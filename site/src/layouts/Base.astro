---
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import "katex/dist/katex.min.css";
import "../styles/site.css";
import { T, checkHref, papersHref } from "../lib/i18n";
import type { CitationMeta } from "../lib/papers";
import type { Lang } from "../lib/registry";

interface Props { lang: Lang; title: string; alternate: string; description?: string; ogImage?: string; indexable?: boolean; citation?: CitationMeta }
const { lang, title, alternate, description = T[lang].lede, ogImage = "/og/default.png", indexable = true, citation } = Astro.props;
const t = T[lang];
const abs = (path: string) => new URL(path, Astro.site ?? "https://h0mework.wiki").href;
const ogVersion = createHash("sha256").update(readFileSync(resolve(process.cwd(), "public", ogImage.replace(/^\//, "")))).digest("hex").slice(0, 12);
const ogImageUrl = abs(`${ogImage}?v=${ogVersion}`);
const selfPath = Astro.url.pathname;
const [zhPath, enPath] = lang === "zh" ? [selfPath, alternate] : [alternate, selfPath];
const citationDate = citation?.date.replaceAll("-", "/");
const jsonLd = citation
  ? {
      "@context": "https://schema.org",
      "@type": "ScholarlyArticle",
      "@id": citation.doiLink,
      headline: citation.title,
      name: citation.title,
      version: `v${citation.version}`,
      author: {
        "@type": "Person",
        name: citation.authorName,
        alternateName: citation.alternateAuthorName,
        ...(citation.orcid
          ? {
              url: `https://orcid.org/${citation.orcid}`,
              sameAs: [
                `https://orcid.org/${citation.orcid}`,
                ...(citation.orcid === "0009-0009-5002-1655" ? ["https://openalex.org/A5157965724"] : []),
              ],
            }
          : {}),
      },
      datePublished: citation.date,
      identifier: [
        { "@type": "PropertyValue", propertyID: "DOI", value: citation.doi },
        citation.doiLink,
      ],
      sameAs: [citation.doiLink, abs(alternate)],
      url: abs(selfPath),
      mainEntityOfPage: abs(selfPath),
      inLanguage: lang === "zh" ? "zh-CN" : "en",
      isAccessibleForFree: true,
      keywords: citation.keywords,
      abstract: citation.abstract,
      license: "https://creativecommons.org/licenses/by/4.0/",
      publisher: {
        "@type": "Organization",
        name: "Zenodo",
        url: "https://zenodo.org",
      },
      isPartOf: {
        "@type": "WebSite",
        name: "H0mework",
        url: "https://h0mework.wiki",
      },
      isBasedOn: {
        "@type": "SoftwareSourceCode",
        name: "H0mework",
        codeRepository: "https://github.com/Sapientropic/H0mework",
        programmingLanguage: "Lean 4",
        license: "https://www.apache.org/licenses/LICENSE-2.0",
      },
      encoding: {
        "@type": "MediaObject",
        contentUrl: abs(citation.pdfPath),
        encodingFormat: "application/pdf",
      },
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "H0mework",
      url: "https://h0mework.wiki",
      inLanguage: lang === "zh" ? "zh-CN" : "en",
      description,
      author: {
        "@type": "Person",
        name: lang === "zh" ? "高健" : "Jian Gao",
        alternateName: lang === "zh" ? "Jian Gao" : "高健",
        url: "https://orcid.org/0009-0009-5002-1655",
        sameAs: ["https://orcid.org/0009-0009-5002-1655", "https://openalex.org/A5157965724", "https://github.com/Sapientropic"],
      },
    };
---
<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {indexable && (
      <>
        <link rel="canonical" href={abs(selfPath)} />
        <link rel="alternate" hreflang="zh-CN" href={abs(zhPath)} />
        <link rel="alternate" hreflang="en" href={abs(enPath)} />
        <link rel="alternate" hreflang="x-default" href={abs(zhPath)} />
      </>
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={citation ? "article" : "website"} />
    <meta property="og:url" content={abs(selfPath)} />
    <meta property="og:site_name" content={t.site} />
    <meta property="og:locale" content={lang === "zh" ? "zh_CN" : "en_US"} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />
    {citation && (
      <>
        <meta name="citation_title" content={citation.title} />
        <meta name="citation_author" content={citation.author} />
        {citation.orcid && <meta name="citation_author_orcid" content={citation.orcid} />}
        <meta name="citation_publication_date" content={citationDate} />
        <meta name="citation_online_date" content={citationDate} />
        <meta name="citation_pdf_url" content={abs(citation.pdfPath)} />
        <meta name="citation_doi" content={citation.doi} />
        <meta name="citation_language" content={lang === "zh" ? "zh" : "en"} />
        {citation.keywords.length > 0 && <meta name="citation_keywords" content={citation.keywords.join("; ")} />}
        <meta name="citation_abstract" content={citation.abstract} />
      </>
    )}
    {indexable && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={t.home}>H<b>0</b>mework</a>
        <nav class="site">
          <a href={papersHref(lang)}>{t.papers}</a>
          <a href={checkHref(lang)}>{t.checkNav}</a>
          <a href="https://github.com/Sapientropic/H0mework">{t.repo}</a>
          <a href={alternate} hreflang={lang === "zh" ? "en" : "zh"}>{t.other}</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site">
      <div class="wrap footer-grid">
        <a class="brand" href={t.home}>H<b>0</b>mework</a>
        <nav>
          <a href="https://github.com/Sapientropic/H0mework">{t.repo}</a>
          <a href={checkHref(lang)}>{t.check}</a>
          <a href="https://github.com/Sapientropic/H0mework/blob/main/docs/evidence-map.md">{t.evidence}</a>
        </nav>
        <p>{t.license}</p>
      </div>
    </footer>
  </body>
</html>
