---
import "katex/dist/katex.min.css";
import "../styles/site.css";
import { T, checkHref, papersHref } from "../lib/i18n";
import type { Lang } from "../lib/registry";

interface Props { lang: Lang; title: string; alternate: string; description?: string; ogImage?: string; indexable?: boolean }
const { lang, title, alternate, description = T[lang].lede, ogImage = "/og/default.png", indexable = true } = Astro.props;
const t = T[lang];
const abs = (path: string) => new URL(path, Astro.site ?? "https://h0mework.wiki").href;
const selfPath = Astro.url.pathname;
const [zhPath, enPath] = lang === "zh" ? [selfPath, alternate] : [alternate, selfPath];
---
<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {indexable && (
      <>
        <link rel="canonical" href={abs(selfPath)} />
        <link rel="alternate" hreflang="zh-CN" href={abs(zhPath)} />
        <link rel="alternate" hreflang="en" href={abs(enPath)} />
        <link rel="alternate" hreflang="x-default" href={abs(zhPath)} />
      </>
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={abs(selfPath)} />
    <meta property="og:site_name" content={t.site} />
    <meta property="og:locale" content={lang === "zh" ? "zh_CN" : "en_US"} />
    <meta property="og:image" content={abs(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={t.home}>H<b>0</b>mework</a>
        <nav class="site">
          <a href={papersHref(lang)}>{t.papers}</a>
          <a href={checkHref(lang)}>{t.checkNav}</a>
          <a href="https://github.com/Sapientropic/H0mework">{t.repo}</a>
          <a href={alternate} hreflang={lang === "zh" ? "en" : "zh"}>{t.other}</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site">
      <div class="wrap footer-grid">
        <a class="brand" href={t.home}>H<b>0</b>mework</a>
        <nav>
          <a href="https://github.com/Sapientropic/H0mework">{t.repo}</a>
          <a href={checkHref(lang)}>{t.check}</a>
          <a href="https://github.com/Sapientropic/H0mework/blob/main/docs/evidence-map.md">{t.evidence}</a>
        </nav>
        <p>{t.license}</p>
      </div>
    </footer>
  </body>
</html>
