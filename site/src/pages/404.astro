---
import Base from "../layouts/Base.astro";
import { T, papersHref } from "../lib/i18n";

// Cloudflare Pages serves this for unknown paths; without it every path returns the home page.
---
<Base lang="zh" title="404 · H0mework" alternate="/en/" indexable={false}>
  <div class="wrap">
    <section class="hero prose">
      <p class="eyebrow">404</p>
      <h1>这一页不存在。</h1>
      <p class="lede">This page does not exist.</p>
      <p><a href={papersHref("zh")}>{T.zh.papers}</a> · <a href={papersHref("en")}>{T.en.papers}</a></p>
    </section>
  </div>
</Base>
