---
import Base from "../layouts/Base.astro";
import Figure from "./Figure.astro";
import ClaimTape from "./ClaimTape.astro";
import CheckCommands from "./CheckCommands.astro";
import Thumb from "./Thumb.astro";
import { ORDERED, chaptersOf, citedByOf, citesOf, paperOf, renderClaim, renderClaimTitle, renderPaperText, statsOf, themeOf, vtFigure, vtTitle, type Lang } from "../lib/papers";
import { claimsOf, labelOf, type ClaimRow } from "../lib/claims";
import { T, fill, paperHref, papersHref } from "../lib/i18n";

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const t = T[lang];
const sep = lang === "zh" ? "：" : ": ";
const paper = paperOf(slug, lang);
const stats = statsOf(slug);
const registered = claimsOf(slug, lang);
const currentFirst = slug === "physics-common-source" && paper.current.number === 3;
const claims = currentFirst
  ? [...registered.filter((claim) => claim.edition === 3), ...registered.filter((claim) => claim.edition < 3)]
  : registered;
const chapters = chaptersOf(slug, lang);
const featured = claims.find((claim) => paper.figure && claim.ids.includes(paper.figure.claim))?.key;
const latest = paper.current;
const earlier = paper.editions.slice(0, -1).reverse();
const index = ORDERED.findIndex((entry) => entry.slug === slug);
const [prev, next] = [ORDERED[index - 1], ORDERED[index + 1]].map((entry) => entry && { href: paperHref(lang, entry.slug), title: paperOf(entry.slug, lang).main });
// The eyebrow opens with the paper's place in the index: its series if it has one, else its theme.
const place = { href: `${papersHref(lang)}#theme-${paper.theme}`, label: paper.series?.[lang] ?? themeOf(paper.theme).label[lang] };
// A paper both cited and citing appears twice; only its first thumbnail carries the view transition, as names must be unique.
const named = new Set<string>();
const linkOf = (other: string) => {
  const entry = paperOf(other, lang);
  const transition = named.has(other) ? undefined : (named.add(other), vtFigure(other));
  return { href: paperHref(lang, other), label: entry.series?.[lang] ?? themeOf(entry.theme).label[lang], title: entry.main, figure: entry.figure?.name, transition };
};
const related = [
  { heading: t.cites, papers: citesOf(slug).map(linkOf) },
  { heading: t.citedBy, papers: citedByOf(slug).map(linkOf) },
].filter((group) => group.papers.length > 0);

// In a long list a divider opens each chapter the list enters; a short list reads without them.
const grouped = claims.length >= 12 && !currentFirst;
const items: ({ kind: "chapter"; key: string; title?: string } | { kind: "claim"; claim: ClaimRow } | { kind: "earlier" })[] = [];
claims.forEach((claim, i) => {
  if (currentFirst && claim.edition < 3 && claims[i - 1]?.edition === 3)
    items.push({ kind: "earlier" });
  if (grouped && claim.chapter && claim.chapter !== claims[i - 1]?.chapter) items.push({ kind: "chapter", key: claim.chapter, title: chapters.get(claim.chapter) });
  items.push({ kind: "claim", claim });
});
// The English note covers every row; a Chinese page names the rows registered in English.
const translated = lang === "zh" ? labelOf(claims.filter((claim) => claim.translated).flatMap((claim) => claim.ids)) : "";
const chapterLabel = (key: string) => (/\d/.test(key) ? fill(t.chapter, key) : fill(t.appendix, key));
---
<Base lang={lang} title={paper.title} alternate={paperHref(lang === "zh" ? "en" : "zh", slug)} description={paper.summary} ogImage={paper.figure ? `/og/${paper.figure.name}.png` : undefined} citation={paper.citation}>
  <div class="wrap">
    <header class="hero">
      <p class="eyebrow"><a href={place.href}>{place.label}</a>{` · ${latest.date}`}</p>
      <h1 class="prose vt-title" style={`view-transition-name:${vtTitle(slug)}`}>{paper.main}</h1>
      {paper.sub && <p class="title-sub prose">{paper.sub}</p>}
      {paper.other && <p class="other prose">{paper.other}</p>}
      <p class="byline">
        <span>{paper.citation.authorName}</span>
        {paper.citation.orcid && (
          <>
            {" · "}
            <a href={`https://orcid.org/${paper.citation.orcid}`}>ORCID {paper.citation.orcid}</a>
          </>
        )}
      </p>
      <div class="actions">
        <a class="button primary" href={paper.citation.pdfPath}>{t.pdf}</a>
        {latest.supplement && <a class="button" href={latest.supplement}>{t.supplement}</a>}
        {latest.arxiv && <a class="button" href={latest.arxiv}>{t.arxiv}</a>}
        <a class="doi" href={latest.doiLink}>DOI {latest.doi}</a>
      </div>
      <ul class="stats">
        <li><b>{stats.claims}</b>{t.statClaims}</li>
        <li><b>{stats.modules}</b>{t.statModules}</li>
        <li><b>{stats.declarations}</b>{t.statDeclarations}</li>
        <li class="ok"><a href="#check">✓ {t.statKernel}</a></li>
      </ul>
    </header>
    {paper.figure && <Figure name={paper.figure.name} lang={lang} transition={vtFigure(slug)} claim={featured} />}
    <section class="section">
      <div class="prose abstract">
        <h2>{t.abstract}</h2>
        {paper.abstract.lead && <p class="lead" set:html={paper.abstract.lead} />}
        <Fragment set:html={[...paper.abstract.shown, ...paper.abstract.folded].join("")} />
      </div>
    </section>
    <section class="section" id="claims">
      <h2>{t.claims}</h2>
      <p class="note prose">{paper.claimsNote ?? t.claimsNote}{translated && fill(t.translatedNote, translated)}</p>
      <ClaimTape rows={claims} lang={lang} featured={featured} link grouped={grouped} />
      <p class="tape-key" aria-hidden="true">
        <span><i class="hole" />{t.keyLean}</span>
        {claims.some((claim) => !claim.proved && claim.category !== "principle") && <span><i class="hole program" />{t.keyProgram}</span>}
        {claims.some((claim) => claim.category === "principle") && <span><i class="hole principle" />{t.keyPrinciple}</span>}
        {featured && <span><i class="hole featured" />{t.keyFigure}</span>}
      </p>
      <ol class="claims">
        {items.map((item) =>
          item.kind === "chapter" ? (
            <li class="chapter" aria-hidden="true"><span class="n">{chapterLabel(item.key)}</span>{item.title && <span class="t" set:html={item.title} />}</li>
          ) : item.kind === "earlier" ? (
            <li class="chapter"><span class="t">{lang === "zh" ? "前两版的证明" : "Proofs from the earlier editions"}</span></li>
          ) : (
            <li class="claim" id={item.claim.key}>
              <details open={item.claim.key === featured}>
                <summary>
                  <span class={`id${item.claim.proved ? "" : " program"}${item.claim.category === "principle" ? " principle" : ""}${item.claim.key === featured ? " featured" : ""}`}>{item.claim.label}</span>
                  <span class="title">
                    <span set:html={renderClaimTitle(item.claim.title)} />
                    {item.claim.category === "interface" && <span class="tag later">{t.keyInterface}</span>}
                    {item.claim.category === "principle" && <span class="tag later">{t.principle}</span>}
                    {item.claim.key === featured && <span class="tag">{t.figure}</span>}
                  </span>
                  <span class="where" title={item.claim.location ?? undefined}>{item.claim.section}</span>
                </summary>
                <div class="body prose">
                  {item.claim.excerpts.length > 0 && (
                    <div class="paper-text">
                      <p class="label">{item.claim.excerptsCited ? t.inPaper : t.inSections}</p>
                      {item.claim.excerpts.map((result, i) => {
                        const head = (
                          <>
                            <span class="result-id">{result.label}</span>
                            {result.name && <span class="result-name" set:html={renderPaperText(result.name).replace(/^<p>|<\/p>\s*$/g, "")} />}
                            {result.parts && <span class="result-parts">{fill(t.parts, result.parts)}</span>}
                          </>
                        );
                        const body = result.body && <div class="result-body" set:html={renderPaperText(result.body)} />;
                        // One result reads as a quotation; several list their names and open the first.
                        return item.claim.excerpts.length === 1 ? (
                          <div class="result"><p class="result-head">{head}</p>{body}</div>
                        ) : (
                          <details class="result" open={i === 0}><summary class="result-head">{head}</summary>{body}</details>
                        );
                      })}
                    </div>
                  )}
                  {item.claim.excerpts.length === 0 && item.claim.restated && (
                    <div class="restated">
                      <p class="label">{t.restated}</p>
                      <div class="statement" set:html={renderClaim(item.claim.restated)} />
                    </div>
                  )}
                  {(item.claim.statement || item.claim.registeredTitle) && (() => {
                    const registered = (
                      <>
                        {item.claim.registeredTitle && <p class="registered-title" set:html={renderClaimTitle(item.claim.registeredTitle)} />}
                        {item.claim.statement && <div class="statement" set:html={renderClaim(item.claim.statement)} />}
                      </>
                    );
                    // With nothing else to read, the registered wording is the body, named as the map's.
                    return item.claim.excerpts.length > 0 || item.claim.restated ? (
                      <details class="registered"><summary>{t.registered}</summary>{registered}</details>
                    ) : (
                      <div class="registered open"><p class="label">{t.registered}</p>{registered}</div>
                    );
                  })()}
                  {item.claim.location && <p class="meta">{t.location}{sep}{item.claim.location}</p>}
                  {item.claim.lean.length > 0 && (
                    <>
                      <h4>{item.claim.category === "principle" ? t.formalSupport : t.lean} · {item.claim.lean.length}</h4>
                      <ul class="modules">
                        {item.claim.lean.map((lean) => (
                          <li>
                            {lean.declarations.length > 0 ? (
                              <details>
                                <summary>
                                  <a href={lean.link} title={lean.module}>{lean.short}</a>
                                  <span class="count" title={t.showDeclarations}>{lean.declarations.length} {t.declarations}</span>
                                </summary>
                                <div class="decls">{lean.declarations.map((decl) => <a href={decl.link} title={decl.qualified}>{decl.name}</a>)}</div>
                              </details>
                            ) : (
                              <a href={lean.link} title={lean.module}>{lean.short}</a>
                            )}
                          </li>
                        ))}
                      </ul>
                    </>
                  )}
                  {item.claim.artifacts.length > 0 && (
                    <>
                      <h4>{t.artifacts} · {item.claim.artifacts.length}</h4>
                      <ul class="modules">{item.claim.artifacts.map((artifact) => <li><a href={artifact.link} title={artifact.path}>{artifact.name}</a></li>)}</ul>
                    </>
                  )}
                </div>
              </details>
            </li>
          ),
        )}
      </ol>
    </section>
    <section class="section" id="check">
      <div class="prose">
        <h2>{t.check}</h2>
        <p>{t.checkPaper}</p>
        {latest.acceptance && <p class="note">{latest.acceptance} <a href={latest.sourceMap}>{t.evidence} · {latest.sourceCommit?.slice(0, 8)}</a></p>}
        <CheckCommands lang={lang} checks={[{ label: "", command: latest.check }]} />
        <p>{t.checkMore}<a href={latest.guide}>{t.guide}</a></p>
        {earlier.length > 0 && (
          <details class="version-history">
            <summary>{t.versions}</summary>
            <ul class="version-list">
              {[latest, ...earlier].map((edition) => (
                <li>
                  <div class="version-links">
                    <span>{fill(t.edition, edition.number)} · {edition.date}</span>
                    <a href={edition.pdf}>PDF</a>
                    {edition.supplement && <a href={edition.supplement}>{t.supplement}</a>}
                    <a href={edition.doiLink}>DOI {edition.doi}</a>
                    <a href={edition.guide}>{t.guide}</a>
                  </div>
                  <CheckCommands lang={lang} checks={[{ label: "", command: edition.check }]} />
                </li>
              ))}
            </ul>
          </details>
        )}
      </div>
    </section>
    {related.length > 0 && (
      <section class="related">
        {related.map((group) => (
          <div>
            <h2>{group.heading}</h2>
            <ul>
              {group.papers.map((other) => (
                <li>
                  <a href={other.href} class:list={{ "text-only": !other.figure }}>
                    {other.figure && <span class="rel-art" aria-hidden="true"><Thumb name={other.figure} transition={other.transition} /></span>}
                    <span class="rel-text"><span class="rel-label">{other.label}</span>{other.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    )}
    <nav class="pager">
      {prev ? <a class="prev" href={prev.href}><span>← {t.prev}</span>{prev.title}</a> : <span />}
      {next ? <a class="next" href={next.href}><span>{t.next} →</span>{next.title}</a> : <span />}
    </nav>
  </div>
</Base>
