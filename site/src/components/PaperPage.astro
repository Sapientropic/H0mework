---
import Base from "../layouts/Base.astro";
import Figure from "./Figure.astro";
import { claimsOf, paperOf, statsOf, type Lang } from "../lib/papers";
import { T, paperHref } from "../lib/i18n";

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const t = T[lang];
const paper = paperOf(slug, lang);
const stats = statsOf(slug);
const claims = claimsOf(slug, lang);
const featured = paper.figure?.claim;
const ordered = featured ? [...claims.filter((c) => c.id === featured), ...claims.filter((c) => c.id !== featured)] : claims;
---
<Base lang={lang} title={paper.title} alternate={paperHref(lang === "zh" ? "en" : "zh", slug)}>
  <div class="wrap">
    <header class="hero">
      <p class="eyebrow">{t.papers} · {paper.date}</p>
      <h1 class="prose">{paper.main}</h1>
      {paper.sub && <p class="title-sub prose">{paper.sub}</p>}
      <p class="other prose">{paper.other}</p>
      <div class="actions">
        <a class="button primary" href={paper.links.pdf}>{t.pdf}</a>
        <a class="button" href={paper.links.supplement}>{t.supplement}</a>
        <a class="button" href={paper.links.arxiv}>{t.arxiv}</a>
        <a class="doi" href={paper.links.doi}>DOI {paper.doi}</a>
      </div>
      <ul class="stats">
        <li><b>{stats.claims}</b>{t.statClaims}</li>
        <li><b>{stats.modules}</b>{t.statModules}</li>
        <li><b>{stats.declarations}</b>{t.statDeclarations}</li>
        {stats.kernel && <li class="ok">✓ {t.statKernel}</li>}
      </ul>
    </header>
    {paper.figure && <Figure name={paper.figure.name} lang={lang} />}
    <section class="section">
      <div class="prose abstract">
        <h2>{t.abstract}</h2>
        <Fragment set:html={paper.abstractLead} />
        <details>
          <summary>{t.more}</summary>
          <Fragment set:html={paper.abstractRest} />
        </details>
      </div>
    </section>
    <section class="section">
      <h2>{t.claims}</h2>
      <p class="note prose">{t.claimsNote}</p>
      <ol class="claims">
        {ordered.map((claim) => (
          <li class="claim" id={claim.id}>
            <details open={claim.id === featured}>
              <summary>
                <span class="id">{claim.id}</span>
                <span class="title">{claim.title}{claim.id === featured && <span class="tag">{t.figure}</span>}</span>
                <span class="where" title={claim.location}>{claim.section}</span>
              </summary>
              <div class="body prose">
                <p>{claim.statement}</p>
                {claim.premises && <p class="premise">{t.premises}：{claim.premises}</p>}
                <p class="premise">{t.location}：{claim.location}</p>
                {claim.lean.length > 0 && (
                  <>
                    <h4>{t.lean} · {claim.lean.length}</h4>
                    <ul class="modules">
                      {claim.lean.map((lean) => (
                        <li>
                          {lean.declarations.length > 0 ? (
                            <details>
                              <summary>
                                <a href={lean.link} title={lean.module}>{lean.short}</a>
                                <span class="count" title={t.showDeclarations}>{lean.declarations.length} {t.declarations}</span>
                              </summary>
                              <div class="decls">{lean.declarations.map((decl) => <a href={decl.link}>{decl.name}</a>)}</div>
                            </details>
                          ) : (
                            <a href={lean.link} title={lean.module}>{lean.short}</a>
                          )}
                        </li>
                      ))}
                    </ul>
                  </>
                )}
                {claim.artifacts.length > 0 && (
                  <>
                    <h4>{t.artifacts} · {claim.artifacts.length}</h4>
                    <ul class="modules">{claim.artifacts.map((artifact) => <li><a href={artifact.link} title={artifact.path}>{artifact.name}</a></li>)}</ul>
                  </>
                )}
              </div>
            </details>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Base>
