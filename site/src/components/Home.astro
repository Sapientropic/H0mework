---
import Base from "../layouts/Base.astro";
import ClaimTape from "./ClaimTape.astro";
import Forest from "./Forest.astro";
import NullScreen from "./NullScreen.astro";
import Thumb from "./Thumb.astro";
import { PAPERS, paperOf, statsOf, vtFigure, vtTitle, type Lang } from "../lib/papers";
import { claimsOf } from "../lib/claims";
import { T, fill, paperHref, papersHref } from "../lib/i18n";

// The opening screen, one line of what the site is, the forest of papers and the latest ones; the full index is /papers/.
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang];
const papers = PAPERS.map((entry, order) => ({ ...paperOf(entry.slug, lang), order, stats: statsOf(entry.slug) }));
const tally = papers.reduce((sum, paper) => ({ claims: sum.claims + paper.stats.claims, modules: sum.modules + paper.stats.modules }), { claims: 0, modules: 0 });
// Every paper on one shelf, newest first; within one date, the later registration.
const latest = [...papers]
  .sort((a, b) => b.current.date.localeCompare(a.current.date) || b.order - a.order)
  .map((paper) => ({ ...paper, claims: claimsOf(paper.slug, lang) }));
---
<Base lang={lang} title={`${t.site} · ${t.tagline.replace("|", lang === "zh" ? "" : " ")}`} alternate={t.otherHref}>
  <div class="wrap">
    <NullScreen lang={lang} />
    <section class="hero prose">
      <h1>{t.tagline.split("|").map((phrase) => <span class="phrase">{phrase}</span>)}</h1>
      <p class="lede">{t.lede}</p>
      <p class="tally"><b>{papers.length}</b>{t.statPapers} · <b>{tally.claims}</b>{t.statClaims} · <b>{tally.modules}</b>{t.statModules} · <span class="ok">✓ {t.statKernel}</span></p>
    </section>
    <Forest lang={lang} />
    <section class="section" id="latest">
      <div class="shelf-head">
        <h2>{t.latest}</h2>
        <div class="shelf-holes" hidden>
          {latest.map((paper, i) => <button type="button" class="hole" data-i={i} aria-label={paper.main} title={paper.main} />)}
        </div>
        <a class="all" href={papersHref(lang)}>{fill(t.allPapers, papers.length)} →</a>
      </div>
      <div class="shelf">
        {latest.map((paper) => (
          <a class="card" href={paperHref(lang, paper.slug)} draggable="false">
            {paper.figure ? (
              <span class="card-art" aria-hidden="true"><Thumb name={paper.figure.name} transition={vtFigure(paper.slug)} /></span>
            ) : (
              <span class="card-art" aria-hidden="true"><span class="punch-card"><ClaimTape rows={paper.claims} lang={lang} grouped={false} /></span></span>
            )}
            <span class="meta">{[paper.series?.[lang], paper.editions.length > 1 ? fill(t.edition, paper.current.number) : null, paper.current.date].filter(Boolean).join(" · ")}</span>
            <span class="t vt-title" style={`view-transition-name:${vtTitle(paper.slug)}`}>{paper.main}</span>
            {paper.sub && <span class="sub">{paper.sub}</span>}
            <span class="st"><b>{paper.stats.claims}</b>{t.statClaims} · <b>{paper.stats.modules}</b>{t.statModules}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
  <script>
    // The shelf scrolls sideways by touch, trackpad or a dragged mouse, and settles on a card; the
    // holes above it are its pages: filled for the cards in view, and a click brings that card in.
    const shelf = document.querySelector<HTMLElement>(".shelf");
    const holes = [...document.querySelectorAll<HTMLButtonElement>(".shelf-holes .hole")];
    if (shelf) {
      const cards = [...shelf.querySelectorAll<HTMLElement>(".card")];
      const smooth = matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";
      const pad = () => parseFloat(getComputedStyle(shelf).scrollPaddingLeft) || 0;
      const go = (i: number) => shelf.scrollTo({ left: cards[i].offsetLeft - pad(), behavior: smooth });
      const nearest = () => cards.reduce((best, card, i) => (Math.abs(card.offsetLeft - pad() - shelf.scrollLeft) < Math.abs(cards[best].offsetLeft - pad() - shelf.scrollLeft) ? i : best), 0);
      // A card is in view when most of it lies inside the column, not in the faded gutters.
      const mark = () => {
        const left = shelf.scrollLeft + pad(), right = left + shelf.clientWidth - 2 * pad();
        cards.forEach((card, i) => holes[i]?.classList.toggle("on", Math.min(right, card.offsetLeft + card.offsetWidth) - Math.max(left, card.offsetLeft) > card.offsetWidth * 0.6));
      };
      let queued = false;
      shelf.addEventListener("scroll", () => { if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; mark(); }); } }, { passive: true });
      new ResizeObserver(() => {
        holes[0]?.parentElement?.toggleAttribute("hidden", shelf.scrollWidth <= shelf.clientWidth + 1);
        mark();
      }).observe(shelf);
      holes.forEach((hole, i) => hole.addEventListener("click", () => go(i)));
      // A mouse drags the shelf; past a few pixels it is a drag, not a click, and on release it settles.
      let from: { x: number; left: number } | null = null, dragging = false, quiet = 0;
      shelf.addEventListener("dragstart", (event) => event.preventDefault());
      // The click that ends a drag opens nothing.
      shelf.addEventListener("click", (event) => { if (performance.now() < quiet) { event.preventDefault(); event.stopPropagation(); } }, { capture: true });
      shelf.addEventListener("pointerdown", (event) => {
        if (event.pointerType === "mouse" && event.button === 0) { from = { x: event.clientX, left: shelf.scrollLeft }; dragging = false; }
      });
      shelf.addEventListener("pointermove", (event) => {
        if (!from) return;
        const dx = event.clientX - from.x;
        if (!dragging && Math.abs(dx) > 6) { dragging = true; shelf.classList.add("dragging"); shelf.setPointerCapture(event.pointerId); }
        if (dragging) shelf.scrollLeft = from.left - dx;
      });
      const drop = () => {
        if (!from) return;
        from = null;
        if (!dragging) return;
        dragging = false;
        quiet = performance.now() + 80;
        shelf.classList.remove("dragging");
        go(nearest());
      };
      shelf.addEventListener("pointerup", drop);
      shelf.addEventListener("pointercancel", drop);
    }
  </script>
</Base>
