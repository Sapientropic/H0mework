---
import Base from "../layouts/Base.astro";
import ClaimTape from "./ClaimTape.astro";
import Forest from "./Forest.astro";
import NullScreen from "./NullScreen.astro";
import isoCss from "../../figures/kit/iso.css?raw";
import { PAPERS, figureSvgOf, paperOf, statsOf, vtFigure, vtTitle, type Lang } from "../lib/papers";
import { claimsOf } from "../lib/claims";
import { T, fill, paperHref, papersHref } from "../lib/i18n";

// The opening screen, one line of what the site is, the forest of papers and the latest ones; the full index is /papers/.
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang];
const papers = PAPERS.map((entry, order) => ({ ...paperOf(entry.slug, lang), order, stats: statsOf(entry.slug) }));
const tally = papers.reduce((sum, paper) => ({ claims: sum.claims + paper.stats.claims, modules: sum.modules + paper.stats.modules }), { claims: 0, modules: 0 });
// Newest first; within one date, the later registration.
const latest = [...papers]
  .sort((a, b) => b.current.date.localeCompare(a.current.date) || b.order - a.order)
  .slice(0, 3)
  .map((paper) => ({ ...paper, thumb: paper.figure ? figureSvgOf(paper.figure.name) : "", claims: claimsOf(paper.slug, lang) }));
---
<Base lang={lang} title={`${t.site} · ${t.tagline.replace("|", lang === "zh" ? "" : " ")}`} alternate={t.otherHref}>
  <style is:global set:html={isoCss}></style>
  <div class="wrap">
    <NullScreen lang={lang} />
    <section class="hero prose">
      <h1>{t.tagline.split("|").map((phrase) => <span class="phrase">{phrase}</span>)}</h1>
      <p class="lede">{t.lede}</p>
      <p class="tally"><b>{papers.length}</b>{t.statPapers} · <b>{tally.claims}</b>{t.statClaims} · <b>{tally.modules}</b>{t.statModules} · <span class="ok">✓ {t.statKernel}</span></p>
    </section>
    <Forest lang={lang} />
    <section class="section" id="latest">
      <h2>{t.latest}</h2>
      <div class="cards">
        {latest.map((paper) => (
          <a class="card" href={paperHref(lang, paper.slug)}>
            {paper.thumb ? (
              <span class="card-art iso vt-fig" data-theme="light" aria-hidden="true" style={`--vt:${vtFigure(paper.slug)}`} set:html={paper.thumb} />
            ) : (
              <span class="card-art" aria-hidden="true"><span class="punch-card"><ClaimTape rows={paper.claims} lang={lang} grouped={false} /></span></span>
            )}
            <span class="meta">{[paper.series?.[lang], paper.editions.length > 1 ? fill(t.edition, paper.current.number) : null, paper.current.date].filter(Boolean).join(" · ")}</span>
            <span class="t vt-title" style={`view-transition-name:${vtTitle(paper.slug)}`}>{paper.main}</span>
            {paper.sub && <span class="sub">{paper.sub}</span>}
            <span class="st"><b>{paper.stats.claims}</b>{t.statClaims} · <b>{paper.stats.modules}</b>{t.statModules}</span>
          </a>
        ))}
      </div>
      <p class="all"><a href={papersHref(lang)}>{fill(t.allPapers, papers.length)} →</a></p>
    </section>
  </div>
</Base>
