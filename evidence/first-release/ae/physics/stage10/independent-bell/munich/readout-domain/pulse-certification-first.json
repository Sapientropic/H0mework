  "public_mouths": [
    {
      "name": "SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.feasible_iff_rates",
      "type": "∀ (effect : SaturationMonoid.PhysicsCore.Stage10.Bell.CompactReadoutEffect)\n  (spectrum : SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.Spectrum),\n  SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.Feasible effect spectrum ↔\n    SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.Rates\n      (SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.background effect spectrum)\n      (SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.factor effect spectrum)"
    },
    {
      "name": "SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.feasible_iff_squared",
      "type": "∀ (effect : SaturationMonoid.PhysicsCore.Stage10.Bell.CompactReadoutEffect)\n  (spectrum : SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.Spectrum),\n  SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.Feasible effect spectrum ↔\n    (effect.u ^ 2 + effect.z ^ 2) * (spectrum.bright + spectrum.dark) ^ 2 ≤ (1 - effect.mu) ^ 2 * spectrum.gap ^ 2 ∧\n      (effect.u ^ 2 + effect.z ^ 2) * (2 - spectrum.bright - spectrum.dark) ^ 2 ≤ (1 + effect.mu) ^ 2 * spectrum.gap ^ 2"
    },
    {
      "name": "SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.feasible_monotone",
      "type": "∀ (effect : SaturationMonoid.PhysicsCore.Stage10.Bell.CompactReadoutEffect)\n  (worst actual : SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.Spectrum),\n  SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.Feasible effect worst →\n    worst.bright ≤ actual.bright →\n      actual.dark ≤ worst.dark →\n        SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.Feasible effect actual"
    },
    {
      "name": "SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.pulse_realizes",
      "type": "∀ (effect : SaturationMonoid.PhysicsCore.Stage10.Bell.CompactReadoutEffect)\n  (spectrum : SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.Spectrum) (positive : 0 < effect.gain),\n  SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.Realizes effect\n    (SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.background effect spectrum)\n    (SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.factor effect spectrum)\n    (SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.atomicEffect spectrum\n      (SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.realizationAxis effect positive))"
    },
    {
      "name": "SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.realized_effect_eq",
      "type": "∀ (effect : SaturationMonoid.PhysicsCore.Stage10.Bell.CompactReadoutEffect)\n  (spectrum : SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.Spectrum) (positive : 0 < effect.gain)\n  (feasible : SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.Feasible effect spectrum),\n  SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.realizedEffect effect spectrum positive feasible =\n    effect"
    },
    {
      "name": "SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.atomic_effect_injective",
      "type": "∀ (axis : SaturationMonoid.PhysicsCore.Stage10.Bell.Axis)\n  {first second : SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.Spectrum},\n  SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.atomicEffect first axis =\n      SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.atomicEffect second axis →\n    first = second"
    },
    {
      "name": "SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.two_spectra_same_effect",
      "type": "∀ (effect : SaturationMonoid.PhysicsCore.Stage10.Bell.CompactReadoutEffect)\n  (first second : SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.Spectrum)\n  (positive : 0 < effect.gain)\n  (first_feasible : SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.Feasible effect first)\n  (second_feasible : SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.Feasible effect second),\n  first ≠ second →\n    SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.atomicEffect first\n          (SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.realizationAxis effect positive) ≠\n        SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.atomicEffect second\n          (SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.realizationAxis effect positive) ∧\n      SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.realizedEffect effect first positive\n            first_feasible =\n          effect ∧\n        SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.realizedEffect effect second positive\n            second_feasible =\n          effect"
    },
    {
      "name": "SaturationMonoid.PhysicsCore.Stage10.Bell.PulseCertification.generalSameSourceCurrentNext",
      "type": "∀ (effect second : SaturationMonoid.PhysicsCore.Stage10.Bell.CompactReadoutEffect)\n  (spectrum : SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.Spectrum) (positive : 0 < effect.gain)\n  (feasible : SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.Feasible effect spectrum)\n  (point : SaturationMonoid.PhysicsCore.ProofFreeRicherAnholonomicSource.BasePoint) (plus x y : Bool),\n  SaturationMonoid.PhysicsCore.Stage10.Bell.effectSourceWeight\n        (SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.realizedEffect effect spectrum positive\n          feasible)\n        second plus point x y =\n      SaturationMonoid.PhysicsCore.Stage10.Bell.effectSourceWeight effect second plus point x y ∧\n    SaturationMonoid.PhysicsCore.Stage10.Bell.effectRuntimeProbability\n          (SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.realizedEffect effect spectrum positive\n            feasible)\n          second plus point x y =\n        SaturationMonoid.PhysicsCore.Stage10.Bell.effectRuntimeProbability effect second plus point x y ∧\n      SaturationMonoid.PhysicsCore.Stage10.Bell.effectNextProbability\n          (SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.realizedEffect effect spectrum positive\n            feasible)\n          second plus point x y =\n        SaturationMonoid.PhysicsCore.Stage10.Bell.effectNextProbability effect second plus point x y"
    },
    {
      "name": "SaturationMonoid.PhysicsCore.Stage10.Bell.PulseCertification.generalBothSidesFullProbability",
      "type": "∀ (first second : SaturationMonoid.PhysicsCore.Stage10.Bell.CompactReadoutEffect)\n  (firstSpectrum secondSpectrum : SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.Spectrum)\n  (firstPositive : 0 < first.gain) (secondPositive : 0 < second.gain)\n  (firstFeasible : SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.Feasible first firstSpectrum)\n  (secondFeasible : SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.Feasible second secondSpectrum)\n  (plus x y : Bool),\n  SaturationMonoid.PhysicsCore.Stage10.Bell.effectProbability\n      (SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.realizedEffect first firstSpectrum\n        firstPositive firstFeasible)\n      (SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutPulseRealization.realizedEffect second secondSpectrum\n        secondPositive secondFeasible)\n      plus x y =\n    SaturationMonoid.PhysicsCore.Stage10.Bell.effectProbability first second plus x y"
    },
