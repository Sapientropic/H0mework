  "public_mouths": [
    {
      "name": "SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.fiber_iff_decomposition",
      "type": "∀ (effect : SaturationMonoid.PhysicsCore.Stage10.Bell.CompactReadoutEffect) (d k : ℝ),\n  0 < effect.gain →\n    (SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.Fiber effect d k ↔\n      SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.Rates d k ∧\n        ∃ atom, SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.Realizes effect d k atom)"
    },
    {
      "name": "SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.efficiency_atomic_lower",
      "type": "∀ (effect atom : SaturationMonoid.PhysicsCore.Stage10.Bell.CompactReadoutEffect) (d k : ℝ),\n  SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.Rates d k →\n    SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.Realizes effect d k atom →\n      0 < effect.gain →\n        SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.intrinsicLower effect ≤\n          SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.efficiency d k *\n            SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.maxAtomic atom"
    },
    {
      "name": "SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.domain_microhardware_bounds",
      "type": "∀ (effect atom : SaturationMonoid.PhysicsCore.Stage10.Bell.CompactReadoutEffect) (d k B G : ℝ),\n  SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.Rates d k →\n    SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.Realizes effect d k atom →\n      0 < G →\n        G ≤ effect.gain →\n          |effect.mu| ≤ B →\n            SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.domainLower B G ≤\n                SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.efficiency d k *\n                  SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.maxAtomic atom ∧\n              d ≤ (1 + B - G) / 2"
    },
    {
      "name": "SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.domain_area_bound",
      "type": "∀ (effect atom : SaturationMonoid.PhysicsCore.Stage10.Bell.CompactReadoutEffect) (d k B G areaSquared : ℝ),\n  SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.Rates d k →\n    SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.Realizes effect d k atom →\n      0 < G →\n        G ≤ effect.gain →\n          |effect.mu| ≤ B →\n            SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.maxAtomic atom ≤ 7 * areaSquared / 4 →\n              4 * SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.domainLower B G / 7 ≤\n                SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.efficiency d k * areaSquared"
    },
    {
      "name": "SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.raw_product_cap_gain",
      "type": "∀ (effect atom : SaturationMonoid.PhysicsCore.Stage10.Bell.CompactReadoutEffect) (d k B cap : ℝ),\n  SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.Rates d k →\n    SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.Realizes effect d k atom →\n      |effect.mu| ≤ B →\n        0 ≤ cap →\n          cap ≤ 1 →\n            SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.efficiency d k *\n                  SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.maxAtomic atom ≤\n                cap →\n              effect.gain ≤ min 1 ((1 + B) * cap / (2 - cap))"
    },
    {
      "name": "SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.raw_detector_area_cap",
      "type": "∀ (effect atom : SaturationMonoid.PhysicsCore.Stage10.Bell.CompactReadoutEffect)\n  (d k B etaUpper areaSquared areaUpper : ℝ),\n  SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.Rates d k →\n    SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.Realizes effect d k atom →\n      d < 1 →\n        |effect.mu| ≤ B →\n          0 ≤ etaUpper →\n            etaUpper ≤ 1 →\n              SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.efficiency d k ≤ etaUpper →\n                0 ≤ areaUpper →\n                  areaSquared ≤ areaUpper →\n                    SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.maxAtomic atom ≤\n                        7 * areaSquared / 4 →\n                      effect.gain ≤\n                        min 1\n                          ((1 + B) * (etaUpper * min 1 (7 * areaUpper / 4)) /\n                            (2 - etaUpper * min 1 (7 * areaUpper / 4)))"
    },
    {
      "name": "SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.inverse_atom_unique",
      "type": "∀ (effect atom : SaturationMonoid.PhysicsCore.Stage10.Bell.CompactReadoutEffect) (d k : ℝ)\n  (fiber : SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.Fiber effect d k) (positive : 0 < k),\n  SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.Realizes effect d k atom →\n    SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber.inverseAtom effect d k fiber positive = atom"
    },
