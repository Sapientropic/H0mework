import SaturationMonoid.GenericFoundation.Cofinal.Topology.Successor

set_option autoImplicit false
set_option Elab.async false

noncomputable section
universe u

namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace CofinalAllPrimeTopology

open CategoryTheory CategoryTheory.Limits SourceGeneratedPrimePowerCompletion

variable {L M : Type u} [AddCommGroup L] [AddCommGroup M]

/-- A left inverse generated by the actual source action remains a left inverse on all three topology carriers. -/
theorem topology_successor_left_inverse (action : L →ₗ[ℤ] M) (backward : M →ₗ[ℤ] L)
    (inverse : Function.LeftInverse backward action) :
    Function.LeftInverse (allStageSuccessor backward) (allStageSuccessor action) ∧
    Function.LeftInverse (allPrimeSuccessor backward) (allPrimeSuccessor action) ∧
    Function.LeftInverse (allPrimeCoimageSuccessor backward) (allPrimeCoimageSuccessor action) := by
  have law : backward.comp action = LinearMap.id := LinearMap.ext inverse
  refine ⟨?_, ?_, ?_⟩
  · intro stages
    funext p j
    change stageMap p j backward (stageMap p j action (stages p j)) = stages p j
    rw [← LinearMap.comp_apply, ← stageMap_comp, law, stageMap_id, LinearMap.id_apply]
  · intro limits
    funext p
    have equation : inducedCompletionMap p action ≫ inducedCompletionMap p backward =
        𝟙 (Completion (L := L) p) := by
      rw [← inducedCompletionMap_comp, law, inducedCompletionMap_id]
    exact ConcreteCategory.congr_hom equation (limits p)
  · intro quotient
    obtain ⟨word, rfl⟩ := (AllPrimeKernel (L := L)).mkQ_surjective quotient
    rw [allPrime_coimage_successor_source, allPrime_coimage_successor_source, inverse word]

private theorem stage_successor_apply {P Q : Type u} [AddCommGroup P] [AddCommGroup Q]
    (p : Nat.Primes) (j : Nat) (action : P →ₗ[ℤ] Q) (value : P) :
    stageMap p j action (stageProjection p j value) = stageProjection p j (action value) :=
  LinearMap.congr_fun (stageMap_projection p j action) value

private theorem completion_coordinates_ext (p : Nat.Primes) {left right : Completion (L := M) p}
    (equal : ∀ j, (restriction (L := M) p j).hom left = (restriction (L := M) p j).hom right) :
    left = right := by
  let atPoint (value : Completion (L := M) p) : ModuleCat.of ℤ (ULift.{u} ℤ) ⟶ Completion (L := M) p :=
    ModuleCat.ofHom ((ULift.moduleEquiv : ULift.{u} ℤ ≃ₗ[ℤ] ℤ).toLinearMap.smulRight value)
  have same : atPoint left = atPoint right := by
    apply (limit.isLimit (tower (L := M) p)).hom_ext
    rintro ⟨j⟩
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro scalar
    change (restriction (L := M) p j).hom (scalar.down • left) =
      (restriction (L := M) p j).hom (scalar.down • right)
    rw [map_smul, map_smul, equal]
  have point := ConcreteCategory.congr_hom same (ULift.up (1 : ℤ))
  change (1 : ℤ) • left = (1 : ℤ) • right at point
  simpa only [one_smul] using point

/-- The actual source decomposition holds on the full stage product, the coherent limits and the separated carriers. -/
theorem topology_successor_decomposition {Q : Type u} [AddCommGroup Q]
    (action : L →ₗ[ℤ] M) (backward : M →ₗ[ℤ] L) (coefficient : M →ₗ[ℤ] Q) (inclusion : Q →ₗ[ℤ] M)
    (decompose : ∀ value, action (backward value)+inclusion (coefficient value) = value) :
    (∀ value : AllStageObservation M,
      allStageSuccessor action (allStageSuccessor backward value)+
        allStageSuccessor inclusion (allStageSuccessor coefficient value) = value) ∧
    (∀ value : AllPrimeCompletion M,
      allPrimeSuccessor action (allPrimeSuccessor backward value)+
        allPrimeSuccessor inclusion (allPrimeSuccessor coefficient value) = value) ∧
    (∀ value : AllPrimeFaithfulCoimage (L := M),
      allPrimeCoimageSuccessor action (allPrimeCoimageSuccessor backward value)+
        allPrimeCoimageSuccessor inclusion (allPrimeCoimageSuccessor coefficient value) = value) := by
  have stage (p : Nat.Primes) (j : Nat) (value : StageResidual (L := M) p j) :
      stageMap p j action (stageMap p j backward value)+
        stageMap p j inclusion (stageMap p j coefficient value) = value := by
    obtain ⟨word, rfl⟩ := (powerRange (L := M) p j).mkQ_surjective value
    change stageMap p j action (stageMap p j backward (stageProjection p j word))+
      stageMap p j inclusion (stageMap p j coefficient (stageProjection p j word)) =
        stageProjection p j word
    simp only [stage_successor_apply]
    rw [← map_add, decompose]
  refine ⟨?_, ?_, ?_⟩
  · intro value
    funext p j
    exact stage p j (value p j)
  · intro value
    funext p
    apply completion_coordinates_ext p
    intro j
    change (restriction (L := M) p j).hom
        ((allPrimeSuccessor action (allPrimeSuccessor backward value)) p+
          (allPrimeSuccessor inclusion (allPrimeSuccessor coefficient value)) p) =
      (restriction (L := M) p j).hom (value p)
    simp only [map_add, allPrime_successor_restriction]
    exact stage p j ((restriction (L := M) p j).hom (value p))
  · intro value
    obtain ⟨word, rfl⟩ := (AllPrimeKernel (L := M)).mkQ_surjective value
    simp only [allPrime_coimage_successor_source]
    rw [← map_add, decompose]

end CofinalAllPrimeTopology
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
