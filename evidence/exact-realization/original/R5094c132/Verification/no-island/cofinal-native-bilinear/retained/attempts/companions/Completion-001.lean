import SaturationMonoid.GenericFoundation.Cofinal.Topology.Bilinear

set_option autoImplicit false
set_option Elab.async false

noncomputable section
universe u
namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace SourceGeneratedPrimePowerCompletion

open CategoryTheory CategoryTheory.Limits

variable {L M N : Type u} [AddCommGroup L] [AddCommGroup M] [AddCommGroup N]

private theorem completion_transition (p : Nat.Primes) (j : Nat) (value : Completion (L := L) p) :
    transition p j ((restriction p (j+1)).hom value) = (restriction p j).hom value := by
  let arrow := (homOfLE (Nat.le_add_right j 1)).op
  have arrowEq : (tower (L := L) p).map arrow = ModuleCat.ofHom (transition (L := L) p j) :=
    Functor.ofOpSequence_map_homOfLE_succ _ j
  have square := limit.w (tower (L := L) p) arrow
  rw [arrowEq] at square
  exact ConcreteCategory.congr_hom square value

private def bilinearCone (act : L →ₗ[ℤ] M →ₗ[ℤ] N) (p : Nat.Primes)
    (left : Completion (L := L) p) : Cone (tower (L := N) p) :=
  Cone.mk (Completion (L := M) p)
    (NatTrans.ofOpSequence
      (fun j => ModuleCat.ofHom ((stageBilinear act p j ((restriction p j).hom left)).comp (restriction p j).hom))
      (fun j => by
        simp only [Functor.const_obj_map, Category.id_comp, tower, Functor.ofOpSequence_map_homOfLE_succ]
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro right
        change stageBilinear act p j ((restriction p j).hom left) ((restriction p j).hom right) =
          transition p j (stageBilinear act p (j+1) ((restriction p (j+1)).hom left)
            ((restriction p (j+1)).hom right))
        rw [stage_bilinear_transition, completion_transition, completion_transition]))

private def completedRight (act : L →ₗ[ℤ] M →ₗ[ℤ] N) (p : Nat.Primes)
    (left : Completion (L := L) p) : Completion (L := M) p →ₗ[ℤ] Completion (L := N) p :=
  (limit.lift (tower (L := N) p) (bilinearCone act p left)).hom

private theorem completed_right_restriction (act : L →ₗ[ℤ] M →ₗ[ℤ] N) (p : Nat.Primes) (j : Nat)
    (left : Completion (L := L) p) (right : Completion (L := M) p) :
    (restriction p j).hom (completedRight act p left right) =
      stageBilinear act p j ((restriction p j).hom left) ((restriction p j).hom right) :=
  ConcreteCategory.congr_hom (limit.lift_π (bilinearCone act p left) (Opposite.op j)) right

/-- Both coherent source arguments act on the existing completion, generated by their stage operations. -/
def completionBilinear (act : L →ₗ[ℤ] M →ₗ[ℤ] N) (p : Nat.Primes) :
    Completion (L := L) p →ₗ[ℤ] Completion (L := M) p →ₗ[ℤ] Completion (L := N) p where
  toFun := completedRight act p
  map_add' left other := by
    apply LinearMap.ext
    intro right
    apply Concrete.limit_ext (tower (L := N) p)
    rintro ⟨j⟩
    change (restriction (L := N) p j).hom (completedRight act p (left+other) right) =
      (restriction (L := N) p j).hom (completedRight act p left right + completedRight act p other right)
    simp only [map_add, completed_right_restriction, LinearMap.add_apply]
  map_smul' coefficient left := by
    apply LinearMap.ext
    intro right
    apply Concrete.limit_ext (tower (L := N) p)
    rintro ⟨j⟩
    change (restriction (L := N) p j).hom (completedRight act p (coefficient • left) right) =
      (restriction (L := N) p j).hom (coefficient • completedRight act p left right)
    simp only [map_smul, completed_right_restriction, LinearMap.smul_apply]

theorem completion_bilinear_restriction (act : L →ₗ[ℤ] M →ₗ[ℤ] N) (p : Nat.Primes) (j : Nat)
    (left : Completion (L := L) p) (right : Completion (L := M) p) :
    (restriction p j).hom (completionBilinear act p left right) =
      stageBilinear act p j ((restriction p j).hom left) ((restriction p j).hom right) :=
  completed_right_restriction act p j left right

theorem completion_bilinear_source (act : L →ₗ[ℤ] M →ₗ[ℤ] N) (p : Nat.Primes) (left : L) (right : M) :
    completionBilinear act p (canonicalLinearMap p left) (canonicalLinearMap p right) =
      canonicalLinearMap p (act left right) := by
  apply Concrete.limit_ext (tower (L := N) p)
  rintro ⟨j⟩
  have source {A : Type u} [AddCommGroup A] (value : A) :
      (restriction p j).hom (canonicalLinearMap p value) = stageProjection p j value :=
    ConcreteCategory.congr_hom (canonicalMap_restriction p j) value
  change (restriction (L := N) p j).hom
      (completionBilinear act p (canonicalLinearMap p left) (canonicalLinearMap p right)) =
    (restriction (L := N) p j).hom (canonicalLinearMap p (act left right))
  rw [completion_bilinear_restriction, source left, source right, source (act left right)]
  exact stage_bilinear_projection act p j left right

end SourceGeneratedPrimePowerCompletion
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
