{
  "argv": [
    "/usr/bin/time",
    "-l",
    "lake",
    "env",
    "lean",
    "-j1",
    "--root=runtime/effective-scope/public-nine-right-nested/AE/src",
    "--trust=0",
    "-Dweak.linter.unnecessarySimpa=false",
    "-Dweak.linter.style.haveILetI=false",
    "-Dweak.linter.unusedSimpArgs=false",
    "-DmaxHeartbeats=2000000",
    "-Dweak.linter.unusedSectionVars=false",
    "-Dweak.linter.unnecessarySeqFocus=false",
    "-Dweak.linter.unusedVariables=false",
    "-Dweak.linter.unreachableTactic=false",
    "-Dweak.linter.unusedTactic=false",
    "-Dweak.linter.defProp=false",
    "-Dweak.linter.deprecated=false",
    "-Dlinter.deprecated=false",
    "-Dweak.linter.tacticAnalysis.introMerge=false",
    "-Dweak.linter.constructorNameAsVariable=false",
    "-DwarningAsError=true",
    "runtime/effective-scope/public-nine-right-nested/AE/src/IndependentActualEffectiveConsumer.lean",
    "-o",
    "runtime/effective-scope/public-nine-right-nested/AE/consumer.olean"
  ],
  "cwd": "./Lean",
  "LEAN_NUM_THREADS": "1"
}
