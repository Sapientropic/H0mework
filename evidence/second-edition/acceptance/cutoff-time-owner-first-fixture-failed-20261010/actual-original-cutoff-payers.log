TYPE _private.H0mework.Versions.R71e.ReleaseMaterials.Physics.LowEnergyPhenomenology.ExternalCompositeDecay.SourceFullYUncutRetardedKernel.0.LowEnergy.FullYDynamicSourceNext.causal_apply = ∀
  {E : Type u_1} {D : Type u_2} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℂ E]
  [inst_2 : CompleteSpace E] [inst_3 : NormedAddCommGroup D] [inst_4 : InnerProductSpace ℂ D] [CompleteSpace D]
  (A : E →L[ℂ] E) (J : E →L[ℂ] D) (x : E) (z : ℂ) (T : ℝ),
  J ((LowEnergy.FullYDynamicSourceNext.sourceCausal A z T) x) =
    Complex.I •
      ∫ (s : ℝ) in 0..T,
        LowEnergy.FullYDynamicSourceNext.retardedPhase✝ z s • J ((LowEnergy.SourceFiniteUnitary.time A s) x)
