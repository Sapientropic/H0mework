OWNER LowEnergy.FourGradeOutputParseval.baseline_square_mass = _private.H0mework.Versions.R71e.ReleaseMaterials.Physics.LowEnergyPhenomenology.ExternalCompositeDecay.SourceFullYPositiveOutputParseval.0.LowEnergy.FourGradeOutputParseval.baseline_square_mass MODULE H0mework.Versions.R71e.ReleaseMaterials.Physics.LowEnergyPhenomenology.ExternalCompositeDecay.SourceFullYPositiveOutputParseval
TYPE _private.H0mework.Versions.R71e.ReleaseMaterials.Physics.LowEnergyPhenomenology.ExternalCompositeDecay.SourceFullYPositiveOutputParseval.0.LowEnergy.FourGradeOutputParseval.baseline_square_mass = ∀
  {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℂ E] [CompleteSpace E] (x : E) (μ : ℝ),
  0 < μ →
    ∫ (ξ : ℝ), ‖FourierTransform.fourier (LowEnergy.FullYPairedParseval.causalWave μ fun x_1 => x) ξ‖ ^ 2 =
        ‖x‖ ^ 2 / (2 * μ) ∧
      ∫ (t : ℝ), ‖LowEnergy.FullYPairedParseval.causalWave μ (fun x_1 => x) t‖ ^ 2 = ‖x‖ ^ 2 / (2 * μ)
OWNER LowEnergy.FourGradeOutputParseval.positive_output_parseval = _private.H0mework.Versions.R71e.ReleaseMaterials.Physics.LowEnergyPhenomenology.ExternalCompositeDecay.SourceFullYPositiveOutputParseval.0.LowEnergy.FourGradeOutputParseval.positive_output_parseval MODULE H0mework.Versions.R71e.ReleaseMaterials.Physics.LowEnergyPhenomenology.ExternalCompositeDecay.SourceFullYPositiveOutputParseval
TYPE _private.H0mework.Versions.R71e.ReleaseMaterials.Physics.LowEnergyPhenomenology.ExternalCompositeDecay.SourceFullYPositiveOutputParseval.0.LowEnergy.FourGradeOutputParseval.positive_output_parseval = ∀
  {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℂ E] [CompleteSpace E] (u b : ℝ → E),
  MeasureTheory.Integrable u MeasureTheory.volume →
    MeasureTheory.Integrable b MeasureTheory.volume →
      Continuous (u - b) →
        MeasureTheory.Integrable (FourierTransform.fourier (u - b)) MeasureTheory.volume →
          MeasureTheory.Integrable (fun ξ => inner ℂ (FourierTransform.fourier b ξ) (FourierTransform.fourier b ξ))
              MeasureTheory.volume →
            MeasureTheory.Integrable (fun t => inner ℂ (b t) (b t)) MeasureTheory.volume →
              MeasureTheory.Integrable (fun t => inner ℂ ((u - b) t) (b t)) MeasureTheory.volume →
                MeasureTheory.Integrable (fun t => inner ℂ (u t) ((u - b) t)) MeasureTheory.volume →
                  ∫ (ξ : ℝ), inner ℂ (FourierTransform.fourier b ξ) (FourierTransform.fourier b ξ) =
                      ∫ (t : ℝ), inner ℂ (b t) (b t) →
                    ∫ (ξ : ℝ), inner ℂ (FourierTransform.fourier u ξ) (FourierTransform.fourier u ξ) =
                      ∫ (t : ℝ), inner ℂ (u t) (u t)
OWNER LowEnergy.FourGradeOutputParseval.square_pair_integrable = _private.H0mework.Versions.R71e.ReleaseMaterials.Physics.LowEnergyPhenomenology.ExternalCompositeDecay.SourceFullYPositiveOutputParseval.0.LowEnergy.FourGradeOutputParseval.square_pair_integrable MODULE H0mework.Versions.R71e.ReleaseMaterials.Physics.LowEnergyPhenomenology.ExternalCompositeDecay.SourceFullYPositiveOutputParseval
TYPE _private.H0mework.Versions.R71e.ReleaseMaterials.Physics.LowEnergyPhenomenology.ExternalCompositeDecay.SourceFullYPositiveOutputParseval.0.LowEnergy.FourGradeOutputParseval.square_pair_integrable = ∀
  {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℂ E] (u v : ℝ → E),
  MeasureTheory.AEStronglyMeasurable u MeasureTheory.volume →
    MeasureTheory.AEStronglyMeasurable v MeasureTheory.volume →
      MeasureTheory.Integrable (fun t => ‖u t‖ ^ 2) MeasureTheory.volume →
        MeasureTheory.Integrable (fun t => ‖v t‖ ^ 2) MeasureTheory.volume →
          MeasureTheory.Integrable (fun t => inner ℂ (u t) (v t)) MeasureTheory.volume
OWNER LowEnergy.FourGradeOutputParseval.one_sided_positive_parseval = _private.H0mework.Versions.R71e.ReleaseMaterials.Physics.LowEnergyPhenomenology.ExternalCompositeDecay.SourceFullYPositiveOutputParseval.0.LowEnergy.FourGradeOutputParseval.one_sided_positive_parseval MODULE H0mework.Versions.R71e.ReleaseMaterials.Physics.LowEnergyPhenomenology.ExternalCompositeDecay.SourceFullYPositiveOutputParseval
TYPE _private.H0mework.Versions.R71e.ReleaseMaterials.Physics.LowEnergyPhenomenology.ExternalCompositeDecay.SourceFullYPositiveOutputParseval.0.LowEnergy.FourGradeOutputParseval.one_sided_positive_parseval = ∀
  {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℂ E] [CompleteSpace E] (f g : ℝ → E),
  MeasureTheory.Integrable f MeasureTheory.volume →
    MeasureTheory.Integrable g MeasureTheory.volume →
      Continuous g →
        MeasureTheory.Integrable (FourierTransform.fourier g) MeasureTheory.volume →
          ∫ (ξ : ℝ), inner ℂ (FourierTransform.fourier f ξ) (FourierTransform.fourier g ξ) =
            ∫ (t : ℝ), inner ℂ (f t) (g t)
