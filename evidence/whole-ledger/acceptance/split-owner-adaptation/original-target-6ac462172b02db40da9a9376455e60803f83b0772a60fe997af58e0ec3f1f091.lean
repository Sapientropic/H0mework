/-- The actual seed-response Euler is generated by the original inverse after both true endpoints are paid. -/
theorem actual_gap_response_Euler_source :
 actualGapResponseEuler=(1/2:ℂ) • actualGapResponse+
 (1+actualGapReturnEndpoint) • OriginalRieszSource.Response.u-
 actualGapEndpoint • OriginalRieszSource.Response.v :=by
 have first:=actual_gap_response_ward
 have second:=actual_gap_return_ward
 have drive:=actual_gap_response_euler_step
 have etaB:EulerPaid.endpointReaction actualGapResponseRaw=
  actualGapEndpoint • OriginalRieszSource.Response.eta:=by
  unfold EulerPaid.endpointReaction
  rw [actual_gap_response_endpoints,←smul_add]
  rfl
 have etaT:EulerPaid.endpointReaction actualGapReturnRaw=
  actualGapReturnEndpoint • OriginalRieszSource.Response.eta:=by
  unfold EulerPaid.endpointReaction
  rw [actual_gap_return_endpoints,←smul_add]
  rfl
 rw [etaB] at first
 rw [etaT] at second
 have generated : L actualGapResponseEuler=
  (1/2:ℂ) • actualGapSource+
  (1+actualGapReturnEndpoint) • OriginalRieszSource.Response.eta-
  actualGapEndpoint • T OriginalRieszSource.Response.eta :=by
  change actualGapResponseEuler-T (T actualGapResponseEuler)=_
  have returned:=eq_sub_of_add_eq first
  have returnt:=eq_sub_of_add_eq second
  rw [returnt,returned,map_sub,map_smul,actual_gap_source_Euler] at drive
  linear_combination (norm:=module) drive
 have vsource : L OriginalRieszSource.Response.v=T OriginalRieszSource.Response.eta :=by
  have source:=congrArg T OriginalRieszSource.Response.u_equation
  change T (OriginalRieszSource.Response.u-T (T OriginalRieszSource.Response.u))=_ at source
  rw [map_sub] at source
  exact source
 have candidate : L ((1/2:ℂ) • actualGapResponse+
   (1+actualGapReturnEndpoint) • OriginalRieszSource.Response.u-
   actualGapEndpoint • OriginalRieszSource.Response.v)=
  (1/2:ℂ) • actualGapSource+
  (1+actualGapReturnEndpoint) • OriginalRieszSource.Response.eta-
  actualGapEndpoint • T OriginalRieszSource.Response.eta :=by
  rw [map_sub,map_add,map_smul,map_smul,map_smul,actual_gap_response_equation,
   OriginalRieszSource.Response.u_equation,vsource]
 have inverseLeft:burnolMeanZeroBlockInverse*L=1:=Ring.inverse_mul_cancel _ burnolMeanZeroOneMinusSquare_isUnit
 have solved:=congrArg burnolMeanZeroBlockInverse (generated.trans candidate.symm)
 change (burnolMeanZeroBlockInverse*L) actualGapResponseEuler=(burnolMeanZeroBlockInverse*L) _ at solved
 rw [inverseLeft] at solved
 exact solved

