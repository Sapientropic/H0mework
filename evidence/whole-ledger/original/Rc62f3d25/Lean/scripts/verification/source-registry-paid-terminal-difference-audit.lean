private def directDependencies (info : ConstantInfo) (includeType : Bool) : Array Name := Id.run do
 let mut result := if includeType then info.type.getUsedConstants else #[]
 if let some value := info.value? (allowOpaque := true) then result := result ++ value.getUsedConstants
 match info with
 | .inductInfo value => result := result ++ value.ctors.toArray
 | .recInfo value => for rule in value.rules do result := result ++ rule.rhs.getUsedConstants
 | _ => pure ()
 return result
private partial def dependencyClosure (env : Environment) (includeType : Bool) (pending : List Name) (seen : NameSet := {}) : NameSet :=
 match pending with
 | [] => seen
 | name :: rest =>
  if seen.contains name then dependencyClosure env includeType rest seen
  else
   let children := match env.find? name with | some info => (directDependencies info includeType).toList | none => []
   dependencyClosure env includeType (children ++ rest) (seen.insert name)
