import Mathlib.Algebra.Category.ModuleCat.Abelian
import Mathlib.Algebra.Category.ModuleCat.Biproducts
import Mathlib.Algebra.Homology.DerivedCategory.Basic
import H0mework.Realization.Arithmetic.AdicCofiberFace

/-!
# Root-generated derived adic cofiber

An actual chain transition on one exact root occurrence canonically generates
its mapping cocone and distinguished derived triangle.  No caller supplies a
cofiber, exact triangle, ShortExact receipt, quasi-isomorphism, perfect model,
truncation or determinant data.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace DerivedAdicCofiber

open CategoryTheory
open CategoryTheory.Limits
open CategoryTheory.Pretriangulated
open DerivedAdicCofiberAxiomFreeCore

noncomputable section

attribute [local instance] HasDerivedCategory.standard

universe w

abbrev IntegralCochainComplex (R : Type) [CommRing R] :=
  CochainComplex (ModuleCat.{0} R) ℤ

/-- Root-owned actual chain transition. -/
structure RootGeneratedDerivedAdicCofiberAt
    {Root : Type w} {R : Type} [CommRing R]
    (rootOccurrence : RootedAccountedUnfolding Root)
    (sourceOccurrence : RootedAccountedUnfolding
      (IntegralCochainComplex R))
    (targetOccurrence : RootedAccountedUnfolding
      (IntegralCochainComplex R))
    (transitionOccurrence : RootedAccountedUnfolding
      (sourceOccurrence.root ⟶ targetOccurrence.root)) : Type where
  private mk ::
  core : RootGeneratedDerivedTransitionIncidenceAt rootOccurrence
    sourceOccurrence targetOccurrence transitionOccurrence

namespace RootGeneratedDerivedAdicCofiberAt

variable {Root : Type w} {R : Type} [CommRing R]
variable {rootOccurrence : RootedAccountedUnfolding Root}
variable {sourceOccurrence targetOccurrence : RootedAccountedUnfolding
  (IntegralCochainComplex R)}
variable {transitionOccurrence : RootedAccountedUnfolding
  (sourceOccurrence.root ⟶ targetOccurrence.root)}

def generate : RootGeneratedDerivedAdicCofiberAt rootOccurrence
    sourceOccurrence targetOccurrence transitionOccurrence :=
  ⟨RootGeneratedDerivedTransitionIncidenceAt.generate⟩

def root
    (_face : RootGeneratedDerivedAdicCofiberAt rootOccurrence
      sourceOccurrence targetOccurrence transitionOccurrence) :=
  rootOccurrence

def sourceComplex
    (_face : RootGeneratedDerivedAdicCofiberAt rootOccurrence
      sourceOccurrence targetOccurrence transitionOccurrence) :=
  sourceOccurrence.root

def targetComplex
    (_face : RootGeneratedDerivedAdicCofiberAt rootOccurrence
      sourceOccurrence targetOccurrence transitionOccurrence) :=
  targetOccurrence.root

def actualTransition
    (_face : RootGeneratedDerivedAdicCofiberAt rootOccurrence
      sourceOccurrence targetOccurrence transitionOccurrence) :
    sourceOccurrence.root ⟶ targetOccurrence.root :=
  transitionOccurrence.root

/-- Canonical cofiber complex generated by the actual transition. -/
noncomputable def cofiberComplex
    (face : RootGeneratedDerivedAdicCofiberAt rootOccurrence
      sourceOccurrence targetOccurrence transitionOccurrence) :
    IntegralCochainComplex R :=
  CochainComplex.mappingCocone face.actualTransition

def cofiberOccurrence
    (face : RootGeneratedDerivedAdicCofiberAt rootOccurrence
      sourceOccurrence targetOccurrence transitionOccurrence) :
    RootedAccountedUnfolding (IntegralCochainComplex R) :=
  RootedAccountedUnfolding.zero face.cofiberComplex

/-- Canonical triangle `cofiber → source → target → cofiber[1]`. -/
noncomputable def triangle
    (face : RootGeneratedDerivedAdicCofiberAt rootOccurrence
      sourceOccurrence targetOccurrence transitionOccurrence) :
    Triangle (IntegralCochainComplex R) :=
  CochainComplex.mappingCocone.triangle face.actualTransition

/-- The same triangle installed in the derived category. -/
noncomputable def derivedTriangle
    (face : RootGeneratedDerivedAdicCofiberAt rootOccurrence
      sourceOccurrence targetOccurrence transitionOccurrence) :
    Triangle (DerivedCategory (ModuleCat.{0} R)) :=
  DerivedCategory.Q.mapTriangle.obj face.triangle

/-- Derived exact-triangle authority is generated from the actual chain map;
there is no ShortExact or distinguished-triangle premise. -/
theorem derivedTriangle_distinguished
    (face : RootGeneratedDerivedAdicCofiberAt rootOccurrence
      sourceOccurrence targetOccurrence transitionOccurrence) :
    face.derivedTriangle ∈
      distTriang (DerivedCategory (ModuleCat.{0} R)) :=
  DerivedCategory.mappingCocone_triangle_distinguished face.actualTransition

/-- A map which is invertible in the derived category kills its generated
cofiber.  This is the quasi-isomorphism-strength statement: chain-level
invertibility is not required. -/
theorem derivedCofiber_isZero_of_derivedIsIso
    (face : RootGeneratedDerivedAdicCofiberAt rootOccurrence
      sourceOccurrence targetOccurrence transitionOccurrence)
    [IsIso (DerivedCategory.Q.map face.actualTransition)] :
    IsZero face.derivedTriangle.obj₁ := by
  apply face.derivedTriangle.isZero₁_of_isIso₂
    face.derivedTriangle_distinguished
  change IsIso (DerivedCategory.Q.map face.actualTransition)
  infer_instance

/-- Strict chain isomorphisms remain a generated restriction of the stronger
derived-isomorphism mouth. -/
theorem derivedCofiber_isZero_of_isIso
    (face : RootGeneratedDerivedAdicCofiberAt rootOccurrence
      sourceOccurrence targetOccurrence transitionOccurrence)
    [IsIso face.actualTransition] :
    IsZero face.derivedTriangle.obj₁ := by
  let _ : IsIso (DerivedCategory.Q.map face.actualTransition) :=
    Functor.map_isIso DerivedCategory.Q face.actualTransition
  exact face.derivedCofiber_isZero_of_derivedIsIso

@[simp] theorem triangle_mor₁
    (face : RootGeneratedDerivedAdicCofiberAt rootOccurrence
      sourceOccurrence targetOccurrence transitionOccurrence) :
    face.triangle.mor₁ = CochainComplex.mappingCocone.fst face.actualTransition :=
  rfl

@[simp] theorem triangle_mor₂
    (face : RootGeneratedDerivedAdicCofiberAt rootOccurrence
      sourceOccurrence targetOccurrence transitionOccurrence) :
    face.triangle.mor₂ = face.actualTransition :=
  rfl

theorem factors_through_axiomFreeCore
    (face : RootGeneratedDerivedAdicCofiberAt rootOccurrence
      sourceOccurrence targetOccurrence transitionOccurrence) :
    face.core.root = rootOccurrence ∧
      face.core.source = sourceOccurrence ∧
      face.core.target = targetOccurrence ∧
      face.core.transition = transitionOccurrence :=
  face.core.preserves_occurrences

theorem preserves_actual_transition
    (face : RootGeneratedDerivedAdicCofiberAt rootOccurrence
      sourceOccurrence targetOccurrence transitionOccurrence) :
    face.root = rootOccurrence ∧
      face.sourceComplex = sourceOccurrence.root ∧
      face.targetComplex = targetOccurrence.root ∧
      face.actualTransition = transitionOccurrence.root :=
  ⟨rfl, rfl, rfl, rfl⟩

end RootGeneratedDerivedAdicCofiberAt

end

end DerivedAdicCofiber
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
