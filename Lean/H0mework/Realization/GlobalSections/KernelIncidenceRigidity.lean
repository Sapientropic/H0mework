import H0mework.Realization.GlobalSections.PrimePowerRigidity
import H0mework.Realization.GlobalSections.AdditiveFamily

/-!
# Root-generated prime-power kernel-incidence rigidity

An actual additive evaluator is accompanied by its source-generated zero,
addition, and prime-power division incidences.  The generic engine turns the
relation incidences into the additive map, computes its source kernel, and
uses finite-generation rigidity to prove that kernel is zero.  Coverage of
the evaluator's source component is then generated by range restriction.

The mouth accepts no injectivity, surjectivity, equivalence, residual-zero,
rigidity, basis, or determinant certificate.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace PrimePowerKernelIncidenceRigidity

open AdditiveFamilyFaithfulRealization
open AdditiveFamilyFaithfulRealization.RootGeneratedAdditiveFamilyFaithfulRealizationAt
open FinitelyGeneratedPrimePowerRigidity

noncomputable section

universe u v w

/-- Actual evaluator and its source-native relation incidences.  The final
field returns an actual division root with its landing relation; it is not an
injectivity or rigidity statement. -/
structure PrimePowerKernelIncidenceAt
    (Generator : Type u) (Carrier : Type v)
    [AddCommGroup Generator] [AddCommGroup Carrier] : Type (max u v) where
  evaluator : Generator → Carrier
  zeroLanding : evaluator 0 = 0
  additionLanding : ∀ left right,
    evaluator (left + right) = evaluator left + evaluator right
  finiteGenerated : AddGroup.FG Generator
  divisionRoot : ∀ (element : Generator), evaluator element = 0 →
    ∀ (prime : Nat.Primes) (exponent : Nat), 0 < exponent →
      { root : Generator //
        (prime : Nat) ^ exponent • root = element }

/-- One exact common-root occurrence of the actual incidence material. -/
structure RootGeneratedPrimePowerKernelIncidenceRigidityAt
    {Root : Type w} {Generator : Type u} {Carrier : Type v}
    [AddCommGroup Generator] [AddCommGroup Carrier]
    (dependentOccurrence : RootedAccountedUnfolding
      (Root × PrimePowerKernelIncidenceAt Generator Carrier)) :
    Type (max u v w) where
  private mk ::

namespace RootGeneratedPrimePowerKernelIncidenceRigidityAt

variable {Root : Type w} {Generator : Type u} {Carrier : Type v}
variable [AddCommGroup Generator] [AddCommGroup Carrier]
variable {dependentOccurrence : RootedAccountedUnfolding
  (Root × PrimePowerKernelIncidenceAt Generator Carrier)}

def generate : RootGeneratedPrimePowerKernelIncidenceRigidityAt
    dependentOccurrence :=
  ⟨⟩

def root
    (_face : RootGeneratedPrimePowerKernelIncidenceRigidityAt
      dependentOccurrence) : RootedAccountedUnfolding Root :=
  dependentOccurrence.map Prod.fst

def materialOccurrence
    (_face : RootGeneratedPrimePowerKernelIncidenceRigidityAt
      dependentOccurrence) :
    RootedAccountedUnfolding
      (PrimePowerKernelIncidenceAt Generator Carrier) :=
  dependentOccurrence.map Prod.snd

def actualMaterial
    (face : RootGeneratedPrimePowerKernelIncidenceRigidityAt
      dependentOccurrence) :
    PrimePowerKernelIncidenceAt Generator Carrier :=
  face.materialOccurrence.root

def evaluatorOccurrence
    (_face : RootGeneratedPrimePowerKernelIncidenceRigidityAt
      dependentOccurrence) :
    RootedAccountedUnfolding (Root × (Generator → Carrier)) :=
  dependentOccurrence.map fun point ↦
    (point.1, point.2.evaluator)

def faithfulFace
    (face : RootGeneratedPrimePowerKernelIncidenceRigidityAt
      dependentOccurrence) :
    RootGeneratedAdditiveFamilyFaithfulRealizationAt
      face.evaluatorOccurrence :=
  RootGeneratedAdditiveFamilyFaithfulRealizationAt.generate

@[simp] theorem actualMaterial_eq
    (face : RootGeneratedPrimePowerKernelIncidenceRigidityAt
      dependentOccurrence) :
    face.actualMaterial = dependentOccurrence.root.2 := by
  simp [actualMaterial, materialOccurrence]

@[simp] theorem actualEvaluator_eq
    (face : RootGeneratedPrimePowerKernelIncidenceRigidityAt
      dependentOccurrence) :
    face.faithfulFace.actualEvaluator =
      face.actualMaterial.evaluator := by
  unfold faithfulFace
    RootGeneratedAdditiveFamilyFaithfulRealizationAt.actualEvaluator
    RootGeneratedAdditiveFamilyFaithfulRealizationAt.evaluatorOccurrence
    evaluatorOccurrence actualMaterial materialOccurrence
  simp

theorem additiveLaws
    (face : RootGeneratedPrimePowerKernelIncidenceRigidityAt
      dependentOccurrence) :
    face.faithfulFace.AdditiveLaws :=
  by
    rw [RootGeneratedAdditiveFamilyFaithfulRealizationAt.AdditiveLaws,
      face.actualEvaluator_eq]
    exact ⟨face.actualMaterial.zeroLanding,
      face.actualMaterial.additionLanding⟩

theorem additiveCalculation
    (face : RootGeneratedPrimePowerKernelIncidenceRigidityAt
      dependentOccurrence) :
    GeneratedAdditiveCalculationAt face.faithfulFace :=
  face.faithfulFace.generatedAdditiveCalculation face.additiveLaws

/-- Kernel rigidity is calculated from actual division-root incidences. -/
theorem evaluator_eq_zero_implies_element_zero
    (face : RootGeneratedPrimePowerKernelIncidenceRigidityAt
      dependentOccurrence)
    (element : Generator)
    (evaluatorZero : face.actualMaterial.evaluator element = 0) :
    element = 0 :=
  eq_zero_of_prime_power_divisible
    face.actualMaterial.finiteGenerated element
      (fun prime exponent exponentPositive ↦
        let root := face.actualMaterial.divisionRoot element evaluatorZero
          prime exponent exponentPositive
        ⟨root.1, root.2⟩)

theorem additiveMap_injective
    (face : RootGeneratedPrimePowerKernelIncidenceRigidityAt
      dependentOccurrence) :
    Function.Injective
      (face.faithfulFace.additiveMap face.additiveCalculation) := by
  let additiveMap := face.faithfulFace.additiveMap face.additiveCalculation
  apply (injective_iff_map_eq_zero additiveMap).mpr
  intro element evaluatorZero
  have materialEvaluatorZero :
      face.actualMaterial.evaluator element = 0 := by
    change face.faithfulFace.actualEvaluator element = 0 at evaluatorZero
    simpa only [face.actualEvaluator_eq] using evaluatorZero
  exact face.evaluator_eq_zero_implies_element_zero
    element materialEvaluatorZero

theorem evaluator_injective
    (face : RootGeneratedPrimePowerKernelIncidenceRigidityAt
      dependentOccurrence) :
    Function.Injective face.actualMaterial.evaluator := by
  rw [← face.actualEvaluator_eq]
  exact face.additiveMap_injective

theorem sourceKernelResidualVanishes
    (face : RootGeneratedPrimePowerKernelIncidenceRigidityAt
      dependentOccurrence) :
    face.faithfulFace.SourceKernelResidualVanishes
      face.additiveCalculation := by
  apply (AddMonoidHom.ker_eq_bot_iff _).mpr
  intro left right equal
  apply face.additiveMap_injective
  exact congrArg Subtype.val equal

theorem sourceKernelResidualZero
    (face : RootGeneratedPrimePowerKernelIncidenceRigidityAt
      dependentOccurrence) :
    GeneratedSourceKernelResidualZeroAt face.faithfulFace
      face.additiveCalculation := by
  cases face.faithfulFace.settleSourceComponent
      face.additiveCalculation with
  | kernelObstruction obstruction =>
      exact False.elim
        (obstruction.persists face.sourceKernelResidualVanishes)
  | faithful residualZero => exact residualZero

noncomputable def canonicalSourceComponentEquiv
    (face : RootGeneratedPrimePowerKernelIncidenceRigidityAt
      dependentOccurrence) :=
  face.faithfulFace.canonicalSourceComponentEquiv face.additiveCalculation
    face.sourceKernelResidualZero

theorem preserves_shared_root_and_actual_relations
    (face : RootGeneratedPrimePowerKernelIncidenceRigidityAt
      dependentOccurrence) :
    face.root = dependentOccurrence.map Prod.fst ∧
      face.materialOccurrence = dependentOccurrence.map Prod.snd ∧
      face.faithfulFace.actualEvaluator =
        face.actualMaterial.evaluator ∧
      face.faithfulFace.SourceKernelResidualVanishes
        face.additiveCalculation :=
  ⟨rfl, rfl, face.actualEvaluator_eq,
    face.sourceKernelResidualVanishes⟩

end RootGeneratedPrimePowerKernelIncidenceRigidityAt

end

end PrimePowerKernelIncidenceRigidity
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
