import H0mework.Realization.FiniteCell.IncidenceAdequacy
import H0mework.Realization.FiniteCell.DerivedAdequacy

/-!
# Root-generated dependent derived global state

A dependent family of stage/place/prime complexes is not a family of
independent arithmetic states.  One actual shared occurrence of the root and
its diagram first generates a single coherent limit-realization carrier.
Every fixed index is then a restriction map from that carrier; canonical
perfect compression and the determinant line attach only to the global
carrier.

The limit carrier is not thereby identified with the motivic integral
perfect complex or `Δ(M)`, and it is not thereby adequate/perfect.  Those are
later faithful-realization, gluing and residual-zero obligations.

An additional local modification (for example a real-place 2-primary
modification or truncation) is installed as an actual transform of one raw
restriction.  The generic engine generates its composite global restriction
and mapping-cofiber face.  It never assumes that the raw homogeneous-cochain
leaf is already perfect.

The mouth accepts no separately owned root/diagram pair, chosen global object,
compatible family, limit cone, stage selection, per-prime determinant,
perfectness, or transform cofiber.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace DependentDerivedGlobalState

open CategoryTheory
open CategoryTheory.Limits
open CochainComplex.HomComplex
open CanonicalFiniteFrontierCompression
open CanonicalFiniteFrontierCompression.RootGeneratedCanonicalFiniteFrontierCompressionAt
open CanonicalFrontierDeterminant
open DerivedAdicCofiber
open FiniteAtomIncidenceAdequacy
open FiniteAtomIncidenceAdequacy.RootGeneratedFiniteAtomIncidenceAt
open FiniteAtomDerivedCofiberAdequacy
open FiniteAtomDerivedCofiberAdequacy.RootGeneratedFiniteAtomDerivedCofiberAdequacyAt
open DerivedCofiberContraction
open DerivedCofiberContraction.RootGeneratedDerivedCofiberContractionAt

noncomputable section

universe j w

/-- One exact shared occurrence of a root and its dependent diagram.  Both
projections retain the same finite exposure tree. -/
structure RootGeneratedDependentDerivedGlobalStateAt
    {Index : Type j} [Category Index]
    {Root : Type w}
    (dependentOccurrence : RootedAccountedUnfolding
      (Root × (Index ⥤ IntegralCochainComplex ℤ))) : Type (max j w) where
  private mk ::

namespace RootGeneratedDependentDerivedGlobalStateAt

variable {Index : Type j} [Category Index]
variable {Root : Type w}
variable {dependentOccurrence : RootedAccountedUnfolding
  (Root × (Index ⥤ IntegralCochainComplex ℤ))}

def generate : RootGeneratedDependentDerivedGlobalStateAt
    dependentOccurrence :=
  ⟨⟩

def root
    (_face : RootGeneratedDependentDerivedGlobalStateAt
      dependentOccurrence) : RootedAccountedUnfolding Root :=
  dependentOccurrence.map Prod.fst

def diagramOccurrence
    (_face : RootGeneratedDependentDerivedGlobalStateAt
      dependentOccurrence) : RootedAccountedUnfolding
      (Index ⥤ IntegralCochainComplex ℤ) :=
  dependentOccurrence.map Prod.snd

def actualDiagram
    (face : RootGeneratedDependentDerivedGlobalStateAt
      dependentOccurrence) :=
  face.diagramOccurrence.root

/-- The coherent global realization carrier generated by the actual
diagram. -/
noncomputable def globalState
    (face : RootGeneratedDependentDerivedGlobalStateAt
      dependentOccurrence)
    [HasLimit face.actualDiagram] : IntegralCochainComplex ℤ :=
  limit face.actualDiagram

noncomputable def globalStateOccurrence
    (face : RootGeneratedDependentDerivedGlobalStateAt
      dependentOccurrence)
    [HasLimit face.actualDiagram] :
    RootedAccountedUnfolding (IntegralCochainComplex ℤ) :=
  RootedAccountedUnfolding.zero face.globalState

noncomputable def globalCone
    (face : RootGeneratedDependentDerivedGlobalStateAt
      dependentOccurrence)
    [HasLimit face.actualDiagram] : Cone face.actualDiagram :=
  limit.cone face.actualDiagram

noncomputable def globalStateIsLimit
    (face : RootGeneratedDependentDerivedGlobalStateAt
      dependentOccurrence)
    [HasLimit face.actualDiagram] : IsLimit face.globalCone :=
  limit.isLimit face.actualDiagram

/-- Every dependent member is a restriction of the same global state. -/
noncomputable def restriction
    (face : RootGeneratedDependentDerivedGlobalStateAt
      dependentOccurrence)
    [HasLimit face.actualDiagram] (index : Index) :
    face.globalState ⟶ face.actualDiagram.obj index :=
  limit.π face.actualDiagram index

noncomputable def restrictionOccurrence
    (face : RootGeneratedDependentDerivedGlobalStateAt
      dependentOccurrence)
    [HasLimit face.actualDiagram] (index : Index) :
    RootedAccountedUnfolding
      (face.globalState ⟶ face.actualDiagram.obj index) :=
  RootedAccountedUnfolding.zero (face.restriction index)

theorem restriction_naturality
    (face : RootGeneratedDependentDerivedGlobalStateAt
      dependentOccurrence)
    [HasLimit face.actualDiagram]
    {source target : Index} (arrow : source ⟶ target) :
    face.restriction source ≫ face.actualDiagram.map arrow =
      face.restriction target :=
  limit.w face.actualDiagram arrow

/-- The conditional canonical compression classifier is attached once, to
the global carrier.  This definition does not assert a positive branch. -/
noncomputable def globalCompression
    (face : RootGeneratedDependentDerivedGlobalStateAt
      dependentOccurrence)
    [HasLimit face.actualDiagram] :
    RootGeneratedCanonicalFiniteFrontierCompressionAt face.root
      face.globalStateOccurrence :=
  RootGeneratedCanonicalFiniteFrontierCompressionAt.generate

/-- A positive global compression token generates one determinant state;
restrictions do not generate sibling determinants. -/
noncomputable def globalDeterminant
    (face : RootGeneratedDependentDerivedGlobalStateAt
      dependentOccurrence)
    [HasLimit face.actualDiagram]
    (settlement : ClassifiedAdequateFrontierAt face.globalCompression) :
    CanonicalFrontierDeterminant.RootGeneratedCanonicalFrontierDeterminantAt
      face.globalCompression settlement :=
  CanonicalFrontierDeterminant.RootGeneratedCanonicalFrontierDeterminantAt.generate

/-- Optional sufficient restriction: a finite graded-atom occurrence is
interpreted only on the unique global carrier, never on a chosen restriction.
The general global perfectness mouth does not require such a trace. -/
noncomputable def globalFiniteAtomIncidence
    (face : RootGeneratedDependentDerivedGlobalStateAt
      dependentOccurrence)
    [HasLimit face.actualDiagram]
    (atomOccurrence : RootedAccountedUnfolding
      (ActualCochainAtomAt face.globalState)) :
    RootGeneratedFiniteAtomIncidenceAt face.globalCompression
      atomOccurrence :=
  RootGeneratedFiniteAtomIncidenceAt.generate

/-- In the finite-degreewise-spanning restriction, a successful source
calculation on the global atom occurrence generates the global adequate
frontier. -/
noncomputable def globalAdequateFrontier
    (face : RootGeneratedDependentDerivedGlobalStateAt
      dependentOccurrence)
    [HasLimit face.actualDiagram]
    {atomOccurrence : RootedAccountedUnfolding
      (ActualCochainAtomAt face.globalState)}
    (calculation : GeneratedAdequacyCalculationAt
      (face.globalFiniteAtomIncidence atomOccurrence)) :
    ClassifiedAdequateFrontierAt face.globalCompression :=
  (face.globalFiniteAtomIncidence atomOccurrence).adequateFrontier calculation

/-- On this sufficient restriction, only the source-generated positive global
calculation can activate the single determinant carrier. -/
noncomputable def globalDeterminantFromAtoms
    (face : RootGeneratedDependentDerivedGlobalStateAt
      dependentOccurrence)
    [HasLimit face.actualDiagram]
    {atomOccurrence : RootedAccountedUnfolding
      (ActualCochainAtomAt face.globalState)}
    (calculation : GeneratedAdequacyCalculationAt
      (face.globalFiniteAtomIncidence atomOccurrence)) :
    CanonicalFrontierDeterminant.RootGeneratedCanonicalFrontierDeterminantAt
      face.globalCompression (face.globalAdequateFrontier calculation) :=
  face.globalDeterminant (face.globalAdequateFrontier calculation)

/-- Generalized finite-trace cofiber restriction.  The trace is closed under
the actual differential, while the caller supplies only a raw degree `-1`
cochain on the generated residual. -/
noncomputable def globalFiniteAtomDerivedCofiberAdequacy
    (face : RootGeneratedDependentDerivedGlobalStateAt
      dependentOccurrence)
    [HasLimit face.actualDiagram]
    (atomOccurrence : RootedAccountedUnfolding
      (ActualCochainAtomAt face.globalState))
    (cochainOccurrence : RootedAccountedUnfolding
      (Cochain
        (traceDerivedFace (compression := face.globalCompression)
          (atomOccurrence := atomOccurrence)).cofiberComplex
        (traceDerivedFace (compression := face.globalCompression)
          (atomOccurrence := atomOccurrence)).cofiberComplex (-1))) :
    RootGeneratedFiniteAtomDerivedCofiberAdequacyAt
      face.globalCompression atomOccurrence cochainOccurrence :=
  RootGeneratedFiniteAtomDerivedCofiberAdequacyAt.generate

/-- A generated positive `δh = 𝟙` calculation activates one adequate frontier
without raw degreewise surjectivity. -/
noncomputable def globalAdequateFrontierFromCofiberCalculation
    (face : RootGeneratedDependentDerivedGlobalStateAt
      dependentOccurrence)
    [HasLimit face.actualDiagram]
    {atomOccurrence : RootedAccountedUnfolding
      (ActualCochainAtomAt face.globalState)}
    {cochainOccurrence : RootedAccountedUnfolding
      (Cochain
        (traceDerivedFace (compression := face.globalCompression)
          (atomOccurrence := atomOccurrence)).cofiberComplex
        (traceDerivedFace (compression := face.globalCompression)
          (atomOccurrence := atomOccurrence)).cofiberComplex (-1))}
    (calculation : GeneratedCofiberContractionCalculationAt
      (face.globalFiniteAtomDerivedCofiberAdequacy atomOccurrence
        cochainOccurrence).contractionFace) :
    ClassifiedAdequateFrontierAt face.globalCompression :=
  (face.globalFiniteAtomDerivedCofiberAdequacy atomOccurrence
    cochainOccurrence).adequateFrontier calculation

noncomputable def globalDeterminantFromCofiberCalculation
    (face : RootGeneratedDependentDerivedGlobalStateAt
      dependentOccurrence)
    [HasLimit face.actualDiagram]
    {atomOccurrence : RootedAccountedUnfolding
      (ActualCochainAtomAt face.globalState)}
    {cochainOccurrence : RootedAccountedUnfolding
      (Cochain
        (traceDerivedFace (compression := face.globalCompression)
          (atomOccurrence := atomOccurrence)).cofiberComplex
        (traceDerivedFace (compression := face.globalCompression)
          (atomOccurrence := atomOccurrence)).cofiberComplex (-1))}
    (calculation : GeneratedCofiberContractionCalculationAt
      (face.globalFiniteAtomDerivedCofiberAdequacy atomOccurrence
        cochainOccurrence).contractionFace) :
    CanonicalFrontierDeterminant.RootGeneratedCanonicalFrontierDeterminantAt
      face.globalCompression
        (face.globalAdequateFrontierFromCofiberCalculation
          (atomOccurrence := atomOccurrence)
          (cochainOccurrence := cochainOccurrence) calculation) :=
  face.globalDeterminant
    (face.globalAdequateFrontierFromCofiberCalculation
      (atomOccurrence := atomOccurrence)
      (cochainOccurrence := cochainOccurrence) calculation)

theorem preserves_one_global_carrier
    (face : RootGeneratedDependentDerivedGlobalStateAt
      dependentOccurrence)
    [HasLimit face.actualDiagram] (index : Index) :
    face.root = dependentOccurrence.map Prod.fst ∧
      face.actualDiagram = (dependentOccurrence.map Prod.snd).root ∧
      face.root.root = dependentOccurrence.root.1 ∧
      face.actualDiagram = dependentOccurrence.root.2 ∧
      face.globalStateOccurrence.root = face.globalState ∧
      (face.restrictionOccurrence index).root = face.restriction index :=
  ⟨rfl, rfl, RootedAccountedUnfolding.root_map _ _,
    RootedAccountedUnfolding.root_map _ _, rfl, rfl⟩

end RootGeneratedDependentDerivedGlobalStateAt

/-- One generated transform of a raw dependent restriction, installed before
any perfectness claim for that leaf. -/
structure RootGeneratedDependentRestrictionTransformAt
    {Index : Type j} [Category Index]
    {Root : Type w}
    {dependentOccurrence : RootedAccountedUnfolding
      (Root × (Index ⥤ IntegralCochainComplex ℤ))}
    (globalFace : RootGeneratedDependentDerivedGlobalStateAt
      dependentOccurrence)
    (index : Index)
    (targetOccurrence : RootedAccountedUnfolding
      (IntegralCochainComplex ℤ))
    (transformOccurrence : RootedAccountedUnfolding
      (globalFace.actualDiagram.obj index ⟶ targetOccurrence.root)) :
    Type (max j w) where
  private mk ::

namespace RootGeneratedDependentRestrictionTransformAt

variable {Index : Type j} [Category Index]
variable {Root : Type w}
variable {dependentOccurrence : RootedAccountedUnfolding
  (Root × (Index ⥤ IntegralCochainComplex ℤ))}
variable {globalFace : RootGeneratedDependentDerivedGlobalStateAt
  dependentOccurrence}
variable {index : Index}
variable {targetOccurrence : RootedAccountedUnfolding
  (IntegralCochainComplex ℤ)}
variable {transformOccurrence : RootedAccountedUnfolding
  (globalFace.actualDiagram.obj index ⟶ targetOccurrence.root)}

def generate : RootGeneratedDependentRestrictionTransformAt globalFace
    index targetOccurrence transformOccurrence :=
  ⟨⟩

def rawOccurrence
    (_face : RootGeneratedDependentRestrictionTransformAt globalFace
      index targetOccurrence transformOccurrence) :
    RootedAccountedUnfolding (IntegralCochainComplex ℤ) :=
  RootedAccountedUnfolding.zero (globalFace.actualDiagram.obj index)

def actualTransform
    (_face : RootGeneratedDependentRestrictionTransformAt globalFace
      index targetOccurrence transformOccurrence) :=
  transformOccurrence.root

noncomputable def installedRestriction
    (_face : RootGeneratedDependentRestrictionTransformAt globalFace
      index targetOccurrence transformOccurrence)
    [HasLimit globalFace.actualDiagram] :
    globalFace.globalState ⟶ targetOccurrence.root :=
  globalFace.restriction index ≫ transformOccurrence.root

noncomputable def installedRestrictionOccurrence
    (face : RootGeneratedDependentRestrictionTransformAt globalFace
      index targetOccurrence transformOccurrence)
    [HasLimit globalFace.actualDiagram] :
    RootedAccountedUnfolding
      (globalFace.globalState ⟶ targetOccurrence.root) :=
  RootedAccountedUnfolding.zero face.installedRestriction

/-- Mapping-cofiber authority of the raw-to-modified restriction transform;
no raw perfectness is assumed. -/
def derivedTransform
    (face : RootGeneratedDependentRestrictionTransformAt globalFace
      index targetOccurrence transformOccurrence) :
    RootGeneratedDerivedAdicCofiberAt globalFace.root face.rawOccurrence
      targetOccurrence transformOccurrence :=
  RootGeneratedDerivedAdicCofiberAt.generate

theorem installedRestriction_factors_through_global
    (face : RootGeneratedDependentRestrictionTransformAt globalFace
      index targetOccurrence transformOccurrence)
    [HasLimit globalFace.actualDiagram] :
    face.installedRestriction =
      globalFace.restriction index ≫ face.actualTransform ∧
      face.derivedTransform.actualTransition = face.actualTransform ∧
      face.derivedTransform.root = globalFace.root :=
  ⟨rfl, rfl, rfl⟩

end RootGeneratedDependentRestrictionTransformAt

end

end DependentDerivedGlobalState
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
