/-
  Proposition 149: irreversibility of the predictive time arrow.

  The requested slogan is:

      prediction is a forward arrow Past -> Future;
      if that arrow dissipates information (is non-injective), no backward
      recall arrow Future -> Past can be obtained by composing more prediction.

  This file proves the algebraic core:

    * a map with a left inverse is injective;
    * therefore a non-injective prediction admits no backward recall;
    * once a non-injective prefix has collapsed two pasts, composing any later
      tail after it cannot restore injectivity;
    * finite iterates of a non-injective endomap remain non-injective after
      the first step and admit no backward recall;
    * adding an explicit trace/source handle, by contrast, makes the
      prediction left-invertible.

  Boundary: the "finite or transfinite" language is represented by the
  arbitrary-tail theorem.  It covers any continuation that factors through the
  collapsed predictive prefix.  It does not formalize ordinal-indexed dynamics
  as a separate object.
-/

import H0mework.Realization.Reflexive.P148

/-! ## Prediction, recall, and information dissipation -/

/-- A prediction arrow is just the forward map.  Keeping it as a structure
lets the theorem names read like the memory-language statement. -/
structure PredictionArrow (Past Future : Type*) where
  predict : Past -> Future

/-- A map dissipates information when it collapses distinguishable inputs. -/
def InformationDissipating {Past Future : Type*} (f : Past -> Future) : Prop :=
  ¬ Function.Injective f

/-- Backward recall for a forward map means a genuine left inverse. -/
def HasBackwardRecall {Past Future : Type*} (f : Past -> Future) : Prop :=
  exists retrieve : Future -> Past, Function.LeftInverse retrieve f

/-- THEOREM 1: any forward map with a backward recall arrow is injective. -/
theorem backwardRecall_injective
    {Past Future : Type*} {f : Past -> Future}
    (h : HasBackwardRecall f) :
    Function.Injective f := by
  rcases h with ⟨retrieve, hretrieve⟩
  intro x y hxy
  calc
    x = retrieve (f x) := (hretrieve x).symm
    _ = retrieve (f y) := by rw [hxy]
    _ = y := hretrieve y

/-- THEOREM 2: a non-injective prediction arrow has no backward recall arrow.
This is the core irreversibility theorem. -/
theorem informationDissipating_no_backwardRecall
    {Past Future : Type*} (f : Past -> Future)
    (h : InformationDissipating f) :
    ¬ HasBackwardRecall f := by
  intro hrecall
  exact h (backwardRecall_injective hrecall)

/-- A packaged form for `PredictionArrow`. -/
theorem predictionArrow_no_backwardRecall
    {Past Future : Type*} (P : PredictionArrow Past Future)
    (h : InformationDissipating P.predict) :
    ¬ HasBackwardRecall P.predict :=
  informationDissipating_no_backwardRecall P.predict h

/-! ## Later prediction cannot undo an already collapsed prefix -/

/-- THEOREM 3: if a predictive prefix is non-injective, composing any later
tail after it is still non-injective.  Once two pasts have been collapsed, no
future-only continuation can separate them again. -/
theorem noninjective_prefix_remains_noninjective_under_tail
    {Past Mid Future : Type*}
    (pre : Past -> Mid) (tail : Mid -> Future)
    (hpre : InformationDissipating pre) :
    InformationDissipating (fun x => tail (pre x)) := by
  intro hcomp
  exact hpre (by
    intro x y hxy
    exact hcomp (congrArg tail hxy))

/-- THEOREM 4: no arbitrary continuation after a non-injective predictive
prefix can acquire backward recall to the original past.  This is the
factor-through-collapsed-prefix version of "no amount of later prediction,
finite or otherwise, creates recollection." -/
theorem noninjective_prefix_no_backwardRecall_after_tail
    {Past Mid Future : Type*}
    (pre : Past -> Mid) (tail : Mid -> Future)
    (hpre : InformationDissipating pre) :
    ¬ HasBackwardRecall (fun x => tail (pre x)) := by
  exact informationDissipating_no_backwardRecall
    (fun x => tail (pre x))
    (noninjective_prefix_remains_noninjective_under_tail
      pre tail hpre)

/-! ## Finite forward prediction chains -/

/-- A finite forward chain generated by repeatedly applying the same
prediction step. -/
def finiteForward {State : Type*} (step : State -> State) :
    Nat -> State -> State
  | 0 => fun x => x
  | Nat.succ n => fun x => finiteForward step n (step x)

/-- THEOREM 5: after at least one step, every finite iterate of a non-injective
prediction step is non-injective. -/
theorem finiteForward_noninjective_succ
    {State : Type*} (step : State -> State)
    (hstep : InformationDissipating step) (n : Nat) :
    InformationDissipating (finiteForward step (Nat.succ n)) := by
  exact noninjective_prefix_remains_noninjective_under_tail
    step (finiteForward step n) hstep

/-- THEOREM 6: no nonempty finite prediction chain generated by a
non-injective step has a backward recall arrow. -/
theorem finiteForward_no_backwardRecall_succ
    {State : Type*} (step : State -> State)
    (hstep : InformationDissipating step) (n : Nat) :
    ¬ HasBackwardRecall (finiteForward step (Nat.succ n)) := by
  exact informationDissipating_no_backwardRecall
    (finiteForward step (Nat.succ n))
    (finiteForward_noninjective_succ step hstep n)

/-! ## Trace write-back as the local inverse-creating work -/

/-- Prediction plus an explicit trace/source handle.  This is the minimal
mathematical form of write-back: the future carries the original source handle
instead of asking prediction alone to reconstruct it. -/
def traceIndexedPrediction {Past Future : Type*}
    (predict : Past -> Future) : Past -> Future × Past :=
  fun x => (predict x, x)

/-- The backward read supplied by an explicit trace/source handle. -/
def traceRecall {Past Future : Type*} : Future × Past -> Past :=
  Prod.snd

/-- THEOREM 7: trace-indexed prediction has a backward recall arrow. -/
theorem traceIndexedPrediction_has_backwardRecall
    {Past Future : Type*} (predict : Past -> Future) :
    HasBackwardRecall (traceIndexedPrediction predict) := by
  refine ⟨traceRecall, ?_⟩
  intro x
  rfl

/-- THEOREM 8: trace-indexed prediction is injective even when the prediction
component alone is not. -/
theorem traceIndexedPrediction_injective
    {Past Future : Type*} (predict : Past -> Future) :
    Function.Injective (traceIndexedPrediction predict) := by
  exact backwardRecall_injective
    (traceIndexedPrediction_has_backwardRecall predict)

/-- THEOREM 9: a lossy prediction component can coexist with a reversible
trace-indexed arrow.  The reversal is supplied by the trace, not by prediction
itself. -/
theorem dissipating_prediction_traceIndexed_recall
    {Past Future : Type*} (predict : Past -> Future)
    (_h : InformationDissipating predict) :
    HasBackwardRecall (traceIndexedPrediction predict) :=
  traceIndexedPrediction_has_backwardRecall predict

/-!
  Summary:
  - `informationDissipating_no_backwardRecall` proves the time-arrow theorem:
    non-injective prediction cannot be inverted into recall.
  - `noninjective_prefix_no_backwardRecall_after_tail` is the strong
    continuation form: later prediction cannot undo an already collapsed
    prefix.
  - `finiteForward_no_backwardRecall_succ` gives the finite-chain corollary.
  - `traceIndexedPrediction_has_backwardRecall` formalizes the positive
    contrast: write-back/source handles create the local order needed for
    backward reachability; prediction alone does not.
-/
