/-
  Proposition 71: a reflexive loop canonically induces a time-field step.

  Proposition 55 deliberately kept the memory-field side independent: a
  `RecollectionTimeStep` had to carry two mechanism-faithfulness fields,
  `observe_eq_read` and `next_section_eq_write`.  That was the right boundary
  while the geometric side was still being separated from the reflexive algebra.

  This file closes the local canonical case.  Any reflexive read/write query,
  at any starting state, induces a two-point time-indexed field:

      now   ↦ x
      after ↦ write x
      observe := read

  Therefore the two P55 fields are no longer assumptions for this generated
  edge; they are theorems by construction.  This does not say that every
  independent runtime memory field is definitionally generated by a reflexive
  query.  It says that every reflexive/recollection loop has a canonical
  time-field landing site, so the read/write algebra naturally advances a
  section along time.
-/

import H0mework.Realization.Fields.TimeIndexedMemory

/-! ## Canonical two-point time generated by a reflexive read/write loop -/

/-- The local time axis generated by one reflexive step. -/
inductive CanonicalReflexiveTime where
  | now
  | after
  deriving DecidableEq, Repr

/-- The time-indexed field canonically generated by a reflexive query at a
starting state.  It is the smallest geometric landing site for the loop:
current section at `now`, written section at `after`, and observation equal to
the query read. -/
def canonicalReflexiveTimeField
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State) :
    TimeMemoryField CanonicalReflexiveTime State Observation where
  stateAt
    | CanonicalReflexiveTime.now => x
    | CanonicalReflexiveTime.after => q.write x
  observe := q.read

/-- Temporal holonomy on the canonical field generated by a reflexive query. -/
def CanonicalReflexiveTemporalHolonomy
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State) : Prop :=
  (canonicalReflexiveTimeField q x).observe
      ((canonicalReflexiveTimeField q x).stateAt
        CanonicalReflexiveTime.after) ≠
    (canonicalReflexiveTimeField q x).observe
      ((canonicalReflexiveTimeField q x).stateAt
        CanonicalReflexiveTime.now)

/-- THEOREM 1: the generated time field observes by the reflexive query's read.
This is the first P55 mechanism field, now derived rather than supplied. -/
theorem canonicalReflexiveTimeField_observe_eq_read
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x y : State) :
    (canonicalReflexiveTimeField q x).observe y = q.read y := by
  rfl

/-- THEOREM 2: the generated next section is the reflexive query's write.  This
is the second P55 mechanism field, now derived rather than supplied. -/
theorem canonicalReflexiveTimeField_after_eq_write
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State) :
    (canonicalReflexiveTimeField q x).stateAt
        CanonicalReflexiveTime.after =
      q.write ((canonicalReflexiveTimeField q x).stateAt
        CanonicalReflexiveTime.now) := by
  rfl

/-- THEOREM 3: on the generated time field, temporal holonomy is exactly the
local reflexive λ obstruction.  This is the adapter-free local bridge: read
after write differs from read before write iff the generated field has
observation holonomy. -/
theorem canonicalReflexiveTemporalHolonomy_iff_obstruction
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State) :
    CanonicalReflexiveTemporalHolonomy q x <->
      ReflexiveLambdaObstruction q x := by
  rfl

/-- THEOREM 4: canonical temporal holonomy gives the usual no-go reason for an
unguarded/global reflexive λ. -/
theorem canonicalReflexiveTemporalHolonomy_no_unguarded_lambda
    {State Observation Obstruction : Type*}
    (q : ReflexiveQuery State Observation) (x : State)
    (hhol : CanonicalReflexiveTemporalHolonomy q x) :
    UnguardedLambdaCertificate State Observation Obstruction q -> False := by
  exact no_unguarded_lambda_of_observation_change q
    ⟨x, (canonicalReflexiveTemporalHolonomy_iff_obstruction q x).mp hhol⟩

/-! ## Canonical P55 recollection time step generated by a trace loop -/

/-- Any recollection trace loop, at any current state, induces the P55
`RecollectionTimeStep` over the canonical two-point time axis. -/
def canonicalRecollectionTimeStep
    {State Observation ActAtom TraceAtom : Type*}
    (loop : RecollectionTraceLoop State Observation ActAtom TraceAtom)
    (x : State) :
    RecollectionTimeStep CanonicalReflexiveTime State Observation ActAtom
      TraceAtom where
  field := canonicalReflexiveTimeField loop.query x
  loop := loop
  now := CanonicalReflexiveTime.now
  next := CanonicalReflexiveTime.after
  observe_eq_read := by
    intro y
    rfl
  next_section_eq_write := by
    rfl

/-- THEOREM 5: the canonical recollection time step satisfies the P55
observation/read field definitionally. -/
theorem canonicalRecollectionTimeStep_observe_eq_read
    {State Observation ActAtom TraceAtom : Type*}
    (loop : RecollectionTraceLoop State Observation ActAtom TraceAtom)
    (x y : State) :
    (canonicalRecollectionTimeStep loop x).field.observe y =
      loop.query.read y := by
  rfl

/-- THEOREM 6: the canonical recollection time step satisfies the P55
next/write field definitionally. -/
theorem canonicalRecollectionTimeStep_next_eq_write
    {State Observation ActAtom TraceAtom : Type*}
    (loop : RecollectionTraceLoop State Observation ActAtom TraceAtom)
    (x : State) :
    (canonicalRecollectionTimeStep loop x).field.stateAt
        (canonicalRecollectionTimeStep loop x).next =
      loop.query.write
        ((canonicalRecollectionTimeStep loop x).field.stateAt
          (canonicalRecollectionTimeStep loop x).now) := by
  rfl

/-- THEOREM 7: P55 theorem 1 becomes unconditional for the canonical edge
generated by any recollection trace loop. -/
theorem canonicalRecollectionTimeStep_holonomy_iff_obstruction
    {State Observation ActAtom TraceAtom : Type*}
    (loop : RecollectionTraceLoop State Observation ActAtom TraceAtom)
    (x : State) :
    TemporalObservationHolonomy (canonicalRecollectionTimeStep loop x) <->
      ReflexiveLambdaObstruction loop.query x := by
  exact temporal_holonomy_iff_reflexive_obstruction
    (canonicalRecollectionTimeStep loop x)

/-- THEOREM 8: if the recollection act fires at the current state, the
canonical generated edge has trace potential at its next section. -/
theorem canonicalRecollectionTimeStep_firing_installs_trace
    {State Observation ActAtom TraceAtom : Type*}
    (loop : RecollectionTraceLoop State Observation ActAtom TraceAtom)
    (x : State) (atom : ActAtom)
    (hfire : loop.act.fires x atom) :
    TemporalTracePotential (canonicalRecollectionTimeStep loop x) := by
  exact recollection_firing_installs_trace_at_next
    (canonicalRecollectionTimeStep loop x) atom hfire

/-- THEOREM 9: canonical recollection holonomy rules out an unguarded/global
λ for the underlying query. -/
theorem canonicalRecollectionTimeStep_no_unguarded_lambda
    {State Observation ActAtom TraceAtom Obstruction : Type*}
    (loop : RecollectionTraceLoop State Observation ActAtom TraceAtom)
    (x : State)
    (hhol : TemporalObservationHolonomy
      (canonicalRecollectionTimeStep loop x)) :
    UnguardedLambdaCertificate State Observation Obstruction loop.query ->
      False := by
  exact temporal_holonomy_no_unguarded_lambda
    (canonicalRecollectionTimeStep loop x) hhol

/-!
  Summary:
  - Every `ReflexiveQuery` canonically generates a two-point time field.
  - Every `RecollectionTraceLoop` canonically generates the corresponding P55
    `RecollectionTimeStep`.
  - The P55 `observe_eq_read` and `next_section_eq_write` fields are theorems
    for that canonical generated edge.
  - The independent-memory-field case remains intentionally nontrivial: a real
    runtime field still has to prove that its own time edge is this generated
    edge, or supply a separate mechanism certificate.
-/
