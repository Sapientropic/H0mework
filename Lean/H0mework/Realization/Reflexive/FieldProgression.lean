/-
  Proposition 80: reflexive loops induce canonical time-field progression.

  Proposition 55 stated the time-field theorem for an already certified
  `RecollectionTimeStep`; its two mechanism fields (`observe_eq_read` and
  `next_section_eq_write`) were part of that certificate.  Proposition 71 then
  constructed the canonical generated edge.  This file packages that construction
  as the explicit "no extra adapter" theorem:

      every reflexive read/write loop naturally induces a two-point memory
      field whose observation is the read and whose next section is the write.

  Boundary: this is the canonical generated edge.  It does not say that every
  independently specified runtime memory field is globally generated by a
  reflexive query.  For arbitrary runtime fields, Proposition 75 remains the
  local converse: once a runtime supplies a certified recollection edge, its
  local two-point restriction is forced to be the generated edge.
-/

import H0mework.Realization.Reflexive.LoopRestriction

/-! ## Reflexive queries generate time-field progression -/

/-- The canonical time-field progression generated by a reflexive query.

The construction uses Proposition 72's canonical trace loop, so the input is
only the reflexive read/write query and the current state. -/
def reflexiveQueryGeneratedTimeStep
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State) :
    RecollectionTimeStep CanonicalReflexiveTime State Observation
      RecollectionAtom RecollectionAtom :=
  canonicalReflexiveStepOf q x

/-- THEOREM 1: any reflexive query induces a time field whose observation map is
the query read.  This is the P55 `observe_eq_read` field as a theorem for the
generated edge. -/
theorem reflexiveQueryGenerated_observe_eq_read
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x y : State) :
    (reflexiveQueryGeneratedTimeStep q x).field.observe y = q.read y := by
  rfl

/-- THEOREM 2: any reflexive query induces a next time section equal to the
query write.  This is the P55 `next_section_eq_write` field as a theorem for
the generated edge. -/
theorem reflexiveQueryGenerated_next_eq_write
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State) :
    (reflexiveQueryGeneratedTimeStep q x).field.stateAt
        (reflexiveQueryGeneratedTimeStep q x).next =
      q.write
        ((reflexiveQueryGeneratedTimeStep q x).field.stateAt
          (reflexiveQueryGeneratedTimeStep q x).now) := by
  rfl

/-- THEOREM 3: P55's temporal-holonomy theorem is unconditional on the canonical
edge generated by any reflexive query. -/
theorem reflexiveQueryGenerated_holonomy_iff_obstruction
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State) :
    TemporalObservationHolonomy (reflexiveQueryGeneratedTimeStep q x) <->
      ReflexiveLambdaObstruction q x := by
  exact canonicalRecollectionTimeStep_holonomy_iff_obstruction
    (canonicalReflexiveTraceLoop q) x

/-- THEOREM 4: on the generated edge, temporal holonomy is exactly recollectable
memory potential for the canonical recollection act. -/
theorem reflexiveQueryGenerated_holonomy_iff_recollectable
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State) :
    TemporalObservationHolonomy (reflexiveQueryGeneratedTimeStep q x) <->
      RecollectableMemoryPotential (reflexiveRecollectionAct q) x := by
  exact canonicalTemporalHolonomy_iff_recollectablePotential q x

/-- THEOREM 5: generated temporal holonomy installs future trace at the next
time section. -/
theorem reflexiveQueryGenerated_holonomy_installs_trace
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State)
    (hhol : TemporalObservationHolonomy
      (reflexiveQueryGeneratedTimeStep q x)) :
    TemporalTracePotential (reflexiveQueryGeneratedTimeStep q x) := by
  exact canonicalTemporalHolonomy_installs_trace q x hhol

/-! ## Recollection trace loops generate the same progression directly -/

/-- The canonical time-field progression generated by a recollection trace loop.

This version keeps the loop's own act and trace atoms instead of replacing them
with the canonical `RecollectionAtom` trace loop. -/
def recollectionLoopGeneratedTimeStep
    {State Observation ActAtom TraceAtom : Type*}
    (loop : RecollectionTraceLoop State Observation ActAtom TraceAtom)
    (x : State) :
    RecollectionTimeStep CanonicalReflexiveTime State Observation ActAtom
      TraceAtom :=
  canonicalRecollectionTimeStep loop x

/-- THEOREM 6: any recollection trace loop induces a time field whose observation
map is its query read. -/
theorem recollectionLoopGenerated_observe_eq_read
    {State Observation ActAtom TraceAtom : Type*}
    (loop : RecollectionTraceLoop State Observation ActAtom TraceAtom)
    (x y : State) :
    (recollectionLoopGeneratedTimeStep loop x).field.observe y =
      loop.query.read y := by
  rfl

/-- THEOREM 7: any recollection trace loop induces a next time section equal to
its query write. -/
theorem recollectionLoopGenerated_next_eq_write
    {State Observation ActAtom TraceAtom : Type*}
    (loop : RecollectionTraceLoop State Observation ActAtom TraceAtom)
    (x : State) :
    (recollectionLoopGeneratedTimeStep loop x).field.stateAt
        (recollectionLoopGeneratedTimeStep loop x).next =
      loop.query.write
        ((recollectionLoopGeneratedTimeStep loop x).field.stateAt
          (recollectionLoopGeneratedTimeStep loop x).now) := by
  rfl

/-- THEOREM 8: P55's temporal-holonomy theorem is unconditional on the canonical
edge generated by any recollection trace loop. -/
theorem recollectionLoopGenerated_holonomy_iff_obstruction
    {State Observation ActAtom TraceAtom : Type*}
    (loop : RecollectionTraceLoop State Observation ActAtom TraceAtom)
    (x : State) :
    TemporalObservationHolonomy (recollectionLoopGeneratedTimeStep loop x) <->
      ReflexiveLambdaObstruction loop.query x := by
  exact canonicalRecollectionTimeStep_holonomy_iff_obstruction loop x

/-- THEOREM 9: if the loop's recollection act fires, the generated edge has
trace potential at its next section. -/
theorem recollectionLoopGenerated_firing_installs_trace
    {State Observation ActAtom TraceAtom : Type*}
    (loop : RecollectionTraceLoop State Observation ActAtom TraceAtom)
    (x : State) (atom : ActAtom)
    (hfire : loop.act.fires x atom) :
    TemporalTracePotential (recollectionLoopGeneratedTimeStep loop x) := by
  exact canonicalRecollectionTimeStep_firing_installs_trace
    loop x atom hfire

/-! ## Local converse remains exact -/

/-- THEOREM 10: any separately certified recollection time edge restricts to the
canonical generated progression of its own loop and current section. -/
theorem certifiedStep_restricts_to_generated_progression
    {Time State Observation ActAtom TraceAtom : Type*}
    (S : RecollectionTimeStep Time State Observation ActAtom TraceAtom) :
    localCanonicalFieldOfStep S =
      (recollectionLoopGeneratedTimeStep S.loop (S.field.stateAt S.now)).field := by
  exact localCanonicalFieldOfStep_eq_generated S

/-!
  Summary:
  - `ReflexiveQuery` and `RecollectionTraceLoop` now have named canonical
    time-field progression constructors.
  - The two P55 mechanism fields are theorems for these generated progressions.
  - Temporal holonomy on the generated edge is unconditionally the local
    reflexive obstruction; for the canonical trace loop it is also recollectable
    potential and installs future trace.
  - The global/runtime boundary is preserved: an independent field must still
    supply a certified edge, but Proposition 75 proves such an edge has no local
    freedom beyond the generated progression.
-/
