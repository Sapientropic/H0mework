/-
  Proposition 98: reflexive loops generate an iterated time-field section.

  Proposition 80 closed the local edge: a reflexive read/write loop generates a
  two-point recollection time step, so the P55 mechanism fields are theorems on
  that edge.  This file lifts the same construction from one edge to the
  canonical `Nat`-indexed time field:

      stateAt 0       = x
      stateAt (n + 1) = write (stateAt n)
      observe         = read

  Thus a reflexive loop does not merely supply an isolated local edge.  It
  generates a whole temporal section by iterating its write map, and every
  adjacent edge of that section is the P55 recollection step forced by the loop.

  Boundary: this is still the canonical generated field of the loop.  It does
  not claim that every independently supplied runtime memory field is globally
  generated by iteration; runtime fields still need a mechanism certificate or a
  restriction proof back to these generated edges.
-/

import H0mework.Realization.Reflexive.FieldProgression

/-! ## The canonical Nat-indexed time field -/

/-- The canonical time-indexed memory field generated by iterating a reflexive
query's write map from an initial state. -/
def reflexiveQueryIteratedTimeField
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State) :
    TimeMemoryField Nat State Observation where
  stateAt := fun n => q.write^[n] x
  observe := q.read

/-- THEOREM 1: the generated temporal section starts at the supplied initial
state. -/
theorem reflexiveQueryIterated_stateAt_zero
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State) :
    (reflexiveQueryIteratedTimeField q x).stateAt 0 = x := by
  rfl

/-- THEOREM 2: the generated temporal section advances by the query write at
every adjacent time edge. -/
theorem reflexiveQueryIterated_stateAt_succ
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State) (n : Nat) :
    (reflexiveQueryIteratedTimeField q x).stateAt (Nat.succ n) =
      q.write ((reflexiveQueryIteratedTimeField q x).stateAt n) := by
  exact Function.iterate_succ_apply' q.write n x

/-- THEOREM 3: the generated temporal section observes by the query read. -/
theorem reflexiveQueryIterated_observe_eq_read
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x y : State) :
    (reflexiveQueryIteratedTimeField q x).observe y = q.read y := by
  rfl

/-! ## Every adjacent edge is a generated recollection step -/

/-- The adjacent recollection edge from time `n` to `n + 1` in the generated
Nat-indexed field. -/
def reflexiveQueryIteratedTimeStepAt
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State) (n : Nat) :
    RecollectionTimeStep Nat State Observation RecollectionAtom
      RecollectionAtom where
  field := reflexiveQueryIteratedTimeField q x
  loop := canonicalReflexiveTraceLoop q
  now := n
  next := Nat.succ n
  observe_eq_read := by
    intro y
    rfl
  next_section_eq_write := by
    exact reflexiveQueryIterated_stateAt_succ q x n

/-- THEOREM 4: P55's `observe = read` mechanism field is a theorem at every
adjacent edge of the generated Nat-indexed section. -/
theorem reflexiveQueryIteratedTimeStep_observe_eq_read
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State) (n : Nat)
    (y : State) :
    (reflexiveQueryIteratedTimeStepAt q x n).field.observe y =
      q.read y := by
  rfl

/-- THEOREM 5: P55's `next = write` mechanism field is a theorem at every
adjacent edge of the generated Nat-indexed section. -/
theorem reflexiveQueryIteratedTimeStep_next_eq_write
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State) (n : Nat) :
    (reflexiveQueryIteratedTimeStepAt q x n).field.stateAt
        (reflexiveQueryIteratedTimeStepAt q x n).next =
      q.write
        ((reflexiveQueryIteratedTimeStepAt q x n).field.stateAt
          (reflexiveQueryIteratedTimeStepAt q x n).now) := by
  exact reflexiveQueryIterated_stateAt_succ q x n

/-- THEOREM 6: temporal holonomy on the `n -> n+1` generated edge is exactly
the local reflexive obstruction at the `n`th section. -/
theorem reflexiveQueryIterated_holonomy_iff_obstruction_at
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State) (n : Nat) :
    TemporalObservationHolonomy
        (reflexiveQueryIteratedTimeStepAt q x n) <->
      ReflexiveLambdaObstruction q
        ((reflexiveQueryIteratedTimeField q x).stateAt n) := by
  exact temporal_holonomy_iff_reflexive_obstruction
    (reflexiveQueryIteratedTimeStepAt q x n)

/-- THEOREM 7: temporal holonomy on any generated edge is recollectable memory
potential for the canonical recollection act at that edge's current section. -/
theorem reflexiveQueryIterated_holonomy_iff_recollectable_at
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State) (n : Nat) :
    TemporalObservationHolonomy
        (reflexiveQueryIteratedTimeStepAt q x n) <->
      RecollectableMemoryPotential (reflexiveRecollectionAct q)
        ((reflexiveQueryIteratedTimeField q x).stateAt n) := by
  exact (reflexiveQueryIterated_holonomy_iff_obstruction_at q x n).trans
    (reflexiveObstruction_iff_recollectablePotential q
      ((reflexiveQueryIteratedTimeField q x).stateAt n))

/-- THEOREM 8: if the canonical recollection act fires at the `n`th section,
the generated edge from `n` to `n+1` has trace potential at its next section. -/
theorem reflexiveQueryIterated_firing_installs_trace_at
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State) (n : Nat)
    (hfire :
      (reflexiveRecollectionAct q).fires
        ((reflexiveQueryIteratedTimeField q x).stateAt n)
        RecollectionAtom.attentionActivated) :
    TemporalTracePotential (reflexiveQueryIteratedTimeStepAt q x n) := by
  exact recollection_firing_installs_trace_at_next
    (reflexiveQueryIteratedTimeStepAt q x n)
    RecollectionAtom.attentionActivated hfire

/-!
  Summary:
  - A reflexive query canonically generates a `Nat`-indexed time field by
    iterating its write map.
  - Every adjacent edge of that field is a P55 `RecollectionTimeStep` with the
    mechanism fields derived, not supplied.
  - Holonomy on each generated edge is exactly local reflexive obstruction and
    exactly recollectable potential for the canonical recollection act.
  - The remaining boundary is mechanism-faithfulness for independent runtime
    fields, not the generated temporal-section algebra itself.
-/
