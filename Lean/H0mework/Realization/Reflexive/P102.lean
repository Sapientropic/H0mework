/-
  Proposition 102: canonical reflexive holonomy is a coboundary on linear time;
  non-coboundary needs cyclic gluing data.

  The tempting final move in the reflexivity/memory story is to say:

      a reflexive loop generates a time field;
      its temporal holonomy is a Čech cocycle;
      the cocycle is not a coboundary.

  The first two clauses have a clean mathematical core.  The third does not
  follow for free.  On the canonical generated `Nat` time field, the additive
  observation-difference cochain is exactly the coboundary of the global
  observation potential

      t ↦ observe (stateAt t).

  So the generated linear-time field gives a cocycle, but it is exact.  A
  genuine H¹ obstruction needs extra cyclic / gluing data: for example a
  three-open cycle with no filled triple overlap and nonzero accumulated phase.

  This file proves both sides:

    * generated observation differences are coboundaries, hence cocycles;
    * a concrete three-cycle phase cochain is a cocycle and not a coboundary.

  Boundary: this does not prove that any concrete runtime reflexive loop
  supplies the cyclic gluing certificate.  It proves the exact mathematical
  shape of the missing certificate.
-/

import H0mework.Realization.Descent.P69
import H0mework.Realization.Reflexive.NaturalTime

/-! ## Linear-time observation differences are exact -/

/-- A simple additive cover where pair restrictions are identities and triple
restrictions are zero.  It is the right minimal target for saying "edge values
are differences of a global potential". -/
def identityPairZeroTripleCover (Index A : Type*) [AddCommGroup A] :
    CechAdditiveCover Index A where
  localToPairLeft := fun _ _ => AddMonoidHom.id A
  localToPairRight := fun _ _ => AddMonoidHom.id A
  pairToTriple01 := fun _ _ _ => 0
  pairToTriple02 := fun _ _ _ => 0
  pairToTriple12 := fun _ _ _ => 0
  coh0 := by
    intro i j k x
    simp
  coh1 := by
    intro i j k x
    simp
  coh2 := by
    intro i j k x
    simp

/-- The global observation potential of a time-indexed field with additive
observations. -/
def observationPotential
    {Time State A : Type*} [AddCommGroup A]
    (F : TimeMemoryField Time State A) : Time -> A :=
  fun t => F.observe (F.stateAt t)

/-- The additive observation-difference cochain induced by a time-indexed
field. -/
def observationDifferenceCochain
    {Time State A : Type*} [AddCommGroup A]
    (F : TimeMemoryField Time State A) : Time -> Time -> A :=
  fun i j => observationPotential F j - observationPotential F i

/-- THEOREM 1: observation differences on a generated time field are exactly
the Čech 0-coboundary of the global observation potential. -/
theorem observationDifferenceCochain_eq_d0
    {Time State A : Type*} [AddCommGroup A]
    (F : TimeMemoryField Time State A) :
    CechAdditiveCover.d0
        (identityPairZeroTripleCover Time A)
        (observationPotential F) =
      observationDifferenceCochain F := by
  funext i j
  rfl

/-- THEOREM 2: therefore every such observation-difference cochain is a
1-coboundary. -/
theorem observationDifferenceCochain_is_coboundary
    {Time State A : Type*} [AddCommGroup A]
    (F : TimeMemoryField Time State A) :
    CechAdditiveCover.OneCoboundary
      (identityPairZeroTripleCover Time A)
      (observationDifferenceCochain F) := by
  exact ⟨observationPotential F,
    (observationDifferenceCochain_eq_d0 F).symm⟩

/-- THEOREM 3: as a consequence, every such observation-difference cochain is
a 1-cocycle.  This is the pure mathematical "holonomy induces a cocycle" slice,
but it is exact on linear generated time. -/
theorem observationDifferenceCochain_is_cocycle
    {Time State A : Type*} [AddCommGroup A]
    (F : TimeMemoryField Time State A) :
    CechAdditiveCover.OneCocycle
      (identityPairZeroTripleCover Time A)
      (observationDifferenceCochain F) := by
  exact CechAdditiveCover.oneCoboundary_is_oneCocycle
    (identityPairZeroTripleCover Time A)
    (observationDifferenceCochain F)
    (observationDifferenceCochain_is_coboundary F)

/-- The observation-difference cochain of the canonical `Nat`-indexed field
generated by a reflexive query. -/
def reflexiveIteratedObservationCochain
    {State A : Type*} [AddCommGroup A]
    (q : ReflexiveQuery State A) (x : State) : Nat -> Nat -> A :=
  observationDifferenceCochain (reflexiveQueryIteratedTimeField q x)

/-- THEOREM 4: the canonical iterated reflexive time field's additive
observation-difference cochain is a coboundary. -/
theorem reflexiveIteratedObservationCochain_is_coboundary
    {State A : Type*} [AddCommGroup A]
    (q : ReflexiveQuery State A) (x : State) :
    CechAdditiveCover.OneCoboundary
      (identityPairZeroTripleCover Nat A)
      (reflexiveIteratedObservationCochain q x) := by
  exact observationDifferenceCochain_is_coboundary
    (reflexiveQueryIteratedTimeField q x)

/-- THEOREM 5: the canonical iterated reflexive time field's additive
observation-difference cochain is a cocycle. -/
theorem reflexiveIteratedObservationCochain_is_cocycle
    {State A : Type*} [AddCommGroup A]
    (q : ReflexiveQuery State A) (x : State) :
    CechAdditiveCover.OneCocycle
      (identityPairZeroTripleCover Nat A)
      (reflexiveIteratedObservationCochain q x) := by
  exact observationDifferenceCochain_is_cocycle
    (reflexiveQueryIteratedTimeField q x)

/-! ## A concrete cyclic non-coboundary witness -/

/-- Three opens arranged as a cycle. -/
inductive ThreeCycleTime where
  | t0
  | t1
  | t2
  deriving DecidableEq, Repr

/-- The three-cycle cover uses identity pair restrictions and zero triple
restrictions, representing a cycle with no filled triple-overlap face. -/
def threeCycleCover : CechAdditiveCover ThreeCycleTime Int :=
  identityPairZeroTripleCover ThreeCycleTime Int

/-- A phase cochain with nonzero accumulated phase around the cycle:
`0 -> 1` contributes 1, `1 -> 2` contributes 1, while `0 -> 2` contributes 0.
If it were a coboundary, transitivity of a global potential would force
`(0 -> 2) = (0 -> 1) + (1 -> 2)`. -/
def threeCyclePhaseCochain : ThreeCycleTime -> ThreeCycleTime -> Int
  | ThreeCycleTime.t0, ThreeCycleTime.t1 => 1
  | ThreeCycleTime.t1, ThreeCycleTime.t2 => 1
  | ThreeCycleTime.t0, ThreeCycleTime.t2 => 0
  | _, _ => 0

/-- THEOREM 6: the three-cycle phase cochain is a cocycle. -/
theorem threeCyclePhaseCocycle :
    CechAdditiveCover.OneCocycle
      threeCycleCover threeCyclePhaseCochain := by
  funext i j k
  simp [CechAdditiveCover.d1,
    threeCycleCover, identityPairZeroTripleCover]

/-- THEOREM 7: the three-cycle phase cochain is not a coboundary. -/
theorem threeCyclePhase_not_coboundary :
    Not (CechAdditiveCover.OneCoboundary
      threeCycleCover threeCyclePhaseCochain) := by
  intro hb
  rcases hb with ⟨s, hs⟩
  have h01 : s ThreeCycleTime.t1 - s ThreeCycleTime.t0 = 1 := by
    simpa [CechAdditiveCover.d0, threeCycleCover,
      identityPairZeroTripleCover, threeCyclePhaseCochain] using
      congrFun (congrFun hs ThreeCycleTime.t0) ThreeCycleTime.t1
  have h12 : s ThreeCycleTime.t2 - s ThreeCycleTime.t1 = 1 := by
    simpa [CechAdditiveCover.d0, threeCycleCover,
      identityPairZeroTripleCover, threeCyclePhaseCochain] using
      congrFun (congrFun hs ThreeCycleTime.t1) ThreeCycleTime.t2
  have h02 : s ThreeCycleTime.t2 - s ThreeCycleTime.t0 = 0 := by
    simpa [CechAdditiveCover.d0, threeCycleCover,
      identityPairZeroTripleCover, threeCyclePhaseCochain] using
      congrFun (congrFun hs ThreeCycleTime.t0) ThreeCycleTime.t2
  omega

/-- THEOREM 8: the three-cycle phase is a genuine H¹ obstruction in the P69
skeleton. -/
theorem threeCyclePhase_h1Obstruction :
    CechAdditiveCover.H1Obstruction
      threeCycleCover threeCyclePhaseCochain :=
  ⟨threeCyclePhaseCocycle, threeCyclePhase_not_coboundary⟩

/-!
  Summary:
  - A reflexive loop's canonical generated linear-time field gives an additive
    observation-difference cocycle, but that cocycle is exact.
  - Therefore `reflexivity ↔ memory` cannot get a nontrivial H¹ class from the
    generated line alone.
  - Non-coboundary is a separate cyclic/gluing certificate.  The three-cycle
    witness proves the pure mathematical shape: nonzero accumulated phase
    around an unfilled cycle is a cocycle that cannot be globally trivialized.
-/
