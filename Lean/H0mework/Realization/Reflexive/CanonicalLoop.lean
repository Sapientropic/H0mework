/-
  Proposition 72: canonical reflexive holonomy installs recollection trace.

  Proposition 71 proved that every reflexive read/write query has a canonical
  two-point time-field edge.  This file adds the matching canonical trace loop.

  The construction is intentionally minimal and not a runtime claim:

    * the recollection act is the canonical P51 act that fires when
      read-after-write changes observation;
    * a trace is available at a state exactly when that state is the write
      result of a firing predecessor.

  Thus in the generated/canonical case no external mechanism bridge is needed
  for the local statement:

      temporal holonomy
        ↔ reflexive λ obstruction
        ↔ recollectable potential
        → future trace.

  Boundary: this still does not say an independently specified runtime memory
  field or runtime trace surface is this canonical construction.  Such a field
  must prove equality to the generated edge/loop or provide a separate
  mechanism-faithfulness certificate.
-/

import H0mework.Realization.Fields.TimeHolonomy
import H0mework.Realization.Reflexive.TwoPointTime

/-! ## Canonical trace loop generated by a reflexive query -/

/-- Trace availability generated by a reflexive query: a trace atom is
available at `y` iff some predecessor `x` fired the canonical recollection act
and wrote to `y`. -/
def canonicalReflexiveTraceAvailable
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation)
    (y : State) (trace : RecollectionAtom) : Prop :=
  exists x, q.write x = y /\ (reflexiveRecollectionAct q).fires x trace

/-- Every reflexive query canonically generates a recollection trace loop. -/
def canonicalReflexiveTraceLoop
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) :
    RecollectionTraceLoop State Observation RecollectionAtom RecollectionAtom where
  query := q
  act := reflexiveRecollectionAct q
  traceAvailable := canonicalReflexiveTraceAvailable q
  traceOf := fun atom => atom
  installs := by
    intro x atom hfire
    exact ⟨x, rfl, hfire⟩

/-- THEOREM 1: firing the canonical recollection act installs the matching
trace after the query write. -/
theorem canonicalReflexiveTraceLoop_installs
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation)
    (x : State) (atom : RecollectionAtom)
    (hfire : (reflexiveRecollectionAct q).fires x atom) :
    (canonicalReflexiveTraceLoop q).traceAvailable
      (q.write x) atom := by
  exact ⟨x, rfl, hfire⟩

/-- THEOREM 2: local reflexive λ obstruction installs canonical future trace.
-/
theorem reflexiveObstruction_installs_canonical_trace
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State)
    (hobs : ReflexiveLambdaObstruction q x) :
    TracePotential (canonicalReflexiveTraceLoop q) (q.write x) := by
  exact RecollectionTraceLoop.firing_creates_future_trace_potential
    (canonicalReflexiveTraceLoop q) x RecollectionAtom.attentionActivated hobs

/-! ## Canonical time edge plus canonical trace loop -/

/-- The canonical time step generated by the canonical trace loop of a
reflexive query. -/
def canonicalReflexiveStepOf
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) :
    State ->
      RecollectionTimeStep CanonicalReflexiveTime State Observation
        RecollectionAtom RecollectionAtom :=
  fun x => canonicalRecollectionTimeStep (canonicalReflexiveTraceLoop q) x

/-- THEOREM 3: on the generated edge, temporal holonomy is exactly
recollectable potential for the canonical recollection act. -/
theorem canonicalTemporalHolonomy_iff_recollectablePotential
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State) :
    TemporalObservationHolonomy (canonicalReflexiveStepOf q x) <->
      RecollectableMemoryPotential (reflexiveRecollectionAct q) x := by
  calc
    TemporalObservationHolonomy (canonicalReflexiveStepOf q x) <->
        ReflexiveLambdaObstruction q x :=
      canonicalRecollectionTimeStep_holonomy_iff_obstruction
        (canonicalReflexiveTraceLoop q) x
    _ <-> RecollectableMemoryPotential (reflexiveRecollectionAct q) x :=
      reflexiveObstruction_iff_recollectablePotential q x

/-- THEOREM 4: canonical temporal holonomy installs trace at the next section
of the generated edge. -/
theorem canonicalTemporalHolonomy_installs_trace
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State)
    (hhol : TemporalObservationHolonomy (canonicalReflexiveStepOf q x)) :
    TemporalTracePotential (canonicalReflexiveStepOf q x) := by
  have hobs : ReflexiveLambdaObstruction q x :=
    (canonicalRecollectionTimeStep_holonomy_iff_obstruction
      (canonicalReflexiveTraceLoop q) x).mp hhol
  exact canonicalRecollectionTimeStep_firing_installs_trace
    (canonicalReflexiveTraceLoop q) x
    RecollectionAtom.attentionActivated hobs

/-! ## Canonical support preservation, with independence kept honest -/

/-- Atom equivalence between temporal holonomy and the canonical recollection
act. -/
def canonicalTemporalHolonomyRecollectionAtomEquiv :
    TemporalHolonomyAtom ≃ RecollectionAtom where
  toFun
    | TemporalHolonomyAtom.observationHolonomy =>
        RecollectionAtom.attentionActivated
  invFun
    | RecollectionAtom.attentionActivated =>
        TemporalHolonomyAtom.observationHolonomy
  left_inv := by
    intro atom
    cases atom
    rfl
  right_inv := by
    intro atom
    cases atom
    rfl

/-- THEOREM 5: on the canonical generated edge, field-side holonomy support is
definitionally the same event as canonical recollection-act firing. -/
theorem canonicalHolonomySupport_iff_recollectionFire
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State)
    (atom : TemporalHolonomyAtom) :
    StepTemporalHolonomySupport (canonicalReflexiveStepOf q) x atom <->
      StepRecollectionFireSupport (canonicalReflexiveStepOf q) x
        (canonicalTemporalHolonomyRecollectionAtomEquiv atom) := by
  cases atom
  calc
    StepTemporalHolonomySupport (canonicalReflexiveStepOf q) x
        TemporalHolonomyAtom.observationHolonomy <->
        TemporalObservationHolonomy (canonicalReflexiveStepOf q x) := by
      rfl
    _ <-> ReflexiveLambdaObstruction q x :=
      canonicalRecollectionTimeStep_holonomy_iff_obstruction
        (canonicalReflexiveTraceLoop q) x
    _ <-> (reflexiveRecollectionAct q).fires x
        RecollectionAtom.attentionActivated := by
      rfl
    _ <-> StepRecollectionFireSupport (canonicalReflexiveStepOf q) x
        RecollectionAtom.attentionActivated := by
      rfl

/-- THEOREM 6: if the generated holonomy support is independently realizable,
then the generated recollection support is independently realizable.  The
support-preservation part is no longer an external bridge; only the genuine
nondegeneracy/independence hypothesis remains. -/
theorem canonicalRecollectionSupport_independent_of_holonomy
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation)
    (h :
      SupportIndependent State TemporalHolonomyAtom
        (StepTemporalHolonomySupport (canonicalReflexiveStepOf q))) :
    SupportIndependent State RecollectionAtom
      (StepRecollectionFireSupport (canonicalReflexiveStepOf q)) := by
  intro assignment
  let leftAssignment : TemporalHolonomyAtom -> Prop :=
    fun atom => assignment (canonicalTemporalHolonomyRecollectionAtomEquiv atom)
  rcases h leftAssignment with ⟨x, hx⟩
  refine ⟨x, ?_⟩
  intro atom
  cases atom
  exact (canonicalHolonomySupport_iff_recollectionFire q x
    TemporalHolonomyAtom.observationHolonomy).symm.trans
      (hx TemporalHolonomyAtom.observationHolonomy)

/-- THEOREM 7: nontrivial generated holonomy support transports to nontrivial
generated recollection support. -/
theorem canonicalRecollectionSupport_nontrivial_of_holonomy
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation)
    (h :
      SupportNontrivial State TemporalHolonomyAtom
        (StepTemporalHolonomySupport (canonicalReflexiveStepOf q))) :
    SupportNontrivial State RecollectionAtom
      (StepRecollectionFireSupport (canonicalReflexiveStepOf q)) := by
  constructor
  · rcases h.1 with ⟨x, atom, hactive⟩
    cases atom
    exact ⟨x, RecollectionAtom.attentionActivated,
      (canonicalHolonomySupport_iff_recollectionFire q x
        TemporalHolonomyAtom.observationHolonomy).mp hactive⟩
  · rcases h.2 with ⟨x, hsilent⟩
    refine ⟨x, ?_⟩
    intro atom hfire
    cases atom
    exact hsilent TemporalHolonomyAtom.observationHolonomy
      ((canonicalHolonomySupport_iff_recollectionFire q x
        TemporalHolonomyAtom.observationHolonomy).mpr hfire)

/-- THEOREM 8: whenever the generated holonomy support is independent and
nontrivial, the canonical edge upgrades to the full P56 temporal holonomy
mechanism bridge without any separate support-preservation certificate. -/
def canonicalTemporalHolonomyMechanismBridge
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation)
    (hInd :
      SupportIndependent State TemporalHolonomyAtom
        (StepTemporalHolonomySupport (canonicalReflexiveStepOf q)))
    (hNon :
      SupportNontrivial State TemporalHolonomyAtom
        (StepTemporalHolonomySupport (canonicalReflexiveStepOf q))) :
    TemporalHolonomyMechanismBridge State CanonicalReflexiveTime State
      Observation RecollectionAtom RecollectionAtom where
  stepOf := canonicalReflexiveStepOf q
  iso :=
    { leftIndependent := hInd
      rightIndependent :=
        canonicalRecollectionSupport_independent_of_holonomy q hInd
      leftNontrivial := hNon
      rightNontrivial :=
        canonicalRecollectionSupport_nontrivial_of_holonomy q hNon
      atomEquiv := canonicalTemporalHolonomyRecollectionAtomEquiv
      support_iff := by
        intro x atom
        exact canonicalHolonomySupport_iff_recollectionFire q x atom }

/-!
  Summary:
  - `canonicalReflexiveTraceLoop` turns any reflexive query into a trace loop
    without an external runtime adapter.
  - On the generated time edge, temporal holonomy is exactly recollectable
    potential and installs future trace.
  - The P56 support-preservation bridge is canonical for generated edges.
    Only independence/nontriviality remain as honest hypotheses, because a
    degenerate query may have no active holonomy states at all.
-/
