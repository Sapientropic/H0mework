/-
  Proposition 75: local uniqueness of the canonical recollection time edge.

  Proposition 71 proved that every reflexive/recollection loop generates a
  canonical two-point time field.  This file proves the converse local
  uniqueness statement needed for the "memory as time-field activation" line:
  any `RecollectionTimeStep`, once it has supplied the P55 mechanism fields,
  restricts along its `(now, next)` edge to exactly that canonical two-point
  generated field.

  This does not make an arbitrary runtime memory field globally generated by a
  reflexive query.  It says something sharper and local: after a runtime has
  certified one recollection time edge, the local two-point geometry of that
  edge is forced.  There is no remaining freedom in `observe = read` or
  `next = write` on the edge itself.
-/

import H0mework.Realization.Reflexive.CanonicalLoop

/-! ## Restricting an arbitrary recollection edge to the canonical two points -/

/-- The local two-point field obtained by restricting an arbitrary
`RecollectionTimeStep` to its `(now, next)` edge. -/
def localCanonicalFieldOfStep
    {Time State Observation ActAtom TraceAtom : Type*}
    (S : RecollectionTimeStep Time State Observation ActAtom TraceAtom) :
    TimeMemoryField CanonicalReflexiveTime State Observation where
  stateAt
    | CanonicalReflexiveTime.now => S.field.stateAt S.now
    | CanonicalReflexiveTime.after => S.field.stateAt S.next
  observe := S.field.observe

/-- The canonical generated recollection edge determined by an arbitrary
`RecollectionTimeStep`'s own loop and current section. -/
def canonicalEdgeOfStep
    {Time State Observation ActAtom TraceAtom : Type*}
    (S : RecollectionTimeStep Time State Observation ActAtom TraceAtom) :
    RecollectionTimeStep CanonicalReflexiveTime State Observation ActAtom
      TraceAtom :=
  canonicalRecollectionTimeStep S.loop (S.field.stateAt S.now)

/-- THEOREM 1: any certified recollection time edge restricts to the canonical
two-point field generated by its loop and current section.  This is the local
uniqueness theorem for the generated time geometry. -/
theorem localCanonicalFieldOfStep_eq_generated
    {Time State Observation ActAtom TraceAtom : Type*}
    (S : RecollectionTimeStep Time State Observation ActAtom TraceAtom) :
    localCanonicalFieldOfStep S =
      canonicalReflexiveTimeField S.loop.query (S.field.stateAt S.now) := by
  cases S with
  | mk field loop now next observe_eq_read next_section_eq_write =>
      cases field with
      | mk stateAt observe =>
          simp [localCanonicalFieldOfStep, canonicalReflexiveTimeField]
          constructor
          · funext t
            cases t
            · rfl
            · exact next_section_eq_write
          · funext y
            exact observe_eq_read y

/-- THEOREM 2: the current point of the restricted edge is the original current
section. -/
theorem localCanonicalFieldOfStep_now
    {Time State Observation ActAtom TraceAtom : Type*}
    (S : RecollectionTimeStep Time State Observation ActAtom TraceAtom) :
    (localCanonicalFieldOfStep S).stateAt CanonicalReflexiveTime.now =
      S.field.stateAt S.now := by
  rfl

/-- THEOREM 3: the next point of the restricted edge is the original next
section, hence also the query write of the current section. -/
theorem localCanonicalFieldOfStep_after_eq_write
    {Time State Observation ActAtom TraceAtom : Type*}
    (S : RecollectionTimeStep Time State Observation ActAtom TraceAtom) :
    (localCanonicalFieldOfStep S).stateAt CanonicalReflexiveTime.after =
      S.loop.query.write (S.field.stateAt S.now) := by
  exact S.next_section_eq_write

/-! ## Transporting holonomy and trace potential across the local uniqueness -/

/-- THEOREM 4: temporal holonomy of any certified recollection edge is exactly
temporal holonomy of its canonical generated local edge. -/
theorem temporal_holonomy_iff_canonicalEdgeOfStep
    {Time State Observation ActAtom TraceAtom : Type*}
    (S : RecollectionTimeStep Time State Observation ActAtom TraceAtom) :
    TemporalObservationHolonomy S <->
      TemporalObservationHolonomy (canonicalEdgeOfStep S) := by
  calc
    TemporalObservationHolonomy S <->
        ReflexiveLambdaObstruction S.loop.query (S.field.stateAt S.now) :=
      temporal_holonomy_iff_reflexive_obstruction S
    _ <->
        TemporalObservationHolonomy (canonicalEdgeOfStep S) :=
      (canonicalRecollectionTimeStep_holonomy_iff_obstruction S.loop
        (S.field.stateAt S.now)).symm

/-- THEOREM 5: trace potential at the next point is unchanged by replacing a
certified recollection edge with its canonical generated local edge. -/
theorem temporal_tracePotential_iff_canonicalEdgeOfStep
    {Time State Observation ActAtom TraceAtom : Type*}
  (S : RecollectionTimeStep Time State Observation ActAtom TraceAtom) :
    TemporalTracePotential S <->
      TemporalTracePotential (canonicalEdgeOfStep S) := by
  simp [TemporalTracePotential, canonicalEdgeOfStep,
    canonicalRecollectionTimeStep, canonicalReflexiveTimeField,
    S.next_section_eq_write]

/-- THEOREM 6: if the original edge has temporal holonomy, then the canonical
generated local edge carries the same no-go reason for unguarded/global λ. -/
theorem canonicalEdgeOfStep_no_unguarded_lambda
    {Time State Observation ActAtom TraceAtom Obstruction : Type*}
    (S : RecollectionTimeStep Time State Observation ActAtom TraceAtom)
    (hhol : TemporalObservationHolonomy S) :
    UnguardedLambdaCertificate State Observation Obstruction S.loop.query ->
      False := by
  exact canonicalRecollectionTimeStep_no_unguarded_lambda S.loop
    (S.field.stateAt S.now)
    ((temporal_holonomy_iff_canonicalEdgeOfStep S).mp hhol)

/-!
  Summary:
  - `canonicalReflexiveTimeField` is not merely one convenient generated edge.
    It is the unique local two-point restriction of any certified
    `RecollectionTimeStep`.
  - Holonomy and trace potential are invariant under replacing a certified
    edge by this canonical local restriction.
  - The remaining mechanism-faithfulness debt is global: a runtime still has
    to produce a certified recollection time edge or prove its larger field
    restricts to one.  Once that edge exists, its local geometry is forced.
-/
