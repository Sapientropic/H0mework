import Mathlib.LinearAlgebra.Finsupp.Supported
import Mathlib.LinearAlgebra.FreeModule.PID
import Mathlib.LinearAlgebra.Isomorphisms
import H0mework.Foundation.Cofinal.CompressionFace
import H0mework.Realization.Determinant.FourTermProjection

/-!
# Root-generated cofinal presented-history settlement

The public source is an actual rooted finite-prefix occurrence: a seed
occurrence of generator/relation events and an actual continuation
occurrence.  Every finite support and relation stage is reconstructed from
the accumulated occurrence trace.  In particular, no caller-owned
`generatorSupport`, `relationStages`, or `relationSupported` record enters
the mouth.

Compactness is tested only after presentation.  The engine maps the stage
presented carrier to the cofinal presented completion and forms its cokernel
residual.  Generator and relation traces may both continue growing while
that residual vanishes.  On the compact branch, the kernel of the resulting
finite-free cover generates a two-term perfect replacement, its homology
equivalence with the same completion, determinant line, and integral unit
torsor.  Otherwise the engine returns the exact persistent non-vanishing
residual obstruction.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace CofinalHistorySettlement

open CofinalPerfectCompressionAxiomFreeCore
open PerfectComplexDeterminantProjection

noncomputable section

universe u w

/-- Actual atoms understood by the generic presentation adapter.  A
relation event brings its own finite support as part of the `Finsupp`; the
adapter automatically exposes every such support generator. -/
inductive PresentedRelationEventAt (Generator : Type u) : Type u
  | generator (value : Generator)
  | relation (value : Generator →₀ ℤ)

namespace PresentedRelationEventAt

variable {Generator : Type u}

noncomputable def support : PresentedRelationEventAt Generator → Finset Generator
  | .generator value => {value}
  | .relation value => value.support

end PresentedRelationEventAt

/-- Root-owned actual pro occurrence.  The cofinal family is not a completed
table supplied by the caller: it is generated by repeatedly advancing the
seed with the installed continuation occurrence. -/
structure RootGeneratedCofinalHistoryAt
    {Root : Type w} {Generator : Type u}
    (rootOccurrence : RootedAccountedUnfolding Root)
    (seedOccurrence : RootedAccountedUnfolding
      (PresentedRelationEventAt Generator))
    (continuationOccurrence : RootedAccountedUnfolding
      (PresentedRelationEventAt Generator →
        RootedAccountedUnfolding (PresentedRelationEventAt Generator))) : Type where
  private mk ::
  core : RootGeneratedCofinalCompressionIncidenceAt rootOccurrence
    (fun event : PresentedRelationEventAt Generator =>
      RootedAccountedUnfolding.zero event) continuationOccurrence

namespace RootGeneratedCofinalHistoryAt

variable {Root : Type w} {Generator : Type u}
variable {rootOccurrence : RootedAccountedUnfolding Root}
variable {seedOccurrence : RootedAccountedUnfolding
  (PresentedRelationEventAt Generator)}
variable {continuationOccurrence : RootedAccountedUnfolding
  (PresentedRelationEventAt Generator →
    RootedAccountedUnfolding (PresentedRelationEventAt Generator))}

/-- The caller installs actual occurrences only. -/
def generate : RootGeneratedCofinalHistoryAt rootOccurrence
    seedOccurrence continuationOccurrence :=
  ⟨RootGeneratedCofinalCompressionIncidenceAt.generate (fun _ => rfl)⟩

def root
    (_face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence) :=
  rootOccurrence

def seed
    (_face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence) :=
  seedOccurrence

def actualContinuation
    (_face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence) :=
  continuationOccurrence.root

/-- Canonical finite-prefix pro observation generated from the actual seed
and continuation. -/
def observation
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence) :
    Nat → RootedAccountedUnfolding (PresentedRelationEventAt Generator)
  | 0 => face.seed
  | stage + 1 => (face.observation stage).advance face.actualContinuation

@[simp] theorem observation_zero
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence) :
    face.observation 0 = face.seed :=
  rfl

@[simp] theorem observation_succ
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    (stage : Nat) :
    face.observation (stage + 1) =
      (face.observation stage).advance face.actualContinuation :=
  rfl

/-- Accumulated finite trace through a stage.  Accumulation makes historical
monotonicity a generic list fact; no domain monotonicity receipt is stored. -/
def observedEvents
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    (stage : Nat) : List (PresentedRelationEventAt Generator) :=
  (List.range (stage + 1)).flatMap
    (fun index => (face.observation index).trace)

theorem observedEvents_mono
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    {first later : Nat} (order : first ≤ later) :
    ∀ event, event ∈ face.observedEvents first →
      event ∈ face.observedEvents later := by
  intro event event_mem
  simp only [observedEvents, List.mem_flatMap, List.mem_range] at event_mem ⊢
  obtain ⟨index, index_lt, event_mem⟩ := event_mem
  exact ⟨index, lt_of_lt_of_le index_lt (Nat.succ_le_succ order), event_mem⟩

/-- Finite generator support read directly from the event trace.  Relation
supports are included automatically. -/
noncomputable def generatorSupport
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    (stage : Nat) : Finset Generator := by
  classical
  exact ((face.observedEvents stage).flatMap
    (fun event => event.support.toList)).toFinset

theorem generatorSupport_mono
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    {first later : Nat} (order : first ≤ later) :
    (face.generatorSupport first : Set Generator) ⊆
      face.generatorSupport later := by
  classical
  intro generator generator_mem
  change generator ∈ face.generatorSupport first at generator_mem
  change generator ∈ face.generatorSupport later
  rw [generatorSupport, List.mem_toFinset, List.mem_flatMap] at generator_mem ⊢
  obtain ⟨event, event_mem, generator_mem⟩ := generator_mem
  exact ⟨event, face.observedEvents_mono order event event_mem,
    generator_mem⟩

def generatorStage
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    (stage : Nat) : Submodule ℤ (Generator →₀ ℤ) :=
  Finsupp.supported ℤ ℤ (face.generatorSupport stage : Set Generator)

/-- Relations at a stage are the span of actual relation events in the
accumulated rooted trace. -/
def relationStage
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    (stage : Nat) : Submodule ℤ (Generator →₀ ℤ) :=
  Submodule.span ℤ
    { relation | PresentedRelationEventAt.relation relation ∈
      face.observedEvents stage }

theorem generatorStage_mono
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    {first later : Nat} (order : first ≤ later) :
    face.generatorStage first ≤ face.generatorStage later :=
  Finsupp.supported_mono (face.generatorSupport_mono order)

theorem relationStage_mono
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    {first later : Nat} (order : first ≤ later) :
    face.relationStage first ≤ face.relationStage later := by
  apply Submodule.span_mono
  intro relation relation_mem
  exact face.observedEvents_mono order _ relation_mem

theorem relationStage_le_generatorStage
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    (stage : Nat) :
    face.relationStage stage ≤ face.generatorStage stage := by
  classical
  apply Submodule.span_le.mpr
  intro relation relation_mem
  change relation ∈ Finsupp.supported ℤ ℤ
    (face.generatorSupport stage : Set Generator)
  rw [Finsupp.mem_supported]
  intro generator generator_mem
  change generator ∈ face.generatorSupport stage
  rw [generatorSupport, List.mem_toFinset, List.mem_flatMap]
  exact ⟨PresentedRelationEventAt.relation relation, relation_mem,
    by simpa [PresentedRelationEventAt.support] using generator_mem⟩

def generatorClosure
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence) :
    Submodule ℤ (Generator →₀ ℤ) :=
  ⨆ stage, face.generatorStage stage

def relationClosure
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence) :
    Submodule ℤ (Generator →₀ ℤ) :=
  ⨆ stage, face.relationStage stage

theorem generatorStage_le_closure
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    (stage : Nat) : face.generatorStage stage ≤ face.generatorClosure :=
  le_iSup (fun current => face.generatorStage current) stage

theorem relationStage_le_closure
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    (stage : Nat) : face.relationStage stage ≤ face.relationClosure :=
  le_iSup (fun current => face.relationStage current) stage

theorem relationClosure_le_generatorClosure
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence) :
    face.relationClosure ≤ face.generatorClosure := by
  refine iSup_le fun stage => ?_
  exact (face.relationStage_le_generatorStage stage).trans
    (face.generatorStage_le_closure stage)

def relationInGeneratorStage
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    (stage : Nat) : Submodule ℤ (face.generatorStage stage) :=
  (face.relationStage stage).comap (face.generatorStage stage).subtype

abbrev StagePresentedCarrier
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    (stage : Nat) :=
  face.generatorStage stage ⧸ face.relationInGeneratorStage stage

def relationInGeneratorClosure
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence) :
    Submodule ℤ face.generatorClosure :=
  face.relationClosure.comap face.generatorClosure.subtype

/-- Cofinal presented completion. -/
abbrev CompletionCarrier
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence) :=
  face.generatorClosure ⧸ face.relationInGeneratorClosure

def stageGeneratorToClosure
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    (stage : Nat) :
    face.generatorStage stage →ₗ[ℤ] face.generatorClosure :=
  Submodule.inclusion (face.generatorStage_le_closure stage)

def completionProjection
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence) :
    face.generatorClosure →ₗ[ℤ] face.CompletionCarrier :=
  face.relationInGeneratorClosure.mkQ

def stageGeneratorToCompletion
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    (stage : Nat) :
    face.generatorStage stage →ₗ[ℤ] face.CompletionCarrier :=
  face.completionProjection.comp (face.stageGeneratorToClosure stage)

theorem stageRelationInGenerator_le_kernel
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    (stage : Nat) :
    face.relationInGeneratorStage stage ≤
      LinearMap.ker (face.stageGeneratorToCompletion stage) := by
  intro relation relation_mem
  rw [LinearMap.mem_ker]
  change face.completionProjection
    (face.stageGeneratorToClosure stage relation) = 0
  apply (Submodule.Quotient.mk_eq_zero
    face.relationInGeneratorClosure).2
  exact (face.relationStage_le_closure stage) relation_mem

/-- Canonical map from the stage presented carrier to the cofinal presented
completion. -/
def stagePresentedToCompletion
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    (stage : Nat) :
    face.StagePresentedCarrier stage →ₗ[ℤ] face.CompletionCarrier :=
  (face.relationInGeneratorStage stage).liftQ
    (face.stageGeneratorToCompletion stage)
    (face.stageRelationInGenerator_le_kernel stage)

/-- The actual compactness residual: cokernel of the stage-presented map. -/
abbrev PresentedResidual
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    (stage : Nat) :=
  face.CompletionCarrier ⧸
    LinearMap.range (face.stagePresentedToCompletion stage)

/-- Residual-zero compactness.  It is deliberately a property of the
presented carrier, not of generator or relation supports separately. -/
def CompactAt
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    (stage : Nat) : Prop :=
  Subsingleton (face.PresentedResidual stage)

def PresentedEpiAt
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    (stage : Nat) : Prop :=
  Function.Surjective (face.stagePresentedToCompletion stage)

theorem compactAt_iff_presentedEpi
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
  (stage : Nat) :
    face.CompactAt stage ↔ face.PresentedEpiAt stage := by
  rw [CompactAt, PresentedEpiAt, Submodule.Quotient.subsingleton_iff,
    LinearMap.range_eq_top]

theorem stageGeneratorToCompletion_surjective_iff_presentedEpi
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    (stage : Nat) :
    Function.Surjective (face.stageGeneratorToCompletion stage) ↔
      face.PresentedEpiAt stage := by
  constructor
  · intro surjective value
    obtain ⟨preimage, equality⟩ := surjective value
    refine ⟨Submodule.Quotient.mk preimage, ?_⟩
    exact equality
  · intro surjective value
    obtain ⟨presented, equality⟩ := surjective value
    obtain ⟨preimage, rfl⟩ := Submodule.Quotient.mk_surjective
      (face.relationInGeneratorStage stage) presented
    exact ⟨preimage, equality⟩

/-- Compact branch generated from the least historical residual-zero stage. -/
structure GeneratedHistoricalCompactnessAt
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence) : Type where
  private mk ::
  index : Nat
  residualVanishes : face.CompactAt index
  least : ∀ stage, face.CompactAt stage → index ≤ stage

/-- Exact obstruction: every stage-to-completion presented cokernel remains
nonzero. -/
structure PersistentPresentedResidualObstructionAt
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence) : Type where
  private mk ::
  residualPersists : ∀ stage, ¬ face.CompactAt stage

/-- Token for the perfect/determinant readout generated only on the compact
branch. -/
structure GeneratedCompactPerfectReadoutAt
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    (_trace : GeneratedHistoricalCompactnessAt face) : Type where
  private mk ::

abbrev SettlementOutcome
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence) :=
  Sum (Σ trace : GeneratedHistoricalCompactnessAt face,
    GeneratedCompactPerfectReadoutAt face trace)
    (PersistentPresentedResidualObstructionAt face)

private noncomputable def compactTraceOf
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    (existsCompact : ∃ stage, face.CompactAt stage) :
    GeneratedHistoricalCompactnessAt face := by
  classical
  let index := Nat.find existsCompact
  exact
    { index := index
      residualVanishes := Nat.find_spec existsCompact
      least := fun _ compact => Nat.find_min' existsCompact compact }

/-- Total settlement.  The caller submits neither a branch nor a finite
model. -/
noncomputable def settle
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence) :
    SettlementOutcome face := by
  classical
  by_cases existsCompact : ∃ stage, face.CompactAt stage
  · let trace := face.compactTraceOf existsCompact
    exact Sum.inl ⟨trace, ⟨⟩⟩
  · exact Sum.inr ⟨fun stage compact => existsCompact ⟨stage, compact⟩⟩

theorem settlement_exhaustive
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence) :
    (∃ stage, face.CompactAt stage) ∨
      (∀ stage, ¬ face.CompactAt stage) := by
  cases face.settle with
  | inl compact =>
      exact Or.inl ⟨compact.1.index, compact.1.residualVanishes⟩
  | inr obstruction => exact Or.inr obstruction.residualPersists

theorem compactPerfectReadout_exists
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    (existsCompact : ∃ stage, face.CompactAt stage) :
    Nonempty (Σ trace : GeneratedHistoricalCompactnessAt face,
      GeneratedCompactPerfectReadoutAt face trace) := by
  let trace := face.compactTraceOf existsCompact
  exact ⟨⟨trace, ⟨⟩⟩⟩

theorem persistentObstruction_exists
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence)
    (persistent : ∀ stage, ¬ face.CompactAt stage) :
    Nonempty (PersistentPresentedResidualObstructionAt face) :=
  ⟨⟨persistent⟩⟩

namespace GeneratedHistoricalCompactnessAt

variable {face : RootGeneratedCofinalHistoryAt rootOccurrence
  seedOccurrence continuationOccurrence}

theorem presentedEpi
    (trace : GeneratedHistoricalCompactnessAt face) :
    face.PresentedEpiAt trace.index :=
  (face.compactAt_iff_presentedEpi trace.index).mp trace.residualVanishes

theorem generatorCover_surjective
    (trace : GeneratedHistoricalCompactnessAt face) :
    Function.Surjective (face.stageGeneratorToCompletion trace.index) :=
  (face.stageGeneratorToCompletion_surjective_iff_presentedEpi
    trace.index).mpr trace.presentedEpi

end GeneratedHistoricalCompactnessAt

namespace GeneratedCompactPerfectReadoutAt

variable {face : RootGeneratedCofinalHistoryAt rootOccurrence
  seedOccurrence continuationOccurrence}
variable {trace : GeneratedHistoricalCompactnessAt face}

abbrev ZeroTerm := Fin 0 → ℤ

/-- Canonical two-term finite-free resolution generated from the kernel of
the first residual-zero stage cover. -/
def perfectComplex
    (_readout : GeneratedCompactPerfectReadoutAt face trace) :
    FourTermIntegralComplexAt
      (LinearMap.ker (face.stageGeneratorToCompletion trace.index))
      (face.generatorStage trace.index) ZeroTerm ZeroTerm where
  d₀ := (LinearMap.ker
    (face.stageGeneratorToCompletion trace.index)).subtype
  d₁ := 0
  d₂ := 0
  d₁_comp_d₀ := rfl
  d₂_comp_d₁ := rfl

def perfectComplexOccurrence
    (readout : GeneratedCompactPerfectReadoutAt face trace) :=
  RootedAccountedUnfolding.zero readout.perfectComplex

def determinantProjection
    (readout : GeneratedCompactPerfectReadoutAt face trace) :
    RootGeneratedFourTermPerfectDeterminantProjectionAt face.root
      readout.perfectComplexOccurrence :=
  RootGeneratedFourTermPerfectDeterminantProjectionAt.generate

noncomputable def generatorBasis
    (_readout : GeneratedCompactPerfectReadoutAt face trace) :
    Module.Basis
      { generator // generator ∈ face.generatorSupport trace.index }
      ℤ (face.generatorStage trace.index) := by
  let supportSet : Set Generator := face.generatorSupport trace.index
  let basis : Module.Basis supportSet ℤ (supportSet →₀ ℤ) :=
    Finsupp.basisSingleOne
  exact basis.map (Finsupp.supportedEquivFinsupp supportSet).symm

noncomputable def kernelBasis
    (readout : GeneratedCompactPerfectReadoutAt face trace) :
    Σ rank : Nat,
      Module.Basis (Fin rank) ℤ
        (LinearMap.ker (face.stageGeneratorToCompletion trace.index)) :=
  Submodule.basisOfPid readout.generatorBasis
    (LinearMap.ker (face.stageGeneratorToCompletion trace.index))

theorem perfectCalculation
    (readout : GeneratedCompactPerfectReadoutAt face trace) :
    RootGeneratedFourTermPerfectCalculationAt
      readout.determinantProjection := by
  let generatorBasis := readout.generatorBasis
  let kernelBasis := readout.kernelBasis.2
  letI : Module.Free ℤ (face.generatorStage trace.index) :=
    Module.Free.of_basis generatorBasis
  letI : Module.Finite ℤ (face.generatorStage trace.index) :=
    Module.Finite.of_basis generatorBasis
  letI : Module.Free ℤ
      (LinearMap.ker (face.stageGeneratorToCompletion trace.index)) :=
    Module.Free.of_basis kernelBasis
  letI : Module.Finite ℤ
      (LinearMap.ker (face.stageGeneratorToCompletion trace.index)) :=
    Module.Finite.of_basis kernelBasis
  exact RootGeneratedFourTermPerfectCalculationAt.generate
    inferInstance inferInstance inferInstance inferInstance
    inferInstance inferInstance inferInstance inferInstance

def determinantState
    (readout : GeneratedCompactPerfectReadoutAt face trace) :
    RootGeneratedFourTermPerfectDeterminantStateAt
      readout.determinantProjection readout.perfectCalculation :=
  RootGeneratedFourTermPerfectDeterminantStateAt.realize

/-- The only nonzero cohomology of the generated two-term presentation is
canonically the same cofinal completion. -/
noncomputable def degreeOneHomologyEquiv
    (_readout : GeneratedCompactPerfectReadoutAt face trace) :
    (face.generatorStage trace.index ⧸
      LinearMap.ker (face.stageGeneratorToCompletion trace.index)) ≃ₗ[ℤ]
        face.CompletionCarrier :=
  (face.stageGeneratorToCompletion trace.index).quotKerEquivOfSurjective
    trace.generatorCover_surjective

theorem degreeZero_acyclic
    (readout : GeneratedCompactPerfectReadoutAt face trace) :
    Function.Injective readout.perfectComplex.d₀ :=
  (LinearMap.ker
    (face.stageGeneratorToCompletion trace.index)).injective_subtype

theorem degreeOne_exact
    (_readout : GeneratedCompactPerfectReadoutAt face trace) :
    LinearMap.range
        (LinearMap.ker
          (face.stageGeneratorToCompletion trace.index)).subtype =
      LinearMap.ker (face.stageGeneratorToCompletion trace.index) :=
  Submodule.range_subtype _

theorem determinantState_has_unitTorsor
    (readout : GeneratedCompactPerfectReadoutAt face trace) :
    Nonempty
      (GradedIntegralDeterminantLine.CanonicalIntegralUnitTorsor
        readout.determinantState.integralLine) :=
  ⟨readout.determinantState.unitTorsor⟩

theorem resolves_same_completion
    (readout : GeneratedCompactPerfectReadoutAt face trace) :
    Nonempty
      ((face.generatorStage trace.index ⧸
        LinearMap.ker (face.stageGeneratorToCompletion trace.index)) ≃ₗ[ℤ]
          face.CompletionCarrier) :=
  ⟨readout.degreeOneHomologyEquiv⟩

end GeneratedCompactPerfectReadoutAt

theorem factors_through_axiomFreeCore
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence) :
    face.core.root = rootOccurrence ∧
      face.core.diagram = continuationOccurrence :=
  ⟨rfl, rfl⟩

theorem preserves_actual_rooted_pro_occurrence
    (face : RootGeneratedCofinalHistoryAt rootOccurrence
      seedOccurrence continuationOccurrence) :
    face.root = rootOccurrence ∧ face.seed = seedOccurrence ∧
      face.actualContinuation = continuationOccurrence.root :=
  ⟨rfl, rfl, rfl⟩

end RootGeneratedCofinalHistoryAt

end

