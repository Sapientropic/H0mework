import H0mework.Realization.Completion.HistoryInstallation
import H0mework.Realization.Completion.FaithfulRealization
import H0mework.Realization.Completion.FaithfulResidual

/-!
# Source-installed faithful realization face

This is the next generic seam after the cofinal-history face.  One material
law carries the history generator/continuation and an occurrence-indexed
actual evaluator with the same generator type.  At an exact living-root
visit, the formal complete carrier and its evaluator are therefore generated
together; the existing faithful-realization classifier then returns either a
quotient equivalence or its relation/coverage residual.

The source projection installation is the admission boundary.  No
faithfulness, surjectivity, inverse, perfectness, determinant or next current
is accepted as a premise.  Whole-ledger write-back and generated next remain
readouts of the same temporal compiler image.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace CofinalFaithfulSettlementFace

open CofinalHistorySettlement
open CofinalHistorySettlementFace
open CofinalHistorySettlementFace.SourceNativeCofinalHistoryMaterialLaw
open CofinalFaithfulRealization
open CofinalFaithfulRealization.RootGeneratedCofinalFaithfulRealizationAt

noncomputable section

universe u

/-! ## Source-owned combined material -/

/-- A source-installed formal-history carrier together with an actual
evaluator into one carrier.  The evaluator's generator type is the history
law's generated type, so the two faces cannot silently use different
presentations. -/
structure SourceNativeCofinalFaithfulMaterialLaw
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (source : SourceNativeLedgerSource N V)
    (Carrier : Type u) [AddCommGroup Carrier] : Type (u + 1) where
  private mk ::
  historyLaw : SourceNativeCofinalHistoryMaterialLaw source
  evaluatorAt : {current : V.Current} →
    source.source.toRootSource.actual.OccurrenceAt current →
      RootedAccountedUnfolding (historyLaw.Generator → Carrier)

namespace SourceNativeCofinalFaithfulMaterialLaw

variable {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
variable {source : SourceNativeLedgerSource N V}
variable {Carrier : Type u} [AddCommGroup Carrier]

/-- Public source-facing constructor. -/
def create
    (historyLaw : SourceNativeCofinalHistoryMaterialLaw source)
    (evaluatorAt : {current : V.Current} →
      source.source.toRootSource.actual.OccurrenceAt current →
        RootedAccountedUnfolding (historyLaw.Generator → Carrier)) :
    SourceNativeCofinalFaithfulMaterialLaw source Carrier :=
  ⟨historyLaw, evaluatorAt⟩

def historyAt
    (law : SourceNativeCofinalFaithfulMaterialLaw source Carrier)
    {current : V.Current}
    (occurrence : source.source.toRootSource.actual.OccurrenceAt current) :=
  law.historyLaw.historyAt occurrence

def evaluatorOccurrenceAt
    (law : SourceNativeCofinalFaithfulMaterialLaw source Carrier)
    {current : V.Current}
    (occurrence : source.source.toRootSource.actual.OccurrenceAt current) :=
  law.evaluatorAt occurrence

def faithfulAt
    (law : SourceNativeCofinalFaithfulMaterialLaw source Carrier)
    {current : V.Current}
    (occurrence : source.source.toRootSource.actual.OccurrenceAt current) :
    RootGeneratedCofinalFaithfulRealizationAt
      (law.historyAt occurrence) (law.evaluatorOccurrenceAt occurrence) :=
  RootGeneratedCofinalFaithfulRealizationAt.generate

/-- Install the combined history/evaluator face in the source's projection
inventory.  The payload is generated by the same exact occurrence. -/
def toProjectionLaw
    (law : SourceNativeCofinalFaithfulMaterialLaw source Carrier) :
    SourceNativeProjectionLaw source where
  Projection := PUnit
  ActiveAt := fun _projection {_current} _occurrence => PUnit
  InactiveAt := fun _projection {_current} _occurrence => PEmpty
  classify := fun _projection {_current} _occurrence => .inl PUnit.unit
  PayloadAt := fun _projection {_current} occurrence _active =>
    ULift (RootGeneratedCofinalFaithfulRealizationAt
      (law.historyAt occurrence) (law.evaluatorOccurrenceAt occurrence))
  project := fun _projection {_current} occurrence _active =>
    ULift.up (law.faithfulAt occurrence)

@[simp] theorem outcomeAt_eq
    (law : SourceNativeCofinalFaithfulMaterialLaw source Carrier)
    {current : V.Current}
    (occurrence : source.source.toRootSource.actual.OccurrenceAt current) :
    law.toProjectionLaw.outcomeAt PUnit.unit occurrence =
      .inl ⟨PUnit.unit, ULift.up (law.faithfulAt occurrence)⟩ :=
  rfl

end SourceNativeCofinalFaithfulMaterialLaw

/-! ## Root admission and exact faithful step -/

structure SourceNativeCofinalFaithfulRecognitionAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}
    } (Carrier : Type u) [AddCommGroup Carrier]
    (root : SourceNativeLivingRootClosure N V) : Type (u + 2) where
  private mk ::
  materialLaw : SourceNativeCofinalFaithfulMaterialLaw
    root.toAuthoritativeRoot.toLedgerRoot.source Carrier
  installation : SourceNativeProjectionLaw.InstallationAt
    materialLaw.toProjectionLaw
    root.toAuthoritativeRoot.source.projectionLaw

namespace SourceNativeCofinalFaithfulRecognitionAt

variable {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
variable {Carrier : Type u} [AddCommGroup Carrier]
variable {root : SourceNativeLivingRootClosure N V}

def create
    (materialLaw : SourceNativeCofinalFaithfulMaterialLaw
      root.toAuthoritativeRoot.toLedgerRoot.source Carrier)
    (installation : SourceNativeProjectionLaw.InstallationAt
      materialLaw.toProjectionLaw
      root.toAuthoritativeRoot.source.projectionLaw) :
    SourceNativeCofinalFaithfulRecognitionAt Carrier root :=
  ⟨materialLaw, installation⟩

end SourceNativeCofinalFaithfulRecognitionAt

structure RootGeneratedCofinalFaithfulSettlementStepAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}
    } {Carrier : Type u} [AddCommGroup Carrier]
    {root : SourceNativeLivingRootClosure N V}
    (recognition : SourceNativeCofinalFaithfulRecognitionAt Carrier root)
    (visit : SourceNativeTemporalVisitAt
    root.toAuthoritativeRoot.toLedgerRoot) : Type (u + 2) where
  private mk ::

namespace RootGeneratedCofinalFaithfulSettlementStepAt

variable {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
variable {Carrier : Type u} [AddCommGroup Carrier]
variable {root : SourceNativeLivingRootClosure N V}
variable {recognition : SourceNativeCofinalFaithfulRecognitionAt Carrier root}
variable {visit : SourceNativeTemporalVisitAt
  root.toAuthoritativeRoot.toLedgerRoot}

def generate : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit :=
  ⟨⟩

def generated
    (_step : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit) :
    SourceNativeTemporalVisitGeneratedEvolutionAt
      root.toAuthoritativeRoot.toLedgerRoot visit :=
  root.toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit visit

def sourceOccurrence
    (step : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit) :=
  step.generated.occurrence

def history
    (step : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit) :=
  recognition.materialLaw.historyAt step.sourceOccurrence

def evaluatorOccurrence
    (step : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit) :=
  recognition.materialLaw.evaluatorOccurrenceAt step.sourceOccurrence

def faithful
    (step : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit) :
    RootGeneratedCofinalFaithfulRealizationAt step.history
      step.evaluatorOccurrence :=
  recognition.materialLaw.faithfulAt step.sourceOccurrence

abbrev CompletionCarrier
    (step : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit) :=
  step.history.CompletionCarrier

abbrev ActualCarrier
    (_step : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit) :=
  Carrier

abbrev SettlementOutcome
    (step : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit) :=
  RootGeneratedCofinalFaithfulRealizationAt.SettlementOutcome step.faithful

abbrev ResidualDispositionOutcome
    (step : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit) :=
  RootGeneratedCofinalFaithfulRealizationAt.ResidualDispositionOutcome step.faithful

def settlement
    (step : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit) :
    step.SettlementOutcome :=
  step.faithful.settle

def residualDisposition
    (step : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit) :
    step.ResidualDispositionOutcome :=
  step.faithful.settleWithResidual

/-! The existing classifier's three branches are the generic
mapping-residual disposition: faithful quotient equivalence, unsound
relation residual, or uncovered actual-carrier residual. -/

def wholeLedgerWriteBack
    (step : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit) :=
  step.generated.wholeLedgerWriteBack

def nextCurrent
    (_step : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit) :
    SourceNativeAuthoritativeRootCurrentAt N :=
  root.generatedNextCurrentAt visit

@[simp] theorem sourceOccurrence_eq_generated
    (step : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit) :
    step.sourceOccurrence = step.generated.occurrence :=
  rfl

theorem history_root_exposure_eq
    (step : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit) :
    step.history.root =
      recognition.materialLaw.historyLaw.rootOccurrenceAt step.sourceOccurrence :=
  rfl

@[simp] theorem history_root_payload_eq_sourceOccurrence
    (step : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit) :
    step.history.root.root = step.sourceOccurrence := by
  change (recognition.materialLaw.historyLaw.rootOccurrenceAt
      step.sourceOccurrence).root = step.sourceOccurrence
  exact recognition.materialLaw.historyLaw.rootOccurrenceAt_root
    step.sourceOccurrence

theorem faithful_root_eq_history_root
    (step : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit) :
    step.faithful.root = step.history.root :=
  rfl

theorem wholeLedgerWriteBack_eq_root
    (step : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit) :
    HEq step.wholeLedgerWriteBack
      (root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt visit.current) :=
  HEq.rfl

@[simp] theorem nextCurrent_eq_root
    (step : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit) :
    step.nextCurrent = root.generatedNextCurrentAt visit :=
  rfl

theorem installedFaithful_factorizes
    (step : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit) :
    HEq
      (root.toAuthoritativeRoot.source.projectionLaw.outcomeAt
        (recognition.installation.embed PUnit.unit)
        step.sourceOccurrence)
      (recognition.materialLaw.toProjectionLaw.outcomeAt
        PUnit.unit step.sourceOccurrence) :=
  recognition.installation.outcome_heq step.sourceOccurrence PUnit.unit

theorem settlement_is_total
    (step : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit) :
    Nonempty step.SettlementOutcome :=
  ⟨step.settlement⟩

theorem residualDisposition_is_total
    (step : RootGeneratedCofinalFaithfulSettlementStepAt recognition visit) :
    Nonempty step.ResidualDispositionOutcome :=
  ⟨step.residualDisposition⟩

end RootGeneratedCofinalFaithfulSettlementStepAt

namespace SourceNativeCofinalFaithfulRecognitionAt

variable {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
variable {Carrier : Type u} [AddCommGroup Carrier]
variable {root : SourceNativeLivingRootClosure N V}

def generateStepAt
    (recognition : SourceNativeCofinalFaithfulRecognitionAt Carrier root)
    (visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot) :
    RootGeneratedCofinalFaithfulSettlementStepAt recognition visit :=
  RootGeneratedCofinalFaithfulSettlementStepAt.generate

end SourceNativeCofinalFaithfulRecognitionAt

end
end CofinalFaithfulSettlementFace
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
