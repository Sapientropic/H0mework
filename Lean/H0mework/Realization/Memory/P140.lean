/-
  Proposition 140: saturation residuals feed the two-phase retention skeleton.

  P124/P125 prove that H¹ residual attenuation composes by the same noisy-OR
  law as salience saturation: after a saturation rate σ, the remaining residual
  fraction is `1 - σ`.  P139 proves the two-channel switching algebra for a
  fast channel plus a slow tail.

  This file connects those two facts at the discrete algebraic level: the
  saturation residual fraction supplies a geometric fast channel

      C₁ * (1 - σ)^n

  and adding an arbitrary slow tail gives the same two-phase skeleton consumed
  by P139.  Boundary: the slow tail is deliberately supplied as a function.
  This does not prove analytic real exponentials, power laws, AIC optimality,
  or the Murre-Chessa gamma-mixture / Laplace-transform theorem.
-/

import H0mework.Realization.Memory.P139

namespace TwoPhaseSaturationBridge

open TwoPhaseRetention

/-! ## Saturation-generated fast channel -/

/-- A fast retention channel generated by a saturation residual rate.  The
remaining fraction after one saturation step is `1 - σ`; after `n` discrete
steps it is `(1 - σ)^n`. -/
def saturationFastChannel {α : Type*} [Monoid α] [Sub α] [OfNat α 1]
    (amplitude σ : α) (n : Nat) : α :=
  amplitude * (1 - σ) ^ n

/-- THEOREM 1: the saturation-generated fast channel is exactly P139's
geometric fast channel with keep-rate `1 - σ`. -/
theorem saturationFastChannel_eq_geometricFast
    {α : Type*} [Monoid α] [Sub α] [OfNat α 1]
    (amplitude σ : α) (n : Nat) :
    saturationFastChannel amplitude σ n =
      geometricFast amplitude (1 - σ) n := by
  rfl

/-- A two-phase signal whose fast component is generated by saturation
attenuation and whose slow component is externally supplied. -/
def h1TwoPhaseSignal {α : Type*} [Ring α]
    (fastAmplitude σ slowAmplitude : α)
    (slowTail : Nat -> α) (n : Nat) : α :=
  saturationFastChannel fastAmplitude σ n +
    shapedSlow slowAmplitude slowTail n

/-- THEOREM 2: the H¹/saturation two-phase signal is exactly P139's discrete
two-phase skeleton with fast keep-rate `1 - σ`. -/
theorem h1TwoPhase_eq_discreteTwoPhase
    {α : Type*} [Ring α]
    (fastAmplitude σ slowAmplitude : α)
    (slowTail : Nat -> α) (n : Nat) :
    h1TwoPhaseSignal fastAmplitude σ slowAmplitude slowTail n =
      discreteTwoPhase fastAmplitude (1 - σ) slowAmplitude slowTail n := by
  rfl

/-! ## Noisy-OR composition as fast-channel keep multiplication -/

/-- THEOREM 3: composing saturation rates by noisy-OR multiplies the residual
keep-rates. -/
theorem keep_of_satOrField
    {α : Type*} [Field α]
    (σ₁ σ₂ : α) :
    (1 : α) - satOrField σ₁ σ₂ = (1 - σ₁) * (1 - σ₂) := by
  unfold satOrField
  ring

/-- THEOREM 4: the fast channel after a composed noisy-OR saturation rate has
the product residual keep-rate. -/
theorem saturationFastChannel_composed_rate
    {α : Type*} [Field α]
    (amplitude σ₁ σ₂ : α) (n : Nat) :
    saturationFastChannel amplitude (satOrField σ₁ σ₂) n =
      amplitude * ((1 - σ₁) * (1 - σ₂)) ^ n := by
  unfold saturationFastChannel
  rw [keep_of_satOrField]

/-! ## Switching-point bridge -/

/-- THEOREM 5: in the saturation-fed two-phase model, the slow tail exceeds the
fast saturation channel exactly when the slow tail contributes more than half
of the total signal. -/
theorem h1TwoPhase_slow_switch_iff_majority
    {α : Type*} [Field α] [LinearOrder α] [IsStrictOrderedRing α]
    (fastAmplitude σ slowAmplitude : α)
    (slowTail : Nat -> α) (n : Nat) :
    saturationFastChannel fastAmplitude σ n <
        shapedSlow slowAmplitude slowTail n <->
      h1TwoPhaseSignal fastAmplitude σ slowAmplitude slowTail n <
        (2 : α) * shapedSlow slowAmplitude slowTail n := by
  simpa [h1TwoPhaseSignal, signal] using slow_dominates_iff_majority
    (fast := saturationFastChannel fastAmplitude σ n)
    (slow := shapedSlow slowAmplitude slowTail n)

/-- THEOREM 6: symmetrically, the fast saturation channel exceeds the slow tail
exactly when the fast channel contributes more than half of the total signal. -/
theorem h1TwoPhase_fast_switch_iff_majority
    {α : Type*} [Field α] [LinearOrder α] [IsStrictOrderedRing α]
    (fastAmplitude σ slowAmplitude : α)
    (slowTail : Nat -> α) (n : Nat) :
    shapedSlow slowAmplitude slowTail n <
        saturationFastChannel fastAmplitude σ n <->
      h1TwoPhaseSignal fastAmplitude σ slowAmplitude slowTail n <
        (2 : α) * saturationFastChannel fastAmplitude σ n := by
  simpa [h1TwoPhaseSignal, signal] using fast_dominates_iff_majority
    (fast := saturationFastChannel fastAmplitude σ n)
    (slow := shapedSlow slowAmplitude slowTail n)

/-!
  Summary:
  - P124/P125's saturation residual rate supplies the discrete geometric fast
    channel of the two-phase retention skeleton.
  - P139's switching predicate applies directly to this saturation-fed model.
  - The slow tail remains an explicit input.  The exact power-law tail still
    needs a separate rate-distribution / analytic theorem.
-/


end TwoPhaseSaturationBridge
