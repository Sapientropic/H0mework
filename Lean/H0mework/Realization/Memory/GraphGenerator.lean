/-
  Proposition 53: graph obstruction generator as recollection mechanism.

  Proposition 36 transported graph gluing obstruction into the memory layer
  through the `MemoryEpistemicType` presentation.  Proposition 52 then
  separated memory into recollection activation and future trace potential.

  This file proves a smaller but cleaner bridge: the graph H¹-like generator
  (non-joinable cross critical pairs) and a recollection trace-installing
  mechanism can be specified independently and then shown strongly isomorphic,
  without using `memoryToSemanticAtom`.

  Boundary: this is a finite two-point witness.  It is stronger than a mere
  renaming bridge, but it is not yet a general theorem that every graph
  obstruction in the real runtime induces exactly this recollection mechanism.
-/

import H0mework.Realization.Memory.RecollectionLoops

/-! ## A graph-side generator atom independent of memory taxonomy -/

/-- The graph-side atom generated by a non-joinable cross-boundary critical
pair.  This is not `MemoryEpistemicType.graphObstruction` and not a semantic
taxonomy atom. -/
inductive GraphBoundaryAtom where
  | crossBoundaryCriticalPair
  deriving DecidableEq, Repr

/-- A minimal graph gluing cocycle with an H¹-like obstruction: both local
pieces are confluent, cross critical pairs are not joinable, and the global
glued graph is not confluent. -/
def twoPointGraphGluingCocycle : GraphGluingCocycle where
  leftConfluent := True
  rightConfluent := True
  globalConfluent := False
  crossCriticalPairsJoinable := False
  global_iff_locals_and_cross := by
    simp

/-- THEOREM 1: the two-point graph cocycle has the cross-critical-pair
generator. -/
theorem twoPoint_graphH1Generator :
    GraphH1Generator twoPointGraphGluingCocycle := by
  simp [GraphH1Generator, twoPointGraphGluingCocycle]

/-- THEOREM 2: equivalently, the graph cocycle has the H¹-like obstruction. -/
theorem twoPoint_graphH1Obstruction :
    GraphH1Obstruction twoPointGraphGluingCocycle := by
  exact (graph_h1_obstruction_iff_cross_generator
    twoPointGraphGluingCocycle).mpr twoPoint_graphH1Generator

/-- Graph-side support over the two-point trace state.  The silent point is the
boundary point where the cross-critical-pair generator is active; the changed
point is already resolved. -/
def twoPointGraphBoundarySupport :
    TwoPointTraceState -> GraphBoundaryAtom -> Prop
  | TwoPointTraceState.silent,
    GraphBoundaryAtom.crossBoundaryCriticalPair =>
      GraphH1Generator twoPointGraphGluingCocycle
  | TwoPointTraceState.changed,
    GraphBoundaryAtom.crossBoundaryCriticalPair =>
      False

/-- THEOREM 3: the graph-side support is independently realizable over its
single atom. -/
theorem twoPointGraphBoundarySupport_independent :
    SupportIndependent TwoPointTraceState GraphBoundaryAtom
      twoPointGraphBoundarySupport := by
  intro assignment
  by_cases h : assignment GraphBoundaryAtom.crossBoundaryCriticalPair
  · refine ⟨TwoPointTraceState.silent, ?_⟩
    intro atom
    cases atom
    simp [twoPointGraphBoundarySupport, twoPoint_graphH1Generator, h]
  · refine ⟨TwoPointTraceState.changed, ?_⟩
    intro atom
    cases atom
    simp [twoPointGraphBoundarySupport, h]

/-- THEOREM 4: the graph-side support is nontrivial. -/
theorem twoPointGraphBoundarySupport_nontrivial :
    SupportNontrivial TwoPointTraceState GraphBoundaryAtom
      twoPointGraphBoundarySupport := by
  constructor
  · exact ⟨TwoPointTraceState.silent,
      GraphBoundaryAtom.crossBoundaryCriticalPair,
      twoPoint_graphH1Generator⟩
  · refine ⟨TwoPointTraceState.changed, ?_⟩
    intro atom h
    cases atom
    exact h

/-! ## Strong bridge to recollection activation -/

/-- Atom equivalence from the graph generator atom to the recollection act
atom. -/
def graphBoundaryRecollectionAtomEquiv :
    GraphBoundaryAtom ≃ IndependentRecollectionAtom where
  toFun
    | GraphBoundaryAtom.crossBoundaryCriticalPair =>
        IndependentRecollectionAtom.recollectionCommitted
  invFun
    | IndependentRecollectionAtom.recollectionCommitted =>
        GraphBoundaryAtom.crossBoundaryCriticalPair
  left_inv := by
    intro atom
    cases atom
    rfl
  right_inv := by
    intro atom
    cases atom
    rfl

/-- THEOREM 5: the graph-side generator support fires exactly when the
independent recollection act fires. -/
theorem twoPoint_graphBoundary_iff_recollectionAct
    (x : TwoPointTraceState) :
    twoPointGraphBoundarySupport x
        GraphBoundaryAtom.crossBoundaryCriticalPair <->
      independentTwoPointRecollectionAct.fires x
        IndependentRecollectionAtom.recollectionCommitted := by
  cases x <;>
    simp [twoPointGraphBoundarySupport, twoPoint_graphH1Generator,
      independentTwoPointRecollectionAct]

/-- THEOREM 6: the graph generator and recollection activation form a strong
support isomorphism: both sides are independent and nontrivial, atoms are
equivalent, and support is preserved. -/
def twoPointGraphGeneratorRecollectionIso :
    StrongSupportIsomorphism TwoPointTraceState GraphBoundaryAtom
      IndependentRecollectionAtom
      twoPointGraphBoundarySupport
      independentTwoPointRecollectionAct.fires where
  leftIndependent := twoPointGraphBoundarySupport_independent
  rightIndependent := independentTwoPointRecollectionAct_independent
  leftNontrivial := twoPointGraphBoundarySupport_nontrivial
  rightNontrivial := independentTwoPointRecollectionAct_nontrivial
  atomEquiv := graphBoundaryRecollectionAtomEquiv
  support_iff := by
    intro x atom
    cases atom
    exact twoPoint_graphBoundary_iff_recollectionAct x

/-! ## Generator firing installs future trace -/

/-- THEOREM 7: if the graph-side cross-critical generator is active at a state,
then the corresponding recollection mechanism installs trace potential after
the write. -/
theorem graphGenerator_installs_future_trace
    (x : TwoPointTraceState)
    (hgen :
      twoPointGraphBoundarySupport x
        GraphBoundaryAtom.crossBoundaryCriticalPair) :
    TracePotential twoPointRecollectionTraceLoop
      (twoPointRecollectionTraceLoop.query.write x) := by
  have hfire :
      independentTwoPointRecollectionAct.fires x
        IndependentRecollectionAtom.recollectionCommitted :=
    (twoPointGraphGeneratorRecollectionIso.support_iff x
      GraphBoundaryAtom.crossBoundaryCriticalPair).mp hgen
  exact RecollectionTraceLoop.firing_creates_future_trace_potential
    twoPointRecollectionTraceLoop x
    IndependentRecollectionAtom.recollectionCommitted hfire

/-- THEOREM 8: at the unresolved boundary point, the graph generator,
recollection activation, and future trace form the full temporal pattern:
no trace before, generator/recollection now, trace after the write. -/
theorem graphGenerator_recollection_temporal_arrow :
    (¬ TracePotential twoPointRecollectionTraceLoop TwoPointTraceState.silent) /\
      twoPointGraphBoundarySupport TwoPointTraceState.silent
        GraphBoundaryAtom.crossBoundaryCriticalPair /\
      RecollectableMemoryPotential
        twoPointRecollectionTraceLoop.act TwoPointTraceState.silent /\
      TracePotential twoPointRecollectionTraceLoop
        (twoPointRecollectionTraceLoop.query.write TwoPointTraceState.silent) := by
  constructor
  · exact twoPoint_silent_has_no_trace
  · constructor
    · exact twoPoint_graphH1Generator
    · constructor
      · exact ⟨IndependentRecollectionAtom.recollectionCommitted,
          (twoPoint_graphBoundary_iff_recollectionAct
            TwoPointTraceState.silent).mp twoPoint_graphH1Generator⟩
      · exact graphGenerator_installs_future_trace
          TwoPointTraceState.silent twoPoint_graphH1Generator

/-!
  Summary:
  - The graph side and recollection side are specified independently:
    `GraphBoundaryAtom.crossBoundaryCriticalPair` is not a memory-taxonomy
    constructor.
  - The two-point witness proves a strong support isomorphism between the graph
    H¹-like generator and recollection activation.
  - Active graph generator support installs future trace through
    `RecollectionTraceLoop`, giving a finite algebraic version of
    "gluing failure becomes memory" at the recollection-mechanism layer.
-/
