import Mathlib.Analysis.InnerProductSpace.LinearMap
import Mathlib.LinearAlgebra.Isomorphisms

/-!
# Source-generated complex feature perfectification

An actual complex-linear feature map into any complex inner-product space
generates its Gram radical, radical quotient, canonical faithful feature map,
and positive Gram/energy readouts.  No positivity, nondegeneracy,
finite-dimensionality, basis, or frame is supplied by the caller.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace SourceGeneratedComplexFeaturePerfectification

noncomputable section

universe c h q

variable {C : Type c} [AddCommGroup C] [Module ℂ C]
variable {H : Type h} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- The Gram evaluation generated by the actual feature map.  It is
conjugate-linear in the first variable and linear in the second. -/
def gramEvaluation (feature : C →ₗ[ℂ] H) :
    C →ₗ⋆[ℂ] C →ₗ[ℂ] ℂ where
  toFun source := (innerₛₗ ℂ (feature source)).comp feature
  map_add' left right := by
    ext value
    simp
  map_smul' scalar source := by
    ext value
    simp

@[simp]
theorem gramEvaluation_apply
    (feature : C →ₗ[ℂ] H) (left right : C) :
    gramEvaluation feature left right =
      inner ℂ (feature left) (feature right) :=
  rfl

/-- The generated Gram radical. -/
abbrev gramRadical (feature : C →ₗ[ℂ] H) : Submodule ℂ C :=
  LinearMap.ker feature

theorem mem_gramRadical_iff_self_gram_zero
    (feature : C →ₗ[ℂ] H) (value : C) :
    value ∈ gramRadical feature ↔
      gramEvaluation feature value value = 0 := by
  simp [gramRadical, gramEvaluation]

theorem mem_gramRadical_iff_gram_zero
    (feature : C →ₗ[ℂ] H) (value : C) :
    value ∈ gramRadical feature ↔
      ∀ test : C, gramEvaluation feature value test = 0 := by
  constructor
  · intro value_mem test
    rw [LinearMap.mem_ker] at value_mem
    simp [gramEvaluation, value_mem]
  · intro gram_zero
    rw [mem_gramRadical_iff_self_gram_zero]
    exact gram_zero value

/-- The feature-perfectified carrier. -/
abbrev Carrier (feature : C →ₗ[ℂ] H) :=
  C ⧸ gramRadical feature

def canonicalMap (feature : C →ₗ[ℂ] H) : C →ₗ[ℂ] Carrier feature :=
  Submodule.mkQ (gramRadical feature)

/-- The actual feature descends canonically to the radical quotient. -/
def faithfulFeature (feature : C →ₗ[ℂ] H) : Carrier feature →ₗ[ℂ] H :=
  (gramRadical feature).liftQ feature le_rfl

@[simp]
theorem faithfulFeature_comp_canonicalMap
    (feature : C →ₗ[ℂ] H) :
    (faithfulFeature feature).comp (canonicalMap feature) = feature := by
  apply LinearMap.ext
  intro value
  rfl

theorem faithfulFeature_injective
    (feature : C →ₗ[ℂ] H) :
    Function.Injective (faithfulFeature feature) := by
  rw [← LinearMap.ker_eq_bot]
  exact Submodule.ker_liftQ_eq_bot _ _ _ le_rfl

/-! ## Universal radical-quotient factorization -/

def canonicalFactor
    {Q : Type q} [AddCommGroup Q] [Module ℂ Q]
    (feature : C →ₗ[ℂ] H) (map : C →ₗ[ℂ] Q)
    (kills_radical : LinearMap.ker feature ≤ LinearMap.ker map) :
    Carrier feature →ₗ[ℂ] Q :=
  (gramRadical feature).liftQ map kills_radical

@[simp]
theorem canonicalFactor_comp_canonicalMap
    {Q : Type q} [AddCommGroup Q] [Module ℂ Q]
    (feature : C →ₗ[ℂ] H) (map : C →ₗ[ℂ] Q)
    (kills_radical : LinearMap.ker feature ≤ LinearMap.ker map) :
    (canonicalFactor feature map kills_radical).comp
        (canonicalMap feature) = map := by
  apply LinearMap.ext
  intro value
  rfl

theorem canonicalFactor_unique
    {Q : Type q} [AddCommGroup Q] [Module ℂ Q]
    (feature : C →ₗ[ℂ] H) (map : C →ₗ[ℂ] Q)
    (kills_radical : LinearMap.ker feature ≤ LinearMap.ker map)
    (other : Carrier feature →ₗ[ℂ] Q)
    (other_commutes : other.comp (canonicalMap feature) = map) :
    other = canonicalFactor feature map kills_radical := by
  apply LinearMap.ext
  intro quotientValue
  obtain ⟨value, rfl⟩ :=
    Submodule.mkQ_surjective (gramRadical feature) quotientValue
  exact (LinearMap.congr_fun other_commutes value).trans rfl

theorem canonicalMap_universal
    {Q : Type q} [AddCommGroup Q] [Module ℂ Q]
    (feature : C →ₗ[ℂ] H) (map : C →ₗ[ℂ] Q)
    (kills_radical : LinearMap.ker feature ≤ LinearMap.ker map) :
    ∃! factor : Carrier feature →ₗ[ℂ] Q,
      factor.comp (canonicalMap feature) = map := by
  refine ⟨canonicalFactor feature map kills_radical,
    canonicalFactor_comp_canonicalMap feature map kills_radical, ?_⟩
  intro other other_commutes
  exact canonicalFactor_unique feature map kills_radical other other_commutes

/-- The quotient is canonically equivalent to the actual feature range. -/
noncomputable def carrierEquivRange (feature : C →ₗ[ℂ] H) :
    Carrier feature ≃ₗ[ℂ] LinearMap.range feature :=
  feature.quotKerEquivRange

@[simp]
theorem carrierEquivRange_canonicalMap
    (feature : C →ₗ[ℂ] H) (value : C) :
    ((carrierEquivRange feature (canonicalMap feature value) :
        LinearMap.range feature) : H) = feature value := by
  exact LinearMap.quotKerEquivRange_apply_mk feature value

/-- The faithful quotient Gram form. -/
def quotientGramEvaluation (feature : C →ₗ[ℂ] H) :
    Carrier feature →ₗ⋆[ℂ] Carrier feature →ₗ[ℂ] ℂ :=
  gramEvaluation (faithfulFeature feature)

@[simp]
theorem quotientGramEvaluation_apply
    (feature : C →ₗ[ℂ] H) (left right : Carrier feature) :
    quotientGramEvaluation feature left right =
      inner ℂ (faithfulFeature feature left)
        (faithfulFeature feature right) :=
  rfl

/-- The real nonnegative readout generated from the quotient Gram diagonal. -/
def positiveEnergyReadout
    (feature : C →ₗ[ℂ] H) (value : Carrier feature) : ℝ :=
  ‖faithfulFeature feature value‖ ^ 2

theorem positiveEnergyReadout_nonnegative
    (feature : C →ₗ[ℂ] H) (value : Carrier feature) :
    0 ≤ positiveEnergyReadout feature value := by
  exact sq_nonneg _

theorem positiveEnergyReadout_eq_zero_iff
    (feature : C →ₗ[ℂ] H) (value : Carrier feature) :
    positiveEnergyReadout feature value = 0 ↔ value = 0 := by
  rw [positiveEnergyReadout, sq_eq_zero_iff, norm_eq_zero]
  constructor
  · intro mapped_zero
    apply faithfulFeature_injective feature
    simpa using mapped_zero
  · rintro rfl
    exact map_zero (faithfulFeature feature)

theorem positiveEnergyReadout_pos_iff
    (feature : C →ₗ[ℂ] H) (value : Carrier feature) :
    0 < positiveEnergyReadout feature value ↔ value ≠ 0 := by
  constructor
  · intro positive value_zero
    subst value
    simp [positiveEnergyReadout] at positive
  · intro value_ne
    exact lt_of_le_of_ne
      (positiveEnergyReadout_nonnegative feature value)
      (Ne.symm ((positiveEnergyReadout_eq_zero_iff feature value).not.mpr
        value_ne))

theorem quotientGram_self_eq_energy
    (feature : C →ₗ[ℂ] H) (value : Carrier feature) :
    quotientGramEvaluation feature value value =
      (positiveEnergyReadout feature value : ℂ) := by
  rw [quotientGramEvaluation_apply, positiveEnergyReadout]
  have innerIdentity := inner_self_eq_norm_sq_to_K (𝕜 := ℂ)
    (faithfulFeature feature value)
  norm_cast at innerIdentity ⊢

structure GeneratedFeaturePerfectification
    (feature : C →ₗ[ℂ] H) : Type (max c h) where
  private mk ::
  map : Carrier feature →ₗ[ℂ] H
  map_eq : map = faithfulFeature feature
  map_injective : Function.Injective map
  gram : Carrier feature →ₗ⋆[ℂ] Carrier feature →ₗ[ℂ] ℂ
  gram_eq : gram = quotientGramEvaluation feature
  energy : Carrier feature → ℝ
  energy_eq : energy = positiveEnergyReadout feature
  energy_nonnegative : ∀ value, 0 ≤ energy value
  energy_zero_iff : ∀ value, energy value = 0 ↔ value = 0

/-- Generate the complete feature perfectification from the actual feature
map alone. -/
def generate (feature : C →ₗ[ℂ] H) :
    GeneratedFeaturePerfectification feature where
  map := faithfulFeature feature
  map_eq := rfl
  map_injective := faithfulFeature_injective feature
  gram := quotientGramEvaluation feature
  gram_eq := rfl
  energy := positiveEnergyReadout feature
  energy_eq := rfl
  energy_nonnegative := positiveEnergyReadout_nonnegative feature
  energy_zero_iff := positiveEnergyReadout_eq_zero_iff feature

theorem generatedFeaturePerfectification_total
    (feature : C →ₗ[ℂ] H) :
    Nonempty (GeneratedFeaturePerfectification feature) :=
  ⟨generate feature⟩

end

end SourceGeneratedComplexFeaturePerfectification
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
