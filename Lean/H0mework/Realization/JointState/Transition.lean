import H0mework.Realization.Completion.HistoryTransition
import H0mework.Realization.Coherent.PerfectRealization

/-!
# Root-generated dependent joint transitions

The canonical compiler target first receives the total cofinal-history
transition disposition.  On the mapped branch, pairing-kernel, pairing-value,
source-action, measurement and Hilbert-evolution naturality are tested in
order.  Every failure retains an exact coordinate; no square or positive
branch is accepted as input.

The temporal wrapper obtains its successor only from the existing source
ledger compiler.  A faithful terminal and an ordinary successor are therefore
one total output, while whole-ledger write-back and generated next remain the
parent controller's canonical values.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace RootLawDependentJointTransition

open CofinalHistorySettlement
open CofinalHistoryTransition
open SourceGeneratedIntegralEquivariantPerfectRealization

noncomputable section

universe u w₁ w₂ h

/-! ## Mathematical transition on one generated history map -/

variable {Root₁ : Type w₁} {Root₂ : Type w₂} {Generator : Type u}
variable {rootOccurrence₁ : RootedAccountedUnfolding Root₁}
variable {rootOccurrence₂ : RootedAccountedUnfolding Root₂}
variable {seedOccurrence₁ seedOccurrence₂ :
  RootedAccountedUnfolding (PresentedRelationEventAt Generator)}
variable {continuationOccurrence₁ continuationOccurrence₂ :
  RootedAccountedUnfolding
    (PresentedRelationEventAt Generator →
      RootedAccountedUnfolding (PresentedRelationEventAt Generator))}

variable {source : RootGeneratedCofinalHistoryAt rootOccurrence₁
  seedOccurrence₁ continuationOccurrence₁}
variable {target : RootGeneratedCofinalHistoryAt rootOccurrence₂
  seedOccurrence₂ continuationOccurrence₂}
variable {H : Type h} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

def carrierMap (transition : GeneratedTransition source target) :
    source.CompletionCarrier →ₗ[ℤ] target.CompletionCarrier :=
  CofinalHistoryTransition.GeneratedTransition.completionMap
    source target transition

/-- A source evaluation-zero direction becomes visible to the target
evaluation after the canonical carrier map. -/
structure PairingKernelResidualAt
    (transition : GeneratedTransition source target)
    (sourcePairing : source.CompletionCarrier →ₗ[ℤ]
      Module.Dual ℤ source.CompletionCarrier)
    (targetPairing : target.CompletionCarrier →ₗ[ℤ]
      Module.Dual ℤ target.CompletionCarrier) where
  coordinate : source.CompletionCarrier
  source_zero : coordinate ∈ LinearMap.ker sourcePairing
  target_nonzero : carrierMap transition coordinate ∉
    LinearMap.ker targetPairing

/-- The two pairings disagree on a transported source pair. -/
structure PairingValueResidualAt
    (transition : GeneratedTransition source target)
    (sourcePairing : source.CompletionCarrier →ₗ[ℤ]
      Module.Dual ℤ source.CompletionCarrier)
    (targetPairing : target.CompletionCarrier →ₗ[ℤ]
      Module.Dual ℤ target.CompletionCarrier) where
  left : source.CompletionCarrier
  right : source.CompletionCarrier
  mismatch :
    targetPairing (carrierMap transition left)
        (carrierMap transition right) ≠
      sourcePairing left right

structure ActionResidualAt
    (transition : GeneratedTransition source target)
    (sourceAction : source.CompletionCarrier →ₗ[ℤ]
      source.CompletionCarrier)
    (targetAction : target.CompletionCarrier →ₗ[ℤ]
      target.CompletionCarrier) where
  coordinate : source.CompletionCarrier
  mismatch : carrierMap transition (sourceAction coordinate) ≠
    targetAction (carrierMap transition coordinate)

structure MeasurementResidualAt
    (transition : GeneratedTransition source target)
    (sourceMeasurement : source.CompletionCarrier →ₗ[ℤ] H)
    (targetMeasurement : target.CompletionCarrier →ₗ[ℤ] H) where
  coordinate : source.CompletionCarrier
  mismatch : sourceMeasurement coordinate ≠
    targetMeasurement (carrierMap transition coordinate)

structure EvolutionResidualAt
    (sourceEvolution targetEvolution : H →ₗᵢ[ℂ] H) where
  coordinate : H
  mismatch : sourceEvolution coordinate ≠ targetEvolution coordinate

/-- All raw squares generated by the same canonical history transition. -/
structure GeneratedJointTransitionAt
    (transition : GeneratedTransition source target)
    (sourcePairing : source.CompletionCarrier →ₗ[ℤ]
      Module.Dual ℤ source.CompletionCarrier)
    (targetPairing : target.CompletionCarrier →ₗ[ℤ]
      Module.Dual ℤ target.CompletionCarrier)
    (sourceAction : source.CompletionCarrier →ₗ[ℤ]
      source.CompletionCarrier)
    (targetAction : target.CompletionCarrier →ₗ[ℤ]
      target.CompletionCarrier)
    (sourceMeasurement : source.CompletionCarrier →ₗ[ℤ] H)
    (targetMeasurement : target.CompletionCarrier →ₗ[ℤ] H)
    (sourceEvolution targetEvolution : H →ₗᵢ[ℂ] H) where
  private mk ::
  pairingKernelCompatible : LinearMap.ker sourcePairing ≤
    LinearMap.ker (targetPairing.comp (carrierMap transition))
  pairingNatural : ∀ left right,
    targetPairing (carrierMap transition left)
        (carrierMap transition right) = sourcePairing left right
  actionNatural : ∀ coordinate,
    carrierMap transition (sourceAction coordinate) =
      targetAction (carrierMap transition coordinate)
  measurementNatural : ∀ coordinate,
    sourceMeasurement coordinate =
      targetMeasurement (carrierMap transition coordinate)
  evolutionNatural : ∀ coordinate,
    sourceEvolution coordinate = targetEvolution coordinate

namespace GeneratedJointTransitionAt

/-- Canonical map between the two evaluation coimages.  Kernel compatibility
is generated by the total classifier, not supplied to a consumer. -/
def perfectCarrierMap
    {transition : GeneratedTransition source target}
    {sourcePairing : source.CompletionCarrier →ₗ[ℤ]
      Module.Dual ℤ source.CompletionCarrier}
    {targetPairing : target.CompletionCarrier →ₗ[ℤ]
      Module.Dual ℤ target.CompletionCarrier}
    {sourceAction : source.CompletionCarrier →ₗ[ℤ]
      source.CompletionCarrier}
    {targetAction : target.CompletionCarrier →ₗ[ℤ]
      target.CompletionCarrier}
    {sourceMeasurement : source.CompletionCarrier →ₗ[ℤ] H}
    {targetMeasurement : target.CompletionCarrier →ₗ[ℤ] H}
    {sourceEvolution targetEvolution : H →ₗᵢ[ℂ] H}
    (generated : GeneratedJointTransitionAt transition sourcePairing
      targetPairing sourceAction targetAction sourceMeasurement
      targetMeasurement sourceEvolution targetEvolution) :
    PerfectCarrier sourcePairing →ₗ[ℤ] PerfectCarrier targetPairing :=
  SourceGeneratedScalarPerfectification.canonicalFactor sourcePairing
    ((SourceGeneratedScalarPerfectification.canonicalMap targetPairing).comp
      (carrierMap transition)) (by
        intro coordinate coordinate_mem
        rw [LinearMap.mem_ker] at coordinate_mem ⊢
        apply (Submodule.Quotient.mk_eq_zero _).2
        exact generated.pairingKernelCompatible coordinate_mem)

@[simp] theorem perfectCarrierMap_source_readback
    {transition : GeneratedTransition source target}
    {sourcePairing : source.CompletionCarrier →ₗ[ℤ]
      Module.Dual ℤ source.CompletionCarrier}
    {targetPairing : target.CompletionCarrier →ₗ[ℤ]
      Module.Dual ℤ target.CompletionCarrier}
    {sourceAction : source.CompletionCarrier →ₗ[ℤ]
      source.CompletionCarrier}
    {targetAction : target.CompletionCarrier →ₗ[ℤ]
      target.CompletionCarrier}
    {sourceMeasurement : source.CompletionCarrier →ₗ[ℤ] H}
    {targetMeasurement : target.CompletionCarrier →ₗ[ℤ] H}
    {sourceEvolution targetEvolution : H →ₗᵢ[ℂ] H}
    (generated : GeneratedJointTransitionAt transition sourcePairing
      targetPairing sourceAction targetAction sourceMeasurement
      targetMeasurement sourceEvolution targetEvolution) :
    generated.perfectCarrierMap.comp
        (SourceGeneratedScalarPerfectification.canonicalMap sourcePairing) =
      (SourceGeneratedScalarPerfectification.canonicalMap targetPairing).comp
        (carrierMap transition) :=
  SourceGeneratedScalarPerfectification.canonicalFactor_comp sourcePairing _ _

/-- Outer representation loss transports without erasure. -/
def representationResidualMap
    {transition : GeneratedTransition source target}
    {sourcePairing : source.CompletionCarrier →ₗ[ℤ]
      Module.Dual ℤ source.CompletionCarrier}
    {targetPairing : target.CompletionCarrier →ₗ[ℤ]
      Module.Dual ℤ target.CompletionCarrier}
    {sourceAction : source.CompletionCarrier →ₗ[ℤ]
      source.CompletionCarrier}
    {targetAction : target.CompletionCarrier →ₗ[ℤ]
      target.CompletionCarrier}
    {sourceMeasurement : source.CompletionCarrier →ₗ[ℤ] H}
    {targetMeasurement : target.CompletionCarrier →ₗ[ℤ] H}
    {sourceEvolution targetEvolution : H →ₗᵢ[ℂ] H}
    (generated : GeneratedJointTransitionAt transition sourcePairing
      targetPairing sourceAction targetAction sourceMeasurement
      targetMeasurement sourceEvolution targetEvolution)
    (coordinate :
      SourceGeneratedScalarPerfectification.FaithfulFactorizationResidual
        sourcePairing sourceMeasurement) :
    SourceGeneratedScalarPerfectification.FaithfulFactorizationResidual
      targetPairing targetMeasurement where
  coordinate := carrierMap transition coordinate.coordinate
  invisible_to_dual := generated.pairingKernelCompatible
    coordinate.invisible_to_dual
  visible_to_actual := by
    intro target_zero
    exact coordinate.visible_to_actual <| by
      rw [generated.measurementNatural coordinate.coordinate]
      exact target_zero

end GeneratedJointTransitionAt

/-- Total joint-transition classifier. -/
inductive JointTransitionDispositionAt
    (transition : GeneratedTransition source target)
    (sourcePairing : source.CompletionCarrier →ₗ[ℤ]
      Module.Dual ℤ source.CompletionCarrier)
    (targetPairing : target.CompletionCarrier →ₗ[ℤ]
      Module.Dual ℤ target.CompletionCarrier)
    (sourceAction : source.CompletionCarrier →ₗ[ℤ]
      source.CompletionCarrier)
    (targetAction : target.CompletionCarrier →ₗ[ℤ]
      target.CompletionCarrier)
    (sourceMeasurement : source.CompletionCarrier →ₗ[ℤ] H)
    (targetMeasurement : target.CompletionCarrier →ₗ[ℤ] H)
    (sourceEvolution targetEvolution : H →ₗᵢ[ℂ] H)
  | generated (joint : GeneratedJointTransitionAt transition sourcePairing
      targetPairing sourceAction targetAction sourceMeasurement
      targetMeasurement sourceEvolution targetEvolution)
  | pairingKernelResidual
      (coordinate : PairingKernelResidualAt transition sourcePairing
        targetPairing)
  | pairingValueResidual
      (coordinate : PairingValueResidualAt transition sourcePairing
        targetPairing)
  | actionResidual
      (coordinate : ActionResidualAt transition sourceAction targetAction)
  | measurementResidual
      (coordinate : MeasurementResidualAt transition sourceMeasurement
        targetMeasurement)
  | evolutionResidual
      (coordinate : EvolutionResidualAt sourceEvolution targetEvolution)

noncomputable def settleJointTransition
    (transition : GeneratedTransition source target)
    (sourcePairing : source.CompletionCarrier →ₗ[ℤ]
      Module.Dual ℤ source.CompletionCarrier)
    (targetPairing : target.CompletionCarrier →ₗ[ℤ]
      Module.Dual ℤ target.CompletionCarrier)
    (sourceAction : source.CompletionCarrier →ₗ[ℤ]
      source.CompletionCarrier)
    (targetAction : target.CompletionCarrier →ₗ[ℤ]
      target.CompletionCarrier)
    (sourceMeasurement : source.CompletionCarrier →ₗ[ℤ] H)
    (targetMeasurement : target.CompletionCarrier →ₗ[ℤ] H)
    (sourceEvolution targetEvolution : H →ₗᵢ[ℂ] H) :
    JointTransitionDispositionAt transition sourcePairing targetPairing
      sourceAction targetAction sourceMeasurement targetMeasurement
      sourceEvolution targetEvolution := by
  classical
  by_cases pairingKernelCompatible : LinearMap.ker sourcePairing ≤
      LinearMap.ker (targetPairing.comp (carrierMap transition))
  · by_cases pairingNatural : ∀ left right,
        targetPairing (carrierMap transition left)
            (carrierMap transition right) = sourcePairing left right
    · by_cases actionNatural : ∀ coordinate,
          carrierMap transition (sourceAction coordinate) =
            targetAction (carrierMap transition coordinate)
      · by_cases measurementNatural : ∀ coordinate,
            sourceMeasurement coordinate =
              targetMeasurement (carrierMap transition coordinate)
        · by_cases evolutionNatural : ∀ coordinate,
              sourceEvolution coordinate = targetEvolution coordinate
          · exact .generated
              ⟨pairingKernelCompatible, pairingNatural, actionNatural,
                measurementNatural, evolutionNatural⟩
          · push Not at evolutionNatural
            exact .evolutionResidual
              ⟨Classical.choose evolutionNatural,
                Classical.choose_spec evolutionNatural⟩
        · push Not at measurementNatural
          exact .measurementResidual
            ⟨Classical.choose measurementNatural,
              Classical.choose_spec measurementNatural⟩
      · push Not at actionNatural
        exact .actionResidual
          ⟨Classical.choose actionNatural,
            Classical.choose_spec actionNatural⟩
    · push Not at pairingNatural
      exact .pairingValueResidual
        ⟨Classical.choose pairingNatural,
          Classical.choose (Classical.choose_spec pairingNatural),
          Classical.choose_spec (Classical.choose_spec pairingNatural)⟩
  · rw [SetLike.not_le_iff_exists] at pairingKernelCompatible
    exact .pairingKernelResidual
      ⟨Classical.choose pairingKernelCompatible,
        (Classical.choose_spec pairingKernelCompatible).1,
        (Classical.choose_spec pairingKernelCompatible).2⟩

theorem settleJointTransition_eq_generated
    (transition : GeneratedTransition source target)
    (sourcePairing : source.CompletionCarrier →ₗ[ℤ]
      Module.Dual ℤ source.CompletionCarrier)
    (targetPairing : target.CompletionCarrier →ₗ[ℤ]
      Module.Dual ℤ target.CompletionCarrier)
    (sourceAction : source.CompletionCarrier →ₗ[ℤ]
      source.CompletionCarrier)
    (targetAction : target.CompletionCarrier →ₗ[ℤ]
      target.CompletionCarrier)
    (sourceMeasurement : source.CompletionCarrier →ₗ[ℤ] H)
    (targetMeasurement : target.CompletionCarrier →ₗ[ℤ] H)
    (sourceEvolution targetEvolution : H →ₗᵢ[ℂ] H)
    (pairingKernelCompatible : LinearMap.ker sourcePairing ≤
      LinearMap.ker (targetPairing.comp (carrierMap transition)))
    (pairingNatural : ∀ left right,
      targetPairing (carrierMap transition left)
          (carrierMap transition right) = sourcePairing left right)
    (actionNatural : ∀ coordinate,
      carrierMap transition (sourceAction coordinate) =
        targetAction (carrierMap transition coordinate))
    (measurementNatural : ∀ coordinate,
      sourceMeasurement coordinate =
        targetMeasurement (carrierMap transition coordinate))
    (evolutionNatural : ∀ coordinate,
      sourceEvolution coordinate = targetEvolution coordinate) :
    ∃ generated, settleJointTransition transition sourcePairing targetPairing
        sourceAction targetAction sourceMeasurement targetMeasurement
        sourceEvolution targetEvolution = .generated generated := by
  refine ⟨⟨pairingKernelCompatible, pairingNatural, actionNatural,
    measurementNatural, evolutionNatural⟩, ?_⟩
  simp [settleJointTransition, pairingKernelCompatible, pairingNatural,
    actionNatural, measurementNatural, evolutionNatural]

theorem settleJointTransition_eq_evolutionResidual
    (transition : GeneratedTransition source target)
    (sourcePairing : source.CompletionCarrier →ₗ[ℤ]
      Module.Dual ℤ source.CompletionCarrier)
    (targetPairing : target.CompletionCarrier →ₗ[ℤ]
      Module.Dual ℤ target.CompletionCarrier)
    (sourceAction : source.CompletionCarrier →ₗ[ℤ]
      source.CompletionCarrier)
    (targetAction : target.CompletionCarrier →ₗ[ℤ]
      target.CompletionCarrier)
    (sourceMeasurement : source.CompletionCarrier →ₗ[ℤ] H)
    (targetMeasurement : target.CompletionCarrier →ₗ[ℤ] H)
    (sourceEvolution targetEvolution : H →ₗᵢ[ℂ] H)
    (pairingKernelCompatible : LinearMap.ker sourcePairing ≤
      LinearMap.ker (targetPairing.comp (carrierMap transition)))
    (pairingNatural : ∀ left right,
      targetPairing (carrierMap transition left)
          (carrierMap transition right) = sourcePairing left right)
    (actionNatural : ∀ coordinate,
      carrierMap transition (sourceAction coordinate) =
        targetAction (carrierMap transition coordinate))
    (measurementNatural : ∀ coordinate,
      sourceMeasurement coordinate =
        targetMeasurement (carrierMap transition coordinate))
    (notEvolutionNatural : ¬ ∀ coordinate,
      sourceEvolution coordinate = targetEvolution coordinate) :
    ∃ coordinate, settleJointTransition transition sourcePairing targetPairing
        sourceAction targetAction sourceMeasurement targetMeasurement
        sourceEvolution targetEvolution = .evolutionResidual coordinate := by
  have existsCoordinate : ∃ coordinate,
      sourceEvolution coordinate ≠ targetEvolution coordinate := by
    simpa only [not_forall] using notEvolutionNatural
  refine ⟨⟨Classical.choose existsCoordinate,
    Classical.choose_spec existsCoordinate⟩, ?_⟩
  simp [settleJointTransition, pairingKernelCompatible, pairingNatural,
    actionNatural, measurementNatural, notEvolutionNatural]

end

end RootLawDependentJointTransition
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
