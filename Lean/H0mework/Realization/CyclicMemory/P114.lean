/-
  Proposition 114: cyclic reflexive memory emergence for finite interaction
  cycles.

  Proposition 108 named the three-agent case: a nonzero interaction residual
  around a cyclic gluing witness is a genuine H¹ obstruction, and therefore
  lives outside the exact single-agent linear-time field proved in
  Proposition 102.

  This file proves the finite-cycle version.  The key invariant is not "some
  local write changed some downstream read" by itself.  Local changes may
  cancel around the ring.  The canonical cycle invariant is the accumulated
  interaction-phase residual:

      ∑ i, c i (next i)

  If this residual is nonzero, then the cochain cannot be generated by any
  global potential.  Since the P69/P102 skeleton has no filled triple face,
  every cochain is a cocycle; nonzero accumulated residual therefore gives a
  genuine H¹ class.

  Boundary:
  - This is the mathematical certificate for a finite multi-agent interaction
    cycle once a phase cochain is in hand.  Proposition 119 proves that finite
    reflexive interaction rings generate that cochain structurally.  A
    production runtime still has to prove that it instantiates such a ring and
    that the residual is visible to the observation layer; Proposition 120
    turns that latter claim into an additive projection/kernel certificate.
  - The local recollection/memory-production bridge remains the P55/P71/P80
    theorem: generated temporal holonomy is recollectable memory potential and
    installs trace.  This file does not identify arbitrary additive phase with
    arbitrary runtime observation change.
-/

import H0mework.Realization.CyclicMemory.P108
import H0mework.Realization.Reflexive.FieldProgression

/-! ## Finite cyclic residuals -/

/-- On the identity-pair / zero-triple cover, every cochain is a cocycle.
This is the finite-index analogue of `threeCycleCover_all_cochains_cocycle`. -/
theorem identityPairZeroTripleCover_all_cochains_cocycle
    {Index A : Type*} [AddCommGroup A]
    (c : Index -> Index -> A) :
    CechAdditiveCover.OneCocycle
      (identityPairZeroTripleCover Index A) c := by
  funext i j k
  simp [CechAdditiveCover.d1, identityPairZeroTripleCover]

/-- A global potential has zero accumulated residual around any finite cycle.
The proof is the telescoping law: `∑ p(next i) = ∑ p i` because `next` is a
permutation. -/
theorem cyclic_coboundary_residual_zero
    {Index A : Type*} [Fintype Index] [AddCommGroup A]
    (next : Equiv.Perm Index) (p : Index -> A) :
    (∑ i, CechAdditiveCover.d0
        (identityPairZeroTripleCover Index A) p i (next i)) = 0 := by
  simp [CechAdditiveCover.d0, identityPairZeroTripleCover]
  have hperm : (∑ i, p (next i)) = ∑ i, p i := by
    simpa using (Equiv.sum_comp next p)
  rw [hperm]
  simp

/-- A cochain has noncancelled residual on a chosen cyclic interaction ring
when the sum of its edge phases around that ring is nonzero. -/
def NoncancelledCycleResidual
    {Index A : Type*} [Fintype Index] [AddCommGroup A]
    (next : Equiv.Perm Index) (c : Index -> Index -> A) : Prop :=
  (∑ i, c i (next i)) ≠ 0

/-- A cochain is explained by a global potential on the selected interaction
edges if every selected edge value is the coboundary of that potential. -/
def CycleEdgePotentialExplained
    {Index A : Type*} [Fintype Index] [AddCommGroup A]
    (next : Equiv.Perm Index) (c : Index -> Index -> A) : Prop :=
  exists p : Index -> A,
    forall i,
      c i (next i) =
        CechAdditiveCover.d0
          (identityPairZeroTripleCover Index A) p i (next i)

/-- Any selected-edge explanation by a global potential forces zero accumulated
cycle residual. -/
theorem cycleEdgePotentialExplained_residual_zero
    {Index A : Type*} [Fintype Index] [AddCommGroup A]
    {next : Equiv.Perm Index} {c : Index -> Index -> A}
    (h : CycleEdgePotentialExplained next c) :
    (∑ i, c i (next i)) = 0 := by
  rcases h with ⟨p, hp⟩
  calc
    (∑ i, c i (next i))
        = ∑ i, CechAdditiveCover.d0
            (identityPairZeroTripleCover Index A) p i (next i) := by
          exact Finset.sum_congr rfl (by intro i _; exact hp i)
    _ = 0 := cyclic_coboundary_residual_zero next p

/-- Noncancelled residual rules out even the weaker explanation by a global
potential on the selected cycle edges. -/
theorem not_cycleEdgePotentialExplained_of_noncancelled
    {Index A : Type*} [Fintype Index] [AddCommGroup A]
    {next : Equiv.Perm Index} {c : Index -> Index -> A}
    (hres : NoncancelledCycleResidual next c) :
    Not (CycleEdgePotentialExplained next c) := by
  intro hexpl
  exact hres (cycleEdgePotentialExplained_residual_zero hexpl)

/-- Noncancelled residual rules out being a full 1-coboundary on the P69/P102
skeleton. -/
theorem not_coboundary_of_noncancelled_cycle_residual
    {Index A : Type*} [Fintype Index] [AddCommGroup A]
    (next : Equiv.Perm Index) (c : Index -> Index -> A)
    (hres : NoncancelledCycleResidual next c) :
    Not (CechAdditiveCover.OneCoboundary
      (identityPairZeroTripleCover Index A) c) := by
  intro hb
  rcases hb with ⟨p, hp⟩
  have hzero := cyclic_coboundary_residual_zero next p
  rw [hp] at hzero
  exact hres hzero

/-- A finite cyclic interaction certificate.  `next` is the read/write trigger
ring; `phase` is the interaction-phase cochain; `noncancelled` says the ring
has a genuine accumulated residual.  The `nondegenerate` field records the
intended multi-agent case `N >= 3`; the algebraic obstruction theorem itself
only needs a finite permutation and a nonzero residual. -/
structure FiniteCyclicInteractionCertificate
    (Index A : Type*) [Fintype Index] [AddCommGroup A] where
  next : Equiv.Perm Index
  phase : Index -> Index -> A
  nondegenerate : 3 ≤ Fintype.card Index
  noncancelled : NoncancelledCycleResidual next phase

namespace FiniteCyclicInteractionCertificate

variable {Index A : Type*} [Fintype Index] [AddCommGroup A]

/-- THEOREM 1: the interaction-phase cochain is a 1-cocycle on the P69/P102
cycle skeleton. -/
theorem phase_cocycle
    (C : FiniteCyclicInteractionCertificate Index A) :
    CechAdditiveCover.OneCocycle
      (identityPairZeroTripleCover Index A) C.phase :=
  identityPairZeroTripleCover_all_cochains_cocycle C.phase

/-- THEOREM 2: the noncancelled cycle residual prevents a global potential
from explaining the selected interaction edges. -/
theorem not_cycleEdgePotentialExplained
    (C : FiniteCyclicInteractionCertificate Index A) :
    Not (CycleEdgePotentialExplained C.next C.phase) :=
  not_cycleEdgePotentialExplained_of_noncancelled C.noncancelled

/-- THEOREM 3: the noncancelled cycle residual prevents the phase cochain from
being a coboundary. -/
theorem phase_not_coboundary
    (C : FiniteCyclicInteractionCertificate Index A) :
    Not (CechAdditiveCover.OneCoboundary
      (identityPairZeroTripleCover Index A) C.phase) :=
  not_coboundary_of_noncancelled_cycle_residual
    C.next C.phase C.noncancelled

/-- THEOREM 4: a finite cyclic interaction certificate produces a genuine H¹
obstruction. -/
theorem h1Obstruction
    (C : FiniteCyclicInteractionCertificate Index A) :
    CechAdditiveCover.H1Obstruction
      (identityPairZeroTripleCover Index A) C.phase :=
  ⟨C.phase_cocycle, C.phase_not_coboundary⟩

/-- THEOREM 5: the H¹ certificate is exactly the nontrivial multi-agent
geometry missing from single-agent linear time: no global potential can
generate the selected cycle phases. -/
theorem h1_and_no_global_cycle_potential
    (C : FiniteCyclicInteractionCertificate Index A) :
    CechAdditiveCover.H1Obstruction
        (identityPairZeroTripleCover Index A) C.phase /\
      Not (CycleEdgePotentialExplained C.next C.phase) :=
  ⟨C.h1Obstruction, C.not_cycleEdgePotentialExplained⟩

end FiniteCyclicInteractionCertificate

/-! ## The recollection-memory bridge remains local and generated -/

/-- THEOREM 6: on a generated reflexive edge, temporal holonomy is exactly
recollectable memory potential.  This re-exports the P80 bridge at the point
where the cyclic theorem uses local edge phases. -/
theorem cyclic_local_holonomy_iff_recollectable
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State) :
    TemporalObservationHolonomy (reflexiveQueryGeneratedTimeStep q x) <->
      RecollectableMemoryPotential (reflexiveRecollectionAct q) x :=
  reflexiveQueryGenerated_holonomy_iff_recollectable q x

/-- THEOREM 7: if the generated local edge has temporal holonomy, it installs
future trace at the next section. -/
theorem cyclic_local_holonomy_installs_trace
    {State Observation : Type*}
    (q : ReflexiveQuery State Observation) (x : State)
    (hhol : TemporalObservationHolonomy
      (reflexiveQueryGeneratedTimeStep q x)) :
    TemporalTracePotential (reflexiveQueryGeneratedTimeStep q x) :=
  reflexiveQueryGenerated_holonomy_installs_trace q x hhol

/-!
  Summary:
  - P108's three-agent certificate is now generalized to any finite interaction
    ring: noncancelled accumulated phase is a cocycle that is not a coboundary.
  - The exact invariant is residual noncancellation, not merely local change.
    Local reflexive obstruction supplies edge-level memory production via
    P55/P71/P80; the finite-cycle theorem says when those edge phases glue into
    a nontrivial global H¹ class.
  - This is still not a production-runtime certificate.  Proposition 119
    removes the need to treat the phase cochain as an external artifact for
    finite reflexive rings; runtime still has to supply the finite agent ring,
    visibility to observation, and the nonzero residual witness.  Proposition
    120 makes the visibility part an additive projection/kernel condition.
-/
