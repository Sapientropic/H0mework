/-
  Proposition 108: multi-agent interaction cycles are the right geometric
  place for nontrivial reflexive holonomy.

  Proposition 102 proved a negative boundary: the canonical single-agent,
  Nat-indexed reflexive time field has a global observation potential, so its
  observation-difference cochain is exact.  That does not say reflexive memory
  has no geometry.  It says a linear one-agent time field is not enough to
  produce nontrivial H¹.

  Proposition 103 then isolated the missing shape: a three-cycle gluing
  residual.  This file names the same certificate as a multi-agent interaction
  cycle.  The point is small but important:

    * a nonzero interaction residual is a genuine H¹ obstruction;
    * such a residual cannot be generated by a single global potential;
    * in particular, it cannot be the first-three-point cochain of any
      canonical single-agent reflexive iterated field.

  Boundary: this is still a mathematical geometry certificate, not a claim that
  the production multi-agent runtime emits such a cycle.  It proves that P102's
  exactness result is a single-agent/linear-time boundary, not a refutation of
  multi-agent reflexive memory holonomy.
-/

import H0mework.Realization.QuerySupport.P107
import H0mework.Realization.Descent.P103

/-! ## Multi-agent interaction cycle as cyclic gluing residual -/

/-- A three-agent interaction cycle carries pairwise read/write phase values.
The residual says the indirect interaction path `0 -> 1 -> 2` is not equivalent
to the direct interaction `0 -> 2`. -/
structure MultiAgentInteractionCycle
    (A : Type*) [AddCommGroup A] where
  interactionPhase : ThreeCycleTime -> ThreeCycleTime -> A
  residual_nonzero :
    interactionPhase ThreeCycleTime.t0 ThreeCycleTime.t1 +
      interactionPhase ThreeCycleTime.t1 ThreeCycleTime.t2 ≠
        interactionPhase ThreeCycleTime.t0 ThreeCycleTime.t2

namespace MultiAgentInteractionCycle

variable {A : Type*} [AddCommGroup A]

/-- THEOREM 1: a multi-agent interaction cycle is exactly a P103 three-cycle
gluing residual certificate. -/
def toThreeCycleGluingResidualCertificate
    (C : MultiAgentInteractionCycle A) :
    ThreeCycleGluingResidualCertificate A where
  cochain := C.interactionPhase
  residual_nonzero := C.residual_nonzero

/-- THEOREM 2: every multi-agent interaction cycle gives a genuine H¹
obstruction in the P69/P102/P103 skeleton. -/
theorem h1Obstruction
    (C : MultiAgentInteractionCycle A) :
    CechAdditiveCover.H1Obstruction
      (identityPairZeroTripleCover ThreeCycleTime A)
      C.interactionPhase :=
  C.toThreeCycleGluingResidualCertificate.h1Obstruction

/-- THEOREM 3: a multi-agent interaction cycle cannot be generated by one
global potential on the three-agent cover. -/
theorem not_single_global_potential
    (C : MultiAgentInteractionCycle A) :
    Not (exists p : ThreeCycleTime -> A,
      CechAdditiveCover.d0
          (identityPairZeroTripleCover ThreeCycleTime A) p =
        C.interactionPhase) := by
  rintro ⟨p, hp⟩
  have hzero := threeCycle_coboundary_residual_zero p
  rw [hp] at hzero
  exact C.residual_nonzero hzero

/-- THEOREM 4: a multi-agent interaction cycle cannot be the first-three-point
cochain of any canonical single-agent reflexive iterated field. -/
theorem not_reflexiveIteratedThreeCycleCochain
    (C : MultiAgentInteractionCycle A)
    {State : Type*} (q : ReflexiveQuery State A) (x : State) :
    C.interactionPhase ≠ reflexiveIteratedThreeCycleCochain q x := by
  intro h
  have hzero := reflexiveIteratedThreeCycle_residual_zero q x
  rw [← h] at hzero
  exact C.residual_nonzero hzero

/-- THEOREM 5: the single-agent exactness theorem and the multi-agent H¹
certificate are compatible: the latter lives exactly outside the global
potential image that P102/P103 proved exact. -/
theorem h1_and_not_single_agent_exact
    (C : MultiAgentInteractionCycle A) :
    CechAdditiveCover.H1Obstruction
        (identityPairZeroTripleCover ThreeCycleTime A)
        C.interactionPhase /\
      Not (exists p : ThreeCycleTime -> A,
        CechAdditiveCover.d0
            (identityPairZeroTripleCover ThreeCycleTime A) p =
          C.interactionPhase) :=
  ⟨C.h1Obstruction, C.not_single_global_potential⟩

end MultiAgentInteractionCycle

/-!
  Summary:
  - P102's single-agent linear field is exact because it is induced by a global
    observation potential.
  - A multi-agent interaction cycle with nonzero residual is not induced by any
    such potential, and is therefore a genuine H¹ obstruction.
  - So nontrivial reflexive-memory holonomy belongs geometrically to cyclic
    interaction/gluing data, not to the one-agent Nat line.

  Remaining boundary:
  - The runtime still owes the concrete certificate that real multi-agent
    read/write traces emit such an interaction cycle and that the residual is
    visible to the relevant observation layer rather than sitting in
    `ker(obs)` as in P22.
-/
