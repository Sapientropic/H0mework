import H0mework.Realization.Residual.Algebra

/-!
# Residual transport morphisms

The one-carrier residual law

`r = K r + (r - K r)`

becomes a cross-carrier transport only when a map commutes with the keep
updates.  This file records that naturality directly:

`F (K_source r) = K_target (F r)`

forces

`F (r - K_source r) = F r - K_target (F r)`.

The second equation is therefore not an independent faithfulness field.  The
unit-subtraction and same-rate scalar keeps below produce both equations from
the algebra of the map itself.  Concrete domains must still construct their
actual map `F` and identify their actual update with one of these keeps.
-/

noncomputable section

namespace SaturationMonoid
namespace AffineRelaxation

universe u v w

/-! ## General additive naturality -/

/-- An additive map carries the complementary trace whenever it commutes with
the two keep operators.  The trace equation is derived, not assumed. -/
theorem residualTransportMorphism_keep_and_trace
    {Source : Type u} {Target : Type v}
    [AddCommGroup Source] [AddCommGroup Target]
    (F : Source →+ Target)
    (sourceKeep : Source → Source)
    (targetKeep : Target → Target)
    (hkeep : ∀ r, F (sourceKeep r) = targetKeep (F r))
    (r : Source) :
    F (sourceKeep r) = targetKeep (F r) ∧
      F (r - sourceKeep r) = F r - targetKeep (F r) := by
  refine ⟨hkeep r, ?_⟩
  rw [map_sub, hkeep]

/-- The target-coordinate residual updates commute with the same additive map
as soon as their residual keeps commute. -/
theorem residualTransportUpdate_map_of_keep_commutes
    {Source : Type u} {Target : Type v}
    [AddCommGroup Source] [AddCommGroup Target]
    (F : Source →+ Target)
    (sourceKeep : Source → Source)
    (targetKeep : Target → Target)
    (hkeep : ∀ r, F (sourceKeep r) = targetKeep (F r))
    (sourceTarget sourceState : Source) :
    F (residualTransportUpdate sourceKeep sourceTarget sourceState) =
      residualTransportUpdate targetKeep (F sourceTarget) (F sourceState) := by
  rw [residualTransportUpdate, residualTransportUpdate, map_sub, hkeep,
    map_sub]

/-! ## Generated quantum transport -/

/-- Affine keep which spends one specified additive residual quantum.  This
is intentionally defined on an additive carrier rather than on `ℕ`, where
subtraction is truncated. -/
def residualQuantumKeep
    {E : Type u} [AddCommGroup E] (quantum : E) : E → E :=
  fun r => r - quantum

@[simp]
theorem residualQuantumKeep_complement
    {E : Type u} [AddCommGroup E] (quantum r : E) :
    r - residualQuantumKeep quantum r = quantum := by
  simp [residualQuantumKeep]

/-- Every additive map automatically makes the source/target
quantum-subtraction square commute.  No separate faithfulness or gap premise
is consumed. -/
theorem residualQuantumKeep_commuting_square
    {Source : Type u} {Target : Type v}
    [AddCommGroup Source] [AddCommGroup Target]
    (F : Source →+ Target) (quantum r : Source) :
    F (residualQuantumKeep quantum r) =
        residualQuantumKeep (F quantum) (F r) ∧
      F (r - residualQuantumKeep quantum r) =
        F r - residualQuantumKeep (F quantum) (F r) := by
  constructor <;> simp [residualQuantumKeep]

/-- The full affine state update generated by subtracting a quantum also
commutes automatically. -/
theorem residualQuantumTransportUpdate_map
    {Source : Type u} {Target : Type v}
    [AddCommGroup Source] [AddCommGroup Target]
    (F : Source →+ Target) (quantum sourceTarget sourceState : Source) :
    F
        (residualTransportUpdate
          (residualQuantumKeep quantum) sourceTarget sourceState) =
      residualTransportUpdate
        (residualQuantumKeep (F quantum))
        (F sourceTarget) (F sourceState) := by
  apply residualTransportUpdate_map_of_keep_commutes
  intro r
  simp [residualQuantumKeep]

/-- A concrete proof that the generated quantum has nonzero image preserves
the nonzero complementary trace.  This pointwise condition also supports
finite arithmetic targets, where global injectivity may be impossible. -/
theorem residualQuantumKeep_mapped_trace_ne_zero_of_quantumImage_ne_zero
    {Source : Type u} {Target : Type v}
    [AddCommGroup Source] [AddCommGroup Target]
    (F : Source →+ Target) {quantum : Source}
    (hquantumImage : F quantum ≠ 0) (r : Source) :
    F (r - residualQuantumKeep quantum r) ≠ 0 := by
  simpa using hquantumImage

/-- Global injectivity is a sufficient, but not necessary, way to prove that
the source-generated quantum has nonzero image. -/
theorem residualQuantumKeep_mapped_trace_ne_zero
    {Source : Type u} {Target : Type v}
    [AddCommGroup Source] [AddCommGroup Target]
    (F : Source →+ Target) (hF : Function.Injective F)
    {quantum : Source} (hquantum : quantum ≠ 0) (r : Source) :
    F (r - residualQuantumKeep quantum r) ≠ 0 := by
  apply residualQuantumKeep_mapped_trace_ne_zero_of_quantumImage_ne_zero F
  simpa using hF.ne hquantum

/-- A nonzero quantum image produces a positive norm gap on every normed
target carrier. -/
theorem residualQuantumKeep_mapped_trace_norm_pos_of_quantumImage_ne_zero
    {Source : Type u} {Target : Type v}
    [AddCommGroup Source] [NormedAddCommGroup Target]
    (F : Source →+ Target) {quantum : Source}
    (hquantumImage : F quantum ≠ 0) (r : Source) :
    0 < ‖F (r - residualQuantumKeep quantum r)‖ :=
  norm_pos_iff.mpr
    (residualQuantumKeep_mapped_trace_ne_zero_of_quantumImage_ne_zero
      F hquantumImage r)

/-- On a normed target carrier, injectivity turns the generated nonzero
quantum into a positive norm gap.  Positivity is derived here. -/
theorem residualQuantumKeep_mapped_trace_norm_pos
    {Source : Type u} {Target : Type v}
    [AddCommGroup Source] [NormedAddCommGroup Target]
    (F : Source →+ Target) (hF : Function.Injective F)
    {quantum : Source} (hquantum : quantum ≠ 0) (r : Source) :
    0 < ‖F (r - residualQuantumKeep quantum r)‖ :=
  residualQuantumKeep_mapped_trace_norm_pos_of_quantumImage_ne_zero
    F (by simpa using hF.ne hquantum) r

/-- If an arithmetic residual is proved to lie in the natural-number lattice
generated by the transported source quantum, then falling strictly below the
generated quantum forces that residual to vanish.  The discrete-lattice
equation and nonzero quantum-image fact remain concrete domain theorems; norm
gap positivity is then derived rather than accepted as a premise. -/
theorem residual_eq_zero_of_eq_nsmul_mappedQuantum_of_norm_lt_of_quantumImage_ne_zero
    {Source : Type u} {Target : Type v}
    [AddCommGroup Source]
    [NormedAddCommGroup Target] [NormedSpace ℝ Target]
    (F : Source →+ Target) {quantum : Source}
    (hquantumImage : F quantum ≠ 0)
    (residual : Target) (multiplicity : ℕ)
    (hdiscrete : residual = multiplicity • F quantum)
    (hbelow : ‖residual‖ < ‖F quantum‖) :
    residual = 0 := by
  by_cases hmultiplicity : multiplicity = 0
  · simp [hdiscrete, hmultiplicity]
  · have hquantumNorm : 0 < ‖F quantum‖ :=
      norm_pos_iff.mpr hquantumImage
    have hmultiplicityOne : (1 : ℝ) ≤ multiplicity := by
      exact_mod_cast Nat.one_le_iff_ne_zero.mpr hmultiplicity
    have hresidualNorm :
        ‖residual‖ = (multiplicity : ℝ) * ‖F quantum‖ := by
      rw [hdiscrete, RCLike.norm_nsmul (K := ℝ)]
      simp [nsmul_eq_mul]
    have hquantumLe : ‖F quantum‖ ≤ ‖residual‖ := by
      rw [hresidualNorm]
      nlinarith
    exact False.elim (not_lt_of_ge hquantumLe hbelow)

/-- Injective-map specialization of the discrete below-quantum exclusion. -/
theorem residual_eq_zero_of_eq_nsmul_mappedQuantum_of_norm_lt
    {Source : Type u} {Target : Type v}
    [AddCommGroup Source]
    [NormedAddCommGroup Target] [NormedSpace ℝ Target]
    (F : Source →+ Target) (hF : Function.Injective F)
    {quantum : Source} (hquantum : quantum ≠ 0)
    (residual : Target) (multiplicity : ℕ)
    (hdiscrete : residual = multiplicity • F quantum)
    (hbelow : ‖residual‖ < ‖F quantum‖) :
    residual = 0 := by
  apply
    residual_eq_zero_of_eq_nsmul_mappedQuantum_of_norm_lt_of_quantumImage_ne_zero
      F (residual := residual) (multiplicity := multiplicity)
  · simpa using hF.ne hquantum
  · exact hdiscrete
  · exact hbelow

/-! ## Same-rate scalar transport -/

/-- A linear map commutes with the same scalar keep rate on both residual
modules. -/
theorem scalarKeepLinearMap_map
    {K : Type w} {Source : Type u} {Target : Type v}
    [Field K]
    [AddCommGroup Source] [Module K Source]
    [AddCommGroup Target] [Module K Target]
    (F : Source →ₗ[K] Target) (sigma : K) (r : Source) :
    F (scalarKeepLinearMap (K := K) (E := Source) sigma r) =
      scalarKeepLinearMap (K := K) (E := Target) sigma (F r) := by
  simp [scalarKeepLinearMap]

/-- Same-rate scalar transport gives both requested commuting equations, with
the trace equation forced by linearity. -/
theorem scalarResidualTransportMorphism_commuting_square
    {K : Type w} {Source : Type u} {Target : Type v}
    [Field K]
    [AddCommGroup Source] [Module K Source]
    [AddCommGroup Target] [Module K Target]
    (F : Source →ₗ[K] Target) (sigma : K) (r : Source) :
    F (scalarKeepLinearMap (K := K) (E := Source) sigma r) =
        scalarKeepLinearMap (K := K) (E := Target) sigma (F r) ∧
      F
          (linearResidualTrace
            (scalarKeepLinearMap (K := K) (E := Source) sigma) r) =
        linearResidualTrace
          (scalarKeepLinearMap (K := K) (E := Target) sigma) (F r) := by
  constructor
  · exact scalarKeepLinearMap_map F sigma r
  · simp [linearResidualTrace, scalarKeepLinearMap]

/-- The corresponding same-rate affine updates commute as well. -/
theorem scalarResidualTransportUpdate_map
    {K : Type w} {Source : Type u} {Target : Type v}
    [Field K]
    [AddCommGroup Source] [Module K Source]
    [AddCommGroup Target] [Module K Target]
    (F : Source →ₗ[K] Target) (sigma : K)
    (sourceTarget sourceState : Source) :
    F
        (residualTransportUpdate
          (fun r : Source =>
            scalarKeepLinearMap (K := K) (E := Source) sigma r)
          sourceTarget sourceState) =
      residualTransportUpdate
        (fun r : Target =>
          scalarKeepLinearMap (K := K) (E := Target) sigma r)
        (F sourceTarget) (F sourceState) := by
  rw [residualTransportUpdate, residualTransportUpdate, map_sub,
    scalarKeepLinearMap_map, map_sub]

end AffineRelaxation
end SaturationMonoid
