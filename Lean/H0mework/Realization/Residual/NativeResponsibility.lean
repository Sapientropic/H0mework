import H0mework.Foundation.Responsibility.Lineage
import H0mework.Foundation.Source.Anchor

/-!
# Responsibility lifecycle schema for native residual updates

This module is the shared bridge shape from one source-indexed native update
to one responsibility progress edge.  A process instance names the update and
its keep, forced trace, typed path, path-indexed write-back, and bearer-route
receipts; the framework then generates the lifecycle vocabulary, exact
progress receipt, atomic progress/transfer classifier, and dependent edge.

This is intentionally a schema rather than an authority grant.  A bare
instance may still choose its own update and receipt families.  Authoritative
instances are generated in `EffectiveResidualUpdateResponsibilityProcess`
from an already existing effective process.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace NativeResidualUpdate

universe u

/-- Proof-relevant exact equality receipt living in the lifecycle universe. -/
structure ExactReceipt {α : Type u} (left right : α) : Type u where
  eq : left = right

/-- Domain-native update data consumed by the shared lifecycle schema. -/
structure Process : Type (u + 1) where
  Residual : Type u
  Content : Type u
  Bearer : Type u
  Scope : Type u
  Lineage : Type u
  Incidence : Type u
  SourceObservation : ComplementObservation.ComplementObservationCarrier.{u}
  EventAt : Residual → Type u
  ObstructionAt : Residual → Type u
  update : {current : Residual} → EventAt current → Residual
  content : Residual → Content
  anchor : {current : Residual} → EventAt current →
    MinimalRegistrableSourceAnchor
      SourceObservation Scope Lineage
  incidence : {current : Residual} → EventAt current → Incidence
  obstructionContent : {current : Residual} → ObstructionAt current → Content
  obstructionResidual : {current : Residual} → ObstructionAt current → Residual
  admissionBearer : Residual → Bearer
  nextBearer : {current : Residual} → EventAt current → Bearer
  KeepAt : {current : Residual} → EventAt current → Type u
  TraceAt : {current : Residual} → EventAt current → Type u
  PathAt : {current : Residual} → EventAt current → Residual → Type u
  WriteBackAt : {current : Residual} → (event : EventAt current) →
    PathAt event (update event) → Type u
  RouteAt : {current : Residual} →
    EventAt current → Bearer → Bearer → Type u
  keepReceipt : {current : Residual} → (event : EventAt current) → KeepAt event
  traceReceipt : {current : Residual} → (event : EventAt current) → TraceAt event
  pathReceipt : {current : Residual} → (event : EventAt current) →
    PathAt event (update event)
  writeBackReceipt : {current : Residual} → (event : EventAt current) →
    WriteBackAt event (pathReceipt event)
  routeReceipt : {current : Residual} → (event : EventAt current) →
    (oldBearer : Bearer) → RouteAt event oldBearer (nextBearer event)
  content_update : {current : Residual} → (event : EventAt current) →
    content (update event) = content current

/-- One actual update event, packed with its exact source residual state. -/
structure SourceEvent (P : Process.{u}) : Type u where
  current : P.Residual
  event : P.EventAt current

namespace SourceEvent

variable {P : Process.{u}}

def next (source : SourceEvent P) : P.Residual :=
  P.update source.event

def nextBearer (source : SourceEvent P) : P.Bearer :=
  P.nextBearer source.event

def anchor (source : SourceEvent P) :
    MinimalRegistrableSourceAnchor
      P.SourceObservation P.Scope P.Lineage :=
  P.anchor source.event

def incidence (source : SourceEvent P) : P.Incidence :=
  P.incidence source.event

def scope (source : SourceEvent P) : P.Scope :=
  source.anchor.scope

def lineage (source : SourceEvent P) : P.Lineage :=
  source.anchor.lineage

theorem content_next (source : SourceEvent P) :
    P.content source.next = P.content source.current :=
  P.content_update source.event

end SourceEvent

/-- Shared progress receipt generated by one exact native update. -/
structure ProgressAt
    (P : Process.{u})
    (source : SourceEvent P) (content : P.Content)
    (current next : P.Residual) : Type u where
  current_eq : current = source.current
  next_eq : next = source.next
  content_eq : content = P.content source.current
  obligationSource : SourceEvent P
  anchor_eq : source.anchor = obligationSource.anchor
  incidence_eq : source.incidence = obligationSource.incidence
  scope_eq : source.scope = obligationSource.scope
  lineage_eq : source.lineage = obligationSource.lineage
  keep : P.KeepAt source.event
  trace : P.TraceAt source.event
  path : P.PathAt source.event source.next
  writeBack : P.WriteBackAt source.event path

/-- Accepted bearer transfer generated by the same actual update event. -/
structure TransferAt
    (P : Process.{u})
    (source : SourceEvent P) (oldBearer nextBearer : P.Bearer) : Type u where
  next_eq : nextBearer = source.nextBearer
  changed : oldBearer ≠ nextBearer
  route : P.RouteAt source.event oldBearer source.nextBearer

/-- Canonical lifecycle vocabulary generated from the native schema.  All
non-progress boundary receipts are unavailable. -/
def vocabulary (P : Process.{u}) : Vocabulary.{u} where
  SourceEvent := SourceEvent P
  Content := P.Content
  Residual := P.Residual
  Bearer := P.Bearer
  ProtectedInterest := PUnit.{u + 1}
  Scope := P.Scope
  Lineage := P.Lineage
  Incidence := P.Incidence
  SourceObservation := P.SourceObservation
  sourceAnchor := SourceEvent.anchor
  sourceIncidence := SourceEvent.incidence
  ObstructionAt := fun source => P.ObstructionAt source.current
  demandContent := fun {_} obstruction => P.obstructionContent obstruction
  demandResidual := fun {_} obstruction => P.obstructionResidual obstruction
  CommitmentAt := fun _ _ => PEmpty.{u + 1}
  MandateOriginAt := fun _ _ => PEmpty.{u + 1}
  AcceptedTaskAt := fun _ _ => PEmpty.{u + 1}
  ActiveDependencyAt := fun _ _ => PEmpty.{u + 1}
  ProtectedRiskAt := fun _ _ => PEmpty.{u + 1}
  AdmissionAuthorityAt := fun source scope =>
    ExactReceipt source.scope scope
  AcceptedAt := fun bearer source scope =>
    ExactReceipt bearer (P.admissionBearer source.current) ×
      ExactReceipt source.scope scope
  StandingMandateAt := fun _ _ _ => PEmpty.{u + 1}
  DischargeJurisdiction := fun _ _ => PUnit.{u + 1}
  ProgressAt := ProgressAt P
  MaintenanceAt := fun _ _ _ => PEmpty.{u + 1}
  TypedDeferAt := fun _ _ _ => PEmpty.{u + 1}
  ScopeNarrowingAt := fun _ _ _ => PEmpty.{u + 1}
  TransferAcceptedAt := fun source oldBearer nextBearer _ =>
    TransferAt P source oldBearer nextBearer
  FulfilledAt := fun _ _ _ => PEmpty.{u + 1}
  WaivedAt := fun _ _ _ => PEmpty.{u + 1}
  InvalidatedAt := fun _ _ _ => PEmpty.{u + 1}
  AbandonedAt := fun _ _ _ => PEmpty.{u + 1}
  ImpossibleResidueAcceptedAt := fun _ _ _ => PEmpty.{u + 1}
  SupersessionAt := fun _ _ _ _ _ _ _ => PEmpty.{u + 1}
  ReopenAt := fun _ _ _ _ _ _ _ => PEmpty.{u + 1}
  JurisdictionEndedAt := fun _ _ _ => PEmpty.{u + 1}
  ConsentRevokedAt := fun _ _ _ => PEmpty.{u + 1}
  CapacityReleasedAt := fun _ _ _ => PEmpty.{u + 1}
  UpperRouteAt := fun _ _ _ => PEmpty.{u + 1}
  NextActorSignal := PEmpty.{u + 1}
  AgeSignal := PEmpty.{u + 1}
  TransferOfferSignal := PEmpty.{u + 1}

abbrev V (P : Process.{u}) := vocabulary P
abbrev Obligation (P : Process.{u}) := AdmittedObligation (V P)

/-- One obstruction recognized at the exact source update state. -/
structure AdmissionEvent (P : Process.{u}) : Type u where
  source : SourceEvent P
  obstruction : P.ObstructionAt source.current
  content_eq : P.obstructionContent obstruction = P.content source.current
  residual_eq : P.obstructionResidual obstruction = source.current

/-- Thin recognition of one actual update at the current obligation.  There
is no target, receipt, path, write-back, or selected lifecycle branch here. -/
structure BoundaryEvent
    (P : Process.{u}) (obligation : Obligation P) : Type u where
  source : SourceEvent P
  residual_eq : obligation.residual = source.current
  content_eq : obligation.content = P.content source.current
  anchor_eq : source.anchor = obligation.admission.sourceEvent.anchor
  incidence_eq : source.incidence =
    obligation.admission.sourceEvent.incidence

def demand (P : Process.{u}) (event : AdmissionEvent P) : ProducerDemand (V P) :=
  producerDemandOfObstruction (source := event.source) event.obstruction

def admissionPayload (P : Process.{u}) (event : AdmissionEvent P) :
    NativeAdmissionPayload (V P) where
  sourceEvent := event.source
  content := P.obstructionContent event.obstruction
  residual := P.obstructionResidual event.obstruction
  bearer := P.admissionBearer event.source.current
  beneficiary := PUnit.unit
  scope := event.source.scope
  lineage := event.source.lineage
  anchor_scope_eq := rfl
  anchor_lineage_eq := rfl
  origin := .producerDemand (demand P event) rfl rfl
  authority := ⟨rfl⟩
  assumption := .accepted ⟨⟨rfl⟩, ⟨rfl⟩⟩
  dischargeJurisdiction := PUnit.unit

/-- Exact target obligation written by the actual update. -/
def nextObligation
    (P : Process.{u}) {obligation : Obligation P}
    (event : BoundaryEvent P obligation) : Obligation P :=
  { obligation with
      residual := event.source.next
      bearer := event.source.nextBearer }

/-- The canonical receipt assembled from the four receipts carried by the
same native event. -/
def progressReceipt
    (P : Process.{u}) {obligation : Obligation P}
    (event : BoundaryEvent P obligation) :
    ProgressAt P event.source obligation.content obligation.residual
      event.source.next where
  current_eq := event.residual_eq
  next_eq := rfl
  content_eq := event.content_eq
  obligationSource := obligation.admission.sourceEvent
  anchor_eq := event.anchor_eq
  incidence_eq := event.incidence_eq
  scope_eq := congrArg MinimalRegistrableSourceAnchor.scope event.anchor_eq
  lineage_eq := congrArg MinimalRegistrableSourceAnchor.lineage event.anchor_eq
  keep := P.keepReceipt event.source.event
  trace := P.traceReceipt event.source.event
  path := P.pathReceipt event.source.event
  writeBack := P.writeBackReceipt event.source.event

/-- The source event determines the exact residual and bearer target.  A bearer
change is one atomic progress-and-transfer edge, not a later synthetic event. -/
def boundaryDisposition
    (P : Process.{u}) [bearerDecidableEq : DecidableEq P.Bearer]
    {obligation : Obligation P}
    (event : BoundaryEvent P obligation) :
    BoundaryDisposition (V P) obligation event.source :=
  let progress := progressReceipt P event
  @dite _ (obligation.bearer = event.source.nextBearer)
      (bearerDecidableEq obligation.bearer event.source.nextBearer)
    (fun _ => .carry (.progressed event.source.next progress))
    (fun changed =>
      .carry (.progressedAndTransferred
        event.source.next event.source.nextBearer progress
        { next_eq := rfl
          changed := changed
          route := P.routeReceipt event.source.event obligation.bearer }))

theorem boundaryDisposition_of_bearer_eq
    (P : Process.{u}) [DecidableEq P.Bearer]
    {obligation : Obligation P}
    (event : BoundaryEvent P obligation)
    (sameBearer : obligation.bearer = event.source.nextBearer) :
    boundaryDisposition P event =
      .carry (.progressed event.source.next (progressReceipt P event)) := by
  unfold boundaryDisposition
  exact dif_pos sameBearer

theorem boundaryDisposition_of_bearer_ne
    (P : Process.{u}) [DecidableEq P.Bearer]
    {obligation : Obligation P}
    (event : BoundaryEvent P obligation)
    (changed : obligation.bearer ≠ event.source.nextBearer) :
    boundaryDisposition P event =
      .carry (.progressedAndTransferred
        event.source.next event.source.nextBearer (progressReceipt P event)
        { next_eq := rfl
          changed := changed
          route := P.routeReceipt event.source.event obligation.bearer }) := by
  unfold boundaryDisposition
  exact dif_neg changed

theorem boundaryDisposition_target
    (P : Process.{u}) [DecidableEq P.Bearer]
    {obligation : Obligation P}
    (event : BoundaryEvent P obligation) :
    (boundaryDisposition P event).targetSlot =
      .live (nextObligation P event) := by
  by_cases sameBearer : obligation.bearer = event.source.nextBearer
  · rw [boundaryDisposition_of_bearer_eq P event sameBearer]
    simp [nextObligation, sameBearer,
      BoundaryDisposition.targetSlot, ActiveCarryDisposition.target]
  · rw [boundaryDisposition_of_bearer_ne P event sameBearer]
    simp [nextObligation,
      BoundaryDisposition.targetSlot, ActiveCarryDisposition.target]

/-- Every generated boundary is genuine progress.  Its only variation is
whether the same actual event also carries an accepted bearer transfer. -/
theorem boundaryDisposition_shape
    (P : Process.{u}) [DecidableEq P.Bearer]
    {obligation : Obligation P} (event : BoundaryEvent P obligation) :
    (∃ receipt,
        boundaryDisposition P event =
          .carry (.progressed event.source.next receipt)) ∨
      ∃ progressReceipt transferReceipt,
        boundaryDisposition P event =
          .carry (.progressedAndTransferred event.source.next
            event.source.nextBearer progressReceipt transferReceipt) := by
  by_cases sameBearer : obligation.bearer = event.source.nextBearer
  · exact Or.inl ⟨_, boundaryDisposition_of_bearer_eq P event sameBearer⟩
  · exact Or.inr ⟨_, _, boundaryDisposition_of_bearer_ne P event sameBearer⟩

/-- A native residual schema induces a responsibility process. -/
def toResponsibilityProcess
    (P : Process.{u}) [DecidableEq P.Bearer] :
    NativeResponsibilityProcess (V P) where
  AdmissionEvent := AdmissionEvent P
  admissionPayload := admissionPayload P
  BoundaryEvent := BoundaryEvent P
  boundarySource := fun event => event.source
  boundary_anchor_eq := fun event => event.anchor_eq
  boundary_incidence_eq := fun event => event.incidence_eq
  boundaryDisposition := boundaryDisposition P
  ReopenEvent := fun _ => PEmpty.{u + 1}
  reopenPayload := fun {_} event => nomatch event

abbrev RP (P : Process.{u}) [DecidableEq P.Bearer] :=
  toResponsibilityProcess P

/-! ## Source-aligned exact-target execution -/

open NativeResponsibilityProcess

def emptyState (P : Process.{u}) : ResponsibilityState (V P) :=
  ResponsibilityState.empty (V P)

def admissionEdge
    (P : Process.{u}) [DecidableEq P.Bearer]
    (event : AdmissionEvent P) :
    (RP P).Edge (emptyState P) :=
  .admit event

def admittedState
    (P : Process.{u}) [DecidableEq P.Bearer]
    (event : AdmissionEvent P) : ResponsibilityState (V P) :=
  (admissionEdge P event).target

def admittedObligation
    (P : Process.{u}) (event : AdmissionEvent P) : Obligation P :=
  (admissionPayload P event).toObligation

theorem admittedState_slot_live
    (P : Process.{u}) [DecidableEq P.Bearer]
    (event : AdmissionEvent P) :
    (admittedState P event).slots[0]? =
      some (.live (admittedObligation P event)) :=
  admit_target_slot (P := RP P) event

/-- A live exact-target cursor whose admission source remains the exact origin
of every later generated event. -/
structure LiveCursor
    (P : Process.{u}) [DecidableEq P.Bearer]
    (origin : SourceEvent P) : Type u where
  state : ResponsibilityState (V P)
  obligation : Obligation P
  slot : Fin state.slots.length
  present : state.slots.get slot = .live obligation
  admissionSource_eq : obligation.admission.sourceEvent = origin
  content_eq : obligation.content = P.content obligation.residual

def initialLive
    (P : Process.{u}) [DecidableEq P.Bearer]
    (event : AdmissionEvent P) : LiveCursor P event.source where
  state := admittedState P event
  obligation := admittedObligation P event
  slot := ⟨0, by simp [admittedState, admissionEdge, emptyState, Edge.target]⟩
  present := rfl
  admissionSource_eq := rfl
  content_eq := by
    change P.obstructionContent event.obstruction =
      P.content (P.obstructionResidual event.obstruction)
    rw [event.residual_eq]
    exact event.content_eq

/-- A source-aligned total event family. Every selected event is an actual
event of `P` at that residual and retains the exact admission anchor and
incidence; no target, path, trace, or lifecycle branch is a field. -/
structure Total
    (P : Process.{u}) (origin : SourceEvent P) : Type u where
  event : (residual : P.Residual) → P.EventAt residual
  anchor_eq : (residual : P.Residual) →
    (⟨residual, event residual⟩ : SourceEvent P).anchor = origin.anchor
  incidence_eq : (residual : P.Residual) →
    (⟨residual, event residual⟩ : SourceEvent P).incidence = origin.incidence

def LiveCursor.boundaryEvent
    {P : Process.{u}} [DecidableEq P.Bearer]
    {origin : SourceEvent P}
    (cursor : LiveCursor P origin)
    (total : Total P origin) :
    BoundaryEvent P cursor.obligation where
  source := ⟨cursor.obligation.residual,
    total.event cursor.obligation.residual⟩
  residual_eq := rfl
  content_eq := cursor.content_eq
  anchor_eq := (total.anchor_eq cursor.obligation.residual).trans
    (congrArg SourceEvent.anchor cursor.admissionSource_eq).symm
  incidence_eq := (total.incidence_eq cursor.obligation.residual).trans
    (congrArg SourceEvent.incidence cursor.admissionSource_eq).symm

def LiveCursor.edge
    {P : Process.{u}} [DecidableEq P.Bearer]
    {origin : SourceEvent P}
    (cursor : LiveCursor P origin)
    (total : Total P origin) :
    (RP P).Edge cursor.state :=
  .cross cursor.slot cursor.obligation cursor.present
    (cursor.boundaryEvent total)

theorem LiveCursor.edge_target_at_slot
    {P : Process.{u}} [DecidableEq P.Bearer]
    {origin : SourceEvent P}
    (cursor : LiveCursor P origin)
    (total : Total P origin) :
    (cursor.edge total).target.slots[cursor.slot.val]? =
      some (.live (nextObligation P (cursor.boundaryEvent total))) := by
  have targetAt :=
    cross_target_slot
      (P := RP P) cursor.slot cursor.obligation cursor.present
      (cursor.boundaryEvent total)
  change
    (cursor.edge total).target.slots[cursor.slot.val]? =
      some ((boundaryDisposition P
        (cursor.boundaryEvent total)).targetSlot) at targetAt
  rw [boundaryDisposition_target P
    (cursor.boundaryEvent total)] at targetAt
  exact targetAt

noncomputable def LiveCursor.next
    {P : Process.{u}} [DecidableEq P.Bearer]
    {origin : SourceEvent P}
    (cursor : LiveCursor P origin)
    (total : Total P origin) : LiveCursor P origin := by
  let edge := cursor.edge total
  let nextObligation :=
    NativeResidualUpdate.nextObligation P (cursor.boundaryEvent total)
  have targetAt :
      edge.target.slots[cursor.slot.val]? = some (.live nextObligation) :=
    cursor.edge_target_at_slot total
  let nextSlot : Fin edge.target.slots.length :=
    ⟨cursor.slot.val, (List.getElem?_eq_some_iff.mp targetAt).1⟩
  exact
    { state := edge.target
      obligation := nextObligation
      slot := nextSlot
      present := (List.getElem?_eq_some_iff.mp targetAt).2
      admissionSource_eq := cursor.admissionSource_eq
      content_eq := by
        let residual : P.Residual := cursor.obligation.residual
        have sourceContent : cursor.obligation.content = P.content residual :=
          cursor.content_eq
        exact sourceContent.trans
          (P.content_update (total.event residual)).symm }

@[simp] theorem LiveCursor.next_state
    {P : Process.{u}} [DecidableEq P.Bearer]
    {origin : SourceEvent P}
    (cursor : LiveCursor P origin)
    (total : Total P origin) :
    (cursor.next total).state = (cursor.edge total).target := by
  rfl

@[simp] theorem LiveCursor.next_residual
    {P : Process.{u}} [DecidableEq P.Bearer]
    {origin : SourceEvent P}
    (cursor : LiveCursor P origin)
    (total : Total P origin) :
    (cursor.next total).obligation.residual =
      P.update (total.event cursor.obligation.residual) := by
  rfl

@[simp] theorem LiveCursor.next_bearer
    {P : Process.{u}} [DecidableEq P.Bearer]
    {origin : SourceEvent P}
    (cursor : LiveCursor P origin)
    (total : Total P origin) :
    (cursor.next total).obligation.bearer =
      P.nextBearer (total.event cursor.obligation.residual) := by
  rfl

/-- Residual reached by repeatedly taking the source-owned total event. -/
def Process.iterate
    (P : Process.{u}) {origin : SourceEvent P}
    (total : Total P origin) : P.Residual → Nat → P.Residual
  | residual, 0 => residual
  | residual, length + 1 =>
      P.update (total.event (P.iterate total residual length))

@[simp] theorem Process.iterate_zero
    (P : Process.{u}) {origin : SourceEvent P}
    (total : Total P origin) (residual : P.Residual) :
    P.iterate total residual 0 = residual := by
  rfl

@[simp] theorem Process.iterate_succ
    (P : Process.{u}) {origin : SourceEvent P}
    (total : Total P origin)
    (residual : P.Residual) (length : Nat) :
    P.iterate total residual (length + 1) =
      P.update (total.event (P.iterate total residual length)) := by
  rfl

/-- Bearer reached by the same source-owned update iteration.  At length
zero it is the producer's admission bearer; every successor bearer is fixed
by the actual event at the iterated residual. -/
def Process.iterateBearer
    (P : Process.{u}) {origin : SourceEvent P}
    (total : Total P origin) : P.Residual → Nat → P.Bearer
  | residual, 0 => P.admissionBearer residual
  | residual, length + 1 =>
      P.nextBearer (total.event (P.iterate total residual length))

@[simp] theorem Process.iterateBearer_zero
    (P : Process.{u}) {origin : SourceEvent P}
    (total : Total P origin) (residual : P.Residual) :
    P.iterateBearer total residual 0 = P.admissionBearer residual := by
  rfl

@[simp] theorem Process.iterateBearer_succ
    (P : Process.{u}) {origin : SourceEvent P}
    (total : Total P origin)
    (residual : P.Residual) (length : Nat) :
    P.iterateBearer total residual (length + 1) =
      P.nextBearer (total.event (P.iterate total residual length)) := by
  rfl

def runCastTarget
    {V : Vocabulary.{u}} {P : NativeResponsibilityProcess V}
    {source target nextTarget : ResponsibilityState V}
    (target_eq : target = nextTarget) (run : P.Run source target) :
    P.Run source nextTarget :=
  target_eq ▸ run

@[simp] theorem runCastTarget_events
    {V : Vocabulary.{u}} {P : NativeResponsibilityProcess V}
    {source target nextTarget : ResponsibilityState V}
    (target_eq : target = nextTarget) (run : P.Run source target) :
    (runCastTarget target_eq run).events = run.events := by
  cases target_eq
  rfl

/-- One exact generated prefix of the canonical responsibility process. -/
structure GeneratedPrefix
    (P : Process.{u}) [DecidableEq P.Bearer]
    (admission : AdmissionEvent P) (length : Nat) : Type u where
  target : LiveCursor P admission.source
  run : (RP P).Run (admittedState P admission) target.state
  events_length : run.events.length = length

noncomputable def generatedPrefix
    (P : Process.{u}) [DecidableEq P.Bearer]
    {admission : AdmissionEvent P}
    (total : Total P admission.source) :
    (length : Nat) → GeneratedPrefix P admission length
  | 0 =>
      { target := initialLive P admission
        run := .nil
        events_length := rfl }
  | length + 1 =>
      let prior := generatedPrefix P (admission := admission) total length
      let edge := prior.target.edge total
      { target := prior.target.next total
        run := runCastTarget
          (LiveCursor.next_state prior.target total).symm
          (NativeResponsibilityProcess.Run.step prior.run edge)
        events_length := by
          simp only [runCastTarget_events,
            NativeResponsibilityProcess.Run.events,
            List.length_append, List.length_singleton,
            prior.events_length] }

theorem generatedPrefix_events_length
    (P : Process.{u}) [DecidableEq P.Bearer]
    {admission : AdmissionEvent P}
    (total : Total P admission.source) (length : Nat) :
    (generatedPrefix P (admission := admission) total length).run.events.length =
      length :=
  (generatedPrefix P (admission := admission) total length).events_length

/-- Successive generated prefixes are literal extensions of one run by the
source-owned event at the prior target; they are not independently admitted
finite executions. -/
theorem generatedPrefix_succ_events
    (P : Process.{u}) [DecidableEq P.Bearer]
    {admission : AdmissionEvent P}
    (total : Total P admission.source) (length : Nat) :
    (generatedPrefix P (admission := admission) total (length + 1)).run.events =
      (generatedPrefix P (admission := admission) total length).run.events ++
        [((generatedPrefix P (admission := admission) total length).target.edge
          total).lifecycleEvent] := by
  simp only [generatedPrefix, runCastTarget_events,
    NativeResponsibilityProcess.Run.events]

/-- Earlier generated prefixes are literal event prefixes of every later
prefix on the same admission and source-owned total process. -/
theorem generatedPrefix_events_prefix_of_le
    (P : Process.{u}) [DecidableEq P.Bearer]
    {admission : AdmissionEvent P}
    (total : Total P admission.source)
    {earlier later : Nat} (earlierLeLater : earlier ≤ later) :
    (generatedPrefix P (admission := admission) total earlier).run.events <+:
      (generatedPrefix P (admission := admission) total later).run.events := by
  obtain ⟨difference, rfl⟩ := Nat.exists_eq_add_of_le earlierLeLater
  induction difference with
  | zero =>
      exact List.prefix_refl _
  | succ difference inductionHypothesis =>
      rw [Nat.add_succ, generatedPrefix_succ_events]
      exact (inductionHypothesis (by omega)).trans
        (List.prefix_append _ _)

/-- A generated prefix is one actual residual run: its target is the literal
iterate of source-owned updates from the admitted residual. -/
theorem generatedPrefix_target_residual
    (P : Process.{u}) [DecidableEq P.Bearer]
    {admission : AdmissionEvent P}
    (total : Total P admission.source) (length : Nat) :
    (generatedPrefix P (admission := admission) total length).target.obligation.residual =
      P.iterate total admission.source.current length := by
  induction length with
  | zero =>
      exact admission.residual_eq
  | succ length inductionHypothesis =>
      simp only [generatedPrefix, Process.iterate_succ]
      rw [LiveCursor.next_residual, inductionHypothesis]

/-- The live bearer at a generated-prefix target is fixed by that same
source-owned update iteration. -/
theorem generatedPrefix_target_bearer
    (P : Process.{u}) [DecidableEq P.Bearer]
    {admission : AdmissionEvent P}
    (total : Total P admission.source) (length : Nat) :
    (generatedPrefix P (admission := admission) total length).target.obligation.bearer =
      P.iterateBearer total admission.source.current length := by
  induction length with
  | zero =>
      rfl
  | succ length inductionHypothesis =>
      simp only [generatedPrefix, Process.iterateBearer_succ]
      rw [LiveCursor.next_bearer]
      have residualEq :=
        generatedPrefix_target_residual P (admission := admission) total length
      rw [residualEq]

/-- Full source-state context for one actual lifecycle progress event. -/
structure ProgressEventAt
    (P : Process.{u}) [DecidableEq P.Bearer]
    (source : ResponsibilityState (V P)) : Type u where
  slot : Fin source.slots.length
  obligation : Obligation P
  present : source.slots.get slot = .live obligation
  boundary : BoundaryEvent P obligation

/-- Shared schema compiler from an actual source event to its dependent
responsibility progress edge. -/
def compileProgressEdge
    (P : Process.{u}) [DecidableEq P.Bearer]
    {source : ResponsibilityState (V P)}
    (event : ProgressEventAt P source) : (RP P).Edge source :=
  .cross event.slot event.obligation event.present event.boundary

@[simp] theorem compileProgressEdge_kind
    (P : Process.{u}) [DecidableEq P.Bearer]
    {source : ResponsibilityState (V P)}
    (event : ProgressEventAt P source) :
    (compileProgressEdge P event).lifecycleEvent.kind.IsProgress := by
  by_cases sameBearer : event.obligation.bearer =
      event.boundary.source.nextBearer
  · exact Or.inl (by
      simp [compileProgressEdge, RP, toResponsibilityProcess,
        NativeResponsibilityProcess.Edge.lifecycleEvent,
        boundaryDisposition_of_bearer_eq P event.boundary sameBearer]
      change LifecycleKind.progressed = LifecycleKind.progressed
      rfl)
  · exact Or.inr (by
      simp [compileProgressEdge, RP, toResponsibilityProcess,
        NativeResponsibilityProcess.Edge.lifecycleEvent,
        boundaryDisposition_of_bearer_ne P event.boundary sameBearer]
      change LifecycleKind.progressedAndTransferred =
        LifecycleKind.progressedAndTransferred
      rfl)

theorem compileProgressEdge_kind_eq_progressed_of_bearer_eq
    (P : Process.{u}) [bearerDecidableEq : DecidableEq P.Bearer]
    {source : ResponsibilityState (V P)}
    (event : ProgressEventAt P source)
    (sameBearer : event.obligation.bearer =
      event.boundary.source.nextBearer) :
    (compileProgressEdge P event).lifecycleEvent.kind = .progressed := by
  simp [compileProgressEdge, RP, toResponsibilityProcess,
    NativeResponsibilityProcess.Edge.lifecycleEvent,
    boundaryDisposition_of_bearer_eq P event.boundary sameBearer]
  change LifecycleKind.progressed = LifecycleKind.progressed
  rfl

theorem compileProgressEdge_kind_eq_progressedAndTransferred_of_bearer_ne
    (P : Process.{u}) [DecidableEq P.Bearer]
    {source : ResponsibilityState (V P)}
    (event : ProgressEventAt P source)
    (changed : event.obligation.bearer ≠
      event.boundary.source.nextBearer) :
    (compileProgressEdge P event).lifecycleEvent.kind =
      .progressedAndTransferred := by
  simp [compileProgressEdge, RP, toResponsibilityProcess,
    NativeResponsibilityProcess.Edge.lifecycleEvent,
    boundaryDisposition_of_bearer_ne P event.boundary changed]
  change LifecycleKind.progressedAndTransferred =
    LifecycleKind.progressedAndTransferred
  rfl

theorem compileProgressEdge_target_at_slot
    (P : Process.{u}) [DecidableEq P.Bearer]
    {source : ResponsibilityState (V P)}
    (event : ProgressEventAt P source) :
    (compileProgressEdge P event).target.slots[event.slot.val]? =
      some (.live (nextObligation P event.boundary)) := by
  have targetAt :=
    NativeResponsibilityProcess.cross_target_slot
      (P := RP P) event.slot event.obligation event.present event.boundary
  change
    (NativeResponsibilityProcess.Edge.cross
        (P := RP P) event.slot event.obligation event.present
        event.boundary).target.slots[event.slot.val]? =
      some (boundaryDisposition P event.boundary).targetSlot at targetAt
  rw [boundaryDisposition_target P event.boundary] at targetAt
  simpa [compileProgressEdge] using targetAt

end NativeResidualUpdate
end ResponsibilityLifecycle
end SaturationMonoid
