import Mathlib.Combinatorics.Quiver.Path
import H0mework.Realization.Residual.TraceWriteback

/-!
# Path-indexed residual transport on native quivers

`EffectiveResidualProcess` handles repeated application of one update and one
keep.  Native rewrite systems, crystal moves, and recollection edges instead
carry different admissible arrows with arrow-dependent keeps.

This module records the minimal common contract after those concrete patterns
already occur in the repository:

* native arrows remain `Type`-valued data in a `Quiver`;
* every arrow owns its keep and actual residual update law;
* `Quiver.Path` composition generates the composite keep, trace cocycle, and
  recollectable write-back;
* a quiver prefunctor and a linear carrier map form a transport morphism only
  after edge keeps commute;
* such morphisms compose, so path trace and write-back can cross more than one
  representation layer.

This is a transporter foundation.  It does not generate domain arrows,
faithfulness, a nonzero quantum, or an obstruction exclusion.
-/

noncomputable section

namespace SaturationMonoid
namespace ResidualProjection

open AffineRelaxation

universe uK uE uV uF uW uQ

/-- A native quiver whose every arrow transports a residual by its own keep.

The quiver remains an explicit typeclass parameter at every use site rather
than being chosen by this structure, so concrete adapters can install a local
named quiver without polluting the vertex type globally. -/
structure PathIndexedResidualTransport
    (K : Type uK) (E : Type uE) (Vertex : Type uV)
    [Field K] [AddCommGroup E] [Module K E]
    [Quiver.{uQ} Vertex] where
  residual : Vertex → E
  edgeKeep :
    {source target : Vertex} →
      (source ⟶ target) →
        E →ₗ[K] E
  edge_residual_transport :
    ∀ {source target : Vertex}
      (edge : source ⟶ target),
        residual target = edgeKeep edge (residual source)

namespace PathIndexedResidualTransport

variable {K : Type uK} {E : Type uE} {Vertex : Type uV}
variable [Field K] [AddCommGroup E] [Module K E] [Quiver.{uQ} Vertex]

/-- Native composable paths for the transport's own quiver. -/
abbrev Path
    (_P : PathIndexedResidualTransport K E Vertex)
    (source target : Vertex) : Type _ :=
  Quiver.Path source target

/-- Composite keep generated in execution order by every retained arrow. -/
def pathKeep
    (P : PathIndexedResidualTransport K E Vertex)
    {source : Vertex} :
    {target : Vertex} → P.Path source target → E →ₗ[K] E
  | _, .nil => LinearMap.id
  | _, .cons path edge =>
      (P.edgeKeep edge).comp (P.pathKeep path)

@[simp] theorem pathKeep_nil
    (P : PathIndexedResidualTransport K E Vertex)
    (source : Vertex) :
    P.pathKeep (.nil : P.Path source source) = LinearMap.id := by
  rfl

@[simp] theorem pathKeep_cons
    (P : PathIndexedResidualTransport K E Vertex)
    {source middle target : Vertex}
    (path : P.Path source middle)
    (edge : middle ⟶ target) :
    P.pathKeep (.cons path edge) =
      (P.edgeKeep edge).comp (P.pathKeep path) := by
  rfl

/-- Path composition composes keeps in actual execution order. -/
theorem pathKeep_comp
    (P : PathIndexedResidualTransport K E Vertex)
    {source middle target : Vertex}
    (first : P.Path source middle)
    (second : P.Path middle target) :
    P.pathKeep (first.comp second) =
      (P.pathKeep second).comp (P.pathKeep first) := by
  induction second with
  | nil =>
      rfl
  | cons second edge inductionHypothesis =>
      simp only [Quiver.Path.comp_cons, pathKeep_cons]
      rw [inductionHypothesis]
      rfl

/-- Arrow-by-arrow transport sends the actual source residual to the actual
path endpoint residual. -/
theorem residual_path_transport
    (P : PathIndexedResidualTransport K E Vertex)
    {source target : Vertex}
    (path : P.Path source target) :
    P.residual target =
      P.pathKeep path (P.residual source) := by
  induction path with
  | nil =>
      rfl
  | cons path edge inductionHypothesis =>
      rw [P.edge_residual_transport edge]
      change
        P.edgeKeep edge (P.residual _) =
          P.edgeKeep edge (P.pathKeep path (P.residual _))
      rw [inductionHypothesis]

/-- Complement generated by a retained path on an arbitrary carrier value. -/
def pathTraceAt
    (P : PathIndexedResidualTransport K E Vertex)
    {source target : Vertex}
    (path : P.Path source target)
    (residual : E) : E :=
  linearResidualTrace (P.pathKeep path) residual

/-- Complement generated by a retained path on its actual source residual. -/
def pathTrace
    (P : PathIndexedResidualTransport K E Vertex)
    {source target : Vertex}
    (path : P.Path source target) : E :=
  P.pathTraceAt path (P.residual source)

@[simp] theorem pathTraceAt_nil
    (P : PathIndexedResidualTransport K E Vertex)
    (source : Vertex) (residual : E) :
    P.pathTraceAt (.nil : P.Path source source) residual = 0 := by
  simp [pathTraceAt, linearResidualTrace]

@[simp] theorem pathTrace_nil
    (P : PathIndexedResidualTransport K E Vertex)
    (source : Vertex) :
    P.pathTrace (.nil : P.Path source source) = 0 := by
  simp [pathTrace]

/-- Conservation uniquely forces the trace of a retained path on every
carrier value, before specializing to the path's actual source residual. -/
theorem pathTraceAt_unique
    (P : PathIndexedResidualTransport K E Vertex)
    {source target : Vertex}
    (path : P.Path source target)
    (residual trace : E) :
    residual = P.pathKeep path residual + trace ↔
      trace = P.pathTraceAt path residual := by
  constructor
  · intro split
    rw [pathTraceAt, linearResidualTrace]
    calc
      trace =
          (P.pathKeep path residual + trace) -
            P.pathKeep path residual := by
        abel
      _ = residual - P.pathKeep path residual := by
        rw [← split]
  · intro traceEquation
    rw [traceEquation, pathTraceAt, linearResidualTrace]
    abel

/-- The path trace is exactly the actual endpoint residual difference. -/
theorem pathTrace_eq_source_sub_target
    (P : PathIndexedResidualTransport K E Vertex)
    {source target : Vertex}
    (path : P.Path source target) :
    P.pathTrace path =
      P.residual source - P.residual target := by
  rw [pathTrace, pathTraceAt, linearResidualTrace,
    P.residual_path_transport path]

/-- The actual path residual splits into its endpoint keep and forced trace. -/
theorem residual_eq_endpoint_add_pathTrace
    (P : PathIndexedResidualTransport K E Vertex)
    {source target : Vertex}
    (path : P.Path source target) :
    P.residual source =
      P.residual target + P.pathTrace path := by
  rw [P.pathTrace_eq_source_sub_target path]
  abel

/-- Conservation uniquely forces the trace of the actual retained path. -/
theorem pathTrace_unique
    (P : PathIndexedResidualTransport K E Vertex)
    {source target : Vertex}
    (path : P.Path source target)
    (trace : E) :
    P.residual source = P.residual target + trace ↔
      trace = P.pathTrace path := by
  constructor
  · intro split
    rw [P.pathTrace_eq_source_sub_target path, split]
    abel
  · intro traceEquation
    rw [traceEquation]
    exact P.residual_eq_endpoint_add_pathTrace path

/-- Trace cocycle on arbitrary carrier values.  The second trace is evaluated
after the first path keep, not at the old basepoint. -/
theorem pathTraceAt_comp
    (P : PathIndexedResidualTransport K E Vertex)
    {source middle target : Vertex}
    (first : P.Path source middle)
    (second : P.Path middle target)
    (residual : E) :
    P.pathTraceAt (first.comp second) residual =
      P.pathTraceAt first residual +
        P.pathTraceAt second (P.pathKeep first residual) := by
  rw [pathTraceAt, pathTraceAt, pathTraceAt, P.pathKeep_comp]
  exact
    (linearResidualTrace_twoStep_eq_composite_trace
      (P.pathKeep second) (P.pathKeep first) residual).symm

/-- On actual typed paths, transported basepoints are enforced by the middle
vertex index, so the cocycle is ordinary addition. -/
theorem pathTrace_comp
    (P : PathIndexedResidualTransport K E Vertex)
    {source middle target : Vertex}
    (first : P.Path source middle)
    (second : P.Path middle target) :
    P.pathTrace (first.comp second) =
      P.pathTrace first + P.pathTrace second := by
  rw [pathTrace, P.pathTraceAt_comp, pathTrace, pathTrace]
  rw [← P.residual_path_transport first]

/-! ## Recollectable path write-back -/

/-- Remaining value and uniquely forced path trace on an arbitrary input. -/
def pathWriteBackAt
    (P : PathIndexedResidualTransport K E Vertex)
    {source target : Vertex}
    (path : P.Path source target)
    (residual : E) :
    ResidualTraceWriteBackCarrier E :=
  (P.pathKeep path residual, P.pathTraceAt path residual)

/-- Actual endpoint residual paired with the completed native-path trace. -/
def pathWriteBack
    (P : PathIndexedResidualTransport K E Vertex)
    {source target : Vertex}
    (path : P.Path source target) :
    ResidualTraceWriteBackCarrier E :=
  (P.residual target, P.pathTrace path)

theorem pathWriteBack_eq_pathWriteBackAt
    (P : PathIndexedResidualTransport K E Vertex)
    {source target : Vertex}
    (path : P.Path source target) :
    P.pathWriteBack path =
      P.pathWriteBackAt path (P.residual source) := by
  apply Prod.ext
  · exact P.residual_path_transport path
  · rfl

/-- Appending a path consumes the old live component and adds the newly
forced trace to the already written memory. -/
theorem pathWriteBackAt_comp
    (P : PathIndexedResidualTransport K E Vertex)
    {source middle target : Vertex}
    (first : P.Path source middle)
    (second : P.Path middle target)
    (residual : E) :
    P.pathWriteBackAt (first.comp second) residual =
      residualTraceWriteBackKeep (P.pathKeep second)
        (P.pathWriteBackAt first residual) := by
  apply Prod.ext
  · change
      P.pathKeep (first.comp second) residual =
        P.pathKeep second (P.pathKeep first residual)
    rw [P.pathKeep_comp]
    rfl
  · change
      P.pathTraceAt (first.comp second) residual =
        P.pathTraceAt first residual +
          P.pathTraceAt second (P.pathKeep first residual)
    exact P.pathTraceAt_comp first second residual

/-- Actual typed path composition performs the same whole-carrier write-back
update. -/
theorem pathWriteBack_comp
    (P : PathIndexedResidualTransport K E Vertex)
    {source middle target : Vertex}
    (first : P.Path source middle)
    (second : P.Path middle target) :
    P.pathWriteBack (first.comp second) =
      residualTraceWriteBackKeep (P.pathKeep second)
        (P.pathWriteBack first) := by
  rw [P.pathWriteBack_eq_pathWriteBackAt,
    P.pathWriteBack_eq_pathWriteBackAt]
  exact P.pathWriteBackAt_comp first second (P.residual source)

/-- Whole-carrier recollection recovers the residual before the path. -/
theorem pathWriteBack_recollects_source
    (P : PathIndexedResidualTransport K E Vertex)
    {source target : Vertex}
    (path : P.Path source target) :
    residualTraceWriteBackRecollection (K := K)
        (P.pathWriteBack path) =
      P.residual source := by
  simp [residualTraceWriteBackRecollection, pathWriteBack]
  exact P.residual_eq_endpoint_add_pathTrace path |>.symm

/-! ## Path transport morphisms and composition -/

/-- A concrete morphism between path-indexed residual transports.

There is deliberately no injectivity, faithfulness, quantum, or target
obstruction field.  Those are pointwise facts for concrete generated paths. -/
structure Morphism
    {Source : Type uE} {SourceVertex : Type uV}
    {Target : Type uF} {TargetVertex : Type uW}
    [AddCommGroup Source] [Module K Source]
    [AddCommGroup Target] [Module K Target]
    [Quiver SourceVertex] [Quiver TargetVertex]
    (source : PathIndexedResidualTransport K Source SourceVertex)
    (target : PathIndexedResidualTransport K Target TargetVertex) where
  quiverMap : SourceVertex ⥤q TargetVertex
  carrierMap : Source →ₗ[K] Target
  residual_naturality :
    ∀ vertex,
      carrierMap (source.residual vertex) =
        target.residual (quiverMap.obj vertex)
  edge_keep_naturality :
    ∀ {left right : SourceVertex}
      (edge : left ⟶ right)
      (residual : Source),
        carrierMap (source.edgeKeep edge residual) =
          target.edgeKeep (quiverMap.map edge) (carrierMap residual)

namespace Morphism

variable
    {Source : Type uE} {SourceVertex : Type uV}
    {Target : Type uF} {TargetVertex : Type uW}
    [AddCommGroup Source] [Module K Source]
    [AddCommGroup Target] [Module K Target]
    [Quiver SourceVertex] [Quiver TargetVertex]
    {source : PathIndexedResidualTransport K Source SourceVertex}
    {target : PathIndexedResidualTransport K Target TargetVertex}

/-- Map a retained native path through the morphism's quiver prefunctor. -/
def mapPath
    (M : Morphism source target)
    {left right : SourceVertex}
    (path : source.Path left right) :
    target.Path (M.quiverMap.obj left) (M.quiverMap.obj right) := by
  exact M.quiverMap.mapPath path

@[simp] theorem mapPath_nil
    (M : Morphism source target)
    (vertex : SourceVertex) :
    M.mapPath (.nil : source.Path vertex vertex) = .nil := by
  rfl

@[simp] theorem mapPath_cons
    (M : Morphism source target)
    {left middle right : SourceVertex}
    (path : source.Path left middle)
    (edge : middle ⟶ right) :
    M.mapPath (.cons path edge) =
      .cons (M.mapPath path) (M.quiverMap.map edge) := by
  rfl

/-- Mapped paths retain composition. -/
theorem mapPath_comp
    (M : Morphism source target)
    {left middle right : SourceVertex}
    (first : source.Path left middle)
    (second : source.Path middle right) :
    M.mapPath (first.comp second) =
      (M.mapPath first).comp (M.mapPath second) := by
  exact M.quiverMap.mapPath_comp first second

/-- Edge keep naturality composes along every retained path. -/
theorem pathKeep_naturality
    (M : Morphism source target)
    {left right : SourceVertex}
    (path : source.Path left right)
    (residual : Source) :
    M.carrierMap (source.pathKeep path residual) =
      target.pathKeep (M.mapPath path) (M.carrierMap residual) := by
  induction path with
  | nil =>
      simp
  | cons path edge inductionHypothesis =>
      change
        M.carrierMap
            (source.edgeKeep edge (source.pathKeep path residual)) =
          target.edgeKeep (M.quiverMap.map edge)
            (target.pathKeep (M.mapPath path) (M.carrierMap residual))
      rw [M.edge_keep_naturality edge, inductionHypothesis]

/-- Complementary path trace naturality is forced by path keep naturality. -/
theorem pathTraceAt_naturality
    (M : Morphism source target)
    {left right : SourceVertex}
    (path : source.Path left right)
    (residual : Source) :
    M.carrierMap (source.pathTraceAt path residual) =
      target.pathTraceAt (M.mapPath path) (M.carrierMap residual) := by
  simp [PathIndexedResidualTransport.pathTraceAt,
    linearResidualTrace, M.pathKeep_naturality path residual]

/-- Actual path traces commute with the same concrete morphism. -/
theorem pathTrace_naturality
    (M : Morphism source target)
    {left right : SourceVertex}
    (path : source.Path left right) :
    M.carrierMap (source.pathTrace path) =
      target.pathTrace (M.mapPath path) := by
  rw [PathIndexedResidualTransport.pathTrace,
    PathIndexedResidualTransport.pathTrace,
    M.pathTraceAt_naturality,
    M.residual_naturality]

/-- Exact generated-path kernel audit: a source trace is killed by the
carrier map precisely when the mapped actual path has zero target trace.
This derives pointwise kernel behavior from naturality; it adds no global
injectivity or faithfulness field. -/
theorem pathTrace_mem_carrierMap_ker_iff
    (M : Morphism source target)
    {left right : SourceVertex}
    (path : source.Path left right) :
    source.pathTrace path ∈ LinearMap.ker M.carrierMap ↔
      target.pathTrace (M.mapPath path) = 0 := by
  rw [LinearMap.mem_ker, M.pathTrace_naturality]

/-- A generated source trace avoids the carrier-map kernel exactly when its
mapped actual path trace is nonzero. -/
theorem pathTrace_not_mem_carrierMap_ker_iff
    (M : Morphism source target)
    {left right : SourceVertex}
    (path : source.Path left right) :
    source.pathTrace path ∉ LinearMap.ker M.carrierMap ↔
      target.pathTrace (M.mapPath path) ≠ 0 :=
  not_congr (M.pathTrace_mem_carrierMap_ker_iff path)

/-- Path keep naturality lifts to the entire live/memory write-back update.
This commuting square is derived; it is not an extra morphism field. -/
theorem pathWriteBackKeep_naturality
    (M : Morphism source target)
    {left right : SourceVertex}
    (path : source.Path left right)
    (state : ResidualTraceWriteBackCarrier Source) :
    residualTraceWriteBackMap M.carrierMap
        (residualTraceWriteBackKeep (source.pathKeep path) state) =
      residualTraceWriteBackKeep
        (target.pathKeep (M.mapPath path))
        (residualTraceWriteBackMap M.carrierMap state) := by
  exact residualTraceWriteBackMap_keep_commutes
    M.carrierMap
    (source.pathKeep path)
    (target.pathKeep (M.mapPath path))
    (M.pathKeep_naturality path)
    state

/-- Arbitrary-input write-back commutes with the same concrete path
morphism. -/
theorem pathWriteBackAt_naturality
    (M : Morphism source target)
    {left right : SourceVertex}
    (path : source.Path left right)
    (residual : Source) :
    residualTraceWriteBackMap M.carrierMap
        (source.pathWriteBackAt path residual) =
      target.pathWriteBackAt (M.mapPath path)
        (M.carrierMap residual) := by
  apply Prod.ext
  · exact M.pathKeep_naturality path residual
  · exact M.pathTraceAt_naturality path residual

/-- The componentwise second-order lift carries the whole path write-back,
not only its scalar trace readout. -/
theorem pathWriteBack_naturality
    (M : Morphism source target)
    {left right : SourceVertex}
    (path : source.Path left right) :
    residualTraceWriteBackMap M.carrierMap
        (source.pathWriteBack path) =
      target.pathWriteBack (M.mapPath path) := by
  apply Prod.ext
  · change
      M.carrierMap (source.residual right) =
        target.residual (M.quiverMap.obj right)
    exact M.residual_naturality right
  · change
      M.carrierMap (source.pathTrace path) =
        target.pathTrace (M.mapPath path)
    exact M.pathTrace_naturality path

/-- Identity path-transport morphism. -/
def id
    (P : PathIndexedResidualTransport K Source SourceVertex) :
    Morphism P P where
  quiverMap := Prefunctor.id SourceVertex
  carrierMap := LinearMap.id
  residual_naturality := by
    intro _
    rfl
  edge_keep_naturality := by
    intro _ _ edge residual
    rfl

/-- Composition of concrete path-transport morphisms. -/
def comp
    {Middle : Type uF} {MiddleVertex : Type uW}
    {Final : Type*} {FinalVertex : Type*}
    [AddCommGroup Middle] [Module K Middle]
    [AddCommGroup Final] [Module K Final]
    [Quiver MiddleVertex] [Quiver FinalVertex]
    {middle : PathIndexedResidualTransport K Middle MiddleVertex}
    {final : PathIndexedResidualTransport K Final FinalVertex}
    (first : Morphism source middle)
    (second : Morphism middle final) :
    Morphism source final where
  quiverMap := first.quiverMap.comp second.quiverMap
  carrierMap := second.carrierMap.comp first.carrierMap
  residual_naturality := by
    intro vertex
    change
      second.carrierMap
          (first.carrierMap (source.residual vertex)) =
        final.residual
          (second.quiverMap.obj (first.quiverMap.obj vertex))
    rw [first.residual_naturality, second.residual_naturality]
  edge_keep_naturality := by
    intro left right edge residual
    change
      second.carrierMap
          (first.carrierMap (source.edgeKeep edge residual)) =
        final.edgeKeep
          (second.quiverMap.map (first.quiverMap.map edge))
          (second.carrierMap (first.carrierMap residual))
    rw [first.edge_keep_naturality, second.edge_keep_naturality]

/-- A composed morphism maps paths by the two prefunctors in sequence. -/
theorem comp_mapPath
    {Middle : Type uF} {MiddleVertex : Type uW}
    {Final : Type*} {FinalVertex : Type*}
    [AddCommGroup Middle] [Module K Middle]
    [AddCommGroup Final] [Module K Final]
    [Quiver MiddleVertex] [Quiver FinalVertex]
    {middle : PathIndexedResidualTransport K Middle MiddleVertex}
    {final : PathIndexedResidualTransport K Final FinalVertex}
    (first : Morphism source middle)
    (second : Morphism middle final)
    {left right : SourceVertex}
    (path : source.Path left right) :
    (first.comp second).mapPath path =
      second.mapPath (first.mapPath path) := by
  exact Prefunctor.mapPath_comp_apply
    first.quiverMap second.quiverMap path

end Morphism

end PathIndexedResidualTransport
end ResidualProjection
end SaturationMonoid
