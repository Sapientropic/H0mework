import H0mework.Realization.Coherent.Completion
import H0mework.Realization.Topology.HilbertCokernel
import H0mework.Realization.Topology.CompressedUnitaryDefectPort

/-!
# Integral-orbit closed conservative defect port

An actual integral feature generates its complexified closed range.  Every
integral event therefore has a canonical observed-state representative.  For
any ambient isometry, subtracting a next orbit point already in this closed
range changes neither the canonical external output nor its energy account.

Every incidence also has canonical internal and external projections whose
ambient sum is the original incidence.  No covariance, residual vanishing,
finite generation, or determinant premise enters.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace SourceGeneratedIntegralOrbitClosedDefectPort

open SourceGeneratedCompressedUnitaryDefectPort
open SourceGeneratedHilbertCokernel
open SourceGeneratedIntegralCoherentCompletion

noncomputable section

universe l h

variable {L : Type l} [AddCommGroup L]
variable {H : Type h} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- Closed subspace generated by the actual complexified integral feature. -/
def orbitClosedRange (feature : L →ₗ[ℤ] H) : ClosedSubmodule ℂ H :=
  closedRange (complexifiedFeature feature)

/-- Every actual integral event lies in the closed range generated by the
same feature. -/
theorem feature_mem_orbitClosedRange (feature : L →ₗ[ℤ] H) (event : L) :
    feature event ∈ orbitClosedRange feature := by
  apply (LinearMap.range (complexifiedFeature feature)).le_topologicalClosure
  exact ⟨1 ⊗ₜ[ℤ] event, complexifiedFeature_one_tmul feature event⟩

/-- Canonical observed input represented by one actual integral event. -/
def orbitEvent (feature : L →ₗ[ℤ] H) (event : L) :
    (orbitClosedRange feature).toSubmodule :=
  ⟨feature event, feature_mem_orbitClosedRange feature event⟩

variable [CompleteSpace H]

/-- Component of an incidence retained inside the generated orbit closure. -/
def orbitProjectedInternal (feature : L →ₗ[ℤ] H) :
    H →L[ℂ] (orbitClosedRange feature).toSubmodule :=
  (orbitClosedRange feature).toSubmodule.orthogonalProjectionOnto

/-- Component of an incidence exposed outside the generated orbit closure. -/
def orbitProjectedExternal (feature : L →ₗ[ℤ] H) :
    H →L[ℂ] Submodule.orthogonal (orbitClosedRange feature).toSubmodule :=
  (Submodule.orthogonal
    (orbitClosedRange feature).toSubmodule).orthogonalProjectionOnto

/-- Canonical whole-incidence disposition.  No coordinate is discarded. -/
theorem incidence_eq_projectedInternal_add_projectedExternal
    (feature : L →ₗ[ℤ] H) (incidence : H) :
    incidence =
      (orbitProjectedInternal feature incidence : H) +
        (orbitProjectedExternal feature incidence : H) := by
  symm
  exact (orbitClosedRange feature).toSubmodule.starProjection_add_starProjection_orthogonal
    incidence

/-- Removing a next orbit point already in the observed closed range does not
change the canonical external projection. -/
theorem externalDefect_eq_projectedExternal_sub_of_mem
    (feature : L →ₗ[ℤ] H) (V : H →ₗᵢ[ℂ] H) (event : L)
    (next : H) (next_mem : next ∈ orbitClosedRange feature) :
    externalDefect (orbitClosedRange feature) V (orbitEvent feature event) =
      orbitProjectedExternal feature (V (feature event) - next) := by
  change
    (Submodule.orthogonal (orbitClosedRange feature).toSubmodule).orthogonalProjectionOnto
      (V (feature event)) = _
  rw [orbitProjectedExternal, map_sub]
  rw [Submodule.orthogonalProjectionOnto_orthogonal_apply_eq_zero
    (K := (orbitClosedRange feature).toSubmodule) next_mem]
  rw [sub_zero]

end


end SourceGeneratedIntegralOrbitClosedDefectPort
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
