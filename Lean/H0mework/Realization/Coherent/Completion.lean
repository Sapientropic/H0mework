import Mathlib.LinearAlgebra.TensorProduct.Tower
import H0mework.Realization.Feature.HilbertRealization

/-!
# Integral events and their coherent Hilbert completion

An actual integral event carrier and an actual complex Hilbert feature
generate their scalar extension, coherent completed range, and faithful
realization in the original Hilbert target.  The construction formalizes one
state module with discrete event and continuous coherent faces; it assumes no
finite generation, projectivity, torsion-freeness, nondegeneracy, or
determinant eligibility.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace SourceGeneratedIntegralCoherentCompletion

open SourceGeneratedComplexFeaturePerfectification

noncomputable section

universe l h

variable {L : Type l} [AddCommGroup L]

/-- Canonical complex scalar extension of an integral event carrier. -/
abbrev ComplexifiedCarrier (L : Type l) [AddCommGroup L] :=
  @TensorProduct ℤ _ ℂ L _ _ Algebra.toModule inferInstance

section AlgebraicScalarExtension

variable {H : Type h} [AddCommGroup H] [Module ℂ H]

/-- Heterogeneous bilinear map `(c,l) ↦ c • map(l)` for any complex
module target. -/
def complexifiedLinearMapBilinear (map : L →ₗ[ℤ] H) :
    ℂ →ₗ[ℂ] L →ₗ[ℤ] H where
  toFun coefficient :=
    { toFun := fun value ↦ coefficient • map value
      map_add' := fun left right ↦ by
        rw [map_add, smul_add]
      map_smul' := fun integer value ↦ by
        rw [map_smul]
        exact smul_comm coefficient integer (map value) }
  map_add' left right := by
    apply LinearMap.ext
    intro value
    exact add_smul left right (map value)
  map_smul' outer inner := by
    apply LinearMap.ext
    intro value
    exact (smul_smul outer inner (map value)).symm

/-- Complex scalar extension of an arbitrary integral map. -/
def complexifiedLinearMap (map : L →ₗ[ℤ] H) :
    ComplexifiedCarrier L →ₗ[ℂ] H :=
  TensorProduct.AlgebraTensorModule.lift
    (complexifiedLinearMapBilinear map)

@[simp] theorem complexifiedLinearMap_tmul
    (map : L →ₗ[ℤ] H) (coefficient : ℂ) (value : L) :
    complexifiedLinearMap map (coefficient ⊗ₜ[ℤ] value) =
      coefficient • map value := by
  rfl

@[simp] theorem complexifiedLinearMap_one_tmul
    (map : L →ₗ[ℤ] H) (value : L) :
    complexifiedLinearMap map (1 ⊗ₜ[ℤ] value) = map value := by
  rw [complexifiedLinearMap_tmul, one_smul]

end AlgebraicScalarExtension

variable {H : Type h} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- Backward-compatible Hilbert spelling of the now algebraic scalar-extension
bilinear map. -/
abbrev complexifiedFeatureBilinear (feature : L →ₗ[ℤ] H) :=
  complexifiedLinearMapBilinear feature

/-- Complex-linear Hilbert feature generated by the actual integral
feature. -/
def complexifiedFeature (feature : L →ₗ[ℤ] H) :
    ComplexifiedCarrier L →ₗ[ℂ] H :=
  complexifiedLinearMap feature

@[simp] theorem complexifiedFeature_tmul
    (feature : L →ₗ[ℤ] H) (coefficient : ℂ) (value : L) :
    complexifiedFeature feature (coefficient ⊗ₜ[ℤ] value) =
      coefficient • feature value := by
  exact complexifiedLinearMap_tmul feature coefficient value

@[simp] theorem complexifiedFeature_one_tmul
    (feature : L →ₗ[ℤ] H) (value : L) :
    complexifiedFeature feature (1 ⊗ₜ[ℤ] value) = feature value := by
  exact complexifiedLinearMap_one_tmul feature value

/-- The discrete event enters its complex scalar extension.  Injectivity is
not asserted: any source torsion remains an explicit kernel. -/
def integralToComplexification :
    L →ₗ[ℤ] ComplexifiedCarrier L :=
  TensorProduct.mk ℤ ℂ L 1

@[simp] theorem integralToComplexification_apply (value : L) :
    integralToComplexification value = 1 ⊗ₜ[ℤ] value := by
  rfl

abbrev CoherentCompletion (feature : L →ₗ[ℤ] H) :=
  HilbertAmbient (complexifiedFeature feature)

/-- Discrete events enter the coherent completion through the same actual
feature; no independent continuous carrier is introduced. -/
def discreteToCoherentCompletion (feature : L →ₗ[ℤ] H) :
    L →ₗ[ℤ] CoherentCompletion feature :=
  ((canonicalHilbertMap (complexifiedFeature feature)).restrictScalars ℤ).comp
    integralToComplexification

variable [CompleteSpace H]

/-- Faithful realization of the generated coherent completion. -/
def coherentCompletionRealization (feature : L →ₗ[ℤ] H) :
    CoherentCompletion feature →ₗᵢ[ℂ] H :=
  hilbertAmbientRealization (complexifiedFeature feature)

@[simp] theorem discreteToCoherentCompletion_actual_readback
    (feature : L →ₗ[ℤ] H) (value : L) :
    coherentCompletionRealization feature
        (discreteToCoherentCompletion feature value) = feature value := by
  change hilbertAmbientRealization (complexifiedFeature feature)
      (canonicalHilbertMap (complexifiedFeature feature)
        (1 ⊗ₜ[ℤ] value)) = feature value
  rw [hilbertAmbientRealization_source_readback,
    complexifiedFeature_one_tmul]

theorem coherentCompletionRealization_injective
    (feature : L →ₗ[ℤ] H) :
    Function.Injective (coherentCompletionRealization feature) :=
  (coherentCompletionRealization feature).injective

end

end SourceGeneratedIntegralCoherentCompletion
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
