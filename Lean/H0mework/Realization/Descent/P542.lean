import H0mework.Realization.Descent.P541

/-!
# Proposition 542: the free descent quotient is too coarse

P540 built the canonical descent quotient generated by all arithmetic-admissible
seven-facet states.  P541 correctly exposed the remaining prime-injectivity
obligation for that quotient.

This file checks that obligation instead of assuming it.  The free descent
relation is too large: because the same H¹ spectral point can be paired with
different arithmetic image points, the quotient identifies distinct prime
arithmetic codes.  Therefore the P540 free descent quotient cannot be the final
structured producer.

This is useful failure.  The next producer must refine the gluing relation,
for example by a physics/Euler-allowed compatibility relation, before taking
the quotient, rather than gluing every arithmetic-admissible seven-facet point
freely.
-/

noncomputable section

namespace SaturationMonoid
namespace AffineRelaxation

/-! ## The arithmetic witness chosen by `ofArithmetic` is unique on half sigma -/

/-- THEOREM 1: although `ArithmeticAdmissibleSevenFacet.arithmetic` is defined
via `Classical.choose`, the `ofArithmetic` constructor recovers the supplied
half-sigma image point.  The proof uses the nondegenerate half-sigma
injectivity of the exponent image. -/
theorem ofArithmetic_arithmetic_eq
    (r : HalfSigmaArithmeticImage)
    (facets : Fin 7 -> Prop)
    (phase : ThreeCycleTime -> ThreeCycleTime -> ℝ)
    (analytic : ℂ) :
    (ArithmeticAdmissibleSevenFacet.ofArithmetic facets phase analytic r).arithmetic =
      r := by
  apply Subtype.ext
  exact
    (ArithmeticAdmissibleSevenFacet.arithmetic_rate_eq
        (ArithmeticAdmissibleSevenFacet.ofArithmetic facets phase analytic r)).trans
      (ArithmeticAdmissibleSevenFacet.ofArithmetic_rate_eq
        facets phase analytic r)

/-! ## Free descent collapses distinct prime arithmetic codes -/

/-- A fixed spectral point used to show that the free descent relation can glue
multiple arithmetic rates through the same H¹ side. -/
def zeroDescentSpectralPoint : H1SpectralProjection (1 / 2 : ℝ) where
  phase := fun _ _ => 0
  analytic := 0

/-- The arithmetic image point for a named prime exponent. -/
def halfSigmaPrimeImage (p : PrimeExponent) : HalfSigmaArithmeticImage :=
  SigmaExponentImage.ofNat (1 / 2 : ℝ) p.1

private def collapseFacets : Fin 7 -> Prop := fun _ => True

private def collapsePhase : ThreeCycleTime -> ThreeCycleTime -> ℝ :=
  zeroDescentSpectralPoint.phase

private def collapseAnalytic : ℂ :=
  zeroDescentSpectralPoint.analytic

/-- THEOREM 2: every prime arithmetic code is equal in the free descent
quotient to the same zero spectral point. -/
theorem descentPrimeCode_eq_zeroSpectral
    (p : PrimeExponent) :
    descentArithmeticPrimeCode p =
      descentSpectralShadow zeroDescentSpectralPoint := by
  let x : ArithmeticAdmissibleSevenFacet :=
    ArithmeticAdmissibleSevenFacet.ofArithmetic
      collapseFacets collapsePhase collapseAnalytic (halfSigmaPrimeImage p)
  have harithmetic :
      descentArithmeticPrimeCode p =
        descentArithmeticShadow x.arithmetic := by
    simp [descentArithmeticPrimeCode, halfSigmaPrimeImage,
      ofArithmetic_arithmetic_eq, x]
    rfl
  have hspectral :
      descentSpectralShadow x.spectral =
        descentSpectralShadow zeroDescentSpectralPoint := by
    rfl
  exact harithmetic.trans ((descent_shadow_eq x).trans hspectral)

/-- THEOREM 3: the free descent quotient identifies the arithmetic codes for
the distinct primes 2 and 3. -/
theorem descentPrimeCode_two_eq_three :
    descentArithmeticPrimeCode primeTwo =
      descentArithmeticPrimeCode primeThree := by
  have h2 := descentPrimeCode_eq_zeroSpectral primeTwo
  have h3 := descentPrimeCode_eq_zeroSpectral primeThree
  exact h2.trans h3.symm

/-- THEOREM 4: the free descent quotient does not preserve the canonical
prime-indexed support. -/
theorem not_descentArithmeticPrimeCodeInjective :
    Not DescentArithmeticPrimeCodeInjective := by
  intro hinj
  exact primeTwo_ne_primeThree'
    (hinj descentPrimeCode_two_eq_three)

/-- THEOREM 5: consequently, the free descent quotient cannot provide a
structured bridge via the canonical arithmetic prime code. -/
theorem no_free_descent_structuredBridge_via_canonical_prime_code :
    Not
      (DescentPredicateCompatible ∧
        DescentArithmeticPrimeCodeInjective) := by
  intro h
  exact not_descentArithmeticPrimeCodeInjective h.2

/-! ## Packaged boundary certificate -/

/-- Compact certificate that P540's free descent quotient is still too coarse
for the final structured producer. -/
structure FreeDescentPrimeCollapseCertificate where
  two_eq_three :
    descentArithmeticPrimeCode primeTwo =
      descentArithmeticPrimeCode primeThree
  prime_two_ne_three :
    primeTwo ≠ primeThree
  not_prime_code_injective :
    Not DescentArithmeticPrimeCodeInjective
  no_structured_bridge_via_canonical_code :
    Not
      (DescentPredicateCompatible ∧
        DescentArithmeticPrimeCodeInjective)

/-- THEOREM 6: the canonical free-descent collapse certificate. -/
theorem freeDescentPrimeCollapseCertificate :
    FreeDescentPrimeCollapseCertificate where
  two_eq_three := descentPrimeCode_two_eq_three
  prime_two_ne_three := primeTwo_ne_primeThree'
  not_prime_code_injective := not_descentArithmeticPrimeCodeInjective
  no_structured_bridge_via_canonical_code :=
    no_free_descent_structuredBridge_via_canonical_prime_code

end AffineRelaxation
end SaturationMonoid
