/-
  Proposition 103: the cyclic gluing residual certificate for nontrivial H¹.

  Proposition 102 established the crucial negative boundary: the canonical
  linear/Nat time field generated by a reflexive loop induces an additive
  observation-difference cocycle, but it is a coboundary.  This file turns the
  remaining "extra cyclic/gluing data" into a reusable certificate.

  On a three-open cycle with no filled triple-overlap face, every 1-cochain is
  a cocycle.  Such a cochain is forced to be a coboundary only if its phase is
  path-additive:

      c(0,1) + c(1,2) = c(0,2).

  Therefore a nonzero cyclic residual

      c(0,1) + c(1,2) ≠ c(0,2)

  is a pure mathematical certificate of a nontrivial H¹ obstruction.  Conversely,
  any cochain sampled from a global observation potential has zero residual and
  cannot be the desired non-coboundary.

  Boundary: this still does not prove that a production runtime has such a
  residual.  It proves exactly what the runtime / richer sheaf layer has to
  supply.
-/

import H0mework.Realization.Reflexive.P102

/-! ## Generic three-cycle residual criterion -/

/-- All cochains on the three-cycle skeleton are cocycles because the cover has
no filled triple-overlap face. -/
theorem threeCycleCover_all_cochains_cocycle
    {A : Type*} [AddCommGroup A]
    (c : ThreeCycleTime -> ThreeCycleTime -> A) :
    CechAdditiveCover.OneCocycle
      (identityPairZeroTripleCover ThreeCycleTime A) c := by
  funext i j k
  simp [CechAdditiveCover.d1, identityPairZeroTripleCover]

/-- A coboundary on the three-cycle skeleton has zero accumulated phase around
the `0 -> 1 -> 2` path relative to the direct `0 -> 2` edge. -/
theorem threeCycle_coboundary_residual_zero
    {A : Type*} [AddCommGroup A]
    (s : ThreeCycleTime -> A) :
    CechAdditiveCover.d0
        (identityPairZeroTripleCover ThreeCycleTime A) s
        ThreeCycleTime.t0 ThreeCycleTime.t1 +
      CechAdditiveCover.d0
        (identityPairZeroTripleCover ThreeCycleTime A) s
        ThreeCycleTime.t1 ThreeCycleTime.t2 =
      CechAdditiveCover.d0
        (identityPairZeroTripleCover ThreeCycleTime A) s
        ThreeCycleTime.t0 ThreeCycleTime.t2 := by
  simp [CechAdditiveCover.d0, identityPairZeroTripleCover]

/-- THEOREM 1: a nonzero accumulated three-cycle residual rules out being a
coboundary. -/
theorem threeCycle_not_coboundary_of_residual
    {A : Type*} [AddCommGroup A]
    (c : ThreeCycleTime -> ThreeCycleTime -> A)
    (hres :
      c ThreeCycleTime.t0 ThreeCycleTime.t1 +
        c ThreeCycleTime.t1 ThreeCycleTime.t2 ≠
          c ThreeCycleTime.t0 ThreeCycleTime.t2) :
    Not (CechAdditiveCover.OneCoboundary
      (identityPairZeroTripleCover ThreeCycleTime A) c) := by
  intro hb
  rcases hb with ⟨s, hs⟩
  have h01 :
      s ThreeCycleTime.t1 - s ThreeCycleTime.t0 =
        c ThreeCycleTime.t0 ThreeCycleTime.t1 := by
    simpa [CechAdditiveCover.d0, identityPairZeroTripleCover] using
      congrFun (congrFun hs ThreeCycleTime.t0) ThreeCycleTime.t1
  have h12 :
      s ThreeCycleTime.t2 - s ThreeCycleTime.t1 =
        c ThreeCycleTime.t1 ThreeCycleTime.t2 := by
    simpa [CechAdditiveCover.d0, identityPairZeroTripleCover] using
      congrFun (congrFun hs ThreeCycleTime.t1) ThreeCycleTime.t2
  have h02 :
      s ThreeCycleTime.t2 - s ThreeCycleTime.t0 =
        c ThreeCycleTime.t0 ThreeCycleTime.t2 := by
    simpa [CechAdditiveCover.d0, identityPairZeroTripleCover] using
      congrFun (congrFun hs ThreeCycleTime.t0) ThreeCycleTime.t2
  apply hres
  rw [← h01, ← h12, ← h02]
  abel

/-- A compact runtime/sheaf-facing certificate: a three-cycle cochain with
nonzero accumulated residual. -/
structure ThreeCycleGluingResidualCertificate
    (A : Type*) [AddCommGroup A] where
  cochain : ThreeCycleTime -> ThreeCycleTime -> A
  residual_nonzero :
    cochain ThreeCycleTime.t0 ThreeCycleTime.t1 +
      cochain ThreeCycleTime.t1 ThreeCycleTime.t2 ≠
        cochain ThreeCycleTime.t0 ThreeCycleTime.t2

namespace ThreeCycleGluingResidualCertificate

/-- THEOREM 2: a three-cycle residual certificate is a genuine H¹ obstruction
in the P69/P102 skeleton. -/
theorem h1Obstruction
    {A : Type*} [AddCommGroup A]
    (C : ThreeCycleGluingResidualCertificate A) :
    CechAdditiveCover.H1Obstruction
      (identityPairZeroTripleCover ThreeCycleTime A) C.cochain :=
  ⟨threeCycleCover_all_cochains_cocycle C.cochain,
    threeCycle_not_coboundary_of_residual C.cochain C.residual_nonzero⟩

end ThreeCycleGluingResidualCertificate

/-! ## Global observation potentials have zero residual -/

/-- Map the three-cycle sample points to the first three natural time points. -/
def threeCycleToNat : ThreeCycleTime -> Nat
  | ThreeCycleTime.t0 => 0
  | ThreeCycleTime.t1 => 1
  | ThreeCycleTime.t2 => 2

/-- Restrict a global Nat-indexed observation potential to the three-cycle
sample points. -/
def threeCyclePotentialSample
    {A : Type*} (p : Nat -> A) : ThreeCycleTime -> A :=
  fun t => p (threeCycleToNat t)

/-- The three-cycle cochain induced by a global Nat-indexed potential. -/
def threeCycleCochainFromPotential
    {A : Type*} [AddCommGroup A] (p : Nat -> A) :
    ThreeCycleTime -> ThreeCycleTime -> A :=
  CechAdditiveCover.d0
    (identityPairZeroTripleCover ThreeCycleTime A)
    (threeCyclePotentialSample p)

/-- THEOREM 3: any three-cycle cochain induced by a global potential has zero
residual. -/
theorem threeCycleCochainFromPotential_residual_zero
    {A : Type*} [AddCommGroup A] (p : Nat -> A) :
    threeCycleCochainFromPotential p ThreeCycleTime.t0 ThreeCycleTime.t1 +
      threeCycleCochainFromPotential p ThreeCycleTime.t1 ThreeCycleTime.t2 =
        threeCycleCochainFromPotential p ThreeCycleTime.t0 ThreeCycleTime.t2 :=
  threeCycle_coboundary_residual_zero (threeCyclePotentialSample p)

/-- THEOREM 4: any three-cycle cochain induced by a global potential is a
coboundary. -/
theorem threeCycleCochainFromPotential_is_coboundary
    {A : Type*} [AddCommGroup A] (p : Nat -> A) :
    CechAdditiveCover.OneCoboundary
      (identityPairZeroTripleCover ThreeCycleTime A)
      (threeCycleCochainFromPotential p) :=
  ⟨threeCyclePotentialSample p, rfl⟩

/-- THEOREM 5: a global-potential-induced three-cycle cochain cannot be an H¹
obstruction. -/
theorem not_h1_of_threeCycleCochainFromPotential
    {A : Type*} [AddCommGroup A] (p : Nat -> A) :
    Not (CechAdditiveCover.H1Obstruction
      (identityPairZeroTripleCover ThreeCycleTime A)
      (threeCycleCochainFromPotential p)) :=
  CechAdditiveCover.not_h1Obstruction_of_coboundary
    (identityPairZeroTripleCover ThreeCycleTime A)
    (threeCycleCochainFromPotential p)
    (threeCycleCochainFromPotential_is_coboundary p)

/-! ## Reflexive iterated fields are global-potential induced -/

/-- The observation potential of the canonical iterated field generated by a
reflexive query. -/
def reflexiveIteratedObservationPotential
    {State A : Type*} [AddCommGroup A]
    (q : ReflexiveQuery State A) (x : State) : Nat -> A :=
  observationPotential (reflexiveQueryIteratedTimeField q x)

/-- The first-three-time-point cochain induced by a reflexive iterated field. -/
def reflexiveIteratedThreeCycleCochain
    {State A : Type*} [AddCommGroup A]
    (q : ReflexiveQuery State A) (x : State) :
    ThreeCycleTime -> ThreeCycleTime -> A :=
  threeCycleCochainFromPotential
    (reflexiveIteratedObservationPotential q x)

/-- THEOREM 6: the first-three-point cochain of any reflexive iterated field has
zero residual. -/
theorem reflexiveIteratedThreeCycle_residual_zero
    {State A : Type*} [AddCommGroup A]
    (q : ReflexiveQuery State A) (x : State) :
    reflexiveIteratedThreeCycleCochain q x
        ThreeCycleTime.t0 ThreeCycleTime.t1 +
      reflexiveIteratedThreeCycleCochain q x
        ThreeCycleTime.t1 ThreeCycleTime.t2 =
        reflexiveIteratedThreeCycleCochain q x
          ThreeCycleTime.t0 ThreeCycleTime.t2 :=
  threeCycleCochainFromPotential_residual_zero
    (reflexiveIteratedObservationPotential q x)

/-- THEOREM 7: the first-three-point cochain of any reflexive iterated field is
a coboundary. -/
theorem reflexiveIteratedThreeCycle_is_coboundary
    {State A : Type*} [AddCommGroup A]
    (q : ReflexiveQuery State A) (x : State) :
    CechAdditiveCover.OneCoboundary
      (identityPairZeroTripleCover ThreeCycleTime A)
      (reflexiveIteratedThreeCycleCochain q x) :=
  threeCycleCochainFromPotential_is_coboundary
    (reflexiveIteratedObservationPotential q x)

/-- THEOREM 8: the first-three-point cochain of any reflexive iterated field is
not a nontrivial H¹ obstruction. -/
theorem not_h1_of_reflexiveIteratedThreeCycle
    {State A : Type*} [AddCommGroup A]
    (q : ReflexiveQuery State A) (x : State) :
    Not (CechAdditiveCover.H1Obstruction
      (identityPairZeroTripleCover ThreeCycleTime A)
      (reflexiveIteratedThreeCycleCochain q x)) :=
  not_h1_of_threeCycleCochainFromPotential
    (reflexiveIteratedObservationPotential q x)

/-!
  Summary:
  - Nontrivial H¹ on the three-cycle skeleton is equivalent to a nonzero
    accumulated gluing residual of the form `c01 + c12 != c02`.
  - A global observation potential, including the canonical field generated by
    iterating a reflexive query, always has zero residual and is a coboundary.
  - Thus the missing final certificate is now exact: runtime/sheaf machinery
    must supply cyclic gluing residual data not reducible to a global
    observation potential.
-/
