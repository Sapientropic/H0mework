import H0mework.Realization.Graph.Realization
import H0mework.Realization.Graph.CokernelNaturality

/-!
# Naturality of the actual functional-graph realization

The completion of an actual functional graph embeds canonically into its
complete target.  This realization commutes with every generated graph
self-morphism, and its second coordinate is exactly the generated continuous
graph functional.  No domain source, relation annihilation, isometry,
finiteness, or determinant premise is used.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace SourceGeneratedFunctionalGraphPerfectification

open SourceGeneratedComplexFeaturePerfectification

noncomputable section

universe c h

variable {C : Type c} [AddCommGroup C] [Module ℂ C]
variable {H : Type h} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
variable [CompleteSpace H]

/-- Realization of the generated graph completion commutes with every
source-generated graph self-morphism. -/
theorem graphHilbertAmbientRealization_graphCompletionMap
    {feature : C →ₗ[ℂ] H} {functional : C →ₗ[ℂ] ℂ}
    (morphism : GraphSourceMorphism feature functional feature functional)
    (point : GraphHilbertAmbient feature functional) :
    graphHilbertAmbientRealization feature functional
        (graphCompletionMap morphism point) =
      graphTargetMap morphism
        (graphHilbertAmbientRealization feature functional point) := by
  let left : GraphHilbertAmbient feature functional →L[ℂ] GraphTarget H :=
    (graphHilbertAmbientRealization feature functional).toContinuousLinearMap.comp
      (graphCompletionMap morphism)
  let right : GraphHilbertAmbient feature functional →L[ℂ] GraphTarget H :=
    (graphTargetMap morphism).comp
      (graphHilbertAmbientRealization feature functional).toContinuousLinearMap
  have mapsEq : left = right := by
    apply ContinuousLinearMap.ext
    intro completed
    have denseEq :=
      (graphCanonicalHilbertMap_denseRange feature functional).equalizer
        left.continuous right.continuous (by
          funext source
          change graphHilbertAmbientRealization feature functional
              (graphCompletionMap morphism
                (canonicalHilbertMap
                  (graphFeature feature functional) source)) =
            graphTargetMap morphism
              (graphHilbertAmbientRealization feature functional
                (canonicalHilbertMap
                  (graphFeature feature functional) source))
          rw [graphCompletionMap_source_readback,
            graphHilbertAmbientRealization_source_readback,
            graphHilbertAmbientRealization_source_readback,
            graphTargetMap_source])
    exact congrFun denseEq completed
  exact congrArg (fun map :
    GraphHilbertAmbient feature functional →L[ℂ] GraphTarget H =>
      map point) mapsEq

/-- The second coordinate of the realized completion is the canonical
continuous functional generated by the same graph. -/
theorem graphHilbertAmbientRealization_snd
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ)
    (point : GraphHilbertAmbient feature functional) :
    (graphHilbertAmbientRealization feature functional point).snd =
      graphHilbertFunctional feature functional point := by
  let left : GraphHilbertAmbient feature functional →L[ℂ] ℂ :=
    (WithLp.sndL 2 ℂ H ℂ).comp
      (graphHilbertAmbientRealization feature functional).toContinuousLinearMap
  let right : GraphHilbertAmbient feature functional →L[ℂ] ℂ :=
    graphHilbertFunctional feature functional
  have mapsEq : left = right := by
    apply ContinuousLinearMap.ext
    intro completed
    have denseEq :=
      (graphCanonicalHilbertMap_denseRange feature functional).equalizer
        left.continuous right.continuous (by
          funext source
          change (graphHilbertAmbientRealization feature functional
              (canonicalHilbertMap
                (graphFeature feature functional) source)).snd =
            graphHilbertFunctional feature functional
              (canonicalHilbertMap
                (graphFeature feature functional) source)
          rw [graphHilbertAmbientRealization_source_readback,
            graphHilbertFunctional_source_readback]
          rfl)
    exact congrFun denseEq completed
  exact congrArg (fun map :
    GraphHilbertAmbient feature functional →L[ℂ] ℂ => map point) mapsEq

end

end SourceGeneratedFunctionalGraphPerfectification
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
