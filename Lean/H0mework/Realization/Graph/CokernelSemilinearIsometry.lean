import H0mework.Realization.Graph.CokernelSemilinearNaturality

/-!
# Isometric semilinear equivalence of functional graph cokernels

Isometric equivalences on the Hilbert and scalar coordinates, algebraic
equivalences on the source and relation coordinates, and one forward square
generate the inverse square and the antiunitary/isometric equivalence on the
closed-relation quotients.  Neither an inverse completion map nor an inverse
quotient map is caller data.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace SourceGeneratedFunctionalGraphCokernel

open SourceGeneratedFunctionalGraphPerfectification
open SourceGeneratedHilbertCokernel

noncomputable section

universe c c' r r' h h'

variable {C : Type c} [AddCommGroup C] [Module ℂ C]
variable {C' : Type c'} [AddCommGroup C'] [Module ℂ C']
variable {Rel : Type r} [AddCommGroup Rel] [Module ℂ Rel]
variable {Rel' : Type r'} [AddCommGroup Rel'] [Module ℂ Rel']
variable {H : Type h} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
variable {H' : Type h'} [NormedAddCommGroup H'] [InnerProductSpace ℂ H']
variable {σ τ : ℂ →+* ℂ}
variable [RingHomInvPair σ τ] [RingHomInvPair τ σ]

/-- A semilinear equivalence of graph-source relation systems whose two graph
target coordinates are isometric.  The backward relation and graph squares
are derived from the displayed forward squares and the four equivalences; no
norm or topology is required on the relation carrier. -/
structure SemilinearRelationGraphIsometricEquivalence
    (σ τ : ℂ →+* ℂ)
    [RingHomInvPair σ τ] [RingHomInvPair τ σ]
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ)
    (relation : Rel →ₗ[ℂ] C)
    (feature' : C' →ₗ[ℂ] H') (functional' : C' →ₗ[ℂ] ℂ)
    (relation' : Rel' →ₗ[ℂ] C') where
  sourceEquiv : C ≃ₛₗ[σ] C'
  hilbertEquiv : H ≃ₛₗᵢ[σ] H'
  scalarEquiv : ℂ ≃ₛₗᵢ[σ] ℂ
  relationEquiv : Rel ≃ₛₗ[σ] Rel'
  feature_commutes : ∀ value,
    hilbertEquiv (feature value) = feature' (sourceEquiv value)
  functional_commutes : ∀ value,
    scalarEquiv (functional value) = functional' (sourceEquiv value)
  relation_commutes : ∀ value,
    sourceEquiv (relation value) = relation' (relationEquiv value)

namespace SemilinearRelationGraphIsometricEquivalence

variable {feature : C →ₗ[ℂ] H} {functional : C →ₗ[ℂ] ℂ}
variable {relation : Rel →ₗ[ℂ] C}
variable {feature' : C' →ₗ[ℂ] H'} {functional' : C' →ₗ[ℂ] ℂ}
variable {relation' : Rel' →ₗ[ℂ] C'}

/-- Forward graph-relation morphism generated by the coordinate
equivalences. -/
def forward
    (equivalence : SemilinearRelationGraphIsometricEquivalence
      σ τ feature functional relation feature' functional' relation') :
    SemilinearRelationGraphSourceMorphism
      σ feature functional relation feature' functional' relation' where
  graphMorphism := {
    sourceMap := equivalence.sourceEquiv.toLinearMap
    hilbertMap := (equivalence.hilbertEquiv : H →SL[σ] H')
    scalarMap := (equivalence.scalarEquiv : ℂ →SL[σ] ℂ)
    feature_commutes := equivalence.feature_commutes
    functional_commutes := equivalence.functional_commutes }
  relationMap := (equivalence.relationEquiv : Rel →ₛₗ[σ] Rel')
  relation_commutes := equivalence.relation_commutes

/-- The inverse graph-relation morphism is forced by the same coordinate
equivalences and the forward squares. -/
def backward
    (equivalence : SemilinearRelationGraphIsometricEquivalence
      σ τ feature functional relation feature' functional' relation') :
    SemilinearRelationGraphSourceMorphism
      τ feature' functional' relation' feature functional relation where
  graphMorphism := {
    sourceMap := equivalence.sourceEquiv.symm.toLinearMap
    hilbertMap := (equivalence.hilbertEquiv.symm : H' →SL[τ] H)
    scalarMap := (equivalence.scalarEquiv.symm : ℂ →SL[τ] ℂ)
    feature_commutes := by
      intro value
      change equivalence.hilbertEquiv.symm (feature' value) =
        feature (equivalence.sourceEquiv.symm value)
      apply equivalence.hilbertEquiv.injective
      rw [equivalence.hilbertEquiv.apply_symm_apply,
        equivalence.feature_commutes,
        equivalence.sourceEquiv.apply_symm_apply]
    functional_commutes := by
      intro value
      change equivalence.scalarEquiv.symm (functional' value) =
        functional (equivalence.sourceEquiv.symm value)
      apply equivalence.scalarEquiv.injective
      rw [equivalence.scalarEquiv.apply_symm_apply,
        equivalence.functional_commutes,
        equivalence.sourceEquiv.apply_symm_apply] }
  relationMap := (equivalence.relationEquiv.symm : Rel' →ₛₗ[τ] Rel)
  relation_commutes := by
    intro value
    change equivalence.sourceEquiv.symm (relation' value) =
      relation (equivalence.relationEquiv.symm value)
    apply equivalence.sourceEquiv.injective
    rw [equivalence.sourceEquiv.apply_symm_apply,
      equivalence.relation_commutes,
      equivalence.relationEquiv.apply_symm_apply]

theorem forward_graphCompletionMap_isometry
    (equivalence : SemilinearRelationGraphIsometricEquivalence
      σ τ feature functional relation feature' functional' relation') :
    Isometry (semilinearGraphCompletionMap
      equivalence.forward.graphMorphism) :=
  semilinearGraphCompletionMap_isometry _
    (by simpa [forward] using equivalence.hilbertEquiv.isometry)
    (by simpa [forward] using equivalence.scalarEquiv.isometry)

theorem backward_graphCompletionMap_isometry
    (equivalence : SemilinearRelationGraphIsometricEquivalence
      σ τ feature functional relation feature' functional' relation') :
    Isometry (semilinearGraphCompletionMap
      equivalence.backward.graphMorphism) :=
  semilinearGraphCompletionMap_isometry _
    (by simpa [backward] using equivalence.hilbertEquiv.symm.isometry)
    (by simpa [backward] using equivalence.scalarEquiv.symm.isometry)

theorem graphCompletionMap_leftInverse
    (equivalence : SemilinearRelationGraphIsometricEquivalence
      σ τ feature functional relation feature' functional' relation') :
    Function.LeftInverse
      (semilinearGraphCompletionMap equivalence.backward.graphMorphism)
      (semilinearGraphCompletionMap equivalence.forward.graphMorphism) := by
  intro point
  have functions_eq :=
    (graphCanonicalHilbertMap_denseRange feature functional).equalizer
      ((semilinearGraphCompletionMap
          equivalence.backward.graphMorphism).continuous.comp
        (semilinearGraphCompletionMap
          equivalence.forward.graphMorphism).continuous)
      continuous_id (by
        funext source
        simp only [Function.comp_apply, id_eq]
        rw [semilinearGraphCompletionMap_source_readback,
          semilinearGraphCompletionMap_source_readback]
        simp [forward, backward])
  simpa using congrFun functions_eq point

theorem graphCompletionMap_rightInverse
    (equivalence : SemilinearRelationGraphIsometricEquivalence
      σ τ feature functional relation feature' functional' relation') :
    Function.RightInverse
      (semilinearGraphCompletionMap equivalence.backward.graphMorphism)
      (semilinearGraphCompletionMap equivalence.forward.graphMorphism) := by
  intro point
  have functions_eq :=
    (graphCanonicalHilbertMap_denseRange feature' functional').equalizer
      ((semilinearGraphCompletionMap
          equivalence.forward.graphMorphism).continuous.comp
        (semilinearGraphCompletionMap
          equivalence.backward.graphMorphism).continuous)
      continuous_id (by
        funext source
        simp only [Function.comp_apply, id_eq]
        rw [semilinearGraphCompletionMap_source_readback,
          semilinearGraphCompletionMap_source_readback]
        simp [forward, backward])
  simpa using congrFun functions_eq point

theorem quotientMap_leftInverse
    (equivalence : SemilinearRelationGraphIsometricEquivalence
      σ τ feature functional relation feature' functional' relation') :
    Function.LeftInverse equivalence.backward.quotientMap
      equivalence.forward.quotientMap := by
  intro quotient
  induction quotient using Submodule.Quotient.induction_on with
  | _ point =>
      change equivalence.backward.quotientMap
          (equivalence.forward.quotientMap
            (quotientClass
              (relationGraphMap feature functional relation) point)) =
        quotientClass (relationGraphMap feature functional relation) point
      rw [equivalence.forward.quotientMap_quotientClass,
        equivalence.backward.quotientMap_quotientClass,
        equivalence.graphCompletionMap_leftInverse point]

theorem quotientMap_rightInverse
    (equivalence : SemilinearRelationGraphIsometricEquivalence
      σ τ feature functional relation feature' functional' relation') :
    Function.RightInverse equivalence.backward.quotientMap
      equivalence.forward.quotientMap := by
  intro quotient
  induction quotient using Submodule.Quotient.induction_on with
  | _ point =>
      change equivalence.forward.quotientMap
          (equivalence.backward.quotientMap
            (quotientClass
              (relationGraphMap feature' functional' relation') point)) =
        quotientClass (relationGraphMap feature' functional' relation') point
      rw [equivalence.backward.quotientMap_quotientClass,
        equivalence.forward.quotientMap_quotientClass,
        equivalence.graphCompletionMap_rightInverse point]

/-- The quotient norm cannot increase under an isometric generated graph map. -/
theorem quotientMap_norm_le
    (morphism : SemilinearRelationGraphSourceMorphism
      σ feature functional relation feature' functional' relation')
    (graphIsometry : Isometry
      (semilinearGraphCompletionMap morphism.graphMorphism))
    (quotient : ClosedRangeQuotient feature functional relation) :
    ‖morphism.quotientMap quotient‖ ≤ ‖quotient‖ := by
  apply le_of_forall_pos_le_add
  intro ε hε
  obtain ⟨point, point_eq, point_norm⟩ :=
    Submodule.Quotient.norm_mk_lt quotient hε
  subst quotient
  change ‖point‖ <
    ‖quotientClass (relationGraphMap feature functional relation) point‖ + ε
    at point_norm
  change ‖morphism.quotientMap
      (quotientClass (relationGraphMap feature functional relation) point)‖ ≤
    ‖quotientClass (relationGraphMap feature functional relation) point‖ + ε
  rw [morphism.quotientMap_quotientClass]
  calc
    ‖quotientClass (relationGraphMap feature' functional' relation')
        (semilinearGraphCompletionMap morphism.graphMorphism point)‖ ≤
        ‖semilinearGraphCompletionMap morphism.graphMorphism point‖ :=
      Submodule.Quotient.norm_mk_le _ _
    _ = ‖point‖ := by
      rw [← dist_zero_right, ← dist_zero_right]
      simpa using graphIsometry.dist_eq point 0
    _ ≤ ‖quotientClass
        (relationGraphMap feature functional relation) point‖ + ε :=
      point_norm.le

/-- The semilinear equivalence generated on the closed-relation quotients. -/
def quotientLinearEquiv
    (equivalence : SemilinearRelationGraphIsometricEquivalence
      σ τ feature functional relation feature' functional' relation') :
    ClosedRangeQuotient feature functional relation ≃ₛₗ[σ]
      ClosedRangeQuotient feature' functional' relation' where
  toFun := equivalence.forward.quotientMap
  invFun := equivalence.backward.quotientMap
  left_inv := equivalence.quotientMap_leftInverse
  right_inv := equivalence.quotientMap_rightInverse
  map_add' := equivalence.forward.quotientMap.map_add
  map_smul' := equivalence.forward.quotientMap.map_smulₛₗ

/-- The generated quotient equivalence is isometric; for `σ = starRingEnd ℂ`
this is the native antiunitary quotient action. -/
def quotientIsometricEquiv
    (equivalence : SemilinearRelationGraphIsometricEquivalence
      σ τ feature functional relation feature' functional' relation') :
    ClosedRangeQuotient feature functional relation ≃ₛₗᵢ[σ]
      ClosedRangeQuotient feature' functional' relation' :=
  LinearIsometryEquiv.ofBounds equivalence.quotientLinearEquiv
    (quotientMap_norm_le equivalence.forward
      equivalence.forward_graphCompletionMap_isometry)
    (quotientMap_norm_le equivalence.backward
      equivalence.backward_graphCompletionMap_isometry)

@[simp]
theorem quotientIsometricEquiv_quotientClass
    (equivalence : SemilinearRelationGraphIsometricEquivalence
      σ τ feature functional relation feature' functional' relation')
    (point : GraphCompletion feature functional) :
    equivalence.quotientIsometricEquiv
        (quotientClass (relationGraphMap feature functional relation) point) =
      quotientClass (relationGraphMap feature' functional' relation')
        (semilinearGraphCompletionMap
          equivalence.forward.graphMorphism point) := by
  exact equivalence.forward.quotientMap_quotientClass point

@[simp]
theorem quotientIsometricEquiv_source_readback
    (equivalence : SemilinearRelationGraphIsometricEquivalence
      σ τ feature functional relation feature' functional' relation')
    (value : C) :
    equivalence.quotientIsometricEquiv
        (canonicalSourceMap feature functional relation value) =
      canonicalSourceMap feature' functional' relation'
        (equivalence.sourceEquiv value) := by
  change equivalence.forward.quotientMap
      (canonicalSourceMap feature functional relation value) = _
  exact equivalence.forward.quotientMap_source_readback value

end SemilinearRelationGraphIsometricEquivalence

end

