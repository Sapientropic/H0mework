import Mathlib.Topology.Algebra.Module.ContinuousLinearMap.Quotient
import H0mework.Realization.Graph.Completion
import H0mework.Realization.Topology.HilbertCokernel

/-!
# Functional graph cokernel

An algebraic complex source functional and feature generate their Hilbert graph completion.
An actual relation family is then killed by quotienting by the closure of its graph range.
When the functional kills the relation family, its canonical continuous graph coordinate descends
uniquely to that quotient. No finiteness, projectivity, nondegeneracy, closed-range, or determinant
premise is used.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace SourceGeneratedFunctionalGraphCokernel

open SourceGeneratedFunctionalGraphPerfectification
open SourceGeneratedHilbertCokernel

noncomputable section

universe c r h

variable {C : Type c} [AddCommGroup C] [Module ℂ C]
variable {Rel : Type r} [AddCommGroup Rel] [Module ℂ Rel]
variable {H : Type h} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- The complete Hilbert space generated by the source feature-functional graph. -/
abbrev GraphCompletion
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ) :=
  GraphHilbertAmbient feature functional

/-- The canonical dense source map into its graph completion. -/
def graphSourceMap
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ) :
    C →ₗ[ℂ] GraphCompletion feature functional :=
  SourceGeneratedComplexFeaturePerfectification.canonicalHilbertMap
    (graphFeature feature functional)

theorem graphSourceMap_denseRange
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ) :
    DenseRange (graphSourceMap feature functional) :=
  graphCanonicalHilbertMap_denseRange feature functional

/-- The actual relations mapped into the same graph completion. -/
def relationGraphMap
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ)
    (relation : Rel →ₗ[ℂ] C) :
    Rel →ₗ[ℂ] GraphCompletion feature functional :=
  (graphSourceMap feature functional).comp relation

/-- The quotient of the graph completion by the source-generated closed relation range. -/
abbrev ClosedRangeQuotient
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ)
    (relation : Rel →ₗ[ℂ] C) :=
  Cokernel (relationGraphMap feature functional relation)

/-- The canonical source class in the closed-range quotient. -/
def canonicalSourceMap
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ)
    (relation : Rel →ₗ[ℂ] C) :
    C →ₗ[ℂ] ClosedRangeQuotient feature functional relation :=
  (quotientClass (relationGraphMap feature functional relation)).toLinearMap.comp
    (graphSourceMap feature functional)

/-- Every actual relation has zero quotient class. -/
@[simp]
theorem canonicalSourceMap_relation
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ)
    (relation : Rel →ₗ[ℂ] C) (value : Rel) :
    canonicalSourceMap feature functional relation (relation value) = 0 := by
  change quotientClass (relationGraphMap feature functional relation)
      (relationGraphMap feature functional relation value) = 0
  exact quotientClass_source _ value

/-- The completed graph functional kills every mapped relation. -/
theorem graphHilbertFunctional_relation
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ)
    (relation : Rel →ₗ[ℂ] C)
    (annihilates : functional.comp relation = 0) (value : Rel) :
    graphHilbertFunctional feature functional
        (relationGraphMap feature functional relation value) = 0 := by
  change graphHilbertFunctional feature functional
      (SourceGeneratedComplexFeaturePerfectification.canonicalHilbertMap
        (graphFeature feature functional) (relation value)) = 0
  rw [graphHilbertFunctional_source_readback]
  simpa using LinearMap.congr_fun annihilates value

/-- Continuity upgrades relation annihilation from the range to its closure. -/
theorem relationClosedRange_le_functional_ker
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ)
    (relation : Rel →ₗ[ℂ] C)
    (annihilates : functional.comp relation = 0) :
    (closedRange (relationGraphMap feature functional relation)).toSubmodule ≤
      (graphHilbertFunctional feature functional).ker := by
  let T := relationGraphMap feature functional relation
  change (LinearMap.range T).topologicalClosure ≤
    (graphHilbertFunctional feature functional).ker
  apply (LinearMap.range T).topologicalClosure_minimal
  · rintro _ ⟨value, rfl⟩
    exact graphHilbertFunctional_relation feature functional relation annihilates value
  · exact ContinuousLinearMap.isClosed_ker _

/-- The source functional descended continuously through the closed-range quotient. -/
def descendedFunctional
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ)
    (relation : Rel →ₗ[ℂ] C)
    (annihilates : functional.comp relation = 0) :
    ClosedRangeQuotient feature functional relation →L[ℂ] ℂ :=
  (closedRange (relationGraphMap feature functional relation)).toSubmodule.liftQL
    (graphHilbertFunctional feature functional)
    (relationClosedRange_le_functional_ker feature functional relation annihilates)

/-- The descended functional reads the original source functional exactly. -/
@[simp]
theorem descendedFunctional_source_readback
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ)
    (relation : Rel →ₗ[ℂ] C)
    (annihilates : functional.comp relation = 0) (value : C) :
    descendedFunctional feature functional relation annihilates
        (canonicalSourceMap feature functional relation value) = functional value := by
  change (closedRange (relationGraphMap feature functional relation)).toSubmodule.liftQL
      (graphHilbertFunctional feature functional)
      (relationClosedRange_le_functional_ker feature functional relation annihilates)
      (quotientClass (relationGraphMap feature functional relation)
        (graphSourceMap feature functional value)) = functional value
  rw [Submodule.liftQL_apply]
  change (closedRange (relationGraphMap feature functional relation)).toSubmodule.liftQ
      (graphHilbertFunctional feature functional).toLinearMap
      (relationClosedRange_le_functional_ker feature functional relation annihilates)
      (Submodule.Quotient.mk (graphSourceMap feature functional value)) = functional value
  rw [Submodule.liftQ_apply]
  exact graphHilbertFunctional_source_readback feature functional value

@[simp]
theorem descendedFunctional_comp_source
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ)
    (relation : Rel →ₗ[ℂ] C)
    (annihilates : functional.comp relation = 0) :
    (descendedFunctional feature functional relation annihilates).toLinearMap.comp
        (canonicalSourceMap feature functional relation) = functional := by
  ext value
  exact descendedFunctional_source_readback
    feature functional relation annihilates value

/-- A nonzero source functional remains nonzero after descent. -/
theorem descendedFunctional_ne_zero
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ)
    (relation : Rel →ₗ[ℂ] C)
    (annihilates : functional.comp relation = 0)
    (nonzero : functional ≠ 0) :
    descendedFunctional feature functional relation annihilates ≠ 0 := by
  intro descendedZero
  apply nonzero
  calc
    functional = (descendedFunctional feature functional relation annihilates).toLinearMap.comp
        (canonicalSourceMap feature functional relation) :=
      (descendedFunctional_comp_source feature functional relation annihilates).symm
    _ = 0 := by rw [descendedZero]; simp

/-- Quotienting the dense graph source by the closed relation range preserves density. -/
theorem canonicalSourceMap_denseRange
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ)
    (relation : Rel →ₗ[ℂ] C) :
    DenseRange (canonicalSourceMap feature functional relation) := by
  let T := relationGraphMap feature functional relation
  have quotientSurjective : Function.Surjective (quotientClass T) := by
    intro quotient
    induction quotient using Submodule.Quotient.induction_on with
    | _ value => exact ⟨value, rfl⟩
  have dense := quotientSurjective.denseRange.comp
    (graphSourceMap_denseRange feature functional)
    (quotientClass T).continuous
  simpa [canonicalSourceMap, T, Function.comp_def] using dense

/-- Dense source readback uniquely determines the continuous quotient functional. -/
theorem descendedFunctional_unique
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ)
    (relation : Rel →ₗ[ℂ] C)
    (annihilates : functional.comp relation = 0)
    (other : ClosedRangeQuotient feature functional relation →L[ℂ] ℂ)
    (readback : other.toLinearMap.comp
      (canonicalSourceMap feature functional relation) = functional) :
    other = descendedFunctional feature functional relation annihilates := by
  apply ContinuousLinearMap.ext
  intro point
  have functionsEqual :=
    (canonicalSourceMap_denseRange feature functional relation).equalizer
      other.continuous
      (descendedFunctional feature functional relation annihilates).continuous (by
        funext source
        have otherReadback := LinearMap.congr_fun readback source
        change other (canonicalSourceMap feature functional relation source) =
          functional source at otherReadback
        exact otherReadback.trans
          (descendedFunctional_source_readback
            feature functional relation annihilates source).symm)
  simpa using congrFun functionsEqual point

/-- Existence and uniqueness of continuous functional descent from source readback alone. -/
theorem descendedFunctional_universal
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ)
    (relation : Rel →ₗ[ℂ] C)
    (annihilates : functional.comp relation = 0) :
    ∃! extension : ClosedRangeQuotient feature functional relation →L[ℂ] ℂ,
      extension.toLinearMap.comp
        (canonicalSourceMap feature functional relation) = functional := by
  refine ⟨descendedFunctional feature functional relation annihilates,
    descendedFunctional_comp_source feature functional relation annihilates, ?_⟩
  intro other readback
  exact descendedFunctional_unique
    feature functional relation annihilates other readback

end

end SourceGeneratedFunctionalGraphCokernel
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
