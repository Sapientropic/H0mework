import Mathlib.Topology.Algebra.LinearMapCompletion
import Mathlib.Topology.Algebra.Module.Star
import H0mework.Realization.Graph.Naturality

/-!
# Semilinear naturality of source-generated functional graphs

A semilinear source map, continuous semilinear maps on the Hilbert and scalar
coordinates, and their two source squares generate a semilinear map on the
actual graph range and hence on its canonical completion.  The completion map
is generated by `ContinuousLinearMap.completion`; it is not supplied by a
caller.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace SourceGeneratedFunctionalGraphPerfectification

open SourceGeneratedComplexFeaturePerfectification

noncomputable section

universe c c' h h'

variable {C : Type c} [AddCommGroup C] [Module ℂ C]
variable {C' : Type c'} [AddCommGroup C'] [Module ℂ C']
variable {H : Type h} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
variable {H' : Type h'} [NormedAddCommGroup H'] [InnerProductSpace ℂ H']
variable {σ : ℂ →+* ℂ}

/-- Same-source semilinear morphism of two feature/functional pairs.  Both
coordinates use the same scalar action `σ`; no map on completions is input. -/
structure SemilinearGraphSourceMorphism
    (σ : ℂ →+* ℂ)
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ)
    (feature' : C' →ₗ[ℂ] H') (functional' : C' →ₗ[ℂ] ℂ) where
  sourceMap : C →ₛₗ[σ] C'
  hilbertMap : H →SL[σ] H'
  scalarMap : ℂ →SL[σ] ℂ
  feature_commutes : ∀ value,
    hilbertMap (feature value) = feature' (sourceMap value)
  functional_commutes : ∀ value,
    scalarMap (functional value) = functional' (sourceMap value)

/-- Coordinatewise semilinear map on the `L²` graph targets. -/
def semilinearGraphTargetMap
    {feature : C →ₗ[ℂ] H} {functional : C →ₗ[ℂ] ℂ}
    {feature' : C' →ₗ[ℂ] H'} {functional' : C' →ₗ[ℂ] ℂ}
    (morphism : SemilinearGraphSourceMorphism
      σ feature functional feature' functional') :
    GraphTarget H →SL[σ] GraphTarget H' where
  toFun value :=
    (WithLp.linearEquiv 2 ℂ (H' × ℂ)).symm
      (morphism.hilbertMap value.fst, morphism.scalarMap value.snd)
  map_add' left right := by
    apply (WithLp.linearEquiv 2 ℂ (H' × ℂ)).injective
    apply Prod.ext <;> simp
  map_smul' scalar value := by
    apply (WithLp.linearEquiv 2 ℂ (H' × ℂ)).injective
    apply Prod.ext
    · exact map_smulₛₗ morphism.hilbertMap scalar value.fst
    · simpa [smul_eq_mul] using
        map_smulₛₗ morphism.scalarMap scalar value.snd
  cont := by
    exact (WithLp.prodContinuousLinearEquiv 2 ℂ H' ℂ).symm.continuous.comp
      ((morphism.hilbertMap.continuous.comp
          (WithLp.fstL 2 ℂ H ℂ).continuous).prodMk
        (morphism.scalarMap.continuous.comp
          (WithLp.sndL 2 ℂ H ℂ).continuous))

@[simp]
theorem semilinearGraphTargetMap_fst
    {feature : C →ₗ[ℂ] H} {functional : C →ₗ[ℂ] ℂ}
    {feature' : C' →ₗ[ℂ] H'} {functional' : C' →ₗ[ℂ] ℂ}
    (morphism : SemilinearGraphSourceMorphism
      σ feature functional feature' functional')
    (value : GraphTarget H) :
    (semilinearGraphTargetMap morphism value).fst =
      morphism.hilbertMap value.fst :=
  rfl

@[simp]
theorem semilinearGraphTargetMap_snd
    {feature : C →ₗ[ℂ] H} {functional : C →ₗ[ℂ] ℂ}
    {feature' : C' →ₗ[ℂ] H'} {functional' : C' →ₗ[ℂ] ℂ}
    (morphism : SemilinearGraphSourceMorphism
      σ feature functional feature' functional')
    (value : GraphTarget H) :
    (semilinearGraphTargetMap morphism value).snd =
      morphism.scalarMap value.snd :=
  rfl

/-- Isometric coordinate maps generate an isometry of graph targets. -/
theorem semilinearGraphTargetMap_isometry
    {feature : C →ₗ[ℂ] H} {functional : C →ₗ[ℂ] ℂ}
    {feature' : C' →ₗ[ℂ] H'} {functional' : C' →ₗ[ℂ] ℂ}
    (morphism : SemilinearGraphSourceMorphism
      σ feature functional feature' functional')
    (hilbert_isometry : Isometry morphism.hilbertMap)
    (scalar_isometry : Isometry morphism.scalarMap) :
    Isometry (semilinearGraphTargetMap morphism) := by
  have map_eq :
      (fun value : GraphTarget H => semilinearGraphTargetMap morphism value) =
        WithLp.map 2
          (Prod.map morphism.hilbertMap morphism.scalarMap) := by
    funext value
    rfl
  change Isometry
    (fun value : GraphTarget H => semilinearGraphTargetMap morphism value)
  rw [map_eq]
  exact hilbert_isometry.withLpProdMap 2 scalar_isometry

theorem semilinearGraphTargetMap_source
    {feature : C →ₗ[ℂ] H} {functional : C →ₗ[ℂ] ℂ}
    {feature' : C' →ₗ[ℂ] H'} {functional' : C' →ₗ[ℂ] ℂ}
    (morphism : SemilinearGraphSourceMorphism
      σ feature functional feature' functional')
    (value : C) :
    semilinearGraphTargetMap morphism
        (graphFeature feature functional value) =
      graphFeature feature' functional' (morphism.sourceMap value) := by
  apply (WithLp.linearEquiv 2 ℂ (H' × ℂ)).injective
  apply Prod.ext
  · exact morphism.feature_commutes value
  · exact morphism.functional_commutes value

theorem semilinearGraphTargetMap_maps_range
    {feature : C →ₗ[ℂ] H} {functional : C →ₗ[ℂ] ℂ}
    {feature' : C' →ₗ[ℂ] H'} {functional' : C' →ₗ[ℂ] ℂ}
    (morphism : SemilinearGraphSourceMorphism
      σ feature functional feature' functional')
    (value : LinearMap.range (graphFeature feature functional)) :
    semilinearGraphTargetMap morphism value.1 ∈
      LinearMap.range (graphFeature feature' functional') := by
  obtain ⟨source, source_eq⟩ := value.2
  refine ⟨morphism.sourceMap source, ?_⟩
  rw [← semilinearGraphTargetMap_source morphism source, source_eq]

/-- Induced semilinear map on the actual graph ranges. -/
def semilinearGraphRangeMap
    {feature : C →ₗ[ℂ] H} {functional : C →ₗ[ℂ] ℂ}
    {feature' : C' →ₗ[ℂ] H'} {functional' : C' →ₗ[ℂ] ℂ}
    (morphism : SemilinearGraphSourceMorphism
      σ feature functional feature' functional') :
    LinearMap.range (graphFeature feature functional) →SL[σ]
      LinearMap.range (graphFeature feature' functional') :=
  ((semilinearGraphTargetMap morphism).domRestrict
      (LinearMap.range (graphFeature feature functional))).codRestrict
    (LinearMap.range (graphFeature feature' functional'))
    (semilinearGraphTargetMap_maps_range morphism)

@[simp]
theorem semilinearGraphRangeMap_apply
    {feature : C →ₗ[ℂ] H} {functional : C →ₗ[ℂ] ℂ}
    {feature' : C' →ₗ[ℂ] H'} {functional' : C' →ₗ[ℂ] ℂ}
    (morphism : SemilinearGraphSourceMorphism
      σ feature functional feature' functional')
    (value : LinearMap.range (graphFeature feature functional)) :
    ((semilinearGraphRangeMap morphism value :
      LinearMap.range (graphFeature feature' functional')) : GraphTarget H') =
        semilinearGraphTargetMap morphism value.1 :=
  rfl

/-- Isometry passes from the coordinate map to the actual graph ranges. -/
theorem semilinearGraphRangeMap_isometry
    {feature : C →ₗ[ℂ] H} {functional : C →ₗ[ℂ] ℂ}
    {feature' : C' →ₗ[ℂ] H'} {functional' : C' →ₗ[ℂ] ℂ}
    (morphism : SemilinearGraphSourceMorphism
      σ feature functional feature' functional')
    (hilbert_isometry : Isometry morphism.hilbertMap)
    (scalar_isometry : Isometry morphism.scalarMap) :
    Isometry (semilinearGraphRangeMap morphism) := by
  intro left right
  change edist (semilinearGraphTargetMap morphism left.1)
      (semilinearGraphTargetMap morphism right.1) = edist left.1 right.1
  exact (semilinearGraphTargetMap_isometry morphism
    hilbert_isometry scalar_isometry).edist_eq left.1 right.1

/-- Canonical semilinear map between the source-generated graph completions. -/
def semilinearGraphCompletionMap
    {feature : C →ₗ[ℂ] H} {functional : C →ₗ[ℂ] ℂ}
    {feature' : C' →ₗ[ℂ] H'} {functional' : C' →ₗ[ℂ] ℂ}
    (morphism : SemilinearGraphSourceMorphism
      σ feature functional feature' functional') :
    GraphHilbertAmbient feature functional →SL[σ]
      GraphHilbertAmbient feature' functional' :=
  (semilinearGraphRangeMap morphism).completion

/-- Completion preserves the isometry generated by isometric coordinates. -/
theorem semilinearGraphCompletionMap_isometry
    {feature : C →ₗ[ℂ] H} {functional : C →ₗ[ℂ] ℂ}
    {feature' : C' →ₗ[ℂ] H'} {functional' : C' →ₗ[ℂ] ℂ}
    (morphism : SemilinearGraphSourceMorphism
      σ feature functional feature' functional')
    (hilbert_isometry : Isometry morphism.hilbertMap)
    (scalar_isometry : Isometry morphism.scalarMap) :
    Isometry (semilinearGraphCompletionMap morphism) := by
  exact (semilinearGraphRangeMap_isometry morphism
    hilbert_isometry scalar_isometry).completion_map

@[simp]
theorem semilinearGraphCompletionMap_range_readback
    {feature : C →ₗ[ℂ] H} {functional : C →ₗ[ℂ] ℂ}
    {feature' : C' →ₗ[ℂ] H'} {functional' : C' →ₗ[ℂ] ℂ}
    (morphism : SemilinearGraphSourceMorphism
      σ feature functional feature' functional')
    (value : LinearMap.range (graphFeature feature functional)) :
    semilinearGraphCompletionMap morphism
        (graphRangeEmbedding feature functional value) =
      graphRangeEmbedding feature' functional'
        (semilinearGraphRangeMap morphism value) := by
  exact ContinuousLinearMap.completion_apply_coe
    (semilinearGraphRangeMap morphism) value

@[simp]
theorem semilinearGraphCompletionMap_source_readback
    {feature : C →ₗ[ℂ] H} {functional : C →ₗ[ℂ] ℂ}
    {feature' : C' →ₗ[ℂ] H'} {functional' : C' →ₗ[ℂ] ℂ}
    (morphism : SemilinearGraphSourceMorphism
      σ feature functional feature' functional')
    (value : C) :
    semilinearGraphCompletionMap morphism
        (canonicalHilbertMap (graphFeature feature functional) value) =
      canonicalHilbertMap (graphFeature feature' functional')
        (morphism.sourceMap value) := by
  change semilinearGraphCompletionMap morphism
      (graphRangeEmbedding feature functional
        ((graphFeature feature functional).rangeRestrict value)) = _
  rw [semilinearGraphCompletionMap_range_readback]
  change graphRangeEmbedding feature' functional'
      (semilinearGraphRangeMap morphism
        ((graphFeature feature functional).rangeRestrict value)) =
    graphRangeEmbedding feature' functional'
      ((graphFeature feature' functional').rangeRestrict
        (morphism.sourceMap value))
  congr 1
  apply Subtype.ext
  exact semilinearGraphTargetMap_source morphism value

/-- The completed functional square.  It is forced by the source square and
density; no functional on the completion is input. -/
theorem graphHilbertFunctional_semilinear_naturality
    {feature : C →ₗ[ℂ] H} {functional : C →ₗ[ℂ] ℂ}
    {feature' : C' →ₗ[ℂ] H'} {functional' : C' →ₗ[ℂ] ℂ}
    (morphism : SemilinearGraphSourceMorphism
      σ feature functional feature' functional')
    (value : GraphHilbertAmbient feature functional) :
    graphHilbertFunctional feature' functional'
        (semilinearGraphCompletionMap morphism value) =
      morphism.scalarMap
        (graphHilbertFunctional feature functional value) := by
  have functions_eq :=
    (graphCanonicalHilbertMap_denseRange feature functional).equalizer
      ((graphHilbertFunctional feature' functional').continuous.comp
        (semilinearGraphCompletionMap morphism).continuous)
      (morphism.scalarMap.continuous.comp
        (graphHilbertFunctional feature functional).continuous) (by
          funext source
          change graphHilbertFunctional feature' functional'
              (semilinearGraphCompletionMap morphism
                (canonicalHilbertMap
                  (graphFeature feature functional) source)) =
            morphism.scalarMap
              (graphHilbertFunctional feature functional
                (canonicalHilbertMap
                  (graphFeature feature functional) source))
          rw [semilinearGraphCompletionMap_source_readback,
            graphHilbertFunctional_source_readback,
            graphHilbertFunctional_source_readback]
          exact (morphism.functional_commutes source).symm)
  simpa using congrFun functions_eq value

end

end SourceGeneratedFunctionalGraphPerfectification
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
