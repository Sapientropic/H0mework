import Mathlib.Analysis.Normed.Operator.Extend
import H0mework.Realization.Graph.Feature
import H0mework.Realization.Topology.DualExtension

/-!
# Completion of a source-generated functional graph

The second graph coordinate is bounded on the graph range.  Its unique
extension along the dense completion embedding gives a canonical continuous
functional on the generated Hilbert ambient and reads back the original
source functional exactly.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace SourceGeneratedFunctionalGraphPerfectification

open SourceGeneratedComplexFeaturePerfectification
open SourceGeneratedTestHilbertGeneralizedDual

noncomputable section

universe c h

variable {C : Type c} [AddCommGroup C] [Module ℂ C]
variable {H : Type h} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- The complete Hilbert ambient generated by the actual graph range. -/
abbrev GraphHilbertAmbient
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ) :=
  HilbertAmbient (graphFeature feature functional)

/-- The second coordinate restricted to the actual graph range. -/
def graphRangeFunctional
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ) :
    LinearMap.range (graphFeature feature functional) →L[ℂ] ℂ :=
  (WithLp.sndL 2 ℂ H ℂ).comp
    (LinearMap.range (graphFeature feature functional)).subtypeL

@[simp]
theorem graphRangeFunctional_apply
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ)
    (value : LinearMap.range (graphFeature feature functional)) :
    graphRangeFunctional feature functional value = value.1.snd :=
  rfl

/-- The isometric dense inclusion of the graph range into its completion. -/
def graphRangeEmbedding
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ) :
    LinearMap.range (graphFeature feature functional) →L[ℂ]
      GraphHilbertAmbient feature functional :=
  (UniformSpace.Completion.toComplₗᵢ :
    LinearMap.range (graphFeature feature functional) →ₗᵢ[ℂ]
      GraphHilbertAmbient feature functional).toContinuousLinearMap

theorem graphRangeEmbedding_denseRange
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ) :
    DenseRange (graphRangeEmbedding feature functional) :=
  UniformSpace.Completion.denseRange_coe

theorem graphRangeEmbedding_isUniformInducing
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ) :
    IsUniformInducing (graphRangeEmbedding feature functional) :=
  (UniformSpace.Completion.toComplₗᵢ :
    LinearMap.range (graphFeature feature functional) →ₗᵢ[ℂ]
      GraphHilbertAmbient feature functional).isometry.isUniformInducing

/-- Canonical continuous coordinate generated by the source graph. -/
def graphHilbertFunctional
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ) :
    GraphHilbertAmbient feature functional →L[ℂ] ℂ :=
  (graphRangeFunctional feature functional).extend
    (graphRangeEmbedding feature functional)

@[simp]
theorem graphHilbertFunctional_range_readback
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ)
    (value : LinearMap.range (graphFeature feature functional)) :
    graphHilbertFunctional feature functional
        (graphRangeEmbedding feature functional value) = value.1.snd := by
  rw [graphHilbertFunctional, ContinuousLinearMap.extend_eq
    (graphRangeFunctional feature functional)
    (graphRangeEmbedding_denseRange feature functional)
    (graphRangeEmbedding_isUniformInducing feature functional)]
  rfl

@[simp]
theorem graphHilbertFunctional_source_readback
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ) (value : C) :
    graphHilbertFunctional feature functional
        (canonicalHilbertMap (graphFeature feature functional) value) =
      functional value := by
  change graphHilbertFunctional feature functional
      (graphRangeEmbedding feature functional
        ((graphFeature feature functional).rangeRestrict value)) =
    functional value
  rw [graphHilbertFunctional_range_readback]
  rfl

@[simp]
theorem graphHilbertFunctional_comp_source
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ) :
    (graphHilbertFunctional feature functional).toLinearMap.comp
        (canonicalHilbertMap (graphFeature feature functional)) = functional := by
  ext value
  exact graphHilbertFunctional_source_readback feature functional value

/-- The source graph has dense range in its generated completion. -/
theorem graphCanonicalHilbertMap_denseRange
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ) :
    DenseRange (canonicalHilbertMap
      (graphFeature feature functional)) := by
  have dense := UniformSpace.Completion.denseRange_coe.comp
    (graphFeature feature functional).surjective_rangeRestrict.denseRange
    (UniformSpace.Completion.continuous_coe
      (LinearMap.range (graphFeature feature functional)))
  simpa [canonicalHilbertMap, Function.comp_def] using dense

/-- No representative is chosen: continuous source readback determines the
graph coordinate uniquely on the entire completion. -/
theorem graphHilbertFunctional_unique
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ)
    (other : GraphHilbertAmbient feature functional →L[ℂ] ℂ)
    (readback : other.toLinearMap.comp
      (canonicalHilbertMap (graphFeature feature functional)) = functional) :
    other = graphHilbertFunctional feature functional := by
  apply ContinuousLinearMap.ext
  intro point
  have functionsEqual :=
    (graphCanonicalHilbertMap_denseRange feature functional).equalizer
      other.continuous
      (graphHilbertFunctional feature functional).continuous (by
        funext source
        have otherReadback := LinearMap.congr_fun readback source
        change other (canonicalHilbertMap
          (graphFeature feature functional) source) = functional source at otherReadback
        exact otherReadback.trans
          (graphHilbertFunctional_source_readback
            feature functional source).symm)
  simpa using congrFun functionsEqual point

/-- Existence and uniqueness of the continuous graph coordinate, stated
without an extension witness in the input. -/
theorem graphHilbertFunctional_universal
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ) :
    ∃! extension : GraphHilbertAmbient feature functional →L[ℂ] ℂ,
      extension.toLinearMap.comp
        (canonicalHilbertMap (graphFeature feature functional)) = functional := by
  refine ⟨graphHilbertFunctional feature functional,
    graphHilbertFunctional_comp_source feature functional, ?_⟩
  intro other readback
  exact graphHilbertFunctional_unique feature functional other readback

/-- The canonical graph coordinate is a direct positive consumer of the
existing generalized-dual extension classifier. -/
def graphBoundedExtension
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ) :
    BoundedExtension
      (canonicalHilbertMap (graphFeature feature functional)) functional where
  extension := graphHilbertFunctional feature functional
  restricts := graphHilbertFunctional_comp_source feature functional

theorem graphExtensionResidual_zero
    (feature : C →ₗ[ℂ] H) (functional : C →ₗ[ℂ] ℂ) :
    canonicalExtensionResidual
        (canonicalHilbertMap (graphFeature feature functional)) functional = 0 :=
  (canonicalExtensionResidual_eq_zero_iff_nonempty
    (canonicalHilbertMap (graphFeature feature functional)) functional).mpr
      ⟨graphBoundedExtension feature functional⟩

end

end SourceGeneratedFunctionalGraphPerfectification
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
