import H0mework.Realization.Perfectification.SourceCoimage

/-!
# Canonical source-generated perfect pair

For an actual source evaluation `e : C →ₗ[ℤ] Dual(D)`, the coimage
`P := C / ker(e)` is already the lossless source carrier.  The old
`PerfectificationDisposition` asks whether the induced map `P → Dual(D)` is
onto the *whole* algebraic dual.  That is a useful bounded-language readout,
but it is not the universal producer.

This file moves the generated duality one level earlier.  The target
`GeneratedDual(e)` is the actual range of `P → Dual(D)`, and the induced map
`P → GeneratedDual(e)` is canonically bijective, with no finite, projective,
nondegenerate, compactness, or determinant premise.  Thus every source
occurrence gets a canonical source-generated dual image and a perfect
equivalence *onto that generated image*.  We never identify this image with
the full algebraic dual for free.

The quotient universal property, source-map transport, and the dual-image
commuting square are inherited from the same `C / ker(e)` occurrence.  A
finite observation may still be lossy; it is classified by the existing
finite-language disposition and leaves its explicit representation residual.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace SourceGeneratedCanonicalPerfectPair

open SourceGeneratedPerfectification

noncomputable section

universe c d a b

variable {C : Type c} {D : Type d}
variable [AddCommGroup C] [AddCommGroup D]
variable (evaluation : C →ₗ[ℤ] Module.Dual ℤ D)

/-! ## The generated dual image -/

abbrev Carrier :=
  SourceGeneratedPerfectification.PerfectificationCarrier evaluation

abbrev GeneratedDual :=
  LinearMap.range (SourceGeneratedPerfectification.dualEmbedding evaluation)

/-- Inclusion of the source-generated dual image into the ambient algebraic
dual.  The image is kept as a subtype so no surjectivity onto the ambient
dual is silently assumed. -/
def dualInclusion : GeneratedDual evaluation →ₗ[ℤ] Module.Dual ℤ D :=
  (GeneratedDual evaluation).subtype

/-- The canonical source-generated duality map. -/
def generatedDualMap : Carrier evaluation →ₗ[ℤ] GeneratedDual evaluation :=
  (SourceGeneratedPerfectification.dualEmbedding evaluation).codRestrict
    (GeneratedDual evaluation) (by
      intro value
      exact ⟨value, rfl⟩)

@[simp] theorem dualInclusion_apply (value : GeneratedDual evaluation) :
    dualInclusion evaluation value = value.1 :=
  rfl

@[simp] theorem generatedDualMap_apply (value : Carrier evaluation) :
    (generatedDualMap evaluation value).1 =
      SourceGeneratedPerfectification.dualEmbedding evaluation value :=
  rfl

theorem generatedDualMap_injective :
    Function.Injective (generatedDualMap evaluation) := by
  intro left right equality
  apply SourceGeneratedPerfectification.dualEmbedding_injective evaluation
  exact congrArg Subtype.val equality

theorem generatedDualMap_surjective :
    Function.Surjective (generatedDualMap evaluation) := by
  intro target
  rcases target.property with ⟨value, equality⟩
  refine ⟨value, ?_⟩
  apply Subtype.ext
  exact equality

theorem generatedDualMap_bijective :
    Function.Bijective (generatedDualMap evaluation) :=
  ⟨generatedDualMap_injective evaluation, generatedDualMap_surjective evaluation⟩

/-- The unconditional perfectification equivalence is between the coimage and
the dual image generated by that same coimage. -/
noncomputable def perfectEquiv :
    Carrier evaluation ≃ₗ[ℤ] GeneratedDual evaluation :=
  LinearEquiv.ofBijective (generatedDualMap evaluation)
    (generatedDualMap_bijective evaluation)

/-- The source-generated coevaluation is the inverse of the generated
evaluation.  It is not supplied by a caller. -/
def coevaluation : GeneratedDual evaluation →ₗ[ℤ] Carrier evaluation :=
  (perfectEquiv evaluation).symm.toLinearMap

@[simp] theorem perfectEquiv_toLinearMap :
    (perfectEquiv evaluation).toLinearMap = generatedDualMap evaluation :=
  rfl

theorem dualInclusion_comp_generatedDualMap :
    (dualInclusion evaluation).comp (generatedDualMap evaluation) =
      SourceGeneratedPerfectification.dualEmbedding evaluation := by
  rfl

@[simp] theorem coevaluation_comp_generatedDualMap :
    (coevaluation evaluation).comp (generatedDualMap evaluation) =
      LinearMap.id := by
  apply LinearMap.ext
  intro value
  exact (perfectEquiv evaluation).symm_apply_apply value

@[simp] theorem generatedDualMap_comp_coevaluation :
    (generatedDualMap evaluation).comp (coevaluation evaluation) =
      LinearMap.id := by
  apply LinearMap.ext
  intro value
  exact (perfectEquiv evaluation).apply_symm_apply value

theorem source_evaluation_readback :
    ((dualInclusion evaluation).comp (generatedDualMap evaluation)).comp
        (SourceGeneratedPerfectification.canonicalMap evaluation) = evaluation := by
  apply LinearMap.ext
  intro value
  rfl

/-! ## A generated package, with the quotient universal property retained -/

structure Generated : Type (max c d + 2) where
  private mk ::
  map : Carrier evaluation →ₗ[ℤ] GeneratedDual evaluation
  inclusion : GeneratedDual evaluation →ₗ[ℤ] Module.Dual ℤ D
  equivalence : Carrier evaluation ≃ₗ[ℤ] GeneratedDual evaluation
  coevaluation : GeneratedDual evaluation →ₗ[ℤ] Carrier evaluation
  map_bijective : Function.Bijective map
  inclusion_map : inclusion.comp map =
    SourceGeneratedPerfectification.dualEmbedding evaluation
  left_zigzag : coevaluation.comp map = LinearMap.id
  right_zigzag : map.comp coevaluation = LinearMap.id

def generate : Generated evaluation where
  map := generatedDualMap evaluation
  inclusion := dualInclusion evaluation
  equivalence := perfectEquiv evaluation
  coevaluation := coevaluation evaluation
  map_bijective := generatedDualMap_bijective evaluation
  inclusion_map := dualInclusion_comp_generatedDualMap evaluation
  left_zigzag := coevaluation_comp_generatedDualMap evaluation
  right_zigzag := generatedDualMap_comp_coevaluation evaluation

/-- Public `P∞` name: an exact perfect envelope enriches `P₀` with its
source-generated dual object and both zig-zag maps.  It does not assert that
the generated dual image equals the whole algebraic dual. -/
abbrev UniversalPerfectEnvelope := Generated evaluation

def sourceGeneratedPerfectification : UniversalPerfectEnvelope evaluation :=
  generate evaluation

theorem generated_total : Nonempty (Generated evaluation) :=
  ⟨generate evaluation⟩

theorem universalPerfectEnvelope_total :
    Nonempty (UniversalPerfectEnvelope evaluation) :=
  ⟨sourceGeneratedPerfectification evaluation⟩

@[simp] theorem generated_map :
    (generate evaluation).map = generatedDualMap evaluation :=
  rfl

@[simp] theorem generated_inclusion :
    (generate evaluation).inclusion = dualInclusion evaluation :=
  rfl

@[simp] theorem generated_equivalence :
    (generate evaluation).equivalence = perfectEquiv evaluation :=
  rfl

theorem generated_readback :
    (generate evaluation).inclusion.comp (generate evaluation).map =
      SourceGeneratedPerfectification.dualEmbedding evaluation :=
  (generate evaluation).inclusion_map

theorem generated_left_zigzag :
    (generate evaluation).coevaluation.comp (generate evaluation).map =
      LinearMap.id :=
  (generate evaluation).left_zigzag

theorem generated_right_zigzag :
    (generate evaluation).map.comp (generate evaluation).coevaluation =
      LinearMap.id :=
  (generate evaluation).right_zigzag

theorem quotient_universal
    {Q : Type a} [AddCommGroup Q]
    (map : C →ₗ[ℤ] Q)
    (kernel_compatibility : LinearMap.ker evaluation ≤ LinearMap.ker map) :
    ∃! factor : Carrier evaluation →ₗ[ℤ] Q,
      factor.comp (SourceGeneratedPerfectification.canonicalMap evaluation) = map :=
  SourceGeneratedPerfectification.canonicalMap_universal evaluation map
    kernel_compatibility

/-! ## Universal exact-perfect envelope

`CompatiblePerfectTarget` describes another exact ambient for the same source
evaluation.  Its dual carrier is equivalent to its carrier and embeds
faithfully into the same ambient dual readout.  The readback equation is the
only compatibility datum.  Kernel compatibility, the carrier factor, and the
dual factor are derived from it.
-/

structure CompatiblePerfectTarget
    (TargetCarrier : Type a) (TargetDual : Type b)
    [AddCommGroup TargetCarrier] [AddCommGroup TargetDual] :
    Type (max c d a b + 1) where
  sourceMap : C →ₗ[ℤ] TargetCarrier
  duality : TargetCarrier ≃ₗ[ℤ] TargetDual
  dualInclusion : TargetDual →ₗ[ℤ] Module.Dual ℤ D
  dualInclusion_injective : Function.Injective dualInclusion
  readback : (dualInclusion.comp duality.toLinearMap).comp sourceMap = evaluation

namespace CompatiblePerfectTarget

variable {TargetCarrier : Type a} {TargetDual : Type b}
variable [AddCommGroup TargetCarrier] [AddCommGroup TargetDual]

theorem kernel_compatibility
    (target : CompatiblePerfectTarget evaluation TargetCarrier TargetDual) :
    LinearMap.ker evaluation ≤ LinearMap.ker target.sourceMap := by
  intro value value_mem
  rw [LinearMap.mem_ker] at value_mem ⊢
  have readbackAt := LinearMap.congr_fun target.readback value
  have inclusionZero :
      target.dualInclusion (target.duality (target.sourceMap value)) = 0 := by
    simpa [LinearMap.comp_apply, value_mem] using readbackAt
  have dualZero : target.duality (target.sourceMap value) = 0 :=
    target.dualInclusion_injective (by simpa using inclusionZero)
  exact target.duality.injective (by simpa using dualZero)

def carrierFactor
    (target : CompatiblePerfectTarget evaluation TargetCarrier TargetDual) :
    Carrier evaluation →ₗ[ℤ] TargetCarrier :=
  SourceGeneratedPerfectification.canonicalFactor evaluation target.sourceMap
    (target.kernel_compatibility evaluation)

@[simp] theorem carrierFactor_comp_canonicalMap
    (target : CompatiblePerfectTarget evaluation TargetCarrier TargetDual) :
    (target.carrierFactor evaluation).comp
        (SourceGeneratedPerfectification.canonicalMap evaluation) =
      target.sourceMap :=
  SourceGeneratedPerfectification.canonicalFactor_comp evaluation
    target.sourceMap (target.kernel_compatibility evaluation)

def dualFactor
    (target : CompatiblePerfectTarget evaluation TargetCarrier TargetDual) :
    GeneratedDual evaluation →ₗ[ℤ] TargetDual :=
  (target.duality.toLinearMap.comp (target.carrierFactor evaluation)).comp
    (coevaluation evaluation)

@[simp] theorem dualFactor_comp_generatedDualMap
    (target : CompatiblePerfectTarget evaluation TargetCarrier TargetDual) :
    (target.dualFactor evaluation).comp (generatedDualMap evaluation) =
      target.duality.toLinearMap.comp (target.carrierFactor evaluation) := by
  apply LinearMap.ext
  intro value
  exact congrArg (fun carrierValue =>
      target.duality (target.carrierFactor evaluation carrierValue))
    ((perfectEquiv evaluation).symm_apply_apply value)

theorem dualInclusion_comp_dualFactor
    (target : CompatiblePerfectTarget evaluation TargetCarrier TargetDual) :
    target.dualInclusion.comp (target.dualFactor evaluation) =
      SourceGeneratedCanonicalPerfectPair.dualInclusion evaluation := by
  apply LinearMap.ext
  intro dualValue
  obtain ⟨carrierValue, rfl⟩ :=
    (generatedDualMap_surjective evaluation) dualValue
  have targetReadback := LinearMap.congr_fun target.readback
  have sourceReadback :=
    SourceGeneratedPerfectification.dualEmbedding_comp_canonicalMap evaluation
  obtain ⟨sourceValue, rfl⟩ :=
    Submodule.mkQ_surjective (LinearMap.ker evaluation) carrierValue
  have targetAt := targetReadback sourceValue
  have sourceAt := LinearMap.congr_fun sourceReadback sourceValue
  have zigAt := LinearMap.congr_fun
    (coevaluation_comp_generatedDualMap evaluation)
    (SourceGeneratedPerfectification.canonicalMap evaluation sourceValue)
  have factorAt := LinearMap.congr_fun
    (target.carrierFactor_comp_canonicalMap evaluation) sourceValue
  change target.dualInclusion
      (target.duality
        (target.carrierFactor evaluation
          (coevaluation evaluation
            (generatedDualMap evaluation
              (SourceGeneratedPerfectification.canonicalMap evaluation sourceValue))))) =
    SourceGeneratedPerfectification.dualEmbedding evaluation
      (SourceGeneratedPerfectification.canonicalMap evaluation sourceValue)
  rw [LinearMap.comp_apply] at zigAt factorAt
  have zigAt' :
      coevaluation evaluation
          (generatedDualMap evaluation
            (SourceGeneratedPerfectification.canonicalMap evaluation sourceValue)) =
        SourceGeneratedPerfectification.canonicalMap evaluation sourceValue := by
    simpa using zigAt
  rw [zigAt', factorAt]
  exact targetAt.trans sourceAt.symm

end CompatiblePerfectTarget

/-- A morphism of exact perfect envelopes preserves the source map, generated
duality, and ambient dual inclusion. -/
structure EnvelopeMorphism
    {TargetCarrier : Type a} {TargetDual : Type b}
    [AddCommGroup TargetCarrier] [AddCommGroup TargetDual]
    (target : CompatiblePerfectTarget evaluation TargetCarrier TargetDual) :
    Type (max c d a b + 1) where
  carrierMap : Carrier evaluation →ₗ[ℤ] TargetCarrier
  dualMap : GeneratedDual evaluation →ₗ[ℤ] TargetDual
  source_commutes : carrierMap.comp
    (SourceGeneratedPerfectification.canonicalMap evaluation) = target.sourceMap
  duality_commutes : dualMap.comp (generatedDualMap evaluation) =
    target.duality.toLinearMap.comp carrierMap
  inclusion_commutes : target.dualInclusion.comp dualMap = dualInclusion evaluation

@[ext] theorem EnvelopeMorphism.ext
    {TargetCarrier : Type a} {TargetDual : Type b}
    [AddCommGroup TargetCarrier] [AddCommGroup TargetDual]
    {target : CompatiblePerfectTarget evaluation TargetCarrier TargetDual}
    {left right : EnvelopeMorphism evaluation target}
    (carrierEquality : left.carrierMap = right.carrierMap)
    (dualEquality : left.dualMap = right.dualMap) :
    left = right := by
  cases left
  cases right
  cases carrierEquality
  cases dualEquality
  rfl

def universalMorphism
    {TargetCarrier : Type a} {TargetDual : Type b}
    [AddCommGroup TargetCarrier] [AddCommGroup TargetDual]
    (target : CompatiblePerfectTarget evaluation TargetCarrier TargetDual) :
    EnvelopeMorphism evaluation target where
  carrierMap := target.carrierFactor evaluation
  dualMap := target.dualFactor evaluation
  source_commutes := target.carrierFactor_comp_canonicalMap evaluation
  duality_commutes := target.dualFactor_comp_generatedDualMap evaluation
  inclusion_commutes := target.dualInclusion_comp_dualFactor evaluation

theorem universalMorphism_unique
    {TargetCarrier : Type a} {TargetDual : Type b}
    [AddCommGroup TargetCarrier] [AddCommGroup TargetDual]
    (target : CompatiblePerfectTarget evaluation TargetCarrier TargetDual)
    (other : EnvelopeMorphism evaluation target) :
    other = universalMorphism evaluation target := by
  have carrierEquality :
      other.carrierMap = target.carrierFactor evaluation :=
    SourceGeneratedPerfectification.canonicalFactor_unique evaluation
      target.sourceMap (target.kernel_compatibility evaluation)
      other.carrierMap other.source_commutes
  cases other with
  | mk otherCarrier otherDual sourceCommutes dualityCommutes inclusionCommutes =>
      simp only at carrierEquality
      subst otherCarrier
      have dualEquality : otherDual = target.dualFactor evaluation := by
        apply LinearMap.ext
        intro dualValue
        obtain ⟨carrierValue, rfl⟩ :=
          (generatedDualMap_surjective evaluation) dualValue
        have otherAt := LinearMap.congr_fun dualityCommutes carrierValue
        have canonicalAt := LinearMap.congr_fun
          (CompatiblePerfectTarget.dualFactor_comp_generatedDualMap
            evaluation target) carrierValue
        exact otherAt.trans canonicalAt.symm
      subst otherDual
      rfl

theorem universal_property
    {TargetCarrier : Type a} {TargetDual : Type b}
    [AddCommGroup TargetCarrier] [AddCommGroup TargetDual]
    (target : CompatiblePerfectTarget evaluation TargetCarrier TargetDual) :
    ∃! morphism : EnvelopeMorphism evaluation target,
      morphism.carrierMap.comp
        (SourceGeneratedPerfectification.canonicalMap evaluation) =
          target.sourceMap := by
  refine ⟨universalMorphism evaluation target,
    (universalMorphism evaluation target).source_commutes, ?_⟩
  intro other _
  exact universalMorphism_unique evaluation target other

/-! ## Any finite observation remains a classified face -/

def observationDisposition
    {O : Type a} [AddCommGroup O]
    (observation : Carrier evaluation →ₗ[ℤ] O) :
    SourceGeneratedPerfectification.FiniteObservationDisposition observation :=
  SourceGeneratedPerfectification.settleFiniteObservation observation

theorem observationDisposition_total
    {O : Type a} [AddCommGroup O]
    (observation : Carrier evaluation →ₗ[ℤ] O) :
    Nonempty (SourceGeneratedPerfectification.FiniteObservationDisposition observation) :=
  ⟨observationDisposition evaluation observation⟩

/-! ## Source-morphism naturality of the generated image -/

variable {C' : Type c} {D' : Type d}
variable [AddCommGroup C'] [AddCommGroup D']
variable (evaluation' : C' →ₗ[ℤ] Module.Dual ℤ D')

def inducedCarrierMap
    (carrierMap : C →ₗ[ℤ] C')
    (dualMap : D' →ₗ[ℤ] D)
    (naturality :
      (SourceGeneratedPerfectification.inducedDualTarget dualMap).comp evaluation =
        evaluation'.comp carrierMap) :
    Carrier evaluation →ₗ[ℤ] Carrier evaluation' :=
  SourceGeneratedPerfectification.inducedPerfectificationMap
    evaluation evaluation' carrierMap dualMap naturality

def inducedDualImageMap
    (carrierMap : C →ₗ[ℤ] C')
    (dualMap : D' →ₗ[ℤ] D)
    (naturality :
      (SourceGeneratedPerfectification.inducedDualTarget dualMap).comp evaluation =
        evaluation'.comp carrierMap) :
    GeneratedDual evaluation →ₗ[ℤ] GeneratedDual evaluation' := by
  let carrierTransport := inducedCarrierMap evaluation evaluation'
    carrierMap dualMap naturality
  let dualTransport :=
    SourceGeneratedPerfectification.inducedDualTarget dualMap
  let map : GeneratedDual evaluation →ₗ[ℤ] GeneratedDual evaluation' :=
    (dualTransport.comp (dualInclusion evaluation)).codRestrict
      (GeneratedDual evaluation') (by
      intro value
      rcases value.property with ⟨sourceValue, sourceEquality⟩
      refine ⟨carrierTransport sourceValue, ?_⟩
      have commute :=
        congrArg (fun f => f sourceValue)
          (SourceGeneratedPerfectification.dualEmbedding_naturality
            evaluation evaluation' carrierMap dualMap naturality)
      calc
        SourceGeneratedPerfectification.dualEmbedding evaluation'
            (carrierTransport sourceValue) =
            dualTransport
              (SourceGeneratedPerfectification.dualEmbedding evaluation sourceValue) :=
          commute
        _ = dualTransport value.1 := by rw [sourceEquality])
  exact map

theorem inducedCarrierMap_comp_canonicalMap
    (carrierMap : C →ₗ[ℤ] C')
    (dualMap : D' →ₗ[ℤ] D)
    (naturality :
      (SourceGeneratedPerfectification.inducedDualTarget dualMap).comp evaluation =
        evaluation'.comp carrierMap) :
    (inducedCarrierMap evaluation evaluation' carrierMap dualMap naturality).comp
        (SourceGeneratedPerfectification.canonicalMap evaluation) =
      (SourceGeneratedPerfectification.canonicalMap evaluation').comp carrierMap :=
  SourceGeneratedPerfectification.inducedPerfectificationMap_comp
    evaluation evaluation' carrierMap dualMap naturality

theorem inducedDualImageMap_naturality
    (carrierMap : C →ₗ[ℤ] C')
    (dualMap : D' →ₗ[ℤ] D)
    (naturality :
      (SourceGeneratedPerfectification.inducedDualTarget dualMap).comp evaluation =
        evaluation'.comp carrierMap) :
    (dualInclusion evaluation').comp
        (inducedDualImageMap evaluation evaluation' carrierMap dualMap naturality) =
      (SourceGeneratedPerfectification.inducedDualTarget dualMap).comp
        (dualInclusion evaluation) := by
  apply LinearMap.ext
  intro value
  rfl

theorem generatedDualMap_naturality
    (carrierMap : C →ₗ[ℤ] C')
    (dualMap : D' →ₗ[ℤ] D)
    (naturality :
      (SourceGeneratedPerfectification.inducedDualTarget dualMap).comp evaluation =
        evaluation'.comp carrierMap) :
    (inducedDualImageMap evaluation evaluation' carrierMap dualMap naturality).comp
        (generatedDualMap evaluation) =
      (generatedDualMap evaluation').comp
        (inducedCarrierMap evaluation evaluation' carrierMap dualMap naturality) := by
  apply LinearMap.ext
  intro value
  apply Subtype.ext
  have commute :=
    congrArg (fun f => f value)
      (SourceGeneratedPerfectification.dualEmbedding_naturality
        evaluation evaluation' carrierMap dualMap naturality)
  change SourceGeneratedPerfectification.inducedDualTarget dualMap
      (SourceGeneratedPerfectification.dualEmbedding evaluation value) =
    SourceGeneratedPerfectification.dualEmbedding evaluation'
      (inducedCarrierMap evaluation evaluation' carrierMap dualMap naturality value)
  exact commute.symm

theorem perfectEquiv_readback_naturality
    (carrierMap : C →ₗ[ℤ] C')
    (dualMap : D' →ₗ[ℤ] D)
    (naturality :
      (SourceGeneratedPerfectification.inducedDualTarget dualMap).comp evaluation =
        evaluation'.comp carrierMap) :
    (inducedDualImageMap evaluation evaluation' carrierMap dualMap naturality).comp
        (perfectEquiv evaluation).toLinearMap =
      (perfectEquiv evaluation').toLinearMap.comp
        (inducedCarrierMap evaluation evaluation' carrierMap dualMap naturality) :=
  generatedDualMap_naturality evaluation evaluation' carrierMap dualMap naturality

theorem coevaluation_naturality
    (carrierMap : C →ₗ[ℤ] C')
    (dualMap : D' →ₗ[ℤ] D)
    (naturality :
      (SourceGeneratedPerfectification.inducedDualTarget dualMap).comp evaluation =
        evaluation'.comp carrierMap) :
    (inducedCarrierMap evaluation evaluation' carrierMap dualMap naturality).comp
        (coevaluation evaluation) =
      (coevaluation evaluation').comp
        (inducedDualImageMap evaluation evaluation' carrierMap dualMap naturality) := by
  apply LinearMap.ext
  intro dualValue
  obtain ⟨carrierValue, rfl⟩ :=
    (generatedDualMap_surjective evaluation) dualValue
  have sourceZigzag := LinearMap.congr_fun
    (coevaluation_comp_generatedDualMap evaluation) carrierValue
  have targetZigzag := LinearMap.congr_fun
    (coevaluation_comp_generatedDualMap evaluation')
    (inducedCarrierMap evaluation evaluation' carrierMap dualMap naturality carrierValue)
  have forwardNaturality := LinearMap.congr_fun
    (generatedDualMap_naturality evaluation evaluation' carrierMap dualMap naturality)
    carrierValue
  rw [LinearMap.comp_apply] at sourceZigzag targetZigzag forwardNaturality
  simpa [sourceZigzag, forwardNaturality] using targetZigzag.symm

theorem inducedDualImageMap_id
    (identityNaturality :
      (SourceGeneratedPerfectification.inducedDualTarget
        (LinearMap.id : D →ₗ[ℤ] D)).comp evaluation =
        evaluation.comp (LinearMap.id : C →ₗ[ℤ] C)) :
    inducedDualImageMap evaluation evaluation LinearMap.id LinearMap.id
      identityNaturality = LinearMap.id := by
  apply LinearMap.ext
  intro value
  apply Subtype.ext
  rfl

variable {C'' : Type c} {D'' : Type d}
variable [AddCommGroup C''] [AddCommGroup D'']

theorem inducedDualImageMap_comp
    (evaluation'' : C'' →ₗ[ℤ] Module.Dual ℤ D'')
    (carrierMap₁ : C →ₗ[ℤ] C')
    (carrierMap₂ : C' →ₗ[ℤ] C'')
    (dualMap₁ : D' →ₗ[ℤ] D)
    (dualMap₂ : D'' →ₗ[ℤ] D')
    (naturality₁ :
      (SourceGeneratedPerfectification.inducedDualTarget dualMap₁).comp evaluation =
        evaluation'.comp carrierMap₁)
    (naturality₂ :
      (SourceGeneratedPerfectification.inducedDualTarget dualMap₂).comp evaluation' =
        evaluation''.comp carrierMap₂)
    (compositeNaturality :
      (SourceGeneratedPerfectification.inducedDualTarget
        (dualMap₁.comp dualMap₂)).comp evaluation =
        evaluation''.comp (carrierMap₂.comp carrierMap₁)) :
    inducedDualImageMap evaluation evaluation''
        (carrierMap₂.comp carrierMap₁) (dualMap₁.comp dualMap₂)
        compositeNaturality =
      (inducedDualImageMap evaluation' evaluation'' carrierMap₂ dualMap₂
        naturality₂).comp
        (inducedDualImageMap evaluation evaluation' carrierMap₁ dualMap₁
          naturality₁) := by
  apply LinearMap.ext
  intro value
  apply Subtype.ext
  rfl

end
end SourceGeneratedCanonicalPerfectPair
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
