import H0mework.Realization.Perfectification.Integral.Completion.LivingLawRootGeneratedPrimePowerCompletionKernel

/-!
# Faithful coimage and separation disposition

The canonical prime-power completion map generates its own kernel quotient.
That coimage embeds faithfully in the inverse limit and has the expected
quotient universal property.  The original carrier is then either separated,
or an actual nonzero coordinate is retained together with all of its
prime-power division witnesses.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace SourceGeneratedPrimePowerCompletion

noncomputable section

universe u v

variable {L : Type u} [AddCommGroup L]

def canonicalLinearMap (prime : Nat.Primes) :
    L →ₗ[ℤ] Completion (L := L) prime :=
  (canonicalMap (L := L) prime).hom

abbrev SeparationKernel (prime : Nat.Primes) : Submodule ℤ L :=
  LinearMap.ker (canonicalLinearMap (L := L) prime)

/-- The lossless quotient generated by the actual completion map.  This is a
faithful coimage, without a claim that it is a finite or algebraically perfect
module. -/
abbrev FaithfulCoimage (prime : Nat.Primes) :=
  L ⧸ SeparationKernel (L := L) prime

def coimageProjection (prime : Nat.Primes) :
    L →ₗ[ℤ] FaithfulCoimage (L := L) prime :=
  Submodule.mkQ _

def coimageRealization (prime : Nat.Primes) :
    FaithfulCoimage (L := L) prime →ₗ[ℤ]
      Completion (L := L) prime :=
  (SeparationKernel (L := L) prime).liftQ
    (canonicalLinearMap (L := L) prime) le_rfl

@[simp] theorem coimageRealization_projection
    (prime : Nat.Primes) :
    (coimageRealization (L := L) prime).comp
        (coimageProjection (L := L) prime) =
      canonicalLinearMap (L := L) prime := by
  unfold coimageRealization coimageProjection
  exact Submodule.liftQ_mkQ _ _ _

theorem coimageRealization_injective (prime : Nat.Primes) :
    Function.Injective (coimageRealization (L := L) prime) := by
  rw [← LinearMap.ker_eq_bot]
  exact Submodule.ker_liftQ_eq_bot _ _ _ le_rfl

/-- The generated coimage is immediately consumable by the existing
faithful-integral localization interface. -/
def coimageFaithfulIntegralFace (prime : Nat.Primes) :
    SourceGeneratedFaithfulIntegralFace.FaithfulIntegralFace
      (L := FaithfulCoimage (L := L) prime)
      (Ambient := Completion (L := L) prime) where
  realization := coimageRealization (L := L) prime
  injective := coimageRealization_injective prime

def coimageFactor
    (prime : Nat.Primes)
    {Q : Type v} [AddCommGroup Q]
    (map : L →ₗ[ℤ] Q)
    (kernelCompatibility :
      SeparationKernel (L := L) prime ≤ LinearMap.ker map) :
    FaithfulCoimage (L := L) prime →ₗ[ℤ] Q :=
  (SeparationKernel (L := L) prime).liftQ map kernelCompatibility

@[simp] theorem coimageFactor_projection
    (prime : Nat.Primes)
    {Q : Type v} [AddCommGroup Q]
    (map : L →ₗ[ℤ] Q)
    (kernelCompatibility :
      SeparationKernel (L := L) prime ≤ LinearMap.ker map) :
    (coimageFactor prime map kernelCompatibility).comp
        (coimageProjection (L := L) prime) = map := by
  unfold coimageFactor coimageProjection
  exact Submodule.liftQ_mkQ _ _ _

theorem coimage_universal
    (prime : Nat.Primes)
    {Q : Type v} [AddCommGroup Q]
    (map : L →ₗ[ℤ] Q)
    (kernelCompatibility :
      SeparationKernel (L := L) prime ≤ LinearMap.ker map) :
    ∃! factor : FaithfulCoimage (L := L) prime →ₗ[ℤ] Q,
      factor.comp (coimageProjection (L := L) prime) = map := by
  refine ⟨coimageFactor prime map kernelCompatibility,
    coimageFactor_projection prime map kernelCompatibility, ?_⟩
  intro other otherCommutes
  apply LinearMap.ext
  intro quotient
  obtain ⟨value, rfl⟩ :=
    Submodule.mkQ_surjective (SeparationKernel (L := L) prime) quotient
  have equality := LinearMap.congr_fun otherCommutes value
  exact equality.trans (by rfl)

/-- An exact coordinate invisible to every finite prime-power observation. -/
structure SeparationResidual (prime : Nat.Primes) where
  coordinate : L
  coordinate_ne_zero : coordinate ≠ 0
  completion_zero : canonicalLinearMap (L := L) prime coordinate = 0
  divided : ∀ stage, ∃ root : L,
    (prime.1 : ℤ) ^ (stage + 1) • root = coordinate

inductive SeparationDisposition (prime : Nat.Primes) : Type u where
  | faithful
      (canonical_injective :
        Function.Injective (canonicalLinearMap (L := L) prime))
  | representationResidual
      (residual : SeparationResidual (L := L) prime)

private theorem exists_distinct_equal_images
    (prime : Nat.Primes)
    (notInjective :
      ¬ Function.Injective (canonicalLinearMap (L := L) prime)) :
    ∃ left right : L, left ≠ right ∧
      canonicalLinearMap (L := L) prime left =
        canonicalLinearMap (L := L) prime right := by
  classical
  by_contra impossible
  apply notInjective
  intro left right equality
  by_contra different
  exact impossible ⟨left, right, different, equality⟩

/-- Total disposition of the source against its generated prime-power
completion language. -/
noncomputable def settleSeparation (prime : Nat.Primes) :
    SeparationDisposition (L := L) prime := by
  classical
  by_cases injective :
      Function.Injective (canonicalLinearMap (L := L) prime)
  · exact .faithful injective
  · let witness := exists_distinct_equal_images prime injective
    let left : L := Classical.choose witness
    let right : L := Classical.choose (Classical.choose_spec witness)
    have different : left ≠ right :=
      (Classical.choose_spec (Classical.choose_spec witness)).1
    have equalImages :
        canonicalLinearMap (L := L) prime left =
          canonicalLinearMap (L := L) prime right :=
      (Classical.choose_spec (Classical.choose_spec witness)).2
    let coordinate : L := left - right
    have coordinate_ne_zero : coordinate ≠ 0 :=
      sub_ne_zero.mpr different
    have completion_zero :
        canonicalLinearMap (L := L) prime coordinate = 0 := by
      rw [map_sub, equalImages, sub_self]
    exact .representationResidual
      { coordinate := coordinate
        coordinate_ne_zero := coordinate_ne_zero
        completion_zero := completion_zero
        divided := (canonicalMap_eq_zero_iff prime coordinate).1
          completion_zero }

theorem separationDisposition_total (prime : Nat.Primes) :
    Nonempty (SeparationDisposition (L := L) prime) :=
  ⟨settleSeparation (L := L) prime⟩

end
end SourceGeneratedPrimePowerCompletion
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
