import H0mework.Realization.Completion.HistoryTransition
import Mathlib.Tactic.Tauto
set_option autoImplicit false
noncomputable section
universe u v w r
namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace SourceHistoryCommon
open CofinalHistorySettlement
-- The carrier is generated by the two original continuation actions.
def continuation {G : Type u} (left right : G → RootedAccountedUnfolding G) (event : G) :=
  RootedAccountedUnfolding.parallelAt event (left event) (right event)
def seed {G : Type u} (left right : RootedAccountedUnfolding G) :=
  RootedAccountedUnfolding.parallelAt left.root left right
variable {A : Type v} {B : Type w} {G : Type u} {Root : Type r}
variable {rootA : RootedAccountedUnfolding A} {rootB : RootedAccountedUnfolding B}
variable {seedA seedB : RootedAccountedUnfolding (PresentedRelationEventAt G)}
variable {nextA nextB : RootedAccountedUnfolding (PresentedRelationEventAt G → RootedAccountedUnfolding (PresentedRelationEventAt G))}
variable (left : RootGeneratedCofinalHistoryAt rootA seedA nextA)
variable (right : RootGeneratedCofinalHistoryAt rootB seedB nextB)
def history (actual : RootedAccountedUnfolding Root) :
    RootGeneratedCofinalHistoryAt actual (seed left.seed right.seed)
      (RootedAccountedUnfolding.zero (continuation left.actualContinuation right.actualContinuation)) :=
  RootGeneratedCofinalHistoryAt.generate

end SourceHistoryCommon
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
end
