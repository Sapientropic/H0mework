import H0mework.Realization.Integral.CharacterGroupRing
import H0mework.Realization.Coherent.EquivariantPerfectAction

/-!
# Canonical perfect pair of an integral group ring

The quantized basis of `ℤ[G]` generates its own coefficient pairing.  The
pairing is faithful for every group, and left translation is contragredient
to translation by the inverse element.  This supplies the source evaluation
needed by the universal exact-perfect envelope; it is not imported from a
finite, analytic, determinant, or domain-specific representation.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace SourceGeneratedIntegralGroupRingPerfectPair

open SourceGeneratedIntegralCharacterGroupRing
open SourceGeneratedScalarPerfectification

noncomputable section

universe u
variable {G : Type u} [Group G]

/-- Coefficient at one quantized basis element as an integral functional. -/
def coefficientFunctional (element : G) : Carrier G →ₗ[ℤ] ℤ :=
  (Finsupp.lapply element).comp
    (MonoidAlgebra.coeffLinearEquiv ℤ).toLinearMap

/-- Canonical Kronecker evaluation generated by the integral basis. -/
def evaluation : Carrier G →ₗ[ℤ] Module.Dual ℤ (Carrier G) :=
  canonicalBasis.constr ℤ coefficientFunctional

@[simp] theorem evaluation_delta (element : G) :
    evaluation (delta element) = coefficientFunctional element := by
  rw [← canonicalBasis_apply element]
  exact canonicalBasis.constr_basis ℤ _ element

/-- Evaluating a group-ring state against a basis detector recovers that
state's literal integral coefficient. -/
theorem evaluation_apply_delta (value : Carrier G) (element : G) :
    evaluation value (delta element) = value.coeff element := by
  let left : Carrier G →ₗ[ℤ] ℤ :=
    { toFun := fun source => evaluation source (delta element)
      map_add' := fun first second => by simp
      map_smul' := fun coefficient source => by
        simpa using congrArg (fun functional => functional (delta element))
          (map_smul (evaluation (G := G)) coefficient source) }
  let right : Carrier G →ₗ[ℤ] ℤ := coefficientFunctional element
  have equal : left = right := by
    apply canonicalBasis.ext
    intro basisElement
    change evaluation (canonicalBasis basisElement) (delta element) =
      coefficientFunctional element (canonicalBasis basisElement)
    rw [canonicalBasis_apply]
    rw [show evaluation (delta basisElement) =
        coefficientFunctional basisElement by
      exact evaluation_delta basisElement]
    change (delta element).coeff basisElement =
      (delta basisElement).coeff element
    by_cases equality : basisElement = element
    · subst basisElement
      simp [delta]
    · simp [delta, equality, Ne.symm equality]
  exact LinearMap.congr_fun equal value

theorem evaluation_injective : Function.Injective (evaluation (G := G)) := by
  intro left right equality
  apply MonoidAlgebra.ext
  apply Finsupp.ext
  intro element
  have atDelta := congrArg (fun functional => functional (delta element)) equality
  simpa [evaluation_apply_delta] using atDelta

theorem evaluation_ker_eq_bot :
    LinearMap.ker (evaluation (G := G)) = ⊥ :=
  LinearMap.ker_eq_bot.mpr evaluation_injective

/-- Translation of quantized charge preserves the same pairing with the
inverse translation on the detector face. -/
theorem translation_evaluation_naturality (element : G) :
    (inducedDualTarget (leftTranslation element⁻¹).toLinearMap).comp
        (evaluation (G := G)) =
      (evaluation (G := G)).comp (leftTranslation element).toLinearMap := by
  apply canonicalBasis.ext
  intro basisElement
  apply LinearMap.ext
  intro testedElement
  rw [canonicalBasis_apply, LinearMap.comp_apply, LinearMap.comp_apply,
    inducedDualTarget_apply]
  change evaluation (delta basisElement)
      (leftTranslation element⁻¹ testedElement) =
    evaluation (leftTranslation element (delta basisElement)) testedElement
  rw [leftTranslation_delta, evaluation_delta, evaluation_delta]
  simp [coefficientFunctional, leftTranslation, deltaUnit_coe, delta]

/-- The canonical translation square as input to the generic equivariant
perfect-envelope producer. -/
def translationAction (element : G) :
    SourceGeneratedScalarEquivariantPerfectAction.ActionData
      (evaluation (G := G)) where
  carrierAction := (leftTranslation element).toLinearMap
  dualCarrierAction := (leftTranslation element⁻¹).toLinearMap
  evaluation_commutes := translation_evaluation_naturality element

end

end SourceGeneratedIntegralGroupRingPerfectPair
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
