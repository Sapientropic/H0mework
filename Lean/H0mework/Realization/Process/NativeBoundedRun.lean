import H0mework.Realization.Process.NativeResponseDisposition

/-!
# Inclusive bounded runs for source-owned dependent responses

Given a source producer

```text
respond current : Option (Σ next, Step current next),
```

`SourceGeneratedNativeResponseDisposition` classifies one reachable
current.  This module iterates the same producer for a caller-chosen amount
of fuel without losing the first failed response.

The fuel counts the maximum number of responses that may be *executed*.
The endpoint is always inspected:

* `terminal` stores the literal `respond current = none`;
* `cutoff` occurs only at zero fuel and stores the live, unexecuted exact
  response;
* `continued` executes one exact response and recurses.

Thus a finite request never turns an available next response into a silent
end.  No theorem here says that an unbounded run terminates.  No target,
coverage family, nonzero witness, relation branch, terminal certificate, or
well-founded measure enters the producer mouth.
-/

namespace SaturationMonoid
namespace SourceGeneratedNativeBoundedRun

open SourceGeneratedNativeResponseDisposition

universe uState uStep

variable {State : Type uState}
variable {Step : State → State → Type uStep}

/-- One literal response together with the equality proving that the source
producer generated precisely this dependent edge. -/
structure NativeResponseStep
    (respond :
      ∀ current : State,
        Option (Response Step current))
    (current next : State) :
    Type (max uState uStep) where
  edge : Step current next
  generated :
    respond current = some ⟨next, edge⟩

/-- Inclusive bounded execution of a source-owned response function.

`fuel` is an upper bound on executed responses.  At zero fuel the current
response is still inspected, so a live response is retained by `cutoff`
rather than discarded. -/
inductive BoundedRun
    (respond :
      ∀ current : State,
        Option (Response Step current)) :
    State → Nat → Type (max uState uStep)
  | terminal
      {current : State}
      {fuel : Nat}
      (stopped : respond current = none) :
      BoundedRun respond current fuel
  | cutoff
      {current next : State}
      (transition :
        NativeResponseStep respond current next) :
      BoundedRun respond current 0
  | continued
      {current next : State}
      {fuel : Nat}
      (transition :
        NativeResponseStep respond current next)
      (rest :
        BoundedRun respond next fuel) :
      BoundedRun respond current (fuel + 1)

/-- Execute at most `fuel` responses while always observing the final
current.  All exit evidence is generated by case analysis on `respond`. -/
def generatedBoundedRun
    (respond :
      ∀ current : State,
        Option (Response Step current)) :
    (current : State) →
      (fuel : Nat) →
        BoundedRun respond current fuel
  | current, 0 =>
      match generated : respond current with
      | none => .terminal generated
      | some ⟨_next, edge⟩ =>
          .cutoff
            ⟨edge, generated⟩
  | current, fuel + 1 =>
      match generated : respond current with
      | none => .terminal generated
      | some ⟨next, edge⟩ =>
          .continued
            ⟨edge, generated⟩
            (generatedBoundedRun respond next fuel)

namespace BoundedRun

/-- Prepend one already generated arrival chain to another chain whose
initial current is the first chain's endpoint. -/
def prependNativeReachable
    {respond :
      ∀ current : State,
        Option (Response Step current)}
    {initial current : State}
    (headArrival :
      NativeReachable initial respond current) :
    {endpoint : State} →
      NativeReachable current respond endpoint →
        NativeReachable initial respond endpoint
  | _, .initial => headArrival
  | _, .step arrival generated =>
      .step
        (prependNativeReachable headArrival arrival)
        generated

/-- Occurrences concatenate when generated arrival chains are prepended. -/
@[simp] theorem prependNativeReachable_occurrence
    {respond :
      ∀ current : State,
        Option (Response Step current)}
    {initial current endpoint : State}
    (headArrival :
      NativeReachable initial respond current)
    (suffix :
      NativeReachable current respond endpoint) :
    (prependNativeReachable headArrival suffix).occurrence =
      headArrival.occurrence + suffix.occurrence := by
  induction suffix with
  | initial => rfl
  | step arrival generated ih =>
      change
        (prependNativeReachable
            headArrival arrival).occurrence + 1 =
          headArrival.occurrence +
            (arrival.occurrence + 1)
      rw [ih]
      exact Nat.add_assoc _ _ _

/-- Number of responses actually executed before terminal or cutoff. -/
def depth
    {respond :
      ∀ current : State,
        Option (Response Step current)}
    {current : State}
    {fuel : Nat} :
    BoundedRun respond current fuel → Nat
  | .terminal _ => 0
  | .cutoff _ => 0
  | .continued _ rest => rest.depth + 1

/-- Last inspected current of the bounded run. -/
def endState
    {respond :
      ∀ current : State,
        Option (Response Step current)}
    {current : State}
    {fuel : Nat} :
    BoundedRun respond current fuel → State
  | .terminal _ => current
  | .cutoff _ => current
  | .continued _ rest => rest.endState

/-- Zero fuel executes no response, although it still observes the current
response and distinguishes terminal from live cutoff. -/
@[simp] theorem depth_zero_fuel
    {respond :
      ∀ current : State,
        Option (Response Step current)}
    {current : State}
    (run : BoundedRun respond current 0) :
    run.depth = 0 := by
  cases run <;> rfl

/-- The last inspected current at zero fuel is the initial current. -/
@[simp] theorem endState_zero_fuel
    {respond :
      ∀ current : State,
        Option (Response Step current)}
    {current : State}
    (run : BoundedRun respond current 0) :
    run.endState = current := by
  cases run <;> rfl

/-- If the initial source response is literally stopped, no bounded run
from that current can have executed an edge. -/
theorem depth_eq_zero_of_respond_eq_none
    {respond :
      ∀ current : State,
        Option (Response Step current)}
    {current : State}
    {fuel : Nat}
    (run : BoundedRun respond current fuel)
    (stopped : respond current = none) :
    run.depth = 0 := by
  cases run with
  | terminal _ => rfl
  | cutoff transition =>
      have generated := transition.generated
      rw [stopped] at generated
      contradiction
  | continued transition rest =>
      have generated := transition.generated
      rw [stopped] at generated
      contradiction

/-- A stopped initial response also pins the last inspected current to the
initial current. -/
theorem endState_eq_current_of_respond_eq_none
    {respond :
      ∀ current : State,
        Option (Response Step current)}
    {current : State}
    {fuel : Nat}
    (run : BoundedRun respond current fuel)
    (stopped : respond current = none) :
    run.endState = current := by
  cases run with
  | terminal _ => rfl
  | cutoff transition =>
      have generated := transition.generated
      rw [stopped] at generated
      contradiction
  | continued transition rest =>
      have generated := transition.generated
      rw [stopped] at generated
      contradiction

/-- One executed source occurrence, retaining both endpoint indices and the
literal producer equality. -/
structure ActualOccurrence
    (respond :
      ∀ current : State,
        Option (Response Step current)) :
    Type (max uState uStep) where
  current : State
  next : State
  transition :
    NativeResponseStep respond current next

/-- Chronological table of executed source occurrences.  A cutoff response
is deliberately absent because it has been observed but not executed. -/
def actualOccurrenceTable
    {respond :
      ∀ current : State,
        Option (Response Step current)}
    {current : State}
    {fuel : Nat}
    (run : BoundedRun respond current fuel) :
    List (ActualOccurrence respond) :=
  match run with
  | .terminal _ => []
  | .cutoff _ => []
  | .continued transition rest =>
      ⟨current, _, transition⟩ ::
        rest.actualOccurrenceTable

@[simp] theorem actualOccurrenceTable_length
    {respond :
      ∀ current : State,
        Option (Response Step current)}
    {current : State}
    {fuel : Nat}
    (run : BoundedRun respond current fuel) :
    run.actualOccurrenceTable.length = run.depth := by
  induction run with
  | terminal stopped => rfl
  | cutoff transition => rfl
  | continued transition rest ih =>
      simp [actualOccurrenceTable, depth, ih]

/-- The exact source reachability of the last inspected current. -/
def endNativeReachable
    {respond :
      ∀ current : State,
        Option (Response Step current)}
    {current : State}
    {fuel : Nat}
    (run : BoundedRun respond current fuel) :
    NativeReachable current respond run.endState :=
  match run with
  | .terminal _ => .initial
  | .cutoff _ => .initial
  | .continued transition rest =>
      let nextArrival :
          NativeReachable current respond _ :=
        .step .initial transition.generated
      prependNativeReachable
        nextArrival rest.endNativeReachable

/-- The constructed endpoint reachability has exactly one step per
executed occurrence. -/
@[simp] theorem endNativeReachable_occurrence
    {respond :
      ∀ current : State,
        Option (Response Step current)}
    {current : State}
    {fuel : Nat}
    (run : BoundedRun respond current fuel) :
    run.endNativeReachable.occurrence = run.depth := by
  induction run with
  | terminal stopped => rfl
  | cutoff transition => rfl
  | @continued current next fuel transition rest ih =>
      let nextArrival : NativeReachable current respond next :=
        .step .initial transition.generated
      change
        (prependNativeReachable nextArrival
          rest.endNativeReachable).occurrence = rest.depth + 1
      rw [prependNativeReachable_occurrence]
      change
        1 + rest.endNativeReachable.occurrence =
          rest.depth + 1
      rw [ih]
      exact Nat.add_comm _ _

/-- Executed depth never exceeds the requested fuel. -/
@[simp] theorem depth_le_fuel
    {respond :
      ∀ current : State,
        Option (Response Step current)}
    {current : State}
    {fuel : Nat}
    (run : BoundedRun respond current fuel) :
    run.depth ≤ fuel := by
  induction run with
  | terminal stopped => simp [depth]
  | cutoff transition => simp [depth]
  | continued transition rest ih =>
      simpa [depth] using Nat.succ_le_succ ih

/-- Typed state of the last inspected current.

The terminal branch keeps its literal `none`.  The continued branch is a
live cutoff: it keeps the exact unexecuted next response and records that
all requested fuel was consumed. -/
inductive EndDisposition
    {respond :
      ∀ current : State,
        Option (Response Step current)}
    {current : State}
    {fuel : Nat}
    (run : BoundedRun respond current fuel) :
    Type (max uState uStep)
  | terminal
      (stopped :
        respond run.endState = none)
      (depth_le :
        run.depth ≤ fuel) :
      EndDisposition run
  | continued
      {next : State}
      (transition :
        NativeResponseStep respond run.endState next)
      (depth_eq :
        run.depth = fuel) :
      EndDisposition run

/-- Read the non-silent terminal-or-live-cutoff disposition from a bounded
run. -/
def endDisposition
    {respond :
      ∀ current : State,
        Option (Response Step current)}
    {current : State}
    {fuel : Nat}
    (run : BoundedRun respond current fuel) :
    EndDisposition run :=
  match run with
  | .terminal stopped =>
      .terminal stopped
        (by simp [depth])
  | .cutoff transition =>
      .continued transition rfl
  | .continued transition rest =>
      match rest.endDisposition with
      | .terminal stopped depthLe =>
          .terminal stopped
            (by
              change rest.depth + 1 ≤ _ + 1
              exact Nat.add_le_add_right depthLe 1)
      | .continued endpoint depthEq =>
          .continued endpoint
            (by
              change rest.depth + 1 = _ + 1
              exact congrArg (· + 1) depthEq)

end BoundedRun

end SourceGeneratedNativeBoundedRun
end SaturationMonoid
