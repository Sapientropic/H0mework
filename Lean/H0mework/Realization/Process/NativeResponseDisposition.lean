import Mathlib.Data.Option.Basic

/-!
# Least reachability and typed disposition for source-owned responses

Many source grammars expose a dependent one-step producer

```text
respond current : Option (Σ next, Step current next).
```

The `some` branch owns both the exact next current and the proof-relevant
step payload.  The `none` branch is an exact stopping fact at the same
current.  This module builds the least source-generated reachability graph
and exhausts every reachable current into one of those two typed outcomes.

The construction is deliberately local.  It does not assume or prove that
repeated response generation terminates, and it has no caller-supplied
target, route length, coverage family, nonzero witness, relation branch, or
terminal certificate.  A concrete domain may enrich the generated `none`
equality with its own typed terminal reason.  A domain with a genuine
relation boundary may put that distinction inside its concrete boundary
family; domains without one must not manufacture a third branch.

`NativeReachable.occurrence` counts actual successful source responses in
the proof-relevant arrival chain.  It is an event occurrence count, not a
carrier dimension or limiting parameter.
-/

namespace SaturationMonoid
namespace SourceGeneratedNativeResponseDisposition

universe uState uStep

variable {State : Type uState}
variable {Step : State → State → Type uStep}

/-- Exact dependent response payload generated at one current. -/
abbrev Response
    (Step : State → State → Type uStep)
    (current : State) :=
  Σ next : State, Step current next

variable (initial : State)
variable
  (respond :
    ∀ current : State, Option (Response Step current))

/-- Least closure of the source-owned response graph from one literal
initial current.

The step constructor accepts only an equality with the actual response
producer.  A bare edge payload is insufficient. -/
inductive NativeReachable :
    State → Type (max uState uStep)
  | initial :
      NativeReachable initial
  | step
      {current : State}
      (reachable : NativeReachable current)
      {response : Response Step current}
      (generated :
        respond current = some response) :
      NativeReachable response.1

namespace NativeReachable

/-- Number of successful source responses in the exact arrival chain. -/
def occurrence :
    {current : State} →
      NativeReachable initial respond current → Nat
  | _, .initial => 0
  | _, .step reachable _ =>
      occurrence reachable + 1

/-- A seed whose own response is terminal has no distinct reachable current.
This is an endpoint theorem, not a global termination claim. -/
theorem eq_initial_of_respond_eq_none
    (stopped : respond initial = none)
    {current : State}
    (reachable : NativeReachable initial respond current) :
    current = initial := by
  induction reachable with
  | initial =>
      rfl
  | @step prior response reachable generated inductionHypothesis =>
      subst prior
      rw [stopped] at generated
      contradiction

end NativeReachable

/-- Exhaustive source-owned outcome at one reachable current.

Both constructors retain the arrival chain.  The continued branch also
retains the literal dependent response and its producer equality.  The
exact next reachability is therefore reconstructed only as
`NativeReachable.step arrival generated`; it is not a separately selectable
field.  The terminal branch retains the literal `none` equality at the same
current. -/
inductive ReachableDisposition
    (current : State) :
    Type (max uState uStep)
  | continued
      (arrival :
        NativeReachable initial respond current)
      (response : Response Step current)
      (generated :
        respond current = some response) :
      ReachableDisposition current
  | terminal
      (arrival :
        NativeReachable initial respond current)
      (stopped : respond current = none) :
      ReachableDisposition current

/-- Every reachable current is exhausted by its source-owned response.

No target or terminal witness is supplied to this definition; both are
generated by case analysis on `respond current`. -/
def NativeReachable.disposition
    {current : State}
    (reachable :
      NativeReachable initial respond current) :
    ReachableDisposition initial respond current := by
  cases generated : respond current with
  | none =>
      exact .terminal reachable generated
  | some response =>
      exact
        .continued reachable response generated

namespace ReachableDisposition

/-- Recover the exact reachable arrival chain retained by either outcome. -/
def arrival
    {current : State} :
    ReachableDisposition initial respond current →
      NativeReachable initial respond current
  | .continued arrival _ _ => arrival
  | .terminal arrival _ => arrival

/-- Occurrence number of the current whose response was exhausted. -/
def occurrence
    {current : State}
    (disposition :
      ReachableDisposition initial respond current) : Nat :=
  disposition.arrival.occurrence

/-- Reconstruct the exact generated next reachability from a continued
outcome.  There is no independently selectable next-arrival proof. -/
def generatedNext?
    {current : State}
    (disposition :
      ReachableDisposition initial respond current) :
    Option
      (Σ response : Response Step current,
        NativeReachable initial respond response.1) :=
  match disposition with
  | .continued arrival response generated =>
      some ⟨response, .step arrival generated⟩
  | .terminal _ _ => none

end ReachableDisposition

end SourceGeneratedNativeResponseDisposition
end SaturationMonoid
