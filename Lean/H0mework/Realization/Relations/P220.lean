import H0mework.Realization.Relations.P219
import Mathlib.Probability.StrongLaw

/-!
# Proposition 220: strong-law producers for finite-grid P170 certificates

P219 made the finite-mixture → continuous-gamma bridge reusable, but it still
accepted convergence as an external certificate.  This file connects one real
producer theorem to that facade: Mathlib's strong law of large numbers.

The result is intentionally finite-grid.  For each observation time in a
finite grid, the empirical Laplace average of iid/pairwise-independent rate
samples converges almost surely to its expectation; if that expectation is the
normalized gamma Laplace value, then almost every sample path produces a P219
canonical finite-grid bridge certificate, and hence shifted-power convergence.

Boundary: this is not a formal gamma-distribution sampler, deterministic
quadrature theorem, order-statistics theorem, or runtime mechanism-faithfulness
proof.  It proves the LLN-to-certificate bridge once the per-time integrability,
independence, identical-distribution, and expectation-identity obligations are
supplied.
-/

namespace FiniteGammaBridgeCertificate

open Filter MeasureTheory ProbabilityTheory
open scoped BigOperators Topology ProbabilityTheory

noncomputable section

/-! ## Empirical Laplace averages -/

/-- Empirical average used by the strong-law producer. -/
def empiricalAverage {Ω : Type*} (X : ℕ → Ω → ℝ) (N : ℕ) (ω : Ω) : ℝ :=
  (∑ i ∈ Finset.range N, X i ω) / (N : ℝ)

/-- The Laplace test variable generated by a sampled rate path. -/
def laplaceTest {Ω : Type*}
    (sampleRate : ℕ → Ω → ℝ) (time : ℝ) (i : ℕ) (ω : Ω) : ℝ :=
  Real.exp (-(sampleRate i ω) * time)

/-! ## Strong-law bridge to gamma convergence -/

/-- THEOREM 1: on a finite observation grid, iid/pairwise-independent Laplace
tests whose expectation is the normalized gamma Laplace target produce almost
sure pointwise convergence to the gamma target.

The finite-grid restriction is the important guardrail: we may intersect the
almost-sure events for finitely/countably many listed times, but this theorem
does not claim simultaneous convergence for every real time.
-/
theorem finiteGrid_laplace_empirical_tendsto_gamma_ae
    {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    {grid : FiniteObservationGrid}
    (sampleRate : ℕ → Ω → ℝ)
    {shape gammaRate : ℝ}
    (_hshape : 0 < shape) (_hrate : 0 < gammaRate)
    (hint : ∀ τ : grid.Time,
      Integrable (laplaceTest sampleRate (grid.time τ) 0) μ)
    (hindep : ∀ τ : grid.Time,
      Pairwise (fun i j : ℕ =>
        laplaceTest sampleRate (grid.time τ) i ⟂ᵢ[μ]
          laplaceTest sampleRate (grid.time τ) j))
    (hident : ∀ τ : grid.Time, ∀ i : ℕ,
      IdentDistrib
        (laplaceTest sampleRate (grid.time τ) i)
        (laplaceTest sampleRate (grid.time τ) 0) μ μ)
    (hexpect : ∀ τ : grid.Time,
      μ[laplaceTest sampleRate (grid.time τ) 0] =
        GammaMixtureForgetting.normalizedGammaLaplace
          shape gammaRate (grid.time τ)) :
    ∀ᵐ ω ∂μ, ∀ τ : grid.Time,
      Tendsto
        (fun N : ℕ =>
          empiricalAverage
            (fun i : ℕ => laplaceTest sampleRate (grid.time τ) i) N ω)
        atTop
        (𝓝 (GammaMixtureForgetting.normalizedGammaLaplace
          shape gammaRate (grid.time τ))) := by
  classical
  have hpoint : ∀ τ : grid.Time, ∀ᵐ ω ∂μ,
      Tendsto
        (fun N : ℕ =>
          empiricalAverage
            (fun i : ℕ => laplaceTest sampleRate (grid.time τ) i) N ω)
        atTop
        (𝓝 (GammaMixtureForgetting.normalizedGammaLaplace
          shape gammaRate (grid.time τ))) := by
    intro τ
    have hslln :=
      ProbabilityTheory.strong_law_ae_real
        (fun i : ℕ => laplaceTest sampleRate (grid.time τ) i)
        (hint τ) (hindep τ) (hident τ)
    filter_upwards [hslln] with ω hω
    simpa [empiricalAverage, hexpect τ] using hω
  exact ae_all_iff.2 hpoint

/-- Compile one almost-sure sample path into P219's canonical finite-grid
bridge certificate. -/
def CanonicalFiniteGridGammaBridgeCertificate.ofEmpiricalStrongLawPath
    {Ω : Type*} {grid : FiniteObservationGrid}
    (sampleRate : ℕ → Ω → ℝ)
    {shape gammaRate : ℝ}
    (hshape : 0 < shape) (hrate : 0 < gammaRate)
    (ω : Ω)
    (hconv : ∀ τ : grid.Time,
      Tendsto
        (fun N : ℕ =>
          empiricalAverage
            (fun i : ℕ => laplaceTest sampleRate (grid.time τ) i) N ω)
        atTop
        (𝓝 (GammaMixtureForgetting.normalizedGammaLaplace
          shape gammaRate (grid.time τ)))) :
    CanonicalFiniteGridGammaBridgeCertificate grid where
  mixture := fun N τ =>
    empiricalAverage
      (fun i : ℕ => laplaceTest sampleRate (grid.time τ) i) N ω
  shape := shape
  gammaRate := gammaRate
  shape_pos := hshape
  gammaRate_pos := hrate
  tendsToGamma := hconv

/-- THEOREM 2: almost every sample path yields a canonical finite-grid bridge
certificate with exactly the empirical Laplace averages as its mixture. -/
theorem finiteGrid_laplace_empirical_canonicalBridge_ae
    {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    {grid : FiniteObservationGrid}
    (sampleRate : ℕ → Ω → ℝ)
    {shape gammaRate : ℝ}
    (hshape : 0 < shape) (hrate : 0 < gammaRate)
    (hint : ∀ τ : grid.Time,
      Integrable (laplaceTest sampleRate (grid.time τ) 0) μ)
    (hindep : ∀ τ : grid.Time,
      Pairwise (fun i j : ℕ =>
        laplaceTest sampleRate (grid.time τ) i ⟂ᵢ[μ]
          laplaceTest sampleRate (grid.time τ) j))
    (hident : ∀ τ : grid.Time, ∀ i : ℕ,
      IdentDistrib
        (laplaceTest sampleRate (grid.time τ) i)
        (laplaceTest sampleRate (grid.time τ) 0) μ μ)
    (hexpect : ∀ τ : grid.Time,
      μ[laplaceTest sampleRate (grid.time τ) 0] =
        GammaMixtureForgetting.normalizedGammaLaplace
          shape gammaRate (grid.time τ)) :
    ∀ᵐ ω ∂μ, ∃ cert : CanonicalFiniteGridGammaBridgeCertificate grid,
      ∀ (N : ℕ) (τ : grid.Time),
        cert.mixture N τ =
          empiricalAverage
            (fun i : ℕ => laplaceTest sampleRate (grid.time τ) i) N ω := by
  filter_upwards [
      finiteGrid_laplace_empirical_tendsto_gamma_ae
        sampleRate hshape hrate hint hindep hident hexpect] with ω hω
  refine ⟨
    CanonicalFiniteGridGammaBridgeCertificate.ofEmpiricalStrongLawPath
      sampleRate hshape hrate ω hω, ?_⟩
  intro N τ
  rfl

/-- THEOREM 3: by composing the strong-law bridge with P219/P147, almost every
sample path converges at every listed grid time to the shifted-power target. -/
theorem finiteGrid_laplace_empirical_tendsto_shiftedPower_ae
    {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    {grid : FiniteObservationGrid}
    (sampleRate : ℕ → Ω → ℝ)
    {shape gammaRate : ℝ}
    (hshape : 0 < shape) (hrate : 0 < gammaRate)
    (hint : ∀ τ : grid.Time,
      Integrable (laplaceTest sampleRate (grid.time τ) 0) μ)
    (hindep : ∀ τ : grid.Time,
      Pairwise (fun i j : ℕ =>
        laplaceTest sampleRate (grid.time τ) i ⟂ᵢ[μ]
          laplaceTest sampleRate (grid.time τ) j))
    (hident : ∀ τ : grid.Time, ∀ i : ℕ,
      IdentDistrib
        (laplaceTest sampleRate (grid.time τ) i)
        (laplaceTest sampleRate (grid.time τ) 0) μ μ)
    (hexpect : ∀ τ : grid.Time,
      μ[laplaceTest sampleRate (grid.time τ) 0] =
        GammaMixtureForgetting.normalizedGammaLaplace
          shape gammaRate (grid.time τ)) :
    ∀ᵐ ω ∂μ, ∀ τ : grid.Time,
      Tendsto
        (fun N : ℕ =>
          empiricalAverage
            (fun i : ℕ => laplaceTest sampleRate (grid.time τ) i) N ω)
        atTop
        (𝓝 ((1 + grid.time τ / gammaRate) ^ (-shape))) := by
  filter_upwards [
      finiteGrid_laplace_empirical_tendsto_gamma_ae
        sampleRate hshape hrate hint hindep hident hexpect] with ω hω τ
  exact canonicalFiniteGridGammaBridge_tendsto_shiftedPower
    (CanonicalFiniteGridGammaBridgeCertificate.ofEmpiricalStrongLawPath
      sampleRate hshape hrate ω hω) τ

/-!
  Summary:
  - P220 is the first producer-side theorem for P219: a finite family of
    strong-law obligations generates a canonical finite-grid gamma bridge.
  - P219 then transports that bridge to shifted-power convergence.

  Still outside this theorem:
  - a formal gamma distribution whose Laplace expectation is the P147 target;
  - uncountable all-time simultaneous convergence;
  - deterministic quadrature / order-statistics;
  - empirical parameter estimation or runtime mechanism-faithfulness.
-/


end

end FiniteGammaBridgeCertificate
