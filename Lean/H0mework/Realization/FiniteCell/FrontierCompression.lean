/-!
# Canonical finite-frontier perfect compression

The canonical all-elements relation presentation does not contain a
source-owned enumeration, and a place-fuel diagram does not secretly provide
one.  This kernel therefore indexes the source directly by its intrinsic
lattice of finite sets of actual graded atoms.  A stage is chosen only by the
generic residual settlement; no domain caller supplies an enumeration,
finite envelope, candidate complex, quasi-isomorphism, basis, or matrix.

For one finite graded frontier the engine builds the finite free module on
its atoms.  Its differential is the canonical lift of the actual
differential: a basis atom is sent to the basis atom of its nonzero image
when that image occurs in the same frontier.  The framework calculates the
coverage condition, `d² = 0`, the evaluation chain map, and later the
kernel-resolution mapping cone.  Global adequacy remains a derived
mapping-cofiber residual, never degreewise coverage of the actual carrier.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace CanonicalFiniteFrontierCompression

open CategoryTheory
open CategoryTheory.Limits
open DerivedAdicCofiber
open DerivedCofinalSettlement

noncomputable section

universe w

attribute [local instance] HasDerivedCategory.standard

private def intLinearMapOfAddMonoidHom
    {M N : Type*} [AddCommGroup M] [AddCommGroup N]
    {moduleM : Module ℤ M} {moduleN : Module ℤ N}
    (hom : M →+ N) : M →ₗ[ℤ] N where
  toFun := hom
  map_add' := hom.map_add
  map_smul' scalar value := by
    convert! hom.map_zsmul scalar value using 1
    · exact congr(hom $(int_smul_eq_zsmul ..))
    · exact int_smul_eq_zsmul ..

/-- One actual element in one degree of the same cochain complex. -/
structure ActualCochainAtomAt (complex : IntegralCochainComplex ℤ) where
  degree : ℤ
  value : complex.X degree

/-- Intrinsic finite frontier of the canonical all-elements family. -/
abbrev CanonicalFiniteFrontierAt (complex : IntegralCochainComplex ℤ) :=
  Finset (ActualCochainAtomAt complex)

/-- Generators visible in one degree of one finite frontier. -/
abbrev StageGeneratorAt {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex) (degree : ℤ) :=
  { atom : ↥frontier // atom.1.degree = degree }

namespace StageGeneratorAt

variable {complex : IntegralCochainComplex ℤ}
variable {frontier : CanonicalFiniteFrontierAt complex}
variable {degree : ℤ}

def actualAtom (generator : StageGeneratorAt frontier degree) :
    ActualCochainAtomAt complex :=
  generator.1.1

def actualValue (generator : StageGeneratorAt frontier degree) :
    complex.X degree :=
  _root_.cast
    (congrArg (fun currentDegree => (complex.X currentDegree : Type))
      generator.property)
    generator.actualAtom.value

@[simp] theorem actualValue_mk
    (value : complex.X degree)
    (membership : (⟨degree, value⟩ : ActualCochainAtomAt complex) ∈ frontier) :
    actualValue
      (⟨⟨⟨degree, value⟩, membership⟩, rfl⟩ :
        StageGeneratorAt frontier degree) = value :=
  rfl

end StageGeneratorAt

/-- Finite free module generated by the degree frontier. -/
abbrev StageFreeModuleAt {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex) (degree : ℤ) :=
  StageGeneratorAt frontier degree →₀ ℤ

/-- Evaluate the finite free stage in the actual carrier. -/
def stageEvaluation
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex) (degree : ℤ) :
    StageFreeModuleAt frontier degree →ₗ[ℤ] complex.X degree :=
  intLinearMapOfAddMonoidHom
    (Finsupp.liftAddHom fun
      (generator : StageGeneratorAt frontier degree) =>
      AddMonoidHom.flip (smulAddHom ℤ (complex.X degree))
        (StageGeneratorAt.actualValue generator))

@[simp] theorem stageEvaluation_single_one
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex) (degree : ℤ)
    (generator : StageGeneratorAt frontier degree) :
    stageEvaluation frontier degree (Finsupp.single generator 1) =
      StageGeneratorAt.actualValue generator := by
  simp [stageEvaluation, intLinearMapOfAddMonoidHom]
  exact @one_smul ℤ (complex.X degree) _
    (complex.X degree).isModule.toDistribMulAction.toMulAction
    (StageGeneratorAt.actualValue generator)

/-- Image of one basis atom under the canonical lifted differential.  A
missing nonzero image is recorded by the later coverage residual rather than
silently becoming a premise. -/
def basisDifferential
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (source target : ℤ) (generator : StageGeneratorAt frontier source) :
    StageFreeModuleAt frontier target := by
  classical
  if related : (ComplexShape.up ℤ).Rel source target then
    let image := complex.d source target
      (StageGeneratorAt.actualValue generator)
    if imageZero : image = 0 then
      exact 0
    else
      let atom : ActualCochainAtomAt complex := ⟨target, image⟩
      if membership : atom ∈ frontier then
        exact Finsupp.single ⟨⟨atom, membership⟩, rfl⟩ 1
      else
        exact 0
  else
    exact 0

/-- Linear extension of the canonical basis differential. -/
def stageDifferential
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (source target : ℤ) :
    StageFreeModuleAt frontier source →ₗ[ℤ]
      StageFreeModuleAt frontier target :=
  (Finsupp.liftAddHom fun generator =>
    AddMonoidHom.flip (smulAddHom ℤ (StageFreeModuleAt frontier target))
      (basisDifferential frontier source target generator)).toIntLinearMap

@[simp] theorem stageDifferential_single
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (source target : ℤ) (generator : StageGeneratorAt frontier source)
    (coefficient : ℤ) :
    stageDifferential frontier source target
        (Finsupp.single generator coefficient) =
      coefficient • basisDifferential frontier source target generator := by
  simp [stageDifferential]

theorem stageDifferential_eq_zero
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (source target : ℤ) (notRelated : ¬ (ComplexShape.up ℤ).Rel source target) :
    stageDifferential frontier source target = 0 := by
  change ¬ source + 1 = target at notRelated
  apply LinearMap.ext
  intro value
  induction value using Finsupp.induction_linear with
  | zero => simp
  | add left right left_ih right_ih => simp [left_ih, right_ih]
  | single generator coefficient =>
      simp [stageDifferential_single, basisDifferential, notRelated]

/-- Exact finite-frontier coverage needed only for the evaluation maps to
form a chain map.  It does not assert that the frontier covers an entire
degree carrier. -/
def DifferentialCoveredAt
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex) : Prop :=
  ∀ source target (_related : (ComplexShape.up ℤ).Rel source target)
    (generator : StageGeneratorAt frontier source),
    let image := complex.d source target
      (StageGeneratorAt.actualValue generator)
    image ≠ 0 →
      (⟨target, image⟩ : ActualCochainAtomAt complex) ∈ frontier

structure GeneratedDifferentialCoverageAt
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex) : Type where
  private mk ::
  covered : DifferentialCoveredAt frontier

structure GeneratedDifferentialCoverageObstructionAt
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex) : Type where
  private mk ::
  notCovered : ¬ DifferentialCoveredAt frontier

abbrev DifferentialCoverageOutcome
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex) :=
  Sum (GeneratedDifferentialCoverageAt frontier)
    (GeneratedDifferentialCoverageObstructionAt frontier)

noncomputable def settleDifferentialCoverage
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex) :
    DifferentialCoverageOutcome frontier := by
  classical
  by_cases covered : DifferentialCoveredAt frontier
  · exact Sum.inl ⟨covered⟩
  · exact Sum.inr ⟨covered⟩

theorem stageEvaluation_naturality
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (coverage : GeneratedDifferentialCoverageAt frontier)
    (source target : ℤ) :
    (complex.d source target).hom.comp (stageEvaluation frontier source) =
      (stageEvaluation frontier target).comp
        (stageDifferential frontier source target) := by
  ext generator
  by_cases related : (ComplexShape.up ℤ).Rel source target
  · change source + 1 = target at related
    let image := complex.d source target
      (StageGeneratorAt.actualValue generator)
    by_cases imageZero : image = 0
    · simp [stageDifferential_single, basisDifferential, related,
        image, imageZero]
    · have membership := coverage.covered source target related generator
        imageZero
      simp [stageDifferential_single, basisDifferential, related,
        image, imageZero, membership]
  · change ¬ source + 1 = target at related
    simp [stageDifferential_single, basisDifferential, related]

theorem stageDifferential_comp_zero
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (source middle target : ℤ) :
    (stageDifferential frontier middle target).comp
        (stageDifferential frontier source middle) = 0 := by
  by_cases sourceMiddle : (ComplexShape.up ℤ).Rel source middle
  · by_cases middleTarget : (ComplexShape.up ℤ).Rel middle target
    · change source + 1 = middle at sourceMiddle
      change middle + 1 = target at middleTarget
      apply LinearMap.ext
      intro value
      induction value using Finsupp.induction_linear with
      | zero => simp
      | add left right left_ih right_ih =>
          change stageDifferential frontier middle target
              (stageDifferential frontier source middle left) = 0 at left_ih
          change stageDifferential frontier middle target
              (stageDifferential frontier source middle right) = 0 at right_ih
          simp only [LinearMap.comp_apply, map_add, left_ih, right_ih,
            add_zero, LinearMap.zero_apply]
      | single generator coefficient =>
          let firstImage := complex.d source middle
            (StageGeneratorAt.actualValue generator)
          by_cases firstZero : firstImage = 0
          · simp [stageDifferential_single, basisDifferential,
              sourceMiddle, firstImage, firstZero]
          · let imageAtom : ActualCochainAtomAt complex :=
              ⟨middle, firstImage⟩
            by_cases membership : imageAtom ∈ frontier
            · have actualZero := ConcreteCategory.congr_hom
                (complex.d_comp_d source middle target)
                (StageGeneratorAt.actualValue generator)
              change complex.d middle target firstImage = 0 at actualZero
              simp [stageDifferential_single, basisDifferential,
                sourceMiddle, middleTarget, firstImage, firstZero,
                imageAtom, membership, actualZero]
            · simp [stageDifferential_single, basisDifferential,
                sourceMiddle, firstImage, firstZero, imageAtom, membership]
    · rw [stageDifferential_eq_zero frontier middle target middleTarget]
      simp
  · rw [stageDifferential_eq_zero frontier source middle sourceMiddle]
    simp

/-- Finite-free complex generated by one canonical finite frontier. -/
noncomputable def stageFreeComplex
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex) :
    IntegralCochainComplex ℤ where
  X degree := ModuleCat.of ℤ (StageFreeModuleAt frontier degree)
  d source target := ModuleCat.ofHom
    (stageDifferential frontier source target)
  shape source target notRelated := by
    apply ModuleCat.hom_ext
    exact stageDifferential_eq_zero frontier source target notRelated
  d_comp_d' source middle target sourceMiddle middleTarget := by
    apply ModuleCat.hom_ext
    exact stageDifferential_comp_zero frontier source middle target

/-- Evaluation of the finite-free complex into the actual complex. -/
noncomputable def stageEvaluationMap
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (coverage : GeneratedDifferentialCoverageAt frontier) :
    stageFreeComplex frontier ⟶ complex where
  f degree := ModuleCat.ofHom (stageEvaluation frontier degree)
  comm' source target _ := by
    apply ModuleCat.hom_ext
    change (complex.d source target).hom.comp
        (stageEvaluation frontier source) =
      (stageEvaluation frontier target).comp
        (stageDifferential frontier source target)
    exact stageEvaluation_naturality frontier coverage source target

/-- Relation term of the finite presentation in one degree.  It is the
actual kernel of evaluation, not a caller-supplied relation list. -/
abbrev StageKernelAt
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex) (degree : ℤ) :=
  LinearMap.ker (stageEvaluation frontier degree)

def kernelDifferential
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (coverage : GeneratedDifferentialCoverageAt frontier)
    (source target : ℤ) :
    StageKernelAt frontier source →ₗ[ℤ]
      StageKernelAt frontier target :=
  LinearMap.codRestrict _
    ((stageDifferential frontier source target).comp
      (LinearMap.ker (stageEvaluation frontier source)).subtype)
    (fun relation => by
      rw [LinearMap.mem_ker]
      have naturality := LinearMap.congr_fun
        (stageEvaluation_naturality frontier coverage source target)
        relation.1
      change complex.d source target
          (stageEvaluation frontier source relation.1) =
        stageEvaluation frontier target
          (stageDifferential frontier source target relation.1) at naturality
      rw [show stageEvaluation frontier source relation.1 = 0 from
        relation.property] at naturality
      simpa using naturality.symm)

@[simp] theorem kernelDifferential_coe
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (coverage : GeneratedDifferentialCoverageAt frontier)
    (source target : ℤ) (relation : StageKernelAt frontier source) :
    ((kernelDifferential frontier coverage source target relation :
        StageKernelAt frontier target) : StageFreeModuleAt frontier target) =
      stageDifferential frontier source target relation.1 :=
  rfl

theorem kernelDifferential_eq_zero
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (coverage : GeneratedDifferentialCoverageAt frontier)
    (source target : ℤ) (notRelated : ¬ (ComplexShape.up ℤ).Rel source target) :
    kernelDifferential frontier coverage source target = 0 := by
  apply LinearMap.ext
  intro relation
  apply Subtype.ext
  simp [kernelDifferential_coe,
    stageDifferential_eq_zero frontier source target notRelated]

theorem kernelDifferential_comp_zero
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (coverage : GeneratedDifferentialCoverageAt frontier)
    (source middle target : ℤ) :
    (kernelDifferential frontier coverage middle target).comp
        (kernelDifferential frontier coverage source middle) = 0 := by
  apply LinearMap.ext
  intro relation
  apply Subtype.ext
  change stageDifferential frontier middle target
      (stageDifferential frontier source middle relation.1) = 0
  exact LinearMap.congr_fun
    (stageDifferential_comp_zero frontier source middle target) relation.1

/-- Kernel terms inherit a strict cochain complex. -/
noncomputable def stageKernelComplex
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (coverage : GeneratedDifferentialCoverageAt frontier) :
    IntegralCochainComplex ℤ where
  X degree := ModuleCat.of ℤ (StageKernelAt frontier degree)
  d source target := ModuleCat.ofHom
    (kernelDifferential frontier coverage source target)
  shape source target notRelated := by
    apply ModuleCat.hom_ext
    exact kernelDifferential_eq_zero frontier coverage
      source target notRelated
  d_comp_d' source middle target sourceMiddle middleTarget := by
    apply ModuleCat.hom_ext
    exact kernelDifferential_comp_zero frontier coverage
      source middle target

/-- Inclusion of generated relations into the finite free generator
complex. -/
noncomputable def stageKernelInclusion
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (coverage : GeneratedDifferentialCoverageAt frontier) :
    stageKernelComplex frontier coverage ⟶ stageFreeComplex frontier where
  f degree := ModuleCat.ofHom
    (LinearMap.ker (stageEvaluation frontier degree)).subtype
  comm' source target _ := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro relation
    rfl

theorem stageKernelInclusion_comp_evaluation
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (coverage : GeneratedDifferentialCoverageAt frontier) :
    stageKernelInclusion frontier coverage ≫
      stageEvaluationMap frontier coverage = 0 := by
  ext degree relation
  exact relation.property

/-- The finite-projective candidate is the mapping cone of the generated
relation-complex inclusion. -/
noncomputable def finitePerfectCandidate
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (coverage : GeneratedDifferentialCoverageAt frontier) :
    IntegralCochainComplex ℤ :=
  CochainComplex.mappingCone (stageKernelInclusion frontier coverage)

/-- Generated candidate-to-actual chain map.  The relation coordinate is
zero because it is the actual evaluation kernel. -/
noncomputable def finitePerfectCandidateMap
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (coverage : GeneratedDifferentialCoverageAt frontier) :
    finitePerfectCandidate frontier coverage ⟶ complex :=
  CochainComplex.mappingCone.desc
    (stageKernelInclusion frontier coverage)
    0 (stageEvaluationMap frontier coverage) (by
      rw [stageKernelInclusion_comp_evaluation]
      simp)

/-! ## Generated finite-free and bounded receipts -/

private noncomputable def stageFreeBasis
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex) (degree : ℤ) :
    Module.Basis (StageGeneratorAt frontier degree) ℤ
      (StageFreeModuleAt frontier degree) :=
  Finsupp.basisSingleOne

private noncomputable def stageKernelBasis
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex) (degree : ℤ) :
    Σ rank : ℕ, Module.Basis (Fin rank) ℤ
      (StageKernelAt frontier degree) :=
  Submodule.basisOfPid (stageFreeBasis frontier degree)
    (LinearMap.ker (stageEvaluation frontier degree))

private noncomputable def candidateDegreeIso
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (coverage : GeneratedDifferentialCoverageAt frontier)
    (degree : ℤ) :
    (finitePerfectCandidate frontier coverage).X degree ≅
      ModuleCat.of ℤ
        (StageKernelAt frontier (degree + 1) ×
          StageFreeModuleAt frontier degree) :=
  HomologicalComplex.homotopyCofiber.XIsoBiprod
      (stageKernelInclusion frontier coverage) degree (degree + 1) rfl ≪≫
    ModuleCat.biprodIsoProd _ _

/-- Public, basis-free term decomposition of the generated mapping-cone
candidate.  It exposes only the actual kernel/free presentation already used
to prove finite perfectness. -/
noncomputable def candidateDegreePresentationLinearEquiv
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (coverage : GeneratedDifferentialCoverageAt frontier)
    (degree : ℤ) :
    (finitePerfectCandidate frontier coverage).X degree ≃ₗ[ℤ]
      (StageKernelAt frontier (degree + 1) ×
        StageFreeModuleAt frontier degree) :=
  (candidateDegreeIso frontier coverage degree).toLinearEquiv

private theorem biprodIsoProd_hom_snd_apply
    (left right : ModuleCat.{0} ℤ) (value : (left ⊞ right : ModuleCat ℤ)) :
    ((ModuleCat.biprodIsoProd left right).toLinearEquiv value).2 =
      (biprod.snd : (left ⊞ right : ModuleCat ℤ) ⟶ right).hom value := by
  have comparison := ModuleCat.biprodIsoProd_inv_comp_snd_apply left right
    ((ModuleCat.biprodIsoProd left right).hom.hom value)
  have back :
      (ModuleCat.biprodIsoProd left right).inv.hom
          ((ModuleCat.biprodIsoProd left right).hom.hom value) = value :=
    ConcreteCategory.congr_hom
      (ModuleCat.biprodIsoProd left right).hom_inv_id value
  exact comparison.symm.trans
    (congrArg (biprod.snd : (left ⊞ right : ModuleCat ℤ) ⟶ right).hom back)

private theorem stage_sndX_eq_XIsoBiprod_snd
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (coverage : GeneratedDifferentialCoverageAt frontier)
    (degree target : ℤ)
    (relation : (ComplexShape.up ℤ).Rel degree target) :
    HomologicalComplex.homotopyCofiber.sndX
        (stageKernelInclusion frontier coverage) degree =
      (HomologicalComplex.homotopyCofiber.XIsoBiprod
          (stageKernelInclusion frontier coverage) degree target relation).hom ≫
        biprod.snd := by
  have next_eq := (ComplexShape.up ℤ).next_eq' relation
  have nextRel : (ComplexShape.up ℤ).Rel degree
      ((ComplexShape.up ℤ).next degree) := by
    rw [next_eq]
    exact relation
  unfold HomologicalComplex.homotopyCofiber.sndX
  rw [dif_pos nextRel]
  obtain rfl := next_eq
  rfl

/-- The free coordinate of the public mapping-cone presentation is exactly
the canonical right projection already consumed by the candidate-to-actual
map.  This commuting law prevents downstream domains from reopening the
private mapping-cone representation. -/
@[simp] theorem candidateDegreePresentationLinearEquiv_snd
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (coverage : GeneratedDifferentialCoverageAt frontier)
    (degree : ℤ)
    (value : (finitePerfectCandidate frontier coverage).X degree) :
    (candidateDegreePresentationLinearEquiv
        frontier coverage degree value).2 =
      ((CochainComplex.mappingCone.snd
        (stageKernelInclusion frontier coverage)).v
          degree degree (add_zero degree)).hom value := by
  let relation : (ComplexShape.up ℤ).Rel degree (degree + 1) :=
    ComplexShape.up_mk degree (degree + 1) rfl
  let xIso := HomologicalComplex.homotopyCofiber.XIsoBiprod
    (stageKernelInclusion frontier coverage) degree (degree + 1) relation
  change ((ModuleCat.biprodIsoProd
      ((stageKernelComplex frontier coverage).X (degree + 1))
      ((stageFreeComplex frontier).X degree)).toLinearEquiv
        (xIso.toLinearEquiv value)).2 = _
  rw [biprodIsoProd_hom_snd_apply]
  change _ =
    (HomologicalComplex.homotopyCofiber.sndX
      (stageKernelInclusion frontier coverage) degree).hom value
  rw [stage_sndX_eq_XIsoBiprod_snd
    frontier coverage degree (degree + 1) relation]
  rfl

/-- Basis of every candidate term, generated from the finite atom basis and
the PID kernel basis. -/
private noncomputable def candidateDegreeBasis
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (coverage : GeneratedDifferentialCoverageAt frontier)
    (degree : ℤ) :
    Module.Basis
      (Fin (stageKernelBasis frontier (degree + 1)).1 ⊕
        StageGeneratorAt frontier degree)
      ℤ ((finitePerfectCandidate frontier coverage).X degree) :=
  ((stageKernelBasis frontier (degree + 1)).2.prod
      (stageFreeBasis frontier degree)).map
    (candidateDegreeIso frontier coverage degree).toLinearEquiv.symm

theorem candidateTermFree
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (coverage : GeneratedDifferentialCoverageAt frontier)
    (degree : ℤ) :
    Module.Free ℤ ((finitePerfectCandidate frontier coverage).X degree) :=
  Module.Free.of_basis (candidateDegreeBasis frontier coverage degree)

theorem candidateTermFinite
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (coverage : GeneratedDifferentialCoverageAt frontier)
    (degree : ℤ) :
    Module.Finite ℤ ((finitePerfectCandidate frontier coverage).X degree) := by
  letI : Fintype (StageGeneratorAt frontier degree) := Fintype.ofFinite _
  exact Module.Finite.of_basis
    (candidateDegreeBasis frontier coverage degree)

noncomputable def frontierDegreeSupport
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex) : Finset ℤ := by
  classical
  exact frontier.image ActualCochainAtomAt.degree

/-- The mapping cone shifts the kernel row once, so its support is contained
in the frontier degrees and their predecessors. -/
noncomputable def candidateDegreeSupport
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex) : Finset ℤ := by
  classical
  exact frontierDegreeSupport frontier ∪
    (frontierDegreeSupport frontier).image (fun degree => degree - 1)

theorem stageGenerator_empty_of_degree_not_mem
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex) (degree : ℤ)
    (degree_not_mem : degree ∉ frontierDegreeSupport frontier)
    (generator : StageGeneratorAt frontier degree) : False := by
  apply degree_not_mem
  apply Finset.mem_image.mpr
  exact ⟨generator.actualAtom, generator.1.property, generator.property⟩

theorem stageFreeModule_subsingleton_of_degree_not_mem
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex) (degree : ℤ)
    (degree_not_mem : degree ∉ frontierDegreeSupport frontier) :
    Subsingleton (StageFreeModuleAt frontier degree) := by
  constructor
  intro left right
  apply Finsupp.ext
  intro generator
  exact False.elim
    (stageGenerator_empty_of_degree_not_mem frontier degree
      degree_not_mem generator)

theorem stageKernel_subsingleton_of_degree_not_mem
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex) (degree : ℤ)
    (degree_not_mem : degree ∉ frontierDegreeSupport frontier) :
    Subsingleton (StageKernelAt frontier degree) := by
  let _ : Subsingleton (StageFreeModuleAt frontier degree) :=
    stageFreeModule_subsingleton_of_degree_not_mem frontier degree
      degree_not_mem
  exact inferInstance

theorem candidateTerm_isZero_outside_support
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (coverage : GeneratedDifferentialCoverageAt frontier)
    (degree : ℤ) (degree_not_mem :
      degree ∉ candidateDegreeSupport frontier) :
    IsZero ((finitePerfectCandidate frontier coverage).X degree) := by
  classical
  have degree_not_frontier : degree ∉ frontierDegreeSupport frontier := by
    intro degree_mem
    apply degree_not_mem
    exact Finset.mem_union_left _ degree_mem
  have next_not_frontier :
      degree + 1 ∉ frontierDegreeSupport frontier := by
    intro next_mem
    apply degree_not_mem
    apply Finset.mem_union_right
    apply Finset.mem_image.mpr
    exact ⟨degree + 1, next_mem, by omega⟩
  apply (CochainComplex.mappingCone.isZero_X_iff
    (stageKernelInclusion frontier coverage) degree).2
  constructor
  · exact ModuleCat.isZero_iff_subsingleton.mpr
      (stageKernel_subsingleton_of_degree_not_mem frontier (degree + 1)
        next_not_frontier)
  · exact ModuleCat.isZero_iff_subsingleton.mpr
      (stageFreeModule_subsingleton_of_degree_not_mem frontier degree
        degree_not_frontier)

/-- Basis-free bounded-perfect predicate used by the determinant consumer. -/
def IsBoundedFiniteFree (complex : IntegralCochainComplex ℤ) : Prop :=
  ∃ degreeSupport : Finset ℤ,
    (∀ degree, degree ∉ degreeSupport → IsZero (complex.X degree)) ∧
      (∀ degree, Module.Free ℤ (complex.X degree) ∧
        Module.Finite ℤ (complex.X degree))

/-- Every canonical finite-frontier candidate is genuinely bounded perfect;
this says nothing yet about adequacy for the actual complex. -/
theorem candidate_isBoundedFiniteFree
    {complex : IntegralCochainComplex ℤ}
    (frontier : CanonicalFiniteFrontierAt complex)
    (coverage : GeneratedDifferentialCoverageAt frontier) :
    IsBoundedFiniteFree (finitePerfectCandidate frontier coverage) :=
  ⟨candidateDegreeSupport frontier,
    candidateTerm_isZero_outside_support frontier coverage,
    fun degree =>
      ⟨candidateTermFree frontier coverage degree,
        candidateTermFinite frontier coverage degree⟩⟩

/-- A complex with zero objects in every degree is a zero object. -/
theorem complex_isZero_of_components
    (complex : IntegralCochainComplex ℤ)
    (components : ∀ degree, IsZero (complex.X degree)) :
    IsZero complex where
  unique_to target := ⟨
    { default := 0
      uniq := fun morphism => by
        apply HomologicalComplex.Hom.ext
        funext degree
        exact (components degree).eq_of_src _ _ }⟩
  unique_from source := ⟨
    { default := 0
      uniq := fun morphism => by
        apply HomologicalComplex.Hom.ext
        funext degree
        exact (components degree).eq_of_tgt _ _ }⟩

/-- Stable root-owned canonical-frontier face.  Its mouth contains only the
exact root occurrence and one actual cochain-complex occurrence. -/
structure RootGeneratedCanonicalFiniteFrontierCompressionAt
    {Root : Type w} (rootOccurrence : RootedAccountedUnfolding Root)
    (actualComplexOccurrence : RootedAccountedUnfolding
      (IntegralCochainComplex ℤ)) : Type w where
  private mk ::

namespace RootGeneratedCanonicalFiniteFrontierCompressionAt

variable {Root : Type w} {rootOccurrence : RootedAccountedUnfolding Root}
variable {actualComplexOccurrence : RootedAccountedUnfolding
  (IntegralCochainComplex ℤ)}

def generate : RootGeneratedCanonicalFiniteFrontierCompressionAt
    rootOccurrence actualComplexOccurrence :=
  ⟨⟩

def root
    (_face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence) :=
  rootOccurrence

def actualComplex
    (_face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence) :=
  actualComplexOccurrence.root

def candidateOccurrence
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence)
    (frontier : CanonicalFiniteFrontierAt face.actualComplex)
    (coverage : GeneratedDifferentialCoverageAt frontier) :
    RootedAccountedUnfolding (IntegralCochainComplex ℤ) :=
  RootedAccountedUnfolding.zero
    (finitePerfectCandidate frontier coverage)

def candidateMapOccurrence
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence)
    (frontier : CanonicalFiniteFrontierAt face.actualComplex)
    (coverage : GeneratedDifferentialCoverageAt frontier) :
    RootedAccountedUnfolding
      ((face.candidateOccurrence frontier coverage).root ⟶
        actualComplexOccurrence.root) :=
  RootedAccountedUnfolding.zero
    (finitePerfectCandidateMap frontier coverage)

def derivedFace
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence)
    (frontier : CanonicalFiniteFrontierAt face.actualComplex)
    (coverage : GeneratedDifferentialCoverageAt frontier) :
    RootGeneratedDerivedAdicCofiberAt face.root
      (face.candidateOccurrence frontier coverage)
      actualComplexOccurrence
      (face.candidateMapOccurrence frontier coverage) :=
  RootGeneratedDerivedAdicCofiberAt.generate

def DerivedResidualVanishes
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence)
    (frontier : CanonicalFiniteFrontierAt face.actualComplex)
    (coverage : GeneratedDifferentialCoverageAt frontier) : Prop :=
  IsZero (face.derivedFace frontier coverage).derivedTriangle.obj₁

structure ClassifiedAdequateFrontierAt
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence) : Type w where
  private mk ::
  frontier : CanonicalFiniteFrontierAt face.actualComplex
  coverage : GeneratedDifferentialCoverageAt frontier
  residualVanishes : face.DerivedResidualVanishes frontier coverage

/-- Seal an actual frontier whose derived residual has already been generated
by an upstream framework calculation.  This is the causal positive mouth for
consumers such as finite-cell tail accounting: it preserves the calculated
frontier instead of rerunning the total existential classifier and silently
choosing a different adequate presentation. -/
def classifiedAdequateFrontierOfGeneratedResidual
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence)
    (frontier : CanonicalFiniteFrontierAt face.actualComplex)
    (coverage : GeneratedDifferentialCoverageAt frontier)
    (residualVanishes : face.DerivedResidualVanishes frontier coverage) :
    ClassifiedAdequateFrontierAt face :=
  ⟨frontier, coverage, residualVanishes⟩

@[simp] theorem classifiedAdequateFrontierOfGeneratedResidual_frontier
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence)
    (frontier : CanonicalFiniteFrontierAt face.actualComplex)
    (coverage : GeneratedDifferentialCoverageAt frontier)
    (residualVanishes : face.DerivedResidualVanishes frontier coverage) :
    (face.classifiedAdequateFrontierOfGeneratedResidual
      frontier coverage residualVanishes).frontier = frontier :=
  rfl

@[simp] theorem classifiedAdequateFrontierOfGeneratedResidual_coverage
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence)
    (frontier : CanonicalFiniteFrontierAt face.actualComplex)
    (coverage : GeneratedDifferentialCoverageAt frontier)
    (residualVanishes : face.DerivedResidualVanishes frontier coverage) :
    (face.classifiedAdequateFrontierOfGeneratedResidual
      frontier coverage residualVanishes).coverage = coverage :=
  rfl

def emptyFrontier
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence) :
    CanonicalFiniteFrontierAt face.actualComplex :=
  ∅

theorem emptyFrontier_differentialCovered
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence) :
    DifferentialCoveredAt face.emptyFrontier := by
  intro source target related generator
  have impossible : generator.1.1 ∈
      (∅ : CanonicalFiniteFrontierAt face.actualComplex) :=
    generator.1.2
  simp at impossible

def emptyFrontierCoverage
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence) :
    GeneratedDifferentialCoverageAt face.emptyFrontier :=
  ⟨face.emptyFrontier_differentialCovered⟩

theorem emptyFrontierCandidate_isZero
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence) :
    IsZero (finitePerfectCandidate face.emptyFrontier
      face.emptyFrontierCoverage) := by
  apply complex_isZero_of_components
  intro degree
  apply candidateTerm_isZero_outside_support
  simp [candidateDegreeSupport, frontierDegreeSupport, emptyFrontier]

theorem emptyFrontierDerivedResidualVanishes_of_actualIsZero
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence)
    (actualIsZero : IsZero face.actualComplex) :
    face.DerivedResidualVanishes face.emptyFrontier
      face.emptyFrontierCoverage := by
  letI : IsIso (finitePerfectCandidateMap face.emptyFrontier
      face.emptyFrontierCoverage) :=
    IsZero.isIso face.emptyFrontierCandidate_isZero actualIsZero _
  letI : IsIso (DerivedCategory.Q.map
      (face.derivedFace face.emptyFrontier
        face.emptyFrontierCoverage).actualTransition) := by
    change IsIso (DerivedCategory.Q.map
      (finitePerfectCandidateMap face.emptyFrontier
        face.emptyFrontierCoverage))
    exact Functor.map_isIso DerivedCategory.Q _
  exact (face.derivedFace face.emptyFrontier
    face.emptyFrontierCoverage).derivedCofiber_isZero_of_derivedIsIso

/-- Derived-zero actual complexes also generate the adequate empty frontier.
This is the correct mouth for an actual acyclic mapping cocone: the chain
complex need not be the strict zero object, but its image in the derived
category must already have been calculated to be zero. -/
theorem emptyFrontierDerivedResidualVanishes_of_actualDerivedIsZero
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence)
    (actualDerivedIsZero :
      IsZero (DerivedCategory.Q.obj face.actualComplex)) :
    face.DerivedResidualVanishes face.emptyFrontier
      face.emptyFrontierCoverage := by
  have candidateDerivedIsZero : IsZero
      (DerivedCategory.Q.obj
        (finitePerfectCandidate face.emptyFrontier
          face.emptyFrontierCoverage)) :=
    Functor.map_isZero DerivedCategory.Q face.emptyFrontierCandidate_isZero
  letI : IsIso (DerivedCategory.Q.map
      (face.derivedFace face.emptyFrontier
        face.emptyFrontierCoverage).actualTransition) :=
    IsZero.isIso candidateDerivedIsZero actualDerivedIsZero _
  exact (face.derivedFace face.emptyFrontier
    face.emptyFrontierCoverage).derivedCofiber_isZero_of_derivedIsIso

/-- Generated zero residuals have a canonical adequate empty frontier.  This
is the genuine positive producer used by zero-residual rigidity; it does not
claim that arbitrary nonzero perfect complexes select a frontier. -/
def adequateEmptyFrontierOfActualIsZero
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence)
    (actualIsZero : IsZero face.actualComplex) :
    ClassifiedAdequateFrontierAt face :=
  ⟨face.emptyFrontier, face.emptyFrontierCoverage,
    face.emptyFrontierDerivedResidualVanishes_of_actualIsZero actualIsZero⟩

/-- Positive empty-frontier classification for an actual complex whose
derived zero law was generated by the framework. -/
def adequateEmptyFrontierOfActualDerivedIsZero
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence)
    (actualDerivedIsZero :
      IsZero (DerivedCategory.Q.obj face.actualComplex)) :
    ClassifiedAdequateFrontierAt face :=
  ⟨face.emptyFrontier, face.emptyFrontierCoverage,
    face.emptyFrontierDerivedResidualVanishes_of_actualDerivedIsZero
      actualDerivedIsZero⟩

/-- Exact negative outcome: every intrinsic finite frontier either fails
the calculated differential-coverage law or has a persistent derived
mapping-cofiber residual. -/
structure NoAdequateFiniteFrontierObstructionAt
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence) : Type w where
  private mk ::
  persists : ∀ (frontier : CanonicalFiniteFrontierAt face.actualComplex)
    (coverage : GeneratedDifferentialCoverageAt frontier),
      ¬ face.DerivedResidualVanishes frontier coverage

abbrev SettlementOutcome
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence) :=
  Sum (ClassifiedAdequateFrontierAt face)
    (NoAdequateFiniteFrontierObstructionAt face)

/-- Total intrinsic-frontier classifier.  Existence of an adequate stage is
not a premise, but excluded-middle classification is not itself a
source-generated compactness proof.  A domain may consume the positive
branch only after its actual history proves that this classifier lands
there. -/
noncomputable def settle
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence) :
    SettlementOutcome face := by
  classical
  by_cases existsAdequate :
      ∃ (frontier : CanonicalFiniteFrontierAt face.actualComplex)
        (coverage : GeneratedDifferentialCoverageAt frontier),
          face.DerivedResidualVanishes frontier coverage
  · let frontier := Classical.choose existsAdequate
    let coverage := Classical.choose (Classical.choose_spec existsAdequate)
    let residualZero := Classical.choose_spec
      (Classical.choose_spec existsAdequate)
    exact Sum.inl ⟨frontier, coverage, residualZero⟩
  · exact Sum.inr ⟨fun frontier coverage residualZero =>
      existsAdequate ⟨frontier, coverage, residualZero⟩⟩

theorem candidateDerivedIsIso
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence)
    (settlement : ClassifiedAdequateFrontierAt face) :
    IsIso (DerivedCategory.Q.map
      (finitePerfectCandidateMap settlement.frontier
        settlement.coverage)) := by
  exact ((face.derivedFace settlement.frontier settlement.coverage
      ).derivedTriangle.isZero₁_iff_isIso₂
        (face.derivedFace settlement.frontier settlement.coverage
          ).derivedTriangle_distinguished).mp
    settlement.residualVanishes

/-- Adequate canonical frontier installs the stable generic derived
settlement mouth. -/
noncomputable def classifiedGlobalSettlement
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence)
    (settlement : ClassifiedAdequateFrontierAt face) :
    RootGeneratedDerivedCofinalSettlementAt face.root
      (face.candidateOccurrence settlement.frontier settlement.coverage)
      actualComplexOccurrence
      (face.candidateMapOccurrence settlement.frontier
        settlement.coverage) := by
  let derivedIso : IsIso (DerivedCategory.Q.map
      (face.candidateMapOccurrence settlement.frontier
        settlement.coverage).root) := by
    change IsIso (DerivedCategory.Q.map
      (finitePerfectCandidateMap settlement.frontier settlement.coverage))
    exact face.candidateDerivedIsIso settlement
  exact @RootGeneratedDerivedCofinalSettlementAt.generate
    Root ℤ inferInstance face.root
    (face.candidateOccurrence settlement.frontier settlement.coverage)
    actualComplexOccurrence
    (face.candidateMapOccurrence settlement.frontier settlement.coverage)
    derivedIso

theorem classification_is_total
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence) :
    Nonempty (SettlementOutcome face) :=
  ⟨face.settle⟩

theorem preserves_actual_root
    (face : RootGeneratedCanonicalFiniteFrontierCompressionAt
      rootOccurrence actualComplexOccurrence) :
    face.root = rootOccurrence ∧
      face.actualComplex = actualComplexOccurrence.root :=
  ⟨rfl, rfl⟩

end RootGeneratedCanonicalFiniteFrontierCompressionAt

end

