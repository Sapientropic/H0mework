import H0mework.Realization.Arithmetic.DerivedAdicCofiber

/-!
# Root-generated contraction of a derived cofiber

An actual degree `-1` endomorphism cochain on the mapping cocone generated by
a rooted chain transition is raw higher-cell data.  The generic engine
calculates whether its differential is the identity.  Only the positive
calculation branch generates a contracting homotopy, then transports it
through the homotopy category and the canonical homotopy-to-derived
localization comparison.

Thus the mouth accepts no `Homotopy`, `QuasiIso`, derived `IsIso`, acyclicity,
or `IsZero` receipt from the caller.

This is a sufficient cofiber route, not a claim that every acyclic complex is
contractible.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace DerivedCofiberContraction

open CategoryTheory
open CategoryTheory.Limits
open CochainComplex.HomComplex
open DerivedAdicCofiber

noncomputable section

universe w

attribute [local instance] HasDerivedCategory.standard

/-- One source-owned raw degree `-1` cochain on the already generated mapping
cocone. -/
structure RootGeneratedDerivedCofiberContractionAt
    {Root : Type w} {R : Type} [CommRing R]
    {rootOccurrence : RootedAccountedUnfolding Root}
    {sourceOccurrence targetOccurrence : RootedAccountedUnfolding
      (IntegralCochainComplex R)}
    {transitionOccurrence : RootedAccountedUnfolding
      (sourceOccurrence.root ⟶ targetOccurrence.root)}
    (cofiberFace : RootGeneratedDerivedAdicCofiberAt rootOccurrence
      sourceOccurrence targetOccurrence transitionOccurrence)
    (cochainOccurrence : RootedAccountedUnfolding
      (Cochain cofiberFace.cofiberComplex cofiberFace.cofiberComplex
        (-1))) : Type where
  private mk ::

namespace RootGeneratedDerivedCofiberContractionAt

variable {Root : Type w} {R : Type} [CommRing R]
variable {rootOccurrence : RootedAccountedUnfolding Root}
variable {sourceOccurrence targetOccurrence : RootedAccountedUnfolding
  (IntegralCochainComplex R)}
variable {transitionOccurrence : RootedAccountedUnfolding
  (sourceOccurrence.root ⟶ targetOccurrence.root)}
variable {cofiberFace : RootGeneratedDerivedAdicCofiberAt rootOccurrence
  sourceOccurrence targetOccurrence transitionOccurrence}
variable {cochainOccurrence : RootedAccountedUnfolding
  (Cochain cofiberFace.cofiberComplex cofiberFace.cofiberComplex (-1))}

def generate : RootGeneratedDerivedCofiberContractionAt cofiberFace
    cochainOccurrence :=
  ⟨⟩

def root
    (_face : RootGeneratedDerivedCofiberContractionAt cofiberFace
      cochainOccurrence) :=
  cofiberFace.root

def actualCochain
    (_face : RootGeneratedDerivedCofiberContractionAt cofiberFace
      cochainOccurrence) :
    Cochain cofiberFace.cofiberComplex cofiberFace.cofiberComplex (-1) :=
  cochainOccurrence.root

/-- Calculation target generated from the raw higher cell. -/
def ContractionEquation
    (face : RootGeneratedDerivedCofiberContractionAt cofiberFace
      cochainOccurrence) : Prop :=
  Cochain.ofHom (𝟙 cofiberFace.cofiberComplex) =
    δ (-1) 0 face.actualCochain +
      Cochain.ofHom
        (0 : cofiberFace.cofiberComplex ⟶ cofiberFace.cofiberComplex)

structure GeneratedCofiberContractionCalculationAt
    (face : RootGeneratedDerivedCofiberContractionAt cofiberFace
      cochainOccurrence) : Type where
  private mk ::
  equation : face.ContractionEquation

structure CofiberContractionEquationObstructionAt
    (face : RootGeneratedDerivedCofiberContractionAt cofiberFace
      cochainOccurrence) : Type where
  private mk ::
  persists : ¬ face.ContractionEquation

abbrev CalculationOutcome
    (face : RootGeneratedDerivedCofiberContractionAt cofiberFace
      cochainOccurrence) :=
  Sum (GeneratedCofiberContractionCalculationAt face)
    (CofiberContractionEquationObstructionAt face)

/-- Total calculation of `δh = 𝟙`; this classifier does not assert that an
arbitrary raw cochain contracts the residual. -/
noncomputable def settle
    (face : RootGeneratedDerivedCofiberContractionAt cofiberFace
      cochainOccurrence) : CalculationOutcome face := by
  classical
  by_cases equation : face.ContractionEquation
  · exact Sum.inl ⟨equation⟩
  · exact Sum.inr ⟨equation⟩

/-- The contracting homotopy is generated only after the cochain equation
has been calculated. -/
noncomputable def generatedContraction
    (face : RootGeneratedDerivedCofiberContractionAt cofiberFace
      cochainOccurrence)
    (calculation : GeneratedCofiberContractionCalculationAt face) :
    Homotopy (𝟙 cofiberFace.cofiberComplex) 0 :=
  (Cochain.equivHomotopy (𝟙 cofiberFace.cofiberComplex)
    (0 : cofiberFace.cofiberComplex ⟶ cofiberFace.cofiberComplex)).symm
      ⟨face.actualCochain, calculation.equation⟩

/-- The actual contraction kills the mapping cocone first in the homotopy
category and then in the derived category. -/
theorem derivedCofiberVanishes
    (face : RootGeneratedDerivedCofiberContractionAt cofiberFace
      cochainOccurrence)
    (calculation : GeneratedCofiberContractionCalculationAt face) :
    IsZero cofiberFace.derivedTriangle.obj₁ := by
  let quotient := HomotopyCategory.quotient
    (ModuleCat.{0} R) (ComplexShape.up ℤ)
  have quotientZero :
      IsZero (quotient.obj cofiberFace.cofiberComplex) :=
    (HomotopyCategory.isZero_quotient_obj_iff
      cofiberFace.cofiberComplex).2
        ⟨face.generatedContraction calculation⟩
  have localizedZero :
      IsZero (DerivedCategory.Qh.obj
        (quotient.obj cofiberFace.cofiberComplex)) := by
    rw [IsZero.iff_id_eq_zero, ← DerivedCategory.Qh.map_id]
    rw [(IsZero.iff_id_eq_zero _).mp quotientZero]
    exact (DerivedCategory.Qh (C := ModuleCat.{0} R)).map_zero _ _
  have derivedZero :
      IsZero (DerivedCategory.Q.obj cofiberFace.cofiberComplex) :=
    IsZero.of_iso localizedZero
      ((DerivedCategory.quotientCompQhIso (ModuleCat.{0} R)).app
        cofiberFace.cofiberComplex).symm
  change IsZero (DerivedCategory.Q.obj cofiberFace.cofiberComplex)
  exact derivedZero

theorem settlementMouth
    (face : RootGeneratedDerivedCofiberContractionAt cofiberFace
      cochainOccurrence)
    (calculation : GeneratedCofiberContractionCalculationAt face) :
    face.root = rootOccurrence ∧
      face.actualCochain = cochainOccurrence.root ∧
      IsZero cofiberFace.derivedTriangle.obj₁ :=
  ⟨rfl, rfl, face.derivedCofiberVanishes calculation⟩

end RootGeneratedDerivedCofiberContractionAt

end

end DerivedCofiberContraction
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
