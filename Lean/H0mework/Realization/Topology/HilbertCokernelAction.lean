import H0mework.Realization.Topology.HilbertCokernel

/-!
# Source action on a Hilbert cokernel

A strict square with a target linear isometry preserves the generated range closure forward and
induces quotient action plus orthogonal compression. Invertible source/target actions upgrade these
maps to canonical linear isometric equivalences.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace SourceGeneratedHilbertCokernel

noncomputable section

universe s h

variable {S : Type s} [AddCommGroup S] [Module ℂ S]
variable {H : Type h} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
variable {T : S →ₗ[ℂ] H}

/-- A one-sided strict square; no surjectivity or closed-range premise is included. -/
structure IsometricSquare (T : S →ₗ[ℂ] H) where
  sourceAction : S →ₗ[ℂ] S
  targetAction : H →ₗᵢ[ℂ] H
  commutes : ∀ source, targetAction (T source) = T (sourceAction source)

namespace IsometricSquare

theorem map_range_le (square : IsometricSquare T) :
    (LinearMap.range T).map square.targetAction.toLinearMap ≤ LinearMap.range T := by
  rintro _ ⟨_, ⟨source, rfl⟩, rfl⟩
  exact ⟨square.sourceAction source, (square.commutes source).symm⟩

theorem map_closedRange_le (square : IsometricSquare T) :
    (closedRange T).toSubmodule.map square.targetAction.toLinearMap ≤
      (closedRange T).toSubmodule := by
  rintro _ ⟨value, hvalue, rfl⟩
  have hMaps : Set.MapsTo square.targetAction
      ((LinearMap.range T : Submodule ℂ H) : Set H) (closedRange T : Set H) := by
    rintro _ ⟨source, rfl⟩
    rw [square.commutes]
    exact (LinearMap.range T).le_topologicalClosure ⟨square.sourceAction source, rfl⟩
  exact hMaps.closure_left square.targetAction.continuous (closedRange T).isClosed hvalue

theorem target_mem_closedRange (square : IsometricSquare T) {value : H}
    (hvalue : value ∈ closedRange T) :
    square.targetAction value ∈ closedRange T :=
  square.map_closedRange_le ⟨value, hvalue, rfl⟩

/-- The algebraic quotient action generated by a one-sided square. -/
def quotientAction (square : IsometricSquare T) : Cokernel T →ₗ[ℂ] Cokernel T :=
  (closedRange T).toSubmodule.mapQ (closedRange T).toSubmodule
    square.targetAction.toLinearMap
    (Submodule.map_le_iff_le_comap.mp square.map_closedRange_le)

@[simp]
theorem quotientAction_quotientClass (square : IsometricSquare T) (value : H) :
    square.quotientAction (quotientClass T value) =
      quotientClass T (square.targetAction value) := by
  rfl

variable [CompleteSpace H]

/-- Orthogonal compression of the one-sided target action. -/
def orthogonalCompression (square : IsometricSquare T) :
    OrthogonalResidual T →L[ℂ] OrthogonalResidual T :=
  (residual T).comp <|
    square.targetAction.toContinuousLinearMap.comp
      (Submodule.orthogonal (closedRange T).toSubmodule).subtypeL

theorem residual_target_eq_compression (square : IsometricSquare T) (value : H) :
    residual T (square.targetAction value) =
      residual T (square.targetAction (residual T value : H)) := by
  rw [← quotientOrthogonalEquiv_quotientClass, ← quotientOrthogonalEquiv_quotientClass]
  apply congrArg (quotientOrthogonalEquiv T)
  apply (Submodule.Quotient.eq _).2
  rw [← square.targetAction.map_sub]
  exact square.target_mem_closedRange (sub_residual_mem_closedRange T value)

@[simp]
theorem quotientAction_intertwines (square : IsometricSquare T) (q : Cokernel T) :
    quotientOrthogonalEquiv T (square.quotientAction q) =
      square.orthogonalCompression (quotientOrthogonalEquiv T q) := by
  induction q using Submodule.Quotient.induction_on with
  | _ value =>
      change quotientOrthogonalEquiv T
          (square.quotientAction (quotientClass T value)) =
        square.orthogonalCompression
          (quotientOrthogonalEquiv T (quotientClass T value))
      rw [square.quotientAction_quotientClass, quotientOrthogonalEquiv_quotientClass,
        quotientOrthogonalEquiv_quotientClass]
      exact square.residual_target_eq_compression value

theorem norm_orthogonalCompression_le (square : IsometricSquare T)
    (value : OrthogonalResidual T) :
    ‖square.orthogonalCompression value‖ ≤ ‖value‖ := by
  change ‖residual T (square.targetAction (value : H))‖ ≤ ‖value‖
  calc
    ‖residual T (square.targetAction (value : H))‖ ≤
        ‖square.targetAction (value : H)‖ :=
      (Submodule.orthogonal (closedRange T).toSubmodule).norm_orthogonalProjectionOnto_apply_le _
    _ = ‖value‖ := square.targetAction.norm_map value

end IsometricSquare

/-- An invertible strict action square. -/
structure ActionSquare (T : S →ₗ[ℂ] H) where
  sourceAction : S ≃ₗ[ℂ] S
  targetAction : H ≃ₗᵢ[ℂ] H
  commutes : ∀ source, targetAction (T source) = T (sourceAction source)

namespace ActionSquare

/-- Forgetting inverses recovers the one-sided square. -/
def toIsometricSquare (square : ActionSquare T) : IsometricSquare T where
  sourceAction := square.sourceAction.toLinearMap
  targetAction := square.targetAction.toLinearIsometry
  commutes := square.commutes

theorem map_range_eq (square : ActionSquare T) :
    (LinearMap.range T).map (square.targetAction : H →ₗ[ℂ] H) =
      LinearMap.range T := by
  apply le_antisymm
  · rintro _ ⟨_, ⟨source, rfl⟩, rfl⟩
    exact ⟨square.sourceAction source, (square.commutes source).symm⟩
  · rintro _ ⟨source, rfl⟩
    refine ⟨T (square.sourceAction.symm source),
      ⟨square.sourceAction.symm source, rfl⟩, ?_⟩
    simpa using square.commutes (square.sourceAction.symm source)

theorem closedRange_invariant (square : ActionSquare T) :
    (closedRange T).mapEquiv square.targetAction.toContinuousLinearEquiv =
      closedRange T := by
  rw [closedRange, ← ClosedSubmodule.closure_map_eq_mapEquiv_closure, square.map_range_eq]

theorem map_closedRange_eq (square : ActionSquare T) :
    (closedRange T).toSubmodule.map
        (square.targetAction.toLinearEquiv : H →ₗ[ℂ] H) =
      (closedRange T).toSubmodule := by
  exact congrArg ClosedSubmodule.toSubmodule square.closedRange_invariant

theorem map_orthogonalResidual_eq (square : ActionSquare T) :
    (Submodule.orthogonal (closedRange T).toSubmodule).map
        (square.targetAction.toLinearEquiv : H →ₗ[ℂ] H) =
      Submodule.orthogonal (closedRange T).toSubmodule := by
  rw [Submodule.map_orthogonal_equiv, square.map_closedRange_eq]

/-- The invertible action restricts to the orthogonal residual isometrically. -/
def orthogonalAction (square : ActionSquare T) :
    OrthogonalResidual T ≃ₗᵢ[ℂ] OrthogonalResidual T where
  __ := square.targetAction.toLinearEquiv.ofSubmodules _ _
    square.map_orthogonalResidual_eq
  norm_map' value := square.targetAction.norm_map value

@[simp]
theorem coe_orthogonalAction_apply
    (square : ActionSquare T) (value : OrthogonalResidual T) :
    (square.orthogonalAction value : H) = square.targetAction (value : H) :=
  rfl

variable [CompleteSpace H]

/-- The corresponding isometric action on the quotient. -/
def quotientAction (square : ActionSquare T) : Cokernel T ≃ₗᵢ[ℂ] Cokernel T :=
  (quotientOrthogonalEquiv T).trans <|
    square.orthogonalAction |>.trans (quotientOrthogonalEquiv T).symm

@[simp]
theorem quotientAction_intertwines (square : ActionSquare T) (q : Cokernel T) :
    quotientOrthogonalEquiv T (square.quotientAction q) =
      square.orthogonalAction (quotientOrthogonalEquiv T q) := by
  simp [quotientAction]

theorem orthogonalAction_residual (square : ActionSquare T) (value : H) :
    square.orthogonalAction (residual T value) =
      residual T (square.targetAction value) := by
  apply Subtype.ext
  change square.targetAction
      ((Submodule.orthogonal (closedRange T).toSubmodule).starProjection value) =
    (Submodule.orthogonal (closedRange T).toSubmodule).starProjection
      (square.targetAction value)
  have hprojection := Submodule.starProjection_map_apply square.targetAction
    (Submodule.orthogonal (closedRange T).toSubmodule)
    (square.targetAction value)
  simpa only [square.map_orthogonalResidual_eq,
    square.targetAction.symm_apply_apply] using hprojection.symm

@[simp]
theorem quotientAction_quotientClass (square : ActionSquare T) (value : H) :
    square.quotientAction (quotientClass T value) =
      quotientClass T (square.targetAction value) := by
  apply (quotientOrthogonalEquiv T).injective
  rw [square.quotientAction_intertwines, quotientOrthogonalEquiv_quotientClass,
    square.orthogonalAction_residual, quotientOrthogonalEquiv_quotientClass]

theorem norm_residual_targetAction (square : ActionSquare T) (value : H) :
    ‖residual T (square.targetAction value)‖ = ‖residual T value‖ := by
  calc
    ‖residual T (square.targetAction value)‖ =
        ‖square.orthogonalAction (residual T value)‖ :=
      congrArg norm (square.orthogonalAction_residual value).symm
    _ = ‖residual T value‖ := square.orthogonalAction.norm_map _

theorem residualEnergy_targetAction (square : ActionSquare T) (value : H) :
    residualEnergy T (square.targetAction value) = residualEnergy T value := by
  simp only [residualEnergy, square.norm_residual_targetAction value]

end ActionSquare

end


end SourceGeneratedHilbertCokernel
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
