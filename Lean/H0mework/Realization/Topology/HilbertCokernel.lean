import Mathlib.Analysis.InnerProductSpace.ProdL2

/-!
# Source-generated Hilbert cokernel

An actual complex-linear source map generates the closure of its range. The quotient by that
closed subspace is canonically the orthogonal residual, with no closed-range, finite-dimensional,
surjectivity, or spectral premise.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace SourceGeneratedHilbertCokernel

noncomputable section

universe s h

variable {S : Type s} [AddCommGroup S] [Module ℂ S]
variable {H : Type h} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- The closed subspace generated by the actual source map. -/
def closedRange (T : S →ₗ[ℂ] H) : ClosedSubmodule ℂ H :=
  (LinearMap.range T).closure

/-- The quotient by the source-generated closed range. -/
abbrev Cokernel (T : S →ₗ[ℂ] H) :=
  H ⧸ (closedRange T).toSubmodule

/-- The orthogonal representative of the source-generated cokernel. -/
abbrev OrthogonalResidual (T : S →ₗ[ℂ] H) :=
  ↥(Submodule.orthogonal (closedRange T).toSubmodule)

/-- The canonical quotient class in the closed-range cokernel. -/
def quotientClass (T : S →ₗ[ℂ] H) : H →L[ℂ] Cokernel T :=
  (closedRange T).toSubmodule.mkQL

theorem quotientClass_eq_zero_iff (T : S →ₗ[ℂ] H) (value : H) :
    quotientClass T value = 0 ↔ value ∈ closedRange T := by
  change (Submodule.Quotient.mk value : Cokernel T) = 0 ↔ _
  exact Submodule.Quotient.mk_eq_zero _

@[simp]
theorem quotientClass_source (T : S →ₗ[ℂ] H) (source : S) :
    quotientClass T (T source) = 0 := by
  rw [quotientClass_eq_zero_iff]
  exact (LinearMap.range T).le_topologicalClosure ⟨source, rfl⟩

variable [CompleteSpace H]

/-- The canonical linear isometry from the quotient to the orthogonal residual. -/
def quotientOrthogonalEquiv (T : S →ₗ[ℂ] H) :
    Cokernel T ≃ₗᵢ[ℂ] OrthogonalResidual T :=
  (closedRange T).toSubmodule.quotientEquivOrthogonal

/-- Orthogonal projection away from the closed source range. -/
def residual (T : S →ₗ[ℂ] H) : H →L[ℂ] OrthogonalResidual T :=
  (Submodule.orthogonal (closedRange T).toSubmodule).orthogonalProjectionOnto

theorem quotientOrthogonalEquiv_quotientClass (T : S →ₗ[ℂ] H) (value : H) :
    quotientOrthogonalEquiv T (quotientClass T value) = residual T value := by
  let P := (closedRange T).toSubmodule
  change P.quotientEquivOrthogonal (P.mkQ value) = Pᗮ.orthogonalProjectionOnto value
  apply Subtype.ext
  change Pᗮ.projection P P.isCompl_orthogonal.symm value = Pᗮ.starProjection value
  rw [Submodule.projection_eq_self_sub_projection P.isCompl_orthogonal value]
  rw [Submodule.starProjection_orthogonal_val (K := P) value]
  rw [Submodule.starProjection_apply_eq_isComplProjection]

theorem norm_quotientClass_eq_norm_residual (T : S →ₗ[ℂ] H) (value : H) :
    ‖quotientClass T value‖ = ‖residual T value‖ := by
  calc
    ‖quotientClass T value‖ = ‖quotientOrthogonalEquiv T (quotientClass T value)‖ :=
      ((quotientOrthogonalEquiv T).norm_map _).symm
    _ = ‖residual T value‖ :=
      congrArg norm (quotientOrthogonalEquiv_quotientClass T value)

theorem residual_eq_zero_iff (T : S →ₗ[ℂ] H) (value : H) :
    residual T value = 0 ↔ value ∈ closedRange T := by
  change
    (Submodule.orthogonal (closedRange T).toSubmodule).orthogonalProjectionOnto value = 0 ↔ _
  rw [Submodule.orthogonalProjectionOnto_eq_zero_iff]
  rw [Submodule.orthogonal_orthogonal]
  rfl

theorem sub_residual_mem_closedRange (T : S →ₗ[ℂ] H) (value : H) :
    value - (residual T value : H) ∈ closedRange T := by
  let P := (closedRange T).toSubmodule
  change value - Pᗮ.starProjection value ∈ P
  rw [Submodule.starProjection_orthogonal_val (K := P) value]
  simp

@[simp]
theorem residual_source (T : S →ₗ[ℂ] H) (source : S) :
    residual T (T source) = 0 := by
  rw [residual_eq_zero_iff]
  exact (LinearMap.range T).le_topologicalClosure ⟨source, rfl⟩

theorem residual_eq_zero_of_denseRange
    (T : S →ₗ[ℂ] H) (hT : DenseRange T) (value : H) :
    residual T value = 0 := by
  rw [residual_eq_zero_iff]
  change value ∈ (LinearMap.range T).topologicalClosure
  have hdense : Dense ((LinearMap.range T : Submodule ℂ H) : Set H) := by
    rw [LinearMap.coe_range]
    exact hT
  rw [Submodule.dense_iff_topologicalClosure_eq_top.mp hdense]
  trivial

/-- Squared norm of the canonical cokernel coordinate. -/
def residualEnergy (T : S →ₗ[ℂ] H) (value : H) : ℝ :=
  ‖residual T value‖ ^ 2

theorem residualEnergy_nonneg (T : S →ₗ[ℂ] H) (value : H) :
    0 ≤ residualEnergy T value := by
  exact sq_nonneg _

theorem residualEnergy_eq_zero_iff (T : S →ₗ[ℂ] H) (value : H) :
    residualEnergy T value = 0 ↔ value ∈ closedRange T := by
  simp [residualEnergy, residual_eq_zero_iff]

theorem residualEnergy_eq_quotientNormSq (T : S →ₗ[ℂ] H) (value : H) :
    residualEnergy T value = ‖quotientClass T value‖ ^ 2 := by
  rw [residualEnergy, norm_quotientClass_eq_norm_residual]

@[simp]
theorem residualEnergy_source (T : S →ₗ[ℂ] H) (source : S) :
    residualEnergy T (T source) = 0 := by
  simp [residualEnergy]

end

end SourceGeneratedHilbertCokernel
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
