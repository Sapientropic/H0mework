import Mathlib.Analysis.InnerProductSpace.Adjoint
import Mathlib.Analysis.InnerProductSpace.ProdL2

/-!
# Source-generated compressed isometry defect port

An ambient linear isometry acting on a closed observed subspace has two
canonical dependent faces: its orthogonal compression back into the subspace
and its external orthogonal output.  Their `L²` product is itself a linear
isometry.  Thus exact reconstruction, polarized Pythagoras, and contractivity
are generated by the carrier and action; none is accepted as a premise.
-/

set_option autoImplicit false

open scoped InnerProductSpace

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace SourceGeneratedCompressedUnitaryDefectPort

noncomputable section

universe u

variable {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [CompleteSpace E]

local instance observedFaceCompleteSpace (K : ClosedSubmodule ℂ E) :
    CompleteSpace K.toSubmodule := by
  apply IsComplete.completeSpace_coe
  exact K.isClosed.isComplete

/-- The whole conservative output port.  Its first coordinate is the observed
compression and its second coordinate is the actual external output. -/
def defectPort (K : ClosedSubmodule ℂ E) (V : E →ₗᵢ[ℂ] E) :
    K.toSubmodule →ₗᵢ[ℂ]
      WithLp 2 (K.toSubmodule × Submodule.orthogonal K.toSubmodule) :=
  K.toSubmodule.orthogonalDecomposition.toLinearIsometry.comp
    (V.comp K.toSubmodule.subtypeₗᵢ)

/-- Orthogonal compression of the ambient action back to the observed closed
subspace. -/
def compression (K : ClosedSubmodule ℂ E) (V : E →ₗᵢ[ℂ] E) :
    K.toSubmodule →L[ℂ] K.toSubmodule :=
  K.toSubmodule.orthogonalProjectionOnto.comp
    (V.toContinuousLinearMap.comp K.toSubmodule.subtypeL)

/-- Canonical external output in the actual orthogonal complement. -/
def externalDefect (K : ClosedSubmodule ℂ E) (V : E →ₗᵢ[ℂ] E) :
    K.toSubmodule →L[ℂ] Submodule.orthogonal K.toSubmodule :=
  (Submodule.orthogonal K.toSubmodule).orthogonalProjectionOnto.comp
    (V.toContinuousLinearMap.comp K.toSubmodule.subtypeL)

@[simp]
theorem defectPort_fst (K : ClosedSubmodule ℂ E) (V : E →ₗᵢ[ℂ] E)
    (x : K.toSubmodule) :
    (defectPort K V x).fst = compression K V x := by
  simp [defectPort, compression]

@[simp]
theorem defectPort_snd (K : ClosedSubmodule ℂ E) (V : E →ₗᵢ[ℂ] E)
    (x : K.toSubmodule) :
    (defectPort K V x).snd = externalDefect K V x := by
  simp [defectPort, externalDefect]

/-- The observed and external outputs reconstruct the ambient action exactly. -/
theorem compression_add_externalDefect (K : ClosedSubmodule ℂ E)
    (V : E →ₗᵢ[ℂ] E) (x : K.toSubmodule) :
    (compression K V x : E) + (externalDefect K V x : E) = V x := by
  simp [compression, externalDefect]

/-- The external coordinate vanishes exactly when this evolved vector remains
inside the observed closed subspace. -/
theorem externalDefect_eq_zero_iff (K : ClosedSubmodule ℂ E)
    (V : E →ₗᵢ[ℂ] E) (x : K.toSubmodule) :
    externalDefect K V x = 0 ↔ V (x : E) ∈ K := by
  constructor
  · intro external_zero
    have reconstruct := compression_add_externalDefect K V x
    rw [external_zero, Submodule.coe_zero, add_zero] at reconstruct
    rw [← reconstruct]
    exact (compression K V x).property
  · intro stays_inside
    change (Submodule.orthogonal K.toSubmodule).orthogonalProjectionOnto
      (V (x : E)) = 0
    exact Submodule.orthogonalProjectionOnto_orthogonal_apply_eq_zero
      (K := K.toSubmodule) stays_inside

/-- The whole external port vanishes exactly when the ambient isometry maps
the observed subspace into itself. -/
theorem externalDefect_eq_zero_iff_mapsTo (K : ClosedSubmodule ℂ E)
    (V : E →ₗᵢ[ℂ] E) :
    externalDefect K V = 0 ↔ ∀ x : K.toSubmodule, V (x : E) ∈ K := by
  constructor
  · intro external_zero x
    apply (externalDefect_eq_zero_iff K V x).mp
    exact DFunLike.congr_fun external_zero x
  · intro maps_to
    apply ContinuousLinearMap.ext
    intro x
    exact (externalDefect_eq_zero_iff K V x).mpr (maps_to x)

/-- Polarized Pythagoras for the observed and external outputs. -/
theorem inner_compression_add_externalDefect (K : ClosedSubmodule ℂ E)
    (V : E →ₗᵢ[ℂ] E) (x y : K.toSubmodule) :
    ⟪compression K V x, compression K V y⟫_ℂ +
        ⟪externalDefect K V x, externalDefect K V y⟫_ℂ = ⟪x, y⟫_ℂ := by
  rw [← (defectPort K V).inner_map_map x y]
  rw [WithLp.prod_inner_apply]
  rw [WithLp.ofLp_fst, WithLp.ofLp_fst, WithLp.ofLp_snd, WithLp.ofLp_snd]
  rw [defectPort_fst, defectPort_fst, defectPort_snd, defectPort_snd]

/-- Exact norm-square disposition between the observed and external outputs. -/
theorem norm_sq_compression_add_externalDefect (K : ClosedSubmodule ℂ E)
    (V : E →ₗᵢ[ℂ] E) (x : K.toSubmodule) :
    ‖compression K V x‖ ^ 2 + ‖externalDefect K V x‖ ^ 2 = ‖x‖ ^ 2 := by
  rw [← (defectPort K V).norm_map x]
  rw [WithLp.prod_norm_sq_eq_of_L2]
  simp only [defectPort_fst, defectPort_snd]

/-- Compression is contractive as a theorem of orthogonal projection and the
ambient isometry. -/
theorem norm_compression_le (K : ClosedSubmodule ℂ E) (V : E →ₗᵢ[ℂ] E)
    (x : K.toSubmodule) : ‖compression K V x‖ ≤ ‖x‖ := by
  calc
    ‖compression K V x‖ ≤ ‖V (x : E)‖ := by
      exact K.toSubmodule.norm_orthogonalProjectionOnto_apply_le (V (x : E))
    _ = ‖x‖ := V.norm_map x

/-- Testing a compression against a vector in the observed face removes the
orthogonal projection. -/
theorem compression_inner_left_readback (K : ClosedSubmodule ℂ E)
    (V : E →ₗᵢ[ℂ] E) (x y : K.toSubmodule) :
    ⟪compression K V x, y⟫_ℂ = ⟪V (x : E), (y : E)⟫_ℂ := by
  simp [compression]

/-- The sibling orientation of the same projection readback. -/
theorem compression_inner_right_readback (K : ClosedSubmodule ℂ E)
    (V : E →ₗᵢ[ℂ] E) (x y : K.toSubmodule) :
    ⟪x, compression K V y⟫_ℂ = ⟪(x : E), V (y : E)⟫_ℂ := by
  simp [compression]

/-- For an ambient isometric equivalence, compression commutes with Hilbert
adjoint by reversing the ambient action. -/
theorem compression_adjoint (K : ClosedSubmodule ℂ E)
    (U : E ≃ₗᵢ[ℂ] E) :
    ContinuousLinearMap.adjoint (compression K U.toLinearIsometry) =
      compression K U.symm.toLinearIsometry := by
  apply ContinuousLinearMap.ext
  intro y
  apply ext_inner_left ℂ
  intro x
  calc
    ⟪x, ContinuousLinearMap.adjoint
        (compression K U.toLinearIsometry) y⟫_ℂ =
        ⟪compression K U.toLinearIsometry x, y⟫_ℂ :=
      (compression K U.toLinearIsometry).adjoint_inner_right x y
    _ = ⟪U (x : E), (y : E)⟫_ℂ :=
      compression_inner_left_readback K U.toLinearIsometry x y
    _ = ⟪(x : E), U.symm (y : E)⟫_ℂ :=
      U.inner_map_eq_flip (x : E) (y : E)
    _ = ⟪x, compression K U.symm.toLinearIsometry y⟫_ℂ :=
      (compression_inner_right_readback
        K U.symm.toLinearIsometry x y).symm

/-- A closed observed face is balanced when an ambient isometric symmetry
maps it back to itself. -/
structure IsBalancedFace (K : ClosedSubmodule ℂ E)
    (J : E ≃ₗᵢ[ℂ] E) : Prop where
  map_eq : K.toSubmodule.map J.toLinearEquiv.toLinearMap = K.toSubmodule

/-- The ambient symmetry restricted to a balanced face. -/
def balancedFaceEquiv (K : ClosedSubmodule ℂ E)
    (J : E ≃ₗᵢ[ℂ] E) (balanced : IsBalancedFace K J) :
    K.toSubmodule ≃ₗᵢ[ℂ] K.toSubmodule :=
  (LinearIsometryEquiv.submoduleMap K.toSubmodule J).trans
    (LinearIsometryEquiv.ofEq _ _ balanced.map_eq)

omit [CompleteSpace E] in
@[simp] theorem balancedFaceEquiv_apply_coe (K : ClosedSubmodule ℂ E)
    (J : E ≃ₗᵢ[ℂ] E) (balanced : IsBalancedFace K J)
    (x : K.toSubmodule) :
    ((balancedFaceEquiv K J balanced x : K.toSubmodule) : E) = J (x : E) :=
  rfl

/-- Projection onto a balanced face is natural under its ambient symmetry. -/
theorem balanced_starProjection (K : ClosedSubmodule ℂ E)
    (J : E ≃ₗᵢ[ℂ] E) (balanced : IsBalancedFace K J) (x : E) :
    J (K.toSubmodule.starProjection x) =
      K.toSubmodule.starProjection (J x) := by
  have projection :=
    Submodule.starProjection_map_apply J K.toSubmodule (J x)
  rw [J.symm_apply_apply] at projection
  simpa only [balanced.map_eq] using projection.symm

/-- If the ambient symmetry reverses the ambient action, it intertwines the
compressed action with its generated adjoint. -/
theorem compression_J_adjoint_sibling (K : ClosedSubmodule ℂ E)
    (U J : E ≃ₗᵢ[ℂ] E) (balanced : IsBalancedFace K J)
    (reverses : ∀ x : E, J (U x) = U.symm (J x)) (x : K.toSubmodule) :
    balancedFaceEquiv K J balanced
        (compression K U.toLinearIsometry x) =
      ContinuousLinearMap.adjoint (compression K U.toLinearIsometry)
        (balancedFaceEquiv K J balanced x) := by
  rw [compression_adjoint]
  apply Subtype.ext
  change J (K.toSubmodule.starProjection (U (x : E))) =
    K.toSubmodule.starProjection (U.symm (J (x : E)))
  rw [balanced_starProjection K J balanced, reverses]

end


