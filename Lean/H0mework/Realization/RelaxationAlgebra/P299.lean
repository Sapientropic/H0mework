import H0mework.Realization.RelaxationAlgebra.P298
import Mathlib.CategoryTheory.SingleObj

/-!
# Proposition 299: the non-absorbing noisy-OR rates form a one-object groupoid

Proposition 298 gives the honest algebraic repair for the failed ring route:
remove the absorbing rate `1`, use `0` as the noisy-OR identity, and invert
rates by `σ / (σ - 1)`.  This file registers that structure as an actual Lean
`Group`, then feeds it to Mathlib's `CategoryTheory.SingleObj`.

This is the minimal true categorical closure of the sigma-relaxation rate
algebra: a one-object groupoid whose endomorphisms are non-absorbing rates and
whose categorical composition is noisy-OR composition.
-/

noncomputable section

namespace SaturationMonoid
namespace SatOrFieldAlgebra

open CategoryTheory

variable {α : Type*} [Field α]

/-! ## Standard typeclass structure on non-absorbing rates -/

instance nonAbsorbingRateMul :
    Mul (NonAbsorbingRate (α := α)) where
  mul := NonAbsorbingRate.mul

instance nonAbsorbingRateOne :
    One (NonAbsorbingRate (α := α)) where
  one := NonAbsorbingRate.one

instance nonAbsorbingRateInv :
    Inv (NonAbsorbingRate (α := α)) where
  inv := NonAbsorbingRate.inv

@[simp] theorem nonAbsorbingRate_mul_val
    (σ τ : NonAbsorbingRate (α := α)) :
    (σ * τ).1 = satOrField σ.1 τ.1 := rfl

@[simp] theorem nonAbsorbingRate_one_val :
    (1 : NonAbsorbingRate (α := α)).1 = 0 := rfl

@[simp] theorem nonAbsorbingRate_inv_val
    (σ : NonAbsorbingRate (α := α)) :
    (σ⁻¹).1 = satOrFieldInv σ.1 := rfl

/-- THEOREM 1: non-absorbing noisy-OR rates form a genuine Lean group. -/
instance nonAbsorbingRateGroup :
    Group (NonAbsorbingRate (α := α)) :=
  Group.ofLeftAxioms
    (fun σ τ υ => NonAbsorbingRate.mul_assoc σ τ υ)
    (fun σ => NonAbsorbingRate.one_mul σ)
    (fun σ => NonAbsorbingRate.inv_mul σ)

/-! ## The one-object sigma-rate groupoid -/

/-- The one-object category/groupoid generated by non-absorbing noisy-OR rates.
-/
abbrev SatRateGroupoid :=
  SingleObj (NonAbsorbingRate (α := α))

/-- THEOREM 2: the unique object's identity morphism is the no-op rate `0`. -/
theorem satRateGroupoid_id_val :
    ((𝟙 (SingleObj.star (NonAbsorbingRate (α := α)))) :
      NonAbsorbingRate (α := α)).1 = 0 := rfl

/-- THEOREM 3: categorical composition is noisy-OR composition, in Mathlib's
single-object order (`f ≫ g` has underlying rate `g ⋆ f`). -/
theorem satRateGroupoid_comp_val
    (f g :
      SingleObj.star (NonAbsorbingRate (α := α)) ⟶
        SingleObj.star (NonAbsorbingRate (α := α))) :
    ((f ≫ g) : NonAbsorbingRate (α := α)).1 =
      satOrField g.1 f.1 := rfl

/-- THEOREM 4: the groupoid inverse of a rate is the noisy-OR inverse
`σ / (σ - 1)`. -/
theorem satRateGroupoid_inv_val
    (f :
      SingleObj.star (NonAbsorbingRate (α := α)) ⟶
        SingleObj.star (NonAbsorbingRate (α := α))) :
    ((CategoryTheory.inv f) : NonAbsorbingRate (α := α)).1 =
      satOrFieldInv f.1 := by
  rw [SingleObj.inv_as_inv]
  rfl

/-- THEOREM 5: in keep-rate coordinates, categorical composition multiplies
residuals. -/
theorem satRateGroupoid_keep_comp
    (f g :
      SingleObj.star (NonAbsorbingRate (α := α)) ⟶
        SingleObj.star (NonAbsorbingRate (α := α))) :
    keep ((f ≫ g) : NonAbsorbingRate (α := α)).1 =
      keep g.1 * keep f.1 := by
  rw [satRateGroupoid_comp_val]
  exact keep_satOrField g.1 f.1

/-- A compact certificate that the corrected sigma-rate algebra has been fed
through Mathlib's standard one-object-category construction. -/
structure SatRateGroupoidCertificate where
  id_val :
    ((𝟙 (SingleObj.star (NonAbsorbingRate (α := α)))) :
      NonAbsorbingRate (α := α)).1 = 0
  comp_val :
    ∀ f g :
      SingleObj.star (NonAbsorbingRate (α := α)) ⟶
        SingleObj.star (NonAbsorbingRate (α := α)),
        ((f ≫ g) : NonAbsorbingRate (α := α)).1 =
          satOrField g.1 f.1
  inv_val :
    ∀ f :
      SingleObj.star (NonAbsorbingRate (α := α)) ⟶
        SingleObj.star (NonAbsorbingRate (α := α)),
        ((CategoryTheory.inv f) : NonAbsorbingRate (α := α)).1 =
          satOrFieldInv f.1
  keep_comp :
    ∀ f g :
      SingleObj.star (NonAbsorbingRate (α := α)) ⟶
        SingleObj.star (NonAbsorbingRate (α := α)),
        keep ((f ≫ g) : NonAbsorbingRate (α := α)).1 =
          keep g.1 * keep f.1

/-- THEOREM 6: the canonical one-object groupoid certificate for non-absorbing
sigma rates. -/
theorem satRateGroupoidCertificate :
    SatRateGroupoidCertificate (α := α) where
  id_val := satRateGroupoid_id_val
  comp_val := satRateGroupoid_comp_val
  inv_val := satRateGroupoid_inv_val
  keep_comp := satRateGroupoid_keep_comp

end SatOrFieldAlgebra
end SaturationMonoid
