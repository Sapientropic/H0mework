/-!
# Living authority generated by a residual audit occurrence

The residual-world coface and its size-one audit patch now generate a complete
living authority without assuming proof irrelevance of the old `OpenAt`
fibres.  The fixed source installs the transported theory epoch, the exact
extended-U7 failure token and the selected residual row before its emitter is
used.  That row then generates causal authority, root/U7 disposition
commuting, the installed failure face, rooted failure and the existing
canonical minimal coface.

No coordinate equation, endpoint branch, settlement, revised material or
generated next is accepted as a premise.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace RootGeneratedResidualLivingAuthority

open RootGeneratedProofRelevantRestructuring
open RootGeneratedResidualAdmission
open RootGeneratedResidualAuditLedger
open ObstructionGeneratedMinimalCoface

universe u

section AuditRestructuring

variable (N : WorldRelationNetwork.{u}) (focus : N.Support)
variable (Residual : Type u) (distinguished : Residual)
variable [Subsingleton Residual]

/-- The audit fold is identity on every complete target-ledger entry,
including proof-relevant inherited witnesses. -/
theorem auditPatch_destination_eq
    {current : AuditV.Current}
    (occurrence : (auditSource N focus Residual).toRootSource.actual.OccurrenceAt
      current)
    (entry : OpenResponsibilityAt (ExtendedNetwork N focus Residual)
      ((auditSource N focus Residual).toRootSource.account.supportOf occurrence)) :
    ((auditPatch N focus Residual distinguished occurrence).toLedgerWriteEvolution
      |>.destination entry).1 = entry := by
  cases auditOccurrence_eq_emitted N focus Residual occurrence
  rcases entry with ⟨responsibility, opened⟩
  cases responsibility with
  | inl _oldResponsibility => rfl
  | inr coordinate =>
      cases Subsingleton.elim coordinate distinguished
      rcases opened with ⟨⟨support_eq⟩⟩
      cases support_eq
      rfl

/-- The audit fold is identity on every complete source-ledger entry. -/
theorem auditPatch_origin_eq
    {current : AuditV.Current}
    (occurrence : (auditSource N focus Residual).toRootSource.actual.OccurrenceAt
      current)
    (entry : OpenResponsibilityAt (ExtendedNetwork N focus Residual)
      ((auditSource N focus Residual).toRootSource.account.supportOf occurrence)) :
    ((auditPatch N focus Residual distinguished occurrence).toLedgerWriteEvolution
      |>.origin entry).1 = entry := by
  cases auditOccurrence_eq_emitted N focus Residual occurrence
  rcases entry with ⟨responsibility, opened⟩
  cases responsibility with
  | inl _oldResponsibility => rfl
  | inr coordinate =>
      cases Subsingleton.elim coordinate distinguished
      rcases opened with ⟨⟨support_eq⟩⟩
      cases support_eq
      rfl

def auditRestructuringLaw : SourceNativeLedgerRestructuringLaw
    (auditSource N focus Residual) :=
  RootGeneratedProofRelevantRestructuring.law
    (ExtendedNetwork N focus Residual) focus (auditSource N focus Residual)

def auditRestructuringCertification
    {current : AuditV.Current}
    (occurrence : (auditSource N focus Residual).toRootSource.actual.OccurrenceAt
      current) :
    SourceNativeLedgerRestructuringCertificationAt
      (auditRestructuringLaw N focus Residual)
      ((auditCompiler N focus Residual distinguished).compile occurrence) := by
  cases auditOccurrence_eq_emitted N focus Residual occurrence
  exact ExactLedgerRestructuringCertificationAt.ofInjective
    (fun left right equality =>
      (auditPatch_origin_eq N focus Residual distinguished
        (auditEmitted N focus Residual current) left).symm.trans
        (equality.trans
          (auditPatch_origin_eq N focus Residual distinguished
            (auditEmitted N focus Residual current) right)))
    (fun left right equality =>
      (auditPatch_destination_eq N focus Residual distinguished
        (auditEmitted N focus Residual current) left).symm.trans
        (equality.trans
          (auditPatch_destination_eq N focus Residual distinguished
            (auditEmitted N focus Residual current) right)))

def auditRestructuringSource : SourceNativeRestructuringLedgerSource
    (ExtendedNetwork N focus Residual) AuditV where
  source := auditSource N focus Residual
  compiler :=
    { ledgerCompiler := auditCompiler N focus Residual distinguished
      restructuringLaw := auditRestructuringLaw N focus Residual
      certifyRestructuring :=
        auditRestructuringCertification N focus Residual distinguished }

end AuditRestructuring

section RootedAuthority

variable (N : WorldRelationNetwork.{u}) (focus : N.Support)
variable (Residual : Type u) (distinguished : Residual)
variable [Subsingleton Residual]
variable (oldTheory : TheoryState N)
variable (oldU7 : U7ProducerCalculus N)
variable (oldCalculus : U7ObstructionEvolutionCalculus N oldU7)

abbrev ResidualWorld := ExtendedNetwork N focus Residual

abbrev extendedU7 : U7ProducerCalculus (ResidualWorld N focus Residual) :=
  extendU7 (Residual := Residual) focus oldU7

abbrev extendedCalculus :
    U7ObstructionEvolutionCalculus (ResidualWorld N focus Residual)
      (extendedU7 N focus Residual oldU7) :=
  extendU7Calculus (Residual := Residual) focus oldU7 oldCalculus

abbrev failure := residualFailure focus oldTheory distinguished

/-- The projection vocabulary contains the exact failure/U7 event pair before
the root emitter is used. -/
def auditFailureProjectionLaw : SourceNativeProjectionLaw
    (auditRestructuringSource N focus Residual distinguished).toLedgerSource where
  Projection := PUnit
  ActiveAt := fun _ {_current} _occurrence => PUnit
  InactiveAt := fun _ {_current} _occurrence => PEmpty
  classify := fun _ {_current} _occurrence => .inl PUnit.unit
  PayloadAt := fun _ {_current} _occurrence _active =>
    SourceNativeRootExpressibilityFailureTokenAt
      (failure N focus Residual distinguished oldTheory)
      (extendedCalculus N focus Residual oldU7 oldCalculus)
      ((extendedCalculus N focus Residual oldU7 oldCalculus).source.emit
        (residualObstruction focus distinguished))
  project := fun _ {_current} _occurrence _active => .canonical

def auditAuthoritySource : SourceNativeAuthoritySource
    (ResidualWorld N focus Residual) AuditV where
  restructuringSource := auditRestructuringSource N focus Residual distinguished
  eventInventoryAdmission :=
    .reflOfNoFaithfulTerminal
      (auditRestructuringSource N focus Residual distinguished)
      (fun _ => ⟨fun terminal => nomatch terminal⟩)
  lawSurface := liftTheory focus oldTheory
  projectionLaw := auditFailureProjectionLaw N focus Residual distinguished
    oldTheory oldU7 oldCalculus

def auditAuthoritativeRoot : SourceNativeAuthoritativeRootClosure
    (ResidualWorld N focus Residual) AuditV where
  source := auditAuthoritySource N focus Residual distinguished oldTheory
    oldU7 oldCalculus
  emitted := auditEmitted N focus Residual
  compiler_commutes := fun _ => rfl

def auditLivingRoot : SourceNativeLivingRootClosure
    (ResidualWorld N focus Residual) AuditV :=
  (auditAuthoritativeRoot N focus Residual distinguished oldTheory oldU7
    oldCalculus).toLivingWithoutFaithfulTerminal
      (fun _ => ⟨fun terminal => nomatch terminal⟩)

abbrev auditVisit : SourceNativeTemporalVisitAt
    (auditLivingRoot N focus Residual distinguished oldTheory oldU7 oldCalculus
      ).toAuthoritativeRoot.toLedgerRoot :=
  .finite
    (auditLivingRoot N focus Residual distinguished oldTheory oldU7 oldCalculus
      ).toAuthoritativeRoot.toRoot.initialVisit

def auditInitialGenerated :=
  (auditLivingRoot N focus Residual distinguished oldTheory oldU7 oldCalculus
    ).toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit
      (auditVisit N focus Residual distinguished oldTheory oldU7 oldCalculus)

def auditInitialRow :=
  ((auditInitialGenerated N focus Residual distinguished oldTheory oldU7
    oldCalculus).canonicalGeneratedEntryRow?
      (residualEntry focus distinguished)).get (by rfl)

/-- The selected finite-patch row becomes causal authority of the complete
fixed living source. -/
def auditLivingCausalAuthority :
    SourceNativeLivingTemporalCausalEntryAuthorityAt
      (auditLivingRoot N focus Residual distinguished oldTheory oldU7 oldCalculus)
      (auditVisit N focus Residual distinguished oldTheory oldU7 oldCalculus)
      (residualEntry focus distinguished) :=
  ((SourceNativeLivingTemporalCausalEntryAuthorityAt.generatedFromInitial?
    (auditLivingRoot N focus Residual distinguished oldTheory oldU7 oldCalculus)
    (residualEntry focus distinguished) .initial).get (by rfl)).2

/-- Root fold and extended U7 compiler expose the same row and the same
carried disposition. -/
theorem auditRootDispositionCommutes :
    U7DemandEntryRootDispositionCommutesAt
      (extendedCalculus N focus Residual oldU7 oldCalculus)
      ((extendedCalculus N focus Residual oldU7 oldCalculus).source.emit
        (residualObstruction focus distinguished))
      (residualEntry focus distinguished)
      (((auditLivingRoot N focus Residual distinguished oldTheory oldU7
        oldCalculus).toAuthoritativeRoot.toLedgerRoot.source.ledgerCompiler.compile
          ((auditLivingRoot N focus Residual distinguished oldTheory oldU7
            oldCalculus).emitted
              (auditVisit N focus Residual distinguished oldTheory oldU7
                oldCalculus).current)).entryDisposition
        (residualEntry focus distinguished)) := by
  constructor
  · exact heq_of_eq
      (residual_u7_demand_entry focus oldU7 oldCalculus distinguished).symm
  · rfl

def auditFailureFace : SourceNativeRootExpressibilityFailureFaceAt
    (auditLivingRoot N focus Residual distinguished oldTheory oldU7 oldCalculus
      ).toAuthoritativeRoot
    (auditVisit N focus Residual distinguished oldTheory oldU7 oldCalculus)
    (U7 := extendedU7 N focus Residual oldU7)
    (failure N focus Residual distinguished oldTheory) where
  lawSurface_eq := rfl
  projection := PUnit.unit
  active := PUnit.unit
  classifier_eq := rfl
  calculus := extendedCalculus N focus Residual oldU7 oldCalculus
  u7Event :=
    (extendedCalculus N focus Residual oldU7 oldCalculus).source.emit
      (residualObstruction focus distinguished)
  u7Event_eq_emit := rfl
  theoryAudit := residual_u7_theoryAudit focus oldU7 oldCalculus distinguished
  support_eq := rfl
  rootEntry := residualEntry focus distinguished
  rootEntryAtFailure_eq := rfl
  rootDispositionCommutes := auditRootDispositionCommutes N focus Residual
    distinguished oldTheory oldU7 oldCalculus
  project_heq := HEq.rfl

def auditSuccessor : CausalEntrySuccessorAt
    (auditLivingRoot N focus Residual distinguished oldTheory oldU7 oldCalculus
      ).toAuthoritativeRoot.toLedgerRoot
    (auditVisit N focus Residual distinguished oldTheory oldU7 oldCalculus)
    (residualEntry focus distinguished) :=
  CausalEntrySuccessorAt.ofNonterminal rfl

def auditRootedFailure : RootedActualExpressibilityFailureAt
    (auditLivingRoot N focus Residual distinguished oldTheory oldU7 oldCalculus
      ).toAuthoritativeRoot
    (auditVisit N focus Residual distinguished oldTheory oldU7 oldCalculus)
    (extendedU7 N focus Residual oldU7)
    (failure N focus Residual distinguished oldTheory) :=
  RootedActualExpressibilityFailureAt.ofRootFailureFace
    (auditFailureFace N focus Residual distinguished oldTheory oldU7 oldCalculus)
    (auditLivingCausalAuthority N focus Residual distinguished oldTheory oldU7
      oldCalculus).toAuthoritativeAuthority
    (auditSuccessor N focus Residual distinguished oldTheory oldU7 oldCalculus)

/-- Existing U8 is now a direct consumer of the selected rooted residual. -/
def generatedMinimalCoface : GeneratedMinimalCofaceAt
    (auditRootedFailure N focus Residual distinguished oldTheory oldU7
      oldCalculus) :=
  root_obstruction_generates_minimal_coface
    (auditRootedFailure N focus Residual distinguished oldTheory oldU7
      oldCalculus)

@[simp] theorem generatedDirection_boundary_eq_residual :
    GeneratedDirectionAt.boundary
        (rooted := auditRootedFailure N focus Residual distinguished oldTheory
          oldU7 oldCalculus)
        GeneratedDirectionAt.completion =
      residualObstruction focus distinguished :=
  rfl

end RootedAuthority

end RootGeneratedResidualLivingAuthority
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
