import H0mework.Foundation.Responsibility.DebtLedgerReadback
import H0mework.Foundation.Ledger.OriginOrBirth

/-!
# Source-generated debt admission at an exact first write

Ordinary whole-ledger evolution is deliberately old-origin total.  It cannot
create a row which is fresh relative to the complete source ledger.  Debt
activation therefore has a separate admission occurrence: an actual
`DebtActivationLaw.StepAt` generates the born debt row on the active face and
the first strict whole-ledger payment in one indexed object.

This is an admission fragment, not a living-root installation.  A later root
consumer must still expose the born row in its exact generated initial patch
before `generatedFromInitialRow` can provide living causal authority.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace DebtAdmissionFirstWrite

open DebtActivationLedger DebtActivationWorld

noncomputable section

universe u

variable {N : WorldRelationNetwork.{u}} {law : DebtActivationLaw.{u}}

/-- One source-indexed admission event.  Its target is carried only by the
actual strict step witness. -/
structure SourceFixedDebtAdmissionEventAt
    (law : DebtActivationLaw.{u}) (source : law.DebtState) : Type u where
  target : law.DebtState
  step : law.StepAt source target

def SourceFixedDebtAdmissionEventAt.ofStep
    {source target : law.DebtState}
    (step : law.StepAt source target) :
    SourceFixedDebtAdmissionEventAt law source :=
  ⟨target, step⟩

/-- The debt row is genuinely fresh relative to the complete inactive
sibling face.  Old and debt claims occupy disjoint sum coordinates, while an
inactive debt responsibility has no open witness. -/
def debtEntryFreshAtInactive
    (support : N.Support) (state : law.DebtState) :
    RootDebtFreshAt (ExtendedNetwork N law) ⟨support, none⟩
      (debtEntry (N := N) (law := law) support state) where
  noPrior := by
    intro source sameDebt
    rcases source with ⟨responsibility, opened⟩
    cases responsibility with
    | inl oldResponsibility => exact nomatch sameDebt.claim_eq
    | inr debtId => exact nomatch opened

/-- The activated debt claim holds natively at its born face. -/
def activatedDebtHolds
    (support : N.Support) (state : law.DebtState) :
    (ExtendedNetwork N law).HoldsAt ⟨support, some state⟩
      (debtEntry (N := N) (law := law) support state).claim :=
  ULift.up (PLift.up rfl)

/-- Zero-field source-generation seal.  It accepts an actual step event, not
a caller-selected row, state, target branch, or positive-budget proof. -/
structure SourceGeneratedDebtAdmissionFirstWriteAt
    (support : N.Support) {source : law.DebtState}
    (event : SourceFixedDebtAdmissionEventAt law source) : Type u where
  private mk ::

def generate
    (support : N.Support) {source : law.DebtState}
    (event : SourceFixedDebtAdmissionEventAt law source) :
    SourceGeneratedDebtAdmissionFirstWriteAt support event :=
  .mk

namespace SourceGeneratedDebtAdmissionFirstWriteAt

variable {support : N.Support} {source : law.DebtState}
  {event : SourceFixedDebtAdmissionEventAt law source}

/-- Complete old ledger before admission. -/
def inactive
    (_generated : SourceGeneratedDebtAdmissionFirstWriteAt support event) :
    CompleteLiveLedgerAt (ExtendedNetwork N law) :=
  inactiveLedger (N := N) (law := law) support

/-- Exact born ledger selected by the admission event's source state. -/
def initial
    (_generated : SourceGeneratedDebtAdmissionFirstWriteAt support event) :
    CompleteLiveLedgerAt (ExtendedNetwork N law) :=
  activeLedger (N := N) (law := law) support source

/-- Exact first-payment target ledger read from the step event. -/
def paid
    (_generated : SourceGeneratedDebtAdmissionFirstWriteAt support event) :
    CompleteLiveLedgerAt (ExtendedNetwork N law) :=
  activeLedger (N := N) (law := law) support event.target

/-- The born row is fixed by the law and source state. -/
def initialEntry
    (_generated : SourceGeneratedDebtAdmissionFirstWriteAt support event) :
    OpenResponsibilityAt (ExtendedNetwork N law) ⟨support, some source⟩ :=
  debtEntry (N := N) (law := law) support source

def paidEntry
    (_generated : SourceGeneratedDebtAdmissionFirstWriteAt support event) :
    OpenResponsibilityAt (ExtendedNetwork N law)
      ⟨support, some event.target⟩ :=
  debtEntry (N := N) (law := law) support event.target

/-- Birth provenance is generated, not supplied to the producer mouth. -/
def fresh
    (_generated : SourceGeneratedDebtAdmissionFirstWriteAt support event) :
    RootDebtFreshAt (ExtendedNetwork N law) ⟨support, none⟩
      (debtEntry (N := N) (law := law) support source) :=
  debtEntryFreshAtInactive support source

/-- The born claim's semantic validity is generated by the activated world. -/
def holds
    (_generated : SourceGeneratedDebtAdmissionFirstWriteAt support event) :
    (ExtendedNetwork N law).HoldsAt ⟨support, some source⟩
      (debtEntry (N := N) (law := law) support source).claim :=
  activatedDebtHolds support source

/-- Same-event exact first payment of the entire active ledger. -/
def firstPayment
    (_generated : SourceGeneratedDebtAdmissionFirstWriteAt support event) :
    LedgerWriteEvolutionAt (ExtendedNetwork N law)
      (activeLedger (N := N) (law := law) support source)
      (activeLedger (N := N) (law := law) support event.target) :=
  stepLedgerEvolution (N := N) (law := law) support event.step

/-- Same-event transfer receipt carried by every inherited row. -/
def firstPaymentReceipt
    (_generated : SourceGeneratedDebtAdmissionFirstWriteAt support event) :
    (ExtendedNetwork N law).DispositionAt ⟨support, some source⟩ .transfer :=
  debtStepReceipt (N := N) (law := law) support event.step

@[simp] theorem firstPayment_destination_debt
    (generated : SourceGeneratedDebtAdmissionFirstWriteAt support event) :
    (generated.firstPayment.destination generated.initialEntry).1 =
      generated.paidEntry :=
  stepLedgerEvolution_destination_debt (N := N) (law := law)
    support event.step

/-- Positive initial capacity is a consequence of the actual strict step; it
is not an admission premise. -/
theorem initialBudget_positive
    (_generated : SourceGeneratedDebtAdmissionFirstWriteAt support event) :
    0 < (debtEntry (N := N) (law := law) support source).progressBudget :=
  Nat.zero_lt_of_lt (law.step_budget_lt event.step)

theorem firstPayment_budget_strict
    (_generated : SourceGeneratedDebtAdmissionFirstWriteAt support event) :
    (debtEntry (N := N) (law := law)
        support event.target).progressBudget <
      (debtEntry (N := N) (law := law) support source).progressBudget :=
  law.step_budget_lt event.step

end SourceGeneratedDebtAdmissionFirstWriteAt

/-- Ordinary old-origin evolution cannot implement inactive-to-active birth.
Its mandatory target origin would contradict the born row's freshness. -/
theorem ordinaryEvolution_cannot_admit
    (support : N.Support) (state : law.DebtState) :
    ¬ Nonempty (LedgerWriteEvolutionAt (ExtendedNetwork N law)
        (inactiveLedger (N := N) (law := law) support)
        (activeLedger (N := N) (law := law) support state)) := by
  rintro ⟨evolution⟩
  exact nomatch evolution.excludesTargetFresh
      (debtEntry (N := N) (law := law) support state)
      (debtEntryFreshAtInactive support state)

end

end DebtAdmissionFirstWrite
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid

#print axioms SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot.DebtAdmissionFirstWrite.SourceGeneratedDebtAdmissionFirstWriteAt.initialBudget_positive
#print axioms SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot.DebtAdmissionFirstWrite.ordinaryEvolution_cannot_admit
