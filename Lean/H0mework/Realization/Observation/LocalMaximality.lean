/-
  Proposition 17: local restriction maximality and gluing obstructions.

  Proposition 7 proved restriction/gluing discipline for a single Ω section.
  Proposition 11 proved that `C_safe` is the greatest safe domain for a fixed
  state space.  This file connects those two levels:

    * restriction maps that preserve the seven facets send safe global domains
      into the local `C_safe`;
    * two locally safe sections glue to a globally safe section exactly when no
      semantic facet has a gluing failure;
    * the graph-confluence gluing failure is isolated as the H¹-like term
      generated by non-joinable cross critical pairs.

  The graph result is a certificate shape, not a full Newman lemma: the concrete
  graph runtime still has to prove that its cross-critical-pair predicate is the
  right one for its rewrite system.
-/

import H0mework.Realization.Observation.RuntimeIndependence

/-! ## Restriction: `C_safe` maximality is local -/

/-- A restriction map preserves each of the seven `C_safe` facets from a larger
    state space into a local state space. -/
structure CSafeRestrictionWitness {Global Local : Type*}
    (PG : CSafePredicates Global) (PL : CSafePredicates Local)
    (ρ : Global → Local) where
  sourceBacked : ∀ x, PG.sourceBacked x → PL.sourceBacked (ρ x)
  authoritySafe : ∀ x, PG.authoritySafe x → PL.authoritySafe (ρ x)
  graphConfluent : ∀ x, PG.graphConfluent x → PL.graphConfluent (ρ x)
  gaugeNonleaking : ∀ x, PG.gaugeNonleaking x → PL.gaugeNonleaking (ρ x)
  contractionSafe : ∀ x, PG.contractionSafe x → PL.contractionSafe (ρ x)
  omegaConsistent : ∀ x, PG.omegaConsistent x → PL.omegaConsistent (ρ x)
  freshnessSafe : ∀ x, PG.freshnessSafe x → PL.freshnessSafe (ρ x)

/-- THEOREM 1: `C_safe` itself is preserved by any facet-preserving restriction. -/
theorem cSafe_preserved_by_restriction {Global Local : Type*}
    (PG : CSafePredicates Global) (PL : CSafePredicates Local)
    (ρ : Global → Local)
    (hρ : CSafeRestrictionWitness PG PL ρ) :
    ∀ x, CSafe PG x → CSafe PL (ρ x) := by
  intro x hx
  exact ⟨
    hρ.sourceBacked x hx.1,
    hρ.authoritySafe x hx.2.1,
    hρ.graphConfluent x hx.2.2.1,
    hρ.gaugeNonleaking x hx.2.2.2.1,
    hρ.contractionSafe x hx.2.2.2.2.1,
    hρ.omegaConsistent x hx.2.2.2.2.2.1,
    hρ.freshnessSafe x hx.2.2.2.2.2.2
  ⟩

/-- Image of a domain under a restriction map. -/
def RestrictedDomain {Global Local : Type*}
    (ρ : Global → Local) (D : Global → Prop) : Local → Prop :=
  fun y => ∃ x, D x ∧ ρ x = y

/-- THEOREM 2: the restricted image of any global facet-safe domain is a local
    facet-safe domain. -/
theorem restricted_domainSafetyWitness {Global Local : Type*}
    (PG : CSafePredicates Global) (PL : CSafePredicates Local)
    (ρ : Global → Local)
    (hρ : CSafeRestrictionWitness PG PL ρ)
    (D : Global → Prop) (hD : DomainSafetyWitness PG D) :
    DomainSafetyWitness PL (RestrictedDomain ρ D) where
  sourceBacked := by
    intro y hy
    rcases hy with ⟨x, hxD, rfl⟩
    exact hρ.sourceBacked x (hD.sourceBacked x hxD)
  authoritySafe := by
    intro y hy
    rcases hy with ⟨x, hxD, rfl⟩
    exact hρ.authoritySafe x (hD.authoritySafe x hxD)
  graphConfluent := by
    intro y hy
    rcases hy with ⟨x, hxD, rfl⟩
    exact hρ.graphConfluent x (hD.graphConfluent x hxD)
  gaugeNonleaking := by
    intro y hy
    rcases hy with ⟨x, hxD, rfl⟩
    exact hρ.gaugeNonleaking x (hD.gaugeNonleaking x hxD)
  contractionSafe := by
    intro y hy
    rcases hy with ⟨x, hxD, rfl⟩
    exact hρ.contractionSafe x (hD.contractionSafe x hxD)
  omegaConsistent := by
    intro y hy
    rcases hy with ⟨x, hxD, rfl⟩
    exact hρ.omegaConsistent x (hD.omegaConsistent x hxD)
  freshnessSafe := by
    intro y hy
    rcases hy with ⟨x, hxD, rfl⟩
    exact hρ.freshnessSafe x (hD.freshnessSafe x hxD)

/-- THEOREM 3: local maximality of `C_safe`: restricting any global facet-safe
    domain lands inside the local greatest safe domain. -/
theorem restricted_facet_safe_domain_subset_local_csafe {Global Local : Type*}
    (PG : CSafePredicates Global) (PL : CSafePredicates Local)
    (ρ : Global → Local)
    (hρ : CSafeRestrictionWitness PG PL ρ)
    (D : Global → Prop) (hD : DomainSafetyWitness PG D) :
    PredSubset (RestrictedDomain ρ D) (CSafe PL) := by
  exact domainSafety_subset_csafe PL (RestrictedDomain ρ D)
    (restricted_domainSafetyWitness PG PL ρ hρ D hD)

/-- THEOREM 4: as a special case, the restricted image of global `C_safe` sits
    inside local `C_safe`. -/
theorem restricted_csafe_subset_local_csafe {Global Local : Type*}
    (PG : CSafePredicates Global) (PL : CSafePredicates Local)
    (ρ : Global → Local)
    (hρ : CSafeRestrictionWitness PG PL ρ) :
    PredSubset (RestrictedDomain ρ (CSafe PG)) (CSafe PL) := by
  exact restricted_facet_safe_domain_subset_local_csafe PG PL ρ hρ
    (CSafe PG) (cSafe_domainSafetyWitness PG)

/-! ## Gluing: local safety plus global facet support -/

/-- A gluing operation preserves every `C_safe` facet when each facet has a
    local-to-global gluing rule. -/
structure CSafeGluingWitness {Left Right Global : Type*}
    (PL : CSafePredicates Left) (PR : CSafePredicates Right)
    (PG : CSafePredicates Global) (glue : Left → Right → Global) where
  sourceBacked :
    ∀ l r, PL.sourceBacked l → PR.sourceBacked r →
      PG.sourceBacked (glue l r)
  authoritySafe :
    ∀ l r, PL.authoritySafe l → PR.authoritySafe r →
      PG.authoritySafe (glue l r)
  graphConfluent :
    ∀ l r, PL.graphConfluent l → PR.graphConfluent r →
      PG.graphConfluent (glue l r)
  gaugeNonleaking :
    ∀ l r, PL.gaugeNonleaking l → PR.gaugeNonleaking r →
      PG.gaugeNonleaking (glue l r)
  contractionSafe :
    ∀ l r, PL.contractionSafe l → PR.contractionSafe r →
      PG.contractionSafe (glue l r)
  omegaConsistent :
    ∀ l r, PL.omegaConsistent l → PR.omegaConsistent r →
      PG.omegaConsistent (glue l r)
  freshnessSafe :
    ∀ l r, PL.freshnessSafe l → PR.freshnessSafe r →
      PG.freshnessSafe (glue l r)

/-- THEOREM 5: if every facet glues, two locally safe states glue to a global
    safe state. -/
theorem cSafe_preserved_by_gluing {Left Right Global : Type*}
    (PL : CSafePredicates Left) (PR : CSafePredicates Right)
    (PG : CSafePredicates Global) (glue : Left → Right → Global)
    (hglue : CSafeGluingWitness PL PR PG glue) :
    ∀ l r, CSafe PL l → CSafe PR r → CSafe PG (glue l r) := by
  intro l r hl hr
  exact ⟨
    hglue.sourceBacked l r hl.1 hr.1,
    hglue.authoritySafe l r hl.2.1 hr.2.1,
    hglue.graphConfluent l r hl.2.2.1 hr.2.2.1,
    hglue.gaugeNonleaking l r hl.2.2.2.1 hr.2.2.2.1,
    hglue.contractionSafe l r hl.2.2.2.2.1 hr.2.2.2.2.1,
    hglue.omegaConsistent l r hl.2.2.2.2.2.1 hr.2.2.2.2.2.1,
    hglue.freshnessSafe l r hl.2.2.2.2.2.2 hr.2.2.2.2.2.2
  ⟩

/-- A gluing failure is a semantic atom that holds on both local states but
    fails on the glued global state. This is the support object for global,
    non-local obstructions. -/
def GluingFailureSupport {Left Right Global : Type*}
    (PL : CSafePredicates Left) (PR : CSafePredicates Right)
    (PG : CSafePredicates Global) (glue : Left → Right → Global)
    (l : Left) (r : Right) (a : SemanticAtom) : Prop :=
  semanticHolds PL a l ∧
    semanticHolds PR a r ∧
    ¬ semanticHolds PG a (glue l r)

/-- THEOREM 6: if both local states are safe, global unsafety is exactly a
    nonempty gluing-failure support. -/
theorem gluingFailureSupport_nonempty_iff_local_safe_global_unsafe
    {Left Right Global : Type*}
    (PL : CSafePredicates Left) (PR : CSafePredicates Right)
    (PG : CSafePredicates Global) (glue : Left → Right → Global)
    (l : Left) (r : Right)
    (hl : CSafe PL l) (hr : CSafe PR r) :
    (∃ a, GluingFailureSupport PL PR PG glue l r a) ↔
      ¬ CSafe PG (glue l r) := by
  constructor
  · rintro ⟨a, _hlocL, _hlocR, hfailG⟩
    exact (semanticFailure_nonempty_iff_not_csafe PG (glue l r)).mp
      ⟨a, hfailG⟩
  · intro hunsafe
    have hLAtoms : SafeByAtoms (semanticObligationSemantics PL) l :=
      (semanticSafe_iff_csafe PL l).mpr hl
    have hRAtoms : SafeByAtoms (semanticObligationSemantics PR) r :=
      (semanticSafe_iff_csafe PR r).mpr hr
    rcases (semanticFailure_nonempty_iff_not_csafe PG (glue l r)).mpr
      hunsafe with ⟨a, hfail⟩
    exact ⟨a, hLAtoms a, hRAtoms a, hfail⟩

/-! ## A global taxonomy: local reopen cases plus gluing support -/

/-- Global obstruction vocabulary for a pairwise gluing attempt: local reopen
    on the left, local reopen on the right, or a genuinely global gluing atom. -/
inductive GlobalGluingTaxonomy where
  | left : ReopenTaxonomy → GlobalGluingTaxonomy
  | right : ReopenTaxonomy → GlobalGluingTaxonomy
  | gluing : SemanticAtom → GlobalGluingTaxonomy
  deriving DecidableEq, Repr

/-- Witness predicate for the global gluing taxonomy. -/
def globalGluingWitness {Left Right Global : Type*}
    (PL : CSafePredicates Left) (PR : CSafePredicates Right)
    (PG : CSafePredicates Global) (glue : Left → Right → Global)
    (l : Left) (r : Right) : GlobalGluingTaxonomy → Prop
  | GlobalGluingTaxonomy.left t => taxonomyWitness PL l t
  | GlobalGluingTaxonomy.right t => taxonomyWitness PR r t
  | GlobalGluingTaxonomy.gluing a => GluingFailureSupport PL PR PG glue l r a

/-- THEOREM 7: the global gluing vocabulary is exactly local reopen support plus
    global gluing-failure support. -/
theorem globalGluingWitness_nonempty_iff
    {Left Right Global : Type*}
    (PL : CSafePredicates Left) (PR : CSafePredicates Right)
    (PG : CSafePredicates Global) (glue : Left → Right → Global)
    (l : Left) (r : Right) :
    (∃ t, globalGluingWitness PL PR PG glue l r t) ↔
      (¬ CSafe PL l ∨
        ¬ CSafe PR r ∨
        ∃ a, GluingFailureSupport PL PR PG glue l r a) := by
  constructor
  · rintro ⟨t, ht⟩
    cases t with
    | left tl =>
        exact Or.inl (taxonomyWitness_not_csafe PL l ht)
    | right tr =>
        exact Or.inr (Or.inl (taxonomyWitness_not_csafe PR r ht))
    | gluing a =>
        exact Or.inr (Or.inr ⟨a, ht⟩)
  · intro h
    rcases h with hleft | hrest
    · rcases (taxonomySupport_nonempty_iff_not_csafe PL l).mpr hleft with
        ⟨tl, htl⟩
      exact ⟨GlobalGluingTaxonomy.left tl, htl⟩
    · rcases hrest with hright | hglue
      · rcases (taxonomySupport_nonempty_iff_not_csafe PR r).mpr hright with
          ⟨tr, htr⟩
        exact ⟨GlobalGluingTaxonomy.right tr, htr⟩
      · rcases hglue with ⟨a, ha⟩
        exact ⟨GlobalGluingTaxonomy.gluing a, ha⟩

/-- THEOREM 8: when both local states are safe, the global gluing vocabulary is
    present exactly when the glued global state is unsafe. -/
theorem globalGluingWitness_iff_global_unsafe_of_local_safe
    {Left Right Global : Type*}
    (PL : CSafePredicates Left) (PR : CSafePredicates Right)
    (PG : CSafePredicates Global) (glue : Left → Right → Global)
    (l : Left) (r : Right)
    (hl : CSafe PL l) (hr : CSafe PR r) :
    (∃ t, globalGluingWitness PL PR PG glue l r t) ↔
      ¬ CSafe PG (glue l r) := by
  rw [globalGluingWitness_nonempty_iff PL PR PG glue l r]
  constructor
  · intro h
    rcases h with hleft | hrest
    · exact False.elim (hleft hl)
    · rcases hrest with hright | hglue
      · exact False.elim (hright hr)
      · exact (gluingFailureSupport_nonempty_iff_local_safe_global_unsafe
          PL PR PG glue l r hl hr).mp hglue
  · intro hunsafe
    exact Or.inr (Or.inr
      ((gluingFailureSupport_nonempty_iff_local_safe_global_unsafe
        PL PR PG glue l r hl hr).mpr hunsafe))

/-! ## Graph H¹ generator: cross critical pairs -/

/-- Abstract certificate for graph-confluence gluing.  It says global
    confluence is equivalent to both local confluence facts plus joinability of
    the cross-boundary critical pairs. -/
structure GraphGluingCocycle where
  leftConfluent : Prop
  rightConfluent : Prop
  globalConfluent : Prop
  crossCriticalPairsJoinable : Prop
  global_iff_locals_and_cross :
    globalConfluent ↔
      leftConfluent ∧ rightConfluent ∧ crossCriticalPairsJoinable

/-- A graph H¹-like obstruction: both local graphs are confluent, but their
    glued graph is not. -/
def GraphH1Obstruction (C : GraphGluingCocycle) : Prop :=
  C.leftConfluent ∧ C.rightConfluent ∧ ¬ C.globalConfluent

/-- The generator for the graph H¹-like obstruction: non-joinable critical
    pairs that only appear across the gluing boundary. -/
def GraphH1Generator (C : GraphGluingCocycle) : Prop :=
  C.leftConfluent ∧ C.rightConfluent ∧ ¬ C.crossCriticalPairsJoinable

/-- THEOREM 9: under the graph gluing certificate, the H¹-like obstruction is
    exactly the cross-critical-pair generator. -/
theorem graph_h1_obstruction_iff_cross_generator
    (C : GraphGluingCocycle) :
    GraphH1Obstruction C ↔ GraphH1Generator C := by
  constructor
  · rintro ⟨hL, hR, hnotG⟩
    refine ⟨hL, hR, ?_⟩
    intro hcross
    exact hnotG ((C.global_iff_locals_and_cross).mpr ⟨hL, hR, hcross⟩)
  · rintro ⟨hL, hR, hnotCross⟩
    refine ⟨hL, hR, ?_⟩
    intro hG
    exact hnotCross ((C.global_iff_locals_and_cross).mp hG).2.2

/-- THEOREM 10: the graph component of gluing-failure support is precisely the
    graph H¹ generator once the runtime identifies its graph facet with the
    graph gluing cocycle. -/
theorem graph_gluing_failure_iff_h1_generator
    {Left Right Global : Type*}
    (PL : CSafePredicates Left) (PR : CSafePredicates Right)
    (PG : CSafePredicates Global) (glue : Left → Right → Global)
    (l : Left) (r : Right) (C : GraphGluingCocycle)
    (hL :
      semanticHolds PL SemanticAtom.graphConfluence l ↔ C.leftConfluent)
    (hR :
      semanticHolds PR SemanticAtom.graphConfluence r ↔ C.rightConfluent)
    (hG :
      semanticHolds PG SemanticAtom.graphConfluence (glue l r) ↔
        C.globalConfluent) :
    GluingFailureSupport PL PR PG glue l r SemanticAtom.graphConfluence ↔
      GraphH1Generator C := by
  constructor
  · rintro ⟨hlocalL, hlocalR, hnotGlobal⟩
    have hH1 : GraphH1Obstruction C := by
      refine ⟨hL.mp hlocalL, hR.mp hlocalR, ?_⟩
      intro hGlobal
      exact hnotGlobal (hG.mpr hGlobal)
    exact (graph_h1_obstruction_iff_cross_generator C).mp hH1
  · intro hgen
    have hH1 : GraphH1Obstruction C :=
      (graph_h1_obstruction_iff_cross_generator C).mpr hgen
    exact ⟨hL.mpr hH1.1, hR.mpr hH1.2.1, fun hglobal =>
      hH1.2.2 (hG.mp hglobal)⟩

/-!
  Summary:
  - `cSafe_preserved_by_restriction` and
    `restricted_facet_safe_domain_subset_local_csafe` lift Proposition 7's
    restriction discipline from single Ω sections to the whole `C_safe`
    conjunction.
  - `gluingFailureSupport_nonempty_iff_local_safe_global_unsafe` isolates the
    global term: if both local sections are safe, any failure after gluing is a
    genuinely non-local semantic atom.
  - `globalGluingWitness_*` extends the local reopen taxonomy with global
    gluing atoms.
  - `graph_h1_obstruction_iff_cross_generator` identifies the likely graph
    H¹ generator as non-joinable cross critical pairs, assuming the graph
    runtime supplies the stated gluing certificate.
-/
