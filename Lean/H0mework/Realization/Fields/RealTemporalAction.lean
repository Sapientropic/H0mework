import Mathlib.Algebra.Order.Field.Basic
import Mathlib.Data.Real.Basic
import H0mework.Foundation.Runtime.TemporalAction

/-!
# Real temporal-action adapter

This explicit Mathlib layer interprets the axiom-free temporal grammar over
`Real`.  Its silent/faithful split is a mathematical readout, never a root
branch or an authority token.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot

/-- Real clock/action calculus generated by a fixed scale-to-barrier map. -/
noncomputable abbrev realTemporalActionCalculus
    (barrierFromScale : Real -> Real) :
    SourceNativeTemporalActionCalculus where
  Scalar := Real
  Scale := Real
  barrierFromScale := barrierFromScale
  horizonFromBarrier := fun barrier => 1 / (2 * barrier)
  actionFromClockDensity := fun clock density => clock * density
  potentialDrop := fun source target => source - target
  ScaleAdmissible := fun scale => 0 <= scale
  Nonnegative := fun value => 0 <= value
  Positive := fun value => 0 < value
  LateClockAt := fun horizon clock => horizon / 2 < clock
  ClockWithinAt := fun clock horizon => clock <= horizon

namespace SourceNativeTemporalActionCouplingAt

variable {barrierFromScale : Real -> Real}

/-- Silent and faithful density are exhaustive real-valued readouts.  This
disjunction carries no world authority and cannot select a root branch. -/
theorem real_densityStratum
    (edge : SourceNativeTemporalActionCouplingAt
      (realTemporalActionCalculus barrierFromScale)) :
    edge.density = 0 ∨ 0 < edge.density :=
  (eq_or_lt_of_le edge.density_nonnegative).imp Eq.symm id

/-- On a faithful temporal edge the exact clock is recovered by division;
no lower density bound is manufactured. -/
theorem real_clock_eq_action_div_density
    (edge : SourceNativeTemporalActionCouplingAt
      (realTemporalActionCalculus barrierFromScale))
    (densityPos : 0 < edge.density) :
    edge.clock = edge.action / edge.density := by
  apply (eq_div_iff densityPos.ne').2
  rw [edge.action_eq_clock_density]

/-- A silent density kills the material action but need not kill the clock. -/
theorem real_action_eq_zero_of_density_eq_zero
    (edge : SourceNativeTemporalActionCouplingAt
      (realTemporalActionCalculus barrierFromScale))
    (densityZero : edge.density = 0) :
    edge.action = 0 := by
  have actionEq : edge.action = edge.clock * edge.density := by
    simpa only [realTemporalActionCalculus] using
      edge.action_eq_clock_density
  rw [actionEq, densityZero, mul_zero]

end SourceNativeTemporalActionCouplingAt
end ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
end SaturationMonoid
