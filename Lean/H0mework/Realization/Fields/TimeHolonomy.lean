/-
  Proposition 56: temporal holonomy support as recollection mechanism.

  Proposition 55 placed reflexive obstruction on a time-indexed memory field:
  a recollection write advances one time edge, and an observation mismatch
  along that edge is temporal holonomy.

  This file turns that holonomy into an independent support language.  The left
  side is not a memory taxonomy and not a reflexive-algebra constructor; it is
  the field-side atom "this time edge has observation holonomy".  The right
  side is recollection activation at the edge's current section.  A
  `TemporalHolonomyMechanismBridge` is a strong support isomorphism between
  those two languages.  Once such a bridge exists, the usual support
  consequences follow: nonempty equivalence, greatest silent domains,
  presentation transport/uniqueness, and future trace installation.

  Boundary: this is still a representation theorem shape.  The two-point
  witness proves the shape is nontrivial, but a real runtime must still supply
  the concrete time-edge family and the support-preservation proof.
-/

import H0mework.Realization.Fields.TimeIndexedMemory

/-! ## Holonomy support over time edges -/

/-- The field-side atom generated by a time edge with nontrivial observation
holonomy. -/
inductive TemporalHolonomyAtom where
  | observationHolonomy
  deriving DecidableEq, Repr

/-- Field-side support: a time edge supports the holonomy atom exactly when its
observation changes across the recollection edge. -/
def StepTemporalHolonomySupport
    {Edge Time State Observation ActAtom TraceAtom : Type*}
    (stepOf :
      Edge -> RecollectionTimeStep Time State Observation ActAtom TraceAtom) :
    Edge -> TemporalHolonomyAtom -> Prop :=
  fun edge atom =>
    match atom with
    | TemporalHolonomyAtom.observationHolonomy =>
        TemporalObservationHolonomy (stepOf edge)

/-- Recollection-side support over the same time edges: an act atom is supported
when it fires at the current section of that edge. -/
def StepRecollectionFireSupport
    {Edge Time State Observation ActAtom TraceAtom : Type*}
    (stepOf :
      Edge -> RecollectionTimeStep Time State Observation ActAtom TraceAtom) :
    Edge -> ActAtom -> Prop :=
  fun edge atom =>
    (stepOf edge).loop.act.fires
      ((stepOf edge).field.stateAt ((stepOf edge).now)) atom

/-- THEOREM 1: because `TemporalHolonomyAtom` has one constructor, nonempty
field-side support is exactly temporal holonomy. -/
theorem holonomySupport_nonempty_iff
    {Edge Time State Observation ActAtom TraceAtom : Type*}
    (stepOf :
      Edge -> RecollectionTimeStep Time State Observation ActAtom TraceAtom)
    (edge : Edge) :
    (exists atom, StepTemporalHolonomySupport stepOf edge atom) <->
      TemporalObservationHolonomy (stepOf edge) := by
  constructor
  · rintro ⟨atom, h⟩
    cases atom
    exact h
  · intro h
    exact ⟨TemporalHolonomyAtom.observationHolonomy, h⟩

/-- THEOREM 2: recollection-side nonempty support is exactly recollectable
potential at the edge's current section. -/
theorem recollectionSupport_nonempty_iff
    {Edge Time State Observation ActAtom TraceAtom : Type*}
    (stepOf :
      Edge -> RecollectionTimeStep Time State Observation ActAtom TraceAtom)
    (edge : Edge) :
    (exists atom, StepRecollectionFireSupport stepOf edge atom) <->
      RecollectableMemoryPotential
        (stepOf edge).loop.act
        ((stepOf edge).field.stateAt ((stepOf edge).now)) := by
  rfl

/-! ## Mechanism bridge -/

/-- A bridge saying that temporal holonomy support and recollection activation
are the same support language over a family of time edges. -/
structure TemporalHolonomyMechanismBridge
    (Edge Time State Observation ActAtom TraceAtom : Type*) where
  stepOf :
    Edge -> RecollectionTimeStep Time State Observation ActAtom TraceAtom
  iso :
    StrongSupportIsomorphism Edge TemporalHolonomyAtom ActAtom
      (StepTemporalHolonomySupport stepOf)
      (StepRecollectionFireSupport stepOf)

namespace TemporalHolonomyMechanismBridge

variable {Edge Time State Observation ActAtom TraceAtom O : Type*}

/-- THEOREM 3: under a temporal holonomy bridge, field holonomy is equivalent
to recollectable potential at the current section. -/
theorem holonomy_iff_recollectable
    (B :
      TemporalHolonomyMechanismBridge Edge Time State Observation ActAtom
        TraceAtom)
    (edge : Edge) :
    TemporalObservationHolonomy (B.stepOf edge) <->
      RecollectableMemoryPotential
        (B.stepOf edge).loop.act
        ((B.stepOf edge).field.stateAt ((B.stepOf edge).now)) := by
  calc
    TemporalObservationHolonomy (B.stepOf edge) <->
        (exists atom, StepTemporalHolonomySupport B.stepOf edge atom) :=
      (holonomySupport_nonempty_iff B.stepOf edge).symm
    _ <-> (exists atom, StepRecollectionFireSupport B.stepOf edge atom) :=
      B.iso.pointwiseNonemptyEquivalent edge
    _ <-> RecollectableMemoryPotential
        (B.stepOf edge).loop.act
        ((B.stepOf edge).field.stateAt ((B.stepOf edge).now)) :=
      recollectionSupport_nonempty_iff B.stepOf edge

/-- THEOREM 4: both field-side holonomy support and recollection-side firing
support inherit greatest silent domains. -/
theorem greatestSilentDomains
    (B :
      TemporalHolonomyMechanismBridge Edge Time State Observation ActAtom
        TraceAtom) :
    IsGreatestSupportSilentDomain
        (StepTemporalHolonomySupport B.stepOf)
        (SupportSilentAt (StepTemporalHolonomySupport B.stepOf)) /\
      IsGreatestSupportSilentDomain
        (StepRecollectionFireSupport B.stepOf)
        (SupportSilentAt (StepRecollectionFireSupport B.stepOf)) := by
  exact ⟨supportSilentStates_greatest (StepTemporalHolonomySupport B.stepOf),
    supportSilentStates_greatest (StepRecollectionFireSupport B.stepOf)⟩

/-- THEOREM 5: any field-side holonomy presentation transports to a
recollection-firing presentation. -/
def transportHolonomyPresentationToRecollection
    (B :
      TemporalHolonomyMechanismBridge Edge Time State Observation ActAtom
        TraceAtom)
    (pres : SupportPresentation (StepTemporalHolonomySupport B.stepOf) O) :
    SupportPresentation (StepRecollectionFireSupport B.stepOf) O :=
  B.iso.transportRightPresentation pres

/-- THEOREM 6: any active field-side holonomy generator installs future trace
through the corresponding recollection act. -/
theorem holonomy_support_installs_trace
    (B :
      TemporalHolonomyMechanismBridge Edge Time State Observation ActAtom
        TraceAtom)
    (edge : Edge) (atom : TemporalHolonomyAtom)
    (hhol : StepTemporalHolonomySupport B.stepOf edge atom) :
    TemporalTracePotential (B.stepOf edge) := by
  have hfire :
      StepRecollectionFireSupport B.stepOf edge (B.iso.atomEquiv atom) :=
    (B.iso.support_iff edge atom).mp hhol
  exact recollection_firing_installs_trace_at_next
    (B.stepOf edge) (B.iso.atomEquiv atom) hfire

/-- THEOREM 7: raw temporal holonomy installs future trace under the bridge. -/
theorem temporal_holonomy_installs_trace
    (B :
      TemporalHolonomyMechanismBridge Edge Time State Observation ActAtom
        TraceAtom)
    (edge : Edge)
    (hhol : TemporalObservationHolonomy (B.stepOf edge)) :
    TemporalTracePotential (B.stepOf edge) := by
  exact B.holonomy_support_installs_trace edge
    TemporalHolonomyAtom.observationHolonomy hhol

end TemporalHolonomyMechanismBridge

/-! ## Two-point field/recollection bridge -/

/-- A two-edge family: one edge has holonomy and recollection activation; the
other is already stable. -/
inductive TwoPointHolonomyEdge where
  | active
  | quiescent
  deriving DecidableEq, Repr

/-- A stable time field: both endpoints are already marked. -/
def twoPointStableTimeMemoryField :
    TimeMemoryField TwoPointTime TwoPointTraceState TwoPointObservation where
  stateAt
    | TwoPointTime.before => TwoPointTraceState.changed
    | TwoPointTime.after => TwoPointTraceState.changed
  observe := twoPointRead

/-- The stable edge is advanced by the same write, but has no holonomy and no
current recollection activation. -/
def twoPointStableTimeStep :
    RecollectionTimeStep TwoPointTime TwoPointTraceState TwoPointObservation
      IndependentRecollectionAtom IndependentTraceAtom where
  field := twoPointStableTimeMemoryField
  loop := twoPointRecollectionTraceLoop
  now := TwoPointTime.before
  next := TwoPointTime.after
  observe_eq_read := by
    intro x
    rfl
  next_section_eq_write := by
    simp [twoPointStableTimeMemoryField, twoPointRecollectionTraceLoop,
      twoPointReflexiveQuery, twoPointWrite]

/-- The two-edge family used to prove independence/nontriviality. -/
def twoPointHolonomyStepOf :
    TwoPointHolonomyEdge ->
      RecollectionTimeStep TwoPointTime TwoPointTraceState TwoPointObservation
        IndependentRecollectionAtom IndependentTraceAtom
  | TwoPointHolonomyEdge.active => twoPointRecollectionTimeStep
  | TwoPointHolonomyEdge.quiescent => twoPointStableTimeStep

/-- Atom equivalence between field-side holonomy and the independent
recollection act. -/
def temporalHolonomyRecollectionAtomEquiv :
    TemporalHolonomyAtom ≃ IndependentRecollectionAtom where
  toFun
    | TemporalHolonomyAtom.observationHolonomy =>
        IndependentRecollectionAtom.recollectionCommitted
  invFun
    | IndependentRecollectionAtom.recollectionCommitted =>
        TemporalHolonomyAtom.observationHolonomy
  left_inv := by
    intro atom
    cases atom
    rfl
  right_inv := by
    intro atom
    cases atom
    rfl

/-- THEOREM 8: the two-edge field-side holonomy support realizes both truth
assignments. -/
theorem twoPointTemporalHolonomySupport_independent :
    SupportIndependent TwoPointHolonomyEdge TemporalHolonomyAtom
      (StepTemporalHolonomySupport twoPointHolonomyStepOf) := by
  intro assignment
  by_cases h : assignment TemporalHolonomyAtom.observationHolonomy
  · refine ⟨TwoPointHolonomyEdge.active, ?_⟩
    intro atom
    cases atom
    simp [StepTemporalHolonomySupport, twoPointHolonomyStepOf,
      twoPoint_temporal_holonomy, h]
  · refine ⟨TwoPointHolonomyEdge.quiescent, ?_⟩
    intro atom
    cases atom
    simp [StepTemporalHolonomySupport, twoPointHolonomyStepOf,
      twoPointStableTimeStep, TemporalObservationHolonomy,
      twoPointStableTimeMemoryField, twoPointRead, h]

/-- THEOREM 9: the two-edge recollection-firing support realizes both truth
assignments. -/
theorem twoPointStepRecollectionSupport_independent :
    SupportIndependent TwoPointHolonomyEdge IndependentRecollectionAtom
      (StepRecollectionFireSupport twoPointHolonomyStepOf) := by
  intro assignment
  by_cases h : assignment IndependentRecollectionAtom.recollectionCommitted
  · refine ⟨TwoPointHolonomyEdge.active, ?_⟩
    intro atom
    cases atom
    simp [StepRecollectionFireSupport, twoPointHolonomyStepOf,
      twoPointRecollectionTimeStep, twoPointTimeMemoryField,
      twoPointRecollectionTraceLoop, independentTwoPointRecollectionAct, h]
  · refine ⟨TwoPointHolonomyEdge.quiescent, ?_⟩
    intro atom
    cases atom
    simp [StepRecollectionFireSupport, twoPointHolonomyStepOf,
      twoPointStableTimeStep, twoPointStableTimeMemoryField,
      twoPointRecollectionTraceLoop, independentTwoPointRecollectionAct, h]

/-- THEOREM 10: field-side holonomy support is nontrivial in the two-edge
witness. -/
theorem twoPointTemporalHolonomySupport_nontrivial :
    SupportNontrivial TwoPointHolonomyEdge TemporalHolonomyAtom
      (StepTemporalHolonomySupport twoPointHolonomyStepOf) := by
  constructor
  · exact ⟨TwoPointHolonomyEdge.active,
      TemporalHolonomyAtom.observationHolonomy,
      twoPoint_temporal_holonomy⟩
  · refine ⟨TwoPointHolonomyEdge.quiescent, ?_⟩
    intro atom h
    cases atom
    simp [StepTemporalHolonomySupport, twoPointHolonomyStepOf,
      twoPointStableTimeStep, TemporalObservationHolonomy,
      twoPointStableTimeMemoryField, twoPointRead] at h

/-- THEOREM 11: recollection-side firing support is nontrivial in the two-edge
witness. -/
theorem twoPointStepRecollectionSupport_nontrivial :
    SupportNontrivial TwoPointHolonomyEdge IndependentRecollectionAtom
      (StepRecollectionFireSupport twoPointHolonomyStepOf) := by
  constructor
  · exact ⟨TwoPointHolonomyEdge.active,
      IndependentRecollectionAtom.recollectionCommitted,
      twoPoint_silent_recollection_fires⟩
  · refine ⟨TwoPointHolonomyEdge.quiescent, ?_⟩
    intro atom h
    cases atom
    simp [StepRecollectionFireSupport, twoPointHolonomyStepOf,
      twoPointStableTimeStep, twoPointStableTimeMemoryField,
      twoPointRecollectionTraceLoop, independentTwoPointRecollectionAct] at h

/-- THEOREM 12: in the two-edge witness, field-side holonomy support and
recollection firing support agree pointwise under the atom equivalence. -/
theorem twoPoint_holonomy_iff_recollectionSupport
    (edge : TwoPointHolonomyEdge) :
    StepTemporalHolonomySupport twoPointHolonomyStepOf edge
        TemporalHolonomyAtom.observationHolonomy <->
      StepRecollectionFireSupport twoPointHolonomyStepOf edge
        IndependentRecollectionAtom.recollectionCommitted := by
  cases edge <;>
    simp [StepTemporalHolonomySupport, StepRecollectionFireSupport,
      twoPointHolonomyStepOf, twoPointRecollectionTimeStep,
      twoPointTimeMemoryField, twoPointStableTimeStep,
      twoPointStableTimeMemoryField, TemporalObservationHolonomy,
      twoPointRead, twoPointRecollectionTraceLoop,
      independentTwoPointRecollectionAct]

/-- THEOREM 13: the two-edge field holonomy support and recollection activation
form a strong support isomorphism. -/
def twoPointTemporalHolonomyRecollectionIso :
    StrongSupportIsomorphism TwoPointHolonomyEdge TemporalHolonomyAtom
      IndependentRecollectionAtom
      (StepTemporalHolonomySupport twoPointHolonomyStepOf)
      (StepRecollectionFireSupport twoPointHolonomyStepOf) where
  leftIndependent := twoPointTemporalHolonomySupport_independent
  rightIndependent := twoPointStepRecollectionSupport_independent
  leftNontrivial := twoPointTemporalHolonomySupport_nontrivial
  rightNontrivial := twoPointStepRecollectionSupport_nontrivial
  atomEquiv := temporalHolonomyRecollectionAtomEquiv
  support_iff := by
    intro edge atom
    cases atom
    exact twoPoint_holonomy_iff_recollectionSupport edge

/-- The two-point temporal holonomy/recollection bridge. -/
def twoPointTemporalHolonomyMechanismBridge :
    TemporalHolonomyMechanismBridge TwoPointHolonomyEdge TwoPointTime
      TwoPointTraceState TwoPointObservation IndependentRecollectionAtom
      IndependentTraceAtom where
  stepOf := twoPointHolonomyStepOf
  iso := twoPointTemporalHolonomyRecollectionIso

/-- THEOREM 14: in the two-point bridge, temporal holonomy is equivalent to
recollectable potential at the edge's current section. -/
theorem twoPoint_holonomy_iff_recollectable
    (edge : TwoPointHolonomyEdge) :
    TemporalObservationHolonomy (twoPointHolonomyStepOf edge) <->
      RecollectableMemoryPotential
        (twoPointHolonomyStepOf edge).loop.act
        ((twoPointHolonomyStepOf edge).field.stateAt
          ((twoPointHolonomyStepOf edge).now)) := by
  exact TemporalHolonomyMechanismBridge.holonomy_iff_recollectable
    twoPointTemporalHolonomyMechanismBridge edge

/-- THEOREM 15: in the two-point bridge, active temporal holonomy installs
future trace. -/
theorem twoPoint_bridge_holonomy_installs_trace :
    TemporalTracePotential
      (twoPointHolonomyStepOf TwoPointHolonomyEdge.active) := by
  exact TemporalHolonomyMechanismBridge.temporal_holonomy_installs_trace
    twoPointTemporalHolonomyMechanismBridge
    TwoPointHolonomyEdge.active
    twoPoint_temporal_holonomy

/-!
  Summary:
  - `TemporalHolonomyAtom` is the field-side generator: a time edge has
    observation holonomy.
  - `TemporalHolonomyMechanismBridge` says that this field-side generator and
    recollection activation are strongly support-isomorphic over a family of
    time edges.
  - The two-edge witness is independent and nontrivial on both sides, and it
    inherits trace installation through Proposition 55.
-/
