/-
  Proposition 470: question/answer as a complement pair.

  P469 proves that `Null` is not a closed singleton under the complement
  involution in any nontrivial carrier.  This file records the next small
  algebraic spine behind the prose

      "why" and "because" are two readings of one complement pair.

  A point determines its complement uniquely, and the complement determines the
  original point uniquely.  The two-point orbit `{x, complement x}` is always
  closed under complement.  It collapses to a singleton exactly at the
  self-dual midpoint `1/2`.

  Boundary: the labels "question" and "answer" are interpretive names for the
  two coordinates.  The proved content is the uniqueness/closure/collapse
  algebra of the complement orbit.
-/

import H0mework.Realization.Claims.P469

namespace SaturationMonoid
namespace AffineRelaxation

/-! ## Generated complement pairs -/

/-- The complement orbit generated by a point. -/
def generatedComplementPair {K : Type*} [One K] [Sub K] (x : K) : Set K :=
  ({x, complement x} : Set K)

/-- A named complement pair: `answer` is the complement of `question`. -/
structure WhyBecausePair (K : Type*) [One K] [Sub K] where
  question : K
  answer : K
  answer_eq_complement : answer = complement question

namespace WhyBecausePair

/-- THEOREM 1: a named complement pair is symmetric; the question is the
complement of the answer. -/
theorem question_eq_complement_answer
    {K : Type*} [Ring K] (P : WhyBecausePair K) :
    P.question = complement P.answer := by
  simpa [P.answer_eq_complement] using
    (complement_involutive P.question).symm

end WhyBecausePair

/-- The canonical pair generated by a single point. -/
def whyBecausePairOf {K : Type*} [One K] [Sub K] (x : K) :
    WhyBecausePair K where
  question := x
  answer := complement x
  answer_eq_complement := rfl

/-! ## Uniqueness: each side determines the other -/

/-- THEOREM 2: every point has a unique complement-answer. -/
theorem complement_answer_unique
    {K : Type*} [One K] [Sub K] (question : K) :
    ∃! answer : K, answer = complement question := by
  refine ⟨complement question, rfl, ?_⟩
  intro answer hanswer
  exact hanswer

/-- THEOREM 3: in a ring carrier, every answer determines the unique
question whose complement it is. -/
theorem complement_question_unique
    {K : Type*} [Ring K] (answer : K) :
    ∃! question : K, answer = complement question := by
  refine ⟨complement answer, ?_, ?_⟩
  · exact (complement_involutive answer).symm
  · intro question hquestion
    have hcomp : complement answer = question := by
      simpa [hquestion] using complement_involutive question
    exact hcomp.symm

/-! ## Closure and collapse of the generated pair -/

/-- THEOREM 4: the complement pair generated by any point is closed under
complement. -/
theorem generatedComplementPair_closed
    {K : Type*} [Ring K] (x : K) :
    ComplementClosed (generatedComplementPair x) := by
  intro y hy
  rcases hy with hy | hy
  · subst y
    right
    rfl
  · subst y
    left
    exact complement_involutive x

/-- THEOREM 5: a singleton is complement-closed exactly when its point is
self-complementary. -/
theorem singleton_complementClosed_iff_selfComplement
    {K : Type*} [Ring K] (x : K) :
    ComplementClosed ({x} : Set K) ↔ complement x = x := by
  constructor
  · intro hclosed
    have hmem : complement x ∈ ({x} : Set K) := hclosed (by simp)
    simpa using hmem
  · intro hself y hy
    have hyx : y = x := by simpa using hy
    subst y
    simp [hself]

/-- THEOREM 6: over an ordered field, a complement-closed singleton is exactly
the midpoint `1/2`. -/
theorem singleton_complementClosed_iff_eq_half
    {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K] (x : K) :
    ComplementClosed ({x} : Set K) ↔ x = (1 : K) / 2 := by
  rw [singleton_complementClosed_iff_selfComplement,
    complement_eq_self_iff_eq_half]

/-- THEOREM 7: the generated complement pair collapses to the singleton `{x}`
exactly when `x` is self-complementary. -/
theorem generatedComplementPair_eq_singleton_iff_selfComplement
    {K : Type*} [Ring K] (x : K) :
    generatedComplementPair x = ({x} : Set K) ↔ complement x = x := by
  constructor
  · intro hset
    have hmem : complement x ∈ generatedComplementPair x := by
      right
      rfl
    have hmem' : complement x ∈ ({x} : Set K) := by
      simpa [hset] using hmem
    simpa using hmem'
  · intro hself
    ext y
    simp [generatedComplementPair, hself]

/-- THEOREM 8: over an ordered field, the generated complement pair collapses
exactly at the midpoint `1/2`. -/
theorem generatedComplementPair_eq_singleton_iff_eq_half
    {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K] (x : K) :
    generatedComplementPair x = ({x} : Set K) ↔ x = (1 : K) / 2 := by
  rw [generatedComplementPair_eq_singleton_iff_selfComplement,
    complement_eq_self_iff_eq_half]

/-- THEOREM 9: away from the midpoint, the two generated coordinates are
distinct. -/
theorem generatedComplementPair_distinct_of_ne_half
    {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
    {x : K} (hx : x ≠ (1 : K) / 2) :
    x ≠ complement x := by
  intro hsame
  have hself : complement x = x := hsame.symm
  exact hx ((complement_eq_self_iff_eq_half x).mp hself)

/-! ## Bundled receipt -/

/-- A compact receipt for the question/answer complement-pair layer. -/
structure WhyBecauseComplementReceipt
    (K : Type*) [Field K] [LinearOrder K] [IsStrictOrderedRing K] : Prop where
  answer_unique :
    ∀ question : K, ∃! answer : K, answer = complement question
  question_unique :
    ∀ answer : K, ∃! question : K, answer = complement question
  pair_closed :
    ∀ x : K, ComplementClosed (generatedComplementPair x)
  singleton_closed_iff_midpoint :
    ∀ x : K, ComplementClosed ({x} : Set K) ↔ x = (1 : K) / 2
  pair_collapses_iff_midpoint :
    ∀ x : K, generatedComplementPair x = ({x} : Set K) ↔
      x = (1 : K) / 2

/-- THEOREM 10: every ordered field carrier has the complement-pair receipt. -/
theorem whyBecauseComplementReceipt
    (K : Type*) [Field K] [LinearOrder K] [IsStrictOrderedRing K] :
    WhyBecauseComplementReceipt K where
  answer_unique := complement_answer_unique
  question_unique := complement_question_unique
  pair_closed := generatedComplementPair_closed
  singleton_closed_iff_midpoint := singleton_complementClosed_iff_eq_half
  pair_collapses_iff_midpoint :=
    generatedComplementPair_eq_singleton_iff_eq_half

end AffineRelaxation
end SaturationMonoid
