import H0mework.Realization.Operations.ScalarRelations

/-!
# Integer specialization of source operation relations

The original integer API directly consumes the scalar relation producer. Formal
words, generated update squares, complete residual fibres and substitution maps
are the integer instances of the same implementation.
-/

set_option autoImplicit false

universe u v w w'

namespace SaturationMonoid.SourceOperationRelations

open SourceOperationEffects
open ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot.SourceGeneratedScalarDifferentialResidual

noncomputable section

variable {Sorts : Type u} (Value : Sorts → Type v) (Var : Sorts → Type w)
  [∀ s, AddCommGroup (Value s)]

abbrev Formal (s : Sorts) := SourceOperationScalarRelations.Formal ℤ Value Var s

variable {Value Var} {Var' : Sorts → Type w'} {s : Sorts}

abbrev evaluation (ρ : Env Value Var) : Formal Value Var s →ₗ[ℤ] Value s :=
  SourceOperationScalarRelations.evaluation (R := ℤ) (s := s) ρ

abbrev effectEvaluator (ρ δ : Env Value Var) : Formal Value Var s →ₗ[ℤ] Value s :=
  SourceOperationScalarRelations.effectEvaluator (R := ℤ) (s := s) ρ δ

theorem evaluation_update (ρ δ : Env Value Var) :
    evaluation (s := s) (ρ + δ) = evaluation ρ + effectEvaluator ρ δ :=
  SourceOperationScalarRelations.evaluation_update (R := ℤ) (s := s) ρ δ

/-- Retain the complete old relation and its independently generated effect
before the addition readout. -/
abbrev updateInventory (ρ δ : Env Value Var) :
    Formal Value Var s →ₗ[ℤ] Value s × Value s :=
  SourceOperationScalarRelations.updateInventory (R := ℤ) (s := s) ρ δ

abbrev additionReadout : Value s × Value s →ₗ[ℤ] Value s :=
  SourceOperationScalarRelations.additionReadout (R := ℤ) (Value := Value) (s := s)

abbrev updateMorphism (ρ δ : Env Value Var) :
    Morphism (updateInventory (s := s) ρ δ) (evaluation (s := s) (ρ + δ)) :=
  SourceOperationScalarRelations.updateMorphism (R := ℤ) (s := s) ρ δ

/-- The existing coimage functor consumes the generated update square. -/
theorem update_residual_from_inventory (ρ δ : Env Value Var)
    (relation : Formal Value Var s) :
    inducedResidualMap (updateMorphism ρ δ)
      (canonicalResidual (updateInventory ρ δ) relation) =
        canonicalResidual (evaluation (ρ + δ)) relation :=
  SourceOperationScalarRelations.update_residual_from_inventory (R := ℤ) (s := s) ρ δ relation

theorem updated_residual_readout (ρ δ : Env Value Var)
    (relation : Formal Value Var s) :
    (residualEquivRange (evaluation (ρ + δ))
      (canonicalResidual (evaluation (ρ + δ)) relation)).val =
        evaluation ρ relation + effectEvaluator ρ δ relation :=
  SourceOperationScalarRelations.updated_residual_readout (R := ℤ) (s := s) ρ δ relation

theorem old_relation_updated_residual (ρ δ : Env Value Var)
    (relation : Formal Value Var s) (old_relation : evaluation ρ relation = 0) :
    (residualEquivRange (evaluation (ρ + δ))
      (canonicalResidual (evaluation (ρ + δ)) relation)).val =
        effectEvaluator ρ δ relation :=
  SourceOperationScalarRelations.old_relation_updated_residual (R := ℤ) (s := s)
    ρ δ relation old_relation

theorem old_relation_updated_zero_iff (ρ δ : Env Value Var)
    (relation : Formal Value Var s) (old_relation : evaluation ρ relation = 0) :
    canonicalResidual (evaluation (ρ + δ)) relation = 0 ↔
      effectEvaluator ρ δ relation = 0 :=
  SourceOperationScalarRelations.old_relation_updated_zero_iff (R := ℤ) (s := s)
    ρ δ relation old_relation

theorem old_relation_updated_nonzero_iff (ρ δ : Env Value Var)
    (relation : Formal Value Var s) (old_relation : evaluation ρ relation = 0) :
    canonicalResidual (evaluation (ρ + δ)) relation ≠ 0 ↔
      effectEvaluator ρ δ relation ≠ 0 :=
  SourceOperationScalarRelations.old_relation_updated_nonzero_iff (R := ℤ) (s := s)
    ρ δ relation old_relation

/-- Every representative in the residual fibre is retained, exactly modulo
the generated evaluation kernel. -/
theorem residual_fibre_iff (ρ : Env Value Var)
    (left right : Formal Value Var s) :
    canonicalResidual (evaluation ρ) left = canonicalResidual (evaluation ρ) right ↔
      left - right ∈ LinearMap.ker (evaluation ρ) :=
  SourceOperationScalarRelations.residual_fibre_iff (R := ℤ) (s := s) ρ left right

/-- The update factors uniquely through the existing coimage of the complete
old/effect inventory; kernel compatibility is generated by the update square. -/
theorem updated_evaluation_factorization (ρ δ : Env Value Var) :
    ∃! factor : ResidualCarrier (updateInventory (s := s) ρ δ) →ₗ[ℤ] Value s,
      factor.comp (canonicalResidual (updateInventory ρ δ)) = evaluation (ρ + δ) :=
  SourceOperationScalarRelations.updated_evaluation_factorization (R := ℤ) (s := s) ρ δ

abbrev substitution (σ : ∀ t, Var t → Expr Value Var' t) :
    Formal Value Var s →ₗ[ℤ] Formal Value Var' s :=
  SourceOperationScalarRelations.substitution (R := ℤ) (s := s) σ

theorem evaluation_substitution (σ : ∀ t, Var t → Expr Value Var' t)
    (ρ : Env Value Var') :
    (evaluation (s := s) ρ).comp (substitution σ) =
      evaluation (fun t x => (σ t x).eval ρ) :=
  SourceOperationScalarRelations.evaluation_substitution (R := ℤ) (s := s) σ ρ

theorem effectEvaluator_substitution (σ : ∀ t, Var t → Expr Value Var' t)
    (ρ δ : Env Value Var') :
    (effectEvaluator (s := s) ρ δ).comp (substitution σ) =
      effectEvaluator (fun t x => (σ t x).eval ρ) (fun t x => (σ t x).effect ρ δ) :=
  SourceOperationScalarRelations.effectEvaluator_substitution (R := ℤ) (s := s) σ ρ δ

abbrev substitutionMorphism (σ : ∀ t, Var t → Expr Value Var' t)
    (ρ : Env Value Var') :
    Morphism (evaluation (s := s) (fun t x => (σ t x).eval ρ)) (evaluation (s := s) ρ) :=
  SourceOperationScalarRelations.substitutionMorphism (R := ℤ) (s := s) σ ρ

theorem substitution_residual_naturality (σ : ∀ t, Var t → Expr Value Var' t)
    (ρ : Env Value Var') (relation : Formal Value Var s) :
    inducedResidualMap (substitutionMorphism σ ρ)
      (canonicalResidual (evaluation (fun t x => (σ t x).eval ρ)) relation) =
        canonicalResidual (evaluation ρ) (substitution σ relation) :=
  SourceOperationScalarRelations.substitution_residual_naturality (R := ℤ) (s := s) σ ρ relation

abbrev effectSubstitutionMorphism (σ : ∀ t, Var t → Expr Value Var' t)
    (ρ δ : Env Value Var') :
    Morphism
      (effectEvaluator (s := s) (fun t x => (σ t x).eval ρ)
        (fun t x => (σ t x).effect ρ δ)) (effectEvaluator (s := s) ρ δ) :=
  SourceOperationScalarRelations.effectSubstitutionMorphism (R := ℤ) (s := s) σ ρ δ

theorem effect_substitution_residual_naturality (σ : ∀ t, Var t → Expr Value Var' t)
    (ρ δ : Env Value Var') (relation : Formal Value Var s) :
    inducedResidualMap (effectSubstitutionMorphism σ ρ δ)
      (canonicalResidual
        (effectEvaluator (fun t x => (σ t x).eval ρ) (fun t x => (σ t x).effect ρ δ))
        relation) = canonicalResidual (effectEvaluator ρ δ) (substitution σ relation) :=
  SourceOperationScalarRelations.effect_substitution_residual_naturality (R := ℤ) (s := s)
    σ ρ δ relation

end

end SaturationMonoid.SourceOperationRelations
