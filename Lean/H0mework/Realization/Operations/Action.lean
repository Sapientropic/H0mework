import H0mework.Foundation.Relations.ScalarDifferentialResidual

/-! An actual source action generates its effect on the complete observation
fibre. The current/next joint observation retains precisely the two source
reads; no target action, commuting square or outcome selector is an input. -/

set_option autoImplicit false

namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace SourceGeneratedObservationAction

open SourceGeneratedScalarDifferentialResidual

noncomputable section

universe r c b
variable {R : Type r} [CommRing R]
variable {C : Type c} {B : Type b}
variable [AddCommGroup C] [Module R C] [AddCommGroup B] [Module R B]
variable (action : C →ₗ[R] C) (observation : C →ₗ[R] B)

/-- The actual next observation on the complete current invisible fibre. -/
def actionDefect : LinearMap.ker observation →ₗ[R] ResidualCarrier observation :=
  ((canonicalResidual observation).comp action).comp (LinearMap.ker observation).subtype

theorem actionDefect_eq_zero_iff :
    actionDefect action observation = 0 ↔
      LinearMap.ker observation ≤ LinearMap.ker ((canonicalResidual observation).comp action) := by
  constructor
  · intro vanishes value invisible
    exact LinearMap.congr_fun vanishes ⟨value, invisible⟩
  · intro invariant
    apply LinearMap.ext
    intro value
    exact invariant value.property

theorem action_exists_unique_iff :
    (∃! next : ResidualCarrier observation →ₗ[R] ResidualCarrier observation,
      next.comp (canonicalResidual observation) = (canonicalResidual observation).comp action) ↔
      actionDefect action observation = 0 := by
  constructor
  · rintro ⟨next, square, _⟩
    apply (actionDefect_eq_zero_iff action observation).mpr
    intro value invisible
    have atValue := LinearMap.congr_fun square value
    rw [LinearMap.comp_apply,
      (canonicalResidual_eq_zero_iff observation value).mpr invisible, map_zero] at atValue
    exact atValue.symm
  · intro vanishes
    exact universal_factorization observation
      ((canonicalResidual observation).comp action)
      ((actionDefect_eq_zero_iff action observation).mp vanishes)

/-- A same-current-observation fibre retains its exact next-observation difference. -/
theorem fibre_action_equation (left right : C) (same : observation left = observation right) :
    canonicalResidual observation (action left) - canonicalResidual observation (action right) =
      actionDefect action observation
        ⟨left - right, by simp only [LinearMap.mem_ker, map_sub, same, sub_self]⟩ := by
  change _ = canonicalResidual observation (action (left - right))
  rw [map_sub, map_sub]

theorem actionDefect_value_zero_iff (value : LinearMap.ker observation) :
    actionDefect action observation value = 0 ↔ observation (action value) = 0 :=
  canonicalResidual_eq_zero_iff observation (action value)

theorem no_action_of_visible_fibre (value : LinearMap.ker observation)
    (visible : observation (action value) ≠ 0) :
    ¬ ∃ next : ResidualCarrier observation →ₗ[R] ResidualCarrier observation,
      next.comp (canonicalResidual observation) = (canonicalResidual observation).comp action := by
  rintro ⟨next, square⟩
  have atValue := LinearMap.congr_fun square value
  rw [LinearMap.comp_apply,
    (canonicalResidual_eq_zero_iff observation value).mpr value.property, map_zero] at atValue
  exact visible ((canonicalResidual_eq_zero_iff observation (action value)).mp atValue.symm)

/-- Keep exactly the current observation and the next read generated by the actual action. -/
def jointObservation : C →ₗ[R] B × B :=
  observation.prod (observation.comp action)

def jointCurrent : ResidualCarrier (jointObservation action observation) →ₗ[R]
    ResidualCarrier observation :=
  (LinearMap.ker (jointObservation action observation)).liftQ
    (canonicalResidual observation) (by
      intro value invisible
      apply (canonicalResidual_eq_zero_iff observation value).mpr
      exact congrArg Prod.fst invisible)

def jointNext : ResidualCarrier (jointObservation action observation) →ₗ[R]
    ResidualCarrier observation :=
  (LinearMap.ker (jointObservation action observation)).liftQ
    ((canonicalResidual observation).comp action) (by
      intro value invisible
      apply (canonicalResidual_eq_zero_iff observation (action value)).mpr
      exact congrArg Prod.snd invisible)

theorem joint_current_source (value : C) :
    jointCurrent action observation
      (canonicalResidual (jointObservation action observation) value) =
      canonicalResidual observation value := rfl

theorem joint_next_source (value : C) :
    jointNext action observation
      (canonicalResidual (jointObservation action observation) value) =
      canonicalResidual observation (action value) := rfl

theorem joint_fibre_iff (left right : C) :
    canonicalResidual (jointObservation action observation) left =
      canonicalResidual (jointObservation action observation) right ↔
      observation left = observation right ∧
        observation (action left) = observation (action right) := by
  rw [← sub_eq_zero, ← map_sub, canonicalResidual_eq_zero_iff,
    map_sub, sub_eq_zero]
  exact Prod.ext_iff

end
end SourceGeneratedObservationAction
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
