/-
  Proposition 85: quotient support coverage as a singleton-failure query basis.

  Proposition 84 pinned the remaining memory/obstruction bridge obligation to
  quotient support coverage.  Proposition 42 pinned generated-query
  completeness to atom-equivalence coverage.  This file connects those two
  threads at the exact strength the memory bridge needs.

  The bridge does not need arbitrary Boolean-query expressibility.  It needs a
  stricter basis theorem: every quotient memory support is generated by one
  primitive failure query, and every primitive failure query is represented by
  some quotient memory support.

  Boundary: this still does not prove that the seven semantic atoms are a
  complete safety vocabulary.  It proves that, once quotient memory atoms are
  used, the required coverage is exactly singleton-failure query coverage, not
  a looser "some Boolean formula happens to express it" condition.
-/

import H0mework.Realization.QuerySupport.P84
import H0mework.Realization.Reflexive.TruthTable

/-! ## Singleton failure queries -/

/-- The Boolean query that observes failure of one primitive semantic atom. -/
def singletonFailureQuery (a : SemanticAtom) : BoolQuery SemanticAtom :=
  BoolQuery.neg (BoolQuery.atom a)

/-- THEOREM 1: a singleton failure query evaluates exactly to failure of its
semantic atom. -/
theorem singletonFailureQuery_eval_iff {State : Type*}
    (P : CSafePredicates State) (a : SemanticAtom) (x : State) :
    BoolQuery.eval (semanticObligationSemantics P)
      (singletonFailureQuery a) x <->
      AtomFailure (semanticObligationSemantics P) x a := by
  rfl

/-! ## Query-basis form of quotient support coverage -/

/-- Every quotient memory support is generated by a singleton primitive failure
query. -/
def QuotientMemorySupportGeneratedBySingletonFailure
    {State MemoryAtom : Type*}
    (P : CSafePredicates State)
    (M : MemoryProductionContract State MemoryAtom) : Prop :=
  forall q : MemorySupportQuotient M,
    exists a : SemanticAtom,
      forall x,
        (memorySupportQuotientContract M).produces x q <->
          BoolQuery.eval (semanticObligationSemantics P)
            (singletonFailureQuery a) x

/-- Every primitive semantic failure query is represented by some quotient
memory support. -/
def SingletonFailureGeneratedByQuotientMemorySupport
    {State MemoryAtom : Type*}
    (P : CSafePredicates State)
    (M : MemoryProductionContract State MemoryAtom) : Prop :=
  forall a : SemanticAtom,
    exists q : MemorySupportQuotient M,
      forall x,
        (memorySupportQuotientContract M).produces x q <->
          BoolQuery.eval (semanticObligationSemantics P)
            (singletonFailureQuery a) x

/-- Singleton-failure query coverage is the query-algebraic form of P84's
quotient support coverage. -/
def SingletonFailureQueryCoverage {State MemoryAtom : Type*}
    (P : CSafePredicates State)
    (M : MemoryProductionContract State MemoryAtom) : Prop :=
  QuotientMemorySupportGeneratedBySingletonFailure P M /\
    SingletonFailureGeneratedByQuotientMemorySupport P M

/-! ## Equivalence with P84 support coverage -/

/-- THEOREM 2: memory-to-semantic quotient support coverage is exactly
generation by singleton primitive failure queries. -/
theorem quotientMemoryCovered_iff_singletonGenerated
    {State MemoryAtom : Type*}
    (P : CSafePredicates State)
    (M : MemoryProductionContract State MemoryAtom) :
    QuotientMemorySupportCovered P M <->
      QuotientMemorySupportGeneratedBySingletonFailure P M := by
  constructor
  · intro hcovered q
    rcases hcovered q with ⟨a, hsupport⟩
    refine ⟨a, ?_⟩
    intro x
    exact (hsupport x).trans
      (singletonFailureQuery_eval_iff P a x).symm
  · intro hgenerated q
    rcases hgenerated q with ⟨a, hquery⟩
    refine ⟨a, ?_⟩
    intro x
    exact (hquery x).trans
      (singletonFailureQuery_eval_iff P a x)

/-- THEOREM 3: semantic-to-memory quotient support coverage is exactly
representation of every singleton primitive failure query. -/
theorem semanticCovered_iff_singletonRepresented
    {State MemoryAtom : Type*}
    (P : CSafePredicates State)
    (M : MemoryProductionContract State MemoryAtom) :
    SemanticSupportCoveredByQuotientMemory P M <->
      SingletonFailureGeneratedByQuotientMemorySupport P M := by
  constructor
  · intro hcovered a
    rcases hcovered a with ⟨q, hsupport⟩
    refine ⟨q, ?_⟩
    intro x
    exact (hsupport x).trans
      (singletonFailureQuery_eval_iff P a x).symm
  · intro hrepresented a
    rcases hrepresented a with ⟨q, hquery⟩
    refine ⟨q, ?_⟩
    intro x
    exact (hquery x).trans
      (singletonFailureQuery_eval_iff P a x)

/-- THEOREM 4: P84's quotient support coverage is equivalent to singleton
failure query coverage. -/
theorem quotientSupportCoverage_iff_singletonFailureQueryCoverage
    {State MemoryAtom : Type*}
    (P : CSafePredicates State)
    (M : MemoryProductionContract State MemoryAtom) :
    QuotientSupportCoverage P M <->
      SingletonFailureQueryCoverage P M := by
  constructor
  · intro hcov
    constructor
    · exact (quotientMemoryCovered_iff_singletonGenerated P M).mp hcov.1
    · exact (semanticCovered_iff_singletonRepresented P M).mp hcov.2
  · intro hsingle
    constructor
    · exact (quotientMemoryCovered_iff_singletonGenerated P M).mpr hsingle.1
    · exact (semanticCovered_iff_singletonRepresented P M).mpr hsingle.2

/-! ## Consequences for query expressibility -/

/-- THEOREM 5: singleton-query coverage makes every quotient memory support
query-expressible over the semantic atom vocabulary. -/
theorem quotientMemorySupports_queryExpressible_of_singletonCoverage
    {State MemoryAtom : Type*}
    (P : CSafePredicates State)
    (M : MemoryProductionContract State MemoryAtom)
    (hcov : SingletonFailureQueryCoverage P M)
    (q : MemorySupportQuotient M) :
    QueryExpressible (semanticObligationSemantics P)
      (fun x => (memorySupportQuotientContract M).produces x q) := by
  rcases hcov.1 q with ⟨a, hquery⟩
  exact ⟨singletonFailureQuery a, by intro x; exact (hquery x).symm⟩

/-- THEOREM 6: quotient support coverage is stronger than generic Boolean
expressibility of quotient memory supports: it gives a singleton failure query
for each quotient support. -/
theorem quotientCoverage_queryExpressible_each_memory_support
    {State MemoryAtom : Type*}
    (P : CSafePredicates State)
    (M : MemoryProductionContract State MemoryAtom)
    (hcov : QuotientSupportCoverage P M)
    (q : MemorySupportQuotient M) :
    QueryExpressible (semanticObligationSemantics P)
      (fun x => (memorySupportQuotientContract M).produces x q) := by
  exact quotientMemorySupports_queryExpressible_of_singletonCoverage
    P M
    ((quotientSupportCoverage_iff_singletonFailureQueryCoverage P M).mp hcov)
    q

/-!
  Summary:
  - The remaining P84 bridge obligation can be read in query-algebraic form:
    quotient memory atoms must be generated by singleton primitive failure
    queries, and every singleton primitive failure query must be represented.
  - This is stricter than generic Boolean-query expressibility.  Arbitrary
    formulas may express useful safety predicates, but memory/obstruction
    equivalence needs support atoms, not arbitrary composites.
  - The next concrete/runtime certificate can now target this exact basis:
    "for each quotient memory support, which primitive failure query is it?"
-/
