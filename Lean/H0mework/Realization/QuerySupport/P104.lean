/-
  Proposition 104: structure-determined obligations force the discovery table.

  The "seven facets might be incomplete" worry is only well-posed if the
  obligation vocabulary is supplied by an external checklist.  A stronger
  route is to make the system structure itself generate the obligation
  vocabulary.  In the current formal line, the strongest available such
  structure is the P94 semantic-memory pullback:

    * runtime states project faithfully into the seven semantic Boolean axes;
    * that projection is surjective, so the axes are independent;
    * memory production is the pullback of primitive semantic failure support.

  This file proves the part that can already be proved without adding new
  philosophical assumptions: once that structure is fixed, the discovery table
  is not empirical.  Any raw discovery relation or finite table that claims to
  preserve support must label a raw semantic memory atom by the matching
  semantic atom.  The diagonal P101 table is therefore forced by the structure.

  Boundary: this does not prove that `reflexive + source-backed +
  navigation-only` uniquely implies P94.  It proves that if the system
  structure has been made precise as P94, then the obligation/discovery table
  is determined by that structure rather than by Python fixtures or operator
  taste.
-/

import H0mework.Realization.Relations.P101

namespace SemanticBoolMemoryPullback

variable {State : Type*}
variable {P : CSafePredicates State}
variable {M : MemoryProductionContract State SemanticAtom}

/-! ## Support-preserving labels are forced -/

/-- THEOREM 1: under a P94 semantic-memory pullback, any support-preserving
claim that raw memory atom `m` represents semantic atom `a` forces `a = m`.

This is the point at which the discovery table stops being an empirical
artifact: support preservation plus semantic independence leaves no freedom to
choose a different primitive label. -/
theorem support_label_forced
    (C : SemanticBoolMemoryPullback P M)
    {m a : SemanticAtom}
    (hsupport :
      forall x,
        M.produces x m <->
          BoolQuery.eval (semanticObligationSemantics P)
            (singletonFailureQuery a) x) :
    a = m := by
  apply semanticSupportExtensional_of_independent P
    C.projection.atomIndependent
  intro x
  calc
    AtomFailure (semanticObligationSemantics P) x a <->
        BoolQuery.eval (semanticObligationSemantics P)
          (singletonFailureQuery a) x :=
      (singletonFailureQuery_eval_iff P a x).symm
    _ <-> M.produces x m :=
      (hsupport x).symm
    _ <-> BoolQuery.eval (semanticObligationSemantics P)
          (singletonFailureQuery m) x :=
      C.toRawAtomicSupportDiscovery.support_iff m m rfl x
    _ <-> AtomFailure (semanticObligationSemantics P) x m :=
      singletonFailureQuery_eval_iff P m x

/-- THEOREM 2: any raw discovery relation compatible with the same P94
structure has forced diagonal labels. -/
theorem anyRawDiscovery_label_forced
    (C : SemanticBoolMemoryPullback P M)
    (D : RawAtomicSupportDiscovery P M)
    {m a : SemanticAtom}
    (hrep : D.represents m a) :
    a = m :=
  C.support_label_forced (D.support_iff m a hrep)

/-- THEOREM 3: any finite support-discovery table compatible with the same P94
structure has forced diagonal row labels. -/
theorem anyTable_row_label_forced
    (C : SemanticBoolMemoryPullback P M)
    (T : RawAtomicSupportDiscoveryTable P M)
    {m a : SemanticAtom}
    (hrow : (m, a) ∈ T.rows) :
    a = m :=
  C.support_label_forced (T.row_support_iff m a hrow)

/-- THEOREM 4: every row of any compatible finite table has the same singleton
failure support as the generated diagonal row. -/
theorem anyTable_row_support_eq_generated
    (C : SemanticBoolMemoryPullback P M)
    (T : RawAtomicSupportDiscoveryTable P M)
    {m a : SemanticAtom}
    (hrow : (m, a) ∈ T.rows)
    (x : State) :
    BoolQuery.eval (semanticObligationSemantics P)
        (singletonFailureQuery a) x <->
      BoolQuery.eval (semanticObligationSemantics P)
        (singletonFailureQuery m) x := by
  have hlabel : a = m := C.anyTable_row_label_forced T hrow
  subst a
  rfl

end SemanticBoolMemoryPullback

/-! ## Packaged structure-determined seven-facet systems -/

/-- A system whose seven primitive obligations are determined by a faithful
semantic-memory pullback.  This packages the current "system structure ->
obligation vocabulary" boundary: the structure is not just a list of labels,
but a projection/pullback certificate. -/
structure StructureDeterminedSevenFacetSystem (State : Type*) where
  predicates : CSafePredicates State
  memory : MemoryProductionContract State SemanticAtom
  pullback : SemanticBoolMemoryPullback predicates memory

namespace StructureDeterminedSevenFacetSystem

variable {State : Type*}

/-- The obligation semantics generated by the system structure. -/
def obligations (S : StructureDeterminedSevenFacetSystem State) :
    ObligationSemantics State SemanticAtom :=
  semanticObligationSemantics S.predicates

/-- The discovery table generated by the system structure. -/
noncomputable def discoveryTable
    (S : StructureDeterminedSevenFacetSystem State) :
    RawAtomicSupportDiscoveryTable S.predicates S.memory :=
  S.pullback.toRawAtomicSupportDiscoveryTable

/-- THEOREM 5: the generated discovery table's rows are diagonal. -/
theorem generatedTable_row_label_forced
    (S : StructureDeterminedSevenFacetSystem State)
    {m a : SemanticAtom}
    (hrow : (m, a) ∈ S.discoveryTable.rows) :
    a = m :=
  S.pullback.anyTable_row_label_forced S.discoveryTable hrow

/-- THEOREM 6: any alternative finite table compatible with the same system
structure has the same forced diagonal labels. -/
theorem anyCompatibleTable_row_label_forced
    (S : StructureDeterminedSevenFacetSystem State)
    (T : RawAtomicSupportDiscoveryTable S.predicates S.memory)
    {m a : SemanticAtom}
    (hrow : (m, a) ∈ T.rows) :
    a = m :=
  S.pullback.anyTable_row_label_forced T hrow

/-- THEOREM 7: for each primitive memory/semantic atom, production support is
exactly the matching singleton-failure query. -/
theorem production_support_forced
    (S : StructureDeterminedSevenFacetSystem State)
    (x : State) (m : SemanticAtom) :
    S.memory.produces x m <->
      BoolQuery.eval S.obligations (singletonFailureQuery m) x :=
  S.pullback.toRawAtomicSupportDiscovery.support_iff m m rfl x

/-- THEOREM 8: the packed P100 foundation certificate is generated by the same
system structure. -/
noncomputable def foundationCertificate
    (S : StructureDeterminedSevenFacetSystem State) :
    FiniteDiscoveryFoundationCertificate S.predicates S.memory :=
  S.pullback.toFiniteDiscoveryFoundationCertificate

end StructureDeterminedSevenFacetSystem

/-!
  Summary:
  - P94-style system structure determines the primitive support table.
  - Any compatible raw discovery relation or finite table must use diagonal
    labels: a raw semantic memory atom `m` can only represent semantic atom `m`.
  - Thus the discovery table is structure-forced once the system structure has
    been formalized as a faithful semantic-memory pullback.
  - The remaining philosophical/mathematical work is upstream: prove that the
    intended AIppocampus structure uniquely yields this P94 seven-axis
    pullback, rather than merely supplying it as the current formal boundary.
-/
