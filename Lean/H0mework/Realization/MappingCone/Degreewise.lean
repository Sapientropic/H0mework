import Mathlib.Algebra.Homology.HomotopyCategory.MappingCocone

/-!
# Degreewise mapping-cocone calculus

The two canonical mapping-cocone coordinates generate each degree.  This
kernel exposes their constructor, extensionality and zero-object readout for
later limit calculations; it contains no domain-specific source.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace CochainMappingCoconeDegreewiseKernel

open CategoryTheory
open CategoryTheory.Limits
open HomologicalComplex

universe u v

noncomputable section

variable {C : Type u} [Category.{v} C] [Preadditive C]
  {K L : CochainComplex C ℤ} (phi : K ⟶ L)
  [HasHomotopyCofiber phi]

/-- Variant with an explicitly named predecessor degree. -/
noncomputable def degreeLiftAt
    {A : C} (p q : ℤ) (hpq : p + (-1) = q)
    (sourceCoordinate : A ⟶ K.X p)
    (targetCoordinate : A ⟶ L.X q) :
    A ⟶ (CochainComplex.mappingCocone phi).X p :=
  sourceCoordinate ≫
      (CochainComplex.mappingCocone.inl phi).v p p (add_zero p) +
    targetCoordinate ≫
      (CochainComplex.mappingCocone.inr phi).1.v q p (by omega)

@[reassoc (attr := simp)] theorem degreeLiftAt_fst
    {A : C} (p q : ℤ) (hpq : p + (-1) = q)
    (sourceCoordinate : A ⟶ K.X p)
    (targetCoordinate : A ⟶ L.X q) :
    degreeLiftAt phi p q hpq sourceCoordinate targetCoordinate ≫
        (CochainComplex.mappingCocone.fst phi).f p =
      sourceCoordinate := by
  simp [degreeLiftAt, Preadditive.add_comp, Category.assoc]

@[reassoc (attr := simp)] theorem degreeLiftAt_snd
    {A : C} (p q : ℤ) (hpq : p + (-1) = q)
    (sourceCoordinate : A ⟶ K.X p)
    (targetCoordinate : A ⟶ L.X q) :
    degreeLiftAt phi p q hpq sourceCoordinate targetCoordinate ≫
        (CochainComplex.mappingCocone.snd phi).v p q hpq =
      targetCoordinate := by
  simp [degreeLiftAt, Preadditive.add_comp, Category.assoc]

/-- Extensionality with an explicitly named predecessor degree. -/
theorem degree_hom_ext_at
    {A : C} (p q : ℤ) (hpq : p + (-1) = q)
    {left right : A ⟶ (CochainComplex.mappingCocone phi).X p}
    (fst_eq : left ≫ (CochainComplex.mappingCocone.fst phi).f p =
      right ≫ (CochainComplex.mappingCocone.fst phi).f p)
    (snd_eq : left ≫
        (CochainComplex.mappingCocone.snd phi).v p q hpq =
      right ≫ (CochainComplex.mappingCocone.snd phi).v p q hpq) :
    left = right := by
  rw [← Category.comp_id left, ← Category.comp_id right,
    ← CochainComplex.mappingCocone.id_X phi p q hpq]
  simp only [Preadditive.comp_add]
  apply congrArg₂ (fun first second => first + second)
  · rw [← Category.assoc, fst_eq, Category.assoc]
  · rw [← Category.assoc, snd_eq, Category.assoc]

/-- A map to one degree of a mapping cocone is generated by its source and
shifted-target coordinates. -/
noncomputable def degreeLift
    {A : C} (p : ℤ) (sourceCoordinate : A ⟶ K.X p)
    (targetCoordinate : A ⟶ L.X (p + (-1))) :
    A ⟶ (CochainComplex.mappingCocone phi).X p :=
  sourceCoordinate ≫
      (CochainComplex.mappingCocone.inl phi).v p p (add_zero p) +
    targetCoordinate ≫
      (CochainComplex.mappingCocone.inr phi).1.v
        (p + (-1)) p (by lia)

@[reassoc (attr := simp)] theorem degreeLift_fst
    {A : C} (p : ℤ) (sourceCoordinate : A ⟶ K.X p)
    (targetCoordinate : A ⟶ L.X (p + (-1))) :
    degreeLift phi p sourceCoordinate targetCoordinate ≫
        (CochainComplex.mappingCocone.fst phi).f p =
      sourceCoordinate := by
  simp [degreeLift, Preadditive.add_comp, Category.assoc]

@[reassoc (attr := simp)] theorem degreeLift_snd
    {A : C} (p : ℤ) (sourceCoordinate : A ⟶ K.X p)
    (targetCoordinate : A ⟶ L.X (p + (-1))) :
    degreeLift phi p sourceCoordinate targetCoordinate ≫
        (CochainComplex.mappingCocone.snd phi).v
          p (p + (-1)) rfl =
      targetCoordinate := by
  simp [degreeLift, Preadditive.add_comp, Category.assoc]

/-- The two degree coordinates are jointly monic. -/
theorem degree_hom_ext
    {A : C} (p : ℤ)
    {left right : A ⟶ (CochainComplex.mappingCocone phi).X p}
    (fst_eq : left ≫ (CochainComplex.mappingCocone.fst phi).f p =
      right ≫ (CochainComplex.mappingCocone.fst phi).f p)
    (snd_eq : left ≫ (CochainComplex.mappingCocone.snd phi).v
        p (p + (-1)) rfl =
      right ≫ (CochainComplex.mappingCocone.snd phi).v
        p (p + (-1)) rfl) :
    left = right := by
  rw [← Category.comp_id left, ← Category.comp_id right,
    ← CochainComplex.mappingCocone.id_X phi p (p + (-1)) rfl]
  simp only [Preadditive.comp_add]
  apply congrArg₂ (fun first second => first + second)
  · rw [← Category.assoc, fst_eq, Category.assoc]
  · rw [← Category.assoc, snd_eq, Category.assoc]

/-- If both degree coordinates vanish as objects, so does the corresponding
mapping-cocone degree. -/
theorem degree_isZero
    (p : ℤ) (sourceZero : IsZero (K.X p))
    (targetZero : IsZero (L.X (p + (-1)))) :
    IsZero ((CochainComplex.mappingCocone phi).X p) := by
  apply IsZero.of_iso
    ((CochainComplex.mappingCone.isZero_X_iff phi (p + (-1))).2 ?_)
    ((CochainComplex.mappingCone phi).shiftFunctorObjXIso
      (-1) p (p + (-1)) rfl).symm
  constructor
  · simpa only [show p + (-1) + 1 = p by omega] using sourceZero
  · exact targetZero

end


end CochainMappingCoconeDegreewiseKernel
end SaturationMonoid
