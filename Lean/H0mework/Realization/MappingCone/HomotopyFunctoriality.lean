import Mathlib.Algebra.Homology.HomotopyCategory.MappingCocone
import H0mework.Realization.MappingCone.Functoriality
import H0mework.Realization.MappingCone.Degreewise

/-!
# Homotopy-coherent functoriality of cochain mapping cocones

A square of cochain maps that commutes up to an actual chain homotopy still
induces a canonical morphism between the shifted mapping cones.  The map is
generated by the universal `homotopyCofiber.desc` construction; callers do
not submit a cone map or a derived comparison.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace CochainMappingCoconeHomotopyFunctoriality

open CategoryTheory
open CochainComplex.HomComplex
open HomologicalComplex

noncomputable section

variable {C : Type*} [Category* C] [Preadditive C]
variable {K L K' L' : CochainComplex C ℤ}

/-- The map of homotopy cofibers generated by a homotopy-commutative
square. -/
noncomputable def homotopyCofiberMap
    (phi : K ⟶ L) (phi' : K' ⟶ L')
    [HasHomotopyCofiber phi] [HasHomotopyCofiber phi']
    (left : K ⟶ K') (right : L ⟶ L')
    (square : Homotopy (left ≫ phi') (phi ≫ right)) :
    homotopyCofiber phi ⟶ homotopyCofiber phi' :=
  homotopyCofiber.desc phi
    (right ≫ homotopyCofiber.inr phi')
    ((Homotopy.ofEq (by simp only [Category.assoc])).trans
      ((square.symm.compRight (homotopyCofiber.inr phi')).trans
        ((Homotopy.ofEq (by simp only [Category.assoc])).trans
          (((homotopyCofiber.inrCompHomotopy phi'
              (fun degree => ⟨degree - 1, by simp⟩)).compLeft left).trans
            (Homotopy.ofEq (by simp))))))

/-- Shift the generated cofiber map to the mapping-cocone convention. -/
noncomputable def mappingCoconeMap
    (phi : K ⟶ L) (phi' : K' ⟶ L')
    [HasHomotopyCofiber phi] [HasHomotopyCofiber phi']
    (left : K ⟶ K') (right : L ⟶ L')
    (square : Homotopy (left ≫ phi') (phi ≫ right)) :
    CochainComplex.mappingCocone phi ⟶
      CochainComplex.mappingCocone phi' :=
  (CochainComplex.shiftFunctor C (-1)).map
    (homotopyCofiberMap phi phi' left right square)

set_option backward.isDefEq.respectTransparency false in
private theorem mappingCocone_fst_f
    (phi : K ⟶ L) [HasHomotopyCofiber phi] (i : ℤ) :
    (CochainComplex.mappingCocone.fst phi).f i =
      homotopyCofiber.fstX phi (i + -1) i (by simp) := by
  simp only [CochainComplex.mappingCocone.fst,
    CochainComplex.mappingCone.fst,
    HomologicalComplex.neg_f_apply,
    CochainComplex.HomComplex.Cocycle.homOf_f,
    CochainComplex.HomComplex.Cocycle.leftShift_coe]
  rw [CochainComplex.HomComplex.Cochain.leftShift_v
    (n := 1) _ (-1) 0 (by norm_num) i i (by simp) (i + -1) (by simp)]
  simp [CochainComplex.shiftFunctorObjXIso,
    HomologicalComplex.XIsoOfEq]
  exact Category.id_comp _

set_option backward.isDefEq.respectTransparency false in
private theorem mappingCocone_snd_v
    (phi : K ⟶ L) [HasHomotopyCofiber phi]
    (p : ℤ) :
    (CochainComplex.mappingCocone.snd phi).v
        p (p + (-1)) rfl =
      ((CochainComplex.mappingCone phi).shiftFunctorObjXIso
          (-1) p (p + (-1)) rfl).hom ≫
        homotopyCofiber.sndX phi (p + (-1)) := by
  unfold CochainComplex.mappingCocone.snd
  rw [CochainComplex.HomComplex.Cochain.leftShift_v
    (CochainComplex.mappingCone.snd phi) (-1) (-1) (zero_add (-1))
      p (p + (-1)) rfl (p + (-1)) (add_zero _)]
  simp [CochainComplex.mappingCone.snd]
  rw [show Int.negOnePow 2 = 1 by rfl, one_smul]

set_option backward.isDefEq.respectTransparency false in
/-- The generated homotopy-coherent cocone map retains the exact left
projection. -/
theorem mappingCoconeMap_fst
    (phi : K ⟶ L) (phi' : K' ⟶ L')
    [HasHomotopyCofiber phi] [HasHomotopyCofiber phi']
    (left : K ⟶ K') (right : L ⟶ L')
    (square : Homotopy (left ≫ phi') (phi ≫ right)) :
    mappingCoconeMap phi phi' left right square ≫
        CochainComplex.mappingCocone.fst phi' =
      CochainComplex.mappingCocone.fst phi ≫ left := by
  ext i
  rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f]
  dsimp only [mappingCoconeMap]
  rw [mappingCocone_fst_f, mappingCocone_fst_f]
  change
    (homotopyCofiberMap phi phi' left right square).f (i + -1) ≫
        homotopyCofiber.fstX phi' (i + -1) i (by simp) =
      homotopyCofiber.fstX phi (i + -1) i (by simp) ≫ left.f i
  unfold homotopyCofiberMap
  rw [homotopyCofiber.desc_f phi _ _ (i + -1) i (by simp)]
  simp [Homotopy.trans_hom]
  rw [homotopyCofiber.inrCompHomotopy_hom
    phi' _ i (i + -1) (by simp)]
  simp

set_option backward.isDefEq.respectTransparency false in
/-- The shifted-target coordinate of a homotopy-coherent cocone map is the
actual right leg corrected by the square homotopy. -/
theorem mappingCoconeMap_snd
    (phi : K ⟶ L) (phi' : K' ⟶ L')
    [HasHomotopyCofiber phi] [HasHomotopyCofiber phi']
    (left : K ⟶ K') (right : L ⟶ L')
    (square : Homotopy (left ≫ phi') (phi ≫ right)) :
    (CochainComplex.HomComplex.Cochain.ofHom
        (mappingCoconeMap phi phi' left right square)).comp
          (CochainComplex.mappingCocone.snd phi') (zero_add (-1)) =
      (CochainComplex.mappingCocone.snd phi).comp
          (CochainComplex.HomComplex.Cochain.ofHom right)
          (add_zero (-1)) -
        (CochainComplex.HomComplex.Cochain.ofHom
          (CochainComplex.mappingCocone.fst phi)).comp
            (CochainComplex.HomComplex.Cochain.ofHomotopy square)
            (add_zero (-1)) := by
  ext p q hpq : 1
  obtain rfl : q = p + (-1) := hpq.symm
  rw [CochainComplex.HomComplex.Cochain.sub_v,
    CochainComplex.HomComplex.Cochain.comp_v
      (CochainComplex.HomComplex.Cochain.ofHom
        (mappingCoconeMap phi phi' left right square))
      (CochainComplex.mappingCocone.snd phi')
      (zero_add (-1)) p p (p + (-1)) (add_zero p) rfl,
    CochainComplex.HomComplex.Cochain.comp_v
      _ _ _ p (p + (-1)) (p + (-1)) rfl (add_zero _),
    CochainComplex.HomComplex.Cochain.comp_v
      (CochainComplex.HomComplex.Cochain.ofHom
        (CochainComplex.mappingCocone.fst phi))
      (CochainComplex.HomComplex.Cochain.ofHomotopy square)
      (add_zero (-1)) p p (p + (-1)) (add_zero p) rfl]
  simp only [CochainComplex.HomComplex.Cochain.ofHom_v,
    CochainComplex.HomComplex.Cochain.ofHomotopy]
  rw [mappingCocone_snd_v, mappingCocone_snd_v]
  unfold mappingCoconeMap
  dsimp only [CochainComplex.shiftFunctor,
    CochainComplex.shiftFunctorObjXIso,
    HomologicalComplex.XIsoOfEq]
  simp only [eqToIso_refl, Iso.refl_hom, Category.id_comp]
  rw [mappingCocone_fst_f]
  change
    (homotopyCofiberMap phi phi' left right square).f (p + (-1)) ≫
        homotopyCofiber.sndX phi' (p + (-1)) =
      homotopyCofiber.sndX phi (p + (-1)) ≫ right.f (p + (-1)) -
        homotopyCofiber.fstX phi (p + (-1)) p (by simp) ≫
          square.hom p (p + (-1))
  unfold homotopyCofiberMap
  rw [homotopyCofiber.desc_f phi _ _ (p + (-1)) p (by simp)]
  simp [Homotopy.trans_hom]
  rw [homotopyCofiber.inrCompHomotopy_hom
    phi' _ p (p + (-1)) (by simp)]
  simp
  abel

set_option backward.isDefEq.respectTransparency false in
/-- A coherent cube of two strict arrow squares and two homotopy-commuting
faces induces one strictly natural map between their mapping cocones.  The
only two-cell is the already generated equality of the two face homotopy
cochains. -/
theorem mappingCoconeMap_cube
    {KH LH KL LL TH UH TL UL : CochainComplex C ℤ}
    (phiH : KH ⟶ LH) (phiL : KL ⟶ LL)
    (psiH : TH ⟶ UH) (psiL : TL ⟶ UL)
    [HasHomotopyCofiber phiH] [HasHomotopyCofiber phiL]
    [HasHomotopyCofiber psiH] [HasHomotopyCofiber psiL]
    (sourceLeft : KH ⟶ KL) (sourceRight : LH ⟶ LL)
    (sourceSquare : sourceLeft ≫ phiL = phiH ≫ sourceRight)
    (targetLeft : TH ⟶ TL) (targetRight : UH ⟶ UL)
    (targetSquare : targetLeft ≫ psiL = psiH ≫ targetRight)
    (highLeft : KH ⟶ TH) (highRight : LH ⟶ UH)
    (highSquare : Homotopy (highLeft ≫ psiH) (phiH ≫ highRight))
    (lowLeft : KL ⟶ TL) (lowRight : LL ⟶ UL)
    (lowSquare : Homotopy (lowLeft ≫ psiL) (phiL ≫ lowRight))
    (leftCube : sourceLeft ≫ lowLeft = highLeft ≫ targetLeft)
    (rightCube : sourceRight ≫ lowRight = highRight ≫ targetRight)
    (twoCell : Cochain.ofHomotopy (highSquare.compRight targetRight) =
      Cochain.ofHomotopy (lowSquare.compLeft sourceLeft)) :
    CochainMappingCoconeFunctoriality.mappingCoconeMap
          phiH phiL sourceLeft sourceRight sourceSquare ≫
        mappingCoconeMap phiL psiL lowLeft lowRight lowSquare =
      mappingCoconeMap phiH psiH highLeft highRight highSquare ≫
        CochainMappingCoconeFunctoriality.mappingCoconeMap
          psiH psiL targetLeft targetRight targetSquare := by
  let sourceTransition :=
    CochainMappingCoconeFunctoriality.mappingCoconeMap
      phiH phiL sourceLeft sourceRight sourceSquare
  let targetTransition :=
    CochainMappingCoconeFunctoriality.mappingCoconeMap
      psiH psiL targetLeft targetRight targetSquare
  let highMap := mappingCoconeMap
    phiH psiH highLeft highRight highSquare
  let lowMap := mappingCoconeMap
    phiL psiL lowLeft lowRight lowSquare
  apply HomologicalComplex.Hom.ext
  funext degree
  apply CochainMappingCoconeDegreewiseKernel.degree_hom_ext psiL degree
  · have lowFst := mappingCoconeMap_fst
      phiL psiL lowLeft lowRight lowSquare
    have highFst := mappingCoconeMap_fst
      phiH psiH highLeft highRight highSquare
    have sourceFst :=
      CochainMappingCoconeFunctoriality.mappingCoconeMap_fst
        phiH phiL sourceLeft sourceRight sourceSquare
    have targetFst :=
      CochainMappingCoconeFunctoriality.mappingCoconeMap_fst
        psiH psiL targetLeft targetRight targetSquare
    change ((sourceTransition ≫ lowMap).f degree) ≫
        (CochainComplex.mappingCocone.fst psiL).f degree =
      ((highMap ≫ targetTransition).f degree) ≫
        (CochainComplex.mappingCocone.fst psiL).f degree
    have generated :
        (sourceTransition ≫ lowMap) ≫
            CochainComplex.mappingCocone.fst psiL =
          (highMap ≫ targetTransition) ≫
            CochainComplex.mappingCocone.fst psiL := by
      calc
        (sourceTransition ≫ lowMap) ≫
            CochainComplex.mappingCocone.fst psiL =
          sourceTransition ≫
            (CochainComplex.mappingCocone.fst phiL ≫ lowLeft) := by
              rw [Category.assoc, lowFst]
        _ = (sourceTransition ≫
              CochainComplex.mappingCocone.fst phiL) ≫ lowLeft :=
          (Category.assoc _ _ _).symm
        _ = (CochainComplex.mappingCocone.fst phiH ≫
              sourceLeft) ≫ lowLeft := by rw [sourceFst]
        _ = CochainComplex.mappingCocone.fst phiH ≫
              (sourceLeft ≫ lowLeft) := Category.assoc _ _ _
        _ = CochainComplex.mappingCocone.fst phiH ≫
              (highLeft ≫ targetLeft) := by rw [leftCube]
        _ = (CochainComplex.mappingCocone.fst phiH ≫ highLeft) ≫
              targetLeft := (Category.assoc _ _ _).symm
        _ = (highMap ≫ CochainComplex.mappingCocone.fst psiH) ≫
              targetLeft := by rw [highFst]
        _ = highMap ≫
              (CochainComplex.mappingCocone.fst psiH ≫ targetLeft) :=
          Category.assoc _ _ _
        _ = highMap ≫
              (targetTransition ≫
                CochainComplex.mappingCocone.fst psiL) := by rw [targetFst]
        _ = (highMap ≫ targetTransition) ≫
              CochainComplex.mappingCocone.fst psiL :=
          (Category.assoc _ _ _).symm
    exact congrArg (fun arrow => arrow.f degree) generated
  · let previous := degree + (-1)
    have degree_previous : degree + (-1) = previous := rfl
    have lowSnd := Cochain.congr_v
      (mappingCoconeMap_snd phiL psiL lowLeft lowRight lowSquare)
      degree previous degree_previous
    have highSnd := Cochain.congr_v
      (mappingCoconeMap_snd phiH psiH highLeft highRight highSquare)
      degree previous degree_previous
    have sourceSnd := Cochain.congr_v
      (CochainMappingCoconeFunctoriality.mappingCoconeMap_snd
        phiH phiL sourceLeft sourceRight sourceSquare)
      degree previous degree_previous
    have targetSnd := Cochain.congr_v
      (CochainMappingCoconeFunctoriality.mappingCoconeMap_snd
        psiH psiL targetLeft targetRight targetSquare)
      degree previous degree_previous
    have sourceFst := congrArg (fun arrow => arrow.f degree)
      (CochainMappingCoconeFunctoriality.mappingCoconeMap_fst
        phiH phiL sourceLeft sourceRight sourceSquare)
    have highTwoCell := Cochain.congr_v twoCell
      degree previous degree_previous
    have rightCubeDegree := congrArg (fun arrow => arrow.f previous) rightCube
    have sourceSndComponent : sourceTransition.f degree ≫
        (CochainComplex.mappingCocone.snd phiL).v
          degree previous degree_previous =
      (CochainComplex.mappingCocone.snd phiH).v
          degree previous degree_previous ≫ sourceRight.f previous := by
      simpa [Cochain.comp_v] using sourceSnd
    have targetSndComponent : targetTransition.f degree ≫
        (CochainComplex.mappingCocone.snd psiL).v
          degree previous degree_previous =
      (CochainComplex.mappingCocone.snd psiH).v
          degree previous degree_previous ≫ targetRight.f previous := by
      simpa [Cochain.comp_v] using targetSnd
    change sourceTransition.f degree ≫
        (CochainComplex.mappingCocone.fst phiL).f degree =
      (CochainComplex.mappingCocone.fst phiH).f degree ≫
        sourceLeft.f degree at sourceFst
    have highTwoCellComponent :
        highSquare.hom degree previous ≫ targetRight.f previous =
      sourceLeft.f degree ≫ lowSquare.hom degree previous := by
      simpa [Cochain.comp_v, Cochain.ofHomotopy] using highTwoCell
    change sourceRight.f previous ≫ lowRight.f previous =
      highRight.f previous ≫ targetRight.f previous
      at rightCubeDegree
    have lowSndComponent : lowMap.f degree ≫
        (CochainComplex.mappingCocone.snd psiL).v
          degree previous degree_previous =
      (CochainComplex.mappingCocone.snd phiL).v
          degree previous degree_previous ≫ lowRight.f previous -
        (CochainComplex.mappingCocone.fst phiL).f degree ≫
          lowSquare.hom degree previous := by
      simpa [lowMap, Cochain.comp_v, Cochain.ofHomotopy] using lowSnd
    have highSndComponent : highMap.f degree ≫
        (CochainComplex.mappingCocone.snd psiH).v
          degree previous degree_previous =
      (CochainComplex.mappingCocone.snd phiH).v
          degree previous degree_previous ≫ highRight.f previous -
        (CochainComplex.mappingCocone.fst phiH).f degree ≫
          highSquare.hom degree previous := by
      simpa [highMap, Cochain.comp_v, Cochain.ofHomotopy] using highSnd
    change ((sourceTransition ≫ lowMap).f degree) ≫
        (CochainComplex.mappingCocone.snd psiL).v
          degree previous degree_previous =
      ((highMap ≫ targetTransition).f degree) ≫
        (CochainComplex.mappingCocone.snd psiL).v
          degree previous degree_previous
    simp only [HomologicalComplex.comp_f]
    calc
      (sourceTransition.f degree ≫ lowMap.f degree) ≫
          (CochainComplex.mappingCocone.snd psiL).v
            degree previous degree_previous =
        sourceTransition.f degree ≫
          (lowMap.f degree ≫
            (CochainComplex.mappingCocone.snd psiL).v
              degree previous degree_previous) := Category.assoc _ _ _
      _ = sourceTransition.f degree ≫
          ((CochainComplex.mappingCocone.snd phiL).v
              degree previous degree_previous ≫ lowRight.f previous -
            (CochainComplex.mappingCocone.fst phiL).f degree ≫
              lowSquare.hom degree previous) := by rw [lowSndComponent]
      _ = (sourceTransition.f degree ≫
            (CochainComplex.mappingCocone.snd phiL).v
              degree previous degree_previous) ≫ lowRight.f previous -
          (sourceTransition.f degree ≫
            (CochainComplex.mappingCocone.fst phiL).f degree) ≫
              lowSquare.hom degree previous := by
        simp only [Preadditive.comp_sub, Category.assoc]
      _ = ((CochainComplex.mappingCocone.snd phiH).v
              degree previous degree_previous ≫ sourceRight.f previous) ≫
            lowRight.f previous -
          ((CochainComplex.mappingCocone.fst phiH).f degree ≫
              sourceLeft.f degree) ≫ lowSquare.hom degree previous := by
        rw [sourceSndComponent, sourceFst]
      _ = (CochainComplex.mappingCocone.snd phiH).v
              degree previous degree_previous ≫
            (sourceRight.f previous ≫ lowRight.f previous) -
          (CochainComplex.mappingCocone.fst phiH).f degree ≫
            (sourceLeft.f degree ≫ lowSquare.hom degree previous) := by
        simp only [Category.assoc]
      _ = (CochainComplex.mappingCocone.snd phiH).v
              degree previous degree_previous ≫
            (highRight.f previous ≫ targetRight.f previous) -
          (CochainComplex.mappingCocone.fst phiH).f degree ≫
            (highSquare.hom degree previous ≫ targetRight.f previous) := by
        rw [rightCubeDegree, highTwoCellComponent]
      _ = (((CochainComplex.mappingCocone.snd phiH).v
                degree previous degree_previous ≫ highRight.f previous) -
            ((CochainComplex.mappingCocone.fst phiH).f degree ≫
              highSquare.hom degree previous)) ≫ targetRight.f previous := by
        simp only [Preadditive.sub_comp, Category.assoc]
      _ = (highMap.f degree ≫
            (CochainComplex.mappingCocone.snd psiH).v
              degree previous degree_previous) ≫ targetRight.f previous := by
        rw [highSndComponent]
      _ = highMap.f degree ≫
          ((CochainComplex.mappingCocone.snd psiH).v
              degree previous degree_previous ≫ targetRight.f previous) :=
        Category.assoc _ _ _
      _ = highMap.f degree ≫
          (targetTransition.f degree ≫
            (CochainComplex.mappingCocone.snd psiL).v
              degree previous degree_previous) := by rw [targetSndComponent]
      _ = (highMap.f degree ≫ targetTransition.f degree) ≫
          (CochainComplex.mappingCocone.snd psiL).v
            degree previous degree_previous :=
        (Category.assoc _ _ _).symm

end

end CochainMappingCoconeHomotopyFunctoriality
end SaturationMonoid
