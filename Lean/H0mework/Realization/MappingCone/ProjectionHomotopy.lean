import Mathlib.Algebra.Category.ModuleCat.AB
import H0mework.Realization.MappingCone.Functoriality

/-!
# Generic mapping-cocone projection null-homotopy

The canonical projection from `Fib(f)` followed by `f` is null-homotopic.
The homotopy is generated by the mapping cocone's own shifted second
projection; callers supply only the actual chain map.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace LivingLawMappingCoconeProjectionNullHomotopy

open CategoryTheory
open CategoryTheory.Limits
open CochainMappingCoconeFunctoriality
open CochainComplex
open CochainComplex.HomComplex

noncomputable section

variable {K L : CochainComplex (ModuleCat ℤ) ℤ}

set_option backward.isDefEq.respectTransparency false in
/-- The mapping cocone itself generates the null-homotopy of
`fst(f) ≫ f`. -/
noncomputable def projectionNullHomotopy (f : K ⟶ L) :
    Homotopy (mappingCocone.fst f ≫ f) 0 := by
  let composite := mappingCocone.fst f ≫ f
  let homotopyCochain := -mappingCocone.snd f
  let negativeComposite : Cochain (mappingCocone f) L 0 :=
    -Cochain.ofHom composite
  have deltaSnd :
      δ (-1) 0 (mappingCocone.snd f) = negativeComposite := by
    unfold negativeComposite composite mappingCocone.snd
      mappingCocone.fst mappingCocone
    rw [Cochain.δ_leftShift (mappingCone.snd f)
      (-1) (-1) 0 (by norm_num) 1 (by norm_num)]
    rw [mappingCone.δ_snd]
    simp [Int.negOnePow_neg, Cochain.leftShift_neg,
      Cochain.leftShift_comp_zero_cochain]
  have compatibility :
      δ (-1) 0 (mappingCocone.snd f) +
        Cochain.ofHom composite = 0 := by
    rw [deltaSnd]
    exact neg_add_cancel _
  refine (Cochain.equivHomotopy composite 0).symm
    ⟨homotopyCochain, ?_⟩
  simp only [homotopyCochain, δ_neg,
    Cochain.ofHom_zero, add_zero]
  exact eq_neg_of_add_eq_zero_right compatibility

/-- The generated contraction carries exactly the negative shifted-target
coordinate of the mapping cocone. -/
theorem projectionNullHomotopy_cochain (f : K ⟶ L) :
    Cochain.ofHomotopy (projectionNullHomotopy f) =
      -mappingCocone.snd f := by
  ext p q hpq : 1
  change (projectionNullHomotopy f).hom p q = _
  unfold projectionNullHomotopy
  rw [Cochain.equivHomotopy_symm_apply_hom]
  simp only [Cochain.neg_v, dif_pos hpq]

/-- Canonical mapping-cocone contractions are natural under every actual
commuting arrow square.  This is the generic two-cell used by nested/cofinal
derived diagrams; callers provide no homotopy compatibility law. -/
theorem projectionNullHomotopy_naturality_cochain
    {K' L' : CochainComplex (ModuleCat ℤ) ℤ}
    (f : K ⟶ L) (f' : K' ⟶ L')
    (left : K ⟶ K') (right : L ⟶ L')
    (commutes : left ≫ f' = f ≫ right) :
    Cochain.ofHomotopy ((projectionNullHomotopy f).compRight right) =
      Cochain.ofHomotopy
        ((projectionNullHomotopy f').compLeft
          (mappingCoconeMap f f' left right commutes)) := by
  have naturality := mappingCoconeMap_snd
    f f' left right commutes
  ext p q hpq : 1
  change (projectionNullHomotopy f).hom p q ≫ right.f q =
    (mappingCoconeMap f f' left right commutes).f p ≫
      (projectionNullHomotopy f').hom p q
  have high := Cochain.congr_v
    (projectionNullHomotopy_cochain f) p q hpq
  have low := Cochain.congr_v
    (projectionNullHomotopy_cochain f') p q hpq
  change (projectionNullHomotopy f).hom p q =
    (-mappingCocone.snd f).v p q hpq at high
  change (projectionNullHomotopy f').hom p q =
    (-mappingCocone.snd f').v p q hpq at low
  rw [high, low]
  have component := Cochain.congr_v naturality p q hpq
  have component' :
      (mappingCoconeMap f f' left right commutes).f p ≫
          (mappingCocone.snd f').v p q hpq =
        (mappingCocone.snd f).v p q hpq ≫ right.f q := by
    simpa [Cochain.comp_v] using component
  calc
    (-mappingCocone.snd f).v p q hpq ≫ right.f q =
        -((mappingCocone.snd f).v p q hpq ≫ right.f q) := by
      simp only [Cochain.neg_v, Preadditive.neg_comp]
    _ = -((mappingCoconeMap f f' left right commutes).f p ≫
          (mappingCocone.snd f').v p q hpq) :=
      congrArg Neg.neg component'.symm
    _ = (mappingCoconeMap f f' left right commutes).f p ≫
        (-mappingCocone.snd f').v p q hpq := by
      simp only [Cochain.neg_v, Preadditive.comp_neg]

/-- Homotopy-category readout of the same generated contraction. -/
theorem projection_class_eq_zero (f : K ⟶ L) :
    (HomotopyCategory.quotient
      (ModuleCat ℤ) (ComplexShape.up ℤ)).map
        (mappingCocone.fst f ≫ f) = 0 :=
  (HomotopyCategory.quotient_map_eq_zero_iff _).2
    ⟨projectionNullHomotopy f⟩

/-- Degreewise homology readout of the generated null-homotopy. -/
theorem projection_homologyMap_comp_eq_zero
    (f : K ⟶ L) (degree : ℤ) :
    HomologicalComplex.homologyMap (mappingCocone.fst f) degree ≫
        HomologicalComplex.homologyMap f degree = 0 := by
  have generated := (projectionNullHomotopy f).homologyMap_eq degree
  simpa only [HomologicalComplex.homologyMap_comp,
    HomologicalComplex.homologyMap_zero] using generated

end

end LivingLawMappingCoconeProjectionNullHomotopy
end SaturationMonoid
