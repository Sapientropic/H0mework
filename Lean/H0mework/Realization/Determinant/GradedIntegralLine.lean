/-!
# Root-generated graded integral determinant line and unit torsor

The determinant state is lifted here from a scalar coordinate to its
integral rank-one carrier.  A determinant frame is a `Unit`-indexed basis of
that line.  All such frames form a canonical torsor under `ℤˣ = {±1}`;
no frame is selected by the producer.

The generic dual-lattice determinant state generates the tensor product of
the two integral top exterior lines together with its parity.  Its rank is
one and, because the two lattice ranks agree, its total parity is even.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace GradedIntegralDeterminantLine

open DualLatticeDeterminant
open LatticeDeterminantTrivialization
open scoped TensorProduct

universe t u v w

noncomputable section

/-- Integral top exterior determinant line of a finite free lattice. -/
abbrev IntegralTopExteriorLine
    (Lattice : Type u) [AddCommGroup Lattice]
    [Module.Free ℤ Lattice] [Module.Finite ℤ Lattice] :=
  ⋀[ℤ]^(Module.finrank ℤ Lattice) Lattice

theorem integralTopExteriorLine_finrank
    (Lattice : Type u) [AddCommGroup Lattice]
    [Module.Free ℤ Lattice] [Module.Finite ℤ Lattice] :
    Module.finrank ℤ (IntegralTopExteriorLine Lattice) = 1 := by
  rw [IntegralTopExteriorLine, exteriorPower.finrank_eq]
  simp

/-- Determinant-frame carrier of a rank-one line over a commutative ring. -/
abbrev DeterminantFrame
    (R : Type t) (Line : Type u) [CommRing R]
    [AddCommGroup Line] [Module R Line] :=
  Module.Basis Unit R Line

abbrev IntegralDeterminantFrame
    (Line : Type u) [AddCommGroup Line] [Module ℤ Line] :=
  DeterminantFrame ℤ Line

/-- An installed lattice basis generates its determinant-line frame.  The
basis is a readout argument; it is not retained by the graded-line producer. -/
noncomputable def determinantFrameOfBasis
    {R : Type t} {Lattice : Type u} [CommRing R] [StrongRankCondition R]
    [AddCommGroup Lattice] [Module R Lattice]
    {Index : Type*} [Fintype Index]
    (basis : Module.Basis Index R Lattice) :
    DeterminantFrame R
      (⋀[R]^(Module.finrank R Lattice) Lattice) := by
  let _ : Module.Free R Lattice := Module.Free.of_basis basis
  let _ : Module.Finite R Lattice := Module.Finite.of_basis basis
  let _ : LinearOrder Index := WellOrderingRel.isWellOrder.linearOrder
  rw [Module.finrank_eq_card_basis basis]
  let full : Set.powersetCard Index (Fintype.card Index) :=
    ⟨Finset.univ, Finset.card_univ⟩
  let topEquiv : Set.powersetCard Index (Fintype.card Index) ≃ Unit :=
    { toFun := fun _ => ()
      invFun := fun _ => full
      left_inv := by
        intro subset
        apply Subtype.ext
        change Finset.univ = subset.1
        have card_eq : subset.1.card =
            (Finset.univ : Finset Index).card := by
          rw [Finset.card_univ]
          exact subset.2
        exact (subset.1.card_eq_iff_eq_univ.mp card_eq).symm
      right_inv := by intro point; cases point; rfl }
  exact (basis.exteriorPower (Fintype.card Index)).reindex
    topEquiv

/-- Basis-free top-exterior transport generated by a lattice equivalence. -/
noncomputable def topExteriorLineEquiv
    {R : Type t} {Source : Type u} {Target : Type v}
    [CommRing R] [AddCommGroup Source] [Module R Source]
    [AddCommGroup Target] [Module R Target]
    (equivalence : Source ≃ₗ[R] Target) :
    (⋀[R]^(Module.finrank R Source) Source) ≃ₗ[R]
      ⋀[R]^(Module.finrank R Target) Target := by
  rw [← equivalence.finrank_eq]
  let forward := exteriorPower.map (Module.finrank R Source)
    equivalence.toLinearMap
  exact LinearEquiv.ofBijective forward
    ⟨exteriorPower.map_injective equivalence.symm.toLinearMap (by simp),
      exteriorPower.map_surjective equivalence.surjective⟩

/-- Intrinsic unit action on determinant frames. -/
noncomputable def unitAct
    {R : Type t} {Line : Type u} [CommRing R]
    [AddCommGroup Line] [Module R Line]
    (unit : Rˣ) (frame : DeterminantFrame R Line) :
    DeterminantFrame R Line :=
  frame.unitsSMul (fun _ => unit)

@[simp] theorem unitAct_apply
    {R : Type t} {Line : Type u} [CommRing R]
    [AddCommGroup Line] [Module R Line]
    (unit : Rˣ) (frame : DeterminantFrame R Line) (index : Unit) :
    unitAct unit frame index = unit • frame index := by
  unfold unitAct
  rw [Module.Basis.unitsSMul_apply]

theorem one_unitAct
    {R : Type t} {Line : Type u} [CommRing R]
    [AddCommGroup Line] [Module R Line]
    (frame : DeterminantFrame R Line) :
    unitAct 1 frame = frame := by
  apply DFunLike.coe_injective
  funext index
  unfold unitAct
  rw [Module.Basis.unitsSMul_apply]
  simp

theorem mul_unitAct
    {R : Type t} {Line : Type u} [CommRing R]
    [AddCommGroup Line] [Module R Line]
    (first second : Rˣ) (frame : DeterminantFrame R Line) :
    unitAct (first * second) frame =
      unitAct first (unitAct second frame) := by
  apply DFunLike.coe_injective
  funext index
  unfold unitAct
  rw [Module.Basis.unitsSMul_apply, Module.Basis.unitsSMul_apply,
    Module.Basis.unitsSMul_apply]
  exact mul_smul first second (frame index)

/-- The unique transition unit read from two determinant frames. -/
noncomputable def frameTransitionUnit
    {R : Type t} {Line : Type u} [CommRing R]
    [AddCommGroup Line] [Module R Line]
    (left right : DeterminantFrame R Line) : Rˣ :=
  (left.isUnit_det right).unit

theorem frameTransitionUnit_val
    {R : Type t} {Line : Type u} [CommRing R]
    [AddCommGroup Line] [Module R Line]
    (left right : DeterminantFrame R Line) :
    (frameTransitionUnit left right : R) = left.det right :=
  (left.isUnit_det right).unit_spec

theorem basis_det_eq_default_coordinate
    {R : Type t} {Line : Type u} [CommRing R]
    [AddCommGroup Line] [Module R Line]
    (left right : DeterminantFrame R Line) :
    left.det right = left.repr (right default) default := by
  rw [Module.Basis.det_apply, Matrix.det_unique]
  rfl

/-- The generated transition unit transports the first frame to the second. -/
theorem frameTransitionUnit_act
    {R : Type t} {Line : Type u} [CommRing R]
    [AddCommGroup Line] [Module R Line]
    (left right : DeterminantFrame R Line) :
    unitAct (frameTransitionUnit left right) left = right := by
  apply DFunLike.coe_injective
  funext index
  cases index
  rw [unitAct_apply, Units.smul_def, frameTransitionUnit_val,
    basis_det_eq_default_coordinate]
  simpa using left.sum_repr (right default)

theorem unitAct_injective
    {R : Type t} {Line : Type u} [CommRing R]
    [AddCommGroup Line] [Module R Line]
    (frame : DeterminantFrame R Line) :
    Function.Injective (fun unit : Rˣ => unitAct unit frame) := by
  intro first second equality
  apply Units.ext
  have vector_eq := congrArg
    (fun basis : DeterminantFrame R Line => basis default) equality
  have coordinate_eq := congrArg
    (fun vector => frame.repr vector default) vector_eq
  simpa [unitAct, Module.Basis.unitsSMul_apply, Units.smul_def] using coordinate_eq

/-- Simply-transitive unit action on all determinant frames. -/
theorem existsUnique_unitAct_eq
    {R : Type t} {Line : Type u} [CommRing R]
    [AddCommGroup Line] [Module R Line]
    (left right : DeterminantFrame R Line) :
    ∃! unit : Rˣ, unitAct unit left = right := by
  refine ⟨frameTransitionUnit left right,
    frameTransitionUnit_act left right, ?_⟩
  intro unit equality
  exact unitAct_injective left
    (equality.trans (frameTransitionUnit_act left right).symm)

/-- Internally generated frame proving the frame carrier is inhabited. -/
noncomputable def internalRankOneFrame
    {R : Type t} {Line : Type u} [CommRing R]
    [StrongRankCondition R]
    [AddCommGroup Line] [Module R Line]
    [Module.Free R Line] [Module.Finite R Line]
    (rankOne : Module.finrank R Line = 1) :
    DeterminantFrame R Line :=
  (Module.finBasisOfFinrankEq R Line rankOne).reindex finOneEquiv

/-- Packaged canonical unit torsor. -/
structure CanonicalUnitTorsor
    (R : Type t) (Line : Type u) [CommRing R]
    [AddCommGroup Line] [Module R Line] where
  framesNonempty : Nonempty (DeterminantFrame R Line)
  act : Rˣ → DeterminantFrame R Line → DeterminantFrame R Line
  one_act : ∀ frame, act 1 frame = frame
  mul_act : ∀ first second frame,
    act (first * second) frame = act first (act second frame)
  simplyTransitive : ∀ left right, ∃! unit, act unit left = right

noncomputable def canonicalUnitTorsor
    {R : Type t} {Line : Type u} [CommRing R]
    [StrongRankCondition R]
    [AddCommGroup Line] [Module R Line]
    [Module.Free R Line] [Module.Finite R Line]
    (rankOne : Module.finrank R Line = 1) :
    CanonicalUnitTorsor R Line where
  framesNonempty := ⟨internalRankOneFrame rankOne⟩
  act := unitAct
  one_act := one_unitAct
  mul_act := mul_unitAct
  simplyTransitive := existsUnique_unitAct_eq

abbrev CanonicalIntegralUnitTorsor
    (Line : Type u) [AddCommGroup Line] [Module ℤ Line] :=
  CanonicalUnitTorsor ℤ Line

noncomputable def canonicalIntegralUnitTorsor
    {Line : Type u} [AddCommGroup Line] [Module ℤ Line]
    [Module.Free ℤ Line] [Module.Finite ℤ Line]
    (rankOne : Module.finrank ℤ Line = 1) :
    CanonicalIntegralUnitTorsor Line :=
  canonicalUnitTorsor rankOne

/-- Coordinate of a determinant state in an installed frame. -/
noncomputable def installedFrameCoordinate
    {R : Type t} {Line : Type u} [CommRing R]
    [AddCommGroup Line] [Module R Line]
    (frame : DeterminantFrame R Line) (state : Line) : R :=
  frame.repr state default

/-- Coordinates transform by the inverse intrinsic unit. -/
theorem installedFrameCoordinate_unitAct
    {R : Type t} {Line : Type u} [CommRing R]
    [AddCommGroup Line] [Module R Line]
    (unit : Rˣ) (frame : DeterminantFrame R Line) (state : Line) :
    installedFrameCoordinate (unitAct unit frame) state =
      unit⁻¹ • installedFrameCoordinate frame state := by
  exact Module.Basis.repr_unitsSMul frame (fun _ => unit) state default

/-- Integral tensor determinant line of a dual lattice pair. -/
abbrev IntegralDualDeterminantLine
    (Left : Type u) (Right : Type v)
    [AddCommGroup Left] [Module.Free ℤ Left] [Module.Finite ℤ Left]
    [AddCommGroup Right] [Module.Free ℤ Right] [Module.Finite ℤ Right] :=
  IntegralTopExteriorLine Left ⊗[ℤ] IntegralTopExteriorLine Right

theorem integralDualDeterminantLine_finrank
    (Left : Type u) (Right : Type v)
    [AddCommGroup Left] [Module.Free ℤ Left] [Module.Finite ℤ Left]
    [AddCommGroup Right] [Module.Free ℤ Right] [Module.Finite ℤ Right] :
    Module.finrank ℤ (IntegralDualDeterminantLine Left Right) = 1 := by
  let leftFrame : IntegralDeterminantFrame (IntegralTopExteriorLine Left) :=
    internalRankOneFrame (integralTopExteriorLine_finrank Left)
  let rightFrame : IntegralDeterminantFrame (IntegralTopExteriorLine Right) :=
    internalRankOneFrame (integralTopExteriorLine_finrank Right)
  have tensorBasis := leftFrame.tensorProduct rightFrame
  calc
    Module.finrank ℤ (IntegralDualDeterminantLine Left Right) =
        Fintype.card (Unit × Unit) :=
      Module.finrank_eq_card_basis tensorBasis
    _ = 1 := by simp

/-- Grading of the integral dual determinant line. -/
def integralDualDeterminantParity
    (Left : Type u) (Right : Type v)
    [AddCommGroup Left] [Module.Free ℤ Left] [Module.Finite ℤ Left]
    [AddCommGroup Right] [Module.Free ℤ Right] [Module.Finite ℤ Right] :
    Fin 2 :=
  ⟨(Module.finrank ℤ Left + Module.finrank ℤ Right) % 2,
    Nat.mod_lt _ (by norm_num)⟩

attribute [local instance 2000] Algebra.toModule

/-- Root-generated graded integral line above one already generated dual
arithmetic determinant state. -/
structure RootGeneratedGradedIntegralDualDeterminantLineAt
    {K : Type t} {Root : Type w} {Left : Type u} {Right : Type v}
    [Field K] [Algebra ℤ K]
    [AddCommGroup Left] [Module.Free ℤ Left] [Module.Finite ℤ Left]
    [AddCommGroup Right] [Module.Free ℤ Right] [Module.Finite ℤ Right]
    {rootOccurrence : RootedAccountedUnfolding Root}
    {leftOccurrences : Left → RootedAccountedUnfolding Left}
    {rightOccurrences : Right → RootedAccountedUnfolding Right}
    {pairingOccurrence :
      RootedAccountedUnfolding (Left →ₗ[ℤ] Right →ₗ[ℤ] K)}
    {pairingFace : RootGeneratedDualLatticePairingAt rootOccurrence
      leftOccurrences rightOccurrences pairingOccurrence}
    {determinantFace :
      RootGeneratedDualLatticeDeterminantTrivializationAt pairingFace}
    {calculation :
      RootGeneratedDualLatticeNondegeneracyCalculationAt pairingFace}
    (dualState : RootGeneratedDualLatticeDeterminantRealizationAt
      determinantFace calculation) : Type where
  private mk ::

namespace RootGeneratedGradedIntegralDualDeterminantLineAt

variable {K : Type t} {Root : Type w} {Left : Type u} {Right : Type v}
variable [Field K] [Algebra ℤ K]
variable [AddCommGroup Left] [Module.Free ℤ Left] [Module.Finite ℤ Left]
variable [AddCommGroup Right] [Module.Free ℤ Right] [Module.Finite ℤ Right]
variable {rootOccurrence : RootedAccountedUnfolding Root}
variable {leftOccurrences : Left → RootedAccountedUnfolding Left}
variable {rightOccurrences : Right → RootedAccountedUnfolding Right}
variable {pairingOccurrence :
  RootedAccountedUnfolding (Left →ₗ[ℤ] Right →ₗ[ℤ] K)}
variable {pairingFace : RootGeneratedDualLatticePairingAt rootOccurrence
  leftOccurrences rightOccurrences pairingOccurrence}
variable {determinantFace :
  RootGeneratedDualLatticeDeterminantTrivializationAt pairingFace}
variable {calculation :
  RootGeneratedDualLatticeNondegeneracyCalculationAt pairingFace}
variable {dualState : RootGeneratedDualLatticeDeterminantRealizationAt
  determinantFace calculation}

def generate : RootGeneratedGradedIntegralDualDeterminantLineAt dualState :=
  ⟨⟩

/-- The graded line is a dependent face of the same dual determinant state. -/
def determinantState
    (_face : RootGeneratedGradedIntegralDualDeterminantLineAt dualState) :
    RootGeneratedDualLatticeDeterminantRealizationAt
      determinantFace calculation :=
  dualState

abbrev line
    (_face : RootGeneratedGradedIntegralDualDeterminantLineAt dualState) :=
  IntegralDualDeterminantLine Left Right

def parity
    (_face : RootGeneratedGradedIntegralDualDeterminantLineAt dualState) :
    Fin 2 :=
  integralDualDeterminantParity Left Right

theorem integralFinrank_eq
    (_face : RootGeneratedGradedIntegralDualDeterminantLineAt dualState) :
    Module.finrank ℤ Left = Module.finrank ℤ Right := by
  simpa [IntegralScalarExtension, Module.finrank_baseChange] using
    dualState.scalarFinrank_eq

/-- A perfect dual pairing has even total determinant parity. -/
theorem parity_eq_zero
    (face : RootGeneratedGradedIntegralDualDeterminantLineAt dualState) :
    face.parity = 0 := by
  apply Fin.ext
  simp only [parity, integralDualDeterminantParity, Fin.val_zero]
  rw [face.integralFinrank_eq]
  omega

/-- Canonical frame torsor of the integral dual determinant line. -/
noncomputable def unitTorsor
    (_face : RootGeneratedGradedIntegralDualDeterminantLineAt dualState) :
    CanonicalIntegralUnitTorsor (IntegralDualDeterminantLine Left Right) := by
  let leftFrame : IntegralDeterminantFrame (IntegralTopExteriorLine Left) :=
    internalRankOneFrame (integralTopExteriorLine_finrank Left)
  let rightFrame : IntegralDeterminantFrame (IntegralTopExteriorLine Right) :=
    internalRankOneFrame (integralTopExteriorLine_finrank Right)
  let tensorBasis := leftFrame.tensorProduct rightFrame
  let _ : Module.Free ℤ (IntegralDualDeterminantLine Left Right) :=
    Module.Free.of_basis tensorBasis
  let _ : Module.Finite ℤ (IntegralDualDeterminantLine Left Right) :=
    Module.Finite.of_basis tensorBasis
  exact canonicalIntegralUnitTorsor
    (integralDualDeterminantLine_finrank Left Right)

/-- Orientation transition readout between two installed integral line
frames. -/
noncomputable def orientationUnit
    (_face : RootGeneratedGradedIntegralDualDeterminantLineAt dualState)
    (left right : IntegralDeterminantFrame
      (IntegralDualDeterminantLine Left Right)) : ℤˣ :=
  frameTransitionUnit left right

theorem orientationUnit_eq_one_or_neg_one
    (face : RootGeneratedGradedIntegralDualDeterminantLineAt dualState)
    (left right : IntegralDeterminantFrame
      (IntegralDualDeterminantLine Left Right)) :
    face.orientationUnit left right = 1 ∨
      face.orientationUnit left right = -1 :=
  Int.units_eq_one_or (face.orientationUnit left right)

end RootGeneratedGradedIntegralDualDeterminantLineAt

end

