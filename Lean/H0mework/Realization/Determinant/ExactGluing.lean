import Mathlib.Algebra.Category.ModuleCat.Free
import H0mework.Foundation.Relations.FiniteDefectDeterminant
import H0mework.Realization.Determinant.GradedIntegralLine

/-!
# Root-generated exact/cofiber determinant gluing

An actual short exact incidence generates the middle basis from endpoint
bases only at readout time.  Passing to top exterior frames lands every such
readout in the canonical unit torsors generated by the graded determinant
kernel; no splitting or middle basis is a producer field.

For the decisive acyclic-cofiber case, the finite-defect receipt already
forces injectivity.  A generated proof that the actual cokernel is
contractible forces surjectivity, hence the presentation map is an
equivalence and exterior power gives a basis-free canonical determinant-line
transport.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace ExactDeterminantGluing

open CategoryTheory
open FiniteDefectDeterminant
open GradedIntegralDeterminantLine

universe u v w

noncomputable section

/-- Root-owned actual short complex. -/
structure RootGeneratedShortExactDeterminantGluingAt
    {R : Type u} {Root : Type w} [CommRing R]
    (rootOccurrence : RootedAccountedUnfolding Root)
    (shortComplexOccurrence :
      RootedAccountedUnfolding (ShortComplex (ModuleCat.{v} R))) : Type where
  private mk ::

namespace RootGeneratedShortExactDeterminantGluingAt

variable {R : Type u} {Root : Type w} [CommRing R]
variable {rootOccurrence : RootedAccountedUnfolding Root}
variable {shortComplexOccurrence :
  RootedAccountedUnfolding (ShortComplex (ModuleCat.{v} R))}

def generate : RootGeneratedShortExactDeterminantGluingAt rootOccurrence
    shortComplexOccurrence :=
  ⟨⟩

def root
    (_face : RootGeneratedShortExactDeterminantGluingAt rootOccurrence
      shortComplexOccurrence) : RootedAccountedUnfolding Root :=
  rootOccurrence

def actualShortComplex
    (_face : RootGeneratedShortExactDeterminantGluingAt rootOccurrence
      shortComplexOccurrence) : ShortComplex (ModuleCat.{v} R) :=
  shortComplexOccurrence.root

end RootGeneratedShortExactDeterminantGluingAt

/-- Generated short-exact calculation.  Endpoint freeness/finiteness are
receipts from the actual complex, not selected bases. -/
structure RootGeneratedShortExactCalculationAt
    {R : Type u} {Root : Type w} [CommRing R]
    {rootOccurrence : RootedAccountedUnfolding Root}
    {shortComplexOccurrence :
      RootedAccountedUnfolding (ShortComplex (ModuleCat.{v} R))}
    (face : RootGeneratedShortExactDeterminantGluingAt rootOccurrence
      shortComplexOccurrence) : Prop where
  shortExact : face.actualShortComplex.ShortExact
  leftFree : Module.Free R face.actualShortComplex.X₁
  leftFinite : Module.Finite R face.actualShortComplex.X₁
  rightFree : Module.Free R face.actualShortComplex.X₃
  rightFinite : Module.Finite R face.actualShortComplex.X₃

namespace RootGeneratedShortExactCalculationAt

variable {R : Type u} {Root : Type w} [CommRing R]
variable {rootOccurrence : RootedAccountedUnfolding Root}
variable {shortComplexOccurrence :
  RootedAccountedUnfolding (ShortComplex (ModuleCat.{v} R))}
variable {face : RootGeneratedShortExactDeterminantGluingAt rootOccurrence
  shortComplexOccurrence}

theorem generate
    (shortExact : face.actualShortComplex.ShortExact)
    (leftFree : Module.Free R face.actualShortComplex.X₁)
    (leftFinite : Module.Finite R face.actualShortComplex.X₁)
    (rightFree : Module.Free R face.actualShortComplex.X₃)
    (rightFinite : Module.Finite R face.actualShortComplex.X₃) :
    RootGeneratedShortExactCalculationAt face :=
  ⟨shortExact, leftFree, leftFinite, rightFree, rightFinite⟩

end RootGeneratedShortExactCalculationAt

structure RootGeneratedShortExactDeterminantGluingReceiptAt
    {R : Type u} {Root : Type w} [CommRing R]
    {rootOccurrence : RootedAccountedUnfolding Root}
    {shortComplexOccurrence :
      RootedAccountedUnfolding (ShortComplex (ModuleCat.{v} R))}
    (face : RootGeneratedShortExactDeterminantGluingAt rootOccurrence
      shortComplexOccurrence)
    (calculation : RootGeneratedShortExactCalculationAt face) : Type where
  private mk ::

namespace RootGeneratedShortExactDeterminantGluingReceiptAt

variable {R : Type u} {Root : Type w} [CommRing R] [StrongRankCondition R]
variable {rootOccurrence : RootedAccountedUnfolding Root}
variable {shortComplexOccurrence :
  RootedAccountedUnfolding (ShortComplex (ModuleCat.{v} R))}
variable {face : RootGeneratedShortExactDeterminantGluingAt rootOccurrence
  shortComplexOccurrence}
variable {calculation : RootGeneratedShortExactCalculationAt face}

def realize : RootGeneratedShortExactDeterminantGluingReceiptAt
    face calculation :=
  ⟨⟩

/-- Exactness generates a middle basis from endpoint bases.  All three bases
are readout arguments; none is stored by the face. -/
noncomputable def gluedMiddleBasis
    {LeftIndex RightIndex : Type*}
    (_receipt : RootGeneratedShortExactDeterminantGluingReceiptAt
      face calculation)
    (leftBasis : Module.Basis LeftIndex R face.actualShortComplex.X₁)
    (rightBasis : Module.Basis RightIndex R face.actualShortComplex.X₃) :
    Module.Basis (LeftIndex ⊕ RightIndex) R
      face.actualShortComplex.X₂ :=
  ModuleCat.Basis.ofShortExact calculation.shortExact leftBasis rightBasis

/-- Installed exact-sequence determinant gluing frame. -/
noncomputable def gluedMiddleDeterminantFrame
    {LeftIndex RightIndex : Type*}
    [Fintype LeftIndex] [Fintype RightIndex]
    (receipt : RootGeneratedShortExactDeterminantGluingReceiptAt
      face calculation)
    (leftBasis : Module.Basis LeftIndex R face.actualShortComplex.X₁)
    (rightBasis : Module.Basis RightIndex R face.actualShortComplex.X₃) :
    DeterminantFrame R
      (⋀[R]^(Module.finrank R face.actualShortComplex.X₂)
        face.actualShortComplex.X₂) :=
  determinantFrameOfBasis (receipt.gluedMiddleBasis leftBasis rightBasis)

/-- Exact-sequence grading law. -/
theorem middle_finrank_eq_add
    (_receipt : RootGeneratedShortExactDeterminantGluingReceiptAt
      face calculation) :
    Module.finrank R face.actualShortComplex.X₂ =
      Module.finrank R face.actualShortComplex.X₁ +
        Module.finrank R face.actualShortComplex.X₃ := by
  let _ : Module.Free R face.actualShortComplex.X₁ := calculation.leftFree
  let _ : Module.Finite R face.actualShortComplex.X₁ := calculation.leftFinite
  let _ : Module.Free R face.actualShortComplex.X₃ := calculation.rightFree
  let _ : Module.Finite R face.actualShortComplex.X₃ := calculation.rightFinite
  exact ModuleCat.free_shortExact_finrank_add calculation.shortExact rfl rfl

end RootGeneratedShortExactDeterminantGluingReceiptAt

/-! ## Acyclic cofiber transport -/

namespace FiniteDefectDeterminant.RootGeneratedFiniteDefectReceiptAt

variable {Root : Type w} {Source : Type u} {Target : Type v}
variable [AddCommGroup Source] [Module.Free ℤ Source] [Module.Finite ℤ Source]
variable [AddCommGroup Target] [Module.Free ℤ Target] [Module.Finite ℤ Target]
variable {rootOccurrence : RootedAccountedUnfolding Root}
variable {sourceOccurrences : Source → RootedAccountedUnfolding Source}
variable {targetOccurrences : Target → RootedAccountedUnfolding Target}
variable {mapOccurrence : RootedAccountedUnfolding (Source →ₗ[ℤ] Target)}
variable {presentationFace : RootGeneratedFiniteDefectPresentationAt rootOccurrence
  sourceOccurrences targetOccurrences mapOccurrence}
variable {presentationCalculation :
  RootGeneratedFiniteDefectCalculationAt presentationFace}

/-- Generated proof that the actual cofiber is acyclic. -/
structure RootGeneratedAcyclicCofiberDeterminantTransportAt
    (receipt : RootGeneratedFiniteDefectReceiptAt presentationFace
      presentationCalculation) : Prop where
  cofiberAcyclic : Subsingleton presentationFace.cofiber

namespace RootGeneratedAcyclicCofiberDeterminantTransportAt

variable {receipt : RootGeneratedFiniteDefectReceiptAt presentationFace
  presentationCalculation}

theorem generate
    (cofiberAcyclic : Subsingleton presentationFace.cofiber) :
    RootGeneratedAcyclicCofiberDeterminantTransportAt receipt :=
  ⟨cofiberAcyclic⟩

theorem actualMap_surjective
    (acyclic : RootGeneratedAcyclicCofiberDeterminantTransportAt receipt) :
    Function.Surjective presentationFace.actualMap := by
  rw [← LinearMap.range_eq_top]
  exact Submodule.Quotient.subsingleton_iff.mp acyclic.cofiberAcyclic

theorem actualMap_bijective
    (acyclic : RootGeneratedAcyclicCofiberDeterminantTransportAt receipt) :
    Function.Bijective presentationFace.actualMap :=
  ⟨receipt.actualMap_injective, acyclic.actualMap_surjective⟩

noncomputable def actualMapEquiv
    (acyclic : RootGeneratedAcyclicCofiberDeterminantTransportAt receipt) :
    Source ≃ₗ[ℤ] Target :=
  LinearEquiv.ofBijective presentationFace.actualMap acyclic.actualMap_bijective

/-- Basis-free top-exterior transport generated by an acyclic actual
cofiber. -/
noncomputable def determinantLineTransport
    (acyclic : RootGeneratedAcyclicCofiberDeterminantTransportAt receipt) :
    IntegralTopExteriorLine Source ≃ₗ[ℤ]
      IntegralTopExteriorLine Target := by
  change
    (⋀[ℤ]^(Module.finrank ℤ Source) Source) ≃ₗ[ℤ]
      ⋀[ℤ]^(Module.finrank ℤ Target) Target
  rw [← presentationCalculation.rank_eq]
  let forward := exteriorPower.map (Module.finrank ℤ Source)
    acyclic.actualMapEquiv.toLinearMap
  exact LinearEquiv.ofBijective forward
    ⟨exteriorPower.map_injective
        acyclic.actualMapEquiv.symm.toLinearMap (by simp),
      exteriorPower.map_surjective acyclic.actualMapEquiv.surjective⟩

end RootGeneratedAcyclicCofiberDeterminantTransportAt
end FiniteDefectDeterminant.RootGeneratedFiniteDefectReceiptAt

end

end ExactDeterminantGluing
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
