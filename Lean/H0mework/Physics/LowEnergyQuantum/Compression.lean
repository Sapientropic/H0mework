import H0mework.Physics.LowEnergyQuantum.Carrier

/-! Exact feedback through the complementary native matter space. A
compressed product acquires the intermediate excursion generated by the
original operators themselves. -/
set_option autoImplicit false
namespace SaturationMonoid.PhysicsCore.LowEnergy.Quantum
open DiracExteriorMatterAction SU7ExteriorBreakingYukawa
open StageNineDiracDualYukawaSpinJurisdiction
open Stage9DEF.Compatibility
noncomputable section

def retained : Module.End ℂ DiracExteriorMatterCarrier :=
  embed.comp Stage9DEF.Compatibility.coordinates

def complementary : Module.End ℂ DiracExteriorMatterCarrier := 1-retained

theorem retained_idempotent : retained.comp retained = retained := by
  apply LinearMap.ext
  intro matter
  change embed (Stage9DEF.Compatibility.coordinates (embed (Stage9DEF.Compatibility.coordinates matter))) = _
  rw [coordinates_embed]
  rfl

theorem compression_add (first second : Module.End ℂ DiracExteriorMatterCarrier) :
    compression (first+second) = compression first+compression second := by
  simp [compression, LinearMap.comp_add, LinearMap.add_comp]

theorem compression_retained (first second : Module.End ℂ DiracExteriorMatterCarrier) :
    compression (first.comp (retained.comp second)) = compression first*compression second := by
  unfold compression
  rw [← LinearMap.toMatrix'_comp]
  rfl

def excursion (first second : Module.End ℂ DiracExteriorMatterCarrier) : Matrix8 :=
  compression (first.comp (complementary.comp second))

theorem compression_product (first second : Module.End ℂ DiracExteriorMatterCarrier) :
    compression (first.comp second) = compression first*compression second+excursion first second := by
  rw [← compression_retained, excursion, ← compression_add]
  congr 1
  apply LinearMap.ext
  intro matter
  simp [complementary]

theorem complementary_yukawa (scalar : ExteriorBreakingScalarCarrier) :
    complementary.comp (diracDualRightChiralYukawaAction scalar) = diracDualRightChiralYukawaAction scalar := by
  apply LinearMap.ext
  intro matter
  simp [complementary, retained, Contact.Quantum.coordinates_yukawa]

theorem yukawa_excursion (first : Module.End ℂ DiracExteriorMatterCarrier)
    (scalar : ExteriorBreakingScalarCarrier) :
    excursion first (diracDualRightChiralYukawaAction scalar) =
      compression (first.comp (diracDualRightChiralYukawaAction scalar)) := by
  rw [excursion, complementary_yukawa]

theorem return_compression_nonzero : compression Contact.ReturnChannel.detectedAction ≠ 0 := by
  intro zero
  have responseZero : responseMatrix Contact.ReturnChannel.detectedAction = 0 := by
    ext row col
    change compression Contact.ReturnChannel.detectedAction (flip row) col = 0
    rw [zero]
    rfl
  apply Contact.ReturnChannel.detected_read_nonzero
  rw [responseZero]
  simp [vectorRead]

theorem return_entirely_complementary :
    compression Contact.ReturnChannel.returnMap *
      compression (diracDualRightChiralYukawaAction Response.MixedWitness.scalarDirection) = 0 ∧
    excursion Contact.ReturnChannel.returnMap
      (diracDualRightChiralYukawaAction Response.MixedWitness.scalarDirection) ≠ 0 := by
  constructor
  · rw [Contact.Quantum.compressed_yukawa, mul_zero]
  · rw [yukawa_excursion]
    exact return_compression_nonzero

end
end SaturationMonoid.PhysicsCore.LowEnergy.Quantum
