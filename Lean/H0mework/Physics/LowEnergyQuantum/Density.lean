import H0mework.Physics.LowEnergyQuantum.Readout

/-! The original prepared response senses the nonlinear coframe feedback.
Its local density keeps the normalization factor generated by the source. -/
set_option autoImplicit false
namespace SaturationMonoid.PhysicsCore.LowEnergy.Quantum
open Evolution ProofFreeRicherAnholonomicSource StageNineHolonomicField
open Stage9C.Material.SpinPair DiracCliffordRepresentation DiracExteriorMatterAction
open StageNineFullDiracAdjointMaterial
open scoped Topology
noncomputable section

theorem spinExchange_involutive (matter : DiracExteriorMatterCarrier) :
    spinExchange (spinExchange matter) = matter := by
  funext spin
  fin_cases spin <;> simp [spinExchange, diracMatrixMatterAction, diracAdjointSpinSwap, Fin.sum_univ_four]

theorem normalizedRead_exchange (angle : ℝ) : normalizedRead angle spinExchange = 1 := by
  unfold normalizedRead
  rw [matrix_action]
  change coordinatePair (preparedSpinor (1/2) angle)
    (spinExchange (spinExchange (preparedSpinor (1/2) angle))) = 1
  rw [spinExchange_involutive, prepared_unit]

def timePoint (time : ℝ) : BasePoint := EuclideanSpace.single 0 time

def densityProfile {initial : State} (flow : Solution initial) (time : ℝ) : ℝ :=
  (flow.configuration.conjugateMatter (timePoint time)
    (spinExchange (flow.configuration.matter (timePoint time)))).re

def densityValue (x : State) : ℝ := 4*spinScale/(x 0)^3
def densityRate (x : State) : ℝ := -12*spinScale*clock x*x 1/(x 0)^4

theorem density_readback {initial : State} (flow : Solution initial) (time : ℝ)
    (inside : time ∈ Set.Ioo (-flow.radius) flow.radius) : densityProfile flow time = densityValue (flow.curve time) := by
  have located : (timePoint time) 0 ∈ Set.Ioo (-flow.radius) flow.radius := by simpa [timePoint] using inside
  unfold densityProfile
  rw [moving_response flow (timePoint time) located spinExchange, normalizedRead_exchange]
  rw [mul_one, Complex.ofReal_re]
  simp [densityValue, Solution.pointState, timePoint]

theorem densityValue_derivative {initial : State} (flow : Solution initial) (time : ℝ)
    (inside : time ∈ Set.Ioo (-flow.radius) flow.radius) :
    HasDerivAt (fun t => densityValue (flow.curve t)) (densityRate (flow.curve time)) time := by
  have derivative := (hasDerivAt_const time (4*spinScale)).div
    ((flow.coordinate_derivative time inside 0).pow 3) (pow_ne_zero _ (ne_of_gt (flow.admissible time inside).1))
  convert derivative using 1 <;> first | rfl | skip
  change -12*spinScale*clock (flow.curve time)*flow.curve time 1/(flow.curve time 0)^4 =
    (0*(flow.curve time 0)^3-4*spinScale*(3*(flow.curve time 0)^2*
      (clock (flow.curve time)*flow.curve time 1)))/((flow.curve time 0)^3)^2
  field_simp [ne_of_gt (flow.admissible time inside).1]
  ring

theorem densityProfile_derivative {initial : State} (flow : Solution initial) (time : ℝ)
    (inside : time ∈ Set.Ioo (-flow.radius) flow.radius) :
    HasDerivAt (densityProfile flow) (densityRate (flow.curve time)) time := by
  have equal : densityProfile flow =ᶠ[𝓝 time] (fun t => densityValue (flow.curve t)) := by
    filter_upwards [isOpen_Ioo.mem_nhds inside] with t ht
    exact density_readback flow t ht
  exact (densityValue_derivative flow time inside).congr_of_eventuallyEq equal

theorem spatial_volume_response {initial : State} (flow : Solution initial) (time : ℝ)
    (inside : time ∈ Set.Ioo (-flow.radius) flow.radius) :
    (flow.curve time 0)^3*densityProfile flow time = 4*spinScale := by
  rw [density_readback flow time inside]
  unfold densityValue
  field_simp [ne_of_gt (flow.admissible time inside).1]

theorem source_density_initial (parameter : ℝ) : densityProfile (solution parameter) 0 = 4*spinScale := by
  rw [density_readback (solution parameter) 0 ⟨neg_neg_of_pos (solution parameter).positive, (solution parameter).positive⟩,
    source_initial]
  simp [densityValue, Evolution.seed]

theorem source_density_first (parameter : ℝ) : HasDerivAt (densityProfile (solution parameter)) 0 0 := by
  have derivative := densityProfile_derivative (solution parameter) 0
    ⟨neg_neg_of_pos (solution parameter).positive, (solution parameter).positive⟩
  simpa only [source_initial, densityRate, Evolution.seed, mul_zero, zero_div] using derivative

theorem densityRate_source_derivative (parameter : ℝ) :
    HasDerivAt (fun t => densityRate ((solution parameter).curve t))
      (2*spinScale*Contact.Stress.weight*(Contact.Slice.impulse parameter)^2) 0 := by
  let flow := solution parameter
  have inside : (0 : ℝ) ∈ Set.Ioo (-flow.radius) flow.radius := ⟨neg_neg_of_pos flow.positive, flow.positive⟩
  have numerator := ((flow.clock_derivative 0 inside).const_mul (-12*spinScale)).mul
    (flow.coordinate_derivative 0 inside 1)
  have denominator := (flow.coordinate_derivative 0 inside 0).pow 4
  have derivative := numerator.div denominator (pow_ne_zero _ (ne_of_gt (flow.admissible 0 inside).1))
  convert derivative using 1 <;> first | rfl | skip
  dsimp [flow]
  rw [source_initial, generator_seed, clock_seed]
  simp [Evolution.seed, seedVelocity, Contact.Slice.scaleAcceleration]
  field_simp [ne_of_gt (Contact.Slice.clock_positive parameter)]
  ring

theorem densityValue_source_second (parameter : ℝ) :
    HasDerivAt (deriv (fun t => densityValue ((solution parameter).curve t)))
      (2*spinScale*Contact.Stress.weight*(Contact.Slice.impulse parameter)^2) 0 := by
  have inside : (0 : ℝ) ∈ Set.Ioo (-(solution parameter).radius) (solution parameter).radius :=
    ⟨neg_neg_of_pos (solution parameter).positive, (solution parameter).positive⟩
  have equal : deriv (fun t => densityValue ((solution parameter).curve t)) =ᶠ[𝓝 (0 : ℝ)]
      (fun t => densityRate ((solution parameter).curve t)) := by
    filter_upwards [isOpen_Ioo.mem_nhds inside] with time ht
    exact (densityValue_derivative (solution parameter) time ht).deriv
  exact (densityRate_source_derivative parameter).congr_of_eventuallyEq equal

theorem source_density_second (parameter : ℝ) :
    HasDerivAt (deriv (densityProfile (solution parameter)))
      (2*spinScale*Contact.Stress.weight*(Contact.Slice.impulse parameter)^2) 0 := by
  have inside : (0 : ℝ) ∈ Set.Ioo (-(solution parameter).radius) (solution parameter).radius :=
    ⟨neg_neg_of_pos (solution parameter).positive, (solution parameter).positive⟩
  have equal : densityProfile (solution parameter) =ᶠ[𝓝 (0 : ℝ)]
      (fun t => densityValue ((solution parameter).curve t)) := by
    filter_upwards [isOpen_Ioo.mem_nhds inside] with time ht
    exact density_readback (solution parameter) time ht
  exact (densityValue_source_second parameter).congr_of_eventuallyEq equal.deriv

theorem source_density_second_positive (parameter : ℝ) (nonzero : parameter ≠ 0) :
    0 < deriv (deriv (densityProfile (solution parameter))) 0 := by
  rw [(source_density_second parameter).deriv]
  exact mul_pos (mul_pos (mul_pos (by norm_num) spinScale_pos) Contact.Stress.weight_positive)
    (sq_pos_of_ne_zero (mul_ne_zero nonzero (ne_of_gt Response.Radial.growthRate_pos)))

theorem source_density_not_locally_constant (parameter : ℝ) (nonzero : parameter ≠ 0) (value : ℝ) :
    ¬densityProfile (solution parameter) =ᶠ[𝓝 (0 : ℝ)] (fun _ => value) := by
  intro equal
  have twice := equal.deriv.deriv_eq
  have zero : deriv (deriv (densityProfile (solution parameter))) 0 = 0 := by simpa using twice
  have positive := source_density_second_positive parameter nonzero
  rw [zero] at positive
  exact lt_irrefl _ positive

end
end SaturationMonoid.PhysicsCore.LowEnergy.Quantum
