/-- Two source-side run coordinates: the existing frequency estimate and the
estimated phase accumulated by the actual executed duration. -/
structure EstimatedFrequencyExecutedRunCalibrationAt
    (design : UniformFiniteLCTransducerNetworkDesign)
    (estimatedOmega actualDuration : ℝ) : Prop where
  frequencyCalibration : EstimatedFrequencyCalibrationAt design estimatedOmega
  estimatedAccumulatedPhaseError :
    |estimatedOmega * actualDuration - Real.pi / 2| <
      (1 : ℝ) / 4000

theorem executedRun_scaledEstimatedPhaseError_lt_oneThreeThousand
    {design : UniformFiniteLCTransducerNetworkDesign}
    {estimatedOmega actualDuration : ℝ}
    (run : EstimatedFrequencyExecutedRunCalibrationAt
      design estimatedOmega actualDuration) :
    |(normalizedLCAngularFrequency design / estimatedOmega) *
        (estimatedOmega * actualDuration - Real.pi / 2)| <
      (1 : ℝ) / 3000 := by
  let omega := normalizedLCAngularFrequency design
  have omegaPositive : 0 < omega :=
    normalizedLCAngularFrequency_pos design
      run.frequencyCalibration.componentAdmissible
  have estimatePositive : 0 < estimatedOmega :=
    run.frequencyCalibration.estimatedFrequencyPositive
  have ratioPositive : 0 < omega / estimatedOmega :=
    div_pos omegaPositive estimatePositive
  have ratioUpper : omega / estimatedOmega < (1001 : ℝ) / 1000 := by
    have upper := (abs_lt.mp
      run.frequencyCalibration.relativeFrequencyError).2
    dsimp [omega] at upper ⊢
    linarith
  rw [abs_mul, abs_of_pos ratioPositive]
  calc
    omega / estimatedOmega *
        |estimatedOmega * actualDuration - Real.pi / 2| ≤
      (1001 : ℝ) / 1000 *
        |estimatedOmega * actualDuration - Real.pi / 2| :=
      mul_le_mul_of_nonneg_right (le_of_lt ratioUpper)
        (abs_nonneg _)
    _ < (1001 : ℝ) / 1000 * ((1 : ℝ) / 4000) :=
      mul_lt_mul_of_pos_left run.estimatedAccumulatedPhaseError
        (by norm_num)
    _ < (1 : ℝ) / 3000 := by norm_num

theorem executedRun_frequencyRatioPhaseError_lt_oneFiveHundred
    {design : UniformFiniteLCTransducerNetworkDesign}
    {estimatedOmega actualDuration : ℝ}
    (run : EstimatedFrequencyExecutedRunCalibrationAt
      design estimatedOmega actualDuration) :
    |(normalizedLCAngularFrequency design / estimatedOmega - 1) *
        (Real.pi / 2)| < (1 : ℝ) / 500 := by
  rw [abs_mul, abs_of_pos (half_pos Real.pi_pos)]
  calc
    |normalizedLCAngularFrequency design / estimatedOmega - 1| *
        (Real.pi / 2) <
      ((1 : ℝ) / 1000) * (Real.pi / 2) :=
        mul_lt_mul_of_pos_right
          run.frequencyCalibration.relativeFrequencyError
          (half_pos Real.pi_pos)
    _ < (1 : ℝ) / 500 := by
      nlinarith [Real.pi_lt_four]

/-- The actual phase error is generated by the frequency-ratio error and the
estimated phase accumulated during the actual execution. -/
theorem executedRun_accumulatedPhaseError
    {design : UniformFiniteLCTransducerNetworkDesign}
    {estimatedOmega actualDuration : ℝ}
    (run : EstimatedFrequencyExecutedRunCalibrationAt
      design estimatedOmega actualDuration) :
    |normalizedLCAngularFrequency design * actualDuration - Real.pi / 2| <
      (1 : ℝ) / 400 := by
  let omega := normalizedLCAngularFrequency design
  have scaledEstimateError :=
    executedRun_scaledEstimatedPhaseError_lt_oneThreeThousand run
  have ratioError :=
    executedRun_frequencyRatioPhaseError_lt_oneFiveHundred run
  have estimateNe : estimatedOmega ≠ 0 :=
    ne_of_gt run.frequencyCalibration.estimatedFrequencyPositive
  have split :
      omega * actualDuration - Real.pi / 2 =
        (omega / estimatedOmega) *
            (estimatedOmega * actualDuration - Real.pi / 2) +
          (omega / estimatedOmega - 1) * (Real.pi / 2) := by
    field_simp [estimateNe]
    ring
  rw [split]
  calc
    |(omega / estimatedOmega) *
          (estimatedOmega * actualDuration - Real.pi / 2) +
        (omega / estimatedOmega - 1) * (Real.pi / 2)| ≤
      |(omega / estimatedOmega) *
          (estimatedOmega * actualDuration - Real.pi / 2)| +
        |(omega / estimatedOmega - 1) * (Real.pi / 2)| := abs_add_le _ _
    _ < (1 : ℝ) / 3000 + (1 : ℝ) / 500 :=
      add_lt_add scaledEstimateError ratioError
    _ < (1 : ℝ) / 400 := by norm_num

/-- Positivity of the actual duration is a consequence, not a caller field. -/
theorem executedRun_duration_pos
    {design : UniformFiniteLCTransducerNetworkDesign}
    {estimatedOmega actualDuration : ℝ}
    (run : EstimatedFrequencyExecutedRunCalibrationAt
      design estimatedOmega actualDuration) :
    0 < actualDuration := by
  let omega := normalizedLCAngularFrequency design
  have omegaPositive : 0 < omega :=
    normalizedLCAngularFrequency_pos design
      run.frequencyCalibration.componentAdmissible
  have phaseError := executedRun_accumulatedPhaseError run
  have phaseLower := (abs_lt.mp phaseError).1
  have phaseProductPositive : 0 < omega * actualDuration := by
    dsimp [omega] at phaseLower ⊢
    nlinarith [Real.pi_gt_three]
  by_contra notPositive
  have durationNonpositive : actualDuration ≤ 0 := le_of_not_gt notPositive
  have productNonpositive : omega * actualDuration ≤ 0 :=
    mul_nonpos_of_nonneg_of_nonpos (le_of_lt omegaPositive)
      durationNonpositive
  exact (not_lt_of_ge productNonpositive) phaseProductPositive

theorem executedRunReferenceGain_linearTolerance
    {design : UniformFiniteLCTransducerNetworkDesign}
    {estimatedOmega actualDuration : ℝ}
    (run : EstimatedFrequencyExecutedRunCalibrationAt
      design estimatedOmega actualDuration) :
    ‖compiledLCTransducerOperator design actualDuration -
        idealQuarterOperator‖ < (1 : ℝ) / 80 := by
  have distanceToCentre := norm_compiledLCTransducerOperator_sub_le
    design ninetyNinePercentUnitLCTransducerDesign
    actualDuration (Real.pi / 2)
  have referenceDesignGain :
      ninetyNinePercentUnitLCTransducerDesign.branch.transferGain =
        (99 : ℝ) / 100 := rfl
  rw [run.frequencyCalibration.referenceGain, referenceDesignGain,
    ninetyNinePercentUnitLC_frequency_eq_one] at distanceToCentre
  norm_num at distanceToCentre
  have phaseError := executedRun_accumulatedPhaseError run
  have centreDistanceLt :
      ‖compiledLCTransducerOperator design actualDuration -
        compiledLCTransducerQuarterOperator
          ninetyNinePercentUnitLCTransducerDesign‖ <
        (99 : ℝ) / 100 * ((1 : ℝ) / 400) := by
    unfold compiledLCTransducerQuarterOperator
    calc
      _ ≤ (99 : ℝ) / 100 *
          |normalizedLCAngularFrequency design * actualDuration -
            Real.pi / 2| := by
        simpa using distanceToCentre
      _ < (99 : ℝ) / 100 * ((1 : ℝ) / 400) :=
        mul_lt_mul_of_pos_left phaseError (by norm_num)
  calc
    ‖compiledLCTransducerOperator design actualDuration -
        idealQuarterOperator‖ =
      ‖(compiledLCTransducerOperator design actualDuration -
          compiledLCTransducerQuarterOperator
            ninetyNinePercentUnitLCTransducerDesign) +
        (compiledLCTransducerQuarterOperator
            ninetyNinePercentUnitLCTransducerDesign -
          idealQuarterOperator)‖ := by congr 1; abel
    _ ≤ ‖compiledLCTransducerOperator design actualDuration -
          compiledLCTransducerQuarterOperator
            ninetyNinePercentUnitLCTransducerDesign‖ +
        ‖compiledLCTransducerQuarterOperator
            ninetyNinePercentUnitLCTransducerDesign -
          idealQuarterOperator‖ := norm_add_le _ _
    _ < (99 : ℝ) / 100 * ((1 : ℝ) / 400) + (1 : ℝ) / 100 :=
      add_lt_add_of_lt_of_le centreDistanceLt
        ninetyNinePercentCenter_error_le_oneHundredth
    _ < (1 : ℝ) / 80 := by norm_num

structure EstimatedFrequencyExecutedRunAdditiveDisturbanceCrownAt
    (design : UniformFiniteLCTransducerNetworkDesign)
    (estimatedOmega actualDuration : ℝ)
    (disturbance : EndpointDisturbance) : Prop where
  runCalibration : EstimatedFrequencyExecutedRunCalibrationAt
    design estimatedOmega actualDuration
  disturbanceBound : ∀ state, ‖disturbance state‖ < (1 : ℝ) / 8
  executedDurationPositive : 0 < actualDuration
  executedAccumulatedPhaseError :
    |normalizedLCAngularFrequency design * actualDuration - Real.pi / 2| <
      (1 : ℝ) / 400
  generatedCouplingCrown :
    let tolerant : AdditiveDisturbanceToleranceAt
        (compiledLCTransducerOperator design actualDuration) disturbance := {
      linearPartTolerance := executedRunReferenceGain_linearTolerance
        runCalibration
      disturbanceBound := disturbanceBound
    }
    SourceGeneratedTruthChildNeuralBodyCouplingLaw.SourceGeneratedTruthChildNeuralBodyCouplingCrownAt
      (additiveDisturbanceCertifiedTruthChildCouplingLaw
        (compiledLCTransducerOperator design actualDuration)
        disturbance tolerant)

theorem estimatedFrequencyExecutedRunWithBoundedDisturbance_generatesCrown
    {design : UniformFiniteLCTransducerNetworkDesign}
    {estimatedOmega actualDuration : ℝ}
    (run : EstimatedFrequencyExecutedRunCalibrationAt
      design estimatedOmega actualDuration)
    (disturbance : EndpointDisturbance)
    (disturbanceBound : ∀ state, ‖disturbance state‖ < (1 : ℝ) / 8) :
    EstimatedFrequencyExecutedRunAdditiveDisturbanceCrownAt
      design estimatedOmega actualDuration disturbance := by
  let tolerant : AdditiveDisturbanceToleranceAt
      (compiledLCTransducerOperator design actualDuration) disturbance := {
    linearPartTolerance := executedRunReferenceGain_linearTolerance run
    disturbanceBound := disturbanceBound
  }
  exact {
    runCalibration := run
    disturbanceBound := disturbanceBound
    executedDurationPositive := executedRun_duration_pos run
    executedAccumulatedPhaseError := executedRun_accumulatedPhaseError run
    generatedCouplingCrown :=
      everyAdditiveDisturbanceWithinTolerance_generatesCouplingCrown _ _ tolerant
  }

/-- The execution is genuinely different from the schedule generated by the
frequency estimate. -/
def perturbedFrequencyExecutedDuration : ℝ :=
  estimatedQuarterDuration perturbedFrequencyEstimate + (1 : ℝ) / 2000

theorem perturbedFrequencyExecutedDuration_ne_schedule :
    perturbedFrequencyExecutedDuration ≠
      estimatedQuarterDuration perturbedFrequencyEstimate := by
  unfold perturbedFrequencyExecutedDuration
  norm_num

theorem perturbedFrequencyExecutedDuration_estimatedPhaseError :
    |perturbedFrequencyEstimate * perturbedFrequencyExecutedDuration -
        Real.pi / 2| <
      (1 : ℝ) / 4000 := by
  have scheduledPhase :
      perturbedFrequencyEstimate *
          estimatedQuarterDuration perturbedFrequencyEstimate =
        Real.pi / 2 := by
    unfold estimatedQuarterDuration
    field_simp [show perturbedFrequencyEstimate ≠ 0 by
      norm_num [perturbedFrequencyEstimate]]
  have phaseResidual :
      perturbedFrequencyEstimate * perturbedFrequencyExecutedDuration -
          Real.pi / 2 =
        perturbedFrequencyEstimate * ((1 : ℝ) / 2000) := by
    unfold perturbedFrequencyExecutedDuration
    rw [mul_add, scheduledPhase]
    ring
  rw [phaseResidual, abs_mul,
    abs_of_pos (by norm_num [perturbedFrequencyEstimate]),
    abs_of_pos (by norm_num)]
  norm_num [perturbedFrequencyEstimate]

theorem perturbedFrequencyExecutedRunCalibration :
    EstimatedFrequencyExecutedRunCalibrationAt fourUnitReferenceGainDesign
      perturbedFrequencyEstimate perturbedFrequencyExecutedDuration where
  frequencyCalibration := fourUnitPerturbedFrequencyCalibration
  estimatedAccumulatedPhaseError :=
    perturbedFrequencyExecutedDuration_estimatedPhaseError

theorem perturbedFrequencyExecuted_signedPhaseResidual_eq :
    normalizedLCAngularFrequency fourUnitReferenceGainDesign *
        perturbedFrequencyExecutedDuration - Real.pi / 2 =
      -Real.pi / 2002 + (1 : ℝ) / 8000 := by
  have split :
      normalizedLCAngularFrequency fourUnitReferenceGainDesign *
          perturbedFrequencyExecutedDuration - Real.pi / 2 =
        (normalizedLCAngularFrequency fourUnitReferenceGainDesign *
          estimatedQuarterDuration perturbedFrequencyEstimate - Real.pi / 2) +
        normalizedLCAngularFrequency fourUnitReferenceGainDesign *
          ((1 : ℝ) / 2000) := by
    unfold perturbedFrequencyExecutedDuration
    ring
  rw [split, perturbedEstimate_signedPhaseResidual_eq,
    fourUnitReferenceGain_actualFrequency_eq_quarter]
  ring

/-- A premise-free point where both the frequency estimate and the executed
duration differ from their exact values while a visible disturbance survives. -/
structure PerturbedFrequencyExecutedRunVisibleBiasCrown : Prop where
  estimateDiffersFromActual : perturbedFrequencyEstimate ≠
    normalizedLCAngularFrequency fourUnitReferenceGainDesign
  executionDiffersFromSchedule : perturbedFrequencyExecutedDuration ≠
    estimatedQuarterDuration perturbedFrequencyEstimate
  signedPhaseResidual :
    normalizedLCAngularFrequency fourUnitReferenceGainDesign *
        perturbedFrequencyExecutedDuration - Real.pi / 2 =
      -Real.pi / 2002 + (1 : ℝ) / 8000
  disturbanceNonzero : smallNonzeroConstantBias ≠ 0
  visibleFalseSourceTarget :
    targetPort
        (disturbedImplementedState
          (compiledLCTransducerOperator fourUnitReferenceGainDesign
            perturbedFrequencyExecutedDuration)
          smallNonzeroConstantBias (preparedState false)) .sourceBound =
      (1 : ℝ) / 1000
  coupling : EstimatedFrequencyExecutedRunAdditiveDisturbanceCrownAt
    fourUnitReferenceGainDesign perturbedFrequencyEstimate
    perturbedFrequencyExecutedDuration smallNonzeroConstantBias

theorem perturbedFrequencyExecutedRunWithVisibleBias_constructible :
    PerturbedFrequencyExecutedRunVisibleBiasCrown where
  estimateDiffersFromActual := perturbedFrequencyEstimate_ne_actual
  executionDiffersFromSchedule :=
    perturbedFrequencyExecutedDuration_ne_schedule
  signedPhaseResidual := perturbedFrequencyExecuted_signedPhaseResidual_eq
  disturbanceNonzero := smallNonzeroConstantBias_ne_zero
  visibleFalseSourceTarget :=
    smallBias_falseSourceTarget_eq_oneThousandth_for _
  coupling :=
    estimatedFrequencyExecutedRunWithBoundedDisturbance_generatesCrown
      perturbedFrequencyExecutedRunCalibration smallNonzeroConstantBias
      smallNonzeroConstantBias_bound

end

