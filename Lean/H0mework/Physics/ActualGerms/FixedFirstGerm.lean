def canonicalGeneratedScalarCovariantIncrement
    (point : BasePoint) (formDirection : LorentzianIndex) :
    ScalarCoordinateCarrier :=
  holonomicScalarGaugeConnectionVariation CanonicalInput
    CanonicalQuadraticVariation point formDirection

theorem canonicalGeneratedScalarCovariantIncrement_contDiff
    (formDirection : LorentzianIndex) :
    ContDiff ℝ ∞ (fun point =>
      canonicalGeneratedScalarCovariantIncrement point formDirection) := by
  have variationSmooth : ContDiff ℝ ∞ CanonicalQuadraticVariation :=
    p286HolonomicSecondJetQuadraticRealization_contDiff
      (p286CanonicalDiagonalResponseSecondJet
        fixedP506L0P286CanonicalGeneratedWrite)
  have coordinateSmooth : ContDiff ℝ ∞ (fun point =>
      CanonicalQuadraticVariation point formDirection) :=
    contDiff_pi.mp variationSmooth formDirection
  have scalarSmooth : ContDiff ℝ ∞ CanonicalInput.scalar :=
    (fixedP506L0FinalCommonActionActual_smooth 0).2.2.2.2.2.2.1
  have outerSmooth : ContDiff ℝ ∞ (fun point =>
      scalarP286ActionBilinear.toContinuousBilinearMap
        (CanonicalQuadraticVariation point formDirection)) :=
    contDiff_const.clm_apply coordinateSmooth
  rw [show (fun point =>
      canonicalGeneratedScalarCovariantIncrement point formDirection) =
      fun point =>
        scalarP286ActionBilinear
          (CanonicalQuadraticVariation point formDirection)
          (CanonicalInput.scalar point) by
    funext point
    rfl]
  exact outerSmooth.clm_apply scalarSmooth

private theorem canonicalGeneratedScalarCovariantIncrement_origin
    (formDirection : LorentzianIndex) :
    canonicalGeneratedScalarCovariantIncrement 0 formDirection = 0 := by
  unfold canonicalGeneratedScalarCovariantIncrement
    holonomicScalarGaugeConnectionVariation
    p286GaugeConnectionMotherVariation CanonicalQuadraticVariation
  rw [p286HolonomicSecondJetQuadraticRealization_origin]
  simp

private theorem canonicalGeneratedScalarCovariantIncrement_derivative_origin
    (derivativeDirection formDirection : LorentzianIndex) :
    fieldDirectionalDerivative
        (fun point =>
          canonicalGeneratedScalarCovariantIncrement point formDirection)
        0 derivativeDirection = 0 := by
  have variationSmooth : ContDiff ℝ ∞ CanonicalQuadraticVariation :=
    p286HolonomicSecondJetQuadraticRealization_contDiff
      (p286CanonicalDiagonalResponseSecondJet
        fixedP506L0P286CanonicalGeneratedWrite)
  have parameterDifferentiable : DifferentiableAt ℝ
      (fun point => CanonicalQuadraticVariation point formDirection) 0 :=
    ((contDiff_pi.mp variationSmooth formDirection).differentiable
      (by simp)).differentiableAt
  have scalarDifferentiable : DifferentiableAt ℝ CanonicalInput.scalar 0 :=
    (((fixedP506L0FinalCommonActionActual_smooth 0).2.2.2.2.2.2.1
      ).differentiable (by simp)).differentiableAt
  let action := scalarP286ActionBilinear.toContinuousBilinearMap
  have totalDerivative :
      fderiv ℝ
          (fun point =>
            action (CanonicalQuadraticVariation point formDirection)
              (CanonicalInput.scalar point)) 0 =
        action.precompR BasePoint
              (CanonicalQuadraticVariation 0 formDirection)
              (fderiv ℝ CanonicalInput.scalar 0) +
          action.precompL BasePoint
              (fderiv ℝ
                (fun point =>
                  CanonicalQuadraticVariation point formDirection) 0)
              (CanonicalInput.scalar 0) :=
    (action.hasFDerivAt_of_bilinear parameterDifferentiable.hasFDerivAt
      scalarDifferentiable.hasFDerivAt).fderiv
  have functionEquality :
      (fun point =>
        canonicalGeneratedScalarCovariantIncrement point formDirection) =
      fun point =>
        action (CanonicalQuadraticVariation point formDirection)
          (CanonicalInput.scalar point) := by
    funext point
    rfl
  rw [functionEquality]
  unfold fieldDirectionalDerivative
  rw [totalDerivative]
  simp only [add_apply, ContinuousLinearMap.precompR_apply,
    ContinuousLinearMap.precompL_apply]
  change
    scalarP286ActionBilinear
          (CanonicalQuadraticVariation 0 formDirection)
          (fieldDirectionalDerivative CanonicalInput.scalar 0
            derivativeDirection) +
        scalarP286ActionBilinear
          (fieldDirectionalDerivative
            (fun point => CanonicalQuadraticVariation point formDirection)
            0 derivativeDirection)
          (CanonicalInput.scalar 0) = 0
  rw [show CanonicalQuadraticVariation 0 formDirection = 0 by
      simp [CanonicalQuadraticVariation],
    show fieldDirectionalDerivative
        (fun point => CanonicalQuadraticVariation point formDirection)
        0 derivativeDirection = 0 by
      have wholeDerivative :=
        p286HolonomicSecondJetQuadraticRealization_firstJet_origin
          (p286CanonicalDiagonalResponseSecondJet
            fixedP506L0P286CanonicalGeneratedWrite)
          derivativeDirection
      rw [← fieldDirectionalDerivative_pi_apply CanonicalQuadraticVariation
        variationSmooth 0 derivativeDirection formDirection]
      exact congrFun wholeDerivative formDirection]
  simp [scalarP286ActionBilinear]

theorem canonicalGeneratedActual_scalarCovariantDerivative_expansion
    (point : BasePoint) :
    holonomicScalarCovariantDerivative CanonicalActual point =
      holonomicScalarCovariantDerivative CanonicalInput point +
