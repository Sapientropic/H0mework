/-- The canonical Hessian write changes the live higher jet, not the value of
the complete continuum point field at the fixed origin. -/
theorem fixedP506L0P286CanonicalGeneratedActual_pointField_origin :
    toContinuumPointField CanonicalActual 0 =
      toContinuumPointField CanonicalInput 0 := by
  apply StageNineContinuumPointField.ext
  · exact congrFun canonicalGeneratedActual_coframe 0
  · change
      holonomicGravityCurvature CanonicalActual 0 =
        holonomicGravityCurvature CanonicalInput 0
    funext internalPair spacetimePair
    unfold holonomicGravityCurvature gravityConnectionDerivative
    rw [canonicalGeneratedActual_gravityConnection]
  · exact congrFun canonicalGeneratedActual_gravityAuxiliary 0
  · exact congrFun canonicalGeneratedActual_gravitySimplicityMultiplier 0
  · exact canonicalGeneratedActual_curvature_origin
  · exact canonicalGeneratedActual_auxiliary_origin
  · exact congrFun canonicalGeneratedActual_scalar 0
  · change
      holonomicScalarCovariantDerivative CanonicalActual 0 =
        holonomicScalarCovariantDerivative CanonicalInput 0
    funext direction
    unfold holonomicScalarCovariantDerivative
    rw [canonicalGeneratedActual_scalar,
      canonicalGeneratedActual_connection_origin]
  · exact congrFun canonicalGeneratedActual_matter 0
  · change
      holonomicMatterCovariantDerivative CanonicalActual 0 =
        holonomicMatterCovariantDerivative CanonicalInput 0
    funext direction
    unfold holonomicMatterCovariantDerivative
    rw [canonicalGeneratedActual_matter,
      canonicalGeneratedActual_gravityConnection,
      canonicalGeneratedActual_connection_origin]
  · exact congrFun canonicalGeneratedActual_conjugateMatter 0

