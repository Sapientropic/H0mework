/-! ## First exact runtime obstruction and resumed producer -/

/-- Complete end-to-end boundary checkpoint: exact runtime occurrence, typed
U7 demand, canonical answer, coface next, resumed coface write, and settled
boundary are one source history. -/
theorem physicalRuntime_boundaryU7_resumes_at_firstGravity :
    quadraticCoframeBoundaryDemand.entry =
        rootOccurrenceLedgerEntry
          physicalRuntimeSeed.tick.generated.occurrence ∧
      Nonempty
        (SourceNativeRootResidualAnswerAndNextAt initialTemporalVisit
          fixedRootQuadraticCoframeBoundaryObstruction
          initialCausalEntryAuthority) ∧
      quadraticCoframeBoundaryAnswerAndNext.answerAndNext.nextCurrent =
        physicalRuntimeAfterBoundary.current.erase ∧
      HEq physicalRuntimeAfterBoundary.tick.generated
        stageTenPhysicalRootClosure.cofaceEvent ∧
      physicalRuntimeAfterCoface.current.visit.current = firstGravityCurrent ∧
      (rootLedgerEntry firstGravityCurrent).1.coframeBoundary = .settled := by
  exact ⟨rfl, ⟨quadraticCoframeBoundaryAnswerAndNext⟩, rfl,
    physicalRuntimeAfterBoundary_tick_eq_closure_coface, rfl, rfl⟩

