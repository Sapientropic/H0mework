open StageNineDiracDualFormNativeFixedP506CartanECConstraintCauchyGravityTailRootU7AnswerNext

noncomputable section

/-- The physical process state is finite causal depth, not a five-position
terminal enum.  Each visit is recursively generated by the same living-root
successor. -/
def physicalRuntimeVisit : Nat → SourceNativeTemporalVisitAt
    livingRoot.toAuthoritativeRoot.toLedgerRoot
  | 0 => livingInitialVisit
  | depth + 1 => livingRootNextVisit (physicalRuntimeVisit depth)

def physicalRuntimeCurrentAt (depth : Nat) :
    SourceNativeLivingRootCurrentAt N :=
  { V := V
    root := livingRoot
    visit := physicalRuntimeVisit depth }

/-- Causal depth after a true cofinal landing. -/
def physicalPostCofinalDepth
    {W : Vocabulary} {root : SourceNativeLedgerRootClosure N W}
    {current : W.Current} :
    SourceNativePostCofinalReachableAt root current → Nat
  | .cofinal _visit => 0
  | .step prior _next_eq => physicalPostCofinalDepth prior + 1

/-- Causal depth of either temporal-history origin. -/
def physicalTemporalDepth
    {W : Vocabulary} {root : SourceNativeLedgerRootClosure N W}
    {current : W.Current} :
    SourceNativeTemporalReachableAt root current → Nat
  | .finite history => ProductiveFiniteRootHistoryAt.causalDepth history
  | .postCofinal history => physicalPostCofinalDepth history

@[simp] theorem physicalTemporalDepth_next
    {W : Vocabulary} {root : SourceNativeLedgerRootClosure N W}
    {current next : W.Current}
    (history : SourceNativeTemporalReachableAt root current)
    (next_eq :
      (root.toRoot.evolutionAt current).nextCurrent? = some next) :
    physicalTemporalDepth (history.next next_eq) =
      physicalTemporalDepth history + 1 := by
  cases history <;> rfl

@[simp] theorem physicalTemporalDepth_livingRootNextVisit
    (visit : SourceNativeTemporalVisitAt
      livingRoot.toAuthoritativeRoot.toLedgerRoot) :
    physicalTemporalDepth (livingRootNextVisit visit).history =
      physicalTemporalDepth visit.history + 1 := by
  unfold livingRootNextVisit
  apply physicalTemporalDepth_next

/-- Constructive depth readout used only to prove that the Nat presentation
cannot identify two different registered histories. -/
def physicalRuntimeDepth
    (current : SourceNativeLivingRootCurrentAt N) : Nat :=
  physicalTemporalDepth current.visit.history

theorem physicalRuntimeVisit_history_depth (depth : Nat) :
    physicalTemporalDepth (physicalRuntimeVisit depth).history = depth := by
  induction depth with
  | zero => rfl
  | succ depth inductionHypothesis =>
      simpa only [physicalRuntimeVisit,
        physicalTemporalDepth_livingRootNextVisit]
        using congrArg Nat.succ inductionHypothesis

theorem physicalRuntimeVisit_depth (depth : Nat) :
    physicalRuntimeDepth (physicalRuntimeCurrentAt depth) = depth := by
  simpa only [physicalRuntimeDepth, physicalRuntimeCurrentAt] using
    physicalRuntimeVisit_history_depth depth

/-- The source-native physical process keeps running beyond the five positions
named by the Stage-Ten closure.  Those positions are its initial prefix, not a
finite terminal enum. -/
def physicalRuntimeProcess : SourceNativeLivingRootProcess N where
  State := Nat
  stateAt := physicalRuntimeCurrentAt
  stateAt_injective := by
    intro left right current_eq
    have depth_eq := congrArg physicalRuntimeDepth current_eq
    rw [physicalRuntimeVisit_depth left,
      physicalRuntimeVisit_depth right] at depth_eq
    exact depth_eq
  initial := 0
  successorAt := by
    intro depth
    refine ⟨depth + 1, ?_, ?_⟩
    · change
        ({ V := V
           root := authoritativeRoot
           visit := physicalRuntimeVisit (depth + 1) } :
          SourceNativeAuthoritativeRootCurrentAt N) =
          livingRoot.generatedNextCurrentAt (physicalRuntimeVisit depth)
      exact (livingRoot_generated_next_eq (physicalRuntimeVisit depth)).symm
    · generalize
        (physicalRuntimeCurrentAt depth).root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt
          (physicalRuntimeCurrentAt depth).visit.current = generated
      cases generated <;> trivial

/-- Closed Physics runtime facade.  Every active coordinate is one projection
already installed in the fixed authoritative root. -/
def physicalRuntimeFacade : SourceNativeLivingRuntimeFacade N where
  process := physicalRuntimeProcess
  FaceAt := fun runtime =>
    runtime.current.root.toAuthoritativeRoot.source.projectionLaw.Projection
  componentAt := fun runtime _face =>
    runtime.current.root.toAuthoritativeRoot.source.projectionLaw
  installationAt := fun _runtime _face => .ofEq rfl
  projectionAt := fun _runtime face => face

/-- The unique runtime seed is the fixed physical initial visit. -/
def physicalRuntimeSeed : LivingRuntimeState physicalRuntimeProcess :=
  physicalRuntimeFacade.seed

def physicalRuntimeAfterBoundary := physicalRuntimeSeed.tick.next

def physicalRuntimeAfterCoface := physicalRuntimeAfterBoundary.tick.next

def physicalRuntimeAfterGravity := physicalRuntimeAfterCoface.tick.next

def physicalRuntimeAfterAssembly := physicalRuntimeAfterGravity.tick.next

def physicalRuntimeAfterPostAssembly := physicalRuntimeAfterAssembly.tick.next

def physicalRuntimeAfterSecondAssembly :=
  physicalRuntimeAfterPostAssembly.tick.next

/-- The sixth event is read directly from the same living-root compiler.  It
does not import a numerical second-assembly recurrence or a cycle witness. -/
def secondAssemblyRuntimeEvent : ExactTemporalCausalRootEventAt
    sourceNativeRoot afterPostAssemblyTemporalVisit :=
  sourceNativeRoot.generatedAtTemporalVisit afterPostAssemblyTemporalVisit

@[simp] theorem physicalRuntimeVisit_zero_current_eq_initial :
    (physicalRuntimeVisit 0).current = Initial := rfl

@[simp] theorem physicalRuntimeVisit_one_current_eq_coface :
    (physicalRuntimeVisit 1).current = quadraticCofaceCurrent := rfl

@[simp] theorem physicalRuntimeVisit_two_current_eq_gravity :
    (physicalRuntimeVisit 2).current = firstGravityCurrent := rfl

@[simp] theorem physicalRuntimeVisit_three_current_eq_assembly :
    (physicalRuntimeVisit 3).current = firstAssemblyCurrent := rfl

@[simp] theorem physicalRuntimeVisit_four_current_eq_postAssembly :
    (physicalRuntimeVisit 4).current = firstPostAssemblyGravityCurrent := rfl

@[simp] theorem physicalRuntimeVisit_five_current_eq_secondAssembly :
    (physicalRuntimeVisit 5).current = secondAssemblyCurrent := rfl

@[simp] theorem physicalRuntimeVisit_six_current_eq_nextGravity :
    (physicalRuntimeVisit 6).current = Next secondAssemblyCurrent := rfl

