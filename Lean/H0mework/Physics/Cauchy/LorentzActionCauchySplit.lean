import H0mework.Physics.Lorentz.LorentzConnectionPointwiseEquation
import H0mework.Physics.Cauchy.P286ActionCauchySplit

/-!
# Stage-9 Lorentz action Cauchy split

The Lorentz connection Euler--Lagrange coefficient is already generated by
the actual Stage-9 action.  This module tests that coefficient against a
constant purely temporal Lorentz one-form and separates its four directional
BF-momentum derivatives:

```text
temporal test q = dt ⊗ c
→ d₀q = dt ∧ dt ⊗ c = 0
→ EL(q) = algebraic spin current(q) - spatial BF divergence(q).
```

The vanishing temporal channel is a structural exterior-calculus identity.
The resulting Gauss predicate is a downstream, failure-capable constraint;
it is not stored in a source or generated by a residual repair.  The fixed
time direction is the existing canonical Cauchy convention, not a caller
supplied foliation, event, branch, or source-time law.
-/

namespace SaturationMonoid.PhysicsCore.StageNineLorentzActionCauchySplit

open ProofFreeRicherAnholonomicSource
open StageNineEnrichedProofFreeSource
open StageNineGravityAuxiliaryVariation
open StageNineHolonomicField
open StageNineLorentzConnectionMomentumRegularity
open StageNineLorentzConnectionPointwiseEquation
open StageNineLorentzConnectionVariation
open StageNineP286ActionCauchySplit

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 5000000
set_option maxRecDepth 100000

/-- Six Lorentz-bivector coefficients carried by the temporal component of a
connection test one-form. -/
abbrev LorentzTemporalBivectorDirection := Fin 6 → ℝ

/-- Canonical constant Lorentz one-form with only a temporal component. -/
def canonicalLorentzTemporalBivectorOneForm
    (component : LorentzTemporalBivectorDirection) :
    LorentzBivectorOneForm :=
  fun direction =>
    if direction = canonicalLorentzianTimeDirection then component else 0

@[simp] theorem canonicalLorentzTemporalBivectorOneForm_time
    (component : LorentzTemporalBivectorDirection) :
    canonicalLorentzTemporalBivectorOneForm component
        canonicalLorentzianTimeDirection =
      component := by
  simp [canonicalLorentzTemporalBivectorOneForm]

/-- Time-direction contribution to the Lorentz BF-momentum divergence. -/
def lorentzConnectionTemporalBFMomentumDerivative
    (configuration : StageNineHolonomicConfiguration)
    (direction : LorentzBivectorOneForm)
    (point : BasePoint) : ℝ :=
  fieldDirectionalDerivative
    (lorentzConnectionBFDifferentialMomentum configuration
      (lorentzConnectionExteriorDerivativeDirection
        canonicalLorentzianTimeDirection direction))
    point canonicalLorentzianTimeDirection

/-- Three fixed spatial contributions to the Lorentz BF-momentum divergence. -/
def lorentzConnectionSpatialBFMomentumDivergence
    (configuration : StageNineHolonomicConfiguration)
    (direction : LorentzBivectorOneForm)
    (point : BasePoint) : ℝ :=
  fieldDirectionalDerivative
      (lorentzConnectionBFDifferentialMomentum configuration
        (lorentzConnectionExteriorDerivativeDirection 1 direction))
      point 1 +
    fieldDirectionalDerivative
      (lorentzConnectionBFDifferentialMomentum configuration
        (lorentzConnectionExteriorDerivativeDirection 2 direction))
      point 2 +
    fieldDirectionalDerivative
      (lorentzConnectionBFDifferentialMomentum configuration
        (lorentzConnectionExteriorDerivativeDirection 3 direction))
      point 3

/-- Exact `1+3` decomposition of the action-owned Lorentz BF divergence. -/
theorem lorentzConnectionBFDifferentialMomentumDivergence_eq_temporal_add_spatial
    (configuration : StageNineHolonomicConfiguration)
    (direction : LorentzBivectorOneForm)
    (point : BasePoint) :
    lorentzConnectionBFDifferentialMomentumDivergence configuration direction
        point =
      lorentzConnectionTemporalBFMomentumDerivative configuration direction
          point +
        lorentzConnectionSpatialBFMomentumDivergence configuration direction
          point := by
  simp [lorentzConnectionBFDifferentialMomentumDivergence,
    lorentzConnectionTemporalBFMomentumDerivative,
    lorentzConnectionSpatialBFMomentumDivergence,
    canonicalLorentzianTimeDirection, Fin.sum_univ_four]
  ring

/-- A purely temporal connection direction has no `dt ∧ dt` channel. -/
theorem lorentzConnectionExteriorDerivativeDirection_time_temporal_eq_zero
    (component : LorentzTemporalBivectorDirection) :
    lorentzConnectionExteriorDerivativeDirection
        canonicalLorentzianTimeDirection
        (canonicalLorentzTemporalBivectorOneForm component) =
      0 := by
  funext internalPair spacetimePair
  fin_cases internalPair <;> fin_cases spacetimePair <;>
    simp [lorentzConnectionExteriorDerivativeDirection,
      canonicalLorentzTemporalBivectorOneForm,
      canonicalLorentzianTimeDirection,
      lorentzSkewConnectionOfBivectorOneForm,
      loweredLorentzBivectorMatrix,
      orientedLorentzBivectorBasisCoefficient,
      minkowskiInternalSign, pairFirst, pairSecond]

private theorem lorentzConnectionBFDifferentialMomentum_zero
    (configuration : StageNineHolonomicConfiguration) :
    lorentzConnectionBFDifferentialMomentum configuration
        (0 : PhysicalBivector) =
      0 := by
  funext point
  simp [lorentzConnectionBFDifferentialMomentum,
    gravityAuxiliaryHodgePairingPolynomial]

/-- The temporal BF-momentum derivative therefore vanishes for every purely
temporal test component, independently of the field equations. -/
theorem lorentzConnectionTemporalBFMomentumDerivative_temporal_eq_zero
    (configuration : StageNineHolonomicConfiguration)
    (component : LorentzTemporalBivectorDirection)
    (point : BasePoint) :
    lorentzConnectionTemporalBFMomentumDerivative configuration
        (canonicalLorentzTemporalBivectorOneForm component) point =
      0 := by
  rw [lorentzConnectionTemporalBFMomentumDerivative,
    lorentzConnectionExteriorDerivativeDirection_time_temporal_eq_zero,
    lorentzConnectionBFDifferentialMomentum_zero]
  simp [fieldDirectionalDerivative]

/-- Actual Lorentz EL residual restricted to a purely temporal test. -/
def lorentzTemporalGaussResidual
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint)
    (component : LorentzTemporalBivectorDirection) : ℝ :=
  lorentzConnectionEulerLagrangeCoefficient source configuration
    (canonicalLorentzTemporalBivectorOneForm component) point

/-- All six temporal Lorentz test components vanish at one actual point. -/
def CanonicalLorentzTemporalGaussConstraintAt
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) : Prop :=
  ∀ component,
    lorentzTemporalGaussResidual source configuration point component = 0

/-- Structural Gauss normal form: algebraic spin responsibility minus the
three-dimensional BF-momentum divergence. -/
theorem lorentzTemporalGaussResidual_eq_algebraic_sub_spatial
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint)
    (component : LorentzTemporalBivectorDirection) :
    lorentzTemporalGaussResidual source configuration point component =
      lorentzConnectionAlgebraicSpinCurrentCoefficient source configuration
          (canonicalLorentzTemporalBivectorOneForm component) point -
        lorentzConnectionSpatialBFMomentumDivergence configuration
          (canonicalLorentzTemporalBivectorOneForm component) point := by
  rw [lorentzTemporalGaussResidual,
    lorentzConnectionEulerLagrangeCoefficient,
    lorentzConnectionBFDifferentialMomentumDivergence_eq_temporal_add_spatial,
    lorentzConnectionTemporalBFMomentumDerivative_temporal_eq_zero]
  ring

theorem canonicalLorentzTemporalGaussConstraintAt_iff
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    CanonicalLorentzTemporalGaussConstraintAt source configuration point ↔
      ∀ component,
        lorentzConnectionAlgebraicSpinCurrentCoefficient source configuration
            (canonicalLorentzTemporalBivectorOneForm component) point =
          lorentzConnectionSpatialBFMomentumDivergence configuration
            (canonicalLorentzTemporalBivectorOneForm component) point := by
  constructor
  · intro constraint component
    have residualZero := constraint component
    rw [lorentzTemporalGaussResidual_eq_algebraic_sub_spatial] at residualZero
    exact sub_eq_zero.mp residualZero
  · intro balance component
    rw [lorentzTemporalGaussResidual_eq_algebraic_sub_spatial,
      balance component]
    ring

/-- A full Lorentz pointwise equation entails its temporal Gauss sector.  This
is a structural projection of an already established equation, not a producer
for that equation. -/
theorem canonicalLorentzConnectionPointwiseEquation_implies_temporalGauss
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (equation :
      CanonicalLorentzConnectionPointwiseEquation source configuration)
    (point : BasePoint) :
    CanonicalLorentzTemporalGaussConstraintAt source configuration point := by
  intro component
  simpa [lorentzTemporalGaussResidual] using
    congrFun (equation
      (canonicalLorentzTemporalBivectorOneForm component)) point

end

end SaturationMonoid.PhysicsCore.StageNineLorentzActionCauchySplit
