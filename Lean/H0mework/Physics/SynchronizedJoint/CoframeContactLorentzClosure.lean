import H0mework.Physics.SynchronizedJoint.CoframeContactLocalActualLift

/-!
# Lorentz closure of the synchronized Cartan--EC contact write

This direct consumer verifies the complete Lorentz Euler three-form on the
single actual generated by the synchronized coframe producer.  It is split
from the producer module so the source/current/contact write and its algebraic
torsion readback remain a narrow gate.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeCartanECSynchronizedCoframeContactLorentzClosure

open ProofFreeRicherAnholonomicSource
open StageNineCartanAffineConnectionActualization
open StageNineCartanTorsionThreeFormCoordinates
open StageNineCoframeFirstJet
open StageNineDiracDualFormNativeCartanConnectionActualization
open StageNineDiracDualFormNativeCartanConnectionLocalActualLift
open StageNineDiracDualFormNativeCartanECSynchronizedCoframeContactLocalActualLift
open StageNineDiracDualFormNativeCoframeECContactLocalActualLift
open StageNineDiracDualFormNativeCoframeLocalVariation
open StageNineEnrichedProofFreeSource
open StageNineFormNativeGravityMultiplierAuxiliaryIntegratedVariation
open StageNineFormNativeIIPlusJetKinematics
open StageNineFormNativeLorentzGeometricFirstVariation
open StageNineFormNativeLorentzGeometricKinematics
open StageNineFormNativeMatterSpinThreeForm
open StageNineGlobalIntegratedAction
open StageNineGravityBianchi
open StageNineHolonomicField
open StageNineIIPlusRestriction
open StageNineLorentzConnectionVariation
open StageNineResidualLinearPlebanskiTorsionReduction
open StageNineTopologicalLorentzThreeFormDuality
open scoped ContDiff Matrix.Norms.Elementwise

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1600000

/-- The installed first jet and retained EC connection reproduce the complete
action-generated spin response on the same synchronized actual. -/
theorem
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_typedTorsionSpin_contact
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint)
    (nondegenerate : Matrix.det (current.coframe contact) ≠ 0) :
    let final :=
      sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
        source current contact
    cartanTorsionThreeForm (final.coframe contact)
        (actualPointwiseCartanTorsionTwoForm
          (holonomicCoframeFirstJetAt final.coframe contact)
          (final.gravityConnection contact)) =
      diracDualFormNativeActionSpinResponseAt source final contact := by
  let final :=
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
      source current contact
  have finalNondegenerate : Matrix.det (final.coframe contact) ≠ 0 := by
    exact
      sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_contactNondegenerate
        source current contact nondegenerate
  dsimp only
  rw [
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_actualTorsion_selfGenerated_contact]
  exact
    diracDualFormNativeActionCartanTorsionAt_generates_spinResponse
      source final contact finalNondegenerate

/-- The live auxiliary jet of the same final actual is the genuine first jet
of `II+(e)` generated by its written smooth coframe. -/
theorem
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_auxiliaryJet_contact
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) :
    let final :=
      sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
        source current contact
    holonomicGravityAuxiliaryJet final contact =
      pointwisePhysicalIIPlusJet
        (holonomicCoframeFirstJetAt final.coframe contact) := by
  let final :=
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
      source current contact
  have finalCoframeSmooth : ContDiff ℝ ∞ final.coframe :=
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_coframe_contDiff
      source current contact
  have auxiliaryFieldEquality :
      final.gravityAuxiliary =
        (restrictHolonomicConfigurationToIIPlus final).gravityAuxiliary := by
    funext point
    exact
      sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_auxiliary
        source current contact point
  have auxiliaryJetEquality :
      holonomicGravityAuxiliaryJet final contact =
        holonomicGravityAuxiliaryJet
          (restrictHolonomicConfigurationToIIPlus final) contact := by
    unfold holonomicGravityAuxiliaryJet
      gravityAuxiliaryDirectionalDerivative
    rw [auxiliaryFieldEquality]
  dsimp only
  calc
    holonomicGravityAuxiliaryJet final contact =
        holonomicGravityAuxiliaryJet
          (restrictHolonomicConfigurationToIIPlus final) contact :=
      auxiliaryJetEquality
    _ = pointwisePhysicalIIPlusJet
          (holonomicCoframeFirstJetAt final.coframe contact) :=
      holonomicGravityAuxiliaryJet_restrictToIIPlus_of_coframeContDiff
        final finalCoframeSmooth contact

/-- A computed-`II+` auxiliary jet and the action-generated torsion--spin
identity are the complete pointwise acceptance data for the Lorentz Euler
equation.  This theorem is independent of the concrete synchronized
constructor, so the final specialization does not unfold that constructor. -/
theorem holonomicFormNativeLorentzEulerThreeForm_zero_of_auxiliaryJet_torsionSpin
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint)
    (connectionSkew : LorentzSkew (configuration.gravityConnection point))
    (auxiliaryJet :
      holonomicGravityAuxiliaryJet configuration point =
        pointwisePhysicalIIPlusJet
          (holonomicCoframeFirstJetAt configuration.coframe point))
    (torsionSpin :
      cartanTorsionThreeForm (configuration.coframe point)
          (actualPointwiseCartanTorsionTwoForm
            (holonomicCoframeFirstJetAt configuration.coframe point)
            (configuration.gravityConnection point)) =
        diracDualFormNativeActionSpinResponseAt source configuration point) :
    holonomicFormNativeLorentzEulerThreeForm source 0 configuration point =
      0 := by
  apply
    (holonomicFormNativeLorentzEulerThreeForm_eq_zero_iff_current source 0
      configuration point).2
  calc
    holonomicGravityAuxiliaryExteriorCovariantDerivative configuration point =
        pointwisePhysicalBivectorExteriorCovariantDerivative
          (configuration.gravityConnection point)
          (holonomicGravityAuxiliaryJet configuration point) := by
      rfl
    _ = pointwisePhysicalBivectorExteriorCovariantDerivative
          (configuration.gravityConnection point)
          (pointwisePhysicalIIPlusJet
            (holonomicCoframeFirstJetAt configuration.coframe point)) := by
      rw [auxiliaryJet]
    _ = internalBivectorDualThreeForm
          (torsionCoframeWedgeThreeForm (configuration.coframe point)
            (pointwiseCartanTorsion
              (holonomicCoframeFirstJetAt configuration.coframe point)
              (configuration.gravityConnection point))) :=
      pointwisePhysicalIIPlus_exteriorCovariantDerivative_eq_torsionCoframe
        (holonomicCoframeFirstJetAt configuration.coframe point)
        (configuration.gravityConnection point) connectionSkew
    _ = diracDualFormNativeActionSpinResponseAt source configuration point := by
      rw [← cartanTorsionThreeForm_actualPointwiseCartanTorsionTwoForm]
      exact torsionSpin
    _ = formNativePhysicalSpinCurrentThreeForm source 0 point
          (toContinuumPointField configuration point) := by
      unfold diracDualFormNativeActionSpinResponseAt
      rw [toContinuumPointField_restrictHolonomicConfigurationToIIPlus]
      rfl

/-- The source/current/contact-only synchronized write therefore closes the
complete Lorentz Euler three-form and the EC coframe Euler covector on one
and the same generated contact actual. -/
theorem
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_lorentzEulerThreeForm_zero_contact
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint)
    (connectionSkew : LorentzSkew (current.gravityConnection contact))
    (nondegenerate : Matrix.det (current.coframe contact) ≠ 0) :
    holonomicFormNativeLorentzEulerThreeForm source 0
        (sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
          source current contact)
        contact =
      0 := by
  let final :=
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
      source current contact
  have finalConnectionSkew :
      LorentzSkew (final.gravityConnection contact) := by
    change LorentzSkew
      ((diracDualFormNativeCartanECSynchronizedECActual
        source current contact).gravityConnection contact)
    rw [
      sourceActionGeneratedDiracDualCoframeECContactLocalActualLift_connection_contact]
    exact connectionSkew
  exact
    holonomicFormNativeLorentzEulerThreeForm_zero_of_auxiliaryJet_torsionSpin
      source final contact finalConnectionSkew
      (sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_auxiliaryJet_contact
        source current contact)
      (sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_typedTorsionSpin_contact
        source current contact nondegenerate)

/-- Same-actual Cartan--EC contact closure.  The conjunction is the positive
consumer of the synchronized write: Lorentz, coframe, and computed-`II+`
simplicity are settled without reading the Candidate obstruction. -/
theorem
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_jointCartanECClosure_contact
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint)
    (connectionSkew : LorentzSkew (current.gravityConnection contact))
    (nondegenerate : Matrix.det (current.coframe contact) ≠ 0) :
    let final :=
      sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
        source current contact
    holonomicFormNativeLorentzEulerThreeForm source 0 final contact = 0 ∧
      diracDualFormNativeCoframeEulerCovector source contact
          (toContinuumPointField final contact) = 0 ∧
        FormNativeGravitySimplicityEquation final := by
  refine ⟨
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_lorentzEulerThreeForm_zero_contact
      source current contact connectionSkew nondegenerate,
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_fullCoframeEuler_zero
      source current contact nondegenerate,
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_simplicity
      source current contact⟩

end

end
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeCartanECSynchronizedCoframeContactLorentzClosure
