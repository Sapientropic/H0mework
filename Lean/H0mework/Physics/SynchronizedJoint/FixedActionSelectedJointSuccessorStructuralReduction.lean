private abbrev Source : SmoothUnifiedSource :=
  positiveSmoothUnifiedSource

private abbrev Current : StageNineHolonomicConfiguration :=
  fixedP506L0CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathGlobalActual

private abbrev Radial : StageNineHolonomicConfiguration :=
  completeJointActionSelectedRadialConnectionActual Source Current

private abbrev Constitutive : StageNineHolonomicConfiguration :=
  completeJointActionSelectedRadialConstitutiveActual Source Current

private abbrev Carry : StageNineHolonomicConfiguration :=
  completeJointActionSelectedScalarMomentumCarryActual Source Current

private abbrev Coupled : StageNineHolonomicConfiguration :=
  completeJointActionSelectedCoupledTemporalActual Source Current

private abbrev Successor : StageNineHolonomicConfiguration :=
  fixedP506L0LorentzPathActionSelectedJointSuccessor

private abbrev Cartan : StageNineHolonomicConfiguration :=
  sourceActionGeneratedDiracDualCartanReactionCurrentRestart Source Coupled

private abbrev Contact (point : BasePoint) : StageNineHolonomicConfiguration :=
  completeJointLiveElectricECFullOccurrenceContact Source Coupled point

private theorem coupled_coframe_eq_one :
    Coupled.coframe = fun _ => (1 : LorentzianCoframe) := by
  calc
    Coupled.coframe = Carry.coframe :=
      sourceActionGeneratedDiracDualCompleteJointTemporalDevelopmentOperator_coframe
        Source Carry
    _ = Constitutive.coframe :=
      scalarActionTemporalMomentumCarryCauchyDevelopmentOperator_coframe
        Source Current Constitutive
    _ = Radial.coframe := rfl
    _ = Current.coframe := rfl
    _ = fun _ => (1 : LorentzianCoframe) :=
      fixedP506L0CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathGlobalActual_coframe_eq_one

/-- The one common successor retains the globally generated identity coframe
as a whole spacetime field. -/
theorem successor_coframe_eq_one :
    fixedP506L0LorentzPathActionSelectedJointSuccessor.coframe =
      fun _ => (1 : LorentzianCoframe) := by
  calc
    Successor.coframe = Coupled.coframe :=
      sourceActionGeneratedDiracDualCompleteJointLiveElectricECFullOccurrenceGlobalOperator_coframe
        Source Coupled
    _ = fun _ => (1 : LorentzianCoframe) := by
      apply Eq.trans
      · exact
          sourceActionGeneratedDiracDualCompleteJointTemporalDevelopmentOperator_coframe
            Source Carry
      calc
        Carry.coframe = Constitutive.coframe :=
          scalarActionTemporalMomentumCarryCauchyDevelopmentOperator_coframe
            Source Current Constitutive
        _ = Radial.coframe := rfl
        _ = Current.coframe := rfl
        _ = fun _ => (1 : LorentzianCoframe) :=
          fixedP506L0CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathGlobalActual_coframe_eq_one

private theorem coupled_coframe_contDiff : ContDiff ℝ ∞ Coupled.coframe := by
  rw [coupled_coframe_eq_one]
  exact contDiff_const

private theorem coupled_coframe_nondegenerate
    (point : BasePoint) :
    Matrix.det (Coupled.coframe point) ≠ 0 := by
  rw [coupled_coframe_eq_one]
  norm_num

private theorem successor_coframe_eq_cartan :
    Successor.coframe = Cartan.coframe := by
  calc
    Successor.coframe = Coupled.coframe :=
      sourceActionGeneratedDiracDualCompleteJointLiveElectricECFullOccurrenceGlobalOperator_coframe
        Source Coupled
    _ = Cartan.coframe :=
      (sourceActionGeneratedDiracDualCartanReactionCurrentRestart_coframe
        Source Coupled).symm

private theorem successor_connection_eq_cartan :
    Successor.gravityConnection = Cartan.gravityConnection :=
  sourceActionGeneratedDiracDualCompleteJointLiveElectricECFullOccurrenceGlobalOperator_gravityConnection_eq_cartan
    Source Coupled

private theorem successor_auxiliary_eq_cartan :
    Successor.gravityAuxiliary = Cartan.gravityAuxiliary := by
  funext point
  calc
    Successor.gravityAuxiliary point =
        physicalIIPlusBivector (Coupled.coframe point) :=
      congrFun
        (sourceActionGeneratedDiracDualCompleteJointLiveElectricECFullOccurrenceGlobalOperator_gravityAuxiliary
          Source Coupled) point
    _ = Cartan.gravityAuxiliary point :=
      (sourceActionGeneratedDiracDualCartanReactionCurrentRestart_auxiliary
        Source Coupled point).symm

private theorem successor_matter_eq_cartan :
    Successor.matter = Cartan.matter := by
  calc
    Successor.matter = Coupled.matter :=
      sourceActionGeneratedDiracDualCompleteJointLiveElectricECFullOccurrenceGlobalOperator_matter_eq_current
        Source Coupled
    _ = Cartan.matter :=
      (sourceActionGeneratedDiracDualCartanReactionCurrentRestart_matter
        Source Coupled).symm

private theorem successor_conjugateMatter_eq_cartan :
    Successor.conjugateMatter = Cartan.conjugateMatter := by
  calc
    Successor.conjugateMatter = Coupled.conjugateMatter :=
      sourceActionGeneratedDiracDualCompleteJointLiveElectricECFullOccurrenceGlobalOperator_conjugateMatter_eq_current
        Source Coupled
    _ = Cartan.conjugateMatter :=
      (sourceActionGeneratedDiracDualCartanReactionCurrentRestart_conjugateMatter
        Source Coupled).symm

private theorem successor_matterSpin_eq_cartan
    (point : BasePoint) :
    formNativeMatterSpinThreeForm Source 0 point
        (toContinuumPointField Successor point) =
      formNativeMatterSpinThreeForm Source 0 point
        (toContinuumPointField Cartan point) := by
  have physicalSpinEquality :=
    diracDualFormNativeActionSpinResponseAt_eq_of_fields_at
      Source Successor Cartan point
      (congrFun successor_coframe_eq_cartan point)
      (congrFun successor_matter_eq_cartan point)
      (congrFun successor_conjugateMatter_eq_cartan point)
  unfold diracDualFormNativeActionSpinResponseAt
    formNativePhysicalSpinCurrentThreeForm at physicalSpinEquality
  exact neg_injective physicalSpinEquality

private theorem successor_auxiliaryExteriorCovariantDerivative_eq_cartan
    (point : BasePoint) :
    holonomicGravityAuxiliaryExteriorCovariantDerivative Successor point =
      holonomicGravityAuxiliaryExteriorCovariantDerivative Cartan point := by
  unfold holonomicGravityAuxiliaryExteriorCovariantDerivative
    holonomicGravityAuxiliaryJet gravityAuxiliaryDirectionalDerivative
  rw [successor_connection_eq_cartan, successor_auxiliary_eq_cartan]

private theorem successor_lorentzRead_eq_cartan
    (point : BasePoint) :
    holonomicFormNativeLorentzEulerThreeForm Source 0 Successor point =
      holonomicFormNativeLorentzEulerThreeForm Source 0 Cartan point := by
  unfold holonomicFormNativeLorentzEulerThreeForm
  rw [successor_auxiliaryExteriorCovariantDerivative_eq_cartan,
    successor_matterSpin_eq_cartan]

/-- Simplicity closes the gravity-multiplier channel at every point of the
same successor. -/
theorem successor_gravityMultiplier_zero (point : BasePoint) :
    (diracDualFormNativePointwiseJointResidual positiveSmoothUnifiedSource
        fixedP506L0LorentzPathActionSelectedJointSuccessor point
      ).gravityMultiplier = 0 := by
  change
    formNativeGravityMultiplierEulerResidual
        (toContinuumPointField Successor point) = 0
  apply
    (formNativeGravityMultiplierEulerResidual_eq_zero_iff_simplicity
      (toContinuumPointField Successor point)).2
  exact
    sourceActionGeneratedDiracDualCompleteJointLiveElectricECFullOccurrenceGlobalOperator_simplicity
      Source Coupled point

/-- The constitutive auxiliary produced before the final compiler closes the
P286 auxiliary equation everywhere on the common successor. -/
theorem successor_p286GaugeAuxiliary_zero (point : BasePoint) :
    (diracDualFormNativePointwiseJointResidual positiveSmoothUnifiedSource
        fixedP506L0LorentzPathActionSelectedJointSuccessor point
      ).p286GaugeAuxiliary = 0 := by
  change
    formNativeP286GaugeAuxiliaryEulerResidualAtBoundary
        (sourceGeneratedUnifiedCouplings Source)
        (toContinuumPointField Successor point) = 0
  apply
    (formNativeP286GaugeAuxiliaryEulerResidual_eq_zero_iff
      (sourceGeneratedUnifiedCouplings Source)
      (toContinuumPointField Successor point)).2
  apply
    (formNativeP286GaugeAuxiliaryEquationAtBoundary_iff_eliminated
      (sourceGeneratedUnifiedCouplings Source)
      (toContinuumPointField Successor point)
      (by
        change Matrix.det (Successor.coframe point) ≠ 0
        rw [successor_coframe_eq_one]
        norm_num)).2
  change
    Successor.gaugeAuxiliary point =
      formNativeP286GaugeEliminatedAuxiliaryAtBoundary
        (sourceGeneratedUnifiedCouplings Source)
        (Successor.coframe point) (holonomicGaugeCurvature Successor point)
  rw [congrFun
    SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeFixedP506CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathActionSelectedJointSuccessorP286Readback.successor_gaugeAuxiliary_eq_actionSelectedCoupledConstitutive
      point]
  unfold diracDualFormNativeConstitutiveAuxiliaryField
  change
    formNativeP286GaugeEliminatedAuxiliaryAtBoundary
        (sourceGeneratedUnifiedCouplings Source)
        (Coupled.coframe point) (holonomicGaugeCurvature Coupled point) =
      formNativeP286GaugeEliminatedAuxiliaryAtBoundary
        (sourceGeneratedUnifiedCouplings Source)
        (Successor.coframe point) (holonomicGaugeCurvature Successor point)
  have coframeEq : Successor.coframe = Coupled.coframe :=
    sourceActionGeneratedDiracDualCompleteJointLiveElectricECFullOccurrenceGlobalOperator_coframe
      Source Coupled
  have connectionEq : Successor.gaugeConnection = Coupled.gaugeConnection :=
    sourceActionGeneratedDiracDualCompleteJointLiveElectricECFullOccurrenceGlobalOperator_gaugeConnection
      Source Coupled
  have curvatureEq :
      holonomicGaugeCurvature Successor point =
        holonomicGaugeCurvature Coupled point :=
    holonomicGaugeCurvature_eq_of_connection_eq Successor Coupled
      connectionEq point
  rw [congrFun coframeEq point, curvatureEq]

/-- The final connection is the Cartan restart of the same coupled input, so
the Lorentz equation closes at every point. -/
theorem successor_lorentzConnection_zero (point : BasePoint) :
    (diracDualFormNativePointwiseJointResidual positiveSmoothUnifiedSource
        fixedP506L0LorentzPathActionSelectedJointSuccessor point
      ).lorentzConnection = 0 := by
  change
    holonomicFormNativeLorentzEulerThreeForm Source 0 Successor point = 0
  rw [successor_lorentzRead_eq_cartan]
  exact
    sourceActionGeneratedDiracDualCartanReactionCurrentRestart_lorentzEulerThreeForm_zero_at_of_coframeContDiff
      Source Coupled coupled_coframe_contDiff point
      (coupled_coframe_nondegenerate point)

private theorem contact_gravityAuxiliary_zero
    (point : BasePoint) :
    formNativeGravityAuxiliaryEulerResidual
        (toContinuumPointField (Contact point) 0) = 0 := by
  change
    holonomicFormNativeGravityAuxiliaryEulerResidual (Contact point) 0 = 0
  unfold Contact completeJointLiveElectricECFullOccurrenceContact
    sourceActionGeneratedDiracDualCompleteJointLiveElectricECGlobalDevelopmentOperator
  exact congrFun
    (sourceActionGeneratedDiracDualECFullCauchyLocalActualLift_auxiliaryEquation
      Source
      (sourceActionGeneratedDiracDualCompleteJointLiveElectricGlobalDevelopmentOperator
        Source (fullyRecenterHolonomicConfiguration Coupled point))) 0

private theorem successorField_auxiliary_eq_contactField
    (point : BasePoint) :
    (toContinuumPointField Successor point).gravityAuxiliary =
      (toContinuumPointField (Contact point) 0).gravityAuxiliary := by
  change Successor.gravityAuxiliary point =
    (Contact point).gravityAuxiliary 0
  exact
    sourceActionGeneratedDiracDualCompleteJointLiveElectricECFullOccurrenceGlobalOperator_gravityAuxiliary_at
      Source Coupled point

private theorem successorField_multiplier_eq_contactField
    (point : BasePoint) :
    (toContinuumPointField Successor point).gravitySimplicityMultiplier =
      (toContinuumPointField (Contact point) 0).gravitySimplicityMultiplier := by
  change Successor.gravitySimplicityMultiplier point =
    (Contact point).gravitySimplicityMultiplier 0
  exact
    sourceActionGeneratedDiracDualCompleteJointLiveElectricECFullOccurrenceGlobalOperator_multiplier_at
      Source Coupled point

/-- The only gravity-auxiliary changed read is exactly the faithful image of
the exhaustive gravity-curvature assembly seam. -/
theorem successor_gravityAuxiliary_normalForm (point : BasePoint) :
    (diracDualFormNativePointwiseJointResidual positiveSmoothUnifiedSource
        fixedP506L0LorentzPathActionSelectedJointSuccessor point
      ).gravityAuxiliary =
      gravityInternalPairVarianceNormalization
        ((completeJointLiveElectricECFullOccurrenceAssemblySeam
          positiveSmoothUnifiedSource
          (completeJointActionSelectedCoupledTemporalActual
            positiveSmoothUnifiedSource
            fixedP506L0CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathGlobalActual)
          point).gravityCurvature) := by
  have contactZero := contact_gravityAuxiliary_zero point
  change
    formNativeGravityAuxiliaryEulerResidual
        (toContinuumPointField Successor point) =
      gravityInternalPairVarianceNormalization
        (holonomicGravityCurvature Successor point -
          holonomicGravityCurvature (Contact point) 0)
  have auxiliaryEq := successorField_auxiliary_eq_contactField point
  have multiplierEq := successorField_multiplier_eq_contactField point
  unfold formNativeGravityAuxiliaryEulerResidual at contactZero ⊢
  change
    gravityInternalPairVarianceNormalization
          (holonomicGravityCurvature (Contact point) 0) -
        gravityInternalDualEquiv
          (toContinuumPointField (Contact point) 0).gravityAuxiliary +
        (toContinuumPointField (Contact point) 0).gravitySimplicityMultiplier =
      0 at contactZero
  rw [auxiliaryEq, multiplierEq, map_sub]
  calc
    gravityInternalPairVarianceNormalization
          (holonomicGravityCurvature Successor point) -
        gravityInternalDualEquiv
          (toContinuumPointField (Contact point) 0).gravityAuxiliary +
        (toContinuumPointField (Contact point) 0).gravitySimplicityMultiplier =
      (gravityInternalPairVarianceNormalization
          (holonomicGravityCurvature Successor point) -
        gravityInternalPairVarianceNormalization
          (holonomicGravityCurvature (Contact point) 0)) +
        (gravityInternalPairVarianceNormalization
            (holonomicGravityCurvature (Contact point) 0) -
          gravityInternalDualEquiv
            (toContinuumPointField (Contact point) 0).gravityAuxiliary +
          (toContinuumPointField (Contact point) 0).gravitySimplicityMultiplier) := by
        abel
    _ = gravityInternalPairVarianceNormalization
          (holonomicGravityCurvature Successor point) -
        gravityInternalPairVarianceNormalization
          (holonomicGravityCurvature (Contact point) 0) := by
      rw [contactZero, add_zero]

/-- Faithfulness of the variance normalization turns the gravity normal form
into an exact assembly-seam zero criterion. -/
theorem successor_gravityAuxiliary_eq_zero_iff_gravityCurvatureSeam_zero
    (point : BasePoint) :
    (diracDualFormNativePointwiseJointResidual positiveSmoothUnifiedSource
        fixedP506L0LorentzPathActionSelectedJointSuccessor point
      ).gravityAuxiliary = 0 ↔
      (completeJointLiveElectricECFullOccurrenceAssemblySeam
        positiveSmoothUnifiedSource
        (completeJointActionSelectedCoupledTemporalActual
          positiveSmoothUnifiedSource
          fixedP506L0CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathGlobalActual)
        point).gravityCurvature = 0 := by
  rw [successor_gravityAuxiliary_normalForm]
  exact LinearEquiv.map_eq_zero_iff _

/-- The fixed successor's raw gravity assembly seam is the exact mismatch
between the source/current-generated Cartan whole-field curvature and the
matching occurrence's EC Full-Cauchy curvature target. -/
theorem successor_gravityCurvatureSeam_eq_cartan_sub_target
    (point : BasePoint) :
    (completeJointLiveElectricECFullOccurrenceAssemblySeam
      positiveSmoothUnifiedSource
      (completeJointActionSelectedCoupledTemporalActual
        positiveSmoothUnifiedSource
        fixedP506L0CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathGlobalActual)
      point).gravityCurvature =
      holonomicGravityCurvature
          (sourceActionGeneratedDiracDualCartanReactionCurrentRestart
            positiveSmoothUnifiedSource
            (completeJointActionSelectedCoupledTemporalActual
              positiveSmoothUnifiedSource
              fixedP506L0CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathGlobalActual))
          point -
        sourceActionGeneratedDiracDualECFullCauchyCurvatureTarget
          positiveSmoothUnifiedSource
          (sourceActionGeneratedDiracDualCompleteJointLiveElectricGlobalDevelopmentOperator
            positiveSmoothUnifiedSource
            (fullyRecenterHolonomicConfiguration
              (completeJointActionSelectedCoupledTemporalActual
                positiveSmoothUnifiedSource
                fixedP506L0CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathGlobalActual)
              point)) := by
  exact
    completeJointLiveElectricECFullOccurrenceAssemblySeam_gravityCurvature_eq_cartan_sub_target
      Source Coupled point

/-- Hence gravity closure is exactly a same-occurrence equality between two
positive action outputs.  This criterion identifies the unassembled native
jet edge without using the mismatch to define a correction. -/
theorem successor_gravityAuxiliary_eq_zero_iff_cartanCurvature_eq_ecTarget
    (point : BasePoint) :
    (diracDualFormNativePointwiseJointResidual positiveSmoothUnifiedSource
        fixedP506L0LorentzPathActionSelectedJointSuccessor point
      ).gravityAuxiliary = 0 ↔
      holonomicGravityCurvature
          (sourceActionGeneratedDiracDualCartanReactionCurrentRestart
            positiveSmoothUnifiedSource
            (completeJointActionSelectedCoupledTemporalActual
              positiveSmoothUnifiedSource
              fixedP506L0CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathGlobalActual))
          point =
        sourceActionGeneratedDiracDualECFullCauchyCurvatureTarget
          positiveSmoothUnifiedSource
          (sourceActionGeneratedDiracDualCompleteJointLiveElectricGlobalDevelopmentOperator
            positiveSmoothUnifiedSource
            (fullyRecenterHolonomicConfiguration
              (completeJointActionSelectedCoupledTemporalActual
                positiveSmoothUnifiedSource
                fixedP506L0CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathGlobalActual)
              point)) := by
  rw [successor_gravityAuxiliary_eq_zero_iff_gravityCurvatureSeam_zero,
    successor_gravityCurvatureSeam_eq_cartan_sub_target, sub_eq_zero]

/-- Whole-carrier structural normal form of the one action-selected
successor.  The four settled structural channels are zero, the gravity
auxiliary is the exhaustive curvature seam, and every remaining coordinate
is retained as the exact read of this same actual. -/
def successorStructuralResidualNormalForm
    (point : BasePoint) :
    DiracDualFormNativePointwiseJointResidualCarrier :=
  let residual :=
    diracDualFormNativePointwiseJointResidual positiveSmoothUnifiedSource
      fixedP506L0LorentzPathActionSelectedJointSuccessor point
  { gravityMultiplier := 0
    gravityAuxiliary :=
      gravityInternalPairVarianceNormalization
        ((completeJointLiveElectricECFullOccurrenceAssemblySeam
          positiveSmoothUnifiedSource
          (completeJointActionSelectedCoupledTemporalActual
            positiveSmoothUnifiedSource
            fixedP506L0CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathGlobalActual)
          point).gravityCurvature)
    p286GaugeAuxiliary := 0
    lorentzConnection := 0
    p286GaugeConnection := residual.p286GaugeConnection
    scalar := residual.scalar
    matter := residual.matter
    conjugateMatter := residual.conjugateMatter
    coframe := residual.coframe }

/-- One equality classifies all nine residual channels of the same global
successor.  This is a diagnostic readback and is never fed into a writer. -/
theorem successor_residual_eq_structuralNormalForm
    (point : BasePoint) :
    diracDualFormNativePointwiseJointResidual positiveSmoothUnifiedSource
        fixedP506L0LorentzPathActionSelectedJointSuccessor point =
      successorStructuralResidualNormalForm point := by
  unfold successorStructuralResidualNormalForm
  apply DiracDualFormNativePointwiseJointResidualCarrier.ext
  · exact successor_gravityMultiplier_zero point
  · exact successor_gravityAuxiliary_normalForm point
  · exact successor_p286GaugeAuxiliary_zero point
  · exact successor_lorentzConnection_zero point
  · rfl
  · rfl
  · rfl
  · rfl
  · rfl

end

end
