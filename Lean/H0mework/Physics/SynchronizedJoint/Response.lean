/-! ## Corrected coframe action channel -/

/-- The exact resynchronized origin field from which the coframe producer
reads its non-gravity action density.  This is the forward producer state,
not a claim that a later complete actual is already a fixed point. -/
def currentFullSynchronizedProducerOriginField
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint) : StageNineContinuumPointField :=
  fullSynchronizedActionMatterOriginField source
    (currentCanonicalFullActionBaseActual source current space)

/-- The coframe response generated by the full synchronized action graph at
one current contact. -/
def currentFullSynchronizedCoframeResponse
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint) : LorentzianCoframe :=
  fullSynchronizedActionCoframeResponse source
    (currentCanonicalFullActionBaseActual source current space)

/-- The corrected linear-Plebanski plus gravity-BF plus non-gravity coframe
Euler covector on the producer graph state. -/
def currentFullSynchronizedProducerCoframeActionCovector
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    LorentzianCoframe →L[Real] Real :=
  linearPlebanskiCoframePrincipal
      (currentFullSynchronizedCoframeResponse source current space) +
    gravityBFCoframeFeedback
      (currentFullSynchronizedCoframeResponse source current space) +
    fullSynchronizedActionNonGravityCoframeStress source
      (currentCanonicalFullActionBaseActual source current space)

/-- The response is generated before this acceptance readout.  Re-substitution
is coframe producer soundness, not an independent field equation. -/
theorem currentFullSynchronizedProducerCoframeActionCovector_eq_zero
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    currentFullSynchronizedProducerCoframeActionCovector source current
        space =
      0 := by
  apply ContinuousLinearMap.ext
  intro variation
  exact fullSynchronizedActionCoframeResponse_actionBalance source
    (currentCanonicalFullActionBaseActual source current space) variation

/-- Mixed-index infinitesimal generator of the established left Spin action
on the internal coframe row.  The sign is the positive derivative convention
of `Λ · e`; it is not selected from a downstream cancellation. -/
def lorentzLeftCoframeTangent
    (component : LorentzTemporalBivectorDirection)
    (coframe : LorentzianCoframe) : LorentzianCoframe :=
  spinConnectionMatrix
      (lorentzSkewConnectionOfBivectorOneForm
        (canonicalLorentzTemporalBivectorOneForm component))
      canonicalLorentzianTimeDirection *
    coframe

/-- Producer-graph coframe/stress torque channel.  It is an evaluation of an
action covector, not a remainder defined from the Lorentz obstruction. -/
def currentFullSynchronizedProducerLorentzCoframeTorque
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (component : LorentzTemporalBivectorDirection) : Real :=
  currentFullSynchronizedProducerCoframeActionCovector source current space
    (lorentzLeftCoframeTangent component
      ((currentCanonicalFullActionActual source current space).coframe 0))

theorem currentFullSynchronizedProducerLorentzCoframeTorque_eq_zero
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (component : LorentzTemporalBivectorDirection) :
    currentFullSynchronizedProducerLorentzCoframeTorque source current space
        component =
      0 := by
  rw [currentFullSynchronizedProducerLorentzCoframeTorque,
    currentFullSynchronizedProducerCoframeActionCovector_eq_zero]
  rfl

/-- Corrected coframe density whose three summands are owned respectively by
the linear Plebanski constraint, gravity BF action, and the full non-gravity
action evaluated on the producer graph state. -/
def currentFullSynchronizedProducerCoframeDensity
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (candidate : LorentzianCoframe) : ℝ :=
  let response :=
    currentFullSynchronizedCoframeResponse source current space
  let field :=
    currentFullSynchronizedProducerOriginField source current space
  linearPlebanskiSimplicityDensity
        (physicalIIPlusBivector (1 : LorentzianCoframe))
        (linearPlebanskiMultiplierOfCoframeResponse response)
        candidate +
      gravityCoupledLinearPlebanskiBFCoframeDensity response candidate +
    coframeGaugeSectorLocalDensity source field candidate +
    coframeScalarSectorLocalDensity source 0 field candidate +
    coframeMatterSectorLocalDensity source 0 field candidate

/-- One actual coframe path through the identity contact. -/
def currentFullSynchronizedProducerCoframeDensityPath
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (variation : LorentzianCoframe)
    (parameter : ℝ) : ℝ :=
  currentFullSynchronizedProducerCoframeDensity source current space
    ((1 : LorentzianCoframe) + parameter • variation)

@[simp] theorem currentFullSynchronizedProducerOriginField_coframe
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    (currentFullSynchronizedProducerOriginField source current
      space).coframe =
      current.coframe space := by
  rfl

/-- The producer covector is the genuine derivative of the corrected action
density at an identity-coframe contact.  This theorem establishes action
provenance only; the following zero is still producer soundness. -/
theorem currentFullSynchronizedProducerCoframeDensityPath_hasDerivAt
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (identityCoframe : current.coframe space = 1)
    (variation : LorentzianCoframe) :
    HasDerivAt
      (currentFullSynchronizedProducerCoframeDensityPath source current
        space variation)
      (currentFullSynchronizedProducerCoframeActionCovector source current
        space variation)
      0 := by
  let response :=
    currentFullSynchronizedCoframeResponse source current space
  let field :=
    currentFullSynchronizedProducerOriginField source current space
  have fieldCoframe : field.coframe = (1 : LorentzianCoframe) := by
    simpa [field] using identityCoframe
  have fieldNondegenerate : Matrix.det field.coframe ≠ 0 := by
    rw [fieldCoframe]
    simp
  have identityDerivative := hasDerivAt_id (x := (0 : ℝ))
  have variationDerivative := identityDerivative.smul_const variation
  have variationDerivativeValue :
      (1 : ℝ) • variation = variation := by
    simp
  have variationDerivativeAtZero :=
    variationDerivative.congr_deriv variationDerivativeValue
  have pathDerivative :=
    variationDerivativeAtZero.const_add (1 : LorentzianCoframe)
  have pointEquality :
      field.coframe =
        (1 : LorentzianCoframe) + (0 : ℝ) • variation := by
    rw [fieldCoframe]
    simp
  have gaugeDerivative :=
    (coframeGaugeSectorLocalDensity_hasFDerivAt source field
      fieldNondegenerate).comp_hasDerivAt_of_eq
        (0 : ℝ) pathDerivative pointEquality
  have scalarDerivative :=
    (coframeScalarSectorLocalDensity_hasFDerivAt source 0 field
      fieldNondegenerate).comp_hasDerivAt_of_eq
        (0 : ℝ) pathDerivative pointEquality
  have matterDerivative :=
    (coframeMatterSectorLocalDensity_hasFDerivAt source 0 field
      fieldNondegenerate).comp_hasDerivAt_of_eq
        (0 : ℝ) pathDerivative pointEquality
  have simplicityDerivative :=
    linearPlebanskiSimplicityDensity_path_hasDerivAt response variation
  have gravityBFDerivative :=
    gravityCoupledLinearPlebanskiBFCoframeDensity_path_hasDerivAt
      response variation
  have totalDerivative :=
    (((simplicityDerivative.add gravityBFDerivative).add gaugeDerivative).add
      scalarDerivative).add matterDerivative
  rw [linearPlebanskiCoframePrincipalValue_eq_principal] at totalDerivative
  have coefficientEquality :
      linearPlebanskiCoframePrincipal response variation +
              gravityBFCoframeFeedback response variation +
            coframeGaugeSectorStressCovector source field variation +
          coframeScalarSectorStressCovector source 0 field variation +
        coframeMatterSectorStressCovector source 0 field variation =
      currentFullSynchronizedProducerCoframeActionCovector source current
        space variation := by
    simp only [currentFullSynchronizedProducerCoframeActionCovector,
      currentFullSynchronizedProducerOriginField,
      currentFullSynchronizedCoframeResponse,
      fullSynchronizedActionNonGravityCoframeStress, response, field,
      add_apply]
    ring
  have adjustedDerivative :=
    totalDerivative.congr_deriv coefficientEquality
  convert adjustedDerivative using 1 <;> rfl

/-- The action-generated response makes the corrected density derivative
zero along every coframe direction on its producer graph state. -/
theorem currentFullSynchronizedProducerCoframeDensityPath_hasDerivAt_zero
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (identityCoframe : current.coframe space = 1)
    (variation : LorentzianCoframe) :
    HasDerivAt
      (currentFullSynchronizedProducerCoframeDensityPath source current
        space variation)
      0
      0 := by
  have actual :=
    currentFullSynchronizedProducerCoframeDensityPath_hasDerivAt source
      current space identityCoframe variation
  rw [currentFullSynchronizedProducerCoframeActionCovector_eq_zero] at actual
  simpa using actual

/-- The multiplier in the final local actual is the one generated from the
same synchronized coframe response; later P286 and matter legs do not replace
it. -/
theorem currentFullSynchronizedActual_multiplier_eq_response
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    (currentCanonicalFullActionActual source current
        space).gravitySimplicityMultiplier =
      fun _ =>
        gravityCoupledLinearPlebanskiMultiplier
          (currentFullSynchronizedCoframeResponse source current space) := by
  change
    (canonicalLocalFullActionResponseOperator source
        (currentCanonicalFullActionBaseActual source current space)
      |>.gravitySimplicityMultiplier) =
      _
  rw [canonicalLocalFullActionResponseOperator_gravitySimplicityMultiplier]
  rfl

/-- The final local actual retains the curvature generated from the same
full-synchronized coframe response.  This is a projection of the forward
producer graph, not a fixed-point premise. -/
theorem currentFullSynchronizedActual_curvature_eq_response
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    holonomicGravityCurvature
        (currentCanonicalFullActionActual source current space) 0 =
      gravityCoupledLinearPlebanskiCurvature
        (currentFullSynchronizedCoframeResponse source current space) := by
  change
    holonomicGravityCurvature
        (fullSynchronizedActionResponseOperator source
          (currentCanonicalFullActionBaseActual source current space)) 0 =
      fullSynchronizedActionGravityCurvature source
        (currentCanonicalFullActionBaseActual source current space)
  exact fullSynchronizedActionResponseOperator_curvature_origin source
    (currentCanonicalFullActionBaseActual source current space)

/-! ## Lorentz finite dual of the complete synchronized actual family -/

/-- Lorentz BF momentum evaluated on the complete synchronized actual at
every current contact. -/
def currentFullSynchronizedLorentzBFMomentumEvaluation
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (derivativeDirection : LorentzianIndex) :
    StageNineSpatialPoint → LorentzSpatialBivectorDirection → Real :=
  fun space direction =>
    lorentzConnectionBFDifferentialMomentum
      (currentCanonicalFullActionActual source current space)
      (lorentzConnectionExteriorDerivativeDirection derivativeDirection
        (canonicalLorentzSpatialBivectorOneForm direction))
      0

/-- Initial temporal BF momentum of the complete synchronized actual. -/
def currentFullSynchronizedLorentzSpatialBFMomentumEvaluation
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (direction : LorentzSpatialBivectorDirection) : Real :=
  currentFullSynchronizedLorentzBFMomentumEvaluation source current
    canonicalLorentzianTimeDirection space direction

def currentFullSynchronizedLorentzSpatialBFMomentumDerivative
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (derivativeDirection : Fin 3)
    (direction : LorentzSpatialBivectorDirection) : Real :=
  fderiv Real
    (currentFullSynchronizedLorentzBFMomentumEvaluation source current
      derivativeDirection.succ · direction)
    space (canonicalSpatialCoordinateDirection derivativeDirection)

def currentFullSynchronizedLorentzSpatialBFMomentumDivergence
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (direction : LorentzSpatialBivectorDirection) : Real :=
  ∑ derivativeDirection : Fin 3,
    currentFullSynchronizedLorentzSpatialBFMomentumDerivative source current
      space derivativeDirection direction

/-- The complete synchronized algebraic current and BF divergence are read
from the same generated family before taking finite coordinates. -/
def currentFullSynchronizedLorentzRawActionReadout
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (direction : LorentzSpatialBivectorDirection) : Real :=
  let actual := currentCanonicalFullActionActual source current space
  let fullDirection := canonicalLorentzSpatialBivectorOneForm direction
  lorentzConnectionAlgebraicSpinCurrentCoefficient source actual
      fullDirection 0 -
    currentFullSynchronizedLorentzSpatialBFMomentumDivergence source current
      space direction

def currentFullSynchronizedLorentzActionCoordinates
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint) : Fin 3 → Fin 6 → Real :=
  fun spatialDirection internalPair =>
    currentFullSynchronizedLorentzRawActionReadout source current space
      (canonicalLorentzSpatialBivectorCoordinateDirection spatialDirection
        internalPair)

def currentFullSynchronizedLorentzVelocityDual
