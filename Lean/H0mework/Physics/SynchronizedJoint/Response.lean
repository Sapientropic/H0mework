theorem currentFullSynchronizedLorentzActualFirstJetLift_timeAxis
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (time : Real) :
    (currentFullSynchronizedLorentzActualFirstJetLift source current
        space).gravityAuxiliary (canonicalCauchySlicePoint time 0) =
      actionGeneratedGravityAuxiliary current space +
        time • currentFullSynchronizedLorentzAuxiliaryVelocity source current
          space := by
  change
    (currentCanonicalFullActionActual source current
        space).gravityAuxiliary (canonicalCauchySlicePoint time 0) +
      localBaseCoordinate canonicalLorentzianTimeDirection
          (canonicalCauchySlicePoint time 0) •
        currentFullSynchronizedLorentzAuxiliaryVelocity source current
          space =
      _
  rw [show
    (currentCanonicalFullActionActual source current space).gravityAuxiliary
        (canonicalCauchySlicePoint time 0) =
      actionGeneratedGravityAuxiliary current space by
    change
      (currentFullSynchronizedCompleteP286BaseActual source current
        space).gravityAuxiliary (canonicalCauchySlicePoint time 0) =
        actionGeneratedGravityAuxiliary current space
    exact sourceActionGeneratedLinearPlebanskiJointLocalActualLift_auxiliary
      source current space _]
  simp [localBaseCoordinate_apply]

/-- At identity coframe, the initial readout is exactly the BF pairing of the
action-generated base auxiliary field. -/
theorem
    currentFullSynchronizedLorentzSpatialBFMomentumEvaluation_identity
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (identityCoframe : current.coframe space = 1)
    (direction : LorentzSpatialBivectorDirection) :
    currentFullSynchronizedLorentzSpatialBFMomentumEvaluation source current
        space direction =
      gravityAuxiliaryHodgePairingPolynomial 1
        (actionGeneratedGravityAuxiliary current space)
        (lorentzConnectionExteriorDerivativeDirection
          canonicalLorentzianTimeDirection
          (canonicalLorentzSpatialBivectorOneForm direction)) := by
  unfold currentFullSynchronizedLorentzSpatialBFMomentumEvaluation
    currentFullSynchronizedLorentzBFMomentumEvaluation
    lorentzConnectionBFDifferentialMomentum
  have baseCoframe :
      (currentCanonicalFullActionActual source current space).coframe 0 =
        1 := by
    change current.coframe space = 1
    exact identityCoframe
  change
    |Matrix.det
        ((currentCanonicalFullActionActual source current space).coframe 0)| *
        gravityAuxiliaryHodgePairingPolynomial
          ((currentCanonicalFullActionActual source current space).coframe 0)
          ((currentCanonicalFullActionActual source current
            space).gravityAuxiliary 0)
          (lorentzConnectionExteriorDerivativeDirection
            canonicalLorentzianTimeDirection
            (canonicalLorentzSpatialBivectorOneForm direction)) =
      _
  rw [baseCoframe]
  change
    |Matrix.det (1 : LorentzianCoframe)| *
        gravityAuxiliaryHodgePairingPolynomial 1
          (actionGeneratedGravityAuxiliary current space)
          (lorentzConnectionExteriorDerivativeDirection
            canonicalLorentzianTimeDirection
            (canonicalLorentzSpatialBivectorOneForm direction)) =
      _
  simp

/-- The installed auxiliary first jet realizes the complete synchronized
Lorentz action velocity on every spatial test direction. -/
theorem currentFullSynchronizedLorentzActualFirstJetLift_BFMomentum_timeAxis
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (identityCoframe : current.coframe space = 1)
    (time : Real)
    (direction : LorentzSpatialBivectorDirection) :
    lorentzConnectionBFDifferentialMomentum
        (currentFullSynchronizedLorentzActualFirstJetLift source current
          space)
        (lorentzConnectionExteriorDerivativeDirection
          canonicalLorentzianTimeDirection
          (canonicalLorentzSpatialBivectorOneForm direction))
        (canonicalCauchySlicePoint time 0) =
      currentFullSynchronizedLorentzSpatialBFMomentumEvaluation source current
          space direction +
        time *
          currentFullSynchronizedLorentzVelocity source current space
            direction := by
  have liftCoframe :
      (currentFullSynchronizedLorentzActualFirstJetLift source current
          space).coframe (canonicalCauchySlicePoint time 0) =
        1 := by
    change current.coframe space = 1
    exact identityCoframe
  unfold lorentzConnectionBFDifferentialMomentum
  change
    |Matrix.det
        ((currentFullSynchronizedLorentzActualFirstJetLift source current
          space).coframe (canonicalCauchySlicePoint time 0))| *
        gravityAuxiliaryHodgePairingPolynomial
          ((currentFullSynchronizedLorentzActualFirstJetLift source current
            space).coframe (canonicalCauchySlicePoint time 0))
          ((currentFullSynchronizedLorentzActualFirstJetLift source current
            space).gravityAuxiliary (canonicalCauchySlicePoint time 0))
          (lorentzConnectionExteriorDerivativeDirection
            canonicalLorentzianTimeDirection
            (canonicalLorentzSpatialBivectorOneForm direction)) =
      _
  rw [liftCoframe,
    currentFullSynchronizedLorentzActualFirstJetLift_timeAxis]
  simp only [Matrix.det_one, abs_one, one_mul]
  rw [gravityAuxiliaryHodgePairingPolynomial_add_smul_left
      (1 : LorentzianCoframe) (by simp),
    currentFullSynchronizedLorentzAuxiliaryVelocity_pairing,
    ← currentFullSynchronizedLorentzSpatialBFMomentumEvaluation_identity
      source current space identityCoframe direction]

/-- Differential form of the same actual first-jet law. -/
theorem currentFullSynchronizedLorentzActualFirstJetLift_BFMomentum_hasDerivAt
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (identityCoframe : current.coframe space = 1)
    (time : Real)
    (direction : LorentzSpatialBivectorDirection) :
    HasDerivAt
      (fun candidate : Real =>
        lorentzConnectionBFDifferentialMomentum
          (currentFullSynchronizedLorentzActualFirstJetLift source current
            space)
          (lorentzConnectionExteriorDerivativeDirection
            canonicalLorentzianTimeDirection
            (canonicalLorentzSpatialBivectorOneForm direction))
          (canonicalCauchySlicePoint candidate 0))
      (currentFullSynchronizedLorentzVelocity source current space direction)
      time := by
  have rawAffineDerivative :=
    (hasDerivAt_const time
      (currentFullSynchronizedLorentzSpatialBFMomentumEvaluation source
        current space direction)).add
      ((hasDerivAt_id time).smul_const
        (currentFullSynchronizedLorentzVelocity source current space
          direction))
  have derivativeValue :
      (0 : Real) +
          (1 : Real) •
            currentFullSynchronizedLorentzVelocity source current space
              direction =
        currentFullSynchronizedLorentzVelocity source current space
          direction := by
    rw [one_smul, zero_add]
  have affineDerivative :=
    rawAffineDerivative.congr_deriv derivativeValue
  apply affineDerivative.congr_of_eventuallyEq
  filter_upwards [] with candidate
  simpa only [Pi.add_apply, id_eq, smul_eq_mul] using
    (currentFullSynchronizedLorentzActualFirstJetLift_BFMomentum_timeAxis
      source current space identityCoframe candidate direction)

/-- Contact-local faithful zero fiber of the actual installer.  The lift is
the identity exactly when the action-generated Lorentz velocity at that same
contact vanishes. -/
theorem currentFullSynchronizedLorentzActualFirstJetLift_eq_base_iff
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    currentFullSynchronizedLorentzActualFirstJetLift source current space =
          currentCanonicalFullActionActual source current space ↔
      currentFullSynchronizedLorentzVelocity source current space = 0 := by
  constructor
  · intro actualEquality
    have auxiliaryEquality := congrArg
      (fun actual : StageNineHolonomicConfiguration =>
        actual.gravityAuxiliary (canonicalCauchySlicePoint 1 0))
      actualEquality
    rw [currentFullSynchronizedLorentzActualFirstJetLift_timeAxis] at auxiliaryEquality
    have auxiliaryZero :
        currentFullSynchronizedLorentzAuxiliaryVelocity source current space =
          0 := by
      have baseAuxiliary :
          (currentCanonicalFullActionActual source current
              space).gravityAuxiliary (canonicalCauchySlicePoint 1 0) =
            actionGeneratedGravityAuxiliary current space := by
        change
          (currentFullSynchronizedCompleteP286BaseActual source current
            space).gravityAuxiliary (canonicalCauchySlicePoint 1 0) =
              actionGeneratedGravityAuxiliary current space
        exact
          sourceActionGeneratedLinearPlebanskiJointLocalActualLift_auxiliary
            source current space _
      rw [baseAuxiliary] at auxiliaryEquality
      have addEquality :
          actionGeneratedGravityAuxiliary current space +
                currentFullSynchronizedLorentzAuxiliaryVelocity source current
                  space =
            actionGeneratedGravityAuxiliary current space + 0 := by
        simpa using auxiliaryEquality
      exact add_left_cancel addEquality
    funext direction
    rw [← currentFullSynchronizedLorentzAuxiliaryVelocity_pairing source
      current space direction, auxiliaryZero]
    simp [gravityAuxiliaryHodgePairingPolynomial]
  · intro velocityZero
    have coordinateZero :
        currentFullSynchronizedLorentzActionCoordinates source current space =
          0 := by
      funext spatialDirection internalPair
      have coordinateEquality := congrArg
        (fun velocity : LorentzSpatialBivectorDirection → Real =>
          velocity
            (canonicalLorentzSpatialBivectorCoordinateDirection
              spatialDirection internalPair))
        velocityZero
      simpa [currentFullSynchronizedLorentzActionCoordinates] using
        coordinateEquality
    have auxiliaryZero :
        currentFullSynchronizedLorentzAuxiliaryVelocity source current space =
          0 := by
      unfold currentFullSynchronizedLorentzAuxiliaryVelocity
      rw [coordinateZero]
      funext internalPair spacetimePair
      fin_cases spacetimePair <;>
        simp [lorentzSpatialAuxiliaryVelocityEmbedding]
    unfold currentFullSynchronizedLorentzActualFirstJetLift
    rw [auxiliaryZero]
    simp

theorem currentCanonicalFullActionActual_smooth
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    (currentCanonicalFullActionActual source current space).Smooth := by
  apply actionGeneratedMatterCompleteFirstGermActual_smooth
  apply actionGeneratedMatterTemporalFirstGermActual_smooth
  apply currentP286CompleteActionResponseOperator_smooth
  apply fullSynchronizedActionResponseOperator_smooth
  exact sourceActionGeneratedLinearPlebanskiJointLocalActualLift_smooth
    source current space

theorem currentFullSynchronizedLorentzActualFirstJetLift_smooth
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    (currentFullSynchronizedLorentzActualFirstJetLift source current
      space).Smooth := by
  have baseSmooth :=
    currentCanonicalFullActionActual_smooth source current space
  rcases baseSmooth with
    ⟨coframeSmooth, connectionSmooth, auxiliarySmooth, multiplierSmooth,
      gaugeConnectionSmooth, gaugeAuxiliarySmooth, scalarSmooth, matterSmooth,
      conjugateSmooth⟩
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · simpa only [currentFullSynchronizedLorentzActualFirstJetLift] using
      coframeSmooth
  · simpa only [currentFullSynchronizedLorentzActualFirstJetLift] using
      connectionSmooth
  · intro internalPair spacetimePair
    simpa only [currentFullSynchronizedLorentzActualFirstJetLift,
      Pi.add_apply, Pi.smul_apply, smul_eq_mul] using
      (auxiliarySmooth internalPair spacetimePair).add
        ((localBaseCoordinate canonicalLorentzianTimeDirection).contDiff.mul
          contDiff_const)
  · simpa only [currentFullSynchronizedLorentzActualFirstJetLift] using
      multiplierSmooth
  · simpa only [currentFullSynchronizedLorentzActualFirstJetLift] using
      gaugeConnectionSmooth
  · simpa only [currentFullSynchronizedLorentzActualFirstJetLift] using
      gaugeAuxiliarySmooth
  · simpa only [currentFullSynchronizedLorentzActualFirstJetLift] using
      scalarSmooth
  · simpa only [currentFullSynchronizedLorentzActualFirstJetLift] using
      matterSmooth
  · simpa only [currentFullSynchronizedLorentzActualFirstJetLift] using
      conjugateSmooth

@[simp] theorem currentCanonicalFullActionActual_coframe
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (point : BasePoint) :
    (currentCanonicalFullActionActual source current space).coframe point =
      current.coframe space := by
  rfl

theorem currentFullSynchronizedLorentzActualFirstJetLift_coframe_one
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (identityCoframe : current.coframe space = 1)
    (point : BasePoint) :
    (currentFullSynchronizedLorentzActualFirstJetLift source current
      space).coframe point = 1 := by
  simp only [currentFullSynchronizedLorentzActualFirstJetLift]
  rw [currentCanonicalFullActionActual_coframe, identityCoframe]

theorem currentFullSynchronizedLorentzActualFirstJetLift_nondegenerate
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (identityCoframe : current.coframe space = 1) :
    (currentFullSynchronizedLorentzActualFirstJetLift source current
      space).Nondegenerate := by
  intro point
  rw [currentFullSynchronizedLorentzActualFirstJetLift_coframe_one
    source current space identityCoframe point]
  simp

end

