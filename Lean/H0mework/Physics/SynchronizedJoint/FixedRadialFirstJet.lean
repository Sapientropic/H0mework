import H0mework.Physics.JointVariation.SectionLorentzPathRadialFirstJet
import H0mework.Physics.SynchronizedJoint.FixedLorentzProfileRegularity

/-!
# Fixed P506/L0 synchronized-section Lorentz path first jet

The fixed exact occurrence now has the `C¹` profile required by the radial
path calculus.  This module reads the all-point primitive connection first
jet from that already emitted occurrence.  It introduces no second actual,
target profile, residual-driven correction, or trajectory certificate.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeFixedP506CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathRadialFirstJet

open ProofFreeRicherAnholonomicSource
open StageNineDiracDualFormNativeCompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathGlobalOperator
open StageNineDiracDualFormNativeFixedP506CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathGlobalActual
open StageNineDiracDualFormNativeFixedP506CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileRegularity
open StageNineDiracDualFormNativeFixedP506JointActionSectionResponse
open StageNineEnrichedProofFreeSource
open StageNineHolonomicField
open StageNineLorentzConnectionVariation

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1200000
set_option maxRecDepth 100000

private abbrev Source : SmoothUnifiedSource :=
  positiveSmoothUnifiedSource

private abbrev Input : StageNineHolonomicConfiguration :=
  FixedP506FormNativeJointActionSolvedSuccessor

private abbrev Occurrence :=
  fixedP506L0CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathOccurrence

/-- The lowered primitive first jet of the one fixed occurrence is exactly
the unconditional radial exactification generated by its `C¹` profile. -/
theorem
    fixedP506L0CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathGlobalActual_loweredConnectionFirstJet_eq_radialFirstJet
    (point : BasePoint)
    (derivativeDirection formDirection : LorentzianIndex)
    (internalPair : Fin 6) :
    minkowskiInternalSign (pairFirst internalPair) *
        gravityConnectionDerivative
          fixedP506L0CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathGlobalActual
          point derivativeDirection formDirection
          (pairFirst internalPair) (pairSecond internalPair) =
      completeJointActionSpacetimeSectionCartanECSynchronizedLorentzRadialFirstJet
        Source Input point (coordinateDirection derivativeDirection)
        formDirection internalPair := by
  change
    minkowskiInternalSign (pairFirst internalPair) *
        gravityConnectionDerivative Occurrence.finalActual
          point derivativeDirection formDirection
          (pairFirst internalPair) (pairSecond internalPair) = _
  exact
    Occurrence.loweredConnectionFirstJet_eq_radialFirstJet
      fixedP506L0CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzJetCLM_contDiff
      point derivativeDirection formDirection internalPair

/-- At the distinguished source occurrence, the radial first jet reduces to
the exact local Cartan--EC action profile of the same occurrence. -/
theorem
    fixedP506L0CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzRadialFirstJet_zero :
    completeJointActionSpacetimeSectionCartanECSynchronizedLorentzRadialFirstJet
        Source Input 0 =
      completeJointActionSpacetimeSectionCartanECSynchronizedLorentzJetCLM
        Source Input 0 := by
  exact
    completeJointActionSpacetimeSectionCartanECSynchronizedLorentzRadialFirstJet_zero
      Source Input

end

end
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeFixedP506CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathRadialFirstJet
