import H0mework.Physics.SynchronizedJoint.GravityTailLorentzPathOperator

/-!
# Cartan--EC synchronized joint coframe/connection path

The gravity-tail action profile already generates, at every spacetime
occurrence, both a complete Cartan-synchronized coframe first jet and the
EC-normal Lorentz-connection first jet.  The earlier path compiler integrated
only the connection jet and retained the affine coframe of the origin
contact.  This module performs the corresponding source-native joint write:

```text
(source, current)
  -> synchronized Cartan--EC gravity prefix
  -> exact recentered action profile at every occurrence
  -> canonical radial integral of the coframe jet
     and canonical radial integral of the connection jet
  -> computed II+(e) and live gravity reaction
  -> one common nine-field actual.
```

The inventory is fixed before emission.  No residual, support, target
coframe, target connection, completed output, selector, branch, closedness
receipt, or free coefficient is accepted by the constructor.  Whether the
two radial integrals realize their sampled jets away from the origin remains
a downstream action-jet readback, never an input to this producer.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeCartanECSynchronizedGravityTailJointPathOperator

open ProofFreeRicherAnholonomicSource
open StageNineCartanContorsionTorsionEquiv
open StageNineCoframeFirstJet
open StageNineDiracDualFormNativeCartanConnectionActualization
open StageNineDiracDualFormNativeCartanConnectionLocalActualLift
open StageNineDiracDualFormNativeCartanECSynchronizedCoframeContactLocalActualLift
open StageNineDiracDualFormNativeCartanECSynchronizedGravityTailLorentzPathOperator
open StageNineDiracDualFormNativeCoframeECContactLocalActualLift
open StageNineDiracDualFormNativeCompleteJointActionFullOccurrenceContactOperator
open StageNineEnrichedProofFreeSource
open StageNineFormNativeGravityMultiplierAuxiliaryIntegratedVariation
open StageNineFormNativeGravityReactionInstallation
open StageNineHolonomicField
open StageNineHolonomicFullSpacetimeRecenterNaturality
open StageNineIIPlusRestriction
open StageNinePositiveSourceGravityMouthNormalizedAffineConnectionGerm
open StageNineResidualLinearPlebanskiTorsionReduction

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1200000
set_option maxRecDepth 100000

/-! ## Occurrence-native coframe one-form -/

/-- The exact Cartan-synchronized coframe jet generated inside the same
recentered gravity-tail profile used by the Lorentz path. -/
def cartanECSynchronizedGravityTailProfileCoframeFirstJet
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) : PointwiseLorentzianCoframeJet :=
  diracDualFormNativeCartanECSynchronizedCoframeFirstJet source
    (cartanECSynchronizedGravityTailProfileInput source current contact) 0

@[simp] theorem
    cartanECSynchronizedGravityTailProfileCoframeFirstJet_coframe_eq_base
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) :
    (cartanECSynchronizedGravityTailProfileCoframeFirstJet
      source current contact).coframe =
      (cartanECSynchronizedGravityTailBase source current).coframe contact := by
  unfold cartanECSynchronizedGravityTailProfileCoframeFirstJet
    diracDualFormNativeCartanECSynchronizedCoframeFirstJet
  dsimp only
  rw [sourceActionGeneratedDiracDualCoframeECContactLocalActualLift_coframe]
  unfold cartanECSynchronizedGravityTailProfileInput
  exact fullyRecenterHolonomicConfiguration_coframe_origin
    (cartanECSynchronizedGravityTailBase source current) contact

/-- The sampled coframe jet is the Cartan derivative generated by the same
recentered gravity base.  This normal form is source/current generic and
contains no fixed-lineage readout. -/
theorem
    cartanECSynchronizedGravityTailProfileCoframeFirstJet_derivative_normalForm
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint)
    (derivativeDirection internal coordinate : LorentzianIndex) :
    (cartanECSynchronizedGravityTailProfileCoframeFirstJet
        source current contact).derivative
        derivativeDirection internal coordinate =
      -coframeConnectionAction
          ((cartanECSynchronizedGravityTailBase source current
            ).gravityConnection contact)
          derivativeDirection
          ((cartanECSynchronizedGravityTailBase source current
            ).coframe contact)
          internal coordinate +
        ((1 : ℝ) / 2) *
          orderedCartanTorsionComponent
            (diracDualFormNativeActionCartanTorsionAt source
              (cartanECSynchronizedGravityTailBase source current) contact)
            internal derivativeDirection coordinate := by
  let base := cartanECSynchronizedGravityTailBase source current
  have spinEq :
      diracDualFormNativeActionSpinResponseAt source
          (sourceActionGeneratedDiracDualCoframeECContactLocalActualLift
            source (fullyRecenterHolonomicConfiguration base contact) 0) 0 =
        diracDualFormNativeActionSpinResponseAt source base contact := by
    apply diracDualFormNativeActionSpinResponseAt_eq_of_fields_at_two_points
    · rw [sourceActionGeneratedDiracDualCoframeECContactLocalActualLift_coframe]
      exact fullyRecenterHolonomicConfiguration_coframe_origin base contact
    · change
        (fullyRecenterHolonomicConfiguration base contact).matter 0 =
          base.matter contact
      exact fullyRecenterHolonomicConfiguration_matter_origin base contact
    · change
        (fullyRecenterHolonomicConfiguration base contact).conjugateMatter 0 =
          base.conjugateMatter contact
      exact
        fullyRecenterHolonomicConfiguration_conjugateMatter_origin base contact
  unfold cartanECSynchronizedGravityTailProfileCoframeFirstJet
    diracDualFormNativeCartanECSynchronizedCoframeFirstJet
  dsimp only
  rw [sourceActionGeneratedDiracDualCoframeECContactLocalActualLift_connection_contact]
  unfold cartanECSynchronizedGravityTailProfileInput
  rw [fullyRecenterHolonomicConfiguration_gravityConnection_origin]
  rw [sourceActionGeneratedDiracDualCoframeECContactLocalActualLift_coframe]
  rw [fullyRecenterHolonomicConfiguration_coframe_origin]
  congr 2
  unfold diracDualFormNativeActionCartanTorsionAt
  rw [sourceActionGeneratedDiracDualCoframeECContactLocalActualLift_coframe]
  rw [fullyRecenterHolonomicConfiguration_coframe_origin]
  rw [spinEq]

/-- At the distinguished source occurrence, resampling the synchronized
profile preserves the complete coframe first jet already emitted by the
synchronized gravity base. -/
theorem
    cartanECSynchronizedGravityTailProfileCoframeFirstJet_zero_eq_baseFirstJet
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    cartanECSynchronizedGravityTailProfileCoframeFirstJet source current 0 =
      holonomicCoframeFirstJetAt
        (cartanECSynchronizedGravityTailBase source current).coframe 0 := by
  change
    cartanECSynchronizedGravityTailProfileCoframeFirstJet source current 0 =
      holonomicCoframeFirstJetAt
        (sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
          source current 0).coframe 0
  rw [
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_coframeFirstJet_contact]
  apply coframeJet_eq_of_fields_eq
  · rw [
      cartanECSynchronizedGravityTailProfileCoframeFirstJet_coframe_eq_base]
    change
      (sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
        source current 0).coframe 0 = _
    rw [
      sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_coframe_contact]
    rfl
  · funext derivativeDirection internal coordinate
    rw [
      cartanECSynchronizedGravityTailProfileCoframeFirstJet_derivative_normalForm]
    unfold diracDualFormNativeCartanECSynchronizedCoframeFirstJet
    dsimp only
    simp only [cartanECSynchronizedGravityTailBase]
    rw [
      sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_connection,
      sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_coframe_contact,
      sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_actionTorsion_contact,
      sourceActionGeneratedDiracDualCoframeECContactLocalActualLift_coframe]

/-- One derivative row of the occurrence-native coframe jet. -/
def cartanECSynchronizedGravityTailCoframeJetOneForm
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint)
    (derivativeDirection : LorentzianIndex) : LorentzianCoframe :=
  fun internal coordinate =>
    (cartanECSynchronizedGravityTailProfileCoframeFirstJet
      source current contact).derivative derivativeDirection internal coordinate

/-- Scalar continuous-linear assembly of one coordinate of the generated
coframe first jet.  The coframe carrier is the repository's raw matrix type,
whose topology deliberately does not install a global normed-group instance;
the canonical path integral is therefore assembled in its sixteen real
coordinates. -/
def cartanECSynchronizedGravityTailCoframeJetCoordinateCLM
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint)
    (internal coordinate : LorentzianIndex) : BasePoint →L[ℝ] ℝ :=
  ∑ derivativeDirection : LorentzianIndex,
    (baseCoordinate derivativeDirection).smulRight
      (cartanECSynchronizedGravityTailCoframeJetOneForm
        source current contact derivativeDirection internal coordinate)

theorem cartanECSynchronizedGravityTailCoframeJetCoordinateCLM_coordinate
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint)
    (derivativeDirection internal coordinate : LorentzianIndex) :
    cartanECSynchronizedGravityTailCoframeJetCoordinateCLM
        source current contact internal coordinate
        (coordinateDirection derivativeDirection) =
      cartanECSynchronizedGravityTailCoframeJetOneForm
        source current contact derivativeDirection internal coordinate := by
  fin_cases derivativeDirection <;>
    simp [cartanECSynchronizedGravityTailCoframeJetCoordinateCLM,
      baseCoordinate, coordinateDirection, Fin.sum_univ_four]

/-! ## Canonical joint path actualization -/

/-- Distinguished coframe value emitted by the synchronized first leg. -/
def cartanECSynchronizedGravityTailCoframePathAnchor
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) : LorentzianCoframe :=
  (cartanECSynchronizedGravityTailBase source current).coframe 0

/-- Radially integrate the exact occurrence-owned coframe one-form. -/
def cartanECSynchronizedGravityTailCoframeRadialIncrement
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (point : BasePoint) : LorentzianCoframe :=
  fun internal coordinate =>
    ∫ᶜ contact in Path.segment (0 : BasePoint) point,
      cartanECSynchronizedGravityTailCoframeJetCoordinateCLM
        source current contact internal coordinate

@[simp] theorem cartanECSynchronizedGravityTailCoframeRadialIncrement_zero
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    cartanECSynchronizedGravityTailCoframeRadialIncrement source current 0 = 0 := by
  ext internal coordinate
  simp [cartanECSynchronizedGravityTailCoframeRadialIncrement]

/-- Primitive global coframe emitted by the canonical radial compiler. -/
def cartanECSynchronizedGravityTailCoframePathField
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    BasePoint → LorentzianCoframe :=
  fun point =>
    cartanECSynchronizedGravityTailCoframePathAnchor source current +
      cartanECSynchronizedGravityTailCoframeRadialIncrement
        source current point

@[simp] theorem cartanECSynchronizedGravityTailCoframePathField_zero
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    cartanECSynchronizedGravityTailCoframePathField source current 0 =
      cartanECSynchronizedGravityTailCoframePathAnchor source current := by
  rw [cartanECSynchronizedGravityTailCoframePathField,
    cartanECSynchronizedGravityTailCoframeRadialIncrement_zero, add_zero]

/-- Install both primitive path fields into the same synchronized prefix and
recompute `B = II+(e)` from the newly emitted coframe. -/
def cartanECSynchronizedGravityTailJointConnectedActual
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  let coframe :=
    cartanECSynchronizedGravityTailCoframePathField source current
  { cartanECSynchronizedGravityTailBase source current with
    coframe := coframe
    gravityConnection :=
      cartanECSynchronizedGravityTailPathConnectionField source current
    gravityAuxiliary := fun point =>
      physicalIIPlusBivector (coframe point) }

/-- Recompute the live reaction only after both primitive paths exist. -/
def cartanECSynchronizedGravityTailJointFinalActual
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  installFormNativeGravityReaction
    (cartanECSynchronizedGravityTailJointConnectedActual source current)

/-! ## Exact fixed-inventory occurrence -/

inductive CartanECSynchronizedGravityTailJointWriteLeg where
  | cartanECSynchronized
  | jointPrimitivePath
  | liveReaction
  deriving DecidableEq

def cartanECSynchronizedGravityTailJointActionWrite
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (leg : CartanECSynchronizedGravityTailJointWriteLeg)
    (before : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  match leg with
  | .cartanECSynchronized =>
      sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
        source before 0
  | .jointPrimitivePath =>
      let coframe :=
        cartanECSynchronizedGravityTailCoframePathField source current
      { before with
        coframe := coframe
        gravityConnection :=
          cartanECSynchronizedGravityTailPathConnectionField source current
        gravityAuxiliary := fun point =>
          physicalIIPlusBivector (coframe point) }
  | .liveReaction =>
      installFormNativeGravityReaction before

/-- Singleton occurrence indexed only by the primitive source and current. -/
inductive CartanECSynchronizedGravityTailJointOccurrence
    (_source : SmoothUnifiedSource)
    (_current : StageNineHolonomicConfiguration) where
  | generated

def sourceActionGeneratedCartanECSynchronizedGravityTailJointOccurrence
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    CartanECSynchronizedGravityTailJointOccurrence source current :=
  .generated

namespace CartanECSynchronizedGravityTailJointOccurrence

def before
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (_occurrence :
      CartanECSynchronizedGravityTailJointOccurrence source current) :
    CartanECSynchronizedGravityTailJointWriteLeg →
      StageNineHolonomicConfiguration
  | .cartanECSynchronized => current
  | .jointPrimitivePath =>
      cartanECSynchronizedGravityTailBase source current
  | .liveReaction =>
      cartanECSynchronizedGravityTailJointConnectedActual source current

def after
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (_occurrence :
      CartanECSynchronizedGravityTailJointOccurrence source current) :
    CartanECSynchronizedGravityTailJointWriteLeg →
      StageNineHolonomicConfiguration
  | .cartanECSynchronized =>
      cartanECSynchronizedGravityTailBase source current
  | .jointPrimitivePath =>
      cartanECSynchronizedGravityTailJointConnectedActual source current
  | .liveReaction =>
      cartanECSynchronizedGravityTailJointFinalActual source current

theorem after_eq_actionWrite
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence :
      CartanECSynchronizedGravityTailJointOccurrence source current)
    (leg : CartanECSynchronizedGravityTailJointWriteLeg) :
    occurrence.after leg =
      cartanECSynchronizedGravityTailJointActionWrite
        source current leg (occurrence.before leg) := by
  cases leg <;> rfl

@[simp] theorem cartanECSynchronized_to_jointPrimitivePath_handoff
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence :
      CartanECSynchronizedGravityTailJointOccurrence source current) :
    occurrence.after .cartanECSynchronized =
      occurrence.before .jointPrimitivePath :=
  rfl

@[simp] theorem jointPrimitivePath_to_liveReaction_handoff
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence :
      CartanECSynchronizedGravityTailJointOccurrence source current) :
    occurrence.after .jointPrimitivePath =
      occurrence.before .liveReaction :=
  rfl

abbrev finalActual
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence :
      CartanECSynchronizedGravityTailJointOccurrence source current) :
    StageNineHolonomicConfiguration :=
  occurrence.after .liveReaction

end CartanECSynchronizedGravityTailJointOccurrence

/-- Public source/current-only joint gravity-tail emitter. -/
def sourceActionGeneratedDiracDualCartanECSynchronizedGravityTailJointPathOperator
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  (sourceActionGeneratedCartanECSynchronizedGravityTailJointOccurrence
    source current).finalActual

theorem
    sourceActionGeneratedDiracDualCartanECSynchronizedGravityTailJointPathOperator_eq_occurrenceFinal
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    sourceActionGeneratedDiracDualCartanECSynchronizedGravityTailJointPathOperator
        source current =
      (sourceActionGeneratedCartanECSynchronizedGravityTailJointOccurrence
        source current).finalActual :=
  rfl

