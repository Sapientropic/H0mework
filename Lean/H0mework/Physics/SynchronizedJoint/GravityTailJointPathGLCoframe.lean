/-- The occurrence-owned radial increment actualized in `GL(4)`. -/
def cartanECSynchronizedGravityTailGLCoframePathField
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    BasePoint → LorentzianCoframe :=
  fun point =>
    coframeMatrixExponentialRetraction
      (cartanECSynchronizedGravityTailCoframePathAnchor source current)
      (cartanECSynchronizedGravityTailCoframeRadialIncrement
        source current point)

@[simp] theorem cartanECSynchronizedGravityTailGLCoframePathField_zero
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    cartanECSynchronizedGravityTailGLCoframePathField source current 0 =
      cartanECSynchronizedGravityTailCoframePathAnchor source current := by
  simp [cartanECSynchronizedGravityTailGLCoframePathField]

/-- A nondegenerate occurrence anchor generates a globally nondegenerate
coframe field. -/
theorem cartanECSynchronizedGravityTailGLCoframePathField_nondegenerate
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (anchorNondegenerate :
      Matrix.det
        (cartanECSynchronizedGravityTailCoframePathAnchor source current) ≠
          0) :
    ∀ point,
      Matrix.det
        (cartanECSynchronizedGravityTailGLCoframePathField
          source current point) ≠ 0 := by
  intro point
  exact coframeMatrixExponentialRetraction_det_ne_zero
    (cartanECSynchronizedGravityTailCoframePathAnchor source current)
    (cartanECSynchronizedGravityTailCoframeRadialIncrement
      source current point)
    anchorNondegenerate

/-- Matrix-valued packaging of the derivative already generated by the
radial integral. -/
def cartanECSynchronizedGravityTailCoframeRadialFirstJetCLM
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (point : BasePoint) : BasePoint →L[ℝ] LorentzianCoframe :=
  ContinuousLinearMap.pi fun internal =>
    ContinuousLinearMap.pi fun coordinate =>
      cartanECSynchronizedGravityTailCoframeRadialFirstJetCoordinate
        source current point internal coordinate

theorem
    cartanECSynchronizedGravityTailCoframeRadialIncrement_hasFDerivAt_of_contDiff
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (regular : ∀ internal coordinate,
      ContDiff ℝ 1 fun contact =>
        cartanECSynchronizedGravityTailCoframeJetCoordinateCLM
          source current contact internal coordinate)
    (point : BasePoint) :
    HasFDerivAt
      (cartanECSynchronizedGravityTailCoframeRadialIncrement source current)
      (cartanECSynchronizedGravityTailCoframeRadialFirstJetCLM
        source current point)
      point := by
  apply hasFDerivAt_pi.mpr
  intro internal
  apply hasFDerivAt_pi.mpr
  intro coordinate
  exact
    cartanECSynchronizedGravityTailCoframeRadialIncrement_coordinate_hasFDerivAt_of_contDiff
      source current internal coordinate (regular internal coordinate) point

/-- The GL actualization has the exact original radial first germ at the
source contact. -/
theorem cartanECSynchronizedGravityTailGLCoframePathField_hasFDerivAt_zero
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (anchorNondegenerate :
      Matrix.det
        (cartanECSynchronizedGravityTailCoframePathAnchor source current) ≠
          0)
    (regular : ∀ internal coordinate,
      ContDiff ℝ 1 fun contact =>
        cartanECSynchronizedGravityTailCoframeJetCoordinateCLM
          source current contact internal coordinate) :
    HasFDerivAt
      (cartanECSynchronizedGravityTailGLCoframePathField source current)
      (cartanECSynchronizedGravityTailCoframeRadialFirstJetCLM
        source current 0)
      0 := by
  exact coframeMatrixExponentialRetraction_comp_hasFDerivAt
    (cartanECSynchronizedGravityTailCoframePathAnchor source current)
    anchorNondegenerate
    (cartanECSynchronizedGravityTailCoframeRadialIncrement source current)
    0
    (cartanECSynchronizedGravityTailCoframeRadialFirstJetCLM
      source current 0)
    (cartanECSynchronizedGravityTailCoframeRadialIncrement_hasFDerivAt_of_contDiff
      source current regular 0)
    (cartanECSynchronizedGravityTailCoframeRadialIncrement_zero source current)

/-- Connected GL gravity material.  It retains the synchronized base's other
fields, installs the occurrence's generated Lorentz path, and recomputes
`II+` from the GL coframe. -/
def cartanECSynchronizedGravityTailGLConnectedActual
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  let coframe :=
    cartanECSynchronizedGravityTailGLCoframePathField source current
  { cartanECSynchronizedGravityTailBase source current with
    coframe := coframe
    gravityConnection :=
      cartanECSynchronizedGravityTailPathConnectionField source current
    gravityAuxiliary := fun point =>
      physicalIIPlusBivector (coframe point) }

/-! ## Exact source/current-only GL occurrence -/

inductive CartanECSynchronizedGravityTailGLWriteLeg where
  | cartanECSynchronized
  | jointPrimitivePath
  | liveReaction
  deriving DecidableEq

def cartanECSynchronizedGravityTailGLActionWrite
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (leg : CartanECSynchronizedGravityTailGLWriteLeg)
    (before : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  match leg with
  | .cartanECSynchronized =>
      sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
        source before 0
  | .jointPrimitivePath =>
      let coframe :=
        cartanECSynchronizedGravityTailGLCoframePathField source current
      { before with
        coframe := coframe
        gravityConnection :=
          cartanECSynchronizedGravityTailPathConnectionField source current
        gravityAuxiliary := fun point =>
          physicalIIPlusBivector (coframe point) }
  | .liveReaction =>
      installFormNativeGravityReaction before

/-- Sealed GL occurrence indexed only by the exact source and current. -/
inductive CartanECSynchronizedGravityTailGLOccurrence
    (_source : SmoothUnifiedSource)
    (_current : StageNineHolonomicConfiguration) where
  | generated

def sourceActionGeneratedCartanECSynchronizedGravityTailGLOccurrence
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    CartanECSynchronizedGravityTailGLOccurrence source current :=
  .generated

namespace CartanECSynchronizedGravityTailGLOccurrence

def before
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (_occurrence :
      CartanECSynchronizedGravityTailGLOccurrence source current) :
    CartanECSynchronizedGravityTailGLWriteLeg →
      StageNineHolonomicConfiguration
  | .cartanECSynchronized => current
  | .jointPrimitivePath =>
      cartanECSynchronizedGravityTailBase source current
  | .liveReaction =>
      cartanECSynchronizedGravityTailGLConnectedActual source current

def after
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (_occurrence :
      CartanECSynchronizedGravityTailGLOccurrence source current) :
    CartanECSynchronizedGravityTailGLWriteLeg →
      StageNineHolonomicConfiguration
  | .cartanECSynchronized =>
      cartanECSynchronizedGravityTailBase source current
  | .jointPrimitivePath =>
      cartanECSynchronizedGravityTailGLConnectedActual source current
  | .liveReaction =>
      installFormNativeGravityReaction
        (cartanECSynchronizedGravityTailGLConnectedActual source current)

theorem after_eq_actionWrite
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence :
      CartanECSynchronizedGravityTailGLOccurrence source current)
    (leg : CartanECSynchronizedGravityTailGLWriteLeg) :
    occurrence.after leg =
      cartanECSynchronizedGravityTailGLActionWrite
        source current leg (occurrence.before leg) := by
  cases leg <;> rfl

@[simp] theorem cartanECSynchronized_to_jointPrimitivePath_handoff
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence :
      CartanECSynchronizedGravityTailGLOccurrence source current) :
    occurrence.after .cartanECSynchronized =
      occurrence.before .jointPrimitivePath :=
  rfl

@[simp] theorem jointPrimitivePath_to_liveReaction_handoff
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence :
      CartanECSynchronizedGravityTailGLOccurrence source current) :
    occurrence.after .jointPrimitivePath =
      occurrence.before .liveReaction :=
  rfl

abbrev finalActual
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence :
      CartanECSynchronizedGravityTailGLOccurrence source current) :
    StageNineHolonomicConfiguration :=
  occurrence.after .liveReaction

end CartanECSynchronizedGravityTailGLOccurrence

