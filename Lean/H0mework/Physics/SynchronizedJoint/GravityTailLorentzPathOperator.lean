open StageNineEnrichedProofFreeSource
open StageNineFormNativeLorentzGeometricFirstVariation
open StageNineFormNativeGravityMultiplierAuxiliaryIntegratedVariation
open StageNineFormNativeGravityReactionInstallation
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineHolonomicFullSpacetimeRecenterNaturality
open StageNineIIPlusRestriction
open StageNineLorentzConnectionVariation
open StageNinePositiveSourceGravityMouthNormalizedAffineConnectionGerm

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1200000
set_option maxRecDepth 100000

/-! ## Exact action-owned profile -/

/-- The first gravity-only leg.  It consumes the supplied current directly;
no complete-joint spacetime-section leg is rerun. -/
def cartanECSynchronizedGravityTailBase
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
    source current 0

/-- Exact recentering of the generated gravity prefix at one occurrence. -/
def cartanECSynchronizedGravityTailProfileInput
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) : StageNineHolonomicConfiguration :=
  fullyRecenterHolonomicConfiguration
    (cartanECSynchronizedGravityTailBase source current) contact

/-- The native synchronized gravity write generated from the exact recentered
prefix.  This is the action profile sampled by the path compiler. -/
def cartanECSynchronizedGravityTailProfileContact
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) : StageNineHolonomicConfiguration :=
  sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
    source
    (cartanECSynchronizedGravityTailProfileInput source current contact)
    0

/-- Primitive connection value read by the recentered action occurrence. -/
def cartanECSynchronizedGravityTailProfileOrigin
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) : PointwiseLorentzSpinConnection :=
  (cartanECSynchronizedGravityTailProfileInput source current contact
    ).gravityConnection 0

@[simp] theorem cartanECSynchronizedGravityTailProfileOrigin_eq_base
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) :
    cartanECSynchronizedGravityTailProfileOrigin source current contact =
      (cartanECSynchronizedGravityTailBase source current
        ).gravityConnection contact := by
  exact fullyRecenterHolonomicConfiguration_gravityConnection_origin
    (cartanECSynchronizedGravityTailBase source current) contact

/-- Curvature target generated inside the same recentered Cartan--EC leg. -/
def cartanECSynchronizedGravityTailProfileTarget
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) : PhysicalBivector :=
  diracDualFormNativeCoframeECContactCurvatureTarget source
    (cartanECSynchronizedGravityTailProfileInput source current contact) 0

theorem cartanECSynchronizedGravityTailProfileField_eq_base
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) :
    diracDualFormNativeCoframeECContactField
        (cartanECSynchronizedGravityTailProfileInput source current contact) 0 =
      diracDualFormNativeCoframeECContactField
        (cartanECSynchronizedGravityTailBase source current) contact := by
  unfold diracDualFormNativeCoframeECContactField
    diracDualFormNativeCoframeECContactPreparedActual
    cartanECSynchronizedGravityTailProfileInput
  rw [toContinuumPointField_restrictHolonomicConfigurationToIIPlus,
    toContinuumPointField_restrictHolonomicConfigurationToIIPlus]
  rw [fullyRecenterHolonomicConfiguration_pointField_origin_unconditional]

theorem cartanECSynchronizedGravityTailProfilePreparedCurvature_eq_base
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) :
    holonomicGravityCurvature
        (diracDualFormNativeCoframeECContactPreparedActual
          (cartanECSynchronizedGravityTailProfileInput source current contact))
        0 =
      holonomicGravityCurvature
        (diracDualFormNativeCoframeECContactPreparedActual
          (cartanECSynchronizedGravityTailBase source current))
        contact := by
  calc
    _ = holonomicGravityCurvature
        (cartanECSynchronizedGravityTailProfileInput source current contact)
        0 := by rfl
    _ = holonomicGravityCurvature
        (cartanECSynchronizedGravityTailBase source current) contact :=
      fullyRecenterHolonomicConfiguration_gravityCurvature_origin_unconditional
        (cartanECSynchronizedGravityTailBase source current) contact
    _ = holonomicGravityCurvature
        (diracDualFormNativeCoframeECContactPreparedActual
          (cartanECSynchronizedGravityTailBase source current))
        contact := by rfl

/-- Closed normalized-affine form of the occurrence-native profile write. -/
theorem cartanECSynchronizedGravityTailProfileContact_connection_normalForm
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) :
    (cartanECSynchronizedGravityTailProfileContact source current contact
      ).gravityConnection =
      normalizedAffineLorentzConnectionField
        (cartanECSynchronizedGravityTailProfileOrigin source current contact)
        (cartanECSynchronizedGravityTailProfileTarget source current contact) := by
  funext point formDirection internalOut internalIn
  simp [cartanECSynchronizedGravityTailProfileContact,
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift,
    diracDualFormNativeCartanECSynchronizedCoframePreparedActual,
    diracDualFormNativeCartanECSynchronizedECActual,
    sourceActionGeneratedDiracDualCoframeECContactLocalActualLift,
    diracDualFormNativeCoframeECContactPreparedActual,
    diracDualFormNativeCoframeECContactConnectedActual,
    restrictHolonomicConfigurationToIIPlus,
    coframeECContactCenteredNormalizedAffineLorentzConnectionField,
    cartanECSynchronizedGravityTailProfileOrigin,
    cartanECSynchronizedGravityTailProfileTarget]

/-- The complete lowered connection first jet written by the native profile
contact. -/
def cartanECSynchronizedGravityTailLoweredConnectionFirstJet
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint)
    (derivativeDirection formDirection : LorentzianIndex)
    (internalPair : Fin 6) : ℝ :=
  minkowskiInternalSign (pairFirst internalPair) *
    gravityConnectionDerivative
      (cartanECSynchronizedGravityTailProfileContact source current contact)
      0 derivativeDirection formDirection
      (pairFirst internalPair) (pairSecond internalPair)

/-- Closed coordinate formula for the native gravity-tail profile jet. -/
theorem cartanECSynchronizedGravityTailLoweredConnectionFirstJet_normalForm
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint)
    (derivativeDirection formDirection : LorentzianIndex)
    (internalPair : Fin 6) :
    cartanECSynchronizedGravityTailLoweredConnectionFirstJet
        source current contact derivativeDirection formDirection internalPair =
      ∑ spacetimePair : Fin 6,
        normalizedDerivativeBivector
            (cartanECSynchronizedGravityTailProfileOrigin
              source current contact)
            (cartanECSynchronizedGravityTailProfileTarget
              source current contact)
            internalPair spacetimePair *
          orientedLorentzBivectorBasisCoefficient spacetimePair
            derivativeDirection formDirection := by
  unfold cartanECSynchronizedGravityTailLoweredConnectionFirstJet
    gravityConnectionDerivative
  rw [cartanECSynchronizedGravityTailProfileContact_connection_normalForm]
  change
    minkowskiInternalSign (pairFirst internalPair) *
        gravityConnectionDerivative
          (normalizedAffineConfiguration
            (cartanECSynchronizedGravityTailProfileOrigin
              source current contact)
            (cartanECSynchronizedGravityTailProfileTarget
              source current contact))
          0 derivativeDirection formDirection
          (pairFirst internalPair) (pairSecond internalPair) = _
  rw [normalizedAffineLorentzConnectionField_loweredDerivative_zero,
    normalizedAffineBivectorOneForm_directionalDerivative_zero]

/-- The generated jet as a Lorentz-bivector-valued one-form. -/
def cartanECSynchronizedGravityTailJetOneForm
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint)
    (derivativeDirection : LorentzianIndex) : LorentzBivectorOneForm :=
  fun formDirection internalPair =>
    cartanECSynchronizedGravityTailLoweredConnectionFirstJet
      source current contact derivativeDirection formDirection internalPair

/-- Finite-dimensional continuous-linear assembly of the occurrence-native
profile jet. -/
def cartanECSynchronizedGravityTailJetCLM
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) :
    BasePoint →L[ℝ] LorentzBivectorOneForm :=
  ∑ derivativeDirection : LorentzianIndex,
    (baseCoordinate derivativeDirection).smulRight
      (cartanECSynchronizedGravityTailJetOneForm
        source current contact derivativeDirection)

theorem cartanECSynchronizedGravityTailJetCLM_coordinate
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint)
    (derivativeDirection : LorentzianIndex) :
    cartanECSynchronizedGravityTailJetCLM source current contact
        (coordinateDirection derivativeDirection) =
      cartanECSynchronizedGravityTailJetOneForm
        source current contact derivativeDirection := by
  fin_cases derivativeDirection <;>
    ext formDirection internalPair <;>
    simp [cartanECSynchronizedGravityTailJetCLM,
      baseCoordinate, coordinateDirection, Fin.sum_univ_four]

/-! ## Canonical path actualization -/

/-- Distinguished primitive connection emitted by the same first gravity
leg.  It is not a separately supplied boundary constant. -/
def cartanECSynchronizedGravityTailPathAnchor
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    PointwiseLorentzSpinConnection :=
  (cartanECSynchronizedGravityTailBase source current).gravityConnection 0

/-- Integrate the exact occurrence-owned action one-form along the fixed
radial segment. -/
def cartanECSynchronizedGravityTailRadialIncrement
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (point : BasePoint) : LorentzBivectorOneForm :=
  ∫ᶜ contact in Path.segment (0 : BasePoint) point,
    cartanECSynchronizedGravityTailJetCLM source current contact

@[simp] theorem cartanECSynchronizedGravityTailRadialIncrement_zero
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    cartanECSynchronizedGravityTailRadialIncrement source current 0 = 0 := by
  funext formDirection internalPair
  simp [cartanECSynchronizedGravityTailRadialIncrement]

/-- Primitive global Lorentz field emitted by the fixed radial compiler. -/
def cartanECSynchronizedGravityTailPathConnectionField
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) : LorentzConnectionField :=
  fun point =>
    cartanECSynchronizedGravityTailPathAnchor source current +
      lorentzSkewConnectionOfBivectorOneForm
        (cartanECSynchronizedGravityTailRadialIncrement
          source current point)

@[simp] theorem cartanECSynchronizedGravityTailPathConnectionField_zero
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    cartanECSynchronizedGravityTailPathConnectionField source current 0 =
      cartanECSynchronizedGravityTailPathAnchor source current := by
  funext formDirection internalOut internalIn
  simp [cartanECSynchronizedGravityTailPathConnectionField]

/-- Install the path connection into the exact synchronized gravity prefix. -/
def cartanECSynchronizedGravityTailConnectedActual
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  { cartanECSynchronizedGravityTailBase source current with
    gravityConnection :=
      cartanECSynchronizedGravityTailPathConnectionField source current }

/-- Recompute the live reaction only after the primitive path exists. -/
def cartanECSynchronizedGravityTailFinalActual
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  installFormNativeGravityReaction
    (cartanECSynchronizedGravityTailConnectedActual source current)

/-! ## Exact fixed-inventory occurrence -/

inductive CartanECSynchronizedGravityTailWriteLeg where
  | cartanECSynchronized
  | lorentzPath
  | liveReaction
  deriving DecidableEq

def cartanECSynchronizedGravityTailActionWrite
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (leg : CartanECSynchronizedGravityTailWriteLeg)
    (before : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  match leg with
  | .cartanECSynchronized =>
      sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
        source before 0
  | .lorentzPath =>
      { before with
        gravityConnection :=
          cartanECSynchronizedGravityTailPathConnectionField source current }
  | .liveReaction =>
      installFormNativeGravityReaction before

/-- Singleton occurrence indexed only by the primitive source and current. -/
inductive CartanECSynchronizedGravityTailOccurrence
    (_source : SmoothUnifiedSource)
    (_current : StageNineHolonomicConfiguration) where
  | generated

def sourceActionGeneratedCartanECSynchronizedGravityTailOccurrence
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    CartanECSynchronizedGravityTailOccurrence source current :=
  .generated

namespace CartanECSynchronizedGravityTailOccurrence

theorem eq_generated
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence : CartanECSynchronizedGravityTailOccurrence source current) :
    occurrence =
      sourceActionGeneratedCartanECSynchronizedGravityTailOccurrence
        source current := by
  cases occurrence
  rfl

def before
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (_occurrence : CartanECSynchronizedGravityTailOccurrence source current) :
    CartanECSynchronizedGravityTailWriteLeg →
      StageNineHolonomicConfiguration
  | .cartanECSynchronized => current
  | .lorentzPath => cartanECSynchronizedGravityTailBase source current
  | .liveReaction =>
      cartanECSynchronizedGravityTailConnectedActual source current

def after
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (_occurrence : CartanECSynchronizedGravityTailOccurrence source current) :
    CartanECSynchronizedGravityTailWriteLeg →
      StageNineHolonomicConfiguration
  | .cartanECSynchronized =>
      cartanECSynchronizedGravityTailBase source current
  | .lorentzPath =>
      cartanECSynchronizedGravityTailConnectedActual source current
  | .liveReaction =>
      cartanECSynchronizedGravityTailFinalActual source current

theorem after_eq_actionWrite
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence : CartanECSynchronizedGravityTailOccurrence source current)
    (leg : CartanECSynchronizedGravityTailWriteLeg) :
    occurrence.after leg =
      cartanECSynchronizedGravityTailActionWrite
        source current leg (occurrence.before leg) := by
  cases leg <;>
    rfl

@[simp] theorem cartanECSynchronized_to_lorentzPath_handoff
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence : CartanECSynchronizedGravityTailOccurrence source current) :
    occurrence.after .cartanECSynchronized =
      occurrence.before .lorentzPath :=
  rfl

@[simp] theorem lorentzPath_to_liveReaction_handoff
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence : CartanECSynchronizedGravityTailOccurrence source current) :
    occurrence.after .lorentzPath = occurrence.before .liveReaction :=
  rfl

/-- The sampled profile is derived from the exact first-leg output. -/
def profileInput
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence : CartanECSynchronizedGravityTailOccurrence source current)
    (contact : BasePoint) : StageNineHolonomicConfiguration :=
  fullyRecenterHolonomicConfiguration
    (occurrence.after .cartanECSynchronized) contact

theorem profileContact_eq_nativeActionWrite
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence : CartanECSynchronizedGravityTailOccurrence source current)
    (contact : BasePoint) :
    cartanECSynchronizedGravityTailProfileContact source current contact =
      sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
        source (occurrence.profileInput contact) 0 := by
  rw [occurrence.eq_generated]
  rfl

abbrev finalActual
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence : CartanECSynchronizedGravityTailOccurrence source current) :
    StageNineHolonomicConfiguration :=
  occurrence.after .liveReaction

end CartanECSynchronizedGravityTailOccurrence

