/-- The coframe write changes the first jet but preserves the entire contact
point field of the preceding EC actual.  In particular, it does not silently
replace the EC curvature, gauge/matter data, or covariant derivatives. -/
theorem
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_pointField_contact
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) :
    toContinuumPointField
        (sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
          source current contact)
        contact =
      toContinuumPointField
        (diracDualFormNativeCartanECSynchronizedECActual
          source current contact)
        contact := by
  unfold toContinuumPointField
  apply StageNineContinuumPointField.ext
  · rw [
      sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_coframe_contact,
      sourceActionGeneratedDiracDualCoframeECContactLocalActualLift_coframe]
  · exact
      sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_curvature
        source current contact contact
  · rw [
      sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_auxiliary,
      sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_coframe_contact,
      sourceActionGeneratedDiracDualCoframeECContactLocalActualLift_auxiliary]
  · rw [show
        (sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
          source current contact).gravitySimplicityMultiplier contact =
            diracDualFormNativeCartanECSynchronizedCoframeReactionField
              source current contact contact by
        exact congrFun
          (sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_multiplier
            source current contact)
          contact]
    rw [show
        (diracDualFormNativeCartanECSynchronizedECActual
          source current contact).gravitySimplicityMultiplier contact =
            formNativeGravityReactionField
              (diracDualFormNativeCartanECSynchronizedECActual
                source current contact)
              contact by
        exact congrFun
          (sourceActionGeneratedDiracDualCoframeECContactLocalActualLift_reactionSelfGenerated
            source current contact)
          contact]
    unfold diracDualFormNativeCartanECSynchronizedCoframeReactionField
      formNativeGravityReactionField
    have preparedAuxiliary :
        (diracDualFormNativeCartanECSynchronizedCoframePreparedActual
          source current contact).gravityAuxiliary contact =
          physicalIIPlusBivector (current.coframe contact) := by
      change
        physicalIIPlusBivector
            (cartanECSynchronizedCenteredAffineCoframeField contact
              (diracDualFormNativeCartanECSynchronizedCoframeFirstJet
                source current contact) contact) =
          physicalIIPlusBivector (current.coframe contact)
      rw [cartanECSynchronizedCenteredAffineCoframeField_contact]
      rfl
    rw [preparedAuxiliary]
    rfl
  · rfl
  · rfl
  · rfl
  · rfl
  · rfl
  · rfl
  · rfl

/-- The synchronized coframe write preserves the complete
curvature-independent EC coframe load at its own occurrence. -/
theorem
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_contactLoad_contact
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) :
    diracDualFormNativeCoframeECContactLoad source
        (sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
          source current contact)
        contact =
      diracDualFormNativeCoframeECContactLoad source current contact := by
  let final :=
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
      source current contact
  let ec := diracDualFormNativeCartanECSynchronizedECActual
    source current contact
  have restrictedIdempotent
      (field : StageNineContinuumPointField) :
      restrictContinuumPointFieldToIIPlus
          (restrictContinuumPointFieldToIIPlus field) =
        restrictContinuumPointFieldToIIPlus field := by
    apply StageNineContinuumPointField.ext <;> rfl
  have contactFieldEq :
      diracDualFormNativeCoframeECContactField final contact =
        restrictContinuumPointFieldToIIPlus
          (toContinuumPointField ec contact) := by
    unfold diracDualFormNativeCoframeECContactField
      diracDualFormNativeCoframeECContactPreparedActual
    rw [toContinuumPointField_restrictHolonomicConfigurationToIIPlus]
    rw [restrictedIdempotent]
    exact congrArg restrictContinuumPointFieldToIIPlus
      (sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_pointField_contact
        source current contact)
  have gaugeEq :=
    sourceActionGeneratedDiracDualCoframeECContactLocalActualLift_gaugeEuler_contact
      source current contact
  have matterEq :=
    sourceActionGeneratedDiracDualCoframeECContactLocalActualLift_matterEuler_contact
      source current contact
  unfold diracDualFormNativeCoframeECContactLoad
  rw [show final.coframe contact = current.coframe contact by
    exact
        sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_coframe_contact
        source current contact]
  rw [contactFieldEq, gaugeEq, matterEq]

/-- Recomputing the action Cartan torsion on the written actual at the same
contact returns the torsion that generated its coframe jet.  This closes the
same-occurrence producer seam; the preceding EC actual is not a second source. -/
theorem
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_actionTorsion_contact
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) :
    diracDualFormNativeActionCartanTorsionAt source
        (sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
          source current contact)
        contact =
      diracDualFormNativeActionCartanTorsionAt source
        (diracDualFormNativeCartanECSynchronizedECActual
          source current contact)
        contact := by
  let final :=
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
      source current contact
  let ec := diracDualFormNativeCartanECSynchronizedECActual
    source current contact
  have pointFieldEquality :
      toContinuumPointField final contact =
        toContinuumPointField ec contact := by
    exact
      sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_pointField_contact
        source current contact
  have coframeEquality : final.coframe contact = ec.coframe contact :=
    congrArg StageNineContinuumPointField.coframe pointFieldEquality
  have spinResponseEquality :
      diracDualFormNativeActionSpinResponseAt source final contact =
        diracDualFormNativeActionSpinResponseAt source ec contact := by
    unfold diracDualFormNativeActionSpinResponseAt
    rw [toContinuumPointField_restrictHolonomicConfigurationToIIPlus,
      toContinuumPointField_restrictHolonomicConfigurationToIIPlus,
      pointFieldEquality]
  unfold diracDualFormNativeActionCartanTorsionAt
  rw [coframeEquality, spinResponseEquality]

/-- Installed torsion and recomputed final-action torsion are definitionally
responsible to the same contact occurrence. -/
theorem
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_actualTorsion_selfGenerated_contact
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) :
    actualPointwiseCartanTorsionTwoForm
        (holonomicCoframeFirstJetAt
          (sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
            source current contact).coframe contact)
        ((sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
          source current contact).gravityConnection contact) =
      diracDualFormNativeActionCartanTorsionAt source
        (sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
          source current contact)
        contact := by
  calc
    _ = diracDualFormNativeActionCartanTorsionAt source
          (diracDualFormNativeCartanECSynchronizedECActual
            source current contact)
          contact :=
      sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_actualTorsion_contact
        source current contact
    _ = _ :=
      (sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_actionTorsion_contact
        source current contact).symm

/-- Contact nondegeneracy is retained literally from the current. -/
theorem
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_contactNondegenerate
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint)
    (nondegenerate : Matrix.det (current.coframe contact) ≠ 0) :
    Matrix.det
        ((sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
          source current contact).coframe contact) ≠ 0 := by
