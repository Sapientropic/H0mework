      diracDualFormNativeCartanECSynchronizedCoframeFirstJet
        source current contact := by
  exact holonomicCoframeFirstJetAt_cartanECSynchronizedCentered_contact _ _

/-- Smoothness of the coframe actually written by the synchronized producer.
This is the fixed-field regularity needed by the same-contact Lorentz
readback, not a generic atlas construction. -/
theorem
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift_coframe_contDiff
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) :
    ContDiff ℝ ∞
      (sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
        source current contact).coframe := by
  change ContDiff ℝ ∞
    (cartanECSynchronizedCenteredAffineCoframeField contact
      (diracDualFormNativeCartanECSynchronizedCoframeFirstJet
        source current contact))
  exact cartanECSynchronizedCenteredAffineCoframeField_contDiff _ _

/-- The installed actual retains the exact typed Cartan torsion generated by
the preceding EC action occurrence. -/
