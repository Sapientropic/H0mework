import H0mework.Physics.CartanAction.CartanConnectionActualization
import H0mework.Physics.CoframeVariation.CoframeECContactLocalActualLift

/-!
# Contact-native synchronized Cartan--EC coframe write

The existing EC contact write generates the primitive gravity connection and
closes the full coframe equation at one nondegenerate contact.  This module
keeps that same connection and integrates the Cartan torsion generated by the
same source/action occurrence into a contact-centered affine coframe first
jet:

```text
(source, current, contact)
  -> EC contact actual
  -> action-generated Cartan torsion of that actual
  -> canonical coframe first jet realizing that torsion
  -> centered affine coframe, B := II+(e), live reaction.
```

The constructor consumes no residual, support, target jet, equation, zero
receipt, inverse witness, branch, or free coefficient.  The factor `1/2` is
forced by antisymmetrization of the ordered torsion components.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeCartanECSynchronizedCoframeContactLocalActualLift

open ProofFreeRicherAnholonomicSource
open StageNineCartanAffineConnectionActualization
open StageNineCartanContorsionTorsionEquiv
open StageNineCoframeFirstJet
open StageNineDiracDualFormNativeCartanConnectionActualization
open StageNineDiracDualFormNativeCoframeLocalVariation
open StageNineDiracDualFormNativeCoframeECContactLocalActualLift
open StageNineEnrichedProofFreeSource
open StageNineFormNativeGravityMultiplierAuxiliaryIntegratedVariation
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineIIPlusRestriction
open StageNineResidualLinearPlebanskiTorsionReduction
open scoped ContDiff Matrix.Norms.Elementwise

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1600000

abbrev diracDualFormNativeCartanECSynchronizedECActual
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) : StageNineHolonomicConfiguration :=
  sourceActionGeneratedDiracDualCoframeECContactLocalActualLift
    source current contact

/-- The canonical coframe first jet whose covariant antisymmetrization is the
Cartan torsion generated from the same EC contact actual. -/
def diracDualFormNativeCartanECSynchronizedCoframeFirstJet
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) : PointwiseLorentzianCoframeJet :=
  let ec := diracDualFormNativeCartanECSynchronizedECActual
    source current contact
  let torsion := diracDualFormNativeActionCartanTorsionAt
    source ec contact
  { coframe := ec.coframe contact
    derivative := fun derivativeDirection internal coordinate =>
      -coframeConnectionAction (ec.gravityConnection contact)
          derivativeDirection (ec.coframe contact) internal coordinate +
        ((1 : ℝ) / 2) *
          orderedCartanTorsionComponent torsion internal
            derivativeDirection coordinate }

/-- Translate the canonical affine jet right inverse to an arbitrary contact.
This is a primitive coframe field, not a family of contact-wise worlds. -/
def cartanECSynchronizedCenteredAffineCoframeField
    (contact : BasePoint)
    (jet : PointwiseLorentzianCoframeJet) :
    BasePoint → LorentzianCoframe :=
  fun point => affineCoframeFieldOfJet jet (point - contact)

@[simp] theorem cartanECSynchronizedCenteredAffineCoframeField_contact
    (contact : BasePoint)
    (jet : PointwiseLorentzianCoframeJet) :
    cartanECSynchronizedCenteredAffineCoframeField contact jet contact =
      jet.coframe := by
  simp [cartanECSynchronizedCenteredAffineCoframeField]

private theorem cartanEC_fderiv_comp_sub_contact
    (field : BasePoint → ℝ)
    (contact : BasePoint)
    (fieldDifferentiable : DifferentiableAt ℝ field 0) :
    fderiv ℝ (fun point => field (point - contact)) contact =
      fderiv ℝ field 0 := by
  have shiftDerivative :
      HasFDerivAt (fun point : BasePoint => point - contact)
        (ContinuousLinearMap.id ℝ BasePoint) contact :=
    hasFDerivAt_sub_const contact
  have fieldDerivativeAtShiftedContact :
      HasFDerivAt field (fderiv ℝ field 0) (contact - contact) := by
    simpa using fieldDifferentiable.hasFDerivAt
  have compositeDerivative :=
    HasFDerivAt.comp (f := fun point : BasePoint => point - contact) contact
      fieldDerivativeAtShiftedContact shiftDerivative
  change
    fderiv ℝ (field ∘ fun point : BasePoint => point - contact) contact =
      fderiv ℝ field 0
  simpa only [ContinuousLinearMap.comp_id] using compositeDerivative.fderiv

/-- Reading the translated affine coframe at its contact recovers the complete
generated first jet, including all mixed and spatial derivatives. -/
theorem holonomicCoframeFirstJetAt_cartanECSynchronizedCentered_contact
    (contact : BasePoint)
    (jet : PointwiseLorentzianCoframeJet) :
    holonomicCoframeFirstJetAt
        (cartanECSynchronizedCenteredAffineCoframeField contact jet) contact =
      jet := by
  apply coframeJet_eq_of_fields_eq
  · exact cartanECSynchronizedCenteredAffineCoframeField_contact contact jet
  · funext derivativeDirection internal coordinate
    unfold holonomicCoframeFirstJetAt
      cartanECSynchronizedCenteredAffineCoframeField
    change
      fderiv ℝ
          (fun point =>
            affineCoframeFieldOfJet jet (point - contact) internal coordinate)
          contact (coordinateDirection derivativeDirection) =
        jet.derivative derivativeDirection internal coordinate
    rw [congrArg
      (fun derivative : BasePoint →L[ℝ] ℝ =>
        derivative (coordinateDirection derivativeDirection))
      (cartanEC_fderiv_comp_sub_contact
        (fun point => affineCoframeFieldOfJet jet point internal coordinate)
        contact
        ((affineCoframeFieldOfJet_componentwiseSmooth jet internal coordinate
          ).differentiable (by simp)).differentiableAt)]
    exact affineCoframeFieldOfJet_directionalDerivative jet 0
      derivativeDirection internal coordinate

/-- The translated affine right inverse is a globally smooth primitive
coframe field.  No regularity premise on the incoming current is needed for
this written field. -/
theorem cartanECSynchronizedCenteredAffineCoframeField_contDiff
    (contact : BasePoint)
    (jet : PointwiseLorentzianCoframeJet) :
    ContDiff ℝ ∞
      (cartanECSynchronizedCenteredAffineCoframeField contact jet) := by
  apply contDiff_pi'
  intro internal
  apply contDiff_pi'
  intro coordinate
  exact
    (affineCoframeFieldOfJet_componentwiseSmooth jet internal coordinate).comp
      (contDiff_id.sub contDiff_const)

/-- Algebraic producer soundness: the generated first jet realizes exactly
the source/action-generated typed Cartan torsion of the EC contact actual. -/
theorem
    diracDualFormNativeCartanECSynchronizedCoframeFirstJet_actualTorsion
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) :
    actualPointwiseCartanTorsionTwoForm
        (diracDualFormNativeCartanECSynchronizedCoframeFirstJet
          source current contact)
        ((diracDualFormNativeCartanECSynchronizedECActual
          source current contact).gravityConnection contact) =
      diracDualFormNativeActionCartanTorsionAt source
        (diracDualFormNativeCartanECSynchronizedECActual
          source current contact)
        contact := by
  ext spacetimePair internal
  unfold actualPointwiseCartanTorsionTwoForm pointwiseCartanTorsion
    pointwiseCoframeCovariantDerivative
    diracDualFormNativeCartanECSynchronizedCoframeFirstJet
  dsimp only
  let torsion := diracDualFormNativeActionCartanTorsionAt source
    (diracDualFormNativeCartanECSynchronizedECActual
      source current contact) contact
  have forward :
      orderedCartanTorsionComponent torsion internal
          (pairFirst spacetimePair) (pairSecond spacetimePair) =
        torsion spacetimePair internal :=
    orderedCartanTorsionComponent_canonical torsion internal spacetimePair
  have reverse :
      orderedCartanTorsionComponent torsion internal
          (pairSecond spacetimePair) (pairFirst spacetimePair) =
        -torsion spacetimePair internal := by
    rw [orderedCartanTorsionComponent_antisymm, forward]
  change _ = torsion spacetimePair internal
  rw [forward, reverse]
  ring

/-- First install the generated affine coframe and recompute the computed
`II+` auxiliary while preserving the EC primitive connection. -/
def diracDualFormNativeCartanECSynchronizedCoframePreparedActual
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) : StageNineHolonomicConfiguration :=
  let ec := diracDualFormNativeCartanECSynchronizedECActual
    source current contact
  let coframe := cartanECSynchronizedCenteredAffineCoframeField contact
    (diracDualFormNativeCartanECSynchronizedCoframeFirstJet
      source current contact)
  { ec with
    coframe := coframe
    gravityAuxiliary := fun point =>
      physicalIIPlusBivector (coframe point) }

/-- Live gravity reaction read only after the synchronized coframe and
computed-`II+` fields have been installed. -/
def diracDualFormNativeCartanECSynchronizedCoframeReactionField
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) : BasePoint → PhysicalBivector :=
  formNativeGravityReactionField
    (diracDualFormNativeCartanECSynchronizedCoframePreparedActual
      source current contact)

/-- Public source/current/contact-only synchronized Cartan--EC write.  The
gravity reaction is recomputed only after the coframe and `II+` writes exist. -/
def sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) : StageNineHolonomicConfiguration :=
  let prepared :=
    diracDualFormNativeCartanECSynchronizedCoframePreparedActual
      source current contact
  { prepared with
    gravitySimplicityMultiplier :=
      diracDualFormNativeCartanECSynchronizedCoframeReactionField
        source current contact }

/-- The public synchronized write exposes the live reaction installed after
its coframe and computed-`II+` auxiliary have both been generated. -/
