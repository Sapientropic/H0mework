import H0mework.Physics.ADCRuntime.LoadedReceiverStep
import H0mework.Physics.ADCRuntime.Continuation

/-! # The loaded physical step reuses the rooted finite-exposure engine -/

set_option autoImplicit false

namespace SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical
namespace Netlist.Dissipative.Dimensioned.Driven.Producer

open Std.Sat Units.Interface Cells.Conductance Cells.Storage
open Netlist.Dissipative.Dimensioned.Driven.Interface
open SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot

noncomputable section
namespace FiniteADCWholeJointCurrent

variable {β : Type} [DecidableEq β] [Hashable β]
variable {hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource}
  {technology : AIGCellTechnology} {actualBoot : FiniteDimensionedSeriesRLCPortState}
variable (downstreamTechnology : AIGCellTechnology) (downstreamGraph : AIG β)
variable (seed : FiniteADCWholeJointCurrent hardware
  (loadedReceiverInstalledMaxTick hardware technology actualBoot) technology)

def loadedAfter (frames : Nat) : FiniteADCWholeJointCurrent hardware
    (loadedReceiverInstalledMaxTick hardware technology actualBoot) technology :=
  ((loadedStep downstreamTechnology downstreamGraph)^[frames]) seed

@[simp] theorem loadedAfter_zero :
    loadedAfter downstreamTechnology downstreamGraph seed 0 = seed := rfl

theorem loadedAfter_succ (frames : Nat) :
    loadedAfter downstreamTechnology downstreamGraph seed (frames + 1) =
      loadedStep downstreamTechnology downstreamGraph
        (loadedAfter downstreamTechnology downstreamGraph seed frames) :=
  Function.iterate_succ_apply' _ _ _

def loadedExposure (frames : Nat) : RootedAccountedUnfolding
    (FiniteADCWholeJointCurrent hardware
      (loadedReceiverInstalledMaxTick hardware technology actualBoot) technology) :=
  RootedAccountedUnfolding.observe
    (fun current => .zero (loadedStep downstreamTechnology downstreamGraph current)) seed frames

theorem loadedExposure_frontier (frames : Nat) :
    (loadedExposure downstreamTechnology downstreamGraph seed frames).frontier =
      [loadedAfter downstreamTechnology downstreamGraph seed frames] :=
  rootedUnaryObservation_frontier (loadedStep downstreamTechnology downstreamGraph) seed frames

theorem loadedExposure_frontier_nonempty (frames : Nat) :
    (loadedExposure downstreamTechnology downstreamGraph seed frames).frontier ≠ [] :=
  RootedAccountedUnfolding.frontier_ne_nil _

theorem loadedAfter_receives_own_recorded_sample (frames : Nat) :
    (loadedAfter downstreamTechnology downstreamGraph seed frames).physicalRead
      downstreamTechnology downstreamGraph =
        some (some (loadedAfter downstreamTechnology downstreamGraph seed frames).plant.val.drive) :=
  physicalRead_received _ _ _

theorem loadedAfter_generates_sample (frames : Nat) :
    SourceGeneratedFiniteADCClockedNoisyMeteredSynchronousSampleAt
      (finiteADCPhysicalCurrentSource
        (loadedAfter downstreamTechnology downstreamGraph seed frames).plant)
      (loadedAfter downstreamTechnology downstreamGraph seed frames).plant.val.drive :=
  finiteADCPhysicalCurrent_generates_receipt _

theorem loadedAfter_no_recipient_reset (frames : Nat) :
    finiteADCPhysicalStateAt (loadedAfter downstreamTechnology downstreamGraph seed (frames + 1)).plant 0 =
      (commonRecoveryTarget downstreamTechnology downstreamGraph
        (loadedAfter downstreamTechnology downstreamGraph seed frames)).2 := by
  rw [loadedAfter_succ]
  exact loadedStep_no_recipient_reset _ _ _

theorem loadedAfter_no_memory_reset (frames : Nat)
    (node : Fin (aigOutputBank (receiverWholeGraph hardware.adcCode
      (loadedReceiverInstalledClockBits hardware technology actualBoot))).aig.decls.size) (polarity : Bool) :
    (loadedAfter downstreamTechnology downstreamGraph seed (frames + 1)).receiverStateAt
      downstreamTechnology downstreamGraph node polarity 0 =
        loadedReceiverAwaitingStateAt downstreamTechnology downstreamGraph
          (loadedAfter downstreamTechnology downstreamGraph seed frames) node polarity
          (loadedReceiverSnapshotDelay downstreamTechnology downstreamGraph
            (loadedAfter downstreamTechnology downstreamGraph seed frames)).value := by
  rw [loadedAfter_succ]
  exact loadedStep_no_memory_reset _ _ _ _ _

theorem loadedAfter_changes_current (frames : Nat) :
    loadedAfter downstreamTechnology downstreamGraph seed (frames + 1) ≠
      loadedAfter downstreamTechnology downstreamGraph seed frames := by
  rw [loadedAfter_succ]
  exact loadedStep_changes_current _ _ _

/-- Only the initial current and requested finite depth are inputs; each next
sample, complete memory and schedule proof is generated by the loaded step. -/
theorem loaded_arbitrary_finite_horizon (frames : Nat) :
    ∃ current : FiniteADCWholeJointCurrent hardware
        (loadedReceiverInstalledMaxTick hardware technology actualBoot) technology,
      (loadedExposure downstreamTechnology downstreamGraph seed frames).frontier = [current] ∧
      current.physicalRead downstreamTechnology downstreamGraph = some (some current.plant.val.drive) ∧
      SourceGeneratedFiniteADCClockedNoisyMeteredSynchronousSampleAt
        (finiteADCPhysicalCurrentSource current.plant) current.plant.val.drive ∧
      finiteADCPhysicalStateAt (loadedStep downstreamTechnology downstreamGraph current).plant 0 =
        (commonRecoveryTarget downstreamTechnology downstreamGraph current).2 ∧
      (∀ node polarity,
        (loadedStep downstreamTechnology downstreamGraph current).receiverStateAt
          downstreamTechnology downstreamGraph node polarity 0 =
            loadedReceiverAwaitingStateAt downstreamTechnology downstreamGraph current node polarity
              (loadedReceiverSnapshotDelay downstreamTechnology downstreamGraph current).value) ∧
      loadedStep downstreamTechnology downstreamGraph current ≠ current := by
  exact ⟨loadedAfter downstreamTechnology downstreamGraph seed frames,
    loadedExposure_frontier _ _ _ _, loadedAfter_receives_own_recorded_sample _ _ _ _,
    loadedAfter_generates_sample _ _ _ _, loadedStep_no_recipient_reset _ _ _,
    loadedStep_no_memory_reset _ _ _, loadedStep_changes_current _ _ _⟩

end FiniteADCWholeJointCurrent
end
end Netlist.Dissipative.Dimensioned.Driven.Producer
end SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical

