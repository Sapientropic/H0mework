import H0mework.Physics.ADCRuntime.ProcessingTime

/-!
# Physical endpoint residuals for endpoint-seeded ADC successors

Every completed ADC run has an adaptively generated settling time.  Its
pre-noise resistor and inductor errors are therefore uniformly small even
when the incoming physical initial state is large.  The same-drive KVL then
recovers the capacitor-voltage error.  This first layer exposes the physical
periodic and endpoint residual bounds used by the successor-coordinate layer.
-/

set_option autoImplicit false

namespace SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical
namespace Netlist.Dissipative.Dimensioned.Driven.Producer

open Physical.Interface
open Netlist.Dissipative.Producer
open Netlist.Dissipative.Dimensioned.Producer
open Netlist.Dissipative.Dimensioned.Driven.Interface
open Physical.Units.Interface

noncomputable section

def finiteADCCorePhysicalSource (core : ResonantDrivenCoreSource) :
    DimensionedSeriesRLCSource :=
  resonantDrivenCoreDimensionedSource core

def finiteADCCoreDimensionedRun (core : ResonantDrivenCoreSource) :
    FiniteDimensionedSeriesRLCNetlistRunOccurrence :=
  compileFiniteDimensionedSeriesRLCNetlistRun (finiteADCCorePhysicalSource core)

def finiteADCCoreNormalizedRun (core : ResonantDrivenCoreSource) :
    FiniteSeriesRLCNetlistRunOccurrence :=
  compileFiniteSeriesRLCNetlistRun (finiteADCCorePhysicalSource core).1

/-- The actual `(V,I)` endpoint generated by one source and one command. -/
def finiteADCGeneratedPhysicalEndpointAt
    (source : FiniteADCClockedNoisyMeteredSynchronousFixtureSource)
    (drive : FiniteBinaryDrive) (processingTicks : Nat := 0) :
    FiniteDimensionedSeriesRLCPortState :=
  let core := source.meteredSource.fixture.coreSource
  drivenTotalPortStateAt
    (finiteADCCorePhysicalSource core)
    (sourceOwnedResonantDrivenFrequencyAt core)
    (sourceOwnedResonantDrivenDriveAt core (binaryDriveState drive))
    source.meteredSource.fixture.initial
    (finiteADCClockedSwitchTime source drive processingTicks)

def finiteADCClockedNormalizedLegErrorAt
    (source : FiniteADCClockedNoisyMeteredSynchronousFixtureSource)
    (drive : FiniteBinaryDrive) (leg : SynchronousSenseLeg)
    (channel : FiniteEmbodimentChannel) (processingTicks : Nat := 0) : ℝ :=
  match leg with
  | .resistor =>
      resonantNormalizedResistorErrorAt
        source.meteredSource.fixture.coreSource (binaryDriveState drive)
        source.meteredSource.fixture.initial channel
        (finiteADCClockedSwitchTime source drive processingTicks)
  | .inductor =>
      resonantNormalizedInductorErrorAt
        source.meteredSource.fixture.coreSource (binaryDriveState drive)
        source.meteredSource.fixture.initial channel
        (finiteADCClockedSwitchTime source drive processingTicks)

theorem finiteADCClockedTransientTolerance_lt_eighth
    (source : FiniteADCClockedNoisyMeteredSynchronousFixtureSource) :
    finiteADCClockedTransientTolerance source < (1 : ℝ) / 8 := by
  have noiseNonnegative := finiteHalfPowerBandNoiseBudget_nonneg
    source.meteredSource.noiseCode
  have adcPositive := finiteADCWholeHilbertBudget_pos
  unfold finiteADCClockedTransientTolerance
  linarith

/-- This is the actual circuit error before band noise, affine metrology and
ADC quantization are added. -/
theorem finiteADCClockedNormalizedLegError_abs_lt_eighth
    (source : FiniteADCClockedNoisyMeteredSynchronousFixtureSource)
    (drive : FiniteBinaryDrive) (leg : SynchronousSenseLeg)
    (channel : FiniteEmbodimentChannel) (processingTicks : Nat := 0) :
    |finiteADCClockedNormalizedLegErrorAt
        source drive leg channel processingTicks| <
      (1 : ℝ) / 8 := by
  have transient := resonantSynchronous_afterGeneratedDurationFor_error_lt
    (finiteADCClockedTransientTolerance source)
    (finiteADCClockedTransientTolerance_pos source)
    source.meteredSource.fixture.coreSource (binaryDriveState drive)
    source.meteredSource.fixture.initial
    (finiteADCClockedSwitchTime source drive processingTicks)
    (finiteADCClocked_required_le_switchTime source drive processingTicks)
  rw [resonantActualSynchronousHilbertError_eq_stateError] at transient
  have coordinate := resonantNormalizedError_abs_le_hilbertNorm
    source.meteredSource.fixture.coreSource (binaryDriveState drive)
    source.meteredSource.fixture.initial leg channel
    (finiteADCClockedSwitchTime source drive processingTicks)
  exact lt_of_le_of_lt coordinate
    (lt_trans transient (finiteADCClockedTransientTolerance_lt_eighth source))

/-- At resonance the drive and resistor component coincide, so the periodic
capacitor and inductor voltages cancel exactly. -/
theorem resonantPeriodicCapacitorVoltage_eq_neg_inductor
    (core : ResonantDrivenCoreSource) (input : FiniteEmbodimentState)
    (channel : FiniteEmbodimentChannel) (physicalTime : SISecond) :
    drivenPeriodicVoltageAt (finiteADCCorePhysicalSource core) channel
        (sourceOwnedResonantDrivenFrequencyAt core channel)
        (sourceOwnedResonantDrivenDriveAt core input channel) physicalTime =
      -resonantPeriodicInductorVoltageAt
        core input channel physicalTime := by
  have kvlValue := congrArg SIQuantity.value
    (drivenPeriodic_forcedKirchhoffVoltageLaw
      (finiteADCCorePhysicalSource core) channel
      (sourceOwnedResonantDrivenFrequencyAt core channel)
      (sourceOwnedResonantDrivenFrequencyAt_positive core channel)
      (sourceOwnedResonantDrivenDriveAt core input channel) physicalTime)
  have resistorValue := congrArg SIQuantity.value
    (resonantPeriodicResistorVoltage_eq_driveWaveform
      core input channel physicalTime)
  apply SIQuantity.ext
  unfold resonantPeriodicInductorVoltageAt at kvlValue ⊢
  unfold resonantPeriodicResistorVoltageAt at resistorValue
  simp only [inductanceTimesCurrentRate_value,
    resistanceTimesCurrent_value, SIQuantity.add_value,
    SIQuantity.neg_value] at kvlValue resistorValue ⊢
  simp only [finiteADCCorePhysicalSource] at kvlValue ⊢
  linear_combination kvlValue - resistorValue

def finiteADCSuccessorInductorRatioAt
    (core : ResonantDrivenCoreSource)
    (channel : FiniteEmbodimentChannel) : ℝ :=
  resonantInductorVoltageRatioAt (finiteADCCorePhysicalSource core) channel

theorem finiteADCSuccessorInductorRatio_pos
    (core : ResonantDrivenCoreSource)
    (channel : FiniteEmbodimentChannel) :
    0 < finiteADCSuccessorInductorRatioAt core channel :=
  resonantInductorVoltageRatio_pos _ _

theorem resonantPeriodicBinaryDriveCapacitor_normalized_abs_le
    (core : ResonantDrivenCoreSource) (drive : FiniteBinaryDrive)
    (channel : FiniteEmbodimentChannel) (physicalTime : SISecond) :
    |(drivenPeriodicVoltageAt (finiteADCCorePhysicalSource core) channel
          (sourceOwnedResonantDrivenFrequencyAt core channel)
          (sourceOwnedResonantDrivenDriveAt core (binaryDriveState drive) channel)
          physicalTime).value /
        core.2.voltageScale.value| ≤
      finiteADCSuccessorInductorRatioAt core channel := by
  rw [resonantPeriodicCapacitorVoltage_eq_neg_inductor]
  have legBound := resonantPeriodicBinaryDriveLeg_abs_le_one
    core drive .inductor channel physicalTime
  change
    |resonantPeriodicNormalizedInductorAt core (binaryDriveState drive)
      channel physicalTime| ≤ 1 at legBound
  have ratioPos := finiteADCSuccessorInductorRatio_pos core channel
  have ratioNe :
      resonantInductorVoltageRatioAt
          (resonantDrivenCoreDimensionedSource core) channel ≠ 0 :=
    ne_of_gt (resonantInductorVoltageRatio_pos _ _)
  have normalized :
      (-resonantPeriodicInductorVoltageAt core (binaryDriveState drive)
          channel physicalTime).value / core.2.voltageScale.value =
        -resonantPeriodicNormalizedInductorAt core (binaryDriveState drive)
            channel physicalTime *
          finiteADCSuccessorInductorRatioAt core channel := by
    unfold resonantPeriodicNormalizedInductorAt
      resonantInductorOutputScaleAt finiteADCSuccessorInductorRatioAt
      finiteADCCorePhysicalSource
    simp only [SIQuantity.neg_value, SIQuantity.smul_value]
    simp only [resonantDrivenCoreDimensionedSource] at ratioNe ⊢
    field_simp [core.2.voltageScale_ne, ratioNe]
  rw [normalized, abs_mul, abs_neg, abs_of_pos ratioPos]
  nlinarith

def finiteADCSuccessorResistanceAt
    (core : ResonantDrivenCoreSource)
    (channel : FiniteEmbodimentChannel) : SIOhm :=
  (finiteADCCoreDimensionedRun core).seriesResistanceAt channel

theorem finiteADCSuccessorResistance_pos
    (core : ResonantDrivenCoreSource)
    (channel : FiniteEmbodimentChannel) :
    0 < (finiteADCSuccessorResistanceAt core channel).value :=
  compiledFiniteDimensionedSeriesRLC_resistance_pos _ _

def finiteADCSuccessorPeriodicCurrentRatioBoundAt
    (core : ResonantDrivenCoreSource)
    (channel : FiniteEmbodimentChannel) : ℝ :=
  core.2.voltageScale.value /
    ((finiteADCSuccessorResistanceAt core channel).value *
      core.2.currentScale.value)

theorem finiteADCSuccessorPeriodicCurrentRatioBound_pos
    (core : ResonantDrivenCoreSource)
    (channel : FiniteEmbodimentChannel) :
    0 < finiteADCSuccessorPeriodicCurrentRatioBoundAt core channel := by
  unfold finiteADCSuccessorPeriodicCurrentRatioBoundAt
  exact div_pos core.2.voltageScalePositive
    (mul_pos (finiteADCSuccessorResistance_pos core channel)
      core.2.currentScalePositive)

theorem resonantPeriodicBinaryDriveCurrent_normalized_abs_le
    (core : ResonantDrivenCoreSource) (drive : FiniteBinaryDrive)
    (channel : FiniteEmbodimentChannel) (physicalTime : SISecond) :
    |(drivenPeriodicCurrentAt (finiteADCCorePhysicalSource core) channel
          (sourceOwnedResonantDrivenFrequencyAt core channel)
          (sourceOwnedResonantDrivenDriveAt core (binaryDriveState drive) channel)
          physicalTime).value / core.2.currentScale.value| ≤
      finiteADCSuccessorPeriodicCurrentRatioBoundAt core channel := by
  have legBound := resonantPeriodicBinaryDriveLeg_abs_le_one
    core drive .resistor channel physicalTime
  change
    |resonantPeriodicNormalizedResistorAt core (binaryDriveState drive)
      channel physicalTime| ≤ 1 at legBound
  have factorPos := finiteADCSuccessorPeriodicCurrentRatioBound_pos core channel
  have resistanceNe := ne_of_gt (finiteADCSuccessorResistance_pos core channel)
  have normalized :
      (drivenPeriodicCurrentAt (finiteADCCorePhysicalSource core) channel
          (sourceOwnedResonantDrivenFrequencyAt core channel)
          (sourceOwnedResonantDrivenDriveAt core (binaryDriveState drive) channel)
          physicalTime).value / core.2.currentScale.value =
        resonantPeriodicNormalizedResistorAt core (binaryDriveState drive)
            channel physicalTime *
          finiteADCSuccessorPeriodicCurrentRatioBoundAt core channel := by
    unfold resonantPeriodicNormalizedResistorAt
      resonantPeriodicResistorVoltageAt
      finiteADCSuccessorPeriodicCurrentRatioBoundAt
      finiteADCSuccessorResistanceAt finiteADCCoreDimensionedRun
      finiteADCCorePhysicalSource
    simp only [resistanceTimesCurrent_value]
    unfold finiteADCSuccessorResistanceAt finiteADCCoreDimensionedRun
      finiteADCCorePhysicalSource at resistanceNe
    simp only [resonantDrivenCoreDimensionedSource] at resistanceNe ⊢
    field_simp [core.2.voltageScale_ne, core.2.currentScale_ne, resistanceNe]
  rw [normalized, abs_mul, abs_of_pos factorPos]
  nlinarith

theorem finiteADCGeneratedEndpoint_currentError_normalized_abs_lt
    (source : FiniteADCClockedNoisyMeteredSynchronousFixtureSource)
    (drive : FiniteBinaryDrive) (channel : FiniteEmbodimentChannel)
    (processingTicks : Nat := 0) :
    let core := source.meteredSource.fixture.coreSource
    let physicalSource := finiteADCCorePhysicalSource core
    let physicalTime := finiteADCClockedSwitchTime source drive processingTicks
    |((finiteADCGeneratedPhysicalEndpointAt
          source drive processingTicks).currentAt channel -
          drivenPeriodicCurrentAt physicalSource channel
            (sourceOwnedResonantDrivenFrequencyAt core channel)
            (sourceOwnedResonantDrivenDriveAt core
              (binaryDriveState drive) channel) physicalTime).value /
        core.2.currentScale.value| <
      (1 : ℝ) / 8 *
        finiteADCSuccessorPeriodicCurrentRatioBoundAt core channel := by
  dsimp only
  let core := source.meteredSource.fixture.coreSource
  have error := finiteADCClockedNormalizedLegError_abs_lt_eighth
    source drive .resistor channel processingTicks
  change
    |resonantNormalizedResistorErrorAt core (binaryDriveState drive)
      source.meteredSource.fixture.initial channel
      (finiteADCClockedSwitchTime source drive processingTicks)| <
        (1 : ℝ) / 8 at error
  have factorPos := finiteADCSuccessorPeriodicCurrentRatioBound_pos core channel
  have resistanceNe := ne_of_gt (finiteADCSuccessorResistance_pos core channel)
  have normalized :
      ((finiteADCGeneratedPhysicalEndpointAt
            source drive processingTicks).currentAt channel -
          drivenPeriodicCurrentAt (finiteADCCorePhysicalSource core) channel
            (sourceOwnedResonantDrivenFrequencyAt core channel)
            (sourceOwnedResonantDrivenDriveAt core
              (binaryDriveState drive) channel)
            (finiteADCClockedSwitchTime source drive processingTicks)).value /
          core.2.currentScale.value =
        resonantNormalizedResistorErrorAt core (binaryDriveState drive)
            source.meteredSource.fixture.initial channel
            (finiteADCClockedSwitchTime source drive processingTicks) *
          finiteADCSuccessorPeriodicCurrentRatioBoundAt core channel := by
    unfold finiteADCGeneratedPhysicalEndpointAt
      resonantNormalizedResistorErrorAt
      resonantActualNormalizedResistorAt
      resonantPeriodicNormalizedResistorAt
      resonantActualResistorVoltageAt resonantPeriodicResistorVoltageAt
      finiteADCSuccessorPeriodicCurrentRatioBoundAt
      finiteADCSuccessorResistanceAt finiteADCCoreDimensionedRun
      finiteADCCorePhysicalSource
    simp only [drivenTotalPortStateAt, SIQuantity.sub_value,
      resistanceTimesCurrent_value]
    unfold finiteADCSuccessorResistanceAt finiteADCCoreDimensionedRun
      finiteADCCorePhysicalSource at resistanceNe
    simp only [resonantDrivenCoreDimensionedSource] at resistanceNe ⊢
    field_simp [core.2.voltageScale_ne, core.2.currentScale_ne, resistanceNe]
    ring
  rw [normalized, abs_mul, abs_of_pos factorPos]
  nlinarith

theorem finiteADCGeneratedEndpoint_voltageError_normalized_abs_lt
    (source : FiniteADCClockedNoisyMeteredSynchronousFixtureSource)
    (drive : FiniteBinaryDrive) (channel : FiniteEmbodimentChannel)
    (processingTicks : Nat := 0) :
    let core := source.meteredSource.fixture.coreSource
    let physicalSource := finiteADCCorePhysicalSource core
    let physicalTime := finiteADCClockedSwitchTime source drive processingTicks
    |((finiteADCGeneratedPhysicalEndpointAt
          source drive processingTicks).voltageAt channel -
          drivenPeriodicVoltageAt physicalSource channel
            (sourceOwnedResonantDrivenFrequencyAt core channel)
            (sourceOwnedResonantDrivenDriveAt core
              (binaryDriveState drive) channel) physicalTime).value /
        core.2.voltageScale.value| <
      (1 + finiteADCSuccessorInductorRatioAt core channel) / 8 := by
  dsimp only
  let core := source.meteredSource.fixture.coreSource
  let physicalTime := finiteADCClockedSwitchTime source drive processingTicks
  have resistorError := finiteADCClockedNormalizedLegError_abs_lt_eighth
    source drive .resistor channel processingTicks
  have inductorError := finiteADCClockedNormalizedLegError_abs_lt_eighth
    source drive .inductor channel processingTicks
  have ratioPos := finiteADCSuccessorInductorRatio_pos core channel
  have ratioNe :
      resonantInductorVoltageRatioAt
          (resonantDrivenCoreDimensionedSource core) channel ≠ 0 :=
    ne_of_gt (resonantInductorVoltageRatio_pos _ _)
  have kvlValue := congrArg SIQuantity.value
    (resonantActualInductor_sub_periodic_eq
      core (binaryDriveState drive) source.meteredSource.fixture.initial
      channel physicalTime)
  have voltageRaw :
      (drivenTotalVoltageAt (resonantDrivenCoreDimensionedSource core)
            (sourceOwnedResonantDrivenFrequencyAt core)
            (sourceOwnedResonantDrivenDriveAt core (binaryDriveState drive))
            source.meteredSource.fixture.initial channel physicalTime -
          drivenPeriodicVoltageAt (resonantDrivenCoreDimensionedSource core) channel
            (sourceOwnedResonantDrivenFrequencyAt core channel)
            (sourceOwnedResonantDrivenDriveAt core
              (binaryDriveState drive) channel) physicalTime).value =
        -(resonantActualResistorVoltageAt core (binaryDriveState drive)
            source.meteredSource.fixture.initial channel physicalTime -
          resonantPeriodicResistorVoltageAt core (binaryDriveState drive)
            channel physicalTime).value -
        (resonantActualInductorVoltageAt core (binaryDriveState drive)
            source.meteredSource.fixture.initial channel physicalTime -
          resonantPeriodicInductorVoltageAt core (binaryDriveState drive)
            channel physicalTime).value := by
    simp only [SIQuantity.sub_value, SIQuantity.neg_value] at kvlValue ⊢
    linarith
  have resistorNormalized :
      (resonantActualResistorVoltageAt core (binaryDriveState drive)
            source.meteredSource.fixture.initial channel physicalTime -
          resonantPeriodicResistorVoltageAt core (binaryDriveState drive)
            channel physicalTime).value / core.2.voltageScale.value =
        finiteADCClockedNormalizedLegErrorAt
          source drive .resistor channel processingTicks := by
    unfold finiteADCClockedNormalizedLegErrorAt
      resonantNormalizedResistorErrorAt
      resonantActualNormalizedResistorAt resonantPeriodicNormalizedResistorAt
    simp only [SIQuantity.sub_value, physicalTime, core]
    field_simp [source.meteredSource.fixture.coreSource.2.voltageScale_ne]
  have inductorNormalized :
      (resonantActualInductorVoltageAt core (binaryDriveState drive)
            source.meteredSource.fixture.initial channel physicalTime -
          resonantPeriodicInductorVoltageAt core (binaryDriveState drive)
            channel physicalTime).value / core.2.voltageScale.value =
        finiteADCClockedNormalizedLegErrorAt
            source drive .inductor channel processingTicks *
          finiteADCSuccessorInductorRatioAt core channel := by
    unfold finiteADCClockedNormalizedLegErrorAt
      resonantNormalizedInductorErrorAt
      resonantActualNormalizedInductorAt resonantPeriodicNormalizedInductorAt
      resonantInductorOutputScaleAt finiteADCSuccessorInductorRatioAt
      finiteADCCorePhysicalSource
    simp only [SIQuantity.sub_value, SIQuantity.smul_value, physicalTime, core]
    simp only [resonantDrivenCoreDimensionedSource] at ratioNe ⊢
    field_simp [source.meteredSource.fixture.coreSource.2.voltageScale_ne, ratioNe]
    rw [mul_div_cancel_right₀ _ ratioNe]
  have normalized :
      ((finiteADCGeneratedPhysicalEndpointAt
            source drive processingTicks).voltageAt channel -
          drivenPeriodicVoltageAt (finiteADCCorePhysicalSource core) channel
            (sourceOwnedResonantDrivenFrequencyAt core channel)
            (sourceOwnedResonantDrivenDriveAt core
              (binaryDriveState drive) channel) physicalTime).value /
          core.2.voltageScale.value =
        -finiteADCClockedNormalizedLegErrorAt
            source drive .resistor channel processingTicks -
          finiteADCClockedNormalizedLegErrorAt
              source drive .inductor channel processingTicks *
            finiteADCSuccessorInductorRatioAt core channel := by
    unfold finiteADCGeneratedPhysicalEndpointAt
    simp only [drivenTotalPortStateAt]
    simp only [finiteADCCorePhysicalSource, core, physicalTime]
    rw [voltageRaw]
    rw [show
      (-(resonantActualResistorVoltageAt core (binaryDriveState drive)
              source.meteredSource.fixture.initial channel physicalTime -
            resonantPeriodicResistorVoltageAt core (binaryDriveState drive)
              channel physicalTime).value -
          (resonantActualInductorVoltageAt core (binaryDriveState drive)
              source.meteredSource.fixture.initial channel physicalTime -
            resonantPeriodicInductorVoltageAt core (binaryDriveState drive)
              channel physicalTime).value) / core.2.voltageScale.value =
        -((resonantActualResistorVoltageAt core (binaryDriveState drive)
              source.meteredSource.fixture.initial channel physicalTime -
            resonantPeriodicResistorVoltageAt core (binaryDriveState drive)
              channel physicalTime).value / core.2.voltageScale.value) -
          ((resonantActualInductorVoltageAt core (binaryDriveState drive)
              source.meteredSource.fixture.initial channel physicalTime -
            resonantPeriodicInductorVoltageAt core (binaryDriveState drive)
              channel physicalTime).value / core.2.voltageScale.value) by ring]
    rw [resistorNormalized, inductorNormalized]
  rw [normalized]
  have resistorError' :
      |finiteADCClockedNormalizedLegErrorAt
          source drive .resistor channel processingTicks| <
        (1 : ℝ) / 8 := resistorError
  have inductorError' :
      |finiteADCClockedNormalizedLegErrorAt
          source drive .inductor channel processingTicks| <
        (1 : ℝ) / 8 := inductorError
  calc
    |-finiteADCClockedNormalizedLegErrorAt
          source drive .resistor channel processingTicks -
        finiteADCClockedNormalizedLegErrorAt
            source drive .inductor channel processingTicks *
          finiteADCSuccessorInductorRatioAt core channel| ≤
      |-finiteADCClockedNormalizedLegErrorAt
          source drive .resistor channel processingTicks| +
        |-(finiteADCClockedNormalizedLegErrorAt
            source drive .inductor channel processingTicks *
          finiteADCSuccessorInductorRatioAt core channel)| := abs_add_le _ _
    _ = |finiteADCClockedNormalizedLegErrorAt
          source drive .resistor channel processingTicks| +
        |finiteADCClockedNormalizedLegErrorAt
            source drive .inductor channel processingTicks| *
          finiteADCSuccessorInductorRatioAt core channel := by
      rw [abs_neg, abs_neg, abs_mul, abs_of_pos ratioPos]
    _ < (1 : ℝ) / 8 + (1 : ℝ) / 8 *
        finiteADCSuccessorInductorRatioAt core channel := by
      exact add_lt_add resistorError'
        (mul_lt_mul_of_pos_right inductorError' ratioPos)
    _ = (1 + finiteADCSuccessorInductorRatioAt core channel) / 8 := by ring

end

end Netlist.Dissipative.Dimensioned.Driven.Producer
end SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical
