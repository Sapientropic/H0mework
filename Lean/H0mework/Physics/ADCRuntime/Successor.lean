import H0mework.Computation.ADCWire.EnergyWireReceiver

/-!
# Actual endpoint-seeded ADC physical successors

A runtime current stores one generated physical run. The immutable template
fixes its RLC core, noise, metrology, ADC and clock codes. Its next initial
state is the current run's actual capacitor-voltage/inductor-current endpoint;
the next command is generated by complementing the recorded receiver output.
No initial-state reset or completed future table is part of the step.
-/

set_option autoImplicit false

namespace SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical
namespace Netlist.Dissipative.Dimensioned.Driven.Producer

open Physical.Interface
open Netlist.Dissipative.Dimensioned.Driven.Interface
open Physical.Units.Interface

/-- Reopen the same source template at one actual physical state. -/
def finiteADCFixtureWithInitial
    (hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource)
    (initial : FiniteDimensionedSeriesRLCPortState) :
    FiniteADCClockedNoisyMeteredSynchronousFixtureSource :=
  { hardware with
    meteredSource := { hardware.meteredSource with
      fixture := { hardware.meteredSource.fixture with initial := initial } } }

@[simp] theorem finiteADCFixtureWithInitial_idempotent
    (hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource)
    (left right : FiniteDimensionedSeriesRLCPortState) :
    finiteADCFixtureWithInitial (finiteADCFixtureWithInitial hardware left) right =
      finiteADCFixtureWithInitial hardware right := rfl

/-- The current is the literal generated run, not a separately certified endpoint shell. -/
abbrev FiniteADCPhysicalRuntimeCurrent
    (hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource) :=
  { run : FiniteADCClockedNoisyMeteredSynchronousSampleOccurrence //
    run = compileFiniteADCClockedNoisyMeteredSynchronousSample
      (finiteADCFixtureWithInitial hardware run.initial) run.drive }

noncomputable def startFiniteADCPhysicalRuntime
    (hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource)
    (initial : FiniteDimensionedSeriesRLCPortState) (drive : FiniteBinaryDrive) :
    FiniteADCPhysicalRuntimeCurrent hardware :=
  ⟨compileFiniteADCClockedNoisyMeteredSynchronousSample
    (finiteADCFixtureWithInitial hardware initial) drive, rfl⟩

def finiteADCPhysicalCurrentSource
    {hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource}
    (current : FiniteADCPhysicalRuntimeCurrent hardware) :=
  finiteADCFixtureWithInitial hardware current.val.initial

/-- Alignment certificates are erased: this data path reads the stored words. -/
noncomputable def finiteADCPhysicalCurrentPacket
    {hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource}
    (current : FiniteADCPhysicalRuntimeCurrent hardware) :
    FiniteADCWirePacket (finiteADCPhysicalCurrentSource current) :=
  recordedADCWirePacket (finiteADCPhysicalCurrentSource current) current.val
    (by have same := congrArg
          FiniteADCClockedNoisyMeteredSynchronousSampleOccurrence.adcCode current.property
        exact same)
    (by have same := congrArg
          FiniteADCClockedNoisyMeteredSynchronousSampleOccurrence.sampleTick current.property
        rw [same]
        exact adcSampleTick_no_counter_overflow
          (finiteADCPhysicalCurrentSource current) current.val.drive)

theorem finiteADCPhysicalCurrentPacket_commutes
    {hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource}
    (current : FiniteADCPhysicalRuntimeCurrent hardware) :
    finiteADCPhysicalCurrentPacket current =
      packADCExecution (finiteADCPhysicalCurrentSource current) current.val.drive := by
  rcases current with ⟨run, same⟩
  have codeSame := congrArg FiniteADCClockedNoisyMeteredSynchronousSampleOccurrence.adcCode same
  apply Prod.ext
  · apply Fin.ext
    exact congrArg FiniteADCClockedNoisyMeteredSynchronousSampleOccurrence.sampleTick same
  · funext frame leg channel
    apply Fin.ext
    have wordSame := congrArg
      (fun run => ((run.adcWordAt frame leg channel).val)) same
    exact congrArg (fun value =>
      (value + 16 * finiteADCGridDenominator hardware.adcCode).toNat) wordSame

noncomputable def finiteADCPhysicalReceived
    {hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource}
    (current : FiniteADCPhysicalRuntimeCurrent hardware) : Option FiniteBinaryDrive :=
  receiveADC128WirePacket (finiteADCPhysicalCurrentSource current)
    (maxADCSampleTick (finiteADCPhysicalCurrentSource current))
    (finiteADCPhysicalCurrentPacket current)

theorem finiteADCPhysicalReceived_exact
    {hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource}
    (current : FiniteADCPhysicalRuntimeCurrent hardware) :
    finiteADCPhysicalReceived current = some current.val.drive := by
  unfold finiteADCPhysicalReceived
  rw [finiteADCPhysicalCurrentPacket_commutes, receiveADC128WirePacket_compiled]

/-- Feedback acts on the received packet, not on the stored request tag.
The syntactic failure branch is total; generated runtime currents cannot reach it. -/
noncomputable def finiteADCPhysicalFeedback
    {hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource}
    (current : FiniteADCPhysicalRuntimeCurrent hardware) : FiniteBinaryDrive :=
  match finiteADCPhysicalReceived current with
  | some received => fun channel => !(received channel)
  | none => uniformBinaryDrive false

theorem finiteADCPhysicalFeedback_exact
    {hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource}
    (current : FiniteADCPhysicalRuntimeCurrent hardware) :
    finiteADCPhysicalFeedback current = fun channel => !(current.val.drive channel) := by
  unfold finiteADCPhysicalFeedback
  rw [finiteADCPhysicalReceived_exact]

/-- The source owns the same constitutive-law solver; its time and initial
state come from this literal run, not from the immutable template's boot state. -/
noncomputable def finiteADCPhysicalStateAt
    {hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource}
    (current : FiniteADCPhysicalRuntimeCurrent hardware) (time : SISecond) :
    FiniteDimensionedSeriesRLCPortState :=
  drivenTotalPortStateAt
    (resonantDrivenCoreDimensionedSource hardware.meteredSource.fixture.coreSource)
    current.val.drivenRun.driveFrequencyAt
    (resonantDrivenRunDrivePhasorAt current.val.drivenRun current.val.driveState)
    current.val.initial time

noncomputable def finiteADCPhysicalEndpoint
    {hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource}
    (current : FiniteADCPhysicalRuntimeCurrent hardware) : FiniteDimensionedSeriesRLCPortState :=
  finiteADCPhysicalStateAt current current.val.executedDuration

theorem finiteADCPhysicalStateAt_commutes
    {hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource}
    (current : FiniteADCPhysicalRuntimeCurrent hardware) (time : SISecond) :
    finiteADCPhysicalStateAt current time =
      drivenTotalPortStateAt
        (resonantDrivenCoreDimensionedSource hardware.meteredSource.fixture.coreSource)
        (sourceOwnedResonantDrivenFrequencyAt hardware.meteredSource.fixture.coreSource)
        (sourceOwnedResonantDrivenDriveAt hardware.meteredSource.fixture.coreSource
          (binaryDriveState current.val.drive))
        current.val.initial time := by
  have runExact := congrArg
    FiniteADCClockedNoisyMeteredSynchronousSampleOccurrence.drivenRun current.property
  have stateExact := congrArg
    FiniteADCClockedNoisyMeteredSynchronousSampleOccurrence.driveState current.property
  unfold finiteADCPhysicalStateAt
  rw [runExact, stateExact]
  rfl

/-- This generated step both changes the actual initial state and runs the
independently received feedback command on the same physical template. -/
noncomputable def finiteADCPhysicalSuccessor
    {hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource}
    (current : FiniteADCPhysicalRuntimeCurrent hardware) : FiniteADCPhysicalRuntimeCurrent hardware :=
  startFiniteADCPhysicalRuntime hardware
    (finiteADCPhysicalEndpoint current) (finiteADCPhysicalFeedback current)

theorem finiteADCPhysicalSuccessor_initial
    {hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource}
    (current : FiniteADCPhysicalRuntimeCurrent hardware) :
    (finiteADCPhysicalSuccessor current).val.initial = finiteADCPhysicalEndpoint current := rfl

theorem finiteADCPhysicalSuccessor_no_reset
    {hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource}
    (current : FiniteADCPhysicalRuntimeCurrent hardware) :
    finiteADCPhysicalStateAt (finiteADCPhysicalSuccessor current) 0 =
      finiteADCPhysicalEndpoint current := by
  exact drivenTotalPortState_initial_exact _ _ _ _

theorem finiteADCPhysicalSuccessor_feedback
    {hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource}
    (current : FiniteADCPhysicalRuntimeCurrent hardware) :
    (finiteADCPhysicalSuccessor current).val.drive =
      fun channel => !(current.val.drive channel) :=
  finiteADCPhysicalFeedback_exact current

theorem finiteADCPhysicalSuccessor_hardware_preserved
    {hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource}
    (current : FiniteADCPhysicalRuntimeCurrent hardware) :
    (finiteADCPhysicalSuccessor current).val.drivenRun = current.val.drivenRun ∧
      (finiteADCPhysicalSuccessor current).val.noiseCode = current.val.noiseCode ∧
      (finiteADCPhysicalSuccessor current).val.meterCode = current.val.meterCode ∧
      (finiteADCPhysicalSuccessor current).val.adcCode = current.val.adcCode ∧
      (finiteADCPhysicalSuccessor current).val.clockCode = current.val.clockCode ∧
      (finiteADCPhysicalSuccessor current).val.clockTick = current.val.clockTick := by
  exact ⟨(congrArg FiniteADCClockedNoisyMeteredSynchronousSampleOccurrence.drivenRun
      current.property).symm,
    (congrArg FiniteADCClockedNoisyMeteredSynchronousSampleOccurrence.noiseCode
      current.property).symm,
    (congrArg FiniteADCClockedNoisyMeteredSynchronousSampleOccurrence.meterCode
      current.property).symm,
    (congrArg FiniteADCClockedNoisyMeteredSynchronousSampleOccurrence.adcCode
      current.property).symm,
    (congrArg FiniteADCClockedNoisyMeteredSynchronousSampleOccurrence.clockCode
      current.property).symm,
    (congrArg FiniteADCClockedNoisyMeteredSynchronousSampleOccurrence.clockTick
      current.property).symm⟩

theorem finiteADCPhysicalSuccessor_changes_current
    {hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource}
    (current : FiniteADCPhysicalRuntimeCurrent hardware) :
    finiteADCPhysicalSuccessor current ≠ current := by
  intro same
  have bitSame := congrArg (fun state => state.val.drive .sourceBound) same
  have feedback := congrFun (finiteADCPhysicalSuccessor_feedback current) .sourceBound
  rw [feedback] at bitSame
  cases bit : current.val.drive .sourceBound <;> simp [bit] at bitSame

theorem finiteADCPhysicalCurrent_generates_receipt
    {hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource}
    (current : FiniteADCPhysicalRuntimeCurrent hardware) :
    SourceGeneratedFiniteADCClockedNoisyMeteredSynchronousSampleAt
      (finiteADCPhysicalCurrentSource current) current.val.drive :=
  sourceGeneratedFiniteADCClockedNoisyMeteredSynchronousSample
    (finiteADCPhysicalCurrentSource current) current.val.drive

theorem finiteADCPhysicalSuccessor_generates_receipt
    {hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource}
    (current : FiniteADCPhysicalRuntimeCurrent hardware) :
    SourceGeneratedFiniteADCClockedNoisyMeteredSynchronousSampleAt
      (finiteADCPhysicalCurrentSource (finiteADCPhysicalSuccessor current))
      (finiteADCPhysicalSuccessor current).val.drive :=
  finiteADCPhysicalCurrent_generates_receipt (finiteADCPhysicalSuccessor current)

theorem finiteADCPhysicalCurrent_duration_positive
    {hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource}
    (current : FiniteADCPhysicalRuntimeCurrent hardware) :
    0 < current.val.executedDuration.value := by
  have same := congrArg
    FiniteADCClockedNoisyMeteredSynchronousSampleOccurrence.executedDuration current.property
  rw [same]
  exact finiteADCClockedSampleTime_pos (finiteADCPhysicalCurrentSource current) current.val.drive

/-- Every actual frame consumes at least one tick of the same source clock. -/
theorem finiteADCPhysicalCurrent_duration_ge_tick
    {hardware : FiniteADCClockedNoisyMeteredSynchronousFixtureSource}
    (current : FiniteADCPhysicalRuntimeCurrent hardware) :
    (finiteSamplingClockTickPeriod hardware.meteredSource.fixture.coreSource
      hardware.clockCode).value ≤ current.val.executedDuration.value := by
  have clockExact : current.val.clockTick =
      finiteSamplingClockTickPeriod hardware.meteredSource.fixture.coreSource hardware.clockCode :=
    congrArg FiniteADCClockedNoisyMeteredSynchronousSampleOccurrence.clockTick current.property
  have timeExact : current.val.executedDuration.value =
      (current.val.sampleTick : ℝ) * current.val.clockTick.value := by
    have timeSame := congrArg
      FiniteADCClockedNoisyMeteredSynchronousSampleOccurrence.executedDuration current.property
    have tickSame := congrArg
      FiniteADCClockedNoisyMeteredSynchronousSampleOccurrence.sampleTick current.property
    rw [timeSame, tickSame, clockExact]
    rfl
  have positive := finiteADCPhysicalCurrent_duration_positive current
  have tickPositive := finiteSamplingClockTickPeriod_pos
    hardware.meteredSource.fixture.coreSource hardware.clockCode
  have countPositive : 0 < current.val.sampleTick := by
    by_contra notPositive
    have zero : current.val.sampleTick = 0 := by omega
    simp only [timeExact, zero, Nat.cast_zero, zero_mul, lt_self_iff_false] at positive
  rw [timeExact, clockExact]
  have oneLe : (1 : ℝ) ≤ current.val.sampleTick := by exact_mod_cast countPositive
  nlinarith

end Netlist.Dissipative.Dimensioned.Driven.Producer
end SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical
