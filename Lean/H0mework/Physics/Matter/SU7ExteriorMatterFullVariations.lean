import H0mework.Physics.Matter.SU7ExteriorMatterVariationRegressions

/-!
# Stage-8D full finite-link variation receipt

Proof-only aggregation of the exact variation laws and their positive/negative
regressions.  It adds no physical source, lineage, mass table, or atomhood datum.
-/

namespace SaturationMonoid.PhysicsCore.SU7ExteriorMatterFullVariations

open SU7MotherLieAlgebra
open SU7MotherGaugeTheory
open SU7ExteriorMatterRepresentation
open SU7ExteriorMatterGaugeCovariantJet
open DiracCliffordRepresentation
open PointwiseDiracSpinConnectionLift
open DiracExteriorMatterAction
open DiracExteriorMatterLocalGaugeLink
open SU7ExteriorBreakingYukawa
open SU7ExteriorYukawaMassSpectrum

noncomputable section

/-! ## Proof-only Stage-8D receipt -/

/-- Exact variation laws only.  This is the receipt consumed by the corrected
joint credential; positive current must be generated by that credential's
own source-indexed matter state. -/
structure StageEightDExactVariationLawReceipt : Prop where
  actualActionAdapter : ∀ geometry connection matter scalar,
    stageEightMatterAction
        (stageEightVariationConfigurationOfActual
          geometry connection matter scalar) =
      diracExteriorMatterLinkActionDensity geometry
          (motherLinkFamilyOfConnection connection) matter +
        stageEightActualYukawaDensity geometry matter scalar
  sourceVariation : ∀ configuration variation coefficient,
    stageEightMatterAction
        (configuration.withSourceMatter
          (configuration.sourceMatter + coefficient • variation)) =
      stageEightMatterAction configuration +
        coefficient * stageEightSourceEquation configuration variation
  targetVariation : ∀ configuration variation coefficient,
    stageEightMatterAction
        (configuration.withTargetMatter
          (configuration.targetMatter + coefficient • variation)) =
      stageEightMatterAction configuration +
        coefficient * stageEightTargetEquation configuration variation
  conjugateVariation : ∀ configuration variation coefficient,
    stageEightMatterAction
        (configuration.withConjugateMatter
          (configuration.conjugateMatter + coefficient • variation)) =
      stageEightMatterAction configuration + coefficient *
        variation (stageEightConjugateEquationVector configuration)
  breakingVariation : ∀ configuration variation coefficient,
    stageEightMatterAction
        (configuration.withBreakingScalar
          (configuration.breakingScalar + coefficient • variation)) =
      stageEightMatterAction configuration +
        coefficient * stageEightBreakingEquation configuration variation
  motherVariation : ∀ configuration variation coefficient,
    stageEightMatterAction
        (configuration.withMotherTransport
          (configuration.motherTransport + coefficient • variation)) =
      stageEightMatterAction configuration +
        coefficient * stageEightMotherCurrent configuration variation
  volumeVariation : ∀ configuration variation coefficient,
    stageEightMatterAction
        (configuration.withGeometryVolume
          (configuration.geometry.volume + coefficient * variation)) =
      stageEightMatterAction configuration +
        coefficient * variation * stageEightVolumeStress configuration
  gammaVariation : ∀ configuration variation coefficient,
    stageEightMatterAction
        (configuration.withGeometryGamma
          (configuration.geometry.gammaAction + coefficient • variation)) =
      stageEightMatterAction configuration +
        coefficient * stageEightGammaStress configuration variation
  spinVariation : ∀ configuration variation coefficient,
    stageEightMatterAction
        (configuration.withGeometrySpin
          (configuration.geometry.spinAction + coefficient • variation)) =
      stageEightMatterAction configuration +
        coefficient * stageEightSpinStress configuration variation

theorem stageEightDExactVariationLawReceipt :
    StageEightDExactVariationLawReceipt where
  actualActionAdapter :=
    stageEightMatterAction_ofActual_eq_link_add_yukawa
  sourceVariation := stageEightMatterAction_source_variation
  targetVariation := stageEightMatterAction_target_variation
  conjugateVariation := stageEightMatterAction_conjugate_variation
  breakingVariation := stageEightMatterAction_breaking_variation
  motherVariation := stageEightMatterAction_mother_variation
  volumeVariation := stageEightMatterAction_volume_variation
  gammaVariation := stageEightMatterAction_gamma_variation
  spinVariation := stageEightMatterAction_spin_variation

/-- The finite-link Stage-8D checkpoint.  The variation laws are exact affine
identities for every complex coefficient.  Geometry is varied through the
actual finite readouts consumed by this action (volume, inverse-coframe gamma,
and spin action); this does not claim a smooth Fréchet variation of the coframe
bundle itself. -/
structure StageEightDFullVariationReceipt : Prop where
  actualActionAdapter : ∀ geometry connection matter scalar,
    stageEightMatterAction
        (stageEightVariationConfigurationOfActual
          geometry connection matter scalar) =
      diracExteriorMatterLinkActionDensity geometry
          (motherLinkFamilyOfConnection connection) matter +
        stageEightActualYukawaDensity geometry matter scalar
  sourceVariation : ∀ configuration variation coefficient,
    stageEightMatterAction
        (configuration.withSourceMatter
          (configuration.sourceMatter + coefficient • variation)) =
      stageEightMatterAction configuration +
        coefficient * stageEightSourceEquation configuration variation
  targetVariation : ∀ configuration variation coefficient,
    stageEightMatterAction
        (configuration.withTargetMatter
          (configuration.targetMatter + coefficient • variation)) =
      stageEightMatterAction configuration +
        coefficient * stageEightTargetEquation configuration variation
  conjugateVariation : ∀ configuration variation coefficient,
    stageEightMatterAction
        (configuration.withConjugateMatter
          (configuration.conjugateMatter + coefficient • variation)) =
      stageEightMatterAction configuration + coefficient *
        variation (stageEightConjugateEquationVector configuration)
  breakingVariation : ∀ configuration variation coefficient,
    stageEightMatterAction
        (configuration.withBreakingScalar
          (configuration.breakingScalar + coefficient • variation)) =
      stageEightMatterAction configuration +
        coefficient * stageEightBreakingEquation configuration variation
  motherVariation : ∀ configuration variation coefficient,
    stageEightMatterAction
        (configuration.withMotherTransport
          (configuration.motherTransport + coefficient • variation)) =
      stageEightMatterAction configuration +
        coefficient * stageEightMotherCurrent configuration variation
  volumeVariation : ∀ configuration variation coefficient,
    stageEightMatterAction
        (configuration.withGeometryVolume
          (configuration.geometry.volume + coefficient * variation)) =
      stageEightMatterAction configuration +
        coefficient * variation * stageEightVolumeStress configuration
  gammaVariation : ∀ configuration variation coefficient,
    stageEightMatterAction
        (configuration.withGeometryGamma
          (configuration.geometry.gammaAction + coefficient • variation)) =
      stageEightMatterAction configuration +
        coefficient * stageEightGammaStress configuration variation
  spinVariation : ∀ configuration variation coefficient,
    stageEightMatterAction
        (configuration.withGeometrySpin
          (configuration.geometry.spinAction + coefficient • variation)) =
      stageEightMatterAction configuration +
        coefficient * stageEightSpinStress configuration variation
  currentNonzero :
    stageEightMotherCurrent stageEightNonzeroCurrentConfiguration ≠ 0
  stressNonzero :
    stageEightVolumeStress stageEightNonzeroCurrentConfiguration ≠ 0
  mirrorRejected : mirrorExteriorSpinorDegree ≠ exteriorSpinorDegree
  noBreakingNoMass :
    exteriorYukawaMassMap (0 : ExteriorBreakingScalarCarrier) = 0
  handFilledMassRejected :
    ¬ MatchesSelectedGeneratedMass
      (0 : ExteriorDegreeTwoMatterCarrier →ₗ[ℂ]
        ExteriorDegreeSixMatterCarrier)
  nonEquivariantYukawaRejected :
    ¬ IsSU7EquivariantYukawa constantBreakingYukawa

theorem stageEightDFullVariationReceipt :
    StageEightDFullVariationReceipt where
  actualActionAdapter :=
    stageEightMatterAction_ofActual_eq_link_add_yukawa
  sourceVariation := stageEightMatterAction_source_variation
  targetVariation := stageEightMatterAction_target_variation
  conjugateVariation := stageEightMatterAction_conjugate_variation
  breakingVariation := stageEightMatterAction_breaking_variation
  motherVariation := stageEightMatterAction_mother_variation
  volumeVariation := stageEightMatterAction_volume_variation
  gammaVariation := stageEightMatterAction_gamma_variation
  spinVariation := stageEightMatterAction_spin_variation
  currentNonzero := stageEightNonzeroMotherCurrent_ne_zero
  stressNonzero := stageEightNonzeroVolumeStress_ne_zero
  mirrorRejected := mirrorExteriorSpinorDegree_ne_actual
  noBreakingNoMass := exteriorYukawaMassMap_zeroBreaking
  handFilledMassRejected := selectedGeneratedMass_rejects_handFilledZero
  nonEquivariantYukawaRejected :=
    constantBreakingYukawa_not_su7Equivariant

end
end SaturationMonoid.PhysicsCore.SU7ExteriorMatterFullVariations
