import H0mework.Physics.Dirac.DiracExteriorMatterLocalGaugeLink
import Mathlib.LinearAlgebra.ExteriorAlgebra.Grading

/-!
# Actual exterior breaking representation and equivariant Yukawa map

This module supplies Stage 8B from the actual Stage-7 representation rather
than from a reference-model Higgs table.  An independent bosonic scalar field
uses the genuine SU(7) representation `Λ⁴V` (complex dimension 35).  Its
selected basis vector is proved nonzero and an actual embedded mother-SU(7)
quarter-turn moves it, so breaking is a theorem about the representation
action rather than a stored tag.

The Yukawa map is the graded exterior product

`Λ²V ⊗ Λ⁴V → Λ⁶V`,

which connects three summands of the actual Stage-7 carrier.  Exterior-algebra
functoriality proves full-SU(7) equivariance, inverse dual transport proves
invariance of the trilinear pairing, and a disjoint-basis channel proves the
coupling is nonzero.  The map is then embedded into
`Λ⁶V ⊕ Λ²V ⊕ Λ⁴V` and lifted to the actual Dirac carrier.  Derived right/left
projectors and `gamma^0` provide the cross-chiral lift; its internal SU(7)
equivariance is machine checked.

Boundary: the selected scalar vector is an explicit breaking datum, not yet a
minimum generated by a scalar potential.  This module does not characterize
its complete stabilizer, identify it with a reference electroweak Higgs, or
claim a Standard-Model vacuum.  Mass rank/kernel and mixing belong to Stage
8C; scalar/matter/gauge/geometry variations belong to Stage 8D.
-/

namespace SaturationMonoid.PhysicsCore.SU7ExteriorBreakingYukawa

open SU7MotherLieAlgebra
open SU7ExteriorMatterRepresentation
open SU7ExteriorMatterRestriction
open SU7ExteriorMatterGaugeCovariantJet
open DiracCliffordRepresentation
open DiracExteriorMatterAction
open GaugeProjection
open GaugeProjection.ConcreteBlockDiagonal

open scoped TensorProduct

noncomputable section

local instance : LinearOrder SU7MotherIndex :=
  LinearOrder.lift' smBlockIndexEquivFin7 smBlockIndexEquivFin7.injective

def exteriorWedge (firstDegree secondDegree : ℕ) :
    (⋀[ℂ]^firstDegree SU7FundamentalCarrier) →ₗ[ℂ]
      ((⋀[ℂ]^secondDegree SU7FundamentalCarrier) →ₗ[ℂ]
        (⋀[ℂ]^(firstDegree + secondDegree) SU7FundamentalCarrier)) :=
  DirectSum.gMulLHom
    (R := ℂ)
    (A := fun degree : ℕ =>
      ⋀[ℂ]^degree SU7FundamentalCarrier)

theorem exteriorPower_map_coe
    (degree : ℕ) (linearMap : Module.End ℂ SU7FundamentalCarrier)
    (value : ⋀[ℂ]^degree SU7FundamentalCarrier) :
    ((exteriorPower.map degree linearMap value :
        ⋀[ℂ]^degree SU7FundamentalCarrier) :
        ExteriorAlgebra ℂ SU7FundamentalCarrier) =
      ExteriorAlgebra.map linearMap
        (value : ExteriorAlgebra ℂ SU7FundamentalCarrier) := by
  let left :
      (⋀[ℂ]^degree SU7FundamentalCarrier) →ₗ[ℂ]
        ExteriorAlgebra ℂ SU7FundamentalCarrier :=
    (Submodule.subtype _).comp (exteriorPower.map degree linearMap)
  let right :
      (⋀[ℂ]^degree SU7FundamentalCarrier) →ₗ[ℂ]
        ExteriorAlgebra ℂ SU7FundamentalCarrier :=
    (ExteriorAlgebra.map linearMap).toLinearMap.comp (Submodule.subtype _)
  have mapsEqual : left = right := by
    apply exteriorPower.linearMap_ext
    ext family
    simp [left, right]
  exact LinearMap.congr_fun mapsEqual value

theorem exteriorWedge_su7_equivariant
    (firstDegree secondDegree : ℕ)
    (groupElement : SU7MotherGroup)
    (first : ⋀[ℂ]^firstDegree SU7FundamentalCarrier)
    (second : ⋀[ℂ]^secondDegree SU7FundamentalCarrier) :
    exteriorWedge firstDegree secondDegree
        (su7ExteriorPowerRepresentation firstDegree groupElement first)
        (su7ExteriorPowerRepresentation secondDegree groupElement second) =
      su7ExteriorPowerRepresentation (firstDegree + secondDegree) groupElement
        (exteriorWedge firstDegree secondDegree first second) := by
  apply Subtype.ext
  change
    ((exteriorPower.map firstDegree
        (su7FundamentalRepresentation groupElement) first :
          ⋀[ℂ]^firstDegree SU7FundamentalCarrier) :
        ExteriorAlgebra ℂ SU7FundamentalCarrier) *
      ((exteriorPower.map secondDegree
        (su7FundamentalRepresentation groupElement) second :
          ⋀[ℂ]^secondDegree SU7FundamentalCarrier) :
        ExteriorAlgebra ℂ SU7FundamentalCarrier) =
    ((exteriorPower.map (firstDegree + secondDegree)
        (su7FundamentalRepresentation groupElement)
          (exteriorWedge firstDegree secondDegree first second) :
          ⋀[ℂ]^(firstDegree + secondDegree) SU7FundamentalCarrier) :
        ExteriorAlgebra ℂ SU7FundamentalCarrier)
  rw [exteriorPower_map_coe, exteriorPower_map_coe,
    exteriorPower_map_coe]
  change
    ExteriorAlgebra.map (su7FundamentalRepresentation groupElement)
          (first : ExteriorAlgebra ℂ SU7FundamentalCarrier) *
        ExteriorAlgebra.map (su7FundamentalRepresentation groupElement)
          (second : ExteriorAlgebra ℂ SU7FundamentalCarrier) =
      ExteriorAlgebra.map (su7FundamentalRepresentation groupElement)
        ((first : ExteriorAlgebra ℂ SU7FundamentalCarrier) *
          (second : ExteriorAlgebra ℂ SU7FundamentalCarrier))
  rw [map_mul]

abbrev ExteriorBreakingScalarCarrier :=
  ⋀[ℂ]^4 SU7FundamentalCarrier

def exteriorBreakingScalarRepresentation :
    Representation ℂ SU7MotherGroup ExteriorBreakingScalarCarrier :=
  su7ExteriorPowerRepresentation 4

theorem exteriorBreakingScalarCarrier_finrank :
    Module.finrank ℂ ExteriorBreakingScalarCarrier = 35 := by
  rw [su7ExteriorPower_finrank]
  norm_num [Nat.choose]

def colorZeroIndex : SU7MotherIndex := Sum.inl 0
def colorOneIndex : SU7MotherIndex := Sum.inl 1
def colorTwoIndex : SU7MotherIndex := Sum.inl 2

def exteriorBreakingScalarSubset : Finset SU7MotherIndex :=
  {colorZeroIndex, colorOneIndex, colorTwoIndex, hyperPlusIndex}

def exteriorBreakingScalarIndex : ExteriorBasisIndex 4 :=
  ⟨exteriorBreakingScalarSubset, by
    change exteriorBreakingScalarSubset.card = 4
    simp [exteriorBreakingScalarSubset, colorZeroIndex, colorOneIndex,
      colorTwoIndex, hyperPlusIndex]⟩

def exteriorBreakingScalar : ExteriorBreakingScalarCarrier :=
  su7ExteriorBasis 4 exteriorBreakingScalarIndex

theorem exteriorBreakingScalar_ne_zero :
    exteriorBreakingScalar ≠ 0 :=
  (su7ExteriorBasis 4).ne_zero exteriorBreakingScalarIndex

@[simp] theorem exteriorBreakingScalar_hyperchargeWeight :
    exteriorHyperchargeWeight exteriorBreakingScalarIndex = 1 := by
  decide

theorem exteriorBreakingScalar_quarterTurn :
    exteriorBreakingScalarRepresentation hyperchargeQuarterTurn
        exteriorBreakingScalar =
      Complex.I • exteriorBreakingScalar := by
  rw [exteriorBreakingScalarRepresentation, exteriorBreakingScalar,
    hyperchargeQuarterTurn_exterior_basis]
  congr 1
  rw [exteriorHyperchargeCharacter_eq_zpow,
    exteriorBreakingScalar_hyperchargeWeight]
  rw [zpow_one]
  rfl

/-- The selected nonzero scalar is an actual breaking vector: an actual
mother-SU(7) element moves it. -/
theorem exteriorBreakingScalar_is_genuinely_broken :
    exteriorBreakingScalarRepresentation hyperchargeQuarterTurn
        exteriorBreakingScalar ≠ exteriorBreakingScalar := by
  rw [exteriorBreakingScalar_quarterTurn]
  intro fixed
  have annihilated :
      ((Complex.I : ℂ) - 1) • exteriorBreakingScalar = 0 := by
    calc
      ((Complex.I : ℂ) - 1) • exteriorBreakingScalar =
          Complex.I • exteriorBreakingScalar -
            (1 : ℂ) • exteriorBreakingScalar :=
        sub_smul Complex.I (1 : ℂ) exteriorBreakingScalar
      _ = exteriorBreakingScalar - exteriorBreakingScalar := by
        rw [fixed, one_smul]
      _ = 0 := sub_self _
  rcases smul_eq_zero.mp annihilated with coefficientZero | scalarZero
  · have i_ne_one : (Complex.I : ℂ) ≠ 1 := by
      intro imaginaryEqualsOne
      have := congrArg Complex.im imaginaryEqualsOne
      norm_num at this
    exact i_ne_one (sub_eq_zero.mp coefficientZero)
  · exact exteriorBreakingScalar_ne_zero scalarZero

abbrev ExteriorDegreeTwoMatterCarrier :=
  ⋀[ℂ]^2 SU7FundamentalCarrier

abbrev ExteriorDegreeSixMatterCarrier :=
  ⋀[ℂ]^6 SU7FundamentalCarrier

/-- The Yukawa mass map is not an arbitrary matrix: it is partial application
of the exterior product `Λ²V ⊗ Λ⁴V → Λ⁶V`. -/
def exteriorYukawaMassMap
    (scalar : ExteriorBreakingScalarCarrier) :
    ExteriorDegreeTwoMatterCarrier →ₗ[ℂ]
      ExteriorDegreeSixMatterCarrier :=
  (exteriorWedge 2 4).flip scalar

theorem exteriorYukawaMassMap_su7_equivariant
    (groupElement : SU7MotherGroup)
    (scalar : ExteriorBreakingScalarCarrier)
    (matter : ExteriorDegreeTwoMatterCarrier) :
    exteriorYukawaMassMap
        (exteriorBreakingScalarRepresentation groupElement scalar)
        (su7ExteriorPowerRepresentation 2 groupElement matter) =
      su7ExteriorPowerRepresentation 6 groupElement
        (exteriorYukawaMassMap scalar matter) := by
  exact exteriorWedge_su7_equivariant 2 4 groupElement matter scalar

def exteriorYukawaDualGaugeTransform
    (groupElement : SU7MotherGroup)
    (dual : Module.Dual ℂ ExteriorDegreeSixMatterCarrier) :
    Module.Dual ℂ ExteriorDegreeSixMatterCarrier :=
  dual.comp (su7ExteriorPowerRepresentation 6 groupElement⁻¹)

def exteriorYukawaPairing
    (dual : Module.Dual ℂ ExteriorDegreeSixMatterCarrier)
    (matter : ExteriorDegreeTwoMatterCarrier)
    (scalar : ExteriorBreakingScalarCarrier) : ℂ :=
  dual (exteriorYukawaMassMap scalar matter)

/-- Full-SU(7) invariance of the actual trilinear Yukawa pairing. -/
theorem exteriorYukawaPairing_su7_invariant
    (groupElement : SU7MotherGroup)
    (dual : Module.Dual ℂ ExteriorDegreeSixMatterCarrier)
    (matter : ExteriorDegreeTwoMatterCarrier)
    (scalar : ExteriorBreakingScalarCarrier) :
    exteriorYukawaPairing
        (exteriorYukawaDualGaugeTransform groupElement dual)
        (su7ExteriorPowerRepresentation 2 groupElement matter)
        (exteriorBreakingScalarRepresentation groupElement scalar) =
      exteriorYukawaPairing dual matter scalar := by
  rw [exteriorYukawaPairing, exteriorYukawaDualGaugeTransform,
    exteriorYukawaMassMap_su7_equivariant]
  change
    dual
        (su7ExteriorPowerRepresentation 6 groupElement⁻¹
          (su7ExteriorPowerRepresentation 6 groupElement
            (exteriorYukawaMassMap scalar matter))) =
      dual (exteriorYukawaMassMap scalar matter)
  have cancellation :
      (su7ExteriorPowerRepresentation 6 groupElement⁻¹).comp
          (su7ExteriorPowerRepresentation 6 groupElement) =
        LinearMap.id := by
    rw [← Module.End.mul_eq_comp, ← map_mul]
    simp [Module.End.one_eq_id]
  have cancellationAtMass := LinearMap.congr_fun cancellation
    (exteriorYukawaMassMap scalar matter)
  change
    su7ExteriorPowerRepresentation 6 groupElement⁻¹
        (su7ExteriorPowerRepresentation 6 groupElement
          (exteriorYukawaMassMap scalar matter)) =
      exteriorYukawaMassMap scalar matter at cancellationAtMass
  exact congrArg dual cancellationAtMass

def weakZeroIndex : SU7MotherIndex := Sum.inr (Sum.inl 0)
def weakOneIndex : SU7MotherIndex := Sum.inr (Sum.inl 1)

def exteriorYukawaDegreeTwoSubset : Finset SU7MotherIndex :=
  {weakZeroIndex, weakOneIndex}

def exteriorYukawaDegreeTwoIndex : ExteriorBasisIndex 2 :=
  ⟨exteriorYukawaDegreeTwoSubset, by
    change exteriorYukawaDegreeTwoSubset.card = 2
    simp [exteriorYukawaDegreeTwoSubset, weakZeroIndex, weakOneIndex]⟩

def exteriorYukawaDegreeTwoProbe : ExteriorDegreeTwoMatterCarrier :=
  su7ExteriorBasis 2 exteriorYukawaDegreeTwoIndex

theorem exteriorYukawaProbe_disjoint :
    Disjoint exteriorYukawaDegreeTwoIndex.1
      exteriorBreakingScalarIndex.1 := by
  decide

def exteriorYukawaDegreeSixIndex : ExteriorBasisIndex 6 :=
  Set.powersetCard.disjUnion exteriorYukawaProbe_disjoint

theorem exteriorYukawaProbe_massMap :
    exteriorYukawaMassMap exteriorBreakingScalar
        exteriorYukawaDegreeTwoProbe =
      (Set.powersetCard.permOfDisjoint
          exteriorYukawaProbe_disjoint).sign •
        su7ExteriorBasis 6 exteriorYukawaDegreeSixIndex := by
  apply Subtype.ext
  simpa [exteriorYukawaMassMap, exteriorWedge,
    exteriorYukawaDegreeTwoProbe, exteriorBreakingScalar,
    exteriorYukawaDegreeSixIndex, su7ExteriorBasis,
    exteriorPower.basis_apply] using
    ExteriorAlgebra.ιMulti_family_mul_of_disjoint ℂ su7FundamentalBasis
      exteriorYukawaDegreeTwoIndex exteriorBreakingScalarIndex
      exteriorYukawaProbe_disjoint

theorem exteriorYukawaProbe_massMap_ne_zero :
    exteriorYukawaMassMap exteriorBreakingScalar
        exteriorYukawaDegreeTwoProbe ≠ 0 := by
  rw [exteriorYukawaProbe_massMap]
  intro scalarMultipleZero
  have basisZero :=
    (smul_eq_zero_iff_eq
      (Set.powersetCard.permOfDisjoint
        exteriorYukawaProbe_disjoint).sign).mp scalarMultipleZero
  exact (su7ExteriorBasis 6).ne_zero
    exteriorYukawaDegreeSixIndex basisZero

def exteriorYukawaDegreeSixCoordinate :
    Module.Dual ℂ ExteriorDegreeSixMatterCarrier :=
  (su7ExteriorBasis 6).coord exteriorYukawaDegreeSixIndex

theorem exteriorYukawaProbe_pairing_ne_zero :
    exteriorYukawaPairing exteriorYukawaDegreeSixCoordinate
        exteriorYukawaDegreeTwoProbe exteriorBreakingScalar ≠ 0 := by
  rw [exteriorYukawaPairing, exteriorYukawaProbe_massMap]
  simp [exteriorYukawaDegreeSixCoordinate]
  intro signedOneZero
  exact one_ne_zero
    ((smul_eq_zero_iff_eq
      (Set.powersetCard.permOfDisjoint
        exteriorYukawaProbe_disjoint).sign).mp signedOneZero)

/-! ## Lift into the actual Stage-7 direct sum and Dirac chirality -/

def exteriorYukawaInternalAction
    (scalar : ExteriorBreakingScalarCarrier) :
    Module.End ℂ SU7ExteriorSpinorMatterCarrier where
  toFun matter :=
    (exteriorYukawaMassMap scalar matter.2.1, (0, 0))
  map_add' first second := by
    simp
  map_smul' coefficient matter := by
    simp

theorem exteriorYukawaInternalAction_su7_equivariant
    (groupElement : SU7MotherGroup)
    (scalar : ExteriorBreakingScalarCarrier) :
    (exteriorYukawaInternalAction
        (exteriorBreakingScalarRepresentation groupElement scalar)).comp
          (su7ExteriorSpinorMatterRepresentation groupElement) =
      (su7ExteriorSpinorMatterRepresentation groupElement).comp
        (exteriorYukawaInternalAction scalar) := by
  apply LinearMap.ext
  rintro ⟨degreeSix, degreeTwo, degreeFour⟩
  apply Prod.ext
  · exact exteriorYukawaMassMap_su7_equivariant
      groupElement scalar degreeTwo
  · simp [exteriorYukawaInternalAction,
      su7ExteriorSpinorMatterRepresentation]

theorem diracMatrixMatterAction_mul
    (first second : DiracMatrix) :
    diracMatrixMatterAction (first * second) =
      (diracMatrixMatterAction first).comp
        (diracMatrixMatterAction second) := by
  apply LinearMap.ext
  intro field
  funext row
  change
    (∑ column,
        (∑ middle, first row middle * second middle column) •
          field column) =
      ∑ middle,
        first row middle •
          ∑ column, second middle column • field column
  calc
    _ = ∑ column, ∑ middle,
        (first row middle * second middle column) • field column := by
      apply Finset.sum_congr rfl
      intro column _
      rw [Finset.sum_smul]
    _ = ∑ middle, ∑ column,
        (first row middle * second middle column) • field column := by
      rw [Finset.sum_comm]
    _ = ∑ middle,
        first row middle •
          ∑ column, second middle column • field column := by
      apply Finset.sum_congr rfl
      intro middle _
      rw [Finset.smul_sum]
      apply Finset.sum_congr rfl
      intro column _
      rw [smul_smul]

theorem diracMatrixMatterAction_apply_apply
    (first second : DiracMatrix)
    (field : DiracExteriorMatterCarrier) :
    diracMatrixMatterAction first
        (diracMatrixMatterAction second field) =
      diracMatrixMatterAction (first * second) field := by
  rw [diracMatrixMatterAction_mul, LinearMap.comp_apply]

/-- The actual scalar Yukawa map between Stage-7 summands, lifted pointwise to
the Dirac carrier. -/
def diracExteriorYukawaInternalAction
    (scalar : ExteriorBreakingScalarCarrier) :
    Module.End ℂ DiracExteriorMatterCarrier :=
  internalMatterLinearAction (exteriorYukawaInternalAction scalar)

@[simp] theorem diracExteriorMatterGaugeRepresentation_eq_internal
    (groupElement : SU7MotherGroup) :
    diracExteriorMatterGaugeRepresentation groupElement =
      internalMatterLinearAction
        (su7ExteriorSpinorMatterRepresentation groupElement) := by
  rfl

theorem diracExteriorYukawaInternalAction_su7_equivariant
    (groupElement : SU7MotherGroup)
    (scalar : ExteriorBreakingScalarCarrier) :
    (diracExteriorYukawaInternalAction
        (exteriorBreakingScalarRepresentation groupElement scalar)).comp
          (diracExteriorMatterGaugeRepresentation groupElement) =
      (diracExteriorMatterGaugeRepresentation groupElement).comp
        (diracExteriorYukawaInternalAction scalar) := by
  apply LinearMap.ext
  intro field
  funext spinIndex
  exact LinearMap.congr_fun
    (exteriorYukawaInternalAction_su7_equivariant groupElement scalar)
    (field spinIndex)

theorem leftChiralityProjector_mul_gammaZero :
    leftChiralityProjector * diracGamma 0 =
      diracGamma 0 * rightChiralityProjector := by
  have anticommutator := diracGammaFive_anticommutes (0 : LorentzianIndex)
  rw [leftChiralityProjector, rightChiralityProjector,
    Matrix.smul_mul, Matrix.mul_smul, Matrix.sub_mul, Matrix.mul_add,
    Matrix.one_mul, Matrix.mul_one]
  have gammaFiveGammaZero :
      diracGammaFive * diracGamma 0 =
        -(diracGamma 0 * diracGammaFive) :=
    eq_neg_of_add_eq_zero_left anticommutator
  rw [gammaFiveGammaZero]
  module

/-- A cross-chiral Dirac lift.  `gamma^0` is the actual chirality-flipping
Clifford matrix; the projectors are the derived matrices from Stage 8A. -/
def chiralExteriorYukawaAction
    (scalar : ExteriorBreakingScalarCarrier) :
    Module.End ℂ DiracExteriorMatterCarrier :=
  (diracMatrixMatterAction leftChiralityProjector).comp
    ((diracMatrixMatterAction (diracGamma 0)).comp
      ((diracExteriorYukawaInternalAction scalar).comp
        (diracMatrixMatterAction rightChiralityProjector)))

private theorem diracMatrixMatterAction_degreeTwo_zero
    (matrix : DiracMatrix)
    (field : DiracExteriorMatterCarrier)
    (zeroDegreeTwo : ∀ spin, (field spin).2.1 = 0) :
    ∀ spin, (diracMatrixMatterAction matrix field spin).2.1 = 0 := by
  intro spin
  change (∑ column, matrix spin column • (field column).2.1) = 0
  simp [zeroDegreeTwo]

/-- The chiral Yukawa map lands in the exterior-degree-six summand, so its
degree-two component vanishes before any Stage-9 field equation is read. -/
theorem chiralExteriorYukawaAction_degreeTwo_eq_zero
    (scalar : ExteriorBreakingScalarCarrier)
    (field : DiracExteriorMatterCarrier) :
    ∀ spin, (chiralExteriorYukawaAction scalar field spin).2.1 = 0 := by
  intro spin
  unfold chiralExteriorYukawaAction
  simp only [LinearMap.comp_apply]
  apply diracMatrixMatterAction_degreeTwo_zero
  intro gammaSpin
  apply diracMatrixMatterAction_degreeTwo_zero
  intro internalSpin
  rfl

/-- The canonical P506 degree-two conjugate coordinate annihilates every
chiral Yukawa output.  This is a representation-selection theorem, not a
scalar equation receipt. -/
theorem diracSpinZeroMatterCoordinate_chiralExteriorYukawaAction_eq_zero
    (scalar : ExteriorBreakingScalarCarrier)
    (field : DiracExteriorMatterCarrier) :
    diracSpinZeroMatterCoordinate
        (chiralExteriorYukawaAction scalar field) =
      0 := by
  change
    ((su7ExteriorBasis 2).repr
      ((chiralExteriorYukawaAction scalar field 0).2.1))
        hyperchargeDegreeTwoIndex =
      0
  rw [chiralExteriorYukawaAction_degreeTwo_eq_zero scalar field 0]
  simp

theorem chiralExteriorYukawaAction_output_left
    (scalar : ExteriorBreakingScalarCarrier)
    (field : DiracExteriorMatterCarrier) :
    diracMatrixMatterAction leftChiralityProjector
        (chiralExteriorYukawaAction scalar field) =
      chiralExteriorYukawaAction scalar field := by
  rw [chiralExteriorYukawaAction]
  simp only [LinearMap.comp_apply]
  rw [diracMatrixMatterAction_apply_apply
      leftChiralityProjector leftChiralityProjector,
    leftChiralityProjector_sq]

theorem chiralExteriorYukawaAction_consumes_right
    (scalar : ExteriorBreakingScalarCarrier)
    (field : DiracExteriorMatterCarrier) :
    chiralExteriorYukawaAction scalar
        (diracMatrixMatterAction rightChiralityProjector field) =
      chiralExteriorYukawaAction scalar field := by
  rw [chiralExteriorYukawaAction]
  simp only [LinearMap.comp_apply]
  rw [diracMatrixMatterAction_apply_apply
      rightChiralityProjector rightChiralityProjector field,
    rightChiralityProjector_sq]

theorem chiralExteriorYukawaAction_su7_equivariant
    (groupElement : SU7MotherGroup)
    (scalar : ExteriorBreakingScalarCarrier) :
    (chiralExteriorYukawaAction
        (exteriorBreakingScalarRepresentation groupElement scalar)).comp
          (diracExteriorMatterGaugeRepresentation groupElement) =
      (diracExteriorMatterGaugeRepresentation groupElement).comp
        (chiralExteriorYukawaAction scalar) := by
  rw [diracExteriorMatterGaugeRepresentation_eq_internal]
  apply LinearMap.ext
  intro field
  have rightCommutes :
      diracMatrixMatterAction rightChiralityProjector
          (internalMatterLinearAction
            (su7ExteriorSpinorMatterRepresentation groupElement) field) =
        internalMatterLinearAction
          (su7ExteriorSpinorMatterRepresentation groupElement)
          (diracMatrixMatterAction rightChiralityProjector field) := by
    simpa only [LinearMap.comp_apply] using LinearMap.congr_fun
      (diracMatrixMatterAction_commutes_internal rightChiralityProjector
        (su7ExteriorSpinorMatterRepresentation groupElement)) field
  have yukawaEquivariant :
      diracExteriorYukawaInternalAction
          (exteriorBreakingScalarRepresentation groupElement scalar)
          (internalMatterLinearAction
            (su7ExteriorSpinorMatterRepresentation groupElement)
            (diracMatrixMatterAction rightChiralityProjector field)) =
        internalMatterLinearAction
          (su7ExteriorSpinorMatterRepresentation groupElement)
          (diracExteriorYukawaInternalAction scalar
            (diracMatrixMatterAction rightChiralityProjector field)) := by
    simpa only [LinearMap.comp_apply,
      diracExteriorMatterGaugeRepresentation_eq_internal] using LinearMap.congr_fun
      (diracExteriorYukawaInternalAction_su7_equivariant
        groupElement scalar)
      (diracMatrixMatterAction rightChiralityProjector field)
  have gammaCommutes :
      diracMatrixMatterAction (diracGamma 0)
          (internalMatterLinearAction
            (su7ExteriorSpinorMatterRepresentation groupElement)
            (diracExteriorYukawaInternalAction scalar
              (diracMatrixMatterAction rightChiralityProjector field))) =
        internalMatterLinearAction
          (su7ExteriorSpinorMatterRepresentation groupElement)
          (diracMatrixMatterAction (diracGamma 0)
            (diracExteriorYukawaInternalAction scalar
              (diracMatrixMatterAction rightChiralityProjector field))) := by
    simpa only [LinearMap.comp_apply] using LinearMap.congr_fun
      (diracMatrixMatterAction_commutes_internal (diracGamma 0)
        (su7ExteriorSpinorMatterRepresentation groupElement))
      (diracExteriorYukawaInternalAction scalar
        (diracMatrixMatterAction rightChiralityProjector field))
  have leftCommutes :
      diracMatrixMatterAction leftChiralityProjector
          (internalMatterLinearAction
            (su7ExteriorSpinorMatterRepresentation groupElement)
            (diracMatrixMatterAction (diracGamma 0)
              (diracExteriorYukawaInternalAction scalar
                (diracMatrixMatterAction rightChiralityProjector field)))) =
        internalMatterLinearAction
          (su7ExteriorSpinorMatterRepresentation groupElement)
          (diracMatrixMatterAction leftChiralityProjector
            (diracMatrixMatterAction (diracGamma 0)
              (diracExteriorYukawaInternalAction scalar
                (diracMatrixMatterAction rightChiralityProjector field)))) := by
    simpa only [LinearMap.comp_apply] using LinearMap.congr_fun
      (diracMatrixMatterAction_commutes_internal leftChiralityProjector
        (su7ExteriorSpinorMatterRepresentation groupElement))
      (diracMatrixMatterAction (diracGamma 0)
        (diracExteriorYukawaInternalAction scalar
          (diracMatrixMatterAction rightChiralityProjector field)))
  simp only [chiralExteriorYukawaAction, LinearMap.comp_apply]
  rw [rightCommutes, yukawaEquivariant, gammaCommutes, leftCommutes]

/-! ## Proof-only Stage-8B receipt -/

structure StageEightBBreakingYukawaReceipt : Prop where
  scalarCarrier_finrank :
    Module.finrank ℂ ExteriorBreakingScalarCarrier = 35
  breakingScalar_nonzero : exteriorBreakingScalar ≠ 0
  actualMotherElement_moves_breakingScalar :
    exteriorBreakingScalarRepresentation hyperchargeQuarterTurn
        exteriorBreakingScalar ≠ exteriorBreakingScalar
  yukawaMassMap_equivariant : ∀
      (groupElement : SU7MotherGroup)
      (scalar : ExteriorBreakingScalarCarrier)
      (matter : ExteriorDegreeTwoMatterCarrier),
    exteriorYukawaMassMap
        (exteriorBreakingScalarRepresentation groupElement scalar)
        (su7ExteriorPowerRepresentation 2 groupElement matter) =
      su7ExteriorPowerRepresentation 6 groupElement
        (exteriorYukawaMassMap scalar matter)
  yukawaPairing_invariant : ∀
      (groupElement : SU7MotherGroup)
      (dual : Module.Dual ℂ ExteriorDegreeSixMatterCarrier)
      (matter : ExteriorDegreeTwoMatterCarrier)
      (scalar : ExteriorBreakingScalarCarrier),
    exteriorYukawaPairing
        (exteriorYukawaDualGaugeTransform groupElement dual)
        (su7ExteriorPowerRepresentation 2 groupElement matter)
        (exteriorBreakingScalarRepresentation groupElement scalar) =
      exteriorYukawaPairing dual matter scalar
  nonzeroYukawaChannel :
    exteriorYukawaPairing exteriorYukawaDegreeSixCoordinate
        exteriorYukawaDegreeTwoProbe exteriorBreakingScalar ≠ 0
  chiralOutput_left : ∀ field : DiracExteriorMatterCarrier,
    diracMatrixMatterAction leftChiralityProjector
        (chiralExteriorYukawaAction exteriorBreakingScalar field) =
      chiralExteriorYukawaAction exteriorBreakingScalar field
  chiralInput_right : ∀ field : DiracExteriorMatterCarrier,
    chiralExteriorYukawaAction exteriorBreakingScalar
        (diracMatrixMatterAction rightChiralityProjector field) =
      chiralExteriorYukawaAction exteriorBreakingScalar field
  chiralYukawa_equivariant : ∀ groupElement : SU7MotherGroup,
    (chiralExteriorYukawaAction
        (exteriorBreakingScalarRepresentation groupElement
          exteriorBreakingScalar)).comp
          (diracExteriorMatterGaugeRepresentation groupElement) =
      (diracExteriorMatterGaugeRepresentation groupElement).comp
        (chiralExteriorYukawaAction exteriorBreakingScalar)

theorem stageEightBBreakingYukawaReceipt :
    StageEightBBreakingYukawaReceipt where
  scalarCarrier_finrank := exteriorBreakingScalarCarrier_finrank
  breakingScalar_nonzero := exteriorBreakingScalar_ne_zero
  actualMotherElement_moves_breakingScalar :=
    exteriorBreakingScalar_is_genuinely_broken
  yukawaMassMap_equivariant :=
    exteriorYukawaMassMap_su7_equivariant
  yukawaPairing_invariant := exteriorYukawaPairing_su7_invariant
  nonzeroYukawaChannel := exteriorYukawaProbe_pairing_ne_zero
  chiralOutput_left :=
    chiralExteriorYukawaAction_output_left exteriorBreakingScalar
  chiralInput_right :=
    chiralExteriorYukawaAction_consumes_right exteriorBreakingScalar
  chiralYukawa_equivariant := fun groupElement =>
    chiralExteriorYukawaAction_su7_equivariant groupElement
      exteriorBreakingScalar

end
end SaturationMonoid.PhysicsCore.SU7ExteriorBreakingYukawa
