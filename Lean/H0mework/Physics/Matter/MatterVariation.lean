local instance matterCoordinateIndexFintype : Fintype MatterCoordinateIndex :=
  Fintype.ofFinite MatterCoordinateIndex

local instance p286ModuleFinite : Module.Finite ℝ P286LieBlockData :=
  FiniteDimensional.of_injective p286AmbientLinear
    p286AmbientLinear_injective

local instance p286CoordinateIndexFintype : Fintype P286CoordinateIndex :=
  StageNineP286GaugeConnectionActionVariation.p286CoordinateIndexFintype

local instance p286CoordinateIsTopologicalAddGroup :
    IsTopologicalAddGroup P286CoordinateCarrier where
  toContinuousAdd := inferInstance
  toContinuousNeg := inferInstance

def varyMatterCoordinates
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → MatterCoordinateCarrier) (parameter : ℝ) :
    StageNineHolonomicConfiguration :=
  { configuration with
    matter := fun point => matterCoordinateEquiv.symm
      (matterCoordinateEquiv (configuration.matter point) +
        parameter • variation point) }

@[simp] theorem varyMatterCoordinates_zero
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → MatterCoordinateCarrier) :
    varyMatterCoordinates configuration variation 0 = configuration := by
  cases configuration
  simp [varyMatterCoordinates]

def matterVariationCoordinateDerivative
    (variation : BasePoint → MatterCoordinateCarrier)
    (point : BasePoint) (direction : LorentzianIndex) :
    MatterCoordinateCarrier :=
  fieldDirectionalDerivative variation point direction

theorem matterCoordinateEquiv_symm_real_smul
    (parameter : ℝ) (coordinates : MatterCoordinateCarrier) :
    matterCoordinateEquiv.symm (parameter • coordinates) =
      parameter • matterCoordinateEquiv.symm coordinates := by
  change matterCoordinateEquiv.symm ((parameter : ℂ) • coordinates) =
    (parameter : ℂ) • matterCoordinateEquiv.symm coordinates
  exact map_smul matterCoordinateEquiv.symm (parameter : ℂ) coordinates

theorem diracExteriorMotherLieAction_matter_real_smul
    (matrix : SU7MotherLieMatrix) (parameter : ℝ)
    (matter : DiracExteriorMatterCarrier) :
    diracExteriorMotherLieAction matrix (parameter • matter) =
      parameter • diracExteriorMotherLieAction matrix matter := by
  change diracExteriorMotherLieAction matrix ((parameter : ℂ) • matter) =
    (parameter : ℂ) • diracExteriorMotherLieAction matrix matter
  exact map_smul (diracExteriorMotherLieAction matrix) (parameter : ℂ) matter

theorem chiralExteriorYukawaAction_matter_real_smul
    (scalar : ExteriorBreakingScalarCarrier) (parameter : ℝ)
    (matter : DiracExteriorMatterCarrier) :
    chiralExteriorYukawaAction scalar (parameter • matter) =
      parameter • chiralExteriorYukawaAction scalar matter := by
  change chiralExteriorYukawaAction scalar ((parameter : ℂ) • matter) =
    (parameter : ℂ) • chiralExteriorYukawaAction scalar matter
  exact map_smul (chiralExteriorYukawaAction scalar) (parameter : ℂ) matter

def holonomicMatterVariationCovariantDerivative
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → MatterCoordinateCarrier)
    (point : BasePoint) (direction : LorentzianIndex) :
    DiracExteriorMatterCarrier :=
  matterCoordinateEquiv.symm
      (matterVariationCoordinateDerivative variation point direction) +
    diracMatrixMatterAction
      (diracSpinConnectionLift
        (configuration.gravityConnection point) direction)
      (matterCoordinateEquiv.symm (variation point)) +
    diracExteriorMotherLieAction
      (p286LieBlockEmbed (configuration.gaugeConnection point direction))
      (matterCoordinateEquiv.symm (variation point))

theorem matterCoordinateDerivative_varyMatterCoordinates
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (variation : CompactlySupportedSmoothVariation MatterCoordinateCarrier)
    (parameter : ℝ) (point : BasePoint) (direction : LorentzianIndex) :
    fieldDirectionalDerivative
        (fun candidate => matterCoordinateEquiv
          ((varyMatterCoordinates configuration variation parameter).matter
            candidate)) point direction =
      fieldDirectionalDerivative
          (fun candidate => matterCoordinateEquiv
            (configuration.matter candidate)) point direction +
        parameter • matterVariationCoordinateDerivative variation point
          direction := by
  have backgroundSmooth : ContDiff ℝ ∞ fun candidate =>
      matterCoordinateEquiv (configuration.matter candidate) :=
    smooth.2.2.2.2.2.2.2.1
  have backgroundDifferentiable : DifferentiableAt ℝ
      (fun candidate => matterCoordinateEquiv
        (configuration.matter candidate)) point :=
    (backgroundSmooth.differentiable (by simp)).differentiableAt
  have variationDifferentiable : DifferentiableAt ℝ
      (variation : BasePoint → MatterCoordinateCarrier) point :=
    (variation.smooth.differentiable (by simp)).differentiableAt
  unfold fieldDirectionalDerivative matterVariationCoordinateDerivative
  simp only [varyMatterCoordinates, matterCoordinateEquiv.apply_symm_apply]
  have derivativeEquality :
      fderiv ℝ
          (fun candidate =>
            matterCoordinateEquiv (configuration.matter candidate) +
              parameter • variation candidate) point =
        fderiv ℝ
            (fun candidate => matterCoordinateEquiv
              (configuration.matter candidate)) point +
          parameter • fderiv ℝ variation point := by
    exact (backgroundDifferentiable.hasFDerivAt.add
      (variationDifferentiable.hasFDerivAt.const_smul parameter)).fderiv
  rw [derivativeEquality]
  simp [fieldDirectionalDerivative]

theorem holonomicMatterCovariantDerivative_varyMatterCoordinates
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (variation : CompactlySupportedSmoothVariation MatterCoordinateCarrier)
    (parameter : ℝ) (point : BasePoint) (direction : LorentzianIndex) :
    holonomicMatterCovariantDerivative
        (varyMatterCoordinates configuration variation parameter) point
        direction =
      holonomicMatterCovariantDerivative configuration point direction +
        parameter • holonomicMatterVariationCovariantDerivative configuration
          variation point direction := by
  unfold holonomicMatterCovariantDerivative
    holonomicMatterVariationCovariantDerivative
  rw [matterCoordinateDerivative_varyMatterCoordinates configuration smooth]
  simp only [varyMatterCoordinates, matterCoordinateEquiv.symm_apply_apply,
    map_add, matterCoordinateEquiv_symm_real_smul]
  rw [diracMatrixMatterAction_real_smul,
    diracExteriorMotherLieAction_matter_real_smul]
  module

def withMatterJets
    (field : StageNineContinuumPointField)
    (matter : DiracExteriorMatterCarrier)
    (matterDerivative : LorentzianIndex → DiracExteriorMatterCarrier) :
    StageNineContinuumPointField :=
  { field with
    matter := matter
    matterCovariantDerivative := matterDerivative }

theorem toContinuumPointField_varyMatterCoordinates
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (variation : CompactlySupportedSmoothVariation MatterCoordinateCarrier)
    (parameter : ℝ) (point : BasePoint) :
    toContinuumPointField
        (varyMatterCoordinates configuration variation parameter) point =
      withMatterJets (toContinuumPointField configuration point)
        (configuration.matter point +
          parameter • matterCoordinateEquiv.symm (variation point))
        (holonomicMatterCovariantDerivative configuration point +
          parameter • holonomicMatterVariationCovariantDerivative
            configuration variation point) := by
  apply StageNineContinuumPointField.ext
  all_goals try rfl
  · simp [toContinuumPointField, withMatterJets, varyMatterCoordinates, map_add,
      matterCoordinateEquiv_symm_real_smul]
  · funext direction
    exact holonomicMatterCovariantDerivative_varyMatterCoordinates
      configuration smooth variation parameter point direction

def matterFieldVariationVector
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (matterVariation : DiracExteriorMatterCarrier)
    (derivativeVariation : LorentzianIndex → DiracExteriorMatterCarrier) :
    DiracExteriorMatterCarrier :=
  Complex.I • matterGaugeKineticSum source 0 point field
      derivativeVariation +
    chiralExteriorYukawaAction
      (scalarCoordinateEquiv.symm field.scalar) matterVariation

def matterFirstVariationDensity
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (matterVariation : DiracExteriorMatterCarrier)
    (derivativeVariation : LorentzianIndex → DiracExteriorMatterCarrier) :
    ℝ :=
  generatedVolumeDensity field *
    (field.conjugateMatter
      (matterFieldVariationVector source point field matterVariation
        derivativeVariation)).re

@[simp] theorem matterDerivativeFrameRelative_zeroChart
    (source : SmoothUnifiedSource) (point : BasePoint)
    (derivative : LorentzianIndex → DiracExteriorMatterCarrier) :
    matterDerivativeFrameRelative source 0 point derivative = derivative := by
  funext direction
  exact matterFrameRelative_zeroChart source point (derivative direction)

theorem matterGaugeKineticSum_zeroChart
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (derivative : LorentzianIndex → DiracExteriorMatterCarrier) :
    matterGaugeKineticSum source 0 point field derivative =
      ∑ direction : LorentzianIndex,
        diracMatrixMatterAction
          (inverseCoframeDiracGamma
            { coframe := field.coframe, derivative := 0 } direction)
          (derivative direction) := by
  unfold matterGaugeKineticSum
  simp only [matterDerivativeFrameRelative_zeroChart]

theorem generatedContinuumMatterVector_withMatterJets_affine
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (matterVariation : DiracExteriorMatterCarrier)
    (derivativeVariation : LorentzianIndex → DiracExteriorMatterCarrier)
    (parameter : ℝ) :
    generatedContinuumMatterVector source 0 point
        (withMatterJets field
          (field.matter + parameter • matterVariation)
          (field.matterCovariantDerivative +
            parameter • derivativeVariation)) =
      generatedContinuumMatterVector source 0 point field +
        parameter • matterFieldVariationVector source point field
          matterVariation derivativeVariation := by
  unfold generatedContinuumMatterVector matterFieldVariationVector
  simp only [withMatterJets, scalarFrameRelativeCoordinates_zeroChart,
    matterFrameRelative_zeroChart, matterDerivativeFrameRelative_zeroChart,
    Pi.add_apply, Pi.smul_apply]
  rw [matterGaugeKineticSum_zeroChart source point field derivativeVariation]
  simp only [map_add, diracMatrixMatterAction_real_smul,
    Finset.sum_add_distrib, chiralExteriorYukawaAction_matter_real_smul]
  have sumRealSmul :
      (∑ direction : LorentzianIndex,
        parameter • diracMatrixMatterAction
          (inverseCoframeDiracGamma
            { coframe := field.coframe, derivative := 0 } direction)
          (derivativeVariation direction)) =
        parameter • ∑ direction : LorentzianIndex,
          diracMatrixMatterAction
            (inverseCoframeDiracGamma
              { coframe := field.coframe, derivative := 0 } direction)
            (derivativeVariation direction) := by
    change
      (∑ direction : LorentzianIndex,
        (parameter : ℂ) • diracMatrixMatterAction
          (inverseCoframeDiracGamma
            { coframe := field.coframe, derivative := 0 } direction)
          (derivativeVariation direction)) =
        (parameter : ℂ) • ∑ direction : LorentzianIndex,
          diracMatrixMatterAction
            (inverseCoframeDiracGamma
              { coframe := field.coframe, derivative := 0 } direction)
            (derivativeVariation direction)
    rw [Finset.smul_sum]
  rw [sumRealSmul]
  module

theorem generatedContinuumMatterDensity_withMatterJets_affine
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (matterVariation : DiracExteriorMatterCarrier)
    (derivativeVariation : LorentzianIndex → DiracExteriorMatterCarrier)
    (parameter : ℝ) :
    generatedContinuumMatterDensity source 0 point
        (withMatterJets field
          (field.matter + parameter • matterVariation)
          (field.matterCovariantDerivative +
            parameter • derivativeVariation)) =
      generatedContinuumMatterDensity source 0 point field +
        parameter *
          (field.conjugateMatter
            (matterFieldVariationVector source point field matterVariation
              derivativeVariation)).re := by
  unfold generatedContinuumMatterDensity
  change
    (matterDualFrameRelative source 0 point field.conjugateMatter
      (generatedContinuumMatterVector source 0 point
        (withMatterJets field
          (field.matter + parameter • matterVariation)
          (field.matterCovariantDerivative +
            parameter • derivativeVariation)))).re = _
  rw [generatedContinuumMatterVector_withMatterJets_affine, map_add,
    matterDualFrameRelative_real_smul]
  simp only [matterDualFrameRelative_zeroChart, Complex.add_re]
  simp [Complex.mul_re]

def holonomicMatterFirstVariationDensity
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → MatterCoordinateCarrier)
    (point : BasePoint) : ℝ :=
  matterFirstVariationDensity source point
    (toContinuumPointField configuration point)
    (matterCoordinateEquiv.symm (variation point))
    (holonomicMatterVariationCovariantDerivative configuration variation point)

theorem generatedUnifiedLocalDensity_withMatterJets_affine
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (matterVariation : DiracExteriorMatterCarrier)
    (derivativeVariation : LorentzianIndex → DiracExteriorMatterCarrier)
    (parameter : ℝ) :
    generatedUnifiedLocalDensityAtBoundary source
        (sourceGeneratedUnifiedCouplings source) 0 point
        (withMatterJets field
          (field.matter + parameter • matterVariation)
          (field.matterCovariantDerivative +
            parameter • derivativeVariation)) =
      generatedUnifiedLocalDensityAtBoundary source
          (sourceGeneratedUnifiedCouplings source) 0 point field +
        parameter * matterFirstVariationDensity source point field
          matterVariation derivativeVariation := by
  rw [generatedUnifiedLocalDensityAtBoundary,
    generatedUnifiedLocalDensityAtBoundary]
  unfold generatedUnifiedLocalDensityCoreAtBoundary
    generatedUnifiedLocalDensityNonGravityCoreAtBoundary
  rw [generatedContinuumMatterDensity_withMatterJets_affine]
  simp only [withMatterJets, generatedVolumeDensity,
    generatedGravitySimplicityDensity, generatedGravitySimplicityResidual,
    generatedGravityBFDensity, generatedScalarKineticDensity]
  unfold matterFirstVariationDensity generatedVolumeDensity
  ring

theorem holonomicLocalDensity_matter_affine
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (variation : CompactlySupportedSmoothVariation MatterCoordinateCarrier)
    (parameter : ℝ) (point : BasePoint) :
    generatedUnifiedLocalDensityAtBoundary source
        (sourceGeneratedUnifiedCouplings source) 0 point
        (toContinuumPointField
          (varyMatterCoordinates configuration variation parameter) point) =
      generatedUnifiedLocalDensityAtBoundary source
          (sourceGeneratedUnifiedCouplings source) 0 point
          (toContinuumPointField configuration point) +
        parameter * holonomicMatterFirstVariationDensity source configuration
          variation point := by
  rw [toContinuumPointField_varyMatterCoordinates configuration smooth]
  exact generatedUnifiedLocalDensity_withMatterJets_affine source point
    (toContinuumPointField configuration point)
    (matterCoordinateEquiv.symm (variation point))
    (holonomicMatterVariationCovariantDerivative configuration variation point)
    parameter

/-! ## Analytic control of the first density -/

theorem matterVariationCoordinateDerivative_continuous
    (variation : CompactlySupportedSmoothVariation MatterCoordinateCarrier)
    (direction : LorentzianIndex) :
    Continuous fun point =>
      matterVariationCoordinateDerivative variation point direction := by
  simpa [matterVariationCoordinateDerivative, fieldDirectionalDerivative] using
    compactVariation_directionalDerivative_continuous variation direction

set_option maxHeartbeats 1200000 in
theorem holonomicMatterVariationCovariantDerivative_coordinate_continuous
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (variation : CompactlySupportedSmoothVariation MatterCoordinateCarrier)
    (direction : LorentzianIndex) :
    Continuous fun point =>
      matterCoordinateEquiv
        (holonomicMatterVariationCovariantDerivative configuration variation
          point direction) := by
  have variationContinuous : Continuous
      (variation : BasePoint → MatterCoordinateCarrier) :=
    variation.smooth.continuous
  have variationMatterCoordinateContinuous : Continuous fun point =>
      matterCoordinateEquiv
        (matterCoordinateEquiv.symm (variation point)) := by
    simpa only [matterCoordinateEquiv.apply_symm_apply] using
      variationContinuous
  have derivativeContinuous :=
    matterVariationCoordinateDerivative_continuous variation direction
  have spinContinuous := diracMatrixMatterCoordinate_raw_apply_continuous
    (fun point =>
      diracSpinConnectionLift (configuration.gravityConnection point) direction)
    (fun point => matterCoordinateEquiv.symm (variation point))
    (holonomicGravitySpinLift_continuous configuration smooth direction)
    variationMatterCoordinateContinuous
  have gaugeCoordinateContinuous : Continuous fun point =>
      p286CoordinateEquiv (configuration.gaugeConnection point direction) :=
    (smooth.2.2.2.2.1 direction).continuous
  have gaugeContinuous := matterP286ActionCoordinate_apply_continuous
    (fun point => p286CoordinateEquiv
      (configuration.gaugeConnection point direction))
    (variation : BasePoint → MatterCoordinateCarrier)
    gaugeCoordinateContinuous variationContinuous
  unfold holonomicMatterVariationCovariantDerivative
  simp only [map_add, matterCoordinateEquiv.apply_symm_apply]
  exact (derivativeContinuous.add spinContinuous).add
    (gaugeContinuous.congr fun point => by
      change
        matterCoordinateEquiv
            (diracExteriorMotherLieAction
              (p286LieBlockEmbed
                (p286CoordinateEquiv.symm
                  (p286CoordinateEquiv
                    (configuration.gaugeConnection point direction))))
              (matterCoordinateEquiv.symm (variation point))) = _
      rw [p286CoordinateEquiv.symm_apply_apply])

theorem holonomicMatterVariationKineticSummand_coordinate_continuous
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate)
    (variation : CompactlySupportedSmoothVariation MatterCoordinateCarrier)
    (direction : LorentzianIndex) :
    Continuous fun point =>
      matterCoordinateEquiv
        (diracMatrixMatterAction
          (inverseCoframeDiracGamma
            { coframe := configuration.coframe point, derivative := 0 }
            direction)
          (holonomicMatterVariationCovariantDerivative configuration variation
            point direction)) :=
  diracMatrixMatterCoordinate_raw_apply_continuous _ _
    (holonomicInverseCoframeDiracGamma_continuous configuration smooth
      nondegenerate direction)
    (holonomicMatterVariationCovariantDerivative_coordinate_continuous
      configuration smooth variation direction)

theorem holonomicMatterVariationKineticSum_coordinate_continuous
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate)
    (variation : CompactlySupportedSmoothVariation MatterCoordinateCarrier) :
    Continuous fun point =>
      matterCoordinateEquiv
        (matterGaugeKineticSum source 0 point
          (toContinuumPointField configuration point)
          (holonomicMatterVariationCovariantDerivative configuration variation
            point)) := by
  have sumContinuous : Continuous fun point =>
      ∑ direction : LorentzianIndex,
        matterCoordinateEquiv
          (diracMatrixMatterAction
            (inverseCoframeDiracGamma
              { coframe := configuration.coframe point, derivative := 0 }
              direction)
            (holonomicMatterVariationCovariantDerivative configuration variation
              point direction)) := by
    apply continuous_finsetSum
    intro direction _
    exact holonomicMatterVariationKineticSummand_coordinate_continuous
      configuration smooth nondegenerate variation direction
  exact sumContinuous.congr fun point => by
    unfold matterGaugeKineticSum matterDerivativeFrameRelative
    simp only [toContinuumPointField, matterFrameRelative_zeroChart, map_sum]

theorem holonomicMatterVariationYukawaVector_coordinate_continuous
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (variation : CompactlySupportedSmoothVariation MatterCoordinateCarrier) :
    Continuous fun point =>
      matterCoordinateEquiv
        (chiralExteriorYukawaAction
          (scalarCoordinateEquiv.symm (configuration.scalar point))
          (matterCoordinateEquiv.symm (variation point))) := by
  exact chiralYukawaCoordinate_apply_continuous configuration.scalar variation
    smooth.2.2.2.2.2.2.1.continuous variation.smooth.continuous

theorem holonomicMatterFieldVariationVector_coordinate_continuous
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate)
    (variation : CompactlySupportedSmoothVariation MatterCoordinateCarrier) :
    Continuous fun point =>
      matterCoordinateEquiv
        (matterFieldVariationVector source point
          (toContinuumPointField configuration point)
          (matterCoordinateEquiv.symm (variation point))
          (holonomicMatterVariationCovariantDerivative configuration variation
            point)) := by
  have kineticContinuous :=
    holonomicMatterVariationKineticSum_coordinate_continuous source
      configuration smooth nondegenerate variation
  have kineticWithIContinuous : Continuous fun point =>
      Complex.I • matterCoordinateEquiv
        (matterGaugeKineticSum source 0 point
          (toContinuumPointField configuration point)
          (holonomicMatterVariationCovariantDerivative configuration variation
            point)) :=
    ((continuous_const : Continuous fun _ : BasePoint => Complex.I).smul
      kineticContinuous).congr fun point => rfl
  have yukawaContinuous :=
    holonomicMatterVariationYukawaVector_coordinate_continuous configuration
      smooth variation
  have actual := kineticWithIContinuous.add yukawaContinuous
  unfold matterFieldVariationVector
  exact actual.congr fun point => by
    simp only [Pi.add_apply, toContinuumPointField]
    rw [map_add, map_smul]

theorem holonomicMatterFirstVariationDensity_continuous
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate)
    (variation : CompactlySupportedSmoothVariation MatterCoordinateCarrier) :
    Continuous
      (holonomicMatterFirstVariationDensity source configuration variation) := by
  have coframeContinuous := holonomicCoframe_continuous configuration smooth
  have volumeContinuous : Continuous fun point =>
      generatedVolumeDensity (toContinuumPointField configuration point) :=
    coframeContinuous.matrix_det.abs
  have vectorContinuous :=
    holonomicMatterFieldVariationVector_coordinate_continuous source
      configuration smooth nondegenerate variation
  have pairingSumContinuous : Continuous fun point =>
      ∑ index : MatterCoordinateIndex,
        matterCoordinateEquiv
            (matterFieldVariationVector source point
              (toContinuumPointField configuration point)
              (matterCoordinateEquiv.symm (variation point))
              (holonomicMatterVariationCovariantDerivative configuration
                variation point)) index *
          configuration.conjugateMatter point
            (matterCoordinateEquiv.symm
              (EuclideanSpace.single index (1 : ℂ))) := by
    apply continuous_finsetSum
    intro index _
    have vectorCoordinateContinuous : Continuous fun point =>
        matterCoordinateEquiv
          (matterFieldVariationVector source point
            (toContinuumPointField configuration point)
            (matterCoordinateEquiv.symm (variation point))
            (holonomicMatterVariationCovariantDerivative configuration variation
              point)) index :=
      (PiLp.continuous_apply 2
        (fun _ : MatterCoordinateIndex => ℂ) index).comp vectorContinuous
    have dualCoordinateContinuous : Continuous fun point =>
        configuration.conjugateMatter point
          (matterCoordinateEquiv.symm
            (EuclideanSpace.single index (1 : ℂ))) :=
      (smooth.2.2.2.2.2.2.2.2 index).continuous
    exact vectorCoordinateContinuous.mul dualCoordinateContinuous
  have dualPairingContinuous : Continuous fun point =>
      configuration.conjugateMatter point
        (matterFieldVariationVector source point
          (toContinuumPointField configuration point)
          (matterCoordinateEquiv.symm (variation point))
          (holonomicMatterVariationCovariantDerivative configuration variation
            point)) :=
    pairingSumContinuous.congr fun point => by
      simpa only [matterCoordinateEquiv.symm_apply_apply] using
        (matterDual_coordinate_expansion (configuration.conjugateMatter point)
          (matterCoordinateEquiv
            (matterFieldVariationVector source point
              (toContinuumPointField configuration point)
              (matterCoordinateEquiv.symm (variation point))
              (holonomicMatterVariationCovariantDerivative configuration
                variation point)))).symm
  have realPairingContinuous := Complex.continuous_re.comp dualPairingContinuous
  unfold holonomicMatterFirstVariationDensity matterFirstVariationDensity
  exact volumeContinuous.mul realPairingContinuous

theorem compactMatterVariation_eventually_jet_zero
    (variation : CompactlySupportedSmoothVariation MatterCoordinateCarrier) :
    ∀ᶠ point in Filter.coclosedCompact BasePoint,
      variation point = 0 ∧
        ∀ direction : LorentzianIndex,
          matterVariationCoordinateDerivative variation point direction = 0 := by
  have variationEventually := variation.compactSupport
  rw [hasCompactSupport_iff_eventuallyEq] at variationEventually
  have derivativeEventually : ∀ direction : LorentzianIndex,
      ∀ᶠ point in Filter.coclosedCompact BasePoint,
        fderiv ℝ (variation : BasePoint → MatterCoordinateCarrier) point
          (coordinateDirection direction) = 0 := by
    intro direction
    have actual := compactVariation_directionalDerivative_compact variation
      direction
    rw [hasCompactSupport_iff_eventuallyEq] at actual
    exact actual
  have everyDerivativeEventually :=
    Filter.eventually_all.2 derivativeEventually
  filter_upwards [variationEventually, everyDerivativeEventually] with
    point variationZero derivativeZero
  refine ⟨variationZero, ?_⟩
  intro direction
  simpa [matterVariationCoordinateDerivative, fieldDirectionalDerivative] using
    derivativeZero direction

theorem holonomicMatterVariationCovariantDerivative_eq_zero_of_jet_zero
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → MatterCoordinateCarrier) (point : BasePoint)
    (variationZero : variation point = 0)
    (derivativeZero : ∀ direction : LorentzianIndex,
      matterVariationCoordinateDerivative variation point direction = 0) :
    holonomicMatterVariationCovariantDerivative configuration variation point =
      0 := by
  funext direction
  unfold holonomicMatterVariationCovariantDerivative
  rw [derivativeZero direction, variationZero]
  simp

@[simp] theorem matterFieldVariationVector_zero
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField) :
    matterFieldVariationVector source point field 0 0 = 0 := by
  unfold matterFieldVariationVector matterGaugeKineticSum
  simp

theorem holonomicMatterFirstVariationDensity_eq_zero_of_jet_zero
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → MatterCoordinateCarrier) (point : BasePoint)
    (variationZero : variation point = 0)
    (derivativeZero : ∀ direction : LorentzianIndex,
      matterVariationCoordinateDerivative variation point direction = 0) :
    holonomicMatterFirstVariationDensity source configuration variation point =
      0 := by
  have covariantDerivativeZero :=
    holonomicMatterVariationCovariantDerivative_eq_zero_of_jet_zero
      configuration variation point variationZero derivativeZero
  unfold holonomicMatterFirstVariationDensity matterFirstVariationDensity
  rw [show matterCoordinateEquiv.symm (variation point) = 0 by
    simp [variationZero], covariantDerivativeZero]
  simp

theorem holonomicMatterFirstVariationDensity_compact
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (variation : CompactlySupportedSmoothVariation MatterCoordinateCarrier) :
    HasCompactSupport
      (holonomicMatterFirstVariationDensity source configuration variation) := by
  rw [hasCompactSupport_iff_eventuallyEq]
  filter_upwards [compactMatterVariation_eventually_jet_zero variation] with
    point jetZero
  exact holonomicMatterFirstVariationDensity_eq_zero_of_jet_zero source
    configuration variation point jetZero.1 jetZero.2

theorem holonomicMatterFirstVariationDensity_integrable
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate)
    (variation : CompactlySupportedSmoothVariation MatterCoordinateCarrier) :
    Integrable
      (holonomicMatterFirstVariationDensity source configuration variation) :=
  (holonomicMatterFirstVariationDensity_continuous source configuration smooth
    nondegenerate variation).integrable_of_hasCompactSupport
      (holonomicMatterFirstVariationDensity_compact source configuration
        variation)

/-! ## Integrated affine law and weak adjoint matter equation -/

theorem holonomicIntegratedUnifiedAction_matter_affine
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate)
    (densityIntegrable : HolonomicLocalDensityIntegrable source 0 configuration)
    (variation : CompactlySupportedSmoothVariation MatterCoordinateCarrier)
    (parameter : ℝ) :
    holonomicIntegratedUnifiedAction source 0
        (varyMatterCoordinates configuration variation parameter) =
      holonomicIntegratedUnifiedAction source 0 configuration +
        parameter *
          (∫ point : BasePoint,
            holonomicMatterFirstVariationDensity source configuration variation
              point) := by
  unfold holonomicIntegratedUnifiedAction
    sourceGeneratedIntegratedUnifiedAction integratedUnifiedActionAtBoundary
  simp only [toContinuumFieldSection]
  have pointwise : (fun point : BasePoint =>
      generatedUnifiedLocalDensityAtBoundary source
        (sourceGeneratedUnifiedCouplings source) 0 point
        (toContinuumPointField
          (varyMatterCoordinates configuration variation parameter) point)) =
      fun point =>
        generatedUnifiedLocalDensityAtBoundary source
          (sourceGeneratedUnifiedCouplings source) 0 point
          (toContinuumPointField configuration point) +
        parameter * holonomicMatterFirstVariationDensity source configuration
          variation point := by
    funext point
    exact holonomicLocalDensity_matter_affine source configuration smooth
      variation parameter point
  rw [pointwise]
  have firstIntegrable := holonomicMatterFirstVariationDensity_integrable
    source configuration smooth nondegenerate variation
  rw [integral_add densityIntegrable
    (firstIntegrable.const_mul parameter), integral_const_mul]

theorem holonomicIntegratedUnifiedAction_matter_hasDerivAt
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate)
    (densityIntegrable : HolonomicLocalDensityIntegrable source 0 configuration)
    (variation : CompactlySupportedSmoothVariation MatterCoordinateCarrier) :
    HasDerivAt
      (fun parameter => holonomicIntegratedUnifiedAction source 0
        (varyMatterCoordinates configuration variation parameter))
      (∫ point : BasePoint,
        holonomicMatterFirstVariationDensity source configuration variation
          point) 0 := by
  let firstIntegral := ∫ point : BasePoint,
    holonomicMatterFirstVariationDensity source configuration variation point
  have actionEquality :
      (fun parameter => holonomicIntegratedUnifiedAction source 0
        (varyMatterCoordinates configuration variation parameter)) =
      fun parameter =>
        holonomicIntegratedUnifiedAction source 0 configuration +
          parameter * firstIntegral := by
    funext parameter
    exact holonomicIntegratedUnifiedAction_matter_affine source configuration
      smooth nondegenerate densityIntegrable variation parameter
  rw [actionEquality]
  simpa using
    ((hasDerivAt_id (x := 0)).mul_const firstIntegral).const_add
      (holonomicIntegratedUnifiedAction source 0 configuration)

def CanonicalMatterActionStationary
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration) : Prop :=
  ∀ variation : CompactlySupportedSmoothVariation MatterCoordinateCarrier,
    HasDerivAt
      (fun parameter => holonomicIntegratedUnifiedAction source 0
        (varyMatterCoordinates configuration variation parameter))
      0 0

def CanonicalMatterWeakEquation
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration) : Prop :=
  ∀ variation : CompactlySupportedSmoothVariation MatterCoordinateCarrier,
    (∫ point : BasePoint,
      holonomicMatterFirstVariationDensity source configuration variation
        point) = 0

theorem canonicalMatterActionStationary_implies_weakEquation
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate)
    (densityIntegrable : HolonomicLocalDensityIntegrable source 0 configuration)
    (stationary : CanonicalMatterActionStationary source configuration) :
    CanonicalMatterWeakEquation source configuration := by
  intro variation
  have actual := holonomicIntegratedUnifiedAction_matter_hasDerivAt source
    configuration smooth nondegenerate densityIntegrable variation
  exact ((stationary variation).unique actual).symm

end

