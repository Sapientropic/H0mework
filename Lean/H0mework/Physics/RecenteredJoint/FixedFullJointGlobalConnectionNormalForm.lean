import H0mework.Physics.ConstrainedCauchy.ConnectionJetReadout
import H0mework.Physics.RecenteredJoint.FixedFullJointAction

/-!
# Fixed canonical full-joint section: global connection normal form

The source/current-generated full-joint contact family is sampled only on
each contact's canonical time axis.  Since the authoritative KIN-12
connection is normalized affine in its local spacetime argument, the one
assembled four-dimensional connection has the exact global form

`omega(t, x) = Omega(x) + t * V(x)`.

Both `Omega` and `V` below are read from the same action-generated contact.
No residual value, support coordinate, branch, target field, or zero-fiber
witness enters their definitions.  The spatial derivative comparison with
the complete local KIN-12 first jet is deliberately retained as one tensor;
it is not used to construct a correction.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeFixedP506P286CanonicalRecenteredSectionCartanFullJointGlobalConnectionNormalForm

open ProofFreeRicherAnholonomicSource
open PointwiseDiracSpinConnectionLift
open StageNineCanonicalCauchyState
open StageNineDiracDualFormNativeConstitutiveJointActionSpatialSectionOperator
open StageNineDiracDualFormNativeECFullCauchyConnectionJetReadout
open StageNineDiracDualFormNativeECFullCauchyLocalActualLift
open StageNineDiracDualFormNativeFixedP506P286CanonicalRecenteredSectionCartanFullJointAction
open StageNineDiracDualFormNativeFixedP506P286CanonicalRecenteredSectionCartanRestart
open StageNineDiracDualFormNativeRepairedConstitutiveJointActionResponseOperator
open StageNineEnrichedProofFreeSource
open StageNineHolonomicField
open StageNineP286ActionCauchySplit
open StageNineP286ActionConnectionVelocity
open StageNinePositiveSourceGravityMouthNormalizedAffineConnectionGerm
open StageNineLorentzConnectionVariation
open StageNineSourceActionGeneratedP506MatterCurrentCanonicalLorentzAdjointDiagonalActual

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1800000
set_option maxRecDepth 100000

private abbrev CartanSectionCurrent : StageNineHolonomicConfiguration :=
  fixedP506L0P286CanonicalRecenteredSectionCartanRestartActual

private abbrev FullJointActual : StageNineHolonomicConfiguration :=
  fixedP506L0P286CanonicalRecenteredSectionCartanFullJointActual

/-- The current consumed by the final EC write at one source-owned spatial
occurrence.  It is generated by the repaired matter and live constitutive
writes from the recentered global Cartan current. -/
def fixedP506L0P286CanonicalRecenteredSectionCartanFullJointPreparedCurrent
    (space : StageNineSpatialPoint) : StageNineHolonomicConfiguration :=
  diracDualFormNativeRepairedConstitutiveWrittenCurrent
    positiveSmoothUnifiedSource
    (spatiallyRecenterHolonomicConfiguration CartanSectionCurrent space)

/-- The generated origin value of the final normalized-affine EC connection
at one contact. -/
def fixedP506L0P286CanonicalRecenteredSectionCartanFullJointConnectionOrigin
    (space : StageNineSpatialPoint) : PointwiseLorentzSpinConnection :=
  sourceActionGeneratedDiracDualECFullCauchyConnectionOrigin
    positiveSmoothUnifiedSource
    (fixedP506L0P286CanonicalRecenteredSectionCartanFullJointPreparedCurrent
      space)

/-- The generated curvature target of the same final EC contact. -/
def fixedP506L0P286CanonicalRecenteredSectionCartanFullJointCurvatureTarget
    (space : StageNineSpatialPoint) : PhysicalBivector :=
  sourceActionGeneratedDiracDualECFullCauchyCurvatureTarget
    positiveSmoothUnifiedSource
    (fixedP506L0P286CanonicalRecenteredSectionCartanFullJointPreparedCurrent
      space)

/-- The exact time-axis coefficient of the normalized-affine connection.
This is an action readout from the generated origin and curvature target, not
an independently supplied velocity. -/
def fixedP506L0P286CanonicalRecenteredSectionCartanFullJointConnectionTimeVelocity
    (space : StageNineSpatialPoint) : PointwiseLorentzSpinConnection :=
  lorentzSkewConnectionOfBivectorOneForm
    (normalizedAffineBivectorOneForm
      (fixedP506L0P286CanonicalRecenteredSectionCartanFullJointConnectionOrigin
        space)
      (fixedP506L0P286CanonicalRecenteredSectionCartanFullJointCurvatureTarget
        space)
      (coordinateDirection canonicalLorentzianTimeDirection))

private theorem canonicalCauchyTimeAxis_eq_smul
    (time : ℝ) :
    canonicalCauchySlicePoint time (0 : StageNineSpatialPoint) =
      time • coordinateDirection canonicalLorentzianTimeDirection := by
  apply PiLp.ext
  intro direction
  fin_cases direction <;>
    simp [canonicalCauchySlicePoint, canonicalLorentzianTimeDirection,
      coordinateDirection, Fin.sum_univ_three]

/-- A normalized-affine bivector one-form is exactly linear on the canonical
time axis. -/
theorem normalizedAffineBivectorOneForm_canonicalTimeAxis
    (omega0 : PointwiseLorentzSpinConnection)
    (target : PhysicalBivector)
    (time : ℝ) :
    normalizedAffineBivectorOneForm omega0 target
        (canonicalCauchySlicePoint time 0) =
      time •
        normalizedAffineBivectorOneForm omega0 target
          (coordinateDirection canonicalLorentzianTimeDirection) := by
  funext formDirection internalPair
  unfold normalizedAffineBivectorOneForm
  rw [canonicalCauchyTimeAxis_eq_smul, map_smul]
  rfl

@[simp] theorem
    fixedP506L0P286CanonicalRecenteredSectionCartanFullJointActual_gravityConnection_slice
    (time : ℝ) (space : StageNineSpatialPoint) :
    FullJointActual.gravityConnection
        (canonicalCauchySlicePoint time space) =
      (fixedP506L0P286CanonicalRecenteredSectionCartanFullJointContactActual
        space).gravityConnection (canonicalCauchySlicePoint time 0) := by
  simp [FullJointActual,
    fixedP506L0P286CanonicalRecenteredSectionCartanFullJointActual,
    spatialContactTimeAxisDiagonal]

theorem
    fixedP506L0P286CanonicalRecenteredSectionCartanFullJointContactActual_connection_eq_normalizedAffine
    (space : StageNineSpatialPoint) :
    (fixedP506L0P286CanonicalRecenteredSectionCartanFullJointContactActual
      space).gravityConnection =
      normalizedAffineLorentzConnectionField
        (fixedP506L0P286CanonicalRecenteredSectionCartanFullJointConnectionOrigin
          space)
        (fixedP506L0P286CanonicalRecenteredSectionCartanFullJointCurvatureTarget
          space) := by
  change
    (sourceActionGeneratedDiracDualECFullCauchyLocalActualLift
      positiveSmoothUnifiedSource
      (fixedP506L0P286CanonicalRecenteredSectionCartanFullJointPreparedCurrent
        space)).gravityConnection = _
  exact
    sourceActionGeneratedDiracDualECFullCauchyLocalActualLift_connection_eq_normalizedAffine
      positiveSmoothUnifiedSource _

/-- Exact global normal form of the strongest existing full-joint connection
producer.  The spatial parameter selects the source-owned contact; the local
normalized-affine germ contributes only its generated time-axis coefficient.
-/
theorem
    fixedP506L0P286CanonicalRecenteredSectionCartanFullJointActual_gravityConnection_normalForm
    (point : BasePoint) :
    FullJointActual.gravityConnection point =
      fixedP506L0P286CanonicalRecenteredSectionCartanFullJointConnectionOrigin
          (canonicalSpatialProjection point) +
        canonicalTimeProjection point •
          fixedP506L0P286CanonicalRecenteredSectionCartanFullJointConnectionTimeVelocity
            (canonicalSpatialProjection point) := by
  rw [← canonicalCauchySlicePoint_projections point]
  rw [
    fixedP506L0P286CanonicalRecenteredSectionCartanFullJointActual_gravityConnection_slice,
    fixedP506L0P286CanonicalRecenteredSectionCartanFullJointContactActual_connection_eq_normalizedAffine]
  unfold normalizedAffineLorentzConnectionField
  rw [normalizedAffineBivectorOneForm_canonicalTimeAxis]
  rw [lorentzSkewConnectionOfBivectorOneForm_smul]
  simp only [canonicalSpatialProjection_slice, canonicalTimeProjection_slice,
    fixedP506L0P286CanonicalRecenteredSectionCartanFullJointConnectionTimeVelocity]

/-- The zero slice of the global section retains exactly the generated
contact-origin connection value. -/
theorem
    fixedP506L0P286CanonicalRecenteredSectionCartanFullJointActual_gravityConnection_zeroSlice
    (space : StageNineSpatialPoint) :
    FullJointActual.gravityConnection (canonicalCauchySlicePoint 0 space) =
      fixedP506L0P286CanonicalRecenteredSectionCartanFullJointConnectionOrigin
        space := by
  rw [
    fixedP506L0P286CanonicalRecenteredSectionCartanFullJointActual_gravityConnection_normalForm]
  simp only [canonicalTimeProjection_slice, canonicalSpatialProjection_slice,
    zero_smul, add_zero]

/-- Complete action-generated local KIN-12 lowered first jet at one matching
contact. -/
def fixedP506L0P286CanonicalRecenteredSectionCartanFullJointLocalLoweredFirstJet
    (space : StageNineSpatialPoint)
    (derivativeDirection formDirection : LorentzianIndex)
    (internalPair : Fin 6) : ℝ :=
  sourceActionGeneratedDiracDualECFullCauchyLoweredConnectionFirstJet
    positiveSmoothUnifiedSource
    (fixedP506L0P286CanonicalRecenteredSectionCartanFullJointPreparedCurrent
      space)
    derivativeDirection formDirection internalPair

/-- The generated global time coefficient is exactly the temporal row of the
same contact's complete KIN-12 lowered first jet. -/
theorem
    fixedP506L0P286CanonicalRecenteredSectionCartanFullJointConnectionTimeVelocity_lowered_eq_localFirstJet
    (space : StageNineSpatialPoint)
    (formDirection : LorentzianIndex)
    (internalPair : Fin 6) :
    loweredLorentzConnectionCoefficient
        (fixedP506L0P286CanonicalRecenteredSectionCartanFullJointConnectionTimeVelocity
          space)
        formDirection internalPair =
      fixedP506L0P286CanonicalRecenteredSectionCartanFullJointLocalLoweredFirstJet
        space canonicalLorentzianTimeDirection formDirection internalPair := by
  rw [
    fixedP506L0P286CanonicalRecenteredSectionCartanFullJointLocalLoweredFirstJet,
    sourceActionGeneratedDiracDualECFullCauchyLoweredConnectionFirstJet_eq_sum]
  unfold
    fixedP506L0P286CanonicalRecenteredSectionCartanFullJointConnectionTimeVelocity
  rw [loweredLorentzConnectionCoefficient_ofBivectorOneForm]
  unfold normalizedAffineBivectorOneForm
    normalizedAffineBivectorComponentLinear
  simp only [sum_apply, smul_apply, smul_eq_mul]
  congr 1
  funext spacetimePair
  congr 1
  rw [Finset.sum_eq_single canonicalLorentzianTimeDirection]
  · rw [baseCoordinate_coordinateDirection]
    simp
  · intro other _ otherNe
    rw [baseCoordinate_coordinateDirection]
    simp [otherNe]
  · simp

/-- The one whole spatial compatibility tensor to be tested when comparing
the global diagonal with every local KIN-12 first germ.  It records the
derivative of the generated origin family minus the action-generated local
spatial row.  It is a downstream observation and is not a write. -/
def fixedP506L0P286CanonicalRecenteredSectionCartanFullJointSpatialJetSeam
    (space : StageNineSpatialPoint)
    (axis : Fin 3)
    (formDirection : LorentzianIndex)
    (internalPair : Fin 6) : ℝ :=
  minkowskiInternalSign (pairFirst internalPair) *
      fderiv ℝ
        (fun candidate : StageNineSpatialPoint =>
          fixedP506L0P286CanonicalRecenteredSectionCartanFullJointConnectionOrigin
              candidate formDirection
            (pairFirst internalPair) (pairSecond internalPair))
        space (canonicalSpatialCoordinateDirection axis) -
    fixedP506L0P286CanonicalRecenteredSectionCartanFullJointLocalLoweredFirstJet
      space axis.succ formDirection internalPair

end

end
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeFixedP506P286CanonicalRecenteredSectionCartanFullJointGlobalConnectionNormalForm
