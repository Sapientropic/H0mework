import H0mework.Physics.Cartan.CartanAffineConnectionActualization
import H0mework.Physics.Coframe.CoframeLocalDifferentiability
import H0mework.Physics.IdentityGerms.CoframeHessianUpdate
import H0mework.Physics.Geometry.GravityBianchi

/-!
# Identity-contact holonomic EC Hessian local actual lift

This module installs one already generated holonomic coframe-Hessian
increment into the primitive Stage-9 fields.  The same increment produces

* a quadratic coframe germ;
* its derived simple auxiliary `B := II+(e)`; and
* the complete affine first jet of the Levi--Civita spin connection computed
  forward from that Hessian.

The literal holonomic curvature of the updated primitive connection therefore
changes at the origin by exactly
`identityECLeviCivitaCurvatureOfCoframeHessian increment`.  This is the
actual-field seam missing from the preceding finite-dimensional section; no
curvature target, inverse, residual endpoint, branch, or acceptance receipt
is supplied to the constructor.

Jurisdiction is the origin/local germ.  A quadratic polynomial coframe need
not be nondegenerate on the whole noncompact base.  Moreover, changing
`e`, `B`, and `omega` invalidates any reaction receipt belonging to the old
actual; the live reaction and the six Cartan/spin rows must be recomputed on
the new common actual.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeIdentityECHolonomicCoframeHessianLocalActualLift

open ProofFreeRicherAnholonomicSource
open PointwiseDiracSpinConnectionLift
open StageNineCartanAffineConnectionActualization
open StageNineCoframeFirstJet
open StageNineCoframeHolonomicSecondJetCarrier
open StageNineCoframeLocalDifferentiability
open StageNineDiracDualFormNativeIdentityECCurvatureNormalSection
open StageNineDiracDualFormNativeIdentityECHolonomicCoframeHessianSection
open StageNineDiracDualFormNativeIdentityECHolonomicCoframeHessianUpdate
open StageNineDiracDualFormNativeSynchronizedECNormalLocalActualLift
open StageNineEnrichedProofFreeSource
open StageNineGlobalIntegratedAction
open StageNineGravityBianchi
open StageNineHolonomicField
open StageNineLinearPlebanskiCoframeActionPrincipal
open StageNineLorentzConnectionVariation
open scoped ContDiff Matrix.Norms.Elementwise

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 2400000

/-! ## Forward affine Levi--Civita first jet -/

/-- Lowered six-coordinate form of the complete Levi--Civita connection
first jet generated by a holonomic coframe Hessian. -/
def identityECLeviCivitaLoweredConnectionFirstJet
    (hessian : CoframeHolonomicSecondJet)
    (derivativeDirection formDirection : LorentzianIndex)
    (internalPair : Fin 6) : ℝ :=
  minkowskiInternalSign (lorentzBivectorFirst internalPair) *
    identityECLeviCivitaSpinConnectionFirstJet hessian
      derivativeDirection formDirection
      (lorentzBivectorFirst internalPair)
      (lorentzBivectorSecond internalPair)

/-- One affine lower-connection component as a continuous linear functional
of the base coordinate. -/
def identityECLeviCivitaAffineBivectorComponentLinear
    (hessian : CoframeHolonomicSecondJet)
    (formDirection : LorentzianIndex)
    (internalPair : Fin 6) : BasePoint →L[ℝ] ℝ :=
  ∑ derivativeDirection : LorentzianIndex,
    identityECLeviCivitaLoweredConnectionFirstJet hessian
        derivativeDirection formDirection internalPair •
      coframeBaseCoordinate derivativeDirection

/-- Complete lowered affine one-form carrying the generated LC first jet. -/
def identityECLeviCivitaAffineBivectorOneForm
    (hessian : CoframeHolonomicSecondJet)
    (point : BasePoint) : LorentzBivectorOneForm :=
  fun formDirection internalPair =>
    identityECLeviCivitaAffineBivectorComponentLinear hessian
      formDirection internalPair point

/-- Primitive Lorentz-skew connection increment obtained from the complete
lowered LC first jet. -/
def identityECLeviCivitaAffineConnectionIncrement
    (hessian : CoframeHolonomicSecondJet) : LorentzConnectionField :=
  fun point =>
    lorentzSkewConnectionOfBivectorOneForm
      (identityECLeviCivitaAffineBivectorOneForm hessian point)

@[simp] theorem identityECLeviCivitaAffineBivectorOneForm_origin
    (hessian : CoframeHolonomicSecondJet) :
    identityECLeviCivitaAffineBivectorOneForm hessian 0 = 0 := by
  funext formDirection internalPair
  simp [identityECLeviCivitaAffineBivectorOneForm]

@[simp] theorem identityECLeviCivitaAffineConnectionIncrement_origin
    (hessian : CoframeHolonomicSecondJet) :
    identityECLeviCivitaAffineConnectionIncrement hessian 0 = 0 := by
  simp [identityECLeviCivitaAffineConnectionIncrement]

theorem identityECLeviCivitaAffineConnectionIncrement_smooth
    (hessian : CoframeHolonomicSecondJet) :
    ∀ formDirection internalOut internalIn,
      ContDiff ℝ ∞ fun point =>
        identityECLeviCivitaAffineConnectionIncrement hessian point
          formDirection internalOut internalIn := by
  intro formDirection internalOut internalIn
  unfold identityECLeviCivitaAffineConnectionIncrement
    identityECLeviCivitaAffineBivectorOneForm
    lorentzSkewConnectionOfBivectorOneForm
    loweredLorentzBivectorMatrix
  fun_prop

theorem identityECLeviCivitaAffineConnectionIncrement_lorentzSkew
    (hessian : CoframeHolonomicSecondJet) (point : BasePoint) :
    LorentzSkew
      (identityECLeviCivitaAffineConnectionIncrement hessian point) :=
  lorentzSkewConnectionOfBivectorOneForm_lorentzSkew _

theorem identityECLeviCivitaAffineBivectorOneForm_directionalDerivative_origin
    (hessian : CoframeHolonomicSecondJet)
    (derivativeDirection formDirection : LorentzianIndex)
    (internalPair : Fin 6) :
    fieldDirectionalDerivative
        (fun point =>
          identityECLeviCivitaAffineBivectorOneForm hessian point
            formDirection internalPair)
        0 derivativeDirection =
      identityECLeviCivitaLoweredConnectionFirstJet hessian
        derivativeDirection formDirection internalPair := by
  unfold fieldDirectionalDerivative identityECLeviCivitaAffineBivectorOneForm
  rw [(identityECLeviCivitaAffineBivectorComponentLinear hessian
    formDirection internalPair).hasFDerivAt.fderiv]
  fin_cases derivativeDirection <;>
    simp [identityECLeviCivitaAffineBivectorComponentLinear,
      coframeBaseCoordinate, coordinateDirection, Fin.sum_univ_four]

/-- The raised primitive connection increment has the complete LC first jet,
not merely its antisymmetric curvature quotient. -/
theorem identityECLeviCivitaAffineConnectionIncrement_directionalDerivative_origin
    (hessian : CoframeHolonomicSecondJet)
    (derivativeDirection formDirection : LorentzianIndex)
    (internalPair : Fin 6) :
    fieldDirectionalDerivative
        (fun point =>
          identityECLeviCivitaAffineConnectionIncrement hessian point
            formDirection (pairFirst internalPair) (pairSecond internalPair))
        0 derivativeDirection =
      identityECLeviCivitaSpinConnectionFirstJet hessian
        derivativeDirection formDirection
        (pairFirst internalPair) (pairSecond internalPair) := by
  let component : BasePoint →L[ℝ] ℝ :=
    ∑ candidateDirection : LorentzianIndex,
      identityECLeviCivitaSpinConnectionFirstJet hessian
          candidateDirection formDirection
          (pairFirst internalPair) (pairSecond internalPair) •
        coframeBaseCoordinate candidateDirection
  have fieldEquality :
      (fun point =>
        identityECLeviCivitaAffineConnectionIncrement hessian point
          formDirection (pairFirst internalPair) (pairSecond internalPair)) =
        component := by
    funext point
    fin_cases internalPair <;>
      simp [component, identityECLeviCivitaAffineConnectionIncrement,
        identityECLeviCivitaAffineBivectorOneForm,
        identityECLeviCivitaAffineBivectorComponentLinear,
        identityECLeviCivitaLoweredConnectionFirstJet,
        lorentzSkewConnectionOfBivectorOneForm,
        loweredLorentzBivectorMatrix,
        orientedLorentzBivectorBasisCoefficient,
        lorentzBivectorFirst, lorentzBivectorSecond,
        pairFirst, pairSecond, minkowskiInternalSign,
        Fin.sum_univ_six]
  unfold fieldDirectionalDerivative
  rw [fieldEquality, component.hasFDerivAt.fderiv]
  fin_cases derivativeDirection <;>
    simp [component, coframeBaseCoordinate, coordinateDirection,
      Fin.sum_univ_four]

/-! ## Primitive simultaneous field update -/

/-- Add one holonomic Hessian increment to the primitive coframe and its
complete LC connection first jet, deriving `B` from the new coframe.  Every
other primitive field is retained. -/
def identityECHolonomicCoframeHessianIncrementLocalActualLift
    (current : StageNineHolonomicConfiguration)
    (increment : CoframeHolonomicSecondJet) :
    StageNineHolonomicConfiguration :=
  let coframeIncrement :=
    coframeHolonomicSecondJetQuadraticRealization increment
  let nextCoframe := fun point =>
    current.coframe point + coframeIncrement point
  { current with
    coframe := nextCoframe
    gravityConnection := fun point =>
      current.gravityConnection point +
        identityECLeviCivitaAffineConnectionIncrement increment point
    gravityAuxiliary := fun point =>
      physicalIIPlusBivector (nextCoframe point) }

@[simp] theorem
    identityECHolonomicCoframeHessianIncrementLocalActualLift_coframe_origin
    (current : StageNineHolonomicConfiguration)
    (increment : CoframeHolonomicSecondJet) :
    (identityECHolonomicCoframeHessianIncrementLocalActualLift
        current increment).coframe 0 = current.coframe 0 := by
  simp [identityECHolonomicCoframeHessianIncrementLocalActualLift]

@[simp] theorem
    identityECHolonomicCoframeHessianIncrementLocalActualLift_connection_origin
    (current : StageNineHolonomicConfiguration)
    (increment : CoframeHolonomicSecondJet) :
    (identityECHolonomicCoframeHessianIncrementLocalActualLift
        current increment).gravityConnection 0 =
      current.gravityConnection 0 := by
  simp [identityECHolonomicCoframeHessianIncrementLocalActualLift]

/-- Installing the holonomic Hessian preserves the supplied coframe first
germ at the contact origin.  The generated quadratic increment has zero
value and zero first derivative there. -/
theorem
    identityECHolonomicCoframeHessianIncrementLocalActualLift_coframe_hasFDerivAt_origin_of
    (current : StageNineHolonomicConfiguration)
    (increment : CoframeHolonomicSecondJet)
    (derivative : BasePoint →L[ℝ] LorentzianCoframe)
    (currentDerivative : HasFDerivAt current.coframe derivative 0) :
    HasFDerivAt
      (identityECHolonomicCoframeHessianIncrementLocalActualLift
        current increment).coframe derivative 0 := by
  have incrementDerivative :=
    coframeHolonomicSecondJetQuadraticRealization_hasFDerivAt increment 0
  have combined := currentDerivative.add incrementDerivative
  have incrementAtOrigin : increment.1 (0 : BasePoint) = 0 := by
    ext direction internal coordinate
    simp
  have derivativeSum :
      derivative + increment.1 (0 : BasePoint) = derivative := by
    ext direction internal coordinate
    simp [incrementAtOrigin]
  have combined' :
      HasFDerivAt
        (current.coframe +
          coframeHolonomicSecondJetQuadraticRealization increment)
        derivative 0 :=
    derivativeSum ▸ combined
  change HasFDerivAt
    (fun point =>
      current.coframe point +
        coframeHolonomicSecondJetQuadraticRealization increment point)
    derivative 0
  rw [show
      (fun point =>
        current.coframe point +
          coframeHolonomicSecondJetQuadraticRealization increment point) =
        current.coframe +
          coframeHolonomicSecondJetQuadraticRealization increment by
    rfl]
  exact combined'

theorem
    identityECHolonomicCoframeHessianIncrementLocalActualLift_simplicity
    (current : StageNineHolonomicConfiguration)
    (increment : CoframeHolonomicSecondJet) :
    ∀ point,
      (identityECHolonomicCoframeHessianIncrementLocalActualLift
          current increment).gravityAuxiliary point =
        physicalIIPlusBivector
          ((identityECHolonomicCoframeHessianIncrementLocalActualLift
              current increment).coframe point) := by
  intro point
  rfl

theorem
    identityECHolonomicCoframeHessianIncrementLocalActualLift_origin_nondegenerate
    (current : StageNineHolonomicConfiguration)
    (increment : CoframeHolonomicSecondJet)
    (currentNondegenerate : Matrix.det (current.coframe 0) ≠ 0) :
    Matrix.det
        ((identityECHolonomicCoframeHessianIncrementLocalActualLift
          current increment).coframe 0) ≠ 0 := by
  simpa using currentNondegenerate

/-- The primitive coframe write differs from the current field by exactly the
quadratic realization of the generated Hessian increment. -/
theorem
    identityECHolonomicCoframeHessianIncrementLocalActualLift_coframe_difference
    (current : StageNineHolonomicConfiguration)
    (increment : CoframeHolonomicSecondJet) :
    (fun point =>
      (identityECHolonomicCoframeHessianIncrementLocalActualLift
          current increment).coframe point - current.coframe point) =
      coframeHolonomicSecondJetQuadraticRealization increment := by
  funext point
  simp [identityECHolonomicCoframeHessianIncrementLocalActualLift]

/-- The nonlinear part actually installed in the primitive coframe has the
supplied holonomic Hessian as its exact origin second Fréchet jet. -/
theorem
    identityECHolonomicCoframeHessianIncrementLocalActualLift_coframe_secondJet
    (current : StageNineHolonomicConfiguration)
    (increment : CoframeHolonomicSecondJet) :
    coframeOriginSecondFrechetJet
        (fun point =>
          (identityECHolonomicCoframeHessianIncrementLocalActualLift
              current increment).coframe point - current.coframe point) =
      increment.1 := by
  rw [
    identityECHolonomicCoframeHessianIncrementLocalActualLift_coframe_difference]
  exact
    coframeHolonomicSecondJetQuadraticRealization_secondJet increment

theorem
    identityECHolonomicCoframeHessianIncrementLocalActualLift_smooth
    (current : StageNineHolonomicConfiguration)
    (increment : CoframeHolonomicSecondJet)
    (currentSmooth : current.Smooth) :
    (identityECHolonomicCoframeHessianIncrementLocalActualLift
      current increment).Smooth := by
  rcases currentSmooth with
    ⟨coframeSmooth, connectionSmooth, auxiliarySmooth, multiplierSmooth,
      gaugeConnectionSmooth, gaugeAuxiliarySmooth, scalarSmooth,
      matterSmooth, conjugateMatterSmooth⟩
  have quadraticSmooth : ContDiff ℝ ∞
      (coframeHolonomicSecondJetQuadraticRealization increment) :=
    coframeHolonomicSecondJetQuadraticRealization_contDiff increment
  have nextCoframeSmooth : ContDiff ℝ ∞ fun point =>
      current.coframe point +
        coframeHolonomicSecondJetQuadraticRealization increment point := by
    apply contDiff_pi'
    intro internal
    apply contDiff_pi'
    intro coordinate
    exact (coframeSmooth internal coordinate).add
      (contDiff_pi.mp
        (contDiff_pi.mp quadraticSmooth internal) coordinate)
  have nextAuxiliarySmooth : ContDiff ℝ ∞ fun point =>
      physicalIIPlusBivector
        (current.coframe point +
          coframeHolonomicSecondJetQuadraticRealization increment point) :=
    physicalIIPlusBivector_contDiff.comp nextCoframeSmooth
  exact
    ⟨fun internal coordinate =>
        contDiff_pi.mp (contDiff_pi.mp nextCoframeSmooth internal) coordinate,
      fun formDirection internalOut internalIn =>
        (connectionSmooth formDirection internalOut internalIn).add
          (identityECLeviCivitaAffineConnectionIncrement_smooth increment
            formDirection internalOut internalIn),
      fun internalPair spacetimePair =>
        contDiff_pi.mp
          (contDiff_pi.mp nextAuxiliarySmooth internalPair) spacetimePair,
      multiplierSmooth, gaugeConnectionSmooth, gaugeAuxiliarySmooth,
      scalarSmooth, matterSmooth, conjugateMatterSmooth⟩

theorem
    identityECHolonomicCoframeHessianIncrementLocalActualLift_lorentzAdmissible
    (current : StageNineHolonomicConfiguration)
    (increment : CoframeHolonomicSecondJet)
    (currentAdmissible : GravityConnectionLorentzAdmissible current) :
    GravityConnectionLorentzAdmissible
      (identityECHolonomicCoframeHessianIncrementLocalActualLift
        current increment) := by
  intro point
  exact lorentzSkew_add (currentAdmissible point)
    (identityECLeviCivitaAffineConnectionIncrement_lorentzSkew
      increment point)

/-! ## Literal actual curvature seam -/

/-- Every canonical internal-pair component of the primitive connection has
the generated complete LC derivative increment at the origin. -/
theorem
    gravityConnectionDerivative_identityECHolonomicCoframeHessianIncrementLocalActualLift_origin
    (current : StageNineHolonomicConfiguration)
    (increment : CoframeHolonomicSecondJet)
    (currentSmooth : current.Smooth)
    (derivativeDirection formDirection : LorentzianIndex)
    (internalPair : Fin 6) :
    gravityConnectionDerivative
        (identityECHolonomicCoframeHessianIncrementLocalActualLift
          current increment)
        0 derivativeDirection formDirection
        (pairFirst internalPair) (pairSecond internalPair) =
      gravityConnectionDerivative current 0 derivativeDirection formDirection
          (pairFirst internalPair) (pairSecond internalPair) +
        identityECLeviCivitaSpinConnectionFirstJet increment
          derivativeDirection formDirection
          (pairFirst internalPair) (pairSecond internalPair) := by
  unfold gravityConnectionDerivative
  change
    fderiv ℝ
        (fun point =>
          current.gravityConnection point formDirection
              (pairFirst internalPair) (pairSecond internalPair) +
            identityECLeviCivitaAffineConnectionIncrement increment point
              formDirection (pairFirst internalPair)
                (pairSecond internalPair))
        0 (coordinateDirection derivativeDirection) = _
  rw [fderiv_fun_add
    ((currentSmooth.2.1 formDirection (pairFirst internalPair)
      (pairSecond internalPair)).differentiable (by simp) 0)
    ((identityECLeviCivitaAffineConnectionIncrement_smooth increment
      formDirection (pairFirst internalPair)
      (pairSecond internalPair)).differentiable (by simp) 0)]
  change
    gravityConnectionDerivative current 0 derivativeDirection formDirection
          (pairFirst internalPair) (pairSecond internalPair) +
      fieldDirectionalDerivative
        (fun point =>
          identityECLeviCivitaAffineConnectionIncrement increment point
            formDirection (pairFirst internalPair) (pairSecond internalPair))
        0 derivativeDirection = _
  rw [
    identityECLeviCivitaAffineConnectionIncrement_directionalDerivative_origin]
  rfl

/-- The curvature is read from the same updated primitive connection.  Since
the affine LC increment vanishes at the origin, its bracket with the retained
current vanishes there and the exact curvature increment is the forward LC
curvature of the supplied holonomic Hessian. -/
theorem
    holonomicGravityCurvature_identityECHolonomicCoframeHessianIncrementLocalActualLift_origin
    (current : StageNineHolonomicConfiguration)
    (increment : CoframeHolonomicSecondJet)
    (currentSmooth : current.Smooth) :
    holonomicGravityCurvature
        (identityECHolonomicCoframeHessianIncrementLocalActualLift
          current increment) 0 =
      holonomicGravityCurvature current 0 +
        identityECLeviCivitaCurvatureOfCoframeHessian increment := by
  funext internalPair spacetimePair
  unfold holonomicGravityCurvature
  dsimp only
  rw [
    gravityConnectionDerivative_identityECHolonomicCoframeHessianIncrementLocalActualLift_origin
      current increment currentSmooth,
    gravityConnectionDerivative_identityECHolonomicCoframeHessianIncrementLocalActualLift_origin
      current increment currentSmooth,
    identityECHolonomicCoframeHessianIncrementLocalActualLift_connection_origin]
  unfold identityECLeviCivitaCurvatureOfCoframeHessian
  simp only [Pi.add_apply]
  ring

/-! ## Source/action-generated identity-contact acceleration -/

/-- Lower-order coframe-action rows already present at the current contact:
the actual primitive curvature plus the intrinsic, gauge, and matter load.
This is computed from `(source,current)` and is not a supplied residual
carrier. -/
def sourceActionGeneratedIdentityECCoframeLowerOrderCoordinates
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) : LorentzianCoframe :=
  coframeCovectorCoordinates
    (identityDiracDualECCurvatureObservation
        (holonomicGravityCurvature current 0) +
      diracDualFormNativeIdentityECLoad source current)

/-- The ten Lorentz-compatible principal rows generated by the identity-
contact EC coframe action.  The six skew rows are deliberately not projected
back into the Levi--Civita Hessian carrier. -/
def sourceActionGeneratedIdentityECCoframeAccelerationRows
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    IdentityECEtaCompatibleRows :=
  identityECEtaCompatibleProjection
    (-sourceActionGeneratedIdentityECCoframeLowerOrderCoordinates
      source current)

/-- No-choice holonomic coframe acceleration generated by the action's
typed ten-row principal section. -/
def sourceActionGeneratedIdentityECHolonomicCoframeHessianIncrement
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    CoframeHolonomicSecondJet :=
  identityECTypedHolonomicCoframeHessianSection
    (sourceActionGeneratedIdentityECCoframeAccelerationRows source current)

/-- Primitive source/action update obtained by installing the generated
coframe acceleration and its complete LC connection first jet together. -/
def sourceActionGeneratedIdentityECHolonomicCoframeHessianLocalActualLift
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  identityECHolonomicCoframeHessianIncrementLocalActualLift current
    (sourceActionGeneratedIdentityECHolonomicCoframeHessianIncrement
      source current)

theorem
    sourceActionGeneratedIdentityECHolonomicCoframeHessianIncrement_observation
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    identityECHolonomicCoframeHessianObservation
        (sourceActionGeneratedIdentityECHolonomicCoframeHessianIncrement
          source current) =
      identityECEtaSymmetricPart
        (-sourceActionGeneratedIdentityECCoframeLowerOrderCoordinates
          source current) := by
  have generated := congrArg Subtype.val
    (identityECTypedHolonomicCoframeHessianObservation_section
      (sourceActionGeneratedIdentityECCoframeAccelerationRows source current))
  exact generated

theorem
    sourceActionGeneratedIdentityECHolonomicCoframeHessianLocalActualLift_curvature_origin
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (currentSmooth : current.Smooth) :
    holonomicGravityCurvature
        (sourceActionGeneratedIdentityECHolonomicCoframeHessianLocalActualLift
          source current) 0 =
      holonomicGravityCurvature current 0 +
        identityECLeviCivitaCurvatureOfCoframeHessian
          (sourceActionGeneratedIdentityECHolonomicCoframeHessianIncrement
            source current) :=
  holonomicGravityCurvature_identityECHolonomicCoframeHessianIncrementLocalActualLift_origin
    current
    (sourceActionGeneratedIdentityECHolonomicCoframeHessianIncrement
      source current)
    currentSmooth

/-- **Ten-plus-six actual settlement.**  Reading the literal curvature of
the generated primitive actual against the same current action load cancels
all ten Lorentz-compatible rows.  The exact remainder is the six-row
Cartan/live-spin part of the pre-existing lower-order action coordinates.

This is producer soundness of the action-defined acceleration, not an
independent constraint closure. -/
theorem
    sourceActionGeneratedIdentityECHolonomicCoframeHessianLocalActualLift_currentLoad_settlement
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (currentSmooth : current.Smooth) :
    coframeCovectorCoordinates
        (identityDiracDualECCurvatureObservation
            (holonomicGravityCurvature
              (sourceActionGeneratedIdentityECHolonomicCoframeHessianLocalActualLift
                source current) 0) +
          diracDualFormNativeIdentityECLoad source current) =
      identityECEtaAntisymmetricPart
        (sourceActionGeneratedIdentityECCoframeLowerOrderCoordinates
          source current) := by
  let lowerOrder :=
    sourceActionGeneratedIdentityECCoframeLowerOrderCoordinates source current
  have curvature :=
    sourceActionGeneratedIdentityECHolonomicCoframeHessianLocalActualLift_curvature_origin
      source current currentSmooth
  have incrementObservation :=
    sourceActionGeneratedIdentityECHolonomicCoframeHessianIncrement_observation
      source current
  rw [curvature, identityDiracDualECCurvatureObservation_add]
  calc
    coframeCovectorCoordinates
        ((identityDiracDualECCurvatureObservation
              (holonomicGravityCurvature current 0) +
            identityDiracDualECCurvatureObservation
              (identityECLeviCivitaCurvatureOfCoframeHessian
                (sourceActionGeneratedIdentityECHolonomicCoframeHessianIncrement
                  source current))) +
          diracDualFormNativeIdentityECLoad source current) =
      identityECEtaSymmetricPart (-lowerOrder) + lowerOrder := by
        ext row column
        have observedCoordinate := congrFun
          (congrFun incrementObservation row) column
        change _ =
          identityECEtaSymmetricPart (-lowerOrder) row column +
            lowerOrder row column
        change
          identityDiracDualECCurvatureObservation
                (holonomicGravityCurvature current 0)
                (coframeCoordinateDirection row column) +
              identityECHolonomicCoframeHessianObservation
                (sourceActionGeneratedIdentityECHolonomicCoframeHessianIncrement
                  source current) row column +
            diracDualFormNativeIdentityECLoad source current
              (coframeCoordinateDirection row column) = _
        rw [observedCoordinate]
        dsimp [lowerOrder,
          sourceActionGeneratedIdentityECCoframeLowerOrderCoordinates,
          coframeCovectorCoordinates]
        simp only [add_apply]
        ring
    _ = identityECEtaAntisymmetricPart lowerOrder :=
      identityECEtaSymmetricPart_neg_add_eq_antisymmetricPart lowerOrder

end


end
