import H0mework.Physics.IdentityGerms.IdentityECCurvatureNormalSection

/-!
# Temporal evolution section of the identity-contact EC observation

The repaired Einstein--Cartan coframe equation has sixteen identity-contact
coordinates.  A Cauchy evolution can change only the eighteen
temporal--spatial curvature coordinates `F_{0i}`; the spatial curvature is
already fixed by the instantaneous connection.

This module computes that restricted action principal.  It proves a
canonical right inverse for the twelve spatial-column coframe equations and
proves that every temporal--spatial curvature has zero readout on the four
temporal-column equations.  Thus the split is generated by the actual
topological EC pairing:

```text
12 evolution rows <- 18 temporal curvature coordinates
4 constraint rows <- spatial curvature and matter/coframe load only.
```

The six-dimensional evolution kernel is retained rather than silently
discarded.  No source value, residual, shell, inverse certificate, target
curvature, branch choice, or stationarity receipt is an input.  This is the
positive algebraic mouth for a later state-dependent connection velocity; it
is not yet a trajectory or a neighborhood solution.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeIdentityECTemporalEvolutionSection

open ProofFreeRicherAnholonomicSource
open StageNineCartanTangentSimplicityResponse
open StageNineDiracDualFormNativeIdentityECCurvatureNormalSection
open StageNineGlobalIntegratedAction
open StageNineHolonomicGravityCurvatureVarianceNormalization
open StageNineLinearPlebanskiCoframeActionPrincipal
open StageNineTopologicalFourFormPairing

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1600000

attribute [local simp] Matrix.cons_val_two Matrix.cons_val_three
  Matrix.cons_val_four

@[simp] private theorem pairFirst_five : pairFirst (5 : Fin 6) = 1 := rfl

@[simp] private theorem pairSecond_five : pairSecond (5 : Fin 6) = 2 := rfl

@[simp] private theorem pairFirstVector_five :
    (![0, 0, 0, 2, 3, 1] : Fin 6 → LorentzianIndex) 5 = 1 := rfl

@[simp] private theorem pairSecondVector_five :
    (![1, 2, 3, 3, 1, 2] : Fin 6 → LorentzianIndex) 5 = 2 := rfl

/-- Eighteen lowered curvature coordinates `F_{0i}^{IJ}`. -/
abbrev IdentityECTemporalCurvatureCoordinates :=
  Fin 6 → Fin 3 → ℝ

/-- Twelve coframe-covector coordinates with spatial coframe column. -/
abbrev IdentityECSpatialCoframeCovectorCoordinates :=
  Fin 4 → Fin 3 → ℝ

/-- Restrict a coframe covector to the twelve spatial-column Cauchy rows. -/
def identityECSpatialCoframeCoordinatesOfCovector
    (covector : LorentzianCoframe →L[ℝ] ℝ) :
    IdentityECSpatialCoframeCovectorCoordinates :=
  fun row direction =>
    covector (coframeCoordinateDirection row direction.succ)

/-- Restrict a coframe covector to the four temporal-column constraints. -/
def identityECConstraintCoordinatesOfCovector
    (covector : LorentzianCoframe →L[ℝ] ℝ) : Fin 4 → ℝ :=
  fun row => covector (coframeCoordinateDirection row 0)

/-- The canonical spacetime two-form slots `(01,02,03)`. -/
def identityECTemporalSpatialPair (direction : Fin 3) : Fin 6 :=
  ⟨direction.val, by omega⟩

@[simp] theorem pairFirst_identityECTemporalSpatialPair
    (direction : Fin 3) :
    pairFirst (identityECTemporalSpatialPair direction) = 0 := by
  fin_cases direction <;> rfl

@[simp] theorem pairSecond_identityECTemporalSpatialPair
    (direction : Fin 3) :
    pairSecond (identityECTemporalSpatialPair direction) = direction.succ := by
  fin_cases direction <;> rfl

/-- Embed temporal--spatial coordinates into the full raw-curvature carrier.
Every spatial--spatial spacetime coordinate is definitionally zero. -/
def identityECTemporalCurvatureOfCoordinates
    (coordinates : IdentityECTemporalCurvatureCoordinates) :
    PhysicalBivector :=
  fun internalPair spacetimePair =>
    ![coordinates internalPair 0,
      coordinates internalPair 1,
      coordinates internalPair 2,
      0, 0, 0] spacetimePair

@[simp] theorem identityECTemporalCurvatureOfCoordinates_apply
    (coordinates : IdentityECTemporalCurvatureCoordinates)
    (internalPair : Fin 6)
    (direction : Fin 3) :
    identityECTemporalCurvatureOfCoordinates coordinates internalPair
        (identityECTemporalSpatialPair direction) =
      coordinates internalPair direction := by
  fin_cases direction <;> rfl

/-- Read the eighteen temporal--spatial coordinates of a raw curvature. -/
def identityECTemporalCurvatureCoordinatesOf
    (rawCurvature : PhysicalBivector) :
    IdentityECTemporalCurvatureCoordinates :=
  fun internalPair direction =>
    rawCurvature internalPair (identityECTemporalSpatialPair direction)

@[simp] theorem identityECTemporalCurvatureCoordinatesOf_ofCoordinates
    (coordinates : IdentityECTemporalCurvatureCoordinates) :
    identityECTemporalCurvatureCoordinatesOf
        (identityECTemporalCurvatureOfCoordinates coordinates) =
      coordinates := by
  funext internalPair direction
  exact identityECTemporalCurvatureOfCoordinates_apply
    coordinates internalPair direction

/-- The twelve evolution rows of the actual identity-contact EC pairing. -/
def identityDiracDualECTemporalEvolutionObservation
    (rawCurvature : PhysicalBivector) :
    IdentityECSpatialCoframeCovectorCoordinates :=
  fun row direction =>
    identityDiracDualECCurvatureObservation rawCurvature
      (coframeCoordinateDirection row direction.succ)

/-- The four independent Cauchy constraint rows: variations of the temporal
coframe column. -/
def identityDiracDualECConstraintObservation
    (rawCurvature : PhysicalBivector) : Fin 4 → ℝ :=
  fun row =>
    identityDiracDualECCurvatureObservation rawCurvature
      (coframeCoordinateDirection row 0)

/-- Explicit magnetic-coordinate form of the four independent Cauchy
constraint rows. -/
theorem identityDiracDualECConstraintObservation_explicit
    (rawCurvature : PhysicalBivector) :
    identityDiracDualECConstraintObservation rawCurvature =
      ![
        -(rawCurvature 3 3 + rawCurvature 4 4 + rawCurvature 5 5),
        -rawCurvature 1 5 + rawCurvature 2 4,
        rawCurvature 0 5 - rawCurvature 2 3,
        -rawCurvature 0 4 + rawCurvature 1 3
      ] := by
  funext row
  fin_cases row <;>
    simp [identityDiracDualECConstraintObservation,
      identityDiracDualECCurvatureObservation,
      coframeCoordinateDirection,
      physicalIIPlusCoframeTangent, coframeWedgeTangent,
      internalBivectorDual, lorentzianCoframeHodge,
      gravityInternalPairVarianceNormalization,
      gravityTopologicalWedgeCoefficient,
      orientedTwoFormWedgeCoefficient_explicit,
      lorentzianTwoFormSign, minkowskiInternalSign,
      pairFirst, pairSecond, Matrix.one_apply,
      Fin.sum_univ_six] <;>
    ring

theorem identityDiracDualECIntrinsicConstraintObservation :
    identityDiracDualECConstraintObservation
        (gravityInternalPairVarianceNormalization
          (coframeWedge (1 : LorentzianCoframe))) =
      ![-3, 0, 0, 0] := by
  rw [identityDiracDualECConstraintObservation_explicit]
  funext row
  fin_cases row <;>
    simp +decide [gravityInternalPairVarianceNormalization,
      coframeWedge, pairFirst, pairSecond, Matrix.one_apply,
      lorentzianTwoFormSign, minkowskiInternalSign,
      Fin.reduceFinMk]
  all_goals norm_num

/-- Canonical six-kernel-fixed coordinates solving the twelve evolution
rows.  The coefficients are forced by the restricted topological principal,
not by source calibration. -/
def identityDiracDualECTemporalEvolutionSectionCoordinates
    (response : IdentityECSpatialCoframeCovectorCoordinates) :
    IdentityECTemporalCurvatureCoordinates :=
  ![
    ![-response 1 0 / 2 + response 2 1 / 2 + response 3 2 / 2,
      -response 2 0,
      -response 3 0],
    ![-response 1 1,
      response 1 0 / 2 - response 2 1 / 2 + response 3 2 / 2,
      -response 3 1],
    ![-response 1 2,
      -response 2 2,
      response 1 0 / 2 + response 2 1 / 2 - response 3 2 / 2],
    ![0, -response 0 2 / 2, response 0 1 / 2],
    ![response 0 2 / 2, 0, -response 0 0 / 2],
    ![-response 0 1 / 2, response 0 0 / 2, 0]
  ]

/-- Temporal--spatial raw-curvature section of the twelve evolution rows. -/
def identityDiracDualECTemporalEvolutionSection
    (response : IdentityECSpatialCoframeCovectorCoordinates) :
    PhysicalBivector :=
  identityECTemporalCurvatureOfCoordinates
    (identityDiracDualECTemporalEvolutionSectionCoordinates response)

/-- **Positive evolution-section theorem.**  The displayed section is a
right inverse of the actual repaired-root temporal EC principal. -/
theorem identityDiracDualECTemporalEvolutionObservation_section
    (response : IdentityECSpatialCoframeCovectorCoordinates) :
    identityDiracDualECTemporalEvolutionObservation
        (identityDiracDualECTemporalEvolutionSection response) =
      response := by
  funext row direction
  fin_cases row <;> fin_cases direction <;>
    simp [identityDiracDualECTemporalEvolutionObservation,
      identityDiracDualECTemporalEvolutionSection,
      identityDiracDualECTemporalEvolutionSectionCoordinates,
      identityECTemporalCurvatureOfCoordinates,
      identityDiracDualECCurvatureObservation,
      coframeCoordinateDirection,
      physicalIIPlusCoframeTangent,
      coframeWedgeTangent,
      internalBivectorDual,
      lorentzianCoframeHodge,
      gravityInternalPairVarianceNormalization,
      gravityTopologicalWedgeCoefficient,
      orientedTwoFormWedgeCoefficient_explicit,
      lorentzianTwoFormSign,
      minkowskiInternalSign,
      pairFirst, pairSecond,
      Matrix.one_apply,
      Fin.sum_univ_six] <;>
    ring

/-- Temporal curvature cannot alter the four constraint rows. -/
theorem identityDiracDualECConstraintObservation_temporal_zero
    (coordinates : IdentityECTemporalCurvatureCoordinates) :
    identityDiracDualECConstraintObservation
        (identityECTemporalCurvatureOfCoordinates coordinates) = 0 := by
  funext row
  fin_cases row <;>
    simp [identityDiracDualECConstraintObservation,
      identityECTemporalCurvatureOfCoordinates,
      identityDiracDualECCurvatureObservation,
      coframeCoordinateDirection,
      physicalIIPlusCoframeTangent,
      coframeWedgeTangent,
      internalBivectorDual,
      lorentzianCoframeHodge,
      gravityInternalPairVarianceNormalization,
      gravityTopologicalWedgeCoefficient,
      orientedTwoFormWedgeCoefficient_explicit,
      lorentzianTwoFormSign,
      minkowskiInternalSign,
      pairFirst, pairSecond,
      Matrix.one_apply,
      Fin.sum_univ_six]

/-- The evolution section is faithful on the twelve action rows. -/
theorem identityDiracDualECTemporalEvolutionSection_injective :
    Function.Injective identityDiracDualECTemporalEvolutionSection := by
  intro first second equality
  have observed := congrArg
    identityDiracDualECTemporalEvolutionObservation equality
  simpa only [identityDiracDualECTemporalEvolutionObservation_section]
    using observed

/-! ## Kernel-faithful temporal target -/

theorem identityECTemporalCurvatureOfCoordinates_add
    (first second : IdentityECTemporalCurvatureCoordinates) :
    identityECTemporalCurvatureOfCoordinates (first + second) =
      identityECTemporalCurvatureOfCoordinates first +
        identityECTemporalCurvatureOfCoordinates second := by
  funext internalPair spacetimePair
  fin_cases spacetimePair <;>
    simp [identityECTemporalCurvatureOfCoordinates]

theorem identityECTemporalCurvatureOfCoordinates_sub
    (first second : IdentityECTemporalCurvatureCoordinates) :
    identityECTemporalCurvatureOfCoordinates (first - second) =
      identityECTemporalCurvatureOfCoordinates first -
        identityECTemporalCurvatureOfCoordinates second := by
  funext internalPair spacetimePair
  fin_cases spacetimePair <;>
    simp [identityECTemporalCurvatureOfCoordinates]

theorem identityDiracDualECTemporalEvolutionObservation_add
    (first second : PhysicalBivector) :
    identityDiracDualECTemporalEvolutionObservation (first + second) =
      identityDiracDualECTemporalEvolutionObservation first +
        identityDiracDualECTemporalEvolutionObservation second := by
  funext row direction
  unfold identityDiracDualECTemporalEvolutionObservation
  rw [identityDiracDualECCurvatureObservation_add]
  rfl

theorem identityDiracDualECTemporalEvolutionObservation_sub
    (first second : PhysicalBivector) :
    identityDiracDualECTemporalEvolutionObservation (first - second) =
      identityDiracDualECTemporalEvolutionObservation first -
        identityDiracDualECTemporalEvolutionObservation second := by
  funext row direction
  unfold identityDiracDualECTemporalEvolutionObservation
  rw [identityDiracDualECCurvatureObservation_sub]
  rfl

theorem identityECTemporalCurvatureCoordinatesOf_add
    (first second : PhysicalBivector) :
    identityECTemporalCurvatureCoordinatesOf (first + second) =
      identityECTemporalCurvatureCoordinatesOf first +
        identityECTemporalCurvatureCoordinatesOf second := by
  funext internalPair direction
  rfl

theorem identityECTemporalCurvatureCoordinatesOf_sub
    (first second : PhysicalBivector) :
    identityECTemporalCurvatureCoordinatesOf (first - second) =
      identityECTemporalCurvatureCoordinatesOf first -
        identityECTemporalCurvatureCoordinatesOf second := by
  funext internalPair direction
  rfl

theorem identityDiracDualECTemporalEvolutionSectionCoordinates_add
    (first second : IdentityECSpatialCoframeCovectorCoordinates) :
    identityDiracDualECTemporalEvolutionSectionCoordinates (first + second) =
      identityDiracDualECTemporalEvolutionSectionCoordinates first +
        identityDiracDualECTemporalEvolutionSectionCoordinates second := by
  funext internalPair direction
  fin_cases internalPair <;> fin_cases direction <;>
    simp [identityDiracDualECTemporalEvolutionSectionCoordinates] <;>
    ring

theorem identityDiracDualECTemporalEvolutionSectionCoordinates_sub
    (first second : IdentityECSpatialCoframeCovectorCoordinates) :
    identityDiracDualECTemporalEvolutionSectionCoordinates (first - second) =
      identityDiracDualECTemporalEvolutionSectionCoordinates first -
        identityDiracDualECTemporalEvolutionSectionCoordinates second := by
  funext internalPair direction
  fin_cases internalPair <;> fin_cases direction <;>
    simp [identityDiracDualECTemporalEvolutionSectionCoordinates] <;>
    ring

/-- Six-dimensional symmetric electric responsibility left after removing
the action-normal twelve-row section. -/
def identityDiracDualECTemporalEvolutionKernelPart
    (coordinates : IdentityECTemporalCurvatureCoordinates) :
    IdentityECTemporalCurvatureCoordinates :=
  coordinates -
    identityDiracDualECTemporalEvolutionSectionCoordinates
      (identityDiracDualECTemporalEvolutionObservation
        (identityECTemporalCurvatureOfCoordinates coordinates))

theorem identityDiracDualECTemporalEvolutionKernelPart_add
    (first second : IdentityECTemporalCurvatureCoordinates) :
    identityDiracDualECTemporalEvolutionKernelPart (first + second) =
      identityDiracDualECTemporalEvolutionKernelPart first +
        identityDiracDualECTemporalEvolutionKernelPart second := by
  unfold identityDiracDualECTemporalEvolutionKernelPart
  rw [identityECTemporalCurvatureOfCoordinates_add,
    identityDiracDualECTemporalEvolutionObservation_add,
    identityDiracDualECTemporalEvolutionSectionCoordinates_add]
  module

theorem identityDiracDualECTemporalEvolutionKernelPart_sub
    (first second : IdentityECTemporalCurvatureCoordinates) :
    identityDiracDualECTemporalEvolutionKernelPart (first - second) =
      identityDiracDualECTemporalEvolutionKernelPart first -
        identityDiracDualECTemporalEvolutionKernelPart second := by
  unfold identityDiracDualECTemporalEvolutionKernelPart
  rw [identityECTemporalCurvatureOfCoordinates_sub,
    identityDiracDualECTemporalEvolutionObservation_sub,
    identityDiracDualECTemporalEvolutionSectionCoordinates_sub]
  module

/-- The full EC normal section can change temporal curvature coordinates, but
its temporal part lies entirely in the twelve-row evolution section.  It
therefore carries no six-dimensional electric-kernel responsibility. -/
theorem identityDiracDualECTemporalEvolutionKernelPart_normalSection
    (observation : LorentzianCoframe →L[ℝ] ℝ) :
    identityDiracDualECTemporalEvolutionKernelPart
        (identityECTemporalCurvatureCoordinatesOf
          (identityDiracDualECCurvatureNormalSection observation)) =
      0 := by
  unfold identityDiracDualECTemporalEvolutionKernelPart
  apply sub_eq_zero.mpr
  funext internalPair direction
  fin_cases internalPair <;> fin_cases direction <;>
    simp [identityDiracDualECTemporalEvolutionSectionCoordinates,
      identityDiracDualECTemporalEvolutionObservation,
      identityECTemporalCurvatureCoordinatesOf,
      identityECTemporalCurvatureOfCoordinates,
      identityECTemporalSpatialPair,
      identityDiracDualECCurvatureNormalSection,
      identityDiracDualECCurvatureObservation,
      linearPlebanskiMultiplierOfCoframeResponse,
      linearPlebanskiCoframeResponseOfStress,
      linearPlebanskiTraceReverse,
      coframeCovectorCoordinates,
      coframeCoordinateDirection,
      physicalIIPlusCoframeTangent,
      coframeWedgeTangent,
      internalBivectorDual,
      lorentzianCoframeHodge,
      gravityInternalPairVarianceNormalization,
      gravityTopologicalWedgeCoefficient,
      orientedTwoFormWedgeCoefficient_explicit,
      lorentzianTwoFormSign,
      minkowskiInternalSign,
      pairFirst, pairSecond,
      Matrix.trace, Matrix.one_apply,
      Fin.sum_univ_six, Fin.sum_univ_four] <;>
    ring

theorem identityDiracDualECTemporalEvolutionKernelPart_curvatureKernelPart
    (rawCurvature : PhysicalBivector) :
    identityDiracDualECTemporalEvolutionKernelPart
        (identityECTemporalCurvatureCoordinatesOf
          (identityDiracDualECCurvatureKernelPart rawCurvature)) =
      identityDiracDualECTemporalEvolutionKernelPart
        (identityECTemporalCurvatureCoordinatesOf rawCurvature) := by
  unfold identityDiracDualECCurvatureKernelPart
  rw [identityECTemporalCurvatureCoordinatesOf_sub,
    identityDiracDualECTemporalEvolutionKernelPart_sub,
    identityDiracDualECTemporalEvolutionKernelPart_normalSection,
    sub_zero]

/-- A full EC normal target preserves the current six-dimensional electric
kernel even though it need not preserve all eighteen raw temporal curvature
coordinates. -/
theorem identityDiracDualECTemporalEvolutionKernelPart_curvatureTarget
    (current : PhysicalBivector)
    (observation : LorentzianCoframe →L[ℝ] ℝ) :
    identityDiracDualECTemporalEvolutionKernelPart
        (identityECTemporalCurvatureCoordinatesOf
          (identityDiracDualECCurvatureTarget current observation)) =
      identityDiracDualECTemporalEvolutionKernelPart
        (identityECTemporalCurvatureCoordinatesOf current) := by
  unfold identityDiracDualECCurvatureTarget
  rw [identityECTemporalCurvatureCoordinatesOf_add,
    identityDiracDualECTemporalEvolutionKernelPart_add,
    identityDiracDualECTemporalEvolutionKernelPart_normalSection,
    add_zero,
    identityDiracDualECTemporalEvolutionKernelPart_curvatureKernelPart]

theorem identityDiracDualECTemporalEvolutionObservation_kernelPart
    (coordinates : IdentityECTemporalCurvatureCoordinates) :
    identityDiracDualECTemporalEvolutionObservation
        (identityECTemporalCurvatureOfCoordinates
          (identityDiracDualECTemporalEvolutionKernelPart coordinates)) =
      0 := by
  rw [identityDiracDualECTemporalEvolutionKernelPart,
    identityECTemporalCurvatureOfCoordinates_sub,
    identityDiracDualECTemporalEvolutionObservation_sub]
  change
    identityDiracDualECTemporalEvolutionObservation
          (identityECTemporalCurvatureOfCoordinates coordinates) -
        identityDiracDualECTemporalEvolutionObservation
          (identityDiracDualECTemporalEvolutionSection
            (identityDiracDualECTemporalEvolutionObservation
              (identityECTemporalCurvatureOfCoordinates coordinates))) =
      0
  rw [identityDiracDualECTemporalEvolutionObservation_section]
  exact sub_self _

/-- Replace only the twelve EC evolution rows and retain all six electric
kernel coordinates from the current curvature. -/
def identityDiracDualECTemporalEvolutionTargetCoordinates
    (current : IdentityECTemporalCurvatureCoordinates)
    (response : IdentityECSpatialCoframeCovectorCoordinates) :
    IdentityECTemporalCurvatureCoordinates :=
  identityDiracDualECTemporalEvolutionKernelPart current +
    identityDiracDualECTemporalEvolutionSectionCoordinates response

theorem identityDiracDualECTemporalEvolutionObservation_targetCoordinates
    (current : IdentityECTemporalCurvatureCoordinates)
    (response : IdentityECSpatialCoframeCovectorCoordinates) :
    identityDiracDualECTemporalEvolutionObservation
        (identityECTemporalCurvatureOfCoordinates
          (identityDiracDualECTemporalEvolutionTargetCoordinates
            current response)) =
      response := by
  rw [identityDiracDualECTemporalEvolutionTargetCoordinates,
    identityECTemporalCurvatureOfCoordinates_add,
    identityDiracDualECTemporalEvolutionObservation_add,
    identityDiracDualECTemporalEvolutionObservation_kernelPart]
  change
    0 + identityDiracDualECTemporalEvolutionObservation
          (identityDiracDualECTemporalEvolutionSection response) = response
  rw [identityDiracDualECTemporalEvolutionObservation_section, zero_add]

theorem identityDiracDualECTemporalEvolutionKernelPart_targetCoordinates
    (current : IdentityECTemporalCurvatureCoordinates)
    (response : IdentityECSpatialCoframeCovectorCoordinates) :
    identityDiracDualECTemporalEvolutionKernelPart
        (identityDiracDualECTemporalEvolutionTargetCoordinates
          current response) =
      identityDiracDualECTemporalEvolutionKernelPart current := by
  unfold identityDiracDualECTemporalEvolutionKernelPart
    identityDiracDualECTemporalEvolutionTargetCoordinates
  rw [identityECTemporalCurvatureOfCoordinates_add,
    identityDiracDualECTemporalEvolutionObservation_add,
    identityDiracDualECTemporalEvolutionObservation_kernelPart]
  rw [show
    identityECTemporalCurvatureOfCoordinates
          (identityDiracDualECTemporalEvolutionSectionCoordinates response) =
        identityDiracDualECTemporalEvolutionSection response by
      rfl,
    identityDiracDualECTemporalEvolutionObservation_section]
  change
    identityDiracDualECTemporalEvolutionKernelPart current +
          identityDiracDualECTemporalEvolutionSectionCoordinates response -
        identityDiracDualECTemporalEvolutionSectionCoordinates
          (0 + response) =
      identityDiracDualECTemporalEvolutionKernelPart current
  rw [zero_add]
  abel

/-- No second electric target can have both the same twelve evolution rows
and the same six transported kernel coordinates. -/
theorem identityDiracDualECTemporalEvolutionTargetCoordinates_unique
    (current candidate : IdentityECTemporalCurvatureCoordinates)
    (response : IdentityECSpatialCoframeCovectorCoordinates)
    (hObservation :
      identityDiracDualECTemporalEvolutionObservation
          (identityECTemporalCurvatureOfCoordinates candidate) = response)
    (hKernel :
      identityDiracDualECTemporalEvolutionKernelPart candidate =
        identityDiracDualECTemporalEvolutionKernelPart current) :
    candidate =
      identityDiracDualECTemporalEvolutionTargetCoordinates current
        response := by
  calc
    candidate =
        identityDiracDualECTemporalEvolutionKernelPart candidate +
          identityDiracDualECTemporalEvolutionSectionCoordinates
            (identityDiracDualECTemporalEvolutionObservation
              (identityECTemporalCurvatureOfCoordinates candidate)) := by
      unfold identityDiracDualECTemporalEvolutionKernelPart
      abel
    _ = identityDiracDualECTemporalEvolutionKernelPart current +
          identityDiracDualECTemporalEvolutionSectionCoordinates response := by
      rw [hKernel, hObservation]
    _ = identityDiracDualECTemporalEvolutionTargetCoordinates current
          response := rfl

/-! ## Full curvature target: magnetic constraints remain untouched -/

/-- Temporal--spatial part of a raw curvature. -/
def identityECTemporalCurvaturePart
    (rawCurvature : PhysicalBivector) : PhysicalBivector :=
  identityECTemporalCurvatureOfCoordinates
    (identityECTemporalCurvatureCoordinatesOf rawCurvature)

/-- Spatial--spatial part of a raw curvature. -/
def identityECSpatialCurvaturePart
    (rawCurvature : PhysicalBivector) : PhysicalBivector :=
  rawCurvature - identityECTemporalCurvaturePart rawCurvature

/-- Replace the electric evolution rows while leaving the magnetic curvature
and electric kernel responsibility unchanged. -/
def identityDiracDualECCauchyEvolutionCurvatureTarget
    (current : PhysicalBivector)
    (temporalResponse : IdentityECSpatialCoframeCovectorCoordinates) :
    PhysicalBivector :=
  identityECSpatialCurvaturePart current +
    identityECTemporalCurvatureOfCoordinates
      (identityDiracDualECTemporalEvolutionTargetCoordinates
        (identityECTemporalCurvatureCoordinatesOf current)
        temporalResponse)

/-- On a temporal--spatial slot, the full Cauchy target is exactly the
kernel-faithful electric target. -/
theorem identityDiracDualECCauchyEvolutionCurvatureTarget_temporal
    (current : PhysicalBivector)
    (temporalResponse : IdentityECSpatialCoframeCovectorCoordinates)
    (internalPair : Fin 6)
    (direction : Fin 3) :
    identityDiracDualECCauchyEvolutionCurvatureTarget current
        temporalResponse internalPair
        (identityECTemporalSpatialPair direction) =
      identityDiracDualECTemporalEvolutionTargetCoordinates
        (identityECTemporalCurvatureCoordinatesOf current)
        temporalResponse internalPair direction := by
  fin_cases direction <;>
    simp [identityDiracDualECCauchyEvolutionCurvatureTarget,
      identityECSpatialCurvaturePart,
      identityECTemporalCurvaturePart,
      identityECTemporalCurvatureCoordinatesOf,
      identityECTemporalCurvatureOfCoordinates,
      identityECTemporalSpatialPair]

theorem identityDiracDualECTemporalEvolutionObservation_cauchyTarget
    (current : PhysicalBivector)
    (temporalResponse : IdentityECSpatialCoframeCovectorCoordinates) :
    identityDiracDualECTemporalEvolutionObservation
        (identityDiracDualECCauchyEvolutionCurvatureTarget current
          temporalResponse) =
      identityDiracDualECTemporalEvolutionObservation
          (identityECSpatialCurvaturePart current) + temporalResponse := by
  rw [identityDiracDualECCauchyEvolutionCurvatureTarget,
    identityDiracDualECTemporalEvolutionObservation_add,
    identityDiracDualECTemporalEvolutionObservation_targetCoordinates]

theorem identityDiracDualECConstraintObservation_add
    (first second : PhysicalBivector) :
    identityDiracDualECConstraintObservation (first + second) =
      identityDiracDualECConstraintObservation first +
        identityDiracDualECConstraintObservation second := by
  funext row
  unfold identityDiracDualECConstraintObservation
  rw [identityDiracDualECCurvatureObservation_add]
  rfl

theorem identityDiracDualECConstraintObservation_sub
    (first second : PhysicalBivector) :
    identityDiracDualECConstraintObservation (first - second) =
      identityDiracDualECConstraintObservation first -
        identityDiracDualECConstraintObservation second := by
  funext row
  unfold identityDiracDualECConstraintObservation
  rw [identityDiracDualECCurvatureObservation_sub]
  rfl

/-- The Cauchy target cannot manufacture or erase an independent EC
constraint. -/
theorem identityDiracDualECConstraintObservation_cauchyTarget
    (current : PhysicalBivector)
    (temporalResponse : IdentityECSpatialCoframeCovectorCoordinates) :
    identityDiracDualECConstraintObservation
        (identityDiracDualECCauchyEvolutionCurvatureTarget current
          temporalResponse) =
      identityDiracDualECConstraintObservation current := by
  rw [identityDiracDualECCauchyEvolutionCurvatureTarget,
    identityDiracDualECConstraintObservation_add,
    identityDiracDualECConstraintObservation_temporal_zero]
  unfold identityECSpatialCurvaturePart identityECTemporalCurvaturePart
  rw [identityDiracDualECConstraintObservation_sub,
    identityDiracDualECConstraintObservation_temporal_zero]
  simp

/-- Canonical spatial--spatial pair order `(23,31,12)`. -/
def identityECSpatialSpatialPair (direction : Fin 3) : Fin 6 :=
  ⟨direction.val + 3, by omega⟩

/-- The target changes no spatial curvature coordinate. -/
theorem identityDiracDualECCauchyEvolutionCurvatureTarget_spatial
    (current : PhysicalBivector)
    (temporalResponse : IdentityECSpatialCoframeCovectorCoordinates)
    (internalPair : Fin 6)
    (direction : Fin 3) :
    identityDiracDualECCauchyEvolutionCurvatureTarget current
        temporalResponse internalPair
        (identityECSpatialSpatialPair direction) =
      current internalPair (identityECSpatialSpatialPair direction) := by
  fin_cases direction <;>
    simp [identityDiracDualECCauchyEvolutionCurvatureTarget,
      identityECSpatialCurvaturePart,
      identityECTemporalCurvaturePart,
      identityECTemporalCurvatureOfCoordinates,
      identityECSpatialSpatialPair]

/-- Total-row target: the caller supplies the desired twelve full EC
evolution rows; the magnetic contribution is subtracted internally. -/
def identityDiracDualECTotalEvolutionCurvatureTarget
    (current : PhysicalBivector)
    (desired : IdentityECSpatialCoframeCovectorCoordinates) :
    PhysicalBivector :=
  identityDiracDualECCauchyEvolutionCurvatureTarget current
    (desired -
      identityDiracDualECTemporalEvolutionObservation
        (identityECSpatialCurvaturePart current))

theorem identityDiracDualECTotalEvolutionCurvatureTarget_temporal
    (current : PhysicalBivector)
    (desired : IdentityECSpatialCoframeCovectorCoordinates)
    (internalPair : Fin 6)
    (direction : Fin 3) :
    identityDiracDualECTotalEvolutionCurvatureTarget current desired
        internalPair (identityECTemporalSpatialPair direction) =
      identityDiracDualECTemporalEvolutionTargetCoordinates
        (identityECTemporalCurvatureCoordinatesOf current)
        (desired -
          identityDiracDualECTemporalEvolutionObservation
            (identityECSpatialCurvaturePart current))
        internalPair direction := by
  rw [identityDiracDualECTotalEvolutionCurvatureTarget,
    identityDiracDualECCauchyEvolutionCurvatureTarget_temporal]

theorem identityDiracDualECTemporalEvolutionObservation_totalTarget
    (current : PhysicalBivector)
    (desired : IdentityECSpatialCoframeCovectorCoordinates) :
    identityDiracDualECTemporalEvolutionObservation
        (identityDiracDualECTotalEvolutionCurvatureTarget current desired) =
      desired := by
  rw [identityDiracDualECTotalEvolutionCurvatureTarget,
    identityDiracDualECTemporalEvolutionObservation_cauchyTarget]
  abel

theorem identityDiracDualECConstraintObservation_totalTarget
    (current : PhysicalBivector)
    (desired : IdentityECSpatialCoframeCovectorCoordinates) :
    identityDiracDualECConstraintObservation
        (identityDiracDualECTotalEvolutionCurvatureTarget current desired) =
      identityDiracDualECConstraintObservation current := by
  exact identityDiracDualECConstraintObservation_cauchyTarget _ _

/-- The total Cauchy target transports the full six-dimensional electric
kernel responsibility unchanged. -/
theorem identityDiracDualECTemporalEvolutionKernelPart_totalTarget
    (current : PhysicalBivector)
    (desired : IdentityECSpatialCoframeCovectorCoordinates) :
    identityDiracDualECTemporalEvolutionKernelPart
        (identityECTemporalCurvatureCoordinatesOf
          (identityDiracDualECTotalEvolutionCurvatureTarget current desired)) =
      identityDiracDualECTemporalEvolutionKernelPart
        (identityECTemporalCurvatureCoordinatesOf current) := by
  have coordinatesEquality :
      identityECTemporalCurvatureCoordinatesOf
          (identityDiracDualECTotalEvolutionCurvatureTarget current desired) =
        identityDiracDualECTemporalEvolutionTargetCoordinates
          (identityECTemporalCurvatureCoordinatesOf current)
          (desired -
            identityDiracDualECTemporalEvolutionObservation
              (identityECSpatialCurvaturePart current)) := by
    funext internalPair direction
    exact identityDiracDualECTotalEvolutionCurvatureTarget_temporal
      current desired internalPair direction
  rw [coordinatesEquality,
    identityDiracDualECTemporalEvolutionKernelPart_targetCoordinates]

theorem identityDiracDualECTotalEvolutionCurvatureTarget_spatial
    (current : PhysicalBivector)
    (desired : IdentityECSpatialCoframeCovectorCoordinates)
    (internalPair : Fin 6)
    (direction : Fin 3) :
    identityDiracDualECTotalEvolutionCurvatureTarget current desired
        internalPair (identityECSpatialSpatialPair direction) =
      current internalPair (identityECSpatialSpatialPair direction) := by
  unfold identityDiracDualECTotalEvolutionCurvatureTarget
  exact identityDiracDualECCauchyEvolutionCurvatureTarget_spatial _ _ _ _

end

