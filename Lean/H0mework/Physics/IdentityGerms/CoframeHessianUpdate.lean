import H0mework.Physics.IdentityGerms.CoframeHessianSection
import H0mework.Physics.IdentityGerms.IdentityECLoad

/-!
# Typed and kernel-faithful identity-contact EC Hessian update

The preceding geometric section exposes exactly the ten coframe rows allowed
by local Lorentz covariance.  This module turns that image into a typed
carrier and uses the section only as an increment on a current holonomic
coframe Hessian.

The update keeps the complete current kernel of the EC observation.  In
particular, choosing the Weyl-zero normal representative for the increment
does not assert that the current Weyl/kernel responsibility vanishes and
does not replace it by a branch choice.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeIdentityECHolonomicCoframeHessianUpdate

open ProofFreeRicherAnholonomicSource
open StageNineCartanTangentSimplicityResponse
open StageNineCoframeHolonomicSecondJetCarrier
open StageNineDiracDualFormNativeIdentityECCurvatureNormalSection
open StageNineDiracDualFormNativeIdentityECHolonomicCoframeHessianSection
open StageNineDiracDualFormNativeSynchronizedECNormalLocalActualLift
open StageNineEnrichedProofFreeSource
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineHolonomicGravityCurvatureVarianceNormalization
open StageNineLinearPlebanskiCoframeActionPrincipal
open StageNineTopologicalFourFormPairing

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 2400000

/-! ## Typed ten-row carrier -/

/-- Lorentz-compatible coframe rows.  These are the ten covariant Einstein
rows, not an ambient sixteen-row shell supplied with an external receipt. -/
def identityECEtaCompatibleRowsSubmodule :
    Submodule ℝ LorentzianCoframe where
  carrier := { coordinates | ∀ row column,
    minkowskiInternalSign row * coordinates row column =
      minkowskiInternalSign column * coordinates column row }
  zero_mem' := by
    intro row column
    simp
  add_mem' := by
    intro first second firstCompatible secondCompatible row column
    simp only [Matrix.add_apply]
    calc
      minkowskiInternalSign row *
          (first row column + second row column) =
        minkowskiInternalSign row * first row column +
          minkowskiInternalSign row * second row column := by ring
      _ = minkowskiInternalSign column * first column row +
          minkowskiInternalSign column * second column row := by
        rw [firstCompatible row column, secondCompatible row column]
      _ = minkowskiInternalSign column *
          (first column row + second column row) := by ring
  smul_mem' := by
    intro parameter coordinates compatible row column
    simp only [Matrix.smul_apply, smul_eq_mul]
    calc
      minkowskiInternalSign row * (parameter * coordinates row column) =
        parameter *
          (minkowskiInternalSign row * coordinates row column) := by ring
      _ = parameter *
          (minkowskiInternalSign column * coordinates column row) := by
        rw [compatible row column]
      _ = minkowskiInternalSign column *
          (parameter * coordinates column row) := by ring

abbrev IdentityECEtaCompatibleRows :=
  identityECEtaCompatibleRowsSubmodule

/-- The canonical ten-row projection carries its compatibility proof
internally. -/
def identityECEtaCompatibleProjection
    (coordinates : LorentzianCoframe) : IdentityECEtaCompatibleRows :=
  ⟨identityECEtaSymmetricPart coordinates,
    identityECEtaSymmetricPart_compatible coordinates⟩

@[simp] theorem identityECEtaSymmetricPart_typed
    (coordinates : IdentityECEtaCompatibleRows) :
    identityECEtaSymmetricPart coordinates.1 = coordinates.1 := by
  ext row column
  have compatible := coordinates.2 row column
  fin_cases row <;> fin_cases column <;>
    simp [identityECEtaSymmetricPart, identityECEtaAdjoint,
      minkowskiInternalSign] at compatible ⊢ <;>
    linarith

/-! ## Typed normal increment -/

/-- Normal-coordinate holonomic Hessian increment generated by a typed
ten-row target. -/
def identityECTypedHolonomicCoframeHessianSection
    (coordinates : IdentityECEtaCompatibleRows) :
    CoframeHolonomicSecondJet :=
  identityECHolonomicCoframeHessianSection coordinates.1

/-- The typed section is a genuine right inverse: no six-row projection is
hidden at this public mouth. -/
theorem identityDiracDualECCurvatureObservation_typedHessianSection
    (coordinates : IdentityECEtaCompatibleRows) :
    coframeCovectorCoordinates
        (identityDiracDualECCurvatureObservation
          (identityECLeviCivitaCurvatureOfCoframeHessian
            (identityECTypedHolonomicCoframeHessianSection coordinates))) =
      coordinates.1 := by
  rw [identityECTypedHolonomicCoframeHessianSection,
    identityDiracDualECCurvatureObservation_holonomicHessianSection,
    identityECEtaSymmetricPart_typed]

/-! ## Complete current observation -/

theorem identityECLeviCivitaCurvatureOfCoframeHessian_add
    (first second : CoframeHolonomicSecondJet) :
    identityECLeviCivitaCurvatureOfCoframeHessian (first + second) =
      identityECLeviCivitaCurvatureOfCoframeHessian first +
        identityECLeviCivitaCurvatureOfCoframeHessian second := by
  funext internalPair spacetimePair
  simp [identityECLeviCivitaCurvatureOfCoframeHessian,
    identityECLeviCivitaSpinConnectionFirstJet,
    identityECCoframeMetricHessian]
  ring

theorem identityECLeviCivitaCurvatureOfCoframeHessian_sub
    (first second : CoframeHolonomicSecondJet) :
    identityECLeviCivitaCurvatureOfCoframeHessian
        (first + (-1 : ℝ) • second) =
      identityECLeviCivitaCurvatureOfCoframeHessian first -
        identityECLeviCivitaCurvatureOfCoframeHessian second := by
  funext internalPair spacetimePair
  simp [identityECLeviCivitaCurvatureOfCoframeHessian,
    identityECLeviCivitaSpinConnectionFirstJet,
    identityECCoframeMetricHessian]
  ring

/-- The ten-row EC observation generated forward from a current holonomic
coframe Hessian. -/
def identityECHolonomicCoframeHessianObservation
    (hessian : CoframeHolonomicSecondJet) : LorentzianCoframe :=
  coframeCovectorCoordinates
    (identityDiracDualECCurvatureObservation
      (identityECLeviCivitaCurvatureOfCoframeHessian hessian))

theorem identityECHolonomicCoframeHessianObservation_add
    (first second : CoframeHolonomicSecondJet) :
    identityECHolonomicCoframeHessianObservation (first + second) =
      identityECHolonomicCoframeHessianObservation first +
        identityECHolonomicCoframeHessianObservation second := by
  rw [identityECHolonomicCoframeHessianObservation,
    identityECLeviCivitaCurvatureOfCoframeHessian_add,
    identityDiracDualECCurvatureObservation_add]
  rfl

theorem identityECHolonomicCoframeHessianObservation_sub
    (first second : CoframeHolonomicSecondJet) :
    identityECHolonomicCoframeHessianObservation
        (first + (-1 : ℝ) • second) =
      identityECHolonomicCoframeHessianObservation first -
        identityECHolonomicCoframeHessianObservation second := by
  rw [identityECHolonomicCoframeHessianObservation,
    identityECLeviCivitaCurvatureOfCoframeHessian_sub,
    identityDiracDualECCurvatureObservation_sub]
  rfl

theorem identityECHolonomicCoframeHessian_coordinate_symmetric
    (hessian : CoframeHolonomicSecondJet)
    (first second internal column : LorentzianIndex) :
    hessian.1 (coordinateDirection first) (coordinateDirection second)
        internal column =
      hessian.1 (coordinateDirection second) (coordinateDirection first)
        internal column := by
  have symmetric := coframeHolonomicSecondJet_symmetric hessian
    (coordinateDirection first) (coordinateDirection second)
  exact congrFun (congrFun symmetric internal) column

/-- Holonomicity forces pair exchange symmetry on the curvature generated by
the Levi--Civita symbol. -/
theorem identityECLeviCivitaCurvatureOfCoframeHessian_pairExchange
    (hessian : CoframeHolonomicSecondJet)
    (first second : Fin 6) :
    identityECLeviCivitaCurvatureOfCoframeHessian hessian first second =
      identityECLeviCivitaCurvatureOfCoframeHessian hessian second first := by
  fin_cases first <;> fin_cases second <;>
    simp [identityECLeviCivitaCurvatureOfCoframeHessian,
      identityECLeviCivitaSpinConnectionFirstJet,
      identityECCoframeMetricHessian,
      identityECHolonomicCoframeHessian_coordinate_symmetric,
      pairFirst, pairSecond, minkowskiInternalSign] <;>
    ring

/-- Pair exchange symmetry of a raw curvature is sufficient for the repaired
EC coframe observation to land in the ten Lorentz-compatible rows. -/
theorem identityDiracDualECCurvatureObservation_compatible_of_pairExchange
    (rawCurvature : PhysicalBivector)
    (pairExchange : ∀ first second,
      rawCurvature first second = rawCurvature second first)
    (row column : LorentzianIndex) :
    minkowskiInternalSign row *
        coframeCovectorCoordinates
          (identityDiracDualECCurvatureObservation rawCurvature) row column =
      minkowskiInternalSign column *
        coframeCovectorCoordinates
          (identityDiracDualECCurvatureObservation rawCurvature) column row := by
  fin_cases row <;> fin_cases column <;>
    simp [identityDiracDualECCurvatureObservation,
      coframeCovectorCoordinates, coframeCoordinateDirection,
      physicalIIPlusCoframeTangent, coframeWedgeTangent,
      internalBivectorDual, lorentzianCoframeHodge,
      gravityInternalPairVarianceNormalization,
      gravityTopologicalWedgeCoefficient,
      orientedTwoFormWedgeCoefficient_explicit,
      lorentzianTwoFormSign, minkowskiInternalSign,
      pairFirst, pairSecond, Matrix.one_apply,
      Fin.sum_univ_six, pairExchange]

/-- A genuine Levi--Civita curvature generated from a holonomic Hessian
cannot acquire one of the six Lorentz-antisymmetric coframe rows. -/
theorem identityECHolonomicCoframeHessianObservation_compatible
    (hessian : CoframeHolonomicSecondJet)
    (row column : LorentzianIndex) :
    minkowskiInternalSign row *
        identityECHolonomicCoframeHessianObservation hessian row column =
      minkowskiInternalSign column *
        identityECHolonomicCoframeHessianObservation hessian column row :=
  identityDiracDualECCurvatureObservation_compatible_of_pairExchange
    (identityECLeviCivitaCurvatureOfCoframeHessian hessian)
    (identityECLeviCivitaCurvatureOfCoframeHessian_pairExchange hessian)
    row column

/-- Typed observation of a current holonomic Hessian. -/
def identityECTypedHolonomicCoframeHessianObservation
    (hessian : CoframeHolonomicSecondJet) :
    IdentityECEtaCompatibleRows :=
  ⟨identityECHolonomicCoframeHessianObservation hessian,
    identityECHolonomicCoframeHessianObservation_compatible hessian⟩

theorem identityECTypedHolonomicCoframeHessianObservation_add
    (first second : CoframeHolonomicSecondJet) :
    identityECTypedHolonomicCoframeHessianObservation (first + second) =
      identityECTypedHolonomicCoframeHessianObservation first +
        identityECTypedHolonomicCoframeHessianObservation second := by
  apply Subtype.ext
  change identityECHolonomicCoframeHessianObservation (first + second) =
    identityECHolonomicCoframeHessianObservation first +
      identityECHolonomicCoframeHessianObservation second
  exact identityECHolonomicCoframeHessianObservation_add first second

theorem identityECTypedHolonomicCoframeHessianObservation_sub
    (first second : CoframeHolonomicSecondJet) :
    identityECTypedHolonomicCoframeHessianObservation
        (first + (-1 : ℝ) • second) =
      identityECTypedHolonomicCoframeHessianObservation first +
        (-1 : ℝ) •
          identityECTypedHolonomicCoframeHessianObservation second := by
  apply Subtype.ext
  change
    identityECHolonomicCoframeHessianObservation
        (first + (-1 : ℝ) • second) =
      identityECHolonomicCoframeHessianObservation first +
        (-1 : ℝ) •
          identityECHolonomicCoframeHessianObservation second
  rw [identityECHolonomicCoframeHessianObservation_sub]
  module

@[simp] theorem identityECTypedHolonomicCoframeHessianObservation_section
    (coordinates : IdentityECEtaCompatibleRows) :
    identityECTypedHolonomicCoframeHessianObservation
        (identityECTypedHolonomicCoframeHessianSection coordinates) =
      coordinates := by
  apply Subtype.ext
  change
    identityECHolonomicCoframeHessianObservation
        (identityECTypedHolonomicCoframeHessianSection coordinates) =
      coordinates.1
  exact identityDiracDualECCurvatureObservation_typedHessianSection coordinates

/-! ## Kernel-faithful update -/

/-- Complete Hessian responsibility invisible to the ten-row EC observation.
It is computed from the current Hessian itself. -/
def identityECHolonomicCoframeHessianKernelPart
    (current : CoframeHolonomicSecondJet) :
    CoframeHolonomicSecondJet :=
  current + (-1 : ℝ) •
    identityECTypedHolonomicCoframeHessianSection
      (identityECTypedHolonomicCoframeHessianObservation current)

theorem identityECTypedHolonomicCoframeHessianObservation_kernelPart
    (current : CoframeHolonomicSecondJet) :
    identityECTypedHolonomicCoframeHessianObservation
        (identityECHolonomicCoframeHessianKernelPart current) =
      0 := by
  unfold identityECHolonomicCoframeHessianKernelPart
  rw [identityECTypedHolonomicCoframeHessianObservation_sub,
    identityECTypedHolonomicCoframeHessianObservation_section]
  module

/-- Replace only the ten EC-observed Hessian rows while retaining every
current kernel/Weyl coordinate. -/
def identityECHolonomicCoframeHessianTarget
    (current : CoframeHolonomicSecondJet)
    (target : IdentityECEtaCompatibleRows) :
    CoframeHolonomicSecondJet :=
  identityECHolonomicCoframeHessianKernelPart current +
    identityECTypedHolonomicCoframeHessianSection target

theorem identityECTypedHolonomicCoframeHessianObservation_target
    (current : CoframeHolonomicSecondJet)
    (target : IdentityECEtaCompatibleRows) :
    identityECTypedHolonomicCoframeHessianObservation
        (identityECHolonomicCoframeHessianTarget current target) =
      target := by
  unfold identityECHolonomicCoframeHessianTarget
  rw [identityECTypedHolonomicCoframeHessianObservation_add,
    identityECTypedHolonomicCoframeHessianObservation_kernelPart,
    identityECTypedHolonomicCoframeHessianObservation_section,
    zero_add]

theorem identityECHolonomicCoframeHessianKernelPart_target
    (current : CoframeHolonomicSecondJet)
    (target : IdentityECEtaCompatibleRows) :
    identityECHolonomicCoframeHessianKernelPart
        (identityECHolonomicCoframeHessianTarget current target) =
      identityECHolonomicCoframeHessianKernelPart current := by
  change
    identityECHolonomicCoframeHessianTarget current target +
        (-1 : ℝ) • identityECTypedHolonomicCoframeHessianSection
          (identityECTypedHolonomicCoframeHessianObservation
            (identityECHolonomicCoframeHessianTarget current target)) =
      identityECHolonomicCoframeHessianKernelPart current
  rw [identityECTypedHolonomicCoframeHessianObservation_target]
  change
    (identityECHolonomicCoframeHessianKernelPart current +
        identityECTypedHolonomicCoframeHessianSection target) +
      (-1 : ℝ) • identityECTypedHolonomicCoframeHessianSection target =
        identityECHolonomicCoframeHessianKernelPart current
  module

theorem identityECHolonomicCoframeHessian_decomposition
    (current : CoframeHolonomicSecondJet) :
    current =
      identityECHolonomicCoframeHessianKernelPart current +
        identityECTypedHolonomicCoframeHessianSection
          (identityECTypedHolonomicCoframeHessianObservation current) := by
  unfold identityECHolonomicCoframeHessianKernelPart
  module

/-- Branch-free uniqueness at fixed current kernel and fixed typed target.
No Hessian representative, inverse, residual endpoint, or witness is an
input. -/
theorem identityECHolonomicCoframeHessianTarget_unique
    (current candidate : CoframeHolonomicSecondJet)
    (target : IdentityECEtaCompatibleRows)
    (observationEquality :
      identityECTypedHolonomicCoframeHessianObservation candidate = target)
    (kernelEquality :
      identityECHolonomicCoframeHessianKernelPart candidate =
        identityECHolonomicCoframeHessianKernelPart current) :
    candidate = identityECHolonomicCoframeHessianTarget current target := by
  calc
    candidate =
        identityECHolonomicCoframeHessianKernelPart candidate +
          identityECTypedHolonomicCoframeHessianSection
            (identityECTypedHolonomicCoframeHessianObservation candidate) :=
      identityECHolonomicCoframeHessian_decomposition candidate
    _ = identityECHolonomicCoframeHessianKernelPart current +
          identityECTypedHolonomicCoframeHessianSection target := by
      rw [kernelEquality, observationEquality]
    _ = identityECHolonomicCoframeHessianTarget current target := rfl

/-! ## Source/action-owned ten-row target -/

/-- The typed gravitational Hessian target is generated only from the live
repaired-action EC load at the current contact.  The six Lorentz-skew rows
remain an explicit downstream responsibility. -/
def sourceActionGeneratedIdentityECHolonomicCoframeHessianTargetRows
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    IdentityECEtaCompatibleRows :=
  identityECEtaCompatibleProjection
    (coframeCovectorCoordinates
      (-diracDualFormNativeIdentityECLoad source current))

/-- Apply the source/action-owned ten-row target to a current holonomic
Hessian without replacing its existing kernel. -/
def sourceActionGeneratedIdentityECHolonomicCoframeHessianTarget
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (currentHessian : CoframeHolonomicSecondJet) :
    CoframeHolonomicSecondJet :=
  identityECHolonomicCoframeHessianTarget currentHessian
    (sourceActionGeneratedIdentityECHolonomicCoframeHessianTargetRows
      source current)

theorem identityECEtaSymmetricPart_neg_add_eq_antisymmetricPart
    (coordinates : LorentzianCoframe) :
    identityECEtaSymmetricPart (-coordinates) + coordinates =
      identityECEtaAntisymmetricPart coordinates := by
  ext row column
  simp [identityECEtaSymmetricPart, identityECEtaAntisymmetricPart,
    identityECEtaAdjoint]
  ring

/-- **Ten-plus-six settlement.**  On the updated Hessian, the LC curvature
cancels exactly the Lorentz-compatible action load.  The remainder is not
discarded: it is literally the six-row Cartan/live-spin carrier. -/
theorem sourceActionGeneratedIdentityECHolonomicCoframeHessianTarget_settlement
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (currentHessian : CoframeHolonomicSecondJet) :
    identityECHolonomicCoframeHessianObservation
        (sourceActionGeneratedIdentityECHolonomicCoframeHessianTarget
          source current currentHessian) +
      coframeCovectorCoordinates
        (diracDualFormNativeIdentityECLoad source current) =
      identityECEtaAntisymmetricPart
        (coframeCovectorCoordinates
          (diracDualFormNativeIdentityECLoad source current)) := by
  have observed := congrArg Subtype.val
    (identityECTypedHolonomicCoframeHessianObservation_target
      currentHessian
      (sourceActionGeneratedIdentityECHolonomicCoframeHessianTargetRows
        source current))
  change
    identityECHolonomicCoframeHessianObservation
        (sourceActionGeneratedIdentityECHolonomicCoframeHessianTarget
          source current currentHessian) =
      (sourceActionGeneratedIdentityECHolonomicCoframeHessianTargetRows
        source current).1 at observed
  rw [observed]
  unfold sourceActionGeneratedIdentityECHolonomicCoframeHessianTargetRows
    identityECEtaCompatibleProjection
  rw [coframeCovectorCoordinates_neg]
  exact identityECEtaSymmetricPart_neg_add_eq_antisymmetricPart _

/-- The source-owned update preserves the current Hessian kernel exactly. -/
theorem sourceActionGeneratedIdentityECHolonomicCoframeHessianTarget_kernelFaithful
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (currentHessian : CoframeHolonomicSecondJet) :
    identityECHolonomicCoframeHessianKernelPart
        (sourceActionGeneratedIdentityECHolonomicCoframeHessianTarget
          source current currentHessian) =
      identityECHolonomicCoframeHessianKernelPart currentHessian :=
  identityECHolonomicCoframeHessianKernelPart_target _ _

end

end
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeIdentityECHolonomicCoframeHessianUpdate
