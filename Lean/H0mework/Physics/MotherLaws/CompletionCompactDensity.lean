import H0mework.Physics.MotherLaws.CompletionPolynomial

set_option autoImplicit false

namespace SaturationMonoid.PhysicsCore.Stage10.SourceUniqueness.MotherLawCompletion

open Set Filter
open scoped Topology

noncomputable section

variable {X : Type*} [TopologicalSpace X] [CompactSpace X]

theorem real_constant_mem_rational_closure (A : Subalgebra ℚ C(X, ℝ)) (r : ℝ) :
    ContinuousMap.const X r ∈ A.topologicalClosure := by
  have closed : IsClosed {a : ℝ | ContinuousMap.const X a ∈ A.topologicalClosure} :=
    A.isClosed_topologicalClosure.preimage ContinuousMap.continuous_const'
  have included : Set.range ((↑) : ℚ → ℝ) ⊆
      {a : ℝ | ContinuousMap.const X a ∈ A.topologicalClosure} := by
    rintro _ ⟨q, rfl⟩
    exact A.le_topologicalClosure (A.algebraMap_mem q)
  exact closure_minimal included closed (Rat.denseRange_cast r)

/-- The real scalar structure is generated by closing the rational constants. -/
def realClosure (A : Subalgebra ℚ C(X, ℝ)) : Subalgebra ℝ C(X, ℝ) where
  __ := A.topologicalClosure.toSubsemiring
  algebraMap_mem' r := real_constant_mem_rational_closure A r

theorem rational_closure_eq_top (A : Subalgebra ℚ C(X, ℝ))
    (separates : A.SeparatesPoints) : A.topologicalClosure = ⊤ := by
  have separated : (realClosure A).SeparatesPoints := by
    intro x y different
    obtain ⟨f, ⟨g, member, rfl⟩, distinct⟩ := separates different
    exact ⟨g, ⟨g, A.le_topologicalClosure member, rfl⟩, distinct⟩
  have dense := ContinuousMap.subalgebra_topologicalClosure_eq_top_of_separatesPoints
    (realClosure A) separated
  have sameSet := congrArg (fun B : Subalgebra ℝ C(X, ℝ) => (B : Set C(X, ℝ))) dense
  change closure (closure (A : Set C(X, ℝ))) = Set.univ at sameSet
  rw [closure_closure] at sameSet
  exact SetLike.coe_injective sameSet

def restrictedPolynomial (n : ℕ) (K : Set (Fin n → ℝ)) :
    MvPolynomial (Fin n) ℚ →ₐ[ℚ] C(K, ℝ) :=
  MvPolynomial.aeval fun i =>
    ⟨fun x => x.val i, (continuous_apply i).comp continuous_subtype_val⟩

@[simp] theorem restrictedPolynomial_apply (n : ℕ) (K : Set (Fin n → ℝ))
    (p : MvPolynomial (Fin n) ℚ) (x : K) :
    restrictedPolynomial n K p x = scalarPolynomial p x.val := by
  change (ContinuousMap.evalAlgHom ℚ ℝ x) (MvPolynomial.aeval _ p) = _
  rw [MvPolynomial.comp_aeval_apply]
  rfl

theorem restrictedPolynomial_separates (n : ℕ) (K : Set (Fin n → ℝ)) :
    (restrictedPolynomial n K).range.SeparatesPoints := by
  intro x y different
  have coord : ∃ i, x.val i ≠ y.val i := by
    by_contra! same
    exact different (Subtype.ext (funext same))
  obtain ⟨i, hi⟩ := coord
  refine ⟨restrictedPolynomial n K (MvPolynomial.X i),
    ⟨restrictedPolynomial n K (MvPolynomial.X i), ⟨MvPolynomial.X i, rfl⟩, rfl⟩, ?_⟩
  simpa [restrictedPolynomial] using hi

theorem compact_polynomial_dense (n : ℕ) (K : Set (Fin n → ℝ)) [CompactSpace K] :
    DenseRange (restrictedPolynomial n K) := by
  have closed := rational_closure_eq_top (restrictedPolynomial n K).range
    (restrictedPolynomial_separates n K)
  rw [DenseRange, dense_iff_closure_eq]
  exact congrArg (fun A : Subalgebra ℚ C(K, ℝ) => (A : Set C(K, ℝ))) closed

theorem compact_polynomial_approximation (n : ℕ) (K : Set (Fin n → ℝ)) [CompactSpace K]
    (f : C(K, ℝ)) (ε : ℝ) (positive : 0 < ε) :
    ∃ p : MvPolynomial (Fin n) ℚ, ∀ x : K,
      dist (scalarPolynomial p x.val) (f x) < ε := by
  obtain ⟨p, close⟩ := (compact_polynomial_dense n K).exists_dist_lt f positive
  have near : dist (restrictedPolynomial n K p) f < ε := by
    simpa only [dist_comm] using close
  refine ⟨p, fun x => ?_⟩
  rw [← restrictedPolynomial_apply]
  exact lt_of_le_of_lt (ContinuousMap.dist_apply_le_dist x) near

end
end SaturationMonoid.PhysicsCore.Stage10.SourceUniqueness.MotherLawCompletion
