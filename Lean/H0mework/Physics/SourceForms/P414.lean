import H0mework.Physics.SourceContracts.P413

/-!
# Proposition 414: atom-native finite sigma-step normal form

P413 states the current holy-grail front door directly on primitive atom fields:

* `atoms.fourPi = 4*pi`;
* `atoms.sigma (yukawa y) <= atoms.sigma weak`.

This file lowers that remaining native inequality surface to the concrete shape
an RG / threshold producer can emit without leaving primitive coordinates:

* a finite local step relation on `StandardModelScaleCode`;
* selected Yukawa paths to the weak endpoint;
* local monotonicity of the primitive `atoms.sigma` coordinate on each step;
* a certificate that the generated reachability relation is not merely the
  target sigma-order predicate in disguise.

The minimal normal-form graph is the same star as P410, now read in native
sigma coordinates: `yukawa y --> weak`.

Boundary: this is still producer-relative.  It does not derive beta functions
or thresholds; it proves that the remaining producer obligation can be supplied
as a finite atom-native sigma-step certificate.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

/-! ## Native endpoint facts -/

/-- THEOREM 1: primitive atoms pin the native GUT sigma endpoint. -/
theorem primitiveAtoms_sigma_gut_eq_nominal
    {Index A CKMCarrier : Type*} [AddCommGroup A]
    (atoms : GrandUnificationPrimitiveProducerAtoms Index A CKMCarrier) :
    atoms.sigma StandardModelScaleCode.gut = sigmaGUTNominal ℝ := by
  rw [← atoms.gutScale_is_gut]
  exact atoms.sigma_gut_nominal

/-- THEOREM 2: primitive atoms pin the native weak sigma endpoint. -/
theorem primitiveAtoms_sigma_weak_eq_nominal
    {Index A CKMCarrier : Type*} [AddCommGroup A]
    (atoms : GrandUnificationPrimitiveProducerAtoms Index A CKMCarrier) :
    atoms.sigma StandardModelScaleCode.weak = sigmaWeakNominal ℝ := by
  rw [← atoms.weakScale_is_weak]
  exact atoms.sigma_weak_nominal

/-- THEOREM 3: the primitive native sigma coordinate orders GUT below weak. -/
theorem primitiveAtoms_sigma_gut_le_weak
    {Index A CKMCarrier : Type*} [AddCommGroup A]
    (atoms : GrandUnificationPrimitiveProducerAtoms Index A CKMCarrier) :
    atoms.sigma StandardModelScaleCode.gut ≤
      atoms.sigma StandardModelScaleCode.weak := by
  rw [primitiveAtoms_sigma_gut_eq_nominal atoms,
    primitiveAtoms_sigma_weak_eq_nominal atoms]
  exact le_of_lt (sigmaGUTNominal_lt_sigmaWeakNominal ℝ)

/-! ## Minimal native sigma weak-step graph -/

/-- The minimal native sigma-step graph generated by the selected weak-bound
rows.  It is definitionally the P410 star graph, but named in the coordinate
where P413 states the remaining front door. -/
def minimalAtomNativeSigmaWeakStep :
    StandardModelScaleCode -> StandardModelScaleCode -> Prop :=
  minimalAlphaWeakStep

/-- THEOREM 4: the minimal native sigma graph has no GUT-to-weak path. -/
theorem not_minimalAtomNativeSigmaWeakStep_reach_gut_weak :
    ¬ RGStepReach minimalAtomNativeSigmaWeakStep StandardModelScaleCode.gut
      StandardModelScaleCode.weak := by
  simpa [minimalAtomNativeSigmaWeakStep] using
    not_minimalAlphaWeakStep_reach_gut_weak

/-- THEOREM 5: the minimal native sigma graph is not the full native
sigma-order relation. -/
theorem minimalAtomNativeSigmaWeakStep_reach_not_sigma_order
    {Index A CKMCarrier : Type*} [AddCommGroup A]
    (atoms : GrandUnificationPrimitiveProducerAtoms Index A CKMCarrier) :
    RGStepReach minimalAtomNativeSigmaWeakStep ≠
      fun a b : StandardModelScaleCode => atoms.sigma a ≤ atoms.sigma b := by
  intro hrel
  have hsigma :
      atoms.sigma StandardModelScaleCode.gut ≤
        atoms.sigma StandardModelScaleCode.weak :=
    primitiveAtoms_sigma_gut_le_weak atoms
  have hreach :
      RGStepReach minimalAtomNativeSigmaWeakStep StandardModelScaleCode.gut
        StandardModelScaleCode.weak := by
    simpa [hrel] using hsigma
  exact not_minimalAtomNativeSigmaWeakStep_reach_gut_weak hreach

/-! ## Atom-native finite sigma-step producer -/

/-- A concrete finite RG-step producer stated entirely in primitive sigma
coordinates. -/
structure PrimitiveAtomNativeSigmaRGStepPathProducer
    {Index A CKMCarrier : Type*} [AddCommGroup A]
    (atoms : GrandUnificationPrimitiveProducerAtoms Index A CKMCarrier) where
  step : StandardModelScaleCode -> StandardModelScaleCode -> Prop
  reach_not_sigma_order :
    RGStepReach step ≠
      fun a b : StandardModelScaleCode => atoms.sigma a ≤ atoms.sigma b
  fourPi_eq_realFourPi : atoms.fourPi = realFourPi
  selected_yukawa_reaches_weak :
    ∀ y : YukawaParameter,
      RGStepReach step (StandardModelScaleCode.yukawa y)
        StandardModelScaleCode.weak
  step_sigma_monotone :
    ∀ {a b : StandardModelScaleCode}, step a b ->
      atoms.sigma a ≤ atoms.sigma b

namespace PrimitiveAtomNativeSigmaRGStepPathProducer

variable {Index A CKMCarrier : Type*} [AddCommGroup A]
variable {atoms : GrandUnificationPrimitiveProducerAtoms Index A CKMCarrier}

/-- THEOREM 6: local native sigma monotonicity extends along finite paths. -/
theorem sigma_monotone_of_reach
    (C : PrimitiveAtomNativeSigmaRGStepPathProducer atoms)
    {a b : StandardModelScaleCode} :
    RGStepReach C.step a b -> atoms.sigma a ≤ atoms.sigma b := by
  intro h
  induction h with
  | refl =>
      exact le_rfl
  | tail hreach hbc ih =>
      exact le_trans ih (C.step_sigma_monotone hbc)

/-- THEOREM 7: finite atom-native sigma steps supply P413's atom-native
physical sigma corridor. -/
def toPrimitiveAtomNativePhysicalSigmaCorridor
    (C : PrimitiveAtomNativeSigmaRGStepPathProducer atoms) :
    PrimitiveAtomNativePhysicalSigmaCorridor Index A CKMCarrier where
  atoms := atoms
  fourPi_eq_realFourPi := C.fourPi_eq_realFourPi
  selected_yukawa_sigma_le_weak := by
    intro y
    exact C.sigma_monotone_of_reach (C.selected_yukawa_reaches_weak y)

end PrimitiveAtomNativeSigmaRGStepPathProducer

namespace PrimitiveAtomNativePhysicalSigmaCorridor

variable {Index A CKMCarrier : Type*} [AddCommGroup A]

/-- THEOREM 8: P413's atom-native corridor supplies a minimal finite
atom-native sigma-step certificate. -/
def toPrimitiveAtomNativeSigmaRGStepPathProducer
    (P : PrimitiveAtomNativePhysicalSigmaCorridor Index A CKMCarrier) :
    PrimitiveAtomNativeSigmaRGStepPathProducer P.atoms where
  step := minimalAtomNativeSigmaWeakStep
  reach_not_sigma_order :=
    minimalAtomNativeSigmaWeakStep_reach_not_sigma_order P.atoms
  fourPi_eq_realFourPi := P.fourPi_eq_realFourPi
  selected_yukawa_reaches_weak := by
    intro y
    exact RGStepReach.tail (RGStepReach.refl _)
      (by exact ⟨y, rfl, rfl⟩)
  step_sigma_monotone := by
    intro a b hab
    rcases hab with ⟨y, hsrc, hdst⟩
    subst hsrc
    subst hdst
    exact P.selected_yukawa_sigma_le_weak y

end PrimitiveAtomNativePhysicalSigmaCorridor

/-! ## Existence-level exact normal form -/

/-- A primitive atom object equipped with a finite native sigma-step producer. -/
def ExistsPrimitiveAtomNativeSigmaRGStepPathProducer
    (Index A CKMCarrier : Type*) [AddCommGroup A] : Prop :=
  ∃ atoms : GrandUnificationPrimitiveProducerAtoms Index A CKMCarrier,
    Nonempty (PrimitiveAtomNativeSigmaRGStepPathProducer atoms)

/-- THEOREM 9: finite native sigma-step producers supply the atom-native
P413 corridor. -/
theorem existsPrimitiveAtomNativeSigmaCorridor_of_sigmaRGStepPath
    {Index A CKMCarrier : Type*} [AddCommGroup A] :
    ExistsPrimitiveAtomNativeSigmaRGStepPathProducer Index A CKMCarrier ->
      Nonempty (PrimitiveAtomNativePhysicalSigmaCorridor
        Index A CKMCarrier) := by
  rintro ⟨atoms, ⟨C⟩⟩
  exact ⟨C.toPrimitiveAtomNativePhysicalSigmaCorridor⟩

/-- THEOREM 10: any atom-native P413 corridor supplies a finite native
sigma-step producer. -/
theorem existsSigmaRGStepPath_of_primitiveAtomNativeSigmaCorridor
    {Index A CKMCarrier : Type*} [AddCommGroup A] :
    Nonempty (PrimitiveAtomNativePhysicalSigmaCorridor
        Index A CKMCarrier) ->
      ExistsPrimitiveAtomNativeSigmaRGStepPathProducer
        Index A CKMCarrier := by
  rintro ⟨P⟩
  exact ⟨P.atoms, ⟨P.toPrimitiveAtomNativeSigmaRGStepPathProducer⟩⟩

/-- THEOREM 11: exact normal form.  The atom-native P413 front door exists iff
it can be supplied as a finite native sigma-step certificate. -/
theorem primitiveAtomNativeSigmaCorridor_nonempty_iff_sigmaRGStepPath
    {Index A CKMCarrier : Type*} [AddCommGroup A] :
    Nonempty (PrimitiveAtomNativePhysicalSigmaCorridor
        Index A CKMCarrier) ↔
      ExistsPrimitiveAtomNativeSigmaRGStepPathProducer
        Index A CKMCarrier := by
  constructor
  · exact existsSigmaRGStepPath_of_primitiveAtomNativeSigmaCorridor
  · exact existsPrimitiveAtomNativeSigmaCorridor_of_sigmaRGStepPath

/-- THEOREM 12: receipt-level exact normal form in atom-native finite
sigma-step coordinates. -/
theorem singleSourcePhysicalHolyGrailReceipt_nonempty_iff_sigmaRGStepPath
    {Index A CKMCarrier : Type*} [AddCommGroup A] :
    Nonempty
        (SingleSourcePhysicalGrandUnificationHolyGrailReceipt
          Index A CKMCarrier) ↔
      ExistsPrimitiveAtomNativeSigmaRGStepPathProducer
        Index A CKMCarrier := by
  exact
    singleSourcePhysicalHolyGrailReceipt_nonempty_iff_atomNativeSigmaCorridor.trans
      primitiveAtomNativeSigmaCorridor_nonempty_iff_sigmaRGStepPath

/-- THEOREM 13: compact holy-grail receipt from finite atom-native sigma
RG-step paths. -/
theorem sigmaRGStepPath_singleSource_holy_grail_receipt
    {Index A CKMCarrier : Type*} [AddCommGroup A] :
    ExistsPrimitiveAtomNativeSigmaRGStepPathProducer Index A CKMCarrier ->
      ∃ C : SingleSourcePhysicalGrandUnificationHolyGrailReceipt
          Index A CKMCarrier,
        C.receipt.zeroFree = C.atoms.toZeroFree ∧
        HEq C.receipt.rg
          C.physicalRG.toSelectedYukawaRGMonotonicityCertificate ∧
        C.receipt.spine = C.atoms.toUnifiedFormulaSpine ∧
        C.receipt.primitiveAtoms = C.atoms ∧
        C.receipt.spine.target.sampled.zeroFree = C.atoms.toZeroFree ∧
        alphaEMFromIntegerConstraint ℝ = (1 : ℝ) / (137 : ℝ) ∧
        gutWeakMixingFromStructuralCards ℝ = threeEighths ℝ ∧
        alphaGUTInverseFromStructuralCards ℝ = ((133 : ℝ) / (3 : ℝ)) ∧
        C.receipt.spine.target.strongResidualProducer.correctedOutput =
          alphaStrongDisplayed ℝ ∧
        (ckmCPDepthSum : ℝ) * C.receipt.spine.target.cpRunningSigma =
          cpRawPhaseClaim ℝ := by
  intro h
  exact
    atomNativeSigmaCorridor_singleSource_holy_grail_receipt
      ((primitiveAtomNativeSigmaCorridor_nonempty_iff_sigmaRGStepPath).mpr h)

end StandardModelConstraint
end SaturationMonoid
