import H0mework.Physics.SourceForms.P405

/-!
# Proposition 406: canonical physical holy-grail receipt

P405 packages the current Standard-Model grand-unification target as a physical
holy-grail receipt.  This file tightens the receipt by making the coherence
with the physical producer part of the type:

* the embedded P384 receipt uses the same zero-free certificate;
* the embedded P384 RG certificate is the forgetful image of the same physical
  alpha-RG monotonicity producer.

This removes a bookkeeping ambiguity from the central normal form.  A receipt
is no longer merely compatible with the physical producer by construction; the
compatibility is an explicit Lean field and therefore a reusable theorem.

Boundary: this is still producer-relative.  It does not construct the physical
RG/threshold beta-function proof or the zero-free Standard-Model seed.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

/-! ## Canonical physical receipt -/

/-- The coherent/canonical version of the P405 holy-grail receipt.

The `HEq` field is used because the two RG certificates are indexed by
potentially different zero-free certificates until `receipt_zeroFree_eq` is
read.  The canonical constructor below makes both equal by reflexivity. -/
structure CanonicalPhysicalGrandUnificationHolyGrailReceipt
    (Index A CKMCarrier : Type*) [AddCommGroup A] where
  zeroFree : ZeroContinuousFreeStandardModelCertificate Index A ℝ CKMCarrier
  physicalRG : PhysicalAlphaRGMonotonicityProducer zeroFree
  receipt : RGMonotonicityGrandUnificationReceipt Index A CKMCarrier
  receipt_zeroFree_eq : receipt.zeroFree = zeroFree
  receipt_rg_heq_physicalRG :
    HEq receipt.rg physicalRG.toSelectedYukawaRGMonotonicityCertificate

namespace CanonicalPhysicalGrandUnificationHolyGrailReceipt

variable {Index A CKMCarrier : Type*} [AddCommGroup A]

/-- THEOREM 1: canonical receipts forget to P405 receipts. -/
def toPhysicalGrandUnificationHolyGrailReceipt
    (C : CanonicalPhysicalGrandUnificationHolyGrailReceipt
      Index A CKMCarrier) :
    PhysicalGrandUnificationHolyGrailReceipt Index A CKMCarrier where
  zeroFree := C.zeroFree
  physicalRG := C.physicalRG
  receipt := C.receipt

/-- THEOREM 2: the P384 receipt's zero-free object is exactly the physical
producer's zero-free object. -/
theorem receipt_zeroFree_is_physical
    (C : CanonicalPhysicalGrandUnificationHolyGrailReceipt
      Index A CKMCarrier) :
    C.receipt.zeroFree = C.zeroFree :=
  C.receipt_zeroFree_eq

/-- THEOREM 3: the P384 RG certificate is heterogeneously equal to the
forgetful P383 certificate generated by the physical alpha-RG producer. -/
theorem receipt_rg_is_physical_forgetful_image
    (C : CanonicalPhysicalGrandUnificationHolyGrailReceipt
      Index A CKMCarrier) :
    HEq C.receipt.rg C.physicalRG.toSelectedYukawaRGMonotonicityCertificate :=
  C.receipt_rg_heq_physicalRG

/-- THEOREM 4: canonical receipts carry the same holy-grail receipt as P405,
now with coherence exposed. -/
theorem holy_grail_receipt
    (C : CanonicalPhysicalGrandUnificationHolyGrailReceipt
      Index A CKMCarrier) :
    NoContinuousFreeParameters
        C.receipt.spine.target.sampled.zeroFree.running.pinned.base.constraints ∧
      (∀ p : ParameterVector ℝ,
        C.receipt.spine.target.sampled.zeroFree.running.pinned.base.constraints p ->
          p StandardModelParameter.qcd_theta = 0) ∧
      alphaEMFromIntegerConstraint ℝ = (1 : ℝ) / (137 : ℝ) ∧
      gutWeakMixingFromStructuralCards ℝ = threeEighths ℝ ∧
      alphaGUTInverseFromStructuralCards ℝ = ((133 : ℝ) / (3 : ℝ)) ∧
      C.receipt.spine.target.strongResidualProducer.correctedOutput =
        alphaStrongDisplayed ℝ ∧
      (ckmCPDepthSum : ℝ) * C.receipt.spine.target.cpRunningSigma =
        cpRawPhaseClaim ℝ ∧
      cpDeltaCPClaim ℝ =
        cpTauProxy ℝ -
          (ckmCPDepthSum : ℝ) * C.receipt.spine.target.cpRunningSigma ∧
      (∀ p : ParameterVector ℝ,
        C.receipt.spine.target.sampled.zeroFree.running.pinned.base.constraints p ->
          ∀ y : YukawaParameter,
            p (yukawaSlot y) =
              (C.receipt.spine.target.sampled.zeroFree.running.pinned.yukawaAmplitude y) *
                AffineRelaxation.realDecayResidual
                  (C.receipt.spine.target.sampled.yukawaLambda y)
                  ((C.receipt.spine.target.sampled.zeroFree.running.pinned.yukawaExponent
                        C.receipt.spine.target.sampled.zeroFree.selectedSeed y :
                        ℝ) *
                    C.receipt.spine.target.sampled.yukawaStep y)) :=
  C.toPhysicalGrandUnificationHolyGrailReceipt.holy_grail_receipt

end CanonicalPhysicalGrandUnificationHolyGrailReceipt

/-! ## Canonical construction and normal form -/

/-- THEOREM 5: a physical alpha-RG monotonicity producer constructs a coherent
canonical holy-grail receipt by reusing the same zero-free object and the same
forgetful RG certificate throughout. -/
theorem canonicalPhysicalHolyGrailReceipt_nonempty_of_physicalAlphaRGMonotonicity
    {Index A CKMCarrier : Type*} [AddCommGroup A] :
    ExistsZeroFreePhysicalAlphaRGMonotonicityProducer Index A CKMCarrier ->
      Nonempty
        (CanonicalPhysicalGrandUnificationHolyGrailReceipt
          Index A CKMCarrier) := by
  intro h
  rcases h with ⟨Z, ⟨P⟩⟩
  let RGC : SelectedYukawaRGMonotonicityCertificate Z :=
    P.toSelectedYukawaRGMonotonicityCertificate
  let hExists : ExistsZeroFreeRGMonotonicityCorridor Index A CKMCarrier :=
    ⟨Z, ⟨RGC⟩⟩
  rcases unifiedFormulaSpine_nonempty_of_rgMonotonicity hExists with ⟨spine⟩
  rcases primitiveProducerAtoms_nonempty_of_rgMonotonicity hExists with ⟨atoms⟩
  let receipt : RGMonotonicityGrandUnificationReceipt Index A CKMCarrier :=
    { zeroFree := Z
      rg := RGC
      gaugeWeakCorridor :=
        selectedYukawaGaugeCouplingsBoundedByWeak_of_rgMonotonicity Z RGC
      spine := spine
      primitiveAtoms := atoms }
  exact
    ⟨{ zeroFree := Z
       physicalRG := P
       receipt := receipt
       receipt_zeroFree_eq := rfl
       receipt_rg_heq_physicalRG := HEq.rfl }⟩

/-- THEOREM 6: exact canonical normal form.  The coherent holy-grail receipt
exists iff the explicit physical alpha-RG producer surface exists. -/
theorem canonicalPhysicalHolyGrailReceipt_nonempty_iff_physicalAlphaRGMonotonicity
    {Index A CKMCarrier : Type*} [AddCommGroup A] :
    Nonempty
        (CanonicalPhysicalGrandUnificationHolyGrailReceipt
          Index A CKMCarrier) ↔
      ExistsZeroFreePhysicalAlphaRGMonotonicityProducer
        Index A CKMCarrier := by
  constructor
  · rintro ⟨C⟩
    exact ⟨C.zeroFree, ⟨C.physicalRG⟩⟩
  · exact canonicalPhysicalHolyGrailReceipt_nonempty_of_physicalAlphaRGMonotonicity

/-- THEOREM 7: compact downstream citation for the coherent/canonical target.

Compared with P405, this carries the same central numerical/formula receipt
but also guarantees that the embedded P384 receipt is the one generated from
the supplied physical producer. -/
theorem physicalAlphaRGMonotonicity_canonical_holy_grail_receipt
    {Index A CKMCarrier : Type*} [AddCommGroup A] :
    ExistsZeroFreePhysicalAlphaRGMonotonicityProducer Index A CKMCarrier ->
      ∃ C : CanonicalPhysicalGrandUnificationHolyGrailReceipt
          Index A CKMCarrier,
        C.receipt.zeroFree = C.zeroFree ∧
        HEq C.receipt.rg
          C.physicalRG.toSelectedYukawaRGMonotonicityCertificate ∧
        NoContinuousFreeParameters
            C.receipt.spine.target.sampled.zeroFree.running.pinned.base.constraints ∧
        alphaEMFromIntegerConstraint ℝ = (1 : ℝ) / (137 : ℝ) ∧
        gutWeakMixingFromStructuralCards ℝ = threeEighths ℝ ∧
        alphaGUTInverseFromStructuralCards ℝ = ((133 : ℝ) / (3 : ℝ)) ∧
        C.receipt.spine.target.strongResidualProducer.correctedOutput =
          alphaStrongDisplayed ℝ ∧
        (ckmCPDepthSum : ℝ) * C.receipt.spine.target.cpRunningSigma =
          cpRawPhaseClaim ℝ := by
  intro h
  rcases
    canonicalPhysicalHolyGrailReceipt_nonempty_of_physicalAlphaRGMonotonicity h
      with ⟨C⟩
  rcases C.holy_grail_receipt with
    ⟨hfree, _htheta, hem, hweak, hgut, hstrong, hckm, _hdelta, _hyukawa⟩
  exact
    ⟨C, C.receipt_zeroFree_is_physical,
      C.receipt_rg_is_physical_forgetful_image,
      hfree, hem, hweak, hgut, hstrong, hckm⟩

end StandardModelConstraint
end SaturationMonoid
