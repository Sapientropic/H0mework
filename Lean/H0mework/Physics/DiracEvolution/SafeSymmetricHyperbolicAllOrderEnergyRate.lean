local instance allOrderEnergyMatterCoordinateIndexFintype :
    Fintype MatterCoordinateIndex :=
  Fintype.ofFinite MatterCoordinateIndex

private theorem matterCoordinateFiberCoefficientCLM_norm
    (coordinates : MatterCoordinateCarrier) :
    ‖matterCoordinateFiberCoefficientCLM coordinates‖ = ‖coordinates‖ := by
  rw [PiLp.norm_eq_sum (by norm_num)]
  rw [PiLp.norm_eq_sum (by norm_num)]
  congr 1
  rw [Fintype.sum_prod_type]
  simp [matterCoordinateFiberCoefficientCLM,
    matterCoordinateFiberCoefficientLinear]

private theorem fixedCoordinatePointwiseMassPairing_eq_fiberMassPairing
    (time : ℝ)
    (space : DiracMatterSpatialCoordinates)
    (first second : MatterCoordinateCarrier) :
    fixedCoordinatePointwiseMassPairing time space first second =
      matterFiberMassPairing
        (fixedP506L0CauchySafeMatterWeakMassMatrix time space)
        first second := by
  unfold fixedCoordinatePointwiseMassPairing fixedPointwiseEnergyFormValue
    diracMatterWeakMassDensity
  rw [fixedPointwiseConstantSpatialSynthesis,
    fixedPointwiseConstantSpatialSynthesis]
  rfl

private theorem fixedCoordinatePointwiseMassPairing_norm_le
    (timeStart timeEnd : ℝ)
    (a b : DiracMatterSpatialCoordinates)
    (C : ℝ)
    (bound : ∀ time ∈ Icc timeStart timeEnd,
      ∀ space ∈ Icc a b,
        ‖matterFiberMassPairing
          (fixedP506L0CauchySafeMatterWeakMassMatrix time space)‖ ≤ C)
    (time : ℝ)
    (timeMem : time ∈ Icc timeStart timeEnd)
    (space : DiracMatterSpatialCoordinates)
    (spaceMem : space ∈ Icc a b)
    (first second : MatterCoordinateCarrier) :
    ‖fixedCoordinatePointwiseMassPairing time space first second‖ ≤
      C * ‖first‖ * ‖second‖ := by
  rw [fixedCoordinatePointwiseMassPairing_eq_fiberMassPairing]
  calc
    ‖matterFiberMassPairing
        (fixedP506L0CauchySafeMatterWeakMassMatrix time space)
        first second‖ ≤
        ‖matterFiberMassPairing
          (fixedP506L0CauchySafeMatterWeakMassMatrix time space) first‖ *
          ‖second‖ :=
      (matterFiberMassPairing
        (fixedP506L0CauchySafeMatterWeakMassMatrix time space) first).le_opNorm _
    _ ≤
        (‖matterFiberMassPairing
          (fixedP506L0CauchySafeMatterWeakMassMatrix time space)‖ *
          ‖first‖) * ‖second‖ := by
      gcongr
      exact (matterFiberMassPairing
        (fixedP506L0CauchySafeMatterWeakMassMatrix time space)).le_opNorm _
    _ ≤ (C * ‖first‖) * ‖second‖ := by
      gcongr
      exact bound time timeMem space spaceMem
    _ = C * ‖first‖ * ‖second‖ := rfl

/-- One source constant controls the energy rate of every forced coordinate
field.  The estimate is independent of derivative order and of the origin of
the forcing. -/
theorem exists_fixedForcedCoordinateEnergyRateBoundOnBox
    (timeStart timeEnd : ℝ)
    (a b : DiracMatterSpatialCoordinates)
    (timeOrder : timeStart ≤ timeEnd)
    (boxOrder : a ≤ b) :
    ∃ K : ℝ, 0 ≤ K ∧
      ∀ time ∈ Icc timeStart timeEnd,
        ∀ space ∈ Icc a b,
          ∀ value forcing : MatterCoordinateCarrier,
            ‖fixedCoordinatePointwiseRate time space value +
                2 * fixedCoordinatePointwiseMassPairing time space
                  forcing value‖ ≤
              K * (fixedCoordinatePointwiseEnergy time space value +
                ‖forcing‖ ^ 2) := by
  let carrier : Set (ℝ × DiracMatterSpatialCoordinates) :=
    Icc timeStart timeEnd ×ˢ Icc a b
  have carrierCompact : IsCompact carrier :=
    isCompact_Icc.prod isCompact_Icc
  have carrierNonempty : carrier.Nonempty :=
    ⟨(timeStart, a), ⟨⟨le_rfl, timeOrder⟩, ⟨le_rfl, boxOrder⟩⟩⟩
  obtain ⟨κ, κPositive, coercivity⟩ :=
    exists_fixedModeUniformPointwiseEnergyCoercivity
      carrier carrierCompact carrierNonempty
  obtain ⟨ordinaryRate, ordinaryRateNonnegative, ordinaryRateBound⟩ :=
    exists_fixedModeUniformPointwiseEnergyRateBound
      carrier carrierCompact carrierNonempty
  obtain ⟨massBound, massBoundNonnegative, massEstimate⟩ :=
    exists_fixedMassPairingOperatorBoundOnBox
      timeStart timeEnd a b timeOrder boxOrder
  let energyCoefficient := ordinaryRate + massBound / κ
  let K := max energyCoefficient massBound
  have energyCoefficientNonnegative : 0 ≤ energyCoefficient := by
    dsimp [energyCoefficient]
    positivity
  refine ⟨K, energyCoefficientNonnegative.trans (le_max_left _ _), ?_⟩
  intro time timeMem space spaceMem value forcing
  have rateBound :
      ‖fixedCoordinatePointwiseRate time space value‖ ≤
        ordinaryRate * fixedCoordinatePointwiseEnergy time space value := by
    exact ordinaryRateBound (time, space) ⟨timeMem, spaceMem⟩
      (matterCoordinateFiberCoefficientCLM value)
  have massBound' :
      ‖fixedCoordinatePointwiseMassPairing time space forcing value‖ ≤
        massBound * ‖forcing‖ * ‖value‖ :=
    fixedCoordinatePointwiseMassPairing_norm_le
      timeStart timeEnd a b massBound massEstimate
      time timeMem space spaceMem forcing value
  have pointCoercivity :
      κ * ‖value‖ ^ 2 ≤
        fixedCoordinatePointwiseEnergy time space value := by
    have read := coercivity (time, space) ⟨timeMem, spaceMem⟩
      (matterCoordinateFiberCoefficientCLM value)
    rwa [matterCoordinateFiberCoefficientCLM_norm] at read
  have valueSqBound :
      ‖value‖ ^ 2 ≤
        fixedCoordinatePointwiseEnergy time space value / κ := by
    apply (le_div_iff₀ κPositive).2
    simpa only [mul_comm] using pointCoercivity
  have energyNonnegative :
      0 ≤ fixedCoordinatePointwiseEnergy time space value :=
    (mul_nonneg κPositive.le (sq_nonneg ‖value‖)).trans pointCoercivity
  have pairingYoung :
      2 * ‖fixedCoordinatePointwiseMassPairing time space forcing value‖ ≤
        massBound * (‖forcing‖ ^ 2 + ‖value‖ ^ 2) := by
    calc
      2 * ‖fixedCoordinatePointwiseMassPairing time space forcing value‖ ≤
          2 * (massBound * ‖forcing‖ * ‖value‖) :=
        mul_le_mul_of_nonneg_left massBound' (by norm_num)
      _ = massBound * (2 * ‖forcing‖ * ‖value‖) := by ring
      _ ≤ massBound * (‖forcing‖ ^ 2 + ‖value‖ ^ 2) :=
        mul_le_mul_of_nonneg_left
          (two_mul_le_add_sq ‖forcing‖ ‖value‖) massBoundNonnegative
  calc
    ‖fixedCoordinatePointwiseRate time space value +
        2 * fixedCoordinatePointwiseMassPairing time space forcing value‖ ≤
        ‖fixedCoordinatePointwiseRate time space value‖ +
          ‖2 * fixedCoordinatePointwiseMassPairing time space forcing value‖ :=
      norm_add_le _ _
    _ = ‖fixedCoordinatePointwiseRate time space value‖ +
        2 * ‖fixedCoordinatePointwiseMassPairing time space forcing value‖ := by
      rw [norm_mul]
      norm_num
    _ ≤ ordinaryRate * fixedCoordinatePointwiseEnergy time space value +
        massBound * (‖forcing‖ ^ 2 + ‖value‖ ^ 2) :=
      add_le_add rateBound pairingYoung
    _ ≤ ordinaryRate * fixedCoordinatePointwiseEnergy time space value +
        massBound * (‖forcing‖ ^ 2 +
          fixedCoordinatePointwiseEnergy time space value / κ) := by
      gcongr
    _ = energyCoefficient *
          fixedCoordinatePointwiseEnergy time space value +
        massBound * ‖forcing‖ ^ 2 := by
      dsimp [energyCoefficient]
      field_simp
      ring
    _ ≤ K * fixedCoordinatePointwiseEnergy time space value +
        K * ‖forcing‖ ^ 2 := by
      exact add_le_add
        (mul_le_mul_of_nonneg_right (le_max_left _ _) energyNonnegative)
        (mul_le_mul_of_nonneg_right (le_max_right _ _) (sq_nonneg _))
    _ = K * (fixedCoordinatePointwiseEnergy time space value +
        ‖forcing‖ ^ 2) := by ring

def fixedMatterAllOrderVolterraForcing
    (word : List (Fin 3))
    (field : BasePoint → MatterCoordinateCarrier)
    (point : BasePoint) : MatterCoordinateCarrier :=
  fixedEvolutionTemporalPrincipalInverseCoordinateCLM point
    (fixedSpatialWordDerivative word
        (matterCoordinateFirstOrderOperator
          fixedEvolutionPrincipalCoordinateCLM fixedMatterLowerCoefficient
          field) point -
      fixedMatterAllOrderCommutedForcing word field point)

def fixedMatterAllOrderTemporalDefect
    (word : List (Fin 3))
    (field : BasePoint → MatterCoordinateCarrier)
    (point : BasePoint) : MatterCoordinateCarrier :=
  fieldDirectionalDerivative
      (fixedSpatialWordDerivative word field) point 0 -
    StageNineDiracDualFormNativeCauchySafeMatterVolterra.cauchySafeMatterVolterraVelocity
      fixedP506L0CauchySafeMatterGalerkinInputActual
      (fun candidate => matterCoordinateEquiv.symm
        (fixedSpatialWordDerivative word field candidate)) point

theorem fixedMatterAllOrderVolterraForcing_of_actionZero
    (word : List (Fin 3))
    (field : BasePoint → MatterCoordinateCarrier)
    (actionZero : ∀ point,
      matterCoordinateFirstOrderOperator
        fixedEvolutionPrincipalCoordinateCLM fixedMatterLowerCoefficient
        field point = 0)
    (point : BasePoint) :
    fixedMatterAllOrderVolterraForcing word field point =
      -fixedEvolutionTemporalPrincipalInverseCoordinateCLM point
        (fixedMatterAllOrderCommutedForcing word field point) := by
  unfold fixedMatterAllOrderVolterraForcing
  have actionEq :
      matterCoordinateFirstOrderOperator
        fixedEvolutionPrincipalCoordinateCLM fixedMatterLowerCoefficient
        field = 0 := by
    funext candidate
    exact actionZero candidate
  rw [actionEq, fixedSpatialWordDerivative_zero]
  simpa only [zero_sub] using
    (map_neg
      (fixedEvolutionTemporalPrincipalInverseCoordinateCLM point)
      (fixedMatterAllOrderCommutedForcing word field point))

/-- The same source constant controls every commuted word.  Derivative order
only selects the generated value and forcing; it never selects a new energy
mechanism. -/
theorem exists_fixedMatterAllOrderEnergyRateBoundOnBox
    (timeStart timeEnd : ℝ)
    (a b : DiracMatterSpatialCoordinates)
    (timeOrder : timeStart ≤ timeEnd)
    (boxOrder : a ≤ b) :
    ∃ K : ℝ, 0 ≤ K ∧
      ∀ (word : List (Fin 3))
        (field : BasePoint → MatterCoordinateCarrier),
        ∀ time ∈ Icc timeStart timeEnd,
          ∀ space ∈ Icc a b,
            ‖fixedCoordinatePointwiseRate time space
                  (fixedSpatialWordDerivative word field
                    (diracMatterSpacetimeCoordinatePoint time space)) +
                2 * fixedCoordinatePointwiseMassPairing time space
                  (fixedMatterAllOrderVolterraForcing word field
                    (diracMatterSpacetimeCoordinatePoint time space))
                  (fixedSpatialWordDerivative word field
                    (diracMatterSpacetimeCoordinatePoint time space))‖ ≤
              K * (fixedCoordinatePointwiseEnergy time space
                  (fixedSpatialWordDerivative word field
                    (diracMatterSpacetimeCoordinatePoint time space)) +
                ‖fixedMatterAllOrderVolterraForcing word field
                  (diracMatterSpacetimeCoordinatePoint time space)‖ ^ 2) := by
  obtain ⟨K, KNonnegative, bound⟩ :=
    exists_fixedForcedCoordinateEnergyRateBoundOnBox
      timeStart timeEnd a b timeOrder boxOrder
  exact ⟨K, KNonnegative, fun word field time timeMem space spaceMem =>
    bound time timeMem space spaceMem _ _⟩

/-- For an exact mother-action solution, the same all-order estimate has only
the source-generated coefficient commutator as forcing. -/
theorem exists_fixedMatterAllOrderOnShellEnergyRateBoundOnBox
    (timeStart timeEnd : ℝ)
    (a b : DiracMatterSpatialCoordinates)
    (timeOrder : timeStart ≤ timeEnd)
    (boxOrder : a ≤ b) :
    ∃ K : ℝ, 0 ≤ K ∧
      ∀ (word : List (Fin 3))
        (field : BasePoint → MatterCoordinateCarrier),
        ContDiff ℝ (⊤ : ℕ∞) field →
        (∀ point,
          matterCoordinateFirstOrderOperator
            fixedEvolutionPrincipalCoordinateCLM fixedMatterLowerCoefficient
            field point = 0) →
        ∀ time ∈ Icc timeStart timeEnd,
          ∀ space ∈ Icc a b,
            fixedMatterAllOrderTemporalDefect word field
                (diracMatterSpacetimeCoordinatePoint time space) =
                -fixedEvolutionTemporalPrincipalInverseCoordinateCLM
                  (diracMatterSpacetimeCoordinatePoint time space)
                  (fixedMatterAllOrderCommutedForcing word field
                    (diracMatterSpacetimeCoordinatePoint time space)) ∧
              ‖fixedCoordinatePointwiseRate time space
                  (fixedSpatialWordDerivative word field
                    (diracMatterSpacetimeCoordinatePoint time space)) +
                2 * fixedCoordinatePointwiseMassPairing time space
                  (-fixedEvolutionTemporalPrincipalInverseCoordinateCLM
                    (diracMatterSpacetimeCoordinatePoint time space)
                    (fixedMatterAllOrderCommutedForcing word field
                      (diracMatterSpacetimeCoordinatePoint time space)))
                  (fixedSpatialWordDerivative word field
                    (diracMatterSpacetimeCoordinatePoint time space))‖ ≤
              K * (fixedCoordinatePointwiseEnergy time space
                  (fixedSpatialWordDerivative word field
                    (diracMatterSpacetimeCoordinatePoint time space)) +
                ‖fixedEvolutionTemporalPrincipalInverseCoordinateCLM
                  (diracMatterSpacetimeCoordinatePoint time space)
                  (fixedMatterAllOrderCommutedForcing word field
                    (diracMatterSpacetimeCoordinatePoint time space))‖ ^ 2) := by
  obtain ⟨K, KNonnegative, bound⟩ :=
    exists_fixedMatterAllOrderEnergyRateBoundOnBox
      timeStart timeEnd a b timeOrder boxOrder
  refine ⟨K, KNonnegative, ?_⟩
  intro word field fieldSmooth actionZero time timeMem space spaceMem
  refine ⟨?_, ?_⟩
  · exact fixedSpatialWordDerivative_temporalVolterraDefect_of_actionZero
      word field fieldSmooth actionZero
        (diracMatterSpacetimeCoordinatePoint time space)
  have forcingEq := fixedMatterAllOrderVolterraForcing_of_actionZero
    word field actionZero (diracMatterSpacetimeCoordinatePoint time space)
  simpa only [forcingEq, norm_neg] using
    bound word field time timeMem space spaceMem

end

