import Mathlib.Analysis.ODE.ExistUnique
import Mathlib.Analysis.ODE.Gronwall

/-!
# Local evolution of Stage-9 Dirac Galerkin coefficients

A fixed synthesis map, a time-dependent mother-action velocity, and a fixed
projection generate a time-dependent linear operator on the coefficient
carrier.  Picard--Lindelöf then produces a coefficient curve on an explicit
source-centered time interval.
-/

namespace SaturationMonoid.PhysicsCore.StageNineDiracMatterGalerkinEvolution

open Metric Set
open scoped NNReal

noncomputable section

set_option autoImplicit false

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [CompleteSpace E]

/-- The coefficient-space evolution generated by a time-dependent linear
Galerkin operator. -/
def galerkinLinearVelocity
    (operator : ℝ → E →L[ℝ] E)
    (time : ℝ)
    (coefficient : E) : E :=
  operator time coefficient

/-- A uniform speed bound on the unit coefficient ball about the initial
coefficient. -/
def galerkinLinearSpeedBound
    (bound : ℝ≥0)
    (initial : E) : ℝ≥0 :=
  bound * (‖initial‖₊ + 1)

/-- The explicit local time radius generated by the operator bound and the
initial coefficient. -/
def galerkinLinearLocalTimeRadius
    (bound : ℝ≥0)
    (initial : E) : ℝ :=
  1 / (galerkinLinearSpeedBound bound initial + 1 : ℝ≥0)

omit [NormedSpace ℝ E] [CompleteSpace E] in
theorem galerkinLinearLocalTimeRadius_pos
    (bound : ℝ≥0)
    (initial : E) :
    0 < galerkinLinearLocalTimeRadius bound initial := by
  unfold galerkinLinearLocalTimeRadius
  positivity

omit [NormedSpace ℝ E] [CompleteSpace E] in
private theorem galerkinLinearLocalTimeRadius_le_one
    (bound : ℝ≥0)
    (initial : E) :
    galerkinLinearLocalTimeRadius bound initial ≤ 1 := by
  unfold galerkinLinearLocalTimeRadius
  simp only [NNReal.coe_add, NNReal.coe_one]
  have denominatorPositive :
      0 < (galerkinLinearSpeedBound bound initial : ℝ) + 1 := by
    positivity
  rw [div_le_one denominatorPositive]
  exact le_add_of_nonneg_left (NNReal.coe_nonneg _)

omit [CompleteSpace E] in
private theorem galerkinLinearVelocity_isPicardLindelof
    (operator : ℝ → E →L[ℝ] E)
    (operatorContinuous : Continuous operator)
    (bound : ℝ≥0)
    (initial : E)
    (initialTime : ℝ)
    (operatorBound :
      ∀ time ∈
        Icc
          (initialTime - galerkinLinearLocalTimeRadius bound initial)
          (initialTime + galerkinLinearLocalTimeRadius bound initial),
        ‖operator time‖₊ ≤ bound) :
    let epsilon := galerkinLinearLocalTimeRadius bound initial
    IsPicardLindelof
      (galerkinLinearVelocity operator)
      (tmin := initialTime - epsilon)
      (tmax := initialTime + epsilon)
      ⟨initialTime, by
        constructor <;>
          linarith [galerkinLinearLocalTimeRadius_pos bound initial]⟩
      initial 1 0 (galerkinLinearSpeedBound bound initial) bound := by
  dsimp only
  let epsilon := galerkinLinearLocalTimeRadius bound initial
  let speedBound := galerkinLinearSpeedBound bound initial
  have epsilonPositive : 0 < epsilon :=
    galerkinLinearLocalTimeRadius_pos bound initial
  refine
    { lipschitzOnWith := ?_
      continuousOn := ?_
      norm_le := ?_
      mul_max_le := ?_ }
  · intro time timeMem
    exact ((operator time).lipschitz.weaken
      (operatorBound time timeMem)).lipschitzOnWith
  · intro coefficient _
    exact (operatorContinuous.clm_apply continuous_const).continuousOn
  · intro time timeMem coefficient coefficientMem
    have coefficientNorm : ‖coefficient‖ ≤ ‖initial‖ + 1 := by
      calc
        ‖coefficient‖ ≤ ‖initial‖ + ‖coefficient - initial‖ :=
          norm_le_norm_add_norm_sub' coefficient initial
        _ ≤ ‖initial‖ + 1 := by
          gcongr
          simpa [mem_closedBall, dist_eq_norm] using coefficientMem
    calc
      ‖galerkinLinearVelocity operator time coefficient‖ ≤
          ‖operator time‖ * ‖coefficient‖ :=
        (operator time).le_opNorm coefficient
      _ ≤ (bound : ℝ) * (‖initial‖ + 1) := by
        gcongr
        exact_mod_cast operatorBound time timeMem
      _ = speedBound := by
        simp [speedBound, galerkinLinearSpeedBound]
  · have maxEq :
        max
            ((initialTime + epsilon) - initialTime)
            (initialTime - (initialTime - epsilon)) =
          epsilon := by
      simp
    rw [maxEq]
    simp only [NNReal.coe_one, NNReal.coe_zero, sub_zero]
    change
      (galerkinLinearSpeedBound bound initial : ℝ) * epsilon ≤ 1
    unfold epsilon galerkinLinearLocalTimeRadius
    simp only [NNReal.coe_add, NNReal.coe_one]
    have denominatorPositive :
        0 < (speedBound : ℝ) + 1 := by positivity
    calc
      (galerkinLinearSpeedBound bound initial : ℝ) *
          (1 / ((galerkinLinearSpeedBound bound initial : ℝ) + 1)) =
        (galerkinLinearSpeedBound bound initial : ℝ) /
          ((galerkinLinearSpeedBound bound initial : ℝ) + 1) := by ring
      _ ≤ 1 := by
        rw [div_le_one denominatorPositive]
        linarith

/-- A continuous, uniformly bounded linear operator path generates a local
coefficient curve through the supplied initial coefficient. -/
theorem exists_galerkinLinearCoefficientCurve
    (operator : ℝ → E →L[ℝ] E)
    (operatorContinuous : Continuous operator)
    (bound : ℝ≥0)
    (operatorBound : ∀ time, ‖operator time‖₊ ≤ bound)
    (initial : E)
    (initialTime : ℝ) :
    ∃ coefficient : ℝ → E,
      coefficient initialTime = initial ∧
        ∀ time ∈
          Icc
            (initialTime - galerkinLinearLocalTimeRadius bound initial)
            (initialTime + galerkinLinearLocalTimeRadius bound initial),
          HasDerivWithinAt coefficient
            (galerkinLinearVelocity operator time (coefficient time))
            (Icc
              (initialTime - galerkinLinearLocalTimeRadius bound initial)
              (initialTime + galerkinLinearLocalTimeRadius bound initial))
            time := by
  let epsilon := galerkinLinearLocalTimeRadius bound initial
  let initialTimeInInterval : Icc (initialTime - epsilon) (initialTime + epsilon) :=
    ⟨initialTime, by
      constructor <;>
        linarith [galerkinLinearLocalTimeRadius_pos bound initial]⟩
  have picard :=
    galerkinLinearVelocity_isPicardLindelof
      operator operatorContinuous bound initial initialTime
        (fun time _ ↦ operatorBound time)
  simpa [epsilon, initialTimeInInterval] using
    picard.exists_eq_forall_mem_Icc_hasDerivWithinAt₀

/-- Every continuous finite-dimensional linear operator path generates a
local coefficient curve; compactness supplies the local operator bound. -/
theorem exists_galerkinLinearCoefficientCurve_of_continuous
    (operator : ℝ → E →L[ℝ] E)
    (operatorContinuous : Continuous operator)
    (initial : E)
    (initialTime : ℝ) :
    ∃ bound : ℝ≥0, ∃ coefficient : ℝ → E,
      coefficient initialTime = initial ∧
        (∀ time ∈
          Icc
            (initialTime - galerkinLinearLocalTimeRadius bound initial)
            (initialTime + galerkinLinearLocalTimeRadius bound initial),
          ‖operator time‖₊ ≤ bound) ∧
        ∀ time ∈
          Icc
            (initialTime - galerkinLinearLocalTimeRadius bound initial)
            (initialTime + galerkinLinearLocalTimeRadius bound initial),
          HasDerivWithinAt coefficient
            (galerkinLinearVelocity operator time (coefficient time))
            (Icc
              (initialTime - galerkinLinearLocalTimeRadius bound initial)
              (initialTime + galerkinLinearLocalTimeRadius bound initial))
            time := by
  have intervalNonempty :
      (Icc (initialTime - 1) (initialTime + 1) : Set ℝ).Nonempty :=
    ⟨initialTime, by constructor <;> linarith⟩
  obtain ⟨maxTime, maxTimeMem, maxNorm⟩ :=
    isCompact_Icc.exists_isMaxOn intervalNonempty
      operatorContinuous.nnnorm.continuousOn
  let bound : ℝ≥0 := ‖operator maxTime‖₊
  have operatorBound :
      ∀ time ∈
        Icc
          (initialTime - galerkinLinearLocalTimeRadius bound initial)
          (initialTime + galerkinLinearLocalTimeRadius bound initial),
        ‖operator time‖₊ ≤ bound := by
    intro time timeMem
    apply maxNorm
    have radiusLe : galerkinLinearLocalTimeRadius bound initial ≤ 1 :=
      galerkinLinearLocalTimeRadius_le_one bound initial
    constructor <;> linarith [timeMem.1, timeMem.2]
  let epsilon := galerkinLinearLocalTimeRadius bound initial
  let initialTimeInInterval : Icc (initialTime - epsilon) (initialTime + epsilon) :=
    ⟨initialTime, by
      constructor <;>
        linarith [galerkinLinearLocalTimeRadius_pos bound initial]⟩
  have picard :=
    galerkinLinearVelocity_isPicardLindelof operator operatorContinuous bound
      initial initialTime operatorBound
  obtain ⟨coefficient, initialValue, evolution⟩ := by
    simpa [epsilon, initialTimeInInterval] using
      picard.exists_eq_forall_mem_Icc_hasDerivWithinAt₀
  have evolution' :
      ∀ time ∈
        Icc
          (initialTime - galerkinLinearLocalTimeRadius bound initial)
          (initialTime + galerkinLinearLocalTimeRadius bound initial),
        HasDerivWithinAt coefficient
          (galerkinLinearVelocity operator time (coefficient time))
          (Icc
            (initialTime - galerkinLinearLocalTimeRadius bound initial)
            (initialTime + galerkinLinearLocalTimeRadius bound initial))
          time := by
    intro time timeMem
    exact evolution time (by
      linarith [timeMem.1]) timeMem.2
  exact ⟨bound, coefficient, initialValue, operatorBound, evolution'⟩

omit [CompleteSpace E] in
/-- A shared operator-norm bound gives a dimension-independent exponential
bound for every Galerkin coefficient curve satisfying the generated ODE. -/
theorem galerkinLinearCoefficientCurve_norm_le
    (operator : ℝ → E →L[ℝ] E)
    (coefficient : ℝ → E)
    (a b : ℝ)
    (bound : ℝ≥0)
    (evolution :
      ∀ time ∈ Icc a b,
        HasDerivWithinAt coefficient
          (galerkinLinearVelocity operator time (coefficient time))
          (Icc a b) time)
    (operatorBound : ∀ time ∈ Ico a b, ‖operator time‖₊ ≤ bound) :
    ∀ time ∈ Icc a b,
      ‖coefficient time‖ ≤
        ‖coefficient a‖ * Real.exp ((bound : ℝ) * (time - a)) := by
  have estimate :=
    dist_le_of_trajectories_ODE_of_mem
      (v := galerkinLinearVelocity operator)
      (s := fun _ ↦ Set.univ)
      (K := bound)
      (f := coefficient)
      (g := fun _ ↦ 0)
      (a := a)
      (b := b)
      (δ := ‖coefficient a‖)
      (fun time timeMem ↦
        ((operator time).lipschitz.weaken
          (operatorBound time timeMem)).lipschitzOnWith)
      (fun time timeMem ↦ (evolution time timeMem).continuousWithinAt)
      (fun time timeMem ↦
        (evolution time (Ico_subset_Icc_self timeMem)).mono_of_mem_nhdsWithin
          (Icc_mem_nhdsGE_of_mem timeMem))
      (fun _ _ ↦ trivial)
      continuous_const.continuousOn
      (fun time _ ↦ by
        simpa [galerkinLinearVelocity] using
          (hasDerivAt_const time (0 : E)).hasDerivWithinAt)
      (fun _ _ ↦ trivial)
      (by simp)
  intro time timeMem
  simpa [dist_eq_norm] using estimate time timeMem

/-- A continuous linear operator path generates a local curve together with
the actual operator bound used by Picard--Lindelöf and its forward
Grönwall estimate. -/
theorem exists_galerkinLinearCoefficientCurve_of_continuous_with_norm_bound
    (operator : ℝ → E →L[ℝ] E)
    (operatorContinuous : Continuous operator)
    (initial : E)
    (initialTime : ℝ) :
    ∃ bound : ℝ≥0, ∃ coefficient : ℝ → E,
      coefficient initialTime = initial ∧
        ((∀ time ∈
            Icc
              (initialTime - galerkinLinearLocalTimeRadius bound initial)
              (initialTime + galerkinLinearLocalTimeRadius bound initial),
            ‖operator time‖₊ ≤ bound) ∧
          ((∀ time ∈
              Icc
                (initialTime - galerkinLinearLocalTimeRadius bound initial)
                (initialTime + galerkinLinearLocalTimeRadius bound initial),
              HasDerivWithinAt coefficient
                (galerkinLinearVelocity operator time (coefficient time))
                (Icc
                  (initialTime - galerkinLinearLocalTimeRadius bound initial)
                  (initialTime + galerkinLinearLocalTimeRadius bound initial))
                time) ∧
            ∀ time ∈
              Icc initialTime
                (initialTime + galerkinLinearLocalTimeRadius bound initial),
              ‖coefficient time‖ ≤
                ‖initial‖ * Real.exp ((bound : ℝ) * (time - initialTime)))) := by
  obtain ⟨bound, coefficient, generated⟩ :=
    exists_galerkinLinearCoefficientCurve_of_continuous operator
      operatorContinuous initial initialTime
  have initialValue := generated.1
  have operatorBound := generated.2.1
  have evolution := generated.2.2
  have forwardEvolution :
      ∀ time ∈
        Icc initialTime
          (initialTime + galerkinLinearLocalTimeRadius bound initial),
        HasDerivWithinAt coefficient
          (galerkinLinearVelocity operator time (coefficient time))
          (Icc initialTime
            (initialTime + galerkinLinearLocalTimeRadius bound initial))
          time := by
    intro time timeMem
    apply (evolution time ?_).mono
    · intro candidate candidateMem
      exact ⟨by
        linarith [candidateMem.1,
          galerkinLinearLocalTimeRadius_pos bound initial], candidateMem.2⟩
    · exact ⟨by
        linarith [timeMem.1,
          galerkinLinearLocalTimeRadius_pos bound initial], timeMem.2⟩
  have coefficientBound :=
    galerkinLinearCoefficientCurve_norm_le operator coefficient initialTime
      (initialTime + galerkinLinearLocalTimeRadius bound initial) bound
      forwardEvolution
      (fun time timeMem ↦ operatorBound time ⟨by
        linarith [timeMem.1,
          galerkinLinearLocalTimeRadius_pos bound initial], timeMem.2.le⟩)
  exact ⟨bound, coefficient, initialValue, operatorBound, evolution,
    fun time timeMem ↦ by
      simpa [initialValue] using coefficientBound time timeMem⟩

/-- A source-independent time radius for a globally bounded linear velocity.
The state ball grows with the current value, but this radius does not. -/
def galerkinLinearUniformTimeRadius (bound : ℝ≥0) : ℝ :=
  1 / (2 * (bound : ℝ) + 1)

theorem galerkinLinearUniformTimeRadius_pos (bound : ℝ≥0) :
    0 < galerkinLinearUniformTimeRadius bound := by
  unfold galerkinLinearUniformTimeRadius
  positivity

omit [CompleteSpace E] in
private theorem galerkinLinearVelocity_isPicardLindelof_uniform
    (operator : ℝ → E →L[ℝ] E)
    (operatorContinuous : Continuous operator)
    (bound : ℝ≥0)
    (operatorBound : ∀ time, ‖operator time‖₊ ≤ bound)
    (initial : E)
    (initialTime : ℝ) :
    let radius := galerkinLinearUniformTimeRadius bound
    IsPicardLindelof
      (galerkinLinearVelocity operator)
      (tmin := initialTime)
      (tmax := initialTime + radius)
      ⟨initialTime, by
        constructor
        · exact le_rfl
        · linarith [galerkinLinearUniformTimeRadius_pos bound]⟩
      initial (‖initial‖₊ + 1) 0
      (bound * (2 * ‖initial‖₊ + 1)) bound := by
  dsimp only
  let radius := galerkinLinearUniformTimeRadius bound
  let stateRadius : ℝ≥0 := ‖initial‖₊ + 1
  let speedBound : ℝ≥0 := bound * (2 * ‖initial‖₊ + 1)
  have radiusPositive : 0 < radius :=
    galerkinLinearUniformTimeRadius_pos bound
  refine
    { lipschitzOnWith := ?_
      continuousOn := ?_
      norm_le := ?_
      mul_max_le := ?_ }
  · intro time _
    exact ((operator time).lipschitz.weaken
      (operatorBound time)).lipschitzOnWith
  · intro coefficient _
    exact (operatorContinuous.clm_apply continuous_const).continuousOn
  · intro time _ coefficient coefficientMem
    have coefficientNorm : ‖coefficient‖ ≤ 2 * ‖initial‖ + 1 := by
      calc
        ‖coefficient‖ ≤ ‖initial‖ + ‖coefficient - initial‖ :=
          norm_le_norm_add_norm_sub' coefficient initial
        _ ≤ ‖initial‖ + (‖initial‖ + 1) := by
          gcongr
          simpa [stateRadius, mem_closedBall, dist_eq_norm] using coefficientMem
        _ = 2 * ‖initial‖ + 1 := by ring
    calc
      ‖galerkinLinearVelocity operator time coefficient‖ ≤
          ‖operator time‖ * ‖coefficient‖ :=
        (operator time).le_opNorm coefficient
      _ ≤ (bound : ℝ) * (2 * ‖initial‖ + 1) := by
        gcongr
        exact_mod_cast operatorBound time
      _ = speedBound := by
        simp [speedBound]
  · have maxEq :
        max ((initialTime + radius) - initialTime)
            (initialTime - initialTime) = radius := by
      simp [radiusPositive.le]
    rw [maxEq]
    simp only [NNReal.coe_zero, sub_zero]
    change
      (bound : ℝ) * (2 * ‖initial‖ + 1) * radius ≤ ‖initial‖ + 1
    unfold radius galerkinLinearUniformTimeRadius
    have denominatorPositive : 0 < 2 * (bound : ℝ) + 1 := by positivity
    rw [show (bound : ℝ) * (2 * ‖initial‖ + 1) *
        (1 / (2 * (bound : ℝ) + 1)) =
      ((bound : ℝ) * (2 * ‖initial‖ + 1)) /
        (2 * (bound : ℝ) + 1) by ring]
    rw [div_le_iff₀ denominatorPositive]
    nlinarith [norm_nonneg initial, NNReal.coe_nonneg bound]

/-- A globally bounded continuous linear operator generates one exact step
of a uniform duration, independent of the supplied initial coefficient. -/
theorem exists_galerkinLinearCoefficientCurve_uniformStep
    (operator : ℝ → E →L[ℝ] E)
    (operatorContinuous : Continuous operator)
    (bound : ℝ≥0)
    (operatorBound : ∀ time, ‖operator time‖₊ ≤ bound)
    (initial : E)
    (initialTime : ℝ) :
    ∃ coefficient : ℝ → E,
      coefficient initialTime = initial ∧
        ∀ time ∈ Icc initialTime
          (initialTime + galerkinLinearUniformTimeRadius bound),
          HasDerivWithinAt coefficient
            (galerkinLinearVelocity operator time (coefficient time))
            (Icc initialTime
              (initialTime + galerkinLinearUniformTimeRadius bound)) time := by
  let radius := galerkinLinearUniformTimeRadius bound
  let initialTimeInInterval : Icc initialTime (initialTime + radius) :=
    ⟨initialTime, le_rfl, by
      linarith [galerkinLinearUniformTimeRadius_pos bound]⟩
  have picard := galerkinLinearVelocity_isPicardLindelof_uniform
    operator operatorContinuous bound operatorBound initial initialTime
  simpa [radius, initialTimeInInterval] using
    picard.exists_eq_forall_mem_Icc_hasDerivWithinAt₀

private def glueCoefficientCurve
    (cut : ℝ)
    (first second : ℝ → E) : ℝ → E :=
  fun time ↦ if time ≤ cut then first time else second time

omit [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E] in
private theorem glueCoefficientCurve_eq_left
    (cut : ℝ)
    (first second : ℝ → E)
    (time : ℝ)
    (timeLe : time ≤ cut) :
    glueCoefficientCurve cut first second time = first time := by
  simp [glueCoefficientCurve, timeLe]

omit [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E] in
private theorem glueCoefficientCurve_eq_right
    (cut : ℝ)
    (first second : ℝ → E)
    (join : first cut = second cut)
    (time : ℝ)
    (cutLe : cut ≤ time) :
    glueCoefficientCurve cut first second time = second time := by
  rcases cutLe.eq_or_lt with rfl | cutLt
  · simp [glueCoefficientCurve, join]
  · simp [glueCoefficientCurve, not_le.mpr cutLt]

omit [CompleteSpace E] in
private theorem glueCoefficientCurve_hasDerivWithinAt
    (operator : ℝ → E →L[ℝ] E)
    (a cut d : ℝ)
    (aLeCut : a ≤ cut)
    (cutLeD : cut ≤ d)
    (first second : ℝ → E)
    (join : first cut = second cut)
    (firstEvolution : ∀ time ∈ Icc a cut,
      HasDerivWithinAt first
        (galerkinLinearVelocity operator time (first time))
        (Icc a cut) time)
    (secondEvolution : ∀ time ∈ Icc cut d,
      HasDerivWithinAt second
        (galerkinLinearVelocity operator time (second time))
        (Icc cut d) time)
    (time : ℝ)
    (timeMem : time ∈ Icc a d) :
    HasDerivWithinAt (glueCoefficientCurve cut first second)
      (galerkinLinearVelocity operator time
        (glueCoefficientCurve cut first second time))
      (Icc a d) time := by
  rcases lt_trichotomy time cut with timeLt | timeEq | cutLt
  · have timeMemLeft : time ∈ Icc a cut :=
      ⟨timeMem.1, timeLt.le⟩
    have leftDerivative := firstEvolution time timeMemLeft
    have leftCongruent : HasDerivWithinAt
        (glueCoefficientCurve cut first second)
        (galerkinLinearVelocity operator time (first time))
        (Icc a cut) time := by
      apply leftDerivative.congr_of_mem
      · intro candidate candidateMem
        exact glueCoefficientCurve_eq_left cut first second candidate
          candidateMem.2
      · exact timeMemLeft
    have rightDerivative : HasDerivWithinAt
        (glueCoefficientCurve cut first second)
        (galerkinLinearVelocity operator time
          (glueCoefficientCurve cut first second time))
        (Icc cut d) time := by
      have outside : time ∉ closure (Icc cut d) := by
        rw [isClosed_Icc.closure_eq]
        simp only [mem_Icc, not_and_or]
        exact Or.inl (not_le.mpr timeLt)
      simpa using (HasFDerivWithinAt.of_notMem_closure
        (f := glueCoefficientCurve cut first second)
        (f' := ContinuousLinearMap.toSpanSingleton ℝ
          (galerkinLinearVelocity operator time
            (glueCoefficientCurve cut first second time)))
        outside).hasDerivWithinAt
    rw [← Icc_union_Icc_eq_Icc aLeCut cutLeD]
    have leftValue := glueCoefficientCurve_eq_left
      cut first second time timeLt.le
    have leftAligned : HasDerivWithinAt
        (glueCoefficientCurve cut first second)
        (galerkinLinearVelocity operator time
          (glueCoefficientCurve cut first second time))
        (Icc a cut) time := by
      rw [leftValue]
      exact leftCongruent
    exact leftAligned.union rightDerivative
  · subst time
    have leftDerivative := firstEvolution cut ⟨aLeCut, le_rfl⟩
    have rightDerivative := secondEvolution cut ⟨le_rfl, cutLeD⟩
    have leftCongruent : HasDerivWithinAt
        (glueCoefficientCurve cut first second)
        (galerkinLinearVelocity operator cut
          (glueCoefficientCurve cut first second cut))
        (Icc a cut) cut := by
      have valueEq := glueCoefficientCurve_eq_left
        cut first second cut le_rfl
      simpa only [valueEq] using
        leftDerivative.congr_of_mem
          (fun candidate candidateMem ↦
            glueCoefficientCurve_eq_left cut first second candidate
              candidateMem.2)
          ⟨aLeCut, le_rfl⟩
    have rightCongruent : HasDerivWithinAt
        (glueCoefficientCurve cut first second)
        (galerkinLinearVelocity operator cut
          (glueCoefficientCurve cut first second cut))
        (Icc cut d) cut := by
      have valueEq := glueCoefficientCurve_eq_right
        cut first second join cut le_rfl
      simpa only [valueEq] using
        rightDerivative.congr_of_mem
          (fun candidate candidateMem ↦
            glueCoefficientCurve_eq_right cut first second join candidate
              candidateMem.1)
          ⟨le_rfl, cutLeD⟩
    rw [← Icc_union_Icc_eq_Icc aLeCut cutLeD]
    exact leftCongruent.union rightCongruent
  · have timeMemRight : time ∈ Icc cut d :=
      ⟨cutLt.le, timeMem.2⟩
    have rightDerivative := secondEvolution time timeMemRight
    have rightCongruent : HasDerivWithinAt
        (glueCoefficientCurve cut first second)
        (galerkinLinearVelocity operator time (second time))
        (Icc cut d) time := by
      apply rightDerivative.congr_of_mem
      · intro candidate candidateMem
        exact glueCoefficientCurve_eq_right cut first second join candidate
          candidateMem.1
      · exact timeMemRight
    have leftDerivative : HasDerivWithinAt
        (glueCoefficientCurve cut first second)
        (galerkinLinearVelocity operator time
          (glueCoefficientCurve cut first second time))
        (Icc a cut) time := by
      have outside : time ∉ closure (Icc a cut) := by
        rw [isClosed_Icc.closure_eq]
        simp only [mem_Icc, not_and_or]
        exact Or.inr (not_le.mpr cutLt)
      simpa using (HasFDerivWithinAt.of_notMem_closure
        (f := glueCoefficientCurve cut first second)
        (f' := ContinuousLinearMap.toSpanSingleton ℝ
          (galerkinLinearVelocity operator time
            (glueCoefficientCurve cut first second time)))
        outside).hasDerivWithinAt
    rw [← Icc_union_Icc_eq_Icc aLeCut cutLeD]
    have rightValue := glueCoefficientCurve_eq_right
      cut first second join time cutLt.le
    have rightAligned : HasDerivWithinAt
        (glueCoefficientCurve cut first second)
        (galerkinLinearVelocity operator time
          (glueCoefficientCurve cut first second time))
        (Icc cut d) time := by
      rw [rightValue]
      exact rightCongruent
    exact leftDerivative.union rightAligned

/-- A globally bounded linear velocity can be continued through any positive
finite number of uniform steps.  The pieces are generated by the same
operator; no endpoint datum is supplied independently. -/
theorem exists_galerkinLinearCoefficientCurve_natSuccSteps
    (operator : ℝ → E →L[ℝ] E)
    (operatorContinuous : Continuous operator)
    (bound : ℝ≥0)
    (operatorBound : ∀ time, ‖operator time‖₊ ≤ bound)
    (initial : E)
    (initialTime : ℝ)
    (steps : ℕ) :
    ∃ coefficient : ℝ → E,
      coefficient initialTime = initial ∧
        ∀ time ∈ Icc initialTime
          (initialTime + ((steps + 1 : ℕ) : ℝ) *
            galerkinLinearUniformTimeRadius bound),
          HasDerivWithinAt coefficient
            (galerkinLinearVelocity operator time (coefficient time))
            (Icc initialTime
              (initialTime + ((steps + 1 : ℕ) : ℝ) *
                galerkinLinearUniformTimeRadius bound)) time := by
  induction steps with
  | zero =>
      simpa using exists_galerkinLinearCoefficientCurve_uniformStep
        operator operatorContinuous bound operatorBound initial initialTime
  | succ steps inductionHypothesis =>
      let radius := galerkinLinearUniformTimeRadius bound
      let cut := initialTime + ((steps + 1 : ℕ) : ℝ) * radius
      let endpoint := initialTime + ((Nat.succ steps + 1 : ℕ) : ℝ) * radius
      obtain ⟨first, firstInitial, firstEvolution⟩ := inductionHypothesis
      obtain ⟨second, secondInitial, secondEvolution⟩ :=
        exists_galerkinLinearCoefficientCurve_uniformStep
          operator operatorContinuous bound operatorBound (first cut) cut
      have initialTimeLeCut : initialTime ≤ cut := by
        dsimp [cut, radius]
        exact le_add_of_nonneg_right <|
          mul_nonneg (Nat.cast_nonneg _) <|
            (galerkinLinearUniformTimeRadius_pos bound).le
      have cutAddRadius : cut + radius = endpoint := by
        dsimp [cut, endpoint]
        push_cast
        ring
      have cutLeEndpoint : cut ≤ endpoint := by
        rw [← cutAddRadius]
        exact le_add_of_nonneg_right
          (galerkinLinearUniformTimeRadius_pos bound).le
      have secondEvolution' : ∀ time ∈ Icc cut endpoint,
          HasDerivWithinAt second
            (galerkinLinearVelocity operator time (second time))
            (Icc cut endpoint) time := by
        intro time timeMem
        rw [← cutAddRadius] at timeMem ⊢
        simpa [radius] using secondEvolution time (by
          simpa [radius] using timeMem)
      refine ⟨glueCoefficientCurve cut first second, ?_, ?_⟩
      · rw [glueCoefficientCurve_eq_left cut first second initialTime
          initialTimeLeCut]
        exact firstInitial
      · intro time timeMem
        have firstEvolution' : ∀ candidate ∈ Icc initialTime cut,
            HasDerivWithinAt first
              (galerkinLinearVelocity operator candidate (first candidate))
              (Icc initialTime cut) candidate := by
          simpa [cut, radius] using firstEvolution
        simpa [endpoint, radius, Nat.cast_add, Nat.cast_one] using
          glueCoefficientCurve_hasDerivWithinAt
            operator initialTime cut endpoint initialTimeLeCut cutLeEndpoint
              first second secondInitial.symm firstEvolution' secondEvolution'
              time (by
                simpa [endpoint, radius, Nat.cast_add, Nat.cast_one] using
                  timeMem)

/-- A global operator bound turns the uniform finite-step construction into
an exact solution on any supplied compact forward interval. -/
theorem exists_galerkinLinearCoefficientCurve_on_Icc_of_globalBound
    (operator : ℝ → E →L[ℝ] E)
    (operatorContinuous : Continuous operator)
    (bound : ℝ≥0)
    (operatorBound : ∀ time, ‖operator time‖₊ ≤ bound)
    (initial : E)
    (timeStart timeEnd : ℝ) :
    ∃ coefficient : ℝ → E,
      coefficient timeStart = initial ∧
        ∀ time ∈ Icc timeStart timeEnd,
          HasDerivWithinAt coefficient
            (galerkinLinearVelocity operator time (coefficient time))
            (Icc timeStart timeEnd) time := by
  let radius := galerkinLinearUniformTimeRadius bound
  have radiusPositive : 0 < radius :=
    galerkinLinearUniformTimeRadius_pos bound
  obtain ⟨steps, stepsBound⟩ :=
    exists_nat_ge ((timeEnd - timeStart) / radius)
  obtain ⟨coefficient, initialValue, evolution⟩ :=
    exists_galerkinLinearCoefficientCurve_natSuccSteps
      operator operatorContinuous bound operatorBound initial timeStart steps
  have endpointBound :
      timeEnd ≤ timeStart + ((steps + 1 : ℕ) : ℝ) * radius := by
    have intervalLengthBound :
        timeEnd - timeStart ≤ (steps : ℝ) * radius := by
      rw [div_le_iff₀ radiusPositive] at stepsBound
      exact stepsBound
    have radiusNonnegative : 0 ≤ radius := radiusPositive.le
    push_cast
    nlinarith
  refine ⟨coefficient, initialValue, ?_⟩
  intro time timeMem
  have timeMemLong : time ∈ Icc timeStart
      (timeStart + ((steps + 1 : ℕ) : ℝ) * radius) :=
    ⟨timeMem.1, timeMem.2.trans endpointBound⟩
  exact (evolution time (by
    simpa [radius] using timeMemLong)).mono <|
      Icc_subset_Icc le_rfl endpointBound

/-- Every continuous linear operator path generates an exact coefficient
curve on an arbitrary compact forward interval.  The construction clamps the
operator to that interval before applying the source-independent finite-step
continuation, so no external bound or endpoint state enters the mouth. -/
theorem exists_galerkinLinearCoefficientCurve_on_Icc
    (operator : ℝ → E →L[ℝ] E)
    (operatorContinuous : Continuous operator)
    (initial : E)
    (timeStart timeEnd : ℝ)
    (timeOrder : timeStart ≤ timeEnd) :
    ∃ coefficient : ℝ → E,
      coefficient timeStart = initial ∧
        ∀ time ∈ Icc timeStart timeEnd,
          HasDerivWithinAt coefficient
            (galerkinLinearVelocity operator time (coefficient time))
            (Icc timeStart timeEnd) time := by
  let clampedOperator : ℝ → E →L[ℝ] E :=
    fun time ↦ operator (projIcc timeStart timeEnd timeOrder time)
  have clampedContinuous : Continuous clampedOperator := by
    dsimp [clampedOperator]
    fun_prop
  have intervalNonempty : (Icc timeStart timeEnd : Set ℝ).Nonempty :=
    ⟨timeStart, left_mem_Icc.mpr timeOrder⟩
  obtain ⟨maxTime, maxTimeMem, maxNorm⟩ :=
    isCompact_Icc.exists_isMaxOn intervalNonempty
      operatorContinuous.nnnorm.continuousOn
  let bound : ℝ≥0 := ‖operator maxTime‖₊
  have clampedBound : ∀ time, ‖clampedOperator time‖₊ ≤ bound := by
    intro time
    apply maxNorm
    exact (projIcc timeStart timeEnd timeOrder time).2
  obtain ⟨coefficient, initialValue, evolution⟩ :=
    exists_galerkinLinearCoefficientCurve_on_Icc_of_globalBound
      clampedOperator clampedContinuous bound clampedBound initial
        timeStart timeEnd
  refine ⟨coefficient, initialValue, ?_⟩
  intro time timeMem
  simpa [clampedOperator, galerkinLinearVelocity,
    projIcc_of_mem timeOrder timeMem] using evolution time timeMem

omit [CompleteSpace E] in
/-- Selector independence on the full source interval: two curves solving the
same continuous linear Galerkin evolution from the same initial coefficient
coincide everywhere on that interval. -/
theorem galerkinLinearCoefficientCurve_eqOn_Icc
    (operator : ℝ → E →L[ℝ] E)
    (operatorContinuous : Continuous operator)
    (first second : ℝ → E)
    (initial : E)
    (timeStart timeEnd : ℝ)
    (timeOrder : timeStart ≤ timeEnd)
    (firstInitial : first timeStart = initial)
    (secondInitial : second timeStart = initial)
    (firstEvolution : ∀ time ∈ Icc timeStart timeEnd,
      HasDerivWithinAt first
        (galerkinLinearVelocity operator time (first time))
        (Icc timeStart timeEnd) time)
    (secondEvolution : ∀ time ∈ Icc timeStart timeEnd,
      HasDerivWithinAt second
        (galerkinLinearVelocity operator time (second time))
        (Icc timeStart timeEnd) time) :
    EqOn first second (Icc timeStart timeEnd) := by
  have intervalNonempty : (Icc timeStart timeEnd : Set ℝ).Nonempty :=
    ⟨timeStart, left_mem_Icc.mpr timeOrder⟩
  obtain ⟨maxTime, maxTimeMem, maxNorm⟩ :=
    isCompact_Icc.exists_isMaxOn intervalNonempty
      operatorContinuous.nnnorm.continuousOn
  let bound : ℝ≥0 := ‖operator maxTime‖₊
  apply ODE_solution_unique_of_mem_Icc_right
    (v := galerkinLinearVelocity operator)
    (s := fun _ ↦ univ)
    (K := bound)
  · intro time timeMem
    exact ((operator time).lipschitz.weaken <| maxNorm <|
      Ico_subset_Icc_self timeMem).lipschitzOnWith
  · intro time timeMem
    exact (firstEvolution time timeMem).continuousWithinAt
  · intro time timeMem
    exact (firstEvolution time (Ico_subset_Icc_self timeMem)
      ).mono_of_mem_nhdsWithin (Icc_mem_nhdsGE_of_mem timeMem)
  · intro _ _
    trivial
  · intro time timeMem
    exact (secondEvolution time timeMem).continuousWithinAt
  · intro time timeMem
    exact (secondEvolution time (Ico_subset_Icc_self timeMem)
      ).mono_of_mem_nhdsWithin (Icc_mem_nhdsGE_of_mem timeMem)
  · intro _ _
    trivial
  · rw [firstInitial, secondInitial]

section ProjectedAction

variable {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]

/-- Synthesize a section, apply the mother-action velocity, and project the
result back to the coefficient carrier. -/
def galerkinProjectedActionOperator
    (synthesis : E →L[ℝ] F)
    (actionVelocity : ℝ → F →L[ℝ] F)
    (projection : F →L[ℝ] E)
    (time : ℝ) : E →L[ℝ] E :=
  projection.comp ((actionVelocity time).comp synthesis)

/-- The operator-norm bound generated by the three Galerkin legs. -/
def galerkinProjectedActionBound
    (synthesis : E →L[ℝ] F)
    (actionBound : ℝ≥0)
    (projection : F →L[ℝ] E) : ℝ≥0 :=
  ‖projection‖₊ * (actionBound * ‖synthesis‖₊)

omit [CompleteSpace E] in
theorem galerkinProjectedActionOperator_continuous
    (synthesis : E →L[ℝ] F)
    (actionVelocity : ℝ → F →L[ℝ] F)
    (projection : F →L[ℝ] E)
    (actionContinuous : Continuous actionVelocity) :
    Continuous
      (galerkinProjectedActionOperator synthesis actionVelocity projection) := by
  exact continuous_const.clm_comp
    (actionContinuous.clm_comp continuous_const)

omit [CompleteSpace E] in
theorem galerkinProjectedActionOperator_bound
    (synthesis : E →L[ℝ] F)
    (actionVelocity : ℝ → F →L[ℝ] F)
    (projection : F →L[ℝ] E)
    (actionBound : ℝ≥0)
    (actionVelocityBound :
      ∀ time, ‖actionVelocity time‖₊ ≤ actionBound)
    (time : ℝ) :
    ‖galerkinProjectedActionOperator
        synthesis actionVelocity projection time‖₊ ≤
      galerkinProjectedActionBound synthesis actionBound projection := by
  calc
    ‖galerkinProjectedActionOperator
        synthesis actionVelocity projection time‖₊ ≤
        ‖projection‖₊ * ‖(actionVelocity time).comp synthesis‖₊ :=
      ContinuousLinearMap.opNNNorm_comp_le projection
        ((actionVelocity time).comp synthesis)
    _ ≤ ‖projection‖₊ * (‖actionVelocity time‖₊ * ‖synthesis‖₊) := by
      gcongr
      exact ContinuousLinearMap.opNNNorm_comp_le (actionVelocity time) synthesis
    _ ≤ ‖projection‖₊ * (actionBound * ‖synthesis‖₊) := by
      gcongr
      exact actionVelocityBound time
    _ = galerkinProjectedActionBound synthesis actionBound projection := rfl

/-- The projected mother-action operator generates a local Galerkin
coefficient trajectory. -/
theorem exists_galerkinProjectedActionCoefficientCurve
    (synthesis : E →L[ℝ] F)
    (actionVelocity : ℝ → F →L[ℝ] F)
    (projection : F →L[ℝ] E)
    (actionContinuous : Continuous actionVelocity)
    (actionBound : ℝ≥0)
    (actionVelocityBound :
      ∀ time, ‖actionVelocity time‖₊ ≤ actionBound)
    (initial : E)
    (initialTime : ℝ) :
    ∃ coefficient : ℝ → E,
      coefficient initialTime = initial ∧
        ∀ time ∈
          Icc
            (initialTime -
              galerkinLinearLocalTimeRadius
                (galerkinProjectedActionBound
                  synthesis actionBound projection)
                initial)
            (initialTime +
              galerkinLinearLocalTimeRadius
                (galerkinProjectedActionBound
                  synthesis actionBound projection)
                initial),
          HasDerivWithinAt coefficient
            (galerkinProjectedActionOperator
              synthesis actionVelocity projection time (coefficient time))
            (Icc
              (initialTime -
                galerkinLinearLocalTimeRadius
                  (galerkinProjectedActionBound
                    synthesis actionBound projection)
                  initial)
              (initialTime +
                galerkinLinearLocalTimeRadius
                  (galerkinProjectedActionBound
                    synthesis actionBound projection)
                  initial))
            time := by
  exact exists_galerkinLinearCoefficientCurve
    (galerkinProjectedActionOperator synthesis actionVelocity projection)
    (galerkinProjectedActionOperator_continuous
      synthesis actionVelocity projection actionContinuous)
    (galerkinProjectedActionBound synthesis actionBound projection)
    (galerkinProjectedActionOperator_bound
      synthesis actionVelocity projection actionBound actionVelocityBound)
    initial initialTime

/-- A continuous projected mother-action operator generates a local
coefficient curve without an externally supplied norm bound. -/
theorem exists_galerkinProjectedActionCoefficientCurve_of_continuous
    (synthesis : E →L[ℝ] F)
    (actionVelocity : ℝ → F →L[ℝ] F)
    (projection : F →L[ℝ] E)
    (actionContinuous : Continuous actionVelocity)
    (initial : E)
    (initialTime : ℝ) :
    ∃ bound : ℝ≥0, ∃ coefficient : ℝ → E,
      coefficient initialTime = initial ∧
        ∀ time ∈
          Icc
            (initialTime - galerkinLinearLocalTimeRadius bound initial)
            (initialTime + galerkinLinearLocalTimeRadius bound initial),
          HasDerivWithinAt coefficient
            (galerkinProjectedActionOperator
              synthesis actionVelocity projection time (coefficient time))
            (Icc
              (initialTime - galerkinLinearLocalTimeRadius bound initial)
              (initialTime + galerkinLinearLocalTimeRadius bound initial))
            time := by
  obtain ⟨bound, coefficient, initialValue, _, evolution⟩ :=
    exists_galerkinLinearCoefficientCurve_of_continuous
      (galerkinProjectedActionOperator synthesis actionVelocity projection)
      (galerkinProjectedActionOperator_continuous
        synthesis actionVelocity projection actionContinuous)
      initial initialTime
  exact ⟨bound, coefficient, initialValue, evolution⟩

/-- A continuous projected mother-action operator generates its coefficient
curve on any compact forward interval.  Compactness and finite-step
continuation are internal to the producer. -/
theorem exists_galerkinProjectedActionCoefficientCurve_on_Icc
    (synthesis : E →L[ℝ] F)
    (actionVelocity : ℝ → F →L[ℝ] F)
    (projection : F →L[ℝ] E)
    (actionContinuous : Continuous actionVelocity)
    (initial : E)
    (timeStart timeEnd : ℝ)
    (timeOrder : timeStart ≤ timeEnd) :
    ∃ coefficient : ℝ → E,
      coefficient timeStart = initial ∧
        ∀ time ∈ Icc timeStart timeEnd,
          HasDerivWithinAt coefficient
            (galerkinProjectedActionOperator
              synthesis actionVelocity projection time (coefficient time))
            (Icc timeStart timeEnd) time := by
  simpa [galerkinLinearVelocity] using
    exists_galerkinLinearCoefficientCurve_on_Icc
      (galerkinProjectedActionOperator synthesis actionVelocity projection)
      (galerkinProjectedActionOperator_continuous
        synthesis actionVelocity projection actionContinuous)
      initial timeStart timeEnd timeOrder

end ProjectedAction

end

