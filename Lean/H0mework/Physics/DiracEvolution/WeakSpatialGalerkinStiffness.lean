import H0mework.Physics.DiracEvolution.WeakSpatialGalerkinMass

/-!
# Stage-nine weak spatial Galerkin stiffness

This module pairs compactly supported finite test fields against the temporal
velocity generated by the same Dirac mother action.  Multiplication by the
already generated positive time principal gives the stiffness leg in
`M_N(t) c_N'(t) + L_N(t) c_N(t) = 0`; no residual, inverse, or target field is
accepted by the constructor.
-/

namespace SaturationMonoid.PhysicsCore.StageNineDiracMatterWeakSpatialGalerkinStiffness

open Filter
open MeasureTheory
open DiracCliffordRepresentation
open DiracExteriorMatterAction
open StageNineDiracDualFormNativeCauchySafeMatterGalerkinOperator
open StageNineDiracMatterHermitianEnergy
open StageNineDiracMatterSpatialEnergyBalance
open StageNineDiracMatterWeakGalerkinEvolution
open StageNineDiracMatterWeakSpatialGalerkinMass
open StageNineHolonomicField
open StageNineMatterActionTemporalFirstGermResponse
open StageNineMatterVariation

noncomputable section

set_option autoImplicit false

variable {modeCount : ℕ}

/-- The weak spatial stiffness density generated by a matter velocity.  The
minus sign is the one in `M c' + L c = 0` when `c'` is the action velocity. -/
def diracMatterWeakStiffnessDensity
    (matrix : DiracMatterSpatialCoordinates → DiracMatrix)
    (basis : Fin modeCount → DiracMatterSpatialCoordinates → ℝ)
    (response : DiracMatterGalerkinCoefficient modeCount →
      DiracMatterSpatialCoordinates → MatterCoordinateCarrier)
    (first second : DiracMatterGalerkinCoefficient modeCount)
    (space : DiracMatterSpatialCoordinates) : ℝ :=
  -diracExteriorMatterEnergyPairing (matrix space)
    (diracMatterSpatialGalerkinSynthesis basis first space)
    (matterCoordinateEquiv.symm (response second space))

theorem diracMatterWeakStiffnessDensity_joint_continuous
    (matrix : ℝ → DiracMatterSpatialCoordinates → DiracMatrix)
    (basis : Fin modeCount → DiracMatterSpatialCoordinates → ℝ)
    (response : ℝ → DiracMatterGalerkinCoefficient modeCount →
      DiracMatterSpatialCoordinates → MatterCoordinateCarrier)
    (matrixContinuous : ∀ row column, Continuous fun input :
      ℝ × DiracMatterSpatialCoordinates ↦
        matrix input.1 input.2 row column)
    (basisContinuous : ∀ mode, Continuous (basis mode))
    (responseContinuous : ∀ coefficient,
      Continuous fun input : ℝ × DiracMatterSpatialCoordinates ↦
        response input.1 coefficient input.2)
    (first second : DiracMatterGalerkinCoefficient modeCount) :
    Continuous fun input : ℝ × DiracMatterSpatialCoordinates ↦
      diracMatterWeakStiffnessDensity (matrix input.1) basis
        (response input.1) first second input.2 := by
  unfold diracMatterWeakStiffnessDensity diracExteriorMatterEnergyPairing
  apply Continuous.neg
  rw [show (fun input : ℝ × DiracMatterSpatialCoordinates ↦
      (diracExteriorMatterCoordinatePairing
        (diracMatterSpatialGalerkinSynthesis basis first input.2)
        ((diracMatrixMatterAction (matrix input.1 input.2))
          (matterCoordinateEquiv.symm
            (response input.1 second input.2)))).re) =
      (fun input ↦ Complex.re
        (∑ internal : InternalMatterCoordinateIndex,
          (star (fun spin ↦ internalMatterCoordinate internal
              (diracMatterSpatialGalerkinSynthesis basis first input.2 spin))) ⬝ᵥ
            (fun spin ↦ ∑ column : DiracSpinorIndex,
              matrix input.1 input.2 spin column *
                matterCoordinateInternalSpinCLM internal column
                  (response input.1 second input.2)))) by
    funext input
    unfold diracExteriorMatterCoordinatePairing
    apply congrArg Complex.re
    apply Finset.sum_congr rfl
    intro internal _
    congr 1
    funext spin
    rw [internalMatterCoordinate_diracMatrixMatterAction]
    apply Finset.sum_congr rfl
    intro column _
    rw [matterCoordinateInternalSpinCLM_apply]]
  apply Complex.continuous_re.comp
  apply continuous_finsetSum Finset.univ
  intro internal _
  unfold dotProduct
  apply continuous_finsetSum Finset.univ
  intro spin _
  apply Continuous.mul
  · exact Continuous.star
      ((diracMatterSpatialGalerkinSynthesis_internalCoordinate_continuous
        basis basisContinuous first internal spin).comp continuous_snd)
  · apply continuous_finsetSum Finset.univ
    intro column _
    exact (matrixContinuous spin column).mul
      ((matterCoordinateInternalSpinCLM internal column).continuous.comp
        (responseContinuous second))

theorem diracMatterWeakStiffnessDensity_continuous
    (matrix : DiracMatterSpatialCoordinates → DiracMatrix)
    (basis : Fin modeCount → DiracMatterSpatialCoordinates → ℝ)
    (response : DiracMatterGalerkinCoefficient modeCount →
      DiracMatterSpatialCoordinates → MatterCoordinateCarrier)
    (matrixContinuous : ∀ row column,
      Continuous fun space ↦ matrix space row column)
    (basisContinuous : ∀ mode, Continuous (basis mode))
    (responseContinuous : ∀ coefficient,
      Continuous (response coefficient))
    (first second : DiracMatterGalerkinCoefficient modeCount) :
    Continuous
      (diracMatterWeakStiffnessDensity matrix basis response first second) := by
  unfold diracMatterWeakStiffnessDensity diracExteriorMatterEnergyPairing
  apply Continuous.neg
  rw [show (fun space ↦
      (diracExteriorMatterCoordinatePairing
        (diracMatterSpatialGalerkinSynthesis basis first space)
        ((diracMatrixMatterAction (matrix space))
          (matterCoordinateEquiv.symm (response second space)))).re) =
      (fun space ↦ Complex.re
        (∑ internal : InternalMatterCoordinateIndex,
          (star (fun spin ↦ internalMatterCoordinate internal
              (diracMatterSpatialGalerkinSynthesis basis first space spin))) ⬝ᵥ
            (fun spin ↦ ∑ column : DiracSpinorIndex,
              matrix space spin column *
                matterCoordinateInternalSpinCLM internal column
                  (response second space)))) by
    funext space
    unfold diracExteriorMatterCoordinatePairing
    apply congrArg Complex.re
    apply Finset.sum_congr rfl
    intro internal _
    congr 1
    funext spin
    rw [internalMatterCoordinate_diracMatrixMatterAction]
    apply Finset.sum_congr rfl
    intro column _
    rw [matterCoordinateInternalSpinCLM_apply]]
  apply Complex.continuous_re.comp
  apply continuous_finsetSum Finset.univ
  intro internal _
  unfold dotProduct
  apply continuous_finsetSum Finset.univ
  intro spin _
  apply Continuous.mul
  · exact Continuous.star
      (diracMatterSpatialGalerkinSynthesis_internalCoordinate_continuous
        basis basisContinuous first internal spin)
  · apply continuous_finsetSum Finset.univ
    intro column _
    exact (matrixContinuous spin column).mul
      ((matterCoordinateInternalSpinCLM internal column).continuous.comp
        (responseContinuous second))

theorem diracMatterWeakStiffnessDensity_add_right
    (matrix : DiracMatterSpatialCoordinates → DiracMatrix)
    (basis : Fin modeCount → DiracMatterSpatialCoordinates → ℝ)
    (response : DiracMatterGalerkinCoefficient modeCount →
      DiracMatterSpatialCoordinates → MatterCoordinateCarrier)
    (responseAdd : ∀ first second,
      response (first + second) = response first + response second)
    (first second third : DiracMatterGalerkinCoefficient modeCount) :
    diracMatterWeakStiffnessDensity matrix basis response first
        (second + third) =
      diracMatterWeakStiffnessDensity matrix basis response first second +
        diracMatterWeakStiffnessDensity matrix basis response first third := by
  funext space
  unfold diracMatterWeakStiffnessDensity
  rw [responseAdd, Pi.add_apply, map_add,
    diracExteriorMatterEnergyPairing_add_right, neg_add]
  simp only [Pi.add_apply]

theorem diracMatterWeakStiffnessDensity_real_smul_right
    (matrix : DiracMatterSpatialCoordinates → DiracMatrix)
    (basis : Fin modeCount → DiracMatterSpatialCoordinates → ℝ)
    (response : DiracMatterGalerkinCoefficient modeCount →
      DiracMatterSpatialCoordinates → MatterCoordinateCarrier)
    (responseSmul : ∀ (parameter : ℝ) coefficient,
      response (parameter • coefficient) = parameter • response coefficient)
    (parameter : ℝ)
    (first second : DiracMatterGalerkinCoefficient modeCount) :
    diracMatterWeakStiffnessDensity matrix basis response first
        (parameter • second) =
      parameter •
        diracMatterWeakStiffnessDensity matrix basis response first second := by
  funext space
  unfold diracMatterWeakStiffnessDensity
  rw [responseSmul, Pi.smul_apply, matterCoordinateEquiv_symm_real_smul,
    diracExteriorMatterEnergyPairing_real_smul_right]
  simp

theorem diracMatterWeakStiffnessDensity_add_left
    (matrix : DiracMatterSpatialCoordinates → DiracMatrix)
    (basis : Fin modeCount → DiracMatterSpatialCoordinates → ℝ)
    (response : DiracMatterGalerkinCoefficient modeCount →
      DiracMatterSpatialCoordinates → MatterCoordinateCarrier)
    (first second third : DiracMatterGalerkinCoefficient modeCount) :
    diracMatterWeakStiffnessDensity matrix basis response (first + second) third =
      diracMatterWeakStiffnessDensity matrix basis response first third +
        diracMatterWeakStiffnessDensity matrix basis response second third := by
  funext space
  unfold diracMatterWeakStiffnessDensity
  rw [diracMatterSpatialGalerkinSynthesis_add, Pi.add_apply,
    diracExteriorMatterEnergyPairing_add_left, neg_add]
  simp only [Pi.add_apply]

theorem diracMatterWeakStiffnessDensity_real_smul_left
    (matrix : DiracMatterSpatialCoordinates → DiracMatrix)
    (basis : Fin modeCount → DiracMatterSpatialCoordinates → ℝ)
    (response : DiracMatterGalerkinCoefficient modeCount →
      DiracMatterSpatialCoordinates → MatterCoordinateCarrier)
    (parameter : ℝ)
    (first second : DiracMatterGalerkinCoefficient modeCount) :
    diracMatterWeakStiffnessDensity matrix basis response
        (parameter • first) second =
      parameter •
        diracMatterWeakStiffnessDensity matrix basis response first second := by
  funext space
  unfold diracMatterWeakStiffnessDensity
  rw [diracMatterSpatialGalerkinSynthesis_real_smul, Pi.smul_apply,
    diracExteriorMatterEnergyPairing_real_smul_left]
  simp

theorem diracMatterWeakStiffnessDensity_hasCompactSupport
    (matrix : DiracMatterSpatialCoordinates → DiracMatrix)
    (basis : Fin modeCount → DiracMatterSpatialCoordinates → ℝ)
    (response : DiracMatterGalerkinCoefficient modeCount →
      DiracMatterSpatialCoordinates → MatterCoordinateCarrier)
    (basisCompact : ∀ mode, HasCompactSupport (basis mode))
    (first second : DiracMatterGalerkinCoefficient modeCount) :
    HasCompactSupport
      (diracMatterWeakStiffnessDensity matrix basis response first second) := by
  have firstCoordinatesCompact :=
    diracMatterSpatialGalerkinSynthesis_coordinates_hasCompactSupport
      basis basisCompact first
  rw [hasCompactSupport_iff_eventuallyEq] at firstCoordinatesCompact ⊢
  filter_upwards [firstCoordinatesCompact] with space coordinatesZero
  have firstZero :
      diracMatterSpatialGalerkinSynthesis basis first space = 0 := by
    apply matterCoordinateEquiv.injective
    simpa only [Pi.zero_apply, map_zero] using coordinatesZero
  simp [diracMatterWeakStiffnessDensity, firstZero,
    diracExteriorMatterEnergyPairing,
    diracExteriorMatterCoordinatePairing, dotProduct]

theorem diracMatterWeakStiffnessDensity_integrable
    (matrix : DiracMatterSpatialCoordinates → DiracMatrix)
    (basis : Fin modeCount → DiracMatterSpatialCoordinates → ℝ)
    (response : DiracMatterGalerkinCoefficient modeCount →
      DiracMatterSpatialCoordinates → MatterCoordinateCarrier)
    (matrixContinuous : ∀ row column,
      Continuous fun space ↦ matrix space row column)
    (basisContinuous : ∀ mode, Continuous (basis mode))
    (basisCompact : ∀ mode, HasCompactSupport (basis mode))
    (responseContinuous : ∀ coefficient, Continuous (response coefficient))
    (first second : DiracMatterGalerkinCoefficient modeCount) :
    Integrable
      (diracMatterWeakStiffnessDensity matrix basis response first second) :=
  (diracMatterWeakStiffnessDensity_continuous matrix basis response
    matrixContinuous basisContinuous responseContinuous first second
    ).integrable_of_hasCompactSupport
      (diracMatterWeakStiffnessDensity_hasCompactSupport matrix basis response
        basisCompact first second)

def diracMatterWeakStiffnessFormValue
    (matrix : DiracMatterSpatialCoordinates → DiracMatrix)
    (basis : Fin modeCount → DiracMatterSpatialCoordinates → ℝ)
    (response : DiracMatterGalerkinCoefficient modeCount →
      DiracMatterSpatialCoordinates → MatterCoordinateCarrier)
    (first second : DiracMatterGalerkinCoefficient modeCount) : ℝ :=
  ∫ space,
    diracMatterWeakStiffnessDensity matrix basis response first second space

theorem diracMatterWeakStiffnessFormValue_time_continuous
    (matrix : ℝ → DiracMatterSpatialCoordinates → DiracMatrix)
    (basis : Fin modeCount → DiracMatterSpatialCoordinates → ℝ)
    (response : ℝ → DiracMatterGalerkinCoefficient modeCount →
      DiracMatterSpatialCoordinates → MatterCoordinateCarrier)
    (matrixContinuous : ∀ row column, Continuous fun input :
      ℝ × DiracMatterSpatialCoordinates ↦
        matrix input.1 input.2 row column)
    (basisContinuous : ∀ mode, Continuous (basis mode))
    (basisCompact : ∀ mode, HasCompactSupport (basis mode))
    (responseContinuous : ∀ coefficient,
      Continuous fun input : ℝ × DiracMatterSpatialCoordinates ↦
        response input.1 coefficient input.2)
    (first second : DiracMatterGalerkinCoefficient modeCount) :
    Continuous fun time ↦
      diracMatterWeakStiffnessFormValue (matrix time) basis
        (response time) first second := by
  let carrier : Set DiracMatterSpatialCoordinates :=
    ⋃ mode : Fin modeCount, tsupport (basis mode)
  have carrierCompact : IsCompact carrier := isCompact_iUnion basisCompact
  have densityContinuous :=
    diracMatterWeakStiffnessDensity_joint_continuous matrix basis response
      matrixContinuous basisContinuous responseContinuous first second
  have densityZeroOutside :
      ∀ time space, time ∈ Set.univ → space ∉ carrier →
        diracMatterWeakStiffnessDensity (matrix time) basis (response time)
          first second space = 0 := by
    intro time space _ spaceOutside
    have basisZero (mode : Fin modeCount) : basis mode space = 0 := by
      by_contra nonzero
      apply spaceOutside
      apply Set.mem_iUnion.2
      exact ⟨mode, subset_closure (by simpa [Function.mem_support] using nonzero)⟩
    have firstZero :
        diracMatterSpatialGalerkinSynthesis basis first space = 0 := by
      apply matterCoordinateEquiv.injective
      simp [diracMatterSpatialGalerkinSynthesis_coordinates, basisZero]
    simp [diracMatterWeakStiffnessDensity, firstZero,
      diracExteriorMatterEnergyPairing,
      diracExteriorMatterCoordinatePairing, dotProduct]
  have integralContinuous :=
    continuousOn_integral_of_compact_support
      (X := ℝ) (Y := DiracMatterSpatialCoordinates) (E := ℝ)
      (μ := volume) (s := Set.univ) (k := carrier)
      (f := fun time space ↦
        diracMatterWeakStiffnessDensity (matrix time) basis (response time)
          first second space)
      carrierCompact densityContinuous.continuousOn densityZeroOutside
  simpa [diracMatterWeakStiffnessFormValue] using integralContinuous

theorem diracMatterWeakStiffnessFormValue_add_right
    (matrix : DiracMatterSpatialCoordinates → DiracMatrix)
    (basis : Fin modeCount → DiracMatterSpatialCoordinates → ℝ)
    (response : DiracMatterGalerkinCoefficient modeCount →
      DiracMatterSpatialCoordinates → MatterCoordinateCarrier)
    (matrixContinuous : ∀ row column,
      Continuous fun space ↦ matrix space row column)
    (basisContinuous : ∀ mode, Continuous (basis mode))
    (basisCompact : ∀ mode, HasCompactSupport (basis mode))
    (responseContinuous : ∀ coefficient, Continuous (response coefficient))
    (responseAdd : ∀ first second,
      response (first + second) = response first + response second)
    (first second third : DiracMatterGalerkinCoefficient modeCount) :
    diracMatterWeakStiffnessFormValue matrix basis response first
        (second + third) =
      diracMatterWeakStiffnessFormValue matrix basis response first second +
        diracMatterWeakStiffnessFormValue matrix basis response first third := by
  unfold diracMatterWeakStiffnessFormValue
  rw [diracMatterWeakStiffnessDensity_add_right matrix basis response responseAdd]
  simp only [Pi.add_apply]
  rw [integral_add
      (diracMatterWeakStiffnessDensity_integrable matrix basis response
        matrixContinuous basisContinuous basisCompact responseContinuous first
        second)
      (diracMatterWeakStiffnessDensity_integrable matrix basis response
        matrixContinuous basisContinuous basisCompact responseContinuous first
        third)]

theorem diracMatterWeakStiffnessFormValue_real_smul_right
    (matrix : DiracMatterSpatialCoordinates → DiracMatrix)
    (basis : Fin modeCount → DiracMatterSpatialCoordinates → ℝ)
    (response : DiracMatterGalerkinCoefficient modeCount →
      DiracMatterSpatialCoordinates → MatterCoordinateCarrier)
    (responseSmul : ∀ (parameter : ℝ) coefficient,
      response (parameter • coefficient) = parameter • response coefficient)
    (parameter : ℝ)
    (first second : DiracMatterGalerkinCoefficient modeCount) :
    diracMatterWeakStiffnessFormValue matrix basis response first
        (parameter • second) =
      parameter •
        diracMatterWeakStiffnessFormValue matrix basis response first second := by
  unfold diracMatterWeakStiffnessFormValue
  rw [diracMatterWeakStiffnessDensity_real_smul_right matrix basis response
    responseSmul]
  simp only [Pi.smul_apply]
  rw [integral_smul]

theorem diracMatterWeakStiffnessFormValue_add_left
    (matrix : DiracMatterSpatialCoordinates → DiracMatrix)
    (basis : Fin modeCount → DiracMatterSpatialCoordinates → ℝ)
    (response : DiracMatterGalerkinCoefficient modeCount →
      DiracMatterSpatialCoordinates → MatterCoordinateCarrier)
    (matrixContinuous : ∀ row column,
      Continuous fun space ↦ matrix space row column)
    (basisContinuous : ∀ mode, Continuous (basis mode))
    (basisCompact : ∀ mode, HasCompactSupport (basis mode))
    (responseContinuous : ∀ coefficient, Continuous (response coefficient))
    (first second third : DiracMatterGalerkinCoefficient modeCount) :
    diracMatterWeakStiffnessFormValue matrix basis response
        (first + second) third =
      diracMatterWeakStiffnessFormValue matrix basis response first third +
        diracMatterWeakStiffnessFormValue matrix basis response second third := by
  unfold diracMatterWeakStiffnessFormValue
  rw [diracMatterWeakStiffnessDensity_add_left]
  simp only [Pi.add_apply]
  rw [integral_add
      (diracMatterWeakStiffnessDensity_integrable matrix basis response
        matrixContinuous basisContinuous basisCompact responseContinuous first
        third)
      (diracMatterWeakStiffnessDensity_integrable matrix basis response
        matrixContinuous basisContinuous basisCompact responseContinuous second
        third)]

theorem diracMatterWeakStiffnessFormValue_real_smul_left
    (matrix : DiracMatterSpatialCoordinates → DiracMatrix)
    (basis : Fin modeCount → DiracMatterSpatialCoordinates → ℝ)
    (response : DiracMatterGalerkinCoefficient modeCount →
      DiracMatterSpatialCoordinates → MatterCoordinateCarrier)
    (parameter : ℝ)
    (first second : DiracMatterGalerkinCoefficient modeCount) :
    diracMatterWeakStiffnessFormValue matrix basis response
        (parameter • first) second =
      parameter •
        diracMatterWeakStiffnessFormValue matrix basis response first second := by
  unfold diracMatterWeakStiffnessFormValue
  rw [diracMatterWeakStiffnessDensity_real_smul_left]
  simp only [Pi.smul_apply]
  rw [integral_smul]

def diracMatterWeakStiffnessInnerLinear
    (matrix : DiracMatterSpatialCoordinates → DiracMatrix)
    (basis : Fin modeCount → DiracMatterSpatialCoordinates → ℝ)
    (response : DiracMatterGalerkinCoefficient modeCount →
      DiracMatterSpatialCoordinates → MatterCoordinateCarrier)
    (matrixContinuous : ∀ row column,
      Continuous fun space ↦ matrix space row column)
    (basisContinuous : ∀ mode, Continuous (basis mode))
    (basisCompact : ∀ mode, HasCompactSupport (basis mode))
    (responseContinuous : ∀ coefficient, Continuous (response coefficient))
    (trial : DiracMatterGalerkinCoefficient modeCount) :
    DiracMatterGalerkinCoefficient modeCount →ₗ[ℝ] ℝ where
  toFun test :=
    diracMatterWeakStiffnessFormValue matrix basis response test trial
  map_add' := fun first second ↦
    diracMatterWeakStiffnessFormValue_add_left matrix basis response
      matrixContinuous basisContinuous basisCompact responseContinuous first
      second trial
  map_smul' := by
    intro parameter test
    exact diracMatterWeakStiffnessFormValue_real_smul_left matrix basis
      response parameter test trial

def diracMatterWeakStiffnessInnerCLM
    (matrix : DiracMatterSpatialCoordinates → DiracMatrix)
    (basis : Fin modeCount → DiracMatterSpatialCoordinates → ℝ)
    (response : DiracMatterGalerkinCoefficient modeCount →
      DiracMatterSpatialCoordinates → MatterCoordinateCarrier)
    (matrixContinuous : ∀ row column,
      Continuous fun space ↦ matrix space row column)
    (basisContinuous : ∀ mode, Continuous (basis mode))
    (basisCompact : ∀ mode, HasCompactSupport (basis mode))
    (responseContinuous : ∀ coefficient, Continuous (response coefficient))
    (trial : DiracMatterGalerkinCoefficient modeCount) :
    DiracMatterGalerkinCoefficient modeCount →L[ℝ] ℝ :=
  (diracMatterWeakStiffnessInnerLinear matrix basis response matrixContinuous
    basisContinuous basisCompact responseContinuous trial).toContinuousLinearMap

def diracMatterWeakStiffnessForm
    (matrix : DiracMatterSpatialCoordinates → DiracMatrix)
    (basis : Fin modeCount → DiracMatterSpatialCoordinates → ℝ)
    (response : DiracMatterGalerkinCoefficient modeCount →
      DiracMatterSpatialCoordinates → MatterCoordinateCarrier)
    (matrixContinuous : ∀ row column,
      Continuous fun space ↦ matrix space row column)
    (basisContinuous : ∀ mode, Continuous (basis mode))
    (basisCompact : ∀ mode, HasCompactSupport (basis mode))
    (responseContinuous : ∀ coefficient, Continuous (response coefficient))
    (responseAdd : ∀ first second,
      response (first + second) = response first + response second)
    (responseSmul : ∀ (parameter : ℝ) coefficient,
      response (parameter • coefficient) = parameter • response coefficient) :
    DiracMatterGalerkinCoefficient modeCount →L[ℝ]
      (DiracMatterGalerkinCoefficient modeCount →L[ℝ] ℝ) :=
  ({
    toFun := fun trial ↦
      diracMatterWeakStiffnessInnerCLM matrix basis response matrixContinuous
        basisContinuous basisCompact responseContinuous trial
    map_add' := by
      intro firstTrial secondTrial
      ext test
      exact diracMatterWeakStiffnessFormValue_add_right matrix basis response
        matrixContinuous basisContinuous basisCompact responseContinuous
        responseAdd test firstTrial secondTrial
    map_smul' := by
      intro parameter trial
      ext test
      change diracMatterWeakStiffnessFormValue matrix basis response
          test (parameter • trial) =
        parameter •
          diracMatterWeakStiffnessFormValue matrix basis response test trial
      exact diracMatterWeakStiffnessFormValue_real_smul_right matrix basis
        response responseSmul parameter test trial
  } : DiracMatterGalerkinCoefficient modeCount →ₗ[ℝ]
      (DiracMatterGalerkinCoefficient modeCount →L[ℝ] ℝ)
    ).toContinuousLinearMap

@[simp] theorem diracMatterWeakStiffnessForm_apply
    (matrix : DiracMatterSpatialCoordinates → DiracMatrix)
    (basis : Fin modeCount → DiracMatterSpatialCoordinates → ℝ)
    (response : DiracMatterGalerkinCoefficient modeCount →
      DiracMatterSpatialCoordinates → MatterCoordinateCarrier)
    (matrixContinuous : ∀ row column,
      Continuous fun space ↦ matrix space row column)
    (basisContinuous : ∀ mode, Continuous (basis mode))
    (basisCompact : ∀ mode, HasCompactSupport (basis mode))
    (responseContinuous : ∀ coefficient, Continuous (response coefficient))
    (responseAdd : ∀ first second,
      response (first + second) = response first + response second)
    (responseSmul : ∀ (parameter : ℝ) coefficient,
      response (parameter • coefficient) = parameter • response coefficient)
    (trial test : DiracMatterGalerkinCoefficient modeCount) :
    diracMatterWeakStiffnessForm matrix basis response matrixContinuous
        basisContinuous basisCompact responseContinuous responseAdd responseSmul
        trial test =
      diracMatterWeakStiffnessFormValue matrix basis response test trial :=
  rfl

theorem diracMatterWeakStiffnessForm_time_continuous
    (matrix : ℝ → DiracMatterSpatialCoordinates → DiracMatrix)
    (basis : Fin modeCount → DiracMatterSpatialCoordinates → ℝ)
    (response : ℝ → DiracMatterGalerkinCoefficient modeCount →
      DiracMatterSpatialCoordinates → MatterCoordinateCarrier)
    (matrixContinuous : ∀ row column, Continuous fun input :
      ℝ × DiracMatterSpatialCoordinates ↦
        matrix input.1 input.2 row column)
    (basisContinuous : ∀ mode, Continuous (basis mode))
    (basisCompact : ∀ mode, HasCompactSupport (basis mode))
    (responseContinuous : ∀ coefficient,
      Continuous fun input : ℝ × DiracMatterSpatialCoordinates ↦
        response input.1 coefficient input.2)
    (responseAdd : ∀ time first second,
      response time (first + second) =
        response time first + response time second)
    (responseSmul : ∀ time (parameter : ℝ) coefficient,
      response time (parameter • coefficient) =
        parameter • response time coefficient) :
    Continuous fun time ↦
      diracMatterWeakStiffnessForm (matrix time) basis (response time)
        (diracMatterWeakMassMatrix_spatial_continuous matrix matrixContinuous time)
        basisContinuous basisCompact
        (fun coefficient ↦ (responseContinuous coefficient).comp
          (continuous_const.prodMk continuous_id))
        (responseAdd time) (responseSmul time) := by
  rw [continuous_clm_apply]
  intro trial
  rw [continuous_clm_apply]
  intro test
  change Continuous fun time ↦
    diracMatterWeakStiffnessFormValue (matrix time) basis (response time)
      test trial
  exact diracMatterWeakStiffnessFormValue_time_continuous matrix basis response
    matrixContinuous basisContinuous basisCompact responseContinuous test trial

/-- Riesz realization of the action-owned weak stiffness form. -/
def diracMatterWeakStiffnessOperator
    (form : ℝ → DiracMatterGalerkinCoefficient modeCount →L[ℝ]
      (DiracMatterGalerkinCoefficient modeCount →L[ℝ] ℝ))
    (time : ℝ) : DiracMatterGalerkinCoefficient modeCount →L[ℝ]
      DiracMatterGalerkinCoefficient modeCount :=
  galerkinWeakMassOperator form time

theorem diracMatterWeakStiffnessOperator_continuous
    (form : ℝ → DiracMatterGalerkinCoefficient modeCount →L[ℝ]
      (DiracMatterGalerkinCoefficient modeCount →L[ℝ] ℝ))
    (formContinuous : Continuous form) :
    Continuous (diracMatterWeakStiffnessOperator form) :=
  galerkinWeakMassOperator_continuous form formContinuous

@[simp] theorem real_inner_diracMatterWeakStiffnessOperator
    (form : ℝ → DiracMatterGalerkinCoefficient modeCount →L[ℝ]
      (DiracMatterGalerkinCoefficient modeCount →L[ℝ] ℝ))
    (time : ℝ)
    (first second : DiracMatterGalerkinCoefficient modeCount) :
    inner ℝ (diracMatterWeakStiffnessOperator form time first) second =
      form time first second :=
  real_inner_galerkinWeakMassOperator form time first second

end

