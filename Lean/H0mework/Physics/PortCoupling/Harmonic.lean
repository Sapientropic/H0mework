def harmonicEndpoint_lawful (occurrence : Bool) :
    physicalWorld.LawfulEvolutionAt
      (current := Bool.not occurrence) occurrence
      (harmonicFlow (Real.pi / 2) (preparedState occurrence)) := by
  rw [harmonicFlow_pi_div_two_eq_evolve_on_prepared]
  exact evolution_lawful occurrence

/-- A coupling receipt whose target value is generated by the continuous
Hamiltonian trajectory, not merely by the discrete endpoint presentation. -/
structure HarmonicPortReceiptAt
    (channel : FiniteEmbodimentChannel)
    (source occurrence : Bool) : Type where
  discrete : PortReceiptAt channel source occurrence
  harmonicLawful : physicalWorld.LawfulEvolutionAt
    (current := Bool.not occurrence) occurrence
    (harmonicFlow (Real.pi / 2) (preparedState occurrence))
  harmonicEndpoint :
    harmonicFlow (Real.pi / 2) (preparedState occurrence) =
      evolutionAtOccurrence occurrence
  continuousLawful : ∀ time,
    harmonicPhysicalWorld.LawfulEvolutionAt
      (current := (preparedState occurrence, time)) time
      (harmonicFlow time (preparedState occurrence))
  energyAlongFlow : ∀ time,
    energy (harmonicFlow time (preparedState occurrence)) =
      energy (preparedState occurrence)
  hamiltonEquations : ∀ time,
    HasDerivAt
        (fun t => sourcePort
          (harmonicFlow t (preparedState occurrence)) channel)
        (-targetPort
          (harmonicFlow time (preparedState occurrence)) channel) time ∧
      HasDerivAt
        (fun t => targetPort
          (harmonicFlow t (preparedState occurrence)) channel)
        (sourcePort
          (harmonicFlow time (preparedState occurrence)) channel) time
  interventionSensitive : ∀ {left right : ℝ}, left ≠ right →
    targetPort
        (harmonicFlow (Real.pi / 2) (intervention channel left)) channel ≠
      targetPort
        (harmonicFlow (Real.pi / 2) (intervention channel right)) channel
  otherTargetPortsUnaffected : ∀ other, other ≠ channel →
    targetPort
        (harmonicFlow (Real.pi / 2) (intervention channel 1)) other = 0

def harmonicSeedReceipt (channel : FiniteEmbodimentChannel) :
    HarmonicPortReceiptAt channel false true where
  discrete := seedReceipt channel
  harmonicLawful := harmonicEndpoint_lawful true
  harmonicEndpoint := harmonicFlow_pi_div_two_eq_evolve_on_prepared true
  continuousLawful := fun time =>
    harmonicEvolution_lawful (preparedState true) time
  energyAlongFlow := fun time =>
    harmonicFlow_energy_conserved time (preparedState true)
  hamiltonEquations := fun time =>
    harmonicFlow_satisfiesPortHamiltonEquations
      (preparedState true) channel time
  interventionSensitive := fun different =>
    harmonicIntervention_sensitive channel different
  otherTargetPortsUnaffected := fun other different =>
    harmonicIntervention_leavesOtherTargetZero
      (sourceChannel := channel) (targetChannel := other) different 1

theorem HarmonicPortReceiptAt.readout_true
    {channel source occurrence}
    (receipt : HarmonicPortReceiptAt channel source occurrence) :
    decide (targetPort (evolutionAtOccurrence occurrence) channel = 1) =
      true :=
  receipt.discrete.readout_true

