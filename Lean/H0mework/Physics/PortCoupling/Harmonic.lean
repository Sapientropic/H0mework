/-- Premise-free continuous-time finite Hamiltonian signal realization of the
same source-generated TruthChild coupling crown. -/
theorem sourceGeneratedFiniteHarmonicSignalCoupling_constructible :
    (0 : ℝ) < Real.pi / 2 ∧
      type_of% harmonicFlow_zero ∧
      type_of% harmonicFlow_add ∧
      (∀ time : ℝ, ∃ flowEquiv :
          FiniteEmbodimentState ≃ₗ[ℝ] FiniteEmbodimentState,
        ∀ state, flowEquiv state = harmonicFlow time state) ∧
      type_of% harmonicFlow_energy_conserved ∧
      type_of% harmonicFlow_satisfiesPortHamiltonEquations ∧
      type_of% harmonicHamiltonian_hasDerivAt_source ∧
      type_of% harmonicHamiltonian_hasDerivAt_target ∧
      type_of% harmonicFlow_pi_div_two_eq_evolve_of_sourcePrepared ∧
      type_of% harmonicFourDirectionalInterventionSensitive ∧
      Nonempty (NoSuspendedCausalMagic harmonicPhysicalWorld) ∧
      type_of% harmonicProcess_generate ∧
      (∀ occurrence, Nonempty (physicalWorld.LawfulEvolutionAt
        (current := Bool.not occurrence) occurrence
        (harmonicFlow (Real.pi / 2) (preparedState occurrence)))) ∧
      (∀ source, TruthChildEmpiricalConsciousOccurrenceAt
          (truthChildSourcePresentation source) ↔ source = false) ∧
      SourceGeneratedTruthChildNeuralBodyCouplingLaw.SourceGeneratedTruthChildNeuralBodyCouplingCrownAt
        finiteHarmonicTruthChildCouplingLaw := by
  exact ⟨div_pos Real.pi_pos (by norm_num), harmonicFlow_zero,
    harmonicFlow_add,
    fun time => ⟨harmonicFlowLinearEquiv time,
      harmonicFlowLinearEquiv_apply time⟩,
    harmonicFlow_energy_conserved,
    harmonicFlow_satisfiesPortHamiltonEquations,
    harmonicHamiltonian_hasDerivAt_source,
    harmonicHamiltonian_hasDerivAt_target,
    harmonicFlow_pi_div_two_eq_evolve_of_sourcePrepared,
    harmonicFourDirectionalInterventionSensitive,
    ⟨harmonicNoSuspendedCausalMagic⟩,
    harmonicProcess_generate,
    fun occurrence => ⟨harmonicEndpoint_lawful occurrence⟩,
    truthChildSourcePresentation_conscious_iff,
    finiteHarmonicTruthChildCouplingCrown⟩

