/-! ## Finite-dimensional matrix directional calculus -/

/-- A fixed directional derivative of a smooth Lorentz-matrix field is
smooth. -/
theorem lorentzMatrixFieldDirectionalDerivative_contDiff
    (field : BasePoint → LorentzianCoframe)
    (smooth : ContDiff ℝ ∞ field)
    (direction : LorentzianIndex) :
    ContDiff ℝ ∞ fun point =>
      fieldDirectionalDerivative field point direction := by
  unfold fieldDirectionalDerivative
  simpa [Function.comp_def] using
    (smooth.contDiff_fderiv_apply (m := ∞) (by simp)).comp
      (contDiff_prodMk_left (coordinateDirection direction))

/-- Matrix entry readout commutes with the derivative of an actual smooth
matrix field. -/
theorem fieldDirectionalDerivative_lorentzMatrix_entry
    (field : BasePoint → LorentzianCoframe)
    (smooth : ContDiff ℝ ∞ field)
    (point : BasePoint) (direction row column : LorentzianIndex) :
    fieldDirectionalDerivative field point direction row column =
      fieldDirectionalDerivative
        (fun candidate => field candidate row column) point direction := by
  have actual := fieldDirectionalDerivative_continuousLinear
    (lorentzMatrixEntryCLM row column) field smooth point direction
  change
    fieldDirectionalDerivative
        (fun candidate => field candidate row column) point direction =
      fieldDirectionalDerivative field point direction row column
    at actual
  exact actual.symm

/-- Equality of mixed coordinate derivatives for a smooth scalar field. -/
theorem mixedRealFieldDirectionalDerivative_comm
    (field : BasePoint → ℝ)
    (smooth : ContDiff ℝ ∞ field)
    (point : BasePoint)
    (first second : LorentzianIndex) :
    fieldDirectionalDerivative
        (fun candidate => fieldDirectionalDerivative field candidate first)
        point second =
      fieldDirectionalDerivative
        (fun candidate => fieldDirectionalDerivative field candidate second)
        point first := by
  have derivativeSmooth : ContDiff ℝ ∞ (fderiv ℝ field) :=
    smooth.fderiv_right (m := ∞) (by simp)
  have derivativeDifferentiable :
      DifferentiableAt ℝ (fderiv ℝ field) point :=
    (derivativeSmooth.differentiable (by simp)).differentiableAt
  have evaluatedSecondDerivative
      (inner outer : LorentzianIndex) :
      fderiv ℝ
          (fun candidate =>
            fderiv ℝ field candidate (coordinateDirection inner))
          point (coordinateDirection outer) =
        fderiv ℝ (fderiv ℝ field) point
          (coordinateDirection outer)
          (coordinateDirection inner) := by
    let evaluation :
        (BasePoint →L[ℝ] ℝ) →L[ℝ] ℝ :=
      ContinuousLinearMap.apply ℝ ℝ (coordinateDirection inner)
    have hEvaluation : HasFDerivAt
        (fun candidate => evaluation (fderiv ℝ field candidate))
        (evaluation.comp (fderiv ℝ (fderiv ℝ field) point)) point := by
      exact evaluation.hasFDerivAt.comp point
        derivativeDifferentiable.hasFDerivAt
    have evaluated := congrArg
      (fun derivative : BasePoint →L[ℝ] ℝ =>
        derivative (coordinateDirection outer))
      hEvaluation.fderiv
    change
      fderiv ℝ
          (fun candidate =>
            fderiv ℝ field candidate (coordinateDirection inner))
          point (coordinateDirection outer) =
        fderiv ℝ (fderiv ℝ field) point
          (coordinateDirection outer)
          (coordinateDirection inner)
      at evaluated
    exact evaluated
  have symmetricSecond : IsSymmSndFDerivAt ℝ field point :=
    smooth.contDiffAt.isSymmSndFDerivAt (by
      have finiteOrder : (2 : WithTop ℕ∞) ≤ ∞ :=
        WithTop.coe_le_coe.2 (OrderTop.le_top _)
      simpa [minSmoothness] using finiteOrder)
  unfold fieldDirectionalDerivative
  calc
    fderiv ℝ
        (fun candidate =>
          fderiv ℝ field candidate (coordinateDirection first))
        point (coordinateDirection second) =
      fderiv ℝ (fderiv ℝ field) point
        (coordinateDirection second)
        (coordinateDirection first) :=
      evaluatedSecondDerivative first second
    _ =
      fderiv ℝ (fderiv ℝ field) point
        (coordinateDirection first)
        (coordinateDirection second) :=
      symmetricSecond.eq
        (coordinateDirection second)
        (coordinateDirection first)
    _ =
      fderiv ℝ
        (fun candidate =>
          fderiv ℝ field candidate (coordinateDirection second))
        point (coordinateDirection first) :=
      (evaluatedSecondDerivative second first).symm

/-- Entrywise Schwarz symmetry, reassembled on the exact Lorentz-matrix
carrier whose elementwise norm is used by the primitive action. -/
theorem mixedLorentzMatrixFieldDirectionalDerivative_comm
    (field : BasePoint → LorentzianCoframe)
    (smooth : ContDiff ℝ ∞ field)
    (point : BasePoint)
    (first second : LorentzianIndex) :
    fieldDirectionalDerivative
        (fun candidate => fieldDirectionalDerivative field candidate first)
        point second =
      fieldDirectionalDerivative
        (fun candidate => fieldDirectionalDerivative field candidate second)
        point first := by
  ext row column
  have firstSmooth :=
    lorentzMatrixFieldDirectionalDerivative_contDiff field smooth first
  have secondSmooth :=
    lorentzMatrixFieldDirectionalDerivative_contDiff field smooth second
  rw [fieldDirectionalDerivative_lorentzMatrix_entry _ firstSmooth,
    fieldDirectionalDerivative_lorentzMatrix_entry _ secondSmooth]
  have firstEntry :
      (fun candidate =>
          fieldDirectionalDerivative field candidate first row column) =
        fun candidate =>
          fieldDirectionalDerivative
            (fun location => field location row column) candidate first := by
    funext candidate
    exact fieldDirectionalDerivative_lorentzMatrix_entry field smooth
      candidate first row column
  have secondEntry :
      (fun candidate =>
          fieldDirectionalDerivative field candidate second row column) =
        fun candidate =>
          fieldDirectionalDerivative
            (fun location => field location row column) candidate second := by
    funext candidate
    exact fieldDirectionalDerivative_lorentzMatrix_entry field smooth
      candidate second row column
  rw [firstEntry, secondEntry]
  exact mixedRealFieldDirectionalDerivative_comm
    (fun candidate => field candidate row column)
    ((contDiff_pi.mp (contDiff_pi.mp smooth row)) column)
    point first second

/-- Product rule on the actual Lorentz matrix norm. -/
theorem fieldDirectionalDerivative_lorentzMatrix_mul
    (first second : BasePoint → LorentzianCoframe)
    (firstSmooth : ContDiff ℝ ∞ first)
    (secondSmooth : ContDiff ℝ ∞ second)
    (point : BasePoint) (direction : LorentzianIndex) :
    fieldDirectionalDerivative
        (fun candidate => first candidate * second candidate)
        point direction =
      fieldDirectionalDerivative first point direction * second point +
        first point * fieldDirectionalDerivative second point direction := by
  have actual := fieldDirectionalDerivative_continuousBilinear
    lorentzMatrixRealMulBilinear.toContinuousBilinearMap
      first second firstSmooth secondSmooth point direction
  change
    fieldDirectionalDerivative
        (fun candidate => first candidate * second candidate)
        point direction =
      fieldDirectionalDerivative first point direction * second point +
        first point * fieldDirectionalDerivative second point direction
    at actual
  exact actual

/-- Subtraction rule on the actual Lorentz matrix norm. -/
theorem fieldDirectionalDerivative_lorentzMatrix_sub
    (first second : BasePoint → LorentzianCoframe)
    (firstSmooth : ContDiff ℝ ∞ first)
    (secondSmooth : ContDiff ℝ ∞ second)
    (point : BasePoint) (direction : LorentzianIndex) :
    fieldDirectionalDerivative
        (fun candidate => first candidate - second candidate)
        point direction =
      fieldDirectionalDerivative first point direction -
        fieldDirectionalDerivative second point direction := by
  unfold fieldDirectionalDerivative
  rw [fderiv_fun_sub
    (firstSmooth.differentiable (by simp) point)
    (secondSmooth.differentiable (by simp) point)]
  rfl

/-! ## Primitive gravity-connection matrix readout -/

/-- Dependency-light smoothness gate for the primitive gravity connection.
Other fields of the holonomic carrier play no role in curvature covariance. -/
def GravityConnectionSmooth
    (configuration : StageNineHolonomicConfiguration) : Prop :=
  ∀ direction internalOut internalIn,
    ContDiff ℝ ∞ fun point =>
      configuration.gravityConnection point direction internalOut internalIn

theorem gravityConnectionSmooth_of_smooth
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth) :
    GravityConnectionSmooth configuration :=
  smooth.2.1

/-- Raw mixed-index matrix generated by the primitive connection field. -/
def rawGravityConnectionMatrix
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) (direction : LorentzianIndex) :
    LorentzianCoframe :=
  spinConnectionMatrix (configuration.gravityConnection point) direction

theorem rawGravityConnectionMatrix_contDiff
    (configuration : StageNineHolonomicConfiguration)
    (smooth : GravityConnectionSmooth configuration)
    (direction : LorentzianIndex) :
    ContDiff ℝ ∞ fun point =>
      rawGravityConnectionMatrix configuration point direction := by
  apply contDiff_pi'
  intro internalOut
  apply contDiff_pi'
  intro internalIn
  exact smooth direction internalOut internalIn

theorem connectionMatrix_contDiff_of_connectionSmooth
    (configuration : StageNineHolonomicConfiguration)
    (smooth : GravityConnectionSmooth configuration)
    (direction : LorentzianIndex) :
    ContDiff ℝ ∞ fun point =>
      connectionMatrix configuration point direction := by
  apply contDiff_piLp'
  rintro ⟨internalOut, internalIn⟩
  exact smooth direction internalOut internalIn

theorem connectionMatrixDerivative_apply_of_connectionSmooth
    (configuration : StageNineHolonomicConfiguration)
    (smooth : GravityConnectionSmooth configuration)
    (point : BasePoint)
    (derivativeDirection formDirection internalOut internalIn :
      LorentzianIndex) :
    connectionMatrixDerivative configuration point derivativeDirection
        formDirection (internalOut, internalIn) =
      gravityConnectionDerivative configuration point derivativeDirection
        formDirection internalOut internalIn := by
  unfold connectionMatrixDerivative gravityConnectionDerivative
    fieldDirectionalDerivative connectionMatrix
  let projection : GravityMatrix →L[ℝ] ℝ :=
    EuclideanSpace.proj (internalOut, internalIn)
  have differentiable :=
    (connectionMatrix_contDiff_of_connectionSmooth configuration smooth
      formDirection).differentiable (by simp) point
  have composed :=
    (projection.hasFDerivAt.comp point differentiable.hasFDerivAt).fderiv
  have evaluated := congrArg
    (fun derivative : BasePoint →L[ℝ] ℝ =>
      derivative (coordinateDirection derivativeDirection)) composed
  simpa [projection, Function.comp_def, connectionMatrix] using evaluated.symm

@[simp] theorem coordinateToRawMatrix_connectionMatrix
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) (direction : LorentzianIndex) :
    coordinateToRawMatrix (connectionMatrix configuration point direction) =
      rawGravityConnectionMatrix configuration point direction :=
  rfl

theorem coordinateToRawMatrix_connectionMatrixDerivative
    (configuration : StageNineHolonomicConfiguration)
    (smooth : GravityConnectionSmooth configuration)
    (point : BasePoint)
    (derivativeDirection formDirection : LorentzianIndex) :
    coordinateToRawMatrix
        (connectionMatrixDerivative configuration point
          derivativeDirection formDirection) =
      fieldDirectionalDerivative
        (fun candidate =>
          rawGravityConnectionMatrix configuration candidate formDirection)
        point derivativeDirection := by
  ext internalOut internalIn
  change
    connectionMatrixDerivative configuration point derivativeDirection
        formDirection (internalOut, internalIn) = _
  rw [connectionMatrixDerivative_apply_of_connectionSmooth
    configuration smooth]
  rw [fieldDirectionalDerivative_lorentzMatrix_entry _
    (rawGravityConnectionMatrix_contDiff configuration smooth formDirection)]
  rfl

/-- Faithful raw-matrix normal form of the actual ordered primitive
curvature. -/
theorem coordinateToRawMatrix_orderedMixedCurvature
    (configuration : StageNineHolonomicConfiguration)
    (smooth : GravityConnectionSmooth configuration)
    (point : BasePoint) (first second : LorentzianIndex) :
    coordinateToRawMatrix
        (orderedMixedCurvature configuration point first second) =
      fieldDirectionalDerivative
          (fun candidate =>
            rawGravityConnectionMatrix configuration candidate second)
          point first -
        fieldDirectionalDerivative
          (fun candidate =>
            rawGravityConnectionMatrix configuration candidate first)
          point second +
        (rawGravityConnectionMatrix configuration point first *
            rawGravityConnectionMatrix configuration point second -
          rawGravityConnectionMatrix configuration point second *
            rawGravityConnectionMatrix configuration point first) := by
  unfold orderedMixedCurvature
  rw [map_add, map_sub,
    coordinateToRawMatrix_connectionMatrixDerivative configuration smooth,
    coordinateToRawMatrix_connectionMatrixDerivative configuration smooth,
    coordinateToRawMatrix_matrixBracket]
  simp only [coordinateToRawMatrix_connectionMatrix]

/-! ## The generated inverse Lorentz field -/

/-- Matrix inverse belonging to the same generated Weyl-dual Lorentz field. -/
def localSpinWeylDualLorentzInverseMatrix
    (spinField : BasePoint → SpinPlus13) (point : BasePoint) :
    LorentzianCoframe :=
  (localSpinWeylDualLorentzMatrix spinField point)⁻¹

theorem localSpinWeylDualLorentzInverseMatrix_contDiff
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField) :
    ContDiff ℝ ∞ (localSpinWeylDualLorentzInverseMatrix spinField) := by
  have fieldEquality :
      localSpinWeylDualLorentzInverseMatrix spinField =
        fun point =>
          (localSpinLorentzMatrixField spinField point).transpose := by
    funext point
    exact spinLorentzMatrix_spinWeylDual_nonsingInv (spinField point)
  rw [fieldEquality]
  exact lorentzMatrixTransposeCLM.contDiff.comp
    (localSpinLorentzMatrixField_contDiff spinField smooth)

@[simp] theorem localSpinWeylDualLorentzMatrix_mul_inverse
    (spinField : BasePoint → SpinPlus13) (point : BasePoint) :
    localSpinWeylDualLorentzMatrix spinField point *
        localSpinWeylDualLorentzInverseMatrix spinField point = 1 := by
  unfold localSpinWeylDualLorentzInverseMatrix
  unfold localSpinWeylDualLorentzMatrix
  rw [spinLorentzMatrix_nonsingInv]
  rw [← map_mul]
  simp

@[simp] theorem localSpinWeylDualLorentzInverse_mul_matrix
    (spinField : BasePoint → SpinPlus13) (point : BasePoint) :
    localSpinWeylDualLorentzInverseMatrix spinField point *
        localSpinWeylDualLorentzMatrix spinField point = 1 := by
  unfold localSpinWeylDualLorentzInverseMatrix
  unfold localSpinWeylDualLorentzMatrix
  rw [spinLorentzMatrix_nonsingInv]
  rw [← map_mul]
  simp

/-- The inverse derivative is forced by differentiating the matrix identity
generated by the same local Spin field. -/
theorem localSpinWeylDualLorentzInverseDerivative
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField)
    (point : BasePoint) (direction : LorentzianIndex) :
    fieldDirectionalDerivative
        (localSpinWeylDualLorentzInverseMatrix spinField) point direction =
      -localSpinWeylDualLorentzInverseMatrix spinField point *
          fieldDirectionalDerivative
            (localSpinWeylDualLorentzMatrix spinField) point direction *
        localSpinWeylDualLorentzInverseMatrix spinField point := by
  let lorentz := localSpinWeylDualLorentzMatrix spinField
  let inverse := localSpinWeylDualLorentzInverseMatrix spinField
  have lorentzSmooth : ContDiff ℝ ∞ lorentz :=
    localSpinWeylDualLorentzMatrix_contDiff spinField smooth
  have inverseSmooth : ContDiff ℝ ∞ inverse :=
    localSpinWeylDualLorentzInverseMatrix_contDiff spinField smooth
  have productDerivative := fieldDirectionalDerivative_lorentzMatrix_mul
    lorentz inverse lorentzSmooth inverseSmooth point direction
  have productFieldEquality :
      (fun candidate => lorentz candidate * inverse candidate) =
        fun _ : BasePoint => (1 : LorentzianCoframe) := by
    funext candidate
    exact localSpinWeylDualLorentzMatrix_mul_inverse spinField candidate
  rw [productFieldEquality] at productDerivative
  have derivativeZero :
      fieldDirectionalDerivative
          (fun _ : BasePoint => (1 : LorentzianCoframe)) point direction = 0 := by
    simp [fieldDirectionalDerivative]
  rw [derivativeZero] at productDerivative
  have productDerivative' :
      fieldDirectionalDerivative lorentz point direction * inverse point +
          lorentz point *
            fieldDirectionalDerivative inverse point direction = 0 :=
    productDerivative.symm
  have inverseProduct : inverse point * lorentz point = 1 := by
    exact localSpinWeylDualLorentzInverse_mul_matrix spinField point
  have rearranged :
      inverse point * fieldDirectionalDerivative lorentz point direction *
            inverse point +
          fieldDirectionalDerivative inverse point direction = 0 := by
    calc
      inverse point * fieldDirectionalDerivative lorentz point direction *
              inverse point +
            fieldDirectionalDerivative inverse point direction =
          inverse point * fieldDirectionalDerivative lorentz point direction *
              inverse point +
            (inverse point * lorentz point) *
              fieldDirectionalDerivative inverse point direction := by
            rw [inverseProduct]
            simp
      _ =
          inverse point *
            (fieldDirectionalDerivative lorentz point direction *
                inverse point +
              lorentz point *
                fieldDirectionalDerivative inverse point direction) := by
            noncomm_ring
      _ = 0 := by rw [productDerivative']; simp
  have derivativeFormula :
      fieldDirectionalDerivative inverse point direction =
        -(inverse point * fieldDirectionalDerivative lorentz point direction *
          inverse point) := by
    rw [eq_neg_iff_add_eq_zero]
    simpa [add_comm] using rearranged
  simpa [lorentz, inverse] using derivativeFormula

/-! ## Homogeneous and Maurer matrices generated by the primitive write -/

/-- Homogeneous matrix leg of the same primitive local Spin connection
write. -/
def localSpinHomogeneousGravityMatrix
    (spinField : BasePoint → SpinPlus13)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) (direction : LorentzianIndex) :
    LorentzianCoframe :=
  localSpinWeylDualLorentzMatrix spinField point *
      rawGravityConnectionMatrix configuration point direction *
    localSpinWeylDualLorentzInverseMatrix spinField point

/-- Right Maurer matrix leg generated by the derivative of the same local
Spin field. -/
def localSpinMaurerGravityMatrix
    (spinField : BasePoint → SpinPlus13)
    (point : BasePoint) (direction : LorentzianIndex) :
    LorentzianCoframe :=
  localSpinWeylDualLorentzDerivative spinField point direction *
    localSpinWeylDualLorentzInverseMatrix spinField point

theorem lorentzMatrixField_mul_contDiff
    (first second : BasePoint → LorentzianCoframe)
    (firstSmooth : ContDiff ℝ ∞ first)
    (secondSmooth : ContDiff ℝ ∞ second) :
    ContDiff ℝ ∞ fun point => first point * second point := by
  apply contDiff_pi'
  intro row
  apply contDiff_pi'
  intro column
  change ContDiff ℝ ∞ fun point =>
    ∑ middle : LorentzianIndex,
      first point row middle * second point middle column
  apply ContDiff.sum
  intro middle _
  exact
    ((contDiff_pi.mp (contDiff_pi.mp firstSmooth row)) middle).mul
      ((contDiff_pi.mp (contDiff_pi.mp secondSmooth middle)) column)

theorem localSpinWeylDualLorentzDerivative_contDiff
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField)
    (direction : LorentzianIndex) :
    ContDiff ℝ ∞ fun point =>
      localSpinWeylDualLorentzDerivative spinField point direction := by
  have fieldEquality :
      (fun point =>
          localSpinWeylDualLorentzDerivative spinField point direction) =
        fun point =>
          fieldDirectionalDerivative
            (localSpinWeylDualLorentzMatrix spinField) point direction := by
    funext point
    exact localSpinWeylDualLorentzDerivative_eq_fieldDirectionalDerivative
      spinField smooth point direction
  rw [fieldEquality]
  exact lorentzMatrixFieldDirectionalDerivative_contDiff
    (localSpinWeylDualLorentzMatrix spinField)
    (localSpinWeylDualLorentzMatrix_contDiff spinField smooth) direction

theorem localSpinHomogeneousGravityMatrix_contDiff
    (spinField : BasePoint → SpinPlus13)
    (configuration : StageNineHolonomicConfiguration)
    (spinSmooth : LocalSpinFieldSmooth spinField)
    (connectionSmooth : GravityConnectionSmooth configuration)
    (direction : LorentzianIndex) :
    ContDiff ℝ ∞ fun point =>
      localSpinHomogeneousGravityMatrix spinField configuration point
        direction := by
  have leftSmooth := localSpinWeylDualLorentzMatrix_contDiff
    spinField spinSmooth
  have connectionMatrixSmooth := rawGravityConnectionMatrix_contDiff
    configuration connectionSmooth direction
  have inverseSmooth := localSpinWeylDualLorentzInverseMatrix_contDiff
    spinField spinSmooth
  exact lorentzMatrixField_mul_contDiff
    (fun point =>
      localSpinWeylDualLorentzMatrix spinField point *
        rawGravityConnectionMatrix configuration point direction)
    (localSpinWeylDualLorentzInverseMatrix spinField)
    (lorentzMatrixField_mul_contDiff _ _ leftSmooth connectionMatrixSmooth)
    inverseSmooth

theorem localSpinMaurerGravityMatrix_contDiff
    (spinField : BasePoint → SpinPlus13)
    (spinSmooth : LocalSpinFieldSmooth spinField)
    (direction : LorentzianIndex) :
    ContDiff ℝ ∞ fun point =>
      localSpinMaurerGravityMatrix spinField point direction := by
  exact lorentzMatrixField_mul_contDiff _ _
    (localSpinWeylDualLorentzDerivative_contDiff spinField spinSmooth direction)
    (localSpinWeylDualLorentzInverseMatrix_contDiff spinField spinSmooth)

/-- The raw matrix written by the primitive action is exactly its generated
homogeneous leg minus its generated Maurer leg. -/
theorem rawGravityConnectionMatrix_localSpinAction
    (spinField : BasePoint → SpinPlus13)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) (direction : LorentzianIndex) :
    rawGravityConnectionMatrix
        (localSpinDiracKineticAction spinField configuration)
        point direction =
      localSpinHomogeneousGravityMatrix spinField configuration point
          direction -
        localSpinMaurerGravityMatrix spinField point direction := by
  rfl

/-- Smoothness of the transformed primitive connection is generated from the
same smooth Spin field and the original primitive connection. -/
theorem localSpinDiracKineticAction_gravityConnectionSmooth
    (spinField : BasePoint → SpinPlus13)
    (configuration : StageNineHolonomicConfiguration)
    (spinSmooth : LocalSpinFieldSmooth spinField)
    (connectionSmooth : GravityConnectionSmooth configuration) :
    GravityConnectionSmooth
      (localSpinDiracKineticAction spinField configuration) := by
  intro direction internalOut internalIn
  have matrixSmooth : ContDiff ℝ ∞ fun point =>
      localSpinHomogeneousGravityMatrix spinField configuration point
          direction -
        localSpinMaurerGravityMatrix spinField point direction :=
    (localSpinHomogeneousGravityMatrix_contDiff spinField configuration
      spinSmooth connectionSmooth direction).sub
      (localSpinMaurerGravityMatrix_contDiff spinField spinSmooth direction)
  have entrySmooth :=
    (lorentzMatrixEntryCLM internalOut internalIn).contDiff.comp matrixSmooth
  have fieldEquality :
      (fun point =>
        (localSpinDiracKineticAction spinField configuration).gravityConnection
          point direction internalOut internalIn) =
      fun point =>
        (localSpinHomogeneousGravityMatrix spinField configuration point
            direction -
          localSpinMaurerGravityMatrix spinField point direction)
            internalOut internalIn := by
    funext point
    exact congrFun
      (congrFun
        (rawGravityConnectionMatrix_localSpinAction spinField configuration
          point direction) internalOut) internalIn
  rw [fieldEquality]
  exact entrySmooth

/-! ## Flatness of the generated Maurer leg -/

/-- The right Maurer leg is flat with the sign convention forced by the
primitive connection write `H - M`. -/
theorem localSpinMaurerGravityMatrix_flat
    (spinField : BasePoint → SpinPlus13)
    (spinSmooth : LocalSpinFieldSmooth spinField)
    (point : BasePoint) (first second : LorentzianIndex) :
    fieldDirectionalDerivative
        (fun candidate =>
          localSpinMaurerGravityMatrix spinField candidate second)
        point first -
      fieldDirectionalDerivative
        (fun candidate =>
          localSpinMaurerGravityMatrix spinField candidate first)
        point second =
      localSpinMaurerGravityMatrix spinField point first *
          localSpinMaurerGravityMatrix spinField point second -
        localSpinMaurerGravityMatrix spinField point second *
          localSpinMaurerGravityMatrix spinField point first := by
  let derivativeField (direction : LorentzianIndex) :
      BasePoint → LorentzianCoframe := fun candidate =>
    localSpinWeylDualLorentzDerivative spinField candidate direction
  let inverseField : BasePoint → LorentzianCoframe :=
    localSpinWeylDualLorentzInverseMatrix spinField
  have inverseSmooth : ContDiff ℝ ∞ inverseField :=
    localSpinWeylDualLorentzInverseMatrix_contDiff spinField spinSmooth
  have derivativeSmooth (direction : LorentzianIndex) :
      ContDiff ℝ ∞ (derivativeField direction) :=
    localSpinWeylDualLorentzDerivative_contDiff spinField spinSmooth direction
  have firstProduct := fieldDirectionalDerivative_lorentzMatrix_mul
    (derivativeField second) inverseField (derivativeSmooth second)
      inverseSmooth point first
  have secondProduct := fieldDirectionalDerivative_lorentzMatrix_mul
    (derivativeField first) inverseField (derivativeSmooth first)
      inverseSmooth point second
  have mixed :
      fieldDirectionalDerivative (derivativeField second) point first =
        fieldDirectionalDerivative (derivativeField first) point second := by
    have secondEquality : derivativeField second = fun candidate =>
        fieldDirectionalDerivative
          (localSpinWeylDualLorentzMatrix spinField) candidate second := by
      funext candidate
      exact localSpinWeylDualLorentzDerivative_eq_fieldDirectionalDerivative
        spinField spinSmooth candidate second
    have firstEquality : derivativeField first = fun candidate =>
        fieldDirectionalDerivative
          (localSpinWeylDualLorentzMatrix spinField) candidate first := by
      funext candidate
      exact localSpinWeylDualLorentzDerivative_eq_fieldDirectionalDerivative
        spinField spinSmooth candidate first
    rw [secondEquality, firstEquality]
    exact mixedLorentzMatrixFieldDirectionalDerivative_comm
      (localSpinWeylDualLorentzMatrix spinField)
      (localSpinWeylDualLorentzMatrix_contDiff spinField spinSmooth)
      point second first
  have inverseFirst := localSpinWeylDualLorentzInverseDerivative
    spinField spinSmooth point first
  have inverseSecond := localSpinWeylDualLorentzInverseDerivative
    spinField spinSmooth point second
  have firstDerivativeReadout :=
    localSpinWeylDualLorentzDerivative_eq_fieldDirectionalDerivative
      spinField spinSmooth point first
  have secondDerivativeReadout :=
    localSpinWeylDualLorentzDerivative_eq_fieldDirectionalDerivative
      spinField spinSmooth point second
  change
    fieldDirectionalDerivative
        (fun candidate => derivativeField second candidate *
          inverseField candidate) point first -
      fieldDirectionalDerivative
        (fun candidate => derivativeField first candidate *
          inverseField candidate) point second = _
  rw [firstProduct, secondProduct, inverseFirst, inverseSecond,
    ← firstDerivativeReadout, ← secondDerivativeReadout, mixed]
  unfold localSpinMaurerGravityMatrix derivativeField inverseField
  noncomm_ring

/-! ## Differentiating the generated homogeneous leg -/

/-- Derivative of the homogeneous connection leg expressed through the same
Maurer matrix and the derivative of the original primitive connection. -/
theorem localSpinHomogeneousGravityMatrix_derivative
    (spinField : BasePoint → SpinPlus13)
    (configuration : StageNineHolonomicConfiguration)
    (spinSmooth : LocalSpinFieldSmooth spinField)
    (connectionSmooth : GravityConnectionSmooth configuration)
    (point : BasePoint)
    (derivativeDirection formDirection : LorentzianIndex) :
    fieldDirectionalDerivative
        (fun candidate =>
          localSpinHomogeneousGravityMatrix spinField configuration
            candidate formDirection)
        point derivativeDirection =
      localSpinMaurerGravityMatrix spinField point derivativeDirection *
          localSpinHomogeneousGravityMatrix spinField configuration point
            formDirection +
        localSpinWeylDualLorentzMatrix spinField point *
            fieldDirectionalDerivative
              (fun candidate =>
                rawGravityConnectionMatrix configuration candidate
                  formDirection)
              point derivativeDirection *
          localSpinWeylDualLorentzInverseMatrix spinField point -
        localSpinHomogeneousGravityMatrix spinField configuration point
            formDirection *
          localSpinMaurerGravityMatrix spinField point derivativeDirection := by
  let lorentz := localSpinWeylDualLorentzMatrix spinField
  let inverse := localSpinWeylDualLorentzInverseMatrix spinField
  let connection : BasePoint → LorentzianCoframe := fun candidate =>
    rawGravityConnectionMatrix configuration candidate formDirection
  have lorentzSmooth : ContDiff ℝ ∞ lorentz :=
    localSpinWeylDualLorentzMatrix_contDiff spinField spinSmooth
  have inverseSmooth : ContDiff ℝ ∞ inverse :=
    localSpinWeylDualLorentzInverseMatrix_contDiff spinField spinSmooth
  have connectionSmooth' : ContDiff ℝ ∞ connection :=
    rawGravityConnectionMatrix_contDiff configuration connectionSmooth
      formDirection
  have leftProductSmooth : ContDiff ℝ ∞ fun candidate =>
      lorentz candidate * connection candidate :=
    lorentzMatrixField_mul_contDiff lorentz connection
      lorentzSmooth connectionSmooth'
  have outerDerivative := fieldDirectionalDerivative_lorentzMatrix_mul
    (fun candidate => lorentz candidate * connection candidate)
      inverse leftProductSmooth inverseSmooth point derivativeDirection
  have innerDerivative := fieldDirectionalDerivative_lorentzMatrix_mul
    lorentz connection lorentzSmooth connectionSmooth' point
      derivativeDirection
  have inverseDerivative := localSpinWeylDualLorentzInverseDerivative
    spinField spinSmooth point derivativeDirection
  have derivativeReadout :=
    localSpinWeylDualLorentzDerivative_eq_fieldDirectionalDerivative
      spinField spinSmooth point derivativeDirection
  have inverseProduct : inverse point * lorentz point = 1 :=
    localSpinWeylDualLorentzInverse_mul_matrix spinField point
  have derivativeHomogeneous :
      fieldDirectionalDerivative lorentz point derivativeDirection *
            connection point * inverse point =
        localSpinMaurerGravityMatrix spinField point derivativeDirection *
          localSpinHomogeneousGravityMatrix spinField configuration point
            formDirection := by
    unfold localSpinMaurerGravityMatrix
      localSpinHomogeneousGravityMatrix
    change
      fieldDirectionalDerivative lorentz point derivativeDirection *
            connection point * inverse point =
        (localSpinWeylDualLorentzDerivative spinField point
              derivativeDirection * inverse point) *
          (lorentz point * connection point * inverse point)
    rw [derivativeReadout]
    calc
      fieldDirectionalDerivative lorentz point derivativeDirection *
            connection point * inverse point =
          fieldDirectionalDerivative lorentz point derivativeDirection *
            (inverse point * lorentz point) * connection point *
              inverse point := by rw [inverseProduct]; simp
      _ = _ := by noncomm_ring
  change
    fieldDirectionalDerivative
        (fun candidate =>
          (lorentz candidate * connection candidate) * inverse candidate)
        point derivativeDirection = _
  rw [outerDerivative, innerDerivative, inverseDerivative]
  calc
    (fieldDirectionalDerivative lorentz point derivativeDirection *
              connection point +
            lorentz point *
              fieldDirectionalDerivative connection point derivativeDirection) *
          inverse point +
        (lorentz point * connection point) *
          (-inverse point *
              fieldDirectionalDerivative lorentz point derivativeDirection *
            inverse point) =
      fieldDirectionalDerivative lorentz point derivativeDirection *
            connection point * inverse point +
        lorentz point *
            fieldDirectionalDerivative connection point derivativeDirection *
          inverse point -
        (lorentz point * connection point * inverse point) *
          (fieldDirectionalDerivative lorentz point derivativeDirection *
            inverse point) := by noncomm_ring
    _ = _ := by
      rw [derivativeHomogeneous, ← derivativeReadout]
      rfl

/-- Conjugation transports the commutator of the original primitive
connection exactly. -/
theorem localSpinHomogeneousGravityMatrix_commutator
    (spinField : BasePoint → SpinPlus13)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) (first second : LorentzianIndex) :
    localSpinHomogeneousGravityMatrix spinField configuration point first *
          localSpinHomogeneousGravityMatrix spinField configuration point
            second -
        localSpinHomogeneousGravityMatrix spinField configuration point second *
          localSpinHomogeneousGravityMatrix spinField configuration point
            first =
      localSpinWeylDualLorentzMatrix spinField point *
          (rawGravityConnectionMatrix configuration point first *
                rawGravityConnectionMatrix configuration point second -
            rawGravityConnectionMatrix configuration point second *
                rawGravityConnectionMatrix configuration point first) *
        localSpinWeylDualLorentzInverseMatrix spinField point := by
  let lorentz := localSpinWeylDualLorentzMatrix spinField point
  let inverse := localSpinWeylDualLorentzInverseMatrix spinField point
  let firstConnection :=
    rawGravityConnectionMatrix configuration point first
  let secondConnection :=
    rawGravityConnectionMatrix configuration point second
  have inverseProduct : inverse * lorentz = 1 :=
    localSpinWeylDualLorentzInverse_mul_matrix spinField point
  unfold localSpinHomogeneousGravityMatrix
  change
    (lorentz * firstConnection * inverse) *
          (lorentz * secondConnection * inverse) -
        (lorentz * secondConnection * inverse) *
          (lorentz * firstConnection * inverse) =
      lorentz *
          (firstConnection * secondConnection -
            secondConnection * firstConnection) *
        inverse
  calc
    (lorentz * firstConnection * inverse) *
          (lorentz * secondConnection * inverse) -
        (lorentz * secondConnection * inverse) *
          (lorentz * firstConnection * inverse) =
      lorentz * firstConnection * (inverse * lorentz) *
            secondConnection * inverse -
        lorentz * secondConnection * (inverse * lorentz) *
            firstConnection * inverse := by noncomm_ring
    _ =
      lorentz * firstConnection * secondConnection * inverse -
        lorentz * secondConnection * firstConnection * inverse := by
      rw [inverseProduct]
      simp
    _ = _ := by noncomm_ring

/-! ## Primitive curvature producer -/

/-- The full ordered mixed curvature is generated covariantly by the actual
inhomogeneous primitive connection write.  No transformed curvature or
covariance certificate occurs among the premises. -/
theorem orderedMixedCurvature_localSpin_raw_covariant
    (spinField : BasePoint → SpinPlus13)
    (configuration : StageNineHolonomicConfiguration)
    (spinSmooth : LocalSpinFieldSmooth spinField)
    (connectionSmooth : GravityConnectionSmooth configuration)
    (point : BasePoint) (first second : LorentzianIndex) :
    coordinateToRawMatrix
        (orderedMixedCurvature
          (localSpinDiracKineticAction spinField configuration)
          point first second) =
      localSpinWeylDualLorentzMatrix spinField point *
        coordinateToRawMatrix
          (orderedMixedCurvature configuration point first second) *
        localSpinWeylDualLorentzInverseMatrix spinField point := by
  let transformed := localSpinDiracKineticAction spinField configuration
  have transformedSmooth : GravityConnectionSmooth transformed :=
    localSpinDiracKineticAction_gravityConnectionSmooth spinField
      configuration spinSmooth connectionSmooth
  rw [coordinateToRawMatrix_orderedMixedCurvature transformed
      transformedSmooth,
    coordinateToRawMatrix_orderedMixedCurvature configuration
      connectionSmooth]
  have actionFieldEquality (direction : LorentzianIndex) :
      (fun candidate =>
        rawGravityConnectionMatrix transformed candidate direction) =
      fun candidate =>
        localSpinHomogeneousGravityMatrix spinField configuration candidate
            direction -
          localSpinMaurerGravityMatrix spinField candidate direction := by
    funext candidate
    exact rawGravityConnectionMatrix_localSpinAction spinField configuration
      candidate direction
  rw [actionFieldEquality first, actionFieldEquality second]
  rw [fieldDirectionalDerivative_lorentzMatrix_sub
      (fun candidate =>
        localSpinHomogeneousGravityMatrix spinField configuration candidate
          second)
      (fun candidate =>
        localSpinMaurerGravityMatrix spinField candidate second)
      (localSpinHomogeneousGravityMatrix_contDiff spinField configuration
        spinSmooth connectionSmooth second)
      (localSpinMaurerGravityMatrix_contDiff spinField spinSmooth second),
    fieldDirectionalDerivative_lorentzMatrix_sub
      (fun candidate =>
        localSpinHomogeneousGravityMatrix spinField configuration candidate
          first)
      (fun candidate =>
        localSpinMaurerGravityMatrix spinField candidate first)
      (localSpinHomogeneousGravityMatrix_contDiff spinField configuration
        spinSmooth connectionSmooth first)
      (localSpinMaurerGravityMatrix_contDiff spinField spinSmooth first)]
  rw [localSpinHomogeneousGravityMatrix_derivative spinField configuration
      spinSmooth connectionSmooth point first second,
    localSpinHomogeneousGravityMatrix_derivative spinField configuration
      spinSmooth connectionSmooth point second first]
  have maurerFlat := localSpinMaurerGravityMatrix_flat spinField spinSmooth
    point first second
  have homogeneousCommutator :=
    localSpinHomogeneousGravityMatrix_commutator spinField configuration point
      first second
  let lorentz := localSpinWeylDualLorentzMatrix spinField point
  let inverse := localSpinWeylDualLorentzInverseMatrix spinField point
  let firstConnection :=
    rawGravityConnectionMatrix configuration point first
  let secondConnection :=
    rawGravityConnectionMatrix configuration point second
  let firstDerivative :=
    fieldDirectionalDerivative
      (fun candidate =>
        rawGravityConnectionMatrix configuration candidate second)
      point first
  let secondDerivative :=
    fieldDirectionalDerivative
      (fun candidate =>
        rawGravityConnectionMatrix configuration candidate first)
      point second
  let firstHomogeneous :=
    localSpinHomogeneousGravityMatrix spinField configuration point first
  let secondHomogeneous :=
    localSpinHomogeneousGravityMatrix spinField configuration point second
  let firstMaurer :=
    localSpinMaurerGravityMatrix spinField point first
  let secondMaurer :=
    localSpinMaurerGravityMatrix spinField point second
  change
    (firstMaurer * secondHomogeneous + lorentz * firstDerivative * inverse -
          secondHomogeneous * firstMaurer -
        fieldDirectionalDerivative
          (fun candidate =>
            localSpinMaurerGravityMatrix spinField candidate second)
          point first) -
      (secondMaurer * firstHomogeneous + lorentz * secondDerivative * inverse -
          firstHomogeneous * secondMaurer -
        fieldDirectionalDerivative
          (fun candidate =>
            localSpinMaurerGravityMatrix spinField candidate first)
          point second) +
      ((firstHomogeneous - firstMaurer) *
          (secondHomogeneous - secondMaurer) -
        (secondHomogeneous - secondMaurer) *
          (firstHomogeneous - firstMaurer)) =
      lorentz *
        (firstDerivative - secondDerivative +
          (firstConnection * secondConnection -
            secondConnection * firstConnection)) *
        inverse
  have maurerFlat' :
      fieldDirectionalDerivative
          (fun candidate =>
            localSpinMaurerGravityMatrix spinField candidate second)
          point first -
        fieldDirectionalDerivative
          (fun candidate =>
            localSpinMaurerGravityMatrix spinField candidate first)
          point second =
        firstMaurer * secondMaurer - secondMaurer * firstMaurer := by
    exact maurerFlat
  have homogeneousCommutator' :
      firstHomogeneous * secondHomogeneous -
          secondHomogeneous * firstHomogeneous =
        lorentz *
          (firstConnection * secondConnection -
            secondConnection * firstConnection) *
          inverse := by
    exact homogeneousCommutator
  have maurerDerivativeRewrite :
      fieldDirectionalDerivative
          (fun candidate =>
            localSpinMaurerGravityMatrix spinField candidate second)
          point first =
        (firstMaurer * secondMaurer - secondMaurer * firstMaurer) +
          fieldDirectionalDerivative
            (fun candidate =>
              localSpinMaurerGravityMatrix spinField candidate first)
            point second := by
    calc
      fieldDirectionalDerivative
          (fun candidate =>
            localSpinMaurerGravityMatrix spinField candidate second)
          point first =
        (fieldDirectionalDerivative
            (fun candidate =>
              localSpinMaurerGravityMatrix spinField candidate second)
            point first -
          fieldDirectionalDerivative
            (fun candidate =>
              localSpinMaurerGravityMatrix spinField candidate first)
            point second) +
          fieldDirectionalDerivative
            (fun candidate =>
              localSpinMaurerGravityMatrix spinField candidate first)
            point second := by abel
      _ = _ := by rw [maurerFlat']
  calc
    _ = lorentz * (firstDerivative - secondDerivative) * inverse +
          (firstHomogeneous * secondHomogeneous -
            secondHomogeneous * firstHomogeneous) := by
      rw [maurerDerivativeRewrite]
      noncomm_ring
    _ = _ := by
      rw [homogeneousCommutator']
      noncomm_ring

/-- Convenience form for the existing whole-configuration smoothness
credential. -/
theorem orderedMixedCurvature_localSpin_raw_covariant_of_smooth
    (spinField : BasePoint → SpinPlus13)
    (configuration : StageNineHolonomicConfiguration)
    (spinSmooth : LocalSpinFieldSmooth spinField)
    (smooth : configuration.Smooth)
    (point : BasePoint) (first second : LorentzianIndex) :
    coordinateToRawMatrix
        (orderedMixedCurvature
          (localSpinDiracKineticAction spinField configuration)
          point first second) =
      localSpinWeylDualLorentzMatrix spinField point *
        coordinateToRawMatrix
          (orderedMixedCurvature configuration point first second) *
        localSpinWeylDualLorentzInverseMatrix spinField point :=
  orderedMixedCurvature_localSpin_raw_covariant spinField configuration
    spinSmooth (gravityConnectionSmooth_of_smooth configuration smooth)
      point first second

end

