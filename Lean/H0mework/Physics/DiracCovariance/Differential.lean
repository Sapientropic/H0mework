import H0mework.Physics.DiracCovariance.Connection
import H0mework.Physics.Dirac.DiracMatterCoordinateCalculus

/-!
# Differential generated by an actual local Spin field

The primitive input is a pointwise `SL(2,C)` field with componentwise
smooth ambient matrix.  Its Dirac matrix, its directional derivative, and
the product derivative on the existing matter carrier are all derived from
that same field.  In particular, no `dS`, transformed matter jet, Maurer
matrix, or covariance certificate is supplied independently.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracKineticLocalSpinDifferential

open DiracCliffordRepresentation
open DiracExteriorMatterAction
open ProofFreeRicherAnholonomicSource
open StageNineDiracKineticLocalSpinConnection
open StageNineDiracMatterCoordinateCalculus
open StageNineGlobalBundle
open StageNineHolonomicField
open StageNineSpinMatterBundle

open scoped ContDiff MatrixGroups Matrix.Norms.Elementwise

noncomputable section

set_option autoImplicit false

/-- Smoothness jurisdiction for a primitive local Spin field, stated only on
its ambient `2 x 2` matrix entries. -/
def LocalSpinFieldSmooth (spinField : BasePoint → SpinPlus13) : Prop :=
  ∀ row column,
    ContDiff ℝ ∞ fun point =>
      ((spinField point : SpinPlus13) : Matrix (Fin 2) (Fin 2) ℂ)
        row column

/-- The actual Dirac representation matrix generated pointwise from the
primitive local Spin field. -/
def localSpinDiracMatrixField
    (spinField : BasePoint → SpinPlus13) (point : BasePoint) : DiracMatrix :=
  spinDiracMatrix (spinField point)

/-- Directional derivative of the generated Dirac matrix. -/
def localSpinDiracMatrixDerivative
    (spinField : BasePoint → SpinPlus13)
    (point : BasePoint) (direction : LorentzianIndex) : DiracMatrix :=
  fieldDirectionalDerivative (localSpinDiracMatrixField spinField)
    point direction

/-- Ambient smoothness of the primitive `SL(2,C)` field generates smoothness
of its fixed Stage-7 Dirac representation. -/
theorem localSpinDiracMatrixField_contDiff
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField) :
    ContDiff ℝ ∞ (localSpinDiracMatrixField spinField) := by
  apply contDiff_pi'
  intro row
  apply contDiff_pi'
  intro column
  change ContDiff ℝ ∞ fun point =>
    weylDiracBlockMatrix (spinField point)
      ((finSumFinEquiv : (Fin 2 ⊕ Fin 2) ≃ Fin 4).symm row)
      ((finSumFinEquiv : (Fin 2 ⊕ Fin 2) ≃ Fin 4).symm column)
  generalize
    ((finSumFinEquiv : (Fin 2 ⊕ Fin 2) ≃ Fin 4).symm row) = blockRow
  generalize
    ((finSumFinEquiv : (Fin 2 ⊕ Fin 2) ≃ Fin 4).symm column) = blockColumn
  rcases blockRow with blockRow | blockRow <;>
    rcases blockColumn with blockColumn | blockColumn
  · simpa [weylDiracBlockMatrix] using smooth blockRow blockColumn
  · simpa [weylDiracBlockMatrix] using
      (contDiff_const : ContDiff ℝ ∞ (fun _ : BasePoint => (0 : ℂ)))
  · simpa [weylDiracBlockMatrix] using
      (contDiff_const : ContDiff ℝ ∞ (fun _ : BasePoint => (0 : ℂ)))
  · simp only [weylDiracBlockMatrix, Matrix.fromBlocks_apply₂₂]
    unfold rightWeylMatrix
    simp only [Matrix.star_eq_conjTranspose, Matrix.conjTranspose_apply,
      Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]
    fin_cases blockRow <;> fin_cases blockColumn
    · change ContDiff ℝ ∞ fun point =>
        Complex.conjCLE
          (((spinField point : SpinPlus13) : Matrix (Fin 2) (Fin 2) ℂ)
            1 1)
      exact Complex.conjCLE.contDiff.comp (smooth 1 1)
    · change ContDiff ℝ ∞ fun point =>
        Complex.conjCLE
          (-(((spinField point : SpinPlus13) : Matrix (Fin 2) (Fin 2) ℂ)
            1 0))
      exact Complex.conjCLE.contDiff.comp (smooth 1 0).neg
    · change ContDiff ℝ ∞ fun point =>
        Complex.conjCLE
          (-(((spinField point : SpinPlus13) : Matrix (Fin 2) (Fin 2) ℂ)
            0 1))
      exact Complex.conjCLE.contDiff.comp (smooth 0 1).neg
    · change ContDiff ℝ ∞ fun point =>
        Complex.conjCLE
          (((spinField point : SpinPlus13) : Matrix (Fin 2) (Fin 2) ℂ)
            0 0)
      exact Complex.conjCLE.contDiff.comp (smooth 0 0)

/-- The generated local-Spin matter field is smooth in the existing faithful
coordinate carrier. -/
theorem localSpinMatterCoordinate_contDiff
    (spinField : BasePoint → SpinPlus13)
    (matter : BasePoint → DiracExteriorMatterCarrier)
    (spinSmooth : LocalSpinFieldSmooth spinField)
    (matterSmooth : ContDiff ℝ ∞ fun point =>
      matterCoordinateEquiv (matter point)) :
    ContDiff ℝ ∞ fun point =>
      matterCoordinateEquiv
        (spinDiracMatterRepresentation (spinField point) (matter point)) := by
  have matrixSmooth :=
    localSpinDiracMatrixField_contDiff spinField spinSmooth
  have actual :=
    (diracMatrixMatterCoordinateRealBilinear.toContinuousBilinearMap.contDiff.comp
      matrixSmooth).clm_apply matterSmooth
  change ContDiff ℝ ∞ fun point =>
    diracMatrixMatterCoordinateRealBilinear
      (localSpinDiracMatrixField spinField point)
      (matterCoordinateEquiv (matter point)) at actual
  change ContDiff ℝ ∞ fun point =>
    matterCoordinateEquiv
      (diracMatrixMatterAction (spinDiracMatrix (spinField point))
        (matter point))
  simpa only [localSpinDiracMatrixField,
    diracMatrixMatterCoordinateRealBilinear_apply,
    matterCoordinateEquiv.symm_apply_apply] using actual

/-- Actual product rule for local Spin matter transport.  Both derivative
terms are read from the same primitive `spinField` and `matter` fields. -/
theorem fieldDirectionalDerivative_localSpinMatterAction
    (spinField : BasePoint → SpinPlus13)
    (matter : BasePoint → DiracExteriorMatterCarrier)
    (spinSmooth : LocalSpinFieldSmooth spinField)
    (matterSmooth : ContDiff ℝ ∞ fun point =>
      matterCoordinateEquiv (matter point))
    (point : BasePoint) (direction : LorentzianIndex) :
    matterCoordinateEquiv.symm
        (fieldDirectionalDerivative
          (fun candidate =>
            matterCoordinateEquiv
              (spinDiracMatterRepresentation (spinField candidate)
                (matter candidate)))
          point direction) =
      spinDiracMatterRepresentation (spinField point)
          (matterCoordinateEquiv.symm
            (fieldDirectionalDerivative
              (fun candidate => matterCoordinateEquiv (matter candidate))
              point direction)) +
        diracMatrixMatterAction
          (localSpinDiracMatrixDerivative spinField point direction)
          (matter point) := by
  have productDerivative :=
    fieldDirectionalDerivative_diracMatrixMatterCoordinate
      (localSpinDiracMatrixField spinField)
      (fun candidate => matterCoordinateEquiv (matter candidate))
      (localSpinDiracMatrixField_contDiff spinField spinSmooth)
      matterSmooth point direction
  apply matterCoordinateEquiv.injective
  simp only [map_add, matterCoordinateEquiv.apply_symm_apply]
  rw [show
    (fun candidate =>
      matterCoordinateEquiv
        (spinDiracMatterRepresentation (spinField candidate)
          (matter candidate))) =
      (fun candidate =>
        diracMatrixMatterCoordinateRealBilinear
          (localSpinDiracMatrixField spinField candidate)
          (matterCoordinateEquiv (matter candidate))) by
    funext candidate
    simp only [diracMatrixMatterCoordinateRealBilinear_apply,
      matterCoordinateEquiv.symm_apply_apply]
    rfl]
  rw [productDerivative]
  simp only [diracMatrixMatterCoordinateRealBilinear_apply,
    matterCoordinateEquiv.symm_apply_apply]
  change
    matterCoordinateEquiv
        (diracMatrixMatterAction
          (fieldDirectionalDerivative
            (localSpinDiracMatrixField spinField) point direction)
          (matter point)) +
      matterCoordinateEquiv
        (diracMatrixMatterAction
          (localSpinDiracMatrixField spinField point)
          (matterCoordinateEquiv.symm
            (fieldDirectionalDerivative
              (fun candidate => matterCoordinateEquiv (matter candidate))
              point direction))) =
    matterCoordinateEquiv
        (diracMatrixMatterAction
          (localSpinDiracMatrixField spinField point)
          (matterCoordinateEquiv.symm
            (fieldDirectionalDerivative
              (fun candidate => matterCoordinateEquiv (matter candidate))
              point direction))) +
      matterCoordinateEquiv
        (diracMatrixMatterAction
          (fieldDirectionalDerivative
            (localSpinDiracMatrixField spinField) point direction)
          (matter point))
  abel

end

end
  SaturationMonoid.PhysicsCore.StageNineDiracKineticLocalSpinDifferential
