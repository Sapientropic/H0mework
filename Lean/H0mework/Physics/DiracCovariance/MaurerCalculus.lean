/-!
# Maurer calculus generated by one local Spin field

The pointwise normalization

`h(x) = g(x) * g(p)⁻¹`

turns the right Maurer derivatives of the actual finite Dirac and Lorentz
representations into ordinary derivatives at `p`.  This file derives the
needed smoothness and product rules from the componentwise smooth primitive
field.  It does not accept a Dirac derivative, Lorentz derivative, Maurer
matrix, connection, or covariance certificate as an independent input.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracKineticLocalSpinMaurerCalculus

open DiracCliffordRepresentation
open ProofFreeRicherAnholonomicSource
open StageNineDiracKineticLocalSpinConnection
open StageNineDiracKineticLocalSpinDifferential
open StageNineDiracKineticLocalSpinLiftCovariance
open StageNineDiracKineticSpinJurisdiction
open StageNineDiracMatterCoordinateCalculus
open StageNineGlobalBundle
open StageNineHolonomicField
open StageNineLorentzCoverAndSpinDescent
open StageNinePhysicalBivectorSpinRepresentation
open StageNineSpinMatterBundle

open scoped ContDiff MatrixGroups Matrix.Norms.Elementwise

noncomputable section

set_option autoImplicit false

/-- Directional chain rule for a continuous linear readout of an actual
smooth field. -/
theorem fieldDirectionalDerivative_continuousLinear
    {V W : Type*}
    [NormedAddCommGroup V] [NormedSpace ℝ V]
    [NormedAddCommGroup W] [NormedSpace ℝ W]
    (linear : V →L[ℝ] W) (field : BasePoint → V)
    (fieldSmooth : ContDiff ℝ ∞ field)
    (point : BasePoint) (direction : LorentzianIndex) :
    fieldDirectionalDerivative (fun candidate => linear (field candidate))
        point direction =
      linear (fieldDirectionalDerivative field point direction) := by
  have differentiable : DifferentiableAt ℝ field point :=
    (fieldSmooth.differentiable (by simp)).differentiableAt
  have derivativeEquality :=
    (linear.hasFDerivAt.comp point differentiable.hasFDerivAt).fderiv
  have applied := congrArg
    (fun derivative : BasePoint →L[ℝ] W =>
      derivative (coordinateDirection direction)) derivativeEquality
  change
    (fderiv ℝ (fun candidate => linear (field candidate)) point)
        (coordinateDirection direction) =
      linear ((fderiv ℝ field point) (coordinateDirection direction))
      at applied
  exact applied

/-- Directional differentiation commutes with a finite sum of actual smooth
fields. -/
theorem fieldDirectionalDerivative_finset_sum
    {I V : Type*} [DecidableEq I]
    [NormedAddCommGroup V] [NormedSpace ℝ V]
    (indices : Finset I) (field : I → BasePoint → V)
    (fieldSmooth : ∀ index ∈ indices, ContDiff ℝ ∞ (field index))
    (point : BasePoint) (direction : LorentzianIndex) :
    fieldDirectionalDerivative
        (fun candidate => ∑ index ∈ indices, field index candidate)
        point direction =
      ∑ index ∈ indices,
        fieldDirectionalDerivative (field index) point direction := by
  unfold fieldDirectionalDerivative
  rw [fderiv_fun_sum]
  · simp
  · intro index membership
    exact ((fieldSmooth index membership).differentiable
      (by simp)).differentiableAt

/-- Whole-matrix form of the actual Lorentz representation field. -/
def localSpinLorentzMatrixField
    (spinField : BasePoint → SpinPlus13) (point : BasePoint) :
    LorentzianCoframe :=
  spinLorentzMatrix (spinField point)

/-- Componentwise smoothness of the primitive `SL(2,C)` field generates
smoothness of its actual four-vector Lorentz representation. -/
private theorem spinHermitianActionField_contDiff
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField) (vector : BasePoint)
    (output : LorentzianIndex) :
    ContDiff ℝ ∞ fun point =>
      spinHermitianAction (spinField point) vector output := by
  let actionMatrix : BasePoint → Matrix (Fin 2) (Fin 2) ℂ :=
    fun point =>
      ((spinField point : SpinPlus13) : Matrix (Fin 2) (Fin 2) ℂ) *
          pauliEncode vector *
        star (((spinField point : SpinPlus13) :
          Matrix (Fin 2) (Fin 2) ℂ))
  have actionEntrySmooth (row column : Fin 2) :
      ContDiff ℝ ∞ fun point => actionMatrix point row column := by
    dsimp only [actionMatrix]
    simp only [Matrix.mul_apply]
    apply ContDiff.sum
    intro middle _
    apply ContDiff.mul
    · apply ContDiff.sum
      intro input _
      exact (smooth row input).mul contDiff_const
    · change ContDiff ℝ ∞ fun point =>
        Complex.conjCLE
          (((spinField point : SpinPlus13) :
            Matrix (Fin 2) (Fin 2) ℂ) column middle)
      exact Complex.conjCLE.contDiff.comp (smooth column middle)
  fin_cases output
  · change ContDiff ℝ ∞ fun point =>
      ((actionMatrix point 0 0 + actionMatrix point 1 1).re) / 2
    exact (Complex.reCLM.contDiff.comp
      ((actionEntrySmooth 0 0).add (actionEntrySmooth 1 1))).div_const 2
  · change ContDiff ℝ ∞ fun point =>
      ((actionMatrix point 0 1 + actionMatrix point 1 0).re) / 2
    exact (Complex.reCLM.contDiff.comp
      ((actionEntrySmooth 0 1).add (actionEntrySmooth 1 0))).div_const 2
  · change ContDiff ℝ ∞ fun point =>
      ((actionMatrix point 1 0 - actionMatrix point 0 1).im) / 2
    exact (Complex.imCLM.contDiff.comp
      ((actionEntrySmooth 1 0).sub (actionEntrySmooth 0 1))).div_const 2
  · change ContDiff ℝ ∞ fun point =>
      ((actionMatrix point 0 0 - actionMatrix point 1 1).re) / 2
    exact (Complex.reCLM.contDiff.comp
      ((actionEntrySmooth 0 0).sub (actionEntrySmooth 1 1))).div_const 2

theorem localSpinLorentzMatrixField_contDiff
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField) :
    ContDiff ℝ ∞ (localSpinLorentzMatrixField spinField) := by
  apply contDiff_pi'
  intro row
  apply contDiff_pi'
  intro column
  change ContDiff ℝ ∞ fun point =>
    spinHermitianAction (spinField point)
      (EuclideanSpace.single column 1) row
  exact spinHermitianActionField_contDiff spinField smooth
    (EuclideanSpace.single column 1) row

/-- The fixed Weyl-dual involution preserves the primitive smooth-field
jurisdiction; no inverse-field differentiability premise is added. -/
theorem localSpinWeylDualField_smooth
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField) :
    LocalSpinFieldSmooth fun point => spinWeylDual (spinField point) := by
  intro row column
  change ContDiff ℝ ∞ fun point =>
    rightWeylMatrix (spinField point) row column
  unfold rightWeylMatrix
  simp only [Matrix.star_eq_conjTranspose, Matrix.conjTranspose_apply,
    Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]
  fin_cases row <;> fin_cases column
  · exact Complex.conjCLE.contDiff.comp (smooth 1 1)
  · exact Complex.conjCLE.contDiff.comp (smooth 1 0).neg
  · exact Complex.conjCLE.contDiff.comp (smooth 0 1).neg
  · exact Complex.conjCLE.contDiff.comp (smooth 0 0)

/-- Smoothness of the exact Weyl-dual Lorentz matrix written by the local
Spin action. -/
theorem localSpinWeylDualLorentzMatrix_contDiff
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField) :
    ContDiff ℝ ∞ (localSpinWeylDualLorentzMatrix spinField) := by
  exact localSpinLorentzMatrixField_contDiff
    (fun point => spinWeylDual (spinField point))
    (localSpinWeylDualField_smooth spinField smooth)

/-- Continuous coordinate readout for the exact elementwise matrix norm used
by the Lorentz carrier. -/
def lorentzMatrixEntryCLM (row column : LorentzianIndex) :
    LorentzianCoframe →L[ℝ] ℝ :=
  (ContinuousLinearMap.proj column :
      (LorentzianIndex → ℝ) →L[ℝ] ℝ).comp
    (ContinuousLinearMap.proj row :
      LorentzianCoframe →L[ℝ] (LorentzianIndex → ℝ))

@[simp] theorem lorentzMatrixEntryCLM_apply
    (row column : LorentzianIndex) (matrix : LorentzianCoframe) :
    lorentzMatrixEntryCLM row column matrix = matrix row column :=
  rfl

/-- Entrywise seam between the historical component derivative and the
continuous coordinate readout of the generated whole matrix derivative. -/
theorem localSpinWeylDualLorentzDerivative_entry
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField)
    (point : BasePoint) (direction row column : LorentzianIndex) :
    localSpinWeylDualLorentzDerivative spinField point direction row column =
      lorentzMatrixEntryCLM row column
        (fieldDirectionalDerivative
          (localSpinWeylDualLorentzMatrix spinField) point direction) := by
  have matrixDifferentiable : DifferentiableAt ℝ
      (localSpinWeylDualLorentzMatrix spinField) point :=
    ((localSpinWeylDualLorentzMatrix_contDiff spinField smooth).differentiable
      (by simp)).differentiableAt
  have derivativeEquality :=
    ((lorentzMatrixEntryCLM row column).hasFDerivAt.comp point
      matrixDifferentiable.hasFDerivAt).fderiv
  have applied := congrArg
    (fun derivative : BasePoint →L[ℝ] ℝ =>
      derivative (coordinateDirection direction)) derivativeEquality
  change
    (fderiv ℝ
        (fun candidate =>
          localSpinWeylDualLorentzMatrix spinField candidate row column)
        point) (coordinateDirection direction) =
      lorentzMatrixEntryCLM row column
        ((fderiv ℝ (localSpinWeylDualLorentzMatrix spinField) point)
          (coordinateDirection direction)) at applied
  exact applied

/-- The historical componentwise Lorentz derivative is exactly the
Fréchet derivative of the generated whole matrix field. -/
theorem localSpinWeylDualLorentzDerivative_eq_fieldDirectionalDerivative
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField)
    (point : BasePoint) (direction : LorentzianIndex) :
    localSpinWeylDualLorentzDerivative spinField point direction =
      fieldDirectionalDerivative
        (localSpinWeylDualLorentzMatrix spinField) point direction := by
  funext row column
  exact (localSpinWeylDualLorentzDerivative_entry spinField smooth point
    direction row column).trans
      (lorentzMatrixEntryCLM_apply row column
        (fieldDirectionalDerivative
          (localSpinWeylDualLorentzMatrix spinField) point direction))

/-- Normalize an actual local Spin field at a selected point.  The selected
value is read from the same field, not supplied as a branch choice. -/
def normalizedLocalSpinField
    (spinField : BasePoint → SpinPlus13) (point : BasePoint) :
    BasePoint → SpinPlus13 :=
  fun candidate => spinField candidate * (spinField point)⁻¹

@[simp] theorem normalizedLocalSpinField_at_point
    (spinField : BasePoint → SpinPlus13) (point : BasePoint) :
    normalizedLocalSpinField spinField point point = 1 := by
  simp [normalizedLocalSpinField]

/-- Point normalization preserves the primitive componentwise smoothness. -/
theorem normalizedLocalSpinField_smooth
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField) (point : BasePoint) :
    LocalSpinFieldSmooth (normalizedLocalSpinField spinField point) := by
  intro row column
  change ContDiff ℝ ∞ fun candidate =>
    ((((spinField candidate : SpinPlus13) : Matrix (Fin 2) (Fin 2) ℂ) *
      (((spinField point)⁻¹ : SpinPlus13) :
        Matrix (Fin 2) (Fin 2) ℂ)) row column)
  simp only [Matrix.mul_apply]
  apply ContDiff.sum
  intro inner _
  exact (smooth row inner).mul contDiff_const

/-! ## Ambient matrix and trace calculus for the normalized Spin tangent -/

/-- Ambient `2 x 2` matrix field underlying the same primitive local Spin
field.  This is a faithful readout, not an independently supplied Lie-algebra
field. -/
def localSpinAmbientMatrixField
    (spinField : BasePoint → SpinPlus13) (point : BasePoint) :
    Matrix (Fin 2) (Fin 2) ℂ :=
  ((spinField point : SpinPlus13) : Matrix (Fin 2) (Fin 2) ℂ)

theorem localSpinAmbientMatrixField_contDiff
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField) :
    ContDiff ℝ ∞ (localSpinAmbientMatrixField spinField) := by
  apply contDiff_pi'
  intro row
  apply contDiff_pi'
  intro column
  exact smooth row column

/-- Continuous coordinate readout for the actual ambient `SL(2,ℂ)` matrix
norm. -/
def spinAmbientMatrixEntryCLM (row column : Fin 2) :
    Matrix (Fin 2) (Fin 2) ℂ →L[ℝ] ℂ :=
  (ContinuousLinearMap.proj column :
      (Fin 2 → ℂ) →L[ℝ] ℂ).comp
    (ContinuousLinearMap.proj row :
      Matrix (Fin 2) (Fin 2) ℂ →L[ℝ] (Fin 2 → ℂ))

@[simp] theorem spinAmbientMatrixEntryCLM_apply
    (row column : Fin 2) (matrix : Matrix (Fin 2) (Fin 2) ℂ) :
    spinAmbientMatrixEntryCLM row column matrix = matrix row column :=
  rfl

/-- Continuous coordinate readout for the actual Dirac matrix norm. -/
def diracMatrixEntryCLM (row column : DiracSpinorIndex) :
    DiracMatrix →L[ℝ] ℂ :=
  (ContinuousLinearMap.proj column :
      (DiracSpinorIndex → ℂ) →L[ℝ] ℂ).comp
    (ContinuousLinearMap.proj row :
      DiracMatrix →L[ℝ] (DiracSpinorIndex → ℂ))

@[simp] theorem diracMatrixEntryCLM_apply
    (row column : DiracSpinorIndex) (matrix : DiracMatrix) :
    diracMatrixEntryCLM row column matrix = matrix row column :=
  rfl

/-- Trace as a continuous real-linear readout of the ambient Spin matrix. -/
def spinAmbientMatrixTraceCLM :
    Matrix (Fin 2) (Fin 2) ℂ →L[ℝ] ℂ :=
  ∑ index : Fin 2, spinAmbientMatrixEntryCLM index index

@[simp] theorem spinAmbientMatrixTraceCLM_apply
    (matrix : Matrix (Fin 2) (Fin 2) ℂ) :
    spinAmbientMatrixTraceCLM matrix = Matrix.trace matrix := by
  simp [spinAmbientMatrixTraceCLM, Matrix.trace]

/-- Trace as a continuous real-linear readout of the Dirac matrix. -/
def diracMatrixTraceCLM : DiracMatrix →L[ℝ] ℂ :=
  ∑ index : DiracSpinorIndex, diracMatrixEntryCLM index index

@[simp] theorem diracMatrixTraceCLM_apply (matrix : DiracMatrix) :
    diracMatrixTraceCLM matrix = Matrix.trace matrix := by
  simp [diracMatrixTraceCLM, Matrix.trace]

/-- Complex multiplication, regarded as the continuous real-bilinear map
appropriate for the real Fréchet derivative on the base. -/
def complexMulRealBilinear : ℂ →ₗ[ℝ] ℂ →ₗ[ℝ] ℂ :=
  LinearMap.mul ℝ ℂ

@[simp] theorem complexMulRealBilinear_continuous_apply
    (first second : ℂ) :
    complexMulRealBilinear.toContinuousBilinearMap first second =
      first * second :=
  rfl

/-- The tangent of the point-normalized primitive `SL(2,ℂ)` field is
traceless.  This is derived by differentiating the determinant-one law at
the generated identity value; no Lie-algebra membership receipt is supplied. -/
theorem normalizedLocalSpinAmbientDerivative_trace_eq_zero
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField)
    (point : BasePoint) (direction : LorentzianIndex) :
    Matrix.trace
        (fieldDirectionalDerivative
          (localSpinAmbientMatrixField
            (normalizedLocalSpinField spinField point)) point direction) =
      0 := by
  let normalized := normalizedLocalSpinField spinField point
  let ambientField := localSpinAmbientMatrixField normalized
  let a : BasePoint → ℂ := fun candidate => ambientField candidate 0 0
  let b : BasePoint → ℂ := fun candidate => ambientField candidate 0 1
  let c : BasePoint → ℂ := fun candidate => ambientField candidate 1 0
  let d : BasePoint → ℂ := fun candidate => ambientField candidate 1 1
  have normalizedSmooth :=
    normalizedLocalSpinField_smooth spinField smooth point
  have ambientSmooth : ContDiff ℝ ∞ ambientField :=
    localSpinAmbientMatrixField_contDiff normalized normalizedSmooth
  have aSmooth : ContDiff ℝ ∞ a := by
    exact (spinAmbientMatrixEntryCLM 0 0).contDiff.comp ambientSmooth
  have bSmooth : ContDiff ℝ ∞ b := by
    exact (spinAmbientMatrixEntryCLM 0 1).contDiff.comp ambientSmooth
  have cSmooth : ContDiff ℝ ∞ c := by
    exact (spinAmbientMatrixEntryCLM 1 0).contDiff.comp ambientSmooth
  have dSmooth : ContDiff ℝ ∞ d := by
    exact (spinAmbientMatrixEntryCLM 1 1).contDiff.comp ambientSmooth
  have adDerivative :=
    fieldDirectionalDerivative_continuousBilinear
      complexMulRealBilinear.toContinuousBilinearMap
      a d aSmooth dSmooth point direction
  change
    fieldDirectionalDerivative (fun candidate => a candidate * d candidate)
        point direction =
      fieldDirectionalDerivative a point direction * d point +
        a point * fieldDirectionalDerivative d point direction
      at adDerivative
  have bcDerivative :=
    fieldDirectionalDerivative_continuousBilinear
      complexMulRealBilinear.toContinuousBilinearMap
      b c bSmooth cSmooth point direction
  change
    fieldDirectionalDerivative (fun candidate => b candidate * c candidate)
        point direction =
      fieldDirectionalDerivative b point direction * c point +
        b point * fieldDirectionalDerivative c point direction
      at bcDerivative
  have adSmooth : ContDiff ℝ ∞ fun candidate => a candidate * d candidate :=
    aSmooth.mul dSmooth
  have bcSmooth : ContDiff ℝ ∞ fun candidate => b candidate * c candidate :=
    bSmooth.mul cSmooth
  have differenceDerivative :
      fieldDirectionalDerivative
          (fun candidate => a candidate * d candidate -
            b candidate * c candidate) point direction =
        fieldDirectionalDerivative (fun candidate => a candidate * d candidate)
            point direction -
          fieldDirectionalDerivative (fun candidate => b candidate * c candidate)
            point direction := by
    unfold fieldDirectionalDerivative
    change
      (fderiv ℝ
          ((fun candidate => a candidate * d candidate) -
            (fun candidate => b candidate * c candidate)) point)
          (coordinateDirection direction) = _
    rw [fderiv_sub
      ((adSmooth.differentiable (by simp)).differentiableAt)
      ((bcSmooth.differentiable (by simp)).differentiableAt)]
    rfl
  have determinantIdentity :
      (fun candidate => a candidate * d candidate -
        b candidate * c candidate) =
      (fun _ : BasePoint => (1 : ℂ)) := by
    funext candidate
    have determinantOne := (normalized candidate).property
    simpa only [a, b, c, d, ambientField, localSpinAmbientMatrixField,
      Matrix.det_fin_two] using determinantOne
  have determinantDerivative := congrArg
    (fun field : BasePoint → ℂ =>
      fieldDirectionalDerivative field point direction) determinantIdentity
  rw [differenceDerivative, adDerivative, bcDerivative] at determinantDerivative
  have normalizedValue : normalized point = 1 := by
    exact normalizedLocalSpinField_at_point spinField point
  have aValue : a point = 1 := by
    simp [a, ambientField, localSpinAmbientMatrixField, normalizedValue]
  have bValue : b point = 0 := by
    simp [b, ambientField, localSpinAmbientMatrixField, normalizedValue]
  have cValue : c point = 0 := by
    simp [c, ambientField, localSpinAmbientMatrixField, normalizedValue]
  have dValue : d point = 1 := by
    simp [d, ambientField, localSpinAmbientMatrixField, normalizedValue]
  have upperTraceDerivative :
      fieldDirectionalDerivative a point direction +
          fieldDirectionalDerivative d point direction = 0 := by
    simpa [fieldDirectionalDerivative, aValue, bValue, cValue, dValue] using
      determinantDerivative
  have traceAddDerivative :
      fieldDirectionalDerivative
          (fun candidate => Matrix.trace (ambientField candidate))
          point direction =
        fieldDirectionalDerivative a point direction +
          fieldDirectionalDerivative d point direction := by
    unfold fieldDirectionalDerivative
    rw [show (fun candidate => Matrix.trace (ambientField candidate)) =
        (fun candidate => a candidate + d candidate) by
      funext candidate
      simp [a, d, Matrix.trace_fin_two]]
    change
      (fderiv ℝ (a + d) point) (coordinateDirection direction) = _
    rw [fderiv_add
      ((aSmooth.differentiable (by simp)).differentiableAt)
      ((dSmooth.differentiable (by simp)).differentiableAt)]
    rfl
  have traceReadout :=
    fieldDirectionalDerivative_continuousLinear
      spinAmbientMatrixTraceCLM ambientField ambientSmooth point direction
  change
    fieldDirectionalDerivative
        (fun candidate => Matrix.trace (ambientField candidate)) point direction =
      Matrix.trace (fieldDirectionalDerivative ambientField point direction)
      at traceReadout
  exact traceReadout.symm.trans (traceAddDerivative.trans upperTraceDerivative)

/-- Real-bilinear square-matrix multiplication on the Dirac carrier. -/
def diracMatrixRealMulBilinear :
    DiracMatrix →ₗ[ℝ] DiracMatrix →ₗ[ℝ] DiracMatrix :=
  mulLinearMap ℝ

@[simp] theorem diracMatrixRealMulBilinear_continuous_apply
    (first second : DiracMatrix) :
    diracMatrixRealMulBilinear.toContinuousBilinearMap first second =
      first * second :=
  rfl

/-- Product rule specialized to the exact Dirac matrix norm instance. -/
theorem fieldDirectionalDerivative_diracMatrix_mul
    (first second : BasePoint → DiracMatrix)
    (firstSmooth : ContDiff ℝ ∞ first)
    (secondSmooth : ContDiff ℝ ∞ second)
    (point : BasePoint) (direction : LorentzianIndex) :
    fieldDirectionalDerivative
        (fun candidate => first candidate * second candidate) point direction =
      fieldDirectionalDerivative first point direction * second point +
        first point * fieldDirectionalDerivative second point direction := by
  have actual := fieldDirectionalDerivative_continuousBilinear
    diracMatrixRealMulBilinear.toContinuousBilinearMap
    first second firstSmooth secondSmooth point direction
  change
    fieldDirectionalDerivative
        (fun candidate => first candidate * second candidate) point direction =
      fieldDirectionalDerivative first point direction * second point +
        first point * fieldDirectionalDerivative second point direction
      at actual
  exact actual

/-- Real-bilinear square-matrix multiplication on the Lorentz carrier. -/
def lorentzMatrixRealMulBilinear :
    LorentzianCoframe →ₗ[ℝ] LorentzianCoframe →ₗ[ℝ]
      LorentzianCoframe :=
  mulLinearMap ℝ

@[simp] theorem lorentzMatrixRealMulBilinear_continuous_apply
    (first second : LorentzianCoframe) :
    lorentzMatrixRealMulBilinear.toContinuousBilinearMap first second =
      first * second :=
  rfl

/-- The normalized Dirac derivative is the right Maurer derivative of the
original generated Dirac matrix field. -/
theorem localSpinDiracMatrixDerivative_normalized
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField)
    (point : BasePoint) (direction : LorentzianIndex) :
    localSpinDiracMatrixDerivative
        (normalizedLocalSpinField spinField point) point direction =
      localSpinDiracMatrixDerivative spinField point direction *
        spinDiracMatrix (spinField point)⁻¹ := by
  have productDerivative :=
    fieldDirectionalDerivative_continuousBilinear
      diracMatrixRealMulBilinear.toContinuousBilinearMap
      (localSpinDiracMatrixField spinField)
      (fun _ : BasePoint => spinDiracMatrix (spinField point)⁻¹)
      (localSpinDiracMatrixField_contDiff spinField smooth)
      contDiff_const point direction
  change
    fieldDirectionalDerivative
        (fun candidate =>
          localSpinDiracMatrixField spinField candidate *
            spinDiracMatrix (spinField point)⁻¹)
        point direction =
      fieldDirectionalDerivative (localSpinDiracMatrixField spinField)
          point direction * spinDiracMatrix (spinField point)⁻¹ +
        localSpinDiracMatrixField spinField point *
          fieldDirectionalDerivative
            (fun _ : BasePoint => spinDiracMatrix (spinField point)⁻¹)
            point direction at productDerivative
  unfold localSpinDiracMatrixDerivative
  rw [show localSpinDiracMatrixField
      (normalizedLocalSpinField spinField point) =
      fun candidate =>
        localSpinDiracMatrixField spinField candidate *
          spinDiracMatrix (spinField point)⁻¹ by
    funext candidate
    simp only [localSpinDiracMatrixField, normalizedLocalSpinField,
      spinDiracMatrix_mul]]
  simpa [localSpinDiracMatrixDerivative,
    fieldDirectionalDerivative] using productDerivative

/-- The normalized Weyl-dual Lorentz derivative is the right Maurer
derivative of the original generated Lorentz matrix field. -/
theorem localSpinWeylDualLorentzDerivative_normalized
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField)
    (point : BasePoint) (direction : LorentzianIndex) :
    localSpinWeylDualLorentzDerivative
        (normalizedLocalSpinField spinField point) point direction =
      localSpinWeylDualLorentzDerivative spinField point direction *
        (localSpinWeylDualLorentzMatrix spinField point)⁻¹ := by
  rw [localSpinWeylDualLorentzDerivative_eq_fieldDirectionalDerivative
      (normalizedLocalSpinField spinField point)
      (normalizedLocalSpinField_smooth spinField smooth point),
    localSpinWeylDualLorentzDerivative_eq_fieldDirectionalDerivative
      spinField smooth]
  have productDerivative :=
    fieldDirectionalDerivative_continuousBilinear
      lorentzMatrixRealMulBilinear.toContinuousBilinearMap
      (localSpinWeylDualLorentzMatrix spinField)
      (fun _ : BasePoint =>
        (localSpinWeylDualLorentzMatrix spinField point)⁻¹)
      (localSpinWeylDualLorentzMatrix_contDiff spinField smooth)
      contDiff_const point direction
  change
    fieldDirectionalDerivative
        (fun candidate =>
          localSpinWeylDualLorentzMatrix spinField candidate *
            (localSpinWeylDualLorentzMatrix spinField point)⁻¹)
        point direction =
      fieldDirectionalDerivative
          (localSpinWeylDualLorentzMatrix spinField) point direction *
          (localSpinWeylDualLorentzMatrix spinField point)⁻¹ +
        localSpinWeylDualLorentzMatrix spinField point *
          fieldDirectionalDerivative
            (fun _ : BasePoint =>
              (localSpinWeylDualLorentzMatrix spinField point)⁻¹)
            point direction at productDerivative
  rw [show localSpinWeylDualLorentzMatrix
      (normalizedLocalSpinField spinField point) =
      fun candidate =>
        localSpinWeylDualLorentzMatrix spinField candidate *
          (localSpinWeylDualLorentzMatrix spinField point)⁻¹ by
    funext candidate
    change
      spinLorentzMatrix
          (spinWeylDual
            (spinField candidate * (spinField point)⁻¹)) =
        spinLorentzMatrix (spinWeylDual (spinField candidate)) *
          (spinLorentzMatrix (spinWeylDual (spinField point)))⁻¹
    rw [map_mul, map_mul]
    have dualInv :
        spinWeylDual ((spinField point)⁻¹) =
          (spinWeylDual (spinField point))⁻¹ :=
      map_inv spinWeylDual (spinField point)
    rw [dualInv, ← spinLorentzMatrix_nonsingInv]]
  simpa [fieldDirectionalDerivative] using productDerivative

end

