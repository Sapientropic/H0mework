open scoped ContDiff MatrixGroups Matrix.Norms.Elementwise

noncomputable section

set_option autoImplicit false

/-- Actual right Maurer Lorentz connection generated by the local Spin field.
The connection is a readout of the same field and point used by the finite
action. -/
def localSpinWeylDualMaurerConnection
    (spinField : BasePoint → SpinPlus13) (point : BasePoint) :
    PointwiseLorentzSpinConnection :=
  fun direction internalOut internalIn =>
    (localSpinWeylDualLorentzDerivative spinField point direction *
      (localSpinWeylDualLorentzMatrix spinField point)⁻¹)
        internalOut internalIn

@[simp] theorem spinConnectionMatrix_localSpinWeylDualMaurerConnection
    (spinField : BasePoint → SpinPlus13) (point : BasePoint)
    (direction : LorentzianIndex) :
    spinConnectionMatrix
        (localSpinWeylDualMaurerConnection spinField point) direction =
      localSpinWeylDualLorentzDerivative spinField point direction *
        (localSpinWeylDualLorentzMatrix spinField point)⁻¹ :=
  rfl

/-- Normalization identifies the ordinary Lorentz derivative at the selected
point with the generated right Maurer connection matrix. -/
theorem spinConnectionMatrix_localSpinWeylDualMaurerConnection_eq_normalized
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField)
    (point : BasePoint) (direction : LorentzianIndex) :
    spinConnectionMatrix
        (localSpinWeylDualMaurerConnection spinField point) direction =
      localSpinWeylDualLorentzDerivative
        (normalizedLocalSpinField spinField point) point direction := by
  rw [spinConnectionMatrix_localSpinWeylDualMaurerConnection,
    localSpinWeylDualLorentzDerivative_normalized spinField smooth]

/-! ## Finite identities to be differentiated -/

/-- Inverse-free variance identity for the fixed Weyl-dual Lorentz action. -/
theorem spinWeylDualLorentz_transpose_mul_original
    (groupElement : SpinPlus13) :
    (spinLorentzMatrix (spinWeylDual groupElement)).transpose *
        spinLorentzMatrix groupElement =
      (1 : LorentzianCoframe) := by
  rw [spinLorentzMatrix_spinWeylDual, Matrix.transpose_transpose,
    ← map_mul]
  simp

/-- The trace of the fixed chiral Dirac representation is the ambient Weyl
trace plus its conjugate.  This finite identity is later differentiated on
the same normalized local Spin field. -/
theorem spinDiracMatrix_trace_eq_ambient_add_star
    (groupElement : SpinPlus13) :
    Matrix.trace (spinDiracMatrix groupElement) =
      Matrix.trace
          ((groupElement : SpinPlus13) : Matrix (Fin 2) (Fin 2) ℂ) +
        star (Matrix.trace
          ((groupElement : SpinPlus13) : Matrix (Fin 2) (Fin 2) ℂ)) := by
  have indexZero :
      (finSumFinEquiv : (Fin 2 ⊕ Fin 2) ≃ Fin 4).symm (0 : Fin 4) =
        Sum.inl (0 : Fin 2) := by
    rw [show (0 : Fin 4) = Fin.castAdd 2 (0 : Fin 2) by rfl]
    exact finSumFinEquiv_symm_apply_castAdd 0
  have indexOne :
      (finSumFinEquiv : (Fin 2 ⊕ Fin 2) ≃ Fin 4).symm (1 : Fin 4) =
        Sum.inl (1 : Fin 2) := by
    rw [show (1 : Fin 4) = Fin.castAdd 2 (1 : Fin 2) by rfl]
    exact finSumFinEquiv_symm_apply_castAdd 1
  have indexTwo :
      (finSumFinEquiv : (Fin 2 ⊕ Fin 2) ≃ Fin 4).symm (2 : Fin 4) =
        Sum.inr (0 : Fin 2) := by
    rw [show (2 : Fin 4) = Fin.natAdd 2 (0 : Fin 2) by rfl]
    exact finSumFinEquiv_symm_apply_natAdd 0
  have indexThree :
      (finSumFinEquiv : (Fin 2 ⊕ Fin 2) ≃ Fin 4).symm (3 : Fin 4) =
        Sum.inr (1 : Fin 2) := by
    rw [show (3 : Fin 4) = Fin.natAdd 2 (1 : Fin 2) by rfl]
    exact finSumFinEquiv_symm_apply_natAdd 1
  simp [Matrix.trace, Fin.sum_univ_four, spinDiracMatrix,
    Matrix.reindexRingEquiv, Matrix.reindexAddEquiv, Matrix.reindex,
    Matrix.submatrix, weylDiracBlockMatrix, Matrix.fromBlocks,
    rightWeylMatrix, Matrix.SpecialLinearGroup.coe_inv,
    Matrix.adjugate_fin_two, indexZero, indexOne, indexTwo, indexThree]
  ring

/-- Real-linear transpose on the exact elementwise Lorentz matrix norm. -/
def lorentzMatrixTransposeLinear :
    LorentzianCoframe →ₗ[ℝ] LorentzianCoframe :=
  (Matrix.transposeLinearEquiv LorentzianIndex LorentzianIndex ℝ ℝ).toLinearMap

def lorentzMatrixTransposeCLM :
    LorentzianCoframe →L[ℝ] LorentzianCoframe :=
  lorentzMatrixTransposeLinear.mkContinuous 1 (by
    intro matrix
    change ‖matrix.transpose‖ ≤ 1 * ‖matrix‖
    rw [Matrix.norm_transpose]
    simp)

@[simp] theorem lorentzMatrixTransposeCLM_apply
    (matrix : LorentzianCoframe) :
    lorentzMatrixTransposeCLM matrix = matrix.transpose :=
  rfl

/-- The Lorentz-column Clifford combination is a real-linear readout of the
generated Lorentz matrix. -/
def lorentzGammaLinear (internal : LorentzianIndex) :
    LorentzianCoframe →ₗ[ℝ] DiracMatrix where
  toFun lorentz :=
    ∑ output : LorentzianIndex,
      (lorentz output internal : ℂ) • diracGamma output
  map_add' := by
    intro first second
    change
      (∑ output : LorentzianIndex,
        (((first output internal + second output internal : ℝ) : ℂ)) •
          diracGamma output) = _
    simp only [Complex.ofReal_add, add_smul, Finset.sum_add_distrib]
  map_smul' := by
    intro parameter lorentz
    change
      (∑ output : LorentzianIndex,
        (((parameter * lorentz output internal : ℝ) : ℂ)) •
          diracGamma output) = _
    conv_rhs =>
      rw [RCLike.real_smul_eq_coe_smul (K := ℂ)]
    rw [Finset.smul_sum]
    apply Finset.sum_congr rfl
    intro output _
    simp only [Complex.ofReal_mul, smul_smul]
    congr 1

def lorentzGammaCLM (internal : LorentzianIndex) :
    LorentzianCoframe →L[ℝ] DiracMatrix :=
  (lorentzGammaLinear internal).toContinuousLinearMap

/-- Real multiplication as the continuous bilinear map used by the
entrywise derivative of the finite Lorentz metric identity. -/
def realMulBilinear : ℝ →ₗ[ℝ] ℝ →ₗ[ℝ] ℝ :=
  LinearMap.mul ℝ ℝ

@[simp] theorem realMulBilinear_apply (first second : ℝ) :
    realMulBilinear first second = first * second :=
  rfl

@[simp] theorem realMulBilinear_continuous_apply
    (first second : ℝ) :
    realMulBilinear.toContinuousBilinearMap first second =
      first * second :=
  rfl

@[simp] theorem lorentzGammaCLM_apply
    (internal : LorentzianIndex) (lorentz : LorentzianCoframe) :
    lorentzGammaCLM internal lorentz =
      ∑ output : LorentzianIndex,
        (lorentz output internal : ℂ) • diracGamma output :=
  rfl

@[simp] theorem lorentzGammaCLM_one
    (internal : LorentzianIndex) :
    lorentzGammaCLM internal (1 : LorentzianCoframe) =
      diracGamma internal := by
  fin_cases internal <;>
    simp [lorentzGammaCLM, lorentzGammaLinear, Fin.sum_univ_four]

/-- Inverse-free finite gamma identity.  This is the form whose derivative
contains no derivative of an inverse field. -/
theorem spinDiracMatrix_mul_diracGamma
    (groupElement : SpinPlus13) (internal : LorentzianIndex) :
    spinDiracMatrix groupElement * diracGamma internal =
      lorentzGammaCLM internal (spinLorentzMatrix groupElement) *
        spinDiracMatrix groupElement := by
  have inverseProduct :
      spinDiracMatrix groupElement⁻¹ * spinDiracMatrix groupElement =
        (1 : DiracMatrix) := by
    rw [← spinDiracMatrix_mul]
    simp
  calc
    spinDiracMatrix groupElement * diracGamma internal =
        spinDiracMatrix groupElement * diracGamma internal *
          (spinDiracMatrix groupElement⁻¹ *
            spinDiracMatrix groupElement) := by
      rw [inverseProduct]
      simp
    _ = (spinDiracMatrix groupElement * diracGamma internal *
          spinDiracMatrix groupElement⁻¹) *
        spinDiracMatrix groupElement := by noncomm_ring
    _ = lorentzGammaCLM internal (spinLorentzMatrix groupElement) *
        spinDiracMatrix groupElement := by
      rw [spinDiracMatrix_diracGamma_covariant]
      rfl

/-! ## Generated infinitesimal identities at the normalized point -/

/-- Differentiating the finite variance identity at the normalized point
relates the two generated Lorentz derivatives. -/
theorem normalizedWeylDualLorentzDerivative_transpose_add_original_eq_zero
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField)
    (point : BasePoint) (direction : LorentzianIndex) :
    (localSpinWeylDualLorentzDerivative
          (normalizedLocalSpinField spinField point) point direction).transpose +
        fieldDirectionalDerivative
          (localSpinLorentzMatrixField
            (normalizedLocalSpinField spinField point)) point direction =
      0 := by
  let normalized := normalizedLocalSpinField spinField point
  let dualField := localSpinWeylDualLorentzMatrix normalized
  let originalField := localSpinLorentzMatrixField normalized
  have normalizedSmooth :=
    normalizedLocalSpinField_smooth spinField smooth point
  have dualSmooth : ContDiff ℝ ∞ dualField :=
    localSpinWeylDualLorentzMatrix_contDiff normalized normalizedSmooth
  have originalSmooth : ContDiff ℝ ∞ originalField :=
    localSpinLorentzMatrixField_contDiff normalized normalizedSmooth
  have transposeSmooth : ContDiff ℝ ∞ fun candidate =>
      lorentzMatrixTransposeCLM (dualField candidate) :=
    lorentzMatrixTransposeCLM.contDiff.comp dualSmooth
  change ContDiff ℝ ∞
    (fun candidate => (dualField candidate).transpose) at transposeSmooth
  have transposeDerivative :=
    fieldDirectionalDerivative_continuousLinear
      lorentzMatrixTransposeCLM dualField dualSmooth point direction
  change
    fieldDirectionalDerivative
        (fun candidate => (dualField candidate).transpose) point direction =
      (fieldDirectionalDerivative dualField point direction).transpose
      at transposeDerivative
  have productDerivative :=
    fieldDirectionalDerivative_continuousBilinear
      lorentzMatrixRealMulBilinear.toContinuousBilinearMap
      (fun candidate => (dualField candidate).transpose)
      originalField transposeSmooth originalSmooth point direction
  change
    fieldDirectionalDerivative
        (fun candidate => (dualField candidate).transpose *
          originalField candidate) point direction =
      fieldDirectionalDerivative
          (fun candidate => (dualField candidate).transpose) point direction *
          originalField point +
        (dualField point).transpose *
          fieldDirectionalDerivative originalField point direction
      at productDerivative
  have finiteIdentity :
      (fun candidate => (dualField candidate).transpose *
        originalField candidate) =
      (fun _ : BasePoint => (1 : LorentzianCoframe)) := by
    funext candidate
    exact spinWeylDualLorentz_transpose_mul_original
      (normalized candidate)
  have productDerivativeZero :
      fieldDirectionalDerivative
          (fun candidate => (dualField candidate).transpose *
            originalField candidate) point direction = 0 := by
    rw [finiteIdentity]
    simp [fieldDirectionalDerivative]
  have normalizedValue : normalized point = 1 := by
    exact normalizedLocalSpinField_at_point spinField point
  have dualValue : dualField point = 1 := by
    change spinLorentzMatrix (spinWeylDual (normalized point)) = 1
    rw [normalizedValue]
    simp
  have originalValue : originalField point = 1 := by
    change spinLorentzMatrix (normalized point) = 1
    rw [normalizedValue]
    simp
  rw [productDerivative] at productDerivativeZero
  rw [transposeDerivative, dualValue, originalValue] at productDerivativeZero
  simp only [Matrix.transpose_one, Matrix.mul_one,
    Matrix.one_mul] at productDerivativeZero
  rw [localSpinWeylDualLorentzDerivative_eq_fieldDirectionalDerivative
    normalized normalizedSmooth]
  exact productDerivativeZero

/-- The same generated normalized Weyl-dual derivative lies in the actual
Lorentz Lie algebra. -/
theorem normalizedWeylDualLorentzDerivative_lorentzSkew
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField)
    (point : BasePoint) :
    LorentzSkew (fun direction internalOut internalIn =>
      localSpinWeylDualLorentzDerivative
        (normalizedLocalSpinField spinField point) point direction
          internalOut internalIn) := by
  intro direction
  let normalized := normalizedLocalSpinField spinField point
  let dualField := localSpinWeylDualLorentzMatrix normalized
  have normalizedSmooth :=
    normalizedLocalSpinField_smooth spinField smooth point
  have dualSmooth : ContDiff ℝ ∞ dualField :=
    localSpinWeylDualLorentzMatrix_contDiff normalized normalizedSmooth
  have entrySmooth (row column : LorentzianIndex) :
      ContDiff ℝ ∞ fun candidate => dualField candidate row column := by
    change ContDiff ℝ ∞ fun candidate =>
      lorentzMatrixEntryCLM row column (dualField candidate)
    exact (lorentzMatrixEntryCLM row column).contDiff.comp dualSmooth
  have normalizedValue : normalized point = 1 := by
    exact normalizedLocalSpinField_at_point spinField point
  ext row column
  change
    ((localSpinWeylDualLorentzDerivative normalized point direction).transpose *
          minkowskiInternalMetric +
        minkowskiInternalMetric *
          localSpinWeylDualLorentzDerivative normalized point direction)
        row column = 0
  let leftField (first second : LorentzianIndex) : BasePoint → ℝ :=
    fun candidate =>
      dualField candidate first row * minkowskiInternalMetric first second
  let term (first second : LorentzianIndex) : BasePoint → ℝ :=
    fun candidate =>
      leftField first second candidate * dualField candidate second column
  have leftSmooth (first second : LorentzianIndex) :
      ContDiff ℝ ∞ (leftField first second) :=
    (entrySmooth first row).mul contDiff_const
  have termSmooth (first second : LorentzianIndex) :
      ContDiff ℝ ∞ (term first second) :=
    (leftSmooth first second).mul (entrySmooth second column)
  have leftDerivative (first second : LorentzianIndex) :
      fieldDirectionalDerivative (leftField first second) point direction =
        fieldDirectionalDerivative
            (fun candidate => dualField candidate first row) point direction *
            minkowskiInternalMetric first second := by
    have actual := fieldDirectionalDerivative_continuousBilinear
      realMulBilinear.toContinuousBilinearMap
      (fun candidate => dualField candidate first row)
      (fun _ : BasePoint => minkowskiInternalMetric first second)
      (entrySmooth first row) contDiff_const point direction
    simpa [leftField, fieldDirectionalDerivative] using actual
  have termDerivative (first second : LorentzianIndex) :
      fieldDirectionalDerivative (term first second) point direction =
        fieldDirectionalDerivative (leftField first second) point direction *
            dualField point second column +
          leftField first second point *
            fieldDirectionalDerivative
              (fun candidate => dualField candidate second column)
              point direction := by
    have actual := fieldDirectionalDerivative_continuousBilinear
      realMulBilinear.toContinuousBilinearMap
      (leftField first second)
      (fun candidate => dualField candidate second column)
      (leftSmooth first second) (entrySmooth second column) point direction
    simpa [term] using actual
  have innerDerivative (first : LorentzianIndex) :=
    fieldDirectionalDerivative_finset_sum Finset.univ
      (fun second => term first second)
      (fun second _ => termSmooth first second) point direction
  have innerSmooth (first : LorentzianIndex) :
      ContDiff ℝ ∞ fun candidate =>
        ∑ second : LorentzianIndex, term first second candidate :=
    ContDiff.sum fun second _ => termSmooth first second
  have totalDerivative :=
    fieldDirectionalDerivative_finset_sum Finset.univ
      (fun first candidate =>
        ∑ second : LorentzianIndex, term first second candidate)
      (fun first _ => innerSmooth first) point direction
  have finiteIdentity :
      (fun candidate =>
        ∑ first : LorentzianIndex, ∑ second : LorentzianIndex,
          term first second candidate) =
      (fun _ : BasePoint => minkowskiInternalMetric row column) := by
    funext candidate
    have identity := congrFun (congrFun
      (spinLorentzMatrix_preserves_minkowskiMetric
        (spinWeylDual (normalized candidate))) row) column
    change
      (((dualField candidate).transpose * minkowskiInternalMetric *
        dualField candidate) row column) =
          minkowskiInternalMetric row column at identity
    rw [Finset.sum_comm]
    simpa [term, leftField, Matrix.mul_apply,
      Matrix.transpose_apply, Finset.sum_mul] using identity
  have totalDerivativeZero :
      fieldDirectionalDerivative
          (fun candidate =>
            ∑ first : LorentzianIndex, ∑ second : LorentzianIndex,
              term first second candidate) point direction = 0 := by
    rw [finiteIdentity]
    simp [fieldDirectionalDerivative]
  rw [totalDerivative] at totalDerivativeZero
  simp_rw [innerDerivative] at totalDerivativeZero
  simp_rw [termDerivative, leftDerivative] at totalDerivativeZero
  fin_cases row <;> fin_cases column <;>
    simp [Matrix.mul_apply, Matrix.transpose_apply, leftField,
      dualField, normalizedValue, localSpinWeylDualLorentzMatrix,
      localSpinWeylDualLorentzDerivative,
      minkowskiInternalMetric, Fin.sum_univ_four] at totalDerivativeZero ⊢ <;>
    linarith

/-- The actual right Maurer connection therefore carries its own generated
Lorentz-skew jurisdiction. -/
theorem localSpinWeylDualMaurerConnection_lorentzSkew
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField) (point : BasePoint) :
    LorentzSkew (localSpinWeylDualMaurerConnection spinField point) := by
  intro direction
  rw [spinConnectionMatrix_localSpinWeylDualMaurerConnection_eq_normalized
    spinField smooth point direction]
  exact normalizedWeylDualLorentzDerivative_lorentzSkew
    spinField smooth point direction

/-! ## Clifford reconstruction of the Maurer derivative -/

/-- Differentiating the inverse-free finite gamma identity at the normalized
point gives the generated Dirac commutator law. -/
theorem normalizedDiracDerivative_commutator_gamma
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField)
    (point : BasePoint) (direction internal : LorentzianIndex) :
    diracMatrixCommutator
        (localSpinDiracMatrixDerivative
          (normalizedLocalSpinField spinField point) point direction)
        (diracGamma internal) =
      lorentzGammaCLM internal
        (fieldDirectionalDerivative
          (localSpinLorentzMatrixField
            (normalizedLocalSpinField spinField point)) point direction) := by
  let normalized := normalizedLocalSpinField spinField point
  let diracField := localSpinDiracMatrixField normalized
  let lorentzField := localSpinLorentzMatrixField normalized
  have normalizedSmooth :=
    normalizedLocalSpinField_smooth spinField smooth point
  have diracSmooth : ContDiff ℝ ∞ diracField :=
    localSpinDiracMatrixField_contDiff normalized normalizedSmooth
  have lorentzSmooth : ContDiff ℝ ∞ lorentzField :=
    localSpinLorentzMatrixField_contDiff normalized normalizedSmooth
  have gammaSmooth : ContDiff ℝ ∞ fun candidate =>
      lorentzGammaCLM internal (lorentzField candidate) :=
    (lorentzGammaCLM internal).contDiff.comp lorentzSmooth
  have leftDerivative :=
    fieldDirectionalDerivative_diracMatrix_mul
      diracField (fun _ : BasePoint => diracGamma internal)
      diracSmooth contDiff_const point direction
  have rightDerivative :=
    fieldDirectionalDerivative_diracMatrix_mul
      (fun candidate => lorentzGammaCLM internal (lorentzField candidate))
      diracField gammaSmooth diracSmooth point direction
  have gammaDerivative :=
    fieldDirectionalDerivative_continuousLinear
      (lorentzGammaCLM internal) lorentzField lorentzSmooth point direction
  have finiteIdentity :
      (fun candidate => diracField candidate * diracGamma internal) =
      (fun candidate =>
        lorentzGammaCLM internal (lorentzField candidate) *
          diracField candidate) := by
    funext candidate
    exact spinDiracMatrix_mul_diracGamma
      (normalized candidate) internal
  have derivativeIdentity := congrArg
    (fun field : BasePoint → DiracMatrix =>
      fieldDirectionalDerivative field point direction) finiteIdentity
  rw [leftDerivative, rightDerivative] at derivativeIdentity
  have derivativeIdentity' := derivativeIdentity.trans
    (congrArg
      (fun derivative : DiracMatrix =>
        derivative * diracField point +
          lorentzGammaCLM internal (lorentzField point) *
            fieldDirectionalDerivative diracField point direction)
      gammaDerivative)
  have normalizedValue : normalized point = 1 := by
    exact normalizedLocalSpinField_at_point spinField point
  have diracValue : diracField point = 1 := by
    change spinDiracMatrix (normalized point) = 1
    rw [normalizedValue]
    exact spinDiracMatrix_one
  have lorentzValue : lorentzField point = 1 := by
    change spinLorentzMatrix (normalized point) = 1
    rw [normalizedValue]
    simp
  rw [diracValue, lorentzValue] at derivativeIdentity'
  simp only [lorentzGammaCLM_one, Matrix.mul_one,
    Matrix.one_mul] at derivativeIdentity'
  simp [fieldDirectionalDerivative] at derivativeIdentity'
  rw [diracMatrixCommutator]
  change
    fieldDirectionalDerivative diracField point direction *
          diracGamma internal -
        diracGamma internal *
          fieldDirectionalDerivative diracField point direction =
      lorentzGammaCLM internal
        (fieldDirectionalDerivative lorentzField point direction)
  unfold fieldDirectionalDerivative
  rw [derivativeIdentity']
  abel

/-- Combining the two differentiated finite identities expresses the Dirac
commutator using the same normalized Weyl-dual Lorentz derivative. -/
theorem normalizedDiracDerivative_commutator_eq_weylDual
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField)
    (point : BasePoint) (direction internal : LorentzianIndex) :
    diracMatrixCommutator
        (localSpinDiracMatrixDerivative
          (normalizedLocalSpinField spinField point) point direction)
        (diracGamma internal) =
      -∑ basisIndex : LorentzianIndex,
        (localSpinWeylDualLorentzDerivative
            (normalizedLocalSpinField spinField point) point direction
            internal basisIndex : ℂ) •
          diracGamma basisIndex := by
  rw [normalizedDiracDerivative_commutator_gamma
    spinField smooth point direction internal]
  have relation :=
    normalizedWeylDualLorentzDerivative_transpose_add_original_eq_zero
      spinField smooth point direction
  rw [lorentzGammaCLM_apply, ← Finset.sum_neg_distrib]
  apply Finset.sum_congr rfl
  intro basisIndex _
  have entry := congrArg
    (lorentzMatrixEntryCLM basisIndex internal) relation
  simp only [map_add, map_zero, lorentzMatrixEntryCLM_apply,
    Matrix.transpose_apply] at entry
  have coefficient :
      fieldDirectionalDerivative
          (localSpinLorentzMatrixField
            (normalizedLocalSpinField spinField point)) point direction
          basisIndex internal =
        -localSpinWeylDualLorentzDerivative
          (normalizedLocalSpinField spinField point) point direction
          internal basisIndex := by
    linarith
  rw [coefficient]
  push_cast
  simp

/-! ## Traceless uniqueness of the generated Maurer lift -/

/-- The generated normalized Dirac tangent is traceless.  The proof reads
the finite chiral trace identity and differentiates the determinant-one law
already carried by the same primitive normalized `SL(2,ℂ)` field. -/
theorem normalizedLocalSpinDiracMatrixDerivative_trace_eq_zero
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField)
    (point : BasePoint) (direction : LorentzianIndex) :
    Matrix.trace
        (localSpinDiracMatrixDerivative
          (normalizedLocalSpinField spinField point) point direction) =
      0 := by
  let normalized := normalizedLocalSpinField spinField point
  let ambientField := localSpinAmbientMatrixField normalized
  let diracField := localSpinDiracMatrixField normalized
  let ambientTraceField : BasePoint → ℂ :=
    fun candidate => Matrix.trace (ambientField candidate)
  let starTraceField : BasePoint → ℂ :=
    fun candidate => Complex.conjCLE (ambientTraceField candidate)
  have normalizedSmooth :=
    normalizedLocalSpinField_smooth spinField smooth point
  have ambientSmooth : ContDiff ℝ ∞ ambientField :=
    localSpinAmbientMatrixField_contDiff normalized normalizedSmooth
  have diracSmooth : ContDiff ℝ ∞ diracField :=
    localSpinDiracMatrixField_contDiff normalized normalizedSmooth
  have ambientTraceSmooth : ContDiff ℝ ∞ ambientTraceField := by
    exact spinAmbientMatrixTraceCLM.contDiff.comp ambientSmooth
  have starTraceSmooth : ContDiff ℝ ∞ starTraceField := by
    exact Complex.conjCLE.contDiff.comp ambientTraceSmooth
  have ambientTangentTraceZero :
      Matrix.trace
          (fieldDirectionalDerivative ambientField point direction) = 0 := by
    exact normalizedLocalSpinAmbientDerivative_trace_eq_zero
      spinField smooth point direction
  have ambientTraceDerivativeReadout :=
    fieldDirectionalDerivative_continuousLinear
      spinAmbientMatrixTraceCLM ambientField ambientSmooth point direction
  change
    fieldDirectionalDerivative ambientTraceField point direction =
      Matrix.trace (fieldDirectionalDerivative ambientField point direction)
      at ambientTraceDerivativeReadout
  have ambientTraceDerivativeZero :
      fieldDirectionalDerivative ambientTraceField point direction = 0 :=
    ambientTraceDerivativeReadout.trans ambientTangentTraceZero
  have starTraceDerivative :=
    fieldDirectionalDerivative_continuousLinear
      Complex.conjCLE.toContinuousLinearMap ambientTraceField
        ambientTraceSmooth point direction
  change
    fieldDirectionalDerivative starTraceField point direction =
      Complex.conjCLE
        (fieldDirectionalDerivative ambientTraceField point direction)
      at starTraceDerivative
  have sumDerivative :
      fieldDirectionalDerivative
          (fun candidate =>
            ambientTraceField candidate + starTraceField candidate)
          point direction =
        fieldDirectionalDerivative ambientTraceField point direction +
          fieldDirectionalDerivative starTraceField point direction := by
    unfold fieldDirectionalDerivative
    change
      (fderiv ℝ (ambientTraceField + starTraceField) point)
          (coordinateDirection direction) = _
    rw [fderiv_add
      ((ambientTraceSmooth.differentiable (by simp)).differentiableAt)
      ((starTraceSmooth.differentiable (by simp)).differentiableAt)]
    rfl
  have finiteTraceIdentity :
      (fun candidate => Matrix.trace (diracField candidate)) =
      (fun candidate =>
        ambientTraceField candidate + starTraceField candidate) := by
    funext candidate
    exact spinDiracMatrix_trace_eq_ambient_add_star (normalized candidate)
  have derivativeIdentity := congrArg
    (fun field : BasePoint → ℂ =>
      fieldDirectionalDerivative field point direction) finiteTraceIdentity
  rw [sumDerivative] at derivativeIdentity
  have diracTraceDerivativeReadout :=
    fieldDirectionalDerivative_continuousLinear
      diracMatrixTraceCLM diracField diracSmooth point direction
  change
    fieldDirectionalDerivative
        (fun candidate => Matrix.trace (diracField candidate)) point direction =
      Matrix.trace (fieldDirectionalDerivative diracField point direction)
      at diracTraceDerivativeReadout
  change
    Matrix.trace (fieldDirectionalDerivative diracField point direction) = 0
  rw [← diracTraceDerivativeReadout, derivativeIdentity,
    starTraceDerivative, ambientTraceDerivativeZero]
  simp

/-- The fixed Clifford lift of the generated Weyl-dual Maurer connection is
exactly the normalized Dirac derivative.  Traceless centralizer rigidity
removes the only possible scalar ambiguity, so no independent lift or
normalization constant is supplied. -/
theorem diracSpinConnectionLift_localSpinWeylDualMaurerConnection_eq_normalized
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField)
    (point : BasePoint) (direction : LorentzianIndex) :
    diracSpinConnectionLift
        (localSpinWeylDualMaurerConnection spinField point) direction =
      localSpinDiracMatrixDerivative
        (normalizedLocalSpinField spinField point) point direction := by
  let connection := localSpinWeylDualMaurerConnection spinField point
  let derivative := localSpinDiracMatrixDerivative
    (normalizedLocalSpinField spinField point) point direction
  let difference :=
    diracSpinConnectionLift connection direction - derivative
  have connectionSkew : LorentzSkew connection := by
    exact localSpinWeylDualMaurerConnection_lorentzSkew
      spinField smooth point
  have differenceTraceZero : Matrix.trace difference = 0 := by
    unfold difference
    rw [Matrix.trace_sub,
      diracSpinConnectionLift_trace_eq_zero,
      normalizedLocalSpinDiracMatrixDerivative_trace_eq_zero
        spinField smooth point direction]
    simp
  have connectionMatrixIdentity :=
    spinConnectionMatrix_localSpinWeylDualMaurerConnection_eq_normalized
      spinField smooth point direction
  have connectionEntryIdentity
      (internal basisIndex : LorentzianIndex) :
      connection direction internal basisIndex =
        localSpinWeylDualLorentzDerivative
          (normalizedLocalSpinField spinField point) point direction
            internal basisIndex := by
    have entry := congrFun (congrFun connectionMatrixIdentity internal)
      basisIndex
    exact entry
  have differenceCommutatorZero
      (internal : LorentzianIndex) :
      diracMatrixCommutator difference (diracGamma internal) = 0 := by
    calc
      diracMatrixCommutator difference (diracGamma internal) =
          diracMatrixCommutator
              (diracSpinConnectionLift connection direction)
              (diracGamma internal) -
            diracMatrixCommutator derivative (diracGamma internal) := by
        unfold difference diracMatrixCommutator
        noncomm_ring
      _ =
          (-∑ basisIndex : LorentzianIndex,
              (connection direction internal basisIndex : ℂ) •
                diracGamma basisIndex) -
            (-∑ basisIndex : LorentzianIndex,
              (localSpinWeylDualLorentzDerivative
                  (normalizedLocalSpinField spinField point) point direction
                    internal basisIndex : ℂ) •
                diracGamma basisIndex) := by
        rw [diracSpinConnectionLift_commutator_upperGamma
          connection connectionSkew direction internal]
        exact congrArg
          (fun matrix : DiracMatrix =>
            (-∑ basisIndex : LorentzianIndex,
                (connection direction internal basisIndex : ℂ) •
                  diracGamma basisIndex) - matrix)
          (normalizedDiracDerivative_commutator_eq_weylDual
            spinField smooth point direction internal)
      _ = 0 := by
        apply sub_eq_zero.mpr
        apply congrArg Neg.neg
        apply Finset.sum_congr rfl
        intro basisIndex _
        rw [connectionEntryIdentity]
  have differenceZero : difference = 0 :=
    diracMatrix_eq_zero_of_trace_eq_zero_of_gamma_commutators
      difference differenceTraceZero differenceCommutatorZero
  exact sub_eq_zero.mp differenceZero

/-- Unnormalized right-Maurer form of the same generated lift identity. -/
theorem diracSpinConnectionLift_localSpinWeylDualMaurerConnection
    (spinField : BasePoint → SpinPlus13)
    (smooth : LocalSpinFieldSmooth spinField)
    (point : BasePoint) (direction : LorentzianIndex) :
    diracSpinConnectionLift
        (localSpinWeylDualMaurerConnection spinField point) direction =
      localSpinDiracMatrixDerivative spinField point direction *
        spinDiracMatrix (spinField point)⁻¹ := by
  rw [← localSpinDiracMatrixDerivative_normalized
    spinField smooth point direction]
  exact
    diracSpinConnectionLift_localSpinWeylDualMaurerConnection_eq_normalized
      spinField smooth point direction

end

