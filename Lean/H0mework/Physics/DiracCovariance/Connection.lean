import H0mework.Physics.Dirac.DiracKineticSpinJurisdiction
import H0mework.Physics.Holonomic.HolonomicField

/-!
# Local Spin action on the primitive Dirac kinetic fields

The finite `kappa/g` seam fixes the local action before any covariance
residual is inspected.  For an actual local Spin field `g(x)` this module
therefore differentiates

`R(x) = L(kappa(g(x)))`

and writes the primitive Lorentz connection by the standard inhomogeneous
law

`omega' = R omega R^-1 - (partial R) R^-1`.

No derivative, lift, covariance, zero-fiber, branch, or stationarity receipt
is stored in the source or accepted by the constructor.  The inactive
gravity/matter-interaction slots are retained only because the current
holonomic carrier is a single record; this operator claims the Dirac kinetic
sector, not yet a full root-action Spin symmetry.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracKineticLocalSpinConnection

open DiracExteriorMatterAction
open PointwiseDiracSpinConnectionLift
open ProofFreeRicherAnholonomicSource
open StageNineCoframeSpinRepresentation
open StageNineDiracKineticSpinJurisdiction
open StageNineGlobalBundle
open StageNineHolonomicField
open StageNinePhysicalBivectorSpinRepresentation
open StageNineSpinMatterBundle

open scoped MatrixGroups Matrix.Norms.Elementwise

noncomputable section

set_option autoImplicit false

/-- The Lorentz matrix forced pointwise by the already fixed Stage-7 Dirac
representation. -/
def localSpinWeylDualLorentzMatrix
    (spinField : BasePoint → SpinPlus13) (point : BasePoint) :
    LorentzianCoframe :=
  spinLorentzMatrix (spinWeylDual (spinField point))

/-- Actual directional derivative of the generated Lorentz matrix.  This is
a readout of `spinField`, not an independently supplied connection jet. -/
def localSpinWeylDualLorentzDerivative
    (spinField : BasePoint → SpinPlus13)
    (point : BasePoint) (direction : LorentzianIndex) :
    LorentzianCoframe :=
  fun internalOut internalIn =>
    fieldDirectionalDerivative
      (fun candidate =>
        localSpinWeylDualLorentzMatrix spinField candidate
          internalOut internalIn)
      point direction

/-- Primitive Lorentz-connection write generated by the local Spin field and
the current primitive connection. -/
def localSpinGravityConnectionAction
    (spinField : BasePoint → SpinPlus13)
    (configuration : StageNineHolonomicConfiguration) :
    LorentzConnectionField :=
  fun point direction internalOut internalIn =>
    let lorentz := localSpinWeylDualLorentzMatrix spinField point
    let derivative :=
      localSpinWeylDualLorentzDerivative spinField point direction
    (lorentz *
          spinConnectionMatrix (configuration.gravityConnection point)
            direction *
        lorentz⁻¹ -
      derivative * lorentz⁻¹) internalOut internalIn

/-- Branch-free local Spin update of the primitive fields consumed by the
holonomic Dirac kinetic operator.  Inactive slots are intentionally retained;
their full root-action transport is outside this checkpoint. -/
def localSpinDiracKineticAction
    (spinField : BasePoint → SpinPlus13)
    (configuration : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration where
  coframe := fun point =>
    spinLorentzCoframeRepresentation
      (spinWeylDual (spinField point)) (configuration.coframe point)
  gravityConnection :=
    localSpinGravityConnectionAction spinField configuration
  gravityAuxiliary := configuration.gravityAuxiliary
  gravitySimplicityMultiplier := configuration.gravitySimplicityMultiplier
  gaugeConnection := configuration.gaugeConnection
  gaugeAuxiliary := configuration.gaugeAuxiliary
  scalar := configuration.scalar
  matter := fun point =>
    spinDiracMatterRepresentation (spinField point)
      (configuration.matter point)
  conjugateMatter := fun point =>
    (configuration.conjugateMatter point).comp
      (spinDiracMatterRepresentation ((spinField point)⁻¹))

@[simp] theorem localSpinDiracKineticAction_coframe
    (spinField : BasePoint → SpinPlus13)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    (localSpinDiracKineticAction spinField configuration).coframe point =
      spinLorentzCoframeRepresentation
        (spinWeylDual (spinField point)) (configuration.coframe point) :=
  rfl

@[simp] theorem localSpinDiracKineticAction_gravityConnection
    (spinField : BasePoint → SpinPlus13)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) (direction : LorentzianIndex) :
    spinConnectionMatrix
        ((localSpinDiracKineticAction spinField configuration).gravityConnection
          point) direction =
      let lorentz := localSpinWeylDualLorentzMatrix spinField point
      let derivative :=
        localSpinWeylDualLorentzDerivative spinField point direction
      lorentz *
            spinConnectionMatrix (configuration.gravityConnection point)
              direction *
          lorentz⁻¹ -
        derivative * lorentz⁻¹ := by
  rfl

@[simp] theorem localSpinDiracKineticAction_matter
    (spinField : BasePoint → SpinPlus13)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    (localSpinDiracKineticAction spinField configuration).matter point =
      spinDiracMatterRepresentation (spinField point)
        (configuration.matter point) :=
  rfl

@[simp] theorem localSpinDiracKineticAction_conjugateMatter
    (spinField : BasePoint → SpinPlus13)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    (localSpinDiracKineticAction spinField configuration).conjugateMatter
        point =
      (configuration.conjugateMatter point).comp
        (spinDiracMatterRepresentation ((spinField point)⁻¹)) :=
  rfl

end

end
  SaturationMonoid.PhysicsCore.StageNineDiracKineticLocalSpinConnection
