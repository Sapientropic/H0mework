import H0mework.Physics.Coframe.CurrentCoframeMatterTimeResponseActualLift
import H0mework.Physics.ConstrainedCauchy.LocalActualLift
import H0mework.Physics.Constitutive.P286GaugeConstitutiveElimination
import H0mework.Physics.Coframe.IdentityCoframeConjugateMatterTimeResponseActualLift

/-!
# Form-native constitutive downstream action operator

This module exposes the dependency-ordered action composition already used
by the fixed P506/L0 construction:

```text
source + current
  -> live-coframe/live-curvature constitutive inverse
  -> current-owned primal matter write
  -> independent adjoint matter write
  -> repaired-root Einstein--Cartan recomputation
  -> one common holonomic actual.
```

The operator accepts no residual, support coordinate, sign, target field,
branch choice, response witness, stationarity receipt, or zero-fiber
certificate.  Its active algebraic primitive is the unique P286 auxiliary
generated by the existing constitutive equivalence.  In particular, this
operator does not generate a new P286 connection; a caller that needs that
primitive must supply a current already produced by the corresponding
action-owned connection operator.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeConstitutiveJointActionResponseOperator

open ProofFreeRicherAnholonomicSource
open StageNineCanonicalCauchyState
open StageNineCurrentCoframeMatterTimeResponseActualLift
open StageNineDiracDualFormNativeECFullCauchyLocalActualLift
open StageNineEnrichedProofFreeSource
open StageNineFormNativeGravityMultiplierAuxiliaryIntegratedVariation
open StageNineFormNativeP286GaugeConstitutiveElimination
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineIdentityCoframeConjugateMatterTimeResponseActualLift
open SU7MotherLieAlgebra

noncomputable section

set_option autoImplicit false

/-- Pointwise P286 auxiliary generated by the authoritative live
constitutive inverse of the current coframe and literal current curvature. -/
def diracDualFormNativeConstitutiveAuxiliaryField
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    BasePoint → Fin 6 → P286LieBlockData :=
  fun point =>
    formNativeP286GaugeEliminatedAuxiliaryAtBoundary
      (sourceGeneratedUnifiedCouplings source)
      (current.coframe point)
      (holonomicGaugeCurvature current point)

/-- First dependency edge: install the action-owned constitutive auxiliary
on the whole current without changing any other primitive field. -/
def diracDualFormNativeConstitutiveWrittenCurrent
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  { current with
    gaugeAuxiliary :=
      diracDualFormNativeConstitutiveAuxiliaryField source current }

@[simp] theorem diracDualFormNativeConstitutiveWrittenCurrent_gravityConnection
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (diracDualFormNativeConstitutiveWrittenCurrent source current
      ).gravityConnection = current.gravityConnection :=
  rfl

/-- Second dependency edge: recompute the primal matter response after the
constitutive primitive has changed. -/
def diracDualFormNativeConstitutivePrimalWrittenCurrent
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  actionGeneratedCurrentCoframeMatterTimeResponseActual
    (diracDualFormNativeConstitutiveWrittenCurrent source current)

/-- Third dependency edge: generate the independent adjoint response on the
same live current. -/
def diracDualFormNativeConstitutiveDualWrittenCurrent
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  actionGeneratedIdentityCoframeConjugateMatterTimeResponseActual
    (diracDualFormNativeConstitutivePrimalWrittenCurrent source current)

/-- Branch-free downstream joint action operator.  The output is one whole
holonomic actual, generated only from the supplied source and current. -/
def diracDualFormNativeConstitutiveJointActionResponseOperator
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  sourceActionGeneratedDiracDualECFullCauchyLocalActualLift source
    (diracDualFormNativeConstitutiveDualWrittenCurrent source current)

theorem
    diracDualFormNativeConstitutiveJointActionResponseOperator_simplicity
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    FormNativeGravitySimplicityEquation
      (diracDualFormNativeConstitutiveJointActionResponseOperator
        source current) := by
  exact
    sourceActionGeneratedDiracDualECFullCauchyLocalActualLift_simplicity
      source
      (diracDualFormNativeConstitutiveDualWrittenCurrent source current)

/-- The local operator recomputes the live gravity reaction after both EC
writes.  Downstream spatial assembly must still recheck the holonomic
curvature; this theorem is only the contactwise action equation. -/
theorem
    diracDualFormNativeConstitutiveJointActionResponseOperator_auxiliaryEquation
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    FormNativeGravityAuxiliaryEquation
      (diracDualFormNativeConstitutiveJointActionResponseOperator
        source current) := by
  exact
    sourceActionGeneratedDiracDualECFullCauchyLocalActualLift_auxiliaryEquation
      source
      (diracDualFormNativeConstitutiveDualWrittenCurrent source current)

@[simp] theorem
    diracDualFormNativeConstitutiveWrittenCurrent_gaugeAuxiliary
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (diracDualFormNativeConstitutiveWrittenCurrent source current
      ).gaugeAuxiliary =
      diracDualFormNativeConstitutiveAuxiliaryField source current :=
  rfl

@[simp] theorem
    diracDualFormNativeConstitutiveWrittenCurrent_gaugeConnection
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (diracDualFormNativeConstitutiveWrittenCurrent source current
      ).gaugeConnection =
      current.gaugeConnection :=
  rfl

theorem
    diracDualFormNativeConstitutiveJointActionResponseOperator_coframe
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (diracDualFormNativeConstitutiveJointActionResponseOperator source current
      ).coframe =
      current.coframe := by
  rw [diracDualFormNativeConstitutiveJointActionResponseOperator,
    sourceActionGeneratedDiracDualECFullCauchyLocalActualLift_coframe,
    diracDualFormNativeConstitutiveDualWrittenCurrent,
    actionGeneratedIdentityCoframeConjugateMatterTimeResponseActual_coframe,
    diracDualFormNativeConstitutivePrimalWrittenCurrent,
    actionGeneratedCurrentCoframeMatterTimeResponseActual_coframe]
  rfl

@[simp] theorem
    diracDualFormNativeConstitutiveJointActionResponseOperator_gravityAuxiliary
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    (diracDualFormNativeConstitutiveJointActionResponseOperator source current
      ).gravityAuxiliary point =
      physicalIIPlusBivector (current.coframe point) := by
  rfl

@[simp] theorem
    diracDualFormNativeConstitutiveJointActionResponseOperator_gravityConnection_zero
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (diracDualFormNativeConstitutiveJointActionResponseOperator source current
      ).gravityConnection 0 =
      current.gravityConnection 0 := by
  rw [diracDualFormNativeConstitutiveJointActionResponseOperator,
    sourceActionGeneratedDiracDualECFullCauchyLocalActualLift_connection_zero,
    diracDualFormNativeConstitutiveDualWrittenCurrent,
    actionGeneratedIdentityCoframeConjugateMatterTimeResponseActual_gravityConnection,
    diracDualFormNativeConstitutivePrimalWrittenCurrent,
    actionGeneratedCurrentCoframeMatterTimeResponseActual_gravityConnection]
  rfl

theorem
    diracDualFormNativeConstitutiveJointActionResponseOperator_gaugeConnection
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (diracDualFormNativeConstitutiveJointActionResponseOperator source current
      ).gaugeConnection =
      current.gaugeConnection := by
  rw [diracDualFormNativeConstitutiveJointActionResponseOperator,
    sourceActionGeneratedDiracDualECFullCauchyLocalActualLift_gaugeConnection,
    diracDualFormNativeConstitutiveDualWrittenCurrent,
    actionGeneratedIdentityCoframeConjugateMatterTimeResponseActual_gaugeConnection,
    diracDualFormNativeConstitutivePrimalWrittenCurrent,
    actionGeneratedCurrentCoframeMatterTimeResponseActual_gaugeConnection]
  rfl

theorem
    diracDualFormNativeConstitutiveJointActionResponseOperator_gaugeAuxiliary
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (diracDualFormNativeConstitutiveJointActionResponseOperator source current
      ).gaugeAuxiliary =
      diracDualFormNativeConstitutiveAuxiliaryField source current := by
  rw [diracDualFormNativeConstitutiveJointActionResponseOperator,
    sourceActionGeneratedDiracDualECFullCauchyLocalActualLift_gaugeAuxiliary,
    diracDualFormNativeConstitutiveDualWrittenCurrent,
    actionGeneratedIdentityCoframeConjugateMatterTimeResponseActual_gaugeAuxiliary,
    diracDualFormNativeConstitutivePrimalWrittenCurrent,
    actionGeneratedCurrentCoframeMatterTimeResponseActual_gaugeAuxiliary,
    diracDualFormNativeConstitutiveWrittenCurrent_gaugeAuxiliary]

theorem
    diracDualFormNativeConstitutiveJointActionResponseOperator_scalar
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (diracDualFormNativeConstitutiveJointActionResponseOperator source current
      ).scalar =
      current.scalar := by
  rw [diracDualFormNativeConstitutiveJointActionResponseOperator,
    sourceActionGeneratedDiracDualECFullCauchyLocalActualLift_scalar,
    diracDualFormNativeConstitutiveDualWrittenCurrent,
    actionGeneratedIdentityCoframeConjugateMatterTimeResponseActual_scalar,
    diracDualFormNativeConstitutivePrimalWrittenCurrent,
    actionGeneratedCurrentCoframeMatterTimeResponseActual_scalar]
  rfl

theorem
    diracDualFormNativeConstitutiveJointActionResponseOperator_matter_zeroSlice
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (space : StageNineSpatialPoint) :
    (diracDualFormNativeConstitutiveJointActionResponseOperator source current
      ).matter (canonicalCauchySlicePoint 0 space) =
      current.matter (canonicalCauchySlicePoint 0 space) := by
  rw [diracDualFormNativeConstitutiveJointActionResponseOperator,
    sourceActionGeneratedDiracDualECFullCauchyLocalActualLift_matter,
    diracDualFormNativeConstitutiveDualWrittenCurrent,
    actionGeneratedIdentityCoframeConjugateMatterTimeResponseActual_matter,
    diracDualFormNativeConstitutivePrimalWrittenCurrent]
  have sliceEquality :=
    congrArg
      (fun state : StageNineCauchyState => state.matter space)
      (canonicalCauchyRestriction_zero_actionGeneratedCurrentCoframeMatterTimeResponseActual
        (diracDualFormNativeConstitutiveWrittenCurrent source current))
  simpa [canonicalCauchyRestriction,
    diracDualFormNativeConstitutiveWrittenCurrent] using sliceEquality

theorem
    diracDualFormNativeConstitutiveJointActionResponseOperator_conjugateMatter_zeroSlice
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (space : StageNineSpatialPoint) :
    (diracDualFormNativeConstitutiveJointActionResponseOperator source current
      ).conjugateMatter (canonicalCauchySlicePoint 0 space) =
      current.conjugateMatter (canonicalCauchySlicePoint 0 space) := by
  rw [diracDualFormNativeConstitutiveJointActionResponseOperator,
    sourceActionGeneratedDiracDualECFullCauchyLocalActualLift_conjugateMatter,
    diracDualFormNativeConstitutiveDualWrittenCurrent]
  have sliceEquality :=
    congrArg
      (fun state : StageNineCauchyState => state.conjugateMatter space)
      (canonicalCauchyRestriction_zero_actionGeneratedIdentityCoframeConjugateMatterTimeResponseActual
        (diracDualFormNativeConstitutivePrimalWrittenCurrent source current))
  rw [show
    (actionGeneratedIdentityCoframeConjugateMatterTimeResponseActual
      (diracDualFormNativeConstitutivePrimalWrittenCurrent source current)
      ).conjugateMatter (canonicalCauchySlicePoint 0 space) =
      (diracDualFormNativeConstitutivePrimalWrittenCurrent source current
        ).conjugateMatter (canonicalCauchySlicePoint 0 space) by
      simpa [canonicalCauchyRestriction] using sliceEquality]
  simp [diracDualFormNativeConstitutivePrimalWrittenCurrent,
    diracDualFormNativeConstitutiveWrittenCurrent]

@[simp] theorem
    diracDualFormNativeConstitutiveJointActionResponseOperator_matter_zero
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (diracDualFormNativeConstitutiveJointActionResponseOperator source current
      ).matter 0 =
      current.matter 0 := by
  rw [diracDualFormNativeConstitutiveJointActionResponseOperator,
    sourceActionGeneratedDiracDualECFullCauchyLocalActualLift_matter,
    diracDualFormNativeConstitutiveDualWrittenCurrent,
    actionGeneratedIdentityCoframeConjugateMatterTimeResponseActual_matter,
    diracDualFormNativeConstitutivePrimalWrittenCurrent,
    actionGeneratedCurrentCoframeMatterTimeResponseActual_matter_origin]
  rfl

@[simp] theorem
    diracDualFormNativeConstitutiveJointActionResponseOperator_conjugateMatter_zero
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (diracDualFormNativeConstitutiveJointActionResponseOperator source current
      ).conjugateMatter 0 =
      current.conjugateMatter 0 := by
  rw [diracDualFormNativeConstitutiveJointActionResponseOperator,
    sourceActionGeneratedDiracDualECFullCauchyLocalActualLift_conjugateMatter,
    diracDualFormNativeConstitutiveDualWrittenCurrent,
    actionGeneratedIdentityCoframeConjugateMatterTimeResponseActual_conjugateMatter_origin,
    diracDualFormNativeConstitutivePrimalWrittenCurrent,
    actionGeneratedCurrentCoframeMatterTimeResponseActual_conjugateMatter]
  rfl

end

end
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeConstitutiveJointActionResponseOperator
