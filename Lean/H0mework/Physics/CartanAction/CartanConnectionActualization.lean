/-!
# Repaired-action Cartan connection actualization

The repaired Dirac-dual action first generates its Lorentz matter coefficient.
The fixed W13 dual turns that coefficient into the physical spin-current
three-form.  On the same computed-`II+` point field this module then applies
KIN-3, KIN-2, and KIN-4 in the forward order

```text
repaired action coefficient
-> physical W13 spin response
-> typed Cartan torsion
-> lowered contorsion
-> omegaLC + lift(q).
```

The response, torsion, contorsion, and connection are all computed internally.
No response value, torsion equation, stationarity receipt, solution, branch
choice, curvature target, or normalization is accepted.  The only correctness
gate is pointwise coframe nondegeneracy.

This is a source/action-relative pointwise producer over an already generated
holonomic configuration.  It is not yet a smooth connection-field producer,
a curvature/integrability result, or a stationary world.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeCartanConnectionActualization

open EmpiricalReferenceScaleCouplingBoundary
open PointwiseDiracSpinConnectionLift
open ProofFreeRicherAnholonomicSource
open StageNineCartanAffineConnectionActualization
open StageNineCartanContorsionTorsionEquiv
open StageNineCartanTorsionThreeFormCoordinates
open StageNineCartanTorsionThreeFormEquiv
open StageNineCoframeFirstJet
open StageNineDiracDualFormNativeLorentzConnectionVariation
open StageNineDiracDualFormNativeMotherAction
open StageNineEnrichedProofFreeSource
open StageNineFormNativeLorentzConnectionLocalVariation
open StageNineFormNativeLorentzGeometricFirstVariation
open StageNineFormNativeMatterSpinThreeForm
open StageNineFormNativeMotherAction
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineIIPlusRestriction
open StageNineLorentzConnectionActualVariationCore
open StageNineLorentzConnectionVariation
open StageNineResidualLinearPlebanskiTorsionReduction
open StageNineTopologicalGravityCurvatureVariancePairing
open StageNineTopologicalLorentzThreeFormDuality

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1200000

/-! ## Repaired-action W13 provenance -/

/-- The physical-current sign is the negative of the matter coefficient
generated by the form-native Lorentz variation. -/
theorem formNativePhysicalSpinCurrentThreeForm_evaluation
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (direction : LorentzBivectorOneForm) :
    lorentzThreeFormWedgeContinuousDual
        (formNativePhysicalSpinCurrentThreeForm source chart point field)
        direction =
      -formNativeLorentzMatterFirstCoefficient source chart point field
        direction := by
  unfold formNativePhysicalSpinCurrentThreeForm
  change lorentzOneFormThreeFormWedgeCoefficient direction
      (-formNativeMatterSpinThreeForm source chart point field) = _
  rw [show
      -formNativeMatterSpinThreeForm source chart point field =
        (-1 : ℝ) • formNativeMatterSpinThreeForm source chart point field by
      ext internalPair triple
      simp,
    lorentzOneFormThreeFormWedgeCoefficient_smul_right]
  rw [← lorentzThreeFormWedgeContinuousDual_apply,
    formNativeMatterSpinThreeForm_evaluation]
  ring

/-- Direct repaired-root provenance at jet level.  Holding the curvature jet
fixed isolates the matter block of the new action hash; this is a coefficient
identity, not a claim that the isolated jet is a complete primitive connection
path or a stationarity equation. -/
theorem
    generatedDiracDualFormNativeUnifiedLocalDensity_matterSpinResponse_affine
    (source : SmoothUnifiedSource)
    (boundary : EmpiricalReferenceScaleCouplings)
    (chart : StageNineChart) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (direction : LorentzBivectorOneForm) (parameter : ℝ) :
    generatedDiracDualFormNativeUnifiedLocalDensityAtBoundary source boundary
        chart point
        (withLorentzConnectionJets field field.gravityCurvature
          (field.matterCovariantDerivative + parameter •
            pointwiseMatterLorentzConnectionVariation field direction)) =
      generatedDiracDualFormNativeUnifiedLocalDensityAtBoundary source boundary
          chart point field -
        parameter *
          lorentzThreeFormWedgeContinuousDual
            (formNativePhysicalSpinCurrentThreeForm source chart point field)
            direction := by
  have expansion :=
    generatedDiracDualFormNativeUnifiedLocalDensity_lorentzConnectionJets_quadratic
      source boundary chart point field 0 0
      (pointwiseMatterLorentzConnectionVariation field direction) parameter
  have simplified :
      generatedDiracDualFormNativeUnifiedLocalDensityAtBoundary source boundary
          chart point
          (withLorentzConnectionJets field field.gravityCurvature
            (field.matterCovariantDerivative + parameter •
              pointwiseMatterLorentzConnectionVariation field direction)) =
        generatedDiracDualFormNativeUnifiedLocalDensityAtBoundary source
            boundary chart point field +
          parameter *
            formNativeLorentzMatterFirstCoefficient source chart point field
              direction := by
    simpa [formNativeLorentzConnectionFirstVariationDensity,
      formNativeLorentzConnectionSecondVariationDensity,
      formNativeLorentzMatterFirstCoefficient,
      gravityTopologicalBFCoefficient] using expansion
  rw [formNativePhysicalSpinCurrentThreeForm_evaluation]
  calc
    _ = generatedDiracDualFormNativeUnifiedLocalDensityAtBoundary source
          boundary chart point field +
        parameter *
          formNativeLorentzMatterFirstCoefficient source chart point field
            direction := simplified
    _ = _ := by ring

/-! ## Internal response-to-connection producer -/

/-- Physical W13 spin current read from the computed-`II+` version of the
same point field. -/
def diracDualFormNativeActionSpinResponseAt
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) : PhysicalBivectorThreeForm :=
  formNativePhysicalSpinCurrentThreeForm source 0 point
    (toContinuumPointField
      (restrictHolonomicConfigurationToIIPlus configuration) point)

theorem diracDualFormNativeActionSpinResponseAt_evaluation
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint)
    (direction : LorentzBivectorOneForm) :
    lorentzThreeFormWedgeContinuousDual
        (diracDualFormNativeActionSpinResponseAt source configuration point)
        direction =
      -formNativeLorentzMatterFirstCoefficient source 0 point
        (toContinuumPointField
          (restrictHolonomicConfigurationToIIPlus configuration) point)
        direction := by
  exact formNativePhysicalSpinCurrentThreeForm_evaluation source 0 point
    (toContinuumPointField
      (restrictHolonomicConfigurationToIIPlus configuration) point)
    direction

/-- KIN-3 generates the unique typed torsion response from the internal W13
current. -/
def diracDualFormNativeActionCartanTorsionAt
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) : PointwiseCartanTorsionTwoForm :=
  cartanTorsionOfThreeForm (configuration.coframe point)
    (diracDualFormNativeActionSpinResponseAt source configuration point)

/-- KIN-2 generates the canonical lowered contorsion coordinates. -/
def diracDualFormNativeActionCartanContorsionAt
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) : LorentzBivectorOneForm :=
  contorsionOfCartanTorsion (configuration.coframe point)
    (diracDualFormNativeActionCartanTorsionAt source configuration point)

/-- KIN-4 installs the generated contorsion over the Levi--Civita connection
of the same primitive coframe first jet. -/
def diracDualFormNativeActionCartanConnectionAt
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) : PointwiseLorentzSpinConnection :=
  cartanAffineSpinConnection
    (holonomicCoframeFirstJetAt configuration.coframe point)
    (diracDualFormNativeActionCartanContorsionAt source configuration point)

/-- The connection's lowered coordinates retain the exact internally
generated contorsion relative to the same Levi--Civita baseline. -/
theorem
    loweredLorentzConnectionCoefficient_diracDualFormNativeActionCartanConnectionAt
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint)
    (formDirection : LorentzianIndex) (pair : Fin 6) :
    loweredLorentzConnectionCoefficient
        (diracDualFormNativeActionCartanConnectionAt source configuration point)
        formDirection pair =
      loweredLorentzConnectionCoefficient
          ((holonomicCoframeFirstJetAt configuration.coframe point)
            |>.lorentzSpinConnection)
          formDirection pair +
        diracDualFormNativeActionCartanContorsionAt source configuration point
          formDirection pair := by
  exact loweredLorentzConnectionCoefficient_cartanAffineSpinConnection
    (holonomicCoframeFirstJetAt configuration.coframe point)
    (diracDualFormNativeActionCartanContorsionAt source configuration point)
    formDirection pair

/-- KIN-3 forward validation of the internally generated typed torsion. -/
theorem diracDualFormNativeActionCartanTorsionAt_generates_spinResponse
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint)
    (nondegenerate : Matrix.det (configuration.coframe point) ≠ 0) :
    cartanTorsionThreeForm (configuration.coframe point)
        (diracDualFormNativeActionCartanTorsionAt source configuration point) =
      diracDualFormNativeActionSpinResponseAt source configuration point := by
  exact cartanTorsionOfThreeForm_rightInverse
    (configuration.coframe point) nondegenerate _

/-- The literal actual Cartan torsion of the generated affine connection is
the internally generated typed torsion.  This is producer soundness, not an
independent field equation. -/
theorem diracDualFormNativeActionCartanConnectionAt_actualTorsion
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint)
    (nondegenerate : Matrix.det (configuration.coframe point) ≠ 0) :
    actualPointwiseCartanTorsionTwoForm
        (holonomicCoframeFirstJetAt configuration.coframe point)
        (diracDualFormNativeActionCartanConnectionAt source configuration point) =
      diracDualFormNativeActionCartanTorsionAt source configuration point := by
  unfold diracDualFormNativeActionCartanConnectionAt
    diracDualFormNativeActionCartanContorsionAt
  rw [actualPointwiseCartanTorsionTwoForm_cartanAffineSpinConnection
    (holonomicCoframeFirstJetAt configuration.coframe point)
    nondegenerate]
  exact contorsionOfCartanTorsion_rightInverse
    (configuration.coframe point) nondegenerate _

/-- **Pointwise producer frontier.**  The literal Cartan response of the
generated Lorentz connection is exactly the W13 current produced by the
repaired action on the same point field. -/
theorem diracDualFormNativeActionCartanConnectionAt_generates_spinResponse
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint)
    (nondegenerate : Matrix.det (configuration.coframe point) ≠ 0) :
    cartanTorsionThreeForm (configuration.coframe point)
        (actualPointwiseCartanTorsionTwoForm
          (holonomicCoframeFirstJetAt configuration.coframe point)
          (diracDualFormNativeActionCartanConnectionAt source configuration point)) =
      diracDualFormNativeActionSpinResponseAt source configuration point := by
  rw [diracDualFormNativeActionCartanConnectionAt_actualTorsion
    source configuration point nondegenerate]
  exact diracDualFormNativeActionCartanTorsionAt_generates_spinResponse
    source configuration point nondegenerate

/-- The internally generated connection inhabits the actual Lorentz-skew
connection domain. -/
theorem diracDualFormNativeActionCartanConnectionAt_lorentzSkew
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint)
    (nondegenerate : Matrix.det (configuration.coframe point) ≠ 0) :
    LorentzSkew
      (diracDualFormNativeActionCartanConnectionAt source configuration point) := by
  exact cartanAffineSpinConnection_lorentzSkew
    (holonomicCoframeFirstJetAt configuration.coframe point)
    nondegenerate _

end

end
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeCartanConnectionActualization
