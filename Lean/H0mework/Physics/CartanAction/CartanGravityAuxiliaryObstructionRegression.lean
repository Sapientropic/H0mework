/-- The selected `(01) internal x (31) spacetime` curvature coordinate is
computed from the live KIN-6 field.  Its two derivative terms vanish by the
spatial slice theorem, while the remaining commutator is fixed by the exact
Cartan connection normal form. -/
theorem positiveDiracDualCartanConnection_curvature_zero_four :
    holonomicGravityCurvature positiveDiracDualCartanConnectionLocalActual
        0 0 4 = (1 / 16 : ℝ) := by
  unfold holonomicGravityCurvature
  simp [pairFirst, pairSecond, minkowskiInternalSign]
  rw [show
      gravityConnectionDerivative positiveDiracDualCartanConnectionLocalActual
          0 3 1 0 1 = 0 by
        exact positiveDiracDualCartanConnection_spatialDerivative_zero
          2 1 0 1,
    show
      gravityConnectionDerivative positiveDiracDualCartanConnectionLocalActual
          0 1 3 0 1 = 0 by
        exact positiveDiracDualCartanConnection_spatialDerivative_zero
          0 3 0 1]
  simp_rw [positiveDiracDualCartanConnection_origin_three_zero,
    positiveDiracDualCartanConnection_origin_one_zero,
    positiveDiracDualCartanConnection_origin_three_middle_one]
  norm_num [Fin.sum_univ_four]

/-- The authoritative contravariant variance normalization changes the sign
of the timelike-spacelike internal pair exactly once. -/
theorem positiveDiracDualCartanConnection_contravariantCurvature_zero_four :
    holonomicContravariantGravityCurvature
        positiveDiracDualCartanConnectionLocalActual 0 0 4 =
      -(1 / 16 : ℝ) := by
  rw [holonomicContravariantGravityCurvature_apply,
    positiveDiracDualCartanConnection_curvature_zero_four]
  norm_num [lorentzianTwoFormSign, minkowskiInternalSign, pairFirst,
    pairSecond]

