  funext upper first second
  unfold PointwiseLorentzianCoframeJet.leviCivitaConnection
    PointwiseLorentzianCoframeJet.leviCivitaConnectionVector
  rw [positiveIdentityZeroCoframeJet_loweredLeviCivitaVector_eq_zero]
  simp

private theorem
    positiveIdentityZeroCoframeJet_coordinateConnectionMatrix_eq_zero
