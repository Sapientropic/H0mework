/-- Typed Cartan torsion generated by KIN-3 at the fixed contact. -/
def positiveDiracDualCartanTorsionNormalForm :
    PointwiseCartanTorsionTwoForm :=
  ⟨![
    ![0, 0, (1 / 2 : ℝ), 0],
    ![0, -(1 / 2 : ℝ), 0, 0],
    ![0, 0, 0, 0],
    ![0, -(1 / 2 : ℝ), 0, 0],
    ![0, 0, -(1 / 2 : ℝ), 0],
    ![-(1 / 2 : ℝ), 0, 0, -(1 / 2 : ℝ)]
  ]⟩

theorem fixedActionCartanTorsion_eq_positiveNormalForm :
    diracDualFormNativeActionCartanTorsionAt positiveSmoothUnifiedSource
        positiveSourceTargetMatterActual 0 =
      positiveDiracDualCartanTorsionNormalForm := by
  unfold diracDualFormNativeActionCartanTorsionAt
  rw [positiveSourceTargetMatterActual_coframe_one]
  change cartanTorsionOfThreeForm 1 fixedActionSpinResponse = _
  rw [fixedActionSpinResponse_eq_positiveDiracDualSpinResponseNormalForm]
  ext spacetimePair internal
  fin_cases spacetimePair <;> fin_cases internal <;>
    simp [positiveDiracDualCartanTorsionNormalForm,
      cartanTorsionOfThreeForm, cartanTorsionOfUndualThreeForm,
      cartanThreeFormFirstContraction, cartanThreeFormDoubleContraction,
      internalBivectorUndualThreeForm,
      orderedPhysicalBivectorThreeFormComponent,
      orderedInternalBivectorThreeFormComponent,
      orientedLorentzThreeFormBasisCoefficient,
      orientedLorentzBivectorBasisCoefficient,
      positiveDiracDualSpinResponseNormalForm,
      pairFirst, pairSecond, threeFormFirst, threeFormSecond,
      threeFormThird, lorentzianCoframeHodge,
      Fin.sum_univ_four, Fin.sum_univ_six, Matrix.one_apply]

/-- Lowered contorsion generated by KIN-2 from the same typed torsion. -/
def positiveDiracDualCartanContorsionNormalForm :
    LorentzBivectorOneForm :=
  ![
    ![0, 0, 0, 0, 0, -(1 / 4 : ℝ)],
    ![0, (1 / 4 : ℝ), 0, (1 / 4 : ℝ), 0, 0],
    ![-(1 / 4 : ℝ), 0, 0, 0, (1 / 4 : ℝ), 0],
    ![0, 0, 0, 0, 0, (1 / 4 : ℝ)]
  ]

theorem fixedActionCartanContorsion_eq_positiveNormalForm :
    diracDualFormNativeActionCartanContorsionAt positiveSmoothUnifiedSource
        positiveSourceTargetMatterActual 0 =
      positiveDiracDualCartanContorsionNormalForm := by
  unfold diracDualFormNativeActionCartanContorsionAt
  rw [positiveSourceTargetMatterActual_coframe_one,
    fixedActionCartanTorsion_eq_positiveNormalForm]
  funext formDirection internalPair
  fin_cases formDirection <;> fin_cases internalPair <;>
    simp [positiveDiracDualCartanContorsionNormalForm,
      contorsionOfCartanTorsion, internalFrameContorsionOfTorsion,
      minkowskiRaiseCartanTorsion,
      pullbackCartanTorsionTwoForm_one,
      pushforwardLorentzBivectorOneForm_one,
      orderedCartanTorsionComponent,
      orientedLorentzBivectorBasisCoefficient,
      positiveDiracDualCartanTorsionNormalForm,
      pairFirst, pairSecond, minkowskiInternalSign,
      Fin.sum_univ_six] <;>
    norm_num

