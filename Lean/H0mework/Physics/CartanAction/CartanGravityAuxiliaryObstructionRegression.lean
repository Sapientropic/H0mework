/-! ## Exact W13 response normal form -/

/-- Physical W13 response generated by the positive P506/L0 matter actual,
in internal-pair rows and `(012,013,023,123)` columns. -/
def positiveDiracDualSpinResponseNormalForm : PhysicalBivectorThreeForm :=
  ![
    ![0, (1 / 2 : ℝ), 0, 0],
    ![0, 0, (1 / 2 : ℝ), 0],
    ![0, 0, 0, 0],
    ![0, 0, -(1 / 2 : ℝ), 0],
    ![0, (1 / 2 : ℝ), 0, 0],
    ![-(1 / 2 : ℝ), 0, 0, (1 / 2 : ℝ)]
  ]

private theorem loweredCoordinate_eq_directionCoordinate
    (direction : LorentzianIndex) (internalPair : Fin 6) :
    loweredLorentzBivectorOneFormCoordinate direction internalPair =
      lorentzBivectorOneFormCoordinateDirection direction internalPair := by
  funext candidateDirection candidatePair
  by_cases directionEqual : candidateDirection = direction
  · subst candidateDirection
    by_cases pairEqual : candidatePair = internalPair
    · subst candidatePair
      simp [loweredLorentzBivectorOneFormCoordinate,
        lorentzBivectorOneFormCoordinateDirection]
    · simp [loweredLorentzBivectorOneFormCoordinate,
        lorentzBivectorOneFormCoordinateDirection, pairEqual]
  · simp [loweredLorentzBivectorOneFormCoordinate,
      lorentzBivectorOneFormCoordinateDirection, directionEqual]

/-- The complete physical W13 current is fixed by the existing action
coefficient normal form and the metric-free one-form/three-form duality. -/
theorem fixedActionSpinResponse_eq_positiveDiracDualSpinResponseNormalForm :
    fixedActionSpinResponse = positiveDiracDualSpinResponseNormalForm := by
  funext internalPair triple
  change -(formNativeMatterSpinThreeForm positiveSmoothUnifiedSource 0 0
    (toContinuumPointField
      (restrictHolonomicConfigurationToIIPlus
        positiveSourceTargetMatterActual) 0) internalPair triple) = _
  rw [show triple =
      missingTripleOfOneForm (missingTripleOfOneForm triple) by simp]
  rw [formNativeMatterSpinThreeForm_coordinate,
      formNativeLorentzMatterFirstCoefficient_restrictToIIPlus,
      loweredCoordinate_eq_directionCoordinate,
      ← lorentzMatterSpinSourceCoefficient_eq_formNativeLorentzMatterFirstCoefficient]
  change -(oneWedgeThreeSign (missingTripleOfOneForm triple) *
    lorentzMatterSpinCoordinates positiveSmoothUnifiedSource
      positiveSourceTargetMatterActual 0
      (missingTripleOfOneForm triple) internalPair) = _
  rw [positiveMatterSpinCoordinates_eq_normalForm]
  fin_cases internalPair <;> fin_cases triple <;>
    simp [positiveDiracDualSpinResponseNormalForm,
      positiveMatterSpinCoordinatesNormalForm,
      missingTripleOfOneForm, oneWedgeThreeSign]

