    fixedCoframeJet = positiveIdentityZeroCoframeJet := by
  unfold fixedCoframeJet positiveSourceTargetMatterActual
  rw [sourceActionGeneratedJointLocalActualLift_coframeFirstJetAt]
  rw [show positiveSourceTargetMatterCauchyState.coframe 0 = 1 by
    exact positiveSourceTargetMatterActual_coframe_one 0]
  rfl

private theorem
    positiveIdentityZeroCoframeJet_loweredLeviCivitaVector_eq_zero
    (first second : LorentzianIndex) :
    positiveIdentityZeroCoframeJet.loweredLeviCivitaVector first second = 0 := by
