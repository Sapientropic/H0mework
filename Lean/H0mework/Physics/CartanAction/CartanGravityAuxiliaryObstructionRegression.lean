/-- **Direct same-actual obstruction.**  Before any reaction is reinstalled,
the repaired-action Cartan actual has a literal nonzero `delta B` residual at
the selected coordinate.  The simplicity contribution is zero there, so the
value comes entirely from the newly generated live curvature. -/
theorem positiveDiracDualCartanConnection_auxiliaryResidual_zero_four :
    holonomicFormNativeGravityAuxiliaryEulerResidual
        positiveDiracDualCartanConnectionLocalActual 0 0 4 =
      -(1 / 16 : ℝ) := by
  rw [holonomicFormNativeGravityAuxiliaryEulerResidual_eq]
  change
    holonomicContravariantGravityCurvature
          positiveDiracDualCartanConnectionLocalActual 0 0 4 -
        gravityInternalDualEquiv
          (positiveDiracDualCartanConnectionLocalActual.gravityAuxiliary 0)
          0 4 +
        positiveDiracDualCartanConnectionLocalActual.gravitySimplicityMultiplier
          0 0 4 = _
  rw [positiveDiracDualCartanConnection_contravariantCurvature_zero_four,
    positiveDiracDualCartanConnectionLocalActual_simplicity 0,
    gravityInternalDualEquiv_physicalIIPlusBivector_eq_neg_coframeWedge,
    positiveDiracDualCartanConnection_coframe_one,
    positiveDiracDualCartanConnection_multiplier_zero]
  norm_num [coframeWedge, pairFirst, pairSecond, Matrix.one_apply]
  simp +decide

/-- The connection-only KIN-6 epoch is rejected by the action-derived
gravity-auxiliary equation on the very same actual. -/
theorem positiveDiracDualCartanConnection_not_auxiliaryEquation :
    ¬FormNativeGravityAuxiliaryEquation
      positiveDiracDualCartanConnectionLocalActual := by
  intro equation
  have atOrigin := congrFun equation 0
  have coordinate := congrFun (congrFun atOrigin 0) 4
  rw [positiveDiracDualCartanConnection_auxiliaryResidual_zero_four]
    at coordinate
  norm_num at coordinate

/-- Bundled positive/negative checkpoint.  KIN-6 remains a valid smooth,
exact-lineage torsion--spin producer; the new direct readout independently
shows that retaining the prior zero reaction does not close `delta B`. -/
theorem positiveDiracDualCartanGravityAuxiliaryObstruction_directRegression :
    positiveSmoothUnifiedSource.stageEight.generatedP506L0Lineage =
        canonicalP506SourceAffineL0ObservableLineageReference ∧
      positiveDiracDualCartanConnectionLocalActual.Smooth ∧
      FormNativeGravitySimplicityEquation
        positiveDiracDualCartanConnectionLocalActual ∧
      FormNativeIIPlusTorsionSpinEquation positiveSmoothUnifiedSource
        positiveDiracDualCartanConnectionLocalActual ∧
      holonomicFormNativeGravityAuxiliaryEulerResidual
          positiveDiracDualCartanConnectionLocalActual 0 0 4 =
        -(1 / 16 : ℝ) ∧
      ¬FormNativeGravityAuxiliaryEquation
