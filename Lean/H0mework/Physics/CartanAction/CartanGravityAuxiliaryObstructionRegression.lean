  rfl

private theorem
    positiveIdentityZeroCoframeJet_lorentzSpinConnectionMatrix_eq_zero
    (direction : LorentzianIndex) :
    positiveIdentityZeroCoframeJet.lorentzSpinConnectionMatrix direction = 0 := by
  unfold PointwiseLorentzianCoframeJet.lorentzSpinConnectionMatrix
  rw [positiveIdentityZeroCoframeJet_coordinateConnectionMatrix_eq_zero,
    positiveIdentityZeroCoframeJet_coframeDerivativeMatrix_eq_zero]
  simp

private theorem positiveIdentityZeroCoframeJet_lorentzSpinConnection_eq_zero :
    positiveIdentityZeroCoframeJet.lorentzSpinConnection = 0 := by
  funext formDirection internalOut internalIn
  change positiveIdentityZeroCoframeJet.lorentzSpinConnectionMatrix
      formDirection internalOut internalIn = 0
  rw [positiveIdentityZeroCoframeJet_lorentzSpinConnectionMatrix_eq_zero]
  rfl

/-- At the fixed contact KIN-4 adds the generated contorsion over the literal
zero Levi--Civita connection of the identity constant coframe. -/
theorem fixedActionCartanConnection_eq_positiveNormalForm :
    fixedActionCartanConnection =
      lorentzSkewConnectionOfBivectorOneForm
        positiveDiracDualCartanContorsionNormalForm := by
  change cartanAffineSpinConnection fixedCoframeJet
      (diracDualFormNativeActionCartanContorsionAt
        positiveSmoothUnifiedSource positiveSourceTargetMatterActual 0) = _
  rw [fixedActionCartanContorsion_eq_positiveNormalForm,
    fixedCoframeJet_eq_positiveIdentityZeroCoframeJet]
  unfold cartanAffineSpinConnection
  rw [positiveIdentityZeroCoframeJet_lorentzSpinConnection_eq_zero]
  simp

/-! ## Spatial slice constancy and live connection derivatives -/

/-- Continuous projection onto the time axis of the actual local chart. -/
private def positiveTimeAxisProjection : BasePoint →L[ℝ] BasePoint :=
  (localBaseCoordinate 0).smulRight (coordinateDirection 0)

private theorem positiveMatterField_timeAxisProjection
    (point : BasePoint) :
    positiveSourceTargetMatterActual.matter
        (positiveTimeAxisProjection point) =
      positiveSourceTargetMatterActual.matter point := by
  change actionGeneratedMatterLocalField
      positiveSourceTargetMatterCauchyState 0
        (positiveTimeAxisProjection point) =
    actionGeneratedMatterLocalField
      positiveSourceTargetMatterCauchyState 0 point
  apply matterCoordinateEquiv.injective
  simp [actionGeneratedMatterLocalField,
    actionGeneratedMatterLocalCoordinate,
    actionGeneratedMatterLocalIncrement,
    actionGeneratedMatterLocalJetCoordinate,
    cauchyMatterSpatialDerivativeCoordinate,
    positiveTimeAxisProjection, localBaseCoordinate, coordinateDirection,
    positiveSourceTargetMatterCauchyState, sourceTargetMatterCauchyState,
    Fin.sum_univ_four]

private theorem positiveConjugateMatterField_timeAxisProjection
    (point : BasePoint) :
    positiveSourceTargetMatterActual.conjugateMatter
        (positiveTimeAxisProjection point) =
      positiveSourceTargetMatterActual.conjugateMatter point := by
  change actionGeneratedConjugateMatterLocalField
      positiveSourceTargetMatterCauchyState 0
        (positiveTimeAxisProjection point) =
    actionGeneratedConjugateMatterLocalField
      positiveSourceTargetMatterCauchyState 0 point
  apply LinearMap.ext
  intro matter
  simp [actionGeneratedConjugateMatterLocalField,
    actionGeneratedConjugateMatterLocalJet,
    cauchyConjugateMatterSpatialDerivative,
    cauchyConjugateMatterSpatialDerivativeCoordinate,
    positiveTimeAxisProjection, localBaseCoordinate, coordinateDirection,
    positiveSourceTargetMatterCauchyState, sourceTargetMatterCauchyState,
    Fin.sum_univ_four]

private theorem positiveActionSpinResponse_timeAxisProjection
    (point : BasePoint) :
    diracDualFormNativeActionSpinResponseAt positiveSmoothUnifiedSource
        positiveSourceTargetMatterActual (positiveTimeAxisProjection point) =
      diracDualFormNativeActionSpinResponseAt positiveSmoothUnifiedSource
        positiveSourceTargetMatterActual point := by
  apply diracDualFormNativeActionSpinResponseAt_eq_of_fields_at_two_points
  · rw [positiveSourceTargetMatterActual_coframe_one,
      positiveSourceTargetMatterActual_coframe_one]
  · exact positiveMatterField_timeAxisProjection point
  · exact positiveConjugateMatterField_timeAxisProjection point

private theorem positiveGeneratedCartanConnectionField_timeAxisProjection
    (point : BasePoint) :
    sourceActionGeneratedDiracDualCartanConnectionField
        positiveSmoothUnifiedSource positiveSourceTargetMatterCauchyState 0
        (positiveTimeAxisProjection point) =
      sourceActionGeneratedDiracDualCartanConnectionField
        positiveSmoothUnifiedSource positiveSourceTargetMatterCauchyState 0
        point := by
  have response := positiveActionSpinResponse_timeAxisProjection point
  change
    diracDualFormNativeActionSpinResponseAt positiveSmoothUnifiedSource
        (sourceActionGeneratedJointLocalActualLift positiveSmoothUnifiedSource
          positiveSourceTargetMatterCauchyState 0)
        (positiveTimeAxisProjection point) =
      diracDualFormNativeActionSpinResponseAt positiveSmoothUnifiedSource
        (sourceActionGeneratedJointLocalActualLift positiveSmoothUnifiedSource
          positiveSourceTargetMatterCauchyState 0) point at response
  unfold sourceActionGeneratedDiracDualCartanConnectionField
    diracDualFormNativeActionCartanConnectionAt
    diracDualFormNativeActionCartanContorsionAt
    diracDualFormNativeActionCartanTorsionAt
  rw [sourceActionGeneratedJointLocalActualLift_coframeFirstJetAt,
    sourceActionGeneratedJointLocalActualLift_coframeFirstJetAt]
  rw [sourceActionGeneratedJointLocalActualLift_coframe_at,
    sourceActionGeneratedJointLocalActualLift_coframe_at, response]

private theorem canonicalCauchySlicePoint_zero_zero :
    canonicalCauchySlicePoint 0 0 = 0 := by
  ext direction
  fin_cases direction <;>
    simp [canonicalCauchySlicePoint, canonicalLorentzianTimeDirection,
      Fin.sum_univ_three]

private theorem scalarFieldDirectionalDerivative_spatial_eq_zero_of_slice_constant
    (field : BasePoint → ℝ)
    (fieldDifferentiable : DifferentiableAt ℝ field 0)
    (constant : ∀ space : StageNineSpatialPoint,
      field (canonicalCauchySlicePoint 0 space) = field 0)
    (axis : Fin 3) :
    fieldDirectionalDerivative field 0 axis.succ = 0 := by
  have sliceDerivative :=
    (show DifferentiableAt ℝ field (canonicalCauchySlicePoint 0 0) by
      rw [canonicalCauchySlicePoint_zero_zero]
      exact fieldDifferentiable).hasFDerivAt.comp
      (0 : StageNineSpatialPoint)
      (canonicalCauchySlicePoint_hasFDerivAt 0 0)
  rw [canonicalCauchySlicePoint_zero_zero] at sliceDerivative
  have sliceFDerivZero :
      fderiv ℝ (field ∘ canonicalCauchySlicePoint 0)
          (0 : StageNineSpatialPoint) =
        0 := by
    rw [show field ∘ canonicalCauchySlicePoint 0 =
        fun _ : StageNineSpatialPoint => field 0 by
      funext space
      exact constant space]
    simp
  rw [sliceDerivative.fderiv] at sliceFDerivZero
  have applied := congrArg
    (fun derivative : StageNineSpatialPoint →L[ℝ] ℝ =>
      derivative (canonicalSpatialCoordinateDirection axis))
    sliceFDerivZero
  unfold fieldDirectionalDerivative
  simpa [ContinuousLinearMap.comp_apply,
    canonicalSpatialInclusion_coordinateDirection] using applied

/-- Every spatial derivative of the live KIN-6 connection vanishes at the
origin because the positive affine matter germs depend only on the time-axis
coordinate and all KIN maps are recomputed pointwise. -/
theorem positiveDiracDualCartanConnection_spatialDerivative_zero
    (axis : Fin 3)
    (formDirection internalOut internalIn : LorentzianIndex) :
    gravityConnectionDerivative positiveDiracDualCartanConnectionLocalActual
        0 axis.succ formDirection internalOut internalIn = 0 := by
  apply scalarFieldDirectionalDerivative_spatial_eq_zero_of_slice_constant
  · exact
      (positiveDiracDualCartanConnectionLocalActual_smooth.2.1
        formDirection internalOut internalIn).differentiable (by simp)
        |>.differentiableAt
  · intro space
    have projection :=
      positiveGeneratedCartanConnectionField_timeAxisProjection
        (canonicalCauchySlicePoint 0 space)
    have projectedPoint :
        positiveTimeAxisProjection (canonicalCauchySlicePoint 0 space) = 0 := by
      ext direction
      fin_cases direction <;>
        simp [positiveTimeAxisProjection, canonicalCauchySlicePoint,
          canonicalLorentzianTimeDirection, localBaseCoordinate,
          coordinateDirection, Fin.sum_univ_three]
    change
      sourceActionGeneratedDiracDualCartanConnectionField
          positiveSmoothUnifiedSource positiveSourceTargetMatterCauchyState 0
          (canonicalCauchySlicePoint 0 space) formDirection internalOut
            internalIn =
        sourceActionGeneratedDiracDualCartanConnectionField
          positiveSmoothUnifiedSource positiveSourceTargetMatterCauchyState 0
          0 formDirection internalOut internalIn
    rw [← projectedPoint]
    exact congrFun (congrFun (congrFun projection.symm formDirection)
      internalOut) internalIn

