import H0mework.Physics.MotherProgrammesFormation.Declarations.Cumulative.AdmittedWorld.Generation
import H0mework.Physics.MotherProgrammesFormation.Declarations.Cumulative.ArenaFormation.Higher
import H0mework.Foundation.Authority.ZeroLawAdmission

set_option autoImplicit false

namespace SaturationMonoid.PhysicsCore.Stage10.SourceUniqueness.MotherAdmittedWorld
open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot ZeroLawRootAdmission
open scoped Classical
noncomputable section
universe u
variable {rank : Ordinal.{0}} {N : WorldRelationNetwork.{u}} {V : ConstructiveRoot.Vocabulary.{u}}

def anchor (rank : Ordinal.{0}) : MotherArenaHigher.Base rank :=
  (MotherArenaHigher.baseReadEquiv rank).symm (fun _ _ => 0)

/-- The only visit data formed by material are its chronological origin
and depth. The complete history is generated by the actual ledger root. -/
def formVisit (root : SourceNativeLedgerRootClosure N V) (material : MotherArenaHigher.Material rank) :
    Option (SourceNativeTemporalVisitAt root) :=
  generate root (if MotherArenaHigher.read rank material (anchor rank) 0 = 0 then false else true)
    (Nat.floor (MotherArenaHigher.read rank material (anchor rank) 1))

theorem every_visit_material (root : SourceNativeLedgerRootClosure N V) (visit : SourceNativeTemporalVisitAt root) :
    ∃ material : MotherArenaHigher.Material rank, formVisit root material = some visit := by
  obtain ⟨cofinal, steps, generated⟩ := every_visit root visit
  let reader : MotherArenaHigher.Base rank → Nat → ℝ := fun _ tag =>
    if tag = 0 then (if cofinal then 1 else 0) else steps
  obtain ⟨material, readback⟩ := MotherArenaHigher.read_surjective rank reader
  refine ⟨material, ?_⟩
  unfold formVisit
  rw [readback]
  cases cofinal <;>
    simpa only [reader, Bool.false_eq_true, if_false, ite_true,
      show ¬ (1 : Nat) = 0 from by decide, Nat.floor_natCast, one_ne_zero] using generated

abbrev HeaderAt (network : WorldRelationNetwork.{u}) :=
  Σ vocabulary : ConstructiveRoot.Vocabulary.{u}, SourceNativeAuthoritativeRootClosure network vocabulary

abbrev StateAt (network : WorldRelationNetwork.{u}) :=
  Σ vocabulary : ConstructiveRoot.Vocabulary.{u},
    Σ root : SourceNativeAuthoritativeRootClosure network vocabulary, LawfulWorldStateAt root

def formState (header : HeaderAt N) (material : MotherArenaHigher.Material rank) : Option (StateAt N) :=
  (formVisit header.2.toLedgerRoot material).map (fun visit => ⟨header.1, header.2, visit⟩)

theorem state_on_header (original : StateAt N) (header : HeaderAt N)
    (same : header = ⟨original.1, original.2.1⟩) :
    ∃ material : MotherArenaHigher.Material rank, formState header material = some original := by
  obtain ⟨material, formed⟩ := every_visit_material original.2.1.toLedgerRoot original.2.2
  refine ⟨material, ?_⟩
  rw [same, formState, formed]
  rfl

end
end SaturationMonoid.PhysicsCore.Stage10.SourceUniqueness.MotherAdmittedWorld
