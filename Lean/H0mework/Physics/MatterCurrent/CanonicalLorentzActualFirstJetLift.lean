/-! ## Exact actual family and complete phase readout -/

abbrev positiveP506MatterCurrentCanonicalLorentzActualFirstJetLift
    (space : StageNineSpatialPoint) : StageNineHolonomicConfiguration :=
  currentCanonicalFullActionLorentzActualFirstJetLift
    positiveSmoothUnifiedSource
    positiveP506MatterCurrentCanonicalGravityPreservingLorentzDualCurrentState
    space

abbrev positiveP506MatterCurrentCanonicalLorentzActualFirstJetPhaseReadout
    (time : Real) : StageNineLorentzCanonicalPhaseState :=
  currentCanonicalFullActionLorentzActualFirstJetPhaseReadout
    positiveSmoothUnifiedSource
    positiveP506MatterCurrentCanonicalGravityPreservingLorentzDualCurrentState
    time

theorem positiveP506MatterCurrentCanonicalLorentzActualFirstJetLift_smooth
    (space : StageNineSpatialPoint) :
    (positiveP506MatterCurrentCanonicalLorentzActualFirstJetLift
      space).Smooth :=
  currentCanonicalFullActionLorentzActualFirstJetLift_smooth
    positiveSmoothUnifiedSource
    positiveP506MatterCurrentCanonicalGravityPreservingLorentzDualCurrentState
    space

theorem
    positiveP506MatterCurrentCanonicalLorentzActualFirstJetLift_nondegenerate
    (space : StageNineSpatialPoint) :
    (positiveP506MatterCurrentCanonicalLorentzActualFirstJetLift
      space).Nondegenerate :=
  currentCanonicalFullActionLorentzActualFirstJetLift_nondegenerate
    positiveSmoothUnifiedSource
    positiveP506MatterCurrentCanonicalGravityPreservingLorentzDualCurrentState
    space
    (positiveP506MatterCurrentCompleteFirstGermCanonicalGeneratedZeroResponseState_coframe_one
