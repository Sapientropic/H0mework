/-- Exact actual-level faithful zero fiber for the complete Lorentz phase. -/
theorem
    positiveP506MatterCurrentCanonicalLorentzActualFirstJetPhaseReadout_unit_eq_initial_iff :
    positiveP506MatterCurrentCanonicalLorentzActualFirstJetPhaseReadout 1 =
          positiveP506MatterCurrentCanonicalLorentzActualFirstJetPhaseReadout 0 ↔
      positiveP506MatterCurrentCanonicalGravityPreservingLorentzCanonicalPhaseVelocity =
        zeroLorentzCanonicalPhaseVelocity := by
  exact
    currentCanonicalFullActionLorentzActualFirstJetPhaseReadout_unit_eq_initial_iff
      positiveSmoothUnifiedSource
      positiveP506MatterCurrentCanonicalGravityPreservingLorentzDualCurrentState
      positiveP506MatterCurrentCompleteFirstGermCanonicalGeneratedZeroResponseState_coframe_one

/-! ## Opaque future source-owned provenance transport -/

/-- A future event or branch provenance value may be transported beside the
physical actual.  The payload type is intentionally opaque to this module. -/
structure SourceOwnedProvenanceLorentzActual
    (Provenance : Type*) where
  sourceOwnedProvenance : Provenance
  actual : StageNineHolonomicConfiguration

/-- Outer transport only: the physical constructor receives no provenance
argument and therefore cannot inspect it or use it to choose a branch. -/
def transportSourceOwnedProvenanceToCanonicalLorentzActual
    {Provenance : Type*}
    (provenance : Provenance)
    (space : StageNineSpatialPoint) :
    SourceOwnedProvenanceLorentzActual Provenance where
  sourceOwnedProvenance := provenance
  actual := positiveP506MatterCurrentCanonicalLorentzActualFirstJetLift space

@[simp] theorem
    transportSourceOwnedProvenanceToCanonicalLorentzActual_provenance
    {Provenance : Type*}
    (provenance : Provenance)
    (space : StageNineSpatialPoint) :
    (transportSourceOwnedProvenanceToCanonicalLorentzActual provenance
      space).sourceOwnedProvenance =
      provenance :=
  rfl

@[simp] theorem transportSourceOwnedProvenanceToCanonicalLorentzActual_actual
    {Provenance : Type*}
    (provenance : Provenance)
    (space : StageNineSpatialPoint) :
    (transportSourceOwnedProvenanceToCanonicalLorentzActual provenance
      space).actual =
      positiveP506MatterCurrentCanonicalLorentzActualFirstJetLift space :=
  rfl

end


end SaturationMonoid.PhysicsCore.StageNineSourceActionGeneratedP506MatterCurrentCanonicalLorentzActualFirstJetLift
