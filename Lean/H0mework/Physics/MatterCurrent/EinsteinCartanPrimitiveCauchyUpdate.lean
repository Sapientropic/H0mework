import H0mework.Physics.ActionGeneration.JointPrimitiveCauchyUpdate
import H0mework.Physics.MatterCurrent.EinsteinCartanLocalActualLift

/-!
# S9-C3h149: P506 Einstein--Cartan primitive Cauchy update

C3h148 first lets the exact P506/L0 matter current generate a local actual
`U₀`, reads its actual Dirac spin action, and writes the resulting
Einstein--Cartan contorsion into a new primitive state.  This module restarts
the existing path-first joint action at that generated state:

```text
exact P506/L0 source
→ actual current Cartan germ U₀
→ actual spin action
→ fixed Einstein--Cartan contorsion
→ generated primitive feedback state
→ matching joint local action germ at every spatial contact
→ complete ten-field primitive Cauchy update
→ matching complete local actual at every response time.
```

The update is produced before any equation or residual is read.  The
connection tangent below is a faithful readout of the already generated
action path.  It is not supplied to the constructor: the gravity action
curvature contributes `-1`, the spatial derivative is zero, and the
contorsion bracket contributes `-3/16`, so the actual velocity is
`-13/16`.

This closes reachability of the complete instantaneous response from the
C3h148 feedback mouth.  It does not claim that the base primitive coframe
tangent is matter-stress-sensitive, that every department is nonzero, that
the affine germ is an autonomous integral flow, or that the full Stage-9
Euler--Lagrange shell is stationary.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineSourceActionGeneratedP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdate

open DiracExteriorMatterAction
open PointwiseDiracSpinConnectionLift
open ProofFreeRicherAnholonomicSource
open RepresentationArithmeticAtomProjectionDefect.BorromeanPreRealization
open StageEightSourceGeneratedMatter
open StageNineBlockwiseConstitutive
open StageNineCanonicalCauchyState
open StageNineEinsteinCartanSpinContorsionAction
open StageNineEnrichedProofFreeSource
open StageNineGravityGaugeActionLocalActualLift
open StageNineHolonomicField
open StageNineJointActionLocalActualLift
open StageNineLorentzActionCanonicalPairUpdate
open StageNineLorentzConnectionVariation
open StageNineP286ActionConnectionVelocity
open StageNineP286ActionCauchySplit
open StageNineSourceActionGeneratedCurrentTorsionFreeCartanPrimitiveCauchyDevelopment
open StageNineSourceActionGeneratedCurrentTorsionFreeCartanSecondJetTrajectoryActualResponse
open StageNineSourceActionGeneratedJointPrimitiveCauchyPath
open StageNineSourceActionGeneratedJointPrimitiveCauchyUpdate
open StageNineSourceActionGeneratedP506MatterCurrentCartanActual
open StageNineSourceActionGeneratedP506MatterCurrentEinsteinCartanLocalActualLift
open StageNineSourceGeneratedMatterSpinActionUpdate

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 5000000
set_option maxRecDepth 100000
set_option linter.unusedSimpArgs false

/-! ## Forward response constructor -/

/-- The complete primitive update generated by restarting the joint action
at the C3h148 Einstein--Cartan feedback state. -/
def positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdate
    (time : ℝ) :
    StageNineCauchyState :=
  sourceActionGeneratedJointPrimitiveCauchyUpdate
    positiveSmoothUnifiedSource time
    positiveP506MatterCurrentEinsteinCartanCauchyState

/-- At every response time and spatial contact, regenerate the complete
local actual from the state generated by the Cauchy update. -/
def positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyLocalActualLift
    (time : ℝ)
    (space : StageNineSpatialPoint) :
    StageNineHolonomicConfiguration :=
  sourceActionGeneratedJointLocalActualLift positiveSmoothUnifiedSource
    (positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdate time)
    space

/-! ## Uniform generated feedback data -/

theorem positiveP506MatterCurrentFeedbackBaseActual_coframe_origin
    (space : StageNineSpatialPoint) :
    (sourceActionGeneratedCurrentEinsteinCartanFeedbackBaseActual
      positiveSmoothUnifiedSource 0 0
      positiveSourceTargetMatterCauchyState space).coframe 0 =
      1 := by
  have law :=
    (positiveP506MatterCurrentCartanTrajectoryActualResponse_realizes
      |>.localActualGenerated 0 space)
  rw [show
    (sourceActionGeneratedCurrentEinsteinCartanFeedbackBaseActual
      positiveSmoothUnifiedSource 0 0
      positiveSourceTargetMatterCauchyState space).coframe 0 =
      (sourceActionGeneratedCurrentPrimitiveCauchyState
        positiveSmoothUnifiedSource 0
        (positiveP506MatterCurrentCartanTrajectoryState 0)).coframe space by
    exact law.coframeInitial]
  unfold positiveP506MatterCurrentCartanTrajectoryState
  rw [
    sourceActionGeneratedCurrentTorsionFreeCartanSecondJetTrajectoryState_currentIdentity]
  change
    (positiveP506MatterCurrentCartanTrajectoryState 0).coframe space = 1
  rw [positiveP506MatterCurrentCartanTrajectoryState_zero]
  simp [sourceActionGeneratedJointPrimitiveActionInitialState,
    positiveSourceTargetMatterCauchyState, sourceTargetMatterCauchyState,
    positivePhaseProbeCauchyState_eq_normalForm,
    positiveProbeCauchyStateNormalForm]

theorem positiveP506MatterCurrentFeedbackBaseActual_matter_origin
    (space : StageNineSpatialPoint) :
    (sourceActionGeneratedCurrentEinsteinCartanFeedbackBaseActual
      positiveSmoothUnifiedSource 0 0
      positiveSourceTargetMatterCauchyState space).matter 0 =
      diracSpinTwoMatterProbe := by
  have retained :=
    (positiveP506MatterCurrentCartanTrajectoryActualResponse_realizes
      |>.localActualGenerated 0 space |>.retainsActionFields)
  unfold
    StageNineStateDependentCartanCoframeFirstJetLocalActualLift.SourceActionCartanCoframeRetainedFields
    at retained
  unfold sourceActionGeneratedCurrentEinsteinCartanFeedbackBaseActual
  rw [retained.2.2.2.2.2.1]
  rw [sourceActionGeneratedJointLocalActualLift_initialMatter]
  rw [
    sourceActionGeneratedCurrentTorsionFreeCartanSecondJetTrajectoryState_currentIdentity]
  change
    (positiveP506MatterCurrentCartanTrajectoryState 0).matter space =
      diracSpinTwoMatterProbe
  rw [positiveP506MatterCurrentCartanTrajectoryState_zero]
  change positiveSourceTargetMatterCauchyState.matter space =
    diracSpinTwoMatterProbe
  simpa [positiveSourceTargetMatterCauchyState,
    sourceTargetMatterCauchyState] using
      positiveSourceTargetMatterCauchyState_matter

theorem positiveP506MatterCurrentFeedbackBaseActual_conjugate_origin
    (space : StageNineSpatialPoint) :
    (sourceActionGeneratedCurrentEinsteinCartanFeedbackBaseActual
      positiveSmoothUnifiedSource 0 0
      positiveSourceTargetMatterCauchyState space).conjugateMatter 0 =
      (diracSpinZeroMatterCoordinate :
        Module.Dual ℂ DiracExteriorMatterCarrier) := by
  have retained :=
    (positiveP506MatterCurrentCartanTrajectoryActualResponse_realizes
      |>.localActualGenerated 0 space |>.retainsActionFields)
  unfold
    StageNineStateDependentCartanCoframeFirstJetLocalActualLift.SourceActionCartanCoframeRetainedFields
    at retained
  unfold sourceActionGeneratedCurrentEinsteinCartanFeedbackBaseActual
  rw [retained.2.2.2.2.2.2]
  rw [sourceActionGeneratedJointLocalActualLift_initialConjugateMatter]
  rw [
    sourceActionGeneratedCurrentTorsionFreeCartanSecondJetTrajectoryState_currentIdentity]
  change
    (positiveP506MatterCurrentCartanTrajectoryState 0).conjugateMatter
        space =
      (diracSpinZeroMatterCoordinate :
        Module.Dual ℂ DiracExteriorMatterCarrier)
  rw [positiveP506MatterCurrentCartanTrajectoryState_zero]
  change positiveSourceTargetMatterCauchyState.conjugateMatter space =
    (diracSpinZeroMatterCoordinate :
      Module.Dual ℂ DiracExteriorMatterCarrier)
  simpa [positiveSourceTargetMatterCauchyState,
    sourceTargetMatterCauchyState] using
      positiveSourceTargetMatterCauchyState_conjugate

/-- The exact P506 spin action generated at the feedback mouth is uniform
over the declared homogeneous Cauchy slice. -/
theorem positiveP506MatterCurrentEinsteinCartanSpinCoordinates_allSpace
    (space : StageNineSpatialPoint) :
    sourceActionGeneratedCurrentEinsteinCartanSpinCoordinates
        positiveSmoothUnifiedSource 0 0
        positiveSourceTargetMatterCauchyState space =
      positiveP506MatterCurrentEinsteinCartanSpinCoordinates := by
  unfold sourceActionGeneratedCurrentEinsteinCartanSpinCoordinates
    positiveP506MatterCurrentEinsteinCartanSpinCoordinates
  apply actualMatterSpinActionCoordinates_eq_of_origin_fields
  · rw [
      positiveP506MatterCurrentFeedbackBaseActual_coframe_origin space,
      positiveP506MatterCurrentFeedbackBaseActual_coframe_origin 0]
  · rw [
      positiveP506MatterCurrentFeedbackBaseActual_matter_origin space,
      positiveP506MatterCurrentFeedbackBaseActual_matter_origin 0]
  · rw [
      positiveP506MatterCurrentFeedbackBaseActual_conjugate_origin space,
      positiveP506MatterCurrentFeedbackBaseActual_conjugate_origin 0]

theorem positiveP506MatterCurrentEinsteinCartanContorsion_allSpace
    (space : StageNineSpatialPoint) :
    sourceActionGeneratedCurrentEinsteinCartanContorsionCoordinates
        positiveSmoothUnifiedSource 0 0
        positiveSourceTargetMatterCauchyState space =
      positiveP506MatterCurrentEinsteinCartanContorsionCoordinates := by
  change
    einsteinCartanSpinContorsionCoordinates
        (sourceActionGeneratedCurrentEinsteinCartanSpinCoordinates
          positiveSmoothUnifiedSource 0 0
          positiveSourceTargetMatterCauchyState space) =
      einsteinCartanSpinContorsionCoordinates
        positiveP506MatterCurrentEinsteinCartanSpinCoordinates
  rw [positiveP506MatterCurrentEinsteinCartanSpinCoordinates_allSpace]

theorem positiveP506MatterCurrentCartanTrajectoryState_connection_allSpace_zero
    (space : StageNineSpatialPoint) :
    (positiveP506MatterCurrentCartanTrajectoryState 0).gravityConnection
        space =
      0 := by
  rw [positiveP506MatterCurrentCartanTrajectoryState_zero]
  funext formDirection internalOut internalIn
  simp [sourceActionGeneratedJointPrimitiveActionInitialState,
    positiveSourceTargetMatterCauchyState, sourceTargetMatterCauchyState,
    positivePhaseProbeCauchyState_eq_normalForm,
    positiveProbeCauchyStateNormalForm]

theorem positiveP506MatterCurrentEinsteinCartanCauchyState_connection_allSpace
    (space : StageNineSpatialPoint) :
    positiveP506MatterCurrentEinsteinCartanCauchyState.gravityConnection
        space =
      lorentzSkewConnectionOfBivectorOneForm
        positiveP506MatterCurrentEinsteinCartanContorsionCoordinates := by
  change
    (positiveP506MatterCurrentCartanTrajectoryState 0).gravityConnection
          space +
        lorentzSkewConnectionOfBivectorOneForm
          (sourceActionGeneratedCurrentEinsteinCartanContorsionCoordinates
            positiveSmoothUnifiedSource 0 0
            positiveSourceTargetMatterCauchyState space) =
      _
  rw [
    positiveP506MatterCurrentCartanTrajectoryState_connection_allSpace_zero,
    positiveP506MatterCurrentEinsteinCartanContorsion_allSpace,
    zero_add]

theorem positiveP506MatterCurrentEinsteinCartanCauchyState_coframe_allSpace
    (space : StageNineSpatialPoint) :
    positiveP506MatterCurrentEinsteinCartanCauchyState.coframe space =
      1 := by
  change
    (positiveP506MatterCurrentCartanTrajectoryState 0).coframe space = 1
  rw [positiveP506MatterCurrentCartanTrajectoryState_zero]
  simp [sourceActionGeneratedJointPrimitiveActionInitialState,
    positiveSourceTargetMatterCauchyState, sourceTargetMatterCauchyState,
    positivePhaseProbeCauchyState_eq_normalForm,
    positiveProbeCauchyStateNormalForm]

/-! ## Action-generated nonzero tangent -/

theorem
    positiveP506MatterCurrentEinsteinCartan_actionGravityCurvature_component :
    actionGeneratedGravityCurvature
        positiveP506MatterCurrentEinsteinCartanCauchyState 0 0 0 =
      -1 := by
  unfold actionGeneratedGravityCurvature actionGeneratedGravityAuxiliary
  rw [positiveP506MatterCurrentEinsteinCartanCauchyState_coframe_allSpace]
  change
    gravityInternalDualLinear
        (gravityInternalDualLinear (coframeWedge 1)) 0 0 =
      -1
  rw [gravityInternalDualLinear_square]
  norm_num [coframeWedge, pairFirst, pairSecond, Matrix.one_apply]

theorem
    positiveP506MatterCurrentEinsteinCartan_spatialConnectionDerivative_zero
    (direction : Fin 3)
    (internalPair : Fin 6) :
    cauchyLoweredLorentzSpatialConnectionDerivativeCoordinate
        positiveP506MatterCurrentEinsteinCartanCauchyState 0 direction
          canonicalLorentzianTimeDirection internalPair =
      0 := by
  unfold cauchyLoweredLorentzSpatialConnectionDerivativeCoordinate
  simp_rw [
    positiveP506MatterCurrentEinsteinCartanCauchyState_connection_allSpace]
  simp

theorem
    positiveP506MatterCurrentEinsteinCartan_connectionBracket_component :
    cauchyLoweredLorentzConnectionBracketCoordinate
        positiveP506MatterCurrentEinsteinCartanCauchyState 0
          canonicalLorentzianTimeDirection 1 0 =
      -(3 / 16 : ℝ) := by
  unfold cauchyLoweredLorentzConnectionBracketCoordinate
  simp_rw [
    positiveP506MatterCurrentEinsteinCartanCauchyState_connection_allSpace]
  rw [show
    positiveP506MatterCurrentEinsteinCartanContorsionCoordinates =
      einsteinCartanSpinContorsionCoordinates
        positiveP506MatterCurrentEinsteinCartanSpinCoordinates by
    rfl]
  rw [
    positiveP506MatterCurrentEinsteinCartanSpinCoordinates_eq_normalForm]
  simp [einsteinCartanSpinContorsionCoordinates,
    positiveP506MatterCurrentSpinCoordinatesNormalForm,
    lorentzSkewConnectionOfBivectorOneForm,
    loweredLorentzBivectorMatrix,
    orientedLorentzBivectorBasisCoefficient,
    pairFirst, pairSecond, lorentzBivectorFirst, lorentzBivectorSecond,
    minkowskiInternalSign, canonicalLorentzianTimeDirection,
    Fin.sum_univ_four, Fin.sum_univ_six]
  norm_num

/-- Actual action velocity after the generated contorsion is written back.
The `-13/16` is an output of the action curvature and the non-Abelian
connection bracket, not a source coefficient. -/
theorem
    positiveP506MatterCurrentEinsteinCartan_actionConnectionVelocity_component :
    actionGeneratedLorentzSpatialConnectionVelocity
        positiveP506MatterCurrentEinsteinCartanCauchyState 0 0 0 =
      -(13 / 16 : ℝ) := by
  unfold actionGeneratedLorentzSpatialConnectionVelocity
  simpa [temporalSpatialPair] using congrArg id
    (show
      actionGeneratedGravityCurvature
            positiveP506MatterCurrentEinsteinCartanCauchyState 0 0 0 +
          cauchyLoweredLorentzSpatialConnectionDerivativeCoordinate
            positiveP506MatterCurrentEinsteinCartanCauchyState 0 0
              canonicalLorentzianTimeDirection 0 -
          cauchyLoweredLorentzConnectionBracketCoordinate
            positiveP506MatterCurrentEinsteinCartanCauchyState 0
              canonicalLorentzianTimeDirection 1 0 =
        -(13 / 16 : ℝ) by
      rw [
        positiveP506MatterCurrentEinsteinCartan_actionGravityCurvature_component,
        positiveP506MatterCurrentEinsteinCartan_spatialConnectionDerivative_zero,
        positiveP506MatterCurrentEinsteinCartan_connectionBracket_component]
      norm_num)

theorem
    positiveP506MatterCurrentEinsteinCartan_primitiveVelocity_component :
    (sourceActionGeneratedJointPrimitiveCauchyVelocity
      positiveSmoothUnifiedSource
      positiveP506MatterCurrentEinsteinCartanCauchyState 0
      |>.gravityConnection 1 0) =
      -(13 / 16 : ℝ) := by
  change
    actionGeneratedLorentzSpatialConnectionVelocity
        positiveP506MatterCurrentEinsteinCartanCauchyState 0 0 0 =
      _
  exact
    positiveP506MatterCurrentEinsteinCartan_actionConnectionVelocity_component

theorem
    positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdate_connectionTangent :
    deriv
        (fun time : ℝ =>
          loweredLorentzConnectionCoefficient
            ((positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdate
              time).gravityConnection 0)
            1 0)
        0 =
      -(13 / 16 : ℝ) := by
  rw [show
    deriv
        (fun time : ℝ =>
          loweredLorentzConnectionCoefficient
            ((positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdate
              time).gravityConnection 0)
            1 0)
        0 =
      (sourceActionGeneratedJointPrimitiveCauchyVelocity
        positiveSmoothUnifiedSource
        positiveP506MatterCurrentEinsteinCartanCauchyState 0
        |>.gravityConnection 1 0) by
    exact
      sourceActionGeneratedJointPrimitiveCauchyUpdate_gravityConnectionTangent
        positiveSmoothUnifiedSource
        positiveP506MatterCurrentEinsteinCartanCauchyState 0 1 0]
  exact positiveP506MatterCurrentEinsteinCartan_primitiveVelocity_component

theorem
    positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdate_nonstatic :
    deriv
        (fun time : ℝ =>
          loweredLorentzConnectionCoefficient
            ((positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdate
              time).gravityConnection 0)
            1 0)
        0 ≠
      0 := by
  rw [
    positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdate_connectionTangent]
  norm_num

/-! ## Initial replay and complete producer law -/

theorem
    positiveP506MatterCurrentEinsteinCartanCauchyState_actionPrepared :
    sourceActionGeneratedJointPrimitiveActionInitialState
        positiveP506MatterCurrentEinsteinCartanCauchyState =
      positiveP506MatterCurrentEinsteinCartanCauchyState := by
  have prepared :=
    sourceActionGeneratedCurrentTorsionFreeCartanSecondJetTrajectoryState_actionPrepared
      positiveSmoothUnifiedSource 0 0 positiveSourceTargetMatterCauchyState
  have lifted := congrArg
    (fun candidate : StageNineCauchyState =>
      { candidate with
        gravityConnection :=
          positiveP506MatterCurrentEinsteinCartanCauchyState.gravityConnection })
    prepared
  simpa [positiveP506MatterCurrentEinsteinCartanCauchyState,
    sourceActionGeneratedCurrentEinsteinCartanFeedbackCauchyState,
    sourceActionGeneratedJointPrimitiveActionInitialState,
    actionGeneratedGravityAuxiliary] using lifted

@[simp] theorem
    positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdate_zero :
    positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdate 0 =
      positiveP506MatterCurrentEinsteinCartanCauchyState := by
  unfold positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdate
  rw [sourceActionGeneratedJointPrimitiveCauchyUpdate_zero,
    positiveP506MatterCurrentEinsteinCartanCauchyState_actionPrepared]

theorem
    positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyLocalActualLift_zero :
    positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyLocalActualLift
        0 0 =
      positiveP506MatterCurrentEinsteinCartanLocalActualLift := by
  rw [
    positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyLocalActualLift,
    positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdate_zero]
  rfl

structure
    PositiveP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdateLaw :
    Prop where
  exactP506L0Lineage :
    positiveSmoothUnifiedSource.stageEight.generatedP506L0Lineage =
      canonicalP506SourceAffineL0ObservableLineageReference
  feedbackActualGenerated :
    PositiveP506MatterCurrentEinsteinCartanLocalActualLaw
  feedbackStateActionPrepared :
    sourceActionGeneratedJointPrimitiveActionInitialState
        positiveP506MatterCurrentEinsteinCartanCauchyState =
      positiveP506MatterCurrentEinsteinCartanCauchyState
  fullPrimitiveUpdateGenerated :
    StageNineJointPrimitiveActionCauchyUpdateLaw
      positiveSmoothUnifiedSource
      positiveP506MatterCurrentEinsteinCartanCauchyState
      positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdate
  initialFeedbackState :
    positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdate 0 =
      positiveP506MatterCurrentEinsteinCartanCauchyState
  initialFeedbackActualReplayed :
    positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyLocalActualLift
        0 0 =
      positiveP506MatterCurrentEinsteinCartanLocalActualLift
  actionConnectionTangent :
    deriv
        (fun time : ℝ =>
          loweredLorentzConnectionCoefficient
            ((positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdate
              time).gravityConnection 0)
            1 0)
        0 =
      -(13 / 16 : ℝ)
  responseNonstatic :
    deriv
        (fun time : ℝ =>
          loweredLorentzConnectionCoefficient
            ((positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdate
              time).gravityConnection 0)
            1 0)
        0 ≠
      0

/-- Frontier theorem: the exact P506/L0 source-generated Einstein--Cartan
feedback state is in the image of the complete path-first primitive response
constructor.  Its local actual is replayed at the origin and the generated
response is dynamically nonstatic in a fixed Lorentz coordinate. -/
theorem
    positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdate_realizes :
    PositiveP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdateLaw := by
  exact
    { exactP506L0Lineage :=
        positiveSmoothUnifiedSource_generates_exactP506L0Lineage
      feedbackActualGenerated :=
        positiveP506MatterCurrentEinsteinCartanLocalActualLift_realizes
      feedbackStateActionPrepared :=
        positiveP506MatterCurrentEinsteinCartanCauchyState_actionPrepared
      fullPrimitiveUpdateGenerated := by
        change
          StageNineJointPrimitiveActionCauchyUpdateLaw
            positiveSmoothUnifiedSource
            positiveP506MatterCurrentEinsteinCartanCauchyState
            (fun time =>
              sourceActionGeneratedJointPrimitiveCauchyUpdate
                positiveSmoothUnifiedSource time
                positiveP506MatterCurrentEinsteinCartanCauchyState)
        exact
          sourceActionGeneratedJointPrimitiveCauchyUpdate_realizes
            positiveSmoothUnifiedSource
            positiveP506MatterCurrentEinsteinCartanCauchyState
      initialFeedbackState :=
        positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdate_zero
      initialFeedbackActualReplayed :=
        positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyLocalActualLift_zero
      actionConnectionTangent :=
        positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdate_connectionTangent
      responseNonstatic :=
        positiveP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdate_nonstatic }

end

end
  SaturationMonoid.PhysicsCore.StageNineSourceActionGeneratedP506MatterCurrentEinsteinCartanPrimitiveCauchyUpdate
