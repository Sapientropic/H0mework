/-! ## Generic source/action feedback constructor -/

/-- The already generated current torsion-free actual used as the feedback
mouth at one spatial contact. -/
def sourceActionGeneratedCurrentEinsteinCartanFeedbackBaseActual
    (source : SmoothUnifiedSource)
    (anchor trajectoryTime : ℝ)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    StageNineHolonomicConfiguration :=
  sourceActionGeneratedCurrentTorsionFreeCartanSecondJetTrajectoryLocalActualLift
    source anchor trajectoryTime state space

/-- Actual Dirac spin coordinates generated internally from the current
base actual. -/
def sourceActionGeneratedCurrentEinsteinCartanSpinCoordinates
    (source : SmoothUnifiedSource)
    (anchor trajectoryTime : ℝ)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    LorentzBivectorOneForm :=
  actualMatterSpinActionCoordinates source
    (sourceActionGeneratedCurrentEinsteinCartanFeedbackBaseActual
      source anchor trajectoryTime state space)
    0

/-- Action-normalized contorsion at every spatial contact. -/
def sourceActionGeneratedCurrentEinsteinCartanContorsionCoordinates
    (source : SmoothUnifiedSource)
    (anchor trajectoryTime : ℝ)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    LorentzBivectorOneForm :=
  einsteinCartanSpinContorsionCoordinates
    (sourceActionGeneratedCurrentEinsteinCartanSpinCoordinates
      source anchor trajectoryTime state space)

/-- Primitive current state after the internally generated contorsion is
added to its torsion-free Lorentz connection. -/
def sourceActionGeneratedCurrentEinsteinCartanFeedbackCauchyState
    (source : SmoothUnifiedSource)
    (anchor trajectoryTime : ℝ)
    (state : StageNineCauchyState) :
    StageNineCauchyState :=
  let current :=
    sourceActionGeneratedCurrentTorsionFreeCartanSecondJetTrajectoryState
      source anchor trajectoryTime state
  { current with
    gravityConnection := fun space =>
      current.gravityConnection space +
        lorentzSkewConnectionOfBivectorOneForm
          (sourceActionGeneratedCurrentEinsteinCartanContorsionCoordinates
            source anchor trajectoryTime state space) }

/-- New complete local actual generated after the primitive connection
feedback. -/
def sourceActionGeneratedCurrentEinsteinCartanFeedbackLocalActualLift
    (source : SmoothUnifiedSource)
    (anchor trajectoryTime : ℝ)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    StageNineHolonomicConfiguration :=
  sourceActionGeneratedJointLocalActualLift source
    (sourceActionGeneratedCurrentEinsteinCartanFeedbackCauchyState
      source anchor trajectoryTime state)
    space

theorem
    sourceActionGeneratedCurrentEinsteinCartanFeedbackLocalActualLift_connection_origin
    (source : SmoothUnifiedSource)
    (anchor trajectoryTime : ℝ)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    (sourceActionGeneratedCurrentEinsteinCartanFeedbackLocalActualLift
      source anchor trajectoryTime state space).gravityConnection 0 =
      (sourceActionGeneratedCurrentTorsionFreeCartanSecondJetTrajectoryState
        source anchor trajectoryTime state).gravityConnection space +
        lorentzSkewConnectionOfBivectorOneForm
          (sourceActionGeneratedCurrentEinsteinCartanContorsionCoordinates
            source anchor trajectoryTime state space) := by
  exact
    sourceActionGeneratedJointLocalActualLift_initialGravityConnection
      source
      (sourceActionGeneratedCurrentEinsteinCartanFeedbackCauchyState
        source anchor trajectoryTime state)
      space

