      positiveP506MatterCurrentEinsteinCartanSpinCoordinates
      (positiveP506MatterCurrentEinsteinCartanLocalActualLift_coframe 0)
      (positiveP506MatterCurrentEinsteinCartanLocalActualLift_gravityAuxiliary_eq
        0)
      positiveP506MatterCurrentEinsteinCartanLocalActualLift_connection_origin
      positiveP506MatterCurrentEinsteinCartanLocalActualLift_spinCoordinates
      direction

