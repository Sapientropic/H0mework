@[simp] theorem
    positiveP506MatterCurrentGravityCoupledLocalActualLift_conjugateMatter
    (point : BasePoint) :
    positiveP506MatterCurrentGravityCoupledLocalActualLift.conjugateMatter
        point =
      positiveP506MatterCurrentGravityCoupledBaseActual.conjugateMatter
        point :=
