import H0mework.Physics.Coframe.LinearPlebanskiGravityCoupledCoframeActionResponse
import H0mework.Physics.MatterCurrent.LinearPlebanskiTrajectoryLocalActionSystem
import H0mework.Physics.GravitySource.NormalizedAffineConnectionGerm

/-!
# S9-C3h157b: gravity-coupled P506 current local actual

C3h156 generates the current P506/L0 actual before any equation is read.
C3h157a then proves that the complete gravity-BF plus linear-Plebanski
coframe action has a unique response to the non-gravity action stress.  This
module installs that action response back into the same generated contact:

```text
proof-free P506/L0 source
→ C3h156 current actual at the generated contact
→ its gauge + scalar + matter action stress
→ gravity-coupled action response k
→ λ = ⋆ᵢ D II⁺(1)[k]
→ F = ⋆ᵢ B - λ
→ complete current local actual U₅.
```

Only the Lorentz first jet and the multiplier are updated.  The origin
connection, coframe, auxiliary, P286, scalar, matter, and dual fields remain
those of the same C3h156 current actual.  No residual, endpoint, inverse,
preimage, supplied stress, coefficient, source parameter, or branch receipt
is accepted by a constructor.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineSourceActionGeneratedP506MatterCurrentGravityCoupledLinearPlebanskiLocalActualLift

open DiracExteriorMatterAction
open ProofFreeRicherAnholonomicSource
open StageNineBlockwiseConstitutive
open StageNineCoframeSectorStress
open StageNineCoframeVariation
open StageNineDynamicBreakingVacuum
open StageNineEnrichedProofFreeSource
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineLinearPlebanskiCoframeActionPrincipal
open StageNineLinearPlebanskiGravityCoupledCoframeActionResponse
open StageNinePlebanskiMultiplierVariation
open StageNinePositiveSourceGravityMouthNormalizedAffineConnectionGerm
open StageNineSourceActionGeneratedP506MatterCurrentEinsteinCartanLocalActualLift
open StageNineSourceActionGeneratedP506MatterCurrentLinearPlebanskiLocalActualLift
open StageNineSourceActionGeneratedP506MatterCurrentLinearPlebanskiSynchronizedLocalActualLift
open StageNineSourceActionGeneratedP506MatterCurrentLinearPlebanskiTrajectoryLocalActionSystem
open StageNineSourceActionGeneratedP506MatterCurrentLinearPlebanskiTrajectoryRestart
open scoped ContDiff Matrix.Norms.Elementwise

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1000000
set_option maxRecDepth 100000
set_option synthInstance.maxHeartbeats 200000
set_option linter.unusedSimpArgs false

/-! ## Same-current-contact action data -/

/-- The already generated C3h156 current actual at its initial P506 contact. -/
def positiveP506MatterCurrentGravityCoupledBaseActual :
    StageNineHolonomicConfiguration :=
  positiveP506MatterCurrentLinearPlebanskiPrimitiveTrajectoryLocalActual 0 0

def positiveP506MatterCurrentGravityCoupledBaseField :
    StageNineContinuumPointField :=
  toContinuumPointField positiveP506MatterCurrentGravityCoupledBaseActual 0

/-- Complete non-gravity stress read from the same generated actual. -/
def positiveP506MatterCurrentNonGravityCoframeStress :
    LorentzianCoframe →L[ℝ] ℝ :=
  coframeGaugeSectorStressCovector positiveSmoothUnifiedSource
      positiveP506MatterCurrentGravityCoupledBaseField +
    coframeScalarSectorStressCovector positiveSmoothUnifiedSource 0
      positiveP506MatterCurrentGravityCoupledBaseField +
    coframeMatterSectorStressCovector positiveSmoothUnifiedSource 0
      positiveP506MatterCurrentGravityCoupledBaseField

/-- The full gravity-coupled response generated by the current action. -/
def positiveP506MatterCurrentGravityCoupledCoframeResponse :
    LorentzianCoframe :=
  gravityCoupledLinearPlebanskiCoframeResponseOfStress
    positiveP506MatterCurrentNonGravityCoframeStress

def positiveP506MatterCurrentGravityCoupledMultiplier : PhysicalBivector :=
  gravityCoupledLinearPlebanskiMultiplier
    positiveP506MatterCurrentGravityCoupledCoframeResponse

def positiveP506MatterCurrentGravityCoupledCurvatureTarget :
    PhysicalBivector :=
  gravityCoupledLinearPlebanskiCurvature
    positiveP506MatterCurrentGravityCoupledCoframeResponse

/-- `U₅`, generated from the same current contact by the complete coframe
action response and auxiliary curvature law. -/
def positiveP506MatterCurrentGravityCoupledLocalActualLift :
    StageNineHolonomicConfiguration :=
  { positiveP506MatterCurrentGravityCoupledBaseActual with
    gravityConnection :=
      normalizedAffineLorentzConnectionField
        (positiveP506MatterCurrentGravityCoupledBaseActual.gravityConnection 0)
        positiveP506MatterCurrentGravityCoupledCurvatureTarget
    gravitySimplicityMultiplier :=
      fun _ => positiveP506MatterCurrentGravityCoupledMultiplier }

theorem positiveP506MatterCurrentGravityCoupledCoframeResponse_actionBalance
    (variation : LorentzianCoframe) :
    linearPlebanskiCoframePrincipal
          positiveP506MatterCurrentGravityCoupledCoframeResponse variation +
        gravityBFCoframeFeedback
          positiveP506MatterCurrentGravityCoupledCoframeResponse variation +
        positiveP506MatterCurrentNonGravityCoframeStress variation =
      0 := by
  exact
    gravityCoupledLinearPlebanskiCoframeResponse_actionBalance_apply
      positiveP506MatterCurrentNonGravityCoframeStress variation

/-! ## Retained primitive fields and generated curvature -/

