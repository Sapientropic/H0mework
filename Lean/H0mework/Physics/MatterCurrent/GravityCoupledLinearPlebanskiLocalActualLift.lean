theorem positiveP506MatterCurrentGravityCoupledBaseActual_eq_synchronized :
    positiveP506MatterCurrentGravityCoupledBaseActual =
      positiveP506MatterCurrentLinearPlebanskiSynchronizedLocalActualLift := by
  exact
    positiveP506MatterCurrentLinearPlebanskiPrimitiveTrajectoryLocalActual_zero

theorem
    positiveP506MatterCurrentGravityCoupledLocalActualLift_gaugeConnection_zero :
    positiveP506MatterCurrentGravityCoupledLocalActualLift.gaugeConnection =
      0 := by
  change positiveP506MatterCurrentGravityCoupledBaseActual.gaugeConnection = 0
  rw [positiveP506MatterCurrentGravityCoupledBaseActual_eq_synchronized]
  exact
    positiveP506MatterCurrentLinearPlebanskiSynchronizedLocalActualLift_gaugeConnection_zero

theorem
    positiveP506MatterCurrentGravityCoupledLocalActualLift_gaugeAuxiliary_zero :
    positiveP506MatterCurrentGravityCoupledLocalActualLift.gaugeAuxiliary =
      0 := by
  change positiveP506MatterCurrentGravityCoupledBaseActual.gaugeAuxiliary = 0
  rw [positiveP506MatterCurrentGravityCoupledBaseActual_eq_synchronized]
  exact
    positiveP506MatterCurrentLinearPlebanskiSynchronizedLocalActualLift_gaugeAuxiliary_zero

theorem
    positiveP506MatterCurrentGravityCoupledLocalActualLift_scalar_vacuum :
    positiveP506MatterCurrentGravityCoupledLocalActualLift.scalar =
      fun _ =>
        sourceGeneratedVacuumCoordinates positiveSmoothUnifiedSource := by
  change
    positiveP506MatterCurrentGravityCoupledBaseActual.scalar =
      fun _ =>
        sourceGeneratedVacuumCoordinates positiveSmoothUnifiedSource
  rw [positiveP506MatterCurrentGravityCoupledBaseActual_eq_synchronized]
  exact
    positiveP506MatterCurrentLinearPlebanskiSynchronizedLocalActualLift_scalar_vacuum

theorem positiveP506MatterCurrentGravityCoupledLocalActualLift_matter_origin :
    positiveP506MatterCurrentGravityCoupledLocalActualLift.matter 0 =
      diracSpinTwoMatterProbe := by
  rw [positiveP506MatterCurrentGravityCoupledLocalActualLift_matter,
    positiveP506MatterCurrentGravityCoupledBaseActual_eq_synchronized,
    positiveP506MatterCurrentLinearPlebanskiSynchronizedLocalActualLift_matter_origin,
    positiveP506MatterCurrentLinearPlebanskiLocalActualLift_matter_origin,
    positiveP506MatterCurrentEinsteinCartanLocalActualLift_matter_origin]

theorem
    positiveP506MatterCurrentGravityCoupledLocalActualLift_conjugate_origin :
    positiveP506MatterCurrentGravityCoupledLocalActualLift.conjugateMatter 0 =
      (diracSpinZeroMatterCoordinate :
        Module.Dual ℂ DiracExteriorMatterCarrier) := by
  rw [positiveP506MatterCurrentGravityCoupledLocalActualLift_conjugateMatter,
    positiveP506MatterCurrentGravityCoupledBaseActual_eq_synchronized,
    positiveP506MatterCurrentLinearPlebanskiSynchronizedLocalActualLift_conjugate_origin,
    positiveP506MatterCurrentLinearPlebanskiLocalActualLift_conjugate_origin,
    positiveP506MatterCurrentEinsteinCartanLocalActualLift_conjugate_origin]

theorem
    positiveP506MatterCurrentGravityCoupledLocalActualLift_scalarCovariantDerivative_zero
    (point : BasePoint) (direction : LorentzianIndex) :
    holonomicScalarCovariantDerivative
        positiveP506MatterCurrentGravityCoupledLocalActualLift point direction =
      0 := by
  unfold holonomicScalarCovariantDerivative
  rw [positiveP506MatterCurrentGravityCoupledLocalActualLift_scalar_vacuum,
    positiveP506MatterCurrentGravityCoupledLocalActualLift_gaugeConnection_zero]
  simp [fieldDirectionalDerivative]

theorem positiveP506MatterCurrentGravityCoupledLocalActualLift_coframe_one
    (point : BasePoint) :
    positiveP506MatterCurrentGravityCoupledLocalActualLift.coframe point =
      1 := by
  rw [positiveP506MatterCurrentGravityCoupledLocalActualLift_coframe,
    positiveP506MatterCurrentGravityCoupledBaseActual_eq_synchronized]
  exact
    positiveP506MatterCurrentLinearPlebanskiSynchronizedLocalActualLift_coframe
      point

theorem
    positiveP506MatterCurrentGravityCoupledLocalActualLift_auxiliary_eq
    (point : BasePoint) :
    positiveP506MatterCurrentGravityCoupledLocalActualLift.gravityAuxiliary
        point =
      physicalIIPlusBivector (1 : LorentzianCoframe) := by
  rw [positiveP506MatterCurrentGravityCoupledLocalActualLift_gravityAuxiliary,
    positiveP506MatterCurrentGravityCoupledBaseActual_eq_synchronized]
  exact
    positiveP506MatterCurrentLinearPlebanskiSynchronizedLocalActualLift_auxiliary
      point

theorem
    positiveP506MatterCurrentGravityCoupledLocalActualLift_connection_origin :
    positiveP506MatterCurrentGravityCoupledLocalActualLift.gravityConnection
        0 =
      positiveP506MatterCurrentGravityCoupledBaseActual.gravityConnection
        0 := by
  exact
    normalizedAffineLorentzConnectionField_zero
      (positiveP506MatterCurrentGravityCoupledBaseActual.gravityConnection 0)
      positiveP506MatterCurrentGravityCoupledCurvatureTarget

theorem positiveP506MatterCurrentGravityCoupledLocalActualLift_curvature_origin :
    holonomicGravityCurvature
        positiveP506MatterCurrentGravityCoupledLocalActualLift 0 =
      positiveP506MatterCurrentGravityCoupledCurvatureTarget := by
  change
    holonomicGravityCurvature
        (normalizedAffineConfiguration
          (positiveP506MatterCurrentGravityCoupledBaseActual.gravityConnection
            0)
          positiveP506MatterCurrentGravityCoupledCurvatureTarget)
        0 =
      positiveP506MatterCurrentGravityCoupledCurvatureTarget
  exact
    holonomicGravityCurvature_normalizedAffineConfiguration_zero _ _

theorem
    positiveP506MatterCurrentGravityCoupledLocalActualLift_auxiliaryBalance :
    holonomicGravityCurvature
          positiveP506MatterCurrentGravityCoupledLocalActualLift 0 -
        gravityInternalDualEquiv
          (positiveP506MatterCurrentGravityCoupledLocalActualLift.gravityAuxiliary
            0) +
        positiveP506MatterCurrentGravityCoupledLocalActualLift.gravitySimplicityMultiplier
          0 =
      0 := by
  rw [positiveP506MatterCurrentGravityCoupledLocalActualLift_curvature_origin,
    positiveP506MatterCurrentGravityCoupledLocalActualLift_auxiliary_eq,
    positiveP506MatterCurrentGravityCoupledLocalActualLift_multiplier]
  unfold positiveP506MatterCurrentGravityCoupledCurvatureTarget
    gravityCoupledLinearPlebanskiCurvature
    positiveP506MatterCurrentGravityCoupledMultiplier
  abel

theorem positiveP506MatterCurrentGravityCoupledLocalActualLift_simplicity :
    GravitySimplicityEquation
      positiveP506MatterCurrentGravityCoupledLocalActualLift := by
  intro point
  rw [positiveP506MatterCurrentGravityCoupledLocalActualLift_auxiliary_eq,
    positiveP506MatterCurrentGravityCoupledLocalActualLift_coframe_one]

theorem positiveP506MatterCurrentGravityCoupledLocalActualLift_nondegenerate :
    positiveP506MatterCurrentGravityCoupledLocalActualLift.Nondegenerate := by
  intro point
  rw [positiveP506MatterCurrentGravityCoupledLocalActualLift_coframe_one]
  simp

theorem positiveP506MatterCurrentGravityCoupledLocalActualLift_smooth :
    positiveP506MatterCurrentGravityCoupledLocalActualLift.Smooth := by
  have baseSmooth : positiveP506MatterCurrentGravityCoupledBaseActual.Smooth := by
    exact
      positiveP506MatterCurrentLinearPlebanskiPrimitiveTrajectoryLocalActual_smooth
        0 0
  rcases baseSmooth with
    ⟨coframeSmooth, _gravityConnectionSmooth, gravityAuxiliarySmooth,
      _gravityMultiplierSmooth, gaugeConnectionSmooth,
      gaugeAuxiliarySmooth, scalarSmooth, matterSmooth,
      conjugateMatterSmooth⟩
  exact
    ⟨coframeSmooth,
      normalizedAffineLorentzConnectionField_smooth _ _,
      gravityAuxiliarySmooth,
      by
        intro internalPair spacetimePair
        change ContDiff ℝ ∞ fun _ : BasePoint =>
          positiveP506MatterCurrentGravityCoupledMultiplier
            internalPair spacetimePair
        fun_prop,
      gaugeConnectionSmooth, gaugeAuxiliarySmooth, scalarSmooth,
      matterSmooth, conjugateMatterSmooth⟩

/-! ## Complete same-actual coframe action derivative -/

def positiveP506MatterCurrentGravityCoupledOriginField :
    StageNineContinuumPointField :=
  toContinuumPointField
    positiveP506MatterCurrentGravityCoupledLocalActualLift 0

theorem positiveP506MatterCurrentGravityCoupledBaseField_coframe :
    positiveP506MatterCurrentGravityCoupledBaseField.coframe = 1 := by
  change positiveP506MatterCurrentGravityCoupledBaseActual.coframe 0 = 1
  rw [positiveP506MatterCurrentGravityCoupledBaseActual_eq_synchronized]
  exact
    positiveP506MatterCurrentLinearPlebanskiSynchronizedLocalActualLift_coframe
      0

theorem positiveP506MatterCurrentGravityCoupledOriginField_coframe :
    positiveP506MatterCurrentGravityCoupledOriginField.coframe = 1 := by
  exact
    positiveP506MatterCurrentGravityCoupledLocalActualLift_coframe_one 0

theorem
    positiveP506MatterCurrentGravityCoupledOriginField_matterCovariantDerivative :
    positiveP506MatterCurrentGravityCoupledOriginField.matterCovariantDerivative =
      positiveP506MatterCurrentGravityCoupledBaseField.matterCovariantDerivative := by
  funext direction
  change
    holonomicMatterCovariantDerivative
        positiveP506MatterCurrentGravityCoupledLocalActualLift 0 direction =
      holonomicMatterCovariantDerivative
        positiveP506MatterCurrentGravityCoupledBaseActual 0 direction
  unfold holonomicMatterCovariantDerivative
  rw [positiveP506MatterCurrentGravityCoupledLocalActualLift_connection_origin]
  rfl

theorem positiveP506MatterCurrentGravityCoupledOriginField_scalar :
    positiveP506MatterCurrentGravityCoupledOriginField.scalar =
      positiveP506MatterCurrentGravityCoupledBaseField.scalar := by
  change
    positiveP506MatterCurrentGravityCoupledLocalActualLift.scalar 0 =
      positiveP506MatterCurrentGravityCoupledBaseActual.scalar 0
  exact positiveP506MatterCurrentGravityCoupledLocalActualLift_scalar 0

theorem positiveP506MatterCurrentGravityCoupledOriginField_matter :
    positiveP506MatterCurrentGravityCoupledOriginField.matter =
      positiveP506MatterCurrentGravityCoupledBaseField.matter := by
  change
    positiveP506MatterCurrentGravityCoupledLocalActualLift.matter 0 =
      positiveP506MatterCurrentGravityCoupledBaseActual.matter 0
  exact positiveP506MatterCurrentGravityCoupledLocalActualLift_matter 0

theorem positiveP506MatterCurrentGravityCoupledOriginField_conjugateMatter :
    positiveP506MatterCurrentGravityCoupledOriginField.conjugateMatter =
      positiveP506MatterCurrentGravityCoupledBaseField.conjugateMatter := by
  change
    positiveP506MatterCurrentGravityCoupledLocalActualLift.conjugateMatter 0 =
      positiveP506MatterCurrentGravityCoupledBaseActual.conjugateMatter 0
  exact
    positiveP506MatterCurrentGravityCoupledLocalActualLift_conjugateMatter 0

private theorem coframeDensity_affinePath_hasDerivAt
    (density : LorentzianCoframe → ℝ)
    (derivative : LorentzianCoframe →L[ℝ] ℝ)
    (hasDerivative : HasFDerivAt density derivative
      (1 : LorentzianCoframe))
    (variation : LorentzianCoframe) :
    HasDerivAt
      (fun parameter : ℝ =>
        density ((1 : LorentzianCoframe) + parameter • variation))
      (derivative variation) 0 := by
  have identityDerivative := hasDerivAt_id (x := (0 : ℝ))
  have variationDerivative := identityDerivative.smul_const variation
  have variationDerivativeValue :
      (1 : ℝ) • variation = variation := by
    simp
  have variationDerivativeAtZero :=
    variationDerivative.congr_deriv variationDerivativeValue
  have pathDerivative :=
    variationDerivativeAtZero.const_add (1 : LorentzianCoframe)
  have pointEquality :
      (1 : LorentzianCoframe) =
        (1 : LorentzianCoframe) + (0 : ℝ) • variation := by
    simp
  exact
    hasDerivative.comp_hasDerivAt_of_eq
      (0 : ℝ) pathDerivative pointEquality

/-- Complete current coframe density: gravity BF, linear Plebanski, and all
three non-gravity sectors evaluated on the same generated contact. -/
def positiveP506MatterCurrentGravityCoupledCoframeActionDensity
    (candidate : LorentzianCoframe) : ℝ :=
  gravityCoupledLinearPlebanskiBFCoframeDensity
      positiveP506MatterCurrentGravityCoupledCoframeResponse candidate +
    linearPlebanskiSimplicityDensity
      (physicalIIPlusBivector (1 : LorentzianCoframe))
      positiveP506MatterCurrentGravityCoupledMultiplier candidate +
    coframeGaugeSectorLocalDensity positiveSmoothUnifiedSource
      positiveP506MatterCurrentGravityCoupledBaseField candidate +
    coframeScalarSectorLocalDensity positiveSmoothUnifiedSource 0
      positiveP506MatterCurrentGravityCoupledBaseField candidate +
    coframeMatterSectorLocalDensity positiveSmoothUnifiedSource 0
      positiveP506MatterCurrentGravityCoupledBaseField candidate

/-- The full coframe action is stationary in every coframe direction at the
same generated P506 current contact. -/
theorem positiveP506MatterCurrentGravityCoupledCoframeAction_path_hasDerivAt
    (variation : LorentzianCoframe) :
    HasDerivAt
      (fun parameter : ℝ =>
        positiveP506MatterCurrentGravityCoupledCoframeActionDensity
          ((1 : LorentzianCoframe) + parameter • variation))
      0 0 := by
  have gravityDerivative :=
    gravityCoupledLinearPlebanskiBFCoframeDensity_path_hasDerivAt
      positiveP506MatterCurrentGravityCoupledCoframeResponse variation
  have linearDerivative :=
    linearPlebanskiSimplicityDensity_path_hasDerivAt
      positiveP506MatterCurrentGravityCoupledCoframeResponse variation
  have baseNondegenerate :
      Matrix.det positiveP506MatterCurrentGravityCoupledBaseField.coframe ≠
        0 := by
    rw [positiveP506MatterCurrentGravityCoupledBaseField_coframe]
    simp
  have gaugeHasDerivative :=
    coframeGaugeSectorLocalDensity_hasFDerivAt positiveSmoothUnifiedSource
      positiveP506MatterCurrentGravityCoupledBaseField baseNondegenerate
  rw [positiveP506MatterCurrentGravityCoupledBaseField_coframe]
    at gaugeHasDerivative
  have gaugeDerivative :=
    coframeDensity_affinePath_hasDerivAt
      (coframeGaugeSectorLocalDensity positiveSmoothUnifiedSource
        positiveP506MatterCurrentGravityCoupledBaseField)
      (coframeGaugeSectorStressCovector positiveSmoothUnifiedSource
        positiveP506MatterCurrentGravityCoupledBaseField)
      gaugeHasDerivative
      variation
  have scalarHasDerivative :=
    coframeScalarSectorLocalDensity_hasFDerivAt positiveSmoothUnifiedSource
      0 positiveP506MatterCurrentGravityCoupledBaseField baseNondegenerate
  rw [positiveP506MatterCurrentGravityCoupledBaseField_coframe]
    at scalarHasDerivative
  have scalarDerivative :=
    coframeDensity_affinePath_hasDerivAt
      (coframeScalarSectorLocalDensity positiveSmoothUnifiedSource 0
        positiveP506MatterCurrentGravityCoupledBaseField)
      (coframeScalarSectorStressCovector positiveSmoothUnifiedSource 0
        positiveP506MatterCurrentGravityCoupledBaseField)
      scalarHasDerivative
      variation
  have matterHasDerivative :=
    coframeMatterSectorLocalDensity_hasFDerivAt positiveSmoothUnifiedSource
      0 positiveP506MatterCurrentGravityCoupledBaseField baseNondegenerate
  rw [positiveP506MatterCurrentGravityCoupledBaseField_coframe]
    at matterHasDerivative
  have matterDerivative :=
    coframeDensity_affinePath_hasDerivAt
      (coframeMatterSectorLocalDensity positiveSmoothUnifiedSource 0
        positiveP506MatterCurrentGravityCoupledBaseField)
      (coframeMatterSectorStressCovector positiveSmoothUnifiedSource 0
        positiveP506MatterCurrentGravityCoupledBaseField)
      matterHasDerivative
      variation
  have combined :=
    (((gravityDerivative.add linearDerivative).add gaugeDerivative).add
      scalarDerivative).add matterDerivative
  have derivativeZero :
      gravityBFCoframeFeedback
            positiveP506MatterCurrentGravityCoupledCoframeResponse variation +
          linearPlebanskiCoframePrincipalValue
            positiveP506MatterCurrentGravityCoupledCoframeResponse variation +
          coframeGaugeSectorStressCovector positiveSmoothUnifiedSource
              positiveP506MatterCurrentGravityCoupledBaseField variation +
          coframeScalarSectorStressCovector positiveSmoothUnifiedSource 0
              positiveP506MatterCurrentGravityCoupledBaseField variation +
          coframeMatterSectorStressCovector positiveSmoothUnifiedSource 0
              positiveP506MatterCurrentGravityCoupledBaseField variation =
        0 := by
    have balance :=
      positiveP506MatterCurrentGravityCoupledCoframeResponse_actionBalance
        variation
    rw [linearPlebanskiCoframePrincipalValue_eq_principal]
    change
      linearPlebanskiCoframePrincipal
            positiveP506MatterCurrentGravityCoupledCoframeResponse variation +
          gravityBFCoframeFeedback
            positiveP506MatterCurrentGravityCoupledCoframeResponse variation +
          ((coframeGaugeSectorStressCovector positiveSmoothUnifiedSource
                positiveP506MatterCurrentGravityCoupledBaseField +
              coframeScalarSectorStressCovector positiveSmoothUnifiedSource 0
                positiveP506MatterCurrentGravityCoupledBaseField) +
            coframeMatterSectorStressCovector positiveSmoothUnifiedSource 0
              positiveP506MatterCurrentGravityCoupledBaseField) variation =
        0 at balance
    simp only [add_apply] at balance
    linarith
  exact combined.congr_deriv derivativeZero

end

end
  SaturationMonoid.PhysicsCore.StageNineSourceActionGeneratedP506MatterCurrentGravityCoupledLinearPlebanskiLocalActualLift
