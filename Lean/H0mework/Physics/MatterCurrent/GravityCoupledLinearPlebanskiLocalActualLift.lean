@[simp] theorem positiveP506MatterCurrentGravityCoupledLocalActualLift_matter
    (point : BasePoint) :
    positiveP506MatterCurrentGravityCoupledLocalActualLift.matter point =
      positiveP506MatterCurrentGravityCoupledBaseActual.matter point :=
