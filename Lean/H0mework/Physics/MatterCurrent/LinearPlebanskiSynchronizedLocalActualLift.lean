/-! ## Linear-Plebanski action target and unique temporal response -/

/-- Curvature generated by the linear-Plebanski auxiliary action on a
primitive Cauchy state.  The multiplier is a dynamical field of `state`; it
is not supplied separately to this producer. -/
def linearPlebanskiActionGeneratedGravityCurvature
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) : PhysicalBivector :=
  gravityInternalDualEquiv
      (actionGeneratedGravityAuxiliary state space) -
    state.gravitySimplicityMultiplier space

/-- The temporal-spatial Lorentz connection velocity forced by the
linear-Plebanski curvature target and the actual spatial Cauchy jet. -/
def linearPlebanskiActionGeneratedLorentzSpatialConnectionVelocity
    (state : StageNineCauchyState) :
    StageNineSpatialPoint → Fin 3 → Fin 6 → ℝ :=
  fun space direction internalPair =>
    linearPlebanskiActionGeneratedGravityCurvature state space internalPair
        (temporalSpatialPair direction) +
      cauchyLoweredLorentzSpatialConnectionDerivativeCoordinate state
        space direction canonicalLorentzianTimeDirection internalPair -
      cauchyLoweredLorentzConnectionBracketCoordinate state space
        canonicalLorentzianTimeDirection direction.succ internalPair

/-- Downstream equation for a candidate temporal Lorentz response. -/
def LinearPlebanskiLorentzActionGeneratedSpatialVelocityLaw
    (state : StageNineCauchyState)
    (velocity : StageNineSpatialPoint → Fin 3 → Fin 6 → ℝ) : Prop :=
  ∀ space direction internalPair,
    lorentzTemporalSpatialCurvatureCoordinate state velocity space direction
        internalPair =
      linearPlebanskiActionGeneratedGravityCurvature state space internalPair
        (temporalSpatialPair direction)

theorem
    linearPlebanskiActionGeneratedLorentzSpatialConnectionVelocity_satisfies_actionLaw
    (state : StageNineCauchyState) :
    LinearPlebanskiLorentzActionGeneratedSpatialVelocityLaw state
      (linearPlebanskiActionGeneratedLorentzSpatialConnectionVelocity
        state) := by
  intro space direction internalPair
  unfold lorentzTemporalSpatialCurvatureCoordinate
    linearPlebanskiActionGeneratedLorentzSpatialConnectionVelocity
  abel

/-- The action equation leaves no temporal-response branch choice once the
Cauchy state is fixed. -/
theorem linearPlebanskiLorentzActionGeneratedSpatialVelocityLaw_unique
    (state : StageNineCauchyState)
    (first second : StageNineSpatialPoint → Fin 3 → Fin 6 → ℝ)
    (firstLaw :
      LinearPlebanskiLorentzActionGeneratedSpatialVelocityLaw state first)
    (secondLaw :
      LinearPlebanskiLorentzActionGeneratedSpatialVelocityLaw state second) :
    first = second := by
  funext space direction internalPair
  have firstEquation := firstLaw space direction internalPair
  have secondEquation := secondLaw space direction internalPair
  unfold lorentzTemporalSpatialCurvatureCoordinate at firstEquation secondEquation
  linarith

/-! ## Action-generated Lorentz first jet -/

def linearPlebanskiActionGeneratedLorentzExteriorDerivativeCoordinate
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (internalPair spacetimePair : Fin 6) : ℝ :=
  linearPlebanskiActionGeneratedGravityCurvature state space internalPair
      spacetimePair -
    cauchyLoweredLorentzConnectionBracketCoordinate state space
      (pairFirst spacetimePair) (pairSecond spacetimePair) internalPair

def linearPlebanskiActionGeneratedLorentzLocalConnectionJet
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (derivativeDirection formDirection : LorentzianIndex)
    (internalPair : Fin 6) : ℝ :=
  ![
    ![
      0,
      linearPlebanskiActionGeneratedLorentzSpatialConnectionVelocity state
        space 0 internalPair,
      linearPlebanskiActionGeneratedLorentzSpatialConnectionVelocity state
        space 1 internalPair,
      linearPlebanskiActionGeneratedLorentzSpatialConnectionVelocity state
        space 2 internalPair
    ],
    ![
      cauchyLoweredLorentzSpatialConnectionDerivativeCoordinate state space
        0 canonicalLorentzianTimeDirection internalPair,
      0,
      (1 / 2 : ℝ) *
        linearPlebanskiActionGeneratedLorentzExteriorDerivativeCoordinate
          state space internalPair 5,
      -((1 / 2 : ℝ) *
        linearPlebanskiActionGeneratedLorentzExteriorDerivativeCoordinate
          state space internalPair 4)
    ],
    ![
      cauchyLoweredLorentzSpatialConnectionDerivativeCoordinate state space
        1 canonicalLorentzianTimeDirection internalPair,
      -((1 / 2 : ℝ) *
        linearPlebanskiActionGeneratedLorentzExteriorDerivativeCoordinate
          state space internalPair 5),
      0,
      (1 / 2 : ℝ) *
        linearPlebanskiActionGeneratedLorentzExteriorDerivativeCoordinate
          state space internalPair 3
    ],
    ![
      cauchyLoweredLorentzSpatialConnectionDerivativeCoordinate state space
        2 canonicalLorentzianTimeDirection internalPair,
      (1 / 2 : ℝ) *
        linearPlebanskiActionGeneratedLorentzExteriorDerivativeCoordinate
          state space internalPair 4,
      -((1 / 2 : ℝ) *
        linearPlebanskiActionGeneratedLorentzExteriorDerivativeCoordinate
          state space internalPair 3),
      0
    ]
  ] derivativeDirection formDirection

def linearPlebanskiActionGeneratedLorentzLocalIncrement
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (formDirection : LorentzianIndex)
    (internalPair : Fin 6) : BasePoint →L[ℝ] ℝ :=
  ∑ derivativeDirection : LorentzianIndex,
    (localBaseCoordinate derivativeDirection).smulRight
      (linearPlebanskiActionGeneratedLorentzLocalConnectionJet state space
        derivativeDirection formDirection internalPair)

def linearPlebanskiActionGeneratedLorentzLocalBivectorIncrement
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (point : BasePoint) : LorentzBivectorOneForm :=
  fun formDirection internalPair =>
    linearPlebanskiActionGeneratedLorentzLocalIncrement state space
      formDirection internalPair point

def linearPlebanskiActionGeneratedLorentzLocalConnectionCoordinate
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (point : BasePoint)
    (formDirection : LorentzianIndex)
    (internalPair : Fin 6) : ℝ :=
  loweredLorentzConnectionCoefficient
      (state.gravityConnection space) formDirection internalPair +
    linearPlebanskiActionGeneratedLorentzLocalIncrement state space
      formDirection internalPair point

/-- Primitive Lorentz connection germ generated from the state and the
linear-Plebanski action. -/
def linearPlebanskiActionGeneratedLorentzLocalConnection
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) : LorentzConnectionField :=
  fun point =>
    state.gravityConnection space +
      lorentzSkewConnectionOfBivectorOneForm
        (linearPlebanskiActionGeneratedLorentzLocalBivectorIncrement
          state space point)

theorem linearPlebanskiActionGeneratedLorentzLocalConnection_loweredCoordinate
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (point : BasePoint)
    (formDirection : LorentzianIndex)
    (internalPair : Fin 6) :
    loweredLorentzConnectionCoefficient
        (linearPlebanskiActionGeneratedLorentzLocalConnection state space
          point)
        formDirection internalPair =
      linearPlebanskiActionGeneratedLorentzLocalConnectionCoordinate state
        space point formDirection internalPair := by
  rw [show
    linearPlebanskiActionGeneratedLorentzLocalConnection state space point =
      state.gravityConnection space +
        lorentzSkewConnectionOfBivectorOneForm
          (linearPlebanskiActionGeneratedLorentzLocalBivectorIncrement
            state space point) by
    rfl]
  rw [loweredLorentzConnectionCoefficient_add,
    loweredLorentzConnectionCoefficient_ofBivectorOneForm]
  rfl

@[simp] theorem linearPlebanskiActionGeneratedLorentzLocalConnection_origin
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    linearPlebanskiActionGeneratedLorentzLocalConnection state space 0 =
      state.gravityConnection space := by
  have incrementZero :
      linearPlebanskiActionGeneratedLorentzLocalBivectorIncrement
          state space 0 =
        0 := by
    funext formDirection internalPair
    simp [linearPlebanskiActionGeneratedLorentzLocalBivectorIncrement,
      linearPlebanskiActionGeneratedLorentzLocalIncrement]
  unfold linearPlebanskiActionGeneratedLorentzLocalConnection
  rw [incrementZero]
  funext formDirection internalOut internalIn
  simp

theorem
    linearPlebanskiActionGeneratedLorentzLocalConnectionCoordinate_derivative
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (derivativeDirection formDirection : LorentzianIndex)
    (internalPair : Fin 6) :
    fieldDirectionalDerivative
        (fun point =>
          linearPlebanskiActionGeneratedLorentzLocalConnectionCoordinate
            state space point formDirection internalPair)
        0 derivativeDirection =
      linearPlebanskiActionGeneratedLorentzLocalIncrement state space
        formDirection internalPair
        (coordinateDirection derivativeDirection) := by
  unfold fieldDirectionalDerivative
    linearPlebanskiActionGeneratedLorentzLocalConnectionCoordinate
  rw [fderiv_const_add]
  rw [(linearPlebanskiActionGeneratedLorentzLocalIncrement state space
    formDirection internalPair).hasFDerivAt.fderiv]

theorem linearPlebanskiActionGeneratedLorentzLocalConnection_loweredDerivative
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (derivativeDirection formDirection : LorentzianIndex)
    (internalPair : Fin 6) :
    fieldDirectionalDerivative
        (fun point =>
          loweredLorentzConnectionCoefficient
            (linearPlebanskiActionGeneratedLorentzLocalConnection state space
              point)
            formDirection internalPair)
        0 derivativeDirection =
      linearPlebanskiActionGeneratedLorentzLocalConnectionJet state space
        derivativeDirection formDirection internalPair := by
  rw [show
    (fun point =>
      loweredLorentzConnectionCoefficient
        (linearPlebanskiActionGeneratedLorentzLocalConnection state space
          point)
        formDirection internalPair) =
      fun point =>
        linearPlebanskiActionGeneratedLorentzLocalConnectionCoordinate state
          space point formDirection internalPair by
    funext point
    exact
      linearPlebanskiActionGeneratedLorentzLocalConnection_loweredCoordinate
        state space point formDirection internalPair]
  rw [
    linearPlebanskiActionGeneratedLorentzLocalConnectionCoordinate_derivative]
  fin_cases derivativeDirection <;>
    simp [linearPlebanskiActionGeneratedLorentzLocalIncrement,
      localBaseCoordinate, coordinateDirection, Fin.sum_univ_four]

theorem linearPlebanskiActionGeneratedLorentzLocalConnection_smooth
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    ∀ formDirection internalOut internalIn,
      ContDiff ℝ ∞ (fun point =>
        linearPlebanskiActionGeneratedLorentzLocalConnection state space point
          formDirection internalOut internalIn) := by
  intro formDirection internalOut internalIn
  unfold linearPlebanskiActionGeneratedLorentzLocalConnection
    lorentzSkewConnectionOfBivectorOneForm
    loweredLorentzBivectorMatrix
    linearPlebanskiActionGeneratedLorentzLocalBivectorIncrement
  apply contDiff_const.add
  apply contDiff_const.mul
  apply ContDiff.sum
  intro internalPair _
  exact
    (linearPlebanskiActionGeneratedLorentzLocalIncrement state space
      formDirection internalPair).contDiff.mul contDiff_const

theorem
    linearPlebanskiActionGeneratedLorentzLocalConnection_antisymmetrized
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (internalPair spacetimePair : Fin 6) :
    linearPlebanskiActionGeneratedLorentzLocalConnectionJet state space
          (pairFirst spacetimePair) (pairSecond spacetimePair) internalPair -
        linearPlebanskiActionGeneratedLorentzLocalConnectionJet state space
          (pairSecond spacetimePair) (pairFirst spacetimePair) internalPair =
      linearPlebanskiActionGeneratedLorentzExteriorDerivativeCoordinate
        state space internalPair spacetimePair := by
  fin_cases spacetimePair <;>
    simp [linearPlebanskiActionGeneratedLorentzLocalConnectionJet,
      linearPlebanskiActionGeneratedLorentzExteriorDerivativeCoordinate,
      linearPlebanskiActionGeneratedLorentzSpatialConnectionVelocity,
      temporalSpatialPair, canonicalLorentzianTimeDirection,
      pairFirst, pairSecond] <;>
    ring

/-! ## Synchronized nine-field actual -/

/-- Full joint actual lift with the Lorentz germ generated by the
linear-Plebanski action.  The only constructor inputs are the proof-free
source, the primitive dynamical state, and the spatial contact. -/
def sourceActionGeneratedLinearPlebanskiJointLocalActualLift
    (source : SmoothUnifiedSource)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    StageNineHolonomicConfiguration :=
  { sourceActionGeneratedJointLocalActualLift source state space with
    gravityConnection :=
      linearPlebanskiActionGeneratedLorentzLocalConnection state space }

/-- The new Lorentz response is installed without replacing any other
primitive field generated by the existing joint action path. -/
theorem
    sourceActionGeneratedLinearPlebanskiJointLocalActualLift_retainsJointPrimitiveFields
    (source : SmoothUnifiedSource)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    (sourceActionGeneratedLinearPlebanskiJointLocalActualLift source state
        space).coframe =
        (sourceActionGeneratedJointLocalActualLift source state space).coframe ∧
      (sourceActionGeneratedLinearPlebanskiJointLocalActualLift source state
        space).gravityAuxiliary =
        (sourceActionGeneratedJointLocalActualLift source state
          space).gravityAuxiliary ∧
      (sourceActionGeneratedLinearPlebanskiJointLocalActualLift source state
        space).gravitySimplicityMultiplier =
        (sourceActionGeneratedJointLocalActualLift source state
          space).gravitySimplicityMultiplier ∧
      (sourceActionGeneratedLinearPlebanskiJointLocalActualLift source state
        space).gaugeConnection =
        (sourceActionGeneratedJointLocalActualLift source state
          space).gaugeConnection ∧
      (sourceActionGeneratedLinearPlebanskiJointLocalActualLift source state
        space).gaugeAuxiliary =
        (sourceActionGeneratedJointLocalActualLift source state
          space).gaugeAuxiliary ∧
      (sourceActionGeneratedLinearPlebanskiJointLocalActualLift source state
        space).scalar =
        (sourceActionGeneratedJointLocalActualLift source state space).scalar ∧
      (sourceActionGeneratedLinearPlebanskiJointLocalActualLift source state
        space).matter =
        (sourceActionGeneratedJointLocalActualLift source state space).matter ∧
      (sourceActionGeneratedLinearPlebanskiJointLocalActualLift source state
        space).conjugateMatter =
        (sourceActionGeneratedJointLocalActualLift source state
          space).conjugateMatter := by
  exact ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

theorem sourceActionGeneratedLinearPlebanskiJointLocalActualLift_smooth
    (source : SmoothUnifiedSource)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    (sourceActionGeneratedLinearPlebanskiJointLocalActualLift source state
      space).Smooth := by
  have baseSmooth :=
    sourceActionGeneratedJointLocalActualLift_smooth source state space
  rcases baseSmooth with
    ⟨coframeSmooth, _gravityConnectionSmooth, gravityAuxiliarySmooth,
      multiplierSmooth, gaugeConnectionSmooth, gaugeAuxiliarySmooth,
      scalarSmooth, matterSmooth, conjugateMatterSmooth⟩
  exact
    ⟨coframeSmooth,
      linearPlebanskiActionGeneratedLorentzLocalConnection_smooth state space,
      gravityAuxiliarySmooth, multiplierSmooth, gaugeConnectionSmooth,
      gaugeAuxiliarySmooth, scalarSmooth, matterSmooth,
      conjugateMatterSmooth⟩

theorem sourceActionGeneratedLinearPlebanskiJointLocalActualLift_nondegenerate
    (source : SmoothUnifiedSource)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (nondegenerate : Matrix.det (state.coframe space) ≠ 0) :
    (sourceActionGeneratedLinearPlebanskiJointLocalActualLift source state
      space).Nondegenerate := by
  intro point
  change Matrix.det (state.coframe space) ≠ 0
  exact nondegenerate

@[simp] theorem
    sourceActionGeneratedLinearPlebanskiJointLocalActualLift_initialConnection
    (source : SmoothUnifiedSource)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    (sourceActionGeneratedLinearPlebanskiJointLocalActualLift source state
      space).gravityConnection 0 =
      state.gravityConnection space :=
  linearPlebanskiActionGeneratedLorentzLocalConnection_origin state space

@[simp] theorem
    sourceActionGeneratedLinearPlebanskiJointLocalActualLift_coframe
    (source : SmoothUnifiedSource)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (point : BasePoint) :
    (sourceActionGeneratedLinearPlebanskiJointLocalActualLift source state
      space).coframe point =
      state.coframe space :=
  rfl

@[simp] theorem
    sourceActionGeneratedLinearPlebanskiJointLocalActualLift_auxiliary
    (source : SmoothUnifiedSource)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (point : BasePoint) :
    (sourceActionGeneratedLinearPlebanskiJointLocalActualLift source state
