import H0mework.Physics.CurrentAction.PrimitiveCauchyUpdate
import H0mework.Physics.MatterCurrent.CompleteFirstGermCanonicalFullActionReplay

/-!
# C3h187: exact P506/L0 canonical full-action contact update

The C3h186b actual `U****` is first restricted to its canonical Cauchy slice.
That generated current state and the same exact-lineage proof-free source are
then passed to the generic contact-wise canonical full-action producer:

```text
exact P506/L0 source + canonical slice of generated U****
→ at every spatial contact, a source/action-generated base actual
→ full synchronized + complete P286 response
→ temporal + complete matter first-germ responses
→ one whole-slice primitive update.
```

This opens a new validation epoch: the contact-wise outputs are freshly
generated and are not identified with `U****` at arbitrary contacts.  The
theorems below retain only what the constructor establishes directly: exact
source lineage, branch-free generation, the two stage-relative faithful zero
fibers, a separately generated zero response, and the P286 auxiliary time jet.

No current-support event, branch, scheduler, or global source-time evolution
is inferred.  A future external source-owned event provenance may wrap this
operator, but it is not an input or an output of this module.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineSourceActionGeneratedP506MatterCurrentCompleteFirstGermCanonicalPrimitiveCauchyUpdate

open ProofFreeRicherAnholonomicSource
open RepresentationArithmeticAtomProjectionDefect.BorromeanPreRealization
open StageNineCanonicalCauchyState
open StageNineCanonicalLocalFullActionResponseOperator
open StageNineConjugateMatterActionTimeVelocity
open StageNineCurrentCanonicalFullActionPrimitiveCauchyUpdate
open StageNineCurrentFullSynchronizedCompleteP286PrimitiveCauchyUpdate
open StageNineCurrentP286CompleteActionResponseOperator
open StageNineDynamicBreakingVacuum
open StageNineEnrichedProofFreeSource
open StageNineFullSynchronizedActionResponseOperator
open StageNineGravityGaugeActionLocalActualLift
open StageNineHolonomicField
open StageNineJointActionLocalActualLift
open StageNineMatterActionCompleteFirstGermResponse
open StageNineMatterActionTimeVelocity
open StageNineMatterActionTemporalFirstGermResponse
open StageNineP286ActionCauchySplit
open StageNineP286ActionVelocityLocalActualLift
open StageNineScalarActionCanonicalMomentumUpdate
open StageNineSourceActionGeneratedP286MomentumJointLocalActualLift
open StageNineSourceActionGeneratedP506MatterCurrentCompleteFirstGermCanonicalFullActionReplay
open StageNineSourceActionGeneratedP506MatterCurrentP286CompleteActionPrincipalMatterCompleteFirstGermResponse
open StageNineSourceActionGeneratedP506MatterCurrentLinearPlebanskiSynchronizedLocalActualLift
open SU7MotherLieAlgebra

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 5000000
set_option maxRecDepth 100000
set_option synthInstance.maxHeartbeats 200000

local instance c3h187P286ModuleFinite : Module.Finite ℝ P286LieBlockData :=
  FiniteDimensional.of_injective p286AmbientLinear
    p286AmbientLinear_injective

local instance c3h187P286CoordinateIndexFintype : Fintype P286CoordinateIndex :=
  Fintype.ofFinite P286CoordinateIndex

local instance c3h187P286CoordinateIsTopologicalAddGroup :
    IsTopologicalAddGroup P286CoordinateCarrier where
  toContinuousAdd := inferInstance
  toContinuousNeg := inferInstance

private abbrev CompleteFirstGermActual : StageNineHolonomicConfiguration :=
  positiveP506MatterCurrentCompleteFirstGermResponseActual

/-! ## Current state generated by the prior canonical actual -/

/-- The next producer consumes the canonical slice of the already generated
complete first-germ actual. -/
def positiveP506MatterCurrentCompleteFirstGermCanonicalCauchyState :
    StageNineCauchyState :=
  canonicalCauchyRestriction 0 CompleteFirstGermActual

/-- C3h186b's canonical replay and the current state have exactly the same
canonical slice.  This is provenance of the current input, not a claim that
the new every-contact update replays `U****`. -/
theorem
    positiveP506MatterCurrentCompleteFirstGermCanonicalCauchyState_eq_replayRestriction :
    positiveP506MatterCurrentCompleteFirstGermCanonicalCauchyState =
      canonicalCauchyRestriction 0
        positiveP506MatterCurrentCompleteFirstGermCanonicalFullActionReplayActual := by
  unfold positiveP506MatterCurrentCompleteFirstGermCanonicalCauchyState
  rw [positiveP506MatterCurrentCompleteFirstGermCanonicalFullActionReplayActual_replays_completeFirstGermActual]

/-! ## Exact contact actuals and whole-slice update -/

abbrev positiveP506MatterCurrentCompleteFirstGermCanonicalContactActual
    (space : StageNineSpatialPoint) : StageNineHolonomicConfiguration :=
  currentCanonicalFullActionActual positiveSmoothUnifiedSource
    positiveP506MatterCurrentCompleteFirstGermCanonicalCauchyState space

def positiveP506MatterCurrentCompleteFirstGermCanonicalPrimitiveCauchyUpdate
    (time : ℝ) : StageNineCauchyState :=
  currentCanonicalFullActionPrimitiveCauchyUpdate positiveSmoothUnifiedSource
    positiveP506MatterCurrentCompleteFirstGermCanonicalCauchyState time

def positiveP506MatterCurrentCompleteFirstGermCanonicalGeneratedZeroResponseState :
    StageNineCauchyState :=
  currentCanonicalFullActionGeneratedZeroResponseState positiveSmoothUnifiedSource
    positiveP506MatterCurrentCompleteFirstGermCanonicalCauchyState

private theorem c3h187CanonicalCauchySlicePoint_zero_zero :
    canonicalCauchySlicePoint 0 0 = 0 := by
  ext direction
  fin_cases direction <;>
    simp [canonicalCauchySlicePoint, canonicalLorentzianTimeDirection,
      Fin.sum_univ_three]

/-- The generated C3h187 zero-response state retains the coframe of its
source-generated current state at every spatial contact.  This is contact
fidelity, not a claim that the whole update is the identity. -/
@[simp] theorem
    positiveP506MatterCurrentCompleteFirstGermCanonicalGeneratedZeroResponseState_coframe
    (space : StageNineSpatialPoint) :
    positiveP506MatterCurrentCompleteFirstGermCanonicalGeneratedZeroResponseState.coframe
        space =
      positiveP506MatterCurrentCompleteFirstGermCanonicalCauchyState.coframe
        space := by
  simp [
    positiveP506MatterCurrentCompleteFirstGermCanonicalGeneratedZeroResponseState,
    currentCanonicalFullActionGeneratedZeroResponseState,
    currentCanonicalFullActionPrimitiveCauchyUpdate,
    currentCanonicalFullActionLocalPath,
    canonicalCauchyRestriction, c3h187CanonicalCauchySlicePoint_zero_zero,
    currentCanonicalFullActionActual,
    currentCanonicalFullActionBaseActual,
    currentFullSynchronizedCompleteP286BaseActual,
    sourceActionGeneratedLinearPlebanskiJointLocalActualLift,
    sourceActionGeneratedJointLocalActualLift,
    sourceActionGeneratedMatterDualScalarLocalActualLift,
    sourceActionGeneratedMatterDualLocalActualLift,
    sourceActionGeneratedMatterLocalActualLift,
    sourceActionGeneratedGravityGaugeLocalActualLift,
    sourceGeneratedP286ActionLocalActualLift,
    canonicalLocalFullActionResponseOperator,
    canonicalLocalFullActionTemporalMatterActual,
    canonicalLocalFullActionP286Actual,
    actionGeneratedMatterCompleteFirstGermActual,
    actionGeneratedMatterTemporalFirstGermActual,
    StageNineFullSynchronizedCompleteP286ActionResponseOperator.fullSynchronizedCompleteP286ActionResponseOperator]

/-- The canonical C3h187 input state inherits the identity coframe of the
already generated complete first-germ actual. -/
@[simp] theorem
    positiveP506MatterCurrentCompleteFirstGermCanonicalCauchyState_coframe_one
    (space : StageNineSpatialPoint) :
    positiveP506MatterCurrentCompleteFirstGermCanonicalCauchyState.coframe
        space = 1 := by
  change CompleteFirstGermActual.coframe
      (canonicalCauchySlicePoint 0 space) = 1
  rw [positiveP506MatterCurrentCompleteFirstGermResponseActual_coframe]
  have identityCoframe :=
    positiveP506MatterCurrentCompleteFirstGermBaseActual_identityCoframe
  unfold HasIdentityCoframe at identityCoframe
  exact congrFun identityCoframe (canonicalCauchySlicePoint 0 space)

/-- Consequently the fresh C3h187 zero-response state also carries the
source-generated identity coframe, with no new normalization input. -/
@[simp] theorem
    positiveP506MatterCurrentCompleteFirstGermCanonicalGeneratedZeroResponseState_coframe_one
    (space : StageNineSpatialPoint) :
    positiveP506MatterCurrentCompleteFirstGermCanonicalGeneratedZeroResponseState.coframe
        space = 1 := by
  rw [
    positiveP506MatterCurrentCompleteFirstGermCanonicalGeneratedZeroResponseState_coframe,
    positiveP506MatterCurrentCompleteFirstGermCanonicalCauchyState_coframe_one]

@[simp] theorem
    positiveP506MatterCurrentCompleteFirstGermCanonicalPrimitiveCauchyUpdate_zero :
    positiveP506MatterCurrentCompleteFirstGermCanonicalPrimitiveCauchyUpdate 0 =
      positiveP506MatterCurrentCompleteFirstGermCanonicalGeneratedZeroResponseState := by
  exact currentCanonicalFullActionPrimitiveCauchyUpdate_zero
    positiveSmoothUnifiedSource
    positiveP506MatterCurrentCompleteFirstGermCanonicalCauchyState

theorem
    positiveP506MatterCurrentCompleteFirstGermCanonicalPrimitiveCauchyUpdate_genericLaw :
    StageNineCurrentCanonicalFullActionPrimitiveCauchyUpdateLaw
      positiveSmoothUnifiedSource
      positiveP506MatterCurrentCompleteFirstGermCanonicalCauchyState
      positiveP506MatterCurrentCompleteFirstGermCanonicalPrimitiveCauchyUpdate := by
  exact currentCanonicalFullActionPrimitiveCauchyUpdate_realizes
    positiveSmoothUnifiedSource
    positiveP506MatterCurrentCompleteFirstGermCanonicalCauchyState

theorem
    positiveP506MatterCurrentCompleteFirstGermCanonicalPrimitiveCauchyUpdate_p286Auxiliary_hasDerivAt
    (globalSpace : StageNineSpatialPoint)
    (pair : Fin 6)
    (time : ℝ) :
    HasDerivAt
      (fun candidate : ℝ =>
        p286CoordinateEquiv
          ((positiveP506MatterCurrentCompleteFirstGermCanonicalPrimitiveCauchyUpdate
            candidate).gaugeAuxiliary globalSpace pair))
      (p286SpatialAuxiliaryVelocityEmbedding
        (currentP286SpatialAuxiliaryVelocity positiveSmoothUnifiedSource
          (currentFullSynchronizedResponseActual positiveSmoothUnifiedSource
            positiveP506MatterCurrentCompleteFirstGermCanonicalCauchyState
            globalSpace))
        pair)
      time := by
  exact
    currentCanonicalFullActionPrimitiveCauchyUpdate_p286Auxiliary_hasDerivAt
      positiveSmoothUnifiedSource
      positiveP506MatterCurrentCompleteFirstGermCanonicalCauchyState
      globalSpace pair time

/-! ## No-premise exact-lineage authority -/

structure
    PositiveP506MatterCurrentCompleteFirstGermCanonicalPrimitiveCauchyUpdateLaw :
    Prop where
  exactP506L0Lineage :
    positiveSmoothUnifiedSource.stageEight.generatedP506L0Lineage =
      canonicalP506SourceAffineL0ObservableLineageReference
  currentStateGeneratedFromCanonicalReplay :
    positiveP506MatterCurrentCompleteFirstGermCanonicalCauchyState =
      canonicalCauchyRestriction 0
        positiveP506MatterCurrentCompleteFirstGermCanonicalFullActionReplayActual
  genericUpdateLaw :
    StageNineCurrentCanonicalFullActionPrimitiveCauchyUpdateLaw
      positiveSmoothUnifiedSource
      positiveP506MatterCurrentCompleteFirstGermCanonicalCauchyState
      positiveP506MatterCurrentCompleteFirstGermCanonicalPrimitiveCauchyUpdate
  zeroResponseGenerated :
    positiveP506MatterCurrentCompleteFirstGermCanonicalPrimitiveCauchyUpdate 0 =
      positiveP506MatterCurrentCompleteFirstGermCanonicalGeneratedZeroResponseState
  p286DirectTimeJet : ∀ globalSpace pair time,
    HasDerivAt
      (fun candidate : ℝ =>
        p286CoordinateEquiv
          ((positiveP506MatterCurrentCompleteFirstGermCanonicalPrimitiveCauchyUpdate
            candidate).gaugeAuxiliary globalSpace pair))
      (p286SpatialAuxiliaryVelocityEmbedding
        (currentP286SpatialAuxiliaryVelocity positiveSmoothUnifiedSource
          (currentFullSynchronizedResponseActual positiveSmoothUnifiedSource
            positiveP506MatterCurrentCompleteFirstGermCanonicalCauchyState
            globalSpace))
        pair)
      time

theorem
    positiveP506MatterCurrentCompleteFirstGermCanonicalPrimitiveCauchyUpdate_realizes_C3h187 :
    PositiveP506MatterCurrentCompleteFirstGermCanonicalPrimitiveCauchyUpdateLaw := by
  exact
    { exactP506L0Lineage :=
        positiveP506MatterCurrentCompleteFirstGermResponseActual_exactP506L0Lineage
      currentStateGeneratedFromCanonicalReplay :=
        positiveP506MatterCurrentCompleteFirstGermCanonicalCauchyState_eq_replayRestriction
      genericUpdateLaw :=
        positiveP506MatterCurrentCompleteFirstGermCanonicalPrimitiveCauchyUpdate_genericLaw
      zeroResponseGenerated :=
        positiveP506MatterCurrentCompleteFirstGermCanonicalPrimitiveCauchyUpdate_zero
      p286DirectTimeJet :=
        positiveP506MatterCurrentCompleteFirstGermCanonicalPrimitiveCauchyUpdate_p286Auxiliary_hasDerivAt }

end

end
  SaturationMonoid.PhysicsCore.StageNineSourceActionGeneratedP506MatterCurrentCompleteFirstGermCanonicalPrimitiveCauchyUpdate
