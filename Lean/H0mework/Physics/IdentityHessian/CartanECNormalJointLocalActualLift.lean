/-! ## Source/current-only critical-pair constructor -/

/-- The common Hessian--Cartan current whose shared primitive fields must be
re-read before the final EC-normal write. -/
def diracDualFormNativeIdentityECHessianCartanCurrent
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  sourceActionGeneratedDiracDualCartanReactionCurrentRestart source
    (sourceActionGeneratedIdentityECHolonomicCoframeHessianLocalActualLift
      source current)

/-- Joint local actual.  The last leg is not a supplied correction: its
curvature target and reaction are computed internally from the live current. -/
def sourceActionGeneratedDiracDualIdentityECHessianCartanECNormalJointLocalActualLift
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  sourceActionGeneratedDiracDualECNormalLocalActualLift source
    (diracDualFormNativeIdentityECHessianCartanCurrent source current)

@[simp] theorem
    sourceActionGeneratedDiracDualIdentityECHessianCartanECNormalJointLocalActualLift_coframe
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (sourceActionGeneratedDiracDualIdentityECHessianCartanECNormalJointLocalActualLift
      source current).coframe =
        (sourceActionGeneratedIdentityECHolonomicCoframeHessianLocalActualLift
          source current).coframe :=
  rfl

/-- The final algebraic/curvature settlement retains the exact dynamical
coframe second jet generated by the Hessian leg. -/
theorem
    sourceActionGeneratedDiracDualIdentityECHessianCartanECNormalJointLocalActualLift_coframe_secondJet
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    coframeOriginSecondFrechetJet
        (fun point =>
          (sourceActionGeneratedDiracDualIdentityECHessianCartanECNormalJointLocalActualLift
              source current).coframe point - current.coframe point) =
      (sourceActionGeneratedIdentityECHolonomicCoframeHessianIncrement
        source current).1 := by
  change
    coframeOriginSecondFrechetJet
        (fun point =>
          (sourceActionGeneratedIdentityECHolonomicCoframeHessianLocalActualLift
              source current).coframe point - current.coframe point) = _
  exact
    identityECHolonomicCoframeHessianIncrementLocalActualLift_coframe_secondJet
      current
      (sourceActionGeneratedIdentityECHolonomicCoframeHessianIncrement
        source current)

theorem
    sourceActionGeneratedDiracDualIdentityECHessianCartanECNormalJointLocalActualLift_simplicity
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    FormNativeGravitySimplicityEquation
      (sourceActionGeneratedDiracDualIdentityECHessianCartanECNormalJointLocalActualLift
        source current) :=
  sourceActionGeneratedDiracDualECNormalLocalActualLift_simplicity _ _

theorem
    sourceActionGeneratedDiracDualIdentityECHessianCartanECNormalJointLocalActualLift_auxiliaryEquation
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    FormNativeGravityAuxiliaryEquation
      (sourceActionGeneratedDiracDualIdentityECHessianCartanECNormalJointLocalActualLift
        source current) :=
  sourceActionGeneratedDiracDualECNormalLocalActualLift_auxiliaryEquation _ _

/-- At an identity contact the action-normal leg closes the complete coframe
Euler covector on the same actual that retains the generated Hessian. -/
theorem
    sourceActionGeneratedDiracDualIdentityECHessianCartanECNormalJointLocalActualLift_fullCoframeEuler_zero
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (coframeOne : current.coframe 0 = 1) :
    diracDualFormNativeCoframeEulerCovector source 0
        (toContinuumPointField
          (sourceActionGeneratedDiracDualIdentityECHessianCartanECNormalJointLocalActualLift
            source current) 0) = 0 := by
  apply sourceActionGeneratedDiracDualECNormalLocalActualLift_fullCoframeEuler_zero
  change
    (sourceActionGeneratedIdentityECHolonomicCoframeHessianLocalActualLift
      source current).coframe 0 = 1
  unfold sourceActionGeneratedIdentityECHolonomicCoframeHessianLocalActualLift
  rw [identityECHolonomicCoframeHessianIncrementLocalActualLift_coframe_origin]
  exact coframeOne

/-- The final normal write preserves the already current-native Cartan value
at the contact, so torsion--spin is revalidated on the final actual rather
than transported as an old receipt. -/
theorem
    sourceActionGeneratedDiracDualIdentityECHessianCartanECNormalJointLocalActualLift_torsionSpin_zero
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (nondegenerate : Matrix.det (current.coframe 0) ≠ 0) :
    internalBivectorDualThreeForm
        (torsionCoframeWedgeThreeForm
          ((sourceActionGeneratedDiracDualIdentityECHessianCartanECNormalJointLocalActualLift
            source current).coframe 0)
          (pointwiseCartanTorsion
            (holonomicCoframeFirstJetAt
              (sourceActionGeneratedDiracDualIdentityECHessianCartanECNormalJointLocalActualLift
                source current).coframe 0)
            ((sourceActionGeneratedDiracDualIdentityECHessianCartanECNormalJointLocalActualLift
              source current).gravityConnection 0))) =
      formNativePhysicalSpinCurrentThreeForm source 0 0
        (toContinuumPointField
          (restrictHolonomicConfigurationToIIPlus
            (sourceActionGeneratedDiracDualIdentityECHessianCartanECNormalJointLocalActualLift
              source current)) 0) := by
  apply sourceActionGeneratedDiracDualECNormalLocalActualLift_torsionSpin_zero
  · change
      Matrix.det
          ((sourceActionGeneratedIdentityECHolonomicCoframeHessianLocalActualLift
            source current).coframe 0) ≠ 0
    unfold sourceActionGeneratedIdentityECHolonomicCoframeHessianLocalActualLift
    rw [identityECHolonomicCoframeHessianIncrementLocalActualLift_coframe_origin]
    exact nondegenerate
  · exact
      sourceActionGeneratedDiracDualCartanReactionCurrentRestart_connection_selfGenerated
        source
        (sourceActionGeneratedIdentityECHolonomicCoframeHessianLocalActualLift
          source current) 0

/-! ## Fixed P506/L0 specialization -/

def positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual :
    StageNineHolonomicConfiguration :=
  sourceActionGeneratedDiracDualIdentityECHessianCartanECNormalJointLocalActualLift
    positiveSmoothUnifiedSource positiveDiracDualCartanReactionLocalActual

/-- The dynamical Hessian retained by the joint actual is genuinely nonzero.
This is obtained from the already generated changed-curvature read; no
nonzero jet or target is supplied to the constructor. -/
private theorem positiveDiracDualIdentityECHessianIncrement_ne_zero :
    sourceActionGeneratedIdentityECHolonomicCoframeHessianIncrement
        positiveSmoothUnifiedSource
        positiveDiracDualCartanReactionLocalActual ≠ 0 := by
  have curvatureZero :
      identityECLeviCivitaCurvatureOfCoframeHessian
          (0 : CoframeHolonomicSecondJet) = 0 := by
    funext internalPair spacetimePair
    simp [identityECLeviCivitaCurvatureOfCoframeHessian,
      identityECLeviCivitaSpinConnectionFirstJet,
      identityECCoframeMetricHessian]
  intro incrementZero
  apply positiveDiracDualIdentityECHessian_changes_curvatureRead
  unfold positiveDiracDualIdentityECHessianLocalActual
  rw [
    sourceActionGeneratedIdentityECHolonomicCoframeHessianLocalActualLift_curvature_origin
      positiveSmoothUnifiedSource positiveDiracDualCartanReactionLocalActual
        positiveDiracDualCartanReactionLocalActual_smooth,
    incrementZero, curvatureZero]
  simp

/-- The final normal settlement has not erased the nontrivial coframe
dynamics installed before it. -/
theorem
    positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual_coframeSecondJet_ne_zero :
    coframeOriginSecondFrechetJet
        (fun point =>
          positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual.coframe
              point -
            positiveDiracDualCartanReactionLocalActual.coframe point) ≠ 0 := by
  unfold positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual
  rw [
    sourceActionGeneratedDiracDualIdentityECHessianCartanECNormalJointLocalActualLift_coframe_secondJet]
  intro valueZero
  apply positiveDiracDualIdentityECHessianIncrement_ne_zero
  apply Subtype.ext
  exact valueZero

private theorem positiveDiracDualCartanReaction_coframe_origin_one :
    positiveDiracDualCartanReactionLocalActual.coframe 0 = 1 := by
  change positiveSourceTargetMatterCauchyState.coframe 0 = 1
  change positivePhaseProbeCauchyState.coframe 0 = 1
  rw [positivePhaseProbeCauchyState_eq_normalForm]
  rfl

theorem
    positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual_fullCoframeEuler_zero :
    diracDualFormNativeCoframeEulerCovector positiveSmoothUnifiedSource 0
        (toContinuumPointField
          positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual 0) =
      0 :=
  sourceActionGeneratedDiracDualIdentityECHessianCartanECNormalJointLocalActualLift_fullCoframeEuler_zero
    positiveSmoothUnifiedSource positiveDiracDualCartanReactionLocalActual
      positiveDiracDualCartanReaction_coframe_origin_one

theorem
    positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual_torsionSpin_zero :
    internalBivectorDualThreeForm
        (torsionCoframeWedgeThreeForm
          (positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual.coframe
            0)
          (pointwiseCartanTorsion
            (holonomicCoframeFirstJetAt
              positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual.coframe
              0)
            (positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual.gravityConnection
              0))) =
      formNativePhysicalSpinCurrentThreeForm positiveSmoothUnifiedSource 0 0
        (toContinuumPointField
          (restrictHolonomicConfigurationToIIPlus
            positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual)
          0) := by
  apply
    sourceActionGeneratedDiracDualIdentityECHessianCartanECNormalJointLocalActualLift_torsionSpin_zero
  rw [positiveDiracDualCartanReaction_coframe_origin_one]
  norm_num

/-- Bundled positive checkpoint.  H1 is absent because it is already the
automatic readout of the preceding occurrence ring, not a field of this
physical producer. -/
theorem
    positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual_directRegression :
    positiveSmoothUnifiedSource.stageEight.generatedP506L0Lineage =
        canonicalP506SourceAffineL0ObservableLineageReference /\
      positiveSmoothUnifiedSource.stageEight.generatedSelectedEndpoint
          canonicalSource_generatedLineage_height_pos = 11 /\
      coframeOriginSecondFrechetJet
          (fun point =>
            positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual.coframe
                point -
              positiveDiracDualCartanReactionLocalActual.coframe point) ≠ 0 /\
      FormNativeGravitySimplicityEquation
        positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual /\
      FormNativeGravityAuxiliaryEquation
        positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual /\
      diracDualFormNativeCoframeEulerCovector positiveSmoothUnifiedSource 0
          (toContinuumPointField
            positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual
            0) = 0 /\
      internalBivectorDualThreeForm
          (torsionCoframeWedgeThreeForm
            (positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual.coframe
              0)
            (pointwiseCartanTorsion
              (holonomicCoframeFirstJetAt
                positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual.coframe
                0)
              (positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual.gravityConnection
                0))) =
        formNativePhysicalSpinCurrentThreeForm positiveSmoothUnifiedSource 0 0
          (toContinuumPointField
            (restrictHolonomicConfigurationToIIPlus
              positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual)
            0) := by
  exact
    ⟨positiveSmoothUnifiedSource_generates_exactP506L0Lineage,
      positiveSmoothUnifiedSource_generates_endpoint_eleven,
      positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual_coframeSecondJet_ne_zero,
      sourceActionGeneratedDiracDualIdentityECHessianCartanECNormalJointLocalActualLift_simplicity
        positiveSmoothUnifiedSource positiveDiracDualCartanReactionLocalActual,
      sourceActionGeneratedDiracDualIdentityECHessianCartanECNormalJointLocalActualLift_auxiliaryEquation
        positiveSmoothUnifiedSource positiveDiracDualCartanReactionLocalActual,
      positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual_fullCoframeEuler_zero,
      positiveDiracDualIdentityECHessianCartanECNormalJointLocalActual_torsionSpin_zero⟩

end

