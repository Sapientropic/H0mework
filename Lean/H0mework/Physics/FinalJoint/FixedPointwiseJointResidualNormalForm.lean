noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1800000
set_option maxRecDepth 100000

private abbrev FinalActual
    (space : StageNineSpatialPoint) : StageNineHolonomicConfiguration :=
  fixedP506L0FinalCommonActionActual space

private abbrev P286Input
    (space : StageNineSpatialPoint) : StageNineHolonomicConfiguration :=
  recenteredCartanRepairedScalarSecondJetActual space

/-! ## Surviving primitive-field normal forms -/

theorem fixedP506L0FinalCommonActionActual_scalar_point_normalForm
    (space : StageNineSpatialPoint) (point : BasePoint) :
    (FinalActual space).scalar point =
      (fixedP506L0RecenteredInput space).scalar point +
        scalarQuadraticTimeCorrection
          (recenteredContactDiracDualScalarAcceleration space) point := by
  rw [fixedP506L0FinalCommonActionActual_scalar,
    recenteredCartanRepairedScalarSecondJetActual]
  rfl

theorem fixedP506L0FinalCommonActionActual_matter_point_normalForm
    (space : StageNineSpatialPoint) (point : BasePoint) :
    matterCoordinateEquiv ((FinalActual space).matter point) =
      matterCoordinateEquiv ((fixedP506L0RecenteredInput space).matter point) +
        matterLinearTimeCoordinateWrite
          (diracDualCurrentCoframeMatterTimeResponseWrite
            (fixedP506L0CartanRestartActual space)) point := by
  rw [fixedP506L0FinalCommonActionActual_matter,
    recenteredCartanRepairedScalarSecondJetActual,
    installScalarQuadraticTimeCorrection_matter]
  change
    matterCoordinateEquiv
        ((actionGeneratedDiracDualRepairedMatterJointResponseActual
          (fixedP506L0CartanRestartActual space)).matter point) = _
  unfold actionGeneratedDiracDualRepairedMatterJointResponseActual
  rw [
    actionGeneratedDiracDualLiveCoframeConjugateMatterTimeResponseActual_matter]
  unfold actionGeneratedDiracDualCurrentCoframeMatterTimeResponseActual
  rw [installMatterLinearTimeResponse_matter_coordinate]
  rw [show
    (fixedP506L0CartanRestartActual space).matter =
        (fixedP506L0RecenteredInput space).matter by
    exact
      sourceActionGeneratedDiracDualCartanReactionCurrentRestart_matter
        positiveSmoothUnifiedSource (fixedP506L0RecenteredInput space)]

theorem fixedP506L0FinalCommonActionActual_conjugateMatter_point_normalForm
    (space : StageNineSpatialPoint) (point : BasePoint) :
    matterDualCoordinates ((FinalActual space).conjugateMatter point) =
      matterDualCoordinates
          ((fixedP506L0RecenteredInput space).conjugateMatter point) +
        conjugateMatterLinearTimeCoordinateWrite
          (liveCoframeConjugateMatterTimeResponseWrite
            (actionGeneratedDiracDualCurrentCoframeMatterTimeResponseActual
              (fixedP506L0CartanRestartActual space))) point := by
  rw [fixedP506L0FinalCommonActionActual_conjugateMatter,
    recenteredCartanRepairedScalarSecondJetActual,
    installScalarQuadraticTimeCorrection_conjugateMatter]
  change
    matterDualCoordinates
        ((actionGeneratedDiracDualRepairedMatterJointResponseActual
          (fixedP506L0CartanRestartActual space)).conjugateMatter point) = _
  unfold actionGeneratedDiracDualRepairedMatterJointResponseActual
    actionGeneratedDiracDualLiveCoframeConjugateMatterTimeResponseActual
  rw [installConjugateMatterLinearTimeResponse_conjugateMatterCoordinates]
  unfold actionGeneratedDiracDualCurrentCoframeMatterTimeResponseActual
  rw [installMatterLinearTimeResponse_conjugateMatter]
  rw [show
    (fixedP506L0CartanRestartActual space).conjugateMatter =
        (fixedP506L0RecenteredInput space).conjugateMatter by
    exact
      sourceActionGeneratedDiracDualCartanReactionCurrentRestart_conjugateMatter
        positiveSmoothUnifiedSource (fixedP506L0RecenteredInput space)]

theorem fixedP506L0FinalCommonActionActual_gaugeAuxiliaryCoordinate_normalForm
    (space : StageNineSpatialPoint) (point : BasePoint) :
    holonomicP286GaugeAuxiliaryCoordinate (FinalActual space) point =
      currentP286OriginAuxiliaryCoordinate (P286Input space) +
        formNativeP286CanonicalAuxiliaryIncrement
          (formNativeCurrentP286RequiredExteriorDerivative
            positiveSmoothUnifiedSource (P286Input space)) point := by
  unfold holonomicP286GaugeAuxiliaryCoordinate FinalActual
  rw [fixedP506L0FinalCommonActionActual_gaugeAuxiliary]
  funext pair
  exact congrFun
    (formNativeCurrentP286CompleteActionResponseOperator_auxiliaryCoordinate
      positiveSmoothUnifiedSource (P286Input space) point) pair

theorem fixedP506L0FinalCommonActionActual_p286ExteriorDerivative_normalForm
    (space : StageNineSpatialPoint) (point : BasePoint) :
    holonomicP286GaugeAuxiliaryExteriorDerivative (FinalActual space) point =
      formNativeCurrentP286RequiredExteriorDerivative
        positiveSmoothUnifiedSource (P286Input space) := by
  have coordinateEq :
      holonomicP286GaugeAuxiliaryCoordinate (FinalActual space) =
        holonomicP286GaugeAuxiliaryCoordinate
          (formNativeCurrentP286CompleteActionResponseOperator
            positiveSmoothUnifiedSource (P286Input space)) := by
    funext candidate pair
    unfold holonomicP286GaugeAuxiliaryCoordinate FinalActual
    rw [fixedP506L0FinalCommonActionActual_gaugeAuxiliary]
    rfl
  unfold holonomicP286GaugeAuxiliaryExteriorDerivative
    p286GaugeAuxiliaryDirectionalDerivative
  rw [coordinateEq]
  exact
    formNativeCurrentP286CompleteActionResponseOperator_exteriorDerivative
      positiveSmoothUnifiedSource (P286Input space) point

/-! ## Gravity and connection-channel normal forms -/

theorem fixedP506L0FinalCommonActionActual_lorentzSkew_origin
    (space : StageNineSpatialPoint) :
    LorentzSkew ((FinalActual space).gravityConnection 0) := by
  rw [fixedP506L0FinalCommonActionActual_connection_selfGenerated_origin]
  apply diracDualFormNativeActionCartanConnectionAt_lorentzSkew
  rw [fixedP506L0FinalCommonActionActual_coframe_origin]
  norm_num

theorem fixedP506L0FinalCommonActionActual_lorentzAdmissible
    (space : StageNineSpatialPoint) :
    GravityConnectionLorentzAdmissible (FinalActual space) := by
  intro point
  unfold FinalActual fixedP506L0FinalCommonActionActual
    sourceActionGeneratedDiracDualECFullCauchyLocalActualLift
    sourceActionGeneratedDiracDualECConstraintSurfaceInitialLocalActualLift
    diracDualFormNativeECConstraintSurfaceConnectedActual
  apply normalizedAffineLorentzConnectionField_lorentzSkew
  simpa [FinalActual, fixedP506L0FinalCommonActionActual,
    sourceActionGeneratedDiracDualECFullCauchyLocalActualLift,
    sourceActionGeneratedDiracDualECConstraintSurfaceInitialLocalActualLift,
    diracDualFormNativeECConstraintSurfaceConnectedActual] using
    fixedP506L0FinalCommonActionActual_lorentzSkew_origin space

theorem fixedP506L0FinalCommonActionActual_lorentzResidual_normalForm
    (space : StageNineSpatialPoint) (point : BasePoint) :
    holonomicFormNativeLorentzEulerThreeForm positiveSmoothUnifiedSource 0
        (FinalActual space) point =
      internalBivectorDualThreeForm
          (torsionCoframeWedgeThreeForm ((FinalActual space).coframe point)
            (pointwiseCartanTorsion
              (holonomicCoframeFirstJetAt (FinalActual space).coframe point)
              ((FinalActual space).gravityConnection point))) +
        formNativeMatterSpinThreeForm positiveSmoothUnifiedSource 0 point
          (toContinuumPointField (FinalActual space) point) := by
  unfold holonomicFormNativeLorentzEulerThreeForm
  congr 1
  have restriction :
      restrictHolonomicConfigurationToIIPlus (FinalActual space) =
        FinalActual space :=
    (restrictHolonomicConfigurationToIIPlus_eq_self_iff_diracDualFormNativeSimplicity
      (FinalActual space)).2
      (fixedP506L0FinalCommonActionActual_simplicity space)
  rw [← restriction]
  exact
    holonomicGravityAuxiliaryExteriorCovariantDerivative_restrictToIIPlus_eq_torsionCoframe
      (FinalActual space) (fixedP506L0FinalCommonActionActual_smooth space)
      (fixedP506L0FinalCommonActionActual_lorentzAdmissible space) point

theorem fixedP506L0FinalCommonActionActual_p286ConnectionResidual_normalForm
    (space : StageNineSpatialPoint) (point : BasePoint) :
    holonomicFormNativeP286GaugeEulerThreeForm positiveSmoothUnifiedSource 0
        (FinalActual space) point =
      formNativeCurrentP286RequiredExteriorDerivative
          positiveSmoothUnifiedSource (P286Input space) +
        pointwiseP286GaugeTwoFormConnectionExteriorAction
          (holonomicP286GaugeConnectionCoordinate (FinalActual space) point)
          (holonomicP286GaugeAuxiliaryCoordinate (FinalActual space) point) +
        formNativeChargedGaugeThreeForm positiveSmoothUnifiedSource 0 point
          (toContinuumPointField (FinalActual space) point) := by
  unfold holonomicFormNativeP286GaugeEulerThreeForm
  rw [holonomicP286GaugeAuxiliaryExteriorCovariantDerivative_eq_parts,
    fixedP506L0FinalCommonActionActual_p286ExteriorDerivative_normalForm]

/-! ## Coframe action channel -/

private theorem physicalIIPlusCoframeTangent_smul_local
    (coframe variation : LorentzianCoframe) (parameter : ℝ) :
    physicalIIPlusCoframeTangent coframe (parameter • variation) =
      parameter • physicalIIPlusCoframeTangent coframe variation := by
  funext internalPair spacetimePair
  fin_cases internalPair <;> fin_cases spacetimePair <;>
    simp [physicalIIPlusCoframeTangent, coframeWedgeTangent,
      internalBivectorDual, lorentzianCoframeHodge,
      pairFirst, pairSecond] <;>
    ring

/-- The live constraint reaction in the same continuous coframe-dual carrier
as the gauge and matter action channels. -/
def fixedP506L0FinalCommonCoframeConstraintReactionCovector
    (space : StageNineSpatialPoint) (point : BasePoint) :
    LorentzianCoframe →L[ℝ] ℝ :=
  let field := toContinuumPointField (FinalActual space) point
  ({ toFun := fun variation =>
      formNativeCoframeConstraintReaction field variation
     map_add' := by
       intro first second
       unfold formNativeCoframeConstraintReaction
       rw [physicalIIPlusCoframeTangent_add,
         gravityTopologicalWedgeCoefficient_add_right]
     map_smul' := by
       intro parameter variation
       unfold formNativeCoframeConstraintReaction
       rw [physicalIIPlusCoframeTangent_smul_local,
         gravityTopologicalWedgeCoefficient_smul_right]
       rfl } : LorentzianCoframe →ₗ[ℝ] ℝ).toContinuousLinearMap

def fixedP506L0FinalCommonCoframeResidualNormalForm
    (space : StageNineSpatialPoint) (point : BasePoint) :
    LorentzianCoframe →L[ℝ] ℝ :=
  let field := toContinuumPointField (FinalActual space) point
  diracDualFormNativeCoframeGaugeEulerCovector positiveSmoothUnifiedSource
      field +
    diracDualFormNativeCoframeMatterEulerCovector positiveSmoothUnifiedSource
      point field -
    fixedP506L0FinalCommonCoframeConstraintReactionCovector space point

theorem fixedP506L0FinalCommonActionActual_coframeResidual_normalForm
    (space : StageNineSpatialPoint) (point : BasePoint)
    (nondegenerate : Matrix.det ((FinalActual space).coframe point) ≠ 0) :
    diracDualFormNativeCoframeEulerCovector positiveSmoothUnifiedSource point
        (toContinuumPointField (FinalActual space) point) =
      fixedP506L0FinalCommonCoframeResidualNormalForm space point := by
  apply ContinuousLinearMap.ext
  intro variation
  rw [
    diracDualFormNativeCoframeEulerCovector_apply_eq_gauge_add_matter_sub_reaction
      positiveSmoothUnifiedSource point
      (toContinuumPointField (FinalActual space) point) nondegenerate variation]
  simp [fixedP506L0FinalCommonCoframeResidualNormalForm,
    fixedP506L0FinalCommonCoframeConstraintReactionCovector]

/-! ## One complete arbitrary-point carrier -/

def fixedP506L0FinalCommonPointwiseJointResidualNormalForm
    (space : StageNineSpatialPoint) (point : BasePoint) :
    DiracDualFormNativePointwiseJointResidualCarrier :=
  let actual := FinalActual space
  let field := toContinuumPointField actual point
  { gravityMultiplier := 0
    gravityAuxiliary := 0
    p286GaugeAuxiliary :=
      formNativeP286GaugeAuxiliaryEulerResidualAtBoundary
        (sourceGeneratedUnifiedCouplings positiveSmoothUnifiedSource) field
    lorentzConnection :=
      internalBivectorDualThreeForm
          (torsionCoframeWedgeThreeForm (actual.coframe point)
            (pointwiseCartanTorsion
              (holonomicCoframeFirstJetAt actual.coframe point)
              (actual.gravityConnection point))) +
        formNativeMatterSpinThreeForm positiveSmoothUnifiedSource 0 point field
    p286GaugeConnection :=
      formNativeCurrentP286RequiredExteriorDerivative
          positiveSmoothUnifiedSource (P286Input space) +
        pointwiseP286GaugeTwoFormConnectionExteriorAction
          (holonomicP286GaugeConnectionCoordinate actual point)
          (holonomicP286GaugeAuxiliaryCoordinate actual point) +
        formNativeChargedGaugeThreeForm positiveSmoothUnifiedSource 0 point field
    scalar := fun direction =>
      diracDualScalarAlgebraicDirectionalCoefficient
          positiveSmoothUnifiedSource actual direction point -
        scalarDifferentialMomentumDivergence
          positiveSmoothUnifiedSource actual direction point
    matter := fun direction =>
      diracDualMatterAlgebraicDirectionalCoefficient
          positiveSmoothUnifiedSource actual direction point -
        matterDifferentialMomentumDivergence
          positiveSmoothUnifiedSource actual direction point
    conjugateMatter := fun direction =>
      generatedVolumeDensity field *
        (matterDualOfCoordinates direction
          (generatedContinuumDiracDualMatterVector positiveSmoothUnifiedSource
            0 point field)).re
    coframe := fixedP506L0FinalCommonCoframeResidualNormalForm space point }

/-- Complete nine-channel action normal form on the already-generated final
actual.  The pointwise determinant premise is used only to split the coframe
derivative into its three action-owned summands. -/
theorem fixedP506L0FinalCommonActionActual_pointwiseJointResidual_normalForm
    (space : StageNineSpatialPoint) (point : BasePoint)
    (nondegenerate : Matrix.det ((FinalActual space).coframe point) ≠ 0) :
    diracDualFormNativePointwiseJointResidual positiveSmoothUnifiedSource
        (FinalActual space) point =
      fixedP506L0FinalCommonPointwiseJointResidualNormalForm space point := by
  apply DiracDualFormNativePointwiseJointResidualCarrier.ext
  · change formNativeGravityMultiplierEulerResidual _ = 0
    exact
      (formNativeGravityMultiplierEulerResidual_eq_zero_iff_simplicity _).2
        (fixedP506L0FinalCommonActionActual_simplicity space point)
  · change formNativeGravityAuxiliaryEulerResidual _ = 0
    exact congrFun
      (fixedP506L0FinalCommonActionActual_gravityAuxiliaryEquation space) point
  · rfl
  · exact
      fixedP506L0FinalCommonActionActual_lorentzResidual_normalForm space point
  · exact
      fixedP506L0FinalCommonActionActual_p286ConnectionResidual_normalForm
        space point
  · funext direction
    rfl
  · funext direction
    rfl
  · funext direction
    rfl
  · exact
      fixedP506L0FinalCommonActionActual_coframeResidual_normalForm
        space point nondegenerate

end

