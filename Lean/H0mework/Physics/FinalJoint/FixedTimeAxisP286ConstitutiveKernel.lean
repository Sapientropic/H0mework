import H0mework.Physics.FinalJoint.FixedTimeAxisCoframe
import H0mework.Physics.Constitutive.P286GaugeConstitutiveEliminationRegularity

/-!
# Fixed P506/L0 time-axis P286 constitutive kernel

The form-native mother action already supplies the P286 auxiliary equation

```text
F = C_e B,
```

where `C_e` is its live-coframe, three-block constitutive operator.  This
module freezes only the coframe input and exposes the resulting curvature
principal as a linear map.  Its inverse map is the existing action-owned
elimination formula, not an inverse reconstructed from a residual.

On a nondegenerate coframe the two maps obey both inverse laws.  The same
inverse is also the actual vertical derivative of the joint live
coframe/curvature elimination map.  Finally these facts are specialized to
the fixed P506/L0 final-common coframe on its canonical origin domain.

The response constructors take only the source-owned coupling boundary, the
live coframe, and an action forcing.  They take no inverse witness, target
response, residual/support coordinate, zero receipt, radius, or branch
selector.  Nondegeneracy appears only in soundness theorems; in the fixed
specialization it is supplied by the source-generated canonical domain.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeFixedP506FinalCommonTimeAxisP286ConstitutiveKernel

open EmpiricalReferenceScaleCouplingBoundary
open ProofFreeRicherAnholonomicSource
open StageNineCanonicalCauchyState
open StageNineDiracDualFormNativeFixedP506FinalCommonActionWrite
open StageNineDiracDualFormNativeFixedP506FinalCommonTimeAxisCoframe
open StageNineEnrichedProofFreeSource
open StageNineFormNativeGaugeAuxiliaryIntegratedVariation
open StageNineFormNativeP286GaugeConstitutiveElimination
open StageNineFormNativeP286GaugeConstitutiveEliminationRegularity
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open SU7MotherLieAlgebra

open scoped ContDiff Matrix.Norms.Elementwise

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1200000
set_option maxRecDepth 100000

local instance finalTimeAxisKernelP286ModuleFinite :
    Module.Finite ℝ P286LieBlockData :=
  FiniteDimensional.of_injective p286AmbientLinear
    p286AmbientLinear_injective

local instance finalTimeAxisKernelP286CoordinateIndexFintype :
    Fintype P286CoordinateIndex :=
  Fintype.ofFinite P286CoordinateIndex

local instance finalTimeAxisKernelP286CoordinateIsTopologicalAddGroup :
    IsTopologicalAddGroup P286CoordinateCarrier where
  toContinuousAdd := inferInstance
  toContinuousNeg := inferInstance

/-! ## Fixed-coframe action principal -/

/-- The curvature principal of the authoritative form-native auxiliary
equation, with the coframe frozen.  This is the action's existing
`diag(g_s^2,g_w^2,g_y^2) *_e` operator; it is not defined from the inverse
below. -/
def p286CoframeActionConstitutiveForwardLinear
    (boundary : EmpiricalReferenceScaleCouplings)
    (coframe : LorentzianCoframe) :
    FormNativeP286GaugeCoordinateTwoForm →ₗ[ℝ]
      FormNativeP286GaugeCoordinateTwoForm where
  toFun :=
    formNativeP286CoordinateBlockwiseConstitutive coframe
      (boundary.strongCouplingSquared : ℝ)
      (boundary.weakCouplingSquared : ℝ)
      (boundary.hyperchargeCouplingSquared : ℝ)
  map_add' := by
    intro first second
    rw [formNativeP286CoordinateBlockwiseConstitutive_eq_sum,
      formNativeP286CoordinateBlockwiseConstitutive_eq_sum,
      formNativeP286CoordinateBlockwiseConstitutive_eq_sum]
    funext output
    simp [Finset.sum_add_distrib]
  map_smul' := by
    intro parameter form
    rw [formNativeP286CoordinateBlockwiseConstitutive_eq_sum,
      formNativeP286CoordinateBlockwiseConstitutive_eq_sum]
    funext output
    simp [Finset.smul_sum, smul_smul, mul_comm]

@[simp] theorem p286CoframeActionConstitutiveForwardLinear_apply
    (boundary : EmpiricalReferenceScaleCouplings)
    (coframe : LorentzianCoframe)
    (auxiliary : FormNativeP286GaugeCoordinateTwoForm) :
    p286CoframeActionConstitutiveForwardLinear boundary coframe auxiliary =
      formNativeP286CoordinateBlockwiseConstitutive coframe
        (boundary.strongCouplingSquared : ℝ)
        (boundary.weakCouplingSquared : ℝ)
        (boundary.hyperchargeCouplingSquared : ℝ) auxiliary :=
  rfl

/-- The action-owned constitutive inverse with only its curvature slot left
linear.  This is the unique formula already generated by the mother action;
no inverse witness or target response enters the definition. -/
def p286CoframeActionConstitutiveInverseVerticalLinear
    (boundary : EmpiricalReferenceScaleCouplings)
    (coframe : LorentzianCoframe) :
    FormNativeP286GaugeCoordinateTwoForm →ₗ[ℝ]
      FormNativeP286GaugeCoordinateTwoForm where
  toFun :=
    formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary boundary
      coframe
  map_add' := by
    intro first second
    rw [formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary_eq_sum,
      formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary_eq_sum,
      formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary_eq_sum]
    funext output
    simp [Finset.sum_add_distrib]
    rw [add_comm]
  map_smul' := by
    intro parameter form
    rw [formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary_eq_sum,
      formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary_eq_sum]
    funext output
    simp [Finset.smul_sum, smul_smul, mul_comm]

@[simp] theorem p286CoframeActionConstitutiveInverseVerticalLinear_apply
    (boundary : EmpiricalReferenceScaleCouplings)
    (coframe : LorentzianCoframe)
    (curvature : FormNativeP286GaugeCoordinateTwoForm) :
    p286CoframeActionConstitutiveInverseVerticalLinear boundary coframe
        curvature =
      formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary boundary
        coframe curvature :=
  rfl

/-- The inverse map is a right inverse of the action constitutive principal
on every nondegenerate live coframe. -/
theorem p286CoframeActionConstitutiveForward_inverseVertical
    (boundary : EmpiricalReferenceScaleCouplings)
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (curvature : FormNativeP286GaugeCoordinateTwoForm) :
    p286CoframeActionConstitutiveForwardLinear boundary coframe
        (p286CoframeActionConstitutiveInverseVerticalLinear boundary coframe
          curvature) =
      curvature := by
  change
    formNativeP286CoordinateBlockwiseConstitutive coframe
        (boundary.strongCouplingSquared : ℝ)
        (boundary.weakCouplingSquared : ℝ)
        (boundary.hyperchargeCouplingSquared : ℝ)
        (StageNineFormNativeP286GaugeConstitutiveEliminationRegularity.formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary
          boundary coframe curvature) =
      curvature
  unfold formNativeP286CoordinateBlockwiseConstitutive
    StageNineFormNativeP286GaugeConstitutiveEliminationRegularity.formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary
  rw [formNativeP286GaugeActual_coordinate_actual]
  simpa only [formNativeP286GaugeCoordinate_actual_coordinate] using
    congrArg formNativeP286GaugeActualToCoordinateLinear
      (formNativeP286GaugeEliminatedAuxiliaryAtBoundary_solves boundary
        coframe nondegenerate
        (formNativeP286GaugeCoordinateToActualLinear curvature))

/-- The same source/action pair also gives the opposite inverse law. -/
theorem p286CoframeActionConstitutiveInverseVertical_forward
    (boundary : EmpiricalReferenceScaleCouplings)
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (auxiliary : FormNativeP286GaugeCoordinateTwoForm) :
    p286CoframeActionConstitutiveInverseVerticalLinear boundary coframe
        (p286CoframeActionConstitutiveForwardLinear boundary coframe
          auxiliary) =
      auxiliary := by
  exact
    formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary_constitutive
      boundary coframe nondegenerate auxiliary

/-- The explicitly constructed pair is a linear equivalence in the precise
two-sided sense.  Nondegeneracy certifies the laws; it is not stored by either
linear-map constructor. -/
theorem p286CoframeActionConstitutiveLinearEquivalence
    (boundary : EmpiricalReferenceScaleCouplings)
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0) :
    Function.LeftInverse
        (p286CoframeActionConstitutiveInverseVerticalLinear boundary coframe)
        (p286CoframeActionConstitutiveForwardLinear boundary coframe) ∧
      Function.RightInverse
        (p286CoframeActionConstitutiveInverseVerticalLinear boundary coframe)
        (p286CoframeActionConstitutiveForwardLinear boundary coframe) := by
  constructor
  · exact p286CoframeActionConstitutiveInverseVertical_forward boundary
      coframe nondegenerate
  · exact p286CoframeActionConstitutiveForward_inverseVertical boundary
      coframe nondegenerate

/-- The no-choice right inverse as a map identity, ready for an action
producer to consume. -/
theorem p286CoframeActionConstitutiveForward_comp_inverseVertical
    (boundary : EmpiricalReferenceScaleCouplings)
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0) :
    (p286CoframeActionConstitutiveForwardLinear boundary coframe).comp
        (p286CoframeActionConstitutiveInverseVerticalLinear boundary coframe) =
      LinearMap.id := by
  apply LinearMap.ext
  intro curvature
  exact p286CoframeActionConstitutiveForward_inverseVertical boundary coframe
    nondegenerate curvature

/-! ## Actual vertical derivative -/

/-- With the coframe genuinely frozen, the vertical derivative of the joint
live constitutive inverse is its action-owned curvature linear map. -/
theorem p286CoframeActionConstitutiveInverse_fderiv_vertical
    (boundary : EmpiricalReferenceScaleCouplings)
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (curvature displacement : FormNativeP286GaugeCoordinateTwoForm) :
    (fderiv ℝ
        (fun joint :
            LorentzianCoframe × FormNativeP286GaugeCoordinateTwoForm =>
          formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary boundary
            joint.1 joint.2)
        (coframe, curvature)) (0, displacement) =
      p286CoframeActionConstitutiveInverseVerticalLinear boundary coframe
        displacement := by
  let inverse :
      LorentzianCoframe × FormNativeP286GaugeCoordinateTwoForm →
        FormNativeP286GaugeCoordinateTwoForm :=
    fun joint =>
      formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary boundary
        joint.1 joint.2
  let axis : ℝ →
      LorentzianCoframe × FormNativeP286GaugeCoordinateTwoForm :=
    fun parameter => (coframe, curvature + parameter • displacement)
  have outerDifferentiable :
      DifferentiableAt ℝ inverse (coframe, curvature) := by
    exact
      formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary_joint_differentiableAt
        boundary coframe nondegenerate curvature
  have curvatureDerivative :
      HasDerivAt (fun parameter : ℝ =>
        curvature + parameter • displacement) displacement 0 := by
    have displacementDerivative :
        HasDerivAt (fun parameter : ℝ => parameter • displacement)
          displacement 0 := by
      simpa using
        (hasDerivAt_id (𝕜 := ℝ) (x := 0)).smul_const displacement
    exact displacementDerivative.const_add curvature
  have axisDerivative : HasDerivAt axis (0, displacement) 0 := by
    exact (hasDerivAt_const (x := (0 : ℝ)) (c := coframe)).prodMk
      curvatureDerivative
  have outerAtAxisOrigin :
      HasFDerivAt inverse (fderiv ℝ inverse (coframe, curvature))
        (axis 0) := by
    simpa [axis] using outerDifferentiable.hasFDerivAt
  have direct := outerAtAxisOrigin.comp_hasDerivAt 0 axisDerivative
  change HasDerivAt
    (fun parameter : ℝ =>
      formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary boundary
        coframe (curvature + parameter • displacement))
    ((fderiv ℝ
        (fun joint :
            LorentzianCoframe × FormNativeP286GaugeCoordinateTwoForm =>
          formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary boundary
            joint.1 joint.2)
        (coframe, curvature)) (0, displacement)) 0 at direct
  have expected :
      HasDerivAt
        (fun parameter : ℝ =>
          formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary boundary
            coframe (curvature + parameter • displacement))
        (p286CoframeActionConstitutiveInverseVerticalLinear boundary coframe
          displacement) 0 := by
    have scaledDerivative :
        HasDerivAt
          (fun parameter : ℝ =>
            parameter •
              p286CoframeActionConstitutiveInverseVerticalLinear boundary
                coframe displacement)
          (p286CoframeActionConstitutiveInverseVerticalLinear boundary coframe
            displacement) 0 := by
      simpa using
        (hasDerivAt_id (𝕜 := ℝ) (x := 0)).smul_const
          (p286CoframeActionConstitutiveInverseVerticalLinear boundary coframe
            displacement)
    have linearDerivative :
        HasDerivAt
          (fun parameter : ℝ =>
            p286CoframeActionConstitutiveInverseVerticalLinear boundary
                coframe curvature +
              parameter •
                p286CoframeActionConstitutiveInverseVerticalLinear boundary
                  coframe displacement)
          (p286CoframeActionConstitutiveInverseVerticalLinear boundary coframe
            displacement) 0 := by
      exact scaledDerivative.const_add
        (p286CoframeActionConstitutiveInverseVerticalLinear boundary coframe
          curvature)
    have functionEquality :
        (fun parameter : ℝ =>
          formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary boundary
            coframe (curvature + parameter • displacement)) =
          fun parameter : ℝ =>
            p286CoframeActionConstitutiveInverseVerticalLinear boundary
                coframe curvature +
              parameter •
                p286CoframeActionConstitutiveInverseVerticalLinear boundary
                  coframe displacement := by
      funext parameter
      change
        p286CoframeActionConstitutiveInverseVerticalLinear boundary coframe
            (curvature + parameter • displacement) = _
      rw [map_add, map_smul]
    rw [functionEquality]
    simpa only [zero_add, one_smul] using linearDerivative
  exact direct.unique expected

/-! ## Fixed P506/L0 canonical time-axis specialization -/

/-- The source-owned boundary used by the fixed P506/L0 mother action. -/
abbrev fixedP506L0FinalCommonP286ActionBoundary :
    EmpiricalReferenceScaleCouplings :=
  sourceGeneratedUnifiedCouplings positiveSmoothUnifiedSource

/-- The fixed current's live coframe at one recentered time-axis point. -/
abbrev fixedP506L0FinalCommonTimeAxisP286Coframe
    (space : StageNineSpatialPoint) (time : ℝ) : LorentzianCoframe :=
  (fixedP506L0FinalCommonActionActual space).coframe
    (canonicalCauchySlicePoint time 0)

/-- The fixed source/current/action constructor.  Its output is selected by
the live coframe and action forcing alone; membership in the live domain is
not an input. -/
def fixedP506L0FinalCommonTimeAxisP286ActionPrincipalResponse
    (space : StageNineSpatialPoint)
    (time : ℝ)
    (actionForcing : FormNativeP286GaugeCoordinateTwoForm) :
    FormNativeP286GaugeCoordinateTwoForm :=
  p286CoframeActionConstitutiveInverseVerticalLinear
    fixedP506L0FinalCommonP286ActionBoundary
    (fixedP506L0FinalCommonTimeAxisP286Coframe space time)
    actionForcing

/-- The same constructor as a no-choice linear right-inverse candidate. -/
def fixedP506L0FinalCommonTimeAxisP286ActionPrincipalLinear
    (space : StageNineSpatialPoint)
    (time : ℝ) :
    FormNativeP286GaugeCoordinateTwoForm →ₗ[ℝ]
      FormNativeP286GaugeCoordinateTwoForm :=
  p286CoframeActionConstitutiveInverseVerticalLinear
    fixedP506L0FinalCommonP286ActionBoundary
    (fixedP506L0FinalCommonTimeAxisP286Coframe space time)

@[simp] theorem
    fixedP506L0FinalCommonTimeAxisP286ActionPrincipalLinear_apply
    (space : StageNineSpatialPoint)
    (time : ℝ)
    (actionForcing : FormNativeP286GaugeCoordinateTwoForm) :
    fixedP506L0FinalCommonTimeAxisP286ActionPrincipalLinear space time
        actionForcing =
      fixedP506L0FinalCommonTimeAxisP286ActionPrincipalResponse space time
        actionForcing :=
  rfl

/-- On the canonical source-generated live component, the fixed constructor
is an exact right inverse of the mother action's constitutive principal. -/
theorem fixedP506L0FinalCommonTimeAxisP286ActionPrincipal_sound
    (space : StageNineSpatialPoint)
    (time : ℝ)
    (inDomain :
      time ∈ fixedP506L0FinalCommonTimeAxisOriginDomain space)
    (actionForcing : FormNativeP286GaugeCoordinateTwoForm) :
    p286CoframeActionConstitutiveForwardLinear
        fixedP506L0FinalCommonP286ActionBoundary
        (fixedP506L0FinalCommonTimeAxisP286Coframe space time)
        (fixedP506L0FinalCommonTimeAxisP286ActionPrincipalResponse space time
          actionForcing) =
      actionForcing := by
  exact p286CoframeActionConstitutiveForward_inverseVertical
    fixedP506L0FinalCommonP286ActionBoundary
    (fixedP506L0FinalCommonTimeAxisP286Coframe space time)
    (fixedP506L0FinalCommonTimeAxisOriginDomain_nondegenerate space inDomain)
    actionForcing

/-- Map-level no-choice right-inverse law on the same canonical domain. -/
theorem
    fixedP506L0FinalCommonTimeAxisP286ActionPrincipal_comp_eq_id
    (space : StageNineSpatialPoint)
    (time : ℝ)
    (inDomain :
      time ∈ fixedP506L0FinalCommonTimeAxisOriginDomain space) :
    (p286CoframeActionConstitutiveForwardLinear
        fixedP506L0FinalCommonP286ActionBoundary
        (fixedP506L0FinalCommonTimeAxisP286Coframe space time)).comp
        (fixedP506L0FinalCommonTimeAxisP286ActionPrincipalLinear space time) =
      LinearMap.id := by
  exact p286CoframeActionConstitutiveForward_comp_inverseVertical
    fixedP506L0FinalCommonP286ActionBoundary
    (fixedP506L0FinalCommonTimeAxisP286Coframe space time)
    (fixedP506L0FinalCommonTimeAxisOriginDomain_nondegenerate space inDomain)

/-- The fixed P506/L0 response is the genuine curvature-vertical derivative
of the joint action inverse at every point of the canonical origin domain. -/
theorem fixedP506L0FinalCommonTimeAxisP286ActionPrincipal_eq_fderiv_vertical
    (space : StageNineSpatialPoint)
    (time : ℝ)
    (inDomain :
      time ∈ fixedP506L0FinalCommonTimeAxisOriginDomain space)
    (curvature actionForcing : FormNativeP286GaugeCoordinateTwoForm) :
    fixedP506L0FinalCommonTimeAxisP286ActionPrincipalResponse space time
        actionForcing =
      (fderiv ℝ
        (fun joint :
            LorentzianCoframe × FormNativeP286GaugeCoordinateTwoForm =>
          formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary
            fixedP506L0FinalCommonP286ActionBoundary joint.1 joint.2)
        (fixedP506L0FinalCommonTimeAxisP286Coframe space time, curvature))
        (0, actionForcing) := by
  symm
  exact p286CoframeActionConstitutiveInverse_fderiv_vertical
    fixedP506L0FinalCommonP286ActionBoundary
    (fixedP506L0FinalCommonTimeAxisP286Coframe space time)
    (fixedP506L0FinalCommonTimeAxisOriginDomain_nondegenerate space inDomain)
    curvature actionForcing

end

end
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeFixedP506FinalCommonTimeAxisP286ConstitutiveKernel
