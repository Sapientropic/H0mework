import H0mework.Physics.SpinPair.ColorInvariant
import H0mework.Physics.Homogeneous.Cartan

/-! Exact source spin/gauge locking on the same epsilon pair. The kinetic
coefficient is generated by the actual color and Lorentz representations. -/

set_option autoImplicit false

namespace SaturationMonoid.PhysicsCore.Stage9C.Material.SpinPair

open DiracCliffordRepresentation DiracExteriorMatterAction PointwiseDiracSpinConnectionLift
open ProofFreeRicherAnholonomicSource Stage9C.Dynamics.Homogeneous
open StageNineGlobalIntegratedAction StageNineHolonomicField StageNineCoframeFirstJet
open StageNineCoframeLocalDifferentiability StageNineLorentzConnectionVariation
open StageNineP286GaugeConnectionVariation StageNineP286GaugeConnectionVariationDensity
open SU7ExteriorBreakingYukawa SU7ExteriorMatterGaugeCovariantJet SU7MotherLieAlgebra

noncomputable section

theorem sourceColorDiracMatter_smul (scalar : ℂ) (coefficients : DiracSpinorIndex → Fin 2 → ℂ) :
    sourceColorDiracMatter (scalar • coefficients) = scalar • sourceColorDiracMatter coefficients := by
  funext spin
  simp [sourceColorDiracMatter, smul_smul]

theorem sourceColorDiracMatter_matrix (matrix : DiracMatrix)
    (coefficients : DiracSpinorIndex → Fin 2 → ℂ) :
    diracMatrixMatterAction matrix (sourceColorDiracMatter coefficients) =
      sourceColorDiracMatter (fun spin state => ∑ other, matrix spin other * coefficients other state) := by
  funext spin
  change (∑ other, matrix spin other • ∑ state, coefficients other state • sourceColorDoubletMatter state) =
    ∑ state, (∑ other, matrix spin other * coefficients other state) • sourceColorDoubletMatter state
  simp only [Finset.smul_sum, smul_smul, Finset.sum_smul]
  rw [Finset.sum_comm]

theorem sourceColorDiracMatter_generator (direction : Fin 3)
    (coefficients : DiracSpinorIndex → Fin 2 → ℂ) :
    diracExteriorMotherLieAction (p286LieBlockEmbed (sourceColorP286Generator direction))
      (sourceColorDiracMatter coefficients) =
      sourceColorDiracMatter (fun spin row => ∑ column,
        coefficients spin column * sourceColorPauli direction row column) := by
  funext spin
  change exteriorSpinorMotherLieAction _ (∑ state, coefficients spin state • sourceColorDoubletMatter state) = _
  simp only [map_sum, map_smul, sourceColorDoublet_generatorAction, Finset.smul_sum, smul_smul,
    sourceColorDiracMatter, Finset.sum_smul]
  rw [Finset.sum_comm]

def spinRotation (direction : Fin 3) : DiracMatrix :=
  ![diracGamma 2 * diracGamma 3, diracGamma 3 * diracGamma 1,
    diracGamma 1 * diracGamma 2] direction

theorem spinPair_generator_action (direction : Fin 3) (u v : ℂ) :
    diracExteriorMotherLieAction (p286LieBlockEmbed (sourceColorP286Generator direction))
      (spinPairMatter u v) =
      (-1 / 2 : ℂ) • diracMatrixMatterAction (spinRotation direction) (spinPairMatter u v) := by
  unfold spinPairMatter
  rw [sourceColorDiracMatter_generator, sourceColorDiracMatter_matrix, ← sourceColorDiracMatter_smul]
  congr 1
  funext spin state
  simp only [Pi.smul_apply, smul_eq_mul]
  fin_cases direction <;> fin_cases spin <;> fin_cases state <;>
    simp [spinRotation, sourceColorPauli, spinPairCoefficients,
      diracGamma, diracGammaZero, diracGammaOne, diracGammaTwo, diracGammaThree,
      Fin.sum_univ_four, Fin.sum_univ_two] <;> ring

theorem homogeneousSpinLift (spin : ℝ) (direction : Fin 3) :
    diracSpinConnectionLift (homogeneousConnection spin) direction.succ =
      ((spin : ℂ) / 2) • spinRotation direction := by
  simp only [diracSpinConnectionLift, homogeneousConnection,
    loweredLorentzConnectionCoefficient_ofBivectorOneForm]
  fin_cases direction <;>
    simp [homogeneousContorsion, spinRotation, lorentzBivectorFirst, lorentzBivectorSecond,
      Fin.sum_univ_six]
  all_goals
    congr 1
    ring

theorem spinPair_rotationKinetic (direction : Fin 3) (u v : ℂ) :
    diracMatrixMatterAction (diracGamma direction.succ)
      (diracMatrixMatterAction (spinRotation direction) (spinPairMatter u v)) =
      Complex.I • spinPairMatter v u := by
  rw [show diracMatrixMatterAction (diracGamma direction.succ)
      (diracMatrixMatterAction (spinRotation direction) (spinPairMatter u v)) =
      diracMatrixMatterAction (diracGamma direction.succ * spinRotation direction) (spinPairMatter u v) by
    rw [diracMatrixMatterAction_mul, LinearMap.comp_apply]]
  unfold spinPairMatter
  rw [sourceColorDiracMatter_matrix, ← sourceColorDiracMatter_smul]
  congr 1
  funext spin state
  simp only [Pi.smul_apply, smul_eq_mul]
  fin_cases direction <;> fin_cases spin <;> fin_cases state <;>
    simp [spinRotation, spinPairCoefficients, Matrix.mul_apply,
      diracGamma, diracGammaZero, diracGammaOne, diracGammaTwo, diracGammaThree,
      Fin.sum_univ_four]

theorem spinPair_spatialCovariantTerm
    (spin amplitude : ℝ) (direction : Fin 3) (u v : ℂ) :
    diracMatrixMatterAction (diracSpinConnectionLift (homogeneousConnection spin) direction.succ)
        (spinPairMatter u v) +
      diracExteriorMotherLieAction (p286LieBlockEmbed (amplitude • sourceColorP286Generator direction))
        (spinPairMatter u v) =
      (((spin-amplitude : ℝ) : ℂ) / 2) •
        diracMatrixMatterAction (spinRotation direction) (spinPairMatter u v) := by
  rw [homogeneousSpinLift, coframeDiracMatrixMatterAction_smul_matrix,
    p286LieBlockEmbed_real_smul, diracExteriorMotherLieAction_real_smul,
    LinearMap.smul_apply, spinPair_generator_action]
  push_cast
  module

theorem spinPair_spatialKinetic
    (spin amplitude : ℝ) (direction : Fin 3) (u v : ℂ) :
    Complex.I • diracMatrixMatterAction (diracGamma direction.succ)
      (diracMatrixMatterAction (diracSpinConnectionLift (homogeneousConnection spin) direction.succ)
          (spinPairMatter u v) +
        diracExteriorMotherLieAction (p286LieBlockEmbed (amplitude • sourceColorP286Generator direction))
          (spinPairMatter u v)) =
      (-((spin-amplitude : ℝ) : ℂ) / 2) • spinPairMatter v u := by
  rw [spinPair_spatialCovariantTerm, map_smul, spinPair_rotationKinetic]
  simp only [smul_smul]
  congr 1
  ring_nf
  simp [Complex.I_sq]
  ring

theorem spinPair_temporalKinetic (frequency u v : ℂ) :
    Complex.I • diracMatrixMatterAction (diracGamma 0)
      (spinPairMatter (Complex.I*frequency*u) (-Complex.I*frequency*v)) =
      frequency • spinPairMatter v u := by
  unfold spinPairMatter
  rw [sourceColorDiracMatter_matrix, ← sourceColorDiracMatter_smul, ← sourceColorDiracMatter_smul]
  congr 1
  funext spin state
  simp only [Pi.smul_apply, smul_eq_mul]
  fin_cases spin <;> fin_cases state <;>
    simp [spinPairCoefficients, diracGamma, diracGammaZero, Fin.sum_univ_four] <;> ring_nf
  all_goals simp [Complex.I_sq]

end
end SaturationMonoid.PhysicsCore.Stage9C.Material.SpinPair
