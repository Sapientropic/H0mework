import H0mework.Physics.Gauge.GaugeWedge
import H0mework.Physics.Exterior.MotherAction

/-!
# Form-native gauge-auxiliary variation

This module varies the actual primitive `SU(3) × SU(2) × U(1)` auxiliary
two-form in the authoritative form-native Stage-9 mother density.  The three
couplings are read independently from the typed boundary, while the dynamic
Hodge is recomputed from the same live coframe.  The derivative generated by
the action is exactly

`W_P286(deltaB, F - K_e B)`.

The collapse from the two quadratic cross terms to `K_e B` uses the
form-native wedge self-adjointness proved in the preceding module; it is not
borrowed from the historical volume-times-metric action.  The faithful dual
then identifies the exact zero fiber without accepting an equation,
stationarity receipt, inverse operator, coverage witness, or target solution
as a premise.

This checkpoint is pointwise and holonomic-local.  Compact-support
integration, the gauge-connection/current equation, auxiliary elimination,
and a simultaneous stationary actual remain downstream obligations.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineFormNativeGaugeAuxiliaryVariation

open EmpiricalReferenceScaleCouplingBoundary
open ProofFreeRicherAnholonomicSource
open StageNineBlockwiseConstitutive
open StageNineEnrichedProofFreeSource
open StageNineFormNativeGaugeWedge
open StageNineFormNativeMotherAction
open StageNineGlobalIntegratedAction
open StageNineHolonomicField

noncomputable section

set_option autoImplicit false

/-! ## Full P286 readouts and setter -/

/-- Replace only the primitive P286 auxiliary two-form. -/
def withFormNativeP286GaugeAuxiliary
    (field : StageNineContinuumPointField)
    (auxiliary : FormNativeP286GaugeTwoForm) :
    StageNineContinuumPointField :=
  { field with gaugeAuxiliary := auxiliary }

@[simp] theorem withFormNativeP286GaugeAuxiliary_coframe
    (field : StageNineContinuumPointField)
    (auxiliary : FormNativeP286GaugeTwoForm) :
    (withFormNativeP286GaugeAuxiliary field auxiliary).coframe =
      field.coframe :=
  rfl

@[simp] theorem withFormNativeP286GaugeAuxiliary_curvature
    (field : StageNineContinuumPointField)
    (auxiliary : FormNativeP286GaugeTwoForm) :
    (withFormNativeP286GaugeAuxiliary field auxiliary).gaugeCurvature =
      field.gaugeCurvature :=
  rfl

@[simp] theorem withFormNativeP286GaugeAuxiliary_auxiliary
    (field : StageNineContinuumPointField)
    (auxiliary : FormNativeP286GaugeTwoForm) :
    (withFormNativeP286GaugeAuxiliary field auxiliary).gaugeAuxiliary =
      auxiliary :=
  rfl

@[simp] theorem generatedFormNativeGravityBFDensity_withP286Auxiliary
    (field : StageNineContinuumPointField)
    (auxiliary : FormNativeP286GaugeTwoForm) :
    generatedFormNativeGravityBFDensity
        (withFormNativeP286GaugeAuxiliary field auxiliary) =
      generatedFormNativeGravityBFDensity field :=
  rfl

@[simp] theorem generatedFormNativeGravityConstraintDensity_withP286Auxiliary
    (field : StageNineContinuumPointField)
    (auxiliary : FormNativeP286GaugeTwoForm) :
    generatedFormNativeGravityConstraintDensity
        (withFormNativeP286GaugeAuxiliary field auxiliary) =
      generatedFormNativeGravityConstraintDensity field :=
  rfl

@[simp] theorem generatedFormNativeMatterDensity_withP286Auxiliary
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (auxiliary : FormNativeP286GaugeTwoForm) :
    generatedFormNativeMatterDensity source chart point
        (withFormNativeP286GaugeAuxiliary field auxiliary) =
      generatedFormNativeMatterDensity source chart point field :=
  rfl

/-! ## The active gauge density in one faithful full-block carrier -/

/-- Repackage the three active gauge blocks without identifying their three
couplings.  This is an equality of the actual mother-density definition. -/
theorem generatedFormNativeGaugeDensityAtBoundary_eq_p286
    (boundary : EmpiricalReferenceScaleCouplings)
    (field : StageNineContinuumPointField) :
    generatedFormNativeGaugeDensityAtBoundary boundary field =
      formNativeP286GaugeWedgeCoefficient field.gaugeAuxiliary
          field.gaugeCurvature -
        (1 / 2 : ℝ) *
          formNativeP286GaugeWedgeCoefficient field.gaugeAuxiliary
            (formNativeP286BlockwiseConstitutive field.coframe
              (boundary.strongCouplingSquared : ℝ)
              (boundary.weakCouplingSquared : ℝ)
              (boundary.hyperchargeCouplingSquared : ℝ)
              field.gaugeAuxiliary) := by
  rw [formNativeP286GaugeWedgeCoefficient_decompose,
    formNativeP286GaugeWedgeCoefficient_decompose]
  unfold generatedFormNativeGaugeDensityAtBoundary
    generatedFormNativeGaugeSectorBFDensity
    gaugeConstitutiveOperatorAtBoundary
    formNativeP286BlockwiseConstitutive
  ring

/-- The genuine action-generated full P286 auxiliary Euler residual. -/
def formNativeP286GaugeAuxiliaryEulerResidualAtBoundary
    (boundary : EmpiricalReferenceScaleCouplings)
    (field : StageNineContinuumPointField) :
    FormNativeP286GaugeTwoForm :=
  field.gaugeCurvature -
    formNativeP286BlockwiseConstitutive field.coframe
      (boundary.strongCouplingSquared : ℝ)
      (boundary.weakCouplingSquared : ℝ)
      (boundary.hyperchargeCouplingSquared : ℝ)
      field.gaugeAuxiliary

/-- The corresponding faithful variational covector. -/
def formNativeP286GaugeAuxiliaryEulerDualAtBoundary
    (boundary : EmpiricalReferenceScaleCouplings)
    (field : StageNineContinuumPointField) :
    Module.Dual ℝ FormNativeP286GaugeTwoForm :=
  formNativeP286GaugeWedgeDual
    (formNativeP286GaugeAuxiliaryEulerResidualAtBoundary boundary field)

def formNativeP286GaugeAuxiliaryFirstVariationDensityAtBoundary
    (boundary : EmpiricalReferenceScaleCouplings)
    (field : StageNineContinuumPointField)
    (variation : FormNativeP286GaugeTwoForm) : ℝ :=
  formNativeP286GaugeWedgeCoefficient variation
    (formNativeP286GaugeAuxiliaryEulerResidualAtBoundary boundary field)

def formNativeP286GaugeAuxiliaryQuadraticCoefficientDensityAtBoundary
    (boundary : EmpiricalReferenceScaleCouplings)
    (field : StageNineContinuumPointField)
    (variation : FormNativeP286GaugeTwoForm) : ℝ :=
  -(1 / 2 : ℝ) *
    formNativeP286GaugeWedgeCoefficient variation
      (formNativeP286BlockwiseConstitutive field.coframe
        (boundary.strongCouplingSquared : ℝ)
        (boundary.weakCouplingSquared : ℝ)
        (boundary.hyperchargeCouplingSquared : ℝ)
        variation)

private theorem formNativeP286GaugeWedgeCoefficient_sub_right
    (first second residual : FormNativeP286GaugeTwoForm) :
    formNativeP286GaugeWedgeCoefficient residual (first - second) =
      formNativeP286GaugeWedgeCoefficient residual first -
        formNativeP286GaugeWedgeCoefficient residual second := by
  rw [sub_eq_add_neg, formNativeP286GaugeWedgeCoefficient_add_right]
  rw [show -second = (-1 : ℝ) • second by
      exact (neg_one_smul ℝ second).symm,
    formNativeP286GaugeWedgeCoefficient_smul_right]
  ring

theorem generatedFormNativeGaugeDensityAtBoundary_auxiliary_quadratic
    (boundary : EmpiricalReferenceScaleCouplings)
    (field : StageNineContinuumPointField)
    (nondegenerate : Matrix.det field.coframe ≠ 0)
    (variation : FormNativeP286GaugeTwoForm) (parameter : ℝ) :
    generatedFormNativeGaugeDensityAtBoundary boundary
        (withFormNativeP286GaugeAuxiliary field
          (field.gaugeAuxiliary + parameter • variation)) =
      generatedFormNativeGaugeDensityAtBoundary boundary field +
        parameter *
          formNativeP286GaugeAuxiliaryFirstVariationDensityAtBoundary
            boundary field variation +
        parameter ^ 2 *
          formNativeP286GaugeAuxiliaryQuadraticCoefficientDensityAtBoundary
            boundary field variation := by
  rw [generatedFormNativeGaugeDensityAtBoundary_eq_p286,
    generatedFormNativeGaugeDensityAtBoundary_eq_p286]
  simp only [withFormNativeP286GaugeAuxiliary_auxiliary,
    withFormNativeP286GaugeAuxiliary_curvature,
    withFormNativeP286GaugeAuxiliary_coframe]
  rw [formNativeP286BlockwiseConstitutive_add,
    formNativeP286BlockwiseConstitutive_smul]
  simp_rw [
    formNativeP286GaugeWedgeCoefficient_add_left,
    formNativeP286GaugeWedgeCoefficient_smul_left,
    formNativeP286GaugeWedgeCoefficient_add_right,
    formNativeP286GaugeWedgeCoefficient_smul_right]
  rw [formNativeP286GaugeWedgeCoefficient_blockwiseConstitutive_symmetric
    field.coframe nondegenerate
    (boundary.strongCouplingSquared : ℝ)
    (boundary.weakCouplingSquared : ℝ)
    (boundary.hyperchargeCouplingSquared : ℝ)
    field.gaugeAuxiliary variation]
  unfold formNativeP286GaugeAuxiliaryFirstVariationDensityAtBoundary
    formNativeP286GaugeAuxiliaryQuadraticCoefficientDensityAtBoundary
    formNativeP286GaugeAuxiliaryEulerResidualAtBoundary
  rw [formNativeP286GaugeWedgeCoefficient_sub_right]
  ring

/-! ## Unified pointwise derivative -/

theorem generatedFormNativeUnifiedLocalDensityAtBoundary_p286Auxiliary_quadratic
    (source : SmoothUnifiedSource)
    (boundary : EmpiricalReferenceScaleCouplings)
    (chart : StageNineChart) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (nondegenerate : Matrix.det field.coframe ≠ 0)
    (variation : FormNativeP286GaugeTwoForm) (parameter : ℝ) :
    generatedFormNativeUnifiedLocalDensityAtBoundary source boundary chart point
        (withFormNativeP286GaugeAuxiliary field
          (field.gaugeAuxiliary + parameter • variation)) =
      generatedFormNativeUnifiedLocalDensityAtBoundary source boundary chart point
          field +
        parameter *
          formNativeP286GaugeAuxiliaryFirstVariationDensityAtBoundary
            boundary field variation +
        parameter ^ 2 *
          formNativeP286GaugeAuxiliaryQuadraticCoefficientDensityAtBoundary
            boundary field variation := by
  unfold generatedFormNativeUnifiedLocalDensityAtBoundary
  rw [generatedFormNativeGaugeDensityAtBoundary_auxiliary_quadratic boundary
    field nondegenerate variation parameter]
  simp only [generatedFormNativeGravityBFDensity_withP286Auxiliary,
    generatedFormNativeGravityConstraintDensity_withP286Auxiliary,
    generatedFormNativeMatterDensity_withP286Auxiliary]
  ring

theorem generatedFormNativeUnifiedLocalDensityAtBoundary_p286Auxiliary_hasDerivAt
    (source : SmoothUnifiedSource)
    (boundary : EmpiricalReferenceScaleCouplings)
    (chart : StageNineChart) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (nondegenerate : Matrix.det field.coframe ≠ 0)
    (variation : FormNativeP286GaugeTwoForm) :
    HasDerivAt
      (fun parameter : ℝ =>
        generatedFormNativeUnifiedLocalDensityAtBoundary source boundary chart
          point
          (withFormNativeP286GaugeAuxiliary field
            (field.gaugeAuxiliary + parameter • variation)))
      (formNativeP286GaugeAuxiliaryFirstVariationDensityAtBoundary
        boundary field variation) 0 := by
  let firstCoefficient :=
    formNativeP286GaugeAuxiliaryFirstVariationDensityAtBoundary
      boundary field variation
  let secondCoefficient :=
    formNativeP286GaugeAuxiliaryQuadraticCoefficientDensityAtBoundary
      boundary field variation
  have formula :
      (fun parameter : ℝ =>
        generatedFormNativeUnifiedLocalDensityAtBoundary source boundary chart
          point
          (withFormNativeP286GaugeAuxiliary field
            (field.gaugeAuxiliary + parameter • variation))) =
        fun parameter =>
          generatedFormNativeUnifiedLocalDensityAtBoundary source boundary chart
              point field +
            parameter * firstCoefficient + parameter ^ 2 * secondCoefficient := by
    funext parameter
    exact
      generatedFormNativeUnifiedLocalDensityAtBoundary_p286Auxiliary_quadratic
        source boundary chart point field nondegenerate variation parameter
  rw [formula]
  change HasDerivAt
    ((fun parameter =>
      generatedFormNativeUnifiedLocalDensityAtBoundary source boundary chart
          point field + parameter * firstCoefficient) +
      fun parameter => parameter ^ 2 * secondCoefficient)
    firstCoefficient 0
  simpa using
    ((((hasDerivAt_id (x := (0 : ℝ))).mul_const firstCoefficient).const_add
      (generatedFormNativeUnifiedLocalDensityAtBoundary source boundary chart
        point field)).add
      (((hasDerivAt_id (x := (0 : ℝ))).pow 2).mul_const
        secondCoefficient))

/-! ## Faithful zero fiber -/

theorem formNativeP286GaugeAuxiliaryFirstVariationDensity_eq_eulerDual
    (boundary : EmpiricalReferenceScaleCouplings)
    (field : StageNineContinuumPointField)
    (variation : FormNativeP286GaugeTwoForm) :
    formNativeP286GaugeAuxiliaryFirstVariationDensityAtBoundary
        boundary field variation =
      formNativeP286GaugeAuxiliaryEulerDualAtBoundary boundary field variation := by
  unfold formNativeP286GaugeAuxiliaryFirstVariationDensityAtBoundary
    formNativeP286GaugeAuxiliaryEulerDualAtBoundary
    formNativeP286GaugeWedgeDual
  change formNativeP286GaugeWedgeCoefficient variation
      (formNativeP286GaugeAuxiliaryEulerResidualAtBoundary boundary field) =
    formNativeP286GaugeWedgeCoefficient
      (formNativeP286GaugeAuxiliaryEulerResidualAtBoundary boundary field)
      variation
  rw [formNativeP286GaugeWedgeCoefficient_symmetric]

theorem formNativeP286GaugeAuxiliaryEulerDual_eq_zero_iff
    (boundary : EmpiricalReferenceScaleCouplings)
    (field : StageNineContinuumPointField) :
    formNativeP286GaugeAuxiliaryEulerDualAtBoundary boundary field = 0 ↔
      formNativeP286GaugeAuxiliaryEulerResidualAtBoundary boundary field = 0 :=
  formNativeP286GaugeWedgeDual_eq_zero_iff _

def FormNativeP286GaugeAuxiliaryEquationAtBoundary
    (boundary : EmpiricalReferenceScaleCouplings)
    (field : StageNineContinuumPointField) : Prop :=
  field.gaugeCurvature =
    formNativeP286BlockwiseConstitutive field.coframe
      (boundary.strongCouplingSquared : ℝ)
      (boundary.weakCouplingSquared : ℝ)
      (boundary.hyperchargeCouplingSquared : ℝ)
      field.gaugeAuxiliary

theorem formNativeP286GaugeAuxiliaryEulerResidual_eq_zero_iff
    (boundary : EmpiricalReferenceScaleCouplings)
    (field : StageNineContinuumPointField) :
    formNativeP286GaugeAuxiliaryEulerResidualAtBoundary boundary field = 0 ↔
      FormNativeP286GaugeAuxiliaryEquationAtBoundary boundary field := by
  simp [formNativeP286GaugeAuxiliaryEulerResidualAtBoundary,
    FormNativeP286GaugeAuxiliaryEquationAtBoundary, sub_eq_zero]

/-- The action-generated variational covector has exactly the advertised
constitutive zero fiber.  This is a faithful identity theorem, not a supplied
solution certificate. -/
theorem formNativeP286GaugeAuxiliaryEulerDual_eq_zero_iff_equation
    (boundary : EmpiricalReferenceScaleCouplings)
    (field : StageNineContinuumPointField) :
    formNativeP286GaugeAuxiliaryEulerDualAtBoundary boundary field = 0 ↔
      FormNativeP286GaugeAuxiliaryEquationAtBoundary boundary field := by
  rw [formNativeP286GaugeAuxiliaryEulerDual_eq_zero_iff,
    formNativeP286GaugeAuxiliaryEulerResidual_eq_zero_iff]

/-! ## Actual primitive holonomic path -/

def varyFormNativeP286GaugeAuxiliary
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → FormNativeP286GaugeTwoForm)
    (parameter : ℝ) : StageNineHolonomicConfiguration :=
  { configuration with
    gaugeAuxiliary := fun point =>
      configuration.gaugeAuxiliary point + parameter • variation point }

theorem toContinuumPointField_varyFormNativeP286GaugeAuxiliary
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → FormNativeP286GaugeTwoForm)
    (parameter : ℝ) (point : BasePoint) :
    toContinuumPointField
        (varyFormNativeP286GaugeAuxiliary configuration variation parameter)
        point =
      withFormNativeP286GaugeAuxiliary
        (toContinuumPointField configuration point)
        (configuration.gaugeAuxiliary point + parameter • variation point) :=
  rfl

def holonomicFormNativeP286GaugeAuxiliaryFirstVariationDensity
    (boundary : EmpiricalReferenceScaleCouplings)
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → FormNativeP286GaugeTwoForm)
    (point : BasePoint) : ℝ :=
  formNativeP286GaugeAuxiliaryFirstVariationDensityAtBoundary boundary
    (toContinuumPointField configuration point) (variation point)

theorem holonomicFormNativeLocalDensity_p286Auxiliary_hasDerivAt
    (source : SmoothUnifiedSource)
    (boundary : EmpiricalReferenceScaleCouplings)
    (chart : StageNineChart) (point : BasePoint)
    (configuration : StageNineHolonomicConfiguration)
    (nondegenerate : Matrix.det (configuration.coframe point) ≠ 0)
    (variation : BasePoint → FormNativeP286GaugeTwoForm) :
    HasDerivAt
      (fun parameter : ℝ =>
        generatedFormNativeUnifiedLocalDensityAtBoundary source boundary chart
          point
          (toContinuumPointField
            (varyFormNativeP286GaugeAuxiliary configuration variation parameter)
            point))
      (holonomicFormNativeP286GaugeAuxiliaryFirstVariationDensity boundary
        configuration variation point) 0 := by
  rw [show (fun parameter : ℝ =>
      generatedFormNativeUnifiedLocalDensityAtBoundary source boundary chart
        point
        (toContinuumPointField
          (varyFormNativeP286GaugeAuxiliary configuration variation parameter)
          point)) =
      fun parameter =>
        generatedFormNativeUnifiedLocalDensityAtBoundary source boundary chart
          point
          (withFormNativeP286GaugeAuxiliary
            (toContinuumPointField configuration point)
            (configuration.gaugeAuxiliary point +
              parameter • variation point)) by
    funext parameter
    rw [toContinuumPointField_varyFormNativeP286GaugeAuxiliary]]
  exact
    generatedFormNativeUnifiedLocalDensityAtBoundary_p286Auxiliary_hasDerivAt
      source boundary chart point (toContinuumPointField configuration point)
      nondegenerate (variation point)

end

end
  SaturationMonoid.PhysicsCore.StageNineFormNativeGaugeAuxiliaryVariation
