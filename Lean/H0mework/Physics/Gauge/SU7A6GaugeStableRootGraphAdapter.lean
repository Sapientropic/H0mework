import H0mework.Physics.Gauge.SU7A6GaugeCompatibilityBoundary
import H0mework.Arithmetic.SourceAtoms.EndpointRootAction

/-!
# Endpoint-stable SU7/A6 root graph with P348 gauge standing

The previous boundary shows that all six unfiltered A6 simple roots are too
broad for the P348 trace audit.  There is nevertheless a genuine nontrivial
subgraph available without assuming endpoint coverage: simple roots `3,4,5`
have zero Cartan entries at Dynkin coordinates `0,1`, the repository's
endpoint-code readout coordinates.

This module builds the commutative multiset graph generated by exactly those
three native roots.  It proves root reachability, exact signed-height unit
descent, and global confluence.  It also proves that every source move keeps
the endpoint codes and raw P348 field fixed.  Source moves and SU3 gauge-frame
changes therefore coexist on one carrier with nonconstant `(fiber, rootLabel)`
lineage, and color-loop trace exactness is a genuine standing invariant.

The root alphabet, ordered action, and commutative label readout come from the
shared lower `SU7A6EndpointStableRootActionCore`.  This adapter adds the source
graph and physical field; it does not redefine that arithmetic.

Boundary: endpoint stability is weaker than the full physical filter.  This
module does not prove Schubert-branch/incidence preservation, no-prime
filtering, completion, thin-datum generation, or omega gluing.
-/

namespace SaturationMonoid
namespace PhysicsCore
namespace SU7A6GaugeStableRootGraphAdapter

open StandardModelConstraint
open SU7A6RootGraphStandingAdapter

noncomputable section

abbrev StableRootIndex := SU7A6StableRootIndex
abbrev StableDerivationState := SU7A6StableDerivationState

/-- Embed the three endpoint-invisible roots as A6 roots `3,4,5`. -/
def toA6Root (root : StableRootIndex) : RootIndex :=
  su7A6StableRootToA6Root root

@[simp] theorem cartan_zero_at_leftEndpoint (root : StableRootIndex) :
    su7A6CartanEntry (toA6Root root) (0 : Fin 6) = 0 := by
  exact su7A6StableRoot_cartan_zero_at_leftEndpoint root

@[simp] theorem cartan_zero_at_rightEndpoint (root : StableRootIndex) :
    su7A6CartanEntry (toA6Root root) (1 : Fin 6) = 0 := by
  exact su7A6StableRoot_cartan_zero_at_rightEndpoint root

def embedMoves (moves : StableDerivationState) : DerivationState :=
  moves.map toA6Root

def generatedLabel
    (rootLabel : SU7A6WeightLabel) (moves : StableDerivationState) :
    SU7A6WeightLabel :=
  su7A6StableGeneratedLabel rootLabel moves

@[simp] theorem generatedLabel_zero
    (rootLabel : SU7A6WeightLabel) :
    generatedLabel rootLabel 0 = rootLabel := by
  exact su7A6StableGeneratedLabel_zero rootLabel

theorem generatedLabel_cons
    (rootLabel : SU7A6WeightLabel)
    (moves : StableDerivationState) (simpleRoot : StableRootIndex) :
    generatedLabel rootLabel (simpleRoot ::ₘ moves) =
      su7A6LowerBySimpleRoot (toA6Root simpleRoot)
        (generatedLabel rootLabel moves) := by
  exact su7A6StableGeneratedLabel_cons rootLabel moves simpleRoot

/-- The adapter's commutative label is the readout of the shared ordered
stable-root action.  The ordered word remains external provenance; this
theorem does not reconstruct it from the multiset. -/
theorem orderedAction_eq_generatedLabel
    (rootLabel : SU7A6WeightLabel)
    (word : List StableRootIndex) :
    su7A6StableRootAction rootLabel word =
      generatedLabel rootLabel (word : StableDerivationState) := by
  exact su7A6StableRootAction_eq_generatedLabel rootLabel word

theorem generatedLabel_leftEndpoint
    (rootLabel : SU7A6WeightLabel) (moves : StableDerivationState) :
    generatedLabel rootLabel moves (0 : Fin 6) = rootLabel (0 : Fin 6) := by
  exact su7A6StableGeneratedLabel_leftEndpoint rootLabel moves

theorem generatedLabel_rightEndpoint
    (rootLabel : SU7A6WeightLabel) (moves : StableDerivationState) :
    generatedLabel rootLabel moves (1 : Fin 6) = rootLabel (1 : Fin 6) := by
  exact su7A6StableGeneratedLabel_rightEndpoint rootLabel moves

theorem leftCode_generatedLabel
    (rootLabel : SU7A6WeightLabel) (moves : StableDerivationState) :
    su7A6EndpointSourceLeftCodeOf (generatedLabel rootLabel moves) =
      su7A6EndpointSourceLeftCodeOf rootLabel := by
  exact su7A6StableGeneratedLabel_preserves_leftEndpointCode
    rootLabel moves

theorem rightCode_generatedLabel
    (rootLabel : SU7A6WeightLabel) (moves : StableDerivationState) :
    su7A6EndpointSourceRightCodeOf (generatedLabel rootLabel moves) =
      su7A6EndpointSourceRightCodeOf rootLabel := by
  exact su7A6StableGeneratedLabel_preserves_rightEndpointCode
    rootLabel moves

/-! ## Stable-root source graph -/

def successors (moves : StableDerivationState) :
    List StableDerivationState :=
  (List.finRange 3).map fun simpleRoot => simpleRoot ::ₘ moves

def sourceSystem
    (rootLabel : SU7A6WeightLabel) (current : StableDerivationState) :
    RawSourceDynamics StableDerivationState StableDerivationState Int where
  roots := [0]
  successors := successors
  current := some current
  handleOf := id
  energyOf := fun moves => su7A6SignedHeight (generatedLabel rootLabel moves)

theorem step_cons
    (rootLabel : SU7A6WeightLabel)
    (current moves : StableDerivationState)
    (simpleRoot : StableRootIndex) :
    (sourceSystem rootLabel current).Step moves (simpleRoot ::ₘ moves) := by
  simp [RawSourceDynamics.Step, sourceSystem, successors]

theorem reachableFrom_zero
    (rootLabel : SU7A6WeightLabel)
    (current moves : StableDerivationState) :
    (sourceSystem rootLabel current).ReachableFrom 0 moves := by
  induction moves using Multiset.induction_on with
  | empty => exact Relation.ReflTransGen.refl
  | @cons simpleRoot tail ih =>
      exact ih.trans
        (Relation.ReflTransGen.single
          (step_cons rootLabel current tail simpleRoot))

theorem everyState_reachable
    (rootLabel : SU7A6WeightLabel)
    (current moves : StableDerivationState) :
    (sourceSystem rootLabel current).Reachable moves :=
  ⟨0, by simp [sourceSystem], reachableFrom_zero rootLabel current moves⟩

theorem currentSourceReachable
    (rootLabel : SU7A6WeightLabel) (current : StableDerivationState) :
    (sourceSystem rootLabel current).CurrentSourceReachable :=
  ⟨current, rfl, 0, by simp [sourceSystem],
    reachableFrom_zero rootLabel current current⟩

theorem step_signedHeight_unit
    (rootLabel : SU7A6WeightLabel) (current : StableDerivationState)
    {source target : StableDerivationState}
    (hstep : (sourceSystem rootLabel current).Step source target) :
    su7A6SignedHeight (generatedLabel rootLabel target) + 1 =
      su7A6SignedHeight (generatedLabel rootLabel source) := by
  change target ∈ successors source at hstep
  simp only [successors, List.mem_map, List.mem_finRange] at hstep
  rcases hstep with ⟨simpleRoot, _hbound, rfl⟩
  rw [generatedLabel_cons]
  exact su7A6SignedHeight_lowerBySimpleRoot
    (generatedLabel rootLabel source) (toA6Root simpleRoot)

theorem sourceEnergyMonotone
    (rootLabel : SU7A6WeightLabel) (current : StableDerivationState) :
    (sourceSystem rootLabel current).SourceEnergyMonotone := by
  intro source target hstep
  have hunit := step_signedHeight_unit rootLabel current hstep
  change
    su7A6SignedHeight (generatedLabel rootLabel target) ≤
      su7A6SignedHeight (generatedLabel rootLabel source)
  omega

theorem reachableFrom_add
    (rootLabel : SU7A6WeightLabel) (current : StableDerivationState)
    (left right : StableDerivationState) :
    (sourceSystem rootLabel current).ReachableFrom left (left + right) := by
  induction right using Multiset.induction_on with
  | empty =>
      change Relation.ReflTransGen
        (sourceSystem rootLabel current).Step left (left + 0)
      simpa using
        (Relation.ReflTransGen.refl :
          Relation.ReflTransGen
            (sourceSystem rootLabel current).Step left left)
  | @cons simpleRoot tail ih =>
      have hstep :
          (sourceSystem rootLabel current).Step
            (left + tail) (simpleRoot ::ₘ (left + tail)) :=
        step_cons rootLabel current (left + tail) simpleRoot
      have hpath := ih.trans (Relation.ReflTransGen.single hstep)
      change Relation.ReflTransGen (sourceSystem rootLabel current).Step
        left (left + (simpleRoot ::ₘ tail))
      simpa [Multiset.add_cons] using hpath

theorem graphConfluent
    (rootLabel : SU7A6WeightLabel) (current : StableDerivationState) :
    (sourceSystem rootLabel current).GraphConfluent := by
  intro declaredRoot hroot left right hleft hright
  have hrootZero : declaredRoot = 0 := by
    simpa [sourceSystem] using hroot
  subst declaredRoot
  refine ⟨left + right, reachableFrom_add rootLabel current left right, ?_⟩
  simpa [Multiset.add_comm] using
    (reachableFrom_add rootLabel current right left)

theorem handleFaithfulOnReachable
    (rootLabel : SU7A6WeightLabel) (current : StableDerivationState) :
    (sourceSystem rootLabel current).HandleFaithfulOnReachable := by
  intro left right _hleft _hright hhandle
  exact hhandle

theorem sourceSystem_admissible
    (rootLabel : SU7A6WeightLabel) (current : StableDerivationState) :
    (sourceSystem rootLabel current).SourceDynamicsAdmissible :=
  ⟨currentSourceReachable rootLabel current,
    sourceEnergyMonotone rootLabel current,
    graphConfluent rootLabel current,
    handleFaithfulOnReachable rootLabel current⟩

/-! ## Source-generated P348 field and joint standing graph -/

def rawField
    (fiber : Nat) (rootLabel : SU7A6WeightLabel)
    (moves : StableDerivationState) : ColorLoopField :=
  rawCodeColorLoopMatrix fiber
    (su7A6EndpointSourceLeftCodeOf (generatedLabel rootLabel moves))
    (su7A6EndpointSourceRightCodeOf (generatedLabel rootLabel moves))

theorem rawField_eq_root
    (fiber : Nat) (rootLabel : SU7A6WeightLabel)
    (moves : StableDerivationState) :
    rawField fiber rootLabel moves = rawField fiber rootLabel 0 := by
  simp [rawField, leftCode_generatedLabel, rightCode_generatedLabel]

structure Presentation where
  fiber : Nat
  rootLabel : SU7A6WeightLabel
  moves : StableDerivationState
  gaugeFrame : GaugeProjection.SU3Gauge

namespace Presentation

def currentLabel (presentation : Presentation) : SU7A6WeightLabel :=
  generatedLabel presentation.rootLabel presentation.moves

def field (presentation : Presentation) : ColorLoopField :=
  colorLoopGaugeAction presentation.gaugeFrame
    (rawField presentation.fiber presentation.rootLabel presentation.moves)

def sourceReachable (presentation : Presentation) : Prop :=
  (sourceSystem presentation.rootLabel presentation.moves).Reachable
    presentation.moves

def sourceConfluent (presentation : Presentation) : Prop :=
  (sourceSystem presentation.rootLabel presentation.moves).GraphConfluent

end Presentation

inductive Move where
  | lower (simpleRoot : StableRootIndex)
  | gauge (frameChange : GaugeProjection.SU3Gauge)

def apply : Move → Presentation → Option Presentation
  | .lower simpleRoot, presentation =>
      some
        { presentation with
          moves := simpleRoot ::ₘ presentation.moves }
  | .gauge frameChange, presentation =>
      some
        { presentation with
          gaugeFrame := frameChange * presentation.gaugeFrame }

def operations :
    AnchoredStandingOperations Presentation Move
      (Nat × SU7A6WeightLabel) where
  toNativeStandingOperations := { apply }
  anchor := fun presentation => (presentation.fiber, presentation.rootLabel)
  anchor_preserved := by
    intro move source result happlies
    cases move <;>
      simp only [apply, Option.some.injEq] at happlies <;>
      subst result <;>
      rfl

theorem field_lower
    (presentation : Presentation) (simpleRoot : StableRootIndex) :
    ({ presentation with
        moves := simpleRoot ::ₘ presentation.moves } : Presentation).field =
      presentation.field := by
  simp only [Presentation.field]
  rw [rawField_eq_root presentation.fiber presentation.rootLabel
      (simpleRoot ::ₘ presentation.moves),
    rawField_eq_root presentation.fiber presentation.rootLabel
      presentation.moves]

theorem field_gauge
    (presentation : Presentation)
    (frameChange : GaugeProjection.SU3Gauge) :
    ({ presentation with
        gaugeFrame := frameChange * presentation.gaugeFrame } : Presentation).field =
      colorLoopGaugeAction frameChange presentation.field := by
  exact colorLoopGaugeAction_mul frameChange presentation.gaugeFrame
    (rawField presentation.fiber presentation.rootLabel presentation.moves)

theorem traceExact_nativeMoveInvariant :
    NativeMoveInvariant operations.toNativeStandingOperations
      (fun presentation => ColorLoopTraceExact presentation.field) := by
  intro move source result happlies
  cases move with
  | lower simpleRoot =>
      change apply (.lower simpleRoot) source = some result at happlies
      simp only [apply, Option.some.injEq] at happlies
      subst result
      change ColorLoopTraceExact source.field ↔
        ColorLoopTraceExact
          ({ source with moves := simpleRoot ::ₘ source.moves } : Presentation).field
      rw [field_lower]
  | gauge frameChange =>
      change apply (.gauge frameChange) source = some result at happlies
      simp only [apply, Option.some.injEq] at happlies
      subst result
      change ColorLoopTraceExact source.field ↔
        ColorLoopTraceExact
          ({ source with
              gaugeFrame := frameChange * source.gaugeFrame } : Presentation).field
      rw [field_gauge]
      exact (colorLoopTraceExact_gaugeInvariant
        frameChange source.field).symm

theorem traceExact_standingInvariant :
    StandingInvariant
      (generatedStandingIdentity operations.toNativeStandingOperations)
      (fun presentation => ColorLoopTraceExact presentation.field) :=
  (standingInvariant_generatedStandingIdentity_iff_nativeMoveInvariant
    operations.toNativeStandingOperations _).mpr
      traceExact_nativeMoveInvariant

theorem sourceReachable_standingInvariant :
    StandingInvariant
      (generatedStandingIdentity operations.toNativeStandingOperations)
      Presentation.sourceReachable := by
  apply
    (standingInvariant_generatedStandingIdentity_iff_nativeMoveInvariant
      operations.toNativeStandingOperations _).mpr
  intro move source result happlies
  exact iff_of_true
    (everyState_reachable source.rootLabel source.moves source.moves)
    (everyState_reachable result.rootLabel result.moves result.moves)

theorem sourceConfluent_standingInvariant :
    StandingInvariant
      (generatedStandingIdentity operations.toNativeStandingOperations)
      Presentation.sourceConfluent := by
  apply
    (standingInvariant_generatedStandingIdentity_iff_nativeMoveInvariant
      operations.toNativeStandingOperations _).mpr
  intro move source result happlies
  exact iff_of_true
    (graphConfluent source.rootLabel source.moves)
    (graphConfluent result.rootLabel result.moves)

theorem exists_nontrivial_source_move (presentation : Presentation) :
    ∃ result : Presentation,
      operations.apply (.lower 0) presentation = some result := by
  exact ⟨{ presentation with moves := (0 : StableRootIndex) ::ₘ presentation.moves },
    rfl⟩

end
end SU7A6GaugeStableRootGraphAdapter
end PhysicsCore
end SaturationMonoid
