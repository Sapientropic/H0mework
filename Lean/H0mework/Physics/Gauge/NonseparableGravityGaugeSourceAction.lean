import H0mework.Physics.Gauge.DynamicTetradGaugeGeometry
import H0mework.Physics.Source.UnifiedPhysicalMasterAction

/-!
# Nonseparable gravity--gauge source action

The Stage-4 action merely added a gravity density to three gauge densities
whose Hodge operators were fixed.  This module replaces that separable gauge
term by one whose volume, Hodge, and constitutive defect are generated from
the live gravity tetrad.

For one sector the density is

`vol(e) [<B, ⋆ₑF> + (g²/2)<B,B>]
  + <F - g²⋆ₑB, λ>`.

Consequently changing `e` changes the gauge action even with all gauge fields
held fixed.  Curvature, auxiliary field, constitutive multiplier, and tetrad
stress are all defined by actual Mathlib Fréchet derivatives.

Boundary: the dynamic Hodge is currently the exact time-axis diagonal coframe
subfamily from `DynamicTetradGaugeGeometry`, not the final arbitrary-coframe
formula.  This file is therefore Stage-5 progress, not completion of the full
goal.
-/

namespace SaturationMonoid.PhysicsCore.NonseparableGravityGaugeSourceAction

open ProofFreeRicherAnholonomicSource
open PhysicalIIPlusFrechetVariation
open JetLocalPhysicalPlebanskiAction
open SourceRelativePhysicalStationaryFamily
open SourceGeneratedPhysicalPlebanskiConfiguration
open EmpiricalReferenceScaleCouplingBoundary
open UnifiedPhysicalMasterAction
open DynamicTetradGaugeGeometry

noncomputable section

abbrev DynamicGaugeVector :=
  DynamicTetradGaugeGeometry.GaugeTwoFormVector

/-- Replace only the curvature coordinate of a live gauge sector. -/
def withGaugeCurvature
    (q : GaugeSectorConfiguration) (curvature : DynamicGaugeVector) :
    GaugeSectorConfiguration :=
  { q with curvature := curvature }

/-- Replace only the auxiliary two-form coordinate of a live gauge sector. -/
def withGaugeAuxiliary
    (q : GaugeSectorConfiguration) (auxiliary : DynamicGaugeVector) :
    GaugeSectorConfiguration :=
  { q with auxiliary := auxiliary }

def dynamicGaugeConstitutiveOperator
    (source : Source) (tetrad : TetradVector)
    (couplingSquared : ℝˣ) :
    DynamicGaugeVector ≃ₗ[ℝ] DynamicGaugeVector :=
  hodgeConstitutiveOperator (dynamicGaugeHodgeEquiv source tetrad)
    couplingSquared

@[simp] theorem dynamicGaugeConstitutiveOperator_apply
    (source : Source) (tetrad : TetradVector)
    (couplingSquared : ℝˣ) (bivector : DynamicGaugeVector) :
    dynamicGaugeConstitutiveOperator source tetrad couplingSquared bivector =
      (couplingSquared : ℝ) •
        dynamicGaugeHodgeCLM source tetrad bivector := by
  rfl

/-- Smooth composition rule for the tetrad-generated constitutive operator. -/
@[fun_prop] theorem dynamicGaugeConstitutiveOperator_comp_contDiff
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (source : Source) (couplingSquared : ℝˣ)
    {tetrad : E → TetradVector} {bivector : E → DynamicGaugeVector}
    (htetrad : ContDiff ℝ ⊤ tetrad)
    (hbivector : ContDiff ℝ ⊤ bivector) :
    ContDiff ℝ ⊤
      (fun x =>
        dynamicGaugeConstitutiveOperator source (tetrad x)
          couplingSquared (bivector x)) := by
  simpa only [dynamicGaugeConstitutiveOperator_apply] using
    (dynamicGaugeHodge_comp_contDiff source htetrad hbivector).const_smul
      (couplingSquared : ℝ)

def dynamicGaugeConstitutiveDefect
    (source : Source) (tetrad : TetradVector)
    (couplingSquared : ℝˣ) (q : GaugeSectorConfiguration) :
    DynamicGaugeVector :=
  q.curvature -
    dynamicGaugeConstitutiveOperator source tetrad couplingSquared q.auxiliary

/-- A finite gauge curvature background projected from the source-generated
Lorentz curvature.  This is a concrete source readout, not a supplied gauge
field or a stored stationarity certificate. -/
def sourceGaugeCurvature (source : Source) : DynamicGaugeVector :=
  fun spacetimePair => sourceCurvatureVector source (0, spacetimePair)

/-- The source gauge auxiliary field is generated by actual constitutive
inversion at the exact source tetrad. -/
def sourceGaugeAuxiliary
    (source : Source) (couplingSquared : ℝˣ) : DynamicGaugeVector :=
  (dynamicGaugeConstitutiveOperator source (tetradVectorAtOrigin source)
    couplingSquared).symm (sourceGaugeCurvature source)

def sourceGaugeSectorConfiguration
    (source : Source) (couplingSquared : ℝˣ) : GaugeSectorConfiguration where
  curvature := sourceGaugeCurvature source
  auxiliary := sourceGaugeAuxiliary source couplingSquared
  constitutiveMultiplier := 0

def sourceRelativeGaugeCurvature
    (source : Source) (q : GaugeSectorConfiguration) : DynamicGaugeVector :=
  q.curvature - sourceGaugeCurvature source

def sourceRelativeGaugeAuxiliary
    (source : Source) (couplingSquared : ℝˣ)
    (q : GaugeSectorConfiguration) : DynamicGaugeVector :=
  q.auxiliary - sourceGaugeAuxiliary source couplingSquared

@[simp] theorem sourceGaugeSector_constitutiveDefect_at_sourceTetrad
    (source : Source) (couplingSquared : ℝˣ) :
    dynamicGaugeConstitutiveDefect source (tetradVectorAtOrigin source)
      couplingSquared (sourceGaugeSectorConfiguration source couplingSquared) =
      0 := by
  simp [dynamicGaugeConstitutiveDefect, sourceGaugeSectorConfiguration,
    sourceGaugeAuxiliary]

@[simp] theorem sourceRelativeGaugeCurvature_at_source
    (source : Source) (couplingSquared : ℝˣ) :
    sourceRelativeGaugeCurvature source
      (sourceGaugeSectorConfiguration source couplingSquared) = 0 := by
  simp [sourceRelativeGaugeCurvature, sourceGaugeSectorConfiguration]

@[simp] theorem sourceRelativeGaugeAuxiliary_at_source
    (source : Source) (couplingSquared : ℝˣ) :
    sourceRelativeGaugeAuxiliary source couplingSquared
      (sourceGaugeSectorConfiguration source couplingSquared) = 0 := by
  simp [sourceRelativeGaugeAuxiliary, sourceGaugeSectorConfiguration]

/-- One genuinely tetrad-dependent source-relative gauge-sector action.

The kinetic/BF density governs fluctuations around independently generated
`Fₛ` and `Bₛ`.  The multiplier term deliberately remains the absolute defect
`F-KₑB`; therefore constitutive elimination is not weakened to a shifted
identity. -/
def dynamicGaugeSectorAction
    (source : Source) (tetrad : TetradVector)
    (couplingSquared : ℝˣ) (q : GaugeSectorConfiguration) : ℝ :=
  dynamicGaugeVolume source tetrad *
      (gaugePairing (sourceRelativeGaugeAuxiliary source couplingSquared q)
          (dynamicGaugeHodgeCLM source tetrad
            (sourceRelativeGaugeCurvature source q)) +
        ((couplingSquared : ℝ) / 2) *
          gaugePairing
            (sourceRelativeGaugeAuxiliary source couplingSquared q)
            (sourceRelativeGaugeAuxiliary source couplingSquared q)) +
    gaugePairing
      (dynamicGaugeConstitutiveDefect source tetrad couplingSquared q)
      q.constitutiveMultiplier

theorem gaugePairing_joint_contDiff :
    ContDiff ℝ ⊤
      (fun pair : DynamicGaugeVector × DynamicGaugeVector =>
        gaugePairing pair.1 pair.2) := by
  unfold gaugePairing
  apply ContDiff.sum
  intro index _
  fun_prop

theorem dynamicGaugeSectorAction_curvature_contDiff
    (source : Source) (tetrad : TetradVector)
    (couplingSquared : ℝˣ) (q : GaugeSectorConfiguration) :
    ContDiff ℝ ⊤
      (fun curvature : DynamicGaugeVector =>
        dynamicGaugeSectorAction source tetrad couplingSquared
          (withGaugeCurvature q curvature)) := by
  unfold dynamicGaugeSectorAction dynamicGaugeConstitutiveDefect
    sourceRelativeGaugeCurvature sourceRelativeGaugeAuxiliary gaugePairing
  fun_prop

theorem dynamicGaugeSectorAction_auxiliary_contDiff
    (source : Source) (tetrad : TetradVector)
    (couplingSquared : ℝˣ) (q : GaugeSectorConfiguration) :
    ContDiff ℝ ⊤
      (fun auxiliary : DynamicGaugeVector =>
        dynamicGaugeSectorAction source tetrad couplingSquared
          (withGaugeAuxiliary q auxiliary)) := by
  unfold dynamicGaugeSectorAction dynamicGaugeConstitutiveDefect
    sourceRelativeGaugeCurvature sourceRelativeGaugeAuxiliary gaugePairing
  fun_prop

theorem dynamicGaugeSectorAction_multiplier_contDiff
    (source : Source) (tetrad : TetradVector)
    (couplingSquared : ℝˣ) (q : GaugeSectorConfiguration) :
    ContDiff ℝ ⊤
      (fun multiplier : DynamicGaugeVector =>
        dynamicGaugeSectorAction source tetrad couplingSquared
          (q.withConstitutiveMultiplier multiplier)) := by
  unfold dynamicGaugeSectorAction dynamicGaugeConstitutiveDefect
    sourceRelativeGaugeCurvature sourceRelativeGaugeAuxiliary gaugePairing
  fun_prop

theorem dynamicGaugeSectorAction_tetrad_contDiff
    (source : Source) (couplingSquared : ℝˣ)
    (q : GaugeSectorConfiguration) :
    ContDiff ℝ ⊤
      (fun tetrad : TetradVector =>
        dynamicGaugeSectorAction source tetrad couplingSquared q) := by
  unfold dynamicGaugeSectorAction dynamicGaugeConstitutiveDefect
    sourceRelativeGaugeCurvature sourceRelativeGaugeAuxiliary gaugePairing
  fun_prop

def dynamicGaugeDeltaCurvature
    (source : Source) (tetrad : TetradVector)
    (couplingSquared : ℝˣ) (q : GaugeSectorConfiguration) :
    GaugeCovector :=
  fderiv ℝ
    (fun curvature : DynamicGaugeVector =>
      dynamicGaugeSectorAction source tetrad couplingSquared
        (withGaugeCurvature q curvature)) q.curvature

def dynamicGaugeDeltaAuxiliary
    (source : Source) (tetrad : TetradVector)
    (couplingSquared : ℝˣ) (q : GaugeSectorConfiguration) :
    GaugeCovector :=
  fderiv ℝ
    (fun auxiliary : DynamicGaugeVector =>
      dynamicGaugeSectorAction source tetrad couplingSquared
        (withGaugeAuxiliary q auxiliary)) q.auxiliary

def dynamicGaugeDeltaMultiplier
    (source : Source) (tetrad : TetradVector)
    (couplingSquared : ℝˣ) (q : GaugeSectorConfiguration) :
    GaugeCovector :=
  fderiv ℝ
    (fun multiplier : DynamicGaugeVector =>
      dynamicGaugeSectorAction source tetrad couplingSquared
        (q.withConstitutiveMultiplier multiplier))
    q.constitutiveMultiplier

/-- Gauge contribution to the gravity-tetrad equation. -/
def dynamicGaugeStressCovector
    (source : Source) (tetrad : TetradVector)
    (couplingSquared : ℝˣ) (q : GaugeSectorConfiguration) :
    TetradVector →L[ℝ] ℝ :=
  fderiv ℝ
    (fun liveTetrad : TetradVector =>
      dynamicGaugeSectorAction source liveTetrad couplingSquared q) tetrad

theorem actual_dynamicGauge_curvature_derivative
    (source : Source) (tetrad : TetradVector)
    (couplingSquared : ℝˣ) (q : GaugeSectorConfiguration) :
    HasFDerivAt
      (fun curvature : DynamicGaugeVector =>
        dynamicGaugeSectorAction source tetrad couplingSquared
          (withGaugeCurvature q curvature))
      (dynamicGaugeDeltaCurvature source tetrad couplingSquared q)
      q.curvature :=
  ((dynamicGaugeSectorAction_curvature_contDiff
    source tetrad couplingSquared q).differentiable (by simp))
      |>.differentiableAt.hasFDerivAt

theorem actual_dynamicGauge_auxiliary_derivative
    (source : Source) (tetrad : TetradVector)
    (couplingSquared : ℝˣ) (q : GaugeSectorConfiguration) :
    HasFDerivAt
      (fun auxiliary : DynamicGaugeVector =>
        dynamicGaugeSectorAction source tetrad couplingSquared
          (withGaugeAuxiliary q auxiliary))
      (dynamicGaugeDeltaAuxiliary source tetrad couplingSquared q)
      q.auxiliary :=
  ((dynamicGaugeSectorAction_auxiliary_contDiff
    source tetrad couplingSquared q).differentiable (by simp))
      |>.differentiableAt.hasFDerivAt

theorem actual_dynamicGauge_multiplier_derivative
    (source : Source) (tetrad : TetradVector)
    (couplingSquared : ℝˣ) (q : GaugeSectorConfiguration) :
    HasFDerivAt
      (fun multiplier : DynamicGaugeVector =>
        dynamicGaugeSectorAction source tetrad couplingSquared
          (q.withConstitutiveMultiplier multiplier))
      (dynamicGaugeDeltaMultiplier source tetrad couplingSquared q)
      q.constitutiveMultiplier :=
  ((dynamicGaugeSectorAction_multiplier_contDiff
    source tetrad couplingSquared q).differentiable (by simp))
      |>.differentiableAt.hasFDerivAt

theorem actual_dynamicGauge_tetrad_derivative
    (source : Source) (tetrad : TetradVector)
    (couplingSquared : ℝˣ) (q : GaugeSectorConfiguration) :
    HasFDerivAt
      (fun liveTetrad : TetradVector =>
        dynamicGaugeSectorAction source liveTetrad couplingSquared q)
      (dynamicGaugeStressCovector source tetrad couplingSquared q) tetrad :=
  ((dynamicGaugeSectorAction_tetrad_contDiff source couplingSquared q)
    |>.differentiable (by simp)).differentiableAt.hasFDerivAt

theorem all_dynamicGauge_variations_from_one_sectorAction
    (source : Source) (tetrad : TetradVector)
    (couplingSquared : ℝˣ) (q : GaugeSectorConfiguration) :
    HasFDerivAt
        (fun curvature : DynamicGaugeVector =>
          dynamicGaugeSectorAction source tetrad couplingSquared
            (withGaugeCurvature q curvature))
        (dynamicGaugeDeltaCurvature source tetrad couplingSquared q)
        q.curvature ∧
      HasFDerivAt
        (fun auxiliary : DynamicGaugeVector =>
          dynamicGaugeSectorAction source tetrad couplingSquared
            (withGaugeAuxiliary q auxiliary))
        (dynamicGaugeDeltaAuxiliary source tetrad couplingSquared q)
        q.auxiliary ∧
      HasFDerivAt
        (fun multiplier : DynamicGaugeVector =>
          dynamicGaugeSectorAction source tetrad couplingSquared
            (q.withConstitutiveMultiplier multiplier))
        (dynamicGaugeDeltaMultiplier source tetrad couplingSquared q)
        q.constitutiveMultiplier ∧
      HasFDerivAt
        (fun liveTetrad : TetradVector =>
          dynamicGaugeSectorAction source liveTetrad couplingSquared q)
        (dynamicGaugeStressCovector source tetrad couplingSquared q)
        tetrad :=
  ⟨actual_dynamicGauge_curvature_derivative source tetrad couplingSquared q,
    actual_dynamicGauge_auxiliary_derivative source tetrad couplingSquared q,
    actual_dynamicGauge_multiplier_derivative source tetrad couplingSquared q,
    actual_dynamicGauge_tetrad_derivative source tetrad couplingSquared q⟩

/-- A nonzero curvature component whose dynamic Hodge lands in component zero.
It is fixed data for a semantic nonseparability regression, not a stored field
equation or a stationary certificate. -/
def gaugeStressProbeCurvature : DynamicGaugeVector :=
  fun index => if index = 3 then 1 else 0

/-- The paired nonzero auxiliary component for the stress probe. -/
def gaugeStressProbeAuxiliary : DynamicGaugeVector :=
  fun index => if index = 0 then 1 else 0

/-- A concrete live gauge sector used to prove that tetrad variation is not
merely present as a formal derivative: both `F` and `B` are nonzero. -/
def gaugeStressProbeConfiguration (source : Source) : GaugeSectorConfiguration where
  curvature := sourceGaugeCurvature source + gaugeStressProbeCurvature
  auxiliary := sourceGaugeAuxiliary source (1 : ℝˣ) +
    gaugeStressProbeAuxiliary
  constitutiveMultiplier := 0

/-- For the concrete unit-coupling probe, the complete sector action reduces
to `ρ(e) (ρ(e) + 1/2)`.  Both factors use the same generated coframe scale. -/
theorem gaugeStressProbe_action_formula
    (source : Source) (tetrad : TetradVector) :
    dynamicGaugeSectorAction source tetrad (1 : ℝˣ)
        (gaugeStressProbeConfiguration source) =
      dynamicGaugeScale source tetrad *
        (dynamicGaugeScale source tetrad + (1 / 2 : ℝ)) := by
  simp [dynamicGaugeSectorAction, dynamicGaugeConstitutiveDefect,
    dynamicGaugeVolume, gaugeStressProbeConfiguration,
    sourceRelativeGaugeCurvature, sourceRelativeGaugeAuxiliary,
    gaugeStressProbeCurvature, gaugeStressProbeAuxiliary,
    gaugePairing, dynamicGaugeHodgeCLM, dynamicGaugeHodgeLinear]

theorem gaugeStressProbe_action_at_source (source : Source) :
    dynamicGaugeSectorAction source (tetradVectorAtOrigin source) (1 : ℝˣ)
        (gaugeStressProbeConfiguration source) = (3 / 2 : ℝ) := by
  rw [gaugeStressProbe_action_formula, dynamicGaugeScale_at_source]
  norm_num

theorem gaugeStressProbe_action_at_timeModeProbe (source : Source) :
    dynamicGaugeSectorAction source (timeModeProbe source) (1 : ℝˣ)
        (gaugeStressProbeConfiguration source) = (21 / 2 : ℝ) := by
  rw [gaugeStressProbe_action_formula]
  have hscale : dynamicGaugeScale source (timeModeProbe source) = 3 := by
    simpa [dynamicGaugeVolume] using timeModeProbe_volume source
  rw [hscale]
  norm_num

/-- A fixed gauge configuration therefore makes the action genuinely depend
on the live gravity tetrad. -/
theorem dynamicGaugeSectorAction_not_tetrad_constant (source : Source) :
    dynamicGaugeSectorAction source (timeModeProbe source) (1 : ℝˣ)
        (gaugeStressProbeConfiguration source) ≠
      dynamicGaugeSectorAction source (tetradVectorAtOrigin source) (1 : ℝˣ)
        (gaugeStressProbeConfiguration source) := by
  rw [gaugeStressProbe_action_at_timeModeProbe,
    gaugeStressProbe_action_at_source]
  norm_num

/-- Unit live-tetrad displacement in the source-selected time-axis mode. -/
def tetradTimeModeDirection : TetradVector :=
  EuclideanSpace.basisFun (LorentzianIndex × LorentzianIndex) ℝ (0, 0)

/-- The continuous coordinate covector dual to `tetradTimeModeDirection`. -/
def tetradTimeModeCovector : TetradVector →L[ℝ] ℝ :=
  EuclideanSpace.proj (𝕜 := ℝ) (0, 0)

theorem tetradGaugeMode_hasFDerivAt_source (source : Source) :
    HasFDerivAt (tetradGaugeMode source) tetradTimeModeCovector
      (tetradVectorAtOrigin source) := by
  change HasFDerivAt
    (fun tetrad : TetradVector =>
      tetradTimeModeCovector tetrad -
        tetradTimeModeCovector (tetradVectorAtOrigin source))
    tetradTimeModeCovector (tetradVectorAtOrigin source)
  exact (tetradTimeModeCovector.hasFDerivAt
    (x := tetradVectorAtOrigin source)).sub_const
      (tetradTimeModeCovector (tetradVectorAtOrigin source))

theorem dynamicGaugeScale_hasFDerivAt_source (source : Source) :
    HasFDerivAt (dynamicGaugeScale source) tetradTimeModeCovector
      (tetradVectorAtOrigin source) := by
  have hmode := tetradGaugeMode_hasFDerivAt_source source
  change HasFDerivAt
    (fun tetrad : TetradVector =>
      tetradGaugeMode source tetrad ^ 2 +
        tetradGaugeMode source tetrad + 1)
    tetradTimeModeCovector (tetradVectorAtOrigin source)
  exact (((hmode.pow 2).add hmode).add_const (1 : ℝ)).congr_fderiv <| by
    simp [tetradGaugeMode_at_source]

/-- The machine-computed gauge stress evaluates to `5/2` on the source time
mode.  This is stronger than merely proving that the action is nonconstant. -/
theorem gaugeStressProbe_covector_apply_timeMode (source : Source) :
    dynamicGaugeStressCovector source (tetradVectorAtOrigin source) (1 : ℝˣ)
        (gaugeStressProbeConfiguration source) tetradTimeModeDirection =
      (5 / 2 : ℝ) := by
  have hscale := dynamicGaugeScale_hasFDerivAt_source source
  have hproduct :
      HasFDerivAt
        (dynamicGaugeScale source *
          fun tetrad : TetradVector =>
            dynamicGaugeScale source tetrad + (1 / 2 : ℝ))
        (dynamicGaugeScale source (tetradVectorAtOrigin source) •
            tetradTimeModeCovector +
          (dynamicGaugeScale source (tetradVectorAtOrigin source) +
              (1 / 2 : ℝ)) •
            tetradTimeModeCovector)
        (tetradVectorAtOrigin source) :=
    hscale.mul (hscale.add_const (1 / 2 : ℝ))
  have haction :
      HasFDerivAt
        (fun tetrad : TetradVector =>
          dynamicGaugeSectorAction source tetrad (1 : ℝˣ)
            (gaugeStressProbeConfiguration source))
        (dynamicGaugeScale source (tetradVectorAtOrigin source) •
            tetradTimeModeCovector +
          (dynamicGaugeScale source (tetradVectorAtOrigin source) +
              (1 / 2 : ℝ)) •
            tetradTimeModeCovector)
        (tetradVectorAtOrigin source) := by
    apply hproduct.congr_of_eventuallyEq
    filter_upwards [] with tetrad
    simpa only [Pi.mul_apply] using
      gaugeStressProbe_action_formula source tetrad
  have hequal :=
    (actual_dynamicGauge_tetrad_derivative source
      (tetradVectorAtOrigin source) (1 : ℝˣ)
        (gaugeStressProbeConfiguration source)).unique haction
  rw [hequal]
  norm_num [dynamicGaugeScale_at_source,
    tetradTimeModeCovector, tetradTimeModeDirection,
    EuclideanSpace.basisFun_apply]

/-- The gauge contribution to the tetrad equation is a genuinely nonzero
continuous covector at the source configuration. -/
theorem gaugeStressProbe_covector_ne_zero (source : Source) :
    dynamicGaugeStressCovector source (tetradVectorAtOrigin source) (1 : ℝˣ)
        (gaugeStressProbeConfiguration source) ≠ 0 := by
  intro hzero
  have hvalue := congrArg
    (fun covector : TetradVector →L[ℝ] ℝ =>
      covector tetradTimeModeDirection) hzero
  rw [gaugeStressProbe_covector_apply_timeMode] at hvalue
  norm_num at hvalue

def dynamicStandardModelGaugeAction
    (source : Source) (tetrad : TetradVector)
    (boundary : EmpiricalReferenceScaleCouplings)
    (q : StandardModelGaugeConfiguration) : ℝ :=
  dynamicGaugeSectorAction source tetrad
      boundary.strongCouplingSquared q.strong +
    dynamicGaugeSectorAction source tetrad
      boundary.weakCouplingSquared q.weak +
    dynamicGaugeSectorAction source tetrad
      boundary.hyperchargeCouplingSquared q.hypercharge

/-- Stage-5 master action.  The gauge term consumes the live gravity tetrad,
so this is not definitionally a sum over disjoint coordinate blocks. -/
def nonseparableMasterAction
    (source : Source) (boundary : EmpiricalReferenceScaleCouplings)
    (q : UnifiedConfiguration) : ℝ :=
  sourceRelativeMasterAction source q.gravity +
    dynamicStandardModelGaugeAction source q.gravity.tetrad boundary q.gauge

def nonseparableDeltaTetrad
    (source : Source) (boundary : EmpiricalReferenceScaleCouplings)
    (q : UnifiedConfiguration) : TetradVector →L[ℝ] ℝ :=
  fderiv ℝ
    (fun tetrad : TetradVector =>
      nonseparableMasterAction source boundary
        (q.withGravityTetrad tetrad)) q.gravity.tetrad

end
end SaturationMonoid.PhysicsCore.NonseparableGravityGaugeSourceAction
