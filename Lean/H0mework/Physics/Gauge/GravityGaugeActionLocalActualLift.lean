import H0mework.Physics.GaugeAction.P286ActionVelocityLocalActualLift
import H0mework.Physics.GravitySource.NormalizedAffineConnectionGerm

/-!
# S9-C3h93: synchronized gravity--gauge action local actual lift

C3h92 generated an actual P286 connection first jet from the auxiliary
action.  This module adds the gravity algebraic action system without
consulting a residual:

* the Plebanski multiplier equation generates `B = II⁺(e)`;
* the gravity auxiliary equation generates `Fω = ⋆ᵢ B`;
* the existing normalized affine Lorentz construction realizes that
  action-owned curvature as an actual primitive connection germ;
* the C3h92 P286 connection realizes all six components of
  `FA = gₛ² *ₑ BA`.

Thus source/Cauchy data and the actual action first produce one common
primitive local configuration; the three equation equalities are downstream
acceptance theorems about that output.  No residual, endpoint, inverse image,
quotient representative, shell witness, or stationarity receipt occurs in
the constructor.

This remains an origin first-jet result.  It is not a finite-time integral
curve, does not yet solve the two connection momentum equations, and does not
claim a full gravity--gauge--matter stationary germ.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineGravityGaugeActionLocalActualLift

open ProofFreeRicherAnholonomicSource
open StageNineCanonicalCauchyState
open StageNineBlockwiseConstitutive
open StageNineEnrichedProofFreeSource
open StageNineGlobalIntegratedAction
open StageNineGravityAuxiliaryVariation
open StageNineHolonomicField
open StageNineP286ActionCauchySplit
open StageNineP286ActionConnectionVelocity
open StageNineP286ActionVelocityLocalActualLift
open StageNineP286GaugeAuxiliaryVariation
open StageNinePlebanskiMultiplierVariation
open StageNinePositiveSourceGravityMouthNormalizedAffineConnectionGerm
open StageNineSourceGeneratedHolonomicPhaseEvolution
open scoped ContDiff

noncomputable section

set_option autoImplicit false

/-! ## Action-generated gravity data -/

/-- The gravity auxiliary selected by the actual multiplier equation. -/
def actionGeneratedGravityAuxiliary
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) : PhysicalBivector :=
  physicalIIPlusBivector (state.coframe space)

/-- The Lorentz curvature selected by the actual gravity auxiliary equation
after the multiplier equation has generated the II+ branch. -/
def actionGeneratedGravityCurvature
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) : PhysicalBivector :=
  gravityInternalDualEquiv
    (actionGeneratedGravityAuxiliary state space)

/-! ## Common primitive actual lift -/

/-- Common gravity--gauge local actual lift.

The P286 and scalar fields come from C3h92.  The gravity auxiliary and
connection are replaced by the outputs generated by the two gravity
algebraic action equations.  The normalized affine Lorentz half split is
fixed by antisymmetrization; it is not a source coefficient or branch
parameter. -/
def sourceActionGeneratedGravityGaugeLocalActualLift
    (source : SmoothUnifiedSource)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    StageNineHolonomicConfiguration :=
  let gaugeLift :=
    sourceGeneratedP286ActionLocalActualLift source state space
  { gaugeLift with
    gravityConnection :=
      normalizedAffineLorentzConnectionField
        (state.gravityConnection space)
        (actionGeneratedGravityCurvature state space)
    gravityAuxiliary :=
      fun _ => actionGeneratedGravityAuxiliary state space }

@[simp] theorem sourceActionGeneratedGravityGaugeLocalActualLift_coframe
    (source : SmoothUnifiedSource)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    (sourceActionGeneratedGravityGaugeLocalActualLift source state
      space).coframe =
        fun _ => state.coframe space :=
  rfl

@[simp] theorem sourceActionGeneratedGravityGaugeLocalActualLift_gravityAuxiliary
    (source : SmoothUnifiedSource)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    (sourceActionGeneratedGravityGaugeLocalActualLift source state
      space).gravityAuxiliary =
        fun _ => actionGeneratedGravityAuxiliary state space :=
  rfl

@[simp] theorem sourceActionGeneratedGravityGaugeLocalActualLift_gravityConnection_origin
    (source : SmoothUnifiedSource)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    (sourceActionGeneratedGravityGaugeLocalActualLift source state
      space).gravityConnection 0 =
      state.gravityConnection space := by
  exact normalizedAffineLorentzConnectionField_zero
    (state.gravityConnection space)
    (actionGeneratedGravityCurvature state space)

theorem sourceActionGeneratedGravityGaugeLocalActualLift_smooth
    (source : SmoothUnifiedSource)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    (sourceActionGeneratedGravityGaugeLocalActualLift source state
      space).Smooth := by
  have gaugeSmooth :=
    sourceGeneratedP286ActionLocalActualLift_smooth source state space
  rcases gaugeSmooth with
    ⟨coframeSmooth, _gravityConnectionSmooth, _gravityAuxiliarySmooth,
      multiplierSmooth, gaugeConnectionSmooth, gaugeAuxiliarySmooth,
      scalarSmooth, matterSmooth, conjugateMatterSmooth⟩
  refine ⟨coframeSmooth, ?_, ?_, multiplierSmooth, gaugeConnectionSmooth,
    gaugeAuxiliarySmooth, scalarSmooth, matterSmooth,
    conjugateMatterSmooth⟩
  · exact normalizedAffineLorentzConnectionField_smooth
      (state.gravityConnection space)
      (actionGeneratedGravityCurvature state space)
  · intro internalPair spacetimePair
    exact (contDiff_const :
      ContDiff ℝ ∞ (fun _ : BasePoint =>
        actionGeneratedGravityAuxiliary state space
          internalPair spacetimePair))

theorem sourceActionGeneratedGravityGaugeLocalActualLift_nondegenerate
    (source : SmoothUnifiedSource)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (nondegenerate : Matrix.det (state.coframe space) ≠ 0) :
    (sourceActionGeneratedGravityGaugeLocalActualLift source state
      space).Nondegenerate := by
  intro _
  exact nondegenerate

/-! ## Actual action-system acceptance -/

/-- The multiplier equation is realized by the generated gravity auxiliary
at the common local origin. -/
theorem sourceActionGeneratedGravityGaugeLocalActualLift_simplicity_origin
    (source : SmoothUnifiedSource)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    (sourceActionGeneratedGravityGaugeLocalActualLift source state
      space).gravityAuxiliary 0 =
      physicalIIPlusBivector
        ((sourceActionGeneratedGravityGaugeLocalActualLift source state
          space).coframe 0) :=
  rfl

/-- The actual primitive Lorentz connection realizes the curvature selected
by the two gravity algebraic action equations. -/
theorem sourceActionGeneratedGravityGaugeLocalActualLift_gravityCurvature_origin
    (source : SmoothUnifiedSource)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    holonomicGravityCurvature
        (sourceActionGeneratedGravityGaugeLocalActualLift source state space)
        0 =
      actionGeneratedGravityCurvature state space := by
  change
    holonomicGravityCurvature
        (normalizedAffineConfiguration
          (state.gravityConnection space)
          (actionGeneratedGravityCurvature state space))
        0 =
      actionGeneratedGravityCurvature state space
  exact holonomicGravityCurvature_normalizedAffineConfiguration_zero
    (state.gravityConnection space)
    (actionGeneratedGravityCurvature state space)

/-- Downstream gravity-auxiliary action equality at the generated origin. -/
theorem sourceActionGeneratedGravityGaugeLocalActualLift_gravityAuxiliaryEquation_origin
    (source : SmoothUnifiedSource)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    holonomicGravityCurvature
        (sourceActionGeneratedGravityGaugeLocalActualLift source state space)
        0 =
      gravityInternalDualEquiv
        ((sourceActionGeneratedGravityGaugeLocalActualLift source state
          space).gravityAuxiliary 0) := by
  rw [
    sourceActionGeneratedGravityGaugeLocalActualLift_gravityCurvature_origin]
  rfl

/-- The same primitive local configuration retains the full six-component
P286 auxiliary equation generated in C3h92. -/
theorem sourceActionGeneratedGravityGaugeLocalActualLift_p286AuxiliaryEquation_origin
    (source : SmoothUnifiedSource)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    holonomicGaugeCurvature
        (sourceActionGeneratedGravityGaugeLocalActualLift source state space)
        0 =
      liftGaugeTwoFormOperator
        (((sourceGeneratedUnifiedCouplings source).strongCouplingSquared :
            ℝ) •
          coframeGaugeSpacetimeHodgeLinear
            ((sourceActionGeneratedGravityGaugeLocalActualLift source state
              space).coframe 0))
        ((sourceActionGeneratedGravityGaugeLocalActualLift source state
          space).gaugeAuxiliary 0) := by
  change
    holonomicGaugeCurvature
        (sourceGeneratedP286ActionLocalActualLift source state space)
        0 =
      liftGaugeTwoFormOperator
        (((sourceGeneratedUnifiedCouplings source).strongCouplingSquared :
            ℝ) •
          coframeGaugeSpacetimeHodgeLinear
            ((sourceGeneratedP286ActionLocalActualLift source state
              space).coframe 0))
        ((sourceGeneratedP286ActionLocalActualLift source state
          space).gaugeAuxiliary 0)
  exact
    sourceGeneratedP286ActionLocalActualLift_auxiliaryEquation_origin
      source state space

/-- The common lift also preserves the Cauchy scalar velocity already
realized by C3h92. -/
theorem sourceActionGeneratedGravityGaugeLocalActualLift_scalarVelocity_origin
    (source : SmoothUnifiedSource)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    fieldDirectionalDerivative
        (sourceActionGeneratedGravityGaugeLocalActualLift source state
          space).scalar
        0 canonicalLorentzianTimeDirection =
      state.scalarVelocity space := by
  simpa [sourceActionGeneratedGravityGaugeLocalActualLift] using
    sourceGeneratedP286ActionLocalActualLift_scalarVelocity_origin
      source state space

/-- One theorem exposes the three synchronized algebraic action equalities
on the same generated primitive configuration. -/
theorem sourceActionGeneratedGravityGaugeLocalActualLift_origin_system
    (source : SmoothUnifiedSource)
    (state : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    let actual :=
      sourceActionGeneratedGravityGaugeLocalActualLift source state space
    actual.gravityAuxiliary 0 =
        physicalIIPlusBivector (actual.coframe 0) ∧
      holonomicGravityCurvature actual 0 =
        gravityInternalDualEquiv (actual.gravityAuxiliary 0) ∧
      holonomicGaugeCurvature actual 0 =
        liftGaugeTwoFormOperator
          (((sourceGeneratedUnifiedCouplings source).strongCouplingSquared :
              ℝ) •
            coframeGaugeSpacetimeHodgeLinear (actual.coframe 0))
          (actual.gaugeAuxiliary 0) := by
  exact
    ⟨sourceActionGeneratedGravityGaugeLocalActualLift_simplicity_origin
        source state space,
      sourceActionGeneratedGravityGaugeLocalActualLift_gravityAuxiliaryEquation_origin
        source state space,
      sourceActionGeneratedGravityGaugeLocalActualLift_p286AuxiliaryEquation_origin
        source state space⟩

/-! ## Positive and negative controls -/

/-- On the identity-coframe probe, the action-generated gravity curvature is
genuinely nonzero. -/
theorem positiveProbe_sourceActionGeneratedGravityGaugeLocalActualLift_gravityCurvature_ne_zero :
    holonomicGravityCurvature
        (sourceActionGeneratedGravityGaugeLocalActualLift
          positiveSmoothUnifiedSource positivePhaseProbeCauchyState 0)
        0 ≠ 0 := by
  rw [
    sourceActionGeneratedGravityGaugeLocalActualLift_gravityCurvature_origin]
  intro curvatureZero
  apply physicalIIPlusBivector_not_zero
  apply gravityInternalDualEquiv.injective
  simpa [actionGeneratedGravityCurvature,
    actionGeneratedGravityAuxiliary, positivePhaseProbeCauchyState,
    canonicalCauchyRestriction, positivePhaseProbeConfiguration] using
      curvatureZero

/-- The same probe has zero primitive P286 data, so no hidden gauge velocity
is introduced while the gravity output remains nontrivial. -/
theorem positiveProbe_sourceActionGeneratedGravityGaugeLocalActualLift_separates_gravity_from_zeroGauge :
    holonomicGravityCurvature
        (sourceActionGeneratedGravityGaugeLocalActualLift
          positiveSmoothUnifiedSource positivePhaseProbeCauchyState 0)
        0 ≠ 0 ∧
      sourceGeneratedP286SpatialConnectionVelocity
          positiveSmoothUnifiedSource positivePhaseProbeCauchyState =
        0 := by
  refine
    ⟨positiveProbe_sourceActionGeneratedGravityGaugeLocalActualLift_gravityCurvature_ne_zero,
      ?_⟩
  apply sourceGeneratedP286SpatialConnectionVelocity_eq_zero_of_gaugeData_zero
  · rfl
  · rfl

end

end
  SaturationMonoid.PhysicsCore.StageNineGravityGaugeActionLocalActualLift
