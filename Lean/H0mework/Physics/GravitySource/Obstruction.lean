import H0mework.Physics.Source.PositiveSourceJointShellReachability
import H0mework.Realization.Residual.Algebra
import Mathlib.LinearAlgebra.FiniteDimensional.Basic

/-!
# S9-C3g5: actual positive-source gravity-mouth obstruction

C3g4 rules out every completion of one explicit, nonempty carrier class:
the positive source's actual origin coframe and Lorentz curvature cannot be
placed on the current gravity algebraic shell by choosing the existing
auxiliary or multiplier.  This module records the residual generated by that
class-wide no-go.  It is the typed bivector

`F_source(0) - gravityInternalDual (II+(e_source(0)))`.

The residual is not a new field, source slot, coupling, branch selector, or
stationarity receipt.  Its zero fiber is exactly constitutive matching, and
the existing C3g4 mismatch proves that fiber is empty for the positive source.

The one-generator real span below is only the smallest *linear responsibility
submodule* containing this actual residual.  No Lorentz action on
`PhysicalBivector` has yet been supplied, so this file does not call that span
covariance-stable and does not identify it with a repair field.  The same
source's existing `sigma` instantiates the framework scalar keep on this
carrier, so `r' = K r`, the forced trace, and the active fixed/zero/trace/energy
equivalence are actual Layer-0/Layer-1 residual transport.  What remains open
is the later Layer-3 lift from that transport to a generated holonomic
configuration; the absence of that lift does not invalidate residual
transport itself.
-/

namespace SaturationMonoid.PhysicsCore.StageNinePositiveSourceGravityMouthObstruction

open AffineRelaxation
open ProofFreeRicherAnholonomicSource
open StageEightProofFreeSource
open StageNineEnrichedProofFreeSource
open StageNineBlockwiseConstitutive
open StageNineSimultaneousSourceContainment
open StageNinePositiveSourceJointShellReachability
open RepresentationArithmeticAtomProjectionDefect.BorromeanPreRealization

noncomputable section

set_option autoImplicit false

/-- The actual obstruction produced by the C3g4 positive-source gravity-mouth
no-go.  Both terms are read from the same fixed source mouth. -/
def positiveSourceGravityMouthObstruction : PhysicalBivector :=
  positiveSmoothUnifiedSource.legacy.lorentzCurvatureAtOrigin -
    gravityInternalDualEquiv
      (physicalIIPlusBivector
        (positiveSmoothUnifiedSource.legacy.coframeAt 0))

/-- The obstruction zero fiber contains no separately supplied shell or
equation receipt. -/
def PositiveSourceGravityMouthObstructionZeroFiber : Prop :=
  positiveSourceGravityMouthObstruction = 0

/-- A concrete coordinate witness for the mismatch. -/
@[simp] theorem positiveSourceGravityMouthObstruction_zero_zero :
    positiveSourceGravityMouthObstruction 0 0 = (5 / 4 : ℝ) := by
  change (canonicalPhysicalSource.lorentzCurvatureAtOrigin -
      gravityInternalDualEquiv
        (physicalIIPlusBivector (canonicalPhysicalSource.coframeAt 0)))
      0 0 = 5 / 4
  rw [canonicalPhysicalSource.coframeAt_zero]
  have sourceCurvature :
      canonicalPhysicalSource.lorentzCurvatureAtOrigin 0 0 =
        (1 / 4 : ℝ) := by
    simp [Source.lorentzCurvatureAtOrigin, pairFirst, pairSecond,
      minkowskiInternalSign, canonicalPhysicalSource_curvature_component]
  change canonicalPhysicalSource.lorentzCurvatureAtOrigin 0 0 -
      gravityInternalDualEquiv
        (physicalIIPlusBivector (1 : LorentzianCoframe)) 0 0 = 5 / 4
  rw [sourceCurvature]
  change (1 / 4 : ℝ) -
      gravityInternalDualLinear
        (gravityInternalDualLinear
          (coframeWedge (1 : LorentzianCoframe))) 0 0 = 5 / 4
  rw [gravityInternalDualLinear_square]
  norm_num [coframeWedge, pairFirst, pairSecond, Matrix.one_apply]

/-- Exact zero-fiber classification: vanishing is precisely equality of the
two generated gravity-mouth readouts. -/
theorem positiveSourceGravityMouthObstructionZeroFiber_iff_match :
    PositiveSourceGravityMouthObstructionZeroFiber ↔
      positiveSmoothUnifiedSource.legacy.lorentzCurvatureAtOrigin =
        gravityInternalDualEquiv
          (physicalIIPlusBivector
            (positiveSmoothUnifiedSource.legacy.coframeAt 0)) := by
  simp [PositiveSourceGravityMouthObstructionZeroFiber,
    positiveSourceGravityMouthObstruction, sub_eq_zero]

/-- The actual obstruction is nonzero.  This is the residual form of the
C3g4 carrier-class no-go, not a claim that the whole joint shell is empty. -/
theorem positiveSourceGravityMouthObstruction_ne_zero :
    positiveSourceGravityMouthObstruction ≠ 0 := by
  intro obstructionZero
  have mouthEquality :
      positiveSmoothUnifiedSource.legacy.lorentzCurvatureAtOrigin =
        gravityInternalDualEquiv
          (physicalIIPlusBivector
            (positiveSmoothUnifiedSource.legacy.coframeAt 0)) :=
    sub_eq_zero.mp obstructionZero
  exact canonicalPhysicalSource_origin_curvature_ne_gravityDualIIPlus
    (congrFun (congrFun mouthEquality 0) 0)

/-- Hence this one source mouth does not inhabit the obstruction zero fiber. -/
theorem positiveSourceGravityMouthObstructionZeroFiber_false :
    ¬ PositiveSourceGravityMouthObstructionZeroFiber :=
  positiveSourceGravityMouthObstruction_ne_zero

/-- The residual's ambient representation is the existing 36-dimensional
real `PhysicalBivector = Λ²_internal ⊗ Λ²_spacetime` coordinate carrier. -/
theorem physicalBivector_finrank :
    Module.finrank ℝ PhysicalBivector = 36 := by
  change Module.finrank ℝ (Matrix (Fin 6) (Fin 6) ℝ) = 36
  rw [Module.finrank_matrix]
  norm_num

/-- Smallest real-linear responsibility submodule containing the actual
obstruction.  Covariance closure is deliberately not asserted here. -/
def positiveSourceGravityMouthLinearResponsibilitySubmodule :
    Submodule ℝ PhysicalBivector :=
  Submodule.span ℝ {positiveSourceGravityMouthObstruction}

abbrev PositiveSourceGravityMouthLinearResponsibilityCarrier :=
  positiveSourceGravityMouthLinearResponsibilitySubmodule

theorem positiveSourceGravityMouthObstruction_mem_linearResponsibility :
    positiveSourceGravityMouthObstruction ∈
      positiveSourceGravityMouthLinearResponsibilitySubmodule :=
  Submodule.subset_span (by simp)

/-- Minimality is relative only to real submodules containing this residual;
it is not yet minimality among Lorentz-covariant carriers. -/
theorem positiveSourceGravityMouthLinearResponsibility_minimal
    (candidate : Submodule ℝ PhysicalBivector)
    (contains : positiveSourceGravityMouthObstruction ∈ candidate) :
    positiveSourceGravityMouthLinearResponsibilitySubmodule ≤ candidate := by
  apply Submodule.span_le.mpr
  simpa using contains

theorem positiveSourceGravityMouthLinearResponsibility_ne_bot :
    positiveSourceGravityMouthLinearResponsibilitySubmodule ≠ ⊥ := by
  intro responsibilityBottom
  have obstructionMem :=
    positiveSourceGravityMouthObstruction_mem_linearResponsibility
  rw [responsibilityBottom] at obstructionMem
  exact positiveSourceGravityMouthObstruction_ne_zero (by simpa using obstructionMem)

/-- The purely linear responsibility carrier is one-dimensional because its
generator is the proved-nonzero obstruction. -/
theorem positiveSourceGravityMouthLinearResponsibility_finrank :
    Module.finrank ℝ PositiveSourceGravityMouthLinearResponsibilityCarrier = 1 :=
  finrank_span_singleton positiveSourceGravityMouthObstruction_ne_zero

/-- Smallest closure that also respects the already selected gravity internal
dual `J`.  This is a constitutive closure, not a Lorentz orbit closure. -/
def positiveSourceGravityMouthInternalDualResponsibilitySubmodule :
    Submodule ℝ PhysicalBivector :=
  Submodule.span ℝ
    {positiveSourceGravityMouthObstruction,
      gravityInternalDualLinear positiveSourceGravityMouthObstruction}

theorem positiveSourceGravityMouthObstruction_mem_internalDualResponsibility :
    positiveSourceGravityMouthObstruction ∈
      positiveSourceGravityMouthInternalDualResponsibilitySubmodule :=
  Submodule.subset_span (by simp)

theorem positiveSourceGravityMouthInternalDualResponsibility_stable
    (bivector : PhysicalBivector)
    (member : bivector ∈
      positiveSourceGravityMouthInternalDualResponsibilitySubmodule) :
    gravityInternalDualLinear bivector ∈
      positiveSourceGravityMouthInternalDualResponsibilitySubmodule := by
  apply (show positiveSourceGravityMouthInternalDualResponsibilitySubmodule ≤
      Submodule.comap gravityInternalDualLinear
        positiveSourceGravityMouthInternalDualResponsibilitySubmodule by
    apply Submodule.span_le.mpr
    intro generator generatorMem
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at generatorMem
    rcases generatorMem with rfl | rfl
    · exact Submodule.subset_span (by simp)
    · change gravityInternalDualLinear
          (gravityInternalDualLinear positiveSourceGravityMouthObstruction) ∈
        positiveSourceGravityMouthInternalDualResponsibilitySubmodule
      rw [gravityInternalDualLinear_square]
      exact Submodule.neg_mem _ (Submodule.subset_span (by simp))) member

/-- Minimality among real submodules that contain the actual residual and are
stable under the current constitutive internal dual. -/
theorem positiveSourceGravityMouthInternalDualResponsibility_minimal
    (candidate : Submodule ℝ PhysicalBivector)
    (contains : positiveSourceGravityMouthObstruction ∈ candidate)
    (internalDualStable : ∀ bivector ∈ candidate,
      gravityInternalDualLinear bivector ∈ candidate) :
    positiveSourceGravityMouthInternalDualResponsibilitySubmodule ≤
      candidate := by
  apply Submodule.span_le.mpr
  intro generator generatorMem
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at generatorMem
  rcases generatorMem with rfl | rfl
  · exact contains
  · exact internalDualStable positiveSourceGravityMouthObstruction contains

/-- The actual residual as an element of its derived linear responsibility
carrier. -/
def carriedPositiveSourceGravityMouthObstruction :
    PositiveSourceGravityMouthLinearResponsibilityCarrier :=
  ⟨positiveSourceGravityMouthObstruction,
    positiveSourceGravityMouthObstruction_mem_linearResponsibility⟩

theorem carriedPositiveSourceGravityMouthObstruction_ne_zero :
    carriedPositiveSourceGravityMouthObstruction ≠ 0 := by
  intro carriedZero
  apply positiveSourceGravityMouthObstruction_ne_zero
  exact congrArg Subtype.val carriedZero

/-- The scalar keep is generated by the same source's existing `sigma`; no
new coefficient or source slot is introduced. -/
def positiveSourceGravityMouthResponsibilityKeep :
    PositiveSourceGravityMouthLinearResponsibilityCarrier →ₗ[ℝ]
      PositiveSourceGravityMouthLinearResponsibilityCarrier :=
  scalarKeepLinearMap positiveSmoothUnifiedSource.legacy.sigma

/-- The first residual transport step `r' = K r`. -/
def transportedPositiveSourceGravityMouthObstruction :
    PositiveSourceGravityMouthLinearResponsibilityCarrier :=
  positiveSourceGravityMouthResponsibilityKeep
    carriedPositiveSourceGravityMouthObstruction

/-- Positivity of the already generated source `sigma` makes this transport
active/faithful on the exact derived carrier. -/
theorem positiveSourceGravityMouthResponsibilityKeep_active :
    ResidualTransportActive positiveSourceGravityMouthResponsibilityKeep := by
  exact scalarKeepLinearMap_active_of_ne_zero
    positiveSmoothUnifiedSource.legacy.sigma
    (ne_of_gt positiveSmoothUnifiedSource.legacy.sigma_pos)

/-- The keep/trace split is the framework first formula on the actual carried
obstruction. -/
theorem carriedPositiveSourceGravityMouthObstruction_split :
    carriedPositiveSourceGravityMouthObstruction =
      transportedPositiveSourceGravityMouthObstruction +
      linearResidualTrace positiveSourceGravityMouthResponsibilityKeep
        carriedPositiveSourceGravityMouthObstruction :=
  residualTransportCore_residual_split
    positiveSourceGravityMouthResponsibilityKeep
    carriedPositiveSourceGravityMouthObstruction

/-- Any proposed trace satisfying the split is forced to `(I-K)r`; it cannot
become an independent branch-choice field. -/
theorem carriedPositiveSourceGravityMouthObstruction_trace_unique
    (trace : PositiveSourceGravityMouthLinearResponsibilityCarrier) :
    carriedPositiveSourceGravityMouthObstruction =
        transportedPositiveSourceGravityMouthObstruction + trace ↔
      trace = linearResidualTrace
        positiveSourceGravityMouthResponsibilityKeep
        carriedPositiveSourceGravityMouthObstruction :=
  residualTransportCore_trace_unique
    positiveSourceGravityMouthResponsibilityKeep
    carriedPositiveSourceGravityMouthObstruction trace

/-- Positive-definite energy readout on the exact residual carrier. -/
def positiveSourceGravityMouthResponsibilityEnergy
    (residual : PositiveSourceGravityMouthLinearResponsibilityCarrier) : ℝ :=
  ‖residual‖ ^ 2

theorem positiveSourceGravityMouthResponsibilityEnergy_eq_zero_iff
    (residual : PositiveSourceGravityMouthLinearResponsibilityCarrier) :
    positiveSourceGravityMouthResponsibilityEnergy residual = 0 ↔
      residual = 0 := by
  simp [positiveSourceGravityMouthResponsibilityEnergy]

/-- Layer-1 faithful transport: fixedness, zero residual, zero trace, and zero
energy are the same predicate on this carrier. -/
theorem positiveSourceGravityMouthResponsibility_transportEquivalence :
    TruthFormulaCoreEquivalence
      positiveSourceGravityMouthResponsibilityKeep
      positiveSourceGravityMouthResponsibilityEnergy
      carriedPositiveSourceGravityMouthObstruction :=
  residualTransportCore_equivalence
    positiveSourceGravityMouthResponsibilityKeep
    positiveSourceGravityMouthResponsibilityEnergy
    positiveSourceGravityMouthResponsibilityKeep_active
    positiveSourceGravityMouthResponsibilityEnergy_eq_zero_iff
    carriedPositiveSourceGravityMouthObstruction

theorem carriedPositiveSourceGravityMouthObstruction_not_fixed :
    ¬ ResidualTransportFixed positiveSourceGravityMouthResponsibilityKeep
      carriedPositiveSourceGravityMouthObstruction := by
  exact fun fixed => carriedPositiveSourceGravityMouthObstruction_ne_zero
    (positiveSourceGravityMouthResponsibility_transportEquivalence
      |>.fixed_iff_zero_residual.mp fixed)

theorem carriedPositiveSourceGravityMouthObstruction_trace_ne_zero :
    linearResidualTrace positiveSourceGravityMouthResponsibilityKeep
        carriedPositiveSourceGravityMouthObstruction ≠ 0 := by
  exact fun traceZero => carriedPositiveSourceGravityMouthObstruction_ne_zero
    (positiveSourceGravityMouthResponsibility_transportEquivalence
      |>.zero_residual_iff_zero_trace.mpr traceZero)

/-- Residual-level no-third-sink: the actual nonzero obstruction cannot stop
as a fixed or traceless residual.  This is distinct from, and does not replace,
the pre-P950 source-state continuation theorem. -/
theorem positiveSourceGravityMouthObstruction_has_no_naked_residual_sink :
    (¬ ResidualTransportFixed positiveSourceGravityMouthResponsibilityKeep
        carriedPositiveSourceGravityMouthObstruction) ∧
      linearResidualTrace positiveSourceGravityMouthResponsibilityKeep
          carriedPositiveSourceGravityMouthObstruction ≠ 0 :=
  ⟨carriedPositiveSourceGravityMouthObstruction_not_fixed,
    carriedPositiveSourceGravityMouthObstruction_trace_ne_zero⟩

/-- Exact lineage qualifies the source but does not erase its actual residual
responsibility. -/
theorem positiveExactLineage_carries_nonzero_gravityMouthResponsibility :
    positiveSmoothUnifiedSource.stageEight.generatedP506L0Lineage =
        canonicalP506SourceAffineL0ObservableLineageReference ∧
      positiveSourceGravityMouthObstruction ≠ 0 ∧
      linearResidualTrace positiveSourceGravityMouthResponsibilityKeep
          carriedPositiveSourceGravityMouthObstruction ≠ 0 :=
  ⟨positiveSmoothUnifiedSource_generates_exactP506L0Lineage,
    positiveSourceGravityMouthObstruction_ne_zero,
    carriedPositiveSourceGravityMouthObstruction_trace_ne_zero⟩

end

end SaturationMonoid.PhysicsCore.StageNinePositiveSourceGravityMouthObstruction
