import H0mework.Physics.Coframe.CoframeGravityGaugeRegularity
import H0mework.Physics.Coframe.CoframeScalarMatterRegularity

/-!
# S9-C3e2b: actual joint regularity of the complete coframe density

This module assembles the independently generated gravity/gauge and
scalar/matter regularity theorems at the common local-density mouth.  The
candidate coframe is varied jointly with the spacetime point; nondegeneracy
is the only local branch condition needed for the inverse-coframe and
absolute-determinant operations.

No differentiability, curvature, stress, domination, or field-equation
receipt is accepted.  In particular, the final theorem derives joint `C¹`
regularity directly from a primitive smooth holonomic configuration.
-/

namespace SaturationMonoid.PhysicsCore.StageNineCoframeHolonomicRegularity

open ProofFreeRicherAnholonomicSource
open StageNineEnrichedProofFreeSource
open StageNineDynamicBreakingVacuum
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineCoframeVariation
open StageNineCoframeLocalDifferentiability
open StageNineCoframeGravityGaugeRegularity
open StageNineCoframeScalarMatterRegularity
open scoped ContDiff Matrix.Norms.Elementwise

noncomputable section

set_option maxHeartbeats 1200000

/-- The actual common local density as a family in the base point and an
independently selected candidate coframe.  All other fields and first jets
are generated by the primitive holonomic configuration. -/
def holonomicCoframeLocalDensityFamily
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) (candidate : LorentzianCoframe) : ℝ :=
  coframeLocalDensity source point
    (toContinuumPointField configuration point) candidate

/-- The absolute coframe determinant is jointly smooth in the point--coframe
carrier on the nondegenerate branch.  Its apparent point dependence drops
definitionally because the candidate replaces the background coframe. -/
theorem holonomicCoframeVolumeDensity_joint_contDiffAt
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) (candidate : LorentzianCoframe)
    (nondegenerate : Matrix.det candidate ≠ 0) :
    ContDiffAt ℝ 1
      (fun joint : BasePoint × LorentzianCoframe =>
        generatedVolumeDensity
          (withCoframe
            (toContinuumPointField configuration joint.1) joint.2))
      (point, candidate) := by
  change ContDiffAt ℝ 1
    (fun joint : BasePoint × LorentzianCoframe =>
      abs (Matrix.det joint.2)) (point, candidate)
  have jointInfinite : ContDiffAt ℝ ∞
      (fun joint : BasePoint × LorentzianCoframe =>
        abs (Matrix.det joint.2)) (point, candidate) :=
    (coframe_volume_contDiffAt candidate nondegenerate).comp
      (point, candidate) contDiffAt_snd
  exact jointInfinite.of_le (by norm_num)

/-- The generated scalar kinetic, source potential, and Dirac--Yukawa
contribution, grouped in the same way as the actual unified density. -/
def holonomicCoframeScalarMatterDensity
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (joint : BasePoint × LorentzianCoframe) : ℝ :=
  generatedScalarKineticDensity source 0 joint.1
      (withCoframe
        (toContinuumPointField configuration joint.1) joint.2) -
    generatedScalarPotential source 0 joint.1
      (withCoframe
        (toContinuumPointField configuration joint.1) joint.2).scalar +
    generatedContinuumMatterDensity source 0 joint.1
      (withCoframe
        (toContinuumPointField configuration joint.1) joint.2)

theorem holonomicCoframeScalarMatterDensity_joint_contDiffAt
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (point : BasePoint) (candidate : LorentzianCoframe)
    (nondegenerate : Matrix.det candidate ≠ 0) :
    ContDiffAt ℝ 1
      (holonomicCoframeScalarMatterDensity source configuration)
      (point, candidate) := by
  unfold holonomicCoframeScalarMatterDensity
  exact generatedScalarMatterSector_pointCoframe_contDiffAt
    source configuration smooth point candidate nondegenerate

/-- The actual unified local density is the volume factor times the sum of
the five gravity/gauge blocks and the scalar/matter block.  This equality is
kept explicit so later analytic modules can audit the assembly boundary. -/
theorem holonomicCoframeLocalDensityFamily_eq_sector_product
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (joint : BasePoint × LorentzianCoframe) :
    Function.uncurry
        (holonomicCoframeLocalDensityFamily source configuration) joint =
      generatedVolumeDensity
          (withCoframe
            (toContinuumPointField configuration joint.1) joint.2) *
        (holonomicCoframeGravityGaugeDensity source configuration joint +
          holonomicCoframeScalarMatterDensity source configuration joint) := by
  change coframeLocalDensity source joint.1
      (toContinuumPointField configuration joint.1) joint.2 = _
  unfold coframeLocalDensity
  unfold generatedUnifiedLocalDensityAtBoundary
  unfold generatedUnifiedLocalDensityCoreAtBoundary
  unfold generatedUnifiedLocalDensityNonGravityCoreAtBoundary
  unfold holonomicCoframeGravityGaugeDensity
  unfold holonomicGravitySimplicityDensityFamily
  unfold holonomicGravityBFDensityFamily
  unfold holonomicStrongGaugeDensityFamily
  unfold holonomicWeakGaugeDensityFamily
  unfold holonomicHyperchargeGaugeDensityFamily
  unfold holonomicCoframeScalarMatterDensity
  simp only [withCoframe, toContinuumPointField]
  ring

/-- Full joint `C¹` regularity of the actual generated unified density at
every nondegenerate candidate coframe.  This is the physics-specific producer
needed by the compact-corridor integral theorem; it has no caller-provided
regularity receipt. -/
theorem holonomicCoframeLocalDensityFamily_joint_contDiffAt
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (point : BasePoint) (candidate : LorentzianCoframe)
    (nondegenerate : Matrix.det candidate ≠ 0) :
    ContDiffAt ℝ 1
      (Function.uncurry
        (holonomicCoframeLocalDensityFamily source configuration))
      (point, candidate) := by
  have volumeSmooth :=
    holonomicCoframeVolumeDensity_joint_contDiffAt configuration point
      candidate nondegenerate
  have gravityGaugeSmooth :=
    holonomicCoframeGravityGaugeDensity_joint_contDiffAt source configuration
      smooth point candidate nondegenerate
  have scalarMatterSmooth :=
    holonomicCoframeScalarMatterDensity_joint_contDiffAt source configuration
      smooth point candidate nondegenerate
  rw [show Function.uncurry
      (holonomicCoframeLocalDensityFamily source configuration) =
        fun joint : BasePoint × LorentzianCoframe =>
          generatedVolumeDensity
              (withCoframe
                (toContinuumPointField configuration joint.1) joint.2) *
            (holonomicCoframeGravityGaugeDensity source configuration joint +
              holonomicCoframeScalarMatterDensity source configuration joint) by
    funext joint
    exact holonomicCoframeLocalDensityFamily_eq_sector_product
      source configuration joint]
  exact volumeSmooth.mul (gravityGaugeSmooth.add scalarMatterSmooth)

/-- Smoothness of the primitive coframe section, reconstructed from the
coordinatewise smoothness carried by `configuration.Smooth`. -/
theorem holonomicCoframe_contDiff
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth) :
    ContDiff ℝ ∞ configuration.coframe := by
  apply contDiff_pi'
  intro row
  apply contDiff_pi'
  intro column
  exact smooth.1 row column

end

end SaturationMonoid.PhysicsCore.StageNineCoframeHolonomicRegularity
