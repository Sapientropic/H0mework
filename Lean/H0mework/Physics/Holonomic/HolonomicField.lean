import H0mework.Physics.Exterior.GlobalIntegratedAction

/-!
# S9-C0: holonomic continuum fields

Only primitive smooth-field candidates live in this carrier.  Curvature and
covariant-derivative coordinates are generated by Fréchet differentiation,
the actual Lorentz/P286 brackets, and the derived exterior-matter Lie action.
-/

namespace SaturationMonoid.PhysicsCore.StageNineHolonomicField

open ProofFreeRicherAnholonomicSource
open StageNineEnrichedProofFreeSource
open StageNineGlobalIntegratedAction
open StageNineDynamicBreakingVacuum
open SU7MotherLieAlgebra
open SU7MotherGaugeTheory
open SU7ExteriorMatterRepresentation
open SU7ExteriorMatterRestriction
open SU7ExteriorBreakingYukawa
open SU7ExteriorMatterGaugeCovariantJet
open DiracExteriorMatterAction
open PointwiseDiracSpinConnectionLift

open scoped TensorProduct ContDiff

noncomputable section

def coordinateDirection (direction : LorentzianIndex) : BasePoint :=
  EuclideanSpace.single direction 1

def fieldDirectionalDerivative
    {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
    (field : BasePoint → V) (point : BasePoint)
    (direction : LorentzianIndex) : V :=
  fderiv ℝ field point (coordinateDirection direction)

abbrev P286AmbientData :=
  Matrix (Fin 3) (Fin 3) ℂ × Matrix (Fin 2) (Fin 2) ℂ × ℂ

def p286AmbientLinear : P286LieBlockData →ₗ[ℝ] P286AmbientData where
  toFun data :=
    ((data.1 : Matrix (Fin 3) (Fin 3) ℂ),
      (data.2.1 : Matrix (Fin 2) (Fin 2) ℂ),
      (data.2.2 : ℂ))
  map_add' := by
    intro first second
    rfl
  map_smul' := by
    intro scalar data
    rfl

theorem p286AmbientLinear_injective :
    Function.Injective p286AmbientLinear := by
  intro first second equality
  apply Prod.ext
  · apply Subtype.ext
    exact congrArg (fun data : P286AmbientData => data.1) equality
  · apply Prod.ext
    · apply Subtype.ext
      exact congrArg (fun data : P286AmbientData => data.2.1) equality
    · apply Subtype.ext
      exact congrArg (fun data : P286AmbientData => data.2.2) equality

local instance p286ModuleFinite : Module.Finite ℝ P286LieBlockData :=
  FiniteDimensional.of_injective p286AmbientLinear
    p286AmbientLinear_injective

abbrev P286CoordinateIndex :=
  Module.Free.ChooseBasisIndex ℝ P286LieBlockData

abbrev P286CoordinateCarrier :=
  EuclideanSpace ℝ P286CoordinateIndex

def p286CoordinateEquiv :
    P286LieBlockData ≃ₗ[ℝ] P286CoordinateCarrier :=
  (Module.Free.chooseBasis ℝ P286LieBlockData).repr ≪≫ₗ
    Finsupp.linearEquivFunOnFinite ℝ ℝ P286CoordinateIndex ≪≫ₗ
      (WithLp.linearEquiv 2 ℝ (P286CoordinateIndex → ℝ)).symm

abbrev MatterCoordinateIndex :=
  Module.Free.ChooseBasisIndex ℂ DiracExteriorMatterCarrier

abbrev MatterCoordinateCarrier :=
  EuclideanSpace ℂ MatterCoordinateIndex

def matterCoordinateEquiv :
    DiracExteriorMatterCarrier ≃ₗ[ℂ] MatterCoordinateCarrier :=
  (Module.Free.chooseBasis ℂ DiracExteriorMatterCarrier).repr ≪≫ₗ
    Finsupp.linearEquivFunOnFinite ℂ ℂ MatterCoordinateIndex ≪≫ₗ
      (WithLp.linearEquiv 2 ℂ (MatterCoordinateIndex → ℂ)).symm

/-- Infinitesimal fundamental SU(7) action.  Unlike the Stage-8 `1 + A`
transport, this contains no identity or higher exterior-power terms. -/
def fundamentalMotherLieAction (matrix : SU7MotherLieMatrix) :
    Module.End ℂ SU7FundamentalCarrier :=
  Matrix.mulVecLin (matrix : Matrix SU7MotherIndex SU7MotherIndex ℂ)

def exteriorBasisLieAction (degree : ℕ) (matrix : SU7MotherLieMatrix)
    (index : ExteriorBasisIndex degree) :
    ⋀[ℂ]^degree SU7FundamentalCarrier :=
  ∑ position : Fin degree,
    exteriorPower.ιMulti ℂ degree fun candidate =>
      if candidate = position then
        fundamentalMotherLieAction matrix
          (su7FundamentalBasis
            (exteriorPositionEquiv index candidate).1)
      else
        su7FundamentalBasis
          (exteriorPositionEquiv index candidate).1

/-- The actual derived Lie-algebra representation on `ΛᵈV`, extended from
the canonical exterior basis. -/
def exteriorMotherLieAction (degree : ℕ) (matrix : SU7MotherLieMatrix) :
    Module.End ℂ (⋀[ℂ]^degree SU7FundamentalCarrier) where
  toFun field :=
    ∑ index : ExteriorBasisIndex degree,
      (su7ExteriorBasis degree).repr field index •
        exteriorBasisLieAction degree matrix index
  map_add' := by
    intro first second
    simp only [map_add, Finsupp.add_apply, add_smul,
      Finset.sum_add_distrib]
  map_smul' := by
    intro scalar field
    simp only [map_smul, Finsupp.smul_apply, RingHom.id_apply]
    rw [Finset.smul_sum]
    apply Finset.sum_congr rfl
    intro index _
    simp [smul_smul]

@[simp] theorem fundamentalMotherLieAction_zero :
    fundamentalMotherLieAction (0 : SU7MotherLieMatrix) = 0 := by
  apply LinearMap.ext
  intro vector
  simp [fundamentalMotherLieAction]

@[simp] theorem exteriorBasisLieAction_zero
    (degree : ℕ) (index : ExteriorBasisIndex degree) :
    exteriorBasisLieAction degree (0 : SU7MotherLieMatrix) index = 0 := by
  unfold exteriorBasisLieAction
  apply Finset.sum_eq_zero
  intro position _
  apply (exteriorPower.ιMulti ℂ degree).map_coord_zero position
  simp [fundamentalMotherLieAction]

@[simp] theorem exteriorMotherLieAction_zero (degree : ℕ) :
    exteriorMotherLieAction degree (0 : SU7MotherLieMatrix) = 0 := by
  apply LinearMap.ext
  intro field
  simp [exteriorMotherLieAction]

def exteriorSpinorMotherLieAction (matrix : SU7MotherLieMatrix) :
    Module.End ℂ SU7ExteriorSpinorMatterCarrier :=
  (exteriorMotherLieAction 6 matrix).prodMap
    ((exteriorMotherLieAction 2 matrix).prodMap
      (exteriorMotherLieAction 4 matrix))

def diracExteriorMotherLieAction (matrix : SU7MotherLieMatrix) :
    Module.End ℂ DiracExteriorMatterCarrier :=
  internalMatterLinearAction (exteriorSpinorMotherLieAction matrix)

def scalarMotherLieAction
    (matrix : SU7MotherLieMatrix) (scalar : ScalarCoordinateCarrier) :
    ScalarCoordinateCarrier :=
  scalarCoordinateEquiv
    (exteriorMotherLieAction 4 matrix
      (scalarCoordinateEquiv.symm scalar))

abbrev LorentzConnectionField :=
  BasePoint → PointwiseLorentzSpinConnection

abbrev P286ConnectionField :=
  BasePoint → LorentzianIndex → P286LieBlockData

@[ext] structure StageNineHolonomicConfiguration where
  coframe : BasePoint → LorentzianCoframe
  gravityConnection : LorentzConnectionField
  gravityAuxiliary : BasePoint → PhysicalBivector
  gravitySimplicityMultiplier : BasePoint → PhysicalBivector
  gaugeConnection : P286ConnectionField
  gaugeAuxiliary : BasePoint → Fin 6 → P286LieBlockData
  scalar : BasePoint → ScalarCoordinateCarrier
  matter : BasePoint → DiracExteriorMatterCarrier
  conjugateMatter : BasePoint → Module.Dual ℂ DiracExteriorMatterCarrier

def StageNineHolonomicConfiguration.Smooth
    (configuration : StageNineHolonomicConfiguration) : Prop :=
  (∀ row column,
    ContDiff ℝ ∞ fun point => configuration.coframe point row column) ∧
    (∀ direction internalOut internalIn,
      ContDiff ℝ ∞ fun point =>
        configuration.gravityConnection point direction internalOut internalIn) ∧
    (∀ internalPair spacetimePair,
      ContDiff ℝ ∞ fun point =>
        configuration.gravityAuxiliary point internalPair spacetimePair) ∧
    (∀ internalPair spacetimePair,
      ContDiff ℝ ∞ fun point =>
        configuration.gravitySimplicityMultiplier point
          internalPair spacetimePair) ∧
    (∀ direction,
      ContDiff ℝ ∞ fun point =>
        p286CoordinateEquiv (configuration.gaugeConnection point direction)) ∧
    (∀ pair,
      ContDiff ℝ ∞ fun point =>
        p286CoordinateEquiv (configuration.gaugeAuxiliary point pair)) ∧
    ContDiff ℝ ∞ configuration.scalar ∧
    ContDiff ℝ ∞ (fun point =>
      matterCoordinateEquiv (configuration.matter point)) ∧
    (∀ index : MatterCoordinateIndex,
      ContDiff ℝ ∞ fun point =>
        configuration.conjugateMatter point
          (matterCoordinateEquiv.symm
            (EuclideanSpace.single index 1)))

def StageNineHolonomicConfiguration.Nondegenerate
    (configuration : StageNineHolonomicConfiguration) : Prop :=
  ∀ point, Matrix.det (configuration.coframe point) ≠ 0

def gravityConnectionDerivative
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) (derivativeDirection formDirection internalOut internalIn :
      LorentzianIndex) : ℝ :=
  fderiv ℝ
    (fun candidate =>
      configuration.gravityConnection candidate formDirection
        internalOut internalIn)
    point (coordinateDirection derivativeDirection)

/-- Actual `dω + ω∧ω` curvature of the primitive Lorentz connection field. -/
def holonomicGravityCurvature
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) : PhysicalBivector :=
  fun internalPair spacetimePair =>
    let internalOut := pairFirst internalPair
    let internalIn := pairSecond internalPair
    let first := pairFirst spacetimePair
    let second := pairSecond spacetimePair
    minkowskiInternalSign internalOut *
      (gravityConnectionDerivative configuration point first second
          internalOut internalIn -
        gravityConnectionDerivative configuration point second first
          internalOut internalIn +
        ∑ middle : LorentzianIndex,
          (configuration.gravityConnection point first internalOut middle *
              configuration.gravityConnection point second middle internalIn -
            configuration.gravityConnection point second internalOut middle *
              configuration.gravityConnection point first middle internalIn))

def p286ConnectionDerivative
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) (derivativeDirection formDirection : LorentzianIndex) :
    P286LieBlockData :=
  p286CoordinateEquiv.symm
    (fieldDirectionalDerivative
      (fun candidate =>
        p286CoordinateEquiv
          (configuration.gaugeConnection candidate formDirection))
      point derivativeDirection)

/-- Actual `dA + [A,A]` curvature of the primitive P286 connection field. -/
def holonomicGaugeCurvature
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) : Fin 6 → P286LieBlockData :=
  fun pair =>
    p286ConnectionDerivative configuration point
        (pairFirst pair) (pairSecond pair) -
      p286ConnectionDerivative configuration point
        (pairSecond pair) (pairFirst pair) +
      p286LieBracket
        (configuration.gaugeConnection point (pairFirst pair))
        (configuration.gaugeConnection point (pairSecond pair))

@[simp] theorem suLieBracket_zero_zero
    {n : Type*} [Fintype n] [DecidableEq n] :
    suLieBracket (0 : SpecialUnitaryLieMatrix n) 0 = 0 := by
  apply Subtype.ext
  simp [suLieBracket]

def holonomicScalarCovariantDerivative
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) (direction : LorentzianIndex) :
    ScalarCoordinateCarrier :=
  fieldDirectionalDerivative configuration.scalar point direction +
    scalarMotherLieAction
      (p286LieBlockEmbed (configuration.gaugeConnection point direction))
      (configuration.scalar point)

def holonomicMatterCovariantDerivative
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) (direction : LorentzianIndex) :
    DiracExteriorMatterCarrier :=
  matterCoordinateEquiv.symm
      (fieldDirectionalDerivative
        (fun candidate => matterCoordinateEquiv (configuration.matter candidate))
        point direction) +
    diracMatrixMatterAction
      (diracSpinConnectionLift
        (configuration.gravityConnection point) direction)
      (configuration.matter point) +
    diracExteriorMotherLieAction
      (p286LieBlockEmbed (configuration.gaugeConnection point direction))
      (configuration.matter point)

def toContinuumPointField
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) : StageNineContinuumPointField where
  coframe := configuration.coframe point
  gravityCurvature := holonomicGravityCurvature configuration point
  gravityAuxiliary := configuration.gravityAuxiliary point
  gravitySimplicityMultiplier :=
    configuration.gravitySimplicityMultiplier point
  gaugeCurvature := holonomicGaugeCurvature configuration point
  gaugeAuxiliary := configuration.gaugeAuxiliary point
  scalar := configuration.scalar point
  scalarCovariantDerivative :=
    holonomicScalarCovariantDerivative configuration point
  matter := configuration.matter point
  matterCovariantDerivative :=
    holonomicMatterCovariantDerivative configuration point
  conjugateMatter := configuration.conjugateMatter point

def toContinuumFieldSection
    (configuration : StageNineHolonomicConfiguration) :
    StageNineContinuumFieldSection :=
  toContinuumPointField configuration

def holonomicIntegratedUnifiedAction
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (configuration : StageNineHolonomicConfiguration) : ℝ :=
  sourceGeneratedIntegratedUnifiedAction source chart
    (toContinuumFieldSection configuration)

/-- The local density of a candidate holonomic configuration is integrable.
This is an analytic condition on the candidate field over the noncompact base,
not source data and not a stationarity or field-equation receipt. -/
def HolonomicLocalDensityIntegrable
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (configuration : StageNineHolonomicConfiguration) : Prop :=
  MeasureTheory.Integrable fun point =>
    generatedUnifiedLocalDensityAtBoundary source
      (sourceGeneratedUnifiedCouplings source) chart point
      (toContinuumPointField configuration point)

/-- The raw first-jet section is now an output: its curvature and covariant
derivatives cannot be independently supplied at the action mouth. -/
theorem toContinuumPointField_generatedJets
    (configuration : StageNineHolonomicConfiguration) (point : BasePoint) :
    (toContinuumPointField configuration point).gravityCurvature =
        holonomicGravityCurvature configuration point ∧
      (toContinuumPointField configuration point).gaugeCurvature =
        holonomicGaugeCurvature configuration point ∧
      (toContinuumPointField configuration point).scalarCovariantDerivative =
        holonomicScalarCovariantDerivative configuration point ∧
      (toContinuumPointField configuration point).matterCovariantDerivative =
        holonomicMatterCovariantDerivative configuration point :=
  ⟨rfl, rfl, rfl, rfl⟩

theorem holonomicGaugeCurvature_zeroConnection
    (configuration : StageNineHolonomicConfiguration)
    (connectionZero : configuration.gaugeConnection = 0)
    (point : BasePoint) :
    holonomicGaugeCurvature configuration point = 0 := by
  funext pair
  simp [holonomicGaugeCurvature, p286ConnectionDerivative,
    fieldDirectionalDerivative, connectionZero, p286LieBracket]

theorem canonicalP286Generator_ne_zero :
    canonicalP286Generator ≠ 0 := by
  intro generatorZero
  have hyperchargeZero := congrArg
    (fun data : P286LieBlockData => (data.2.2 : ℂ)) generatorZero
  norm_num [canonicalP286Generator, hyperchargeGenerator] at hyperchargeZero

def independentGaugeCurvatureFake
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) : StageNineContinuumPointField :=
  { toContinuumPointField configuration point with
    gaugeCurvature := fun _ => canonicalP286Generator }

/-- Negative regression: a nonzero curvature slot cannot be hand-filled over
a zero primitive connection and still claim to be the holonomic action input.
-/
theorem independentGaugeCurvatureFake_rejected
    (configuration : StageNineHolonomicConfiguration)
    (connectionZero : configuration.gaugeConnection = 0)
    (point : BasePoint) :
    independentGaugeCurvatureFake configuration point ≠
      toContinuumPointField configuration point := by
  intro fakeEquality
  have curvatureEquality := congrArg
    StageNineContinuumPointField.gaugeCurvature fakeEquality
  have zeroCurvature := holonomicGaugeCurvature_zeroConnection
    configuration connectionZero point
  have componentEquality := congrFun curvatureEquality 0
  have generatedEquality :
      canonicalP286Generator =
        holonomicGaugeCurvature configuration point 0 := by
    simpa [independentGaugeCurvatureFake, toContinuumPointField] using
      componentEquality
  rw [zeroCurvature] at generatedEquality
  exact canonicalP286Generator_ne_zero generatedEquality

end

end SaturationMonoid.PhysicsCore.StageNineHolonomicField
