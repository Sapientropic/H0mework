import H0mework.Physics.RepresentationSources.P678

/-!
# Proposition 679: source-law finite-output no-free theorem

P678 welds the full-beta-vector physical source law to the current grand root.
This file removes one more place where a "parameter vector" could hide.

We define the finite physical output surface generated by a P632
`OneAxisFiniteSourceLaw`: an output carries an axis plus the three grouped
finite Standard-Model readings currently proved in Lean:

* the alpha_s inverse residual;
* the nine Yukawa mass-order depths;
* the CKM/Jarlskog depth sum.

Lean proves that this whole output surface is a singleton.  Equivalently, once
the one-axis source law is fixed, the current finite alpha/Yukawa/CKM output
vector has no continuous freedom left: every accepted output is the canonical
one read from the full beta-vector/Poincare source-law axis.

Boundary: this is still the finite source-law output theorem.  It does not
derive the universal QFT one-loop weights, smooth SU(7) breaking, threshold /
three-loop RG, Higgs-extra spectra, full CKM matrix entries, Goldbach, RH, or
the final Euler/RH adapter range.
-/

noncomputable section

namespace SaturationMonoid
namespace StandardModelConstraint

/-! ## Source-law generated finite physical output surface -/

/-- Grouped finite physical output generated by the current one-axis
source-law layer. -/
@[ext]
structure SourceLawFinitePhysicalOutput where
  axis : ℚ
  alphaInverseResidual : ℚ
  yukawaMassOrder : List ℚ
  ckmDepthSum : ℚ

/-- The canonical output read from the full-beta-vector/Poincare source-law
axis. -/
def canonicalSourceLawFinitePhysicalOutput :
    SourceLawFinitePhysicalOutput where
  axis := fullBetaVectorPoincareOneAxis
  alphaInverseResidual := -((89000 : ℚ) / 128511)
  yukawaMassOrder := [50, 346, 372, 489, 583, 682, 880, 908, 982]
  ckmDepthSum := (386 : ℚ)

/-- The source-law output surface: the axis must satisfy the P632 source law,
and the output coordinates must be read from that same axis. -/
def SourceLawFinitePhysicalOutputSurface
    (O : SourceLawFinitePhysicalOutput) : Prop :=
  OneAxisFiniteSourceLaw O.axis ∧
    O.alphaInverseResidual =
      inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (oneAxisAlphaStrongGap O.axis) ∧
    O.yukawaMassOrder =
      rationalGridMassOrder
        (gridOfStencil (oneAxisYukawaRationalStencil O.axis)) ∧
    O.ckmDepthSum = 2 * oneAxisCKMSectorGap O.axis

/-- THEOREM 1: the canonical full-beta-vector output lies on the source-law
finite physical output surface. -/
theorem canonicalSourceLawFinitePhysicalOutput_surface :
    SourceLawFinitePhysicalOutputSurface
      canonicalSourceLawFinitePhysicalOutput := by
  refine ⟨fullBetaVectorPoincareOneAxis_sourceLaw, ?_, ?_, ?_⟩
  · exact fullBetaVectorPoincareOneAxis_alphaInverseResidual.symm
  · exact fullBetaVectorPoincareOneAxis_yukawaMassOrder.symm
  · exact fullBetaVectorPoincareOneAxis_ckmDepthSum.symm

/-- THEOREM 2: every source-law finite output is the canonical output. -/
theorem eq_canonicalSourceLawFinitePhysicalOutput_of_surface
    (O : SourceLawFinitePhysicalOutput)
    (hO : SourceLawFinitePhysicalOutputSurface O) :
    O = canonicalSourceLawFinitePhysicalOutput := by
  rcases O with ⟨axis, alphaInv, yukawaList, ckmSum⟩
  rcases hO with ⟨hsource, halpha, hyukawa, hckm⟩
  have haxis :
      axis = canonicalSourceLawFinitePhysicalOutput.axis := by
    calc
      axis = (10 : ℚ) := oneAxisFiniteSourceLaw_eq_ten hsource
      _ = canonicalSourceLawFinitePhysicalOutput.axis := by
        simp [canonicalSourceLawFinitePhysicalOutput,
          fullBetaVectorPoincareOneAxis_eq_ten]
  have halpha' :
      alphaInv =
        canonicalSourceLawFinitePhysicalOutput.alphaInverseResidual := by
    calc
      alphaInv =
          inverseCorrectionFromAlphaGap
            (alphaStrongTwoLoopSMOutput ℚ)
            (oneAxisAlphaStrongGap axis) := halpha
      _ = -((89000 : ℚ) / 128511) :=
          oneAxisAlphaStrongInverseCorrection_eq_neg_of_sourceLaw hsource
      _ = canonicalSourceLawFinitePhysicalOutput.alphaInverseResidual := rfl
  have hyukawa' :
      yukawaList =
        canonicalSourceLawFinitePhysicalOutput.yukawaMassOrder := by
    calc
      yukawaList =
          rationalGridMassOrder
            (gridOfStencil (oneAxisYukawaRationalStencil axis)) := hyukawa
      _ = [50, 346, 372, 489, 583, 682, 880, 908, 982] :=
          oneAxisYukawaMassOrder_eq_of_sourceLaw hsource
      _ = canonicalSourceLawFinitePhysicalOutput.yukawaMassOrder := rfl
  have hckm' :
      ckmSum = canonicalSourceLawFinitePhysicalOutput.ckmDepthSum := by
    calc
      ckmSum = 2 * oneAxisCKMSectorGap axis := hckm
      _ = (386 : ℚ) := oneAxisCKMDepthSum_eq_386_of_sourceLaw hsource
      _ = canonicalSourceLawFinitePhysicalOutput.ckmDepthSum := rfl
  cases haxis
  cases halpha'
  cases hyukawa'
  cases hckm'
  rfl

/-- THEOREM 3: source-law finite outputs are exactly the canonical output. -/
theorem sourceLawFinitePhysicalOutputSurface_iff_canonical
    (O : SourceLawFinitePhysicalOutput) :
    SourceLawFinitePhysicalOutputSurface O ↔
      O = canonicalSourceLawFinitePhysicalOutput := by
  constructor
  · exact eq_canonicalSourceLawFinitePhysicalOutput_of_surface O
  · intro hO
    rw [hO]
    exact canonicalSourceLawFinitePhysicalOutput_surface

/-- No-free predicate for source-law finite physical outputs. -/
def NoContinuousFreeSourceLawFinitePhysicalOutputs
    (constraints : SourceLawFinitePhysicalOutput -> Prop) : Prop :=
  ∀ O P : SourceLawFinitePhysicalOutput,
    constraints O -> constraints P -> O = P

/-- THEOREM 4: the source-law finite physical output surface is singleton /
no-free. -/
theorem sourceLawFinitePhysicalOutputSurface_noFree :
    NoContinuousFreeSourceLawFinitePhysicalOutputs
      SourceLawFinitePhysicalOutputSurface := by
  intro O P hO hP
  rw [eq_canonicalSourceLawFinitePhysicalOutput_of_surface O hO,
    eq_canonicalSourceLawFinitePhysicalOutput_of_surface P hP]

/-- THEOREM 5: every source-law finite output has the exact alpha_s inverse
residual `-89000/128511`. -/
theorem sourceLawFinitePhysicalOutput_alphaInverseResidual
    (O : SourceLawFinitePhysicalOutput)
    (hO : SourceLawFinitePhysicalOutputSurface O) :
    O.alphaInverseResidual = -((89000 : ℚ) / 128511) := by
  rw [eq_canonicalSourceLawFinitePhysicalOutput_of_surface O hO]
  rfl

/-- THEOREM 6: every source-law finite output has the documented Yukawa
mass-order depth list. -/
theorem sourceLawFinitePhysicalOutput_yukawaMassOrder
    (O : SourceLawFinitePhysicalOutput)
    (hO : SourceLawFinitePhysicalOutputSurface O) :
    O.yukawaMassOrder =
      [50, 346, 372, 489, 583, 682, 880, 908, 982] := by
  rw [eq_canonicalSourceLawFinitePhysicalOutput_of_surface O hO]
  rfl

/-- THEOREM 7: every source-law finite output has CKM/Jarlskog depth sum
`386`. -/
theorem sourceLawFinitePhysicalOutput_ckmDepthSum
    (O : SourceLawFinitePhysicalOutput)
    (hO : SourceLawFinitePhysicalOutputSurface O) :
    O.ckmDepthSum = (386 : ℚ) := by
  rw [eq_canonicalSourceLawFinitePhysicalOutput_of_surface O hO]
  rfl

/-! ## Packaged certificate -/

/-- P679 certificate: the current finite physical output vector generated by
the one-axis source law has no continuous parameters left. -/
structure SourceLawFinitePhysicalOutputNoFreeCertificate where
  p678_physical_source_law :
    FullBetaVectorSourceLawPhysicalCertificate
  canonical_surface :
    SourceLawFinitePhysicalOutputSurface
      canonicalSourceLawFinitePhysicalOutput
  surface_iff_canonical :
    ∀ O : SourceLawFinitePhysicalOutput,
      SourceLawFinitePhysicalOutputSurface O ↔
        O = canonicalSourceLawFinitePhysicalOutput
  no_free :
    NoContinuousFreeSourceLawFinitePhysicalOutputs
      SourceLawFinitePhysicalOutputSurface
  alpha_inverse_residual :
    ∀ O : SourceLawFinitePhysicalOutput,
      SourceLawFinitePhysicalOutputSurface O ->
        O.alphaInverseResidual = -((89000 : ℚ) / 128511)
  yukawa_mass_order :
    ∀ O : SourceLawFinitePhysicalOutput,
      SourceLawFinitePhysicalOutputSurface O ->
        O.yukawaMassOrder =
          [50, 346, 372, 489, 583, 682, 880, 908, 982]
  ckm_depth_sum :
    ∀ O : SourceLawFinitePhysicalOutput,
      SourceLawFinitePhysicalOutputSurface O ->
        O.ckmDepthSum = (386 : ℚ)

/-- DEFINITION 1: canonical source-law finite-output no-free certificate. -/
def sourceLawFinitePhysicalOutputNoFreeCertificate :
    SourceLawFinitePhysicalOutputNoFreeCertificate where
  p678_physical_source_law := fullBetaVectorSourceLawPhysicalCertificate
  canonical_surface := canonicalSourceLawFinitePhysicalOutput_surface
  surface_iff_canonical :=
    sourceLawFinitePhysicalOutputSurface_iff_canonical
  no_free := sourceLawFinitePhysicalOutputSurface_noFree
  alpha_inverse_residual :=
    sourceLawFinitePhysicalOutput_alphaInverseResidual
  yukawa_mass_order :=
    sourceLawFinitePhysicalOutput_yukawaMassOrder
  ckm_depth_sum :=
    sourceLawFinitePhysicalOutput_ckmDepthSum

end StandardModelConstraint

