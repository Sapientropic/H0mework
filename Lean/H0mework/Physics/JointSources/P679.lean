    sourceLawFinitePhysicalOutputNoFreeCertificate
  surface_iff_canonical :=
    sourceLawFinitePhysicalOutputSurface_iff_canonical
  no_continuous_free_finite_outputs :=
    sourceLawFinitePhysicalOutputSurface_noFree
  source_producer_iff_goldbach :=
    evenSupportCodeSource_pullbackProducer_iff_goldbach
  alpha_active_source_iff_su7 :=
    alphaStrong_sourceSurface_activeSource_iff_su7Breaking

