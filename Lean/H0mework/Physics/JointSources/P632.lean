import H0mework.Realization.Relations.P631

/-!
# Proposition 632: the parametric one-axis source law

P631 packages the current strongest finite root, but it is still a canonical
witness.  This file turns that witness into a reusable producer target.

We introduce a parametric one-axis family:

* visible gauge card: `a - 1`;
* electromagnetic denominator: `2^7 + (a - 1)`;
* alpha_s residual gap: `(alpha(a) - dim SU(7)) / a^4`;
* Yukawa rational stencil: the P630 stencil with `alpha` and `visible` read
  from the same axis `a`;
* CKM sector gap: `(dim SU(7)-1) - (-(alpha(a)+visible(a)))`.

The source law is deliberately small:

`a = b0_QCD + PoincareSlots_4D`.

Lean proves that any `a` satisfying this law collapses to `a=10` and therefore
forces the same three nails as P631: alpha_s residual `-89000/128511`, the
Yukawa mass-order list, and CKM/Jarlskog `386`.

Boundary: this still does not prove the smooth physical dynamics that produces
the axis law.  It makes the next producer obligation precise and reusable.
-/

noncomputable section

namespace SaturationMonoid
namespace StandardModelConstraint

/-! ## A parametric one-axis family -/

/-- The source law a deeper producer must hit: the finite axis is QCD `b0`
plus the 4D Poincare pairing-slot count. -/
def OneAxisFiniteSourceLaw (a : ℚ) : Prop :=
  a =
    RunningSigmaBeta.betaCoeff
      RunningSigmaBeta.qcdBlockIncidenceOneLoopInput +
        (AffineRelaxation.GeometryConnection.poincarePairingSlotCount 4 : ℚ)

/-- Visible gauge directions as read from a candidate one-axis value. -/
def oneAxisVisibleGauge (a : ℚ) : ℚ := a - 1

/-- Electromagnetic structural denominator as read from a candidate axis. -/
def oneAxisAlphaEMDenominator (a : ℚ) : ℚ :=
  sevenFacetInformationStateCount ℚ + oneAxisVisibleGauge a

/-- SU(7)-breaking numerator as read from a candidate axis. -/
def oneAxisAlphaStrongNumerator (a : ℚ) : ℚ :=
  oneAxisAlphaEMDenominator a - su7GaugeFreedomDimension ℚ

/-- Finite alpha_s resolution denominator as read from a candidate axis. -/
def oneAxisAlphaStrongDenominator (a : ℚ) : ℚ :=
  a ^ alphaStrongResidualResolutionExponent

/-- Alpha-level residual gap generated by a candidate finite axis. -/
def oneAxisAlphaStrongGap (a : ℚ) : ℚ :=
  oneAxisAlphaStrongNumerator a / oneAxisAlphaStrongDenominator a

/-- Yukawa rational stencil with `alpha` and `visible` read from a candidate
axis. -/
def oneAxisYukawaRationalStencil (a : ℚ) :
    RationalYukawaBiquadraticStencil where
  center := 5 * oneAxisAlphaEMDenominator a - 3
  generationSlope := 2 * oneAxisAlphaEMDenominator a - 7
  sectorSlope := su7GaugeFreedomDimension ℚ - 1
  generationCurvature := -((oneAxisAlphaEMDenominator a + 1) / 2)
  sectorCurvature :=
    -(oneAxisAlphaEMDenominator a + oneAxisVisibleGauge a)
  mixedTwist := -(su7GaugeFreedomDimension ℚ + 2 * (7 : ℚ))
  generationCurvatureSector := su7GaugeFreedomDimension ℚ + 4
  generationSectorCurvature := (oneAxisVisibleGauge a + 1) ^ (2 : Nat)
  bicurvature :=
    sevenFacetInformationStateCount ℚ -
      informationMatterSupportCardFromComponentCarrierZ

/-- CKM-relevant sector gap generated by a candidate finite axis. -/
def oneAxisCKMSectorGap (a : ℚ) : ℚ :=
  (su7GaugeFreedomDimension ℚ - 1) -
    (-(oneAxisAlphaEMDenominator a + oneAxisVisibleGauge a))

/-! ## Any source-law axis collapses to the P631 axis -/

/-- THEOREM 1: the one-axis source law forces `a=10`. -/
theorem oneAxisFiniteSourceLaw_eq_ten {a : ℚ}
    (h : OneAxisFiniteSourceLaw a) :
    a = (10 : ℚ) := by
  change a = alphaStrongQCDPoincareResolutionAxis at h
  rw [h]
  exact alphaStrongQCDPoincareResolutionAxis_eq_ten

/-- THEOREM 2: the source law forces visible gauge card `9`. -/
theorem oneAxisVisibleGauge_eq_nine_of_sourceLaw {a : ℚ}
    (h : OneAxisFiniteSourceLaw a) :
    oneAxisVisibleGauge a = (9 : ℚ) := by
  rw [oneAxisVisibleGauge, oneAxisFiniteSourceLaw_eq_ten h]
  norm_num

/-- THEOREM 3: the source law forces alpha-em denominator `137`. -/
theorem oneAxisAlphaEMDenominator_eq_137_of_sourceLaw {a : ℚ}
    (h : OneAxisFiniteSourceLaw a) :
    oneAxisAlphaEMDenominator a = (137 : ℚ) := by
  rw [oneAxisAlphaEMDenominator,
    oneAxisVisibleGauge_eq_nine_of_sourceLaw h,
    sevenFacetInformationStateCount_eq_128]
  norm_num

/-! ## Alpha_s consequence -/

/-- THEOREM 4: the source law forces the alpha_s alpha-level gap
`89/10000`. -/
theorem oneAxisAlphaStrongGap_eq_89_div_10000_of_sourceLaw {a : ℚ}
    (h : OneAxisFiniteSourceLaw a) :
    oneAxisAlphaStrongGap a = (89 : ℚ) / 10000 := by
  have ha := oneAxisFiniteSourceLaw_eq_ten h
  norm_num [oneAxisAlphaStrongGap, oneAxisAlphaStrongNumerator,
    oneAxisAlphaStrongDenominator, oneAxisAlphaEMDenominator,
    oneAxisVisibleGauge, ha, alphaStrongResidualResolutionExponent,
    su7GaugeFreedomDimension, sevenFacetInformationStateCount]

/-- THEOREM 5: the source-law alpha gap transports to the exact inverse
residual `-89000/128511`. -/
theorem oneAxisAlphaStrongInverseCorrection_eq_neg_of_sourceLaw {a : ℚ}
    (h : OneAxisFiniteSourceLaw a) :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (oneAxisAlphaStrongGap a) =
      -((89000 : ℚ) / 128511) := by
  rw [oneAxisAlphaStrongGap_eq_89_div_10000_of_sourceLaw h]
  norm_num [inverseCorrectionFromAlphaGap, alphaStrongTwoLoopSMOutput]

/-! ## Yukawa and CKM consequences -/

/-- THEOREM 6: the source-law Yukawa stencil is canonical. -/
theorem oneAxisYukawaRationalStencil_eq_canonical_of_sourceLaw {a : ℚ}
    (h : OneAxisFiniteSourceLaw a) :
    oneAxisYukawaRationalStencil a =
      RationalYukawaBiquadraticStencil.canonical := by
  have ha := oneAxisFiniteSourceLaw_eq_ten h
  ext <;>
    norm_num [oneAxisYukawaRationalStencil, oneAxisAlphaEMDenominator,
      oneAxisVisibleGauge, ha,
      RationalYukawaBiquadraticStencil.canonical,
      yukawaDepthStencilCenter, yukawaDepthStencilGenerationSlope,
      yukawaDepthStencilSectorSlope, yukawaDepthStencilGenerationCurvature,
      yukawaDepthStencilSectorCurvature, yukawaDepthStencilMixedTwist,
      yukawaDepthStencilGenerationCurvatureSector,
      yukawaDepthStencilGenerationSectorCurvature,
      yukawaDepthStencilBicurvature, visibleGaugeCarrierCardZ,
      canonicalInformationMatterSupportCardZ, alphaEMIntegerDenominator,
      su7GaugeFreedomDimension, sevenFacetInformationStateCount,
      informationMatterSupportCardFromComponentCarrierZ_eq_seventeen]

/-- THEOREM 7: the source-law Yukawa grid is the selected grid. -/
theorem oneAxisYukawaGrid_eq_selected_of_sourceLaw {a : ℚ}
    (h : OneAxisFiniteSourceLaw a) :
    gridOfStencil (oneAxisYukawaRationalStencil a) =
      selectedYukawaDepthGrid := by
  rw [oneAxisYukawaRationalStencil_eq_canonical_of_sourceLaw h,
    ← selectedGrid_eq_gridOf_canonical]

/-- THEOREM 8: the source law forces the documented Yukawa mass-order depth
list. -/
theorem oneAxisYukawaMassOrder_eq_of_sourceLaw {a : ℚ}
    (h : OneAxisFiniteSourceLaw a) :
    rationalGridMassOrder (gridOfStencil (oneAxisYukawaRationalStencil a)) =
      [50, 346, 372, 489, 583, 682, 880, 908, 982] := by
  rw [oneAxisYukawaGrid_eq_selected_of_sourceLaw h]
  rfl

/-- THEOREM 9: the source law forces the CKM sector gap `193`. -/
theorem oneAxisCKMSectorGap_eq_193_of_sourceLaw {a : ℚ}
    (h : OneAxisFiniteSourceLaw a) :
    oneAxisCKMSectorGap a = (193 : ℚ) := by
  have ha := oneAxisFiniteSourceLaw_eq_ten h
  norm_num [oneAxisCKMSectorGap, oneAxisAlphaEMDenominator,
    oneAxisVisibleGauge, ha, su7GaugeFreedomDimension,
    sevenFacetInformationStateCount]

/-- THEOREM 10: the source law forces the CKM/Jarlskog depth sum `386`. -/
theorem oneAxisCKMDepthSum_eq_386_of_sourceLaw {a : ℚ}
    (h : OneAxisFiniteSourceLaw a) :
    2 * oneAxisCKMSectorGap a = (386 : ℚ) := by
  rw [oneAxisCKMSectorGap_eq_193_of_sourceLaw h]
  norm_num

/-! ## Bundled producer target -/

/-- Compact receipt: any deeper producer that proves the one-axis source law
gets the current finite three-nail output for free. -/
structure OneAxisFiniteSourceLawReceipt (a : ℚ) where
  source_law : OneAxisFiniteSourceLaw a
  axis : a = (10 : ℚ)
  visible : oneAxisVisibleGauge a = (9 : ℚ)
  alpha_em : oneAxisAlphaEMDenominator a = (137 : ℚ)
  alpha_gap : oneAxisAlphaStrongGap a = (89 : ℚ) / 10000
  alpha_inverse_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (oneAxisAlphaStrongGap a) =
      -((89000 : ℚ) / 128511)
  yukawa_stencil :
    oneAxisYukawaRationalStencil a =
      RationalYukawaBiquadraticStencil.canonical
  yukawa_grid :
    gridOfStencil (oneAxisYukawaRationalStencil a) =
      selectedYukawaDepthGrid
  yukawa_mass_order :
    rationalGridMassOrder (gridOfStencil (oneAxisYukawaRationalStencil a)) =
      [50, 346, 372, 489, 583, 682, 880, 908, 982]
  ckm_sector_gap : oneAxisCKMSectorGap a = (193 : ℚ)
  ckm_depth_sum : 2 * oneAxisCKMSectorGap a = (386 : ℚ)

/-- THEOREM 11: source-law receipt constructor. -/
theorem oneAxisFiniteSourceLawReceipt {a : ℚ}
    (h : OneAxisFiniteSourceLaw a) :
    OneAxisFiniteSourceLawReceipt a where
  source_law := h
  axis := oneAxisFiniteSourceLaw_eq_ten h
  visible := oneAxisVisibleGauge_eq_nine_of_sourceLaw h
  alpha_em := oneAxisAlphaEMDenominator_eq_137_of_sourceLaw h
  alpha_gap := oneAxisAlphaStrongGap_eq_89_div_10000_of_sourceLaw h
  alpha_inverse_residual :=
    oneAxisAlphaStrongInverseCorrection_eq_neg_of_sourceLaw h
  yukawa_stencil := oneAxisYukawaRationalStencil_eq_canonical_of_sourceLaw h
  yukawa_grid := oneAxisYukawaGrid_eq_selected_of_sourceLaw h
  yukawa_mass_order := oneAxisYukawaMassOrder_eq_of_sourceLaw h
  ckm_sector_gap := oneAxisCKMSectorGap_eq_193_of_sourceLaw h
  ckm_depth_sum := oneAxisCKMDepthSum_eq_386_of_sourceLaw h

end StandardModelConstraint
end SaturationMonoid
