import H0mework.Physics.BranchSources.P874

/-!
# Proposition 875: well-founded Lyapunov descent produces physical zero cells

P874 proves a finite-orbit version: if a finite physical orbit has a certified
minimum-energy cell and every nonzero cell strictly descends, the minimum cell
has zero residual.

This file removes the stored minimum.  A physical orbit now supplies only:

* a starting cell;
* a Lyapunov successor for every nonzero-residual cell;
* strict decrease of residual energy along that successor.

Because residual energy is a natural number, well-founded induction forces the
descent to terminate at a zero-residual cell.  This is the harder producer
shape: the zero cell is generated by dynamics, not stored as a minimum witness.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open SaturationMonoid.AffineRelaxation

set_option linter.defProp false

/-! ## Well-founded physical Lyapunov orbit -/

/-- A physical orbit over one even fiber with a starting cell and a strict
Lyapunov descent successor for every nonzero-residual cell. -/
structure SU7WellFoundedPhysicalOrbit (n : ℕ) where
  startCell : SU7PhysicalBranchCell n
  lyapunov_descends_nonzero :
    ∀ cell : SU7PhysicalBranchCell n,
      physicalResidual cell ≠ 0 ->
        ∃ next : SU7PhysicalBranchCell n,
          physicalResidualEnergy next < physicalResidualEnergy cell

/-- THEOREM 1: well-founded Lyapunov descent from any starting cell reaches a
zero-residual physical cell. -/
theorem exists_zeroCell_of_wellFoundedLyapunovOrbit
    {n : ℕ} (O : SU7WellFoundedPhysicalOrbit n) :
    ∃ cell : SU7PhysicalBranchCell n, physicalResidual cell = 0 := by
  have hstep :
      ∀ e : ℕ,
        (∀ e' < e,
          ∀ cell : SU7PhysicalBranchCell n,
            physicalResidualEnergy cell = e' ->
              ∃ zeroCell : SU7PhysicalBranchCell n,
                physicalResidual zeroCell = 0) ->
          ∀ cell : SU7PhysicalBranchCell n,
            physicalResidualEnergy cell = e ->
              ∃ zeroCell : SU7PhysicalBranchCell n,
                physicalResidual zeroCell = 0 := by
    intro e ih cell henergy
    by_cases hzero : physicalResidual cell = 0
    · exact ⟨cell, hzero⟩
    · rcases O.lyapunov_descends_nonzero cell hzero with ⟨next, hnext_lt⟩
      exact ih (physicalResidualEnergy next) (by simpa [henergy] using hnext_lt)
        next rfl
  have hmain :
      ∀ cell : SU7PhysicalBranchCell n,
        physicalResidualEnergy cell = physicalResidualEnergy O.startCell ->
          ∃ zeroCell : SU7PhysicalBranchCell n,
            physicalResidual zeroCell = 0 :=
    Nat.strong_induction_on (physicalResidualEnergy O.startCell) hstep
  exact hmain O.startCell rfl

/-- The zero physical cell selected from a well-founded Lyapunov orbit. -/
def physicalZeroCell_of_wellFoundedLyapunovOrbit
    {n : ℕ} (O : SU7WellFoundedPhysicalOrbit n) :
    SU7PhysicalBranchCell n :=
  Classical.choose (exists_zeroCell_of_wellFoundedLyapunovOrbit O)

/-- THEOREM 2: the selected well-founded-descent cell has zero residual. -/
theorem physicalZeroCell_of_wellFoundedLyapunovOrbit_residual_zero
    {n : ℕ} (O : SU7WellFoundedPhysicalOrbit n) :
    physicalResidual (physicalZeroCell_of_wellFoundedLyapunovOrbit O) = 0 :=
  Classical.choose_spec (exists_zeroCell_of_wellFoundedLyapunovOrbit O)

/-! ## Fiberwise well-founded confinement dynamics -/

/-- Well-founded Lyapunov form of SU(7) confinement dynamics.  It supplies one
well-founded descent orbit on each even fiber. -/
structure SU7WellFoundedConfinementDynamics where
  compact_gauge_orbit : SU7CompactGaugeOrbit
  lyapunov_residual_dissipation : SU7LyapunovResidualDissipation
  quantized_spectrum_no_escaping_boundary :
    SU7QuantizedSpectrumNoEscapingBoundary
  orbit :
    ∀ n : ℕ, 2 ≤ n -> SU7WellFoundedPhysicalOrbit n

/-- THEOREM 3: well-founded Lyapunov confinement produces the P873 physical
confinement dynamics.  No atom-code primality law is used here. -/
def confinementDynamics_of_wellFoundedLyapunov
    (D : SU7WellFoundedConfinementDynamics) :
    SU7ConfinementDynamics where
  compact_gauge_orbit := D.compact_gauge_orbit
  lyapunov_residual_dissipation := D.lyapunov_residual_dissipation
  quantized_spectrum_no_escaping_boundary :=
    D.quantized_spectrum_no_escaping_boundary
  physicalZeroCell := fun n hn =>
    physicalZeroCell_of_wellFoundedLyapunovOrbit (D.orbit n hn)
  physicalZeroCell_residual_zero := by
    intro n hn
    exact physicalZeroCell_of_wellFoundedLyapunovOrbit_residual_zero
      (D.orbit n hn)

/-- THEOREM 4: well-founded Lyapunov confinement gives a zero physical cell on
every even fiber. -/
theorem physicalZeroCellEveryEvenFiber_of_wellFoundedLyapunov
    (D : SU7WellFoundedConfinementDynamics) :
    ∀ n : ℕ, 2 ≤ n ->
      ∃ cell : SU7PhysicalBranchCell n, physicalResidual cell = 0 :=
  physicalZeroCellEveryEvenFiber_of_confinementDynamics
    (confinementDynamics_of_wellFoundedLyapunov D)

/-! ## Downstream readouts after the separate atom-code projection -/

/-- THEOREM 5: well-founded Lyapunov confinement plus atom-code prime
projection gives prime-edge trace no-gap. -/
theorem traceSpectrumNoGap_of_wellFoundedLyapunov
    (D : SU7WellFoundedConfinementDynamics)
    (P : SU7AtomCodePrimeProjectionLaw) :
    PrimeEdgeTraceSpectrumNoGap :=
  traceSpectrumNoGap_of_confinementDynamics
    (confinementDynamics_of_wellFoundedLyapunov D) P

/-- THEOREM 6: well-founded Lyapunov confinement plus atom-code prime
projection gives the unit bracket. -/
theorem unitBracketProducer_of_wellFoundedLyapunov
    (D : SU7WellFoundedConfinementDynamics)
    (P : SU7AtomCodePrimeProjectionLaw) :
    ColorLoopTraceUnitBracketProducer :=
  unitBracketProducer_of_confinementDynamics
    (confinementDynamics_of_wellFoundedLyapunov D) P

/-- THEOREM 7: well-founded Lyapunov confinement plus atom-code prime
projection gives ordinary even Goldbach. -/
theorem evenGoldbach_of_wellFoundedLyapunov
    (D : SU7WellFoundedConfinementDynamics)
    (P : SU7AtomCodePrimeProjectionLaw) :
    EvenGoldbachStatement :=
  evenGoldbach_of_confinementDynamics
    (confinementDynamics_of_wellFoundedLyapunov D) P

/-! ## Certificate -/

/-- P875 certificate: zero physical cells are generated by well-founded
Lyapunov descent from a starting cell. -/
structure SU7WellFoundedLyapunovConfinementProducerCertificate where
  descent_reaches_zero :
    ∀ {n : ℕ},
      SU7WellFoundedPhysicalOrbit n ->
      ∃ cell : SU7PhysicalBranchCell n, physicalResidual cell = 0
  orbit_to_confinement :
    SU7WellFoundedConfinementDynamics -> SU7ConfinementDynamics
  well_founded_to_zero_fibers :
    SU7WellFoundedConfinementDynamics ->
      ∀ n : ℕ, 2 ≤ n ->
        ∃ cell : SU7PhysicalBranchCell n, physicalResidual cell = 0
  well_founded_to_no_gap :
    SU7WellFoundedConfinementDynamics ->
      SU7AtomCodePrimeProjectionLaw ->
        PrimeEdgeTraceSpectrumNoGap
  well_founded_to_unit_bracket :
    SU7WellFoundedConfinementDynamics ->
      SU7AtomCodePrimeProjectionLaw ->
        ColorLoopTraceUnitBracketProducer
  well_founded_to_goldbach :
    SU7WellFoundedConfinementDynamics ->
      SU7AtomCodePrimeProjectionLaw ->
        EvenGoldbachStatement

def su7WellFoundedLyapunovConfinementProducerCertificate :
    SU7WellFoundedLyapunovConfinementProducerCertificate where
  descent_reaches_zero := exists_zeroCell_of_wellFoundedLyapunovOrbit
  orbit_to_confinement := confinementDynamics_of_wellFoundedLyapunov
  well_founded_to_zero_fibers :=
    physicalZeroCellEveryEvenFiber_of_wellFoundedLyapunov
  well_founded_to_no_gap := traceSpectrumNoGap_of_wellFoundedLyapunov
  well_founded_to_unit_bracket := unitBracketProducer_of_wellFoundedLyapunov
  well_founded_to_goldbach := evenGoldbach_of_wellFoundedLyapunov


end
end StandardModelConstraint
end SaturationMonoid
