import H0mework.Physics.ConstrainedCauchy.LocalActualLift

/-!
# Exact first-jet readout of the full EC Cauchy connection

The KIN-12 actual is produced by two connection writes.  KIN-10 first writes
the temporal evolution observations.  KIN-11 then consumes that evolved
current and installs a normalized affine connection whose curvature carries
both the retained evolution observations and the newly generated constraint
observations.

Consequently, the raw first jet of the final connection is the derivative of
that last normalized affine field.  It is not a transported copy of
`diracDualFormNativeECCauchyConnectionJet`.  This module exposes the exact
source/current-only readout and proves that its antisymmetrization, together
with the origin bracket, is precisely the curvature target generated by the
KIN-12 composition.

No first jet, curvature, target, residual, equation, branch, or receipt is an
input to any definition below.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeECFullCauchyConnectionJetReadout

open ProofFreeRicherAnholonomicSource
open StageNineDiracDualFormNativeECCauchyConnectionLocalActualLift
open StageNineDiracDualFormNativeECConstraintSurfaceInitialLocalActualLift
open StageNineDiracDualFormNativeECFullCauchyLocalActualLift
open StageNineDiracDualFormNativeSynchronizedECNormalLocalActualLift
open StageNineEnrichedProofFreeSource
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineLorentzConnectionVariation
open StageNinePositiveSourceGravityMouthNormalizedAffineConnectionGerm

noncomputable section

set_option autoImplicit false

/-! ## Generated normalization data -/

/-- Origin connection consumed by the final normalized-affine write.  It is
read from the action-generated KIN-10 current after the computed-`II+`
preparation; it is not a new source coordinate. -/
def sourceActionGeneratedDiracDualECFullCauchyConnectionOrigin
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    PointwiseLorentzSpinConnection :=
  (diracDualFormNativeECNormalPreparedActual
      (diracDualFormNativeECEvolutionWrittenCurrent source current)
    ).gravityConnection 0

/-- Curvature target internally generated by the final constraint write from
the live KIN-10 output.  The public interface still consumes only
`(source,current)`. -/
def sourceActionGeneratedDiracDualECFullCauchyCurvatureTarget
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) : PhysicalBivector :=
  diracDualFormNativeECConstraintSurfaceCurvatureTarget source
    (diracDualFormNativeECEvolutionWrittenCurrent source current)

/-- Exact primitive connection field of the KIN-12 final actual. -/
theorem
    sourceActionGeneratedDiracDualECFullCauchyLocalActualLift_connection_eq_normalizedAffine
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (sourceActionGeneratedDiracDualECFullCauchyLocalActualLift source current
      ).gravityConnection =
      normalizedAffineLorentzConnectionField
        (sourceActionGeneratedDiracDualECFullCauchyConnectionOrigin
          source current)
        (sourceActionGeneratedDiracDualECFullCauchyCurvatureTarget
          source current) := by
  rfl

/-! ## Exact lowered full first jet -/

/-- The complete lowered first jet read from the final primitive connection.
Unlike KIN-10's intermediate jet, all `4 x 4 x 6` coordinates here belong to
the final normalized-affine field. -/
def sourceActionGeneratedDiracDualECFullCauchyLoweredConnectionFirstJet
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (derivativeDirection formDirection : LorentzianIndex)
    (internalPair : Fin 6) : ℝ :=
  minkowskiInternalSign (pairFirst internalPair) *
    gravityConnectionDerivative
      (sourceActionGeneratedDiracDualECFullCauchyLocalActualLift
        source current)
      0 derivativeDirection formDirection
      (pairFirst internalPair) (pairSecond internalPair)

/-- The final lowered jet is exactly the derivative of the generated
normalized-affine bivector one-form.  This is a readout of the final actual,
not a claim that its raw coordinates equal the intermediate KIN-10 jet. -/
theorem
    sourceActionGeneratedDiracDualECFullCauchyLoweredConnectionFirstJet_eq_directionalDerivative
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (derivativeDirection formDirection : LorentzianIndex)
    (internalPair : Fin 6) :
    sourceActionGeneratedDiracDualECFullCauchyLoweredConnectionFirstJet
        source current derivativeDirection formDirection internalPair =
      fieldDirectionalDerivative
        (fun point =>
          normalizedAffineBivectorOneForm
              (sourceActionGeneratedDiracDualECFullCauchyConnectionOrigin
                source current)
              (sourceActionGeneratedDiracDualECFullCauchyCurvatureTarget
                source current)
              point formDirection internalPair)
        0 derivativeDirection := by
  change
    minkowskiInternalSign (pairFirst internalPair) *
        gravityConnectionDerivative
          (normalizedAffineConfiguration
            (sourceActionGeneratedDiracDualECFullCauchyConnectionOrigin
              source current)
            (sourceActionGeneratedDiracDualECFullCauchyCurvatureTarget
              source current))
          0 derivativeDirection formDirection
          (pairFirst internalPair) (pairSecond internalPair) = _
  exact
    normalizedAffineLorentzConnectionField_loweredDerivative_zero
      (sourceActionGeneratedDiracDualECFullCauchyConnectionOrigin
        source current)
      (sourceActionGeneratedDiracDualECFullCauchyCurvatureTarget
        source current)
      derivativeDirection formDirection internalPair

/-- Closed coordinate formula for every entry of the KIN-12 final lowered
first jet. -/
theorem
    sourceActionGeneratedDiracDualECFullCauchyLoweredConnectionFirstJet_eq_sum
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (derivativeDirection formDirection : LorentzianIndex)
    (internalPair : Fin 6) :
    sourceActionGeneratedDiracDualECFullCauchyLoweredConnectionFirstJet
        source current derivativeDirection formDirection internalPair =
      ∑ spacetimePair : Fin 6,
        normalizedDerivativeBivector
            (sourceActionGeneratedDiracDualECFullCauchyConnectionOrigin
              source current)
            (sourceActionGeneratedDiracDualECFullCauchyCurvatureTarget
              source current)
            internalPair spacetimePair *
          orientedLorentzBivectorBasisCoefficient spacetimePair
            derivativeDirection formDirection := by
  rw [
    sourceActionGeneratedDiracDualECFullCauchyLoweredConnectionFirstJet_eq_directionalDerivative,
    normalizedAffineBivectorOneForm_directionalDerivative_zero]

/-! ## Antisymmetric curvature readback -/

/-- Curvature reconstructed from the final lowered first jet and the
quadratic bracket of its generated origin value. -/
def sourceActionGeneratedDiracDualECFullCauchyConnectionJetCurvature
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) : PhysicalBivector :=
  fun internalPair spacetimePair =>
    sourceActionGeneratedDiracDualECFullCauchyLoweredConnectionFirstJet
          source current (pairFirst spacetimePair) (pairSecond spacetimePair)
          internalPair -
      sourceActionGeneratedDiracDualECFullCauchyLoweredConnectionFirstJet
          source current (pairSecond spacetimePair) (pairFirst spacetimePair)
          internalPair +
      originLorentzBracketCurvature
        (sourceActionGeneratedDiracDualECFullCauchyConnectionOrigin
          source current)
        internalPair spacetimePair

/-- Antisymmetrizing the complete final jet closes exactly on the curvature
target generated by the KIN-12 source/current write. -/
theorem
    sourceActionGeneratedDiracDualECFullCauchyConnectionJetCurvature_eq_target
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    sourceActionGeneratedDiracDualECFullCauchyConnectionJetCurvature
        source current =
      sourceActionGeneratedDiracDualECFullCauchyCurvatureTarget
        source current := by
  funext internalPair spacetimePair
  unfold sourceActionGeneratedDiracDualECFullCauchyConnectionJetCurvature
  rw [
    sourceActionGeneratedDiracDualECFullCauchyLoweredConnectionFirstJet_eq_directionalDerivative,
    sourceActionGeneratedDiracDualECFullCauchyLoweredConnectionFirstJet_eq_directionalDerivative,
    normalizedAffineBivectorOneForm_antisymmetrizedDerivative_zero]
  ring

/-- The jet reconstruction is the literal holonomic `d omega + omega wedge
omega` curvature of the same KIN-12 final actual. -/
theorem
    sourceActionGeneratedDiracDualECFullCauchyConnectionJetCurvature_eq_holonomic
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    sourceActionGeneratedDiracDualECFullCauchyConnectionJetCurvature
        source current =
      holonomicGravityCurvature
        (sourceActionGeneratedDiracDualECFullCauchyLocalActualLift
          source current)
        0 := by
  rw [
    sourceActionGeneratedDiracDualECFullCauchyConnectionJetCurvature_eq_target]
  exact
    (sourceActionGeneratedDiracDualECConstraintSurfaceInitialLocalActualLift_curvature_zero
      source (diracDualFormNativeECEvolutionWrittenCurrent source current)).symm

end

end
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeECFullCauchyConnectionJetReadout
