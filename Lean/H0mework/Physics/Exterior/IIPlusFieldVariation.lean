import H0mework.Physics.Source.PhysicalIIPlusNativeVariation
import H0mework.Physics.Holonomic.HolonomicField

/-!
# Dependency-light whole-field variation of `II+`

This module differentiates the actual polynomial field

`x ↦ II+(e(x)) = star_internal (e(x) wedge e(x))`

coordinate by coordinate.  It was extracted from the historical C3h105
source/action module so the current form-native gravity chain can consume the
Fréchet chain rule without importing that historical producer spine.

The declarations retain their existing namespace and names for downstream
compatibility.  They use only a primitive smooth coframe field and the
action-independent native differential `D II+`; no source, action, equation,
stationarity, residual, shell, branch receipt, or fixed actual is consumed.
-/

namespace SaturationMonoid.PhysicsCore.StageNineHolonomicField

open ProofFreeRicherAnholonomicSource
open scoped ContDiff

noncomputable section

set_option autoImplicit false

/-- Fréchet differentiation of a finite product-valued field commutes with
coordinate evaluation.  This is the common whole-field-to-coordinate seam
for actual `II+` jet construction; it carries no equation receipt beyond the
differentiability generated by `fieldSmooth`. -/
theorem fieldDirectionalDerivative_pi_apply
    {I V : Type*} [Fintype I]
    [NormedAddCommGroup V] [NormedSpace ℝ V]
    (field : BasePoint → I → V) (fieldSmooth : ContDiff ℝ ∞ field)
    (point : BasePoint) (direction : LorentzianIndex) (index : I) :
    (fieldDirectionalDerivative field point direction) index =
      fieldDirectionalDerivative (fun candidate => field candidate index)
        point direction := by
  unfold fieldDirectionalDerivative
  have differentiable : DifferentiableAt ℝ field point :=
    (fieldSmooth.differentiable (by simp)).differentiableAt
  have derivativeEquality := fderiv_apply differentiable index
  have applied := congrArg
    (fun derivative : BasePoint →L[ℝ] V =>
      derivative (coordinateDirection direction)) derivativeEquality
  simpa only [ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.proj_apply] using applied.symm

end


end SaturationMonoid.PhysicsCore.StageNineHolonomicField

namespace
  SaturationMonoid.PhysicsCore.StageNineCartanTangentSimplicityResponse

open ProofFreeRicherAnholonomicSource
open StageNineHolonomicField
open scoped ContDiff

noncomputable section

set_option autoImplicit false

/-- Actual directional tangent of a primitive coframe field. -/
def coframeFieldDirectionalTangent
    (coframe : BasePoint → LorentzianCoframe)
    (point : BasePoint)
    (direction : LorentzianIndex) :
    LorentzianCoframe :=
  fun internal coordinate =>
    fieldDirectionalDerivative
      (fun candidate => coframe candidate internal coordinate)
      point direction

/-- Product-rule derivative of the raw coframe wedge on an actual smooth
coframe field. -/
theorem coframeWedge_fieldDirectionalDerivative
    (coframe : BasePoint → LorentzianCoframe)
    (smooth :
      ∀ internal coordinate,
        ContDiff ℝ ∞ fun point => coframe point internal coordinate)
    (point : BasePoint)
    (direction : LorentzianIndex)
    (internalPair spacetimePair : Fin 6) :
    fieldDirectionalDerivative
        (fun candidate =>
          coframeWedge (coframe candidate) internalPair spacetimePair)
        point direction =
      coframeWedgeTangent (coframe point)
          (coframeFieldDirectionalTangent coframe point direction)
        internalPair spacetimePair := by
  let firstInternal := pairFirst internalPair
  let secondInternal := pairSecond internalPair
  let firstSpacetime := pairFirst spacetimePair
  let secondSpacetime := pairSecond spacetimePair
  have firstFirst :
      HasFDerivAt
          (fun candidate =>
            coframe candidate firstInternal firstSpacetime)
          (fderiv ℝ
            (fun candidate =>
              coframe candidate firstInternal firstSpacetime)
            point)
          point :=
    (smooth firstInternal firstSpacetime).differentiable (by simp)
      |>.differentiableAt.hasFDerivAt
  have secondSecond :
      HasFDerivAt
          (fun candidate =>
            coframe candidate secondInternal secondSpacetime)
          (fderiv ℝ
            (fun candidate =>
              coframe candidate secondInternal secondSpacetime)
            point)
          point :=
    (smooth secondInternal secondSpacetime).differentiable (by simp)
      |>.differentiableAt.hasFDerivAt
  have firstSecond :
      HasFDerivAt
          (fun candidate =>
            coframe candidate firstInternal secondSpacetime)
          (fderiv ℝ
            (fun candidate =>
              coframe candidate firstInternal secondSpacetime)
            point)
          point :=
    (smooth firstInternal secondSpacetime).differentiable (by simp)
      |>.differentiableAt.hasFDerivAt
  have secondFirst :
      HasFDerivAt
          (fun candidate =>
            coframe candidate secondInternal firstSpacetime)
          (fderiv ℝ
            (fun candidate =>
              coframe candidate secondInternal firstSpacetime)
            point)
          point :=
    (smooth secondInternal firstSpacetime).differentiable (by simp)
      |>.differentiableAt.hasFDerivAt
  dsimp only [firstInternal, secondInternal, firstSpacetime,
    secondSpacetime] at firstFirst secondSecond firstSecond secondFirst
  unfold fieldDirectionalDerivative coframeWedge
    coframeWedgeTangent coframeFieldDirectionalTangent
  change
    (fderiv ℝ
        (((fun candidate =>
            coframe candidate (pairFirst internalPair)
              (pairFirst spacetimePair)) *
          fun candidate =>
            coframe candidate (pairSecond internalPair)
              (pairSecond spacetimePair)) -
        ((fun candidate =>
            coframe candidate (pairFirst internalPair)
              (pairSecond spacetimePair)) *
          fun candidate =>
            coframe candidate (pairSecond internalPair)
              (pairFirst spacetimePair)))
        point) (coordinateDirection direction) = _
  rw [((firstFirst.mul secondSecond).sub
    (firstSecond.mul secondFirst)).fderiv]
  simp [fieldDirectionalDerivative]
  ring

theorem fieldDirectionalDerivative_neg_of_contDiff
    (field : BasePoint → ℝ)
    (smooth : ContDiff ℝ ∞ field)
    (point : BasePoint)
    (direction : LorentzianIndex) :
    fieldDirectionalDerivative (fun candidate => -field candidate)
        point direction =
      -fieldDirectionalDerivative field point direction := by
  have derivative :
      HasFDerivAt field (fderiv ℝ field point) point :=
    smooth.differentiable (by simp)
      |>.differentiableAt.hasFDerivAt
  unfold fieldDirectionalDerivative
  change
    (fderiv ℝ (-field) point) (coordinateDirection direction) =
      -(fderiv ℝ field point) (coordinateDirection direction)
  rw [derivative.neg.fderiv]
  simp

/-- The actual scalar-coordinate chain rule for `II+(e(x))`. -/
theorem physicalIIPlusBivector_fieldDirectionalDerivative
    (coframe : BasePoint → LorentzianCoframe)
    (smooth :
      ∀ internal coordinate,
        ContDiff ℝ ∞ fun point => coframe point internal coordinate)
    (point : BasePoint)
    (direction : LorentzianIndex)
    (internalPair spacetimePair : Fin 6) :
    fieldDirectionalDerivative
        (fun candidate =>
          physicalIIPlusBivector (coframe candidate)
            internalPair spacetimePair)
        point direction =
      physicalIIPlusCoframeTangent (coframe point)
          (coframeFieldDirectionalTangent coframe point direction)
        internalPair spacetimePair := by
  have wedgeSmooth (pair : Fin 6) :
      ContDiff ℝ ∞ fun candidate =>
        coframeWedge (coframe candidate) pair spacetimePair := by
    unfold coframeWedge
    fun_prop
  fin_cases internalPair
  · simpa [physicalIIPlusBivector, physicalIIPlusCoframeTangent,
      internalBivectorDual, lorentzianCoframeHodge] using
      coframeWedge_fieldDirectionalDerivative coframe smooth point
        direction 3 spacetimePair
  · simpa [physicalIIPlusBivector, physicalIIPlusCoframeTangent,
      internalBivectorDual, lorentzianCoframeHodge] using
      coframeWedge_fieldDirectionalDerivative coframe smooth point
        direction 4 spacetimePair
  · simpa [physicalIIPlusBivector, physicalIIPlusCoframeTangent,
      internalBivectorDual, lorentzianCoframeHodge] using
      coframeWedge_fieldDirectionalDerivative coframe smooth point
        direction 5 spacetimePair
  · change
      fieldDirectionalDerivative
          (fun candidate =>
            -coframeWedge (coframe candidate) 0 spacetimePair)
          point direction =
        -coframeWedgeTangent (coframe point)
          (coframeFieldDirectionalTangent coframe point direction)
          0 spacetimePair
    rw [fieldDirectionalDerivative_neg_of_contDiff _
      (wedgeSmooth 0)]
    rw [coframeWedge_fieldDirectionalDerivative coframe smooth]
  · change
      fieldDirectionalDerivative
          (fun candidate =>
            -coframeWedge (coframe candidate) 1 spacetimePair)
          point direction =
        -coframeWedgeTangent (coframe point)
          (coframeFieldDirectionalTangent coframe point direction)
          1 spacetimePair
    rw [fieldDirectionalDerivative_neg_of_contDiff _
      (wedgeSmooth 1)]
    rw [coframeWedge_fieldDirectionalDerivative coframe smooth]
  · change
      fieldDirectionalDerivative
          (fun candidate =>
            -coframeWedge (coframe candidate) 2 spacetimePair)
          point direction =
        -coframeWedgeTangent (coframe point)
          (coframeFieldDirectionalTangent coframe point direction)
          2 spacetimePair
    rw [fieldDirectionalDerivative_neg_of_contDiff _
      (wedgeSmooth 2)]
    rw [coframeWedge_fieldDirectionalDerivative coframe smooth]

end

end
  SaturationMonoid.PhysicsCore.StageNineCartanTangentSimplicityResponse
