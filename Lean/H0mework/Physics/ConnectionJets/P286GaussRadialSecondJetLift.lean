import H0mework.Physics.Holonomic.P286HolonomicSecondJetCurvatureSymbol
import H0mework.Physics.ActionGeneration.P286GaussJointLocalActualLift

/-!
# P286 Gauss-radial quadratic second-jet lift

Given a Gauss charge and constitutive coupling, this module constructs the
canonical symmetric connection Hessian whose curvature symbol follows the
equal-axis radial auxiliary first jet.

The generic carrier does not accept a residual, branch, or target preimage.
Its scale-uniqueness theorem proves that an exact integration cannot expose a
second physical response coefficient once a nonzero charge and constitutive
coupling have been generated.
-/

namespace SaturationMonoid.PhysicsCore.StageNineP286GaussRadialSecondJetLift

open ProofFreeRicherAnholonomicSource
open StageNineEnrichedProofFreeSource
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineP286ActionCauchySplit
open StageNineP286GaugeAuxiliaryVariation
open StageNineP286GaugeConnectionVariation
open StageNineP286HolonomicSecondJetCarrier
open StageNineP286HolonomicSecondJetCurvatureSymbol
open StageNineP286SourceAffineCurvatureJetNormalForm
open StageNineResidualLimitCoframeBalanceDecision
open StageNineSourceActionGeneratedP286GaussJointLocalActualLift
open StageNineSourceActionGeneratedP286MomentumJointLocalActualLift
open StageNineSourceGeneratedP286AffineConnectionGerm
open SU7MotherLieAlgebra

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 2400000
set_option maxRecDepth 100000
set_option synthInstance.maxHeartbeats 200000

local instance p286ModuleFinite : Module.Finite ℝ P286LieBlockData :=
  FiniteDimensional.of_injective p286AmbientLinear
    p286AmbientLinear_injective

local instance p286CoordinateIndexFintype : Fintype P286CoordinateIndex :=
  Fintype.ofFinite P286CoordinateIndex

local instance p286CoordinateIsTopologicalAddGroup :
    IsTopologicalAddGroup P286CoordinateCarrier where
  toContinuousAdd := inferInstance
  toContinuousNeg := inferInstance

/-! ## The auxiliary first jet that owns the response -/

/-- The continuous linear first jet of the already generated radial auxiliary
profile.  Its `1/3` is the fixed equal-axis Gauss normalization. -/
def p286GaussRadialAuxiliaryFirstJetLinear
    (charge : P286CoordinateCarrier) :
    BasePoint →L[ℝ] P286GaugeTwoForm :=
  ∑ axis : Fin 3,
    (1 / 3 : ℝ) •
      (p286BaseCoordinate axis.succ).smulRight
        (p286GaussAuxiliaryAxisEmbedding charge axis)

theorem p286GaussRadialAuxiliaryProfile_eq_firstJetLinear
    (charge : P286CoordinateCarrier) :
    p286GaussRadialAuxiliaryProfile charge =
      p286GaussRadialAuxiliaryFirstJetLinear charge := by
  funext point
  unfold p286GaussRadialAuxiliaryProfile
    p286GaussRadialAuxiliaryFirstJetLinear
  change
    (∑ axis : Fin 3,
      ((1 / 3 : ℝ) * point axis.succ) •
        p286GaussAuxiliaryAxisEmbedding charge axis) =
      ∑ axis : Fin 3,
        (1 / 3 : ℝ) •
          (point axis.succ •
            p286GaussAuxiliaryAxisEmbedding charge axis)
  apply Finset.sum_congr rfl
  intro axis _
  module

theorem p286GaussRadialAuxiliaryProfile_directionalDerivative
    (charge : P286CoordinateCarrier) (point : BasePoint)
    (direction : LorentzianIndex) :
    fieldDirectionalDerivative
        (p286GaussRadialAuxiliaryProfile charge) point direction =
      p286GaussRadialAuxiliaryFirstJetLinear charge
        (coordinateDirection direction) := by
  unfold fieldDirectionalDerivative
  rw [p286GaussRadialAuxiliaryProfile_eq_firstJetLinear]
  rw [(p286GaussRadialAuxiliaryFirstJetLinear charge).hasFDerivAt.fderiv]

theorem p286GaussRadialAuxiliaryProfile_spatialFirstJet
    (charge : P286CoordinateCarrier) (axis : Fin 3) :
    fieldDirectionalDerivative
        (p286GaussRadialAuxiliaryProfile charge) 0 axis.succ =
      (1 / 3 : ℝ) • p286GaussAuxiliaryAxisEmbedding charge axis := by
  rw [p286GaussRadialAuxiliaryProfile_directionalDerivative]
  fin_cases axis <;>
    simp [p286GaussRadialAuxiliaryFirstJetLinear,
      coordinateDirection, p286BaseCoordinate_apply, Fin.sum_univ_three]

/-! ## Canonical temporal-gauge Hessian generated by that first jet -/

/-- The diagonal spatial Hessian whose temporal connection component is the
canonical primitive of the radial Gauss slope.  The coefficient is forced:
the Hodge/coupling target contributes `g²/3`, while the exterior derivative
of the temporal component contributes a minus sign. -/
def p286GaussRadialActionSecondJetAmbient
    (couplingSquared : ℝ) (charge : P286CoordinateCarrier) :
    P286ConnectionSecondJetAmbient :=
  (-(couplingSquared / 3) : ℝ) •
    ∑ axis : Fin 3,
      (p286BaseCoordinate axis.succ).smulRight
        ((p286BaseCoordinate axis.succ).smulRight
          (p286TemporalGaugeOneForm charge))

theorem p286GaussRadialActionSecondJetAmbient_symmetric
    (couplingSquared : ℝ) (charge : P286CoordinateCarrier)
    (first second : BasePoint) :
    p286GaussRadialActionSecondJetAmbient couplingSquared charge first second =
      p286GaussRadialActionSecondJetAmbient couplingSquared charge second first := by
  unfold p286GaussRadialActionSecondJetAmbient
  change
    (-(couplingSquared / 3) : ℝ) •
        (∑ axis : Fin 3,
          first axis.succ •
            (second axis.succ • p286TemporalGaugeOneForm charge)) =
      (-(couplingSquared / 3) : ℝ) •
        (∑ axis : Fin 3,
          second axis.succ •
            (first axis.succ • p286TemporalGaugeOneForm charge))
  apply congrArg (fun value : P286GaugeOneForm =>
    (-(couplingSquared / 3) : ℝ) • value)
  apply Finset.sum_congr rfl
  intro axis _
  module

def p286GaussRadialActionSecondJet
    (couplingSquared : ℝ) (charge : P286CoordinateCarrier) :
    P286HolonomicConnectionSecondJet :=
  ⟨p286GaussRadialActionSecondJetAmbient couplingSquared charge,
    p286GaussRadialActionSecondJetAmbient_symmetric couplingSquared charge⟩

/-- The canonical realization exposes the forced `-g²/6` primitive. -/
theorem p286GaussRadialActionSecondJet_realization_normalForm
    (couplingSquared : ℝ) (charge : P286CoordinateCarrier)
    (point : BasePoint) :
    p286HolonomicSecondJetQuadraticRealization
        (p286GaussRadialActionSecondJet couplingSquared charge) point =
      ∑ axis : Fin 3,
        (-(couplingSquared / 6) * (point axis.succ) ^ 2 : ℝ) •
          p286TemporalGaugeOneForm charge := by
  rw [p286HolonomicSecondJetQuadraticRealization_apply]
  unfold p286GaussRadialActionSecondJet
    p286GaussRadialActionSecondJetAmbient
  change
    (1 / 2 : ℝ) •
        ((-(couplingSquared / 3) : ℝ) •
          ∑ axis : Fin 3,
            point axis.succ •
              (point axis.succ • p286TemporalGaugeOneForm charge)) =
      ∑ axis : Fin 3,
        (-(couplingSquared / 6) * (point axis.succ) ^ 2 : ℝ) •
          p286TemporalGaugeOneForm charge
  rw [Finset.smul_sum, Finset.smul_sum]
  apply Finset.sum_congr rfl
  intro axis _
  module

/-- The action-selected Hessian produces exactly the constitutive image of
the action-generated radial auxiliary first jet, in every spatial direction.
This is the local auxiliary-equation acceptance proved by this probe. -/
theorem p286GaussRadialActionSecondJet_curvatureSymbol_eq_auxiliaryFirstJet
    (couplingSquared : ℝ) (charge : P286CoordinateCarrier)
    (axis : Fin 3) :
    p286HolonomicSecondJetCurvatureSymbol
        (p286GaussRadialActionSecondJet couplingSquared charge) axis.succ =
      liftGaugeTwoFormOperator
        (couplingSquared • coframeGaugeSpacetimeHodgeLinear 1)
        (fieldDirectionalDerivative
          (p286GaussRadialAuxiliaryProfile charge) 0 axis.succ) := by
  rw [p286GaussRadialAuxiliaryProfile_spatialFirstJet,
    liftGaugeTwoFormOperator_smul_operator_p286,
    liftGaugeTwoFormOperator_smul_p286,
    coframeGaugeSpacetimeHodgeLinear_one]
  rw [show
    EmpiricalReferenceScaleCouplingBoundary.lorentzianCoframeHodgeEquiv.toLinearMap =
      lorentzianCoframeHodge by rfl]
  funext pair
  simp only [Pi.smul_apply]
  rw [StageNineP286SourceAffineCurvatureJetNormalForm.liftGaugeTwoFormOperator_fixedHodge_apply_local]
  fin_cases axis <;> fin_cases pair <;>
    simp [p286GaussRadialActionSecondJet,
      p286GaussRadialActionSecondJetAmbient,
      p286HolonomicSecondJetCurvatureSymbol,
      p286HolonomicSecondJetOrderedCurvatureSymbol,
      p286GaussAuxiliaryAxisEmbedding,
      p286SpatialAuxiliaryVelocityEmbedding,
      p286TemporalGaugeOneForm,
      ContinuousLinearMap.smulRight_apply,
      p286BaseCoordinate_apply, coordinateDirection,
      canonicalLorentzianTimeDirection,
      pairFirst, pairSecond, Fin.sum_univ_three] <;>
    module

/-- The radial sector carries no physical-time curvature slope. -/
theorem p286GaussRadialActionSecondJet_curvatureSymbol_time
    (couplingSquared : ℝ) (charge : P286CoordinateCarrier) :
    p286HolonomicSecondJetCurvatureSymbol
        (p286GaussRadialActionSecondJet couplingSquared charge)
        canonicalLorentzianTimeDirection = 0 := by
  funext pair
  fin_cases pair <;>
    simp [p286GaussRadialActionSecondJet,
      p286GaussRadialActionSecondJetAmbient,
      p286HolonomicSecondJetCurvatureSymbol,
      p286HolonomicSecondJetOrderedCurvatureSymbol,
      ContinuousLinearMap.smulRight_apply,
      p286BaseCoordinate_apply, coordinateDirection,
      canonicalLorentzianTimeDirection,
      pairFirst, pairSecond, Fin.sum_univ_three]

/-- Inside the canonical temporal/diagonal response family, no coefficient is
free: matching one nonzero Gauss charge to the action-owned first jet forces
the response scale to be the constitutive coupling. -/
theorem p286GaussRadialActionSecondJet_responseScale_unique
    {candidateScale couplingSquared : ℝ}
    {charge : P286CoordinateCarrier} (charge_ne_zero : charge ≠ 0)
    (response :
      p286HolonomicSecondJetCurvatureSymbol
          (p286GaussRadialActionSecondJet candidateScale charge) 1 0 =
        liftGaugeTwoFormOperator
          (couplingSquared • coframeGaugeSpacetimeHodgeLinear 1)
          ((1 / 3 : ℝ) • p286GaussAuxiliaryAxisEmbedding charge 0) 0) :
    candidateScale = couplingSquared := by
  have generatedResponse :=
    congrFun
      (p286GaussRadialActionSecondJet_curvatureSymbol_eq_auxiliaryFirstJet
        candidateScale charge 0) 0
  rw [p286GaussRadialAuxiliaryProfile_spatialFirstJet] at generatedResponse
  have generatedResponse' :
      p286HolonomicSecondJetCurvatureSymbol
          (p286GaussRadialActionSecondJet candidateScale charge) 1 0 =
        liftGaugeTwoFormOperator
          (candidateScale • coframeGaugeSpacetimeHodgeLinear 1)
          ((1 / 3 : ℝ) • p286GaussAuxiliaryAxisEmbedding charge 0) 0 := by
    simpa using generatedResponse
  have responseScaled :
      (candidateScale / 3 : ℝ) • charge =
        (couplingSquared / 3 : ℝ) • charge := by
    rw [generatedResponse'] at response
    simp only [liftGaugeTwoFormOperator_smul_operator_p286,
      liftGaugeTwoFormOperator_smul_p286,
      coframeGaugeSpacetimeHodgeLinear_one] at response
    have hodgeEq :
      EmpiricalReferenceScaleCouplingBoundary.lorentzianCoframeHodgeEquiv.toLinearMap =
        lorentzianCoframeHodge := rfl
    simp only [hodgeEq] at response
    simp only [Pi.smul_apply] at response
    simp_rw [StageNineP286SourceAffineCurvatureJetNormalForm.liftGaugeTwoFormOperator_fixedHodge_apply_local]
      at response
    simpa [p286GaussAuxiliaryAxisEmbedding,
      p286SpatialAuxiliaryVelocityEmbedding, div_eq_mul_inv,
      mul_comm, smul_smul] using response
  have responseDifference :
      ((candidateScale - couplingSquared) / 3 : ℝ) • charge = 0 := by
    calc
      ((candidateScale - couplingSquared) / 3 : ℝ) • charge =
          (candidateScale / 3 : ℝ) • charge -
            (couplingSquared / 3 : ℝ) • charge := by module
      _ = 0 := sub_eq_zero.mpr responseScaled
  have coefficientZero : (candidateScale - couplingSquared) / 3 = 0 :=
    (smul_eq_zero.mp responseDifference).resolve_right charge_ne_zero
  linarith

end

end SaturationMonoid.PhysicsCore.StageNineP286GaussRadialSecondJetLift
