import H0mework.Physics.Holonomic.P286HolonomicSecondJetCurvatureSymbol
import H0mework.Physics.GaugeAction.P286ActionCanonicalPairUpdate
import H0mework.Physics.ActionGeneration.P286MomentumJointLocalActualLift

/-!
# P286 temporal-velocity second-jet lift

Given a spatial auxiliary velocity `V` and a constitutive coupling, this
module constructs the corresponding primitive-connection Hessian.  Its only
nonzero base Hessian slot is `(time,time)`, with the existing canonical
spatial one-form as value.

Consequently its curvature-symbol time derivative is exactly the
identity-coframe constitutive image of the auxiliary velocity, while every
spatial curvature derivative vanishes.  The construction consumes neither a
residual nor a target/preimage certificate and introduces no selectable
coefficient or branch.
-/

namespace SaturationMonoid.PhysicsCore.StageNineP286TemporalVelocitySecondJetLift

open ProofFreeRicherAnholonomicSource
open EmpiricalReferenceScaleCouplingBoundary
open StageNineBlockwiseConstitutive
open StageNineEnrichedProofFreeSource
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineP286ActionCanonicalPairUpdate
open StageNineP286ActionCauchySplit
open StageNineP286GaugeAuxiliaryVariation
open StageNineP286GaugeConnectionVariation
open StageNineP286HolonomicSecondJetCarrier
open StageNineP286HolonomicSecondJetCurvatureSymbol
open StageNineP286SourceAffineCurvatureJetNormalForm
open StageNineResidualLimitCoframeBalanceDecision
open StageNineSourceActionGeneratedP286MomentumJointLocalActualLift
open StageNineSourceGeneratedP286AffineConnectionGerm
open SU7MotherLieAlgebra

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 2400000

local instance p286ModuleFinite : Module.Finite ℝ P286LieBlockData :=
  FiniteDimensional.of_injective p286AmbientLinear
    p286AmbientLinear_injective

local instance p286CoordinateIndexFintype : Fintype P286CoordinateIndex :=
  Fintype.ofFinite P286CoordinateIndex

local instance p286CoordinateIsTopologicalAddGroup :
    IsTopologicalAddGroup P286CoordinateCarrier where
  toContinuousAdd := inferInstance
  toContinuousNeg := inferInstance

@[simp] private theorem canonicalP286SpatialGaugeOneForm_one
    (velocity : P286SpatialGaugeDirection) :
    canonicalP286SpatialGaugeOneForm velocity 1 = velocity 0 :=
  canonicalP286SpatialGaugeOneForm_spatial velocity 0

@[simp] private theorem canonicalP286SpatialGaugeOneForm_two
    (velocity : P286SpatialGaugeDirection) :
    canonicalP286SpatialGaugeOneForm velocity 2 = velocity 1 :=
  canonicalP286SpatialGaugeOneForm_spatial velocity 1

@[simp] private theorem canonicalP286SpatialGaugeOneForm_three
    (velocity : P286SpatialGaugeDirection) :
    canonicalP286SpatialGaugeOneForm velocity 3 = velocity 2 :=
  canonicalP286SpatialGaugeOneForm_spatial velocity 2

/-! ## The forced temporal Hessian -/

/-- The raw Hessian selected by the action-generated auxiliary time velocity.
The source coupling is its constitutive coefficient; there is no additional
response scale. -/
def p286TemporalVelocityActionSecondJetAmbient
    (couplingSquared : ℝ) (velocity : P286SpatialGaugeDirection) :
    P286ConnectionSecondJetAmbient :=
  couplingSquared •
    (p286BaseCoordinate canonicalLorentzianTimeDirection).smulRight
      ((p286BaseCoordinate canonicalLorentzianTimeDirection).smulRight
        (canonicalP286SpatialGaugeOneForm velocity))

theorem p286TemporalVelocityActionSecondJetAmbient_symmetric
    (couplingSquared : ℝ) (velocity : P286SpatialGaugeDirection)
    (first second : BasePoint) :
    p286TemporalVelocityActionSecondJetAmbient couplingSquared velocity
        first second =
      p286TemporalVelocityActionSecondJetAmbient couplingSquared velocity
        second first := by
  unfold p286TemporalVelocityActionSecondJetAmbient
  change
    couplingSquared •
        (first canonicalLorentzianTimeDirection •
          (second canonicalLorentzianTimeDirection •
            canonicalP286SpatialGaugeOneForm velocity)) =
      couplingSquared •
        (second canonicalLorentzianTimeDirection •
          (first canonicalLorentzianTimeDirection •
            canonicalP286SpatialGaugeOneForm velocity))
  module

/-- Holonomic primitive-connection second jet generated by `V` and `g²`. -/
def p286TemporalVelocityActionSecondJet
    (couplingSquared : ℝ) (velocity : P286SpatialGaugeDirection) :
    P286HolonomicConnectionSecondJet :=
  ⟨p286TemporalVelocityActionSecondJetAmbient couplingSquared velocity,
    p286TemporalVelocityActionSecondJetAmbient_symmetric
      couplingSquared velocity⟩

/-! ## Exact constitutive response -/

/-- The temporal curvature first jet is exactly the constitutive image of the
already generated spatial auxiliary velocity. -/
theorem p286TemporalVelocityActionSecondJet_curvatureSymbol_time
    (couplingSquared : ℝ) (velocity : P286SpatialGaugeDirection) :
    p286HolonomicSecondJetCurvatureSymbol
        (p286TemporalVelocityActionSecondJet couplingSquared velocity)
        canonicalLorentzianTimeDirection =
      liftGaugeTwoFormOperator
        (couplingSquared • coframeGaugeSpacetimeHodgeLinear 1)
        (p286SpatialAuxiliaryVelocityEmbedding velocity) := by
  rw [liftGaugeTwoFormOperator_smul_operator_p286,
    coframeGaugeSpacetimeHodgeLinear_one]
  rw [show
    lorentzianCoframeHodgeEquiv.toLinearMap =
      lorentzianCoframeHodge by rfl]
  funext pair
  change
    p286HolonomicSecondJetCurvatureSymbol
        (p286TemporalVelocityActionSecondJet couplingSquared velocity)
        canonicalLorentzianTimeDirection pair =
      couplingSquared •
        liftGaugeTwoFormOperator lorentzianCoframeHodge
          (p286SpatialAuxiliaryVelocityEmbedding velocity) pair
  rw [StageNineP286SourceAffineCurvatureJetNormalForm.liftGaugeTwoFormOperator_fixedHodge_apply_local]
  fin_cases pair <;>
    simp [p286TemporalVelocityActionSecondJet,
      p286TemporalVelocityActionSecondJetAmbient,
      p286HolonomicSecondJetCurvatureSymbol,
      p286HolonomicSecondJetOrderedCurvatureSymbol,
      p286SpatialAuxiliaryVelocityEmbedding,
      ContinuousLinearMap.smulRight_apply,
      p286BaseCoordinate_apply, coordinateDirection,
      canonicalLorentzianTimeDirection, pairFirst, pairSecond]

/-- This sector adds no spatial curvature derivative, so it can be summed
with the independent Gauss-radial second jet without cross-contamination. -/
theorem p286TemporalVelocityActionSecondJet_curvatureSymbol_spatial
    (couplingSquared : ℝ) (velocity : P286SpatialGaugeDirection)
    (axis : Fin 3) :
    p286HolonomicSecondJetCurvatureSymbol
        (p286TemporalVelocityActionSecondJet couplingSquared velocity)
        axis.succ = 0 := by
  funext pair
  fin_cases axis <;> fin_cases pair <;>
    simp [p286TemporalVelocityActionSecondJet,
      p286TemporalVelocityActionSecondJetAmbient,
      p286HolonomicSecondJetCurvatureSymbol,
      p286HolonomicSecondJetOrderedCurvatureSymbol,
      ContinuousLinearMap.smulRight_apply,
      p286BaseCoordinate_apply, coordinateDirection,
      canonicalLorentzianTimeDirection, pairFirst, pairSecond]

/-- Linear composition seam with any independently generated second-jet
sector, in particular the Gauss-radial jet. -/
theorem p286TemporalVelocityActionSecondJet_add_curvatureSymbol_time
    (couplingSquared : ℝ) (velocity : P286SpatialGaugeDirection)
    (other : P286HolonomicConnectionSecondJet) :
    p286HolonomicSecondJetCurvatureSymbol
        (p286TemporalVelocityActionSecondJet couplingSquared velocity + other)
        canonicalLorentzianTimeDirection =
      liftGaugeTwoFormOperator
          (couplingSquared • coframeGaugeSpacetimeHodgeLinear 1)
          (p286SpatialAuxiliaryVelocityEmbedding velocity) +
        p286HolonomicSecondJetCurvatureSymbol other
          canonicalLorentzianTimeDirection := by
  rw [map_add]
  simp only [Pi.add_apply]
  rw [p286TemporalVelocityActionSecondJet_curvatureSymbol_time]

theorem p286TemporalVelocityActionSecondJet_add_curvatureSymbol_spatial
    (couplingSquared : ℝ) (velocity : P286SpatialGaugeDirection)
    (other : P286HolonomicConnectionSecondJet) (axis : Fin 3) :
    p286HolonomicSecondJetCurvatureSymbol
        (p286TemporalVelocityActionSecondJet couplingSquared velocity + other)
        axis.succ =
      p286HolonomicSecondJetCurvatureSymbol other axis.succ := by
  rw [map_add]
  simp only [Pi.add_apply]
  rw [p286TemporalVelocityActionSecondJet_curvatureSymbol_spatial,
    zero_add]

end

end SaturationMonoid.PhysicsCore.StageNineP286TemporalVelocitySecondJetLift
