set_option maxHeartbeats 1800000

local instance p286ModuleFinite : Module.Finite ℝ P286LieBlockData :=
  FiniteDimensional.of_injective p286AmbientLinear
    p286AmbientLinear_injective

local instance p286CoordinateIndexFintype : Fintype P286CoordinateIndex :=
  Fintype.ofFinite P286CoordinateIndex

local instance p286CoordinateIsTopologicalAddGroup :
    IsTopologicalAddGroup P286CoordinateCarrier where
  toContinuousAdd := inferInstance
  toContinuousNeg := inferInstance

/-! ## Synchronized installation over the current residual seed -/

/-- Primitive-connection representative underlying the deterministic C3h78
repair.  The auxiliary is deliberately not carried through this mouth; it is
recomputed after the new Hessian is installed. -/
def colorCartanResidualRepairKinematic : StageNineHolonomicConfiguration :=
  colorCartanQuadraticKinematic
    colorCartanQuadraticResidualDerivedCoefficient

theorem colorCartanQuadraticResidualRepair_eq_synchronizedKinematic :
    colorCartanQuadraticResidualRepair =
      synchronizeP286ConstitutiveAuxiliary
        colorCartanResidualRepairKinematic :=
  rfl

/-- Install one existing-field Hessian over the deterministic C3h78 repair,
then recompute the derived P286 auxiliary from the varied actual curvature. -/
def colorCartanRepairSecondJetConstitutiveResponse
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ) :
    StageNineHolonomicConfiguration :=
  synchronizeP286ConstitutiveAuxiliary
    (installP286HolonomicConnectionSecondJet
      colorCartanResidualRepairKinematic jet parameter)

@[simp] theorem colorCartanRepairSecondJetConstitutiveResponse_coframe
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ) :
    (colorCartanRepairSecondJetConstitutiveResponse jet parameter).coframe =
      colorCartanQuadraticResidualRepair.coframe :=
  rfl

@[simp] theorem colorCartanRepairSecondJetConstitutiveResponse_gaugeConnection
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ) :
    (colorCartanRepairSecondJetConstitutiveResponse jet
        parameter).gaugeConnection =
      (installP286HolonomicConnectionSecondJet
        colorCartanResidualRepairKinematic jet parameter).gaugeConnection :=
  rfl

theorem colorCartanRepairSecondJetConstitutiveResponse_nondegenerate
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ) :
    (colorCartanRepairSecondJetConstitutiveResponse jet
      parameter).Nondegenerate := by
  intro point
  change Matrix.det (colorCartanQuadraticResidualRepair.coframe point) ≠ 0
  exact colorCartanQuadraticResidualRepair_nondegenerate point

theorem colorCartanRepairSecondJetConstitutiveResponse_smooth
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ) :
    (colorCartanRepairSecondJetConstitutiveResponse jet parameter).Smooth := by
  apply synchronizeP286ConstitutiveAuxiliary_smooth
  · exact installP286HolonomicConnectionSecondJet_smooth
      colorCartanResidualRepairKinematic
      (colorCartanQuadraticKinematic_smooth
        colorCartanQuadraticResidualDerivedCoefficient)
      jet parameter
  · intro point
    change Matrix.det (colorCartanQuadraticResidualRepair.coframe point) ≠ 0
    exact colorCartanQuadraticResidualRepair_nondegenerate point

theorem colorCartanRepairSecondJetConstitutiveResponse_auxiliaryEquation
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ)
    (point : BasePoint) :
    holonomicP286GaugeAuxiliaryEquationResidual positiveSmoothUnifiedSource
        (colorCartanRepairSecondJetConstitutiveResponse jet parameter) point =
      0 :=
  synchronizeP286ConstitutiveAuxiliary_solves
    (installP286HolonomicConnectionSecondJet
      colorCartanResidualRepairKinematic jet parameter)
    (by
      intro basePoint
      change Matrix.det
        (colorCartanQuadraticResidualRepair.coframe basePoint) ≠ 0
      exact colorCartanQuadraticResidualRepair_nondegenerate basePoint)
    point

theorem colorCartanRepairSecondJetConstitutiveResponse_connection_origin
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ) :
    holonomicP286GaugeConnectionCoordinate
        (colorCartanRepairSecondJetConstitutiveResponse jet parameter) 0 =
      holonomicP286GaugeConnectionCoordinate
        colorCartanQuadraticResidualRepair 0 := by
  calc
    holonomicP286GaugeConnectionCoordinate
        (colorCartanRepairSecondJetConstitutiveResponse jet parameter) 0 =
        holonomicP286GaugeConnectionCoordinate
          (installP286HolonomicConnectionSecondJet
            colorCartanResidualRepairKinematic jet parameter) 0 := by
      funext direction
      change p286CoordinateEquiv
          ((colorCartanRepairSecondJetConstitutiveResponse jet
            parameter).gaugeConnection 0 direction) =
        p286CoordinateEquiv
          ((installP286HolonomicConnectionSecondJet
            colorCartanResidualRepairKinematic jet parameter).gaugeConnection
              0 direction)
      rw [colorCartanRepairSecondJetConstitutiveResponse_gaugeConnection]
    _ = holonomicP286GaugeConnectionCoordinate
          colorCartanResidualRepairKinematic 0 :=
      installP286HolonomicConnectionSecondJet_connection_origin
        colorCartanResidualRepairKinematic jet parameter
    _ = holonomicP286GaugeConnectionCoordinate
          colorCartanQuadraticResidualRepair 0 := by
      rw [colorCartanQuadraticResidualRepair_eq_synchronizedKinematic]
      funext direction
      change p286CoordinateEquiv
          (colorCartanResidualRepairKinematic.gaugeConnection 0 direction) =
        p286CoordinateEquiv
          ((synchronizeP286ConstitutiveAuxiliary
            colorCartanResidualRepairKinematic).gaugeConnection 0 direction)
      rw [synchronizeP286ConstitutiveAuxiliary_gaugeConnection]

theorem colorCartanRepairSecondJetConstitutiveResponse_curvature_origin
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ) :
    holonomicP286GaugeCurvatureCoordinate
        (colorCartanRepairSecondJetConstitutiveResponse jet parameter) 0 =
      holonomicP286GaugeCurvatureCoordinate
        colorCartanQuadraticResidualRepair 0 := by
  calc
    holonomicP286GaugeCurvatureCoordinate
        (colorCartanRepairSecondJetConstitutiveResponse jet parameter) 0 =
        holonomicP286GaugeCurvatureCoordinate
          (installP286HolonomicConnectionSecondJet
            colorCartanResidualRepairKinematic jet parameter) 0 := by
      funext pair
      exact congrArg p286CoordinateEquiv
        (congrFun
          (synchronizeP286ConstitutiveAuxiliary_curvature
            (installP286HolonomicConnectionSecondJet
              colorCartanResidualRepairKinematic jet parameter) 0)
          pair)
    _ = holonomicP286GaugeCurvatureCoordinate
          colorCartanResidualRepairKinematic 0 :=
      installP286HolonomicConnectionSecondJet_curvature_origin
        colorCartanResidualRepairKinematic
        (colorCartanQuadraticKinematic_smooth
          colorCartanQuadraticResidualDerivedCoefficient)
        jet parameter
    _ = holonomicP286GaugeCurvatureCoordinate
          colorCartanQuadraticResidualRepair 0 := by
      rw [colorCartanQuadraticResidualRepair_eq_synchronizedKinematic]
      funext pair
      exact congrArg p286CoordinateEquiv
        (congrFun
          (synchronizeP286ConstitutiveAuxiliary_curvature
            colorCartanResidualRepairKinematic 0).symm
          pair)

theorem colorCartanRepairSecondJetConstitutiveResponse_gaugeConnection_origin
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ) :
    (colorCartanRepairSecondJetConstitutiveResponse jet
        parameter).gaugeConnection 0 =
      colorCartanQuadraticResidualRepair.gaugeConnection 0 := by
  funext direction
  apply p286CoordinateEquiv.injective
  exact congrFun
    (colorCartanRepairSecondJetConstitutiveResponse_connection_origin jet
      parameter)
    direction

theorem colorCartanRepairSecondJetConstitutiveResponse_curvature_origin_raw
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ) :
    holonomicGaugeCurvature
        (colorCartanRepairSecondJetConstitutiveResponse jet parameter) 0 =
      holonomicGaugeCurvature colorCartanQuadraticResidualRepair 0 := by
  funext pair
  apply p286CoordinateEquiv.injective
  exact congrFun
    (colorCartanRepairSecondJetConstitutiveResponse_curvature_origin jet
      parameter)
    pair

theorem colorCartanRepairSecondJetConstitutiveResponse_auxiliary_origin
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ) :
    (colorCartanRepairSecondJetConstitutiveResponse jet
        parameter).gaugeAuxiliary 0 =
      colorCartanQuadraticResidualRepair.gaugeAuxiliary 0 := by
  rw [colorCartanQuadraticResidualRepair_eq_synchronizedKinematic]
  funext pair
  apply p286CoordinateEquiv.injective
  simp only [colorCartanRepairSecondJetConstitutiveResponse,
    synchronizeP286ConstitutiveAuxiliary_gaugeAuxiliary,
    generatedP286GaugeConstitutiveAuxiliary,
    p286CoordinateEquiv.apply_symm_apply]
  change
    p286GaugeConstitutiveAuxiliaryCoordinate positiveSmoothUnifiedSource
        (colorCartanResidualRepairKinematic.coframe 0)
        (holonomicP286GaugeCurvatureCoordinate
          (installP286HolonomicConnectionSecondJet
            colorCartanResidualRepairKinematic jet parameter) 0) pair =
      p286GaugeConstitutiveAuxiliaryCoordinate positiveSmoothUnifiedSource
        (colorCartanResidualRepairKinematic.coframe 0)
        (holonomicP286GaugeCurvatureCoordinate
          colorCartanResidualRepairKinematic 0) pair
  rw [installP286HolonomicConnectionSecondJet_curvature_origin
    colorCartanResidualRepairKinematic
    (colorCartanQuadraticKinematic_smooth
      colorCartanQuadraticResidualDerivedCoefficient)
    jet parameter]

theorem colorCartanRepairSecondJetConstitutiveResponse_pointField_origin
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ) :
    toContinuumPointField
        (colorCartanRepairSecondJetConstitutiveResponse jet parameter) 0 =
      toContinuumPointField colorCartanQuadraticResidualRepair 0 := by
  apply StageNineContinuumPointField.ext
  · rfl
  · rfl
  · rfl
  · rfl
  · exact
      colorCartanRepairSecondJetConstitutiveResponse_curvature_origin_raw jet
        parameter
  · exact
      colorCartanRepairSecondJetConstitutiveResponse_auxiliary_origin jet
        parameter
  · rfl
  · funext direction
    change holonomicScalarCovariantDerivative
        (colorCartanRepairSecondJetConstitutiveResponse jet parameter) 0
          direction =
      holonomicScalarCovariantDerivative colorCartanQuadraticResidualRepair 0
        direction
    unfold holonomicScalarCovariantDerivative
    rw [colorCartanRepairSecondJetConstitutiveResponse_gaugeConnection_origin]
    rfl
  · rfl
  · funext direction
    change holonomicMatterCovariantDerivative
        (colorCartanRepairSecondJetConstitutiveResponse jet parameter) 0
          direction =
      holonomicMatterCovariantDerivative colorCartanQuadraticResidualRepair 0
        direction
    unfold holonomicMatterCovariantDerivative
    rw [colorCartanRepairSecondJetConstitutiveResponse_gaugeConnection_origin]
    rfl
  · rfl

theorem
    colorCartanRepairSecondJetConstitutiveResponse_algebraicCurrent_origin
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ)
    (direction : P286GaugeOneForm) :
    p286GaugeConnectionAlgebraicCurrentCoefficient
        positiveSmoothUnifiedSource
        (colorCartanRepairSecondJetConstitutiveResponse jet parameter)
        direction 0 =
      p286GaugeConnectionAlgebraicCurrentCoefficient
        positiveSmoothUnifiedSource colorCartanQuadraticResidualRepair
        direction 0 := by
  have algebraicDirectionEquality :
      p286GaugeConnectionAlgebraicCurvatureDirection
          (colorCartanRepairSecondJetConstitutiveResponse jet parameter)
          direction 0 =
        p286GaugeConnectionAlgebraicCurvatureDirection
          colorCartanQuadraticResidualRepair direction 0 := by
    funext pair
    unfold p286GaugeConnectionAlgebraicCurvatureDirection
      p286GaugeConnectionAlgebraicCurvatureVariation
      holonomicP286GaugeConnectionCoordinate
    rw [colorCartanRepairSecondJetConstitutiveResponse_gaugeConnection_origin]
  unfold p286GaugeConnectionAlgebraicCurrentCoefficient
  rw [colorCartanRepairSecondJetConstitutiveResponse_pointField_origin,
    algebraicDirectionEquality]
  rfl

theorem
    colorCartanRepairSecondJetConstitutiveResponse_curvatureDerivative_origin
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ)
    (derivativeDirection : LorentzianIndex) (pair : Fin 6) :
    fieldDirectionalDerivative
        (fun point =>
          holonomicP286GaugeCurvatureCoordinate
            (colorCartanRepairSecondJetConstitutiveResponse jet parameter)
            point pair)
        0 derivativeDirection =
      fieldDirectionalDerivative
          (fun point =>
            holonomicP286GaugeCurvatureCoordinate
              colorCartanQuadraticResidualRepair point pair)
          0 derivativeDirection +
        parameter •
          p286HolonomicSecondJetCurvatureSymbol jet derivativeDirection pair := by
  have responseFunction :
      (fun point =>
        holonomicP286GaugeCurvatureCoordinate
          (colorCartanRepairSecondJetConstitutiveResponse jet parameter)
          point pair) =
        fun point =>
          holonomicP286GaugeCurvatureCoordinate
            (installP286HolonomicConnectionSecondJet
              colorCartanResidualRepairKinematic jet parameter)
            point pair := by
    funext point
    exact congrArg p286CoordinateEquiv
      (congrFun
        (synchronizeP286ConstitutiveAuxiliary_curvature
          (installP286HolonomicConnectionSecondJet
            colorCartanResidualRepairKinematic jet parameter) point)
        pair)
  have repairFunction :
      (fun point =>
        holonomicP286GaugeCurvatureCoordinate
          colorCartanQuadraticResidualRepair point pair) =
        fun point =>
          holonomicP286GaugeCurvatureCoordinate
            colorCartanResidualRepairKinematic point pair := by
    rw [colorCartanQuadraticResidualRepair_eq_synchronizedKinematic]
    funext point
    exact congrArg p286CoordinateEquiv
      (congrFun
        (synchronizeP286ConstitutiveAuxiliary_curvature
          colorCartanResidualRepairKinematic point)
        pair)
  rw [responseFunction, repairFunction]
  exact
    installP286HolonomicConnectionSecondJet_curvatureDirectionalDerivative_origin
      colorCartanResidualRepairKinematic
      (colorCartanQuadraticKinematic_smooth
        colorCartanQuadraticResidualDerivedCoefficient)
      jet parameter derivativeDirection pair

theorem
    colorCartanRepairSecondJetConstitutiveResponse_auxiliaryCoordinate
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ)
    (point : BasePoint) :
    holonomicP286GaugeAuxiliaryCoordinate
        (colorCartanRepairSecondJetConstitutiveResponse jet parameter) point =
      p286GaugeConstitutiveAuxiliaryCoordinate positiveSmoothUnifiedSource
        (canonicalPhysicalSource.coframeAt point)
        (holonomicP286GaugeCurvatureCoordinate
          (colorCartanRepairSecondJetConstitutiveResponse jet parameter)
          point) := by
  funext pair
  simp only [holonomicP286GaugeAuxiliaryCoordinate,
    colorCartanRepairSecondJetConstitutiveResponse,
    synchronizeP286ConstitutiveAuxiliary_gaugeAuxiliary,
    generatedP286GaugeConstitutiveAuxiliary,
    p286CoordinateEquiv.apply_symm_apply]
  have coframeEquality :
      (installP286HolonomicConnectionSecondJet
        colorCartanResidualRepairKinematic jet parameter).coframe point =
        canonicalPhysicalSource.coframeAt point := by
    rfl
  have curvatureEquality :
      (fun candidate =>
        p286CoordinateEquiv
          (holonomicGaugeCurvature
            (installP286HolonomicConnectionSecondJet
              colorCartanResidualRepairKinematic jet parameter)
            point candidate)) =
        holonomicP286GaugeCurvatureCoordinate
          (colorCartanRepairSecondJetConstitutiveResponse jet parameter)
          point := by
    funext candidate
    exact congrArg p286CoordinateEquiv
      (congrFun
        (synchronizeP286ConstitutiveAuxiliary_curvature
          (installP286HolonomicConnectionSecondJet
            colorCartanResidualRepairKinematic jet parameter) point).symm
        candidate)
  rw [coframeEquality, curvatureEquality]
  rfl

/-! ## The residual-side linear response forced by the curvature symbol -/

private theorem p286GaugeExteriorDerivativeDirection_add_local
    (derivativeDirection : LorentzianIndex)
    (first second : P286GaugeOneForm) :
    p286GaugeExteriorDerivativeDirection derivativeDirection
        (first + second) =
      p286GaugeExteriorDerivativeDirection derivativeDirection first +
        p286GaugeExteriorDerivativeDirection derivativeDirection second := by
  funext pair
  unfold p286GaugeExteriorDerivativeDirection
  simp only [Pi.add_apply]
  split <;> split <;> module

private theorem p286GaugeExteriorDerivativeDirection_smul_local
    (derivativeDirection : LorentzianIndex) (parameter : ℝ)
    (direction : P286GaugeOneForm) :
    p286GaugeExteriorDerivativeDirection derivativeDirection
        (parameter • direction) =
      parameter •
        p286GaugeExteriorDerivativeDirection derivativeDirection direction := by
  funext pair
  unfold p286GaugeExteriorDerivativeDirection
  simp only [Pi.smul_apply]
  split <;> split <;> module

/-- Constitutive first-jet response generated from the actual curvature
symbol at the repair origin. -/
def p286HolonomicSecondJetConstitutiveAuxiliaryResponse
    (jet : P286HolonomicConnectionSecondJet)
    (derivativeDirection : LorentzianIndex) : P286GaugeTwoForm :=
  p286GaugeConstitutiveAuxiliaryCoordinate positiveSmoothUnifiedSource
    (colorCartanQuadraticResidualRepair.coframe 0)
    (p286HolonomicSecondJetCurvatureSymbol jet derivativeDirection)

private theorem p286HolonomicSecondJetConstitutiveAuxiliaryResponse_add
    (first second : P286HolonomicConnectionSecondJet)
    (derivativeDirection : LorentzianIndex) :
    p286HolonomicSecondJetConstitutiveAuxiliaryResponse (first + second)
        derivativeDirection =
      p286HolonomicSecondJetConstitutiveAuxiliaryResponse first
          derivativeDirection +
        p286HolonomicSecondJetConstitutiveAuxiliaryResponse second
          derivativeDirection := by
  funext pair
  simp [p286HolonomicSecondJetConstitutiveAuxiliaryResponse,
    p286GaugeConstitutiveAuxiliaryCoordinate,
    liftGaugeTwoFormOperator_add_p286]

private theorem p286HolonomicSecondJetConstitutiveAuxiliaryResponse_smul
    (parameter : ℝ) (jet : P286HolonomicConnectionSecondJet)
    (derivativeDirection : LorentzianIndex) :
    p286HolonomicSecondJetConstitutiveAuxiliaryResponse (parameter • jet)
        derivativeDirection =
      parameter •
        p286HolonomicSecondJetConstitutiveAuxiliaryResponse jet
          derivativeDirection := by
  funext pair
  simp [p286HolonomicSecondJetConstitutiveAuxiliaryResponse,
    p286GaugeConstitutiveAuxiliaryCoordinate,
    liftGaugeTwoFormOperator_smul_p286]
  module

private theorem p286GaugeBFCurvatureIncrementDensity_add_auxiliary
    (coframe : LorentzianCoframe)
    (spacetimeHodge : GaugeTwoForm →ₗ[ℝ] GaugeTwoForm)
    (first second variation : P286GaugeTwoForm) :
    p286GaugeBFCurvatureIncrementDensity coframe spacetimeHodge
        (first + second) variation =
      p286GaugeBFCurvatureIncrementDensity coframe spacetimeHodge first
          variation +
        p286GaugeBFCurvatureIncrementDensity coframe spacetimeHodge second
          variation := by
  unfold p286GaugeBFCurvatureIncrementDensity
  rw [generatedGaugeTwoFormMetricPairing_p286_add_left]

private theorem p286GaugeBFCurvatureIncrementDensity_smul_auxiliary
    (coframe : LorentzianCoframe)
    (spacetimeHodge : GaugeTwoForm →ₗ[ℝ] GaugeTwoForm)
    (parameter : ℝ) (auxiliary variation : P286GaugeTwoForm) :
    p286GaugeBFCurvatureIncrementDensity coframe spacetimeHodge
        (parameter • auxiliary) variation =
      parameter *
        p286GaugeBFCurvatureIncrementDensity coframe spacetimeHodge auxiliary
          variation := by
  unfold p286GaugeBFCurvatureIncrementDensity
  rw [generatedGaugeTwoFormMetricPairing_p286_smul_left]

/-- One derivative-direction contribution to the origin BF-divergence
displacement. -/
def p286HolonomicSecondJetBFDivergenceResponseTerm
    (jet : P286HolonomicConnectionSecondJet)
    (direction : P286GaugeOneForm)
    (derivativeDirection : LorentzianIndex) : ℝ :=
  generatedVolumeDensity
      (toContinuumPointField colorCartanQuadraticResidualRepair 0) *
    p286GaugeBFCurvatureIncrementDensity
      (colorCartanQuadraticResidualRepair.coframe 0)
      (coframeGaugeSpacetimeHodgeLinear
        (colorCartanQuadraticResidualRepair.coframe 0))
      (p286HolonomicSecondJetConstitutiveAuxiliaryResponse jet
        derivativeDirection)
      (p286GaugeExteriorDerivativeDirection derivativeDirection direction)

private theorem p286HolonomicSecondJetBFDivergenceResponseTerm_add_jet
    (first second : P286HolonomicConnectionSecondJet)
    (direction : P286GaugeOneForm)
    (derivativeDirection : LorentzianIndex) :
    p286HolonomicSecondJetBFDivergenceResponseTerm (first + second) direction
        derivativeDirection =
      p286HolonomicSecondJetBFDivergenceResponseTerm first direction
          derivativeDirection +
        p286HolonomicSecondJetBFDivergenceResponseTerm second direction
          derivativeDirection := by
  unfold p286HolonomicSecondJetBFDivergenceResponseTerm
  rw [p286HolonomicSecondJetConstitutiveAuxiliaryResponse_add,
    p286GaugeBFCurvatureIncrementDensity_add_auxiliary, mul_add]

private theorem p286HolonomicSecondJetBFDivergenceResponseTerm_smul_jet
    (parameter : ℝ) (jet : P286HolonomicConnectionSecondJet)
    (direction : P286GaugeOneForm)
    (derivativeDirection : LorentzianIndex) :
    p286HolonomicSecondJetBFDivergenceResponseTerm (parameter • jet)
        direction derivativeDirection =
      parameter *
        p286HolonomicSecondJetBFDivergenceResponseTerm jet direction
          derivativeDirection := by
  unfold p286HolonomicSecondJetBFDivergenceResponseTerm
  rw [p286HolonomicSecondJetConstitutiveAuxiliaryResponse_smul,
    p286GaugeBFCurvatureIncrementDensity_smul_auxiliary]
  ring

private theorem p286HolonomicSecondJetBFDivergenceResponseTerm_add_direction
    (jet : P286HolonomicConnectionSecondJet)
    (first second : P286GaugeOneForm)
    (derivativeDirection : LorentzianIndex) :
    p286HolonomicSecondJetBFDivergenceResponseTerm jet (first + second)
        derivativeDirection =
      p286HolonomicSecondJetBFDivergenceResponseTerm jet first
          derivativeDirection +
        p286HolonomicSecondJetBFDivergenceResponseTerm jet second
          derivativeDirection := by
  unfold p286HolonomicSecondJetBFDivergenceResponseTerm
  rw [p286GaugeExteriorDerivativeDirection_add_local,
    p286GaugeBFCurvatureIncrementDensity_add, mul_add]

private theorem p286HolonomicSecondJetBFDivergenceResponseTerm_smul_direction
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ)
    (direction : P286GaugeOneForm)
    (derivativeDirection : LorentzianIndex) :
    p286HolonomicSecondJetBFDivergenceResponseTerm jet
        (parameter • direction) derivativeDirection =
      parameter *
        p286HolonomicSecondJetBFDivergenceResponseTerm jet direction
          derivativeDirection := by
  unfold p286HolonomicSecondJetBFDivergenceResponseTerm
  rw [p286GaugeExteriorDerivativeDirection_smul_local,
    p286GaugeBFCurvatureIncrementDensity_smul]
  ring

/-- The origin BF-divergence displacement forced by one holonomic Hessian,
written entirely with the existing action density and constitutive solver. -/
def p286HolonomicSecondJetBFDivergenceResponseValue
    (jet : P286HolonomicConnectionSecondJet)
    (direction : P286GaugeOneForm) : ℝ :=
  ∑ derivativeDirection : LorentzianIndex,
    p286HolonomicSecondJetBFDivergenceResponseTerm jet direction
      derivativeDirection

private theorem p286HolonomicSecondJetBFDivergenceResponseValue_add_jet
    (first second : P286HolonomicConnectionSecondJet)
    (direction : P286GaugeOneForm) :
    p286HolonomicSecondJetBFDivergenceResponseValue (first + second)
        direction =
      p286HolonomicSecondJetBFDivergenceResponseValue first direction +
        p286HolonomicSecondJetBFDivergenceResponseValue second direction := by
  unfold p286HolonomicSecondJetBFDivergenceResponseValue
  simp_rw [p286HolonomicSecondJetBFDivergenceResponseTerm_add_jet,
    Finset.sum_add_distrib]

private theorem p286HolonomicSecondJetBFDivergenceResponseValue_smul_jet
    (parameter : ℝ) (jet : P286HolonomicConnectionSecondJet)
    (direction : P286GaugeOneForm) :
    p286HolonomicSecondJetBFDivergenceResponseValue (parameter • jet)
        direction =
      parameter *
        p286HolonomicSecondJetBFDivergenceResponseValue jet direction := by
  unfold p286HolonomicSecondJetBFDivergenceResponseValue
  simp_rw [p286HolonomicSecondJetBFDivergenceResponseTerm_smul_jet]
  rw [Finset.mul_sum]

private theorem p286HolonomicSecondJetBFDivergenceResponseValue_add_direction
    (jet : P286HolonomicConnectionSecondJet)
    (first second : P286GaugeOneForm) :
    p286HolonomicSecondJetBFDivergenceResponseValue jet (first + second) =
      p286HolonomicSecondJetBFDivergenceResponseValue jet first +
        p286HolonomicSecondJetBFDivergenceResponseValue jet second := by
  unfold p286HolonomicSecondJetBFDivergenceResponseValue
  simp_rw [p286HolonomicSecondJetBFDivergenceResponseTerm_add_direction,
    Finset.sum_add_distrib]

private theorem p286HolonomicSecondJetBFDivergenceResponseValue_smul_direction
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ)
    (direction : P286GaugeOneForm) :
    p286HolonomicSecondJetBFDivergenceResponseValue jet
        (parameter • direction) =
      parameter *
        p286HolonomicSecondJetBFDivergenceResponseValue jet direction := by
  unfold p286HolonomicSecondJetBFDivergenceResponseValue
  simp_rw [p286HolonomicSecondJetBFDivergenceResponseTerm_smul_direction]
  rw [Finset.mul_sum]

/-- Complete action-side response carrier.  The Euler--Lagrange sign is the
negative of the BF-divergence displacement because the algebraic/current
origin data are preserved. -/
def p286HolonomicSecondJetEulerLagrangeResponse :
    P286HolonomicConnectionSecondJet →ₗ[ℝ]
      Module.Dual ℝ P286GaugeOneForm where
  toFun jet :=
    { toFun := fun direction =>
        -p286HolonomicSecondJetBFDivergenceResponseValue jet direction
      map_add' := by
        intro first second
        rw [p286HolonomicSecondJetBFDivergenceResponseValue_add_direction]
        ring
      map_smul' := by
        intro parameter direction
        rw [p286HolonomicSecondJetBFDivergenceResponseValue_smul_direction]
        simp only [RingHom.id_apply]
        ring }
  map_add' := by
    intro first second
    apply LinearMap.ext
    intro direction
    change
      -p286HolonomicSecondJetBFDivergenceResponseValue (first + second)
          direction =
        -p286HolonomicSecondJetBFDivergenceResponseValue first direction +
          -p286HolonomicSecondJetBFDivergenceResponseValue second direction
    rw [p286HolonomicSecondJetBFDivergenceResponseValue_add_jet]
    ring
  map_smul' := by
    intro parameter jet
    apply LinearMap.ext
    intro direction
    change
      -p286HolonomicSecondJetBFDivergenceResponseValue (parameter • jet)
          direction =
        parameter *
          (-p286HolonomicSecondJetBFDivergenceResponseValue jet direction)
    rw [p286HolonomicSecondJetBFDivergenceResponseValue_smul_jet]
    ring

@[simp] theorem p286HolonomicSecondJetEulerLagrangeResponse_apply
    (jet : P286HolonomicConnectionSecondJet)
    (direction : P286GaugeOneForm) :
    p286HolonomicSecondJetEulerLagrangeResponse jet direction =
      -p286HolonomicSecondJetBFDivergenceResponseValue jet direction :=
  rfl

/-! ## Exact action response of the synchronized family -/

private theorem
    positiveSourceP286ConstitutiveMomentumPolynomial_normalForm
    (curvature direction : P286GaugeTwoForm) (point : BasePoint) :
    abs (Matrix.det (canonicalPhysicalSource.coframeAt point)) *
        p286GaugeAuxiliaryHodgePairingPolynomial
          (canonicalPhysicalSource.coframeAt point)
          (p286GaugeConstitutiveAuxiliaryCoordinate
            positiveSmoothUnifiedSource
            (canonicalPhysicalSource.coframeAt point) curvature)
          direction =
      2 * ∑ pair : Fin 6,
        lorentzianTwoFormSign pair *
          p286CoordinateLiePairing
            (liftGaugeTwoFormOperator
              (coframeTwoFormLinear
                (canonicalPhysicalSource.coframeAt point))
              curvature pair)
            (liftGaugeTwoFormOperator
              (coframeTwoFormLinear
                (canonicalPhysicalSource.coframeAt point))
              direction pair) := by
  rw [canonicalPhysicalSource_coframeAt_det]
  simp only [abs_one, one_mul]
  unfold p286GaugeAuxiliaryHodgePairingPolynomial
    p286GaugeConstitutiveAuxiliaryCoordinate
  have couplingInverse :
      (((sourceGeneratedUnifiedCouplings
        positiveSmoothUnifiedSource).strongCouplingSquared : ℝ)⁻¹) = 2 := by
    change (positiveSmoothUnifiedSource.legacy.sigma)⁻¹ = 2
    rw [SaturationMonoid.PhysicsCore.StageNinePositiveSourceGravityMouthResidualTransportIteration.positiveSmoothUnifiedSource_legacy_sigma_eq_half]
    norm_num
  rw [couplingInverse]
  simp_rw [liftGaugeTwoFormOperator_smul_p286]
  simp_rw [liftCoframe_dynamicHodge_p286
    (canonicalPhysicalSource.coframeAt point)
    (canonicalPhysicalSource_globally_nondegenerate point) curvature]
  simp_rw [Pi.smul_apply, p286CoordinateLiePairing_smul_left]
  let framedCurvature :=
    liftGaugeTwoFormOperator
      (coframeTwoFormLinear (canonicalPhysicalSource.coframeAt point))
      curvature
  let framedDirection :=
    liftGaugeTwoFormOperator
      (coframeTwoFormLinear (canonicalPhysicalSource.coframeAt point))
      direction
  calc
    (∑ pair : Fin 6,
      lorentzianTwoFormSign pair *
        (-2 * p286CoordinateLiePairing
          (liftGaugeTwoFormOperator lorentzianCoframeHodge
            framedCurvature pair)
          (liftGaugeTwoFormOperator lorentzianCoframeHodge
            framedDirection pair))) =
      -2 * ∑ pair : Fin 6,
        lorentzianTwoFormSign pair *
          p286CoordinateLiePairing
            (liftGaugeTwoFormOperator lorentzianCoframeHodge
              framedCurvature pair)
            (liftGaugeTwoFormOperator lorentzianCoframeHodge
              framedDirection pair) := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro pair _
        ring
    _ = 2 * ∑ pair : Fin 6,
        lorentzianTwoFormSign pair *
          p286CoordinateLiePairing (framedCurvature pair)
            (framedDirection pair) := by
      rw [p286FixedHodge_pairing_pairing_local]
      ring
    _ = _ := rfl

theorem
    colorCartanRepairSecondJetConstitutiveResponse_p286Momentum_normalForm
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ)
    (direction : P286GaugeTwoForm) (point : BasePoint) :
    p286GaugeConnectionBFDifferentialMomentum
        (colorCartanRepairSecondJetConstitutiveResponse jet parameter)
        direction point =
      2 * ∑ pair : Fin 6,
        lorentzianTwoFormSign pair *
          p286CoordinateLiePairing
            (liftGaugeTwoFormOperator
              (coframeTwoFormLinear
                (canonicalPhysicalSource.coframeAt point))
              (holonomicP286GaugeCurvatureCoordinate
                (colorCartanRepairSecondJetConstitutiveResponse jet parameter)
                point)
              pair)
            (liftGaugeTwoFormOperator
              (coframeTwoFormLinear
                (canonicalPhysicalSource.coframeAt point))
              direction pair) := by
  unfold p286GaugeConnectionBFDifferentialMomentum
  change
    abs (Matrix.det
        ((colorCartanRepairSecondJetConstitutiveResponse jet
          parameter).coframe point)) *
        p286GaugeAuxiliaryHodgePairingPolynomial
          ((colorCartanRepairSecondJetConstitutiveResponse jet
            parameter).coframe point)
          (holonomicP286GaugeAuxiliaryCoordinate
            (colorCartanRepairSecondJetConstitutiveResponse jet parameter)
            point)
          direction = _
  have coframeEquality :
      (colorCartanRepairSecondJetConstitutiveResponse jet
        parameter).coframe point =
        canonicalPhysicalSource.coframeAt point := by
    rfl
  rw [coframeEquality,
    colorCartanRepairSecondJetConstitutiveResponse_auxiliaryCoordinate]
  exact positiveSourceP286ConstitutiveMomentumPolynomial_normalForm
    (holonomicP286GaugeCurvatureCoordinate
      (colorCartanRepairSecondJetConstitutiveResponse jet parameter) point)
    direction point

/-- Actual curvature displacement relative to the deterministic C3h78 repair.
It is a derived field, not a new primitive source slot. -/
def colorCartanRepairSecondJetCurvatureDisplacement
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ)
    (point : BasePoint) : P286GaugeTwoForm :=
  holonomicP286GaugeCurvatureCoordinate
      (colorCartanRepairSecondJetConstitutiveResponse jet parameter) point -
    holonomicP286GaugeCurvatureCoordinate
      colorCartanQuadraticResidualRepair point

theorem colorCartanRepairSecondJetCurvatureDisplacement_contDiff
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ) :
    ContDiff ℝ ∞
      (colorCartanRepairSecondJetCurvatureDisplacement jet parameter) := by
  apply contDiff_pi'
  intro pair
  exact
    (holonomicGaugeCurvature_coordinate_contDiff
      (colorCartanRepairSecondJetConstitutiveResponse jet parameter)
      (colorCartanRepairSecondJetConstitutiveResponse_smooth jet parameter)
      pair).sub
    (holonomicGaugeCurvature_coordinate_contDiff
      colorCartanQuadraticResidualRepair
      colorCartanQuadraticResidualRepair_smooth pair)

@[simp] theorem colorCartanRepairSecondJetCurvatureDisplacement_origin
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ) :
    colorCartanRepairSecondJetCurvatureDisplacement jet parameter 0 = 0 := by
  unfold colorCartanRepairSecondJetCurvatureDisplacement
  rw [colorCartanRepairSecondJetConstitutiveResponse_curvature_origin]
  exact sub_self _

theorem
    colorCartanRepairSecondJetCurvatureDisplacement_derivative_origin
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ)
    (derivativeDirection : LorentzianIndex) (pair : Fin 6) :
    fieldDirectionalDerivative
        (fun point =>
          colorCartanRepairSecondJetCurvatureDisplacement jet parameter point
            pair)
        0 derivativeDirection =
      parameter •
        p286HolonomicSecondJetCurvatureSymbol jet derivativeDirection pair := by
  have responseSmooth :=
    holonomicGaugeCurvature_coordinate_contDiff
      (colorCartanRepairSecondJetConstitutiveResponse jet parameter)
      (colorCartanRepairSecondJetConstitutiveResponse_smooth jet parameter)
      pair
  have repairSmooth :=
    holonomicGaugeCurvature_coordinate_contDiff
      colorCartanQuadraticResidualRepair
      colorCartanQuadraticResidualRepair_smooth pair
  unfold colorCartanRepairSecondJetCurvatureDisplacement
  change
    fieldDirectionalDerivative
        (fun point =>
          p286CoordinateEquiv
              (holonomicGaugeCurvature
                (colorCartanRepairSecondJetConstitutiveResponse jet parameter)
                point pair) -
            p286CoordinateEquiv
              (holonomicGaugeCurvature colorCartanQuadraticResidualRepair
                point pair))
        0 derivativeDirection =
      _
  rw [fieldDirectionalDerivative_sub_of_contDiff _ _ responseSmooth
    repairSmooth]
  change
    fieldDirectionalDerivative
          (fun point =>
            holonomicP286GaugeCurvatureCoordinate
              (colorCartanRepairSecondJetConstitutiveResponse jet parameter)
              point pair)
          0 derivativeDirection -
        fieldDirectionalDerivative
          (fun point =>
            holonomicP286GaugeCurvatureCoordinate
              colorCartanQuadraticResidualRepair point pair)
          0 derivativeDirection =
      _
  rw [
    colorCartanRepairSecondJetConstitutiveResponse_curvatureDerivative_origin]
  module

private def p286PositiveSourceFramedField
    (field : BasePoint → P286GaugeTwoForm) (point : BasePoint) :
    P286GaugeTwoForm :=
  liftGaugeTwoFormOperator
    (coframeTwoFormLinear (canonicalPhysicalSource.coframeAt point))
    (field point)

private theorem p286PositiveSourceFramedField_contDiff
    (field : BasePoint → P286GaugeTwoForm)
    (fieldSmooth : ContDiff ℝ ∞ field) :
    ContDiff ℝ ∞ (p286PositiveSourceFramedField field) := by
  change ContDiff ℝ ∞ fun point =>
    liftGaugeTwoFormOperator
      (coframeTwoFormLinear
        (colorCartanQuadraticResidualRepair.coframe point))
      (field point)
  exact holonomicLiftCoframeTwoFormLinear_apply_contDiff
    colorCartanQuadraticResidualRepair
    colorCartanQuadraticResidualRepair_smooth field fieldSmooth

private theorem p286PositiveSourceFramedField_origin_of_field_origin
    (field : BasePoint → P286GaugeTwoForm) (fieldOrigin : field 0 = 0) :
    p286PositiveSourceFramedField field 0 = 0 := by
  unfold p286PositiveSourceFramedField
  rw [fieldOrigin, liftGaugeTwoFormOperator_zero_p286]

private theorem
    fieldDirectionalDerivative_coordinateTwo_smul_of_right_zero
    (field : BasePoint → P286CoordinateCarrier)
    (fieldSmooth : ContDiff ℝ ∞ field) (fieldOrigin : field 0 = 0)
    (derivativeDirection : LorentzianIndex) :
    fieldDirectionalDerivative
        (fun point : BasePoint => point 2 • field point)
        0 derivativeDirection = 0 := by
  have fieldDerivative :
      HasFDerivAt field (fderiv ℝ field 0) 0 :=
    (fieldSmooth.differentiable (by simp)).differentiableAt.hasFDerivAt
  have productDerivative :=
    (p286BaseCoordinate 2).hasFDerivAt.smul fieldDerivative
  change HasFDerivAt
      (fun point : BasePoint => point 2 • field point) _ 0 at productDerivative
  unfold fieldDirectionalDerivative
  rw [productDerivative.fderiv]
  simp [fieldOrigin, p286BaseCoordinate_apply, coordinateDirection]

private theorem
    p286PositiveSourceFramedCurvatureDisplacement_derivative_origin
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ)
    (derivativeDirection : LorentzianIndex) (pair : Fin 6) :
    fieldDirectionalDerivative
        (fun point =>
          p286PositiveSourceFramedField
            (colorCartanRepairSecondJetCurvatureDisplacement jet parameter)
            point pair)
        0 derivativeDirection =
      parameter •
        p286HolonomicSecondJetCurvatureSymbol jet derivativeDirection pair := by
  let displacement :=
    colorCartanRepairSecondJetCurvatureDisplacement jet parameter
  have displacementSmooth : ContDiff ℝ ∞ displacement :=
    colorCartanRepairSecondJetCurvatureDisplacement_contDiff jet parameter
  have displacementOrigin : displacement 0 = 0 :=
    colorCartanRepairSecondJetCurvatureDisplacement_origin jet parameter
  have productFiveSmooth : ContDiff ℝ ∞
      (fun point : BasePoint => point 2 • displacement point 5) :=
    (p286BaseCoordinate 2).contDiff.smul
      (contDiff_pi.mp displacementSmooth 5)
  have productFourSmooth : ContDiff ℝ ∞
      (fun point : BasePoint => point 2 • displacement point 4) :=
    (p286BaseCoordinate 2).contDiff.smul
      (contDiff_pi.mp displacementSmooth 4)
  fin_cases pair
  · change
      fieldDirectionalDerivative
          (fun point =>
            p286PositiveSourceFramedField displacement point 0)
          0 derivativeDirection =
        parameter •
          p286HolonomicSecondJetCurvatureSymbol jet derivativeDirection 0
    have functionEquality :
        (fun point =>
          p286PositiveSourceFramedField displacement point 0) =
            fun point => displacement point 0 := by
      funext point
      simp [p286PositiveSourceFramedField,
        liftGaugeTwoFormOperator_positiveSourceFrame_apply_local]
    rw [functionEquality]
    exact
      colorCartanRepairSecondJetCurvatureDisplacement_derivative_origin
        jet parameter derivativeDirection 0
  · change
      fieldDirectionalDerivative
          (fun point =>
            p286PositiveSourceFramedField displacement point 1)
          0 derivativeDirection =
        parameter •
          p286HolonomicSecondJetCurvatureSymbol jet derivativeDirection 1
    have functionEquality :
        (fun point =>
          p286PositiveSourceFramedField displacement point 1) =
            fun point =>
              displacement point 1 + point 2 • displacement point 5 := by
      funext point
      simp [p286PositiveSourceFramedField,
        liftGaugeTwoFormOperator_positiveSourceFrame_apply_local]
    rw [functionEquality,
      fieldDirectionalDerivative_add_of_contDiff _ _
        (contDiff_pi.mp displacementSmooth 1) productFiveSmooth,
      fieldDirectionalDerivative_coordinateTwo_smul_of_right_zero
        (fun point => displacement point 5)
        (contDiff_pi.mp displacementSmooth 5)
        (congrFun displacementOrigin 5)]
    simpa using
      colorCartanRepairSecondJetCurvatureDisplacement_derivative_origin
        jet parameter derivativeDirection 1
  · change
      fieldDirectionalDerivative
          (fun point =>
            p286PositiveSourceFramedField displacement point 2)
          0 derivativeDirection =
        parameter •
          p286HolonomicSecondJetCurvatureSymbol jet derivativeDirection 2
    have functionEquality :
        (fun point =>
          p286PositiveSourceFramedField displacement point 2) =
            fun point =>
              displacement point 2 - point 2 • displacement point 4 := by
      funext point
      simp [p286PositiveSourceFramedField,
        liftGaugeTwoFormOperator_positiveSourceFrame_apply_local]
    rw [functionEquality,
      fieldDirectionalDerivative_sub_of_contDiff _ _
        (contDiff_pi.mp displacementSmooth 2) productFourSmooth,
      fieldDirectionalDerivative_coordinateTwo_smul_of_right_zero
        (fun point => displacement point 4)
        (contDiff_pi.mp displacementSmooth 4)
        (congrFun displacementOrigin 4)]
    simpa using
      colorCartanRepairSecondJetCurvatureDisplacement_derivative_origin
        jet parameter derivativeDirection 2
  · change
      fieldDirectionalDerivative
          (fun point =>
            p286PositiveSourceFramedField displacement point 3)
          0 derivativeDirection =
        parameter •
          p286HolonomicSecondJetCurvatureSymbol jet derivativeDirection 3
    have functionEquality :
        (fun point =>
          p286PositiveSourceFramedField displacement point 3) =
            fun point => displacement point 3 := by
      funext point
      simp [p286PositiveSourceFramedField,
        liftGaugeTwoFormOperator_positiveSourceFrame_apply_local]
    rw [functionEquality]
    exact
      colorCartanRepairSecondJetCurvatureDisplacement_derivative_origin
        jet parameter derivativeDirection 3
  · change
      fieldDirectionalDerivative
          (fun point =>
            p286PositiveSourceFramedField displacement point 4)
          0 derivativeDirection =
        parameter •
          p286HolonomicSecondJetCurvatureSymbol jet derivativeDirection 4
    have functionEquality :
        (fun point =>
          p286PositiveSourceFramedField displacement point 4) =
            fun point => displacement point 4 := by
      funext point
      simp [p286PositiveSourceFramedField,
        liftGaugeTwoFormOperator_positiveSourceFrame_apply_local]
    rw [functionEquality]
    exact
      colorCartanRepairSecondJetCurvatureDisplacement_derivative_origin
        jet parameter derivativeDirection 4
  · change
      fieldDirectionalDerivative
          (fun point =>
            p286PositiveSourceFramedField displacement point 5)
          0 derivativeDirection =
        parameter •
          p286HolonomicSecondJetCurvatureSymbol jet derivativeDirection 5
    have functionEquality :
        (fun point =>
          p286PositiveSourceFramedField displacement point 5) =
            fun point => displacement point 5 := by
      funext point
      simp [p286PositiveSourceFramedField,
        liftGaugeTwoFormOperator_positiveSourceFrame_apply_local]
    rw [functionEquality]
    exact
      colorCartanRepairSecondJetCurvatureDisplacement_derivative_origin
        jet parameter derivativeDirection 5

/-- Exact BF-momentum displacement induced by the actual curvature difference.
The coefficient `2` here has already been derived from the source coupling in
`positiveSourceP286ConstitutiveMomentumPolynomial_normalForm`. -/
def colorCartanRepairSecondJetMomentumDisplacement
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ)
    (direction : P286GaugeTwoForm) (point : BasePoint) : ℝ :=
  2 * ∑ pair : Fin 6,
    lorentzianTwoFormSign pair *
      p286CoordinateLiePairing
        (liftGaugeTwoFormOperator
          (coframeTwoFormLinear
            (canonicalPhysicalSource.coframeAt point))
          (colorCartanRepairSecondJetCurvatureDisplacement jet parameter point)
          pair)
        (liftGaugeTwoFormOperator
          (coframeTwoFormLinear
            (canonicalPhysicalSource.coframeAt point))
          direction pair)

theorem colorCartanRepairSecondJetMomentumDisplacement_contDiff
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ)
    (direction : P286GaugeTwoForm) :
    ContDiff ℝ ∞
      (colorCartanRepairSecondJetMomentumDisplacement jet parameter
        direction) := by
  let displacement :=
    colorCartanRepairSecondJetCurvatureDisplacement jet parameter
  have displacementSmooth : ContDiff ℝ ∞ displacement :=
    colorCartanRepairSecondJetCurvatureDisplacement_contDiff jet parameter
  have framedDisplacementSmooth :=
    p286PositiveSourceFramedField_contDiff displacement displacementSmooth
  have framedDirectionSmooth :=
    p286PositiveSourceFramedField_contDiff (fun _ => direction) contDiff_const
  change ContDiff ℝ ∞ fun point =>
    2 * ∑ pair : Fin 6,
      lorentzianTwoFormSign pair *
        p286CoordinateLiePairing
          (p286PositiveSourceFramedField displacement point pair)
          (p286PositiveSourceFramedField (fun _ => direction) point pair)
  apply contDiff_const.mul
  apply ContDiff.sum
  intro pair _
  apply contDiff_const.mul
  exact p286CoordinateLiePairing_apply_contDiff
    (fun point => p286PositiveSourceFramedField displacement point pair)
    (fun point =>
      p286PositiveSourceFramedField (fun _ => direction) point pair)
    (contDiff_pi.mp framedDisplacementSmooth pair)
    (contDiff_pi.mp framedDirectionSmooth pair)

theorem
    colorCartanRepairSecondJetConstitutiveResponse_p286Momentum_eq_affine
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ)
    (direction : P286GaugeTwoForm) :
    p286GaugeConnectionBFDifferentialMomentum
        (colorCartanRepairSecondJetConstitutiveResponse jet parameter)
        direction =
      p286GaugeConnectionBFDifferentialMomentum
          colorCartanQuadraticResidualRepair direction +
        colorCartanRepairSecondJetMomentumDisplacement jet parameter
          direction := by
  funext point
  rw [
    colorCartanRepairSecondJetConstitutiveResponse_p286Momentum_normalForm]
  have repairNormalForm :=
    colorCartanQuadraticConstitutiveResponse_p286Momentum_normalForm
      colorCartanQuadraticResidualDerivedCoefficient direction point
  change
    p286GaugeConnectionBFDifferentialMomentum
        colorCartanQuadraticResidualRepair direction point =
      2 * ∑ pair : Fin 6,
        lorentzianTwoFormSign pair *
          p286CoordinateLiePairing
            (liftGaugeTwoFormOperator
              (coframeTwoFormLinear
                (canonicalPhysicalSource.coframeAt point))
              (holonomicP286GaugeCurvatureCoordinate
                colorCartanQuadraticResidualRepair point)
              pair)
            (liftGaugeTwoFormOperator
              (coframeTwoFormLinear
                (canonicalPhysicalSource.coframeAt point))
              direction pair)
      at repairNormalForm
  change
    _ =
      p286GaugeConnectionBFDifferentialMomentum
          colorCartanQuadraticResidualRepair direction point +
        colorCartanRepairSecondJetMomentumDisplacement jet parameter
          direction point
  rw [repairNormalForm]
  have curvatureSplit :
      holonomicP286GaugeCurvatureCoordinate
          (colorCartanRepairSecondJetConstitutiveResponse jet parameter)
          point =
        holonomicP286GaugeCurvatureCoordinate
            colorCartanQuadraticResidualRepair point +
          colorCartanRepairSecondJetCurvatureDisplacement jet parameter
            point := by
    unfold colorCartanRepairSecondJetCurvatureDisplacement
    module
  unfold colorCartanRepairSecondJetMomentumDisplacement
  rw [curvatureSplit, liftGaugeTwoFormOperator_add_p286]
  simp_rw [Pi.add_apply, p286CoordinateLiePairing_add_left, mul_add]
  rw [Finset.sum_add_distrib]
  ring

private theorem p286PositiveSourceFramedField_const_origin
    (direction : P286GaugeTwoForm) :
    p286PositiveSourceFramedField (fun _ => direction) 0 = direction := by
  funext pair
  unfold p286PositiveSourceFramedField
  rw [liftGaugeTwoFormOperator_positiveSourceFrame_apply_local]
  fin_cases pair <;> simp

private theorem fieldDirectionalDerivative_const_mul_real_local
    (field : BasePoint → ℝ) (fieldSmooth : ContDiff ℝ ∞ field)
    (scalar : ℝ) (derivativeDirection : LorentzianIndex) :
    fieldDirectionalDerivative (fun point => scalar * field point) 0
        derivativeDirection =
      scalar * fieldDirectionalDerivative field 0 derivativeDirection := by
  unfold fieldDirectionalDerivative
  rw [fderiv_const_mul
    (fieldSmooth.differentiable (by simp) 0) scalar]
  rfl

private theorem fieldDirectionalDerivative_add_real_local
    (first second : BasePoint → ℝ)
    (firstSmooth : ContDiff ℝ ∞ first)
    (secondSmooth : ContDiff ℝ ∞ second)
    (point : BasePoint) (derivativeDirection : LorentzianIndex) :
    fieldDirectionalDerivative (first + second) point derivativeDirection =
      fieldDirectionalDerivative first point derivativeDirection +
        fieldDirectionalDerivative second point derivativeDirection := by
  have functionEquality :
      first + second = fun candidate => first candidate + second candidate := by
    funext candidate
    rfl
  rw [functionEquality]
  unfold fieldDirectionalDerivative
  rw [fderiv_fun_add
    (firstSmooth.differentiable (by simp) point)
    (secondSmooth.differentiable (by simp) point)]
  rfl

private theorem fieldDirectionalDerivative_finset_sum_real_local
    {Index : Type*} [Fintype Index]
    (field : Index → BasePoint → ℝ)
    (fieldSmooth : ∀ index, ContDiff ℝ ∞ (field index))
    (derivativeDirection : LorentzianIndex) :
    fieldDirectionalDerivative (fun point => ∑ index, field index point) 0
        derivativeDirection =
      ∑ index,
        fieldDirectionalDerivative (field index) 0 derivativeDirection := by
  have sumDerivative :
      HasFDerivAt
        (∑ index, field index)
        (∑ index, fderiv ℝ (field index) 0) 0 :=
    HasFDerivAt.sum (u := Finset.univ) fun index _ =>
      ((fieldSmooth index).differentiable (by simp)).differentiableAt.hasFDerivAt
  have sumDerivativePointwise :
      HasFDerivAt
        (fun point => ∑ index, field index point)
        (∑ index, fderiv ℝ (field index) 0) 0 := by
    convert sumDerivative using 1
    funext point
    simp
  unfold fieldDirectionalDerivative
  rw [sumDerivativePointwise.fderiv]
  simp

private theorem
    fieldDirectionalDerivative_p286Pairing_of_left_zero_local
    (first second : BasePoint → P286CoordinateCarrier)
    (firstSmooth : ContDiff ℝ ∞ first)
    (secondSmooth : ContDiff ℝ ∞ second)
    (firstOrigin : first 0 = 0)
    (derivativeDirection : LorentzianIndex) :
    fieldDirectionalDerivative
        (fun point => p286CoordinateLiePairing (first point) (second point))
        0 derivativeDirection =
      p286CoordinateLiePairing
        (fieldDirectionalDerivative first 0 derivativeDirection)
        (second 0) := by
  have firstDerivative :
      HasFDerivAt first (fderiv ℝ first 0) 0 :=
    (firstSmooth.differentiable (by simp)).differentiableAt.hasFDerivAt
  have secondDerivative :
      HasFDerivAt second (fderiv ℝ second 0) 0 :=
    (secondSmooth.differentiable (by simp)).differentiableAt.hasFDerivAt
  have pairingDerivative :=
    p286CoordinateLiePairingBilinear.toContinuousBilinearMap
      |>.hasFDerivAt_of_bilinear firstDerivative secondDerivative
  unfold fieldDirectionalDerivative
  change
    (fderiv ℝ
      (fun point =>
        p286CoordinateLiePairingBilinear.toContinuousBilinearMap
          (first point) (second point))
      0) (coordinateDirection derivativeDirection) =
      p286CoordinateLiePairingBilinear.toContinuousBilinearMap
        ((fderiv ℝ first 0) (coordinateDirection derivativeDirection))
        (second 0)
  rw [pairingDerivative.fderiv]
  simp [firstOrigin]

private theorem
    colorCartanRepairSecondJetMomentumPairing_derivative_origin
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ)
    (direction : P286GaugeTwoForm)
    (derivativeDirection : LorentzianIndex) (pair : Fin 6) :
    fieldDirectionalDerivative
        (fun point =>
          p286CoordinateLiePairing
            (p286PositiveSourceFramedField
              (colorCartanRepairSecondJetCurvatureDisplacement jet parameter)
              point pair)
            (p286PositiveSourceFramedField (fun _ => direction) point pair))
        0 derivativeDirection =
      parameter *
        p286CoordinateLiePairing
          (p286HolonomicSecondJetCurvatureSymbol jet derivativeDirection pair)
          (direction pair) := by
  have displacementSmooth :=
    colorCartanRepairSecondJetCurvatureDisplacement_contDiff jet parameter
  have framedDisplacementSmooth :=
    p286PositiveSourceFramedField_contDiff
      (colorCartanRepairSecondJetCurvatureDisplacement jet parameter)
      displacementSmooth
  have framedDirectionSmooth :=
    p286PositiveSourceFramedField_contDiff (fun _ => direction) contDiff_const
  have framedDisplacementOrigin :=
    p286PositiveSourceFramedField_origin_of_field_origin
      (colorCartanRepairSecondJetCurvatureDisplacement jet parameter)
      (colorCartanRepairSecondJetCurvatureDisplacement_origin jet parameter)
  rw [fieldDirectionalDerivative_p286Pairing_of_left_zero_local
      (fun point =>
        p286PositiveSourceFramedField
          (colorCartanRepairSecondJetCurvatureDisplacement jet parameter)
          point pair)
      (fun point =>
        p286PositiveSourceFramedField (fun _ => direction) point pair)
      (contDiff_pi.mp framedDisplacementSmooth pair)
      (contDiff_pi.mp framedDirectionSmooth pair)
      (congrFun framedDisplacementOrigin pair),
    p286PositiveSourceFramedCurvatureDisplacement_derivative_origin,
    congrFun (p286PositiveSourceFramedField_const_origin direction) pair,
    p286CoordinateLiePairing_smul_left]

/-! ## Actual full-dual affine response -/

/-- Action-normal form of one second-jet divergence contribution.  The
coefficient is derived from the exact positive-source coupling and the
existing constitutive equation; it is not part of the response-carrier
definition. -/
theorem p286HolonomicSecondJetBFDivergenceResponseTerm_normalForm
    (jet : P286HolonomicConnectionSecondJet)
    (direction : P286GaugeOneForm)
    (derivativeDirection : LorentzianIndex) :
    p286HolonomicSecondJetBFDivergenceResponseTerm jet direction
        derivativeDirection =
      2 * ∑ pair : Fin 6,
        lorentzianTwoFormSign pair *
          p286CoordinateLiePairing
            (p286HolonomicSecondJetCurvatureSymbol jet derivativeDirection
              pair)
            (p286GaugeExteriorDerivativeDirection derivativeDirection
              direction pair) := by
  unfold p286HolonomicSecondJetBFDivergenceResponseTerm
    p286GaugeBFCurvatureIncrementDensity
  rw [← p286GaugeAuxiliaryHodgePairingPolynomial_eq
    (colorCartanQuadraticResidualRepair.coframe 0)
    (colorCartanQuadraticResidualRepair_nondegenerate 0)]
  change
    abs (Matrix.det (canonicalPhysicalSource.coframeAt 0)) *
        p286GaugeAuxiliaryHodgePairingPolynomial
          (canonicalPhysicalSource.coframeAt 0)
          (p286GaugeConstitutiveAuxiliaryCoordinate
            positiveSmoothUnifiedSource
            (canonicalPhysicalSource.coframeAt 0)
            (p286HolonomicSecondJetCurvatureSymbol jet derivativeDirection))
          (p286GaugeExteriorDerivativeDirection derivativeDirection
            direction) =
      _
  rw [positiveSourceP286ConstitutiveMomentumPolynomial_normalForm
    (p286HolonomicSecondJetCurvatureSymbol jet derivativeDirection)
    (p286GaugeExteriorDerivativeDirection derivativeDirection direction) 0]
  apply congrArg (fun value : ℝ => 2 * value)
  apply Finset.sum_congr rfl
  intro pair _
  change
    lorentzianTwoFormSign pair *
        p286CoordinateLiePairing
          (p286PositiveSourceFramedField
            (fun _ =>
              p286HolonomicSecondJetCurvatureSymbol jet derivativeDirection)
            0 pair)
          (p286PositiveSourceFramedField
            (fun _ =>
              p286GaugeExteriorDerivativeDirection derivativeDirection
                direction)
            0 pair) =
      _
  rw [
    congrFun
      (p286PositiveSourceFramedField_const_origin
        (p286HolonomicSecondJetCurvatureSymbol jet derivativeDirection))
      pair,
    congrFun
      (p286PositiveSourceFramedField_const_origin
      (p286GaugeExteriorDerivativeDirection derivativeDirection direction))
      pair]

/-- Directional derivative of the actual momentum displacement for an
arbitrary fixed two-form direction. -/
theorem colorCartanRepairSecondJetMomentumDisplacement_derivative_origin
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ)
    (direction : P286GaugeTwoForm)
    (derivativeDirection : LorentzianIndex) :
    fieldDirectionalDerivative
        (colorCartanRepairSecondJetMomentumDisplacement jet parameter
          direction)
        0 derivativeDirection =
      parameter *
        (2 * ∑ pair : Fin 6,
          lorentzianTwoFormSign pair *
            p286CoordinateLiePairing
              (p286HolonomicSecondJetCurvatureSymbol jet
                derivativeDirection pair)
              (direction pair)) := by
  let displacement :=
    colorCartanRepairSecondJetCurvatureDisplacement jet parameter
  let framedDisplacement :=
    p286PositiveSourceFramedField displacement
  let framedDirection :=
    p286PositiveSourceFramedField (fun _ => direction)
  let pairingField : Fin 6 → BasePoint → ℝ := fun pair point =>
    p286CoordinateLiePairing
      (framedDisplacement point pair) (framedDirection point pair)
  let summand : Fin 6 → BasePoint → ℝ := fun pair point =>
    lorentzianTwoFormSign pair * pairingField pair point
  have displacementSmooth : ContDiff ℝ ∞ displacement :=
    colorCartanRepairSecondJetCurvatureDisplacement_contDiff jet parameter
  have framedDisplacementSmooth : ContDiff ℝ ∞ framedDisplacement :=
    p286PositiveSourceFramedField_contDiff displacement displacementSmooth
  have framedDirectionSmooth : ContDiff ℝ ∞ framedDirection :=
    p286PositiveSourceFramedField_contDiff (fun _ => direction) contDiff_const
  have pairingSmooth (pair : Fin 6) :
      ContDiff ℝ ∞ (pairingField pair) := by
    exact p286CoordinateLiePairing_apply_contDiff
      (fun point => framedDisplacement point pair)
      (fun point => framedDirection point pair)
      (contDiff_pi.mp framedDisplacementSmooth pair)
      (contDiff_pi.mp framedDirectionSmooth pair)
  have summandSmooth (pair : Fin 6) :
      ContDiff ℝ ∞ (summand pair) := by
    exact contDiff_const.mul (pairingSmooth pair)
  have sumSmooth :
      ContDiff ℝ ∞ (fun point => ∑ pair : Fin 6, summand pair point) := by
    apply ContDiff.sum
    intro pair _
    exact summandSmooth pair
  have summandDerivative (pair : Fin 6) :
      fieldDirectionalDerivative (summand pair) 0 derivativeDirection =
        lorentzianTwoFormSign pair *
          (parameter *
            p286CoordinateLiePairing
              (p286HolonomicSecondJetCurvatureSymbol jet
                derivativeDirection pair)
              (direction pair)) := by
    unfold summand
    rw [fieldDirectionalDerivative_const_mul_real_local
      (pairingField pair) (pairingSmooth pair)
      (lorentzianTwoFormSign pair) derivativeDirection]
    unfold pairingField framedDisplacement framedDirection displacement
    rw [
      colorCartanRepairSecondJetMomentumPairing_derivative_origin]
  change
    fieldDirectionalDerivative
        (fun point => 2 * ∑ pair : Fin 6, summand pair point)
        0 derivativeDirection =
      _
  rw [fieldDirectionalDerivative_const_mul_real_local
      (fun point => ∑ pair : Fin 6, summand pair point)
      sumSmooth 2 derivativeDirection,
    fieldDirectionalDerivative_finset_sum_real_local
      summand summandSmooth derivativeDirection]
  simp_rw [summandDerivative]
  have sumScale :
      (∑ pair : Fin 6,
        lorentzianTwoFormSign pair *
          (parameter *
            p286CoordinateLiePairing
              (p286HolonomicSecondJetCurvatureSymbol jet
                derivativeDirection pair)
              (direction pair))) =
        parameter *
          ∑ pair : Fin 6,
            lorentzianTwoFormSign pair *
              p286CoordinateLiePairing
                (p286HolonomicSecondJetCurvatureSymbol jet
                  derivativeDirection pair)
                (direction pair) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro pair _
    ring
  rw [sumScale]
  ring

/-- The derivative of the actual momentum displacement is exactly the
action-native response term for the selected exterior direction. -/
theorem
    colorCartanRepairSecondJetMomentumDisplacement_exteriorDerivative_origin
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ)
    (direction : P286GaugeOneForm)
    (derivativeDirection : LorentzianIndex) :
    fieldDirectionalDerivative
        (colorCartanRepairSecondJetMomentumDisplacement jet parameter
          (p286GaugeExteriorDerivativeDirection derivativeDirection
            direction))
        0 derivativeDirection =
      parameter *
        p286HolonomicSecondJetBFDivergenceResponseTerm jet direction
          derivativeDirection := by
  rw [
    colorCartanRepairSecondJetMomentumDisplacement_derivative_origin,
    p286HolonomicSecondJetBFDivergenceResponseTerm_normalForm]

/-- Per-derivative-direction affine law for the actual synchronized
constitutive momentum. -/
theorem
    colorCartanRepairSecondJetConstitutiveResponse_p286MomentumDerivative_origin
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ)
    (direction : P286GaugeOneForm)
    (derivativeDirection : LorentzianIndex) :
    fieldDirectionalDerivative
        (p286GaugeConnectionBFDifferentialMomentum
          (colorCartanRepairSecondJetConstitutiveResponse jet parameter)
          (p286GaugeExteriorDerivativeDirection derivativeDirection
            direction))
        0 derivativeDirection =
      fieldDirectionalDerivative
          (p286GaugeConnectionBFDifferentialMomentum
            colorCartanQuadraticResidualRepair
            (p286GaugeExteriorDerivativeDirection derivativeDirection
              direction))
          0 derivativeDirection +
        parameter *
          p286HolonomicSecondJetBFDivergenceResponseTerm jet direction
            derivativeDirection := by
  rw [
    colorCartanRepairSecondJetConstitutiveResponse_p286Momentum_eq_affine]
  rw [fieldDirectionalDerivative_add_real_local _ _
    (p286GaugeConnectionBFDifferentialMomentum_contDiff
      colorCartanQuadraticResidualRepair
      colorCartanQuadraticResidualRepair_smooth
      colorCartanQuadraticResidualRepair_nondegenerate
      (p286GaugeExteriorDerivativeDirection derivativeDirection direction))
    (colorCartanRepairSecondJetMomentumDisplacement_contDiff jet parameter
      (p286GaugeExteriorDerivativeDirection derivativeDirection direction))]
  rw [
    colorCartanRepairSecondJetMomentumDisplacement_exteriorDerivative_origin]

/-- Exact origin BF-divergence displacement of the synchronized response. -/
theorem
    colorCartanRepairSecondJetConstitutiveResponse_p286Divergence_origin
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ)
    (direction : P286GaugeOneForm) :
    p286GaugeConnectionBFDifferentialMomentumDivergence
        (colorCartanRepairSecondJetConstitutiveResponse jet parameter)
        direction 0 =
      p286GaugeConnectionBFDifferentialMomentumDivergence
          colorCartanQuadraticResidualRepair direction 0 +
        parameter *
          p286HolonomicSecondJetBFDivergenceResponseValue jet direction := by
  unfold p286GaugeConnectionBFDifferentialMomentumDivergence
    p286HolonomicSecondJetBFDivergenceResponseValue
  simp_rw [
    colorCartanRepairSecondJetConstitutiveResponse_p286MomentumDerivative_origin]
  rw [Finset.sum_add_distrib, ← Finset.mul_sum]

/-- Scalar readout of the complete affine Euler--Lagrange response. -/
theorem
    colorCartanRepairSecondJetConstitutiveResponse_p286EulerLagrangeCoefficient_origin
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ)
    (direction : P286GaugeOneForm) :
    p286GaugeConnectionEulerLagrangeCoefficient positiveSmoothUnifiedSource
        (colorCartanRepairSecondJetConstitutiveResponse jet parameter)
        direction 0 =
      p286GaugeConnectionEulerLagrangeCoefficient positiveSmoothUnifiedSource
          colorCartanQuadraticResidualRepair direction 0 +
        parameter *
          p286HolonomicSecondJetEulerLagrangeResponse jet direction := by
  unfold p286GaugeConnectionEulerLagrangeCoefficient
  rw [
    colorCartanRepairSecondJetConstitutiveResponse_algebraicCurrent_origin,
    colorCartanRepairSecondJetConstitutiveResponse_p286Divergence_origin,
    p286HolonomicSecondJetEulerLagrangeResponse_apply]
  ring

/-- Complete origin residual dual of the actual synchronized second-jet
family. -/
def colorCartanRepairSecondJetConstitutiveResponseOriginResidual
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ) :
    Module.Dual ℝ P286GaugeOneForm :=
  p286GaugeConnectionEulerLagrangeAt positiveSmoothUnifiedSource
    (colorCartanRepairSecondJetConstitutiveResponse jet parameter)
    (colorCartanRepairSecondJetConstitutiveResponse_smooth jet parameter)
    (colorCartanRepairSecondJetConstitutiveResponse_nondegenerate jet
      parameter)
    0

/-- C3h82c producer theorem: the actual synchronized configuration has an
exact affine origin residual in the full P286 gauge-variation dual.  This is
not a selected-direction receipt. -/
theorem
    colorCartanRepairSecondJetConstitutiveResponseOriginResidual_eq_affine
    (jet : P286HolonomicConnectionSecondJet) (parameter : ℝ) :
    colorCartanRepairSecondJetConstitutiveResponseOriginResidual jet
        parameter =
      colorCartanQuadraticResidualRepairOriginResidual +
        parameter • p286HolonomicSecondJetEulerLagrangeResponse jet := by
  apply LinearMap.ext
  intro direction
  change
    p286GaugeConnectionEulerLagrangeCoefficient positiveSmoothUnifiedSource
        (colorCartanRepairSecondJetConstitutiveResponse jet parameter)
        direction 0 =
      p286GaugeConnectionEulerLagrangeCoefficient positiveSmoothUnifiedSource
          colorCartanQuadraticResidualRepair direction 0 +
        parameter *
          p286HolonomicSecondJetEulerLagrangeResponse jet direction
  exact
    colorCartanRepairSecondJetConstitutiveResponse_p286EulerLagrangeCoefficient_origin
      jet parameter direction

/-! ## Positive and negative full-dual regressions -/

/-- The full-dual response recovers the independently established C3h78
color-Cartan slope. -/
theorem
    p286HolonomicSecondJetEulerLagrangeResponse_colorCartanQuadratic_colorCartan :
    p286HolonomicSecondJetEulerLagrangeResponse
        colorCartanQuadraticHolonomicSecondJet colorCartanMuZeroDirection =
      8 := by
  rw [p286HolonomicSecondJetEulerLagrangeResponse_apply]
  unfold p286HolonomicSecondJetBFDivergenceResponseValue
  rw [Fin.sum_univ_four]
  simp_rw [p286HolonomicSecondJetBFDivergenceResponseTerm_normalForm,
    Fin.sum_univ_six]
  simp [p286HolonomicSecondJetCurvatureSymbol,
    p286HolonomicSecondJetOrderedCurvatureSymbol,
    colorCartanQuadraticHolonomicSecondJet,
    colorCartanQuadraticSecondJetAmbient,
    colorCartanQuadraticUnitOneForm,
    p286GaugeExteriorDerivativeDirection, colorCartanMuZeroDirection,
    ContinuousLinearMap.smulRight_apply, p286BaseCoordinate_apply,
    coordinateDirection, lorentzianTwoFormSign, minkowskiInternalSign,
    pairFirst, pairSecond]
  change
    2 * p286CoordinateLiePairing
        (-(2 • colorCartanQuadraticCoordinate))
        (-colorCartanQuadraticCoordinate) = 8
  rw [p286CoordinateLiePairing_neg_left_local,
    p286CoordinateLiePairing_neg_right_local,
    p286CoordinateLiePairing_smul_left,
    colorCartanQuadraticCoordinate_pairing_self]
  norm_num

/-- The same nonzero Hessian does not move the independent commutator
channel; the existing residual there therefore remains exposed. -/
theorem
    p286HolonomicSecondJetEulerLagrangeResponse_colorCartanQuadratic_commutator :
    p286HolonomicSecondJetEulerLagrangeResponse
        colorCartanQuadraticHolonomicSecondJet p286CommutatorProbe =
      0 := by
  rw [p286HolonomicSecondJetEulerLagrangeResponse_apply]
  unfold p286HolonomicSecondJetBFDivergenceResponseValue
  rw [Fin.sum_univ_four]
  simp_rw [p286HolonomicSecondJetBFDivergenceResponseTerm_normalForm,
    Fin.sum_univ_six]
  simp [p286HolonomicSecondJetCurvatureSymbol,
    p286HolonomicSecondJetOrderedCurvatureSymbol,
    colorCartanQuadraticHolonomicSecondJet,
    colorCartanQuadraticSecondJetAmbient,
    colorCartanQuadraticUnitOneForm,
    p286GaugeExteriorDerivativeDirection, p286CommutatorProbe,
    ContinuousLinearMap.smulRight_apply, p286BaseCoordinate_apply,
    coordinateDirection, lorentzianTwoFormSign, minkowskiInternalSign,
    pairFirst, pairSecond]
  change
    p286CoordinateLiePairing (-(2 • colorCartanQuadraticCoordinate))
        (-(p286CoordinateEquiv p286CommutatorProbeData)) = 0
  rw [p286CoordinateLiePairing_neg_left_local,
    p286CoordinateLiePairing_neg_right_local,
    p286CoordinateLiePairing_smul_left,
    colorCartanQuadraticCoordinate_pairing_commutatorProbe_eq_zero]
  norm_num

/-- Every longitudinal Hessian in the already exhibited curvature-symbol
kernel is also invisible to the constitutive Euler--Lagrange response. -/
theorem
    p286HolonomicSecondJetEulerLagrangeResponse_longitudinal_eq_zero :
    p286HolonomicSecondJetEulerLagrangeResponse
        longitudinalColorCartanHolonomicSecondJet = 0 := by
  apply LinearMap.ext
  intro direction
  rw [p286HolonomicSecondJetEulerLagrangeResponse_apply]
  unfold p286HolonomicSecondJetBFDivergenceResponseValue
  simp_rw [p286HolonomicSecondJetBFDivergenceResponseTerm_normalForm]
  rw [
    longitudinalColorCartanHolonomicSecondJet_curvatureSymbol_eq_zero]
  simp

/-- Stable kernel checkpoint: the full constitutive response is not
injective, so later zero-fiber work must quotient or transport this
responsibility rather than choose an arbitrary Hessian preimage. -/
theorem p286HolonomicSecondJetEulerLagrangeResponse_not_injective :
    ¬ Function.Injective p286HolonomicSecondJetEulerLagrangeResponse := by
  intro injective
  apply longitudinalColorCartanHolonomicSecondJet_ne_zero
  apply injective
  rw [
    p286HolonomicSecondJetEulerLagrangeResponse_longitudinal_eq_zero,
    map_zero]

/-- Positive actual-family regression in the repaired color-Cartan
direction. -/
theorem
    colorCartanRepairSecondJetConstitutiveResponseOriginResidual_colorCartan
    (parameter : ℝ) :
    colorCartanRepairSecondJetConstitutiveResponseOriginResidual
        colorCartanQuadraticHolonomicSecondJet parameter
        colorCartanMuZeroDirection =
      8 * parameter := by
  rw [
    colorCartanRepairSecondJetConstitutiveResponseOriginResidual_eq_affine]
  change
    colorCartanQuadraticResidualRepairOriginResidual
          colorCartanMuZeroDirection +
        parameter *
          p286HolonomicSecondJetEulerLagrangeResponse
            colorCartanQuadraticHolonomicSecondJet
            colorCartanMuZeroDirection =
      _
  rw [
    colorCartanQuadraticResidualRepairOriginResidual_colorCartan_eq_zero,
    p286HolonomicSecondJetEulerLagrangeResponse_colorCartanQuadratic_colorCartan]
  ring

/-- Negative actual-family regression: the independent commutator residual
remains `-3` for every color-Cartan Hessian amplitude. -/
theorem
    colorCartanRepairSecondJetConstitutiveResponseOriginResidual_commutator
    (parameter : ℝ) :
    colorCartanRepairSecondJetConstitutiveResponseOriginResidual
        colorCartanQuadraticHolonomicSecondJet parameter
        p286CommutatorProbe =
      -3 := by
  rw [
    colorCartanRepairSecondJetConstitutiveResponseOriginResidual_eq_affine]
  change
    colorCartanQuadraticResidualRepairOriginResidual p286CommutatorProbe +
        parameter *
          p286HolonomicSecondJetEulerLagrangeResponse
            colorCartanQuadraticHolonomicSecondJet p286CommutatorProbe =
      _
  rw [
    colorCartanQuadraticResidualRepairOriginResidual_commutator_eq_neg_three,
    p286HolonomicSecondJetEulerLagrangeResponse_colorCartanQuadratic_commutator]
  ring

/-- A nonzero longitudinal Hessian leaves the complete actual origin
residual dual unchanged for every amplitude. -/
theorem
    colorCartanRepairSecondJetConstitutiveResponseOriginResidual_longitudinal
    (parameter : ℝ) :
    colorCartanRepairSecondJetConstitutiveResponseOriginResidual
        longitudinalColorCartanHolonomicSecondJet parameter =
      colorCartanQuadraticResidualRepairOriginResidual := by
  rw [
    colorCartanRepairSecondJetConstitutiveResponseOriginResidual_eq_affine,
    p286HolonomicSecondJetEulerLagrangeResponse_longitudinal_eq_zero]
  simp

end

