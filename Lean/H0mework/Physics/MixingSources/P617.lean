import H0mework.Physics.MixingSources.P616

/-!
# Proposition 617: a four-card CKM sector-axis primitive packet

P616 proves that the CKM/Jarlskog depth sum only needs the sector-axis pair

* `sectorSlope`;
* `sectorCurvature`.

This file lowers that pair to the smallest finite-card packet currently needed
for the CKM nail:

* low-energy electromagnetic denominator;
* low-energy visible gauge card;
* unified SU(7) gauge freedom;
* unit card.

The full eleven-card Yukawa primitive packet from P604 still produces the
whole nine-depth table.  But for CKM/Jarlskog `386`, only this four-card
projection is necessary.

Boundary: this is still finite-card production.  It does not prove why
continuous SU(7)-breaking dynamics selects these cards; it proves that once
these four carrier cards are supplied, the CKM/Jarlskog depth sum is forced.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

/-! ## Minimal sector-axis primitive packet -/

/-- The minimal finite-card packet needed for the CKM/Jarlskog sector-axis
producer. -/
structure CKMSectorAxisPrimitiveCardPacket where
  alphaDenominator : Int
  visibleGauge : Int
  unifiedGaugeFreedom : Int
  unit : Int

/-- The canonical CKM sector-axis packet, read from existing finite carriers. -/
def canonicalCKMSectorAxisPrimitiveCardPacket :
    CKMSectorAxisPrimitiveCardPacket where
  alphaDenominator := alphaEMIntegerDenominator ℤ
  visibleGauge := visibleGaugeCarrierCardFromLowEnergyZ
  unifiedGaugeFreedom := su7GaugeFreedomDimension ℤ
  unit := yukawaCoefficientUnitCardZ

/-- THEOREM 1: the canonical sector-axis packet evaluates to
`137, 9, 48, 1`. -/
theorem canonicalCKMSectorAxisPrimitiveCardPacket_values :
    canonicalCKMSectorAxisPrimitiveCardPacket.alphaDenominator = 137 ∧
      canonicalCKMSectorAxisPrimitiveCardPacket.visibleGauge = 9 ∧
      canonicalCKMSectorAxisPrimitiveCardPacket.unifiedGaugeFreedom = 48 ∧
      canonicalCKMSectorAxisPrimitiveCardPacket.unit = 1 := by
  norm_num [canonicalCKMSectorAxisPrimitiveCardPacket,
    alphaEMIntegerDenominator, su7GaugeFreedomDimension,
    visibleGaugeCarrierCardFromLowEnergyZ_eq_nine,
    yukawaCoefficientUnitCardZ]

/-- Source equations for the minimal four-card CKM packet. -/
def CKMSectorAxisPrimitiveCardSourceEquations
    (P : CKMSectorAxisPrimitiveCardPacket) : Prop :=
  P.alphaDenominator = alphaEMIntegerDenominator ℤ ∧
    P.visibleGauge = visibleGaugeCarrierCardFromLowEnergyZ ∧
    P.unifiedGaugeFreedom = su7GaugeFreedomDimension ℤ ∧
    P.unit = yukawaCoefficientUnitCardZ

/-- THEOREM 2: the canonical four-card packet satisfies the source equations.
-/
theorem canonicalCKMSectorAxisPrimitiveCardPacket_sourceEquations :
    CKMSectorAxisPrimitiveCardSourceEquations
      canonicalCKMSectorAxisPrimitiveCardPacket := by
  simp [CKMSectorAxisPrimitiveCardSourceEquations,
    canonicalCKMSectorAxisPrimitiveCardPacket]

/-- THEOREM 3: the four-card source surface is a singleton. -/
theorem eq_canonicalCKMSectorAxisPrimitiveCardPacket_of_sourceEquations
    (P : CKMSectorAxisPrimitiveCardPacket)
    (hP : CKMSectorAxisPrimitiveCardSourceEquations P) :
    P = canonicalCKMSectorAxisPrimitiveCardPacket := by
  cases P with
  | mk alphaDenominator visibleGauge unifiedGaugeFreedom unit =>
    unfold CKMSectorAxisPrimitiveCardSourceEquations at hP
    rcases hP with ⟨hAlpha, hVisible, hUnified, hUnit⟩
    dsimp at hAlpha
    dsimp at hVisible
    dsimp at hUnified
    dsimp at hUnit
    subst alphaDenominator
    subst visibleGauge
    subst unifiedGaugeFreedom
    subst unit
    rfl

/-! ## Four-card packet as a sector-axis stencil producer -/

/-- A rational stencil whose CKM-relevant sector-axis fields are generated by
the four-card packet.  All other coefficients are deliberately set to zero:
P616 proves they cannot affect the CKM/Jarlskog depth sum. -/
def rationalStencilOfCKMSectorAxisPrimitiveCardPacket
    (P : CKMSectorAxisPrimitiveCardPacket) :
    RationalYukawaBiquadraticStencil where
  center := 0
  generationSlope := 0
  sectorSlope := (P.unifiedGaugeFreedom - P.unit : Int)
  generationCurvature := 0
  sectorCurvature := -((P.alphaDenominator + P.visibleGauge : Int))
  mixedTwist := 0
  generationCurvatureSector := 0
  generationSectorCurvature := 0
  bicurvature := 0

/-- THEOREM 4: any four-card source-surface packet satisfies the P616
sector-axis source equations. -/
theorem ckmSectorAxisPrimitiveCardPacket_sectorAxisSourceEquations
    (P : CKMSectorAxisPrimitiveCardPacket)
    (hP : CKMSectorAxisPrimitiveCardSourceEquations P) :
    RationalStencilSectorAxisSourceEquations
      (rationalStencilOfCKMSectorAxisPrimitiveCardPacket P) := by
  rcases hP with ⟨hAlpha, hVisible, hUnified, hUnit⟩
  constructor
  · norm_num [rationalStencilOfCKMSectorAxisPrimitiveCardPacket,
      hUnified, hUnit, su7GaugeFreedomDimension, yukawaCoefficientUnitCardZ]
  · norm_num [rationalStencilOfCKMSectorAxisPrimitiveCardPacket,
      hAlpha, hVisible, alphaEMIntegerDenominator,
      visibleGaugeCarrierCardFromLowEnergyZ_eq_nine]

/-- THEOREM 5: any four-card source-surface packet forces CKM/Jarlskog depth
sum `386`. -/
theorem ckmSectorAxisPrimitiveCardPacket_jarlskogDepthSum_eq_386
    (P : CKMSectorAxisPrimitiveCardPacket)
    (hP : CKMSectorAxisPrimitiveCardSourceEquations P) :
    ckmJarlskogDepthSumFromRationalGrid
        (gridOfStencil
          (rationalStencilOfCKMSectorAxisPrimitiveCardPacket P)) =
      (386 : ℚ) :=
  rationalStencilSectorAxisSourceEquations_jarlskogDepthSum_eq_386
    (rationalStencilOfCKMSectorAxisPrimitiveCardPacket P)
    (ckmSectorAxisPrimitiveCardPacket_sectorAxisSourceEquations P hP)

/-- THEOREM 6: the canonical four-card packet forces CKM/Jarlskog depth sum
`386`. -/
theorem canonicalCKMSectorAxisPrimitiveCardPacket_jarlskogDepthSum_eq_386 :
    ckmJarlskogDepthSumFromRationalGrid
        (gridOfStencil
          (rationalStencilOfCKMSectorAxisPrimitiveCardPacket
            canonicalCKMSectorAxisPrimitiveCardPacket)) =
      (386 : ℚ) :=
  ckmSectorAxisPrimitiveCardPacket_jarlskogDepthSum_eq_386
    canonicalCKMSectorAxisPrimitiveCardPacket
    canonicalCKMSectorAxisPrimitiveCardPacket_sourceEquations

/-! ## Projection from the full Yukawa primitive-card packet -/

/-- Forget the full eleven-card Yukawa packet down to the four cards needed by
the CKM/Jarlskog sector-axis producer. -/
def ckmSectorAxisPacketOfYukawaPrimitiveCardPacket
    (P : YukawaCoefficientPrimitiveCardPacket) :
    CKMSectorAxisPrimitiveCardPacket where
  alphaDenominator := P.alphaDenominator
  visibleGauge := P.visibleGauge
  unifiedGaugeFreedom := P.unifiedGaugeFreedom
  unit := P.unit

/-- THEOREM 7: a full Yukawa primitive-card source-surface packet projects to
the minimal CKM four-card source surface. -/
theorem ckmSectorAxisSourceEquations_of_yukawaPrimitiveCardSourceEquations
    (P : YukawaCoefficientPrimitiveCardPacket)
    (hP : YukawaPrimitiveCardSourceEquations P) :
    CKMSectorAxisPrimitiveCardSourceEquations
      (ckmSectorAxisPacketOfYukawaPrimitiveCardPacket P) := by
  rcases hP with
    ⟨hAlpha, _hInfo, hVisible, hUnified, _hGauged, _hSectors,
      _hSinglets, _hBlocks, _hPoincare, hUnit, _hSupport⟩
  exact ⟨hAlpha, hVisible, hUnified, hUnit⟩

/-- THEOREM 8: the minimal CKM four-card projection of any full Yukawa
source-surface packet forces Jarlskog depth sum `386`. -/
theorem ckmSectorAxisProjectionOfYukawaPacket_jarlskogDepthSum_eq_386
    (P : YukawaCoefficientPrimitiveCardPacket)
    (hP : YukawaPrimitiveCardSourceEquations P) :
    ckmJarlskogDepthSumFromRationalGrid
        (gridOfStencil
          (rationalStencilOfCKMSectorAxisPrimitiveCardPacket
            (ckmSectorAxisPacketOfYukawaPrimitiveCardPacket P))) =
      (386 : ℚ) :=
  ckmSectorAxisPrimitiveCardPacket_jarlskogDepthSum_eq_386
    (ckmSectorAxisPacketOfYukawaPrimitiveCardPacket P)
    (ckmSectorAxisSourceEquations_of_yukawaPrimitiveCardSourceEquations P hP)

/-! ## Bundled receipt -/

/-- Compact receipt: the CKM/Jarlskog producer only needs a four-card
primitive packet, and the full Yukawa primitive-card packet projects to it. -/
structure CKMSectorAxisPrimitiveCardProducerReceipt where
  canonical_values :
    canonicalCKMSectorAxisPrimitiveCardPacket.alphaDenominator = 137 ∧
      canonicalCKMSectorAxisPrimitiveCardPacket.visibleGauge = 9 ∧
      canonicalCKMSectorAxisPrimitiveCardPacket.unifiedGaugeFreedom = 48 ∧
      canonicalCKMSectorAxisPrimitiveCardPacket.unit = 1
  canonical_source :
    CKMSectorAxisPrimitiveCardSourceEquations
      canonicalCKMSectorAxisPrimitiveCardPacket
  source_surface_singleton :
    ∀ P : CKMSectorAxisPrimitiveCardPacket,
      CKMSectorAxisPrimitiveCardSourceEquations P ->
        P = canonicalCKMSectorAxisPrimitiveCardPacket
  source_surface_to_sector_axis :
    ∀ P : CKMSectorAxisPrimitiveCardPacket,
      CKMSectorAxisPrimitiveCardSourceEquations P ->
        RationalStencilSectorAxisSourceEquations
          (rationalStencilOfCKMSectorAxisPrimitiveCardPacket P)
  source_surface_jarlskog :
    ∀ P : CKMSectorAxisPrimitiveCardPacket,
      CKMSectorAxisPrimitiveCardSourceEquations P ->
        ckmJarlskogDepthSumFromRationalGrid
            (gridOfStencil
              (rationalStencilOfCKMSectorAxisPrimitiveCardPacket P)) =
          (386 : ℚ)
  full_yukawa_packet_projection :
    ∀ P : YukawaCoefficientPrimitiveCardPacket,
      YukawaPrimitiveCardSourceEquations P ->
        CKMSectorAxisPrimitiveCardSourceEquations
          (ckmSectorAxisPacketOfYukawaPrimitiveCardPacket P)

/-- THEOREM 9: four-card primitive producer receipt for CKM/Jarlskog. -/
theorem ckmSectorAxisPrimitiveCardProducerReceipt :
    CKMSectorAxisPrimitiveCardProducerReceipt where
  canonical_values := canonicalCKMSectorAxisPrimitiveCardPacket_values
  canonical_source := canonicalCKMSectorAxisPrimitiveCardPacket_sourceEquations
  source_surface_singleton :=
    eq_canonicalCKMSectorAxisPrimitiveCardPacket_of_sourceEquations
  source_surface_to_sector_axis :=
    ckmSectorAxisPrimitiveCardPacket_sectorAxisSourceEquations
  source_surface_jarlskog :=
    ckmSectorAxisPrimitiveCardPacket_jarlskogDepthSum_eq_386
  full_yukawa_packet_projection :=
    ckmSectorAxisSourceEquations_of_yukawaPrimitiveCardSourceEquations

end StandardModelConstraint
end SaturationMonoid
