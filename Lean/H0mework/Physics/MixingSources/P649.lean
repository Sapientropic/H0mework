import H0mework.Physics.YukawaSources.P648

/-!
# Proposition 649: finite CKM/Jarlskog producer-debt closure

P644 proves the typed Jarlskog factors and sum on the selected Yukawa depth
table.  P648 proves that primitive finite cards plus an endpoint-preserving
SU(7) sector schedule force that selected table.

This file composes the two: any table generated by the finite primitive-card /
endpoint-ordering producer has typed factors

`V_us = -226`, `V_cb = -143`, `V_ub* = 562`, `V_cs* = 193`,

and therefore Jarlskog depth sum `386`.

Boundary: this is the CKM phase-depth producer, not a full CKM matrix
construction.
-/

noncomputable section

namespace SaturationMonoid
namespace StandardModelConstraint

open InformationMatterProjection

/-! ## Typed factors forced by the finite depth producer -/

/-- THEOREM 1: any finite primitive-card / endpoint-ordering Yukawa table
forces the typed Jarlskog factor values. -/
theorem ckmJarlskogFactors_forced_of_primitiveCards_and_endpointSchedule
    (P : YukawaCoefficientPrimitiveCardPacket)
    (f : YukawaInteractionSector -> InformationSlot)
    (T : YukawaDepthTableCandidate)
    (hP : YukawaPrimitiveCardSourceEquations P)
    (hf : YukawaSectorEndpointSignaturePreservingSchedule f)
    (hT :
      T =
        coefficientScheduleYukawaDepthTableCandidate
          (primitiveCardYukawaDepthStencilCoefficientVector P) f) :
    CKMJarlskogFactor.depthContribution T .V_us = (-226 : Int) ∧
      CKMJarlskogFactor.depthContribution T .V_cb = (-143 : Int) ∧
        CKMJarlskogFactor.depthContribution T .V_ub_conj = (562 : Int) ∧
          CKMJarlskogFactor.depthContribution T .V_cs_conj = (193 : Int) := by
  rw [yukawaDepthTable_forced_of_primitiveCards_and_endpointSchedule
    P f T hP hf hT]
  exact
    ⟨selectedCKMJarlskogFactor_V_us_eq_neg226,
      selectedCKMJarlskogFactor_V_cb_eq_neg143,
      selectedCKMJarlskogFactor_V_ub_conj_eq_562,
      selectedCKMJarlskogFactor_V_cs_conj_eq_193⟩

/-- THEOREM 2: any finite primitive-card / endpoint-ordering Yukawa table
forces the typed Jarlskog four-product depth sum `386`. -/
theorem ckmJarlskogDepthSum_forced_of_primitiveCards_and_endpointSchedule
    (P : YukawaCoefficientPrimitiveCardPacket)
    (f : YukawaInteractionSector -> InformationSlot)
    (T : YukawaDepthTableCandidate)
    (hP : YukawaPrimitiveCardSourceEquations P)
    (hf : YukawaSectorEndpointSignaturePreservingSchedule f)
    (hT :
      T =
        coefficientScheduleYukawaDepthTableCandidate
          (primitiveCardYukawaDepthStencilCoefficientVector P) f) :
    ckmJarlskogFourProductDepthSum T = (ckmCPDepthSum : Int) := by
  rw [yukawaDepthTable_forced_of_primitiveCards_and_endpointSchedule
    P f T hP hf hT]
  exact selectedCKMJarlskogFourProductDepthSum_eq_386

/-- THEOREM 3: the expanded typed-factor sum is the same finite producer
output `386`. -/
theorem ckmJarlskogExpandedDepthSum_forced :
    (-226 : Int) + (-143 : Int) + (562 : Int) + (193 : Int) =
      (ckmCPDepthSum : Int) :=
  selectedCKMJarlskogFourProduct_expanded_eq_386

/-! ## Bundled CKM closure certificate -/

/-- Compact certificate: the current finite CKM/Jarlskog producer debt is
closed at the typed phase-depth sum layer. -/
structure CKMFiniteJarlskogProducerDebtClosureCertificate where
  typed_selected_receipt :
    CKMJarlskogTypedDepthProducerReceipt
  yukawa_depth_closure :
    YukawaFiniteDepthProducerDebtClosureCertificate
  factors_forced :
    ∀ (P : YukawaCoefficientPrimitiveCardPacket)
      (f : YukawaInteractionSector -> InformationSlot)
      (T : YukawaDepthTableCandidate),
        YukawaPrimitiveCardSourceEquations P ->
          YukawaSectorEndpointSignaturePreservingSchedule f ->
            T =
              coefficientScheduleYukawaDepthTableCandidate
                (primitiveCardYukawaDepthStencilCoefficientVector P) f ->
              CKMJarlskogFactor.depthContribution T .V_us = (-226 : Int) ∧
                CKMJarlskogFactor.depthContribution T .V_cb = (-143 : Int) ∧
                  CKMJarlskogFactor.depthContribution T .V_ub_conj = (562 : Int) ∧
                    CKMJarlskogFactor.depthContribution T .V_cs_conj = (193 : Int)
  depth_sum_forced :
    ∀ (P : YukawaCoefficientPrimitiveCardPacket)
      (f : YukawaInteractionSector -> InformationSlot)
      (T : YukawaDepthTableCandidate),
        YukawaPrimitiveCardSourceEquations P ->
          YukawaSectorEndpointSignaturePreservingSchedule f ->
            T =
              coefficientScheduleYukawaDepthTableCandidate
                (primitiveCardYukawaDepthStencilCoefficientVector P) f ->
              ckmJarlskogFourProductDepthSum T = (ckmCPDepthSum : Int)
  expanded_sum :
    (-226 : Int) + (-143 : Int) + (562 : Int) + (193 : Int) =
      (ckmCPDepthSum : Int)

/-- THEOREM 4: finite CKM/Jarlskog producer-debt closure certificate. -/
theorem ckmFiniteJarlskogProducerDebtClosureCertificate :
    CKMFiniteJarlskogProducerDebtClosureCertificate where
  typed_selected_receipt := ckmJarlskogTypedDepthProducerReceipt
  yukawa_depth_closure := yukawaFiniteDepthProducerDebtClosureCertificate
  factors_forced :=
    ckmJarlskogFactors_forced_of_primitiveCards_and_endpointSchedule
  depth_sum_forced :=
    ckmJarlskogDepthSum_forced_of_primitiveCards_and_endpointSchedule
  expanded_sum := ckmJarlskogExpandedDepthSum_forced

end StandardModelConstraint
end SaturationMonoid
