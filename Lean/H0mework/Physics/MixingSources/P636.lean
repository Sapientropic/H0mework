import H0mework.Physics.YukawaSources.P604
import H0mework.Physics.AlphaSources.P635

/-!
# Proposition 636: identity of the current Yukawa/CKM producer faces

P635 identified the current `alpha_s` producer fronts as one
`AlphaStrongResidualGapProducer` object.  This file performs the analogous
tightening for the Yukawa/CKM nail.

There are two honest layers:

* full Yukawa-depth faces (primitive-card input, QCD/Poincare unified-axis
  stencil, one-axis primitive-source stencil) all generate the same selected
  rational grid and the same generated depth-table surface;
* the CKM sector-axis face is intentionally smaller.  It forgets seven Yukawa
  coefficients, so it is not the same full grid.  Lean instead identifies it
  at its correct object: the sector-axis/Jarlskog normal form, where it gives
  the same depth sum `386`.

Boundary: this is still finite-cardinality producer identity.  It does not
derive the finite cards from continuous SU(7)-breaking dynamics, RG flow, or
consolidation ordering.
-/

noncomputable section

namespace SaturationMonoid
namespace StandardModelConstraint

/-! ## Primitive-card full Yukawa face as a rational stencil/grid -/

/-- The rational stencil read from the P604 primitive-card producer input. -/
def primitiveCardYukawaRationalStencil :
    RationalYukawaBiquadraticStencil :=
  rationalStencilOfCoefficientVector
    primitiveCardYukawaProducerInputCandidate.coefficients

/-- THEOREM 1: the primitive-card rational stencil is the canonical stencil. -/
theorem primitiveCardYukawaRationalStencil_eq_canonical :
    primitiveCardYukawaRationalStencil =
      RationalYukawaBiquadraticStencil.canonical := by
  change
    rationalStencilOfCoefficientVector
        canonicalPrimitiveCardYukawaDepthStencilCoefficientVector =
      RationalYukawaBiquadraticStencil.canonical
  rw [canonicalPrimitiveCardYukawaDepthStencilCoefficientVector_eq_carrierSourced]
  exact rationalStencilOf_carrierSourcedCoefficients_eq_canonical

/-- THEOREM 2: the primitive-card rational stencil lies on the full carrier
coefficient surface. -/
theorem primitiveCardYukawaRationalStencil_surface :
    RationalStencilCarrierCoefficientSurface
      primitiveCardYukawaRationalStencil := by
  rw [primitiveCardYukawaRationalStencil_eq_canonical]
  exact canonical_rationalStencilCarrierCoefficientSurface

/-- The rational grid generated by the primitive-card full Yukawa face. -/
def primitiveCardYukawaRationalGrid : RationalYukawaDepthGrid :=
  gridOfStencil primitiveCardYukawaRationalStencil

/-- THEOREM 3: the primitive-card full Yukawa face generates the selected
rational grid. -/
theorem primitiveCardYukawaRationalGrid_eq_selected :
    primitiveCardYukawaRationalGrid = selectedYukawaDepthGrid := by
  rw [primitiveCardYukawaRationalGrid,
    primitiveCardYukawaRationalStencil_eq_canonical,
    ← selectedGrid_eq_gridOf_canonical]

/-- THEOREM 4: the primitive-card rational grid is the same grid as the
QCD/Poincare unified-axis Yukawa grid. -/
theorem primitiveCardYukawaRationalGrid_eq_unifiedAxis :
    primitiveCardYukawaRationalGrid =
      qcdPoincareUnifiedAxisYukawaDepthGrid := by
  rw [primitiveCardYukawaRationalGrid_eq_selected,
    qcdPoincareUnifiedAxisYukawaDepthGrid_eq_selected]

/-! ## One-axis primitive-source full Yukawa face -/

/-- The rational Yukawa stencil read from a primitive one-axis source
producer. -/
def oneAxisPrimitiveSourceYukawaRationalStencil
    (P : OneAxisPrimitiveSourceProducer) :
    RationalYukawaBiquadraticStencil :=
  oneAxisYukawaRationalStencil P.axis

/-- THEOREM 5: every primitive-source one-axis Yukawa stencil is canonical. -/
theorem oneAxisPrimitiveSourceYukawaRationalStencil_eq_canonical
    (P : OneAxisPrimitiveSourceProducer) :
    oneAxisPrimitiveSourceYukawaRationalStencil P =
      RationalYukawaBiquadraticStencil.canonical :=
  oneAxisYukawaRationalStencil_eq_canonical_of_sourceLaw
    (oneAxisPrimitiveSourceProducer_sourceLaw P)

/-- THEOREM 6: every primitive-source one-axis Yukawa stencil is the same
stencil as the QCD/Poincare unified-axis Yukawa stencil. -/
theorem oneAxisPrimitiveSourceYukawaRationalStencil_eq_unifiedAxis
    (P : OneAxisPrimitiveSourceProducer) :
    oneAxisPrimitiveSourceYukawaRationalStencil P =
      qcdPoincareUnifiedAxisYukawaRationalStencil := by
  rw [oneAxisPrimitiveSourceYukawaRationalStencil_eq_canonical P,
    qcdPoincareUnifiedAxisYukawaRationalStencil_eq_canonical]

/-- The rational grid generated by a primitive-source one-axis Yukawa face. -/
def oneAxisPrimitiveSourceYukawaRationalGrid
    (P : OneAxisPrimitiveSourceProducer) :
    RationalYukawaDepthGrid :=
  gridOfStencil (oneAxisPrimitiveSourceYukawaRationalStencil P)

/-- THEOREM 7: every primitive-source one-axis Yukawa face generates the
selected rational grid. -/
theorem oneAxisPrimitiveSourceYukawaRationalGrid_eq_selected
    (P : OneAxisPrimitiveSourceProducer) :
    oneAxisPrimitiveSourceYukawaRationalGrid P =
      selectedYukawaDepthGrid := by
  rw [oneAxisPrimitiveSourceYukawaRationalGrid,
    oneAxisPrimitiveSourceYukawaRationalStencil_eq_canonical P,
    ← selectedGrid_eq_gridOf_canonical]

/-- THEOREM 8: every primitive-source one-axis Yukawa grid is the primitive-card
grid. -/
theorem oneAxisPrimitiveSourceYukawaRationalGrid_eq_primitiveCard
    (P : OneAxisPrimitiveSourceProducer) :
    oneAxisPrimitiveSourceYukawaRationalGrid P =
      primitiveCardYukawaRationalGrid := by
  rw [oneAxisPrimitiveSourceYukawaRationalGrid_eq_selected P,
    primitiveCardYukawaRationalGrid_eq_selected]

/-! ## Generated depth-table face -/

/-- THEOREM 9: the primitive-card producer input is the selected P603 producer
input. -/
theorem primitiveCardYukawaProducerInput_eq_selected_face :
    primitiveCardYukawaProducerInputCandidate =
      selectedYukawaProducerInputCandidate :=
  primitiveCardYukawaProducerInputCandidate_eq_selected

/-- THEOREM 10: the primitive-card generated signed-depth table is the
selected generated table. -/
theorem primitiveCardYukawaDepthTable_eq_selected :
    primitiveCardYukawaProducerInputCandidate.depthTable =
      selectedYukawaDepthTableCandidate :=
  yukawaProducerInput_depthTable_eq_selected
    primitiveCardYukawaProducerInputCandidate
    primitiveCardYukawaProducerInputCandidate_surface

/-! ## CKM minimal sector-axis face at its correct quotient -/

/-- The P629 QCD/Poincare-axis CKM sector-axis stencil.  This is a minimal
CKM stencil, not a full Yukawa grid producer. -/
def qcdPoincareUnifiedAxisCKMSectorRationalStencil :
    RationalYukawaBiquadraticStencil :=
  rationalStencilOfCKMSectorAxisPrimitiveCardPacket
    qcdPoincareUnifiedAxisCKMSectorAxisPrimitiveCardPacket

/-- THEOREM 11: the P629 sector-axis packet is the canonical P617 packet. -/
theorem qcdPoincareUnifiedAxisCKMSectorPacket_eq_canonical_face :
    qcdPoincareUnifiedAxisCKMSectorAxisPrimitiveCardPacket =
      canonicalCKMSectorAxisPrimitiveCardPacket :=
  qcdPoincareUnifiedAxisCKMSectorAxisPrimitiveCardPacket_eq_canonical

/-- THEOREM 12: the full P604 primitive-card packet projects to the canonical
CKM four-card packet. -/
theorem primitiveCardPacket_ckmProjection_eq_canonical :
    ckmSectorAxisPacketOfYukawaPrimitiveCardPacket
        canonicalYukawaCoefficientPrimitiveCardPacket =
      canonicalCKMSectorAxisPrimitiveCardPacket :=
  eq_canonicalCKMSectorAxisPrimitiveCardPacket_of_sourceEquations
    (ckmSectorAxisPacketOfYukawaPrimitiveCardPacket
      canonicalYukawaCoefficientPrimitiveCardPacket)
    (ckmSectorAxisSourceEquations_of_yukawaPrimitiveCardSourceEquations
      canonicalYukawaCoefficientPrimitiveCardPacket
      canonicalYukawaCoefficientPrimitiveCardPacket_sourceEquations)

/-- THEOREM 13: the primitive-source one-axis CKM sector gap is the same gap
as the P627 QCD/Poincare-axis CKM sector gap. -/
theorem oneAxisPrimitiveSourceCKMSectorGap_eq_unifiedAxis
    (P : OneAxisPrimitiveSourceProducer) :
    oneAxisCKMSectorGap P.axis =
      qcdPoincareUnifiedAxisCKMSectorGap := by
  rw [oneAxisCKMSectorGap_eq_193_of_sourceLaw
      (oneAxisPrimitiveSourceProducer_sourceLaw P),
    qcdPoincareUnifiedAxisCKMSectorGap_eq_193]

/-- THEOREM 14: the P629 sector-axis face gives the same Jarlskog depth sum
`386`. -/
theorem qcdPoincareUnifiedAxisCKMSectorRationalStencil_jarlskog_eq_386 :
    ckmJarlskogDepthSumFromRationalGrid
        (gridOfStencil qcdPoincareUnifiedAxisCKMSectorRationalStencil) =
      (386 : ℚ) := by
  exact
    qcdPoincareUnifiedAxisCKMSectorAxisPrimitiveCardPacket_jarlskogDepthSum_eq_386

/-! ## Bundled identity certificate -/

/-- Compact certificate: the current finite Yukawa full-depth faces all
collapse to the selected grid/table, while the CKM minimal face collapses to
the same sector-gap/Jarlskog normal form. -/
structure YukawaCKMCurrentProducerFacesIdentityCertificate where
  primitive_stencil_canonical :
    primitiveCardYukawaRationalStencil =
      RationalYukawaBiquadraticStencil.canonical
  primitive_grid_selected :
    primitiveCardYukawaRationalGrid = selectedYukawaDepthGrid
  primitive_grid_eq_unified_axis :
    primitiveCardYukawaRationalGrid =
      qcdPoincareUnifiedAxisYukawaDepthGrid
  primitive_input_eq_selected :
    primitiveCardYukawaProducerInputCandidate =
      selectedYukawaProducerInputCandidate
  primitive_table_eq_selected :
    primitiveCardYukawaProducerInputCandidate.depthTable =
      selectedYukawaDepthTableCandidate
  one_axis_stencil_canonical :
    ∀ P : OneAxisPrimitiveSourceProducer,
      oneAxisPrimitiveSourceYukawaRationalStencil P =
        RationalYukawaBiquadraticStencil.canonical
  one_axis_stencil_eq_unified_axis :
    ∀ P : OneAxisPrimitiveSourceProducer,
      oneAxisPrimitiveSourceYukawaRationalStencil P =
        qcdPoincareUnifiedAxisYukawaRationalStencil
  one_axis_grid_eq_primitive :
    ∀ P : OneAxisPrimitiveSourceProducer,
      oneAxisPrimitiveSourceYukawaRationalGrid P =
        primitiveCardYukawaRationalGrid
  ckm_sector_packet_eq_canonical :
    qcdPoincareUnifiedAxisCKMSectorAxisPrimitiveCardPacket =
      canonicalCKMSectorAxisPrimitiveCardPacket
  primitive_packet_ckm_projection :
    ckmSectorAxisPacketOfYukawaPrimitiveCardPacket
        canonicalYukawaCoefficientPrimitiveCardPacket =
      canonicalCKMSectorAxisPrimitiveCardPacket
  one_axis_ckm_gap_eq_unified_axis :
    ∀ P : OneAxisPrimitiveSourceProducer,
      oneAxisCKMSectorGap P.axis =
        qcdPoincareUnifiedAxisCKMSectorGap
  ckm_sector_jarlskog :
    ckmJarlskogDepthSumFromRationalGrid
        (gridOfStencil qcdPoincareUnifiedAxisCKMSectorRationalStencil) =
      (386 : ℚ)

/-- THEOREM 15: current finite Yukawa/CKM producer-face identity certificate.
-/
theorem yukawaCKMCurrentProducerFacesIdentityCertificate :
    YukawaCKMCurrentProducerFacesIdentityCertificate where
  primitive_stencil_canonical :=
    primitiveCardYukawaRationalStencil_eq_canonical
  primitive_grid_selected :=
    primitiveCardYukawaRationalGrid_eq_selected
  primitive_grid_eq_unified_axis :=
    primitiveCardYukawaRationalGrid_eq_unifiedAxis
  primitive_input_eq_selected :=
    primitiveCardYukawaProducerInput_eq_selected_face
  primitive_table_eq_selected :=
    primitiveCardYukawaDepthTable_eq_selected
  one_axis_stencil_canonical :=
    oneAxisPrimitiveSourceYukawaRationalStencil_eq_canonical
  one_axis_stencil_eq_unified_axis :=
    oneAxisPrimitiveSourceYukawaRationalStencil_eq_unifiedAxis
  one_axis_grid_eq_primitive :=
    oneAxisPrimitiveSourceYukawaRationalGrid_eq_primitiveCard
  ckm_sector_packet_eq_canonical :=
    qcdPoincareUnifiedAxisCKMSectorPacket_eq_canonical_face
  primitive_packet_ckm_projection :=
    primitiveCardPacket_ckmProjection_eq_canonical
  one_axis_ckm_gap_eq_unified_axis :=
    oneAxisPrimitiveSourceCKMSectorGap_eq_unifiedAxis
  ckm_sector_jarlskog :=
    qcdPoincareUnifiedAxisCKMSectorRationalStencil_jarlskog_eq_386

end StandardModelConstraint
end SaturationMonoid
