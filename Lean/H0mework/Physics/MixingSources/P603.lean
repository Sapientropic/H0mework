import Mathlib.Tactic
import H0mework.Physics.YukawaSources.P599

/-!
# Proposition 603: singleton SU(7) Yukawa/CKM producer input

P599 proved that the *output table* generated by carrier-source coefficients
and an endpoint-preserving SU(7) sector schedule is a singleton.  This file
closes the corresponding finite *producer-input* surface:

* the coefficient vector is forced by the carrier-source equations (P594/P596);
* the sector schedule is forced by endpoint signatures (P591);
* therefore the pair `(coefficient vector, schedule)` itself is a singleton;
* the singleton pair generates the selected nine Yukawa depths and CKM/Jarlskog
  depth sum `386`.

Boundary: this is still a finite producer-input closure theorem.  It does not
derive the carrier-source equations from dynamical SU(7) breaking, RG flow, or
consolidation ordering.  It proves that once those equations are independently
produced, there is no remaining coefficient, schedule, depth-table, or CKM
depth-sum freedom.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

open InformationMatterProjection

/-! ## Producer-input candidates -/

/-- A finite producer input for the Yukawa/CKM surface: a coefficient vector
plus a sector-to-incidence schedule. -/
@[ext]
structure YukawaProducerInputCandidate where
  coefficients : YukawaDepthStencilCoefficientVector
  schedule : YukawaInteractionSector -> InformationSlot

/-- The selected finite producer input: P593's carrier-sourced coefficient
vector and P590/P591's endpoint-preserving sector incidence schedule. -/
def selectedYukawaProducerInputCandidate :
    YukawaProducerInputCandidate where
  coefficients := carrierSourcedYukawaDepthStencilCoefficientVector
  schedule := yukawaSectorInformationIncidence

/-- Accepted finite producer inputs. -/
def YukawaProducerInputSurface
    (I : YukawaProducerInputCandidate) : Prop :=
  YukawaCoefficientCarrierSourceEquations I.coefficients ∧
    YukawaSectorEndpointSignaturePreservingSchedule I.schedule

/-- The depth table generated by a producer input. -/
def YukawaProducerInputCandidate.depthTable
    (I : YukawaProducerInputCandidate) :
    YukawaDepthTableCandidate :=
  coefficientScheduleYukawaDepthTableCandidate
    I.coefficients I.schedule

/-! ## The producer-input surface is a singleton -/

/-- THEOREM 1: the selected producer input is accepted. -/
theorem selectedYukawaProducerInputCandidate_surface :
    YukawaProducerInputSurface selectedYukawaProducerInputCandidate := by
  exact
    ⟨carrierSourcedYukawaDepthStencilCoefficientVector_sourceEquations,
      yukawaSectorInformationIncidence_endpointPreserving⟩

/-- THEOREM 2: every accepted producer input is the selected producer input. -/
theorem eq_selectedYukawaProducerInputCandidate_of_surface
    (I : YukawaProducerInputCandidate)
    (hI : YukawaProducerInputSurface I) :
    I = selectedYukawaProducerInputCandidate := by
  rcases I with ⟨C, f⟩
  rcases hI with ⟨hC, hf⟩
  have hC' :
      C = carrierSourcedYukawaDepthStencilCoefficientVector :=
    eq_carrierSourced_of_sourceEquations C hC
  have hf' : f = yukawaSectorInformationIncidence :=
    yukawaSectorEndpointSignaturePreservingSchedule_unique f hf
  cases hC'
  cases hf'
  rfl

/-- Producer-input surfaces have no continuous/free parameter: any two accepted
inputs are equal. -/
def NoContinuousFreeYukawaProducerInputParameters
    (constraints : YukawaProducerInputCandidate -> Prop) : Prop :=
  ∀ I J : YukawaProducerInputCandidate,
    constraints I -> constraints J -> I = J

/-- THEOREM 3: the finite producer-input surface is singleton/no-free. -/
theorem yukawaProducerInputSurface_noContinuousFree :
    NoContinuousFreeYukawaProducerInputParameters
      YukawaProducerInputSurface := by
  intro I J hI hJ
  rw [eq_selectedYukawaProducerInputCandidate_of_surface I hI,
    eq_selectedYukawaProducerInputCandidate_of_surface J hJ]

/-! ## Depth-closure and output consequences -/

/-- THEOREM 4: for a producer input, selected-depth closure is equivalent to
being an accepted producer input. -/
theorem yukawaProducerInput_depthClosure_iff_surface
    (I : YukawaProducerInputCandidate) :
    YukawaCoefficientAcceptedSurface I.schedule I.coefficients ↔
      YukawaProducerInputSurface I := by
  constructor
  · intro h
    exact
      ⟨(yukawaAcceptedSurface_iff_sourceEquations
          I.coefficients I.schedule).mp h |>.2,
        (yukawaAcceptedSurface_iff_sourceEquations
          I.coefficients I.schedule).mp h |>.1⟩
  · intro h
    exact
      (yukawaAcceptedSurface_iff_sourceEquations
        I.coefficients I.schedule).mpr ⟨h.2, h.1⟩

/-- THEOREM 5: every accepted producer input generates the selected depth
table. -/
theorem yukawaProducerInput_depthTable_eq_selected
    (I : YukawaProducerInputCandidate)
    (hI : YukawaProducerInputSurface I) :
    I.depthTable = selectedYukawaDepthTableCandidate := by
  rw [eq_selectedYukawaProducerInputCandidate_of_surface I hI]
  ext y
  simp [YukawaProducerInputCandidate.depthTable,
    selectedYukawaProducerInputCandidate,
    selectedYukawaDepthTableCandidate,
    coefficientScheduleYukawaDepthTableCandidate]
  exact
    coefficientVectorEndpointScheduleYukawaDepthStencilOf_eq_selectedDepthZ
      carrierSourcedYukawaDepthStencilCoefficientVector
      carrierSourcedYukawaDepthStencilCoefficientVector_sourceEquations
      yukawaSectorInformationIncidence
      yukawaSectorInformationIncidence_endpointPreserving y

/-- THEOREM 6: every accepted producer input generates the documented nine
Yukawa depths in mass-order display. -/
theorem yukawaProducerInput_massOrder_eq
    (I : YukawaProducerInputCandidate)
    (hI : YukawaProducerInputSurface I) :
    I.depthTable.massOrder =
      [50, 346, 372, 489, 583, 682, 880, 908, 982] := by
  rw [yukawaProducerInput_depthTable_eq_selected I hI]
  exact selectedYukawaDepthTableCandidate_massOrder_eq

/-- THEOREM 7: every accepted producer input induces CKM/Jarlskog depth sum
`386`. -/
theorem yukawaProducerInput_ckmDepthSum_eq_386
    (I : YukawaProducerInputCandidate)
    (hI : YukawaProducerInputSurface I) :
    ckmDepthSum_fromYukawaDepthTable I.depthTable =
      (ckmCPDepthSum : Int) := by
  rw [yukawaProducerInput_depthTable_eq_selected I hI]
  exact selectedYukawaDepthTableCandidate_ckmDepthSum_eq_386

/-! ## Bundled receipt -/

/-- Compact receipt: the finite SU(7) Yukawa/CKM producer input is a singleton,
and that singleton produces both the nine-depth table and CKM depth sum `386`.
-/
structure YukawaProducerInputSingletonReceipt where
  selected_surface :
    YukawaProducerInputSurface selectedYukawaProducerInputCandidate
  input_unique :
    ∀ I : YukawaProducerInputCandidate,
      YukawaProducerInputSurface I ->
        I = selectedYukawaProducerInputCandidate
  no_free :
    NoContinuousFreeYukawaProducerInputParameters
      YukawaProducerInputSurface
  depth_closure_iff :
    ∀ I : YukawaProducerInputCandidate,
      YukawaCoefficientAcceptedSurface I.schedule I.coefficients ↔
        YukawaProducerInputSurface I
  generated_table :
    ∀ I : YukawaProducerInputCandidate,
      YukawaProducerInputSurface I ->
        I.depthTable = selectedYukawaDepthTableCandidate
  mass_order :
    ∀ I : YukawaProducerInputCandidate,
      YukawaProducerInputSurface I ->
        I.depthTable.massOrder =
          [50, 346, 372, 489, 583, 682, 880, 908, 982]
  ckm_depth_sum :
    ∀ I : YukawaProducerInputCandidate,
      YukawaProducerInputSurface I ->
        ckmDepthSum_fromYukawaDepthTable I.depthTable =
          (ckmCPDepthSum : Int)

/-- THEOREM 8: singleton producer-input receipt for the Yukawa/CKM finite
surface. -/
theorem yukawaProducerInputSingletonReceipt :
    YukawaProducerInputSingletonReceipt where
  selected_surface := selectedYukawaProducerInputCandidate_surface
  input_unique := eq_selectedYukawaProducerInputCandidate_of_surface
  no_free := yukawaProducerInputSurface_noContinuousFree
  depth_closure_iff := yukawaProducerInput_depthClosure_iff_surface
  generated_table := yukawaProducerInput_depthTable_eq_selected
  mass_order := yukawaProducerInput_massOrder_eq
  ckm_depth_sum := yukawaProducerInput_ckmDepthSum_eq_386

end StandardModelConstraint
end SaturationMonoid
