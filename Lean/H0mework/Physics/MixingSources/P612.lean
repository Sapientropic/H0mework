import Mathlib.Tactic
import H0mework.Physics.YukawaSources.P606

/-!
# Proposition 612: Jarlskog four-product normal form

P582/P599/P606 already push the CKM/Jarlskog depth sum `386` down to the
finite Yukawa-depth producer surface.  This file removes one more bit of
presentation slack: the four Jarlskog entries are not four independent
summands.

For every Yukawa depth table, the chosen Jarlskog four-product depth sum

`(n_s-n_u) + (n_b-n_c) + (n_u-n_b) + (n_s-n_c)`

cancels the `u` and `b` depths and reduces to

`2 * (n_s-n_c)`.

Thus the current `386` is structurally `2 * 193`, i.e. twice the
strange/charm depth separation generated by the same finite producer surface.

Boundary: this is still finite-depth algebra.  It does not derive the depth
table from continuous SU(7)-breaking / consolidation dynamics, nor the full
CKM matrix.  It proves that the currently certified CP-depth sum is the normal
form of the typed Jarlskog four-product rather than a four-constant sum.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

/-! ## Typed Jarlskog four-product entries -/

/-- The four CKM factors in the Jarlskog product used by the current CP-depth
slice.  The conjugation signs are built into the two `_conj` cases. -/
inductive CKMJarlskogFactor where
  | V_us
  | V_cb
  | V_ub_conj
  | V_cs_conj
  deriving DecidableEq, Repr

/-- The depth contribution of a typed Jarlskog factor, read from a Yukawa depth
table. -/
def CKMJarlskogFactor.depthContribution
    (T : YukawaDepthTableCandidate) : CKMJarlskogFactor -> Int
  | .V_us => T.depth .strange - T.depth .up
  | .V_cb => T.depth .bottom - T.depth .charm
  | .V_ub_conj => T.depth .up - T.depth .bottom
  | .V_cs_conj => T.depth .strange - T.depth .charm

/-- The typed four-product depth sum. -/
def ckmJarlskogFourProductDepthSum
    (T : YukawaDepthTableCandidate) : Int :=
  (CKMJarlskogFactor.depthContribution T .V_us) +
    (CKMJarlskogFactor.depthContribution T .V_cb) +
      (CKMJarlskogFactor.depthContribution T .V_ub_conj) +
        (CKMJarlskogFactor.depthContribution T .V_cs_conj)

/-- THEOREM 1: the typed four-product presentation is the same expression as
P599's table-level CKM depth sum. -/
theorem ckmJarlskogFourProductDepthSum_eq_tableSum
    (T : YukawaDepthTableCandidate) :
    ckmJarlskogFourProductDepthSum T =
      ckmDepthSum_fromYukawaDepthTable T := by
  rfl

/-! ## Cancellation normal form -/

/-- The strange/charm depth separation. -/
def charmStrangeDepthGap (T : YukawaDepthTableCandidate) : Int :=
  T.depth .strange - T.depth .charm

/-- THEOREM 2: for every depth table, the Jarlskog four-product cancels the
`u` and `b` depths and reduces to twice the strange/charm depth gap. -/
theorem ckmDepthSum_fromYukawaDepthTable_normalForm
    (T : YukawaDepthTableCandidate) :
    ckmDepthSum_fromYukawaDepthTable T =
      2 * charmStrangeDepthGap T := by
  simp [ckmDepthSum_fromYukawaDepthTable, charmStrangeDepthGap]
  ring

/-- THEOREM 3: the same normal form for the typed Jarlskog presentation. -/
theorem ckmJarlskogFourProductDepthSum_normalForm
    (T : YukawaDepthTableCandidate) :
    ckmJarlskogFourProductDepthSum T =
      2 * charmStrangeDepthGap T := by
  rw [ckmJarlskogFourProductDepthSum_eq_tableSum,
    ckmDepthSum_fromYukawaDepthTable_normalForm]

/-! ## Selected and generated-table consequences -/

/-- THEOREM 4: the selected table has strange/charm gap `193`. -/
theorem selectedYukawaDepthTableCandidate_charmStrangeGap_eq_193 :
    charmStrangeDepthGap selectedYukawaDepthTableCandidate = 193 := by
  norm_num [charmStrangeDepthGap, selectedYukawaDepthTableCandidate,
    selectedYukawaIntegerDepthZ, selectedYukawaIntegerDepth]

/-- THEOREM 5: the selected CKM depth sum is exactly twice the selected
strange/charm gap. -/
theorem selectedYukawaDepthTableCandidate_ckmDepthSum_eq_twice_charmStrange :
    ckmDepthSum_fromYukawaDepthTable selectedYukawaDepthTableCandidate =
      2 * charmStrangeDepthGap selectedYukawaDepthTableCandidate := by
  exact ckmDepthSum_fromYukawaDepthTable_normalForm
    selectedYukawaDepthTableCandidate

/-- THEOREM 6: the selected table's normal form computes to `386`. -/
theorem selectedYukawaDepthTableCandidate_twice_charmStrange_eq_386 :
    2 * charmStrangeDepthGap selectedYukawaDepthTableCandidate =
      (ckmCPDepthSum : Int) := by
  rw [selectedYukawaDepthTableCandidate_charmStrangeGap_eq_193]
  norm_num [ckmCPDepthSum]

/-- THEOREM 7: every generated Yukawa table has the same typed Jarlskog normal
form and hence the same CKM depth sum `386`. -/
theorem yukawaDepthTableGeneratedSurface_jarlskogNormalForm_eq_386
    (T : YukawaDepthTableCandidate)
    (hT : YukawaDepthTableGeneratedSurface T) :
    ckmJarlskogFourProductDepthSum T = (ckmCPDepthSum : Int) := by
  rw [ckmJarlskogFourProductDepthSum_eq_tableSum]
  exact yukawaDepthTableGeneratedSurface_ckmDepthSum_eq_386 T hT

/-- THEOREM 8: every primitive-card source-surface packet generates a depth
table whose typed Jarlskog four-product has normal form `2*(n_s-n_c)=386`. -/
theorem yukawaPrimitiveCardPacket_jarlskogNormalForm_eq_386
    (P : YukawaCoefficientPrimitiveCardPacket)
    (hP : YukawaPrimitiveCardSourceEquations P) :
    ckmJarlskogFourProductDepthSum
        (yukawaProducerInputCandidateOfPrimitiveCardPacket P).depthTable =
      (ckmCPDepthSum : Int) := by
  rw [yukawaProducerInputCandidateOfPrimitiveCardPacket_eq_canonical P hP]
  exact primitiveCardYukawaProducerInputCandidate_ckmDepthSum_eq_386

/-! ## Bundled receipt -/

/-- Compact receipt: the CKM/Jarlskog depth producer is a typed four-product
whose normal form is twice the strange/charm depth gap. -/
structure CKMJarlskogNormalFormReceipt where
  table_sum :
    ∀ T : YukawaDepthTableCandidate,
      ckmJarlskogFourProductDepthSum T =
        ckmDepthSum_fromYukawaDepthTable T
  normal_form :
    ∀ T : YukawaDepthTableCandidate,
      ckmJarlskogFourProductDepthSum T =
        2 * charmStrangeDepthGap T
  selected_gap :
    charmStrangeDepthGap selectedYukawaDepthTableCandidate = 193
  selected_twice_gap :
    2 * charmStrangeDepthGap selectedYukawaDepthTableCandidate =
      (ckmCPDepthSum : Int)
  generated_tables :
    ∀ T : YukawaDepthTableCandidate,
      YukawaDepthTableGeneratedSurface T ->
        ckmJarlskogFourProductDepthSum T = (ckmCPDepthSum : Int)
  primitive_card_packets :
    ∀ P : YukawaCoefficientPrimitiveCardPacket,
      YukawaPrimitiveCardSourceEquations P ->
        ckmJarlskogFourProductDepthSum
            (yukawaProducerInputCandidateOfPrimitiveCardPacket P).depthTable =
          (ckmCPDepthSum : Int)

/-- THEOREM 9: typed Jarlskog normal-form receipt. -/
theorem ckmJarlskogNormalFormReceipt :
    CKMJarlskogNormalFormReceipt where
  table_sum := ckmJarlskogFourProductDepthSum_eq_tableSum
  normal_form := ckmJarlskogFourProductDepthSum_normalForm
  selected_gap := selectedYukawaDepthTableCandidate_charmStrangeGap_eq_193
  selected_twice_gap :=
    selectedYukawaDepthTableCandidate_twice_charmStrange_eq_386
  generated_tables :=
    yukawaDepthTableGeneratedSurface_jarlskogNormalForm_eq_386
  primitive_card_packets :=
    yukawaPrimitiveCardPacket_jarlskogNormalForm_eq_386

end StandardModelConstraint
end SaturationMonoid
