/-!
# Form-native P286 gauge geometric first variation

This module composes the three channels generated by one actual primitive
P286 connection path:

```text
exterior curvature response + algebraic connection response + charged matter
  -> integral W13_P286(a, D_A B + S_charged).
```

All channels consume the same configuration, point, and variation.  This is
an action-provenance and geometric representation theorem.  It assumes no
stationarity, weak equation, pointwise Euler equation, current balance,
constitutive elimination, source branch, or target solution.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineFormNativeP286GaugeGeometricFirstVariation

open MeasureTheory
open ProofFreeRicherAnholonomicSource
open StageNineCompactSupportIntegrationByParts
open StageNineEnrichedProofFreeSource
open StageNineFormNativeChargedGaugeCurrentThreeForm
open StageNineFormNativeMotherAction
open StageNineFormNativeP286GaugeConnectionIntegratedVariation
open StageNineFormNativeP286GaugeConnectionLocalVariation
open StageNineFormNativeP286GaugeDerivativeIntegrationByParts
open StageNineFormNativeP286GaugeGeometricKinematics
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineP286GaugeAuxiliaryVariation
open StageNineP286GaugeConnectionVariation
open StageNineTopologicalFourFormPairing
open StageNineTopologicalP286GaugeThreeFormDuality
open SU7MotherGaugeTheory
open SU7MotherLieAlgebra

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 800000

local instance p286ModuleFinite : Module.Finite ℝ P286LieBlockData :=
  FiniteDimensional.of_injective p286AmbientLinear
    p286AmbientLinear_injective

local instance p286CoordinateIndexFintype : Fintype P286CoordinateIndex :=
  Fintype.ofFinite P286CoordinateIndex

/-! ## Same-actual pointwise decomposition -/

/-- Algebraic BF plus scalar/Dirac contribution after separating the exterior
curvature channel. -/
def holonomicFormNativeP286GaugeAlgebraicChargedFirstDensity
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → P286GaugeOneForm)
    (point : BasePoint) : ℝ :=
  p286GaugeOneFormThreeFormWedgeCoefficient (variation point)
    (pointwiseP286GaugeTwoFormConnectionExteriorAction
        (holonomicP286GaugeConnectionCoordinate configuration point)
        (holonomicP286GaugeAuxiliaryCoordinate configuration point) +
      formNativeChargedGaugeThreeForm source chart point
        (toContinuumPointField configuration point))

/-- The local active action coefficient is the actual exterior BF response
plus W13 of the algebraic and charged channels. -/
theorem holonomicFormNativeP286GaugeConnectionFirstVariationDensity_eq_parts
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → P286GaugeOneForm)
    (point : BasePoint) :
    holonomicFormNativeP286GaugeConnectionFirstVariationDensity source chart
        configuration variation point =
      generatedTwoFormWedgeCoefficient p286CoordinateLiePairing
          (holonomicP286GaugeAuxiliaryCoordinate configuration point)
          (p286GaugeConnectionExteriorDerivativeVariation variation point) +
        holonomicFormNativeP286GaugeAlgebraicChargedFirstDensity source chart
          configuration variation point := by
  rw [holonomicFormNativeP286GaugeConnectionFirstVariationDensity_eq_charged,
    p286GaugeConnectionLinearCurvatureVariation_eq_parts,
    p286TopologicalGaugeBFCoefficient_add_right]
  have algebraicVariation :
      p286GaugeConnectionAlgebraicCurvatureVariation configuration variation
          point =
        p286GaugeConnectionAlgebraicCurvatureDirection
          (holonomicP286GaugeConnectionCoordinate configuration point)
          (variation point) :=
    rfl
  rw [algebraicVariation,
    p286TopologicalGaugeBF_algebraicCurvatureDirection_eq_w13]
  unfold holonomicFormNativeP286GaugeAlgebraicChargedFirstDensity
  rw [p286GaugeOneFormThreeFormWedgeCoefficient_add_right,
    formNativeChargedGaugeThreeForm_evaluation]
  ring

/-! ## Integrability of the complementary channel -/

theorem holonomicFormNativeP286GaugeAlgebraicChargedFirstDensity_integrable
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate)
    (variation : CompactlySupportedSmoothVariation P286GaugeOneForm) :
    Integrable
      (holonomicFormNativeP286GaugeAlgebraicChargedFirstDensity source 0
        configuration variation) := by
  have completeIntegrable :=
    holonomicFormNativeP286GaugeConnectionFirstVariationDensity_integrable
      source configuration smooth nondegenerate variation
  have exteriorIntegrable :=
    p286TopologicalGaugeBF_exteriorDerivativeVariation_integrable
      configuration smooth variation
  have differenceIntegrable : Integrable fun point : BasePoint =>
      holonomicFormNativeP286GaugeConnectionFirstVariationDensity source 0
          configuration variation point -
        generatedTwoFormWedgeCoefficient p286CoordinateLiePairing
          (holonomicP286GaugeAuxiliaryCoordinate configuration point)
          (p286GaugeConnectionExteriorDerivativeVariation variation point) :=
    completeIntegrable.sub exteriorIntegrable
  refine differenceIntegrable.congr ?_
  filter_upwards [] with point
  rw [holonomicFormNativeP286GaugeConnectionFirstVariationDensity_eq_parts
    source 0 configuration variation point]
  ring

/-! ## Complete integrated geometric representation -/

/-- Action-signed P286 Euler three-form generated on the same actual. -/
def holonomicFormNativeP286GaugeEulerThreeForm
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) : P286GaugeThreeForm :=
  holonomicP286GaugeAuxiliaryExteriorCovariantDerivative configuration point +
    formNativeChargedGaugeThreeForm source chart point
      (toContinuumPointField configuration point)

/-- Complete same-actual connection first coefficient in geometric W13 form. -/
theorem holonomicFormNativeP286GaugeConnectionFirstVariation_integral_eq_w13
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate)
    (variation : CompactlySupportedSmoothVariation P286GaugeOneForm) :
    (∫ point : BasePoint,
      holonomicFormNativeP286GaugeConnectionFirstVariationDensity source 0
        configuration variation point) =
      ∫ point : BasePoint,
        p286GaugeOneFormThreeFormWedgeCoefficient (variation point)
          (holonomicFormNativeP286GaugeEulerThreeForm source 0 configuration
            point) := by
  have exteriorIntegrable :=
    p286TopologicalGaugeBF_exteriorDerivativeVariation_integrable
      configuration smooth variation
  have derivativeWedgeIntegrable :=
    p286Wedge_holonomicGaugeAuxiliaryExteriorDerivative_integrable
      configuration smooth variation
  have remainderIntegrable :=
    holonomicFormNativeP286GaugeAlgebraicChargedFirstDensity_integrable
      source configuration smooth nondegenerate variation
  calc
    (∫ point : BasePoint,
        holonomicFormNativeP286GaugeConnectionFirstVariationDensity source 0
          configuration variation point) =
      ∫ point : BasePoint,
        generatedTwoFormWedgeCoefficient p286CoordinateLiePairing
            (holonomicP286GaugeAuxiliaryCoordinate configuration point)
            (p286GaugeConnectionExteriorDerivativeVariation variation point) +
          holonomicFormNativeP286GaugeAlgebraicChargedFirstDensity source 0
            configuration variation point := by
      apply integral_congr_ae
      filter_upwards [] with point
      exact holonomicFormNativeP286GaugeConnectionFirstVariationDensity_eq_parts
        source 0 configuration variation point
    _ = (∫ point : BasePoint,
          generatedTwoFormWedgeCoefficient p286CoordinateLiePairing
            (holonomicP286GaugeAuxiliaryCoordinate configuration point)
            (p286GaugeConnectionExteriorDerivativeVariation variation point)) +
        ∫ point : BasePoint,
          holonomicFormNativeP286GaugeAlgebraicChargedFirstDensity source 0
            configuration variation point := by
      exact integral_add exteriorIntegrable remainderIntegrable
    _ = (∫ point : BasePoint,
          p286GaugeOneFormThreeFormWedgeCoefficient (variation point)
            (holonomicP286GaugeAuxiliaryExteriorDerivative configuration
              point)) +
        ∫ point : BasePoint,
          holonomicFormNativeP286GaugeAlgebraicChargedFirstDensity source 0
            configuration variation point := by
      rw [p286TopologicalGaugeBF_exteriorDerivativeVariation_integral_eq_w13
        configuration smooth variation]
    _ = ∫ point : BasePoint,
        p286GaugeOneFormThreeFormWedgeCoefficient (variation point)
            (holonomicP286GaugeAuxiliaryExteriorDerivative configuration point) +
          holonomicFormNativeP286GaugeAlgebraicChargedFirstDensity source 0
            configuration variation point := by
      exact (integral_add derivativeWedgeIntegrable remainderIntegrable).symm
    _ = ∫ point : BasePoint,
        p286GaugeOneFormThreeFormWedgeCoefficient (variation point)
          (holonomicFormNativeP286GaugeEulerThreeForm source 0 configuration
            point) := by
      apply integral_congr_ae
      filter_upwards [] with point
      unfold holonomicFormNativeP286GaugeAlgebraicChargedFirstDensity
        holonomicFormNativeP286GaugeEulerThreeForm
      rw [holonomicP286GaugeAuxiliaryExteriorCovariantDerivative_eq_parts]
      simp only [p286GaugeOneFormThreeFormWedgeCoefficient_add_right]
      ring

/-! ## Action provenance and physical-current convention -/

/-- The active integrated action derivative is exactly W13 against the
generated Euler three-form.  This is producer consistency, not an independent
Cauchy constraint. -/
theorem holonomicFormNativeIntegratedUnifiedAction_p286Connection_hasDerivAt_w13
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate)
    (densityIntegrable :
      FormNativeHolonomicLocalDensityIntegrable source 0 configuration)
    (variation : CompactlySupportedSmoothVariation P286GaugeOneForm) :
    HasDerivAt
      (fun parameter => holonomicFormNativeIntegratedUnifiedAction source 0
        (varyP286GaugeConnectionCoordinate configuration variation parameter))
      (∫ point : BasePoint,
        p286GaugeOneFormThreeFormWedgeCoefficient (variation point)
          (holonomicFormNativeP286GaugeEulerThreeForm source 0 configuration
            point)) 0 := by
  have actionDerivative :=
    holonomicFormNativeIntegratedUnifiedAction_p286Connection_hasDerivAt
      source configuration smooth nondegenerate densityIntegrable variation
  rw [holonomicFormNativeP286GaugeConnectionFirstVariation_integral_eq_w13
    source configuration smooth nondegenerate variation] at actionDerivative
  exact actionDerivative

/-- Physical charged-current convention, introduced only after the complete
action variation has fixed its relative sign. -/
def formNativePhysicalChargedGaugeCurrentThreeForm
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField) :
    P286GaugeThreeForm :=
  -formNativeChargedGaugeThreeForm source chart point field

/-- The action-signed zero equation is exactly `D_A B = J_charged`.  This
does not assert that either side holds on an arbitrary configuration. -/
theorem holonomicFormNativeP286GaugeEulerThreeForm_eq_zero_iff_current
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    holonomicFormNativeP286GaugeEulerThreeForm source chart configuration
        point = 0 ↔
      holonomicP286GaugeAuxiliaryExteriorCovariantDerivative configuration
          point =
        formNativePhysicalChargedGaugeCurrentThreeForm source chart point
          (toContinuumPointField configuration point) := by
  unfold holonomicFormNativeP286GaugeEulerThreeForm
    formNativePhysicalChargedGaugeCurrentThreeForm
  constructor <;> intro equality
  · exact eq_neg_of_add_eq_zero_left equality
  · exact add_eq_zero_iff_eq_neg.mpr equality

end

end
  SaturationMonoid.PhysicsCore.StageNineFormNativeP286GaugeGeometricFirstVariation
