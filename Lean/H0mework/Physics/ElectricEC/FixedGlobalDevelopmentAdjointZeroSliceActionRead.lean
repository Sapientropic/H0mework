import H0mework.Physics.ElectricEC.FixedTemporalAdjointAmbientFirstJetRegularity
import H0mework.Physics.ElectricEC.FixedGlobalDevelopmentMatterZeroSliceActionRead

/-!
# U5 zero-slice adjoint action read

The fixed P506/L0 first whole-action sweep carries the ambient adjoint first
jet generated by its source-owned temporal leg.  This module identifies its
canonical-time derivative at every zero-slice occurrence with the same-source
complete-joint adjoint profile, while the three spatial derivatives remain the
fixed input jet.

The construction and all comparisons stay on the existing U5 actual.  No
residual, target derivative, support branch, equation receipt, or successor is
accepted as input.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeFixedP506CompleteJointLiveElectricECGlobalDevelopmentAdjointZeroSliceActionRead

open DiracExteriorMatterAction
open ProofFreeRicherAnholonomicSource
open StageNineCanonicalCauchyState
open StageNineConjugateMatterVariation
open StageNineCoframeFirstJet
open StageNineCurrentCoframeMatterTemporalPrincipal
open StageNineDiracDualFormNativeCartanReactionCurrentRestart
open StageNineDiracDualFormNativeCompleteJointActionGeneratedProfiles
open StageNineDiracDualFormNativeCompleteJointActionFullOccurrenceContactOperator
open StageNineDiracDualFormNativeCompleteJointActionGlobalDevelopmentOperator
open StageNineDiracDualFormNativeCompleteJointActionTemporalDevelopmentOperator
open StageNineDiracDualFormNativeFixedP506CompleteJointLiveElectricECTemporalAdjointAmbientFirstJetRegularity
open StageNineDiracDualFormNativeFixedP506CompleteJointLiveElectricECGlobalDevelopmentMatterZeroSliceActionRead
open StageNineDiracDualFormNativeFixedP506JointActionWrite
open StageNineDiracDualFormNativeIdentityECHessianCartanECNormalFixedGlobalActual
open StageNineDiracDualFormNativeIdentityECHessianCartanECNormalFixedGlobalFullCauchyActual
open StageNineDiracDualFormNativeIdentityECHessianCartanECNormalFixedGlobalMatterDualFullCauchyActual
open StageNineDiracDualFormNativeIdentityECHessianCartanECNormalFixedGlobalMatterDualP286CompleteActual
open StageNineDiracDualFormNativeFixedP506CompleteJointLiveElectricECOriginTransport
open StageNineDiracDualFormNativeFixedP506CompleteJointLiveElectricOriginCoframeClosure
open StageNineDiracDualFormNativeFixedP506JointActionSectionResponse
open StageNineDiracDualFormNativeLiveCoframeConjugateMatterActionResponse
open StageNineDiracDualFormNativeRepairedMatterResponseOperator
open StageNineEnrichedProofFreeSource
open StageNineHolonomicField
open StageNineHolonomicFullSpacetimeRecenterNaturality
open StageNineHolonomicIdentityCoframeConjugateMatterActionResponse
open StageNineP286ActionCauchySplit
open StageNineSourceActionGeneratedP506MatterCurrentCanonicalLorentzAdjointDiagonalActual

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1200000
set_option maxRecDepth 100000

private abbrev Source : SmoothUnifiedSource :=
  positiveSmoothUnifiedSource

private abbrev Input : StageNineHolonomicConfiguration :=
  FixedP506FormNativeJointActionSolvedSuccessor

private abbrev Current : StageNineHolonomicConfiguration :=
  fixedP506L0CompleteJointLiveElectricECGlobalDevelopmentActual

private theorem recentered_adjointDirectionalDerivative_normalForm
    (space : StageNineSpatialPoint)
    (direction : LorentzianIndex) :
    fieldDirectionalDerivative
        (fixedP506L0CompleteJointRecenteredAdjointCoordinates space)
        0 direction =
      fieldDirectionalDerivative
          (fixedP506L0CompleteJointRecenteredInputAdjointCoordinates space)
          0 direction +
        canonicalTimeProjection (coordinateDirection direction) •
          completeJointAdjointTemporalCoordinateCorrection Source Input
            (canonicalCauchySlicePoint 0 space) := by
  have generated :=
    fixedP506L0CompleteJointLiveElectricECGlobalDevelopmentActual_recentered_conjugateMatterCoordinates_hasFDerivAt
      space
  unfold fieldDirectionalDerivative
  rw [generated.fderiv]
  simp only [add_apply, ContinuousLinearMap.smulRight_apply]

private theorem recentered_input_adjointDirectionalDerivative_eq_global
    (space : StageNineSpatialPoint)
    (direction : LorentzianIndex) :
    fieldDirectionalDerivative
        (fixedP506L0CompleteJointRecenteredInputAdjointCoordinates space)
        0 direction =
      fieldDirectionalDerivative
        (holonomicConjugateMatterCoordinates Input)
        (canonicalCauchySlicePoint 0 space) direction := by
  unfold fixedP506L0CompleteJointRecenteredInputAdjointCoordinates
  dsimp only
  simpa [canonicalSpacetimeContactTranslation] using
    fieldDirectionalDerivative_comp_canonicalSpacetimeContactTranslation
      (holonomicConjugateMatterCoordinates Input)
      (canonicalCauchySlicePoint 0 space) 0 direction

private theorem global_current_adjointDirectionalDerivative_eq_recentered
    (space : StageNineSpatialPoint)
    (direction : LorentzianIndex) :
    fieldDirectionalDerivative
        (holonomicConjugateMatterCoordinates Current)
        (canonicalCauchySlicePoint 0 space) direction =
      fieldDirectionalDerivative
        (fixedP506L0CompleteJointRecenteredAdjointCoordinates space)
        0 direction := by
  let point := canonicalCauchySlicePoint 0 space
  rw [fixedP506L0CompleteJointRecenteredAdjointCoordinates_eq_comp]
  simpa [point, canonicalSpacetimeContactTranslation] using
    (fieldDirectionalDerivative_comp_canonicalSpacetimeContactTranslation
      (holonomicConjugateMatterCoordinates Current) point 0 direction).symm

/-- The ambient canonical-time derivative of the fixed U5 adjoint field is
the exact source/action-generated profile velocity at every zero-slice
occurrence. -/
theorem
    fixedP506L0CompleteJointLiveElectricECGlobalDevelopmentActual_conjugateMatterTimeDerivative_zeroSlice_eq_profileVelocity
    (space : StageNineSpatialPoint) :
    fieldDirectionalDerivative
        (holonomicConjugateMatterCoordinates Current)
        (canonicalCauchySlicePoint 0 space)
        canonicalLorentzianTimeDirection =
      matterDualCoordinates
        (sourceActionGeneratedDiracDualCompleteJointProfiles Source Input
          (canonicalCauchySlicePoint 0 space)).adjointVelocity := by
  rw [global_current_adjointDirectionalDerivative_eq_recentered space,
    recentered_adjointDirectionalDerivative_normalForm space,
    recentered_input_adjointDirectionalDerivative_eq_global space]
  have timeProjection :
      canonicalTimeProjection
          (coordinateDirection canonicalLorentzianTimeDirection) = 1 := by
    simp [canonicalTimeProjection, canonicalLorentzianTimeDirection,
      coordinateDirection]
  rw [timeProjection, one_smul]
  unfold completeJointAdjointTemporalCoordinateCorrection
  abel

/-- The three spatial adjoint derivatives of U5 are inherited from the fixed
input; the canonical-time primitive contributes only in direction zero. -/
theorem
    fixedP506L0CompleteJointLiveElectricECGlobalDevelopmentActual_conjugateMatterSpatialDerivative_zeroSlice_eq_input
    (space : StageNineSpatialPoint)
    (direction : Fin 3) :
    fieldDirectionalDerivative
        (holonomicConjugateMatterCoordinates Current)
        (canonicalCauchySlicePoint 0 space) direction.succ =
      fieldDirectionalDerivative
        (holonomicConjugateMatterCoordinates Input)
        (canonicalCauchySlicePoint 0 space) direction.succ := by
  rw [global_current_adjointDirectionalDerivative_eq_recentered space,
    recentered_adjointDirectionalDerivative_normalForm space,
    recentered_input_adjointDirectionalDerivative_eq_global space]
  fin_cases direction <;>
    simp [canonicalTimeProjection, canonicalLorentzianTimeDirection,
      coordinateDirection]

private abbrev CartanCurrent : StageNineHolonomicConfiguration :=
  sourceActionGeneratedDiracDualCartanReactionCurrentRestart Source Current

private abbrev ProfileRestart
    (space : StageNineSpatialPoint) : StageNineHolonomicConfiguration :=
  completeJointGeneratedProfileRestartCurrent Source Input
    (canonicalCauchySlicePoint 0 space)

private abbrev ProfilePrimal
    (space : StageNineSpatialPoint) : StageNineHolonomicConfiguration :=
  actionGeneratedDiracDualCurrentCoframeMatterTimeResponseActual
    (ProfileRestart space)

private theorem input_coframeFirstJet_zeroSlice
    (space : StageNineSpatialPoint) :
    holonomicCoframeFirstJetAt Input.coframe
        (canonicalCauchySlicePoint 0 space) =
      identityCoframeMatterGeometry := by
  rw [fixedP506FormNativeJointActionSolvedSuccessor_coframe,
    fixedP506JointActionSuccessor_coframe,
    fixedGlobalMatterDualP286Complete_coframe,
    fixedGlobalMatterDualFullCauchy_coframe,
    fixedGlobalFullCauchy_coframe]
  simpa [identityCoframeMatterGeometry] using
    fixedPrimitiveDiagonal_coframeFirstJet_zeroSlice space

private theorem profileRestart_coframeFirstJet_origin
    (space : StageNineSpatialPoint) :
    holonomicCoframeFirstJetAt (ProfileRestart space).coframe 0 =
      identityCoframeMatterGeometry := by
  unfold ProfileRestart completeJointGeneratedProfileRestartCurrent
  rw [sourceActionGeneratedDiracDualCartanReactionCurrentRestart_coframe,
    recentered_input_coframeFirstJet_origin]
  exact input_coframeFirstJet_zeroSlice space

private theorem profilePrimal_coframeFirstJet_origin
    (space : StageNineSpatialPoint) :
    holonomicCoframeFirstJetAt (ProfilePrimal space).coframe 0 =
      identityCoframeMatterGeometry := by
  unfold ProfilePrimal
  rw [actionGeneratedDiracDualCurrentCoframeMatterTimeResponseActual_coframe]
  exact profileRestart_coframeFirstJet_origin space

/-- The matching Cartan restart keeps the identity complete coframe first jet
at every fixed P506/L0 zero-slice occurrence. -/
theorem
    fixedP506L0CompleteJointLiveElectricECCartanRestart_coframeFirstJet_zeroSlice
    (space : StageNineSpatialPoint) :
    holonomicCoframeFirstJetAt CartanCurrent.coframe
        (canonicalCauchySlicePoint 0 space) =
      identityCoframeMatterGeometry := by
  calc
    holonomicCoframeFirstJetAt CartanCurrent.coframe
          (canonicalCauchySlicePoint 0 space) =
        holonomicCoframeFirstJetAt (ProfileRestart space).coframe 0 :=
      currentCartan_coframeFirstJet_zeroSlice_eq_profileRestart space
    _ = identityCoframeMatterGeometry :=
      profileRestart_coframeFirstJet_origin space

private theorem
    cartanCurrent_conjugateMatterSpatialDerivative_zeroSlice_eq_profilePrimal
    (space : StageNineSpatialPoint)
    (direction : Fin 3) :
    holonomicConjugateMatterDerivativeDual CartanCurrent
        (canonicalCauchySlicePoint 0 space) direction.succ =
      holonomicConjugateMatterDerivativeDual (ProfilePrimal space) 0
        direction.succ := by
  unfold holonomicConjugateMatterDerivativeDual
    holonomicConjugateMatterDerivativeCoordinates
    holonomicConjugateMatterCoordinates
  rw [sourceActionGeneratedDiracDualCartanReactionCurrentRestart_conjugateMatter]
  apply congrArg matterDualOfCoordinates
  calc
    fieldDirectionalDerivative (holonomicConjugateMatterCoordinates Current)
          (canonicalCauchySlicePoint 0 space) direction.succ =
        fieldDirectionalDerivative (holonomicConjugateMatterCoordinates Input)
          (canonicalCauchySlicePoint 0 space) direction.succ := by
      exact
        fixedP506L0CompleteJointLiveElectricECGlobalDevelopmentActual_conjugateMatterSpatialDerivative_zeroSlice_eq_input
          space direction
    _ = fieldDirectionalDerivative
          (holonomicConjugateMatterCoordinates
            (fullyRecenterHolonomicConfiguration Input
              (canonicalCauchySlicePoint 0 space)))
          0 direction.succ := by
      change
        fieldDirectionalDerivative (holonomicConjugateMatterCoordinates Input)
            (canonicalCauchySlicePoint 0 space) direction.succ =
          fieldDirectionalDerivative
            (holonomicConjugateMatterCoordinates Input ∘
              canonicalSpacetimeContactTranslation
                (canonicalCauchySlicePoint 0 space)) 0 direction.succ
      simpa [canonicalSpacetimeContactTranslation] using
        (fieldDirectionalDerivative_comp_canonicalSpacetimeContactTranslation
          (holonomicConjugateMatterCoordinates Input)
          (canonicalCauchySlicePoint 0 space) 0
          direction.succ).symm
    _ = fieldDirectionalDerivative
          (holonomicConjugateMatterCoordinates (ProfilePrimal space)) 0
          direction.succ := by rfl

private theorem cartanCurrent_adjointActionVelocity_zeroSlice_eq_profile
    (space : StageNineSpatialPoint) :
    holonomicDiracDualLiveCoframeConjugateMatterActionVelocity CartanCurrent
        (canonicalCauchySlicePoint 0 space) =
      holonomicDiracDualLiveCoframeConjugateMatterActionVelocity
        (ProfilePrimal space) 0 := by
  calc
    holonomicDiracDualLiveCoframeConjugateMatterActionVelocity CartanCurrent
          (canonicalCauchySlicePoint 0 space) =
        holonomicDiracDualRightChiralIdentityCoframeConjugateMatterActionVelocity
          CartanCurrent (canonicalCauchySlicePoint 0 space) :=
      holonomicDiracDualLiveCoframeConjugateMatterActionVelocity_eq_rightChiralIdentity_of_firstJet
        _ _
          (fixedP506L0CompleteJointLiveElectricECCartanRestart_coframeFirstJet_zeroSlice
            space)
    _ =
        holonomicDiracDualRightChiralIdentityCoframeConjugateMatterActionVelocity
          (ProfilePrimal space) 0 := by
      apply
        holonomicDiracDualRightChiralIdentityCoframeConjugateMatterActionVelocity_eq_of_pointData
      · change
          CartanCurrent.gravityConnection
              (canonicalCauchySlicePoint 0 space) =
            (ProfileRestart space).gravityConnection 0
        simpa [Source, Input, Current, CartanCurrent, ProfileRestart] using
          currentCartan_gravityConnection_zeroSlice_eq_profileRestart space
      · change
          CartanCurrent.gaugeConnection
              (canonicalCauchySlicePoint 0 space) =
            (ProfileRestart space).gaugeConnection 0
        simpa [Source, Input, Current, CartanCurrent, ProfileRestart] using
          currentCartan_gaugeConnection_zeroSlice_eq_profileRestart space
      · change CartanCurrent.scalar (canonicalCauchySlicePoint 0 space) =
          (ProfileRestart space).scalar 0
        simpa [Source, Input, Current, CartanCurrent, ProfileRestart] using
          currentCartan_scalar_zeroSlice_eq_profileRestart space
      · change
          CartanCurrent.conjugateMatter
              (canonicalCauchySlicePoint 0 space) =
            (ProfileRestart space).conjugateMatter 0
        simpa [Source, Input, Current, CartanCurrent, ProfileRestart] using
          currentCartan_conjugateMatter_zeroSlice_eq_profileRestart space
      · exact
          cartanCurrent_conjugateMatterSpatialDerivative_zeroSlice_eq_profilePrimal
            space
    _ = holonomicDiracDualLiveCoframeConjugateMatterActionVelocity
          (ProfilePrimal space) 0 :=
      (holonomicDiracDualLiveCoframeConjugateMatterActionVelocity_eq_rightChiralIdentity_of_firstJet
        _ _ (profilePrimal_coframeFirstJet_origin space)).symm

private theorem
    cartanCurrent_conjugateMatterTimeDerivative_zeroSlice_eq_actionVelocity
    (space : StageNineSpatialPoint) :
    holonomicConjugateMatterDerivativeDual CartanCurrent
        (canonicalCauchySlicePoint 0 space)
        canonicalLorentzianTimeDirection =
      holonomicDiracDualLiveCoframeConjugateMatterActionVelocity CartanCurrent
        (canonicalCauchySlicePoint 0 space) := by
  calc
    holonomicConjugateMatterDerivativeDual CartanCurrent
          (canonicalCauchySlicePoint 0 space)
          canonicalLorentzianTimeDirection =
        matterDualOfCoordinates
          (fieldDirectionalDerivative
            (holonomicConjugateMatterCoordinates Current)
            (canonicalCauchySlicePoint 0 space)
            canonicalLorentzianTimeDirection) := by
      unfold holonomicConjugateMatterDerivativeDual
        holonomicConjugateMatterDerivativeCoordinates
        holonomicConjugateMatterCoordinates CartanCurrent
      rw [sourceActionGeneratedDiracDualCartanReactionCurrentRestart_conjugateMatter]
    _ = matterDualOfCoordinates
          (matterDualCoordinates
            (sourceActionGeneratedDiracDualCompleteJointProfiles Source Input
              (canonicalCauchySlicePoint 0 space)).adjointVelocity) := by
      rw [
        fixedP506L0CompleteJointLiveElectricECGlobalDevelopmentActual_conjugateMatterTimeDerivative_zeroSlice_eq_profileVelocity]
    _ =
        (sourceActionGeneratedDiracDualCompleteJointProfiles Source Input
          (canonicalCauchySlicePoint 0 space)).adjointVelocity :=
      matterDualOfCoordinates_surjective _
    _ = holonomicDiracDualLiveCoframeConjugateMatterActionVelocity
          (ProfilePrimal space) 0 := by
      rw [sourceActionGeneratedDiracDualCompleteJointProfiles_adjointVelocity]
    _ = holonomicDiracDualLiveCoframeConjugateMatterActionVelocity CartanCurrent
          (canonicalCauchySlicePoint 0 space) :=
      (cartanCurrent_adjointActionVelocity_zeroSlice_eq_profile space).symm

/-- The same-source Cartan restart of U5 satisfies the action-generated
adjoint Dirac law at every zero-slice occurrence.  This is an existing-field
read: the temporal derivative comes from the global U5 producer and the
action velocity is recomputed from the matching local point data. -/
theorem
    fixedP506L0CompleteJointLiveElectricECCartanRestart_adjointActionLaw_zeroSlice
    (space : StageNineSpatialPoint) :
    let point := canonicalCauchySlicePoint 0 space
    HolonomicDiracDualLiveCoframeConjugateMatterTimeActionLaw CartanCurrent
      point
      (holonomicConjugateMatterDerivativeDual CartanCurrent point
        canonicalLorentzianTimeDirection) := by
  dsimp only
  let point := canonicalCauchySlicePoint 0 space
  have coframeOne : CartanCurrent.coframe point = 1 :=
    coframe_eq_one_of_identity_firstJet CartanCurrent point
      (fixedP506L0CompleteJointLiveElectricECCartanRestart_coframeFirstJet_zeroSlice
        space)
  have nondegenerate : Matrix.det (CartanCurrent.coframe point) ≠ 0 := by
    rw [coframeOne]
    simp
  have noncharacteristic :
      coframeTemporalPrincipalScalar (CartanCurrent.coframe point) ≠ 0 := by
    rw [coframeOne, coframeTemporalPrincipalScalar_one]
    exact one_ne_zero
  rw [cartanCurrent_conjugateMatterTimeDerivative_zeroSlice_eq_actionVelocity]
  exact
    holonomicDiracDualLiveCoframeConjugateMatterActionVelocity_satisfies
      CartanCurrent point nondegenerate noncharacteristic

end


end
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeFixedP506CompleteJointLiveElectricECGlobalDevelopmentAdjointZeroSliceActionRead
