local instance secondSweepMatterP286ModuleFinite :
    Module.Finite ℝ P286LieBlockData :=
  StageNineP286HolonomicSecondJetCarrier.p286ModuleFinite

local instance secondSweepMatterP286CoordinateIndexFintype :
    Fintype P286CoordinateIndex :=
  StageNineP286HolonomicSecondJetCarrier.p286CoordinateIndexFintype

local instance secondSweepMatterP286CoordinateIsTopologicalAddGroup :
    IsTopologicalAddGroup P286CoordinateCarrier :=
  StageNineP286HolonomicSecondJetCarrier.p286CoordinateIsTopologicalAddGroup

private abbrev Source : SmoothUnifiedSource :=
  positiveSmoothUnifiedSource

private abbrev Input : StageNineHolonomicConfiguration :=
  FixedP506FormNativeJointActionSolvedSuccessor

private abbrev U5 : StageNineHolonomicConfiguration :=
  fixedP506L0CompleteJointLiveElectricECGlobalDevelopmentActual

private theorem current_coframe_eq_input : U5.coframe = Input.coframe := by
  calc
    U5.coframe =
        fixedP506L0CompleteJointLiveElectricGlobalDevelopmentActual.coframe :=
      fixedP506L0CompleteJointLiveElectricECGlobalDevelopmentActual_coframe_eq_preEC
    _ = fixedP506L0CompleteJointGlobalDevelopmentActual.coframe :=
      fixedP506L0CompleteJointLiveElectricGlobalDevelopmentActual_coframe_eq_existing
    _ = Input.coframe :=
      fixedP506L0CompleteJointGlobalDevelopmentActual_coframe

private theorem canonicalSpacetimeContactTranslation_contDiff
    (point : BasePoint) :
    ContDiff ℝ ∞ (canonicalSpacetimeContactTranslation point) := by
  unfold canonicalSpacetimeContactTranslation
  fun_prop

private theorem recentered_coframe_contDiffAt
    (space : StageNineSpatialPoint) :
    ContDiffAt ℝ 1
      (fullyRecenterHolonomicConfiguration U5
        (canonicalCauchySlicePoint 0 space)).coframe 0 := by
  let point := canonicalCauchySlicePoint 0 space
  have inputCoframeSmooth : ContDiff ℝ ∞ Input.coframe := by
    apply contDiff_pi'
    intro internal
    apply contDiff_pi'
    intro coordinate
    exact fixedP506FormNativeJointActionSolvedSuccessor_smooth.1
      internal coordinate
  have currentCoframeSmooth : ContDiff ℝ ∞ U5.coframe := by
    rw [current_coframe_eq_input]
    exact inputCoframeSmooth
  change ContDiffAt ℝ 1
    (U5.coframe ∘ canonicalSpacetimeContactTranslation point) 0
  exact
    (currentCoframeSmooth.comp
      (canonicalSpacetimeContactTranslation_contDiff point)).contDiffAt.of_le
        (by norm_num)

private theorem recentered_gaugeConnection_contDiffAt
    (space : StageNineSpatialPoint)
    (direction : LorentzianIndex) :
    ContDiffAt ℝ 0 (fun localPoint =>
      p286CoordinateEquiv
        ((fullyRecenterHolonomicConfiguration U5
          (canonicalCauchySlicePoint 0 space)).gaugeConnection
            localPoint direction)) 0 := by
  let point := canonicalCauchySlicePoint 0 space
  change ContDiffAt ℝ 0
    ((fun target => p286CoordinateEquiv
      (U5.gaugeConnection target direction)) ∘
        canonicalSpacetimeContactTranslation point) 0
  exact
    ((fixedP506L0CompleteJointLiveElectricECGlobalDevelopmentActual_gaugeConnectionCoordinate_contDiff
      direction).comp
        (canonicalSpacetimeContactTranslation_contDiff point)).contDiffAt.of_le
      (by norm_num)

private theorem recentered_coframe_origin_one
    (space : StageNineSpatialPoint) :
    (fullyRecenterHolonomicConfiguration U5
      (canonicalCauchySlicePoint 0 space)).coframe 0 = 1 := by
  rw [fullyRecenterHolonomicConfiguration_coframe_origin,
    current_coframe_eq_input]
  rw [← fixedP506L0CompleteJointGlobalDevelopmentActual_coframe]
  exact fixedP506L0CompleteJointGlobalDevelopmentActual_coframe_zeroSlice space

/-- The second full-occurrence matter profile read from the literal U5
current is locally continuous at every recentered zero-slice occurrence. -/
theorem
    fixedP506L0CompleteJointLiveElectricECSecondSweepMatterTemporalCorrection_recentered_contDiffAt
    (space : StageNineSpatialPoint) :
    ContDiffAt ℝ 0
      (completeJointMatterTemporalCoordinateCorrection Source
        (fullyRecenterHolonomicConfiguration U5
          (canonicalCauchySlicePoint 0 space))) 0 := by
  let current := fullyRecenterHolonomicConfiguration U5
    (canonicalCauchySlicePoint 0 space)
  have coframeOrigin : current.coframe 0 = 1 := by
    simpa [current] using recentered_coframe_origin_one space
  have nondegenerate : Matrix.det (current.coframe 0) ≠ 0 := by
    rw [coframeOrigin]
    simp
  have noncharacteristic :
      coframeTemporalPrincipalScalar (current.coframe 0) ≠ 0 := by
    rw [coframeOrigin, coframeTemporalPrincipalScalar_one]
    exact one_ne_zero
  apply completeJointMatterTemporalCoordinateCorrection_contDiffAt_of_local
    Source current 0 nondegenerate noncharacteristic
  · simpa [current] using recentered_coframe_contDiffAt space
  · exact
      (fixedP506L0CompleteJointLiveElectricECGlobalDevelopmentActual_recentered_scalar_contDiffAt
        space).of_le (by norm_num)
  · exact
      fixedP506L0CompleteJointLiveElectricECGlobalDevelopmentActual_recentered_matterCoordinates_contDiffAt
        space
  · simpa [current,
      fixedP506L0CompleteJointRecenteredAdjointCoordinates] using
      fixedP506L0CompleteJointLiveElectricECGlobalDevelopmentActual_recentered_conjugateMatterCoordinates_contDiffAt
        space
  · intro direction
    simpa [current] using
      recentered_gaugeConnection_contDiffAt space direction

end

