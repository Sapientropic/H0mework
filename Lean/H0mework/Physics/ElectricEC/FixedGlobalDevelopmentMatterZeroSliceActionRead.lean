private theorem recentered_matterTimeDerivative_normalForm
    (space : StageNineSpatialPoint) :
    let point := canonicalCauchySlicePoint 0 space
    fieldDirectionalDerivative
        (fun localPoint =>
          matterCoordinateEquiv
            ((fullyRecenterHolonomicConfiguration Current point).matter
              localPoint))
        0 canonicalLorentzianTimeDirection =
      fieldDirectionalDerivative
          (fun localPoint =>
            matterCoordinateEquiv
              ((fullyRecenterHolonomicConfiguration Input point).matter
                localPoint))
          0 canonicalLorentzianTimeDirection +
        completeJointMatterTemporalCoordinateCorrection Source Input point := by
  dsimp only
  let point := canonicalCauchySlicePoint 0 space
  let inputCoordinates : BasePoint → MatterCoordinateCarrier :=
    fun localPoint =>
      matterCoordinateEquiv
        (Input.matter (canonicalSpacetimeContactTranslation point localPoint))
  have generated :
      HasFDerivAt
        (fun localPoint =>
          matterCoordinateEquiv
            ((fullyRecenterHolonomicConfiguration Current point).matter
              localPoint))
        (fderiv ℝ inputCoordinates 0 +
          canonicalTimeProjection.smulRight
            (completeJointMatterTemporalCoordinateCorrection Source Input point))
        0 := by
    simpa [Source, Input, Current, point, inputCoordinates] using
      fixedP506L0CompleteJointLiveElectricECGlobalDevelopmentActual_recentered_matterCoordinates_hasFDerivAt
        space
  unfold fieldDirectionalDerivative
  rw [generated.fderiv]
  simp only [add_apply, ContinuousLinearMap.smulRight_apply]
  have timeProjection :
      canonicalTimeProjection
          (coordinateDirection canonicalLorentzianTimeDirection) = 1 := by
    simp [canonicalTimeProjection, canonicalLorentzianTimeDirection,
      coordinateDirection]
  rw [timeProjection, one_smul]
  rfl

private theorem recentered_input_matterTimeDerivative_eq_global
    (space : StageNineSpatialPoint) :
    let point := canonicalCauchySlicePoint 0 space
    fieldDirectionalDerivative
        (fun localPoint =>
          matterCoordinateEquiv
            ((fullyRecenterHolonomicConfiguration Input point).matter
              localPoint))
        0 canonicalLorentzianTimeDirection =
      fieldDirectionalDerivative
        (fun target => matterCoordinateEquiv (Input.matter target))
        point canonicalLorentzianTimeDirection := by
  dsimp only
  change
    fieldDirectionalDerivative
        ((fun target => matterCoordinateEquiv (Input.matter target)) ∘
          canonicalSpacetimeContactTranslation
            (canonicalCauchySlicePoint 0 space))
        0 canonicalLorentzianTimeDirection = _
  simpa [canonicalSpacetimeContactTranslation] using
    fieldDirectionalDerivative_comp_canonicalSpacetimeContactTranslation
      (fun target => matterCoordinateEquiv (Input.matter target))
      (canonicalCauchySlicePoint 0 space) 0
      canonicalLorentzianTimeDirection

