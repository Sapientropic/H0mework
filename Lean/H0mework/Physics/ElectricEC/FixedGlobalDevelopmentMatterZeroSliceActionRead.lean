private theorem current_matterDerivative_spatial_zeroSlice_eq_recenteredInput
    (space : StageNineSpatialPoint)
    (direction : Fin 3) :
    let point := canonicalCauchySlicePoint 0 space
    fieldDirectionalDerivative
        (fun candidate => matterCoordinateEquiv (Current.matter candidate))
        point direction.succ =
      fieldDirectionalDerivative
        (fun localPoint => matterCoordinateEquiv
          ((fullyRecenterHolonomicConfiguration Input point).matter
            localPoint)) 0 direction.succ := by
  dsimp only
  calc
    fieldDirectionalDerivative
        (fun candidate => matterCoordinateEquiv (Current.matter candidate))
        (canonicalCauchySlicePoint 0 space) direction.succ =
      fieldDirectionalDerivative
        (fun candidate => matterCoordinateEquiv (Input.matter candidate))
        (canonicalCauchySlicePoint 0 space) direction.succ :=
      fixedP506L0CompleteJointLiveElectricECGlobalDevelopmentActual_matterSpatialDerivative_zeroSlice_eq_input
        space direction
    _ = fieldDirectionalDerivative
        (fun localPoint => matterCoordinateEquiv
          ((fullyRecenterHolonomicConfiguration Input
            (canonicalCauchySlicePoint 0 space)).matter localPoint))
        0 direction.succ := by
      change
        fieldDirectionalDerivative
            (fun candidate => matterCoordinateEquiv (Input.matter candidate))
            (canonicalCauchySlicePoint 0 space) direction.succ =
          fieldDirectionalDerivative
            ((fun candidate => matterCoordinateEquiv (Input.matter candidate)) ∘
              canonicalSpacetimeContactTranslation
                (canonicalCauchySlicePoint 0 space)) 0 direction.succ
      simpa [canonicalSpacetimeContactTranslation] using
        (fieldDirectionalDerivative_comp_canonicalSpacetimeContactTranslation
