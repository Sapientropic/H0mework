/-- The ambient canonical-time first derivative of the fixed `U5` matter
field is the same-source action-generated profile velocity at every point of
the complete zero slice. -/
theorem
    fixedP506L0CompleteJointLiveElectricECGlobalDevelopmentActual_matterTimeDerivative_zeroSlice_eq_profileVelocity
    (space : StageNineSpatialPoint) :
    fieldDirectionalDerivative
        (fun point => matterCoordinateEquiv (Current.matter point))
        (canonicalCauchySlicePoint 0 space)
        canonicalLorentzianTimeDirection =
      matterCoordinateEquiv
        (sourceActionGeneratedDiracDualCompleteJointProfiles Source Input
          (canonicalCauchySlicePoint 0 space)).matterVelocity := by
  rw [global_current_matterTimeDerivative_eq_recentered space,
    recentered_matterTimeDerivative_normalForm space,
    recentered_input_matterTimeDerivative_eq_global space]
  unfold completeJointMatterTemporalCoordinateCorrection
  abel

