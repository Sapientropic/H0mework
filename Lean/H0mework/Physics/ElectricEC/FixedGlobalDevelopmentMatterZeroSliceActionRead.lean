/-- Every spatial matter first derivative of the fixed `U5` field on the
zero slice is inherited from the fixed input.  The generated temporal
primitive contributes only in the canonical-time direction. -/
theorem
    fixedP506L0CompleteJointLiveElectricECGlobalDevelopmentActual_matterSpatialDerivative_zeroSlice_eq_input
    (space : StageNineSpatialPoint)
    (direction : Fin 3) :
    fieldDirectionalDerivative
        (fun point => matterCoordinateEquiv (Current.matter point))
        (canonicalCauchySlicePoint 0 space) direction.succ =
      fieldDirectionalDerivative
        (fun point => matterCoordinateEquiv (Input.matter point))
        (canonicalCauchySlicePoint 0 space) direction.succ := by
  rw [global_current_matterDirectionalDerivative_eq_recentered space,
    recentered_matterDirectionalDerivative_normalForm space,
    recentered_input_matterDirectionalDerivative_eq_global space]
  fin_cases direction <;>
    simp [canonicalTimeProjection, canonicalLorentzianTimeDirection,
      coordinateDirection]

