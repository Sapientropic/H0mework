import H0mework.Realization.Reflexive.TruthTable

/-!
# Standing-relative audit bases

The primitive audit vocabulary is not an ontology of the states being
audited.  Domain objects may have arbitrarily many native properties and
admissibility coordinates.  An audit vocabulary is complete only relative to
the predicates that preserve a separately generated notion of verifiable
standing identity.

`NativeStandingIdentity` deliberately contains no seven-facet fields.  Its
relation is the downstream interface that a concrete domain must derive from
its native source, legal-transformation, derivation-path, representation,
gluing, contraction, and temporal operations.  Supplying this interface alone
is not a physical producer theorem; a concrete reconstruction must still
construct it from those operations.

Standing relevance is intentionally narrower than mere invariance: a
gauge-invariant mass or trace value can remain a domain property without being
part of the standing contract.  `StandingRelevance` therefore records the
independently generated predicate family and proves only the necessary native
identity invariance.  Agreement on audit atoms implying native standing
identity is a strong sufficient coverage condition for every such family, and
is exact only for the maximal family of all standing-invariant predicates.
Cardinal equality between domain admissibility coordinates and audit atoms is
neither required nor used.
-/

namespace SaturationMonoid
namespace PhysicsCore

universe uPresentation uMove

/-- A domain-native equivalence relation expressing verifiable standing
identity.  Concrete instances must be derived from native operations rather
than from the audit atoms whose completeness is being tested. -/
structure NativeStandingIdentity (State : Type*) where
  sameStanding : State → State → Prop
  refl : ∀ x, sameStanding x x
  symm : ∀ {x y}, sameStanding x y → sameStanding y x
  trans : ∀ {x y z}, sameStanding x y → sameStanding y z → sameStanding x z

/-- Necessary structural condition for standing relevance: the predicate
cannot distinguish presentations with the same native standing identity. -/
def StandingInvariant {State : Type*}
    (I : NativeStandingIdentity State) (target : State → Prop) : Prop :=
  ∀ {x y}, I.sameStanding x y → (target x ↔ target y)

/-- A domain-generated family of predicates whose subject matter is standing,
not arbitrary invariant domain data.  Concrete instances must justify
`relevant` independently of the audit atoms; choosing it from atom
expressibility would make completeness circular. -/
structure StandingRelevance {State : Type*}
    (I : NativeStandingIdentity State) where
  relevant : (State → Prop) → Prop
  invariant : ∀ target, relevant target → StandingInvariant I target

/-- The maximal relevance family contains every native-standing invariant.
It is useful for a strong quotient-completeness theorem, but is generally
strictly broader than the intended standing contract. -/
def maximalStandingRelevance {State : Type*}
    (I : NativeStandingIdentity State) : StandingRelevance I where
  relevant := StandingInvariant I
  invariant := by
    intro target htarget
    exact htarget

/-- A facet-free family of native transformations on one presentation
carrier.  `none` means that a move is not defined at the given presentation;
no audit atom or final standing truth value is stored here. -/
structure NativeStandingOperations
    (Presentation : Type uPresentation) (Move : Type uMove) where
  apply : Move → Presentation → Option Presentation

/-- The equivalence relation generated by successful native transformations.
The closure supplies identity, path composition, and change-of-presentation
symmetry mechanically rather than accepting a caller-provided certificate. -/
inductive GeneratedStandingEquiv
    {Presentation : Type uPresentation} {Move : Type uMove}
    (operations : NativeStandingOperations Presentation Move) :
    Presentation → Presentation → Prop
  | refl (presentation : Presentation) :
      GeneratedStandingEquiv operations presentation presentation
  | step {source target : Presentation} (move : Move)
      (applies : operations.apply move source = some target) :
      GeneratedStandingEquiv operations source target
  | symm {source target : Presentation}
      (related : GeneratedStandingEquiv operations source target) :
      GeneratedStandingEquiv operations target source
  | trans {first second third : Presentation}
      (left : GeneratedStandingEquiv operations first second)
      (right : GeneratedStandingEquiv operations second third) :
      GeneratedStandingEquiv operations first third

/-- The standing identity computed from a native transformation graph. -/
def generatedStandingIdentity
    {Presentation : Type uPresentation} {Move : Type uMove}
    (operations : NativeStandingOperations Presentation Move) :
    NativeStandingIdentity Presentation where
  sameStanding := GeneratedStandingEquiv operations
  refl := GeneratedStandingEquiv.refl
  symm := GeneratedStandingEquiv.symm
  trans := GeneratedStandingEquiv.trans

/-- Direct operational characterization of standing invariance. -/
def NativeMoveInvariant
    {Presentation : Type uPresentation} {Move : Type uMove}
    (operations : NativeStandingOperations Presentation Move)
    (target : Presentation → Prop) : Prop :=
  ∀ move source result,
    operations.apply move source = some result →
      (target source ↔ target result)

/-- For generated standing identity, it is enough and necessary to verify
invariance across each successful native operation. -/
theorem standingInvariant_generatedStandingIdentity_iff_nativeMoveInvariant
    {Presentation : Type uPresentation} {Move : Type uMove}
    (operations : NativeStandingOperations Presentation Move)
    (target : Presentation → Prop) :
    StandingInvariant (generatedStandingIdentity operations) target ↔
      NativeMoveInvariant operations target := by
  constructor
  · intro hstanding move source result happlies
    exact hstanding (.step move happlies)
  · intro hmoves source result hrelated
    induction hrelated with
    | refl _ => rfl
    | step move happlies => exact hmoves move _ _ happlies
    | symm _ ih => exact ih.symm
    | trans _ _ ihleft ihrght => exact ihleft.trans ihrght

/-- Audit soundness: native standing identity never changes an audit atom. -/
def StandingAuditSound {State Atom : Type*}
    (I : NativeStandingIdentity State)
    (S : ObligationSemantics State Atom) : Prop :=
  ∀ {x y}, I.sameStanding x y → AtomEquiv S x y

/-- Strong standing separation: states agreeing on every audit atom have the
same native standing identity.  This is sufficient for any independently
generated standing-relevance family, but need not be necessary for a narrower
family. -/
def StandingAuditSeparates {State Atom : Type*}
    (I : NativeStandingIdentity State)
    (S : ObligationSemantics State Atom) : Prop :=
  ∀ {x y}, AtomEquiv S x y → I.sameStanding x y

/-- An exact audit basis induces exactly the native standing quotient.  This is
stronger than completeness for a selected standing-relevance family. -/
structure StandingAuditBasis {State Atom : Type*}
    (I : NativeStandingIdentity State)
    (S : ObligationSemantics State Atom) : Prop where
  sound : StandingAuditSound I S
  separates : StandingAuditSeparates I S

theorem standingAuditSound_iff_atoms_standingInvariant
    {State Atom : Type*}
    (I : NativeStandingIdentity State)
    (S : ObligationSemantics State Atom) :
    StandingAuditSound I S ↔
      ∀ atom, StandingInvariant I (S.holds atom) := by
  constructor
  · intro sound atom x y hxy
    exact sound hxy atom
  · intro hatoms x y hxy atom
    exact hatoms atom hxy

/-- Strong separation supplies coverage for any independently generated
standing-relevance family. -/
theorem atomCoverage_of_standingAuditSeparates
    {State Atom : Type*}
    (I : NativeStandingIdentity State)
    (S : ObligationSemantics State Atom)
    (R : StandingRelevance I)
    (separates : StandingAuditSeparates I S) :
    AtomCoverageCertificate S R.relevant where
  invariant := by
    intro target htarget x y hxy
    exact R.invariant target htarget (separates hxy)

/-- Coverage of the maximal invariant family recovers strong standing
separation.  The proof uses the standing class of a fixed state as a target. -/
theorem standingAuditSeparates_of_maximalAtomCoverage
    {State Atom : Type*}
    (I : NativeStandingIdentity State)
    (S : ObligationSemantics State Atom)
    (coverage : AtomCoverageCertificate S (StandingInvariant I)) :
    StandingAuditSeparates I S := by
  intro x y hxy
  let target : State → Prop := fun z => I.sameStanding x z
  have htarget : StandingInvariant I target := by
    intro u v huv
    constructor
    · intro hxu
      exact I.trans hxu huv
    · intro hxv
      exact I.trans hxv (I.symm huv)
  have hcovered := coverage.invariant target htarget hxy
  exact hcovered.mp (I.refl x)

/-- Exact criterion only for the maximal family of all standing invariants. -/
theorem standingAuditSeparates_iff_maximalAtomCoverage
    {State Atom : Type*}
    (I : NativeStandingIdentity State)
    (S : ObligationSemantics State Atom) :
    StandingAuditSeparates I S ↔
      AtomCoverageCertificate S (StandingInvariant I) := by
  constructor
  · intro hseparates
    exact atomCoverage_of_standingAuditSeparates I S
      (maximalStandingRelevance I) hseparates
  · exact standingAuditSeparates_of_maximalAtomCoverage I S

/-- For a selected finite standing contract, completeness remains exactly the
explicit Proposition 42 atom-coverage obligation. -/
theorem finiteFacetCompleteFor_standingRelevance_iff_atomCoverage
    {State Atom : Type*}
    [Fintype Atom] [Fintype (Atom → Bool)]
    (I : NativeStandingIdentity State)
    (R : StandingRelevance I)
    (S : ObligationSemantics State Atom) :
    FiniteFacetCompleteFor S R.relevant ↔
      AtomCoverageCertificate S R.relevant :=
  finite_facetComplete_iff_atomCoverage S R.relevant

/-- Strong standing separation is a sufficient, non-circular route to finite
completeness for any selected standing-relevance family. -/
theorem finiteFacetCompleteFor_standingRelevance_of_standingAuditSeparates
    {State Atom : Type*}
    [Fintype Atom] [Fintype (Atom → Bool)]
    (I : NativeStandingIdentity State)
    (R : StandingRelevance I)
    (S : ObligationSemantics State Atom)
    (hseparates : StandingAuditSeparates I S) :
    FiniteFacetCompleteFor S R.relevant :=
  (finite_facetComplete_iff_atomCoverage S R.relevant).mpr
    (atomCoverage_of_standingAuditSeparates I S R hseparates)

/-- Strong quotient completeness is exact when the relevance family is the
maximal family of all standing invariants. -/
theorem finiteFacetCompleteFor_allStandingInvariant_iff_standingAuditSeparates
    {State Atom : Type*}
    [Fintype Atom] [Fintype (Atom → Bool)]
    (I : NativeStandingIdentity State)
    (S : ObligationSemantics State Atom) :
    FiniteFacetCompleteFor S (StandingInvariant I) ↔
      StandingAuditSeparates I S := by
  exact (finite_facetComplete_iff_atomCoverage S (StandingInvariant I)).trans
    (standingAuditSeparates_iff_maximalAtomCoverage I S).symm

theorem StandingAuditBasis.atomEquiv_iff_sameStanding
    {State Atom : Type*}
    {I : NativeStandingIdentity State}
    {S : ObligationSemantics State Atom}
    (basis : StandingAuditBasis I S) {x y : State} :
    AtomEquiv S x y ↔ I.sameStanding x y :=
  ⟨basis.separates, basis.sound⟩

end PhysicsCore
end SaturationMonoid
