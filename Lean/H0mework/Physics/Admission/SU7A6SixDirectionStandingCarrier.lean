import H0mework.Physics.Gauge.SU7A6GaugeStableRootGraphAdapter

/-!
# Six-direction standing carrier over the endpoint-stable SU7/A6 graph

This module replaces the rank-one integration rehearsal with a genuine SU7/A6
source/gauge core.  The base graph is generated by endpoint-stable A6 roots
`3,4,5`; it already carries root reachability, path confluence, and P348 gauge
standing under the nonconstant lineage `(fiber, rootLabel)`.

Equal-lineage pullbacks attach temporal metadata, authority transforms, and a
valid affine contraction.  The resulting carrier supports nontrivial native
SU7 source moves, SU3 frame changes, time advances, authority changes, and
contraction on the same lineage.  Six downstream predicates are proved
standing-invariant.

This is still not a seven-audit closure.  Omega gluing is absent, and the
endpoint-stable root subgraph has not been proved to preserve the full
Schubert/incidence/no-prime/completion filter or to generate a thin source
datum.  No P104/P203 instance is constructed.
-/

namespace SaturationMonoid
namespace PhysicsCore
namespace SU7A6SixDirectionStandingCarrier

open StandardModelConstraint
open SU7A6GaugeStableRootGraphAdapter

noncomputable section

abbrev Lineage := Nat × SU7A6WeightLabel
abbrev BasePresentation := SU7A6GaugeStableRootGraphAdapter.Presentation
abbrev BaseMove := SU7A6GaugeStableRootGraphAdapter.Move

def temporalOperations :
    AnchoredStandingOperations (Lineage × RawTemporalStanding) Nat Lineage :=
  AnchoredStandingPullback.taggedOperations
    (Anchor := Lineage) RawTemporalStanding.standingOperations

abbrev SourceGaugeTemporal :=
  AnchoredStandingPullback operations temporalOperations

namespace SourceGaugeTemporal

def base (presentation : SourceGaugeTemporal) : BasePresentation :=
  presentation.1.1

def temporal (presentation : SourceGaugeTemporal) : RawTemporalStanding :=
  presentation.1.2.2

end SourceGaugeTemporal

def sourceGaugeTemporalPresentation
    (base : BasePresentation) (temporal : RawTemporalStanding) :
    SourceGaugeTemporal :=
  ⟨(base, ((base.fiber, base.rootLabel), temporal)), rfl⟩

def sourceGaugeTemporalAnchored :
    AnchoredStandingOperations SourceGaugeTemporal
      (Sum BaseMove Nat) Lineage :=
  AnchoredStandingPullback.anchoredOperations operations temporalOperations

def authorityOperations :
    AnchoredStandingOperations
      (Lineage × RawAuthorityStanding) RawAuthorityStanding.Move Lineage :=
  AnchoredStandingPullback.taggedOperations
    (Anchor := Lineage) RawAuthorityStanding.standingOperations

abbrev SourceGaugeTemporalAuthority :=
  AnchoredStandingPullback sourceGaugeTemporalAnchored authorityOperations

namespace SourceGaugeTemporalAuthority

def base (presentation : SourceGaugeTemporalAuthority) : BasePresentation :=
  presentation.1.1.base

def temporal
    (presentation : SourceGaugeTemporalAuthority) : RawTemporalStanding :=
  presentation.1.1.temporal

def authority
    (presentation : SourceGaugeTemporalAuthority) : RawAuthorityStanding :=
  presentation.1.2.2

end SourceGaugeTemporalAuthority

def sourceGaugeTemporalAuthorityPresentation
    (presentation : SourceGaugeTemporal)
    (authority : RawAuthorityStanding) : SourceGaugeTemporalAuthority :=
  ⟨(presentation,
      ((presentation.base.fiber, presentation.base.rootLabel), authority)),
    rfl⟩

def sourceGaugeTemporalAuthorityAnchored :
    AnchoredStandingOperations SourceGaugeTemporalAuthority
      (Sum (Sum BaseMove Nat) RawAuthorityStanding.Move) Lineage :=
  AnchoredStandingPullback.anchoredOperations
    sourceGaugeTemporalAnchored authorityOperations

def scaleOperations (scale : RawAffineScaleValidity) :
    AnchoredStandingOperations (Lineage × Real) Unit Lineage :=
  AnchoredStandingPullback.taggedOperations
    (Anchor := Lineage) scale.standingOperations

abbrev State (scale : RawAffineScaleValidity) :=
  AnchoredStandingPullback
    sourceGaugeTemporalAuthorityAnchored (scaleOperations scale)

namespace State

def base {scale : RawAffineScaleValidity}
    (state : State scale) : BasePresentation :=
  state.1.1.base

def temporal {scale : RawAffineScaleValidity}
    (state : State scale) : RawTemporalStanding :=
  state.1.1.temporal

def authority {scale : RawAffineScaleValidity}
    (state : State scale) : RawAuthorityStanding :=
  state.1.1.authority

def scaleValue {scale : RawAffineScaleValidity}
    (state : State scale) : Real :=
  state.1.2.2

end State

def presentation
    (scale : RawAffineScaleValidity)
    (base : BasePresentation)
    (temporal : RawTemporalStanding)
    (authority : RawAuthorityStanding)
    (value : Real) : State scale :=
  let temporalPresentation :=
    sourceGaugeTemporalPresentation base temporal
  let authorityPresentation :=
    sourceGaugeTemporalAuthorityPresentation temporalPresentation authority
  ⟨(authorityPresentation, ((base.fiber, base.rootLabel), value)), rfl⟩

def anchoredOperations (scale : RawAffineScaleValidity) :
    AnchoredStandingOperations (State scale)
      (Sum (Sum (Sum BaseMove Nat) RawAuthorityStanding.Move) Unit)
      Lineage :=
  AnchoredStandingPullback.anchoredOperations
    sourceGaugeTemporalAuthorityAnchored (scaleOperations scale)

def nativeOperations (scale : RawAffineScaleValidity) :
    NativeStandingOperations (State scale)
      (Sum (Sum (Sum BaseMove Nat) RawAuthorityStanding.Move) Unit) :=
  AnchoredStandingPullback.operations
    sourceGaugeTemporalAuthorityAnchored (scaleOperations scale)

def identity (scale : RawAffineScaleValidity) :
    NativeStandingIdentity (State scale) :=
  generatedStandingIdentity (nativeOperations scale)

/-! ## Lifted native invariants -/

theorem taggedTemporal_freshness_standingInvariant :
    StandingInvariant
      (generatedStandingIdentity temporalOperations.toNativeStandingOperations)
      (fun presentation : Lineage × RawTemporalStanding =>
        presentation.2.StandingFresh) :=
  AnchoredStandingPullback.taggedLift_standingInvariant
    (Anchor := Lineage) RawTemporalStanding.standingOperations
    RawTemporalStanding.standingInvariant_standingFresh

theorem taggedAuthority_authorized_standingInvariant :
    StandingInvariant
      (generatedStandingIdentity authorityOperations.toNativeStandingOperations)
      (fun presentation : Lineage × RawAuthorityStanding =>
        presentation.2.StandingAuthorized) :=
  AnchoredStandingPullback.taggedLift_standingInvariant
    (Anchor := Lineage) RawAuthorityStanding.standingOperations
    RawAuthorityStanding.authorized_standingInvariant

theorem taggedScale_eqTarget_standingInvariant
    (scale : RawAffineScaleValidity) (hvalid : scale.ScaleValid) :
    StandingInvariant
      (generatedStandingIdentity
        (scaleOperations scale).toNativeStandingOperations)
      (fun presentation : Lineage × Real =>
        presentation.2 = scale.target) :=
  AnchoredStandingPullback.taggedLift_standingInvariant
    (Anchor := Lineage) scale.standingOperations
    (scale.eqTarget_standingInvariant hvalid)

theorem sourceReachable_standingInvariant
    (scale : RawAffineScaleValidity) :
    StandingInvariant (identity scale)
      (fun state : State scale => state.base.sourceReachable) := by
  exact AnchoredStandingPullback.leftLift_standingInvariant
    sourceGaugeTemporalAuthorityAnchored (scaleOperations scale)
    (AnchoredStandingPullback.leftLift_standingInvariant
      sourceGaugeTemporalAnchored authorityOperations
      (AnchoredStandingPullback.leftLift_standingInvariant
        operations temporalOperations
        SU7A6GaugeStableRootGraphAdapter.sourceReachable_standingInvariant))

theorem sourceConfluent_standingInvariant
    (scale : RawAffineScaleValidity) :
    StandingInvariant (identity scale)
      (fun state : State scale => state.base.sourceConfluent) := by
  exact AnchoredStandingPullback.leftLift_standingInvariant
    sourceGaugeTemporalAuthorityAnchored (scaleOperations scale)
    (AnchoredStandingPullback.leftLift_standingInvariant
      sourceGaugeTemporalAnchored authorityOperations
      (AnchoredStandingPullback.leftLift_standingInvariant
        operations temporalOperations
        SU7A6GaugeStableRootGraphAdapter.sourceConfluent_standingInvariant))

theorem traceExact_standingInvariant
    (scale : RawAffineScaleValidity) :
    StandingInvariant (identity scale)
      (fun state : State scale => ColorLoopTraceExact state.base.field) := by
  exact AnchoredStandingPullback.leftLift_standingInvariant
    sourceGaugeTemporalAuthorityAnchored (scaleOperations scale)
    (AnchoredStandingPullback.leftLift_standingInvariant
      sourceGaugeTemporalAnchored authorityOperations
      (AnchoredStandingPullback.leftLift_standingInvariant
        operations temporalOperations
        SU7A6GaugeStableRootGraphAdapter.traceExact_standingInvariant))

theorem freshness_standingInvariant
    (scale : RawAffineScaleValidity) :
    StandingInvariant (identity scale)
      (fun state : State scale => state.temporal.StandingFresh) := by
  exact AnchoredStandingPullback.leftLift_standingInvariant
    sourceGaugeTemporalAuthorityAnchored (scaleOperations scale)
    (AnchoredStandingPullback.leftLift_standingInvariant
      sourceGaugeTemporalAnchored authorityOperations
      (AnchoredStandingPullback.rightLift_standingInvariant
        operations temporalOperations
        taggedTemporal_freshness_standingInvariant))

theorem authorized_standingInvariant
    (scale : RawAffineScaleValidity) :
    StandingInvariant (identity scale)
      (fun state : State scale => state.authority.StandingAuthorized) := by
  exact AnchoredStandingPullback.leftLift_standingInvariant
    sourceGaugeTemporalAuthorityAnchored (scaleOperations scale)
    (AnchoredStandingPullback.rightLift_standingInvariant
      sourceGaugeTemporalAnchored authorityOperations
      taggedAuthority_authorized_standingInvariant)

theorem contraction_standingInvariant
    (scale : RawAffineScaleValidity) (hvalid : scale.ScaleValid) :
    StandingInvariant (identity scale)
      (fun state : State scale => state.scaleValue = scale.target) := by
  exact AnchoredStandingPullback.rightLift_standingInvariant
    sourceGaugeTemporalAuthorityAnchored (scaleOperations scale)
    (taggedScale_eqTarget_standingInvariant scale hvalid)

/-! ## Source moves remain executable on the full carrier -/

def sourceLowerMove (simpleRoot : StableRootIndex) :
    Sum (Sum (Sum BaseMove Nat) RawAuthorityStanding.Move) Unit :=
  .inl (.inl (.inl (.lower simpleRoot)))

theorem sourceLower_applies
    (scale : RawAffineScaleValidity)
    (base : BasePresentation)
    (simpleRoot : StableRootIndex)
    (temporal : RawTemporalStanding)
    (authority : RawAuthorityStanding)
    (value : Real) :
    ∃ result : State scale,
      (nativeOperations scale).apply (sourceLowerMove simpleRoot)
          (presentation scale base temporal authority value) = some result := by
  let temporalPresentation :=
    sourceGaugeTemporalPresentation base temporal
  let authorityPresentation :=
    sourceGaugeTemporalAuthorityPresentation temporalPresentation authority
  let fullPresentation : State scale :=
    ⟨(authorityPresentation, ((base.fiber, base.rootLabel), value)), rfl⟩
  let nextBase : BasePresentation :=
    { base with moves := simpleRoot ::ₘ base.moves }
  have hbase : operations.apply (.lower simpleRoot) base = some nextBase := by
    rfl
  rcases AnchoredStandingPullback.exists_apply_inl_of_left_apply
      operations temporalOperations
      (source := temporalPresentation) hbase with
    ⟨nextTemporal, hTemporal⟩
  rcases AnchoredStandingPullback.exists_apply_inl_of_left_apply
      sourceGaugeTemporalAnchored authorityOperations
      (source := authorityPresentation) hTemporal with
    ⟨nextAuthority, hAuthority⟩
  rcases AnchoredStandingPullback.exists_apply_inl_of_left_apply
      sourceGaugeTemporalAuthorityAnchored (scaleOperations scale)
      (source := fullPresentation) hAuthority with
    ⟨result, hresult⟩
  exact ⟨result, by
    simpa [nativeOperations, sourceLowerMove, fullPresentation,
      authorityPresentation, temporalPresentation, presentation]
      using hresult⟩

end
end SU7A6SixDirectionStandingCarrier
end PhysicsCore
end SaturationMonoid
