import Mathlib.Analysis.SpecialFunctions.Sqrt
import Mathlib.Tactic

/-! Every real rotation-circle point is generated by the rational quarter-angle parameter. -/
set_option autoImplicit false
namespace SaturationMonoid.PhysicsCore.LowEnergy.Rotation
noncomputable section

def halfCos (parameter : ℝ) : ℝ := (1-parameter^2)/(1+parameter^2)
def halfSin (parameter : ℝ) : ℝ := 2*parameter/(1+parameter^2)
def circleCos (parameter : ℝ) : ℝ := (halfCos parameter)^2-(halfSin parameter)^2
def circleSin (parameter : ℝ) : ℝ := 2*halfCos parameter*halfSin parameter

theorem circleCos_formula (parameter : ℝ) :
    circleCos parameter = (1-6*parameter^2+parameter^4)/(1+parameter^2)^2 := by
  have nonzero : 1+parameter^2 ≠ 0 := ne_of_gt (by positivity)
  unfold circleCos halfCos halfSin
  field_simp
  ring

theorem circleSin_formula (parameter : ℝ) :
    circleSin parameter = 4*parameter*(1-parameter^2)/(1+parameter^2)^2 := by
  have nonzero : 1+parameter^2 ≠ 0 := ne_of_gt (by positivity)
  unfold circleSin halfCos halfSin
  field_simp
  ring

theorem circle_unit (parameter : ℝ) : (circleCos parameter)^2+(circleSin parameter)^2=1 := by
  have nonzero : 1+parameter^2 ≠ 0 := ne_of_gt (by positivity)
  rw [circleCos_formula, circleSin_formula]
  field_simp
  ring

private theorem half_parameter (a b : ℝ) (unit : a^2+b^2=1) (denominator : 1+a ≠ 0) :
    halfCos (b/(1+a))=a ∧ halfSin (b/(1+a))=b := by
  have total : (1+a)^2+b^2 ≠ 0 := ne_of_gt
    (add_pos_of_pos_of_nonneg (sq_pos_of_ne_zero denominator) (sq_nonneg b))
  constructor
  · unfold halfCos
    field_simp
    linear_combination -(1+a)*unit
  · unfold halfSin
    field_simp
    linear_combination -b*unit

theorem circle_surjective (c s : ℝ) (unit : c^2+s^2=1) :
    ∃ parameter : ℝ, circleCos parameter=c ∧ circleSin parameter=s := by
  by_cases endpoint : c = -1
  · have zero : s=0 := by nlinarith [unit]
    refine ⟨1,?_,?_⟩ <;> norm_num [circleCos, circleSin, halfCos, halfSin, endpoint, zero]
  have nonnegative : 0 ≤ 1+c := by nlinarith [sq_nonneg (c+1), sq_nonneg s]
  have positive : 0 < 1+c := by
    by_contra failed
    have : c = -1 := by linarith
    exact endpoint this
  let a := Real.sqrt ((1+c)/2)
  let b := s/(2*a)
  have a_positive : 0 < a := Real.sqrt_pos.2 (by positivity)
  have a_square : a^2=(1+c)/2 := Real.sq_sqrt (by positivity)
  have b_square : b^2=(1-c)/2 := by
    dsimp [b]
    rw [div_pow]
    apply (div_eq_iff (pow_ne_zero 2 (mul_ne_zero (by norm_num) (ne_of_gt a_positive)))).2
    rw [mul_pow, a_square]
    nlinarith [unit]
  have sum_square : a^2+b^2=1 := by linarith
  obtain ⟨cosine,sine⟩ := half_parameter a b sum_square (ne_of_gt (by positivity))
  refine ⟨b/(1+a),?_,?_⟩
  · rw [circleCos, cosine, sine]
    linarith
  · rw [circleSin, cosine, sine]
    dsimp [b]
    field_simp

end
end SaturationMonoid.PhysicsCore.LowEnergy.Rotation
