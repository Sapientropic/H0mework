import H0mework.Physics.LowEnergy.PacketField.Parseval
import Mathlib.MeasureTheory.Measure.Haar.NormedSpace

/-! The source phase e^(+i k x) fixes k=2πh. The physical three-momentum
measure is generated by the actual three-dimensional Haar change of scale. -/
set_option autoImplicit false
open MeasureTheory
namespace SaturationMonoid.PhysicsCore.LowEnergy.PacketField
open FullQuantum FullSpace
noncomputable section
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

theorem physicalFourier_measure (field : Position → E) :
    (∫ frequency : Position, field ((2*Real.pi) • frequency))=
      ((2*Real.pi)^3)⁻¹ • ∫ momentum : Position, field momentum := by
  have generated := Measure.integral_comp_smul_of_nonneg (volume : Measure Position) field (2*Real.pi)
    (hR := by positivity)
  simpa only [finrank_euclideanSpace_fin] using generated

theorem physicalFourier_band (radius : ℝ) (field : Position → E) :
    (∫ frequency in {point : Position | ‖(2*Real.pi) • point‖≤radius}, field ((2*Real.pi) • frequency))=
      ((2*Real.pi)^3)⁻¹ • ∫ momentum in {point : Position | ‖point‖≤radius}, field momentum := by
  let ball : Set Position := {point | ‖point‖≤radius}
  have measurableBall : MeasurableSet ball := (isClosed_le continuous_norm continuous_const).measurableSet
  have scaleContinuous : Continuous (fun point : Position => (2*Real.pi) • point) :=
    (continuous_const (y := (2*Real.pi : ℝ))).smul (continuous_id : Continuous (id : Position → Position))
  have measurableScaled : MeasurableSet {point : Position | ‖(2*Real.pi) • point‖≤radius} :=
    (isClosed_le scaleContinuous.norm continuous_const).measurableSet
  have generated := physicalFourier_measure (ball.indicator field)
  rw [integral_indicator measurableBall] at generated
  rw [← integral_indicator measurableScaled]
  have indicator : (fun frequency : Position =>
      {point : Position | ‖(2*Real.pi) • point‖≤radius}.indicator
        (fun point => field ((2*Real.pi) • point)) frequency)=
      (fun frequency : Position => ball.indicator field ((2*Real.pi) • frequency)) := by
    funext frequency
    simp only [Set.indicator,Set.mem_ofPred_eq,ball]
  rw [indicator]
  exact generated

end
end SaturationMonoid.PhysicsCore.LowEnergy.PacketField
