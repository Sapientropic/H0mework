import H0mework.Physics.LowEnergy.PacketDynamics.Bounded

/-! The complex Fourier current is generated by the same phase in both ordered terms, before conjugate transfers are paired. -/
set_option autoImplicit false
namespace SaturationMonoid.PhysicsCore.LowEnergy.PacketFourier
open FullQuantum FullSpace PacketNoise PacketDynamics Stage9C.Material.SpinPair
noncomputable section

def phaseCurrentMap {energy damping : ℝ} (map : SourceMap energy damping) (shift : Position) (time : ℝ) :
    FullMatterL2 →L[ℂ] FullMatterL2 :=
  (((lapse^2)⁻¹ : ℝ) : ℂ) •
    (boundaryAction.comp ((spatialFlow 0 (-time)).comp
      ((phaseShift shift).toContinuousLinearMap.comp (evolve map time).hamiltonian))+
      (adjointFlow time).comp ((adjointEvolve map.boundary (-time)).shift shift).adjointHamiltonian)

def phaseCurrentGreen (energy damping : ℝ) (positive : 0 < damping) (shift : Position) (time : ℝ) :
    FullMatterL2 →L[ℂ] FullMatterL2 :=
  phaseCurrentMap (greenMap energy damping positive) shift time

def phaseCurrentFilter (energy damping : ℝ) (positive : 0 < damping) (shift : Position) (time : ℝ) :
    FullMatterL2 →L[ℂ] FullMatterL2 :=
  ((‖rawPacket energy damping positive‖⁻¹ : ℝ) : ℂ) • phaseCurrentGreen energy damping positive shift time

end
end SaturationMonoid.PhysicsCore.LowEnergy.PacketFourier
