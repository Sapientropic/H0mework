import H0mework.Physics.LowEnergy.Quantum.SymmetricGraphClosure
import H0mework.Physics.Exterior.GlobalIntegratedAction
import Mathlib.Analysis.InnerProductSpace.Projection.Basic
import Mathlib.Analysis.InnerProductSpace.Projection.Submodule
import Mathlib.Tactic

/-! Bounded range inverses and midpoint steps generated by the original symmetric
closed graph. Source specialization uses its generated reference scale; the
orthogonal defect remains an explicit original-core weak equation. -/
set_option autoImplicit false
noncomputable section
namespace LowEnergy.SourceRetardedGraph
open SymmetricGraphClosure
open scoped InnerProductSpace
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

def sourceMu : ℝ :=
  (SaturationMonoid.PhysicsCore.StageNineGlobalIntegratedAction.sourceGeneratedUnifiedCouplings
    SaturationMonoid.PhysicsCore.StageNineEnrichedProofFreeSource.positiveSmoothUnifiedSource).renormalizationScale

theorem source_mu_large : 1 ≤ sourceMu := by
  change 1 ≤ 1 + (2 * Real.pi) ^ 2
  nlinarith [sq_nonneg (2 * Real.pi)]

theorem closed_graph_pairing_both (T : E →ₗ.[ℂ] E) (symmetric : FormalAdjointPair T T)
    (p q : E × E) (hp : p ∈ closedGraph T) (hq : q ∈ closedGraph T) :
    inner ℂ p.2 q.1 = inner ℂ p.1 q.2 := by
  have h : Set.EqOn (fun z : E × E => inner ℂ p.2 z.1)
      (fun z : E × E => inner ℂ p.1 z.2) (T.graph : Set (E × E)) := by
    intro z hz
    obtain ⟨x, rfl⟩ := T.mem_graph_iff'.mp hz
    exact closed_graph_pairing T T symmetric hp x
  exact h.closure (continuous_const.inner continuous_fst)
    (continuous_const.inner continuous_snd) hq

theorem closed_self_im (T : E →ₗ.[ℂ] E) (symmetric : FormalAdjointPair T T)
    (p : E × E) (hp : p ∈ closedGraph T) : (inner ℂ p.2 p.1).im = 0 := by
  have h := congrArg Complex.im (closed_graph_pairing_both T symmetric p p hp hp)
  have hc := inner_im_symm (𝕜 := ℂ) p.2 p.1
  change (inner ℂ p.2 p.1).im = -(inner ℂ p.1 p.2).im at hc
  linarith

def lower (mu : ℝ) : E × E →L[ℂ] E :=
  ContinuousLinearMap.snd ℂ E E - (Complex.I*(mu : ℂ)) • ContinuousLinearMap.fst ℂ E E

def upper (mu : ℝ) : E × E →L[ℂ] E :=
  ContinuousLinearMap.snd ℂ E E + (Complex.I*(mu : ℂ)) • ContinuousLinearMap.fst ℂ E E

theorem upper_norm_sq (T : E →ₗ.[ℂ] E) (symmetric : FormalAdjointPair T T)
    (mu : ℝ) (p : E × E) (hp : p ∈ closedGraph T) :
    ‖upper mu p‖^2 = ‖p.2‖^2+mu^2*‖p.1‖^2 := by
  have him := closed_self_im T symmetric p hp
  change ‖p.2+(Complex.I*(mu : ℂ)) • p.1‖^2 = _
  rw [norm_add_sq (𝕜 := ℂ), inner_smul_right, norm_smul]
  simp [him, Complex.norm_real,
    Real.norm_eq_abs, mul_pow, sq_abs]

theorem lower_norm_sq (T : E →ₗ.[ℂ] E) (symmetric : FormalAdjointPair T T)
    (mu : ℝ) (p : E × E) (hp : p ∈ closedGraph T) :
    ‖lower mu p‖^2 = ‖p.2‖^2+mu^2*‖p.1‖^2 := by
  have h := upper_norm_sq T symmetric (-mu) p hp
  simpa [upper, lower, sub_eq_add_neg] using h

theorem cayley_equal_norm (T : E →ₗ.[ℂ] E) (symmetric : FormalAdjointPair T T)
    (mu : ℝ) (p : E × E) (hp : p ∈ closedGraph T) :
    ‖upper mu p‖ = ‖lower mu p‖ := by
  have hu := upper_norm_sq T symmetric mu p hp
  have hl := lower_norm_sq T symmetric mu p hp
  nlinarith [norm_nonneg (upper mu p), norm_nonneg (lower mu p)]

theorem lower_graph_bound (T : E →ₗ.[ℂ] E) (symmetric : FormalAdjointPair T T)
    (mu : ℝ) (large : 1 ≤ mu) (p : E × E) (hp : p ∈ closedGraph T) :
    ‖p‖ ≤ ‖lower mu p‖ := by
  have h := lower_norm_sq T symmetric mu p hp
  have hc : 1 ≤ mu^2 := by nlinarith
  have hx := mul_le_mul_of_nonneg_right hc (sq_nonneg ‖p.1‖)
  have h1 : ‖p.1‖ ≤ ‖lower mu p‖ := by
    nlinarith [sq_nonneg ‖p.2‖, norm_nonneg p.1, norm_nonneg (lower mu p)]
  have h2 : ‖p.2‖ ≤ ‖lower mu p‖ := by
    nlinarith [mul_nonneg (sq_nonneg mu) (sq_nonneg ‖p.1‖), norm_nonneg p.2,
      norm_nonneg (lower mu p)]
  exact max_le h1 h2

def lowerOnGraph (T : E →ₗ.[ℂ] E) (mu : ℝ) : closedGraph T →L[ℂ] E :=
  (lower mu).comp (closedGraph T).subtypeL

def upperOnGraph (T : E →ₗ.[ℂ] E) (mu : ℝ) : closedGraph T →L[ℂ] E :=
  (upper mu).comp (closedGraph T).subtypeL

theorem lower_antilipschitz (T : E →ₗ.[ℂ] E) (symmetric : FormalAdjointPair T T)
    (mu : ℝ) (large : 1 ≤ mu) : AntilipschitzWith 1 (lowerOnGraph T mu) := by
  apply (lowerOnGraph T mu).antilipschitz_of_bound
  intro p
  change ‖p.val‖ ≤ 1 * ‖lower mu p.val‖
  simpa only [one_mul] using lower_graph_bound T symmetric mu large p.val p.property

theorem upper_antilipschitz (T : E →ₗ.[ℂ] E) (symmetric : FormalAdjointPair T T)
    (mu : ℝ) (large : 1 ≤ mu) : AntilipschitzWith 1 (upperOnGraph T mu) := by
  apply (upperOnGraph T mu).antilipschitz_of_bound
  intro p
  have h := lower_graph_bound T symmetric mu large p.val p.property
  rw [← cayley_equal_norm T symmetric mu p.val p.property] at h
  change ‖p.val‖ ≤ 1 * ‖upper mu p.val‖
  simpa only [one_mul] using h

def incomingRange (T : E →ₗ.[ℂ] E) (mu : ℝ) : Submodule ℂ E :=
  LinearMap.range (lowerOnGraph T mu).toLinearMap

def outgoingRange (T : E →ₗ.[ℂ] E) (mu : ℝ) : Submodule ℂ E :=
  LinearMap.range (upperOnGraph T mu).toLinearMap

def graphInverse (T : E →ₗ.[ℂ] E) (symmetric : FormalAdjointPair T T)
    (mu : ℝ) (large : 1 ≤ mu) : incomingRange T mu →L[ℂ] closedGraph T := by
  let low := LinearEquiv.ofInjective (lowerOnGraph T mu).toLinearMap
    (lower_antilipschitz T symmetric mu large).injective
  refine low.symm.toLinearMap.mkContinuous 1 ?_
  intro x
  change ‖low.symm x‖ ≤ 1 * ‖(x : E)‖
  have h := lower_graph_bound T symmetric mu large (low.symm x).val (low.symm x).property
  have heq : lowerOnGraph T mu (low.symm x) = (x : E) :=
    congrArg (fun z : incomingRange T mu => (z : E)) (low.apply_symm_apply x)
  change ‖low.symm x‖ ≤ ‖lowerOnGraph T mu (low.symm x)‖ at h
  simpa only [heq, one_mul] using h

theorem lower_graph_inverse (T : E →ₗ.[ℂ] E) (symmetric : FormalAdjointPair T T)
    (mu : ℝ) (large : 1 ≤ mu) (x : incomingRange T mu) :
    lowerOnGraph T mu (graphInverse T symmetric mu large x) = (x : E) := by
  change (lowerOnGraph T mu).toLinearMap
    ((LinearEquiv.ofInjective (lowerOnGraph T mu).toLinearMap
      (lower_antilipschitz T symmetric mu large).injective).symm x) = (x : E)
  exact LinearEquiv.ofInjective_symm_apply (lowerOnGraph T mu).toLinearMap x

theorem graph_inverse_lower (T : E →ₗ.[ℂ] E) (symmetric : FormalAdjointPair T T)
    (mu : ℝ) (large : 1 ≤ mu) (p : closedGraph T) :
    graphInverse T symmetric mu large ⟨lowerOnGraph T mu p, ⟨p, rfl⟩⟩ = p := by
  apply (lower_antilipschitz T symmetric mu large).injective
  exact lower_graph_inverse T symmetric mu large ⟨lowerOnGraph T mu p, ⟨p, rfl⟩⟩

def rangeResolvent (T : E →ₗ.[ℂ] E) (symmetric : FormalAdjointPair T T)
    (mu : ℝ) (large : 1 ≤ mu) : incomingRange T mu →L[ℂ] E :=
  (ContinuousLinearMap.fst ℂ E E).comp
    ((closedGraph T).subtypeL.comp (graphInverse T symmetric mu large))

theorem range_resolvent_graph (T : E →ₗ.[ℂ] E) (symmetric : FormalAdjointPair T T)
    (mu : ℝ) (large : 1 ≤ mu) (f : incomingRange T mu) :
    (rangeResolvent T symmetric mu large f,
      (f : E)+(Complex.I*(mu : ℂ)) • rangeResolvent T symmetric mu large f)
      ∈ closedGraph T := by
  have h := lower_graph_inverse T symmetric mu large f
  change (graphInverse T symmetric mu large f).val.2 -
    (Complex.I*(mu : ℂ)) • (graphInverse T symmetric mu large f).val.1 = (f : E) at h
  rw [sub_eq_iff_eq_add] at h
  change ((graphInverse T symmetric mu large f).val.1,
    (f : E)+(Complex.I*(mu : ℂ)) • (graphInverse T symmetric mu large f).val.1) ∈ _
  rw [← h]
  exact (graphInverse T symmetric mu large f).property

theorem range_resolvent_bound (T : E →ₗ.[ℂ] E) (symmetric : FormalAdjointPair T T)
    (mu : ℝ) (large : 1 ≤ mu) (f : incomingRange T mu) :
    mu * ‖rangeResolvent T symmetric mu large f‖ ≤ ‖(f : E)‖ := by
  let p := graphInverse T symmetric mu large f
  have h := lower_norm_sq T symmetric mu p.val p.property
  have heq := lower_graph_inverse T symmetric mu large f
  change lower mu p.val = (f : E) at heq
  rw [heq] at h
  change mu * ‖p.val.1‖ ≤ ‖(f : E)‖
  nlinarith [sq_nonneg ‖p.val.2‖, norm_nonneg (f : E)]

def rangeStep (T : E →ₗ.[ℂ] E) (symmetric : FormalAdjointPair T T)
    (mu : ℝ) (large : 1 ≤ mu) : incomingRange T mu →L[ℂ] E :=
  -((upperOnGraph T mu).comp (graphInverse T symmetric mu large))

theorem range_step_norm (T : E →ₗ.[ℂ] E) (symmetric : FormalAdjointPair T T)
    (mu : ℝ) (large : 1 ≤ mu) (f : incomingRange T mu) :
    ‖rangeStep T symmetric mu large f‖ = ‖(f : E)‖ := by
  let p := graphInverse T symmetric mu large f
  change ‖-(upper mu p.val)‖ = _
  rw [norm_neg, cayley_equal_norm T symmetric mu p.val p.property]
  exact congrArg norm (lower_graph_inverse T symmetric mu large f)

theorem range_step_midpoint (T : E →ₗ.[ℂ] E) (symmetric : FormalAdjointPair T T)
    (mu : ℝ) (large : 1 ≤ mu) (f : incomingRange T mu) :
    (((2 : ℂ)⁻¹) • ((f : E)+rangeStep T symmetric mu large f),
      (Complex.I*(mu : ℂ)/2) • (rangeStep T symmetric mu large f-(f : E)))
      ∈ closedGraph T := by
  let p := graphInverse T symmetric mu large f
  have heq := lower_graph_inverse T symmetric mu large f
  change p.val.2-(Complex.I*(mu : ℂ)) • p.val.1 = (f : E) at heq
  change (((2 : ℂ)⁻¹) • ((f : E)+ -(p.val.2+(Complex.I*(mu : ℂ)) • p.val.1)),
      (Complex.I*(mu : ℂ)/2) • (-(p.val.2+(Complex.I*(mu : ℂ)) • p.val.1)-(f : E)))
      ∈ closedGraph T
  rw [← heq]
  convert (closedGraph T).smul_mem (-(Complex.I*(mu : ℂ))) p.property using 1
  congr 1 <;> module

def cayleyRange (T : E →ₗ.[ℂ] E) (symmetric : FormalAdjointPair T T)
    (mu : ℝ) (large : 1 ≤ mu) : incomingRange T mu ≃ₗᵢ[ℂ] outgoingRange T mu := by
  let low := LinearEquiv.ofInjective (lowerOnGraph T mu).toLinearMap
    (lower_antilipschitz T symmetric mu large).injective
  let high := LinearEquiv.ofInjective (upperOnGraph T mu).toLinearMap
    (upper_antilipschitz T symmetric mu large).injective
  refine { toLinearEquiv := low.symm.trans high, norm_map' := ?_ }
  intro x
  change ‖upperOnGraph T mu (low.symm x)‖ = ‖(x : E)‖
  calc
    ‖upperOnGraph T mu (low.symm x)‖ = ‖lowerOnGraph T mu (low.symm x)‖ :=
      cayley_equal_norm T symmetric mu (low.symm x).val (low.symm x).property
    _ = ‖(x : E)‖ := congrArg (fun z : incomingRange T mu => ‖(z : E)‖)
      (low.apply_symm_apply x)

theorem incoming_range_closed [CompleteSpace E]
    (T : E →ₗ.[ℂ] E) (symmetric : FormalAdjointPair T T) (mu : ℝ) (large : 1 ≤ mu) :
    IsClosed (incomingRange T mu : Set E) := by
  let : CompleteSpace (closedGraph T) :=
    T.graph.isClosed_topologicalClosure.isComplete.completeSpace_coe
  exact (lower_antilipschitz T symmetric mu large).isClosed_range
    (lowerOnGraph T mu).uniformContinuous

def defect (T : E →ₗ.[ℂ] E) (mu : ℝ) : Submodule ℂ E := (incomingRange T mu).orthogonal

theorem mem_defect_iff (T : E →ₗ.[ℂ] E) (mu : ℝ) (h : E) :
    h ∈ defect T mu ↔ ∀ p ∈ closedGraph T,
      inner ℂ p.2 h = inner ℂ p.1 ((-(Complex.I*(mu : ℂ))) • h) := by
  change (∀ u ∈ incomingRange T mu, inner ℂ u h = 0) ↔ _
  constructor
  · intro hd p hp
    have hz := hd (lowerOnGraph T mu ⟨p, hp⟩) ⟨⟨p, hp⟩, rfl⟩
    change inner ℂ (p.2-(Complex.I*(mu : ℂ)) • p.1) h = 0 at hz
    simpa [inner_sub_left, inner_smul_left, inner_smul_right, sub_eq_zero,
      ← eq_neg_iff_add_eq_zero, mul_comm] using hz
  · intro hw u hu
    obtain ⟨p, rfl⟩ := hu
    change inner ℂ (p.val.2-(Complex.I*(mu : ℂ)) • p.val.1) h = 0
    simpa [inner_sub_left, inner_smul_left, inner_smul_right, sub_eq_zero,
      ← eq_neg_iff_add_eq_zero, mul_comm] using
      hw p.val p.property

theorem mem_defect_iff_core (T : E →ₗ.[ℂ] E) (mu : ℝ) (h : E) :
    h ∈ defect T mu ↔ ∀ x : T.domain,
      inner ℂ (T x) h = inner ℂ (x : E) ((-(Complex.I*(mu : ℂ))) • h) := by
  rw [mem_defect_iff]
  constructor
  · intro hw x
    exact hw ((x : E), T x) (T.graph.le_topologicalClosure (T.mem_graph x))
  · intro hw p hp
    have heq : Set.EqOn (fun z : E × E => inner ℂ z.2 h)
        (fun z : E × E => inner ℂ z.1 ((-(Complex.I*(mu : ℂ))) • h))
        (T.graph : Set (E × E)) := by
      intro z hz
      obtain ⟨x, rfl⟩ := T.mem_graph_iff'.mp hz
      exact hw x
    exact heq.closure (continuous_snd.inner continuous_const)
      (continuous_fst.inner continuous_const) hp

theorem mem_range_iff_defect [CompleteSpace E] (T : E →ₗ.[ℂ] E)
    (symmetric : FormalAdjointPair T T) (mu : ℝ) (large : 1 ≤ mu) (f : E) :
    f ∈ incomingRange T mu ↔ ∀ h ∈ defect T mu, inner ℂ h f = 0 := by
  change f ∈ incomingRange T mu ↔ f ∈ (incomingRange T mu).orthogonal.orthogonal
  rw [Submodule.orthogonal_orthogonal_eq_closure,
    (incoming_range_closed T symmetric mu large).submodule_topologicalClosure_eq]

#print axioms closed_graph_pairing_both
#print axioms cayley_equal_norm
#print axioms lower_graph_bound
#print axioms cayleyRange
#print axioms incoming_range_closed
#print axioms mem_defect_iff_core
#print axioms range_resolvent_graph
#print axioms range_resolvent_bound
#print axioms mem_range_iff_defect
#print axioms range_step_norm
#print axioms range_step_midpoint
#print axioms source_mu_large
end LowEnergy.SourceRetardedGraph
