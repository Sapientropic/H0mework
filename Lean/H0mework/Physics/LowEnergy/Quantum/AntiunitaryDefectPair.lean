import Mathlib.Analysis.InnerProductSpace.LinearPMap

/-! Conjugate defect spaces generated by an antiunitary symmetry of the test action. -/

namespace LowEnergy.AntiunitaryDefectPair

open scoped ComplexConjugate LinearPMap

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

theorem antiunitary_inner (C : E ≃ₛₗᵢ[starRingEnd ℂ] E) (x y : E) :
    inner ℂ (C x) (C y) = conj (inner ℂ x y) := by
  have hplus : C (x + (RCLike.I : ℂ) • y) = C x - (RCLike.I : ℂ) • C y := by
    simp [map_add, map_smulₛₗ, sub_eq_add_neg]
  have hminus : C (x - (RCLike.I : ℂ) • y) = C x + (RCLike.I : ℂ) • C y := by
    simp [map_sub, map_smulₛₗ]
  apply Complex.ext
  · change RCLike.re (inner ℂ (C x) (C y)) = RCLike.re (inner ℂ x y)
    simp only [re_inner_eq_norm_add_mul_self_sub_norm_sub_mul_self_div_four,
      ← C.map_add, ← C.map_sub, C.norm_map]
  · change RCLike.im (inner ℂ (C x) (C y)) = -RCLike.im (inner ℂ x y)
    simp only [im_inner_eq_norm_sub_i_smul_mul_self_sub_norm_add_i_smul_mul_self_div_four]
    rw [← hplus, ← hminus, C.norm_map, C.norm_map]
    ring

/-- Test-domain equations, with eigenvalue convention `T† u = z • u`. -/
def defectSpace (T : E →ₗ.[ℂ] E) (z : ℂ) : Submodule ℂ E where
  carrier := {u | ∀ x : T.domain, inner ℂ u (T x) = inner ℂ (z • u) (x : E)}
  zero_mem' := by simp
  add_mem' := by
    intro u v hu hv x
    simp only [inner_add_left, smul_add, hu x, hv x]
  smul_mem' := by
    intro a u hu x
    simp only [inner_smul_left, smul_comm z a u, hu x]

theorem mem_defect_iff_adjoint [CompleteSpace E] (T : E →ₗ.[ℂ] E)
    (hdense : Dense (T.domain : Set E)) (z : ℂ) (u : E) :
    u ∈ defectSpace T z ↔ ∃ hu : u ∈ T†.domain, T† ⟨u, hu⟩ = z • u := by
  constructor
  · intro hu
    have hmem : u ∈ T†.domain :=
      LinearPMap.mem_adjoint_domain_of_exists u ⟨z • u, fun x => (hu x).symm⟩
    exact ⟨hmem, LinearPMap.adjoint_apply_eq hdense ⟨u, hmem⟩ (fun x => (hu x).symm)⟩
  · rintro ⟨hu, hvalue⟩ x
    have h := LinearPMap.adjoint_isFormalAdjoint hdense ⟨u, hu⟩ x
    simpa [hvalue] using h.symm

structure DomainSymmetry (T : E →ₗ.[ℂ] E) (C : E ≃ₛₗᵢ[starRingEnd ℂ] E) : Prop where
  domain_iff : ∀ x : E, C x ∈ T.domain ↔ x ∈ T.domain
  commute : ∀ x : T.domain,
    T ⟨C x, (domain_iff x).2 x.property⟩ = C (T x)

theorem maps_defect (T : E →ₗ.[ℂ] E) (C : E ≃ₛₗᵢ[starRingEnd ℂ] E)
    (hsym : DomainSymmetry T C) (z : ℂ) {u : E} (hu : u ∈ defectSpace T z) :
    C u ∈ defectSpace T (conj z) := by
  intro x
  have hpre : C.symm x ∈ T.domain := (hsym.domain_iff (C.symm x)).1 (by simp)
  let y : T.domain := ⟨C.symm x, hpre⟩
  have hxy : (C y : E) = x := C.apply_symm_apply x
  have hTx : T x = C (T y) := by
    have h := hsym.commute y
    simpa only [y, C.apply_symm_apply] using h
  rw [hTx, antiunitary_inner, hu y]
  have hz : C (z • u) = conj z • C u := by simp [map_smulₛₗ]
  rw [← hz, ← hxy, antiunitary_inner]

theorem DomainSymmetry.symm (T : E →ₗ.[ℂ] E) (C : E ≃ₛₗᵢ[starRingEnd ℂ] E)
    (hsym : DomainSymmetry T C) : DomainSymmetry T C.symm where
  domain_iff x := by simpa only [C.apply_symm_apply] using (hsym.domain_iff (C.symm x)).symm
  commute x := by
    apply C.injective
    have hpre : C.symm x ∈ T.domain := (hsym.domain_iff (C.symm x)).1 (by simp)
    have h := hsym.commute ⟨C.symm x, hpre⟩
    simpa only [C.apply_symm_apply] using h.symm

/-- The inverse uses `C.symm`; no involution or chosen defect-space pairing is required. -/
def defectEquiv (T : E →ₗ.[ℂ] E) (C : E ≃ₛₗᵢ[starRingEnd ℂ] E)
    (hsym : DomainSymmetry T C) (z : ℂ) :
    defectSpace T z ≃ₛₗᵢ[starRingEnd ℂ] defectSpace T (conj z) where
  toFun u := ⟨C u, maps_defect T C hsym z u.property⟩
  invFun u := ⟨C.symm u, by
    simpa using maps_defect T C.symm (hsym.symm T C) (conj z) u.property⟩
  left_inv u := Subtype.ext (C.symm_apply_apply u)
  right_inv u := Subtype.ext (C.apply_symm_apply u)
  map_add' u v := Subtype.ext (C.map_add u v)
  map_smul' a u := Subtype.ext (C.map_smulₛₗ a u)
  norm_map' u := C.norm_map u

theorem defectEquiv_apply (T : E →ₗ.[ℂ] E) (C : E ≃ₛₗᵢ[starRingEnd ℂ] E)
    (hsym : DomainSymmetry T C) (z : ℂ) (u : defectSpace T z) :
    (defectEquiv T C hsym z u : E) = C u := rfl

end LowEnergy.AntiunitaryDefectPair
