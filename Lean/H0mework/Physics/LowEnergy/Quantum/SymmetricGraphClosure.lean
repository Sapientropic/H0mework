import Mathlib.Analysis.InnerProductSpace.Continuous
import Mathlib.LinearAlgebra.LinearPMap
import Mathlib.Topology.Algebra.Module.Basic

/-!
Minimal closed extensions generated by a dense formal-adjoint test domain.
For the source form consumer, the concrete integral inner product and dense smooth
domain remain an instance obligation.  The second operator is an adjoint-domain
test action; it is not an interaction added to the first operator.
-/

set_option autoImplicit false

namespace LowEnergy.SymmetricGraphClosure

open Filter Topology
open scoped InnerProductSpace

variable {𝕜 E : Type*} [RCLike 𝕜] [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]

def FormalAdjointPair (T S : E →ₗ.[𝕜] E) : Prop :=
  ∀ (x : T.domain) (y : S.domain), inner 𝕜 (T x) (y : E) = inner 𝕜 (x : E) (S y)

def closedGraph (T : E →ₗ.[𝕜] E) : Submodule 𝕜 (E × E) :=
  T.graph.topologicalClosure

theorem closed_graph_pairing (T S : E →ₗ.[𝕜] E) (hpair : FormalAdjointPair T S)
    {p : E × E} (hp : p ∈ closedGraph T) (d : S.domain) :
    inner 𝕜 p.2 (d : E) = inner 𝕜 p.1 (S d) := by
  have h : Set.EqOn (fun q : E × E => inner 𝕜 q.2 (d : E))
      (fun q : E × E => inner 𝕜 q.1 (S d)) (T.graph : Set (E × E)) := by
    intro q hq
    obtain ⟨x, rfl⟩ := T.mem_graph_iff'.mp hq
    exact hpair x d
  exact h.closure (continuous_snd.inner continuous_const)
    (continuous_fst.inner continuous_const) hp

theorem closed_graph_zero_fiber (T S : E →ₗ.[𝕜] E)
    (hdense : Dense (S.domain : Set E)) (hpair : FormalAdjointPair T S)
    {p : E × E} (hp : p ∈ closedGraph T) (hzero : p.1 = 0) : p.2 = 0 := by
  have h : Set.EqOn (fun z : E => inner 𝕜 p.2 z) (fun _ => 0) (S.domain : Set E) := by
    intro z hz
    have heq := closed_graph_pairing T S hpair hp ⟨z, hz⟩
    simpa [hzero] using heq
  exact (inner_self_eq_zero (𝕜 := 𝕜)).mp
    (h.closure (continuous_const.inner continuous_id) continuous_const (hdense p.2))

theorem closed_graph_single_valued (T S : E →ₗ.[𝕜] E)
    (hdense : Dense (S.domain : Set E)) (hpair : FormalAdjointPair T S)
    {x y z : E} (hy : (x, y) ∈ closedGraph T) (hz : (x, z) ∈ closedGraph T) : y = z := by
  exact sub_eq_zero.mp
    (closed_graph_zero_fiber T S hdense hpair ((closedGraph T).sub_mem hy hz) (sub_self x))

noncomputable def closedExtension (T S : E →ₗ.[𝕜] E)
    (hdense : Dense (S.domain : Set E)) (hpair : FormalAdjointPair T S) : E →ₗ.[𝕜] E where
  domain := (closedGraph T).map (LinearMap.fst 𝕜 E E)
  toFun := (closedGraph T).toLinearPMapAux
    (fun _ hp hzero => closed_graph_zero_fiber T S hdense hpair hp hzero)

theorem closed_extension_graph (T S : E →ₗ.[𝕜] E)
    (hdense : Dense (S.domain : Set E)) (hpair : FormalAdjointPair T S) :
    (closedExtension T S hdense hpair).graph = closedGraph T := by
  classical
  have hg : ∀ p : E × E, p ∈ closedGraph T → p.1 = 0 → p.2 = 0 :=
    fun _ hp hzero => closed_graph_zero_fiber T S hdense hpair hp hzero
  have heq : closedExtension T S hdense hpair = (closedGraph T).toLinearPMap := by
    simp only [closedExtension, Submodule.toLinearPMap, dif_pos hg]
  rw [heq]
  exact (closedGraph T).toLinearPMap_graph_eq hg

theorem closed_extension_isClosed (T S : E →ₗ.[𝕜] E)
    (hdense : Dense (S.domain : Set E)) (hpair : FormalAdjointPair T S) :
    IsClosed ((closedExtension T S hdense hpair).graph : Set (E × E)) := by
  rw [closed_extension_graph]
  exact T.graph.isClosed_topologicalClosure

theorem extends_original (T S : E →ₗ.[𝕜] E)
    (hdense : Dense (S.domain : Set E)) (hpair : FormalAdjointPair T S) :
    T ≤ closedExtension T S hdense hpair := by
  apply LinearPMap.le_of_le_graph
  rw [closed_extension_graph]
  exact T.graph.le_topologicalClosure

theorem minimal_closed_extension (T S : E →ₗ.[𝕜] E)
    (hdense : Dense (S.domain : Set E)) (hpair : FormalAdjointPair T S)
    (U : E →ₗ.[𝕜] E) (hextends : T ≤ U) (hclosed : IsClosed (U.graph : Set (E × E))) :
    closedExtension T S hdense hpair ≤ U := by
  apply LinearPMap.le_of_le_graph
  rw [closed_extension_graph]
  exact T.graph.topologicalClosure_minimal (LinearPMap.le_graph_of_le hextends) hclosed

theorem zero_sequence_limit (T S : E →ₗ.[𝕜] E)
    (hdense : Dense (S.domain : Set E)) (hpair : FormalAdjointPair T S)
    (x : ℕ → T.domain) (y : E)
    (hx : Tendsto (fun n => (x n : E)) atTop (𝓝 0))
    (hTx : Tendsto (fun n => T (x n)) atTop (𝓝 y)) : y = 0 := by
  have hmem : (0, y) ∈ closedGraph T :=
    T.graph.isClosed_topologicalClosure.mem_of_tendsto (hx.prodMk_nhds hTx)
      (Eventually.of_forall fun n => T.graph.le_topologicalClosure (T.mem_graph (x n)))
  exact closed_graph_zero_fiber T S hdense hpair hmem rfl

/-- A symmetric action supplies its own dense formal-adjoint test domain. -/
theorem symmetric_zero_sequence_limit (T : E →ₗ.[𝕜] E)
    (hdense : Dense (T.domain : Set E)) (hsymmetric : FormalAdjointPair T T)
    (x : ℕ → T.domain) (y : E)
    (hx : Tendsto (fun n => (x n : E)) atTop (𝓝 0))
    (hTx : Tendsto (fun n => T (x n)) atTop (𝓝 y)) : y = 0 :=
  zero_sequence_limit T T hdense hsymmetric x y hx hTx

end LowEnergy.SymmetricGraphClosure
