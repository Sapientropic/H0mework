/-! Full primal time symbols are generated by the original temporal principal.
The independent dual and positive Hilbert adjoint remain distinct. -/
set_option autoImplicit false
namespace SaturationMonoid.PhysicsCore.LowEnergy.FullQuantum
open DiracCliffordRepresentation DiracExteriorMatterAction PointwiseDiracSpinConnectionLift
open ProofFreeRicherAnholonomicSource StageNineHolonomicField SU7MotherLieAlgebra
open StageNineCurrentCoframeMatterTemporalPrincipal StageNineCurrentCoframeMatterTimeResponse
open StageNineDiracDualFormNativeRepairedMatterResponseOperator
open StageNineDiracDualYukawaSpinJurisdiction SU7ExteriorBreakingYukawa
open StageNineDynamicBreakingVacuum
open Stage9C.Material.SpinPair
open Stage9C.Dynamics.Homogeneous StageNineFullDiracAdjointMaterial
open StageNineCoframeLocalDifferentiability
open scoped Matrix
noncomputable section

abbrev Mother := Module.End ℂ DiracExteriorMatterCarrier

def connection (C : StageNineHolonomicConfiguration) (p : BasePoint)
    (mu : LorentzianIndex) : Mother :=
  diracMatrixMatterAction (diracSpinConnectionLift (C.gravityConnection p) mu) +
    diracExteriorMotherLieAction (p286LieBlockEmbed (C.gaugeConnection p mu))

theorem connection_original (C : StageNineHolonomicConfiguration) (p : BasePoint)
    (mu : LorentzianIndex) :
    connection C p mu (C.matter p) = holonomicMatterConnectionAction C p mu := rfl

def knownSymbol (C : StageNineHolonomicConfiguration) (p : BasePoint)
    (k : Fin 3 → ℝ) : Mother :=
  Complex.I • ∑ j : Fin 3,
    (diracMatrixMatterAction (inverseCoframeDiracGamma
      { coframe := C.coframe p, derivative := 0 } j.succ)).comp
      ((Complex.I * (k j : ℂ)) • (1 : Mother) + connection C p j.succ) +
    diracDualRightChiralYukawaAction (scalarCoordinateEquiv.symm (C.scalar p))

def drift (C : StageNineHolonomicConfiguration) (p : BasePoint)
    (k : Fin 3 → ℝ) : Mother :=
  -(currentCoframeMatterTemporalPrincipalInverse (C.coframe p)).comp
    (knownSymbol C p k) - connection C p 0

def hamiltonian (C : StageNineHolonomicConfiguration) (p : BasePoint)
    (k : Fin 3 → ℝ) : Mother := Complex.I • drift C p k

theorem hamiltonian_drift (C : StageNineHolonomicConfiguration) (p : BasePoint)
    (k : Fin 3 → ℝ) : (-Complex.I) • hamiltonian C p k = drift C p k := by
  simp [hamiltonian, smul_smul]

theorem full_temporal_equation (C : StageNineHolonomicConfiguration) (p : BasePoint)
    (k : Fin 3 → ℝ) (noncharacteristic : coframeTemporalPrincipalScalar (C.coframe p) ≠ 0)
    (v : DiracExteriorMatterCarrier) :
    currentCoframeMatterTemporalPrincipal (C.coframe p)
      (drift C p k v + connection C p 0 v) + knownSymbol C p k v = 0 := by
  simp only [drift, LinearMap.sub_apply, LinearMap.neg_apply, LinearMap.comp_apply,
    sub_add_cancel, map_neg]
  rw [currentCoframeMatterTemporalPrincipalInverse_right _ noncharacteristic]
  exact neg_add_cancel _

def lowerSymbol (C : StageNineHolonomicConfiguration) (p : BasePoint)
    (k : Fin 3 → ℝ) : Mother :=
  knownSymbol C p k + (currentCoframeMatterTemporalPrincipal (C.coframe p)).comp
    (connection C p 0)

def dualDrift (C : StageNineHolonomicConfiguration) (p : BasePoint)
    (k : Fin 3 → ℝ) : Mother :=
  (lowerSymbol C p k).comp (currentCoframeMatterTemporalPrincipalInverse (C.coframe p))

theorem dualDrift_original (C : StageNineHolonomicConfiguration) (p : BasePoint)
    (k : Fin 3 → ℝ) (noncharacteristic : coframeTemporalPrincipalScalar (C.coframe p) ≠ 0)
    (v : DiracExteriorMatterCarrier) :
    dualDrift C p k v = -currentCoframeMatterTemporalPrincipal (C.coframe p)
      (drift C p k (currentCoframeMatterTemporalPrincipalInverse (C.coframe p) v)) := by
  have equation := full_temporal_equation C p k noncharacteristic
    (currentCoframeMatterTemporalPrincipalInverse (C.coframe p) v)
  simp only [dualDrift, lowerSymbol, LinearMap.comp_apply, LinearMap.add_apply]
  rw [map_add] at equation
  have reordered := equation
  rw [add_assoc, add_comm
    (currentCoframeMatterTemporalPrincipal (C.coframe p)
      (connection C p 0 (currentCoframeMatterTemporalPrincipalInverse (C.coframe p) v)))
    (knownSymbol C p k (currentCoframeMatterTemporalPrincipalInverse (C.coframe p) v))] at reordered
  exact eq_neg_of_add_eq_zero_right reordered

def normalizedMomentum (C : StageNineHolonomicConfiguration) (p : BasePoint)
    (chi : Module.Dual ℂ DiracExteriorMatterCarrier) :
    Module.Dual ℂ DiracExteriorMatterCarrier :=
  (-Complex.I * ((|(C.coframe p).det| : ℝ) : ℂ)) •
    chi.comp (currentCoframeMatterTemporalPrincipal (C.coframe p))

theorem actual_temporal_principal (p : BasePoint) (v : DiracExteriorMatterCarrier) :
    currentCoframeMatterTemporalPrincipal (actual.coframe p) v =
      (Complex.I * (lapse : ℂ)⁻¹) • diracMatrixMatterAction diracGammaZero v := by
  unfold currentCoframeMatterTemporalPrincipal
  rw [actual_coframe, homogeneousInverseGamma lapse (ne_of_gt lapse_pos)]
  simp [coframeDiracMatrixMatterAction_smul_matrix, smul_smul, diracGamma]

theorem actual_noncharacteristic (p : BasePoint) :
    coframeTemporalPrincipalScalar (actual.coframe p) ≠ 0 := by
  rw [actual_coframe]
  unfold coframeTemporalPrincipalScalar
  rw [homogeneousCoframe_inv lapse (ne_of_gt lapse_pos)]
  simp [homogeneousCoframe, Fin.sum_univ_four, minkowskiInternalSign,
    ne_of_gt lapse_pos]

theorem normalizedMomentum_original_kinetic (p : BasePoint) (density : ℝ)
    (matter velocity : DiracExteriorMatterCarrier) :
    normalizedMomentum actual p ((density : ℂ) • fullCanonicalDiracAdjoint matter) velocity =
      Kinetic.kineticPair density matter velocity := by
  simp only [normalizedMomentum, LinearMap.smul_apply, LinearMap.comp_apply,
    actual_temporal_principal, map_smul, smul_eq_mul]
  rw [actual_coframe, homogeneousCoframe_det, abs_of_pos lapse_pos]
  change (-Complex.I * (lapse : ℂ)) * ((Complex.I * (lapse : ℂ)⁻¹) *
    ((density : ℂ) * fullCanonicalDiracAdjoint matter
      (diracMatrixMatterAction (diracGamma 0) velocity))) = _
  rw [Kinetic.canonical_time_pair]
  unfold Kinetic.kineticPair
  have nz : (lapse : ℂ) ≠ 0 := by exact_mod_cast ne_of_gt lapse_pos
  field_simp
  simp [Complex.I_sq]

theorem knownSymbol_original (C : StageNineHolonomicConfiguration) (p : BasePoint)
    (k : Fin 3 → ℝ)
    (spatialJet : ∀ j : Fin 3, holonomicMatterCovariantDerivative C p j.succ =
      (Complex.I * (k j : ℂ)) • C.matter p + connection C p j.succ (C.matter p)) :
    knownSymbol C p k (C.matter p) =
      holonomicDiracDualCurrentCoframeMatterKnownVector C p := by
  simp only [knownSymbol, LinearMap.add_apply, LinearMap.smul_apply, LinearMap.sum_apply,
    LinearMap.comp_apply, Module.End.one_apply,
    holonomicDiracDualCurrentCoframeMatterKnownVector, spatialJet]

theorem drift_original (C : StageNineHolonomicConfiguration) (p : BasePoint)
    (k : Fin 3 → ℝ)
    (spatialJet : ∀ j : Fin 3, holonomicMatterCovariantDerivative C p j.succ =
      (Complex.I * (k j : ℂ)) • C.matter p + connection C p j.succ (C.matter p)) :
    drift C p k (C.matter p) =
      actionGeneratedHolonomicDiracDualCurrentCoframeMatterRawTimeVelocity C p := by
  simp only [drift, LinearMap.sub_apply, LinearMap.neg_apply, LinearMap.comp_apply,
    knownSymbol_original C p k spatialJet, connection_original]
  rfl

theorem actual_spatial_jet (p : BasePoint) (j : Fin 3) :
    holonomicMatterCovariantDerivative actual p j.succ =
      (Complex.I * ((0 : Fin 3 → ℝ) j : ℂ)) • actual.matter p +
        connection actual p j.succ (actual.matter p) := by
  unfold holonomicMatterCovariantDerivative
  rw [actual_matterCoordinateDerivative]
  simp [connection]

theorem actual_drift (p : BasePoint) :
    drift actual p 0 (actual.matter p) =
      actionGeneratedHolonomicDiracDualCurrentCoframeMatterRawTimeVelocity actual p :=
  drift_original actual p 0 (actual_spatial_jet p)

def yukawaHamiltonian (scalar : ExteriorBreakingScalarCarrier) : Mother :=
  (lapse : ℂ) • (diracMatrixMatterAction diracGammaZero).comp
    (diracDualRightChiralYukawaAction scalar)

theorem yukawa_time_coefficient (scalar : ExteriorBreakingScalarCarrier)
    (v : DiracExteriorMatterCarrier) :
    (Complex.I * (lapse : ℂ)⁻¹) • diracMatrixMatterAction diracGammaZero
      ((-Complex.I) • yukawaHamiltonian scalar v) +
      diracDualRightChiralYukawaAction scalar v = 0 := by
  simp only [yukawaHamiltonian, LinearMap.smul_apply, LinearMap.comp_apply, map_smul,
    diracMatrixMatterAction_apply_apply, diracGammaZero_sq, smul_smul]
  have nz : (lapse : ℂ) ≠ 0 := by exact_mod_cast ne_of_gt lapse_pos
  field_simp
  have negative (w : DiracExteriorMatterCarrier) :
      diracMatrixMatterAction (-1) w = -w := by
    funext row
    fin_cases row <;> simp [diracMatrixMatterAction, Matrix.one_apply, Fin.sum_univ_four]
    · exact neg_one_smul ℂ (w 0)
    · exact neg_one_smul ℂ (w 1)
    · exact neg_one_smul ℂ (w 2)
    · exact neg_one_smul ℂ (w 3)
  rw [negative]
  simp [Complex.I_sq]

theorem yukawa_time_insertions (first second : ExteriorBreakingScalarCarrier)
    (P : Mother)
    (preserves : MixedSymbol.degreeSix.comp P = P.comp MixedSymbol.degreeSix) :
    (yukawaHamiltonian first).comp (P.comp (yukawaHamiltonian second)) = 0 := by
  have middle : MixedSymbol.degreeSix.comp
      (P.comp (diracMatrixMatterAction diracGammaZero)) =
      (P.comp (diracMatrixMatterAction diracGammaZero)).comp MixedSymbol.degreeSix := by
    rw [← LinearMap.comp_assoc, preserves, LinearMap.comp_assoc,
      MixedSymbol.degreeSix_spin, ← LinearMap.comp_assoc]
  have vanished := MixedSymbol.yukawa_propagator_yukawa first second
    (P.comp (diracMatrixMatterAction diracGammaZero)) middle
  apply LinearMap.ext
  intro v
  have value := LinearMap.congr_fun vanished v
  simp only [LinearMap.comp_apply, LinearMap.zero_apply] at value
  simp only [yukawaHamiltonian, LinearMap.comp_apply, LinearMap.smul_apply, map_smul]
  rw [value]
  simp

theorem yukawa_time_square (scalar : ExteriorBreakingScalarCarrier) :
    yukawaHamiltonian scalar * yukawaHamiltonian scalar = 0 := by
  apply LinearMap.ext
  intro v
  exact LinearMap.congr_fun (yukawa_time_insertions scalar scalar (1 : Mother) (by rfl)) v

theorem yukawa_time_nonzero : yukawaHamiltonian exteriorBreakingScalar ≠ 0 := by
  intro zero
  apply diracDualRightChiralYukawaAction_nonzero
  apply LinearMap.ext
  intro v
  have equation := yukawa_time_coefficient exteriorBreakingScalar v
  rw [zero, LinearMap.zero_apply, smul_zero, map_zero, smul_zero, zero_add] at equation
  exact equation

end
end SaturationMonoid.PhysicsCore.LowEnergy.FullQuantum
