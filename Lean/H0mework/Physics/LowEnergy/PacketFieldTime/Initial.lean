import H0mework.Physics.LowEnergy.PacketFieldTime.Time
import Mathlib.Analysis.Calculus.Deriv.Slope

/-! The strong initial slope is generated by the same original current at
time zero. It is constructed as a PacketField.spectrum independently of the derivative. -/
set_option autoImplicit false
open MeasureTheory Filter Topology
namespace SaturationMonoid.PhysicsCore.LowEnergy.PacketFieldTime
open FullQuantum FullSpace PacketPairResponse PacketField PacketFourier
noncomputable section
variable {ι : Type*} [Fintype ι]
attribute [local irreducible] poleLift phasePacket

def sourceSeed (circleY circleZ : CircleData ι) (numerator : ι → List PoleTerm)
    (energy damping : ℝ) (positive : 0<damping) (row : ι) : FieldSpace FullMatterL2 :=
  -(∑ sign : Bool, poleLift circleY circleZ numerator sign row
    (compactSection (bandCurrent energy damping positive true) (bandCurrent_continuous energy damping positive true) 0))

theorem sourceSeed_ae (circleY circleZ : CircleData ι) (numerator : ι → List PoleTerm)
    (energy damping : ℝ) (positive : 0<damping) (row : ι) :
    sourceSeed circleY circleZ numerator energy damping positive row=ᵐ[volume]
      physicalBand (fun point => -(∑ sign : Bool, poleColumn circleY circleZ numerator sign point row •
        phasePacket energy damping positive (bandShift point) 0)) :=
  polePair_ae circleY circleZ numerator row (fun _ =>
    compactSection (bandCurrent energy damping positive true) (bandCurrent_continuous energy damping positive true) 0)

theorem spectralVelocity_initial (circleY circleZ : CircleData ι) (numerator : ι → List PoleTerm)
    (energy damping : ℝ) (positive : 0<damping) (row : ι) :
    spectralVelocity circleY circleZ numerator energy damping positive 0 row=
      sourceSeed circleY circleZ numerator energy damping positive row := by
  have speed (sign : Bool) : branchSpeed energy damping positive sign 0=
      compactSection (bandCurrent energy damping positive true) (bandCurrent_continuous energy damping positive true) 0 := by
    apply ContinuousMap.ext
    intro point
    exact branchSpeed_initial energy damping positive sign point
  unfold spectralVelocity sourceSeed
  simp_rw [speed]

theorem spectrum_initial (circleY circleZ : CircleData ι) (numerator : ι → List PoleTerm)
    (energy damping : ℝ) (positive : 0<damping) (row : ι) :
    PacketField.spectrum circleY circleZ numerator energy damping positive 0 row=0 := by
  rw [spectrum_as_lift]
  simp only [branchCurve_initial,map_zero,Finset.sum_const_zero,neg_zero]

theorem reconstructedField_initial (circleY circleZ : CircleData ι) (numerator : ι → List PoleTerm)
    (energy damping : ℝ) (positive : 0<damping) (row : ι) :
    reconstructedField circleY circleZ numerator energy damping positive 0 row=0 := by
  rw [reconstructedField,spectrum_initial,map_zero]

theorem spectrum_initial_derivative (circleY circleZ : CircleData ι) (numerator : ι → List PoleTerm)
    (energy damping : ℝ) (positive : 0<damping) (row : ι) :
    HasDerivAt (fun t => PacketField.spectrum circleY circleZ numerator energy damping positive t row)
      (sourceSeed circleY circleZ numerator energy damping positive row) 0 := by
  simpa only [spectralVelocity_initial] using
    spectrum_derivative circleY circleZ numerator energy damping positive 0 row

theorem reconstructedField_initial_derivative (circleY circleZ : CircleData ι) (numerator : ι → List PoleTerm)
    (energy damping : ℝ) (positive : 0<damping) (row : ι) :
    HasDerivAt (fun t => reconstructedField circleY circleZ numerator energy damping positive t row)
      (spatialFourier (sourceSeed circleY circleZ numerator energy damping positive row)) 0 := by
  simpa only [reconstructedVelocity,spectralVelocity_initial] using
    reconstructedField_derivative circleY circleZ numerator energy damping positive 0 row

theorem spectrum_strong_initial_slope (circleY circleZ : CircleData ι) (numerator : ι → List PoleTerm)
    (energy damping : ℝ) (positive : 0<damping) (row : ι) :
    Tendsto (fun t : ℝ => t⁻¹ • PacketField.spectrum circleY circleZ numerator energy damping positive t row)
      (𝓝[≠] 0) (𝓝 (sourceSeed circleY circleZ numerator energy damping positive row)) := by
  have generated := (spectrum_initial_derivative circleY circleZ numerator energy damping positive row).tendsto_slope_zero
  simpa only [zero_add,spectrum_initial,sub_zero] using generated

theorem reconstructedField_strong_initial_slope (circleY circleZ : CircleData ι) (numerator : ι → List PoleTerm)
    (energy damping : ℝ) (positive : 0<damping) (row : ι) :
    Tendsto (fun t : ℝ => t⁻¹ • reconstructedField circleY circleZ numerator energy damping positive t row)
      (𝓝[≠] 0) (𝓝 (spatialFourier (sourceSeed circleY circleZ numerator energy damping positive row))) := by
  have generated := (reconstructedField_initial_derivative circleY circleZ numerator energy damping positive row).tendsto_slope_zero
  simpa only [zero_add,reconstructedField_initial,sub_zero] using generated

end
end SaturationMonoid.PhysicsCore.LowEnergy.PacketFieldTime
