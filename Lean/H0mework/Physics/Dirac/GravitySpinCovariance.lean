import H0mework.Physics.Exterior.MotherAction
import H0mework.Physics.Dirac.ResidualLinearPlebanskiFiberwiseSpinCovariance

/-!
# Active form-native gravity and gauge Spin covariance

This module supplies the first action-facing covariance seam for the active
form-native Stage-9 action.  The auxiliary bivector, simplicity multiplier,
and coframe follow the existing representations generated by the actual
`SL(2,ℂ)` Spin cover.  The historical holonomic curvature coordinate is
different: it is a lowered internal-pair readout, so its transformation is
the forced conjugate

`N⁻¹ ∘ ρ(g) ∘ N`,

where `N` is the unique variance normalization already used by the active BF
term.  Since `N` is involutive, the implementation writes the same map on
both sides.  No covariance certificate, source slot, action response, or
stationarity receipt is accepted as a premise.

Only formulation-neutral representation facts are reused from the earlier
fiberwise covariance module; none of its historical action-density receipts
is consumed.  The result here covers the complete active gravity and gauge
summands, plus the volume factor.  Scalar and Dirac--Yukawa covariance and
the inhomogeneous primitive local-Spin connection action remain separate
downstream gates, so this file does not claim full unified local covariance.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineFormNativeGravitySpinCovariance

open ProofFreeRicherAnholonomicSource
open EmpiricalReferenceScaleCouplingBoundary
open StageNineBlockwiseConstitutive
open StageNineCoframeSpinRepresentation
open StageNineFormNativeMotherAction
open StageNineGlobalBundle
open StageNineGlobalIntegratedAction
open StageNineHolonomicGravityCurvatureVarianceNormalization
open StageNinePhysicalBivectorSpinRepresentation
open StageNineResidualLinearPlebanskiFiberwiseSpinCovariance
open StageNineTopologicalFourFormPairing
open StageNineTopologicalGravityCurvatureVariancePairing

noncomputable section

set_option autoImplicit false

/-! ## Formulation-neutral topological pairing -/

/-- The metric-free gravity wedge is invariant under the actual induced
Spin action on both internal bivector legs.  The proof uses the previously
derived finite representation identities, not an invariance premise. -/
theorem gravityTopologicalWedgeCoefficient_spin_invariant
    (groupElement : SpinPlus13) (first second : PhysicalBivector) :
    gravityTopologicalWedgeCoefficient
        (spinLorentzPhysicalBivectorRepresentation groupElement first)
        (spinLorentzPhysicalBivectorRepresentation groupElement second) =
      gravityTopologicalWedgeCoefficient first second := by
  have hodgeCommute :
      gravitySpacetimeHodge (1 : LorentzianCoframe)
          (spinLorentzPhysicalBivectorRepresentation groupElement second) =
        spinLorentzPhysicalBivectorRepresentation groupElement
          (gravitySpacetimeHodge (1 : LorentzianCoframe) second) := by
    unfold gravitySpacetimeHodge
    exact physicalBivector_spacetimeLinearMap_spin_commute groupElement
      (coframeGaugeSpacetimeHodgeLinear (1 : LorentzianCoframe)) second
  have pairingInvariant := gravityCoframePairing_internal_spin_invariant
    groupElement (1 : LorentzianCoframe) first
      (gravitySpacetimeHodge (1 : LorentzianCoframe) second)
  have transformedSeam :=
    gravityCoframePairing_one_spacetimeHodge_eq_neg_topological
      (spinLorentzPhysicalBivectorRepresentation groupElement first)
      (spinLorentzPhysicalBivectorRepresentation groupElement second)
  have originalSeam :=
    gravityCoframePairing_one_spacetimeHodge_eq_neg_topological first second
  rw [hodgeCommute, pairingInvariant] at transformedSeam
  linarith

/-! ## The forced lowered-curvature action -/

/-- Spin transport on the historical lowered curvature coordinate.  This is
not the naive contravariant bivector action: variance is raised before and
lowered after the actual exterior-square representation. -/
def spinLorentzLoweredPhysicalBivector
    (groupElement : SpinPlus13) (lowered : PhysicalBivector) :
    PhysicalBivector :=
  gravityInternalPairVarianceNormalization
    (spinLorentzPhysicalBivectorRepresentation groupElement
      (gravityInternalPairVarianceNormalization lowered))

/-- Raising the transformed lowered curvature gives exactly the ordinary
contravariant Spin transport of the raised original curvature. -/
theorem gravityInternalPairVarianceNormalization_spinLowered
    (groupElement : SpinPlus13) (lowered : PhysicalBivector) :
    gravityInternalPairVarianceNormalization
        (spinLorentzLoweredPhysicalBivector groupElement lowered) =
      spinLorentzPhysicalBivectorRepresentation groupElement
        (gravityInternalPairVarianceNormalization lowered) := by
  unfold spinLorentzLoweredPhysicalBivector
  exact gravityInternalPairVarianceNormalization_involutive _

theorem spinLorentzLoweredPhysicalBivector_injective
    (groupElement : SpinPlus13) :
    Function.Injective (spinLorentzLoweredPhysicalBivector groupElement) := by
  intro first second equality
  apply gravityInternalPairVarianceNormalization_injective
  apply (spinLorentzPhysicalBivectorRepresentation groupElement).injective
  apply gravityInternalPairVarianceNormalization_injective
  exact equality

@[simp] theorem spinLorentzLoweredPhysicalBivector_eq_zero_iff
    (groupElement : SpinPlus13) (lowered : PhysicalBivector) :
    spinLorentzLoweredPhysicalBivector groupElement lowered = 0 ↔
      lowered = 0 := by
  constructor
  · intro transformedZero
    apply spinLorentzLoweredPhysicalBivector_injective groupElement
    simpa [spinLorentzLoweredPhysicalBivector] using transformedZero
  · rintro rfl
    simp [spinLorentzLoweredPhysicalBivector]

/-- The active BF variance seam is invariant only after the lowered
curvature follows its conjugated action. -/
theorem gravityTopologicalBFCoefficient_spin_invariant
    (groupElement : SpinPlus13)
    (auxiliary loweredCurvature : PhysicalBivector) :
    gravityTopologicalBFCoefficient
        (spinLorentzPhysicalBivectorRepresentation groupElement auxiliary)
        (spinLorentzLoweredPhysicalBivector groupElement loweredCurvature) =
      gravityTopologicalBFCoefficient auxiliary loweredCurvature := by
  unfold gravityTopologicalBFCoefficient
  rw [gravityInternalPairVarianceNormalization_spinLowered]
  exact gravityTopologicalWedgeCoefficient_spin_invariant
    groupElement auxiliary
      (gravityInternalPairVarianceNormalization loweredCurvature)

/-! ## Active point-field transport -/

/-- Tensorial Spin transport of the active gravity slots.  Gauge, scalar,
and matter coordinates remain unchanged at this checkpoint. -/
def transformFormNativeGravityPointField
    (groupElement : SpinPlus13) (field : StageNineContinuumPointField) :
    StageNineContinuumPointField :=
  { field with
      coframe := spinLorentzCoframeRepresentation groupElement field.coframe
      gravityCurvature :=
        spinLorentzLoweredPhysicalBivector groupElement field.gravityCurvature
      gravityAuxiliary :=
        spinLorentzPhysicalBivectorRepresentation groupElement
          field.gravityAuxiliary
      gravitySimplicityMultiplier :=
        spinLorentzPhysicalBivectorRepresentation groupElement
          field.gravitySimplicityMultiplier }

@[simp] theorem transformFormNativeGravityPointField_coframe
    (groupElement : SpinPlus13) (field : StageNineContinuumPointField) :
    (transformFormNativeGravityPointField groupElement field).coframe =
      spinLorentzCoframeRepresentation groupElement field.coframe :=
  rfl

theorem generatedGravitySimplicityResidual_formNative_spin_covariant
    (groupElement : SpinPlus13) (field : StageNineContinuumPointField) :
    generatedGravitySimplicityResidual
        (transformFormNativeGravityPointField groupElement field) =
      spinLorentzPhysicalBivectorRepresentation groupElement
        (generatedGravitySimplicityResidual field) := by
  unfold generatedGravitySimplicityResidual
  change
    spinLorentzPhysicalBivectorRepresentation groupElement
          field.gravityAuxiliary -
        physicalIIPlusBivector
          (spinLorentzCoframeRepresentation groupElement field.coframe) =
      spinLorentzPhysicalBivectorRepresentation groupElement
        (field.gravityAuxiliary - physicalIIPlusBivector field.coframe)
  rw [physicalIIPlusBivector_spin_covariant, map_sub]

theorem generatedGravitySimplicityResidual_formNative_spin_eq_zero_iff
    (groupElement : SpinPlus13) (field : StageNineContinuumPointField) :
    generatedGravitySimplicityResidual
          (transformFormNativeGravityPointField groupElement field) = 0 ↔
      generatedGravitySimplicityResidual field = 0 := by
  rw [generatedGravitySimplicityResidual_formNative_spin_covariant]
  constructor
  · intro transformedZero
    apply (spinLorentzPhysicalBivectorRepresentation groupElement).injective
    simpa using transformedZero
  · rintro residualZero
    rw [residualZero]
    exact map_zero _

theorem generatedFormNativeGravityConstraintDensity_spin_invariant
    (groupElement : SpinPlus13) (field : StageNineContinuumPointField) :
    generatedFormNativeGravityConstraintDensity
        (transformFormNativeGravityPointField groupElement field) =
      generatedFormNativeGravityConstraintDensity field := by
  unfold generatedFormNativeGravityConstraintDensity
  change
    gravityTopologicalWedgeCoefficient
        (spinLorentzPhysicalBivectorRepresentation groupElement
          field.gravitySimplicityMultiplier)
        (generatedGravitySimplicityResidual
          (transformFormNativeGravityPointField groupElement field)) =
      gravityTopologicalWedgeCoefficient field.gravitySimplicityMultiplier
        (generatedGravitySimplicityResidual field)
  rw [generatedGravitySimplicityResidual_formNative_spin_covariant]
  exact gravityTopologicalWedgeCoefficient_spin_invariant groupElement
    field.gravitySimplicityMultiplier
      (generatedGravitySimplicityResidual field)

theorem generatedFormNativeGravityBFDensity_spin_invariant
    (groupElement : SpinPlus13) (field : StageNineContinuumPointField) :
    generatedFormNativeGravityBFDensity
        (transformFormNativeGravityPointField groupElement field) =
      generatedFormNativeGravityBFDensity field := by
  unfold generatedFormNativeGravityBFDensity
  change
    gravityTopologicalBFCoefficient
          (spinLorentzPhysicalBivectorRepresentation groupElement
            field.gravityAuxiliary)
          (spinLorentzLoweredPhysicalBivector groupElement
            field.gravityCurvature) -
        (1 / 2 : ℝ) *
          gravityTopologicalWedgeCoefficient
            (spinLorentzPhysicalBivectorRepresentation groupElement
              field.gravityAuxiliary)
            (gravityInternalDualEquiv
              (spinLorentzPhysicalBivectorRepresentation groupElement
                field.gravityAuxiliary)) =
      gravityTopologicalBFCoefficient field.gravityAuxiliary
          field.gravityCurvature -
        (1 / 2 : ℝ) *
          gravityTopologicalWedgeCoefficient field.gravityAuxiliary
            (gravityInternalDualEquiv field.gravityAuxiliary)
  rw [gravityTopologicalBFCoefficient_spin_invariant,
    gravityInternalDualEquiv_spin_commute,
    gravityTopologicalWedgeCoefficient_spin_invariant]

/-! ## Coframe-dependent gauge and volume summands -/

theorem gaugeConstitutiveOperatorAtBoundary_spin_invariant
    (groupElement : SpinPlus13) (coframe : LorentzianCoframe)
    (couplingSquared : ℝˣ) (nondegenerate : Matrix.det coframe ≠ 0) :
    gaugeConstitutiveOperatorAtBoundary
        (spinLorentzCoframeRepresentation groupElement coframe)
        couplingSquared =
      gaugeConstitutiveOperatorAtBoundary coframe couplingSquared := by
  unfold gaugeConstitutiveOperatorAtBoundary
  rw [coframeGaugeSpacetimeHodgeLinear_spin_invariant
    groupElement coframe nondegenerate]

theorem generatedFormNativeGaugeDensityAtBoundary_spin_invariant
    (groupElement : SpinPlus13)
    (boundary : EmpiricalReferenceScaleCouplings)
    (field : StageNineContinuumPointField)
    (nondegenerate : Matrix.det field.coframe ≠ 0) :
    generatedFormNativeGaugeDensityAtBoundary boundary
        (transformFormNativeGravityPointField groupElement field) =
      generatedFormNativeGaugeDensityAtBoundary boundary field := by
  unfold generatedFormNativeGaugeDensityAtBoundary
  simp only [transformFormNativeGravityPointField]
  rw [gaugeConstitutiveOperatorAtBoundary_spin_invariant
      groupElement field.coframe boundary.strongCouplingSquared
        nondegenerate,
    gaugeConstitutiveOperatorAtBoundary_spin_invariant
      groupElement field.coframe boundary.weakCouplingSquared
        nondegenerate,
    gaugeConstitutiveOperatorAtBoundary_spin_invariant
      groupElement field.coframe boundary.hyperchargeCouplingSquared
        nondegenerate]

theorem generatedVolumeDensity_formNative_spin_invariant
    (groupElement : SpinPlus13) (field : StageNineContinuumPointField) :
    generatedVolumeDensity
        (transformFormNativeGravityPointField groupElement field) =
      generatedVolumeDensity field := by
  unfold generatedVolumeDensity
  rw [transformFormNativeGravityPointField_coframe, spinLorentzCoframe_det]

/-- Positive checkpoint for every already closed active gravity/gauge
summand.  It deliberately stops before scalar, matter, or primitive local
connection covariance. -/
theorem generatedFormNativeGravityGaugeSpinCovariance
    (groupElement : SpinPlus13)
    (boundary : EmpiricalReferenceScaleCouplings)
    (field : StageNineContinuumPointField)
    (nondegenerate : Matrix.det field.coframe ≠ 0) :
    generatedFormNativeGravityBFDensity
          (transformFormNativeGravityPointField groupElement field) =
        generatedFormNativeGravityBFDensity field ∧
      generatedFormNativeGravityConstraintDensity
          (transformFormNativeGravityPointField groupElement field) =
        generatedFormNativeGravityConstraintDensity field ∧
      generatedFormNativeGaugeDensityAtBoundary boundary
          (transformFormNativeGravityPointField groupElement field) =
        generatedFormNativeGaugeDensityAtBoundary boundary field ∧
      generatedVolumeDensity
          (transformFormNativeGravityPointField groupElement field) =
        generatedVolumeDensity field := by
  exact ⟨generatedFormNativeGravityBFDensity_spin_invariant
      groupElement field,
    generatedFormNativeGravityConstraintDensity_spin_invariant
      groupElement field,
    generatedFormNativeGaugeDensityAtBoundary_spin_invariant
      groupElement boundary field nondegenerate,
    generatedVolumeDensity_formNative_spin_invariant groupElement field⟩

end

end
  SaturationMonoid.PhysicsCore.StageNineFormNativeGravitySpinCovariance
