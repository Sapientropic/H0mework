import H0mework.Physics.Lorentz.LorentzConnectionLocalVariation
import H0mework.Physics.Lorentz.TopologicalLorentzThreeFormDualInverse

/-!
# Form-native matter spin three-form

The authoritative matter part of the form-native Lorentz first variation
generates a pointwise continuous linear functional on the lowered Lorentz
bivector one-form carrier.  This module keeps the live coframe volume in that
functional and applies the canonical W13 inverse to obtain its unique
contravariant three-form representative.

The represented coefficient enters the action with a plus sign.  It is
therefore an action-signed spin contribution `S_spin`; a later physical
current notation `J_spin := -S_spin` may be introduced only after the gravity
integration-by-parts seam has fixed the complete equation.  No source slot,
normalization, branch choice, old momentum, weak equation, stationarity, or
torsion solution is consumed here.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineFormNativeMatterSpinThreeForm

open ProofFreeRicherAnholonomicSource
open PointwiseDiracSpinConnectionLift
open StageNineEnrichedProofFreeSource
open StageNineFormNativeLorentzConnectionLocalVariation
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineLorentzConnectionVariation
open StageNineMatterCovariantDerivativeAffine
open StageNineResidualLinearPlebanskiTorsionReduction
open StageNineTopologicalGravityCurvatureVariancePairing
open StageNineTopologicalLorentzThreeFormDuality
open StageNineTopologicalLorentzThreeFormDualInverse
open DiracExteriorMatterAction

noncomputable section

set_option autoImplicit false

/-! ## Pointwise action-generated Lorentz dual -/

/-- Matter-covariant-derivative response generated by one lowered Lorentz
connection direction at a fixed continuum point field. -/
def pointwiseMatterLorentzConnectionVariation
    (field : StageNineContinuumPointField)
    (direction : LorentzBivectorOneForm) :
    LorentzianIndex -> DiracExteriorMatterCarrier :=
  fun formDirection =>
    diracMatrixMatterAction
      (diracSpinConnectionLift
        (lorentzSkewConnectionOfBivectorOneForm direction) formDirection)
      field.matter

theorem pointwiseMatterLorentzConnectionVariation_add
    (field : StageNineContinuumPointField)
    (first second : LorentzBivectorOneForm) :
    pointwiseMatterLorentzConnectionVariation field (first + second) =
      pointwiseMatterLorentzConnectionVariation field first +
        pointwiseMatterLorentzConnectionVariation field second := by
  funext formDirection
  unfold pointwiseMatterLorentzConnectionVariation
  rw [lorentzSkewConnectionOfBivectorOneForm_add,
    diracSpinConnectionLift_add,
    diracMatrixMatterAction_add_matrix_local]
  rfl

theorem pointwiseMatterLorentzConnectionVariation_smul
    (field : StageNineContinuumPointField) (parameter : ℝ)
    (direction : LorentzBivectorOneForm) :
    pointwiseMatterLorentzConnectionVariation field
        (parameter • direction) =
      parameter •
        pointwiseMatterLorentzConnectionVariation field direction := by
  funext formDirection
  unfold pointwiseMatterLorentzConnectionVariation
  rw [lorentzSkewConnectionOfBivectorOneForm_smul,
    diracSpinConnectionLift_real_smul,
    diracMatrixMatterAction_real_smul_matrix_local]
  rfl

/-- The pointwise matter coefficient exactly as it occurs in the form-native
action.  In particular the live volume is retained and is not divided out. -/
def formNativeLorentzMatterFirstCoefficient
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (direction : LorentzBivectorOneForm) : ℝ :=
  generatedVolumeDensity field *
    matterCovariantDerivativeFirstVariationDensity source chart point field
      (pointwiseMatterLorentzConnectionVariation field direction)

theorem formNativeLorentzMatterFirstCoefficient_add
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (first second : LorentzBivectorOneForm) :
    formNativeLorentzMatterFirstCoefficient source chart point field
        (first + second) =
      formNativeLorentzMatterFirstCoefficient source chart point field first +
        formNativeLorentzMatterFirstCoefficient source chart point field
          second := by
  unfold formNativeLorentzMatterFirstCoefficient
  rw [pointwiseMatterLorentzConnectionVariation_add,
    matterCovariantDerivativeFirstVariationDensity_add]
  ring

theorem formNativeLorentzMatterFirstCoefficient_smul
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (parameter : ℝ) (direction : LorentzBivectorOneForm) :
    formNativeLorentzMatterFirstCoefficient source chart point field
        (parameter • direction) =
      parameter *
        formNativeLorentzMatterFirstCoefficient source chart point field
          direction := by
  unfold formNativeLorentzMatterFirstCoefficient
  rw [pointwiseMatterLorentzConnectionVariation_smul,
    matterCovariantDerivativeFirstVariationDensity_real_smul]
  ring

def formNativeLorentzMatterFirstLinearMap
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField) :
    LorentzBivectorOneForm →ₗ[ℝ] ℝ where
  toFun := formNativeLorentzMatterFirstCoefficient source chart point field
  map_add' :=
    formNativeLorentzMatterFirstCoefficient_add source chart point field
  map_smul' := by
    intro parameter direction
    simpa only [RingHom.id_apply, smul_eq_mul] using
      formNativeLorentzMatterFirstCoefficient_smul source chart point field
        parameter direction

/-- Continuity follows from the finite 24-dimensional direction carrier; no
analytic or equation certificate is supplied. -/
def formNativeLorentzMatterFirstContinuousLinearMap
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField) :
    LorentzBivectorOneForm →L[ℝ] ℝ where
  toLinearMap :=
    formNativeLorentzMatterFirstLinearMap source chart point field
  cont :=
    (formNativeLorentzMatterFirstLinearMap source chart point field)
      |>.continuous_of_finiteDimensional

@[simp] theorem formNativeLorentzMatterFirstContinuousLinearMap_apply
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (direction : LorentzBivectorOneForm) :
    formNativeLorentzMatterFirstContinuousLinearMap source chart point field
        direction =
      formNativeLorentzMatterFirstCoefficient source chart point field
        direction :=
  rfl

/-! ## Provenance seams -/

theorem pointwiseMatterLorentzConnectionVariation_actual
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint -> LorentzBivectorOneForm) (point : BasePoint) :
    pointwiseMatterLorentzConnectionVariation
        (toContinuumPointField configuration point) (variation point) =
      holonomicMatterLorentzConnectionVariation configuration variation
        point := by
  funext formDirection
  rfl

/-- The local form-native first coefficient reads this exact pointwise matter
dual; this is an action-provenance identity, not an independent equation. -/
theorem formNativeLorentzConnectionFirstVariationDensity_matterDirection
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (curvatureVariation : PhysicalBivector)
    (direction : LorentzBivectorOneForm) :
    formNativeLorentzConnectionFirstVariationDensity source chart point field
        curvatureVariation
        (pointwiseMatterLorentzConnectionVariation field direction) =
      gravityTopologicalBFCoefficient field.gravityAuxiliary
          curvatureVariation +
        formNativeLorentzMatterFirstCoefficient source chart point field
          direction :=
  rfl

theorem holonomicFormNativeLorentzConnectionFirstVariationDensity_eq
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint -> LorentzBivectorOneForm) (point : BasePoint) :
    holonomicFormNativeLorentzConnectionFirstVariationDensity source chart
        configuration variation point =
      gravityTopologicalBFCoefficient
          (configuration.gravityAuxiliary point)
          (lorentzConnectionLinearCurvatureVariation configuration variation
            point) +
        formNativeLorentzMatterFirstCoefficient source chart point
          (toContinuumPointField configuration point) (variation point) :=
  rfl

/-! ## Unique W13 representative -/

/-- Action-signed spin contribution generated by the pointwise matter dual. -/
def formNativeMatterSpinThreeForm
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField) :
    PhysicalBivectorThreeForm :=
  lorentzOneFormContinuousDualThreeForm
    (formNativeLorentzMatterFirstContinuousLinearMap source chart point field)

@[simp] theorem formNativeMatterSpinThreeForm_coordinate
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (direction : LorentzianIndex) (internalPair : Fin 6) :
    formNativeMatterSpinThreeForm source chart point field internalPair
        (missingTripleOfOneForm direction) =
      oneWedgeThreeSign direction *
        formNativeLorentzMatterFirstCoefficient source chart point field
          (loweredLorentzBivectorOneFormCoordinate direction internalPair) := by
  simp [formNativeMatterSpinThreeForm,
    lorentzOneFormContinuousDualThreeForm]

/-- W13 evaluates the generated three-form to the exact matter action
coefficient on every lowered one-form direction. -/
theorem formNativeMatterSpinThreeForm_evaluation
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (direction : LorentzBivectorOneForm) :
    lorentzThreeFormWedgeContinuousDual
        (formNativeMatterSpinThreeForm source chart point field) direction =
      formNativeLorentzMatterFirstCoefficient source chart point field
        direction := by
  simp [formNativeMatterSpinThreeForm]

theorem formNativeMatterSpinThreeForm_eq_zero_iff
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField) :
    formNativeMatterSpinThreeForm source chart point field = 0 ↔
      formNativeLorentzMatterFirstContinuousLinearMap source chart point
        field = 0 := by
  exact lorentzOneFormContinuousDualThreeForm_eq_zero_iff _

/-- No matter response can disappear in the W13 carrier, and no witness is
chosen: the unique three-form vanishes exactly when every action coefficient
does. -/
theorem formNativeMatterSpinThreeForm_eq_zero_iff_all
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField) :
    formNativeMatterSpinThreeForm source chart point field = 0 ↔
      ∀ direction : LorentzBivectorOneForm,
        formNativeLorentzMatterFirstCoefficient source chart point field
          direction = 0 := by
  rw [formNativeMatterSpinThreeForm_eq_zero_iff]
  constructor
  · intro dualZero direction
    have evaluated := DFunLike.congr_fun dualZero direction
    simpa using evaluated
  · intro allZero
    apply ContinuousLinearMap.ext
    intro direction
    simp [allZero direction]

end

end
  SaturationMonoid.PhysicsCore.StageNineFormNativeMatterSpinThreeForm
