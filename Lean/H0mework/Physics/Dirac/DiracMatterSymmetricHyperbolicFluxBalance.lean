import H0mework.Physics.Dirac.DiracMatterHermitianEnergyIdentity

namespace SaturationMonoid.PhysicsCore.StageNineDiracMatterSymmetricHyperbolicFluxBalance

open DiracCliffordRepresentation
open DiracExteriorMatterAction
open ProofFreeRicherAnholonomicSource
open StageNineDiracMatterHermitianEnergy
open StageNineDiracMatterHermitianEnergyIdentity
open StageNineHolonomicField
open SU7ExteriorMatterRepresentation
open scoped ComplexOrder Matrix

noncomputable section

def diracMatterCoordinateLine
    (point : BasePoint)
    (direction : LorentzianIndex)
    (parameter : ℝ) : BasePoint :=
  point + parameter • coordinateDirection direction

@[simp] theorem diracMatterCoordinateLine_zero
    (point : BasePoint)
    (direction : LorentzianIndex) :
    diracMatterCoordinateLine point direction 0 = point := by
  simp [diracMatterCoordinateLine]

theorem diracMatterCoordinateLine_hasDerivAt
    (point : BasePoint)
    (direction : LorentzianIndex) :
    HasDerivAt (diracMatterCoordinateLine point direction)
      (coordinateDirection direction) 0 := by
  let directionLinear : ℝ →L[ℝ] BasePoint :=
    (1 : ℝ →L[ℝ] ℝ).smulRight (coordinateDirection direction)
  have lineDerivative : HasDerivAt
      (fun parameter : ℝ => point + directionLinear parameter)
      (coordinateDirection direction) 0 := by
    have actual := (hasDerivAt_const (x := (0 : ℝ)) point).add
      directionLinear.hasFDerivAt.hasDerivAt
    exact actual.congr_deriv (by simp [directionLinear])
  have lineEq :
      diracMatterCoordinateLine point direction =
        fun parameter : ℝ => point + directionLinear parameter := by
    funext parameter
    apply PiLp.ext
    intro coordinate
    rfl
  rw [lineEq]
  exact lineDerivative

def diracMatterEnergyFlux
    (matrix : DiracMatrix)
    (field : DiracExteriorMatterCarrier) : ℝ :=
  diracExteriorMatterCoordinateEnergy matrix field

/-- Bilinear Hermitian flux used by Green transport between a fixed test and
an independently varying trial field. -/
def diracMatterBilinearFlux
    (matrix : DiracMatrix)
    (first second : DiracExteriorMatterCarrier) : ℝ :=
  Complex.re
    (diracExteriorMatterCoordinatePairing first
      (diracMatrixMatterAction matrix second))

/-- Coordinate product rule for the bilinear Hermitian Dirac flux.  The
coefficient derivative is supplied as its action on the second field, exactly
as it is generated by the fixed action profile. -/
theorem diracMatterBilinearFlux_coordinate_hasDerivAt
    (coefficient : LorentzianIndex → BasePoint → DiracMatrix)
    (first second : BasePoint → DiracExteriorMatterCarrier)
    (point : BasePoint)
    (direction : LorentzianIndex)
    (firstDerivative secondDerivative coefficientDerivative :
      DiracExteriorMatterCarrier)
    (hermitian : Matrix.IsHermitian (coefficient direction point))
    (firstCoordinateDerivative :
      ∀ (internal : InternalMatterCoordinateIndex)
        (spin : DiracSpinorIndex),
        HasDerivAt
          (fun parameter ↦
            internalMatterCoordinate internal
              (first (diracMatterCoordinateLine point direction parameter)
                spin))
          (internalMatterCoordinate internal (firstDerivative spin))
          0)
    (actedSecondCoordinateDerivative :
      ∀ (internal : InternalMatterCoordinateIndex)
        (spin : DiracSpinorIndex),
        HasDerivAt
          (fun parameter ↦
            internalMatterCoordinate internal
              (diracMatrixMatterAction
                (coefficient direction
                  (diracMatterCoordinateLine point direction parameter))
                (second
                  (diracMatterCoordinateLine point direction parameter))
                spin))
          (internalMatterCoordinate internal
            ((diracMatrixMatterAction (coefficient direction point)
                secondDerivative + coefficientDerivative) spin))
          0) :
    HasDerivAt
      (fun parameter ↦
        let candidate :=
          diracMatterCoordinateLine point direction parameter
        diracMatterBilinearFlux
          (coefficient direction candidate) (first candidate)
          (second candidate))
      (diracMatterBilinearFlux (coefficient direction point)
          (second point) firstDerivative +
        diracMatterBilinearFlux (coefficient direction point)
          (first point) secondDerivative +
        Complex.re
          (diracExteriorMatterCoordinatePairing
            (first point) coefficientDerivative))
      0 := by
  let actedSecond : ℝ → DiracExteriorMatterCarrier :=
    fun parameter ↦
      let candidate := diracMatterCoordinateLine point direction parameter
      diracMatrixMatterAction (coefficient direction candidate)
        (second candidate)
  have derivative :=
    diracExteriorMatterCoordinatePairing_re_hasDerivAt
      (fun parameter ↦
        first (diracMatterCoordinateLine point direction parameter))
      actedSecond firstDerivative
      (diracMatrixMatterAction (coefficient direction point)
          secondDerivative + coefficientDerivative)
      0 firstCoordinateDerivative actedSecondCoordinateDerivative
  have actedAt :
      actedSecond 0 =
        diracMatrixMatterAction (coefficient direction point) (second point) := by
    simp [actedSecond]
  have symmetricTerm :
      Complex.re
          (diracExteriorMatterCoordinatePairing firstDerivative
            (diracMatrixMatterAction (coefficient direction point)
              (second point))) =
        diracMatterBilinearFlux (coefficient direction point)
          (second point) firstDerivative := by
    have equality := congrArg Complex.re
      (diracExteriorMatterCoordinatePairing_action_star
        (coefficient direction point) hermitian firstDerivative (second point))
    simpa [diracMatterBilinearFlux] using equality
  have splitTerm :
      Complex.re
          (diracExteriorMatterCoordinatePairing (first point)
            (diracMatrixMatterAction (coefficient direction point)
                secondDerivative + coefficientDerivative)) =
        diracMatterBilinearFlux (coefficient direction point)
            (first point) secondDerivative +
          Complex.re
            (diracExteriorMatterCoordinatePairing
              (first point) coefficientDerivative) := by
    change
      Complex.re
          ((diracExteriorMatterCoordinatePairingRight (first point))
            ((diracMatrixMatterAction (coefficient direction point))
                secondDerivative + coefficientDerivative)) = _
    rw [map_add, Complex.add_re]
    rfl
  simpa [diracMatterBilinearFlux, actedSecond, actedAt, symmetricTerm,
    splitTerm, add_assoc] using derivative

/-- The coordinate derivative of the Hermitian Dirac energy flux. -/
theorem diracMatterEnergyFlux_coordinate_hasDerivAt
    (coefficient : LorentzianIndex → BasePoint → DiracMatrix)
    (field : BasePoint → DiracExteriorMatterCarrier)
    (point : BasePoint)
    (direction : LorentzianIndex)
    (fieldDerivative coefficientDerivative : DiracExteriorMatterCarrier)
    (hermitian : Matrix.IsHermitian (coefficient direction point))
    (fieldCoordinateDerivative :
      ∀ (internal : InternalMatterCoordinateIndex)
        (spin : DiracSpinorIndex),
        HasDerivAt
          (fun parameter =>
            internalMatterCoordinate internal
              (field (diracMatterCoordinateLine point direction parameter)
                spin))
          (internalMatterCoordinate internal (fieldDerivative spin))
          0)
    (actedFieldCoordinateDerivative :
      ∀ (internal : InternalMatterCoordinateIndex)
        (spin : DiracSpinorIndex),
        HasDerivAt
          (fun parameter =>
            internalMatterCoordinate internal
              (diracMatrixMatterAction
                (coefficient direction
                  (diracMatterCoordinateLine point direction parameter))
                (field
                  (diracMatterCoordinateLine point direction parameter))
                spin))
          (internalMatterCoordinate internal
            ((diracMatrixMatterAction (coefficient direction point)
              fieldDerivative + coefficientDerivative) spin))
          0) :
    HasDerivAt
      (fun parameter =>
        diracMatterEnergyFlux
          (coefficient direction
            (diracMatterCoordinateLine point direction parameter))
          (field (diracMatterCoordinateLine point direction parameter)))
      (2 * Complex.re
          (diracExteriorMatterCoordinatePairing (field point)
            (diracMatrixMatterAction
              (coefficient direction point) fieldDerivative)) +
        Complex.re
          (diracExteriorMatterCoordinatePairing
            (field point) coefficientDerivative))
      0 := by
  have identity :=
    diracExteriorMatterHermitianVariableEnergy_hasDerivAt
      (coefficient direction point) hermitian
      (fun parameter =>
        field (diracMatterCoordinateLine point direction parameter))
      (fun parameter =>
        diracMatrixMatterAction
          (coefficient direction
            (diracMatterCoordinateLine point direction parameter))
          (field (diracMatterCoordinateLine point direction parameter)))
      fieldDerivative coefficientDerivative 0
      (by simp [diracMatterCoordinateLine])
      fieldCoordinateDerivative actedFieldCoordinateDerivative
  simpa [diracMatterEnergyFlux,
    diracExteriorMatterCoordinateEnergy] using identity

def diracMatterEnergyFluxDivergence
    (coefficient : LorentzianIndex → BasePoint → DiracMatrix)
    (field : BasePoint → DiracExteriorMatterCarrier)
    (point : BasePoint) : ℝ :=
  ∑ direction : LorentzianIndex,
    deriv
      (fun parameter =>
        diracMatterEnergyFlux
          (coefficient direction
            (diracMatterCoordinateLine point direction parameter))
          (field (diracMatterCoordinateLine point direction parameter)))
      0

/-- A Hermitian first-order Dirac equation generates its local energy-flux balance. -/
theorem diracMatterEnergyFluxDivergence_eq
    (coefficient : LorentzianIndex → BasePoint → DiracMatrix)
    (field : BasePoint → DiracExteriorMatterCarrier)
    (point : BasePoint)
    (fieldDerivative coefficientDerivative :
      LorentzianIndex → DiracExteriorMatterCarrier)
    (lowerOrder : DiracExteriorMatterCarrier)
    (hermitian :
      ∀ direction : LorentzianIndex,
        Matrix.IsHermitian (coefficient direction point))
    (fieldCoordinateDerivative :
      ∀ (direction : LorentzianIndex)
        (internal : InternalMatterCoordinateIndex)
        (spin : DiracSpinorIndex),
        HasDerivAt
          (fun parameter =>
            internalMatterCoordinate internal
              (field (diracMatterCoordinateLine point direction parameter)
                spin))
          (internalMatterCoordinate internal
            (fieldDerivative direction spin))
          0)
    (actedFieldCoordinateDerivative :
      ∀ (direction : LorentzianIndex)
        (internal : InternalMatterCoordinateIndex)
        (spin : DiracSpinorIndex),
        HasDerivAt
          (fun parameter =>
            internalMatterCoordinate internal
              (diracMatrixMatterAction
                (coefficient direction
                  (diracMatterCoordinateLine point direction parameter))
                (field
                  (diracMatterCoordinateLine point direction parameter))
                spin))
          (internalMatterCoordinate internal
            ((diracMatrixMatterAction (coefficient direction point)
                (fieldDerivative direction) +
              coefficientDerivative direction) spin))
          0)
    (equation :
      (∑ direction : LorentzianIndex,
        diracMatrixMatterAction (coefficient direction point)
          (fieldDerivative direction)) + lowerOrder = 0) :
    diracMatterEnergyFluxDivergence coefficient field point =
      (∑ direction : LorentzianIndex,
        Complex.re
          (diracExteriorMatterCoordinatePairing (field point)
            (coefficientDerivative direction))) -
        2 * Complex.re
          (diracExteriorMatterCoordinatePairing
            (field point) lowerOrder) := by
  have fluxDerivative
      (direction : LorentzianIndex) :=
    diracMatterEnergyFlux_coordinate_hasDerivAt
      coefficient field point direction
      (fieldDerivative direction) (coefficientDerivative direction)
      (hermitian direction)
      (fieldCoordinateDerivative direction)
      (actedFieldCoordinateDerivative direction)
  have fluxDerivativeEq
      (direction : LorentzianIndex) :
      deriv
          (fun parameter =>
            diracMatterEnergyFlux
              (coefficient direction
                (diracMatterCoordinateLine point direction parameter))
              (field
                (diracMatterCoordinateLine point direction parameter)))
          0 =
        2 * Complex.re
            (diracExteriorMatterCoordinatePairing (field point)
              (diracMatrixMatterAction
                (coefficient direction point)
                (fieldDerivative direction))) +
          Complex.re
            (diracExteriorMatterCoordinatePairing (field point)
              (coefficientDerivative direction)) :=
    (fluxDerivative direction).deriv
  unfold diracMatterEnergyFluxDivergence
  simp_rw [fluxDerivativeEq]
  rw [Finset.sum_add_distrib]
  have principalPairing :
      (∑ direction : LorentzianIndex,
        Complex.re
          (diracExteriorMatterCoordinatePairing (field point)
            (diracMatrixMatterAction (coefficient direction point)
              (fieldDerivative direction)))) =
        Complex.re
          (diracExteriorMatterCoordinatePairing (field point)
            (∑ direction : LorentzianIndex,
              diracMatrixMatterAction (coefficient direction point)
                (fieldDerivative direction))) := by
    rw [diracExteriorMatterCoordinatePairing_sum_right, Complex.re_sum]
  rw [← Finset.mul_sum, principalPairing]
  have principalSumEq :
      (∑ direction : LorentzianIndex,
        diracMatrixMatterAction (coefficient direction point)
          (fieldDerivative direction)) = -lowerOrder :=
    eq_neg_of_add_eq_zero_left equation
  rw [principalSumEq]
  have pairingNeg :
      diracExteriorMatterCoordinatePairing (field point) (-lowerOrder) =
        -diracExteriorMatterCoordinatePairing (field point) lowerOrder := by
    change
      diracExteriorMatterCoordinatePairingRight (field point) (-lowerOrder) =
        -diracExteriorMatterCoordinatePairingRight (field point) lowerOrder
    exact map_neg _ _
  rw [pairingNeg, Complex.neg_re]
  ring

end

end SaturationMonoid.PhysicsCore.StageNineDiracMatterSymmetricHyperbolicFluxBalance
