import H0mework.Physics.DiracCovariance.Density

/-!
# Pointwise local-Spin covariance of the scalar density

The primitive local-Spin action changes the coframe by the already selected
Weyl-dual Lorentz representation while retaining the scalar and gauge
connection fields.  The induced spacetime metric, scalar covariant
derivative, kinetic coefficient, potential, and their separately densitized
scalar block are therefore pointwise invariant.

This is an action consumer/readout closure.  It does not add a scalar
producer, field equation, stationarity receipt, or full root-action symmetry.
-/

namespace SaturationMonoid.PhysicsCore.StageNineScalarLocalSpinDensity

open ProofFreeRicherAnholonomicSource
open StageNineCoframeSpinRepresentation
open StageNineDiracKineticLocalSpinConnection
open StageNineDiracKineticLocalSpinDensity
open StageNineDiracKineticSpinJurisdiction
open StageNineDynamicBreakingVacuum
open StageNineEnrichedProofFreeSource
open StageNineGlobalBundle
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNinePhysicalBivectorSpinRepresentation

open scoped MatrixGroups

noncomputable section

set_option autoImplicit false

/-- The metric generated from a coframe is invariant under the actual
Spin--Lorentz left action. -/
theorem lorentzianMetricOfCoframe_spinLorentzCoframeRepresentation
    (groupElement : SpinPlus13)
    (coframe : LorentzianCoframe) :
    lorentzianMetricOfCoframe
        (spinLorentzCoframeRepresentation groupElement coframe) =
      lorentzianMetricOfCoframe coframe := by
  change lorentzianMetricOfCoframe
      (spinLorentzMatrix groupElement * coframe) = _
  unfold lorentzianMetricOfCoframe
  rw [Matrix.transpose_mul]
  calc
    coframe.transpose * (spinLorentzMatrix groupElement).transpose *
            minkowskiInternalMetric *
          (spinLorentzMatrix groupElement * coframe) =
        coframe.transpose *
            ((spinLorentzMatrix groupElement).transpose *
              minkowskiInternalMetric * spinLorentzMatrix groupElement) *
          coframe := by noncomm_ring
    _ = coframe.transpose * minkowskiInternalMetric * coframe := by
      rw [spinLorentzMatrix_preserves_minkowskiMetric]

/-- Matrix inversion preserves the generated metric identity without a
separate nondegeneracy premise. -/
theorem lorentzianMetricOfCoframe_inv_spinLorentzCoframeRepresentation
    (groupElement : SpinPlus13)
    (coframe : LorentzianCoframe) :
    (lorentzianMetricOfCoframe
      (spinLorentzCoframeRepresentation groupElement coframe))⁻¹ =
      (lorentzianMetricOfCoframe coframe)⁻¹ := by
  rw [lorentzianMetricOfCoframe_spinLorentzCoframeRepresentation]

@[simp] theorem localSpinDiracKineticAction_scalar
    (spinField : BasePoint → SpinPlus13)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    (localSpinDiracKineticAction spinField configuration).scalar point =
      configuration.scalar point :=
  rfl

@[simp] theorem localSpinDiracKineticAction_gaugeConnection
    (spinField : BasePoint → SpinPlus13)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint)
    (direction : LorentzianIndex) :
    (localSpinDiracKineticAction spinField configuration).gaugeConnection
        point direction =
      configuration.gaugeConnection point direction :=
  rfl

@[simp] theorem holonomicScalarCovariantDerivative_localSpin_invariant
    (spinField : BasePoint → SpinPlus13)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint)
    (direction : LorentzianIndex) :
    holonomicScalarCovariantDerivative
        (localSpinDiracKineticAction spinField configuration)
        point direction =
      holonomicScalarCovariantDerivative configuration point direction :=
  rfl

/-- The undensitized scalar kinetic coefficient is invariant on the actual
point field generated by the primitive local-Spin action. -/
theorem generatedScalarKineticDensity_localSpin_invariant
    (source : SmoothUnifiedSource)
    (chart : StageNineChart)
    (spinField : BasePoint → SpinPlus13)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    generatedScalarKineticDensity source chart point
        (toContinuumPointField
          (localSpinDiracKineticAction spinField configuration) point) =
      generatedScalarKineticDensity source chart point
        (toContinuumPointField configuration point) := by
  have metricEquality :
      lorentzianMetricOfCoframe
          (toContinuumPointField
            (localSpinDiracKineticAction spinField configuration)
            point).coframe =
        lorentzianMetricOfCoframe
          (toContinuumPointField configuration point).coframe := by
    change
      lorentzianMetricOfCoframe
          (spinLorentzCoframeRepresentation
            (spinWeylDual (spinField point))
            (configuration.coframe point)) =
        lorentzianMetricOfCoframe (configuration.coframe point)
    exact lorentzianMetricOfCoframe_spinLorentzCoframeRepresentation _ _
  have derivativeEquality :
      (toContinuumPointField
          (localSpinDiracKineticAction spinField configuration)
          point).scalarCovariantDerivative =
        (toContinuumPointField configuration point).scalarCovariantDerivative := by
    funext direction
    exact holonomicScalarCovariantDerivative_localSpin_invariant
      spinField configuration point direction
  unfold generatedScalarKineticDensity
  rw [metricEquality, derivativeEquality]

/-- The source-generated scalar potential sees the unchanged scalar slot and
is therefore definitionally invariant under the primitive local-Spin action. -/
theorem generatedScalarPotential_localSpin_invariant
    (source : SmoothUnifiedSource)
    (chart : StageNineChart)
    (spinField : BasePoint → SpinPlus13)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    generatedScalarPotential source chart point
        (toContinuumPointField
          (localSpinDiracKineticAction spinField configuration) point).scalar =
      generatedScalarPotential source chart point
        (toContinuumPointField configuration point).scalar :=
  rfl

/-- The scalar contribution used by the form-native root, with the coordinate
volume factor applied only to the scalar component density. -/
def generatedDensitizedContinuumScalarDensity
    (source : SmoothUnifiedSource)
    (chart : StageNineChart)
    (point : BasePoint)
    (field : StageNineContinuumPointField) : ℝ :=
  generatedVolumeDensity field *
    (generatedScalarKineticDensity source chart point field -
      generatedScalarPotential source chart point field.scalar)

theorem generatedDensitizedContinuumScalarDensity_overlap
    (source : SmoothUnifiedSource)
    (initial terminal : StageNineChart)
    (point : BasePoint)
    (field : StageNineContinuumPointField) :
    generatedDensitizedContinuumScalarDensity source terminal point
        (transportContinuumPointField source initial terminal point field) =
      generatedDensitizedContinuumScalarDensity source initial point field := by
  have potentialEquality :
      generatedScalarPotential source terminal point
          (transportContinuumPointField source initial terminal point
            field).scalar =
        generatedScalarPotential source initial point field.scalar :=
    generatedScalarPotential_overlap_invariant source initial terminal point
      field.scalar
  unfold generatedDensitizedContinuumScalarDensity
  rw [generatedScalarKineticDensity_overlap]
  rw [potentialEquality]
  rfl

/-- Complete pointwise local-Spin invariance of the separately densitized
scalar block. -/
theorem generatedDensitizedContinuumScalarDensity_localSpin_invariant
    (source : SmoothUnifiedSource)
    (chart : StageNineChart)
    (spinField : BasePoint → SpinPlus13)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    generatedDensitizedContinuumScalarDensity source chart point
        (toContinuumPointField
          (localSpinDiracKineticAction spinField configuration) point) =
      generatedDensitizedContinuumScalarDensity source chart point
        (toContinuumPointField configuration point) := by
  unfold generatedDensitizedContinuumScalarDensity
  rw [generatedVolumeDensity_localSpinDiracKineticAction]
  rw [generatedScalarKineticDensity_localSpin_invariant]
  rw [generatedScalarPotential_localSpin_invariant]

end

end SaturationMonoid.PhysicsCore.StageNineScalarLocalSpinDensity
