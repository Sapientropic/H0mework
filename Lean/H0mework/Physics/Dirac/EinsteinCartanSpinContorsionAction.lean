  rw [connectionOrigin]
  simp_rw [coframeTwoFormLinear_one]
  simp only [LinearMap.id_apply]
  fin_cases internalPair <;>
    simp [einsteinCartanLorentzCoordinateDirection,
      simpleBEinsteinCartanGravityActionCoordinates,
      physicalIIPlusBivector, internalBivectorDual, coframeWedge,
      coframeTwoFormLinear,
      lorentzSkewConnectionOfBivectorOneForm,
      loweredLorentzBivectorMatrix,
      orientedLorentzBivectorBasisCoefficient,
      lorentzianCoframeHodge, lorentzianTwoFormSign,
      minkowskiInternalSign, pairFirst, pairSecond, Matrix.one_apply,
      Fin.sum_univ_six, Fin.sum_univ_four] <;>
    ring

private theorem actualSimpleBGravityAction_eq_coordinates_row_three
    (configuration : StageNineHolonomicConfiguration)
    (connection : LorentzBivectorOneForm)
    (coframeOrigin : configuration.coframe 0 = 1)
    (auxiliaryOrigin :
      configuration.gravityAuxiliary 0 = physicalIIPlusBivector 1)
    (connectionOrigin :
      configuration.gravityConnection 0 =
        lorentzSkewConnectionOfBivectorOneForm connection)
    (internalPair : Fin 6) :
    -lorentzGravityBFAlgebraicCoefficient configuration
        (einsteinCartanLorentzCoordinateDirection 3 internalPair) 0 =
      simpleBEinsteinCartanGravityActionCoordinates connection 3 internalPair := by
  unfold lorentzGravityBFAlgebraicCoefficient
  simp only [toContinuumPointField]
  rw [coframeOrigin, auxiliaryOrigin]
  simp only [generatedVolumeDensity, Matrix.det_one, abs_one, one_mul]
  unfold gravityBFCurvatureIncrementDensity
  rw [← gravityAuxiliaryHodgePairingPolynomial_eq
    (1 : LorentzianCoframe) (by simp)]
  unfold gravityAuxiliaryHodgePairingPolynomial
    lorentzConnectionAlgebraicCurvatureDirection
    lorentzConnectionAlgebraicCurvatureVariation
  rw [connectionOrigin]
  simp_rw [coframeTwoFormLinear_one]
  simp only [LinearMap.id_apply]
  fin_cases internalPair <;>
    simp [einsteinCartanLorentzCoordinateDirection,
      simpleBEinsteinCartanGravityActionCoordinates,
      physicalIIPlusBivector, internalBivectorDual, coframeWedge,
      coframeTwoFormLinear,
      lorentzSkewConnectionOfBivectorOneForm,
      loweredLorentzBivectorMatrix,
      orientedLorentzBivectorBasisCoefficient,
      lorentzianCoframeHodge, lorentzianTwoFormSign,
      minkowskiInternalSign, pairFirst, pairSecond, Matrix.one_apply,
      Fin.sum_univ_six, Fin.sum_univ_four] <;>
    ring

/-- Bind the displayed finite action to an actual generated configuration.
Only already-produced origin values are consumed. -/
theorem actualSimpleBGravityAction_eq_coordinates
    (configuration : StageNineHolonomicConfiguration)
    (connection : LorentzBivectorOneForm)
    (coframeOrigin : configuration.coframe 0 = 1)
    (auxiliaryOrigin :
      configuration.gravityAuxiliary 0 =
        physicalIIPlusBivector 1)
    (connectionOrigin :
      configuration.gravityConnection 0 =
        lorentzSkewConnectionOfBivectorOneForm connection) :
    (fun formDirection internalPair =>
      -lorentzGravityBFAlgebraicCoefficient configuration
        (einsteinCartanLorentzCoordinateDirection
          formDirection internalPair)
        0) =
      simpleBEinsteinCartanGravityActionCoordinates connection := by
  funext formDirection internalPair
  fin_cases formDirection
  · exact actualSimpleBGravityAction_eq_coordinates_row_zero configuration
      connection coframeOrigin auxiliaryOrigin connectionOrigin internalPair
  · exact actualSimpleBGravityAction_eq_coordinates_row_one configuration
      connection coframeOrigin auxiliaryOrigin connectionOrigin internalPair
  · exact actualSimpleBGravityAction_eq_coordinates_row_two configuration
      connection coframeOrigin auxiliaryOrigin connectionOrigin internalPair
  · exact actualSimpleBGravityAction_eq_coordinates_row_three configuration
      connection coframeOrigin auxiliaryOrigin connectionOrigin internalPair

/-- Actual all-coordinate Cartan balance generated by the direct contorsion
map.  It is an acceptance theorem for an already generated `configuration`,
not a constructor premise. -/
theorem actualSimpleBContorsion_gravityAction_eq_spin
    (configuration : StageNineHolonomicConfiguration)
    (spin : LorentzBivectorOneForm)
    (coframeOrigin : configuration.coframe 0 = 1)
    (auxiliaryOrigin :
      configuration.gravityAuxiliary 0 =
        physicalIIPlusBivector 1)
    (connectionOrigin :
      configuration.gravityConnection 0 =
        lorentzSkewConnectionOfBivectorOneForm
          (einsteinCartanSpinContorsionCoordinates spin)) :
    (fun formDirection internalPair =>
      -lorentzGravityBFAlgebraicCoefficient configuration
        (einsteinCartanLorentzCoordinateDirection
          formDirection internalPair)
        0) =
      spin := by
  rw [
    actualSimpleBGravityAction_eq_coordinates configuration
      (einsteinCartanSpinContorsionCoordinates spin)
      coframeOrigin auxiliaryOrigin connectionOrigin,
    simpleBGravityAction_contorsion]

/-- Full-direction algebraic Einstein--Cartan balance on an already
generated actual.  The coordinate spin equality is a downstream readout of
that actual, not a constructor argument. -/
theorem actualSimpleBContorsion_algebraicBalance
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (spin : LorentzBivectorOneForm)
    (coframeOrigin : configuration.coframe 0 = 1)
    (auxiliaryOrigin :
      configuration.gravityAuxiliary 0 =
        physicalIIPlusBivector 1)
    (connectionOrigin :
      configuration.gravityConnection 0 =
        lorentzSkewConnectionOfBivectorOneForm
          (einsteinCartanSpinContorsionCoordinates spin))
    (actualSpin :
      actualMatterSpinActionCoordinates source configuration 0 = spin)
    (direction : LorentzBivectorOneForm) :
    lorentzGravityBFAlgebraicCoefficient configuration direction 0 +
        lorentzMatterSpinSourceCoefficient source configuration direction 0 =
      0 := by
  have gravityCoordinates :=
    actualSimpleBContorsion_gravityAction_eq_spin configuration spin
      coframeOrigin auxiliaryOrigin connectionOrigin
  have dualEquality :
      -einsteinCartanGravityBFActionDual configuration 0 =
        einsteinCartanMatterSpinActionDual source configuration 0 := by
    apply einsteinCartanLorentzDual_eq_of_coordinate_eq
    intro formDirection internalPair
    change
      -lorentzGravityBFAlgebraicCoefficient configuration
          (einsteinCartanLorentzCoordinateDirection
            formDirection internalPair)
          0 =
        lorentzMatterSpinSourceCoefficient source configuration
          (einsteinCartanLorentzCoordinateDirection
            formDirection internalPair)
          0
    have gravityCoordinate :=
      congrFun (congrFun gravityCoordinates formDirection) internalPair
    have spinCoordinate :=
      congrFun (congrFun actualSpin formDirection) internalPair
    unfold actualMatterSpinActionCoordinates at spinCoordinate
    linarith
  have evaluated := congrArg
    (fun response : Module.Dual ℝ LorentzBivectorOneForm =>
      response direction)
    dualEquality
  change
    -lorentzGravityBFAlgebraicCoefficient configuration direction 0 =
      lorentzMatterSpinSourceCoefficient source configuration direction 0
    at evaluated
  linarith

end

