/-! ## Actual representation covector -/

/-- Coordinate basis of the actual Lorentz-bivector one-form carrier. -/
def einsteinCartanLorentzCoordinateDirection
    (formDirection : LorentzianIndex)
    (internalPair : Fin 6) :
    LorentzBivectorOneForm :=
  fun candidateForm candidatePair =>
    if candidateForm = formDirection ∧ candidatePair = internalPair then
      1
    else
      0

/-- Complete matter-spin covector generated by an already actual
configuration and the existing Dirac representation action. -/
def actualMatterSpinActionCoordinates
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    LorentzBivectorOneForm :=
  fun formDirection internalPair =>
    lorentzMatterSpinSourceCoefficient source configuration
      (einsteinCartanLorentzCoordinateDirection
        formDirection internalPair)
      point

theorem actualMatterSpinActionCoordinates_zero_of_matter_zero
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (matterZero : configuration.matter 0 = 0) :
    actualMatterSpinActionCoordinates source configuration 0 = 0 := by
  funext formDirection internalPair
  unfold actualMatterSpinActionCoordinates
    lorentzMatterSpinSourceCoefficient
    holonomicMatterLorentzConnectionVariation
  rw [matterZero]
  simp [matterGaugeConnectionFirstVariationDensity,
    matterGaugeConnectionVariationVector, matterGaugeKineticSum,
    matterDerivativeFrameRelative, matterFrameRelative]

/-- The spin action readout is insensitive to fields that do not occur in
the Dirac connection variation. -/
theorem actualMatterSpinActionCoordinates_eq_of_origin_fields
    (source : SmoothUnifiedSource)
    (first second : StageNineHolonomicConfiguration)
    (coframeEqual : first.coframe 0 = second.coframe 0)
    (matterEqual : first.matter 0 = second.matter 0)
    (conjugateEqual :
      first.conjugateMatter 0 = second.conjugateMatter 0) :
    actualMatterSpinActionCoordinates source first 0 =
      actualMatterSpinActionCoordinates source second 0 := by
  funext formDirection internalPair
  unfold actualMatterSpinActionCoordinates
    lorentzMatterSpinSourceCoefficient
    holonomicMatterLorentzConnectionVariation
    matterGaugeConnectionFirstVariationDensity
    matterGaugeConnectionVariationVector
    matterGaugeKineticSum
    generatedVolumeDensity
  simp only [toContinuumPointField]
  rw [coframeEqual, matterEqual, conjugateEqual]

/-- The same spin-action readout can be compared at two actual contacts.
The action is evaluated in the fixed normalized chart `0`; its frame-relative
matter and dual maps are therefore identity maps at every base point.  Once
coframe, primal matter, and adjoint matter agree at the two contacts, the
generated spin coordinates agree without a supplied transport witness. -/
theorem actualMatterSpinActionCoordinates_eq_of_fields_at
    (source : SmoothUnifiedSource)
    (first second : StageNineHolonomicConfiguration)
    (firstPoint secondPoint : BasePoint)
    (coframeEqual :
      first.coframe firstPoint = second.coframe secondPoint)
    (matterEqual :
      first.matter firstPoint = second.matter secondPoint)
    (conjugateEqual :
      first.conjugateMatter firstPoint =
        second.conjugateMatter secondPoint) :
    actualMatterSpinActionCoordinates source first firstPoint =
      actualMatterSpinActionCoordinates source second secondPoint := by
  funext formDirection internalPair
  unfold actualMatterSpinActionCoordinates
    lorentzMatterSpinSourceCoefficient
    holonomicMatterLorentzConnectionVariation
    matterGaugeConnectionFirstVariationDensity
    matterGaugeConnectionVariationVector
    matterGaugeKineticSum
    generatedVolumeDensity
  simp only [toContinuumPointField]
  rw [coframeEqual, matterEqual, conjugateEqual]
  simp [matterDualFrameRelative, matterDerivativeFrameRelative,
    matterFrameRelative, StageNineDynamicBreakingVacuum.generatedScalarFrame,
    generatedTransition_normalized]

/-! ## Direct action morphism -/

/-- Closed coordinate form of the identity-coframe/simple-`B`
gravity-connection action.  The theorem below identifies it with the actual
gravity-BF variation on any matching generated configuration. -/
def simpleBEinsteinCartanGravityActionCoordinates
    (connection : LorentzBivectorOneForm) :
    LorentzBivectorOneForm :=
  ![
    ![
      -connection 2 5 + connection 3 4,
      connection 1 5 - connection 3 3,
      -connection 1 4 + connection 2 3,
      -connection 2 2 + connection 3 1,
      connection 1 2 - connection 3 0,
      -connection 1 1 + connection 2 0],
    ![
      -connection 2 1 - connection 3 2,
      -connection 0 5 + connection 2 0,
      connection 0 4 + connection 3 0,
      connection 2 4 + connection 3 5,
      -connection 0 2 - connection 2 3,
      connection 0 1 - connection 3 3],
    ![
      connection 0 5 + connection 1 1,
      -connection 1 0 - connection 3 2,
      -connection 0 3 + connection 3 1,
      connection 0 2 - connection 1 4,
      connection 1 3 + connection 3 5,
      -connection 0 0 - connection 3 4],
    ![
      -connection 0 4 + connection 1 2,
      connection 0 3 + connection 2 2,
      -connection 1 0 - connection 2 1,
      -connection 0 1 - connection 1 5,
      connection 0 0 - connection 2 5,
      connection 1 3 + connection 2 4]
  ]

/-- The fixed Einstein--Cartan representation morphism from a spin covector
to contorsion coordinates.  The factors `1/2` are not adjustable data: the
all-coordinate action-normalization theorem below determines them. -/
def einsteinCartanSpinContorsionCoordinates
    (spin : LorentzBivectorOneForm) :
    LorentzBivectorOneForm :=
  ![
    ![
      -(1 / 2 : ℝ) * spin 0 0 - (1 / 2 : ℝ) * spin 2 5 +
        (1 / 2 : ℝ) * spin 3 4,
      -(1 / 2 : ℝ) * spin 0 1 + (1 / 2 : ℝ) * spin 1 5 -
        (1 / 2 : ℝ) * spin 3 3,
      -(1 / 2 : ℝ) * spin 0 2 - (1 / 2 : ℝ) * spin 1 4 +
        (1 / 2 : ℝ) * spin 2 3,
      (1 / 2 : ℝ) * spin 0 3 - (1 / 2 : ℝ) * spin 2 2 +
        (1 / 2 : ℝ) * spin 3 1,
      (1 / 2 : ℝ) * spin 0 4 + (1 / 2 : ℝ) * spin 1 2 -
        (1 / 2 : ℝ) * spin 3 0,
      (1 / 2 : ℝ) * spin 0 5 - (1 / 2 : ℝ) * spin 1 1 +
        (1 / 2 : ℝ) * spin 2 0],
    ![
      (1 / 2 : ℝ) * spin 1 0 - (1 / 2 : ℝ) * spin 2 1 -
        (1 / 2 : ℝ) * spin 3 2,
      -(1 / 2 : ℝ) * spin 0 5 + (1 / 2 : ℝ) * spin 1 1 +
        (1 / 2 : ℝ) * spin 2 0,
      (1 / 2 : ℝ) * spin 0 4 + (1 / 2 : ℝ) * spin 1 2 +
        (1 / 2 : ℝ) * spin 3 0,
      -(1 / 2 : ℝ) * spin 1 3 + (1 / 2 : ℝ) * spin 2 4 +
        (1 / 2 : ℝ) * spin 3 5,
      -(1 / 2 : ℝ) * spin 0 2 - (1 / 2 : ℝ) * spin 1 4 -
        (1 / 2 : ℝ) * spin 2 3,
      (1 / 2 : ℝ) * spin 0 1 - (1 / 2 : ℝ) * spin 1 5 -
        (1 / 2 : ℝ) * spin 3 3],
    ![
      (1 / 2 : ℝ) * spin 0 5 + (1 / 2 : ℝ) * spin 1 1 +
        (1 / 2 : ℝ) * spin 2 0,
      -(1 / 2 : ℝ) * spin 1 0 + (1 / 2 : ℝ) * spin 2 1 -
        (1 / 2 : ℝ) * spin 3 2,
      -(1 / 2 : ℝ) * spin 0 3 + (1 / 2 : ℝ) * spin 2 2 +
        (1 / 2 : ℝ) * spin 3 1,
      (1 / 2 : ℝ) * spin 0 2 - (1 / 2 : ℝ) * spin 1 4 -
        (1 / 2 : ℝ) * spin 2 3,
      (1 / 2 : ℝ) * spin 1 3 - (1 / 2 : ℝ) * spin 2 4 +
        (1 / 2 : ℝ) * spin 3 5,
      -(1 / 2 : ℝ) * spin 0 0 - (1 / 2 : ℝ) * spin 2 5 -
        (1 / 2 : ℝ) * spin 3 4],
    ![
      -(1 / 2 : ℝ) * spin 0 4 + (1 / 2 : ℝ) * spin 1 2 +
        (1 / 2 : ℝ) * spin 3 0,
      (1 / 2 : ℝ) * spin 0 3 + (1 / 2 : ℝ) * spin 2 2 +
        (1 / 2 : ℝ) * spin 3 1,
      -(1 / 2 : ℝ) * spin 1 0 - (1 / 2 : ℝ) * spin 2 1 +
        (1 / 2 : ℝ) * spin 3 2,
      -(1 / 2 : ℝ) * spin 0 1 - (1 / 2 : ℝ) * spin 1 5 -
        (1 / 2 : ℝ) * spin 3 3,
      (1 / 2 : ℝ) * spin 0 0 - (1 / 2 : ℝ) * spin 2 5 -
        (1 / 2 : ℝ) * spin 3 4,
      (1 / 2 : ℝ) * spin 1 3 + (1 / 2 : ℝ) * spin 2 4 -
        (1 / 2 : ℝ) * spin 3 5]
  ]

@[simp] theorem einsteinCartanSpinContorsionCoordinates_zero :
    einsteinCartanSpinContorsionCoordinates 0 = 0 := by
  funext formDirection internalPair
  fin_cases formDirection <;> fin_cases internalPair <;>
    simp [einsteinCartanSpinContorsionCoordinates]

theorem einsteinCartanSpinContorsionCoordinates_add
    (first second : LorentzBivectorOneForm) :
    einsteinCartanSpinContorsionCoordinates (first + second) =
      einsteinCartanSpinContorsionCoordinates first +
        einsteinCartanSpinContorsionCoordinates second := by
  funext formDirection internalPair
  fin_cases formDirection <;> fin_cases internalPair <;>
    simp [einsteinCartanSpinContorsionCoordinates] <;>
    ring

theorem einsteinCartanSpinContorsionCoordinates_smul
    (scalar : ℝ)
    (spin : LorentzBivectorOneForm) :
    einsteinCartanSpinContorsionCoordinates (scalar • spin) =
      scalar • einsteinCartanSpinContorsionCoordinates spin := by
  funext formDirection internalPair
  fin_cases formDirection <;> fin_cases internalPair <;>
    simp [einsteinCartanSpinContorsionCoordinates] <;>
    ring

/-- The direct spin-to-contorsion law as a real-linear representation
morphism. -/
def einsteinCartanSpinContorsionLinear :
    Module.End ℝ LorentzBivectorOneForm where
  toFun := einsteinCartanSpinContorsionCoordinates
  map_add' := einsteinCartanSpinContorsionCoordinates_add
  map_smul' := einsteinCartanSpinContorsionCoordinates_smul

/-! ## Faithfulness and action normalization -/

/-- The action response of the generated contorsion is exactly the original
spin covector.  This is the no-free-parameter normalization gate. -/
theorem simpleBGravityAction_contorsion
    (spin : LorentzBivectorOneForm) :
    simpleBEinsteinCartanGravityActionCoordinates
        (einsteinCartanSpinContorsionCoordinates spin) =
      spin := by
  funext formDirection internalPair
  fin_cases formDirection <;> fin_cases internalPair <;>
    simp [simpleBEinsteinCartanGravityActionCoordinates,
      einsteinCartanSpinContorsionCoordinates] <;>
    ring

/-- Conversely, the representation morphism loses no connection
coordinate on the simple-`B` action carrier. -/
theorem contorsion_simpleBGravityAction
    (connection : LorentzBivectorOneForm) :
    einsteinCartanSpinContorsionCoordinates
        (simpleBEinsteinCartanGravityActionCoordinates connection) =
      connection := by
  funext formDirection internalPair
  fin_cases formDirection <;> fin_cases internalPair <;>
    simp [simpleBEinsteinCartanGravityActionCoordinates,
      einsteinCartanSpinContorsionCoordinates] <;>
    ring

theorem einsteinCartanSpinContorsionCoordinates_injective :
    Function.Injective einsteinCartanSpinContorsionCoordinates := by
  intro first second equality
  have responseEquality :=
    congrArg simpleBEinsteinCartanGravityActionCoordinates equality
  simpa [simpleBGravityAction_contorsion] using responseEquality

theorem einsteinCartanSpinContorsionCoordinates_eq_zero_iff
    (spin : LorentzBivectorOneForm) :
    einsteinCartanSpinContorsionCoordinates spin = 0 ↔
      spin = 0 := by
  constructor
  · intro equality
    exact einsteinCartanSpinContorsionCoordinates_injective
      (equality.trans einsteinCartanSpinContorsionCoordinates_zero.symm)
  · intro equality
    subst spin
    exact einsteinCartanSpinContorsionCoordinates_zero

/-! ## Full Lorentz action dual -/

theorem einsteinCartanLorentzCoordinateExpansion
    (direction : LorentzBivectorOneForm) :
    (∑ formDirection : LorentzianIndex,
      ∑ internalPair : Fin 6,
        direction formDirection internalPair •
          einsteinCartanLorentzCoordinateDirection
            formDirection internalPair) =
      direction := by
  funext formDirection internalPair
  fin_cases formDirection <;> fin_cases internalPair <;>
    simp [einsteinCartanLorentzCoordinateDirection, Fin.sum_univ_six]

theorem einsteinCartanAlgebraicCurvatureDirection_add
    (configuration : StageNineHolonomicConfiguration)
    (first second : LorentzBivectorOneForm)
    (point : BasePoint) :
    lorentzConnectionAlgebraicCurvatureDirection configuration
        (first + second) point =
      lorentzConnectionAlgebraicCurvatureDirection configuration first
          point +
        lorentzConnectionAlgebraicCurvatureDirection configuration second
          point := by
  funext internalPair spacetimePair
  unfold lorentzConnectionAlgebraicCurvatureDirection
    lorentzConnectionAlgebraicCurvatureVariation
  dsimp only
  rw [lorentzSkewConnectionOfBivectorOneForm_add]
  simp only [Pi.add_apply, mul_add, add_mul, Finset.sum_add_distrib]
  rw [← mul_add, ← Finset.sum_add_distrib]
  apply congrArg
  apply Finset.sum_congr rfl
  intro middle _
  ring

theorem einsteinCartanAlgebraicCurvatureDirection_smul
    (configuration : StageNineHolonomicConfiguration)
    (scalar : ℝ)
    (direction : LorentzBivectorOneForm)
    (point : BasePoint) :
    lorentzConnectionAlgebraicCurvatureDirection configuration
        (scalar • direction) point =
      scalar •
        lorentzConnectionAlgebraicCurvatureDirection configuration
          direction point := by
  funext internalPair spacetimePair
  unfold lorentzConnectionAlgebraicCurvatureDirection
    lorentzConnectionAlgebraicCurvatureVariation
  dsimp only
  rw [lorentzSkewConnectionOfBivectorOneForm_smul]
  simp only [Pi.smul_apply, smul_eq_mul, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro middle _
  ring

theorem einsteinCartanGravityBFAlgebraicCoefficient_add
    (configuration : StageNineHolonomicConfiguration)
    (first second : LorentzBivectorOneForm)
    (point : BasePoint) :
    lorentzGravityBFAlgebraicCoefficient configuration
        (first + second) point =
      lorentzGravityBFAlgebraicCoefficient configuration first point +
        lorentzGravityBFAlgebraicCoefficient configuration second point := by
  unfold lorentzGravityBFAlgebraicCoefficient
  rw [einsteinCartanAlgebraicCurvatureDirection_add,
    gravityBFCurvatureIncrementDensity_add]
  ring

theorem einsteinCartanGravityBFAlgebraicCoefficient_smul
    (configuration : StageNineHolonomicConfiguration)
    (scalar : ℝ)
    (direction : LorentzBivectorOneForm)
    (point : BasePoint) :
    lorentzGravityBFAlgebraicCoefficient configuration
        (scalar • direction) point =
      scalar *
        lorentzGravityBFAlgebraicCoefficient configuration direction point := by
  unfold lorentzGravityBFAlgebraicCoefficient
  rw [einsteinCartanAlgebraicCurvatureDirection_smul,
    gravityBFCurvatureIncrementDensity_smul]
  ring

theorem einsteinCartanMatterLorentzVariation_add
    (configuration : StageNineHolonomicConfiguration)
    (first second : LorentzBivectorOneForm)
    (point : BasePoint) :
    holonomicMatterLorentzConnectionVariation configuration
        (fun _ => first + second) point =
      holonomicMatterLorentzConnectionVariation configuration
          (fun _ => first) point +
        holonomicMatterLorentzConnectionVariation configuration
          (fun _ => second) point := by
  funext formDirection
  unfold holonomicMatterLorentzConnectionVariation
  rw [lorentzSkewConnectionOfBivectorOneForm_add,
    diracSpinConnectionLift_add,
    diracMatrixMatterAction_add_matrix_local]
  rfl

theorem einsteinCartanMatterLorentzVariation_smul
    (configuration : StageNineHolonomicConfiguration)
    (scalar : ℝ)
    (direction : LorentzBivectorOneForm)
    (point : BasePoint) :
    holonomicMatterLorentzConnectionVariation configuration
        (fun _ => scalar • direction) point =
      scalar •
        holonomicMatterLorentzConnectionVariation configuration
          (fun _ => direction) point := by
  funext formDirection
  unfold holonomicMatterLorentzConnectionVariation
  rw [lorentzSkewConnectionOfBivectorOneForm_smul,
