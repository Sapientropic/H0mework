import H0mework.Physics.Lorentz.LorentzCoverAndSpinDescent
import H0mework.Physics.Coframe.CoframeTwoFormPairing

/-!
# S9-C3g6a: induced Spin action on the physical bivector carrier

The current gravity obstruction lives in

`PhysicalBivector = Λ²_internal ⊗ Λ²_spacetime`.

This module derives its internal-factor action from the already generated
`spinLorentzCover`; it does not accept a bivector representation as a new
source field or certificate.  The actual four-vector linear equivalence is
sent to its coordinate matrix, the existing `coframeWedge` construction gives
the exterior-square action, and conjugation by matrix transpose applies that
action to the internal pair index while leaving the spacetime pair index
unchanged.

The resulting maps are proved multiplicative linear equivalences and packaged
as an actual `SpinPlus13` representation.  An existing dilation element acts
nontrivially on a concrete bivector coordinate, while the central sign acts
trivially as required by the existing two-to-one Spin--Lorentz cover.  This
checkpoint is representation infrastructure only: it does not yet prove
equivariance of the gravity obstruction builder, construct an orbit-span
carrier, or add a field, action coefficient, source slot, or branch receipt.
-/

namespace SaturationMonoid.PhysicsCore.StageNinePhysicalBivectorSpinRepresentation

open PhysicsCore
open ProofFreeRicherAnholonomicSource
open PointwiseLorentzianCoframeJet
open StageNineSpinMatterBundle
open StageNineGlobalBundle
open StageNineBlockwiseConstitutive
open StageNineLorentzCoverAndSpinDescent
open StageNineGlobalIntegratedAction
open StageNineCoframeTwoFormPairing

noncomputable section

set_option autoImplicit false

/-- Canonical coordinate basis of the already fixed four-dimensional base
carrier. -/
def basePointCoordinateBasis : Module.Basis LorentzianIndex ℝ BasePoint :=
  (EuclideanSpace.basisFun LorentzianIndex ℝ).toBasis

/-- Matrix representation of the actual source-independent Spin--Lorentz
cover.  Multiplicativity comes from `spinLorentzCover` and `toMatrixAlgEquiv`.
-/
def spinLorentzMatrix : SpinPlus13 →* LorentzianCoframe :=
  (LinearMap.toMatrixAlgEquiv basePointCoordinateBasis).toAlgHom.toMonoidHom'.comp
    (LinearEquiv.automorphismGroup.toLinearMapMonoidHom.comp spinLorentzCover)

@[simp] theorem spinLorentzMatrix_apply
    (groupElement : SpinPlus13) (row column : LorentzianIndex) :
    spinLorentzMatrix groupElement row column =
      spinLorentzCover groupElement (EuclideanSpace.single column 1) row := by
  change (LinearMap.toMatrixAlgEquiv basePointCoordinateBasis)
      (spinLorentzCover groupElement).toLinearMap row column = _
  rw [LinearMap.toMatrixAlgEquiv_apply]
  simp [basePointCoordinateBasis, EuclideanSpace.basisFun_apply,
    EuclideanSpace.basisFun_repr]

/-- Exterior-square action on the oriented six-coordinate two-form carrier. -/
def spinLorentzTwoFormLinearMap (groupElement : SpinPlus13) :
    GaugeTwoForm →ₗ[ℝ] GaugeTwoForm :=
  coframeTwoFormLinear (spinLorentzMatrix groupElement)

@[simp] theorem spinLorentzTwoFormLinearMap_one :
    spinLorentzTwoFormLinearMap 1 = LinearMap.id := by
  rw [spinLorentzTwoFormLinearMap, map_one, coframeTwoFormLinear_one]

theorem spinLorentzTwoFormLinearMap_mul
    (first second : SpinPlus13) :
    spinLorentzTwoFormLinearMap (first * second) =
      (spinLorentzTwoFormLinearMap first).comp
        (spinLorentzTwoFormLinearMap second) := by
  rw [spinLorentzTwoFormLinearMap, map_mul, coframeTwoFormLinear_mul]
  rfl

/-- Inverse exterior-square action is generated by the inverse Spin element. -/
def spinLorentzTwoFormLinearEquiv (groupElement : SpinPlus13) :
    GaugeTwoForm ≃ₗ[ℝ] GaugeTwoForm where
  toLinearMap := spinLorentzTwoFormLinearMap groupElement
  invFun := spinLorentzTwoFormLinearMap groupElement⁻¹
  left_inv := by
    intro form
    change spinLorentzTwoFormLinearMap groupElement⁻¹
        (spinLorentzTwoFormLinearMap groupElement form) = form
    rw [← LinearMap.comp_apply, ← spinLorentzTwoFormLinearMap_mul]
    simp
  right_inv := by
    intro form
    change spinLorentzTwoFormLinearMap groupElement
        (spinLorentzTwoFormLinearMap groupElement⁻¹ form) = form
    rw [← LinearMap.comp_apply, ← spinLorentzTwoFormLinearMap_mul]
    simp

/-- Actual exterior-square representation generated from the existing
Spin--Lorentz cover. -/
def spinLorentzTwoFormRepresentation :
    SpinPlus13 →* (GaugeTwoForm ≃ₗ[ℝ] GaugeTwoForm) where
  toFun := spinLorentzTwoFormLinearEquiv
  map_one' := by
    apply LinearEquiv.ext
    intro form
    change spinLorentzTwoFormLinearMap 1 form = form
    rw [spinLorentzTwoFormLinearMap_one]
    rfl
  map_mul' first second := by
    apply LinearEquiv.ext
    intro form
    change spinLorentzTwoFormLinearMap (first * second) form =
      spinLorentzTwoFormLinearMap first
        (spinLorentzTwoFormLinearMap second form)
    rw [spinLorentzTwoFormLinearMap_mul]
    rfl

/-- Apply the exterior-square representation to the internal pair index of a
physical bivector.  Matrix transpose exposes internal columns as pointwise
two-form rows, after which it is transposed back. -/
def spinLorentzPhysicalBivectorLinearEquiv
    (groupElement : SpinPlus13) :
    PhysicalBivector ≃ₗ[ℝ] PhysicalBivector :=
  (Matrix.transposeLinearEquiv (Fin 6) (Fin 6) ℝ ℝ).trans
    ((LinearEquiv.piCongrRight
      (fun _ : Fin 6 => spinLorentzTwoFormLinearEquiv groupElement)).trans
        (Matrix.transposeLinearEquiv (Fin 6) (Fin 6) ℝ ℝ))

@[simp] theorem spinLorentzPhysicalBivectorLinearEquiv_apply
    (groupElement : SpinPlus13) (bivector : PhysicalBivector)
    (internalPair spacetimePair : Fin 6) :
    spinLorentzPhysicalBivectorLinearEquiv groupElement bivector
        internalPair spacetimePair =
      spinLorentzTwoFormLinearEquiv groupElement
        (fun sourceInternalPair => bivector sourceInternalPair spacetimePair)
        internalPair :=
  rfl

/-- The induced internal-factor action is a genuine multiplicative
representation on the full physical bivector carrier. -/
def spinLorentzPhysicalBivectorRepresentation :
    SpinPlus13 →* (PhysicalBivector ≃ₗ[ℝ] PhysicalBivector) where
  toFun := spinLorentzPhysicalBivectorLinearEquiv
  map_one' := by
    apply LinearEquiv.ext
    intro bivector
    funext internalPair spacetimePair
    rw [spinLorentzPhysicalBivectorLinearEquiv_apply]
    change spinLorentzTwoFormLinearMap 1
      (fun sourceInternalPair => bivector sourceInternalPair spacetimePair)
        internalPair = bivector internalPair spacetimePair
    rw [spinLorentzTwoFormLinearMap_one]
    rfl
  map_mul' first second := by
    apply LinearEquiv.ext
    intro bivector
    funext internalPair spacetimePair
    rw [spinLorentzPhysicalBivectorLinearEquiv_apply]
    change spinLorentzTwoFormLinearMap (first * second)
        (fun sourceInternalPair => bivector sourceInternalPair spacetimePair)
          internalPair = _
    rw [spinLorentzTwoFormLinearMap_mul]
    rfl

/-- Coordinate bivector used to certify that the induced representation is
not the trivial representation. -/
def internalTimeSpaceBasis : PhysicalBivector :=
  fun internalPair spacetimePair =>
    if internalPair = 0 ∧ spacetimePair = 0 then 1 else 0

/-- The already fixed dilation element acts nontrivially on the actual
physical bivector carrier.  The value is computed through the Spin cover,
its four-vector matrix, and the exterior-square action. -/
theorem spinDilation_internalTimeSpaceBasis_component :
    spinLorentzPhysicalBivectorRepresentation spinDilation
        internalTimeSpaceBasis 0 0 = 17 / 8 := by
  have three_ne_zero : (3 : LorentzianIndex) ≠ 0 := by decide
  change spinLorentzPhysicalBivectorLinearEquiv spinDilation
    internalTimeSpaceBasis 0 0 = 17 / 8
  rw [spinLorentzPhysicalBivectorLinearEquiv_apply]
  change spinLorentzTwoFormLinearMap spinDilation
    (fun sourceInternalPair => internalTimeSpaceBasis sourceInternalPair 0)
      0 = 17 / 8
  norm_num [spinLorentzTwoFormLinearEquiv, spinLorentzTwoFormLinearMap,
    coframeTwoFormLinear, coframeWedge, internalTimeSpaceBasis,
    pairFirst, pairSecond,
    Matrix.mul_apply, Fin.sum_univ_two, three_ne_zero]
  norm_num [spinLorentzCover, spinLorentzLinearEquiv, spinLorentzLinearMap,
    spinHermitianAction, pauliDecode, pauliEncode, spinDilation,
    Matrix.mul_apply, Fin.sum_univ_two, Matrix.conjTranspose_apply,
    three_ne_zero]

/-- Negative regression: the induced physical-bivector representation cannot
collapse to the identity representation. -/
theorem spinDilation_physicalBivectorRepresentation_ne_one :
    spinLorentzPhysicalBivectorRepresentation spinDilation ≠ 1 := by
  intro representationIsTrivial
  have componentEquality := congrArg
    (fun action : PhysicalBivector ≃ₗ[ℝ] PhysicalBivector =>
      action internalTimeSpaceBasis 0 0)
    representationIsTrivial
  rw [spinDilation_internalTimeSpaceBasis_component] at componentEquality
  norm_num [internalTimeSpaceBasis] at componentEquality

/-- The expected double-cover kernel is preserved by the induced
representation; the nonidentity central sign acts like the identity. -/
theorem spinCentralSign_physicalBivectorRepresentation_eq_one :
    spinLorentzPhysicalBivectorRepresentation spinCentralSign = 1 := by
  have coverEquality : spinLorentzCover spinCentralSign = spinLorentzCover 1 :=
    spinLorentzCover_identifies_central_sign
  have matrixEquality :
      spinLorentzMatrix spinCentralSign = spinLorentzMatrix 1 := by
    change (LinearMap.toMatrixAlgEquiv basePointCoordinateBasis)
        (spinLorentzCover spinCentralSign).toLinearMap =
      (LinearMap.toMatrixAlgEquiv basePointCoordinateBasis)
        (spinLorentzCover 1).toLinearMap
    rw [coverEquality]
  apply LinearEquiv.ext
  intro bivector
  funext internalPair spacetimePair
  change coframeTwoFormLinear (spinLorentzMatrix spinCentralSign)
      (fun sourceInternalPair => bivector sourceInternalPair spacetimePair)
        internalPair = bivector internalPair spacetimePair
  rw [matrixEquality, map_one, coframeTwoFormLinear_one]
  rfl

end

end SaturationMonoid.PhysicsCore.StageNinePhysicalBivectorSpinRepresentation
