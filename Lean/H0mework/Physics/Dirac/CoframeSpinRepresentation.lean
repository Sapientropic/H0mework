import H0mework.Physics.Dirac.PhysicalBivectorSpinRepresentation
import Mathlib.Topology.Algebra.Module.FiniteDimension
import Mathlib.Topology.Algebra.Module.Spaces.ContinuousLinearMap

/-!
# C3h75a: coframe Spin representation and continuous-dual transport

This C3h75 checkpoint derives the left coframe action from the already
generated `spinLorentzCover`.  Finite dimensionality upgrades the linear
equivalences to continuous linear equivalences, and inverse precomposition
then gives the continuous-dual action on actual coframe residuals.

The declarations below are representation/transporter infrastructure only.
They do not produce a new coframe `e'`, select a normalization, solve the
joint shell, or add a source slot, coupling, branch receipt, or field.

The final scalar-ambiguity regression concerns the vector space of Spin
intertwiners.  Its scalar `2` is not a Lorentz/Spin dilation and it does not
claim that any decoder exists or that the whole gravity shell is empty.
-/

namespace SaturationMonoid.PhysicsCore.StageNineCoframeSpinRepresentation

open ProofFreeRicherAnholonomicSource
open StageNineSpinMatterBundle
open StageNineGlobalBundle
open StageNineLorentzCoverAndSpinDescent
open StageNinePhysicalBivectorSpinRepresentation

noncomputable section

set_option autoImplicit false

/-! ## Primal coframe representation -/

/-- The Spin--Lorentz matrix acts on the internal row of a coframe by left
multiplication.  Its inverse is generated by the inverse Spin element. -/
def spinLorentzCoframeLinearEquiv (groupElement : SpinPlus13) :
    LorentzianCoframe ≃ₗ[ℝ] LorentzianCoframe where
  toFun coframe := spinLorentzMatrix groupElement * coframe
  invFun coframe := spinLorentzMatrix groupElement⁻¹ * coframe
  left_inv coframe := by
    change spinLorentzMatrix groupElement⁻¹ *
      (spinLorentzMatrix groupElement * coframe) = coframe
    rw [← Matrix.mul_assoc, ← map_mul spinLorentzMatrix]
    simp
  right_inv coframe := by
    change spinLorentzMatrix groupElement *
      (spinLorentzMatrix groupElement⁻¹ * coframe) = coframe
    rw [← Matrix.mul_assoc, ← map_mul spinLorentzMatrix]
    simp
  map_add' first second := Matrix.mul_add _ _ _
  map_smul' scalar coframe := Matrix.mul_smul _ _ _

/-- Genuine multiplicative Spin action on the existing coframe carrier. -/
def spinLorentzCoframeRepresentation :
    SpinPlus13 →* (LorentzianCoframe ≃ₗ[ℝ] LorentzianCoframe) where
  toFun := spinLorentzCoframeLinearEquiv
  map_one' := by
    apply LinearEquiv.ext
    intro coframe
    change spinLorentzMatrix 1 * coframe = coframe
    simp
  map_mul' first second := by
    apply LinearEquiv.ext
    intro coframe
    change spinLorentzMatrix (first * second) * coframe =
      spinLorentzMatrix first * (spinLorentzMatrix second * coframe)
    rw [map_mul spinLorentzMatrix, Matrix.mul_assoc]

/-! ## Finite-dimensional continuous upgrade -/

/-- Finite dimensionality makes each primal coframe equivalence continuous;
no norm, coefficient, or source datum is added. -/
def spinLorentzCoframeContinuousLinearEquiv (groupElement : SpinPlus13) :
    LorentzianCoframe ≃L[ℝ] LorentzianCoframe :=
  (spinLorentzCoframeLinearEquiv groupElement).toContinuousLinearEquiv

@[simp] theorem spinLorentzCoframeContinuousLinearEquiv_apply
    (groupElement : SpinPlus13) (coframe : LorentzianCoframe) :
    spinLorentzCoframeContinuousLinearEquiv groupElement coframe =
      spinLorentzMatrix groupElement * coframe :=
  rfl

@[simp] theorem spinLorentzCoframeContinuousLinearEquiv_symm_apply
    (groupElement : SpinPlus13) (coframe : LorentzianCoframe) :
    (spinLorentzCoframeContinuousLinearEquiv groupElement).symm coframe =
      spinLorentzMatrix groupElement⁻¹ * coframe :=
  rfl

/-- Continuous version of the same genuine Spin representation. -/
def spinLorentzCoframeContinuousRepresentation :
    SpinPlus13 →* (LorentzianCoframe ≃L[ℝ] LorentzianCoframe) where
  toFun := spinLorentzCoframeContinuousLinearEquiv
  map_one' := by
    apply DFunLike.ext _ _
    intro coframe
    change spinLorentzMatrix 1 * coframe = coframe
    simp
  map_mul' first second := by
    apply DFunLike.ext _ _
    intro coframe
    change spinLorentzMatrix (first * second) * coframe =
      spinLorentzMatrix first * (spinLorentzMatrix second * coframe)
    rw [map_mul spinLorentzMatrix, Matrix.mul_assoc]

/-! ## Continuous-dual contragredient representation -/

/-- Actual continuous dual carrying the coframe residual channel. -/
abbrev CoframeContinuousDual := LorentzianCoframe →L[ℝ] ℝ

/-- Inverse-precomposition linear equivalence on the carrier of continuous
residuals.  Both output maps are continuous because they are compositions of
continuous linear maps. -/
def spinLorentzCoframeDualLinearEquiv
    (groupElement : SpinPlus13) :
    CoframeContinuousDual ≃ₗ[ℝ] CoframeContinuousDual where
  toFun residual := residual.comp
    (spinLorentzCoframeContinuousLinearEquiv groupElement⁻¹).toContinuousLinearMap
  invFun residual := residual.comp
    (spinLorentzCoframeContinuousLinearEquiv groupElement).toContinuousLinearMap
  left_inv residual := by
    apply ContinuousLinearMap.ext
    intro variation
    change residual
      (spinLorentzMatrix groupElement⁻¹ *
        (spinLorentzMatrix groupElement * variation)) = residual variation
    rw [← Matrix.mul_assoc, ← map_mul spinLorentzMatrix]
    simp
  right_inv residual := by
    apply ContinuousLinearMap.ext
    intro variation
    change residual
      (spinLorentzMatrix groupElement *
        (spinLorentzMatrix groupElement⁻¹ * variation)) = residual variation
    rw [← Matrix.mul_assoc, ← map_mul spinLorentzMatrix]
    simp
  map_add' first second := by
    apply ContinuousLinearMap.ext
    intro variation
    rfl
  map_smul' scalar residual := by
    apply ContinuousLinearMap.ext
    intro variation
    rfl

@[simp] theorem spinLorentzCoframeDualLinearEquiv_apply
    (groupElement : SpinPlus13) (residual : CoframeContinuousDual)
    (variation : LorentzianCoframe) :
    spinLorentzCoframeDualLinearEquiv groupElement residual variation =
      residual
        (spinLorentzCoframeContinuousRepresentation groupElement⁻¹ variation) :=
  rfl

/-- The inverse-precomposition convention is a genuine left representation
on the continuous-dual carrier. -/
def spinLorentzCoframeDualLinearRepresentation :
    SpinPlus13 →* (CoframeContinuousDual ≃ₗ[ℝ] CoframeContinuousDual) where
  toFun := spinLorentzCoframeDualLinearEquiv
  map_one' := by
    apply LinearEquiv.ext
    intro residual
    apply ContinuousLinearMap.ext
    intro variation
    change residual (spinLorentzMatrix (1 : SpinPlus13)⁻¹ * variation) =
      residual variation
    simp
  map_mul' first second := by
    apply LinearEquiv.ext
    intro residual
    apply ContinuousLinearMap.ext
    intro variation
    change residual (spinLorentzMatrix (first * second)⁻¹ * variation) =
      residual
        (spinLorentzMatrix second⁻¹ *
          (spinLorentzMatrix first⁻¹ * variation))
    rw [mul_inv_rev, map_mul spinLorentzMatrix, Matrix.mul_assoc]

/-- The continuous-dual carrier is finite dimensional, so the actual dual
linear equivalence has a canonical continuous upgrade. -/
def spinLorentzCoframeDualContinuousLinearEquiv
    (groupElement : SpinPlus13) :
    CoframeContinuousDual ≃L[ℝ] CoframeContinuousDual :=
  (spinLorentzCoframeDualLinearEquiv groupElement).toContinuousLinearEquiv

/-- Contragredient representation on continuous coframe residuals. -/
def spinLorentzCoframeDualRepresentation :
    SpinPlus13 →* (CoframeContinuousDual ≃L[ℝ] CoframeContinuousDual) where
  toFun := spinLorentzCoframeDualContinuousLinearEquiv
  map_one' := by
    apply DFunLike.ext _ _
    intro residual
    exact LinearEquiv.congr_fun
      (map_one spinLorentzCoframeDualLinearRepresentation) residual
  map_mul' first second := by
    apply DFunLike.ext _ _
    intro residual
    exact LinearEquiv.congr_fun
      (map_mul spinLorentzCoframeDualLinearRepresentation first second) residual

/-- Explicit inverse-precomposition readout for the dual action. -/
@[simp] theorem spinLorentzCoframeDualRepresentation_apply
    (groupElement : SpinPlus13) (residual : CoframeContinuousDual)
    (variation : LorentzianCoframe) :
    spinLorentzCoframeDualRepresentation groupElement residual variation =
      residual
        (spinLorentzCoframeContinuousRepresentation groupElement⁻¹ variation) := by
  change residual (spinLorentzMatrix groupElement⁻¹ * variation) =
    residual (spinLorentzMatrix groupElement⁻¹ * variation)
  rfl

/-- Primal/dual pairing is invariant under the jointly transported pair. -/
@[simp] theorem spinLorentzCoframeDual_evaluation_invariant
    (groupElement : SpinPlus13) (residual : CoframeContinuousDual)
    (variation : LorentzianCoframe) :
    spinLorentzCoframeDualRepresentation groupElement residual
        (spinLorentzCoframeContinuousRepresentation groupElement variation) =
      residual variation := by
  rw [spinLorentzCoframeDualRepresentation_apply]
  change residual
      (spinLorentzMatrix groupElement⁻¹ *
        (spinLorentzMatrix groupElement * variation)) = residual variation
  rw [← Matrix.mul_assoc, ← map_mul spinLorentzMatrix]
  simp

/-- Dual transport neither creates nor erases the zero residual. -/
theorem spinLorentzCoframeDual_eq_zero_iff
    (groupElement : SpinPlus13) (residual : CoframeContinuousDual) :
    spinLorentzCoframeDualRepresentation groupElement residual = 0 ↔
      residual = 0 := by
  constructor
  · intro transportedZero
    apply (spinLorentzCoframeDualRepresentation groupElement).injective
    simpa using transportedZero
  · rintro rfl
    exact map_zero _

/-- In particular, continuous-dual residual transport is faithful. -/
theorem spinLorentzCoframeDual_injective (groupElement : SpinPlus13) :
    Function.Injective (spinLorentzCoframeDualRepresentation groupElement) :=
  (spinLorentzCoframeDualRepresentation groupElement).injective

/-! ## Kernel and nontriviality regressions -/

/-- The central sign has identity matrix because the existing Spin cover
identifies it with the identity Lorentz transformation. -/
theorem spinCentralSign_lorentzMatrix_eq_one :
    spinLorentzMatrix spinCentralSign = 1 := by
  have coverEquality : spinLorentzCover spinCentralSign = spinLorentzCover 1 :=
    spinLorentzCover_identifies_central_sign
  calc
    spinLorentzMatrix spinCentralSign = spinLorentzMatrix 1 := by
      change (LinearMap.toMatrixAlgEquiv basePointCoordinateBasis)
          (spinLorentzCover spinCentralSign).toLinearMap =
        (LinearMap.toMatrixAlgEquiv basePointCoordinateBasis)
          (spinLorentzCover 1).toLinearMap
      rw [coverEquality]
    _ = 1 := map_one spinLorentzMatrix

/-- Expected central-sign kernel on primal coframes. -/
theorem spinCentralSign_coframeRepresentation_eq_one :
    spinLorentzCoframeRepresentation spinCentralSign = 1 := by
  apply LinearEquiv.ext
  intro coframe
  change spinLorentzMatrix spinCentralSign * coframe = coframe
  rw [spinCentralSign_lorentzMatrix_eq_one]
  simp

/-- Expected central-sign kernel survives the continuous upgrade. -/
theorem spinCentralSign_coframeContinuousRepresentation_eq_one :
    spinLorentzCoframeContinuousRepresentation spinCentralSign = 1 := by
  apply DFunLike.ext _ _
  intro coframe
  change spinLorentzMatrix spinCentralSign * coframe = coframe
  rw [spinCentralSign_lorentzMatrix_eq_one]
  simp

/-- The continuous-dual action has the same central-sign kernel. -/
theorem spinCentralSign_coframeDualRepresentation_eq_one :
    spinLorentzCoframeDualRepresentation spinCentralSign = 1 := by
  have primalEquality :
      spinLorentzCoframeContinuousLinearEquiv spinCentralSign = 1 :=
    spinCentralSign_coframeContinuousRepresentation_eq_one
  apply DFunLike.ext _ _
  intro residual
  apply ContinuousLinearMap.ext
  intro variation
  change residual
      ((spinLorentzCoframeContinuousLinearEquiv spinCentralSign).symm
        variation) = residual variation
  rw [primalEquality]
  rfl

/-- Concrete primal coordinate witnessing the already generated dilation. -/
theorem spinDilation_unitCoframe_time_component :
    spinLorentzCoframeRepresentation spinDilation
        (1 : LorentzianCoframe) 0 0 = 17 / 8 := by
  change (spinLorentzMatrix spinDilation * (1 : LorentzianCoframe)) 0 0 =
    17 / 8
  rw [Matrix.mul_one, spinLorentzMatrix_apply]
  simpa [stageNineUnitPoint] using spinDilation_lorentz_timeCoordinate

/-- Negative regression: the primal coframe representation is not trivial. -/
theorem spinDilation_coframeRepresentation_ne_one :
    spinLorentzCoframeRepresentation spinDilation ≠ 1 := by
  intro representationIsTrivial
  have componentEquality := congrArg
    (fun action : LorentzianCoframe ≃ₗ[ℝ] LorentzianCoframe =>
      action (1 : LorentzianCoframe) 0 0)
    representationIsTrivial
  rw [spinDilation_unitCoframe_time_component] at componentEquality
  norm_num [Matrix.one_apply] at componentEquality

/-! ## No-free-normalization regression for decoder intertwiners -/

/-- A possible continuous decoder from a coframe residual to a coframe.
Merely naming this type does not supply an element of it. -/
abbrev CoframeDecoder := CoframeContinuousDual →L[ℝ] LorentzianCoframe

/-- Spin equivariance of a candidate decoder.  This is a relation on a
supplied map, not a producer or a normalization rule. -/
def SpinEquivariantCoframeDecoder (decoder : CoframeDecoder) : Prop :=
  ∀ groupElement residual,
    decoder (spinLorentzCoframeDualRepresentation groupElement residual) =
      spinLorentzCoframeContinuousRepresentation groupElement
        (decoder residual)

/-- Scalar multiplication by two preserves the intertwining relation.  The
scalar acts in the vector space of decoders; it is not a Lorentz action. -/
theorem spinEquivariantCoframeDecoder_two_smul
    {decoder : CoframeDecoder}
    (decoderEquivariant : SpinEquivariantCoframeDecoder decoder) :
    SpinEquivariantCoframeDecoder ((2 : ℝ) • decoder) := by
  intro groupElement residual
  change (2 : ℝ) •
      decoder (spinLorentzCoframeDualRepresentation groupElement residual) =
    spinLorentzCoframeContinuousRepresentation groupElement
      ((2 : ℝ) • decoder residual)
  rw [map_smul]
  exact congrArg (fun coframe => (2 : ℝ) • coframe)
    (decoderEquivariant groupElement residual)

/-- A nonzero decoder cannot equal twice itself. -/
theorem two_smul_coframeDecoder_ne_self
    {decoder : CoframeDecoder} (decoderNonzero : decoder ≠ 0) :
    (2 : ℝ) • decoder ≠ decoder := by
  intro doubledEqualsSelf
  apply decoderNonzero
  apply ContinuousLinearMap.ext
  intro residual
  funext row column
  have componentEquality := congrArg
    (fun candidate : CoframeDecoder => candidate residual row column)
    doubledEqualsSelf
  change (2 : ℝ) * decoder residual row column =
    decoder residual row column at componentEquality
  change decoder residual row column = 0
  linarith

/-- There cannot be a unique nonzero Spin-equivariant decoder: if one were
supplied, twice that decoder would be a distinct nonzero intertwiner.  This
does not assert existence and is not a no-go for the full gravity shell. -/
theorem no_unique_nonzero_spinEquivariantCoframeDecoder :
    ¬ ∃! decoder : CoframeDecoder,
      decoder ≠ 0 ∧ SpinEquivariantCoframeDecoder decoder := by
  rintro ⟨decoder, ⟨decoderNonzero, decoderEquivariant⟩, uniqueDecoder⟩
  have doubledNonzero : (2 : ℝ) • decoder ≠ 0 := by
    intro doubledZero
    apply decoderNonzero
    have halfDoubledZero := congrArg
      (fun candidate : CoframeDecoder => (1 / 2 : ℝ) • candidate)
      doubledZero
    norm_num [smul_smul] at halfDoubledZero
    exact halfDoubledZero
  have doubledEquivariant :
      SpinEquivariantCoframeDecoder ((2 : ℝ) • decoder) :=
    spinEquivariantCoframeDecoder_two_smul decoderEquivariant
  have doubledEqualsSelf : (2 : ℝ) • decoder = decoder :=
    uniqueDecoder ((2 : ℝ) • decoder)
      ⟨doubledNonzero, doubledEquivariant⟩
  exact two_smul_coframeDecoder_ne_self decoderNonzero doubledEqualsSelf

end

