import H0mework.Physics.MotherProgrammesFormationDiscrete.History
import Mathlib.Data.Rat.Cast.CharZero

set_option autoImplicit false

namespace SaturationMonoid.PhysicsCore.Stage10.SourceUniqueness.RationalSourceFormation

open AffineRelaxation StageNineEnrichedProofFreeSource
open MotherFamilyOccurrence StageEightDiscreteFormation

noncomputable section

def sourceTrace (source : SmoothUnifiedSource) : ℝ :=
  linearResidualTrace source.continuousKeep (source.stageEight.physicalPhaseAmplitude : ℝ)

theorem source_trace_eq (source : SmoothUnifiedSource) :
    sourceTrace source = source.legacy.sigma * (source.stageEight.physicalPhaseAmplitude : ℝ) := by
  simpa only [sourceTrace, SmoothUnifiedSource.continuousKeep, smul_eq_mul] using
    residualTransportCore_scalar_trace source.legacy.sigma (source.stageEight.physicalPhaseAmplitude : ℝ)

def rationalTrace (source : SmoothUnifiedSource) : ℚ :=
  (source.stageEight.physicalPhaseAmplitude : ℚ) / (source.stageEight.sigmaSeed + 2 : ℚ)

theorem rational_trace_cast (source : SmoothUnifiedSource) :
    (rationalTrace source : ℝ) = sourceTrace source := by
  rw [source_trace_eq]
  unfold rationalTrace
  push_cast
  change (source.stageEight.physicalPhaseAmplitude : ℝ) / (source.stageEight.sigmaSeed + 2 : ℝ) =
    (1 / (source.stageEight.sigmaSeed + 2 : ℝ)) * (source.stageEight.physicalPhaseAmplitude : ℝ)
  ring

def traceAtVisit (visit : MotherVisit) : ℝ := sourceTrace (sourceAtVisit visit)

/-- The numerator and denominator are read from one auxiliary source
generated by the original finite instruction program. -/
theorem every_rational_generated (value : ℚ) :
    ∃ code, traceAtVisit (Stage9C.Revision.SpinPair.visit (10 + code)) = (value : ℝ) := by
  let integers : IntegerSlot → ℤ := Pi.single (.inr (Sum.inl .t1)) (2 * value.num)
  let material : Material := ⟨integers, 0, 2 * value.den - 2, 0⟩
  have phase : (toSource material).stageEight.physicalPhaseAmplitude = 2 * value.num := by
    simp [material, integers, toSource, StageEightProofFreeSource.Source.physicalPhaseAmplitude,
      Pi.single_apply]
  have denominator : ((2 * value.den - 2 : ℕ) : ℝ) + 2 = 2 * (value.den : ℝ) := by
    have positive := value.den_pos
    have natural : 2 * value.den - 2 + 2 = 2 * value.den := by omega
    exact_mod_cast natural
  have generated : sourceTrace (toSource material) = (value : ℝ) := by
    rw [source_trace_eq, phase]
    change (1 / (((2 * value.den - 2 : ℕ) : ℝ) + 2)) * ((2 * value.num : ℤ) : ℝ) = _
    rw [denominator, Rat.cast_def]
    push_cast
    field_simp
  obtain ⟨code, readback⟩ := every_material_at_code material
  refine ⟨code, ?_⟩
  rw [traceAtVisit, sourceAtVisit, code_at, readback]
  exact generated

end
end SaturationMonoid.PhysicsCore.Stage10.SourceUniqueness.RationalSourceFormation
