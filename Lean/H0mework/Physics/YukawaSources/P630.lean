import H0mework.Physics.MixingSources.P629

/-!
# Proposition 630: Yukawa coefficients from the unified QCD/Poincare axis

P627 routed the finite `alpha_s` producer through one shared axis

`axis = b0_QCD + PoincareSlots_4D = 7 + 3 = 10`.

P629 routed the CKM/Jarlskog depth sum through the same axis by reconstructing
the visible gauge card `9` and electromagnetic denominator `137`.

This file pushes the Yukawa depth producer through that same finite axis.  It
defines the rational Yukawa stencil whose `alpha` and visible-gauge cards are
read from P627, proves that this stencil is the canonical P584/P615 stencil,
and then inherits the selected `3 x 3` depth grid, mass-order depth list, and
Jarlskog depth sum.

Boundary: this closes a finite-cardinality presentation gap.  It still does
not construct the continuous SU(7)-breaking / consolidation-order dynamics
that should eventually produce this finite axis and coefficient law.
-/

noncomputable section

namespace SaturationMonoid
namespace StandardModelConstraint

/-! ## Axis-derived rational Yukawa stencil -/

/-- The Yukawa biquadratic stencil with its electromagnetic denominator and
visible-gauge card read from the same QCD/Poincare axis used by P627/P629.

The remaining cards are the already-certified finite SU(7), seven-facet, and
information/matter support cards. -/
def qcdPoincareUnifiedAxisYukawaRationalStencil :
    RationalYukawaBiquadraticStencil where
  center :=
    5 * alphaStrongQCDPoincareStructuralAlphaEMDenominator - 3
  generationSlope :=
    2 * alphaStrongQCDPoincareStructuralAlphaEMDenominator - 7
  sectorSlope := su7GaugeFreedomDimension ℚ - 1
  generationCurvature :=
    -((alphaStrongQCDPoincareStructuralAlphaEMDenominator + 1) / 2)
  sectorCurvature :=
    -(alphaStrongQCDPoincareStructuralAlphaEMDenominator +
      alphaStrongQCDPoincareVisibleGaugeFromAxis)
  mixedTwist := -(su7GaugeFreedomDimension ℚ + 2 * (7 : ℚ))
  generationCurvatureSector := su7GaugeFreedomDimension ℚ + 4
  generationSectorCurvature :=
    (alphaStrongQCDPoincareVisibleGaugeFromAxis + 1) ^ (2 : Nat)
  bicurvature :=
    sevenFacetInformationStateCount ℚ -
      informationMatterSupportCardFromComponentCarrierZ

/-- THEOREM 1: the unified-axis Yukawa stencil is the canonical P584/P615
stencil. -/
theorem qcdPoincareUnifiedAxisYukawaRationalStencil_eq_canonical :
    qcdPoincareUnifiedAxisYukawaRationalStencil =
      RationalYukawaBiquadraticStencil.canonical := by
  ext <;>
    norm_num [qcdPoincareUnifiedAxisYukawaRationalStencil,
      RationalYukawaBiquadraticStencil.canonical,
      alphaStrongQCDPoincareStructuralAlphaEMDenominator_eq_137,
      alphaStrongQCDPoincareVisibleGaugeFromAxis_eq_nine,
      yukawaDepthStencilCenter, yukawaDepthStencilGenerationSlope,
      yukawaDepthStencilSectorSlope, yukawaDepthStencilGenerationCurvature,
      yukawaDepthStencilSectorCurvature, yukawaDepthStencilMixedTwist,
      yukawaDepthStencilGenerationCurvatureSector,
      yukawaDepthStencilGenerationSectorCurvature,
      yukawaDepthStencilBicurvature, visibleGaugeCarrierCardZ,
      canonicalInformationMatterSupportCardZ, alphaEMIntegerDenominator,
      su7GaugeFreedomDimension, sevenFacetInformationStateCount,
      informationMatterSupportCardFromComponentCarrierZ_eq_seventeen]

/-- THEOREM 2: the unified-axis Yukawa stencil lies on the P615 carrier
coefficient surface. -/
theorem qcdPoincareUnifiedAxisYukawaRationalStencil_surface :
    RationalStencilCarrierCoefficientSurface
      qcdPoincareUnifiedAxisYukawaRationalStencil := by
  rw [qcdPoincareUnifiedAxisYukawaRationalStencil_eq_canonical]
  exact canonical_rationalStencilCarrierCoefficientSurface

/-! ## Forced grid, depth list, and Jarlskog sum -/

/-- The Yukawa depth grid generated by the unified-axis stencil. -/
def qcdPoincareUnifiedAxisYukawaDepthGrid : RationalYukawaDepthGrid :=
  gridOfStencil qcdPoincareUnifiedAxisYukawaRationalStencil

/-- THEOREM 3: the unified-axis stencil generates the selected Yukawa depth
grid. -/
theorem qcdPoincareUnifiedAxisYukawaDepthGrid_eq_selected :
    qcdPoincareUnifiedAxisYukawaDepthGrid = selectedYukawaDepthGrid := by
  rw [qcdPoincareUnifiedAxisYukawaDepthGrid,
    qcdPoincareUnifiedAxisYukawaRationalStencil_eq_canonical,
    ← selectedGrid_eq_gridOf_canonical]

/-- THEOREM 4: the unified-axis stencil forces the documented nine-depth
mass-order list. -/
theorem qcdPoincareUnifiedAxisYukawaDepthGrid_massOrder_eq :
    rationalGridMassOrder qcdPoincareUnifiedAxisYukawaDepthGrid =
      [50, 346, 372, 489, 583, 682, 880, 908, 982] := by
  rw [qcdPoincareUnifiedAxisYukawaDepthGrid_eq_selected]
  rfl

/-- THEOREM 5: the unified-axis stencil forces the CKM/Jarlskog depth sum
`386`. -/
theorem qcdPoincareUnifiedAxisYukawaDepthGrid_jarlskogDepthSum_eq_386 :
    ckmJarlskogDepthSumFromRationalGrid
        qcdPoincareUnifiedAxisYukawaDepthGrid =
      (386 : ℚ) := by
  rw [qcdPoincareUnifiedAxisYukawaDepthGrid_eq_selected]
  norm_num [ckmJarlskogDepthSumFromRationalGrid, rationalGridDepthOf,
    selectedYukawaDepthGrid, selectedYukawaIntegerDepthZ,
    selectedYukawaIntegerDepth, yukawaMatrixCoordinates,
    yukawaMatrixParameter]

/-! ## Bundled receipt -/

/-- Compact receipt: the same QCD/Poincare axis that drives the finite
`alpha_s` residual and the CKM sector gap also supplies the Yukawa coefficient
surface, hence the selected nine-depth grid. -/
structure QCDPoincareUnifiedAxisYukawaProducerReceipt where
  axis :
    alphaStrongQCDPoincareResolutionAxis = (10 : ℚ)
  visible_gauge_from_axis :
    alphaStrongQCDPoincareVisibleGaugeFromAxis = (9 : ℚ)
  alpha_em_denominator :
    alphaStrongQCDPoincareStructuralAlphaEMDenominator = (137 : ℚ)
  stencil_eq_canonical :
    qcdPoincareUnifiedAxisYukawaRationalStencil =
      RationalYukawaBiquadraticStencil.canonical
  carrier_surface :
    RationalStencilCarrierCoefficientSurface
      qcdPoincareUnifiedAxisYukawaRationalStencil
  grid :
    qcdPoincareUnifiedAxisYukawaDepthGrid = selectedYukawaDepthGrid
  mass_order :
    rationalGridMassOrder qcdPoincareUnifiedAxisYukawaDepthGrid =
      [50, 346, 372, 489, 583, 682, 880, 908, 982]
  jarlskog :
    ckmJarlskogDepthSumFromRationalGrid
        qcdPoincareUnifiedAxisYukawaDepthGrid =
      (386 : ℚ)

/-- THEOREM 6: bundled unified-axis Yukawa producer receipt. -/
theorem qcdPoincareUnifiedAxisYukawaProducerReceipt :
    QCDPoincareUnifiedAxisYukawaProducerReceipt where
  axis := alphaStrongQCDPoincareResolutionAxis_eq_ten
  visible_gauge_from_axis :=
    alphaStrongQCDPoincareVisibleGaugeFromAxis_eq_nine
  alpha_em_denominator :=
    alphaStrongQCDPoincareStructuralAlphaEMDenominator_eq_137
  stencil_eq_canonical :=
    qcdPoincareUnifiedAxisYukawaRationalStencil_eq_canonical
  carrier_surface :=
    qcdPoincareUnifiedAxisYukawaRationalStencil_surface
  grid := qcdPoincareUnifiedAxisYukawaDepthGrid_eq_selected
  mass_order := qcdPoincareUnifiedAxisYukawaDepthGrid_massOrder_eq
  jarlskog :=
    qcdPoincareUnifiedAxisYukawaDepthGrid_jarlskogDepthSum_eq_386

end StandardModelConstraint
end SaturationMonoid
