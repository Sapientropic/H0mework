import H0mework.Physics.MixingSources.P615
import H0mework.Physics.SourceForms.P773

/-!
# Proposition 774: Yukawa-depth producer source normal form

P772/P773 close the accepted input surface against the selected Yukawa/CKM
table.  This file pushes that leg one layer upstream and packages the actual
finite generator chain:

* carrier-card coefficient vector;
* Poincare generation axis crossed with the interaction-sector axis;
* unique rational `3 x 3` biquadratic stencil;
* selected nine depths;
* CKM/Jarlskog factor and depth normal form.

This is the no-choice source normal form for the current finite Yukawa-depth
producer.  It says the nine depths are not an independent table at the accepted
surface: they are the image of the unique carrier coefficient stencil.
-/

noncomputable section

namespace SaturationMonoid
namespace StandardModelConstraint

/-! ## Focused normal-form projections -/

/-- THEOREM 1: the carrier-sourced coefficient vector is the canonical
rational stencil. -/
theorem yukawaDepthProducerNormalForm_carrierCoefficients :
    rationalStencilOfCoefficientVector
        carrierSourcedYukawaDepthStencilCoefficientVector =
      RationalYukawaBiquadraticStencil.canonical :=
  rationalStencilOf_carrierSourcedCoefficients_eq_canonical

/-- THEOREM 2: the carrier coefficient surface is exactly the canonical
rational stencil. -/
theorem yukawaDepthProducerNormalForm_surface_iff_canonical
    (C : RationalYukawaBiquadraticStencil) :
    RationalStencilCarrierCoefficientSurface C ↔
      C = RationalYukawaBiquadraticStencil.canonical :=
  rationalStencilCarrierCoefficientSurface_iff_eq_canonical C

/-- THEOREM 3: the canonical stencil is the unique rational biquadratic
stencil for the selected `3 x 3` depth grid. -/
theorem yukawaDepthProducerNormalForm_unique_stencil :
    ∃! C : RationalYukawaBiquadraticStencil,
      ∀ g s,
        C.eval g s =
          (selectedYukawaIntegerDepthZ (yukawaMatrixParameter g s) : ℚ) :=
  RationalYukawaBiquadraticStencil.canonical_unique_for_selectedDepth

/-- THEOREM 4: the Poincare/sector sourced stencil is the carrier-card
stencil at every generation-sector cell. -/
theorem yukawaDepthProducerNormalForm_poincareSector_eq_stencil
    (g : StandardModelFermionGeneration)
    (s : YukawaInteractionSector) :
    poincareSectorSourcedYukawaDepthStencilAt g s =
      yukawaDepthStencilAt g s :=
  poincareSectorSourcedYukawaDepthStencilAt_eq_stencil g s

/-- THEOREM 5: the carrier coefficient vector generates the selected
rational depth grid. -/
theorem yukawaDepthProducerNormalForm_grid_eq_selected :
    carrierCoefficientYukawaDepthGrid = selectedYukawaDepthGrid :=
  carrierCoefficientYukawaDepthGrid_eq_selected

/-- THEOREM 6: the carrier coefficient vector forces the mass-order list. -/
theorem yukawaDepthProducerNormalForm_massOrder :
    rationalGridMassOrder carrierCoefficientYukawaDepthGrid =
      [50, 346, 372, 489, 583, 682, 880, 908, 982] :=
  carrierCoefficientYukawaDepthGrid_massOrder_eq

/-- THEOREM 7: the carrier coefficient vector forces CKM/Jarlskog depth `386`.
-/
theorem yukawaDepthProducerNormalForm_jarlskogDepth :
    ckmJarlskogDepthSumFromRationalGrid
        carrierCoefficientYukawaDepthGrid =
      (386 : ℚ) :=
  carrierCoefficientYukawaDepthGrid_jarlskogDepthSum_eq_386

/-- THEOREM 8: every full-beta-vector accepted depth table is exactly the
selected table. -/
theorem yukawaDepthProducerNormalForm_fullBetaVector_iff_selected
    (T : YukawaDepthTableCandidate) :
    FullBetaVectorYukawaDepthProducerSurface T ↔
      T = selectedYukawaDepthTableCandidate :=
  fullBetaVectorYukawaDepthProducerSurface_iff_selected T

/-- THEOREM 9: every accepted input surface has the table generated by the
carrier coefficient stencil. -/
theorem inputSurface_yukawaTable_eq_carrierNormalForm
    (C : FullBetaVectorInputThreeNailCandidate)
    (hC : FullBetaVectorInputThreeNailProducerSurface C) :
    C.2 = selectedYukawaDepthTableCandidate ∧
      carrierCoefficientYukawaDepthGrid = selectedYukawaDepthGrid ∧
        rationalGridMassOrder carrierCoefficientYukawaDepthGrid =
          [50, 346, 372, 489, 583, 682, 880, 908, 982] :=
  ⟨inputSurface_yukawaTable_eq_selected C hC,
    yukawaDepthProducerNormalForm_grid_eq_selected,
    yukawaDepthProducerNormalForm_massOrder⟩

/-- THEOREM 10: every accepted input surface inherits the CKM factor quartet
and exact depth sum from the same normal form. -/
theorem inputSurface_ckm_eq_yukawaDepthProducerNormalForm
    (C : FullBetaVectorInputThreeNailCandidate)
    (hC : FullBetaVectorInputThreeNailProducerSurface C) :
    (CKMJarlskogFactor.depthContribution C.2 .V_us = (-226 : Int) ∧
        CKMJarlskogFactor.depthContribution C.2 .V_cb = (-143 : Int) ∧
          CKMJarlskogFactor.depthContribution C.2 .V_ub_conj =
            (562 : Int) ∧
            CKMJarlskogFactor.depthContribution C.2 .V_cs_conj =
              (193 : Int)) ∧
      ckmJarlskogFourProductDepthSum C.2 = (ckmCPDepthSum : Int) ∧
        ckmDepthSum_fromYukawaDepthTable C.2 = (ckmCPDepthSum : Int) :=
  ⟨inputSurface_ckmFactors_forced C hC,
    inputSurfaceFiniteNumerical_ckmDepthSum_eq_386_int C hC,
    fullBetaVectorInputThreeNailSurfaceCertificate.ckm_table_sum C hC⟩

/-! ## Bundled certificate -/

/-- One source-normal-form certificate for the finite Yukawa/CKM producer leg.
-/
structure YukawaDepthProducerSourceNormalFormCertificate : Prop where
  carrier_stencil :
    Nonempty YukawaDepthCarrierStencilReceipt
  interpolation_uniqueness :
    Nonempty YukawaDepthStencilUniquenessReceipt
  poincare_sector_sourcing :
    Nonempty PoincareSectorSourcedYukawaDepthReceipt
  carrier_coefficient_no_choice :
    Nonempty YukawaCarrierCoefficientNoChoiceReceipt
  full_beta_vector_depth_producer :
    Nonempty FullBetaVectorYukawaDepthProducerCertificate
  input_surface_yukawa_ckm :
    InputSurfaceYukawaCKMSourceDecompositionCertificate
  carrier_coefficients :
    rationalStencilOfCoefficientVector
        carrierSourcedYukawaDepthStencilCoefficientVector =
      RationalYukawaBiquadraticStencil.canonical
  carrier_surface_iff_canonical :
    ∀ C : RationalYukawaBiquadraticStencil,
      RationalStencilCarrierCoefficientSurface C ↔
        C = RationalYukawaBiquadraticStencil.canonical
  unique_stencil :
    ∃! C : RationalYukawaBiquadraticStencil,
      ∀ g s,
        C.eval g s =
          (selectedYukawaIntegerDepthZ (yukawaMatrixParameter g s) : ℚ)
  poincare_sector_eq_stencil :
    ∀ g s,
      poincareSectorSourcedYukawaDepthStencilAt g s =
        yukawaDepthStencilAt g s
  carrier_grid_eq_selected :
    carrierCoefficientYukawaDepthGrid = selectedYukawaDepthGrid
  carrier_mass_order :
    rationalGridMassOrder carrierCoefficientYukawaDepthGrid =
      [50, 346, 372, 489, 583, 682, 880, 908, 982]
  carrier_jarlskog_depth :
    ckmJarlskogDepthSumFromRationalGrid
        carrierCoefficientYukawaDepthGrid =
      (386 : ℚ)
  full_beta_vector_surface_iff_selected :
    ∀ T : YukawaDepthTableCandidate,
      FullBetaVectorYukawaDepthProducerSurface T ↔
        T = selectedYukawaDepthTableCandidate
  input_surface_table_from_carrier :
    ∀ C : FullBetaVectorInputThreeNailCandidate,
      FullBetaVectorInputThreeNailProducerSurface C ->
        C.2 = selectedYukawaDepthTableCandidate ∧
          carrierCoefficientYukawaDepthGrid = selectedYukawaDepthGrid ∧
            rationalGridMassOrder carrierCoefficientYukawaDepthGrid =
              [50, 346, 372, 489, 583, 682, 880, 908, 982]
  input_surface_ckm :
    ∀ C : FullBetaVectorInputThreeNailCandidate,
      FullBetaVectorInputThreeNailProducerSurface C ->
        (CKMJarlskogFactor.depthContribution C.2 .V_us = (-226 : Int) ∧
            CKMJarlskogFactor.depthContribution C.2 .V_cb = (-143 : Int) ∧
              CKMJarlskogFactor.depthContribution C.2 .V_ub_conj =
                (562 : Int) ∧
                CKMJarlskogFactor.depthContribution C.2 .V_cs_conj =
                  (193 : Int)) ∧
          ckmJarlskogFourProductDepthSum C.2 = (ckmCPDepthSum : Int) ∧
            ckmDepthSum_fromYukawaDepthTable C.2 = (ckmCPDepthSum : Int)

/-- THEOREM 11: finite Yukawa-depth producer source normal-form certificate. -/
theorem yukawaDepthProducerSourceNormalFormCertificate :
    YukawaDepthProducerSourceNormalFormCertificate where
  carrier_stencil := ⟨yukawaDepthCarrierStencilReceipt⟩
  interpolation_uniqueness := ⟨yukawaDepthStencilUniquenessReceipt⟩
  poincare_sector_sourcing := ⟨poincareSectorSourcedYukawaDepthReceipt⟩
  carrier_coefficient_no_choice := ⟨yukawaCarrierCoefficientNoChoiceReceipt⟩
  full_beta_vector_depth_producer := ⟨fullBetaVectorYukawaDepthProducerCertificate⟩
  input_surface_yukawa_ckm :=
    inputSurfaceYukawaCKMSourceDecompositionCertificate
  carrier_coefficients :=
    yukawaDepthProducerNormalForm_carrierCoefficients
  carrier_surface_iff_canonical :=
    yukawaDepthProducerNormalForm_surface_iff_canonical
  unique_stencil :=
    yukawaDepthProducerNormalForm_unique_stencil
  poincare_sector_eq_stencil :=
    yukawaDepthProducerNormalForm_poincareSector_eq_stencil
  carrier_grid_eq_selected :=
    yukawaDepthProducerNormalForm_grid_eq_selected
  carrier_mass_order :=
    yukawaDepthProducerNormalForm_massOrder
  carrier_jarlskog_depth :=
    yukawaDepthProducerNormalForm_jarlskogDepth
  full_beta_vector_surface_iff_selected :=
    yukawaDepthProducerNormalForm_fullBetaVector_iff_selected
  input_surface_table_from_carrier :=
    inputSurface_yukawaTable_eq_carrierNormalForm
  input_surface_ckm :=
    inputSurface_ckm_eq_yukawaDepthProducerNormalForm

end StandardModelConstraint
end SaturationMonoid
