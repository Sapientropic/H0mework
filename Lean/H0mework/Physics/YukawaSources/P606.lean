import H0mework.Physics.JointSources.P605

/-!
# Proposition 606: singleton source surface for the Yukawa primitive-card packet

P604 constructed the canonical primitive-card packet that generates the Yukawa
coefficient vector.  P605 then bundled the three current Standard-Model
producer nails into one receipt.

This file tightens the Yukawa side of that receipt: the primitive-card packet
itself is no longer just a chosen canonical object.  It is the unique point of
an explicit source-equation surface.  Therefore any packet whose fields are
read from the same finite core cards collapses to the P604 packet, and hence
produces the same nine Yukawa depths and CKM/Jarlskog depth sum `386`.

Boundary: this still does not prove why continuous SU(7)-breaking dynamics
selects those finite cards.  It proves that, once the finite-card source
surface is accepted, there is no remaining packet-level freedom.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

/-! ## Primitive-card source equations -/

/-- Source equations for a primitive-card packet.

These equations are intentionally written against named carriers, not against
bare numerals.  P604 proves those carriers evaluate to the displayed integers;
this surface says that any accepted packet must use those sources. -/
def YukawaPrimitiveCardSourceEquations
    (P : YukawaCoefficientPrimitiveCardPacket) : Prop :=
  P.alphaDenominator = alphaEMIntegerDenominator ℤ ∧
    P.informationStates = sevenFacetInformationStateCount ℤ ∧
    P.visibleGauge = visibleGaugeCarrierCardFromLowEnergyZ ∧
    P.unifiedGaugeFreedom = su7GaugeFreedomDimension ℤ ∧
    P.gaugedFundamental = gaugedFundamentalBlockCardZ ∧
    P.primitiveSectors = primitiveSloganSectorCardZ ∧
    P.gaugeSinglets = gaugeSingletBlockCardZ ∧
    P.su7FundamentalBlocks = su7FundamentalBlockIndexCardZ ∧
    P.poincareTopResolution = fourDimensionalPoincareTopResolutionCardZ ∧
    P.unit = yukawaCoefficientUnitCardZ ∧
    P.informationMatterSupport = informationMatterSupportCardFromComponentCarrierZ

/-- THEOREM 1: the P604 canonical packet satisfies the source equations. -/
theorem canonicalYukawaCoefficientPrimitiveCardPacket_sourceEquations :
    YukawaPrimitiveCardSourceEquations
      canonicalYukawaCoefficientPrimitiveCardPacket := by
  simp [YukawaPrimitiveCardSourceEquations,
    canonicalYukawaCoefficientPrimitiveCardPacket]

/-- THEOREM 2: the primitive-card source surface is a singleton. -/
theorem eq_canonicalYukawaCoefficientPrimitiveCardPacket_of_sourceEquations
    (P : YukawaCoefficientPrimitiveCardPacket)
    (hP : YukawaPrimitiveCardSourceEquations P) :
    P = canonicalYukawaCoefficientPrimitiveCardPacket := by
  cases P with
  | mk alphaDenominator informationStates visibleGauge unifiedGaugeFreedom
      gaugedFundamental primitiveSectors gaugeSinglets su7FundamentalBlocks
      poincareTopResolution unit informationMatterSupport =>
    unfold YukawaPrimitiveCardSourceEquations at hP
    rcases hP with
      ⟨hAlpha, hInfo, hVisible, hUnified, hGauged, hSectors, hSinglets,
        hBlocks, hPoincare, hUnit, hSupport⟩
    dsimp at hAlpha
    dsimp at hInfo
    dsimp at hVisible
    dsimp at hUnified
    dsimp at hGauged
    dsimp at hSectors
    dsimp at hSinglets
    dsimp at hBlocks
    dsimp at hPoincare
    dsimp at hUnit
    dsimp at hSupport
    subst alphaDenominator
    subst informationStates
    subst visibleGauge
    subst unifiedGaugeFreedom
    subst gaugedFundamental
    subst primitiveSectors
    subst gaugeSinglets
    subst su7FundamentalBlocks
    subst poincareTopResolution
    subst unit
    subst informationMatterSupport
    rfl

/-! ## Propagating source-surface uniqueness to Yukawa/CKM output -/

/-- Producer input generated by an arbitrary primitive-card packet. -/
def yukawaProducerInputCandidateOfPrimitiveCardPacket
    (P : YukawaCoefficientPrimitiveCardPacket) :
    YukawaProducerInputCandidate where
  coefficients := primitiveCardYukawaDepthStencilCoefficientVector P
  schedule := yukawaSectorInformationIncidence

/-- THEOREM 3: any source-surface packet gives the canonical P604 producer
input. -/
theorem yukawaProducerInputCandidateOfPrimitiveCardPacket_eq_canonical
    (P : YukawaCoefficientPrimitiveCardPacket)
    (hP : YukawaPrimitiveCardSourceEquations P) :
    yukawaProducerInputCandidateOfPrimitiveCardPacket P =
      primitiveCardYukawaProducerInputCandidate := by
  rw [eq_canonicalYukawaCoefficientPrimitiveCardPacket_of_sourceEquations P hP]
  rfl

/-- THEOREM 4: any source-surface packet is accepted by the P603 producer-input
surface. -/
theorem yukawaProducerInputCandidateOfPrimitiveCardPacket_surface
    (P : YukawaCoefficientPrimitiveCardPacket)
    (hP : YukawaPrimitiveCardSourceEquations P) :
    YukawaProducerInputSurface
      (yukawaProducerInputCandidateOfPrimitiveCardPacket P) := by
  rw [yukawaProducerInputCandidateOfPrimitiveCardPacket_eq_canonical P hP]
  exact primitiveCardYukawaProducerInputCandidate_surface

/-- THEOREM 5: any source-surface packet generates the documented nine-depth
table. -/
theorem yukawaProducerInputCandidateOfPrimitiveCardPacket_massOrder_eq
    (P : YukawaCoefficientPrimitiveCardPacket)
    (hP : YukawaPrimitiveCardSourceEquations P) :
    (yukawaProducerInputCandidateOfPrimitiveCardPacket P).depthTable.massOrder =
      [50, 346, 372, 489, 583, 682, 880, 908, 982] := by
  rw [yukawaProducerInputCandidateOfPrimitiveCardPacket_eq_canonical P hP]
  exact primitiveCardYukawaProducerInputCandidate_massOrder_eq

/-- THEOREM 6: any source-surface packet generates CKM/Jarlskog depth sum
`386`. -/
theorem yukawaProducerInputCandidateOfPrimitiveCardPacket_ckmDepthSum_eq_386
    (P : YukawaCoefficientPrimitiveCardPacket)
    (hP : YukawaPrimitiveCardSourceEquations P) :
    ckmDepthSum_fromYukawaDepthTable
      (yukawaProducerInputCandidateOfPrimitiveCardPacket P).depthTable =
        (ckmCPDepthSum : Int) := by
  rw [yukawaProducerInputCandidateOfPrimitiveCardPacket_eq_canonical P hP]
  exact primitiveCardYukawaProducerInputCandidate_ckmDepthSum_eq_386

/-! ## Receipt and P605 strengthening -/

/-- Compact receipt for the primitive-card source singleton surface. -/
structure YukawaPrimitiveCardSourceSurfaceReceipt where
  canonical_source :
    YukawaPrimitiveCardSourceEquations
      canonicalYukawaCoefficientPrimitiveCardPacket
  source_surface_singleton :
    ∀ P : YukawaCoefficientPrimitiveCardPacket,
      YukawaPrimitiveCardSourceEquations P ->
        P = canonicalYukawaCoefficientPrimitiveCardPacket
  producer_input_unique :
    ∀ P : YukawaCoefficientPrimitiveCardPacket,
      YukawaPrimitiveCardSourceEquations P ->
        yukawaProducerInputCandidateOfPrimitiveCardPacket P =
          primitiveCardYukawaProducerInputCandidate
  producer_input_surface :
    ∀ P : YukawaCoefficientPrimitiveCardPacket,
      YukawaPrimitiveCardSourceEquations P ->
        YukawaProducerInputSurface
          (yukawaProducerInputCandidateOfPrimitiveCardPacket P)
  mass_order :
    ∀ P : YukawaCoefficientPrimitiveCardPacket,
      YukawaPrimitiveCardSourceEquations P ->
        (yukawaProducerInputCandidateOfPrimitiveCardPacket P).depthTable.massOrder =
          [50, 346, 372, 489, 583, 682, 880, 908, 982]
  ckm_depth_sum :
    ∀ P : YukawaCoefficientPrimitiveCardPacket,
      YukawaPrimitiveCardSourceEquations P ->
        ckmDepthSum_fromYukawaDepthTable
          (yukawaProducerInputCandidateOfPrimitiveCardPacket P).depthTable =
            (ckmCPDepthSum : Int)

/-- THEOREM 7: receipt for the primitive-card singleton source surface. -/
theorem yukawaPrimitiveCardSourceSurfaceReceipt :
    YukawaPrimitiveCardSourceSurfaceReceipt where
  canonical_source :=
    canonicalYukawaCoefficientPrimitiveCardPacket_sourceEquations
  source_surface_singleton :=
    eq_canonicalYukawaCoefficientPrimitiveCardPacket_of_sourceEquations
  producer_input_unique :=
    yukawaProducerInputCandidateOfPrimitiveCardPacket_eq_canonical
  producer_input_surface :=
    yukawaProducerInputCandidateOfPrimitiveCardPacket_surface
  mass_order :=
    yukawaProducerInputCandidateOfPrimitiveCardPacket_massOrder_eq
  ckm_depth_sum :=
    yukawaProducerInputCandidateOfPrimitiveCardPacket_ckmDepthSum_eq_386

/-- P605 strengthened by the primitive-card singleton source-surface receipt. -/
structure MainProducerNailsSourceSurfaceCertificate
    (C : FourDPoincareCertificate)
    (e : UnifiedGaugeFreedomCarrier ↪ AlphaEMStructuralCarrier) where
  main_nails :
    MainProducerNailsCertificate C e
  primitive_card_source_surface :
    YukawaPrimitiveCardSourceSurfaceReceipt

/-- THEOREM 8: any P605 main-nails input also carries the P606 primitive-card
source singleton surface. -/
noncomputable def mainProducerNailsSourceSurfaceCertificate
    (C : FourDPoincareCertificate)
    (e : UnifiedGaugeFreedomCarrier ↪ AlphaEMStructuralCarrier) :
    MainProducerNailsSourceSurfaceCertificate C e where
  main_nails := mainProducerNailsCertificate C e
  primitive_card_source_surface := yukawaPrimitiveCardSourceSurfaceReceipt

/-- THEOREM 9: canonical current-formal P605/P606 combined certificate. -/
noncomputable def canonicalCurrentFormalMainProducerNailsSourceSurfaceCertificate :
    MainProducerNailsSourceSurfaceCertificate
      currentFormalFourDPoincareCertificate
      unifiedGaugeIntoAlphaEMStructural :=
  mainProducerNailsSourceSurfaceCertificate
    currentFormalFourDPoincareCertificate
    unifiedGaugeIntoAlphaEMStructural

end StandardModelConstraint
end SaturationMonoid
