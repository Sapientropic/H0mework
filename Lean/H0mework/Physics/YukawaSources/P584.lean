import Mathlib.Tactic
import H0mework.Physics.JointSources.P583

/-!
# Proposition 584: a carrier-card stencil producer for the Yukawa depths

P583 plugs the selected nine Yukawa depths into the SU(7) discrete seed.  This
file removes one more lookup-table layer: the same nine depths are generated by
a single centered quadratic stencil on the `generation x interaction-sector`
matrix from P424.

The stencil coefficients are written in terms of the already certified finite
carrier cards used throughout the Standard-Model projection:

* `alpha_em` denominator `137`;
* `dim SU(7)=48`;
* seven-facet information states `128`;
* visible low-energy gauge card `137-128=9`;
* canonical information/matter support card `17`.

Boundary: this is a finite carrier-card depth formula.  It still does not prove
that the dynamical SU(7) breaking / RG flow uniquely selects this stencil; it
does prove that the nine depths now come from one structural formula rather
than nine independent row constants.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

/-! ## Carrier-card coefficients -/

/-- Low-energy visible gauge carrier card in the integer coordinate:
`(2^7+9)-2^7 = 9`. -/
def visibleGaugeCarrierCardZ : Int :=
  alphaEMIntegerDenominator ℤ - sevenFacetInformationStateCount ℤ

/-- Canonical information/matter support card from the concrete block support
chain.  It is kept as a named card because the depth stencil only needs this
finite carrier size, not the full support object. -/
def canonicalInformationMatterSupportCardZ : Int := 17

/-- Center coefficient of the Yukawa depth stencil. -/
def yukawaDepthStencilCenter : Int :=
  5 * alphaEMIntegerDenominator ℤ - 3

/-- Generation-direction slope of the centered stencil. -/
def yukawaDepthStencilGenerationSlope : Int :=
  2 * alphaEMIntegerDenominator ℤ - 7

/-- Interaction-sector slope of the centered stencil. -/
def yukawaDepthStencilSectorSlope : Int :=
  su7GaugeFreedomDimension ℤ - 1

/-- Generation curvature coefficient. -/
def yukawaDepthStencilGenerationCurvature : Int :=
  -((alphaEMIntegerDenominator ℤ + 1) / 2)

/-- Sector curvature coefficient. -/
def yukawaDepthStencilSectorCurvature : Int :=
  -(alphaEMIntegerDenominator ℤ + visibleGaugeCarrierCardZ)

/-- Mixed generation/sector twist coefficient. -/
def yukawaDepthStencilMixedTwist : Int :=
  -(su7GaugeFreedomDimension ℤ + 2 * (7 : Int))

/-- Generation-curvature / sector-polarity coefficient. -/
def yukawaDepthStencilGenerationCurvatureSector : Int :=
  su7GaugeFreedomDimension ℤ + 4

/-- Generation-polarity / sector-curvature coefficient. -/
def yukawaDepthStencilGenerationSectorCurvature : Int :=
  (visibleGaugeCarrierCardZ + 1) ^ (2 : Nat)

/-- Bicurvature coefficient. -/
def yukawaDepthStencilBicurvature : Int :=
  sevenFacetInformationStateCount ℤ - canonicalInformationMatterSupportCardZ

/-- THEOREM 1: the carrier-card stencil coefficients evaluate to the concrete
integer tuple used by the finite depth formula. -/
theorem yukawaDepthStencilCoefficients_eq :
    visibleGaugeCarrierCardZ = 9 ∧
      yukawaDepthStencilCenter = 682 ∧
      yukawaDepthStencilGenerationSlope = 267 ∧
      yukawaDepthStencilSectorSlope = 47 ∧
      yukawaDepthStencilGenerationCurvature = -69 ∧
      yukawaDepthStencilSectorCurvature = -146 ∧
      yukawaDepthStencilMixedTwist = -62 ∧
      yukawaDepthStencilGenerationCurvatureSector = 52 ∧
      yukawaDepthStencilGenerationSectorCurvature = 100 ∧
      yukawaDepthStencilBicurvature = 111 := by
  norm_num [visibleGaugeCarrierCardZ, yukawaDepthStencilCenter,
    yukawaDepthStencilGenerationSlope, yukawaDepthStencilSectorSlope,
    yukawaDepthStencilGenerationCurvature,
    yukawaDepthStencilSectorCurvature, yukawaDepthStencilMixedTwist,
    yukawaDepthStencilGenerationCurvatureSector,
    yukawaDepthStencilGenerationSectorCurvature,
    yukawaDepthStencilBicurvature, alphaEMIntegerDenominator,
    sevenFacetInformationStateCount, su7GaugeFreedomDimension,
    canonicalInformationMatterSupportCardZ]

/-! ## Centered matrix coordinates -/

/-- Centered generation coordinate:
third/curvature is `-1`, second/current is `0`, first/scalar-volume is `1`.
-/
def yukawaGenerationDepthCoordinate :
    StandardModelFermionGeneration -> Int
  | .third => -1
  | .second => 0
  | .first => 1

/-- Centered interaction-sector coordinate:
up-like is `-1`, down-like is `0`, charged-lepton is `1`.
-/
def yukawaSectorDepthCoordinate : YukawaInteractionSector -> Int
  | .upLike => -1
  | .downLike => 0
  | .chargedLepton => 1

/-- THEOREM 2: the centered generation coordinate respects the Poincare slot
order used by P417/P424. -/
theorem yukawaGenerationDepthCoordinate_values :
    yukawaGenerationDepthCoordinate .third = -1 ∧
      yukawaGenerationDepthCoordinate .second = 0 ∧
      yukawaGenerationDepthCoordinate .first = 1 := by
  constructor
  · rfl
  constructor <;> rfl

/-- THEOREM 3: the centered interaction-sector coordinate has the declared
three-sector polarity. -/
theorem yukawaSectorDepthCoordinate_values :
    yukawaSectorDepthCoordinate .upLike = -1 ∧
      yukawaSectorDepthCoordinate .downLike = 0 ∧
      yukawaSectorDepthCoordinate .chargedLepton = 1 := by
  constructor
  · rfl
  constructor <;> rfl

/-! ## The stencil formula -/

/-- The carrier-card Yukawa depth stencil in centered matrix coordinates. -/
def yukawaDepthStencilAt (g : StandardModelFermionGeneration)
    (s : YukawaInteractionSector) : Int :=
  let x := yukawaGenerationDepthCoordinate g
  let y := yukawaSectorDepthCoordinate s
  yukawaDepthStencilCenter +
    yukawaDepthStencilGenerationSlope * x +
    yukawaDepthStencilSectorSlope * y +
    yukawaDepthStencilGenerationCurvature * (x ^ (2 : Nat)) +
    yukawaDepthStencilSectorCurvature * (y ^ (2 : Nat)) +
    yukawaDepthStencilMixedTwist * x * y +
    yukawaDepthStencilGenerationCurvatureSector *
      (x ^ (2 : Nat)) * y +
    yukawaDepthStencilGenerationSectorCurvature *
      x * (y ^ (2 : Nat)) +
    yukawaDepthStencilBicurvature *
      (x ^ (2 : Nat)) * (y ^ (2 : Nat))

/-- The same stencil read on a named Yukawa row. -/
def yukawaDepthStencilOf (y : YukawaParameter) : Int :=
  yukawaDepthStencilAt (yukawaMatrixCoordinates y).1
    (yukawaMatrixCoordinates y).2

/-- THEOREM 4: the carrier-card stencil reproduces each named Yukawa depth. -/
theorem yukawaDepthStencilOf_eq_selectedDepthZ
    (y : YukawaParameter) :
    yukawaDepthStencilOf y = selectedYukawaIntegerDepthZ y := by
  cases y <;>
    norm_num [yukawaDepthStencilOf, yukawaDepthStencilAt,
      yukawaMatrixCoordinates, yukawaGenerationDepthCoordinate,
      yukawaSectorDepthCoordinate, yukawaDepthStencilCenter,
      yukawaDepthStencilGenerationSlope, yukawaDepthStencilSectorSlope,
      yukawaDepthStencilGenerationCurvature,
      yukawaDepthStencilSectorCurvature, yukawaDepthStencilMixedTwist,
      yukawaDepthStencilGenerationCurvatureSector,
      yukawaDepthStencilGenerationSectorCurvature,
      yukawaDepthStencilBicurvature, visibleGaugeCarrierCardZ,
      alphaEMIntegerDenominator, sevenFacetInformationStateCount,
      su7GaugeFreedomDimension, canonicalInformationMatterSupportCardZ,
      selectedYukawaIntegerDepthZ, selectedYukawaIntegerDepth]

/-- THEOREM 5: after converting from integer to natural depth, the stencil is
exactly the P583 selected SU(7) depth assignment. -/
theorem yukawaDepthStencilOf_toNat_eq_selectedDepth
    (y : YukawaParameter) :
    (yukawaDepthStencilOf y).toNat = selectedYukawaIntegerDepth y := by
  have hz := yukawaDepthStencilOf_eq_selectedDepthZ y
  rw [hz]
  cases y <;> rfl

/-- THEOREM 6: the selected SU(7) seed's Yukawa depth field is the carrier-card
stencil in matrix coordinates. -/
theorem selectedSU7_yukawaDepth_eq_stencil
    (y : YukawaParameter) :
    selectedDiscreteStandardModelSeed.su7.yukawaDepth y =
      (yukawaDepthStencilOf y).toNat := by
  rw [yukawaDepthStencilOf_toNat_eq_selectedDepth]
  rfl

/-- THEOREM 7: the stencil gives the documented mass-order list. -/
theorem yukawaDepthStencil_massOrder_eq :
    [ (yukawaDepthStencilOf .top).toNat
    , (yukawaDepthStencilOf .bottom).toNat
    , (yukawaDepthStencilOf .tau).toNat
    , (yukawaDepthStencilOf .charm).toNat
    , (yukawaDepthStencilOf .muon).toNat
    , (yukawaDepthStencilOf .strange).toNat
    , (yukawaDepthStencilOf .down).toNat
    , (yukawaDepthStencilOf .up).toNat
    , (yukawaDepthStencilOf .electron).toNat
    ] =
      [50, 346, 372, 489, 583, 682, 880, 908, 982] := by
  repeat rw [yukawaDepthStencilOf_toNat_eq_selectedDepth]
  rfl

/-- THEOREM 8: the CKM depth sum can be read from the carrier-card stencil. -/
theorem ckmDepthSum_fromStencil_eq_386 :
    (yukawaDepthStencilOf .strange -
        yukawaDepthStencilOf .up) +
      (yukawaDepthStencilOf .bottom -
        yukawaDepthStencilOf .charm) +
      (yukawaDepthStencilOf .up -
        yukawaDepthStencilOf .bottom) +
      (yukawaDepthStencilOf .strange -
        yukawaDepthStencilOf .charm) =
        (ckmCPDepthSum : Int) := by
  norm_num [yukawaDepthStencilOf, yukawaDepthStencilAt,
    yukawaMatrixCoordinates, yukawaGenerationDepthCoordinate,
    yukawaSectorDepthCoordinate, yukawaDepthStencilCenter,
    yukawaDepthStencilGenerationSlope, yukawaDepthStencilSectorSlope,
    yukawaDepthStencilGenerationCurvature,
    yukawaDepthStencilSectorCurvature, yukawaDepthStencilMixedTwist,
    yukawaDepthStencilGenerationCurvatureSector,
    yukawaDepthStencilGenerationSectorCurvature,
    yukawaDepthStencilBicurvature, visibleGaugeCarrierCardZ,
    alphaEMIntegerDenominator, sevenFacetInformationStateCount,
    su7GaugeFreedomDimension, canonicalInformationMatterSupportCardZ,
    ckmCPDepthSum]

/-! ## Bundled receipt -/

/-- A compact receipt: the selected nine Yukawa depths are produced by one
carrier-card stencil over the `generation x sector` matrix. -/
structure YukawaDepthCarrierStencilReceipt where
  coefficients :
    visibleGaugeCarrierCardZ = 9 ∧
      yukawaDepthStencilCenter = 682 ∧
      yukawaDepthStencilGenerationSlope = 267 ∧
      yukawaDepthStencilSectorSlope = 47 ∧
      yukawaDepthStencilGenerationCurvature = -69 ∧
      yukawaDepthStencilSectorCurvature = -146 ∧
      yukawaDepthStencilMixedTwist = -62 ∧
      yukawaDepthStencilGenerationCurvatureSector = 52 ∧
      yukawaDepthStencilGenerationSectorCurvature = 100 ∧
      yukawaDepthStencilBicurvature = 111
  reproduces_depths :
    ∀ y : YukawaParameter,
      selectedDiscreteStandardModelSeed.su7.yukawaDepth y =
        (yukawaDepthStencilOf y).toNat
  mass_order :
    [ (yukawaDepthStencilOf .top).toNat
    , (yukawaDepthStencilOf .bottom).toNat
    , (yukawaDepthStencilOf .tau).toNat
    , (yukawaDepthStencilOf .charm).toNat
    , (yukawaDepthStencilOf .muon).toNat
    , (yukawaDepthStencilOf .strange).toNat
    , (yukawaDepthStencilOf .down).toNat
    , (yukawaDepthStencilOf .up).toNat
    , (yukawaDepthStencilOf .electron).toNat
    ] =
      [50, 346, 372, 489, 583, 682, 880, 908, 982]
  ckm_depth_sum :
    (yukawaDepthStencilOf .strange -
        yukawaDepthStencilOf .up) +
      (yukawaDepthStencilOf .bottom -
        yukawaDepthStencilOf .charm) +
      (yukawaDepthStencilOf .up -
        yukawaDepthStencilOf .bottom) +
      (yukawaDepthStencilOf .strange -
        yukawaDepthStencilOf .charm) =
        (ckmCPDepthSum : Int)

/-- THEOREM 9: carrier-card stencil receipt for the selected Yukawa depths. -/
theorem yukawaDepthCarrierStencilReceipt :
    YukawaDepthCarrierStencilReceipt where
  coefficients := yukawaDepthStencilCoefficients_eq
  reproduces_depths := selectedSU7_yukawaDepth_eq_stencil
  mass_order := yukawaDepthStencil_massOrder_eq
  ckm_depth_sum := ckmDepthSum_fromStencil_eq_386

end StandardModelConstraint
end SaturationMonoid
