import Mathlib.Tactic
import H0mework.Physics.YukawaSources.P596

/-!
# Proposition 599: singleton generated Yukawa depth table

P596 proves that the finite Yukawa coefficient surface is a singleton: carrier
source equations and selected-depth closure are equivalent.  This file moves
one level down to the table that the physics-facing producer actually cares
about.

A Yukawa depth table is accepted only if it is generated by:

* a coefficient vector satisfying the P594/P596 carrier-source equations; and
* an endpoint-signature preserving SU(7) sector schedule.

Lean then proves that the accepted depth-table surface is a singleton.  The
unique table is the selected nine-depth table, it has the documented mass-order
display `[50, 346, 372, 489, 583, 682, 880, 908, 982]`, and it induces the CKM
Jarlskog depth sum `386`.

Boundary: this still does not derive the carrier-source equations from
dynamical SU(7) breaking / consolidation ordering.  It proves that once those
equations and endpoint preservation are supplied, there is no remaining freedom
in the generated Yukawa table or the CKM depth sum.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

open InformationMatterProjection

/-! ## Depth-table candidates -/

/-- A candidate table assigning a signed integer consolidation depth to each
named Standard-Model Yukawa slot. -/
@[ext]
structure YukawaDepthTableCandidate where
  depth : YukawaParameter -> Int

/-- The selected table from P582, repackaged as a candidate object. -/
def selectedYukawaDepthTableCandidate : YukawaDepthTableCandidate where
  depth := selectedYukawaIntegerDepthZ

/-- The depth table generated by a coefficient vector and an SU(7) sector
schedule. -/
def coefficientScheduleYukawaDepthTableCandidate
    (C : YukawaDepthStencilCoefficientVector)
    (f : YukawaInteractionSector -> InformationSlot) :
    YukawaDepthTableCandidate where
  depth := fun y => coefficientVectorEndpointScheduleYukawaDepthStencilOf C f y

/-- Accepted generated depth tables: a table must be generated from a
carrier-source coefficient vector along an endpoint-preserving sector schedule.
-/
def YukawaDepthTableGeneratedSurface
    (T : YukawaDepthTableCandidate) : Prop :=
  ∃ C : YukawaDepthStencilCoefficientVector,
    ∃ f : YukawaInteractionSector -> InformationSlot,
      YukawaCoefficientCarrierSourceEquations C ∧
        YukawaSectorEndpointSignaturePreservingSchedule f ∧
          T = coefficientScheduleYukawaDepthTableCandidate C f

/-! ## The generated table surface is a singleton -/

/-- THEOREM 1: the selected table is generated by the carrier-sourced
coefficient vector and the endpoint-preserving SU(7) incidence schedule. -/
theorem selectedYukawaDepthTableCandidate_generated :
    YukawaDepthTableGeneratedSurface selectedYukawaDepthTableCandidate := by
  refine
    ⟨carrierSourcedYukawaDepthStencilCoefficientVector,
      yukawaSectorInformationIncidence,
      carrierSourcedYukawaDepthStencilCoefficientVector_sourceEquations,
      yukawaSectorInformationIncidence_endpointPreserving, ?_⟩
  ext y
  simp [selectedYukawaDepthTableCandidate,
    coefficientScheduleYukawaDepthTableCandidate]
  exact
    (coefficientVectorEndpointScheduleYukawaDepthStencilOf_eq_selectedDepthZ
      carrierSourcedYukawaDepthStencilCoefficientVector
      carrierSourcedYukawaDepthStencilCoefficientVector_sourceEquations
      yukawaSectorInformationIncidence
      yukawaSectorInformationIncidence_endpointPreserving y).symm

/-- THEOREM 2: every accepted generated depth table is the selected table. -/
theorem eq_selectedYukawaDepthTableCandidate_of_generated
    (T : YukawaDepthTableCandidate)
    (hT : YukawaDepthTableGeneratedSurface T) :
    T = selectedYukawaDepthTableCandidate := by
  rcases hT with ⟨C, f, hC, hf, hT⟩
  rw [hT]
  ext y
  simp [selectedYukawaDepthTableCandidate,
    coefficientScheduleYukawaDepthTableCandidate]
  exact coefficientVectorEndpointScheduleYukawaDepthStencilOf_eq_selectedDepthZ
    C hC f hf y

/-- A generated Yukawa table surface has no free table parameter when any two
accepted tables are equal. -/
def NoContinuousFreeYukawaDepthTableParameters
    (constraints : YukawaDepthTableCandidate -> Prop) : Prop :=
  ∀ T U : YukawaDepthTableCandidate,
    constraints T -> constraints U -> T = U

/-- THEOREM 3: the generated Yukawa depth-table surface is singleton/no-free.
-/
theorem yukawaDepthTableGeneratedSurface_noContinuousFree :
    NoContinuousFreeYukawaDepthTableParameters
      YukawaDepthTableGeneratedSurface := by
  intro T U hT hU
  rw [eq_selectedYukawaDepthTableCandidate_of_generated T hT,
    eq_selectedYukawaDepthTableCandidate_of_generated U hU]

/-! ## Mass-order display and CKM sum from any accepted table -/

/-- The documented mass-order display of a depth table:
`top, bottom, tau, charm, muon, strange, down, up, electron`. -/
def YukawaDepthTableCandidate.massOrder (T : YukawaDepthTableCandidate) :
    List Nat :=
  [ (T.depth .top).toNat
  , (T.depth .bottom).toNat
  , (T.depth .tau).toNat
  , (T.depth .charm).toNat
  , (T.depth .muon).toNat
  , (T.depth .strange).toNat
  , (T.depth .down).toNat
  , (T.depth .up).toNat
  , (T.depth .electron).toNat
  ]

/-- THEOREM 4: the selected table has the documented mass-order display. -/
theorem selectedYukawaDepthTableCandidate_massOrder_eq :
    selectedYukawaDepthTableCandidate.massOrder =
      [50, 346, 372, 489, 583, 682, 880, 908, 982] := by
  norm_num [YukawaDepthTableCandidate.massOrder,
    selectedYukawaDepthTableCandidate, selectedYukawaIntegerDepthZ,
    selectedYukawaIntegerDepth]
  omega

/-- THEOREM 5: every accepted generated table has the documented mass-order
display. -/
theorem yukawaDepthTableGeneratedSurface_massOrder_eq
    (T : YukawaDepthTableCandidate)
    (hT : YukawaDepthTableGeneratedSurface T) :
    T.massOrder = [50, 346, 372, 489, 583, 682, 880, 908, 982] := by
  rw [eq_selectedYukawaDepthTableCandidate_of_generated T hT]
  exact selectedYukawaDepthTableCandidate_massOrder_eq

/-- The CKM/Jarlskog depth sum read directly from a table. -/
def ckmDepthSum_fromYukawaDepthTable
    (T : YukawaDepthTableCandidate) : Int :=
  (T.depth .strange - T.depth .up) +
    (T.depth .bottom - T.depth .charm) +
      (T.depth .up - T.depth .bottom) +
        (T.depth .strange - T.depth .charm)

/-- THEOREM 6: the selected table induces CKM/Jarlskog depth sum `386`. -/
theorem selectedYukawaDepthTableCandidate_ckmDepthSum_eq_386 :
    ckmDepthSum_fromYukawaDepthTable selectedYukawaDepthTableCandidate =
      (ckmCPDepthSum : Int) := by
  norm_num [ckmDepthSum_fromYukawaDepthTable,
    selectedYukawaDepthTableCandidate, selectedYukawaIntegerDepthZ,
    selectedYukawaIntegerDepth, ckmCPDepthSum]

/-- THEOREM 7: every accepted generated table induces CKM/Jarlskog depth sum
`386`. -/
theorem yukawaDepthTableGeneratedSurface_ckmDepthSum_eq_386
    (T : YukawaDepthTableCandidate)
    (hT : YukawaDepthTableGeneratedSurface T) :
    ckmDepthSum_fromYukawaDepthTable T = (ckmCPDepthSum : Int) := by
  rw [eq_selectedYukawaDepthTableCandidate_of_generated T hT]
  exact selectedYukawaDepthTableCandidate_ckmDepthSum_eq_386

/-! ## Bundled receipt -/

/-- Compact receipt: carrier-source coefficients plus endpoint-preserving
sector schedules generate exactly one Yukawa depth table, and that table gives
both the documented nine-depth list and CKM depth sum `386`. -/
structure YukawaDepthTableGeneratedSingletonReceipt where
  selected_generated :
    YukawaDepthTableGeneratedSurface selectedYukawaDepthTableCandidate
  unique_table :
    ∀ T : YukawaDepthTableCandidate,
      YukawaDepthTableGeneratedSurface T ->
        T = selectedYukawaDepthTableCandidate
  no_free :
    NoContinuousFreeYukawaDepthTableParameters
      YukawaDepthTableGeneratedSurface
  mass_order :
    ∀ T : YukawaDepthTableCandidate,
      YukawaDepthTableGeneratedSurface T ->
        T.massOrder = [50, 346, 372, 489, 583, 682, 880, 908, 982]
  ckm_depth_sum :
    ∀ T : YukawaDepthTableCandidate,
      YukawaDepthTableGeneratedSurface T ->
        ckmDepthSum_fromYukawaDepthTable T = (ckmCPDepthSum : Int)

/-- THEOREM 8: singleton receipt for generated Yukawa depth tables. -/
theorem yukawaDepthTableGeneratedSingletonReceipt :
    YukawaDepthTableGeneratedSingletonReceipt where
  selected_generated := selectedYukawaDepthTableCandidate_generated
  unique_table := eq_selectedYukawaDepthTableCandidate_of_generated
  no_free := yukawaDepthTableGeneratedSurface_noContinuousFree
  mass_order := yukawaDepthTableGeneratedSurface_massOrder_eq
  ckm_depth_sum := yukawaDepthTableGeneratedSurface_ckmDepthSum_eq_386

end StandardModelConstraint
end SaturationMonoid
