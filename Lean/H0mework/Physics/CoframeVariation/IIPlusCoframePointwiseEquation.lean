/-! ## The genuine reduced Euler covector -/

/-- Coframe derivative of the actual nonlinear computed-`II+` local family. -/
def diracDualFormNativeIIPlusReducedCoframeEulerCovector
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) : LorentzianCoframe →L[ℝ] ℝ :=
  fderiv ℝ
    (holonomicDiracDualFormNativeIIPlusReducedCoframeLocalDensityFamily
      source configuration point)
    (configuration.coframe point)

/-- The derivative of the joint local family is the coefficient generated by
the actual nonlinear `B(t) := II+(e+t h)` path. -/
theorem diracDualFormNativeIIPlusReducedCoframeEulerCovector_apply
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate)
    (point : BasePoint)
    (direction : LorentzianCoframe) :
    diracDualFormNativeIIPlusReducedCoframeEulerCovector source configuration
        point direction =
      diracDualFormNativeIIPlusReducedCoframeFirstVariationDensity source point
        (toContinuumPointField configuration point) direction := by
  let variation : BasePoint → LorentzianCoframe := fun _ => direction
  let field := toContinuumPointField configuration point
  have jointC1 :=
    holonomicDiracDualFormNativeIIPlusReducedCoframeLocalDensityFamily_joint_contDiffAt
      source configuration smooth point (configuration.coframe point)
        (nondegenerate point)
  have canonical :=
    affineCorridor_hasFDerivAt_of_jointC1
      (holonomicDiracDualFormNativeIIPlusReducedCoframeLocalDensityFamily
        source configuration)
      configuration.coframe variation 0 point
        (by simpa [variation, affineCorridorSection] using jointC1)
  have canonicalScalar := canonical.hasDerivAt
  have pathEquality :
      (fun parameter : ℝ =>
        holonomicDiracDualFormNativeIIPlusReducedCoframeLocalDensityFamily
          source configuration point
          (configuration.coframe point + parameter • direction)) =
        diracDualFormNativeIIPlusReducedLocalDensityPath source point field
          direction := by
    funext parameter
    simpa [variation, field] using
      holonomicDiracDualFormNativeIIPlusReducedCoframeLocalDensityFamily_affine_eq_reducedPath
        source configuration variation parameter point
  rw [pathEquality] at canonicalScalar
  have actual :=
    diracDualFormNativeIIPlusReducedLocalDensityPath_hasDerivAt source point
      field (nondegenerate point) direction
  have derivativeEquality := canonicalScalar.unique actual
  dsimp [field, variation] at derivativeEquality
  simp only [zero_smul, add_zero, one_smul] at derivativeEquality
  unfold diracDualFormNativeIIPlusReducedCoframeEulerCovector
  exact derivativeEquality

def holonomicDiracDualFormNativeIIPlusReducedCoframeDirectionalEulerCoefficient
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (direction : LorentzianCoframe)
    (point : BasePoint) : ℝ :=
  diracDualFormNativeIIPlusReducedCoframeEulerCovector source configuration
    point direction

/-- Joint `C¹` regularity supplies continuity of every fixed-direction
reduced coefficient. -/
theorem
    holonomicDiracDualFormNativeIIPlusReducedCoframeDirectionalEulerCoefficient_continuous
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate)
    (direction : LorentzianCoframe) :
    Continuous
      (holonomicDiracDualFormNativeIIPlusReducedCoframeDirectionalEulerCoefficient
        source configuration direction) := by
  rw [continuous_iff_continuousAt]
  intro point
  have jointC1 :=
    holonomicDiracDualFormNativeIIPlusReducedCoframeLocalDensityFamily_joint_contDiffAt
      source configuration smooth point (configuration.coframe point)
        (nondegenerate point)
  have sectionC0 : ContDiffAt ℝ 0 configuration.coframe point :=
    (holonomicCoframe_contDiff configuration smooth).contDiffAt.of_le (by simp)
  have derivativeC0 : ContDiffAt ℝ 0
      (fun candidate : BasePoint =>
        fderiv ℝ
          (holonomicDiracDualFormNativeIIPlusReducedCoframeLocalDensityFamily
            source configuration candidate)
          (configuration.coframe candidate)) point :=
    ContDiffAt.fderiv (m := 0) jointC1 sectionC0 (by simp)
  have evaluatedContinuous : ContinuousAt
      (fun candidate : BasePoint =>
        fderiv ℝ
          (holonomicDiracDualFormNativeIIPlusReducedCoframeLocalDensityFamily
            source configuration candidate)
          (configuration.coframe candidate) direction) point :=
    derivativeC0.continuousAt.clm_apply continuousAt_const
  change ContinuousAt
    (fun candidate : BasePoint =>
      fderiv ℝ
        (holonomicDiracDualFormNativeIIPlusReducedCoframeLocalDensityFamily
          source configuration candidate)
        (configuration.coframe candidate) direction) point
  exact evaluatedContinuous

/-! ## Weak and pointwise equations -/

def DiracDualFormNativeIIPlusReducedCoframeWeakEquation
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration) : Prop :=
  ∀ variation : CompactlySupportedSmoothVariation LorentzianCoframe,
    (∫ point : BasePoint,
      diracDualFormNativeIIPlusReducedCoframeEulerCovector source
        configuration point (variation point)) = 0

def DiracDualFormNativeIIPlusReducedCoframePointwiseEquation
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration) : Prop :=
  ∀ point : BasePoint,
    diracDualFormNativeIIPlusReducedCoframeEulerCovector source configuration
      point = 0

theorem
    diracDualFormNativeIIPlusReducedCoframeWeakEquation_direction_integral
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (weakEquation :
      DiracDualFormNativeIIPlusReducedCoframeWeakEquation source configuration)
    (direction : LorentzianCoframe)
    (variation : CompactlySupportedSmoothVariation ℝ) :
    (∫ point : BasePoint,
      variation point *
        holonomicDiracDualFormNativeIIPlusReducedCoframeDirectionalEulerCoefficient
          source configuration direction point) = 0 := by
  have weakDirection :=
    weakEquation (scalarTimesCoframeVariation direction variation)
  simpa [
    holonomicDiracDualFormNativeIIPlusReducedCoframeDirectionalEulerCoefficient]
    using weakDirection

theorem
    diracDualFormNativeIIPlusReducedCoframeWeakEquation_implies_pointwiseEquation
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate)
    (weakEquation :
      DiracDualFormNativeIIPlusReducedCoframeWeakEquation source configuration) :
    DiracDualFormNativeIIPlusReducedCoframePointwiseEquation source
      configuration := by
  intro point
  apply ContinuousLinearMap.ext
  intro direction
  have directionZero :
      holonomicDiracDualFormNativeIIPlusReducedCoframeDirectionalEulerCoefficient
          source configuration direction = 0 := by
    apply continuous_eq_zero_of_integral_mul_compactSmooth_eq_zero
      (holonomicDiracDualFormNativeIIPlusReducedCoframeDirectionalEulerCoefficient
        source configuration direction)
      (holonomicDiracDualFormNativeIIPlusReducedCoframeDirectionalEulerCoefficient_continuous
        source configuration smooth nondegenerate direction)
    intro variation
    exact
      diracDualFormNativeIIPlusReducedCoframeWeakEquation_direction_integral
        source configuration weakEquation direction variation
  simpa [
    holonomicDiracDualFormNativeIIPlusReducedCoframeDirectionalEulerCoefficient]
    using congrFun directionZero point

theorem
    diracDualFormNativeIIPlusReducedCoframePointwiseEquation_implies_weakEquation
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (pointwiseEquation :
      DiracDualFormNativeIIPlusReducedCoframePointwiseEquation source
        configuration) :
    DiracDualFormNativeIIPlusReducedCoframeWeakEquation source configuration := by
  intro variation
  apply integral_eq_zero_of_ae
  filter_upwards with point
  rw [pointwiseEquation point]
  exact zero_apply _

theorem
    diracDualFormNativeIIPlusReducedCoframeWeakEquation_iff_pointwiseEquation
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate) :
    DiracDualFormNativeIIPlusReducedCoframeWeakEquation source configuration ↔
      DiracDualFormNativeIIPlusReducedCoframePointwiseEquation source
        configuration := by
  constructor
  · exact
      diracDualFormNativeIIPlusReducedCoframeWeakEquation_implies_pointwiseEquation
        source configuration smooth nondegenerate
  · exact
      diracDualFormNativeIIPlusReducedCoframePointwiseEquation_implies_weakEquation
        source configuration

/-! ## Action stationarity and explicit EC-shaped balance -/

theorem
    diracDualFormNativeIIPlusReducedCoframeActionStationary_iff_weakEquation
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate)
    (densityIntegrable :
      DiracDualFormNativeHolonomicLocalDensityIntegrable source 0
        (restrictHolonomicConfigurationToIIPlus configuration)) :
    DiracDualFormNativeIIPlusReducedCoframeActionStationary source
        configuration ↔
      DiracDualFormNativeIIPlusReducedCoframeWeakEquation source
        configuration := by
  constructor
  · intro stationary variation
    have actual :=
      holonomicIIPlusReducedDiracDualFormNativeIntegratedUnifiedAction_coframe_hasDerivAt
        source configuration smooth nondegenerate densityIntegrable variation
    have generatedZero :
        (∫ point : BasePoint,
          holonomicDiracDualFormNativeIIPlusReducedCoframeFirstVariationDensity
            source configuration variation point) = 0 :=
      ((stationary variation).unique actual).symm
    have coefficientEquality :
        (∫ point : BasePoint,
          holonomicDiracDualFormNativeIIPlusReducedCoframeFirstVariationDensity
            source configuration variation point) =
          ∫ point : BasePoint,
            diracDualFormNativeIIPlusReducedCoframeEulerCovector source
              configuration point (variation point) := by
      apply integral_congr_ae
      filter_upwards with point
      exact (diracDualFormNativeIIPlusReducedCoframeEulerCovector_apply source
        configuration smooth nondegenerate point (variation point)).symm
    exact coefficientEquality.symm.trans generatedZero
  · intro weakEquation variation
    have actual :=
      holonomicIIPlusReducedDiracDualFormNativeIntegratedUnifiedAction_coframe_hasDerivAt
        source configuration smooth nondegenerate densityIntegrable variation
    have coefficientEquality :
        (∫ point : BasePoint,
          holonomicDiracDualFormNativeIIPlusReducedCoframeFirstVariationDensity
            source configuration variation point) =
          ∫ point : BasePoint,
            diracDualFormNativeIIPlusReducedCoframeEulerCovector source
              configuration point (variation point) := by
      apply integral_congr_ae
      filter_upwards with point
      exact (diracDualFormNativeIIPlusReducedCoframeEulerCovector_apply source
        configuration smooth nondegenerate point (variation point)).symm
    have generatedZero := coefficientEquality.trans (weakEquation variation)
    rw [generatedZero] at actual
    exact actual

theorem
    diracDualFormNativeIIPlusReducedCoframeActionStationary_iff_pointwiseEquation
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate)
    (densityIntegrable :
      DiracDualFormNativeHolonomicLocalDensityIntegrable source 0
        (restrictHolonomicConfigurationToIIPlus configuration)) :
    DiracDualFormNativeIIPlusReducedCoframeActionStationary source
        configuration ↔
      DiracDualFormNativeIIPlusReducedCoframePointwiseEquation source
        configuration := by
  rw [
    diracDualFormNativeIIPlusReducedCoframeActionStationary_iff_weakEquation
      source configuration smooth nondegenerate densityIntegrable]
  exact
    diracDualFormNativeIIPlusReducedCoframeWeakEquation_iff_pointwiseEquation
      source configuration smooth nondegenerate

/-- Explicit pointwise first-order coframe balance.  The matter covector here
contains the scalar, Dirac kinetic, and repaired Dirac-dual Yukawa sectors. -/
def DiracDualFormNativeIIPlusCoframeECBalanceEquation
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration) : Prop :=
  ∀ point : BasePoint, ∀ direction : LorentzianCoframe,
    gravityTopologicalWedgeCoefficient
          (physicalIIPlusCoframeTangent (configuration.coframe point) direction)
          (gravityInternalPairVarianceNormalization
              (toContinuumPointField configuration point).gravityCurvature +
            coframeWedge (configuration.coframe point)) +
        diracDualFormNativeCoframeGaugeEulerCovector source
          (restrictContinuumPointFieldToIIPlus
            (toContinuumPointField configuration point)) direction +
        diracDualFormNativeCoframeMatterEulerCovector source point
          (restrictContinuumPointFieldToIIPlus
            (toContinuumPointField configuration point)) direction = 0

theorem
    diracDualFormNativeIIPlusReducedCoframePointwiseEquation_iff_EC_balance
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate) :
    DiracDualFormNativeIIPlusReducedCoframePointwiseEquation source
        configuration ↔
      DiracDualFormNativeIIPlusCoframeECBalanceEquation source
        configuration := by
  constructor
  · intro pointwise point direction
    have evaluated := congrArg
      (fun covector : LorentzianCoframe →L[ℝ] ℝ => covector direction)
      (pointwise point)
    simp only [zero_apply] at evaluated
    rw [diracDualFormNativeIIPlusReducedCoframeEulerCovector_apply source
      configuration smooth nondegenerate point direction] at evaluated
    rw [
      diracDualFormNativeIIPlusReducedCoframeFirstVariationDensity_eq_EC_balance
        source point (toContinuumPointField configuration point)
          (nondegenerate point) direction] at evaluated
    exact evaluated
  · intro balance point
    apply ContinuousLinearMap.ext
    intro direction
    rw [diracDualFormNativeIIPlusReducedCoframeEulerCovector_apply source
      configuration smooth nondegenerate point direction]
    rw [
      diracDualFormNativeIIPlusReducedCoframeFirstVariationDensity_eq_EC_balance
        source point (toContinuumPointField configuration point)
          (nondegenerate point) direction]
    exact balance point direction

theorem
    diracDualFormNativeIIPlusReducedCoframeActionStationary_iff_EC_balance
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate)
    (densityIntegrable :
      DiracDualFormNativeHolonomicLocalDensityIntegrable source 0
        (restrictHolonomicConfigurationToIIPlus configuration)) :
    DiracDualFormNativeIIPlusReducedCoframeActionStationary source
        configuration ↔
      DiracDualFormNativeIIPlusCoframeECBalanceEquation source
        configuration := by
  rw [
    diracDualFormNativeIIPlusReducedCoframeActionStationary_iff_pointwiseEquation
      source configuration smooth nondegenerate densityIntegrable]
  exact
    diracDualFormNativeIIPlusReducedCoframePointwiseEquation_iff_EC_balance
      source configuration smooth nondegenerate

/-! ## Terminal gravity critical locus with both first-order equations -/

/-- The repaired four-leg gravity locus reduces to simplicity, the unique
reaction, the explicit coframe EC balance, and the torsion--spin equation on
one actual.  This still does not produce an inhabitant or solve either
equation. -/
theorem
    diracDualFormNative_fourLegCriticalLocus_iff_EC_coframeBalance_and_torsionSpin
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (admissible : GravityConnectionLorentzAdmissible configuration)
    (nondegenerate : configuration.Nondegenerate)
    (densityIntegrable :
      DiracDualFormNativeHolonomicLocalDensityIntegrable source 0
        configuration) :
    (DiracDualFormNativeGravityMultiplierActionStationary source 0
        configuration ∧
      DiracDualFormNativeGravityAuxiliaryActionStationary source 0
        configuration ∧
      DiracDualFormNativeGravityCoframeActionStationary source configuration ∧
      DiracDualFormNativeLorentzConnectionActionStationary source
        configuration) ↔
    (FormNativeGravitySimplicityEquation configuration ∧
      configuration.gravitySimplicityMultiplier =
        formNativeGravityReactionField configuration ∧
      DiracDualFormNativeIIPlusCoframeECBalanceEquation source configuration ∧
      FormNativeIIPlusTorsionSpinEquation source configuration) := by
  constructor
  · intro fullLocus
    obtain ⟨simplicity, reaction, reducedCoframe, torsionSpin⟩ :=
      (diracDualFormNative_fourLegCriticalLocus_iff_reducedCoframeStationary_and_torsionSpin
        source configuration smooth admissible nondegenerate
          densityIntegrable).1 fullLocus
    have fixedPoint :=
      (restrictHolonomicConfigurationToIIPlus_eq_self_iff_diracDualFormNativeSimplicity
        configuration).2 simplicity
    have restrictedIntegrable :
        DiracDualFormNativeHolonomicLocalDensityIntegrable source 0
          (restrictHolonomicConfigurationToIIPlus configuration) := by
      simpa only [fixedPoint] using densityIntegrable
    have coframeBalance :=
      (diracDualFormNativeIIPlusReducedCoframeActionStationary_iff_EC_balance
        source configuration smooth nondegenerate restrictedIntegrable).1
          reducedCoframe
    exact ⟨simplicity, reaction, coframeBalance, torsionSpin⟩
  · rintro ⟨simplicity, reaction, coframeBalance, torsionSpin⟩
    have fixedPoint :=
      (restrictHolonomicConfigurationToIIPlus_eq_self_iff_diracDualFormNativeSimplicity
        configuration).2 simplicity
    have restrictedIntegrable :
        DiracDualFormNativeHolonomicLocalDensityIntegrable source 0
          (restrictHolonomicConfigurationToIIPlus configuration) := by
      simpa only [fixedPoint] using densityIntegrable
    have reducedCoframe :=
      (diracDualFormNativeIIPlusReducedCoframeActionStationary_iff_EC_balance
        source configuration smooth nondegenerate restrictedIntegrable).2
          coframeBalance
    exact
      (diracDualFormNative_fourLegCriticalLocus_iff_reducedCoframeStationary_and_torsionSpin
        source configuration smooth admissible nondegenerate
          densityIntegrable).2
        ⟨simplicity, reaction, reducedCoframe, torsionSpin⟩

end


