  StageNineP286SourceNativeReducedEntropyDescent.reducedEntropyP286CoordinateIndexFintype

local instance centeredReducedIterationP286CoordinateIsTopologicalAddGroup :
    IsTopologicalAddGroup P286CoordinateCarrier where
  toContinuousAdd := inferInstance
  toContinuousNeg := inferInstance

/-- The centered reduced `A/F/B` step preserves source-generated smoothness. -/
theorem p286CenteredReducedNext_smooth
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth)
    (nondegenerate : current.Nondegenerate)
    (center : BasePoint) :
    (p286CenteredReducedNext source current smooth nondegenerate center
      ).Smooth := by
  unfold p286CenteredReducedNext p286ReducedCompactJointPath
  apply formNativeP286GaugeConstitutiveReadout_smooth source
  · exact varyP286GaugeConnectionCoordinate_smooth_of_contDiff
      (p286ReducedEntropyBase source current)
      (p286ReducedEntropyBase_smooth source current smooth nondegenerate)
      (p286CenteredReducedVariation source current smooth nondegenerate center)
      (p286CenteredReducedVariation source current smooth nondegenerate
        center).smooth
      (p286CenteredReducedStepSize source current smooth nondegenerate center)
  · exact p286ReducedCompactRawPath_nondegenerate source current
      nondegenerate
      (p286CenteredReducedVariation source current smooth nondegenerate center)
      (p286CenteredReducedStepSize source current smooth nondegenerate center)

/-- One source-qualified state of the centered reduced entropy dynamics. -/
structure P286CenteredReducedEntropyStateAt
    (source : SmoothUnifiedSource) : Type where
  current : StageNineHolonomicConfiguration
  smooth : current.Smooth
  nondegenerate : current.Nondegenerate
  auxiliaryEquation :
    FormNativeP286GaugeAuxiliaryPointwiseEquation source current

/-- Algebraic reduction generates the initial qualified state before the
first connection payment. -/
def p286CenteredReducedEntropyInitialState
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth)
    (nondegenerate : current.Nondegenerate) :
    P286CenteredReducedEntropyStateAt source where
  current := p286ReducedEntropyBase source current
  smooth := p286ReducedEntropyBase_smooth source current smooth nondegenerate
  nondegenerate :=
    p286ReducedEntropyBase_nondegenerate source current nondegenerate
  auxiliaryEquation :=
    p286ReducedEntropyBase_auxiliaryEquation source current nondegenerate

/-- The unique next qualified state generated at the given material center. -/
def P286CenteredReducedEntropyStateAt.next
    {source : SmoothUnifiedSource}
    (center : BasePoint)
    (state : P286CenteredReducedEntropyStateAt source) :
    P286CenteredReducedEntropyStateAt source where
  current := p286CenteredReducedNext source state.current state.smooth
    state.nondegenerate center
  smooth := p286CenteredReducedNext_smooth source state.current state.smooth
    state.nondegenerate center
  nondegenerate := p286CenteredReducedNext_nondegenerate source state.current
    state.smooth state.nondegenerate center
  auxiliaryEquation :=
    p286CenteredReducedNext_auxiliaryPointwiseEquation source state.current
      state.smooth state.nondegenerate center

/-- The algebraic reduction of every qualified state is definitionally its
own current up to the generated auxiliary equation. -/
theorem P286CenteredReducedEntropyStateAt.reducedBase_eq
    {source : SmoothUnifiedSource}
    (state : P286CenteredReducedEntropyStateAt source) :
    p286ReducedEntropyBase source state.current = state.current := by
  exact
    ((formNativeP286GaugeAuxiliaryPointwiseEquation_iff_fixedReadout source
      state.current state.nondegenerate).1 state.auxiliaryEquation).symm

/-- Canonical finite iteration at a fixed material center. -/
def p286CenteredReducedEntropyIterate
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint) : Nat → P286CenteredReducedEntropyStateAt source
  | 0 => p286CenteredReducedEntropyInitialState source initial smooth
      nondegenerate
  | epoch + 1 =>
      (p286CenteredReducedEntropyIterate source initial smooth nondegenerate
        center epoch).next center

@[simp] theorem p286CenteredReducedEntropyIterate_zero_current
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint) :
    (p286CenteredReducedEntropyIterate source initial smooth nondegenerate
      center 0).current = p286ReducedEntropyBase source initial :=
  rfl

@[simp] theorem p286CenteredReducedEntropyIterate_succ_current
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint)
    (epoch : Nat) :
    (p286CenteredReducedEntropyIterate source initial smooth nondegenerate
      center (epoch + 1)).current =
      p286CenteredReducedNext source
        (p286CenteredReducedEntropyIterate source initial smooth nondegenerate
          center epoch).current
        (p286CenteredReducedEntropyIterate source initial smooth nondegenerate
          center epoch).smooth
        (p286CenteredReducedEntropyIterate source initial smooth nondegenerate
          center epoch).nondegenerate center :=
  rfl

/-! ## Exact finite entropy payment -/

/-- Defect read at one generated epoch. -/
def p286CenteredReducedEntropyDefectAt
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint)
    (epoch : Nat) : ℝ :=
  let state := p286CenteredReducedEntropyIterate source initial smooth
    nondegenerate center epoch
  p286CenteredReducedDefect source state.current center

/-- Signed reduced `A/F/B` action change at one generated epoch. -/
def p286CenteredReducedEntropyRelativeActionAt
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint)
    (epoch : Nat) : ℝ :=
  let state := p286CenteredReducedEntropyIterate source initial smooth
    nondegenerate center epoch
  p286CenteredReducedRelativeAction source state.current state.smooth
    state.nondegenerate center

/-- Nonnegative entropy payment generated by one centered reduced step. -/
def p286CenteredReducedEntropyPaymentAt
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint)
    (epoch : Nat) : ℝ :=
  -p286CenteredReducedEntropyRelativeActionAt source initial smooth
    nondegenerate center epoch

/-- Finite accumulated payment.  `fuel = 0` is observation exhaustion, not
a terminal state. -/
def p286CenteredReducedAccumulatedEntropyPayment
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint)
    (fuel : Nat) : ℝ :=
  ∑ epoch ∈ Finset.range fuel,
    p286CenteredReducedEntropyPaymentAt source initial smooth nondegenerate
      center epoch

/-- Normalized finite action ledger, based at zero on the algebraically
reduced initial state. -/
def p286CenteredReducedNormalizedEntropy
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint)
    (fuel : Nat) : ℝ :=
  ∑ epoch ∈ Finset.range fuel,
    p286CenteredReducedEntropyRelativeActionAt source initial smooth
      nondegenerate center epoch

theorem p286CenteredReducedRelativeAction_eq_zero_of_defect_eq_zero
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth)
    (nondegenerate : current.Nondegenerate)
    (center : BasePoint)
    (defectZero : p286CenteredReducedDefect source current center = 0) :
    p286CenteredReducedRelativeAction source current smooth nondegenerate
      center = 0 := by
  rw [p286CenteredReducedRelativeAction_quartic,
    p286CenteredReducedFirstCoefficient_eq_neg_defect]
  have stepZero :
      p286CenteredReducedStepSize source current smooth nondegenerate center =
        0 := by
    simp [p286CenteredReducedStepSize, p286QuarticNegativeDefectSafeStep,
      defectZero]
  rw [stepZero]
  ring

theorem p286CenteredReducedEntropyPaymentAt_nonnegative
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint)
    (epoch : Nat) :
    0 ≤ p286CenteredReducedEntropyPaymentAt source initial smooth
      nondegenerate center epoch := by
  let state := p286CenteredReducedEntropyIterate source initial smooth
    nondegenerate center epoch
  exact neg_nonneg.mpr
    (p286CenteredReducedRelativeAction_nonpositive source state.current
      state.smooth state.nondegenerate center)

theorem p286CenteredReducedEntropyPaymentAt_eq_zero_iff_defectAt_eq_zero
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint)
    (epoch : Nat) :
    p286CenteredReducedEntropyPaymentAt source initial smooth nondegenerate
        center epoch = 0 ↔
      p286CenteredReducedEntropyDefectAt source initial smooth nondegenerate
        center epoch = 0 := by
  let state := p286CenteredReducedEntropyIterate source initial smooth
    nondegenerate center epoch
  constructor
  · intro paymentZero
    by_contra defectNonzero
    have defectPositive :
        0 < p286CenteredReducedDefect source state.current center :=
      lt_of_le_of_ne
        (p286CenteredReducedDefect_nonnegative source state.current center)
        (Ne.symm defectNonzero)
    have paymentPositive :
        0 < p286CenteredReducedEntropyPaymentAt source initial smooth
          nondegenerate center epoch := by
      exact neg_pos.mpr
        (p286CenteredReducedRelativeAction_strict source state.current
          state.smooth state.nondegenerate center defectPositive)
    exact (ne_of_gt paymentPositive) paymentZero
  · intro defectZero
    change
      p286CenteredReducedDefect source state.current center = 0 at defectZero
    change
      -p286CenteredReducedRelativeAction source state.current state.smooth
          state.nondegenerate center = 0
    rw [p286CenteredReducedRelativeAction_eq_zero_of_defect_eq_zero source
      state.current state.smooth state.nondegenerate center defectZero]
    simp

theorem p286CenteredReducedEntropyPaymentAt_pos_iff_defectAt_pos
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint)
    (epoch : Nat) :
    0 < p286CenteredReducedEntropyPaymentAt source initial smooth
        nondegenerate center epoch ↔
      0 < p286CenteredReducedEntropyDefectAt source initial smooth
        nondegenerate center epoch := by
  constructor
  · intro paymentPositive
    have defectNonnegative :
        0 ≤ p286CenteredReducedEntropyDefectAt source initial smooth
          nondegenerate center epoch := by
      exact p286CenteredReducedDefect_nonnegative source _ center
    apply lt_of_le_of_ne defectNonnegative
    intro zeroEq
    have defectZero := zeroEq.symm
    have paymentZero :=
      (p286CenteredReducedEntropyPaymentAt_eq_zero_iff_defectAt_eq_zero
        source initial smooth nondegenerate center epoch).2 defectZero
    exact (ne_of_gt paymentPositive) paymentZero
  · intro defectPositive
    let state := p286CenteredReducedEntropyIterate source initial smooth
      nondegenerate center epoch
    exact neg_pos.mpr
      (p286CenteredReducedRelativeAction_strict source state.current
        state.smooth state.nondegenerate center defectPositive)

theorem p286CenteredReducedEntropy_defectZero_or_generatedProgress
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint)
    (epoch : Nat) :
    (p286CenteredReducedEntropyDefectAt source initial smooth nondegenerate
          center epoch = 0 ∧
        (p286CenteredReducedEntropyIterate source initial smooth nondegenerate
          center (epoch + 1)).current =
          (p286CenteredReducedEntropyIterate source initial smooth
            nondegenerate center epoch).current) ∨
      (0 < p286CenteredReducedEntropyPaymentAt source initial smooth
          nondegenerate center epoch ∧
        (p286CenteredReducedEntropyIterate source initial smooth nondegenerate
          center (epoch + 1)).current ≠
          (p286CenteredReducedEntropyIterate source initial smooth
            nondegenerate center epoch).current) := by
  let state := p286CenteredReducedEntropyIterate source initial smooth
    nondegenerate center epoch
  rcases eq_or_lt_of_le
      (p286CenteredReducedDefect_nonnegative source state.current center) with
    defectZero | defectPositive
  · left
    have defectZero' := defectZero.symm
    refine ⟨defectZero', ?_⟩
    rw [p286CenteredReducedEntropyIterate_succ_current]
    exact
      (p286CenteredReducedNext_eq_base_of_defect_zero source state.current
        state.smooth state.nondegenerate center defectZero').trans
        state.reducedBase_eq
  · right
    refine ⟨?_, ?_⟩
    · exact
        (p286CenteredReducedEntropyPaymentAt_pos_iff_defectAt_pos source
          initial smooth nondegenerate center epoch).2 defectPositive
    · rw [p286CenteredReducedEntropyIterate_succ_current]
      intro nextEq
      exact
        (p286CenteredReducedNext_ne_base_of_defect_pos source state.current
          state.smooth state.nondegenerate center defectPositive)
          (nextEq.trans state.reducedBase_eq.symm)

@[simp] theorem p286CenteredReducedAccumulatedEntropyPayment_succ
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint)
    (fuel : Nat) :
    p286CenteredReducedAccumulatedEntropyPayment source initial smooth
        nondegenerate center (fuel + 1) =
      p286CenteredReducedAccumulatedEntropyPayment source initial smooth
          nondegenerate center fuel +
        p286CenteredReducedEntropyPaymentAt source initial smooth
          nondegenerate center fuel := by
  simp [p286CenteredReducedAccumulatedEntropyPayment,
    Finset.sum_range_succ]

@[simp] theorem p286CenteredReducedNormalizedEntropy_succ
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint)
    (fuel : Nat) :
    p286CenteredReducedNormalizedEntropy source initial smooth nondegenerate
        center (fuel + 1) =
      p286CenteredReducedNormalizedEntropy source initial smooth nondegenerate
          center fuel +
        p286CenteredReducedEntropyRelativeActionAt source initial smooth
          nondegenerate center fuel := by
  simp [p286CenteredReducedNormalizedEntropy, Finset.sum_range_succ]

theorem p286CenteredReducedAccumulatedEntropyPayment_nonnegative
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint)
    (fuel : Nat) :
    0 ≤ p286CenteredReducedAccumulatedEntropyPayment source initial smooth
      nondegenerate center fuel := by
  exact Finset.sum_nonneg fun epoch _ =>
    p286CenteredReducedEntropyPaymentAt_nonnegative source initial smooth
      nondegenerate center epoch

/-- Exact finite entropy telescope. -/
theorem p286CenteredReducedNormalizedEntropy_eq_neg_accumulatedPayment
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint)
    (fuel : Nat) :
    p286CenteredReducedNormalizedEntropy source initial smooth nondegenerate
        center fuel =
      -p286CenteredReducedAccumulatedEntropyPayment source initial smooth
        nondegenerate center fuel := by
  induction fuel with
  | zero => simp [p286CenteredReducedNormalizedEntropy,
      p286CenteredReducedAccumulatedEntropyPayment]
  | succ fuel inductionHypothesis =>
      rw [p286CenteredReducedNormalizedEntropy_succ,
        p286CenteredReducedAccumulatedEntropyPayment_succ,
        inductionHypothesis]
      unfold p286CenteredReducedEntropyPaymentAt
      ring

theorem p286CenteredReducedNormalizedEntropy_nonpositive
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint)
    (fuel : Nat) :
    p286CenteredReducedNormalizedEntropy source initial smooth nondegenerate
      center fuel ≤ 0 := by
  rw [p286CenteredReducedNormalizedEntropy_eq_neg_accumulatedPayment]
  exact neg_nonpos.mpr
    (p286CenteredReducedAccumulatedEntropyPayment_nonnegative source initial
      smooth nondegenerate center fuel)

/-- Unconditional cofinal entropy disposition.  Either the total generated
payment is finite and the exact one-step payment tends to zero, or cumulative
strict progress diverges.  No entropy floor, limit state, or fixedness is a
premise. -/
theorem p286CenteredReducedEntropyPayment_cofinalDisposition
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint) :
    (Summable fun epoch =>
        p286CenteredReducedEntropyPaymentAt source initial smooth
          nondegenerate center epoch) ∧
        Tendsto
          (fun epoch =>
            p286CenteredReducedEntropyPaymentAt source initial smooth
              nondegenerate center epoch)
          atTop (nhds 0) ∨
      Tendsto
        (fun fuel =>
          p286CenteredReducedAccumulatedEntropyPayment source initial smooth
            nondegenerate center fuel)
        atTop atTop := by
  classical
  by_cases paymentSummable : Summable fun epoch =>
      p286CenteredReducedEntropyPaymentAt source initial smooth nondegenerate
        center epoch
  · left
    exact ⟨paymentSummable, paymentSummable.tendsto_atTop_zero⟩
  · right
    have divergence :=
      (not_summable_iff_tendsto_nat_atTop_of_nonneg
        (fun epoch => p286CenteredReducedEntropyPaymentAt_nonnegative source
          initial smooth nondegenerate center epoch)).1 paymentSummable
    simpa [p286CenteredReducedAccumulatedEntropyPayment] using divergence

/-! ## Exact cofinal material contracts

The finite telescope above is unconditional.  Passing to a cofinal normal
form needs two additional source laws: a lower entropy floor and a uniform
conversion of defect into paid dissipation.  Neither contract contains a
limit configuration, a fixedness witness, or a target equation. -/

/-- Source-owned lower bound for the normalized action ledger. -/
abbrev P286CenteredReducedEntropyFloorAt
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint) : Prop :=
  ∃ floor : ℝ, ∀ fuel : Nat,
    floor ≤ p286CenteredReducedNormalizedEntropy source initial smooth
      nondegenerate center fuel

/-- Uniform quantitative defect-to-payment law for the generated trajectory. -/
abbrev P286CenteredReducedEntropyDefectCoercivityAt
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint) : Prop :=
  ∃ κ : ℝ, 0 < κ ∧ ∀ epoch : Nat,
    κ * p286CenteredReducedEntropyDefectAt source initial smooth
        nondegenerate center epoch ≤
      p286CenteredReducedEntropyPaymentAt source initial smooth nondegenerate
        center epoch

/-- Minimal entropy material needed to force centered defect decay. -/
abbrev P286CenteredReducedEntropyCofinalMaterialAt
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint) : Prop :=
  P286CenteredReducedEntropyFloorAt source initial smooth nondegenerate
      center ∧
    P286CenteredReducedEntropyDefectCoercivityAt source initial smooth
      nondegenerate center

theorem p286CenteredReducedEntropyPayment_summable_of_floor
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint)
    (floorLaw : P286CenteredReducedEntropyFloorAt source initial smooth
      nondegenerate center) :
    Summable fun epoch =>
      p286CenteredReducedEntropyPaymentAt source initial smooth nondegenerate
        center epoch := by
  rcases floorLaw with ⟨floor, floorLower⟩
  apply summable_of_sum_range_le
    (fun epoch => p286CenteredReducedEntropyPaymentAt_nonnegative source
      initial smooth nondegenerate center epoch) (c := -floor)
  intro fuel
  have lower := floorLower fuel
  rw [p286CenteredReducedNormalizedEntropy_eq_neg_accumulatedPayment]
    at lower
  change
    p286CenteredReducedAccumulatedEntropyPayment source initial smooth
      nondegenerate center fuel ≤ -floor
  linarith

theorem p286CenteredReducedEntropyDefect_summable_of_cofinalMaterial
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint)
    (material : P286CenteredReducedEntropyCofinalMaterialAt source initial
      smooth nondegenerate center) :
    Summable fun epoch =>
      p286CenteredReducedEntropyDefectAt source initial smooth nondegenerate
        center epoch := by
  rcases material with ⟨floorLaw, κ, κPositive, defectPaid⟩
  have paymentSummable :=
    p286CenteredReducedEntropyPayment_summable_of_floor source initial smooth
      nondegenerate center floorLaw
  have scaledPaymentSummable :
      Summable fun epoch =>
        p286CenteredReducedEntropyPaymentAt source initial smooth
            nondegenerate center epoch / κ := by
    simpa [div_eq_mul_inv] using paymentSummable.mul_right κ⁻¹
  exact Summable.of_nonneg_of_le
    (fun epoch => p286CenteredReducedDefect_nonnegative source _ center)
    (fun epoch => (le_div_iff₀' κPositive).2 (defectPaid epoch))
    scaledPaymentSummable

/-- The exact strongest cofinal conclusion available from entropy alone:
the generated centered defect tends to zero.  No state convergence or fixed
point is assumed. -/
theorem p286CenteredReducedEntropyDefect_tendsto_zero_of_cofinalMaterial
    (source : SmoothUnifiedSource)
    (initial : StageNineHolonomicConfiguration)
    (smooth : initial.Smooth)
    (nondegenerate : initial.Nondegenerate)
    (center : BasePoint)
    (material : P286CenteredReducedEntropyCofinalMaterialAt source initial
      smooth nondegenerate center) :
    Tendsto
      (fun epoch =>
        p286CenteredReducedEntropyDefectAt source initial smooth
          nondegenerate center epoch)
      atTop (nhds 0) :=
  (p286CenteredReducedEntropyDefect_summable_of_cofinalMaterial source initial
    smooth nondegenerate center material).tendsto_atTop_zero

