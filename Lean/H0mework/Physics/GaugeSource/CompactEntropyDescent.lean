import H0mework.Physics.GaugeAction.P286JointYangMillsGradientFlowRegularity

/-!
# Source-native compact P286 action descent

The pointwise P286 Euler covector already generates its positive-pairing
gradient.  A raw all-space gradient need not be compactly supported, while the
integrated first-variation theorem is intentionally stated for genuine compact
variations.  This module closes that seam without accepting a step size or a
future state:

```text
current Euler covector
  -> fixed unit bump * negative pairing gradient
  -> exact compact relative-action quadratic
  -> coefficient-computed safe step
  -> strict finite descent whenever the computed cutoff defect is positive.
```

The entropy is a *relative* action: it integrates the density difference
between the generated candidate and its current.  The difference is compactly
supported even when neither whole-space action density is integrable.  Its
quadratic normal form follows from the existing primitive connection path, and
the safe step is computed only from its current first and second coefficients.
No descent certificate, stationarity law, target state, or solution is stored
in the constructor.
-/

namespace SaturationMonoid.PhysicsCore
namespace StageNineP286SourceNativeCompactEntropyDescent

open MeasureTheory
open ProofFreeRicherAnholonomicSource
open StageNineCompactSupportIntegrationByParts
open StageNineEnrichedProofFreeSource
open StageNineFormNativeMotherAction
open StageNineFormNativeP286GaugeConnectionIntegratedVariation
open StageNineFormNativeP286GaugeConnectionLocalVariation
open StageNineFormNativeP286GaugeGeometricFirstVariation
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineP286GaugeAuxiliaryVariation
open StageNineP286GaugeConnectionVariation
open StageNineP286JointYangMillsGradientFlow
open StageNineP286JointYangMillsGradientFlowRegularity
open StageNineTopologicalP286GaugeThreeFormDuality
open SU7MotherLieAlgebra
open scoped ContDiff

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1200000
set_option maxRecDepth 100000

local instance compactEntropyP286ModuleFinite :
    Module.Finite ℝ P286LieBlockData :=
  FiniteDimensional.of_injective p286AmbientLinear p286AmbientLinear_injective

local instance compactEntropyP286CoordinateIndexFintype :
    Fintype P286CoordinateIndex :=
  Fintype.ofFinite P286CoordinateIndex

/-! ## Source-computed compact negative gradient -/

/-- The fixed origin bump multiplies the current-computed negative action
gradient.  The function contains no supplied direction or future field. -/
def p286CompactNegativeGradient
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    BasePoint → P286GaugeOneForm :=
  fun point =>
    (-nonzeroCompactScalarVariation point) •
      p286JointYangMillsActionGradient source current point

theorem p286CompactNegativeGradient_contDiff
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth)
    (nondegenerate : current.Nondegenerate) :
    ContDiff ℝ ∞ (p286CompactNegativeGradient source current) := by
  exact nonzeroCompactScalarVariation.smooth.neg.smul
    (p286JointYangMillsActionGradient_contDiff source current smooth
      nondegenerate)

theorem p286CompactNegativeGradient_hasCompactSupport
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    HasCompactSupport (p286CompactNegativeGradient source current) := by
  have bumpCompact := nonzeroCompactScalarVariation.compactSupport
  rw [hasCompactSupport_iff_eventuallyEq] at bumpCompact ⊢
  filter_upwards [bumpCompact] with point bumpZero
  simp [p286CompactNegativeGradient, bumpZero]

/-- Qualified compact variation generated by the current itself.  The proof
arguments certify the already fixed current; they do not contribute a
direction or outcome. -/
def p286CompactNegativeGradientVariation
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth)
    (nondegenerate : current.Nondegenerate) :
    CompactlySupportedSmoothVariation P286GaugeOneForm where
  toFun := p286CompactNegativeGradient source current
  smooth := p286CompactNegativeGradient_contDiff source current smooth
    nondegenerate
  compactSupport := p286CompactNegativeGradient_hasCompactSupport source
    current

/-! ## Computed defect and exact first coefficient -/

/-- The finite defect actually seen by the fixed compact material window. -/
def p286CompactActionDefect
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) : ℝ :=
  ∫ point : BasePoint,
    nonzeroCompactScalarVariation point *
      p286JointYangMillsActionDefect source current point

theorem p286JointYangMillsActionDefect_continuous
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth)
    (nondegenerate : current.Nondegenerate) :
    Continuous (p286JointYangMillsActionDefect source current) := by
  have gradientContinuous :
      Continuous (p286JointYangMillsActionGradient source current) :=
    (p286JointYangMillsActionGradient_contDiff source current smooth
      nondegenerate).continuous
  unfold p286JointYangMillsActionDefect
  apply continuous_finsetSum
  intro direction _
  exact p286CoordinateLiePairing_apply_continuous
    (fun point => p286JointYangMillsActionGradient source current point
      direction)
    (fun point => p286JointYangMillsActionGradient source current point
      direction)
    ((continuous_apply direction).comp gradientContinuous)
    ((continuous_apply direction).comp gradientContinuous)

theorem p286CompactActionDefect_nonnegative
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    0 ≤ p286CompactActionDefect source current := by
  unfold p286CompactActionDefect
  apply integral_nonneg
  intro point
  exact mul_nonneg unitCompactBump.nonneg
    (p286JointYangMillsActionDefect_nonnegative source current point)

theorem p286CompactActionDefect_pos_of_origin_euler_ne_zero
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth)
    (nondegenerate : current.Nondegenerate)
    (originNonzero :
      holonomicFormNativeP286GaugeEulerThreeForm source 0 current 0 ≠ 0) :
    0 < p286CompactActionDefect source current := by
  let integrand := fun point : BasePoint =>
    nonzeroCompactScalarVariation point *
      p286JointYangMillsActionDefect source current point
  have integrandContinuous : Continuous integrand :=
    nonzeroCompactScalarVariation.smooth.continuous.mul
      (p286JointYangMillsActionDefect_continuous source current smooth
        nondegenerate)
  have integrandCompact : HasCompactSupport integrand :=
    nonzeroCompactScalarVariation.compactSupport.mul_right
  have integrandNonnegative : 0 ≤ integrand := by
    intro point
    exact mul_nonneg unitCompactBump.nonneg
      (p286JointYangMillsActionDefect_nonnegative source current point)
  have originDefectPositive :
      0 < p286JointYangMillsActionDefect source current 0 := by
    have defectNonnegative :=
      p286JointYangMillsActionDefect_nonnegative source current 0
    have defectNonzero :
        p286JointYangMillsActionDefect source current 0 ≠ 0 := by
      intro defectZero
      exact originNonzero
        ((p286JointYangMillsActionDefect_eq_zero_iff source current 0).mp
          defectZero)
    exact lt_of_le_of_ne defectNonnegative defectNonzero.symm
  have bumpOne : nonzeroCompactScalarVariation (0 : BasePoint) = 1 := by
    apply unitCompactBump.one_of_mem_closedBall
    exact Metric.mem_closedBall_self unitCompactBump.rIn_pos.le
  have integrandOriginNonzero : integrand 0 ≠ 0 := by
    simp [integrand, bumpOne, originDefectPositive.ne']
  exact integrandContinuous.integral_pos_of_hasCompactSupport_nonneg_nonzero
    integrandCompact integrandNonnegative integrandOriginNonzero

/-- The exact first coefficient of the generated compact path. -/
def p286CompactNegativeGradientFirstCoefficient
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth)
    (nondegenerate : current.Nondegenerate) : ℝ :=
  ∫ point : BasePoint,
    holonomicFormNativeP286GaugeConnectionFirstVariationDensity source 0
      current
      (p286CompactNegativeGradientVariation source current smooth
        nondegenerate)
      point

theorem p286CompactNegativeGradientFirstCoefficient_eq_neg_defect
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth)
    (nondegenerate : current.Nondegenerate) :
    p286CompactNegativeGradientFirstCoefficient source current smooth
        nondegenerate =
      -p286CompactActionDefect source current := by
  rw [p286CompactNegativeGradientFirstCoefficient,
    holonomicFormNativeP286GaugeConnectionFirstVariation_integral_eq_w13
      source current smooth nondegenerate
      (p286CompactNegativeGradientVariation source current smooth
        nondegenerate)]
  rw [show (fun point : BasePoint =>
      p286GaugeOneFormThreeFormWedgeCoefficient
        (p286CompactNegativeGradientVariation source current smooth
          nondegenerate point)
        (holonomicFormNativeP286GaugeEulerThreeForm source 0 current point)) =
      fun point =>
        -(nonzeroCompactScalarVariation point *
          p286JointYangMillsActionDefect source current point) by
    funext point
    change
      p286GaugeOneFormThreeFormWedgeCoefficient
          ((-nonzeroCompactScalarVariation point) •
            p286JointYangMillsActionGradient source current point)
          (holonomicFormNativeP286GaugeEulerThreeForm source 0 current point) =
        _
    rw [p286GaugeOneFormThreeFormWedgeCoefficient_smul_left,
      p286JointYangMillsActionGradient_pairing_euler]
    ring]
  rw [integral_neg]
  rfl

/-! ## Compact relative action polynomial -/

/-- Relative mother-action read along one compact primitive connection path.
Unlike a difference of two separately integrated whole-space actions, this
integrates the compactly supported density difference directly. -/
def p286CompactConnectionRelativeAction
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (variation : CompactlySupportedSmoothVariation P286GaugeOneForm)
    (parameter : ℝ) : ℝ :=
  ∫ point : BasePoint,
    sourceGeneratedFormNativeUnifiedLocalDensity source 0 point
        (toContinuumPointField
          (varyP286GaugeConnectionCoordinate current variation parameter)
          point) -
      sourceGeneratedFormNativeUnifiedLocalDensity source 0 point
        (toContinuumPointField current point)

def p286CompactNegativeGradientSecondCoefficient
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth)
    (nondegenerate : current.Nondegenerate) : ℝ :=
  ∫ point : BasePoint,
    holonomicFormNativeP286GaugeConnectionSecondVariationDensity source 0
      current
      (p286CompactNegativeGradientVariation source current smooth
        nondegenerate)
      point

theorem p286CompactConnectionRelativeAction_quadratic
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth)
    (nondegenerate : current.Nondegenerate)
    (variation : CompactlySupportedSmoothVariation P286GaugeOneForm)
    (parameter : ℝ) :
    p286CompactConnectionRelativeAction source current variation parameter =
      parameter *
          (∫ point : BasePoint,
            holonomicFormNativeP286GaugeConnectionFirstVariationDensity source
              0 current variation point) +
        parameter ^ 2 *
          (∫ point : BasePoint,
            holonomicFormNativeP286GaugeConnectionSecondVariationDensity source
              0 current variation point) := by
  unfold p286CompactConnectionRelativeAction
  rw [show (fun point : BasePoint =>
      sourceGeneratedFormNativeUnifiedLocalDensity source 0 point
          (toContinuumPointField
            (varyP286GaugeConnectionCoordinate current variation parameter)
            point) -
        sourceGeneratedFormNativeUnifiedLocalDensity source 0 point
          (toContinuumPointField current point)) =
      fun point =>
        parameter *
            holonomicFormNativeP286GaugeConnectionFirstVariationDensity source
              0 current variation point +
          parameter ^ 2 *
            holonomicFormNativeP286GaugeConnectionSecondVariationDensity source
              0 current variation point by
    funext point
    rw [holonomicFormNativeUnifiedLocalDensity_p286Connection_quadratic
      source 0 current smooth variation parameter point]
    ring]
  have firstIntegrable :=
    holonomicFormNativeP286GaugeConnectionFirstVariationDensity_integrable
      source current smooth nondegenerate variation
  have secondIntegrable :=
    holonomicFormNativeP286GaugeConnectionSecondVariationDensity_integrable
      source current smooth nondegenerate variation
  rw [integral_add (firstIntegrable.const_mul parameter)
      (secondIntegrable.const_mul (parameter ^ 2)),
    integral_const_mul, integral_const_mul]

/-! ## Coefficient-computed finite step -/

/-- Safe step for a quadratic whose first coefficient is the negative defect.
The denominator is strictly positive for every current second coefficient. -/
def p286CompactNegativeGradientStepSize
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth)
    (nondegenerate : current.Nondegenerate) : ℝ :=
  p286CompactActionDefect source current /
    (2 * (1 +
      |p286CompactNegativeGradientSecondCoefficient source current smooth
        nondegenerate|))

theorem p286QuadraticNegativeDefectSafeStep_strict
    (defect second : ℝ)
    (defectPositive : 0 < defect) :
    let step := defect / (2 * (1 + |second|))
    step * (-defect) + step ^ 2 * second < 0 := by
  dsimp only
  let denominator : ℝ := 2 * (1 + |second|)
  let step : ℝ := defect / denominator
  have absNonnegative : 0 ≤ |second| := abs_nonneg second
  have denominatorPositive : 0 < denominator := by
    dsimp [denominator]
    positivity
  have denominatorNonzero : denominator ≠ 0 := ne_of_gt denominatorPositive
  have stepPositive : 0 < step := div_pos defectPositive denominatorPositive
  have stepDenominator : step * denominator = defect := by
    dsimp [step]
    exact div_mul_cancel₀ defect denominatorNonzero
  have stepAbs_lt_defect : step * |second| < defect := by
    dsimp [denominator] at stepDenominator
    nlinarith
  have squareSecond_le_squareAbs : step ^ 2 * second ≤ step ^ 2 * |second| :=
    mul_le_mul_of_nonneg_left (le_abs_self second) (sq_nonneg step)
  have squareAbs_lt_stepDefect : step ^ 2 * |second| < step * defect := by
    have scaled := mul_lt_mul_of_pos_left stepAbs_lt_defect stepPositive
    nlinarith
  nlinarith

theorem p286QuadraticNegativeDefectSafeStep_nonpositive
    (defect second : ℝ)
    (defectNonnegative : 0 ≤ defect) :
    let step := defect / (2 * (1 + |second|))
    step * (-defect) + step ^ 2 * second ≤ 0 := by
  by_cases defectZero : defect = 0
  · simp [defectZero]
  · exact (p286QuadraticNegativeDefectSafeStep_strict defect second
      (lt_of_le_of_ne defectNonnegative (Ne.symm defectZero))).le

/-- The next primitive configuration is generated from the current compact
negative gradient and its two exact action coefficients. -/
def p286CompactNegativeGradientNext
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth)
    (nondegenerate : current.Nondegenerate) :
    StageNineHolonomicConfiguration :=
  varyP286GaugeConnectionCoordinate current
    (p286CompactNegativeGradientVariation source current smooth nondegenerate)
    (p286CompactNegativeGradientStepSize source current smooth nondegenerate)

theorem p286CompactNegativeGradient_relativeAction_nonpositive
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth)
    (nondegenerate : current.Nondegenerate) :
    p286CompactConnectionRelativeAction source current
        (p286CompactNegativeGradientVariation source current smooth
          nondegenerate)
        (p286CompactNegativeGradientStepSize source current smooth
          nondegenerate) ≤ 0 := by
  rw [p286CompactConnectionRelativeAction_quadratic source current smooth
    nondegenerate]
  change
    p286CompactNegativeGradientStepSize source current smooth nondegenerate *
          p286CompactNegativeGradientFirstCoefficient source current smooth
            nondegenerate +
        p286CompactNegativeGradientStepSize source current smooth
            nondegenerate ^ 2 *
          p286CompactNegativeGradientSecondCoefficient source current smooth
            nondegenerate ≤ 0
  rw [p286CompactNegativeGradientFirstCoefficient_eq_neg_defect]
  exact p286QuadraticNegativeDefectSafeStep_nonpositive
    (p286CompactActionDefect source current)
    (p286CompactNegativeGradientSecondCoefficient source current smooth
      nondegenerate)
    (p286CompactActionDefect_nonnegative source current)

theorem p286CompactNegativeGradient_relativeAction_strict
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth)
    (nondegenerate : current.Nondegenerate)
    (defectPositive : 0 < p286CompactActionDefect source current) :
    p286CompactConnectionRelativeAction source current
        (p286CompactNegativeGradientVariation source current smooth
          nondegenerate)
        (p286CompactNegativeGradientStepSize source current smooth
          nondegenerate) < 0 := by
  rw [p286CompactConnectionRelativeAction_quadratic source current smooth
    nondegenerate]
  change
    p286CompactNegativeGradientStepSize source current smooth nondegenerate *
          p286CompactNegativeGradientFirstCoefficient source current smooth
            nondegenerate +
        p286CompactNegativeGradientStepSize source current smooth
            nondegenerate ^ 2 *
          p286CompactNegativeGradientSecondCoefficient source current smooth
            nondegenerate < 0
  rw [p286CompactNegativeGradientFirstCoefficient_eq_neg_defect]
  exact p286QuadraticNegativeDefectSafeStep_strict
    (p286CompactActionDefect source current)
    (p286CompactNegativeGradientSecondCoefficient source current smooth
      nondegenerate) defectPositive

theorem p286CompactNegativeGradient_relativeAction_strict_of_origin_euler_ne_zero
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth)
    (nondegenerate : current.Nondegenerate)
    (originNonzero :
      holonomicFormNativeP286GaugeEulerThreeForm source 0 current 0 ≠ 0) :
    p286CompactConnectionRelativeAction source current
        (p286CompactNegativeGradientVariation source current smooth
          nondegenerate)
        (p286CompactNegativeGradientStepSize source current smooth
          nondegenerate) < 0 :=
  p286CompactNegativeGradient_relativeAction_strict source current smooth
    nondegenerate
    (p286CompactActionDefect_pos_of_origin_euler_ne_zero source current smooth
      nondegenerate originNonzero)

end
