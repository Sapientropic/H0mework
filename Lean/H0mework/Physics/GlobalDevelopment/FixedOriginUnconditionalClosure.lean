import H0mework.Physics.JointVariation.GlobalDevelopmentFixed
import H0mework.Physics.DualVariation.PointwiseActionJetCarrier

/-!
# Fixed P506/L0 old-global unconditional origin closure

This module records the unconditional origin channels already generated by
the source/current-only complete-joint global development.  Each proof reads
the corresponding action equation from that one actual; no residual,
support coordinate, target field, or equation receipt enters a constructor.

The matter and conjugate-matter channels are added by the two dedicated
primal/adjoint origin modules because their existing proofs carry genuine
first- and second-jet dependencies.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeFixedP506CompleteJointGlobalDevelopmentOriginUnconditionalClosure

open ProofFreeRicherAnholonomicSource
open StageNineCanonicalCauchyState
open StageNineDiracDualFormNativeCartanReactionCurrentRestart
open StageNineDiracDualFormNativeCompleteJointActionGlobalDevelopmentFixedP506
open StageNineDiracDualFormNativeCompleteJointActionGlobalDevelopmentOperator
open StageNineDiracDualFormNativeFixedP506JointActionSectionResponse
open StageNineDiracDualFormNativeJointResidualCarrier
open StageNineEnrichedProofFreeSource
open StageNineFormNativeGaugeAuxiliaryVariation
open StageNineFormNativeGravityMultiplierAuxiliaryIntegratedVariation
open StageNineFormNativeGravityMultiplierAuxiliaryVariation
open StageNineFormNativeLorentzGeometricFirstVariation
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineP286ActionCauchySplit

open scoped ContDiff Matrix.Norms.Elementwise

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1200000
set_option maxRecDepth 100000

abbrev fixedP506L0CompleteJointGlobalOriginClosureActual :
    StageNineHolonomicConfiguration :=
  fixedP506L0CompleteJointGlobalDevelopmentActual

private theorem canonicalCauchySlicePoint_zero_zero :
    canonicalCauchySlicePoint 0 (0 : StageNineSpatialPoint) = 0 := by
  apply PiLp.ext
  intro direction
  fin_cases direction <;>
    simp [canonicalCauchySlicePoint, canonicalLorentzianTimeDirection,
      Fin.sum_univ_three]

theorem
    fixedP506L0CompleteJointGlobalDevelopmentActual_gravityMultiplier_origin_zero :
    (diracDualFormNativePointwiseJointResidual positiveSmoothUnifiedSource
      fixedP506L0CompleteJointGlobalOriginClosureActual 0
      ).gravityMultiplier =
      0 := by
  change formNativeGravityMultiplierEulerResidual
    (toContinuumPointField
      fixedP506L0CompleteJointGlobalOriginClosureActual 0) = 0
  exact
    (formNativeGravityMultiplierEulerResidual_eq_zero_iff_simplicity _).2
      (sourceActionGeneratedDiracDualCompleteJointGlobalDevelopmentOperator_simplicity
        positiveSmoothUnifiedSource
        FixedP506FormNativeJointActionSolvedSuccessor 0)

theorem
    fixedP506L0CompleteJointGlobalDevelopmentActual_gravityAuxiliary_origin_zero :
    (diracDualFormNativePointwiseJointResidual positiveSmoothUnifiedSource
      fixedP506L0CompleteJointGlobalOriginClosureActual 0
      ).gravityAuxiliary =
      0 := by
  change holonomicFormNativeGravityAuxiliaryEulerResidual
    fixedP506L0CompleteJointGlobalOriginClosureActual 0 = 0
  exact congrFun
    (sourceActionGeneratedDiracDualCompleteJointGlobalDevelopmentOperator_gravityAuxiliaryEquation
      positiveSmoothUnifiedSource
      FixedP506FormNativeJointActionSolvedSuccessor) 0

theorem
    fixedP506L0CompleteJointGlobalDevelopmentActual_p286GaugeAuxiliary_origin_zero :
    (diracDualFormNativePointwiseJointResidual positiveSmoothUnifiedSource
      fixedP506L0CompleteJointGlobalOriginClosureActual 0
      ).p286GaugeAuxiliary =
      0 := by
  change
    formNativeP286GaugeAuxiliaryEulerResidualAtBoundary
      (sourceGeneratedUnifiedCouplings positiveSmoothUnifiedSource)
      (toContinuumPointField
        fixedP506L0CompleteJointGlobalOriginClosureActual 0) = 0
  apply
    (formNativeP286GaugeAuxiliaryEulerResidual_eq_zero_iff
      (sourceGeneratedUnifiedCouplings positiveSmoothUnifiedSource)
      (toContinuumPointField
        fixedP506L0CompleteJointGlobalOriginClosureActual 0)).2
  simpa only [canonicalCauchySlicePoint_zero_zero] using
    fixedP506L0CompleteJointGlobalDevelopmentActual_p286AuxiliaryEquation_zeroSlice
      (0 : StageNineSpatialPoint)

theorem
    fixedP506L0CompleteJointGlobalDevelopmentActual_lorentzConnection_origin_zero :
    (diracDualFormNativePointwiseJointResidual positiveSmoothUnifiedSource
      fixedP506L0CompleteJointGlobalOriginClosureActual 0
      ).lorentzConnection =
      0 := by
  change
    holonomicFormNativeLorentzEulerThreeForm positiveSmoothUnifiedSource 0
      fixedP506L0CompleteJointGlobalOriginClosureActual 0 = 0
  have coframeSmooth :
      ContDiff ℝ ∞
        (completeJointGlobalP286Current positiveSmoothUnifiedSource
          FixedP506FormNativeJointActionSolvedSuccessor).coframe := by
    rw [←
      sourceActionGeneratedDiracDualCartanReactionCurrentRestart_coframe
        positiveSmoothUnifiedSource
        (completeJointGlobalP286Current positiveSmoothUnifiedSource
          FixedP506FormNativeJointActionSolvedSuccessor)]
    change ContDiff ℝ ∞
      fixedP506L0CompleteJointGlobalOriginClosureActual.coframe
    apply contDiff_pi'
    intro internal
    apply contDiff_pi'
    intro coordinate
    exact
      fixedP506L0CompleteJointGlobalDevelopmentActual_coframe_contDiff
        internal coordinate
  have nondegenerate :
      Matrix.det
        ((completeJointGlobalP286Current positiveSmoothUnifiedSource
          FixedP506FormNativeJointActionSolvedSuccessor).coframe 0) ≠ 0 := by
    rw [←
      sourceActionGeneratedDiracDualCartanReactionCurrentRestart_coframe
        positiveSmoothUnifiedSource
        (completeJointGlobalP286Current positiveSmoothUnifiedSource
          FixedP506FormNativeJointActionSolvedSuccessor)]
    change Matrix.det
      (fixedP506L0CompleteJointGlobalOriginClosureActual.coframe 0) ≠ 0
    simpa only [canonicalCauchySlicePoint_zero_zero] using
      fixedP506L0CompleteJointGlobalDevelopmentActual_coframe_nondegenerate_zeroSlice
        (0 : StageNineSpatialPoint)
  exact
    sourceActionGeneratedDiracDualCartanReactionCurrentRestart_lorentzEulerThreeForm_zero_at_of_coframeContDiff
      positiveSmoothUnifiedSource
      (completeJointGlobalP286Current positiveSmoothUnifiedSource
        FixedP506FormNativeJointActionSolvedSuccessor)
      coframeSmooth 0 nondegenerate

end

end
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeFixedP506CompleteJointGlobalDevelopmentOriginUnconditionalClosure
