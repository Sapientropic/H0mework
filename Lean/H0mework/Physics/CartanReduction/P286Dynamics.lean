import H0mework.Physics.CartanReduction.AlgebraicCartan
import H0mework.Physics.GaugeSource.CenteredReducedEntropyIteration

/-! A whole-field P286 action step that preserves the generated Cartan
constraint. The path commutation retains the exact quartic action law and
the original source-computed defect. -/

set_option autoImplicit false

namespace SaturationMonoid.PhysicsCore.Stage9C.Reduction

open ProofFreeRicherAnholonomicSource StageNineEnrichedProofFreeSource
open StageNineHolonomicField StageNineP286GaugeConnectionVariation
open StageNineCompactSupportIntegrationByParts
open StageNineGlobalIntegratedAction StageNineFormNativeGaugeAuxiliaryIntegratedVariation
open StageNineDiracDualFormNativeCartanReactionCurrentRestart
open StageNineDiracDualFormNativeCartanReactionCurrentRestartGlobalRegularity
open StageNineDiracDualFormNativeCartanConnectionActualization
open StageNineDiracDualFormNativeCartanConnectionLocalActualLift
open StageNineFormNativeGravityMultiplierAuxiliaryIntegratedVariation
open StageNineHolonomicGravityCurvatureVarianceNormalization
open StageNineFormNativeP286GaugeYangMillsReadout
open StageNineP286SourceNativeReducedEntropyDescent
open StageNineP286SourceNativeReducedCompactVariation
open StageNineP286SourceNativeCenteredReducedEntropySafeStep
open StageNineP286SourceNativeCenteredReducedEntropyIteration
open SU7MotherLieAlgebra

noncomputable section

local instance : Module.Finite ℝ P286LieBlockData :=
  StageNineP286SourceNativeReducedEntropyDescent.reducedEntropyP286ModuleFinite

local instance : Fintype P286CoordinateIndex :=
  StageNineP286SourceNativeReducedEntropyDescent.reducedEntropyP286CoordinateIndexFintype

local instance : IsTopologicalAddGroup P286CoordinateCarrier where
  toContinuousAdd := inferInstance
  toContinuousNeg := inferInstance

theorem cartan_gaugeVariation_commute
    (source : SmoothUnifiedSource) (current : StageNineHolonomicConfiguration)
    (variation : BasePoint → P286GaugeOneForm) (parameter : ℝ) :
    sourceActionGeneratedDiracDualCartanReactionCurrentRestart source
        (varyP286GaugeConnectionCoordinate current variation parameter) =
      varyP286GaugeConnectionCoordinate
        (sourceActionGeneratedDiracDualCartanReactionCurrentRestart source current)
        variation parameter := by
  have connection :
      (sourceActionGeneratedDiracDualCartanReactionCurrentRestart source
        (varyP286GaugeConnectionCoordinate current variation parameter)).gravityConnection =
      (sourceActionGeneratedDiracDualCartanReactionCurrentRestart source current).gravityConnection := by
    funext point
    change diracDualFormNativeActionCartanConnectionAt source
      (varyP286GaugeConnectionCoordinate current variation parameter) point =
        diracDualFormNativeActionCartanConnectionAt source current point
    unfold diracDualFormNativeActionCartanConnectionAt
      diracDualFormNativeActionCartanContorsionAt diracDualFormNativeActionCartanTorsionAt
    rw [diracDualFormNativeActionSpinResponseAt_eq_of_fields_at source
      (varyP286GaugeConnectionCoordinate current variation parameter) current point rfl rfl rfl]
    rfl
  apply StageNineHolonomicConfiguration.ext
  · rfl
  · exact connection
  · rfl
  · change formNativeGravityReactionField
        (sourceActionGeneratedDiracDualCartanReactionCurrentRestart source
          (varyP286GaugeConnectionCoordinate current variation parameter)) =
      formNativeGravityReactionField
        (sourceActionGeneratedDiracDualCartanReactionCurrentRestart source current)
    unfold formNativeGravityReactionField holonomicContravariantGravityCurvature
      holonomicGravityCurvature gravityConnectionDerivative
    rw [connection]
    rfl
  · rfl
  · rfl
  · rfl
  · rfl
  · rfl

/-- P286 dynamics retains the coframe and both matter fields read by the
whole-field Cartan connection. The same variation may be performed on either
side of that write. -/
theorem cartan_reducedPath_commute
    (source : SmoothUnifiedSource) (current : StageNineHolonomicConfiguration)
    (variation : CompactlySupportedSmoothVariation P286GaugeOneForm) (parameter : ℝ) :
    sourceActionGeneratedDiracDualCartanReactionCurrentRestart source
        (p286ReducedCompactJointPath source current variation parameter) =
      p286ReducedCompactJointPath source
        (sourceActionGeneratedDiracDualCartanReactionCurrentRestart source current)
        variation parameter := by
  unfold p286ReducedCompactJointPath p286ReducedCompactRawPath p286ReducedEntropyBase
  rw [cartan_constitutive_commute, cartan_gaugeVariation_commute,
    cartan_constitutive_commute]

/-- The next actual is generated by the source's complete reduced P286
action step, then its whole-field Cartan write. Neither defect nor next is
an input. -/
def p286CartanNext
    (source : SmoothUnifiedSource) (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth) (nondegenerate : current.Nondegenerate)
    (center : BasePoint) : StageNineHolonomicConfiguration :=
  sourceActionGeneratedDiracDualCartanReactionCurrentRestart source
    (p286CenteredReducedNext source current smooth nondegenerate center)

theorem p286CartanNext_smooth
    (source : SmoothUnifiedSource) (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth) (nondegenerate : current.Nondegenerate)
    (center : BasePoint) :
    (p286CartanNext source current smooth nondegenerate center).Smooth :=
  sourceActionGeneratedDiracDualCartanReactionCurrentRestart_smooth source _
    (p286CenteredReducedNext_smooth source current smooth nondegenerate center)
    (p286CenteredReducedNext_nondegenerate source current smooth nondegenerate center)

theorem p286CartanNext_nondegenerate
    (source : SmoothUnifiedSource) (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth) (nondegenerate : current.Nondegenerate)
    (center : BasePoint) :
    (p286CartanNext source current smooth nondegenerate center).Nondegenerate :=
  nondegenerate

theorem p286CartanNext_auxiliaryPointwiseEquation
    (source : SmoothUnifiedSource) (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth) (nondegenerate : current.Nondegenerate)
    (center : BasePoint) :
    FormNativeP286GaugeAuxiliaryPointwiseEquation source
      (p286CartanNext source current smooth nondegenerate center) :=
  p286CenteredReducedNext_auxiliaryPointwiseEquation source current smooth nondegenerate center

theorem p286CartanNext_eq_reducedNext_of_cartan_fixed
    (source : SmoothUnifiedSource) (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth) (nondegenerate : current.Nondegenerate)
    (center : BasePoint)
    (cartanFixed : sourceActionGeneratedDiracDualCartanReactionCurrentRestart
      source current = current) :
    p286CartanNext source current smooth nondegenerate center =
      p286CenteredReducedNext source current smooth nondegenerate center := by
  unfold p286CartanNext p286CenteredReducedNext
  rw [cartan_reducedPath_commute, cartanFixed]

theorem p286CartanNext_cartan_fixed
    (source : SmoothUnifiedSource) (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth) (nondegenerate : current.Nondegenerate)
    (center : BasePoint) :
    sourceActionGeneratedDiracDualCartanReactionCurrentRestart source
        (p286CartanNext source current smooth nondegenerate center) =
      p286CartanNext source current smooth nondegenerate center :=
  sourceActionGeneratedDiracDualCartanReactionCurrentRestart_idempotent source _

end
end SaturationMonoid.PhysicsCore.Stage9C.Reduction
