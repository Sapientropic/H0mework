import H0mework.Physics.RunningSources.P385

/-!
# Proposition 386: finite RG-step paths produce the grand-unification receipt

P385 lowers the remaining P383 RG producer to a scalar coordinate monotonicity
certificate.  This file lowers the same target in the direction a concrete
threshold / breaking-chain computation usually has: local adjacent RG steps.

The key move is to make the RG corridor a finite path closure.  If every
selected Yukawa scale reaches the weak endpoint through finitely many certified
steps, and `g^2` is monotone on each step, then `g^2` is monotone on the whole
reachable corridor by transitivity.  That supplies P383, hence the P384
grand-unification receipt.

Boundary: this still does not construct the physical step graph or beta /
threshold inequalities.  It specifies the smaller certificate a concrete
SU(7)-breaking / RG calculation should output: paths plus adjacent
monotonicity checks.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

/-! ## Finite RG-step reachability -/

/-- Reflexive-transitive finite reachability generated by local RG steps. -/
inductive RGStepReach
    (step : StandardModelScaleCode -> StandardModelScaleCode -> Prop) :
    StandardModelScaleCode -> StandardModelScaleCode -> Prop where
  | refl (a : StandardModelScaleCode) : RGStepReach step a a
  | tail {a b c : StandardModelScaleCode} :
      RGStepReach step a b -> step b c -> RGStepReach step a c

namespace RGStepReach

variable {step : StandardModelScaleCode -> StandardModelScaleCode -> Prop}

/-- THEOREM 1: local monotonicity of `g^2` along RG steps extends to every
finite reachable path. -/
theorem gaugeCouplingSq_monotone
    {Index A CKMCarrier : Type*} [AddCommGroup A]
    (Z : ZeroContinuousFreeStandardModelCertificate Index A ℝ CKMCarrier)
    (hstep :
      ∀ {a b : StandardModelScaleCode}, step a b ->
        (Z.running.gaugeCoupling a) ^ (2 : Nat) ≤
          (Z.running.gaugeCoupling b) ^ (2 : Nat))
    {a b : StandardModelScaleCode} :
    RGStepReach step a b ->
      (Z.running.gaugeCoupling a) ^ (2 : Nat) ≤
        (Z.running.gaugeCoupling b) ^ (2 : Nat) := by
  intro h
  induction h with
  | refl =>
      exact le_rfl
  | tail hreach hbc ih =>
      exact le_trans ih (hstep hbc)

end RGStepReach

/-! ## Step-path RG producer -/

/-- A concrete RG-step producer: selected Yukawa scales reach the weak endpoint
through finite local steps, and each step satisfies the adjacent `g^2`
monotonicity inequality. -/
structure RGStepPathProducer
    {Index A CKMCarrier : Type*} [AddCommGroup A]
    (Z : ZeroContinuousFreeStandardModelCertificate Index A ℝ CKMCarrier) where
  step : StandardModelScaleCode -> StandardModelScaleCode -> Prop
  fourPi_pos : 0 < Z.running.fourPi
  selected_yukawa_reaches_weak :
    ∀ y : YukawaParameter,
      RGStepReach step (StandardModelScaleCode.yukawa y)
        StandardModelScaleCode.weak
  gaugeCouplingSq_step_monotone :
    ∀ {a b : StandardModelScaleCode}, step a b ->
      (Z.running.gaugeCoupling a) ^ (2 : Nat) ≤
        (Z.running.gaugeCoupling b) ^ (2 : Nat)

namespace RGStepPathProducer

variable {Index A CKMCarrier : Type*} [AddCommGroup A]
variable {Z : ZeroContinuousFreeStandardModelCertificate Index A ℝ CKMCarrier}

/-- A step-path producer generates P383's RG monotonicity certificate by taking
the scale relation to be finite reachability. -/
def toSelectedYukawaRGMonotonicityCertificate
    (C : RGStepPathProducer Z) :
    SelectedYukawaRGMonotonicityCertificate Z :=
  { scaleLe := RGStepReach C.step
    fourPi_pos := C.fourPi_pos
    selected_yukawa_le_weak := C.selected_yukawa_reaches_weak
    gaugeCouplingSq_monotone :=
      fun h =>
        RGStepReach.gaugeCouplingSq_monotone Z
          C.gaugeCouplingSq_step_monotone h }

/-- THEOREM 3: a step-path producer gives P382's gauge weak corridor. -/
theorem toSelectedYukawaGaugeCouplingsBoundedByWeak
    (C : RGStepPathProducer Z) :
    SelectedYukawaGaugeCouplingsBoundedByWeak Z :=
  selectedYukawaGaugeCouplingsBoundedByWeak_of_rgMonotonicity Z
    C.toSelectedYukawaRGMonotonicityCertificate

end RGStepPathProducer

/-- A zero-free certificate equipped with the finite RG-step producer. -/
def ExistsZeroFreeRGStepPathProducer
    (Index A CKMCarrier : Type*) [AddCommGroup A] : Prop :=
  ∃ Z : ZeroContinuousFreeStandardModelCertificate Index A ℝ CKMCarrier,
    Nonempty (RGStepPathProducer Z)

/-- THEOREM 4: finite RG-step paths supply P383's RG monotonicity corridor. -/
theorem existsZeroFreeRGMonotonicityCorridor_of_stepPathProducer
    {Index A CKMCarrier : Type*} [AddCommGroup A] :
    ExistsZeroFreeRGStepPathProducer Index A CKMCarrier ->
      ExistsZeroFreeRGMonotonicityCorridor Index A CKMCarrier := by
  rintro ⟨Z, ⟨C⟩⟩
  exact ⟨Z, ⟨C.toSelectedYukawaRGMonotonicityCertificate⟩⟩

/-- THEOREM 5: finite RG-step paths construct the P384 grand-unification
receipt. -/
theorem rgMonotonicityGrandUnificationReceipt_nonempty_of_stepPathProducer
    {Index A CKMCarrier : Type*} [AddCommGroup A] :
    ExistsZeroFreeRGStepPathProducer Index A CKMCarrier ->
      Nonempty (RGMonotonicityGrandUnificationReceipt Index A CKMCarrier) := by
  intro h
  exact
    rgMonotonicityGrandUnificationReceipt_nonempty_of_exists
      (existsZeroFreeRGMonotonicityCorridor_of_stepPathProducer h)

/-- THEOREM 6: finite RG-step paths therefore provide the P374 unified-formula
spine. -/
theorem unifiedFormulaSpine_nonempty_of_stepPathProducer
    {Index A CKMCarrier : Type*} [AddCommGroup A] :
    ExistsZeroFreeRGStepPathProducer Index A CKMCarrier ->
      Nonempty (StandardModelUnifiedFormulaSpineCertificate Index A CKMCarrier) := by
  intro h
  exact
    unifiedFormulaSpine_nonempty_iff_rgMonotonicityReceipt_nonempty
      (rgMonotonicityGrandUnificationReceipt_nonempty_of_stepPathProducer h)

/-- THEOREM 7: finite RG-step paths also provide the primitive producer atoms. -/
theorem primitiveProducerAtoms_nonempty_of_stepPathProducer
    {Index A CKMCarrier : Type*} [AddCommGroup A] :
    ExistsZeroFreeRGStepPathProducer Index A CKMCarrier ->
      Nonempty (GrandUnificationPrimitiveProducerAtoms Index A CKMCarrier) := by
  intro h
  exact
    primitiveProducerAtoms_nonempty_iff_rgMonotonicityReceipt_nonempty
      (rgMonotonicityGrandUnificationReceipt_nonempty_of_stepPathProducer h)

end StandardModelConstraint
end SaturationMonoid
