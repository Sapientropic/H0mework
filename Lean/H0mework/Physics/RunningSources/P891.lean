import H0mework.Physics.AlphaSources.P890

/-!
# Proposition 891: running-sigma beta-order producer for the alpha_s RG zero

P885 removed the counterterm-shaped RG receipt: the paired finite-spectrum
imbalance is already zero, so every loop-order image of it is zero.  Its loop
orders were still the bare finite spectra `Fin 2` and `Fin 3`.

This file lowers those orders to the running-sigma beta carrier:

* P451 proves that residual/complement self-bump has quadratic beta form
  `σ' - σ = -b0 σ^2`;
* the first correction order is the successor of that quadratic order;
* the alpha-strong RG coordinate is the paired-spectrum imbalance transported
  along those beta-order spectra.

Thus the RG zero source is now anchored in the residual beta-order structure
rather than in displayed `Fin 2 / Fin 3` loop-order names.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open RunningSigmaBeta
open scoped BigOperators

set_option linter.defProp false

/-! ## Running-sigma beta-order producer -/

/-- The running-sigma beta-order producer.  The quadratic order is the
monomial degree forced by residual/complement self-bump; the next correction
order is its successor. -/
structure RunningSigmaBetaOrderProducer where
  quadraticOrder : ℕ
  nextCorrectionOrder : ℕ
  quadraticLaw :
    ∀ (C : OneLoopCarrier) (σ : ℝ),
      C.residualSelfBumpStep σ - σ = -C.b0 * σ ^ quadraticOrder
  next_eq_succ :
    nextCorrectionOrder = quadraticOrder + 1

/-- Canonical running-sigma beta-order producer supplied by P451. -/
def runningSigmaBetaOrderProducer : RunningSigmaBetaOrderProducer where
  quadraticOrder := 2
  nextCorrectionOrder := 3
  quadraticLaw := by
    intro C σ
    exact OneLoopCarrier.residualSelfBumpStep_delta_eq_oneLoop C σ
  next_eq_succ := by
    norm_num

/-- THEOREM 1: the residual beta order is quadratic. -/
theorem runningSigmaBetaOrderProducer_quadratic_eq_two :
    runningSigmaBetaOrderProducer.quadraticOrder = 2 := rfl

/-- THEOREM 2: the next correction order is cubic. -/
theorem runningSigmaBetaOrderProducer_next_eq_three :
    runningSigmaBetaOrderProducer.nextCorrectionOrder = 3 := rfl

/-- THEOREM 3: the quadratic order law is exactly P451's residual beta law. -/
theorem runningSigmaBetaOrderProducer_quadraticLaw
    (C : OneLoopCarrier) (σ : ℝ) :
    C.residualSelfBumpStep σ - σ =
      -C.b0 * σ ^ runningSigmaBetaOrderProducer.quadraticOrder :=
  runningSigmaBetaOrderProducer.quadraticLaw C σ

/-- THEOREM 4: the correction order is the successor of the quadratic order.
-/
theorem runningSigmaBetaOrderProducer_next_succ :
    runningSigmaBetaOrderProducer.nextCorrectionOrder =
      runningSigmaBetaOrderProducer.quadraticOrder + 1 :=
  runningSigmaBetaOrderProducer.next_eq_succ

/-! ## Beta-order spectra -/

/-- Alpha-strong RG order spectrum generated by the quadratic running-sigma
beta order. -/
abbrev AlphaStrongRunningSigmaQuadraticOrderSpectrum :=
  Fin runningSigmaBetaOrderProducer.quadraticOrder

/-- Alpha-strong RG correction spectrum generated by the successor beta order.
-/
abbrev AlphaStrongRunningSigmaCorrectionOrderSpectrum :=
  Fin runningSigmaBetaOrderProducer.nextCorrectionOrder

/-- THEOREM 5: the quadratic beta-order spectrum has trace `2`. -/
theorem alphaStrongRunningSigmaQuadraticOrderTrace_eq_two :
    finiteUnitSpectrumTrace AlphaStrongRunningSigmaQuadraticOrderSpectrum =
      2 := by
  unfold AlphaStrongRunningSigmaQuadraticOrderSpectrum
  rw [finiteUnitSpectrumTrace_eq_card,
    runningSigmaBetaOrderProducer_quadratic_eq_two]
  norm_num

/-- THEOREM 6: the successor correction-order spectrum has trace `3`. -/
theorem alphaStrongRunningSigmaCorrectionOrderTrace_eq_three :
    finiteUnitSpectrumTrace AlphaStrongRunningSigmaCorrectionOrderSpectrum =
      3 := by
  unfold AlphaStrongRunningSigmaCorrectionOrderSpectrum
  rw [finiteUnitSpectrumTrace_eq_card,
    runningSigmaBetaOrderProducer_next_eq_three]
  norm_num

/-- THEOREM 7: the quadratic beta-order spectrum reproduces P858's two-loop
order trace. -/
theorem alphaStrongRunningSigmaQuadraticOrderTrace_eq_p858 :
    finiteUnitSpectrumTrace AlphaStrongRunningSigmaQuadraticOrderSpectrum =
      finiteUnitSpectrumTrace AlphaStrongTwoLoopOrderSpectrum := by
  rw [alphaStrongRunningSigmaQuadraticOrderTrace_eq_two]
  change (2 : ℚ) = alphaStrongGeneratedTwoLoopWeight
  exact alphaStrongGeneratedTwoLoopWeight_eq_two.symm

/-- THEOREM 8: the successor correction-order spectrum reproduces P858's
three-loop order trace. -/
theorem alphaStrongRunningSigmaCorrectionOrderTrace_eq_p858 :
    finiteUnitSpectrumTrace AlphaStrongRunningSigmaCorrectionOrderSpectrum =
      finiteUnitSpectrumTrace AlphaStrongThreeLoopOrderSpectrum := by
  rw [alphaStrongRunningSigmaCorrectionOrderTrace_eq_three]
  change (3 : ℚ) = alphaStrongGeneratedThreeLoopWeight
  exact alphaStrongGeneratedThreeLoopWeight_eq_three.symm

/-! ## RG coordinate from beta-order spectra -/

/-- RG coordinate generated from running-sigma beta-order spectra acting on the
paired finite-spectrum imbalance. -/
def alphaStrongRunningSigmaBetaOrderRGCoordinate : ℚ :=
  alphaStrongPairedSpectrumLoopOrderRawCoordinate
      AlphaStrongRunningSigmaQuadraticOrderSpectrum +
    alphaStrongPairedSpectrumLoopOrderRawCoordinate
      AlphaStrongRunningSigmaCorrectionOrderSpectrum

/-- THEOREM 9: the running-sigma beta-order RG coordinate vanishes because the
paired finite-spectrum imbalance vanishes. -/
theorem alphaStrongRunningSigmaBetaOrderRGCoordinate_eq_zero :
    alphaStrongRunningSigmaBetaOrderRGCoordinate = 0 := by
  unfold alphaStrongRunningSigmaBetaOrderRGCoordinate
  rw [alphaStrongPairedSpectrumLoopOrderRawCoordinate_eq_zero,
    alphaStrongPairedSpectrumLoopOrderRawCoordinate_eq_zero]
  norm_num

/-- THEOREM 10: the running-sigma beta-order RG coordinate agrees with P885's
counterterm-free paired-spectrum RG coordinate. -/
theorem alphaStrongRunningSigmaBetaOrderRGCoordinate_eq_p885 :
    alphaStrongRunningSigmaBetaOrderRGCoordinate =
      alphaStrongPairedSpectrumCountertermFreeRGCoordinate := by
  rw [alphaStrongRunningSigmaBetaOrderRGCoordinate_eq_zero,
    alphaStrongPairedSpectrumCountertermFreeRGCoordinate_eq_zero]

/-! ## Alpha_s vector with running-sigma beta-order RG source -/

/-- Four-source vector whose RG coordinate is generated from running-sigma
beta-order spectra. -/
def alphaStrongRunningSigmaBetaOrderFourSourceVector :
    AlphaStrongResidualSource -> ℚ
  | .su7Breaking =>
      alphaStrongNoFreeHiggsExtraFourSourceVector .su7Breaking
  | .threshold =>
      alphaStrongNoFreeHiggsExtraFourSourceVector .threshold
  | .threeLoopRG => alphaStrongRunningSigmaBetaOrderRGCoordinate
  | .higgsExtraRepresentation =>
      alphaStrongNoFreeHiggsExtraFourSourceVector .higgsExtraRepresentation

/-- THEOREM 11: replacing the RG coordinate by the running-sigma beta-order
producer leaves the P890 vector unchanged. -/
theorem alphaStrongRunningSigmaBetaOrderFourSourceVector_eq_p890 :
    alphaStrongRunningSigmaBetaOrderFourSourceVector =
      alphaStrongNoFreeHiggsExtraFourSourceVector := by
  funext source
  cases source
  · rfl
  · rfl
  · calc
      alphaStrongRunningSigmaBetaOrderFourSourceVector .threeLoopRG =
          alphaStrongRunningSigmaBetaOrderRGCoordinate := rfl
      _ = alphaStrongPairedSpectrumCountertermFreeRGCoordinate :=
          alphaStrongRunningSigmaBetaOrderRGCoordinate_eq_p885
      _ = alphaStrongNoFreeHiggsExtraFourSourceVector .threeLoopRG := rfl
  · rfl

/-- THEOREM 12: the running-sigma beta-order vector transports to the exact
inverse alpha_s residual. -/
theorem alphaStrongRunningSigmaBetaOrderFourSourceVector_outputs_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          alphaStrongRunningSigmaBetaOrderFourSourceVector s) =
      -((89000 : ℚ) / 128511) := by
  rw [alphaStrongRunningSigmaBetaOrderFourSourceVector_eq_p890]
  exact alphaStrongNoFreeHiggsExtraFourSourceVector_outputs_residual

/-! ## Certificate -/

/-- P891 certificate: the RG zero source is generated from running-sigma
beta-order spectra rather than bare loop-order names. -/
structure AlphaStrongRunningSigmaBetaOrderRGProducerCertificate : Prop where
  quadratic_order :
    runningSigmaBetaOrderProducer.quadraticOrder = 2
  next_order :
    runningSigmaBetaOrderProducer.nextCorrectionOrder = 3
  quadratic_law :
    ∀ (C : OneLoopCarrier) (σ : ℝ),
      C.residualSelfBumpStep σ - σ =
        -C.b0 * σ ^ runningSigmaBetaOrderProducer.quadraticOrder
  next_succ :
    runningSigmaBetaOrderProducer.nextCorrectionOrder =
      runningSigmaBetaOrderProducer.quadraticOrder + 1
  quadratic_trace :
    finiteUnitSpectrumTrace AlphaStrongRunningSigmaQuadraticOrderSpectrum =
      2
  correction_trace :
    finiteUnitSpectrumTrace AlphaStrongRunningSigmaCorrectionOrderSpectrum =
      3
  rg_zero :
    alphaStrongRunningSigmaBetaOrderRGCoordinate = 0
  rg_p885 :
    alphaStrongRunningSigmaBetaOrderRGCoordinate =
      alphaStrongPairedSpectrumCountertermFreeRGCoordinate
  vector_p890 :
    alphaStrongRunningSigmaBetaOrderFourSourceVector =
      alphaStrongNoFreeHiggsExtraFourSourceVector
  inverse_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          alphaStrongRunningSigmaBetaOrderFourSourceVector s) =
      -((89000 : ℚ) / 128511)

/-- THEOREM 13: canonical running-sigma beta-order RG producer certificate. -/
def alphaStrongRunningSigmaBetaOrderRGProducerCertificate :
    AlphaStrongRunningSigmaBetaOrderRGProducerCertificate where
  quadratic_order := runningSigmaBetaOrderProducer_quadratic_eq_two
  next_order := runningSigmaBetaOrderProducer_next_eq_three
  quadratic_law := runningSigmaBetaOrderProducer_quadraticLaw
  next_succ := runningSigmaBetaOrderProducer_next_succ
  quadratic_trace := alphaStrongRunningSigmaQuadraticOrderTrace_eq_two
  correction_trace := alphaStrongRunningSigmaCorrectionOrderTrace_eq_three
  rg_zero := alphaStrongRunningSigmaBetaOrderRGCoordinate_eq_zero
  rg_p885 := alphaStrongRunningSigmaBetaOrderRGCoordinate_eq_p885
  vector_p890 := alphaStrongRunningSigmaBetaOrderFourSourceVector_eq_p890
  inverse_residual :=
    alphaStrongRunningSigmaBetaOrderFourSourceVector_outputs_residual


end
end StandardModelConstraint
end SaturationMonoid
