import H0mework.Physics.BranchSources.P884
import H0mework.Physics.RunningSources.P858

/-!
# Proposition 885: counterterm-free paired-spectrum RG source

P877 generated the `alpha_s` threshold and Higgs/extra zero coordinates from
paired finite representation spectra.  Its RG coordinate was still presented
as a loop raw coordinate plus its source-law counterterm.

This file removes that extra cancellation from the balanced case.  The paired
finite-spectrum imbalance is already zero, so the two- and three-loop RG
coordinate is zero as the linear image of that paired imbalance.  The final
four-source vector can therefore use the raw paired-spectrum RG coordinate
directly, without a counterterm-shaped `x + (-x)` receipt.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open scoped BigOperators

set_option linter.defProp false

/-! ## Raw paired-spectrum RG coordinate -/

/-- Raw RG coordinate generated by a loop-order spectrum acting on the paired
finite-spectrum imbalance. -/
def alphaStrongPairedSpectrumLoopOrderRawCoordinate
    (ι : Type*) [Fintype ι] : ℚ :=
  finiteUnitSpectrumTrace ι *
    alphaStrongPairedSpectrumFiniteLoopImbalance

/-- THEOREM 1: every paired-spectrum loop-order raw coordinate is zero because
the paired finite-spectrum imbalance is zero. -/
theorem alphaStrongPairedSpectrumLoopOrderRawCoordinate_eq_zero
    (ι : Type*) [Fintype ι] :
    alphaStrongPairedSpectrumLoopOrderRawCoordinate ι = 0 := by
  unfold alphaStrongPairedSpectrumLoopOrderRawCoordinate
  rw [alphaStrongPairedSpectrumFiniteLoopImbalance_eq_zero]
  ring

/-- THEOREM 2: the loop-order raw coordinate agrees with P877's raw coordinate
at the generated loop-order trace. -/
theorem alphaStrongPairedSpectrumLoopOrderRawCoordinate_eq_p877
    (ι : Type*) [Fintype ι] :
    alphaStrongPairedSpectrumLoopOrderRawCoordinate ι =
      alphaStrongPairedSpectrumLoopRawCoordinate
        (finiteUnitSpectrumTrace ι) := by
  rfl

/-- Counterterm-free paired-spectrum two/three-loop RG coordinate. -/
def alphaStrongPairedSpectrumCountertermFreeRGCoordinate : ℚ :=
  alphaStrongPairedSpectrumLoopOrderRawCoordinate
      AlphaStrongTwoLoopOrderSpectrum +
    alphaStrongPairedSpectrumLoopOrderRawCoordinate
      AlphaStrongThreeLoopOrderSpectrum

/-- THEOREM 3: the counterterm-free paired-spectrum RG coordinate is zero. -/
theorem alphaStrongPairedSpectrumCountertermFreeRGCoordinate_eq_zero :
    alphaStrongPairedSpectrumCountertermFreeRGCoordinate = 0 := by
  unfold alphaStrongPairedSpectrumCountertermFreeRGCoordinate
  rw [alphaStrongPairedSpectrumLoopOrderRawCoordinate_eq_zero,
    alphaStrongPairedSpectrumLoopOrderRawCoordinate_eq_zero]
  norm_num

/-- THEOREM 4: the counterterm-free paired-spectrum RG coordinate agrees with
P877's source-law-renormalized coordinate in the balanced paired-spectrum
case. -/
theorem alphaStrongPairedSpectrumCountertermFreeRGCoordinate_eq_p877 :
    alphaStrongPairedSpectrumCountertermFreeRGCoordinate =
      alphaStrongPairedSpectrumThreeLoopRGCoordinate := by
  rw [alphaStrongPairedSpectrumCountertermFreeRGCoordinate_eq_zero,
    alphaStrongPairedSpectrumThreeLoopRGCoordinate_eq_zero]

/-- THEOREM 5: the counterterm-free paired-spectrum RG coordinate agrees with
the generated representation-spectrum RG coordinate. -/
theorem alphaStrongPairedSpectrumCountertermFreeRGCoordinate_eq_generated :
    alphaStrongPairedSpectrumCountertermFreeRGCoordinate =
      alphaStrongGeneratedThreeLoopRGCoordinate := by
  rw [alphaStrongPairedSpectrumCountertermFreeRGCoordinate_eq_zero,
    alphaStrongGeneratedThreeLoopRGCoordinate_eq_zero]

/-! ## Counterterm-free four-source vector -/

/-- Four-source vector whose RG coordinate is the raw paired-spectrum
loop-order image, not a counterterm cancellation. -/
def alphaStrongPairedSpectrumCountertermFreeFourSourceVector :
    AlphaStrongResidualSource -> ℚ
  | .su7Breaking =>
      alphaStrongGeneratedRepresentationFourSourceVector .su7Breaking
  | .threshold => thresholdPairedSpectrumContribution
  | .threeLoopRG => alphaStrongPairedSpectrumCountertermFreeRGCoordinate
  | .higgsExtraRepresentation => higgsExtraPairedSpectrumContribution

/-- THEOREM 6: the counterterm-free paired-spectrum vector is the P856
generated representation-spectrum vector. -/
theorem alphaStrongPairedSpectrumCountertermFreeFourSourceVector_eq_generated :
    alphaStrongPairedSpectrumCountertermFreeFourSourceVector =
      alphaStrongGeneratedRepresentationFourSourceVector := by
  funext source
  cases source
  · rfl
  · calc
      alphaStrongPairedSpectrumCountertermFreeFourSourceVector .threshold =
          0 := thresholdPairedSpectrumContribution_eq_zero
      _ = alphaStrongGeneratedRepresentationFourSourceVector .threshold :=
          alphaStrongGeneratedRepresentationFourSourceVector_threshold.symm
  · calc
      alphaStrongPairedSpectrumCountertermFreeFourSourceVector .threeLoopRG =
          0 := alphaStrongPairedSpectrumCountertermFreeRGCoordinate_eq_zero
      _ = alphaStrongGeneratedRepresentationFourSourceVector .threeLoopRG :=
          alphaStrongGeneratedRepresentationFourSourceVector_threeLoopRG.symm
  · calc
      alphaStrongPairedSpectrumCountertermFreeFourSourceVector
          .higgsExtraRepresentation = 0 :=
          higgsExtraPairedSpectrumContribution_eq_zero
      _ =
          alphaStrongGeneratedRepresentationFourSourceVector
            .higgsExtraRepresentation :=
          alphaStrongGeneratedRepresentationFourSourceVector_higgsExtra.symm

/-- THEOREM 7: the counterterm-free paired-spectrum vector transports to the
exact inverse alpha_s residual. -/
theorem alphaStrongPairedSpectrumCountertermFreeFourSourceVector_outputs_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          alphaStrongPairedSpectrumCountertermFreeFourSourceVector s) =
      -((89000 : ℚ) / 128511) := by
  rw [alphaStrongPairedSpectrumCountertermFreeFourSourceVector_eq_generated]
  exact alphaStrongGeneratedRepresentationFourSourceVector_outputs_residual

/-! ## Certificate -/

/-- P885 certificate: for the balanced paired-spectrum source, the RG zero
coordinate is generated before counterterm cancellation. -/
structure AlphaStrongCountertermFreePairedSpectrumRGProducerCertificate :
    Prop where
  loop_order_raw_zero :
    ∀ ι : Type*, ∀ _ : Fintype ι,
      alphaStrongPairedSpectrumLoopOrderRawCoordinate ι = 0
  rg_raw_zero :
    alphaStrongPairedSpectrumCountertermFreeRGCoordinate = 0
  rg_agrees_p877 :
    alphaStrongPairedSpectrumCountertermFreeRGCoordinate =
      alphaStrongPairedSpectrumThreeLoopRGCoordinate
  rg_agrees_generated :
    alphaStrongPairedSpectrumCountertermFreeRGCoordinate =
      alphaStrongGeneratedThreeLoopRGCoordinate
  vector_eq_generated :
    alphaStrongPairedSpectrumCountertermFreeFourSourceVector =
      alphaStrongGeneratedRepresentationFourSourceVector
  inverse_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          alphaStrongPairedSpectrumCountertermFreeFourSourceVector s) =
      -((89000 : ℚ) / 128511)

/-- THEOREM 8: canonical counterterm-free paired-spectrum RG producer
certificate. -/
def alphaStrongCountertermFreePairedSpectrumRGProducerCertificate :
    AlphaStrongCountertermFreePairedSpectrumRGProducerCertificate where
  loop_order_raw_zero := by
    intro ι _
    exact alphaStrongPairedSpectrumLoopOrderRawCoordinate_eq_zero ι
  rg_raw_zero :=
    alphaStrongPairedSpectrumCountertermFreeRGCoordinate_eq_zero
  rg_agrees_p877 :=
    alphaStrongPairedSpectrumCountertermFreeRGCoordinate_eq_p877
  rg_agrees_generated :=
    alphaStrongPairedSpectrumCountertermFreeRGCoordinate_eq_generated
  vector_eq_generated :=
    alphaStrongPairedSpectrumCountertermFreeFourSourceVector_eq_generated
  inverse_residual :=
    alphaStrongPairedSpectrumCountertermFreeFourSourceVector_outputs_residual


end
end StandardModelConstraint
end SaturationMonoid
