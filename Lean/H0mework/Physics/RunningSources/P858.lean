import H0mework.Physics.AlphaSpectrum.P857

/-!
# Proposition 858: alpha strong RG weights from loop spectra

P857 removed the packet denominator from the alpha-strong vector.  This file
removes the remaining displayed RG loop weights: the two- and three-loop
weights are generated by finite loop spectra `Fin 2` and `Fin 3`.

The RG coordinate is therefore:

`trace(Fin 2) * finiteImbalance + counterterm`
plus
`trace(Fin 3) * finiteImbalance + counterterm`.

It is then welded back to the P857 no-packet vector and the exact inverse
residual.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open scoped BigOperators

set_option linter.defProp false

/-- Two-loop order spectrum. -/
abbrev AlphaStrongTwoLoopOrderSpectrum := Fin 2

/-- Three-loop order spectrum. -/
abbrev AlphaStrongThreeLoopOrderSpectrum := Fin 3

/-- Generated two-loop weight. -/
def alphaStrongGeneratedTwoLoopWeight : ℚ :=
  finiteUnitSpectrumTrace AlphaStrongTwoLoopOrderSpectrum

/-- Generated three-loop weight. -/
def alphaStrongGeneratedThreeLoopWeight : ℚ :=
  finiteUnitSpectrumTrace AlphaStrongThreeLoopOrderSpectrum

theorem alphaStrongGeneratedTwoLoopWeight_eq_two :
    alphaStrongGeneratedTwoLoopWeight = 2 := by
  unfold alphaStrongGeneratedTwoLoopWeight AlphaStrongTwoLoopOrderSpectrum
  rw [finiteUnitSpectrumTrace_eq_card]
  norm_num

theorem alphaStrongGeneratedThreeLoopWeight_eq_three :
    alphaStrongGeneratedThreeLoopWeight = 3 := by
  unfold alphaStrongGeneratedThreeLoopWeight AlphaStrongThreeLoopOrderSpectrum
  rw [finiteUnitSpectrumTrace_eq_card]
  norm_num

/-- Raw loop coordinate whose weight is generated by a finite loop-order
spectrum. -/
def alphaStrongLoopSpectrumRawCoordinate
    (ι : Type*) [Fintype ι] : ℚ :=
  finiteUnitSpectrumTrace ι * alphaStrongGeneratedFiniteLoopImbalance

theorem alphaStrongLoopSpectrumRawCoordinate_eq_zero
    (ι : Type*) [Fintype ι] :
    alphaStrongLoopSpectrumRawCoordinate ι = 0 := by
  unfold alphaStrongLoopSpectrumRawCoordinate
  rw [alphaStrongGeneratedFiniteLoopImbalance_eq_zero]
  ring

theorem alphaStrongLoopSpectrumRawCoordinate_eq_generated
    (ι : Type*) [Fintype ι] :
    alphaStrongLoopSpectrumRawCoordinate ι =
      alphaStrongGeneratedLoopRawCoordinate (finiteUnitSpectrumTrace ι) := by
  rfl

/-- Renormalized loop coordinate generated from a finite loop-order spectrum. -/
def alphaStrongLoopSpectrumRenormalizedCoordinate
    (ι : Type*) [Fintype ι] : ℚ :=
  alphaStrongLoopSpectrumRawCoordinate ι +
    (-alphaStrongLoopSpectrumRawCoordinate ι)

theorem alphaStrongLoopSpectrumRenormalizedCoordinate_eq_zero
    (ι : Type*) [Fintype ι] :
    alphaStrongLoopSpectrumRenormalizedCoordinate ι = 0 := by
  unfold alphaStrongLoopSpectrumRenormalizedCoordinate
  ring

theorem alphaStrongLoopSpectrumRenormalizedCoordinate_eq_generated
    (ι : Type*) [Fintype ι] :
    alphaStrongLoopSpectrumRenormalizedCoordinate ι =
      alphaStrongGeneratedLoopRenormalizedCoordinate
        (finiteUnitSpectrumTrace ι) := by
  rfl

/-- The RG coordinate with both loop weights generated from finite spectra. -/
def alphaStrongLoopSpectrumGeneratedRGCoordinate : ℚ :=
  alphaStrongLoopSpectrumRenormalizedCoordinate
      AlphaStrongTwoLoopOrderSpectrum +
    alphaStrongLoopSpectrumRenormalizedCoordinate
      AlphaStrongThreeLoopOrderSpectrum

theorem alphaStrongLoopSpectrumGeneratedRGCoordinate_eq_zero :
    alphaStrongLoopSpectrumGeneratedRGCoordinate = 0 := by
  unfold alphaStrongLoopSpectrumGeneratedRGCoordinate
  rw [alphaStrongLoopSpectrumRenormalizedCoordinate_eq_zero,
    alphaStrongLoopSpectrumRenormalizedCoordinate_eq_zero]
  norm_num

theorem alphaStrongLoopSpectrumGeneratedRGCoordinate_eq_p856 :
    alphaStrongLoopSpectrumGeneratedRGCoordinate =
      alphaStrongGeneratedThreeLoopRGCoordinate := by
  unfold alphaStrongLoopSpectrumGeneratedRGCoordinate
    alphaStrongGeneratedThreeLoopRGCoordinate
  rw [alphaStrongLoopSpectrumRenormalizedCoordinate_eq_generated,
    alphaStrongLoopSpectrumRenormalizedCoordinate_eq_generated]
  change
    alphaStrongGeneratedLoopRenormalizedCoordinate
        alphaStrongGeneratedTwoLoopWeight +
      alphaStrongGeneratedLoopRenormalizedCoordinate
        alphaStrongGeneratedThreeLoopWeight =
        alphaStrongGeneratedLoopRenormalizedCoordinate 2 +
          alphaStrongGeneratedLoopRenormalizedCoordinate 3
  rw [alphaStrongGeneratedTwoLoopWeight_eq_two,
    alphaStrongGeneratedThreeLoopWeight_eq_three]

/-- Fully generated four-source vector: source numerator, zero-source balances,
RG loop weights, and denominator all come from finite spectra. -/
def alphaStrongFullyGeneratedFourSourceVector :
    AlphaStrongResidualSource → ℚ
  | .su7Breaking =>
      alphaStrongSU7BreakingGeneratedImbalance /
        alphaStrongGeneratedResolutionDenominator
  | .threshold =>
      alphaStrongThresholdGeneratedImbalance /
        alphaStrongGeneratedResolutionDenominator
  | .threeLoopRG => alphaStrongLoopSpectrumGeneratedRGCoordinate
  | .higgsExtraRepresentation =>
      alphaStrongHiggsExtraGeneratedImbalance /
        alphaStrongGeneratedResolutionDenominator

theorem alphaStrongFullyGeneratedFourSourceVector_su7Breaking :
    alphaStrongFullyGeneratedFourSourceVector .su7Breaking =
      89 / 10000 := by
  unfold alphaStrongFullyGeneratedFourSourceVector
  rw [alphaStrongSU7BreakingGeneratedImbalance_eq_89,
    alphaStrongGeneratedResolutionDenominator_eq_10000]

theorem alphaStrongFullyGeneratedFourSourceVector_threshold :
    alphaStrongFullyGeneratedFourSourceVector .threshold = 0 := by
  unfold alphaStrongFullyGeneratedFourSourceVector
  rw [alphaStrongThresholdGeneratedImbalance_eq_zero]
  norm_num

theorem alphaStrongFullyGeneratedFourSourceVector_threeLoopRG :
    alphaStrongFullyGeneratedFourSourceVector .threeLoopRG = 0 := by
  unfold alphaStrongFullyGeneratedFourSourceVector
  exact alphaStrongLoopSpectrumGeneratedRGCoordinate_eq_zero

theorem alphaStrongFullyGeneratedFourSourceVector_higgsExtra :
    alphaStrongFullyGeneratedFourSourceVector .higgsExtraRepresentation =
      0 := by
  unfold alphaStrongFullyGeneratedFourSourceVector
  rw [alphaStrongHiggsExtraGeneratedImbalance_eq_zero]
  norm_num

theorem alphaStrongFullyGeneratedFourSourceVector_eq_noPacket :
    alphaStrongFullyGeneratedFourSourceVector =
      alphaStrongNoPacketGeneratedFourSourceVector := by
  funext source
  cases source
  · rw [alphaStrongFullyGeneratedFourSourceVector_su7Breaking,
      alphaStrongNoPacketGeneratedFourSourceVector_su7Breaking]
  · rw [alphaStrongFullyGeneratedFourSourceVector_threshold,
      alphaStrongNoPacketGeneratedFourSourceVector_threshold]
  · rw [alphaStrongFullyGeneratedFourSourceVector_threeLoopRG,
      alphaStrongNoPacketGeneratedFourSourceVector_threeLoopRG]
  · rw [alphaStrongFullyGeneratedFourSourceVector_higgsExtra,
      alphaStrongNoPacketGeneratedFourSourceVector_higgsExtra]

theorem alphaStrongFullyGeneratedFourSourceVector_eq_primitive :
    alphaStrongFullyGeneratedFourSourceVector =
      su7AlphaStrongFourSourcePrimitiveGenerator := by
  rw [alphaStrongFullyGeneratedFourSourceVector_eq_noPacket,
    alphaStrongNoPacketGeneratedFourSourceVector_eq_primitive]

theorem alphaStrongFullyGeneratedFourSourceVector_outputs_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          alphaStrongFullyGeneratedFourSourceVector s) =
      -((89000 : ℚ) / 128511) := by
  rw [alphaStrongFullyGeneratedFourSourceVector_eq_noPacket]
  exact alphaStrongNoPacketGeneratedFourSourceVector_outputs_residual

/-- Certificate: alpha-strong residual from fully generated finite spectra,
including the RG loop-order weights. -/
structure AlphaStrongFullyGeneratedSpectrumCertificate : Prop where
  twoLoopWeight :
    alphaStrongGeneratedTwoLoopWeight = 2
  threeLoopWeight :
    alphaStrongGeneratedThreeLoopWeight = 3
  rgCoordinate :
    alphaStrongLoopSpectrumGeneratedRGCoordinate = 0
  vectorNoPacket :
    alphaStrongFullyGeneratedFourSourceVector =
      alphaStrongNoPacketGeneratedFourSourceVector
  vectorPrimitive :
    alphaStrongFullyGeneratedFourSourceVector =
      su7AlphaStrongFourSourcePrimitiveGenerator
  residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          alphaStrongFullyGeneratedFourSourceVector s) =
      -((89000 : ℚ) / 128511)

def alphaStrongFullyGeneratedSpectrumCertificate :
    AlphaStrongFullyGeneratedSpectrumCertificate where
  twoLoopWeight := alphaStrongGeneratedTwoLoopWeight_eq_two
  threeLoopWeight := alphaStrongGeneratedThreeLoopWeight_eq_three
  rgCoordinate := alphaStrongLoopSpectrumGeneratedRGCoordinate_eq_zero
  vectorNoPacket := alphaStrongFullyGeneratedFourSourceVector_eq_noPacket
  vectorPrimitive := alphaStrongFullyGeneratedFourSourceVector_eq_primitive
  residual := alphaStrongFullyGeneratedFourSourceVector_outputs_residual


end
end StandardModelConstraint
end SaturationMonoid
