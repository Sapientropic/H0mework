import H0mework.Physics.GaugeStanding.VariationRegularity

/-!
# S9-C: variable-parameter scalar action jet

The scalar component of the linked active P286 tangent is a genuine
point-dependent bilinear action `rho(epsilon(x)) H(x)`.  This module proves
its directional Leibniz rule from the actual continuous bilinear map.

This is one input to scalar covariant-jet equivariance.  It does not assume
the still-required Lie-representation commutator law, a Ward identity,
stationarity, or a residual-zero receipt.
-/

open SaturationMonoid

namespace SaturationMonoid.PhysicsCore.StageNineP286LinkedActiveScalarJetAlgebra

open ProofFreeRicherAnholonomicSource
open StageNineHolonomicField
open StageNineP286GaugeConnectionVariationDensity
open StageNineP286InfinitesimalGaugeTransformation
open StageNineP286LinkedActiveVariation
open StageNineP286LinkedActiveVariationRegularity
open SU7MotherGaugeTheory
open SU7MotherLieAlgebra

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 300000

local instance p286ModuleFinite : Module.Finite ℝ P286LieBlockData :=
  FiniteDimensional.of_injective p286AmbientLinear
    p286AmbientLinear_injective

local instance p286CoordinateIndexFintype : Fintype P286CoordinateIndex :=
  StageNineP286InfinitesimalGaugeTransformation.p286CoordinateIndexFintype

local instance p286CoordinateIsTopologicalAddGroup :
    IsTopologicalAddGroup P286CoordinateCarrier where
  toContinuousAdd := inferInstance
  toContinuousNeg := inferInstance

/-- Directional Leibniz rule for the actual point-dependent scalar tangent
generated by one P286 gauge parameter. -/
theorem fieldDirectionalDerivative_linkedActiveScalar
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (point : BasePoint)
    (direction : LorentzianIndex) :
    fieldDirectionalDerivative
        (fun current =>
          (representationDerivedP286CoupledGaugeTangentSection configuration
            gaugeParameter current).scalar)
        point direction =
      scalarP286ActionBilinear
          (p286GaugeParameterDerivative gaugeParameter point direction)
          (configuration.scalar point) +
        scalarP286ActionBilinear (gaugeParameter point)
          (fieldDirectionalDerivative configuration.scalar point direction) := by
  let action := scalarP286ActionBilinear.toContinuousBilinearMap
  have parameterDifferentiable :
      DifferentiableAt ℝ gaugeParameter point :=
    (gaugeParameter.smooth.differentiable (by simp)).differentiableAt
  have scalarDifferentiable :
      DifferentiableAt ℝ configuration.scalar point :=
    (smooth.2.2.2.2.2.2.1.differentiable (by simp)).differentiableAt
  have totalDerivative :
      fderiv ℝ
          (fun current =>
            action (gaugeParameter current) (configuration.scalar current))
          point =
        action.precompR BasePoint (gaugeParameter point)
            (fderiv ℝ configuration.scalar point) +
          action.precompL BasePoint (fderiv ℝ gaugeParameter point)
            (configuration.scalar point) :=
    (action.hasFDerivAt_of_bilinear parameterDifferentiable.hasFDerivAt
      scalarDifferentiable.hasFDerivAt).fderiv
  have tangentEquality :
      (fun current =>
        (representationDerivedP286CoupledGaugeTangentSection configuration
          gaugeParameter current).scalar) =
        fun current =>
          action (gaugeParameter current) (configuration.scalar current) := by
    funext current
    rfl
  rw [tangentEquality]
  unfold fieldDirectionalDerivative
  rw [totalDerivative]
  simp only [add_apply,
    ContinuousLinearMap.precompR_apply,
    ContinuousLinearMap.precompL_apply]
  change
    scalarP286ActionBilinear (gaugeParameter point)
          (fieldDirectionalDerivative configuration.scalar point direction) +
        scalarP286ActionBilinear
          (p286GaugeParameterDerivative gaugeParameter point direction)
          (configuration.scalar point) =
      scalarP286ActionBilinear
          (p286GaugeParameterDerivative gaugeParameter point direction)
          (configuration.scalar point) +
        scalarP286ActionBilinear (gaugeParameter point)
          (fieldDirectionalDerivative configuration.scalar point direction)
  exact add_comm _ _

end

end SaturationMonoid.PhysicsCore.StageNineP286LinkedActiveScalarJetAlgebra
