import H0mework.Physics.GaugeStanding.PointJetExpansion

/-!
# S9-C: typed normal form of the linked active point field

The primitive linked path and its generated jets are collected here into one
typed `StageNineContinuumPointField`.  This is a readout of the actual
holonomic path, not an independently supplied first-jet carrier.

The normal form makes every parameter degree visible:

* curvature and charged covariant jets are quadratic;
* auxiliary, scalar, matter, and conjugate matter are affine;
* coframe and all gravity fields are fixed.

It is the single point-field input for the joint local-density polynomial.
-/

open SaturationMonoid

namespace
  SaturationMonoid.PhysicsCore.StageNineP286LinkedActivePointFieldNormalForm

open DiracExteriorMatterAction
open ProofFreeRicherAnholonomicSource
open StageNineDynamicBreakingVacuum
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineP286GaugeAuxiliaryVariation
open StageNineP286GaugeConnectionVariation
open StageNineP286InfinitesimalGaugeTransformation
open StageNineP286LinkedActiveMatterDensityCancellation
open StageNineP286LinkedActivePointJetExpansion
open StageNineP286LinkedActiveScalarKineticCancellation
open StageNineP286LinkedActiveVariation
open SU7MotherGaugeTheory

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 400000

/-- Fully typed polynomial readout of the continuum point field generated by
the one linked primitive path.  Every coefficient is computed from the
initial configuration and its representation-derived tangent. -/
def p286LinkedActivePointFieldNormalForm
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ)
    (point : BasePoint) : StageNineContinuumPointField :=
  let field := toContinuumPointField configuration point
  let tangent :=
    representationDerivedP286CoupledGaugeTangentSection configuration
      gaugeParameter point
  { field with
    gaugeCurvature := fun pair =>
      p286CoordinateEquiv.symm
        ((holonomicP286GaugeCurvatureCoordinate configuration point +
          parameter •
            linkedActiveP286CurvatureLinearResponse configuration
              gaugeParameter point +
          parameter ^ 2 •
            linkedActiveP286CurvatureQuadraticResponse configuration
              gaugeParameter point) pair)
    gaugeAuxiliary := fun pair =>
      p286CoordinateEquiv.symm
        ((holonomicP286GaugeAuxiliaryCoordinate configuration point +
          parameter • tangent.auxiliary) pair)
    scalar :=
      configuration.scalar point + parameter • tangent.scalar
    scalarCovariantDerivative :=
      holonomicScalarCovariantDerivative configuration point +
        parameter •
          linkedActiveScalarCovariantJetResponse configuration gaugeParameter
            point +
        parameter ^ 2 •
          linkedActiveScalarCovariantJetQuadraticResponse configuration
            gaugeParameter point
    matter :=
      configuration.matter point + parameter • tangent.matter
    matterCovariantDerivative :=
      holonomicMatterCovariantDerivative configuration point +
        parameter •
          linkedActiveMatterCovariantJetResponse configuration gaugeParameter
            point +
        parameter ^ 2 •
          linkedActiveMatterCovariantJetQuadraticResponse configuration
            gaugeParameter point
    conjugateMatter :=
      configuration.conjugateMatter point +
        parameter • tangent.conjugateMatter }

/-- The normal form is exactly the continuum first-jet field generated from
the actual linked holonomic primitive path. -/
theorem toContinuumPointField_p286LinkedActivePrimitivePath
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ)
    (point : BasePoint) :
    toContinuumPointField
        (p286LinkedActivePrimitivePath configuration gaugeParameter parameter)
        point =
      p286LinkedActivePointFieldNormalForm configuration gaugeParameter
        parameter point := by
  apply StageNineContinuumPointField.ext
  · rfl
  · rfl
  · rfl
  · rfl
  · funext pair
    apply p286CoordinateEquiv.injective
    simpa only [toContinuumPointField,
      p286LinkedActivePointFieldNormalForm,
      holonomicP286GaugeCurvatureCoordinate,
      p286CoordinateEquiv.apply_symm_apply] using
        congrFun
          (p286LinkedActivePrimitivePath_curvatureCoordinate configuration
            smooth gaugeParameter parameter point)
          pair
  · funext pair
    apply p286CoordinateEquiv.injective
    simpa only [toContinuumPointField,
      p286LinkedActivePointFieldNormalForm,
      holonomicP286GaugeAuxiliaryCoordinate,
      p286CoordinateEquiv.apply_symm_apply] using
        congrFun
          (p286LinkedActivePrimitivePath_auxiliaryCoordinate configuration
            gaugeParameter parameter point)
          pair
  · simpa only [toContinuumPointField,
      p286LinkedActivePointFieldNormalForm] using
      p286LinkedActivePrimitivePath_scalarCoordinate configuration
        gaugeParameter parameter point
  · funext direction
    simpa only [toContinuumPointField,
      p286LinkedActivePointFieldNormalForm, Pi.add_apply,
      Pi.smul_apply] using
      p286LinkedActivePrimitivePath_scalarCovariantDerivative configuration
        smooth gaugeParameter parameter point direction
  · apply matterCoordinateEquiv.injective
    change
      matterCoordinateEquiv
          ((p286LinkedActivePrimitivePath configuration gaugeParameter
            parameter).matter point) =
        matterCoordinateEquiv
          (configuration.matter point +
            parameter •
              (representationDerivedP286CoupledGaugeTangentSection
                configuration gaugeParameter point).matter)
    rw [map_add]
    have coordinateSmul :
        matterCoordinateEquiv
            (parameter •
              (representationDerivedP286CoupledGaugeTangentSection
                configuration gaugeParameter point).matter) =
          parameter • matterCoordinateEquiv
            (representationDerivedP286CoupledGaugeTangentSection
              configuration gaugeParameter point).matter := by
      change
        matterCoordinateEquiv
            ((parameter : ℂ) •
              (representationDerivedP286CoupledGaugeTangentSection
                configuration gaugeParameter point).matter) =
          (parameter : ℂ) • matterCoordinateEquiv
            (representationDerivedP286CoupledGaugeTangentSection
              configuration gaugeParameter point).matter
      exact map_smul matterCoordinateEquiv (parameter : ℂ) _
    rw [coordinateSmul]
    exact p286LinkedActivePrimitivePath_matterCoordinate configuration
      gaugeParameter parameter point
  · funext direction
    simpa only [toContinuumPointField,
      p286LinkedActivePointFieldNormalForm, Pi.add_apply,
      Pi.smul_apply] using
      p286LinkedActivePrimitivePath_matterCovariantDerivative configuration
        smooth gaugeParameter parameter point direction
  · simpa only [toContinuumPointField,
      p286LinkedActivePointFieldNormalForm] using
      p286LinkedActivePrimitivePath_conjugateMatter configuration
        gaugeParameter parameter point

end

end
  SaturationMonoid.PhysicsCore.StageNineP286LinkedActivePointFieldNormalForm
