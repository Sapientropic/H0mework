import H0mework.Physics.GaugeStanding.LieRepresentation
import H0mework.Physics.GaugeStanding.VariationRegularity

/-!
# S9-C: linked active matter covariant jet

This module follows the same action-first route as the scalar jet.  One
compactly supported P286 parameter generates the matter direction, the
connection direction, and therefore the complete matter covariant-jet
response.  The Lorentz-spin part is retained and commutes with the internal
P286 action on the actual Dirac/exterior carrier.

No Ward identity, stationarity law, residual-zero receipt, or target jet is
accepted at a theorem mouth.
-/

open SaturationMonoid

namespace
  SaturationMonoid.PhysicsCore.StageNineP286LinkedActiveMatterCovariantJet

open DiracExteriorMatterAction
open PointwiseDiracSpinConnectionLift
open ProofFreeRicherAnholonomicSource
open StageNineHolonomicField
open StageNineP286BracketCalculus
open StageNineP286GaugeConnectionVariation
open StageNineP286GaugeConnectionVariationDensity
open StageNineP286InfinitesimalGaugeTransformation
open StageNineP286LinkedActiveLieRepresentation
open StageNineP286LinkedActiveVariation
open StageNineP286LinkedActiveVariationRegularity
open SU7MotherGaugeTheory
open SU7MotherLieAlgebra

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 300000

local instance p286ModuleFinite : Module.Finite ℝ P286LieBlockData :=
  FiniteDimensional.of_injective p286AmbientLinear
    p286AmbientLinear_injective

local instance p286CoordinateIndexFintype : Fintype P286CoordinateIndex :=
  StageNineP286InfinitesimalGaugeTransformation.p286CoordinateIndexFintype

local instance p286CoordinateIsTopologicalAddGroup :
    IsTopologicalAddGroup P286CoordinateCarrier where
  toContinuousAdd := inferInstance
  toContinuousNeg := inferInstance

/-- Directional Leibniz rule for the actual point-dependent matter tangent
generated by one P286 gauge parameter. -/
theorem fieldDirectionalDerivative_linkedActiveMatterCoordinate
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (point : BasePoint)
    (direction : LorentzianIndex) :
    fieldDirectionalDerivative
        (fun current =>
          matterCoordinateEquiv
            ((representationDerivedP286CoupledGaugeTangentSection configuration
              gaugeParameter current).matter))
        point direction =
      matterP286ActionCoordinateBilinear
        (p286GaugeParameterDerivative gaugeParameter point direction)
        (matterCoordinateEquiv (configuration.matter point)) +
      matterP286ActionCoordinateBilinear
        (gaugeParameter point)
        (fieldDirectionalDerivative
          (fun current => matterCoordinateEquiv (configuration.matter current))
          point direction) := by
  let action :=
    matterP286ActionCoordinateBilinear.toContinuousBilinearMap
  have parameterDifferentiable :
      DifferentiableAt ℝ gaugeParameter point :=
    (gaugeParameter.smooth.differentiable (by simp)).differentiableAt
  have matterDifferentiable :
      DifferentiableAt ℝ
          (fun current => matterCoordinateEquiv (configuration.matter current))
          point :=
    (smooth.2.2.2.2.2.2.2.1.differentiable (by simp)).differentiableAt
  have totalDerivative :
      fderiv ℝ
          (fun current =>
            action (gaugeParameter current)
              (matterCoordinateEquiv (configuration.matter current)))
          point =
        action.precompR BasePoint (gaugeParameter point)
            (fderiv ℝ
              (fun current =>
                matterCoordinateEquiv (configuration.matter current))
              point) +
          action.precompL BasePoint (fderiv ℝ gaugeParameter point)
            (matterCoordinateEquiv (configuration.matter point)) := by
    exact
      (action.hasFDerivAt_of_bilinear parameterDifferentiable.hasFDerivAt
        matterDifferentiable.hasFDerivAt).fderiv
  have tangentEquality :
      (fun current =>
        matterCoordinateEquiv
          ((representationDerivedP286CoupledGaugeTangentSection configuration
            gaugeParameter current).matter)) =
        fun current =>
          action (gaugeParameter current)
            (matterCoordinateEquiv (configuration.matter current)) := by
    funext current
    change
      matterCoordinateEquiv
          (diracExteriorMotherLieAction
            (p286LieBlockEmbed
              (p286CoordinateEquiv.symm (gaugeParameter current)))
            (configuration.matter current)) =
        matterCoordinateEquiv
          (diracExteriorMotherLieAction
            (p286LieBlockEmbed
              (p286CoordinateEquiv.symm (gaugeParameter current)))
            (matterCoordinateEquiv.symm
              (matterCoordinateEquiv (configuration.matter current))))
    rw [matterCoordinateEquiv.symm_apply_apply]
  rw [tangentEquality]
  unfold fieldDirectionalDerivative
  rw [totalDerivative]
  simp only [add_apply, ContinuousLinearMap.precompR_apply,
    ContinuousLinearMap.precompL_apply]
  change
    matterP286ActionCoordinateBilinear
        (gaugeParameter point)
        (fieldDirectionalDerivative
          (fun current => matterCoordinateEquiv (configuration.matter current))
          point direction) +
      matterP286ActionCoordinateBilinear
        (p286GaugeParameterDerivative gaugeParameter point direction)
        (matterCoordinateEquiv (configuration.matter point)) =
      matterP286ActionCoordinateBilinear
        (p286GaugeParameterDerivative gaugeParameter point direction)
        (matterCoordinateEquiv (configuration.matter point)) +
      matterP286ActionCoordinateBilinear
        (gaugeParameter point)
        (fieldDirectionalDerivative
          (fun current => matterCoordinateEquiv (configuration.matter current))
          point direction)
  exact add_comm _ _

/-- The faithful P286 coordinate bracket acts by the commutator on matter
coordinates. -/
theorem matterP286ActionCoordinateBilinear_coordinateBracket
    (epsilon connection : P286CoordinateCarrier)
    (matter : MatterCoordinateCarrier) :
    matterP286ActionCoordinateBilinear
        (coordinateBracket epsilon connection) matter =
      matterP286ActionCoordinateBilinear epsilon
          (matterP286ActionCoordinateBilinear connection matter) -
        matterP286ActionCoordinateBilinear connection
          (matterP286ActionCoordinateBilinear epsilon matter) := by
  simp only [matterP286ActionCoordinateBilinear, LinearMap.coe_mk,
    AddHom.coe_mk, matterCoordinateEquiv.symm_apply_apply]
  rw [coordinateBracket, p286CoordinateEquiv.symm_apply_apply,
    p286LieBlockEmbed_bracket]
  have bracket :=
    LinearMap.congr_fun
      (diracExteriorMotherLieAction_bracket
        (p286LieBlockEmbed (p286CoordinateEquiv.symm epsilon))
        (p286LieBlockEmbed (p286CoordinateEquiv.symm connection)))
      (matterCoordinateEquiv.symm matter)
  simpa [LinearMap.comp_apply] using congrArg matterCoordinateEquiv bracket

/-- The complete first variation of the matter covariant jet along the
linked active P286 tangent is the action of the same parameter on the
original covariant jet.  The gravity/spin connection is fixed by the internal
variation but its action on the varied matter field is retained. -/
theorem linkedActiveMatterCovariantJetVariation_eq_action
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (point : BasePoint)
    (direction : LorentzianIndex) :
    matterCoordinateEquiv.symm
          (fieldDirectionalDerivative
            (fun current =>
              matterCoordinateEquiv
                ((representationDerivedP286CoupledGaugeTangentSection
                  configuration gaugeParameter current).matter))
            point direction) +
        diracMatrixMatterAction
          (diracSpinConnectionLift
            (configuration.gravityConnection point) direction)
          ((representationDerivedP286CoupledGaugeTangentSection configuration
            gaugeParameter point).matter) +
      diracExteriorMotherLieAction
          (p286LieBlockEmbed
            (configuration.gaugeConnection point direction))
          ((representationDerivedP286CoupledGaugeTangentSection configuration
            gaugeParameter point).matter) +
      diracExteriorMotherLieAction
          (p286LieBlockEmbed
            (p286CoordinateEquiv.symm
              ((representationDerivedP286CoupledGaugeTangentSection
                configuration gaugeParameter point).connection direction)))
          (configuration.matter point) =
    diracExteriorMotherLieAction
      (p286GaugeParameterMotherAt gaugeParameter point)
      (holonomicMatterCovariantDerivative configuration point direction) := by
  let epsilon := gaugeParameter point
  let connection :=
    holonomicP286GaugeConnectionCoordinate configuration point direction
  let parameterDerivative :=
    p286GaugeParameterDerivative gaugeParameter point direction
  let matter := configuration.matter point
  let matterCoordinates := matterCoordinateEquiv matter
  let matterDerivative :=
    fieldDirectionalDerivative
      (fun current => matterCoordinateEquiv (configuration.matter current))
      point direction
  let spinMatrix :=
    diracSpinConnectionLift
      (configuration.gravityConnection point) direction
  have connectionTangent :
      (representationDerivedP286CoupledGaugeTangentSection configuration
        gaugeParameter point).connection direction =
        coordinateBracket epsilon connection - parameterDerivative := by
    rfl
  have matterTangent :
      (representationDerivedP286CoupledGaugeTangentSection configuration
        gaugeParameter point).matter =
        diracExteriorMotherLieAction
          (p286LieBlockEmbed (p286CoordinateEquiv.symm epsilon)) matter := by
    rfl
  have spinCommutes :
      diracMatrixMatterAction spinMatrix
          (diracExteriorMotherLieAction
            (p286LieBlockEmbed (p286CoordinateEquiv.symm epsilon)) matter) =
        diracExteriorMotherLieAction
          (p286LieBlockEmbed (p286CoordinateEquiv.symm epsilon))
          (diracMatrixMatterAction spinMatrix matter) := by
    exact LinearMap.congr_fun
      (diracMatrixMatterAction_commutes_internal spinMatrix
        (exteriorSpinorMotherLieAction
          (p286LieBlockEmbed (p286CoordinateEquiv.symm epsilon))))
      matter
  have actionCoordinate
      (parameter : P286CoordinateCarrier)
      (field : DiracExteriorMatterCarrier) :
      matterCoordinateEquiv
          (diracExteriorMotherLieAction
            (p286LieBlockEmbed (p286CoordinateEquiv.symm parameter)) field) =
        matterP286ActionCoordinateBilinear parameter
          (matterCoordinateEquiv field) := by
    simp [matterP286ActionCoordinateBilinear]
  have connectionPrimitive :
      p286CoordinateEquiv.symm connection =
        configuration.gaugeConnection point direction := by
    simp [connection, holonomicP286GaugeConnectionCoordinate]
  apply matterCoordinateEquiv.injective
  simp only [map_add, matterCoordinateEquiv.apply_symm_apply]
  rw [fieldDirectionalDerivative_linkedActiveMatterCoordinate
    configuration smooth]
  rw [connectionTangent, matterTangent, spinCommutes]
  unfold p286GaugeParameterMotherAt holonomicMatterCovariantDerivative
  simp only [map_add]
  rw [← connectionPrimitive]
  simp_rw [actionCoordinate]
  simp only [matterCoordinateEquiv.apply_symm_apply]
  rw [show
      matterP286ActionCoordinateBilinear
          (coordinateBracket epsilon connection - parameterDerivative)
          matterCoordinates =
        matterP286ActionCoordinateBilinear
            (coordinateBracket epsilon connection) matterCoordinates -
          matterP286ActionCoordinateBilinear parameterDerivative
            matterCoordinates by
      rw [map_sub, LinearMap.sub_apply]]
  rw [matterP286ActionCoordinateBilinear_coordinateBracket]
  abel

end

end SaturationMonoid.PhysicsCore.StageNineP286LinkedActiveMatterCovariantJet
