import H0mework.Physics.GaugeAction.P286GaugeConnectionActionVariation

/-!
# Stage-9 linked P286 gauge--BF path polynomial

The gauge--BF density is evaluated on the generic joint path

`F(t) = F + t L + t² Q`, `B(t) = B + t b`.

Its exact cubic normal form is derived directly from the actual P286 pairing
and spacetime operators.  The first coefficient is the sum of the curvature
and auxiliary legs; the second and third coefficients explicitly retain the
mixed and quadratic responses generated by the same path.

No difference quotient, target coefficient, Ward identity, stationarity
law, residual zero, source datum, or supplied path receipt is accepted.
-/

open SaturationMonoid

namespace
  SaturationMonoid.PhysicsCore.StageNineP286LinkedActiveGaugeBFPathPolynomial

open ProofFreeRicherAnholonomicSource
open StageNineBlockwiseConstitutive
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineP286GaugeAuxiliaryVariation
open StageNineP286GaugeConnectionActionVariation

noncomputable section

set_option autoImplicit false

/-- First coefficient of the generic joint gauge--BF path.  It is exactly
the curvature response at the original auxiliary plus the auxiliary response
at the original curvature. -/
def p286GaugeBFJointPathFirstCoefficient
    (coframe : LorentzianCoframe)
    (spacetimeHodge operator : GaugeTwoForm →ₗ[ℝ] GaugeTwoForm)
    (curvature auxiliary linearCurvature auxiliaryDirection :
      P286GaugeTwoForm) : ℝ :=
  p286GaugeBFCurvatureIncrementDensity coframe spacetimeHodge auxiliary
      linearCurvature +
    p286CoordinateGaugeAuxiliaryFirstVariationDensity coframe spacetimeHodge
      operator curvature auxiliary auxiliaryDirection

/-- Second coefficient of the generic joint gauge--BF path.  It records the
quadratic curvature response, the mixed auxiliary/linear-curvature response,
and the quadratic auxiliary response. -/
def p286GaugeBFJointPathSecondCoefficient
    (coframe : LorentzianCoframe)
    (spacetimeHodge operator : GaugeTwoForm →ₗ[ℝ] GaugeTwoForm)
    (auxiliary linearCurvature quadraticCurvature auxiliaryDirection :
      P286GaugeTwoForm) : ℝ :=
  p286GaugeBFCurvatureIncrementDensity coframe spacetimeHodge auxiliary
      quadraticCurvature +
    p286GaugeBFCurvatureIncrementDensity coframe spacetimeHodge
      auxiliaryDirection linearCurvature +
    p286CoordinateGaugeAuxiliarySecondVariationDensity coframe
      spacetimeHodge operator auxiliaryDirection

/-- Third coefficient of the generic joint gauge--BF path.  This is the
mixed auxiliary/quadratic-curvature response; no higher coefficient occurs
because the gauge--BF density is linear in curvature. -/
def p286GaugeBFJointPathThirdCoefficient
    (coframe : LorentzianCoframe)
    (spacetimeHodge : GaugeTwoForm →ₗ[ℝ] GaugeTwoForm)
    (quadraticCurvature auxiliaryDirection : P286GaugeTwoForm) : ℝ :=
  p286GaugeBFCurvatureIncrementDensity coframe spacetimeHodge
    auxiliaryDirection quadraticCurvature

/-- The first joint coefficient exposes both independently generated
first-order legs without hiding either one in a target-shaped abbreviation. -/
theorem p286GaugeBFJointPathFirstCoefficient_eq_curvature_add_auxiliary
    (coframe : LorentzianCoframe)
    (spacetimeHodge operator : GaugeTwoForm →ₗ[ℝ] GaugeTwoForm)
    (curvature auxiliary linearCurvature auxiliaryDirection :
      P286GaugeTwoForm) :
    p286GaugeBFJointPathFirstCoefficient coframe spacetimeHodge operator
        curvature auxiliary linearCurvature auxiliaryDirection =
      p286GaugeBFCurvatureIncrementDensity coframe spacetimeHodge auxiliary
          linearCurvature +
        p286CoordinateGaugeAuxiliaryFirstVariationDensity coframe
          spacetimeHodge operator curvature auxiliary auxiliaryDirection :=
  rfl

/-- Exact cubic normal form of the actual P286 coordinate gauge--BF density
along simultaneous quadratic-curvature and affine-auxiliary responses. -/
theorem generatedGaugeSectorBFDensity_p286Coordinate_joint_cubic
    (coframe : LorentzianCoframe)
    (spacetimeHodge operator : GaugeTwoForm →ₗ[ℝ] GaugeTwoForm)
    (curvature auxiliary linearCurvature quadraticCurvature
      auxiliaryDirection : P286GaugeTwoForm)
    (parameter : ℝ) :
    generatedGaugeSectorBFDensity p286CoordinateLiePairing coframe
        spacetimeHodge operator
        (curvature + parameter • linearCurvature +
          parameter ^ 2 • quadraticCurvature)
        (auxiliary + parameter • auxiliaryDirection) =
      generatedGaugeSectorBFDensity p286CoordinateLiePairing coframe
          spacetimeHodge operator curvature auxiliary +
        parameter *
          p286GaugeBFJointPathFirstCoefficient coframe spacetimeHodge operator
            curvature auxiliary linearCurvature auxiliaryDirection +
        parameter ^ 2 *
          p286GaugeBFJointPathSecondCoefficient coframe spacetimeHodge operator
            auxiliary linearCurvature quadraticCurvature auxiliaryDirection +
        parameter ^ 3 *
          p286GaugeBFJointPathThirdCoefficient coframe spacetimeHodge
            quadraticCurvature auxiliaryDirection := by
  unfold generatedGaugeSectorBFDensity
    p286GaugeBFJointPathFirstCoefficient
    p286GaugeBFJointPathSecondCoefficient
    p286GaugeBFJointPathThirdCoefficient
    p286GaugeBFCurvatureIncrementDensity
    p286CoordinateGaugeAuxiliaryFirstVariationDensity
    p286CoordinateGaugeAuxiliarySecondVariationDensity
  simp only [liftGaugeTwoFormOperator_add_p286,
    liftGaugeTwoFormOperator_smul_p286,
    generatedGaugeTwoFormMetricPairing_p286_add_left,
    generatedGaugeTwoFormMetricPairing_p286_add_right,
    generatedGaugeTwoFormMetricPairing_p286_smul_left,
    generatedGaugeTwoFormMetricPairing_p286_smul_right]
  ring

end

end
  SaturationMonoid.PhysicsCore.StageNineP286LinkedActiveGaugeBFPathPolynomial
