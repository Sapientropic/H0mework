import H0mework.Physics.GaugeAction.P286InfinitesimalGaugeTransformation
import H0mework.Physics.GaugeAction.P286GaugeAuxiliaryVariation
import H0mework.Physics.Exterior.ScalarVariation
import H0mework.Physics.Matter.MatterVariation

/-!
# S9-C: linked active P286 primitive variation

A single compactly supported smooth P286 Lie-algebra parameter generates the
simultaneous tangent of every primitive field charged under P286.  The linked
path below applies the five existing primitive variation mouths to that one
tangent section; it does not accept five independently supplied directions.

This module contains no Ward identity, stationarity hypothesis, residual
equation, quotient premise, or source receipt.  It only builds the faithful
linear primitive path that a later active-variation theorem may inspect.
-/

open SaturationMonoid

namespace SaturationMonoid.PhysicsCore.StageNineP286LinkedActiveVariation

open ProofFreeRicherAnholonomicSource
open StageNineDynamicBreakingVacuum
open StageNineHolonomicField
open StageNineP286GaugeAuxiliaryVariation
open StageNineP286GaugeConnectionVariation
open StageNineP286InfinitesimalGaugeTransformation
open StageNineScalarVariation
open StageNineMatterVariation
open StageNineConjugateMatterVariation
open SU7MotherGaugeTheory
open SU7MotherLieAlgebra
open DiracExteriorMatterAction

noncomputable section

set_option autoImplicit false

local instance p286CoordinateIndexFintype : Fintype P286CoordinateIndex :=
  StageNineP286InfinitesimalGaugeTransformation.p286CoordinateIndexFintype

/-! ## One parameter, one simultaneous tangent section -/

/-- Pointwise tangent of every primitive field charged under P286.  Gravity
and coframe fields are absent because the internal P286 action fixes them. -/
@[ext] structure P286CoupledGaugeTangentAt where
  connection : P286GaugeOneForm
  auxiliary : P286GaugeTwoForm
  scalar : ScalarCoordinateCarrier
  matter : DiracExteriorMatterCarrier
  conjugateMatter : Module.Dual ℂ DiracExteriorMatterCarrier

def p286GaugeParameterMotherAt
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (point : BasePoint) : SU7MotherLieMatrix :=
  p286LieBlockEmbed (p286CoordinateEquiv.symm (gaugeParameter point))

/-- Simultaneous infinitesimal action assembled from the active connection
direction and the declared adjoint/derived representations. -/
def representationDerivedP286CoupledGaugeTangentAt
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (point : BasePoint) : P286CoupledGaugeTangentAt where
  connection :=
    p286InfinitesimalGaugeConnectionDirection configuration gaugeParameter point
  auxiliary := fun pair =>
    p286CoordinateLieBracket (gaugeParameter point)
      (p286CoordinateEquiv (configuration.gaugeAuxiliary point pair))
  scalar :=
    scalarMotherLieAction (p286GaugeParameterMotherAt gaugeParameter point)
      (configuration.scalar point)
  matter :=
    diracExteriorMotherLieAction
      (p286GaugeParameterMotherAt gaugeParameter point)
      (configuration.matter point)
  conjugateMatter :=
    -(configuration.conjugateMatter point).comp
      (diracExteriorMotherLieAction
        (p286GaugeParameterMotherAt gaugeParameter point))

/-- The all-point section generated by the same compact-smooth parameter at
every point. -/
def representationDerivedP286CoupledGaugeTangentSection
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter) :
    BasePoint → P286CoupledGaugeTangentAt :=
  fun point =>
    representationDerivedP286CoupledGaugeTangentAt configuration
      gaugeParameter point

@[simp] theorem representationDerivedP286CoupledGaugeTangentSection_apply
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (point : BasePoint) :
    representationDerivedP286CoupledGaugeTangentSection configuration
        gaugeParameter point =
      representationDerivedP286CoupledGaugeTangentAt configuration
        gaugeParameter point :=
  rfl

/-- The frozen-background control carrier: change only the connection. -/
def connectionOnlyP286CoupledGaugeTangent
    (shift : P286GaugeOneForm) : P286CoupledGaugeTangentAt where
  connection := shift
  auxiliary := 0
  scalar := 0
  matter := 0
  conjugateMatter := 0

@[simp] theorem representationDerivedP286CoupledGaugeTangentAt_connection
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (point : BasePoint) :
    (representationDerivedP286CoupledGaugeTangentAt configuration
      gaugeParameter point).connection =
        p286InfinitesimalGaugeConnectionDirection configuration gaugeParameter
          point :=
  rfl

/-! ## Linked linear primitive path -/

/-- Linear primitive path generated by one coupled tangent section.  Each
field is changed through its already established primitive variation mouth. -/
def p286LinkedActivePrimitivePath
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ) : StageNineHolonomicConfiguration :=
  let tangent :=
    representationDerivedP286CoupledGaugeTangentSection configuration
      gaugeParameter
  varyConjugateMatterCoordinates
    (varyMatterCoordinates
      (varyScalarCoordinates
        (varyP286GaugeAuxiliaryCoordinate
          (varyP286GaugeConnectionCoordinate configuration
            (fun point => (tangent point).connection) parameter)
          (fun point => (tangent point).auxiliary) parameter)
        (fun point => (tangent point).scalar) parameter)
      (fun point => matterCoordinateEquiv (tangent point).matter) parameter)
    (fun point => matterDualCoordinates (tangent point).conjugateMatter)
    parameter

@[simp] theorem p286LinkedActivePrimitivePath_zero
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter) :
    p286LinkedActivePrimitivePath configuration gaugeParameter 0 =
      configuration := by
  cases configuration
  simp [p286LinkedActivePrimitivePath,
    varyP286GaugeConnectionCoordinate,
    holonomicP286GaugeConnectionCoordinate,
    varyP286GaugeAuxiliaryCoordinate,
    varyScalarCoordinates,
    varyMatterCoordinates,
    varyConjugateMatterCoordinates]

@[simp] theorem p286LinkedActivePrimitivePath_coframe
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ) :
    (p286LinkedActivePrimitivePath configuration gaugeParameter
      parameter).coframe =
        configuration.coframe :=
  rfl

@[simp] theorem p286LinkedActivePrimitivePath_gravityConnection
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ) :
    (p286LinkedActivePrimitivePath configuration gaugeParameter
      parameter).gravityConnection =
        configuration.gravityConnection :=
  rfl

@[simp] theorem p286LinkedActivePrimitivePath_gravityAuxiliary
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ) :
    (p286LinkedActivePrimitivePath configuration gaugeParameter
      parameter).gravityAuxiliary =
        configuration.gravityAuxiliary :=
  rfl

@[simp] theorem p286LinkedActivePrimitivePath_gravitySimplicityMultiplier
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ) :
    (p286LinkedActivePrimitivePath configuration gaugeParameter
      parameter).gravitySimplicityMultiplier =
        configuration.gravitySimplicityMultiplier :=
  rfl

@[simp] theorem p286LinkedActivePrimitivePath_connectionCoordinate
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ) (point : BasePoint) :
    holonomicP286GaugeConnectionCoordinate
        (p286LinkedActivePrimitivePath configuration gaugeParameter parameter)
        point =
      holonomicP286GaugeConnectionCoordinate configuration point +
        parameter •
          (representationDerivedP286CoupledGaugeTangentSection configuration
            gaugeParameter point).connection := by
  funext direction
  simp [p286LinkedActivePrimitivePath,
    varyP286GaugeConnectionCoordinate,
    holonomicP286GaugeConnectionCoordinate,
    varyP286GaugeAuxiliaryCoordinate,
    varyScalarCoordinates,
    varyMatterCoordinates,
    varyConjugateMatterCoordinates]

@[simp] theorem p286LinkedActivePrimitivePath_auxiliaryCoordinate
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ) (point : BasePoint) :
    holonomicP286GaugeAuxiliaryCoordinate
        (p286LinkedActivePrimitivePath configuration gaugeParameter parameter)
        point =
      holonomicP286GaugeAuxiliaryCoordinate configuration point +
        parameter •
          (representationDerivedP286CoupledGaugeTangentSection configuration
            gaugeParameter point).auxiliary := by
  funext pair
  simp [p286LinkedActivePrimitivePath,
    holonomicP286GaugeAuxiliaryCoordinate,
    varyP286GaugeConnectionCoordinate,
    varyP286GaugeAuxiliaryCoordinate,
    varyConjugateMatterCoordinates,
    varyMatterCoordinates,
    varyScalarCoordinates]

@[simp] theorem p286LinkedActivePrimitivePath_scalarCoordinate
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ) (point : BasePoint) :
    (p286LinkedActivePrimitivePath configuration gaugeParameter parameter).scalar
        point =
      configuration.scalar point +
        parameter •
          (representationDerivedP286CoupledGaugeTangentSection configuration
            gaugeParameter point).scalar := by
  simp [p286LinkedActivePrimitivePath,
    varyP286GaugeConnectionCoordinate,
    varyP286GaugeAuxiliaryCoordinate,
    varyConjugateMatterCoordinates,
    varyMatterCoordinates,
    varyScalarCoordinates]

@[simp] theorem p286LinkedActivePrimitivePath_matterCoordinate
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ) (point : BasePoint) :
    matterCoordinateEquiv
        ((p286LinkedActivePrimitivePath configuration gaugeParameter
          parameter).matter point) =
      matterCoordinateEquiv (configuration.matter point) +
        parameter • matterCoordinateEquiv
          (representationDerivedP286CoupledGaugeTangentSection configuration
            gaugeParameter point).matter := by
  simp [p286LinkedActivePrimitivePath,
    varyP286GaugeConnectionCoordinate,
    varyP286GaugeAuxiliaryCoordinate,
    varyConjugateMatterCoordinates,
    varyScalarCoordinates,
    varyMatterCoordinates]

@[simp] theorem p286LinkedActivePrimitivePath_conjugateMatter
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ) (point : BasePoint) :
    (p286LinkedActivePrimitivePath configuration gaugeParameter
        parameter).conjugateMatter point =
      configuration.conjugateMatter point +
        parameter •
          (representationDerivedP286CoupledGaugeTangentSection configuration
            gaugeParameter point).conjugateMatter := by
  simp [p286LinkedActivePrimitivePath,
    varyP286GaugeConnectionCoordinate,
    varyP286GaugeAuxiliaryCoordinate,
    varyConjugateMatterCoordinates,
    varyScalarCoordinates,
    varyMatterCoordinates,
    matterDualOfCoordinates_surjective]

end

end SaturationMonoid.PhysicsCore.StageNineP286LinkedActiveVariation
