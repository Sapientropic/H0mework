import H0mework.Physics.GaugeAction.P286GaugeConnectionActionVariation

/-!
# Stage-9 linked P286 scalar-kinetic path polynomial

The scalar covariant jet generated by the linked primitive path has the
generic quadratic form

`D(t) = D + t R + t² S`.

This module expands the actual scalar kinetic density on that typed path.
The first coefficient is exactly the existing scalar-kinetic first
variation.  The second through fourth coefficients are written directly
from the coframe inverse metric, the source frame, and the scalar coordinate
pairing.

No difference quotient, target coefficient, Ward identity, stationarity
law, residual zero, source datum, or supplied jet receipt is accepted.
-/

open SaturationMonoid

namespace
  SaturationMonoid.PhysicsCore.StageNineP286LinkedActiveScalarKineticPathPolynomial

open ProofFreeRicherAnholonomicSource
open StageNineDynamicBreakingVacuum
open StageNineEnrichedProofFreeSource
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineP286GaugeConnectionActionVariation

noncomputable section

set_option autoImplicit false

/-- Typed point field obtained by replacing only the scalar covariant jet by
the generic quadratic path `D + t R + t² S`. -/
def withScalarCovariantDerivativeQuadraticPath
    (field : StageNineContinuumPointField)
    (linear quadratic : LorentzianIndex → ScalarCoordinateCarrier)
    (parameter : ℝ) : StageNineContinuumPointField :=
  { field with
    scalarCovariantDerivative :=
      field.scalarCovariantDerivative + parameter • linear +
        parameter ^ 2 • quadratic }

/-- Polarized form of the actual scalar kinetic density.  This stays private:
the public coefficients below retain their direct metric/pairing readout. -/
private def scalarKineticPolarizedDensity
    (source : SmoothUnifiedSource)
    (chart : StageNineChart)
    (point : BasePoint)
    (field : StageNineContinuumPointField)
    (firstDerivative secondDerivative :
      LorentzianIndex → ScalarCoordinateCarrier) : ℝ :=
  (1 / 2 : ℝ) *
    ∑ first : LorentzianIndex,
      ∑ second : LorentzianIndex,
        ((lorentzianMetricOfCoframe field.coframe)⁻¹ first second) *
          scalarCoordinatePairingRe
            (scalarFrameRelativeCovariantDerivative source chart point
              firstDerivative first)
            (scalarFrameRelativeCovariantDerivative source chart point
              secondDerivative second)

private theorem scalarKineticPolarizedDensity_add_left
    (source : SmoothUnifiedSource)
    (chart : StageNineChart)
    (point : BasePoint)
    (field : StageNineContinuumPointField)
    (first second residual :
      LorentzianIndex → ScalarCoordinateCarrier) :
    scalarKineticPolarizedDensity source chart point field
        (first + second) residual =
      scalarKineticPolarizedDensity source chart point field first residual +
        scalarKineticPolarizedDensity source chart point field second
          residual := by
  unfold scalarKineticPolarizedDensity
  simp only [scalarFrameRelativeCovariantDerivative_add, Pi.add_apply,
    scalarCoordinatePairingRe_add_left, mul_add,
    Finset.sum_add_distrib]

private theorem scalarKineticPolarizedDensity_add_right
    (source : SmoothUnifiedSource)
    (chart : StageNineChart)
    (point : BasePoint)
    (field : StageNineContinuumPointField)
    (first second residual :
      LorentzianIndex → ScalarCoordinateCarrier) :
    scalarKineticPolarizedDensity source chart point field
        residual (first + second) =
      scalarKineticPolarizedDensity source chart point field residual first +
        scalarKineticPolarizedDensity source chart point field residual
          second := by
  unfold scalarKineticPolarizedDensity
  simp only [scalarFrameRelativeCovariantDerivative_add, Pi.add_apply,
    scalarCoordinatePairingRe_add_right, mul_add,
    Finset.sum_add_distrib]

private theorem scalarKineticPolarizedDensity_smul_left
    (source : SmoothUnifiedSource)
    (chart : StageNineChart)
    (point : BasePoint)
    (field : StageNineContinuumPointField)
    (parameter : ℝ)
    (first residual : LorentzianIndex → ScalarCoordinateCarrier) :
    scalarKineticPolarizedDensity source chart point field
        (parameter • first) residual =
      parameter *
        scalarKineticPolarizedDensity source chart point field first
          residual := by
  unfold scalarKineticPolarizedDensity
  simp only [scalarFrameRelativeCovariantDerivative_real_smul,
    Pi.smul_apply, scalarCoordinatePairingRe_real_smul_left]
  simp_rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro firstDirection _
  apply Finset.sum_congr rfl
  intro secondDirection _
  ring

private theorem scalarKineticPolarizedDensity_smul_right
    (source : SmoothUnifiedSource)
    (chart : StageNineChart)
    (point : BasePoint)
    (field : StageNineContinuumPointField)
    (parameter : ℝ)
    (first residual : LorentzianIndex → ScalarCoordinateCarrier) :
    scalarKineticPolarizedDensity source chart point field
        residual (parameter • first) =
      parameter *
        scalarKineticPolarizedDensity source chart point field residual
          first := by
  unfold scalarKineticPolarizedDensity
  simp only [scalarFrameRelativeCovariantDerivative_real_smul,
    Pi.smul_apply, scalarCoordinatePairingRe_real_smul_right]
  simp_rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro firstDirection _
  apply Finset.sum_congr rfl
  intro secondDirection _
  ring

/-- The first path coefficient is the already established actual
scalar-kinetic first variation in the linear jet response. -/
def scalarKineticQuadraticJetPathFirstCoefficient
    (source : SmoothUnifiedSource)
    (chart : StageNineChart)
    (point : BasePoint)
    (field : StageNineContinuumPointField)
    (linear : LorentzianIndex → ScalarCoordinateCarrier) : ℝ :=
  scalarGaugeConnectionKineticFirstVariationDensity source chart point field
    linear

/-- The second path coefficient contains the linear-response square and the
two base/quadratic-response cross terms. -/
def scalarKineticQuadraticJetPathSecondCoefficient
    (source : SmoothUnifiedSource)
    (chart : StageNineChart)
    (point : BasePoint)
    (field : StageNineContinuumPointField)
    (linear quadratic : LorentzianIndex → ScalarCoordinateCarrier) : ℝ :=
  (1 / 2 : ℝ) *
    ∑ first : LorentzianIndex,
      ∑ second : LorentzianIndex,
        ((lorentzianMetricOfCoframe field.coframe)⁻¹ first second) *
          (scalarCoordinatePairingRe
              (scalarFrameRelativeCovariantDerivative source chart point
                quadratic first)
              (scalarFrameRelativeCovariantDerivative source chart point
                field.scalarCovariantDerivative second) +
            scalarCoordinatePairingRe
              (scalarFrameRelativeCovariantDerivative source chart point
                field.scalarCovariantDerivative first)
              (scalarFrameRelativeCovariantDerivative source chart point
                quadratic second) +
            scalarCoordinatePairingRe
              (scalarFrameRelativeCovariantDerivative source chart point
                linear first)
              (scalarFrameRelativeCovariantDerivative source chart point
                linear second))

/-- The third path coefficient is the pair of mixed linear/quadratic
responses generated by the same scalar covariant jet. -/
def scalarKineticQuadraticJetPathThirdCoefficient
    (source : SmoothUnifiedSource)
    (chart : StageNineChart)
    (point : BasePoint)
    (field : StageNineContinuumPointField)
    (linear quadratic : LorentzianIndex → ScalarCoordinateCarrier) : ℝ :=
  (1 / 2 : ℝ) *
    ∑ first : LorentzianIndex,
      ∑ second : LorentzianIndex,
        ((lorentzianMetricOfCoframe field.coframe)⁻¹ first second) *
          (scalarCoordinatePairingRe
              (scalarFrameRelativeCovariantDerivative source chart point
                linear first)
              (scalarFrameRelativeCovariantDerivative source chart point
                quadratic second) +
            scalarCoordinatePairingRe
              (scalarFrameRelativeCovariantDerivative source chart point
                quadratic first)
              (scalarFrameRelativeCovariantDerivative source chart point
                linear second))

/-- The fourth path coefficient is the actual quadratic-response square. -/
def scalarKineticQuadraticJetPathFourthCoefficient
    (source : SmoothUnifiedSource)
    (chart : StageNineChart)
    (point : BasePoint)
    (field : StageNineContinuumPointField)
    (quadratic : LorentzianIndex → ScalarCoordinateCarrier) : ℝ :=
  (1 / 2 : ℝ) *
    ∑ first : LorentzianIndex,
      ∑ second : LorentzianIndex,
        ((lorentzianMetricOfCoframe field.coframe)⁻¹ first second) *
          scalarCoordinatePairingRe
            (scalarFrameRelativeCovariantDerivative source chart point
              quadratic first)
            (scalarFrameRelativeCovariantDerivative source chart point
              quadratic second)

/-- The first coefficient is definitionally the existing scalar-kinetic
first variation; no parallel acceptance notion is introduced. -/
theorem scalarKineticQuadraticJetPathFirstCoefficient_eq_firstVariation
    (source : SmoothUnifiedSource)
    (chart : StageNineChart)
    (point : BasePoint)
    (field : StageNineContinuumPointField)
    (linear : LorentzianIndex → ScalarCoordinateCarrier) :
    scalarKineticQuadraticJetPathFirstCoefficient source chart point field
        linear =
      scalarGaugeConnectionKineticFirstVariationDensity source chart point
        field linear :=
  rfl

private theorem scalarKineticQuadraticJetPathFirstCoefficient_eq_polarized
    (source : SmoothUnifiedSource)
    (chart : StageNineChart)
    (point : BasePoint)
    (field : StageNineContinuumPointField)
    (linear : LorentzianIndex → ScalarCoordinateCarrier) :
    scalarKineticQuadraticJetPathFirstCoefficient source chart point field
        linear =
      scalarKineticPolarizedDensity source chart point field linear
          field.scalarCovariantDerivative +
        scalarKineticPolarizedDensity source chart point field
          field.scalarCovariantDerivative linear := by
  unfold scalarKineticQuadraticJetPathFirstCoefficient
    scalarGaugeConnectionKineticFirstVariationDensity
    scalarKineticPolarizedDensity
  simp_rw [mul_add, Finset.sum_add_distrib]
  ring

private theorem scalarKineticQuadraticJetPathSecondCoefficient_eq_polarized
    (source : SmoothUnifiedSource)
    (chart : StageNineChart)
    (point : BasePoint)
    (field : StageNineContinuumPointField)
    (linear quadratic : LorentzianIndex → ScalarCoordinateCarrier) :
    scalarKineticQuadraticJetPathSecondCoefficient source chart point field
        linear quadratic =
      scalarKineticPolarizedDensity source chart point field quadratic
          field.scalarCovariantDerivative +
        scalarKineticPolarizedDensity source chart point field
          field.scalarCovariantDerivative quadratic +
        scalarKineticPolarizedDensity source chart point field linear
          linear := by
  unfold scalarKineticQuadraticJetPathSecondCoefficient
    scalarKineticPolarizedDensity
  simp_rw [mul_add, Finset.sum_add_distrib]
  ring

private theorem scalarKineticQuadraticJetPathThirdCoefficient_eq_polarized
    (source : SmoothUnifiedSource)
    (chart : StageNineChart)
    (point : BasePoint)
    (field : StageNineContinuumPointField)
    (linear quadratic : LorentzianIndex → ScalarCoordinateCarrier) :
    scalarKineticQuadraticJetPathThirdCoefficient source chart point field
        linear quadratic =
      scalarKineticPolarizedDensity source chart point field linear
          quadratic +
        scalarKineticPolarizedDensity source chart point field quadratic
          linear := by
  unfold scalarKineticQuadraticJetPathThirdCoefficient
    scalarKineticPolarizedDensity
  simp_rw [mul_add, Finset.sum_add_distrib]
  ring

private theorem scalarKineticQuadraticJetPathFourthCoefficient_eq_polarized
    (source : SmoothUnifiedSource)
    (chart : StageNineChart)
    (point : BasePoint)
    (field : StageNineContinuumPointField)
    (quadratic : LorentzianIndex → ScalarCoordinateCarrier) :
    scalarKineticQuadraticJetPathFourthCoefficient source chart point field
        quadratic =
      scalarKineticPolarizedDensity source chart point field quadratic
        quadratic :=
  rfl

/-- Exact degree-four normal form of the actual scalar kinetic density on a
quadratic covariant-jet path. -/
theorem generatedScalarKineticDensity_quadraticJetPath_quartic
    (source : SmoothUnifiedSource)
    (chart : StageNineChart)
    (point : BasePoint)
    (field : StageNineContinuumPointField)
    (linear quadratic : LorentzianIndex → ScalarCoordinateCarrier)
    (parameter : ℝ) :
    generatedScalarKineticDensity source chart point
        (withScalarCovariantDerivativeQuadraticPath field linear quadratic
          parameter) =
      generatedScalarKineticDensity source chart point field +
        parameter *
          scalarKineticQuadraticJetPathFirstCoefficient source chart point
            field linear +
        parameter ^ 2 *
          scalarKineticQuadraticJetPathSecondCoefficient source chart point
            field linear quadratic +
        parameter ^ 3 *
          scalarKineticQuadraticJetPathThirdCoefficient source chart point
            field linear quadratic +
        parameter ^ 4 *
          scalarKineticQuadraticJetPathFourthCoefficient source chart point
            field quadratic := by
  rw [scalarKineticQuadraticJetPathFirstCoefficient_eq_polarized,
    scalarKineticQuadraticJetPathSecondCoefficient_eq_polarized,
    scalarKineticQuadraticJetPathThirdCoefficient_eq_polarized,
    scalarKineticQuadraticJetPathFourthCoefficient_eq_polarized]
  change
    scalarKineticPolarizedDensity source chart point field
        (field.scalarCovariantDerivative + parameter • linear +
          parameter ^ 2 • quadratic)
        (field.scalarCovariantDerivative + parameter • linear +
          parameter ^ 2 • quadratic) =
      scalarKineticPolarizedDensity source chart point field
          field.scalarCovariantDerivative field.scalarCovariantDerivative +
        parameter *
          (scalarKineticPolarizedDensity source chart point field linear
              field.scalarCovariantDerivative +
            scalarKineticPolarizedDensity source chart point field
              field.scalarCovariantDerivative linear) +
        parameter ^ 2 *
          (scalarKineticPolarizedDensity source chart point field quadratic
              field.scalarCovariantDerivative +
            scalarKineticPolarizedDensity source chart point field
              field.scalarCovariantDerivative quadratic +
            scalarKineticPolarizedDensity source chart point field linear
              linear) +
        parameter ^ 3 *
          (scalarKineticPolarizedDensity source chart point field linear
              quadratic +
            scalarKineticPolarizedDensity source chart point field quadratic
              linear) +
        parameter ^ 4 *
          scalarKineticPolarizedDensity source chart point field quadratic
            quadratic
  simp only [scalarKineticPolarizedDensity_add_left,
    scalarKineticPolarizedDensity_add_right,
    scalarKineticPolarizedDensity_smul_left,
    scalarKineticPolarizedDensity_smul_right]
  ring

end

end
  SaturationMonoid.PhysicsCore.StageNineP286LinkedActiveScalarKineticPathPolynomial
