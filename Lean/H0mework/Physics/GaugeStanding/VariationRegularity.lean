import H0mework.Physics.GaugeStanding.Variation

/-!
# S9-C: regularity of the linked active P286 primitive path

The linked path preserves nondegeneracy because its five primitive mouths do
not change the coframe.  Under smooth background fields, the same compactly
supported smooth gauge parameter also generates compact-smooth auxiliary,
scalar, and matter-coordinate directions.

The conjugate direction is proved compactly supported below.  Its remaining
smoothness obligation is not exposed as a supplied regularity receipt: the
current public API has no continuous bilinear contragredient-coordinate
action combining a varying matter dual with the P286 matter action.

No Ward identity, stationarity, field equation, or residual-zero premise is
used.
-/

open SaturationMonoid

namespace SaturationMonoid.PhysicsCore.StageNineP286LinkedActiveVariationRegularity

open ProofFreeRicherAnholonomicSource
open StageNineCompactSupportIntegrationByParts
open StageNineDynamicBreakingVacuum
open StageNineHolonomicField
open StageNineP286GaugeAuxiliaryVariation
open StageNineP286GaugeConnectionVariationDensity
open StageNineP286InfinitesimalGaugeTransformation
open StageNineP286LinkedActiveVariation
open StageNineConjugateMatterVariation
open SU7MotherGaugeTheory
open SU7MotherLieAlgebra
open DiracExteriorMatterAction
open scoped ContDiff

noncomputable section

set_option autoImplicit false

local instance matterCoordinateIndexFintype : Fintype MatterCoordinateIndex :=
  Fintype.ofFinite MatterCoordinateIndex

local instance p286ModuleFinite : Module.Finite ℝ P286LieBlockData :=
  FiniteDimensional.of_injective p286AmbientLinear
    p286AmbientLinear_injective

local instance p286CoordinateIndexFintype : Fintype P286CoordinateIndex :=
  StageNineP286InfinitesimalGaugeTransformation.p286CoordinateIndexFintype

local instance p286CoordinateIsTopologicalAddGroup :
    IsTopologicalAddGroup P286CoordinateCarrier where
  toContinuousAdd := inferInstance
  toContinuousNeg := inferInstance

/-! ## Geometry is unchanged -/

theorem p286LinkedActivePrimitivePath_nondegenerate
    (configuration : StageNineHolonomicConfiguration)
    (nondegenerate : configuration.Nondegenerate)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ) :
    (p286LinkedActivePrimitivePath configuration gaugeParameter
      parameter).Nondegenerate := by
  intro point
  simpa using nondegenerate point

/-! ## Compact-smooth charged directions -/

/-- The adjoint auxiliary direction generated by the same local parameter. -/
def p286LinkedActiveAuxiliaryVariation
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (gaugeParameter : P286InfinitesimalGaugeParameter) :
    CompactlySupportedSmoothVariation P286GaugeTwoForm where
  toFun := fun point =>
    (representationDerivedP286CoupledGaugeTangentSection configuration
      gaugeParameter point).auxiliary
  smooth := by
    apply contDiff_pi'
    intro pair
    change ContDiff ℝ ∞ fun point =>
      p286CoordinateLieBracketBilinear (gaugeParameter point)
        (p286CoordinateEquiv (configuration.gaugeAuxiliary point pair))
    exact
      (p286CoordinateLieBracketBilinear.toContinuousBilinearMap.contDiff.comp
        gaugeParameter.smooth).clm_apply
        (smooth.2.2.2.2.2.1 pair)
  compactSupport := by
    have parameterEventually := gaugeParameter.compactSupport
    rw [hasCompactSupport_iff_eventuallyEq] at parameterEventually ⊢
    filter_upwards [parameterEventually] with point parameterZero
    have parameterZero' : gaugeParameter point = 0 := by
      simpa using parameterZero
    funext pair
    simp [representationDerivedP286CoupledGaugeTangentSection,
      representationDerivedP286CoupledGaugeTangentAt, parameterZero']

@[simp] theorem p286LinkedActiveAuxiliaryVariation_apply
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (point : BasePoint) :
    p286LinkedActiveAuxiliaryVariation configuration smooth gaugeParameter
        point =
      (representationDerivedP286CoupledGaugeTangentSection configuration
        gaugeParameter point).auxiliary :=
  rfl

/-- The breaking-scalar direction generated by the same local parameter. -/
def p286LinkedActiveScalarVariation
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (gaugeParameter : P286InfinitesimalGaugeParameter) :
    CompactlySupportedSmoothVariation ScalarCoordinateCarrier where
  toFun := fun point =>
    (representationDerivedP286CoupledGaugeTangentSection configuration
      gaugeParameter point).scalar
  smooth := by
    change ContDiff ℝ ∞ fun point =>
      scalarP286ActionBilinear (gaugeParameter point)
        (configuration.scalar point)
    exact
      (scalarP286ActionBilinear.toContinuousBilinearMap.contDiff.comp
        gaugeParameter.smooth).clm_apply
        smooth.2.2.2.2.2.2.1
  compactSupport := by
    have parameterEventually := gaugeParameter.compactSupport
    rw [hasCompactSupport_iff_eventuallyEq] at parameterEventually ⊢
    filter_upwards [parameterEventually] with point parameterZero
    have parameterZero' : gaugeParameter point = 0 := by
      simpa using parameterZero
    change scalarP286ActionBilinear (gaugeParameter point)
      (configuration.scalar point) = 0
    simp [parameterZero']

@[simp] theorem p286LinkedActiveScalarVariation_apply
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (point : BasePoint) :
    p286LinkedActiveScalarVariation configuration smooth gaugeParameter point =
      (representationDerivedP286CoupledGaugeTangentSection configuration
        gaugeParameter point).scalar :=
  rfl

/-- Matter coordinates of the representation-derived matter direction. -/
def p286LinkedActiveMatterVariation
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (gaugeParameter : P286InfinitesimalGaugeParameter) :
    CompactlySupportedSmoothVariation MatterCoordinateCarrier where
  toFun := fun point =>
    matterCoordinateEquiv
      (representationDerivedP286CoupledGaugeTangentSection configuration
        gaugeParameter point).matter
  smooth := by
    change ContDiff ℝ ∞ fun point =>
      matterCoordinateEquiv
        (diracExteriorMotherLieAction
          (p286LieBlockEmbed
            (p286CoordinateEquiv.symm (gaugeParameter point)))
          (configuration.matter point))
    have actual :=
      (matterP286ActionCoordinateBilinear.toContinuousBilinearMap.contDiff.comp
        gaugeParameter.smooth).clm_apply
        smooth.2.2.2.2.2.2.2.1
    change ContDiff ℝ ∞ fun point =>
      matterCoordinateEquiv
        (diracExteriorMotherLieAction
          (p286LieBlockEmbed
            (p286CoordinateEquiv.symm (gaugeParameter point)))
          (matterCoordinateEquiv.symm
            (matterCoordinateEquiv (configuration.matter point)))) at actual
    simpa only [matterCoordinateEquiv.symm_apply_apply] using actual
  compactSupport := by
    have parameterEventually := gaugeParameter.compactSupport
    rw [hasCompactSupport_iff_eventuallyEq] at parameterEventually ⊢
    filter_upwards [parameterEventually] with point parameterZero
    have parameterZero' : gaugeParameter point = 0 := by
      simpa using parameterZero
    change matterCoordinateEquiv
      (diracExteriorMotherLieAction
        (p286LieBlockEmbed
          (p286CoordinateEquiv.symm (gaugeParameter point)))
        (configuration.matter point)) = 0
    simp [parameterZero']

@[simp] theorem p286LinkedActiveMatterVariation_apply
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (point : BasePoint) :
    p286LinkedActiveMatterVariation configuration smooth gaugeParameter point =
      matterCoordinateEquiv
        (representationDerivedP286CoupledGaugeTangentSection configuration
          gaugeParameter point).matter :=
  rfl

/-! ## Conjugate-coordinate compact support -/

theorem p286LinkedActiveConjugateMatterCoordinate_compactSupport
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter) :
    HasCompactSupport fun point =>
      matterDualCoordinates
        (representationDerivedP286CoupledGaugeTangentSection configuration
          gaugeParameter point).conjugateMatter := by
  have parameterEventually := gaugeParameter.compactSupport
  rw [hasCompactSupport_iff_eventuallyEq] at parameterEventually ⊢
  filter_upwards [parameterEventually] with point parameterZero
  have parameterZero' : gaugeParameter point = 0 := by
    simpa using parameterZero
  apply PiLp.ext
  intro index
  simp [representationDerivedP286CoupledGaugeTangentSection,
    representationDerivedP286CoupledGaugeTangentAt,
    p286GaugeParameterMotherAt, matterDualCoordinates, parameterZero']

end

end SaturationMonoid.PhysicsCore.StageNineP286LinkedActiveVariationRegularity
