import H0mework.Physics.GaugeAction.P286FrozenSourceScalarTorque
import H0mework.Physics.GaugeStanding.GaugeBFAlgebra
import H0mework.Physics.GaugeStanding.MatterDensityCancellation
import H0mework.Physics.GaugeStanding.ScalarKineticCancellation

/-!
# S9-C: complete linked active P286 local Ward coefficient

This module assembles the first-order coefficients generated by one linked
P286 primitive tangent at one point:

* the P286 gauge--BF coefficient;
* the scalar kinetic coefficient;
* the complete Dirac--Yukawa plus conjugate-matter coefficient;
* the frozen-source scalar-potential torque.

Gravity and coframe primitives are fixed by this internal variation.  The
three active-field sectors cancel, leaving exactly the source-relative
torque.  This file closes the pointwise coefficient algebra; it deliberately
does not yet claim that the coefficient has been integrated or identified
with a `HasDerivAt` of the full action path.
-/

open SaturationMonoid

namespace
  SaturationMonoid.PhysicsCore.StageNineP286LinkedActiveLocalWardCoefficient

open ProofFreeRicherAnholonomicSource
open StageNineEnrichedProofFreeSource
open StageNineHolonomicField
open StageNineP286FrozenSourceScalarTorque
open StageNineP286InfinitesimalGaugeTransformation
open StageNineP286LinkedActiveGaugeBFAlgebra
open StageNineP286LinkedActiveMatterDensityCancellation
open StageNineP286LinkedActiveScalarKineticCancellation

noncomputable section

set_option autoImplicit false

/-- Complete pointwise first coefficient generated by the linked active P286
primitive tangent, with the source held fixed. -/
def linkedActiveFullLocalFirstVariationDensity
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (point : BasePoint) : ℝ :=
  holonomicP286LinkedActiveGaugeBFFirstVariationDensity source configuration
      gaugeParameter point +
    linkedActiveScalarKineticFirstVariationDensity source configuration
      gaugeParameter point +
    linkedActiveMatterDensityFirstVariation source configuration
      gaugeParameter point +
    p286FrozenSourceScalarTorqueDensity source configuration gaugeParameter
      point

/-- The actual linked active pointwise coefficient reduces to the honest
frozen-source scalar torque; no active-field term is dropped. -/
theorem linkedActiveFullLocalFirstVariationDensity_eq_torque
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (point : BasePoint) :
    linkedActiveFullLocalFirstVariationDensity source configuration
        gaugeParameter point =
      p286FrozenSourceScalarTorqueDensity source configuration gaugeParameter
        point := by
  unfold linkedActiveFullLocalFirstVariationDensity
  rw [holonomicP286LinkedActiveGaugeBFFirstVariationDensity_eq_zero
      source configuration smooth gaugeParameter point,
    linkedActiveScalarKineticFirstVariationDensity_eq_zero
      source configuration smooth gaugeParameter point,
    linkedActiveMatterDensityFirstVariation_eq_zero
      source configuration smooth gaugeParameter point]
  ring

end

end
  SaturationMonoid.PhysicsCore.StageNineP286LinkedActiveLocalWardCoefficient
