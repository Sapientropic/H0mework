open StageNineScalarVariation

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 600000
set_option synthInstance.maxHeartbeats 100000

/-- Explicit first coefficient of the complete root local density.  Every
summand is a readout of the same initial point field and linked tangent. -/
def p286LinkedActiveFullLocalFirstCoefficient
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (point : BasePoint) : ℝ :=
  let field := toContinuumPointField configuration point
  let tangent :=
    representationDerivedP286CoupledGaugeTangentSection configuration
      gaugeParameter point
  generatedVolumeDensity field *
      p286GaugeBFJointPathFirstCoefficient field.coframe
        (coframeGaugeSpacetimeHodgeLinear field.coframe)
        (((sourceGeneratedUnifiedCouplings source).strongCouplingSquared : ℝ) •
          coframeGaugeSpacetimeHodgeLinear field.coframe)
        (p286CurvatureCoordinate field)
        (p286AuxiliaryCoordinate field)
        (linkedActiveP286CurvatureLinearResponse configuration gaugeParameter
          point)
        tangent.auxiliary +
    generatedVolumeDensity field *
      scalarKineticQuadraticJetPathFirstCoefficient source 0 point field
        (linkedActiveScalarCovariantJetResponse configuration gaugeParameter
          point) +
    p286LinkedMatterDensityFirstCoefficient source point field
      tangent.scalar tangent.matter
      (linkedActiveMatterCovariantJetResponse configuration gaugeParameter
        point)
      tangent.conjugateMatter -
    generatedVolumeDensity field *
      scalarPotentialFirstVariation source field tangent.scalar

/-- Explicit second coefficient.  It records every quadratic-response and
cross term generated by the same primitive path. -/
def p286LinkedActiveFullLocalSecondCoefficient
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (point : BasePoint) : ℝ :=
  let field := toContinuumPointField configuration point
  let tangent :=
    representationDerivedP286CoupledGaugeTangentSection configuration
      gaugeParameter point
  generatedVolumeDensity field *
      p286GaugeBFJointPathSecondCoefficient field.coframe
        (coframeGaugeSpacetimeHodgeLinear field.coframe)
        (((sourceGeneratedUnifiedCouplings source).strongCouplingSquared : ℝ) •
          coframeGaugeSpacetimeHodgeLinear field.coframe)
        (p286AuxiliaryCoordinate field)
        (linkedActiveP286CurvatureLinearResponse configuration gaugeParameter
          point)
        (linkedActiveP286CurvatureQuadraticResponse configuration
          gaugeParameter point)
        tangent.auxiliary +
    generatedVolumeDensity field *
      scalarKineticQuadraticJetPathSecondCoefficient source 0 point field
        (linkedActiveScalarCovariantJetResponse configuration gaugeParameter
          point)
        (linkedActiveScalarCovariantJetQuadraticResponse configuration
          gaugeParameter point) +
    p286LinkedMatterDensitySecondCoefficient source point field
      tangent.scalar tangent.matter
      (linkedActiveMatterCovariantJetResponse configuration gaugeParameter
        point)
      (linkedActiveMatterCovariantJetQuadraticResponse configuration
        gaugeParameter point)
      tangent.conjugateMatter -
    generatedVolumeDensity field * scalarCoordinateSquaredNorm tangent.scalar

/-- Explicit cubic coefficient.  Only the gauge--BF, scalar-kinetic, and
matter sectors have cubic cross terms. -/
def p286LinkedActiveFullLocalThirdCoefficient
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (point : BasePoint) : ℝ :=
  let field := toContinuumPointField configuration point
  let tangent :=
    representationDerivedP286CoupledGaugeTangentSection configuration
      gaugeParameter point
  generatedVolumeDensity field *
      p286GaugeBFJointPathThirdCoefficient field.coframe
        (coframeGaugeSpacetimeHodgeLinear field.coframe)
        (linkedActiveP286CurvatureQuadraticResponse configuration
          gaugeParameter point)
        tangent.auxiliary +
    generatedVolumeDensity field *
      scalarKineticQuadraticJetPathThirdCoefficient source 0 point field
        (linkedActiveScalarCovariantJetResponse configuration gaugeParameter
          point)
        (linkedActiveScalarCovariantJetQuadraticResponse configuration
          gaugeParameter point) +
    p286LinkedMatterDensityThirdCoefficient source point field
      tangent.scalar tangent.matter
      (linkedActiveMatterCovariantJetQuadraticResponse configuration
        gaugeParameter point)
      tangent.conjugateMatter

/-- Explicit quartic coefficient.  It is exactly the square of the scalar
covariant-jet quadratic response, with the frozen volume inserted once. -/
def p286LinkedActiveFullLocalFourthCoefficient
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (point : BasePoint) : ℝ :=
  let field := toContinuumPointField configuration point
  generatedVolumeDensity field *
    scalarKineticQuadraticJetPathFourthCoefficient source 0 point field
      (linkedActiveScalarCovariantJetQuadraticResponse configuration
        gaugeParameter point)

/-! ## Sector readouts of the one typed point-field normal form -/

private theorem p286CurvatureCoordinate_pointFieldNormalForm
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ)
    (point : BasePoint) :
    p286CurvatureCoordinate
        (p286LinkedActivePointFieldNormalForm configuration gaugeParameter
          parameter point) =
      p286CurvatureCoordinate
          (toContinuumPointField configuration point) +
        parameter •
          linkedActiveP286CurvatureLinearResponse configuration gaugeParameter
            point +
        parameter ^ 2 •
          linkedActiveP286CurvatureQuadraticResponse configuration
            gaugeParameter point := by
  funext pair
  simp [p286CurvatureCoordinate, p286LinkedActivePointFieldNormalForm,
    Pi.add_apply, Pi.smul_apply]
  rfl

private theorem p286AuxiliaryCoordinate_pointFieldNormalForm
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ)
    (point : BasePoint) :
    p286AuxiliaryCoordinate
        (p286LinkedActivePointFieldNormalForm configuration gaugeParameter
          parameter point) =
      p286AuxiliaryCoordinate
          (toContinuumPointField configuration point) +
        parameter •
          (representationDerivedP286CoupledGaugeTangentSection configuration
            gaugeParameter point).auxiliary := by
  funext pair
  simp [p286AuxiliaryCoordinate, p286LinkedActivePointFieldNormalForm,
    Pi.add_apply, Pi.smul_apply]
  rfl

private theorem generatedVolumeDensity_pointFieldNormalForm
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ)
    (point : BasePoint) :
    generatedVolumeDensity
        (p286LinkedActivePointFieldNormalForm configuration gaugeParameter
          parameter point) =
      generatedVolumeDensity
        (toContinuumPointField configuration point) := by
  rfl

private theorem p286LinkedActivePointFieldNormalForm_coframe
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ)
    (point : BasePoint) :
    (p286LinkedActivePointFieldNormalForm configuration gaugeParameter
        parameter point).coframe =
      (toContinuumPointField configuration point).coframe := by
  rfl

private theorem generatedGravitySimplicityDensity_pointFieldNormalForm
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ)
    (point : BasePoint) :
    generatedGravitySimplicityDensity
        (p286LinkedActivePointFieldNormalForm configuration gaugeParameter
          parameter point) =
      generatedGravitySimplicityDensity
        (toContinuumPointField configuration point) := by
  rfl

private theorem generatedGravityBFDensity_pointFieldNormalForm
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ)
    (point : BasePoint) :
    generatedGravityBFDensity
        (p286LinkedActivePointFieldNormalForm configuration gaugeParameter
          parameter point) =
      generatedGravityBFDensity
        (toContinuumPointField configuration point) := by
  rfl

private theorem generatedScalarKineticDensity_pointFieldNormalForm_quartic
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ)
    (point : BasePoint) :
    generatedScalarKineticDensity source 0 point
        (p286LinkedActivePointFieldNormalForm configuration gaugeParameter
          parameter point) =
      generatedScalarKineticDensity source 0 point
          (toContinuumPointField configuration point) +
        parameter *
          scalarKineticQuadraticJetPathFirstCoefficient source 0 point
            (toContinuumPointField configuration point)
            (linkedActiveScalarCovariantJetResponse configuration
              gaugeParameter point) +
        parameter ^ 2 *
          scalarKineticQuadraticJetPathSecondCoefficient source 0 point
            (toContinuumPointField configuration point)
            (linkedActiveScalarCovariantJetResponse configuration
              gaugeParameter point)
            (linkedActiveScalarCovariantJetQuadraticResponse configuration
              gaugeParameter point) +
        parameter ^ 3 *
          scalarKineticQuadraticJetPathThirdCoefficient source 0 point
            (toContinuumPointField configuration point)
            (linkedActiveScalarCovariantJetResponse configuration
              gaugeParameter point)
            (linkedActiveScalarCovariantJetQuadraticResponse configuration
              gaugeParameter point) +
        parameter ^ 4 *
          scalarKineticQuadraticJetPathFourthCoefficient source 0 point
            (toContinuumPointField configuration point)
            (linkedActiveScalarCovariantJetQuadraticResponse configuration
              gaugeParameter point) := by
  simpa only [generatedScalarKineticDensity,
    p286LinkedActivePointFieldNormalForm, toContinuumPointField,
    withScalarCovariantDerivativeQuadraticPath] using
    generatedScalarKineticDensity_quadraticJetPath_quartic source 0 point
      (toContinuumPointField configuration point)
      (linkedActiveScalarCovariantJetResponse configuration gaugeParameter
        point)
      (linkedActiveScalarCovariantJetQuadraticResponse configuration
        gaugeParameter point)
      parameter

private theorem generatedScalarPotential_pointFieldNormalForm_quadratic
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ)
    (point : BasePoint) :
    generatedScalarPotential source 0 point
        (p286LinkedActivePointFieldNormalForm configuration gaugeParameter
          parameter point).scalar =
      generatedScalarPotential source 0 point
          (toContinuumPointField configuration point).scalar +
        parameter *
          scalarPotentialFirstVariation source
            (toContinuumPointField configuration point)
            (representationDerivedP286CoupledGaugeTangentSection configuration
              gaugeParameter point).scalar +
        parameter ^ 2 *
          scalarCoordinateSquaredNorm
            (representationDerivedP286CoupledGaugeTangentSection configuration
              gaugeParameter point).scalar := by
  simpa only [p286LinkedActivePointFieldNormalForm, toContinuumPointField,
    withScalarJets] using
    generatedScalarPotential_withScalarJets_quadratic source point
      (toContinuumPointField configuration point)
      (representationDerivedP286CoupledGaugeTangentSection configuration
        gaugeParameter point).scalar
      (toContinuumPointField configuration point).scalarCovariantDerivative
      parameter

private theorem generatedContinuumMatterDensity_pointFieldNormalForm_cubic
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ)
    (point : BasePoint) :
    generatedVolumeDensity (toContinuumPointField configuration point) *
        generatedContinuumMatterDensity source 0 point
          (p286LinkedActivePointFieldNormalForm configuration gaugeParameter
            parameter point) =
      generatedVolumeDensity (toContinuumPointField configuration point) *
          generatedContinuumMatterDensity source 0 point
            (toContinuumPointField configuration point) +
        parameter *
          p286LinkedMatterDensityFirstCoefficient source point
            (toContinuumPointField configuration point)
            (representationDerivedP286CoupledGaugeTangentSection configuration
              gaugeParameter point).scalar
            (representationDerivedP286CoupledGaugeTangentSection configuration
              gaugeParameter point).matter
            (linkedActiveMatterCovariantJetResponse configuration
              gaugeParameter point)
            (representationDerivedP286CoupledGaugeTangentSection configuration
              gaugeParameter point).conjugateMatter +
        parameter ^ 2 *
          p286LinkedMatterDensitySecondCoefficient source point
            (toContinuumPointField configuration point)
            (representationDerivedP286CoupledGaugeTangentSection configuration
              gaugeParameter point).scalar
            (representationDerivedP286CoupledGaugeTangentSection configuration
              gaugeParameter point).matter
            (linkedActiveMatterCovariantJetResponse configuration
              gaugeParameter point)
            (linkedActiveMatterCovariantJetQuadraticResponse configuration
              gaugeParameter point)
            (representationDerivedP286CoupledGaugeTangentSection configuration
              gaugeParameter point).conjugateMatter +
        parameter ^ 3 *
          p286LinkedMatterDensityThirdCoefficient source point
            (toContinuumPointField configuration point)
            (representationDerivedP286CoupledGaugeTangentSection configuration
              gaugeParameter point).scalar
            (representationDerivedP286CoupledGaugeTangentSection configuration
              gaugeParameter point).matter
            (linkedActiveMatterCovariantJetQuadraticResponse configuration
              gaugeParameter point)
            (representationDerivedP286CoupledGaugeTangentSection configuration
              gaugeParameter point).conjugateMatter := by
  simpa only [generatedContinuumMatterDensity,
    generatedContinuumMatterVector, p286LinkedActivePointFieldNormalForm,
    toContinuumPointField, withP286LinkedMatterPathData] using
    generatedContinuumMatterDensity_p286LinkedMatterPath_cubic source point
      (toContinuumPointField configuration point)
      (representationDerivedP286CoupledGaugeTangentSection configuration
        gaugeParameter point).scalar
      (representationDerivedP286CoupledGaugeTangentSection configuration
        gaugeParameter point).matter
      (linkedActiveMatterCovariantJetResponse configuration gaugeParameter
        point)
      (linkedActiveMatterCovariantJetQuadraticResponse configuration
        gaugeParameter point)
      (representationDerivedP286CoupledGaugeTangentSection configuration
        gaugeParameter point).conjugateMatter
      parameter

/-! ## Root coefficient fidelity and exact polynomial -/

theorem p286LinkedActiveFullLocalFirstCoefficient_eq_existing
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (point : BasePoint) :
    p286LinkedActiveFullLocalFirstCoefficient source configuration
        gaugeParameter point =
      linkedActiveFullLocalFirstVariationDensity source configuration
        gaugeParameter point := by
  unfold p286LinkedActiveFullLocalFirstCoefficient
    linkedActiveFullLocalFirstVariationDensity
    holonomicP286LinkedActiveGaugeBFFirstVariationDensity
    linkedActiveScalarKineticFirstVariationDensity
    p286FrozenSourceScalarTorqueDensity
    p286GaugeBFJointPathFirstCoefficient
    linkedActiveP286CurvatureLinearResponse
  dsimp only
  rw [p286LinkedMatterDensityFirstCoefficient_eq_linkedActive]
  rw [scalarKineticQuadraticJetPathFirstCoefficient_eq_firstVariation]
  simp only [representationDerivedP286CoupledGaugeTangentSection_apply]
  ring

/-- Exact quartic normal form of the complete chart-zero root local density
on the one actual linked primitive path. -/
theorem generatedUnifiedLocalDensity_p286LinkedActivePrimitivePath_quartic
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (parameter : ℝ)
    (point : BasePoint) :
    generatedUnifiedLocalDensityAtBoundary source
        (sourceGeneratedUnifiedCouplings source) 0 point
        (toContinuumPointField
          (p286LinkedActivePrimitivePath configuration gaugeParameter
            parameter)
          point) =
      generatedUnifiedLocalDensityAtBoundary source
          (sourceGeneratedUnifiedCouplings source) 0 point
          (toContinuumPointField configuration point) +
        parameter *
          p286LinkedActiveFullLocalFirstCoefficient source configuration
            gaugeParameter point +
        parameter ^ 2 *
          p286LinkedActiveFullLocalSecondCoefficient source configuration
            gaugeParameter point +
        parameter ^ 3 *
          p286LinkedActiveFullLocalThirdCoefficient source configuration
            gaugeParameter point +
        parameter ^ 4 *
          p286LinkedActiveFullLocalFourthCoefficient source configuration
            gaugeParameter point := by
  rw [toContinuumPointField_p286LinkedActivePrimitivePath configuration smooth
    gaugeParameter parameter point]
  rw [generatedUnifiedLocalDensity_p286_decomposition,
    generatedUnifiedLocalDensity_p286_decomposition]
  unfold generatedUnifiedLocalDensityP286IndependentCore
  rw [p286LinkedActivePointFieldNormalForm_coframe,
    generatedVolumeDensity_pointFieldNormalForm,
    generatedGravitySimplicityDensity_pointFieldNormalForm,
    generatedGravityBFDensity_pointFieldNormalForm]
  rw [p286CurvatureCoordinate_pointFieldNormalForm,
    p286AuxiliaryCoordinate_pointFieldNormalForm]
  rw [generatedGaugeSectorBFDensity_p286Coordinate_joint_cubic]
  rw [generatedScalarKineticDensity_pointFieldNormalForm_quartic,
    generatedScalarPotential_pointFieldNormalForm_quadratic]
  have matterExpansion :=
    generatedContinuumMatterDensity_pointFieldNormalForm_cubic source
      configuration gaugeParameter parameter point
  unfold p286LinkedActiveFullLocalFirstCoefficient
    p286LinkedActiveFullLocalSecondCoefficient
    p286LinkedActiveFullLocalThirdCoefficient
    p286LinkedActiveFullLocalFourthCoefficient
  dsimp only
  linear_combination matterExpansion

/-- The complete actual root local density has the previously assembled
linked-active first coefficient as its derivative at the path origin. -/
theorem generatedUnifiedLocalDensity_p286LinkedActivePrimitivePath_hasDerivAt
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (point : BasePoint) :
    HasDerivAt
      (fun parameter =>
        generatedUnifiedLocalDensityAtBoundary source
          (sourceGeneratedUnifiedCouplings source) 0 point
          (toContinuumPointField
            (p286LinkedActivePrimitivePath configuration gaugeParameter
              parameter)
            point))
      (linkedActiveFullLocalFirstVariationDensity source configuration
        gaugeParameter point)
      0 := by
  let base :=
    generatedUnifiedLocalDensityAtBoundary source
      (sourceGeneratedUnifiedCouplings source) 0 point
      (toContinuumPointField configuration point)
  let first :=
    p286LinkedActiveFullLocalFirstCoefficient source configuration
      gaugeParameter point
  let second :=
    p286LinkedActiveFullLocalSecondCoefficient source configuration
      gaugeParameter point
  let third :=
    p286LinkedActiveFullLocalThirdCoefficient source configuration
      gaugeParameter point
  let fourth :=
    p286LinkedActiveFullLocalFourthCoefficient source configuration
      gaugeParameter point
  have functionEquality :
      (fun parameter =>
        generatedUnifiedLocalDensityAtBoundary source
          (sourceGeneratedUnifiedCouplings source) 0 point
          (toContinuumPointField
            (p286LinkedActivePrimitivePath configuration gaugeParameter
              parameter)
            point)) =
        fun parameter =>
          base + parameter * first + parameter ^ 2 * second +
            parameter ^ 3 * third + parameter ^ 4 * fourth := by
    funext parameter
    exact
      generatedUnifiedLocalDensity_p286LinkedActivePrimitivePath_quartic
        source configuration smooth gaugeParameter parameter point
  have polynomialDerivative :
      HasDerivAt
        (fun parameter =>
          base + parameter * first + parameter ^ 2 * second +
            parameter ^ 3 * third + parameter ^ 4 * fourth)
        first 0 := by
    change HasDerivAt
      ((((fun parameter => base + parameter * first) +
          fun parameter => parameter ^ 2 * second) +
          fun parameter => parameter ^ 3 * third) +
          fun parameter => parameter ^ 4 * fourth)
      first 0
    simpa using
      ((((((hasDerivAt_id (x := (0 : ℝ))).mul_const first).const_add base).add
        (((hasDerivAt_id (x := (0 : ℝ))).pow 2).mul_const second)).add
        (((hasDerivAt_id (x := (0 : ℝ))).pow 3).mul_const third)).add
        (((hasDerivAt_id (x := (0 : ℝ))).pow 4).mul_const fourth))
  rw [functionEquality]
  rw [← p286LinkedActiveFullLocalFirstCoefficient_eq_existing]
  exact polynomialDerivative

/-- With a smooth actual configuration, the local derivative is the honest
frozen-source torque.  This is a readout of the derivative theorem, not a
stationarity claim. -/
theorem generatedUnifiedLocalDensity_p286LinkedActivePrimitivePath_hasDerivAt_torque
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (gaugeParameter : P286InfinitesimalGaugeParameter)
    (point : BasePoint) :
    HasDerivAt
      (fun parameter =>
        generatedUnifiedLocalDensityAtBoundary source
          (sourceGeneratedUnifiedCouplings source) 0 point
          (toContinuumPointField
            (p286LinkedActivePrimitivePath configuration gaugeParameter
              parameter)
            point))
      (p286FrozenSourceScalarTorqueDensity source configuration gaugeParameter
        point)
      0 := by
  rw [← linkedActiveFullLocalFirstVariationDensity_eq_torque source
    configuration smooth gaugeParameter point]
  exact
    generatedUnifiedLocalDensity_p286LinkedActivePrimitivePath_hasDerivAt
      source configuration smooth gaugeParameter point

end

