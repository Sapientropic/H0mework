import H0mework.Physics.MatterJets.MatterActionTemporalFirstGermResponse

/-!
# S9-C3h183a: complete primal-matter first-germ principal response

This module isolates the finite-dimensional algebra behind the complete
four-direction response.  Its carrier stores only the time--time and
time--space Hessian entries.  Symmetry and the zero spatial--spatial block are
therefore generated by the evaluator rather than supplied as receipts.

For an actual first-germ residual `Rν`, the identity-coframe principal symbols
`Pμ` generate the unique Hessian in this temporal-pivot carrier satisfying

`sum μ, Pμ (H μ ν) + Rν = 0`.

Substitution into this same equation is producer soundness, not an independent
field-equation closure.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineMatterCompleteFirstGermPrincipal

open DiracExteriorMatterAction
open ProofFreeRicherAnholonomicSource
open StageNineConjugateMatterActionTimeVelocity
open StageNineMatterActionTemporalFirstGermResponse
open StageNineP286ActionCauchySplit
open scoped Matrix

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 3000000
set_option synthInstance.maxHeartbeats 200000

/-! ## Minimal symmetric temporal-pivot carrier -/

/-- The smallest symmetric Hessian carrier whose spatial--spatial block is
fixed to zero. -/
@[ext] structure TemporalPivotMatterHessian where
  timeTime : DiracExteriorMatterCarrier
  timeSpatial : Fin 3 → DiracExteriorMatterCarrier

instance : Zero TemporalPivotMatterHessian where
  zero := { timeTime := 0, timeSpatial := 0 }

@[simp] theorem temporalPivotMatterHessian_zero_timeTime :
    (0 : TemporalPivotMatterHessian).timeTime = 0 :=
  rfl

@[simp] theorem temporalPivotMatterHessian_zero_timeSpatial
    (axis : Fin 3) :
    (0 : TemporalPivotMatterHessian).timeSpatial axis = 0 :=
  rfl

/-- Evaluation as the explicit symmetric four-by-four Hessian matrix. -/
def temporalPivotMatterHessianValue
    (hessian : TemporalPivotMatterHessian) :
    LorentzianIndex → LorentzianIndex → DiracExteriorMatterCarrier :=
  !![hessian.timeTime,
      hessian.timeSpatial 0, hessian.timeSpatial 1, hessian.timeSpatial 2;
     hessian.timeSpatial 0, 0, 0, 0;
     hessian.timeSpatial 1, 0, 0, 0;
     hessian.timeSpatial 2, 0, 0, 0]

@[simp] theorem temporalPivotMatterHessianValue_time_time
    (hessian : TemporalPivotMatterHessian) :
    temporalPivotMatterHessianValue hessian
        canonicalLorentzianTimeDirection canonicalLorentzianTimeDirection =
      hessian.timeTime := by
  simp [temporalPivotMatterHessianValue,
    canonicalLorentzianTimeDirection]

@[simp] theorem temporalPivotMatterHessianValue_time_spatial
    (hessian : TemporalPivotMatterHessian)
    (axis : Fin 3) :
    temporalPivotMatterHessianValue hessian
        canonicalLorentzianTimeDirection axis.succ =
      hessian.timeSpatial axis := by
  fin_cases axis <;>
    simp [temporalPivotMatterHessianValue,
      canonicalLorentzianTimeDirection, Matrix.cons_val]

@[simp] theorem temporalPivotMatterHessianValue_spatial_time
    (hessian : TemporalPivotMatterHessian)
    (axis : Fin 3) :
    temporalPivotMatterHessianValue hessian axis.succ
        canonicalLorentzianTimeDirection =
      hessian.timeSpatial axis := by
  fin_cases axis <;>
    simp [temporalPivotMatterHessianValue,
      canonicalLorentzianTimeDirection, Matrix.cons_val]

@[simp] theorem temporalPivotMatterHessianValue_spatial_spatial
    (hessian : TemporalPivotMatterHessian)
    (first second : Fin 3) :
    temporalPivotMatterHessianValue hessian first.succ second.succ = 0 := by
  fin_cases first <;> fin_cases second <;>
    simp [temporalPivotMatterHessianValue, Matrix.cons_val]

theorem temporalPivotMatterHessianValue_symmetric
    (hessian : TemporalPivotMatterHessian)
    (first second : LorentzianIndex) :
    temporalPivotMatterHessianValue hessian first second =
      temporalPivotMatterHessianValue hessian second first := by
  fin_cases first <;> fin_cases second <;>
    simp [temporalPivotMatterHessianValue, Matrix.cons_val]

/-! ## Principal response and canonical Hessian -/

def completeMatterFirstGermPrincipalResponse
    (hessian : TemporalPivotMatterHessian)
    (derivativeDirection : LorentzianIndex) :
    DiracExteriorMatterCarrier :=
  ∑ fieldDirection : LorentzianIndex,
    identityCoframeMatterPrincipal fieldDirection
      (temporalPivotMatterHessianValue hessian fieldDirection
        derivativeDirection)

theorem completeMatterFirstGermPrincipalResponse_time_normalForm
    (hessian : TemporalPivotMatterHessian) :
    completeMatterFirstGermPrincipalResponse hessian
        canonicalLorentzianTimeDirection =
      identityCoframeMatterPrincipal canonicalLorentzianTimeDirection
          hessian.timeTime +
        ∑ axis : Fin 3,
          identityCoframeMatterPrincipal axis.succ
            (hessian.timeSpatial axis) := by
  unfold completeMatterFirstGermPrincipalResponse
  rw [Fin.sum_univ_four, Fin.sum_univ_three]
  simp [canonicalLorentzianTimeDirection,
    temporalPivotMatterHessianValue, Matrix.cons_val]
  module

theorem completeMatterFirstGermPrincipalResponse_spatial_normalForm
    (hessian : TemporalPivotMatterHessian)
    (axis : Fin 3) :
    completeMatterFirstGermPrincipalResponse hessian axis.succ =
      identityCoframeMatterPrincipal canonicalLorentzianTimeDirection
        (hessian.timeSpatial axis) := by
  fin_cases axis <;>
    unfold completeMatterFirstGermPrincipalResponse <;>
    rw [Fin.sum_univ_four] <;>
    simp [canonicalLorentzianTimeDirection,
      temporalPivotMatterHessianValue, Matrix.cons_val]

def CompleteMatterFirstGermResponseLaw
    (residual : LorentzianIndex → DiracExteriorMatterCarrier)
    (hessian : TemporalPivotMatterHessian) : Prop :=
  ∀ derivativeDirection,
    completeMatterFirstGermPrincipalResponse hessian derivativeDirection +
        residual derivativeDirection =
      0

/-- Canonical action response.  Every entry is computed from `R` and the
existing identity-coframe principal symbols. -/
def canonicalCompleteMatterFirstGermHessian
    (residual : LorentzianIndex → DiracExteriorMatterCarrier) :
    TemporalPivotMatterHessian where
  timeSpatial axis :=
    -identityCoframeMatterPrincipal canonicalLorentzianTimeDirection
      (residual axis.succ)
  timeTime :=
    -identityCoframeMatterPrincipal canonicalLorentzianTimeDirection
        (residual canonicalLorentzianTimeDirection) +
      ∑ axis : Fin 3,
        identityCoframeMatterPrincipal canonicalLorentzianTimeDirection
          (identityCoframeMatterPrincipal axis.succ
            (identityCoframeMatterPrincipal
              canonicalLorentzianTimeDirection (residual axis.succ)))

theorem canonicalCompleteMatterFirstGermHessian_spatial_response
    (residual : LorentzianIndex → DiracExteriorMatterCarrier)
    (axis : Fin 3) :
    completeMatterFirstGermPrincipalResponse
        (canonicalCompleteMatterFirstGermHessian residual) axis.succ =
      -residual axis.succ := by
  rw [completeMatterFirstGermPrincipalResponse_spatial_normalForm]
  change
    identityCoframeMatterPrincipal canonicalLorentzianTimeDirection
        (-identityCoframeMatterPrincipal canonicalLorentzianTimeDirection
          (residual axis.succ)) =
      -residual axis.succ
  rw [map_neg, identityCoframeMatterPrincipal_time_involutive]

theorem canonicalCompleteMatterFirstGermHessian_time_response
    (residual : LorentzianIndex → DiracExteriorMatterCarrier) :
    completeMatterFirstGermPrincipalResponse
        (canonicalCompleteMatterFirstGermHessian residual)
        canonicalLorentzianTimeDirection =
      -residual canonicalLorentzianTimeDirection := by
  rw [completeMatterFirstGermPrincipalResponse_time_normalForm]
  change
    identityCoframeMatterPrincipal canonicalLorentzianTimeDirection
          (-identityCoframeMatterPrincipal canonicalLorentzianTimeDirection
              (residual canonicalLorentzianTimeDirection) +
            ∑ axis : Fin 3,
              identityCoframeMatterPrincipal canonicalLorentzianTimeDirection
                (identityCoframeMatterPrincipal axis.succ
                  (identityCoframeMatterPrincipal
                    canonicalLorentzianTimeDirection
                    (residual axis.succ)))) +
        ∑ axis : Fin 3,
          identityCoframeMatterPrincipal axis.succ
            (-identityCoframeMatterPrincipal canonicalLorentzianTimeDirection
              (residual axis.succ)) =
      -residual canonicalLorentzianTimeDirection
  rw [map_add, map_neg, map_sum,
    identityCoframeMatterPrincipal_time_involutive]
  simp_rw [identityCoframeMatterPrincipal_time_involutive, map_neg]
  simp [Finset.sum_neg_distrib, add_assoc]

/-- Producer-soundness of the canonical Hessian at the algebraic action
socket. -/
theorem canonicalCompleteMatterFirstGermHessian_producerSound
    (residual : LorentzianIndex → DiracExteriorMatterCarrier) :
    CompleteMatterFirstGermResponseLaw residual
      (canonicalCompleteMatterFirstGermHessian residual) := by
  intro derivativeDirection
  refine Fin.cases ?_ (fun axis => ?_) derivativeDirection
  · change
      completeMatterFirstGermPrincipalResponse
            (canonicalCompleteMatterFirstGermHessian residual)
            canonicalLorentzianTimeDirection +
          residual canonicalLorentzianTimeDirection =
        0
    rw [canonicalCompleteMatterFirstGermHessian_time_response]
    simp
  · rw [canonicalCompleteMatterFirstGermHessian_spatial_response]
    simp

/-! ## Uniqueness only inside the declared temporal-pivot class -/

theorem identityCoframeMatterPrincipal_time_injective :
    Function.Injective
      (identityCoframeMatterPrincipal canonicalLorentzianTimeDirection) := by
  intro first second principalEqual
  calc
    first =
        identityCoframeMatterPrincipal canonicalLorentzianTimeDirection
          (identityCoframeMatterPrincipal canonicalLorentzianTimeDirection
            first) :=
      (identityCoframeMatterPrincipal_time_involutive first).symm
    _ =
        identityCoframeMatterPrincipal canonicalLorentzianTimeDirection
          (identityCoframeMatterPrincipal canonicalLorentzianTimeDirection
            second) := by rw [principalEqual]
    _ = second := identityCoframeMatterPrincipal_time_involutive second

theorem completeMatterFirstGermPrincipalResponse_injective
    (first second : TemporalPivotMatterHessian)
    (responseEqual : ∀ direction,
      completeMatterFirstGermPrincipalResponse first direction =
        completeMatterFirstGermPrincipalResponse second direction) :
    first = second := by
  have spatialEqual : ∀ axis : Fin 3,
      first.timeSpatial axis = second.timeSpatial axis := by
    intro axis
    apply identityCoframeMatterPrincipal_time_injective
    simpa only [completeMatterFirstGermPrincipalResponse_spatial_normalForm]
      using responseEqual axis.succ
  apply TemporalPivotMatterHessian.ext
  · apply identityCoframeMatterPrincipal_time_injective
    have timeEqual := responseEqual canonicalLorentzianTimeDirection
    rw [completeMatterFirstGermPrincipalResponse_time_normalForm,
      completeMatterFirstGermPrincipalResponse_time_normalForm] at timeEqual
    simp_rw [spatialEqual] at timeEqual
    exact add_right_cancel timeEqual
  · funext axis
    exact spatialEqual axis

theorem completeMatterFirstGermResponseLaw_unique
    (residual : LorentzianIndex → DiracExteriorMatterCarrier)
    (candidate : TemporalPivotMatterHessian)
    (candidateLaw : CompleteMatterFirstGermResponseLaw residual candidate) :
    candidate = canonicalCompleteMatterFirstGermHessian residual := by
  apply completeMatterFirstGermPrincipalResponse_injective
  intro direction
  have candidateAt := candidateLaw direction
  have canonicalAt :=
    canonicalCompleteMatterFirstGermHessian_producerSound residual direction
  exact add_right_cancel (candidateAt.trans canonicalAt.symm)

theorem canonicalCompleteMatterFirstGermHessian_eq_zero_iff
    (residual : LorentzianIndex → DiracExteriorMatterCarrier) :
    canonicalCompleteMatterFirstGermHessian residual = 0 ↔
      residual = 0 := by
  constructor
  · intro hessianZero
    funext direction
    refine Fin.cases ?_ (fun axis => ?_) direction
    · have law :=
        canonicalCompleteMatterFirstGermHessian_producerSound residual
          canonicalLorentzianTimeDirection
      rw [hessianZero,
        completeMatterFirstGermPrincipalResponse_time_normalForm] at law
      simpa [canonicalLorentzianTimeDirection] using law
    · have law :=
        canonicalCompleteMatterFirstGermHessian_producerSound residual axis.succ
      rw [hessianZero,
        completeMatterFirstGermPrincipalResponse_spatial_normalForm] at law
      simpa using law
  · rintro rfl
    apply TemporalPivotMatterHessian.ext
    · simp [canonicalCompleteMatterFirstGermHessian]
    · funext axis
      simp [canonicalCompleteMatterFirstGermHessian]

end

end
  SaturationMonoid.PhysicsCore.StageNineMatterCompleteFirstGermPrincipal
