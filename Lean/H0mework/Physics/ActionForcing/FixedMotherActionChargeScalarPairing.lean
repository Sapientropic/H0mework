    scalarP286Action_positiveVacuum_finiteCoordinate data 1 0,
    scalarP286Action_positiveVacuum_finiteCoordinate data 1 1]
  simp_rw [p286LieBlockEmbed_diagonal_exteriorPosition_sum_eq_subset_sum]
  simp [motherActionChargeCandidate, motherActionChargeCandidateData,
    p286CoordinateLiePairing, p286LiePairing,
    motherActionChargeColor, motherActionChargeColorRaw,
    motherActionChargeWeak, motherActionChargeWeakRaw,
    exteriorPosition_sum_eq_subset_sum_complex,
    finiteGenerationOldChargeActionCoefficient,
    finiteGenerationScalarIndex, finiteGenerationScalarSubset,
    p286LieBlockEmbed, rawP286LieBlock, weakHyperchargeLieBlock,
    hyperchargeLieBlock, scalarLieBlock,
    specialUnitaryLiePairing, hyperchargeLiePairing,
    realScaleHypercharge, hyperchargeGenerator,
    Matrix.trace, Matrix.mul_apply, Fin.sum_univ_three, Fin.sum_univ_two,
    Matrix.fromBlocks_apply₁₁, Matrix.fromBlocks_apply₁₂,
    Matrix.fromBlocks_apply₂₁, Matrix.fromBlocks_apply₂₂,
    SU7ExteriorBreakingYukawa.colorZeroIndex,
    SU7ExteriorBreakingYukawa.colorOneIndex,
    SU7ExteriorBreakingYukawa.colorTwoIndex,
    SU7ExteriorBreakingYukawa.weakOneIndex,
