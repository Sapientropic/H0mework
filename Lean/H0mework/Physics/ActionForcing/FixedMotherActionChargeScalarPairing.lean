        motherActionChargeCandidate =
      -(1 / 12 : ℝ) *
        scalarCoordinatePairingRe
          (scalarP286ActionBilinear (p286CoordinateEquiv data) Vacuum)
          (scalarP286ActionBilinear
            positiveP506MatterCurrentP286NonzeroCurvatureGaussCharge
            Vacuum) := by
  have colorTraceZero := specialUnitaryLieMatrix_trace data.1
  have colorImaginaryTraceZero := congrArg Complex.im colorTraceZero
  simp [Matrix.trace, Fin.sum_univ_three] at colorImaginaryTraceZero
  have weakTraceZero := specialUnitaryLieMatrix_trace data.2.1
  have weakImaginaryTraceZero := congrArg Complex.im weakTraceZero
  simp [Matrix.trace, Fin.sum_univ_two] at weakImaginaryTraceZero
  rw [oldChargeAction_positiveVacuum_normalForm,
    scalarCoordinatePairingRe_eq_inner_re_local]
  simp only [Fin.sum_univ_two, inner_add_right, inner_smul_right]
  simp only [EuclideanSpace.inner_single_right]
  rw [scalarP286Action_positiveVacuum_finiteCoordinate data 0 0,
