        motherActionChargeColor, motherActionChargeColorRaw,
        p506MatterCurrentGaussData, p506MatterCurrentGaussColor,
        p506MatterCurrentGaussColorRaw, Matrix.mul_apply,
        Matrix.diagonal_apply, Fin.sum_univ_three] <;> ring
