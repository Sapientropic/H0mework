/-- The representation-level scalar pairing selected by the temporal
hypercharge test and the actual mother-action charge. -/
def motherActionChargeHyperchargeScalarPairing : ℝ :=
  scalarCoordinatePairingRe
    (scalarP286ActionBilinear Hypercharge Vacuum)
    (scalarP286ActionBilinear Charge Vacuum)

/-- The literal radial connection increment evaluated at the distinguished
zero-slice point. -/
theorem radialQuarticDeltaA_e0_actionNormalForm :
    p286RadialQuarticTemporalConnection Charge Point =
      (1 / 40 : ℝ) • p286TemporalGaugeOneForm Charge := by
  funext direction
  fin_cases direction <;>
    simp [p286RadialQuarticTemporalConnection,
      p286SpatialRadialQuarticCoefficient, p286SpatialRadiusSquared,
      p286SpatialMetricCovectorOperator, p286TemporalGaugeOneForm,
      Point, SpatialE0, canonicalCauchySlicePoint,
      canonicalLorentzianTimeDirection, p286BaseCoordinate_apply,
      Fin.sum_univ_three]

private theorem algebraic_scalar_e0_eq_vacuum :
    Algebraic.scalar Point = Vacuum := by
  change Temporal.scalar Point = Vacuum
  calc
    Temporal.scalar Point = Input.scalar Point := by
      exact
        sourceActionGeneratedDiracDualCompleteJointTemporalDevelopmentOperator_scalar_zeroSlice
          Source Input SpatialE0
    _ = Vacuum := by
      rw [fixedP506FormNativeJointActionSolvedSuccessor_scalar,
        fixedP506JointActionSuccessor_scalar, fixedP506JointActual_scalar_vacuum]

private theorem algebraic_coframe_e0 :
    Algebraic.coframe Point = 1 := by
  have zeroSlice :=
    fixedP506L0CompleteJointGlobalDevelopmentActual_coframe_zeroSlice SpatialE0
  change Input.coframe Point = 1 at zeroSlice
  exact zeroSlice

private theorem algebraic_temporalHypercharge_scalarVariation_e0 :
    holonomicScalarGaugeConnectionVariation Algebraic
        (fun _ => p286TemporalGaugeOneForm Hypercharge) Point =
      fun direction =>
        if direction = 0 then
          scalarP286ActionBilinear Hypercharge Vacuum
        else 0 := by
  funext direction
  unfold holonomicScalarGaugeConnectionVariation
    p286GaugeConnectionMotherVariation
  rw [algebraic_scalar_e0_eq_vacuum]
  change
    scalarP286ActionBilinear
        (p286TemporalGaugeOneForm Hypercharge direction) Vacuum = _
  fin_cases direction <;>
    simp [p286TemporalGaugeOneForm, canonicalLorentzianTimeDirection,
      scalarP286ActionBilinear]

private theorem algebraic_radialScalarShift_e0 :
    p286ScalarCovariantDerivativeShift Algebraic
        (p286RadialQuarticTemporalConnection Charge Point) Point =
      fun direction =>
        if direction = 0 then
          (1 / 40 : ℝ) • scalarP286ActionBilinear Charge Vacuum
        else 0 := by
  rw [radialQuarticDeltaA_e0_actionNormalForm,
    p286ScalarCovariantDerivativeShift_smul]
  funext direction
  unfold p286ScalarCovariantDerivativeShift
    holonomicScalarGaugeConnectionVariation
    p286GaugeConnectionMotherVariation
  rw [algebraic_scalar_e0_eq_vacuum]
  fin_cases direction <;>
    simp [p286TemporalGaugeOneForm, canonicalLorentzianTimeDirection,
      scalarP286ActionBilinear]

private theorem scalarCoordinatePairingRe_comm_local
    (first second : ScalarCoordinateCarrier) :
    scalarCoordinatePairingRe first second =
      scalarCoordinatePairingRe second first := by
  unfold scalarCoordinatePairingRe
  apply Finset.sum_congr rfl
  intro index _
  simp [Complex.mul_re, mul_comm]

private theorem scalarCoordinatePairingRe_zero_left_local
    (second : ScalarCoordinateCarrier) :
    scalarCoordinatePairingRe 0 second = 0 := by
  simp [scalarCoordinatePairingRe]

private theorem scalarCoordinatePairingRe_zero_right_local
    (first : ScalarCoordinateCarrier) :
    scalarCoordinatePairingRe first 0 = 0 := by
  simp [scalarCoordinatePairingRe]

/-- Exact action-provenance normal form of the changed scalar current.  The
only unsimplified scalar is the representation pairing of the two
action-owned charges. -/
theorem radialQuarticMotherCharge_temporalHypercharge_scalarShift_eq_pairing :
    p286ScalarCurrentShiftCoefficient Source Algebraic
        (p286RadialQuarticTemporalConnection Charge Point)
        (p286TemporalGaugeOneForm Hypercharge) Point =
      -(1 / 40 : ℝ) * motherActionChargeHyperchargeScalarPairing := by
  unfold p286ScalarCurrentShiftCoefficient generatedVolumeDensity
    motherActionChargeHyperchargeScalarPairing
  simp only [toContinuumPointField]
  rw [algebraic_coframe_e0, Matrix.det_one, abs_one, one_mul,
    algebraic_temporalHypercharge_scalarVariation_e0,
    algebraic_radialScalarShift_e0]
  unfold scalarFrameRelativeCovariantDerivative
  simp only [scalarFrameRelativeCoordinates_zeroChart]
  rw [StageNinePositiveSourceNativeGravityCurvatureBridge.lorentzianMetricOfCoframe_one_inv]
  simp only [Fin.sum_univ_four]
  have reversePairing :
      scalarCoordinatePairingRe
          (scalarP286ActionBilinear Charge Vacuum)
          (scalarP286ActionBilinear Hypercharge Vacuum) =
        motherActionChargeHyperchargeScalarPairing := by
    exact scalarCoordinatePairingRe_comm_local _ _
  simp [minkowskiInternalMetric, Matrix.diagonal_apply,
    scalarCoordinatePairingRe_zero_left_local,
    scalarCoordinatePairingRe_zero_right_local,
    scalarCoordinatePairingRe_real_smul_left,
    scalarCoordinatePairingRe_real_smul_right]
  rw [show
    scalarCoordinatePairingRe
        (scalarP286ActionBilinear Hypercharge Vacuum)
        (scalarP286ActionBilinear Charge Vacuum) =
      motherActionChargeHyperchargeScalarPairing by rfl]
  rw [reversePairing]
  ring

/-! ## Exact finite normal form of the action-owned charge -/

private def motherActionChargeColorRaw : Matrix (Fin 3) (Fin 3) ℂ :=
  Matrix.diagonal fun index =>
    if index = 0 then (5 / 108 : ℂ) * Complex.I
    else if index = 1 then (5 / 108 : ℂ) * Complex.I
    else -(5 / 54 : ℂ) * Complex.I

private def motherActionChargeColor : SU3BlockLieMatrix := by
  refine ⟨motherActionChargeColorRaw, ?_, ?_⟩
  · ext row column
    fin_cases row <;> fin_cases column <;>
      simp [motherActionChargeColorRaw]
  · simp [motherActionChargeColorRaw, Matrix.trace, Fin.sum_univ_three]
    ring

private def motherActionChargeWeakRaw : Matrix (Fin 2) (Fin 2) ℂ :=
  Matrix.diagonal fun index =>
    if index = 0 then -(1 / 18 : ℂ) * Complex.I
    else (1 / 18 : ℂ) * Complex.I

private def motherActionChargeWeak : SU2BlockLieMatrix := by
  refine ⟨motherActionChargeWeakRaw, ?_, ?_⟩
  · ext row column
    fin_cases row <;> fin_cases column <;>
      simp [motherActionChargeWeakRaw]
  · simp [motherActionChargeWeakRaw, Matrix.trace, Fin.sum_univ_two]

private def motherActionChargeCandidateData : P286LieBlockData :=
  (motherActionChargeColor, motherActionChargeWeak,
    realScaleHypercharge (7 / 36) hyperchargeGenerator)

private def motherActionChargeCandidate : P286CoordinateCarrier :=
  p286CoordinateEquiv motherActionChargeCandidateData

