private theorem scalarP286Action_positiveVacuum_finiteCoordinate
    (data : P286LieBlockData) (output input : Fin 2) :
    scalarP286ActionBilinear (p286CoordinateEquiv data) Vacuum
        (finiteGenerationScalarIndex output input) =
      ∑ position : Fin 4,
        (p286LieBlockEmbed data :
          Matrix SU7MotherIndex SU7MotherIndex ℂ)
          (exteriorPositionEquiv
            (finiteGenerationScalarIndex output input) position).1
          (exteriorPositionEquiv
            (finiteGenerationScalarIndex output input) position).1 := by
  rw [positiveVacuumCoordinates_normalForm]
  simp only [map_sum, WithLp.ofLp_sum, Finset.sum_apply]
  have term (sourceOutput sourceInput : Fin 2) :
      scalarP286ActionBilinear (p286CoordinateEquiv data)
          (EuclideanSpace.single
            (finiteGenerationScalarIndex sourceOutput sourceInput) 1)
          (finiteGenerationScalarIndex output input) =
        if (sourceOutput, sourceInput) = (output, input) then
          ∑ position : Fin 4,
            (p286LieBlockEmbed data :
              Matrix SU7MotherIndex SU7MotherIndex ℂ)
              (exteriorPositionEquiv
                (finiteGenerationScalarIndex output input) position).1
              (exteriorPositionEquiv
                (finiteGenerationScalarIndex output input) position).1
        else 0 := by
    by_cases equality : (sourceOutput, sourceInput) = (output, input)
    · rcases Prod.ext_iff.mp equality with ⟨outputEq, inputEq⟩
      change sourceOutput = output at outputEq
      change sourceInput = input at inputEq
      subst sourceOutput
      subst sourceInput
      simp only [Prod.mk.injEq, true_and, ↓reduceIte]
      exact scalarP286Action_finiteGeneration_self data output input
    · rw [if_neg equality]
      exact scalarP286Action_finiteGeneration_cross_zero
        data sourceOutput sourceInput output input equality
  simp_rw [term]
  fin_cases output <;> fin_cases input <;> simp

private theorem motherActionChargeCandidate_response
    (data : P286LieBlockData) :
