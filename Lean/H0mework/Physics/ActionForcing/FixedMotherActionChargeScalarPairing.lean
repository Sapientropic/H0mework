/-- The action-owned mother charge acts diagonally on the occupied
degree-two hypercharge state.  This is a readout of the private finite
normal form, not a caller-supplied charge or eigenvalue. -/
theorem
    fixedP506L0U6OccurrenceP286MotherActionCharge_hyperchargeProbe_action_normalForm :
    exteriorMotherLieAction 2
        (p286LieBlockEmbed
          (p286CoordinateEquiv.symm
            fixedP506L0U6OccurrenceP286MotherActionCharge))
        (su7ExteriorBasis 2 hyperchargeDegreeTwoIndex) =
      ((13 / 54 : ℂ) * Complex.I) •
        su7ExteriorBasis 2 hyperchargeDegreeTwoIndex := by
  change
    exteriorMotherLieAction 2
        (p286LieBlockEmbed (p286CoordinateEquiv.symm Charge))
        (su7ExteriorBasis 2 hyperchargeDegreeTwoIndex) = _
  rw [motherActionCharge_eq_candidate]
  unfold motherActionChargeCandidate
  rw [p286CoordinateEquiv.symm_apply_apply,
    exteriorMotherLieAction_basis_current]
  unfold exteriorBasisLieAction
  calc
    _ = ∑ position : Fin 2,
        motherActionChargeFundamentalCoefficient
            (exteriorPositionEquiv hyperchargeDegreeTwoIndex position).1 •
          su7ExteriorBasis 2 hyperchargeDegreeTwoIndex := by
      apply Finset.sum_congr rfl
      intro position _
      change
        (exteriorPower.ιMulti ℂ 2)
            (exteriorBasisLieActionInput 2
              (p286LieBlockEmbed motherActionChargeCandidateData)
              hyperchargeDegreeTwoIndex position) = _
      rw [exteriorBasisLieActionTerm_eq_update,
        show exteriorBasisInput 2 hyperchargeDegreeTwoIndex position =
            su7FundamentalBasis
              (exteriorPositionEquiv hyperchargeDegreeTwoIndex position).1 by
          rfl,
        motherActionChargeFundamentalAction_basis,
        (exteriorPower.ιMulti ℂ 2).map_update_smul,
        show su7FundamentalBasis
              (exteriorPositionEquiv hyperchargeDegreeTwoIndex position).1 =
            exteriorBasisInput 2 hyperchargeDegreeTwoIndex position by rfl,
        Function.update_eq_self]
      exact congrArg
        (fun value =>
          motherActionChargeFundamentalCoefficient
              (exteriorPositionEquiv hyperchargeDegreeTwoIndex position).1 •
            value)
        (exteriorBasisInput_wedge_eq_basis_current 2
          hyperchargeDegreeTwoIndex)
    _ = _ := by
      rw [← Finset.sum_smul]
      congr 1
      change
        (∑ position : Fin 2,
          motherActionChargeFundamentalCoefficient
            (Set.powersetCard.ofFinEmbEquiv.symm
              hyperchargeDegreeTwoIndex position)) = _
      rw [exteriorPosition_sum_eq_subset_sum_complex]
      simp [motherActionChargeFundamentalCoefficient,
        motherActionChargeCandidateData, motherActionChargeColor,
        motherActionChargeColorRaw, motherActionChargeWeak,
        motherActionChargeWeakRaw, realScaleHypercharge,
        hyperchargeGenerator, p286LieBlockEmbed, rawP286LieBlock,
        weakHyperchargeLieBlock, hyperchargeLieBlock, scalarLieBlock,
        hyperchargeDegreeTwoIndex, hyperchargeDegreeTwoSubset,
        hyperPlusIndex, Matrix.diagonal_apply]
      ring

