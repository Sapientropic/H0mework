private theorem scalarP286Action_finiteGeneration_self
    (data : P286LieBlockData) (output input : Fin 2) :
    scalarP286ActionBilinear (p286CoordinateEquiv data)
        (EuclideanSpace.single
          (finiteGenerationScalarIndex output input) 1)
        (finiteGenerationScalarIndex output input) =
      ∑ position : Fin 4,
        (p286LieBlockEmbed data :
          Matrix SU7MotherIndex SU7MotherIndex ℂ)
          (exteriorPositionEquiv
            (finiteGenerationScalarIndex output input) position).1
          (exteriorPositionEquiv
            (finiteGenerationScalarIndex output input) position).1 := by
  change
    scalarMotherLieAction
        (p286LieBlockEmbed
          (p286CoordinateEquiv.symm (p286CoordinateEquiv data)))
        (EuclideanSpace.single
          (finiteGenerationScalarIndex output input) 1)
        (finiteGenerationScalarIndex output input) = _
  rw [p286CoordinateEquiv.symm_apply_apply,
    scalarMotherLieAction_single_apply,
    exteriorBasisLieAction_self_coordinate]

private theorem exteriorBasisLieAction_coordinate_zero_of_sourceWitness
    (matrix : SU7MotherLieMatrix) (output input : ScalarBasisIndex)
    (extra : SU7MotherIndex) (extraMem : extra ∈ input.1)
    (extraNotOutput : extra ∉ output.1)
    (extraColumnZero :
      ∀ target, target ∈ output.1 →
        (matrix : Matrix SU7MotherIndex SU7MotherIndex ℂ)
          target extra = 0) :
    (su7ExteriorBasis 4).repr
        (exteriorBasisLieAction 4 matrix input) output = 0 := by
  rw [exteriorBasisLieAction_coordinate_eq_sum_det_updateRow]
  apply Finset.sum_eq_zero
  intro actionPosition _
  let extraPosition : Fin 4 :=
    (exteriorPositionEquiv input).symm ⟨extra, extraMem⟩
  have extraPositionValue :
      (exteriorPositionEquiv input extraPosition).1 = extra := by
    exact congrArg Subtype.val
      ((exteriorPositionEquiv input).apply_symm_apply ⟨extra, extraMem⟩)
  apply Matrix.det_eq_zero_of_row_eq_zero extraPosition
  intro column
  by_cases changed : extraPosition = actionPosition
  · subst actionPosition
    simp only [Matrix.updateRow_self]
    unfold exteriorBasisActionCoordinateRow
    rw [show exteriorBasisInput 4 input extraPosition =
        su7FundamentalBasis
          (exteriorPositionEquiv input extraPosition).1 by rfl,
      fundamentalMotherLieAction_basis_coordinate, extraPositionValue]
    exact extraColumnZero _ (exteriorPositionEquiv output column).property
  · rw [Matrix.updateRow_ne changed]
    have outputValueNe :
        (exteriorPositionEquiv output column).1 ≠ extra := by
      intro equality
      exact extraNotOutput
        (equality ▸ (exteriorPositionEquiv output column).property)
    simp [exteriorBasisCoordinateMatrix, exteriorBasisInput,
      extraPositionValue, outputValueNe]

private theorem exteriorBasisLieAction_coordinate_zero_of_targetWitness
    (matrix : SU7MotherLieMatrix) (output input : ScalarBasisIndex)
    (missing : SU7MotherIndex) (missingMem : missing ∈ output.1)
    (missingNotInput : missing ∉ input.1)
    (missingRowZero :
      ∀ source, source ∈ input.1 →
        (matrix : Matrix SU7MotherIndex SU7MotherIndex ℂ)
          missing source = 0) :
    (su7ExteriorBasis 4).repr
        (exteriorBasisLieAction 4 matrix input) output = 0 := by
  rw [exteriorBasisLieAction_coordinate_eq_sum_det_updateRow]
  apply Finset.sum_eq_zero
  intro actionPosition _
  let missingPosition : Fin 4 :=
    (exteriorPositionEquiv output).symm ⟨missing, missingMem⟩
  have missingPositionValue :
      (exteriorPositionEquiv output missingPosition).1 = missing := by
    exact congrArg Subtype.val
      ((exteriorPositionEquiv output).apply_symm_apply
        ⟨missing, missingMem⟩)
  apply Matrix.det_eq_zero_of_column_eq_zero missingPosition
  intro row
  by_cases changed : row = actionPosition
  · subst row
    simp only [Matrix.updateRow_self]
    unfold exteriorBasisActionCoordinateRow
    rw [show exteriorBasisInput 4 input actionPosition =
        su7FundamentalBasis
          (exteriorPositionEquiv input actionPosition).1 by rfl,
      fundamentalMotherLieAction_basis_coordinate, missingPositionValue]
    exact missingRowZero _ (exteriorPositionEquiv input actionPosition).property
  · rw [Matrix.updateRow_ne changed]
    have inputValueNe :
        (exteriorPositionEquiv input row).1 ≠ missing := by
      intro equality
      exact missingNotInput
        (equality ▸ (exteriorPositionEquiv input row).property)
    simp [exteriorBasisCoordinateMatrix, exteriorBasisInput,
      missingPositionValue, inputValueNe]

