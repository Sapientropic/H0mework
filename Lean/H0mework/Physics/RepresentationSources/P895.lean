import H0mework.Physics.BranchSources.P894

/-!
# Proposition 895: representation support spectra generate physical families

P894 identifies a finite physical branch-family gap with permanent holonomy.
The next throat is the family itself: P894 still starts from a
`SU7PhysicalBranchingSpectrumFamily`, while the proof spine wants the family
and its positive representation support to be generated from SU(7)
representation spectrum data.

This file introduces a lower support-spectrum object.  A representation support
slot stores physical SU(7) atom / color-loop data, but no prime edge and no
Goldbach pair.  A finite list of support slots generates:

* the physical branch-spectrum family;
* its positive representation-weight readout;
* the holonomy-form confinement rule used by P894.

Permanent holonomy is first stated at the slot level.  Lean proves that
slot-level no-permanent-holonomy implies the generated family forbids permanent
holonomy.  Thus the family/weight layer is no longer free data: it is the image
of the representation support spectrum.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open SaturationMonoid.AffineRelaxation

set_option linter.defProp false

/-! ## Representation support slots below physical branch families -/

/-- A positive-support SU(7) representation branch slot over one even fiber.

This stores only physical representation / color-loop data.  It contains no
`PrimeExponent`, no `Nat.Prime` field, and no Goldbach pair. -/
structure SU7PhysicalRepresentationSupportSlot (n : ℕ) where
  branch : SU3FlagSchubertCell
  leftAtom : SU7Atom
  rightAtom : SU7Atom
  colorLoop : SU7ColorLoop
  allowed : GaugeAllowed colorLoop
  loop_fiber : colorLoop.fiber = n
  loop_left : colorLoop.leftAtom = leftAtom
  loop_right : colorLoop.rightAtom = rightAtom

/-- The physical branch-spectrum cell generated by a representation support
slot. -/
def physicalBranchingSpectrumCell_of_representationSupportSlot
    {n : ℕ} (s : SU7PhysicalRepresentationSupportSlot n) :
    SU7PhysicalBranchingSpectrumCell n where
  branch := s.branch
  leftAtom := s.leftAtom
  rightAtom := s.rightAtom
  colorLoop := s.colorLoop
  allowed := s.allowed
  loop_fiber := s.loop_fiber
  loop_left := s.loop_left
  loop_right := s.loop_right

/-- A finite positive-support representation spectrum over one even fiber. -/
structure SU7PhysicalRepresentationSupportSpectrum (n : ℕ) where
  slots : List (SU7PhysicalRepresentationSupportSlot n)

/-- The physical branch-spectrum family generated by the support spectrum.

Representation weight is the support readout: every generated support cell has
positive weight.  There is no independently supplied weight function here. -/
def physicalBranchingSpectrumFamily_of_representationSupportSpectrum
    {n : ℕ} (S : SU7PhysicalRepresentationSupportSpectrum n) :
    SU7PhysicalBranchingSpectrumFamily n where
  spectrumCells :=
    S.slots.map physicalBranchingSpectrumCell_of_representationSupportSlot
  representationWeight := fun _ => 1

/-- THEOREM 1: every support slot maps to a cell in the generated family. -/
theorem representationSupportSlot_mem_generatedFamily
    {n : ℕ} (S : SU7PhysicalRepresentationSupportSpectrum n)
    {s : SU7PhysicalRepresentationSupportSlot n}
    (hs : s ∈ S.slots) :
    physicalBranchingSpectrumCell_of_representationSupportSlot s ∈
      (physicalBranchingSpectrumFamily_of_representationSupportSpectrum
        S).spectrumCells := by
  exact List.mem_map.mpr
    ⟨s, hs, rfl⟩

/-- THEOREM 2: every generated support cell has positive representation
weight. -/
theorem generatedFamily_representationWeight_positive
    {n : ℕ} (S : SU7PhysicalRepresentationSupportSpectrum n)
    (C : SU7PhysicalBranchingSpectrumCell n) :
    0 <
      (physicalBranchingSpectrumFamily_of_representationSupportSpectrum
        S).representationWeight C := by
  simp [physicalBranchingSpectrumFamily_of_representationSupportSpectrum]

/-! ## Slot-level permanent holonomy -/

/-- Permanent holonomy at the representation support-slot level. -/
def SU7RepresentationSupportPermanentHolonomySlot
    {n : ℕ} (S : SU7PhysicalRepresentationSupportSpectrum n)
    (s : SU7PhysicalRepresentationSupportSlot n) : Prop :=
  s ∈ S.slots ∧
    physicalBranchingSpectrumResidual
      (physicalBranchingSpectrumCell_of_representationSupportSlot s) ≠ 0 ∧
      ∀ next : SU7PhysicalRepresentationSupportSlot n,
        next ∈ S.slots ->
          ¬ physicalBranchingSpectrumResidualEnergy
              (physicalBranchingSpectrumCell_of_representationSupportSlot next) <
            physicalBranchingSpectrumResidualEnergy
              (physicalBranchingSpectrumCell_of_representationSupportSlot s)

/-- The representation support spectrum forbids permanent slot holonomy. -/
def SU7RepresentationSupportSpectrumForbidsPermanentHolonomy
    {n : ℕ} (S : SU7PhysicalRepresentationSupportSpectrum n) : Prop :=
  ∀ s : SU7PhysicalRepresentationSupportSlot n,
    ¬ SU7RepresentationSupportPermanentHolonomySlot S s

/-- THEOREM 3: slot-level no-permanent-holonomy implies the generated physical
branch family forbids permanent holonomy. -/
theorem generatedFamily_forbidsPermanentHolonomy_of_representationSupport
    {n : ℕ} (S : SU7PhysicalRepresentationSupportSpectrum n)
    (H : SU7RepresentationSupportSpectrumForbidsPermanentHolonomy S) :
    SU7PhysicalBranchingSpectrumFamilyForbidsPermanentHolonomy
      (physicalBranchingSpectrumFamily_of_representationSupportSpectrum S) := by
  intro C hperm
  rcases hperm with ⟨hmem, _hwt, hnonzero, hterminal⟩
  rcases List.mem_map.mp hmem with ⟨s, hs_mem, hs_eq⟩
  have hslot_terminal :
      ∀ next : SU7PhysicalRepresentationSupportSlot n,
        next ∈ S.slots ->
          ¬ physicalBranchingSpectrumResidualEnergy
              (physicalBranchingSpectrumCell_of_representationSupportSlot next) <
            physicalBranchingSpectrumResidualEnergy
              (physicalBranchingSpectrumCell_of_representationSupportSlot s) := by
    intro next hnext_mem hlt
    have hnext_family :
        physicalBranchingSpectrumCell_of_representationSupportSlot next ∈
          (physicalBranchingSpectrumFamily_of_representationSupportSpectrum
            S).spectrumCells :=
      representationSupportSlot_mem_generatedFamily S hnext_mem
    have hnext_wt :
        0 <
          (physicalBranchingSpectrumFamily_of_representationSupportSpectrum
            S).representationWeight
            (physicalBranchingSpectrumCell_of_representationSupportSlot
              next) :=
      generatedFamily_representationWeight_positive S _
    have hlt_to_C :
        physicalBranchingSpectrumResidualEnergy
            (physicalBranchingSpectrumCell_of_representationSupportSlot next) <
          physicalBranchingSpectrumResidualEnergy C := by
      simpa [hs_eq] using hlt
    exact hterminal
      (physicalBranchingSpectrumCell_of_representationSupportSlot next)
      hnext_family hnext_wt hlt_to_C
  have hslot_nonzero :
      physicalBranchingSpectrumResidual
        (physicalBranchingSpectrumCell_of_representationSupportSlot s) ≠
          0 := by
    simpa [hs_eq] using hnonzero
  exact H s ⟨hs_mem, hslot_nonzero, hslot_terminal⟩

/-! ## Generated holonomy-form confinement rules -/

/-- A representation support spectrum together with a start support slot and
slot-level confinement. -/
structure SU7RepresentationSupportHolonomyConfinementRule (n : ℕ) where
  spectrum : SU7PhysicalRepresentationSupportSpectrum n
  startSlot : SU7PhysicalRepresentationSupportSlot n
  start_mem : startSlot ∈ spectrum.slots
  forbids_permanent_slot_holonomy :
    SU7RepresentationSupportSpectrumForbidsPermanentHolonomy spectrum

/-- THEOREM 4: a representation support-spectrum rule generates P894's
physical holonomy confinement rule. -/
def physicalHolonomyRule_of_representationSupportRule
    {n : ℕ} (R : SU7RepresentationSupportHolonomyConfinementRule n) :
    SU7PhysicalBranchingSpectrumHolonomyConfinementRule n where
  family :=
    physicalBranchingSpectrumFamily_of_representationSupportSpectrum
      R.spectrum
  startCell :=
    physicalBranchingSpectrumCell_of_representationSupportSlot R.startSlot
  start_mem :=
    representationSupportSlot_mem_generatedFamily R.spectrum R.start_mem
  start_weight_positive :=
    generatedFamily_representationWeight_positive R.spectrum _
  forbids_permanent_holonomy :=
    generatedFamily_forbidsPermanentHolonomy_of_representationSupport
      R.spectrum R.forbids_permanent_slot_holonomy

/-- THEOREM 5: a representation support-spectrum rule generates a P884
transition system via P894/P893. -/
def physicalTransitionSystem_of_representationSupportRule
    {n : ℕ} (R : SU7RepresentationSupportHolonomyConfinementRule n) :
    SU7PhysicalBranchingSpectrumTransitionSystem n :=
  physicalTransitionSystem_of_holonomyConfinementRule
    (physicalHolonomyRule_of_representationSupportRule R)

/-- THEOREM 6: a representation support-spectrum rule generates a zero
physical residual cell. -/
theorem exists_zeroCell_of_representationSupportRule
    {n : ℕ} (R : SU7RepresentationSupportHolonomyConfinementRule n) :
    ∃ Z : SU7PhysicalBranchingSpectrumCell n,
      Z ∈
          (physicalBranchingSpectrumFamily_of_representationSupportSpectrum
            R.spectrum).spectrumCells ∧
        0 <
          (physicalBranchingSpectrumFamily_of_representationSupportSpectrum
            R.spectrum).representationWeight Z ∧
          physicalBranchingSpectrumResidual Z = 0 :=
  exists_zeroCell_of_holonomyConfinementRule
    (physicalHolonomyRule_of_representationSupportRule R)

/-- THEOREM 7: a representation support-spectrum rule computes a trace-zero
prime-edge loop. -/
def traceZeroPrimeEdgeLoop_of_representationSupportRule
    {n : ℕ} (R : SU7RepresentationSupportHolonomyConfinementRule n) :
    TraceZeroPrimeEdgeLoop n :=
  traceZeroPrimeEdgeLoop_of_holonomyConfinementRule
    (physicalHolonomyRule_of_representationSupportRule R)

/-! ## Fiberwise representation support confinement -/

/-- Every even fiber carries a representation support-spectrum confinement
rule. -/
def SU7RepresentationSupportHolonomyConfinementRuleEveryEvenFiber : Prop :=
  ∀ n : ℕ, 2 ≤ n ->
    Nonempty (SU7RepresentationSupportHolonomyConfinementRule n)

/-- THEOREM 8: fiberwise representation support rules generate P894
holonomy-form rules on every even fiber. -/
theorem holonomyRulesEveryEvenFiber_of_representationSupportRules
    (H : SU7RepresentationSupportHolonomyConfinementRuleEveryEvenFiber) :
    SU7PhysicalBranchingSpectrumHolonomyConfinementRuleEveryEvenFiber := by
  intro n hn
  let R : SU7RepresentationSupportHolonomyConfinementRule n :=
    Classical.choice (H n hn)
  exact ⟨physicalHolonomyRule_of_representationSupportRule R⟩

/-- Physical representation support confinement data: physical law names plus
representation support-spectrum holonomy rules on every even fiber. -/
structure SU7PhysicalRepresentationSupportConfinement where
  compact_gauge_orbit : SU7CompactGaugeOrbit
  lyapunov_residual_dissipation : SU7LyapunovResidualDissipation
  quantized_spectrum_no_escaping_boundary :
    SU7QuantizedSpectrumNoEscapingBoundary
  representation_support_rules :
    SU7RepresentationSupportHolonomyConfinementRuleEveryEvenFiber

/-- THEOREM 9: representation support confinement generates P894 physical
holonomy branch-rule confinement. -/
def holonomyBranchRuleConfinement_of_representationSupportConfinement
    (D : SU7PhysicalRepresentationSupportConfinement) :
    SU7PhysicalHolonomyBranchRuleConfinement where
  compact_gauge_orbit := D.compact_gauge_orbit
  lyapunov_residual_dissipation := D.lyapunov_residual_dissipation
  quantized_spectrum_no_escaping_boundary :=
    D.quantized_spectrum_no_escaping_boundary
  holonomy_rules :=
    holonomyRulesEveryEvenFiber_of_representationSupportRules
      D.representation_support_rules

/-- THEOREM 10: representation support confinement computes trace-zero
prime-edge loops on every even fiber. -/
def traceZeroPrimeEdgeLoopEveryEvenFiber_of_representationSupportConfinement
    (D : SU7PhysicalRepresentationSupportConfinement) :
    ∀ n : ℕ, 2 ≤ n -> TraceZeroPrimeEdgeLoop n :=
  traceZeroPrimeEdgeLoopEveryEvenFiber_of_holonomyBranchRuleConfinement
    (holonomyBranchRuleConfinement_of_representationSupportConfinement D)

/-- THEOREM 11: representation support confinement gives ordinary even
Goldbach through the P895 -> P894 -> P893 -> P884 -> P892 route. -/
theorem evenGoldbach_of_physicalRepresentationSupportConfinement
    (D : SU7PhysicalRepresentationSupportConfinement) :
    EvenGoldbachStatement :=
  evenGoldbach_of_physicalHolonomyBranchRuleConfinement
    (holonomyBranchRuleConfinement_of_representationSupportConfinement D)

/-! ## Certificate -/

/-- P895 certificate: physical branch families and their positive
representation support are generated from representation support spectra. -/
structure SU7RepresentationSupportSpectrumProducerCertificate where
  slot_to_cell :
    ∀ {n : ℕ}, SU7PhysicalRepresentationSupportSlot n ->
      SU7PhysicalBranchingSpectrumCell n
  spectrum_to_family :
    ∀ {n : ℕ}, SU7PhysicalRepresentationSupportSpectrum n ->
      SU7PhysicalBranchingSpectrumFamily n
  slot_mem_generated :
    ∀ {n : ℕ} (S : SU7PhysicalRepresentationSupportSpectrum n)
      {s : SU7PhysicalRepresentationSupportSlot n},
      s ∈ S.slots ->
        physicalBranchingSpectrumCell_of_representationSupportSlot s ∈
          (physicalBranchingSpectrumFamily_of_representationSupportSpectrum
            S).spectrumCells
  slot_no_holonomy_to_family_no_holonomy :
    ∀ {n : ℕ} (S : SU7PhysicalRepresentationSupportSpectrum n),
      SU7RepresentationSupportSpectrumForbidsPermanentHolonomy S ->
        SU7PhysicalBranchingSpectrumFamilyForbidsPermanentHolonomy
          (physicalBranchingSpectrumFamily_of_representationSupportSpectrum S)
  support_rule_to_holonomy_rule :
    ∀ {n : ℕ},
      SU7RepresentationSupportHolonomyConfinementRule n ->
        SU7PhysicalBranchingSpectrumHolonomyConfinementRule n
  support_rule_to_transition :
    ∀ {n : ℕ},
      SU7RepresentationSupportHolonomyConfinementRule n ->
        SU7PhysicalBranchingSpectrumTransitionSystem n
  support_rule_to_trace_zero :
    ∀ {n : ℕ},
      SU7RepresentationSupportHolonomyConfinementRule n ->
        TraceZeroPrimeEdgeLoop n
  support_confinement_to_goldbach :
    SU7PhysicalRepresentationSupportConfinement ->
      EvenGoldbachStatement

def su7RepresentationSupportSpectrumProducerCertificate :
    SU7RepresentationSupportSpectrumProducerCertificate where
  slot_to_cell :=
    physicalBranchingSpectrumCell_of_representationSupportSlot
  spectrum_to_family :=
    physicalBranchingSpectrumFamily_of_representationSupportSpectrum
  slot_mem_generated :=
    representationSupportSlot_mem_generatedFamily
  slot_no_holonomy_to_family_no_holonomy :=
    generatedFamily_forbidsPermanentHolonomy_of_representationSupport
  support_rule_to_holonomy_rule :=
    physicalHolonomyRule_of_representationSupportRule
  support_rule_to_transition :=
    physicalTransitionSystem_of_representationSupportRule
  support_rule_to_trace_zero :=
    traceZeroPrimeEdgeLoop_of_representationSupportRule
  support_confinement_to_goldbach :=
    evenGoldbach_of_physicalRepresentationSupportConfinement


end
end StandardModelConstraint
end SaturationMonoid
