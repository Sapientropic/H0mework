/-
  Proposition 513: block-product producer for concrete matter multiplicities.

  P512 bundles the current information/matter carrier receipt.  This file
  lowers one remaining finite bookkeeping boundary: the component multiplicity
  of each generated matter/Higgs slot is not merely a copied table.  It is the
  product of the dimensions of the two endpoint blocks that generate the slot,
  hence it agrees with the concrete endpoint fiber multiplicity from P506.

  Boundary: this is still a finite `3+2+1+1` block-product theorem.  It does
  not derive the physical endpoint-signature table, Higgs breaking,
  anomaly-cancellation dynamics, mass values, or low-energy RG thresholds from
  first principles.
-/

import H0mework.Physics.RepresentationSources.P512

namespace SaturationMonoid
namespace StandardModelConstraint
namespace InformationMatterProjection

open RunningSigmaBeta

/-! ## Matter multiplicities from endpoint block products -/

/-- The block-product multiplicity of a generated matter/Higgs slot. -/
def matterSlotEndpointBlockProduct (s : MatterSlot) : ℕ :=
  carrierBlockCard (generatedSlotEndpointSignature s).1 *
    carrierBlockCard (generatedSlotEndpointSignature s).2

/-- THEOREM 1: every generated matter/Higgs component multiplicity is exactly
the product of the dimensions of its two endpoint blocks. -/
theorem matterSlotComponentMultiplicity_eq_endpointBlockProduct
    (s : MatterSlot) :
    matterSlotComponentMultiplicity s =
      matterSlotEndpointBlockProduct s := by
  cases s <;> rfl

/-- THEOREM 2: for every canonical incidence, the generated slot's component
multiplicity is the concrete endpoint fiber multiplicity. -/
theorem generatedSlot_componentMultiplicity_eq_incidence_endpointMultiplicity
    (i : InformationSlot) :
    matterSlotComponentMultiplicity (generatedSlotOfIncidence i) =
      concreteEndpointMultiplicity (incidenceEndpoint i) := by
  cases i <;> decide

/-- THEOREM 3: equivalently, concrete endpoint fibers reproduce the generated
matter/Higgs component multiplicities. -/
theorem incidence_endpointMultiplicity_eq_generatedSlot_componentMultiplicity
    (i : InformationSlot) :
    concreteEndpointMultiplicity (incidenceEndpoint i) =
      matterSlotComponentMultiplicity (generatedSlotOfIncidence i) := by
  exact (generatedSlot_componentMultiplicity_eq_incidence_endpointMultiplicity i).symm

/-- THEOREM 4: the block-product statement can be read directly on
incidences. -/
theorem generatedSlot_componentMultiplicity_eq_blockCard_product
    (i : InformationSlot) :
    matterSlotComponentMultiplicity (generatedSlotOfIncidence i) =
      carrierBlockCard (SU7BlockIncidence.endpoints i).1 *
        carrierBlockCard (SU7BlockIncidence.endpoints i).2 := by
  cases i <;> rfl

/-- THEOREM 5: the six incidence-ordered block products are
`6,3,3,2,2,1`, matching the matter/Higgs component table. -/
theorem incidence_blockProduct_table :
    matterSlotComponentMultiplicity
        (generatedSlotOfIncidence .colorWeak) = 6 ∧
    matterSlotComponentMultiplicity
        (generatedSlotOfIncidence .colorPositiveSinglet) = 3 ∧
    matterSlotComponentMultiplicity
        (generatedSlotOfIncidence .colorNegativeSinglet) = 3 ∧
    matterSlotComponentMultiplicity
        (generatedSlotOfIncidence .weakPositiveSinglet) = 2 ∧
    matterSlotComponentMultiplicity
        (generatedSlotOfIncidence .weakNegativeSinglet) = 2 ∧
    matterSlotComponentMultiplicity
        (generatedSlotOfIncidence .positiveNegativeSinglet) = 1 := by
  decide

/-- Bundled receipt: in the current carrier, matter/Higgs component counts are
generated by endpoint block products and agree with concrete endpoint fibers.
-/
structure ConcreteMatterBlockProductProducerCertificate : Prop where
  current_carrier :
    ConcreteInformationMatterCarrierCertificate
  slot_block_product :
    ∀ s : MatterSlot,
      matterSlotComponentMultiplicity s =
        matterSlotEndpointBlockProduct s
  incidence_endpoint_fiber :
    ∀ i : InformationSlot,
      matterSlotComponentMultiplicity (generatedSlotOfIncidence i) =
        concreteEndpointMultiplicity (incidenceEndpoint i)
  incidence_block_product :
    ∀ i : InformationSlot,
      matterSlotComponentMultiplicity (generatedSlotOfIncidence i) =
        carrierBlockCard (SU7BlockIncidence.endpoints i).1 *
          carrierBlockCard (SU7BlockIncidence.endpoints i).2
  block_product_table :
    matterSlotComponentMultiplicity
        (generatedSlotOfIncidence .colorWeak) = 6 ∧
    matterSlotComponentMultiplicity
        (generatedSlotOfIncidence .colorPositiveSinglet) = 3 ∧
    matterSlotComponentMultiplicity
        (generatedSlotOfIncidence .colorNegativeSinglet) = 3 ∧
    matterSlotComponentMultiplicity
        (generatedSlotOfIncidence .weakPositiveSinglet) = 2 ∧
    matterSlotComponentMultiplicity
        (generatedSlotOfIncidence .weakNegativeSinglet) = 2 ∧
    matterSlotComponentMultiplicity
        (generatedSlotOfIncidence .positiveNegativeSinglet) = 1
  endpoint_support :
    ConcreteBlockSupportEndpointCertificate
  representation_typing :
    ConcreteMatterRepresentationTypingCertificate

/-- THEOREM 6: the current concrete carrier supplies the finite block-product
producer for matter/Higgs component multiplicities. -/
theorem concreteMatterBlockProductProducerCertificate :
    ConcreteMatterBlockProductProducerCertificate where
  current_carrier := concreteInformationMatterCarrierCertificate
  slot_block_product := matterSlotComponentMultiplicity_eq_endpointBlockProduct
  incidence_endpoint_fiber :=
    generatedSlot_componentMultiplicity_eq_incidence_endpointMultiplicity
  incidence_block_product :=
    generatedSlot_componentMultiplicity_eq_blockCard_product
  block_product_table := incidence_blockProduct_table
  endpoint_support := concreteBlockSupportEndpointCertificate
  representation_typing := concreteMatterRepresentationTypingCertificate

end InformationMatterProjection
end StandardModelConstraint
end SaturationMonoid
