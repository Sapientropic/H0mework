import H0mework.Physics.AlphaSources.P607
import H0mework.Physics.SourceForms.P634

/-!
# Proposition 635: identity of the current alpha_s producer faces

P601/P602/P626/P627 and P633/P634 reached the same `alpha_s` residual from
different finite producer faces:

* embedded complement plus a supplied 4D Poincare-resolution carrier;
* the QCD/Poincare denominator `b0_QCD + slots_4D`;
* the unified one-axis numerator/denominator presentation;
* the primitive source producer singleton.

This file proves these are not merely numerically co-targeted.  On the current
finite SU(7)-breaking source surface, they are the same
`AlphaStrongResidualGapProducer` object.

Boundary: this still inherits the finite source surface.  It does not construct
threshold spectra, three-loop RG, Higgs/extra-representation dynamics, or a
smooth de Rham spacetime producer.  The gain is object-level identity of the
current `alpha_s` producer fronts, so the remaining producer debt has one
surface instead of several parallel presentations.
-/

noncomputable section

namespace SaturationMonoid
namespace StandardModelConstraint

/-! ## The primitive source face as a four-source producer -/

/-- Contribution function read from a primitive one-axis source producer:
the SU(7)-breaking source gets the one-axis alpha gap and the other three
residual sources are zero. -/
def oneAxisPrimitiveSourceContribution
    (P : OneAxisPrimitiveSourceProducer) :
    AlphaStrongResidualSource -> ℚ
  | .su7Breaking => oneAxisAlphaStrongGap P.axis
  | .threshold => 0
  | .threeLoopRG => 0
  | .higgsExtraRepresentation => 0

/-- THEOREM 1: every primitive source contribution lies on the finite
SU(7)-breaking contribution law. -/
theorem oneAxisPrimitiveSourceContribution_law
    (P : OneAxisPrimitiveSourceProducer) :
    AlphaStrongSU7FiniteContributionLaw
      (oneAxisPrimitiveSourceContribution P) := by
  constructor
  · rw [oneAxisPrimitiveSourceContribution]
    rw [oneAxisAlphaStrongGap_eq_89_div_10000_of_sourceLaw
      (oneAxisPrimitiveSourceProducer_sourceLaw P)]
    exact (alphaStrongSU7BreakingAlphaGap_eq_89_div_10000 ℚ).symm
  constructor
  · rfl
  constructor
  · rfl
  · rfl

/-- The residual-gap producer generated by a primitive one-axis source
producer. -/
def oneAxisPrimitiveSourceResidualGapProducer
    (P : OneAxisPrimitiveSourceProducer) :
    AlphaStrongResidualGapProducer :=
  alphaStrongGapProducerOfSU7FiniteContributionLaw
    (oneAxisPrimitiveSourceContribution P)
    (oneAxisPrimitiveSourceContribution_law P)

/-- THEOREM 2: the primitive source producer lies on the same finite source
surface as the earlier alpha_s producers. -/
theorem oneAxisPrimitiveSourceResidualGapProducer_sourceSurface
    (P : OneAxisPrimitiveSourceProducer) :
    AlphaStrongResidualProducerFiniteSourceSurface
      (oneAxisPrimitiveSourceResidualGapProducer P) := by
  exact oneAxisPrimitiveSourceContribution_law P

/-! ## Existing finite faces all lie on the same source surface -/

/-- THEOREM 3: the P602 Poincare-resolution producer lies on the finite source
surface. -/
theorem alphaStrongPoincareResolutionResidualGapProducer_sourceSurface
    (C : FourDPoincareCertificate)
    (e : UnifiedGaugeFreedomCarrier ↪ AlphaEMStructuralCarrier) :
    AlphaStrongResidualProducerFiniteSourceSurface
      (alphaStrongPoincareResolutionResidualGapProducer C e) := by
  exact alphaStrongPoincareResolutionContribution_law C e

/-- THEOREM 4: the P626 QCD/Poincare producer lies on the finite source
surface. -/
theorem alphaStrongQCDPoincareResidualGapProducer_sourceSurface
    (e : UnifiedGaugeFreedomCarrier ↪ AlphaEMStructuralCarrier) :
    AlphaStrongResidualProducerFiniteSourceSurface
      (alphaStrongQCDPoincareResidualGapProducer e) := by
  exact alphaStrongQCDPoincareContribution_law e

/-- THEOREM 5: the P627 unified-axis producer lies on the finite source
surface. -/
theorem alphaStrongQCDPoincareUnifiedAxisResidualGapProducer_sourceSurface :
    AlphaStrongResidualProducerFiniteSourceSurface
      alphaStrongQCDPoincareUnifiedAxisResidualGapProducer := by
  exact alphaStrongQCDPoincareUnifiedAxisContribution_law

/-! ## Object-level identity of the producer faces -/

/-- THEOREM 6: every primitive source residual producer is the unified-axis
residual producer. -/
theorem oneAxisPrimitiveSourceResidualGapProducer_eq_unifiedAxis
    (P : OneAxisPrimitiveSourceProducer) :
    oneAxisPrimitiveSourceResidualGapProducer P =
      alphaStrongQCDPoincareUnifiedAxisResidualGapProducer := by
  rw [
    eq_alphaStrongSU7BreakingResidualGapProducer_of_sourceSurface
      (oneAxisPrimitiveSourceResidualGapProducer P)
      (oneAxisPrimitiveSourceResidualGapProducer_sourceSurface P),
    eq_alphaStrongSU7BreakingResidualGapProducer_of_sourceSurface
      alphaStrongQCDPoincareUnifiedAxisResidualGapProducer
      alphaStrongQCDPoincareUnifiedAxisResidualGapProducer_sourceSurface]

/-- THEOREM 7: every P602 Poincare-resolution residual producer is the
unified-axis residual producer. -/
theorem alphaStrongPoincareResolutionResidualGapProducer_eq_unifiedAxis
    (C : FourDPoincareCertificate)
    (e : UnifiedGaugeFreedomCarrier ↪ AlphaEMStructuralCarrier) :
    alphaStrongPoincareResolutionResidualGapProducer C e =
      alphaStrongQCDPoincareUnifiedAxisResidualGapProducer := by
  rw [
    eq_alphaStrongSU7BreakingResidualGapProducer_of_sourceSurface
      (alphaStrongPoincareResolutionResidualGapProducer C e)
      (alphaStrongPoincareResolutionResidualGapProducer_sourceSurface C e),
    eq_alphaStrongSU7BreakingResidualGapProducer_of_sourceSurface
      alphaStrongQCDPoincareUnifiedAxisResidualGapProducer
      alphaStrongQCDPoincareUnifiedAxisResidualGapProducer_sourceSurface]

/-- THEOREM 8: every P626 QCD/Poincare residual producer is the unified-axis
residual producer. -/
theorem alphaStrongQCDPoincareResidualGapProducer_eq_unifiedAxis
    (e : UnifiedGaugeFreedomCarrier ↪ AlphaEMStructuralCarrier) :
    alphaStrongQCDPoincareResidualGapProducer e =
      alphaStrongQCDPoincareUnifiedAxisResidualGapProducer := by
  rw [
    eq_alphaStrongSU7BreakingResidualGapProducer_of_sourceSurface
      (alphaStrongQCDPoincareResidualGapProducer e)
      (alphaStrongQCDPoincareResidualGapProducer_sourceSurface e),
    eq_alphaStrongSU7BreakingResidualGapProducer_of_sourceSurface
      alphaStrongQCDPoincareUnifiedAxisResidualGapProducer
      alphaStrongQCDPoincareUnifiedAxisResidualGapProducer_sourceSurface]

/-- THEOREM 9: the primitive-source producer and unified-axis producer have
the same produced alpha gap. -/
theorem oneAxisPrimitiveSourceProducedGap_eq_unifiedAxis
    (P : OneAxisPrimitiveSourceProducer) :
    (oneAxisPrimitiveSourceResidualGapProducer P).producedGap =
      alphaStrongQCDPoincareUnifiedAxisResidualGapProducer.producedGap := by
  rw [oneAxisPrimitiveSourceResidualGapProducer_eq_unifiedAxis P]

/-- THEOREM 10: the object identity transports the primitive-source producer
to the exact inverse residual. -/
theorem oneAxisPrimitiveSourceResidualGapProducer_inverseCorrection
    (P : OneAxisPrimitiveSourceProducer) :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (oneAxisPrimitiveSourceResidualGapProducer P).producedGap =
      -((89000 : ℚ) / 128511) := by
  rw [oneAxisPrimitiveSourceResidualGapProducer_eq_unifiedAxis P]
  exact alphaStrongQCDPoincareUnifiedAxisResidualGapProducer_inverseCorrection

/-! ## Bundled identity certificate -/

/-- Compact certificate: the current finite `alpha_s` producer fronts are the
same object, not just numerically aligned. -/
structure AlphaStrongCurrentProducerFacesIdentityCertificate where
  primitive_source_surface :
    ∀ P : OneAxisPrimitiveSourceProducer,
      AlphaStrongResidualProducerFiniteSourceSurface
        (oneAxisPrimitiveSourceResidualGapProducer P)
  poincare_resolution_surface :
    ∀ (C : FourDPoincareCertificate.{0})
      (e : UnifiedGaugeFreedomCarrier ↪ AlphaEMStructuralCarrier),
      AlphaStrongResidualProducerFiniteSourceSurface
        (alphaStrongPoincareResolutionResidualGapProducer C e)
  qcd_poincare_surface :
    ∀ e : UnifiedGaugeFreedomCarrier ↪ AlphaEMStructuralCarrier,
      AlphaStrongResidualProducerFiniteSourceSurface
        (alphaStrongQCDPoincareResidualGapProducer e)
  unified_axis_surface :
    AlphaStrongResidualProducerFiniteSourceSurface
      alphaStrongQCDPoincareUnifiedAxisResidualGapProducer
  primitive_eq_unified :
    ∀ P : OneAxisPrimitiveSourceProducer,
      oneAxisPrimitiveSourceResidualGapProducer P =
        alphaStrongQCDPoincareUnifiedAxisResidualGapProducer
  poincare_eq_unified :
    ∀ (C : FourDPoincareCertificate.{0})
      (e : UnifiedGaugeFreedomCarrier ↪ AlphaEMStructuralCarrier),
      alphaStrongPoincareResolutionResidualGapProducer C e =
        alphaStrongQCDPoincareUnifiedAxisResidualGapProducer
  qcd_poincare_eq_unified :
    ∀ e : UnifiedGaugeFreedomCarrier ↪ AlphaEMStructuralCarrier,
      alphaStrongQCDPoincareResidualGapProducer e =
        alphaStrongQCDPoincareUnifiedAxisResidualGapProducer
  primitive_inverse_residual :
    ∀ P : OneAxisPrimitiveSourceProducer,
      inverseCorrectionFromAlphaGap
          (alphaStrongTwoLoopSMOutput ℚ)
          (oneAxisPrimitiveSourceResidualGapProducer P).producedGap =
        -((89000 : ℚ) / 128511)

/-- THEOREM 11: current finite alpha_s producer-face identity certificate. -/
theorem alphaStrongCurrentProducerFacesIdentityCertificate :
    AlphaStrongCurrentProducerFacesIdentityCertificate where
  primitive_source_surface :=
    oneAxisPrimitiveSourceResidualGapProducer_sourceSurface
  poincare_resolution_surface :=
    alphaStrongPoincareResolutionResidualGapProducer_sourceSurface
  qcd_poincare_surface :=
    alphaStrongQCDPoincareResidualGapProducer_sourceSurface
  unified_axis_surface :=
    alphaStrongQCDPoincareUnifiedAxisResidualGapProducer_sourceSurface
  primitive_eq_unified :=
    oneAxisPrimitiveSourceResidualGapProducer_eq_unifiedAxis
  poincare_eq_unified :=
    alphaStrongPoincareResolutionResidualGapProducer_eq_unifiedAxis
  qcd_poincare_eq_unified :=
    alphaStrongQCDPoincareResidualGapProducer_eq_unifiedAxis
  primitive_inverse_residual :=
    oneAxisPrimitiveSourceResidualGapProducer_inverseCorrection

end StandardModelConstraint
end SaturationMonoid
