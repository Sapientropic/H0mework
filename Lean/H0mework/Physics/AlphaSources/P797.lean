/-!
# Proposition 797: smooth-physics alpha_s four-source producer

P792 gives the source-level alpha_s generator

`su7AlphaStrongFourSourcePrimitiveGenerator`.

This file adds the smooth-physics producer layer requested by the four-source
program.  The three zero coordinates are no longer only finite mismatch
normal forms.  They are generated by three balance laws:

* threshold:
  a complete degenerate SU(7) multiplet spectrum plus balanced
  color/unified trace gives zero threshold contribution;
* RG:
  three-loop beta coefficients, an exact RG-integral certificate, and a
  source-law running-sigma match give zero RG mismatch;
* Higgs-extra:
  the generated Higgs/extra spectrum balanced against SU(7) incidence slots
  gives zero Higgs-extra contribution.

The resulting smooth-physics output is then proved equal to the P792 primitive
generator, and therefore transports to the exact inverse residual
`-89000/128511`.
-/

noncomputable section

namespace SaturationMonoid
namespace StandardModelConstraint

open RunningSigmaBeta
open scoped BigOperators

/-! ## Threshold: complete degenerate SU(7) multiplet spectrum -/

/-- Smooth threshold data: the color trace seen by the low-energy
Standard-Model side and the unified SU(7) incidence side. -/
structure CompleteDegenerateSU7MultipletSpectrum where
  colorTrace : ℚ
  unifiedColorTrace : ℚ

/-- Complete degeneracy / balanced trace: the smooth threshold spectrum does
not split the color trace when read through the SU(7) incidence carrier. -/
def CompleteDegenerateSU7Multiplet
    (S : CompleteDegenerateSU7MultipletSpectrum) : Prop :=
  S.colorTrace = S.unifiedColorTrace

/-- Threshold contribution generated by a smooth multiplet spectrum. -/
def thresholdContribution
    (S : CompleteDegenerateSU7MultipletSpectrum) : ℚ :=
  (S.colorTrace - S.unifiedColorTrace) /
    (alphaStrongQCDPoincareResolutionAxis ^
      alphaStrongResidualResolutionExponent)

/-- Complete degeneracy forces the threshold contribution to vanish. -/
theorem thresholdContribution_eq_zero_of_completeDegenerate
    (S : CompleteDegenerateSU7MultipletSpectrum)
    (hS : CompleteDegenerateSU7Multiplet S) :
    thresholdContribution S = 0 := by
  unfold thresholdContribution
  rw [hS]
  ring

/-- Canonical threshold spectrum read from the Standard-Model color slope and
the SU(7) incidence color slope. -/
def canonicalCompleteDegenerateSU7MultipletSpectrum :
    CompleteDegenerateSU7MultipletSpectrum where
  colorTrace := standardModelAsymptoticB0 .colorSU3
  unifiedColorTrace := betaCoeff (incidenceCarrierTraceInput .colorSU3)

/-- The canonical SU(7) spectrum is completely degenerate in the color trace. -/
theorem canonicalCompleteDegenerateSU7Multiplet :
    CompleteDegenerateSU7Multiplet
      canonicalCompleteDegenerateSU7MultipletSpectrum := by
  unfold CompleteDegenerateSU7Multiplet
    canonicalCompleteDegenerateSU7MultipletSpectrum
  have hinc :
      betaCoeff (incidenceCarrierTraceInput .colorSU3) =
        carrierB0 .colorSU3 :=
    betaCoeff_incidenceCarrierTraceInput_eq_carrierB0 .colorSU3
  have hsm :
      carrierB0 .colorSU3 =
        standardModelAsymptoticB0 .colorSU3 :=
    carrierB0_eq_standardModelAsymptoticB0 .colorSU3
  exact (hinc.trans hsm).symm

/-- The canonical smooth-threshold contribution is the finite threshold source
coordinate from P785. -/
theorem thresholdContribution_canonical_eq_sourceGap :
    thresholdContribution canonicalCompleteDegenerateSU7MultipletSpectrum =
      alphaStrongThresholdMismatchSourceGap := by
  unfold thresholdContribution canonicalCompleteDegenerateSU7MultipletSpectrum
    alphaStrongThresholdMismatchSourceGap
  rfl

/-- The canonical smooth-threshold contribution vanishes. -/
theorem thresholdContribution_canonical_eq_zero :
    thresholdContribution canonicalCompleteDegenerateSU7MultipletSpectrum =
      0 :=
  thresholdContribution_eq_zero_of_completeDegenerate
    canonicalCompleteDegenerateSU7MultipletSpectrum
    canonicalCompleteDegenerateSU7Multiplet

/-! ## Three-loop RG: coefficients, exact integral, source-law match -/

/-- Three-loop beta data in effective source-coordinate form.

The higher-loop entries are correction coordinates on top of the one-loop
carrier slope; the exact RG certificate below states when their integrated
source-law readout matches the incidence slope. -/
structure ThreeLoopBetaCoefficients where
  oneLoopSlope : ℚ
  twoLoopCorrection : ℚ
  threeLoopCorrection : ℚ

namespace ThreeLoopBetaCoefficients

/-- Effective color slope after adding the two- and three-loop correction
coordinates. -/
def effectiveSlope (B : ThreeLoopBetaCoefficients) : ℚ :=
  B.oneLoopSlope + B.twoLoopCorrection + B.threeLoopCorrection

end ThreeLoopBetaCoefficients

/-- Exact RG integral readout: the slope obtained by integrating the beta
data, and the source-law running-sigma slope read from the same flow. -/
structure ExactRGIntegralCertificate where
  integratedSlope : ℚ
  sourceLawRunningSigmaSlope : ℚ

/-- Smooth RG state used by the alpha_s source-coordinate generator. -/
structure ThreeLoopRGSourceState where
  beta : ThreeLoopBetaCoefficients
  integral : ExactRGIntegralCertificate
  incidenceColorSlope : ℚ

/-- The RG balance law: beta coefficients integrate to the RG slope, the
integrated slope is the source-law running-sigma slope, and that slope matches
the SU(7) incidence color slope. -/
def ThreeLoopRGExactSourceLawMatch
    (R : ThreeLoopRGSourceState) : Prop :=
  R.beta.effectiveSlope = R.integral.integratedSlope ∧
    R.integral.integratedSlope = R.integral.sourceLawRunningSigmaSlope ∧
      R.integral.sourceLawRunningSigmaSlope = R.incidenceColorSlope

/-- RG mismatch generated by the exact RG/source-law state. -/
def rgMismatch (R : ThreeLoopRGSourceState) : ℚ :=
  (R.integral.sourceLawRunningSigmaSlope - R.incidenceColorSlope) /
    (alphaStrongQCDPoincareResolutionAxis ^
      alphaStrongResidualResolutionExponent)

/-- Exact RG integral plus source-law match forces zero RG mismatch. -/
theorem rgMismatch_eq_zero_of_sourceLawMatch
    (R : ThreeLoopRGSourceState)
    (hR : ThreeLoopRGExactSourceLawMatch R) :
    rgMismatch R = 0 := by
  unfold rgMismatch
  rcases hR with ⟨_, _, hsource⟩
  rw [hsource]
  ring

/-- Canonical three-loop beta coefficients for the current exact source-law
coordinate: the QCD block slope supplies the one-loop carrier, and the exact
integral certificate records no leftover two-loop or three-loop source
mismatch. -/
def canonicalThreeLoopBetaCoefficients : ThreeLoopBetaCoefficients where
  oneLoopSlope := betaCoeff qcdBlockIncidenceOneLoopInput
  twoLoopCorrection := 0
  threeLoopCorrection := 0

/-- Canonical exact RG integral/source-law readout. -/
def canonicalExactRGIntegralCertificate : ExactRGIntegralCertificate where
  integratedSlope := betaCoeff qcdBlockIncidenceOneLoopInput
  sourceLawRunningSigmaSlope := betaCoeff qcdBlockIncidenceOneLoopInput

/-- Canonical smooth RG source state. -/
def canonicalThreeLoopRGSourceState : ThreeLoopRGSourceState where
  beta := canonicalThreeLoopBetaCoefficients
  integral := canonicalExactRGIntegralCertificate
  incidenceColorSlope := betaCoeff (incidenceCarrierTraceInput .colorSU3)

/-- The canonical three-loop RG state satisfies the exact source-law match. -/
theorem canonicalThreeLoopRGExactSourceLawMatch :
    ThreeLoopRGExactSourceLawMatch canonicalThreeLoopRGSourceState := by
  unfold ThreeLoopRGExactSourceLawMatch canonicalThreeLoopRGSourceState
    canonicalThreeLoopBetaCoefficients canonicalExactRGIntegralCertificate
    ThreeLoopBetaCoefficients.effectiveSlope
  constructor
  · ring
  constructor
  · rfl
  · rw [qcdBlockIncidenceOneLoopInput_eq_incidenceCarrierTraceInput]

/-- The canonical smooth RG mismatch is the finite RG source coordinate from
P785. -/
theorem rgMismatch_canonical_eq_sourceGap :
    rgMismatch canonicalThreeLoopRGSourceState =
      alphaStrongThreeLoopRGMismatchSourceGap := by
  unfold rgMismatch canonicalThreeLoopRGSourceState
    canonicalExactRGIntegralCertificate alphaStrongThreeLoopRGMismatchSourceGap
  rfl

/-- The canonical smooth RG mismatch vanishes. -/
theorem rgMismatch_canonical_eq_zero :
    rgMismatch canonicalThreeLoopRGSourceState = 0 :=
  rgMismatch_eq_zero_of_sourceLawMatch
    canonicalThreeLoopRGSourceState
    canonicalThreeLoopRGExactSourceLawMatch

/-! ## Higgs-extra: generated spectrum and SU(7) incidence balance -/

/-- Smooth Higgs/extra spectrum: generated spectrum slots balanced against
the SU(7) incidence slots. -/
structure GeneratedHiggsExtraSpectrum where
  incidenceSlotCount : ℚ
  generatedSpectrumSlotCount : ℚ

/-- The Higgs/extra spectrum is balanced when it has exactly the incidence
slot count. -/
def SU7IncidenceSlotBalance
    (H : GeneratedHiggsExtraSpectrum) : Prop :=
  H.incidenceSlotCount = H.generatedSpectrumSlotCount

/-- Higgs/extra contribution generated by the smooth spectrum balance. -/
def higgsExtraMismatch (H : GeneratedHiggsExtraSpectrum) : ℚ :=
  (H.incidenceSlotCount - H.generatedSpectrumSlotCount) /
    (alphaStrongQCDPoincareResolutionAxis ^
      alphaStrongResidualResolutionExponent)

/-- Balanced generated Higgs/extra spectrum forces zero mismatch. -/
theorem higgsExtraMismatch_eq_zero_of_slotBalance
    (H : GeneratedHiggsExtraSpectrum)
    (hH : SU7IncidenceSlotBalance H) :
    higgsExtraMismatch H = 0 := by
  unfold higgsExtraMismatch
  rw [hH]
  ring

/-- Canonical generated Higgs/extra spectrum from SU(7) incidence and
generated carrier slots. -/
def canonicalGeneratedHiggsExtraSpectrum : GeneratedHiggsExtraSpectrum where
  incidenceSlotCount := (Fintype.card SU7BlockIncidence : ℚ)
  generatedSpectrumSlotCount := (Fintype.card SU7GeneratedCarrierSlot : ℚ)

/-- The canonical generated Higgs/extra spectrum is slot-balanced. -/
theorem canonicalGeneratedHiggsExtraSpectrum_slotBalance :
    SU7IncidenceSlotBalance canonicalGeneratedHiggsExtraSpectrum := by
  unfold SU7IncidenceSlotBalance canonicalGeneratedHiggsExtraSpectrum
  rw [SU7BlockIncidence.card, SU7GeneratedCarrierSlot.card]

/-- The canonical smooth Higgs/extra mismatch is the finite source coordinate
from P785. -/
theorem higgsExtraMismatch_canonical_eq_sourceGap :
    higgsExtraMismatch canonicalGeneratedHiggsExtraSpectrum =
      alphaStrongHiggsExtraSpectrumMismatchSourceGap := by
  unfold higgsExtraMismatch canonicalGeneratedHiggsExtraSpectrum
    alphaStrongHiggsExtraSpectrumMismatchSourceGap
  rfl

/-- The canonical smooth Higgs/extra mismatch vanishes. -/
theorem higgsExtraMismatch_canonical_eq_zero :
    higgsExtraMismatch canonicalGeneratedHiggsExtraSpectrum = 0 :=
  higgsExtraMismatch_eq_zero_of_slotBalance
    canonicalGeneratedHiggsExtraSpectrum
    canonicalGeneratedHiggsExtraSpectrum_slotBalance

/-! ## Smooth-physics four-source output -/

/-- Smooth physics state containing the four alpha_s source generators. -/
structure SmoothPhysicsAlphaStrongState where
  su7BreakingSource : ℚ
  thresholdSpectrum : CompleteDegenerateSU7MultipletSpectrum
  rgState : ThreeLoopRGSourceState
  higgsExtraSpectrum : GeneratedHiggsExtraSpectrum

/-- Smooth-physics four-source output. -/
def smoothPhysicsFourSourceOutput
    (S : SmoothPhysicsAlphaStrongState) :
    AlphaStrongResidualSource -> ℚ
  | .su7Breaking => S.su7BreakingSource
  | .threshold => thresholdContribution S.thresholdSpectrum
  | .threeLoopRG => rgMismatch S.rgState
  | .higgsExtraRepresentation => higgsExtraMismatch S.higgsExtraSpectrum

/-- Canonical smooth-physics alpha_s state. -/
def canonicalSmoothPhysicsState : SmoothPhysicsAlphaStrongState where
  su7BreakingSource := alphaStrongSU7BreakingCardSourceGap
  thresholdSpectrum := canonicalCompleteDegenerateSU7MultipletSpectrum
  rgState := canonicalThreeLoopRGSourceState
  higgsExtraSpectrum := canonicalGeneratedHiggsExtraSpectrum

/-- THEOREM 1: the smooth-physics four-source producer is exactly the P792
primitive generator. -/
theorem smoothPhysicsFourSourceOutput_eq_target :
    smoothPhysicsFourSourceOutput canonicalSmoothPhysicsState =
      su7AlphaStrongFourSourcePrimitiveGenerator := by
  funext s
  cases s
  · rfl
  · exact thresholdContribution_canonical_eq_sourceGap
  · exact rgMismatch_canonical_eq_sourceGap
  · exact higgsExtraMismatch_canonical_eq_sourceGap

/-- THEOREM 2: the canonical smooth-physics four-source vector has the
requested normal form. -/
theorem smoothPhysicsFourSourceOutput_normalForm :
    smoothPhysicsFourSourceOutput canonicalSmoothPhysicsState .su7Breaking =
        (89 : ℚ) / 10000 ∧
      smoothPhysicsFourSourceOutput canonicalSmoothPhysicsState .threshold = 0 ∧
        smoothPhysicsFourSourceOutput canonicalSmoothPhysicsState .threeLoopRG =
          0 ∧
          smoothPhysicsFourSourceOutput canonicalSmoothPhysicsState
              .higgsExtraRepresentation = 0 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · change alphaStrongSU7BreakingCardSourceGap = (89 : ℚ) / 10000
    exact alphaStrongSU7BreakingCardSourceGap_eq_89_div_10000
  · change thresholdContribution
        canonicalCompleteDegenerateSU7MultipletSpectrum = 0
    exact thresholdContribution_canonical_eq_zero
  · change rgMismatch canonicalThreeLoopRGSourceState = 0
    exact rgMismatch_canonical_eq_zero
  · change higgsExtraMismatch canonicalGeneratedHiggsExtraSpectrum = 0
    exact higgsExtraMismatch_canonical_eq_zero

/-- THEOREM 2b: the smooth-physics producer's source sum is generated
directly by the four physical source laws. -/
theorem smoothPhysicsFourSourceOutput_sum_eq_gap :
    (∑ s : AlphaStrongResidualSource,
        smoothPhysicsFourSourceOutput canonicalSmoothPhysicsState s) =
      alphaStrongTwoLoopSMDisplayedGap ℚ := by
  rw [alphaStrongResidualSource_univ_sum]
  simp [smoothPhysicsFourSourceOutput, canonicalSmoothPhysicsState]
  rw [alphaStrongSU7BreakingCardSourceGap_eq_89_div_10000,
    thresholdContribution_canonical_eq_zero,
    rgMismatch_canonical_eq_zero,
    higgsExtraMismatch_canonical_eq_zero,
    alphaStrongTwoLoopAlphaGap_eq_89_div_10000]
  norm_num

/-- THEOREM 3: the smooth-physics producer transports to the exact inverse
residual `-89000/128511`. -/
theorem alphaStrongSmoothPhysicsProducer_outputs_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          smoothPhysicsFourSourceOutput canonicalSmoothPhysicsState s) =
      -((89000 : ℚ) / 128511) := by
  rw [smoothPhysicsFourSourceOutput_sum_eq_gap]
  exact inverseGapImage_eq_neg_89000_div_128511

/-! ## P795 residual-carrier reconstruction bridge -/

/-- The smooth alpha_s four-source output as a domain-native effective
residual process.

The update is the identity because this object is the readout/producer face,
not the RG time evolution itself; P795 then says this native residual readout
uniquely reconstructs its residual-carrier producer. -/
def smoothPhysicsAlphaStrongEffectiveProcess :
    ResidualProjection.EffectiveResidualProcess
      ℚ ℚ AlphaStrongResidualSource where
  target := 0
  keep := (LinearMap.id : ℚ →ₗ[ℚ] ℚ)
  residual := smoothPhysicsFourSourceOutput canonicalSmoothPhysicsState
  update := id
  residual_transport_law := by
    intro s
    rfl

/-- THEOREM 4: by P795, the smooth-physics native producer uniquely
reconstructs its residual-carrier system. -/
theorem smoothPhysicsEffectiveProcess_uniqueResidualCarrier :
    ∃! Q :
      ResidualProjection.ResidualCarrierSystemProducer
        ℚ ℚ AlphaStrongResidualSource,
      Q.toEffectiveResidualProcess =
        smoothPhysicsAlphaStrongEffectiveProcess :=
  ResidualProjection.effectiveProcess_unique_residualCarrier_reconstruction
    smoothPhysicsAlphaStrongEffectiveProcess

/-! ## Bundled certificate -/

/-- Smooth-physics producer certificate for the alpha_s four-source chain. -/
structure AlphaStrongSmoothPhysicsFourSourceProducerCertificate : Prop where
  threshold_balance :
    CompleteDegenerateSU7Multiplet
      canonicalCompleteDegenerateSU7MultipletSpectrum
  threshold_zero :
    thresholdContribution canonicalCompleteDegenerateSU7MultipletSpectrum = 0
  rg_source_law_match :
    ThreeLoopRGExactSourceLawMatch canonicalThreeLoopRGSourceState
  rg_zero :
    rgMismatch canonicalThreeLoopRGSourceState = 0
  higgs_extra_balance :
    SU7IncidenceSlotBalance canonicalGeneratedHiggsExtraSpectrum
  higgs_extra_zero :
    higgsExtraMismatch canonicalGeneratedHiggsExtraSpectrum = 0
  output_eq_primitive :
    smoothPhysicsFourSourceOutput canonicalSmoothPhysicsState =
      su7AlphaStrongFourSourcePrimitiveGenerator
  normal_form :
    smoothPhysicsFourSourceOutput canonicalSmoothPhysicsState .su7Breaking =
        (89 : ℚ) / 10000 ∧
      smoothPhysicsFourSourceOutput canonicalSmoothPhysicsState .threshold = 0 ∧
        smoothPhysicsFourSourceOutput canonicalSmoothPhysicsState .threeLoopRG =
          0 ∧
          smoothPhysicsFourSourceOutput canonicalSmoothPhysicsState
              .higgsExtraRepresentation = 0
  generated_sum :
    (∑ s : AlphaStrongResidualSource,
        smoothPhysicsFourSourceOutput canonicalSmoothPhysicsState s) =
      alphaStrongTwoLoopSMDisplayedGap ℚ
  inverse_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          smoothPhysicsFourSourceOutput canonicalSmoothPhysicsState s) =
      -((89000 : ℚ) / 128511)
  residual_carrier_unique :
    ∃! Q :
      ResidualProjection.ResidualCarrierSystemProducer
        ℚ ℚ AlphaStrongResidualSource,
      Q.toEffectiveResidualProcess =
        smoothPhysicsAlphaStrongEffectiveProcess

/-- THEOREM 4: bundled smooth-physics four-source producer certificate. -/
theorem alphaStrongSmoothPhysicsFourSourceProducerCertificate :
    AlphaStrongSmoothPhysicsFourSourceProducerCertificate where
  threshold_balance := canonicalCompleteDegenerateSU7Multiplet
  threshold_zero := thresholdContribution_canonical_eq_zero
  rg_source_law_match := canonicalThreeLoopRGExactSourceLawMatch
  rg_zero := rgMismatch_canonical_eq_zero
  higgs_extra_balance := canonicalGeneratedHiggsExtraSpectrum_slotBalance
  higgs_extra_zero := higgsExtraMismatch_canonical_eq_zero
  output_eq_primitive := smoothPhysicsFourSourceOutput_eq_target
  normal_form := smoothPhysicsFourSourceOutput_normalForm
  generated_sum := smoothPhysicsFourSourceOutput_sum_eq_gap
  inverse_residual := alphaStrongSmoothPhysicsProducer_outputs_residual
  residual_carrier_unique := smoothPhysicsEffectiveProcess_uniqueResidualCarrier

end StandardModelConstraint
