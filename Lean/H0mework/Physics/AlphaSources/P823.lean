import H0mework.Physics.AlphaSources.P802

/-!
# Proposition 823: alpha_s four-source vector generated coordinatewise

P797-P802 lower the alpha_s residual to structural producer roots.  This file
removes one last ambiguity in the presentation: the four-source vector is
defined coordinatewise from the producer legs themselves.

The generated coordinates are:

* SU(7)-breaking: the card-source numerator/denominator;
* threshold: the one-loop carrier trace, read as a complete degenerate
  multiplet spectrum;
* RG: the SU(7) loop-counterterm source, whose generated raw loop coordinates
  are cancelled by their source-law counterterms;
* Higgs/extra: the endpoint-orientation equivalence, read as the generated
  incidence-slot spectrum.

Thus the inverse correction `-89000/128511` is produced by this coordinatewise
source vector, not by a pre-shaped four-coordinate receipt.
-/

noncomputable section

namespace SaturationMonoid
namespace StandardModelConstraint

open RunningSigmaBeta
open scoped BigOperators

/-! ## Coordinatewise structural generator -/

/-- The alpha_s four-source vector generated directly from the four structural
producer legs of P802.

This is the native coordinatewise generator: each coordinate is calculated from
its own source object before the vector is compared with the P792 primitive
normal form. -/
def alphaStrongCoordinatewiseStructuralFourSourceVector
    (D : StructuralCarrierSmoothPhysicsSourceData) :
    AlphaStrongResidualSource -> ℚ
  | .su7Breaking =>
      su7BreakingSourceFromCardData D.breakingCard
  | .threshold =>
      thresholdContribution
        (thresholdSpectrumFromTraceSource
          (thresholdTraceSourceFromOneLoopCarrier D.oneLoopCarrier))
  | .threeLoopRG =>
      rgMismatch
        (threeLoopRGStateFromBetaAndIncidence
          (threeLoopBetaCoefficientsFromExpansion
            (threeLoopRGExpansionFromSU7CountertermSource
              (loopCountertermSourceOfStructuralCarrierSource D)))
          (betaCoeff (incidenceCarrierTraceInput .colorSU3)))
  | .higgsExtraRepresentation =>
      higgsExtraMismatch
        (generatedHiggsExtraSpectrumFromIncidenceEquiv
          (incidenceEquivFromOrientationCertificate D.orientation))

/-- THEOREM 1: the coordinatewise structural generator is definitionally the
smooth four-source output generated by the P802 structural carrier source. -/
theorem alphaStrongCoordinatewiseStructuralFourSourceVector_eq_smoothOutput
    (D : StructuralCarrierSmoothPhysicsSourceData) :
    alphaStrongCoordinatewiseStructuralFourSourceVector D =
      smoothPhysicsFourSourceOutput
        (smoothPhysicsStateFromStructuralCarrierSource D) := by
  funext s
  cases s <;> rfl

/-! ## The four generated coordinates -/

/-- THEOREM 2: the SU(7)-breaking coordinate is generated from the card source
as `89/10000`. -/
theorem alphaStrongCoordinatewise_su7Breaking_eq_89_div_10000 :
    alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData .su7Breaking =
      (89 : ℚ) / 10000 := by
  exact su7BreakingSourceFromCardData_canonical_eq_89_div_10000

/-- THEOREM 3: the threshold coordinate vanishes because the one-loop carrier
receipt generates a balanced complete-degenerate threshold spectrum. -/
theorem alphaStrongCoordinatewise_threshold_eq_zero :
    alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData .threshold =
      0 := by
  exact thresholdContribution_fromTraceSource_eq_zero
    (thresholdTraceSourceFromOneLoopCarrier
      standardModelOneLoopCarrierFinalReceipt)
    (thresholdTraceSourceFromOneLoopCarrier_balanced
      standardModelOneLoopCarrierFinalReceipt)

/-- THEOREM 4: the RG coordinate vanishes because the SU(7) counterterm source
generates cancelled two- and three-loop source coordinates. -/
theorem alphaStrongCoordinatewise_threeLoopRG_eq_zero :
    alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData .threeLoopRG =
      0 := by
  exact rgMismatch_fromSU7CountertermSource_eq_zero
    (loopCountertermSourceOfStructuralCarrierSource
      canonicalStructuralCarrierSmoothPhysicsSourceData)

/-- THEOREM 5: the Higgs/extra coordinate vanishes because the endpoint
orientation equivalence generates a balanced incidence-slot spectrum. -/
theorem alphaStrongCoordinatewise_higgsExtra_eq_zero :
    alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData
          .higgsExtraRepresentation =
      0 := by
  exact higgsExtraMismatch_fromIncidenceEquiv_eq_zero
    (incidenceEquivFromOrientationCertificate
      su7IncidenceOrientationUniquenessCertificate)

/-- THEOREM 6: the coordinatewise structural vector has the exact normal form
`{89/10000, 0, 0, 0}`. -/
theorem alphaStrongCoordinatewiseStructuralFourSourceVector_normalForm :
    alphaStrongCoordinatewiseStructuralFourSourceVector
          canonicalStructuralCarrierSmoothPhysicsSourceData .su7Breaking =
        (89 : ℚ) / 10000 ∧
      alphaStrongCoordinatewiseStructuralFourSourceVector
          canonicalStructuralCarrierSmoothPhysicsSourceData .threshold = 0 ∧
        alphaStrongCoordinatewiseStructuralFourSourceVector
            canonicalStructuralCarrierSmoothPhysicsSourceData .threeLoopRG =
          0 ∧
          alphaStrongCoordinatewiseStructuralFourSourceVector
              canonicalStructuralCarrierSmoothPhysicsSourceData
                .higgsExtraRepresentation = 0 := by
  exact ⟨alphaStrongCoordinatewise_su7Breaking_eq_89_div_10000,
    alphaStrongCoordinatewise_threshold_eq_zero,
    alphaStrongCoordinatewise_threeLoopRG_eq_zero,
    alphaStrongCoordinatewise_higgsExtra_eq_zero⟩

/-! ## Produced residual -/

/-- THEOREM 7: the coordinatewise structural generator is the P792 primitive
four-source generator. -/
theorem alphaStrongCoordinatewiseStructuralFourSourceVector_eq_primitive :
    alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData =
      su7AlphaStrongFourSourcePrimitiveGenerator := by
  rw [alphaStrongCoordinatewiseStructuralFourSourceVector_eq_smoothOutput]
  exact structuralCarrierSmoothPhysicsFourSourceOutput_eq_target

/-- THEOREM 8: the coordinatewise generated vector transports to the exact
inverse alpha_s residual. -/
theorem alphaStrongCoordinatewiseStructuralProducer_outputs_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          alphaStrongCoordinatewiseStructuralFourSourceVector
            canonicalStructuralCarrierSmoothPhysicsSourceData s) =
      -((89000 : ℚ) / 128511) := by
  rw [alphaStrongCoordinatewiseStructuralFourSourceVector_eq_primitive]
  exact su7AlphaStrongFourSourcePrimitiveGenerator_inverseResidual

/-! ## Bundled certificate -/

/-- Coordinatewise alpha_s four-source producer certificate. -/
structure AlphaStrongCoordinatewiseStructuralProducerCertificate : Prop where
  vector_eq_smooth_output :
    alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData =
      smoothPhysicsFourSourceOutput
        (smoothPhysicsStateFromStructuralCarrierSource
          canonicalStructuralCarrierSmoothPhysicsSourceData)
  su7_breaking_generated :
    alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData .su7Breaking =
      (89 : ℚ) / 10000
  threshold_from_one_loop :
    ThresholdTraceSourceBalanced
      (thresholdTraceSourceFromOneLoopCarrier
        standardModelOneLoopCarrierFinalReceipt)
  threshold_zero :
    alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData .threshold =
      0
  rg_counterterm_source_law :
    ThreeLoopRGExpansionSourceLaw
      (threeLoopRGExpansionFromSU7CountertermSource
        (loopCountertermSourceOfStructuralCarrierSource
          canonicalStructuralCarrierSmoothPhysicsSourceData))
  rg_zero :
    alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData .threeLoopRG =
      0
  higgs_extra_orientation_balance :
    SU7IncidenceSlotBalance
      (generatedHiggsExtraSpectrumFromIncidenceEquiv
        (incidenceEquivFromOrientationCertificate
          su7IncidenceOrientationUniquenessCertificate))
  higgs_extra_zero :
    alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData
          .higgsExtraRepresentation =
      0
  output_eq_primitive :
    alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData =
      su7AlphaStrongFourSourcePrimitiveGenerator
  inverse_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          alphaStrongCoordinatewiseStructuralFourSourceVector
            canonicalStructuralCarrierSmoothPhysicsSourceData s) =
      -((89000 : ℚ) / 128511)

/-- THEOREM 9: bundled coordinatewise alpha_s structural producer certificate. -/
theorem alphaStrongCoordinatewiseStructuralProducerCertificate :
    AlphaStrongCoordinatewiseStructuralProducerCertificate where
  vector_eq_smooth_output :=
    alphaStrongCoordinatewiseStructuralFourSourceVector_eq_smoothOutput
      canonicalStructuralCarrierSmoothPhysicsSourceData
  su7_breaking_generated :=
    alphaStrongCoordinatewise_su7Breaking_eq_89_div_10000
  threshold_from_one_loop :=
    thresholdTraceSourceFromOneLoopCarrier_balanced
      standardModelOneLoopCarrierFinalReceipt
  threshold_zero :=
    alphaStrongCoordinatewise_threshold_eq_zero
  rg_counterterm_source_law :=
    threeLoopRGExpansionFromSU7CountertermSource_sourceLaw
      (loopCountertermSourceOfStructuralCarrierSource
        canonicalStructuralCarrierSmoothPhysicsSourceData)
  rg_zero :=
    alphaStrongCoordinatewise_threeLoopRG_eq_zero
  higgs_extra_orientation_balance :=
    generatedHiggsExtraSpectrumFromIncidenceEquiv_balanced
      (incidenceEquivFromOrientationCertificate
        su7IncidenceOrientationUniquenessCertificate)
  higgs_extra_zero :=
    alphaStrongCoordinatewise_higgsExtra_eq_zero
  output_eq_primitive :=
    alphaStrongCoordinatewiseStructuralFourSourceVector_eq_primitive
  inverse_residual :=
    alphaStrongCoordinatewiseStructuralProducer_outputs_residual

end StandardModelConstraint
end SaturationMonoid
