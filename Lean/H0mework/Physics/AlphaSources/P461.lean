/-
  Proposition 461: end-to-end QCD b0 carrier receipt.

  P455 states the carrier formula `b0 = betaCoeff(Lie_algebra,
  representation)`.  P459/P460 lower the representation side to the
  `3+2+1+1` block-incidence carrier and remove the remaining schedule
  permutation freedom relative to endpoint signatures.

  This file packages the QCD case in the form needed by the standard-model
  track: the color Lie-algebra datum is the color block dimension `3`, the
  representation trace is generated by the block incidences and the three
  Poincare generation slots, and the standard one-loop coefficient function
  then forces `b0 = 7`.

  Boundary: the universal one-loop coefficient function `betaCoeff` is still
  the standard Lie/QFT input, and the endpoint-signature table remains the
  current physical producer boundary.  This file removes no physics by
  sleight-of-hand; it just makes the carrier-to-b0 receipt a single Lean
  object.
-/

import H0mework.Physics.RepresentationSources.P460

namespace SaturationMonoid
namespace StandardModelConstraint
namespace RunningSigmaBeta

namespace SU7CarrierBlock

/-! ## Block dimensions as Lie-algebra data -/

/-- Fundamental block dimension in the concrete `3+2+1+1` carrier. -/
def fundamentalDimension : SU7CarrierBlock -> ℕ
  | .color => 3
  | .weak => 2
  | .positiveSinglet => 1
  | .negativeSinglet => 1

/-- THEOREM 1: the block dimensions are exactly `3+2+1+1`. -/
theorem fundamentalDimension_sum :
    fundamentalDimension .color +
      fundamentalDimension .weak +
      fundamentalDimension .positiveSinglet +
      fundamentalDimension .negativeSinglet = 7 := by
  norm_num [fundamentalDimension]

/-- THEOREM 2: the color block selects the `su(3)` adjoint Casimir datum used
by the QCD one-loop coefficient. -/
theorem color_fundamentalDimension :
    fundamentalDimension .color = 3 := rfl

/-- THEOREM 3: the weak block selects the `su(2)` adjoint Casimir datum. -/
theorem weak_fundamentalDimension :
    fundamentalDimension .weak = 2 := rfl

end SU7CarrierBlock

/-! ## End-to-end QCD coefficient input -/

/-- The QCD one-loop input read directly from:

* the color block dimension of the `3+2+1+1` carrier;
* the block-incidence-generated Weyl trace;
* the incidence-generated Higgs scalar trace.
-/
def qcdBlockIncidenceOneLoopInput : GaugeTraceOneLoopInput where
  adjointCasimir := (SU7CarrierBlock.fundamentalDimension .color : ℚ)
  weylDynkinTrace :=
    incidenceTotalWeylTrace StandardModelWeylMultiplet.colorDynkinTrace
  scalarDynkinTrace := incidenceHiggsScalarTrace .colorSU3

/-- THEOREM 4: the direct block-incidence QCD input is the color component of
the incidence carrier trace input. -/
theorem qcdBlockIncidenceOneLoopInput_eq_incidenceCarrierTraceInput :
    qcdBlockIncidenceOneLoopInput = incidenceCarrierTraceInput .colorSU3 := by
  rfl

/-- THEOREM 5: the direct block-incidence QCD input reconstructs the final
carrier formula input. -/
theorem qcdBlockIncidenceOneLoopInput_eq_carrierTraceInput :
    qcdBlockIncidenceOneLoopInput = carrierTraceInput .colorSU3 := by
  rw [qcdBlockIncidenceOneLoopInput_eq_incidenceCarrierTraceInput,
    incidenceCarrierTraceInput_eq_multipletCarrierTraceInput,
    multipletCarrierTraceInput_eq_carrierTraceInput]

/-- THEOREM 6: the final QCD carrier receipt.

`b0 = betaCoeff(su(3), representation)` where `su(3)` is the color block of
the `3+2+1+1` carrier and the representation trace is generated by the
block-incidence carrier plus the three Poincare generation slots. -/
theorem qcd_b0_from_final_carrier_formula :
    betaCoeff qcdBlockIncidenceOneLoopInput = 7 := by
  rw [qcdBlockIncidenceOneLoopInput_eq_incidenceCarrierTraceInput,
    qcd_b0_from_block_incidence_carrier]

/-- THEOREM 7: the same carrier receipt written as the running-sigma law. -/
theorem qcd_residualSelfBump_delta_from_final_carrier_formula
    (σ : ℝ) :
    (standardModelOneLoopCarrier .colorSU3).residualSelfBumpStep σ - σ =
      -((betaCoeff qcdBlockIncidenceOneLoopInput : ℚ) : ℝ) * σ ^ 2 := by
  rw [qcd_b0_from_final_carrier_formula,
    standardModelResidualSelfBump_delta_color]
  norm_num

/-- Bundled end-to-end certificate for the QCD carrier coefficient. -/
structure QCDCarrierB0FinalReceipt where
  block_dimension_sum :
    SU7CarrierBlock.fundamentalDimension .color +
      SU7CarrierBlock.fundamentalDimension .weak +
      SU7CarrierBlock.fundamentalDimension .positiveSinglet +
      SU7CarrierBlock.fundamentalDimension .negativeSinglet = 7
  color_block_dimension :
    SU7CarrierBlock.fundamentalDimension .color = 3
  schedule_unique :
    ∀ f : SU7BlockIncidence -> SU7GeneratedCarrierSlot,
      (∀ i : SU7BlockIncidence,
        generatedSlotEndpointSignature (f i) =
          SU7BlockIncidence.endpoints i) ->
        f = generatedSlotOfIncidence
  input_reconstructs_carrier :
    qcdBlockIncidenceOneLoopInput = carrierTraceInput .colorSU3
  beta_formula :
    betaCoeff qcdBlockIncidenceOneLoopInput = 7
  running_delta :
    ∀ σ : ℝ,
      (standardModelOneLoopCarrier .colorSU3).residualSelfBumpStep σ - σ =
        -((betaCoeff qcdBlockIncidenceOneLoopInput : ℚ) : ℝ) * σ ^ 2

/-- THEOREM 8: the end-to-end QCD b0 carrier certificate. -/
def qcdCarrierB0FinalReceipt : QCDCarrierB0FinalReceipt where
  block_dimension_sum := SU7CarrierBlock.fundamentalDimension_sum
  color_block_dimension := SU7CarrierBlock.color_fundamentalDimension
  schedule_unique :=
    su7IncidenceOrientationUniquenessCertificate.schedule_unique
  input_reconstructs_carrier := qcdBlockIncidenceOneLoopInput_eq_carrierTraceInput
  beta_formula := qcd_b0_from_final_carrier_formula
  running_delta := qcd_residualSelfBump_delta_from_final_carrier_formula

end RunningSigmaBeta
end StandardModelConstraint
end SaturationMonoid
