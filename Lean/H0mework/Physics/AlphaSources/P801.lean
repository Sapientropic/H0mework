import H0mework.Physics.RunningSources.P800

/-!
# Proposition 801: full-bottom alpha_s smooth producer

P800 generates the threshold/RG/Higgs-extra zero coordinates from SU(7)
balance data, but its full source object still carries the SU(7)-breaking
coordinate as a scalar field.  This file removes that last scalar field from
the smooth producer input.

The SU(7)-breaking coordinate is generated from card-source data:

`(information states + visible gauge - unified gauge freedom) / axis^exponent`.

The threshold/RG/Higgs-extra coordinates are generated by the P800 SU(7)
counterterm source.  Thus the full smooth alpha_s state is now generated from
four structural ingredients, not a target-shaped four-source receipt:

* SU(7)-breaking card source;
* threshold trace source;
* loop-counterterm source;
* Higgs/extra incidence-slot source.

The generated output is still the P792 primitive four-source generator and
therefore inverse-transports to `-89000/128511`.  P795 again gives unique
residual-carrier reconstruction.
-/

noncomputable section

namespace SaturationMonoid
namespace StandardModelConstraint

open RunningSigmaBeta
open scoped BigOperators

/-! ## SU(7)-breaking card-source data -/

/-- Data-level version of the SU(7)-breaking card source.  These are the
structural carrier counts that P791 uses directly. -/
structure SU7BreakingCardSourceData where
  informationStates : ℚ
  visibleGauge : ℚ
  unifiedGaugeFreedom : ℚ
  resolutionAxis : ℚ
  resolutionExponent : Nat

/-- Denominator generated by the card-source resolution axis. -/
def SU7BreakingCardSourceData.denominator
    (D : SU7BreakingCardSourceData) : ℚ :=
  D.resolutionAxis ^ D.resolutionExponent

/-- Numerator generated by the seven-facet information carrier, the visible
gauge carrier, and the unified SU(7) gauge-freedom carrier. -/
def SU7BreakingCardSourceData.numerator
    (D : SU7BreakingCardSourceData) : ℚ :=
  (D.informationStates + D.visibleGauge) - D.unifiedGaugeFreedom

/-- Generate the SU(7)-breaking alpha_s source coordinate from card data. -/
def su7BreakingSourceFromCardData
    (D : SU7BreakingCardSourceData) : ℚ :=
  D.numerator / D.denominator

/-- Canonical SU(7)-breaking card-source data. -/
def canonicalSU7BreakingCardSourceData :
    SU7BreakingCardSourceData where
  informationStates := sevenFacetInformationStateCount ℚ
  visibleGauge := lowEnergyVisibleGaugeDimensionFromCard ℚ
  unifiedGaugeFreedom := unifiedGaugeFreedomDimensionFromCard ℚ
  resolutionAxis := alphaStrongQCDPoincareResolutionAxis
  resolutionExponent := alphaStrongResidualResolutionExponent

/-- The canonical card-source data emits P791's SU(7)-breaking card gap. -/
theorem su7BreakingSourceFromCardData_canonical :
    su7BreakingSourceFromCardData canonicalSU7BreakingCardSourceData =
      alphaStrongSU7BreakingCardSourceGap := by
  unfold su7BreakingSourceFromCardData
    SU7BreakingCardSourceData.numerator
    SU7BreakingCardSourceData.denominator
    canonicalSU7BreakingCardSourceData
    alphaStrongSU7BreakingCardSourceGap
    alphaStrongSU7BreakingCardNumerator
    alphaStrongSU7BreakingCardDenominator
  rfl

/-- The canonical card-source data emits exactly `89/10000`. -/
theorem su7BreakingSourceFromCardData_canonical_eq_89_div_10000 :
    su7BreakingSourceFromCardData canonicalSU7BreakingCardSourceData =
      (89 : ℚ) / 10000 := by
  rw [su7BreakingSourceFromCardData_canonical,
    alphaStrongSU7BreakingCardSourceGap_eq_89_div_10000]

/-! ## Full-bottom smooth alpha_s producer -/

/-- Full-bottom source data: no field is a final four-source coordinate.
`breakingCard` generates the nonzero SU(7)-breaking source; `thresholdTrace`
and `incidenceGeneratedSlotEquiv` generate the P800 counterterm/RG/Higgs
coordinates. -/
structure FullBottomSmoothPhysicsSourceData where
  breakingCard : SU7BreakingCardSourceData
  thresholdTrace : ThresholdTraceSourceData
  incidenceGeneratedSlotEquiv :
    SU7BlockIncidence ≃ SU7GeneratedCarrierSlot

/-- Extract P800's counterterm source from the full-bottom source. -/
def loopCountertermSourceOfFullBottomSource
    (D : FullBottomSmoothPhysicsSourceData) :
    SU7LoopCountertermSourceData where
  thresholdTrace := D.thresholdTrace
  incidenceGeneratedSlotEquiv := D.incidenceGeneratedSlotEquiv

/-- Generate P797's smooth state from full-bottom source data. -/
def smoothPhysicsStateFromFullBottomSource
    (D : FullBottomSmoothPhysicsSourceData) :
    SmoothPhysicsAlphaStrongState where
  su7BreakingSource := su7BreakingSourceFromCardData D.breakingCard
  thresholdSpectrum :=
    thresholdSpectrumFromTraceSource D.thresholdTrace
  rgState :=
    threeLoopRGStateFromBetaAndIncidence
      (threeLoopBetaCoefficientsFromExpansion
        (threeLoopRGExpansionFromSU7CountertermSource
          (loopCountertermSourceOfFullBottomSource D)))
      (betaCoeff (incidenceCarrierTraceInput .colorSU3))
  higgsExtraSpectrum :=
    generatedHiggsExtraSpectrumFromIncidenceEquiv
      D.incidenceGeneratedSlotEquiv

/-- Canonical full-bottom source data. -/
def canonicalFullBottomSmoothPhysicsSourceData :
    FullBottomSmoothPhysicsSourceData where
  breakingCard := canonicalSU7BreakingCardSourceData
  thresholdTrace := canonicalThresholdTraceSourceData
  incidenceGeneratedSlotEquiv := blockIncidenceGeneratedSlotEquiv

/-- The canonical full-bottom source generates P797's canonical smooth state. -/
theorem smoothPhysicsStateFromFullBottomSource_canonical :
    smoothPhysicsStateFromFullBottomSource
        canonicalFullBottomSmoothPhysicsSourceData =
      canonicalSmoothPhysicsState := by
  unfold smoothPhysicsStateFromFullBottomSource
    canonicalFullBottomSmoothPhysicsSourceData canonicalSmoothPhysicsState
    loopCountertermSourceOfFullBottomSource
  rw [su7BreakingSourceFromCardData_canonical,
    threeLoopRGStateFromSU7CountertermSource_eq_canonical]
  rfl

/-- THEOREM 1: the full-bottom source producer outputs exactly the P792
four-source primitive generator. -/
theorem fullBottomSmoothPhysicsFourSourceOutput_eq_target :
    smoothPhysicsFourSourceOutput
        (smoothPhysicsStateFromFullBottomSource
          canonicalFullBottomSmoothPhysicsSourceData) =
      su7AlphaStrongFourSourcePrimitiveGenerator := by
  rw [smoothPhysicsStateFromFullBottomSource_canonical]
  exact smoothPhysicsFourSourceOutput_eq_target

/-- THEOREM 2: the full-bottom producer transports to the exact inverse
alpha_s residual. -/
theorem alphaStrongFullBottomSmoothPhysicsProducer_outputs_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          smoothPhysicsFourSourceOutput
            (smoothPhysicsStateFromFullBottomSource
              canonicalFullBottomSmoothPhysicsSourceData) s) =
      -((89000 : ℚ) / 128511) := by
  rw [fullBottomSmoothPhysicsFourSourceOutput_eq_target]
  exact su7AlphaStrongFourSourcePrimitiveGenerator_inverseResidual

/-! ## P795 residual-carrier reconstruction -/

/-- The full-bottom alpha_s output as a native effective residual process. -/
def fullBottomSmoothAlphaStrongEffectiveProcess :
    ResidualProjection.EffectiveResidualProcess
      ℚ ℚ AlphaStrongResidualSource where
  target := 0
  keep := (LinearMap.id : ℚ →ₗ[ℚ] ℚ)
  residual :=
    smoothPhysicsFourSourceOutput
      (smoothPhysicsStateFromFullBottomSource
        canonicalFullBottomSmoothPhysicsSourceData)
  update := id
  residual_transport_law := by
    intro s
    rfl

/-- THEOREM 3: by P795, the full-bottom native producer uniquely reconstructs
its residual-carrier system. -/
theorem fullBottomSmoothEffectiveProcess_uniqueResidualCarrier :
    ∃! Q :
      ResidualProjection.ResidualCarrierSystemProducer
        ℚ ℚ AlphaStrongResidualSource,
      Q.toEffectiveResidualProcess =
        fullBottomSmoothAlphaStrongEffectiveProcess :=
  ResidualProjection.effectiveProcess_unique_residualCarrier_reconstruction
    fullBottomSmoothAlphaStrongEffectiveProcess

/-! ## Bundled certificate -/

/-- Full-bottom alpha_s producer certificate. -/
structure AlphaStrongFullBottomSmoothProducerCertificate : Prop where
  breaking_card_gap :
    su7BreakingSourceFromCardData canonicalSU7BreakingCardSourceData =
      alphaStrongSU7BreakingCardSourceGap
  breaking_card_normal_form :
    su7BreakingSourceFromCardData canonicalSU7BreakingCardSourceData =
      (89 : ℚ) / 10000
  threshold_balanced :
    ThresholdTraceSourceBalanced canonicalThresholdTraceSourceData
  loop_counterterm_source_law :
    ThreeLoopRGExpansionSourceLaw
      (threeLoopRGExpansionFromSU7CountertermSource
        (loopCountertermSourceOfFullBottomSource
          canonicalFullBottomSmoothPhysicsSourceData))
  beta_coefficients_generated :
    threeLoopBetaCoefficientsFromExpansion
        (threeLoopRGExpansionFromSU7CountertermSource
          (loopCountertermSourceOfFullBottomSource
            canonicalFullBottomSmoothPhysicsSourceData)) =
      canonicalThreeLoopBetaCoefficients
  smooth_state_generated :
    smoothPhysicsStateFromFullBottomSource
        canonicalFullBottomSmoothPhysicsSourceData =
      canonicalSmoothPhysicsState
  output_eq_primitive :
    smoothPhysicsFourSourceOutput
        (smoothPhysicsStateFromFullBottomSource
          canonicalFullBottomSmoothPhysicsSourceData) =
      su7AlphaStrongFourSourcePrimitiveGenerator
  inverse_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          smoothPhysicsFourSourceOutput
            (smoothPhysicsStateFromFullBottomSource
              canonicalFullBottomSmoothPhysicsSourceData) s) =
      -((89000 : ℚ) / 128511)
  residual_carrier_unique :
    ∃! Q :
      ResidualProjection.ResidualCarrierSystemProducer
        ℚ ℚ AlphaStrongResidualSource,
      Q.toEffectiveResidualProcess =
        fullBottomSmoothAlphaStrongEffectiveProcess

/-- THEOREM 4: bundled full-bottom alpha_s producer certificate. -/
theorem alphaStrongFullBottomSmoothProducerCertificate :
    AlphaStrongFullBottomSmoothProducerCertificate where
  breaking_card_gap :=
    su7BreakingSourceFromCardData_canonical
  breaking_card_normal_form :=
    su7BreakingSourceFromCardData_canonical_eq_89_div_10000
  threshold_balanced :=
    canonicalThresholdTraceSourceData_balanced
  loop_counterterm_source_law :=
    threeLoopRGExpansionFromSU7CountertermSource_sourceLaw
      (loopCountertermSourceOfFullBottomSource
        canonicalFullBottomSmoothPhysicsSourceData)
  beta_coefficients_generated :=
    threeLoopBetaCoefficientsFromSU7CountertermSource_eq_canonical
      (loopCountertermSourceOfFullBottomSource
        canonicalFullBottomSmoothPhysicsSourceData)
  smooth_state_generated :=
    smoothPhysicsStateFromFullBottomSource_canonical
  output_eq_primitive :=
    fullBottomSmoothPhysicsFourSourceOutput_eq_target
  inverse_residual :=
    alphaStrongFullBottomSmoothPhysicsProducer_outputs_residual
  residual_carrier_unique :=
    fullBottomSmoothEffectiveProcess_uniqueResidualCarrier

end StandardModelConstraint
end SaturationMonoid
