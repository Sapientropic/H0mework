import H0mework.Physics.RepresentationSources.P790
import H0mework.Physics.RunningSources.P889

/-!
# Proposition 890: no-free Higgs/extra pairing for the alpha_s zero source

P877 generated the Higgs/extra zero source from the pairing

`SU7BlockIncidence ≃ SU7GeneratedCarrierSlot`.

P790 proves that this equivalence is not a free schedule: once endpoint
signatures are fixed, every endpoint-preserving equivalence has the same
underlying function as `blockIncidenceGeneratedSlotEquiv`.

This file welds that no-free uniqueness directly into the alpha_s four-source
chain.  The Higgs/extra zero source is now certified as the unique
endpoint-signature-preserving incidence/slot pairing, not merely as a chosen
six-by-six cancellation.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open RunningSigmaBeta
open scoped BigOperators

set_option linter.defProp false

/-! ## No-free Higgs/extra pairing -/

/-- THEOREM 1: the Higgs/extra pairing used by P877 preserves endpoint
signatures. -/
theorem higgsExtraPairedSpectrum_endpoint_preserving :
    ∀ i : SU7BlockIncidence,
      generatedSlotEndpointSignature (higgsExtraPairedSpectrum.pair i) =
        SU7BlockIncidence.endpoints i := by
  intro i
  change
    generatedSlotEndpointSignature (generatedSlotOfIncidence i) =
      SU7BlockIncidence.endpoints i
  exact generatedSlotOfIncidence_endpointSignature i

/-- THEOREM 2: any endpoint-signature-preserving Higgs/extra equivalence has
the same underlying function as the P877 Higgs/extra pairing. -/
theorem higgsExtraEndpointPreservingPair_eq_canonical
    (e : SU7BlockIncidence ≃ SU7GeneratedCarrierSlot)
    (he : ∀ i : SU7BlockIncidence,
      generatedSlotEndpointSignature (e i) = SU7BlockIncidence.endpoints i) :
    e.toFun = higgsExtraPairedSpectrum.pair.toFun := by
  calc
    e.toFun = blockIncidenceGeneratedSlotEquiv.toFun := by
      exact blockIncidenceGeneratedSlotEquiv_no_free e he
    _ = higgsExtraPairedSpectrum.pair.toFun := by
      rfl

/-- Higgs/extra paired spectrum read with its no-free endpoint-signature
certificate. -/
def higgsExtraNoFreePairedSpectrum :
    PairedRepresentationSpectrum SU7BlockIncidence
      SU7GeneratedCarrierSlot where
  leftWeight := fun _ => 1
  rightWeight := fun _ => 1
  pair := blockIncidenceGeneratedSlotEquiv
  paired_weight := by
    intro _
    rfl

/-- THEOREM 3: the no-free Higgs/extra paired spectrum is P877's spectrum. -/
theorem higgsExtraNoFreePairedSpectrum_eq_p877 :
    higgsExtraNoFreePairedSpectrum = higgsExtraPairedSpectrum := by
  rfl

/-- No-free Higgs/extra imbalance. -/
def higgsExtraNoFreePairedSpectrumImbalance : ℚ :=
  higgsExtraNoFreePairedSpectrum.imbalance

/-- THEOREM 4: the no-free Higgs/extra imbalance is zero. -/
theorem higgsExtraNoFreePairedSpectrumImbalance_eq_zero :
    higgsExtraNoFreePairedSpectrumImbalance = 0 := by
  unfold higgsExtraNoFreePairedSpectrumImbalance
  exact PairedRepresentationSpectrum.imbalance_eq_zero
    higgsExtraNoFreePairedSpectrum

/-- THEOREM 5: the no-free Higgs/extra imbalance is the P877 imbalance. -/
theorem higgsExtraNoFreePairedSpectrumImbalance_eq_p877 :
    higgsExtraNoFreePairedSpectrumImbalance =
      higgsExtraPairedSpectrumImbalance := by
  rfl

/-- THEOREM 6: the no-free Higgs/extra imbalance agrees with the P856
generated Higgs/extra imbalance. -/
theorem higgsExtraNoFreePairedSpectrumImbalance_eq_generated :
    higgsExtraNoFreePairedSpectrumImbalance =
      alphaStrongHiggsExtraGeneratedImbalance := by
  rw [higgsExtraNoFreePairedSpectrumImbalance_eq_p877,
    higgsExtraPairedSpectrumImbalance_eq_generated]

/-- No-free Higgs/extra contribution. -/
def higgsExtraNoFreePairedSpectrumContribution : ℚ :=
  higgsExtraNoFreePairedSpectrumImbalance /
    canonicalAlphaStrongRepresentationSpectrumPacket.resolutionDenominator

/-- THEOREM 7: the no-free Higgs/extra contribution is zero. -/
theorem higgsExtraNoFreePairedSpectrumContribution_eq_zero :
    higgsExtraNoFreePairedSpectrumContribution = 0 := by
  unfold higgsExtraNoFreePairedSpectrumContribution
  rw [higgsExtraNoFreePairedSpectrumImbalance_eq_zero]
  norm_num

/-- THEOREM 8: the no-free Higgs/extra contribution is P877's Higgs/extra
paired-spectrum contribution. -/
theorem higgsExtraNoFreePairedSpectrumContribution_eq_p877 :
    higgsExtraNoFreePairedSpectrumContribution =
      higgsExtraPairedSpectrumContribution := by
  rw [higgsExtraNoFreePairedSpectrumContribution_eq_zero,
    higgsExtraPairedSpectrumContribution_eq_zero]

/-! ## Alpha_s vector with no-free Higgs/extra source -/

/-- Four-source vector whose Higgs/extra coordinate is generated by the
endpoint-signature-unique incidence/slot pairing. -/
def alphaStrongNoFreeHiggsExtraFourSourceVector :
    AlphaStrongResidualSource -> ℚ
  | .su7Breaking =>
      alphaStrongSMBlockIndexThresholdFourSourceVector .su7Breaking
  | .threshold =>
      alphaStrongSMBlockIndexThresholdFourSourceVector .threshold
  | .threeLoopRG =>
      alphaStrongSMBlockIndexThresholdFourSourceVector .threeLoopRG
  | .higgsExtraRepresentation => higgsExtraNoFreePairedSpectrumContribution

/-- THEOREM 9: replacing the Higgs/extra coordinate by the no-free
endpoint-signature producer leaves the P889 vector unchanged. -/
theorem alphaStrongNoFreeHiggsExtraFourSourceVector_eq_p889 :
    alphaStrongNoFreeHiggsExtraFourSourceVector =
      alphaStrongSMBlockIndexThresholdFourSourceVector := by
  funext source
  cases source
  · rfl
  · rfl
  · rfl
  · exact higgsExtraNoFreePairedSpectrumContribution_eq_p877

/-- THEOREM 10: the no-free Higgs/extra vector transports to the exact
inverse alpha_s residual. -/
theorem alphaStrongNoFreeHiggsExtraFourSourceVector_outputs_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          alphaStrongNoFreeHiggsExtraFourSourceVector s) =
      -((89000 : ℚ) / 128511) := by
  rw [alphaStrongNoFreeHiggsExtraFourSourceVector_eq_p889]
  exact alphaStrongSMBlockIndexThresholdFourSourceVector_outputs_residual

/-! ## Certificate -/

/-- P890 certificate: the Higgs/extra zero source is generated by the unique
endpoint-signature-preserving SU(7) incidence/slot pairing. -/
structure AlphaStrongNoFreeHiggsExtraProducerCertificate : Prop where
  endpoint_preserving :
    ∀ i : SU7BlockIncidence,
      generatedSlotEndpointSignature (higgsExtraPairedSpectrum.pair i) =
        SU7BlockIncidence.endpoints i
  no_free :
    ∀ e : SU7BlockIncidence ≃ SU7GeneratedCarrierSlot,
      (∀ i : SU7BlockIncidence,
        generatedSlotEndpointSignature (e i) =
          SU7BlockIncidence.endpoints i) ->
        e.toFun = higgsExtraPairedSpectrum.pair.toFun
  imbalance_zero :
    higgsExtraNoFreePairedSpectrumImbalance = 0
  imbalance_generated :
    higgsExtraNoFreePairedSpectrumImbalance =
      alphaStrongHiggsExtraGeneratedImbalance
  contribution_p877 :
    higgsExtraNoFreePairedSpectrumContribution =
      higgsExtraPairedSpectrumContribution
  vector_p889 :
    alphaStrongNoFreeHiggsExtraFourSourceVector =
      alphaStrongSMBlockIndexThresholdFourSourceVector
  inverse_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          alphaStrongNoFreeHiggsExtraFourSourceVector s) =
      -((89000 : ℚ) / 128511)

/-- THEOREM 11: canonical no-free Higgs/extra producer certificate. -/
def alphaStrongNoFreeHiggsExtraProducerCertificate :
    AlphaStrongNoFreeHiggsExtraProducerCertificate where
  endpoint_preserving := higgsExtraPairedSpectrum_endpoint_preserving
  no_free := higgsExtraEndpointPreservingPair_eq_canonical
  imbalance_zero := higgsExtraNoFreePairedSpectrumImbalance_eq_zero
  imbalance_generated := higgsExtraNoFreePairedSpectrumImbalance_eq_generated
  contribution_p877 := higgsExtraNoFreePairedSpectrumContribution_eq_p877
  vector_p889 := alphaStrongNoFreeHiggsExtraFourSourceVector_eq_p889
  inverse_residual := alphaStrongNoFreeHiggsExtraFourSourceVector_outputs_residual


end
end StandardModelConstraint
end SaturationMonoid
