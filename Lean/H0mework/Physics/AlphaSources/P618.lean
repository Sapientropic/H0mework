import H0mework.Physics.MixingSources.P617
import H0mework.Physics.AlphaSources.P613

/-!
# Proposition 618: physical finite-geometry producer for the alpha_s residual

P613 leaves the `alpha_s` residual producer debt in a sharper place: produce
the finite-geometry witness, rather than merely name `SU(7)` breaking as the
active source.

This file packages the currently machine-checked physical finite layer as one
producer:

* the SU(7) representation-physicalization receipt supplies the concrete
  block embedding, matter/anomaly carrier, and QCD one-loop `b0 = 7`;
* an embedded unified-gauge complement supplies the numerator;
* a 4D Poincare-resolution carrier supplies the denominator;
* the resulting four-source producer has threshold, three-loop-RG, and
  Higgs/extra-representation components explicitly zero on this finite layer.

Boundary: this is still not a smooth threshold spectrum, three-loop RG, or
Higgs-extra-representation dynamics calculation.  It proves that the current
finite physical signature, once supplied, is sufficient to produce the exact
inverse residual `-89000/128511` and close `alpha_s`.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

/-! ## The finite-geometry physical producer -/

/-- The alpha_s producer generated by a 4D Poincare-resolution denominator and
an embedded unified-gauge-complement numerator. -/
def alphaStrongPhysicalFiniteGeometryProducer
    (C : FourDPoincareCertificate)
    (e : UnifiedGaugeFreedomCarrier ↪ AlphaEMStructuralCarrier) :
    AlphaStrongResidualGapProducer :=
  alphaStrongPoincareResolutionResidualGapProducer C e

/-- THEOREM 1: the physical finite-geometry producer exposes the P602
contribution law on the nose. -/
theorem alphaStrongPhysicalFiniteGeometryProducer_contribution_eq
    (C : FourDPoincareCertificate)
    (e : UnifiedGaugeFreedomCarrier ↪ AlphaEMStructuralCarrier) :
    (alphaStrongPhysicalFiniteGeometryProducer C e).contribution =
      alphaStrongPoincareResolutionContribution C e := by
  rfl

/-- THEOREM 2: on this finite physical layer, the non-SU(7) roadmap residual
sources are explicitly null. -/
theorem alphaStrongPhysicalFiniteGeometryProducer_nonSU7_sources_zero
    (C : FourDPoincareCertificate)
    (e : UnifiedGaugeFreedomCarrier ↪ AlphaEMStructuralCarrier) :
    (alphaStrongPhysicalFiniteGeometryProducer C e).contribution .threshold = 0 ∧
      (alphaStrongPhysicalFiniteGeometryProducer C e).contribution .threeLoopRG = 0 ∧
        (alphaStrongPhysicalFiniteGeometryProducer C e).contribution
            .higgsExtraRepresentation = 0 := by
  change
    (alphaStrongPoincareResolutionContribution C e) .threshold = 0 ∧
      (alphaStrongPoincareResolutionContribution C e) .threeLoopRG = 0 ∧
        (alphaStrongPoincareResolutionContribution C e)
            .higgsExtraRepresentation = 0
  simp [alphaStrongPoincareResolutionContribution]

/-- THEOREM 3: the finite physical producer is on the finite SU(7) source
surface. -/
theorem alphaStrongPhysicalFiniteGeometryProducer_sourceSurface
    (C : FourDPoincareCertificate)
    (e : UnifiedGaugeFreedomCarrier ↪ AlphaEMStructuralCarrier) :
    AlphaStrongResidualProducerFiniteSourceSurface
      (alphaStrongPhysicalFiniteGeometryProducer C e) := by
  change
    AlphaStrongSU7FiniteContributionLaw
      (alphaStrongPoincareResolutionContribution C e)
  exact alphaStrongPoincareResolutionContribution_law C e

/-- THEOREM 4: the finite physical producer is also on the P613
finite-geometry witness surface. -/
theorem alphaStrongPhysicalFiniteGeometryProducer_finiteGeometrySurface
    (C : FourDPoincareCertificate)
    (e : UnifiedGaugeFreedomCarrier ↪ AlphaEMStructuralCarrier) :
    AlphaStrongResidualProducerFiniteGeometrySurface
      (alphaStrongPhysicalFiniteGeometryProducer C e) := by
  exact
    (alphaStrongResidualProducerFiniteSourceSurface_iff_finiteGeometrySurface
      (alphaStrongPhysicalFiniteGeometryProducer C e)).mp
        (alphaStrongPhysicalFiniteGeometryProducer_sourceSurface C e)

/-- THEOREM 5: the active source support of the finite physical producer is
exactly the singleton `{su7Breaking}`. -/
theorem alphaStrongPhysicalFiniteGeometryProducer_activeSupport_iff
    (C : FourDPoincareCertificate)
    (e : UnifiedGaugeFreedomCarrier ↪ AlphaEMStructuralCarrier)
    (s : AlphaStrongResidualSource) :
    AlphaStrongResidualActiveSourceSupport
        (alphaStrongPhysicalFiniteGeometryProducer C e).contribution s ↔
      s = .su7Breaking := by
  exact
    alphaStrongResidualProducer_sourceSurface_activeSupport_iff
      (alphaStrongPhysicalFiniteGeometryProducer C e)
      (alphaStrongPhysicalFiniteGeometryProducer_sourceSurface C e)
      s

/-- THEOREM 6: the finite physical producer has alpha-level gap `89/10000`. -/
theorem alphaStrongPhysicalFiniteGeometryProducer_gap
    (C : FourDPoincareCertificate)
    (e : UnifiedGaugeFreedomCarrier ↪ AlphaEMStructuralCarrier) :
    (alphaStrongPhysicalFiniteGeometryProducer C e).producedGap =
      (89 : ℚ) / 10000 := by
  exact
    alphaStrongResidualProducer_finiteGeometrySurface_gap
      (alphaStrongPhysicalFiniteGeometryProducer C e)
      (alphaStrongPhysicalFiniteGeometryProducer_finiteGeometrySurface C e)

/-- THEOREM 7: the finite physical producer transports to the exact inverse
residual `-89000/128511`. -/
theorem alphaStrongPhysicalFiniteGeometryProducer_inverseCorrection
    (C : FourDPoincareCertificate)
    (e : UnifiedGaugeFreedomCarrier ↪ AlphaEMStructuralCarrier) :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (alphaStrongPhysicalFiniteGeometryProducer C e).producedGap =
      -((89000 : ℚ) / 128511) := by
  exact
    alphaStrongResidualProducer_finiteGeometrySurface_inverseCorrection
      (alphaStrongPhysicalFiniteGeometryProducer C e)
      (alphaStrongPhysicalFiniteGeometryProducer_finiteGeometrySurface C e)

/-- THEOREM 8: the finite physical producer closes the displayed strong
coupling after inverse-coordinate transport. -/
theorem alphaStrongPhysicalFiniteGeometryProducer_closes_displayedAlpha
    (C : FourDPoincareCertificate)
    (e : UnifiedGaugeFreedomCarrier ↪ AlphaEMStructuralCarrier) :
    (1 : ℚ) /
        (alphaStrongTwoLoopSMOutputInverse ℚ +
          inverseCorrectionFromAlphaGap
            (alphaStrongTwoLoopSMOutput ℚ)
            (alphaStrongPhysicalFiniteGeometryProducer C e).producedGap) =
      alphaStrongDisplayed ℚ := by
  rw [alphaStrongPhysicalFiniteGeometryProducer_inverseCorrection C e]
  rw [← alphaStrongResidualInverseCorrectionNeeded_eq ℚ]
  exact alphaStrongResidualInverseCorrection_closes_displayedAlpha

/-! ## Bundled receipt -/

/-- Compact receipt for the current finite-geometry physical `alpha_s`
producer. -/
structure AlphaStrongPhysicalFiniteGeometryProducerReceipt
    (C : FourDPoincareCertificate)
    (e : UnifiedGaugeFreedomCarrier ↪ AlphaEMStructuralCarrier) where
  representation :
    SU7RepresentationPhysicalizationReceipt
  qcd_b0 :
    RunningSigmaBeta.betaCoeff
        RunningSigmaBeta.qcdBlockIncidenceOneLoopInput = 7
  alpha_gap_positive :
    0 < alphaStrongTwoLoopSMDisplayedGap ℚ
  non_su7_sources_zero :
    (alphaStrongPhysicalFiniteGeometryProducer C e).contribution .threshold = 0 ∧
      (alphaStrongPhysicalFiniteGeometryProducer C e).contribution .threeLoopRG = 0 ∧
        (alphaStrongPhysicalFiniteGeometryProducer C e).contribution
            .higgsExtraRepresentation = 0
  finite_geometry_surface :
    AlphaStrongResidualProducerFiniteGeometrySurface
      (alphaStrongPhysicalFiniteGeometryProducer C e)
  active_support :
    ∀ s : AlphaStrongResidualSource,
      AlphaStrongResidualActiveSourceSupport
          (alphaStrongPhysicalFiniteGeometryProducer C e).contribution s ↔
        s = .su7Breaking
  alpha_gap :
    (alphaStrongPhysicalFiniteGeometryProducer C e).producedGap =
      (89 : ℚ) / 10000
  inverse_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (alphaStrongPhysicalFiniteGeometryProducer C e).producedGap =
      -((89000 : ℚ) / 128511)
  closes_displayed_alpha :
    (1 : ℚ) /
        (alphaStrongTwoLoopSMOutputInverse ℚ +
          inverseCorrectionFromAlphaGap
            (alphaStrongTwoLoopSMOutput ℚ)
            (alphaStrongPhysicalFiniteGeometryProducer C e).producedGap) =
      alphaStrongDisplayed ℚ

/-- THEOREM 9: the bundled finite-geometry physical producer receipt. -/
noncomputable def alphaStrongPhysicalFiniteGeometryProducerReceipt
    (C : FourDPoincareCertificate)
    (e : UnifiedGaugeFreedomCarrier ↪ AlphaEMStructuralCarrier) :
    AlphaStrongPhysicalFiniteGeometryProducerReceipt C e where
  representation := su7RepresentationPhysicalizationReceipt
  qcd_b0 := su7RepresentationPhysicalizationReceipt.qcd_b0
  alpha_gap_positive :=
    su7RepresentationPhysicalizationReceipt.alpha_residual_necessity
      |>.alpha_gap_positive
  non_su7_sources_zero :=
    alphaStrongPhysicalFiniteGeometryProducer_nonSU7_sources_zero C e
  finite_geometry_surface :=
    alphaStrongPhysicalFiniteGeometryProducer_finiteGeometrySurface C e
  active_support :=
    alphaStrongPhysicalFiniteGeometryProducer_activeSupport_iff C e
  alpha_gap := alphaStrongPhysicalFiniteGeometryProducer_gap C e
  inverse_residual :=
    alphaStrongPhysicalFiniteGeometryProducer_inverseCorrection C e
  closes_displayed_alpha :=
    alphaStrongPhysicalFiniteGeometryProducer_closes_displayedAlpha C e

end StandardModelConstraint
end SaturationMonoid
