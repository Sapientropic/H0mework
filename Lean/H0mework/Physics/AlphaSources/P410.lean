import H0mework.Physics.RunningSources.P409

/-!
# Proposition 410: minimal alpha-step normal form for the holy-grail front door

P409 says a finite physical alpha-RG step certificate is sufficient for the
single-source holy-grail receipt.  This file proves the converse normal-form
direction at the current alpha-bound level: any P401 physical alpha weak-bound
can be displayed as a finite step certificate by the minimal star graph whose
only nontrivial edges are

`yukawa y  -->  weak`.

The point is not to claim this star graph is a beta-function derivation.  It is
a normal-form witness: the remaining producer obligation can be read either as
the direct alpha weak-bound or as a finite path certificate with an explicitly
non-tautological reachability relation.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

/-! ## Minimal alpha weak-bound step graph -/

/-- The minimal step graph generated by the selected alpha weak-bound rows:
each selected Yukawa scale has one edge to the weak endpoint. -/
def minimalAlphaWeakStep :
    StandardModelScaleCode -> StandardModelScaleCode -> Prop :=
  fun a b => ∃ y : YukawaParameter,
    a = StandardModelScaleCode.yukawa y ∧ b = StandardModelScaleCode.weak

/-- THEOREM 1: the minimal graph has no edge out of the GUT scale. -/
theorem not_minimalAlphaWeakStep_from_gut
    (c : StandardModelScaleCode) :
    ¬ minimalAlphaWeakStep StandardModelScaleCode.gut c := by
  rintro ⟨y, hsrc, _hdst⟩
  cases hsrc

/-- THEOREM 2: from `gut`, the minimal graph can only reach `gut` itself. -/
theorem minimalAlphaWeakStep_reach_from_gut_eq_gut
    {b : StandardModelScaleCode} :
    RGStepReach minimalAlphaWeakStep StandardModelScaleCode.gut b ->
      b = StandardModelScaleCode.gut := by
  intro h
  induction h with
  | refl =>
      rfl
  | tail hreach hbc ih =>
      subst ih
      exact False.elim (not_minimalAlphaWeakStep_from_gut _ hbc)

/-- THEOREM 3: in particular, the weak endpoint is not reachable from `gut`
in the minimal alpha weak-bound graph. -/
theorem not_minimalAlphaWeakStep_reach_gut_weak :
    ¬ RGStepReach minimalAlphaWeakStep StandardModelScaleCode.gut
      StandardModelScaleCode.weak := by
  intro h
  have hweak :
      StandardModelScaleCode.weak = StandardModelScaleCode.gut :=
    minimalAlphaWeakStep_reach_from_gut_eq_gut h
  cases hweak

/-! ## Alpha-order witness on the excluded GUT-to-weak pair -/

/-- THEOREM 4: under physical `4*pi`, the GUT endpoint alpha is the nominal
`13/1000`. -/
theorem gut_alpha_eq_sigmaGUTNominal_of_fourPi_eq
    {Index A CKMCarrier : Type*} [AddCommGroup A]
    {Z : ZeroContinuousFreeStandardModelCertificate Index A ℝ CKMCarrier}
    (hfour : Z.running.fourPi = realFourPi) :
    alphaFromGaugeCoupling realFourPi
        (Z.running.gaugeCoupling StandardModelScaleCode.gut) =
      sigmaGUTNominal ℝ := by
  calc
    alphaFromGaugeCoupling realFourPi
        (Z.running.gaugeCoupling StandardModelScaleCode.gut) =
        alphaFromGaugeCoupling Z.running.fourPi
          (Z.running.gaugeCoupling StandardModelScaleCode.gut) := by
          rw [hfour]
    _ = Z.running.sigma StandardModelScaleCode.gut := by
          exact (Z.running.sigma_eq_alpha StandardModelScaleCode.gut).symm
    _ = sigmaGUTNominal ℝ :=
          ZeroContinuousFreeStandardModelCertificate.sigma_gut_code_eq_integer_ratio Z

/-- THEOREM 5: under a physical alpha weak-bound, the alpha-order relates the
GUT endpoint to the weak endpoint.  This pair will witness that the minimal
step reachability relation is strictly not the full alpha-order relation. -/
theorem gut_alpha_le_weak_alpha_of_alphaWeakBound
    {Index A CKMCarrier : Type*} [AddCommGroup A]
    {Z : ZeroContinuousFreeStandardModelCertificate Index A ℝ CKMCarrier}
    (H : PhysicalSelectedYukawaAlphaWeakBound Z) :
    alphaFromGaugeCoupling realFourPi
        (Z.running.gaugeCoupling StandardModelScaleCode.gut) ≤
      alphaFromGaugeCoupling realFourPi
        (Z.running.gaugeCoupling StandardModelScaleCode.weak) := by
  have hgut :
      alphaFromGaugeCoupling realFourPi
          (Z.running.gaugeCoupling StandardModelScaleCode.gut) =
        sigmaGUTNominal ℝ :=
    gut_alpha_eq_sigmaGUTNominal_of_fourPi_eq (Z := Z) H.1
  have hweak :
      alphaFromGaugeCoupling realFourPi
          (Z.running.gaugeCoupling StandardModelScaleCode.weak) =
        sigmaWeakNominal ℝ :=
    PhysicalAlphaRGMonotonicityProducer.weak_alpha_eq_sigmaWeakNominal_of_fourPi_eq
      (Z := Z) H.1
  rw [hgut, hweak]
  exact le_of_lt (sigmaGUTNominal_lt_sigmaWeakNominal ℝ)

/-! ## Physical alpha weak-bound as a finite step certificate -/

/-- THEOREM 6: the minimal graph's reachability relation is not the target
alpha-order relation whenever the physical alpha weak-bound holds. -/
theorem minimalAlphaWeakStep_reach_not_alpha_order
    {Index A CKMCarrier : Type*} [AddCommGroup A]
    {Z : ZeroContinuousFreeStandardModelCertificate Index A ℝ CKMCarrier}
    (H : PhysicalSelectedYukawaAlphaWeakBound Z) :
    RGStepReach minimalAlphaWeakStep ≠
      fun a b : StandardModelScaleCode =>
        alphaFromGaugeCoupling realFourPi (Z.running.gaugeCoupling a) ≤
          alphaFromGaugeCoupling realFourPi (Z.running.gaugeCoupling b) := by
  intro hrel
  have hα :
      alphaFromGaugeCoupling realFourPi
          (Z.running.gaugeCoupling StandardModelScaleCode.gut) ≤
        alphaFromGaugeCoupling realFourPi
          (Z.running.gaugeCoupling StandardModelScaleCode.weak) :=
    gut_alpha_le_weak_alpha_of_alphaWeakBound (Z := Z) H
  have hreach :
      RGStepReach minimalAlphaWeakStep StandardModelScaleCode.gut
        StandardModelScaleCode.weak := by
    simpa [hrel] using hα
  exact not_minimalAlphaWeakStep_reach_gut_weak hreach

/-- THEOREM 7: a physical alpha weak-bound supplies P409's finite alpha-RG
step producer in minimal normal form. -/
def PhysicalSelectedYukawaAlphaWeakBound.toPhysicalAlphaRGStepPathProducer
    {Index A CKMCarrier : Type*} [AddCommGroup A]
    {Z : ZeroContinuousFreeStandardModelCertificate Index A ℝ CKMCarrier}
    (H : PhysicalSelectedYukawaAlphaWeakBound Z) :
    PhysicalAlphaRGStepPathProducer Z :=
  { step := minimalAlphaWeakStep
    reach_not_alpha_order :=
      minimalAlphaWeakStep_reach_not_alpha_order (Z := Z) H
    fourPi_eq_realFourPi := H.1
    selected_yukawa_reaches_weak := by
      intro y
      exact RGStepReach.tail (RGStepReach.refl _)
        ⟨y, rfl, rfl⟩
    step_alpha_monotone := by
      intro a b hab
      rcases hab with ⟨y, hsrc, hdst⟩
      subst hsrc
      subst hdst
      have hweak :
          alphaFromGaugeCoupling realFourPi
              (Z.running.gaugeCoupling StandardModelScaleCode.weak) =
            sigmaWeakNominal ℝ :=
        PhysicalAlphaRGMonotonicityProducer.weak_alpha_eq_sigmaWeakNominal_of_fourPi_eq
          (Z := Z) H.1
      simpa [hweak] using H.2 y }

/-! ## Exact existence-level normal forms -/

/-- THEOREM 8: the direct alpha weak-bound produces the finite physical
alpha-RG step certificate. -/
theorem existsZeroFreePhysicalAlphaRGStepPathProducer_of_alphaWeakBound
    {Index A CKMCarrier : Type*} [AddCommGroup A] :
    ExistsZeroFreePhysicalSelectedYukawaAlphaWeakBound Index A CKMCarrier ->
      ExistsZeroFreePhysicalAlphaRGStepPathProducer Index A CKMCarrier := by
  rintro ⟨Z, H⟩
  exact ⟨Z, ⟨H.toPhysicalAlphaRGStepPathProducer⟩⟩

/-- THEOREM 9: a finite physical alpha-RG step certificate also gives the
direct alpha weak-bound. -/
theorem existsZeroFreePhysicalSelectedYukawaAlphaWeakBound_of_alphaRGStepPath
    {Index A CKMCarrier : Type*} [AddCommGroup A] :
    ExistsZeroFreePhysicalAlphaRGStepPathProducer Index A CKMCarrier ->
      ExistsZeroFreePhysicalSelectedYukawaAlphaWeakBound Index A CKMCarrier :=
  existsZeroFreePhysicalSelectedYukawaAlphaWeakBound_of_physicalAlphaRGMonotonicity ∘
    existsZeroFreePhysicalAlphaRGMonotonicityProducer_of_alphaRGStepPath

/-- THEOREM 10: exact normal form.  The finite physical alpha-RG step surface
is equivalent to the direct P401 alpha weak-bound surface. -/
theorem alphaRGStepPath_iff_alphaWeakBound
    {Index A CKMCarrier : Type*} [AddCommGroup A] :
    ExistsZeroFreePhysicalAlphaRGStepPathProducer Index A CKMCarrier ↔
      ExistsZeroFreePhysicalSelectedYukawaAlphaWeakBound Index A CKMCarrier := by
  constructor
  · exact existsZeroFreePhysicalSelectedYukawaAlphaWeakBound_of_alphaRGStepPath
  · exact existsZeroFreePhysicalAlphaRGStepPathProducer_of_alphaWeakBound

/-- THEOREM 11: exact front-door normal form.  P404's physical alpha-RG
monotonicity surface is equivalent to the direct P401 physical alpha
weak-bound surface. -/
theorem physicalAlphaRGMonotonicity_iff_alphaWeakBound
    {Index A CKMCarrier : Type*} [AddCommGroup A] :
    ExistsZeroFreePhysicalAlphaRGMonotonicityProducer Index A CKMCarrier ↔
      ExistsZeroFreePhysicalSelectedYukawaAlphaWeakBound Index A CKMCarrier := by
  constructor
  · exact existsZeroFreePhysicalSelectedYukawaAlphaWeakBound_of_physicalAlphaRGMonotonicity
  · exact
      existsZeroFreePhysicalAlphaRGMonotonicityProducer_of_alphaRGStepPath ∘
        existsZeroFreePhysicalAlphaRGStepPathProducer_of_alphaWeakBound

/-- THEOREM 12: receipt-level exact normal form against the direct P401
physical alpha weak-bound. -/
theorem singleSourcePhysicalHolyGrailReceipt_nonempty_iff_alphaWeakBound
    {Index A CKMCarrier : Type*} [AddCommGroup A] :
    Nonempty
        (SingleSourcePhysicalGrandUnificationHolyGrailReceipt
          Index A CKMCarrier) ↔
      ExistsZeroFreePhysicalSelectedYukawaAlphaWeakBound
        Index A CKMCarrier := by
  exact
    singleSourcePhysicalHolyGrailReceipt_nonempty_iff_physicalAlphaRGMonotonicity.trans
      physicalAlphaRGMonotonicity_iff_alphaWeakBound

/-- THEOREM 13: compact single-source holy-grail receipt directly from the
P401 physical alpha weak-bound. -/
theorem alphaWeakBound_singleSource_holy_grail_receipt
    {Index A CKMCarrier : Type*} [AddCommGroup A] :
    ExistsZeroFreePhysicalSelectedYukawaAlphaWeakBound Index A CKMCarrier ->
      ∃ C : SingleSourcePhysicalGrandUnificationHolyGrailReceipt
          Index A CKMCarrier,
        C.receipt.zeroFree = C.atoms.toZeroFree ∧
        HEq C.receipt.rg
          C.physicalRG.toSelectedYukawaRGMonotonicityCertificate ∧
        C.receipt.spine = C.atoms.toUnifiedFormulaSpine ∧
        C.receipt.primitiveAtoms = C.atoms ∧
        C.receipt.spine.target.sampled.zeroFree = C.atoms.toZeroFree ∧
        alphaEMFromIntegerConstraint ℝ = (1 : ℝ) / (137 : ℝ) ∧
        gutWeakMixingFromStructuralCards ℝ = threeEighths ℝ ∧
        alphaGUTInverseFromStructuralCards ℝ = ((133 : ℝ) / (3 : ℝ)) ∧
        C.receipt.spine.target.strongResidualProducer.correctedOutput =
          alphaStrongDisplayed ℝ ∧
        (ckmCPDepthSum : ℝ) * C.receipt.spine.target.cpRunningSigma =
          cpRawPhaseClaim ℝ := by
  intro h
  exact
    physicalAlphaRGStepPath_singleSource_holy_grail_receipt
      (existsZeroFreePhysicalAlphaRGStepPathProducer_of_alphaWeakBound h)

end StandardModelConstraint
end SaturationMonoid
