import H0mework.Physics.LowEnergyEvolution.Geometry
import H0mework.Physics.SpinPair.DiracActual
import H0mework.Physics.SpinPair.Adjoint

/-! Derivatives of both actual spin fields retain the dilution generated by
the moving spatial coframe. -/
set_option autoImplicit false
namespace SaturationMonoid.PhysicsCore.LowEnergy.Evolution
open ProofFreeRicherAnholonomicSource StageNineHolonomicField StageNineGlobalIntegratedAction
open StageNineEnrichedProofFreeSource Stage9C.Material.SpinPair
open DiracCliffordRepresentation DiracExteriorMatterAction
noncomputable section

theorem dilution_hasDerivAt (a : ℝ) (positive : 0 < a) :
    HasDerivAt dilution (-3/(2*a)*dilution a) a := by
  have rootPositive := Real.sqrt_pos.2 positive
  have derivative := ((hasDerivAt_id a).mul (Real.hasDerivAt_sqrt (ne_of_gt positive))).inv
    (mul_ne_zero (ne_of_gt positive) (ne_of_gt rootPositive))
  convert derivative using 1 <;> first | rfl | skip
  · dsimp [dilution]
    field_simp [ne_of_gt positive, ne_of_gt rootPositive]
    nlinarith [Real.sq_sqrt (le_of_lt positive)]

def dilutionRate (x : State) : ℝ := -3*clock x*x 1/(2*x 0)

def spinAmplitude (sign : ℝ) (x : State) : ℂ :=
  (dilution (x 0) : ℂ) * Complex.exp ((sign : ℂ)*Complex.I*(x 6 : ℂ))

def spinVelocity (sign : ℝ) (x : State) : ℂ :=
  ((dilutionRate x : ℂ) + (sign : ℂ)*Complex.I*(generator x 6 : ℂ)) * spinAmplitude sign x

theorem Solution.spinAmplitude_derivative {initial : State} (flow : Solution initial)
    (sign time : ℝ) (inside : time ∈ Set.Ioo (-flow.radius) flow.radius) :
    HasDerivAt (fun t => spinAmplitude sign (flow.curve t))
      (spinVelocity sign (flow.curve time)) time := by
  have amplitude := (dilution_hasDerivAt _ (flow.admissible time inside).1).comp time
    (flow.coordinate_derivative time inside 0)
  have phase := ((flow.coordinate_derivative time inside 6).ofReal_comp.const_mul
    ((sign : ℂ)*Complex.I)).cexp
  convert amplitude.ofReal_comp.mul phase using 1 <;> first | rfl | skip
  · dsimp [spinVelocity, spinAmplitude, dilutionRate, generator]
    push_cast
    ring

theorem spinPairCoefficients_derivative {upper lower : ℝ → ℂ} {du dv : ℂ} {time : ℝ}
    (hu : HasDerivAt upper du time) (hv : HasDerivAt lower dv time) :
    HasDerivAt (fun t => spinPairCoefficients (upper t) (lower t))
      (spinPairCoefficients du dv) time := by
  apply hasDerivAt_pi.mpr
  intro row
  apply hasDerivAt_pi.mpr
  intro col
  fin_cases row <;> fin_cases col <;>
    simp only [spinPairCoefficients, Matrix.of_apply]
  all_goals first | exact hu | exact hv | exact hu.neg | exact hv.neg | exact hasDerivAt_const _ _

theorem spinPairCoordinates_derivative {upper lower : ℝ → ℂ} {du dv : ℂ} {time : ℝ}
    (hu : HasDerivAt upper du time) (hv : HasDerivAt lower dv time) :
    HasDerivAt (fun t => matterCoordinateEquiv (spinPairMatter (upper t) (lower t)))
      (matterCoordinateEquiv (spinPairMatter du dv)) time :=
  (sourceColorMatterCoordinateLinear.restrictScalars ℝ).toContinuousLinearMap.hasFDerivAt.comp_hasDerivAt
    time (spinPairCoefficients_derivative hu hv)

private def dualEvaluationLinear (matter : DiracExteriorMatterCarrier) :
    (DiracSpinorIndex → Fin 2 → ℂ) →ₗ[ℂ] ℂ where
  toFun coefficients := ∑ spin, ∑ state,
    coefficients spin state * sourceColorDoubletDual state (matter spin)
  map_add' := by
    intro first second
    simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]
  map_smul' := by
    intro coefficient values
    simp only [Pi.smul_apply, smul_eq_mul, Finset.mul_sum, RingHom.id_apply]
    apply Finset.sum_congr rfl
    intro spin _
    apply Finset.sum_congr rfl
    intro state _
    ring

theorem spinPairDual_derivative {upper lower : ℝ → ℂ} {du dv : ℂ} {time : ℝ}
    (hu : HasDerivAt upper du time) (hv : HasDerivAt lower dv time)
    (matter : DiracExteriorMatterCarrier) :
    HasDerivAt (fun t => spinPairDual (upper t) (lower t) matter)
      (spinPairDual du dv matter) time :=
  ((dualEvaluationLinear matter).restrictScalars ℝ).toContinuousLinearMap.hasFDerivAt.comp_hasDerivAt
    time (spinPairCoefficients_derivative hu hv)

theorem Solution.matter {initial : State} (flow : Solution initial) (point : BasePoint) :
    flow.configuration.matter point =
      spinPairMatter (spinAmplitude 1 (flow.pointState point)) (spinAmplitude (-1) (flow.pointState point)) := by
  change spinPairMatter _ _ = _
  simp [spinAmplitude]

theorem Solution.dual {initial : State} (flow : Solution initial) (point : BasePoint) :
    flow.configuration.conjugateMatter point =
      spinPairDual ((spinScale : ℂ)*spinAmplitude 1 (flow.pointState point))
        ((spinScale : ℂ)*spinAmplitude (-1) (flow.pointState point)) := by
  change spinPairDual _ _ = _
  simp [spinAmplitude, mul_assoc]

theorem Solution.matter_derivative {initial : State} (flow : Solution initial)
    (point : BasePoint) (inside : point 0 ∈ Set.Ioo (-flow.radius) flow.radius) (mu : LorentzianIndex) :
    matterCoordinateEquiv.symm (fieldDirectionalDerivative
      (fun p => matterCoordinateEquiv (flow.configuration.matter p)) point mu) =
      if mu = 0 then spinPairMatter (spinVelocity 1 (flow.pointState point))
        (spinVelocity (-1) (flow.pointState point)) else 0 := by
  have derivative := spinPairCoordinates_derivative
    (flow.spinAmplitude_derivative 1 (point 0) inside)
    (flow.spinAmplitude_derivative (-1) (point 0) inside)
  simp_rw [flow.matter]
  unfold fieldDirectionalDerivative Solution.pointState
  rw [time_fderiv_apply _ _ point derivative mu]
  split_ifs <;> simp

theorem Solution.dual_derivative {initial : State} (flow : Solution initial)
    (point : BasePoint) (inside : point 0 ∈ Set.Ioo (-flow.radius) flow.radius)
    (mu : LorentzianIndex) (matter : DiracExteriorMatterCarrier) :
    fieldDirectionalDerivative (fun p => flow.configuration.conjugateMatter p matter) point mu =
      if mu = 0 then spinPairDual ((spinScale : ℂ)*spinVelocity 1 (flow.pointState point))
        ((spinScale : ℂ)*spinVelocity (-1) (flow.pointState point)) matter else 0 := by
  have derivative := spinPairDual_derivative
    ((flow.spinAmplitude_derivative 1 (point 0) inside).const_mul (spinScale : ℂ))
    ((flow.spinAmplitude_derivative (-1) (point 0) inside).const_mul (spinScale : ℂ)) matter
  simp_rw [flow.dual]
  exact time_fderiv_apply _ _ point derivative mu

end
end SaturationMonoid.PhysicsCore.LowEnergy.Evolution
