import H0mework.Physics.BranchSources.P908

/-!
# Proposition 909: tensor confinement produces non-storing physical branch cells

P873 introduced the desired physical objects:

* `SU7Atom`;
* `SU7PhysicalBranchCell`;
* `physicalResidual`;
* `SU7ConfinementDynamics`.

P878 then showed the global projection theorem

```lean
∀ a : SU7Atom, Nat.Prime (atomCode a)
```

cannot be proved while the project-wide irreducibility predicate is still the
placeholder `True`.

This file gives the hard producer shape that does not smuggle Goldbach back
into the premise.  A finite tensor-irreducible bounded energy shell produces a
zero-residual tensor cell by P908.  That tensor cell is then forgotten to a
plain `SU7PhysicalBranchCell`.  The cell itself stores no `Nat.Prime`,
`PrimeExponent`, or Goldbach pair; primality is proved only for the generated
left/right atoms from their tensor-irreducibility witnesses.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open SaturationMonoid.AffineRelaxation

set_option linter.defProp false

/-! ## Forgetting tensor cells to P873 physical branch cells -/

/-- Forget a tensor-irreducible branch-spectrum cell all the way down to the
P873 physical branch-cell interface.

The resulting object has only physical SU(7) atoms and a gauge-allowed color
loop.  It stores no prime-valued data. -/
def physicalBranchCell_of_tensorIrreducibleCell
    {C : SU7WeightTensorCoding} {n : ℕ}
    (B : SU7TensorIrreducibleBranchingSpectrumCell C n) :
    SU7PhysicalBranchCell n :=
  physicalBranchCell_of_physicalSpectrumCell
    (physicalBranchingSpectrumCell_of_tensorIrreducibleCell B)

/-- The P873 physical residual of the forgotten cell is exactly the raw
tensor-irreducible residual. -/
theorem physicalResidual_tensorIrreducibleCell_eq
    {C : SU7WeightTensorCoding} {n : ℕ}
    (B : SU7TensorIrreducibleBranchingSpectrumCell C n) :
    physicalResidual (physicalBranchCell_of_tensorIrreducibleCell B) =
      tensorIrreducibleBranchingSpectrumResidual B := by
  rfl

/-- The left atom generated by a tensor-irreducible cell projects to a prime
raw atom code. -/
theorem tensorPhysicalBranchCell_left_atomCode_prime
    {C : SU7WeightTensorCoding} {n : ℕ}
    (B : SU7TensorIrreducibleBranchingSpectrumCell C n) :
    Nat.Prime
      (atomCode (physicalBranchCell_of_tensorIrreducibleCell B).leftAtom) := by
  simpa [physicalBranchCell_of_tensorIrreducibleCell,
    physicalBranchCell_of_physicalSpectrumCell,
    physicalBranchingSpectrumCell_of_tensorIrreducibleCell] using
    (tensorIrreducibleAtom_atomCode_prime B.leftAtom)

/-- The right atom generated by a tensor-irreducible cell projects to a prime
raw atom code. -/
theorem tensorPhysicalBranchCell_right_atomCode_prime
    {C : SU7WeightTensorCoding} {n : ℕ}
    (B : SU7TensorIrreducibleBranchingSpectrumCell C n) :
    Nat.Prime
      (atomCode (physicalBranchCell_of_tensorIrreducibleCell B).rightAtom) := by
  simpa [physicalBranchCell_of_tensorIrreducibleCell,
    physicalBranchCell_of_physicalSpectrumCell,
    physicalBranchingSpectrumCell_of_tensorIrreducibleCell] using
    (tensorIrreducibleAtom_atomCode_prime B.rightAtom)

/-- Zero tensor residual gives a zero P873 physical residual after forgetting.
-/
theorem physicalResidual_zero_of_tensorIrreducibleCell
    {C : SU7WeightTensorCoding} {n : ℕ}
    (B : SU7TensorIrreducibleBranchingSpectrumCell C n)
    (hzero : tensorIrreducibleBranchingSpectrumResidual B = 0) :
    physicalResidual (physicalBranchCell_of_tensorIrreducibleCell B) = 0 := by
  simpa [physicalResidual_tensorIrreducibleCell_eq B] using hzero

/-! ## Generated physical zero cells -/

/-- A physical branch cell generated by tensor confinement, together with the
local faithful projection facts for its two atoms.

This package is deliberately local.  P878 proves that the global theorem for
all placeholder `SU7Atom`s is false; tensor confinement only certifies the atoms
it actually generates. -/
structure SU7GeneratedPhysicalZeroBranchCell (n : ℕ) where
  cell : SU7PhysicalBranchCell n
  residual_zero : physicalResidual cell = 0
  left_atomCode_prime : Nat.Prime (atomCode cell.leftAtom)
  right_atomCode_prime : Nat.Prime (atomCode cell.rightAtom)

/-- The generated physical zero cell has arithmetic balance under raw
`atomCode`. -/
theorem SU7GeneratedPhysicalZeroBranchCell.sum_eq
    {n : ℕ} (G : SU7GeneratedPhysicalZeroBranchCell n) :
    atomCode G.cell.leftAtom + atomCode G.cell.rightAtom = 2 * n :=
  physicalResidual_zero_to_sum G.cell G.residual_zero

/-- A generated physical zero cell computes a trace-zero prime-edge loop only
after the local atom-code primality proofs are projected out. -/
def traceZeroPrimeEdgeLoop_of_generatedPhysicalZeroBranchCell
    {n : ℕ} (G : SU7GeneratedPhysicalZeroBranchCell n) :
    TraceZeroPrimeEdgeLoop n :=
  traceZeroPrimeEdgeLoop_of_branchWeight
    { branch := SU3FlagSchubertCell.e
      leftPrime := ⟨atomCode G.cell.leftAtom, G.left_atomCode_prime⟩
      rightPrime := ⟨atomCode G.cell.rightAtom, G.right_atomCode_prime⟩ }
    ((branchWeightResidual_eq_zero_iff_traceNeutral
      { branch := SU3FlagSchubertCell.e
        leftPrime := ⟨atomCode G.cell.leftAtom, G.left_atomCode_prime⟩
        rightPrime := ⟨atomCode G.cell.rightAtom, G.right_atomCode_prime⟩ }).mp
      (by
        change (((atomCode G.cell.leftAtom + atomCode G.cell.rightAtom : ℕ) : ℤ) -
          ((2 * n : ℕ) : ℤ) = 0)
        exact G.residual_zero))

/-- A bounded tensor energy shell computes a non-storing physical zero branch
cell.  No prime data is stored in the shell or tensor cell; the two prime
proofs are produced from tensor irreducibility at the final projection
boundary. -/
def generatedPhysicalZeroBranchCell_of_tensorIrreducibleBoundedEnergyShell
    {C : SU7WeightTensorCoding} {n : ℕ}
    (L : SU7TensorIrreducibleBoundedEnergyShell C n) :
    SU7GeneratedPhysicalZeroBranchCell n :=
  let Z := Classical.choose
    (exists_zeroCell_of_tensorIrreducibleBoundedEnergyShell L)
  let hZ := Classical.choose_spec
    (exists_zeroCell_of_tensorIrreducibleBoundedEnergyShell L)
  { cell := physicalBranchCell_of_tensorIrreducibleCell Z
    residual_zero :=
      physicalResidual_zero_of_tensorIrreducibleCell Z hZ.2.2
    left_atomCode_prime :=
      tensorPhysicalBranchCell_left_atomCode_prime Z
    right_atomCode_prime :=
      tensorPhysicalBranchCell_right_atomCode_prime Z }

/-- A bounded tensor energy shell computes the trace-zero prime-edge loop via
the generated physical cell projection. -/
def traceZeroPrimeEdgeLoop_of_tensorIrreducibleBoundedEnergyShell_physical
    {C : SU7WeightTensorCoding} {n : ℕ}
    (L : SU7TensorIrreducibleBoundedEnergyShell C n) :
    TraceZeroPrimeEdgeLoop n :=
  traceZeroPrimeEdgeLoop_of_generatedPhysicalZeroBranchCell
    (generatedPhysicalZeroBranchCell_of_tensorIrreducibleBoundedEnergyShell L)

/-! ## Fiberwise dynamics readout -/

/-- Every even fiber carries generated physical zero cells when every even
fiber carries a bounded tensor-irreducible energy shell. -/
def generatedPhysicalZeroBranchCellEveryEvenFiber_of_tensorShells
    {C : SU7WeightTensorCoding}
    (H : SU7TensorIrreducibleBoundedEnergyShellEveryEvenFiber C) :
    ∀ n : ℕ, 2 ≤ n -> SU7GeneratedPhysicalZeroBranchCell n := by
  intro n hn
  exact
    generatedPhysicalZeroBranchCell_of_tensorIrreducibleBoundedEnergyShell
      (Classical.choice (H n hn))

/-- Fiberwise bounded tensor shells give trace-zero prime-edge loops through
the non-storing P873 physical cell interface. -/
def traceZeroPrimeEdgeLoopEveryEvenFiber_of_tensorShells_physical
    {C : SU7WeightTensorCoding}
    (H : SU7TensorIrreducibleBoundedEnergyShellEveryEvenFiber C) :
    ∀ n : ℕ, 2 ≤ n -> TraceZeroPrimeEdgeLoop n := by
  intro n hn
  exact
    traceZeroPrimeEdgeLoop_of_generatedPhysicalZeroBranchCell
      (generatedPhysicalZeroBranchCellEveryEvenFiber_of_tensorShells H n hn)

/-- Fiberwise bounded tensor shells give ordinary even Goldbach through the
non-storing physical branch-cell projection. -/
theorem evenGoldbach_of_tensorShells_generatedPhysicalCells
    {C : SU7WeightTensorCoding}
    (H : SU7TensorIrreducibleBoundedEnergyShellEveryEvenFiber C) :
    EvenGoldbachStatement :=
  evenGoldbach_of_traceZeroPrimeEdgeLoopEveryEvenFiber
    (traceZeroPrimeEdgeLoopEveryEvenFiber_of_tensorShells_physical H)

/-! ## Certificate -/

/-- P909 certificate: tensor confinement produces the requested P873-style
physical branch cells first, and only then projects their generated atom codes
to prime edges. -/
structure SU7TensorConfinementPhysicalBranchProducerCertificate where
  forget_tensor_cell :
    ∀ {C : SU7WeightTensorCoding} {n : ℕ},
      SU7TensorIrreducibleBranchingSpectrumCell C n ->
        SU7PhysicalBranchCell n
  residual_preserved :
    ∀ {C : SU7WeightTensorCoding} {n : ℕ}
      (B : SU7TensorIrreducibleBranchingSpectrumCell C n),
      physicalResidual (physicalBranchCell_of_tensorIrreducibleCell B) =
        tensorIrreducibleBranchingSpectrumResidual B
  left_prime_generated :
    ∀ {C : SU7WeightTensorCoding} {n : ℕ}
      (B : SU7TensorIrreducibleBranchingSpectrumCell C n),
      Nat.Prime
        (atomCode (physicalBranchCell_of_tensorIrreducibleCell B).leftAtom)
  right_prime_generated :
    ∀ {C : SU7WeightTensorCoding} {n : ℕ}
      (B : SU7TensorIrreducibleBranchingSpectrumCell C n),
      Nat.Prime
        (atomCode (physicalBranchCell_of_tensorIrreducibleCell B).rightAtom)
  tensor_shell_to_generated_physical_zero :
    ∀ {C : SU7WeightTensorCoding} {n : ℕ},
      SU7TensorIrreducibleBoundedEnergyShell C n ->
        SU7GeneratedPhysicalZeroBranchCell n
  generated_zero_to_trace_zero :
    ∀ {n : ℕ}, SU7GeneratedPhysicalZeroBranchCell n ->
      TraceZeroPrimeEdgeLoop n
  every_fiber_to_goldbach :
    ∀ {C : SU7WeightTensorCoding},
      SU7TensorIrreducibleBoundedEnergyShellEveryEvenFiber C ->
        EvenGoldbachStatement

/-- Canonical P909 producer certificate. -/
def su7TensorConfinementPhysicalBranchProducerCertificate :
    SU7TensorConfinementPhysicalBranchProducerCertificate where
  forget_tensor_cell := physicalBranchCell_of_tensorIrreducibleCell
  residual_preserved := physicalResidual_tensorIrreducibleCell_eq
  left_prime_generated := tensorPhysicalBranchCell_left_atomCode_prime
  right_prime_generated := tensorPhysicalBranchCell_right_atomCode_prime
  tensor_shell_to_generated_physical_zero :=
    generatedPhysicalZeroBranchCell_of_tensorIrreducibleBoundedEnergyShell
  generated_zero_to_trace_zero :=
    traceZeroPrimeEdgeLoop_of_generatedPhysicalZeroBranchCell
  every_fiber_to_goldbach :=
    evenGoldbach_of_tensorShells_generatedPhysicalCells


end
end StandardModelConstraint
end SaturationMonoid
