import H0mework.Arithmetic.PrimeShadow.P925

/-!
# Proposition 926: explicit finite raw SU(7) branch-spectrum generator

P925 lowered endpoint certificates to Boolean factor checks.  This file lowers
the list object itself: for a fiber `n` and a raw-code bound, Lean enumerates

* all six `SU(3)` Schubert branch cells;
* all six `3+2+1+1` SU(7) block incidences;
* all raw endpoint-code pairs below the bound;

then keeps exactly the endpoint pairs whose multiplicative-atomicity check
succeeds.  The resulting finite list feeds P925.  The residual-energy bound is
computed from the generated spectrum by a recursive maximum, not supplied as a
separate proof field.

The remaining producer datum is now the real finite check:

```text
start cell is in the generated spectrum
rawBranchingEnergyShellCoverageCheck generatedSpectrum computedMaxEnergy = true
```
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open SaturationMonoid.AffineRelaxation
open RunningSigmaBeta

set_option linter.defProp false
set_option linter.unusedVariables false

/-! ## Explicit finite branch/incidence/code enumeration -/

namespace SU7BlockIncidence

/-- The six concrete SU(7) block-incidence slots. -/
def all : List SU7BlockIncidence :=
  [.colorWeak, .colorPositiveSinglet, .colorNegativeSinglet,
    .weakPositiveSinglet, .weakNegativeSinglet, .positiveNegativeSinglet]

end SU7BlockIncidence

/-- Raw endpoint codes enumerated up to and including `bound`. -/
def rawCodeBoundedList (bound : ℕ) : List ℕ :=
  List.range (bound + 1)

/-- All raw branching-decomposition candidates generated from the color
Schubert cells, SU(7) incidence slots, and endpoint-code bound. -/
def rawBranchingCandidateCells (n bound : ℕ) :
    List (SU7BranchingDecompositionCell n) :=
  List.flatMap (fun branch =>
    List.flatMap (fun incidence =>
      List.flatMap (fun leftCode =>
        (rawCodeBoundedList bound).map fun rightCode =>
          { branch := branch
            incidence := incidence
            leftWeightCode := leftCode
            rightWeightCode := rightCode })
        (rawCodeBoundedList bound))
      SU7BlockIncidence.all)
    SU3FlagSchubertCell.all

/-- One candidate becomes a Boolean atomic raw cell exactly when both endpoint
codes pass the finite multiplicative-atomicity checker. -/
def booleanAtomicCellOfCandidate?
    {n : ℕ} (c : SU7BranchingDecompositionCell n) :
    Option (SU7BooleanAtomicRawBranchingCell n) :=
  if hleft : natMultiplicativelyAtomicCheck c.leftWeightCode = true then
    if hright : natMultiplicativelyAtomicCheck c.rightWeightCode = true then
      some
        { cell := c
          left_check := hleft
          right_check := hright }
    else
      none
  else
    none

/-- Generated Boolean atomic raw branch cells from the explicit finite
candidate space. -/
def booleanAtomicRawBranchingCandidateList (n bound : ℕ) :
    List (SU7BooleanAtomicRawBranchingCell n) :=
  (rawBranchingCandidateCells n bound).filterMap
    booleanAtomicCellOfCandidate?

/-- The P922/P923/P925 raw spectrum generated by the explicit candidate list.
-/
def booleanGeneratedRawBranchingSpectrum (n bound : ℕ) :
    SU7BranchingDecompositionSpectrum n :=
  rawBranchingSpectrum_of_certifiedCells
    (certifiedRawBranchingCells_of_atomicRawBranchingCells
      (atomicRawBranchingCells_of_booleanAtomicCells
        (booleanAtomicRawBranchingCandidateList n bound)))

/-! ## Computed residual-energy bound -/

/-- Recursive maximum residual energy of a finite raw branch-cell list. -/
def maxRawResidualEnergyOfCells
    {n : ℕ} : List (SU7BranchingDecompositionCell n) -> ℕ
  | [] => 0
  | c :: cs =>
      max (rawAtomCodeBranchingDecompositionResidualEnergy c)
        (maxRawResidualEnergyOfCells cs)

/-- Every member of a finite raw list is bounded by the recursive maximum. -/
theorem rawResidualEnergy_le_maxRawResidualEnergyOfCells
    {n : ℕ} {xs : List (SU7BranchingDecompositionCell n)}
    {c : SU7BranchingDecompositionCell n}
    (hmem : c ∈ xs) :
    rawAtomCodeBranchingDecompositionResidualEnergy c ≤
      maxRawResidualEnergyOfCells xs := by
  induction xs with
  | nil =>
      simp at hmem
  | cons x xs ih =>
      rw [List.mem_cons] at hmem
      rw [maxRawResidualEnergyOfCells]
      rcases hmem with hcx | hmem_tail
      · subst c
        exact Nat.le_max_left
          (rawAtomCodeBranchingDecompositionResidualEnergy x)
          (maxRawResidualEnergyOfCells xs)
      · exact Nat.le_trans (ih hmem_tail)
          (Nat.le_max_right
            (rawAtomCodeBranchingDecompositionResidualEnergy x)
            (maxRawResidualEnergyOfCells xs))

/-- Computed maximum energy of the explicitly generated spectrum. -/
def generatedRawBranchingMaxEnergy (n bound : ℕ) : ℕ :=
  maxRawResidualEnergyOfCells
    (booleanGeneratedRawBranchingSpectrum n bound).cells

/-- The generated maximum is a valid energy bound for the generated spectrum.
-/
theorem generatedRawBranching_energy_bound
    {n bound : ℕ} :
    ∀ c : SU7BranchingDecompositionCell n,
      c ∈ (booleanGeneratedRawBranchingSpectrum n bound).cells ->
        rawAtomCodeBranchingDecompositionResidualEnergy c ≤
          generatedRawBranchingMaxEnergy n bound := by
  intro c hmem
  exact rawResidualEnergy_le_maxRawResidualEnergyOfCells hmem

/-! ## Generated checked-list certificates -/

/-- A generated Boolean raw-branching coverage certificate.

The cell list and energy bound are computed from `n` and `codeBound`.  The only
remaining finite obligations are start membership and the Boolean energy-shell
coverage check. -/
structure SU7GeneratedBooleanRawBranchingCoverageCertificate (n : ℕ) where
  codeBound : ℕ
  startCell : SU7BranchingDecompositionCell n
  start_mem :
    startCell ∈
      (booleanGeneratedRawBranchingSpectrum n codeBound).cells
  coverage_check :
    rawBranchingEnergyShellCoverageCheck
      (booleanGeneratedRawBranchingSpectrum n codeBound)
      (generatedRawBranchingMaxEnergy n codeBound) = true

/-- A generated coverage certificate feeds P925's Boolean checked-list
interface. -/
def booleanAtomicCheckedCellList_of_generatedCoverageCertificate
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    SU7BooleanAtomicRawBranchingCheckedCellList n where
  cells := booleanAtomicRawBranchingCandidateList n G.codeBound
  startCell := G.startCell
  start_mem := G.start_mem
  maxEnergy := generatedRawBranchingMaxEnergy n G.codeBound
  energy_bound := generatedRawBranching_energy_bound
  coverage_check := G.coverage_check

/-- A generated coverage certificate computes a generated physical zero branch
cell. -/
def generatedPhysicalZeroBranchCell_of_generatedCoverageCertificate
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    SU7GeneratedPhysicalZeroBranchCell n :=
  generatedPhysicalZeroBranchCell_of_booleanAtomicCheckedCellList
    (booleanAtomicCheckedCellList_of_generatedCoverageCertificate G)

/-- A generated coverage certificate computes a trace-zero prime-edge loop. -/
def traceZeroPrimeEdgeLoop_of_generatedCoverageCertificate
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    TraceZeroPrimeEdgeLoop n :=
  traceZeroPrimeEdgeLoop_of_booleanAtomicCheckedCellList
    (booleanAtomicCheckedCellList_of_generatedCoverageCertificate G)

/-- Every even fiber carries a generated Boolean raw-branching coverage
certificate. -/
def SU7GeneratedBooleanRawBranchingCoverageEveryEvenFiber : Prop :=
  ∀ n : ℕ, 2 ≤ n ->
    Nonempty (SU7GeneratedBooleanRawBranchingCoverageCertificate n)

/-- Generated coverage certificates feed P925 on every even fiber. -/
def booleanAtomicCheckedCellListsEveryEvenFiber_of_generatedCoverage
    (H : SU7GeneratedBooleanRawBranchingCoverageEveryEvenFiber) :
    SU7BooleanAtomicRawBranchingCheckedCellListEveryEvenFiber := by
  intro n hn
  exact ⟨booleanAtomicCheckedCellList_of_generatedCoverageCertificate
    (Classical.choice (H n hn))⟩

/-- Fiberwise generated coverage certificates give ordinary even Goldbach.
-/
theorem evenGoldbach_of_generatedCoverageCertificates
    (H : SU7GeneratedBooleanRawBranchingCoverageEveryEvenFiber) :
    EvenGoldbachStatement :=
  evenGoldbach_of_booleanAtomicCheckedCellLists
    (booleanAtomicCheckedCellListsEveryEvenFiber_of_generatedCoverage H)

/-! ## Certificate -/

/-- P926 certificate: the branch spectrum is generated by explicit SU(7)
branch/incidence/code enumeration; the energy bound is computed. -/
structure SU7ExplicitFiniteRawBranchSpectrumGeneratorCertificate where
  candidate_cells :
    ∀ n bound : ℕ, List (SU7BranchingDecompositionCell n)
  boolean_atomic_cells :
    ∀ n bound : ℕ, List (SU7BooleanAtomicRawBranchingCell n)
  generated_spectrum :
    ∀ n bound : ℕ, SU7BranchingDecompositionSpectrum n
  computed_max_energy :
    ∀ n bound : ℕ, ℕ
  computed_energy_bound :
    ∀ {n bound : ℕ} (c : SU7BranchingDecompositionCell n),
      c ∈ (booleanGeneratedRawBranchingSpectrum n bound).cells ->
        rawAtomCodeBranchingDecompositionResidualEnergy c ≤
          generatedRawBranchingMaxEnergy n bound
  generated_certificate_to_checked_list :
    ∀ {n : ℕ}, SU7GeneratedBooleanRawBranchingCoverageCertificate n ->
      SU7BooleanAtomicRawBranchingCheckedCellList n
  every_fiber_to_goldbach :
    SU7GeneratedBooleanRawBranchingCoverageEveryEvenFiber ->
      EvenGoldbachStatement

/-- Canonical P926 explicit finite generator certificate. -/
def su7ExplicitFiniteRawBranchSpectrumGeneratorCertificate :
    SU7ExplicitFiniteRawBranchSpectrumGeneratorCertificate where
  candidate_cells := rawBranchingCandidateCells
  boolean_atomic_cells := booleanAtomicRawBranchingCandidateList
  generated_spectrum := booleanGeneratedRawBranchingSpectrum
  computed_max_energy := generatedRawBranchingMaxEnergy
  computed_energy_bound := generatedRawBranching_energy_bound
  generated_certificate_to_checked_list :=
    booleanAtomicCheckedCellList_of_generatedCoverageCertificate
  every_fiber_to_goldbach :=
    evenGoldbach_of_generatedCoverageCertificates


end
end StandardModelConstraint
end SaturationMonoid
