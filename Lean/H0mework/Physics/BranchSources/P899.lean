import H0mework.Physics.BranchSources.P898

/-!
# Proposition 899: energy ladders generate branching normalizers

P898 still accepts a normalizer map.  This file lowers that map to a
quantized residual-energy normal form.

An energy ladder is a finite SU(7) branching-decomposition spectrum plus a
canonical representative for every positive residual-energy level `e`, whose
energy is exactly `e - 1`.  The normalizer of a cell is then not stored: it is
computed by reading the cell's current residual energy and moving to the
previous energy-level representative.  Zero residual cells are fixed.

This is the quantized-spectrum face of the no-gap route:

```text
positive residual energy e
-> canonical lower energy representative e - 1
-> normalizer map
-> fixed iff zero residual
-> P898/P897/P896 no permanent holonomy spine
```
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open SaturationMonoid.AffineRelaxation

set_option linter.defProp false

/-! ## Quantized energy ladders -/

/-- Nonzero branching residual gives positive residual energy. -/
theorem branchingDecompositionResidualEnergy_pos_of_nonzero
    {n : ℕ} (C : SU7BranchingDecompositionCell n)
    (hnonzero : branchingDecompositionResidual C ≠ 0) :
    0 < branchingDecompositionResidualEnergy C := by
  unfold branchingDecompositionResidualEnergy
  apply Nat.pos_of_ne_zero
  intro henergy
  exact hnonzero (Int.natAbs_eq_zero.mp henergy)

/-- A quantized residual-energy ladder on one finite SU(7)
branching-decomposition spectrum.

For every positive energy level `e`, the ladder supplies a same-spectrum
representative at energy `e - 1`.  This is stronger and more structured than a
free successor relation: descent is generated by the natural-number energy
coordinate itself. -/
structure SU7BranchingEnergyLadderNormalForm (n : ℕ) where
  spectrum : SU7BranchingDecompositionSpectrum n
  startCell : SU7BranchingDecompositionCell n
  start_mem : startCell ∈ spectrum.cells
  lowerEnergyCell : ℕ -> SU7BranchingDecompositionCell n
  lowerEnergyCell_mem :
    ∀ e : ℕ, 0 < e -> lowerEnergyCell e ∈ spectrum.cells
  lowerEnergyCell_energy_eq_pred :
    ∀ e : ℕ, 0 < e ->
      branchingDecompositionResidualEnergy (lowerEnergyCell e) = e - 1

/-- The normalizer computed from an energy ladder.  Zero cells are fixed;
nonzero cells move to the representative of the previous energy level. -/
def branchingEnergyLadderNormalize
    {n : ℕ} (L : SU7BranchingEnergyLadderNormalForm n)
    (C : SU7BranchingDecompositionCell n) :
    SU7BranchingDecompositionCell n :=
  if branchingDecompositionResidual C = 0 then
    C
  else
    L.lowerEnergyCell (branchingDecompositionResidualEnergy C)

/-- THEOREM 1: energy-ladder normalization preserves spectrum membership. -/
theorem branchingEnergyLadderNormalize_mem_preserves
    {n : ℕ} (L : SU7BranchingEnergyLadderNormalForm n)
    (C : SU7BranchingDecompositionCell n)
    (hmem : C ∈ L.spectrum.cells) :
    branchingEnergyLadderNormalize L C ∈ L.spectrum.cells := by
  by_cases hzero : branchingDecompositionResidual C = 0
  · simp [branchingEnergyLadderNormalize, hzero, hmem]
  · have hpos :
        0 < branchingDecompositionResidualEnergy C :=
      branchingDecompositionResidualEnergy_pos_of_nonzero C hzero
    simp [branchingEnergyLadderNormalize, hzero,
      L.lowerEnergyCell_mem _ hpos]

/-- THEOREM 2: energy-ladder normalization strictly lowers nonzero residual
energy. -/
theorem branchingEnergyLadderNormalize_strictly_decreases_nonzero
    {n : ℕ} (L : SU7BranchingEnergyLadderNormalForm n)
    (C : SU7BranchingDecompositionCell n)
    (_hmem : C ∈ L.spectrum.cells)
    (hnonzero : branchingDecompositionResidual C ≠ 0) :
    branchingDecompositionResidualEnergy
        (branchingEnergyLadderNormalize L C) <
      branchingDecompositionResidualEnergy C := by
  have hpos :
      0 < branchingDecompositionResidualEnergy C :=
    branchingDecompositionResidualEnergy_pos_of_nonzero C hnonzero
  have henergy :
      branchingDecompositionResidualEnergy
          (branchingEnergyLadderNormalize L C) =
        branchingDecompositionResidualEnergy C - 1 := by
    simp [branchingEnergyLadderNormalize, hnonzero,
      L.lowerEnergyCell_energy_eq_pred _ hpos]
  omega

/-- THEOREM 3: zero residual cells are fixed by energy-ladder normalization. -/
theorem branchingEnergyLadderNormalize_fixed_of_zero
    {n : ℕ} (L : SU7BranchingEnergyLadderNormalForm n)
    (C : SU7BranchingDecompositionCell n)
    (_hmem : C ∈ L.spectrum.cells)
    (hzero : branchingDecompositionResidual C = 0) :
    branchingEnergyLadderNormalize L C = C := by
  simp [branchingEnergyLadderNormalize, hzero]

/-- THEOREM 4: an energy ladder generates P898's branching normalizer. -/
def branchingNormalizer_of_energyLadder
    {n : ℕ} (L : SU7BranchingEnergyLadderNormalForm n) :
    SU7BranchingDecompositionNormalizer n where
  spectrum := L.spectrum
  startCell := L.startCell
  start_mem := L.start_mem
  normalize := branchingEnergyLadderNormalize L
  normalize_mem_preserves :=
    branchingEnergyLadderNormalize_mem_preserves L
  normalize_strictly_decreases_nonzero :=
    branchingEnergyLadderNormalize_strictly_decreases_nonzero L
  normalize_fixed_of_zero :=
    branchingEnergyLadderNormalize_fixed_of_zero L

/-- THEOREM 5: an energy ladder inherits P898's fixed-point law. -/
theorem branchingEnergyLadder_fixed_iff_residual_zero
    {n : ℕ} (L : SU7BranchingEnergyLadderNormalForm n)
    (C : SU7BranchingDecompositionCell n)
    (hmem : C ∈ L.spectrum.cells) :
    branchingEnergyLadderNormalize L C = C ↔
      branchingDecompositionResidual C = 0 :=
  branchingNormalizer_fixed_iff_residual_zero
    (branchingNormalizer_of_energyLadder L) C hmem

/-- THEOREM 6: an energy ladder produces a zero decomposition-residual cell
through the P899 -> P898 -> P897 spine. -/
theorem exists_zeroCell_of_branchingEnergyLadder
    {n : ℕ} (L : SU7BranchingEnergyLadderNormalForm n) :
    ∃ Z : SU7BranchingDecompositionCell n,
      Z ∈ L.spectrum.cells ∧
        branchingDecompositionResidual Z = 0 :=
  exists_zeroCell_of_branchingNormalizer
    (branchingNormalizer_of_energyLadder L)

/-- THEOREM 7: an energy ladder forbids permanent decomposition holonomy. -/
theorem branchingEnergyLadder_forbidsPermanentHolonomy
    {n : ℕ} (L : SU7BranchingEnergyLadderNormalForm n) :
    SU7BranchingDecompositionSpectrumForbidsPermanentHolonomy
      L.spectrum :=
  branchingNormalizer_forbidsPermanentHolonomy
    (branchingNormalizer_of_energyLadder L)

/-! ## Fiberwise energy-ladder confinement -/

/-- Every even fiber carries a quantized energy-ladder normal form. -/
def SU7BranchingEnergyLadderNormalFormEveryEvenFiber : Prop :=
  ∀ n : ℕ, 2 ≤ n ->
    Nonempty (SU7BranchingEnergyLadderNormalForm n)

/-- THEOREM 8: fiberwise energy ladders generate P898 normalizers on every
even fiber. -/
theorem normalizersEveryEvenFiber_of_energyLadders
    (H : SU7BranchingEnergyLadderNormalFormEveryEvenFiber) :
    SU7BranchingDecompositionNormalizerEveryEvenFiber := by
  intro n hn
  let L : SU7BranchingEnergyLadderNormalForm n :=
    Classical.choice (H n hn)
  exact ⟨branchingNormalizer_of_energyLadder L⟩

/-- Physical energy-ladder confinement data.  The proof payload is now the
quantized spectrum ladder itself. -/
structure SU7BranchingEnergyLadderConfinement where
  compact_gauge_orbit : SU7CompactGaugeOrbit
  lyapunov_residual_dissipation : SU7LyapunovResidualDissipation
  quantized_spectrum_no_escaping_boundary :
    SU7QuantizedSpectrumNoEscapingBoundary
  incidence_schedule_no_free :
    RunningSigmaBeta.SU7IncidenceScheduleNoFreeCertificate
  energy_ladders : SU7BranchingEnergyLadderNormalFormEveryEvenFiber

/-- THEOREM 9: energy-ladder confinement generates P898 normalizer
confinement. -/
def branchingNormalizerConfinement_of_energyLadderConfinement
    (D : SU7BranchingEnergyLadderConfinement) :
    SU7BranchingNormalizerConfinement where
  compact_gauge_orbit := D.compact_gauge_orbit
  lyapunov_residual_dissipation := D.lyapunov_residual_dissipation
  quantized_spectrum_no_escaping_boundary :=
    D.quantized_spectrum_no_escaping_boundary
  incidence_schedule_no_free := D.incidence_schedule_no_free
  normalizers :=
    normalizersEveryEvenFiber_of_energyLadders D.energy_ladders

/-- THEOREM 10: energy-ladder confinement computes trace-zero prime-edge loops
on every even fiber. -/
def traceZeroPrimeEdgeLoopEveryEvenFiber_of_energyLadderConfinement
    (D : SU7BranchingEnergyLadderConfinement) :
    ∀ n : ℕ, 2 ≤ n -> TraceZeroPrimeEdgeLoop n :=
  traceZeroPrimeEdgeLoopEveryEvenFiber_of_branchingNormalizerConfinement
    (branchingNormalizerConfinement_of_energyLadderConfinement D)

/-- THEOREM 11: energy-ladder confinement gives ordinary even Goldbach through
the non-storing branch-decomposition projection chain. -/
theorem evenGoldbach_of_branchingEnergyLadderConfinement
    (D : SU7BranchingEnergyLadderConfinement) :
    EvenGoldbachStatement :=
  evenGoldbach_of_branchingNormalizerConfinement
    (branchingNormalizerConfinement_of_energyLadderConfinement D)

/-! ## Certificate -/

/-- P899 certificate: quantized residual-energy ladders generate the
normalizer and downstream no-gap spine. -/
structure SU7BranchingEnergyLadderProducerCertificate where
  residual_energy_pos_of_nonzero :
    ∀ {n : ℕ} (C : SU7BranchingDecompositionCell n),
      branchingDecompositionResidual C ≠ 0 ->
        0 < branchingDecompositionResidualEnergy C
  ladder_to_normalizer :
    ∀ {n : ℕ}, SU7BranchingEnergyLadderNormalForm n ->
      SU7BranchingDecompositionNormalizer n
  ladder_fixed_iff_residual_zero :
    ∀ {n : ℕ} (L : SU7BranchingEnergyLadderNormalForm n)
      (C : SU7BranchingDecompositionCell n),
      C ∈ L.spectrum.cells ->
        (branchingEnergyLadderNormalize L C = C ↔
          branchingDecompositionResidual C = 0)
  ladder_to_zero_cell :
    ∀ {n : ℕ} (L : SU7BranchingEnergyLadderNormalForm n),
      ∃ Z : SU7BranchingDecompositionCell n,
        Z ∈ L.spectrum.cells ∧
          branchingDecompositionResidual Z = 0
  ladder_forbids_permanent_holonomy :
    ∀ {n : ℕ} (L : SU7BranchingEnergyLadderNormalForm n),
      SU7BranchingDecompositionSpectrumForbidsPermanentHolonomy L.spectrum
  ladder_confinement_to_goldbach :
    SU7BranchingEnergyLadderConfinement -> EvenGoldbachStatement

def su7BranchingEnergyLadderProducerCertificate :
    SU7BranchingEnergyLadderProducerCertificate where
  residual_energy_pos_of_nonzero :=
    branchingDecompositionResidualEnergy_pos_of_nonzero
  ladder_to_normalizer :=
    branchingNormalizer_of_energyLadder
  ladder_fixed_iff_residual_zero :=
    branchingEnergyLadder_fixed_iff_residual_zero
  ladder_to_zero_cell :=
    exists_zeroCell_of_branchingEnergyLadder
  ladder_forbids_permanent_holonomy :=
    branchingEnergyLadder_forbidsPermanentHolonomy
  ladder_confinement_to_goldbach :=
    evenGoldbach_of_branchingEnergyLadderConfinement


end
end StandardModelConstraint
end SaturationMonoid
