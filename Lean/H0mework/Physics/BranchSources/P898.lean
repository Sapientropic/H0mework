import H0mework.Physics.BranchSources.P897

/-!
# Proposition 898: branching normalizers generate residual dynamics

P897 replaces static no-gap data by a relation-valued residual dynamics.  This
file lowers that one more step to a canonical normalizer map on the same finite
branching-decomposition spectrum.

The normalizer is the truth-formula face of confinement:

* zero residual cells are fixed;
* nonzero residual cells are transported to a same-spectrum lower-energy cell.

Lean proves the fixed-point theorem

```text
normalize C = C  iff  branchingDecompositionResidual C = 0
```

for cells in the spectrum, then turns the normalizer into P897's residual
dynamics.  Thus the no-gap route is no longer a free relation: it is generated
by a canonical residual transport map.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open SaturationMonoid.AffineRelaxation

set_option linter.defProp false

/-! ## Normalizer maps on branching-decomposition spectra -/

/-- A normalizer on one finite SU(7) branching-decomposition spectrum.

The map contains no prime edge and no zero cell.  It says: transport every
active nonzero residual cell inside the same spectrum to lower energy, and
leave zero residual cells fixed. -/
structure SU7BranchingDecompositionNormalizer (n : ℕ) where
  spectrum : SU7BranchingDecompositionSpectrum n
  startCell : SU7BranchingDecompositionCell n
  start_mem : startCell ∈ spectrum.cells
  normalize :
    SU7BranchingDecompositionCell n -> SU7BranchingDecompositionCell n
  normalize_mem_preserves :
    ∀ C : SU7BranchingDecompositionCell n,
      C ∈ spectrum.cells -> normalize C ∈ spectrum.cells
  normalize_strictly_decreases_nonzero :
    ∀ C : SU7BranchingDecompositionCell n,
      C ∈ spectrum.cells ->
        branchingDecompositionResidual C ≠ 0 ->
          branchingDecompositionResidualEnergy (normalize C) <
            branchingDecompositionResidualEnergy C
  normalize_fixed_of_zero :
    ∀ C : SU7BranchingDecompositionCell n,
      C ∈ spectrum.cells ->
        branchingDecompositionResidual C = 0 ->
          normalize C = C

/-- THEOREM 1: nonzero residual cells cannot be fixed by the normalizer. -/
theorem branchingNormalizer_not_fixed_of_nonzero
    {n : ℕ} (N : SU7BranchingDecompositionNormalizer n)
    (C : SU7BranchingDecompositionCell n)
    (hmem : C ∈ N.spectrum.cells)
    (hnonzero : branchingDecompositionResidual C ≠ 0) :
    N.normalize C ≠ C := by
  intro hfixed
  have hlt :
      branchingDecompositionResidualEnergy C <
        branchingDecompositionResidualEnergy C := by
    simpa [hfixed] using
      N.normalize_strictly_decreases_nonzero C hmem hnonzero
  exact (lt_irrefl _ hlt)

/-- THEOREM 2: on active spectrum cells, fixed point is exactly zero
residual. -/
theorem branchingNormalizer_fixed_iff_residual_zero
    {n : ℕ} (N : SU7BranchingDecompositionNormalizer n)
    (C : SU7BranchingDecompositionCell n)
    (hmem : C ∈ N.spectrum.cells) :
    N.normalize C = C ↔ branchingDecompositionResidual C = 0 := by
  constructor
  · intro hfixed
    by_contra hnonzero
    exact branchingNormalizer_not_fixed_of_nonzero N C hmem hnonzero hfixed
  · intro hzero
    exact N.normalize_fixed_of_zero C hmem hzero

/-- The relation generated by one normalizer step. -/
def branchingNormalizerStep
    {n : ℕ} (N : SU7BranchingDecompositionNormalizer n)
    (C next : SU7BranchingDecompositionCell n) : Prop :=
  branchingDecompositionResidual C ≠ 0 ∧ next = N.normalize C

/-- THEOREM 3: generated normalizer steps preserve spectrum membership. -/
theorem branchingNormalizerStep_mem_preserves
    {n : ℕ} (N : SU7BranchingDecompositionNormalizer n)
    (C next : SU7BranchingDecompositionCell n)
    (hmem : C ∈ N.spectrum.cells)
    (hstep : branchingNormalizerStep N C next) :
    next ∈ N.spectrum.cells := by
  rcases hstep with ⟨_hnonzero, hnext⟩
  simpa [hnext] using N.normalize_mem_preserves C hmem

/-- THEOREM 4: generated normalizer steps strictly lower residual energy. -/
theorem branchingNormalizerStep_strictly_decreases_energy
    {n : ℕ} (N : SU7BranchingDecompositionNormalizer n)
    (C next : SU7BranchingDecompositionCell n)
    (hmem : C ∈ N.spectrum.cells)
    (hstep : branchingNormalizerStep N C next) :
    branchingDecompositionResidualEnergy next <
      branchingDecompositionResidualEnergy C := by
  rcases hstep with ⟨hnonzero, hnext⟩
  simpa [hnext] using
    N.normalize_strictly_decreases_nonzero C hmem hnonzero

/-- THEOREM 5: the normalizer supplies a successor for every nonzero residual
cell. -/
theorem branchingNormalizerStep_no_terminal_nonzero
    {n : ℕ} (N : SU7BranchingDecompositionNormalizer n)
    (C : SU7BranchingDecompositionCell n)
    (_hmem : C ∈ N.spectrum.cells)
    (hnonzero : branchingDecompositionResidual C ≠ 0) :
    ∃ next : SU7BranchingDecompositionCell n,
      branchingNormalizerStep N C next := by
  exact ⟨N.normalize C, hnonzero, rfl⟩

/-- THEOREM 6: a branching normalizer generates P897's residual dynamics. -/
def branchingResidualDynamics_of_normalizer
    {n : ℕ} (N : SU7BranchingDecompositionNormalizer n) :
    SU7BranchingDecompositionResidualDynamics n where
  spectrum := N.spectrum
  startCell := N.startCell
  start_mem := N.start_mem
  step := branchingNormalizerStep N
  step_mem_preserves :=
    branchingNormalizerStep_mem_preserves N
  step_strictly_decreases_energy :=
    branchingNormalizerStep_strictly_decreases_energy N
  no_terminal_nonzero :=
    branchingNormalizerStep_no_terminal_nonzero N

/-- THEOREM 7: a branching normalizer produces a zero decomposition-residual
cell through P897. -/
theorem exists_zeroCell_of_branchingNormalizer
    {n : ℕ} (N : SU7BranchingDecompositionNormalizer n) :
    ∃ Z : SU7BranchingDecompositionCell n,
      Z ∈ N.spectrum.cells ∧
        branchingDecompositionResidual Z = 0 :=
  exists_zeroCell_of_branchingResidualDynamics
    (branchingResidualDynamics_of_normalizer N)

/-- THEOREM 8: a branching normalizer forbids permanent decomposition
holonomy. -/
theorem branchingNormalizer_forbidsPermanentHolonomy
    {n : ℕ} (N : SU7BranchingDecompositionNormalizer n) :
    SU7BranchingDecompositionSpectrumForbidsPermanentHolonomy
      N.spectrum :=
  branchingResidualDynamics_forbidsPermanentHolonomy
    (branchingResidualDynamics_of_normalizer N)

/-- THEOREM 9: a branching normalizer computes a trace-zero prime-edge loop
through the existing projection spine. -/
def traceZeroPrimeEdgeLoop_of_branchingNormalizer
    {n : ℕ} (N : SU7BranchingDecompositionNormalizer n) :
    TraceZeroPrimeEdgeLoop n :=
  traceZeroPrimeEdgeLoop_of_branchingResidualDynamics
    (branchingResidualDynamics_of_normalizer N)

/-! ## Fiberwise normalizer confinement -/

/-- Every even fiber carries a branching-decomposition normalizer. -/
def SU7BranchingDecompositionNormalizerEveryEvenFiber : Prop :=
  ∀ n : ℕ, 2 ≤ n ->
    Nonempty (SU7BranchingDecompositionNormalizer n)

/-- THEOREM 10: fiberwise normalizers generate P897 residual dynamics on every
even fiber. -/
theorem residualDynamicsEveryEvenFiber_of_normalizers
    (H : SU7BranchingDecompositionNormalizerEveryEvenFiber) :
    SU7BranchingDecompositionResidualDynamicsEveryEvenFiber := by
  intro n hn
  let N : SU7BranchingDecompositionNormalizer n :=
    Classical.choice (H n hn)
  exact ⟨branchingResidualDynamics_of_normalizer N⟩

/-- Physical normalizer-level confinement data.  The proof payload is now a
fiberwise canonical residual normalizer rather than a relation-valued dynamics.
-/
structure SU7BranchingNormalizerConfinement where
  compact_gauge_orbit : SU7CompactGaugeOrbit
  lyapunov_residual_dissipation : SU7LyapunovResidualDissipation
  quantized_spectrum_no_escaping_boundary :
    SU7QuantizedSpectrumNoEscapingBoundary
  incidence_schedule_no_free :
    RunningSigmaBeta.SU7IncidenceScheduleNoFreeCertificate
  normalizers : SU7BranchingDecompositionNormalizerEveryEvenFiber

/-- THEOREM 11: normalizer confinement generates P897 residual-transport
confinement. -/
def residualTransportConfinement_of_branchingNormalizerConfinement
    (D : SU7BranchingNormalizerConfinement) :
    SU7BranchingResidualTransportConfinement where
  compact_gauge_orbit := D.compact_gauge_orbit
  lyapunov_residual_dissipation := D.lyapunov_residual_dissipation
  quantized_spectrum_no_escaping_boundary :=
    D.quantized_spectrum_no_escaping_boundary
  incidence_schedule_no_free := D.incidence_schedule_no_free
  residual_dynamics :=
    residualDynamicsEveryEvenFiber_of_normalizers D.normalizers

/-- THEOREM 12: normalizer confinement computes trace-zero prime-edge loops on
every even fiber. -/
def traceZeroPrimeEdgeLoopEveryEvenFiber_of_branchingNormalizerConfinement
    (D : SU7BranchingNormalizerConfinement) :
    ∀ n : ℕ, 2 ≤ n -> TraceZeroPrimeEdgeLoop n :=
  traceZeroPrimeEdgeLoopEveryEvenFiber_of_residualTransportConfinement
    (residualTransportConfinement_of_branchingNormalizerConfinement D)

/-- THEOREM 13: normalizer confinement gives ordinary even Goldbach through
the non-storing branch-decomposition projection chain. -/
theorem evenGoldbach_of_branchingNormalizerConfinement
    (D : SU7BranchingNormalizerConfinement) :
    EvenGoldbachStatement :=
  evenGoldbach_of_branchingResidualTransportConfinement
    (residualTransportConfinement_of_branchingNormalizerConfinement D)

/-! ## Certificate -/

/-- P898 certificate: a canonical normalizer map generates the whole
decomposition-level residual dynamics and fixed-point law. -/
structure SU7BranchingNormalizerProducerCertificate where
  fixed_iff_residual_zero :
    ∀ {n : ℕ} (N : SU7BranchingDecompositionNormalizer n)
      (C : SU7BranchingDecompositionCell n),
      C ∈ N.spectrum.cells ->
        (N.normalize C = C ↔ branchingDecompositionResidual C = 0)
  normalizer_to_dynamics :
    ∀ {n : ℕ}, SU7BranchingDecompositionNormalizer n ->
      SU7BranchingDecompositionResidualDynamics n
  normalizer_to_zero_cell :
    ∀ {n : ℕ} (N : SU7BranchingDecompositionNormalizer n),
      ∃ Z : SU7BranchingDecompositionCell n,
        Z ∈ N.spectrum.cells ∧
          branchingDecompositionResidual Z = 0
  normalizer_forbids_permanent_holonomy :
    ∀ {n : ℕ} (N : SU7BranchingDecompositionNormalizer n),
      SU7BranchingDecompositionSpectrumForbidsPermanentHolonomy N.spectrum
  normalizer_to_trace_zero :
    ∀ {n : ℕ}, SU7BranchingDecompositionNormalizer n ->
      TraceZeroPrimeEdgeLoop n
  normalizer_confinement_to_goldbach :
    SU7BranchingNormalizerConfinement -> EvenGoldbachStatement

def su7BranchingNormalizerProducerCertificate :
    SU7BranchingNormalizerProducerCertificate where
  fixed_iff_residual_zero :=
    branchingNormalizer_fixed_iff_residual_zero
  normalizer_to_dynamics :=
    branchingResidualDynamics_of_normalizer
  normalizer_to_zero_cell :=
    exists_zeroCell_of_branchingNormalizer
  normalizer_forbids_permanent_holonomy :=
    branchingNormalizer_forbidsPermanentHolonomy
  normalizer_to_trace_zero :=
    traceZeroPrimeEdgeLoop_of_branchingNormalizer
  normalizer_confinement_to_goldbach :=
    evenGoldbach_of_branchingNormalizerConfinement


end
end StandardModelConstraint
end SaturationMonoid
