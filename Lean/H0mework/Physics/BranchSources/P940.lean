import H0mework.Arithmetic.CodePairs.P927
import H0mework.Arithmetic.PrimeShadow.P939

/-!
# Proposition 940: generated coverage uses the branch-rule projection throat

P939 introduced the lowest no-smuggling projection boundary:

```text
raw branch-rule spectrum cell
+ local tensor filter
-> no-prime cell
-> generated prime-edge projection
```

P927 already proves that an explicit generated coverage certificate computes a
zero raw residual cell.  This file welds those two facts.  The zero cell is
read from the generated coverage theorem, wrapped as a raw branch-rule spectrum
cell, and then projected through P939.  Thus the explicit generated coverage
route reaches the prime-edge / trace-zero readout through the new branch-rule
throat, not through a pre-stored prime pair.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open SaturationMonoid.AffineRelaxation
open RunningSigmaBeta

set_option linter.defProp false

/-! ## Generated coverage to branch-rule zero cells -/

/-- The local tensor filter generated by an explicit coverage certificate.

The filter is scoped to the generated raw spectrum; it is not stored in a raw
branch-rule cell. -/
def branchRuleLocalTensorFilter_of_generatedCoverageCertificate
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    SU7RawBranchingLocalTensorFilter rawCodeTensorCoding
      (booleanGeneratedRawBranchingSpectrum n G.codeBound) :=
  (checkedLocalEnergyShellRule_of_generatedCoverageCertificate G).local_tensor_filter

/-- The zero raw cell computed from generated coverage, packaged as the P939
raw branch-rule spectrum cell. -/
def branchRuleZeroCell_of_generatedCoverageCertificate
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    SU7BranchRuleSpectrumCell
      (booleanGeneratedRawBranchingSpectrum n G.codeBound) :=
  let hZ := exists_zeroRawCell_of_generatedCoverageCertificate G
  let z := Classical.choose hZ
  let hz := Classical.choose_spec hZ
  { rawCell := z
    raw_mem := hz.1 }

/-- The generated branch-rule zero cell has zero raw residual. -/
theorem branchRuleZeroCell_generatedCoverage_residual_zero
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    branchRuleSpectrumResidual
        (branchRuleZeroCell_of_generatedCoverageCertificate G) = 0 := by
  unfold branchRuleZeroCell_of_generatedCoverageCertificate
  exact (Classical.choose_spec
    (exists_zeroRawCell_of_generatedCoverageCertificate G)).2

/-- The generated coverage zero cell projects to a prime left endpoint only
through P939's branch-rule projection throat. -/
theorem generatedCoverage_branchRule_leftCode_prime
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    Nat.Prime
      (branchRuleZeroCell_of_generatedCoverageCertificate G).leftCode :=
  branchRuleSpectrumCell_leftCode_prime
    (branchRuleLocalTensorFilter_of_generatedCoverageCertificate G)
    (branchRuleZeroCell_of_generatedCoverageCertificate G)

/-- The generated coverage zero cell projects to a prime right endpoint only
through P939's branch-rule projection throat. -/
theorem generatedCoverage_branchRule_rightCode_prime
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    Nat.Prime
      (branchRuleZeroCell_of_generatedCoverageCertificate G).rightCode :=
  branchRuleSpectrumCell_rightCode_prime
    (branchRuleLocalTensorFilter_of_generatedCoverageCertificate G)
    (branchRuleZeroCell_of_generatedCoverageCertificate G)

/-- Generated coverage preserves residual through the branch-rule prime-edge
projection. -/
theorem generatedCoverage_branchRule_projection_preserves_residual
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    branchWeightResidual
        (primeEdgeBranchCell_of_branchRuleSpectrumCell
          (branchRuleLocalTensorFilter_of_generatedCoverageCertificate G)
          (branchRuleZeroCell_of_generatedCoverageCertificate G)) =
      branchRuleSpectrumResidual
        (branchRuleZeroCell_of_generatedCoverageCertificate G) :=
  branchWeightResidual_branchRuleProjection_eq
    (branchRuleLocalTensorFilter_of_generatedCoverageCertificate G)
    (branchRuleZeroCell_of_generatedCoverageCertificate G)

/-- Generated coverage gives the arithmetic balance of the projected endpoint
codes through the branch-rule zero cell. -/
theorem generatedCoverage_branchRule_zero_to_sum
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    (branchRuleZeroCell_of_generatedCoverageCertificate G).leftCode +
        (branchRuleZeroCell_of_generatedCoverageCertificate G).rightCode =
      2 * n :=
  branchRuleSpectrumResidual_zero_to_sum
    (branchRuleZeroCell_of_generatedCoverageCertificate G)
    (branchRuleZeroCell_generatedCoverage_residual_zero G)

/-- Generated coverage computes a trace-zero prime-edge loop through P939's
raw branch-rule projection throat. -/
def traceZeroPrimeEdgeLoop_of_generatedCoverageBranchRule
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    TraceZeroPrimeEdgeLoop n :=
  traceZeroPrimeEdgeLoop_of_branchRuleSpectrumCell
    (branchRuleLocalTensorFilter_of_generatedCoverageCertificate G)
    (branchRuleZeroCell_of_generatedCoverageCertificate G)
    (branchRuleZeroCell_generatedCoverage_residual_zero G)

/-- Fiberwise generated coverage gives ordinary even Goldbach through the
branch-rule projection throat. -/
theorem evenGoldbach_of_generatedCoverageBranchRule
    (H : SU7GeneratedBooleanRawBranchingCoverageEveryEvenFiber) :
    EvenGoldbachStatement :=
  evenGoldbach_of_traceZeroPrimeEdgeLoopEveryEvenFiber
    (fun n hn =>
      traceZeroPrimeEdgeLoop_of_generatedCoverageBranchRule
        (Classical.choice (H n hn)))

/-! ## Certificate -/

/-- P940 certificate: explicit generated coverage reaches the trace-zero
prime-edge readout through the P939 branch-rule projection throat. -/
structure SU7GeneratedCoverageBranchRuleProjectionCertificate where
  generated_filter :
    ∀ {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n),
      SU7RawBranchingLocalTensorFilter rawCodeTensorCoding
        (booleanGeneratedRawBranchingSpectrum n G.codeBound)
  zero_cell :
    ∀ {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n),
      SU7BranchRuleSpectrumCell
        (booleanGeneratedRawBranchingSpectrum n G.codeBound)
  zero_cell_residual_zero :
    ∀ {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n),
      branchRuleSpectrumResidual
          (branchRuleZeroCell_of_generatedCoverageCertificate G) = 0
  left_prime_generated :
    ∀ {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n),
      Nat.Prime
        (branchRuleZeroCell_of_generatedCoverageCertificate G).leftCode
  right_prime_generated :
    ∀ {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n),
      Nat.Prime
        (branchRuleZeroCell_of_generatedCoverageCertificate G).rightCode
  projection_preserves_residual :
    ∀ {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n),
      branchWeightResidual
          (primeEdgeBranchCell_of_branchRuleSpectrumCell
            (branchRuleLocalTensorFilter_of_generatedCoverageCertificate G)
            (branchRuleZeroCell_of_generatedCoverageCertificate G)) =
        branchRuleSpectrumResidual
          (branchRuleZeroCell_of_generatedCoverageCertificate G)
  zero_to_sum :
    ∀ {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n),
      (branchRuleZeroCell_of_generatedCoverageCertificate G).leftCode +
          (branchRuleZeroCell_of_generatedCoverageCertificate G).rightCode =
        2 * n
  trace_zero :
    ∀ {n : ℕ}, SU7GeneratedBooleanRawBranchingCoverageCertificate n ->
      TraceZeroPrimeEdgeLoop n
  every_fiber_to_goldbach :
    SU7GeneratedBooleanRawBranchingCoverageEveryEvenFiber ->
      EvenGoldbachStatement

/-- Canonical P940 generated-coverage branch-rule projection certificate. -/
def su7GeneratedCoverageBranchRuleProjectionCertificate :
    SU7GeneratedCoverageBranchRuleProjectionCertificate where
  generated_filter :=
    branchRuleLocalTensorFilter_of_generatedCoverageCertificate
  zero_cell := branchRuleZeroCell_of_generatedCoverageCertificate
  zero_cell_residual_zero :=
    branchRuleZeroCell_generatedCoverage_residual_zero
  left_prime_generated := generatedCoverage_branchRule_leftCode_prime
  right_prime_generated := generatedCoverage_branchRule_rightCode_prime
  projection_preserves_residual :=
    generatedCoverage_branchRule_projection_preserves_residual
  zero_to_sum := generatedCoverage_branchRule_zero_to_sum
  trace_zero := traceZeroPrimeEdgeLoop_of_generatedCoverageBranchRule
  every_fiber_to_goldbach := evenGoldbach_of_generatedCoverageBranchRule


end
end StandardModelConstraint
end SaturationMonoid
