import H0mework.Physics.Lorentz.LorentzConnectionVariation
import Mathlib.Analysis.Calculus.Deriv.Slope
import Mathlib.Analysis.Calculus.ParametricIntervalIntegral
import Mathlib.MeasureTheory.Integral.CurveIntegral.Poincare

/-!
# Radial curve-integral first jet

This module isolates the calculus used by action-owned radial path compilers.
For a `C¹` one-form it computes the unconditional Fréchet derivative of the
already emitted radial curve integral, retaining the full radial
exactification term.
-/

namespace SaturationMonoid.PhysicsCore.StageNineRadialCurveIntegralFirstJet

open PointwiseDiracSpinConnectionLift
open Filter MeasureTheory Metric Set
open StageNineLorentzConnectionVariation

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1200000
set_option maxRecDepth 100000

/-- The unconditional derivative integrand of a radial curve integral.  The
second summand records variation of the generated one-form along the radial
segment. -/
def radialCurveIntegralDerivativeIntegrand
    {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F]
    (oneForm : E → E →L[ℝ] F)
    (point : E)
    (parameter : ℝ) : E →L[ℝ] F :=
  (oneForm (parameter • point)).comp (ContinuousLinearMap.id ℝ E) +
    (ContinuousLinearMap.flipₗᵢ ℝ E E F)
      ((fderiv ℝ oneForm (parameter • point)).comp
        (parameter • ContinuousLinearMap.id ℝ E)) point

/-- A radial curve integral has the explicit derivative generated by its
`C¹` one-form.  The full radial exactification term is retained. -/
theorem radialCurveIntegral_hasFDerivAt_of_contDiff
    {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [ProperSpace E]
    [NormedAddCommGroup F] [NormedSpace ℝ F]
    (oneForm : E → E →L[ℝ] F)
    (regular : ContDiff ℝ 1 oneForm)
    (point : E) :
    HasFDerivAt
      (fun endpoint => ∫ᶜ x in Path.segment (0 : E) endpoint, oneForm x)
      (∫ parameter in (0 : ℝ)..1,
        radialCurveIntegralDerivativeIntegrand oneForm point parameter)
      point := by
  let integrand : E → ℝ → F :=
    fun endpoint parameter => oneForm (parameter • endpoint) endpoint
  let integrandDerivative : E → ℝ → E →L[ℝ] F :=
    fun endpoint parameter =>
      radialCurveIntegralDerivativeIntegrand oneForm endpoint parameter
  have integrandContinuous (endpoint : E) :
      Continuous (fun parameter : ℝ => integrand endpoint parameter) := by
    unfold integrand
    exact
      (regular.continuous.comp
        (continuous_id.smul continuous_const)).clm_apply continuous_const
  have derivativeContinuous :
      Continuous
        (fun pair : E × ℝ => integrandDerivative pair.1 pair.2) := by
    have oneFormContinuous : Continuous oneForm := regular.continuous
    have oneFormDerivativeContinuous : Continuous (fderiv ℝ oneForm) :=
      regular.continuous_fderiv (by norm_num)
    unfold integrandDerivative radialCurveIntegralDerivativeIntegrand
    fun_prop
  have derivativeParameterContinuous (endpoint : E) :
      Continuous (fun parameter : ℝ => integrandDerivative endpoint parameter) :=
    derivativeContinuous.comp (continuous_const.prodMk continuous_id)
  obtain ⟨bound, derivativeBound⟩ :=
    (IsCompact.prod (isCompact_closedBall point 1)
        (isCompact_Icc : IsCompact (Set.Icc (0 : ℝ) 1))
      ).exists_bound_of_continuousOn derivativeContinuous.continuousOn
  have differentiated :
      HasFDerivAt
        (fun endpoint => ∫ parameter in (0 : ℝ)..1, integrand endpoint parameter)
        (∫ parameter in (0 : ℝ)..1,
          integrandDerivative point parameter)
        point := by
    apply intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le
      (s := Metric.closedBall point 1) (bound := fun _ => bound)
    · exact Metric.closedBall_mem_nhds point zero_lt_one
    · filter_upwards [] with endpoint
      exact (integrandContinuous endpoint).aestronglyMeasurable
    · exact (integrandContinuous point).intervalIntegrable 0 1
    · exact (derivativeParameterContinuous point).aestronglyMeasurable
    · filter_upwards [] with parameter parameter_mem endpoint endpoint_mem
      apply derivativeBound (endpoint, parameter)
      refine ⟨endpoint_mem, ?_⟩
      rw [Set.uIoc_of_le zero_le_one] at parameter_mem
      exact ⟨le_of_lt parameter_mem.1, parameter_mem.2⟩
    · exact continuous_const.intervalIntegrable 0 1
    · filter_upwards [] with parameter _ endpoint _
      have scaled :
          HasFDerivAt (fun candidate : E => parameter • candidate)
            (parameter • ContinuousLinearMap.id ℝ E) endpoint :=
        (hasFDerivAt_id endpoint).const_smul parameter
      have coefficient :
          HasFDerivAt (fun candidate : E => oneForm (parameter • candidate))
            ((fderiv ℝ oneForm (parameter • endpoint)).comp
              (parameter • ContinuousLinearMap.id ℝ E)) endpoint :=
        (regular.differentiable (by norm_num) (parameter • endpoint)
          ).hasFDerivAt.comp endpoint scaled
      simpa [integrandDerivative, integrand,
        radialCurveIntegralDerivativeIntegrand] using
          coefficient.clm_apply (hasFDerivAt_id endpoint)
  simpa [integrand, integrandDerivative, curveIntegral_segment,
    AffineMap.lineMap_apply] using differentiated

/-- A differentiable symmetric one-form is the complete first jet of its
source-anchored radial primitive at every point. -/
theorem radialCurveIntegral_hasFDerivAt_of_symmetric
    {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    (oneForm : E → E →L[ℝ] F)
    (oneFormDerivative : E → E →L[ℝ] E →L[ℝ] F)
    (differentiable : ∀ point,
      HasFDerivAt oneForm (oneFormDerivative point) point)
    (symmetric : ∀ point first second,
      oneFormDerivative point first second =
        oneFormDerivative point second first)
    (point : E) :
    HasFDerivAt
      (fun endpoint => ∫ᶜ x in Path.segment (0 : E) endpoint, oneForm x)
      (oneForm point) point := by
  have generated :=
    (convex_univ : Convex ℝ (Set.univ : Set E)
      ).hasFDerivWithinAt_curveIntegral_segment_of_hasFDerivWithinAt_symmetric
        (dω := oneFormDerivative)
        (fun candidate _ => (differentiable candidate).hasFDerivWithinAt)
        (fun candidate _ first _ second _ =>
          symmetric candidate first second)
        (Set.mem_univ (0 : E)) (Set.mem_univ point)
  exact generated.hasFDerivAt_of_univ

/-- At the radial source, local continuity of the emitted one-form determines
the exact first jet because the source segment is constant. -/
theorem radialCurveIntegral_hasFDerivAt_zero_of_contDiffAt
    {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F]
    [CompleteSpace F]
    (oneForm : E → E →L[ℝ] F)
    (regular : ContDiffAt ℝ 0 oneForm 0) :
    HasFDerivAt
      (fun endpoint => ∫ᶜ x in Path.segment (0 : E) endpoint, oneForm x)
      (oneForm 0) 0 := by
  apply HasFDerivAt.curveIntegral_segment_source'
  filter_upwards [regular.eventually (by simp)] with point pointRegular
  exact pointRegular.continuousAt

/-! ## Regularity of the generated radial primitive -/

/-- A globally `C¹` one-form generates a globally `C¹` radial primitive whose
derivative retains the full radial exactification term. -/
theorem radialCurveIntegral_contDiff_one_of_contDiff
    {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [ProperSpace E]
    [NormedAddCommGroup F] [NormedSpace ℝ F]
    (oneForm : E → E →L[ℝ] F)
    (regular : ContDiff ℝ 1 oneForm) :
    ContDiff ℝ 1
      (fun endpoint => ∫ᶜ x in Path.segment (0 : E) endpoint, oneForm x) := by
  rw [contDiff_one_iff_hasFDerivAt]
  let derivative : E → E →L[ℝ] F := fun point =>
    ∫ parameter in (0 : ℝ)..1,
      radialCurveIntegralDerivativeIntegrand oneForm point parameter
  refine ⟨derivative, ?_, ?_⟩
  · have jointContinuous : Continuous
        (fun pair : E × ℝ =>
          radialCurveIntegralDerivativeIntegrand
            oneForm pair.1 pair.2) := by
      have oneFormContinuous : Continuous oneForm := regular.continuous
      have oneFormDerivativeContinuous : Continuous (fderiv ℝ oneForm) :=
        regular.continuous_fderiv (by norm_num)
      unfold radialCurveIntegralDerivativeIntegrand
      fun_prop
    exact intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
      jointContinuous 0 1
  · intro point
    exact radialCurveIntegral_hasFDerivAt_of_contDiff oneForm regular point

private theorem fixedIntervalIntegral_continuousOn_ball
    {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [ProperSpace E]
    [NormedAddCommGroup F] [NormedSpace ℝ F]
    (family : E → ℝ → F)
    (radius : ℝ)
    (regular : ContinuousOn (Function.uncurry family)
      (closedBall (0 : E) radius ×ˢ Icc (0 : ℝ) 1)) :
    ContinuousOn
      (fun point => ∫ parameter in (0 : ℝ)..1, family point parameter)
      (ball (0 : E) radius) := by
  have compactDomain : IsCompact
      (closedBall (0 : E) radius ×ˢ Icc (0 : ℝ) 1) :=
    (isCompact_closedBall (0 : E) radius).prod isCompact_Icc
  obtain ⟨bound, bound_spec⟩ :=
    compactDomain.exists_bound_of_continuousOn regular
  intro point pointMem
  apply intervalIntegral.continuousWithinAt_of_dominated_interval
      (μ := volume) (bound := fun _ => bound)
  · filter_upwards [self_mem_nhdsWithin] with candidate candidateMem
    have sectionContinuous : ContinuousOn (family candidate) (Icc (0 : ℝ) 1) :=
      regular.comp
        (continuous_const.prodMk continuous_id).continuousOn
        (by
          intro parameter parameterMem
          exact ⟨ball_subset_closedBall candidateMem, parameterMem⟩)
    exact (sectionContinuous.intervalIntegrable_of_Icc (by norm_num)).def'
      |>.aestronglyMeasurable
  · filter_upwards [self_mem_nhdsWithin] with candidate candidateMem
    filter_upwards [] with parameter parameterMem
    have parameterMem' : parameter ∈ Icc (0 : ℝ) 1 := by
      have actual := uIoc_subset_uIcc parameterMem
      simpa [uIcc_of_le (by norm_num : (0 : ℝ) ≤ 1)] using actual
    exact bound_spec (candidate, parameter)
      ⟨ball_subset_closedBall candidateMem, parameterMem'⟩
  · exact intervalIntegrable_const
  · filter_upwards [] with parameter parameterMem
    have parameterMem' : parameter ∈ Icc (0 : ℝ) 1 := by
      have actual := uIoc_subset_uIcc parameterMem
      simpa [uIcc_of_le (by norm_num : (0 : ℝ) ≤ 1)] using actual
    have sectionContinuous : ContinuousOn
        (fun candidate : E => family candidate parameter)
        (closedBall (0 : E) radius) :=
      regular.comp
        (continuous_id.prodMk continuous_const).continuousOn
        (fun candidate candidateMem => ⟨candidateMem, parameterMem'⟩)
    exact (sectionContinuous point (ball_subset_closedBall pointMem)).mono
      ball_subset_closedBall

/-- Local continuity of a one-form at the radial source gives local
continuity of its radial primitive.  The compact interval and a smaller
source-centered ball generate the domination bound. -/
theorem radialCurveIntegral_contDiffAt_zero_of_contDiffAt
    {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [ProperSpace E]
    [NormedAddCommGroup F] [NormedSpace ℝ F]
    (oneForm : E → E →L[ℝ] F)
    (regular : ContDiffAt ℝ 0 oneForm 0) :
    ContDiffAt ℝ 0
      (fun endpoint => ∫ᶜ x in Path.segment (0 : E) endpoint, oneForm x)
      0 := by
  obtain ⟨corridor, corridorOpen, zeroMem, regularOn⟩ :=
    regular.contDiffOn' (m := 0) le_rfl (by simp)
  have regularOn' : ContDiffOn ℝ 0 oneForm corridor := by
    simpa using regularOn
  obtain ⟨epsilon, epsilon_pos, ballSubset⟩ :=
    Metric.mem_nhds_iff.mp (corridorOpen.mem_nhds zeroMem)
  let radius : ℝ := epsilon / 2
  have radius_pos : 0 < radius := by
    dsimp [radius]
    positivity
  have closedBallSubset : closedBall (0 : E) radius ⊆ corridor := by
    intro point pointMem
    apply ballSubset
    rw [mem_closedBall] at pointMem
    rw [mem_ball]
    exact pointMem.trans_lt (by
      dsimp [radius]
      linarith)
  have radialMapsToCorridor :
      ∀ point ∈ closedBall (0 : E) radius,
        ∀ parameter ∈ Icc (0 : ℝ) 1,
          parameter • point ∈ corridor := by
    intro point pointMem parameter parameterMem
    apply closedBallSubset
    rw [mem_closedBall_zero_iff] at pointMem ⊢
    rw [norm_smul, Real.norm_eq_abs]
    have parameterAbs : |parameter| ≤ 1 := by
      rw [abs_of_nonneg parameterMem.1]
      exact parameterMem.2
    exact (mul_le_of_le_one_left (norm_nonneg point) parameterAbs).trans pointMem
  let family : E → ℝ → F :=
    fun endpoint parameter => oneForm (parameter • endpoint) endpoint
  have familyContinuous : ContinuousOn (Function.uncurry family)
      (closedBall (0 : E) radius ×ˢ Icc (0 : ℝ) 1) := by
    change ContinuousOn
      (fun pair : E × ℝ => oneForm (pair.2 • pair.1) pair.1)
      (closedBall (0 : E) radius ×ˢ Icc (0 : ℝ) 1)
    have coefficientContinuous : ContinuousOn
        (fun pair : E × ℝ => oneForm (pair.2 • pair.1))
        (closedBall (0 : E) radius ×ˢ Icc (0 : ℝ) 1) :=
      regularOn'.continuousOn.comp
        (continuous_snd.smul continuous_fst).continuousOn
        (by
          intro pair pairMem
          exact radialMapsToCorridor pair.1 pairMem.1 pair.2 pairMem.2)
    exact coefficientContinuous.clm_apply continuous_fst.continuousOn
  have primitiveContinuous : ContinuousOn
      (fun endpoint => ∫ parameter in (0 : ℝ)..1, family endpoint parameter)
      (ball (0 : E) radius) :=
    fixedIntervalIntegral_continuousOn_ball family radius familyContinuous
  rw [contDiffAt_zero]
  refine ⟨ball (0 : E) radius, ball_mem_nhds _ radius_pos, ?_⟩
  simpa [family, curveIntegral_segment, AffineMap.lineMap_apply] using
    primitiveContinuous

/-- A locally `C¹` one-form at the radial source generates a locally `C¹`
radial primitive there with its full radial exactification derivative. -/
theorem radialCurveIntegral_contDiffAt_one_of_contDiffAt
    {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [ProperSpace E]
    [NormedAddCommGroup F] [NormedSpace ℝ F]
    (oneForm : E → E →L[ℝ] F)
    (regular : ContDiffAt ℝ 1 oneForm 0) :
    ContDiffAt ℝ 1
      (fun endpoint => ∫ᶜ x in Path.segment (0 : E) endpoint, oneForm x)
      0 := by
  obtain ⟨corridor, corridorOpen, zeroMem, regularOn⟩ :=
    regular.contDiffOn' (m := 1) le_rfl (by simp)
  have regularOn' : ContDiffOn ℝ 1 oneForm corridor := by
    simpa using regularOn
  obtain ⟨epsilon, epsilon_pos, ballSubset⟩ :=
    Metric.mem_nhds_iff.mp (corridorOpen.mem_nhds zeroMem)
  let radius : ℝ := epsilon / 2
  have radius_pos : 0 < radius := by
    dsimp [radius]
    positivity
  have closedBallSubset : closedBall (0 : E) radius ⊆ corridor := by
    intro point pointMem
    apply ballSubset
    rw [mem_closedBall] at pointMem
    rw [mem_ball]
    exact pointMem.trans_lt (by
      dsimp [radius]
      linarith)
  have radialMapsToCorridor :
      ∀ point ∈ closedBall (0 : E) radius,
        ∀ parameter ∈ Icc (0 : ℝ) 1,
          parameter • point ∈ corridor := by
    intro point pointMem parameter parameterMem
    apply closedBallSubset
    rw [mem_closedBall_zero_iff] at pointMem ⊢
    rw [norm_smul, Real.norm_eq_abs]
    have parameterAbs : |parameter| ≤ 1 := by
      rw [abs_of_nonneg parameterMem.1]
      exact parameterMem.2
    exact (mul_le_of_le_one_left (norm_nonneg point) parameterAbs).trans pointMem
  let derivativeFamily : E → ℝ → (E →L[ℝ] F) :=
    fun point parameter =>
      radialCurveIntegralDerivativeIntegrand oneForm point parameter
  have derivativeFamilyContinuous : ContinuousOn
      (Function.uncurry derivativeFamily)
      (closedBall (0 : E) radius ×ˢ Icc (0 : ℝ) 1) := by
    change ContinuousOn
      (fun pair : E × ℝ =>
        radialCurveIntegralDerivativeIntegrand oneForm pair.1 pair.2)
      (closedBall (0 : E) radius ×ˢ Icc (0 : ℝ) 1)
    have oneFormContinuous : ContinuousOn oneForm corridor :=
      regularOn'.continuousOn
    have oneFormDerivativeContinuous : ContinuousOn (fderiv ℝ oneForm) corridor :=
      regularOn'.continuousOn_fderiv_of_isOpen corridorOpen (by norm_num)
    unfold radialCurveIntegralDerivativeIntegrand
    have scaleMaps : MapsTo (fun pair : E × ℝ => pair.2 • pair.1)
        (closedBall (0 : E) radius ×ˢ Icc (0 : ℝ) 1) corridor := by
      intro pair pairMem
      exact radialMapsToCorridor pair.1 pairMem.1 pair.2 pairMem.2
    have coefficientContinuous : ContinuousOn
        (fun pair : E × ℝ => oneForm (pair.2 • pair.1))
        (closedBall (0 : E) radius ×ˢ Icc (0 : ℝ) 1) :=
      oneFormContinuous.comp
        (continuous_snd.smul continuous_fst).continuousOn scaleMaps
    have firstContinuous : ContinuousOn
        (fun pair : E × ℝ =>
          (oneForm (pair.2 • pair.1)).comp (ContinuousLinearMap.id ℝ E))
        (closedBall (0 : E) radius ×ˢ Icc (0 : ℝ) 1) :=
      coefficientContinuous.clm_comp continuousOn_const
    have fullDerivativeContinuous : ContinuousOn
        (fun pair : E × ℝ => fderiv ℝ oneForm (pair.2 • pair.1))
        (closedBall (0 : E) radius ×ˢ Icc (0 : ℝ) 1) :=
      oneFormDerivativeContinuous.comp
        (continuous_snd.smul continuous_fst).continuousOn scaleMaps
    have scaledIdentityContinuous : Continuous
        (fun pair : E × ℝ => pair.2 • ContinuousLinearMap.id ℝ E) := by
      fun_prop
    have composedContinuous : ContinuousOn
        (fun pair : E × ℝ =>
          (fderiv ℝ oneForm (pair.2 • pair.1)).comp
            (pair.2 • ContinuousLinearMap.id ℝ E))
        (closedBall (0 : E) radius ×ˢ Icc (0 : ℝ) 1) :=
      fullDerivativeContinuous.clm_comp scaledIdentityContinuous.continuousOn
    have flippedContinuous : ContinuousOn
        (fun pair : E × ℝ =>
          (ContinuousLinearMap.flipₗᵢ ℝ E E F)
            ((fderiv ℝ oneForm (pair.2 • pair.1)).comp
              (pair.2 • ContinuousLinearMap.id ℝ E)))
        (closedBall (0 : E) radius ×ˢ Icc (0 : ℝ) 1) := by
      simpa [Function.comp_def] using
        (LinearIsometryEquiv.continuous
          (ContinuousLinearMap.flipₗᵢ ℝ E E F)).comp_continuousOn
            composedContinuous
    exact firstContinuous.add
      (flippedContinuous.clm_apply continuous_fst.continuousOn)
  let derivative : E → E →L[ℝ] F := fun point =>
    ∫ parameter in (0 : ℝ)..1, derivativeFamily point parameter
  have derivativeContinuous : ContinuousOn derivative (ball (0 : E) radius) :=
    fixedIntervalIntegral_continuousOn_ball
      derivativeFamily radius derivativeFamilyContinuous
  let integrand : E → ℝ → F :=
    fun point parameter => oneForm (parameter • point) point
  have integrandContinuous : ContinuousOn (Function.uncurry integrand)
      (closedBall (0 : E) radius ×ˢ Icc (0 : ℝ) 1) := by
    change ContinuousOn
      (fun pair : E × ℝ => oneForm (pair.2 • pair.1) pair.1)
      (closedBall (0 : E) radius ×ˢ Icc (0 : ℝ) 1)
    have coefficientContinuous : ContinuousOn
        (fun pair : E × ℝ => oneForm (pair.2 • pair.1))
        (closedBall (0 : E) radius ×ˢ Icc (0 : ℝ) 1) :=
      regularOn'.continuousOn.comp
        (continuous_snd.smul continuous_fst).continuousOn
        (by
          intro pair pairMem
          exact radialMapsToCorridor pair.1 pairMem.1 pair.2 pairMem.2)
    exact coefficientContinuous.clm_apply continuous_fst.continuousOn
  have compactDomain : IsCompact
      (closedBall (0 : E) radius ×ˢ Icc (0 : ℝ) 1) :=
    (isCompact_closedBall (0 : E) radius).prod isCompact_Icc
  obtain ⟨bound, derivativeBound⟩ :=
    compactDomain.exists_bound_of_continuousOn derivativeFamilyContinuous
  have integrandIntervalIntegrable
      (point : E) (pointMem : point ∈ ball (0 : E) radius) :
      IntervalIntegrable (integrand point) volume 0 1 := by
    have sectionContinuous : ContinuousOn (integrand point) (Icc (0 : ℝ) 1) :=
      integrandContinuous.comp
        (continuous_const.prodMk continuous_id).continuousOn
        (by
          intro parameter parameterMem
          exact ⟨ball_subset_closedBall pointMem, parameterMem⟩)
    exact sectionContinuous.intervalIntegrable_of_Icc (by norm_num)
  have derivativeIntervalIntegrable
      (point : E) (pointMem : point ∈ ball (0 : E) radius) :
      IntervalIntegrable (derivativeFamily point) volume 0 1 := by
    have sectionContinuous : ContinuousOn (derivativeFamily point)
        (Icc (0 : ℝ) 1) :=
      derivativeFamilyContinuous.comp
        (continuous_const.prodMk continuous_id).continuousOn
        (by
          intro parameter parameterMem
          exact ⟨ball_subset_closedBall pointMem, parameterMem⟩)
    exact sectionContinuous.intervalIntegrable_of_Icc (by norm_num)
  apply contDiffAt_one_iff.mpr
  refine ⟨derivative, ball (0 : E) radius,
    ball_mem_nhds _ radius_pos, derivativeContinuous, ?_⟩
  intro point pointMem
  have differentiated :
      HasFDerivAt
        (fun endpoint => ∫ parameter in (0 : ℝ)..1,
          integrand endpoint parameter)
        (∫ parameter in (0 : ℝ)..1, derivativeFamily point parameter)
        point := by
    apply intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le
        (μ := volume)
        (s := ball (0 : E) radius)
        (F := fun candidate parameter => integrand candidate parameter)
        (F' := fun candidate parameter => derivativeFamily candidate parameter)
        (bound := fun _ => bound)
    · exact isOpen_ball.mem_nhds pointMem
    · filter_upwards [isOpen_ball.mem_nhds pointMem] with candidate candidateMem
      exact (integrandIntervalIntegrable candidate candidateMem).def'
        |>.aestronglyMeasurable
    · exact integrandIntervalIntegrable point pointMem
    · exact (derivativeIntervalIntegrable point pointMem).def'
        |>.aestronglyMeasurable
    · filter_upwards [] with parameter parameterMem
      intro candidate candidateMem
      have parameterMem' : parameter ∈ Icc (0 : ℝ) 1 := by
        have actual := uIoc_subset_uIcc parameterMem
        simpa [uIcc_of_le (by norm_num : (0 : ℝ) ≤ 1)] using actual
      exact derivativeBound (candidate, parameter)
        ⟨ball_subset_closedBall candidateMem, parameterMem'⟩
    · exact intervalIntegrable_const
    · filter_upwards [] with parameter parameterMem
      intro candidate candidateMem
      have parameterMem' : parameter ∈ Icc (0 : ℝ) 1 := by
        have actual := uIoc_subset_uIcc parameterMem
        simpa [uIcc_of_le (by norm_num : (0 : ℝ) ≤ 1)] using actual
      have scaled :
          HasFDerivAt (fun endpoint : E => parameter • endpoint)
            (parameter • ContinuousLinearMap.id ℝ E) candidate :=
        (hasFDerivAt_id candidate).const_smul parameter
      have coefficient :
          HasFDerivAt (fun endpoint : E => oneForm (parameter • endpoint))
            ((fderiv ℝ oneForm (parameter • candidate)).comp
              (parameter • ContinuousLinearMap.id ℝ E)) candidate :=
        (((regularOn'.differentiableOn (by norm_num)).differentiableAt
          (corridorOpen.mem_nhds
            (radialMapsToCorridor candidate
              (ball_subset_closedBall candidateMem) parameter parameterMem'))
          ).hasFDerivAt).comp candidate scaled
      simpa [integrand, derivativeFamily,
        radialCurveIntegralDerivativeIntegrand] using
          coefficient.clm_apply (hasFDerivAt_id candidate)
  simpa [derivative, integrand, derivativeFamily, curveIntegral_segment,
    AffineMap.lineMap_apply] using differentiated

/-! ## Exact endpoint readout and transverse defect -/

/-- The curve integral of the generated Fréchet derivative along the source
ray is exactly the endpoint difference.  This is the source-native
fundamental-theorem readout used to expose value-level radial defects. -/
theorem curveIntegral_fderiv_segment_eq_sub_of_contDiff
    {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    (field : E → F)
    (regular : ContDiff ℝ 1 field)
    (point : E) :
    (∫ᶜ contact in Path.segment (0 : E) point,
        fderiv ℝ field contact) =
      field point - field 0 := by
  let path : ℝ → E := fun parameter => parameter • point
  let derivative : ℝ → F := fun parameter =>
    fderiv ℝ field (path parameter) point
  have pathDerivative (parameter : ℝ) :
      HasDerivAt path point parameter := by
    simpa [path] using (hasDerivAt_id parameter).smul_const point
  have derivativeAt (parameter : ℝ) :
      HasDerivAt (fun candidate => field (path candidate))
        (derivative parameter) parameter := by
    exact (regular.differentiable (by norm_num) (path parameter)
      ).hasFDerivAt.comp_hasDerivAt parameter (pathDerivative parameter)
  have derivativeContinuous : Continuous derivative := by
    have fieldDerivativeContinuous : Continuous (fderiv ℝ field) :=
      regular.continuous_fderiv (by norm_num)
    unfold derivative path
    fun_prop
  have ftc := intervalIntegral.integral_eq_sub_of_hasDerivAt
    (a := (0 : ℝ)) (b := 1)
    (fun parameter _ => derivativeAt parameter)
    (derivativeContinuous.intervalIntegrable (0 : ℝ) 1)
  rw [curveIntegral_segment]
  simpa [path, derivative, AffineMap.lineMap_apply] using ftc

/-- Fundamental-theorem readout along the source ray, with an arbitrary
output direction retained.  This is the cancellation term that isolates the
antisymmetric part of the one-form derivative below. -/
private theorem radialOneForm_endpoint_ftc
    {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    (oneForm : E → E →L[ℝ] F)
    (regular : ContDiff ℝ 1 oneForm)
    (point direction : E) :
    (∫ parameter in (0 : ℝ)..1,
        oneForm (parameter • point) direction +
          parameter • fderiv ℝ oneForm (parameter • point) point direction) =
      oneForm point direction := by
  let primitive : ℝ → F := fun parameter =>
    parameter • oneForm (parameter • point) direction
  let derivative : ℝ → F := fun parameter =>
    oneForm (parameter • point) direction +
      parameter • fderiv ℝ oneForm (parameter • point) point direction
  have derivativeAt (parameter : ℝ) :
      HasDerivAt primitive (derivative parameter) parameter := by
    have scaled : HasDerivAt (fun candidate : ℝ => candidate • point)
        point parameter := by
      simpa using (hasDerivAt_id parameter).smul_const point
    have formDerivative :
        HasDerivAt (fun candidate : ℝ => oneForm (candidate • point))
          (fderiv ℝ oneForm (parameter • point) point) parameter := by
      exact (regular.differentiable (by norm_num) (parameter • point)
        ).hasFDerivAt.comp_hasDerivAt parameter scaled
    have evaluated :
        HasDerivAt (fun candidate : ℝ => oneForm (candidate • point) direction)
          (fderiv ℝ oneForm (parameter • point) point direction) parameter := by
      exact (ContinuousLinearMap.apply ℝ F direction).hasFDerivAt.comp_hasDerivAt
        parameter formDerivative
    have product := (hasDerivAt_id' parameter).smul evaluated
    change HasDerivAt
      (fun candidate : ℝ => candidate • oneForm (candidate • point) direction)
      _ parameter at product
    simpa only [primitive, derivative, one_smul, add_comm] using product
  have derivativeContinuous : Continuous derivative := by
    have oneFormContinuous : Continuous oneForm := regular.continuous
    have oneFormDerivativeContinuous : Continuous (fderiv ℝ oneForm) :=
      regular.continuous_fderiv (by norm_num)
    unfold derivative
    fun_prop
  have ftc := intervalIntegral.integral_eq_sub_of_hasDerivAt
    (a := (0 : ℝ)) (b := 1)
    (fun parameter _ => derivativeAt parameter)
    (derivativeContinuous.intervalIntegrable (0 : ℝ) 1)
  simpa [primitive, derivative] using ftc

/-- The radial component of the unconditional first jet is the endpoint
one-form itself.  This is a one-dimensional fundamental-theorem readout of
the emitted radial path; it uses no closedness or target-jet premise. -/
theorem radialCurveIntegralFirstJet_apply_radial
    {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    (oneForm : E → E →L[ℝ] F)
    (regular : ContDiff ℝ 1 oneForm)
    (point : E) :
    (∫ parameter in (0 : ℝ)..1,
      radialCurveIntegralDerivativeIntegrand oneForm point parameter point) =
      oneForm point point := by
  rw [← radialOneForm_endpoint_ftc oneForm regular point point]
  apply intervalIntegral.integral_congr
  intro parameter _
  unfold radialCurveIntegralDerivativeIntegrand
  change
    oneForm (parameter • point) point +
        fderiv ℝ oneForm (parameter • point) (parameter • point) point =
      oneForm (parameter • point) point +
        parameter • fderiv ℝ oneForm (parameter • point) point point
  rw [map_smul]
  simp only [smul_apply]

/-- Continuous-linear-map form of
`radialCurveIntegralFirstJet_apply_radial`.  This is the reusable endpoint
readout consumed by emitted coframe and connection paths. -/
theorem radialCurveIntegralFirstJetCLM_apply_radial
    {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    (oneForm : E → E →L[ℝ] F)
    (regular : ContDiff ℝ 1 oneForm)
    (point : E) :
    (∫ parameter in (0 : ℝ)..1,
      radialCurveIntegralDerivativeIntegrand oneForm point parameter) point =
      oneForm point point := by
  have integrandContinuous : Continuous fun parameter : ℝ =>
      radialCurveIntegralDerivativeIntegrand oneForm point parameter := by
    have oneFormContinuous : Continuous oneForm := regular.continuous
    have oneFormDerivativeContinuous : Continuous (fderiv ℝ oneForm) :=
      regular.continuous_fderiv (by norm_num)
    unfold radialCurveIntegralDerivativeIntegrand
    fun_prop
  rw [ContinuousLinearMap.intervalIntegral_apply
    (integrandContinuous.intervalIntegrable (0 : ℝ) 1) point]
  exact radialCurveIntegralFirstJet_apply_radial oneForm regular point

/-- Exactification defect of the emitted radial first jet against the
source one-form at its endpoint.  It is generated by the same path and is a
readout, not a premise. -/
def radialCurveIntegralFirstJetDefect
    {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    (oneForm : E → E →L[ℝ] F)
    (point : E) : E →L[ℝ] F :=
  (∫ parameter in (0 : ℝ)..1,
    radialCurveIntegralDerivativeIntegrand oneForm point parameter) -
      oneForm point

/-- Exact obstruction formula: the emitted radial first-jet defect is the
source-history integral of the antisymmetric part of the one-form derivative.
Thus closedness is a generated, inspectable obligation rather than an
unstructured acceptance premise. -/
theorem radialCurveIntegralFirstJetDefect_apply_eq_integral_antisymmetry
    {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    (oneForm : E → E →L[ℝ] F)
    (regular : ContDiff ℝ 1 oneForm)
    (point direction : E) :
    radialCurveIntegralFirstJetDefect oneForm point direction =
      ∫ parameter in (0 : ℝ)..1,
        parameter •
          (fderiv ℝ oneForm (parameter • point) direction point -
            fderiv ℝ oneForm (parameter • point) point direction) := by
  have integrandContinuous : Continuous fun parameter : ℝ =>
      radialCurveIntegralDerivativeIntegrand oneForm point parameter := by
    have oneFormContinuous : Continuous oneForm := regular.continuous
    have oneFormDerivativeContinuous : Continuous (fderiv ℝ oneForm) :=
      regular.continuous_fderiv (by norm_num)
    unfold radialCurveIntegralDerivativeIntegrand
    fun_prop
  have endpointIntegrandContinuous : Continuous fun parameter : ℝ =>
      oneForm (parameter • point) direction +
        parameter • fderiv ℝ oneForm (parameter • point) point direction := by
    have oneFormContinuous : Continuous oneForm := regular.continuous
    have oneFormDerivativeContinuous : Continuous (fderiv ℝ oneForm) :=
      regular.continuous_fderiv (by norm_num)
    fun_prop
  unfold radialCurveIntegralFirstJetDefect
  rw [sub_apply, ContinuousLinearMap.intervalIntegral_apply
    (integrandContinuous.intervalIntegrable (0 : ℝ) 1) direction]
  rw [← radialOneForm_endpoint_ftc oneForm regular point direction]
  rw [← intervalIntegral.integral_sub
    ((integrandContinuous.clm_apply continuous_const).intervalIntegrable 0 1)
    (endpointIntegrandContinuous.intervalIntegrable 0 1)]
  apply intervalIntegral.integral_congr
  intro parameter _
  unfold radialCurveIntegralDerivativeIntegrand
  change
    (oneForm (parameter • point) direction +
          fderiv ℝ oneForm (parameter • point)
            (parameter • direction) point) -
        (oneForm (parameter • point) direction +
          parameter • fderiv ℝ oneForm (parameter • point) point direction) =
      parameter •
        (fderiv ℝ oneForm (parameter • point) direction point -
          fderiv ℝ oneForm (parameter • point) point direction)
  rw [map_smul]
  simp only [smul_apply]
  module

private theorem radialCurveIntegralFirstJetDefect_line_factor
    {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    (oneForm : E → E →L[ℝ] F)
    (regular : ContDiff ℝ 1 oneForm)
    (point direction : E)
    (scale : ℝ) :
    radialCurveIntegralFirstJetDefect oneForm (scale • point) direction =
      scale • ∫ parameter in (0 : ℝ)..1,
        parameter •
          (fderiv ℝ oneForm (parameter • (scale • point)) direction point -
            fderiv ℝ oneForm (parameter • (scale • point)) point direction) := by
  rw [radialCurveIntegralFirstJetDefect_apply_eq_integral_antisymmetry
    oneForm regular]
  rw [← intervalIntegral.integral_smul]
  apply intervalIntegral.integral_congr
  intro parameter _
  simp only [map_smul, smul_apply, smul_sub, smul_smul]
  module

private theorem radialCurveIntegralFirstJetDefect_line_average_continuous
    {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    (oneForm : E → E →L[ℝ] F)
    (regular : ContDiff ℝ 1 oneForm)
    (point direction : E) :
    Continuous (fun scale : ℝ =>
      ∫ parameter in (0 : ℝ)..1,
        parameter •
          (fderiv ℝ oneForm (parameter • (scale • point)) direction point -
            fderiv ℝ oneForm (parameter • (scale • point)) point direction)) := by
  have derivativeContinuous : Continuous (fderiv ℝ oneForm) :=
    regular.continuous_fderiv (by norm_num)
  have jointContinuous : Continuous (fun pair : ℝ × ℝ =>
      pair.2 •
        (fderiv ℝ oneForm (pair.2 • (pair.1 • point)) direction point -
          fderiv ℝ oneForm (pair.2 • (pair.1 • point)) point direction)) := by
    fun_prop
  exact intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
    jointContinuous 0 1

/-- The first germ of the radial exactification defect is one half of the
antisymmetric derivative of the emitted one-form. -/
theorem radialCurveIntegralFirstJetDefect_line_hasDerivAt_zero
    {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    (oneForm : E → E →L[ℝ] F)
    (regular : ContDiff ℝ 1 oneForm)
    (point direction : E) :
    HasDerivAt
      (fun scale : ℝ =>
        radialCurveIntegralFirstJetDefect oneForm (scale • point) direction)
      ((1 / 2 : ℝ) •
        (fderiv ℝ oneForm 0 direction point -
          fderiv ℝ oneForm 0 point direction)) 0 := by
  let average : ℝ → F := fun scale =>
    ∫ parameter in (0 : ℝ)..1,
      parameter •
        (fderiv ℝ oneForm (parameter • (scale • point)) direction point -
          fderiv ℝ oneForm (parameter • (scale • point)) point direction)
  have lineEq :
      (fun scale : ℝ =>
        radialCurveIntegralFirstJetDefect oneForm (scale • point) direction) =
      fun scale => scale • average scale := by
    funext scale
    exact radialCurveIntegralFirstJetDefect_line_factor oneForm regular
      point direction scale
  have averageContinuous : Continuous average := by
    exact radialCurveIntegralFirstJetDefect_line_average_continuous
      oneForm regular point direction
  have averageZero :
      average 0 =
        (1 / 2 : ℝ) •
          (fderiv ℝ oneForm 0 direction point -
            fderiv ℝ oneForm 0 point direction) := by
    dsimp [average]
    simp only [zero_smul, smul_zero]
    rw [intervalIntegral.integral_smul_const]
    norm_num
  rw [lineEq, ← averageZero]
  rw [hasDerivAt_iff_tendsto_slope_zero]
  refine (averageContinuous.continuousAt.mono_left inf_le_left).congr' ?_
  filter_upwards [self_mem_nhdsWithin] with scale scaleMem
  have scaleNe : scale ≠ 0 := by simpa using scaleMem
  simp [scaleNe]

/-- At the source contact, the radial primitive and its source germ have the
same first jet.  This is an origin statement; away from the contact the
transverse antisymmetry defect remains part of the generated evaluator. -/
theorem radialCurveIntegralFirstJetDefect_zero_of_contDiff
    {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [ProperSpace E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    (oneForm : E → E →L[ℝ] F)
    (regular : ContDiff ℝ 1 oneForm) :
    radialCurveIntegralFirstJetDefect oneForm 0 = 0 := by
  have generated :=
    radialCurveIntegral_hasFDerivAt_of_contDiff oneForm regular 0
  have source :=
    radialCurveIntegral_hasFDerivAt_zero_of_contDiffAt oneForm
      (regular.contDiffAt.of_le (by norm_num))
  unfold radialCurveIntegralFirstJetDefect
  exact sub_eq_zero.mpr (generated.unique source)

/-- The radial first jet is the endpoint one-form plus its generated
exactification defect. -/
theorem radialCurveIntegralFirstJet_eq_endpoint_add_defect
    {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    (oneForm : E → E →L[ℝ] F)
    (point : E) :
    (∫ parameter in (0 : ℝ)..1,
      radialCurveIntegralDerivativeIntegrand oneForm point parameter) =
      oneForm point + radialCurveIntegralFirstJetDefect oneForm point := by
  unfold radialCurveIntegralFirstJetDefect
  abel

/-- The generated exactification defect has no radial component.  Hence all
remaining non-closedness is transverse to the emitted source ray. -/
theorem radialCurveIntegralFirstJetDefect_apply_radial
    {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    (oneForm : E → E →L[ℝ] F)
    (regular : ContDiff ℝ 1 oneForm)
    (point : E) :
    radialCurveIntegralFirstJetDefect oneForm point point = 0 := by
  unfold radialCurveIntegralFirstJetDefect
  rw [sub_apply,
    radialCurveIntegralFirstJetCLM_apply_radial oneForm regular point]
  exact sub_self _

/-! ## Fixed Lorentz coordinate inventory -/

/-- The pre-registered linear lift from lowered bivector coordinates to a
primitive skew Lorentz connection. -/
def radialLorentzConnectionLiftCLM :
    LorentzBivectorOneForm →L[ℝ] PointwiseLorentzSpinConnection :=
  ({
    toFun := lorentzSkewConnectionOfBivectorOneForm
    map_add' := lorentzSkewConnectionOfBivectorOneForm_add
    map_smul' := lorentzSkewConnectionOfBivectorOneForm_smul
  } : LorentzBivectorOneForm →ₗ[ℝ] PointwiseLorentzSpinConnection
    ).toContinuousLinearMap

/-- Continuous coordinate projection for a pointwise Lorentz connection. -/
def radialLorentzConnectionCoordinateCLM
    (formDirection internalOut internalIn : LorentzianIndex) :
    PointwiseLorentzSpinConnection →L[ℝ] ℝ :=
  let formProjection :
      PointwiseLorentzSpinConnection →L[ℝ]
        (LorentzianIndex → LorentzianIndex → ℝ) :=
    ContinuousLinearMap.proj formDirection
  let internalOutProjection :
      (LorentzianIndex → LorentzianIndex → ℝ) →L[ℝ]
        (LorentzianIndex → ℝ) :=
    ContinuousLinearMap.proj internalOut
  let internalInProjection :
      (LorentzianIndex → ℝ) →L[ℝ] ℝ :=
    ContinuousLinearMap.proj internalIn
  internalInProjection.comp (internalOutProjection.comp formProjection)

end

