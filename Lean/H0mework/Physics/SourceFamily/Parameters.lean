import H0mework.Physics.RootRuntime.RuntimeOccurrence
import H0mework.Physics.SpinPair.Parameters

set_option autoImplicit false

namespace SaturationMonoid.PhysicsCore.Stage10.SourceUniqueness.SourceFamily

open ProofFreeRicherAnholonomicSource StageNineEnrichedProofFreeSource
open StageNineGlobalIntegratedAction StageNineDynamicBreakingVacuum
open Stage9C.Material.SpinPair

noncomputable section

/-- One local material operation on the original source's natural seed.
It retains every other source coordinate and does not install a runtime. -/
def advanceSource (current : SmoothUnifiedSource) : SmoothUnifiedSource :=
  { current with stageEight := { current.stageEight with sigmaSeed := current.stageEight.sigmaSeed + 1 } }

def sourceAt : ℕ → SmoothUnifiedSource
  | 0 => Runtime.source
  | step + 1 => advanceSource (sourceAt step)

theorem source_seed (step : ℕ) : (sourceAt step).stageEight.sigmaSeed = step := by
  induction step with
  | zero => rfl
  | succ step previous => change (sourceAt step).stageEight.sigmaSeed + 1 = _; rw [previous]

def coupling (step : ℕ) : ℝ := (sourceAt step).legacy.sigma

theorem coupling_value (step : ℕ) : coupling step = 1 / (step + 2 : ℝ) := by
  change 1 / ((sourceAt step).stageEight.sigmaSeed + 2 : ℝ) = _
  rw [source_seed]

theorem coupling_pos (step : ℕ) : 0 < coupling step := (sourceAt step).legacy.sigma_pos

theorem coupling_decreases (step : ℕ) : coupling (step + 1) < coupling step := by
  rw [coupling_value, coupling_value]
  apply one_div_lt_one_div_of_lt (by positivity)
  push_cast
  linarith

theorem source_couplings (step : ℕ) :
    ((sourceGeneratedUnifiedCouplings (sourceAt step)).strongCouplingSquared : ℝ) = coupling step ∧
    ((sourceGeneratedUnifiedCouplings (sourceAt step)).weakCouplingSquared : ℝ) = coupling step ∧
    ((sourceGeneratedUnifiedCouplings (sourceAt step)).hyperchargeCouplingSquared : ℝ) = coupling step :=
  ⟨rfl, rfl, rfl⟩

theorem vacuum_retained (step : ℕ) :
    sourceGeneratedVacuumCoordinates (sourceAt step) = sourceGeneratedVacuumCoordinates Runtime.source := by
  induction step with
  | zero => rfl
  | succ step previous => exact previous

theorem contact_retained (step : ℕ) :
    (sourceAt step).continuousContactResidual = Runtime.source.continuousContactResidual := by
  induction step with
  | zero => rfl
  | succ step previous => exact previous

theorem generated_contact_rate (step : ℕ) :
    (sourceAt step).continuousContactRate = coupling step * Runtime.source.continuousContactResidual := by
  rw [SmoothUnifiedSource.continuousContactRate_eq_scalar, contact_retained]
  rfl

/-- Clock amplitude is generated by the same gauge/spin balance. The
spacetime argument remains the original BasePoint throughout the field. -/
def clock (step : ℕ) : ℝ := Real.sqrt (gaugeScale ^ 3 / (2 * coupling step * spinScale))

def phaseRate (step : ℕ) : ℝ := 3 * clock step / 2 * (spinScale - gaugeScale)

theorem clock_pos (step : ℕ) : 0 < clock step :=
  Real.sqrt_pos.2 (div_pos (pow_pos gaugeScale_pos 3)
    (mul_pos (mul_pos (by norm_num) (coupling_pos step)) spinScale_pos))

theorem clock_square (step : ℕ) : clock step ^ 2 = gaugeScale ^ 3 / (2 * coupling step * spinScale) :=
  Real.sq_sqrt (le_of_lt (div_pos (pow_pos gaugeScale_pos 3)
    (mul_pos (mul_pos (by norm_num) (coupling_pos step)) spinScale_pos)))

theorem gauge_balance (step : ℕ) : gaugeScale ^ 3 = 2 * coupling step * clock step ^ 2 * spinScale := by
  rw [clock_square]
  field_simp [ne_of_gt (coupling_pos step), ne_of_gt spinScale_pos]

theorem coupling_clock_square (step : ℕ) : coupling step * clock step ^ 2 = 27 / 125 := by
  rw [clock_square, gaugeScale]
  field_simp [ne_of_gt (coupling_pos step), ne_of_gt spinScale_pos]
  nlinarith [spinScale_sq, sq_nonneg (spinScale ^ 2 - 2)]

theorem clock_zero : clock 0 = lapse := by
  have first := coupling_clock_square 0
  rw [coupling_value] at first
  have square := lapse_sq
  nlinarith [clock_pos 0, lapse_pos]

theorem phaseRate_zero : phaseRate 0 = frequency := by
  rw [phaseRate, clock_zero]
  rfl

theorem coframe_time_balance_at (step : ℕ) :
    3 * gaugeScale ^ 4 / (4 * coupling step * clock step ^ 2) -
      6 * (spinScale - gaugeScale) * spinScale = 3 - 3 * spinScale ^ 2 := by
  have ratio : coupling step * clock step ^ 2 = sourceCoupling * lapse ^ 2 := by
    rw [coupling_clock_square, sourceCoupling_eq, lapse_sq]
    norm_num
  have denominator : 4 * coupling step * clock step ^ 2 = 4 * sourceCoupling * lapse ^ 2 := by
    linear_combination 4 * ratio
  rw [denominator]
  exact coframe_time_balance

theorem coframe_spatial_balance_at (step : ℕ) :
    -(gaugeScale ^ 4 / (4 * coupling step * clock step)) +
      2 * clock step * (spinScale - gaugeScale) * spinScale = clock step * (3 - spinScale ^ 2) := by
  have balance := coupling_clock_square step
  have spin := spinScale_sq
  unfold gaugeScale
  field_simp [ne_of_gt (coupling_pos step), ne_of_gt (clock_pos step)]
  nlinarith [sq_nonneg (spinScale ^ 2 - 2)]

end
end SaturationMonoid.PhysicsCore.Stage10.SourceUniqueness.SourceFamily
