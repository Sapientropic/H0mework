/-! ## Whole-slice primitive fidelity -/

/-- The precise responsibility of the diagonal constructor.  It realizes all
nine primitive holonomic fields of one current-state update on one common
spacetime configuration.  `scalarVelocity` is intentionally absent because it
is a derived Cauchy readout, not a primitive holonomic field. -/
def PrimitiveSliceFidelity
    (candidate : StageNineHolonomicConfiguration)
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState) : Prop :=
  forall time space,
    candidate.coframe (canonicalCauchySlicePoint time space) =
        (currentCanonicalFullActionLorentzStateResponseUpdate source current
          time).coframe space ∧
    candidate.gravityConnection (canonicalCauchySlicePoint time space) =
        (currentCanonicalFullActionLorentzStateResponseUpdate source current
          time).gravityConnection space ∧
    candidate.gravityAuxiliary (canonicalCauchySlicePoint time space) =
        (currentCanonicalFullActionLorentzStateResponseUpdate source current
          time).gravityAuxiliary space ∧
    candidate.gravitySimplicityMultiplier
        (canonicalCauchySlicePoint time space) =
      (currentCanonicalFullActionLorentzStateResponseUpdate source current
        time).gravitySimplicityMultiplier space ∧
    candidate.gaugeConnection (canonicalCauchySlicePoint time space) =
        (currentCanonicalFullActionLorentzStateResponseUpdate source current
          time).gaugeConnection space ∧
    candidate.gaugeAuxiliary (canonicalCauchySlicePoint time space) =
        (currentCanonicalFullActionLorentzStateResponseUpdate source current
          time).gaugeAuxiliary space ∧
    candidate.scalar (canonicalCauchySlicePoint time space) =
        (currentCanonicalFullActionLorentzStateResponseUpdate source current
          time).scalar space ∧
    candidate.matter (canonicalCauchySlicePoint time space) =
        (currentCanonicalFullActionLorentzStateResponseUpdate source current
          time).matter space ∧
    candidate.conjugateMatter (canonicalCauchySlicePoint time space) =
      (currentCanonicalFullActionLorentzStateResponseUpdate source current
        time).conjugateMatter space

theorem coherentDiagonalActual_primitiveSliceFidelity
    (source : SmoothUnifiedSource) (current : StageNineCauchyState) :
    PrimitiveSliceFidelity
      (currentCanonicalFullActionLorentzCoherentDiagonalActual source current)
      source current := by
  intro time space
  exact ⟨coherentDiagonalActual_coframe_slice source current time space,
    coherentDiagonalActual_gravityConnection_slice source current time space,
    coherentDiagonalActual_gravityAuxiliary_slice source current time space,
    coherentDiagonalActual_multiplier_slice source current time space,
    coherentDiagonalActual_gaugeConnection_slice source current time space,
    coherentDiagonalActual_gaugeAuxiliary_slice source current time space,
    coherentDiagonalActual_scalar_slice source current time space,
    coherentDiagonalActual_matter_slice source current time space,
    coherentDiagonalActual_conjugateMatter_slice source current time space⟩

end

