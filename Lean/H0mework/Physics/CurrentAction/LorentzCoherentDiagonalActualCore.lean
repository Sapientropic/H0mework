/-- Diagonalize the complete per-contact actual family into one spacetime
field.  Every entry is still generated by the same source/current action
graph; no residual or endpoint enters this constructor. -/
def currentCanonicalFullActionLorentzCoherentDiagonalActual
    (source : SmoothUnifiedSource)
    (current : StageNineCauchyState) : StageNineHolonomicConfiguration where
  coframe := fun point =>
    (currentCanonicalFullActionLorentzStateResponseUpdate source current
      (canonicalTimeProjection point)).coframe
        (canonicalSpatialProjection point)
  gravityConnection := fun point =>
    (currentCanonicalFullActionLorentzStateResponseUpdate source current
      (canonicalTimeProjection point)).gravityConnection
        (canonicalSpatialProjection point)
  gravityAuxiliary := fun point =>
    (currentCanonicalFullActionLorentzStateResponseUpdate source current
      (canonicalTimeProjection point)).gravityAuxiliary
        (canonicalSpatialProjection point)
  gravitySimplicityMultiplier := fun point =>
    (currentCanonicalFullActionLorentzStateResponseUpdate source current
      (canonicalTimeProjection point)).gravitySimplicityMultiplier
        (canonicalSpatialProjection point)
  gaugeConnection := fun point =>
    (currentCanonicalFullActionLorentzStateResponseUpdate source current
      (canonicalTimeProjection point)).gaugeConnection
        (canonicalSpatialProjection point)
  gaugeAuxiliary := fun point =>
    (currentCanonicalFullActionLorentzStateResponseUpdate source current
      (canonicalTimeProjection point)).gaugeAuxiliary
        (canonicalSpatialProjection point)
  scalar := fun point =>
    (currentCanonicalFullActionLorentzStateResponseUpdate source current
      (canonicalTimeProjection point)).scalar
        (canonicalSpatialProjection point)
  matter := fun point =>
    (currentCanonicalFullActionLorentzStateResponseUpdate source current
      (canonicalTimeProjection point)).matter
        (canonicalSpatialProjection point)
  conjugateMatter := fun point =>
    (currentCanonicalFullActionLorentzStateResponseUpdate source current
      (canonicalTimeProjection point)).conjugateMatter
        (canonicalSpatialProjection point)

@[simp] theorem coherentDiagonalActual_coframe_slice
    (source : SmoothUnifiedSource) (current : StageNineCauchyState)
    (time : Real) (space : StageNineSpatialPoint) :
    (currentCanonicalFullActionLorentzCoherentDiagonalActual source current
      ).coframe (canonicalCauchySlicePoint time space) =
      (currentCanonicalFullActionLorentzStateResponseUpdate source current
        time).coframe space := by
  simp [currentCanonicalFullActionLorentzCoherentDiagonalActual]

