noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 500000
set_option maxRecDepth 100000
set_option linter.unusedSimpArgs false

/-! ## Action-generated coordinate readout -/

theorem preContorsionSpatialLorentzActionTarget_eq_normalForm :
    preContorsionSpatialLorentzActionTarget =
      fun spatial internalPair =>
        positiveMatterSpinCoordinatesNormalForm spatial.succ internalPair := by
  have matterNormalForm :
      lorentzMatterSpinCoordinates positiveSmoothUnifiedSource
          PreContorsionP286Actual 0 =
        positiveMatterSpinCoordinatesNormalForm :=
    positiveMatterSpinCoordinates_eq_normalForm_of_origin
      PreContorsionP286Actual
      (preContorsionP286Actual_coframe_one 0)
      preContorsionP286Actual_matter_origin
      preContorsionP286Actual_conjugateMatter_origin
  funext spatial internalPair
  unfold preContorsionSpatialLorentzActionTarget
  rw [lorentzConnectionAlgebraicSpinCurrentCoefficient_eq_sectors,
    preContorsionP286Actual_gravityBFAlgebraic_zero]
  have coordinate :=
    congrFun (congrFun matterNormalForm spatial.succ) internalPair
  change
    lorentzMatterSpinSourceCoefficient positiveSmoothUnifiedSource
        PreContorsionP286Actual
        (lorentzBivectorOneFormCoordinateDirection spatial.succ internalPair)
        0 =
      positiveMatterSpinCoordinatesNormalForm spatial.succ internalPair
    at coordinate
  linarith

theorem generatedSpatialSkewCoframeJet_eq_normalForm :
    generatedSpatialSkewCoframeJet =
      ![
        ![0, (1 / 2 : ℝ), 0, -(1 / 4 : ℝ), 0, 0],
        ![-(1 / 2 : ℝ), 0, 0, 0, -(1 / 4 : ℝ), 0],
        ![0, 0, 0, 0, 0, -(1 / 4 : ℝ)]
      ] := by
  unfold generatedSpatialSkewCoframeJet
  rw [preContorsionSpatialLorentzActionTarget_eq_normalForm]
  funext spatial internalPair
  fin_cases spatial <;> fin_cases internalPair <;>
    simp [einsteinCartanSpatialSkewCoframeCoordinates,
      positiveMatterSpinCoordinatesNormalForm] <;>
    ring

/-- Each generated spatial coframe jet is transverse to its own derivative
axis.  This is the zero responsible for the absence of an extra spatial
Dirac-principal density correction. -/
theorem generatedSpatialSkewCoframeJet_matchingRow_zero
    (spatial : Fin 3) (internal : LorentzianIndex) :
    loweredLorentzBivectorMatrix
        (generatedSpatialSkewCoframeJet spatial)
        spatial.succ internal =
      0 := by
  rw [generatedSpatialSkewCoframeJet_eq_normalForm]
  fin_cases spatial <;> fin_cases internal <;>
    simp [loweredLorentzBivectorMatrix,
      orientedLorentzBivectorBasisCoefficient, pairFirst, pairSecond,
      Fin.sum_univ_six]

/-- The temporal row is zero by the spatial lift, while the three spatial
rows are zero by the action-generated normal form above. -/
theorem generatedSpatialSkewCoframeJetLift_matchingRow_zero
    (direction internal : LorentzianIndex) :
    loweredLorentzBivectorMatrix
        (spatialSkewCoframeJetLift generatedSpatialSkewCoframeJet direction)
        direction internal =
      0 := by
  refine Fin.cases ?_ (fun spatial => ?_) direction
  · simp [spatialSkewCoframeJetLift, loweredLorentzBivectorMatrix]
  · simpa only [spatialSkewCoframeJetLift_spatial] using
      generatedSpatialSkewCoframeJet_matchingRow_zero spatial internal

/-! ## Generic matching-row transport -/

theorem skewCoframeAxis_matchingRow
    (coordinates : Fin 6 → ℝ)
    (direction : LorentzianIndex)
    (matchingRow :
      ∀ internal,
        loweredLorentzBivectorMatrix coordinates direction internal = 0)
    (parameter : ℝ) (internal : LorentzianIndex) :
    skewCoframeAxis coordinates parameter direction internal =
      (1 : LorentzianCoframe) direction internal := by
  simp [skewCoframeAxis, matchingRow internal]

theorem skewCoframeAxis_inverse_matchingRow
    (coordinates : Fin 6 → ℝ)
    (direction : LorentzianIndex)
    (matchingRow :
      ∀ internal,
        loweredLorentzBivectorMatrix coordinates direction internal = 0)
    (parameter : ℝ) (internal : LorentzianIndex) :
    (skewCoframeAxis coordinates parameter)⁻¹ direction internal =
      (1 : LorentzianCoframe) direction internal := by
  let coframe := skewCoframeAxis coordinates parameter
  have determinantNonzero : Matrix.det coframe ≠ 0 := by
    exact ne_of_gt (skewCoframeAxis_det_pos coordinates parameter)
  have inverseLaw :=
    Matrix.mul_nonsing_inv coframe
      (isUnit_iff_ne_zero.mpr determinantNonzero)
  have entry := congrFun (congrFun inverseLaw direction) internal
  change
    (∑ middle,
      coframe direction middle * coframe⁻¹ middle internal) =
        (1 : LorentzianCoframe) direction internal at entry
  have rowIdentity (middle : LorentzianIndex) :
      coframe direction middle =
        (1 : LorentzianCoframe) direction middle := by
    exact skewCoframeAxis_matchingRow coordinates direction matchingRow
      parameter middle
  simp_rw [rowIdentity] at entry
  simpa [Matrix.one_apply] using entry

theorem skewCoframeAxis_inverseGamma_matchingAxis
    (coordinates : Fin 6 → ℝ)
    (direction : LorentzianIndex)
    (matchingRow :
      ∀ internal,
        loweredLorentzBivectorMatrix coordinates direction internal = 0)
    (parameter : ℝ) :
    inverseCoframeDiracGamma
        { coframe := skewCoframeAxis coordinates parameter
          derivative := 0 }
        direction =
      diracGamma direction := by
  unfold inverseCoframeDiracGamma
  ext row column
  simp_rw [
    skewCoframeAxis_inverse_matchingRow coordinates direction matchingRow
      parameter]
  simp [Matrix.one_apply]

/-! ## Generated-profile specialization -/

theorem preContorsionSpatialProfileActual_coframe_axis
    (direction : LorentzianIndex) (parameter : ℝ) :
    preContorsionSpatialProfileActual.coframe
        (parameter • coordinateDirection direction) =
      skewCoframeAxis
        (spatialSkewCoframeJetLift generatedSpatialSkewCoframeJet direction)
        parameter := by
  change
    (skewCoframeActual
      (spatialSkewCoframeJetLift generatedSpatialSkewCoframeJet)).coframe
        (parameter • coordinateDirection direction) =
      _
  exact skewCoframeActual_axis_eq _ direction parameter

theorem preContorsionSpatialProfileActual_inverseGamma_axis
    (direction : LorentzianIndex) (parameter : ℝ) :
    inverseCoframeDiracGamma
        { coframe :=
            preContorsionSpatialProfileActual.coframe
              (parameter • coordinateDirection direction)
          derivative := 0 }
        direction =
      diracGamma direction := by
  rw [preContorsionSpatialProfileActual_coframe_axis]
  exact
    skewCoframeAxis_inverseGamma_matchingAxis
      (spatialSkewCoframeJetLift generatedSpatialSkewCoframeJet direction)
      direction
      (generatedSpatialSkewCoframeJetLift_matchingRow_zero direction)
      parameter

/-- The actual densitized Dirac principal on one matching coordinate axis,
applied to a fixed matter vector.  This is an operator readout of the
generated coframe, not a stored response. -/
def preContorsionSpatialProfileActualDensitizedMatterPrincipalAxis
    (direction : LorentzianIndex)
    (parameter : ℝ)
    (matter : DiracExteriorMatterCarrier) :
    MatterCoordinateCarrier :=
  matterCoordinateEquiv
    (abs
        (Matrix.det
          (preContorsionSpatialProfileActual.coframe
            (parameter • coordinateDirection direction))) •
      (Complex.I •
        diracMatrixMatterAction
          (inverseCoframeDiracGamma
            { coframe :=
                preContorsionSpatialProfileActual.coframe
                  (parameter • coordinateDirection direction)
              derivative := 0 }
            direction)
          matter))

/-- The density factor of the same actual has zero first derivative along
every matching coordinate axis.  Together with the exact inverse-gamma
theorem above, this is the full first-order geometric part of the
densitized Dirac principal divergence. -/
theorem preContorsionSpatialProfileActual_volumeDensity_axis_hasDerivAt_zero
    (direction : LorentzianIndex) :
    HasDerivAt
      (fun parameter : ℝ =>
        abs
          (Matrix.det
            (preContorsionSpatialProfileActual.coframe
              (parameter • coordinateDirection direction))))
      0 0 := by
  rw [show
    (fun parameter : ℝ =>
      abs
        (Matrix.det
          (preContorsionSpatialProfileActual.coframe
            (parameter • coordinateDirection direction)))) =
      fun parameter : ℝ =>
        abs
          (Matrix.det
            (skewCoframeAxis
              (spatialSkewCoframeJetLift generatedSpatialSkewCoframeJet
                direction)
              parameter)) by
    funext parameter
    rw [preContorsionSpatialProfileActual_coframe_axis]]
  exact skewCoframeAxis_abs_det_hasDerivAt_zero _

/-- Every coordinate contribution to the densitized Dirac-principal
divergence has zero derivative on the actual P506 profile.  This is stronger
than cancellation after summing the axes. -/
theorem
    preContorsionSpatialProfileActual_densitizedMatterPrincipal_axis_hasDerivAt_zero
    (direction : LorentzianIndex)
    (matter : DiracExteriorMatterCarrier) :
    HasDerivAt
      (fun parameter : ℝ =>
        preContorsionSpatialProfileActualDensitizedMatterPrincipalAxis
          direction parameter matter)
      0 0 := by
  rw [show
    (fun parameter : ℝ =>
      preContorsionSpatialProfileActualDensitizedMatterPrincipalAxis
        direction parameter matter) =
      fun parameter : ℝ =>
        abs
            (Matrix.det
              (preContorsionSpatialProfileActual.coframe
                (parameter • coordinateDirection direction))) •
          matterCoordinateEquiv
            (Complex.I •
              diracMatrixMatterAction (diracGamma direction) matter) by
    funext parameter
    unfold
      preContorsionSpatialProfileActualDensitizedMatterPrincipalAxis
    rw [preContorsionSpatialProfileActual_inverseGamma_axis]
    exact
      matterCoordinateEquiv.toLinearMap.map_smul_of_tower
        (abs
          (Matrix.det
            (preContorsionSpatialProfileActual.coframe
              (parameter • coordinateDirection direction))))
        (Complex.I •
          diracMatrixMatterAction (diracGamma direction) matter)]
  simpa using
    (preContorsionSpatialProfileActual_volumeDensity_axis_hasDerivAt_zero
      direction).smul_const
      (matterCoordinateEquiv
        (Complex.I • diracMatrixMatterAction (diracGamma direction) matter))

/-- Full geometric Dirac-principal divergence at the common contact.  The
matter vector is held fixed: derivatives of the primal or dual fields belong
to their action-generated evolution laws, not to this geometric operator. -/
def preContorsionSpatialProfileActualDensitizedMatterPrincipalDivergenceOrigin
    (matter : DiracExteriorMatterCarrier) :
    MatterCoordinateCarrier :=
  ∑ direction : LorentzianIndex,
    deriv
      (fun parameter : ℝ =>
        preContorsionSpatialProfileActualDensitizedMatterPrincipalAxis
          direction parameter matter)
      0

/-- The complete densitized principal geometry has no origin drift on this
source/action-generated actual.  Hence this profile does not require a new
adjoint density-correction epoch at the common contact. -/
theorem
    preContorsionSpatialProfileActual_densitizedMatterPrincipalDivergence_origin :
    preContorsionSpatialProfileActualDensitizedMatterPrincipalDivergenceOrigin =
      0 := by
  funext matter
  unfold
    preContorsionSpatialProfileActualDensitizedMatterPrincipalDivergenceOrigin
  apply Finset.sum_eq_zero
  intro direction _
  exact
    (preContorsionSpatialProfileActual_densitizedMatterPrincipal_axis_hasDerivAt_zero
      direction matter).deriv

end

end
