/-- The response generated by the same action graph is tangent to the
Plebanski simplicity surface at the canonical profile contact.  The zeroes
on both sides are outputs of the existing action grammar, not supplied
constraint receipts. -/
theorem preContorsionSpatialProfileCurrent_response_tangentSimplicity :
    (currentCanonicalFullActionLorentzStateResponse
        positiveSmoothUnifiedSource PreContorsionSpatialProfileCurrent
        0).gravityAuxiliary =
      physicalIIPlusCoframeTangent
        (PreContorsionSpatialProfileCurrent.coframe 0)
        (fun internal coordinate =>
          (currentCanonicalFullActionLorentzStateResponse
            positiveSmoothUnifiedSource PreContorsionSpatialProfileCurrent
            0).coframe internal coordinate) := by
  rw [currentCanonicalFullActionLorentzStateResponse_gravityAuxiliary,
    preContorsionSpatialProfileCurrent_lorentzAuxiliaryVelocity_zero]
  change
    (0 : PhysicalBivector) =
      physicalIIPlusCoframeTangent
        (PreContorsionSpatialProfileCurrent.coframe 0) 0
  funext internalPair spacetimePair
  fin_cases internalPair <;>
  simp [physicalIIPlusCoframeTangent, coframeWedgeTangent,
    internalBivectorDual, lorentzianCoframeHodge]

/-- The response-level law is realized by the genuine time derivatives of
one and the same C3h200k actual at its generated zero slice. -/
theorem
    positiveP506MatterPreContorsionSpatialProfileCoherentFirstGermActual_tangentSimplicity :
    (fun internalPair spacetimePair =>
      deriv
          (fun time : Real =>
            positiveP506MatterPreContorsionSpatialProfileCoherentFirstGermActual.gravityAuxiliary
              (canonicalCauchySlicePoint time 0)
              internalPair spacetimePair)
          0) =
      physicalIIPlusCoframeTangent
          (positiveP506MatterPreContorsionSpatialProfileCoherentFirstGermActual.coframe
            (canonicalCauchySlicePoint 0 0))
          (fun internal coordinate =>
            deriv
              (fun time : Real =>
                positiveP506MatterPreContorsionSpatialProfileCoherentFirstGermActual.coframe
                  (canonicalCauchySlicePoint time 0)
                  internal coordinate)
              0) := by
  have coframeOrigin :
      positiveP506MatterPreContorsionSpatialProfileCoherentFirstGermActual.coframe
          (canonicalCauchySlicePoint 0 0) =
        PreContorsionSpatialProfileCurrent.coframe 0 := by
    change
      (currentCanonicalFullActionLorentzCoherentDiagonalActual
        positiveSmoothUnifiedSource
        PreContorsionSpatialProfileCurrent).coframe
          (canonicalCauchySlicePoint 0 0) =
        PreContorsionSpatialProfileCurrent.coframe 0
    rw [coherentDiagonalActual_coframe_slice,
      preContorsionSpatialProfileCurrent_zeroStep]
  have coframeTangent :
      (fun internal coordinate =>
          deriv
            (fun time : Real =>
              positiveP506MatterPreContorsionSpatialProfileCoherentFirstGermActual.coframe
                (canonicalCauchySlicePoint time 0)
                internal coordinate)
            0) =
        (fun internal coordinate =>
          (currentCanonicalFullActionLorentzStateResponse
            positiveSmoothUnifiedSource PreContorsionSpatialProfileCurrent
            0).coframe internal coordinate) := by
    funext internal coordinate
    exact coherentDiagonalActual_coframe_originTangent
      positiveSmoothUnifiedSource PreContorsionSpatialProfileCurrent
      0 internal coordinate
  rw [coframeOrigin, coframeTangent]
  funext internalPair spacetimePair
  change
    deriv
        (fun time : Real =>
          (currentCanonicalFullActionLorentzCoherentDiagonalActual
            positiveSmoothUnifiedSource
            PreContorsionSpatialProfileCurrent).gravityAuxiliary
              (canonicalCauchySlicePoint time 0)
              internalPair spacetimePair)
        0 = _
  rw [coherentDiagonalActual_gravityAuxiliary_originTangent]
  exact congrFun
    (congrFun preContorsionSpatialProfileCurrent_response_tangentSimplicity
      internalPair)
    spacetimePair

