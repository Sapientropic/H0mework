        (p286TemporalGaugeOneForm component) 0 :=
      coherentProfileActual_p286AlgebraicCurrent_eq_profile _
    _ = p286GaugeConnectionSpatialBFMomentumDivergence
        preContorsionSpatialProfileActual
        (p286TemporalGaugeOneForm component) 0 :=
      preContorsionSpatialProfileActual_p286Gauss_origin component
    _ = p286GaugeConnectionSpatialBFMomentumDivergence
        positiveP506MatterPreContorsionSpatialProfileCoherentFirstGermActual
        (p286TemporalGaugeOneForm component) 0 :=
      (coherentProfileActual_p286SpatialBFDivergence_eq_profile _).symm

