private theorem preContorsionSpatialProfileActual_p286AlgebraicCurrent_eq_direct
    (direction : P286GaugeOneForm) :
    p286GaugeConnectionAlgebraicCurrentCoefficient positiveSmoothUnifiedSource
        preContorsionSpatialProfileActual direction 0 =
      p286GaugeConnectionAlgebraicCurrentCoefficient positiveSmoothUnifiedSource
        PreContorsionP286Actual direction 0 := by
