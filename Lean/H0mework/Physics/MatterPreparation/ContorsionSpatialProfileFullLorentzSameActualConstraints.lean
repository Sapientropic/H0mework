  let base := currentCanonicalFullActionBaseActual positiveSmoothUnifiedSource
    PreContorsionSpatialProfileCurrent space
  let slice := canonicalCauchySlicePoint 0 space
  have coframeEq : base.coframe 0 =
      preContorsionSpatialProfileActual.coframe slice := by
    rfl
  have gaugeConnectionEq : base.gaugeConnection 0 =
      preContorsionSpatialProfileActual.gaugeConnection slice := by
    change
      sourceGeneratedP286ActionLocalConnection positiveSmoothUnifiedSource
          PreContorsionSpatialProfileCurrent space 0 =
        preContorsionSpatialProfileActual.gaugeConnection slice
    funext formDirection
    rw [sourceGeneratedP286ActionLocalConnection_origin]
    rfl
  have gaugeAuxiliaryEq : base.gaugeAuxiliary 0 =
      preContorsionSpatialProfileActual.gaugeAuxiliary slice := by
    rfl
  have scalarEq : base.scalar 0 =
      preContorsionSpatialProfileActual.scalar slice := by
    rw [preContorsionSpatialProfileCurrent_baseScalar_vacuum,
      preContorsionSpatialProfileActual_scalar_vacuum]
  have scalarCovariantDerivativeEq :
      holonomicScalarCovariantDerivative base 0 =
        holonomicScalarCovariantDerivative preContorsionSpatialProfileActual
          slice := by
    unfold holonomicScalarCovariantDerivative
    rw [preContorsionSpatialProfileCurrent_baseScalar_vacuum,
      preContorsionSpatialProfileActual_scalar_vacuum,
      gaugeConnectionEq]
    simp [fieldDirectionalDerivative]
  have matterEq : base.matter 0 =
      preContorsionSpatialProfileActual.matter slice := by
    change
      (sourceActionGeneratedJointLocalActualLift positiveSmoothUnifiedSource
        PreContorsionSpatialProfileCurrent space).matter 0 = _
    rw [sourceActionGeneratedJointLocalActualLift_initialMatter]
    rfl
  have conjugateMatterEq : base.conjugateMatter 0 =
      preContorsionSpatialProfileActual.conjugateMatter slice := by
    change
      (sourceActionGeneratedJointLocalActualLift positiveSmoothUnifiedSource
        PreContorsionSpatialProfileCurrent space).conjugateMatter 0 = _
    rw [sourceActionGeneratedJointLocalActualLift_initialConjugateMatter]
    rfl
  exact p286AlgebraicCurrent_eq_of_contacts positiveSmoothUnifiedSource
    base preContorsionSpatialProfileActual 0 slice coframeEq
    gaugeConnectionEq gaugeAuxiliaryEq scalarEq
    scalarCovariantDerivativeEq matterEq conjugateMatterEq direction

