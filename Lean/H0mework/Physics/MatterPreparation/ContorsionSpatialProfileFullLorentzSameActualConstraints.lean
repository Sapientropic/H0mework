/-! ## Same-actual simplicity -/

/-- The final C3h200n actual remains on the simplicity surface at the common
contact.  This is stated directly on the final actual, not through a stored
residual-zero certificate. -/
theorem fullLorentzTriangularActual_simplicity_origin :
    positiveP506MatterPreContorsionSpatialProfileFullLorentzTriangularActual.gravityAuxiliary
        0 =
      physicalIIPlusBivector
        (positiveP506MatterPreContorsionSpatialProfileFullLorentzTriangularActual.coframe
          0) := by
  rw [fullLorentzTriangularActual_gravityAuxiliary_origin,
    fullLorentzTriangularActual_coframe_origin]

/-- Exact failure-capable mouth for canonical-origin tangent simplicity.
It mentions only one actual and its genuine time derivatives, so regressions
can test the same statement rather than a stronger full-simplicity surrogate. -/
def CanonicalGravityOriginTangentSimplicity
    (actual : StageNineHolonomicConfiguration) : Prop :=
  (fun internalPair spacetimePair =>
    deriv
        (fun time : Real =>
          actual.gravityAuxiliary (canonicalCauchySlicePoint time 0)
            internalPair spacetimePair)
        0) =
    physicalIIPlusCoframeTangent
      (actual.coframe (canonicalCauchySlicePoint 0 0))
      (fun internal coordinate =>
        deriv
          (fun time : Real =>
            actual.coframe (canonicalCauchySlicePoint time 0)
              internal coordinate)
          0)

/-- The canonical-time first germ of the same final actual is tangent to the
simplicity surface.  The connection-only C3h200n write leaves both primitive
fields in this equation unchanged on the whole carrier. -/
theorem fullLorentzTriangularActual_tangentSimplicity :
    (fun internalPair spacetimePair =>
      deriv
          (fun time : Real =>
            positiveP506MatterPreContorsionSpatialProfileFullLorentzTriangularActual.gravityAuxiliary
              (canonicalCauchySlicePoint time 0)
              internalPair spacetimePair)
          0) =
      physicalIIPlusCoframeTangent
          (positiveP506MatterPreContorsionSpatialProfileFullLorentzTriangularActual.coframe
            (canonicalCauchySlicePoint 0 0))
          (fun internal coordinate =>
            deriv
              (fun time : Real =>
                positiveP506MatterPreContorsionSpatialProfileFullLorentzTriangularActual.coframe
                  (canonicalCauchySlicePoint time 0)
                  internal coordinate)
              0) := by
  simpa only [
    positiveP506MatterPreContorsionSpatialProfileFullLorentzTriangularActual,
    changedBackgroundLorentzOriginCarrier_gravityAuxiliary,
    changedBackgroundLorentzOriginCarrier_coframe] using
    positiveP506MatterPreContorsionSpatialProfileCoherentFirstGermActual_tangentSimplicity

theorem fullLorentzTriangularActual_canonicalOriginTangentSimplicity :
    CanonicalGravityOriginTangentSimplicity
      positiveP506MatterPreContorsionSpatialProfileFullLorentzTriangularActual :=
  fullLorentzTriangularActual_tangentSimplicity

/-! ## P286 origin preparation -/

/-- The direct P286 response is origin faithful, and the exact P506 matter
state carries no primitive P286 auxiliary value at the selected contact.
The generated radial auxiliary profile therefore begins at zero. -/
private theorem preContorsionP286Actual_gaugeAuxiliary_origin_zero :
    PreContorsionP286Actual.gaugeAuxiliary 0 = 0 := by
  change
    (currentP286CompleteActionResponseOperator positiveSmoothUnifiedSource
      (currentCanonicalFullActionBaseActual positiveSmoothUnifiedSource
        positiveSourceTargetMatterCauchyState 0)).gaugeAuxiliary 0 = 0
  rw [currentP286CompleteActionResponseOperator_gaugeAuxiliary_origin]
  rfl

private def preContorsionP286BaseActual :
    StageNineHolonomicConfiguration :=
  currentCanonicalFullActionBaseActual positiveSmoothUnifiedSource
    positiveSourceTargetMatterCauchyState 0

private def preContorsionP286GaussAxisAuxiliary
    (axis : Fin 3) : P286GaugeTwoForm :=
  canonicalP286EqualAxisCoefficient •
    p286GaussAuxiliaryAxisEmbedding
      (currentP286GaussCharge positiveSmoothUnifiedSource
        preContorsionP286BaseActual)
      axis

/-- Along every spatial coordinate line, the already generated P286
auxiliary germ is exactly linear and starts at zero.  The coefficient and
axis embedding belong to the parameter-free P286 producer. -/
private theorem preContorsionP286Actual_auxiliary_spatialAxis
    (axis : Fin 3) (parameter : ℝ) :
    holonomicP286GaugeAuxiliaryCoordinate PreContorsionP286Actual
        (parameter • coordinateDirection axis.succ) =
      parameter • preContorsionP286GaussAxisAuxiliary axis := by
  rw [show PreContorsionP286Actual =
      currentP286CompleteActionResponseOperator positiveSmoothUnifiedSource
        preContorsionP286BaseActual by rfl]
  rw [currentP286CompleteActionResponseOperator_auxiliaryCoordinate]
  unfold currentP286CompleteResponseAuxiliaryCoordinate
  have originZero :
      currentP286OriginAuxiliaryCoordinate preContorsionP286BaseActual = 0 := by
    have baseZero : preContorsionP286BaseActual.gaugeAuxiliary 0 = 0 := by
      rw [← currentP286CompleteActionResponseOperator_gaugeAuxiliary_origin
        positiveSmoothUnifiedSource preContorsionP286BaseActual]
      exact preContorsionP286Actual_gaugeAuxiliary_origin_zero
    funext pair
    unfold currentP286OriginAuxiliaryCoordinate
    rw [congrFun baseZero pair]
    exact map_zero p286CoordinateEquiv
  rw [originZero]
  funext pair
  fin_cases axis <;>
    simp [currentP286CanonicalGaussRadialAuxiliaryProfile,
      symmetricP286GaussRadialAuxiliaryProfile,
      preContorsionP286GaussAxisAuxiliary,
      coordinateDirection, canonicalLorentzianTimeDirection,
      Fin.sum_univ_three, Pi.smul_apply, smul_smul, mul_comm]

private theorem p286HodgePairing_smul_left
    (coframe : LorentzianCoframe)
    (parameter : ℝ) (first test : P286GaugeTwoForm) :
    p286GaugeAuxiliaryHodgePairingPolynomial coframe
        (parameter • first) test =
      parameter *
        p286GaugeAuxiliaryHodgePairingPolynomial coframe first test := by
  unfold p286GaugeAuxiliaryHodgePairingPolynomial
  rw [liftGaugeTwoFormOperator_smul_p286]
  simp_rw [Pi.smul_apply, p286CoordinateLiePairing_smul_left]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro pair _
  ring

private theorem p286HodgePairing_add_left
    (coframe : LorentzianCoframe)
    (first second test : P286GaugeTwoForm) :
    p286GaugeAuxiliaryHodgePairingPolynomial coframe
        (first + second) test =
      p286GaugeAuxiliaryHodgePairingPolynomial coframe first test +
        p286GaugeAuxiliaryHodgePairingPolynomial coframe second test := by
  unfold p286GaugeAuxiliaryHodgePairingPolynomial
  rw [liftGaugeTwoFormOperator_add_p286]
  simp_rw [Pi.add_apply, p286CoordinateLiePairing_add_left]
  simp_rw [mul_add]
  rw [Finset.sum_add_distrib]

/-- Proof-side constant-auxiliary comparison carrier.  It is used only to
establish regularity of the factor left after the actual generated spatial
auxiliary is factored as `t • A_axis`; it is not a producer or source slot. -/
private def preContorsionSpatialProfileAxisAuxiliaryActual
    (axis : Fin 3) : StageNineHolonomicConfiguration :=
  { preContorsionSpatialProfileActual with
    gaugeAuxiliary := fun _ pair =>
      p286CoordinateEquiv.symm
        (preContorsionP286GaussAxisAuxiliary axis pair) }

private theorem
    preContorsionSpatialProfileAxisAuxiliaryActual_auxiliaryCoordinate
    (axis : Fin 3) (point : BasePoint) :
    holonomicP286GaugeAuxiliaryCoordinate
        (preContorsionSpatialProfileAxisAuxiliaryActual axis) point =
      preContorsionP286GaussAxisAuxiliary axis := by
  funext pair
  unfold holonomicP286GaugeAuxiliaryCoordinate
    preContorsionSpatialProfileAxisAuxiliaryActual
  exact p286CoordinateEquiv.apply_symm_apply _

private theorem preContorsionSpatialProfileAxisAuxiliaryActual_smooth
    (axis : Fin 3) :
    (preContorsionSpatialProfileAxisAuxiliaryActual axis).Smooth := by
  rcases preContorsionSpatialProfileActual_smooth with
    ⟨coframe, gravityConnection, gravityAuxiliary, multiplier,
      gaugeConnection, _gaugeAuxiliary, scalar, matter, conjugateMatter⟩
  refine ⟨coframe, gravityConnection, gravityAuxiliary, multiplier,
    gaugeConnection, ?_, scalar, matter, conjugateMatter⟩
  intro pair
  dsimp [preContorsionSpatialProfileAxisAuxiliaryActual]
  fun_prop

private theorem preContorsionSpatialProfileAxisAuxiliaryActual_nondegenerate
    (axis : Fin 3) :
    (preContorsionSpatialProfileAxisAuxiliaryActual axis).Nondegenerate := by
  exact preContorsionSpatialProfileActual_nondegenerate

private def preContorsionSpatialProfileP286AxisMomentumFactor
    (axis : Fin 3) (direction : P286GaugeTwoForm) (parameter : ℝ) : ℝ :=
  p286GaugeConnectionBFDifferentialMomentum
    (preContorsionSpatialProfileAxisAuxiliaryActual axis) direction
    (parameter • coordinateDirection axis.succ)

private theorem preContorsionSpatialProfileP286AxisMomentumFactor_contDiff
    (axis : Fin 3) (direction : P286GaugeTwoForm) :
    ContDiff ℝ ∞
      (preContorsionSpatialProfileP286AxisMomentumFactor axis direction) := by
  unfold preContorsionSpatialProfileP286AxisMomentumFactor
  exact
    (p286GaugeConnectionBFDifferentialMomentum_contDiff
      (preContorsionSpatialProfileAxisAuxiliaryActual axis)
      (preContorsionSpatialProfileAxisAuxiliaryActual_smooth axis)
      (preContorsionSpatialProfileAxisAuxiliaryActual_nondegenerate axis)
      direction).comp (by fun_prop)

private theorem preContorsionSpatialProfileP286AxisMomentumFactor_origin
    (axis : Fin 3) (direction : P286GaugeTwoForm) :
    preContorsionSpatialProfileP286AxisMomentumFactor axis direction 0 =
      p286GaugeAuxiliaryHodgePairingPolynomial 1
        (preContorsionP286GaussAxisAuxiliary axis) direction := by
  have volumeOne :
      generatedVolumeDensity
          (toContinuumPointField
            (preContorsionSpatialProfileAxisAuxiliaryActual axis) 0) = 1 := by
    unfold generatedVolumeDensity
    rw [show
      (toContinuumPointField
        (preContorsionSpatialProfileAxisAuxiliaryActual axis) 0).coframe = 1 by
        exact preContorsionSpatialProfileActual_coframe_origin]
    simp
  unfold preContorsionSpatialProfileP286AxisMomentumFactor
    p286GaugeConnectionBFDifferentialMomentum
  rw [show (0 : ℝ) • coordinateDirection axis.succ = 0 by simp]
  rw [volumeOne]
  rw [show
    (preContorsionSpatialProfileAxisAuxiliaryActual axis).coframe 0 = 1 by
      exact preContorsionSpatialProfileActual_coframe_origin]
  rw [preContorsionSpatialProfileAxisAuxiliaryActual_auxiliaryCoordinate]
  simp

private theorem preContorsionSpatialProfileP286AxisMomentum_factorization
    (axis : Fin 3) (direction : P286GaugeTwoForm) (parameter : ℝ) :
    p286GaugeConnectionBFDifferentialMomentum
        preContorsionSpatialProfileActual direction
        (parameter • coordinateDirection axis.succ) =
      parameter *
        preContorsionSpatialProfileP286AxisMomentumFactor axis direction
          parameter := by
  have auxiliaryCoordinate :
      holonomicP286GaugeAuxiliaryCoordinate preContorsionSpatialProfileActual
          (parameter • coordinateDirection axis.succ) =
        parameter • preContorsionP286GaussAxisAuxiliary axis := by
    funext pair
    unfold holonomicP286GaugeAuxiliaryCoordinate
    rw [congrFun preContorsionSpatialProfileActual_retains_p286Fields.2
      (parameter • coordinateDirection axis.succ)]
    exact congrFun
      (preContorsionP286Actual_auxiliary_spatialAxis axis parameter) pair
  unfold p286GaugeConnectionBFDifferentialMomentum
    preContorsionSpatialProfileP286AxisMomentumFactor
  unfold p286GaugeConnectionBFDifferentialMomentum
  rw [auxiliaryCoordinate, p286HodgePairing_smul_left]
  rw [preContorsionSpatialProfileAxisAuxiliaryActual_auxiliaryCoordinate]
  have volumeEquality :
      generatedVolumeDensity
          (toContinuumPointField
            (preContorsionSpatialProfileAxisAuxiliaryActual axis)
            (parameter • coordinateDirection axis.succ)) =
        generatedVolumeDensity
          (toContinuumPointField preContorsionSpatialProfileActual
            (parameter • coordinateDirection axis.succ)) := by
    rfl
  have coframeEquality :
      (preContorsionSpatialProfileAxisAuxiliaryActual axis).coframe
          (parameter • coordinateDirection axis.succ) =
        preContorsionSpatialProfileActual.coframe
          (parameter • coordinateDirection axis.succ) := by
    rfl
  rw [volumeEquality, coframeEquality]
  ring

/-- The spatial BF-momentum derivative of the coframe-corrected profile reads
the already generated radial P286 auxiliary coefficient.  The coframe can
vary away from the contact: because the auxiliary begins at zero, the
derivative of the remaining smooth factor is multiplied by the vanishing
axis parameter. -/
theorem preContorsionSpatialProfileActual_p286BFMomentum_spatialDerivative
    (axis : Fin 3) (direction : P286GaugeTwoForm) :
    fieldDirectionalDerivative
        (p286GaugeConnectionBFDifferentialMomentum
          preContorsionSpatialProfileActual direction)
        0 axis.succ =
      p286GaugeAuxiliaryHodgePairingPolynomial 1
        (preContorsionP286GaussAxisAuxiliary axis) direction := by
  let momentum := p286GaugeConnectionBFDifferentialMomentum
    preContorsionSpatialProfileActual direction
  let line : ℝ → BasePoint := fun parameter =>
    parameter • coordinateDirection axis.succ
  let factor := preContorsionSpatialProfileP286AxisMomentumFactor axis direction
  have momentumDifferentiable : DifferentiableAt ℝ momentum 0 :=
    ((p286GaugeConnectionBFDifferentialMomentum_contDiff
      preContorsionSpatialProfileActual
      preContorsionSpatialProfileActual_smooth
      preContorsionSpatialProfileActual_nondegenerate direction).differentiable
      (by simp)).differentiableAt
  have lineDerivative :
      HasDerivAt line (coordinateDirection axis.succ) 0 := by
    simpa [line] using
      (hasDerivAt_id (𝕜 := ℝ) (x := 0)).smul_const
        (coordinateDirection axis.succ)
  have outer :
      HasFDerivAt momentum (fderiv ℝ momentum 0) (line 0) := by
    simpa [line] using momentumDifferentiable.hasFDerivAt
  have composed := outer.comp_hasDerivAt 0 lineDerivative
  have factorDerivative : HasDerivAt factor (deriv factor 0) 0 :=
    ((preContorsionSpatialProfileP286AxisMomentumFactor_contDiff axis direction
      ).differentiable (by simp)).differentiableAt.hasDerivAt
  have productRaw :=
    (hasDerivAt_id (𝕜 := ℝ) (x := 0)).mul factorDerivative
  have product : HasDerivAt (id * factor) (factor 0) 0 := by
    simpa using productRaw
  have compositionEquality :
      momentum ∘ line = id * factor := by
    funext parameter
    simpa [momentum, line, factor] using
      preContorsionSpatialProfileP286AxisMomentum_factorization
        axis direction parameter
  rw [compositionEquality] at composed
  have coefficientEquality := composed.unique product
  unfold fieldDirectionalDerivative
  change
    (fderiv ℝ momentum 0) (coordinateDirection axis.succ) = _
  calc
    _ = factor 0 := coefficientEquality
    _ = _ :=
      preContorsionSpatialProfileP286AxisMomentumFactor_origin axis direction

private theorem preContorsionP286BaseActual_coframe_one
    (point : BasePoint) :
    preContorsionP286BaseActual.coframe point = 1 := by
  have responseOne := preContorsionP286Actual_coframe_one point
  change
    (currentP286CompleteActionResponseOperator positiveSmoothUnifiedSource
      preContorsionP286BaseActual).coframe point = 1 at responseOne
  simpa only [currentP286CompleteActionResponseOperator_coframe] using
    responseOne

private theorem
    preContorsionSpatialProfileActual_p286BFMomentum_spatialDerivative_eq_direct
    (axis : Fin 3) (direction : P286GaugeTwoForm) :
    fieldDirectionalDerivative
        (p286GaugeConnectionBFDifferentialMomentum
          preContorsionSpatialProfileActual direction)
        0 axis.succ =
      fieldDirectionalDerivative
        (p286GaugeConnectionBFDifferentialMomentum
          PreContorsionP286Actual direction)
        0 axis.succ := by
  rw [preContorsionSpatialProfileActual_p286BFMomentum_spatialDerivative]
  change _ = fieldDirectionalDerivative
    (p286GaugeConnectionBFDifferentialMomentum
      (currentP286CompleteActionResponseOperator positiveSmoothUnifiedSource
        preContorsionP286BaseActual) direction) 0 axis.succ
  rw [currentP286CompleteActionResponseOperator_bfMomentum_derivative
    positiveSmoothUnifiedSource preContorsionP286BaseActual
    preContorsionP286BaseActual_coframe_one]
  fin_cases axis <;>
    simp [preContorsionP286GaussAxisAuxiliary,
      canonicalLorentzianTimeDirection, Fin.sum_univ_three,
      p286HodgePairing_smul_left]

/-- The coframe repair preserves the full spatial P286 BF divergence at the
common contact.  This is not inferred from unchanged P286 fields: it follows
from the explicit first-order axis calculation above. -/
theorem preContorsionSpatialProfileActual_p286SpatialBFDivergence_eq_direct
    (direction : P286GaugeOneForm) :
    p286GaugeConnectionSpatialBFMomentumDivergence
        preContorsionSpatialProfileActual direction 0 =
      p286GaugeConnectionSpatialBFMomentumDivergence
        PreContorsionP286Actual direction 0 := by
  have axisZero :
      fieldDirectionalDerivative
          (p286GaugeConnectionBFDifferentialMomentum
            preContorsionSpatialProfileActual
            (p286GaugeExteriorDerivativeDirection 1 direction)) 0 1 =
        fieldDirectionalDerivative
          (p286GaugeConnectionBFDifferentialMomentum
            PreContorsionP286Actual
            (p286GaugeExteriorDerivativeDirection 1 direction)) 0 1 := by
    simpa using
      preContorsionSpatialProfileActual_p286BFMomentum_spatialDerivative_eq_direct
        (0 : Fin 3) (p286GaugeExteriorDerivativeDirection 1 direction)
  have axisOne :
      fieldDirectionalDerivative
          (p286GaugeConnectionBFDifferentialMomentum
            preContorsionSpatialProfileActual
            (p286GaugeExteriorDerivativeDirection 2 direction)) 0 2 =
        fieldDirectionalDerivative
          (p286GaugeConnectionBFDifferentialMomentum
            PreContorsionP286Actual
            (p286GaugeExteriorDerivativeDirection 2 direction)) 0 2 := by
    simpa using
      preContorsionSpatialProfileActual_p286BFMomentum_spatialDerivative_eq_direct
        (1 : Fin 3) (p286GaugeExteriorDerivativeDirection 2 direction)
  have axisTwo :
      fieldDirectionalDerivative
          (p286GaugeConnectionBFDifferentialMomentum
            preContorsionSpatialProfileActual
            (p286GaugeExteriorDerivativeDirection 3 direction)) 0 3 =
        fieldDirectionalDerivative
          (p286GaugeConnectionBFDifferentialMomentum
            PreContorsionP286Actual
            (p286GaugeExteriorDerivativeDirection 3 direction)) 0 3 := by
    simpa using
      preContorsionSpatialProfileActual_p286BFMomentum_spatialDerivative_eq_direct
        (2 : Fin 3) (p286GaugeExteriorDerivativeDirection 3 direction)
  unfold p286GaugeConnectionSpatialBFMomentumDivergence
  rw [axisZero, axisOne, axisTwo]

