/-! ## Coherent P286 BF-momentum transport -/

/-- The coherent actual's P286 auxiliary is the generated profile pulled
back to the zero slice plus the current-action velocity times physical time.
The origin term is identified through the already proved action-prepared
zero step, not by projecting the coherent actual after construction. -/
theorem coherentProfileActual_p286AuxiliaryCoordinate_normalForm
    (point : BasePoint) :
    holonomicP286GaugeAuxiliaryCoordinate
        positiveP506MatterPreContorsionSpatialProfileCoherentFirstGermActual
        point =
      holonomicP286GaugeAuxiliaryCoordinate
          preContorsionSpatialProfileActual
          (canonicalZeroSliceProjection point) +
        canonicalTimeProjection point •
          p286SpatialAuxiliaryVelocityEmbedding
            (currentP286SpatialAuxiliaryVelocity positiveSmoothUnifiedSource
              (currentCanonicalFullActionBaseActual positiveSmoothUnifiedSource
                PreContorsionSpatialProfileCurrent
                (canonicalSpatialProjection point))) := by
  funext pair
  change
    p286CoordinateEquiv
        ((currentCanonicalFullActionLorentzStateResponseUpdate
          positiveSmoothUnifiedSource PreContorsionSpatialProfileCurrent
          (canonicalTimeProjection point)).gaugeAuxiliary
          (canonicalSpatialProjection point) pair) = _
  rw [currentCanonicalFullActionLorentzStateResponseUpdate_p286Auxiliary_normalForm]
  have zeroStepNormalForm :=
    currentCanonicalFullActionLorentzStateResponseUpdate_p286Auxiliary_normalForm
      positiveSmoothUnifiedSource PreContorsionSpatialProfileCurrent
      (canonicalSpatialProjection point) 0 pair
  rw [preContorsionSpatialProfileCurrent_zeroStep] at zeroStepNormalForm
  have originEquality :
      currentP286OriginAuxiliaryCoordinate
          (currentCanonicalFullActionBaseActual positiveSmoothUnifiedSource
            PreContorsionSpatialProfileCurrent
            (canonicalSpatialProjection point)) pair =
        p286CoordinateEquiv
          (preContorsionSpatialProfileActual.gaugeAuxiliary
            (canonicalCauchySlicePoint 0
              (canonicalSpatialProjection point)) pair) := by
    symm
    simpa [PreContorsionSpatialProfileCurrent,
      canonicalCauchyRestriction] using zeroStepNormalForm
  rw [originEquality, canonicalZeroSliceProjection_apply]
  rfl

/-- Coefficient of the coherent actual's only extra P286 BF-momentum term.
It is a readout of the action-generated spatial velocity on the already fixed
profile coframe, not an additional source datum. -/
def coherentProfileP286BFMomentumCorrectionCoefficient
    (direction : P286GaugeTwoForm) (point : BasePoint) : ℝ :=
  generatedVolumeDensity
      (toContinuumPointField preContorsionSpatialProfileActual
        (canonicalZeroSliceProjection point)) *
    p286GaugeAuxiliaryHodgePairingPolynomial
      (preContorsionSpatialProfileActual.coframe
        (canonicalZeroSliceProjection point))
      (p286SpatialAuxiliaryVelocityEmbedding
        (currentP286SpatialAuxiliaryVelocity positiveSmoothUnifiedSource
          (currentCanonicalFullActionBaseActual positiveSmoothUnifiedSource
            PreContorsionSpatialProfileCurrent
            (canonicalSpatialProjection point))))
      direction

theorem coherentProfileP286BFMomentumCorrectionCoefficient_continuous
    (direction : P286GaugeTwoForm) :
    Continuous
      (coherentProfileP286BFMomentumCorrectionCoefficient direction) := by
  let velocityField : BasePoint → P286GaugeTwoForm := fun point =>
    p286SpatialAuxiliaryVelocityEmbedding
      (currentP286SpatialAuxiliaryVelocity positiveSmoothUnifiedSource
        (currentCanonicalFullActionBaseActual positiveSmoothUnifiedSource
          PreContorsionSpatialProfileCurrent
          (canonicalSpatialProjection point)))
  let hodgeDirectionField : BasePoint → P286GaugeTwoForm := fun point =>
    liftGaugeTwoFormOperator
      (coframeGaugeSpacetimeHodgeLinear
        (preContorsionSpatialProfileActual.coframe point)) direction
  have velocityContinuous : Continuous velocityField :=
    preContorsionSpatialProfileCurrent_p286AuxiliaryVelocityEmbedding_continuous.comp
