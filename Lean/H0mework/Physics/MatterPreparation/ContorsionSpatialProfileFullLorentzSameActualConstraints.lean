/-- Smoothness of the action-generated BF correction coefficient.  Both
two-form arguments are transported through the profile coframe polynomial;
no mixed derivative or Gauss equation is assumed. -/
theorem coherentProfileP286BFMomentumCorrectionCoefficient_contDiff
    (direction : P286GaugeTwoForm) :
    ContDiff ℝ ∞
      (coherentProfileP286BFMomentumCorrectionCoefficient direction) := by
  let velocityField : BasePoint → P286GaugeTwoForm := fun point =>
    p286SpatialAuxiliaryVelocityEmbedding
      (currentP286SpatialAuxiliaryVelocity positiveSmoothUnifiedSource
        (currentCanonicalFullActionBaseActual positiveSmoothUnifiedSource
          PreContorsionSpatialProfileCurrent
          (canonicalSpatialProjection point)))
  have velocitySmooth : ContDiff ℝ ∞ velocityField :=
    preContorsionSpatialProfileCurrent_p286AuxiliaryVelocityEmbedding_contDiff.comp
      canonicalSpatialProjection.contDiff
  have pairingSmooth : ContDiff ℝ ∞ fun point =>
      p286GaugeAuxiliaryHodgePairingPolynomial
        (preContorsionSpatialProfileActual.coframe point)
        (velocityField point) direction :=
    p286GaugeAuxiliaryHodgePairingPolynomial_variable_contDiff
      preContorsionSpatialProfileActual
      preContorsionSpatialProfileActual_smooth velocityField
      (fun _ => direction) velocitySmooth contDiff_const
  have volumeSmooth : ContDiff ℝ ∞ fun point =>
      generatedVolumeDensity
        (toContinuumPointField preContorsionSpatialProfileActual point) :=
    holonomicGeneratedVolumeDensity_contDiff
      preContorsionSpatialProfileActual
      preContorsionSpatialProfileActual_smooth
      preContorsionSpatialProfileActual_nondegenerate
  have pulledSmooth :=
    (volumeSmooth.mul pairingSmooth).comp
      canonicalZeroSliceProjection.contDiff
  rw [show coherentProfileP286BFMomentumCorrectionCoefficient direction =
      (fun point =>
        generatedVolumeDensity
            (toContinuumPointField preContorsionSpatialProfileActual point) *
          p286GaugeAuxiliaryHodgePairingPolynomial
            (preContorsionSpatialProfileActual.coframe point)
            (velocityField point) direction) ∘
        canonicalZeroSliceProjection by
    funext point
    simp only [Function.comp_apply]
    unfold coherentProfileP286BFMomentumCorrectionCoefficient
    dsimp [velocityField]
    rw [canonicalZeroSliceProjection_apply,
      canonicalSpatialProjection_slice]]
  exact pulledSmooth

