/-- The coherent P286 BF momentum is differentiable at the common contact.
Its derivative consists of the zero-slice profile derivative and the genuine
time-response covector; this theorem does not discard the latter. -/
theorem coherentProfileActual_p286BFMomentum_hasFDerivAt_origin
    (direction : P286GaugeTwoForm) :
    HasFDerivAt
      (p286GaugeConnectionBFDifferentialMomentum
        positiveP506MatterPreContorsionSpatialProfileCoherentFirstGermActual
        direction)
      (((fderiv ℝ
          (p286GaugeConnectionBFDifferentialMomentum
            preContorsionSpatialProfileActual direction) 0).comp
          canonicalZeroSliceProjection) +
        (coherentProfileP286BFMomentumCorrectionCoefficient direction 0) •
          canonicalTimeProjection)
      0 := by
  rw [show
    p286GaugeConnectionBFDifferentialMomentum
        positiveP506MatterPreContorsionSpatialProfileCoherentFirstGermActual
        direction =
      fun point =>
        p286GaugeConnectionBFDifferentialMomentum
            preContorsionSpatialProfileActual direction
            (canonicalZeroSliceProjection point) +
          canonicalTimeProjection point *
            coherentProfileP286BFMomentumCorrectionCoefficient direction
              point by
    funext point
    exact coherentProfileActual_p286BFMomentum_normalForm direction point]
  have profileDerivative :
      HasFDerivAt
        (p286GaugeConnectionBFDifferentialMomentum
          preContorsionSpatialProfileActual direction)
        (fderiv ℝ
          (p286GaugeConnectionBFDifferentialMomentum
            preContorsionSpatialProfileActual direction) 0)
        0 :=
    ((p286GaugeConnectionBFDifferentialMomentum_contDiff
      preContorsionSpatialProfileActual
      preContorsionSpatialProfileActual_smooth
      preContorsionSpatialProfileActual_nondegenerate
      direction).differentiable (by simp)).differentiableAt.hasFDerivAt
  have profileDerivativeAtProjection :
      HasFDerivAt
        (p286GaugeConnectionBFDifferentialMomentum
          preContorsionSpatialProfileActual direction)
        (fderiv ℝ
          (p286GaugeConnectionBFDifferentialMomentum
            preContorsionSpatialProfileActual direction) 0)
        (canonicalZeroSliceProjection 0) := by
    rw [canonicalZeroSliceProjection.map_zero]
    exact profileDerivative
  have pulledBackDerivative :=
    HasFDerivAt.comp
      (f := fun point : BasePoint => canonicalZeroSliceProjection point)
      0 profileDerivativeAtProjection
      canonicalZeroSliceProjection.hasFDerivAt
  have combinedDerivative := pulledBackDerivative.add
    (coherentProfileP286BFMomentumCorrection_hasFDerivAt_origin direction)
  exact combinedDerivative.congr_of_eventuallyEq (by
    filter_upwards with point
    rfl)

/-- The coherent time-response term has zero contraction with every spatial
basis direction.  Hence each spatial P286 BF-momentum derivative is exactly
the already generated profile derivative, even though the correction itself
need not vanish. -/
theorem coherentProfileActual_p286BFMomentum_spatialDerivative_eq_profile
    (axis : Fin 3) (direction : P286GaugeTwoForm) :
    fieldDirectionalDerivative
        (p286GaugeConnectionBFDifferentialMomentum
          positiveP506MatterPreContorsionSpatialProfileCoherentFirstGermActual
          direction)
        0 axis.succ =
      fieldDirectionalDerivative
        (p286GaugeConnectionBFDifferentialMomentum
          preContorsionSpatialProfileActual direction)
        0 axis.succ := by
  unfold fieldDirectionalDerivative
  rw [(coherentProfileActual_p286BFMomentum_hasFDerivAt_origin
    direction).fderiv]
  rw [add_apply, ContinuousLinearMap.comp_apply,
    canonicalZeroSliceProjection_coordinateSpatial]
  have timeZero :
      canonicalTimeProjection (coordinateDirection axis.succ) = 0 := by
    fin_cases axis <;>
      simp [canonicalTimeProjection, localBaseCoordinate_apply,
        coordinateDirection, canonicalLorentzianTimeDirection]
  rw [smul_apply, timeZero]
  simp

/-- Summing the three transported spatial derivatives preserves the P286
Gauss divergence on the same coherent actual. -/
theorem coherentProfileActual_p286SpatialBFDivergence_eq_profile
    (direction : P286GaugeOneForm) :
    p286GaugeConnectionSpatialBFMomentumDivergence
        positiveP506MatterPreContorsionSpatialProfileCoherentFirstGermActual
        direction 0 =
      p286GaugeConnectionSpatialBFMomentumDivergence
        preContorsionSpatialProfileActual direction 0 := by
  have axisZero :
      fieldDirectionalDerivative
          (p286GaugeConnectionBFDifferentialMomentum
            positiveP506MatterPreContorsionSpatialProfileCoherentFirstGermActual
            (p286GaugeExteriorDerivativeDirection 1 direction)) 0 1 =
        fieldDirectionalDerivative
          (p286GaugeConnectionBFDifferentialMomentum
            preContorsionSpatialProfileActual
            (p286GaugeExteriorDerivativeDirection 1 direction)) 0 1 := by
    simpa using
      coherentProfileActual_p286BFMomentum_spatialDerivative_eq_profile
        (0 : Fin 3) (p286GaugeExteriorDerivativeDirection 1 direction)
  have axisOne :
      fieldDirectionalDerivative
          (p286GaugeConnectionBFDifferentialMomentum
            positiveP506MatterPreContorsionSpatialProfileCoherentFirstGermActual
            (p286GaugeExteriorDerivativeDirection 2 direction)) 0 2 =
        fieldDirectionalDerivative
          (p286GaugeConnectionBFDifferentialMomentum
            preContorsionSpatialProfileActual
            (p286GaugeExteriorDerivativeDirection 2 direction)) 0 2 := by
    simpa using
      coherentProfileActual_p286BFMomentum_spatialDerivative_eq_profile
        (1 : Fin 3) (p286GaugeExteriorDerivativeDirection 2 direction)
  have axisTwo :
      fieldDirectionalDerivative
          (p286GaugeConnectionBFDifferentialMomentum
            positiveP506MatterPreContorsionSpatialProfileCoherentFirstGermActual
            (p286GaugeExteriorDerivativeDirection 3 direction)) 0 3 =
        fieldDirectionalDerivative
          (p286GaugeConnectionBFDifferentialMomentum
            preContorsionSpatialProfileActual
            (p286GaugeExteriorDerivativeDirection 3 direction)) 0 3 := by
    simpa [Fin.succ] using
      coherentProfileActual_p286BFMomentum_spatialDerivative_eq_profile
        (2 : Fin 3) (p286GaugeExteriorDerivativeDirection 3 direction)
  unfold p286GaugeConnectionSpatialBFMomentumDivergence
  rw [axisZero, axisOne, axisTwo]

/-- The coherent actual itself satisfies canonical P286 Gauss at the common
contact.  This closes the stitched spatial derivative, rather than reusing a
single local restart's origin equation as if it were a global derivative. -/
theorem coherentProfileActual_p286Gauss_origin :
    CanonicalP286GaugeGaussConstraintAt positiveSmoothUnifiedSource
