    positiveSmoothUnifiedSource preContorsionSpatialProfileActual
    PreContorsionP286Actual 0
    (preContorsionSpatialProfileActual_coframe_origin.trans
      (preContorsionP286Actual_coframe_one 0).symm)
    (congrFun preContorsionSpatialProfileActual_retains_p286Fields.1 0)
    (congrFun preContorsionSpatialProfileActual_retains_p286Fields.2 0)
    (congrFun preContorsionSpatialProfileActual_scalar_eq_direct 0)
    preContorsionSpatialProfileActual_scalarCovariantDerivative_origin_eq_direct
    (congrFun preContorsionSpatialProfileActual_retains_matterFields.1 0)
    (congrFun preContorsionSpatialProfileActual_retains_matterFields.2 0)
    direction

/-- The coframe-corrected profile remains on the action-generated P286
Gauss surface at the common contact.  This is producer consistency: the
P286 response generated its radial auxiliary germ before the coframe write,
and the explicit derivative calculation proves that the later write
preserves the equation. -/
theorem preContorsionSpatialProfileActual_p286Gauss_origin :
    CanonicalP286GaugeGaussConstraintAt positiveSmoothUnifiedSource
      preContorsionSpatialProfileActual 0 := by
  intro component
  calc
    p286GaugeConnectionAlgebraicCurrentCoefficient
        positiveSmoothUnifiedSource preContorsionSpatialProfileActual
        (p286TemporalGaugeOneForm component) 0 =
      p286GaugeConnectionAlgebraicCurrentCoefficient
        positiveSmoothUnifiedSource PreContorsionP286Actual
        (p286TemporalGaugeOneForm component) 0 :=
      preContorsionSpatialProfileActual_p286AlgebraicCurrent_eq_direct _
    _ = currentP286TemporalActionTarget positiveSmoothUnifiedSource
        preContorsionP286BaseActual component := by
      change
        p286GaugeConnectionAlgebraicCurrentCoefficient
            positiveSmoothUnifiedSource
            (currentP286CompleteActionResponseOperator
              positiveSmoothUnifiedSource preContorsionP286BaseActual)
