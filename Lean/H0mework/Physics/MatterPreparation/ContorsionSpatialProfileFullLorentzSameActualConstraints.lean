/-- The P286 auxiliary velocity installed by the coherent actual varies
continuously with the source-owned spatial contact.  The proof reconstructs
the finite action dual from its basis coefficients before applying the fixed
BF Legendre inverse; no velocity field is supplied at the theorem mouth. -/
theorem preContorsionSpatialProfileCurrent_p286AuxiliaryVelocity_continuous :
    Continuous fun space =>
      currentP286SpatialAuxiliaryVelocity positiveSmoothUnifiedSource
        (currentCanonicalFullActionBaseActual positiveSmoothUnifiedSource
          PreContorsionSpatialProfileCurrent space) := by
  let basis := Module.finBasis ℝ P286SpatialGaugeDirection
  let coordinates := fun space =>
    basis.dualBasis.equivFun
      (currentP286SpatialActionTarget positiveSmoothUnifiedSource
        (currentCanonicalFullActionBaseActual positiveSmoothUnifiedSource
          PreContorsionSpatialProfileCurrent space))
  have coordinatesContinuous : Continuous coordinates := by
    apply continuous_pi
    intro index
    rw [show (fun space => coordinates space index) =
      fun space =>
        currentP286SpatialActionTarget positiveSmoothUnifiedSource
          (currentCanonicalFullActionBaseActual positiveSmoothUnifiedSource
            PreContorsionSpatialProfileCurrent space)
          (basis index) by
      funext space
      exact basis.dualBasis_equivFun _ index]
    exact
      preContorsionSpatialProfileCurrent_baseP286SpatialActionTarget_coefficient_continuous
        (basis index)
  let reconstruct :=
    basis.dualBasis.equivFun.symm.trans p286SpatialBFLegendreEquiv.symm
  have reconstructedContinuous : Continuous fun space =>
      reconstruct (coordinates space) :=
    reconstruct.toLinearMap.continuous_of_finiteDimensional.comp
      coordinatesContinuous
  exact reconstructedContinuous.congr fun space => by
    change
      p286SpatialBFLegendreEquiv.symm
          (basis.dualBasis.equivFun.symm
            (basis.dualBasis.equivFun
              (currentP286SpatialActionTarget positiveSmoothUnifiedSource
                (currentCanonicalFullActionBaseActual
                  positiveSmoothUnifiedSource
                  PreContorsionSpatialProfileCurrent space)))) =
        p286SpatialBFLegendreEquiv.symm
          (currentP286SpatialActionTarget positiveSmoothUnifiedSource
            (currentCanonicalFullActionBaseActual positiveSmoothUnifiedSource
              PreContorsionSpatialProfileCurrent space))
    rw [LinearEquiv.symm_apply_apply]

/-- Smoothness upgrade of the action-generated P286 auxiliary velocity.  The
velocity is still reconstructed from the current action dual and the fixed BF
Legendre inverse; no response field is accepted as input. -/
theorem preContorsionSpatialProfileCurrent_p286AuxiliaryVelocity_contDiff :
    ContDiff ℝ ∞ fun space =>
      currentP286SpatialAuxiliaryVelocity positiveSmoothUnifiedSource
        (currentCanonicalFullActionBaseActual positiveSmoothUnifiedSource
          PreContorsionSpatialProfileCurrent space) := by
  let basis := Module.finBasis ℝ P286SpatialGaugeDirection
  let coordinates := fun space =>
    basis.dualBasis.equivFun
      (currentP286SpatialActionTarget positiveSmoothUnifiedSource
        (currentCanonicalFullActionBaseActual positiveSmoothUnifiedSource
          PreContorsionSpatialProfileCurrent space))
  have coordinatesContDiff : ContDiff ℝ ∞ coordinates := by
    apply contDiff_pi'
    intro index
    rw [show (fun space => coordinates space index) =
      fun space =>
        currentP286SpatialActionTarget positiveSmoothUnifiedSource
          (currentCanonicalFullActionBaseActual positiveSmoothUnifiedSource
            PreContorsionSpatialProfileCurrent space)
          (basis index) by
      funext space
      exact basis.dualBasis_equivFun _ index]
    exact
      preContorsionSpatialProfileCurrent_baseP286SpatialActionTarget_coefficient_contDiff
        (basis index)
  let reconstruct :=
    basis.dualBasis.equivFun.symm.trans p286SpatialBFLegendreEquiv.symm
  let reconstructCLM : _ →L[ℝ] P286SpatialGaugeDirection :=
    ⟨reconstruct.toLinearMap,
      reconstruct.toLinearMap.continuous_of_finiteDimensional⟩
  rw [show (fun space =>
      currentP286SpatialAuxiliaryVelocity positiveSmoothUnifiedSource
        (currentCanonicalFullActionBaseActual positiveSmoothUnifiedSource
          PreContorsionSpatialProfileCurrent space)) =
    fun space => reconstructCLM (coordinates space) by
    funext space
    change
      p286SpatialBFLegendreEquiv.symm
          (currentP286SpatialActionTarget positiveSmoothUnifiedSource
            (currentCanonicalFullActionBaseActual positiveSmoothUnifiedSource
              PreContorsionSpatialProfileCurrent space)) =
        p286SpatialBFLegendreEquiv.symm
          (basis.dualBasis.equivFun.symm
            (basis.dualBasis.equivFun
              (currentP286SpatialActionTarget positiveSmoothUnifiedSource
                (currentCanonicalFullActionBaseActual positiveSmoothUnifiedSource
                  PreContorsionSpatialProfileCurrent space))))
    rw [LinearEquiv.symm_apply_apply]]
  exact reconstructCLM.contDiff.comp coordinatesContDiff

private theorem
