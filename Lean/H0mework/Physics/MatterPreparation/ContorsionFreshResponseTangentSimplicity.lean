  rw [currentCanonicalFullActionLorentzSpatialBFMomentumDivergence_eq_sum,
    currentCanonicalFullActionLorentzSpatialBFMomentumDivergence_eq_sum]
  apply Finset.sum_congr rfl
  intro derivativeDirection _
  exact
    preContorsionFullLorentzTriangularCurrent_spatialBFMomentumDerivative_eq_profileCurrent
      space derivativeDirection direction

/-- At the canonical contact, the regenerated cross-contact divergence is
the full divergence of the C3h200n final actual. -/
theorem
    preContorsionFullLorentzTriangularCurrent_spatialBFMomentumDivergence_eq_finalActual
    (direction : LorentzSpatialBivectorDirection) :
    currentCanonicalFullActionLorentzSpatialBFMomentumDivergence
        positiveSmoothUnifiedSource
        PreContorsionFullLorentzTriangularCurrent 0 direction =
      lorentzConnectionBFDifferentialMomentumDivergence
        positiveP506MatterPreContorsionSpatialProfileFullLorentzTriangularActual
        (canonicalLorentzSpatialBivectorOneForm direction) 0 := by
  calc
    currentCanonicalFullActionLorentzSpatialBFMomentumDivergence
        positiveSmoothUnifiedSource
        PreContorsionFullLorentzTriangularCurrent 0 direction =
      currentCanonicalFullActionLorentzSpatialBFMomentumDivergence
        positiveSmoothUnifiedSource PreContorsionSpatialProfileCurrent
        0 direction :=
      preContorsionFullLorentzTriangularCurrent_spatialBFMomentumDivergence_eq_profileCurrent
        0 direction
    _ = lorentzConnectionBFDifferentialMomentumDivergence
        preContorsionSpatialProfileActual
        (canonicalLorentzSpatialBivectorOneForm direction) 0 :=
      preContorsionSpatialProfileCurrent_spatialBFMomentumDivergence_eq_profile
        direction
    _ = lorentzCoordinatePairing preContorsionFullLorentzProfileDivergence
        (canonicalLorentzSpatialBivectorOneForm direction) :=
      preContorsionSpatialProfileActual_fullDivergence_eq_pairing _
    _ = lorentzConnectionBFDifferentialMomentumDivergence
        positiveP506MatterPreContorsionSpatialProfileFullLorentzTriangularActual
        (canonicalLorentzSpatialBivectorOneForm direction) 0 :=
      (fullLorentzTriangularActual_fullDivergence_eq_pairing _).symm

