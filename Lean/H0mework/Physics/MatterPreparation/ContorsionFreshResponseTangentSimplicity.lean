/-- The C3h200p fresh actual remains on the full simplicity surface.  This
is derived from regenerated action coordinates, not from C3h200o. -/
theorem preContorsionFullLorentzFreshActual_gravitySimplicity :
    GravitySimplicityEquation
      positiveP506MatterPreContorsionFullLorentzFreshActual := by
  intro point
  rw [currentCanonicalFullActionLorentzActualFirstJetLift_coframe_one
    positiveSmoothUnifiedSource PreContorsionFullLorentzTriangularCurrent
    0 preContorsionFullLorentzTriangularCurrent_coframe_origin]
  change
    actionGeneratedGravityAuxiliary
          PreContorsionFullLorentzTriangularCurrent 0 +
        localBaseCoordinate canonicalLorentzianTimeDirection point •
          currentCanonicalFullActionLorentzAuxiliaryVelocity
            positiveSmoothUnifiedSource
            PreContorsionFullLorentzTriangularCurrent 0 =
      physicalIIPlusBivector 1
  rw [preContorsionFullLorentzTriangularCurrent_lorentzAuxiliaryVelocity_zero]
  simp only [smul_zero, add_zero]
  unfold actionGeneratedGravityAuxiliary
  rw [preContorsionFullLorentzTriangularCurrent_coframe_origin]

/-- The newly generated state response satisfies `V_B = D II⁺(e)[V_e]` at
the final current. -/
theorem preContorsionFullLorentzFreshResponse_tangentSimplicity :
    positiveP506MatterPreContorsionFullLorentzFreshResponse.gravityAuxiliary =
      physicalIIPlusCoframeTangent
        (PreContorsionFullLorentzTriangularCurrent.coframe 0)
        (fun internal coordinate =>
          positiveP506MatterPreContorsionFullLorentzFreshResponse.coframe
            internal coordinate) := by
  rw [currentCanonicalFullActionLorentzStateResponse_gravityAuxiliary,
    preContorsionFullLorentzTriangularCurrent_lorentzAuxiliaryVelocity_zero]
  change
    (0 : PhysicalBivector) =
      physicalIIPlusCoframeTangent
        (PreContorsionFullLorentzTriangularCurrent.coframe 0) 0
  funext internalPair spacetimePair
  fin_cases internalPair <;>
    simp [physicalIIPlusCoframeTangent, coframeWedgeTangent,
      internalBivectorDual, lorentzianCoframeHodge]

/-- The response-level law is realized by genuine derivatives of the one
C3h200p fresh actual.  No older actual or stored tangent receipt appears in
the proof. -/
theorem
    preContorsionFullLorentzFreshActual_canonicalOriginTangentSimplicity :
    CanonicalGravityOriginTangentSimplicity
      positiveP506MatterPreContorsionFullLorentzFreshActual := by
  have auxiliaryTangent :
      (fun internalPair spacetimePair =>
        deriv
            (fun time : Real =>
              positiveP506MatterPreContorsionFullLorentzFreshActual.gravityAuxiliary
                (canonicalCauchySlicePoint time 0)
                internalPair spacetimePair)
            0) =
        (0 : PhysicalBivector) := by
    funext internalPair spacetimePair
    rw [show
      (fun time : Real =>
        positiveP506MatterPreContorsionFullLorentzFreshActual.gravityAuxiliary
          (canonicalCauchySlicePoint time 0) internalPair spacetimePair) =
        fun _ : Real =>
          actionGeneratedGravityAuxiliary
              PreContorsionFullLorentzTriangularCurrent 0
              internalPair spacetimePair by
      funext time
      rw [currentCanonicalFullActionLorentzActualFirstJetLift_gravityAuxiliary_timeAxis,
        preContorsionFullLorentzTriangularCurrent_lorentzAuxiliaryVelocity_zero]
      simp]
    simp
  have coframeTangent :
      (fun internal coordinate =>
        deriv
            (fun time : Real =>
              positiveP506MatterPreContorsionFullLorentzFreshActual.coframe
                (canonicalCauchySlicePoint time 0)
                internal coordinate)
            0) =
        (0 : LorentzianCoframe) := by
    funext internal coordinate
    rw [show
      (fun time : Real =>
        positiveP506MatterPreContorsionFullLorentzFreshActual.coframe
          (canonicalCauchySlicePoint time 0) internal coordinate) =
        fun _ : Real => (1 : LorentzianCoframe) internal coordinate by
      funext time
      rw [currentCanonicalFullActionLorentzActualFirstJetLift_coframe_one
        positiveSmoothUnifiedSource PreContorsionFullLorentzTriangularCurrent
        0 preContorsionFullLorentzTriangularCurrent_coframe_origin]]
    simp
  unfold CanonicalGravityOriginTangentSimplicity
  rw [auxiliaryTangent, coframeTangent]
  funext internalPair spacetimePair
  fin_cases internalPair <;>
    simp [physicalIIPlusCoframeTangent, coframeWedgeTangent,
      internalBivectorDual, lorentzianCoframeHodge]

