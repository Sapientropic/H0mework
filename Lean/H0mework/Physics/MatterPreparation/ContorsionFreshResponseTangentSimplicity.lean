/-! ## C3h200q checkpoint law -/

structure
    PositiveP506MatterPreContorsionFullLorentzFreshResponseTangentSimplicityLaw :
    Prop where
  exactP506L0Lineage :
    positiveSmoothUnifiedSource.stageEight.generatedP506L0Lineage =
      canonicalP506SourceAffineL0ObservableLineageReference
  endpointEleven :
    positiveSmoothUnifiedSource.stageEight.generatedSelectedEndpoint
        canonicalSource_generatedLineage_height_pos = 11
  regeneratedLorentzCoordinates :
    currentCanonicalFullActionLorentzSpatialBFMomentumActionCoordinates
        positiveSmoothUnifiedSource
        PreContorsionFullLorentzTriangularCurrent 0 = 0
  regeneratedAuxiliaryVelocity :
    currentCanonicalFullActionLorentzAuxiliaryVelocity
        positiveSmoothUnifiedSource
        PreContorsionFullLorentzTriangularCurrent 0 = 0
  freshGravitySimplicity :
    GravitySimplicityEquation
      positiveP506MatterPreContorsionFullLorentzFreshActual
  responseTangentSimplicity :
    positiveP506MatterPreContorsionFullLorentzFreshResponse.gravityAuxiliary =
      physicalIIPlusCoframeTangent
        (PreContorsionFullLorentzTriangularCurrent.coframe 0)
        (fun internal coordinate =>
          positiveP506MatterPreContorsionFullLorentzFreshResponse.coframe
            internal coordinate)
  sameFreshActualTangentSimplicity :
    CanonicalGravityOriginTangentSimplicity
      positiveP506MatterPreContorsionFullLorentzFreshActual
  freshP286ProducerConsistency : ∀ direction,
    p286GaugeConnectionEulerLagrangeCoefficient positiveSmoothUnifiedSource
        positiveP506MatterPreContorsionFullLorentzFreshActual direction 0 = 0
  freshP286GaussStructuralProjection :
    CanonicalP286GaugeGaussConstraintAt positiveSmoothUnifiedSource
      positiveP506MatterPreContorsionFullLorentzFreshActual 0

theorem
    positiveP506MatterPreContorsionFullLorentzFreshResponseTangentSimplicity_realizes_C3h200q :
    PositiveP506MatterPreContorsionFullLorentzFreshResponseTangentSimplicityLaw := by
  exact
    { exactP506L0Lineage :=
        positiveSmoothUnifiedSource_generates_exactP506L0Lineage
      endpointEleven := positiveSmoothUnifiedSource_generates_endpoint_eleven
      regeneratedLorentzCoordinates :=
        preContorsionFullLorentzTriangularCurrent_actionCoordinates_zero
      regeneratedAuxiliaryVelocity :=
        preContorsionFullLorentzTriangularCurrent_lorentzAuxiliaryVelocity_zero
      freshGravitySimplicity :=
        preContorsionFullLorentzFreshActual_gravitySimplicity
      responseTangentSimplicity :=
        preContorsionFullLorentzFreshResponse_tangentSimplicity
      sameFreshActualTangentSimplicity :=
        preContorsionFullLorentzFreshActual_canonicalOriginTangentSimplicity
      freshP286ProducerConsistency :=
        preContorsionFullLorentzFreshActual_p286ConnectionEquation_origin_producerConsistency
      freshP286GaussStructuralProjection :=
        preContorsionFullLorentzFreshActual_p286Gauss_structuralProjection }

end

