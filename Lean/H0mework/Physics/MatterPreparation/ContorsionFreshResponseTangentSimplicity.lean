    exact actualMatterSpinActionCoordinates_eq_of_origin_fields
      positiveSmoothUnifiedSource
      (currentCanonicalGravityPreservingActual positiveSmoothUnifiedSource
        PreContorsionFullLorentzTriangularCurrent 0)
      positiveP506MatterPreContorsionSpatialProfileFullLorentzTriangularActual
      finalCurrent_freshBase_coframe_origin_eq_finalActual
      finalCurrent_freshBase_matter_origin_eq_finalActual
      finalCurrent_freshBase_conjugateMatter_origin_eq_finalActual
