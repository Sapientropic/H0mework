import H0mework.Physics.CurrentAction.LorentzContactResponse
import H0mework.Physics.MatterPreparation.ContorsionSpatialProfileFullLorentzSameActualConstraints

/-!
# S9-C3h200p: complete response restart from the final Lorentz current

C3h200n changed the Lorentz connection of the coherent profile actual and
C3h200o checked the primary constraints on that same final actual.  Those
checkpoints did not recompute the state-dependent action response after the
connection change.  This module starts the next producer epoch in the
forward direction:

```text
C3h200n final actual
→ its actual time-zero Cauchy restriction Ufinal
→ action-prepared carrier and zero-faithful restart
→ complete full-action local actual A(Ufinal, 0)
→ all ten coordinates of V(Ufinal, 0).
```

The fresh actual and response are generated by the existing C3h198
current-state operator.  No residual, endpoint inverse, branch, target
tangent, constraint receipt, or tunable parameter enters the constructor.
The zero restart and the C3h126 origin bridge are consistency statements;
they are not independent field equations.  This file does not identify the
old C3h200n tangent with the newly generated response and does not claim a
flow or constraint propagation.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineSourceActionGeneratedP506MatterPreContorsionSpatialProfileFullLorentzCurrentResponseRestart

open ProofFreeRicherAnholonomicSource
open RepresentationArithmeticAtomProjectionDefect.BorromeanPreRealization
open StageEightProofFreeSource
open StageNineCanonicalCauchyState
open StageNineChangedBackgroundLorentzOriginResponseFiber
open StageNineCurrentCanonicalFullActionLorentzContactResponse
open StageNineCurrentCanonicalFullActionLorentzActualFirstJetLift
open StageNineCurrentCanonicalFullActionLorentzStateResponse
open StageNineEnrichedProofFreeSource
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineLorentzConnectionVariation
open StageNineP286ActionCauchySplit
open StageNineSourceActionGeneratedJointPrimitiveCauchyPath
open StageNineSourceActionGeneratedJointPrimitiveCauchyUpdate
open StageNineSourceActionGeneratedP506MatterCurrentCanonicalFullActionCoherentDiagonalActual
open StageNineSourceActionGeneratedP506MatterPreContorsionSpatialProfileActualLift
open StageNineSourceActionGeneratedP506MatterPreContorsionSpatialProfileCoherentFirstGermActual
open StageNineSourceActionGeneratedP506MatterPreContorsionSpatialProfileCurrentResponse
open StageNineSourceActionGeneratedP506MatterPreContorsionSpatialProfileFullLorentzSameActualConstraints
open StageNineSourceActionGeneratedP506MatterPreContorsionSpatialProfileFullLorentzTriangularActualLift

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 5000000
set_option maxRecDepth 100000

private theorem canonicalCauchySlicePoint_zero_zero :
    canonicalCauchySlicePoint 0 (0 : StageNineSpatialPoint) = 0 := by
  ext direction
  fin_cases direction <;>
    simp [canonicalCauchySlicePoint, canonicalLorentzianTimeDirection,
      Fin.sum_univ_three]

/-! ## Final current and forward response objects -/

/-- The actual Cauchy state read from the C3h200n final configuration.  It is
not the earlier profile current: its Lorentz connection already contains the
action-generated triangular correction. -/
def PreContorsionFullLorentzTriangularCurrent : StageNineCauchyState :=
  canonicalCauchyRestriction 0
    positiveP506MatterPreContorsionSpatialProfileFullLorentzTriangularActual

/-- The fresh local actual generated from the corrected current itself. -/
abbrev positiveP506MatterPreContorsionFullLorentzFreshActual :
    StageNineHolonomicConfiguration :=
  currentCanonicalFullActionLorentzActualFirstJetLift
    positiveSmoothUnifiedSource PreContorsionFullLorentzTriangularCurrent 0

/-- The complete ten-coordinate action response recomputed at the corrected
current. -/
abbrev positiveP506MatterPreContorsionFullLorentzFreshResponse :
    StageNineJointPrimitiveActionVelocity :=
  currentCanonicalFullActionLorentzStateResponse
    positiveSmoothUnifiedSource PreContorsionFullLorentzTriangularCurrent 0

/-- The contact-local restart chart generated from the corrected current.
Its real coordinate is a germ coordinate, not a source knob or global time. -/
abbrev positiveP506MatterPreContorsionFullLorentzCurrentRestart
    (coordinate : Real) : StageNineCauchyState :=
  currentCanonicalFullActionLorentzStateResponseUpdate
    positiveSmoothUnifiedSource PreContorsionFullLorentzTriangularCurrent
    coordinate

/-! ## Carrier provenance and preparedness -/

/-- The connection-only C3h200n write leaves the complete spatial coframe
slice unchanged. -/
theorem preContorsionFullLorentzTriangularCurrent_coframe_eq_profile :
    PreContorsionFullLorentzTriangularCurrent.coframe =
      PreContorsionSpatialProfileCurrent.coframe := by
  funext space
  change
    positiveP506MatterPreContorsionSpatialProfileFullLorentzTriangularActual.coframe
        (canonicalCauchySlicePoint 0 space) =
      preContorsionSpatialProfileActual.coframe
        (canonicalCauchySlicePoint 0 space)
  rw [positiveP506MatterPreContorsionSpatialProfileFullLorentzTriangularActual,
    changedBackgroundLorentzOriginCarrier_coframe]
  change
    (currentCanonicalFullActionLorentzCoherentDiagonalActual
      positiveSmoothUnifiedSource
      PreContorsionSpatialProfileCurrent).coframe
        (canonicalCauchySlicePoint 0 space) = _
  rw [coherentDiagonalActual_coframe_slice,
    preContorsionSpatialProfileCurrent_zeroStep]
  rfl

/-- The same write also leaves the complete spatial gravity-auxiliary slice
unchanged. -/
theorem
    preContorsionFullLorentzTriangularCurrent_gravityAuxiliary_eq_profile :
    PreContorsionFullLorentzTriangularCurrent.gravityAuxiliary =
      PreContorsionSpatialProfileCurrent.gravityAuxiliary := by
  funext space
  change
    positiveP506MatterPreContorsionSpatialProfileFullLorentzTriangularActual.gravityAuxiliary
        (canonicalCauchySlicePoint 0 space) =
      preContorsionSpatialProfileActual.gravityAuxiliary
        (canonicalCauchySlicePoint 0 space)
  rw [positiveP506MatterPreContorsionSpatialProfileFullLorentzTriangularActual,
    changedBackgroundLorentzOriginCarrier_gravityAuxiliary]
  change
    (currentCanonicalFullActionLorentzCoherentDiagonalActual
      positiveSmoothUnifiedSource
      PreContorsionSpatialProfileCurrent).gravityAuxiliary
        (canonicalCauchySlicePoint 0 space) = _
  rw [coherentDiagonalActual_gravityAuxiliary_slice,
    preContorsionSpatialProfileCurrent_zeroStep]
  rfl

/-- The corrected connection is present in the new current at the common
contact; the restart therefore cannot silently reuse the old connection. -/
theorem preContorsionFullLorentzTriangularCurrent_gravityConnection_origin :
    PreContorsionFullLorentzTriangularCurrent.gravityConnection 0 =
      lorentzSkewConnectionOfBivectorOneForm
        preContorsionFullLorentzConnectionCorrection := by
  change
    positiveP506MatterPreContorsionSpatialProfileFullLorentzTriangularActual.gravityConnection
        (canonicalCauchySlicePoint 0 0) = _
  rw [canonicalCauchySlicePoint_zero_zero,
    fullLorentzTriangularActual_connection_origin]

@[simp] theorem preContorsionFullLorentzTriangularCurrent_coframe_origin :
    PreContorsionFullLorentzTriangularCurrent.coframe 0 = 1 := by
  rw [preContorsionFullLorentzTriangularCurrent_coframe_eq_profile,
    preContorsionSpatialProfileCurrent_coframe_origin]

/-- The final current remains in the same action-prepared gravity carrier.
Only primitive coframe and auxiliary fields are used in this proof. -/
theorem preContorsionFullLorentzTriangularCurrent_actionPrepared :
    sourceActionGeneratedJointPrimitiveActionInitialState
        PreContorsionFullLorentzTriangularCurrent =
      PreContorsionFullLorentzTriangularCurrent := by
  apply actionInitialState_eq_self_of_gravityAuxiliaryPrepared
  funext space
  change
    physicalIIPlusBivector
        (PreContorsionFullLorentzTriangularCurrent.coframe space) =
      PreContorsionFullLorentzTriangularCurrent.gravityAuxiliary space
  rw [congrFun
      preContorsionFullLorentzTriangularCurrent_coframe_eq_profile space,
    congrFun
      preContorsionFullLorentzTriangularCurrent_gravityAuxiliary_eq_profile
      space]
  exact congrFun preContorsionSpatialProfileCurrent_gravityAuxiliaryPrepared
    space

/-! ## Zero-faithful restart and complete response -/

/-- The complete restart has the corrected current as its genuine zero
origin.  This is carrier consistency, not a stationary-response claim. -/
@[simp] theorem preContorsionFullLorentzTriangularCurrent_restart_zero :
    positiveP506MatterPreContorsionFullLorentzCurrentRestart 0 =
      PreContorsionFullLorentzTriangularCurrent := by
  exact
    currentCanonicalFullActionLorentzStateResponseUpdate_zero_of_actionPrepared
      positiveSmoothUnifiedSource PreContorsionFullLorentzTriangularCurrent
      preContorsionFullLorentzTriangularCurrent_actionPrepared

/-- The new restart and the established C3h126 update share the same
action-prepared origin.  No positive-coordinate equality is asserted. -/
theorem preContorsionFullLorentzTriangularCurrent_commonC3h126Origin :
    positiveP506MatterPreContorsionFullLorentzCurrentRestart 0 =
      sourceActionGeneratedJointPrimitiveCauchyUpdate
        positiveSmoothUnifiedSource 0
        PreContorsionFullLorentzTriangularCurrent := by
  exact
    currentCanonicalFullActionLorentzStateResponseUpdate_zero_eq_jointPrimitiveCauchyUpdate_zero
      positiveSmoothUnifiedSource PreContorsionFullLorentzTriangularCurrent

/-- The complete full-action response is recomputed from the C3h200n final
current.  The law contains the generated local actual, all ten genuine time
jets, the Lorentz and P286 action responses, and primal/adjoint uniqueness. -/
theorem preContorsionFullLorentzTriangularCurrent_contactResponse :
    StageNineCurrentCanonicalFullActionLorentzContactResponseLaw
      positiveSmoothUnifiedSource PreContorsionFullLorentzTriangularCurrent
      0 := by
  exact currentCanonicalFullActionLorentzContactResponse_realizes
    positiveSmoothUnifiedSource PreContorsionFullLorentzTriangularCurrent 0
    preContorsionFullLorentzTriangularCurrent_coframe_origin

/-- Primitive contact-origin fidelity of the fresh actual.  This is a local
statement because only the canonical contact currently carries the complete
identity-principal response authority. -/
def PreContorsionFullLorentzFreshContactOriginFidelity : Prop :=
  positiveP506MatterPreContorsionFullLorentzFreshActual.coframe 0 =
      PreContorsionFullLorentzTriangularCurrent.coframe 0 ∧
    positiveP506MatterPreContorsionFullLorentzFreshActual.gravityConnection
        0 =
      PreContorsionFullLorentzTriangularCurrent.gravityConnection 0 ∧
    positiveP506MatterPreContorsionFullLorentzFreshActual.gravityAuxiliary
        0 =
      PreContorsionFullLorentzTriangularCurrent.gravityAuxiliary 0 ∧
    positiveP506MatterPreContorsionFullLorentzFreshActual.gravitySimplicityMultiplier
        0 =
      PreContorsionFullLorentzTriangularCurrent.gravitySimplicityMultiplier 0 ∧
    positiveP506MatterPreContorsionFullLorentzFreshActual.gaugeConnection 0 =
      PreContorsionFullLorentzTriangularCurrent.gaugeConnection 0 ∧
    positiveP506MatterPreContorsionFullLorentzFreshActual.gaugeAuxiliary 0 =
      PreContorsionFullLorentzTriangularCurrent.gaugeAuxiliary 0 ∧
    positiveP506MatterPreContorsionFullLorentzFreshActual.scalar 0 =
      PreContorsionFullLorentzTriangularCurrent.scalar 0 ∧
    positiveP506MatterPreContorsionFullLorentzFreshActual.matter 0 =
      PreContorsionFullLorentzTriangularCurrent.matter 0 ∧
    positiveP506MatterPreContorsionFullLorentzFreshActual.conjugateMatter 0 =
      PreContorsionFullLorentzTriangularCurrent.conjugateMatter 0

theorem preContorsionFullLorentzFreshActual_contactOriginFidelity :
    PreContorsionFullLorentzFreshContactOriginFidelity := by
  have zeroStep :=
    preContorsionFullLorentzTriangularCurrent_restart_zero
  have coframe := congrArg (fun state : StageNineCauchyState =>
    state.coframe 0) zeroStep
  have gravityConnection := congrArg (fun state : StageNineCauchyState =>
    state.gravityConnection 0) zeroStep
  have gravityAuxiliary := congrArg (fun state : StageNineCauchyState =>
    state.gravityAuxiliary 0) zeroStep
  have multiplier := congrArg (fun state : StageNineCauchyState =>
    state.gravitySimplicityMultiplier 0) zeroStep
  have gaugeConnection := congrArg (fun state : StageNineCauchyState =>
    state.gaugeConnection 0) zeroStep
  have gaugeAuxiliary := congrArg (fun state : StageNineCauchyState =>
    state.gaugeAuxiliary 0) zeroStep
  have scalar := congrArg (fun state : StageNineCauchyState =>
    state.scalar 0) zeroStep
  have matter := congrArg (fun state : StageNineCauchyState =>
    state.matter 0) zeroStep
  have conjugateMatter := congrArg (fun state : StageNineCauchyState =>
    state.conjugateMatter 0) zeroStep
  change
    positiveP506MatterPreContorsionFullLorentzFreshActual.coframe
        (canonicalCauchySlicePoint 0 0) = _ at coframe
  change
    positiveP506MatterPreContorsionFullLorentzFreshActual.gravityConnection
        (canonicalCauchySlicePoint 0 0) = _ at gravityConnection
  change
    positiveP506MatterPreContorsionFullLorentzFreshActual.gravityAuxiliary
        (canonicalCauchySlicePoint 0 0) = _ at gravityAuxiliary
  change
    positiveP506MatterPreContorsionFullLorentzFreshActual.gravitySimplicityMultiplier
        (canonicalCauchySlicePoint 0 0) = _ at multiplier
  change positiveP506MatterPreContorsionFullLorentzFreshActual.gaugeConnection
    (canonicalCauchySlicePoint 0 0) = _ at gaugeConnection
  change positiveP506MatterPreContorsionFullLorentzFreshActual.gaugeAuxiliary
    (canonicalCauchySlicePoint 0 0) = _ at gaugeAuxiliary
  change positiveP506MatterPreContorsionFullLorentzFreshActual.scalar
    (canonicalCauchySlicePoint 0 0) = _ at scalar
  change positiveP506MatterPreContorsionFullLorentzFreshActual.matter
    (canonicalCauchySlicePoint 0 0) = _ at matter
  change positiveP506MatterPreContorsionFullLorentzFreshActual.conjugateMatter
    (canonicalCauchySlicePoint 0 0) = _ at conjugateMatter
  rw [canonicalCauchySlicePoint_zero_zero] at coframe gravityConnection
  rw [canonicalCauchySlicePoint_zero_zero] at gravityAuxiliary multiplier
  rw [canonicalCauchySlicePoint_zero_zero] at gaugeConnection gaugeAuxiliary
  rw [canonicalCauchySlicePoint_zero_zero] at scalar matter conjugateMatter
  unfold PreContorsionFullLorentzFreshContactOriginFidelity
  exact ⟨coframe, gravityConnection, gravityAuxiliary, multiplier,
    gaugeConnection, gaugeAuxiliary, scalar, matter, conjugateMatter⟩

/-! ## C3h200p checkpoint law -/

/-- Role-separated final-current restart authority.  Only the fresh actual
and complete current-dependent response are new producer content.  Prepared
origin equalities remain explicitly classified as consistency. -/
structure
    PositiveP506MatterPreContorsionFullLorentzCurrentResponseRestartLaw :
    Prop where
  exactP506L0Lineage :
    positiveSmoothUnifiedSource.stageEight.generatedP506L0Lineage =
      canonicalP506SourceAffineL0ObservableLineageReference
  endpointEleven :
    positiveSmoothUnifiedSource.stageEight.generatedSelectedEndpoint
        canonicalSource_generatedLineage_height_pos = 11
  finalCurrentGenerated :
    PreContorsionFullLorentzTriangularCurrent =
      canonicalCauchyRestriction 0
        positiveP506MatterPreContorsionSpatialProfileFullLorentzTriangularActual
  correctedConnectionPresent :
    PreContorsionFullLorentzTriangularCurrent.gravityConnection 0 =
      lorentzSkewConnectionOfBivectorOneForm
        preContorsionFullLorentzConnectionCorrection
  actionPrepared :
    sourceActionGeneratedJointPrimitiveActionInitialState
        PreContorsionFullLorentzTriangularCurrent =
      PreContorsionFullLorentzTriangularCurrent
  zeroRestartConsistency :
    positiveP506MatterPreContorsionFullLorentzCurrentRestart 0 =
      PreContorsionFullLorentzTriangularCurrent
  commonC3h126OriginConsistency :
    positiveP506MatterPreContorsionFullLorentzCurrentRestart 0 =
      sourceActionGeneratedJointPrimitiveCauchyUpdate
        positiveSmoothUnifiedSource 0
        PreContorsionFullLorentzTriangularCurrent
  freshContactOriginFidelity :
    PreContorsionFullLorentzFreshContactOriginFidelity
  completeFinalCurrentResponse :
    StageNineCurrentCanonicalFullActionLorentzContactResponseLaw
      positiveSmoothUnifiedSource PreContorsionFullLorentzTriangularCurrent
      0

theorem
    positiveP506MatterPreContorsionFullLorentzCurrentResponseRestart_realizes_C3h200p :
    PositiveP506MatterPreContorsionFullLorentzCurrentResponseRestartLaw := by
  exact
    { exactP506L0Lineage :=
        positiveSmoothUnifiedSource_generates_exactP506L0Lineage
      endpointEleven := positiveSmoothUnifiedSource_generates_endpoint_eleven
      finalCurrentGenerated := rfl
      correctedConnectionPresent :=
        preContorsionFullLorentzTriangularCurrent_gravityConnection_origin
      actionPrepared :=
        preContorsionFullLorentzTriangularCurrent_actionPrepared
      zeroRestartConsistency :=
        preContorsionFullLorentzTriangularCurrent_restart_zero
      commonC3h126OriginConsistency :=
        preContorsionFullLorentzTriangularCurrent_commonC3h126Origin
      freshContactOriginFidelity :=
        preContorsionFullLorentzFreshActual_contactOriginFidelity
      completeFinalCurrentResponse :=
        preContorsionFullLorentzTriangularCurrent_contactResponse }

end

end
  SaturationMonoid.PhysicsCore.StageNineSourceActionGeneratedP506MatterPreContorsionSpatialProfileFullLorentzCurrentResponseRestart
