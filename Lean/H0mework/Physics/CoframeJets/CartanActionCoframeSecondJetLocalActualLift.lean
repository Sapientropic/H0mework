open StageNineP286ActionVelocityLocalActualLift
open StageNineScalarActionCanonicalMomentumUpdate
open StageNineScalarActionSecondJetLocalActualLift

noncomputable section

set_option autoImplicit false

/-- Matrix-valued physical-time jet of the actual C3h101 Lorentz connection.
It is generated by the action-owned bivector jet, not reconstructed from a
torsion residual. -/
def positiveActionGeneratedLorentzConnectionTimeJet :
    PointwiseLorentzSpinConnection :=
  lorentzSkewConnectionOfBivectorOneForm
    (fun formDirection internalPair =>
      actionGeneratedLorentzLocalConnectionJet
        positivePhaseProbeCauchyState 0
        canonicalLorentzianTimeDirection formDirection internalPair)

/-- The twelve spatial coframe-acceleration coordinates generated by the
actual Lorentz action jet and Cartan transport. -/
abbrev PositiveCartanSpatialCoframeAcceleration :=
  LorentzianIndex → Fin 3 → ℝ

def positiveActionGeneratedCartanSpatialCoframeAcceleration :
    PositiveCartanSpatialCoframeAcceleration :=
  fun internal direction =>
    positiveActionGeneratedLorentzConnectionTimeJet
      direction.succ internal 0

/-- Direct update law for the twelve spatial coordinates.  It mentions no
endpoint or residual and has coefficient one, hence no inverse or branch
selector. -/
def PositiveActionCartanSpatialAccelerationLaw
    (candidate : PositiveCartanSpatialCoframeAcceleration) : Prop :=
  ∀ internal direction,
    candidate internal direction =
      positiveActionGeneratedLorentzConnectionTimeJet
        direction.succ internal 0

theorem
    positiveActionGeneratedCartanSpatialCoframeAcceleration_satisfies_law :
    PositiveActionCartanSpatialAccelerationLaw
      positiveActionGeneratedCartanSpatialCoframeAcceleration := by
  intro internal direction
  rfl

theorem positiveActionCartanSpatialAccelerationLaw_unique
    (candidate : PositiveCartanSpatialCoframeAcceleration)
    (law : PositiveActionCartanSpatialAccelerationLaw candidate) :
    candidate =
      positiveActionGeneratedCartanSpatialCoframeAcceleration := by
  funext internal direction
  exact law internal direction

/-- Cartan transport of the action-generated Lorentz time jet into the
spatial coframe acceleration at the positive identity-coframe mouth.
The temporal coframe column remains the existing fixed control. -/
def positiveActionGeneratedCartanCoframeAcceleration :
    LorentzianCoframe :=
  fun internal coordinate =>
    ![
      0,
      positiveActionGeneratedCartanSpatialCoframeAcceleration internal 0,
      positiveActionGeneratedCartanSpatialCoframeAcceleration internal 1,
      positiveActionGeneratedCartanSpatialCoframeAcceleration internal 2
    ] coordinate

@[simp] theorem
    positiveActionGeneratedCartanCoframeAcceleration_temporal :
    ∀ internal,
      positiveActionGeneratedCartanCoframeAcceleration internal
        canonicalLorentzianTimeDirection = 0 := by
  intro internal
  simp [positiveActionGeneratedCartanCoframeAcceleration,
    canonicalLorentzianTimeDirection]

private theorem positiveActionGravityCurvature_component :
    actionGeneratedGravityCurvature positivePhaseProbeCauchyState 0 0 0 =
      -1 := by
  rw [positivePhaseProbeCauchyState_eq_normalForm]
  change
    gravityInternalDualLinear
        (gravityInternalDualLinear (coframeWedge 1)) 0 0 =
      -1
  rw [gravityInternalDualLinear_square]
  norm_num [coframeWedge, pairFirst, pairSecond, Matrix.one_apply]

private theorem positiveActionLorentzVelocity_component :
    actionGeneratedLorentzSpatialConnectionVelocity
        positivePhaseProbeCauchyState 0 0 0 =
      -1 := by
  calc
    _ = actionGeneratedGravityCurvature
          positivePhaseProbeCauchyState 0 0 0 := by
      rw [positivePhaseProbeCauchyState_eq_normalForm]
      simp [actionGeneratedLorentzSpatialConnectionVelocity,
        cauchyLoweredLorentzSpatialConnectionDerivativeCoordinate,
        cauchyLoweredLorentzConnectionBracketCoordinate,
        temporalSpatialPair, canonicalLorentzianTimeDirection,
        positiveProbeCauchyStateNormalForm]
    _ = -1 := positiveActionGravityCurvature_component

theorem positiveActionGeneratedCartanCoframeAcceleration_component :
    positiveActionGeneratedCartanCoframeAcceleration 1 1 = 1 := by
  simp [positiveActionGeneratedCartanCoframeAcceleration,
    positiveActionGeneratedCartanSpatialCoframeAcceleration,
    positiveActionGeneratedLorentzConnectionTimeJet,
    lorentzSkewConnectionOfBivectorOneForm,
    loweredLorentzBivectorMatrix,
    orientedLorentzBivectorBasisCoefficient,
    actionGeneratedLorentzLocalConnectionJet,
    positiveActionLorentzVelocity_component,
    pairFirst, pairSecond, minkowskiInternalSign,
    canonicalLorentzianTimeDirection, Fin.sum_univ_six]

def positiveActionGeneratedCartanCoframeField
    (point : BasePoint) : LorentzianCoframe :=
  positivePathFirstJointLocalActualLift.coframe point +
    scalarQuadraticTimeCoefficient point •
      positiveActionGeneratedCartanCoframeAcceleration

def positiveActionGeneratedCartanGravityAuxiliaryField
    (point : BasePoint) : PhysicalBivector :=
  physicalIIPlusBivector
    (positiveActionGeneratedCartanCoframeField point)

/-- Joint second-order actual response: the C3h101 connection and all other
action-generated fields are retained, C3h102 supplies the scalar second jet,
and Cartan transport supplies the coframe second jet together with the
derived simple gravity auxiliary. -/
def positiveActionGeneratedCartanJointLocalActualLift :
    StageNineHolonomicConfiguration :=
  { positiveActionGeneratedScalarSecondJetLocalActualLift with
    coframe := positiveActionGeneratedCartanCoframeField
    gravityAuxiliary :=
      positiveActionGeneratedCartanGravityAuxiliaryField }

def PositiveActionCartanRetainedFields
    (actual : StageNineHolonomicConfiguration) : Prop :=
  actual.gravityConnection =
      positiveActionGeneratedScalarSecondJetLocalActualLift.gravityConnection ∧
    actual.gravitySimplicityMultiplier =
      positiveActionGeneratedScalarSecondJetLocalActualLift.gravitySimplicityMultiplier ∧
    actual.gaugeConnection =
      positiveActionGeneratedScalarSecondJetLocalActualLift.gaugeConnection ∧
    actual.gaugeAuxiliary =
      positiveActionGeneratedScalarSecondJetLocalActualLift.gaugeAuxiliary ∧
    actual.scalar =
      positiveActionGeneratedScalarSecondJetLocalActualLift.scalar ∧
    actual.matter =
      positiveActionGeneratedScalarSecondJetLocalActualLift.matter ∧
    actual.conjugateMatter =
      positiveActionGeneratedScalarSecondJetLocalActualLift.conjugateMatter

theorem
    positiveActionGeneratedCartanJointLocalActualLift_retains_action_fields :
    PositiveActionCartanRetainedFields
      positiveActionGeneratedCartanJointLocalActualLift := by
  exact ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

theorem positiveActionGeneratedCartanCoframeField_origin :
    positiveActionGeneratedCartanCoframeField 0 = 1 := by
  simp [positiveActionGeneratedCartanCoframeField]

theorem positiveActionGeneratedCartanGravityAuxiliaryField_origin :
    positiveActionGeneratedCartanGravityAuxiliaryField 0 =
      physicalIIPlusBivector 1 := by
  rw [positiveActionGeneratedCartanGravityAuxiliaryField,
    positiveActionGeneratedCartanCoframeField_origin]

theorem positiveActionGeneratedCartanCoframeField_timeDerivative
    (point : BasePoint)
    (internal coordinate : LorentzianIndex) :
    fieldDirectionalDerivative
        (fun candidate =>
          positiveActionGeneratedCartanCoframeField candidate
            internal coordinate)
        point canonicalLorentzianTimeDirection =
      point canonicalLorentzianTimeDirection *
        positiveActionGeneratedCartanCoframeAcceleration
          internal coordinate := by
  have derivative :=
    (hasFDerivAt_const (x := point)
      (c := (1 : LorentzianCoframe) internal coordinate)).add
      ((scalarQuadraticTimeCoefficient_hasFDerivAt point).mul_const
        (positiveActionGeneratedCartanCoframeAcceleration
          internal coordinate))
  rw [show
    (fun candidate =>
      positiveActionGeneratedCartanCoframeField candidate
        internal coordinate) =
      fun candidate =>
        (1 : LorentzianCoframe) internal coordinate +
          scalarQuadraticTimeCoefficient candidate *
            positiveActionGeneratedCartanCoframeAcceleration
              internal coordinate by
    funext candidate
    simp [positiveActionGeneratedCartanCoframeField]]
  rw [show
    (fun candidate : BasePoint =>
      (1 : LorentzianCoframe) internal coordinate +
        scalarQuadraticTimeCoefficient candidate *
          positiveActionGeneratedCartanCoframeAcceleration
            internal coordinate) =
      (fun _ : BasePoint =>
        (1 : LorentzianCoframe) internal coordinate) +
        fun candidate =>
          scalarQuadraticTimeCoefficient candidate *
            positiveActionGeneratedCartanCoframeAcceleration
              internal coordinate by
    rfl]
  unfold fieldDirectionalDerivative
  rw [derivative.fderiv]
  simp [coordinateDirection]
  ring

theorem
    positiveActionGeneratedCartanCoframeField_temporalColumnDerivative_zero
    (point : BasePoint)
    (derivativeDirection internal : LorentzianIndex) :
    fieldDirectionalDerivative
        (fun candidate =>
          positiveActionGeneratedCartanCoframeField candidate
            internal canonicalLorentzianTimeDirection)
        point derivativeDirection = 0 := by
  rw [show
    (fun candidate =>
      positiveActionGeneratedCartanCoframeField candidate
        internal canonicalLorentzianTimeDirection) =
      fun _ : BasePoint =>
        (1 : LorentzianCoframe) internal 0 by
    funext candidate
    simp [positiveActionGeneratedCartanCoframeField,
      positiveActionGeneratedCartanCoframeAcceleration,
      canonicalLorentzianTimeDirection]]
  simp [fieldDirectionalDerivative]

theorem positiveActionGeneratedCartanCoframeField_firstTimeDerivative_origin
    (internal coordinate : LorentzianIndex) :
    fieldDirectionalDerivative
        (fun point =>
          positiveActionGeneratedCartanCoframeField point
            internal coordinate)
        0 canonicalLorentzianTimeDirection = 0 := by
  rw [positiveActionGeneratedCartanCoframeField_timeDerivative]
  simp

theorem positiveActionGeneratedCartanCoframeField_secondTimeDerivative_origin
    (internal coordinate : LorentzianIndex) :
    fieldDirectionalDerivative
        (fun point =>
          fieldDirectionalDerivative
            (fun candidate =>
              positiveActionGeneratedCartanCoframeField candidate
                internal coordinate)
            point canonicalLorentzianTimeDirection)
        0 canonicalLorentzianTimeDirection =
      positiveActionGeneratedCartanCoframeAcceleration
        internal coordinate := by
  rw [show
    (fun point =>
      fieldDirectionalDerivative
        (fun candidate =>
          positiveActionGeneratedCartanCoframeField candidate
            internal coordinate)
        point canonicalLorentzianTimeDirection) =
      fun point =>
        point canonicalLorentzianTimeDirection *
          positiveActionGeneratedCartanCoframeAcceleration
            internal coordinate by
    funext point
    exact positiveActionGeneratedCartanCoframeField_timeDerivative
      point internal coordinate]
  unfold fieldDirectionalDerivative
  have derivative :=
    (localBaseCoordinate canonicalLorentzianTimeDirection).hasFDerivAt
      (x := (0 : BasePoint))
      |>.mul_const
        (positiveActionGeneratedCartanCoframeAcceleration
          internal coordinate)
  rw [show
    (fun point : BasePoint =>
      point canonicalLorentzianTimeDirection *
        positiveActionGeneratedCartanCoframeAcceleration
          internal coordinate) =
      fun point =>
        localBaseCoordinate canonicalLorentzianTimeDirection point *
          positiveActionGeneratedCartanCoframeAcceleration
            internal coordinate by
    rfl,
    derivative.fderiv]
  simp [coordinateDirection]

theorem
    positiveActionGeneratedCartanJointLocalActualLift_scalarSecondTimeDerivative :
    fieldDirectionalDerivative
        (fun point =>
          fieldDirectionalDerivative
            positiveActionGeneratedCartanJointLocalActualLift.scalar
            point canonicalLorentzianTimeDirection)
        0 canonicalLorentzianTimeDirection =
      positiveActionGeneratedScalarCovariantAcceleration := by
  change
    fieldDirectionalDerivative
        (fun point =>
          fieldDirectionalDerivative
            positiveActionGeneratedScalarSecondJetLocalActualLift.scalar
            point canonicalLorentzianTimeDirection)
        0 canonicalLorentzianTimeDirection =
      positiveActionGeneratedScalarCovariantAcceleration
  exact
    positiveActionGeneratedScalarSecondJetLocalActualLift_scalarSecondTimeDerivative

theorem positiveActionGeneratedCartanJointLocalActualLift_simplicity :
    StageNinePlebanskiMultiplierVariation.GravitySimplicityEquation
      positiveActionGeneratedCartanJointLocalActualLift := by
  intro point
  rfl

theorem positivePathFirstGravityConnection_timeAxis
    (time : ℝ) :
    positivePathFirstJointLocalActualLift.gravityConnection
        (canonicalCauchySlicePoint time 0) =
      time • positiveActionGeneratedLorentzConnectionTimeJet := by
  have increment :
      actionGeneratedLorentzLocalBivectorIncrement
          positivePhaseProbeCauchyState 0
          (canonicalCauchySlicePoint time 0) =
        time •
          (fun formDirection internalPair =>
            actionGeneratedLorentzLocalConnectionJet
              positivePhaseProbeCauchyState 0
              canonicalLorentzianTimeDirection formDirection
                internalPair) := by
    funext formDirection internalPair
    unfold actionGeneratedLorentzLocalBivectorIncrement
      actionGeneratedLorentzLocalIncrement
    simp [localBaseCoordinate, canonicalCauchySlicePoint,
      canonicalLorentzianTimeDirection, Fin.sum_univ_four]
  funext formDirection internalOut internalIn
  change
    actionGeneratedLorentzLocalConnection
        positivePhaseProbeCauchyState 0
        (canonicalCauchySlicePoint time 0)
        formDirection internalOut internalIn =
      _
  unfold actionGeneratedLorentzLocalConnection
  rw [increment, lorentzSkewConnectionOfBivectorOneForm_smul]
  simp [
    positiveActionGeneratedLorentzConnectionTimeJet,
    positivePhaseProbeCauchyState_eq_normalForm,
    positiveProbeCauchyStateNormalForm]

theorem positiveActionGeneratedCartanGravityConnection_timeAxis
    (time : ℝ) :
    positiveActionGeneratedCartanJointLocalActualLift.gravityConnection
        (canonicalCauchySlicePoint time 0) =
      time • positiveActionGeneratedLorentzConnectionTimeJet := by
  change
    positiveActionGeneratedScalarSecondJetLocalActualLift.gravityConnection
        (canonicalCauchySlicePoint time 0) =
      _
  rw [positiveActionGeneratedScalarSecondJetLocalActualLift_eq_C3h101]
  exact positivePathFirstGravityConnection_timeAxis time

@[simp] theorem positiveActionGeneratedLorentzConnectionTimeJet_temporal_zero :
    positiveActionGeneratedLorentzConnectionTimeJet
        canonicalLorentzianTimeDirection = 0 := by
  funext internalOut internalIn
  simp [positiveActionGeneratedLorentzConnectionTimeJet,
    actionGeneratedLorentzLocalConnectionJet,
    canonicalLorentzianTimeDirection,
    lorentzSkewConnectionOfBivectorOneForm,
    loweredLorentzBivectorMatrix]

theorem positivePathFirstGravityConnection_timeAxis_temporal_zero
    (time : ℝ) :
    positivePathFirstJointLocalActualLift.gravityConnection
        (canonicalCauchySlicePoint time 0)
        canonicalLorentzianTimeDirection = 0 := by
  rw [positivePathFirstGravityConnection_timeAxis]
  funext internalOut internalIn
  simp

@[simp] theorem
    positiveActionGeneratedCartanCoframeAcceleration_spatial
    (internal : LorentzianIndex)
    (direction : Fin 3) :
    positiveActionGeneratedCartanCoframeAcceleration
        internal direction.succ =
      positiveActionGeneratedLorentzConnectionTimeJet
        direction.succ internal 0 := by
  fin_cases direction <;>
    simp [positiveActionGeneratedCartanCoframeAcceleration,
      positiveActionGeneratedCartanSpatialCoframeAcceleration]

@[simp] theorem
    positiveActionGeneratedCartanCoframeField_temporalColumn
    (point : BasePoint)
    (internal : LorentzianIndex) :
    positiveActionGeneratedCartanCoframeField point internal
        canonicalLorentzianTimeDirection =
      (1 : LorentzianCoframe) internal 0 := by
  simp [positiveActionGeneratedCartanCoframeField,
    positiveActionGeneratedCartanCoframeAcceleration,
    canonicalLorentzianTimeDirection]

/-- Downstream acceptance of the action/Cartan-generated joint response:
on the physical-time path through the selected positive Cauchy point, every
mixed Cartan torsion coordinate vanishes exactly. -/
theorem positiveActionGeneratedCartanJointLocalActualLift_mixedCartanLaw
    (time : ℝ)
    (direction : Fin 3)
    (internal : LorentzianIndex) :
    cartanTorsionCoordinate
        positiveActionGeneratedCartanJointLocalActualLift
        (canonicalCauchySlicePoint time 0)
        canonicalLorentzianTimeDirection direction.succ internal = 0 := by
  unfold cartanTorsionCoordinate
  dsimp only [positiveActionGeneratedCartanJointLocalActualLift]
  rw [positiveActionGeneratedCartanCoframeField_timeDerivative,
    positiveActionGeneratedCartanCoframeField_temporalColumnDerivative_zero,
    positiveActionGeneratedScalarSecondJetLocalActualLift_eq_C3h101]
  rw [positivePathFirstGravityConnection_timeAxis_temporal_zero,
    positivePathFirstGravityConnection_timeAxis]
  simp_rw [positiveActionGeneratedCartanCoframeField_temporalColumn]
  rw [positiveActionGeneratedCartanCoframeAcceleration_spatial]
  fin_cases direction <;> fin_cases internal <;>
    simp [canonicalCauchySlicePoint, canonicalLorentzianTimeDirection,
      Matrix.one_apply]

/-- Complete positive-lineage second-order response interface.  The
constructor is listed first; the Cartan equation appears only as the final
acceptance field. -/
structure PositiveActionCartanSecondJetLocalActualLaw
    (actual : StageNineHolonomicConfiguration) : Prop where
  retainsActionFields :
    PositiveActionCartanRetainedFields actual
  spatialAcceleration :
    PositiveActionCartanSpatialAccelerationLaw
      positiveActionGeneratedCartanSpatialCoframeAcceleration
  coframeInitial :
    actual.coframe 0 = 1
  coframeFirstTime :
    ∀ internal coordinate,
      fieldDirectionalDerivative
          (fun point => actual.coframe point internal coordinate)
          0 canonicalLorentzianTimeDirection = 0
  coframeSecondTime :
    ∀ internal coordinate,
      fieldDirectionalDerivative
          (fun point =>
            fieldDirectionalDerivative
              (fun candidate =>
                actual.coframe candidate internal coordinate)
              point canonicalLorentzianTimeDirection)
          0 canonicalLorentzianTimeDirection =
        positiveActionGeneratedCartanCoframeAcceleration
          internal coordinate
  lorentzConnectionTimePath :
    ∀ time,
      actual.gravityConnection (canonicalCauchySlicePoint time 0) =
        time • positiveActionGeneratedLorentzConnectionTimeJet
  scalarSecondTime :
    fieldDirectionalDerivative
        (fun point =>
          fieldDirectionalDerivative actual.scalar point
            canonicalLorentzianTimeDirection)
        0 canonicalLorentzianTimeDirection =
      positiveActionGeneratedScalarCovariantAcceleration
  scalarAction :
    ∀ direction,
      sourceActionGeneratedScalarTemporalMomentumVelocity
          positiveSmoothUnifiedSource positivePhaseProbeCauchyState 0
          direction =
        -scalarCoordinatePairingRe direction
          positiveActionGeneratedScalarCovariantAcceleration
  gravitySimplicity :
    StageNinePlebanskiMultiplierVariation.GravitySimplicityEquation actual
  mixedCartanAcceptance :
    ∀ (time : ℝ) (direction : Fin 3) (internal : LorentzianIndex),
      cartanTorsionCoordinate actual
          (canonicalCauchySlicePoint time 0)
          canonicalLorentzianTimeDirection direction.succ internal = 0

theorem
    positiveActionGeneratedCartanJointLocalActualLift_realizes_C3h103 :
    PositiveActionCartanSecondJetLocalActualLaw
      positiveActionGeneratedCartanJointLocalActualLift := by
  refine
    { retainsActionFields :=
        positiveActionGeneratedCartanJointLocalActualLift_retains_action_fields,
      spatialAcceleration :=
        positiveActionGeneratedCartanSpatialCoframeAcceleration_satisfies_law,
      coframeInitial :=
        positiveActionGeneratedCartanCoframeField_origin,
      coframeFirstTime := ?_,
      coframeSecondTime := ?_,
      lorentzConnectionTimePath :=
        positiveActionGeneratedCartanGravityConnection_timeAxis,
      scalarSecondTime :=
        positiveActionGeneratedCartanJointLocalActualLift_scalarSecondTimeDerivative,
      scalarAction :=
        positiveActionGeneratedScalarCovariantAcceleration_actionLaw,
      gravitySimplicity :=
        positiveActionGeneratedCartanJointLocalActualLift_simplicity,
      mixedCartanAcceptance :=
        positiveActionGeneratedCartanJointLocalActualLift_mixedCartanLaw }
  · intro internal coordinate
    exact
      positiveActionGeneratedCartanCoframeField_firstTimeDerivative_origin
        internal coordinate
  · intro internal coordinate
    exact
      positiveActionGeneratedCartanCoframeField_secondTimeDerivative_origin
        internal coordinate

end

end
