import H0mework.Physics.DualVariation.LorentzConnectionVariation
import H0mework.Physics.Lorentz.LorentzTorsionSpinEquation

/-!
# Repaired-root Lorentz stationarity and torsion--spin balance

The repaired Dirac-dual Yukawa term is independent of the Lorentz connection
jet.  Its authoritative root nevertheless has a distinct action hash, so its
stationarity receipt must be regenerated rather than borrowed from the
historical action.  The new-hash variation already produces the same
form-native weak coefficient.  This module faithfully localizes that
coefficient and, on the computed `II+` actual, reads it as the existing
torsion--spin equation.

No stationarity witness, torsion solution, contorsion inverse, or old-action
stationarity theorem is accepted as a premise.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeLorentzTorsionSpinEquation

open ProofFreeRicherAnholonomicSource
open StageNineDiracDualFormNativeLorentzConnectionVariation
open StageNineDiracDualFormNativeMotherAction
open StageNineEnrichedProofFreeSource
open StageNineFormNativeIIPlusJetKinematics
open StageNineFormNativeLorentzConnectionIntegratedVariation
open StageNineFormNativeLorentzPointwiseEquation
open StageNineFormNativeLorentzTorsionSpinEquation
open StageNineGlobalIntegratedAction
open StageNineGravityBianchi
open StageNineHolonomicField
open StageNineIIPlusRestriction

noncomputable section

set_option autoImplicit false

/-- New-hash connection stationarity has the faithful pointwise equation
generated by its own integrated action derivative. -/
theorem
    diracDualFormNativeLorentzConnectionActionStationary_iff_pointwiseEquation
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (admissible : GravityConnectionLorentzAdmissible configuration)
    (nondegenerate : configuration.Nondegenerate)
    (densityIntegrable :
      DiracDualFormNativeHolonomicLocalDensityIntegrable source 0
        configuration) :
    DiracDualFormNativeLorentzConnectionActionStationary source
        configuration ↔
      FormNativeLorentzConnectionPointwiseEquation source configuration := by
  rw [diracDualFormNativeLorentzConnectionActionStationary_iff_weakEquation
    source configuration smooth nondegenerate densityIntegrable]
  exact formNativeLorentzConnectionWeakEquation_iff_pointwiseEquation source
    configuration smooth admissible nondegenerate

/-- On the actual obtained by computing `B := II+(e)`, stationarity of the
repaired root is exactly the torsion--spin balance.  This is an equivalence of
generated equations, not a proof that either zero fiber is inhabited. -/
theorem
    diracDualFormNativeLorentzConnectionActionStationary_restrictToIIPlus_iff_torsionSpinEquation
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (admissible : GravityConnectionLorentzAdmissible configuration)
    (nondegenerate : configuration.Nondegenerate)
    (densityIntegrable :
      DiracDualFormNativeHolonomicLocalDensityIntegrable source 0
        (restrictHolonomicConfigurationToIIPlus configuration)) :
    DiracDualFormNativeLorentzConnectionActionStationary source
        (restrictHolonomicConfigurationToIIPlus configuration) ↔
      FormNativeIIPlusTorsionSpinEquation source configuration := by
  have restrictedSmooth :
      (restrictHolonomicConfigurationToIIPlus configuration).Smooth :=
    restrictHolonomicConfigurationToIIPlus_smooth configuration smooth
  have restrictedAdmissible :
      GravityConnectionLorentzAdmissible
        (restrictHolonomicConfigurationToIIPlus configuration) :=
    (restrictHolonomicConfigurationToIIPlus_lorentzAdmissible_iff
      configuration).2 admissible
  have restrictedNondegenerate :
      (restrictHolonomicConfigurationToIIPlus configuration).Nondegenerate :=
    (restrictHolonomicConfigurationToIIPlus_nondegenerate_iff
      configuration).2 nondegenerate
  rw [diracDualFormNativeLorentzConnectionActionStationary_iff_pointwiseEquation
    source (restrictHolonomicConfigurationToIIPlus configuration)
    restrictedSmooth restrictedAdmissible restrictedNondegenerate
    densityIntegrable]
  exact
    formNativeLorentzConnectionPointwiseEquation_restrictToIIPlus_iff_torsionSpinEquation
      source configuration smooth admissible

end

end
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeLorentzTorsionSpinEquation
