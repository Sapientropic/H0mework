/-!
# Dirac-dual form-native joint residual carrier

This module is the single pointwise residual mouth of the authoritative
Dirac-dual form-native Stage-9 mother action.  Its nine coordinates are the
actual algebraic or Euler residuals generated by that action:

* gravity multiplier and gravity auxiliary;
* P286 gauge auxiliary;
* Lorentz and P286 connection three-forms;
* scalar, matter, and conjugate-matter directional families;
* the coframe Euler covector.

The constructor consumes only a proof-free source, one holonomic
configuration, and one spacetime point.  It accepts no target residual,
equation receipt, stationarity certificate, branch selector, or supplied
solution.  The global section and its zero fiber are readouts of that same
source/configuration pair.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeJointResidualCarrier

open ProofFreeRicherAnholonomicSource
open StageNineDiracDualFormNativeCoframeLocalVariation
open StageNineDiracDualFormNativeConjugateMatterVariation
open StageNineDiracDualFormNativeMatterVariation
open StageNineDiracDualFormNativeScalarVariation
open StageNineDynamicBreakingVacuum
open StageNineEnrichedProofFreeSource
open StageNineFormNativeGaugeWedge
open StageNineFormNativeGravityMultiplierAuxiliaryVariation
open StageNineFormNativeGaugeAuxiliaryVariation
open StageNineFormNativeLorentzGeometricFirstVariation
open StageNineFormNativeP286GaugeGeometricFirstVariation
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineResidualLinearPlebanskiTorsionReduction
open StageNineTopologicalP286GaugeThreeFormDuality
open SU7MotherGaugeTheory
open SU7MotherLieAlgebra

noncomputable section

set_option autoImplicit false

/-- The complete repaired-root residual at one spacetime point.

Connection equations are stored in their faithful geometric three-form
carriers.  The scalar and matter equations remain raw directional families:
no unproved linearity or continuity package is smuggled into the carrier. -/
structure DiracDualFormNativePointwiseJointResidualCarrier where
  gravityMultiplier : PhysicalBivector
  gravityAuxiliary : PhysicalBivector
  p286GaugeAuxiliary : FormNativeP286GaugeTwoForm
  lorentzConnection : PhysicalBivectorThreeForm
  p286GaugeConnection : P286GaugeThreeForm
  scalar : ScalarCoordinateCarrier → ℝ
  matter : MatterCoordinateCarrier → ℝ
  conjugateMatter : MatterCoordinateCarrier → ℝ
  coframe : LorentzianCoframe →L[ℝ] ℝ

/-! ## Canonical componentwise additive carrier -/

abbrev DiracDualFormNativePointwiseAlgebraicResidualCoordinates :=
  PhysicalBivector × PhysicalBivector × FormNativeP286GaugeTwoForm

abbrev DiracDualFormNativePointwiseEulerResidualCoordinates :=
  PhysicalBivectorThreeForm ×
    P286GaugeThreeForm ×
      (ScalarCoordinateCarrier → ℝ) ×
        (MatterCoordinateCarrier → ℝ) ×
          (MatterCoordinateCarrier → ℝ) ×
            (LorentzianCoframe →L[ℝ] ℝ)

abbrev DiracDualFormNativePointwiseJointResidualCoordinates :=
  DiracDualFormNativePointwiseAlgebraicResidualCoordinates ×
    DiracDualFormNativePointwiseEulerResidualCoordinates

/-- Exact coordinate equivalence exposing the existing nine residual
channels.  It adds no coordinate and forgets no action readout. -/
def diracDualFormNativePointwiseJointResidualCoordinateEquiv :
    DiracDualFormNativePointwiseJointResidualCarrier ≃
      DiracDualFormNativePointwiseJointResidualCoordinates where
  toFun residual :=
    ((residual.gravityMultiplier,
        residual.gravityAuxiliary,
        residual.p286GaugeAuxiliary),
      residual.lorentzConnection,
      residual.p286GaugeConnection,
      residual.scalar,
      residual.matter,
      residual.conjugateMatter,
      residual.coframe)
  invFun coordinates :=
    { gravityMultiplier := coordinates.1.1
      gravityAuxiliary := coordinates.1.2.1
      p286GaugeAuxiliary := coordinates.1.2.2
      lorentzConnection := coordinates.2.1
      p286GaugeConnection := coordinates.2.2.1
      scalar := coordinates.2.2.2.1
      matter := coordinates.2.2.2.2.1
      conjugateMatter := coordinates.2.2.2.2.2.1
      coframe := coordinates.2.2.2.2.2.2 }
  left_inv residual := by
    cases residual
    rfl
  right_inv coordinates := by
    rcases coordinates with
      ⟨⟨gravityMultiplier, gravityAuxiliary, p286GaugeAuxiliary⟩,
        lorentzConnection, p286GaugeConnection, scalar, matter,
        conjugateMatter, coframe⟩
    rfl

instance : Zero DiracDualFormNativePointwiseJointResidualCarrier where
  zero :=
    { gravityMultiplier := 0
      gravityAuxiliary := 0
      p286GaugeAuxiliary := 0
      lorentzConnection := 0
      p286GaugeConnection := 0
      scalar := 0
      matter := 0
      conjugateMatter := 0
      coframe := 0 }

/-- The whole residual is one additive carrier.  This instance lets the
five action legs be telescoped without splitting the final read into nine
independent repair epochs. -/
instance : AddCommGroup DiracDualFormNativePointwiseJointResidualCarrier :=
  diracDualFormNativePointwiseJointResidualCoordinateEquiv.addCommGroup

@[simp] theorem zero_gravityMultiplier :
    (0 : DiracDualFormNativePointwiseJointResidualCarrier).gravityMultiplier =
      0 :=
  rfl

@[simp] theorem zero_gravityAuxiliary :
    (0 : DiracDualFormNativePointwiseJointResidualCarrier).gravityAuxiliary =
      0 :=
  rfl

@[simp] theorem zero_p286GaugeAuxiliary :
    (0 : DiracDualFormNativePointwiseJointResidualCarrier).p286GaugeAuxiliary =
      0 :=
  rfl

@[simp] theorem zero_lorentzConnection :
    (0 : DiracDualFormNativePointwiseJointResidualCarrier).lorentzConnection =
      0 :=
  rfl

@[simp] theorem zero_p286GaugeConnection :
    (0 : DiracDualFormNativePointwiseJointResidualCarrier).p286GaugeConnection =
      0 :=
  rfl

@[simp] theorem zero_scalar :
    (0 : DiracDualFormNativePointwiseJointResidualCarrier).scalar = 0 :=
  rfl

@[simp] theorem zero_matter :
    (0 : DiracDualFormNativePointwiseJointResidualCarrier).matter = 0 :=
  rfl

@[simp] theorem zero_conjugateMatter :
    (0 : DiracDualFormNativePointwiseJointResidualCarrier).conjugateMatter =
      0 :=
  rfl

@[simp] theorem zero_coframe :
    (0 : DiracDualFormNativePointwiseJointResidualCarrier).coframe = 0 :=
  rfl

@[ext] theorem DiracDualFormNativePointwiseJointResidualCarrier.ext
    (first second : DiracDualFormNativePointwiseJointResidualCarrier)
    (gravityMultiplier :
      first.gravityMultiplier = second.gravityMultiplier)
    (gravityAuxiliary :
      first.gravityAuxiliary = second.gravityAuxiliary)
    (p286GaugeAuxiliary :
      first.p286GaugeAuxiliary = second.p286GaugeAuxiliary)
    (lorentzConnection :
      first.lorentzConnection = second.lorentzConnection)
    (p286GaugeConnection :
      first.p286GaugeConnection = second.p286GaugeConnection)
    (scalar : first.scalar = second.scalar)
    (matter : first.matter = second.matter)
    (conjugateMatter : first.conjugateMatter = second.conjugateMatter)
    (coframe : first.coframe = second.coframe) :
    first = second := by
  cases first
  cases second
  simp_all

/-- The authoritative repaired-root residual generated by one source,
configuration, and spacetime point. -/
def diracDualFormNativePointwiseJointResidual
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    DiracDualFormNativePointwiseJointResidualCarrier :=
  let field := toContinuumPointField configuration point
  { gravityMultiplier := formNativeGravityMultiplierEulerResidual field
    gravityAuxiliary := formNativeGravityAuxiliaryEulerResidual field
    p286GaugeAuxiliary :=
      formNativeP286GaugeAuxiliaryEulerResidualAtBoundary
        (sourceGeneratedUnifiedCouplings source) field
    lorentzConnection :=
      holonomicFormNativeLorentzEulerThreeForm source 0 configuration point
    p286GaugeConnection :=
      holonomicFormNativeP286GaugeEulerThreeForm source 0 configuration point
    scalar := fun direction =>
      diracDualScalarEulerLagrangeDirectionalCoefficient source configuration
        direction point
    matter := fun direction =>
      diracDualMatterEulerLagrangeDirectionalCoefficient source configuration
        direction point
    conjugateMatter := fun direction =>
      diracDualConjugateMatterDirectionalCoefficient source configuration
        direction point
    coframe := diracDualFormNativeCoframeEulerCovector source point field }

/-- The complete residual section of one source/configuration pair. -/
def diracDualFormNativeJointResidualSection
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration) :
    BasePoint → DiracDualFormNativePointwiseJointResidualCarrier :=
  diracDualFormNativePointwiseJointResidual source configuration

def OnDiracDualFormNativePointwiseJointZeroFiber
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) : Prop :=
  diracDualFormNativePointwiseJointResidual source configuration point = 0

/-- The global zero fiber of the authoritative repaired-root residual. -/
def DiracDualFormNativeJointZeroFiber
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration) : Prop :=
  diracDualFormNativeJointResidualSection source configuration = 0

theorem onDiracDualFormNativePointwiseJointZeroFiber_iff_components
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    OnDiracDualFormNativePointwiseJointZeroFiber source configuration point ↔
      formNativeGravityMultiplierEulerResidual
          (toContinuumPointField configuration point) = 0 ∧
      formNativeGravityAuxiliaryEulerResidual
          (toContinuumPointField configuration point) = 0 ∧
      formNativeP286GaugeAuxiliaryEulerResidualAtBoundary
          (sourceGeneratedUnifiedCouplings source)
          (toContinuumPointField configuration point) = 0 ∧
      holonomicFormNativeLorentzEulerThreeForm source 0 configuration point =
        0 ∧
      holonomicFormNativeP286GaugeEulerThreeForm source 0 configuration point =
        0 ∧
      (fun direction =>
        diracDualScalarEulerLagrangeDirectionalCoefficient source
          configuration direction point) = 0 ∧
      (fun direction =>
        diracDualMatterEulerLagrangeDirectionalCoefficient source
          configuration direction point) = 0 ∧
      (fun direction =>
        diracDualConjugateMatterDirectionalCoefficient source configuration
          direction point) = 0 ∧
      diracDualFormNativeCoframeEulerCovector source point
          (toContinuumPointField configuration point) = 0 := by
  constructor
  · intro jointZero
    exact
      ⟨congrArg
          DiracDualFormNativePointwiseJointResidualCarrier.gravityMultiplier
          jointZero,
        congrArg
          DiracDualFormNativePointwiseJointResidualCarrier.gravityAuxiliary
          jointZero,
        congrArg
          DiracDualFormNativePointwiseJointResidualCarrier.p286GaugeAuxiliary
          jointZero,
        congrArg
          DiracDualFormNativePointwiseJointResidualCarrier.lorentzConnection
          jointZero,
        congrArg
          DiracDualFormNativePointwiseJointResidualCarrier.p286GaugeConnection
          jointZero,
        congrArg DiracDualFormNativePointwiseJointResidualCarrier.scalar
          jointZero,
        congrArg DiracDualFormNativePointwiseJointResidualCarrier.matter
          jointZero,
        congrArg
          DiracDualFormNativePointwiseJointResidualCarrier.conjugateMatter
          jointZero,
        congrArg DiracDualFormNativePointwiseJointResidualCarrier.coframe
          jointZero⟩
  · rintro ⟨gravityMultiplier, gravityAuxiliary, p286GaugeAuxiliary,
      lorentzConnection, p286GaugeConnection, scalar, matter,
      conjugateMatter, coframe⟩
    apply DiracDualFormNativePointwiseJointResidualCarrier.ext
    · simpa [diracDualFormNativePointwiseJointResidual] using
        gravityMultiplier
    · simpa [diracDualFormNativePointwiseJointResidual] using
        gravityAuxiliary
    · simpa [diracDualFormNativePointwiseJointResidual] using
        p286GaugeAuxiliary
    · simpa [diracDualFormNativePointwiseJointResidual] using
        lorentzConnection
    · simpa [diracDualFormNativePointwiseJointResidual] using
        p286GaugeConnection
    · simpa [diracDualFormNativePointwiseJointResidual] using scalar
    · simpa [diracDualFormNativePointwiseJointResidual] using matter
    · simpa [diracDualFormNativePointwiseJointResidual] using
        conjugateMatter
    · simpa [diracDualFormNativePointwiseJointResidual] using coframe

theorem diracDualFormNativeJointZeroFiber_iff_pointwise
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration) :
    DiracDualFormNativeJointZeroFiber source configuration ↔
      ∀ point,
        OnDiracDualFormNativePointwiseJointZeroFiber source configuration
          point := by
  constructor
  · intro sectionZero point
    exact congrFun sectionZero point
  · intro pointwiseZero
    funext point
    exact pointwiseZero point

end

end
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeJointResidualCarrier
