/-! ## Exact coordinate seams -/

/-- The dependency-light acceptance coordinate is exactly the actual Cartan
torsion of the primitive coframe first jet and gravity connection. -/
theorem cartanTorsionCoordinate_eq_pointwiseCartanTorsion
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint)
    (first second internal : LorentzianIndex) :
    cartanTorsionCoordinate configuration point first second internal =
      pointwiseCartanTorsion
        (holonomicCoframeFirstJetAt configuration.coframe point)
        (configuration.gravityConnection point) first second internal := by
  unfold cartanTorsionCoordinate pointwiseCartanTorsion
    pointwiseCoframeCovariantDerivative coframeConnectionAction
    holonomicCoframeFirstJetAt fieldDirectionalDerivative
  ring

/-- The acceptance matter-spin coefficient is the exact pointwise matter
coefficient generated by the form-native action.  The old identifier does
not introduce a second current or normalization. -/
theorem
    lorentzMatterSpinSourceCoefficient_eq_formNativeLorentzMatterFirstCoefficient
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (direction : LorentzBivectorOneForm) (point : BasePoint) :
    lorentzMatterSpinSourceCoefficient source configuration direction point =
      formNativeLorentzMatterFirstCoefficient source 0 point
        (toContinuumPointField configuration point) direction := by
  unfold lorentzMatterSpinSourceCoefficient
    formNativeLorentzMatterFirstCoefficient
    matterGaugeConnectionFirstVariationDensity
    matterCovariantDerivativeFirstVariationDensity
    matterGaugeConnectionVariationVector
    matterCovariantDerivativeVariationVector
    matterGaugeKineticSum matterCovariantDerivativeKineticSum
    holonomicMatterLorentzConnectionVariation
    pointwiseMatterLorentzConnectionVariation
  rfl

/-- Computing `B := II+(e)` changes no field consumed by the matter-spin
functional. -/
theorem formNativeLorentzMatterFirstCoefficient_restrictToIIPlus
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) (direction : LorentzBivectorOneForm) :
    formNativeLorentzMatterFirstCoefficient source 0 point
        (toContinuumPointField
          (restrictHolonomicConfigurationToIIPlus configuration) point)
        direction =
      formNativeLorentzMatterFirstCoefficient source 0 point
        (toContinuumPointField configuration point) direction := by
  unfold formNativeLorentzMatterFirstCoefficient
    matterCovariantDerivativeFirstVariationDensity
    matterCovariantDerivativeVariationVector
    matterCovariantDerivativeKineticSum
    pointwiseMatterLorentzConnectionVariation
    restrictHolonomicConfigurationToIIPlus toContinuumPointField
  rfl

@[simp] theorem torsionCoframeWedgeThreeForm_zero
    (coframe : LorentzianCoframe) :
    torsionCoframeWedgeThreeForm coframe 0 = 0 := by
  funext internalPair triple
  simp [torsionCoframeWedgeThreeForm]

@[simp] theorem internalBivectorDualThreeForm_zero :
    internalBivectorDualThreeForm 0 = 0 := by
  funext internalPair triple
  fin_cases internalPair <;>
    simp [internalBivectorDualThreeForm, lorentzianCoframeHodge]

/-! ## Acceptance consequence -/

/-- A computed-`II+` torsion--spin equation faithfully transports nonzero
matter spin into a nonzero Cartan torsion coordinate on the same actual. -/
theorem formNativeIIPlusTorsionSpinEquation_implies_spinTorsionCompatible
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (torsionSpinEquation :
      FormNativeIIPlusTorsionSpinEquation source configuration) :
    SpinTorsionCompatible source configuration := by
  intro point matterSpinNonzero
  rcases matterSpinNonzero with ⟨direction, coefficientNonzero⟩
  have actionCoefficientNonzero :
      formNativeLorentzMatterFirstCoefficient source 0 point
          (toContinuumPointField
            (restrictHolonomicConfigurationToIIPlus configuration) point)
          direction ≠ 0 := by
    rw [formNativeLorentzMatterFirstCoefficient_restrictToIIPlus]
    rw [←
      lorentzMatterSpinSourceCoefficient_eq_formNativeLorentzMatterFirstCoefficient]
    exact coefficientNonzero
  by_contra noTorsionCoordinate
  have everyTorsionCoordinateZero :
      ∀ first second internal : LorentzianIndex,
        cartanTorsionCoordinate configuration point first second internal =
          0 := by
    intro first second internal
    by_contra coordinateNonzero
    exact noTorsionCoordinate
      ⟨first, second, internal, coordinateNonzero⟩
  have pointwiseTorsionZero :
      pointwiseCartanTorsion
          (holonomicCoframeFirstJetAt configuration.coframe point)
          (configuration.gravityConnection point) = 0 := by
    funext first second internal
    rw [← cartanTorsionCoordinate_eq_pointwiseCartanTorsion]
    exact everyTorsionCoordinateZero first second internal
  have geometricTorsionZero :
      internalBivectorDualThreeForm
          (torsionCoframeWedgeThreeForm (configuration.coframe point)
            (pointwiseCartanTorsion
              (holonomicCoframeFirstJetAt configuration.coframe point)
              (configuration.gravityConnection point))) = 0 := by
    rw [pointwiseTorsionZero]
    simp
  have physicalSpinCurrentZero :
      formNativePhysicalSpinCurrentThreeForm source 0 point
          (toContinuumPointField
            (restrictHolonomicConfigurationToIIPlus configuration) point) =
        0 := by
    rw [← torsionSpinEquation point]
    exact geometricTorsionZero
  have matterSpinThreeFormZero :
      formNativeMatterSpinThreeForm source 0 point
          (toContinuumPointField
            (restrictHolonomicConfigurationToIIPlus configuration) point) =
        0 := by
    simpa [formNativePhysicalSpinCurrentThreeForm] using
      physicalSpinCurrentZero
  have everyActionCoefficientZero :=
    (formNativeMatterSpinThreeForm_eq_zero_iff_all source 0 point
      (toContinuumPointField
        (restrictHolonomicConfigurationToIIPlus configuration) point)).mp
      matterSpinThreeFormZero
  exact actionCoefficientNonzero (everyActionCoefficientZero direction)

/-- The single repaired-root joint residual already contains both the
simplicity and Lorentz equations needed for spin--torsion compatibility.
No density-integrability or integrated-stationarity receipt is required. -/
theorem diracDualFormNativeJointZeroFiber_implies_spinTorsionCompatible
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (admissible : GravityConnectionLorentzAdmissible configuration)
    (jointZeroFiber :
      DiracDualFormNativeJointZeroFiber source configuration) :
    SpinTorsionCompatible source configuration := by
  have pointwiseZero :
      ∀ point,
        OnDiracDualFormNativePointwiseJointZeroFiber source configuration
          point :=
    (diracDualFormNativeJointZeroFiber_iff_pointwise source configuration).1
      jointZeroFiber
  have simplicity : FormNativeGravitySimplicityEquation configuration := by
    intro point
    have gravityZero :
        (diracDualFormNativePointwiseJointResidual source configuration point
          ).gravityMultiplier = 0 := by
      simpa using congrArg
        DiracDualFormNativePointwiseJointResidualCarrier.gravityMultiplier
        (pointwiseZero point)
    change formNativeGravityMultiplierEulerResidual
        (toContinuumPointField configuration point) = 0 at gravityZero
    exact
      (formNativeGravityMultiplierEulerResidual_eq_zero_iff_simplicity
        (toContinuumPointField configuration point)).1 gravityZero
  have lorentzResidualZero :
      holonomicFormNativeLorentzEulerThreeForm source 0 configuration = 0 := by
    funext point
    have lorentzZero :
        (diracDualFormNativePointwiseJointResidual source configuration point
          ).lorentzConnection = 0 := by
      simpa using congrArg
        DiracDualFormNativePointwiseJointResidualCarrier.lorentzConnection
        (pointwiseZero point)
    exact lorentzZero
  have pointwiseEquation :
      FormNativeLorentzConnectionPointwiseEquation source configuration :=
    (holonomicFormNativeLorentzEulerThreeForm_eq_zero_iff_pointwiseEquation
      source configuration).1 lorentzResidualZero
  have fixedPoint :
      restrictHolonomicConfigurationToIIPlus configuration = configuration :=
    (restrictHolonomicConfigurationToIIPlus_eq_self_iff_diracDualFormNativeSimplicity
      configuration).2 simplicity
  have restrictedPointwiseEquation :
      FormNativeLorentzConnectionPointwiseEquation source
        (restrictHolonomicConfigurationToIIPlus configuration) := by
    rw [fixedPoint]
    exact pointwiseEquation
  have torsionSpinEquation :
      FormNativeIIPlusTorsionSpinEquation source configuration :=
    (formNativeLorentzConnectionPointwiseEquation_restrictToIIPlus_iff_torsionSpinEquation
      source configuration smooth admissible).1 restrictedPointwiseEquation
  exact formNativeIIPlusTorsionSpinEquation_implies_spinTorsionCompatible
    source configuration torsionSpinEquation

/-- Spin--torsion compatibility is a dependent elimination theorem of the
current S9-C key, not an independently supplied constructor tooth. -/
theorem ClassicalWorldAcceptance.spinTorsionCompatible
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (acceptance : ClassicalWorldAcceptance source current) :
    SpinTorsionCompatible source current :=
  diracDualFormNativeJointZeroFiber_implies_spinTorsionCompatible source
    current acceptance.smooth acceptance.gravityConnectionLorentzAdmissible
    acceptance.jointZeroFiber

/-- Repaired-root stationarity supplies the torsion-compatibility readout
through the generated equation; it does not store a separate acceptance
tooth. -/
theorem
    diracDualFormNativeLorentzConnectionActionStationary_restrictToIIPlus_implies_spinTorsionCompatible
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (admissible : GravityConnectionLorentzAdmissible configuration)
    (nondegenerate : configuration.Nondegenerate)
    (densityIntegrable :
      DiracDualFormNativeHolonomicLocalDensityIntegrable source 0
        (restrictHolonomicConfigurationToIIPlus configuration))
    (stationary :
      DiracDualFormNativeLorentzConnectionActionStationary source
        (restrictHolonomicConfigurationToIIPlus configuration)) :
    SpinTorsionCompatible source configuration :=
  formNativeIIPlusTorsionSpinEquation_implies_spinTorsionCompatible source
    configuration
      ((diracDualFormNativeLorentzConnectionActionStationary_restrictToIIPlus_iff_torsionSpinEquation
        source configuration smooth admissible nondegenerate
        densityIntegrable).mp stationary)

end

end
