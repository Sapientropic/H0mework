/-- Pure canonical-momentum increment induced by the action-owned scalar
quadratic writer.  It is read from the writer and the unchanged coframe; it is
not a residual coordinate or a supplied correction. -/
def scalarQuadraticMomentumIncrement
    (space : StageNineSpatialPoint)
    (acceleration direction : ScalarCoordinateCarrier)
    (derivativeDirection : LorentzianIndex)
    (point : BasePoint) : ℝ :=
  let current := recenteredCartanRepairedConstitutiveCurrent space
  let variation :=
    scalarVariationDifferentialDirection direction derivativeDirection
  let increment :=
    scalarQuadraticCovariantIncrement current acceleration
  generatedVolumeDensity (toContinuumPointField current point) *
    ((1 / 2 : ℝ) *
      ∑ first : LorentzianIndex,
        ∑ second : LorentzianIndex,
          ((lorentzianMetricOfCoframe (current.coframe point))⁻¹
              first second) *
            (scalarCoordinatePairingRe
                (variation first) (increment point second) +
              scalarCoordinatePairingRe
                (increment point first) (variation second)))

theorem
    scalarDifferentialMomentum_recenteredCartanRepairedScalarSecondJetActual
    (space : StageNineSpatialPoint)
    (direction : ScalarCoordinateCarrier)
    (derivativeDirection : LorentzianIndex) :
    scalarDifferentialMomentum positiveSmoothUnifiedSource
        (recenteredCartanRepairedScalarSecondJetActual space) direction
        derivativeDirection =
      scalarDifferentialMomentum positiveSmoothUnifiedSource
          (recenteredCartanRepairedConstitutiveCurrent space) direction
          derivativeDirection +
        scalarQuadraticMomentumIncrement space
          (recenteredContactDiracDualScalarAcceleration space) direction
          derivativeDirection := by
  funext point
  unfold recenteredCartanRepairedScalarSecondJetActual
    scalarDifferentialMomentum
    scalarGaugeConnectionKineticFirstVariationDensity
    scalarFrameRelativeCovariantDerivative
    scalarQuadraticMomentumIncrement generatedVolumeDensity
  simp only [toContinuumPointField,
    scalarFrameRelativeCoordinates_zeroChart]
  rw [installScalarQuadraticTimeCorrection_coframe]
  have covariantEquality :
      holonomicScalarCovariantDerivative
          (installScalarQuadraticTimeCorrection
            (recenteredCartanRepairedConstitutiveCurrent space)
            (recenteredContactDiracDualScalarAcceleration space)) point =
        holonomicScalarCovariantDerivative
            (recenteredCartanRepairedConstitutiveCurrent space) point +
          scalarQuadraticCovariantIncrement
            (recenteredCartanRepairedConstitutiveCurrent space)
            (recenteredContactDiracDualScalarAcceleration space) point := by
    exact
      holonomicScalarCovariantDerivative_recenteredCartanRepairedScalarSecondJetActual
        space point
  rw [covariantEquality]
  simp only [Pi.add_apply, scalarCoordinatePairingRe_add_left,
    scalarCoordinatePairingRe_add_right]
  let volume :=
    |Matrix.det
      ((recenteredCartanRepairedConstitutiveCurrent space).coframe point)|
  let weight := fun first second : LorentzianIndex =>
    (lorentzianMetricOfCoframe
      ((recenteredCartanRepairedConstitutiveCurrent space).coframe point))⁻¹
        first second
  let firstLeft := fun first second : LorentzianIndex =>
    scalarCoordinatePairingRe
      (scalarVariationDifferentialDirection direction derivativeDirection first)
      (holonomicScalarCovariantDerivative
        (recenteredCartanRepairedConstitutiveCurrent space) point second)
  let firstRight := fun first second : LorentzianIndex =>
    scalarCoordinatePairingRe
      (holonomicScalarCovariantDerivative
        (recenteredCartanRepairedConstitutiveCurrent space) point first)
      (scalarVariationDifferentialDirection direction derivativeDirection second)
