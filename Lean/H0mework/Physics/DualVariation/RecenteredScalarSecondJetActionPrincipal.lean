theorem scalarQuadraticMomentumIncrement_diagonalDerivative_origin
    (space : StageNineSpatialPoint)
    (acceleration direction : ScalarCoordinateCarrier)
    (derivativeDirection : LorentzianIndex) :
    fieldDirectionalDerivative
        (scalarQuadraticMomentumIncrement space acceleration direction
          derivativeDirection)
        0 derivativeDirection =
      if derivativeDirection = canonicalLorentzianTimeDirection then
