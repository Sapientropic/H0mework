theorem scalarQuadraticTimeCorrection_directionalDerivative
    (acceleration : ScalarCoordinateCarrier)
    (point : BasePoint)
    (direction : LorentzianIndex) :
    fieldDirectionalDerivative
        (scalarQuadraticTimeCorrection acceleration) point direction =
      if direction = canonicalLorentzianTimeDirection then
        point canonicalLorentzianTimeDirection • acceleration
      else 0 := by
  have derivative :=
    (scalarQuadraticTimeCoefficient_hasFDerivAt point).smul_const acceleration
  unfold fieldDirectionalDerivative scalarQuadraticTimeCorrection
  rw [derivative.fderiv]
  fin_cases direction
  · simp [coordinateDirection, canonicalLorentzianTimeDirection]
    ring_nf
  · simp [coordinateDirection, canonicalLorentzianTimeDirection]
  · simp [coordinateDirection, canonicalLorentzianTimeDirection]
  · simp [coordinateDirection, canonicalLorentzianTimeDirection]

theorem scalarQuadraticTimeCorrection_diagonalSecondDerivative_origin
    (acceleration : ScalarCoordinateCarrier)
    (direction : LorentzianIndex) :
    fieldDirectionalDerivative
        (fun point =>
          fieldDirectionalDerivative
            (scalarQuadraticTimeCorrection acceleration) point direction)
        0 direction =
      if direction = canonicalLorentzianTimeDirection then acceleration else 0 := by
  by_cases temporal : direction = canonicalLorentzianTimeDirection
  · subst direction
    simpa using
      scalarQuadraticTimeCorrection_secondTimeDerivative_origin acceleration
  · rw [show
      (fun point =>
        fieldDirectionalDerivative
          (scalarQuadraticTimeCorrection acceleration) point direction) =
        fun _ : BasePoint => 0 by
      funext point
      rw [scalarQuadraticTimeCorrection_directionalDerivative]
      simp [temporal]]
    simp [fieldDirectionalDerivative, temporal]

/-- Pure scalar-covariant increment caused by the quadratic writer. -/
def scalarQuadraticCovariantIncrement
    (current : StageNineHolonomicConfiguration)
    (acceleration : ScalarCoordinateCarrier)
    (point : BasePoint)
    (formDirection : LorentzianIndex) : ScalarCoordinateCarrier :=
  fieldDirectionalDerivative
      (scalarQuadraticTimeCorrection acceleration) point formDirection +
    scalarMotherLieAction
      (p286LieBlockEmbed (current.gaugeConnection point formDirection))
      (scalarQuadraticTimeCorrection acceleration point)

