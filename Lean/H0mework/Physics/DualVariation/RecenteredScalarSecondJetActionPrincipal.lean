      leftPairingDifferentiable rightPairingDifferentiable derivativeDirection,
      scalarPairingLeft_directionalDerivative_local _
        incrementSecondDifferentiable _ derivativeDirection,
      scalarPairingRight_directionalDerivative_local _
        incrementFirstDifferentiable _ derivativeDirection]
  have weightedTermSmooth (first second : LorentzianIndex) :
      ContDiffAt ℝ ∞ (weightedTerm first second) 0 := by
    exact (metricEntrySmooth first second).mul
      (pairingTermSmooth first second).contDiffAt
  have weightedTermDerivative (first second : LorentzianIndex) :
