  have doubleSumOrigin : doubleSum 0 = 0 := by
    simp [doubleSum, weightedTerm, pairingTermOrigin]
  have doubleSumDerivativeFormula :
      fieldDirectionalDerivative doubleSum 0 derivativeDirection =
