private theorem scalarQuadraticCovariantIncrement_contDiff
    (space : StageNineSpatialPoint)
    (acceleration : ScalarCoordinateCarrier)
    (formDirection : LorentzianIndex) :
    ContDiff ℝ ∞ fun point =>
      scalarQuadraticCovariantIncrement
        (recenteredCartanRepairedConstitutiveCurrent space)
        acceleration point formDirection := by
  have differentialSmooth : ContDiff ℝ ∞ fun point =>
      fieldDirectionalDerivative
        (scalarQuadraticTimeCorrection acceleration) point formDirection := by
    rw [show
      (fun point =>
        fieldDirectionalDerivative
          (scalarQuadraticTimeCorrection acceleration) point formDirection) =
        if formDirection = canonicalLorentzianTimeDirection then
          fun point =>
            point canonicalLorentzianTimeDirection • acceleration
        else fun _ : BasePoint => 0 by
      funext point
      rw [scalarQuadraticTimeCorrection_directionalDerivative]
      split <;> rfl]
    split
    · fun_prop
    · exact contDiff_const
  have gaugeSmooth :=
    recenteredCartanRepairedConstitutiveCurrent_gaugeCoordinate_contDiff
      space formDirection
  have actionOuterSmooth : ContDiff ℝ ∞ fun point =>
      scalarP286ActionBilinear.toContinuousBilinearMap
        (p286CoordinateEquiv
          ((recenteredCartanRepairedConstitutiveCurrent space
            ).gaugeConnection point formDirection)) :=
    contDiff_const.clm_apply gaugeSmooth
  have actionSmooth : ContDiff ℝ ∞ fun point =>
      scalarMotherLieAction
        (p286LieBlockEmbed
          ((recenteredCartanRepairedConstitutiveCurrent space
            ).gaugeConnection point formDirection))
        (scalarQuadraticTimeCorrection acceleration point) := by
    have actual :=
      actionOuterSmooth.clm_apply
        (scalarQuadraticTimeCorrection_contDiff acceleration)
    rw [show
      (fun point =>
        scalarMotherLieAction
          (p286LieBlockEmbed
            ((recenteredCartanRepairedConstitutiveCurrent space
              ).gaugeConnection point formDirection))
          (scalarQuadraticTimeCorrection acceleration point)) =
        fun point =>
          scalarP286ActionBilinear.toContinuousBilinearMap
            (p286CoordinateEquiv
              ((recenteredCartanRepairedConstitutiveCurrent space
                ).gaugeConnection point formDirection))
            (scalarQuadraticTimeCorrection acceleration point) by
      funext point
      change
        scalarMotherLieAction
          (p286LieBlockEmbed
            ((recenteredCartanRepairedConstitutiveCurrent space
              ).gaugeConnection point formDirection))
          (scalarQuadraticTimeCorrection acceleration point) =
        scalarMotherLieAction
          (p286LieBlockEmbed
            (p286CoordinateEquiv.symm
              (p286CoordinateEquiv
                ((recenteredCartanRepairedConstitutiveCurrent space
                  ).gaugeConnection point formDirection))))
          (scalarQuadraticTimeCorrection acceleration point)
      rw [p286CoordinateEquiv.symm_apply_apply]]
    exact actual
  unfold scalarQuadraticCovariantIncrement
  exact differentialSmooth.add actionSmooth

theorem scalarQuadraticCovariantIncrement_diagonalDerivative_origin
    (space : StageNineSpatialPoint)
    (acceleration : ScalarCoordinateCarrier)
    (direction : LorentzianIndex) :
    fieldDirectionalDerivative
        (fun point =>
          scalarQuadraticCovariantIncrement
            (recenteredCartanRepairedConstitutiveCurrent space)
            acceleration point direction)
        0 direction =
      if direction = canonicalLorentzianTimeDirection then acceleration else 0 := by
  let gaugeCoordinate := fun point =>
    p286CoordinateEquiv
      ((recenteredCartanRepairedConstitutiveCurrent space).gaugeConnection
        point direction)
  let correction := scalarQuadraticTimeCorrection acceleration
  let action := fun point =>
    scalarMotherLieAction
      (p286LieBlockEmbed
        ((recenteredCartanRepairedConstitutiveCurrent space).gaugeConnection
          point direction))
      (correction point)
  have gaugeSmooth : ContDiff ℝ ∞ gaugeCoordinate :=
    recenteredCartanRepairedConstitutiveCurrent_gaugeCoordinate_contDiff
      space direction
  have correctionSmooth : ContDiff ℝ ∞ correction :=
    scalarQuadraticTimeCorrection_contDiff acceleration
  have actionEquality : action = fun point =>
      scalarP286ActionBilinear.toContinuousBilinearMap
        (gaugeCoordinate point) (correction point) := by
    funext point
    change
      scalarMotherLieAction
          (p286LieBlockEmbed
            ((recenteredCartanRepairedConstitutiveCurrent space
              ).gaugeConnection point direction))
          (correction point) =
        scalarMotherLieAction
          (p286LieBlockEmbed
            (p286CoordinateEquiv.symm
              (p286CoordinateEquiv
                ((recenteredCartanRepairedConstitutiveCurrent space
                  ).gaugeConnection point direction))))
          (correction point)
    rw [p286CoordinateEquiv.symm_apply_apply]
  have actionDerivativeZero :
      fieldDirectionalDerivative action 0 direction = 0 := by
    rw [actionEquality,
      fieldDirectionalDerivative_continuousBilinear
        scalarP286ActionBilinear.toContinuousBilinearMap
        gaugeCoordinate correction gaugeSmooth correctionSmooth 0 direction]
    have correctionOrigin : correction 0 = 0 := by
      simp [correction]
    have correctionDerivative :
        fieldDirectionalDerivative correction 0 direction = 0 := by
      exact scalarQuadraticTimeCorrection_firstDerivative_origin
        acceleration direction
    rw [correctionOrigin, correctionDerivative]
    simp
  have differentialSmooth : ContDiff ℝ ∞ fun point =>
      fieldDirectionalDerivative correction point direction := by
    rw [show
      (fun point => fieldDirectionalDerivative correction point direction) =
        if direction = canonicalLorentzianTimeDirection then
          fun point => point canonicalLorentzianTimeDirection • acceleration
        else fun _ : BasePoint => 0 by
      funext point
      change
        fieldDirectionalDerivative
            (scalarQuadraticTimeCorrection acceleration) point direction = _
      rw [scalarQuadraticTimeCorrection_directionalDerivative]
      split <;> rfl]
    split
    · fun_prop
    · exact contDiff_const
  have actionSmooth : ContDiff ℝ ∞ action := by
    rw [actionEquality]
    exact
      (contDiff_const.clm_apply gaugeSmooth).clm_apply correctionSmooth
  unfold scalarQuadraticCovariantIncrement
  change
    fieldDirectionalDerivative
      (fun point =>
        fieldDirectionalDerivative correction point direction + action point)
      0 direction = _
  rw [fieldDirectionalDerivative_add_scalar_local
    (fun point => fieldDirectionalDerivative correction point direction)
    action differentialSmooth actionSmooth 0 direction]
  rw [show
    fieldDirectionalDerivative
        (fun point => fieldDirectionalDerivative correction point direction)
        0 direction =
      if direction = canonicalLorentzianTimeDirection then acceleration else 0 by
    exact scalarQuadraticTimeCorrection_diagonalSecondDerivative_origin
      acceleration direction,
    actionDerivativeZero, add_zero]

theorem
    holonomicScalarCovariantDerivative_recenteredCartanRepairedScalarSecondJetActual
    (space : StageNineSpatialPoint)
    (point : BasePoint) :
    holonomicScalarCovariantDerivative
        (recenteredCartanRepairedScalarSecondJetActual space) point =
      holonomicScalarCovariantDerivative
          (recenteredCartanRepairedConstitutiveCurrent space) point +
        scalarQuadraticCovariantIncrement
          (recenteredCartanRepairedConstitutiveCurrent space)
          (recenteredContactDiracDualScalarAcceleration space) point := by
  funext formDirection
  unfold recenteredCartanRepairedScalarSecondJetActual
    holonomicScalarCovariantDerivative
    scalarQuadraticCovariantIncrement
  rw [installScalarQuadraticTimeCorrection_gaugeConnection]
  change
    fieldDirectionalDerivative
        ((recenteredCartanRepairedConstitutiveCurrent space).scalar +
          scalarQuadraticTimeCorrection
            (recenteredContactDiracDualScalarAcceleration space))
        point formDirection + _ = _
  have currentDifferentiable : DifferentiableAt ℝ
      (recenteredCartanRepairedConstitutiveCurrent space).scalar point := by
    rw [recenteredCartanRepairedConstitutiveCurrent_scalar]
    change DifferentiableAt ℝ
      ((spatiallyRecenterHolonomicConfiguration
        FixedP506FormNativeJointActionSolvedSuccessor space).scalar) point
    exact
      ((spatiallyRecenterHolonomicConfiguration_smooth
        FixedP506FormNativeJointActionSolvedSuccessor
        fixedP506FormNativeJointActionSolvedSuccessor_smooth space
        ).2.2.2.2.2.2.1.differentiable (by simp)).differentiableAt
  have correctionDifferentiable : DifferentiableAt ℝ
      (scalarQuadraticTimeCorrection
        (recenteredContactDiracDualScalarAcceleration space)) point := by
    exact
      ((scalarQuadraticTimeCoefficient_hasFDerivAt point).smul_const
        (recenteredContactDiracDualScalarAcceleration space)).differentiableAt
  unfold fieldDirectionalDerivative
  rw [fderiv_add currentDifferentiable correctionDifferentiable, add_apply]
  rw [show
    (installScalarQuadraticTimeCorrection
      (recenteredCartanRepairedConstitutiveCurrent space)
      (recenteredContactDiracDualScalarAcceleration space)).scalar point =
        (recenteredCartanRepairedConstitutiveCurrent space).scalar point +
          scalarQuadraticTimeCorrection
            (recenteredContactDiracDualScalarAcceleration space) point by
    rfl]
  rw [scalarMotherLieAction_add_right]
  simp only [Pi.add_apply]
  module

