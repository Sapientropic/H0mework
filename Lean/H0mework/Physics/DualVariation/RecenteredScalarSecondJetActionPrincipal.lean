      simp [variation, scalarVariationDifferentialDirection,
        minkowskiInternalMetric, Fin.sum_univ_four,
        canonicalLorentzianTimeDirection, diagonal,
        scalarCoordinatePairingRe_zero_left_local,
        scalarCoordinatePairingRe_zero_right_local]
    · have diagonal :
          fieldDirectionalDerivative (fun point => increment point 2) 0 2 =
            0 := by
        simpa [canonicalLorentzianTimeDirection] using
          incrementDiagonalDerivative
      simp [variation, scalarVariationDifferentialDirection,
        minkowskiInternalMetric, Fin.sum_univ_four,
        canonicalLorentzianTimeDirection, diagonal,
        scalarCoordinatePairingRe_zero_left_local,
        scalarCoordinatePairingRe_zero_right_local]
    · have diagonal :
          fieldDirectionalDerivative (fun point => increment point 3) 0 3 =
