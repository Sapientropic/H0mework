        (weightedTermSmooth first second).differentiableAt (by simp))
      derivativeDirection]
    apply Finset.sum_congr rfl
    intro second _
    exact weightedTermDerivative first second
  have metricOrigin :
      (fun first second => metric 0 first second) =
        minkowskiInternalMetric := by
    funext first second
    unfold metric
    rw [coframeOrigin,
      StageNinePositiveSourceNativeGravityCurvatureBridge.lorentzianMetricOfCoframe_one_inv]
  have incrementDiagonalDerivative :
      fieldDirectionalDerivative
