    simp_rw [metricOrigin]
    fin_cases derivativeDirection
    · have diagonal :
          fieldDirectionalDerivative (fun point => increment point 0) 0 0 =
            acceleration := by
        simpa [canonicalLorentzianTimeDirection] using
          incrementDiagonalDerivative
      have pairingSymmetry :
          scalarCoordinatePairingRe acceleration direction =
            scalarCoordinatePairingRe direction acceleration :=
        scalarCoordinatePairingRe_comm_local acceleration direction
      simp [variation, scalarVariationDifferentialDirection,
        minkowskiInternalMetric, Fin.sum_univ_four,
        canonicalLorentzianTimeDirection, diagonal, pairingSymmetry,
