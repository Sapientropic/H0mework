import H0mework.Physics.Lorentz.LorentzConnectionVariation
import H0mework.Physics.Exterior.GravityAuxiliaryVariation
import H0mework.Physics.GaugeAction.P286GaugeConnectionActionVariation

/-!
# S9-C3b1: local action variation of the primitive Lorentz connection

The admissible Lorentz-skew primitive variation from C3b0 is substituted into
the one common Stage-9 local density.  A readout helper exposes only the
gravity-curvature and Dirac covariant-derivative jets already generated by
that primitive variation; it is not a new action mouth.

The gravity BF term is linear in curvature, while the Dirac density is affine
in its covariant derivative.  Lean therefore proves the exact local
quadratic polynomial whose first coefficient contains both the gravity BF
connection channel and the actual exterior-Dirac spin-current channel.  No
current, action derivative, stationarity, or equation certificate is supplied.
-/

namespace SaturationMonoid.PhysicsCore.StageNineLorentzConnectionActionVariation

open ProofFreeRicherAnholonomicSource
open StageNineEnrichedProofFreeSource
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineCompactSupportIntegrationByParts
open StageNineGravityAuxiliaryVariation
open StageNineP286GaugeAuxiliaryVariation
open StageNineP286GaugeConnectionActionVariation
open StageNineLorentzConnectionVariation
open DiracExteriorMatterAction

noncomputable section

set_option maxHeartbeats 600000

/-- Readout helper for the two jets generated by one primitive Lorentz
connection variation.  It is not accepted by the holonomic action mouth. -/
def withLorentzConnectionJets
    (field : StageNineContinuumPointField)
    (gravityCurvature : PhysicalBivector)
    (matterDerivative : LorentzianIndex → DiracExteriorMatterCarrier) :
    StageNineContinuumPointField :=
  { field with
    gravityCurvature := gravityCurvature
    matterCovariantDerivative := matterDerivative }

@[simp] theorem withLorentzConnectionJets_coframe
    (field : StageNineContinuumPointField)
    (gravityCurvature : PhysicalBivector)
    (matterDerivative : LorentzianIndex → DiracExteriorMatterCarrier) :
    (withLorentzConnectionJets field gravityCurvature matterDerivative).coframe =
      field.coframe :=
  rfl

@[simp] theorem withLorentzConnectionJets_volume
    (field : StageNineContinuumPointField)
    (gravityCurvature : PhysicalBivector)
    (matterDerivative : LorentzianIndex → DiracExteriorMatterCarrier) :
    generatedVolumeDensity
        (withLorentzConnectionJets field gravityCurvature matterDerivative) =
      generatedVolumeDensity field :=
  rfl

def variedLorentzCurvature
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → LorentzBivectorOneForm) (parameter : ℝ)
    (point : BasePoint) : PhysicalBivector :=
  holonomicGravityCurvature configuration point +
    parameter •
      lorentzConnectionLinearCurvatureVariation configuration variation point +
    parameter ^ 2 •
      lorentzConnectionQuadraticCurvatureVariation variation point

def variedLorentzMatterCovariantDerivative
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → LorentzBivectorOneForm) (parameter : ℝ)
    (point : BasePoint) :
    LorentzianIndex → DiracExteriorMatterCarrier :=
  holonomicMatterCovariantDerivative configuration point +
    parameter •
      holonomicMatterLorentzConnectionVariation configuration variation point

theorem toContinuumPointField_varyLorentzConnection
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (variation : CompactlySupportedSmoothVariation LorentzBivectorOneForm)
    (parameter : ℝ) (point : BasePoint) :
    toContinuumPointField
        (varyLorentzConnection configuration variation parameter) point =
      withLorentzConnectionJets (toContinuumPointField configuration point)
        (variedLorentzCurvature configuration variation parameter point)
        (variedLorentzMatterCovariantDerivative configuration variation
          parameter point) := by
  apply StageNineContinuumPointField.ext
  all_goals try rfl
  · exact holonomicGravityCurvature_varyLorentzConnection
      configuration smooth variation parameter point
  · funext formDirection
    exact holonomicMatterCovariantDerivative_lorentzConnection_expansion
      configuration variation parameter point formDirection

def gravityBFCurvatureIncrementDensity
    (coframe : LorentzianCoframe)
    (auxiliary variation : PhysicalBivector) : ℝ :=
  gravityCoframePairing coframe auxiliary
    (gravitySpacetimeHodge coframe variation)

theorem generatedGravityBFDensity_curvature_add_smul
    (field : StageNineContinuumPointField)
    (variation : PhysicalBivector) (parameter : ℝ) :
    generatedGravityBFDensity
        { field with
          gravityCurvature := field.gravityCurvature + parameter • variation } =
      generatedGravityBFDensity field +
        parameter * gravityBFCurvatureIncrementDensity field.coframe
          field.gravityAuxiliary variation := by
  unfold generatedGravityBFDensity gravityBFCurvatureIncrementDensity
  simp only [gravitySpacetimeHodge_add, gravitySpacetimeHodge_smul,
    gravityCoframePairing_add_right, gravityCoframePairing_smul_right]
  ring

theorem generatedGravityBFDensity_curvature_quadratic
    (field : StageNineContinuumPointField)
    (linear quadratic : PhysicalBivector) (parameter : ℝ) :
    generatedGravityBFDensity
        { field with
          gravityCurvature :=
            field.gravityCurvature + parameter • linear +
              parameter ^ 2 • quadratic } =
      generatedGravityBFDensity field +
        parameter * gravityBFCurvatureIncrementDensity field.coframe
          field.gravityAuxiliary linear +
        parameter ^ 2 * gravityBFCurvatureIncrementDensity field.coframe
          field.gravityAuxiliary quadratic := by
  unfold generatedGravityBFDensity gravityBFCurvatureIncrementDensity
  simp only [gravitySpacetimeHodge_add, gravitySpacetimeHodge_smul,
    gravityCoframePairing_add_right, gravityCoframePairing_smul_right]
  ring

theorem generatedContinuumMatterDensity_withLorentzConnectionJets_affine
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (gravityCurvature : PhysicalBivector)
    (variation : LorentzianIndex → DiracExteriorMatterCarrier)
    (parameter : ℝ) :
    generatedContinuumMatterDensity source chart point
        (withLorentzConnectionJets field gravityCurvature
          (field.matterCovariantDerivative + parameter • variation)) =
      generatedContinuumMatterDensity source chart point field +
        parameter * matterGaugeConnectionFirstVariationDensity source chart
          point field variation := by
  have actual :=
    generatedContinuumMatterDensity_withP286GaugeConnectionJets_affine
      source chart point field (p286CurvatureCoordinate field)
      field.scalarCovariantDerivative variation parameter
  simpa [withLorentzConnectionJets, withP286GaugeConnectionJets,
    generatedContinuumMatterDensity, generatedContinuumMatterVector]
    using actual

def lorentzConnectionFirstVariationDensity
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (curvatureVariation : PhysicalBivector)
    (matterVariation : LorentzianIndex → DiracExteriorMatterCarrier) : ℝ :=
  generatedVolumeDensity field *
    (gravityBFCurvatureIncrementDensity field.coframe
        field.gravityAuxiliary curvatureVariation +
      matterGaugeConnectionFirstVariationDensity source chart point field
        matterVariation)

def lorentzConnectionSecondVariationDensity
    (field : StageNineContinuumPointField)
    (curvatureVariation : PhysicalBivector) : ℝ :=
  generatedVolumeDensity field *
    gravityBFCurvatureIncrementDensity field.coframe
      field.gravityAuxiliary curvatureVariation

theorem generatedUnifiedLocalDensity_lorentzConnectionJets_quadratic
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (linearCurvature quadraticCurvature : PhysicalBivector)
    (matterVariation : LorentzianIndex → DiracExteriorMatterCarrier)
    (parameter : ℝ) :
    generatedUnifiedLocalDensityAtBoundary source
        (sourceGeneratedUnifiedCouplings source) chart point
        (withLorentzConnectionJets field
          (field.gravityCurvature + parameter • linearCurvature +
            parameter ^ 2 • quadraticCurvature)
          (field.matterCovariantDerivative + parameter • matterVariation)) =
      generatedUnifiedLocalDensityAtBoundary source
          (sourceGeneratedUnifiedCouplings source) chart point field +
        parameter * lorentzConnectionFirstVariationDensity source chart point
          field linearCurvature matterVariation +
        parameter ^ 2 * lorentzConnectionSecondVariationDensity field
          quadraticCurvature := by
  rw [generatedUnifiedLocalDensityAtBoundary,
    generatedUnifiedLocalDensityAtBoundary]
  simp only [withLorentzConnectionJets_volume]
  have gravityExpansion := generatedGravityBFDensity_curvature_quadratic field
    linearCurvature quadraticCurvature parameter
  have matterExpansion :=
    generatedContinuumMatterDensity_withLorentzConnectionJets_affine source
      chart point field
      (field.gravityCurvature + parameter • linearCurvature +
        parameter ^ 2 • quadraticCurvature)
      matterVariation parameter
  have simplicityReadout :
      generatedGravitySimplicityDensity
          (withLorentzConnectionJets field
            (field.gravityCurvature + parameter • linearCurvature +
              parameter ^ 2 • quadraticCurvature)
            (field.matterCovariantDerivative + parameter • matterVariation)) =
        generatedGravitySimplicityDensity field := by
    rfl
  have gravityReadout :
      generatedGravityBFDensity
          (withLorentzConnectionJets field
            (field.gravityCurvature + parameter • linearCurvature +
              parameter ^ 2 • quadraticCurvature)
            (field.matterCovariantDerivative + parameter • matterVariation)) =
        generatedGravityBFDensity
          { field with gravityCurvature :=
              field.gravityCurvature + parameter • linearCurvature +
                parameter ^ 2 • quadraticCurvature } := by
    rfl
  have scalarKineticReadout :
      generatedScalarKineticDensity source chart point
          (withLorentzConnectionJets field
            (field.gravityCurvature + parameter • linearCurvature +
              parameter ^ 2 • quadraticCurvature)
            (field.matterCovariantDerivative + parameter • matterVariation)) =
        generatedScalarKineticDensity source chart point field := by
    rfl
  unfold generatedUnifiedLocalDensityCoreAtBoundary
    generatedUnifiedLocalDensityNonGravityCoreAtBoundary
  rw [simplicityReadout, gravityReadout, gravityExpansion,
    scalarKineticReadout, matterExpansion]
  simp only [withLorentzConnectionJets]
  unfold lorentzConnectionFirstVariationDensity
    lorentzConnectionSecondVariationDensity
  ring

def holonomicLorentzConnectionFirstVariationDensity
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → LorentzBivectorOneForm)
    (point : BasePoint) : ℝ :=
  lorentzConnectionFirstVariationDensity source chart point
    (toContinuumPointField configuration point)
    (lorentzConnectionLinearCurvatureVariation configuration variation point)
    (holonomicMatterLorentzConnectionVariation configuration variation point)

def holonomicLorentzConnectionSecondVariationDensity
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → LorentzBivectorOneForm)
    (point : BasePoint) : ℝ :=
  lorentzConnectionSecondVariationDensity
    (toContinuumPointField configuration point)
    (lorentzConnectionQuadraticCurvatureVariation variation point)

theorem holonomicLocalDensity_lorentzConnection_quadratic
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (variation : CompactlySupportedSmoothVariation LorentzBivectorOneForm)
    (parameter : ℝ) (point : BasePoint) :
    generatedUnifiedLocalDensityAtBoundary source
        (sourceGeneratedUnifiedCouplings source) chart point
        (toContinuumPointField
          (varyLorentzConnection configuration variation parameter) point) =
      generatedUnifiedLocalDensityAtBoundary source
          (sourceGeneratedUnifiedCouplings source) chart point
          (toContinuumPointField configuration point) +
        parameter * holonomicLorentzConnectionFirstVariationDensity source
          chart configuration variation point +
        parameter ^ 2 * holonomicLorentzConnectionSecondVariationDensity
          configuration variation point := by
  rw [toContinuumPointField_varyLorentzConnection configuration smooth
    variation parameter point]
  exact generatedUnifiedLocalDensity_lorentzConnectionJets_quadratic
    source chart point (toContinuumPointField configuration point)
    (lorentzConnectionLinearCurvatureVariation configuration variation point)
    (lorentzConnectionQuadraticCurvatureVariation variation point)
    (holonomicMatterLorentzConnectionVariation configuration variation point)
    parameter

end

end SaturationMonoid.PhysicsCore.StageNineLorentzConnectionActionVariation
