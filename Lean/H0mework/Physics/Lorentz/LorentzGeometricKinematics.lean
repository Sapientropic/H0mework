/-!
# Form-native Lorentz geometric kinematics

This module supplies the actual first jet of the live gravity auxiliary field,
its standard contravariant exterior covariant derivative, and the derivative /
algebraic split of the lowered curvature response generated by a primitive
Lorentz variation.

All definitions are off-shell kinematics.  They consume no action equation,
stationarity, residual, torsion solution, or fixed actual.  The later pairing
theorem must explicitly consume `GravityConnectionLorentzAdmissible`; smooth
primitive data alone do not imply a Lorentz connection.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineFormNativeLorentzGeometricKinematics

open ProofFreeRicherAnholonomicSource
open PointwiseDiracSpinConnectionLift
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineGravityBianchi
open StageNineLorentzConnectionVariation
open StageNineLorentzConnectionActualVariationRegularity
open StageNineResidualLinearPlebanskiTorsionReduction
open StageNineTopologicalFourFormPairing
open StageNineTopologicalGravityCurvatureVariancePairing
open StageNineTopologicalLorentzThreeFormDuality
open scoped ContDiff

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 600000

/-! ## Actual gravity-auxiliary first jet -/

/-- Directional derivative of one actual auxiliary coordinate. -/
def gravityAuxiliaryDirectionalDerivative
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) (direction : LorentzianIndex) : PhysicalBivector :=
  fieldDirectionalDerivative configuration.gravityAuxiliary point direction

/-- Smoothness of the whole actual auxiliary field, assembled from the
primitive coordinate smoothness carried by the holonomic configuration. -/
theorem holonomicGravityAuxiliary_contDiff
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth) :
    ContDiff ℝ ∞ configuration.gravityAuxiliary := by
  apply contDiff_pi'
  intro internalPair
  apply contDiff_pi'
  intro spacetimePair
  exact smooth.2.2.1 internalPair spacetimePair

/-- The actual pointwise first jet of the live primitive gravity auxiliary.
No jet or derivative receipt is supplied separately. -/
def holonomicGravityAuxiliaryJet
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) : PointwisePhysicalBivectorJet where
  value := configuration.gravityAuxiliary point
  derivative := gravityAuxiliaryDirectionalDerivative configuration point

@[simp] theorem holonomicGravityAuxiliaryJet_value
    (configuration : StageNineHolonomicConfiguration) (point : BasePoint) :
    (holonomicGravityAuxiliaryJet configuration point).value =
      configuration.gravityAuxiliary point :=
  rfl

@[simp] theorem holonomicGravityAuxiliaryJet_derivative
    (configuration : StageNineHolonomicConfiguration) (point : BasePoint)
    (direction : LorentzianIndex) :
    (holonomicGravityAuxiliaryJet configuration point).derivative direction =
      gravityAuxiliaryDirectionalDerivative configuration point direction :=
  rfl

/-- Actual geometric `D_omega B` generated by the primitive connection and
the live gravity auxiliary field. -/
def holonomicGravityAuxiliaryExteriorCovariantDerivative
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) : PhysicalBivectorThreeForm :=
  pointwisePhysicalBivectorExteriorCovariantDerivative
    (configuration.gravityConnection point)
    (holonomicGravityAuxiliaryJet configuration point)

/-- Pure exterior derivative of a contravariant physical bivector jet. -/
def pointwisePhysicalBivectorExteriorDerivativeOfDerivative
    (derivative : LorentzianIndex → PhysicalBivector) :
    PhysicalBivectorThreeForm :=
  fun internalPair triple =>
    orderedSpacetimeBivectorComponent
        (derivative (threeFormFirst triple)) internalPair
        (threeFormSecond triple) (threeFormThird triple) +
      orderedSpacetimeBivectorComponent
        (derivative (threeFormSecond triple)) internalPair
        (threeFormThird triple) (threeFormFirst triple) +
      orderedSpacetimeBivectorComponent
        (derivative (threeFormThird triple)) internalPair
        (threeFormFirst triple) (threeFormSecond triple)

def pointwisePhysicalBivectorExteriorDerivative
    (jet : PointwisePhysicalBivectorJet) : PhysicalBivectorThreeForm :=
  pointwisePhysicalBivectorExteriorDerivativeOfDerivative jet.derivative

/-- Connection-action part of the exterior covariant derivative. -/
def pointwisePhysicalBivectorConnectionExteriorAction
    (connection : PointwiseLorentzSpinConnection)
    (bivector : PhysicalBivector) : PhysicalBivectorThreeForm :=
  pointwisePhysicalBivectorExteriorCovariantDerivative connection
    { value := bivector, derivative := 0 }

/-- Exact derived split `D_connection B = dB + connection·B`. -/
theorem pointwisePhysicalBivectorExteriorCovariantDerivative_eq_parts
    (connection : PointwiseLorentzSpinConnection)
    (jet : PointwisePhysicalBivectorJet) :
    pointwisePhysicalBivectorExteriorCovariantDerivative connection jet =
      pointwisePhysicalBivectorExteriorDerivative jet +
        pointwisePhysicalBivectorConnectionExteriorAction connection
          jet.value := by
  funext internalPair triple
  unfold pointwisePhysicalBivectorExteriorCovariantDerivative
    pointwisePhysicalBivectorCovariantDerivative
    pointwisePhysicalBivectorExteriorDerivative
    pointwisePhysicalBivectorExteriorDerivativeOfDerivative
    pointwisePhysicalBivectorConnectionExteriorAction
  simp [pointwisePhysicalBivectorExteriorCovariantDerivative,
    pointwisePhysicalBivectorCovariantDerivative,
    orderedSpacetimeBivectorComponent]
  simp_rw [add_mul]
  simp only [Finset.sum_add_distrib]
  ring

/-- Actual `dB` generated from the primitive auxiliary field, before the
connection-action channel is added. -/
def holonomicGravityAuxiliaryExteriorDerivative
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) : PhysicalBivectorThreeForm :=
  pointwisePhysicalBivectorExteriorDerivative
    (holonomicGravityAuxiliaryJet configuration point)

theorem holonomicGravityAuxiliaryExteriorCovariantDerivative_eq_parts
    (configuration : StageNineHolonomicConfiguration) (point : BasePoint) :
    holonomicGravityAuxiliaryExteriorCovariantDerivative configuration point =
      holonomicGravityAuxiliaryExteriorDerivative configuration point +
        pointwisePhysicalBivectorConnectionExteriorAction
          (configuration.gravityConnection point)
          (configuration.gravityAuxiliary point) := by
  exact pointwisePhysicalBivectorExteriorCovariantDerivative_eq_parts
    (configuration.gravityConnection point)
    (holonomicGravityAuxiliaryJet configuration point)

theorem gravityAuxiliaryDirectionalDerivative_continuous
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (direction : LorentzianIndex) :
    Continuous
      (gravityAuxiliaryDirectionalDerivative configuration · direction) := by
  change Continuous fun point =>
    fderiv ℝ configuration.gravityAuxiliary point
      (coordinateDirection direction)
  have derivativeContinuous :
      Continuous (fderiv ℝ configuration.gravityAuxiliary) :=
    ((holonomicGravityAuxiliary_contDiff configuration smooth).fderiv_right
      (m := 0) (by simp)).continuous
  exact derivativeContinuous.clm_apply continuous_const

theorem holonomicGravityAuxiliaryExteriorCovariantDerivative_continuous
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth) :
    Continuous
      (holonomicGravityAuxiliaryExteriorCovariantDerivative configuration) := by
  apply continuous_pi
  intro internalPair
  apply continuous_pi
  intro triple
  have valueContinuous : Continuous configuration.gravityAuxiliary := by
    apply continuous_pi
    intro pair
    apply continuous_pi
    intro formPair
    exact (smooth.2.2.1 pair formPair).continuous
  have derivativeContinuous : ∀ direction,
      Continuous
        (gravityAuxiliaryDirectionalDerivative configuration · direction) :=
    gravityAuxiliaryDirectionalDerivative_continuous configuration smooth
  have connectionContinuous : ∀ direction internalOut internalIn,
      Continuous fun point =>
        configuration.gravityConnection point direction internalOut
          internalIn := fun direction internalOut internalIn =>
    (smooth.2.1 direction internalOut internalIn).continuous
  unfold holonomicGravityAuxiliaryExteriorCovariantDerivative
    pointwisePhysicalBivectorExteriorCovariantDerivative
    pointwisePhysicalBivectorCovariantDerivative
    holonomicGravityAuxiliaryJet
    ordinaryLorentzBivectorConnectionAction
    orderedInternalBivectorComponent
    orderedSpacetimeBivectorComponent
  dsimp only
  fun_prop

/-! ## Lowered curvature response split -/

/-- Exterior-derivative channel of the historical lowered curvature
variation. -/
def lorentzConnectionExteriorDerivativeVariation
    (variation : BasePoint -> LorentzBivectorOneForm) (point : BasePoint) :
    PhysicalBivector :=
  fun internalPair spacetimePair =>
    let internalOut := pairFirst internalPair
    let internalIn := pairSecond internalPair
    let first := pairFirst spacetimePair
    let second := pairSecond spacetimePair
    minkowskiInternalSign internalOut *
      (lorentzConnectionVariationDerivative variation point first second
          internalOut internalIn -
        lorentzConnectionVariationDerivative variation point second first
          internalOut internalIn)

/-- Algebraic connection channel of the same lowered curvature variation. -/
def lorentzConnectionAlgebraicCurvatureVariation
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint -> LorentzBivectorOneForm) (point : BasePoint) :
    PhysicalBivector :=
  fun internalPair spacetimePair =>
    let internalOut := pairFirst internalPair
    let internalIn := pairSecond internalPair
    let first := pairFirst spacetimePair
    let second := pairSecond spacetimePair
    let varied := lorentzSkewConnectionOfBivectorOneForm (variation point)
    minkowskiInternalSign internalOut *
      ∑ middle : LorentzianIndex,
        (varied first internalOut middle *
            configuration.gravityConnection point second middle internalIn +
          configuration.gravityConnection point first internalOut middle *
            varied second middle internalIn -
          varied second internalOut middle *
            configuration.gravityConnection point first middle internalIn -
          configuration.gravityConnection point second internalOut middle *
            varied first middle internalIn)

def lorentzConnectionAlgebraicCurvatureDirection
    (configuration : StageNineHolonomicConfiguration)
    (direction : LorentzBivectorOneForm) (point : BasePoint) :
    PhysicalBivector :=
  lorentzConnectionAlgebraicCurvatureVariation configuration
    (fun _ => direction) point

theorem lorentzConnectionLinearCurvatureVariation_eq_parts
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint -> LorentzBivectorOneForm) (point : BasePoint) :
    lorentzConnectionLinearCurvatureVariation configuration variation point =
      lorentzConnectionExteriorDerivativeVariation variation point +
        lorentzConnectionAlgebraicCurvatureVariation configuration variation
          point := by
  funext internalPair spacetimePair
  unfold lorentzConnectionLinearCurvatureVariation
    lorentzConnectionExteriorDerivativeVariation
    lorentzConnectionAlgebraicCurvatureVariation
  dsimp only
  simp only [Pi.add_apply]
  ring

/-! ## Pointwise algebraic W22--W13 seam -/

/-- The algebraic commutator part of the actual lowered curvature response
pairs with the connection-action part of `D_omega B` with exact sign `+1`
and factor `1`.  `GravityConnectionLorentzAdmissible` is the explicit domain
gate; smoothness alone is insufficient. -/
theorem gravityTopologicalBF_algebraicCurvatureDirection_eq_w13
    (configuration : StageNineHolonomicConfiguration)
    (admissible : GravityConnectionLorentzAdmissible configuration)
    (point : BasePoint) (direction : LorentzBivectorOneForm) :
    gravityTopologicalBFCoefficient
        (configuration.gravityAuxiliary point)
        (lorentzConnectionAlgebraicCurvatureDirection configuration direction
          point) =
      lorentzOneFormThreeFormWedgeCoefficient direction
        (pointwisePhysicalBivectorConnectionExteriorAction
          (configuration.gravityConnection point)
          (configuration.gravityAuxiliary point)) := by
  have connectionSkew :
      LorentzSkew (configuration.gravityConnection point) :=
    gravityConnection_lorentzSkew_of_admissible configuration admissible point
  have h00 (formDirection : LorentzianIndex) :
      configuration.gravityConnection point formDirection 0 0 = 0 :=
    lorentzSkew_diagonal_zero _ connectionSkew formDirection 0
  have h11 (formDirection : LorentzianIndex) :
      configuration.gravityConnection point formDirection 1 1 = 0 :=
    lorentzSkew_diagonal_zero _ connectionSkew formDirection 1
  have h22 (formDirection : LorentzianIndex) :
      configuration.gravityConnection point formDirection 2 2 = 0 :=
    lorentzSkew_diagonal_zero _ connectionSkew formDirection 2
  have h33 (formDirection : LorentzianIndex) :
      configuration.gravityConnection point formDirection 3 3 = 0 :=
    lorentzSkew_diagonal_zero _ connectionSkew formDirection 3
  have h10 (formDirection : LorentzianIndex) :
      configuration.gravityConnection point formDirection 1 0 =
        configuration.gravityConnection point formDirection 0 1 := by
    have h := lorentzSkew_entry _ connectionSkew formDirection 0 1
    simp only [minkowskiInternalSign_one_value,
      minkowskiInternalSign_zero_value, one_mul, neg_one_mul] at h
    linarith
  have h20 (formDirection : LorentzianIndex) :
      configuration.gravityConnection point formDirection 2 0 =
        configuration.gravityConnection point formDirection 0 2 := by
    have h := lorentzSkew_entry _ connectionSkew formDirection 0 2
    simp only [minkowskiInternalSign_two_value,
      minkowskiInternalSign_zero_value, one_mul, neg_one_mul] at h
    linarith
  have h30 (formDirection : LorentzianIndex) :
      configuration.gravityConnection point formDirection 3 0 =
        configuration.gravityConnection point formDirection 0 3 := by
    have h := lorentzSkew_entry _ connectionSkew formDirection 0 3
    simp only [minkowskiInternalSign_three_value,
      minkowskiInternalSign_zero_value, one_mul, neg_one_mul] at h
    linarith
  have h21 (formDirection : LorentzianIndex) :
      configuration.gravityConnection point formDirection 2 1 =
        -configuration.gravityConnection point formDirection 1 2 := by
    have h := lorentzSkew_entry _ connectionSkew formDirection 1 2
    simp only [minkowskiInternalSign_two_value,
      minkowskiInternalSign_one_value, one_mul] at h
    linarith
  have h31 (formDirection : LorentzianIndex) :
      configuration.gravityConnection point formDirection 3 1 =
        -configuration.gravityConnection point formDirection 1 3 := by
    have h := lorentzSkew_entry _ connectionSkew formDirection 1 3
    simp only [minkowskiInternalSign_three_value,
      minkowskiInternalSign_one_value, one_mul] at h
    linarith
  have h32 (formDirection : LorentzianIndex) :
      configuration.gravityConnection point formDirection 3 2 =
        -configuration.gravityConnection point formDirection 2 3 := by
    have h := lorentzSkew_entry _ connectionSkew formDirection 2 3
    simp only [minkowskiInternalSign_three_value,
      minkowskiInternalSign_two_value, one_mul] at h
    linarith
  rw [gravityTopologicalBFCoefficient_eq_mixed]
  simp [gravityTopologicalMixedWedgeCoefficient,
    orientedTwoFormWedgeCoefficient_explicit,
    lorentzConnectionAlgebraicCurvatureDirection,
    lorentzConnectionAlgebraicCurvatureVariation,
    lorentzOneFormThreeFormWedgeCoefficient,
    pointwisePhysicalBivectorExteriorCovariantDerivative,
    pointwisePhysicalBivectorCovariantDerivative,
    pointwisePhysicalBivectorConnectionExteriorAction,
    ordinaryLorentzBivectorConnectionAction,
    orderedInternalBivectorComponent,
    orderedSpacetimeBivectorComponent,
    lorentzSkewConnectionOfBivectorOneForm,
    loweredLorentzBivectorMatrix,
    orientedLorentzBivectorBasisCoefficient,
    oneWedgeThreeSign, missingTripleOfOneForm,
    threeFormFirst, threeFormSecond, threeFormThird,
    pairFirst, pairSecond, minkowskiInternalSign,
    Fin.sum_univ_four, Fin.sum_univ_six,
    h00, h11, h22, h33, h10, h20, h30, h21, h31, h32]
  all_goals ring

end

