/-! ## Direct lowered exterior derivative and its principal symbol -/

/-- Contribution of one coordinate derivative to the lowered bivector-valued
two-form `d q`.  Both the derivative direction and the one-form value are
lowered coordinates; no internal metric or coframe enters this definition. -/
def loweredLorentzExteriorDerivativeDirection
    (derivativeDirection : LorentzianIndex)
    (oneForm : LorentzBivectorOneForm) : PhysicalBivector :=
  fun internalPair spacetimePair =>
    let first := pairFirst spacetimePair
    let second := pairSecond spacetimePair
    (if derivativeDirection = first then
        oneForm second internalPair
      else 0) -
      if derivativeDirection = second then
        oneForm first internalPair
      else 0

theorem loweredLorentzExteriorDerivativeDirection_add
    (derivativeDirection : LorentzianIndex)
    (first second : LorentzBivectorOneForm) :
    loweredLorentzExteriorDerivativeDirection derivativeDirection
        (first + second) =
      loweredLorentzExteriorDerivativeDirection derivativeDirection first +
        loweredLorentzExteriorDerivativeDirection derivativeDirection second := by
  funext internalPair spacetimePair
  unfold loweredLorentzExteriorDerivativeDirection
  dsimp only
  simp only [Pi.add_apply]
  split_ifs <;> ring

theorem loweredLorentzExteriorDerivativeDirection_smul
    (derivativeDirection : LorentzianIndex) (parameter : ℝ)
    (oneForm : LorentzBivectorOneForm) :
    loweredLorentzExteriorDerivativeDirection derivativeDirection
        (parameter • oneForm) =
      parameter •
        loweredLorentzExteriorDerivativeDirection derivativeDirection
          oneForm := by
  funext internalPair spacetimePair
  unfold loweredLorentzExteriorDerivativeDirection
  dsimp only
  simp only [Pi.smul_apply, smul_eq_mul]
  split_ifs <;> ring

private def gravityTopologicalBFRightLinear
    (auxiliary : PhysicalBivector) : PhysicalBivector →ₗ[ℝ] ℝ where
  toFun := gravityTopologicalBFCoefficient auxiliary
  map_add' := fun first second =>
    gravityTopologicalBFCoefficient_add_right auxiliary first second
  map_smul' := by
    intro parameter first
    simpa only [RingHom.id_apply, smul_eq_mul] using
      gravityTopologicalBFCoefficient_smul_right parameter auxiliary first

/-- The derivative-direction principal pairing
`(B,q) |-> W22(B, d_direction q)`. -/
def gravityExteriorPrincipalBilinear
    (derivativeDirection : LorentzianIndex) :
    PhysicalBivector →ₗ[ℝ] LorentzBivectorOneForm →ₗ[ℝ] ℝ where
  toFun auxiliary :=
    { toFun := fun oneForm =>
        gravityTopologicalBFCoefficient auxiliary
          (loweredLorentzExteriorDerivativeDirection derivativeDirection
            oneForm)
      map_add' := by
        intro first second
        rw [loweredLorentzExteriorDerivativeDirection_add,
          gravityTopologicalBFCoefficient_add_right]
      map_smul' := by
        intro parameter oneForm
        rw [loweredLorentzExteriorDerivativeDirection_smul,
          gravityTopologicalBFCoefficient_smul_right]
        rfl }
  map_add' := by
    intro first second
    apply LinearMap.ext
    intro oneForm
    exact gravityTopologicalBFCoefficient_add_left first second _
  map_smul' := by
    intro parameter auxiliary
    apply LinearMap.ext
    intro oneForm
    change
      gravityTopologicalBFCoefficient (parameter • auxiliary)
          (loweredLorentzExteriorDerivativeDirection derivativeDirection
            oneForm) =
        parameter *
          gravityTopologicalBFCoefficient auxiliary
            (loweredLorentzExteriorDerivativeDirection derivativeDirection
              oneForm)
    exact gravityTopologicalBFCoefficient_smul_left parameter auxiliary _

@[simp] theorem gravityExteriorPrincipalBilinear_apply
    (derivativeDirection : LorentzianIndex)
    (auxiliary : PhysicalBivector)
    (oneForm : LorentzBivectorOneForm) :
    gravityExteriorPrincipalBilinear derivativeDirection auxiliary oneForm =
      gravityTopologicalBFCoefficient auxiliary
        (loweredLorentzExteriorDerivativeDirection derivativeDirection
          oneForm) :=
  rfl

/-- Continuity is generated by the finite-dimensional carriers. -/
def gravityExteriorPrincipalContinuousBilinear
    (derivativeDirection : LorentzianIndex) :
    PhysicalBivector →L[ℝ] LorentzBivectorOneForm →L[ℝ] ℝ :=
  (gravityExteriorPrincipalBilinear derivativeDirection)
    |>.toContinuousBilinearMap

@[simp] theorem gravityExteriorPrincipalContinuousBilinear_apply
    (derivativeDirection : LorentzianIndex)
    (auxiliary : PhysicalBivector)
    (oneForm : LorentzBivectorOneForm) :
    gravityExteriorPrincipalContinuousBilinear derivativeDirection auxiliary
        oneForm =
      gravityTopologicalBFCoefficient auxiliary
        (loweredLorentzExteriorDerivativeDirection derivativeDirection
          oneForm) :=
  rfl

/-- Direct lowered `d q`, assembled from the actual Fréchet derivative of the
whole one-form field. -/
def loweredLorentzBivectorExteriorDerivative
    (variation : BasePoint → LorentzBivectorOneForm)
    (point : BasePoint) : PhysicalBivector :=
  ∑ derivativeDirection : LorentzianIndex,
    loweredLorentzExteriorDerivativeDirection derivativeDirection
      (fieldDirectionalDerivative variation point derivativeDirection)

private theorem fieldDirectionalDerivative_pi_apply_local
    {I V : Type*} [Fintype I]
    [NormedAddCommGroup V] [NormedSpace ℝ V]
    (field : BasePoint → I → V) (fieldSmooth : ContDiff ℝ ∞ field)
    (point : BasePoint) (direction : LorentzianIndex) (index : I) :
    (fieldDirectionalDerivative field point direction) index =
      fieldDirectionalDerivative (fun candidate => field candidate index)
        point direction := by
  unfold fieldDirectionalDerivative
  have differentiable : DifferentiableAt ℝ field point :=
    (fieldSmooth.differentiable (by simp)).differentiableAt
  have derivativeEquality := fderiv_apply differentiable index
  have applied := congrArg
    (fun derivative : BasePoint →L[ℝ] V =>
      derivative (coordinateDirection direction)) derivativeEquality
  simpa only [ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.proj_apply] using applied.symm

private theorem fieldDirectionalDerivative_oneForm_coordinate
    (variation : CompactlySupportedSmoothVariation LorentzBivectorOneForm)
    (point : BasePoint) (derivativeDirection formDirection : LorentzianIndex)
    (internalPair : Fin 6) :
    (fieldDirectionalDerivative variation point derivativeDirection)
        formDirection internalPair =
      fieldDirectionalDerivative
        (fun candidate => variation candidate formDirection internalPair)
        point derivativeDirection := by
  have first := fieldDirectionalDerivative_pi_apply_local variation
    variation.smooth point derivativeDirection formDirection
  have formSmooth : ContDiff ℝ ∞ fun candidate =>
      variation candidate formDirection :=
    contDiff_pi.mp variation.smooth formDirection
  have second := fieldDirectionalDerivative_pi_apply_local
    (fun candidate => variation candidate formDirection) formSmooth point
      derivativeDirection internalPair
  calc
    (fieldDirectionalDerivative variation point derivativeDirection)
          formDirection internalPair =
        (fieldDirectionalDerivative
          (fun candidate => variation candidate formDirection) point
            derivativeDirection) internalPair := congrArg
              (fun oneForm => oneForm internalPair) first
    _ = _ := second

private def lorentzSkewConnectionCoordinateLinear
    (formDirection internalOut internalIn : LorentzianIndex) :
    LorentzBivectorOneForm →ₗ[ℝ] ℝ where
  toFun := fun oneForm =>
    lorentzSkewConnectionOfBivectorOneForm oneForm formDirection internalOut
      internalIn
  map_add' := by
    intro first second
    have lifted := lorentzSkewConnectionOfBivectorOneForm_add first second
    exact congrFun (congrFun (congrFun lifted formDirection) internalOut)
      internalIn
  map_smul' := by
    intro parameter oneForm
    have lifted := lorentzSkewConnectionOfBivectorOneForm_smul parameter oneForm
    exact congrFun (congrFun (congrFun lifted formDirection) internalOut)
      internalIn

private theorem minkowskiSign_mul_lorentzSkewConnection_pair
    (oneForm : LorentzBivectorOneForm) (formDirection : LorentzianIndex)
    (internalPair : Fin 6) :
    minkowskiInternalSign (pairFirst internalPair) *
        lorentzSkewConnectionOfBivectorOneForm oneForm formDirection
          (pairFirst internalPair) (pairSecond internalPair) =
      oneForm formDirection internalPair := by
  fin_cases internalPair <;>
    simp [lorentzSkewConnectionOfBivectorOneForm,
      loweredLorentzBivectorMatrix,
      orientedLorentzBivectorBasisCoefficient,
      pairFirst, pairSecond, minkowskiInternalSign,
      Fin.sum_univ_six]

/-- Chain-rule seam from the lifted connection coordinate back to the whole
lowered one-form derivative.  The two internal variance signs cancel here,
before the direct `d q` carrier enters W22. -/
theorem loweredLorentzConnectionVariationDerivative_coordinate
    (variation : CompactlySupportedSmoothVariation LorentzBivectorOneForm)
    (point : BasePoint) (derivativeDirection formDirection : LorentzianIndex)
    (internalPair : Fin 6) :
    minkowskiInternalSign (pairFirst internalPair) *
        lorentzConnectionVariationDerivative variation point
          derivativeDirection formDirection (pairFirst internalPair)
            (pairSecond internalPair) =
      (fieldDirectionalDerivative variation point derivativeDirection)
        formDirection internalPair := by
  let connectionCoordinate :=
    lorentzSkewConnectionCoordinateLinear formDirection
      (pairFirst internalPair) (pairSecond internalPair)
  have connectionCoordinateSmooth : ContDiff ℝ ∞ fun candidate =>
      connectionCoordinate (variation candidate) :=
    connectionCoordinate.toContinuousLinearMap.contDiff.comp variation.smooth
  have functionEquality :
      (fun candidate =>
        minkowskiInternalSign (pairFirst internalPair) *
          connectionCoordinate (variation candidate)) =
        (fun candidate => variation candidate formDirection internalPair) := by
    funext candidate
    exact minkowskiSign_mul_lorentzSkewConnection_pair
      (variation candidate) formDirection internalPair
  have derivativeEquality := congrArg
    (fun field : BasePoint → ℝ =>
      fderiv ℝ field point (coordinateDirection derivativeDirection))
    functionEquality
  rw [fderiv_const_mul
    (connectionCoordinateSmooth.differentiable (by simp) point)
      (minkowskiInternalSign (pairFirst internalPair))] at derivativeEquality
  change
    minkowskiInternalSign (pairFirst internalPair) *
        lorentzConnectionVariationDerivative variation point
          derivativeDirection formDirection (pairFirst internalPair)
            (pairSecond internalPair) =
      fieldDirectionalDerivative
        (fun candidate => variation candidate formDirection internalPair)
        point derivativeDirection at derivativeEquality
  exact derivativeEquality.trans
    (fieldDirectionalDerivative_oneForm_coordinate variation point
      derivativeDirection formDirection internalPair).symm

/-- The direct lowered exterior derivative used by the IBP carrier is exactly
the derivative channel of the production raw-curvature response. -/
theorem loweredLorentzBivectorExteriorDerivative_eq_actual
    (variation : CompactlySupportedSmoothVariation LorentzBivectorOneForm)
    (point : BasePoint) :
    loweredLorentzBivectorExteriorDerivative variation point =
      lorentzConnectionExteriorDerivativeVariation variation point := by
  funext internalPair spacetimePair
  have firstCoordinate :=
    loweredLorentzConnectionVariationDerivative_coordinate variation point
      (pairFirst spacetimePair) (pairSecond spacetimePair) internalPair
  have secondCoordinate :=
    loweredLorentzConnectionVariationDerivative_coordinate variation point
      (pairSecond spacetimePair) (pairFirst spacetimePair) internalPair
  unfold loweredLorentzBivectorExteriorDerivative
    loweredLorentzExteriorDerivativeDirection
    lorentzConnectionExteriorDerivativeVariation
  dsimp only
  fin_cases spacetimePair <;>
    simp [Finset.sum_apply, pairFirst, pairSecond,
      Fin.sum_univ_four] at firstCoordinate secondCoordinate ⊢ <;>
    linarith

/-! ## Two finite-coordinate identities -/

/-- Expanding direct `d q` exposes one principal-symbol term for each
spacetime derivative direction. -/
theorem gravityTopologicalBF_loweredExteriorDerivative_eq_principalSum
    (auxiliary : PhysicalBivector)
    (variation : BasePoint → LorentzBivectorOneForm)
    (point : BasePoint) :
    gravityTopologicalBFCoefficient auxiliary
        (loweredLorentzBivectorExteriorDerivative variation point) =
      ∑ derivativeDirection : LorentzianIndex,
        gravityExteriorPrincipalBilinear derivativeDirection auxiliary
          (fieldDirectionalDerivative variation point derivativeDirection) := by
  change
    gravityTopologicalBFRightLinear auxiliary
        (∑ derivativeDirection : LorentzianIndex,
          loweredLorentzExteriorDerivativeDirection derivativeDirection
            (fieldDirectionalDerivative variation point
              derivativeDirection)) =
      ∑ derivativeDirection : LorentzianIndex,
        gravityTopologicalBFRightLinear auxiliary
          (loweredLorentzExteriorDerivativeDirection derivativeDirection
            (fieldDirectionalDerivative variation point
              derivativeDirection))
  rw [map_sum]

/-- Coordinate Stokes sign identity.  The minus sign generated by analytic
integration by parts becomes the fixed `(+,-,+,-)` W13 orientation, so the
final integrated formula has coefficient `+1`. -/
theorem gravityExteriorPrincipalSum_eq_w13
    (derivative : LorentzianIndex → PhysicalBivector)
    (oneForm : LorentzBivectorOneForm) :
    -(∑ derivativeDirection : LorentzianIndex,
        gravityExteriorPrincipalBilinear derivativeDirection
          (derivative derivativeDirection) oneForm) =
      lorentzOneFormThreeFormWedgeCoefficient oneForm
        (pointwisePhysicalBivectorExteriorDerivativeOfDerivative
          derivative) := by
  classical
  simp [gravityExteriorPrincipalBilinear,
    gravityTopologicalBFCoefficient_eq_mixed,
    gravityTopologicalMixedWedgeCoefficient,
    orientedTwoFormWedgeCoefficient_explicit,
    loweredLorentzExteriorDerivativeDirection,
    lorentzOneFormThreeFormWedgeCoefficient,
    pointwisePhysicalBivectorExteriorDerivativeOfDerivative,
    orderedSpacetimeBivectorComponent,
    orientedLorentzBivectorBasisCoefficient,
    oneWedgeThreeSign, missingTripleOfOneForm,
    threeFormFirst, threeFormSecond, threeFormThird,
    pairFirst, pairSecond, Fin.sum_univ_four, Fin.sum_univ_six]
  ring

/-! ## Compact-support integration by parts -/

private theorem gravityExteriorPrincipal_left_integrable
    (background : BasePoint → PhysicalBivector)
    (backgroundSmooth : ContDiff ℝ ∞ background)
    (variation : CompactlySupportedSmoothVariation LorentzBivectorOneForm)
    (derivativeDirection : LorentzianIndex) :
    Integrable fun point =>
      gravityExteriorPrincipalContinuousBilinear derivativeDirection
        (background point)
        (fderiv ℝ variation point
          (coordinateDirection derivativeDirection)) := by
  have termContinuous : Continuous fun point =>
      gravityExteriorPrincipalContinuousBilinear derivativeDirection
        (background point)
        (fderiv ℝ variation point
          (coordinateDirection derivativeDirection)) :=
    ((gravityExteriorPrincipalContinuousBilinear derivativeDirection)
      |>.continuous.comp backgroundSmooth.continuous).clm_apply
        (compactVariation_directionalDerivative_continuous variation
          derivativeDirection)
  have derivativeCompact : HasCompactSupport fun point =>
      fderiv ℝ variation point
        (coordinateDirection derivativeDirection) :=
    compactVariation_directionalDerivative_compact variation
      derivativeDirection
  have termCompact : HasCompactSupport fun point =>
      gravityExteriorPrincipalContinuousBilinear derivativeDirection
        (background point)
        (fderiv ℝ variation point
          (coordinateDirection derivativeDirection)) :=
    hasCompactSupport_bilinear_right
      (gravityExteriorPrincipalContinuousBilinear derivativeDirection)
      background _ derivativeCompact
  exact termContinuous.integrable_of_hasCompactSupport termCompact

private theorem gravityExteriorPrincipal_right_integrable
    (background : BasePoint → PhysicalBivector)
    (backgroundSmooth : ContDiff ℝ ∞ background)
    (variation : CompactlySupportedSmoothVariation LorentzBivectorOneForm)
    (derivativeDirection : LorentzianIndex) :
    Integrable fun point =>
      gravityExteriorPrincipalContinuousBilinear derivativeDirection
        (fderiv ℝ background point
          (coordinateDirection derivativeDirection))
        (variation point) := by
  have derivativeContinuous : Continuous (fderiv ℝ background) :=
    (backgroundSmooth.fderiv_right (m := 0) (by simp)).continuous
  have directionalContinuous : Continuous fun point =>
      fderiv ℝ background point
        (coordinateDirection derivativeDirection) :=
    derivativeContinuous.clm_apply continuous_const
  have termContinuous : Continuous fun point =>
      gravityExteriorPrincipalContinuousBilinear derivativeDirection
        (fderiv ℝ background point
          (coordinateDirection derivativeDirection))
        (variation point) :=
    ((gravityExteriorPrincipalContinuousBilinear derivativeDirection)
      |>.continuous.comp directionalContinuous).clm_apply
        variation.smooth.continuous
  have termCompact : HasCompactSupport fun point =>
      gravityExteriorPrincipalContinuousBilinear derivativeDirection
        (fderiv ℝ background point
          (coordinateDirection derivativeDirection))
        (variation point) :=
    hasCompactSupport_bilinear_right
      (gravityExteriorPrincipalContinuousBilinear derivativeDirection)
      _ variation variation.compactSupport
  exact termContinuous.integrable_of_hasCompactSupport termCompact

private theorem gravityExteriorPrincipal_integrationByParts
    (background : BasePoint → PhysicalBivector)
    (backgroundSmooth : ContDiff ℝ ∞ background)
    (variation : CompactlySupportedSmoothVariation LorentzBivectorOneForm)
    (derivativeDirection : LorentzianIndex) :
    (∫ point : BasePoint,
      gravityExteriorPrincipalContinuousBilinear derivativeDirection
        (background point)
        (fderiv ℝ variation point
          (coordinateDirection derivativeDirection))) =
      -(∫ point : BasePoint,
        gravityExteriorPrincipalContinuousBilinear derivativeDirection
          (fderiv ℝ background point
            (coordinateDirection derivativeDirection))
          (variation point)) :=
  compactSupport_integrationByParts
    (gravityExteriorPrincipalContinuousBilinear derivativeDirection)
    background variation backgroundSmooth derivativeDirection

/-! ## Public integrability seams -/

/-- The actual exterior-curvature response is integrable against the live
auxiliary field.  Compact support belongs to the connection variation; no
action equation or nondegeneracy assumption is used. -/
theorem gravityTopologicalBF_exteriorDerivativeVariation_integrable
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (variation :
      CompactlySupportedSmoothVariation LorentzBivectorOneForm) :
    Integrable fun point : BasePoint =>
      gravityTopologicalBFCoefficient
        (configuration.gravityAuxiliary point)
        (lorentzConnectionExteriorDerivativeVariation variation point) := by
  have auxiliarySmooth :
      ContDiff ℝ ∞ configuration.gravityAuxiliary :=
    holonomicGravityAuxiliary_contDiff configuration smooth
  have principalIntegrable : Integrable fun point : BasePoint =>
      ∑ derivativeDirection : LorentzianIndex,
        gravityExteriorPrincipalContinuousBilinear derivativeDirection
          (configuration.gravityAuxiliary point)
          (fderiv ℝ variation point
            (coordinateDirection derivativeDirection)) :=
    integrable_finsetSum Finset.univ fun derivativeDirection _ =>
      gravityExteriorPrincipal_left_integrable
        configuration.gravityAuxiliary auxiliarySmooth variation
          derivativeDirection
  refine principalIntegrable.congr ?_
  filter_upwards [] with point
  rw [← loweredLorentzBivectorExteriorDerivative_eq_actual variation point]
  simpa [fieldDirectionalDerivative] using
    (gravityTopologicalBF_loweredExteriorDerivative_eq_principalSum
      (configuration.gravityAuxiliary point) variation point).symm

/-- The geometric `W13(q,dB)` side is integrable on the same actual.  This
is the right-hand analytic seam needed to compose the full connection first
variation without silently distributing a nonintegrable Bochner integral. -/
theorem lorentzWedge_holonomicGravityAuxiliaryExteriorDerivative_integrable
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (variation :
      CompactlySupportedSmoothVariation LorentzBivectorOneForm) :
    Integrable fun point : BasePoint =>
      lorentzOneFormThreeFormWedgeCoefficient (variation point)
        (holonomicGravityAuxiliaryExteriorDerivative configuration point) := by
  have auxiliarySmooth :
      ContDiff ℝ ∞ configuration.gravityAuxiliary :=
    holonomicGravityAuxiliary_contDiff configuration smooth
  have principalIntegrable : Integrable fun point : BasePoint =>
      ∑ derivativeDirection : LorentzianIndex,
        gravityExteriorPrincipalContinuousBilinear derivativeDirection
          (fderiv ℝ configuration.gravityAuxiliary point
            (coordinateDirection derivativeDirection))
          (variation point) :=
    integrable_finsetSum Finset.univ fun derivativeDirection _ =>
      gravityExteriorPrincipal_right_integrable
        configuration.gravityAuxiliary auxiliarySmooth variation
          derivativeDirection
  refine principalIntegrable.neg.congr ?_
  filter_upwards [] with point
  simpa [gravityAuxiliaryDirectionalDerivative,
    fieldDirectionalDerivative,
    gravityExteriorPrincipalContinuousBilinear,
    holonomicGravityAuxiliaryExteriorDerivative,
    pointwisePhysicalBivectorExteriorDerivative,
    holonomicGravityAuxiliaryJet] using
      gravityExteriorPrincipalSum_eq_w13
        (gravityAuxiliaryDirectionalDerivative configuration point)
        (variation point)

/-- Derivative-only arbitrary-`q` compact integration by parts.  Both sides
use the same actual auxiliary field.  This theorem is a geometric transporter,
not an action equation or a stationarity result. -/
theorem gravityTopologicalBF_loweredExteriorDerivative_integral_eq_w13
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (variation :
      CompactlySupportedSmoothVariation LorentzBivectorOneForm) :
    (∫ point : BasePoint,
      gravityTopologicalBFCoefficient
        (configuration.gravityAuxiliary point)
        (loweredLorentzBivectorExteriorDerivative variation point)) =
      ∫ point : BasePoint,
        lorentzOneFormThreeFormWedgeCoefficient (variation point)
          (holonomicGravityAuxiliaryExteriorDerivative configuration point) := by
  have auxiliarySmooth :
      ContDiff ℝ ∞ configuration.gravityAuxiliary :=
    holonomicGravityAuxiliary_contDiff configuration smooth
  have leftIntegrable : ∀ derivativeDirection : LorentzianIndex,
      Integrable fun point =>
        gravityExteriorPrincipalContinuousBilinear derivativeDirection
          (configuration.gravityAuxiliary point)
          (fderiv ℝ variation point
            (coordinateDirection derivativeDirection)) :=
    gravityExteriorPrincipal_left_integrable
      configuration.gravityAuxiliary auxiliarySmooth variation
  have rightIntegrable : ∀ derivativeDirection : LorentzianIndex,
      Integrable fun point =>
        gravityExteriorPrincipalContinuousBilinear derivativeDirection
          (fderiv ℝ configuration.gravityAuxiliary point
            (coordinateDirection derivativeDirection))
          (variation point) :=
    gravityExteriorPrincipal_right_integrable
      configuration.gravityAuxiliary auxiliarySmooth variation
  have ibp : ∀ derivativeDirection : LorentzianIndex,
      (∫ point : BasePoint,
        gravityExteriorPrincipalContinuousBilinear derivativeDirection
          (configuration.gravityAuxiliary point)
          (fderiv ℝ variation point
            (coordinateDirection derivativeDirection))) =
        -(∫ point : BasePoint,
          gravityExteriorPrincipalContinuousBilinear derivativeDirection
            (fderiv ℝ configuration.gravityAuxiliary point
              (coordinateDirection derivativeDirection))
            (variation point)) :=
    gravityExteriorPrincipal_integrationByParts
      configuration.gravityAuxiliary auxiliarySmooth variation
  calc
    (∫ point : BasePoint,
        gravityTopologicalBFCoefficient
          (configuration.gravityAuxiliary point)
          (loweredLorentzBivectorExteriorDerivative variation point)) =
      ∫ point : BasePoint,
        ∑ derivativeDirection : LorentzianIndex,
          gravityExteriorPrincipalContinuousBilinear derivativeDirection
            (configuration.gravityAuxiliary point)
            (fderiv ℝ variation point
              (coordinateDirection derivativeDirection)) := by
        apply integral_congr_ae
        filter_upwards [] with point
        simpa [fieldDirectionalDerivative] using
          gravityTopologicalBF_loweredExteriorDerivative_eq_principalSum
            (configuration.gravityAuxiliary point) variation point
    _ = ∑ derivativeDirection : LorentzianIndex,
        ∫ point : BasePoint,
          gravityExteriorPrincipalContinuousBilinear derivativeDirection
            (configuration.gravityAuxiliary point)
            (fderiv ℝ variation point
              (coordinateDirection derivativeDirection)) := by
      exact integral_finsetSum Finset.univ fun derivativeDirection _ =>
        leftIntegrable derivativeDirection
    _ = ∑ derivativeDirection : LorentzianIndex,
        -(∫ point : BasePoint,
          gravityExteriorPrincipalContinuousBilinear derivativeDirection
            (fderiv ℝ configuration.gravityAuxiliary point
              (coordinateDirection derivativeDirection))
            (variation point)) := by
      apply Finset.sum_congr rfl
      intro derivativeDirection _
      exact ibp derivativeDirection
    _ = -(∑ derivativeDirection : LorentzianIndex,
        ∫ point : BasePoint,
          gravityExteriorPrincipalContinuousBilinear derivativeDirection
            (fderiv ℝ configuration.gravityAuxiliary point
              (coordinateDirection derivativeDirection))
            (variation point)) := by
      rw [Finset.sum_neg_distrib]
    _ = -(∫ point : BasePoint,
        ∑ derivativeDirection : LorentzianIndex,
          gravityExteriorPrincipalContinuousBilinear derivativeDirection
            (fderiv ℝ configuration.gravityAuxiliary point
              (coordinateDirection derivativeDirection))
            (variation point)) := by
      rw [integral_finsetSum Finset.univ fun derivativeDirection _ =>
        rightIntegrable derivativeDirection]
    _ = ∫ point : BasePoint,
        -(∑ derivativeDirection : LorentzianIndex,
          gravityExteriorPrincipalContinuousBilinear derivativeDirection
            (fderiv ℝ configuration.gravityAuxiliary point
              (coordinateDirection derivativeDirection))
            (variation point)) := by
      rw [integral_neg]
    _ = ∫ point : BasePoint,
        lorentzOneFormThreeFormWedgeCoefficient (variation point)
          (holonomicGravityAuxiliaryExteriorDerivative configuration point) := by
      apply integral_congr_ae
      filter_upwards [] with point
      simpa [gravityAuxiliaryDirectionalDerivative,
        fieldDirectionalDerivative,
        gravityExteriorPrincipalContinuousBilinear,
        holonomicGravityAuxiliaryExteriorDerivative,
        pointwisePhysicalBivectorExteriorDerivative,
        holonomicGravityAuxiliaryJet] using
        gravityExteriorPrincipalSum_eq_w13
          (gravityAuxiliaryDirectionalDerivative configuration point)
          (variation point)

/-- Production-facing form: the derivative channel is the actual historical
lowered raw-curvature response generated by the primitive Lorentz path. -/
theorem gravityTopologicalBF_exteriorDerivativeVariation_integral_eq_w13
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (variation :
      CompactlySupportedSmoothVariation LorentzBivectorOneForm) :
    (∫ point : BasePoint,
      gravityTopologicalBFCoefficient
        (configuration.gravityAuxiliary point)
        (lorentzConnectionExteriorDerivativeVariation variation point)) =
      ∫ point : BasePoint,
        lorentzOneFormThreeFormWedgeCoefficient (variation point)
          (holonomicGravityAuxiliaryExteriorDerivative configuration point) := by
