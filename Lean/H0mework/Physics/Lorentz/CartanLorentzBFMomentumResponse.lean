import H0mework.Physics.Cartan.CartanTangentSimplicityResponse

/-!
# S9-C3h106: actual Cartan-path Lorentz BF-momentum response

C3h103/C3h105 already generate the actual coframe history `U`, its derived
`B := II⁺(U)`, and tangent simplicity.  This module now sends that same
history through the action-owned Lorentz connection variation:

```text
source/action
→ actual U and B := II⁺(U)
→ canonical spatial Lorentz variation q
→ d q through lorentzConnectionExteriorDerivativeDirection
→ lorentzConnectionBFDifferentialMomentum U (d q)
→ temporal action response.
```

For the full spatial Lorentz-bivector variation space, Lean proves

```text
M_U(point, q) = r(point)^8 * matchedBoostTrace(q),
r(point) = 1 + (x⁰)^2 / 2,
∂₀² M_U(0, q) = 8 * matchedBoostTrace(q).
```

The exponent is generated by the actual field: `abs(det U) = r^3`, while
the auxiliary/coframe/Hodge polynomial contributes `r^5`.  The universally
quantified direction is an action test variation, not a source parameter or
branch choice.  A fixed matched unit is exposed only as a downstream
coordinate readout.

This is an action-owned response/acceptance theorem for an already generated
actual `U`.  It does not invert the BF covector and uses no residual
coordinate, endpoint, preimage, right inverse, supplied certificate, source
knob, or branch receipt.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineCartanLorentzBFMomentumResponse

open ProofFreeRicherAnholonomicSource
open PointwiseDiracSpinConnectionLift
open StageNineCartanActionCoframeSecondJetLocalActualLift
open StageNineCartanTangentSimplicityResponse
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineGravityAuxiliaryVariation
open StageNineLorentzActionCanonicalPairUpdate
open StageNineLorentzConnectionMomentumRegularity
open StageNineLorentzConnectionPointwiseEquation
open StageNineLorentzConnectionVariation
open StageNineP286ActionCauchySplit
open StageNineP286ActionConnectionVelocity
open StageNineP286ActionVelocityLocalActualLift
open StageNineScalarActionSecondJetLocalActualLift
open scoped ContDiff

noncomputable section

set_option autoImplicit false

/-- The three action-matched temporal-spatial Lorentz coordinates. -/
def canonicalLorentzMatchedBoostTrace
    (direction : LorentzSpatialBivectorDirection) : ℝ :=
  ∑ spatial : Fin 3,
    direction spatial (temporalSpatialPair spatial)

def canonicalLorentzSpatialBFDifferentialMomentum
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint)
    (direction : LorentzSpatialBivectorDirection) : ℝ :=
  lorentzConnectionBFDifferentialMomentum
    configuration
    (lorentzConnectionExteriorDerivativeDirection
      canonicalLorentzianTimeDirection
      (canonicalLorentzSpatialBivectorOneForm direction))
    point

def positiveCartanCanonicalLorentzBFMomentum
    (point : BasePoint)
    (direction : LorentzSpatialBivectorDirection) : ℝ :=
  canonicalLorentzSpatialBFDifferentialMomentum
    positiveActionGeneratedCartanJointLocalActualLift point direction

set_option maxRecDepth 100000 in
set_option maxHeartbeats 1200000 in
theorem positiveCartanCanonicalLorentzBFMomentum_normalForm
    (point : BasePoint)
    (direction : LorentzSpatialBivectorDirection) :
    positiveCartanCanonicalLorentzBFMomentum point direction =
      positiveCartanRadialScale point ^ 8 *
        canonicalLorentzMatchedBoostTrace direction := by
  unfold positiveCartanCanonicalLorentzBFMomentum
    canonicalLorentzSpatialBFDifferentialMomentum
    lorentzConnectionBFDifferentialMomentum
    generatedVolumeDensity
  change
    |Matrix.det (positiveActionGeneratedCartanCoframeField point)| *
        gravityAuxiliaryHodgePairingPolynomial
          (positiveActionGeneratedCartanCoframeField point)
          (positiveActionGeneratedCartanGravityAuxiliaryField point)
          (lorentzConnectionExteriorDerivativeDirection
            canonicalLorentzianTimeDirection
            (canonicalLorentzSpatialBivectorOneForm direction)) =
      _
  rw [positiveActionGeneratedCartanCoframeField_det]
  rw [abs_of_pos (pow_pos (positiveCartanRadialScale_pos point) 3)]
  rw [positiveActionGeneratedCartanCoframeField_eq_normalForm]
  unfold positiveActionGeneratedCartanGravityAuxiliaryField
  rw [positiveActionGeneratedCartanCoframeField_eq_normalForm]
  have directionOne :
      Fin.cases (motive := fun _ : Fin 4 => Fin 6 → ℝ)
          0 direction (1 : Fin 4) =
        direction 0 := by
    rfl
  have directionTwo :
      Fin.cases (motive := fun _ : Fin 4 => Fin 6 → ℝ)
          0 direction (2 : Fin 4) =
        direction 1 := by
    rfl
  have directionThree :
      Fin.cases (motive := fun _ : Fin 4 => Fin 6 → ℝ)
          0 direction (3 : Fin 4) =
        direction 2 := by
    rfl
  simp [gravityAuxiliaryHodgePairingPolynomial,
    physicalIIPlusBivector, internalBivectorDual,
    positiveCartanCoframeNormalForm,
    coframeWedge, coframeTwoFormLinear,
    lorentzConnectionExteriorDerivativeDirection,
    canonicalLorentzSpatialBivectorOneForm,
    lorentzSkewConnectionOfBivectorOneForm,
    loweredLorentzBivectorMatrix,
    orientedLorentzBivectorBasisCoefficient,
    lorentzianCoframeHodge, lorentzianTwoFormSign,
    minkowskiInternalSign, pairFirst, pairSecond,
    canonicalLorentzianTimeDirection, temporalSpatialPair,
    Matrix.diagonal_apply,
    Fin.sum_univ_six, Fin.sum_univ_three,
    canonicalLorentzMatchedBoostTrace,
    directionOne, directionTwo, directionThree]
  ring

theorem positiveCartanCanonicalLorentzBFMomentum_timeDerivative
    (point : BasePoint)
    (direction : LorentzSpatialBivectorDirection) :
    fieldDirectionalDerivative
        (fun candidate =>
          positiveCartanCanonicalLorentzBFMomentum candidate direction)
        point canonicalLorentzianTimeDirection =
      8 * positiveCartanRadialScale point ^ 7 *
          point canonicalLorentzianTimeDirection *
        canonicalLorentzMatchedBoostTrace direction := by
  rw [show
    (fun candidate =>
      positiveCartanCanonicalLorentzBFMomentum candidate direction) =
      fun candidate =>
        positiveCartanRadialScale candidate ^ 8 *
          canonicalLorentzMatchedBoostTrace direction by
    funext candidate
    exact
      positiveCartanCanonicalLorentzBFMomentum_normalForm
        candidate direction]
  unfold fieldDirectionalDerivative positiveCartanRadialScale
  rw [
    (((scalarQuadraticTimeCoefficient_hasFDerivAt point).const_add 1).pow 8
      |>.mul_const (canonicalLorentzMatchedBoostTrace direction)
      |>.fderiv)]
  simp [coordinateDirection]
  ring

theorem positiveCartanCanonicalLorentzBFMomentum_secondTimeDerivative_origin
    (direction : LorentzSpatialBivectorDirection) :
    fieldDirectionalDerivative
        (fun point =>
          fieldDirectionalDerivative
            (fun candidate =>
              positiveCartanCanonicalLorentzBFMomentum candidate direction)
            point canonicalLorentzianTimeDirection)
        0 canonicalLorentzianTimeDirection =
      8 * canonicalLorentzMatchedBoostTrace direction := by
  rw [show
    (fun point =>
      fieldDirectionalDerivative
        (fun candidate =>
          positiveCartanCanonicalLorentzBFMomentum candidate direction)
        point canonicalLorentzianTimeDirection) =
      fun point =>
        ((8 * positiveCartanRadialScale point ^ 7) *
          localBaseCoordinate canonicalLorentzianTimeDirection point) *
            canonicalLorentzMatchedBoostTrace direction by
    funext point
    exact positiveCartanCanonicalLorentzBFMomentum_timeDerivative
      point direction]
  unfold fieldDirectionalDerivative
  have radialPowerDerivative :=
    (((scalarQuadraticTimeCoefficient_hasFDerivAt (0 : BasePoint)).const_add 1
      ).pow 7)
  have scaledRadialPowerDerivative :=
    radialPowerDerivative.const_mul 8
  have coordinateDerivative :=
    (localBaseCoordinate canonicalLorentzianTimeDirection).hasFDerivAt
      (x := (0 : BasePoint))
  have baseResponseDerivative :=
    scaledRadialPowerDerivative.mul coordinateDerivative
  have fullResponseDerivative :=
    baseResponseDerivative.mul_const
      (canonicalLorentzMatchedBoostTrace direction)
  unfold positiveCartanRadialScale
  change
    (fderiv ℝ
        (fun point =>
          ((((fun candidate : BasePoint =>
                8 * (1 + scalarQuadraticTimeCoefficient candidate) ^ 7) *
              fun candidate : BasePoint =>
                localBaseCoordinate canonicalLorentzianTimeDirection
                  candidate) : BasePoint → ℝ) point) *
              canonicalLorentzMatchedBoostTrace direction)
        0) (coordinateDirection canonicalLorentzianTimeDirection) =
      8 * canonicalLorentzMatchedBoostTrace direction
  rw [fullResponseDerivative.fderiv]
  simp [coordinateDirection]
  ring

/-- The complete first response expressed through the action-owned temporal
BF-momentum API, rather than through a residual covector. -/
theorem positiveCartanLorentzTemporalBFMomentumDerivative_normalForm
    (point : BasePoint)
    (direction : LorentzSpatialBivectorDirection) :
    lorentzConnectionTemporalBFMomentumDerivative
        positiveActionGeneratedCartanJointLocalActualLift
        (canonicalLorentzSpatialBivectorOneForm direction) point =
      8 * positiveCartanRadialScale point ^ 7 *
          point canonicalLorentzianTimeDirection *
        canonicalLorentzMatchedBoostTrace direction := by
  unfold lorentzConnectionTemporalBFMomentumDerivative
  change
    fieldDirectionalDerivative
        (fun candidate =>
          positiveCartanCanonicalLorentzBFMomentum candidate direction)
        point canonicalLorentzianTimeDirection =
      _
  exact
    positiveCartanCanonicalLorentzBFMomentum_timeDerivative point direction

theorem
    positiveCartanLorentzTemporalBFMomentumDerivative_timeResponse_origin
    (direction : LorentzSpatialBivectorDirection) :
    fieldDirectionalDerivative
        (lorentzConnectionTemporalBFMomentumDerivative
          positiveActionGeneratedCartanJointLocalActualLift
          (canonicalLorentzSpatialBivectorOneForm direction))
        0 canonicalLorentzianTimeDirection =
      8 * canonicalLorentzMatchedBoostTrace direction := by
  unfold lorentzConnectionTemporalBFMomentumDerivative
  exact
    positiveCartanCanonicalLorentzBFMomentum_secondTimeDerivative_origin
      direction

theorem positiveCartanCanonicalLorentzBFMomentum_contDiff
    (direction : LorentzSpatialBivectorDirection) :
    ContDiff ℝ ∞ (fun point =>
      positiveCartanCanonicalLorentzBFMomentum point direction) := by
  rw [show
    (fun point =>
      positiveCartanCanonicalLorentzBFMomentum point direction) =
      fun point =>
        positiveCartanRadialScale point ^ 8 *
          canonicalLorentzMatchedBoostTrace direction by
    funext point
    exact
      positiveCartanCanonicalLorentzBFMomentum_normalForm point direction]
  unfold positiveCartanRadialScale scalarQuadraticTimeCoefficient
  fun_prop

/-- The response law keeps the C3h105 actual path as provenance owner and
universally quantifies the complete action-variation space. -/
structure PositiveActionCartanLorentzBFMomentumResponseLaw
    (actual : StageNineHolonomicConfiguration) : Prop where
  actualPath :
    PositiveActionCartanTangentSimplicityResponseLaw actual
  fullMomentumResponse :
    ∀ point direction,
      canonicalLorentzSpatialBFDifferentialMomentum
          actual point direction =
        positiveCartanRadialScale point ^ 8 *
          canonicalLorentzMatchedBoostTrace direction

theorem
    positiveActionCartanLorentzBFMomentumResponse_realizes_C3h106 :
    PositiveActionCartanLorentzBFMomentumResponseLaw
      positiveActionGeneratedCartanJointLocalActualLift := by
  refine
    { actualPath :=
        positiveActionGeneratedCartanTangentSimplicityResponse_realizes_C3h105,
      fullMomentumResponse := ?_ }
  intro point direction
  exact
    positiveCartanCanonicalLorentzBFMomentum_normalForm point direction

/-- The fixed unit normalization in the first matched boost channel.  This is
a basis direction of the action variation space, not source data or a
continuous probe parameter. -/
def positiveCartanCanonicalUnitBoostDirection :
    LorentzSpatialBivectorDirection :=
  fun spatial internalPair =>
    if spatial = 0 then
      if internalPair = temporalSpatialPair 0 then 1 else 0
    else 0

theorem positiveCartanCanonicalUnitBoostDirection_matchedTrace :
    canonicalLorentzMatchedBoostTrace
        positiveCartanCanonicalUnitBoostDirection =
      1 := by
  unfold canonicalLorentzMatchedBoostTrace
  rw [Fin.sum_univ_three]
  simp [positiveCartanCanonicalUnitBoostDirection, temporalSpatialPair]

def positiveCartanCanonicalUnitBFMomentum
    (point : BasePoint) : ℝ :=
  positiveCartanCanonicalLorentzBFMomentum point
    positiveCartanCanonicalUnitBoostDirection

theorem positiveCartanCanonicalUnitBFMomentum_normalForm
    (point : BasePoint) :
    positiveCartanCanonicalUnitBFMomentum point =
      positiveCartanRadialScale point ^ 8 := by
  unfold positiveCartanCanonicalUnitBFMomentum
  rw [positiveCartanCanonicalLorentzBFMomentum_normalForm,
    positiveCartanCanonicalUnitBoostDirection_matchedTrace]
  ring

theorem positiveCartanCanonicalUnitBFMomentum_timeDerivative
    (point : BasePoint) :
    fieldDirectionalDerivative positiveCartanCanonicalUnitBFMomentum point
        canonicalLorentzianTimeDirection =
      8 * positiveCartanRadialScale point ^ 7 *
        point canonicalLorentzianTimeDirection := by
  change
    fieldDirectionalDerivative
        (fun candidate =>
          positiveCartanCanonicalLorentzBFMomentum candidate
            positiveCartanCanonicalUnitBoostDirection)
        point canonicalLorentzianTimeDirection =
      _
  simpa [positiveCartanCanonicalUnitBoostDirection_matchedTrace] using
    positiveCartanCanonicalLorentzBFMomentum_timeDerivative point
      positiveCartanCanonicalUnitBoostDirection

theorem positiveCartanCanonicalUnitBFMomentum_firstTimeDerivative_origin :
    fieldDirectionalDerivative positiveCartanCanonicalUnitBFMomentum 0
        canonicalLorentzianTimeDirection =
      0 := by
  rw [positiveCartanCanonicalUnitBFMomentum_timeDerivative]
  simp

theorem positiveCartanCanonicalUnitBFMomentum_secondTimeDerivative_origin :
    fieldDirectionalDerivative
        (fun point =>
          fieldDirectionalDerivative
            positiveCartanCanonicalUnitBFMomentum point
            canonicalLorentzianTimeDirection)
        0 canonicalLorentzianTimeDirection =
      8 := by
  change
    fieldDirectionalDerivative
        (fun point =>
          fieldDirectionalDerivative
            (fun candidate =>
              positiveCartanCanonicalLorentzBFMomentum candidate
                positiveCartanCanonicalUnitBoostDirection)
            point canonicalLorentzianTimeDirection)
        0 canonicalLorentzianTimeDirection =
      8
  simpa [positiveCartanCanonicalUnitBoostDirection_matchedTrace] using
    positiveCartanCanonicalLorentzBFMomentum_secondTimeDerivative_origin
      positiveCartanCanonicalUnitBoostDirection

end

end
