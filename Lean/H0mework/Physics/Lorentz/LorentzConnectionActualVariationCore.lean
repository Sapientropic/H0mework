import H0mework.Physics.Lorentz.LorentzConnectionVariation
import H0mework.Physics.Matter.MatterCovariantDerivativeAffine

/-!
# Dependency-light actual Lorentz-connection variation core

This module bundles the two derived jets generated by the primitive
Lorentz-skew path `omega + t * q`: the historical lowered gravity curvature
and the Dirac matter covariant derivative.  It is deliberately independent
of every historical or form-native action law.

The bundled point field is only a readout of the actual primitive path.  It
does not store curvature, a spin response, stationarity, or an equation back
into the source or holonomic configuration.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineLorentzConnectionActualVariationCore

open ProofFreeRicherAnholonomicSource
open StageNineEnrichedProofFreeSource
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineCompactSupportIntegrationByParts
open StageNineLorentzConnectionVariation
open StageNineMatterCovariantDerivativeAffine
open DiracExteriorMatterAction

noncomputable section

set_option autoImplicit false

/-- Readout helper for the two jets generated by one primitive Lorentz
connection variation. -/
def withLorentzConnectionJets
    (field : StageNineContinuumPointField)
    (gravityCurvature : PhysicalBivector)
    (matterDerivative : LorentzianIndex -> DiracExteriorMatterCarrier) :
    StageNineContinuumPointField :=
  { field with
    gravityCurvature := gravityCurvature
    matterCovariantDerivative := matterDerivative }

@[simp] theorem withLorentzConnectionJets_coframe
    (field : StageNineContinuumPointField)
    (gravityCurvature : PhysicalBivector)
    (matterDerivative : LorentzianIndex -> DiracExteriorMatterCarrier) :
    (withLorentzConnectionJets field gravityCurvature matterDerivative).coframe =
      field.coframe :=
  rfl

@[simp] theorem withLorentzConnectionJets_volume
    (field : StageNineContinuumPointField)
    (gravityCurvature : PhysicalBivector)
    (matterDerivative : LorentzianIndex -> DiracExteriorMatterCarrier) :
    generatedVolumeDensity
        (withLorentzConnectionJets field gravityCurvature matterDerivative) =
      generatedVolumeDensity field :=
  rfl

def variedLorentzCurvature
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint -> LorentzBivectorOneForm) (parameter : ℝ)
    (point : BasePoint) : PhysicalBivector :=
  holonomicGravityCurvature configuration point +
    parameter •
      lorentzConnectionLinearCurvatureVariation configuration variation point +
    parameter ^ 2 •
      lorentzConnectionQuadraticCurvatureVariation variation point

def variedLorentzMatterCovariantDerivative
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint -> LorentzBivectorOneForm) (parameter : ℝ)
    (point : BasePoint) :
    LorentzianIndex -> DiracExteriorMatterCarrier :=
  holonomicMatterCovariantDerivative configuration point +
    parameter •
      holonomicMatterLorentzConnectionVariation configuration variation point

/-- The bundled readout is exactly the continuum field generated by the
actual varied primitive connection.  The base configuration smoothness is
used to identify its derived curvature jet; no action premise appears. -/
theorem toContinuumPointField_varyLorentzConnection
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (variation : CompactlySupportedSmoothVariation LorentzBivectorOneForm)
    (parameter : ℝ) (point : BasePoint) :
    toContinuumPointField
        (varyLorentzConnection configuration variation parameter) point =
      withLorentzConnectionJets (toContinuumPointField configuration point)
        (variedLorentzCurvature configuration variation parameter point)
        (variedLorentzMatterCovariantDerivative configuration variation
          parameter point) := by
  apply StageNineContinuumPointField.ext
  all_goals try rfl
  · exact holonomicGravityCurvature_varyLorentzConnection
      configuration smooth variation parameter point
  · funext formDirection
    exact holonomicMatterCovariantDerivative_lorentzConnection_expansion
      configuration variation parameter point formDirection

/-- The formulation-neutral matter affine law specialized to the two-jet
readout.  The curvature argument is irrelevant to this coefficient and is
present only because the actual Lorentz path generates both jets together. -/
theorem generatedContinuumMatterDensity_withLorentzConnectionJets_affine
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (gravityCurvature : PhysicalBivector)
    (variation : LorentzianIndex -> DiracExteriorMatterCarrier)
    (parameter : ℝ) :
    generatedContinuumMatterDensity source chart point
        (withLorentzConnectionJets field gravityCurvature
          (field.matterCovariantDerivative + parameter • variation)) =
      generatedContinuumMatterDensity source chart point field +
        parameter * matterCovariantDerivativeFirstVariationDensity
          source chart point field variation := by
  simpa [withLorentzConnectionJets, withMatterCovariantDerivative,
    generatedContinuumMatterDensity, generatedContinuumMatterVector]
    using
      generatedContinuumMatterDensity_withMatterCovariantDerivative_affine
        source chart point field variation parameter

end

end
  SaturationMonoid.PhysicsCore.StageNineLorentzConnectionActualVariationCore
