import H0mework.Physics.Lorentz.LorentzGeometricFirstVariation
import H0mework.Physics.Dirac.MatterSpinThreeFormRegularity
import H0mework.Physics.Lorentz.TopologicalLorentzWeakEquation

/-!
# Form-native Lorentz pointwise equation

This module localizes the complete Lorentz response generated by the
form-native action.  The existing action derivative first becomes the W13
weak equation for the same Euler three-form; actual matter-spin regularity
then discharges the sole continuity premise of the formulation-neutral W13
fundamental lemma.

The resulting pointwise equation is an exact characterization of action
stationarity:

```text
D_omega B + S_spin = 0  iff  D_omega B = J_spin,
J_spin := -S_spin.
```

It does not construct a stationary configuration, solve torsion, consume an
equation receipt, or count as an independent Cauchy constraint.  The action
derivative remains the producer; localization and the final sign conversion
are faithful readout/transport steps.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineFormNativeLorentzPointwiseEquation

open ProofFreeRicherAnholonomicSource
open StageNineCompactSupportIntegrationByParts
open StageNineEnrichedProofFreeSource
open StageNineFormNativeLorentzConnectionIntegratedVariation
open StageNineFormNativeLorentzGeometricFirstVariation
open StageNineFormNativeLorentzGeometricKinematics
open StageNineFormNativeMatterSpinThreeFormRegularity
open StageNineFormNativeMotherAction
open StageNineGlobalIntegratedAction
open StageNineGravityBianchi
open StageNineHolonomicField
open StageNineLorentzConnectionVariation
open StageNineResidualLinearPlebanskiTorsionReduction
open StageNineTopologicalLorentzWeakEquation

noncomputable section

set_option autoImplicit false

/-! ## Complete residual continuity -/

theorem holonomicFormNativeLorentzEulerThreeForm_continuous
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate) :
    Continuous
      (holonomicFormNativeLorentzEulerThreeForm source 0 configuration) :=
  (holonomicGravityAuxiliaryExteriorCovariantDerivative_continuous
    configuration smooth).add
      (holonomicFormNativeMatterSpinThreeForm_continuous source configuration
        smooth nondegenerate)

/-! ## Action weak equation to W13 weak equation -/

theorem formNativeLorentzConnectionWeakEquation_iff_topological
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (admissible : GravityConnectionLorentzAdmissible configuration)
    (nondegenerate : configuration.Nondegenerate) :
    FormNativeLorentzConnectionWeakEquation source configuration ↔
      TopologicalLorentzWeakEquation
        (holonomicFormNativeLorentzEulerThreeForm source 0 configuration) := by
  constructor
  · intro actionWeak variation
    have firstCoefficientZero := actionWeak variation
    rw [holonomicFormNativeLorentzConnectionFirstVariation_integral_eq_w13
      source configuration smooth admissible nondegenerate variation] at firstCoefficientZero
    exact firstCoefficientZero
  · intro topologicalWeak variation
    have eulerPairingZero := topologicalWeak variation
    rw [← holonomicFormNativeLorentzConnectionFirstVariation_integral_eq_w13
      source configuration smooth admissible nondegenerate variation] at eulerPairingZero
    exact eulerPairingZero

/-- The action weak equation has the faithful pointwise Euler-three-form zero
fiber.  Continuity is generated from the actual primitive fields rather than
supplied as a receipt. -/
theorem formNativeLorentzConnectionWeakEquation_iff_eulerThreeForm_eq_zero
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (admissible : GravityConnectionLorentzAdmissible configuration)
    (nondegenerate : configuration.Nondegenerate) :
    FormNativeLorentzConnectionWeakEquation source configuration ↔
      holonomicFormNativeLorentzEulerThreeForm source 0 configuration = 0 := by
  rw [formNativeLorentzConnectionWeakEquation_iff_topological source
    configuration smooth admissible nondegenerate]
  exact topologicalLorentzWeakEquation_iff_residual_eq_zero
    (holonomicFormNativeLorentzEulerThreeForm source 0 configuration)
    (holonomicFormNativeLorentzEulerThreeForm_continuous source configuration
      smooth nondegenerate)

/-! ## Pointwise physical-current readout -/

def FormNativeLorentzConnectionPointwiseEquation
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration) : Prop :=
  ∀ point : BasePoint,
    holonomicGravityAuxiliaryExteriorCovariantDerivative configuration point =
      formNativePhysicalSpinCurrentThreeForm source 0 point
        (toContinuumPointField configuration point)

theorem holonomicFormNativeLorentzEulerThreeForm_eq_zero_iff_pointwiseEquation
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration) :
    holonomicFormNativeLorentzEulerThreeForm source 0 configuration = 0 ↔
      FormNativeLorentzConnectionPointwiseEquation source configuration := by
  constructor
  · intro residualZero point
    have pointZero := congrFun residualZero point
    exact
      (holonomicFormNativeLorentzEulerThreeForm_eq_zero_iff_current source 0
        configuration point).mp pointZero
  · intro pointwiseEquation
    funext point
    exact
      (holonomicFormNativeLorentzEulerThreeForm_eq_zero_iff_current source 0
        configuration point).mpr (pointwiseEquation point)

theorem formNativeLorentzConnectionWeakEquation_iff_pointwiseEquation
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (admissible : GravityConnectionLorentzAdmissible configuration)
    (nondegenerate : configuration.Nondegenerate) :
    FormNativeLorentzConnectionWeakEquation source configuration ↔
      FormNativeLorentzConnectionPointwiseEquation source configuration := by
  rw [formNativeLorentzConnectionWeakEquation_iff_eulerThreeForm_eq_zero source
    configuration smooth admissible nondegenerate]
  exact
    holonomicFormNativeLorentzEulerThreeForm_eq_zero_iff_pointwiseEquation
      source configuration

/-- Final action-derived characterization.  This theorem does not assert
that the supplied configuration is stationary; it states exactly what
stationarity means for the authoritative form-native Lorentz path family. -/
theorem formNativeLorentzConnectionActionStationary_iff_pointwiseEquation
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (admissible : GravityConnectionLorentzAdmissible configuration)
    (nondegenerate : configuration.Nondegenerate)
    (densityIntegrable :
      FormNativeHolonomicLocalDensityIntegrable source 0 configuration) :
    FormNativeLorentzConnectionActionStationary source configuration ↔
      FormNativeLorentzConnectionPointwiseEquation source configuration := by
  rw [formNativeLorentzConnectionActionStationary_iff_weakEquation source
    configuration smooth nondegenerate densityIntegrable]
  exact formNativeLorentzConnectionWeakEquation_iff_pointwiseEquation source
    configuration smooth admissible nondegenerate

end

end
  SaturationMonoid.PhysicsCore.StageNineFormNativeLorentzPointwiseEquation
