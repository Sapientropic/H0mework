/-!
# Form-native Lorentz geometric first variation

This module composes the three contributions generated by one actual
Lorentz-connection path:

```text
exterior curvature response + algebraic connection response + matter spin
  -> integral W13(q, D_omega B + S_spin).
```

The exterior term is moved by the compact-support integration-by-parts
theorem.  The algebraic term is identified with the connection-action part of
`D_omega B`, and the pointwise matter dual supplies its unique action-signed
three-form.  All three channels use the same configuration, point, and
variation.

This is an action-provenance and geometric representation theorem.  It does
not assume or prove stationarity, a weak equation, a pointwise Euler--Lagrange
equation, torsion closure, or an Einstein--Cartan solution.  Nondegeneracy is
used only through the existing integrability theorem for the complete local
first coefficient; it is not used by either topological pairing identity.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineFormNativeLorentzGeometricFirstVariation

open MeasureTheory
open ProofFreeRicherAnholonomicSource
open StageNineCompactSupportIntegrationByParts
open StageNineEnrichedProofFreeSource
open StageNineFormNativeLorentzConnectionIntegratedVariation
open StageNineFormNativeLorentzConnectionLocalVariation
open StageNineFormNativeLorentzDerivativeIntegrationByParts
open StageNineFormNativeLorentzGeometricKinematics
open StageNineFormNativeMatterSpinThreeForm
open StageNineFormNativeMotherAction
open StageNineGlobalIntegratedAction
open StageNineGravityBianchi
open StageNineHolonomicField
open StageNineLorentzConnectionVariation
open StageNineResidualLinearPlebanskiTorsionReduction
open StageNineTopologicalGravityCurvatureVariancePairing
open StageNineTopologicalLorentzThreeFormDuality

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 800000

/-! ## Same-actual pointwise decomposition -/

/-- Algebraic gravity and matter contribution left after the exterior
curvature channel has been separated. -/
def holonomicFormNativeLorentzAlgebraicMatterFirstDensity
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → LorentzBivectorOneForm)
    (point : BasePoint) : ℝ :=
  lorentzOneFormThreeFormWedgeCoefficient (variation point)
    (pointwisePhysicalBivectorConnectionExteriorAction
        (configuration.gravityConnection point)
        (configuration.gravityAuxiliary point) +
      formNativeMatterSpinThreeForm source chart point
        (toContinuumPointField configuration point))

/-- The local action coefficient is the actual exterior BF response plus the
W13 representation of its algebraic-gravity and matter channels. -/
theorem holonomicFormNativeLorentzConnectionFirstVariationDensity_eq_parts
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (configuration : StageNineHolonomicConfiguration)
    (admissible : GravityConnectionLorentzAdmissible configuration)
    (variation : BasePoint → LorentzBivectorOneForm)
    (point : BasePoint) :
    holonomicFormNativeLorentzConnectionFirstVariationDensity source chart
        configuration variation point =
      gravityTopologicalBFCoefficient
          (configuration.gravityAuxiliary point)
          (lorentzConnectionExteriorDerivativeVariation variation point) +
        holonomicFormNativeLorentzAlgebraicMatterFirstDensity source chart
          configuration variation point := by
  rw [holonomicFormNativeLorentzConnectionFirstVariationDensity_eq,
    lorentzConnectionLinearCurvatureVariation_eq_parts,
    gravityTopologicalBFCoefficient_add_right]
  have algebraicVariation :
      lorentzConnectionAlgebraicCurvatureVariation configuration variation
          point =
        lorentzConnectionAlgebraicCurvatureDirection configuration
          (variation point) point :=
    rfl
  rw [algebraicVariation,
    gravityTopologicalBF_algebraicCurvatureDirection_eq_w13
      configuration admissible point (variation point)]
  unfold holonomicFormNativeLorentzAlgebraicMatterFirstDensity
  rw [lorentzOneFormThreeFormWedgeCoefficient_add_right]
  rw [← formNativeMatterSpinThreeForm_evaluation source chart point
    (toContinuumPointField configuration point) (variation point)]
  simp only [lorentzThreeFormWedgeContinuousDual_apply]
  ring

/-! ## Integrability of the complementary channel -/

/-- The algebraic-plus-matter channel is integrable because the complete
action coefficient and the separately generated exterior BF channel are both
integrable.  `Nondegenerate` enters only through the former existing analytic
receipt. -/
theorem holonomicFormNativeLorentzAlgebraicMatterFirstDensity_integrable
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (admissible : GravityConnectionLorentzAdmissible configuration)
    (nondegenerate : configuration.Nondegenerate)
    (variation :
      CompactlySupportedSmoothVariation LorentzBivectorOneForm) :
    Integrable
      (holonomicFormNativeLorentzAlgebraicMatterFirstDensity source 0
        configuration variation) := by
  have completeIntegrable :=
    holonomicFormNativeLorentzConnectionFirstVariationDensity_integrable
      source configuration smooth nondegenerate variation
  have exteriorIntegrable :=
    gravityTopologicalBF_exteriorDerivativeVariation_integrable
      configuration smooth variation
  have differenceIntegrable : Integrable fun point : BasePoint =>
      holonomicFormNativeLorentzConnectionFirstVariationDensity source 0
          configuration variation point -
        gravityTopologicalBFCoefficient
          (configuration.gravityAuxiliary point)
          (lorentzConnectionExteriorDerivativeVariation variation point) :=
    completeIntegrable.sub exteriorIntegrable
  refine differenceIntegrable.congr ?_
  filter_upwards [] with point
  rw [holonomicFormNativeLorentzConnectionFirstVariationDensity_eq_parts
    source 0 configuration admissible variation point]
  ring

/-! ## Complete integrated geometric representation -/

/-- Action-signed Lorentz Euler three-form on the same actual configuration.
It is derived from the live geometric covariant derivative and the unique
matter dual; it is not a source field or a stored equation receipt. -/
def holonomicFormNativeLorentzEulerThreeForm
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) : PhysicalBivectorThreeForm :=
  holonomicGravityAuxiliaryExteriorCovariantDerivative configuration point +
    formNativeMatterSpinThreeForm source chart point
      (toContinuumPointField configuration point)

/-- Complete same-actual first coefficient in geometric W13 form. -/
theorem holonomicFormNativeLorentzConnectionFirstVariation_integral_eq_w13
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (admissible : GravityConnectionLorentzAdmissible configuration)
    (nondegenerate : configuration.Nondegenerate)
    (variation :
      CompactlySupportedSmoothVariation LorentzBivectorOneForm) :
    (∫ point : BasePoint,
      holonomicFormNativeLorentzConnectionFirstVariationDensity source 0
        configuration variation point) =
      ∫ point : BasePoint,
        lorentzOneFormThreeFormWedgeCoefficient (variation point)
          (holonomicFormNativeLorentzEulerThreeForm source 0 configuration
            point) := by
  have exteriorIntegrable :=
    gravityTopologicalBF_exteriorDerivativeVariation_integrable
      configuration smooth variation
  have derivativeWedgeIntegrable :=
    lorentzWedge_holonomicGravityAuxiliaryExteriorDerivative_integrable
      configuration smooth variation
  have remainderIntegrable :=
    holonomicFormNativeLorentzAlgebraicMatterFirstDensity_integrable
      source configuration smooth admissible nondegenerate variation
  calc
    (∫ point : BasePoint,
        holonomicFormNativeLorentzConnectionFirstVariationDensity source 0
          configuration variation point) =
      ∫ point : BasePoint,
        gravityTopologicalBFCoefficient
            (configuration.gravityAuxiliary point)
            (lorentzConnectionExteriorDerivativeVariation variation point) +
          holonomicFormNativeLorentzAlgebraicMatterFirstDensity source 0
            configuration variation point := by
      apply integral_congr_ae
      filter_upwards [] with point
      exact
        holonomicFormNativeLorentzConnectionFirstVariationDensity_eq_parts
          source 0 configuration admissible variation point
    _ = (∫ point : BasePoint,
          gravityTopologicalBFCoefficient
            (configuration.gravityAuxiliary point)
            (lorentzConnectionExteriorDerivativeVariation variation point)) +
        ∫ point : BasePoint,
          holonomicFormNativeLorentzAlgebraicMatterFirstDensity source 0
            configuration variation point := by
      exact integral_add exteriorIntegrable remainderIntegrable
    _ = (∫ point : BasePoint,
          lorentzOneFormThreeFormWedgeCoefficient (variation point)
            (holonomicGravityAuxiliaryExteriorDerivative configuration
              point)) +
        ∫ point : BasePoint,
          holonomicFormNativeLorentzAlgebraicMatterFirstDensity source 0
            configuration variation point := by
      rw [gravityTopologicalBF_exteriorDerivativeVariation_integral_eq_w13
        configuration smooth variation]
    _ = ∫ point : BasePoint,
        lorentzOneFormThreeFormWedgeCoefficient (variation point)
            (holonomicGravityAuxiliaryExteriorDerivative configuration
              point) +
          holonomicFormNativeLorentzAlgebraicMatterFirstDensity source 0
            configuration variation point := by
      exact (integral_add derivativeWedgeIntegrable remainderIntegrable).symm
    _ = ∫ point : BasePoint,
        lorentzOneFormThreeFormWedgeCoefficient (variation point)
          (holonomicFormNativeLorentzEulerThreeForm source 0 configuration
            point) := by
      apply integral_congr_ae
      filter_upwards [] with point
      unfold holonomicFormNativeLorentzAlgebraicMatterFirstDensity
        holonomicFormNativeLorentzEulerThreeForm
      rw [holonomicGravityAuxiliaryExteriorCovariantDerivative_eq_parts]
      simp only [lorentzOneFormThreeFormWedgeCoefficient_add_right]
      ring

/-! ## Action provenance and physical-current convention -/

/-- The active form-native candidate's integrated action derivative is exactly the W13 pairing with
the generated Euler three-form.  This remains producer consistency; it is not
an independently imposed constraint. -/
theorem holonomicFormNativeIntegratedUnifiedAction_lorentzConnection_hasDerivAt_w13
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (admissible : GravityConnectionLorentzAdmissible configuration)
    (nondegenerate : configuration.Nondegenerate)
    (densityIntegrable :
      FormNativeHolonomicLocalDensityIntegrable source 0 configuration)
    (variation :
      CompactlySupportedSmoothVariation LorentzBivectorOneForm) :
    HasDerivAt
      (fun parameter => holonomicFormNativeIntegratedUnifiedAction source 0
        (varyLorentzConnection configuration variation parameter))
      (∫ point : BasePoint,
        lorentzOneFormThreeFormWedgeCoefficient (variation point)
          (holonomicFormNativeLorentzEulerThreeForm source 0 configuration
            point)) 0 := by
  have actionDerivative :=
    holonomicFormNativeIntegratedUnifiedAction_lorentzConnection_hasDerivAt
      source configuration smooth nondegenerate densityIntegrable variation
  rw [holonomicFormNativeLorentzConnectionFirstVariation_integral_eq_w13
    source configuration smooth admissible nondegenerate variation] at actionDerivative
  exact actionDerivative

/-- Physical spin-current convention fixed only after the complete action
variation has determined the relative sign. -/
def formNativePhysicalSpinCurrentThreeForm
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField) :
    PhysicalBivectorThreeForm :=
  -formNativeMatterSpinThreeForm source chart point field

/-- The action-signed zero equation is exactly `D_omega B = J_spin` under the
now-frozen physical-current convention.  This theorem does not assert that
either side holds on an arbitrary configuration. -/
theorem holonomicFormNativeLorentzEulerThreeForm_eq_zero_iff_current
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    holonomicFormNativeLorentzEulerThreeForm source chart configuration point =
        0 ↔
      holonomicGravityAuxiliaryExteriorCovariantDerivative configuration
          point =
        formNativePhysicalSpinCurrentThreeForm source chart point
          (toContinuumPointField configuration point) := by
  unfold holonomicFormNativeLorentzEulerThreeForm
    formNativePhysicalSpinCurrentThreeForm
  constructor <;> intro equality
  · exact eq_neg_of_add_eq_zero_left equality
  · exact add_eq_zero_iff_eq_neg.mpr equality

end

end
  SaturationMonoid.PhysicsCore.StageNineFormNativeLorentzGeometricFirstVariation
