import H0mework.Physics.Geometry.TopologicalFourFormPairing
import H0mework.Physics.Cartan.ResidualLinearPlebanskiTorsionReduction

/-!
# Topological Lorentz one-form--three-form duality

This module fixes the canonical coordinate duality between a lowered Lorentz
bivector-valued one-form and a contravariant Lorentz bivector-valued
three-form.  The spacetime orientation is `epsilon_0123 = +1`; hence

`dx^mu wedge dx^(missing mu) = (+,-,+,-)_mu d^4x`.

Lowered and contravariant internal bivector coordinates contract directly.
No internal metric sign, variance selector, orientation selector, action,
equation, source, volume density, or field certificate enters the map.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineTopologicalLorentzThreeFormDuality

open StageNineLorentzConnectionVariation
open StageNineResidualLinearPlebanskiTorsionReduction
open StageNineTopologicalFourFormPairing

noncomputable section

set_option autoImplicit false

/-- In the three-form order `(012,013,023,123)`, the triple complementary to
the one-form direction `(0,1,2,3)` has index `(3,2,1,0)`. -/
def missingTripleOfOneForm : LorentzianIndex → Fin 4 := ![3, 2, 1, 0]

@[simp] theorem missingTripleOfOneForm_involutive
    (direction : LorentzianIndex) :
    missingTripleOfOneForm (missingTripleOfOneForm direction) = direction := by
  fin_cases direction <;> rfl

/-- Orientation sign of `dx^mu wedge dx^(missing mu)` for
`epsilon_0123 = +1`. -/
def oneWedgeThreeSign : LorentzianIndex → ℝ := ![1, -1, 1, -1]

theorem oneWedgeThreeSign_ne_zero (direction : LorentzianIndex) :
    oneWedgeThreeSign direction ≠ 0 := by
  fin_cases direction <;> norm_num [oneWedgeThreeSign]

@[simp] theorem oneWedgeThreeSign_square (direction : LorentzianIndex) :
    oneWedgeThreeSign direction * oneWedgeThreeSign direction = 1 := by
  fin_cases direction <;> norm_num [oneWedgeThreeSign]

/-- Metric-free coefficient of `q wedge H`.  The Lorentz bivector one-form
`q` is lowered and the three-form `H` is contravariant, so their internal-pair
contraction carries no additional Lorentz sign. -/
def lorentzOneFormThreeFormWedgeCoefficient
    (oneForm : LorentzBivectorOneForm)
    (threeForm : PhysicalBivectorThreeForm) : ℝ :=
  ∑ direction : LorentzianIndex,
    ∑ internalPair : Fin 6,
      oneWedgeThreeSign direction * oneForm direction internalPair *
        threeForm internalPair (missingTripleOfOneForm direction)

theorem lorentzOneFormThreeFormWedgeCoefficient_add_left
    (first second : LorentzBivectorOneForm)
    (threeForm : PhysicalBivectorThreeForm) :
    lorentzOneFormThreeFormWedgeCoefficient (first + second) threeForm =
      lorentzOneFormThreeFormWedgeCoefficient first threeForm +
        lorentzOneFormThreeFormWedgeCoefficient second threeForm := by
  unfold lorentzOneFormThreeFormWedgeCoefficient
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro direction _
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro internalPair _
  simp only [Pi.add_apply]
  ring

theorem lorentzOneFormThreeFormWedgeCoefficient_smul_left
    (parameter : ℝ) (oneForm : LorentzBivectorOneForm)
    (threeForm : PhysicalBivectorThreeForm) :
    lorentzOneFormThreeFormWedgeCoefficient (parameter • oneForm) threeForm =
      parameter *
        lorentzOneFormThreeFormWedgeCoefficient oneForm threeForm := by
  unfold lorentzOneFormThreeFormWedgeCoefficient
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro direction _
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro internalPair _
  simp only [Pi.smul_apply, smul_eq_mul]
  ring

theorem lorentzOneFormThreeFormWedgeCoefficient_add_right
    (oneForm : LorentzBivectorOneForm)
    (first second : PhysicalBivectorThreeForm) :
    lorentzOneFormThreeFormWedgeCoefficient oneForm (first + second) =
      lorentzOneFormThreeFormWedgeCoefficient oneForm first +
        lorentzOneFormThreeFormWedgeCoefficient oneForm second := by
  unfold lorentzOneFormThreeFormWedgeCoefficient
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro direction _
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro internalPair _
  simp only [Pi.add_apply]
  ring

theorem lorentzOneFormThreeFormWedgeCoefficient_smul_right
    (parameter : ℝ) (oneForm : LorentzBivectorOneForm)
    (threeForm : PhysicalBivectorThreeForm) :
    lorentzOneFormThreeFormWedgeCoefficient oneForm
        (parameter • threeForm) =
      parameter *
        lorentzOneFormThreeFormWedgeCoefficient oneForm threeForm := by
  unfold lorentzOneFormThreeFormWedgeCoefficient
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro direction _
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro internalPair _
  simp only [Pi.smul_apply, smul_eq_mul]
  ring

/-- Algebraic one-form dual generated by a contravariant three-form. -/
def lorentzThreeFormWedgeLinearDual
    (threeForm : PhysicalBivectorThreeForm) :
    LorentzBivectorOneForm →ₗ[ℝ] ℝ where
  toFun := fun oneForm =>
    lorentzOneFormThreeFormWedgeCoefficient oneForm threeForm
  map_add' := fun first second =>
    lorentzOneFormThreeFormWedgeCoefficient_add_left first second threeForm
  map_smul' := by
    intro parameter oneForm
    simpa only [RingHom.id_apply, smul_eq_mul] using
      lorentzOneFormThreeFormWedgeCoefficient_smul_left parameter oneForm
        threeForm

/-- Canonical continuous-linear `q wedge H` dual.  Continuity is derived from
the finite 24-dimensional one-form carrier, not supplied as data. -/
def lorentzThreeFormWedgeContinuousDual
    (threeForm : PhysicalBivectorThreeForm) :
    LorentzBivectorOneForm →L[ℝ] ℝ where
  toLinearMap := lorentzThreeFormWedgeLinearDual threeForm
  cont :=
    (lorentzThreeFormWedgeLinearDual threeForm)
      |>.continuous_of_finiteDimensional

@[simp] theorem lorentzThreeFormWedgeContinuousDual_apply
    (threeForm : PhysicalBivectorThreeForm)
    (oneForm : LorentzBivectorOneForm) :
    lorentzThreeFormWedgeContinuousDual threeForm oneForm =
      lorentzOneFormThreeFormWedgeCoefficient oneForm threeForm :=
  rfl

/-- Canonical coordinate one-form in the lowered internal-pair carrier. -/
def loweredLorentzBivectorOneFormCoordinate
    (direction : LorentzianIndex) (internalPair : Fin 6) :
    LorentzBivectorOneForm :=
  Pi.single direction (Pi.single internalPair 1)

/-- Evaluation on a coordinate one-form reads exactly the complementary
three-form coordinate with the fixed wedge sign. -/
@[simp] theorem lorentzThreeFormWedgeContinuousDual_coordinate_apply
    (threeForm : PhysicalBivectorThreeForm)
    (direction : LorentzianIndex) (internalPair : Fin 6) :
    lorentzThreeFormWedgeContinuousDual threeForm
        (loweredLorentzBivectorOneFormCoordinate direction internalPair) =
      oneWedgeThreeSign direction *
        threeForm internalPair (missingTripleOfOneForm direction) := by
  classical
  fin_cases direction <;> fin_cases internalPair <;>
    simp [lorentzThreeFormWedgeContinuousDual,
      lorentzThreeFormWedgeLinearDual,
      lorentzOneFormThreeFormWedgeCoefficient,
      loweredLorentzBivectorOneFormCoordinate,
      missingTripleOfOneForm, oneWedgeThreeSign,
      Fin.sum_univ_four, Fin.sum_univ_six]

/-- The topological one-form dual has a faithful zero fiber. -/
theorem lorentzThreeFormWedgeContinuousDual_eq_zero_iff
    (threeForm : PhysicalBivectorThreeForm) :
    lorentzThreeFormWedgeContinuousDual threeForm = 0 ↔ threeForm = 0 := by
  constructor
  · intro dualZero
    funext internalPair triple
    let direction : LorentzianIndex := missingTripleOfOneForm triple
    have evaluated := congrArg
      (fun dual : LorentzBivectorOneForm →L[ℝ] ℝ =>
        dual (loweredLorentzBivectorOneFormCoordinate direction internalPair))
      dualZero
    change
      lorentzThreeFormWedgeContinuousDual threeForm
          (loweredLorentzBivectorOneFormCoordinate direction internalPair) = 0
      at evaluated
    rw [lorentzThreeFormWedgeContinuousDual_coordinate_apply] at evaluated
    have coordinateZero :
        oneWedgeThreeSign direction * threeForm internalPair triple = 0 := by
      rw [show missingTripleOfOneForm direction = triple by
        simp [direction]] at evaluated
      exact evaluated
    exact (mul_eq_zero.mp coordinateZero).resolve_left
      (oneWedgeThreeSign_ne_zero direction)
  · rintro rfl
    ext oneForm
    simp [lorentzThreeFormWedgeContinuousDual,
      lorentzThreeFormWedgeLinearDual,
      lorentzOneFormThreeFormWedgeCoefficient]

/-- Equivalently, nonzero three-form responsibility cannot disappear in the
continuous dual. -/
theorem lorentzThreeFormWedgeContinuousDual_ne_zero_iff
    (threeForm : PhysicalBivectorThreeForm) :
    lorentzThreeFormWedgeContinuousDual threeForm ≠ 0 ↔ threeForm ≠ 0 := by
  rw [ne_eq, ne_eq,
    not_congr (lorentzThreeFormWedgeContinuousDual_eq_zero_iff threeForm)]

end

end
  SaturationMonoid.PhysicsCore.StageNineTopologicalLorentzThreeFormDuality
