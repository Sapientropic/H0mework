/-!
# Local form-native Lorentz-connection variation

The primitive Lorentz-skew path generates the historical lowered curvature
polynomial `F_raw + t L_raw + t^2 Q_raw` and the affine Dirac covariant-
derivative jet.  This module substitutes those actual jets into the corrected
form-native mother action.

The gravity coefficient is

`W22(B, N(L_raw))`,

where COV-1 is applied exactly once inside
`gravityTopologicalBFCoefficient`.  It is not multiplied by the coordinate
volume density.  The separate matter coefficient is multiplied by the live
`generatedVolumeDensity`, exactly as in the authoritative mother action.

No historical gravity action, action derivative, weak equation, momentum,
stationarity certificate, residual, or fixed actual is imported or reused.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineFormNativeLorentzConnectionLocalVariation

open EmpiricalReferenceScaleCouplingBoundary
open ProofFreeRicherAnholonomicSource
open StageNineEnrichedProofFreeSource
open StageNineFormNativeMotherAction
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineLorentzConnectionActualVariationCore
open StageNineLorentzConnectionVariation
open StageNineMatterCovariantDerivativeAffine
open StageNineTopologicalFourFormPairing
open StageNineTopologicalGravityCurvatureVariancePairing
open StageNineHolonomicGravityCurvatureVarianceNormalization
open StageNineCompactSupportIntegrationByParts
open DiracExteriorMatterAction

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 600000

/-! ## Pure W22 curvature polynomial -/

theorem gravityTopologicalBFCoefficient_curvature_quadratic
    (auxiliary curvature linear quadratic : PhysicalBivector)
    (parameter : ℝ) :
    gravityTopologicalBFCoefficient auxiliary
        (curvature + parameter • linear + parameter ^ 2 • quadratic) =
      gravityTopologicalBFCoefficient auxiliary curvature +
        parameter * gravityTopologicalBFCoefficient auxiliary linear +
        parameter ^ 2 * gravityTopologicalBFCoefficient auxiliary quadratic := by
  unfold gravityTopologicalBFCoefficient
  rw [map_add, map_add, map_smul, map_smul]
  rw [gravityTopologicalWedgeCoefficient_add_right,
    gravityTopologicalWedgeCoefficient_add_right,
    gravityTopologicalWedgeCoefficient_smul_right,
    gravityTopologicalWedgeCoefficient_smul_right]

/-- The corrected gravity BF/constitutive block along a generated two-jet.
Only the BF term changes; the internal constitutive term is independent of
the primitive connection. -/
theorem generatedFormNativeGravityBFDensity_withLorentzConnectionJets_quadratic
    (field : StageNineContinuumPointField)
    (linear quadratic : PhysicalBivector) (parameter : ℝ) :
    ∀ matterDerivative : LorentzianIndex -> DiracExteriorMatterCarrier,
    generatedFormNativeGravityBFDensity
        (withLorentzConnectionJets field
          (field.gravityCurvature + parameter • linear +
            parameter ^ 2 • quadratic)
          matterDerivative) =
      generatedFormNativeGravityBFDensity field +
        parameter *
          gravityTopologicalBFCoefficient field.gravityAuxiliary linear +
        parameter ^ 2 *
          gravityTopologicalBFCoefficient field.gravityAuxiliary quadratic := by
  intro matterDerivative
  unfold generatedFormNativeGravityBFDensity
  change
    gravityTopologicalBFCoefficient field.gravityAuxiliary
          (field.gravityCurvature + parameter • linear +
            parameter ^ 2 • quadratic) -
        (1 / 2 : ℝ) *
          gravityTopologicalWedgeCoefficient field.gravityAuxiliary
            (StageNineBlockwiseConstitutive.gravityInternalDualEquiv
              field.gravityAuxiliary) = _
  rw [gravityTopologicalBFCoefficient_curvature_quadratic]
  ring

/-! ## Matter and full local coefficient -/

/-- Full first coefficient generated by the same actual Lorentz path.  The
topological gravity term and the component matter density retain their
distinct density weights. -/
def formNativeLorentzConnectionFirstVariationDensity
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (curvatureVariation : PhysicalBivector)
    (matterVariation : LorentzianIndex -> DiracExteriorMatterCarrier) : ℝ :=
  gravityTopologicalBFCoefficient field.gravityAuxiliary curvatureVariation +
    generatedVolumeDensity field *
      matterCovariantDerivativeFirstVariationDensity source chart point field
        matterVariation

/-- The second coefficient is purely the non-Abelian gravity-curvature
channel.  Matter is affine in its connection-generated derivative jet. -/
def formNativeLorentzConnectionSecondVariationDensity
    (field : StageNineContinuumPointField)
    (curvatureVariation : PhysicalBivector) : ℝ :=
  gravityTopologicalBFCoefficient field.gravityAuxiliary curvatureVariation

theorem generatedFormNativeMatterDensity_withLorentzConnectionJets_affine
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (gravityCurvature : PhysicalBivector)
    (variation : LorentzianIndex -> DiracExteriorMatterCarrier)
    (parameter : ℝ) :
    generatedFormNativeMatterDensity source chart point
        (withLorentzConnectionJets field gravityCurvature
          (field.matterCovariantDerivative + parameter • variation)) =
      generatedFormNativeMatterDensity source chart point field +
        parameter *
          (generatedVolumeDensity field *
            matterCovariantDerivativeFirstVariationDensity source chart point
              field variation) := by
  unfold generatedFormNativeMatterDensity
  change
    generatedVolumeDensity field *
        (generatedScalarKineticDensity source chart point field -
          StageNineDynamicBreakingVacuum.generatedScalarPotential source chart
            point field.scalar +
          generatedContinuumMatterDensity source chart point
            (withLorentzConnectionJets field gravityCurvature
              (field.matterCovariantDerivative + parameter • variation))) = _
  rw [generatedContinuumMatterDensity_withLorentzConnectionJets_affine]
  ring

/-- Exact local polynomial for the authoritative form-native action at an
explicit coupling boundary.  The connection path changes neither the live
coframe, auxiliary/multiplier fields, gauge blocks, scalar, nor matter value. -/
theorem generatedFormNativeUnifiedLocalDensity_lorentzConnectionJets_quadratic
    (source : SmoothUnifiedSource)
    (boundary : EmpiricalReferenceScaleCouplings)
    (chart : StageNineChart) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (linearCurvature quadraticCurvature : PhysicalBivector)
    (matterVariation : LorentzianIndex -> DiracExteriorMatterCarrier)
    (parameter : ℝ) :
    generatedFormNativeUnifiedLocalDensityAtBoundary source boundary chart point
        (withLorentzConnectionJets field
          (field.gravityCurvature + parameter • linearCurvature +
            parameter ^ 2 • quadraticCurvature)
          (field.matterCovariantDerivative + parameter • matterVariation)) =
      generatedFormNativeUnifiedLocalDensityAtBoundary source boundary chart
          point field +
        parameter *
          formNativeLorentzConnectionFirstVariationDensity source chart point
            field linearCurvature matterVariation +
        parameter ^ 2 *
          formNativeLorentzConnectionSecondVariationDensity field
            quadraticCurvature := by
  unfold generatedFormNativeUnifiedLocalDensityAtBoundary
  have gravityExpansion :=
    generatedFormNativeGravityBFDensity_withLorentzConnectionJets_quadratic
      field linearCurvature quadraticCurvature parameter
      (field.matterCovariantDerivative + parameter • matterVariation)
  have matterExpansion :=
    generatedFormNativeMatterDensity_withLorentzConnectionJets_affine source
      chart point field
      (field.gravityCurvature + parameter • linearCurvature +
        parameter ^ 2 • quadraticCurvature)
      matterVariation parameter
  have constraintReadout :
      generatedFormNativeGravityConstraintDensity
          (withLorentzConnectionJets field
            (field.gravityCurvature + parameter • linearCurvature +
              parameter ^ 2 • quadraticCurvature)
            (field.matterCovariantDerivative + parameter • matterVariation)) =
        generatedFormNativeGravityConstraintDensity field :=
    rfl
  have gaugeReadout :
      generatedFormNativeGaugeDensityAtBoundary boundary
          (withLorentzConnectionJets field
            (field.gravityCurvature + parameter • linearCurvature +
              parameter ^ 2 • quadraticCurvature)
            (field.matterCovariantDerivative + parameter • matterVariation)) =
        generatedFormNativeGaugeDensityAtBoundary boundary field :=
    rfl
  rw [gravityExpansion, constraintReadout, gaugeReadout, matterExpansion]
  unfold formNativeLorentzConnectionFirstVariationDensity
    formNativeLorentzConnectionSecondVariationDensity
  ring

/-! ## Actual holonomic path -/

/-- First public production mouth: the actual primitive Lorentz path induces
the corrected gravity BF polynomial.  It requires no source, chart,
nondegeneracy, stationarity, residual, or field-equation premise. -/
theorem holonomicFormNativeGravityBFDensity_lorentzConnection_quadratic
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (variation : CompactlySupportedSmoothVariation LorentzBivectorOneForm)
    (parameter : ℝ) (point : BasePoint) :
    generatedFormNativeGravityBFDensity
        (toContinuumPointField
          (varyLorentzConnection configuration variation parameter) point) =
      generatedFormNativeGravityBFDensity
          (toContinuumPointField configuration point) +
        parameter *
          gravityTopologicalBFCoefficient
            (configuration.gravityAuxiliary point)
            (lorentzConnectionLinearCurvatureVariation configuration variation
              point) +
        parameter ^ 2 *
          gravityTopologicalBFCoefficient
            (configuration.gravityAuxiliary point)
            (lorentzConnectionQuadraticCurvatureVariation variation point) := by
  rw [toContinuumPointField_varyLorentzConnection configuration smooth
    variation parameter point]
  exact
    generatedFormNativeGravityBFDensity_withLorentzConnectionJets_quadratic
      (toContinuumPointField configuration point)
      (lorentzConnectionLinearCurvatureVariation configuration variation point)
      (lorentzConnectionQuadraticCurvatureVariation variation point) parameter
      (variedLorentzMatterCovariantDerivative configuration variation parameter
        point)

def holonomicFormNativeLorentzConnectionFirstVariationDensity
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint -> LorentzBivectorOneForm)
    (point : BasePoint) : ℝ :=
  formNativeLorentzConnectionFirstVariationDensity source chart point
    (toContinuumPointField configuration point)
    (lorentzConnectionLinearCurvatureVariation configuration variation point)
    (holonomicMatterLorentzConnectionVariation configuration variation point)

def holonomicFormNativeLorentzConnectionSecondVariationDensity
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint -> LorentzBivectorOneForm)
    (point : BasePoint) : ℝ :=
  formNativeLorentzConnectionSecondVariationDensity
    (toContinuumPointField configuration point)
    (lorentzConnectionQuadraticCurvatureVariation variation point)

/-- Complete local polynomial on one actual holonomic path.  Both gravity
and matter coefficients are generated from that same primitive occurrence. -/
theorem holonomicFormNativeUnifiedLocalDensity_lorentzConnection_quadratic
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (variation : CompactlySupportedSmoothVariation LorentzBivectorOneForm)
    (parameter : ℝ) (point : BasePoint) :
    sourceGeneratedFormNativeUnifiedLocalDensity source chart point
        (toContinuumPointField
          (varyLorentzConnection configuration variation parameter) point) =
      sourceGeneratedFormNativeUnifiedLocalDensity source chart point
          (toContinuumPointField configuration point) +
        parameter *
          holonomicFormNativeLorentzConnectionFirstVariationDensity source chart
            configuration variation point +
        parameter ^ 2 *
          holonomicFormNativeLorentzConnectionSecondVariationDensity
            configuration variation point := by
  rw [toContinuumPointField_varyLorentzConnection configuration smooth
    variation parameter point]
  exact
    generatedFormNativeUnifiedLocalDensity_lorentzConnectionJets_quadratic
      source (sourceGeneratedUnifiedCouplings source) chart point
      (toContinuumPointField configuration point)
      (lorentzConnectionLinearCurvatureVariation configuration variation point)
      (lorentzConnectionQuadraticCurvatureVariation variation point)
      (holonomicMatterLorentzConnectionVariation configuration variation point)
      parameter

end

end
  SaturationMonoid.PhysicsCore.StageNineFormNativeLorentzConnectionLocalVariation
