theorem positive_generatedMotherAxisGenerator_zero_nonzero :
    generatedMotherAxisGenerator positiveSmoothUnifiedSource 0 1 ≠ 0 := by
  intro generatorZero
  have entryZero := congrArg
    (fun matrix : Matrix SU7MotherIndex SU7MotherIndex ℂ =>
      matrix (Sum.inl 0) (Sum.inl 0)) generatorZero
  norm_num [generatedMotherAxisGenerator, stageEightMotherConnection,
    sourceMotherConnection, sourceP286Potential, realScaleP286,
    realScaleHypercharge, p286LieBlockEmbed, rawP286LieBlock,
    colorCartanGenerator, colorCartanRaw,
    StageNineEnrichedProofFreeSource.positiveSmoothUnifiedSource,
    StageNineEnrichedProofFreeSource.SmoothUnifiedSource.legacy,
    StageNineEnrichedProofFreeSource.SmoothUnifiedSource.forget,
    StageEightProofFreeSource.canonicalPhysicalSource,
    StageEightProofFreeSource.canonicalSource,
    StageEightProofFreeSource.Source.toPhysicalSource,
    ProofFreeRicherAnholonomicSource.Source.sigma] at entryZero

open scoped Matrix.Norms.Operator in
theorem positive_generatedUnifiedMotherAxisTransport_nonconstant :
    generatedUnifiedMotherAxisTransport positiveSmoothUnifiedSource 0 1 ≠
      fun _ => 1 := by
  intro transportConstant
  have generatedDerivative :=
    generatedUnifiedMotherAxisTransport_hasDerivAt
      positiveSmoothUnifiedSource 0 1 0
  rw [transportConstant] at generatedDerivative
  have constantDerivative : HasDerivAt
      (fun _ : ℝ =>
        (1 : Matrix SU7MotherIndex SU7MotherIndex ℂ)) 0 0 :=
    hasDerivAt_const (x := (0 : ℝ))
      (c := (1 : Matrix SU7MotherIndex SU7MotherIndex ℂ))
  have derivativeZero := generatedDerivative.unique constantDerivative
  simp only [one_mul] at derivativeZero
  exact positive_generatedMotherAxisGenerator_zero_nonzero derivativeZero

theorem positive_generatedMotherAxisGenerators_do_not_commute :
    ¬ Commute
      (generatedMotherAxisGenerator positiveSmoothUnifiedSource 0 1)
      (generatedMotherAxisGenerator positiveSmoothUnifiedSource 1 1) := by
  intro generatorsCommute
  have entryEquality := congrArg
    (fun matrix : Matrix SU7MotherIndex SU7MotherIndex ℂ =>
      matrix (Sum.inl 0) (Sum.inl 1)) generatorsCommute.eq
  norm_num [generatedMotherAxisGenerator, stageEightMotherConnection,
    sourceMotherConnection, sourceP286Potential, realScaleP286,
    realScaleHypercharge, p286LieBlockEmbed, rawP286LieBlock,
    colorCartanGenerator, colorCartanRaw,
    colorMixingGenerator, colorMixingRaw, Matrix.mul_apply,
    Fin.sum_univ_three,
    StageNineEnrichedProofFreeSource.positiveSmoothUnifiedSource,
    StageNineEnrichedProofFreeSource.SmoothUnifiedSource.legacy,
    StageNineEnrichedProofFreeSource.SmoothUnifiedSource.forget,
    StageEightProofFreeSource.canonicalPhysicalSource,
    StageEightProofFreeSource.canonicalSource,
    StageEightProofFreeSource.Source.toPhysicalSource,
    ProofFreeRicherAnholonomicSource.Source.sigma] at entryEquality
  have imaginaryEquality := congrArg Complex.im entryEquality
  norm_num at imaginaryEquality

theorem positive_generatedTransitionLogDerivative_zero_one_nonzero :
    generatedTransitionLogDerivative positiveSmoothUnifiedSource 0 1 0 ≠ 0 := by
  intro derivativeZero
  have coefficientEq :
      generatedTransitionDerivativeCoefficient
        positiveSmoothUnifiedSource 0 1 0 = Real.pi := by
    rw [generatedTransitionDerivativeCoefficient]
    simp only [↓reduceIte]
    rw [positive_continuousContactRate]
    norm_num [chartWeight]
  rw [generatedTransitionLogDerivative, coefficientEq] at derivativeZero
  have entryZero := congrArg
    (fun value : SU7MotherLieMatrix =>
      (value : Matrix SU7MotherIndex SU7MotherIndex ℂ)
        hyperPlusIndex hyperPlusIndex) derivativeZero
  change (Real.pi : ℂ) *
    (motherHyperchargeDirection :
      Matrix SU7MotherIndex SU7MotherIndex ℂ)
        hyperPlusIndex hyperPlusIndex = 0 at entryZero
  rw [motherHyperchargeDirection_hyperPlus_entry] at entryZero
  exact (mul_ne_zero (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero)
    Complex.I_ne_zero) entryZero

/-- Negative regression: the global full potential cannot be reused unchanged
in every chart; the generated inhomogeneous overlap term forces the chart
shift used by `generatedLocalUnifiedMotherPotential`. -/
theorem unshiftedUnifiedMotherPotential_badGluing_rejected :
    ¬ ((generatedUnifiedMotherPotential positiveSmoothUnifiedSource 0 0 :
          Matrix SU7MotherIndex SU7MotherIndex ℂ) =
      motherAdjointMatrix
          (generatedTransition positiveSmoothUnifiedSource 0 1 0)
          (generatedUnifiedMotherPotential positiveSmoothUnifiedSource 0 0) -
        (generatedTransitionLogDerivative positiveSmoothUnifiedSource 0 1 0 :
          Matrix SU7MotherIndex SU7MotherIndex ℂ)) := by
  intro badGluing
  rw [generatedTransition_adjoint_unifiedMotherPotential] at badGluing
  have derivativeMatrixZero :
      (generatedTransitionLogDerivative positiveSmoothUnifiedSource 0 1 0 :
        Matrix SU7MotherIndex SU7MotherIndex ℂ) = 0 :=
    sub_eq_self.mp badGluing.symm
  exact positive_generatedTransitionLogDerivative_zero_one_nonzero
    (Subtype.ext derivativeMatrixZero)

open scoped Matrix.Norms.Operator in
def UnifiedMotherAxisParallelODE (source : SmoothUnifiedSource) : Prop :=
  ∀ direction length time,
    HasDerivAt
      (generatedUnifiedMotherAxisTransport source direction length)
      (generatedUnifiedMotherAxisTransport source direction length time *
        (-(length : ℝ) •
          (generatedUnifiedMotherPotential source
            (generatedMotherAxisPath direction length time) direction :
              Matrix SU7MotherIndex SU7MotherIndex ℂ)))
      time

/-- S9-A output credential.  Every carried object is a concrete generated
definition indexed by `source`; callers supply neither bundle nor connection,
descent, smoothness, ODE, lineage, or holonomy certificate. -/
structure SourceGeneratedStageNineAGlobalGeometryCredential
    (source : SmoothUnifiedSource) where
  exactP506L0Lineage :
    source.stageEight.generatedP506L0Lineage =
      canonicalP506SourceAffineL0ObservableLineageReference
  lineageHeightPositive :
    0 < su7A6SignedHeight
      source.stageEight.generatedP506L0Lineage.sourceLabel
  endpointEleven :
    source.stageEight.generatedSelectedEndpoint
      lineageHeightPositive = 11
  totalTransitionAdmissible :
    (generatedTotalTransitionSystem source).TopologicalTransitionAdmissible
  gluedPrincipalSpace : Nonempty (GluedPrincipalTotalSpace source)
  physicalMatterBundle : Nonempty (PhysicalDiracMatterAssociatedBundle source)
  fullMotherGaugeDescent : ∀ initial terminal point direction,
    (generatedLocalUnifiedMotherPotential source terminal point direction :
        Matrix SU7MotherIndex SU7MotherIndex ℂ) =
      motherAdjointMatrix (generatedTransition source initial terminal point)
          (generatedLocalUnifiedMotherPotential source initial point direction) -
        (generatedTransitionLogDerivative source initial terminal direction :
          Matrix SU7MotherIndex SU7MotherIndex ℂ)
  smoothLorentzDescent : LorentzConnectionComponentwiseSmooth source
  axisParallelODE : UnifiedMotherAxisParallelODE source
  noncommutingMotherDirections :
    ¬ Commute (generatedMotherAxisGenerator source 0 1)
      (generatedMotherAxisGenerator source 1 1)
  nonzeroMotherCurvature :
    generatedUnifiedMotherCurvatureAt source 0 (pairFirst 0) (pairSecond 0) ≠ 0
  nontrivialPathHolonomy :
    generatedVerticalParallelTransport source 1 1 1 ≠ 1

theorem positiveSourceGeneratedStageNineAGlobalGeometryCredential :
    SourceGeneratedStageNineAGlobalGeometryCredential
      positiveSmoothUnifiedSource where
  exactP506L0Lineage := canonicalSource_generates_exactP506L0Lineage
  lineageHeightPositive := canonicalSource_generatedLineage_height_pos
  endpointEleven := canonicalSource_generates_selectedEndpoint_eleven
  totalTransitionAdmissible :=
    generatedTotalTransitionSystem_admissible positiveSmoothUnifiedSource
  gluedPrincipalSpace :=
    (positiveSource_generates_gluedTotalBundle).2.2
  physicalMatterBundle :=
    (positiveSource_generates_physicalSpinMatterBundle).1
  fullMotherGaugeDescent :=
    generatedLocalUnifiedMotherPotential_overlap_gauge
      positiveSmoothUnifiedSource
  smoothLorentzDescent :=
    positive_generatedLorentzConnection_componentwiseSmooth
  axisParallelODE :=
    generatedUnifiedMotherAxisTransport_solves_parallelODE
      positiveSmoothUnifiedSource
  noncommutingMotherDirections :=
    positive_generatedMotherAxisGenerators_do_not_commute
  nonzeroMotherCurvature :=
    positive_generatedUnifiedMotherCurvature_nonzero
  nontrivialPathHolonomy :=
    positive_generatedRectanglePathTransport_nontrivial


end

