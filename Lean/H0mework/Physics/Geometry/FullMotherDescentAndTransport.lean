theorem generatedUnifiedMotherAxisTransport_hasDerivAt
    (source : SmoothUnifiedSource) (direction : LorentzianIndex)
    (length time : ℝ) :
    HasDerivAt
      (generatedUnifiedMotherAxisTransport source direction length)
      (generatedUnifiedMotherAxisTransport source direction length time *
        generatedMotherAxisGenerator source direction length)
      time := by
  exact hasDerivAt_exp_smul_const
    (generatedMotherAxisGenerator source direction length) time

open scoped Matrix.Norms.Operator in
@[simp] theorem generatedUnifiedMotherAxisTransport_zero
    (source : SmoothUnifiedSource) (direction : LorentzianIndex)
    (length : ℝ) :
    generatedUnifiedMotherAxisTransport source direction length 0 = 1 := by
  simp [generatedUnifiedMotherAxisTransport]

open scoped Matrix.Norms.Operator in
theorem generatedUnifiedMotherAxisTransport_add
    (source : SmoothUnifiedSource) (direction : LorentzianIndex)
    (length first second : ℝ) :
    generatedUnifiedMotherAxisTransport source direction length
        (first + second) =
      generatedUnifiedMotherAxisTransport source direction length first *
        generatedUnifiedMotherAxisTransport source direction length second := by
  unfold generatedUnifiedMotherAxisTransport
  rw [add_smul]
  exact Matrix.exp_add_of_commute _ _
    ((Commute.refl
      (generatedMotherAxisGenerator source direction length)).smul_left
        first |>.smul_right second)

theorem generatedMotherAxisGenerator_eq_pathContraction
    (source : SmoothUnifiedSource) (direction : LorentzianIndex)
    (length time : ℝ) :
    generatedMotherAxisGenerator source direction length =
      -(length : ℝ) •
        (generatedUnifiedMotherPotential source
          (generatedMotherAxisPath direction length time) direction :
            Matrix SU7MotherIndex SU7MotherIndex ℂ) := by
  rw [generatedUnifiedMotherPotential_axisPath]
  rfl

