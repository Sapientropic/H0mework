def generatedUnifiedMotherAxisTransport
    (source : SmoothUnifiedSource) (direction : LorentzianIndex)
    (length time : ℝ) : Matrix SU7MotherIndex SU7MotherIndex ℂ :=
  NormedSpace.exp
    (time • generatedMotherAxisGenerator source direction length)

