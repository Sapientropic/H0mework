theorem embeddedP286HyperchargeElement_commutes_p286LieBlockEmbed
    (phase : Circle) (data : P286LieBlockData) :
    Commute (embeddedP286HyperchargeElement phase :
        Matrix SU7MotherIndex SU7MotherIndex ℂ)
        (p286LieBlockEmbed data : Matrix SU7MotherIndex SU7MotherIndex ℂ) := by
  change
    (embeddedP286HyperchargeElement phase :
        Matrix SU7MotherIndex SU7MotherIndex ℂ) *
        (p286LieBlockEmbed data : Matrix SU7MotherIndex SU7MotherIndex ℂ) =
      (p286LieBlockEmbed data : Matrix SU7MotherIndex SU7MotherIndex ℂ) *
        (embeddedP286HyperchargeElement phase :
          Matrix SU7MotherIndex SU7MotherIndex ℂ)
  ext row column
  fin_cases row <;> fin_cases column <;>
    simp [embeddedP286HyperchargeElement, p286HyperchargeElement,
      blockDiagonalSMBlock, rawBlockDiagonal, weakHyperchargeBlock,
      hyperchargePairBlock, scalarOneBlock, p286LieBlockEmbed,
      rawP286LieBlock, weakHyperchargeLieBlock, hyperchargeLieBlock,
      scalarLieBlock, Matrix.mul_apply, Matrix.one_apply] <;> ring

set_option maxHeartbeats 800000 in
theorem embeddedP286HyperchargeElement_commutes_generatedUnifiedMotherPotential
    (source : SmoothUnifiedSource) (phase : Circle)
    (point : BasePoint) (direction : LorentzianIndex) :
    (embeddedP286HyperchargeElement phase :
        Matrix SU7MotherIndex SU7MotherIndex ℂ) *
        (generatedUnifiedMotherPotential source point direction :
          Matrix SU7MotherIndex SU7MotherIndex ℂ) =
      (generatedUnifiedMotherPotential source point direction :
          Matrix SU7MotherIndex SU7MotherIndex ℂ) *
        (embeddedP286HyperchargeElement phase :
          Matrix SU7MotherIndex SU7MotherIndex ℂ) := by
  let groupMatrix : Matrix SU7MotherIndex SU7MotherIndex ℂ :=
    embeddedP286HyperchargeElement phase
  have potentialCommutes : Commute groupMatrix
      ((stageEightMotherConnection source).potential direction :
        Matrix SU7MotherIndex SU7MotherIndex ℂ) := by
    exact embeddedP286HyperchargeElement_commutes_p286LieBlockEmbed phase
      (sourceP286Potential source.legacy direction)
  have exteriorCommutes : ∀ derivative,
      Commute groupMatrix
        (stageEightExteriorDerivativeComponent source derivative direction :
          Matrix SU7MotherIndex SU7MotherIndex ℂ) := by
    intro derivative
    fin_cases derivative <;> fin_cases direction <;>
      simp only [stageEightExteriorDerivativeComponent, stageEightMotherConnection,
        sourceMotherConnection]
    all_goals
      first
      | exact embeddedP286HyperchargeElement_commutes_p286LieBlockEmbed phase _
      | exact (embeddedP286HyperchargeElement_commutes_p286LieBlockEmbed
          phase _).neg_right
      | exact Commute.zero_right _
  have sumCommutes : Commute groupMatrix
      (∑ derivative : LorentzianIndex,
        (point derivative : ℂ) •
          (stageEightExteriorDerivativeComponent source derivative direction :
            Matrix SU7MotherIndex SU7MotherIndex ℂ)) := by
    exact Commute.sum_right Finset.univ _ groupMatrix (by
      intro derivative _
      exact (exteriorCommutes derivative).smul_right (point derivative : ℂ))
  have scaledSumCommutes : Commute groupMatrix
      (((1 / 2 : ℝ) : ℂ) •
        ∑ derivative : LorentzianIndex,
          (point derivative : ℂ) •
            (stageEightExteriorDerivativeComponent source derivative direction :
              Matrix SU7MotherIndex SU7MotherIndex ℂ)) :=
    sumCommutes.smul_right (((1 / 2 : ℝ) : ℂ))
  change Commute groupMatrix
    (((stageEightMotherConnection source).potential direction :
        Matrix SU7MotherIndex SU7MotherIndex ℂ) +
      ((1 / 2 : ℝ) : ℂ) •
        ∑ derivative : LorentzianIndex,
          (point derivative : ℂ) •
            (stageEightExteriorDerivativeComponent source derivative direction :
              Matrix SU7MotherIndex SU7MotherIndex ℂ))
  exact potentialCommutes.add_right scaledSumCommutes

def generatedLocalUnifiedMotherPotential
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (direction : LorentzianIndex) : SU7MotherLieMatrix :=
  generatedUnifiedMotherPotential source point direction -
    if direction = 0 then
      (chartWeight chart * source.continuousContactRate) •
        motherHyperchargeDirection
    else 0

theorem generatedLocalUnifiedMotherPotential_overlap_linear
    (source : SmoothUnifiedSource) (initial terminal : StageNineChart)
    (point : BasePoint) (direction : LorentzianIndex) :
    generatedLocalUnifiedMotherPotential source terminal point direction =
      generatedLocalUnifiedMotherPotential source initial point direction -
        generatedTransitionLogDerivative source initial terminal direction := by
  by_cases direction_zero : direction = 0
  · subst direction
    simp [generatedLocalUnifiedMotherPotential,
      generatedTransitionLogDerivative,
      generatedTransitionDerivativeCoefficient]
    module
  · simp [generatedLocalUnifiedMotherPotential,
      generatedTransitionLogDerivative,
      generatedTransitionDerivativeCoefficient, direction_zero]

theorem generatedTransition_adjoint_unifiedMotherPotential
    (source : SmoothUnifiedSource) (initial terminal : StageNineChart)
    (point : BasePoint) (direction : LorentzianIndex) :
    motherAdjointMatrix (generatedTransition source initial terminal point)
        (generatedUnifiedMotherPotential source point direction) =
      (generatedUnifiedMotherPotential source point direction :
        Matrix SU7MotherIndex SU7MotherIndex ℂ) := by
  rw [motherAdjointMatrix]
  rw [generatedTransition]
  rw [(embeddedP286HyperchargeElement_commutes_generatedUnifiedMotherPotential
    source _ point direction)]
  rw [Matrix.mul_assoc]
  change
    (generatedUnifiedMotherPotential source point direction :
        Matrix SU7MotherIndex SU7MotherIndex ℂ) *
      (((embeddedP286HyperchargeElement _ : SU7MotherGroup) *
        (embeddedP286HyperchargeElement _ : SU7MotherGroup)⁻¹ :
          SU7MotherGroup) :
        Matrix SU7MotherIndex SU7MotherIndex ℂ) = _
  rw [mul_inv_cancel]
  simp

theorem generatedTransition_adjoint_hyperchargeShift
    (source : SmoothUnifiedSource) (initial terminal : StageNineChart)
    (point : BasePoint) (coefficient : ℝ) :
    motherAdjointMatrix (generatedTransition source initial terminal point)
        (coefficient • motherHyperchargeDirection) =
      (coefficient : ℂ) •
        (motherHyperchargeDirection :
          Matrix SU7MotherIndex SU7MotherIndex ℂ) := by
  rw [motherAdjointMatrix_real_smul]
  rw [generatedTransition,
    embeddedP286HyperchargeElement_adjoint_motherHyperchargeDirection]

theorem generatedTransition_adjoint_localUnifiedMotherPotential
    (source : SmoothUnifiedSource) (initial terminal : StageNineChart)
    (point : BasePoint) (direction : LorentzianIndex) :
    motherAdjointMatrix (generatedTransition source initial terminal point)
        (generatedLocalUnifiedMotherPotential source initial point direction) =
      (generatedLocalUnifiedMotherPotential source initial point direction :
        Matrix SU7MotherIndex SU7MotherIndex ℂ) := by
  by_cases direction_zero : direction = 0
  · subst direction
    simp only [generatedLocalUnifiedMotherPotential, ↓reduceIte]
    change motherAdjointMatrix _
      (generatedUnifiedMotherPotential source point 0 -
        (chartWeight initial * source.continuousContactRate) •
          motherHyperchargeDirection) = _
    rw [show
      motherAdjointMatrix (generatedTransition source initial terminal point)
          (generatedUnifiedMotherPotential source point 0 -
            (chartWeight initial * source.continuousContactRate) •
              motherHyperchargeDirection) =
        motherAdjointMatrix (generatedTransition source initial terminal point)
            (generatedUnifiedMotherPotential source point 0) -
          motherAdjointMatrix (generatedTransition source initial terminal point)
            ((chartWeight initial * source.continuousContactRate) •
              motherHyperchargeDirection) by
        simp [motherAdjointMatrix, Matrix.mul_sub, Matrix.sub_mul]]
    rw [generatedTransition_adjoint_unifiedMotherPotential,
      generatedTransition_adjoint_hyperchargeShift]
    rfl
  · simp only [generatedLocalUnifiedMotherPotential, direction_zero, ↓reduceIte,
      sub_zero]
    exact generatedTransition_adjoint_unifiedMotherPotential
      source initial terminal point direction

theorem generatedLocalUnifiedMotherPotential_overlap_gauge
    (source : SmoothUnifiedSource) (initial terminal : StageNineChart)
    (point : BasePoint) (direction : LorentzianIndex) :
    (generatedLocalUnifiedMotherPotential source terminal point direction :
        Matrix SU7MotherIndex SU7MotherIndex ℂ) =
      motherAdjointMatrix (generatedTransition source initial terminal point)
          (generatedLocalUnifiedMotherPotential source initial point direction) -
        (generatedTransitionLogDerivative source initial terminal direction :
          Matrix SU7MotherIndex SU7MotherIndex ℂ) := by
  rw [generatedTransition_adjoint_localUnifiedMotherPotential]
  exact congrArg Subtype.val
    (generatedLocalUnifiedMotherPotential_overlap_linear
      source initial terminal point direction)

@[simp] theorem stageEightExteriorDerivativeComponent_self
