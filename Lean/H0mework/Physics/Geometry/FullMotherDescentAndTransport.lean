def generatedMotherAxisPath
    (direction : LorentzianIndex) (length time : ℝ) : BasePoint :=
  EuclideanSpace.single direction (length * time)

theorem generatedUnifiedMotherPotential_axisPath
    (source : SmoothUnifiedSource) (direction : LorentzianIndex)
    (length time : ℝ) :
    generatedUnifiedMotherPotential source
        (generatedMotherAxisPath direction length time) direction =
      (stageEightMotherConnection source).potential direction := by
  fin_cases direction <;>
    simp [generatedUnifiedMotherPotential, generatedMotherAxisPath,
      stageEightExteriorDerivativeComponent, Fin.sum_univ_four]

def generatedMotherAxisGenerator
    (source : SmoothUnifiedSource) (direction : LorentzianIndex)
    (length : ℝ) : Matrix SU7MotherIndex SU7MotherIndex ℂ :=
  -(length : ℝ) •
    ((stageEightMotherConnection source).potential direction :
      Matrix SU7MotherIndex SU7MotherIndex ℂ)

