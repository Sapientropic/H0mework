import H0mework.Physics.GravityTail.FixedPrimitiveSeamClosure

/-!
# Fixed gravity-tail primitive-factor disposition

This module exposes the strongest premise-free value-factor normal forms and
one concrete nonzero coframe-first-jet factor generated by the fixed gravity
occurrence.  It does not choose a root branch or construct a replacement
current.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace PhysicsCore
namespace StageNineGravityTailPrimitiveFactorDisposition

open ProofFreeRicherAnholonomicSource
open StageNineCanonicalCauchyState
open StageNineDiracDualFormNativeCartanECSynchronizedGravityTailJointPathOperator
open StageNineDiracDualFormNativeFixedP506CartanECConstraintCauchyGlobalOperator
open StageNineDiracDualFormNativeFixedP506CartanECConstraintCauchyGravityTailAllPointResidualNormalForm
open StageNineDiracDualFormNativeFixedP506CartanECConstraintCauchyGravityTailJointPath
open StageNineEnrichedProofFreeSource
open StageNineHolonomicField
open StageNineLorentzConnectionVariation
open StageNineP286ActionConnectionVelocity

noncomputable section

private abbrev Source : SmoothUnifiedSource := positiveSmoothUnifiedSource

private abbrev Current : StageNineHolonomicConfiguration :=
  fixedP506L0CartanECConstraintCauchyGlobalActual

/-- The value-level coframe factor is exactly the emitted radial increment;
the fixed gravity base contributes no hidden displacement because its
coframe is globally the identity. -/
theorem coframeValueDefect_eq_radialIncrement
    (point : BasePoint) :
    fixedP506L0CartanECConstraintCauchyGravityTailCoframeValueDefect point =
      cartanECSynchronizedGravityTailCoframeRadialIncrement
        positiveSmoothUnifiedSource
        fixedP506L0CartanECConstraintCauchyGlobalActual point := by
  change
    fixedP506L0CartanECConstraintCauchyGravityTailCoframeValueDefect point =
      cartanECSynchronizedGravityTailCoframeRadialIncrement
        Source Current point
  unfold fixedP506L0CartanECConstraintCauchyGravityTailCoframeValueDefect
    cartanECSynchronizedGravityTailCoframePathField
    cartanECSynchronizedGravityTailCoframePathAnchor
  rw [fixedP506L0CartanECConstraintCauchyGravityTailBase_coframe_eq_one]
  simp

/-- The value-level connection factor contains exactly the skew image of
the same-path profile Lorentz-jet drift.  The normalized-affine part has
already cancelled. -/
theorem connectionValueDefect_eq_profileLorentzJetDrift
    (point : BasePoint) :
    fixedP506L0CartanECConstraintCauchyGravityTailConnectionValueDefect
        point =
      lorentzSkewConnectionOfBivectorOneForm
        (fixedP506L0CartanECConstraintCauchyGravityTailProfileLorentzJetDriftRadialIncrement
          point) := by
  rw [←
    fixedP506L0CartanECConstraintCauchyGravityTailActionJetSeam_gravityConnection_eq_valueDefect]
  exact
    fixedP506L0CartanECConstraintCauchyGravityTailActionJetSeam_gravityConnection_eq_profileLorentzJetDrift
      point

/-- A concrete initial-slice primitive factor is nonzero while the coframe
value factor at the same point is already settled.  The witness is selected
from the three source-generated coordinates whose sum is `-319/216`; no
coordinate or value is supplied. -/
theorem exists_zeroSlice_coframeValue_zero_and_firstJetFactor_nonzero :
    ∃ (space : StageNineSpatialPoint) (axis : Fin 3)
        (internal coordinate : LorentzianIndex),
      fixedP506L0CartanECConstraintCauchyGravityTailCoframeValueDefect
          (canonicalCauchySlicePoint 0 space) = 0 ∧
        cartanECSynchronizedGravityTailCoframeRadialFirstJetDefectCoordinate
            positiveSmoothUnifiedSource
            fixedP506L0CartanECConstraintCauchyGlobalActual
            (canonicalCauchySlicePoint 0 space) internal coordinate
            (coordinateDirection axis.succ) ≠ 0 := by
  let spaceOne : StageNineSpatialPoint :=
    canonicalSpatialCoordinateDirection 1
  let spaceTwo : StageNineSpatialPoint :=
    canonicalSpatialCoordinateDirection 2
  let spaceZero : StageNineSpatialPoint :=
    canonicalSpatialCoordinateDirection 0
  let first :=
    cartanECSynchronizedGravityTailCoframeRadialFirstJetDerivativeDefect
      Source Current (canonicalCauchySlicePoint 0 spaceOne) 3 2 3
  let second :=
    cartanECSynchronizedGravityTailCoframeRadialFirstJetDerivativeDefect
      Source Current (canonicalCauchySlicePoint 0 spaceTwo) 1 3 1
  let third :=
    cartanECSynchronizedGravityTailCoframeRadialFirstJetDerivativeDefect
      Source Current (canonicalCauchySlicePoint 0 spaceZero) 2 1 2
  have coframeZero (space : StageNineSpatialPoint) :
      fixedP506L0CartanECConstraintCauchyGravityTailCoframeValueDefect
          (canonicalCauchySlicePoint 0 space) = 0 := by
    rw [coframeValueDefect_eq_radialIncrement,
      fixedP506L0CartanECConstraintCauchyGravityTailCoframeRadialIncrement_zeroSlice]
  have fixedSum : first + second + third = -(319 / 216 : ℝ) := by
    simpa [first, second, third, spaceOne, spaceTwo, spaceZero] using
      fixedP506L0CartanECConstraintCauchyGravityTail_zeroSlice_transverseCoframeDefectSum_eq_neg_319_div_216
  by_cases firstNonzero : first ≠ 0
  · refine ⟨spaceOne, 2, 2, 3, coframeZero spaceOne, ?_⟩
    simpa [first,
      cartanECSynchronizedGravityTailCoframeRadialFirstJetDerivativeDefect]
      using firstNonzero
  · have firstZero : first = 0 := not_ne_iff.mp firstNonzero
    by_cases secondNonzero : second ≠ 0
    · refine ⟨spaceTwo, 0, 3, 1, coframeZero spaceTwo, ?_⟩
      simpa [second,
        cartanECSynchronizedGravityTailCoframeRadialFirstJetDerivativeDefect]
        using secondNonzero
    · have secondZero : second = 0 := not_ne_iff.mp secondNonzero
      have thirdNonzero : third ≠ 0 := by
        intro thirdZero
        rw [firstZero, secondZero, thirdZero] at fixedSum
        norm_num at fixedSum
      refine ⟨spaceZero, 1, 1, 2, coframeZero spaceZero, ?_⟩
      simpa [third,
        cartanECSynchronizedGravityTailCoframeRadialFirstJetDerivativeDefect]
        using thirdNonzero

end

end StageNineGravityTailPrimitiveFactorDisposition
end PhysicsCore
end SaturationMonoid
