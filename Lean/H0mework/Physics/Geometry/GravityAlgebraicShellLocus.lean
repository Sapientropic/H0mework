import H0mework.Physics.Exterior.GravityAuxiliaryVariation

/-!
# S9-C3g1: current gravity algebraic-shell locus

C3g0 rejects the old affine/canonical source mouth and a naive identity-flat
tail; it does not prove that the current gravity shell is empty.  This module
therefore classifies the complete pointwise locus of the two algebraic
equations already generated by the action:

* multiplier stationarity gives `B = II+(e)`;
* auxiliary-field stationarity gives `F = gravityInternalDual B`.

The locus is equivalent to `coframe × squared-multiplier`: `B` and `F` are
determined, while the multiplier remains arbitrary because its first response
vanishes on the simplicity shell.  In particular the locus is inhabited by a
nonzero-curvature identity-coframe point, so the current algebraic shell is not
empty.  It is also not subsingleton even after imposing a nondegenerate
identity coframe, so this parameterization is not a producer and callers may
not select an arbitrary witness.

This checkpoint does not include the coframe, connection, gauge, scalar, or
matter Euler--Lagrange equations; it proves neither local holonomic
realizability nor simultaneous stationarity.  A final source producer must
canonically generate any surviving free data from exact lineage, or retain
observable multiplicity in a transported residual/responsibility trace.
-/

namespace SaturationMonoid.PhysicsCore.StageNineGravityAlgebraicShellLocus

open ProofFreeRicherAnholonomicSource
open StageNineGlobalIntegratedAction
open StageNinePlebanskiMultiplierVariation
open StageNineGravityAuxiliaryVariation
open StageNineBlockwiseConstitutive

noncomputable section

/-- The four pointwise gravity coordinates needed by the current algebraic
shell.  The multiplier is included so its unselected freedom stays visible. -/
structure CurrentGravityAlgebraicPoint where
  coframe : LorentzianCoframe
  curvature : PhysicalBivector
  auxiliary : PhysicalBivector
  multiplier : PhysicalBivector

namespace CurrentGravityAlgebraicPoint

/-- Read the algebraic gravity coordinates from an action point field. -/
def ofContinuumPointField
    (field : StageNineContinuumPointField) : CurrentGravityAlgebraicPoint where
  coframe := field.coframe
  curvature := field.gravityCurvature
  auxiliary := field.gravityAuxiliary
  multiplier := field.gravitySimplicityMultiplier

end CurrentGravityAlgebraicPoint

/-- The actual pointwise equations generated by the current multiplier and
gravity-auxiliary variation channels. -/
def OnCurrentGravityAlgebraicShell
    (point : CurrentGravityAlgebraicPoint) : Prop :=
  point.auxiliary = physicalIIPlusBivector point.coframe ∧
    point.curvature = gravityInternalDualEquiv point.auxiliary

/-- Algebraic reconstruction from the two coordinates not selected by these
equations.  This is a locus chart, not a source producer. -/
def currentGravityAlgebraicPointOf
    (coframe : LorentzianCoframe) (multiplier : PhysicalBivector) :
    CurrentGravityAlgebraicPoint where
  coframe := coframe
  curvature := gravityInternalDualEquiv (physicalIIPlusBivector coframe)
  auxiliary := physicalIIPlusBivector coframe
  multiplier := multiplier

@[simp] theorem currentGravityAlgebraicPointOf_onShell
    (coframe : LorentzianCoframe) (multiplier : PhysicalBivector) :
    OnCurrentGravityAlgebraicShell
      (currentGravityAlgebraicPointOf coframe multiplier) := by
  simp [OnCurrentGravityAlgebraicShell, currentGravityAlgebraicPointOf]

/-- Every point on the current algebraic shell is reconstructed from exactly
its coframe and multiplier. -/
theorem onCurrentGravityAlgebraicShell_iff_reconstructs
    (point : CurrentGravityAlgebraicPoint) :
    OnCurrentGravityAlgebraicShell point ↔
      point = currentGravityAlgebraicPointOf point.coframe point.multiplier := by
  constructor
  · rintro ⟨auxiliary, curvature⟩
    cases point
    simp only at auxiliary curvature ⊢
    subst auxiliary
    subst curvature
    rfl
  · intro equality
    rw [equality]
    exact currentGravityAlgebraicPointOf_onShell _ _

/-- Exact classification of the current two-equation algebraic locus. -/
def currentGravityAlgebraicShellEquiv :
    { point : CurrentGravityAlgebraicPoint //
        OnCurrentGravityAlgebraicShell point } ≃
      LorentzianCoframe × PhysicalBivector where
  toFun := fun point => (point.1.coframe, point.1.multiplier)
  invFun := fun data =>
    ⟨currentGravityAlgebraicPointOf data.1 data.2,
      currentGravityAlgebraicPointOf_onShell data.1 data.2⟩
  left_inv := by
    intro point
    apply Subtype.ext
    exact (onCurrentGravityAlgebraicShell_iff_reconstructs point.1).mp
      point.2 |>.symm
  right_inv := by
    intro data
    rfl

/-- The classification is literally the zero locus of the actual simplicity
and gravity-auxiliary residuals on a continuum point field. -/
theorem projectedField_onShell_iff_actualResidualsZero
    (field : StageNineContinuumPointField) :
    OnCurrentGravityAlgebraicShell
        (CurrentGravityAlgebraicPoint.ofContinuumPointField field) ↔
      generatedGravitySimplicityResidual field = 0 ∧
        gravityAuxiliaryEquationResidual field = 0 := by
  simp [OnCurrentGravityAlgebraicShell,
    CurrentGravityAlgebraicPoint.ofContinuumPointField,
    generatedGravitySimplicityResidual, gravityAuxiliaryEquationResidual,
    sub_eq_zero]

/-- On the shell, the current fixed-dual equation sets curvature to the
negative raw coframe wedge. -/
theorem currentGravityShellCurvature_eq_negCoframeWedge
    (coframe : LorentzianCoframe) :
    gravityInternalDualEquiv (physicalIIPlusBivector coframe) =
      -coframeWedge coframe := by
  change gravityInternalDualLinear
    (gravityInternalDualLinear (coframeWedge coframe)) = -coframeWedge coframe
  exact gravityInternalDualLinear_square (coframeWedge coframe)

/-- A nondegenerate, nonzero-curvature member of the algebraic locus.  This is
an inhabitance regression, not a holonomic or stationary source solution. -/
def identityCurrentGravityAlgebraicPoint : CurrentGravityAlgebraicPoint :=
  currentGravityAlgebraicPointOf 1 0

@[simp] theorem identityCurrentGravityAlgebraicPoint_onShell :
    OnCurrentGravityAlgebraicShell identityCurrentGravityAlgebraicPoint :=
  currentGravityAlgebraicPointOf_onShell 1 0

@[simp] theorem identityCurrentGravityAlgebraicPoint_nondegenerate :
    Matrix.det identityCurrentGravityAlgebraicPoint.coframe ≠ 0 := by
  simp [identityCurrentGravityAlgebraicPoint,
    currentGravityAlgebraicPointOf]

theorem identityCurrentGravityAlgebraicPoint_curvature_ne_zero :
    identityCurrentGravityAlgebraicPoint.curvature ≠ 0 := by
  change gravityInternalDualEquiv (physicalIIPlusBivector 1) ≠ 0
  intro curvatureZero
  have auxiliaryZero :
      physicalIIPlusBivector (1 : LorentzianCoframe) = 0 := by
    apply gravityInternalDualEquiv.injective
    simpa using curvatureZero
  exact physicalIIPlusBivector_not_zero auxiliaryZero

/-- The C3g0 flat identity point remains outside the classified locus. -/
def identityFlatGravityAlgebraicFake : CurrentGravityAlgebraicPoint where
  coframe := 1
  curvature := 0
  auxiliary := physicalIIPlusBivector 1
  multiplier := 0

theorem identityFlatGravityAlgebraicFake_not_onShell :
    ¬ OnCurrentGravityAlgebraicShell identityFlatGravityAlgebraicFake := by
  rintro ⟨_, curvatureEquation⟩
  have curvatureZero :
      gravityInternalDualEquiv (physicalIIPlusBivector 1) = 0 := by
    simpa [identityFlatGravityAlgebraicFake] using curvatureEquation.symm
  have auxiliaryZero :
      physicalIIPlusBivector (1 : LorentzianCoframe) = 0 := by
    apply gravityInternalDualEquiv.injective
    simpa using curvatureZero
  exact physicalIIPlusBivector_not_zero auxiliaryZero

/-- The equations do not select the squared multiplier, even after fixing the
same nondegenerate coframe and its generated nonzero curvature. -/
theorem currentGravityAlgebraicPointOf_injective_multiplier
    (coframe : LorentzianCoframe) :
    Function.Injective (currentGravityAlgebraicPointOf coframe) := by
  intro first second equality
  exact congrArg CurrentGravityAlgebraicPoint.multiplier equality

/-- No-free-parameter regression: the nondegenerate algebraic locus is not a
singleton and therefore cannot itself serve as a canonical source producer. -/
theorem nondegenerateCurrentGravityAlgebraicShell_not_subsingleton :
    ¬ Subsingleton
      { point : CurrentGravityAlgebraicPoint //
        OnCurrentGravityAlgebraicShell point ∧
          Matrix.det point.coframe ≠ 0 } := by
  intro singleton
  let zeroPoint :
      { point : CurrentGravityAlgebraicPoint //
        OnCurrentGravityAlgebraicShell point ∧
          Matrix.det point.coframe ≠ 0 } :=
    ⟨currentGravityAlgebraicPointOf 1 0,
      currentGravityAlgebraicPointOf_onShell 1 0,
      by simp [currentGravityAlgebraicPointOf]⟩
  let nonzeroPoint :
      { point : CurrentGravityAlgebraicPoint //
        OnCurrentGravityAlgebraicShell point ∧
          Matrix.det point.coframe ≠ 0 } :=
    ⟨currentGravityAlgebraicPointOf 1 (physicalIIPlusBivector 1),
      currentGravityAlgebraicPointOf_onShell 1
        (physicalIIPlusBivector 1),
      by simp [currentGravityAlgebraicPointOf]⟩
  have pointsEqual : zeroPoint = nonzeroPoint := singleton.elim _ _
  have multipliersEqual := congrArg
    (fun point => point.1.multiplier) pointsEqual
  exact physicalIIPlusBivector_not_zero (by
    simpa [zeroPoint, nonzeroPoint, currentGravityAlgebraicPointOf] using
      multipliersEqual.symm)

end

end SaturationMonoid.PhysicsCore.StageNineGravityAlgebraicShellLocus
