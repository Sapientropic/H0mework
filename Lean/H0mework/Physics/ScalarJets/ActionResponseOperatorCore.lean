import H0mework.Physics.DualVariation.ScalarVariation
import H0mework.Physics.ScalarJets.ScalarActionSecondJetLocalActualLift

/-!
# Generic Dirac-dual scalar second-jet action response core

This dependency-light module contains the source/current-native scalar
second-jet producer.  The mother action is read in the fixed finite real
scalar basis; those reads determine a real dual and therefore one canonical
quadratic temporal write.  No fixed P506/L0 specialization, recentered
section, residual, support branch, target acceleration, equation witness, or
zero-fiber certificate is an input.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeScalarSecondJetActionResponseOperator

open ProofFreeRicherAnholonomicSource
open StageNineCanonicalCauchyState
open StageNineDiracDualFormNativeScalarVariation
open StageNineDynamicBreakingVacuum
open StageNineEnrichedProofFreeSource
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineP286ActionCauchySplit
open StageNineP286GaugeConnectionActionVariation
open StageNineP286GaugeConnectionVariationDensity
open StageNineScalarActionSecondJetLocalActualLift
open StageNineScalarPointwiseEquation
open SU7MotherLieAlgebra

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1200000
set_option maxRecDepth 100000

/-! ## Source/current action demand -/

def genericScalarCurrentPdot
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (direction : ScalarCoordinateCarrier) : ℝ :=
  fieldDirectionalDerivative
    (scalarDifferentialMomentum source current direction
      canonicalLorentzianTimeDirection)
    0 canonicalLorentzianTimeDirection

def genericScalarSpatialMomentumDivergence
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (direction : ScalarCoordinateCarrier) : ℝ :=
  ∑ derivativeDirection : Fin 3,
    fieldDirectionalDerivative
      (scalarDifferentialMomentum source current direction
        derivativeDirection.succ)
      0 derivativeDirection.succ

/-- The forward `3+1` momentum derivative required by the scalar mother
action, before comparison with the current temporal momentum derivative. -/
def genericDiracDualScalarRequiredPdot
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (direction : ScalarCoordinateCarrier) : ℝ :=
  diracDualScalarAlgebraicDirectionalCoefficient source current direction 0 -
    genericScalarSpatialMomentumDivergence source current direction

/-- Raw action read used to generate the real scalar covector.  It is not a
joint-residual field and is never accepted as an input to the writer. -/
def genericDiracDualScalarRawTemporalDemand
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (direction : ScalarCoordinateCarrier) : ℝ :=
  genericDiracDualScalarRequiredPdot source current direction -
    genericScalarCurrentPdot source current direction

/-- Canonical finite-coordinate synthesis of the real action covector.
Every coefficient is a source/current action read on an existing real or
imaginary scalar basis vector; there is no freely supplied coefficient. -/
def genericDiracDualScalarTemporalDemandCoordinate
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) : ScalarCoordinateCarrier :=
  WithLp.toLp 2 fun index =>
    (genericDiracDualScalarRawTemporalDemand source current
        (scalarRealBasis index) : ℂ) +
      (genericDiracDualScalarRawTemporalDemand source current
          (scalarImaginaryBasis index) : ℂ) * Complex.I

/-- Real dual canonically generated by the scalar mother-action basis reads. -/
def genericDiracDualScalarTemporalDemandDual
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    Module.Dual ℝ ScalarCoordinateCarrier where
  toFun := fun direction =>
    scalarCoordinatePairingRe direction
      (genericDiracDualScalarTemporalDemandCoordinate source current)
  map_add' := by
    intro first second
    exact scalarCoordinatePairingRe_add_left first second _
  map_smul' := by
    intro parameter direction
    simpa only [RingHom.id_apply, smul_eq_mul] using
      scalarCoordinatePairingRe_real_smul_left parameter direction
        (genericDiracDualScalarTemporalDemandCoordinate source current)

def genericDiracDualScalarTemporalDemand
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (direction : ScalarCoordinateCarrier) : ℝ :=
  genericDiracDualScalarTemporalDemandDual source current direction

@[simp] theorem genericDiracDualScalarTemporalDemandDual_realBasis
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (index : ScalarBasisIndex) :
    genericDiracDualScalarTemporalDemandDual source current
        (scalarRealBasis index) =
      genericDiracDualScalarRawTemporalDemand source current
        (scalarRealBasis index) := by
  classical
  simp [genericDiracDualScalarTemporalDemandDual,
    genericDiracDualScalarTemporalDemandCoordinate, scalarCoordinatePairingRe,
    scalarRealBasis, scalarImaginaryBasis, Complex.mul_re, Complex.mul_im]
  rw [Finset.sum_eq_single index]
  · simp
  · intro candidate _ candidateNe
    simp [candidateNe]
  · simp

@[simp] theorem genericDiracDualScalarTemporalDemandDual_imaginaryBasis
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (index : ScalarBasisIndex) :
    genericDiracDualScalarTemporalDemandDual source current
        (scalarImaginaryBasis index) =
      genericDiracDualScalarRawTemporalDemand source current
        (scalarImaginaryBasis index) := by
  classical
  simp [genericDiracDualScalarTemporalDemandDual,
    genericDiracDualScalarTemporalDemandCoordinate, scalarCoordinatePairingRe,
    scalarRealBasis, scalarImaginaryBasis, Complex.mul_re, Complex.mul_im]
  rw [Finset.sum_eq_single index]
  · simp
  · intro candidate _ candidateNe
    simp [candidateNe]
  · simp

/-! ## No-free-parameter acceleration and writer -/

/-- The unique scalar coordinate representing the negative action demand. -/
def genericDiracDualScalarGeneratedAcceleration
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) : ScalarCoordinateCarrier :=
  -scalarActionRealDual
    (genericDiracDualScalarTemporalDemandDual source current)

theorem genericDiracDualScalarGeneratedAcceleration_actionLaw
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (direction : ScalarCoordinateCarrier) :
    genericDiracDualScalarTemporalDemand source current direction =
      -scalarCoordinatePairingRe direction
        (genericDiracDualScalarGeneratedAcceleration source current) := by
  change
    genericDiracDualScalarTemporalDemandDual source current direction =
      -scalarCoordinatePairingRe direction
        (-scalarActionRealDual
          (genericDiracDualScalarTemporalDemandDual source current))
  rw [show
    scalarCoordinatePairingRe direction
        (-scalarActionRealDual
          (genericDiracDualScalarTemporalDemandDual source current)) =
      -scalarCoordinatePairingRe direction
        (scalarActionRealDual
          (genericDiracDualScalarTemporalDemandDual source current)) by
    change
      scalarCoordinatePairingReBilinear direction
          (-scalarActionRealDual
            (genericDiracDualScalarTemporalDemandDual source current)) =
        -scalarCoordinatePairingReBilinear direction
          (scalarActionRealDual
            (genericDiracDualScalarTemporalDemandDual source current))
    exact map_neg
      (scalarCoordinatePairingReBilinear direction)
      (scalarActionRealDual
        (genericDiracDualScalarTemporalDemandDual source current))]
  rw [neg_neg, scalarCoordinatePairingRe_actionRealDual]

/-- Source/current-native scalar second-jet write.  The acceleration is
computed internally from the action and is not a constructor argument. -/
def genericDiracDualScalarSecondJetActionResponse
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  { current with
    scalar := fun point =>
      current.scalar point +
        scalarQuadraticTimeCorrection
          (genericDiracDualScalarGeneratedAcceleration source current) point }

