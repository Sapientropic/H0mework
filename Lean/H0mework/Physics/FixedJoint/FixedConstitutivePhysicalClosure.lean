theorem
    fixedP506FormNativeConstitutiveJointActionSuccessor_ne_fixedActual :
    FixedP506FormNativeConstitutiveJointActionSuccessor ≠
      FixedP506JointActual := by
  intro sameActual
  apply fixedP506JointResidual_origin_ne_zero
  change
    diracDualFormNativePointwiseJointResidual positiveSmoothUnifiedSource
        FixedP506JointActual 0 =
      0
  rw [← sameActual]
  exact
    fixedP506FormNativeConstitutiveJointActionSuccessorResidual_origin_zero

/-- Positive/negative fixed-contact checkpoint for the same source lineage.
The predecessor remains outside the zero fiber; the one action-generated
constitutive successor lies on it and retains the complete six-sector and
spin--torsion content. -/
theorem
    fixedP506FormNativeConstitutiveJointActionSuccessor_physicalCheckpoint :
    positiveSmoothUnifiedSource.stageEight.generatedP506L0Lineage =
        canonicalP506SourceAffineL0ObservableLineageReference ∧
      fixedP506JointResidualSection 0 ≠ 0 ∧
      fixedP506FormNativeConstitutiveJointActionSuccessorResidualSection 0 =
        0 ∧
      FixedP506FormNativeConstitutiveJointActionSuccessor ≠
        FixedP506JointActual ∧
      LegacySimultaneousSixSectorNonzero positiveSmoothUnifiedSource
        FixedP506FormNativeConstitutiveJointActionSuccessor ∧
      internalBivectorDualThreeForm
            (torsionCoframeWedgeThreeForm
              (FixedP506FormNativeConstitutiveJointActionSuccessor.coframe 0)
              (pointwiseCartanTorsion
                (holonomicCoframeFirstJetAt
                  FixedP506FormNativeConstitutiveJointActionSuccessor.coframe
                  0)
                (FixedP506FormNativeConstitutiveJointActionSuccessor.gravityConnection
                  0))) =
          formNativePhysicalSpinCurrentThreeForm positiveSmoothUnifiedSource 0
            0
            (toContinuumPointField
              (restrictHolonomicConfigurationToIIPlus
                FixedP506FormNativeConstitutiveJointActionSuccessor) 0) := by
  exact
    ⟨fixedP506FormNativeConstitutiveJointActionSuccessor_exactLineage,
      fixedP506JointResidual_origin_ne_zero,
      fixedP506FormNativeConstitutiveJointActionSuccessorResidual_origin_zero,
      fixedP506FormNativeConstitutiveJointActionSuccessor_ne_fixedActual,
      fixedP506FormNativeConstitutiveJointActionSuccessor_simultaneousSixSectorNonzero,
      fixedP506FormNativeConstitutiveJointActionSuccessor_torsionSpin_origin⟩

end

