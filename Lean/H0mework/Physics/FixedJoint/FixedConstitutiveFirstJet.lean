private def fixedP506FormNativeConstitutiveCoordinateAxis
    (direction : LorentzianIndex) : ℝ → BasePoint :=
  fun parameter => parameter • coordinateDirection direction

private theorem fixedP506FormNativeConstitutiveCoordinateAxis_hasDerivAt
    (direction : LorentzianIndex) :
    HasDerivAt (fixedP506FormNativeConstitutiveCoordinateAxis direction)
      (coordinateDirection direction) 0 := by
  let line :=
    fun parameter : ℝ => parameter • coordinateDirection direction
  change HasDerivAt line (coordinateDirection direction) 0
  simpa [line] using
    (hasDerivAt_id (𝕜 := ℝ) 0).smul_const
      (coordinateDirection direction)

private theorem fixedP506FormNativeConstitutiveInput_coframe_eq_complete :
    FixedConstitutiveInput.coframe =
      positiveP506DiracDualIdentityECHessianCartanECNormalFixedGlobalMatterDualP286CompleteActual.coframe := by
  rw [fixedP506FormNativeJointActionSolvedSuccessor_coframe,
    fixedP506JointActionSuccessor_coframe]

private theorem fixedP506FormNativeConstitutiveInput_coframe_origin :
    FixedConstitutiveInput.coframe 0 = 1 := by
  rw [fixedP506FormNativeConstitutiveInput_coframe_eq_complete]
  exact fixedGlobalMatterDualP286Complete_coframe_origin

private theorem
    fixedP506FormNativeConstitutiveInput_coframeAxis_hasDerivAt_zero
    (direction : LorentzianIndex) :
    HasDerivAt
      (fun parameter =>
        FixedConstitutiveInput.coframe
          (fixedP506FormNativeConstitutiveCoordinateAxis direction parameter))
      0 0 := by
  rw [fixedP506FormNativeConstitutiveInput_coframe_eq_complete]
  exact
    fixedGlobalMatterDualP286Complete_coframeCoordinateAxis_hasDerivAt_zero
      direction

private def fixedP506FormNativeConstitutiveCurvatureAxisDerivative
    (direction : LorentzianIndex) :
    FormNativeP286GaugeCoordinateTwoForm :=
  fun pair =>
    (fderiv ℝ
      (fun point =>
        holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput
          point pair)
      0) (coordinateDirection direction)

private theorem
    fixedP506FormNativeConstitutiveInput_curvatureAxis_hasDerivAt
    (direction : LorentzianIndex) :
    HasDerivAt
      (fun parameter =>
        holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput
          (fixedP506FormNativeConstitutiveCoordinateAxis direction parameter))
      (fixedP506FormNativeConstitutiveCurvatureAxisDerivative direction) 0 := by
  apply hasDerivAt_pi.mpr
  intro pair
  have outer :
      HasFDerivAt
        (fun point =>
          holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput
            point pair)
        (fderiv ℝ
          (fun point =>
            holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput
              point pair)
          0)
        0 :=
    ((holonomicGaugeCurvature_coordinate_contDiff FixedConstitutiveInput
      fixedP506FormNativeJointActionSolvedSuccessor_smooth pair)
      |>.differentiable (by simp)
      |>.differentiableAt).hasFDerivAt
  have outerAtAxis :
      HasFDerivAt
        (fun point =>
          holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput
            point pair)
        (fderiv ℝ
          (fun point =>
            holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput
              point pair)
          0)
        (fixedP506FormNativeConstitutiveCoordinateAxis direction 0) := by
    simpa [fixedP506FormNativeConstitutiveCoordinateAxis] using outer
  have composed :=
    outerAtAxis.comp_hasDerivAt 0
      (fixedP506FormNativeConstitutiveCoordinateAxis_hasDerivAt direction)
  have functionEquality :
      ((fun point =>
          holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput
            point pair) ∘
        fixedP506FormNativeConstitutiveCoordinateAxis direction) =
        fun parameter =>
          holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput
            (fixedP506FormNativeConstitutiveCoordinateAxis direction parameter)
            pair := by
    rfl
  rw [functionEquality] at composed
  simpa [fixedP506FormNativeConstitutiveCurvatureAxisDerivative] using composed

private def fixedP506FormNativeConstitutiveLiveInputAxis
    (direction : LorentzianIndex) :
    ℝ →
      LorentzianCoframe × FormNativeP286GaugeCoordinateTwoForm :=
  fun parameter =>
    let point :=
      fixedP506FormNativeConstitutiveCoordinateAxis direction parameter
    (FixedConstitutiveInput.coframe point,
      holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput point)

private def fixedP506FormNativeConstitutiveFrozenInputAxis
    (direction : LorentzianIndex) :
    ℝ →
      LorentzianCoframe × FormNativeP286GaugeCoordinateTwoForm :=
  fun parameter =>
    let point :=
      fixedP506FormNativeConstitutiveCoordinateAxis direction parameter
    (1, holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput point)

private theorem fixedP506FormNativeConstitutiveLiveInputAxis_hasDerivAt
    (direction : LorentzianIndex) :
    HasDerivAt
      (fixedP506FormNativeConstitutiveLiveInputAxis direction)
      (0, fixedP506FormNativeConstitutiveCurvatureAxisDerivative direction)
      0 := by
  exact
    (fixedP506FormNativeConstitutiveInput_coframeAxis_hasDerivAt_zero
      direction).prodMk
      (fixedP506FormNativeConstitutiveInput_curvatureAxis_hasDerivAt
        direction)

private theorem fixedP506FormNativeConstitutiveFrozenInputAxis_hasDerivAt
    (direction : LorentzianIndex) :
    HasDerivAt
      (fixedP506FormNativeConstitutiveFrozenInputAxis direction)
      (0, fixedP506FormNativeConstitutiveCurvatureAxisDerivative direction)
      0 := by
  exact
    (hasDerivAt_const (x := (0 : ℝ)) (c := (1 : LorentzianCoframe))).prodMk
      (fixedP506FormNativeConstitutiveInput_curvatureAxis_hasDerivAt
        direction)

private def fixedP506FormNativeConstitutiveActionInverse :
    LorentzianCoframe × FormNativeP286GaugeCoordinateTwoForm →
      FormNativeP286GaugeCoordinateTwoForm :=
  fun joint =>
    formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary
      FixedConstitutiveBoundary joint.1 joint.2

private def fixedP506FormNativeConstitutiveCommonAxisDerivative
    (direction : LorentzianIndex) :
    FormNativeP286GaugeCoordinateTwoForm :=
  (fderiv ℝ fixedP506FormNativeConstitutiveActionInverse
      (1,
        holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput 0))
    (0, fixedP506FormNativeConstitutiveCurvatureAxisDerivative direction)

/-- The live-coframe inverse and its identity-coframe comparison have the
same directional first jet at the fixed contact.  This follows from the
zero coframe first jet and joint differentiability of the already generated
action inverse; it does not inspect a residual coordinate. -/
private theorem
    fixedP506FormNativeConstitutiveAuxiliaryCoordinate_fderiv_eq_input
    (direction : LorentzianIndex) :
    (fderiv ℝ fixedP506FormNativeConstitutiveAuxiliaryCoordinate 0)
        (coordinateDirection direction) =
      (fderiv ℝ
        (holonomicP286GaugeAuxiliaryCoordinate FixedConstitutiveInput) 0)
        (coordinateDirection direction) := by
  let liveGlobal : BasePoint → FormNativeP286GaugeCoordinateTwoForm :=
    fun point =>
      fixedP506FormNativeConstitutiveActionInverse
        (FixedConstitutiveInput.coframe point,
          holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput point)
  let frozenGlobal : BasePoint → FormNativeP286GaugeCoordinateTwoForm :=
    fun point =>
      fixedP506FormNativeConstitutiveActionInverse
        (1,
          holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput point)
  have outerDifferentiable :
      DifferentiableAt ℝ fixedP506FormNativeConstitutiveActionInverse
        (1,
          holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput 0) :=
    formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary_joint_differentiableAt
      FixedConstitutiveBoundary 1 (by norm_num)
      (holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput 0)
  have coframeDifferentiable :
      DifferentiableAt ℝ FixedConstitutiveInput.coframe 0 :=
    (StageNineCoframeHolonomicRegularity.holonomicCoframe_contDiff
      FixedConstitutiveInput
      fixedP506FormNativeJointActionSolvedSuccessor_smooth
      ).differentiable (by simp) |>.differentiableAt
  have curvatureDifferentiable :
      DifferentiableAt ℝ
        (holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput) 0 := by
    apply differentiableAt_pi.mpr
    intro pair
    exact
      (holonomicGaugeCurvature_coordinate_contDiff FixedConstitutiveInput
        fixedP506FormNativeJointActionSolvedSuccessor_smooth pair
        ).differentiable (by simp) |>.differentiableAt
  have liveGlobalDifferentiable :
      DifferentiableAt ℝ liveGlobal 0 := by
    have outerAtLiveOrigin :
        DifferentiableAt ℝ fixedP506FormNativeConstitutiveActionInverse
          (FixedConstitutiveInput.coframe 0,
            holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput 0) := by
      simpa [fixedP506FormNativeConstitutiveInput_coframe_origin] using
        outerDifferentiable
    have composed :=
      outerAtLiveOrigin.comp 0
        (coframeDifferentiable.prodMk curvatureDifferentiable)
    simpa [liveGlobal,
      fixedP506FormNativeConstitutiveInput_coframe_origin] using composed
  have frozenGlobalDifferentiable :
      DifferentiableAt ℝ frozenGlobal 0 := by
    have constantDifferentiable :
        DifferentiableAt ℝ
          (fun _ : BasePoint => (1 : LorentzianCoframe)) 0 :=
      differentiableAt_const (c := (1 : LorentzianCoframe))
    have jointDifferentiable :
        DifferentiableAt ℝ
          (fun point : BasePoint =>
            ((1 : LorentzianCoframe),
              holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput
                point))
          0 :=
      constantDifferentiable.prodMk curvatureDifferentiable
    have composed := outerDifferentiable.comp 0 jointDifferentiable
    simpa [frozenGlobal] using composed
  have outer :
      HasFDerivAt fixedP506FormNativeConstitutiveActionInverse
        (fderiv ℝ fixedP506FormNativeConstitutiveActionInverse
          (1,
            holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput 0))
        (1,
          holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput 0) :=
    outerDifferentiable.hasFDerivAt
  have outerAtLiveAxis :
      HasFDerivAt fixedP506FormNativeConstitutiveActionInverse
        (fderiv ℝ fixedP506FormNativeConstitutiveActionInverse
          (1,
            holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput 0))
        (fixedP506FormNativeConstitutiveLiveInputAxis direction 0) := by
    simpa [fixedP506FormNativeConstitutiveLiveInputAxis,
      fixedP506FormNativeConstitutiveCoordinateAxis,
      fixedP506FormNativeConstitutiveInput_coframe_origin] using outer
  have outerAtFrozenAxis :
      HasFDerivAt fixedP506FormNativeConstitutiveActionInverse
        (fderiv ℝ fixedP506FormNativeConstitutiveActionInverse
          (1,
            holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput 0))
        (fixedP506FormNativeConstitutiveFrozenInputAxis direction 0) := by
    simpa [fixedP506FormNativeConstitutiveFrozenInputAxis,
      fixedP506FormNativeConstitutiveCoordinateAxis] using outer
  have liveDirect :=
    outerAtLiveAxis.comp_hasDerivAt 0
      (fixedP506FormNativeConstitutiveLiveInputAxis_hasDerivAt direction)
  have frozenDirect :=
    outerAtFrozenAxis.comp_hasDerivAt 0
      (fixedP506FormNativeConstitutiveFrozenInputAxis_hasDerivAt direction)
  have liveGlobalAtAxis :
      HasFDerivAt liveGlobal (fderiv ℝ liveGlobal 0)
        (fixedP506FormNativeConstitutiveCoordinateAxis direction 0) := by
    simpa [fixedP506FormNativeConstitutiveCoordinateAxis] using
      liveGlobalDifferentiable.hasFDerivAt
  have frozenGlobalAtAxis :
      HasFDerivAt frozenGlobal (fderiv ℝ frozenGlobal 0)
        (fixedP506FormNativeConstitutiveCoordinateAxis direction 0) := by
    simpa [fixedP506FormNativeConstitutiveCoordinateAxis] using
      frozenGlobalDifferentiable.hasFDerivAt
  have liveExpected :=
    liveGlobalAtAxis.comp_hasDerivAt 0
      (fixedP506FormNativeConstitutiveCoordinateAxis_hasDerivAt direction)
  have frozenExpected :=
    frozenGlobalAtAxis.comp_hasDerivAt 0
      (fixedP506FormNativeConstitutiveCoordinateAxis_hasDerivAt direction)
  have liveFunctionEquality :
      (liveGlobal ∘ fixedP506FormNativeConstitutiveCoordinateAxis direction) =
        fixedP506FormNativeConstitutiveActionInverse ∘
          fixedP506FormNativeConstitutiveLiveInputAxis direction := by
    rfl
  have frozenFunctionEquality :
      (frozenGlobal ∘
          fixedP506FormNativeConstitutiveCoordinateAxis direction) =
        fixedP506FormNativeConstitutiveActionInverse ∘
          fixedP506FormNativeConstitutiveFrozenInputAxis direction := by
    rfl
  rw [liveFunctionEquality] at liveExpected
  rw [frozenFunctionEquality] at frozenExpected
  have liveDerivative :=
    liveExpected.unique liveDirect
  have frozenDerivative :=
    frozenExpected.unique frozenDirect
  have liveGlobalEquality :
      liveGlobal = fixedP506FormNativeConstitutiveAuxiliaryCoordinate := by
    funext point
    exact
      (fixedP506FormNativeConstitutiveAuxiliaryCoordinate_eq_actionInverse
        point).symm
  have frozenGlobalEquality :
      frozenGlobal =
        holonomicP286GaugeAuxiliaryCoordinate FixedConstitutiveInput := by
    funext point
    exact fixedP506FormNativeConstitutiveActionInverse_frozenCoframe point
  rw [liveGlobalEquality] at liveDerivative
  rw [frozenGlobalEquality] at frozenDerivative
  exact liveDerivative.trans frozenDerivative.symm

/-- The action-owned live constitutive write retains the complete canonical
P506/L0 auxiliary first jet at the fixed contact. -/
theorem
    fixedP506FormNativeConstitutiveJointActionSuccessor_auxiliaryDirectionalDerivative
    (direction : LorentzianIndex) :
    p286GaugeAuxiliaryDirectionalDerivative
        FixedP506FormNativeConstitutiveJointActionSuccessor 0 direction =
      fixedP506FormNativeJointActionAuxiliaryFirstJetLinear
        (coordinateDirection direction) := by
  unfold p286GaugeAuxiliaryDirectionalDerivative fieldDirectionalDerivative
  have newCoordinateEquality :
      holonomicP286GaugeAuxiliaryCoordinate
          FixedP506FormNativeConstitutiveJointActionSuccessor =
        fixedP506FormNativeConstitutiveAuxiliaryCoordinate := by
    funext point
    exact
      fixedP506FormNativeConstitutiveJointActionSuccessor_auxiliaryCoordinate
        point
  rw [newCoordinateEquality,
    fixedP506FormNativeConstitutiveAuxiliaryCoordinate_fderiv_eq_input]
  have oldCoordinateEquality :
      holonomicP286GaugeAuxiliaryCoordinate FixedConstitutiveInput =
        holonomicP286GaugeAuxiliaryCoordinate
          FixedP506JointActionSuccessor := by
    unfold holonomicP286GaugeAuxiliaryCoordinate
    rw [fixedP506FormNativeJointActionSolvedSuccessor_gaugeAuxiliary]
  rw [oldCoordinateEquality]
  exact
    fixedP506JointActionSuccessor_auxiliaryDirectionalDerivative direction

/-! ## Complete generated-slice first jet

The origin calculation above is not the end of the fixed-lineage producer.
KIN-16 already supplies the actual four-dimensional coframe jet on every
point of the generated time-zero slice.  Since that jet is the identity/zero
jet, the same action-owned live constitutive inverse and its frozen-coframe
presentation have equal directional derivatives at every such point.
-/

private theorem
    fixedP506FormNativeConstitutiveInput_coframeFirstJet_zeroSlice
    (space : StageNineSpatialPoint) :
    holonomicCoframeFirstJetAt FixedConstitutiveInput.coframe
        (canonicalCauchySlicePoint 0 space) =
      ({ coframe := 1, derivative := 0 } :
        PointwiseLorentzianCoframeJet) := by
  rw [fixedP506FormNativeConstitutiveInput_coframe_eq_complete,
    fixedGlobalMatterDualP286Complete_coframe,
    fixedGlobalMatterDualFullCauchy_coframe,
    fixedGlobalFullCauchy_coframe]
  exact fixedPrimitiveDiagonal_coframeFirstJet_zeroSlice space

private def fixedP506FormNativeConstitutiveCoordinateAxisAt
    (point : BasePoint) (direction : LorentzianIndex) : ℝ → BasePoint :=
  fun parameter =>
    parameter • coordinateDirection direction + point

private theorem
    fixedP506FormNativeConstitutiveCoordinateAxisAt_hasDerivAt
    (point : BasePoint) (direction : LorentzianIndex) :
    HasDerivAt
      (fixedP506FormNativeConstitutiveCoordinateAxisAt point direction)
      (coordinateDirection direction) 0 := by
  let line := fun parameter : ℝ =>
    parameter • coordinateDirection direction + point
  change HasDerivAt line (coordinateDirection direction) 0
  simpa [line] using
    ((hasDerivAt_id (𝕜 := ℝ) 0).smul_const
      (coordinateDirection direction)).add_const point

private theorem
    fixedP506FormNativeConstitutiveInput_coframeAxisAt_hasDerivAt_zero
    (space : StageNineSpatialPoint)
    (direction : LorentzianIndex) :
    HasDerivAt
      (fun parameter =>
        FixedConstitutiveInput.coframe
          (fixedP506FormNativeConstitutiveCoordinateAxisAt
            (canonicalCauchySlicePoint 0 space) direction parameter))
      0 0 := by
  apply hasDerivAt_pi.mpr
  intro internal
  apply hasDerivAt_pi.mpr
  intro coordinate
  let point := canonicalCauchySlicePoint 0 space
  let component := fun candidate : BasePoint =>
    FixedConstitutiveInput.coframe candidate internal coordinate
  have componentDifferentiable :
      DifferentiableAt ℝ component point :=
    ((contDiff_pi.mp
      (contDiff_pi.mp
        (StageNineCoframeHolonomicRegularity.holonomicCoframe_contDiff
          FixedConstitutiveInput
          fixedP506FormNativeJointActionSolvedSuccessor_smooth)
        internal)
      coordinate).differentiable (by simp)).differentiableAt
  have outerAtAxis :
      HasFDerivAt component (fderiv ℝ component point)
        (fixedP506FormNativeConstitutiveCoordinateAxisAt
          point direction 0) := by
    simpa [fixedP506FormNativeConstitutiveCoordinateAxisAt] using
      componentDifferentiable.hasFDerivAt
  have composed :=
    outerAtAxis.comp_hasDerivAt 0
      (fixedP506FormNativeConstitutiveCoordinateAxisAt_hasDerivAt
        point direction)
  have jetCoordinate :=
    congrArg
      (fun jet : PointwiseLorentzianCoframeJet =>
        jet.derivative direction internal coordinate)
      (fixedP506FormNativeConstitutiveInput_coframeFirstJet_zeroSlice space)
  have derivativeZero :
      (fderiv ℝ component point) (coordinateDirection direction) = 0 := by
    simpa [component, point, holonomicCoframeFirstJetAt] using
      jetCoordinate
  simpa [component, point, Function.comp_def, derivativeZero] using composed

private def fixedP506FormNativeConstitutiveCurvatureAxisDerivativeAt
    (point : BasePoint) (direction : LorentzianIndex) :
    FormNativeP286GaugeCoordinateTwoForm :=
  fun pair =>
    (fderiv ℝ
      (fun candidate =>
        holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput
          candidate pair)
      point) (coordinateDirection direction)

private theorem
    fixedP506FormNativeConstitutiveInput_curvatureAxisAt_hasDerivAt
    (point : BasePoint)
    (direction : LorentzianIndex) :
    HasDerivAt
      (fun parameter =>
        holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput
          (fixedP506FormNativeConstitutiveCoordinateAxisAt
            point direction parameter))
      (fixedP506FormNativeConstitutiveCurvatureAxisDerivativeAt
        point direction)
      0 := by
  apply hasDerivAt_pi.mpr
  intro pair
  have outer :
      HasFDerivAt
        (fun candidate =>
          holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput
            candidate pair)
        (fderiv ℝ
          (fun candidate =>
            holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput
              candidate pair)
          point)
        point :=
    ((holonomicGaugeCurvature_coordinate_contDiff FixedConstitutiveInput
      fixedP506FormNativeJointActionSolvedSuccessor_smooth pair)
      |>.differentiable (by simp)
