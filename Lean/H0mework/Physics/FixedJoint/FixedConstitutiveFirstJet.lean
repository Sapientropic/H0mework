/-! ## The forward inverse in its fixed faithful chart -/

private theorem fixedP506FormNativeBlockwiseCoupling_same
    (parameter : ℝ) (coordinate : P286CoordinateCarrier) :
    formNativeP286BlockwiseCouplingCoordinateLinear
        parameter parameter parameter coordinate =
      parameter • coordinate := by
  apply p286CoordinateEquiv.symm.injective
  simp [formNativeP286BlockwiseCouplingCoordinateLinear,
    formNativeP286BlockwiseCouplingActualLinear]
  apply Prod.ext
  · rfl
  · apply Prod.ext <;> rfl

private theorem
    fixedP506FormNativeCoordinateBlockwiseConstitutive_eq_unified
    (coframe : LorentzianCoframe)
    (form : FormNativeP286GaugeCoordinateTwoForm) :
    formNativeP286CoordinateBlockwiseConstitutive coframe
        ((FixedConstitutiveBoundary.strongCouplingSquared : ℝ))
        ((FixedConstitutiveBoundary.weakCouplingSquared : ℝ))
        ((FixedConstitutiveBoundary.hyperchargeCouplingSquared : ℝ))
        form =
      liftGaugeTwoFormOperator
        (((FixedConstitutiveBoundary.strongCouplingSquared : ℝ) •
          coframeGaugeSpacetimeHodgeLinear coframe))
        form := by
  have weakEq :
      ((FixedConstitutiveBoundary.weakCouplingSquared : ℝ)) =
        ((FixedConstitutiveBoundary.strongCouplingSquared : ℝ)) := by
    rfl
  have hyperchargeEq :
      ((FixedConstitutiveBoundary.hyperchargeCouplingSquared : ℝ)) =
        ((FixedConstitutiveBoundary.strongCouplingSquared : ℝ)) := by
    rfl
  rw [weakEq, hyperchargeEq,
    formNativeP286CoordinateBlockwiseConstitutive_eq_sum,
    liftGaugeTwoFormOperator_smul_operator_p286]
  funext output
  unfold liftGaugeTwoFormOperator
  simp only [Pi.smul_apply]
  simp_rw [fixedP506FormNativeBlockwiseCoupling_same]
  rw [Finset.smul_sum]
  apply Finset.sum_congr rfl
  intro input _
  module

private theorem
    fixedP506FormNativeConstitutiveAuxiliaryCoordinate_eq_actionInverse
    (point : BasePoint) :
    fixedP506FormNativeConstitutiveAuxiliaryCoordinate point =
      formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary
        FixedConstitutiveBoundary
        (FixedConstitutiveInput.coframe point)
        (holonomicP286GaugeCurvatureCoordinate
          FixedConstitutiveInput point) := by
  unfold fixedP506FormNativeConstitutiveAuxiliaryCoordinate
  change
    formNativeP286GaugeActualToCoordinateLinear
        (formNativeP286GaugeEliminatedAuxiliaryAtBoundary
          FixedConstitutiveBoundary
          (FixedConstitutiveInput.coframe point)
          (holonomicGaugeCurvature FixedConstitutiveInput point)) =
      formNativeP286GaugeActualToCoordinateLinear
        (formNativeP286GaugeEliminatedAuxiliaryAtBoundary
          FixedConstitutiveBoundary
          (FixedConstitutiveInput.coframe point)
          (formNativeP286GaugeCoordinateToActualLinear
            (formNativeP286GaugeActualToCoordinateLinear
              (holonomicGaugeCurvature FixedConstitutiveInput point))))
  rw [formNativeP286GaugeActual_coordinate_actual]

/-- With the coframe frozen to the generated identity value, the same
authoritative inverse returns the earlier source/action-owned auxiliary on
the whole explicit section. -/
theorem
    fixedP506FormNativeConstitutiveActionInverse_frozenCoframe
    (point : BasePoint) :
    formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary
        FixedConstitutiveBoundary 1
        (holonomicP286GaugeCurvatureCoordinate
          FixedConstitutiveInput point) =
      holonomicP286GaugeAuxiliaryCoordinate FixedConstitutiveInput point := by
  rw [
    fixedP506FormNativeJointActionSolvedSuccessor_curvatureCoordinate_normalForm,
    fixedP506FormNativeJointActionSolvedSuccessor_auxiliaryCoordinate_normalForm]
  have recovered :=
    formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary_constitutive
      FixedConstitutiveBoundary 1 (by norm_num)
      (c3h181FullAuxiliaryCoordinateNormalForm (-point))
  rw [fixedP506FormNativeCoordinateBlockwiseConstitutive_eq_unified] at recovered
  rw [c3h181FullAuxiliary_hodge_eq_curvature] at recovered
  exact recovered

