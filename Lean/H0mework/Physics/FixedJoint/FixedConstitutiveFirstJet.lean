theorem
    fixedP506FormNativeConstitutiveAuxiliaryCoordinate_fderiv_eq_input_zeroSlice
    (space : StageNineSpatialPoint)
    (direction : LorentzianIndex) :
    (fderiv ℝ fixedP506FormNativeConstitutiveAuxiliaryCoordinate
        (canonicalCauchySlicePoint 0 space))
        (coordinateDirection direction) =
      (fderiv ℝ
        (holonomicP286GaugeAuxiliaryCoordinate FixedConstitutiveInput)
        (canonicalCauchySlicePoint 0 space))
        (coordinateDirection direction) := by
  let point := canonicalCauchySlicePoint 0 space
  let liveGlobal : BasePoint → FormNativeP286GaugeCoordinateTwoForm :=
    fun candidate =>
      fixedP506FormNativeConstitutiveActionInverse
        (FixedConstitutiveInput.coframe candidate,
          holonomicP286GaugeCurvatureCoordinate
            FixedConstitutiveInput candidate)
  let frozenGlobal : BasePoint → FormNativeP286GaugeCoordinateTwoForm :=
    fun candidate =>
      fixedP506FormNativeConstitutiveActionInverse
        (1,
          holonomicP286GaugeCurvatureCoordinate
            FixedConstitutiveInput candidate)
  have coframeAtPoint :
      FixedConstitutiveInput.coframe point = 1 := by
    have jet :=
      fixedP506FormNativeConstitutiveInput_coframeFirstJet_zeroSlice space
    exact congrArg PointwiseLorentzianCoframeJet.coframe jet
  have outerDifferentiable :
      DifferentiableAt ℝ fixedP506FormNativeConstitutiveActionInverse
        (1,
          holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput
            point) :=
    formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary_joint_differentiableAt
      FixedConstitutiveBoundary 1 (by norm_num)
      (holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput point)
  have coframeDifferentiable :
      DifferentiableAt ℝ FixedConstitutiveInput.coframe point :=
    (StageNineCoframeHolonomicRegularity.holonomicCoframe_contDiff
      FixedConstitutiveInput
      fixedP506FormNativeJointActionSolvedSuccessor_smooth
      ).differentiable (by simp) |>.differentiableAt
  have curvatureDifferentiable :
      DifferentiableAt ℝ
        (holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput)
        point := by
    apply differentiableAt_pi.mpr
    intro pair
    exact
      (holonomicGaugeCurvature_coordinate_contDiff FixedConstitutiveInput
        fixedP506FormNativeJointActionSolvedSuccessor_smooth pair
        ).differentiable (by simp) |>.differentiableAt
  have liveGlobalDifferentiable :
      DifferentiableAt ℝ liveGlobal point := by
    have outerAtLivePoint :
        DifferentiableAt ℝ fixedP506FormNativeConstitutiveActionInverse
          (FixedConstitutiveInput.coframe point,
            holonomicP286GaugeCurvatureCoordinate
              FixedConstitutiveInput point) := by
      simpa [coframeAtPoint] using outerDifferentiable
    have composed :=
      outerAtLivePoint.comp point
        (coframeDifferentiable.prodMk curvatureDifferentiable)
    simpa [liveGlobal, coframeAtPoint] using composed
  have frozenGlobalDifferentiable :
      DifferentiableAt ℝ frozenGlobal point := by
    have constantDifferentiable :
        DifferentiableAt ℝ
          (fun _ : BasePoint => (1 : LorentzianCoframe)) point :=
      differentiableAt_const (c := (1 : LorentzianCoframe))
    have composed :=
      outerDifferentiable.comp point
        (constantDifferentiable.prodMk curvatureDifferentiable)
    simpa [frozenGlobal] using composed
  have outer :
      HasFDerivAt fixedP506FormNativeConstitutiveActionInverse
        (fderiv ℝ fixedP506FormNativeConstitutiveActionInverse
          (1,
            holonomicP286GaugeCurvatureCoordinate
              FixedConstitutiveInput point))
        (1,
          holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput
            point) :=
    outerDifferentiable.hasFDerivAt
  have outerAtLiveAxis :
      HasFDerivAt fixedP506FormNativeConstitutiveActionInverse
        (fderiv ℝ fixedP506FormNativeConstitutiveActionInverse
          (1,
            holonomicP286GaugeCurvatureCoordinate
              FixedConstitutiveInput point))
        (fixedP506FormNativeConstitutiveLiveInputAxisAt
          point direction 0) := by
    simpa [fixedP506FormNativeConstitutiveLiveInputAxisAt,
      fixedP506FormNativeConstitutiveCoordinateAxisAt,
      coframeAtPoint] using outer
  have outerAtFrozenAxis :
      HasFDerivAt fixedP506FormNativeConstitutiveActionInverse
        (fderiv ℝ fixedP506FormNativeConstitutiveActionInverse
          (1,
            holonomicP286GaugeCurvatureCoordinate
              FixedConstitutiveInput point))
        (fixedP506FormNativeConstitutiveFrozenInputAxisAt
          point direction 0) := by
    simpa [fixedP506FormNativeConstitutiveFrozenInputAxisAt,
      fixedP506FormNativeConstitutiveCoordinateAxisAt] using outer
  have liveDirect :=
    outerAtLiveAxis.comp_hasDerivAt 0
      (fixedP506FormNativeConstitutiveLiveInputAxisAt_hasDerivAt
        space direction)
  have frozenDirect :=
    outerAtFrozenAxis.comp_hasDerivAt 0
      (fixedP506FormNativeConstitutiveFrozenInputAxisAt_hasDerivAt
        point direction)
  have liveGlobalAtAxis :
      HasFDerivAt liveGlobal (fderiv ℝ liveGlobal point)
        (fixedP506FormNativeConstitutiveCoordinateAxisAt
          point direction 0) := by
    simpa [fixedP506FormNativeConstitutiveCoordinateAxisAt] using
      liveGlobalDifferentiable.hasFDerivAt
  have frozenGlobalAtAxis :
      HasFDerivAt frozenGlobal (fderiv ℝ frozenGlobal point)
        (fixedP506FormNativeConstitutiveCoordinateAxisAt
          point direction 0) := by
    simpa [fixedP506FormNativeConstitutiveCoordinateAxisAt] using
      frozenGlobalDifferentiable.hasFDerivAt
  have liveExpected :=
    liveGlobalAtAxis.comp_hasDerivAt 0
      (fixedP506FormNativeConstitutiveCoordinateAxisAt_hasDerivAt
        point direction)
  have frozenExpected :=
    frozenGlobalAtAxis.comp_hasDerivAt 0
      (fixedP506FormNativeConstitutiveCoordinateAxisAt_hasDerivAt
        point direction)
  have liveFunctionEquality :
      (liveGlobal ∘
          fixedP506FormNativeConstitutiveCoordinateAxisAt point direction) =
        fixedP506FormNativeConstitutiveActionInverse ∘
          fixedP506FormNativeConstitutiveLiveInputAxisAt
            point direction := by
    rfl
  have frozenFunctionEquality :
      (frozenGlobal ∘
          fixedP506FormNativeConstitutiveCoordinateAxisAt point direction) =
        fixedP506FormNativeConstitutiveActionInverse ∘
          fixedP506FormNativeConstitutiveFrozenInputAxisAt
            point direction := by
    rfl
  rw [liveFunctionEquality] at liveExpected
  rw [frozenFunctionEquality] at frozenExpected
  have liveDerivative :=
    liveExpected.unique liveDirect
  have frozenDerivative :=
    frozenExpected.unique frozenDirect
  have liveGlobalEquality :
      liveGlobal = fixedP506FormNativeConstitutiveAuxiliaryCoordinate := by
    funext candidate
    exact
      (fixedP506FormNativeConstitutiveAuxiliaryCoordinate_eq_actionInverse
        candidate).symm
  have frozenGlobalEquality :
      frozenGlobal =
        holonomicP286GaugeAuxiliaryCoordinate FixedConstitutiveInput := by
    funext candidate
    exact fixedP506FormNativeConstitutiveActionInverse_frozenCoframe
      candidate
  rw [liveGlobalEquality] at liveDerivative
  rw [frozenGlobalEquality] at frozenDerivative
  simpa [point] using liveDerivative.trans frozenDerivative.symm

/-- The generated live constitutive auxiliary coordinate is differentiable
at every occurrence of the fixed P506/L0 time-zero slice.  This is the
regularity mouth used when the same action inverse is transported to a
matching spatially recentered contact. -/
theorem
    fixedP506FormNativeConstitutiveAuxiliaryCoordinate_differentiableAt_zeroSlice
    (space : StageNineSpatialPoint) :
    DifferentiableAt ℝ fixedP506FormNativeConstitutiveAuxiliaryCoordinate
      (canonicalCauchySlicePoint 0 space) := by
  let point := canonicalCauchySlicePoint 0 space
  let liveGlobal : BasePoint → FormNativeP286GaugeCoordinateTwoForm :=
    fun candidate =>
      fixedP506FormNativeConstitutiveActionInverse
        (FixedConstitutiveInput.coframe candidate,
          holonomicP286GaugeCurvatureCoordinate
            FixedConstitutiveInput candidate)
  have coframeAtPoint : FixedConstitutiveInput.coframe point = 1 := by
    have jet :=
      fixedP506FormNativeConstitutiveInput_coframeFirstJet_zeroSlice space
    exact congrArg PointwiseLorentzianCoframeJet.coframe jet
  have outerDifferentiable :
      DifferentiableAt ℝ fixedP506FormNativeConstitutiveActionInverse
        (1,
          holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput
            point) :=
    formNativeP286GaugeEliminatedAuxiliaryCoordinateAtBoundary_joint_differentiableAt
      FixedConstitutiveBoundary 1 (by norm_num)
      (holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput point)
  have coframeDifferentiable :
      DifferentiableAt ℝ FixedConstitutiveInput.coframe point :=
    (StageNineCoframeHolonomicRegularity.holonomicCoframe_contDiff
      FixedConstitutiveInput
      fixedP506FormNativeJointActionSolvedSuccessor_smooth
      ).differentiable (by simp) |>.differentiableAt
  have curvatureDifferentiable :
      DifferentiableAt ℝ
        (holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput)
        point := by
    apply differentiableAt_pi.mpr
    intro pair
    exact
      (holonomicGaugeCurvature_coordinate_contDiff FixedConstitutiveInput
        fixedP506FormNativeJointActionSolvedSuccessor_smooth pair
        ).differentiable (by simp) |>.differentiableAt
  have liveDifferentiable : DifferentiableAt ℝ liveGlobal point := by
    have outerAtLive :
        DifferentiableAt ℝ fixedP506FormNativeConstitutiveActionInverse
          (FixedConstitutiveInput.coframe point,
            holonomicP286GaugeCurvatureCoordinate FixedConstitutiveInput
              point) := by
      simpa only [coframeAtPoint] using outerDifferentiable
    have composed := outerAtLive.comp point
      (coframeDifferentiable.prodMk curvatureDifferentiable)
    simpa [liveGlobal] using composed
  have liveGlobalEquality :
      liveGlobal = fixedP506FormNativeConstitutiveAuxiliaryCoordinate := by
    funext candidate
    exact
      (fixedP506FormNativeConstitutiveAuxiliaryCoordinate_eq_actionInverse
        candidate).symm
  rw [← liveGlobalEquality]
  exact liveDifferentiable

/-- The action-owned constitutive write retains the complete P506/L0
auxiliary first jet at every point of the generated time-zero slice. -/
theorem
    fixedP506FormNativeConstitutiveJointActionSuccessor_auxiliaryDirectionalDerivative_zeroSlice
    (space : StageNineSpatialPoint)
