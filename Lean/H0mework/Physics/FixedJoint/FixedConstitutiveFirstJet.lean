          point)
        (fixedP506FormNativeConstitutiveCoordinateAxisAt
          point direction 0) := by
    simpa [fixedP506FormNativeConstitutiveCoordinateAxisAt] using outer
  have composed :=
    outerAtAxis.comp_hasDerivAt 0
      (fixedP506FormNativeConstitutiveCoordinateAxisAt_hasDerivAt
        point direction)
  simpa [fixedP506FormNativeConstitutiveCoordinateAxisAt,
    fixedP506FormNativeConstitutiveCurvatureAxisDerivativeAt,
    Function.comp_def] using composed

