import H0mework.Physics.FixedJoint.FixedJointResidual

/-!
# Fixed P506/L0 form-native joint action write

The complete repaired-root residual calculation shows that the fixed
P506/L0 actual has exactly one supported origin coordinate: the form-native
P286 connection three-form.  This module does not turn that coordinate into
a separate gate and does not define a correction as the negative residual.

Instead, the authoritative connection Euler form

`D_A B + S_charged`

fixes the physical-current convention `J = -S_charged`.  The existing
finite-dimensional BF Legendre and Lie-pairing equivalences then generate
the unique temporal and Gauss response, and one origin-faithful write
installs both on the same current actual.  The full-carrier support theorem
is used only to justify that this one action-owned write is the complete
joint write at the fixed contact.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeFixedP506JointActionWrite

open ProofFreeRicherAnholonomicSource
open RepresentationArithmeticAtomProjectionDefect.BorromeanPreRealization
open StageNineCurrentP286CompleteActionResponseOperator
open StageNineDiracDualFormNativeFixedP506JointResidual
open StageNineDiracDualFormNativeIdentityECHessianCartanECNormalFixedGlobalMatterDualP286CompleteActual
open StageNineDiracDualFormNativeJointResidualCarrier
open StageNineEnrichedProofFreeSource
open StageNineFormNativeChargedGaugeCurrentThreeForm
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineP286ActionCanonicalPairUpdate
open StageNineP286ActionCauchySplit
open StageNineP286ActionVelocityLocalActualLift
open StageNineP286GaugeAuxiliaryVariation
open StageNineP286GaugeConnectionVariation
open StageNineSourceActionGeneratedP286GaussJointLocalActualLift
open StageNineSourceActionGeneratedP286MomentumJointLocalActualLift
open StageNineSourceActionGeneratedP506MatterCurrentP286CompleteResponseLocalActualLift
open SU7MotherGaugeTheory
open SU7MotherLieAlgebra

open scoped ContDiff

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1200000
set_option maxRecDepth 100000

local instance fixedJointWriteP286ModuleFinite :
    Module.Finite ℝ P286LieBlockData :=
  FiniteDimensional.of_injective p286AmbientLinear
    p286AmbientLinear_injective

local instance fixedJointWriteP286CoordinateIndexFintype :
    Fintype P286CoordinateIndex :=
  Fintype.ofFinite P286CoordinateIndex

local instance fixedJointWriteP286CoordinateIsTopologicalAddGroup :
    IsTopologicalAddGroup P286CoordinateCarrier where
  toContinuousAdd := inferInstance
  toContinuousNeg := inferInstance

private def FixedJointWriteCurrent : StageNineHolonomicConfiguration :=
  FixedP506JointActual

/-! ## Action-owned dual and its unique response -/

/-- Physical current dual generated by the authoritative form-native action.
The minus sign is fixed by `D_A B + S_charged = 0`; it is not read from a
residual coordinate. -/
def fixedP506FormNativeP286ActionTarget :
    Module.Dual ℝ P286GaugeOneForm :=
  -formNativeChargedGaugeFirstLinearMap positiveSmoothUnifiedSource 0 0
    (toContinuumPointField FixedJointWriteCurrent 0)

theorem fixedP506FormNativeP286ActionTarget_eq_neg_charged :
    fixedP506FormNativeP286ActionTarget =
      -formNativeChargedGaugeFirstLinearMap positiveSmoothUnifiedSource 0 0
        (toContinuumPointField FixedP506JointActual 0) := by
  rfl

theorem fixedP506FormNativeP286ActionTarget_eq_neg_currentAction :
    fixedP506FormNativeP286ActionTarget =
      -currentP286FullActionTarget positiveSmoothUnifiedSource
        FixedJointWriteCurrent := by
  apply LinearMap.ext
  intro direction
  unfold fixedP506FormNativeP286ActionTarget
  simp only [LinearMap.neg_apply]
  congr 1
  unfold FixedJointWriteCurrent
  exact
    (fixedP506JointActual_actionCurrent_eq_formNativeCharged direction).symm

def fixedP506FormNativeP286SpatialActionTarget :
    Module.Dual ℝ P286SpatialGaugeDirection :=
  fixedP506FormNativeP286ActionTarget.comp
    canonicalP286SpatialActionInclusion

def fixedP506FormNativeP286TemporalActionTarget :
    Module.Dual ℝ P286CoordinateCarrier :=
  fixedP506FormNativeP286ActionTarget.comp
    canonicalP286TemporalActionInclusion

/-- Unique temporal auxiliary response generated through the already proved
BF Legendre equivalence. -/
def fixedP506FormNativeP286SpatialAuxiliaryVelocity :
    P286SpatialGaugeDirection :=
  p286SpatialBFLegendreEquiv.symm
    fixedP506FormNativeP286SpatialActionTarget

/-- Unique Gauss charge generated through the faithful Lie pairing. -/
def fixedP506FormNativeP286GaussCharge : P286CoordinateCarrier :=
  p286CoordinateLiePairingEquiv.symm
    fixedP506FormNativeP286TemporalActionTarget

theorem fixedP506FormNativeP286SpatialAuxiliaryVelocity_response :
    p286SpatialBFLegendreDualOperator
        fixedP506FormNativeP286SpatialAuxiliaryVelocity =
      fixedP506FormNativeP286SpatialActionTarget := by
  exact p286SpatialBFLegendreEquiv.apply_symm_apply _

theorem fixedP506FormNativeP286SpatialAuxiliaryVelocity_unique
    (candidate : P286SpatialGaugeDirection)
    (response :
      p286SpatialBFLegendreDualOperator candidate =
        fixedP506FormNativeP286SpatialActionTarget) :
    candidate = fixedP506FormNativeP286SpatialAuxiliaryVelocity :=
  p286SpatialBFLegendreEquiv_unique _ candidate response

theorem fixedP506FormNativeP286GaussCharge_response
    (component : P286CoordinateCarrier) :
    p286CoordinateLiePairing fixedP506FormNativeP286GaussCharge component =
      fixedP506FormNativeP286TemporalActionTarget component := by
  change
    p286CoordinateLiePairingEquiv
        (p286CoordinateLiePairingEquiv.symm
          fixedP506FormNativeP286TemporalActionTarget) component =
      fixedP506FormNativeP286TemporalActionTarget component
  rw [p286CoordinateLiePairingEquiv.apply_symm_apply]

theorem fixedP506FormNativeP286GaussCharge_unique
    (candidate : P286CoordinateCarrier)
    (response : ∀ component,
      p286CoordinateLiePairing candidate component =
        fixedP506FormNativeP286TemporalActionTarget component) :
    candidate = fixedP506FormNativeP286GaussCharge := by
  apply p286CoordinateLiePairingDualOperator_injective
  apply LinearMap.ext
  intro component
  rw [p286CoordinateLiePairingDualOperator_apply,
    p286CoordinateLiePairingDualOperator_apply,
    response, fixedP506FormNativeP286GaussCharge_response]

/-! ## One common origin-faithful write -/

def fixedP506FormNativeJointActionAuxiliaryCoordinate
    (point : BasePoint) : P286GaugeTwoForm :=
  currentP286OriginAuxiliaryCoordinate FixedJointWriteCurrent +
    point canonicalLorentzianTimeDirection •
      p286SpatialAuxiliaryVelocityEmbedding
        fixedP506FormNativeP286SpatialAuxiliaryVelocity +
    currentP286CanonicalGaussRadialAuxiliaryProfile
      fixedP506FormNativeP286GaussCharge point

def fixedP506FormNativeJointActionAuxiliaryField :
    BasePoint → Fin 6 → P286LieBlockData :=
  fun point pair =>
    p286CoordinateEquiv.symm
      (fixedP506FormNativeJointActionAuxiliaryCoordinate point pair)

/-- The same-source next common actual.  Only the field selected by the
complete origin support is changed, but the output is one whole
`StageNineHolonomicConfiguration`, not a P286 endpoint or residual patch. -/
def FixedP506JointActionSuccessor : StageNineHolonomicConfiguration :=
  installGeneratedGaugeAuxiliaryGerm FixedJointWriteCurrent
    fixedP506FormNativeJointActionAuxiliaryField

@[simp] theorem fixedP506FormNativeJointActionAuxiliaryCoordinate_origin :
    fixedP506FormNativeJointActionAuxiliaryCoordinate 0 =
      currentP286OriginAuxiliaryCoordinate FixedJointWriteCurrent := by
  simp [fixedP506FormNativeJointActionAuxiliaryCoordinate]

theorem fixedP506FormNativeJointActionAuxiliaryField_origin :
    fixedP506FormNativeJointActionAuxiliaryField 0 =
      FixedJointWriteCurrent.gaugeAuxiliary 0 := by
  funext pair
  apply p286CoordinateEquiv.injective
  simp [fixedP506FormNativeJointActionAuxiliaryField,
    currentP286OriginAuxiliaryCoordinate]

theorem fixedP506JointActionSuccessor_pointField_origin :
    toContinuumPointField FixedP506JointActionSuccessor 0 =
      toContinuumPointField FixedP506JointActual 0 := by
  calc
    _ = toContinuumPointField FixedJointWriteCurrent 0 :=
      installGeneratedGaugeAuxiliaryGerm_pointField_eq_of_contact
        FixedJointWriteCurrent
        fixedP506FormNativeJointActionAuxiliaryField 0
        fixedP506FormNativeJointActionAuxiliaryField_origin
    _ = _ := by rfl

@[simp] theorem fixedP506JointActionSuccessor_coframe :
    FixedP506JointActionSuccessor.coframe =
      FixedP506JointActual.coframe := by
  change FixedJointWriteCurrent.coframe = FixedP506JointActual.coframe
  rfl

@[simp] theorem fixedP506JointActionSuccessor_gravityConnection :
    FixedP506JointActionSuccessor.gravityConnection =
      FixedP506JointActual.gravityConnection := by
  change
    FixedJointWriteCurrent.gravityConnection =
      FixedP506JointActual.gravityConnection
  rfl

@[simp] theorem fixedP506JointActionSuccessor_gravityAuxiliary :
    FixedP506JointActionSuccessor.gravityAuxiliary =
      FixedP506JointActual.gravityAuxiliary := by
  change
    FixedJointWriteCurrent.gravityAuxiliary =
      FixedP506JointActual.gravityAuxiliary
  rfl

@[simp] theorem fixedP506JointActionSuccessor_multiplier :
