theorem fixedP506JointActionSuccessor_exactLineage :
    positiveSmoothUnifiedSource.stageEight.generatedP506L0Lineage =
      canonicalP506SourceAffineL0ObservableLineageReference :=
  positiveSmoothUnifiedSource_generates_exactP506L0Lineage

theorem fixedP506FormNativeJointActionAuxiliaryCoordinate_contDiff
    (pair : Fin 6) :
    ContDiff ℝ ∞ fun point : BasePoint =>
      fixedP506FormNativeJointActionAuxiliaryCoordinate point pair := by
  have originSmooth :
      ContDiff ℝ ∞ fun _ : BasePoint =>
        currentP286OriginAuxiliaryCoordinate FixedJointWriteCurrent pair :=
    contDiff_const
  have timeSmooth :
      ContDiff ℝ ∞ fun point : BasePoint =>
        point canonicalLorentzianTimeDirection •
          p286SpatialAuxiliaryVelocityEmbedding
            fixedP506FormNativeP286SpatialAuxiliaryVelocity pair := by
    simpa only [localBaseCoordinate_apply] using
      ((localBaseCoordinate canonicalLorentzianTimeDirection).contDiff
        |>.smul_const
          (p286SpatialAuxiliaryVelocityEmbedding
            fixedP506FormNativeP286SpatialAuxiliaryVelocity pair))
  have radialSmooth :
      ContDiff ℝ ∞ fun point : BasePoint =>
        currentP286CanonicalGaussRadialAuxiliaryProfile
          fixedP506FormNativeP286GaussCharge point pair :=
    currentP286CanonicalGaussRadialAuxiliaryProfile_contDiff _ pair
  change ContDiff ℝ ∞ fun point : BasePoint =>
    (currentP286OriginAuxiliaryCoordinate FixedJointWriteCurrent +
      point canonicalLorentzianTimeDirection •
        p286SpatialAuxiliaryVelocityEmbedding
          fixedP506FormNativeP286SpatialAuxiliaryVelocity +
      currentP286CanonicalGaussRadialAuxiliaryProfile
        fixedP506FormNativeP286GaussCharge point) pair
  simpa only [Pi.add_apply, Pi.smul_apply] using
    ((originSmooth.add timeSmooth).add radialSmooth)

theorem fixedP506JointActionSuccessor_smooth :
    FixedP506JointActionSuccessor.Smooth := by
  have currentSmooth : FixedJointWriteCurrent.Smooth := by
    simpa only [FixedJointWriteCurrent] using
      fixedGlobalMatterDualP286Complete_smooth
  rcases currentSmooth with
    ⟨coframe, gravityConnection, gravityAuxiliary, multiplier,
      gaugeConnection, _gaugeAuxiliary, scalar, matter, conjugate⟩
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · simpa only [FixedP506JointActionSuccessor,
      installGeneratedGaugeAuxiliaryGerm] using coframe
  · simpa only [FixedP506JointActionSuccessor,
      installGeneratedGaugeAuxiliaryGerm] using gravityConnection
  · simpa only [FixedP506JointActionSuccessor,
      installGeneratedGaugeAuxiliaryGerm] using gravityAuxiliary
  · simpa only [FixedP506JointActionSuccessor,
      installGeneratedGaugeAuxiliaryGerm] using multiplier
  · simpa only [FixedP506JointActionSuccessor,
      installGeneratedGaugeAuxiliaryGerm] using gaugeConnection
  · intro pair
    change ContDiff ℝ ∞ fun point : BasePoint =>
      p286CoordinateEquiv
        (fixedP506FormNativeJointActionAuxiliaryField point pair)
    rw [show
      (fun point : BasePoint =>
        p286CoordinateEquiv
          (fixedP506FormNativeJointActionAuxiliaryField point pair)) =
        (fun point : BasePoint =>
          fixedP506FormNativeJointActionAuxiliaryCoordinate point pair) by
      funext point
      exact p286CoordinateEquiv.apply_symm_apply _]
    exact fixedP506FormNativeJointActionAuxiliaryCoordinate_contDiff pair
  · simpa only [FixedP506JointActionSuccessor,
      installGeneratedGaugeAuxiliaryGerm] using scalar
  · simpa only [FixedP506JointActionSuccessor,
      installGeneratedGaugeAuxiliaryGerm] using matter
  · simpa only [FixedP506JointActionSuccessor,
      installGeneratedGaugeAuxiliaryGerm] using conjugate

/-- The whole-carrier calculation, not an isolated projection, licenses this
single supported action write at the fixed contact. -/
theorem fixedP506JointActionWrite_completeSupport :
    fixedP506JointResidualSection 0 =
        fixedP506JointOriginResidualNormalForm ∧
      fixedP506JointResidualSection 0 ≠ 0 :=
  ⟨fixedP506JointResidual_origin_normalForm,
    fixedP506JointResidual_origin_ne_zero⟩

end

end
