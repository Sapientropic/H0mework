import H0mework.Physics.AlphaSpectrum.P856

/-!
# Proposition 857: alpha strong residual from generated spectra, no packet

P856 generated the four alpha-strong source coordinates from representation
spectra, but still used the P851 packet's denominator.  This file removes that
last packet dependency from the vector itself: the denominator is generated by
the same finite-spectrum evaluator as the sources,

`(|Fin 7| + |Fin 3|)^4 = 10000`.

The resulting no-packet vector is then welded back to P856/P851/P792.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open scoped BigOperators

set_option linter.defProp false

/-- The QCD-side resolution modes in the generated alpha-strong denominator. -/
abbrev AlphaStrongGeneratedQCDResolutionMode := Fin 7

/-- The Poincare-side resolution slots in the generated alpha-strong denominator. -/
abbrev AlphaStrongGeneratedPoincareResolutionMode := Fin 3

/-- The generated QCD/Poincare resolution axis. -/
def alphaStrongGeneratedResolutionAxis : ℚ :=
  finiteUnitSpectrumTrace AlphaStrongGeneratedQCDResolutionMode +
    finiteUnitSpectrumTrace AlphaStrongGeneratedPoincareResolutionMode

theorem alphaStrongGeneratedResolutionAxis_eq_ten :
    alphaStrongGeneratedResolutionAxis = 10 := by
  unfold alphaStrongGeneratedResolutionAxis
  rw [finiteUnitSpectrumTrace_eq_card, finiteUnitSpectrumTrace_eq_card]
  norm_num

/-- The generated denominator used by all non-RG source coordinates. -/
def alphaStrongGeneratedResolutionDenominator : ℚ :=
  alphaStrongGeneratedResolutionAxis ^ alphaStrongResidualResolutionExponent

theorem alphaStrongGeneratedResolutionDenominator_eq_10000 :
    alphaStrongGeneratedResolutionDenominator = 10000 := by
  unfold alphaStrongGeneratedResolutionDenominator
  rw [alphaStrongGeneratedResolutionAxis_eq_ten]
  norm_num [alphaStrongResidualResolutionExponent]

theorem alphaStrongGeneratedResolutionDenominator_eq_packet :
    alphaStrongGeneratedResolutionDenominator =
      canonicalAlphaStrongRepresentationSpectrumPacket.resolutionDenominator := by
  rw [alphaStrongGeneratedResolutionDenominator_eq_10000,
    canonicalRepresentationSpectrum_denominator_eq_10000]

/-- The fully generated alpha-strong four-source vector, with no packet field
appearing in its definition. -/
def alphaStrongNoPacketGeneratedFourSourceVector :
    AlphaStrongResidualSource → ℚ
  | .su7Breaking =>
      alphaStrongSU7BreakingGeneratedImbalance /
        alphaStrongGeneratedResolutionDenominator
  | .threshold =>
      alphaStrongThresholdGeneratedImbalance /
        alphaStrongGeneratedResolutionDenominator
  | .threeLoopRG => alphaStrongGeneratedThreeLoopRGCoordinate
  | .higgsExtraRepresentation =>
      alphaStrongHiggsExtraGeneratedImbalance /
        alphaStrongGeneratedResolutionDenominator

theorem alphaStrongNoPacketGeneratedFourSourceVector_su7Breaking :
    alphaStrongNoPacketGeneratedFourSourceVector .su7Breaking =
      89 / 10000 := by
  unfold alphaStrongNoPacketGeneratedFourSourceVector
  rw [alphaStrongSU7BreakingGeneratedImbalance_eq_89,
    alphaStrongGeneratedResolutionDenominator_eq_10000]

theorem alphaStrongNoPacketGeneratedFourSourceVector_threshold :
    alphaStrongNoPacketGeneratedFourSourceVector .threshold = 0 := by
  unfold alphaStrongNoPacketGeneratedFourSourceVector
  rw [alphaStrongThresholdGeneratedImbalance_eq_zero]
  norm_num

theorem alphaStrongNoPacketGeneratedFourSourceVector_threeLoopRG :
    alphaStrongNoPacketGeneratedFourSourceVector .threeLoopRG = 0 := by
  unfold alphaStrongNoPacketGeneratedFourSourceVector
  exact alphaStrongGeneratedThreeLoopRGCoordinate_eq_zero

theorem alphaStrongNoPacketGeneratedFourSourceVector_higgsExtra :
    alphaStrongNoPacketGeneratedFourSourceVector .higgsExtraRepresentation =
      0 := by
  unfold alphaStrongNoPacketGeneratedFourSourceVector
  rw [alphaStrongHiggsExtraGeneratedImbalance_eq_zero]
  norm_num

/-- The no-packet vector agrees with the P856 generated representation vector. -/
theorem alphaStrongNoPacketGeneratedFourSourceVector_eq_generated :
    alphaStrongNoPacketGeneratedFourSourceVector =
      alphaStrongGeneratedRepresentationFourSourceVector := by
  funext source
  cases source
  · rw [alphaStrongNoPacketGeneratedFourSourceVector_su7Breaking,
      alphaStrongGeneratedRepresentationFourSourceVector_su7Breaking]
  · rw [alphaStrongNoPacketGeneratedFourSourceVector_threshold,
      alphaStrongGeneratedRepresentationFourSourceVector_threshold]
  · rw [alphaStrongNoPacketGeneratedFourSourceVector_threeLoopRG,
      alphaStrongGeneratedRepresentationFourSourceVector_threeLoopRG]
  · rw [alphaStrongNoPacketGeneratedFourSourceVector_higgsExtra,
      alphaStrongGeneratedRepresentationFourSourceVector_higgsExtra]

theorem alphaStrongNoPacketGeneratedFourSourceVector_eq_packet :
    alphaStrongNoPacketGeneratedFourSourceVector =
      canonicalAlphaStrongRepresentationSpectrumPacket.fourSourceVector := by
  rw [alphaStrongNoPacketGeneratedFourSourceVector_eq_generated,
    alphaStrongGeneratedRepresentationFourSourceVector_eq_packet]

theorem alphaStrongNoPacketGeneratedFourSourceVector_eq_primitive :
    alphaStrongNoPacketGeneratedFourSourceVector =
      su7AlphaStrongFourSourcePrimitiveGenerator := by
  rw [alphaStrongNoPacketGeneratedFourSourceVector_eq_generated,
    alphaStrongGeneratedRepresentationFourSourceVector_eq_primitive]

theorem alphaStrongNoPacketGeneratedFourSourceVector_eq_independent :
    alphaStrongNoPacketGeneratedFourSourceVector =
      alphaStrongFourSourceIndependentContribution := by
  rw [alphaStrongNoPacketGeneratedFourSourceVector_eq_generated,
    alphaStrongGeneratedRepresentationFourSourceVector_eq_independent]

theorem alphaStrongNoPacketGeneratedFourSourceVector_outputs_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          alphaStrongNoPacketGeneratedFourSourceVector s) =
      -((89000 : ℚ) / 128511) := by
  rw [alphaStrongNoPacketGeneratedFourSourceVector_eq_generated]
  exact alphaStrongGeneratedRepresentationFourSourceVector_outputs_residual

/-- Certificate: every coordinate and the denominator of the alpha-strong
source vector are generated from finite representation spectra before transport
to the inverse residual. -/
structure AlphaStrongNoPacketGeneratedSpectrumCertificate : Prop where
  axis :
    alphaStrongGeneratedResolutionAxis = 10
  denominator :
    alphaStrongGeneratedResolutionDenominator = 10000
  su7Breaking :
    alphaStrongNoPacketGeneratedFourSourceVector .su7Breaking = 89 / 10000
  threshold :
    alphaStrongNoPacketGeneratedFourSourceVector .threshold = 0
  threeLoopRG :
    alphaStrongNoPacketGeneratedFourSourceVector .threeLoopRG = 0
  higgsExtra :
    alphaStrongNoPacketGeneratedFourSourceVector .higgsExtraRepresentation = 0
  vectorGenerated :
    alphaStrongNoPacketGeneratedFourSourceVector =
      alphaStrongGeneratedRepresentationFourSourceVector
  vectorPrimitive :
    alphaStrongNoPacketGeneratedFourSourceVector =
      su7AlphaStrongFourSourcePrimitiveGenerator
  residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          alphaStrongNoPacketGeneratedFourSourceVector s) =
      -((89000 : ℚ) / 128511)

def alphaStrongNoPacketGeneratedSpectrumCertificate :
    AlphaStrongNoPacketGeneratedSpectrumCertificate where
  axis := alphaStrongGeneratedResolutionAxis_eq_ten
  denominator := alphaStrongGeneratedResolutionDenominator_eq_10000
  su7Breaking := alphaStrongNoPacketGeneratedFourSourceVector_su7Breaking
  threshold := alphaStrongNoPacketGeneratedFourSourceVector_threshold
  threeLoopRG := alphaStrongNoPacketGeneratedFourSourceVector_threeLoopRG
  higgsExtra := alphaStrongNoPacketGeneratedFourSourceVector_higgsExtra
  vectorGenerated := alphaStrongNoPacketGeneratedFourSourceVector_eq_generated
  vectorPrimitive := alphaStrongNoPacketGeneratedFourSourceVector_eq_primitive
  residual := alphaStrongNoPacketGeneratedFourSourceVector_outputs_residual


end
end StandardModelConstraint
end SaturationMonoid
