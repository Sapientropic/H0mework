import H0mework.Physics.AlphaSpectrum.P851

/-!
# Proposition 856: alpha strong residual from generated representation spectra

This file pushes the alpha-strong producer one layer below the representation
packet of Proposition 851.  The four source coordinates are computed by a
uniform finite-spectrum evaluator:

* SU(7) breaking is the trace difference `(128 + 9) - 48`.
* Threshold and Higgs/extra terms are balanced trace differences.
* The RG coordinate is a raw loop spectrum plus its finite counterterm.

The result is the same four-source vector as Proposition 851, but now the
nonzero source is generated by the representation-spectrum arithmetic rather
than read directly as a complement carrier of size 89.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open scoped BigOperators

set_option linter.defProp false

/-- The information-state side of the alpha-strong SU(7) breaking spectrum. -/
abbrev AlphaStrongInformationStateMode := Fin 128

/-- The unbroken low-energy gauge side contributing to the alpha-em anchor. -/
abbrev AlphaStrongUnbrokenGaugeMode := Fin 9

/-- The SU(7) adjoint gauge spectrum. -/
abbrev AlphaStrongSU7AdjointGaugeMode := Fin 48

/-- The positive side of the SU(7) breaking trace: information states plus
unbroken low-energy gauge modes. -/
def alphaStrongSU7BreakingPositiveTrace : ℚ :=
  finiteUnitSpectrumTrace AlphaStrongInformationStateMode +
    finiteUnitSpectrumTrace AlphaStrongUnbrokenGaugeMode

/-- The negative side of the SU(7) breaking trace: the SU(7) adjoint. -/
def alphaStrongSU7BreakingNegativeTrace : ℚ :=
  finiteUnitSpectrumTrace AlphaStrongSU7AdjointGaugeMode

/-- The generated SU(7) breaking imbalance. -/
def alphaStrongSU7BreakingGeneratedImbalance : ℚ :=
  alphaStrongSU7BreakingPositiveTrace - alphaStrongSU7BreakingNegativeTrace

theorem alphaStrongSU7BreakingPositiveTrace_eq_137 :
    alphaStrongSU7BreakingPositiveTrace = 137 := by
  unfold alphaStrongSU7BreakingPositiveTrace
  rw [finiteUnitSpectrumTrace_eq_card, finiteUnitSpectrumTrace_eq_card]
  norm_num

theorem alphaStrongSU7BreakingNegativeTrace_eq_48 :
    alphaStrongSU7BreakingNegativeTrace = 48 := by
  unfold alphaStrongSU7BreakingNegativeTrace
  rw [finiteUnitSpectrumTrace_eq_card]
  norm_num

theorem alphaStrongSU7BreakingGeneratedImbalance_eq_89 :
    alphaStrongSU7BreakingGeneratedImbalance = 89 := by
  unfold alphaStrongSU7BreakingGeneratedImbalance
  rw [alphaStrongSU7BreakingPositiveTrace_eq_137,
    alphaStrongSU7BreakingNegativeTrace_eq_48]
  norm_num

theorem alphaStrongSU7BreakingGeneratedImbalance_eq_complementTrace :
    alphaStrongSU7BreakingGeneratedImbalance =
      su7BreakingComplementSpectrumTrace := by
  rw [alphaStrongSU7BreakingGeneratedImbalance_eq_89,
    su7BreakingComplementSpectrumTrace_eq_89]

/-- Threshold correction generated as a finite-spectrum imbalance. -/
def alphaStrongThresholdGeneratedImbalance : ℚ :=
  thresholdLowEnergyFiniteColorTrace - thresholdUnifiedFiniteColorTrace

theorem alphaStrongThresholdGeneratedImbalance_eq_zero :
    alphaStrongThresholdGeneratedImbalance = 0 := by
  unfold alphaStrongThresholdGeneratedImbalance
  rw [thresholdLowEnergyFiniteColorTrace_eq_seven,
    thresholdUnifiedFiniteColorTrace_eq_seven]
  norm_num

/-- Higgs/extra contribution generated as an incidence-slot imbalance. -/
def alphaStrongHiggsExtraGeneratedImbalance : ℚ :=
  higgsExtraIncidenceFiniteTrace - higgsExtraGeneratedFiniteTrace

theorem alphaStrongHiggsExtraGeneratedImbalance_eq_zero :
    alphaStrongHiggsExtraGeneratedImbalance = 0 := by
  unfold alphaStrongHiggsExtraGeneratedImbalance
  rw [higgsExtraIncidenceFiniteTrace_eq_six,
    higgsExtraGeneratedFiniteTrace_eq_six]
  norm_num

/-- The finite-spectrum loop imbalance seen by RG loop coordinates. -/
def alphaStrongGeneratedFiniteLoopImbalance : ℚ :=
  alphaStrongThresholdGeneratedImbalance +
    alphaStrongHiggsExtraGeneratedImbalance

theorem alphaStrongGeneratedFiniteLoopImbalance_eq_zero :
    alphaStrongGeneratedFiniteLoopImbalance = 0 := by
  unfold alphaStrongGeneratedFiniteLoopImbalance
  rw [alphaStrongThresholdGeneratedImbalance_eq_zero,
    alphaStrongHiggsExtraGeneratedImbalance_eq_zero]
  norm_num

/-- Raw loop coordinate before its finite counterterm is applied. -/
def alphaStrongGeneratedLoopRawCoordinate (loopWeight : ℚ) : ℚ :=
  loopWeight * alphaStrongGeneratedFiniteLoopImbalance

theorem alphaStrongGeneratedLoopRawCoordinate_eq_zero (loopWeight : ℚ) :
    alphaStrongGeneratedLoopRawCoordinate loopWeight = 0 := by
  unfold alphaStrongGeneratedLoopRawCoordinate
  rw [alphaStrongGeneratedFiniteLoopImbalance_eq_zero]
  ring

/-- Renormalized loop coordinate: raw spectrum plus its finite counterterm. -/
def alphaStrongGeneratedLoopRenormalizedCoordinate (loopWeight : ℚ) : ℚ :=
  alphaStrongGeneratedLoopRawCoordinate loopWeight +
    (-alphaStrongGeneratedLoopRawCoordinate loopWeight)

theorem alphaStrongGeneratedLoopRenormalizedCoordinate_eq_zero
    (loopWeight : ℚ) :
    alphaStrongGeneratedLoopRenormalizedCoordinate loopWeight = 0 := by
  unfold alphaStrongGeneratedLoopRenormalizedCoordinate
  ring

/-- The generated two/three-loop RG mismatch coordinate. -/
def alphaStrongGeneratedThreeLoopRGCoordinate : ℚ :=
  alphaStrongGeneratedLoopRenormalizedCoordinate 2 +
    alphaStrongGeneratedLoopRenormalizedCoordinate 3

theorem alphaStrongGeneratedThreeLoopRGCoordinate_eq_zero :
    alphaStrongGeneratedThreeLoopRGCoordinate = 0 := by
  unfold alphaStrongGeneratedThreeLoopRGCoordinate
  rw [alphaStrongGeneratedLoopRenormalizedCoordinate_eq_zero,
    alphaStrongGeneratedLoopRenormalizedCoordinate_eq_zero]
  norm_num

/-- Four-source vector generated directly from finite representation spectra. -/
def alphaStrongGeneratedRepresentationFourSourceVector :
    AlphaStrongResidualSource → ℚ
  | .su7Breaking =>
      alphaStrongSU7BreakingGeneratedImbalance /
        canonicalAlphaStrongRepresentationSpectrumPacket.resolutionDenominator
  | .threshold =>
      alphaStrongThresholdGeneratedImbalance /
        canonicalAlphaStrongRepresentationSpectrumPacket.resolutionDenominator
  | .threeLoopRG => alphaStrongGeneratedThreeLoopRGCoordinate
  | .higgsExtraRepresentation =>
      alphaStrongHiggsExtraGeneratedImbalance /
        canonicalAlphaStrongRepresentationSpectrumPacket.resolutionDenominator

theorem alphaStrongGeneratedRepresentationFourSourceVector_su7Breaking :
    alphaStrongGeneratedRepresentationFourSourceVector .su7Breaking =
      89 / 10000 := by
  unfold alphaStrongGeneratedRepresentationFourSourceVector
  rw [alphaStrongSU7BreakingGeneratedImbalance_eq_89,
    canonicalRepresentationSpectrum_denominator_eq_10000]

theorem alphaStrongGeneratedRepresentationFourSourceVector_threshold :
    alphaStrongGeneratedRepresentationFourSourceVector .threshold = 0 := by
  unfold alphaStrongGeneratedRepresentationFourSourceVector
  rw [alphaStrongThresholdGeneratedImbalance_eq_zero]
  norm_num

theorem alphaStrongGeneratedRepresentationFourSourceVector_threeLoopRG :
    alphaStrongGeneratedRepresentationFourSourceVector .threeLoopRG = 0 := by
  unfold alphaStrongGeneratedRepresentationFourSourceVector
  exact alphaStrongGeneratedThreeLoopRGCoordinate_eq_zero

theorem alphaStrongGeneratedRepresentationFourSourceVector_higgsExtra :
    alphaStrongGeneratedRepresentationFourSourceVector .higgsExtraRepresentation =
      0 := by
  unfold alphaStrongGeneratedRepresentationFourSourceVector
  rw [alphaStrongHiggsExtraGeneratedImbalance_eq_zero]
  norm_num

/-- The generated finite-spectrum vector is the packet-level vector of P851. -/
theorem alphaStrongGeneratedRepresentationFourSourceVector_eq_packet :
    alphaStrongGeneratedRepresentationFourSourceVector =
      canonicalAlphaStrongRepresentationSpectrumPacket.fourSourceVector := by
  funext source
  cases source
  · rw [alphaStrongGeneratedRepresentationFourSourceVector_su7Breaking,
      canonicalRepresentationSpectrum_su7Breaking_eq_89_div_10000]
  · rw [alphaStrongGeneratedRepresentationFourSourceVector_threshold,
      canonicalRepresentationSpectrum_threshold_eq_zero]
  · rw [alphaStrongGeneratedRepresentationFourSourceVector_threeLoopRG,
      canonicalRepresentationSpectrum_threeLoopRG_eq_zero]
  · rw [alphaStrongGeneratedRepresentationFourSourceVector_higgsExtra,
      canonicalRepresentationSpectrum_higgsExtra_eq_zero]

theorem alphaStrongGeneratedRepresentationFourSourceVector_coordinatewise :
    alphaStrongGeneratedRepresentationFourSourceVector =
      alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData := by
  rw [alphaStrongGeneratedRepresentationFourSourceVector_eq_packet,
    canonicalRepresentationSpectrum_fourSourceVector_eq_coordinatewise]

theorem alphaStrongGeneratedRepresentationFourSourceVector_eq_primitive :
    alphaStrongGeneratedRepresentationFourSourceVector =
      su7AlphaStrongFourSourcePrimitiveGenerator := by
  rw [alphaStrongGeneratedRepresentationFourSourceVector_eq_packet,
    canonicalRepresentationSpectrum_fourSourceVector_eq_primitive]

theorem alphaStrongGeneratedRepresentationFourSourceVector_eq_independent :
    alphaStrongGeneratedRepresentationFourSourceVector =
      alphaStrongFourSourceIndependentContribution := by
  rw [alphaStrongGeneratedRepresentationFourSourceVector_eq_primitive,
    su7AlphaStrongFourSourcePrimitiveGenerator_eq_independent]

theorem alphaStrongGeneratedRepresentationFourSourceVector_outputs_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          alphaStrongGeneratedRepresentationFourSourceVector s) =
      -((89000 : ℚ) / 128511) := by
  rw [alphaStrongGeneratedRepresentationFourSourceVector_eq_packet]
  exact canonicalRepresentationSpectrum_outputs_residual

/-- Certificate: alpha strong residual is produced by generated representation
spectra, not by a free four-source receipt. -/
structure AlphaStrongGeneratedRepresentationSpectrumCertificate where
  su7BreakingTrace :
    alphaStrongSU7BreakingGeneratedImbalance = 89
  thresholdTrace :
    alphaStrongThresholdGeneratedImbalance = 0
  higgsExtraTrace :
    alphaStrongHiggsExtraGeneratedImbalance = 0
  rgTrace :
    alphaStrongGeneratedThreeLoopRGCoordinate = 0
  vectorAgreement :
    alphaStrongGeneratedRepresentationFourSourceVector =
      canonicalAlphaStrongRepresentationSpectrumPacket.fourSourceVector
  vectorStructural :
    alphaStrongGeneratedRepresentationFourSourceVector =
      alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData
  vectorPrimitive :
    alphaStrongGeneratedRepresentationFourSourceVector =
      su7AlphaStrongFourSourcePrimitiveGenerator
  vectorIndependent :
    alphaStrongGeneratedRepresentationFourSourceVector =
      alphaStrongFourSourceIndependentContribution
  residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          alphaStrongGeneratedRepresentationFourSourceVector s) =
      -((89000 : ℚ) / 128511)

def alphaStrongGeneratedRepresentationSpectrumCertificate :
    AlphaStrongGeneratedRepresentationSpectrumCertificate where
  su7BreakingTrace := alphaStrongSU7BreakingGeneratedImbalance_eq_89
  thresholdTrace := alphaStrongThresholdGeneratedImbalance_eq_zero
  higgsExtraTrace := alphaStrongHiggsExtraGeneratedImbalance_eq_zero
  rgTrace := alphaStrongGeneratedThreeLoopRGCoordinate_eq_zero
  vectorAgreement := alphaStrongGeneratedRepresentationFourSourceVector_eq_packet
  vectorStructural :=
    alphaStrongGeneratedRepresentationFourSourceVector_coordinatewise
  vectorPrimitive :=
    alphaStrongGeneratedRepresentationFourSourceVector_eq_primitive
  vectorIndependent :=
    alphaStrongGeneratedRepresentationFourSourceVector_eq_independent
  residual := alphaStrongGeneratedRepresentationFourSourceVector_outputs_residual


end
end StandardModelConstraint
end SaturationMonoid
