import H0mework.Physics.AlphaSources.P461
import H0mework.Physics.AlphaSpectrum.P886

/-!
# Proposition 887: block-derived spectrum sizes for the alpha_s partition

P886 made the nonzero alpha-strong breaking source a partition-spectrum
producer:

`(Fin 128 ⊕ Fin 9) - Fin 48`.

This file lowers those three cardinalities one more step.  They are generated
from the concrete SU(7) block data already present in P461:

* the fundamental carrier has size `3 + 2 + 1 + 1 = 7`;
* information modes are binary fields over that carrier, `2^7 = 128`;
* low-energy visible gauge modes are color-adjoint plus photon,
  `(3^2 - 1) + 1 = 9`;
* unified gauge freedom is the SU(7) adjoint, `7^2 - 1 = 48`.

The resulting block-derived partition vector is proved equal to P886's
partition-breaking vector, hence it transports to the exact alpha-strong
inverse residual `-89000/128511`.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open scoped BigOperators
open RunningSigmaBeta

set_option linter.defProp false

/-! ## Fundamental block dimension and generated finite modes -/

/-- Fundamental dimension of the concrete SU(7) block carrier. -/
def su7BreakingFundamentalBlockDimension : ℕ :=
  SU7CarrierBlock.fundamentalDimension .color +
    SU7CarrierBlock.fundamentalDimension .weak +
      SU7CarrierBlock.fundamentalDimension .positiveSinglet +
        SU7CarrierBlock.fundamentalDimension .negativeSinglet

/-- THEOREM 1: the block carrier dimension is `3 + 2 + 1 + 1 = 7`. -/
theorem su7BreakingFundamentalBlockDimension_eq_seven :
    su7BreakingFundamentalBlockDimension = 7 := by
  unfold su7BreakingFundamentalBlockDimension
  exact SU7CarrierBlock.fundamentalDimension_sum

/-- Binary information fields over the SU(7) block carrier. -/
abbrev SU7BreakingInformationStateFromBlocks :=
  Fin su7BreakingFundamentalBlockDimension -> Bool

/-- THEOREM 2: binary fields over the seven block slots have cardinality
`2^7 = 128`. -/
theorem su7BreakingInformationStateFromBlocks_card_eq_128 :
    Fintype.card SU7BreakingInformationStateFromBlocks = 128 := by
  unfold SU7BreakingInformationStateFromBlocks
  rw [su7BreakingFundamentalBlockDimension_eq_seven]
  simp

/-- The color block dimension selected from the same SU(7) block carrier. -/
def su7BreakingColorBlockDimension : ℕ :=
  SU7CarrierBlock.fundamentalDimension .color

/-- THEOREM 3: the color block dimension is `3`. -/
theorem su7BreakingColorBlockDimension_eq_three :
    su7BreakingColorBlockDimension = 3 := by
  rfl

/-- Low-energy color-adjoint dimension generated by the color block. -/
def su7BreakingColorAdjointDimension : ℕ :=
  su7BreakingColorBlockDimension ^ (2 : Nat) - 1

/-- THEOREM 4: the generated color-adjoint dimension is `3^2 - 1 = 8`. -/
theorem su7BreakingColorAdjointDimension_eq_eight :
    su7BreakingColorAdjointDimension = 8 := by
  unfold su7BreakingColorAdjointDimension
  rw [su7BreakingColorBlockDimension_eq_three]
  norm_num

/-- Low-energy visible gauge modes: color adjoint plus the photon direction. -/
abbrev SU7BreakingLowEnergyVisibleGaugeFromBlocks :=
  Fin su7BreakingColorAdjointDimension ⊕ Fin 1

/-- THEOREM 5: low-energy visible gauge modes have cardinality
`(3^2 - 1) + 1 = 9`. -/
theorem su7BreakingLowEnergyVisibleGaugeFromBlocks_card_eq_nine :
    Fintype.card SU7BreakingLowEnergyVisibleGaugeFromBlocks = 9 := by
  change Fintype.card (Fin su7BreakingColorAdjointDimension ⊕ Fin 1) = 9
  rw [Fintype.card_sum, Fintype.card_fin, Fintype.card_fin,
    su7BreakingColorAdjointDimension_eq_eight]

/-- Unified SU(7) adjoint dimension generated by the fundamental block
dimension. -/
def su7BreakingUnifiedAdjointDimension : ℕ :=
  su7BreakingFundamentalBlockDimension ^ (2 : Nat) - 1

/-- THEOREM 6: the generated unified adjoint dimension is `7^2 - 1 = 48`. -/
theorem su7BreakingUnifiedAdjointDimension_eq_48 :
    su7BreakingUnifiedAdjointDimension = 48 := by
  unfold su7BreakingUnifiedAdjointDimension
  rw [su7BreakingFundamentalBlockDimension_eq_seven]
  norm_num

/-- Unified SU(7) adjoint gauge modes generated from the block dimension. -/
abbrev SU7BreakingAdjointGaugeFromBlocks :=
  Fin su7BreakingUnifiedAdjointDimension

/-- THEOREM 7: the block-derived unified adjoint mode carrier has cardinality
`48`. -/
theorem su7BreakingAdjointGaugeFromBlocks_card_eq_48 :
    Fintype.card SU7BreakingAdjointGaugeFromBlocks = 48 := by
  unfold SU7BreakingAdjointGaugeFromBlocks
  rw [Fintype.card_fin, su7BreakingUnifiedAdjointDimension_eq_48]

/-! ## Block-derived partition traces -/

/-- Positive side generated from block-derived information and low-energy
visible gauge modes. -/
abbrev SU7BreakingPositivePartitionModeFromBlocks :=
  Sum SU7BreakingInformationStateFromBlocks
    SU7BreakingLowEnergyVisibleGaugeFromBlocks

/-- Negative side generated from the block-derived SU(7) adjoint. -/
abbrev SU7BreakingNegativePartitionModeFromBlocks :=
  SU7BreakingAdjointGaugeFromBlocks

/-- Finite trace of the block-derived positive breaking partition. -/
def su7BreakingPositivePartitionTraceFromBlocks : ℚ :=
  finiteUnitSpectrumTrace SU7BreakingPositivePartitionModeFromBlocks

/-- Finite trace of the block-derived negative breaking partition. -/
def su7BreakingNegativePartitionTraceFromBlocks : ℚ :=
  finiteUnitSpectrumTrace SU7BreakingNegativePartitionModeFromBlocks

/-- Block-derived complement trace. -/
def su7BreakingPartitionComplementTraceFromBlocks : ℚ :=
  su7BreakingPositivePartitionTraceFromBlocks -
    su7BreakingNegativePartitionTraceFromBlocks

/-- THEOREM 8: the block-derived positive partition trace is `128 + 9 = 137`.
-/
theorem su7BreakingPositivePartitionTraceFromBlocks_eq_137 :
    su7BreakingPositivePartitionTraceFromBlocks = 137 := by
  unfold su7BreakingPositivePartitionTraceFromBlocks
  rw [finiteUnitSpectrumTrace_eq_card]
  have hcard :
      Fintype.card SU7BreakingPositivePartitionModeFromBlocks =
        Fintype.card SU7BreakingInformationStateFromBlocks +
          Fintype.card SU7BreakingLowEnergyVisibleGaugeFromBlocks := by
    unfold SU7BreakingPositivePartitionModeFromBlocks
    rw [Fintype.card_sum]
  rw [hcard, su7BreakingInformationStateFromBlocks_card_eq_128,
    su7BreakingLowEnergyVisibleGaugeFromBlocks_card_eq_nine]
  norm_num

/-- THEOREM 9: the block-derived negative partition trace is `48`. -/
theorem su7BreakingNegativePartitionTraceFromBlocks_eq_48 :
    su7BreakingNegativePartitionTraceFromBlocks = 48 := by
  unfold su7BreakingNegativePartitionTraceFromBlocks
  rw [finiteUnitSpectrumTrace_eq_card,
    su7BreakingAdjointGaugeFromBlocks_card_eq_48]
  norm_num

/-- THEOREM 10: the block-derived complement trace is `89`. -/
theorem su7BreakingPartitionComplementTraceFromBlocks_eq_89 :
    su7BreakingPartitionComplementTraceFromBlocks = 89 := by
  unfold su7BreakingPartitionComplementTraceFromBlocks
  rw [su7BreakingPositivePartitionTraceFromBlocks_eq_137,
    su7BreakingNegativePartitionTraceFromBlocks_eq_48]
  norm_num

/-- THEOREM 11: the block-derived complement trace is P886's partition trace.
-/
theorem su7BreakingPartitionComplementTraceFromBlocks_eq_p886 :
    su7BreakingPartitionComplementTraceFromBlocks =
      su7BreakingPartitionComplementTrace := by
  rw [su7BreakingPartitionComplementTraceFromBlocks_eq_89,
    su7BreakingPartitionComplementTrace_eq_89]

/-! ## Block-derived alpha_s vector -/

/-- Four-source vector whose breaking source is read from the block-derived
partition trace, with the paired counterterm-free zero sources of P885. -/
def alphaStrongBlockDerivedPartitionFourSourceVector :
    AlphaStrongResidualSource -> ℚ
  | .su7Breaking =>
      su7BreakingPartitionComplementTraceFromBlocks /
        alphaStrongGeneratedResolutionDenominator
  | .threshold => thresholdPairedSpectrumContribution
  | .threeLoopRG => alphaStrongPairedSpectrumCountertermFreeRGCoordinate
  | .higgsExtraRepresentation => higgsExtraPairedSpectrumContribution

/-- THEOREM 12: the block-derived breaking coordinate is `89/10000`. -/
theorem alphaStrongBlockDerivedPartitionFourSourceVector_su7Breaking :
    alphaStrongBlockDerivedPartitionFourSourceVector .su7Breaking =
      89 / 10000 := by
  unfold alphaStrongBlockDerivedPartitionFourSourceVector
  rw [su7BreakingPartitionComplementTraceFromBlocks_eq_89,
    alphaStrongGeneratedResolutionDenominator_eq_10000]

/-- THEOREM 13: the block-derived vector is P886's partition-breaking vector.
-/
theorem alphaStrongBlockDerivedPartitionFourSourceVector_eq_p886 :
    alphaStrongBlockDerivedPartitionFourSourceVector =
      alphaStrongPartitionBreakingCountertermFreeFourSourceVector := by
  funext source
  cases source
  · calc
      alphaStrongBlockDerivedPartitionFourSourceVector .su7Breaking =
          89 / 10000 :=
          alphaStrongBlockDerivedPartitionFourSourceVector_su7Breaking
      _ = alphaStrongPartitionBreakingCountertermFreeFourSourceVector
            .su7Breaking := by
          rw [
            alphaStrongPartitionBreakingCountertermFreeFourSourceVector_su7Breaking]
  · rfl
  · rfl
  · rfl

/-- THEOREM 14: the block-derived vector transports to the exact inverse
alpha_s residual. -/
theorem alphaStrongBlockDerivedPartitionFourSourceVector_outputs_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          alphaStrongBlockDerivedPartitionFourSourceVector s) =
      -((89000 : ℚ) / 128511) := by
  rw [alphaStrongBlockDerivedPartitionFourSourceVector_eq_p886]
  exact
    alphaStrongPartitionBreakingCountertermFreeFourSourceVector_outputs_residual

/-! ## Certificate -/

/-- P887 certificate: `128`, `9`, and `48` are generated from SU(7) block data,
then welded through P886 to the exact alpha-strong inverse residual. -/
structure AlphaStrongBlockDerivedPartitionProducerCertificate : Prop where
  block_dimension :
    su7BreakingFundamentalBlockDimension = 7
  information_modes :
    Fintype.card SU7BreakingInformationStateFromBlocks = 128
  color_adjoint :
    su7BreakingColorAdjointDimension = 8
  low_energy_visible :
    Fintype.card SU7BreakingLowEnergyVisibleGaugeFromBlocks = 9
  unified_adjoint :
    Fintype.card SU7BreakingAdjointGaugeFromBlocks = 48
  positive_partition :
    su7BreakingPositivePartitionTraceFromBlocks = 137
  negative_partition :
    su7BreakingNegativePartitionTraceFromBlocks = 48
  complement_partition :
    su7BreakingPartitionComplementTraceFromBlocks = 89
  complement_p886 :
    su7BreakingPartitionComplementTraceFromBlocks =
      su7BreakingPartitionComplementTrace
  source_coordinate :
    alphaStrongBlockDerivedPartitionFourSourceVector .su7Breaking =
      89 / 10000
  vector_p886 :
    alphaStrongBlockDerivedPartitionFourSourceVector =
      alphaStrongPartitionBreakingCountertermFreeFourSourceVector
  inverse_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          alphaStrongBlockDerivedPartitionFourSourceVector s) =
      -((89000 : ℚ) / 128511)

/-- THEOREM 15: canonical block-derived partition producer certificate. -/
def alphaStrongBlockDerivedPartitionProducerCertificate :
    AlphaStrongBlockDerivedPartitionProducerCertificate where
  block_dimension := su7BreakingFundamentalBlockDimension_eq_seven
  information_modes := su7BreakingInformationStateFromBlocks_card_eq_128
  color_adjoint := su7BreakingColorAdjointDimension_eq_eight
  low_energy_visible := su7BreakingLowEnergyVisibleGaugeFromBlocks_card_eq_nine
  unified_adjoint := su7BreakingAdjointGaugeFromBlocks_card_eq_48
  positive_partition := su7BreakingPositivePartitionTraceFromBlocks_eq_137
  negative_partition := su7BreakingNegativePartitionTraceFromBlocks_eq_48
  complement_partition := su7BreakingPartitionComplementTraceFromBlocks_eq_89
  complement_p886 := su7BreakingPartitionComplementTraceFromBlocks_eq_p886
  source_coordinate := alphaStrongBlockDerivedPartitionFourSourceVector_su7Breaking
  vector_p886 := alphaStrongBlockDerivedPartitionFourSourceVector_eq_p886
  inverse_residual :=
    alphaStrongBlockDerivedPartitionFourSourceVector_outputs_residual


end
end StandardModelConstraint
end SaturationMonoid
