import H0mework.Physics.RunningSources.P885

/-!
# Proposition 886: partition-spectrum producer for the alpha_s breaking source

P885 made the RG coordinate counterterm-free in the balanced paired-spectrum
case.  The remaining nonzero alpha-strong source is the SU(7)-breaking
coordinate.  Earlier files already computed it as `(128 + 9) - 48`, but the
packet layer also kept a `Fin 89` complement carrier.

This file makes the partition itself the producer:

* positive side: information states plus unbroken low-energy gauge modes,
  `Fin 128 ⊕ Fin 9`;
* negative side: the SU(7) adjoint, `Fin 48`;
* complement trace: the finite-spectrum trace difference, `137 - 48 = 89`.

The resulting four-source vector is then welded to P885, so the exact
alpha-strong inverse residual is transported from the partition spectrum rather
than from a stored complement carrier.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open scoped BigOperators

set_option linter.defProp false

/-! ## SU(7)-breaking partition spectrum -/

/-- Positive side of the SU(7)-breaking partition: the 128 information modes
and the 9 unbroken low-energy gauge modes. -/
abbrev SU7BreakingPositivePartitionMode :=
  Sum AlphaStrongInformationStateMode AlphaStrongUnbrokenGaugeMode

/-- Negative side of the SU(7)-breaking partition: the 48 SU(7) adjoint modes. -/
abbrev SU7BreakingNegativePartitionMode :=
  AlphaStrongSU7AdjointGaugeMode

/-- Finite trace of the positive breaking partition. -/
def su7BreakingPositivePartitionTrace : ℚ :=
  finiteUnitSpectrumTrace SU7BreakingPositivePartitionMode

/-- Finite trace of the negative breaking partition. -/
def su7BreakingNegativePartitionTrace : ℚ :=
  finiteUnitSpectrumTrace SU7BreakingNegativePartitionMode

/-- Complement trace generated as the partition difference. -/
def su7BreakingPartitionComplementTrace : ℚ :=
  su7BreakingPositivePartitionTrace - su7BreakingNegativePartitionTrace

/-- THEOREM 1: the positive partition trace is `128 + 9 = 137`. -/
theorem su7BreakingPositivePartitionTrace_eq_137 :
    su7BreakingPositivePartitionTrace = 137 := by
  unfold su7BreakingPositivePartitionTrace
    SU7BreakingPositivePartitionMode
  rw [finiteUnitSpectrumTrace_eq_card]
  norm_num

/-- THEOREM 2: the negative partition trace is the SU(7) adjoint dimension,
`48`. -/
theorem su7BreakingNegativePartitionTrace_eq_48 :
    su7BreakingNegativePartitionTrace = 48 := by
  unfold su7BreakingNegativePartitionTrace
    SU7BreakingNegativePartitionMode
  rw [finiteUnitSpectrumTrace_eq_card]
  norm_num

/-- THEOREM 3: the SU(7)-breaking partition produces the complement trace
`137 - 48 = 89`. -/
theorem su7BreakingPartitionComplementTrace_eq_89 :
    su7BreakingPartitionComplementTrace = 89 := by
  unfold su7BreakingPartitionComplementTrace
  rw [su7BreakingPositivePartitionTrace_eq_137,
    su7BreakingNegativePartitionTrace_eq_48]
  norm_num

/-- THEOREM 4: the partition-spectrum complement is the generated imbalance of
P856. -/
theorem su7BreakingPartitionComplementTrace_eq_generatedImbalance :
    su7BreakingPartitionComplementTrace =
      alphaStrongSU7BreakingGeneratedImbalance := by
  rw [su7BreakingPartitionComplementTrace_eq_89,
    alphaStrongSU7BreakingGeneratedImbalance_eq_89]

/-- THEOREM 5: the partition-spectrum complement agrees with the old
cardinality-89 complement carrier, but does not use that carrier as its
definition. -/
theorem su7BreakingPartitionComplementTrace_eq_complementSpectrum :
    su7BreakingPartitionComplementTrace =
      su7BreakingComplementSpectrumTrace := by
  rw [su7BreakingPartitionComplementTrace_eq_89,
    su7BreakingComplementSpectrumTrace_eq_89]

/-! ## Four-source vector from partition breaking plus paired zero sources -/

/-- Four-source vector whose nonzero breaking coordinate is generated by the
SU(7) partition spectrum, while the other coordinates use the paired
counterterm-free sources of P885. -/
def alphaStrongPartitionBreakingCountertermFreeFourSourceVector :
    AlphaStrongResidualSource -> ℚ
  | .su7Breaking =>
      su7BreakingPartitionComplementTrace /
        alphaStrongGeneratedResolutionDenominator
  | .threshold => thresholdPairedSpectrumContribution
  | .threeLoopRG => alphaStrongPairedSpectrumCountertermFreeRGCoordinate
  | .higgsExtraRepresentation => higgsExtraPairedSpectrumContribution

/-- THEOREM 6: the partition breaking coordinate is `89/10000`. -/
theorem alphaStrongPartitionBreakingCountertermFreeFourSourceVector_su7Breaking :
    alphaStrongPartitionBreakingCountertermFreeFourSourceVector .su7Breaking =
      89 / 10000 := by
  unfold alphaStrongPartitionBreakingCountertermFreeFourSourceVector
  rw [su7BreakingPartitionComplementTrace_eq_89,
    alphaStrongGeneratedResolutionDenominator_eq_10000]

/-- THEOREM 7: the partition-breaking vector agrees with P885's
counterterm-free paired-spectrum vector. -/
theorem alphaStrongPartitionBreakingCountertermFreeFourSourceVector_eq_p885 :
    alphaStrongPartitionBreakingCountertermFreeFourSourceVector =
      alphaStrongPairedSpectrumCountertermFreeFourSourceVector := by
  funext source
  cases source
  · calc
      alphaStrongPartitionBreakingCountertermFreeFourSourceVector
          .su7Breaking =
          89 / 10000 :=
          alphaStrongPartitionBreakingCountertermFreeFourSourceVector_su7Breaking
      _ = alphaStrongPairedSpectrumCountertermFreeFourSourceVector
            .su7Breaking := by
          rw [alphaStrongPairedSpectrumCountertermFreeFourSourceVector_eq_generated,
            alphaStrongGeneratedRepresentationFourSourceVector_su7Breaking]
  · rfl
  · rfl
  · rfl

/-- THEOREM 8: the partition-breaking vector also agrees with the fully
generated finite-spectrum vector of P858. -/
theorem alphaStrongPartitionBreakingCountertermFreeFourSourceVector_eq_fullyGenerated :
    alphaStrongPartitionBreakingCountertermFreeFourSourceVector =
      alphaStrongFullyGeneratedFourSourceVector := by
  rw [alphaStrongPartitionBreakingCountertermFreeFourSourceVector_eq_p885,
    alphaStrongPairedSpectrumCountertermFreeFourSourceVector_eq_generated,
    ← alphaStrongNoPacketGeneratedFourSourceVector_eq_generated,
    ← alphaStrongFullyGeneratedFourSourceVector_eq_noPacket]

/-- THEOREM 9: the partition-spectrum producer transports to the exact inverse
alpha_s residual. -/
theorem alphaStrongPartitionBreakingCountertermFreeFourSourceVector_outputs_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          alphaStrongPartitionBreakingCountertermFreeFourSourceVector s) =
      -((89000 : ℚ) / 128511) := by
  rw [alphaStrongPartitionBreakingCountertermFreeFourSourceVector_eq_p885]
  exact
    alphaStrongPairedSpectrumCountertermFreeFourSourceVector_outputs_residual

/-! ## Certificate -/

/-- P886 certificate: the nonzero SU(7)-breaking alpha_s source is produced by
the physical partition `(Fin 128 ⊕ Fin 9) - Fin 48`, then welded to the
counterterm-free paired zero sources. -/
structure AlphaStrongPartitionBreakingProducerCertificate : Prop where
  positive_partition :
    su7BreakingPositivePartitionTrace = 137
  negative_partition :
    su7BreakingNegativePartitionTrace = 48
  complement_partition :
    su7BreakingPartitionComplementTrace = 89
  complement_generated :
    su7BreakingPartitionComplementTrace =
      alphaStrongSU7BreakingGeneratedImbalance
  complement_old_carrier :
    su7BreakingPartitionComplementTrace =
      su7BreakingComplementSpectrumTrace
  source_coordinate :
    alphaStrongPartitionBreakingCountertermFreeFourSourceVector .su7Breaking =
      89 / 10000
  vector_p885 :
    alphaStrongPartitionBreakingCountertermFreeFourSourceVector =
      alphaStrongPairedSpectrumCountertermFreeFourSourceVector
  vector_fully_generated :
    alphaStrongPartitionBreakingCountertermFreeFourSourceVector =
      alphaStrongFullyGeneratedFourSourceVector
  inverse_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          alphaStrongPartitionBreakingCountertermFreeFourSourceVector s) =
      -((89000 : ℚ) / 128511)

/-- THEOREM 10: canonical partition-breaking producer certificate. -/
def alphaStrongPartitionBreakingProducerCertificate :
    AlphaStrongPartitionBreakingProducerCertificate where
  positive_partition := su7BreakingPositivePartitionTrace_eq_137
  negative_partition := su7BreakingNegativePartitionTrace_eq_48
  complement_partition := su7BreakingPartitionComplementTrace_eq_89
  complement_generated :=
    su7BreakingPartitionComplementTrace_eq_generatedImbalance
  complement_old_carrier :=
    su7BreakingPartitionComplementTrace_eq_complementSpectrum
  source_coordinate :=
    alphaStrongPartitionBreakingCountertermFreeFourSourceVector_su7Breaking
  vector_p885 :=
    alphaStrongPartitionBreakingCountertermFreeFourSourceVector_eq_p885
  vector_fully_generated :=
    alphaStrongPartitionBreakingCountertermFreeFourSourceVector_eq_fullyGenerated
  inverse_residual :=
    alphaStrongPartitionBreakingCountertermFreeFourSourceVector_outputs_residual


end
end StandardModelConstraint
end SaturationMonoid
