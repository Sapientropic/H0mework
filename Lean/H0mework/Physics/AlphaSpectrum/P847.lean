import H0mework.Physics.GaugeFlow.P846

/-!
# Proposition 847: finite-spectrum evaluator for the alpha_s zero sources

P829 expanded the three zero coordinates of the `alpha_s` four-source vector
as visible spectrum/counterterm coordinates:

* threshold: `7 - 7`;
* RG: generated raw loop coordinate plus its source-law counterterm;
* Higgs/extra: `6 - 6`.

This file lowers that presentation one more step.  The `7` and `6` coordinates
are produced by a common finite-spectrum evaluator, and the RG coordinate is
the loop-weighted residual of those finite spectra before the source-law
counterterm subtracts it.  Thus the zero coordinates are read from finite
representation spectra, not from zero-valued receipts.
-/

noncomputable section

namespace SaturationMonoid
namespace StandardModelConstraint

open RunningSigmaBeta
open scoped BigOperators

set_option linter.checkUnivs false
set_option linter.defProp false

/-! ## Common finite-spectrum evaluator -/

/-- Unit-weight finite-spectrum trace.  It is the common evaluator behind the
`7 - 7` threshold trace and the `6 - 6` Higgs/extra slot count. -/
def finiteUnitSpectrumTrace (ι : Type*) [Fintype ι] : ℚ :=
  ∑ _ : ι, (1 : ℚ)

/-- THEOREM 1: the finite unit-spectrum trace is the cardinality of the
carrier. -/
theorem finiteUnitSpectrumTrace_eq_card
    (ι : Type*) [Fintype ι] :
    finiteUnitSpectrumTrace ι = (Fintype.card ι : ℚ) := by
  simp [finiteUnitSpectrumTrace]

/-! ## Threshold finite spectrum: 7 - 7 -/

/-- The seven low-energy color threshold modes. -/
abbrev SU7ThresholdColorMode := Fin 7

/-- Low-energy color trace generated by the finite threshold spectrum. -/
def thresholdLowEnergyFiniteColorTrace : ℚ :=
  finiteUnitSpectrumTrace SU7ThresholdColorMode

/-- Unified-incidence color trace generated by the same finite spectrum. -/
def thresholdUnifiedFiniteColorTrace : ℚ :=
  finiteUnitSpectrumTrace SU7ThresholdColorMode

/-- THEOREM 2: the low-energy finite threshold trace is `7`. -/
theorem thresholdLowEnergyFiniteColorTrace_eq_seven :
    thresholdLowEnergyFiniteColorTrace = 7 := by
  unfold thresholdLowEnergyFiniteColorTrace SU7ThresholdColorMode
  rw [finiteUnitSpectrumTrace_eq_card]
  norm_num

/-- THEOREM 3: the unified finite threshold trace is `7`. -/
theorem thresholdUnifiedFiniteColorTrace_eq_seven :
    thresholdUnifiedFiniteColorTrace = 7 := by
  unfold thresholdUnifiedFiniteColorTrace SU7ThresholdColorMode
  rw [finiteUnitSpectrumTrace_eq_card]
  norm_num

/-- Threshold contribution generated directly from finite-spectrum traces. -/
def thresholdFiniteSpectrumContribution : ℚ :=
  (thresholdLowEnergyFiniteColorTrace - thresholdUnifiedFiniteColorTrace) /
    (alphaStrongQCDPoincareResolutionAxis ^
      alphaStrongResidualResolutionExponent)

/-- THEOREM 4: the finite-spectrum threshold contribution is `0`, by the
subtraction `7 - 7`. -/
theorem thresholdFiniteSpectrumContribution_eq_zero :
    thresholdFiniteSpectrumContribution = 0 := by
  unfold thresholdFiniteSpectrumContribution
  rw [thresholdLowEnergyFiniteColorTrace_eq_seven,
    thresholdUnifiedFiniteColorTrace_eq_seven]
  norm_num

/-- THEOREM 5: the finite threshold spectrum gives the same threshold
coordinate as P823/P829. -/
theorem thresholdFiniteSpectrumContribution_eq_coordinatewise :
    thresholdFiniteSpectrumContribution =
      alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData .threshold := by
  calc
    thresholdFiniteSpectrumContribution = 0 :=
      thresholdFiniteSpectrumContribution_eq_zero
    _ =
      alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData .threshold :=
        alphaStrongCoordinatewise_threshold_eq_zero.symm

/-! ## Higgs/extra finite spectrum: 6 - 6 -/

/-- Incidence-side Higgs/extra trace generated by the SU(7) block-incidence
carrier. -/
def higgsExtraIncidenceFiniteTrace : ℚ :=
  finiteUnitSpectrumTrace SU7BlockIncidence

/-- Matter/Higgs-side trace generated by the SU(7) generated-slot carrier. -/
def higgsExtraGeneratedFiniteTrace : ℚ :=
  finiteUnitSpectrumTrace SU7GeneratedCarrierSlot

/-- THEOREM 6: the incidence-side Higgs/extra finite trace is `6`. -/
theorem higgsExtraIncidenceFiniteTrace_eq_six :
    higgsExtraIncidenceFiniteTrace = 6 := by
  unfold higgsExtraIncidenceFiniteTrace
  rw [finiteUnitSpectrumTrace_eq_card, SU7BlockIncidence.card]
  norm_num

/-- THEOREM 7: the generated-slot Higgs/extra finite trace is `6`. -/
theorem higgsExtraGeneratedFiniteTrace_eq_six :
    higgsExtraGeneratedFiniteTrace = 6 := by
  unfold higgsExtraGeneratedFiniteTrace
  rw [finiteUnitSpectrumTrace_eq_card, SU7GeneratedCarrierSlot.card]
  norm_num

/-- Higgs/extra mismatch generated directly from finite representation slots. -/
def higgsExtraFiniteSpectrumMismatch : ℚ :=
  (higgsExtraIncidenceFiniteTrace - higgsExtraGeneratedFiniteTrace) /
    (alphaStrongQCDPoincareResolutionAxis ^
      alphaStrongResidualResolutionExponent)

/-- THEOREM 8: the finite-spectrum Higgs/extra mismatch is `0`, by `6 - 6`. -/
theorem higgsExtraFiniteSpectrumMismatch_eq_zero :
    higgsExtraFiniteSpectrumMismatch = 0 := by
  unfold higgsExtraFiniteSpectrumMismatch
  rw [higgsExtraIncidenceFiniteTrace_eq_six,
    higgsExtraGeneratedFiniteTrace_eq_six]
  norm_num

/-- THEOREM 9: the finite Higgs/extra spectrum gives the same coordinate as
P823/P829. -/
theorem higgsExtraFiniteSpectrumMismatch_eq_coordinatewise :
    higgsExtraFiniteSpectrumMismatch =
      alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData
          .higgsExtraRepresentation := by
  calc
    higgsExtraFiniteSpectrumMismatch = 0 :=
      higgsExtraFiniteSpectrumMismatch_eq_zero
    _ =
      alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData
          .higgsExtraRepresentation :=
        alphaStrongCoordinatewise_higgsExtra_eq_zero.symm

/-! ## RG finite spectrum: loop-weighted residual plus counterterm -/

/-- The finite-spectrum imbalance read by the higher-loop coordinate.  It is
exactly the threshold residual plus the Higgs/extra slot residual. -/
def alphaStrongFiniteSpectrumImbalance : ℚ :=
  (thresholdLowEnergyFiniteColorTrace - thresholdUnifiedFiniteColorTrace) +
    (higgsExtraIncidenceFiniteTrace - higgsExtraGeneratedFiniteTrace)

/-- THEOREM 10: the finite-spectrum imbalance is zero. -/
theorem alphaStrongFiniteSpectrumImbalance_eq_zero :
    alphaStrongFiniteSpectrumImbalance = 0 := by
  unfold alphaStrongFiniteSpectrumImbalance
  rw [thresholdLowEnergyFiniteColorTrace_eq_seven,
    thresholdUnifiedFiniteColorTrace_eq_seven,
    higgsExtraIncidenceFiniteTrace_eq_six,
    higgsExtraGeneratedFiniteTrace_eq_six]
  norm_num

/-- Raw higher-loop coordinate generated by finite spectra at loop weight
`loopWeight`. -/
def finiteSpectrumLoopRawCoordinate (loopWeight : ℚ) : ℚ :=
  loopWeight * alphaStrongFiniteSpectrumImbalance

/-- THEOREM 11: every finite-spectrum raw loop coordinate vanishes because the
finite spectrum imbalance vanishes. -/
theorem finiteSpectrumLoopRawCoordinate_eq_zero
    (loopWeight : ℚ) :
    finiteSpectrumLoopRawCoordinate loopWeight = 0 := by
  unfold finiteSpectrumLoopRawCoordinate
  rw [alphaStrongFiniteSpectrumImbalance_eq_zero]
  ring

/-- THEOREM 12: the finite-spectrum raw coordinate agrees with the canonical
SU(7) counterterm-source raw coordinate. -/
theorem finiteSpectrumLoopRawCoordinate_eq_canonical
    (loopWeight : ℚ) :
    finiteSpectrumLoopRawCoordinate loopWeight =
      su7LoopRawCoordinate canonicalStructuralLoopCountertermSource
        loopWeight := by
  calc
    finiteSpectrumLoopRawCoordinate loopWeight = 0 :=
      finiteSpectrumLoopRawCoordinate_eq_zero loopWeight
    _ =
      su7LoopRawCoordinate canonicalStructuralLoopCountertermSource
        loopWeight :=
        (su7LoopRawCoordinate_eq_zero_of_balanced
          canonicalStructuralLoopCountertermSource loopWeight
          (thresholdTraceSourceFromOneLoopCarrier_balanced
            standardModelOneLoopCarrierFinalReceipt)).symm

/-- Loop coordinate generated from finite spectra.  The counterterm is the
source-law subtraction of the generated raw coordinate. -/
def finiteSpectrumLoopCoordinateContribution
    (loopWeight : ℚ) :
    LoopCoordinateContribution where
  diagram := finiteSpectrumLoopRawCoordinate loopWeight
  counterterm := -finiteSpectrumLoopRawCoordinate loopWeight

/-- THEOREM 13: the finite-spectrum loop coordinate is source-law cancelled. -/
theorem finiteSpectrumLoopCoordinateContribution_cancelled
    (loopWeight : ℚ) :
    (finiteSpectrumLoopCoordinateContribution loopWeight).Cancelled := by
  unfold LoopCoordinateContribution.Cancelled
    LoopCoordinateContribution.renormalized
    finiteSpectrumLoopCoordinateContribution
  ring

/-- THEOREM 14: the finite-spectrum loop coordinate agrees with the canonical
SU(7) counterterm-source coordinate. -/
theorem finiteSpectrumLoopCoordinateContribution_eq_canonical
    (loopWeight : ℚ) :
    finiteSpectrumLoopCoordinateContribution loopWeight =
      loopCoordinateContributionFromSU7CountertermSource
        canonicalStructuralLoopCountertermSource loopWeight := by
  unfold finiteSpectrumLoopCoordinateContribution
    loopCoordinateContributionFromSU7CountertermSource
  rw [finiteSpectrumLoopRawCoordinate_eq_canonical loopWeight]

/-- The RG coordinate generated by the finite two- and three-loop spectra. -/
def finiteSpectrumRGMismatch : ℚ :=
  (finiteSpectrumLoopCoordinateContribution 2).renormalized +
    (finiteSpectrumLoopCoordinateContribution 3).renormalized

/-- THEOREM 15: the finite-spectrum RG mismatch is zero. -/
theorem finiteSpectrumRGMismatch_eq_zero :
    finiteSpectrumRGMismatch = 0 := by
  unfold finiteSpectrumRGMismatch
    LoopCoordinateContribution.renormalized
    finiteSpectrumLoopCoordinateContribution
  rw [finiteSpectrumLoopRawCoordinate_eq_zero 2,
    finiteSpectrumLoopRawCoordinate_eq_zero 3]
  norm_num

/-- THEOREM 16: the finite-spectrum RG coordinate gives the same coordinate as
P823/P829. -/
theorem finiteSpectrumRGMismatch_eq_coordinatewise :
    finiteSpectrumRGMismatch =
      alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData .threeLoopRG := by
  calc
    finiteSpectrumRGMismatch = 0 := finiteSpectrumRGMismatch_eq_zero
    _ =
      alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData .threeLoopRG :=
        alphaStrongCoordinatewise_threeLoopRG_eq_zero.symm

/-! ## Finite-spectrum four-source vector -/

/-- The `alpha_s` four-source vector with the three zero coordinates generated
by finite-spectrum evaluators. -/
def alphaStrongFiniteSpectrumFourSourceVector :
    AlphaStrongResidualSource -> ℚ
  | .su7Breaking => (89 : ℚ) / 10000
  | .threshold => thresholdFiniteSpectrumContribution
  | .threeLoopRG => finiteSpectrumRGMismatch
  | .higgsExtraRepresentation => higgsExtraFiniteSpectrumMismatch

/-- THEOREM 17: the finite-spectrum vector is the coordinatewise structural
four-source vector. -/
theorem alphaStrongFiniteSpectrumFourSourceVector_eq_coordinatewise :
    alphaStrongFiniteSpectrumFourSourceVector =
      alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData := by
  funext s
  cases s
  · exact alphaStrongCoordinatewise_su7Breaking_eq_89_div_10000.symm
  · exact thresholdFiniteSpectrumContribution_eq_coordinatewise
  · exact finiteSpectrumRGMismatch_eq_coordinatewise
  · exact higgsExtraFiniteSpectrumMismatch_eq_coordinatewise

/-- THEOREM 18: the finite-spectrum vector transports to the exact inverse
alpha_s residual. -/
theorem alphaStrongFiniteSpectrumFourSourceVector_outputs_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          alphaStrongFiniteSpectrumFourSourceVector s) =
      -((89000 : ℚ) / 128511) := by
  rw [alphaStrongFiniteSpectrumFourSourceVector_eq_coordinatewise]
  exact alphaStrongCoordinatewiseStructuralProducer_outputs_residual

/-! ## Certificate -/

/-- P847 certificate: threshold, RG, and Higgs/extra zero sources are produced
by finite-spectrum evaluators before the vector is summed. -/
structure AlphaStrongFiniteSpectrumEvaluatorCertificate : Prop where
  unit_trace_card :
    ∀ (ι : Type*) [Fintype ι],
      finiteUnitSpectrumTrace ι = (Fintype.card ι : ℚ)
  threshold_low_trace :
    thresholdLowEnergyFiniteColorTrace = 7
  threshold_unified_trace :
    thresholdUnifiedFiniteColorTrace = 7
  threshold_zero :
    thresholdFiniteSpectrumContribution = 0
  threshold_coordinate :
    thresholdFiniteSpectrumContribution =
      alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData .threshold
  higgs_incidence_trace :
    higgsExtraIncidenceFiniteTrace = 6
  higgs_generated_trace :
    higgsExtraGeneratedFiniteTrace = 6
  higgs_zero :
    higgsExtraFiniteSpectrumMismatch = 0
  higgs_coordinate :
    higgsExtraFiniteSpectrumMismatch =
      alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData
          .higgsExtraRepresentation
  finite_imbalance_zero :
    alphaStrongFiniteSpectrumImbalance = 0
  raw_loop_zero :
    ∀ loopWeight : ℚ,
      finiteSpectrumLoopRawCoordinate loopWeight = 0
  raw_loop_agrees_canonical :
    ∀ loopWeight : ℚ,
      finiteSpectrumLoopRawCoordinate loopWeight =
        su7LoopRawCoordinate canonicalStructuralLoopCountertermSource
          loopWeight
  loop_coordinate_cancelled :
    ∀ loopWeight : ℚ,
      (finiteSpectrumLoopCoordinateContribution loopWeight).Cancelled
  loop_coordinate_agrees_canonical :
    ∀ loopWeight : ℚ,
      finiteSpectrumLoopCoordinateContribution loopWeight =
        loopCoordinateContributionFromSU7CountertermSource
          canonicalStructuralLoopCountertermSource loopWeight
  rg_zero :
    finiteSpectrumRGMismatch = 0
  rg_coordinate :
    finiteSpectrumRGMismatch =
      alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData .threeLoopRG
  finite_vector_eq_coordinatewise :
    alphaStrongFiniteSpectrumFourSourceVector =
      alphaStrongCoordinatewiseStructuralFourSourceVector
        canonicalStructuralCarrierSmoothPhysicsSourceData
  inverse_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          alphaStrongFiniteSpectrumFourSourceVector s) =
      -((89000 : ℚ) / 128511)

/-- THEOREM 19: canonical P847 finite-spectrum evaluator certificate. -/
def alphaStrongFiniteSpectrumEvaluatorCertificate :
    AlphaStrongFiniteSpectrumEvaluatorCertificate where
  unit_trace_card := finiteUnitSpectrumTrace_eq_card
  threshold_low_trace := thresholdLowEnergyFiniteColorTrace_eq_seven
  threshold_unified_trace := thresholdUnifiedFiniteColorTrace_eq_seven
  threshold_zero := thresholdFiniteSpectrumContribution_eq_zero
  threshold_coordinate := thresholdFiniteSpectrumContribution_eq_coordinatewise
  higgs_incidence_trace := higgsExtraIncidenceFiniteTrace_eq_six
  higgs_generated_trace := higgsExtraGeneratedFiniteTrace_eq_six
  higgs_zero := higgsExtraFiniteSpectrumMismatch_eq_zero
  higgs_coordinate := higgsExtraFiniteSpectrumMismatch_eq_coordinatewise
  finite_imbalance_zero := alphaStrongFiniteSpectrumImbalance_eq_zero
  raw_loop_zero := finiteSpectrumLoopRawCoordinate_eq_zero
  raw_loop_agrees_canonical := finiteSpectrumLoopRawCoordinate_eq_canonical
  loop_coordinate_cancelled := finiteSpectrumLoopCoordinateContribution_cancelled
  loop_coordinate_agrees_canonical :=
    finiteSpectrumLoopCoordinateContribution_eq_canonical
  rg_zero := finiteSpectrumRGMismatch_eq_zero
  rg_coordinate := finiteSpectrumRGMismatch_eq_coordinatewise
  finite_vector_eq_coordinatewise :=
    alphaStrongFiniteSpectrumFourSourceVector_eq_coordinatewise
  inverse_residual :=
    alphaStrongFiniteSpectrumFourSourceVector_outputs_residual


end StandardModelConstraint
end SaturationMonoid
