import H0mework.Arithmetic.AtomicCodes.P930
import H0mework.Physics.AlphaSources.P785
import H0mework.Physics.AlphaSources.P919

/-!
# Proposition 931: alpha_s four-source vector is generated by type spectra

P785 expresses the alpha-strong residual as an independent four-source
contribution.  P919 computes the same vector from finite type carriers:
information states, unbroken gauge modes, SU(7) adjoint modes, threshold
color modes, Higgs incidence/generated modes, and loop-order modes.

This file welds the two objects.  The four-source contribution used by the
alpha residual is not a separate rational receipt: it is exactly the vector
generated by the canonical finite type-spectrum carrier.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open RunningSigmaBeta
open scoped BigOperators

set_option linter.defProp false

/-! ## Type-spectrum vector equals the independent four-source vector -/

/-- THEOREM 1: the SU(7)-breaking component of the type-spectrum vector is
the independent four-source SU(7)-breaking component. -/
theorem alphaStrongTypeSpectrum_su7Breaking_eq_independent :
    canonicalAlphaStrongTypeSpectrumCarrier.fourSourceVector .su7Breaking =
      alphaStrongFourSourceIndependentContribution .su7Breaking := by
  unfold alphaStrongFourSourceIndependentContribution
  rw [canonicalAlphaStrongTypeSpectrum_fourSourceVector_su7Breaking,
    alphaStrongSU7BreakingStructuralSourceGap_eq_89_div_10000]

/-- THEOREM 2: the finite threshold spectrum component is the independent
threshold source. -/
theorem alphaStrongTypeSpectrum_threshold_eq_independent :
    canonicalAlphaStrongTypeSpectrumCarrier.fourSourceVector .threshold =
      alphaStrongFourSourceIndependentContribution .threshold := by
  unfold alphaStrongFourSourceIndependentContribution
  rw [canonicalAlphaStrongTypeSpectrum_fourSourceVector_threshold,
    alphaStrongThresholdMismatchSourceGap_eq_zero]

/-- THEOREM 3: the finite loop-order spectrum component is the independent
three-loop/RG source. -/
theorem alphaStrongTypeSpectrum_threeLoopRG_eq_independent :
    canonicalAlphaStrongTypeSpectrumCarrier.fourSourceVector .threeLoopRG =
      alphaStrongFourSourceIndependentContribution .threeLoopRG := by
  unfold alphaStrongFourSourceIndependentContribution
  rw [canonicalAlphaStrongTypeSpectrum_fourSourceVector_threeLoopRG,
    alphaStrongThreeLoopRGMismatchSourceGap_eq_zero]

/-- THEOREM 4: the Higgs incidence/generated spectrum component is the
independent Higgs-extra source. -/
theorem alphaStrongTypeSpectrum_higgsExtra_eq_independent :
    canonicalAlphaStrongTypeSpectrumCarrier.fourSourceVector
        .higgsExtraRepresentation =
      alphaStrongFourSourceIndependentContribution
        .higgsExtraRepresentation := by
  unfold alphaStrongFourSourceIndependentContribution
  rw [canonicalAlphaStrongTypeSpectrum_fourSourceVector_higgsExtra,
    alphaStrongHiggsExtraSpectrumMismatchSourceGap_eq_zero]

/-- THEOREM 5: the canonical finite type-spectrum vector is exactly the
independent four-source contribution used by the alpha residual. -/
theorem alphaStrongTypeSpectrum_vector_eq_independentFourSource :
    canonicalAlphaStrongTypeSpectrumCarrier.fourSourceVector =
      alphaStrongFourSourceIndependentContribution := by
  funext s
  cases s
  · exact alphaStrongTypeSpectrum_su7Breaking_eq_independent
  · exact alphaStrongTypeSpectrum_threshold_eq_independent
  · exact alphaStrongTypeSpectrum_threeLoopRG_eq_independent
  · exact alphaStrongTypeSpectrum_higgsExtra_eq_independent

/-! ## The alpha residual is transported from the type-spectrum vector -/

/-- THEOREM 6: the type-spectrum vector has the same displayed alpha-level
gap as the independent four-source vector. -/
theorem alphaStrongTypeSpectrum_sum_eq_independentGap :
    (∑ s : AlphaStrongResidualSource,
        canonicalAlphaStrongTypeSpectrumCarrier.fourSourceVector s) =
      alphaStrongTwoLoopSMDisplayedGap ℚ := by
  rw [alphaStrongTypeSpectrum_vector_eq_independentFourSource]
  exact alphaStrongFourSourceIndependentContribution_sum_eq_gap

/-- THEOREM 7: the exact inverse residual is produced directly from the
finite type-spectrum vector. -/
theorem alphaStrongTypeSpectrum_independentInverseResidual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          canonicalAlphaStrongTypeSpectrumCarrier.fourSourceVector s) =
      -((89000 : ℚ) / 128511) := by
  rw [alphaStrongTypeSpectrum_vector_eq_independentFourSource]
  exact alphaStrongIndependentFourSource_inverseResidual

/-! ## Spectrum-level normal form of the three zero branches -/

/-- THEOREM 8: threshold zero is the equality of the two finite color traces.
-/
theorem alphaStrongThresholdZero_from_typeSpectrumTrace :
    canonicalAlphaStrongTypeSpectrumCarrier.thresholdLowColorTrace =
        canonicalAlphaStrongTypeSpectrumCarrier.thresholdUnifiedColorTrace ∧
      canonicalAlphaStrongTypeSpectrumCarrier.fourSourceVector .threshold =
        alphaStrongFourSourceIndependentContribution .threshold := by
  refine ⟨?_, alphaStrongTypeSpectrum_threshold_eq_independent⟩
  rw [canonicalAlphaStrongTypeSpectrum_thresholdLowTrace_eq_7,
    canonicalAlphaStrongTypeSpectrum_thresholdUnifiedTrace_eq_7]

/-- THEOREM 9: three-loop/RG zero is generated by the finite loop imbalance
being zero before loop-order weights are applied. -/
theorem alphaStrongThreeLoopRGZero_from_typeSpectrumLoop :
    canonicalAlphaStrongTypeSpectrumCarrier.finiteLoopImbalance = 0 ∧
      canonicalAlphaStrongTypeSpectrumCarrier.fourSourceVector .threeLoopRG =
        alphaStrongFourSourceIndependentContribution .threeLoopRG := by
  exact
    ⟨canonicalAlphaStrongTypeSpectrum_finiteLoopImbalance_eq_zero,
      alphaStrongTypeSpectrum_threeLoopRG_eq_independent⟩

/-- THEOREM 10: Higgs-extra zero is the equality of the incidence spectrum
and generated matter/Higgs spectrum traces. -/
theorem alphaStrongHiggsExtraZero_from_typeSpectrumTrace :
    canonicalAlphaStrongTypeSpectrumCarrier.higgsIncidenceTrace =
        canonicalAlphaStrongTypeSpectrumCarrier.higgsGeneratedTrace ∧
      canonicalAlphaStrongTypeSpectrumCarrier.fourSourceVector
          .higgsExtraRepresentation =
        alphaStrongFourSourceIndependentContribution
          .higgsExtraRepresentation := by
  refine ⟨?_, alphaStrongTypeSpectrum_higgsExtra_eq_independent⟩
  rw [canonicalAlphaStrongTypeSpectrum_higgsIncidenceTrace_eq_6,
    canonicalAlphaStrongTypeSpectrum_higgsGeneratedTrace_eq_6]

/-! ## Bundled certificate -/

/-- P931 certificate: the alpha-strong independent four-source contribution is
the finite type-spectrum vector, so threshold/RG/Higgs-extra branches are
generated by concrete finite spectra rather than by an external zero receipt. -/
structure AlphaStrongTypeSpectrumIndependentFourSourceBridgeCertificate :
    Prop where
  type_spectrum :
    AlphaStrongTypeCarrierSpectrumProducerCertificate
  independent_four_source :
    AlphaStrongIndependentFourSourceResidualProducerCertificate
  vector_eq_independent :
    canonicalAlphaStrongTypeSpectrumCarrier.fourSourceVector =
      alphaStrongFourSourceIndependentContribution
  threshold_from_spectrum :
    canonicalAlphaStrongTypeSpectrumCarrier.thresholdLowColorTrace =
        canonicalAlphaStrongTypeSpectrumCarrier.thresholdUnifiedColorTrace ∧
      canonicalAlphaStrongTypeSpectrumCarrier.fourSourceVector .threshold =
        alphaStrongFourSourceIndependentContribution .threshold
  three_loop_rg_from_spectrum :
    canonicalAlphaStrongTypeSpectrumCarrier.finiteLoopImbalance = 0 ∧
      canonicalAlphaStrongTypeSpectrumCarrier.fourSourceVector .threeLoopRG =
        alphaStrongFourSourceIndependentContribution .threeLoopRG
  higgs_extra_from_spectrum :
    canonicalAlphaStrongTypeSpectrumCarrier.higgsIncidenceTrace =
        canonicalAlphaStrongTypeSpectrumCarrier.higgsGeneratedTrace ∧
      canonicalAlphaStrongTypeSpectrumCarrier.fourSourceVector
          .higgsExtraRepresentation =
        alphaStrongFourSourceIndependentContribution
          .higgsExtraRepresentation
  generated_gap :
    (∑ s : AlphaStrongResidualSource,
        canonicalAlphaStrongTypeSpectrumCarrier.fourSourceVector s) =
      alphaStrongTwoLoopSMDisplayedGap ℚ
  generated_inverse_residual :
    inverseCorrectionFromAlphaGap
        (alphaStrongTwoLoopSMOutput ℚ)
        (∑ s : AlphaStrongResidualSource,
          canonicalAlphaStrongTypeSpectrumCarrier.fourSourceVector s) =
      -((89000 : ℚ) / 128511)

/-- THEOREM 11: alpha-strong type-spectrum / independent-four-source bridge.
-/
theorem alphaStrongTypeSpectrumIndependentFourSourceBridgeCertificate :
    AlphaStrongTypeSpectrumIndependentFourSourceBridgeCertificate where
  type_spectrum :=
    alphaStrongTypeCarrierSpectrumProducerCertificate
  independent_four_source :=
    alphaStrongIndependentFourSourceResidualProducerCertificate
  vector_eq_independent :=
    alphaStrongTypeSpectrum_vector_eq_independentFourSource
  threshold_from_spectrum :=
    alphaStrongThresholdZero_from_typeSpectrumTrace
  three_loop_rg_from_spectrum :=
    alphaStrongThreeLoopRGZero_from_typeSpectrumLoop
  higgs_extra_from_spectrum :=
    alphaStrongHiggsExtraZero_from_typeSpectrumTrace
  generated_gap :=
    alphaStrongTypeSpectrum_sum_eq_independentGap
  generated_inverse_residual :=
    alphaStrongTypeSpectrum_independentInverseResidual


end
end StandardModelConstraint
end SaturationMonoid
