/-!
# Lorentz path over the synchronized complete-joint spacetime section

The complete-joint spacetime section followed by its synchronized Cartan--EC
tail already emits one smooth four-dimensional actual.  This module keeps
that exact output as the unique pre-path current.  At every spacetime
occurrence it recenters that current and runs one Cartan--EC native leg; the
actual primitive connection derivative of that local action output is then
integrated by the canonical radial path compiler.

The public operator consumes only `(source,current)`.  Its four-leg occurrence
fixes the spacetime-section, synchronized-gravity, Lorentz-path, and live-
reaction writes before emission.  No residual, support, target jet, completed
field, selector, branch, zero-fiber receipt, or free coefficient is accepted.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeCompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathGlobalOperator

open PointwiseDiracSpinConnectionLift
open ProofFreeRicherAnholonomicSource
open StageNineDiracDualFormNativeCartanECSynchronizedCoframeContactLocalActualLift
open StageNineDiracDualFormNativeCoframeECContactLocalActualLift
open StageNineDiracDualFormNativeCompleteJointActionFullOccurrenceContactOperator
open StageNineDiracDualFormNativeCompleteJointActionSpacetimeSectionCartanECSynchronizedGlobalOperator
open StageNineDiracDualFormNativeCompleteJointActionSpacetimeSectionOperator
open StageNineEnrichedProofFreeSource
open StageNineFormNativeGravityMultiplierAuxiliaryIntegratedVariation
open StageNineFormNativeGravityReactionInstallation
open StageNineHolonomicField
open StageNineHolonomicFullSpacetimeRecenterNaturality
open StageNineIIPlusRestriction
open StageNineLorentzConnectionVariation
open StageNinePositiveSourceGravityMouthNormalizedAffineConnectionGerm

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1200000
set_option maxRecDepth 100000

/-! ## Exact occurrence-owned contact profile -/

/-- The already emitted synchronized spacetime section.  It is the unique
pre-path actual and is recomputed only from the same source/current indices. -/
def completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathBase
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  sourceActionGeneratedDiracDualCompleteJointActionSpacetimeSectionCartanECSynchronizedGlobalOperator
    source current

/-- The exact recentering of the pre-path actual at one physical occurrence. -/
def completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileInput
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) : StageNineHolonomicConfiguration :=
  fullyRecenterHolonomicConfiguration
    (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathBase
      source current)
    contact

/-- The primitive connection value read by the local EC action at the
recentered origin. -/
def completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileOrigin
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) : PointwiseLorentzSpinConnection :=
  (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileInput
    source current contact).gravityConnection 0

/-- Recentring changes the profile's coordinates, not its primitive value:
the local action origin is exactly the pre-path field at that occurrence. -/
@[simp] theorem
    completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileOrigin_eq_base
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) :
    completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileOrigin
        source current contact =
      (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathBase
        source current).gravityConnection contact := by
  exact fullyRecenterHolonomicConfiguration_gravityConnection_origin
    (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathBase
      source current)
    contact

/-- The curvature target generated by the same local EC action. -/
def completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileTarget
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) : PhysicalBivector :=
  diracDualFormNativeCoframeECContactCurvatureTarget source
    (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileInput
      source current contact)
    0

theorem
    completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileField_eq_base
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) :
    diracDualFormNativeCoframeECContactField
        (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileInput
          source current contact)
        0 =
      diracDualFormNativeCoframeECContactField
        (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathBase
          source current)
        contact := by
  unfold diracDualFormNativeCoframeECContactField
    diracDualFormNativeCoframeECContactPreparedActual
    completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileInput
  rw [toContinuumPointField_restrictHolonomicConfigurationToIIPlus,
    toContinuumPointField_restrictHolonomicConfigurationToIIPlus]
  rw [fullyRecenterHolonomicConfiguration_pointField_origin_unconditional]

theorem
    completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfilePreparedCurvature_eq_base
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) :
    holonomicGravityCurvature
        (diracDualFormNativeCoframeECContactPreparedActual
          (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileInput
            source current contact))
        0 =
      holonomicGravityCurvature
        (diracDualFormNativeCoframeECContactPreparedActual
          (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathBase
            source current))
        contact := by
  calc
    holonomicGravityCurvature
        (diracDualFormNativeCoframeECContactPreparedActual
          (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileInput
            source current contact))
        0 =
      holonomicGravityCurvature
        (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileInput
          source current contact)
        0 := by
          rfl
    _ = holonomicGravityCurvature
        (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathBase
          source current)
        contact :=
      fullyRecenterHolonomicConfiguration_gravityCurvature_origin_unconditional
        (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathBase
          source current)
        contact
    _ = holonomicGravityCurvature
        (diracDualFormNativeCoframeECContactPreparedActual
          (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathBase
            source current))
        contact := by
          rfl

/-- One native Cartan--EC action contact generated from the exact recentered
pre-path prefix.  The contact is an action output, not a supplied jet. -/
def completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileContact
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) : StageNineHolonomicConfiguration :=
  sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
    source
    (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileInput
      source current contact)
    0

/-- The primitive connection of the profile contact is the exact normalized
affine field generated by the action-owned origin and curvature target. -/
theorem
    completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileContact_connection_normalForm
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) :
    (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileContact
      source current contact).gravityConnection =
      normalizedAffineLorentzConnectionField
        (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileOrigin
          source current contact)
        (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileTarget
          source current contact) := by
  funext point formDirection internalOut internalIn
  simp [completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileContact,
    sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift,
    diracDualFormNativeCartanECSynchronizedCoframePreparedActual,
    diracDualFormNativeCartanECSynchronizedECActual,
    sourceActionGeneratedDiracDualCoframeECContactLocalActualLift,
    diracDualFormNativeCoframeECContactPreparedActual,
    diracDualFormNativeCoframeECContactConnectedActual,
    restrictHolonomicConfigurationToIIPlus,
    coframeECContactCenteredNormalizedAffineLorentzConnectionField,
    completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileOrigin,
    completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileTarget]

/-- The lowered primitive Lorentz first jet actually written by the local
Cartan--EC action contact. -/
def completeJointActionSpacetimeSectionCartanECSynchronizedLoweredConnectionFirstJet
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint)
    (derivativeDirection formDirection : LorentzianIndex)
    (internalPair : Fin 6) : ℝ :=
  minkowskiInternalSign (pairFirst internalPair) *
    gravityConnectionDerivative
      (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileContact
        source current contact)
      0 derivativeDirection formDirection
      (pairFirst internalPair) (pairSecond internalPair)

/-- Closed coordinate formula for the complete exact profile jet. -/
theorem
    completeJointActionSpacetimeSectionCartanECSynchronizedLoweredConnectionFirstJet_normalForm
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint)
    (derivativeDirection formDirection : LorentzianIndex)
    (internalPair : Fin 6) :
    completeJointActionSpacetimeSectionCartanECSynchronizedLoweredConnectionFirstJet
        source current contact derivativeDirection formDirection internalPair =
      ∑ spacetimePair : Fin 6,
        normalizedDerivativeBivector
            (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileOrigin
              source current contact)
            (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileTarget
              source current contact)
            internalPair spacetimePair *
          orientedLorentzBivectorBasisCoefficient spacetimePair
            derivativeDirection formDirection := by
  unfold
    completeJointActionSpacetimeSectionCartanECSynchronizedLoweredConnectionFirstJet
    gravityConnectionDerivative
  rw [
    completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileContact_connection_normalForm]
  change
    minkowskiInternalSign (pairFirst internalPair) *
        gravityConnectionDerivative
          (normalizedAffineConfiguration
            (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileOrigin
              source current contact)
            (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileTarget
              source current contact))
          0 derivativeDirection formDirection
          (pairFirst internalPair) (pairSecond internalPair) = _
  rw [normalizedAffineLorentzConnectionField_loweredDerivative_zero,
    normalizedAffineBivectorOneForm_directionalDerivative_zero]

/-- The exact generated jet as a Lorentz-bivector-valued one-form. -/
def completeJointActionSpacetimeSectionCartanECSynchronizedLorentzJetOneForm
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint)
    (derivativeDirection : LorentzianIndex) : LorentzBivectorOneForm :=
  fun formDirection internalPair =>
    completeJointActionSpacetimeSectionCartanECSynchronizedLoweredConnectionFirstJet
      source current contact derivativeDirection formDirection internalPair

/-- Finite-dimensional continuous-linear assembly of the exact action jet. -/
def completeJointActionSpacetimeSectionCartanECSynchronizedLorentzJetCLM
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint) :
    BasePoint →L[ℝ] LorentzBivectorOneForm :=
  ∑ derivativeDirection : LorentzianIndex,
    (baseCoordinate derivativeDirection).smulRight
      (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzJetOneForm
        source current contact derivativeDirection)

theorem
    completeJointActionSpacetimeSectionCartanECSynchronizedLorentzJetCLM_coordinate
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (contact : BasePoint)
    (derivativeDirection : LorentzianIndex) :
    completeJointActionSpacetimeSectionCartanECSynchronizedLorentzJetCLM
        source current contact (coordinateDirection derivativeDirection) =
      completeJointActionSpacetimeSectionCartanECSynchronizedLorentzJetOneForm
        source current contact derivativeDirection := by
  fin_cases derivativeDirection <;>
    ext formDirection internalPair <;>
    simp [completeJointActionSpacetimeSectionCartanECSynchronizedLorentzJetCLM,
      baseCoordinate, coordinateDirection, Fin.sum_univ_four]

/-! ## Canonical path write -/

/-- The distinguished primitive value is read from the exact pre-path
action output. -/
def completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathAnchor
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    PointwiseLorentzSpinConnection :=
  (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathBase
    source current).gravityConnection 0

/-- Integrate the occurrence-owned action one-form along the fixed radial
segment. -/
def completeJointActionSpacetimeSectionCartanECSynchronizedLorentzRadialIncrement
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (point : BasePoint) : LorentzBivectorOneForm :=
  ∫ᶜ contact in Path.segment (0 : BasePoint) point,
    completeJointActionSpacetimeSectionCartanECSynchronizedLorentzJetCLM
      source current contact

@[simp] theorem
    completeJointActionSpacetimeSectionCartanECSynchronizedLorentzRadialIncrement_zero
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    completeJointActionSpacetimeSectionCartanECSynchronizedLorentzRadialIncrement
        source current 0 = 0 := by
  funext formDirection internalPair
  simp [completeJointActionSpacetimeSectionCartanECSynchronizedLorentzRadialIncrement]

/-- The primitive whole-spacetime Lorentz field emitted by the path compiler. -/
def completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathConnectionField
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) : LorentzConnectionField :=
  fun point =>
    completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathAnchor
        source current +
      lorentzSkewConnectionOfBivectorOneForm
        (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzRadialIncrement
          source current point)

@[simp] theorem
    completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathConnectionField_zero
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathConnectionField
        source current 0 =
      completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathAnchor
        source current := by
  funext formDirection internalOut internalIn
  simp [completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathConnectionField]

/-- Install the generated connection into the exact pre-path actual. -/
def completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathConnectedActual
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  { completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathBase
      source current with
    gravityConnection :=
      completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathConnectionField
        source current }

/-- Recompute the live reaction only after the primitive path is installed. -/
def completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathReactionField
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    BasePoint → PhysicalBivector :=
  formNativeGravityReactionField
    (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathConnectedActual
      source current)

/-! ## One fixed-inventory whole-action occurrence -/

inductive CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathWriteLeg where
  | spacetimeSection
  | cartanECSynchronized
  | lorentzPath
  | liveReaction
  deriving DecidableEq

/-- The four action-owned writes in their pre-registered order. -/
def completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathActionWrite
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (leg :
      CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathWriteLeg)
    (before : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  match leg with
  | .spacetimeSection =>
      sourceActionGeneratedDiracDualCompleteJointActionSpacetimeSectionOperator
        source before
  | .cartanECSynchronized =>
      sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
        source before 0
  | .lorentzPath =>
      { before with
        gravityConnection :=
          completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathConnectionField
            source current }
  | .liveReaction =>
      installFormNativeGravityReaction before

/-- The exact occurrence has one constructor and no completion payload. -/
inductive CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathOccurrence
    (_source : SmoothUnifiedSource)
    (_current : StageNineHolonomicConfiguration) where
  | generated

def sourceActionGeneratedCompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathOccurrence
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathOccurrence
      source current :=
  .generated

namespace CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathOccurrence

theorem eq_generated
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence :
      CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathOccurrence
        source current) :
    occurrence =
      sourceActionGeneratedCompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathOccurrence
        source current := by
  cases occurrence
  rfl

def before
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (_occurrence :
      CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathOccurrence
        source current) :
    CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathWriteLeg →
      StageNineHolonomicConfiguration
  | .spacetimeSection => current
  | .cartanECSynchronized =>
      completeJointActionSpacetimeSectionCartanECSynchronizedPreCartanCurrent
        source current
  | .lorentzPath =>
      completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathBase
        source current
  | .liveReaction =>
      completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathConnectedActual
        source current

def after
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (_occurrence :
      CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathOccurrence
        source current) :
    CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathWriteLeg →
      StageNineHolonomicConfiguration
  | .spacetimeSection =>
      completeJointActionSpacetimeSectionCartanECSynchronizedPreCartanCurrent
        source current
  | .cartanECSynchronized =>
      completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathBase
        source current
  | .lorentzPath =>
      completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathConnectedActual
        source current
  | .liveReaction =>
      installFormNativeGravityReaction
        (completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathConnectedActual
          source current)

theorem after_eq_actionWrite
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence :
      CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathOccurrence
        source current)
    (leg :
      CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathWriteLeg) :
    occurrence.after leg =
      completeJointActionSpacetimeSectionCartanECSynchronizedLorentzPathActionWrite
        source current leg (occurrence.before leg) := by
  cases leg <;>
    rfl

@[simp] theorem spacetimeSection_to_cartanECSynchronized_handoff
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence :
      CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathOccurrence
        source current) :
    occurrence.after .spacetimeSection =
      occurrence.before .cartanECSynchronized :=
  rfl

@[simp] theorem cartanECSynchronized_to_lorentzPath_handoff
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence :
      CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathOccurrence
        source current) :
    occurrence.after .cartanECSynchronized = occurrence.before .lorentzPath :=
  rfl

@[simp] theorem lorentzPath_to_liveReaction_handoff
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence :
      CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathOccurrence
        source current) :
    occurrence.after .lorentzPath = occurrence.before .liveReaction :=
  rfl

/-- The exact recentered source prefix that generates the profile contact. -/
def profileInput
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence :
      CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathOccurrence
        source current)
    (contact : BasePoint) : StageNineHolonomicConfiguration :=
  fullyRecenterHolonomicConfiguration
    (occurrence.after .cartanECSynchronized) contact

/-- The profile is the native Cartan--EC leg on the exact outer occurrence
prefix, not a completed target carried by the event. -/
theorem profileContact_eq_nativeActionWrite
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence :
      CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathOccurrence
        source current)
    (contact : BasePoint) :
    completeJointActionSpacetimeSectionCartanECSynchronizedLorentzProfileContact
        source current contact =
      sourceActionGeneratedDiracDualCartanECSynchronizedCoframeContactLocalActualLift
        source (occurrence.profileInput contact) 0 := by
  rw [occurrence.eq_generated]
  rfl

abbrev finalActual
    {source : SmoothUnifiedSource}
    {current : StageNineHolonomicConfiguration}
    (occurrence :
      CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathOccurrence
        source current) : StageNineHolonomicConfiguration :=
  occurrence.after .liveReaction

end CompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathOccurrence

