    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  (sourceActionGeneratedCompleteJointActionSpacetimeSectionCartanECSynchronizedLorentzPathOccurrence
