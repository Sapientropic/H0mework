import H0mework.Physics.JointVariation.FullOccurrenceContactOperator
import H0mework.Physics.JointVariation.GlobalDevelopmentOperator

/-!
# Canonical P286 occurrence write profile

This module isolates the source/current-only P286 write already generated by
the complete-joint global development at every spacetime occurrence.  Each
occurrence first recenters the primitive current, then runs the canonical
temporal development, reads the origin action forcing, and converts that
forcing into the canonical connection write.  Applying the faithful canonical
diagonal section gives the corresponding second-jet profile.

No target, residual, support witness, successor, or equation receipt enters
either profile.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeCompleteJointP286CanonicalOccurrenceWriteProfile

open ProofFreeRicherAnholonomicSource
open StageNineDiracDualFormNativeCompleteJointActionFullOccurrenceContactOperator
open StageNineDiracDualFormNativeCompleteJointActionGlobalDevelopmentOperator
open StageNineDiracDualFormNativeP286CanonicalJointActionProducerCore
open StageNineEnrichedProofFreeSource
open StageNineFormNativeP286GaugeGeometricFirstVariation
open StageNineHolonomicField
open StageNineP286CanonicalDiagonalActionPrincipal
open StageNineP286GaugeConnectionVariation
open StageNineP286HolonomicSecondJetCarrier
open StageNineTopologicalP286GaugeThreeFormDuality
open SU7MotherLieAlgebra

noncomputable section

set_option autoImplicit false

/-! ## Source/current-only occurrence profiles -/

/-- The canonical P286 connection write generated at each recentered
spacetime occurrence of one primitive current. -/
def completeJointP286CanonicalOccurrenceWriteProfile
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    BasePoint → P286GaugeOneForm :=
  fun point =>
    diracDualFormNativeP286CanonicalGeneratedWrite source
      (completeJointGlobalTemporalCurrent source
        (fullyRecenterHolonomicConfiguration current point))

/-- The faithful canonical second jet generated by the occurrence write. -/
def completeJointP286CanonicalOccurrenceSecondJetProfile
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    BasePoint → P286HolonomicConnectionSecondJet :=
  fun point =>
    p286CanonicalDiagonalResponseSecondJet
      (completeJointP286CanonicalOccurrenceWriteProfile source current point)

/-! ## Faithfulness and installation -/

/-- The occurrence write vanishes exactly when its authoritative origin
action forcing vanishes. -/
theorem completeJointP286CanonicalOccurrenceWriteProfile_eq_zero_iff_forcing
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    completeJointP286CanonicalOccurrenceWriteProfile source current point = 0 ↔
      diracDualFormNativeP286CanonicalOriginActionForcing source
          (completeJointGlobalTemporalCurrent source
            (fullyRecenterHolonomicConfiguration current point)) = 0 := by
  unfold completeJointP286CanonicalOccurrenceWriteProfile
  unfold diracDualFormNativeP286CanonicalGeneratedWrite
  exact p286GaugeOneFormPairingEquiv.symm.map_eq_zero_iff

/-- The origin forcing vanishes exactly when the zero-write constitutive
candidate has zero form-native P286 Euler three-form at the local origin. -/
theorem completeJointP286CanonicalOccurrenceForcing_eq_zero_iff_zeroWriteEuler
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    diracDualFormNativeP286CanonicalOriginActionForcing source
          (completeJointGlobalTemporalCurrent source
            (fullyRecenterHolonomicConfiguration current point)) = 0 ↔
      holonomicFormNativeP286GaugeEulerThreeForm source 0
          (diracDualFormNativeP286CanonicalJointCandidate source
            (completeJointGlobalTemporalCurrent source
              (fullyRecenterHolonomicConfiguration current point)) 0) 0 = 0 := by
  unfold diracDualFormNativeP286CanonicalOriginActionForcing
  unfold diracDualFormNativeP286CanonicalOriginActionDual
  exact p286GaugeThreeFormWedgeLinearDual_eq_zero_iff _

/-- The canonical occurrence second jet has no kernel beyond the write
itself. -/
theorem completeJointP286CanonicalOccurrenceSecondJetProfile_eq_zero_iff_write
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    completeJointP286CanonicalOccurrenceSecondJetProfile source current point = 0 ↔
      completeJointP286CanonicalOccurrenceWriteProfile source current point = 0 := by
  unfold completeJointP286CanonicalOccurrenceSecondJetProfile
  simpa only [map_zero] using
    p286CanonicalDiagonalResponseSecondJet_eq_iff
      (completeJointP286CanonicalOccurrenceWriteProfile source current point) 0

/-- The complete-joint algebraic current at a recentered occurrence installs
exactly the generated occurrence write defined above into its live
constitutive candidate. -/
theorem completeJointGlobalP286AlgebraicCurrent_fullyRecenter_eq_occurrenceCandidate
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    completeJointGlobalP286AlgebraicCurrent source
        (fullyRecenterHolonomicConfiguration current point) =
      diracDualFormNativeP286CanonicalJointCandidate source
        (completeJointGlobalTemporalCurrent source
          (fullyRecenterHolonomicConfiguration current point))
        (completeJointP286CanonicalOccurrenceWriteProfile source current point) :=
  rfl

end

end SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeCompleteJointP286CanonicalOccurrenceWriteProfile
