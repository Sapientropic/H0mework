import H0mework.Physics.JointVariation.SectionFixedGlobalRegularity
import H0mework.Physics.Recentering.HolonomicFullSpacetimeRecenterActionJetNaturality

/-!
# Fixed complete-joint spacetime residual normal form

The fixed P506/L0 complete-joint operator has already generated one smooth
four-dimensional actual.  This module reads the complete mother-action jet of
that same actual at an arbitrary occurrence and packages its entire
nine-coordinate residual in one fixed-lineage normal form.

The normal form is the matching action contact jet together with the
exhaustive assembly seam generated by the global diagonal.  Neither the seam
nor the residual is fed back into a writer.  Full spacetime recentering is
used only as a faithful same-actual readout at the local origin.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeCompleteJointActionSpacetimeSectionFixedP506RecenteredResidualNormalForm

open ProofFreeRicherAnholonomicSource
open StageNineDiracDualFormNativeCompleteJointActionFullOccurrenceContactOperator
open StageNineDiracDualFormNativeCompleteJointActionSpacetimeSectionFixedP506
open StageNineDiracDualFormNativeCompleteJointActionSpacetimeSectionFixedP506GlobalRegularity
open StageNineDiracDualFormNativeCompleteJointActionSpacetimeSectionOperator
open StageNineDiracDualFormNativeJointResidualCarrier
open StageNineDiracDualFormNativePointwiseActionJetCarrier
open StageNineEnrichedProofFreeSource
open StageNineHolonomicField
open StageNineHolonomicFullSpacetimeRecenterActionJetNaturality

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1200000
set_option maxRecDepth 100000

private abbrev GlobalActual : StageNineHolonomicConfiguration :=
  fixedP506L0CompleteJointActionSpacetimeSectionActual

/-- The complete fixed-lineage action jet read at one spacetime occurrence.

This is the generated matching-contact jet plus the exhaustive diagonal
assembly seam.  It is a normal form for the jet of the already generated
global actual, not a second actual or a candidate write. -/
def fixedP506L0CompleteJointActionFullyRecenteredOriginActionJetNormalForm
    (point : BasePoint) :
    DiracDualFormNativePointwiseActionJetCarrier :=
  pointwiseActionJetWithCompleteJointAssemblySeam
    (generatedDiracDualFormNativePointwiseActionJet
      positiveSmoothUnifiedSource
      (fixedP506L0CompleteJointActionMatchingContact point)
      (completeJointActionMatchingContactPoint point))
    (fixedP506L0CompleteJointActionSpacetimeAssemblySeam point)

/-- One whole-carrier normal form for all nine residual coordinates of the
fixed global actual at one occurrence. -/
def fixedP506L0CompleteJointActionPointwiseJointResidualNormalForm
    (point : BasePoint) :
    DiracDualFormNativePointwiseJointResidualCarrier :=
  diracDualFormNativeJointResidualOfActionJet positiveSmoothUnifiedSource
    point
    (fixedP506L0CompleteJointActionFullyRecenteredOriginActionJetNormalForm
      point)

/-- The complete residual of the one global write is exactly the
matching-contact-plus-assembly-seam readout.  This is a simultaneous
nine-coordinate equality; no residual coordinate is solved independently. -/
theorem
    fixedP506L0CompleteJointActionSpacetimeSection_pointwiseJointResidual_normalForm
    (point : BasePoint) :
    diracDualFormNativePointwiseJointResidual positiveSmoothUnifiedSource
        GlobalActual point =
      fixedP506L0CompleteJointActionPointwiseJointResidualNormalForm point := by
  rw [diracDualFormNativePointwiseJointResidual_eq_actionJetReadout,
    fixedP506L0CompleteJointActionSpacetimeSection_actionJet_naturality]
  rfl

/-- Reading the same smooth global actual through its canonical full
spacetime recentering yields the identical whole-carrier normal form at the
local origin.  No complete-joint writer is rerun. -/
theorem
    fixedP506L0CompleteJointActionSpacetimeSection_fullyRecentered_origin_residual_normalForm
    (point : BasePoint) :
    diracDualFormNativePointwiseJointResidual positiveSmoothUnifiedSource
        (fullyRecenterHolonomicConfiguration GlobalActual point) 0 =
      fixedP506L0CompleteJointActionPointwiseJointResidualNormalForm point := by
  rw [pointwiseJointResidual_fullyRecenter_origin
    positiveSmoothUnifiedSource GlobalActual
    fixedP506L0CompleteJointActionSpacetimeSection_smooth point]
  exact
    fixedP506L0CompleteJointActionSpacetimeSection_pointwiseJointResidual_normalForm
      point

/-- Exact fixed-lineage zero-fiber verdict at one occurrence.  The remaining
mathematical obligation is now literally whether the displayed whole
normal-form carrier is zero, rather than a list of field-local gates. -/
theorem
    fixedP506L0CompleteJointActionSpacetimeSection_onZeroFiber_iff_normalForm_zero
    (point : BasePoint) :
    OnDiracDualFormNativePointwiseJointZeroFiber positiveSmoothUnifiedSource
        GlobalActual point ↔
      fixedP506L0CompleteJointActionPointwiseJointResidualNormalForm point =
        0 := by
  unfold OnDiracDualFormNativePointwiseJointZeroFiber
  rw [
    fixedP506L0CompleteJointActionSpacetimeSection_pointwiseJointResidual_normalForm]

/-- Global zero-fiber reachability is reduced to one fixed-lineage
whole-carrier equation at every occurrence.  This theorem does not assume or
manufacture a zero witness. -/
theorem
    fixedP506L0CompleteJointActionSpacetimeSection_zeroFiber_iff_normalForm_zero :
    DiracDualFormNativeJointZeroFiber positiveSmoothUnifiedSource
        GlobalActual ↔
      ∀ point,
        fixedP506L0CompleteJointActionPointwiseJointResidualNormalForm point =
          0 := by
  rw [diracDualFormNativeJointZeroFiber_iff_pointwise]
  constructor
  · intro zeroFiber point
    exact
      (fixedP506L0CompleteJointActionSpacetimeSection_onZeroFiber_iff_normalForm_zero
        point).1 (zeroFiber point)
  · intro normalFormZero point
    exact
      (fixedP506L0CompleteJointActionSpacetimeSection_onZeroFiber_iff_normalForm_zero
        point).2 (normalFormZero point)

end

end
  SaturationMonoid.PhysicsCore.StageNineDiracDualFormNativeCompleteJointActionSpacetimeSectionFixedP506RecenteredResidualNormalForm
