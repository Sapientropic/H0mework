private theorem completeJointOutput_chargedGaugeThreeForm_origin_eq_preEC
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    formNativeChargedGaugeThreeForm source 0 0
        (toContinuumPointField
          (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
            source current) 0) =
      formNativeChargedGaugeThreeForm source 0 0
        (toContinuumPointField
          (completeJointPreECCurrent source current) 0) := by
  unfold formNativeChargedGaugeThreeForm
  apply congrArg p286GaugeThreeFormOfDual
  apply LinearMap.ext
  intro direction
  simp only [formNativeChargedGaugeFirstLinearMap_apply]
  unfold formNativeChargedGaugeFirstCoefficient
  rw [completeJointOutput_volume_origin_eq_preEC,
    completeJointOutput_pointwiseScalarGaugeVariation_origin_eq_preEC,
    completeJointOutput_pointwiseMatterGaugeVariation_origin_eq_preEC,
    completeJointOutput_scalarGaugeKinetic_origin_eq_preEC,
    completeJointOutput_matterGaugeKinetic_origin_eq_preEC]

private theorem
    completeJointOutput_p286AuxiliaryExteriorCovariantDerivative_origin_eq_preEC
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    holonomicP286GaugeAuxiliaryExteriorCovariantDerivative
        (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
          source current) 0 =
      holonomicP286GaugeAuxiliaryExteriorCovariantDerivative
        (completeJointPreECCurrent source current) 0 := by
  have connectionEq :
      holonomicP286GaugeConnectionCoordinate
          (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
            source current) 0 =
        holonomicP286GaugeConnectionCoordinate
          (completeJointPreECCurrent source current) 0 := by
    unfold holonomicP286GaugeConnectionCoordinate
    unfold sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
    rw [sourceActionGeneratedDiracDualECFullCauchyLocalActualLift_gaugeConnection]
  have auxiliaryEq :
      holonomicP286GaugeAuxiliaryCoordinate
          (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
            source current) =
        holonomicP286GaugeAuxiliaryCoordinate
          (completeJointPreECCurrent source current) := by
    funext point pair
    unfold holonomicP286GaugeAuxiliaryCoordinate
    unfold sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
    rw [sourceActionGeneratedDiracDualECFullCauchyLocalActualLift_gaugeAuxiliary]
  have derivativeEq :
      p286GaugeAuxiliaryDirectionalDerivative
          (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
            source current) 0 =
        p286GaugeAuxiliaryDirectionalDerivative
          (completeJointPreECCurrent source current) 0 := by
    unfold p286GaugeAuxiliaryDirectionalDerivative
    rw [auxiliaryEq]
  unfold holonomicP286GaugeAuxiliaryExteriorCovariantDerivative
  rw [connectionEq, congrFun auxiliaryEq 0, derivativeEq]

/-- The final EC write does not break the P286 equation.  Its complete Euler
three-form reads the primitive P286 auxiliary/connection fields and the
charged matter current; all are preserved, and the only apparent gravity
dependency is the contact value of the spin connection, which EC retains. -/
theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_p286ConnectionEquation_origin
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    holonomicFormNativeP286GaugeEulerThreeForm source 0
        (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
          source current) 0 =
      0 := by
  unfold holonomicFormNativeP286GaugeEulerThreeForm
  rw [
    completeJointOutput_p286AuxiliaryExteriorCovariantDerivative_origin_eq_preEC,
    completeJointOutput_chargedGaugeThreeForm_origin_eq_preEC]
  exact completeJointPreECCurrent_p286ConnectionEquation_origin source current

/-- The EC leg is the action-owned inverse for the complete coframe covector
at an identity contact. -/
theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_coframeEuler_origin_zero
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (coframeOne : current.coframe 0 = 1) :
    diracDualFormNativeCoframeEulerCovector source 0
        (toContinuumPointField
          (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
            source current) 0) =
      0 := by
  apply
    sourceActionGeneratedDiracDualECFullCauchyLocalActualLift_fullCoframeEuler_zero
  simpa [completeJointPreECCurrent, completeJointScalarSecondJetCurrent] using
    coframeOne

end

