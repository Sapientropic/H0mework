    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
        source current).coframe =
      (completeJointPreECCurrent source current).coframe := by
  unfold sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
  exact sourceActionGeneratedDiracDualECFullCauchyLocalActualLift_coframe _ _

