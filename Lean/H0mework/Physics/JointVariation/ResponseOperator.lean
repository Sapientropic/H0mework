open StageNineP286GaugeConnectionVariation
open StageNineTopologicalP286GaugeThreeFormDuality

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1200000
set_option maxRecDepth 100000

/-! ## Source/current-only product producer -/

/-- First product leg: solve both repaired matter laws and install the unique
live constitutive auxiliary computed from the supplied source/current. -/
def completeJointRepairedConstitutiveCurrent
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  diracDualFormNativeRepairedConstitutiveWrittenCurrent source current

/-- Second product leg: generate the scalar temporal second jet from the
mother-action demand of the complete preceding current. -/
def completeJointScalarSecondJetCurrent
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  genericDiracDualScalarSecondJetActionResponse source
    (completeJointRepairedConstitutiveCurrent source current)

/-- Third product leg: generate the complete P286 auxiliary first jet after
the repaired matter and scalar writes have both occurred. -/
def completeJointPreECCurrent
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  formNativeCurrentP286CompleteActionResponseOperator source
    (completeJointScalarSecondJetCurrent source current)

/-- One branch-free dependency-ordered joint response.  The outer EC write is
last, so it reads the repaired matter, scalar, and P286 fields generated by
the three preceding legs. -/
def sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    StageNineHolonomicConfiguration :=
  sourceActionGeneratedDiracDualECFullCauchyLocalActualLift source
    (completeJointPreECCurrent source current)

/-! ## Primitive dependency ledger -/

@[simp] theorem completeJointRepairedConstitutiveCurrent_coframe
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (completeJointRepairedConstitutiveCurrent source current).coframe =
      current.coframe :=
  rfl

@[simp] theorem completeJointRepairedConstitutiveCurrent_gravityConnection
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (completeJointRepairedConstitutiveCurrent source current
      ).gravityConnection = current.gravityConnection :=
  rfl

@[simp] theorem completeJointRepairedConstitutiveCurrent_gaugeConnection
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (completeJointRepairedConstitutiveCurrent source current).gaugeConnection =
      current.gaugeConnection :=
  rfl

@[simp] theorem completeJointRepairedConstitutiveCurrent_scalar
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (completeJointRepairedConstitutiveCurrent source current).scalar =
      current.scalar :=
  rfl

@[simp] theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_coframe
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
      source current).coframe = current.coframe := by
  simp [sourceActionGeneratedDiracDualCompleteJointActionResponseOperator,
    completeJointPreECCurrent, completeJointScalarSecondJetCurrent]

@[simp] theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_gaugeConnection
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
      source current).gaugeConnection = current.gaugeConnection := by
  simp [sourceActionGeneratedDiracDualCompleteJointActionResponseOperator,
    completeJointPreECCurrent, completeJointScalarSecondJetCurrent]

@[simp] theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_scalar
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
      source current).scalar =
      (completeJointScalarSecondJetCurrent source current).scalar := by
  simp [sourceActionGeneratedDiracDualCompleteJointActionResponseOperator,
    completeJointPreECCurrent]

@[simp] theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_matter
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
      source current).matter =
      (completeJointRepairedConstitutiveCurrent source current).matter := by
  simp [sourceActionGeneratedDiracDualCompleteJointActionResponseOperator,
    completeJointPreECCurrent, completeJointScalarSecondJetCurrent]

@[simp] theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_conjugateMatter
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
      source current).conjugateMatter =
      (completeJointRepairedConstitutiveCurrent source current
        ).conjugateMatter := by
  simp [sourceActionGeneratedDiracDualCompleteJointActionResponseOperator,
    completeJointPreECCurrent, completeJointScalarSecondJetCurrent]

@[simp] theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_gaugeAuxiliary
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
      source current).gaugeAuxiliary =
      (completeJointPreECCurrent source current).gaugeAuxiliary := by
  simp [sourceActionGeneratedDiracDualCompleteJointActionResponseOperator]

theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_connection_zero
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
        source current).gravityConnection 0 =
      current.gravityConnection 0 := by
  rw [sourceActionGeneratedDiracDualCompleteJointActionResponseOperator,
    sourceActionGeneratedDiracDualECFullCauchyLocalActualLift_connection_zero]
  simp [completeJointPreECCurrent, completeJointScalarSecondJetCurrent]

theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_scalar_origin
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
        source current).scalar 0 = current.scalar 0 := by
  rw [
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_scalar]
  unfold completeJointScalarSecondJetCurrent
  rw [genericDiracDualScalarSecondJetActionResponse_scalar_origin]
  rfl

theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_matter_origin
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
        source current).matter 0 = current.matter 0 := by
  rw [
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_matter]
  unfold completeJointRepairedConstitutiveCurrent
    diracDualFormNativeRepairedConstitutiveWrittenCurrent
    diracDualFormNativeRepairedMatterWrittenCurrent
    actionGeneratedDiracDualRepairedMatterJointResponseActual
  rw [
    actionGeneratedDiracDualLiveCoframeConjugateMatterTimeResponseActual_matter,
    actionGeneratedDiracDualCurrentCoframeMatterTimeResponseActual_matter_origin]

theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_conjugateMatter_origin
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
        source current).conjugateMatter 0 = current.conjugateMatter 0 := by
  rw [
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_conjugateMatter]
  unfold completeJointRepairedConstitutiveCurrent
    diracDualFormNativeRepairedConstitutiveWrittenCurrent
    diracDualFormNativeRepairedMatterWrittenCurrent
    actionGeneratedDiracDualRepairedMatterJointResponseActual
  rw [
    actionGeneratedDiracDualLiveCoframeConjugateMatterTimeResponseActual_conjugateMatter_origin]
  rfl

/-! ## Matter action laws generated by the first product leg -/

private theorem completeJointRepairedConstitutiveCurrent_primalActionLaw
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth)
    (noncharacteristic :
      coframeTemporalPrincipalScalar (current.coframe 0) ≠ 0) :
    HolonomicDiracDualCurrentCoframeMatterTimeActionLaw
      (completeJointRepairedConstitutiveCurrent source current)
      0
      (holonomicMatterCovariantDerivative
        (completeJointRepairedConstitutiveCurrent source current)
        0 canonicalLorentzianTimeDirection) := by
  have law :=
    actionGeneratedDiracDualRepairedMatterJointResponseActual_primalActionLaw
      current smooth noncharacteristic
  simpa [completeJointRepairedConstitutiveCurrent,
    diracDualFormNativeRepairedConstitutiveWrittenCurrent,
    diracDualFormNativeRepairedMatterWrittenCurrent,
    HolonomicDiracDualCurrentCoframeMatterTimeActionLaw,
    holonomicDiracDualCurrentCoframeMatterKnownVector,
    holonomicMatterCovariantDerivative] using law

private theorem completeJointRepairedConstitutiveCurrent_liveAdjointActionLaw
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth)
    (nondegenerate : Matrix.det (current.coframe 0) ≠ 0)
    (noncharacteristic :
      coframeTemporalPrincipalScalar (current.coframe 0) ≠ 0) :
    HolonomicDiracDualLiveCoframeConjugateMatterTimeActionLaw
      (completeJointRepairedConstitutiveCurrent source current)
      0
      (holonomicConjugateMatterDerivativeDual
        (completeJointRepairedConstitutiveCurrent source current)
        0 canonicalLorentzianTimeDirection) := by
  simpa [completeJointRepairedConstitutiveCurrent] using
    diracDualFormNativeRepairedConstitutiveWrittenCurrent_liveAdjointActionLaw
      source current smooth nondegenerate noncharacteristic

/-! ## Matter-law preservation through the complete product -/

/-- The scalar-second-jet, P286, and EC legs preserve the repaired primal
matter action law at the common contact.  The only gravity field changed by
the final EC leg is the connection, whose value at the contact is retained.
This is an action-law transport theorem on the generated output, not a new
matter response constructor. -/
theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_primalActionLaw
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth)
    (noncharacteristic :
      coframeTemporalPrincipalScalar (current.coframe 0) ≠ 0) :
    HolonomicDiracDualCurrentCoframeMatterTimeActionLaw
      (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
        source current)
      0
      (holonomicMatterCovariantDerivative
        (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
          source current)
        0 canonicalLorentzianTimeDirection) := by
  have law :=
    completeJointRepairedConstitutiveCurrent_primalActionLaw
      source current smooth noncharacteristic
  unfold HolonomicDiracDualCurrentCoframeMatterTimeActionLaw at law ⊢
  unfold holonomicDiracDualCurrentCoframeMatterKnownVector at law ⊢
  have derivativeEq :
      ∀ direction,
        holonomicMatterCovariantDerivative
            (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
              source current)
            0 direction =
          holonomicMatterCovariantDerivative
            (completeJointRepairedConstitutiveCurrent source current)
            0 direction := by
    intro direction
    unfold holonomicMatterCovariantDerivative
    rw [
      sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_matter,
      sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_connection_zero,
      sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_gaugeConnection,
      completeJointRepairedConstitutiveCurrent_gravityConnection,
      completeJointRepairedConstitutiveCurrent_gaugeConnection]
  rw [completeJointRepairedConstitutiveCurrent_coframe,
    completeJointRepairedConstitutiveCurrent_scalar] at law
  rw [
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_coframe,
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_scalar_origin,
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_matter]
  simp_rw [derivativeEq]
  exact law

/-- The same dependency-ordered product also preserves the repaired adjoint
action law.  All spatial adjoint derivatives are unchanged, while the
algebraic operator sees only contact values retained by the later writes. -/
private theorem
    completeJointFinal_liveKnownDensitizedDual_origin_eq_repairedStage
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    holonomicDiracDualLiveCoframeConjugateMatterKnownDensitizedDual
        (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
          source current)
        0 =
      holonomicDiracDualLiveCoframeConjugateMatterKnownDensitizedDual
        (completeJointRepairedConstitutiveCurrent source current) 0 := by
  have coframeEq :
      (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
          source current).coframe =
        (completeJointRepairedConstitutiveCurrent source current).coframe := by
    rw [
      sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_coframe,
      completeJointRepairedConstitutiveCurrent_coframe]
  have conjugateEq :
      (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
          source current).conjugateMatter =
        (completeJointRepairedConstitutiveCurrent source current
          ).conjugateMatter :=
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_conjugateMatter
      source current
  have connectionEq :
      (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
          source current).gravityConnection 0 =
        (completeJointRepairedConstitutiveCurrent source current
          ).gravityConnection 0 := by
    rw [
      sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_connection_zero,
      completeJointRepairedConstitutiveCurrent_gravityConnection]
  have gaugeEq :
      (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
          source current).gaugeConnection =
        (completeJointRepairedConstitutiveCurrent source current
          ).gaugeConnection := by
    rw [
      sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_gaugeConnection,
      completeJointRepairedConstitutiveCurrent_gaugeConnection]
  have scalarEq :
      (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
          source current).scalar 0 =
        (completeJointRepairedConstitutiveCurrent source current).scalar 0 := by
    rw [
      sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_scalar_origin,
      completeJointRepairedConstitutiveCurrent_scalar]
  have volumeEq :
      generatedVolumeDensity
          (toContinuumPointField
            (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
              source current)
            0) =
        generatedVolumeDensity
          (toContinuumPointField
            (completeJointRepairedConstitutiveCurrent source current) 0) := by
    unfold generatedVolumeDensity toContinuumPointField
    rw [coframeEq]
  have conjugateDerivativeEq :
      ∀ direction,
        holonomicConjugateMatterDerivativeDual
            (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
              source current)
            0 direction =
          holonomicConjugateMatterDerivativeDual
            (completeJointRepairedConstitutiveCurrent source current)
            0 direction := by
    intro direction
    unfold holonomicConjugateMatterDerivativeDual
      holonomicConjugateMatterDerivativeCoordinates
      holonomicConjugateMatterCoordinates
    rw [conjugateEq]
  have algebraicOperatorEq :
      holonomicDiracDualLiveCoframeMatterAlgebraicOperator
          (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
            source current)
          0 =
        holonomicDiracDualLiveCoframeMatterAlgebraicOperator
          (completeJointRepairedConstitutiveCurrent source current) 0 := by
    unfold holonomicDiracDualLiveCoframeMatterAlgebraicOperator
      holonomicIdentityCoframeMatterConnectionOperator
    rw [coframeEq, connectionEq, gaugeEq, scalarEq]
  have algebraicDualEq :
      holonomicDiracDualLiveCoframeAlgebraicDual
          (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
            source current)
          0 =
        holonomicDiracDualLiveCoframeAlgebraicDual
          (completeJointRepairedConstitutiveCurrent source current) 0 := by
    unfold holonomicDiracDualLiveCoframeAlgebraicDual
    rw [volumeEq, conjugateEq, algebraicOperatorEq]
  have spatialTransportEq :
      holonomicLiveCoframeConjugateMatterSpatialTransportCoordinates
          (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
            source current)
          0 =
        holonomicLiveCoframeConjugateMatterSpatialTransportCoordinates
          (completeJointRepairedConstitutiveCurrent source current) 0 := by
    unfold holonomicLiveCoframeConjugateMatterSpatialTransportCoordinates
    rw [volumeEq, coframeEq]
    simp_rw [conjugateDerivativeEq]
  have driftEq :
      ∀ direction,
        holonomicLiveCoframeDensitizedPrincipalDriftCoordinates
            (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
              source current)
            0 direction =
          holonomicLiveCoframeDensitizedPrincipalDriftCoordinates
            (completeJointRepairedConstitutiveCurrent source current)
            0 direction := by
    intro direction
    unfold holonomicLiveCoframeDensitizedPrincipalDriftCoordinates
      holonomicLiveCoframeAffineGerm
      holonomicConjugateMatterCoordinates
    rw [coframeEq, conjugateEq]
  have spatialDriftEq :
      holonomicLiveCoframeSpatialPrincipalDriftCoordinates
          (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
            source current)
          0 =
        holonomicLiveCoframeSpatialPrincipalDriftCoordinates
          (completeJointRepairedConstitutiveCurrent source current) 0 := by
    unfold holonomicLiveCoframeSpatialPrincipalDriftCoordinates
    simp_rw [driftEq]
  have temporalDriftEq :
      holonomicLiveCoframeTemporalPrincipalDriftCoordinates
          (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
            source current)
          0 =
        holonomicLiveCoframeTemporalPrincipalDriftCoordinates
          (completeJointRepairedConstitutiveCurrent source current) 0 :=
    driftEq canonicalLorentzianTimeDirection
  unfold holonomicDiracDualLiveCoframeConjugateMatterKnownDensitizedDual
  rw [algebraicDualEq, spatialTransportEq, spatialDriftEq, temporalDriftEq]

theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_liveAdjointActionLaw_of_repairedLaw
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (law :
      HolonomicDiracDualLiveCoframeConjugateMatterTimeActionLaw
        (completeJointRepairedConstitutiveCurrent source current)
        0
        (holonomicConjugateMatterDerivativeDual
          (completeJointRepairedConstitutiveCurrent source current)
          0 canonicalLorentzianTimeDirection)) :
    HolonomicDiracDualLiveCoframeConjugateMatterTimeActionLaw
      (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
        source current)
      0
      (holonomicConjugateMatterDerivativeDual
        (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
          source current)
        0 canonicalLorentzianTimeDirection) := by
  unfold HolonomicDiracDualLiveCoframeConjugateMatterTimeActionLaw at law ⊢
  have conjugateDerivativeEq :
      ∀ direction,
        holonomicConjugateMatterDerivativeDual
            (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
              source current)
            0 direction =
          holonomicConjugateMatterDerivativeDual
            (completeJointRepairedConstitutiveCurrent source current)
            0 direction := by
    intro direction
    unfold holonomicConjugateMatterDerivativeDual
      holonomicConjugateMatterDerivativeCoordinates
      holonomicConjugateMatterCoordinates
    rw [
      sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_conjugateMatter]
  have coframeEq :
      (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
          source current).coframe =
        (completeJointRepairedConstitutiveCurrent source current).coframe := by
    rw [
      sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_coframe,
      completeJointRepairedConstitutiveCurrent_coframe]
  have volumeEq :
      generatedVolumeDensity
          (toContinuumPointField
            (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
              source current)
            0) =
        generatedVolumeDensity
          (toContinuumPointField
            (completeJointRepairedConstitutiveCurrent source current) 0) := by
    unfold generatedVolumeDensity toContinuumPointField
    rw [coframeEq]
  rw [volumeEq, coframeEq, conjugateDerivativeEq,
    completeJointFinal_liveKnownDensitizedDual_origin_eq_repairedStage]
  exact law

theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_liveAdjointActionLaw
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth)
    (nondegenerate : Matrix.det (current.coframe 0) ≠ 0)
    (noncharacteristic :
      coframeTemporalPrincipalScalar (current.coframe 0) ≠ 0) :
    HolonomicDiracDualLiveCoframeConjugateMatterTimeActionLaw
      (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
        source current)
      0
      (holonomicConjugateMatterDerivativeDual
        (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
          source current)
        0 canonicalLorentzianTimeDirection) :=
  sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_liveAdjointActionLaw_of_repairedLaw
    source current
    (completeJointRepairedConstitutiveCurrent_liveAdjointActionLaw
      source current smooth nondegenerate noncharacteristic)

/-- The primal action law gives the final product's conjugate-matter Euler
vector directly. -/
theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_matterVector_origin_zero
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth)
    (noncharacteristic :
      coframeTemporalPrincipalScalar (current.coframe 0) ≠ 0) :
    generatedContinuumDiracDualMatterVector source 0 0
        (toContinuumPointField
          (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
            source current) 0) =
      0 :=
  generatedContinuumDiracDualMatterVector_zero_of_repairedActionLaw
    source
    (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
      source current)
    0
    (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_primalActionLaw
      source current smooth noncharacteristic)

theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_conjugateMatterResidual_origin_zero
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (smooth : current.Smooth)
    (noncharacteristic :
      coframeTemporalPrincipalScalar (current.coframe 0) ≠ 0) :
    (fun direction =>
      diracDualConjugateMatterDirectionalCoefficient source
        (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
          source current)
        direction 0) =
      0 := by
  funext direction
  unfold diracDualConjugateMatterDirectionalCoefficient
  rw [
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_matterVector_origin_zero
      source current smooth noncharacteristic]
  simp

/-! ## Action-generated gravity closure -/

theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_simplicity
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    FormNativeGravitySimplicityEquation
      (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
        source current) :=
  sourceActionGeneratedDiracDualECFullCauchyLocalActualLift_simplicity _ _

theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_auxiliaryEquation
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    FormNativeGravityAuxiliaryEquation
      (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
        source current) :=
  sourceActionGeneratedDiracDualECFullCauchyLocalActualLift_auxiliaryEquation
    _ _

theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_connectionSelfGenerated_zero
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (selfGenerated :
      current.gravityConnection 0 =
        diracDualFormNativeActionCartanConnectionAt source current 0) :
    (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
        source current).gravityConnection 0 =
      diracDualFormNativeActionCartanConnectionAt source
        (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
          source current) 0 := by
  apply
    sourceActionGeneratedDiracDualECFullCauchyLocalActualLift_connectionSelfGenerated_zero
  have coframeField :
      (completeJointPreECCurrent source current).coframe = current.coframe := by
    simp [completeJointPreECCurrent, completeJointScalarSecondJetCurrent]
  have matterOrigin :
      (completeJointPreECCurrent source current).matter 0 =
        current.matter 0 := by
    simp [completeJointPreECCurrent, completeJointScalarSecondJetCurrent,
      completeJointRepairedConstitutiveCurrent,
      diracDualFormNativeRepairedConstitutiveWrittenCurrent,
      diracDualFormNativeRepairedMatterWrittenCurrent,
      actionGeneratedDiracDualRepairedMatterJointResponseActual,
      actionGeneratedDiracDualCurrentCoframeMatterTimeResponseActual]
  have conjugateOrigin :
      (completeJointPreECCurrent source current).conjugateMatter 0 =
        current.conjugateMatter 0 := by
    simp [completeJointPreECCurrent, completeJointScalarSecondJetCurrent,
      completeJointRepairedConstitutiveCurrent,
      diracDualFormNativeRepairedConstitutiveWrittenCurrent,
      diracDualFormNativeRepairedMatterWrittenCurrent,
      actionGeneratedDiracDualRepairedMatterJointResponseActual,
      actionGeneratedDiracDualCurrentCoframeMatterTimeResponseActual,
      installMatterLinearTimeResponse_conjugateMatter]
  calc
    (completeJointPreECCurrent source current).gravityConnection 0 =
        current.gravityConnection 0 := by
      simp [completeJointPreECCurrent, completeJointScalarSecondJetCurrent]
    _ = diracDualFormNativeActionCartanConnectionAt source current 0 :=
      selfGenerated
    _ = diracDualFormNativeActionCartanConnectionAt source
          (completeJointPreECCurrent source current) 0 := by
      unfold diracDualFormNativeActionCartanConnectionAt
        diracDualFormNativeActionCartanContorsionAt
        diracDualFormNativeActionCartanTorsionAt
      rw [coframeField]
      rw [diracDualFormNativeActionSpinResponseAt_eq_of_fields_at
        source current (completeJointPreECCurrent source current) 0
        (by rw [coframeField]) matterOrigin.symm conjugateOrigin.symm]

/-! ## Contact action closure -/

/-- The product retains the constitutive auxiliary generated before the
scalar and P286 differential writes.  Both sides are recomputed on the final
output point field; no auxiliary equation is supplied to the producer. -/
theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_liveGaugeAuxiliary_origin
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
        source current).gaugeAuxiliary 0 =
      formNativeP286GaugeEliminatedAuxiliaryAtBoundary
        (sourceGeneratedUnifiedCouplings source)
        ((sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
          source current).coframe 0)
        (holonomicGaugeCurvature
          (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
            source current) 0) := by
  have curvatureEq :
      holonomicGaugeCurvature
          (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
            source current) 0 =
        holonomicGaugeCurvature current 0 := by
    exact holonomicGaugeCurvature_eq_of_connection_eq
      (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
        source current) current
      (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_gaugeConnection
        source current) 0
  rw [curvatureEq,
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_coframe]
  rw [
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_gaugeAuxiliary]
  unfold completeJointPreECCurrent
  rw [formNativeCurrentP286CompleteActionResponseOperator_gaugeAuxiliary_origin]
  unfold completeJointScalarSecondJetCurrent
  rw [genericDiracDualScalarSecondJetActionResponse_gaugeAuxiliary]
  rfl

theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_p286GaugeAuxiliaryEquation_origin
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (coframeOne : current.coframe 0 = 1) :
    FormNativeP286GaugeAuxiliaryEquationAtBoundary
      (sourceGeneratedUnifiedCouplings source)
      (toContinuumPointField
        (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
          source current) 0) := by
  apply
    (formNativeP286GaugeAuxiliaryEquationAtBoundary_iff_eliminated
      (sourceGeneratedUnifiedCouplings source)
      (toContinuumPointField
        (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
          source current) 0) (by
        change Matrix.det
          ((sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
            source current).coframe 0) ≠ 0
        rw [
          sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_coframe,
          coframeOne]
        norm_num)).2
  exact
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_liveGaugeAuxiliary_origin
      source current

theorem
    sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_p286GaugeAuxiliaryResidual_origin_zero
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration)
    (coframeOne : current.coframe 0 = 1) :
    formNativeP286GaugeAuxiliaryEulerResidualAtBoundary
        (sourceGeneratedUnifiedCouplings source)
        (toContinuumPointField
          (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
            source current) 0) =
      0 := by
  exact
    (formNativeP286GaugeAuxiliaryEulerResidual_eq_zero_iff
      (sourceGeneratedUnifiedCouplings source)
      (toContinuumPointField
        (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator
          source current) 0)).2
      (sourceActionGeneratedDiracDualCompleteJointActionResponseOperator_p286GaugeAuxiliaryEquation_origin
        source current coframeOne)

/-- The third product leg closes the complete P286 connection equation before
the final EC reaction is installed.  This is the action-generated P286 side
of the product critical pair. -/
theorem completeJointPreECCurrent_p286ConnectionEquation_origin
    (source : SmoothUnifiedSource)
    (current : StageNineHolonomicConfiguration) :
    holonomicFormNativeP286GaugeEulerThreeForm source 0
        (completeJointPreECCurrent source current) 0 =
      0 := by
  exact
    formNativeCurrentP286CompleteActionResponseOperator_connectionEquation_origin
      source (completeJointScalarSecondJetCurrent source current)

/-! ## EC--P286 critical-pair closure -/

