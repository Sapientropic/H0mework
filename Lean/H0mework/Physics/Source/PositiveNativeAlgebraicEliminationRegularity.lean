/-- Both primitive source connections and the source coframe remain smooth
after their deterministic installation into any smooth completion. -/
theorem positiveSourceNativeKinematicSeed_smooth
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth) :
    (positiveSourceNativeKinematicSeed configuration).Smooth := by
  exact installSourceP286AffineConnection_smooth
    positiveSmoothUnifiedSource.legacy
    (installPositiveSourceNativeGravityKinematics configuration)
    (installPositiveSourceNativeGravityKinematics_smooth configuration smooth)

/-- The gravity auxiliary generated by the inverse internal-dual solver is
smooth because its input is the actual curvature of the smooth primitive
source connection. -/
theorem positiveSourceNativeAlgebraicEliminationUpdate_gravityAuxiliary_smooth
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth) :
    ∀ internalPair spacetimePair,
      ContDiff ℝ ∞ fun point =>
        (positiveSourceNativeAlgebraicEliminationUpdate
          configuration).gravityAuxiliary point internalPair spacetimePair := by
  intro internalPair spacetimePair
  have seedSmooth := positiveSourceNativeKinematicSeed_smooth configuration smooth
  change ContDiff ℝ ∞ fun point =>
    (gravityInternalDualEquiv.symm
      (holonomicGravityCurvature
        (positiveSourceNativeKinematicSeed configuration) point))
      internalPair spacetimePair
  fin_cases internalPair <;>
    simp [gravityInternalDualEquiv, gravityInternalDualLinear] <;>
    first
    | exact holonomicGravityCurvature_component_contDiff
        (positiveSourceNativeKinematicSeed configuration) seedSmooth _ _
    | exact (holonomicGravityCurvature_component_contDiff
        (positiveSourceNativeKinematicSeed configuration) seedSmooth _ _).neg

/-- Coordinatewise lifted exterior-square transport remains smooth when both
the coframe and the Lie-algebra-valued two-form vary smoothly. -/
theorem liftCoframeTwoFormLinear_apply_contDiff_p286
    (coframe : BasePoint → LorentzianCoframe)
    (coframeSmooth : ContDiff ℝ ∞ coframe)
    (form : BasePoint → Fin 6 → P286CoordinateCarrier)
    (formSmooth : ContDiff ℝ ∞ form) :
    ContDiff ℝ ∞ fun point =>
      liftGaugeTwoFormOperator
        (coframeTwoFormLinear (coframe point)) (form point) := by
  apply contDiff_pi'
  intro output
  unfold liftGaugeTwoFormOperator
  apply ContDiff.sum
  intro input _
  have coefficientSmooth : ContDiff ℝ ∞ fun point =>
      gaugeOperatorCoefficient
        (coframeTwoFormLinear (coframe point)) output input := by
    have coframeEntrySmooth : ∀ row column,
        ContDiff ℝ ∞ fun point => coframe point row column :=
      fun row column =>
        contDiff_pi.mp (contDiff_pi.mp coframeSmooth row) column
    have wedgeSmooth : ContDiff ℝ ∞ fun point =>
        coframeWedge (coframe point) output input := by
      unfold coframeWedge
      fun_prop
    simpa [gaugeOperatorCoefficient, coframeTwoFormLinear] using wedgeSmooth
  exact coefficientSmooth.smul (contDiff_pi.mp formSmooth input)

/-- The complete coframe-dependent Hodge applied to the actual P286
curvature is smooth.  The inverse coframe is generated from pointwise
nondegeneracy rather than supplied as a field. -/
theorem positiveSourceNativeKinematicSeed_p286HodgeCurvature_smooth
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth) :
    ContDiff ℝ ∞ fun point =>
      liftGaugeTwoFormOperator
        (coframeGaugeSpacetimeHodgeLinear
          ((positiveSourceNativeKinematicSeed configuration).coframe point))
        (fun pair => p286CoordinateEquiv
          (holonomicGaugeCurvature
            (positiveSourceNativeKinematicSeed configuration) point pair)) := by
  let seed := positiveSourceNativeKinematicSeed configuration
  have seedSmooth : seed.Smooth :=
    positiveSourceNativeKinematicSeed_smooth configuration smooth
  have seedNondegenerate : seed.Nondegenerate :=
    positiveSourceNativeKinematicSeed_nondegenerate configuration
  let curvatureCoordinate : BasePoint → Fin 6 → P286CoordinateCarrier :=
    fun point pair =>
    p286CoordinateEquiv (holonomicGaugeCurvature seed point pair)
  have curvatureSmooth : ContDiff ℝ ∞ curvatureCoordinate := by
    apply contDiff_pi'
    intro pair
    exact holonomicGaugeCurvature_coordinate_contDiff seed seedSmooth pair
  change ContDiff ℝ ∞ fun point =>
    liftGaugeTwoFormOperator
      (coframeGaugeSpacetimeHodgeLinear (seed.coframe point))
      (curvatureCoordinate point)
  apply contDiff_pi'
  intro output
  unfold liftGaugeTwoFormOperator
  apply ContDiff.sum
  intro input _
  have coefficientSmooth : ContDiff ℝ ∞ fun point =>
      gaugeOperatorCoefficient
        (coframeGaugeSpacetimeHodgeLinear (seed.coframe point))
        output input := by
    let basis : GaugeTwoForm := fun candidate =>
      if candidate = input then 1 else 0
    have actual := holonomicGaugeSpacetimeHodge_apply_contDiff
      seed seedSmooth seedNondegenerate (fun _ => basis) contDiff_const
    exact contDiff_pi.mp actual output
  exact coefficientSmooth.smul (contDiff_pi.mp curvatureSmooth input)

/-- The P286 auxiliary generated by the unique existing constitutive solver
is smooth in all six spacetime two-form channels. -/
theorem positiveSourceNativeAlgebraicEliminationUpdate_gaugeAuxiliary_smooth
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth) :
    ∀ pair,
      ContDiff ℝ ∞ fun point =>
        p286CoordinateEquiv
          ((positiveSourceNativeAlgebraicEliminationUpdate
            configuration).gaugeAuxiliary point pair) := by
  have hodgeSmooth :=
    positiveSourceNativeKinematicSeed_p286HodgeCurvature_smooth
      configuration smooth
  have coordinateAuxiliarySmooth : ContDiff ℝ ∞ fun point =>
      p286GaugeConstitutiveAuxiliaryCoordinate
        positiveSmoothUnifiedSource
        ((positiveSourceNativeKinematicSeed configuration).coframe point)
        (fun candidate => p286CoordinateEquiv
          (holonomicGaugeCurvature
            (positiveSourceNativeKinematicSeed configuration) point candidate)) := by
    simpa [p286GaugeConstitutiveAuxiliaryCoordinate] using
      ((contDiff_const : ContDiff ℝ ∞ fun _ : BasePoint =>
          (((sourceGeneratedUnifiedCouplings
            positiveSmoothUnifiedSource).strongCouplingSquared : ℝ)⁻¹))
        |>.smul hodgeSmooth |>.neg)
  intro pair
  simpa [positiveSourceNativeAlgebraicEliminationUpdate,
    generatedP286GaugeConstitutiveAuxiliary] using
      (contDiff_pi.mp coordinateAuxiliarySmooth pair)

/-- Arbitrary smooth completions remain smooth after the source replaces the
three primitive kinematic fields and derives both auxiliaries from their
actual curvatures. -/
theorem positiveSourceNativeAlgebraicEliminationUpdate_smooth
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth) :
    (positiveSourceNativeAlgebraicEliminationUpdate configuration).Smooth := by
  have seedSmooth := positiveSourceNativeKinematicSeed_smooth configuration smooth
  rcases smooth with
    ⟨_oldCoframeSmooth, _oldGravityConnectionSmooth,
      _oldGravityAuxiliarySmooth, gravityMultiplierSmooth,
      _oldGaugeConnectionSmooth, _oldGaugeAuxiliarySmooth,
      scalarSmooth, matterSmooth, conjugateMatterSmooth⟩
  exact ⟨seedSmooth.1, seedSmooth.2.1,
    positiveSourceNativeAlgebraicEliminationUpdate_gravityAuxiliary_smooth
      configuration
      ⟨_oldCoframeSmooth, _oldGravityConnectionSmooth,
        _oldGravityAuxiliarySmooth, gravityMultiplierSmooth,
        _oldGaugeConnectionSmooth, _oldGaugeAuxiliarySmooth,
        scalarSmooth, matterSmooth, conjugateMatterSmooth⟩,
    gravityMultiplierSmooth, seedSmooth.2.2.2.2.1,
    positiveSourceNativeAlgebraicEliminationUpdate_gaugeAuxiliary_smooth
      configuration
      ⟨_oldCoframeSmooth, _oldGravityConnectionSmooth,
        _oldGravityAuxiliarySmooth, gravityMultiplierSmooth,
        _oldGaugeConnectionSmooth, _oldGaugeAuxiliarySmooth,
        scalarSmooth, matterSmooth, conjugateMatterSmooth⟩,
    scalarSmooth, matterSmooth, conjugateMatterSmooth⟩

/-! ## Unconditional canonical-template specialization -/

/-- A proof-engineering holder with no physical claim.  It is used only to
instantiate generic regularity lemmas before the source overwrites both
connections and the coframe. -/
private def regularityZeroTemplate : StageNineHolonomicConfiguration where
  coframe := 0
  gravityConnection := 0
  gravityAuxiliary := 0
  gravitySimplicityMultiplier := 0
  gaugeConnection := 0
  gaugeAuxiliary := 0
  scalar := 0
  matter := 0
  conjugateMatter := 0

private theorem regularityZeroTemplate_smooth : regularityZeroTemplate.Smooth := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro row column
    exact contDiff_const
  · intro direction internalOut internalIn
    exact contDiff_const
  · intro internalPair spacetimePair
    exact contDiff_const
  · intro internalPair spacetimePair
    exact contDiff_const
  · intro direction
    simpa [regularityZeroTemplate] using
      (contDiff_const : ContDiff ℝ ∞ fun _ : BasePoint =>
        p286CoordinateEquiv (0 : P286LieBlockData))
  · intro pair
    simpa [regularityZeroTemplate] using
      (contDiff_const : ContDiff ℝ ∞ fun _ : BasePoint =>
        p286CoordinateEquiv (0 : P286LieBlockData))
  · exact contDiff_const
  · simpa [regularityZeroTemplate] using
      (contDiff_const : ContDiff ℝ ∞ fun _ : BasePoint =>
        matterCoordinateEquiv (0 : DiracExteriorMatterCarrier))
  · intro index
    exact contDiff_const

/-- The actual positive source coframe transports every fixed P286 coordinate
two-form smoothly through its dynamically generated Hodge operator. -/
private theorem positiveSourceCoframe_p286Hodge_smooth
    (form : Fin 6 → P286CoordinateCarrier) :
    ContDiff ℝ ∞ fun point =>
      liftGaugeTwoFormOperator
        (coframeGaugeSpacetimeHodgeLinear
          (positiveSmoothUnifiedSource.legacy.coframeAt point)) form := by
  let seed := positiveSourceNativeKinematicSeed regularityZeroTemplate
  have seedSmooth : seed.Smooth :=
    positiveSourceNativeKinematicSeed_smooth regularityZeroTemplate
      regularityZeroTemplate_smooth
  have seedNondegenerate : seed.Nondegenerate :=
    positiveSourceNativeKinematicSeed_nondegenerate regularityZeroTemplate
  change ContDiff ℝ ∞ fun point =>
    liftGaugeTwoFormOperator
      (coframeGaugeSpacetimeHodgeLinear (seed.coframe point)) form
  apply contDiff_pi'
  intro output
  unfold liftGaugeTwoFormOperator
  apply ContDiff.sum
  intro input _
  have coefficientSmooth : ContDiff ℝ ∞ fun point =>
      gaugeOperatorCoefficient
        (coframeGaugeSpacetimeHodgeLinear (seed.coframe point))
        output input := by
    let basis : GaugeTwoForm := fun candidate =>
      if candidate = input then 1 else 0
    have actual := holonomicGaugeSpacetimeHodge_apply_contDiff
      seed seedSmooth seedNondegenerate (fun _ => basis) contDiff_const
    exact contDiff_pi.mp actual output
  exact coefficientSmooth.smul contDiff_const

/-- The existing source-generated P286 constitutive solver is smooth for
every fixed curvature argument; no regularity field or receipt is supplied
to the source. -/
private theorem positiveSourceFixedP286ConstitutiveAuxiliary_smooth
    (curvature : Fin 6 → P286LieBlockData) :
    ContDiff ℝ ∞ fun point =>
      p286GaugeConstitutiveAuxiliaryCoordinate
        positiveSmoothUnifiedSource
        (positiveSmoothUnifiedSource.legacy.coframeAt point)
        (fun pair => p286CoordinateEquiv (curvature pair)) := by
  have hodgeSmooth := positiveSourceCoframe_p286Hodge_smooth
    (fun pair => p286CoordinateEquiv (curvature pair))
  simpa [p286GaugeConstitutiveAuxiliaryCoordinate] using
    ((contDiff_const : ContDiff ℝ ∞ fun _ : BasePoint =>
        (((sourceGeneratedUnifiedCouplings
          positiveSmoothUnifiedSource).strongCouplingSquared : ℝ)⁻¹))
      |>.smul hodgeSmooth |>.neg)

/-- The historical residual-limit reader is genuinely smooth from its actual
definitions.  This theorem has no smoothness premise. -/
theorem residualLimitLorentzCarrierReader_smooth :
    residualLimitLorentzCarrierReader.Smooth := by
  have sourceCoframeSmooth : ∀ row column,
      ContDiff ℝ ∞ fun point =>
        positiveSmoothUnifiedSource.legacy.coframeAt point row column := by
    intro row column
    exact (contDiff_pi.mp
      (contDiff_pi.mp
        positiveSmoothUnifiedSource.legacy.coframeAt_contDiff row) column).of_le
          (by simp)
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · change ∀ row column,
      ContDiff ℝ ∞ fun point =>
        positiveSmoothUnifiedSource.legacy.coframeAt point row column
    exact sourceCoframeSmooth
  · change ∀ direction internalOut internalIn,
      ContDiff ℝ ∞ fun point =>
        positiveSourceGravityMouthResidualLimitConnectionField point
          direction internalOut internalIn
    exact positiveSourceGravityMouthResidualLimitConnectionField_smooth
  · intro internalPair spacetimePair
    change ContDiff ℝ ∞ fun point =>
      physicalIIPlusBivector
        (positiveSmoothUnifiedSource.legacy.coframeAt point)
        internalPair spacetimePair
    fin_cases internalPair <;>
      simp [physicalIIPlusBivector, internalBivectorDual,
        lorentzianCoframeHodge, coframeWedge] <;>
      exact ((sourceCoframeSmooth _ _).mul (sourceCoframeSmooth _ _)).sub
        ((sourceCoframeSmooth _ _).mul (sourceCoframeSmooth _ _))
  · intro internalPair spacetimePair
    exact contDiff_const
  · change ∀ direction,
      ContDiff ℝ ∞ fun point =>
        p286CoordinateEquiv
          (sourceP286AffineConnectionField
            positiveSmoothUnifiedSource.legacy point direction)
    exact sourceP286AffineConnectionField_smooth _
  · intro pair
    change ContDiff ℝ ∞ fun point =>
      p286CoordinateEquiv
        (generatedP286GaugeConstitutiveAuxiliary
          positiveSmoothUnifiedSource
          (positiveSmoothUnifiedSource.legacy.coframeAt point)
          (sourceP286TargetCurvature positiveSmoothUnifiedSource.legacy) pair)
    simpa [generatedP286GaugeConstitutiveAuxiliary] using
      (contDiff_pi.mp
        (positiveSourceFixedP286ConstitutiveAuxiliary_smooth
          (sourceP286TargetCurvature positiveSmoothUnifiedSource.legacy)) pair)
  · change ContDiff ℝ ∞
      (generatedLocalVacuumCoordinates positiveSmoothUnifiedSource 0)
    rw [show generatedLocalVacuumCoordinates positiveSmoothUnifiedSource 0 =
        fun _ : BasePoint =>
          sourceGeneratedVacuumCoordinates positiveSmoothUnifiedSource by
      funext point
      unfold generatedLocalVacuumCoordinates generatedScalarFrame
      rw [generatedTransition_normalized]
      exact scalarCoordinateAction_one _]
    exact contDiff_const
  · change ContDiff ℝ ∞ fun _ : BasePoint =>
      matterCoordinateEquiv (0 : DiracExteriorMatterCarrier)
    exact contDiff_const
  · intro index
    exact contDiff_const

/-- The requested canonical source-reference specialization consumes no
smoothness receipt: its premise-free smoothness is generated just above. -/
theorem positiveSourceNativeAlgebraicEliminationUpdate_reference_smooth :
    (positiveSourceNativeAlgebraicEliminationUpdate
      residualLimitLorentzCarrierReader).Smooth :=
  positiveSourceNativeAlgebraicEliminationUpdate_smooth
    residualLimitLorentzCarrierReader residualLimitLorentzCarrierReader_smooth

/-- C3h70 then remains smooth on the same canonical source-reference input. -/
theorem positiveSourceNativeGravityAlgebraicKeepResponse_reference_smooth :
    (gravityAlgebraicKeepResponseUpdate positiveSmoothUnifiedSource
      (positiveSourceNativeAlgebraicEliminationUpdate
        residualLimitLorentzCarrierReader)).Smooth :=
  gravityAlgebraicKeepResponseUpdate_smooth positiveSmoothUnifiedSource
    (positiveSourceNativeAlgebraicEliminationUpdate
      residualLimitLorentzCarrierReader)
    positiveSourceNativeAlgebraicEliminationUpdate_reference_smooth

/-- Actual off-shell gravity Bianchi for the C3h70 canonical response. -/
theorem positiveSourceNativeGravityAlgebraicKeepResponse_reference_gravityBianchi
    (point : BasePoint)
    (first second third : LorentzianIndex) :
    covariantMixedCurvatureDerivative
          (gravityAlgebraicKeepResponseUpdate positiveSmoothUnifiedSource
            (positiveSourceNativeAlgebraicEliminationUpdate
              residualLimitLorentzCarrierReader))
          point first second third +
        covariantMixedCurvatureDerivative
          (gravityAlgebraicKeepResponseUpdate positiveSmoothUnifiedSource
            (positiveSourceNativeAlgebraicEliminationUpdate
              residualLimitLorentzCarrierReader))
          point second third first +
        covariantMixedCurvatureDerivative
          (gravityAlgebraicKeepResponseUpdate positiveSmoothUnifiedSource
            (positiveSourceNativeAlgebraicEliminationUpdate
              residualLimitLorentzCarrierReader))
          point third first second = 0 := by
  exact gravityAlgebraicKeepResponseUpdate_bianchi
    positiveSmoothUnifiedSource
    (positiveSourceNativeAlgebraicEliminationUpdate
      residualLimitLorentzCarrierReader)
    positiveSourceNativeAlgebraicEliminationUpdate_reference_smooth
    point first second third

/-- The same smooth response also satisfies actual off-shell P286 Bianchi;
this remains a kinematic identity, not joint-shell closure. -/
theorem positiveSourceNativeGravityAlgebraicKeepResponse_reference_p286Bianchi
    (point : BasePoint)
    (first second third : LorentzianIndex) :
    StageNineP286Bianchi.covariantCurvatureDerivative
          (gravityAlgebraicKeepResponseUpdate positiveSmoothUnifiedSource
            (positiveSourceNativeAlgebraicEliminationUpdate
              residualLimitLorentzCarrierReader))
          point first second third +
        StageNineP286Bianchi.covariantCurvatureDerivative
          (gravityAlgebraicKeepResponseUpdate positiveSmoothUnifiedSource
            (positiveSourceNativeAlgebraicEliminationUpdate
              residualLimitLorentzCarrierReader))
          point second third first +
        StageNineP286Bianchi.covariantCurvatureDerivative
          (gravityAlgebraicKeepResponseUpdate positiveSmoothUnifiedSource
            (positiveSourceNativeAlgebraicEliminationUpdate
              residualLimitLorentzCarrierReader))
          point third first second = 0 := by
  exact holonomicP286GaugeCurvature_bianchi
    (gravityAlgebraicKeepResponseUpdate positiveSmoothUnifiedSource
      (positiveSourceNativeAlgebraicEliminationUpdate
        residualLimitLorentzCarrierReader))
    positiveSourceNativeGravityAlgebraicKeepResponse_reference_smooth
    point first second third

end

