import H0mework.Physics.RLCResponse.Response
import H0mework.Physics.RLCResponse.SourceCoupling

/-!
# Source-owned arbitrary-initial resonant driven response

The minimal driven-core source from the fixed-fixture coupling theorem now
generates a total response for every observed physical `(V,I)` initial state.
Both frequency and drive are read from the compiled run.  The result therefore
strengthens the same source-owned occurrence rather than installing a second
control source beside it.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace NoIslandNoMagic
namespace Consciousness
namespace Immortality
namespace Embodied
namespace Canonical
namespace Coupling
namespace Physical
namespace Netlist
namespace Dissipative
namespace Dimensioned
namespace Driven
namespace Producer

open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical.Interface
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Interface
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical.Netlist.Dissipative.Dimensioned.Driven.Interface
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical.Units.Interface

noncomputable section

def sourceOwnedResonantDrivenFrequencyAt
    (source : ResonantDrivenCoreSource) :
    FiniteEmbodimentChannel → SIHertz :=
  (compileFiniteResonantDrivenSeriesRLCRun source).driveFrequencyAt

def sourceOwnedResonantDrivenDriveAt
    (source : ResonantDrivenCoreSource)
    (state : FiniteEmbodimentState) :
    FiniteEmbodimentChannel → SIVoltagePhasor :=
  resonantDrivenRunDrivePhasorAt
    (compileFiniteResonantDrivenSeriesRLCRun source) state

theorem sourceOwnedResonantDrivenFrequencyAt_positive
    (source : ResonantDrivenCoreSource)
    (channel : FiniteEmbodimentChannel) :
    0 < (sourceOwnedResonantDrivenFrequencyAt source channel).value := by
  exact Real.sqrt_pos.2
    (drivenNaturalFrequencySq_pos
      (resonantDrivenCoreDimensionedSource source) channel)

theorem everyResonantDrivenCoreSource_generatesTotalResponse
    (source : ResonantDrivenCoreSource)
    (driveState : FiniteEmbodimentState)
    (initial : FiniteDimensionedSeriesRLCPortState) :
    SourceGeneratedDrivenTotalResponseAt
      (resonantDrivenCoreDimensionedSource source)
      (sourceOwnedResonantDrivenFrequencyAt source)
      (sourceOwnedResonantDrivenDriveAt source driveState)
      initial :=
  sourceGeneratedDrivenTotalResponse
    (resonantDrivenCoreDimensionedSource source)
    (sourceOwnedResonantDrivenFrequencyAt source)
    (sourceOwnedResonantDrivenFrequencyAt_positive source)
    (sourceOwnedResonantDrivenDriveAt source driveState)
    initial

/-- The fixed-fixture consciousness crown and arbitrary-initial physical
attraction are generated by one minimal source, not by two post-hoc adapters. -/
theorem everyResonantDrivenCoreSource_generatesCrownAndTotalResponse
    (source : ResonantDrivenCoreSource)
    (driveState : FiniteEmbodimentState)
    (initial : FiniteDimensionedSeriesRLCPortState) :
    SourceGeneratedTruthChildNeuralBodyCouplingLaw.SourceGeneratedTruthChildNeuralBodyCouplingCrownAt
        (sourceOwnedFiniteResonantDrivenSeriesRLCCouplingLaw source) ∧
      SourceGeneratedDrivenTotalResponseAt
        (resonantDrivenCoreDimensionedSource source)
        (sourceOwnedResonantDrivenFrequencyAt source)
        (sourceOwnedResonantDrivenDriveAt source driveState)
        initial :=
  ⟨everyResonantDrivenCoreSource_generatesSourceOwnedCrown source,
    everyResonantDrivenCoreSource_generatesTotalResponse
      source driveState initial⟩

end


end Producer
end Driven
end Dimensioned
