open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical.Netlist.Dissipative.Producer
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical.Netlist.Dissipative.Dimensioned.Producer
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical.Units.Interface

noncomputable section

private theorem harmonicSource_isBoundedUnder
    (frequency momentum position : ℝ) :
    IsBoundedUnder (· ≤ ·) atTop
      (norm ∘ fun time : ℝ =>
        Real.cos (frequency * time) * momentum -
          Real.sin (frequency * time) * position) := by
  apply Filter.isBoundedUnder_of
  refine ⟨|momentum| + |position|, ?_⟩
  intro time
  simp only [Function.comp_apply, Real.norm_eq_abs]
  calc
    |Real.cos (frequency * time) * momentum -
        Real.sin (frequency * time) * position| ≤
        |Real.cos (frequency * time) * momentum| +
          |Real.sin (frequency * time) * position| := abs_sub _ _
    _ = |Real.cos (frequency * time)| * |momentum| +
          |Real.sin (frequency * time)| * |position| := by
      rw [abs_mul, abs_mul]
    _ ≤ 1 * |momentum| + 1 * |position| := by
      exact add_le_add
        (mul_le_mul_of_nonneg_right (Real.abs_cos_le_one _) (abs_nonneg _))
        (mul_le_mul_of_nonneg_right (Real.abs_sin_le_one _) (abs_nonneg _))
    _ = |momentum| + |position| := by ring

private theorem harmonicTarget_isBoundedUnder
    (frequency momentum position : ℝ) :
    IsBoundedUnder (· ≤ ·) atTop
      (norm ∘ fun time : ℝ =>
        Real.sin (frequency * time) * momentum +
          Real.cos (frequency * time) * position) := by
  apply Filter.isBoundedUnder_of
  refine ⟨|momentum| + |position|, ?_⟩
  intro time
  simp only [Function.comp_apply, Real.norm_eq_abs]
  calc
    |Real.sin (frequency * time) * momentum +
        Real.cos (frequency * time) * position| ≤
        |Real.sin (frequency * time) * momentum| +
          |Real.cos (frequency * time) * position| := abs_add_le _ _
    _ = |Real.sin (frequency * time)| * |momentum| +
          |Real.cos (frequency * time)| * |position| := by
      rw [abs_mul, abs_mul]
    _ ≤ 1 * |momentum| + 1 * |position| := by
      exact add_le_add
        (mul_le_mul_of_nonneg_right (Real.abs_sin_le_one _) (abs_nonneg _))
        (mul_le_mul_of_nonneg_right (Real.abs_cos_le_one _) (abs_nonneg _))
    _ = |momentum| + |position| := by ring

theorem finiteSeriesRLCScaleAt_tendsto_zero
    (run : FiniteSeriesRLCNetlistRunOccurrence)
    (channel : FiniteEmbodimentChannel)
    (dampingPositive : 0 < run.dampingRateAt channel) :
    Tendsto (fun time : ℝ => finiteSeriesRLCScaleAt run channel time)
      atTop (𝓝 0) := by
  have exponentTendsToNegInfinity :
      Tendsto (fun time : ℝ => (-run.dampingRateAt channel) * time)
        atTop atBot :=
    tendsto_id.const_mul_atTop_of_neg (neg_lt_zero.mpr dampingPositive)
  exact Real.tendsto_exp_atBot.comp exponentTendsToNegInfinity

theorem finiteSeriesRLC_sourcePort_tendsto_zero
    (run : FiniteSeriesRLCNetlistRunOccurrence)
    (initial : FiniteEmbodimentState)
    (channel : FiniteEmbodimentChannel)
    (dampingPositive : 0 < run.dampingRateAt channel) :
    Tendsto
      (fun time : ℝ =>
        sourcePort (finiteSeriesRLCFlowAt run initial time) channel)
      atTop (𝓝 0) := by
  have scaleTendsToZero :=
    finiteSeriesRLCScaleAt_tendsto_zero run channel dampingPositive
  have harmonicBounded := harmonicSource_isBoundedUnder
    (run.baseRun.frequencyAt channel) (sourcePort initial channel)
      (targetPort initial channel)
  have productTendsToZero :=
    scaleTendsToZero.zero_mul_isBoundedUnder_le harmonicBounded
  simpa [finiteSeriesRLCFlowAt, finiteParallelLCFlowAt, harmonicFlow,
    finiteSeriesRLCScaleAt, sourcePort, targetPort] using productTendsToZero

theorem finiteSeriesRLC_targetPort_tendsto_zero
    (run : FiniteSeriesRLCNetlistRunOccurrence)
    (initial : FiniteEmbodimentState)
    (channel : FiniteEmbodimentChannel)
    (dampingPositive : 0 < run.dampingRateAt channel) :
    Tendsto
      (fun time : ℝ =>
        targetPort (finiteSeriesRLCFlowAt run initial time) channel)
      atTop (𝓝 0) := by
  have scaleTendsToZero :=
    finiteSeriesRLCScaleAt_tendsto_zero run channel dampingPositive
  have harmonicBounded := harmonicTarget_isBoundedUnder
    (run.baseRun.frequencyAt channel) (sourcePort initial channel)
      (targetPort initial channel)
  have productTendsToZero :=
    scaleTendsToZero.zero_mul_isBoundedUnder_le harmonicBounded
  simpa [finiteSeriesRLCFlowAt, finiteParallelLCFlowAt, harmonicFlow,
    finiteSeriesRLCScaleAt, sourcePort, targetPort] using productTendsToZero

theorem finiteSeriesRLC_current_tendsto_zero
    (run : FiniteSeriesRLCNetlistRunOccurrence)
    (initial : FiniteEmbodimentState)
    (channel : FiniteEmbodimentChannel)
    (dampingPositive : 0 < run.dampingRateAt channel) :
    Tendsto (finiteSeriesRLCCurrentAt run initial channel) atTop (𝓝 0) := by
  have sourceTendsToZero := finiteSeriesRLC_sourcePort_tendsto_zero
    run initial channel dampingPositive
  have targetTendsToZero := finiteSeriesRLC_targetPort_tendsto_zero
    run initial channel dampingPositive
  change Tendsto
    (fun time : ℝ =>
      run.baseRun.frequencyAt channel *
          sourcePort (finiteSeriesRLCFlowAt run initial time) channel -
        run.dampingRateAt channel *
          targetPort (finiteSeriesRLCFlowAt run initial time) channel)
    atTop (𝓝 0)
  simpa using
    (sourceTendsToZero.const_mul (run.baseRun.frequencyAt channel)).sub
      (targetTendsToZero.const_mul (run.dampingRateAt channel))

theorem compiledFiniteDimensionedSeriesRLC_normalizedTime_tendsto_atTop
    (source : DimensionedSeriesRLCSource) :
    Tendsto
      (fun physicalTime : ℝ =>
        finiteDimensionedSeriesRLCNormalizedTimeAt
          (compileFiniteDimensionedSeriesRLCNetlistRun source)
          (⟨physicalTime⟩ : SISecond))
      atTop atTop := by
  have inversePositive : 0 < source.2.timeScale.value⁻¹ :=
    inv_pos.mpr source.2.timeScalePositive
  simpa [finiteDimensionedSeriesRLCNormalizedTimeAt,
    compiledFiniteDimensionedSeriesRLC_scale,
    SIQuantity.sameDimensionRatio_value, div_eq_mul_inv, mul_comm] using
    tendsto_id.const_mul_atTop inversePositive

theorem compiledFiniteDimensionedSeriesRLC_voltage_tendsto_zero
    (source : DimensionedSeriesRLCSource)
    (initial : FiniteEmbodimentState)
    (channel : FiniteEmbodimentChannel) :
    Tendsto
      (fun physicalTime : ℝ =>
        (finiteDimensionedSeriesRLCVoltageAt
          (compileFiniteDimensionedSeriesRLCNetlistRun source)
          initial channel (⟨physicalTime⟩ : SISecond)).value)
      atTop (𝓝 0) := by
  have normalizedTargetTendsToZero := finiteSeriesRLC_targetPort_tendsto_zero
    (compileFiniteSeriesRLCNetlistRun source.1) initial channel
      (by
        rw [compiledFiniteSeriesRLCNetlistRun_dampingRateAt]
        exact finiteSeriesRLCDampingRate_pos)
  have physicalTargetTendsToZero := normalizedTargetTendsToZero.comp
    (compiledFiniteDimensionedSeriesRLC_normalizedTime_tendsto_atTop source)
  simpa [finiteDimensionedSeriesRLCVoltageAt, finiteSeriesRLCVoltageAt,
    compiledFiniteDimensionedSeriesRLC_normalizedRun,
    SIQuantity.scale_value, mul_comm] using
    physicalTargetTendsToZero.const_mul source.2.voltageScale.value

theorem compiledFiniteDimensionedSeriesRLC_current_tendsto_zero
    (source : DimensionedSeriesRLCSource)
    (initial : FiniteEmbodimentState)
    (channel : FiniteEmbodimentChannel) :
    Tendsto
      (fun physicalTime : ℝ =>
        (finiteDimensionedSeriesRLCCurrentAt
          (compileFiniteDimensionedSeriesRLCNetlistRun source)
          initial channel (⟨physicalTime⟩ : SISecond)).value)
      atTop (𝓝 0) := by
  have normalizedCurrentTendsToZero := finiteSeriesRLC_current_tendsto_zero
    (compileFiniteSeriesRLCNetlistRun source.1) initial channel
      (by
        rw [compiledFiniteSeriesRLCNetlistRun_dampingRateAt]
        exact finiteSeriesRLCDampingRate_pos)
  have physicalCurrentTendsToZero := normalizedCurrentTendsToZero.comp
    (compiledFiniteDimensionedSeriesRLC_normalizedTime_tendsto_atTop source)
  simpa [finiteDimensionedSeriesRLCCurrentAt,
    compiledFiniteDimensionedSeriesRLC_normalizedRun,
    SIQuantity.scale_value, mul_comm] using
    physicalCurrentTendsToZero.const_mul source.2.currentScale.value

end

