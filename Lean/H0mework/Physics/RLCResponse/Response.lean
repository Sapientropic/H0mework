import H0mework.Physics.RLCResponse.PortState
import H0mework.Physics.RLCResponse.Attraction

/-!
# Arbitrary-initial total response of a driven dimensioned series-RLC run

For every physical `(V,I)` initial state, this file derives the unique
homogeneous correction generated by the compiled damped shear and adds it to
the already proved periodic particular solution.  The resulting total
response starts at the requested state, satisfies the same forced circuit
laws, and converges to the moving periodic orbit because its generated
homogeneous residual tends to zero.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace NoIslandNoMagic
namespace Consciousness
namespace Immortality
namespace Embodied
namespace Canonical
namespace Coupling
namespace Physical
namespace Netlist
namespace Dissipative
namespace Dimensioned
namespace Driven
namespace Producer

open Filter
open scoped Topology
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical.Interface
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical.Netlist.Interface
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical.Netlist.Dissipative.Interface
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical.Netlist.Dissipative.Producer
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical.Netlist.Dissipative.Dimensioned.Producer
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical.Netlist.Dissipative.Dimensioned.Driven.Interface
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical.Units.Interface

noncomputable section

def drivenPeriodicPortStateAt
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (physicalTime : SISecond) : FiniteDimensionedSeriesRLCPortState where
  voltageAt := fun channel =>
    drivenPeriodicVoltageAt source channel (frequencyAt channel)
      (driveAt channel) physicalTime
  currentAt := fun channel =>
    drivenPeriodicCurrentAt source channel (frequencyAt channel)
      (driveAt channel) physicalTime

def drivenInitialVoltageResidualRatioAt
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState)
    (channel : FiniteEmbodimentChannel) : ℝ :=
  ((initial.voltageAt channel -
      drivenPeriodicVoltageAt source channel (frequencyAt channel)
        (driveAt channel) 0).value) / source.2.voltageScale.value

def drivenInitialCurrentResidualRatioAt
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState)
    (channel : FiniteEmbodimentChannel) : ℝ :=
  ((initial.currentAt channel -
      drivenPeriodicCurrentAt source channel (frequencyAt channel)
        (driveAt channel) 0).value) / source.2.currentScale.value

def drivenInitialPortResidualAt
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState) :
    FiniteDimensionedSeriesRLCPortState where
  voltageAt := fun channel =>
    initial.voltageAt channel -
      drivenPeriodicVoltageAt source channel (frequencyAt channel)
        (driveAt channel) 0
  currentAt := fun channel =>
    initial.currentAt channel -
      drivenPeriodicCurrentAt source channel (frequencyAt channel)
        (driveAt channel) 0

/-- Inverse of the actual damped current shear
`j = ν p - α v`, generated independently in every compiled row. -/
def drivenHomogeneousInitialAt
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState) :
    FiniteEmbodimentState :=
  fun channel =>
    let run := compileFiniteSeriesRLCNetlistRun source.1
    let voltageResidual := drivenInitialVoltageResidualRatioAt
      source frequencyAt driveAt initial channel
    let currentResidual := drivenInitialCurrentResidualRatioAt
      source frequencyAt driveAt initial channel
    ((currentResidual + run.dampingRateAt channel * voltageResidual) /
        run.baseRun.frequencyAt channel,
      voltageResidual)

theorem drivenHomogeneousInitial_eq_normalizePortResidual
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState) :
    drivenHomogeneousInitialAt source frequencyAt driveAt initial =
      normalizeFiniteDimensionedSeriesRLCPortState
        (compileFiniteDimensionedSeriesRLCNetlistRun source)
        (drivenInitialPortResidualAt source frequencyAt driveAt initial) := by
  rfl

theorem drivenHomogeneousInitial_portState_exact
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState) :
    finiteDimensionedSeriesRLCPortStateOfNormalized
        (compileFiniteDimensionedSeriesRLCNetlistRun source)
        (drivenHomogeneousInitialAt source frequencyAt driveAt initial) =
      drivenInitialPortResidualAt source frequencyAt driveAt initial := by
  rw [drivenHomogeneousInitial_eq_normalizePortResidual]
  exact compiledFiniteDimensionedSeriesRLC_portStateOfNormalized_normalize
    source (drivenInitialPortResidualAt source frequencyAt driveAt initial)

/-- No second normalized residual can realize the same physical `(V,I)`
initial correction. -/
theorem drivenHomogeneousInitial_unique
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState)
    (candidate : FiniteEmbodimentState)
    (candidateExact :
      finiteDimensionedSeriesRLCPortStateOfNormalized
          (compileFiniteDimensionedSeriesRLCNetlistRun source) candidate =
        drivenInitialPortResidualAt source frequencyAt driveAt initial) :
    candidate = drivenHomogeneousInitialAt
      source frequencyAt driveAt initial := by
  apply compiledFiniteDimensionedSeriesRLCPortStateOfNormalized_injective source
  rw [candidateExact, drivenHomogeneousInitial_portState_exact]

def drivenTotalVoltageAt
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState)
    (channel : FiniteEmbodimentChannel) (physicalTime : SISecond) : SIVolt :=
  drivenPeriodicVoltageAt source channel (frequencyAt channel)
      (driveAt channel) physicalTime +
    finiteDimensionedSeriesRLCVoltageAt
      (compileFiniteDimensionedSeriesRLCNetlistRun source)
      (drivenHomogeneousInitialAt source frequencyAt driveAt initial)
      channel physicalTime

def drivenTotalCurrentAt
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState)
    (channel : FiniteEmbodimentChannel) (physicalTime : SISecond) : SIAmpere :=
  drivenPeriodicCurrentAt source channel (frequencyAt channel)
      (driveAt channel) physicalTime +
    finiteDimensionedSeriesRLCCurrentAt
      (compileFiniteDimensionedSeriesRLCNetlistRun source)
      (drivenHomogeneousInitialAt source frequencyAt driveAt initial)
      channel physicalTime

def drivenTotalPortStateAt
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState)
    (physicalTime : SISecond) : FiniteDimensionedSeriesRLCPortState where
  voltageAt := fun channel =>
    drivenTotalVoltageAt source frequencyAt driveAt initial channel physicalTime
  currentAt := fun channel =>
    drivenTotalCurrentAt source frequencyAt driveAt initial channel physicalTime

theorem drivenHomogeneousInitial_voltage_exact
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState)
    (channel : FiniteEmbodimentChannel) :
    finiteDimensionedSeriesRLCVoltageAt
        (compileFiniteDimensionedSeriesRLCNetlistRun source)
        (drivenHomogeneousInitialAt source frequencyAt driveAt initial)
        channel 0 =
      initial.voltageAt channel -
        drivenPeriodicVoltageAt source channel (frequencyAt channel)
          (driveAt channel) 0 := by
  apply SIQuantity.ext
  simp [finiteDimensionedSeriesRLCVoltageAt,
    finiteDimensionedSeriesRLCNormalizedTimeAt,
    finiteSeriesRLCVoltageAt, drivenHomogeneousInitialAt,
    drivenInitialVoltageResidualRatioAt, targetPort]
  field_simp [source.2.voltageScale_ne]

theorem drivenHomogeneousInitial_current_exact
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState)
    (channel : FiniteEmbodimentChannel) :
    finiteDimensionedSeriesRLCCurrentAt
        (compileFiniteDimensionedSeriesRLCNetlistRun source)
        (drivenHomogeneousInitialAt source frequencyAt driveAt initial)
        channel 0 =
      initial.currentAt channel -
        drivenPeriodicCurrentAt source channel (frequencyAt channel)
          (driveAt channel) 0 := by
  have frequencyNonzero :
      (compileFiniteSeriesRLCNetlistRun source.1).baseRun.frequencyAt
        channel ≠ 0 :=
    ne_of_gt (compiledFiniteSeriesRLCNetlistRun_frequency_pos source.1 channel)
  have normalizedShear :
      finiteSeriesRLCCurrentAt
          (compileFiniteSeriesRLCNetlistRun source.1)
          (drivenHomogeneousInitialAt source frequencyAt driveAt initial)
          channel 0 =
        drivenInitialCurrentResidualRatioAt
          source frequencyAt driveAt initial channel := by
    rw [finiteSeriesRLCCurrentAt_zero]
    simp only [drivenHomogeneousInitialAt, sourcePort, targetPort]
    field_simp [frequencyNonzero]
    ring
  apply SIQuantity.ext
  simp only [finiteDimensionedSeriesRLCCurrentAt,
    compiledFiniteDimensionedSeriesRLC_normalizedRun,
    compiledFiniteDimensionedSeriesRLC_scale,
    finiteDimensionedSeriesRLCNormalizedTimeAt,
    SIQuantity.sameDimensionRatio_value, SIQuantity.zero_value, zero_div,
    SIQuantity.scale_value]
  rw [normalizedShear]
  simp only [drivenInitialCurrentResidualRatioAt, SIQuantity.sub_value]
  field_simp [source.2.currentScale_ne]

theorem drivenTotal_voltage_initial_exact
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState)
    (channel : FiniteEmbodimentChannel) :
    drivenTotalVoltageAt source frequencyAt driveAt initial channel 0 =
      initial.voltageAt channel := by
  rw [drivenTotalVoltageAt, drivenHomogeneousInitial_voltage_exact]
  apply SIQuantity.ext
  simp

theorem drivenTotal_current_initial_exact
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState)
    (channel : FiniteEmbodimentChannel) :
    drivenTotalCurrentAt source frequencyAt driveAt initial channel 0 =
      initial.currentAt channel := by
  rw [drivenTotalCurrentAt, drivenHomogeneousInitial_current_exact]
  apply SIQuantity.ext
  simp

theorem drivenTotalPortState_initial_exact
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState) :
    drivenTotalPortStateAt source frequencyAt driveAt initial 0 = initial := by
  apply FiniteDimensionedSeriesRLCPortState.ext <;> funext channel
  · exact drivenTotal_voltage_initial_exact
      source frequencyAt driveAt initial channel
  · exact drivenTotal_current_initial_exact
      source frequencyAt driveAt initial channel

/-! ## Total derivatives and circuit laws -/

def drivenTotalVoltageDerivativeAt
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState)
    (channel : FiniteEmbodimentChannel)
    (physicalTime : SISecond) : VoltageRateQuantity :=
  voltageWaveformDerivativeAt (frequencyAt channel)
      (drivenPeriodicVoltageResponsePhasorAt source channel
        (frequencyAt channel) (driveAt channel)) physicalTime +
    finiteDimensionedSeriesRLCVoltageDerivativeAt
      (compileFiniteDimensionedSeriesRLCNetlistRun source)
      (drivenHomogeneousInitialAt source frequencyAt driveAt initial)
      channel physicalTime

def drivenTotalCurrentDerivativeAt
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState)
    (channel : FiniteEmbodimentChannel)
    (physicalTime : SISecond) : CurrentRateQuantity :=
  currentWaveformDerivativeAt (frequencyAt channel)
      (drivenPeriodicCurrentPhasorAt source channel
        (frequencyAt channel) (driveAt channel)) physicalTime +
    finiteDimensionedSeriesRLCCurrentDerivativeAt
      (compileFiniteDimensionedSeriesRLCNetlistRun source)
      (drivenHomogeneousInitialAt source frequencyAt driveAt initial)
      channel physicalTime

theorem drivenTotalVoltage_hasSIQuantityDerivAt
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState)
    (channel : FiniteEmbodimentChannel) (physicalTime : SISecond) :
    HasSIQuantityDerivAt
      (drivenTotalVoltageAt source frequencyAt driveAt initial channel)
      (drivenTotalVoltageDerivativeAt
        source frequencyAt driveAt initial channel physicalTime)
      physicalTime := by
  constructor
  have periodicDerivative :=
    (drivenPeriodicVoltage_hasSIQuantityDerivAt source channel
      (frequencyAt channel) (driveAt channel) physicalTime).valueHasDerivAt
  have homogeneousDerivative :=
    (finiteDimensionedSeriesRLCVoltage_hasSIQuantityDerivAt
      (compileFiniteDimensionedSeriesRLCNetlistRun source)
      (drivenHomogeneousInitialAt source frequencyAt driveAt initial)
      channel physicalTime).valueHasDerivAt
  convert periodicDerivative.add homogeneousDerivative using 1 <;> try rfl

theorem drivenTotalCurrent_hasSIQuantityDerivAt
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState)
    (channel : FiniteEmbodimentChannel) (physicalTime : SISecond) :
    HasSIQuantityDerivAt
      (drivenTotalCurrentAt source frequencyAt driveAt initial channel)
      (drivenTotalCurrentDerivativeAt
        source frequencyAt driveAt initial channel physicalTime)
      physicalTime := by
  constructor
  have periodicDerivative :=
    (drivenPeriodicCurrent_hasSIQuantityDerivAt source channel
      (frequencyAt channel) (driveAt channel) physicalTime).valueHasDerivAt
  have homogeneousDerivative :=
    (finiteDimensionedSeriesRLCCurrent_hasSIQuantityDerivAt
      (compileFiniteDimensionedSeriesRLCNetlistRun source)
      (drivenHomogeneousInitialAt source frequencyAt driveAt initial)
      channel physicalTime).valueHasDerivAt
  convert periodicDerivative.add homogeneousDerivative using 1 <;> try rfl

theorem drivenTotal_capacitorConstitutiveLaw
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState)
    (channel : FiniteEmbodimentChannel) (physicalTime : SISecond) :
    capacitanceTimesVoltageRate
        ((compileFiniteDimensionedSeriesRLCNetlistRun source).capacitanceAt
          channel)
        (drivenTotalVoltageDerivativeAt
          source frequencyAt driveAt initial channel physicalTime) =
      drivenTotalCurrentAt source frequencyAt driveAt initial channel
        physicalTime := by
  have periodicLaw := congrArg SIQuantity.value
    (drivenPeriodic_capacitorConstitutiveLaw source channel
      (frequencyAt channel) (driveAt channel) physicalTime)
  have homogeneousLaw := congrArg SIQuantity.value
    (compiledFiniteDimensionedSeriesRLC_capacitorConstitutiveLaw source
      (drivenHomogeneousInitialAt source frequencyAt driveAt initial)
      channel physicalTime)
  apply SIQuantity.ext
  simp only [capacitanceTimesVoltageRate_value, SIQuantity.add_value,
    drivenTotalVoltageDerivativeAt, drivenTotalCurrentAt,
    finiteDimensionedSeriesRLCCurrentAt, SIQuantity.scale_value]
    at periodicLaw homogeneousLaw ⊢
  linear_combination periodicLaw + homogeneousLaw

def drivenTotalSeriesRLCElementCurrentAt
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState)
    (channel : FiniteEmbodimentChannel) (physicalTime : SISecond)
    (_element : SeriesRLCCoreElementKind) : SIAmpere :=
  drivenTotalCurrentAt source frequencyAt driveAt initial channel physicalTime

def drivenTotalSeriesRLCNodeCurrentAt
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState)
    (channel : FiniteEmbodimentChannel) (physicalTime : SISecond)
    (node : SeriesRLCLocalNode) : SIAmpere :=
  ((seriesRLCCoreIncidence node .seriesResistor : ℝ) •
      drivenTotalSeriesRLCElementCurrentAt source frequencyAt driveAt initial
        channel physicalTime .seriesResistor) +
    ((seriesRLCCoreIncidence node .inductor : ℝ) •
      drivenTotalSeriesRLCElementCurrentAt source frequencyAt driveAt initial
        channel physicalTime .inductor) +
    ((seriesRLCCoreIncidence node .capacitor : ℝ) •
      drivenTotalSeriesRLCElementCurrentAt source frequencyAt driveAt initial
        channel physicalTime .capacitor)

theorem drivenTotal_kirchhoffCurrentLaw
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState)
    (channel : FiniteEmbodimentChannel) (physicalTime : SISecond)
    (node : SeriesRLCLocalNode) :
    drivenTotalSeriesRLCNodeCurrentAt source frequencyAt driveAt initial
      channel physicalTime node = 0 := by
  apply SIQuantity.ext
  cases node <;>
    simp [drivenTotalSeriesRLCNodeCurrentAt,
      drivenTotalSeriesRLCElementCurrentAt, seriesRLCCoreIncidence]

theorem drivenTotal_forcedKirchhoffVoltageLaw
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (frequencyPositive : ∀ channel, 0 < (frequencyAt channel).value)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState)
    (channel : FiniteEmbodimentChannel) (physicalTime : SISecond) :
    inductanceTimesCurrentRate
        ((compileFiniteDimensionedSeriesRLCNetlistRun source).inductanceAt
          channel)
        (drivenTotalCurrentDerivativeAt
          source frequencyAt driveAt initial channel physicalTime) +
      resistanceTimesCurrent
        ((compileFiniteDimensionedSeriesRLCNetlistRun source
          ).seriesResistanceAt channel)
        (drivenTotalCurrentAt source frequencyAt driveAt initial channel
          physicalTime) +
      drivenTotalVoltageAt source frequencyAt driveAt initial channel
        physicalTime =
      voltageWaveformAt (frequencyAt channel) (driveAt channel)
        physicalTime := by
  have periodicLaw := congrArg SIQuantity.value
    (drivenPeriodic_forcedKirchhoffVoltageLaw source channel
      (frequencyAt channel) (frequencyPositive channel) (driveAt channel)
      physicalTime)
  have homogeneousLaw := congrArg SIQuantity.value
    (compiledFiniteDimensionedSeriesRLC_kirchhoffVoltageLaw source
      (drivenHomogeneousInitialAt source frequencyAt driveAt initial)
      channel physicalTime)
  apply SIQuantity.ext
  simp only [inductanceTimesCurrentRate_value,
    resistanceTimesCurrent_value, SIQuantity.add_value,
    SIQuantity.zero_value,
    drivenTotalCurrentDerivativeAt, drivenTotalCurrentAt,
    drivenTotalVoltageAt] at periodicLaw homogeneousLaw ⊢
  linear_combination periodicLaw + homogeneousLaw

/-! ## Attraction to the generated moving periodic orbit -/

theorem drivenTotal_voltage_sub_periodic_tendsto_zero
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState)
    (channel : FiniteEmbodimentChannel) :
    Tendsto
      (fun physicalTime : ℝ =>
        (drivenTotalVoltageAt source frequencyAt driveAt initial channel
            (⟨physicalTime⟩ : SISecond) -
          drivenPeriodicVoltageAt source channel (frequencyAt channel)
            (driveAt channel) (⟨physicalTime⟩ : SISecond)).value)
      atTop (𝓝 0) := by
  simpa [drivenTotalVoltageAt] using
    (compiledFiniteDimensionedSeriesRLC_voltage_tendsto_zero source
      (drivenHomogeneousInitialAt source frequencyAt driveAt initial) channel)

theorem drivenTotal_current_sub_periodic_tendsto_zero
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState)
    (channel : FiniteEmbodimentChannel) :
    Tendsto
      (fun physicalTime : ℝ =>
        (drivenTotalCurrentAt source frequencyAt driveAt initial channel
            (⟨physicalTime⟩ : SISecond) -
          drivenPeriodicCurrentAt source channel (frequencyAt channel)
            (driveAt channel) (⟨physicalTime⟩ : SISecond)).value)
      atTop (𝓝 0) := by
  simpa [drivenTotalCurrentAt] using
    (compiledFiniteDimensionedSeriesRLC_current_tendsto_zero source
      (drivenHomogeneousInitialAt source frequencyAt driveAt initial) channel)

theorem drivenTotal_portError_tendsto_zero
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState)
    (channel : FiniteEmbodimentChannel) :
    Tendsto
      (fun physicalTime : ℝ =>
        ((drivenTotalVoltageAt source frequencyAt driveAt initial channel
              (⟨physicalTime⟩ : SISecond) -
            drivenPeriodicVoltageAt source channel (frequencyAt channel)
              (driveAt channel) (⟨physicalTime⟩ : SISecond)).value,
          (drivenTotalCurrentAt source frequencyAt driveAt initial channel
              (⟨physicalTime⟩ : SISecond) -
            drivenPeriodicCurrentAt source channel (frequencyAt channel)
              (driveAt channel) (⟨physicalTime⟩ : SISecond)).value))
      atTop (𝓝 (0, 0)) := by
  exact (drivenTotal_voltage_sub_periodic_tendsto_zero
    source frequencyAt driveAt initial channel).prodMk_nhds
      (drivenTotal_current_sub_periodic_tendsto_zero
        source frequencyAt driveAt initial channel)

structure SourceGeneratedDrivenTotalResponseAt
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState) : Prop where
  frequencyPositive : ∀ channel, 0 < (frequencyAt channel).value
  periodicParticular : ∀ channel,
    SourceGeneratedDrivenPeriodicParticularAt source channel
      (frequencyAt channel) (driveAt channel)
  homogeneousResidualExact :
    type_of% (drivenHomogeneousInitial_portState_exact
      source frequencyAt driveAt initial)
  homogeneousResidualUnique : ∀ candidate,
    type_of% (drivenHomogeneousInitial_unique
      source frequencyAt driveAt initial candidate)
  initialExact :
    drivenTotalPortStateAt source frequencyAt driveAt initial 0 = initial
  voltageDerivative : ∀ channel physicalTime,
    type_of% (drivenTotalVoltage_hasSIQuantityDerivAt
      source frequencyAt driveAt initial channel physicalTime)
  currentDerivative : ∀ channel physicalTime,
    type_of% (drivenTotalCurrent_hasSIQuantityDerivAt
      source frequencyAt driveAt initial channel physicalTime)
  capacitorLaw : ∀ channel physicalTime,
    type_of% (drivenTotal_capacitorConstitutiveLaw
      source frequencyAt driveAt initial channel physicalTime)
  kirchhoffCurrent : ∀ channel physicalTime node,
    type_of% (drivenTotal_kirchhoffCurrentLaw
      source frequencyAt driveAt initial channel physicalTime node)
  forcedKirchhoffVoltage : ∀ channel physicalTime,
    type_of% (drivenTotal_forcedKirchhoffVoltageLaw source frequencyAt
      frequencyPositive driveAt initial channel physicalTime)
  attractsPeriodicOrbit : ∀ channel,
    type_of% (drivenTotal_portError_tendsto_zero
      source frequencyAt driveAt initial channel)

theorem sourceGeneratedDrivenTotalResponse
    (source : DimensionedSeriesRLCSource)
    (frequencyAt : FiniteEmbodimentChannel → SIHertz)
    (frequencyPositive : ∀ channel, 0 < (frequencyAt channel).value)
    (driveAt : FiniteEmbodimentChannel → SIVoltagePhasor)
    (initial : FiniteDimensionedSeriesRLCPortState) :
    SourceGeneratedDrivenTotalResponseAt
      source frequencyAt driveAt initial where
  frequencyPositive := frequencyPositive
  periodicParticular := fun channel =>
    sourceGeneratedDrivenPeriodicParticular source channel
      (frequencyAt channel) (driveAt channel) (frequencyPositive channel)
  homogeneousResidualExact :=
    drivenHomogeneousInitial_portState_exact
      source frequencyAt driveAt initial
  homogeneousResidualUnique :=
    drivenHomogeneousInitial_unique source frequencyAt driveAt initial
  initialExact := drivenTotalPortState_initial_exact
    source frequencyAt driveAt initial
  voltageDerivative := drivenTotalVoltage_hasSIQuantityDerivAt
