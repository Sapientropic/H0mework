import H0mework.Physics.Cartan.CartanContorsionTorsionEquiv
import H0mework.Physics.Lorentz.PointwiseLorentzSpinConnectionRecovery

/-!
# Actual affine Cartan connection generated from typed torsion

This module closes the pointwise kinematic seam left open by KIN-2.  For a
nondegenerate coframe first jet it starts from the canonical Levi--Civita spin
connection, adds the canonical lowered Lorentz-bivector contorsion recovered from
a typed Cartan torsion, and proves that the repository's literal
`pointwiseCartanTorsion` readout of the resulting connection is exactly that
torsion.

The construction consumes no source field, action equation, stationarity
receipt, curvature target, or supplied branch choice.  It is therefore a
kinematic actualizer/transporter.  The downstream action-facing producer must
generate the target torsion from the repaired-root W13 spin response before
using this map.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineCartanAffineConnectionActualization

open ProofFreeRicherAnholonomicSource
open PointwiseDiracSpinConnectionLift
open StageNineCartanContorsionTorsionEquiv
open StageNineGlobalIntegratedAction
open StageNineLorentzConnectionVariation
open StageNineResidualLinearPlebanskiTorsionReduction

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1200000

/-- Package the existing component-indexed Cartan torsion readout in the typed
24-dimensional two-form carrier used by KIN-2. -/
def actualPointwiseCartanTorsionTwoForm
    (jet : PointwiseLorentzianCoframeJet)
    (connection : PointwiseLorentzSpinConnection) :
    PointwiseCartanTorsionTwoForm :=
  ⟨fun pair internal =>
    pointwiseCartanTorsion jet connection
      (pairFirst pair) (pairSecond pair) internal⟩

/-- The canonical Levi--Civita spin connection is an actual zero-torsion
baseline for the literal Cartan readout. -/
theorem actualPointwiseCartanTorsionTwoForm_lorentzSpinConnection_eq_zero
    (jet : PointwiseLorentzianCoframeJet)
    (nondegenerate : Matrix.det jet.coframe ≠ 0) :
    actualPointwiseCartanTorsionTwoForm jet jet.lorentzSpinConnection = 0 := by
  ext pair internal
  unfold actualPointwiseCartanTorsionTwoForm pointwiseCartanTorsion
    pointwiseCoframeCovariantDerivative
  have firstTetrad := jet.tetradPostulate_lorentzSpinConnection
    (isUnit_iff_ne_zero.mpr nondegenerate)
    (pairFirst pair) internal (pairSecond pair)
  have secondTetrad := jet.tetradPostulate_lorentzSpinConnection
    (isUnit_iff_ne_zero.mpr nondegenerate)
    (pairSecond pair) internal (pairFirst pair)
  have affineSymmetry :
      (∑ upper : LorentzianIndex,
        jet.leviCivitaConnection upper (pairFirst pair) (pairSecond pair) *
          jet.coframe internal upper) =
        ∑ upper : LorentzianIndex,
          jet.leviCivitaConnection upper (pairSecond pair) (pairFirst pair) *
            jet.coframe internal upper := by
    apply Finset.sum_congr rfl
    intro upper _
    rw [jet.leviCivitaConnection_symm upper]
  change
    (jet.derivative (pairFirst pair) internal (pairSecond pair) +
        coframeConnectionAction jet.lorentzSpinConnection
          (pairFirst pair) jet.coframe internal (pairSecond pair)) -
      (jet.derivative (pairSecond pair) internal (pairFirst pair) +
        coframeConnectionAction jet.lorentzSpinConnection
          (pairSecond pair) jet.coframe internal (pairFirst pair)) = 0
  unfold coframeConnectionAction
  linarith

/-- Cartan torsion is affine in the spin connection: after separating a
baseline, the increment is evaluated on the zero-derivative coframe jet. -/
theorem actualPointwiseCartanTorsionTwoForm_add_increment
    (jet : PointwiseLorentzianCoframeJet)
    (baseline increment : PointwiseLorentzSpinConnection) :
    actualPointwiseCartanTorsionTwoForm jet (baseline + increment) =
      actualPointwiseCartanTorsionTwoForm jet baseline +
        actualPointwiseCartanTorsionTwoForm
          { coframe := jet.coframe, derivative := 0 } increment := by
  ext pair internal
  simp only [actualPointwiseCartanTorsionTwoForm,
    pointwiseCartanTorsionTwoForm_add_apply]
  unfold pointwiseCartanTorsion pointwiseCoframeCovariantDerivative
    coframeConnectionAction
  simp only [Pi.add_apply]
  simp_rw [add_mul, Finset.sum_add_distrib]
  simp only [Pi.zero_apply]
  ring

/-- The literal actual Cartan torsion generated by a lowered Lorentz-bivector
connection increment on a fixed coframe. -/
def actualCartanTorsionIncrementTwoForm
    (coframe : LorentzianCoframe)
    (contorsion : LorentzBivectorOneForm) :
    PointwiseCartanTorsionTwoForm :=
  actualPointwiseCartanTorsionTwoForm
    { coframe := coframe, derivative := 0 }
    (lorentzSkewConnectionOfBivectorOneForm contorsion)

/-- Polynomial frame naturality of the actual increment.  This direction uses
no inverse coframe and is the key seam between the literal readout and KIN-2's
factored internal-frame map. -/
theorem actualCartanTorsionIncrementTwoForm_pushforward
    (coframe : LorentzianCoframe)
    (contorsion : LorentzBivectorOneForm) :
    actualCartanTorsionIncrementTwoForm coframe
        (pushforwardLorentzBivectorOneForm coframe contorsion) =
      pushforwardCartanTorsionTwoForm coframe
        (minkowskiRaiseCartanTorsion
          (internalFrameCartanTorsion contorsion)) := by
  ext pair internal
  fin_cases pair <;> fin_cases internal <;>
    simp [actualCartanTorsionIncrementTwoForm,
      actualPointwiseCartanTorsionTwoForm,
      pushforwardCartanTorsionTwoForm, coframeTwoFormLinear,
      pointwiseCartanTorsion, pointwiseCoframeCovariantDerivative,
      coframeConnectionAction, lorentzSkewConnectionOfBivectorOneForm,
      pushforwardLorentzBivectorOneForm, internalFrameCartanTorsion,
      minkowskiRaiseCartanTorsion, loweredLorentzBivectorMatrix,
      orientedLorentzBivectorBasisCoefficient, coframeWedge,
      pairFirst, pairSecond, Matrix.mulVec, dotProduct,
      Fin.sum_univ_four, Fin.sum_univ_six] <;>
    ring

/-- On a nondegenerate coframe, the literal actual increment is exactly the
KIN-2 contorsion-to-torsion map. -/
theorem actualCartanTorsionIncrementTwoForm_eq_factored
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (contorsion : LorentzBivectorOneForm) :
    actualCartanTorsionIncrementTwoForm coframe contorsion =
      cartanTorsionOfContorsion coframe contorsion := by
  unfold cartanTorsionOfContorsion
  rw [← actualCartanTorsionIncrementTwoForm_pushforward]
  rw [pushforward_pullbackLorentzBivectorOneForm coframe nondegenerate]

/-- Add a lowered Lorentz-bivector contorsion to the coframe jet's canonical
Levi--Civita spin connection. -/
def cartanAffineSpinConnection
    (jet : PointwiseLorentzianCoframeJet)
    (contorsion : LorentzBivectorOneForm) :
    PointwiseLorentzSpinConnection :=
  jet.lorentzSpinConnection +
    lorentzSkewConnectionOfBivectorOneForm contorsion

/-- Pointwise Lorentz skewness is closed under addition. -/
theorem lorentzSkew_add
    {first second : PointwiseLorentzSpinConnection}
    (firstSkew : LorentzSkew first)
    (secondSkew : LorentzSkew second) :
    LorentzSkew (first + second) := by
  intro formDirection
  have firstAt := firstSkew formDirection
  have secondAt := secondSkew formDirection
  rw [show spinConnectionMatrix (first + second) formDirection =
      spinConnectionMatrix first formDirection +
        spinConnectionMatrix second formDirection by
    ext internalOut internalIn
    rfl]
  rw [Matrix.transpose_add, Matrix.add_mul, Matrix.mul_add]
  calc
    (Matrix.transpose (spinConnectionMatrix first formDirection) *
          minkowskiInternalMetric +
        Matrix.transpose (spinConnectionMatrix second formDirection) *
          minkowskiInternalMetric) +
      (minkowskiInternalMetric * spinConnectionMatrix first formDirection +
        minkowskiInternalMetric * spinConnectionMatrix second formDirection) =
        (Matrix.transpose (spinConnectionMatrix first formDirection) *
            minkowskiInternalMetric +
          minkowskiInternalMetric * spinConnectionMatrix first formDirection) +
        (Matrix.transpose (spinConnectionMatrix second formDirection) *
            minkowskiInternalMetric +
          minkowskiInternalMetric * spinConnectionMatrix second formDirection) := by
      abel
    _ = 0 := by rw [firstAt, secondAt, add_zero]

/-- The generated affine connection remains in the actual Lorentz-skew
connection domain. -/
theorem cartanAffineSpinConnection_lorentzSkew
    (jet : PointwiseLorentzianCoframeJet)
    (nondegenerate : Matrix.det jet.coframe ≠ 0)
    (contorsion : LorentzBivectorOneForm) :
    LorentzSkew (cartanAffineSpinConnection jet contorsion) := by
  apply lorentzSkew_add
  · exact jet.lorentzSpinConnection_lorentzSkew nondegenerate
  · exact lorentzSkewConnectionOfBivectorOneForm_lorentzSkew contorsion

/-- The lowered coordinates of the affine connection retain the generated
contorsion without a sign or index-order drift. -/
theorem loweredLorentzConnectionCoefficient_cartanAffineSpinConnection
    (jet : PointwiseLorentzianCoframeJet)
    (contorsion : LorentzBivectorOneForm)
    (formDirection : LorentzianIndex) (pair : Fin 6) :
    loweredLorentzConnectionCoefficient
        (cartanAffineSpinConnection jet contorsion) formDirection pair =
      loweredLorentzConnectionCoefficient jet.lorentzSpinConnection
          formDirection pair + contorsion formDirection pair := by
  rw [cartanAffineSpinConnection,
    loweredLorentzConnectionCoefficient_add,
    loweredLorentzConnectionCoefficient_ofBivectorOneForm]

/-- **KIN-4 frontier.**  The actual Cartan torsion of the affine full
connection is exactly the typed torsion generated by its contorsion. -/
theorem actualPointwiseCartanTorsionTwoForm_cartanAffineSpinConnection
    (jet : PointwiseLorentzianCoframeJet)
    (nondegenerate : Matrix.det jet.coframe ≠ 0)
    (contorsion : LorentzBivectorOneForm) :
    actualPointwiseCartanTorsionTwoForm jet
        (cartanAffineSpinConnection jet contorsion) =
      cartanTorsionOfContorsion jet.coframe contorsion := by
  rw [cartanAffineSpinConnection,
    actualPointwiseCartanTorsionTwoForm_add_increment,
    actualPointwiseCartanTorsionTwoForm_lorentzSpinConnection_eq_zero
      jet nondegenerate,
    zero_add]
  exact actualCartanTorsionIncrementTwoForm_eq_factored
    jet.coframe nondegenerate contorsion

/-- The canonical affine full connection generated from a coframe jet and a
target typed torsion.  The inverse response is computed, not supplied. -/
def cartanAffineSpinConnectionOfTorsion
    (jet : PointwiseLorentzianCoframeJet)
    (torsion : PointwiseCartanTorsionTwoForm) :
    PointwiseLorentzSpinConnection :=
  cartanAffineSpinConnection jet
    (contorsionOfCartanTorsion jet.coframe torsion)

/-- The no-choice torsion actualizer remains Lorentz skew on every
nondegenerate coframe fiber. -/
theorem cartanAffineSpinConnectionOfTorsion_lorentzSkew
    (jet : PointwiseLorentzianCoframeJet)
    (nondegenerate : Matrix.det jet.coframe ≠ 0)
    (torsion : PointwiseCartanTorsionTwoForm) :
    LorentzSkew (cartanAffineSpinConnectionOfTorsion jet torsion) := by
  exact cartanAffineSpinConnection_lorentzSkew jet nondegenerate _

/-- The generated affine connection realizes the requested typed torsion in
the repository's literal Cartan readout. -/
theorem actualPointwiseCartanTorsionTwoForm_cartanAffineSpinConnectionOfTorsion
    (jet : PointwiseLorentzianCoframeJet)
    (nondegenerate : Matrix.det jet.coframe ≠ 0)
    (torsion : PointwiseCartanTorsionTwoForm) :
    actualPointwiseCartanTorsionTwoForm jet
        (cartanAffineSpinConnectionOfTorsion jet torsion) = torsion := by
  rw [cartanAffineSpinConnectionOfTorsion,
    actualPointwiseCartanTorsionTwoForm_cartanAffineSpinConnection
      jet nondegenerate]
  exact contorsionOfCartanTorsion_rightInverse
    jet.coframe nondegenerate torsion

end

end
  SaturationMonoid.PhysicsCore.StageNineCartanAffineConnectionActualization
