import H0mework.Physics.Cauchy.CanonicalCauchyState
import H0mework.Physics.JointVariation.TemporalDevelopmentOperator
import H0mework.Physics.GaugeAction.P286GaugeConnectionVariationDensity
import Mathlib.Analysis.SpecialFunctions.Exponential

/-!
# P286-connection-generated scalar parallel transport

A temporal P286 connection coordinate acts on the scalar carrier through the
actual degree-four exterior Lie representation.  Exponentiating that
representation gives a canonical one-parameter scalar transport before any
equation residual is read.  Its tangent at the identity is therefore an
output of the representation path, rather than a caller-supplied scalar first
jet.

This module is deliberately independent of the fixed P506 specialization.  It
accepts only a primitive configuration and a spatial point, reads the temporal
connection and scalar zero-slice anchor there, and forms the representation
exponential.  It is a connection/representation transporter; source and
physical-action authority must be supplied by a downstream exact-lineage
specialization.  No residual, support coordinate, target relation, branch
selector, or equation receipt enters the construction.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineP286ConnectionGeneratedScalarParallelTransport

open StageNineCanonicalCauchyState
open StageNineDiracDualFormNativeCompleteJointActionTemporalDevelopmentOperator
open StageNineDynamicBreakingVacuum
open StageNineHolonomicField
open StageNineP286ActionCauchySplit
open StageNineP286GaugeConnectionVariation
open StageNineP286GaugeConnectionVariationDensity
open SU7MotherLieAlgebra

noncomputable section

set_option autoImplicit false

local instance p286ConnectionGeneratedScalarModuleFinite :
    Module.Finite ℝ P286LieBlockData :=
  FiniteDimensional.of_injective p286AmbientLinear
    p286AmbientLinear_injective

local instance p286ConnectionGeneratedScalarCoordinateIndexFintype :
    Fintype P286CoordinateIndex :=
  Fintype.ofFinite P286CoordinateIndex

local instance p286ConnectionGeneratedScalarCoordinateIsTopologicalAddGroup :
    IsTopologicalAddGroup P286CoordinateCarrier where
  toContinuousAdd := inferInstance
  toContinuousNeg := inferInstance

local instance p286ConnectionGeneratedScalarNormedAddCommGroup :
    NormedAddCommGroup ScalarCoordinateCarrier :=
  PiLp.normedAddCommGroup 2 (fun _ : ScalarBasisIndex => ℂ)

local instance p286ConnectionGeneratedScalarNormedSpace :
    NormedSpace ℝ ScalarCoordinateCarrier :=
  PiLp.normedSpace 2 ℝ (fun _ : ScalarBasisIndex => ℂ)

/-! ## Representation exponential -/

/-- The infinitesimal scalar transporter generated by one P286 connection
coordinate.  The sign is the parallel-transport orientation appearing in
`D₀ φ = ∂₀ φ + A₀ · φ`. -/
def p286ConnectionScalarParallelGenerator
    (connection : P286CoordinateCarrier) :
    ScalarCoordinateCarrier →L[ℝ] ScalarCoordinateCarrier :=
  -(scalarP286ActionBilinear.toContinuousBilinearMap connection)

/-- Canonical finite scalar transport generated by the actual P286 Lie
representation. -/
def p286ConnectionScalarParallelTransport
    (connection : P286CoordinateCarrier) (time : ℝ) :
    ScalarCoordinateCarrier →L[ℝ] ScalarCoordinateCarrier :=
  NormedSpace.exp
    (time • p286ConnectionScalarParallelGenerator connection)

@[simp] theorem p286ConnectionScalarParallelTransport_zero
    (connection : P286CoordinateCarrier) :
    p286ConnectionScalarParallelTransport connection 0 = 1 := by
  unfold p286ConnectionScalarParallelTransport
  have hzero :
      (0 : ℝ) • p286ConnectionScalarParallelGenerator connection = 0 := by
    ext scalar coordinate
    simp
  rw [hzero, NormedSpace.exp_zero]

/-- The representation exponential solves its own parallel-orbit
equation. -/
theorem p286ConnectionScalarParallelTransport_orbit_hasDerivAt
    (connection : P286CoordinateCarrier)
    (anchor : ScalarCoordinateCarrier) (time : ℝ) :
    NormedHasDerivAt
      (fun candidateTime =>
        p286ConnectionScalarParallelTransport connection candidateTime anchor)
      (p286ConnectionScalarParallelGenerator connection
        (p286ConnectionScalarParallelTransport connection time anchor))
      time := by
  have operatorDerivative :
      HasDerivAt
        (fun candidateTime : ℝ =>
          NormedSpace.exp
            (candidateTime •
              p286ConnectionScalarParallelGenerator connection))
        (p286ConnectionScalarParallelGenerator connection *
          NormedSpace.exp
            (time • p286ConnectionScalarParallelGenerator connection))
        time := by
    exact hasDerivAt_exp_smul_const'
      (p286ConnectionScalarParallelGenerator connection) time
  have evaluationDerivative :
      HasFDerivAt
        (fun operator :
            ScalarCoordinateCarrier →L[ℝ] ScalarCoordinateCarrier =>
          operator anchor)
        (ContinuousLinearMap.apply ℝ ScalarCoordinateCarrier anchor)
        (NormedSpace.exp
          (time • p286ConnectionScalarParallelGenerator connection)) :=
    (ContinuousLinearMap.apply ℝ ScalarCoordinateCarrier anchor).hasFDerivAt
  have orbitDerivative :=
    evaluationDerivative.comp_hasDerivAt time operatorDerivative
  simpa [NormedHasDerivAt, p286ConnectionScalarParallelTransport,
    Function.comp_def, ContinuousLinearMap.apply_apply,
    mul_apply_eq_comp] using orbitDerivative

/-! ## Current-indexed parallel orbit -/

/-- Temporal P286 connection coordinate at one zero-slice occurrence. -/
def p286CurrentTemporalConnectionCoordinate
    (current : StageNineHolonomicConfiguration)
    (space : StageNineSpatialPoint) : P286CoordinateCarrier :=
  p286CoordinateEquiv
    (current.gaugeConnection (canonicalCauchySlicePoint 0 space)
      canonicalLorentzianTimeDirection)

/-- Scalar zero-slice anchor at the same occurrence. -/
def p286CurrentScalarZeroSliceAnchor
    (current : StageNineHolonomicConfiguration)
    (space : StageNineSpatialPoint) : ScalarCoordinateCarrier :=
  current.scalar (canonicalCauchySlicePoint 0 space)

/-- The scalar orbit canonically generated from one current's own temporal
P286 connection and zero-slice scalar anchor. -/
def p286ConnectionGeneratedScalarParallelOrbit
    (current : StageNineHolonomicConfiguration)
    (space : StageNineSpatialPoint) (time : ℝ) :
    ScalarCoordinateCarrier :=
  p286ConnectionScalarParallelTransport
    (p286CurrentTemporalConnectionCoordinate current space) time
    (p286CurrentScalarZeroSliceAnchor current space)

@[simp] theorem p286ConnectionGeneratedScalarParallelOrbit_zero
    (current : StageNineHolonomicConfiguration)
    (space : StageNineSpatialPoint) :
    p286ConnectionGeneratedScalarParallelOrbit current space 0 =
      p286CurrentScalarZeroSliceAnchor current space := by
  simp [p286ConnectionGeneratedScalarParallelOrbit]

/-- The representation first jet is read from the parallel path's
infinitesimal generator. -/
def p286ConnectionGeneratedScalarParallelVelocity
    (current : StageNineHolonomicConfiguration)
    (space : StageNineSpatialPoint) : ScalarCoordinateCarrier :=
  p286ConnectionScalarParallelGenerator
    (p286CurrentTemporalConnectionCoordinate current space)
    (p286CurrentScalarZeroSliceAnchor current space)

theorem p286ConnectionGeneratedScalarParallelOrbit_hasDerivAt_zero
    (current : StageNineHolonomicConfiguration)
    (space : StageNineSpatialPoint) :
    NormedHasDerivAt
      (p286ConnectionGeneratedScalarParallelOrbit current space)
      (p286ConnectionGeneratedScalarParallelVelocity current space) 0 := by
  unfold p286ConnectionGeneratedScalarParallelOrbit
    p286ConnectionGeneratedScalarParallelVelocity
  simpa only [p286ConnectionScalarParallelTransport_zero,
    one_apply_eq_self] using
    (p286ConnectionScalarParallelTransport_orbit_hasDerivAt
      (p286CurrentTemporalConnectionCoordinate current space)
      (p286CurrentScalarZeroSliceAnchor current space) 0)

/-- Computed readout of the path-generated first jet.  This equation is not
the producer mouth: the exponential orbit above is. -/
theorem p286ConnectionGeneratedScalarParallelVelocity_eq_lieAction
    (current : StageNineHolonomicConfiguration)
    (space : StageNineSpatialPoint) :
    p286ConnectionGeneratedScalarParallelVelocity current space =
      -scalarP286ActionBilinear
        (p286CurrentTemporalConnectionCoordinate current space)
        (p286CurrentScalarZeroSliceAnchor current space) := by
  rfl

end

end
  SaturationMonoid.PhysicsCore.StageNineP286ConnectionGeneratedScalarParallelTransport
