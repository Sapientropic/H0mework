import H0mework.Physics.GaugeAction.P286GaugeConnectionVariation
import H0mework.Physics.Lorentz.TopologicalLorentzThreeFormDuality

/-!
# Topological P286 gauge one-form--three-form duality

This module constructs the canonical finite-coordinate pairing between a
P286 connection one-form and a P286-valued contravariant three-form:

`W13_P286(a,H) = sum_mu (+,-,+,-)_mu <a_mu,H_(missing mu)>`.

The Lie-fiber pairing is the faithful positive P286 trace pairing and the
spacetime sign is fixed by `epsilon_0123 = +1`.  The induced map from
three-forms to one-form duals is a linear equivalence.  Consequently every
action-generated P286 one-form covector has one canonical three-form
representative; there is no basis witness, branch selector, current receipt,
source field, action equation, or normalization parameter in the inverse.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineTopologicalP286GaugeThreeFormDuality

open ProofFreeRicherAnholonomicSource
open StageNineEnrichedProofFreeSource
open StageNineHolonomicField
open StageNineP286GaugeAuxiliaryVariation
open StageNineP286GaugeConnectionVariation
open StageNineTopologicalLorentzThreeFormDuality
open SU7MotherGaugeTheory
open SU7MotherLieAlgebra

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 600000

local instance p286ModuleFinite : Module.Finite ℝ P286LieBlockData :=
  FiniteDimensional.of_injective p286AmbientLinear
    p286AmbientLinear_injective

local instance p286CoordinateIndexFintype : Fintype P286CoordinateIndex :=
  Fintype.ofFinite P286CoordinateIndex

local instance p286CoordinateIsTopologicalAddGroup :
    IsTopologicalAddGroup P286CoordinateCarrier where
  toContinuousAdd := inferInstance
  toContinuousNeg := inferInstance

/-- Contravariant spacetime three-form with one faithful P286 coordinate in
each oriented triple `(012,013,023,123)`. -/
abbrev P286GaugeThreeForm := Fin 4 → P286CoordinateCarrier

/-- Metric-free coefficient of a P286 one-form wedged with a P286 three-form. -/
def p286GaugeOneFormThreeFormWedgeCoefficient
    (oneForm : P286GaugeOneForm) (threeForm : P286GaugeThreeForm) : ℝ :=
  ∑ direction : LorentzianIndex,
    oneWedgeThreeSign direction *
      p286CoordinateLiePairing (oneForm direction)
        (threeForm (missingTripleOfOneForm direction))

theorem p286GaugeOneFormThreeFormWedgeCoefficient_add_left
    (first second : P286GaugeOneForm) (threeForm : P286GaugeThreeForm) :
    p286GaugeOneFormThreeFormWedgeCoefficient (first + second) threeForm =
      p286GaugeOneFormThreeFormWedgeCoefficient first threeForm +
        p286GaugeOneFormThreeFormWedgeCoefficient second threeForm := by
  unfold p286GaugeOneFormThreeFormWedgeCoefficient
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro direction _
  rw [Pi.add_apply, p286CoordinateLiePairing_add_left]
  ring

theorem p286GaugeOneFormThreeFormWedgeCoefficient_smul_left
    (parameter : ℝ) (oneForm : P286GaugeOneForm)
    (threeForm : P286GaugeThreeForm) :
    p286GaugeOneFormThreeFormWedgeCoefficient (parameter • oneForm)
        threeForm =
      parameter *
        p286GaugeOneFormThreeFormWedgeCoefficient oneForm threeForm := by
  unfold p286GaugeOneFormThreeFormWedgeCoefficient
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro direction _
  rw [Pi.smul_apply, p286CoordinateLiePairing_smul_left]
  ring

theorem p286GaugeOneFormThreeFormWedgeCoefficient_add_right
    (oneForm : P286GaugeOneForm) (first second : P286GaugeThreeForm) :
    p286GaugeOneFormThreeFormWedgeCoefficient oneForm (first + second) =
      p286GaugeOneFormThreeFormWedgeCoefficient oneForm first +
        p286GaugeOneFormThreeFormWedgeCoefficient oneForm second := by
  unfold p286GaugeOneFormThreeFormWedgeCoefficient
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro direction _
  rw [Pi.add_apply, p286CoordinateLiePairing_add_right]
  ring

theorem p286GaugeOneFormThreeFormWedgeCoefficient_smul_right
    (parameter : ℝ) (oneForm : P286GaugeOneForm)
    (threeForm : P286GaugeThreeForm) :
    p286GaugeOneFormThreeFormWedgeCoefficient oneForm
        (parameter • threeForm) =
      parameter *
        p286GaugeOneFormThreeFormWedgeCoefficient oneForm threeForm := by
  unfold p286GaugeOneFormThreeFormWedgeCoefficient
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro direction _
  rw [Pi.smul_apply, p286CoordinateLiePairing_smul_right]
  ring

/-- Linear dual of connection one-forms generated by one P286 three-form. -/
def p286GaugeThreeFormWedgeLinearDual
    (threeForm : P286GaugeThreeForm) : Module.Dual ℝ P286GaugeOneForm where
  toFun := fun oneForm =>
    p286GaugeOneFormThreeFormWedgeCoefficient oneForm threeForm
  map_add' := fun first second =>
    p286GaugeOneFormThreeFormWedgeCoefficient_add_left first second threeForm
  map_smul' := by
    intro parameter oneForm
    simpa only [RingHom.id_apply, smul_eq_mul] using
      p286GaugeOneFormThreeFormWedgeCoefficient_smul_left parameter oneForm
        threeForm

@[simp] theorem p286GaugeThreeFormWedgeLinearDual_apply
    (threeForm : P286GaugeThreeForm) (oneForm : P286GaugeOneForm) :
    p286GaugeThreeFormWedgeLinearDual threeForm oneForm =
      p286GaugeOneFormThreeFormWedgeCoefficient oneForm threeForm :=
  rfl

/-- Canonical one-form supported in one spacetime direction with one supplied
P286 fiber coordinate. -/
def singleP286GaugeOneForm
    (direction : LorentzianIndex) (coordinate : P286CoordinateCarrier) :
    P286GaugeOneForm :=
  Pi.single direction coordinate

/-- Evaluation on a single spacetime direction reads the complementary
three-form coordinate through the faithful P286 pairing. -/
@[simp] theorem p286GaugeThreeFormWedgeLinearDual_single_apply
    (threeForm : P286GaugeThreeForm) (direction : LorentzianIndex)
    (coordinate : P286CoordinateCarrier) :
    p286GaugeThreeFormWedgeLinearDual threeForm
        (singleP286GaugeOneForm direction coordinate) =
      oneWedgeThreeSign direction *
        p286CoordinateLiePairing coordinate
          (threeForm (missingTripleOfOneForm direction)) := by
  classical
  fin_cases direction <;>
    simp [p286GaugeThreeFormWedgeLinearDual,
      p286GaugeOneFormThreeFormWedgeCoefficient,
      singleP286GaugeOneForm, oneWedgeThreeSign, missingTripleOfOneForm,
      Fin.sum_univ_four]

/-- The W13 dual has a faithful zero fiber. -/
theorem p286GaugeThreeFormWedgeLinearDual_eq_zero_iff
    (threeForm : P286GaugeThreeForm) :
    p286GaugeThreeFormWedgeLinearDual threeForm = 0 ↔ threeForm = 0 := by
  constructor
  · intro dualZero
    funext triple
    let direction : LorentzianIndex := missingTripleOfOneForm triple
    have evaluated := congrArg
      (fun dual : Module.Dual ℝ P286GaugeOneForm =>
        dual (singleP286GaugeOneForm direction (threeForm triple))) dualZero
    change
      p286GaugeThreeFormWedgeLinearDual threeForm
          (singleP286GaugeOneForm direction (threeForm triple)) = 0
      at evaluated
    rw [p286GaugeThreeFormWedgeLinearDual_single_apply] at evaluated
    have pairedZero :
        p286CoordinateLiePairing (threeForm triple) (threeForm triple) = 0 := by
      have signedPairZero :
          oneWedgeThreeSign direction *
              p286CoordinateLiePairing (threeForm triple) (threeForm triple) =
            0 := by
        rw [show missingTripleOfOneForm direction = triple by
          simp [direction]] at evaluated
        exact evaluated
      exact (mul_eq_zero.mp signedPairZero).resolve_left
        (oneWedgeThreeSign_ne_zero direction)
    exact (p286CoordinateLiePairing_self_eq_zero_iff _).mp pairedZero
  · rintro rfl
    ext oneForm
    simp [p286GaugeThreeFormWedgeLinearDual,
      p286GaugeOneFormThreeFormWedgeCoefficient]

/-- Linear packaging of the full three-form-to-one-form-dual map. -/
def p286GaugeThreeFormWedgeDualOperator :
    P286GaugeThreeForm →ₗ[ℝ] Module.Dual ℝ P286GaugeOneForm where
  toFun := p286GaugeThreeFormWedgeLinearDual
  map_add' := by
    intro first second
    apply LinearMap.ext
    intro oneForm
    exact p286GaugeOneFormThreeFormWedgeCoefficient_add_right oneForm first
      second
  map_smul' := by
    intro parameter threeForm
    apply LinearMap.ext
    intro oneForm
    change
      p286GaugeOneFormThreeFormWedgeCoefficient oneForm
          (parameter • threeForm) =
        parameter *
          p286GaugeOneFormThreeFormWedgeCoefficient oneForm threeForm
    exact p286GaugeOneFormThreeFormWedgeCoefficient_smul_right parameter
      oneForm threeForm

@[simp] theorem p286GaugeThreeFormWedgeDualOperator_apply
    (threeForm : P286GaugeThreeForm) :
    p286GaugeThreeFormWedgeDualOperator threeForm =
      p286GaugeThreeFormWedgeLinearDual threeForm :=
  rfl

theorem p286GaugeThreeFormWedgeDualOperator_injective :
    Function.Injective p286GaugeThreeFormWedgeDualOperator := by
  intro first second equality
  have differenceZero :
      p286GaugeThreeFormWedgeDualOperator (first - second) = 0 := by
    rw [map_sub, equality, sub_self]
  have threeFormDifferenceZero : first - second = 0 :=
    (p286GaugeThreeFormWedgeLinearDual_eq_zero_iff (first - second)).mp
      differenceZero
  exact sub_eq_zero.mp threeFormDifferenceZero

theorem p286GaugeThreeFormWedgeDualOperator_surjective :
    Function.Surjective p286GaugeThreeFormWedgeDualOperator := by
  have dimensionEquality :
      Module.finrank ℝ P286GaugeThreeForm =
        Module.finrank ℝ (Module.Dual ℝ P286GaugeOneForm) := by
    exact Subspace.dual_finrank_eq.symm
  apply
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank
      dimensionEquality).mp
  exact p286GaugeThreeFormWedgeDualOperator_injective

/-- Canonical branch-free identification of P286 three-forms with all
connection one-form covectors. -/
def p286GaugeThreeFormWedgeEquiv :
    P286GaugeThreeForm ≃ₗ[ℝ] Module.Dual ℝ P286GaugeOneForm :=
  LinearEquiv.ofBijective p286GaugeThreeFormWedgeDualOperator
    ⟨p286GaugeThreeFormWedgeDualOperator_injective,
      p286GaugeThreeFormWedgeDualOperator_surjective⟩

@[simp] theorem p286GaugeThreeFormWedgeEquiv_apply
    (threeForm : P286GaugeThreeForm) :
    p286GaugeThreeFormWedgeEquiv threeForm =
      p286GaugeThreeFormWedgeLinearDual threeForm :=
  rfl

/-- Unique three-form represented by an arbitrary action covector. -/
def p286GaugeThreeFormOfDual
    (dual : Module.Dual ℝ P286GaugeOneForm) : P286GaugeThreeForm :=
  p286GaugeThreeFormWedgeEquiv.symm dual

theorem p286GaugeThreeFormOfDual_evaluation
    (dual : Module.Dual ℝ P286GaugeOneForm)
    (oneForm : P286GaugeOneForm) :
    p286GaugeOneFormThreeFormWedgeCoefficient oneForm
        (p286GaugeThreeFormOfDual dual) =
      dual oneForm := by
  change
    p286GaugeThreeFormWedgeEquiv
        (p286GaugeThreeFormWedgeEquiv.symm dual) oneForm =
      dual oneForm
  rw [p286GaugeThreeFormWedgeEquiv.apply_symm_apply]

theorem p286GaugeThreeFormOfDual_unique
    (dual : Module.Dual ℝ P286GaugeOneForm)
    (candidate : P286GaugeThreeForm)
    (represents : ∀ oneForm,
      p286GaugeOneFormThreeFormWedgeCoefficient oneForm candidate =
        dual oneForm) :
    candidate = p286GaugeThreeFormOfDual dual := by
  apply p286GaugeThreeFormWedgeDualOperator_injective
  apply LinearMap.ext
  intro oneForm
  rw [p286GaugeThreeFormWedgeDualOperator_apply,
    p286GaugeThreeFormWedgeDualOperator_apply,
    p286GaugeThreeFormWedgeLinearDual_apply,
    p286GaugeThreeFormWedgeLinearDual_apply]
  rw [represents, p286GaugeThreeFormOfDual_evaluation]

end

end
  SaturationMonoid.PhysicsCore.StageNineTopologicalP286GaugeThreeFormDuality
