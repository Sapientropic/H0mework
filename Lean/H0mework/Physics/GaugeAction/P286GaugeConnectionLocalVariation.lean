open StageNineP286GaugeAuxiliaryVariation
open StageNineP286GaugeConnectionActionVariation
open StageNineP286GaugeConnectionVariation
open StageNineTopologicalFourFormPairing
open SU7MotherLieAlgebra
open SU7ExteriorMatterRepresentation
open SU7ExteriorMatterRestriction

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 600000

local instance p286ModuleFinite : Module.Finite ℝ P286LieBlockData :=
  FiniteDimensional.of_injective p286AmbientLinear
    p286AmbientLinear_injective

local instance p286CoordinateIndexFintype : Fintype P286CoordinateIndex :=
  Fintype.ofFinite P286CoordinateIndex

local instance p286CoordinateIsTopologicalAddGroup :
    IsTopologicalAddGroup P286CoordinateCarrier where
  toContinuousAdd := inferInstance
  toContinuousNeg := inferInstance

/-! ## Faithful coordinate-to-actual curvature seam -/

/-- Return one P286 curvature-coordinate two-form to the actual typed Lie
carrier.  This is a faithful representation seam, not a new field slot. -/
def formNativeP286GaugeCurvatureCoordinateToActual
    (curvature : P286GaugeTwoForm) : FormNativeP286GaugeTwoForm :=
  fun pair => p286CoordinateEquiv.symm (curvature pair)

@[simp] theorem formNativeP286GaugeCurvatureCoordinateToActual_zero :
    formNativeP286GaugeCurvatureCoordinateToActual 0 = 0 := by
  funext pair
  change p286CoordinateEquiv.symm 0 = 0
  exact p286CoordinateEquiv.symm.map_zero

theorem formNativeP286GaugeCurvatureCoordinateToActual_add
    (first second : P286GaugeTwoForm) :
    formNativeP286GaugeCurvatureCoordinateToActual (first + second) =
      formNativeP286GaugeCurvatureCoordinateToActual first +
        formNativeP286GaugeCurvatureCoordinateToActual second := by
  funext pair
  change p286CoordinateEquiv.symm (first pair + second pair) =
    p286CoordinateEquiv.symm (first pair) +
      p286CoordinateEquiv.symm (second pair)
  exact p286CoordinateEquiv.symm.map_add _ _

theorem formNativeP286GaugeCurvatureCoordinateToActual_smul
    (parameter : ℝ) (curvature : P286GaugeTwoForm) :
    formNativeP286GaugeCurvatureCoordinateToActual (parameter • curvature) =
      parameter •
        formNativeP286GaugeCurvatureCoordinateToActual curvature := by
  funext pair
  change p286CoordinateEquiv.symm (parameter • curvature pair) =
    parameter • p286CoordinateEquiv.symm (curvature pair)
  exact p286CoordinateEquiv.symm.map_smul _ _

@[simp] theorem formNativeP286GaugeCurvatureCoordinateToActual_readout
    (field : StageNineContinuumPointField) :
    formNativeP286GaugeCurvatureCoordinateToActual
        (p286CurvatureCoordinate field) =
      field.gaugeCurvature := by
  funext pair
  simp [formNativeP286GaugeCurvatureCoordinateToActual,
    p286CurvatureCoordinate]

/-! ## Metric-free gauge BF polynomial -/

/-- First gauge-BF coefficient generated by a curvature-coordinate tangent.
The primitive auxiliary field is read from the same point field. -/
def formNativeP286GaugeConnectionBFFirstVariationDensity
    (field : StageNineContinuumPointField)
    (curvatureVariation : P286GaugeTwoForm) : ℝ :=
  formNativeP286GaugeWedgeCoefficient field.gaugeAuxiliary
    (formNativeP286GaugeCurvatureCoordinateToActual curvatureVariation)

/-- Coordinate presentation of the same active topological BF coefficient.
This seam is used only for finite-dimensional analysis; it does not replace
the actual Lie-valued action field. -/
theorem formNativeP286GaugeConnectionBFFirstVariationDensity_eq_coordinate
    (field : StageNineContinuumPointField)
    (curvatureVariation : P286GaugeTwoForm) :
    formNativeP286GaugeConnectionBFFirstVariationDensity field
        curvatureVariation =
      generatedTwoFormWedgeCoefficient p286CoordinateLiePairing
        (p286AuxiliaryCoordinate field) curvatureVariation := by
  unfold formNativeP286GaugeConnectionBFFirstVariationDensity
    formNativeP286GaugeWedgeCoefficient generatedTwoFormWedgeCoefficient
    formNativeP286LiePairing formNativeP286GaugeCurvatureCoordinateToActual
    p286CoordinateLiePairing p286LiePairing p286AuxiliaryCoordinate
  simp

/-- The active gauge BF/constitutive block along a generated curvature two-jet.
The constitutive term is connection-independent, so only `B wedge F` varies. -/
theorem generatedFormNativeGaugeDensityAtBoundary_connectionJets_quadratic
    (boundary : EmpiricalReferenceScaleCouplings)
    (field : StageNineContinuumPointField)
    (linearCurvature quadraticCurvature : P286GaugeTwoForm)
    (scalarDerivative : LorentzianIndex → ScalarCoordinateCarrier)
    (matterDerivative : LorentzianIndex → DiracExteriorMatterCarrier)
    (parameter : ℝ) :
    generatedFormNativeGaugeDensityAtBoundary boundary
        (withP286GaugeConnectionJets field
          (p286CurvatureCoordinate field + parameter • linearCurvature +
            parameter ^ 2 • quadraticCurvature)
          scalarDerivative matterDerivative) =
      generatedFormNativeGaugeDensityAtBoundary boundary field +
        parameter *
          formNativeP286GaugeConnectionBFFirstVariationDensity field
            linearCurvature +
        parameter ^ 2 *
          formNativeP286GaugeConnectionBFFirstVariationDensity field
            quadraticCurvature := by
  have curvatureReadout :
      (withP286GaugeConnectionJets field
          (p286CurvatureCoordinate field + parameter • linearCurvature +
            parameter ^ 2 • quadraticCurvature)
          scalarDerivative matterDerivative).gaugeCurvature =
        field.gaugeCurvature +
          parameter •
            formNativeP286GaugeCurvatureCoordinateToActual linearCurvature +
          parameter ^ 2 •
            formNativeP286GaugeCurvatureCoordinateToActual
              quadraticCurvature := by
    funext pair
    simp [withP286GaugeConnectionJets, p286CurvatureCoordinate,
      formNativeP286GaugeCurvatureCoordinateToActual]
  rw [generatedFormNativeGaugeDensityAtBoundary_eq_p286,
    generatedFormNativeGaugeDensityAtBoundary_eq_p286]
  rw [curvatureReadout]
  simp only [withP286GaugeConnectionJets]
  rw [formNativeP286GaugeWedgeCoefficient_add_right,
    formNativeP286GaugeWedgeCoefficient_add_right,
    formNativeP286GaugeWedgeCoefficient_smul_right]
  rw [formNativeP286GaugeWedgeCoefficient_smul_right]
  unfold formNativeP286GaugeConnectionBFFirstVariationDensity
  ring

/-! ## Active matter polynomial -/

/-- The scalar and Dirac terms of the form-native mother density retain their
live volume factor along the same primitive P286 connection path. -/
theorem generatedFormNativeMatterDensity_connectionJets_quadratic
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (curvature : P286GaugeTwoForm)
    (scalarVariation : LorentzianIndex → ScalarCoordinateCarrier)
    (matterVariation : LorentzianIndex → DiracExteriorMatterCarrier)
    (parameter : ℝ) :
    generatedFormNativeMatterDensity source chart point
        (withP286GaugeConnectionJets field curvature
          (field.scalarCovariantDerivative + parameter • scalarVariation)
          (field.matterCovariantDerivative + parameter • matterVariation)) =
      generatedFormNativeMatterDensity source chart point field +
        parameter *
          (generatedVolumeDensity field *
            (scalarGaugeConnectionKineticFirstVariationDensity
                source chart point field scalarVariation +
              matterGaugeConnectionFirstVariationDensity
                source chart point field matterVariation)) +
        parameter ^ 2 *
          (generatedVolumeDensity field *
            scalarGaugeConnectionKineticSecondVariationDensity
              source chart point field scalarVariation) := by
  unfold generatedFormNativeMatterDensity
  rw [generatedScalarKineticDensity_withP286GaugeConnectionJets_quadratic,
    generatedContinuumMatterDensity_withP286GaugeConnectionJets_affine]
  simp only [withP286GaugeConnectionJets, generatedVolumeDensity]
  ring

/-! ## Complete local coefficient -/

/-- Complete first coefficient generated by one actual P286 connection path.
The topological BF and component matter terms retain their distinct density
weights. -/
def formNativeP286GaugeConnectionFirstVariationDensity
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (curvatureVariation : P286GaugeTwoForm)
    (scalarVariation : LorentzianIndex → ScalarCoordinateCarrier)
    (matterVariation : LorentzianIndex → DiracExteriorMatterCarrier) : ℝ :=
  formNativeP286GaugeConnectionBFFirstVariationDensity field
      curvatureVariation +
    generatedVolumeDensity field *
      (scalarGaugeConnectionKineticFirstVariationDensity
          source chart point field scalarVariation +
        matterGaugeConnectionFirstVariationDensity
          source chart point field matterVariation)

/-- Complete second coefficient.  It retains the non-Abelian curvature
channel and the scalar quadratic channel; the Dirac leg is affine. -/
def formNativeP286GaugeConnectionSecondVariationDensity
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (curvatureVariation : P286GaugeTwoForm)
    (scalarVariation : LorentzianIndex → ScalarCoordinateCarrier) : ℝ :=
  formNativeP286GaugeConnectionBFFirstVariationDensity field
      curvatureVariation +
    generatedVolumeDensity field *
      scalarGaugeConnectionKineticSecondVariationDensity
        source chart point field scalarVariation

/-- Exact local polynomial for the authoritative form-native mother density
at an explicit coupling boundary. -/
theorem generatedFormNativeUnifiedLocalDensity_p286ConnectionJets_quadratic
    (source : SmoothUnifiedSource)
    (boundary : EmpiricalReferenceScaleCouplings)
    (chart : StageNineChart) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (linearCurvature quadraticCurvature : P286GaugeTwoForm)
    (scalarVariation : LorentzianIndex → ScalarCoordinateCarrier)
    (matterVariation : LorentzianIndex → DiracExteriorMatterCarrier)
    (parameter : ℝ) :
    generatedFormNativeUnifiedLocalDensityAtBoundary source boundary chart point
        (withP286GaugeConnectionJets field
          (p286CurvatureCoordinate field + parameter • linearCurvature +
            parameter ^ 2 • quadraticCurvature)
          (field.scalarCovariantDerivative + parameter • scalarVariation)
          (field.matterCovariantDerivative + parameter • matterVariation)) =
      generatedFormNativeUnifiedLocalDensityAtBoundary source boundary chart
          point field +
        parameter *
          formNativeP286GaugeConnectionFirstVariationDensity source chart point
            field linearCurvature scalarVariation matterVariation +
        parameter ^ 2 *
          formNativeP286GaugeConnectionSecondVariationDensity source chart point
            field quadraticCurvature scalarVariation := by
  unfold generatedFormNativeUnifiedLocalDensityAtBoundary
  have gaugeExpansion :=
    generatedFormNativeGaugeDensityAtBoundary_connectionJets_quadratic
      boundary field linearCurvature quadraticCurvature
      (field.scalarCovariantDerivative + parameter • scalarVariation)
      (field.matterCovariantDerivative + parameter • matterVariation)
      parameter
  have matterExpansion :=
    generatedFormNativeMatterDensity_connectionJets_quadratic source chart point
      field
      (p286CurvatureCoordinate field + parameter • linearCurvature +
        parameter ^ 2 • quadraticCurvature)
      scalarVariation matterVariation parameter
  have gravityBFReadout :
      generatedFormNativeGravityBFDensity
          (withP286GaugeConnectionJets field
            (p286CurvatureCoordinate field + parameter • linearCurvature +
              parameter ^ 2 • quadraticCurvature)
            (field.scalarCovariantDerivative + parameter • scalarVariation)
            (field.matterCovariantDerivative + parameter • matterVariation)) =
        generatedFormNativeGravityBFDensity field :=
    rfl
  have constraintReadout :
      generatedFormNativeGravityConstraintDensity
          (withP286GaugeConnectionJets field
            (p286CurvatureCoordinate field + parameter • linearCurvature +
              parameter ^ 2 • quadraticCurvature)
            (field.scalarCovariantDerivative + parameter • scalarVariation)
            (field.matterCovariantDerivative + parameter • matterVariation)) =
        generatedFormNativeGravityConstraintDensity field :=
    rfl
  rw [gravityBFReadout, constraintReadout, gaugeExpansion, matterExpansion]
  unfold formNativeP286GaugeConnectionFirstVariationDensity
    formNativeP286GaugeConnectionSecondVariationDensity
  ring

/-! ## Actual primitive holonomic path -/

def holonomicFormNativeP286GaugeConnectionFirstVariationDensity
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → P286GaugeOneForm)
    (point : BasePoint) : ℝ :=
  formNativeP286GaugeConnectionFirstVariationDensity source chart point
    (toContinuumPointField configuration point)
    (p286GaugeConnectionLinearCurvatureVariation configuration variation point)
    (holonomicScalarGaugeConnectionVariation configuration variation point)
    (holonomicMatterGaugeConnectionVariation configuration variation point)

def holonomicFormNativeP286GaugeConnectionSecondVariationDensity
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → P286GaugeOneForm)
    (point : BasePoint) : ℝ :=
  formNativeP286GaugeConnectionSecondVariationDensity source chart point
    (toContinuumPointField configuration point)
    (p286GaugeConnectionQuadraticCurvatureVariation variation point)
    (holonomicScalarGaugeConnectionVariation configuration variation point)

/-- The first production checkpoint: one primitive connection occurrence
generates the complete active form-native local polynomial. -/
theorem holonomicFormNativeUnifiedLocalDensity_p286Connection_quadratic
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (variation : CompactlySupportedSmoothVariation P286GaugeOneForm)
    (parameter : ℝ) (point : BasePoint) :
    sourceGeneratedFormNativeUnifiedLocalDensity source chart point
        (toContinuumPointField
          (varyP286GaugeConnectionCoordinate configuration variation parameter)
          point) =
      sourceGeneratedFormNativeUnifiedLocalDensity source chart point
          (toContinuumPointField configuration point) +
        parameter *
          holonomicFormNativeP286GaugeConnectionFirstVariationDensity source
            chart configuration variation point +
        parameter ^ 2 *
          holonomicFormNativeP286GaugeConnectionSecondVariationDensity source
            chart configuration variation point := by
  rw [toContinuumPointField_varyP286GaugeConnectionCoordinate configuration
    smooth variation parameter point]
  exact
    generatedFormNativeUnifiedLocalDensity_p286ConnectionJets_quadratic
      source (sourceGeneratedUnifiedCouplings source) chart point
      (toContinuumPointField configuration point)
      (p286GaugeConnectionLinearCurvatureVariation configuration variation point)
      (p286GaugeConnectionQuadraticCurvatureVariation variation point)
      (holonomicScalarGaugeConnectionVariation configuration variation point)
      (holonomicMatterGaugeConnectionVariation configuration variation point)
      parameter

end

end
