noncomputable section

local instance p286ModuleFinite : Module.Finite ℝ P286LieBlockData :=
  FiniteDimensional.of_injective p286AmbientLinear
    p286AmbientLinear_injective

local instance p286CoordinateIndexFintype : Fintype P286CoordinateIndex :=
  Fintype.ofFinite P286CoordinateIndex

local instance p286CoordinateIsTopologicalAddGroup :
    IsTopologicalAddGroup P286CoordinateCarrier where
  toContinuousAdd := inferInstance
  toContinuousNeg := inferInstance

/-- Readout helper for the three jet slots generated by one primitive P286
connection variation.  It is never accepted by the holonomic action mouth. -/
def withP286GaugeConnectionJets
    (field : StageNineContinuumPointField)
    (curvature : P286GaugeTwoForm)
    (scalarDerivative : LorentzianIndex → ScalarCoordinateCarrier)
    (matterDerivative : LorentzianIndex → DiracExteriorMatterCarrier) :
    StageNineContinuumPointField :=
  { field with
    gaugeCurvature := fun pair => p286CoordinateEquiv.symm (curvature pair)
    scalarCovariantDerivative := scalarDerivative
    matterCovariantDerivative := matterDerivative }

@[simp] theorem p286CurvatureCoordinate_withP286GaugeConnectionJets
    (field : StageNineContinuumPointField)
    (curvature : P286GaugeTwoForm)
    (scalarDerivative : LorentzianIndex → ScalarCoordinateCarrier)
    (matterDerivative : LorentzianIndex → DiracExteriorMatterCarrier) :
    p286CurvatureCoordinate
        (withP286GaugeConnectionJets field curvature scalarDerivative
          matterDerivative) = curvature := by
  funext pair
  exact p286CoordinateEquiv.apply_symm_apply (curvature pair)

@[simp] theorem p286AuxiliaryCoordinate_withP286GaugeConnectionJets
    (field : StageNineContinuumPointField)
    (curvature : P286GaugeTwoForm)
    (scalarDerivative : LorentzianIndex → ScalarCoordinateCarrier)
    (matterDerivative : LorentzianIndex → DiracExteriorMatterCarrier) :
    p286AuxiliaryCoordinate
        (withP286GaugeConnectionJets field curvature scalarDerivative
          matterDerivative) = p286AuxiliaryCoordinate field := by
  rfl

@[simp] theorem withP286GaugeConnectionJets_coframe
    (field : StageNineContinuumPointField)
    (curvature : P286GaugeTwoForm)
    (scalarDerivative : LorentzianIndex → ScalarCoordinateCarrier)
    (matterDerivative : LorentzianIndex → DiracExteriorMatterCarrier) :
    (withP286GaugeConnectionJets field curvature scalarDerivative
      matterDerivative).coframe = field.coframe := by
  rfl

@[simp] theorem withP286GaugeConnectionJets_volume
    (field : StageNineContinuumPointField)
    (curvature : P286GaugeTwoForm)
    (scalarDerivative : LorentzianIndex → ScalarCoordinateCarrier)
    (matterDerivative : LorentzianIndex → DiracExteriorMatterCarrier) :
    generatedVolumeDensity
        (withP286GaugeConnectionJets field curvature scalarDerivative
          matterDerivative) = generatedVolumeDensity field := by
  rfl

def variedP286CurvatureCoordinate
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → P286GaugeOneForm) (parameter : ℝ)
    (point : BasePoint) : P286GaugeTwoForm :=
  holonomicP286GaugeCurvatureCoordinate configuration point +
    parameter •
      p286GaugeConnectionLinearCurvatureVariation configuration variation
        point +
    parameter ^ 2 •
      p286GaugeConnectionQuadraticCurvatureVariation variation point

def variedP286ScalarCovariantDerivative
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → P286GaugeOneForm) (parameter : ℝ)
    (point : BasePoint) : LorentzianIndex → ScalarCoordinateCarrier :=
  holonomicScalarCovariantDerivative configuration point +
    parameter •
      holonomicScalarGaugeConnectionVariation configuration variation point

def variedP286MatterCovariantDerivative
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → P286GaugeOneForm) (parameter : ℝ)
    (point : BasePoint) : LorentzianIndex → DiracExteriorMatterCarrier :=
  holonomicMatterCovariantDerivative configuration point +
    parameter •
      holonomicMatterGaugeConnectionVariation configuration variation point

/-- The helper readout is definitionally downstream of the primitive
configuration variation; it does not provide independent jet coordinates. -/
theorem toContinuumPointField_varyP286GaugeConnectionCoordinate
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (variation : CompactlySupportedSmoothVariation P286GaugeOneForm)
    (parameter : ℝ) (point : BasePoint) :
    toContinuumPointField
        (varyP286GaugeConnectionCoordinate configuration variation parameter)
        point =
      withP286GaugeConnectionJets
        (toContinuumPointField configuration point)
        (variedP286CurvatureCoordinate configuration variation parameter point)
        (variedP286ScalarCovariantDerivative configuration variation parameter
          point)
        (variedP286MatterCovariantDerivative configuration variation parameter
          point) := by
  apply StageNineContinuumPointField.ext
  all_goals try rfl
  · funext pair
    apply p286CoordinateEquiv.injective
    simp only [toContinuumPointField, withP286GaugeConnectionJets,
      p286CoordinateEquiv.apply_symm_apply]
    change
      holonomicP286GaugeCurvatureCoordinate
          (varyP286GaugeConnectionCoordinate configuration variation parameter)
          point pair =
        variedP286CurvatureCoordinate configuration variation parameter point
          pair
    have curvatureExpansion := congrFun
      (holonomicP286GaugeCurvatureCoordinate_expansion configuration smooth
        variation parameter point) pair
    simpa [variedP286CurvatureCoordinate] using curvatureExpansion
  · funext direction
    exact holonomicScalarCovariantDerivative_gaugeConnection_expansion
      configuration variation parameter point direction
  · funext direction
    exact holonomicMatterCovariantDerivative_gaugeConnection_expansion
      configuration variation parameter point direction

/-! ## Gauge BF and scalar kinetic polynomial identities -/

def p286GaugeBFCurvatureIncrementDensity
    (coframe : LorentzianCoframe)
    (spacetimeHodge : GaugeTwoForm →ₗ[ℝ] GaugeTwoForm)
    (auxiliary variation : P286GaugeTwoForm) : ℝ :=
  generatedGaugeTwoFormMetricPairing p286CoordinateLiePairing coframe
    auxiliary (liftGaugeTwoFormOperator spacetimeHodge variation)

theorem generatedGaugeSectorBFDensity_p286Coordinate_curvature_add_smul
    (coframe : LorentzianCoframe)
    (spacetimeHodge operator : GaugeTwoForm →ₗ[ℝ] GaugeTwoForm)
    (curvature auxiliary variation : P286GaugeTwoForm)
    (parameter : ℝ) :
    generatedGaugeSectorBFDensity p286CoordinateLiePairing coframe
        spacetimeHodge operator (curvature + parameter • variation) auxiliary =
      generatedGaugeSectorBFDensity p286CoordinateLiePairing coframe
          spacetimeHodge operator curvature auxiliary +
        parameter * p286GaugeBFCurvatureIncrementDensity coframe
          spacetimeHodge auxiliary variation := by
  unfold generatedGaugeSectorBFDensity
    p286GaugeBFCurvatureIncrementDensity
  rw [liftGaugeTwoFormOperator_add_p286,
    liftGaugeTwoFormOperator_smul_p286,
    generatedGaugeTwoFormMetricPairing_p286_add_right,
    generatedGaugeTwoFormMetricPairing_p286_smul_right]
  ring_nf

theorem generatedGaugeSectorBFDensity_p286Coordinate_curvature_quadratic
    (coframe : LorentzianCoframe)
    (spacetimeHodge operator : GaugeTwoForm →ₗ[ℝ] GaugeTwoForm)
    (curvature auxiliary linear quadratic : P286GaugeTwoForm)
    (parameter : ℝ) :
    generatedGaugeSectorBFDensity p286CoordinateLiePairing coframe
        spacetimeHodge operator
        (curvature + parameter • linear + parameter ^ 2 • quadratic)
        auxiliary =
      generatedGaugeSectorBFDensity p286CoordinateLiePairing coframe
          spacetimeHodge operator curvature auxiliary +
        parameter * p286GaugeBFCurvatureIncrementDensity coframe
          spacetimeHodge auxiliary linear +
        parameter ^ 2 * p286GaugeBFCurvatureIncrementDensity coframe
          spacetimeHodge auxiliary quadratic := by
  rw [show curvature + parameter • linear + parameter ^ 2 • quadratic =
    (curvature + parameter • linear) + parameter ^ 2 • quadratic by rfl]
  rw [generatedGaugeSectorBFDensity_p286Coordinate_curvature_add_smul,
    generatedGaugeSectorBFDensity_p286Coordinate_curvature_add_smul]

theorem scalarCoordinatePairingRe_add_left
    (first second residual : ScalarCoordinateCarrier) :
    scalarCoordinatePairingRe (first + second) residual =
      scalarCoordinatePairingRe first residual +
        scalarCoordinatePairingRe second residual := by
  unfold scalarCoordinatePairingRe
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro index _
  rw [WithLp.ofLp_add]
  simp [add_mul]

theorem scalarCoordinatePairingRe_add_right
    (first second residual : ScalarCoordinateCarrier) :
    scalarCoordinatePairingRe residual (first + second) =
      scalarCoordinatePairingRe residual first +
        scalarCoordinatePairingRe residual second := by
  unfold scalarCoordinatePairingRe
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro index _
  rw [WithLp.ofLp_add]
  simp [mul_add]

theorem scalarCoordinatePairingRe_real_smul_left
    (parameter : ℝ) (first residual : ScalarCoordinateCarrier) :
    scalarCoordinatePairingRe (parameter • first) residual =
      parameter * scalarCoordinatePairingRe first residual := by
  unfold scalarCoordinatePairingRe
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro index _
  rw [WithLp.ofLp_smul]
  simp [Complex.mul_re]
  ring

theorem scalarCoordinatePairingRe_real_smul_right
    (parameter : ℝ) (first residual : ScalarCoordinateCarrier) :
    scalarCoordinatePairingRe residual (parameter • first) =
      parameter * scalarCoordinatePairingRe residual first := by
  unfold scalarCoordinatePairingRe
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro index _
  rw [WithLp.ofLp_smul]
  simp [Complex.mul_re]
  ring

theorem scalarCoordinateAction_real_smul
    (groupElement : SU7MotherGroup) (parameter : ℝ)
    (coordinates : ScalarCoordinateCarrier) :
    scalarCoordinateAction groupElement (parameter • coordinates) =
      parameter • scalarCoordinateAction groupElement coordinates := by
  unfold scalarCoordinateAction
  rw [RCLike.real_smul_eq_coe_smul (K := ℂ)]
  simp only [map_smul]
  exact (RCLike.real_smul_eq_coe_smul (K := ℂ) parameter _).symm

theorem scalarFrameRelativeCovariantDerivative_add
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint)
    (first second : LorentzianIndex → ScalarCoordinateCarrier) :
    scalarFrameRelativeCovariantDerivative source chart point
        (first + second) =
      scalarFrameRelativeCovariantDerivative source chart point first +
        scalarFrameRelativeCovariantDerivative source chart point second := by
  funext direction
  simp [scalarFrameRelativeCovariantDerivative,
    scalarFrameRelativeCoordinates, scalarCoordinateAction_add]

theorem scalarFrameRelativeCovariantDerivative_real_smul
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (parameter : ℝ)
    (derivative : LorentzianIndex → ScalarCoordinateCarrier) :
    scalarFrameRelativeCovariantDerivative source chart point
        (parameter • derivative) =
      parameter • scalarFrameRelativeCovariantDerivative source chart point
        derivative := by
  funext direction
  simp [scalarFrameRelativeCovariantDerivative,
    scalarFrameRelativeCoordinates, scalarCoordinateAction_real_smul]

def scalarGaugeConnectionKineticFirstVariationDensity
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (variation : LorentzianIndex → ScalarCoordinateCarrier) : ℝ :=
  (1 / 2 : ℝ) *
    ∑ first : LorentzianIndex,
      ∑ second : LorentzianIndex,
        ((lorentzianMetricOfCoframe field.coframe)⁻¹ first second) *
          (scalarCoordinatePairingRe
              (scalarFrameRelativeCovariantDerivative source chart point
                variation first)
              (scalarFrameRelativeCovariantDerivative source chart point
                field.scalarCovariantDerivative second) +
            scalarCoordinatePairingRe
              (scalarFrameRelativeCovariantDerivative source chart point
                field.scalarCovariantDerivative first)
              (scalarFrameRelativeCovariantDerivative source chart point
                variation second))

def scalarGaugeConnectionKineticSecondVariationDensity
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (variation : LorentzianIndex → ScalarCoordinateCarrier) : ℝ :=
  (1 / 2 : ℝ) *
    ∑ first : LorentzianIndex,
      ∑ second : LorentzianIndex,
        ((lorentzianMetricOfCoframe field.coframe)⁻¹ first second) *
          scalarCoordinatePairingRe
            (scalarFrameRelativeCovariantDerivative source chart point
              variation first)
            (scalarFrameRelativeCovariantDerivative source chart point
              variation second)

theorem weightedDoubleSum_quadratic
    {First Second : Type*} [Fintype First] [Fintype Second]
    (weight baseTerm leftTerm rightTerm quadraticTerm :
      First → (Second → ℝ))
    (parameter : ℝ) :
    (∑ i : First, ∑ j : Second,
      weight i j *
        (baseTerm i j + parameter * leftTerm i j +
          parameter * (rightTerm i j + parameter * quadraticTerm i j))) =
      (∑ i : First, ∑ j : Second,
        weight i j * baseTerm i j) +
        parameter *
          (∑ i : First, ∑ j : Second,
            weight i j * (leftTerm i j + rightTerm i j)) +
        parameter ^ 2 *
          (∑ i : First, ∑ j : Second,
            weight i j * quadraticTerm i j) := by
  ring_nf
  simp_rw [Finset.sum_add_distrib, Finset.mul_sum]
  rw [mul_add]
  simp_rw [Finset.mul_sum]
  ring_nf

theorem generatedScalarKineticDensity_withP286GaugeConnectionJets_quadratic
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (curvature : P286GaugeTwoForm)
    (variation : LorentzianIndex → ScalarCoordinateCarrier)
    (matterDerivative : LorentzianIndex → DiracExteriorMatterCarrier)
    (parameter : ℝ) :
    generatedScalarKineticDensity source chart point
        (withP286GaugeConnectionJets field curvature
          (field.scalarCovariantDerivative + parameter • variation)
          matterDerivative) =
      generatedScalarKineticDensity source chart point field +
        parameter * scalarGaugeConnectionKineticFirstVariationDensity
          source chart point field variation +
        parameter ^ 2 * scalarGaugeConnectionKineticSecondVariationDensity
          source chart point field variation := by
  unfold generatedScalarKineticDensity
    scalarGaugeConnectionKineticFirstVariationDensity
    scalarGaugeConnectionKineticSecondVariationDensity
  simp only [withP286GaugeConnectionJets, Pi.add_apply, Pi.smul_apply,
    scalarFrameRelativeCovariantDerivative_add,
    scalarFrameRelativeCovariantDerivative_real_smul,
    scalarCoordinatePairingRe_add_left,
    scalarCoordinatePairingRe_add_right,
    scalarCoordinatePairingRe_real_smul_left,
    scalarCoordinatePairingRe_real_smul_right]
  simp_rw [← Matrix.of_symm_apply]
  rw [weightedDoubleSum_quadratic]
  ring

/-! ## Matter current polynomial identity -/

theorem matterFrameRelative_add
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (first second : DiracExteriorMatterCarrier) :
    matterFrameRelative source chart point (first + second) =
      matterFrameRelative source chart point first +
        matterFrameRelative source chart point second := by
  unfold matterFrameRelative
  exact map_add _ first second

theorem matterFrameRelative_real_smul
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (parameter : ℝ)
    (matter : DiracExteriorMatterCarrier) :
    matterFrameRelative source chart point (parameter • matter) =
      parameter • matterFrameRelative source chart point matter := by
  unfold matterFrameRelative
  change
    (diracExteriorMatterGaugeRepresentation
      (generatedScalarFrame source chart point)⁻¹)
        ((parameter : ℂ) • matter) =
      (parameter : ℂ) •
        (diracExteriorMatterGaugeRepresentation
          (generatedScalarFrame source chart point)⁻¹) matter
  exact map_smul _ _ _

theorem matterDerivativeFrameRelative_add
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint)
    (first second : LorentzianIndex → DiracExteriorMatterCarrier) :
    matterDerivativeFrameRelative source chart point (first + second) =
      matterDerivativeFrameRelative source chart point first +
        matterDerivativeFrameRelative source chart point second := by
  funext direction
  exact matterFrameRelative_add source chart point _ _

theorem matterDerivativeFrameRelative_real_smul
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (parameter : ℝ)
    (derivative : LorentzianIndex → DiracExteriorMatterCarrier) :
    matterDerivativeFrameRelative source chart point
        (parameter • derivative) =
      parameter • matterDerivativeFrameRelative source chart point derivative := by
  funext direction
  exact matterFrameRelative_real_smul source chart point parameter _

theorem matterDerivativeFrameRelative_smul
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (parameter : ℂ)
    (derivative : LorentzianIndex → DiracExteriorMatterCarrier) :
    matterDerivativeFrameRelative source chart point
        (parameter • derivative) =
      parameter • matterDerivativeFrameRelative source chart point derivative := by
  funext direction
  unfold matterDerivativeFrameRelative matterFrameRelative
  exact
    (diracExteriorMatterGaugeRepresentation
      (generatedScalarFrame source chart point)⁻¹).map_smul
        parameter (derivative direction)

theorem diracMatrixMatterAction_real_smul
    (matrix : DiracMatrix) (parameter : ℝ)
    (matter : DiracExteriorMatterCarrier) :
    diracMatrixMatterAction matrix (parameter • matter) =
      parameter • diracMatrixMatterAction matrix matter := by
  change
    diracMatrixMatterAction matrix ((parameter : ℂ) • matter) =
      (parameter : ℂ) • diracMatrixMatterAction matrix matter
  exact map_smul _ _ _

def matterGaugeKineticSum
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (derivative : LorentzianIndex → DiracExteriorMatterCarrier) :
    DiracExteriorMatterCarrier :=
  ∑ direction : LorentzianIndex,
    diracMatrixMatterAction
      (inverseCoframeDiracGamma
        { coframe := field.coframe, derivative := 0 } direction)
      (matterDerivativeFrameRelative source chart point derivative direction)

theorem matterGaugeKineticSum_add
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (first second : LorentzianIndex → DiracExteriorMatterCarrier) :
    matterGaugeKineticSum source chart point field (first + second) =
      matterGaugeKineticSum source chart point field first +
        matterGaugeKineticSum source chart point field second := by
  unfold matterGaugeKineticSum
  simp only [matterDerivativeFrameRelative_add, Pi.add_apply, map_add,
    Finset.sum_add_distrib]

theorem matterGaugeKineticSum_real_smul
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (parameter : ℝ)
    (derivative : LorentzianIndex → DiracExteriorMatterCarrier) :
    matterGaugeKineticSum source chart point field (parameter • derivative) =
      parameter • matterGaugeKineticSum source chart point field derivative := by
  change
    matterGaugeKineticSum source chart point field
        ((parameter : ℂ) • derivative) =
      (parameter : ℂ) •
        matterGaugeKineticSum source chart point field derivative
  unfold matterGaugeKineticSum
  simp only [matterDerivativeFrameRelative_smul, Pi.smul_apply, map_smul]
  rw [Finset.smul_sum]

theorem matterGaugeKineticSum_smul
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (parameter : ℂ)
    (derivative : LorentzianIndex → DiracExteriorMatterCarrier) :
    matterGaugeKineticSum source chart point field (parameter • derivative) =
      parameter • matterGaugeKineticSum source chart point field derivative := by
  unfold matterGaugeKineticSum
  simp only [matterDerivativeFrameRelative_smul, Pi.smul_apply, map_smul]
  rw [Finset.smul_sum]

def matterGaugeConnectionVariationVector
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (variation : LorentzianIndex → DiracExteriorMatterCarrier) :
    DiracExteriorMatterCarrier :=
  Complex.I • matterGaugeKineticSum source chart point field variation

def matterGaugeConnectionFirstVariationDensity
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (variation : LorentzianIndex → DiracExteriorMatterCarrier) : ℝ :=
  (matterDualFrameRelative source chart point field.conjugateMatter
    (matterGaugeConnectionVariationVector source chart point field
      variation)).re

theorem generatedContinuumMatterVector_withP286GaugeConnectionJets_affine
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (curvature : P286GaugeTwoForm)
    (scalarDerivative : LorentzianIndex → ScalarCoordinateCarrier)
    (variation : LorentzianIndex → DiracExteriorMatterCarrier)
    (parameter : ℝ) :
    generatedContinuumMatterVector source chart point
        (withP286GaugeConnectionJets field curvature scalarDerivative
          (field.matterCovariantDerivative + parameter • variation)) =
      generatedContinuumMatterVector source chart point field +
        parameter • matterGaugeConnectionVariationVector
          source chart point field variation := by
  unfold generatedContinuumMatterVector
    matterGaugeConnectionVariationVector
  let yukawa :=
    chiralExteriorYukawaAction
      (scalarCoordinateEquiv.symm
        (scalarFrameRelativeCoordinates source chart point field.scalar))
      (matterFrameRelative source chart point field.matter)
  change
    Complex.I •
          matterGaugeKineticSum source chart point field
            (field.matterCovariantDerivative +
              (parameter : ℂ) • variation) +
        yukawa =
      (Complex.I • matterGaugeKineticSum source chart point field
          field.matterCovariantDerivative + yukawa) +
        (parameter : ℂ) •
          (Complex.I • matterGaugeKineticSum source chart point field variation)
  rw [matterGaugeKineticSum_add, matterGaugeKineticSum_smul]
  rw [smul_add]
  module

theorem matterDualFrameRelative_real_smul
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint)
    (dual : Module.Dual ℂ DiracExteriorMatterCarrier)
    (parameter : ℝ) (matter : DiracExteriorMatterCarrier) :
    matterDualFrameRelative source chart point dual (parameter • matter) =
      (parameter : ℂ) *
        matterDualFrameRelative source chart point dual matter := by
  change
    matterDualFrameRelative source chart point dual
        ((parameter : ℂ) • matter) =
      (parameter : ℂ) •
        matterDualFrameRelative source chart point dual matter
  exact (matterDualFrameRelative source chart point dual).map_smul
    (parameter : ℂ) matter

theorem generatedContinuumMatterDensity_withP286GaugeConnectionJets_affine
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (curvature : P286GaugeTwoForm)
    (scalarDerivative : LorentzianIndex → ScalarCoordinateCarrier)
    (variation : LorentzianIndex → DiracExteriorMatterCarrier)
    (parameter : ℝ) :
    generatedContinuumMatterDensity source chart point
        (withP286GaugeConnectionJets field curvature scalarDerivative
          (field.matterCovariantDerivative + parameter • variation)) =
      generatedContinuumMatterDensity source chart point field +
        parameter * matterGaugeConnectionFirstVariationDensity
          source chart point field variation := by
  unfold generatedContinuumMatterDensity
    matterGaugeConnectionFirstVariationDensity
  rw [generatedContinuumMatterVector_withP286GaugeConnectionJets_affine]
  simp only [withP286GaugeConnectionJets, map_add, Complex.add_re,
    matterDualFrameRelative_real_smul]
  simp [Complex.mul_re]

/-! ## One exact local action polynomial -/

def p286GaugeConnectionFirstVariationDensity
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (curvatureVariation : P286GaugeTwoForm)
    (scalarVariation : LorentzianIndex → ScalarCoordinateCarrier)
    (matterVariation : LorentzianIndex → DiracExteriorMatterCarrier) : ℝ :=
  generatedVolumeDensity field *
    (p286GaugeBFCurvatureIncrementDensity field.coframe
        (coframeGaugeSpacetimeHodgeLinear field.coframe)
        (p286AuxiliaryCoordinate field) curvatureVariation +
      scalarGaugeConnectionKineticFirstVariationDensity
        source chart point field scalarVariation +
      matterGaugeConnectionFirstVariationDensity
        source chart point field matterVariation)

def p286GaugeConnectionSecondVariationDensity
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (curvatureVariation : P286GaugeTwoForm)
    (scalarVariation : LorentzianIndex → ScalarCoordinateCarrier) : ℝ :=
  generatedVolumeDensity field *
    (p286GaugeBFCurvatureIncrementDensity field.coframe
        (coframeGaugeSpacetimeHodgeLinear field.coframe)
        (p286AuxiliaryCoordinate field) curvatureVariation +
      scalarGaugeConnectionKineticSecondVariationDensity
        source chart point field scalarVariation)

theorem generatedUnifiedLocalDensityP286IndependentCore_connectionJets_quadratic
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (curvature : P286GaugeTwoForm)
    (scalarVariation : LorentzianIndex → ScalarCoordinateCarrier)
    (matterVariation : LorentzianIndex → DiracExteriorMatterCarrier)
    (parameter : ℝ) :
    generatedUnifiedLocalDensityP286IndependentCore source chart point
        (withP286GaugeConnectionJets field curvature
          (field.scalarCovariantDerivative + parameter • scalarVariation)
          (field.matterCovariantDerivative + parameter • matterVariation)) =
      generatedUnifiedLocalDensityP286IndependentCore source chart point field +
        parameter *
          (scalarGaugeConnectionKineticFirstVariationDensity
              source chart point field scalarVariation +
            matterGaugeConnectionFirstVariationDensity
              source chart point field matterVariation) +
        parameter ^ 2 *
          scalarGaugeConnectionKineticSecondVariationDensity
            source chart point field scalarVariation := by
  unfold generatedUnifiedLocalDensityP286IndependentCore
  rw [generatedScalarKineticDensity_withP286GaugeConnectionJets_quadratic,
    generatedContinuumMatterDensity_withP286GaugeConnectionJets_affine]
  simp only [generatedGravitySimplicityDensity,
    generatedGravitySimplicityResidual, generatedGravityBFDensity,
    withP286GaugeConnectionJets]
  ring

theorem generatedUnifiedLocalDensity_p286GaugeConnectionJets_quadratic
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (point : BasePoint) (field : StageNineContinuumPointField)
    (linearCurvature quadraticCurvature : P286GaugeTwoForm)
    (scalarVariation : LorentzianIndex → ScalarCoordinateCarrier)
    (matterVariation : LorentzianIndex → DiracExteriorMatterCarrier)
    (parameter : ℝ) :
    generatedUnifiedLocalDensityAtBoundary source
        (sourceGeneratedUnifiedCouplings source) chart point
        (withP286GaugeConnectionJets field
          (p286CurvatureCoordinate field + parameter • linearCurvature +
            parameter ^ 2 • quadraticCurvature)
          (field.scalarCovariantDerivative + parameter • scalarVariation)
          (field.matterCovariantDerivative + parameter • matterVariation)) =
      generatedUnifiedLocalDensityAtBoundary source
          (sourceGeneratedUnifiedCouplings source) chart point field +
        parameter * p286GaugeConnectionFirstVariationDensity
          source chart point field linearCurvature scalarVariation
            matterVariation +
        parameter ^ 2 * p286GaugeConnectionSecondVariationDensity
          source chart point field quadraticCurvature scalarVariation := by
  rw [generatedUnifiedLocalDensity_p286_decomposition,
    generatedUnifiedLocalDensity_p286_decomposition]
  simp only [withP286GaugeConnectionJets_volume,
    withP286GaugeConnectionJets_coframe,
    p286CurvatureCoordinate_withP286GaugeConnectionJets,
    p286AuxiliaryCoordinate_withP286GaugeConnectionJets]
  rw [generatedUnifiedLocalDensityP286IndependentCore_connectionJets_quadratic]
  rw [generatedGaugeSectorBFDensity_p286Coordinate_curvature_quadratic]
  unfold p286GaugeConnectionFirstVariationDensity
    p286GaugeConnectionSecondVariationDensity
  ring

def holonomicP286GaugeConnectionFirstVariationDensity
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → P286GaugeOneForm) (point : BasePoint) : ℝ :=
  p286GaugeConnectionFirstVariationDensity source chart point
    (toContinuumPointField configuration point)
    (p286GaugeConnectionLinearCurvatureVariation configuration variation point)
    (holonomicScalarGaugeConnectionVariation configuration variation point)
    (holonomicMatterGaugeConnectionVariation configuration variation point)

def holonomicP286GaugeConnectionSecondVariationDensity
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (configuration : StageNineHolonomicConfiguration)
    (variation : BasePoint → P286GaugeOneForm) (point : BasePoint) : ℝ :=
  p286GaugeConnectionSecondVariationDensity source chart point
    (toContinuumPointField configuration point)
    (p286GaugeConnectionQuadraticCurvatureVariation variation point)
    (holonomicScalarGaugeConnectionVariation configuration variation point)

theorem holonomicLocalDensity_p286GaugeConnection_quadratic
    (source : SmoothUnifiedSource) (chart : StageNineChart)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (variation : CompactlySupportedSmoothVariation P286GaugeOneForm)
    (parameter : ℝ) (point : BasePoint) :
    generatedUnifiedLocalDensityAtBoundary source
        (sourceGeneratedUnifiedCouplings source) chart point
        (toContinuumPointField
          (varyP286GaugeConnectionCoordinate configuration variation parameter)
          point) =
      generatedUnifiedLocalDensityAtBoundary source
          (sourceGeneratedUnifiedCouplings source) chart point
          (toContinuumPointField configuration point) +
        parameter * holonomicP286GaugeConnectionFirstVariationDensity
          source chart configuration variation point +
        parameter ^ 2 * holonomicP286GaugeConnectionSecondVariationDensity
          source chart configuration variation point := by
  rw [toContinuumPointField_varyP286GaugeConnectionCoordinate configuration
    smooth variation parameter point]
  exact generatedUnifiedLocalDensity_p286GaugeConnectionJets_quadratic
    source chart point (toContinuumPointField configuration point)
      (p286GaugeConnectionLinearCurvatureVariation configuration variation point)
      (p286GaugeConnectionQuadraticCurvatureVariation variation point)
      (holonomicScalarGaugeConnectionVariation configuration variation point)
      (holonomicMatterGaugeConnectionVariation configuration variation point)
      parameter

end

