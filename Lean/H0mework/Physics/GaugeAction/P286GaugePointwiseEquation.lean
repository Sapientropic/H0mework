import H0mework.Physics.Constitutive.P286GaugeGeometricFirstVariation
import H0mework.Physics.Matter.ChargedGaugeCurrentThreeFormRegularity
import H0mework.Physics.Constitutive.P286GaugeGeometricRegularity
import H0mework.Physics.GaugeAction.TopologicalP286GaugeWeakEquation

/-!
# Form-native P286 gauge pointwise equation

This module localizes the complete P286 connection response generated by the
form-native action.  The action derivative first becomes the W13 weak equation
for the same Euler three-form; continuity generated from the actual primitive
fields then discharges the sole analytic premise of the formulation-neutral
P286 W13 fundamental lemma.

The resulting pointwise equation is the exact action-stationarity
characterization

```text
D_A B + S_charged = 0  iff  D_A B = J_charged,
J_charged := -S_charged.
```

It does not construct a stationary configuration, consume an equation or
current receipt, eliminate the auxiliary field, or count as an independent
Cauchy constraint.  The action derivative remains the producer;
localization and the physical-current sign are faithful readouts.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineFormNativeP286GaugePointwiseEquation

open ProofFreeRicherAnholonomicSource
open StageNineCompactSupportIntegrationByParts
open StageNineEnrichedProofFreeSource
open StageNineFormNativeChargedGaugeCurrentThreeFormRegularity
open StageNineFormNativeP286GaugeConnectionIntegratedVariation
open StageNineFormNativeP286GaugeGeometricFirstVariation
open StageNineFormNativeP286GaugeGeometricKinematics
open StageNineFormNativeP286GaugeGeometricRegularity
open StageNineFormNativeMotherAction
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineP286GaugeConnectionVariation
open StageNineTopologicalP286GaugeWeakEquation
open SU7MotherGaugeTheory
open SU7MotherLieAlgebra

noncomputable section

set_option autoImplicit false

local instance p286ModuleFinite : Module.Finite ℝ P286LieBlockData :=
  FiniteDimensional.of_injective p286AmbientLinear
    p286AmbientLinear_injective

local instance p286CoordinateIndexFintype : Fintype P286CoordinateIndex :=
  Fintype.ofFinite P286CoordinateIndex

local instance p286CoordinateIsTopologicalAddGroup :
    IsTopologicalAddGroup P286CoordinateCarrier where
  toContinuousAdd := inferInstance
  toContinuousNeg := inferInstance

/-! ## Complete residual continuity -/

theorem holonomicFormNativeP286GaugeEulerThreeForm_continuous
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate) :
    Continuous
      (holonomicFormNativeP286GaugeEulerThreeForm source 0 configuration) :=
  (holonomicP286GaugeAuxiliaryExteriorCovariantDerivative_continuous
    configuration smooth).add
      (holonomicFormNativeChargedGaugeThreeForm_continuous source configuration
        smooth nondegenerate)

/-! ## Action weak equation to W13 weak equation -/

theorem formNativeP286GaugeConnectionWeakEquation_iff_topological
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate) :
    FormNativeP286GaugeConnectionWeakEquation source configuration ↔
      TopologicalP286GaugeWeakEquation
        (holonomicFormNativeP286GaugeEulerThreeForm source 0 configuration) := by
  constructor
  · intro actionWeak variation
    have firstCoefficientZero := actionWeak variation
    rw [holonomicFormNativeP286GaugeConnectionFirstVariation_integral_eq_w13
      source configuration smooth nondegenerate variation] at firstCoefficientZero
    exact firstCoefficientZero
  · intro topologicalWeak variation
    have eulerPairingZero := topologicalWeak variation
    rw [← holonomicFormNativeP286GaugeConnectionFirstVariation_integral_eq_w13
      source configuration smooth nondegenerate variation] at eulerPairingZero
    exact eulerPairingZero

/-- The action weak equation has the faithful pointwise Euler-three-form zero
fiber.  Continuity is generated from the actual primitive fields rather than
supplied as a receipt. -/
theorem formNativeP286GaugeConnectionWeakEquation_iff_eulerThreeForm_eq_zero
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate) :
    FormNativeP286GaugeConnectionWeakEquation source configuration ↔
      holonomicFormNativeP286GaugeEulerThreeForm source 0 configuration = 0 := by
  rw [formNativeP286GaugeConnectionWeakEquation_iff_topological source
    configuration smooth nondegenerate]
  exact topologicalP286GaugeWeakEquation_iff_residual_eq_zero
    (holonomicFormNativeP286GaugeEulerThreeForm source 0 configuration)
    (holonomicFormNativeP286GaugeEulerThreeForm_continuous source configuration
      smooth nondegenerate)

/-! ## Pointwise physical-current readout -/

def FormNativeP286GaugeConnectionPointwiseEquation
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration) : Prop :=
  ∀ point : BasePoint,
    holonomicP286GaugeAuxiliaryExteriorCovariantDerivative configuration point =
      formNativePhysicalChargedGaugeCurrentThreeForm source 0 point
        (toContinuumPointField configuration point)

theorem holonomicFormNativeP286GaugeEulerThreeForm_eq_zero_iff_pointwiseEquation
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration) :
    holonomicFormNativeP286GaugeEulerThreeForm source 0 configuration = 0 ↔
      FormNativeP286GaugeConnectionPointwiseEquation source configuration := by
  constructor
  · intro residualZero point
    have pointZero := congrFun residualZero point
    exact
      (holonomicFormNativeP286GaugeEulerThreeForm_eq_zero_iff_current source 0
        configuration point).mp pointZero
  · intro pointwiseEquation
    funext point
    exact
      (holonomicFormNativeP286GaugeEulerThreeForm_eq_zero_iff_current source 0
        configuration point).mpr (pointwiseEquation point)

theorem formNativeP286GaugeConnectionWeakEquation_iff_pointwiseEquation
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate) :
    FormNativeP286GaugeConnectionWeakEquation source configuration ↔
      FormNativeP286GaugeConnectionPointwiseEquation source configuration := by
  rw [formNativeP286GaugeConnectionWeakEquation_iff_eulerThreeForm_eq_zero
    source configuration smooth nondegenerate]
  exact
    holonomicFormNativeP286GaugeEulerThreeForm_eq_zero_iff_pointwiseEquation
      source configuration

/-- Final action-derived characterization.  The theorem does not assert that
the supplied configuration is stationary; it states exactly what stationarity
means for the authoritative form-native P286 connection path family. -/
theorem formNativeP286GaugeConnectionActionStationary_iff_pointwiseEquation
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate)
    (densityIntegrable :
      FormNativeHolonomicLocalDensityIntegrable source 0 configuration) :
    FormNativeP286GaugeConnectionActionStationary source configuration ↔
      FormNativeP286GaugeConnectionPointwiseEquation source configuration := by
  rw [formNativeP286GaugeConnectionActionStationary_iff_weakEquation source
    configuration smooth nondegenerate densityIntegrable]
  exact formNativeP286GaugeConnectionWeakEquation_iff_pointwiseEquation source
    configuration smooth nondegenerate

end

end
  SaturationMonoid.PhysicsCore.StageNineFormNativeP286GaugePointwiseEquation
