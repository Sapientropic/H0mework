noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 800000
set_option maxRecDepth 100000

local instance p286ModuleFinite : Module.Finite ℝ P286LieBlockData :=
  FiniteDimensional.of_injective p286AmbientLinear
    p286AmbientLinear_injective

local instance p286CoordinateIndexFintype : Fintype P286CoordinateIndex :=
  Fintype.ofFinite P286CoordinateIndex

local instance p286CoordinateIsTopologicalAddGroup :
    IsTopologicalAddGroup P286CoordinateCarrier where
  toContinuousAdd := inferInstance
  toContinuousNeg := inferInstance

/-! ## Direct exterior derivative and its principal symbol -/

/-- Contribution of one coordinate derivative to the P286-valued two-form
`d a`.  This is a coordinate exterior derivative, so neither a coframe nor a
spacetime Hodge enters. -/
def p286GaugeExteriorDerivativeDirection
    (derivativeDirection : LorentzianIndex)
    (oneForm : P286GaugeOneForm) : P286GaugeTwoForm :=
  fun pair =>
    (if derivativeDirection = pairFirst pair then
        oneForm (pairSecond pair)
      else 0) -
      if derivativeDirection = pairSecond pair then
        oneForm (pairFirst pair)
      else 0

theorem p286GaugeExteriorDerivativeDirection_add
    (derivativeDirection : LorentzianIndex)
    (first second : P286GaugeOneForm) :
    p286GaugeExteriorDerivativeDirection derivativeDirection
        (first + second) =
      p286GaugeExteriorDerivativeDirection derivativeDirection first +
        p286GaugeExteriorDerivativeDirection derivativeDirection second := by
  funext pair
  unfold p286GaugeExteriorDerivativeDirection
  simp only [Pi.add_apply]
  split_ifs <;> module

theorem p286GaugeExteriorDerivativeDirection_smul
    (derivativeDirection : LorentzianIndex) (parameter : ℝ)
    (oneForm : P286GaugeOneForm) :
    p286GaugeExteriorDerivativeDirection derivativeDirection
        (parameter • oneForm) =
      parameter •
        p286GaugeExteriorDerivativeDirection derivativeDirection oneForm := by
  funext pair
  unfold p286GaugeExteriorDerivativeDirection
  simp only [Pi.smul_apply]
  split_ifs <;> module

theorem p286TopologicalGaugeBFCoefficient_add_left
    (first second residual : P286GaugeTwoForm) :
    generatedTwoFormWedgeCoefficient p286CoordinateLiePairing
        (first + second) residual =
      generatedTwoFormWedgeCoefficient p286CoordinateLiePairing first residual +
        generatedTwoFormWedgeCoefficient p286CoordinateLiePairing second
          residual := by
  unfold generatedTwoFormWedgeCoefficient
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro pair _
  rw [Pi.add_apply, p286CoordinateLiePairing_add_left]

theorem p286TopologicalGaugeBFCoefficient_smul_left
    (parameter : ℝ) (first second : P286GaugeTwoForm) :
    generatedTwoFormWedgeCoefficient p286CoordinateLiePairing
        (parameter • first) second =
      parameter * generatedTwoFormWedgeCoefficient p286CoordinateLiePairing
        first second := by
  unfold generatedTwoFormWedgeCoefficient
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro pair _
  rw [Pi.smul_apply, p286CoordinateLiePairing_smul_left]

theorem p286TopologicalGaugeBFCoefficient_add_right
    (first second residual : P286GaugeTwoForm) :
    generatedTwoFormWedgeCoefficient p286CoordinateLiePairing residual
        (first + second) =
      generatedTwoFormWedgeCoefficient p286CoordinateLiePairing residual first +
        generatedTwoFormWedgeCoefficient p286CoordinateLiePairing residual
          second := by
  unfold generatedTwoFormWedgeCoefficient
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro pair _
  rw [Pi.add_apply, p286CoordinateLiePairing_add_right]

theorem p286TopologicalGaugeBFCoefficient_smul_right
    (parameter : ℝ) (first second : P286GaugeTwoForm) :
    generatedTwoFormWedgeCoefficient p286CoordinateLiePairing first
        (parameter • second) =
      parameter * generatedTwoFormWedgeCoefficient p286CoordinateLiePairing
        first second := by
  unfold generatedTwoFormWedgeCoefficient
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro pair _
  rw [Pi.smul_apply, p286CoordinateLiePairing_smul_right]

private def p286TopologicalGaugeBFRightLinear
    (auxiliary : P286GaugeTwoForm) : P286GaugeTwoForm →ₗ[ℝ] ℝ where
  toFun := generatedTwoFormWedgeCoefficient p286CoordinateLiePairing auxiliary
  map_add' := fun first second =>
    p286TopologicalGaugeBFCoefficient_add_right first second auxiliary
  map_smul' := by
    intro parameter first
    simpa only [RingHom.id_apply, smul_eq_mul] using
      p286TopologicalGaugeBFCoefficient_smul_right parameter auxiliary first

/-- Derivative-direction principal pairing
`(B,a) |-> W22_P286(B,d_direction a)`. -/
def p286GaugeExteriorPrincipalBilinear
    (derivativeDirection : LorentzianIndex) :
    P286GaugeTwoForm →ₗ[ℝ] P286GaugeOneForm →ₗ[ℝ] ℝ where
  toFun auxiliary :=
    { toFun := fun oneForm =>
        generatedTwoFormWedgeCoefficient p286CoordinateLiePairing auxiliary
          (p286GaugeExteriorDerivativeDirection derivativeDirection oneForm)
      map_add' := by
        intro first second
        rw [p286GaugeExteriorDerivativeDirection_add,
          p286TopologicalGaugeBFCoefficient_add_right]
      map_smul' := by
        intro parameter oneForm
        rw [p286GaugeExteriorDerivativeDirection_smul,
          p286TopologicalGaugeBFCoefficient_smul_right]
        rfl }
  map_add' := by
    intro first second
    apply LinearMap.ext
    intro oneForm
    exact p286TopologicalGaugeBFCoefficient_add_left first second _
  map_smul' := by
    intro parameter auxiliary
    apply LinearMap.ext
    intro oneForm
    change
      generatedTwoFormWedgeCoefficient p286CoordinateLiePairing
          (parameter • auxiliary)
          (p286GaugeExteriorDerivativeDirection derivativeDirection oneForm) =
        parameter *
          generatedTwoFormWedgeCoefficient p286CoordinateLiePairing auxiliary
            (p286GaugeExteriorDerivativeDirection derivativeDirection oneForm)
    exact p286TopologicalGaugeBFCoefficient_smul_left parameter auxiliary _

@[simp] theorem p286GaugeExteriorPrincipalBilinear_apply
    (derivativeDirection : LorentzianIndex)
    (auxiliary : P286GaugeTwoForm) (oneForm : P286GaugeOneForm) :
    p286GaugeExteriorPrincipalBilinear derivativeDirection auxiliary oneForm =
      generatedTwoFormWedgeCoefficient p286CoordinateLiePairing auxiliary
        (p286GaugeExteriorDerivativeDirection derivativeDirection oneForm) :=
  rfl

/-- Finite-dimensional continuity of the principal symbol. -/
def p286GaugeExteriorPrincipalContinuousBilinear
    (derivativeDirection : LorentzianIndex) :
    P286GaugeTwoForm →L[ℝ] P286GaugeOneForm →L[ℝ] ℝ :=
  (p286GaugeExteriorPrincipalBilinear derivativeDirection)
    |>.toContinuousBilinearMap

@[simp] theorem p286GaugeExteriorPrincipalContinuousBilinear_apply
    (derivativeDirection : LorentzianIndex)
    (auxiliary : P286GaugeTwoForm) (oneForm : P286GaugeOneForm) :
    p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection auxiliary
        oneForm =
      generatedTwoFormWedgeCoefficient p286CoordinateLiePairing auxiliary
        (p286GaugeExteriorDerivativeDirection derivativeDirection oneForm) :=
  rfl

/-- Direct `d a`, assembled from the actual Fréchet derivative of the whole
P286 one-form variation. -/
def p286GaugeOneFormExteriorDerivative
    (variation : BasePoint → P286GaugeOneForm)
    (point : BasePoint) : P286GaugeTwoForm :=
  ∑ derivativeDirection : LorentzianIndex,
    p286GaugeExteriorDerivativeDirection derivativeDirection
      (fieldDirectionalDerivative variation point derivativeDirection)

private theorem fieldDirectionalDerivative_p286OneForm_coordinate
    (variation : CompactlySupportedSmoothVariation P286GaugeOneForm)
    (point : BasePoint) (derivativeDirection formDirection : LorentzianIndex) :
    (fieldDirectionalDerivative variation point derivativeDirection)
        formDirection =
      p286GaugeVariationCoordinateDerivative variation point
        derivativeDirection formDirection := by
  unfold p286GaugeVariationCoordinateDerivative fieldDirectionalDerivative
  have differentiable : DifferentiableAt ℝ variation point :=
    (variation.smooth.differentiable (by simp)).differentiableAt
  have derivativeEquality := fderiv_apply differentiable formDirection
  have applied := congrArg
    (fun derivative : BasePoint →L[ℝ] P286CoordinateCarrier =>
      derivative (coordinateDirection derivativeDirection)) derivativeEquality
  simpa only [ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.proj_apply] using applied.symm

/-- The direct exterior derivative used by the analytic carrier is exactly
the exterior channel of the primitive connection curvature response. -/
theorem p286GaugeOneFormExteriorDerivative_eq_actual
    (variation : CompactlySupportedSmoothVariation P286GaugeOneForm)
    (point : BasePoint) :
    p286GaugeOneFormExteriorDerivative variation point =
      p286GaugeConnectionExteriorDerivativeVariation variation point := by
  funext pair
  unfold p286GaugeOneFormExteriorDerivative
    p286GaugeExteriorDerivativeDirection
    p286GaugeConnectionExteriorDerivativeVariation
  fin_cases pair <;>
    simp only [Finset.sum_apply, pairFirst, pairSecond,
      fieldDirectionalDerivative_p286OneForm_coordinate]
  all_goals
    rw [Finset.sum_sub_distrib, Fintype.sum_ite_eq',
      Fintype.sum_ite_eq']

/-! ## Finite-coordinate Stokes identities -/

theorem p286TopologicalGaugeBF_exteriorDerivative_eq_principalSum
    (auxiliary : P286GaugeTwoForm)
    (variation : BasePoint → P286GaugeOneForm) (point : BasePoint) :
    generatedTwoFormWedgeCoefficient p286CoordinateLiePairing auxiliary
        (p286GaugeOneFormExteriorDerivative variation point) =
      ∑ derivativeDirection : LorentzianIndex,
        p286GaugeExteriorPrincipalBilinear derivativeDirection auxiliary
          (fieldDirectionalDerivative variation point derivativeDirection) := by
  change
    p286TopologicalGaugeBFRightLinear auxiliary
        (∑ derivativeDirection : LorentzianIndex,
          p286GaugeExteriorDerivativeDirection derivativeDirection
            (fieldDirectionalDerivative variation point
              derivativeDirection)) =
      ∑ derivativeDirection : LorentzianIndex,
        p286TopologicalGaugeBFRightLinear auxiliary
          (p286GaugeExteriorDerivativeDirection derivativeDirection
            (fieldDirectionalDerivative variation point
              derivativeDirection))
  rw [map_sum]

private theorem p286CoordinateLiePairing_neg_right_local
    (first second : P286CoordinateCarrier) :
    p286CoordinateLiePairing first (-second) =
      -p286CoordinateLiePairing first second := by
  rw [show -second = (-1 : ℝ) • second by simp,
    p286CoordinateLiePairing_smul_right]
  ring

/-- The analytic integration-by-parts minus sign is exactly converted into
the fixed `(+,-,+,-)` W13 orientation. -/
theorem p286GaugeExteriorPrincipalSum_eq_w13
    (derivative : LorentzianIndex → P286GaugeTwoForm)
    (oneForm : P286GaugeOneForm) :
    -(∑ derivativeDirection : LorentzianIndex,
        p286GaugeExteriorPrincipalBilinear derivativeDirection
          (derivative derivativeDirection) oneForm) =
      p286GaugeOneFormThreeFormWedgeCoefficient oneForm
        (pointwiseP286GaugeTwoFormExteriorDerivativeOfDerivative
          derivative) := by
  classical
  simp [p286GaugeExteriorPrincipalBilinear,
    generatedTwoFormWedgeCoefficient,
    p286GaugeExteriorDerivativeDirection,
    p286GaugeOneFormThreeFormWedgeCoefficient,
    pointwiseP286GaugeTwoFormExteriorDerivativeOfDerivative,
    twoFormComplement, oneWedgeThreeSign, missingTripleOfOneForm,
    threeFormFirst, threeFormSecond, threeFormThird,
    pairFirst, pairSecond, Fin.sum_univ_four, Fin.sum_univ_six,
    p286CoordinateLiePairing_add_right,
    p286CoordinateLiePairing_neg_right_local,
    p286CoordinateLiePairing_symmetric]
  ring

/-! ## Compact-support integration by parts -/

private theorem p286GaugeExteriorPrincipal_left_integrable
    (background : BasePoint → P286GaugeTwoForm)
    (backgroundSmooth : ContDiff ℝ ∞ background)
    (variation : CompactlySupportedSmoothVariation P286GaugeOneForm)
    (derivativeDirection : LorentzianIndex) :
    Integrable fun point =>
      p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection
        (background point)
        (fderiv ℝ variation point
          (coordinateDirection derivativeDirection)) := by
  have termContinuous : Continuous fun point =>
      p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection
        (background point)
        (fderiv ℝ variation point
          (coordinateDirection derivativeDirection)) :=
    ((p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection)
      |>.continuous.comp backgroundSmooth.continuous).clm_apply
        (compactVariation_directionalDerivative_continuous variation
          derivativeDirection)
  have derivativeCompact : HasCompactSupport fun point =>
      fderiv ℝ variation point
        (coordinateDirection derivativeDirection) :=
    compactVariation_directionalDerivative_compact variation
      derivativeDirection
  have termCompact : HasCompactSupport fun point =>
      p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection
        (background point)
        (fderiv ℝ variation point
          (coordinateDirection derivativeDirection)) :=
    hasCompactSupport_bilinear_right
      (p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection)
      background _ derivativeCompact
  exact termContinuous.integrable_of_hasCompactSupport termCompact

private theorem p286GaugeExteriorPrincipal_right_integrable
    (background : BasePoint → P286GaugeTwoForm)
    (backgroundSmooth : ContDiff ℝ ∞ background)
    (variation : CompactlySupportedSmoothVariation P286GaugeOneForm)
    (derivativeDirection : LorentzianIndex) :
    Integrable fun point =>
      p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection
        (fderiv ℝ background point
          (coordinateDirection derivativeDirection))
        (variation point) := by
  have derivativeContinuous : Continuous (fderiv ℝ background) :=
    (backgroundSmooth.fderiv_right (m := 0) (by simp)).continuous
  have directionalContinuous : Continuous fun point =>
      fderiv ℝ background point
        (coordinateDirection derivativeDirection) :=
    derivativeContinuous.clm_apply continuous_const
  have termContinuous : Continuous fun point =>
      p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection
        (fderiv ℝ background point
          (coordinateDirection derivativeDirection))
        (variation point) :=
    ((p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection)
      |>.continuous.comp directionalContinuous).clm_apply
        variation.smooth.continuous
  have termCompact : HasCompactSupport fun point =>
      p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection
        (fderiv ℝ background point
          (coordinateDirection derivativeDirection))
        (variation point) :=
    hasCompactSupport_bilinear_right
      (p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection)
      _ variation variation.compactSupport
  exact termContinuous.integrable_of_hasCompactSupport termCompact

private theorem p286GaugeExteriorPrincipal_integrationByParts
    (background : BasePoint → P286GaugeTwoForm)
    (backgroundSmooth : ContDiff ℝ ∞ background)
    (variation : CompactlySupportedSmoothVariation P286GaugeOneForm)
    (derivativeDirection : LorentzianIndex) :
    (∫ point : BasePoint,
      p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection
        (background point)
        (fderiv ℝ variation point
          (coordinateDirection derivativeDirection))) =
      -(∫ point : BasePoint,
        p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection
          (fderiv ℝ background point
            (coordinateDirection derivativeDirection))
          (variation point)) :=
  compactSupport_integrationByParts
    (p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection)
    background variation backgroundSmooth derivativeDirection

private theorem holonomicP286GaugeAuxiliaryCoordinate_contDiff_local
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth) :
    ContDiff ℝ ∞
      (holonomicP286GaugeAuxiliaryCoordinate configuration) := by
  apply contDiff_pi'
  intro pair
  exact smooth.2.2.2.2.2.1 pair

/-! ## Public integrability and production-facing identity -/

theorem p286TopologicalGaugeBF_exteriorDerivativeVariation_integrable
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (variation : CompactlySupportedSmoothVariation P286GaugeOneForm) :
    Integrable fun point : BasePoint =>
      generatedTwoFormWedgeCoefficient p286CoordinateLiePairing
        (holonomicP286GaugeAuxiliaryCoordinate configuration point)
        (p286GaugeConnectionExteriorDerivativeVariation variation point) := by
  have auxiliarySmooth :=
    holonomicP286GaugeAuxiliaryCoordinate_contDiff_local configuration smooth
  have principalIntegrable : Integrable fun point : BasePoint =>
      ∑ derivativeDirection : LorentzianIndex,
        p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection
          (holonomicP286GaugeAuxiliaryCoordinate configuration point)
          (fderiv ℝ variation point
            (coordinateDirection derivativeDirection)) :=
    integrable_finsetSum Finset.univ fun derivativeDirection _ =>
      p286GaugeExteriorPrincipal_left_integrable
        (holonomicP286GaugeAuxiliaryCoordinate configuration) auxiliarySmooth
        variation derivativeDirection
  refine principalIntegrable.congr ?_
  filter_upwards [] with point
  rw [← p286GaugeOneFormExteriorDerivative_eq_actual variation point]
  simpa [fieldDirectionalDerivative] using
    (p286TopologicalGaugeBF_exteriorDerivative_eq_principalSum
      (holonomicP286GaugeAuxiliaryCoordinate configuration point)
      variation point).symm

theorem p286Wedge_holonomicGaugeAuxiliaryExteriorDerivative_integrable
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (variation : CompactlySupportedSmoothVariation P286GaugeOneForm) :
    Integrable fun point : BasePoint =>
      p286GaugeOneFormThreeFormWedgeCoefficient (variation point)
        (holonomicP286GaugeAuxiliaryExteriorDerivative configuration point) := by
  have auxiliarySmooth :=
    holonomicP286GaugeAuxiliaryCoordinate_contDiff_local configuration smooth
  have principalIntegrable : Integrable fun point : BasePoint =>
      ∑ derivativeDirection : LorentzianIndex,
        p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection
          (fderiv ℝ (holonomicP286GaugeAuxiliaryCoordinate configuration) point
            (coordinateDirection derivativeDirection))
          (variation point) :=
    integrable_finsetSum Finset.univ fun derivativeDirection _ =>
      p286GaugeExteriorPrincipal_right_integrable
        (holonomicP286GaugeAuxiliaryCoordinate configuration) auxiliarySmooth
        variation derivativeDirection
  refine principalIntegrable.neg.congr ?_
  filter_upwards [] with point
  simpa [p286GaugeAuxiliaryDirectionalDerivative,
    fieldDirectionalDerivative,
    p286GaugeExteriorPrincipalContinuousBilinear,
    holonomicP286GaugeAuxiliaryExteriorDerivative] using
      p286GaugeExteriorPrincipalSum_eq_w13
        (p286GaugeAuxiliaryDirectionalDerivative configuration point)
        (variation point)

/-- Derivative-only arbitrary-variation compact integration by parts.  Both
sides consume the same actual auxiliary field. -/
theorem p286TopologicalGaugeBF_exteriorDerivative_integral_eq_w13
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (variation : CompactlySupportedSmoothVariation P286GaugeOneForm) :
    (∫ point : BasePoint,
      generatedTwoFormWedgeCoefficient p286CoordinateLiePairing
        (holonomicP286GaugeAuxiliaryCoordinate configuration point)
        (p286GaugeOneFormExteriorDerivative variation point)) =
      ∫ point : BasePoint,
        p286GaugeOneFormThreeFormWedgeCoefficient (variation point)
          (holonomicP286GaugeAuxiliaryExteriorDerivative configuration point) := by
  have auxiliarySmooth :=
    holonomicP286GaugeAuxiliaryCoordinate_contDiff_local configuration smooth
  have leftIntegrable : ∀ derivativeDirection : LorentzianIndex,
      Integrable fun point =>
        p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection
          (holonomicP286GaugeAuxiliaryCoordinate configuration point)
          (fderiv ℝ variation point
            (coordinateDirection derivativeDirection)) :=
    p286GaugeExteriorPrincipal_left_integrable
      (holonomicP286GaugeAuxiliaryCoordinate configuration) auxiliarySmooth
      variation
  have rightIntegrable : ∀ derivativeDirection : LorentzianIndex,
      Integrable fun point =>
        p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection
          (fderiv ℝ (holonomicP286GaugeAuxiliaryCoordinate configuration) point
            (coordinateDirection derivativeDirection))
          (variation point) :=
    p286GaugeExteriorPrincipal_right_integrable
      (holonomicP286GaugeAuxiliaryCoordinate configuration) auxiliarySmooth
      variation
  have ibp : ∀ derivativeDirection : LorentzianIndex,
      (∫ point : BasePoint,
        p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection
          (holonomicP286GaugeAuxiliaryCoordinate configuration point)
          (fderiv ℝ variation point
            (coordinateDirection derivativeDirection))) =
        -(∫ point : BasePoint,
          p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection
            (fderiv ℝ (holonomicP286GaugeAuxiliaryCoordinate configuration)
              point (coordinateDirection derivativeDirection))
            (variation point)) :=
    p286GaugeExteriorPrincipal_integrationByParts
      (holonomicP286GaugeAuxiliaryCoordinate configuration) auxiliarySmooth
      variation
  calc
    (∫ point : BasePoint,
        generatedTwoFormWedgeCoefficient p286CoordinateLiePairing
          (holonomicP286GaugeAuxiliaryCoordinate configuration point)
          (p286GaugeOneFormExteriorDerivative variation point)) =
      ∫ point : BasePoint,
        ∑ derivativeDirection : LorentzianIndex,
          p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection
            (holonomicP286GaugeAuxiliaryCoordinate configuration point)
            (fderiv ℝ variation point
              (coordinateDirection derivativeDirection)) := by
        apply integral_congr_ae
        filter_upwards [] with point
        simpa [fieldDirectionalDerivative] using
          p286TopologicalGaugeBF_exteriorDerivative_eq_principalSum
            (holonomicP286GaugeAuxiliaryCoordinate configuration point)
            variation point
    _ = ∑ derivativeDirection : LorentzianIndex,
        ∫ point : BasePoint,
          p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection
            (holonomicP286GaugeAuxiliaryCoordinate configuration point)
            (fderiv ℝ variation point
              (coordinateDirection derivativeDirection)) := by
      exact integral_finsetSum Finset.univ fun derivativeDirection _ =>
        leftIntegrable derivativeDirection
    _ = ∑ derivativeDirection : LorentzianIndex,
        -(∫ point : BasePoint,
          p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection
            (fderiv ℝ (holonomicP286GaugeAuxiliaryCoordinate configuration)
              point (coordinateDirection derivativeDirection))
            (variation point)) := by
      apply Finset.sum_congr rfl
      intro derivativeDirection _
      exact ibp derivativeDirection
    _ = -(∑ derivativeDirection : LorentzianIndex,
        ∫ point : BasePoint,
          p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection
            (fderiv ℝ (holonomicP286GaugeAuxiliaryCoordinate configuration)
              point (coordinateDirection derivativeDirection))
            (variation point)) := by
      rw [Finset.sum_neg_distrib]
    _ = -(∫ point : BasePoint,
        ∑ derivativeDirection : LorentzianIndex,
          p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection
            (fderiv ℝ (holonomicP286GaugeAuxiliaryCoordinate configuration)
              point (coordinateDirection derivativeDirection))
            (variation point)) := by
      rw [integral_finsetSum Finset.univ fun derivativeDirection _ =>
        rightIntegrable derivativeDirection]
    _ = ∫ point : BasePoint,
        -(∑ derivativeDirection : LorentzianIndex,
          p286GaugeExteriorPrincipalContinuousBilinear derivativeDirection
            (fderiv ℝ (holonomicP286GaugeAuxiliaryCoordinate configuration)
              point (coordinateDirection derivativeDirection))
            (variation point)) := by
      rw [integral_neg]
    _ = ∫ point : BasePoint,
        p286GaugeOneFormThreeFormWedgeCoefficient (variation point)
          (holonomicP286GaugeAuxiliaryExteriorDerivative configuration point) := by
      apply integral_congr_ae
      filter_upwards [] with point
      simpa [p286GaugeAuxiliaryDirectionalDerivative,
        fieldDirectionalDerivative,
        p286GaugeExteriorPrincipalContinuousBilinear,
        holonomicP286GaugeAuxiliaryExteriorDerivative] using
        p286GaugeExteriorPrincipalSum_eq_w13
          (p286GaugeAuxiliaryDirectionalDerivative configuration point)
          (variation point)

/-- Production-facing form: the derivative channel is exactly the actual
primitive P286 curvature response. -/
theorem p286TopologicalGaugeBF_exteriorDerivativeVariation_integral_eq_w13
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (variation : CompactlySupportedSmoothVariation P286GaugeOneForm) :
    (∫ point : BasePoint,
      generatedTwoFormWedgeCoefficient p286CoordinateLiePairing
        (holonomicP286GaugeAuxiliaryCoordinate configuration point)
        (p286GaugeConnectionExteriorDerivativeVariation variation point)) =
      ∫ point : BasePoint,
        p286GaugeOneFormThreeFormWedgeCoefficient (variation point)
          (holonomicP286GaugeAuxiliaryExteriorDerivative configuration point) := by
  rw [← p286TopologicalGaugeBF_exteriorDerivative_integral_eq_w13
    configuration smooth variation]
  apply integral_congr_ae
  filter_upwards [] with point
  rw [p286GaugeOneFormExteriorDerivative_eq_actual variation point]

end

