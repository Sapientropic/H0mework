/-!
# SafeFinal single-current candidate for the S9-C acceptance consumer

The current below is the final actual of the fixed source-generated
Cauchy-safe joint occurrence.  No singleton family or epoch selector remains
at the repaired S9-C boundary.

The constructor stores no regularity, equation, nonzero witness, acceptance,
or future root state.  Smoothness, nondegeneracy, and Lorentz admissibility are
read back from the generated actual.  The dynamic scalar's canonical source
contact is likewise generated by the same occurrence.  Spin--torsion
compatibility is a dependent readout of the joint residual.  Consequently
full S9-C acceptance is reduced to two same-current mathematical obligations.
-/

set_option autoImplicit false
set_option maxHeartbeats 1000000

namespace SaturationMonoid
namespace PhysicsCore
namespace StageNineDiracDualFormNativeFixedP506CartanECConstraintCauchySafeClassicalWorldCandidateFamily

open ProofFreeRicherAnholonomicSource
open StageNineCClassicalWorldAcceptance
open StageNineCartanAffineConnectionActualization
open StageNineDiracDualFormNativeCartanECCauchyTemporalGlobalOperator
open StageNineDiracDualFormNativeCartanConnectionActualization
open StageNineDiracDualFormNativeCauchySafeJointGlobalDevelopment
open StageNineDiracDualFormNativeFixedP506CartanECConstraintCauchySafeGlobalOperator
open StageNineDiracDualFormNativeFixedP506CartanECConstraintCauchySafeDynamicScalarSourceContact
open StageNineDiracDualFormNativeFixedP506CartanECConstraintCauchySafeJointGlobalSmooth
open StageNineDiracDualFormNativeJointResidualCarrier
open StageNineEnrichedProofFreeSource
open StageNineGravityBianchi
open StageNineHolonomicField
open StageNineJointShellStationarity
open StageNineLorentzConnectionVariation

noncomputable section

private abbrev Source : SmoothUnifiedSource := positiveSmoothUnifiedSource

private abbrev Prepared : StageNineHolonomicConfiguration :=
  fixedP506L0CartanECConstraintCauchySafePreparedActual

private abbrev BaseCurrent : StageNineHolonomicConfiguration :=
  cartanECCauchyTemporalBase Source Prepared

private abbrev GlobalP286 : StageNineHolonomicConfiguration :=
  cauchySafeJointGlobalP286Current Source BaseCurrent

/-- The exact configuration emitted by the final leg of the SafeFinal
source occurrence. -/
abbrev SafeFinalClassicalWorldCandidateActual :
    StageNineHolonomicConfiguration :=
  fixedP506L0CartanECConstraintCauchySafeJointGlobalActual

theorem safeFinalClassicalWorldCandidateActual_exactOccurrence :
    SafeFinalClassicalWorldCandidateActual =
      fixedP506L0CartanECConstraintCauchySafeJointGlobalOccurrence.finalActual :=
  rfl

theorem safeFinalClassicalWorldCandidateActual_smooth :
    SafeFinalClassicalWorldCandidateActual.Smooth :=
  fixedP506L0CartanECConstraintCauchySafeJointGlobalActual_smooth

theorem safeFinalClassicalWorldCandidateActual_nondegenerate :
    SafeFinalClassicalWorldCandidateActual.Nondegenerate :=
  fixedP506L0CartanECConstraintCauchySafeJointGlobalActual_nondegenerate

/-- The SafeFinal EC connection is pointwise Lorentz-skew.  The proof reads
the same primitive connection emitted by the occurrence: a source-native
Cartan connection at the origin plus the generated Lorentz-bivector radial
increment. -/
theorem safeFinalClassicalWorldCandidateActual_gravityConnectionLorentzAdmissible :
    GravityConnectionLorentzAdmissible
      SafeFinalClassicalWorldCandidateActual := by
  intro point
  change LorentzSkew
    (cauchySafeJointGlobalECConnectionField Source GlobalP286 point)
  unfold cauchySafeJointGlobalECConnectionField
  apply lorentzSkew_add
  · change LorentzSkew (BaseCurrent.gravityConnection 0)
    change LorentzSkew
      (diracDualFormNativeActionCartanConnectionAt Source Prepared 0)
    exact diracDualFormNativeActionCartanConnectionAt_lorentzSkew
      Source Prepared 0
        (fixedP506L0CartanECConstraintCauchySafePreparedActual_nondegenerate 0)
  · exact lorentzSkewConnectionOfBivectorOneForm_lorentzSkew _

/-- The dynamic scalar's source contact is a readout of this exact generated
current, not a field supplied to the acceptance constructor. -/
theorem safeFinalClassicalWorldCandidateActual_dynamicScalarSourceContact :
    DynamicScalarSourceContactAtOrigin Source
      SafeFinalClassicalWorldCandidateActual :=
  fixedP506L0CartanECConstraintCauchySafeJointGlobalActual_scalar_origin_generatedVacuum

/-- Exact acceptance boundary for the current SafeFinal occurrence.  The
right side contains no sibling actual, old action hash, static scalar field,
or completed acceptance package. -/
theorem safeFinalClassicalWorldCandidateActual_acceptance_iff :
    ClassicalWorldAcceptance Source SafeFinalClassicalWorldCandidateActual ↔
      DiracDualFormNativeJointZeroFiber Source
          SafeFinalClassicalWorldCandidateActual ∧
        SimultaneousSixPhysicalSectorNonzero Source
          SafeFinalClassicalWorldCandidateActual := by
  constructor
  · intro acceptance
    exact
      ⟨acceptance.jointZeroFiber,
        acceptance.simultaneousSixPhysicalSectorNonzero⟩
  · rintro ⟨jointZeroFiber, sixPhysical⟩
    exact
      { smooth := safeFinalClassicalWorldCandidateActual_smooth
        nondegenerate := safeFinalClassicalWorldCandidateActual_nondegenerate
        gravityConnectionLorentzAdmissible :=
          safeFinalClassicalWorldCandidateActual_gravityConnectionLorentzAdmissible
        jointZeroFiber := jointZeroFiber
        dynamicScalarSourceContact :=
          safeFinalClassicalWorldCandidateActual_dynamicScalarSourceContact
        simultaneousSixPhysicalSectorNonzero := sixPhysical }

#print axioms
  safeFinalClassicalWorldCandidateActual_gravityConnectionLorentzAdmissible
#print axioms safeFinalClassicalWorldCandidateActual_acceptance_iff

end
end StageNineDiracDualFormNativeFixedP506CartanECConstraintCauchySafeClassicalWorldCandidateFamily
