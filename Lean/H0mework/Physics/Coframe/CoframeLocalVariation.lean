        formNativeCoframeMatterEulerCovector source point field variation -
        formNativeCoframeConstraintReaction field variation := by
  rw [formNativeCoframeEulerCovector_apply source point field
    nondegenerate variation,
    formNativeCoframeCommonCoreEulerCovector_eq_gauge_add_matter
