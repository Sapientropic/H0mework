/-!
# Local coframe variation of the form-native action candidate

This module varies only the primitive coframe in the current metric-free
form-native action candidate.  The gravity auxiliary, multiplier, curvature,
connections, gauge auxiliaries, scalar, and matter coordinates remain fixed.
Every coframe-derived constitutive or matter operator is recomputed from the
live varied coframe.

The resulting Euler covector is generated by the same local action.  Its
reaction part is proved explicitly to be

`-W22(lambda, D II+(e)[h])`.

The gravity BF leg is coframe-independent; gauge coframe dependence occurs
only through the source-owned `K_e = g^2 * star_e`; scalar and Dirac terms
retain their own live coordinate volume.  No historical `rho(e)` action,
stress receipt, equation, stationarity, fixed actual, branch certificate, or
target covector is consumed.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineFormNativeCoframeLocalVariation

open EmpiricalReferenceScaleCouplingBoundary
open ProofFreeRicherAnholonomicSource
open StageNineBlockwiseConstitutive
open StageNineCartanTangentSimplicityResponse
open StageNineCoframeLocalDifferentiability
open StageNineCoframeVariation
open StageNineEnrichedProofFreeSource
open StageNineFormNativeMotherAction
open StageNineGlobalIntegratedAction
open StageNineTopologicalFourFormPairing
open SU7MotherLieAlgebra
open scoped ContDiff Matrix.Norms.Elementwise

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 1200000

/-! ## The actual coframe-local action and its constraint-free core -/

/-- Evaluate the current form-native candidate after replacing only the
primitive coframe. -/
def formNativeCoframeLocalDensity
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (coframe : LorentzianCoframe) : ℝ :=
  sourceGeneratedFormNativeUnifiedLocalDensity source 0 point
    (withCoframe field coframe)

/-- The same action coefficient with the direct holonomic-constraint channel
omitted.  This retains gravity BF, gauge constitutive, scalar, and matter
terms exactly as written in the current candidate. -/
def formNativeCoframeCommonCoreDensity
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (coframe : LorentzianCoframe) : ℝ :=
  generatedFormNativeUnifiedLocalDensityWithoutConstraintAtBoundary source
    (sourceGeneratedUnifiedCouplings source) 0 point
    (withCoframe field coframe)

/-- The coframe-dependent gauge block of the current candidate.  Its direct
BF subterms are constant; only the three source-owned constitutive operators
depend on the coframe. -/
def formNativeCoframeGaugeDensity
    (source : SmoothUnifiedSource)
    (field : StageNineContinuumPointField)
    (coframe : LorentzianCoframe) : ℝ :=
  generatedFormNativeGaugeDensityAtBoundary
    (sourceGeneratedUnifiedCouplings source) (withCoframe field coframe)

/-- The scalar and Dirac--Yukawa block with its own live volume density. -/
def formNativeCoframeMatterDensity
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (coframe : LorentzianCoframe) : ℝ :=
  generatedFormNativeMatterDensity source 0 point
    (withCoframe field coframe)

theorem formNativeCoframeLocalDensity_eq_constraint_add_commonCore
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (coframe : LorentzianCoframe) :
    formNativeCoframeLocalDensity source point field coframe =
      generatedFormNativeGravityConstraintDensity
          (withCoframe field coframe) +
        formNativeCoframeCommonCoreDensity source point field coframe := by
  unfold formNativeCoframeLocalDensity
    sourceGeneratedFormNativeUnifiedLocalDensity
    generatedFormNativeUnifiedLocalDensityAtBoundary
    formNativeCoframeCommonCoreDensity
    generatedFormNativeUnifiedLocalDensityWithoutConstraintAtBoundary
  ring

theorem formNativeCoframeCommonCoreDensity_eq_gravity_add_gauge_add_matter
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (coframe : LorentzianCoframe) :
    formNativeCoframeCommonCoreDensity source point field coframe =
      generatedFormNativeGravityBFDensity field +
        formNativeCoframeGaugeDensity source field coframe +
        formNativeCoframeMatterDensity source point field coframe := by
  unfold formNativeCoframeCommonCoreDensity
    generatedFormNativeUnifiedLocalDensityWithoutConstraintAtBoundary
    formNativeCoframeGaugeDensity formNativeCoframeMatterDensity
  rfl

/-- The direct gravity BF coefficient does not see a frozen-field coframe
replacement. -/
@[simp] theorem generatedFormNativeGravityBFDensity_withCoframe
    (field : StageNineContinuumPointField)
    (coframe : LorentzianCoframe) :
    generatedFormNativeGravityBFDensity (withCoframe field coframe) =
      generatedFormNativeGravityBFDensity field :=
  rfl

/-! ## Coframe regularity of the direct gauge constitutive block -/

private theorem specialUnitaryFormNativeConstitutive_contDiffAt
    {n : Type*} [Fintype n] [DecidableEq n]
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (coupling : ℝ)
    (auxiliary : Fin 6 → SpecialUnitaryLieMatrix n) :
    ContDiffAt ℝ ∞ (fun candidate : LorentzianCoframe =>
      generatedTwoFormWedgeCoefficient
        (@specialUnitaryLiePairing n _ _) auxiliary
        (liftGaugeTwoFormOperator
          (coupling • coframeGaugeSpacetimeHodgeLinear candidate)
          auxiliary)) coframe := by
  unfold generatedTwoFormWedgeCoefficient liftGaugeTwoFormOperator
  simp_rw [specialUnitaryLiePairing_sum_right,
    coframeSpecialUnitaryLiePairing_smul_right]
  apply ContDiffAt.sum
  intro pair _
  apply ContDiffAt.sum
  intro input _
  exact (scaledCoframeHodgeOperatorCoefficient_contDiffAt
      coframe nondegenerate coupling (twoFormComplement pair) input).mul
    contDiffAt_const

private theorem hyperchargeFormNativeConstitutive_contDiffAt
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (coupling : ℝ)
    (auxiliary : Fin 6 → HyperchargeLieScalar) :
    ContDiffAt ℝ ∞ (fun candidate : LorentzianCoframe =>
      generatedTwoFormWedgeCoefficient hyperchargeLiePairing auxiliary
        (liftGaugeTwoFormOperator
          (coupling • coframeGaugeSpacetimeHodgeLinear candidate)
          auxiliary)) coframe := by
  unfold generatedTwoFormWedgeCoefficient liftGaugeTwoFormOperator
  simp_rw [hyperchargeLiePairing_sum_right,
    coframeHyperchargeLiePairing_smul_right]
  apply ContDiffAt.sum
  intro pair _
  apply ContDiffAt.sum
  intro input _
  exact (scaledCoframeHodgeOperatorCoefficient_contDiffAt
      coframe nondegenerate coupling (twoFormComplement pair) input).mul
    contDiffAt_const

private theorem specialUnitaryFormNativeGaugeSector_contDiffAt
    {n : Type*} [Fintype n] [DecidableEq n]
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (coupling : ℝ)
    (curvature auxiliary : Fin 6 → SpecialUnitaryLieMatrix n) :
    ContDiffAt ℝ ∞ (fun candidate : LorentzianCoframe =>
      generatedFormNativeGaugeSectorBFDensity
        (@specialUnitaryLiePairing n _ _)
        (coupling • coframeGaugeSpacetimeHodgeLinear candidate)
        curvature auxiliary) coframe := by
  unfold generatedFormNativeGaugeSectorBFDensity
  exact contDiffAt_const.sub
    (contDiffAt_const.mul
      (specialUnitaryFormNativeConstitutive_contDiffAt coframe
        nondegenerate coupling auxiliary))

private theorem hyperchargeFormNativeGaugeSector_contDiffAt
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (coupling : ℝ)
    (curvature auxiliary : Fin 6 → HyperchargeLieScalar) :
    ContDiffAt ℝ ∞ (fun candidate : LorentzianCoframe =>
      generatedFormNativeGaugeSectorBFDensity hyperchargeLiePairing
        (coupling • coframeGaugeSpacetimeHodgeLinear candidate)
        curvature auxiliary) coframe := by
  unfold generatedFormNativeGaugeSectorBFDensity
  exact contDiffAt_const.sub
    (contDiffAt_const.mul
      (hyperchargeFormNativeConstitutive_contDiffAt coframe
        nondegenerate coupling auxiliary))

theorem generatedFormNativeGaugeDensityAtBoundary_withCoframe_contDiffAt
    (boundary : EmpiricalReferenceScaleCouplings)
    (field : StageNineContinuumPointField)
    (nondegenerate : Matrix.det field.coframe ≠ 0) :
    ContDiffAt ℝ ∞ (fun candidate : LorentzianCoframe =>
      generatedFormNativeGaugeDensityAtBoundary boundary
        (withCoframe field candidate)) field.coframe := by
  unfold generatedFormNativeGaugeDensityAtBoundary
    gaugeConstitutiveOperatorAtBoundary
  exact ((specialUnitaryFormNativeGaugeSector_contDiffAt field.coframe
      nondegenerate (boundary.strongCouplingSquared : ℝ)
      (fun pair => (field.gaugeCurvature pair).1)
      (fun pair => (field.gaugeAuxiliary pair).1)).add
    (specialUnitaryFormNativeGaugeSector_contDiffAt field.coframe
      nondegenerate (boundary.weakCouplingSquared : ℝ)
      (fun pair => (field.gaugeCurvature pair).2.1)
      (fun pair => (field.gaugeAuxiliary pair).2.1))).add
    (hyperchargeFormNativeGaugeSector_contDiffAt field.coframe
      nondegenerate (boundary.hyperchargeCouplingSquared : ℝ)
      (fun pair => (field.gaugeCurvature pair).2.2)
      (fun pair => (field.gaugeAuxiliary pair).2.2))

/-! ## Local differentiability and action-generated Euler covectors -/

theorem generatedFormNativeGravityConstraintDensity_withCoframe_contDiffAt
    (field : StageNineContinuumPointField) :
    ContDiffAt ℝ ∞ (fun candidate : LorentzianCoframe =>
      generatedFormNativeGravityConstraintDensity
        (withCoframe field candidate)) field.coframe := by
  change ContDiffAt ℝ ∞ (fun candidate : LorentzianCoframe =>
    ∑ internalPair : Fin 6,
      lorentzianTwoFormSign internalPair *
        ∑ pair : Fin 6,
          field.gravitySimplicityMultiplier internalPair pair *
            (field.gravityAuxiliary internalPair
                (twoFormComplement pair) -
              physicalIIPlusBivector candidate internalPair
                (twoFormComplement pair))) field.coframe
  apply ContDiffAt.sum
  intro internalPair _
  apply ContDiffAt.mul contDiffAt_const
  apply ContDiffAt.sum
  intro pair _
  exact contDiffAt_const.mul
    (contDiffAt_const.sub
      ((contDiff_pi.mp
        (contDiff_pi.mp physicalIIPlusBivector_contDiff internalPair)
        (twoFormComplement pair)).contDiffAt))

theorem generatedFormNativeMatterDensity_withCoframe_contDiffAt
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (nondegenerate : Matrix.det field.coframe ≠ 0) :
    ContDiffAt ℝ ∞ (fun candidate : LorentzianCoframe =>
      generatedFormNativeMatterDensity source 0 point
        (withCoframe field candidate)) field.coframe := by
  unfold generatedFormNativeMatterDensity
  simpa only [withCoframe] using
    (generatedVolumeDensity_withCoframe_contDiffAt
    field nondegenerate).mul
      ((generatedScalarKineticDensity_withCoframe_contDiffAt
        source point field nondegenerate).sub contDiffAt_const |>.add
        (generatedContinuumMatterDensity_withCoframe_contDiffAt
          source point field nondegenerate))

theorem formNativeCoframeGaugeDensity_contDiffAt
    (source : SmoothUnifiedSource)
    (field : StageNineContinuumPointField)
    (nondegenerate : Matrix.det field.coframe ≠ 0) :
    ContDiffAt ℝ ∞ (formNativeCoframeGaugeDensity source field)
      field.coframe :=
  generatedFormNativeGaugeDensityAtBoundary_withCoframe_contDiffAt
    (sourceGeneratedUnifiedCouplings source) field nondegenerate

theorem formNativeCoframeMatterDensity_contDiffAt
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (nondegenerate : Matrix.det field.coframe ≠ 0) :
    ContDiffAt ℝ ∞ (formNativeCoframeMatterDensity source point field)
      field.coframe :=
  generatedFormNativeMatterDensity_withCoframe_contDiffAt
    source point field nondegenerate

theorem formNativeCoframeCommonCoreDensity_contDiffAt
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (nondegenerate : Matrix.det field.coframe ≠ 0) :
    ContDiffAt ℝ ∞
      (formNativeCoframeCommonCoreDensity source point field)
      field.coframe := by
  unfold formNativeCoframeCommonCoreDensity
    generatedFormNativeUnifiedLocalDensityWithoutConstraintAtBoundary
  simpa only [generatedFormNativeGravityBFDensity_withCoframe] using
    (contDiffAt_const.add
    (generatedFormNativeGaugeDensityAtBoundary_withCoframe_contDiffAt
      (sourceGeneratedUnifiedCouplings source) field nondegenerate)).add
    (generatedFormNativeMatterDensity_withCoframe_contDiffAt
      source point field nondegenerate)

theorem formNativeCoframeLocalDensity_contDiffAt
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (nondegenerate : Matrix.det field.coframe ≠ 0) :
    ContDiffAt ℝ ∞ (formNativeCoframeLocalDensity source point field)
      field.coframe := by
  rw [show formNativeCoframeLocalDensity source point field =
      fun coframe =>
        generatedFormNativeGravityConstraintDensity
            (withCoframe field coframe) +
          formNativeCoframeCommonCoreDensity source point field coframe by
    funext coframe
    exact formNativeCoframeLocalDensity_eq_constraint_add_commonCore
      source point field coframe]
  exact (generatedFormNativeGravityConstraintDensity_withCoframe_contDiffAt
    field).add (formNativeCoframeCommonCoreDensity_contDiffAt
      source point field nondegenerate)

def formNativeCoframeEulerCovector
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField) :
    LorentzianCoframe →L[ℝ] ℝ :=
  fderiv ℝ (formNativeCoframeLocalDensity source point field) field.coframe

def formNativeCoframeCommonCoreEulerCovector
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField) :
    LorentzianCoframe →L[ℝ] ℝ :=
  fderiv ℝ (formNativeCoframeCommonCoreDensity source point field)
    field.coframe

/-- Gauge constitutive coframe covector generated from the corrected direct
wedge density. -/
def formNativeCoframeGaugeEulerCovector
    (source : SmoothUnifiedSource)
    (field : StageNineContinuumPointField) :
    LorentzianCoframe →L[ℝ] ℝ :=
  fderiv ℝ (formNativeCoframeGaugeDensity source field) field.coframe

/-- Live-volume plus inverse-frame scalar/Dirac coframe covector generated
from the current matter block. -/
def formNativeCoframeMatterEulerCovector
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField) :
    LorentzianCoframe →L[ℝ] ℝ :=
  fderiv ℝ (formNativeCoframeMatterDensity source point field)
