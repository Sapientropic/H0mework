theorem formNativeCoframeLocalDensity_hasFDerivAt
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (nondegenerate : Matrix.det field.coframe ≠ 0) :
    HasFDerivAt (formNativeCoframeLocalDensity source point field)
      (formNativeCoframeEulerCovector source point field) field.coframe :=
  ((formNativeCoframeLocalDensity_contDiffAt source point field
    nondegenerate).differentiableAt (by simp)).hasFDerivAt

theorem formNativeCoframeCommonCoreDensity_hasFDerivAt
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (nondegenerate : Matrix.det field.coframe ≠ 0) :
    HasFDerivAt (formNativeCoframeCommonCoreDensity source point field)
      (formNativeCoframeCommonCoreEulerCovector source point field)
      field.coframe :=
  ((formNativeCoframeCommonCoreDensity_contDiffAt source point field
    nondegenerate).differentiableAt (by simp)).hasFDerivAt

theorem formNativeCoframeGaugeDensity_hasFDerivAt
    (source : SmoothUnifiedSource)
    (field : StageNineContinuumPointField)
    (nondegenerate : Matrix.det field.coframe ≠ 0) :
    HasFDerivAt (formNativeCoframeGaugeDensity source field)
      (formNativeCoframeGaugeEulerCovector source field) field.coframe :=
  ((formNativeCoframeGaugeDensity_contDiffAt source field
    nondegenerate).differentiableAt (by simp)).hasFDerivAt

theorem formNativeCoframeMatterDensity_hasFDerivAt
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (nondegenerate : Matrix.det field.coframe ≠ 0) :
    HasFDerivAt (formNativeCoframeMatterDensity source point field)
      (formNativeCoframeMatterEulerCovector source point field)
      field.coframe :=
  ((formNativeCoframeMatterDensity_contDiffAt source point field
    nondegenerate).differentiableAt (by simp)).hasFDerivAt

/-- The constraint-free coframe derivative contains no direct gravity BF
term.  It is exactly gauge constitutive plus live matter response. -/
theorem formNativeCoframeCommonCoreEulerCovector_eq_gauge_add_matter
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (nondegenerate : Matrix.det field.coframe ≠ 0) :
    formNativeCoframeCommonCoreEulerCovector source point field =
      formNativeCoframeGaugeEulerCovector source field +
        formNativeCoframeMatterEulerCovector source point field := by
  have gravityGaugeDerivative :=
    (formNativeCoframeGaugeDensity_hasFDerivAt source field
      nondegenerate).const_add
      (generatedFormNativeGravityBFDensity field)
  have splitDerivative := gravityGaugeDerivative.add
    (formNativeCoframeMatterDensity_hasFDerivAt source point field
      nondegenerate)
  have sameDerivative : HasFDerivAt
      (formNativeCoframeCommonCoreDensity source point field)
      (formNativeCoframeGaugeEulerCovector source field +
        formNativeCoframeMatterEulerCovector source point field)
      field.coframe := by
    rw [show formNativeCoframeCommonCoreDensity source point field =
      fun coframe =>
        generatedFormNativeGravityBFDensity field +
          formNativeCoframeGaugeDensity source field coframe +
          formNativeCoframeMatterDensity source point field coframe by
      funext coframe
      exact
        formNativeCoframeCommonCoreDensity_eq_gravity_add_gauge_add_matter
          source point field coframe]
    change HasFDerivAt
      ((fun _ : LorentzianCoframe =>
          generatedFormNativeGravityBFDensity field) +
        formNativeCoframeGaugeDensity source field +
        formNativeCoframeMatterDensity source point field)
      (formNativeCoframeGaugeEulerCovector source field +
        formNativeCoframeMatterEulerCovector source point field)
      field.coframe
    exact splitDerivative
  exact (formNativeCoframeCommonCoreDensity_hasFDerivAt
    source point field nondegenerate).unique sameDerivative

/-! ## Exact direct-reaction contribution -/

def formNativeCoframeConstraintReaction
    (field : StageNineContinuumPointField)
    (variation : LorentzianCoframe) : ℝ :=
  gravityTopologicalWedgeCoefficient field.gravitySimplicityMultiplier
    (physicalIIPlusCoframeTangent field.coframe variation)

theorem generatedFormNativeGravityConstraintDensity_coframe_affine
    (field : StageNineContinuumPointField)
    (variation : LorentzianCoframe) (parameter : ℝ) :
    generatedFormNativeGravityConstraintDensity
        (withCoframe field
          (field.coframe + parameter • variation)) =
      generatedFormNativeGravityConstraintDensity field -
        parameter * formNativeCoframeConstraintReaction field variation -
        parameter ^ 2 *
          gravityTopologicalWedgeCoefficient
            field.gravitySimplicityMultiplier
            (physicalIIPlusBivector variation) := by
  have expansion := physicalIIPlusBivector_affine_expansion
    field.coframe variation parameter
  have residualExpansion :
      field.gravityAuxiliary -
          physicalIIPlusBivector
            (field.coframe + parameter • variation) =
        (field.gravityAuxiliary -
            physicalIIPlusBivector field.coframe) +
          (-parameter) •
            physicalIIPlusCoframeTangent field.coframe variation +
          (-(parameter ^ 2)) • physicalIIPlusBivector variation := by
    rw [expansion]
    module
  unfold generatedFormNativeGravityConstraintDensity
    formNativeCoframeConstraintReaction generatedGravitySimplicityResidual
  change gravityTopologicalWedgeCoefficient
      field.gravitySimplicityMultiplier
      (field.gravityAuxiliary -
        physicalIIPlusBivector
          (field.coframe + parameter • variation)) = _
  rw [residualExpansion,
    gravityTopologicalWedgeCoefficient_add_right,
    gravityTopologicalWedgeCoefficient_add_right,
    gravityTopologicalWedgeCoefficient_smul_right,
    gravityTopologicalWedgeCoefficient_smul_right]
  ring

theorem generatedFormNativeGravityConstraintDensity_coframe_path_hasDerivAt
    (field : StageNineContinuumPointField)
    (variation : LorentzianCoframe) :
    HasDerivAt
      (fun parameter : ℝ =>
        generatedFormNativeGravityConstraintDensity
          (withCoframe field
            (field.coframe + parameter • variation)))
      (-formNativeCoframeConstraintReaction field variation) 0 := by
  let reaction := formNativeCoframeConstraintReaction field variation
  let quadratic := gravityTopologicalWedgeCoefficient
    field.gravitySimplicityMultiplier (physicalIIPlusBivector variation)
  have formula :
      (fun parameter : ℝ =>
        generatedFormNativeGravityConstraintDensity
          (withCoframe field
            (field.coframe + parameter • variation))) =
        fun parameter =>
          generatedFormNativeGravityConstraintDensity field -
            parameter * reaction - parameter ^ 2 * quadratic := by
    funext parameter
    exact generatedFormNativeGravityConstraintDensity_coframe_affine
      field variation parameter
  rw [formula]
  have linearDerivative := (hasDerivAt_id (x := (0 : ℝ))).mul_const reaction
  have quadraticDerivative :=
    ((hasDerivAt_id (x := (0 : ℝ))).pow 2).mul_const quadratic
  have polynomialDerivative :=
    ((hasDerivAt_const (x := (0 : ℝ))
      (c := generatedFormNativeGravityConstraintDensity field)).sub
      linearDerivative).sub quadraticDerivative
  have derivativeValue :
      (0 : ℝ) - 1 * reaction -
          (2 : ℝ) * (0 : ℝ) ^ (2 - 1) * 1 * quadratic =
        -formNativeCoframeConstraintReaction field variation := by
    simp [reaction]
  convert polynomialDerivative.congr_deriv derivativeValue using 1 <;>
    rfl

theorem formNativeCoframeLocalDensity_path_hasDerivAt
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (nondegenerate : Matrix.det field.coframe ≠ 0)
    (variation : LorentzianCoframe) :
    HasDerivAt
      (fun parameter : ℝ =>
        formNativeCoframeLocalDensity source point field
          (field.coframe + parameter • variation))
      (formNativeCoframeEulerCovector source point field variation) 0 := by
  have identityDerivative := hasDerivAt_id (x := (0 : ℝ))
  have variationDerivative := identityDerivative.smul_const variation
  have variationDerivativeValue : (1 : ℝ) • variation = variation := by
    simp
  have variationDerivativeAtZero :=
    variationDerivative.congr_deriv variationDerivativeValue
  have pathDerivative := variationDerivativeAtZero.const_add field.coframe
  have pointEquality :
      field.coframe = field.coframe + (0 : ℝ) • variation := by
    simp
  exact (formNativeCoframeLocalDensity_hasFDerivAt source point field
    nondegenerate).comp_hasDerivAt_of_eq 0 pathDerivative pointEquality

theorem formNativeCoframeCommonCoreDensity_path_hasDerivAt
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (nondegenerate : Matrix.det field.coframe ≠ 0)
    (variation : LorentzianCoframe) :
    HasDerivAt
      (fun parameter : ℝ =>
        formNativeCoframeCommonCoreDensity source point field
          (field.coframe + parameter • variation))
      (formNativeCoframeCommonCoreEulerCovector source point field variation)
      0 := by
  have identityDerivative := hasDerivAt_id (x := (0 : ℝ))
  have variationDerivative := identityDerivative.smul_const variation
  have variationDerivativeValue : (1 : ℝ) • variation = variation := by
    simp
  have variationDerivativeAtZero :=
    variationDerivative.congr_deriv variationDerivativeValue
  have pathDerivative := variationDerivativeAtZero.const_add field.coframe
  have pointEquality :
      field.coframe = field.coframe + (0 : ℝ) • variation := by
    simp
  exact (formNativeCoframeCommonCoreDensity_hasFDerivAt source point field
    nondegenerate).comp_hasDerivAt_of_eq 0 pathDerivative pointEquality

/-- Exact coframe Euler split generated by the current action candidate.
The direct constraint reaction is exposed off shell; no simplicity or other
Euler equation is required. -/
theorem formNativeCoframeEulerCovector_apply
    (source : SmoothUnifiedSource) (point : BasePoint)
    (field : StageNineContinuumPointField)
    (nondegenerate : Matrix.det field.coframe ≠ 0)
    (variation : LorentzianCoframe) :
    formNativeCoframeEulerCovector source point field variation =
      formNativeCoframeCommonCoreEulerCovector source point field variation -
        formNativeCoframeConstraintReaction field variation := by
  have totalDerivative := formNativeCoframeLocalDensity_path_hasDerivAt
    source point field nondegenerate variation
  have constraintDerivative :=
    generatedFormNativeGravityConstraintDensity_coframe_path_hasDerivAt
      field variation
  have commonDerivative :=
    formNativeCoframeCommonCoreDensity_path_hasDerivAt
      source point field nondegenerate variation
  have splitDerivative := constraintDerivative.add commonDerivative
  have sameDerivative : HasDerivAt
      (fun parameter : ℝ =>
        formNativeCoframeLocalDensity source point field
          (field.coframe + parameter • variation))
      (-formNativeCoframeConstraintReaction field variation +
        formNativeCoframeCommonCoreEulerCovector source point field variation)
      0 := by
    rw [show (fun parameter : ℝ =>
        formNativeCoframeLocalDensity source point field
          (field.coframe + parameter • variation)) =
      fun parameter =>
        generatedFormNativeGravityConstraintDensity
            (withCoframe field
              (field.coframe + parameter • variation)) +
          formNativeCoframeCommonCoreDensity source point field
            (field.coframe + parameter • variation) by
      funext parameter
      exact formNativeCoframeLocalDensity_eq_constraint_add_commonCore
        source point field (field.coframe + parameter • variation)]
    exact splitDerivative
  have derivativeEquality := totalDerivative.unique sameDerivative
  linarith

/-- Fully routed local coframe response of the current candidate: gauge
constitutive response plus live matter response minus the direct constraint
reaction.  This is still a local action derivative, not an equation or a
stationary actual. -/
theorem formNativeCoframeEulerCovector_apply_eq_gauge_add_matter_sub_reaction
    (source : SmoothUnifiedSource) (point : BasePoint)
