import H0mework.Physics.Coframe.CoframeSectorStress
import H0mework.Physics.Coframe.CoframeEquation

/-!
# S9-C3f5: coframe equation as an actual sector-stress balance

The coframe Euler covector generated by the action is the sum of the complete
gravity, gauge, scalar, and exterior-matter sector derivatives.  This module
uses that off-shell split to expose the exact on-shell balance.

The conclusion is a sum law.  It does not claim that the exterior-matter
stress or any other individual sector vanishes.  In particular, the matter
sector retains its Yukawa volume-stress contribution through current action
ownership.
-/

namespace SaturationMonoid.PhysicsCore.StageNineCoframeSectorBalance

open ProofFreeRicherAnholonomicSource
open StageNineEnrichedProofFreeSource
open StageNineGlobalIntegratedAction
open StageNineHolonomicField
open StageNineCoframeLocalDifferentiability
open StageNineCoframeSectorStress

noncomputable section

/-- The exact four-sector coframe balance read from the generated action. -/
def CanonicalCoframeSectorBalance
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration) : Prop :=
  ∀ point : BasePoint,
    coframeGravitySectorStressCovector
          (toContinuumPointField configuration point) +
        coframeGaugeSectorStressCovector source
          (toContinuumPointField configuration point) +
        coframeScalarSectorStressCovector source point
          (toContinuumPointField configuration point) +
        coframeMatterSectorStressCovector source point
          (toContinuumPointField configuration point) = 0

theorem canonicalCoframePointwiseEquation_implies_sectorBalance
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (nondegenerate : configuration.Nondegenerate)
    (equation :
      StageNineCoframePointwiseEquation.CanonicalCoframePointwiseEquation
        source configuration) :
    CanonicalCoframeSectorBalance source configuration := by
  intro point
  have pointEquation := equation point
  rw [coframeLocalStressCovector_eq_sector_sum source point
    (toContinuumPointField configuration point)] at pointEquation
  · exact pointEquation
  · simpa [toContinuumPointField] using nondegenerate point

/-- On shell, the exterior-matter stress is balanced by the negative sum of
the gravity, gauge, and scalar responses; it is not forced to vanish. -/
theorem canonicalCoframeSectorBalance_implies_matter_eq_negative_response
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (balance : CanonicalCoframeSectorBalance source configuration)
    (point : BasePoint) :
    coframeMatterSectorStressCovector source point
        (toContinuumPointField configuration point) =
      -(coframeGravitySectorStressCovector
            (toContinuumPointField configuration point) +
          coframeGaugeSectorStressCovector source
            (toContinuumPointField configuration point) +
          coframeScalarSectorStressCovector source point
            (toContinuumPointField configuration point)) := by
  have pointBalance := balance point
  rw [eq_neg_iff_add_eq_zero]
  rw [← pointBalance]
  abel

/-- Root producer: actual coframe action stationarity generates the complete
four-sector stress balance through the existing weak and pointwise equations. -/
theorem canonicalCoframeActionStationaryF_generates_sectorBalance
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate)
    (densityIntegrable : HolonomicLocalDensityIntegrable source 0 configuration)
    (stationary :
      StageNineCoframeIntegratedVariation.CanonicalCoframeActionStationaryF
        source configuration) :
    CanonicalCoframeSectorBalance source configuration := by
  apply canonicalCoframePointwiseEquation_implies_sectorBalance source
    configuration nondegenerate
  exact StageNineCoframeEquation.canonicalCoframeActionStationaryF_implies_pointwiseEquation
    source configuration smooth nondegenerate densityIntegrable stationary

/-- Root response readout, retaining all three balancing sectors explicitly. -/
theorem canonicalCoframeActionStationaryF_generates_matter_eq_negative_response
    (source : SmoothUnifiedSource)
    (configuration : StageNineHolonomicConfiguration)
    (smooth : configuration.Smooth)
    (nondegenerate : configuration.Nondegenerate)
    (densityIntegrable : HolonomicLocalDensityIntegrable source 0 configuration)
    (stationary :
      StageNineCoframeIntegratedVariation.CanonicalCoframeActionStationaryF
        source configuration)
    (point : BasePoint) :
    coframeMatterSectorStressCovector source point
        (toContinuumPointField configuration point) =
      -(coframeGravitySectorStressCovector
            (toContinuumPointField configuration point) +
          coframeGaugeSectorStressCovector source
            (toContinuumPointField configuration point) +
          coframeScalarSectorStressCovector source point
            (toContinuumPointField configuration point)) := by
  apply canonicalCoframeSectorBalance_implies_matter_eq_negative_response
    source configuration
  exact canonicalCoframeActionStationaryF_generates_sectorBalance source
    configuration smooth nondegenerate densityIntegrable stationary

end

end SaturationMonoid.PhysicsCore.StageNineCoframeSectorBalance
