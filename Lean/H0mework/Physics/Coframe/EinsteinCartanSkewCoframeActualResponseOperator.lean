def simpleBPairingTangent
    (coordinates : Fin 6 → ℝ) (direction : PhysicalBivector) : ℝ :=
  ∑ internalPair : Fin 6,
    lorentzianTwoFormSign internalPair *
      ∑ spacetimePair : Fin 6,
        lorentzianTwoFormSign spacetimePair *
          (simpleBFirstTransformTangent coordinates
              internalPair spacetimePair *
            lorentzianCoframeHodge (direction internalPair)
              spacetimePair +
          physicalIIPlusBivector (1 : LorentzianCoframe)
              internalPair spacetimePair *
            hodgeCoframeWedgeTangentLinear coordinates
              (direction internalPair) spacetimePair)

theorem skewCoframeAxisSimpleBPairing_hasDerivAt
    (coordinates : Fin 6 → ℝ) (direction : PhysicalBivector) :
    HasDerivAt
        (fun parameter =>
          gravityAuxiliaryHodgePairingPolynomial
            (skewCoframeAxis coordinates parameter)
            (physicalIIPlusBivector
              (skewCoframeAxis coordinates parameter))
            direction)
        (simpleBPairingTangent coordinates direction)
        0 := by
  unfold gravityAuxiliaryHodgePairingPolynomial
    simpleBPairingTangent
  change HasDerivAt
    (∑ internalPair : Fin 6, fun parameter =>
      lorentzianTwoFormSign internalPair *
        ∑ spacetimePair : Fin 6,
          lorentzianTwoFormSign spacetimePair *
            coframeTwoFormLinear
                (skewCoframeAxis coordinates parameter)
                (physicalIIPlusBivector
                  (skewCoframeAxis coordinates parameter)
                  internalPair)
                spacetimePair *
              lorentzianCoframeHodge
                (coframeTwoFormLinear
                  (skewCoframeAxis coordinates parameter)
                  (direction internalPair))
                spacetimePair)
    (∑ internalPair : Fin 6,
      lorentzianTwoFormSign internalPair *
        ∑ spacetimePair : Fin 6,
          lorentzianTwoFormSign spacetimePair *
            (simpleBFirstTransformTangent coordinates
                internalPair spacetimePair *
              lorentzianCoframeHodge (direction internalPair)
                spacetimePair +
            physicalIIPlusBivector (1 : LorentzianCoframe)
                internalPair spacetimePair *
              hodgeCoframeWedgeTangentLinear coordinates
                (direction internalPair) spacetimePair))
    0
  apply HasDerivAt.sum
  intro internalPair _
  apply HasDerivAt.const_mul
  change HasDerivAt
    (∑ spacetimePair : Fin 6, fun parameter =>
      lorentzianTwoFormSign spacetimePair *
        coframeTwoFormLinear
            (skewCoframeAxis coordinates parameter)
            (physicalIIPlusBivector
              (skewCoframeAxis coordinates parameter)
              internalPair)
            spacetimePair *
          lorentzianCoframeHodge
            (coframeTwoFormLinear
              (skewCoframeAxis coordinates parameter)
              (direction internalPair))
            spacetimePair)
    (∑ spacetimePair : Fin 6,
      lorentzianTwoFormSign spacetimePair *
        (simpleBFirstTransformTangent coordinates
            internalPair spacetimePair *
          lorentzianCoframeHodge (direction internalPair)
            spacetimePair +
        physicalIIPlusBivector (1 : LorentzianCoframe)
            internalPair spacetimePair *
          hodgeCoframeWedgeTangentLinear coordinates
            (direction internalPair) spacetimePair))
    0
  apply HasDerivAt.sum
  intro spacetimePair _
  have productDerivative :=
    (skewCoframeAxisSimpleBFirstTransform_hasDerivAt coordinates
        internalPair spacetimePair).mul
      (skewCoframeAxisHodgeSecondTransform_hasDerivAt coordinates
        (direction internalPair) spacetimePair)
  simpa [skewCoframeAxis, coframeTwoFormLinear_one, mul_assoc] using
    productDerivative.const_mul (lorentzianTwoFormSign spacetimePair)

theorem skewCoframeAxis_det_hasDerivAt_zero
    (coordinates : Fin 6 → ℝ) :
    HasDerivAt
        (fun parameter =>
          Matrix.det (skewCoframeAxis coordinates parameter))
        0 0 := by
  rw [show
    (fun parameter =>
      Matrix.det (skewCoframeAxis coordinates parameter)) =
      fun parameter =>
        1 + parameter ^ 2 * skewCoframeAxisNormSq coordinates +
          parameter ^ 4 * skewCoframeAxisPfaffian coordinates ^ 2 by
    funext parameter
    exact skewCoframeAxis_det coordinates parameter]
  have quadratic :=
    ((hasDerivAt_id (0 : ℝ)).pow 2).mul_const
      (skewCoframeAxisNormSq coordinates)
  have quartic :=
    ((hasDerivAt_id (0 : ℝ)).pow 4).mul_const
      (skewCoframeAxisPfaffian coordinates ^ 2)
  simpa [id, add_assoc] using (quadratic.add quartic).const_add 1

theorem skewCoframeAxis_abs_det_hasDerivAt_zero
    (coordinates : Fin 6 → ℝ) :
    HasDerivAt
        (fun parameter =>
          |Matrix.det (skewCoframeAxis coordinates parameter)|)
        0 0 := by
  have determinantPositive :
      0 < Matrix.det (skewCoframeAxis coordinates 0) :=
    skewCoframeAxis_det_pos coordinates 0
  simpa [Function.comp_def] using
    (hasDerivAt_abs_pos determinantPositive).comp 0
      (skewCoframeAxis_det_hasDerivAt_zero coordinates)

