  ]

theorem einsteinCartanSkewCoframeCoordinates_closedForm_leftInverse
    (jet : LorentzBivectorOneForm) :
    einsteinCartanSkewCoframeCoordinates
        (skewCoframeDivergenceResponseCoordinates jet) = jet := by
  funext derivativeDirection internalPair
  fin_cases derivativeDirection <;> fin_cases internalPair <;>
    simp [einsteinCartanSkewCoframeCoordinates,
      skewCoframeDivergenceResponseCoordinates] <;> ring

theorem einsteinCartanSkewCoframeCoordinates_closedForm_rightInverse
    (spin : LorentzBivectorOneForm) :
    skewCoframeDivergenceResponseCoordinates
        (einsteinCartanSkewCoframeCoordinates spin) = spin := by
  funext formDirection internalPair
  fin_cases formDirection <;> fin_cases internalPair <;>
    simp [einsteinCartanSkewCoframeCoordinates,
      skewCoframeDivergenceResponseCoordinates] <;> ring

theorem einsteinCartanSkewCoframeCoordinates_leftInverse
    (jet : LorentzBivectorOneForm) :
    einsteinCartanSkewCoframeCoordinates
        (skewCoframeActualBFDivergenceCoordinates jet) = jet := by
  rw [skewCoframeActualBFDivergenceCoordinates_eq_closedForm]
  exact einsteinCartanSkewCoframeCoordinates_closedForm_leftInverse jet

theorem einsteinCartanSkewCoframeCoordinates_rightInverse
    (spin : LorentzBivectorOneForm) :
    skewCoframeActualBFDivergenceCoordinates
        (einsteinCartanSkewCoframeCoordinates spin) = spin := by
  rw [skewCoframeActualBFDivergenceCoordinates_eq_closedForm]
  exact einsteinCartanSkewCoframeCoordinates_closedForm_rightInverse spin

theorem skewCoframeActualBFDivergenceCoordinates_bijective :
    Function.Bijective skewCoframeActualBFDivergenceCoordinates := by
  constructor
  · intro first second equality
    have lifted := congrArg einsteinCartanSkewCoframeCoordinates equality
    simpa only [einsteinCartanSkewCoframeCoordinates_leftInverse] using lifted
  · intro spin
    exact ⟨einsteinCartanSkewCoframeCoordinates spin,
      einsteinCartanSkewCoframeCoordinates_rightInverse spin⟩

end

