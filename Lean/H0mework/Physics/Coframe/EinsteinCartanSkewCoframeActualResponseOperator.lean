  · change HasDerivAt
      (-fun parameter =>
        coframeTwoFormLinear
          (skewCoframeAxis coordinates parameter) form 2)
      (-coframeWedgeTangentLinear
        (loweredLorentzBivectorMatrix coordinates) form 2) 0
