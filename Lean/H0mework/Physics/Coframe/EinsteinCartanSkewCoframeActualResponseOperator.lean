theorem skewCoframeAxisHodgeSecondTransform_hasDerivAt
    (coordinates : Fin 6 → ℝ)
    (form : GaugeTwoForm) (spacetimePair : Fin 6) :
    HasDerivAt
        (fun parameter =>
          lorentzianCoframeHodge
              (coframeTwoFormLinear
                (skewCoframeAxis coordinates parameter) form)
            spacetimePair)
        (hodgeCoframeWedgeTangentLinear coordinates form
          spacetimePair)
        0 := by
  fin_cases spacetimePair
  · simpa [hodgeCoframeWedgeTangentLinear,
      lorentzianCoframeHodge] using
      skewCoframeAxisCoframeTwoFormLinear_fixed_hasDerivAt coordinates form 3
  · simpa [hodgeCoframeWedgeTangentLinear,
      lorentzianCoframeHodge] using
      skewCoframeAxisCoframeTwoFormLinear_fixed_hasDerivAt coordinates form 4
  · simpa [hodgeCoframeWedgeTangentLinear,
      lorentzianCoframeHodge] using
      skewCoframeAxisCoframeTwoFormLinear_fixed_hasDerivAt coordinates form 5
  · change HasDerivAt
      (-fun parameter =>
        coframeTwoFormLinear
          (skewCoframeAxis coordinates parameter) form 0)
      (-coframeWedgeTangentLinear
        (loweredLorentzBivectorMatrix coordinates) form 0) 0
    exact
      (skewCoframeAxisCoframeTwoFormLinear_fixed_hasDerivAt
        coordinates form 0).neg
  · change HasDerivAt
      (-fun parameter =>
        coframeTwoFormLinear
          (skewCoframeAxis coordinates parameter) form 1)
      (-coframeWedgeTangentLinear
        (loweredLorentzBivectorMatrix coordinates) form 1) 0
    exact
      (skewCoframeAxisCoframeTwoFormLinear_fixed_hasDerivAt
