def skewCoframePointCoordinates
    (jet : LorentzBivectorOneForm) (point : BasePoint) : Fin 6 → ℝ :=
  fun internalPair =>
    ∑ derivativeDirection : LorentzianIndex,
      point derivativeDirection * jet derivativeDirection internalPair

theorem skewCoframeActual_coframe_eq_pointCoordinates
    (jet : LorentzBivectorOneForm) (point : BasePoint) :
    (skewCoframeActual jet).coframe point =
      skewCoframeAxis (skewCoframePointCoordinates jet point) 1 := by
  ext internal coordinate
  simp [skewCoframeActual, skewCoframeField, skewCoframeJet,
    affineCoframeFieldOfJet, coframeJetAffineComponentLinear,
    coframeBaseCoordinate, skewCoframeDerivative,
    skewCoframeAxis, skewCoframePointCoordinates,
    loweredLorentzBivectorMatrix, Finset.mul_sum,
    Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro derivativeDirection _
  apply Finset.sum_congr rfl
  intro internalPair _
  ring

theorem skewCoframeActual_nondegenerate
    (jet : LorentzBivectorOneForm) :
    (skewCoframeActual jet).Nondegenerate := by
  intro point
  rw [skewCoframeActual_coframe_eq_pointCoordinates]
  exact ne_of_gt
    (skewCoframeAxis_det_pos
      (skewCoframePointCoordinates jet point) 1)

def skewCoframeAxisMomentum
    (jet : LorentzBivectorOneForm)
    (derivativeDirection : LorentzianIndex)
    (direction : LorentzBivectorOneForm)
    (parameter : ℝ) : ℝ :=
  lorentzConnectionBFDifferentialMomentum
    (skewCoframeActual jet)
    (lorentzConnectionExteriorDerivativeDirection derivativeDirection
      direction)
    (parameter • coordinateDirection derivativeDirection)

theorem skewCoframeAxisMomentum_eq
    (jet : LorentzBivectorOneForm)
    (derivativeDirection : LorentzianIndex)
    (direction : LorentzBivectorOneForm)
    (parameter : ℝ) :
    skewCoframeAxisMomentum jet derivativeDirection direction
        parameter =
      skewCoframeAxisSimpleBMomentum (jet derivativeDirection)
        (lorentzConnectionExteriorDerivativeDirection derivativeDirection
          direction)
        parameter := by
  unfold skewCoframeAxisMomentum skewCoframeAxisSimpleBMomentum
    lorentzConnectionBFDifferentialMomentum generatedVolumeDensity
  change
    |Matrix.det
        ((skewCoframeActual jet).coframe
          (parameter • coordinateDirection derivativeDirection))| *
      gravityAuxiliaryHodgePairingPolynomial
        ((skewCoframeActual jet).coframe
          (parameter • coordinateDirection derivativeDirection))
        ((skewCoframeActual jet).gravityAuxiliary
          (parameter • coordinateDirection derivativeDirection))
        (lorentzConnectionExteriorDerivativeDirection derivativeDirection
          direction) =
      _
  rw [show
    (skewCoframeActual jet).gravityAuxiliary
        (parameter • coordinateDirection derivativeDirection) =
      physicalIIPlusBivector
        ((skewCoframeActual jet).coframe
          (parameter • coordinateDirection derivativeDirection)) by
    rfl]
  rw [skewCoframeActual_axis_eq]

theorem skewCoframeAxisMomentum_deriv_zero
    (jet : LorentzBivectorOneForm)
    (derivativeDirection : LorentzianIndex)
    (direction : LorentzBivectorOneForm) :
    deriv
        (skewCoframeAxisMomentum jet derivativeDirection direction)
        0 =
      simpleBPairingTangent (jet derivativeDirection)
        (lorentzConnectionExteriorDerivativeDirection derivativeDirection
          direction) := by
  rw [show
    skewCoframeAxisMomentum jet derivativeDirection direction =
      skewCoframeAxisSimpleBMomentum (jet derivativeDirection)
        (lorentzConnectionExteriorDerivativeDirection derivativeDirection
          direction) by
    funext parameter
    exact skewCoframeAxisMomentum_eq jet derivativeDirection direction
      parameter]
  exact
    (skewCoframeAxisSimpleBMomentum_hasDerivAt_zero
      (jet derivativeDirection)
      (lorentzConnectionExteriorDerivativeDirection derivativeDirection
        direction)).deriv

private theorem fieldDirectionalDerivative_eq_skewAxisDeriv
    (field : BasePoint → ℝ)
    (direction : LorentzianIndex)
    (differentiable : DifferentiableAt ℝ field 0) :
    fieldDirectionalDerivative field 0 direction =
      deriv (fun parameter : ℝ =>
        field (parameter • coordinateDirection direction)) 0 := by
  have lineDerivative :
      HasDerivAt (fun parameter : ℝ =>
        parameter • coordinateDirection direction)
        (coordinateDirection direction) 0 := by
    simpa using
      ((hasDerivAt_id (0 : ℝ)).smul_const
        (coordinateDirection direction))
  have fieldDerivative :
      HasFDerivAt field (fderiv ℝ field 0)
        ((0 : ℝ) • coordinateDirection direction) := by
    simpa using differentiable.hasFDerivAt
  have axisDerivative :=
    fieldDerivative.comp_hasDerivAt (0 : ℝ) lineDerivative
  unfold fieldDirectionalDerivative
  simpa [Function.comp_def] using axisDerivative.deriv.symm

theorem skewCoframeMomentum_directionalDerivative_origin
    (jet : LorentzBivectorOneForm)
    (derivativeDirection : LorentzianIndex)
    (direction : LorentzBivectorOneForm) :
    fieldDirectionalDerivative
        (lorentzConnectionBFDifferentialMomentum
          (skewCoframeActual jet)
          (lorentzConnectionExteriorDerivativeDirection derivativeDirection
            direction))
        0 derivativeDirection =
      simpleBPairingTangent (jet derivativeDirection)
        (lorentzConnectionExteriorDerivativeDirection derivativeDirection
          direction) := by
  rw [fieldDirectionalDerivative_eq_skewAxisDeriv]
  · exact skewCoframeAxisMomentum_deriv_zero
      jet derivativeDirection direction
  · exact
      ((lorentzConnectionBFDifferentialMomentum_contDiff
          (skewCoframeActual jet)
          (skewCoframeActual_smooth jet)
          (skewCoframeActual_nondegenerate jet)
          (lorentzConnectionExteriorDerivativeDirection derivativeDirection
            direction)).differentiable (by simp)).differentiableAt

def simpleBPairingTangentNormalForm
    (jet direction : LorentzBivectorOneForm) :
    LorentzianIndex → ℝ :=
  ![
    jet 0 0 * (-direction 2 5 + direction 3 4) +
      jet 0 1 * (direction 1 5 - direction 3 3) +
      jet 0 2 * (-direction 1 4 + direction 2 3) +
      jet 0 3 * (-direction 2 2 + direction 3 1) +
      jet 0 4 * (direction 1 2 - direction 3 0) +
      jet 0 5 * (-direction 1 1 + direction 2 0),
    jet 1 0 * (direction 2 1 + direction 3 2) +
      jet 1 1 * (-direction 0 5 - direction 2 0) +
      jet 1 2 * (direction 0 4 - direction 3 0) +
      jet 1 3 * (direction 2 4 + direction 3 5) +
      jet 1 4 * (-direction 0 2 - direction 2 3) +
      jet 1 5 * (direction 0 1 - direction 3 3),
    jet 2 0 * (direction 0 5 - direction 1 1) +
      jet 2 1 * (direction 1 0 + direction 3 2) +
      jet 2 2 * (-direction 0 3 - direction 3 1) +
      jet 2 3 * (direction 0 2 - direction 1 4) +
      jet 2 4 * (direction 1 3 + direction 3 5) +
      jet 2 5 * (-direction 0 0 - direction 3 4),
    jet 3 0 * (-direction 0 4 - direction 1 2) +
      jet 3 1 * (direction 0 3 - direction 2 2) +
      jet 3 2 * (direction 1 0 + direction 2 1) +
      jet 3 3 * (-direction 0 1 - direction 1 5) +
      jet 3 4 * (direction 0 0 - direction 2 5) +
      jet 3 5 * (direction 1 3 + direction 2 4)
  ]

theorem simpleBPairingTangent_eq_normalForm
    (jet direction : LorentzBivectorOneForm)
    (derivativeDirection : LorentzianIndex) :
    simpleBPairingTangent (jet derivativeDirection)
        (lorentzConnectionExteriorDerivativeDirection derivativeDirection
          direction) =
      simpleBPairingTangentNormalForm jet direction
        derivativeDirection := by
  fin_cases derivativeDirection <;>
    simp [simpleBPairingTangent,
      simpleBFirstTransformTangent,
      hodgeCoframeWedgeTangentLinear,
      coframeWedgeTangentLinear,
      simpleBPairingTangentNormalForm,
      lorentzConnectionExteriorDerivativeDirection,
      lorentzSkewConnectionOfBivectorOneForm,
      loweredLorentzBivectorMatrix,
      orientedLorentzBivectorBasisCoefficient,
      physicalIIPlusBivector, physicalIIPlusCoframeTangent,
      internalBivectorDual, coframeWedge, coframeWedgeTangent,
      lorentzianCoframeHodge, lorentzianTwoFormSign,
      minkowskiInternalSign, pairFirst, pairSecond,
      Matrix.one_apply, Fin.sum_univ_six, Fin.sum_univ_four] <;>
    ring

theorem skewCoframeMomentumDivergence_origin_eq_axisSum
    (jet direction : LorentzBivectorOneForm) :
    lorentzConnectionBFDifferentialMomentumDivergence
        (skewCoframeActual jet) direction 0 =
      ∑ derivativeDirection : LorentzianIndex,
        simpleBPairingTangent (jet derivativeDirection)
          (lorentzConnectionExteriorDerivativeDirection derivativeDirection
            direction) := by
  unfold lorentzConnectionBFDifferentialMomentumDivergence
  simp only [skewCoframeMomentum_directionalDerivative_origin]

theorem skewCoframeMomentumDivergence_origin
    (jet direction : LorentzBivectorOneForm) :
    lorentzConnectionBFDifferentialMomentumDivergence
        (skewCoframeActual jet) direction 0 =
      ∑ formDirection : LorentzianIndex,
        ∑ internalPair : Fin 6,
          skewCoframeDivergenceResponseCoordinates jet formDirection
              internalPair *
            direction formDirection internalPair := by
  rw [skewCoframeMomentumDivergence_origin_eq_axisSum]
  simp_rw [simpleBPairingTangent_eq_normalForm]
  simp [simpleBPairingTangentNormalForm,
    skewCoframeDivergenceResponseCoordinates,
    Fin.sum_univ_four, Fin.sum_univ_six]
  ring

def skewCoframeActualBFDivergenceCoordinates
    (jet : LorentzBivectorOneForm) : LorentzBivectorOneForm :=
  fun formDirection internalPair =>
    lorentzConnectionBFDifferentialMomentumDivergence
      (skewCoframeActual jet)
      (lorentzBivectorOneFormCoordinateDirection formDirection internalPair)
      0

theorem skewCoframeActualBFDivergenceCoordinates_apply
    (jet : LorentzBivectorOneForm)
    (formDirection : LorentzianIndex) (internalPair : Fin 6) :
    skewCoframeActualBFDivergenceCoordinates jet formDirection
        internalPair =
      skewCoframeDivergenceResponseCoordinates jet formDirection
        internalPair := by
  unfold skewCoframeActualBFDivergenceCoordinates
  rw [skewCoframeMomentumDivergence_origin]
  fin_cases formDirection <;> fin_cases internalPair <;>
    simp [lorentzBivectorOneFormCoordinateDirection,
      Fin.sum_univ_four, Fin.sum_univ_six]

theorem skewCoframeActualBFDivergenceCoordinates_eq_closedForm
    (jet : LorentzBivectorOneForm) :
    skewCoframeActualBFDivergenceCoordinates jet =
      skewCoframeDivergenceResponseCoordinates jet := by
  funext formDirection internalPair
  exact skewCoframeActualBFDivergenceCoordinates_apply
    jet formDirection internalPair

