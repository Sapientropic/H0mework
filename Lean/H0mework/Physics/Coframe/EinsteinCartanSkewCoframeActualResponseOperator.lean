/-- Closed coordinate form of the simple-`B` skew-coframe principal response
at the identity coframe.  Its equality with the actual BF-divergence operator
is proved below for every 24-dimensional skew jet. -/
def skewCoframeDivergenceResponseCoordinates
    (jet : LorentzBivectorOneForm) : LorentzBivectorOneForm :=
  ![
    ![
      -jet 2 5 + jet 3 4,
      jet 1 5 - jet 3 3,
      -jet 1 4 + jet 2 3,
      -jet 2 2 + jet 3 1,
      jet 1 2 - jet 3 0,
      -jet 1 1 + jet 2 0],
    ![
      jet 2 1 + jet 3 2,
      -jet 0 5 - jet 2 0,
      jet 0 4 - jet 3 0,
      jet 2 4 + jet 3 5,
      -jet 0 2 - jet 2 3,
      jet 0 1 - jet 3 3],
    ![
      jet 0 5 - jet 1 1,
      jet 1 0 + jet 3 2,
      -jet 0 3 - jet 3 1,
      jet 0 2 - jet 1 4,
      jet 1 3 + jet 3 5,
      -jet 0 0 - jet 3 4],
    ![
      -jet 0 4 - jet 1 2,
      jet 0 3 - jet 2 2,
      jet 1 0 + jet 2 1,
      -jet 0 1 - jet 1 5,
      jet 0 0 - jet 2 5,
      jet 1 3 + jet 2 4]
  ]

/-- Lift the 24 skew-jet coordinates to the complete 64-coordinate coframe
first derivative. -/
def skewCoframeDerivative
    (coordinates : LorentzBivectorOneForm) :
    LorentzianCoframeDerivative :=
  fun derivativeDirection internal coordinate =>
    loweredLorentzBivectorMatrix (coordinates derivativeDirection)
      internal coordinate

theorem skewCoframeDerivative_skew
    (coordinates : LorentzBivectorOneForm)
    (derivativeDirection internal coordinate : LorentzianIndex) :
    skewCoframeDerivative coordinates derivativeDirection internal coordinate =
      -skewCoframeDerivative coordinates derivativeDirection coordinate
        internal := by
  fin_cases internal <;> fin_cases coordinate <;>
    simp [skewCoframeDerivative, loweredLorentzBivectorMatrix,
      orientedLorentzBivectorBasisCoefficient, pairFirst, pairSecond,
      Fin.sum_univ_six]

def skewCoframeJet
    (coordinates : LorentzBivectorOneForm) :
    PointwiseLorentzianCoframeJet where
  coframe := 1
  derivative := skewCoframeDerivative coordinates

def skewCoframeField
    (coordinates : LorentzBivectorOneForm) :
    BasePoint → LorentzianCoframe :=
  affineCoframeFieldOfJet (skewCoframeJet coordinates)

/-- Actual primitive configuration generated by a skew coframe jet.  All
non-gravity fields come from the already source/action-generated C3h107 base;
the gravity auxiliary is derived, not stored, as `B := II⁺(U)`. -/
def skewCoframeActual
    (coordinates : LorentzBivectorOneForm) :
    StageNineHolonomicConfiguration :=
  let base := positiveSourceTargetMatterActual
  let coframe := skewCoframeField coordinates
  { base with
    coframe := coframe
    gravityAuxiliary := fun point => physicalIIPlusBivector (coframe point) }

@[simp] theorem skewCoframeActual_coframe_origin
    (coordinates : LorentzBivectorOneForm) :
    (skewCoframeActual coordinates).coframe 0 = 1 := by
  exact affineCoframeFieldOfJet_origin _

@[simp] theorem skewCoframeActual_gravityAuxiliary_origin
    (coordinates : LorentzBivectorOneForm) :
    (skewCoframeActual coordinates).gravityAuxiliary 0 =
      physicalIIPlusBivector 1 := by
  rw [show
    (skewCoframeActual coordinates).gravityAuxiliary 0 =
      physicalIIPlusBivector
        ((skewCoframeActual coordinates).coframe 0) by rfl]
  rw [skewCoframeActual_coframe_origin]

theorem skewCoframeActual_smooth
    (coordinates : LorentzBivectorOneForm) :
    (skewCoframeActual coordinates).Smooth := by
  rcases positiveSourceTargetMatterActual_smooth with
    ⟨_baseCoframeSmooth, gravityConnectionSmooth,
      _baseGravityAuxiliarySmooth, multiplierSmooth,
      gaugeConnectionSmooth, gaugeAuxiliarySmooth, scalarSmooth,
      matterSmooth, conjugateMatterSmooth⟩
  let jet := skewCoframeJet coordinates
  have coframeSmooth :
      ContDiff ℝ ∞ (affineCoframeFieldOfJet jet) := by
    apply contDiff_pi'
    intro internal
    apply contDiff_pi'
    intro coordinate
    exact affineCoframeFieldOfJet_componentwiseSmooth
      jet internal coordinate
  have gravityAuxiliarySmooth :
      ContDiff ℝ ∞ fun point =>
        physicalIIPlusBivector
          (affineCoframeFieldOfJet jet point) :=
    physicalIIPlusBivector_contDiff.comp coframeSmooth
  exact
    ⟨fun internal coordinate =>
        contDiff_pi.mp (contDiff_pi.mp coframeSmooth internal) coordinate,
      gravityConnectionSmooth,
      fun internalPair spacetimePair =>
        contDiff_pi.mp
          (contDiff_pi.mp gravityAuxiliarySmooth internalPair)
          spacetimePair,
      multiplierSmooth, gaugeConnectionSmooth, gaugeAuxiliarySmooth,
      scalarSmooth, matterSmooth, conjugateMatterSmooth⟩

def lorentzBivectorOneFormCoordinateDirection
    (formDirection : LorentzianIndex) (internalPair : Fin 6) :
    LorentzBivectorOneForm :=
  fun candidateForm candidatePair =>
    if candidateForm = formDirection ∧ candidatePair = internalPair then
      1
    else
      0

def skewCoframeAxis
    (coordinates : Fin 6 → ℝ) (parameter : ℝ) :
    LorentzianCoframe :=
  fun internal coordinate =>
    (1 : LorentzianCoframe) internal coordinate +
      parameter *
        loweredLorentzBivectorMatrix coordinates internal coordinate

def skewCoframeAxisNormSq (coordinates : Fin 6 → ℝ) : ℝ :=
  ∑ pair : Fin 6, coordinates pair ^ 2

def skewCoframeAxisPfaffian (coordinates : Fin 6 → ℝ) : ℝ :=
  coordinates 0 * coordinates 3 + coordinates 1 * coordinates 4 +
    coordinates 2 * coordinates 5

@[simp] theorem skewCoframeAxis_zero
    (coordinates : Fin 6 → ℝ) :
    skewCoframeAxis coordinates 0 = 1 := by
  ext internal coordinate
  simp [skewCoframeAxis]

theorem skewCoframeAxis_det
    (coordinates : Fin 6 → ℝ) (parameter : ℝ) :
    Matrix.det (skewCoframeAxis coordinates parameter) =
      1 + parameter ^ 2 * skewCoframeAxisNormSq coordinates +
        parameter ^ 4 * skewCoframeAxisPfaffian coordinates ^ 2 := by
  rw [Matrix.det_succ_row_zero]
  simp [skewCoframeAxis, skewCoframeAxisNormSq, skewCoframeAxisPfaffian,
    Matrix.det_fin_three, Matrix.one_apply,
    Fin.sum_univ_four, Fin.sum_univ_six,
    Fin.succAbove, loweredLorentzBivectorMatrix,
    orientedLorentzBivectorBasisCoefficient, pairFirst, pairSecond]
  ring

theorem skewCoframeAxis_det_pos
    (coordinates : Fin 6 → ℝ) (parameter : ℝ) :
    0 < Matrix.det (skewCoframeAxis coordinates parameter) := by
  rw [skewCoframeAxis_det]
  have normSqNonnegative : 0 ≤ skewCoframeAxisNormSq coordinates := by
    unfold skewCoframeAxisNormSq
    exact Finset.sum_nonneg fun pair (_ : pair ∈ Finset.univ) =>
      sq_nonneg (coordinates pair)
  have quadraticNonnegative :
      0 ≤ parameter ^ 2 * skewCoframeAxisNormSq coordinates :=
    mul_nonneg (sq_nonneg parameter) normSqNonnegative
  have quarticNonnegative :
      0 ≤ parameter ^ 4 * skewCoframeAxisPfaffian coordinates ^ 2 :=
    mul_nonneg (by positivity) (sq_nonneg _)
  linarith

theorem skewCoframeActual_axis_eq
    (jet : LorentzBivectorOneForm)
    (derivativeDirection : LorentzianIndex)
    (parameter : ℝ) :
    (skewCoframeActual jet).coframe
        (parameter • coordinateDirection derivativeDirection) =
      skewCoframeAxis (jet derivativeDirection) parameter := by
  ext internal coordinate
  simp [skewCoframeActual, skewCoframeField, skewCoframeJet,
    affineCoframeFieldOfJet, coframeJetAffineComponentLinear,
    coframeBaseCoordinate, skewCoframeDerivative,
    skewCoframeAxis, coordinateDirection]

def coframeWedgeTangentLinear
    (tangent : LorentzianCoframe) (form : GaugeTwoForm) :
    GaugeTwoForm :=
  fun internalPair =>
    ∑ spacetimePair : Fin 6,
      coframeWedgeTangent (1 : LorentzianCoframe) tangent
          internalPair spacetimePair *
        form spacetimePair

theorem skewCoframeAxis_entry_hasDerivAt
    (coordinates : Fin 6 → ℝ)
    (internal coordinate : LorentzianIndex) :
    HasDerivAt
        (fun parameter =>
          skewCoframeAxis coordinates parameter internal coordinate)
        (loweredLorentzBivectorMatrix coordinates internal coordinate) 0 := by
  simpa [skewCoframeAxis, add_comm] using
    ((hasDerivAt_id (0 : ℝ)).mul_const
      (loweredLorentzBivectorMatrix coordinates internal coordinate)
      |>.const_add ((1 : LorentzianCoframe) internal coordinate))

theorem skewCoframeAxisCoframeWedge_hasDerivAt
    (coordinates : Fin 6 → ℝ)
    (internalPair spacetimePair : Fin 6) :
    HasDerivAt
        (fun parameter =>
          coframeWedge (skewCoframeAxis coordinates parameter)
            internalPair spacetimePair)
        (coframeWedgeTangent (1 : LorentzianCoframe)
          (loweredLorentzBivectorMatrix coordinates)
          internalPair spacetimePair)
        0 := by
  have tangentEquality :
      coframeWedgeTangent (1 : LorentzianCoframe)
          (loweredLorentzBivectorMatrix coordinates)
          internalPair spacetimePair =
        (loweredLorentzBivectorMatrix coordinates
              (pairFirst internalPair) (pairFirst spacetimePair) *
            (1 : LorentzianCoframe)
              (pairSecond internalPair) (pairSecond spacetimePair) +
          (1 : LorentzianCoframe)
              (pairFirst internalPair) (pairFirst spacetimePair) *
            loweredLorentzBivectorMatrix coordinates
              (pairSecond internalPair) (pairSecond spacetimePair)) -
        (loweredLorentzBivectorMatrix coordinates
              (pairFirst internalPair) (pairSecond spacetimePair) *
            (1 : LorentzianCoframe)
              (pairSecond internalPair) (pairFirst spacetimePair) +
          (1 : LorentzianCoframe)
              (pairFirst internalPair) (pairSecond spacetimePair) *
            loweredLorentzBivectorMatrix coordinates
              (pairSecond internalPair) (pairFirst spacetimePair)) := by
    unfold coframeWedgeTangent
    ring
  rw [tangentEquality]
  have firstProduct :=
    (skewCoframeAxis_entry_hasDerivAt coordinates
        (pairFirst internalPair) (pairFirst spacetimePair)).mul
      (skewCoframeAxis_entry_hasDerivAt coordinates
        (pairSecond internalPair) (pairSecond spacetimePair))
  have secondProduct :=
    (skewCoframeAxis_entry_hasDerivAt coordinates
        (pairFirst internalPair) (pairSecond spacetimePair)).mul
      (skewCoframeAxis_entry_hasDerivAt coordinates
        (pairSecond internalPair) (pairFirst spacetimePair))
  change HasDerivAt
    (((fun parameter =>
        skewCoframeAxis coordinates parameter
          (pairFirst internalPair) (pairFirst spacetimePair)) *
      fun parameter =>
        skewCoframeAxis coordinates parameter
          (pairSecond internalPair) (pairSecond spacetimePair)) -
      ((fun parameter =>
        skewCoframeAxis coordinates parameter
          (pairFirst internalPair) (pairSecond spacetimePair)) *
      fun parameter =>
        skewCoframeAxis coordinates parameter
          (pairSecond internalPair) (pairFirst spacetimePair)))
      _ 0
  simpa [skewCoframeAxis] using firstProduct.sub secondProduct

theorem skewCoframeAxisPhysicalIIPlus_hasDerivAt
    (coordinates : Fin 6 → ℝ)
    (internalPair spacetimePair : Fin 6) :
    HasDerivAt
        (fun parameter =>
          physicalIIPlusBivector
              (skewCoframeAxis coordinates parameter)
            internalPair spacetimePair)
        (physicalIIPlusCoframeTangent (1 : LorentzianCoframe)
          (loweredLorentzBivectorMatrix coordinates)
          internalPair spacetimePair)
        0 := by
  fin_cases internalPair
  · simpa [physicalIIPlusBivector, physicalIIPlusCoframeTangent,
      internalBivectorDual, lorentzianCoframeHodge] using
      skewCoframeAxisCoframeWedge_hasDerivAt coordinates 3 spacetimePair
  · simpa [physicalIIPlusBivector, physicalIIPlusCoframeTangent,
      internalBivectorDual, lorentzianCoframeHodge] using
      skewCoframeAxisCoframeWedge_hasDerivAt coordinates 4 spacetimePair
  · simpa [physicalIIPlusBivector, physicalIIPlusCoframeTangent,
      internalBivectorDual, lorentzianCoframeHodge] using
      skewCoframeAxisCoframeWedge_hasDerivAt coordinates 5 spacetimePair
  · change HasDerivAt
      (-fun parameter =>
        coframeWedge (skewCoframeAxis coordinates parameter)
          0 spacetimePair)
      (-coframeWedgeTangent (1 : LorentzianCoframe)
        (loweredLorentzBivectorMatrix coordinates) 0 spacetimePair) 0
    exact
      (skewCoframeAxisCoframeWedge_hasDerivAt coordinates 0 spacetimePair).neg
  · change HasDerivAt
      (-fun parameter =>
        coframeWedge (skewCoframeAxis coordinates parameter)
          1 spacetimePair)
      (-coframeWedgeTangent (1 : LorentzianCoframe)
        (loweredLorentzBivectorMatrix coordinates) 1 spacetimePair) 0
    exact
      (skewCoframeAxisCoframeWedge_hasDerivAt coordinates 1 spacetimePair).neg
  · change HasDerivAt
      (-fun parameter =>
        coframeWedge (skewCoframeAxis coordinates parameter)
          2 spacetimePair)
      (-coframeWedgeTangent (1 : LorentzianCoframe)
        (loweredLorentzBivectorMatrix coordinates) 2 spacetimePair) 0
    exact
      (skewCoframeAxisCoframeWedge_hasDerivAt coordinates 2 spacetimePair).neg

theorem skewCoframeAxisCoframeTwoFormLinear_fixed_hasDerivAt
    (coordinates : Fin 6 → ℝ)
    (form : GaugeTwoForm) (internalPair : Fin 6) :
    HasDerivAt
        (fun parameter =>
          coframeTwoFormLinear (skewCoframeAxis coordinates parameter)
            form internalPair)
        (coframeWedgeTangentLinear
          (loweredLorentzBivectorMatrix coordinates) form internalPair)
        0 := by
  unfold coframeTwoFormLinear coframeWedgeTangentLinear
  change HasDerivAt
    (∑ spacetimePair : Fin 6, fun parameter =>
      coframeWedge (skewCoframeAxis coordinates parameter)
          internalPair spacetimePair *
        form spacetimePair)
    (∑ spacetimePair : Fin 6,
      coframeWedgeTangent (1 : LorentzianCoframe)
          (loweredLorentzBivectorMatrix coordinates)
          internalPair spacetimePair *
        form spacetimePair)
    0
  apply HasDerivAt.sum
  intro spacetimePair _
  exact
    (skewCoframeAxisCoframeWedge_hasDerivAt coordinates
      internalPair spacetimePair).mul_const (form spacetimePair)

def simpleBFirstTransformTangent
    (coordinates : Fin 6 → ℝ)
    (internalPair spacetimePair : Fin 6) : ℝ :=
  ∑ sourcePair : Fin 6,
    (coframeWedgeTangent (1 : LorentzianCoframe)
        (loweredLorentzBivectorMatrix coordinates)
        spacetimePair sourcePair *
      physicalIIPlusBivector (1 : LorentzianCoframe)
        internalPair sourcePair +
    coframeWedge (1 : LorentzianCoframe) spacetimePair sourcePair *
      physicalIIPlusCoframeTangent (1 : LorentzianCoframe)
        (loweredLorentzBivectorMatrix coordinates)
        internalPair sourcePair)

theorem skewCoframeAxisSimpleBFirstTransform_hasDerivAt
    (coordinates : Fin 6 → ℝ)
    (internalPair spacetimePair : Fin 6) :
    HasDerivAt
        (fun parameter =>
          coframeTwoFormLinear (skewCoframeAxis coordinates parameter)
            (physicalIIPlusBivector
              (skewCoframeAxis coordinates parameter) internalPair)
            spacetimePair)
        (simpleBFirstTransformTangent coordinates internalPair
          spacetimePair)
        0 := by
  unfold coframeTwoFormLinear simpleBFirstTransformTangent
  change HasDerivAt
    (∑ sourcePair : Fin 6, fun parameter =>
      coframeWedge (skewCoframeAxis coordinates parameter)
          spacetimePair sourcePair *
        physicalIIPlusBivector
          (skewCoframeAxis coordinates parameter)
          internalPair sourcePair)
    (∑ sourcePair : Fin 6,
      (coframeWedgeTangent (1 : LorentzianCoframe)
          (loweredLorentzBivectorMatrix coordinates)
          spacetimePair sourcePair *
        physicalIIPlusBivector (1 : LorentzianCoframe)
          internalPair sourcePair +
      coframeWedge (1 : LorentzianCoframe) spacetimePair sourcePair *
        physicalIIPlusCoframeTangent (1 : LorentzianCoframe)
          (loweredLorentzBivectorMatrix coordinates)
          internalPair sourcePair))
    0
  apply HasDerivAt.sum
  intro sourcePair _
  change HasDerivAt
    ((fun parameter =>
        coframeWedge (skewCoframeAxis coordinates parameter)
          spacetimePair sourcePair) *
      fun parameter =>
        physicalIIPlusBivector
          (skewCoframeAxis coordinates parameter)
          internalPair sourcePair)
    _ 0
  simpa using
    (skewCoframeAxisCoframeWedge_hasDerivAt coordinates
        spacetimePair sourcePair).mul
      (skewCoframeAxisPhysicalIIPlus_hasDerivAt coordinates
        internalPair sourcePair)

def hodgeCoframeWedgeTangentLinear
    (coordinates : Fin 6 → ℝ) (form : GaugeTwoForm) :
    GaugeTwoForm :=
  lorentzianCoframeHodge
    (coframeWedgeTangentLinear
