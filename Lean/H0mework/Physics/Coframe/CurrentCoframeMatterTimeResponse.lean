import H0mework.Physics.Coframe.CurrentCoframeMatterTemporalPrincipal
import H0mework.Physics.Matter.MatterActionTimeVelocity

/-!
# S9-C3h200y: current-coframe matter time response

The C3h96 matter producer solved the temporal Dirac equation on the
identity-coframe carrier.  This module upgrades the producer itself to the
actual coframe at a selected Cauchy contact:

```text
(current, contact)
→ actual spatial covariant matter jet
→ actual inverse-coframe spatial Dirac principal
→ action-known vector
→ branch-free inverse of the actual temporal principal
→ unique temporal covariant response
→ raw primitive matter response.
```

The definitions are total and accept no inverse witness, residual, target
velocity, branch selector, noncharacteristic receipt, or tunable coefficient.
Noncharacteristicity appears only as a theorem hypothesis when the generated
formula is proved sound and unique.  On an identity-coframe contact the new
operator is proved to be exactly the established C3h96 producer, so this
upgrade does not silently open a new response epoch there.
-/

namespace
  SaturationMonoid.PhysicsCore.StageNineCurrentCoframeMatterTimeResponse

open DiracCliffordRepresentation
open DiracExteriorMatterAction
open PointwiseDiracSpinConnectionLift
open ProofFreeRicherAnholonomicSource
open StageNineCanonicalCauchyState
open StageNineCurrentCoframeMatterTemporalPrincipal
open StageNineDynamicBreakingVacuum
open StageNineHolonomicField
open StageNineMatterActionTimeVelocity
open StageNineP286ActionCauchySplit
open SU7ExteriorBreakingYukawa
open SU7MotherLieAlgebra

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 500000
set_option maxRecDepth 100000
set_option linter.unusedSimpArgs false

/-! ## Action-known spatial and algebraic terms -/

/-- All non-temporal terms in the Dirac--Yukawa equation, evaluated with the
actual inverse coframe of the selected current contact. -/
def currentCoframeMatterKnownVector
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    DiracExteriorMatterCarrier :=
  Complex.I •
      ∑ direction : Fin 3,
        diracMatrixMatterAction
          (inverseCoframeDiracGamma
            { coframe := current.coframe space, derivative := 0 }
            direction.succ)
          (cauchyMatterSpatialCovariantDerivative current space direction) +
    chiralExteriorYukawaAction
      (scalarCoordinateEquiv.symm (current.scalar space))
      (current.matter space)

/-- Current-state temporal action law at one contact. -/
def CurrentCoframeMatterTimeActionLaw
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (timeCovariantDerivative : DiracExteriorMatterCarrier) : Prop :=
  CurrentCoframeMatterTemporalActionLaw
    (current.coframe space)
    (currentCoframeMatterKnownVector current space)
    timeCovariantDerivative

/-! ## Branch-free response producer -/

/-- Temporal covariant matter response generated by the actual coframe and
the action-known spatial/algebraic terms. -/
def actionGeneratedCurrentCoframeMatterTimeCovariantDerivative
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    DiracExteriorMatterCarrier :=
  actionGeneratedCurrentCoframeMatterTemporalDerivative
    (current.coframe space)
    (currentCoframeMatterKnownVector current space)

/-- Primitive matter time response after removing the already present
Lorentz and P286 temporal connection actions. -/
def actionGeneratedCurrentCoframeMatterRawTimeVelocity
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint) :
    DiracExteriorMatterCarrier :=
  actionGeneratedCurrentCoframeMatterTimeCovariantDerivative current space -
    cauchyMatterConnectionAction current space
      canonicalLorentzianTimeDirection

theorem
    actionGeneratedCurrentCoframeMatterTimeCovariantDerivative_satisfies_actionLaw
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (noncharacteristic :
      coframeTemporalPrincipalScalar (current.coframe space) ≠ 0) :
    CurrentCoframeMatterTimeActionLaw current space
      (actionGeneratedCurrentCoframeMatterTimeCovariantDerivative
        current space) := by
  exact
    actionGeneratedCurrentCoframeMatterTemporalDerivative_satisfies_actionLaw
      (current.coframe space) noncharacteristic
      (currentCoframeMatterKnownVector current space)

/-- The action-generated response has no hidden temporal branch. -/
theorem currentCoframeMatterTimeActionLaw_unique
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (noncharacteristic :
      coframeTemporalPrincipalScalar (current.coframe space) ≠ 0)
    (first second : DiracExteriorMatterCarrier)
    (firstLaw : CurrentCoframeMatterTimeActionLaw current space first)
    (secondLaw : CurrentCoframeMatterTimeActionLaw current space second) :
    first = second := by
  exact
    currentCoframeMatterTemporalActionLaw_unique
      (current.coframe space) noncharacteristic
      (currentCoframeMatterKnownVector current space)
      first second firstLaw secondLaw

/-! ## Holonomic actual interface -/

/-- Connection contribution to the matter covariant derivative, read from
one already generated holonomic actual. -/
def holonomicMatterConnectionAction
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint)
    (direction : LorentzianIndex) :
    DiracExteriorMatterCarrier :=
  diracMatrixMatterAction
      (diracSpinConnectionLift
        (configuration.gravityConnection point) direction)
      (configuration.matter point) +
    diracExteriorMotherLieAction
      (p286LieBlockEmbed
        (configuration.gaugeConnection point direction))
      (configuration.matter point)

/-- Non-temporal Dirac--Yukawa terms read from one holonomic actual at the
judged contact. -/
def holonomicCurrentCoframeMatterKnownVector
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    DiracExteriorMatterCarrier :=
  Complex.I •
      ∑ direction : Fin 3,
        diracMatrixMatterAction
          (inverseCoframeDiracGamma
            { coframe := configuration.coframe point, derivative := 0 }
            direction.succ)
          (holonomicMatterCovariantDerivative configuration point
            direction.succ) +
    chiralExteriorYukawaAction
      (scalarCoordinateEquiv.symm (configuration.scalar point))
      (configuration.matter point)

/-! ## Coordinate-time symmetric-hyperbolic form -/

/-- Multiplying one coordinate principal by the fixed internal-time
principal produces the Hermitian coordinate-time evolution coefficient. -/
theorem identityCoframeMatterTimePrincipal_coordinatePrincipal
    (coframe : LorentzianCoframe)
    (coordinate : LorentzianIndex)
    (matter : DiracExteriorMatterCarrier) :
    identityCoframeMatterTimePrincipal
        (Complex.I •
          diracMatrixMatterAction
            (inverseCoframeDiracGamma
              { coframe := coframe, derivative := 0 } coordinate)
            matter) =
      diracMatrixMatterAction
        (coframeCoordinateDiracEvolutionPrincipal coframe coordinate)
        matter := by
  unfold identityCoframeMatterTimePrincipal
    coframeCoordinateDiracEvolutionPrincipal diracFramePrincipal
  rw [map_smul, smul_smul, ← LinearMap.comp_apply,
    ← diracMatrixMatterAction_mul, smul_mul_smul]
  funext row
  simp [diracMatrixMatterAction, Finset.smul_sum, smul_smul]

private theorem identityCoframeMatterTimePrincipal_add
    (first second : DiracExteriorMatterCarrier) :
    identityCoframeMatterTimePrincipal (first + second) =
      identityCoframeMatterTimePrincipal first +
        identityCoframeMatterTimePrincipal second := by
  simp [identityCoframeMatterTimePrincipal]

private theorem identityCoframeMatterTimePrincipal_zero :
    identityCoframeMatterTimePrincipal
        (0 : DiracExteriorMatterCarrier) = 0 := by
  simp [identityCoframeMatterTimePrincipal]

private theorem identityCoframeMatterTimePrincipal_spatialSum
    (fields : Fin 3 → DiracExteriorMatterCarrier) :
    identityCoframeMatterTimePrincipal
        (Complex.I • ∑ direction, fields direction) =
      ∑ direction,
        identityCoframeMatterTimePrincipal
          (Complex.I • fields direction) := by
  simp [identityCoframeMatterTimePrincipal, map_sum, Finset.smul_sum]

/-- The action-known spatial and Yukawa terms after the canonical
internal-time multiplication.  Its three coordinate coefficients are the
Hermitian matrices `coframeCoordinateDiracEvolutionPrincipal`. -/
def holonomicCurrentCoframeMatterEvolutionKnownVector
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) : DiracExteriorMatterCarrier :=
  (∑ direction : Fin 3,
      diracMatrixMatterAction
        (coframeCoordinateDiracEvolutionPrincipal
          (configuration.coframe point) direction.succ)
        (holonomicMatterCovariantDerivative configuration point
          direction.succ)) +
    identityCoframeMatterTimePrincipal
      (chiralExteriorYukawaAction
        (scalarCoordinateEquiv.symm (configuration.scalar point))
        (configuration.matter point))

theorem identityCoframeMatterTimePrincipal_holonomicKnownVector
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    identityCoframeMatterTimePrincipal
        (holonomicCurrentCoframeMatterKnownVector configuration point) =
      holonomicCurrentCoframeMatterEvolutionKnownVector configuration point := by
  rw [holonomicCurrentCoframeMatterKnownVector,
    holonomicCurrentCoframeMatterEvolutionKnownVector,
    identityCoframeMatterTimePrincipal_add,
    identityCoframeMatterTimePrincipal_spatialSum]
  simp_rw [identityCoframeMatterTimePrincipal_coordinatePrincipal]

private theorem
    identityCoframeMatterTimePrincipal_coordinatePrincipal_reverse
    (coframe : LorentzianCoframe)
    (coordinate : LorentzianIndex)
    (matter : DiracExteriorMatterCarrier) :
    identityCoframeMatterTimePrincipal
        (diracMatrixMatterAction
          (coframeCoordinateDiracEvolutionPrincipal coframe coordinate)
          matter) =
      Complex.I •
        diracMatrixMatterAction
          (inverseCoframeDiracGamma
            { coframe := coframe, derivative := 0 } coordinate)
          matter := by
  rw [← identityCoframeMatterTimePrincipal_coordinatePrincipal]
  exact identityCoframeMatterTimePrincipal_involutive _

private theorem
    identityCoframeMatterTimePrincipal_holonomicKnownVector_reverse
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    identityCoframeMatterTimePrincipal
        (holonomicCurrentCoframeMatterEvolutionKnownVector configuration point) =
      holonomicCurrentCoframeMatterKnownVector configuration point := by
  rw [← identityCoframeMatterTimePrincipal_holonomicKnownVector]
  exact identityCoframeMatterTimePrincipal_involutive _

/-- Current-coframe temporal action law owned by one holonomic actual. -/
def HolonomicCurrentCoframeMatterTimeActionLaw
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint)
    (timeCovariantDerivative : DiracExteriorMatterCarrier) : Prop :=
  CurrentCoframeMatterTemporalActionLaw
    (configuration.coframe point)
    (holonomicCurrentCoframeMatterKnownVector configuration point)
    timeCovariantDerivative

/-- Exact coordinate-time evolution form of the same mother-action law.
The time coefficient is generated by the current coframe; it is not supplied
as a separate symmetrizer or inverse witness. -/
def HolonomicCurrentCoframeMatterCoordinateTimeEvolutionLaw
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint)
    (timeCovariantDerivative : DiracExteriorMatterCarrier) : Prop :=
  diracMatrixMatterAction
        (coframeCoordinateDiracEvolutionPrincipal
          (configuration.coframe point) 0)
        timeCovariantDerivative +
      holonomicCurrentCoframeMatterEvolutionKnownVector configuration point =
    0

theorem holonomicCurrentCoframeMatterActionLaw_iff_coordinateTimeEvolutionLaw
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint)
    (timeCovariantDerivative : DiracExteriorMatterCarrier) :
    HolonomicCurrentCoframeMatterTimeActionLaw configuration point
        timeCovariantDerivative ↔
      HolonomicCurrentCoframeMatterCoordinateTimeEvolutionLaw configuration
        point timeCovariantDerivative := by
  constructor
  · intro actionLaw
    change
      currentCoframeMatterTemporalPrincipal (configuration.coframe point)
            timeCovariantDerivative +
          holonomicCurrentCoframeMatterKnownVector configuration point =
        0 at actionLaw
    change
      diracMatrixMatterAction
            (coframeCoordinateDiracEvolutionPrincipal
              (configuration.coframe point) 0)
            timeCovariantDerivative +
          holonomicCurrentCoframeMatterEvolutionKnownVector configuration point =
        0
    have transformed :=
      congrArg identityCoframeMatterTimePrincipal actionLaw
    simpa only [identityCoframeMatterTimePrincipal_add,
      identityCoframeMatterTimePrincipal_zero,
      currentCoframeMatterTemporalPrincipal,
      LinearMap.smul_apply,
      identityCoframeMatterTimePrincipal_coordinatePrincipal,
      identityCoframeMatterTimePrincipal_holonomicKnownVector] using transformed
  · intro evolutionLaw
    change
      diracMatrixMatterAction
            (coframeCoordinateDiracEvolutionPrincipal
              (configuration.coframe point) 0)
            timeCovariantDerivative +
          holonomicCurrentCoframeMatterEvolutionKnownVector configuration point =
        0 at evolutionLaw
    change
      currentCoframeMatterTemporalPrincipal (configuration.coframe point)
            timeCovariantDerivative +
          holonomicCurrentCoframeMatterKnownVector configuration point =
        0
    have transformed :=
      congrArg identityCoframeMatterTimePrincipal evolutionLaw
    simpa only [identityCoframeMatterTimePrincipal_add,
      identityCoframeMatterTimePrincipal_zero,
      identityCoframeMatterTimePrincipal_coordinatePrincipal_reverse,
      identityCoframeMatterTimePrincipal_holonomicKnownVector_reverse,
      currentCoframeMatterTemporalPrincipal,
      LinearMap.smul_apply] using transformed

/-- Branch-free temporal covariant response generated from the same actual's
coframe, spatial covariant jet, scalar, and matter value. -/
def actionGeneratedHolonomicCurrentCoframeMatterTimeCovariantDerivative
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    DiracExteriorMatterCarrier :=
  actionGeneratedCurrentCoframeMatterTemporalDerivative
    (configuration.coframe point)
    (holonomicCurrentCoframeMatterKnownVector configuration point)

/-- Raw primitive response after removing the actual temporal connection
action. -/
def actionGeneratedHolonomicCurrentCoframeMatterRawTimeVelocity
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint) :
    DiracExteriorMatterCarrier :=
  actionGeneratedHolonomicCurrentCoframeMatterTimeCovariantDerivative
      configuration point -
    holonomicMatterConnectionAction configuration point
      canonicalLorentzianTimeDirection

theorem
    actionGeneratedHolonomicCurrentCoframeMatterTimeCovariantDerivative_satisfies_actionLaw
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint)
    (noncharacteristic :
      coframeTemporalPrincipalScalar (configuration.coframe point) ≠ 0) :
    HolonomicCurrentCoframeMatterTimeActionLaw configuration point
      (actionGeneratedHolonomicCurrentCoframeMatterTimeCovariantDerivative
        configuration point) := by
  exact
    actionGeneratedCurrentCoframeMatterTemporalDerivative_satisfies_actionLaw
      (configuration.coframe point) noncharacteristic
      (holonomicCurrentCoframeMatterKnownVector configuration point)

/-- The same source/current-owned response is directly accepted by the
coordinate-time symmetric-hyperbolic law. -/
theorem
    actionGeneratedHolonomicCurrentCoframeMatterTimeCovariantDerivative_satisfies_coordinateTimeEvolutionLaw
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint)
    (noncharacteristic :
      coframeTemporalPrincipalScalar (configuration.coframe point) ≠ 0) :
    HolonomicCurrentCoframeMatterCoordinateTimeEvolutionLaw configuration point
      (actionGeneratedHolonomicCurrentCoframeMatterTimeCovariantDerivative
        configuration point) :=
  (holonomicCurrentCoframeMatterActionLaw_iff_coordinateTimeEvolutionLaw
    configuration point _).mp
      (actionGeneratedHolonomicCurrentCoframeMatterTimeCovariantDerivative_satisfies_actionLaw
        configuration point noncharacteristic)

/-- The actual-owned response is uniquely fixed on the noncharacteristic
locus; no candidate jet can enter as producer data. -/
theorem holonomicCurrentCoframeMatterTimeActionLaw_unique
    (configuration : StageNineHolonomicConfiguration)
    (point : BasePoint)
    (noncharacteristic :
      coframeTemporalPrincipalScalar (configuration.coframe point) ≠ 0)
    (first second : DiracExteriorMatterCarrier)
    (firstLaw :
      HolonomicCurrentCoframeMatterTimeActionLaw configuration point first)
    (secondLaw :
      HolonomicCurrentCoframeMatterTimeActionLaw configuration point second) :
    first = second := by
  exact
    currentCoframeMatterTemporalActionLaw_unique
      (configuration.coframe point) noncharacteristic
      (holonomicCurrentCoframeMatterKnownVector configuration point)
      first second firstLaw secondLaw

/-! ## Exact compatibility with the established identity-coframe producer -/

theorem currentCoframeMatterKnownVector_eq_identity
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (identityCoframe : current.coframe space = 1) :
    currentCoframeMatterKnownVector current space =
      actionGeneratedMatterKnownVector current space := by
  unfold currentCoframeMatterKnownVector actionGeneratedMatterKnownVector
  rw [identityCoframe]
  rw [show
    ({ coframe := (1 : LorentzianCoframe), derivative := 0 } :
      PointwiseLorentzianCoframeJet) =
        identityCoframeMatterGeometry by rfl]
  simp_rw [inverseCoframeDiracGamma_identity]

theorem currentCoframeMatterTemporalPrincipal_one
    (matter : DiracExteriorMatterCarrier) :
    currentCoframeMatterTemporalPrincipal (1 : LorentzianCoframe) matter =
      identityCoframeMatterTimePrincipal matter := by
  unfold currentCoframeMatterTemporalPrincipal
    identityCoframeMatterTimePrincipal
  rw [show
    ({ coframe := (1 : LorentzianCoframe), derivative := 0 } :
      PointwiseLorentzianCoframeJet) =
        identityCoframeMatterGeometry by rfl]
  rw [inverseCoframeDiracGamma_identity]
  simp only [LinearMap.smul_apply]

theorem currentCoframeMatterTemporalPrincipalInverse_one
    (matter : DiracExteriorMatterCarrier) :
    currentCoframeMatterTemporalPrincipalInverse
        (1 : LorentzianCoframe) matter =
      identityCoframeMatterTimePrincipal matter := by
  simp [currentCoframeMatterTemporalPrincipalInverse,
    coframeTemporalPrincipalScalar_one,
    currentCoframeMatterTemporalPrincipal_one]

/-- At an identity-coframe contact, the current-coframe producer is exactly
the original action-generated response, not a second candidate. -/
theorem
    actionGeneratedCurrentCoframeMatterTimeCovariantDerivative_eq_identity
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (identityCoframe : current.coframe space = 1) :
    actionGeneratedCurrentCoframeMatterTimeCovariantDerivative current space =
      actionGeneratedMatterTimeCovariantDerivative current space := by
  unfold actionGeneratedCurrentCoframeMatterTimeCovariantDerivative
    actionGeneratedCurrentCoframeMatterTemporalDerivative
    actionGeneratedMatterTimeCovariantDerivative
  rw [identityCoframe,
    currentCoframeMatterKnownVector_eq_identity current space
      identityCoframe]
  exact congrArg Neg.neg
    (currentCoframeMatterTemporalPrincipalInverse_one
      (actionGeneratedMatterKnownVector current space))

/-- Raw primitive responses also agree exactly on the old carrier. -/
theorem actionGeneratedCurrentCoframeMatterRawTimeVelocity_eq_identity
    (current : StageNineCauchyState)
    (space : StageNineSpatialPoint)
    (identityCoframe : current.coframe space = 1) :
    actionGeneratedCurrentCoframeMatterRawTimeVelocity current space =
      actionGeneratedMatterRawTimeVelocity current space := by
  unfold actionGeneratedCurrentCoframeMatterRawTimeVelocity
    actionGeneratedMatterRawTimeVelocity
  rw [
    actionGeneratedCurrentCoframeMatterTimeCovariantDerivative_eq_identity
      current space identityCoframe]

end

end
  SaturationMonoid.PhysicsCore.StageNineCurrentCoframeMatterTimeResponse
