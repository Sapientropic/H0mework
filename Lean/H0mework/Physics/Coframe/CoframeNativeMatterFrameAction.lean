/-!
# Coframe-native matter frame action

For a nondegenerate coframe `e`, the internal time covector `e⁰` and its
dual frame vector `E₀` are generated by `e` itself.  The resulting complete
frame basis preserves the mother Dirac kinetic vector and gives a canonical
frame-time action solve with exact uniqueness.
-/

namespace SaturationMonoid.PhysicsCore.StageNineCoframeNativeMatterFrameAction

open DiracCliffordRepresentation
open DiracExteriorMatterAction
open ProofFreeRicherAnholonomicSource
open StageNineCurrentCoframeMatterTemporalPrincipal
open StageNineDiracDualYukawaSpinJurisdiction
open StageNineHolonomicField
open StageNineMatterActionTimeVelocity
open SU7ExteriorBreakingYukawa
open SU7MotherGaugeTheory
open scoped Matrix

noncomputable section

set_option autoImplicit false
set_option maxHeartbeats 500000

abbrev LorentzianCovector := LorentzianIndex → ℝ

def coordinateCovector
    (direction : LorentzianIndex) : LorentzianCovector :=
  fun coordinate => if coordinate = direction then 1 else 0

/-- The internal-time coframe leg `e⁰` generated from the current coframe. -/
def coframeNativeTemporalCovector
    (coframe : LorentzianCoframe) : LorentzianCovector :=
  fun coordinate => coframe 0 coordinate

/-- The inverse-frame time direction `E₀`; it is the canonical dual of
`e⁰` on the nondegenerate locus. -/
def coframeNativeTemporalDirection
    (coframe : LorentzianCoframe) : LorentzianIndex → ℝ :=
  fun coordinate => coframe⁻¹ coordinate 0

/-- Internal components of a spacetime covector after contraction with the
inverse coframe. -/
def inverseCoframeCovectorComponent
    (coframe : LorentzianCoframe)
    (covector : LorentzianCovector)
    (internal : LorentzianIndex) : ℝ :=
  ∑ coordinate : LorentzianIndex,
    covector coordinate * coframe⁻¹ coordinate internal

@[simp] theorem inverseCoframe_coordinateCovector_component
    (coframe : LorentzianCoframe)
    (direction internal : LorentzianIndex) :
    inverseCoframeCovectorComponent coframe
        (coordinateCovector direction) internal =
      coframe⁻¹ direction internal := by
  simp [inverseCoframeCovectorComponent, coordinateCovector]

theorem coframeNativeTemporalCovector_inverse_component
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (internal : LorentzianIndex) :
    inverseCoframeCovectorComponent coframe
        (coframeNativeTemporalCovector coframe) internal =
      (1 : LorentzianCoframe) 0 internal := by
  have product := congrFun
    (congrFun
      (Matrix.mul_nonsing_inv coframe
        (isUnit_iff_ne_zero.mpr nondegenerate)) 0) internal
  simpa [inverseCoframeCovectorComponent,
    coframeNativeTemporalCovector, Matrix.mul_apply] using product

/-- The generated temporal covector and direction are exactly dual. -/
theorem coframeNativeTemporal_pairing
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0) :
    ∑ coordinate : LorentzianIndex,
        coframeNativeTemporalCovector coframe coordinate *
          coframeNativeTemporalDirection coframe coordinate =
      1 := by
  simpa [inverseCoframeCovectorComponent,
    coframeNativeTemporalDirection, Matrix.one_apply] using
    coframeNativeTemporalCovector_inverse_component
      coframe nondegenerate (0 : LorentzianIndex)

/-- Lorentzian scalar square of the Dirac symbol at an arbitrary spacetime
covector. -/
def coframeCovectorPrincipalScalar
    (coframe : LorentzianCoframe)
    (covector : LorentzianCovector) : ℝ :=
  -∑ internal : LorentzianIndex,
    minkowskiInternalSign internal *
      (inverseCoframeCovectorComponent coframe covector internal) ^ 2

/-- The coordinate-zero temporal scalar is the covector symbol evaluated at
the coordinate covector `dt`. -/
theorem coframeCovectorPrincipalScalar_coordinateZero
    (coframe : LorentzianCoframe) :
    coframeCovectorPrincipalScalar coframe (coordinateCovector 0) =
      coframeTemporalPrincipalScalar coframe := by
  simp [coframeCovectorPrincipalScalar, coframeTemporalPrincipalScalar]

/-- `e⁰` is canonically normalized and noncharacteristic. -/
theorem coframeNativeTemporalPrincipalScalar_eq_one
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0) :
    coframeCovectorPrincipalScalar coframe
        (coframeNativeTemporalCovector coframe) = 1 := by
  unfold coframeCovectorPrincipalScalar
  simp_rw [coframeNativeTemporalCovector_inverse_component
    coframe nondegenerate]
  simp [minkowskiInternalSign, Matrix.one_apply]

/-- Covector-indexed inverse-coframe Clifford symbol. -/
def coframeCovectorDiracGamma
    (coframe : LorentzianCoframe)
    (covector : LorentzianCovector) : DiracMatrix :=
  ∑ internal : LorentzianIndex,
    (inverseCoframeCovectorComponent coframe covector internal : ℂ) •
      diracGamma internal

/-- The existing coordinate-indexed inverse gamma is the coordinate-basis
specialization of the covector symbol. -/
theorem coframeCovectorDiracGamma_coordinate
    (coframe : LorentzianCoframe)
    (direction : LorentzianIndex) :
    coframeCovectorDiracGamma coframe (coordinateCovector direction) =
      inverseCoframeDiracGamma
        { coframe := coframe, derivative := 0 } direction := by
  simp [coframeCovectorDiracGamma, inverseCoframeDiracGamma]

/-- Evaluating the symbol on the coframe-native time covector gives exactly
the fixed internal-time gamma, independently of the coframe coordinates. -/
theorem coframeNativeTemporalDiracGamma_eq_gammaZero
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0) :
    coframeCovectorDiracGamma coframe
        (coframeNativeTemporalCovector coframe) =
      diracGamma 0 := by
  unfold coframeCovectorDiracGamma
  simp_rw [coframeNativeTemporalCovector_inverse_component
    coframe nondegenerate]
  simp [Matrix.one_apply]

/-! ## Frame-spatial Clifford principal -/

/-- The internal coframe row `eᵃ` as a spacetime covector. -/
def coframeNativeInternalCovector
    (coframe : LorentzianCoframe)
    (internal : LorentzianIndex) : LorentzianCovector :=
  fun coordinate => coframe internal coordinate

theorem coframeNativeInternalCovector_inverse_component
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (source target : LorentzianIndex) :
    inverseCoframeCovectorComponent coframe
        (coframeNativeInternalCovector coframe source) target =
      (1 : LorentzianCoframe) source target := by
  have product := congrFun
    (congrFun
      (Matrix.mul_nonsing_inv coframe
        (isUnit_iff_ne_zero.mpr nondegenerate)) source) target
  simpa [inverseCoframeCovectorComponent,
    coframeNativeInternalCovector, Matrix.mul_apply] using product

theorem coframeNativeInternalCovector_principalScalar
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (internal : LorentzianIndex) :
    coframeCovectorPrincipalScalar coframe
        (coframeNativeInternalCovector coframe internal) =
      -minkowskiInternalSign internal := by
  unfold coframeCovectorPrincipalScalar
  simp_rw [coframeNativeInternalCovector_inverse_component
    coframe nondegenerate]
  fin_cases internal <;>
    simp [minkowskiInternalSign, Matrix.one_apply]

theorem coframeNativeInternalCovector_diracGamma
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (internal : LorentzianIndex) :
    coframeCovectorDiracGamma coframe
        (coframeNativeInternalCovector coframe internal) =
      diracGamma internal := by
  unfold coframeCovectorDiracGamma
  simp_rw [coframeNativeInternalCovector_inverse_component
    coframe nondegenerate]
  fin_cases internal <;>
    simp [Matrix.one_apply]

/-- A covector tangent to the source-generated internal spatial frame. -/
def coframeNativeSpatialCovector
    (coframe : LorentzianCoframe)
    (covector : Fin 3 → ℝ) : LorentzianCovector :=
  ∑ internal : Fin 3,
    covector internal •
      coframeNativeInternalCovector coframe internal.succ

theorem coframeNativeSpatialCovector_inverse_component
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (covector : Fin 3 → ℝ)
    (target : LorentzianIndex) :
    inverseCoframeCovectorComponent coframe
        (coframeNativeSpatialCovector coframe covector) target =
      ∑ internal : Fin 3,
        covector internal *
          (1 : LorentzianCoframe) internal.succ target := by
  simp only [coframeNativeSpatialCovector,
    inverseCoframeCovectorComponent, Finset.sum_apply, Pi.smul_apply,
    smul_eq_mul]
  simp_rw [Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro internal _
  simp_rw [mul_assoc]
  rw [← Finset.mul_sum]
  exact congrArg (covector internal * ·)
    (coframeNativeInternalCovector_inverse_component
      coframe nondegenerate internal.succ target)

/-- Frame-spatial covectors have the exact negative Euclidean scalar
principal, independently of the spacetime coframe coordinates. -/
theorem coframeNativeSpatialCovector_principalScalar
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (covector : Fin 3 → ℝ) :
    coframeCovectorPrincipalScalar coframe
        (coframeNativeSpatialCovector coframe covector) =
      -∑ internal : Fin 3, (covector internal) ^ 2 := by
  unfold coframeCovectorPrincipalScalar
  simp_rw [coframeNativeSpatialCovector_inverse_component
    coframe nondegenerate covector]
  simp [minkowskiInternalSign, Matrix.one_apply,
    Fin.sum_univ_three, Fin.sum_univ_four]

theorem coframeNativeSpatialCovector_diracGamma
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (covector : Fin 3 → ℝ) :
    coframeCovectorDiracGamma coframe
        (coframeNativeSpatialCovector coframe covector) =
      ∑ internal : Fin 3,
        (covector internal : ℂ) • diracGamma internal.succ := by
  unfold coframeCovectorDiracGamma
  simp_rw [coframeNativeSpatialCovector_inverse_component
    coframe nondegenerate covector]
  simp [Matrix.one_apply, Fin.sum_univ_three, Fin.sum_univ_four]

/-- The frame-spatial Dirac symbol squares to the exact Euclidean norm
times the identity. -/
theorem coframeNativeSpatialCovector_diracGamma_sq
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (covector : Fin 3 → ℝ) :
    coframeCovectorDiracGamma coframe
          (coframeNativeSpatialCovector coframe covector) *
        coframeCovectorDiracGamma coframe
          (coframeNativeSpatialCovector coframe covector) =
      ((∑ internal : Fin 3, (covector internal) ^ 2 : ℝ) : ℂ) •
        (1 : DiracMatrix) := by
  have iSq : Complex.I ^ 2 = (-1 : ℂ) := by
    rw [pow_two, Complex.I_mul_I]
  rw [coframeNativeSpatialCovector_diracGamma
    coframe nondegenerate covector]
  ext row column
  fin_cases row <;> fin_cases column <;>
    simp [diracGamma, diracGammaOne, diracGammaTwo,
      diracGammaThree, Matrix.mul_apply,
      Fin.sum_univ_three, Fin.sum_univ_four]
  all_goals
    ring_nf
  all_goals
    rw [iSq]
    ring

theorem coframeNativeSpatialCovector_normSq_pos
    (covector : Fin 3 → ℝ)
    (nonzero : covector ≠ 0) :
    0 < ∑ internal : Fin 3, (covector internal) ^ 2 := by
  obtain ⟨internal, internalNonzero⟩ :
      ∃ internal, covector internal ≠ 0 := by
    by_contra everyZero
    push Not at everyZero
    exact nonzero (funext everyZero)
  exact Finset.sum_pos' (fun candidate _ => sq_nonneg (covector candidate))
    ⟨internal, Finset.mem_univ internal,
      sq_pos_of_ne_zero internalNonzero⟩

/-- Every nonzero frame-spatial covector has an invertible Dirac symbol. -/
theorem coframeNativeSpatialCovector_diracGamma_isUnit
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (covector : Fin 3 → ℝ)
    (nonzero : covector ≠ 0) :
    IsUnit (coframeCovectorDiracGamma coframe
      (coframeNativeSpatialCovector coframe covector)) := by
  let normSq : ℝ := ∑ internal : Fin 3, (covector internal) ^ 2
  let gamma := coframeCovectorDiracGamma coframe
    (coframeNativeSpatialCovector coframe covector)
  have normSqPos : 0 < normSq :=
    coframeNativeSpatialCovector_normSq_pos covector nonzero
  have normSqNe : (normSq : ℂ) ≠ 0 := by
    exact_mod_cast ne_of_gt normSqPos
  have gammaSq : gamma * gamma = (normSq : ℂ) • (1 : DiracMatrix) := by
    exact coframeNativeSpatialCovector_diracGamma_sq
      coframe nondegenerate covector
  apply isUnit_iff_exists.mpr
  refine ⟨(normSq : ℂ)⁻¹ • gamma, ?_, ?_⟩
  · rw [mul_smul_comm, gammaSq, smul_smul,
      inv_mul_cancel₀ normSqNe, one_smul]
  · rw [smul_mul_assoc, gammaSq, smul_smul,
      inv_mul_cancel₀ normSqNe, one_smul]

/-- Matter principal indexed by a spacetime covector. -/
def coframeCovectorMatterPrincipal
    (coframe : LorentzianCoframe)
    (covector : LorentzianCovector) :
    Module.End ℂ DiracExteriorMatterCarrier :=
  Complex.I • diracMatrixMatterAction
    (coframeCovectorDiracGamma coframe covector)

/-- On the matter carrier, the frame-spatial principal squares to minus the
Euclidean covector norm. -/
theorem coframeNativeSpatialMatterPrincipal_sq
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (covector : Fin 3 → ℝ)
    (matter : DiracExteriorMatterCarrier) :
    coframeCovectorMatterPrincipal coframe
        (coframeNativeSpatialCovector coframe covector)
        (coframeCovectorMatterPrincipal coframe
          (coframeNativeSpatialCovector coframe covector) matter) =
      -((∑ internal : Fin 3, (covector internal) ^ 2 : ℝ) : ℂ) • matter := by
  unfold coframeCovectorMatterPrincipal
  simp only [LinearMap.smul_apply]
  rw [map_smul, smul_smul, ← LinearMap.comp_apply,
    ← diracMatrixMatterAction_mul,
    coframeNativeSpatialCovector_diracGamma_sq
      coframe nondegenerate covector]
  have actionScalarOne (coefficient : ℂ) :
      diracMatrixMatterAction
          (coefficient • (1 : DiracMatrix)) matter =
        coefficient • matter := by
    funext row
    fin_cases row <;>
      simp [diracMatrixMatterAction, Matrix.one_apply]
  rw [actionScalarOne, Complex.I_mul_I]
  module

/-- A nonzero frame-spatial covector acts injectively on the complete matter
carrier.  This is the action-level ellipticity readout used by the commuted
energy estimate. -/
theorem coframeNativeSpatialMatterPrincipal_injective
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (covector : Fin 3 → ℝ)
    (nonzero : covector ≠ 0) :
    Function.Injective
      (coframeCovectorMatterPrincipal coframe
        (coframeNativeSpatialCovector coframe covector)) := by
  intro first second equality
  have iterated := congrArg
    (coframeCovectorMatterPrincipal coframe
      (coframeNativeSpatialCovector coframe covector)) equality
  rw [coframeNativeSpatialMatterPrincipal_sq coframe nondegenerate covector,
    coframeNativeSpatialMatterPrincipal_sq coframe nondegenerate covector]
    at iterated
  have normSqNe :
      -((∑ internal : Fin 3, (covector internal) ^ 2 : ℝ) : ℂ) ≠ 0 := by
    exact neg_ne_zero.mpr (by
      exact_mod_cast ne_of_gt
        (coframeNativeSpatialCovector_normSq_pos covector nonzero))
  have differenceZero :
      -((∑ internal : Fin 3, (covector internal) ^ 2 : ℝ) : ℂ) •
          (first - second) = 0 := by
    rw [smul_sub, iterated, sub_self]
  have : first - second = 0 :=
    (smul_eq_zero.mp differenceZero).resolve_left normSqNe
  exact sub_eq_zero.mp this

theorem coframeNativeTemporalMatterPrincipal_eq
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0) :
    coframeCovectorMatterPrincipal coframe
        (coframeNativeTemporalCovector coframe) =
      Complex.I • diracMatrixMatterAction (diracGamma 0) := by
  simp [coframeCovectorMatterPrincipal,
    coframeNativeTemporalDiracGamma_eq_gammaZero coframe nondegenerate]

/-- Pointwise current-owned specialization on any globally nondegenerate
Stage-9 configuration. -/
theorem currentNativeTemporalPrincipalScalar_eq_one
    (current : StageNineHolonomicConfiguration)
    (nondegenerate : current.Nondegenerate)
    (point : BasePoint) :
    coframeCovectorPrincipalScalar (current.coframe point)
        (coframeNativeTemporalCovector (current.coframe point)) = 1 :=
  coframeNativeTemporalPrincipalScalar_eq_one
    (current.coframe point) (nondegenerate point)

/-! ## Complete frame-basis matter split -/

abbrev MatterDerivativeFamily :=
  LorentzianIndex → DiracExteriorMatterCarrier

/-- Coordinate derivatives read in the inverse-frame basis. -/
def frameMatterDerivative
    (coframe : LorentzianCoframe)
    (coordinateDerivative : MatterDerivativeFamily)
    (internal : LorentzianIndex) : DiracExteriorMatterCarrier :=
  ∑ coordinate : LorentzianIndex,
    (coframe⁻¹ coordinate internal : ℂ) •
      coordinateDerivative coordinate

/-- Frame derivatives reconstructed in the coordinate basis. -/
def coordinateMatterDerivative
    (coframe : LorentzianCoframe)
    (frameDerivative : MatterDerivativeFamily)
    (coordinate : LorentzianIndex) : DiracExteriorMatterCarrier :=
  ∑ internal : LorentzianIndex,
    (coframe internal coordinate : ℂ) • frameDerivative internal

theorem inverse_mul_coframe_complex
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (first second : LorentzianIndex) :
    ∑ middle : LorentzianIndex,
        (coframe⁻¹ first middle : ℂ) *
          (coframe middle second : ℂ) =
      ((1 : LorentzianCoframe) first second : ℂ) := by
  have entry := congrFun
    (congrFun
      (Matrix.nonsing_inv_mul coframe
        (isUnit_iff_ne_zero.mpr nondegenerate)) first) second
  exact_mod_cast entry

theorem coframe_mul_inverse_complex
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (first second : LorentzianIndex) :
    ∑ middle : LorentzianIndex,
        (coframe first middle : ℂ) *
          (coframe⁻¹ middle second : ℂ) =
      ((1 : LorentzianCoframe) first second : ℂ) := by
  have entry := congrFun
    (congrFun
      (Matrix.mul_nonsing_inv coframe
        (isUnit_iff_ne_zero.mpr nondegenerate)) first) second
  exact_mod_cast entry

theorem coordinateMatterDerivative_frameMatterDerivative
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (coordinateDerivative : MatterDerivativeFamily) :
    coordinateMatterDerivative coframe
        (frameMatterDerivative coframe coordinateDerivative) =
      coordinateDerivative := by
  funext coordinate
  unfold coordinateMatterDerivative frameMatterDerivative
  simp_rw [Finset.smul_sum, smul_smul]
  rw [Finset.sum_comm]
  simp_rw [← Finset.sum_smul,
    show ∀ sourceCoordinate,
      (∑ internal : LorentzianIndex,
        (coframe internal coordinate : ℂ) *
          (coframe⁻¹ sourceCoordinate internal : ℂ)) =
        ((1 : LorentzianCoframe) sourceCoordinate coordinate : ℂ) by
      intro sourceCoordinate
      simpa [mul_comm] using inverse_mul_coframe_complex coframe
        nondegenerate sourceCoordinate coordinate]
  rw [Finset.sum_eq_single coordinate]
  · simp
  · intro candidate _ candidateNe
    simp [candidateNe]
  · simp

theorem frameMatterDerivative_coordinateMatterDerivative
    (coframe : LorentzianCoframe)
    (nondegenerate : Matrix.det coframe ≠ 0)
    (frameDerivative : MatterDerivativeFamily) :
    frameMatterDerivative coframe
        (coordinateMatterDerivative coframe frameDerivative) =
      frameDerivative := by
  funext internal
  unfold coordinateMatterDerivative frameMatterDerivative
  simp_rw [Finset.smul_sum, smul_smul]
  rw [Finset.sum_comm]
  simp_rw [← Finset.sum_smul,
    show ∀ sourceInternal,
      (∑ coordinate : LorentzianIndex,
        (coframe⁻¹ coordinate internal : ℂ) *
          (coframe sourceInternal coordinate : ℂ)) =
        ((1 : LorentzianCoframe) sourceInternal internal : ℂ) by
      intro sourceInternal
      simpa [mul_comm] using coframe_mul_inverse_complex coframe
        nondegenerate sourceInternal internal]
  rw [Finset.sum_eq_single internal]
  · simp
  · intro candidate _ candidateNe
    simp [candidateNe]
  · simp

/-- The current covariant derivative read in the canonical inverse frame. -/
def frameMatterCovariantDerivative
    (geometry : PointwiseLorentzianCoframeJet)
    (connection : SU7MotherGaugeConnection)
    (jet : DiracExteriorMatterFirstJet)
    (internal : LorentzianIndex) : DiracExteriorMatterCarrier :=
  frameMatterDerivative geometry.coframe
    (diracExteriorMatterCovariantDerivative geometry connection jet) internal

/-- The same mother kinetic vector, expressed in the complete frame basis. -/
def frameBasisDiracExteriorMatterKineticVector
    (geometry : PointwiseLorentzianCoframeJet)
    (connection : SU7MotherGaugeConnection)
    (jet : DiracExteriorMatterFirstJet) : DiracExteriorMatterCarrier :=
  Complex.I •
    ∑ internal : LorentzianIndex,
      diracMatrixMatterAction (diracGamma internal)
        (frameMatterCovariantDerivative geometry connection jet internal)

theorem diracMatrixMatterAction_inverseGamma_expand
    (geometry : PointwiseLorentzianCoframeJet)
    (coordinate : LorentzianIndex)
    (matter : DiracExteriorMatterCarrier) :
    diracMatrixMatterAction
        (inverseCoframeDiracGamma geometry coordinate) matter =
      ∑ internal : LorentzianIndex,
        (geometry.coframe⁻¹ coordinate internal : ℂ) •
          diracMatrixMatterAction (diracGamma internal) matter := by
  funext spinIndex
  change
    (∑ column : DiracSpinorIndex,
      (∑ internal : LorentzianIndex,
        (geometry.coframe⁻¹ coordinate internal : ℂ) *
          diracGamma internal spinIndex column) • matter column) =
      ∑ internal : LorentzianIndex,
        (geometry.coframe⁻¹ coordinate internal : ℂ) •
          ∑ column : DiracSpinorIndex,
            diracGamma internal spinIndex column • matter column
  calc
    _ = ∑ column : DiracSpinorIndex,
          ∑ internal : LorentzianIndex,
            ((geometry.coframe⁻¹ coordinate internal : ℂ) *
              diracGamma internal spinIndex column) • matter column := by
      apply Finset.sum_congr rfl
      intro column _
      rw [Finset.sum_smul]
    _ = ∑ internal : LorentzianIndex,
          ∑ column : DiracSpinorIndex,
            ((geometry.coframe⁻¹ coordinate internal : ℂ) *
              diracGamma internal spinIndex column) • matter column := by
      rw [Finset.sum_comm]
    _ = _ := by
      apply Finset.sum_congr rfl
      intro internal _
      rw [Finset.smul_sum]
      apply Finset.sum_congr rfl
      intro column _
      rw [smul_smul]

theorem diracExteriorMatterKineticVector_eq_frameBasis
    (geometry : PointwiseLorentzianCoframeJet)
    (connection : SU7MotherGaugeConnection)
    (jet : DiracExteriorMatterFirstJet) :
    diracExteriorMatterKineticVector geometry connection jet =
      frameBasisDiracExteriorMatterKineticVector geometry connection jet := by
  unfold diracExteriorMatterKineticVector
    frameBasisDiracExteriorMatterKineticVector
    frameMatterCovariantDerivative frameMatterDerivative
  congr 1
  simp_rw [diracMatrixMatterAction_inverseGamma_expand]
  simp only [map_sum, map_smul]
  rw [Finset.sum_comm]

/-- All action-known frame-spatial and right-chiral Yukawa terms. -/
def frameTimeMatterKnownVector
    (coframe : LorentzianCoframe)
    (coordinateDerivative : MatterDerivativeFamily)
    (scalar : ExteriorBreakingScalarCarrier)
    (matter : DiracExteriorMatterCarrier) :
    DiracExteriorMatterCarrier :=
  Complex.I •
      ∑ spatial : Fin 3,
        diracMatrixMatterAction (diracGamma spatial.succ)
          (frameMatterDerivative coframe coordinateDerivative spatial.succ) +
    diracDualRightChiralYukawaAction scalar matter

private theorem diracMatrixMatterAction_smulMatrix
    (parameter : ℂ) (matrix : DiracMatrix)
    (matter : DiracExteriorMatterCarrier) :
    diracMatrixMatterAction (parameter • matrix) matter =
      parameter • diracMatrixMatterAction matrix matter := by
  funext row
  simp [diracMatrixMatterAction, Finset.smul_sum, smul_smul]

/-- Applying the frame-time principal to one internal principal produces the
transformed evolution matrix from the concrete Clifford representation. -/
theorem identityCoframeMatterTimePrincipal_framePrincipal
    (internal : LorentzianIndex)
    (matter : DiracExteriorMatterCarrier) :
    identityCoframeMatterTimePrincipal
        (Complex.I • diracMatrixMatterAction (diracGamma internal) matter) =
      diracMatrixMatterAction
        (diracFrameEvolutionPrincipal internal) matter := by
  unfold identityCoframeMatterTimePrincipal
    diracFrameEvolutionPrincipal diracFramePrincipal
  rw [map_smul, smul_smul, ← LinearMap.comp_apply,
    ← diracMatrixMatterAction_mul, smul_mul_smul]
  exact (diracMatrixMatterAction_smulMatrix
    (Complex.I * Complex.I)
    (diracGamma 0 * diracGamma internal) matter).symm

private theorem identityCoframeMatterTimePrincipal_add
    (first second : DiracExteriorMatterCarrier) :
    identityCoframeMatterTimePrincipal (first + second) =
      identityCoframeMatterTimePrincipal first +
        identityCoframeMatterTimePrincipal second := by
  simp [identityCoframeMatterTimePrincipal]

private theorem identityCoframeMatterTimePrincipal_zero :
    identityCoframeMatterTimePrincipal (0 : DiracExteriorMatterCarrier) = 0 := by
  simp [identityCoframeMatterTimePrincipal]

private theorem identityCoframeMatterTimePrincipal_sum
    (fields : Fin 3 → DiracExteriorMatterCarrier) :
    identityCoframeMatterTimePrincipal (∑ index, fields index) =
      ∑ index, identityCoframeMatterTimePrincipal (fields index) := by
  simp [identityCoframeMatterTimePrincipal, map_sum, Finset.smul_sum]

/-- The action-known part after multiplying the Dirac equation by its
frame-time principal. -/
def frameTimeMatterEvolutionKnownVector
    (coframe : LorentzianCoframe)
    (coordinateDerivative : MatterDerivativeFamily)
    (scalar : ExteriorBreakingScalarCarrier)
    (matter : DiracExteriorMatterCarrier) :
    DiracExteriorMatterCarrier :=
  (∑ spatial : Fin 3,
      diracMatrixMatterAction
        (diracFrameEvolutionPrincipal spatial.succ)
        (frameMatterDerivative coframe coordinateDerivative spatial.succ)) +
    identityCoframeMatterTimePrincipal
      (diracDualRightChiralYukawaAction scalar matter)

theorem identityCoframeMatterTimePrincipal_knownVector
    (coframe : LorentzianCoframe)
    (coordinateDerivative : MatterDerivativeFamily)
    (scalar : ExteriorBreakingScalarCarrier)
    (matter : DiracExteriorMatterCarrier) :
    identityCoframeMatterTimePrincipal
        (frameTimeMatterKnownVector coframe coordinateDerivative scalar matter) =
      frameTimeMatterEvolutionKnownVector
        coframe coordinateDerivative scalar matter := by
  rw [frameTimeMatterKnownVector, frameTimeMatterEvolutionKnownVector,
    Finset.smul_sum, identityCoframeMatterTimePrincipal_add,
    identityCoframeMatterTimePrincipal_sum]
  congr 1
  apply Finset.sum_congr rfl
  intro spatial _
  exact identityCoframeMatterTimePrincipal_framePrincipal
    spatial.succ
    (frameMatterDerivative coframe coordinateDerivative spatial.succ)

private theorem identityCoframeMatterTimePrincipal_evolutionKnownVector
    (coframe : LorentzianCoframe)
    (coordinateDerivative : MatterDerivativeFamily)
    (scalar : ExteriorBreakingScalarCarrier)
    (matter : DiracExteriorMatterCarrier) :
    identityCoframeMatterTimePrincipal
        (frameTimeMatterEvolutionKnownVector
          coframe coordinateDerivative scalar matter) =
      frameTimeMatterKnownVector coframe coordinateDerivative scalar matter := by
  rw [← identityCoframeMatterTimePrincipal_knownVector]
  exact identityCoframeMatterTimePrincipal_involutive _

/-- Frame-time matter equation; its unknown is `D_{E₀}ψ`. -/
def FrameTimeMatterActionLaw
    (coframe : LorentzianCoframe)
    (coordinateDerivative : MatterDerivativeFamily)
    (scalar : ExteriorBreakingScalarCarrier)
    (matter timeFrameDerivative : DiracExteriorMatterCarrier) : Prop :=
  identityCoframeMatterTimePrincipal timeFrameDerivative +
      frameTimeMatterKnownVector coframe coordinateDerivative scalar matter =
    0

/-- Equivalent first-order evolution form of the frame-time matter law.  Its
time coefficient is the identity and its three spatial matrices are the
Hermitian `diracFrameEvolutionPrincipal` matrices. -/
def FrameTimeMatterEvolutionLaw
    (coframe : LorentzianCoframe)
    (coordinateDerivative : MatterDerivativeFamily)
    (scalar : ExteriorBreakingScalarCarrier)
    (matter timeFrameDerivative : DiracExteriorMatterCarrier) : Prop :=
  timeFrameDerivative +
      frameTimeMatterEvolutionKnownVector
        coframe coordinateDerivative scalar matter =
    0

theorem frameTimeMatterActionLaw_iff_evolutionLaw
    (coframe : LorentzianCoframe)
    (coordinateDerivative : MatterDerivativeFamily)
    (scalar : ExteriorBreakingScalarCarrier)
    (matter timeFrameDerivative : DiracExteriorMatterCarrier) :
    FrameTimeMatterActionLaw coframe coordinateDerivative scalar matter
        timeFrameDerivative ↔
      FrameTimeMatterEvolutionLaw coframe coordinateDerivative scalar matter
        timeFrameDerivative := by
  constructor
  · intro actionLaw
    have transformed := congrArg identityCoframeMatterTimePrincipal actionLaw
    simpa [FrameTimeMatterActionLaw, FrameTimeMatterEvolutionLaw,
      identityCoframeMatterTimePrincipal_add,
      identityCoframeMatterTimePrincipal_zero,
      identityCoframeMatterTimePrincipal_involutive,
      identityCoframeMatterTimePrincipal_knownVector] using transformed
  · intro evolutionLaw
    have transformed := congrArg identityCoframeMatterTimePrincipal evolutionLaw
    simpa [FrameTimeMatterActionLaw, FrameTimeMatterEvolutionLaw,
      identityCoframeMatterTimePrincipal_add,
      identityCoframeMatterTimePrincipal_zero,
      identityCoframeMatterTimePrincipal_involutive,
      identityCoframeMatterTimePrincipal_evolutionKnownVector] using transformed

/-- Branch-free `iγ⁰` solve generated from the frame-spatial action
reads and the authoritative right-chiral Yukawa operator. -/
def actionGeneratedFrameTimeMatterDerivative
    (coframe : LorentzianCoframe)
    (coordinateDerivative : MatterDerivativeFamily)
    (scalar : ExteriorBreakingScalarCarrier)
    (matter : DiracExteriorMatterCarrier) :
    DiracExteriorMatterCarrier :=
  -identityCoframeMatterTimePrincipal
    (frameTimeMatterKnownVector coframe coordinateDerivative scalar matter)

theorem actionGeneratedFrameTimeMatterDerivative_satisfies_actionLaw
    (coframe : LorentzianCoframe)
    (coordinateDerivative : MatterDerivativeFamily)
    (scalar : ExteriorBreakingScalarCarrier)
    (matter : DiracExteriorMatterCarrier) :
    FrameTimeMatterActionLaw coframe coordinateDerivative scalar matter
      (actionGeneratedFrameTimeMatterDerivative
        coframe coordinateDerivative scalar matter) := by
  unfold FrameTimeMatterActionLaw actionGeneratedFrameTimeMatterDerivative
  rw [show
    identityCoframeMatterTimePrincipal
        (-identityCoframeMatterTimePrincipal
          (frameTimeMatterKnownVector coframe coordinateDerivative scalar
            matter)) =
      -identityCoframeMatterTimePrincipal
        (identityCoframeMatterTimePrincipal
          (frameTimeMatterKnownVector coframe coordinateDerivative scalar
            matter)) by
    simp [identityCoframeMatterTimePrincipal]]
  rw [identityCoframeMatterTimePrincipal_involutive]
  simp

theorem frameTimeMatterActionLaw_unique
    (coframe : LorentzianCoframe)
    (coordinateDerivative : MatterDerivativeFamily)
    (scalar : ExteriorBreakingScalarCarrier)
    (matter first second : DiracExteriorMatterCarrier)
    (firstLaw :
      FrameTimeMatterActionLaw coframe coordinateDerivative scalar matter first)
    (secondLaw :
      FrameTimeMatterActionLaw coframe coordinateDerivative scalar matter
        second) :
    first = second := by
  have principalEqual :
      identityCoframeMatterTimePrincipal first =
        identityCoframeMatterTimePrincipal second := by
    unfold FrameTimeMatterActionLaw at firstLaw secondLaw
    calc
      identityCoframeMatterTimePrincipal first =
          -frameTimeMatterKnownVector coframe coordinateDerivative scalar
            matter := eq_neg_of_add_eq_zero_left firstLaw
      _ = identityCoframeMatterTimePrincipal second :=
        (eq_neg_of_add_eq_zero_left secondLaw).symm
  calc
    first = identityCoframeMatterTimePrincipal
        (identityCoframeMatterTimePrincipal first) :=
      (identityCoframeMatterTimePrincipal_involutive first).symm
    _ = identityCoframeMatterTimePrincipal
        (identityCoframeMatterTimePrincipal second) := by rw [principalEqual]
    _ = second := identityCoframeMatterTimePrincipal_involutive second

end

end SaturationMonoid.PhysicsCore.StageNineCoframeNativeMatterFrameAction
