import H0mework.NavierStokes.Butterfly.GainCellCrossing
import H0mework.NavierStokes.Accumulation.ConcretePhaseRichNormalizedWorkInward
import H0mework.NavierStokes.Accumulation.FiniteNormalizedWorkNativeJet

/-!
# Complete butterfly normalized-work jet

The first butterfly action is evaluated on its complete nonzero quadratic
output carrier.  The generated action energy and its same-source linearized
write-back are two projections of one source action.  Their exact rational
sum is positive and commutes to the physical finite generator.  Consequently
the genuine whole-tangent normalized-work jet is positive at the concrete
butterfly source.
-/

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 10000000

open scoped BigOperators

namespace SaturationMonoid
namespace NavierStokes
namespace RationalVorticityEvaluator

open ThreeDimensionalPeriodicIntegerCharacterCoarseFilter
open ThreeDimensionalPeriodicCoarseFilterCore
open ThreeDimensionalPeriodicFilteredNavierStokesGenerator
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientFiniteSupportComplexTrajectory
open ThreeDimensionalVorticityCoefficientGeneratedShellSerrinGeometry
open ThreeDimensionalVorticityCoefficientGeneratedShellViscousParseval
open ThreeDimensionalVorticityCoefficientInfiniteFixedOutputNonlinearRow
open ThreeDimensionalVorticityCoefficientGeneratedPathInfiniteNonlinearNegativeOneTimeBudget
open ThreeDimensionalVorticityCoefficientCanonicalExhaustiveGalerkinTarget
open ThreeDimensionalVorticityCoefficientGeneratedWholeRestartCanonicalReplay
open ThreeDimensionalVorticityCoefficientFiniteSupportWholeActionTube
open ThreeDimensionalVorticityCoefficientWholeActionTube
open ThreeDimensionalVorticityCoefficientFiniteNormalizedWorkPhaseFace
open ThreeDimensionalVorticityCoefficientFiniteNormalizedWorkNativeJet
open PhaseRichTriple

noncomputable section

/-- Every nonzero row generated by the complete first butterfly action. -/
def butterflyCompleteActionModes : Finset IntegerWavevector :=
  (wholeFiniteSupportActionModes butterflySeedModes).erase 0

def butterflyCompleteRationalState : GaussianRatState := fun wave =>
  if wave ∈ butterflySeedModes then butterflySeedRow 1 wave else 0

def butterflyCompleteRationalTangent : GaussianRatState :=
  rationalVorticityGeneratorCoefficientAt butterflySeedModes (1 / 100)
    butterflyCompleteRationalState

/-- Complete derivative of the generated action.  Fresh action rows are
retained in both bilinear slots before the viscous write-back is subtracted. -/
def butterflyCompleteRationalLinearized : GaussianRatState := fun output =>
  GaussianRatVector.sub
    (rationalVorticityBilinearCoefficientAt butterflyCompleteActionModes
        butterflyCompleteRationalTangent butterflyCompleteRationalState
        output +
      rationalVorticityBilinearCoefficientAt butterflyCompleteActionModes
        butterflyCompleteRationalState butterflyCompleteRationalTangent
        output)
    (GaussianRatVector.ratScale
      ((1 / 100) * rationalIntegerWaveNormSq output)
      (butterflyCompleteRationalTangent output))

def butterflyCompleteRationalTangentEnergy : ℚ :=
  ∑ wave ∈ butterflyCompleteActionModes,
    gaussianRatVectorRealInner
      (butterflyCompleteRationalTangent wave)
      (butterflyCompleteRationalTangent wave)

def butterflyCompleteRationalLinearWriteback : ℚ :=
  ∑ wave ∈ butterflySeedModes,
    gaussianRatVectorRealInner
      (butterflyCompleteRationalState wave)
      (butterflyCompleteRationalLinearized wave)

/-- Exact derivative of the complete physical net-enstrophy work. -/
def butterflyCompleteRationalWholePowerJet : ℚ :=
  2 * (butterflyCompleteRationalTangentEnergy +
    butterflyCompleteRationalLinearWriteback)

theorem butterflyCompleteActionModes_zero_not_mem :
    (0 : IntegerWavevector) ∉ butterflyCompleteActionModes := by
  simp [butterflyCompleteActionModes]

theorem butterflySeedModes_subset_completeAction :
    butterflySeedModes ⊆ butterflyCompleteActionModes := by
  intro wave waveMem
  rw [butterflyCompleteActionModes, Finset.mem_erase]
  exact ⟨fun waveZero =>
      butterflySeedModes_zero_not_mem (waveZero ▸ waveMem),
    modes_subset_wholeFiniteSupportActionModes butterflySeedModes waveMem⟩

set_option maxHeartbeats 100000000 in
theorem butterflyCompleteRationalWholePowerJet_eq :
    butterflyCompleteRationalWholePowerJet = 53707 / 250 := by
  with_unfolding_all rfl

theorem butterflyCompleteRationalWholePowerJet_pos :
    0 < butterflyCompleteRationalWholePowerJet := by
  rw [butterflyCompleteRationalWholePowerJet_eq]
  norm_num

theorem butterflyGainPhysicalState_supported_on_completeAction
    (wave : IntegerWavevector)
    (waveNotMem : wave ∉ butterflyCompleteActionModes) :
    butterflyPhysicalState 1 wave = 0 := by
  apply butterflyPhysicalState_supported 1 wave
  intro waveMem
  exact waveNotMem (butterflySeedModes_subset_completeAction waveMem)

theorem butterflyCompleteRationalState_toComplex
    (wave : IntegerWavevector) :
    GaussianRatVector.toComplex (butterflyCompleteRationalState wave) =
      butterflyPhysicalState 1 wave := by
  simpa [butterflyCompleteRationalState,
    butterflyRationalSeedStateAt] using
    (butterflyGainRationalSeedState_toComplex wave :
      GaussianRatVector.toComplex
          (butterflyRationalSeedStateAt 1 wave) =
        butterflyPhysicalState 1 wave)

theorem butterflyCompleteRationalState_eq :
    butterflyCompleteRationalState = butterflyRationalSeedStateAt 1 := by
  rfl

theorem butterflyCompleteRationalTangent_toComplex
    (wave : IntegerWavevector) :
    GaussianRatVector.toComplex (butterflyCompleteRationalTangent wave) =
      butterflyGainPhysicalActionState wave := by
  unfold butterflyCompleteRationalTangent
  rw [butterflyCompleteRationalState_eq]
  exact butterflyGainRationalTangentState_toComplex wave

theorem butterflyGainPhysicalActionState_eq_completeFiniteGenerator
    (wave : IntegerWavevector) (waveMem : wave ∈ butterflyCompleteActionModes) :
    butterflyGainPhysicalActionState wave =
      finiteStateVorticityGenerator butterflyCompleteActionModes
        butterflyGainViscosity.coeff (butterflyPhysicalState 1) wave := by
  rw [butterflyGainPhysicalActionState,
    wholeFiniteSupportActionState_apply_eq_wholeTangent
      butterflyGainViscosity.coeff butterflySeedModes
      (butterflyPhysicalState 1)
      (butterflyPhysicalState_supported 1) wave]
  unfold wholeLatticeVorticityFourierTangentAt
  rw [wholeStateVorticityNonlinearCoefficientAt_eq_finite_of_supported
    butterflyCompleteActionModes (butterflyPhysicalState 1)
    butterflyGainPhysicalState_supported_on_completeAction wave]
  rw [finiteStateVorticityGenerator_apply, if_pos waveMem]

theorem butterflyCompleteRationalLinearized_toComplex
    (wave : IntegerWavevector) (waveMem : wave ∈ butterflyCompleteActionModes) :
    GaussianRatVector.toComplex
        (butterflyCompleteRationalLinearized wave) =
      finiteGeneratorLinearizationAt butterflyCompleteActionModes
        butterflyGainViscosity.coeff (butterflyPhysicalState 1)
        butterflyGainPhysicalActionState wave := by
  have rightBridge := rationalVorticityBilinearCoefficientAt_toComplex
    butterflyCompleteActionModes
    butterflyCompleteRationalTangent butterflyCompleteRationalState
    butterflyGainPhysicalActionState (butterflyPhysicalState 1) wave
    butterflyCompleteActionModes_zero_not_mem
    (fun actual _actualMem =>
      butterflyCompleteRationalTangent_toComplex actual)
    (fun actual _actualMem =>
      butterflyCompleteRationalState_toComplex actual)
  have leftBridge := rationalVorticityBilinearCoefficientAt_toComplex
    butterflyCompleteActionModes
    butterflyCompleteRationalState butterflyCompleteRationalTangent
    (butterflyPhysicalState 1) butterflyGainPhysicalActionState wave
    butterflyCompleteActionModes_zero_not_mem
    (fun actual _actualMem =>
      butterflyCompleteRationalState_toComplex actual)
    (fun actual _actualMem =>
      butterflyCompleteRationalTangent_toComplex actual)
  rw [butterflyCompleteRationalLinearized,
    GaussianRatVector.toComplex_sub,
    GaussianRatVector.toComplex_add_instance,
    GaussianRatVector.toComplex_ratScale,
    rightBridge, leftBridge,
    butterflyCompleteRationalTangent_toComplex]
  unfold finiteGeneratorLinearizationAt
  rw [finiteComplexVorticityState_apply, if_pos waveMem]
  congr 1
  have scalarEq :
      ((((1 / 100) * rationalIntegerWaveNormSq wave : ℚ) : ℝ) : ℂ) =
        ((butterflyGainViscosity.coeff *
          integerWaveViscousMultiplier wave : ℝ) : ℂ) := by
    congr 1
    rw [Rat.cast_mul, rationalIntegerWaveNormSq_cast,
      integerWaveViscousMultiplier]
    calc
      ((1 / 100 : ℚ) : ℝ) * integerWaveNormSq wave =
          (butterflyGainViscosity.coeff * (2 * Real.pi) ^ 2) *
            integerWaveNormSq wave := by
              rw [butterflyGainViscosity_scaled]
      _ = butterflyGainViscosity.coeff *
          ((2 * Real.pi) ^ 2 * integerWaveNormSq wave) := by ring
  rw [scalarEq]
  rfl

theorem butterflyCompletePhysicalActionEnergy_eq :
    (∑ wave ∈ butterflyCompleteActionModes,
      complexCoordinateRealInner
        (butterflyGainPhysicalActionState wave)
        (finiteStateVorticityGenerator butterflyCompleteActionModes
          butterflyGainViscosity.coeff (butterflyPhysicalState 1) wave)) =
      (butterflyCompleteRationalTangentEnergy : Real) := by
  calc
    _ = ∑ wave ∈ butterflyCompleteActionModes,
        (gaussianRatVectorRealInner
          (butterflyCompleteRationalTangent wave)
          (butterflyCompleteRationalTangent wave) : Real) := by
      apply Finset.sum_congr rfl
      intro wave waveMem
      rw [← butterflyCompleteRationalTangent_toComplex,
        ← butterflyGainPhysicalActionState_eq_completeFiniteGenerator
          wave waveMem,
        ← butterflyCompleteRationalTangent_toComplex,
        complexCoordinateRealInner_gaussianRat_toComplex]
    _ = (butterflyCompleteRationalTangentEnergy : Real) := by
      norm_cast

theorem butterflyCompletePhysicalLinearWriteback_eq :
    (∑ wave ∈ butterflyCompleteActionModes,
      complexCoordinateRealInner (butterflyPhysicalState 1 wave)
        (finiteGeneratorLinearizationAt butterflyCompleteActionModes
          butterflyGainViscosity.coeff (butterflyPhysicalState 1)
          butterflyGainPhysicalActionState wave)) =
      (butterflyCompleteRationalLinearWriteback : Real) := by
  rw [← Finset.sum_subset butterflySeedModes_subset_completeAction
    (fun wave _waveMem waveNotSource => by
      rw [butterflyPhysicalState_supported 1 wave waveNotSource]
      simp [complexCoordinateRealInner])]
  calc
    _ = ∑ wave ∈ butterflySeedModes,
        (gaussianRatVectorRealInner
          (butterflyCompleteRationalState wave)
          (butterflyCompleteRationalLinearized wave) : Real) := by
      apply Finset.sum_congr rfl
      intro wave waveMem
      rw [← butterflyCompleteRationalState_toComplex,
        ← butterflyCompleteRationalLinearized_toComplex wave
          (butterflySeedModes_subset_completeAction waveMem),
        complexCoordinateRealInner_gaussianRat_toComplex]
    _ = (butterflyCompleteRationalLinearWriteback : Real) := by
      norm_cast

theorem butterflyCompletePhysicalWorkDerivative_eq :
    2 * finiteGeneratorRealWorkDerivativeAt butterflyCompleteActionModes
        butterflyGainViscosity.coeff (butterflyPhysicalState 1)
        butterflyGainPhysicalActionState =
      (butterflyCompleteRationalWholePowerJet : Real) := by
  unfold finiteGeneratorRealWorkDerivativeAt
  rw [Finset.sum_add_distrib,
    butterflyCompletePhysicalActionEnergy_eq,
    butterflyCompletePhysicalLinearWriteback_eq]
  change
    2 * ((butterflyCompleteRationalTangentEnergy : Real) +
      (butterflyCompleteRationalLinearWriteback : Real)) =
        (butterflyCompleteRationalWholePowerJet : Real)
  unfold butterflyCompleteRationalWholePowerJet
  push_cast
  rfl

theorem butterflyCompletePhysicalWorkDerivative_pos :
    0 < finiteGeneratorRealWorkDerivativeAt butterflyCompleteActionModes
      butterflyGainViscosity.coeff (butterflyPhysicalState 1)
      butterflyGainPhysicalActionState := by
  have jetPos : (0 : Real) <
      (butterflyCompleteRationalWholePowerJet : Real) := by
    exact_mod_cast butterflyCompleteRationalWholePowerJet_pos
  nlinarith [butterflyCompletePhysicalWorkDerivative_eq]

theorem butterflyGainPhysicalActionState_supported_on_completeAction
    (wave : IntegerWavevector)
    (waveNotMem : wave ∉ butterflyCompleteActionModes) :
    butterflyGainPhysicalActionState wave = 0 := by
  unfold butterflyGainPhysicalActionState
  by_cases waveZero : wave = 0
  · subst wave
    rw [wholeFiniteSupportActionState_apply_eq_wholeTangent
      butterflyGainViscosity.coeff butterflySeedModes
      (butterflyPhysicalState 1)
      (butterflyPhysicalState_supported 1) 0]
    exact wholeLatticeVorticityFourierTangentAt_zero
      butterflyGainViscosity.coeff (butterflyPhysicalState 1)
      (butterflyPhysicalState_transverse 1)
      (butterflyPhysicalState_zero 1)
  · apply wholeFiniteSupportActionState_supported
    intro waveMem
    exact waveNotMem (Finset.mem_erase.mpr ⟨waveZero, waveMem⟩)

theorem butterflyCompleteFiniteGenerator_eq_action :
    finiteStateVorticityGenerator butterflyCompleteActionModes
        butterflyGainViscosity.coeff (butterflyPhysicalState 1) =
      butterflyGainPhysicalActionState := by
  apply lp.ext
  funext wave
  by_cases waveMem : wave ∈ butterflyCompleteActionModes
  · exact (butterflyGainPhysicalActionState_eq_completeFiniteGenerator
      wave waveMem).symm
  · rw [finiteStateVorticityGenerator_apply, if_neg waveMem,
      butterflyGainPhysicalActionState_supported_on_completeAction
        wave waveMem]

theorem butterflyCompleteFiniteAugmentedMass_eq :
    finiteAugmentedCoefficientMass butterflyCompleteActionModes
        (butterflyPhysicalState 1) = 25 := by
  unfold finiteAugmentedCoefficientMass
  rw [← wholeVorticityEuclideanMass_eq_finite_of_supported
    butterflyCompleteActionModes (butterflyPhysicalState 1)
    butterflyGainPhysicalState_supported_on_completeAction]
  rw [butterflyPhysicalState_one_coefficientMass_eq]
  norm_num

theorem butterflyCompleteFiniteGeneratorWork_eq :
    finiteGeneratorRealWork butterflyCompleteActionModes
        butterflyGainViscosity.coeff (butterflyPhysicalState 1) =
      (157 / 50 : Real) := by
  unfold finiteGeneratorRealWork
  rw [← Finset.sum_subset butterflySeedModes_subset_completeAction
    (fun wave _waveMem waveNotSeed => by
      rw [butterflyPhysicalState_supported 1 wave waveNotSeed]
      simp [complexCoordinateRealInner])]
  calc
    (∑ wave ∈ butterflySeedModes,
        complexCoordinateRealInner (butterflyPhysicalState 1 wave)
          (finiteStateVorticityGenerator butterflyCompleteActionModes
            butterflyGainViscosity.coeff (butterflyPhysicalState 1) wave)) =
        ∑ wave ∈ butterflySeedModes,
          complexCoordinateRealInner (butterflyPhysicalState 1 wave)
            (butterflyGainPhysicalActionState wave) := by
      apply Finset.sum_congr rfl
      intro wave waveMem
      rw [butterflyGainPhysicalActionState_eq_completeFiniteGenerator
        wave (butterflySeedModes_subset_completeAction waveMem)]
    _ = (157 / 50 : Real) :=
      butterflyGainPhysicalEnstrophyTangentPairing_eq

theorem butterflyCompleteNormalizedWorkRawDerivative_pos :
    0 < finiteNormalizedWorkRawDerivative butterflyCompleteActionModes
      butterflyGainViscosity.coeff (butterflyPhysicalState 1)
      (finiteGeneratorRealWorkDerivativeAt butterflyCompleteActionModes
        butterflyGainViscosity.coeff (butterflyPhysicalState 1)
        butterflyGainPhysicalActionState) := by
  let derivative := finiteGeneratorRealWorkDerivativeAt
    butterflyCompleteActionModes butterflyGainViscosity.coeff
      (butterflyPhysicalState 1) butterflyGainPhysicalActionState
  have derivativeEq : derivative = (53707 / 500 : Real) := by
    dsimp only [derivative]
    have wholeJet : (butterflyCompleteRationalWholePowerJet : Real) =
        (53707 / 250 : Real) := by
      rw [butterflyCompleteRationalWholePowerJet_eq]
      norm_num
    nlinarith [butterflyCompletePhysicalWorkDerivative_eq]
  have massPos : (0 : Real) < 25 := by norm_num
  have quarterPowerPos :
      0 < (25 : Real) ^ (1 / 4 : Real) :=
    Real.rpow_pos_of_pos massPos _
  have fiveQuarterPower :
      (25 : Real) ^ (5 / 4 : Real) =
        25 * (25 : Real) ^ (1 / 4 : Real) := by
    calc
      (25 : Real) ^ (5 / 4 : Real) =
          (25 : Real) ^ ((1 : Real) + 1 / 4) := by
            congr 1
            norm_num
      _ = (25 : Real) ^ (1 : Real) *
          (25 : Real) ^ (1 / 4 : Real) := by
            rw [Real.rpow_add massPos]
      _ = _ := by rw [Real.rpow_one]
  unfold finiteNormalizedWorkRawDerivative
  rw [butterflyCompleteFiniteAugmentedMass_eq,
    butterflyCompleteFiniteGeneratorWork_eq]
  dsimp only [derivative] at derivativeEq
  rw [derivativeEq]
  norm_num
  rw [fiveQuarterPower]
  have denominatorPos :
      0 < ((25 : Real) * (25 : Real) ^ (1 / 4 : Real)) ^ 2 :=
    sq_pos_of_pos (mul_pos massPos quarterPowerPos)
  apply div_pos _ denominatorPos
  nlinarith

theorem butterflyCompleteNormalizedWorkDirectionalDerivative_pos :
    0 < finiteNormalizedWorkDirectionalDerivative
      butterflyCompleteActionModes butterflyGainViscosity.coeff
        (butterflyPhysicalState 1) := by
  obtain ⟨trajectory, initial, epsilon, epsilonPos, actual⟩ :=
    exists_finiteStateVorticity_localTrajectory
      butterflyCompleteActionModes butterflyGainViscosity.coeff
        (butterflyPhysicalState 1)
  have actualZero := actual 0 ⟨by linarith, by linarith⟩
  have workDerivative := finiteGeneratorRealWork_hasDerivAt
    butterflyCompleteActionModes butterflyGainViscosity.coeff trajectory 0
      (finiteStateVorticityGenerator butterflyCompleteActionModes
        butterflyGainViscosity.coeff (trajectory 0)) actualZero
  have rawEq := finiteNormalizedWorkDirectionalDerivative_eq_raw
    butterflyCompleteActionModes butterflyGainViscosity.coeff trajectory 0
      (finiteGeneratorRealWorkDerivativeAt butterflyCompleteActionModes
        butterflyGainViscosity.coeff (butterflyPhysicalState 1)
        butterflyGainPhysicalActionState)
      actualZero (by
        simpa only [initial, butterflyCompleteFiniteGenerator_eq_action]
          using workDerivative)
  rw [initial] at rawEq
  rw [rawEq]
  exact butterflyCompleteNormalizedWorkRawDerivative_pos

theorem butterflyPhysicalState_completeActualNormalizedJet_pos :
    0 < finiteNormalizedWorkActualJet butterflyCompleteActionModes
      butterflyGainViscosity.coeff (butterflyPhysicalState 1) := by
  rw [finiteNormalizedWorkActualJet_eq_resolved_of_supported
    butterflyCompleteActionModes butterflyGainViscosity.coeff
      (butterflyPhysicalState 1)
      butterflyGainPhysicalState_supported_on_completeAction]
  exact butterflyCompleteNormalizedWorkDirectionalDerivative_pos

theorem butterflyPhysicalState_completeNormalizedWork_pos :
    0 < finiteNormalizedGeneratorWork butterflyCompleteActionModes
      butterflyGainViscosity.coeff (butterflyPhysicalState 1) := by
  unfold finiteNormalizedGeneratorWork
  rw [butterflyCompleteFiniteGeneratorWork_eq]
  exact div_pos (by norm_num)
    (Real.rpow_pos_of_pos
      (finiteAugmentedCoefficientMass_pos butterflyCompleteActionModes
        (butterflyPhysicalState 1)) _)

end
