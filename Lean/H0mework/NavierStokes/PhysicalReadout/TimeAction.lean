noncomputable section

local instance : MeasureSpace UnitAddCircle := ⟨AddCircle.haarAddCircle⟩

variable {nu : Viscosity} {initial : ComplexVorticityHilbertState} {T : ℝ}

abbrev PhysicalField := Lp PhysicalSpace 2 (volume : Measure Torus)

/-- Complete physical acceleration generated by the original receipt's whole tangent. -/
def physicalTangent (receipt : WholeContinuousMildSerrinReceipt nu initial T) : ℝ → PhysicalField :=
  fun time => physicalCLM (velocityTangent receipt time)

def physicalTangentLp (receipt : WholeContinuousMildSerrinReceipt nu initial T) :
    Lp PhysicalField 2 (commonTimeMeasure T) :=
  (physicalCLM.compLpL 2 (commonTimeMeasure T)) (velocityTangentLp receipt)

theorem physicalTangentLp_apply (receipt : WholeContinuousMildSerrinReceipt nu initial T) :
    ∀ᵐ time ∂commonTimeMeasure T,
      physicalTangentLp receipt time = physicalTangent receipt time.1 := by
  filter_upwards [physicalCLM.coeFn_compLpL (velocityTangentLp receipt)] with time actual
  rw [physicalTangentLp, actual, physicalTangent, velocityTangent,
    commonTimeZeroExtension_of_mem T _ time.1 time.2]

theorem physicalTangent_intervalIntegrable (receipt : WholeContinuousMildSerrinReceipt nu initial T) :
    IntervalIntegrable (physicalTangent receipt) volume 0 T :=
  ⟨physicalCLM.integrable_comp (velocityTangent_intervalIntegrable receipt).1,
    physicalCLM.integrable_comp (velocityTangent_intervalIntegrable receipt).2⟩

/-- Exact complete-space impulse on every original physical subinterval. -/
theorem physical_integral_write (receipt : WholeContinuousMildSerrinReceipt nu initial T)
    (time : Icc (0 : ℝ) T) :
    (∫ actual in 0..time.1, physicalTangent receipt actual) =
      receiptField receipt time - realField (wholeBiotSavartVelocityState initial) := by
  have integrableAt := (velocityTangent_intervalIntegrable receipt).mono_set (by
    rw [uIcc_of_le time.2.1, uIcc_of_le receipt.requestedTimePos.le]
    exact Icc_subset_Icc le_rfl time.2.2)
  change (∫ actual in 0..time.1, physicalCLM (velocityTangent receipt actual)) = _
  rw [physicalCLM.intervalIntegral_comp_comm integrableAt,
    velocity_integral_write receipt time, map_sub, ← receiptField_eq_physicalCLM]
  congr 1
  change realField (NativeEndpointVelocityCarrier.wholeVelocity
    (puncturedWholeVelocityEuclideanState initial)) = _
  rw [NativeEndpointVelocityCarrier.wholeVelocity_punctured]

def physicalPrimitive (receipt : WholeContinuousMildSerrinReceipt nu initial T) : ℝ → PhysicalField :=
  fun time => physicalCLM (velocityPrimitive receipt time)

theorem physical_write (receipt : WholeContinuousMildSerrinReceipt nu initial T)
    (time : Icc (0 : ℝ) T) :
    receiptField receipt time = physicalPrimitive receipt time.1 := by
  rw [receiptField_eq_physicalCLM, velocity_write receipt time]
  rfl

theorem physicalPrimitive_ae_hasDerivAt (receipt : WholeContinuousMildSerrinReceipt nu initial T) :
    ∀ᵐ time : ℝ, time ∈ uIcc (0 : ℝ) T →
      HasDerivAt (physicalPrimitive receipt) (physicalTangent receipt time) time := by
  filter_upwards [velocityPrimitive_ae_hasDerivAt receipt] with time derivative inside
  exact physicalCLM.hasFDerivAt.comp_hasDerivAt time (derivative inside)

/-- The physical all-frequency impulse writes the literal next of the original occurrence. -/
theorem occurrence_physical_write (current : GeneratedWholeRestartCurrent nu) (index : ℕ) :
    let occurrence := generatedWholeRestartNativeActualOccurrence current index
    (∫ actual in 0..occurrence.response.1.contact.time.1,
      physicalTangent (occurrenceReceipt occurrence) actual) =
      realField (wholeBiotSavartVelocityState occurrence.response.1.contact.physicalState) -
        realField (wholeBiotSavartVelocityState (run current index).contact.physicalState) := by
  let occurrence := generatedWholeRestartNativeActualOccurrence current index
  exact physical_integral_write (occurrenceReceipt occurrence)
    ⟨_, (occurrenceReceipt occurrence).requestedTimePos.le, le_rfl⟩

end
end SaturationMonoid.NavierStokes.NativePhysicalTimeAction
