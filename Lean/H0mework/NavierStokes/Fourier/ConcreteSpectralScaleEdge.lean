/-!
# A concrete source-owned spectral scale edge for three-dimensional vorticity

The smooth bump filter is an actual Navier--Stokes realization, but its
multiplier defect on the orthogonal concrete pair first appears at fourth
order.  This module instead realizes the source grammar by the sharp unit
Fourier shell

```text
m(k) = 1  if |k|² ≤ 1,
m(k) = 0  otherwise.
```

This is a native scale update, not an observer chosen after seeing a target.
It acts on the whole raw coefficient table, preserves the source inventory,
commutes with reality symmetrization, transverse projection, Biot--Savart
inversion, and the finite full-signed physical compiler, and forms an
`EffectiveResidualProcess` with its uniquely forced complementary trace.

For the already generated concrete closed triad, the scale law retains the
two input waves and removes their output.  The selected full vorticity
nonlinear row has zero advection part and stretching row
`(-1/4, 0, 0)`.  Its source-filter/output-filter commutator is therefore the
same nonzero row, with multiplier defect exactly one.  No pair, target,
nonzero witness, observer faithfulness, or coverage statement is accepted as
a premise.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalVorticityCoefficientConcreteSpectralScaleEdge

open scoped BigOperators Matrix

open Matrix
open AffineRelaxation
open ResidualProjection
open ThreeDimensionalPeriodicCoarseFilterCore
open ThreeDimensionalPeriodicFullVorticityStretching
open ThreeDimensionalPeriodicIntegerCharacterCoarseFilter
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientPhysicalCompiler
open ThreeDimensionalVorticityCoefficientStretchingPairTable
open ThreeDimensionalVorticityCoefficientCoarseFilterProcess
open ThreeDimensionalVorticityCoefficientConcreteActivePair
open ThreeDimensionalVorticityCoefficientConcreteActiveClosedTriad
open ThreeDimensionalVorticityCoefficientConcreteNonlinearOutput
open ThreeDimensionalVorticityCoefficientNonlinearPairGenerator
open ThreeDimensionalVorticityCoefficientNonlinearPhysicalBridge

noncomputable section

/-! ## Source-owned unit-shell multiplier -/

/-- Sharp projection multiplier generated by the integer unit shell. -/
def unitShellSharpMultiplier
    (wave : IntegerWavevector) : ℝ :=
  if integerWaveNormSq wave ≤ 1 then 1 else 0

/-- The norm-shell law is invariant under the source's frequency negation. -/
@[simp] theorem unitShellSharpMultiplier_waveNeg
    (wave : IntegerWavevector) :
    unitShellSharpMultiplier (waveNeg wave) =
      unitShellSharpMultiplier wave := by
  simp [unitShellSharpMultiplier]

/-- The generated multiplier is a projection at every frequency. -/
@[simp] theorem unitShellSharpMultiplier_mul_self
    (wave : IntegerWavevector) :
    unitShellSharpMultiplier wave * unitShellSharpMultiplier wave =
      unitShellSharpMultiplier wave := by
  by_cases retained : integerWaveNormSq wave ≤ 1 <;>
    simp [unitShellSharpMultiplier, retained]

/-! ## Native raw-source update and whole coefficient keep -/

/--
Apply the generated unit-shell projection to the complete raw coefficient
table while retaining the source-owned finite inventory.
-/
def unitShellSharpSourceUpdate
    (source : RawVorticityFourierSource) :
    RawVorticityFourierSource where
  activeModes := source.activeModes
  rawVorticity := fun wave =>
    (unitShellSharpMultiplier wave : ℂ) • source.rawVorticity wave

@[simp] theorem unitShellSharpSourceUpdate_activeModes
    (source : RawVorticityFourierSource) :
    (unitShellSharpSourceUpdate source).activeModes =
      source.activeModes :=
  rfl

@[simp] theorem unitShellSharpSourceUpdate_generatedSupport
    (source : RawVorticityFourierSource) :
    generatedSupport (unitShellSharpSourceUpdate source) =
      generatedSupport source :=
  rfl

/-- Whole-carrier coefficient keep generated by the unit-shell scale law. -/
def unitShellCoefficientKeep :
    VorticityCoefficientCarrier →ₗ[ℂ] VorticityCoefficientCarrier where
  toFun := fun coefficient wave =>
    (unitShellSharpMultiplier wave : ℂ) • coefficient wave
  map_add' := by
    intro left right
    funext wave coordinate
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    ring
  map_smul' := by
    intro scalar coefficient
    funext wave coordinate
    simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
    ring

@[simp] theorem unitShellCoefficientKeep_apply
    (coefficient : VorticityCoefficientCarrier)
    (wave : IntegerWavevector) :
    unitShellCoefficientKeep coefficient wave =
      (unitShellSharpMultiplier wave : ℂ) • coefficient wave :=
  rfl

/-- The whole-carrier keep is an actual idempotent projection. -/
@[simp] theorem unitShellCoefficientKeep_idempotent
    (coefficient : VorticityCoefficientCarrier) :
    unitShellCoefficientKeep (unitShellCoefficientKeep coefficient) =
      unitShellCoefficientKeep coefficient := by
  funext wave coordinate
  by_cases retained : integerWaveNormSq wave ≤ 1 <;>
    simp [unitShellCoefficientKeep, unitShellSharpMultiplier, retained]

/-- The discarded complement is forced into the keep's kernel. -/
theorem unitShellCoefficientKeep_discarded_kernel
    (coefficient : VorticityCoefficientCarrier) :
    unitShellCoefficientKeep
        (coefficient - unitShellCoefficientKeep coefficient) = 0 := by
  rw [map_sub, unitShellCoefficientKeep_idempotent]
  simp

theorem supportedRawVorticity_unitShellSharpSourceUpdate
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) :
    supportedRawVorticity (unitShellSharpSourceUpdate source) wave =
      (unitShellSharpMultiplier wave : ℂ) •
        supportedRawVorticity source wave := by
  by_cases membership : wave ∈ source.activeModes
  · simp [supportedRawVorticity, unitShellSharpSourceUpdate, membership]
  · simp [supportedRawVorticity, unitShellSharpSourceUpdate, membership]

theorem realitySymmetrizedVorticity_unitShellSharpSourceUpdate
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) :
    realitySymmetrizedVorticity (unitShellSharpSourceUpdate source) wave =
      (unitShellSharpMultiplier wave : ℂ) •
        realitySymmetrizedVorticity source wave := by
  funext coordinate
  unfold realitySymmetrizedVorticity
  rw [supportedRawVorticity_unitShellSharpSourceUpdate,
    supportedRawVorticity_unitShellSharpSourceUpdate,
    unitShellSharpMultiplier_waveNeg]
  simp only [Pi.smul_apply, smul_eq_mul, map_mul,
    Complex.star_def, Complex.conj_ofReal]
  ring

/--
The native update commutes with every generated vorticity coefficient on the
whole integer-wave carrier.
-/
theorem generatedVorticityCoefficient_unitShellSharpSourceUpdate
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) :
    generatedVorticityCoefficient (unitShellSharpSourceUpdate source) wave =
      unitShellCoefficientKeep
        (generatedVorticityCoefficient source) wave := by
  by_cases membership : wave ∈ generatedSupport source
  · rw [generatedVorticityCoefficient,
      unitShellSharpSourceUpdate_generatedSupport,
      if_pos membership,
      realitySymmetrizedVorticity_unitShellSharpSourceUpdate,
      transverseProjection_smul,
      unitShellCoefficientKeep_apply,
      generatedVorticityCoefficient,
      if_pos membership]
  · rw [generatedVorticityCoefficient,
      unitShellSharpSourceUpdate_generatedSupport,
      if_neg membership,
      unitShellCoefficientKeep_apply,
      generatedVorticityCoefficient,
      if_neg membership]
    rw [smul_zero]

/-- The same actual keep commutes with Biot--Savart velocity generation. -/
theorem generatedVelocityCoefficient_unitShellSharpSourceUpdate
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) :
    generatedVelocityCoefficient (unitShellSharpSourceUpdate source) wave =
      unitShellCoefficientKeep
        (generatedVelocityCoefficient source) wave := by
  unfold generatedVelocityCoefficient
  rw [generatedVorticityCoefficient_unitShellSharpSourceUpdate,
    unitShellCoefficientKeep_apply,
    biotSavartVelocityCoefficient_smul,
    unitShellCoefficientKeep_apply]

/-! ## Effective residual transport and forced trace -/

/-- The generated vorticity table transported by the native spectral edge. -/
def unitShellVorticityCoefficientProcess :
    EffectiveResidualProcess ℂ VorticityCoefficientCarrier
      RawVorticityFourierSource where
  target := 0
  keep := unitShellCoefficientKeep
  residual := generatedVorticityCoefficient
  update := unitShellSharpSourceUpdate
  residual_transport_law := by
    intro source
    funext wave
    exact
      generatedVorticityCoefficient_unitShellSharpSourceUpdate
        source wave

/-- Old residual equals actual next residual plus its forced complement. -/
theorem unitShellVorticityCoefficientProcess_residual_split
    (source : RawVorticityFourierSource) :
    generatedVorticityCoefficient source =
      generatedVorticityCoefficient
          (unitShellSharpSourceUpdate source) +
        linearResidualTrace unitShellCoefficientKeep
          (generatedVorticityCoefficient source) := by
  exact
    effectiveProcess_residual_eq_next_residual_add_trace
      unitShellVorticityCoefficientProcess source

/-- No independently supplied trace can alter the native scale split. -/
theorem unitShellVorticityCoefficientProcess_trace_unique
    (source : RawVorticityFourierSource)
    (trace : VorticityCoefficientCarrier) :
    generatedVorticityCoefficient source =
        generatedVorticityCoefficient
            (unitShellSharpSourceUpdate source) + trace ↔
      trace = linearResidualTrace unitShellCoefficientKeep
        (generatedVorticityCoefficient source) := by
  exact
    effectiveProcess_trace_unique
      unitShellVorticityCoefficientProcess source trace

/-! ## Finite full-signed physical projection -/

/--
Actual finite full-signed Fourier realization after the source-generated
unit-shell keep.  The finite inventory is explicit; no inverse Fourier map on
arbitrary physical fields is postulated.
-/
def finiteUnitShellSharpSpectralProjection
    (modes : Finset IntegerWavevector)
    (coefficient : VorticityCoefficientCarrier) :
    PhysicalSpace → PhysicalSpace :=
  finiteRealComplexFourierField modes
    (unitShellCoefficientKeep coefficient)

/--
The native raw-source edge and its finite physical realization form the
whole-carrier compiler square.
-/
theorem physicalVelocity_unitShellSharpSourceUpdate
    (source : RawVorticityFourierSource) :
    physicalVelocity (unitShellSharpSourceUpdate source) =
      finiteUnitShellSharpSpectralProjection
        (generatedSupport source)
        (generatedVelocityCoefficient source) := by
  rw [physicalVelocity,
    unitShellSharpSourceUpdate_generatedSupport]
  have coefficientEquality :
      generatedVelocityCoefficient
          (unitShellSharpSourceUpdate source) =
        unitShellCoefficientKeep
          (generatedVelocityCoefficient source) := by
    funext wave
    exact
      generatedVelocityCoefficient_unitShellSharpSourceUpdate
        source wave
  rw [coefficientEquality]
  rfl

/--
The full nonlinear source compiler consumes the sharp spectral velocity
produced by the same native edge.
-/
theorem unitShellSharpUpdatedNonlinearity_physicalCompiler
    (source : RawVorticityFourierSource) :
    generatedVorticityNonlinearPairField
        (unitShellSharpSourceUpdate source) =
      -vorticityAdvection
          (finiteUnitShellSharpSpectralProjection
            (generatedSupport source)
            (generatedVelocityCoefficient source)) +
        vortexStretching
          (finiteUnitShellSharpSpectralProjection
            (generatedSupport source)
            (generatedVelocityCoefficient source)) := by
  calc
    generatedVorticityNonlinearPairField
        (unitShellSharpSourceUpdate source) =
      -vorticityAdvection
          (physicalVelocity (unitShellSharpSourceUpdate source)) +
        vortexStretching
          (physicalVelocity (unitShellSharpSourceUpdate source)) :=
      generatedVorticityNonlinearPairField_eq_physicalNonlinearity _
    _ = _ := by
      rw [physicalVelocity_unitShellSharpSourceUpdate]

/-! ## Nonlinear pair transport and forced row commutator -/

/-- Product keep generated on an ordered nonlinear pair. -/
def unitShellSharpPairMultiplier
    (pair : StretchingPair) : ℂ :=
  (unitShellSharpMultiplier pair.1 : ℂ) *
    (unitShellSharpMultiplier pair.2 : ℂ)

/-- Difference between source-first and output-first spectral transport. -/
def unitShellSharpPairMultiplierDefect
    (pair : StretchingPair) : ℂ :=
  unitShellSharpPairMultiplier pair -
    (unitShellSharpMultiplier (stretchingPairOutput pair) : ℂ)

theorem generatedStretchingPairContribution_unitShellSharpSourceUpdate
    (source : RawVorticityFourierSource)
    (pair : StretchingPair) :
    generatedStretchingPairContribution
        (unitShellSharpSourceUpdate source) pair =
      unitShellSharpPairMultiplier pair •
        generatedStretchingPairContribution source pair := by
  rw [generatedStretchingPairContribution,
    generatedStretchingPairContribution,
    generatedVorticityCoefficient_unitShellSharpSourceUpdate,
    generatedVelocityCoefficient_unitShellSharpSourceUpdate,
    unitShellCoefficientKeep_apply,
    unitShellCoefficientKeep_apply]
  funext coordinate
  simp [unitShellSharpPairMultiplier, dotProduct_smul]
  ring

theorem generatedVorticityAdvectionPairContribution_unitShellSharpSourceUpdate
    (source : RawVorticityFourierSource)
    (pair : StretchingPair) :
    generatedVorticityAdvectionPairContribution
        (unitShellSharpSourceUpdate source) pair =
      unitShellSharpPairMultiplier pair •
        generatedVorticityAdvectionPairContribution source pair := by
  rw [generatedVorticityAdvectionPairContribution,
    generatedVorticityAdvectionPairContribution,
    generatedVelocityCoefficient_unitShellSharpSourceUpdate,
    generatedVorticityCoefficient_unitShellSharpSourceUpdate,
    unitShellCoefficientKeep_apply,
    unitShellCoefficientKeep_apply]
  funext coordinate
  simp [unitShellSharpPairMultiplier, dotProduct_smul]
  ring

theorem generatedVorticityNonlinearPairContribution_unitShellSharpSourceUpdate
    (source : RawVorticityFourierSource)
    (pair : StretchingPair) :
    generatedVorticityNonlinearPairContribution
        (unitShellSharpSourceUpdate source) pair =
      unitShellSharpPairMultiplier pair •
        generatedVorticityNonlinearPairContribution source pair := by
  rw [generatedVorticityNonlinearPairContribution,
    generatedStretchingPairContribution_unitShellSharpSourceUpdate,
    generatedVorticityAdvectionPairContribution_unitShellSharpSourceUpdate,
    generatedVorticityNonlinearPairContribution,
    smul_sub]

/-- One exact row of the source-filter/output-filter commutator. -/
def unitShellSharpNonlinearPairCommutator
    (source : RawVorticityFourierSource)
    (pair : StretchingPair) : ComplexCoordinateVector :=
  generatedVorticityNonlinearPairContribution
      (unitShellSharpSourceUpdate source) pair -
    (unitShellSharpMultiplier (stretchingPairOutput pair) : ℂ) •
      generatedVorticityNonlinearPairContribution source pair

/-- The commutator row is uniquely forced by the multiplier defect. -/
theorem unitShellSharpNonlinearPairCommutator_eq_defect_smul
    (source : RawVorticityFourierSource)
    (pair : StretchingPair) :
    unitShellSharpNonlinearPairCommutator source pair =
      unitShellSharpPairMultiplierDefect pair •
        generatedVorticityNonlinearPairContribution source pair := by
  rw [unitShellSharpNonlinearPairCommutator,
    generatedVorticityNonlinearPairContribution_unitShellSharpSourceUpdate]
  exact
    (sub_smul
      (unitShellSharpPairMultiplier pair)
      (unitShellSharpMultiplier (stretchingPairOutput pair) : ℂ)
      (generatedVorticityNonlinearPairContribution source pair)).symm

/-! ## Premise-free concrete kernel escape -/

@[simp] theorem unitShellSharpMultiplier_concreteAdvectingWave :
    unitShellSharpMultiplier concreteAdvectingWave = 1 := by
  norm_num [unitShellSharpMultiplier, integerWaveNormSq,
    concreteAdvectingWave, Fin.sum_univ_succ]

@[simp] theorem unitShellSharpMultiplier_concreteTransportedWave :
    unitShellSharpMultiplier concreteTransportedWave = 1 := by
  norm_num [unitShellSharpMultiplier, integerWaveNormSq,
    concreteTransportedWave, Fin.sum_univ_succ]

@[simp] theorem unitShellSharpMultiplier_concreteStretchingOutput :
    unitShellSharpMultiplier concreteStretchingOutput = 0 := by
  norm_num [unitShellSharpMultiplier, integerWaveNormSq,
    concreteStretchingOutput, Fin.sum_univ_succ]

@[simp] theorem concreteStretchingPair_unitShellSharpPairMultiplier :
    unitShellSharpPairMultiplier concreteStretchingPair = 1 := by
  simp [unitShellSharpPairMultiplier, concreteStretchingPair]

@[simp] theorem concreteStretchingPair_unitShellSharpPairMultiplierDefect :
    unitShellSharpPairMultiplierDefect concreteStretchingPair = 1 := by
  rw [unitShellSharpPairMultiplierDefect,
    concreteStretchingPair_unitShellSharpPairMultiplier,
    concreteStretchingPair_output,
    unitShellSharpMultiplier_concreteStretchingOutput]
  norm_num

/--
The native spectral scale retains both source rows, discards their output,
and therefore generates the exact nonzero nonlinear commutator row.
-/
theorem concreteClosedTriad_unitShellSharpNonlinearPairCommutator :
    unitShellSharpNonlinearPairCommutator
        concreteActiveClosedTriadSource concreteStretchingPair =
      ![(-1 / 4 : ℂ), 0, 0] := by
  rw [unitShellSharpNonlinearPairCommutator_eq_defect_smul,
    concreteStretchingPair_unitShellSharpPairMultiplierDefect,
    concreteStretchingPair_nonlinearContribution]
  simp

theorem concreteClosedTriad_unitShellSharpNonlinearPairCommutator_ne_zero :
    unitShellSharpNonlinearPairCommutator
        concreteActiveClosedTriadSource concreteStretchingPair ≠ 0 := by
  rw [concreteClosedTriad_unitShellSharpNonlinearPairCommutator]
  intro equality
  have coordinateEquality := congrFun equality 0
  norm_num at coordinateEquality

end

