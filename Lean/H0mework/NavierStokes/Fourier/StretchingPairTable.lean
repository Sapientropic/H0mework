import H0mework.NavierStokes.InitialData.RawSourceCore

/-!
# Source-generated three-dimensional vortex-stretching pair table

The raw vorticity source generates a complete finite ordered-pair table from
its already reality-closed, zero-free support.  Every pair `(p, q)` carries
the physical Fourier coefficient

```text
(omega_p dot nabla) u_q = I * (2 pi) * (q dot omega_p) * u_q
```

and has output frequency `p + q`.  Output coefficients are fiber sums of this
one complete table; no output or pair is selected by the source.

Only after the table has been generated do we filter the contributions that
are definitionally nonzero.  Their subtype occurrences therefore carry a
strictly positive squared-norm quantum without accepting nonvanishing as a
premise.  This module stops before physical-field compilation, closed-triad
pairing, and native successor generation.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalVorticityCoefficientStretchingPairTable

open scoped BigOperators

open Matrix
open ThreeDimensionalPeriodicCoarseFilterCore
open ThreeDimensionalPeriodicIntegerCharacterCoarseFilter
open ThreeDimensionalVorticityCoefficientRawSourceCore

noncomputable section

/-! ## Complete source-generated ordered-pair table -/

/-- One ordered vorticity--velocity Fourier interaction. -/
abbrev StretchingPair := IntegerWavevector × IntegerWavevector

/-- Simultaneously negate both frequencies of an ordered pair. -/
def stretchingPairNeg (pair : StretchingPair) : StretchingPair :=
  (waveNeg pair.1, waveNeg pair.2)

@[simp] theorem stretchingPairNeg_involutive
    (pair : StretchingPair) :
    stretchingPairNeg (stretchingPairNeg pair) = pair := by
  rcases pair with ⟨first, second⟩
  simp [stretchingPairNeg]

/-- Negation as an involutive equivalence of the ambient pair carrier. -/
def stretchingPairNegEquiv : StretchingPair ≃ StretchingPair where
  toFun := stretchingPairNeg
  invFun := stretchingPairNeg
  left_inv := stretchingPairNeg_involutive
  right_inv := stretchingPairNeg_involutive

/-- Complete ordered-pair inventory generated from the physical support. -/
def generatedStretchingPairTable
    (source : RawVorticityFourierSource) : Finset StretchingPair :=
  generatedSupport source ×ˢ generatedSupport source

@[simp] theorem mem_generatedStretchingPairTable_iff
    (source : RawVorticityFourierSource)
    (pair : StretchingPair) :
    pair ∈ generatedStretchingPairTable source ↔
      pair.1 ∈ generatedSupport source ∧
        pair.2 ∈ generatedSupport source := by
  simp [generatedStretchingPairTable]

@[simp] theorem mem_generatedStretchingPairTable_pairNeg_iff
    (source : RawVorticityFourierSource)
    (pair : StretchingPair) :
    stretchingPairNeg pair ∈ generatedStretchingPairTable source ↔
      pair ∈ generatedStretchingPairTable source := by
  simp [stretchingPairNeg]

/-- Actual output frequency generated by an ordered pair. -/
def stretchingPairOutput (pair : StretchingPair) : IntegerWavevector :=
  pair.1 + pair.2

@[simp] theorem stretchingPairOutput_pairNeg
    (pair : StretchingPair) :
    stretchingPairOutput (stretchingPairNeg pair) =
      waveNeg (stretchingPairOutput pair) := by
  funext coordinate
  simp [stretchingPairOutput, stretchingPairNeg, waveNeg]
  ring

/-! ## Physical vortex-stretching coefficient -/

/--
The coefficient of `(omega_p dot nabla) u_q` for the repository character
`exp (I * 2 pi k dot x)`.  The angular factor is explicitly `2 pi`.
-/
def generatedStretchingPairContribution
    (source : RawVorticityFourierSource)
    (pair : StretchingPair) : ComplexCoordinateVector :=
  (Complex.I * (((2 * Real.pi : ℝ) : ℂ)) *
      (complexWavevector pair.2 ⬝ᵥ
        generatedVorticityCoefficient source pair.1)) •
    generatedVelocityCoefficient source pair.2

/-- Pair negation carries the physical coefficient to its complex conjugate. -/
theorem generatedStretchingPairContribution_pairNeg
    (source : RawVorticityFourierSource)
    (pair : StretchingPair) :
    generatedStretchingPairContribution source
        (stretchingPairNeg pair) =
      vectorConj (generatedStretchingPairContribution source pair) := by
  rw [generatedStretchingPairContribution,
    generatedStretchingPairContribution]
  simp only [stretchingPairNeg,
    generatedVorticityCoefficient_waveNeg,
    generatedVelocityCoefficient_waveNeg,
    complexWavevector_waveNeg_dot_vectorConj,
    vectorConj_smul]
  funext coordinate
  simp [vectorConj]

/-! ## Exact aggregation by output -/

/-- Exact output fiber inside the one complete ordered-pair table. -/
def generatedStretchingPairFiber
    (source : RawVorticityFourierSource)
    (output : IntegerWavevector) : Finset StretchingPair :=
  (generatedStretchingPairTable source).filter
    (fun pair => stretchingPairOutput pair = output)

@[simp] theorem mem_generatedStretchingPairFiber_iff
    (source : RawVorticityFourierSource)
    (output : IntegerWavevector)
    (pair : StretchingPair) :
    pair ∈ generatedStretchingPairFiber source output ↔
      pair ∈ generatedStretchingPairTable source ∧
        stretchingPairOutput pair = output := by
  simp [generatedStretchingPairFiber]

@[simp] theorem mem_generatedStretchingPairFiber_pairNeg_iff
    (source : RawVorticityFourierSource)
    (output : IntegerWavevector)
    (pair : StretchingPair) :
    stretchingPairNeg pair ∈
        generatedStretchingPairFiber source (waveNeg output) ↔
      pair ∈ generatedStretchingPairFiber source output := by
  rw [mem_generatedStretchingPairFiber_iff,
    mem_generatedStretchingPairFiber_iff,
    stretchingPairOutput_pairNeg]
  constructor
  · rintro ⟨pairMembership, outputEquality⟩
    refine
      ⟨(mem_generatedStretchingPairTable_pairNeg_iff source pair).mp
          pairMembership,
        ?_⟩
    simpa [waveNeg] using outputEquality
  · rintro ⟨pairMembership, outputEquality⟩
    refine
      ⟨(mem_generatedStretchingPairTable_pairNeg_iff source pair).mpr
          pairMembership,
        ?_⟩
    rw [outputEquality]

/-- Vortex-stretching coefficient obtained by summing one exact output fiber. -/
def generatedStretchingCoefficientAt
    (source : RawVorticityFourierSource)
    (output : IntegerWavevector) : ComplexCoordinateVector :=
  ∑ pair ∈ generatedStretchingPairFiber source output,
    generatedStretchingPairContribution source pair

/--
The output coefficient is exactly the complete pair-table sum with the output
condition internal to the summand.
-/
theorem generatedStretchingCoefficientAt_eq_fullPairTableSum
    (source : RawVorticityFourierSource)
    (output : IntegerWavevector) :
    generatedStretchingCoefficientAt source output =
      ∑ pair ∈ generatedStretchingPairTable source,
        if stretchingPairOutput pair = output then
          generatedStretchingPairContribution source pair
        else 0 := by
  rw [generatedStretchingCoefficientAt,
    generatedStretchingPairFiber,
    Finset.sum_filter]

theorem vectorConj_finset_sum
    {ι : Type*}
    (indices : Finset ι)
    (coefficient : ι → ComplexCoordinateVector) :
    vectorConj (∑ index ∈ indices, coefficient index) =
      ∑ index ∈ indices, vectorConj (coefficient index) := by
  funext coordinate
  simp [vectorConj]

/-- Output aggregation preserves the source-generated Fourier reality law. -/
theorem generatedStretchingCoefficientAt_waveNeg
    (source : RawVorticityFourierSource)
    (output : IntegerWavevector) :
    generatedStretchingCoefficientAt source (waveNeg output) =
      vectorConj (generatedStretchingCoefficientAt source output) := by
  rw [generatedStretchingCoefficientAt,
    generatedStretchingCoefficientAt,
    vectorConj_finset_sum]
  symm
  refine Finset.sum_equiv stretchingPairNegEquiv ?_ ?_
  · intro pair
    exact
      (mem_generatedStretchingPairFiber_pairNeg_iff
        source output pair).symm
  · intro pair membership
    exact (generatedStretchingPairContribution_pairNeg source pair).symm

/-! ## Definition-generated active occurrences and their quantum -/

/-- Active interactions are filtered only after the full table is generated. -/
noncomputable def activeStretchingPairs
    (source : RawVorticityFourierSource) : Finset StretchingPair := by
  classical
  exact (generatedStretchingPairTable source).filter
    (fun pair => generatedStretchingPairContribution source pair ≠ 0)

@[simp] theorem mem_activeStretchingPairs_iff
    (source : RawVorticityFourierSource)
    (pair : StretchingPair) :
    pair ∈ activeStretchingPairs source ↔
      pair ∈ generatedStretchingPairTable source ∧
        generatedStretchingPairContribution source pair ≠ 0 := by
  classical
  simp [activeStretchingPairs]

/-- A definition-generated active occurrence on the same source pair table. -/
abbrev ActiveStretchingPairOccurrence
    (source : RawVorticityFourierSource) :=
  {pair : StretchingPair // pair ∈ activeStretchingPairs source}

/-- Squared coordinate norm of a finite complex vector. -/
def complexCoordinateVectorNormSq
    (vector : ComplexCoordinateVector) : ℝ :=
  ∑ coordinate : Coordinate, Complex.normSq (vector coordinate)

theorem complexCoordinateVectorNormSq_nonneg
    (vector : ComplexCoordinateVector) :
    0 ≤ complexCoordinateVectorNormSq vector := by
  exact Finset.sum_nonneg fun _ _ => Complex.normSq_nonneg _

theorem complexCoordinateVectorNormSq_eq_zero_iff
    (vector : ComplexCoordinateVector) :
    complexCoordinateVectorNormSq vector = 0 ↔ vector = 0 := by
  constructor
  · intro normZero
    funext coordinate
    have coordinateNormZero : Complex.normSq (vector coordinate) = 0 :=
      congrFun
        ((Fintype.sum_eq_zero_iff_of_nonneg
          fun i => Complex.normSq_nonneg (vector i)).mp normZero)
        coordinate
    exact Complex.normSq_eq_zero.mp coordinateNormZero
  · rintro rfl
    simp [complexCoordinateVectorNormSq]

theorem complexCoordinateVectorNormSq_pos_iff
    (vector : ComplexCoordinateVector) :
    0 < complexCoordinateVectorNormSq vector ↔ vector ≠ 0 := by
  exact
    (complexCoordinateVectorNormSq_nonneg vector).lt_iff_ne.trans
      (not_congr
        (eq_comm.trans
          (complexCoordinateVectorNormSq_eq_zero_iff vector)))

/-- Positive squared-norm quantum attached to one generated active occurrence. -/
def activeStretchingPairQuantum
    (source : RawVorticityFourierSource)
    (occurrence : ActiveStretchingPairOccurrence source) : ℝ :=
  complexCoordinateVectorNormSq
    (generatedStretchingPairContribution source occurrence.1)

theorem activeStretchingPairQuantum_pos
    (source : RawVorticityFourierSource)
    (occurrence : ActiveStretchingPairOccurrence source) :
    0 < activeStretchingPairQuantum source occurrence := by
  rw [activeStretchingPairQuantum,
    complexCoordinateVectorNormSq_pos_iff]
  exact (mem_activeStretchingPairs_iff source occurrence.1).mp
    occurrence.2 |>.2

/-! ## Empty-source negative controls -/

@[simp] theorem zeroRawVorticitySource_generatedStretchingPairTable :
    generatedStretchingPairTable zeroRawVorticitySource = ∅ := by
  simp [generatedStretchingPairTable]

@[simp] theorem zeroRawVorticitySource_activeStretchingPairs :
    activeStretchingPairs zeroRawVorticitySource = ∅ := by
  classical
  simp [activeStretchingPairs]

@[simp] theorem zeroRawVorticitySource_generatedStretchingCoefficientAt
    (output : IntegerWavevector) :
    generatedStretchingCoefficientAt zeroRawVorticitySource output = 0 := by
  simp [generatedStretchingCoefficientAt,
    generatedStretchingPairFiber]

end

end ThreeDimensionalVorticityCoefficientStretchingPairTable
end NavierStokes
end SaturationMonoid
