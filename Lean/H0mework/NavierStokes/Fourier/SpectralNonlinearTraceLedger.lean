import H0mework.NavierStokes.Fourier.ConcreteSpectralScaleEdge

/-!
# Generated spectral nonlinear trace on the complete vorticity pair fiber

The sharp unit-shell source update and the nonlinear pair generator determine
two actual orders at every output frequency:

```text
source update -> pair formation -> complete fiber aggregation
pair formation -> complete fiber aggregation -> output keep.
```

This module generates their trace directly on the complete old-source pair
fiber.  Its row coefficient is the source multiplier gap

```text
m(p)m(q) - m(p+q),
```

not a separately supplied witness and not a definition by subtraction of the
two aggregate orders.  The conservation split, difference identity, and
uniqueness theorem are then consequences of this generated ledger.

Pair negation preserves both the gap and the nonlinear-row reality law, so
the generated trace is itself a valid Fourier coefficient table for the
physical compiler.  No pair, output, target, nonvanishing, coverage, or
faithfulness premise is accepted.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalVorticityCoefficientSpectralNonlinearTraceLedger

open scoped BigOperators Matrix

open Matrix
open ThreeDimensionalPeriodicCoarseFilterCore
open ThreeDimensionalPeriodicIntegerCharacterCoarseFilter
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientStretchingPairTable
open ThreeDimensionalVorticityCoefficientNonlinearPairGenerator
open ThreeDimensionalVorticityCoefficientConcreteSpectralScaleEdge

noncomputable section

/-! ## The two actual orders -/

/--
Apply the native unit-shell update to the raw source before generating and
aggregating its complete nonlinear output fiber.
-/
def unitShellSourceFilterThenNonlinearAggregate
    (source : RawVorticityFourierSource)
    (output : IntegerWavevector) : ComplexCoordinateVector :=
  generatedVorticityNonlinearCoefficientAt
    (unitShellSharpSourceUpdate source) output

/--
Generate and aggregate the complete old-source nonlinear fiber before
applying the unit-shell keep at its output frequency.
-/
def nonlinearAggregateThenUnitShellOutputProjection
    (source : RawVorticityFourierSource)
    (output : IntegerWavevector) : ComplexCoordinateVector :=
  unitShellCoefficientKeep
    (generatedVorticityNonlinearCoefficientAt source) output

/-! ## Source-generated complete-fiber trace -/

/--
The generated spectral nonlinear trace is the complete old-source output
fiber weighted by the actual unit-shell multiplier gap.

This is the primary definition: it does not inspect or subtract the two
aggregate orders.
-/
def generatedUnitShellNonlinearTraceCoefficient
    (source : RawVorticityFourierSource)
    (output : IntegerWavevector) : ComplexCoordinateVector :=
  ∑ pair ∈ generatedStretchingPairFiber source output,
    unitShellSharpPairMultiplierDefect pair •
      generatedVorticityNonlinearPairContribution source pair

@[simp] theorem generatedStretchingPairTable_unitShellSharpSourceUpdate
    (source : RawVorticityFourierSource) :
    generatedStretchingPairTable (unitShellSharpSourceUpdate source) =
      generatedStretchingPairTable source := by
  simp [generatedStretchingPairTable]

@[simp] theorem generatedStretchingPairFiber_unitShellSharpSourceUpdate
    (source : RawVorticityFourierSource)
    (output : IntegerWavevector) :
    generatedStretchingPairFiber
        (unitShellSharpSourceUpdate source) output =
      generatedStretchingPairFiber source output := by
  simp [generatedStretchingPairFiber]

/--
The source-first aggregate is the complete old-source fiber transported by
the generated product multiplier on every ordered pair.
-/
theorem generatedVorticityNonlinearCoefficientAt_unitShellSharpSourceUpdate
    (source : RawVorticityFourierSource)
    (output : IntegerWavevector) :
    generatedVorticityNonlinearCoefficientAt
        (unitShellSharpSourceUpdate source) output =
      ∑ pair ∈ generatedStretchingPairFiber source output,
        unitShellSharpPairMultiplier pair •
          generatedVorticityNonlinearPairContribution source pair := by
  rw [generatedVorticityNonlinearCoefficientAt,
    generatedStretchingPairFiber_unitShellSharpSourceUpdate]
  apply Finset.sum_congr rfl
  intro pair pairMembership
  exact
    generatedVorticityNonlinearPairContribution_unitShellSharpSourceUpdate
      source pair

/-! ## Residual conservation and forced uniqueness -/

/--
The actual source-first order is the projected old aggregate plus the trace
generated by the complete pair-fiber multiplier-gap ledger.
-/
theorem unitShellSourceFilterThenNonlinearAggregate_eq_projection_add_trace
    (source : RawVorticityFourierSource)
    (output : IntegerWavevector) :
    unitShellSourceFilterThenNonlinearAggregate source output =
      nonlinearAggregateThenUnitShellOutputProjection source output +
        generatedUnitShellNonlinearTraceCoefficient source output := by
  rw [unitShellSourceFilterThenNonlinearAggregate,
    nonlinearAggregateThenUnitShellOutputProjection,
    generatedUnitShellNonlinearTraceCoefficient,
    generatedVorticityNonlinearCoefficientAt_unitShellSharpSourceUpdate,
    unitShellCoefficientKeep_apply,
    generatedVorticityNonlinearCoefficientAt,
    Finset.smul_sum,
    ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro pair pairMembership
  have outputEquality : stretchingPairOutput pair = output :=
    (mem_generatedStretchingPairFiber_iff
      source output pair).mp pairMembership |>.2
  rw [← outputEquality]
  simp only [unitShellSharpPairMultiplierDefect, ← add_smul]
  congr 1
  ring

/-- Subtracting the projected old aggregate recovers the generated trace. -/
theorem unitShellSourceFirst_sub_projectedOld_eq_generatedTrace
    (source : RawVorticityFourierSource)
    (output : IntegerWavevector) :
    unitShellSourceFilterThenNonlinearAggregate source output -
        nonlinearAggregateThenUnitShellOutputProjection source output =
      generatedUnitShellNonlinearTraceCoefficient source output := by
  rw [
    unitShellSourceFilterThenNonlinearAggregate_eq_projection_add_trace]
  abel

/--
Any additive trace which closes these two actual orders is uniquely the
complete-fiber trace already generated by the source multiplier gap.
-/
theorem generatedUnitShellNonlinearTraceCoefficient_unique
    (source : RawVorticityFourierSource)
    (output : IntegerWavevector)
    (trace : ComplexCoordinateVector) :
    unitShellSourceFilterThenNonlinearAggregate source output =
        nonlinearAggregateThenUnitShellOutputProjection source output +
          trace ↔
      trace = generatedUnitShellNonlinearTraceCoefficient source output := by
  constructor
  · intro splitting
    calc
      trace =
          unitShellSourceFilterThenNonlinearAggregate source output -
            nonlinearAggregateThenUnitShellOutputProjection source output := by
        rw [splitting]
        abel
      _ = generatedUnitShellNonlinearTraceCoefficient source output :=
        unitShellSourceFirst_sub_projectedOld_eq_generatedTrace source output
  · intro traceEquality
    rw [traceEquality]
    exact
      unitShellSourceFilterThenNonlinearAggregate_eq_projection_add_trace
        source output

/-! ## Fourier reality of the generated trace -/

@[simp] theorem unitShellSharpPairMultiplier_stretchingPairNeg
    (pair : StretchingPair) :
    unitShellSharpPairMultiplier (stretchingPairNeg pair) =
      unitShellSharpPairMultiplier pair := by
  simp [unitShellSharpPairMultiplier, stretchingPairNeg]

@[simp] theorem unitShellSharpPairMultiplierDefect_stretchingPairNeg
    (pair : StretchingPair) :
    unitShellSharpPairMultiplierDefect (stretchingPairNeg pair) =
      unitShellSharpPairMultiplierDefect pair := by
  simp [unitShellSharpPairMultiplierDefect]

@[simp] theorem star_unitShellSharpPairMultiplierDefect
    (pair : StretchingPair) :
    star (unitShellSharpPairMultiplierDefect pair) =
      unitShellSharpPairMultiplierDefect pair := by
  simp [unitShellSharpPairMultiplierDefect,
    unitShellSharpPairMultiplier]

/--
Each generated trace row is carried by pair negation to its complex
conjugate; the scalar gap itself is real.
-/
theorem generatedUnitShellNonlinearTraceRow_pairNeg
    (source : RawVorticityFourierSource)
    (pair : StretchingPair) :
    unitShellSharpPairMultiplierDefect (stretchingPairNeg pair) •
        generatedVorticityNonlinearPairContribution source
          (stretchingPairNeg pair) =
      vectorConj
        (unitShellSharpPairMultiplierDefect pair •
          generatedVorticityNonlinearPairContribution source pair) := by
  rw [unitShellSharpPairMultiplierDefect_stretchingPairNeg,
    generatedVorticityNonlinearPairContribution_pairNeg,
    vectorConj_smul,
    star_unitShellSharpPairMultiplierDefect]

/--
The complete generated trace obeys the Fourier conjugate-symmetry law needed
by the finite physical compiler.
-/
theorem generatedUnitShellNonlinearTraceCoefficient_waveNeg
    (source : RawVorticityFourierSource)
    (output : IntegerWavevector) :
    generatedUnitShellNonlinearTraceCoefficient source (waveNeg output) =
      vectorConj
        (generatedUnitShellNonlinearTraceCoefficient source output) := by
  rw [generatedUnitShellNonlinearTraceCoefficient,
    generatedUnitShellNonlinearTraceCoefficient,
    vectorConj_finset_sum]
  symm
  refine Finset.sum_equiv stretchingPairNegEquiv ?_ ?_
  · intro pair
    exact
      (mem_generatedStretchingPairFiber_pairNeg_iff
        source output pair).symm
  · intro pair pairMembership
    exact (generatedUnitShellNonlinearTraceRow_pairNeg source pair).symm

end

end ThreeDimensionalVorticityCoefficientSpectralNonlinearTraceLedger
end NavierStokes
end SaturationMonoid
