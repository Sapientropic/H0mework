/-! ## Finite-to-whole control -/

private theorem norm_sub_sq_le_two_mul
    {E : Type*}
    [NormedAddCommGroup E]
    (left right : E) :
    ‖left - right‖ ^ 2 ≤
      2 * ‖left‖ ^ 2 + 2 * ‖right‖ ^ 2 := by
  have normLe :
      ‖left - right‖ ≤ ‖left‖ + ‖right‖ :=
    norm_sub_le left right
  have squareLe :
      ‖left - right‖ ^ 2 ≤
        (‖left‖ + ‖right‖) ^ 2 :=
    (sq_le_sq₀ (norm_nonneg _)
      (add_nonneg (norm_nonneg _) (norm_nonneg _))).2 normLe
  calc
    ‖left - right‖ ^ 2 ≤
        (‖left‖ + ‖right‖) ^ 2 := squareLe
    _ ≤ 2 * ‖left‖ ^ 2 + 2 * ‖right‖ ^ 2 := by
      nlinarith [sq_nonneg (‖left‖ - ‖right‖)]

private theorem complexCoordinateAmplitudeSq_sub_le_two_mul
    (left right : ComplexCoordinateVector) :
    complexCoordinateAmplitudeSq (left - right) ≤
      2 * complexCoordinateAmplitudeSq left +
        2 * complexCoordinateAmplitudeSq right := by
  unfold complexCoordinateAmplitudeSq
  calc
    (∑ coordinate : Coordinate,
        Complex.normSq ((left - right) coordinate)) ≤
        ∑ coordinate : Coordinate,
          (2 * Complex.normSq (left coordinate) +
            2 * Complex.normSq (right coordinate)) := by
      apply Finset.sum_le_sum
      intro coordinate coordinateMem
      simpa only [Pi.sub_apply, Complex.normSq_eq_norm_sq] using
        norm_sub_sq_le_two_mul
          (left coordinate) (right coordinate)
    _ =
        2 * (∑ coordinate : Coordinate,
          Complex.normSq (left coordinate)) +
        2 * (∑ coordinate : Coordinate,
          Complex.normSq (right coordinate)) := by
      rw [Finset.sum_add_distrib, Finset.mul_sum, Finset.mul_sum]

/-- Whole gradient summability is closed under subtraction.  The weighted
difference carrier is therefore generated by the two actual whole states;
it is not an independent certificate premise. -/
theorem summable_wholeStateVorticityGradientDensity_sub
    (left right : ComplexVorticityHilbertState)
    (leftGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq (left wave))
    (rightGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq (right wave)) :
    Summable fun wave : IntegerWavevector =>
      integerWaveNormSq wave *
        complexCoordinateAmplitudeSq ((left - right) wave) := by
  have dominatingSummable :
      Summable fun wave : IntegerWavevector =>
        2 *
            (integerWaveNormSq wave *
              complexCoordinateAmplitudeSq (left wave)) +
          2 *
            (integerWaveNormSq wave *
              complexCoordinateAmplitudeSq (right wave)) :=
    (leftGradientSummable.mul_left 2).add
      (rightGradientSummable.mul_left 2)
  apply dominatingSummable.of_nonneg_of_le
  · intro wave
    exact mul_nonneg (integerWaveNormSq_nonneg wave)
      (complexCoordinateAmplitudeSq_nonneg _)
  · intro wave
    calc
      integerWaveNormSq wave *
          complexCoordinateAmplitudeSq ((left - right) wave) ≤
          integerWaveNormSq wave *
            (2 * complexCoordinateAmplitudeSq (left wave) +
              2 * complexCoordinateAmplitudeSq (right wave)) :=
        mul_le_mul_of_nonneg_left
          (complexCoordinateAmplitudeSq_sub_le_two_mul
            (left wave) (right wave))
          (integerWaveNormSq_nonneg wave)
      _ =
          2 *
              (integerWaveNormSq wave *
                complexCoordinateAmplitudeSq (left wave)) +
            2 *
              (integerWaveNormSq wave *
                complexCoordinateAmplitudeSq (right wave)) := by
        ring

theorem finiteStateVelocityMajorant_le_whole
    (modes : Finset IntegerWavevector)
    (state : ComplexVorticityHilbertState)
    (gradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq (state wave)) :
    finiteStateVelocityMajorant modes state ≤
      wholeStateVelocityMajorant state := by
  have velocitySummable :=
    summable_wholeStateVelocityAmplitude state gradientSummable
  unfold finiteStateVelocityMajorant finiteVelocityFourierMajorant
    wholeStateVelocityMajorant
  simpa only [velocityRowAmplitude] using
    velocitySummable.sum_le_tsum modes fun wave waveMem =>
      Real.sqrt_nonneg _

private theorem finiteStateVorticityCoefficientEnstrophy_nonneg
    (modes : Finset IntegerWavevector)
    (state : ComplexVorticityHilbertState) :
    0 ≤ finiteStateVorticityCoefficientEnstrophy modes state := by
  unfold finiteStateVorticityCoefficientEnstrophy
  exact Finset.sum_nonneg fun wave waveMem =>
    complexCoordinateAmplitudeSq_nonneg _

private theorem wholeVorticityEuclideanMass_nonneg
    (state : ComplexVorticityHilbertState) :
    0 ≤ wholeVorticityEuclideanMass state := by
  unfold wholeVorticityEuclideanMass
  exact tsum_nonneg fun wave =>
    sq_nonneg (vorticityRowAmplitude state wave)

/-- Every finite nonlinear-difference mass is controlled by one
cutoff-independent expression on the actual whole carrier. -/
theorem finiteStateVorticityNonlinearDifferenceNegativeOneMass_le_whole
    (modes : Finset IntegerWavevector)
    (left right : ComplexVorticityHilbertState)
    (leftTransverse : WholeStateTransverse left)
    (rightTransverse : WholeStateTransverse right)
    (leftGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq (left wave))
    (rightGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq (right wave))
    (differenceGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq ((left - right) wave)) :
    finiteStateVorticityNonlinearDifferenceNegativeOneMass
        modes left right ≤
      4 *
        ((wholeStateVelocityMajorant left ^ 2 +
            wholeStateVelocityMajorant right ^ 2) *
            wholeVorticityEuclideanMass (left - right) +
          wholeStateVelocityMajorant (left - right) ^ 2 *
            (wholeVorticityEuclideanMass left +
              wholeVorticityEuclideanMass right)) := by
  have finiteBound :=
    finiteStateVorticityNonlinearDifferenceNegativeOneMass_le
      modes left right
      (finiteStateTransverseOn_of_wholeStateTransverse
        modes left leftTransverse)
      (finiteStateTransverseOn_of_wholeStateTransverse
        modes right rightTransverse)
  have leftMajorantLe :=
    finiteStateVelocityMajorant_le_whole
      modes left leftGradientSummable
  have rightMajorantLe :=
    finiteStateVelocityMajorant_le_whole
      modes right rightGradientSummable
  have differenceMajorantLe :=
    finiteStateVelocityMajorant_le_whole
      modes (left - right) differenceGradientSummable
  have leftMajorantSqLe :
      finiteStateVelocityMajorant modes left ^ 2 ≤
        wholeStateVelocityMajorant left ^ 2 :=
    (sq_le_sq₀
      (finiteStateVelocityMajorant_nonneg modes left)
      (wholeStateVelocityMajorant_nonneg left)).mpr
      leftMajorantLe
  have rightMajorantSqLe :
      finiteStateVelocityMajorant modes right ^ 2 ≤
        wholeStateVelocityMajorant right ^ 2 :=
    (sq_le_sq₀
      (finiteStateVelocityMajorant_nonneg modes right)
      (wholeStateVelocityMajorant_nonneg right)).mpr
      rightMajorantLe
  have differenceMajorantSqLe :
      finiteStateVelocityMajorant modes (left - right) ^ 2 ≤
        wholeStateVelocityMajorant (left - right) ^ 2 :=
    (sq_le_sq₀
      (finiteStateVelocityMajorant_nonneg modes (left - right))
      (wholeStateVelocityMajorant_nonneg (left - right))).mpr
      differenceMajorantLe
  have leftMassLe :=
    finiteStateVorticityCoefficientEnstrophy_le_wholeMass
      modes left
  have rightMassLe :=
    finiteStateVorticityCoefficientEnstrophy_le_wholeMass
      modes right
  have differenceMassLe :=
    finiteStateVorticityCoefficientEnstrophy_le_wholeMass
      modes (left - right)
  have finiteDifferenceMassNonneg :
      0 ≤
        finiteStateVorticityCoefficientEnstrophy
          modes (left - right) :=
    finiteStateVorticityCoefficientEnstrophy_nonneg
      modes (left - right)
  have finiteAmbientMassNonneg :
      0 ≤
        finiteStateVorticityCoefficientEnstrophy modes left +
          finiteStateVorticityCoefficientEnstrophy modes right :=
    add_nonneg
      (finiteStateVorticityCoefficientEnstrophy_nonneg modes left)
      (finiteStateVorticityCoefficientEnstrophy_nonneg modes right)
  have wholeAmbientMajorantSqNonneg :
      0 ≤
        wholeStateVelocityMajorant left ^ 2 +
          wholeStateVelocityMajorant right ^ 2 :=
    add_nonneg (sq_nonneg _) (sq_nonneg _)
  have wholeDifferenceMajorantSqNonneg :
      0 ≤ wholeStateVelocityMajorant (left - right) ^ 2 :=
    sq_nonneg _
  have ambientTermLe :
      (finiteStateVelocityMajorant modes left ^ 2 +
          finiteStateVelocityMajorant modes right ^ 2) *
          finiteStateVorticityCoefficientEnstrophy
            modes (left - right) ≤
        (wholeStateVelocityMajorant left ^ 2 +
          wholeStateVelocityMajorant right ^ 2) *
          wholeVorticityEuclideanMass (left - right) := by
    calc
      (finiteStateVelocityMajorant modes left ^ 2 +
          finiteStateVelocityMajorant modes right ^ 2) *
          finiteStateVorticityCoefficientEnstrophy
            modes (left - right) ≤
          (wholeStateVelocityMajorant left ^ 2 +
            wholeStateVelocityMajorant right ^ 2) *
            finiteStateVorticityCoefficientEnstrophy
              modes (left - right) :=
        mul_le_mul_of_nonneg_right
          (add_le_add leftMajorantSqLe rightMajorantSqLe)
          finiteDifferenceMassNonneg
      _ ≤
          (wholeStateVelocityMajorant left ^ 2 +
            wholeStateVelocityMajorant right ^ 2) *
            wholeVorticityEuclideanMass (left - right) :=
        mul_le_mul_of_nonneg_left
          differenceMassLe wholeAmbientMajorantSqNonneg
  have differenceTermLe :
      finiteStateVelocityMajorant modes (left - right) ^ 2 *
          (finiteStateVorticityCoefficientEnstrophy modes left +
            finiteStateVorticityCoefficientEnstrophy modes right) ≤
        wholeStateVelocityMajorant (left - right) ^ 2 *
          (wholeVorticityEuclideanMass left +
            wholeVorticityEuclideanMass right) := by
    calc
      finiteStateVelocityMajorant modes (left - right) ^ 2 *
          (finiteStateVorticityCoefficientEnstrophy modes left +
            finiteStateVorticityCoefficientEnstrophy modes right) ≤
          wholeStateVelocityMajorant (left - right) ^ 2 *
            (finiteStateVorticityCoefficientEnstrophy modes left +
              finiteStateVorticityCoefficientEnstrophy modes right) :=
        mul_le_mul_of_nonneg_right
          differenceMajorantSqLe finiteAmbientMassNonneg
      _ ≤
          wholeStateVelocityMajorant (left - right) ^ 2 *
            (wholeVorticityEuclideanMass left +
              wholeVorticityEuclideanMass right) :=
        mul_le_mul_of_nonneg_left
          (add_le_add leftMassLe rightMassLe)
          wholeDifferenceMajorantSqNonneg
  exact finiteBound.trans <|
    mul_le_mul_of_nonneg_left
      (add_le_add ambientTermLe differenceTermLe) (by norm_num)

/-! ## Whole difference density -/

/-- One Fourier density of the whole nonlinear-difference `H⁻¹` mass. -/
def wholeStateVorticityNonlinearDifferenceNegativeOneDensity
    (left right : ComplexVorticityHilbertState)
    (output : IntegerWavevector) : ℝ :=
  if output = 0 then 0
  else
    ‖wholeStateVorticityNonlinearCoefficientAt left output -
        wholeStateVorticityNonlinearCoefficientAt right output‖ ^ 2 /
      integerWaveViscousMultiplier output

/-- Full-lattice nonlinear-difference `H⁻¹` mass. -/
def wholeStateVorticityNonlinearDifferenceNegativeOneMass
    (left right : ComplexVorticityHilbertState) : ℝ :=
  ∑' output : IntegerWavevector,
    wholeStateVorticityNonlinearDifferenceNegativeOneDensity
      left right output

theorem wholeStateVorticityNonlinearDifferenceNegativeOneDensity_nonneg
    (left right : ComplexVorticityHilbertState)
    (output : IntegerWavevector) :
    0 ≤
      wholeStateVorticityNonlinearDifferenceNegativeOneDensity
        left right output := by
  unfold wholeStateVorticityNonlinearDifferenceNegativeOneDensity
  split_ifs
  · rfl
  · exact div_nonneg (sq_nonneg _)
      (mul_nonneg (sq_nonneg _)
        (integerWaveNormSq_nonneg output))

/-- Canonical finite-cube approximation to one whole nonlinear-difference
negative-one density. -/
def canonicalCubeVorticityNonlinearDifferenceNegativeOneDensity
    (radius : ℕ)
    (left right : ComplexVorticityHilbertState)
    (output : IntegerWavevector) : ℝ :=
  if output = 0 then 0
  else
    ‖finiteStateVorticityNonlinearCoefficientAt
          (integerWaveFrequencyCube radius) left output -
        finiteStateVorticityNonlinearCoefficientAt
          (integerWaveFrequencyCube radius) right output‖ ^ 2 /
      integerWaveViscousMultiplier output

theorem
    canonicalCubeVorticityNonlinearDifferenceNegativeOneDensity_tendsto
    (left right : ComplexVorticityHilbertState)
    (leftTransverse : WholeStateTransverse left)
    (rightTransverse : WholeStateTransverse right)
    (output : IntegerWavevector) :
    Tendsto
      (fun radius =>
        canonicalCubeVorticityNonlinearDifferenceNegativeOneDensity
          radius left right output)
      atTop
      (𝓝
        (wholeStateVorticityNonlinearDifferenceNegativeOneDensity
          left right output)) := by
  by_cases outputZero : output = 0
  · simp [canonicalCubeVorticityNonlinearDifferenceNegativeOneDensity,
      wholeStateVorticityNonlinearDifferenceNegativeOneDensity,
      outputZero]
  · have leftRowTendsto :=
      finiteStateVorticityNonlinearCoefficientAt_frequencyCube_tendsto
        left leftTransverse output
    have rightRowTendsto :=
      finiteStateVorticityNonlinearCoefficientAt_frequencyCube_tendsto
        right rightTransverse output
    have differenceRowTendsto :=
      leftRowTendsto.sub rightRowTendsto
    have densityTendsto :=
      (differenceRowTendsto.norm.pow 2).div_const
        (integerWaveViscousMultiplier output)
    simpa [canonicalCubeVorticityNonlinearDifferenceNegativeOneDensity,
      wholeStateVorticityNonlinearDifferenceNegativeOneDensity,
      outputZero] using densityTendsto

theorem
    canonicalCubeVorticityNonlinearDifferenceNegativeOneDensity_sum_le_mass
    (outputs : Finset IntegerWavevector)
    (radius : ℕ)
    (left right : ComplexVorticityHilbertState)
    (outputsSubset :
      outputs ⊆ integerWaveFrequencyCube radius) :
    (∑ output ∈ outputs,
        canonicalCubeVorticityNonlinearDifferenceNegativeOneDensity
          radius left right output) ≤
      finiteStateVorticityNonlinearDifferenceNegativeOneMass
        (integerWaveFrequencyCube radius) left right := by
  unfold finiteStateVorticityNonlinearDifferenceNegativeOneMass
    canonicalCubeVorticityNonlinearDifferenceNegativeOneDensity
  exact
    Finset.sum_le_sum_of_subset_of_nonneg outputsSubset
      (fun output outputMem outputNotMem => by
        by_cases outputZero : output = 0
        · simp [outputZero]
        · rw [if_neg outputZero]
          exact div_nonneg (sq_nonneg _)
            (mul_nonneg (sq_nonneg _)
              (integerWaveNormSq_nonneg output)))

/-- Every finite partial sum of the genuine whole difference density obeys
the same cutoff-independent two-term bound. -/
theorem wholeStateVorticityNonlinearDifferenceNegativeOneDensity_sum_le
    (outputs : Finset IntegerWavevector)
    (left right : ComplexVorticityHilbertState)
    (leftTransverse : WholeStateTransverse left)
    (rightTransverse : WholeStateTransverse right)
    (leftGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq (left wave))
    (rightGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq (right wave))
    (differenceGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq ((left - right) wave)) :
    (∑ output ∈ outputs,
        wholeStateVorticityNonlinearDifferenceNegativeOneDensity
          left right output) ≤
      4 *
        ((wholeStateVelocityMajorant left ^ 2 +
            wholeStateVelocityMajorant right ^ 2) *
            wholeVorticityEuclideanMass (left - right) +
          wholeStateVelocityMajorant (left - right) ^ 2 *
            (wholeVorticityEuclideanMass left +
              wholeVorticityEuclideanMass right)) := by
  have sumTendsto :
      Tendsto
        (fun radius =>
          ∑ output ∈ outputs,
            canonicalCubeVorticityNonlinearDifferenceNegativeOneDensity
              radius left right output)
        atTop
        (𝓝
          (∑ output ∈ outputs,
            wholeStateVorticityNonlinearDifferenceNegativeOneDensity
              left right output)) := by
    apply tendsto_finsetSum
    intro output outputMem
    exact
      canonicalCubeVorticityNonlinearDifferenceNegativeOneDensity_tendsto
        left right leftTransverse rightTransverse output
  have eventuallySubset :
      ∀ᶠ radius : ℕ in atTop,
        outputs ⊆ integerWaveFrequencyCube radius :=
    tendsto_atTop.1 integerWaveFrequencyCube_tendsto_atTop outputs
  apply le_of_tendsto sumTendsto
  filter_upwards [eventuallySubset] with radius outputsSubset
  calc
    (∑ output ∈ outputs,
        canonicalCubeVorticityNonlinearDifferenceNegativeOneDensity
          radius left right output) ≤
        finiteStateVorticityNonlinearDifferenceNegativeOneMass
          (integerWaveFrequencyCube radius) left right :=
      canonicalCubeVorticityNonlinearDifferenceNegativeOneDensity_sum_le_mass
        outputs radius left right outputsSubset
    _ ≤
        4 *
          ((wholeStateVelocityMajorant left ^ 2 +
              wholeStateVelocityMajorant right ^ 2) *
              wholeVorticityEuclideanMass (left - right) +
            wholeStateVelocityMajorant (left - right) ^ 2 *
              (wholeVorticityEuclideanMass left +
                wholeVorticityEuclideanMass right)) :=
      finiteStateVorticityNonlinearDifferenceNegativeOneMass_le_whole
        (integerWaveFrequencyCube radius) left right
        leftTransverse rightTransverse
        leftGradientSummable rightGradientSummable
        differenceGradientSummable

/-- Summability of the genuine whole nonlinear-difference density is
generated from the uniform finite-cube estimate. -/
theorem
    summable_wholeStateVorticityNonlinearDifferenceNegativeOneDensity
    (left right : ComplexVorticityHilbertState)
    (leftTransverse : WholeStateTransverse left)
    (rightTransverse : WholeStateTransverse right)
    (leftGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq (left wave))
    (rightGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq (right wave))
    (differenceGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq ((left - right) wave)) :
    Summable fun output : IntegerWavevector =>
      wholeStateVorticityNonlinearDifferenceNegativeOneDensity
        left right output := by
  apply summable_of_sum_le
    (fun output =>
      wholeStateVorticityNonlinearDifferenceNegativeOneDensity_nonneg
        left right output)
  intro outputs
  exact
    wholeStateVorticityNonlinearDifferenceNegativeOneDensity_sum_le
      outputs left right leftTransverse rightTransverse
      leftGradientSummable rightGradientSummable
      differenceGradientSummable

private theorem finiteNonlinearDifferencePairing_sq_le_testEnergy_mul_mass
    (modes : Finset IntegerWavevector)
    (modesZeroFree : ∀ wave ∈ modes, wave ≠ 0)
    (testCoefficient : IntegerWavevector → ComplexCoordinateVector)
    (left right : ComplexVorticityHilbertState)
    (differenceSummable :
      Summable fun wave : IntegerWavevector =>
        wholeStateVorticityNonlinearDifferenceNegativeOneDensity
          left right wave) :
    (∑ wave ∈ modes,
        complexCoordinateRealInner (testCoefficient wave)
          (wholeStateVorticityNonlinearCoefficientAt left wave -
            wholeStateVorticityNonlinearCoefficientAt right wave)) ^ 2 ≤
      (∑ wave ∈ modes,
          3 * integerWaveViscousMultiplier wave *
            complexCoordinateAmplitudeSq (testCoefficient wave)) *
        wholeStateVorticityNonlinearDifferenceNegativeOneMass left right := by
  have pointwise (wave : IntegerWavevector) (waveMem : wave ∈ modes) :
      complexCoordinateRealInner (testCoefficient wave)
          (wholeStateVorticityNonlinearCoefficientAt left wave -
            wholeStateVorticityNonlinearCoefficientAt right wave) ^ 2 ≤
        (3 * integerWaveViscousMultiplier wave *
            complexCoordinateAmplitudeSq (testCoefficient wave)) *
          wholeStateVorticityNonlinearDifferenceNegativeOneDensity
            left right wave := by
    have waveNe := modesZeroFree wave waveMem
    have multiplierPos : 0 < integerWaveViscousMultiplier wave := by
      unfold integerWaveViscousMultiplier
      exact mul_pos (sq_pos_of_pos (by positivity))
        (integerWaveNormSq_pos waveNe)
    have innerSq := complexCoordinateRealInner_sq_le
      (testCoefficient wave)
      (wholeStateVorticityNonlinearCoefficientAt left wave -
        wholeStateVorticityNonlinearCoefficientAt right wave)
    have differenceAmplitude :=
      ThreeDimensionalVorticityCoefficientInfiniteFixedOutputNonlinearRow.complexCoordinateAmplitudeSq_le_three_mul_norm_sq
        (wholeStateVorticityNonlinearCoefficientAt left wave -
          wholeStateVorticityNonlinearCoefficientAt right wave)
    unfold wholeStateVorticityNonlinearDifferenceNegativeOneDensity
    rw [if_neg waveNe, div_eq_mul_inv]
    calc
      complexCoordinateRealInner (testCoefficient wave)
          (wholeStateVorticityNonlinearCoefficientAt left wave -
            wholeStateVorticityNonlinearCoefficientAt right wave) ^ 2 ≤
          complexCoordinateAmplitudeSq (testCoefficient wave) *
            complexCoordinateAmplitudeSq
              (wholeStateVorticityNonlinearCoefficientAt left wave -
                wholeStateVorticityNonlinearCoefficientAt right wave) := innerSq
      _ ≤
          complexCoordinateAmplitudeSq (testCoefficient wave) *
            (3 * ‖wholeStateVorticityNonlinearCoefficientAt left wave -
              wholeStateVorticityNonlinearCoefficientAt right wave‖ ^ 2) := by
        exact mul_le_mul_of_nonneg_left differenceAmplitude
          (complexCoordinateAmplitudeSq_nonneg _)
      _ =
          (3 * integerWaveViscousMultiplier wave *
              complexCoordinateAmplitudeSq (testCoefficient wave)) *
            (‖wholeStateVorticityNonlinearCoefficientAt left wave -
                wholeStateVorticityNonlinearCoefficientAt right wave‖ ^ 2 *
              (integerWaveViscousMultiplier wave)⁻¹) := by
        field_simp [multiplierPos.ne']
  have cauchy := Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul
    modes
    (r := fun wave =>
      complexCoordinateRealInner (testCoefficient wave)
        (wholeStateVorticityNonlinearCoefficientAt left wave -
          wholeStateVorticityNonlinearCoefficientAt right wave))
    (f := fun wave =>
      3 * integerWaveViscousMultiplier wave *
        complexCoordinateAmplitudeSq (testCoefficient wave))
    (g := fun wave =>
      wholeStateVorticityNonlinearDifferenceNegativeOneDensity left right wave)
    (fun wave _ =>
      mul_nonneg
        (mul_nonneg (by norm_num)
          (mul_nonneg (sq_nonneg _) (integerWaveNormSq_nonneg wave)))
        (complexCoordinateAmplitudeSq_nonneg _))
    (fun wave _ =>
      wholeStateVorticityNonlinearDifferenceNegativeOneDensity_nonneg
        left right wave)
    pointwise
  exact cauchy.trans (mul_le_mul_of_nonneg_left
    (by
      unfold wholeStateVorticityNonlinearDifferenceNegativeOneMass
      exact differenceSummable.sum_le_tsum modes (fun wave _ =>
        wholeStateVorticityNonlinearDifferenceNegativeOneDensity_nonneg
          left right wave))
    (Finset.sum_nonneg fun wave _ =>
      mul_nonneg
        (mul_nonneg (by norm_num)
          (mul_nonneg (sq_nonneg _)
            (integerWaveNormSq_nonneg wave)))
        (complexCoordinateAmplitudeSq_nonneg _)))

/-- The finite `H¹` test pairing of an input-projection nonlinear error is
controlled by the exact whole nonlinear `H⁻¹` difference mass of the same
state and projection. -/
theorem finiteNonlinearProjectionPairing_sq_le_testEnergy_mul_differenceMass
    (state : ComplexVorticityHilbertState)
    (stateTransverse : WholeStateTransverse state)
    (gradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq (state wave))
    (inputRadius : ℕ)
    (testModes : Finset IntegerWavevector)
    (testModesZeroFree : ∀ wave ∈ testModes, wave ≠ 0)
    (testCoefficient : IntegerWavevector → ComplexCoordinateVector) :
    let projected := complexSharpSupportProjection
      (integerWaveFrequencyCube inputRadius) state
    (∑ wave ∈ testModes,
        complexCoordinateRealInner (testCoefficient wave)
          (wholeStateVorticityNonlinearCoefficientAt projected wave -
            wholeStateVorticityNonlinearCoefficientAt state wave)) ^ 2 ≤
      (∑ wave ∈ testModes,
          3 * integerWaveViscousMultiplier wave *
            complexCoordinateAmplitudeSq (testCoefficient wave)) *
        wholeStateVorticityNonlinearDifferenceNegativeOneMass
          projected state := by
  dsimp only
  let modes := integerWaveFrequencyCube inputRadius
  let projected := complexSharpSupportProjection modes state
  have projectedTransverse : WholeStateTransverse projected := by
    intro wave
    by_cases waveMem : wave ∈ modes
    · simpa [projected, complexSharpSupportProjection_apply, waveMem] using
        stateTransverse wave
    · simp [projected, complexSharpSupportProjection_apply, waveMem]
  have projectedGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq (projected wave) :=
    summable_wholeStateVorticityGradientDensity_of_supported
      modes projected
      (complexSharpSupportProjection_supported modes state)
  have differenceGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq ((projected - state) wave) :=
    summable_wholeStateVorticityGradientDensity_sub
      projected state projectedGradientSummable gradientSummable
  have differenceSummable :=
    summable_wholeStateVorticityNonlinearDifferenceNegativeOneDensity
      projected state projectedTransverse stateTransverse
      projectedGradientSummable gradientSummable
      differenceGradientSummable
  exact finiteNonlinearDifferencePairing_sq_le_testEnergy_mul_mass
    testModes testModesZeroFree testCoefficient projected state
    differenceSummable

/-- Cutoff-free whole-carrier `H⁻¹` estimate for the actual nonlinear
difference. -/
theorem wholeStateVorticityNonlinearDifferenceNegativeOneMass_le
    (left right : ComplexVorticityHilbertState)
    (leftTransverse : WholeStateTransverse left)
    (rightTransverse : WholeStateTransverse right)
    (leftGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq (left wave))
    (rightGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq (right wave))
    (differenceGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq ((left - right) wave)) :
    wholeStateVorticityNonlinearDifferenceNegativeOneMass
        left right ≤
      4 *
        ((wholeStateVelocityMajorant left ^ 2 +
            wholeStateVelocityMajorant right ^ 2) *
            wholeVorticityEuclideanMass (left - right) +
          wholeStateVelocityMajorant (left - right) ^ 2 *
            (wholeVorticityEuclideanMass left +
              wholeVorticityEuclideanMass right)) := by
  unfold wholeStateVorticityNonlinearDifferenceNegativeOneMass
  apply le_of_tendsto
    (summable_wholeStateVorticityNonlinearDifferenceNegativeOneDensity
      left right leftTransverse rightTransverse
      leftGradientSummable rightGradientSummable
      differenceGradientSummable).hasSum
  exact Filter.Eventually.of_forall fun outputs =>
    wholeStateVorticityNonlinearDifferenceNegativeOneDensity_sum_le
      outputs left right leftTransverse rightTransverse
      leftGradientSummable rightGradientSummable
      differenceGradientSummable

/-! ## Actual weighted whole carrier -/

/-- The actual nonlinear-difference row with the exact inverse
square-root Laplacian weight installed coefficientwise. -/
def wholeStateVorticityNonlinearDifferenceNegativeOneWeightedCoefficient
    (left right : ComplexVorticityHilbertState)
    (output : IntegerWavevector) : ComplexCoordinateVector :=
  if output = 0 then 0
  else
    (Real.sqrt (integerWaveViscousMultiplier output))⁻¹ •
      (wholeStateVorticityNonlinearCoefficientAt left output -
        wholeStateVorticityNonlinearCoefficientAt right output)

theorem
    wholeStateVorticityNonlinearDifferenceNegativeOneWeightedCoefficient_norm_sq
    (left right : ComplexVorticityHilbertState)
    (output : IntegerWavevector) :
    ‖wholeStateVorticityNonlinearDifferenceNegativeOneWeightedCoefficient
        left right output‖ ^ 2 =
      wholeStateVorticityNonlinearDifferenceNegativeOneDensity
        left right output := by
  by_cases outputZero : output = 0
  · simp [wholeStateVorticityNonlinearDifferenceNegativeOneWeightedCoefficient,
      wholeStateVorticityNonlinearDifferenceNegativeOneDensity,
      outputZero]
  · have multiplierPos :
        0 < integerWaveViscousMultiplier output := by
      unfold integerWaveViscousMultiplier
      exact
        mul_pos
          (sq_pos_of_pos (mul_pos (by norm_num) Real.pi_pos))
          (integerWaveNormSq_pos outputZero)
    have multiplierNonneg :
        0 ≤ integerWaveViscousMultiplier output :=
      multiplierPos.le
    have sqrtPos :
        0 < Real.sqrt (integerWaveViscousMultiplier output) :=
      Real.sqrt_pos.2 multiplierPos
    rw [wholeStateVorticityNonlinearDifferenceNegativeOneWeightedCoefficient,
      wholeStateVorticityNonlinearDifferenceNegativeOneDensity,
      if_neg outputZero, if_neg outputZero]
    rw [norm_smul, Real.norm_eq_abs,
      abs_inv, abs_of_nonneg (Real.sqrt_nonneg _)]
    rw [div_eq_mul_inv]
    field_simp [sqrtPos.ne']
    rw [Real.sq_sqrt multiplierNonneg]
    ring

/-- The nonlinear difference as a genuine weighted
`ℓ²(ℤ³; ℂ³)` negative-one state. -/
def wholeStateVorticityNonlinearDifferenceNegativeOneState
    (left right : ComplexVorticityHilbertState)
    (leftTransverse : WholeStateTransverse left)
    (rightTransverse : WholeStateTransverse right)
    (leftGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq (left wave))
    (rightGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq (right wave))
    (differenceGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq ((left - right) wave)) :
    lp (fun _ : IntegerWavevector => ComplexCoordinateVector) 2 :=
  ⟨wholeStateVorticityNonlinearDifferenceNegativeOneWeightedCoefficient
      left right, by
    apply memℓp_gen
    simpa only [ENNReal.toReal_ofNat, Real.rpow_two] using
      (summable_wholeStateVorticityNonlinearDifferenceNegativeOneDensity
        left right leftTransverse rightTransverse
        leftGradientSummable rightGradientSummable
        differenceGradientSummable).congr
          (fun output =>
            (wholeStateVorticityNonlinearDifferenceNegativeOneWeightedCoefficient_norm_sq
              left right output).symm)⟩

@[simp] theorem wholeStateVorticityNonlinearDifferenceNegativeOneState_apply
    (left right : ComplexVorticityHilbertState)
    (leftTransverse : WholeStateTransverse left)
    (rightTransverse : WholeStateTransverse right)
    (leftGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq (left wave))
    (rightGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq (right wave))
    (differenceGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq ((left - right) wave))
    (output : IntegerWavevector) :
    wholeStateVorticityNonlinearDifferenceNegativeOneState
        left right leftTransverse rightTransverse
        leftGradientSummable rightGradientSummable
        differenceGradientSummable output =
      wholeStateVorticityNonlinearDifferenceNegativeOneWeightedCoefficient
        left right output :=
  rfl

theorem wholeStateVorticityNonlinearDifferenceNegativeOneState_norm_sq
    (left right : ComplexVorticityHilbertState)
    (leftTransverse : WholeStateTransverse left)
    (rightTransverse : WholeStateTransverse right)
    (leftGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq (left wave))
    (rightGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq (right wave))
    (differenceGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq ((left - right) wave)) :
    ‖wholeStateVorticityNonlinearDifferenceNegativeOneState
        left right leftTransverse rightTransverse
        leftGradientSummable rightGradientSummable
        differenceGradientSummable‖ ^ 2 =
      wholeStateVorticityNonlinearDifferenceNegativeOneMass
        left right := by
  rw [show
    ‖wholeStateVorticityNonlinearDifferenceNegativeOneState
        left right leftTransverse rightTransverse
        leftGradientSummable rightGradientSummable
        differenceGradientSummable‖ ^ 2 =
      ∑' output : IntegerWavevector,
        ‖wholeStateVorticityNonlinearDifferenceNegativeOneState
          left right leftTransverse rightTransverse
          leftGradientSummable rightGradientSummable
          differenceGradientSummable output‖ ^ 2 by
      simpa using
        (lp.norm_rpow_eq_tsum
          (p := (2 : ℝ≥0∞)) (by norm_num)
          (wholeStateVorticityNonlinearDifferenceNegativeOneState
            left right leftTransverse rightTransverse
            leftGradientSummable rightGradientSummable
            differenceGradientSummable))]
  unfold wholeStateVorticityNonlinearDifferenceNegativeOneMass
  apply tsum_congr
  intro output
  rw [wholeStateVorticityNonlinearDifferenceNegativeOneState_apply,
    wholeStateVorticityNonlinearDifferenceNegativeOneWeightedCoefficient_norm_sq]

/-- Norm bound in the actual weighted whole difference carrier. -/
theorem wholeStateVorticityNonlinearDifferenceNegativeOneState_norm_sq_le
    (left right : ComplexVorticityHilbertState)
    (leftTransverse : WholeStateTransverse left)
    (rightTransverse : WholeStateTransverse right)
    (leftGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq (left wave))
    (rightGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq (right wave))
    (differenceGradientSummable :
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq ((left - right) wave)) :
    ‖wholeStateVorticityNonlinearDifferenceNegativeOneState
        left right leftTransverse rightTransverse
        leftGradientSummable rightGradientSummable
        differenceGradientSummable‖ ^ 2 ≤
      4 *
        ((wholeStateVelocityMajorant left ^ 2 +
            wholeStateVelocityMajorant right ^ 2) *
            wholeVorticityEuclideanMass (left - right) +
          wholeStateVelocityMajorant (left - right) ^ 2 *
            (wholeVorticityEuclideanMass left +
              wholeVorticityEuclideanMass right)) := by
  rw [wholeStateVorticityNonlinearDifferenceNegativeOneState_norm_sq]
  exact
    wholeStateVorticityNonlinearDifferenceNegativeOneMass_le
      left right leftTransverse rightTransverse
      leftGradientSummable rightGradientSummable
      differenceGradientSummable

end

