/-! ## Zero extension and physical output compiler -/

/--
The complete nonlinear coefficient is zero away from the output inventory
generated by the same pair table.
-/
theorem generatedVorticityNonlinearCoefficientAt_eq_zero_of_not_mem
    (source : RawVorticityFourierSource)
    {output : IntegerWavevector}
    (notMem : output ∉ generatedStretchingOutputInventory source) :
    generatedVorticityNonlinearCoefficientAt source output = 0 := by
  rw [generatedVorticityNonlinearCoefficientAt]
  apply Finset.sum_eq_zero
  intro pair pairMembership
  have fiberMembership :=
    (mem_generatedStretchingPairFiber_iff source output pair).mp
      pairMembership
  exact False.elim <| notMem <|
    (mem_generatedStretchingOutputInventory_iff source output).mpr
      ⟨pair, fiberMembership.1, fiberMembership.2⟩

/--
Physical realization of the complete nonlinear coefficient table on the
source-generated output inventory.
-/
def generatedVorticityNonlinearOutputField
    (source : RawVorticityFourierSource) :
    PhysicalSpace → PhysicalSpace :=
  finiteRealComplexFourierField
    (generatedStretchingOutputInventory source)
    (generatedVorticityNonlinearCoefficientAt source)

private theorem realComplexFourierMode_finset_sum
    {ι : Type*}
    (indices : Finset ι)
    (wave : IntegerWavevector)
    (coefficient : ι → ComplexCoordinateVector) :
    realComplexFourierMode wave
        (∑ index ∈ indices, coefficient index) =
      fun x =>
        ∑ index ∈ indices,
          realComplexFourierMode wave (coefficient index) x := by
  funext x
  ext coordinate
  simp [realComplexFourierMode, coefficientReal, coefficientImag]
  rw [Finset.mul_sum, Finset.mul_sum]

/--
Regrouping by generated output is exactly the complete physical nonlinear pair
field.  Every pair is assigned to its source-generated output fiber; no output
coverage or target is supplied by the caller.
-/
theorem generatedVorticityNonlinearPairField_eq_outputField
    (source : RawVorticityFourierSource) :
    generatedVorticityNonlinearPairField source =
      generatedVorticityNonlinearOutputField source := by
  funext x
  unfold generatedVorticityNonlinearPairField
    generatedVorticityNonlinearOutputField
    finiteRealComplexFourierField
  simp_rw [generatedVorticityNonlinearCoefficientAt,
    realComplexFourierMode_finset_sum]
  calc
    (∑ pair ∈ generatedStretchingPairTable source,
        realComplexFourierMode (stretchingPairOutput pair)
          (generatedVorticityNonlinearPairContribution source pair) x) =
      ∑ output ∈ generatedStretchingOutputInventory source,
        ∑ pair ∈ generatedStretchingPairTable source with
            stretchingPairOutput pair = output,
          realComplexFourierMode (stretchingPairOutput pair)
            (generatedVorticityNonlinearPairContribution source pair) x := by
      symm
      exact Finset.sum_fiberwise_of_maps_to
        (fun pair pairMembership =>
          Finset.mem_image.mpr ⟨pair, pairMembership, rfl⟩)
        (fun pair =>
          realComplexFourierMode (stretchingPairOutput pair)
            (generatedVorticityNonlinearPairContribution source pair) x)
    _ =
      ∑ output ∈ generatedStretchingOutputInventory source,
        ∑ pair ∈ generatedStretchingPairFiber source output,
          realComplexFourierMode output
            (generatedVorticityNonlinearPairContribution source pair) x := by
      apply Finset.sum_congr rfl
      intro output outputMembership
      rw [generatedStretchingPairFiber]
      apply Finset.sum_congr rfl
      intro pair pairMembership
      rw [(Finset.mem_filter.mp pairMembership).2]

/-! ## Premise-free physical Fourier readout -/

/--
The actual unit-cell Fourier observer recovers every generated nonlinear
output coefficient.  Signed inventory closure, coefficient reality, and zero
extension are all generated upstream from the same raw source.
-/
theorem
    physicalUnitCellComplexFourierCoordinate_generatedVorticityNonlinearOutputField
    (source : RawVorticityFourierSource)
    (testing : IntegerWavevector) :
    physicalUnitCellComplexFourierCoordinate testing
        (generatedVorticityNonlinearOutputField source) =
      generatedVorticityNonlinearCoefficientAt source testing := by
  rw [generatedVorticityNonlinearOutputField,
    physicalUnitCellComplexFourierCoordinate_finiteRealComplexFourierField]
  funext coordinate
  by_cases membership :
      testing ∈ generatedStretchingOutputInventory source
  · have negMembership :
        waveNeg testing ∈ generatedStretchingOutputInventory source :=
      (mem_generatedStretchingOutputInventory_waveNeg_iff
        source testing).mpr membership
    rw [if_pos membership, if_pos negMembership,
      generatedVorticityNonlinearCoefficientAt_waveNeg]
    simp [vectorConj]
  · have negNotMembership :
        waveNeg testing ∉ generatedStretchingOutputInventory source := by
      simpa only [mem_generatedStretchingOutputInventory_waveNeg_iff]
        using membership
    rw [if_neg membership, if_neg negNotMembership,
      generatedVorticityNonlinearCoefficientAt_eq_zero_of_not_mem
        source membership]
    simp

/-! ## Whole-carrier negative-one output compiler -/

private theorem integerWaveFrequencyCube_waveNeg_mem
    (radius : Nat) {wave : IntegerWavevector}
    (waveMem : wave ∈ integerWaveFrequencyCube radius) :
    waveNeg wave ∈ integerWaveFrequencyCube radius := by
  rw [integerWaveFrequencyCube, Fintype.mem_piFinset] at waveMem ⊢
  intro coordinate
  have coordinateMem := Finset.mem_Icc.mp (waveMem coordinate)
  apply Finset.mem_Icc.mpr
  constructor
  · simpa [waveNeg] using neg_le_neg coordinateMem.2
  · simpa [waveNeg] using neg_le_neg coordinateMem.1

private theorem complexFourierRealityReflection_frequencyCube_eq_projection
    (radius : Nat)
    (state : ComplexVorticityHilbertState)
    (reality : FiniteStateFourierReality state) :
    complexFourierRealityReflection
        (integerWaveFrequencyCube radius) state =
      complexSharpSupportProjection
        (integerWaveFrequencyCube radius) state := by
  apply Subtype.ext
  funext wave
  by_cases waveMem : wave ∈ integerWaveFrequencyCube radius
  · rw [complexFourierRealityReflection_apply,
      complexSharpSupportProjection_apply,
      if_pos waveMem, if_pos waveMem, reality wave]
    simp
  · rw [complexFourierRealityReflection_apply,
      complexSharpSupportProjection_apply,
      if_neg waveMem, if_neg waveMem]

private theorem finiteStateVorticityNonlinearCoefficientAt_frequencyCube_waveNeg
    (radius : Nat)
    (state : ComplexVorticityHilbertState)
    (reality : FiniteStateFourierReality state)
    (output : IntegerWavevector) :
    finiteStateVorticityNonlinearCoefficientAt
        (integerWaveFrequencyCube radius) state output =
      vectorConj
        (finiteStateVorticityNonlinearCoefficientAt
          (integerWaveFrequencyCube radius) state
          (waveNeg output)) := by
  let modes := integerWaveFrequencyCube radius
  have reflected :=
    finiteStateVorticityNonlinearCoefficientAt_realityReflection
      (modes := modes)
      (fun {_wave} waveMem =>
        integerWaveFrequencyCube_waveNeg_mem radius waveMem)
      state output
  rw [complexFourierRealityReflection_frequencyCube_eq_projection
    radius state reality] at reflected
  rw [finiteStateVorticityNonlinearCoefficientAt_projection_of_subset
    (Finset.Subset.rfl) state output] at reflected
  exact reflected

/-- The infinite nonlinear Fourier row preserves the reality law generated
by the same transverse whole state. -/
theorem wholeStateVorticityNonlinearCoefficientAt_waveNeg
    (state : ComplexVorticityHilbertState)
    (stateTransverse : WholeStateTransverse state)
    (reality : FiniteStateFourierReality state)
    (output : IntegerWavevector) :
    wholeStateVorticityNonlinearCoefficientAt state output =
      vectorConj
        (wholeStateVorticityNonlinearCoefficientAt
          state (waveNeg output)) := by
  have leftTendsto :=
    finiteStateVorticityNonlinearCoefficientAt_frequencyCube_tendsto
      state stateTransverse output
  have rightTendsto :=
    finiteStateVorticityNonlinearCoefficientAt_frequencyCube_tendsto
      state stateTransverse (waveNeg output)
  have conjTendsto :
      Tendsto
        (fun radius =>
          vectorConj
            (finiteStateVorticityNonlinearCoefficientAt
              (integerWaveFrequencyCube radius) state
              (waveNeg output)))
        atTop
        (nhds
          (vectorConj
            (wholeStateVorticityNonlinearCoefficientAt
              state (waveNeg output)))) :=
    complexCoordinateVectorConjCLM.continuous.continuousAt.tendsto.comp
      rightTendsto
  apply tendsto_nhds_unique leftTendsto
  rw [show
    (fun radius =>
      finiteStateVorticityNonlinearCoefficientAt
        (integerWaveFrequencyCube radius) state output) =
      (fun radius =>
        vectorConj
          (finiteStateVorticityNonlinearCoefficientAt
            (integerWaveFrequencyCube radius) state
            (waveNeg output))) by
      funext radius
      exact
        finiteStateVorticityNonlinearCoefficientAt_frequencyCube_waveNeg
          radius state reality output]
  exact conjTendsto

private theorem vectorConj_real_smul
    (scalar : Real)
    (vector : ComplexCoordinateVector) :
    vectorConj (scalar • vector) =
      scalar • vectorConj vector := by
  funext coordinate
  simp [vectorConj]

/-- Installing the inverse square-root Laplacian weight preserves the
source state's signed Fourier reality. -/
theorem wholeStateVorticityNonlinearNegativeOneWeightedCoefficient_waveNeg
    (state : ComplexVorticityHilbertState)
    (stateTransverse : WholeStateTransverse state)
    (reality : FiniteStateFourierReality state)
    (output : IntegerWavevector) :
    wholeStateVorticityNonlinearNegativeOneWeightedCoefficient
        state (waveNeg output) =
      vectorConj
        (wholeStateVorticityNonlinearNegativeOneWeightedCoefficient
          state output) := by
  by_cases outputZero : output = 0
  · subst output
    simp [wholeStateVorticityNonlinearNegativeOneWeightedCoefficient]
  · have negOutputZero : waveNeg output ≠ 0 := by
      simpa using outputZero
    have nonlinearNeg :
        wholeStateVorticityNonlinearCoefficientAt
            state (waveNeg output) =
          vectorConj
            (wholeStateVorticityNonlinearCoefficientAt state output) := by
      simpa using
        wholeStateVorticityNonlinearCoefficientAt_waveNeg
          state stateTransverse reality (waveNeg output)
    rw [wholeStateVorticityNonlinearNegativeOneWeightedCoefficient,
      if_neg negOutputZero,
      wholeStateVorticityNonlinearNegativeOneWeightedCoefficient,
      if_neg outputZero, integerWaveViscousMultiplier_waveNeg,
      nonlinearNeg, vectorConj_real_smul]

private theorem complexCoordinateAmplitudeSq_real_smul
    (scalar : Real)
    (vector : ComplexCoordinateVector) :
    complexCoordinateAmplitudeSq (scalar • vector) =
      scalar ^ 2 * complexCoordinateAmplitudeSq vector := by
  simp_rw [complexCoordinateAmplitudeSq_eq_complexCoordinateVectorNormSq]
  change
    complexCoordinateVectorNormSq ((scalar : Complex) • vector) = _
  rw [complexCoordinateVectorNormSq_smul, Complex.normSq_ofReal]
  ring

/-- The weighted row's Euclidean amplitude is exactly the nonlinear
negative-one density used by the whole action ledger. -/
theorem
    wholeStateVorticityNonlinearNegativeOneWeightedCoefficient_amplitudeSq
    (state : ComplexVorticityHilbertState)
    (output : IntegerWavevector) :
    complexCoordinateAmplitudeSq
        (wholeStateVorticityNonlinearNegativeOneWeightedCoefficient
          state output) =
      (integerWaveViscousMultiplier output)⁻¹ *
        complexCoordinateAmplitudeSq
          (wholeStateVorticityNonlinearCoefficientAt state output) := by
  by_cases outputZero : output = 0
  · subst output
    rw [wholeStateVorticityNonlinearNegativeOneWeightedCoefficient,
      if_pos rfl]
    simp [complexCoordinateAmplitudeSq, integerWaveViscousMultiplier,
      integerWaveNormSq]
  · have multiplierPos :
        0 < integerWaveViscousMultiplier output := by
      unfold integerWaveViscousMultiplier
      exact mul_pos
        (sq_pos_of_pos (mul_pos (by norm_num) Real.pi_pos))
        (integerWaveNormSq_pos outputZero)
    rw [wholeStateVorticityNonlinearNegativeOneWeightedCoefficient,
      if_neg outputZero, complexCoordinateAmplitudeSq_real_smul]
    rw [show
      (Real.sqrt (integerWaveViscousMultiplier output))⁻¹ ^ 2 =
        (integerWaveViscousMultiplier output)⁻¹ by
      rw [inv_pow]
      apply congrArg Inv.inv
      exact Real.sq_sqrt multiplierPos.le]

/-- Finite physical realization of the whole nonlinear negative-one rows in
one canonical output cube. -/
def wholeStateVorticityNonlinearNegativeOneOutputField
    (radius : Nat)
    (state : ComplexVorticityHilbertState) :
    PhysicalSpace → PhysicalSpace :=
  finiteRealComplexFourierField
    (integerWaveFrequencyCube radius)
    (wholeStateVorticityNonlinearNegativeOneWeightedCoefficient state)

/-- The unit-cell physical square of the finite output field is exactly the
same low-output nonlinear negative-one action density. -/
theorem
    physicalUnitCell_wholeStateVorticityNonlinearNegativeOneOutputField_parseval
    (radius : Nat)
    (state : ComplexVorticityHilbertState)
    (stateTransverse : WholeStateTransverse state)
    (reality : FiniteStateFourierReality state) :
    (∫ x in physicalUnitCell,
      velocityDot
        (wholeStateVorticityNonlinearNegativeOneOutputField radius state)
        (wholeStateVorticityNonlinearNegativeOneOutputField radius state) x) =
      ∑ output ∈ integerWaveFrequencyCube radius,
        (integerWaveViscousMultiplier output)⁻¹ *
          complexCoordinateAmplitudeSq
            (wholeStateVorticityNonlinearCoefficientAt state output) := by
  let modes := integerWaveFrequencyCube radius
  let coefficient :=
    wholeStateVorticityNonlinearNegativeOneWeightedCoefficient state
  have observerExact :
      ∀ output ∈ modes,
        physicalUnitCellComplexFourierCoordinate output
            (finiteRealComplexFourierField modes coefficient) =
          coefficient output := by
    intro output outputMem
    rw [physicalUnitCellComplexFourierCoordinate_finiteRealComplexFourierField]
    funext coordinate
    rw [if_pos outputMem,
      if_pos (integerWaveFrequencyCube_waveNeg_mem radius outputMem)]
    rw [show
      coefficient (waveNeg output) =
        vectorConj (coefficient output) by
      exact
        wholeStateVorticityNonlinearNegativeOneWeightedCoefficient_waveNeg
          state stateTransverse reality output]
    simp [vectorConj]
  have parseval :=
    physicalUnitCell_finiteRealComplexFourierField_parseval_of_observer
      modes coefficient observerExact
  rw [show
    wholeStateVorticityNonlinearNegativeOneOutputField radius state =
      finiteRealComplexFourierField modes coefficient by rfl]
  rw [parseval]
  apply Finset.sum_congr rfl
  intro output outputMem
  rw [← complexCoordinateAmplitudeSq_eq_complexCoordinateVectorNormSq]
  exact
    wholeStateVorticityNonlinearNegativeOneWeightedCoefficient_amplitudeSq
      state output

end

