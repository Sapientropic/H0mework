import H0mework.NavierStokes.Fourier.CoarseKernelMoments
import Mathlib.Analysis.SpecialFunctions.Trigonometric.Bounds

/-!
# Integer characters of the periodic coarse filter

An integer wavevector generates real sine and cosine characters on the
lifted three-torus.  The actual normalized even coarse kernel acts on each
such character by the scalar obtained by filtering its cosine at the
origin.

The two whole-point formulas below derive this diagonal action directly
from convolution, compact support, and inversion symmetry.  No multiplier
nonvanishing, faithfulness, spectral gap, or target observer is assumed.
This module does not yet evaluate a two-scale stress observer or a
unit-cell mean.
-/

open MeasureTheory

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalPeriodicIntegerCharacterCoarseFilter

open ThreeDimensionalPeriodicCoarseFilterCore
open ThreeDimensionalPeriodicCoarseKernelMoments

noncomputable section

/-- An integer frequency on the three physical coordinates. -/
abbrev IntegerWavevector := Coordinate → ℤ

/-- The real phase `2π k · x` generated by an integer wavevector. -/
def integerWavePhase
    (k : IntegerWavevector) (x : PhysicalSpace) : ℝ :=
  (2 * Real.pi) * ∑ i : Coordinate, (k i : ℝ) * x i

theorem integerWavePhase_zero
    (k : IntegerWavevector) :
    integerWavePhase k (0 : PhysicalSpace) = 0 := by
  simp [integerWavePhase]

theorem integerWavePhase_add
    (k : IntegerWavevector) (x y : PhysicalSpace) :
    integerWavePhase k (x + y) =
      integerWavePhase k x + integerWavePhase k y := by
  simp only [integerWavePhase, PiLp.add_apply, mul_add,
    Finset.sum_add_distrib]

theorem integerWavePhase_sub
    (k : IntegerWavevector) (x y : PhysicalSpace) :
    integerWavePhase k (x - y) =
      integerWavePhase k x - integerWavePhase k y := by
  simp only [integerWavePhase, PiLp.sub_apply, mul_sub,
    Finset.sum_sub_distrib]

theorem integerWavePhase_neg
    (k : IntegerWavevector) (x : PhysicalSpace) :
    integerWavePhase k (-x) = -integerWavePhase k x := by
  simp only [integerWavePhase, PiLp.neg_apply, mul_neg,
    Finset.sum_neg_distrib]

theorem integerWavePhase_continuous
    (k : IntegerWavevector) :
    Continuous (integerWavePhase k) := by
  unfold integerWavePhase
  fun_prop

/-- A coordinatewise frequency ceiling gives the physical Euclidean phase
bound with the exact three-dimensional factor. -/
theorem integerWavePhase_abs_le_of_coordinate_bound
    (wave : IntegerWavevector)
    (x : PhysicalSpace)
    (frequencyBound : ℝ)
    (frequencyBoundNonneg : 0 ≤ frequencyBound)
    (coordinateBound :
      ∀ coordinate : Coordinate,
        |(wave coordinate : ℝ)| ≤ frequencyBound) :
    |integerWavePhase wave x| ≤
      6 * Real.pi * frequencyBound * ‖x‖ := by
  have termLe (coordinate : Coordinate) :
      |(wave coordinate : ℝ) * x coordinate| ≤
        frequencyBound * ‖x‖ := by
    rw [abs_mul]
    have coordinateLe : |x coordinate| ≤ ‖x‖ := by
      simpa only [Real.norm_eq_abs] using
        PiLp.norm_apply_le x coordinate
    exact mul_le_mul (coordinateBound coordinate) coordinateLe
      (abs_nonneg _) frequencyBoundNonneg
  unfold integerWavePhase
  calc
    |(2 * Real.pi) *
        ∑ coordinate : Coordinate, (wave coordinate : ℝ) * x coordinate| =
        (2 * Real.pi) *
          |∑ coordinate : Coordinate,
            (wave coordinate : ℝ) * x coordinate| := by
      rw [abs_mul, abs_of_pos (mul_pos (by norm_num) Real.pi_pos)]
    _ ≤ (2 * Real.pi) *
        ∑ coordinate : Coordinate,
          |(wave coordinate : ℝ) * x coordinate| := by
      exact mul_le_mul_of_nonneg_left
        (by
          simpa only [Finset.sum_attach] using
            Finset.abs_sum_le_sum_abs
              (fun coordinate : Coordinate =>
                (wave coordinate : ℝ) * x coordinate)
              Finset.univ)
        (mul_pos (by norm_num) Real.pi_pos).le
    _ ≤ (2 * Real.pi) *
        ∑ _coordinate : Coordinate, frequencyBound * ‖x‖ := by
      exact mul_le_mul_of_nonneg_left
        (Finset.sum_le_sum fun coordinate _ => termLe coordinate)
        (mul_pos (by norm_num) Real.pi_pos).le
    _ = 6 * Real.pi * frequencyBound * ‖x‖ := by
      norm_num [Fin.sum_univ_three]
      ring

/-- The real cosine character generated by `k`. -/
def integerCosine
    (k : IntegerWavevector) (x : PhysicalSpace) : ℝ :=
  Real.cos (integerWavePhase k x)

/-- The real sine character generated by `k`. -/
def integerSine
    (k : IntegerWavevector) (x : PhysicalSpace) : ℝ :=
  Real.sin (integerWavePhase k x)

theorem integerCosine_continuous
    (k : IntegerWavevector) :
    Continuous (integerCosine k) :=
  Real.continuous_cos.comp (integerWavePhase_continuous k)

theorem integerSine_continuous
    (k : IntegerWavevector) :
    Continuous (integerSine k) :=
  Real.continuous_sin.comp (integerWavePhase_continuous k)

theorem integerCosine_neg
    (k : IntegerWavevector) (x : PhysicalSpace) :
    integerCosine k (-x) = integerCosine k x := by
  unfold integerCosine
  rw [integerWavePhase_neg, Real.cos_neg]

theorem integerSine_neg
    (k : IntegerWavevector) (x : PhysicalSpace) :
    integerSine k (-x) = -integerSine k x := by
  unfold integerSine
  rw [integerWavePhase_neg, Real.sin_neg]

private theorem coarseKernel_mul_integerCosine_integrable
    (s : CoarseScale) (k : IntegerWavevector) :
    Integrable
      (fun y : PhysicalSpace =>
        coarseKernel s y * integerCosine k y) volume := by
  exact
    ((coarseKernel_contDiff s).continuous.mul
      (integerCosine_continuous k)).integrable_of_hasCompactSupport
        (coarseKernel_hasCompactSupport s).mul_right

private theorem coarseKernel_mul_integerSine_integrable
    (s : CoarseScale) (k : IntegerWavevector) :
    Integrable
      (fun y : PhysicalSpace =>
        coarseKernel s y * integerSine k y) volume := by
  exact
    ((coarseKernel_contDiff s).continuous.mul
      (integerSine_continuous k)).integrable_of_hasCompactSupport
        (coarseKernel_hasCompactSupport s).mul_right

/--
The actual even kernel annihilates every generated integer sine character
at the origin.
-/
theorem coarseFilter_integerSine_origin_eq_zero
    (s : CoarseScale) (k : IntegerWavevector) :
    coarseFilter s (integerSine k) (0 : PhysicalSpace) = 0 := by
  let integrand : PhysicalSpace → ℝ :=
    fun y => coarseKernel s y * integerSine k (-y)
  have hOdd :
      (fun y => integrand (-y)) = -integrand := by
    funext y
    unfold integrand
    rw [neg_neg, coarseKernel_neg]
    simp only [Pi.neg_apply, integerSine_neg]
    ring
  have hInvariant :=
    integral_neg_eq_self integrand volume
  rw [hOdd] at hInvariant
  change
    (∫ y : PhysicalSpace, -integrand y) =
      ∫ y : PhysicalSpace, integrand y at hInvariant
  have hAntisymmetric :
      -(∫ y : PhysicalSpace, integrand y) =
        ∫ y : PhysicalSpace, integrand y := by
    simpa only [integral_neg] using hInvariant
  have hIntegral :
      ∫ y : PhysicalSpace, integrand y = 0 := by
    linarith [hAntisymmetric]
  simpa only [coarseFilter, convolution_def,
    ContinuousLinearMap.lsmul_apply, smul_eq_mul,
    zero_sub, integrand] using hIntegral

/--
The scalar generated by applying the actual coarse filter to the cosine
character at the origin.
-/
def coarseCharacterMultiplier
    (s : CoarseScale) (k : IntegerWavevector) : ℝ :=
  coarseFilter s (integerCosine k) (0 : PhysicalSpace)

theorem coarseCharacterMultiplier_eq_integral
    (s : CoarseScale) (k : IntegerWavevector) :
    coarseCharacterMultiplier s k =
      ∫ y : PhysicalSpace,
        coarseKernel s y * integerCosine k y := by
  simp only [coarseCharacterMultiplier, coarseFilter,
    convolution_def, ContinuousLinearMap.lsmul_apply,
    smul_eq_mul, zero_sub, integerCosine_neg]

/-- At its source-owned reciprocal physical scale, the normalized coarse
kernel retains at least one half of every integer character under a supplied
coordinatewise frequency ceiling.  The conclusion is generated by the
actual compact kernel and does not assume multiplier faithfulness. -/
theorem coarseCharacterMultiplier_ge_half_of_coordinate_bound
    (s : CoarseScale)
    (wave : IntegerWavevector)
    (frequencyBound : ℝ)
    (frequencyBoundNonneg : 0 ≤ frequencyBound)
    (coordinateBound :
      ∀ coordinate : Coordinate,
        |(wave coordinate : ℝ)| ≤ frequencyBound)
    (scaleSmall :
      6 * Real.pi * frequencyBound * s.radius ≤ 1) :
    (1 / 2 : ℝ) ≤ coarseCharacterMultiplier s wave := by
  have scaleCoefficientNonneg :
      0 ≤ 6 * Real.pi * frequencyBound := by
    positivity
  have kernelIntegrable :
      Integrable (coarseKernel s) volume :=
    (coarseKernel_contDiff s).continuous.integrable_of_hasCompactSupport
      (coarseKernel_hasCompactSupport s)
  have lowerIntegrable :
      Integrable (fun x : PhysicalSpace =>
        (1 / 2 : ℝ) * coarseKernel s x) volume :=
    kernelIntegrable.const_mul (1 / 2 : ℝ)
  have filteredIntegrable :
      Integrable (fun x : PhysicalSpace =>
        coarseKernel s x * integerCosine wave x) volume :=
    ((coarseKernel_contDiff s).continuous.mul
      (integerCosine_continuous wave)).integrable_of_hasCompactSupport
        (coarseKernel_hasCompactSupport s).mul_right
  have pointwise :
      ∀ x : PhysicalSpace,
        (1 / 2 : ℝ) * coarseKernel s x ≤
          coarseKernel s x * integerCosine wave x := by
    intro x
    by_cases kernelZero : coarseKernel s x = 0
    · simp [kernelZero]
    · have support :
          x ∈ Function.support (coarseKernel s) := kernelZero
      rw [show
          Function.support (coarseKernel s) =
            Metric.ball (0 : PhysicalSpace) s.radius by
        exact (coarseBump s).support_normed_eq] at support
      have normLe : ‖x‖ ≤ s.radius := by
        exact le_of_lt (by
          simpa only [Metric.mem_ball, dist_zero_right] using support)
      have phaseAbsLe : |integerWavePhase wave x| ≤ 1 := by
        calc
          |integerWavePhase wave x| ≤
              6 * Real.pi * frequencyBound * ‖x‖ :=
            integerWavePhase_abs_le_of_coordinate_bound
              wave x frequencyBound frequencyBoundNonneg coordinateBound
          _ ≤ 6 * Real.pi * frequencyBound * s.radius :=
            mul_le_mul_of_nonneg_left normLe scaleCoefficientNonneg
          _ ≤ 1 := scaleSmall
      have phaseSqLe : integerWavePhase wave x ^ 2 ≤ 1 := by
        have square :=
          (sq_le_sq₀ (abs_nonneg (integerWavePhase wave x))
            (by norm_num : (0 : ℝ) ≤ 1)).2 phaseAbsLe
        simpa only [sq_abs, one_pow] using square
      have cosineHalf : (1 / 2 : ℝ) ≤ integerCosine wave x := by
        unfold integerCosine
        have cosineLower :=
          Real.one_sub_sq_div_two_le_cos
            (x := integerWavePhase wave x)
        nlinarith
      simpa only [mul_comm] using
        mul_le_mul_of_nonneg_left cosineHalf
          (coarseKernel_nonneg s x)
  calc
    (1 / 2 : ℝ) =
        ∫ x : PhysicalSpace, (1 / 2 : ℝ) * coarseKernel s x := by
      rw [integral_const_mul, coarseKernel_integral]
      ring
    _ ≤ ∫ x : PhysicalSpace,
        coarseKernel s x * integerCosine wave x := by
      exact integral_mono lowerIntegrable filteredIntegrable pointwise
    _ = coarseCharacterMultiplier s wave :=
      (coarseCharacterMultiplier_eq_integral s wave).symm

/-- Normalization fixes the zero-frequency multiplier to one. -/
@[simp]
theorem coarseCharacterMultiplier_zero
    (s : CoarseScale) :
    coarseCharacterMultiplier s (0 : IntegerWavevector) = 1 := by
  have hCharacter :
      integerCosine (0 : IntegerWavevector) =
        fun _ : PhysicalSpace => (1 : ℝ) := by
    funext x
    simp [integerCosine, integerWavePhase]
  rw [coarseCharacterMultiplier, hCharacter]
  exact congrFun (coarseFilter_const s (1 : ℝ))
    (0 : PhysicalSpace)

/--
The actual coarse convolution acts diagonally on every integer cosine
character at every spatial point.
-/
theorem coarseFilter_integerCosine_apply
    (s : CoarseScale) (k : IntegerWavevector)
    (x : PhysicalSpace) :
    coarseFilter s (integerCosine k) x =
      coarseCharacterMultiplier s k * integerCosine k x := by
  have hCos :=
    coarseKernel_mul_integerCosine_integrable s k
  have hSin :=
    coarseKernel_mul_integerSine_integrable s k
  rw [coarseCharacterMultiplier_eq_integral]
  simp only [coarseFilter, convolution_def,
    ContinuousLinearMap.lsmul_apply, smul_eq_mul]
  calc
    (∫ y : PhysicalSpace,
        coarseKernel s y * integerCosine k (x - y)) =
        ∫ y : PhysicalSpace,
          integerCosine k x *
              (coarseKernel s y * integerCosine k y) +
            integerSine k x *
              (coarseKernel s y * integerSine k y) := by
      apply integral_congr_ae
      filter_upwards with y
      simp only [integerCosine, integerSine,
        integerWavePhase_sub, Real.cos_sub]
      ring
    _ =
        integerCosine k x *
            (∫ y : PhysicalSpace,
              coarseKernel s y * integerCosine k y) +
          integerSine k x *
            (∫ y : PhysicalSpace,
              coarseKernel s y * integerSine k y) := by
      rw [integral_add
          (hCos.const_mul (integerCosine k x))
          (hSin.const_mul (integerSine k x)),
        integral_const_mul, integral_const_mul]
    _ =
        (∫ y : PhysicalSpace,
          coarseKernel s y * integerCosine k y) *
            integerCosine k x := by
      have hSineIntegral :
          (∫ y : PhysicalSpace,
            coarseKernel s y * integerSine k y) = 0 := by
        have hOrigin :=
          coarseFilter_integerSine_origin_eq_zero s k
        simpa only [coarseFilter, convolution_def,
          ContinuousLinearMap.lsmul_apply, smul_eq_mul,
          zero_sub, integerSine_neg, mul_neg,
          integral_neg, neg_eq_zero] using hOrigin
      rw [hSineIntegral]
      ring

/--
The same source-generated multiplier acts on the matching sine character at
every spatial point.
-/
theorem coarseFilter_integerSine_apply
    (s : CoarseScale) (k : IntegerWavevector)
    (x : PhysicalSpace) :
    coarseFilter s (integerSine k) x =
      coarseCharacterMultiplier s k * integerSine k x := by
  have hCos :=
    coarseKernel_mul_integerCosine_integrable s k
  have hSin :=
    coarseKernel_mul_integerSine_integrable s k
  rw [coarseCharacterMultiplier_eq_integral]
  simp only [coarseFilter, convolution_def,
    ContinuousLinearMap.lsmul_apply, smul_eq_mul]
  calc
    (∫ y : PhysicalSpace,
        coarseKernel s y * integerSine k (x - y)) =
        ∫ y : PhysicalSpace,
          integerSine k x *
              (coarseKernel s y * integerCosine k y) -
            integerCosine k x *
              (coarseKernel s y * integerSine k y) := by
      apply integral_congr_ae
      filter_upwards with y
      simp only [integerCosine, integerSine,
        integerWavePhase_sub, Real.sin_sub]
      ring
    _ =
        integerSine k x *
            (∫ y : PhysicalSpace,
              coarseKernel s y * integerCosine k y) -
          integerCosine k x *
            (∫ y : PhysicalSpace,
              coarseKernel s y * integerSine k y) := by
      rw [integral_sub
          (hCos.const_mul (integerSine k x))
          (hSin.const_mul (integerCosine k x)),
        integral_const_mul, integral_const_mul]
    _ =
        (∫ y : PhysicalSpace,
          coarseKernel s y * integerCosine k y) *
            integerSine k x := by
      have hSineIntegral :
          (∫ y : PhysicalSpace,
            coarseKernel s y * integerSine k y) = 0 := by
        have hOrigin :=
          coarseFilter_integerSine_origin_eq_zero s k
        simpa only [coarseFilter, convolution_def,
          ContinuousLinearMap.lsmul_apply, smul_eq_mul,
          zero_sub, integerSine_neg, mul_neg,
          integral_neg, neg_eq_zero] using hOrigin
      rw [hSineIntegral]
      ring

end

end ThreeDimensionalPeriodicIntegerCharacterCoarseFilter
end NavierStokes
end SaturationMonoid
