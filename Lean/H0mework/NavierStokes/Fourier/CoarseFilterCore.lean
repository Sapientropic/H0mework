import Mathlib.Analysis.Calculus.BumpFunction.Convolution
import Mathlib.Analysis.InnerProductSpace.PiL2

/-!
# A source-owned coarse filter on lifted periodic three-space

This module starts the infinite-carrier Navier--Stokes line.  The carrier is
the full function space on `EuclideanSpace ℝ (Fin 3)`; `Fin 3` records the
three physical coordinates and is not a Fourier or Galerkin truncation.

A positive physical radius generates a normalized, compactly supported,
smooth bump kernel.  Convolution with that kernel is the native coarse
update.  Integer-lattice periodicity is preserved by the actual convolution,
so the construction applies to lifted fields on the three-torus.

The derivative theorem below is deliberately the theorem supplied by the
compact smooth kernel: it identifies the derivative of the filtered field
with convolution against the derivative of the kernel.  It does **not** yet
identify this expression with the filter of the derivative of the input.
That integration-by-parts bridge remains a separate T1 obligation.
-/

open scoped Convolution
open MeasureTheory

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalPeriodicCoarseFilterCore

noncomputable section

abbrev Coordinate := Fin 3

abbrev PhysicalSpace := EuclideanSpace ℝ Coordinate

abbrev IntegerShift := Coordinate → ℤ

/-- A scale is generated by a strictly positive physical radius. -/
structure CoarseScale where
  radius : ℝ
  radius_pos : 0 < radius

/--
The source-owned bump has inner radius `radius / 2` and outer radius
`radius`.  No kernel, normalization, or support certificate is supplied by a
caller.
-/
noncomputable def coarseBump (s : CoarseScale) :
    ContDiffBump (0 : PhysicalSpace) where
  rIn := s.radius / 2
  rOut := s.radius
  rIn_pos := div_pos s.radius_pos (by norm_num)
  rIn_lt_rOut := by
    linarith [s.radius_pos]

/-- The normalized coarse kernel generated by `s`. -/
noncomputable def coarseKernel (s : CoarseScale) : PhysicalSpace → ℝ :=
  (coarseBump s).normed volume

/--
The native spatial coarse update on the full function carrier.

The output type may be any real normed additive group.  In particular, it
may be the velocity space or a finite-coordinate tensor value space while
the spatial carrier remains infinite.
-/
noncomputable def coarseFilter {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (s : CoarseScale) (f : PhysicalSpace → E) : PhysicalSpace → E :=
  coarseKernel s ⋆[ContinuousLinearMap.lsmul ℝ ℝ, volume] f

/-- Embed an integer lattice displacement into physical three-space. -/
def latticeShift (z : IntegerShift) : PhysicalSpace :=
  WithLp.toLp 2 (fun i => (z i : ℝ))

/-- A function on three-space is the lift of a unit-periodic field. -/
def LatticePeriodic {E : Type*} [Add E]
    (f : PhysicalSpace → E) : Prop :=
  ∀ z x, f (x + latticeShift z) = f x

theorem coarseKernel_nonneg (s : CoarseScale) (x : PhysicalSpace) :
    0 ≤ coarseKernel s x :=
  (coarseBump s).nonneg_normed x

theorem coarseKernel_integral (s : CoarseScale) :
    ∫ x : PhysicalSpace, coarseKernel s x = 1 :=
  (coarseBump s).integral_normed

theorem coarseKernel_hasCompactSupport (s : CoarseScale) :
    HasCompactSupport (coarseKernel s) :=
  (coarseBump s).hasCompactSupport_normed

theorem coarseKernel_contDiff (s : CoarseScale) :
    ContDiff ℝ (⊤ : ℕ∞) (coarseKernel s) :=
  (coarseBump s).contDiff_normed

/-- Normalization makes the native coarse update preserve constants. -/
theorem coarseFilter_const {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (s : CoarseScale) (c : E) :
    coarseFilter s (fun _ => c) = fun _ => c := by
  funext x
  exact (coarseBump s).normed_convolution_eq_right (fun _ _ => rfl)

/--
Additivity is generated on the locally integrable domain where both
convolutions genuinely exist.  It is not asserted for arbitrary
nonintegrable functions, for which the Bochner integral uses its fallback
value.
-/
theorem coarseFilter_add {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (s : CoarseScale) (f g : PhysicalSpace → E)
    (hf : LocallyIntegrable f volume)
    (hg : LocallyIntegrable g volume) :
    coarseFilter s (f + g) =
      coarseFilter s f + coarseFilter s g := by
  exact
    ((coarseKernel_hasCompactSupport s).convolutionExists_left
      (ContinuousLinearMap.lsmul ℝ ℝ)
      (coarseKernel_contDiff s).continuous hf).distrib_add
        ((coarseKernel_hasCompactSupport s).convolutionExists_left
          (ContinuousLinearMap.lsmul ℝ ℝ)
          (coarseKernel_contDiff s).continuous hg)

theorem coarseFilter_neg {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (s : CoarseScale) (f : PhysicalSpace → E) :
    coarseFilter s (-f) = -coarseFilter s f := by
  simpa only [coarseFilter, neg_one_smul] using
    (MeasureTheory.convolution_smul
      (L := ContinuousLinearMap.lsmul ℝ ℝ)
      (μ := volume) (f := coarseKernel s) (g := f) (y := (-1 : ℝ)))

theorem coarseFilter_smul {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (s : CoarseScale) (a : ℝ) (f : PhysicalSpace → E) :
    coarseFilter s (a • f) = a • coarseFilter s f := by
  simpa only [coarseFilter] using
    (MeasureTheory.convolution_smul
      (L := ContinuousLinearMap.lsmul ℝ ℝ)
      (μ := volume) (f := coarseKernel s) (g := f) (y := a))

theorem coarseFilter_sub {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (s : CoarseScale) (f g : PhysicalSpace → E)
    (hf : LocallyIntegrable f volume)
    (hg : LocallyIntegrable g volume) :
    coarseFilter s (f - g) =
      coarseFilter s f - coarseFilter s g := by
  rw [sub_eq_add_neg, coarseFilter_add s f (-g) hf hg.neg,
    coarseFilter_neg]
  simp only [sub_eq_add_neg]

/--
The compact smooth kernel differentiates the actual coarse update.

This is not yet a theorem that moves a derivative from the kernel onto `f`.
-/
theorem coarseFilter_hasFDerivAt {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (s : CoarseScale) (f : PhysicalSpace → E)
    (hf : LocallyIntegrable f volume) (x : PhysicalSpace) :
    HasFDerivAt (coarseFilter s f)
      ((fderiv ℝ (coarseKernel s) ⋆[
        (ContinuousLinearMap.lsmul ℝ ℝ).precompL PhysicalSpace,
        volume] f) x) x := by
  exact
    (coarseBump s).hasCompactSupport_normed.hasFDerivAt_convolution_left
      (ContinuousLinearMap.lsmul ℝ ℝ)
      (coarseBump s).contDiff_normed hf x

/-- A locally integrable input is smoothed to all orders by the native filter. -/
theorem coarseFilter_contDiff {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (s : CoarseScale) (f : PhysicalSpace → E)
    (hf : LocallyIntegrable f volume) :
    ContDiff ℝ (⊤ : ℕ∞) (coarseFilter s f) := by
  exact
    (coarseBump s).hasCompactSupport_normed.contDiff_convolution_left
      (ContinuousLinearMap.lsmul ℝ ℝ)
      (coarseBump s).contDiff_normed hf

/--
The native coarse update respects the integer-lattice identification.

No periodicity certificate for the output is stored: it is proved directly
from the same convolution and the input's actual lattice law.
-/
theorem coarseFilter_latticePeriodic {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (s : CoarseScale) (f : PhysicalSpace → E)
    (hf : LatticePeriodic f) :
    LatticePeriodic (coarseFilter s f) := by
  intro z x
  simp only [coarseFilter, convolution_def,
    ContinuousLinearMap.lsmul_apply]
  apply integral_congr_ae
  filter_upwards with t
  rw [show x + latticeShift z - t =
    (x - t) + latticeShift z by abel]
  rw [hf z (x - t)]

end

end ThreeDimensionalPeriodicCoarseFilterCore
end NavierStokes
end SaturationMonoid
