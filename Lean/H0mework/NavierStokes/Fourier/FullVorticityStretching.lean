import Mathlib.Analysis.Calculus.FDeriv.Symmetric
import H0mework.NavierStokes.Fourier.CoarseNonlinearDivergence
import H0mework.NavierStokes.Fourier.CoarseVectorCalculus
import H0mework.NavierStokes.Fourier.LocalEnergyAlgebra

/-!
# Full three-dimensional vorticity stretching algebra

This module defines the right-handed curl on the full physical
`EuclideanSpace ℝ (Fin 3)` carrier and derives the exact incompressible
vorticity identity

```text
curl (-div (u ⊗ u)) = -(u · ∇) curl u + (curl u · ∇) u.
```

The theorem is a generic PDE algebra/readout.  It consumes a smooth,
divergence-free velocity field; it does not generate such a field, a
Navier--Stokes trajectory, or a regularity estimate.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalPeriodicFullVorticityStretching

open MeasureTheory
open ThreeDimensionalPeriodicCoarseFilterCore
open ThreeDimensionalPeriodicCoarseFilterSpatialCommutation
open ThreeDimensionalPeriodicCoarseCorrelationResidual
open ThreeDimensionalPeriodicCoarseNonlinearDivergence
open ThreeDimensionalPeriodicCoarseVectorCalculus
open ThreeDimensionalPeriodicLocalEnergyAlgebra

noncomputable section

abbrev Velocity := PhysicalSpace

abbrev VelocityField := PhysicalSpace → Velocity

abbrev ScalarField := PhysicalSpace → ℝ

private def coordinateZero : Coordinate := 0

private def coordinateOne : Coordinate := 1

private def coordinateTwo : Coordinate := 2

private def coordinateDirection (i : Coordinate) : PhysicalSpace :=
  EuclideanSpace.single i 1

/-! ## Right-handed curl -/

/--
The right-handed curl readout on one Fréchet derivative.  In coordinates
it is `(D₁u₂ - D₂u₁, D₂u₀ - D₀u₂, D₀u₁ - D₁u₀)`.
-/
noncomputable def vorticityReadoutLinear :
    (PhysicalSpace →L[ℝ] Velocity) →ₗ[ℝ] Velocity where
  toFun D :=
    WithLp.toLp 2 ![
      D (coordinateDirection coordinateOne) coordinateTwo -
        D (coordinateDirection coordinateTwo) coordinateOne,
      D (coordinateDirection coordinateTwo) coordinateZero -
        D (coordinateDirection coordinateZero) coordinateTwo,
      D (coordinateDirection coordinateZero) coordinateOne -
        D (coordinateDirection coordinateOne) coordinateZero]
  map_add' D E := by
    ext i
    fin_cases i <;> simp <;> ring
  map_smul' r D := by
    ext i
    fin_cases i <;> simp [mul_sub]

/-- Continuous-linear form of the right-handed curl readout. -/
noncomputable def vorticityReadout :
    (PhysicalSpace →L[ℝ] Velocity) →L[ℝ] Velocity :=
  vorticityReadoutLinear.toContinuousLinearMap

@[simp] theorem vorticityReadout_apply
    (D : PhysicalSpace →L[ℝ] Velocity) :
    vorticityReadout D =
      WithLp.toLp 2 ![
        D (EuclideanSpace.single (1 : Coordinate) 1) 2 -
          D (EuclideanSpace.single (2 : Coordinate) 1) 1,
        D (EuclideanSpace.single (2 : Coordinate) 1) 0 -
          D (EuclideanSpace.single (0 : Coordinate) 1) 2,
        D (EuclideanSpace.single (0 : Coordinate) 1) 1 -
          D (EuclideanSpace.single (1 : Coordinate) 1) 0] :=
  rfl

/-- The full right-handed vorticity field `curl u`. -/
noncomputable def vorticityField (u : VelocityField) : VelocityField :=
  fun x => vorticityReadout (fderiv ℝ u x)

/-- Public coordinate formula for the full right-handed curl. -/
@[simp] theorem vorticityField_apply
    (u : VelocityField) (x : PhysicalSpace) :
    vorticityField u x =
      WithLp.toLp 2 ![
        fderiv ℝ u x (EuclideanSpace.single (1 : Coordinate) 1) 2 -
          fderiv ℝ u x (EuclideanSpace.single (2 : Coordinate) 1) 1,
        fderiv ℝ u x (EuclideanSpace.single (2 : Coordinate) 1) 0 -
          fderiv ℝ u x (EuclideanSpace.single (0 : Coordinate) 1) 2,
        fderiv ℝ u x (EuclideanSpace.single (0 : Coordinate) 1) 1 -
          fderiv ℝ u x (EuclideanSpace.single (1 : Coordinate) 1) 0] :=
  rfl

/-- Vortex stretching `(curl u · ∇)u`. -/
noncomputable def vortexStretching (u : VelocityField) : VelocityField :=
  fun x => fderiv ℝ u x (vorticityField u x)

/-- Vorticity advection `(u · ∇)(curl u)`. -/
noncomputable def vorticityAdvection (u : VelocityField) : VelocityField :=
  fun x => fderiv ℝ (vorticityField u) x (u x)

/-- Pointwise enstrophy work generated by vortex stretching. -/
noncomputable def enstrophyStretchingWork
    (u : VelocityField) : ScalarField :=
  velocityDot (vorticityField u) (vortexStretching u)

private theorem coordinateStretching_abs_le_squareMass_mul_sqrt_gradient
    (v : Coordinate → ℝ) (D : Coordinate → Coordinate → ℝ) :
    |∑ i : Coordinate, v i * ∑ j : Coordinate, v j * D i j| ≤
      (∑ i : Coordinate, (v i) ^ 2) *
        Real.sqrt (∑ i : Coordinate, ∑ j : Coordinate, (D i j) ^ 2) := by
  let M : ℝ := ∑ i : Coordinate, (v i) ^ 2
  let row : Coordinate → ℝ := fun i => ∑ j : Coordinate, v j * D i j
  let G : ℝ := ∑ i : Coordinate, ∑ j : Coordinate, (D i j) ^ 2
  have hM : 0 ≤ M := by
    dsimp [M]
    positivity
  have hG : 0 ≤ G := by
    dsimp [G]
    positivity
  have hRow (i : Coordinate) :
      (row i) ^ 2 ≤ M * ∑ j : Coordinate, (D i j) ^ 2 := by
    simpa only [row, M] using
      (Finset.sum_mul_sq_le_sq_mul_sq
        (Finset.univ : Finset Coordinate) v (D i))
  have hRows :
      (∑ i : Coordinate, (row i) ^ 2) ≤ M * G := by
    calc
      (∑ i : Coordinate, (row i) ^ 2) ≤
          ∑ i : Coordinate, M * ∑ j : Coordinate, (D i j) ^ 2 :=
        Finset.sum_le_sum fun i _ => hRow i
      _ = M * G := by
        simp only [G, Finset.mul_sum]
  have hOuter :
      (∑ i : Coordinate, v i * row i) ^ 2 ≤
        M * ∑ i : Coordinate, (row i) ^ 2 := by
    simpa only [M] using
      (Finset.sum_mul_sq_le_sq_mul_sq
        (Finset.univ : Finset Coordinate) v row)
  have hSquare :
      (∑ i : Coordinate, v i * row i) ^ 2 ≤ M ^ 2 * G := by
    calc
      (∑ i : Coordinate, v i * row i) ^ 2 ≤
          M * ∑ i : Coordinate, (row i) ^ 2 := hOuter
      _ ≤ M * (M * G) := mul_le_mul_of_nonneg_left hRows hM
      _ = M ^ 2 * G := by ring
  have hRhs : 0 ≤ M * Real.sqrt G :=
    mul_nonneg hM (Real.sqrt_nonneg G)
  rw [← sq_le_sq₀ (abs_nonneg _) hRhs]
  simpa only [sq_abs, mul_pow, Real.sq_sqrt hG] using hSquare

private theorem continuousLinearMap_apply_eq_sum
    (D : PhysicalSpace →L[ℝ] Velocity)
    (v : PhysicalSpace) (i : Coordinate) :
    D v i =
      ∑ j : Coordinate,
        v j * D (coordinateDirection j) i := by
  rw [← (EuclideanSpace.basisFun Coordinate ℝ).sum_repr v,
    map_sum]
  simp only [EuclideanSpace.basisFun_repr,
    EuclideanSpace.basisFun_apply, map_smul,
    WithLp.ofLp_sum, Finset.sum_apply, WithLp.ofLp_smul,
    Pi.smul_apply, smul_eq_mul, PiLp.single_apply,
    mul_ite, mul_one, mul_zero, Fintype.sum_ite_eq]
  rfl

/-- Pointwise vortex-stretching work is paid by the whole vorticity mass
and the Euclidean velocity-gradient density at the same physical state. -/
theorem enstrophyStretchingWork_abs_le_vorticitySq_mul_sqrt_gradientDissipation
    (u : VelocityField) (x : PhysicalSpace) :
    |enstrophyStretchingWork u x| ≤
      velocityDot (vorticityField u) (vorticityField u) x *
        Real.sqrt (gradientDissipation u x) := by
  unfold enstrophyStretchingWork vortexStretching velocityDot
    gradientDissipation
  have hRewrite :
      (∑ i : Coordinate,
          vorticityField u x i *
            fderiv ℝ u x (vorticityField u x) i) =
        ∑ i : Coordinate,
          vorticityField u x i *
            ∑ j : Coordinate,
              vorticityField u x j *
                fderiv ℝ u x (EuclideanSpace.single j 1) i := by
    apply Finset.sum_congr rfl
    intro i _
    rw [continuousLinearMap_apply_eq_sum]
    rfl
  rw [hRewrite]
  simpa only [pow_two] using
    (coordinateStretching_abs_le_squareMass_mul_sqrt_gradient
      (fun i => vorticityField u x i)
      (fun i j =>
        fderiv ℝ u x (EuclideanSpace.single j 1) i))

private theorem continuousLinearMap_comp_apply_eq_sum
    (D : PhysicalSpace →L[ℝ] Velocity)
    (j i : Coordinate) :
    (D.comp D) (coordinateDirection j) i =
      ∑ k : Coordinate,
        D (coordinateDirection j) k *
          D (coordinateDirection k) i := by
  rw [ContinuousLinearMap.comp_apply,
    continuousLinearMap_apply_eq_sum]

private theorem vorticityReadout_comp_self_of_trace_eq_zero
    (D : PhysicalSpace →L[ℝ] Velocity)
    (htrace :
      ∑ j : Coordinate, D (coordinateDirection j) j = 0) :
    vorticityReadout (D.comp D) =
      -D (vorticityReadout D) := by
  ext i
  fin_cases i
  · change
      (D.comp D) (coordinateDirection coordinateOne) coordinateTwo -
          (D.comp D) (coordinateDirection coordinateTwo) coordinateOne =
        -D (vorticityReadout D) coordinateZero
    rw [continuousLinearMap_comp_apply_eq_sum,
      continuousLinearMap_comp_apply_eq_sum,
      continuousLinearMap_apply_eq_sum]
    simp only [vorticityReadout_apply, Fin.sum_univ_three,
      coordinateZero, coordinateOne, coordinateTwo,
      coordinateDirection, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons] at htrace ⊢
    linear_combination
      (D (EuclideanSpace.single 1 1) 2 -
          D (EuclideanSpace.single 2 1) 1) * htrace
  · change
      (D.comp D) (coordinateDirection coordinateTwo) coordinateZero -
          (D.comp D) (coordinateDirection coordinateZero) coordinateTwo =
        -D (vorticityReadout D) coordinateOne
    rw [continuousLinearMap_comp_apply_eq_sum,
      continuousLinearMap_comp_apply_eq_sum,
      continuousLinearMap_apply_eq_sum]
    simp only [vorticityReadout_apply, Fin.sum_univ_three,
      coordinateZero, coordinateOne, coordinateTwo,
      coordinateDirection, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons] at htrace ⊢
    linear_combination
      (D (EuclideanSpace.single 2 1) 0 -
          D (EuclideanSpace.single 0 1) 2) * htrace
  · change
      (D.comp D) (coordinateDirection coordinateZero) coordinateOne -
          (D.comp D) (coordinateDirection coordinateOne) coordinateZero =
        -D (vorticityReadout D) coordinateTwo
    rw [continuousLinearMap_comp_apply_eq_sum,
      continuousLinearMap_comp_apply_eq_sum,
      continuousLinearMap_apply_eq_sum]
    simp only [vorticityReadout_apply, Fin.sum_univ_three,
      coordinateZero, coordinateOne, coordinateTwo,
      coordinateDirection, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons] at htrace ⊢
    linear_combination
      (D (EuclideanSpace.single 0 1) 1 -
          D (EuclideanSpace.single 1 1) 0) * htrace

theorem vorticityField_contDiff
    (u : VelocityField) (hu : ContDiff ℝ 2 u) :
    ContDiff ℝ 1 (vorticityField u) := by
  have hDerivative :
      ContDiff ℝ 1 (fderiv ℝ u) :=
    hu.fderiv_right (m := 1) (by norm_num)
  change ContDiff ℝ 1
    (vorticityReadout ∘ fderiv ℝ u)
  exact vorticityReadout.contDiff.comp hDerivative

theorem fderiv_vorticityField
    (u : VelocityField) (hu : ContDiff ℝ 2 u)
    (x : PhysicalSpace) :
    fderiv ℝ (vorticityField u) x =
      vorticityReadout.comp
        (fderiv ℝ (fderiv ℝ u) x) := by
  have hDerivative :
      ContDiff ℝ 1 (fderiv ℝ u) :=
    hu.fderiv_right (m := 1) (by norm_num)
  change fderiv ℝ
      (vorticityReadout ∘ fderiv ℝ u) x = _
  rw [fderiv_comp x vorticityReadout.differentiableAt
    (hDerivative.differentiable_one x)]
  rw [ContinuousLinearMap.fderiv]

private theorem fderiv_self_advection
    (u : VelocityField) (hu : ContDiff ℝ 2 u)
    (x : PhysicalSpace) :
    fderiv ℝ (fun y => fderiv ℝ u y (u y)) x =
      (fderiv ℝ u x).comp (fderiv ℝ u x) +
        (fderiv ℝ (fderiv ℝ u) x).flip (u x) := by
  have hDerivative :
      ContDiff ℝ 1 (fderiv ℝ u) :=
    hu.fderiv_right (m := 1) (by norm_num)
  exact fderiv_clm_apply
    (hDerivative.differentiable_one x)
    (hu.differentiable (by norm_num) x)

/--
For a divergence-free full three-dimensional field, curl of the advective
derivative is vorticity advection minus vortex stretching.
-/
theorem vorticityField_self_advection_of_divergence_eq_zero
    (u : VelocityField) (hu : ContDiff ℝ 2 u)
    (hdiv : velocityDivergence u = 0) :
    vorticityField (fun x => fderiv ℝ u x (u x)) =
      vorticityAdvection u - vortexStretching u := by
  funext x
  have htrace :
      ∑ j : Coordinate,
        fderiv ℝ u x (coordinateDirection j) j = 0 := by
    have hx := congrFun hdiv x
    change
      (∑ j : Coordinate,
        fderiv ℝ u x (EuclideanSpace.single j 1) j) = 0 at hx
    exact hx
  have hSymmetric :
      IsSymmSndFDerivAt ℝ u x :=
    hu.contDiffAt.isSymmSndFDerivAt (by norm_num)
  have hFlip :
      (fderiv ℝ (fderiv ℝ u) x).flip (u x) =
        fderiv ℝ (fderiv ℝ u) x (u x) := by
    apply ContinuousLinearMap.ext
    intro v
    change
      fderiv ℝ (fderiv ℝ u) x v (u x) =
        fderiv ℝ (fderiv ℝ u) x (u x) v
    exact hSymmetric v (u x)
  calc
    vorticityField (fun y => fderiv ℝ u y (u y)) x =
        vorticityReadout
          ((fderiv ℝ u x).comp (fderiv ℝ u x) +
            (fderiv ℝ (fderiv ℝ u) x).flip (u x)) := by
      rw [vorticityField, fderiv_self_advection u hu x]
    _ =
        vorticityReadout
            ((fderiv ℝ u x).comp (fderiv ℝ u x)) +
          vorticityReadout
            ((fderiv ℝ (fderiv ℝ u) x).flip (u x)) := by
      rw [map_add]
    _ =
        -fderiv ℝ u x (vorticityReadout (fderiv ℝ u x)) +
          vorticityReadout
            (fderiv ℝ (fderiv ℝ u) x (u x)) := by
      rw [vorticityReadout_comp_self_of_trace_eq_zero
        (fderiv ℝ u x) htrace, hFlip]
    _ = vorticityAdvection u x - vortexStretching u x := by
      rw [vorticityAdvection, vortexStretching,
        fderiv_vorticityField u hu x]
      simp only [ContinuousLinearMap.comp_apply, vorticityField]
      abel

theorem vorticityField_add
    (u v : VelocityField)
    (hu : Differentiable ℝ u)
    (hv : Differentiable ℝ v) :
    vorticityField (u + v) =
      vorticityField u + vorticityField v := by
  funext x
  simp only [vorticityField, fderiv_add (hu x) (hv x), map_add,
    Pi.add_apply]

theorem vorticityField_neg (u : VelocityField) :
    vorticityField (-u) = -vorticityField u := by
  funext x
  simp only [vorticityField, fderiv_neg, map_neg, Pi.neg_apply]

/-!
## Full incompressible vorticity identity
-/

/--
The actual quadratic Navier--Stokes nonlinearity has the exact
three-dimensional vorticity decomposition

`curl (-div (u ⊗ u)) = -(u · ∇)curl u + (curl u · ∇)u`.

The sign is forced by the repository's `tensorDivergence` convention and
the right-handed coordinate curl above.
-/
theorem vorticityField_neg_tensorDivergence_velocityTensor_of_divergence_eq_zero
    (u : VelocityField) (hu : ContDiff ℝ 2 u)
    (hdiv : velocityDivergence u = 0) :
    vorticityField (-tensorDivergence (velocityTensor u)) =
      -vorticityAdvection u + vortexStretching u := by
  rw [tensorDivergence_velocityTensor_of_divergence_eq_zero
    u (hu.of_le (by norm_num)) hdiv]
  rw [vorticityField_neg,
    vorticityField_self_advection_of_divergence_eq_zero u hu hdiv]
  abel

/--
Pointwise enstrophy work readout of the full vorticity decomposition.  No
sign is asserted for the stretching work.
-/
theorem velocityDot_vorticityField_neg_tensorDivergence_velocityTensor
    (u : VelocityField) (hu : ContDiff ℝ 2 u)
    (hdiv : velocityDivergence u = 0) :
    velocityDot (vorticityField u)
        (vorticityField (-tensorDivergence (velocityTensor u))) =
      -velocityDot (vorticityField u) (vorticityAdvection u) +
        enstrophyStretchingWork u := by
  rw [vorticityField_neg_tensorDivergence_velocityTensor_of_divergence_eq_zero
    u hu hdiv]
  funext x
  simp only [velocityDot, enstrophyStretchingWork,
    Pi.add_apply, Pi.neg_apply, WithLp.ofLp_add,
    WithLp.ofLp_neg, mul_add, mul_neg,
    Finset.sum_add_distrib, Finset.sum_neg_distrib]

/-- The concrete coarse filter commutes with full three-dimensional curl. -/
theorem vorticityField_coarseFilter
    (s : CoarseScale) (u : VelocityField)
    (hu : ContDiff ℝ 1 u) :
    vorticityField (coarseFilter s u) =
      coarseFilter s (vorticityField u) := by
  funext x
  rw [vorticityField,
    fderiv_coarseFilter_eq_coarseFilter_fderiv s u hu]
  change vorticityReadout
      (coarseFilter s (fderiv ℝ u) x) =
    coarseFilter s
      (fun y => vorticityReadout (fderiv ℝ u y)) x
  exact (coarseFilter_comp_continuousLinearMap
    s vorticityReadout (fderiv ℝ u)
    (hu.continuous_fderiv one_ne_zero).locallyIntegrable x).symm

end

