import H0mework.NavierStokes.Fourier.FilteredNavierStokesGenerator

/-!
# Pointwise energy algebra on periodic three-space

This module begins the local-energy layer on the full lifted periodic
function carrier.  Its first whole-carrier readout is the exact stress
product rule

```text
u · div T = div (Tᵀ u) - T : ∇u.
```

The transpose notation in this display is only explanatory.  The Lean
definitions keep the actual coordinate orientation already used by
`tensorDivergence`: `T i j` is differentiated in the physical `j`
direction.

This module does not generate a time-dependent Navier--Stokes solution,
energy inequality, flux sign, or regularity saving.  It pays the pointwise
product-rule cost needed by the later filtered local-energy ledger.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalPeriodicLocalEnergyAlgebra

open scoped Laplacian

open ThreeDimensionalPeriodicCoarseFilterCore
open ThreeDimensionalPeriodicCoarseCorrelationResidual
open ThreeDimensionalPeriodicCoarseNonlinearDivergence
open ThreeDimensionalPeriodicCoarseVectorCalculus
open ThreeDimensionalPeriodicFilteredNavierStokesGenerator

noncomputable section

abbrev LocalVelocityField := PhysicalSpace → PhysicalSpace

abbrev LocalScalarField := PhysicalSpace → ℝ

/-- Pointwise Euclidean coordinate pairing of two velocity fields. -/
def velocityDot
    (u v : LocalVelocityField) : LocalScalarField :=
  fun x => ∑ i : Coordinate, u x i * v x i

/--
The physical energy flux generated by a stress and a velocity:
its `j` coordinate is `∑ i, uᵢ Tᵢⱼ`.
-/
def stressEnergyFlux
    (T : StressField) (u : LocalVelocityField) :
    LocalVelocityField :=
  fun x =>
    WithLp.toLp 2 (fun j =>
      ∑ i : Coordinate, u x i * T x i j)

/-- The coordinate contraction `T : ∇u`. -/
noncomputable def stressGradientContraction
    (T : StressField) (u : LocalVelocityField) :
    LocalScalarField :=
  fun x =>
    ∑ i : Coordinate, ∑ j : Coordinate,
      T x i j *
        fderiv ℝ u x (EuclideanSpace.single j 1) i

private noncomputable def stressCoordinateReadout
    (i j : Coordinate) : Stress →L[ℝ] ℝ :=
  (ContinuousLinearMap.proj j) ∘L
    (ContinuousLinearMap.proj i)

private lemma fderiv_velocity_coordinate
    (u : LocalVelocityField)
    (hu : Differentiable ℝ u)
    (x : PhysicalSpace) (i : Coordinate) :
    fderiv ℝ (fun y => u y i) x =
      (EuclideanSpace.proj i) ∘L (fderiv ℝ u x) := by
  change
    fderiv ℝ ((EuclideanSpace.proj i) ∘ u) x = _
  rw [fderiv_comp x
    (EuclideanSpace.proj i).differentiableAt
    (hu x)]
  rw [ContinuousLinearMap.fderiv]

private lemma fderiv_velocity_coordinate_apply
    (u : LocalVelocityField)
    (hu : Differentiable ℝ u)
    (x : PhysicalSpace) (i j : Coordinate) :
    fderiv ℝ (fun y => u y i) x
        (EuclideanSpace.single j 1) =
      fderiv ℝ u x (EuclideanSpace.single j 1) i := by
  rw [fderiv_velocity_coordinate u hu x i]
  rfl

private lemma fderiv_stress_coordinate
    (T : StressField)
    (hT : Differentiable ℝ T)
    (x : PhysicalSpace) (i j : Coordinate) :
    fderiv ℝ (fun y => T y i j) x =
      stressCoordinateReadout i j ∘L
        (fderiv ℝ T x) := by
  change
    fderiv ℝ ((stressCoordinateReadout i j) ∘ T) x = _
  rw [fderiv_comp x
    (stressCoordinateReadout i j).differentiableAt
    (hT x)]
  rw [ContinuousLinearMap.fderiv]

private lemma fderiv_stress_coordinate_apply
    (T : StressField)
    (hT : Differentiable ℝ T)
    (x : PhysicalSpace) (i j k : Coordinate) :
    fderiv ℝ (fun y => T y i j) x
        (EuclideanSpace.single k 1) =
      fderiv ℝ T x (EuclideanSpace.single k 1) i j := by
  rw [fderiv_stress_coordinate T hT x i j]
  rfl

private lemma fderiv_scalar_mul_apply
    (a b : LocalScalarField)
    (ha : Differentiable ℝ a)
    (hb : Differentiable ℝ b)
    (x : PhysicalSpace) (j : Coordinate) :
    fderiv ℝ (fun y => a y * b y) x
        (EuclideanSpace.single j 1) =
      a x *
          fderiv ℝ b x (EuclideanSpace.single j 1) +
        b x *
          fderiv ℝ a x (EuclideanSpace.single j 1) := by
  change
    fderiv ℝ (a * b) x (EuclideanSpace.single j 1) = _
  rw [fderiv_mul (ha x) (hb x)]
  simp only [smul_apply, smul_eq_mul, add_apply]

private lemma fderiv_sum_mul_apply
    {ι : Type*} [Fintype ι]
    (a b : ι → LocalScalarField)
    (ha : ∀ i, Differentiable ℝ (a i))
    (hb : ∀ i, Differentiable ℝ (b i))
    (x : PhysicalSpace) (j : Coordinate) :
    fderiv ℝ (fun y => ∑ i, a i y * b i y) x
        (EuclideanSpace.single j 1) =
      ∑ i,
        (a i x *
            fderiv ℝ (b i) x
              (EuclideanSpace.single j 1) +
          b i x *
            fderiv ℝ (a i) x
              (EuclideanSpace.single j 1)) := by
  have hfun :
      (fun y => ∑ i, a i y * b i y) =
        ∑ i, (fun y => a i y * b i y) := by
    funext y
    simp only [Finset.sum_apply]
  rw [hfun, fderiv_sum]
  · change
      ((ContinuousLinearMap.apply ℝ ℝ)
          (EuclideanSpace.single j (1 : ℝ)))
          (∑ i,
            fderiv ℝ (fun y => a i y * b i y) x) = _
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro i _
    exact
      fderiv_scalar_mul_apply
        (a i) (b i) (ha i) (hb i) x j
  · intro i _
    exact ((ha i).mul (hb i)).differentiableAt

/-- Differentiability of the actual stress transport vector. -/
theorem stressEnergyFlux_differentiable
    (T : StressField) (u : LocalVelocityField)
    (hT : Differentiable ℝ T)
    (hu : Differentiable ℝ u) :
    Differentiable ℝ (stressEnergyFlux T u) := by
  rw [differentiable_piLp 2]
  intro j
  change
    Differentiable ℝ
      (fun x =>
        ∑ i : Coordinate, u x i * T x i j)
  have hfun :
      (fun x =>
        ∑ i : Coordinate, u x i * T x i j) =
        ∑ i : Coordinate,
          (fun x => u x i * T x i j) := by
    funext x
    simp only [Finset.sum_apply]
  rw [hfun]
  apply Differentiable.sum
  intro i _
  exact
    ((differentiable_piLp 2).mp hu i).mul
      (differentiable_pi.mp
        (differentiable_pi.mp hT i) j)

private lemma velocityDivergence_stressEnergyFlux_apply
    (T : StressField) (u : LocalVelocityField)
    (hT : Differentiable ℝ T)
    (hu : Differentiable ℝ u)
    (x : PhysicalSpace) :
    velocityDivergence (stressEnergyFlux T u) x =
      ∑ j : Coordinate, ∑ i : Coordinate,
        (u x i *
            fderiv ℝ T x
              (EuclideanSpace.single j 1) i j +
          T x i j *
            fderiv ℝ u x
              (EuclideanSpace.single j 1) i) := by
  have hFlux :=
    stressEnergyFlux_differentiable T u hT hu
  change
    (∑ j : Coordinate,
      fderiv ℝ (stressEnergyFlux T u) x
        (EuclideanSpace.single j 1) j) = _
  apply Finset.sum_congr rfl
  intro j _
  rw [← fderiv_velocity_coordinate_apply
    (stressEnergyFlux T u) hFlux x j j]
  change
    fderiv ℝ
        (fun y =>
          ∑ i : Coordinate, u y i * T y i j)
        x (EuclideanSpace.single j 1) = _
  rw [fderiv_sum_mul_apply
    (fun i y => u y i) (fun i y => T y i j)]
  · apply Finset.sum_congr rfl
    intro i _
    rw [fderiv_stress_coordinate_apply T hT x i j j,
      fderiv_velocity_coordinate_apply u hu x i j]
  · intro i
    exact (differentiable_piLp 2).mp hu i
  · intro i
    exact
      differentiable_pi.mp
        (differentiable_pi.mp hT i) j

/--
The actual pointwise stress product rule on the whole spatial carrier.

This theorem consumes differentiable fields and performs the divergence
readout.  It does not generate either field or assert that the contraction
is nonzero.
-/
theorem velocityDot_tensorDivergence
    (T : StressField) (u : LocalVelocityField)
    (hT : Differentiable ℝ T)
    (hu : Differentiable ℝ u) :
    velocityDot u (tensorDivergence T) =
      velocityDivergence (stressEnergyFlux T u) -
        stressGradientContraction T u := by
  funext x
  simp only [Pi.sub_apply]
  rw [velocityDivergence_stressEnergyFlux_apply
    T u hT hu x]
  simp only [velocityDot, tensorDivergence,
    stressGradientContraction]
  simp_rw [Finset.mul_sum]
  simp_rw [Finset.sum_add_distrib]
  have hDivergence :
      (∑ i : Coordinate, ∑ j : Coordinate,
        u x i *
          fderiv ℝ T x
            (EuclideanSpace.single j 1) i j) =
        ∑ j : Coordinate, ∑ i : Coordinate,
          u x i *
            fderiv ℝ T x
              (EuclideanSpace.single j 1) i j :=
    Finset.sum_comm
  have hContraction :
      (∑ j : Coordinate, ∑ i : Coordinate,
        T x i j *
          fderiv ℝ u x
            (EuclideanSpace.single j 1) i) =
        ∑ i : Coordinate, ∑ j : Coordinate,
          T x i j *
            fderiv ℝ u x
              (EuclideanSpace.single j 1) i :=
    Finset.sum_comm
  rw [hDivergence, hContraction]
  ring

/-! ## Pressure work -/

/-- The pointwise pressure transport `p u`. -/
def pressureEnergyFlux
    (p : LocalScalarField) (u : LocalVelocityField) :
    LocalVelocityField :=
  fun x => p x • u x

/--
Pressure work is a divergence plus the exact compressibility correction.
The divergence-free specialization is a downstream corollary rather than
an input field of the pressure flux.
-/
theorem velocityDot_scalarGradient
    (p : LocalScalarField) (u : LocalVelocityField)
    (hp : Differentiable ℝ p)
    (hu : Differentiable ℝ u) :
    velocityDot u (scalarGradient p) =
      velocityDivergence (pressureEnergyFlux p u) -
        fun x => p x * velocityDivergence u x := by
  have hFlux :
      Differentiable ℝ (pressureEnergyFlux p u) := by
    exact hp.fun_smul hu
  funext x
  simp only [Pi.sub_apply]
  change
    (∑ i : Coordinate,
      u x i *
        fderiv ℝ p x (EuclideanSpace.single i 1)) =
      (∑ j : Coordinate,
        fderiv ℝ (pressureEnergyFlux p u) x
          (EuclideanSpace.single j 1) j) -
      p x *
        ∑ i : Coordinate,
          fderiv ℝ u x
            (EuclideanSpace.single i 1) i
  apply Eq.symm
  calc
    (∑ j : Coordinate,
        fderiv ℝ (pressureEnergyFlux p u) x
          (EuclideanSpace.single j 1) j) -
        p x *
          ∑ i : Coordinate,
            fderiv ℝ u x
              (EuclideanSpace.single i 1) i =
      (∑ j : Coordinate,
        fderiv ℝ (fun y => p y * u y j) x
          (EuclideanSpace.single j 1)) -
        p x *
          ∑ i : Coordinate,
            fderiv ℝ u x
              (EuclideanSpace.single i 1) i := by
        apply congrArg
          (fun z =>
            z -
              p x *
                ∑ i : Coordinate,
                  fderiv ℝ u x
                    (EuclideanSpace.single i 1) i)
        apply Finset.sum_congr rfl
        intro j _
        rw [← fderiv_velocity_coordinate_apply
          (pressureEnergyFlux p u) hFlux x j j]
        rfl
    _ =
      (∑ j : Coordinate,
        (p x *
            fderiv ℝ u x
              (EuclideanSpace.single j 1) j +
          u x j *
            fderiv ℝ p x
              (EuclideanSpace.single j 1))) -
        p x *
          ∑ i : Coordinate,
            fderiv ℝ u x
              (EuclideanSpace.single i 1) i := by
        apply congrArg
          (fun z =>
            z -
              p x *
                ∑ i : Coordinate,
                  fderiv ℝ u x
                    (EuclideanSpace.single i 1) i)
        apply Finset.sum_congr rfl
        intro j _
        rw [fderiv_scalar_mul_apply
          p (fun y => u y j) hp
          ((differentiable_piLp 2).mp hu j) x j]
        rw [fderiv_velocity_coordinate_apply u hu x j j]
    _ =
      ∑ i : Coordinate,
        u x i *
          fderiv ℝ p x
            (EuclideanSpace.single i 1) := by
        rw [Finset.sum_add_distrib, ← Finset.mul_sum]
        ring

/-! ## Resolved kinetic transport -/

/-- Pointwise kinetic-energy density `|u|² / 2`. -/
def kineticEnergyDensity
    (u : LocalVelocityField) : LocalScalarField :=
  fun x =>
    (2 : ℝ)⁻¹ *
      ∑ i : Coordinate, u x i * u x i

/-- The resolved kinetic-energy transport `( |u|² / 2 ) u`. -/
def kineticEnergyFlux
    (u : LocalVelocityField) : LocalVelocityField :=
  fun x => kineticEnergyDensity u x • u x

private lemma velocitySquared_differentiable
    (u : LocalVelocityField)
    (hu : Differentiable ℝ u) :
    Differentiable ℝ
      (fun x =>
        ∑ i : Coordinate, u x i * u x i) := by
  have hfun :
      (fun x =>
        ∑ i : Coordinate, u x i * u x i) =
        ∑ i : Coordinate,
          (fun x => u x i * u x i) := by
    funext x
    simp only [Finset.sum_apply]
  rw [hfun]
  apply Differentiable.sum
  intro i _
  exact
    ((differentiable_piLp 2).mp hu i).mul
      ((differentiable_piLp 2).mp hu i)

private lemma kineticEnergyDensity_differentiable
    (u : LocalVelocityField)
    (hu : Differentiable ℝ u) :
    Differentiable ℝ (kineticEnergyDensity u) := by
  exact
    (velocitySquared_differentiable u hu).const_mul
      (2 : ℝ)⁻¹

private lemma fderiv_kineticEnergyDensity_apply
    (u : LocalVelocityField)
    (hu : Differentiable ℝ u)
    (x : PhysicalSpace) (j : Coordinate) :
    fderiv ℝ (kineticEnergyDensity u) x
        (EuclideanSpace.single j 1) =
      ∑ i : Coordinate,
        u x i *
          fderiv ℝ u x
            (EuclideanSpace.single j 1) i := by
  change
    fderiv ℝ
        (fun y =>
          (2 : ℝ)⁻¹ *
            ∑ i : Coordinate, u y i * u y i)
        x (EuclideanSpace.single j 1) = _
  rw [fderiv_const_mul
    (velocitySquared_differentiable u hu x)
    (2 : ℝ)⁻¹]
  simp only [smul_apply, smul_eq_mul]
  rw [fderiv_sum_mul_apply
    (fun i y => u y i) (fun i y => u y i)]
  · simp_rw [fderiv_velocity_coordinate_apply u hu x]
    ring_nf
    rw [← Finset.sum_mul]
    ring
  · intro i
    exact (differentiable_piLp 2).mp hu i
  · intro i
    exact (differentiable_piLp 2).mp hu i

/-- Differentiability of resolved kinetic-energy transport. -/
theorem kineticEnergyFlux_differentiable
    (u : LocalVelocityField)
    (hu : Differentiable ℝ u) :
    Differentiable ℝ (kineticEnergyFlux u) := by
  exact
    (kineticEnergyDensity_differentiable u hu).fun_smul hu

private lemma velocityDivergence_kineticEnergyFlux_apply
    (u : LocalVelocityField)
    (hu : Differentiable ℝ u)
    (x : PhysicalSpace) :
    velocityDivergence (kineticEnergyFlux u) x =
      kineticEnergyDensity u x *
          velocityDivergence u x +
        ∑ j : Coordinate, ∑ i : Coordinate,
          u x j * u x i *
            fderiv ℝ u x
              (EuclideanSpace.single j 1) i := by
  have hFlux :=
    kineticEnergyFlux_differentiable u hu
  change
    (∑ j : Coordinate,
      fderiv ℝ (kineticEnergyFlux u) x
        (EuclideanSpace.single j 1) j) = _
  calc
    (∑ j : Coordinate,
        fderiv ℝ (kineticEnergyFlux u) x
          (EuclideanSpace.single j 1) j) =
      ∑ j : Coordinate,
        fderiv ℝ
            (fun y =>
              kineticEnergyDensity u y * u y j)
            x (EuclideanSpace.single j 1) := by
        apply Finset.sum_congr rfl
        intro j _
        rw [← fderiv_velocity_coordinate_apply
          (kineticEnergyFlux u) hFlux x j j]
        rfl
    _ =
      ∑ j : Coordinate,
        (kineticEnergyDensity u x *
            fderiv ℝ u x
              (EuclideanSpace.single j 1) j +
          u x j *
            fderiv ℝ (kineticEnergyDensity u) x
              (EuclideanSpace.single j 1)) := by
        apply Finset.sum_congr rfl
        intro j _
        rw [fderiv_scalar_mul_apply
          (kineticEnergyDensity u) (fun y => u y j)
          (kineticEnergyDensity_differentiable u hu)
          ((differentiable_piLp 2).mp hu j) x j]
        rw [fderiv_velocity_coordinate_apply u hu x j j]
    _ =
      kineticEnergyDensity u x *
          velocityDivergence u x +
        ∑ j : Coordinate, ∑ i : Coordinate,
          u x j * u x i *
            fderiv ℝ u x
              (EuclideanSpace.single j 1) i := by
        simp_rw [fderiv_kineticEnergyDensity_apply u hu x]
        change
          (∑ j : Coordinate,
            (kineticEnergyDensity u x *
                fderiv ℝ u x
                  (EuclideanSpace.single j 1) j +
              u x j *
                ∑ i : Coordinate,
                  u x i *
                    fderiv ℝ u x
                      (EuclideanSpace.single j 1) i)) =
            kineticEnergyDensity u x *
                (∑ i : Coordinate,
                  fderiv ℝ u x
                    (EuclideanSpace.single i 1) i) +
              ∑ j : Coordinate, ∑ i : Coordinate,
                u x j * u x i *
                  fderiv ℝ u x
                    (EuclideanSpace.single j 1) i
        simp_rw [Finset.mul_sum]
        rw [Finset.sum_add_distrib]
        ring_nf

/--
The resolved convective work is the divergence of kinetic transport plus
the exact compressibility correction.  Incompressibility is intentionally
not required here.
-/
theorem velocityDot_tensorDivergence_velocityTensor
    (u : LocalVelocityField)
    (hu : ContDiff ℝ 1 u) :
    velocityDot u (tensorDivergence (velocityTensor u)) =
      velocityDivergence (kineticEnergyFlux u) +
        fun x =>
          kineticEnergyDensity u x *
            velocityDivergence u x := by
  have huDiff : Differentiable ℝ u :=
    hu.differentiable (by norm_num)
  have hTensorDiff :
      Differentiable ℝ (velocityTensor u) :=
    (velocityTensor_contDiff u hu).differentiable
      (by norm_num)
  funext x
  simp only [Pi.add_apply]
  rw [velocityDivergence_kineticEnergyFlux_apply
    u huDiff x]
  change
    (∑ i : Coordinate,
      u x i *
        ∑ j : Coordinate,
          fderiv ℝ (velocityTensor u) x
            (EuclideanSpace.single j 1) i j) =
      (kineticEnergyDensity u x *
          ∑ j : Coordinate,
            fderiv ℝ u x
              (EuclideanSpace.single j 1) j +
        ∑ j : Coordinate, ∑ i : Coordinate,
          u x j * u x i *
            fderiv ℝ u x
              (EuclideanSpace.single j 1) i) +
      kineticEnergyDensity u x *
        ∑ j : Coordinate,
          fderiv ℝ u x
            (EuclideanSpace.single j 1) j
  simp_rw [← fderiv_stress_coordinate_apply
    (velocityTensor u) hTensorDiff x]
  change
    (∑ i : Coordinate,
      u x i *
        ∑ j : Coordinate,
          fderiv ℝ
              (fun y => u y i * u y j)
              x (EuclideanSpace.single j 1)) = _
  have hDerivative :
      (∑ i : Coordinate,
        u x i *
          ∑ j : Coordinate,
            fderiv ℝ
                (fun y => u y i * u y j)
                x (EuclideanSpace.single j 1)) =
        ∑ i : Coordinate,
          u x i *
            ∑ j : Coordinate,
              (u x i *
                  fderiv ℝ u x
                    (EuclideanSpace.single j 1) j +
                u x j *
                  fderiv ℝ u x
                    (EuclideanSpace.single j 1) i) := by
    apply Finset.sum_congr rfl
    intro i _
    apply congrArg (fun z => u x i * z)
    apply Finset.sum_congr rfl
    intro j _
    rw [fderiv_scalar_mul_apply
      (fun y => u y i) (fun y => u y j)
      ((differentiable_piLp 2).mp huDiff i)
      ((differentiable_piLp 2).mp huDiff j) x j]
    rw [fderiv_velocity_coordinate_apply u huDiff x j j,
      fderiv_velocity_coordinate_apply u huDiff x i j]
  rw [hDerivative]
  simp_rw [Finset.mul_sum]
  simp_rw [mul_add, Finset.sum_add_distrib]
  have hSquare :
      (∑ i : Coordinate, ∑ j : Coordinate,
        u x i *
          (u x i *
            fderiv ℝ u x
              (EuclideanSpace.single j 1) j)) =
        (∑ i : Coordinate, u x i * u x i) *
          ∑ j : Coordinate,
            fderiv ℝ u x
              (EuclideanSpace.single j 1) j := by
    rw [Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro i _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    ring
  have hAdvection :
      (∑ i : Coordinate, ∑ j : Coordinate,
        u x i *
          (u x j *
            fderiv ℝ u x
              (EuclideanSpace.single j 1) i)) =
        ∑ j : Coordinate, ∑ i : Coordinate,
          u x j * u x i *
            fderiv ℝ u x
              (EuclideanSpace.single j 1) i := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro j _
    apply Finset.sum_congr rfl
    intro i _
    ring
  rw [hSquare, hAdvection]
  simp only [kineticEnergyDensity]
  simp_rw [← Finset.mul_sum]
  ring_nf

/-! ## Viscous work -/

/-- The physical velocity gradient with coordinates `∂ⱼ uᵢ`. -/
noncomputable def velocityGradient
    (u : LocalVelocityField) : StressField :=
  fun x i j =>
    fderiv ℝ u x (EuclideanSpace.single j 1) i

/-- The explicit coordinate square `∑ᵢⱼ (∂ⱼ uᵢ)²`. -/
noncomputable def gradientDissipation
    (u : LocalVelocityField) : LocalScalarField :=
  fun x =>
    ∑ i : Coordinate, ∑ j : Coordinate,
      (fderiv ℝ u x
        (EuclideanSpace.single j 1) i) ^ 2

/-- The viscous transport vector `(∇u)ᵀu`. -/
noncomputable def viscousEnergyFlux
    (u : LocalVelocityField) : LocalVelocityField :=
  stressEnergyFlux (velocityGradient u) u

private noncomputable def
    velocityDerivativeCoordinateReadout
    (i j : Coordinate) :
    (PhysicalSpace →L[ℝ] PhysicalSpace) →L[ℝ] ℝ :=
  (EuclideanSpace.proj i) ∘L
    ((ContinuousLinearMap.apply ℝ PhysicalSpace)
      (EuclideanSpace.single j 1))

/-- A `C²` velocity has a differentiable physical gradient tensor. -/
theorem velocityGradient_differentiable
    (u : LocalVelocityField)
    (hu : ContDiff ℝ 2 u) :
    Differentiable ℝ (velocityGradient u) := by
  have hDu :
      Differentiable ℝ (fderiv ℝ u) :=
    (hu.fderiv_right (m := 1) (by norm_num)).differentiable
      (by norm_num)
  rw [differentiable_pi]
  intro i
  rw [differentiable_pi]
  intro j
  change
    Differentiable ℝ
      (velocityDerivativeCoordinateReadout i j ∘
        fderiv ℝ u)
  exact
    (velocityDerivativeCoordinateReadout i j).differentiable.comp
      hDu

private lemma fderiv_velocityGradient_coordinate_apply
    (u : LocalVelocityField)
    (hu : ContDiff ℝ 2 u)
    (x : PhysicalSpace) (i j k : Coordinate) :
    fderiv ℝ
        (fun y => velocityGradient u y i j) x
        (EuclideanSpace.single k 1) =
      fderiv ℝ (fderiv ℝ u) x
          (EuclideanSpace.single k 1)
          (EuclideanSpace.single j 1) i := by
  have hDu :
      Differentiable ℝ (fderiv ℝ u) :=
    (hu.fderiv_right (m := 1) (by norm_num)).differentiable
      (by norm_num)
  change
    fderiv ℝ
        (velocityDerivativeCoordinateReadout i j ∘
          fderiv ℝ u) x
        (EuclideanSpace.single k 1) = _
  rw [fderiv_comp x
    (velocityDerivativeCoordinateReadout i j).differentiableAt
    (hDu x)]
  rw [ContinuousLinearMap.fderiv]
  rfl

/--
The divergence of the generated velocity gradient is the canonical vector
Laplacian.  This identifies the index convention used by the energy flux
with the already verified Mathlib `Δ` readout.
-/
theorem tensorDivergence_velocityGradient
    (u : LocalVelocityField)
    (hu : ContDiff ℝ 2 u) :
    tensorDivergence (velocityGradient u) = Δ u := by
  rw [← coordinateVectorLaplacian_eq_mathlib]
  funext x
  ext i
  change
    (∑ j : Coordinate,
      fderiv ℝ (velocityGradient u) x
        (EuclideanSpace.single j 1) i j) =
      ∑ j : Coordinate,
        fderiv ℝ (fderiv ℝ u) x
          (EuclideanSpace.single j 1)
          (EuclideanSpace.single j 1) i
  apply Finset.sum_congr rfl
  intro j _
  rw [← fderiv_stress_coordinate_apply
    (velocityGradient u)
    (velocityGradient_differentiable u hu) x i j j]
  exact fderiv_velocityGradient_coordinate_apply
    u hu x i j j

theorem stressGradientContraction_velocityGradient
    (u : LocalVelocityField) :
    stressGradientContraction (velocityGradient u) u =
      gradientDissipation u := by
  funext x
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  simp only [velocityGradient]
  ring

/--
The viscous pointwise energy identity on the whole carrier:
`u · Δu = div ((∇u)ᵀu) - |∇u|²`.
-/
theorem velocityDot_vectorLaplacian
    (u : LocalVelocityField)
    (hu : ContDiff ℝ 2 u) :
    velocityDot u (Δ u) =
      velocityDivergence (viscousEnergyFlux u) -
        gradientDissipation u := by
  rw [← tensorDivergence_velocityGradient u hu]
  simpa only [viscousEnergyFlux,
    stressGradientContraction_velocityGradient] using
    velocityDot_tensorDivergence
      (velocityGradient u) u
      (velocityGradient_differentiable u hu)
      (hu.differentiable (by norm_num))

end

end ThreeDimensionalPeriodicLocalEnergyAlgebra
end NavierStokes
