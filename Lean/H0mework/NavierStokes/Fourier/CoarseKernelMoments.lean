import H0mework.NavierStokes.Fourier.DecayingShearFlow

/-!
# Exact moments of the source-owned periodic coarse kernel

This module isolates two analytic facts generated by the actual normalized
compact bump.  They belong before any stress-work or cascade observer:

* the kernel is even;
* at the origin it annihilates the canonical odd sine while seeing its
  square strictly positively.

The strict inequality is proved from a concrete point inside the generated
open support.  No Fourier multiplier, nonvanishing certificate, or
faithfulness premise is used.
-/

open MeasureTheory

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalPeriodicCoarseKernelMoments

open ThreeDimensionalPeriodicCoarseFilterCore
open ThreeDimensionalPeriodicDecayingShearFlow

noncomputable section

/-- A generated point inside both the bump support and one sine half-period. -/
noncomputable def momentWitnessCoordinate
    (s : CoarseScale) : ℝ :=
  min (s.radius / 2) (1 / 8 : ℝ)

noncomputable def momentWitnessPoint
    (s : CoarseScale) : PhysicalSpace :=
  EuclideanSpace.single (1 : Coordinate)
    (momentWitnessCoordinate s)

theorem momentWitnessCoordinate_pos
    (s : CoarseScale) :
    0 < momentWitnessCoordinate s := by
  unfold momentWitnessCoordinate
  exact lt_min
    (div_pos s.radius_pos (by norm_num))
    (by norm_num)

theorem momentWitnessCoordinate_lt_radius
    (s : CoarseScale) :
    momentWitnessCoordinate s < s.radius := by
  calc
    momentWitnessCoordinate s ≤ s.radius / 2 :=
      min_le_left _ _
    _ < s.radius := by
      linarith [s.radius_pos]

theorem momentWitnessCoordinate_le_eighth
    (s : CoarseScale) :
    momentWitnessCoordinate s ≤ 1 / 8 :=
  min_le_right _ _

theorem momentWitnessPoint_mem_support
    (s : CoarseScale) :
    momentWitnessPoint s ∈
      Function.support (coarseKernel s) := by
  rw [show
      Function.support (coarseKernel s) =
        Metric.ball (0 : PhysicalSpace) s.radius by
    exact (coarseBump s).support_normed_eq]
  rw [Metric.mem_ball, dist_zero_right]
  simp only [momentWitnessPoint,
    PiLp.norm_single, Real.norm_eq_abs,
    abs_of_pos (momentWitnessCoordinate_pos s)]
  exact momentWitnessCoordinate_lt_radius s

theorem waveMode_momentWitnessPoint_pos
    (s : CoarseScale) :
    0 < waveMode (momentWitnessPoint s) := by
  have haPos :=
    momentWitnessCoordinate_pos s
  have haSmall :
      2 * momentWitnessCoordinate s < 1 := by
    linarith [momentWitnessCoordinate_le_eighth s]
  unfold waveMode wavePhase waveNumber momentWitnessPoint
  change
    0 < Real.sin
      ((2 * Real.pi) * momentWitnessCoordinate s)
  apply Real.sin_pos_of_pos_of_lt_pi
  · positivity
  · calc
      (2 * Real.pi) * momentWitnessCoordinate s =
          Real.pi * (2 * momentWitnessCoordinate s) := by
        ring
      _ < Real.pi * 1 :=
        mul_lt_mul_of_pos_left haSmall Real.pi_pos
      _ = Real.pi := by ring

theorem waveMode_neg
    (x : PhysicalSpace) :
    waveMode (-x) = -waveMode x := by
  unfold waveMode
  rw [map_neg, Real.sin_neg]

theorem coarseKernel_neg
    (s : CoarseScale) (x : PhysicalSpace) :
    coarseKernel s (-x) = coarseKernel s x := by
  exact (coarseBump s).normed_neg x

theorem waveMode_continuous :
    Continuous waveMode := by
  unfold waveMode
  exact Real.continuous_sin.comp wavePhase.continuous

/--
The source-owned positive bump sees a genuinely nonzero piece of the
canonical squared mode at every generated positive scale.
-/
theorem coarseFilter_waveMode_sq_zero_pos
    (s : CoarseScale) :
    0 < coarseFilter s (fun x => waveMode x ^ 2)
      (0 : PhysicalSpace) := by
  let integrand : PhysicalSpace → ℝ :=
    fun x => coarseKernel s x * waveMode (-x) ^ 2
  have hContinuous : Continuous integrand := by
    exact
      (coarseKernel_contDiff s).continuous.mul
        ((waveMode_continuous.comp continuous_neg).pow 2)
  have hCompact : HasCompactSupport integrand := by
    exact (coarseKernel_hasCompactSupport s).mul_right
  have hNonneg : 0 ≤ integrand := by
    intro x
    exact mul_nonneg (coarseKernel_nonneg s x)
      (sq_nonneg (waveMode (-x)))
  have hKernel :
      coarseKernel s (momentWitnessPoint s) ≠ 0 :=
    momentWitnessPoint_mem_support s
  have hMode :
      waveMode (-(momentWitnessPoint s)) ≠ 0 := by
    rw [waveMode_neg]
    exact neg_ne_zero.mpr
      (ne_of_gt (waveMode_momentWitnessPoint_pos s))
  have hWitness :
      integrand (momentWitnessPoint s) ≠ 0 := by
    exact mul_ne_zero hKernel (pow_ne_zero 2 hMode)
  have hPositive :
      0 < ∫ x : PhysicalSpace, integrand x :=
    hContinuous.integral_pos_of_hasCompactSupport_nonneg_nonzero
      hCompact hNonneg hWitness
  simpa only [coarseFilter, convolution_def,
    ContinuousLinearMap.lsmul_apply, smul_eq_mul,
    zero_sub, integrand] using hPositive

/--
The even source kernel annihilates the canonical odd mode at the origin.
This is an exact property of the actual convolution, not a Fourier-multiplier
assumption.
-/
theorem coarseFilter_waveMode_zero_eq_zero
    (s : CoarseScale) :
    coarseFilter s waveMode (0 : PhysicalSpace) = 0 := by
  let integrand : PhysicalSpace → ℝ :=
    fun x => coarseKernel s x * waveMode (-x)
  have hOdd :
      (fun x => integrand (-x)) = -integrand := by
    funext x
    unfold integrand
    rw [neg_neg, coarseKernel_neg]
    simp only [Pi.neg_apply, waveMode_neg]
    ring
  have hInvariant :=
    integral_neg_eq_self integrand volume
  rw [hOdd] at hInvariant
  change
    (∫ x : PhysicalSpace, -integrand x) =
      ∫ x : PhysicalSpace, integrand x at hInvariant
  have hAntisymmetric :
      -(∫ x : PhysicalSpace, integrand x) =
        ∫ x : PhysicalSpace, integrand x := by
    simpa only [integral_neg] using hInvariant
  have hIntegral :
      ∫ x : PhysicalSpace, integrand x = 0 := by
    linarith [hAntisymmetric]
  simpa only [coarseFilter, convolution_def,
    ContinuousLinearMap.lsmul_apply, smul_eq_mul,
    zero_sub, integrand] using hIntegral

end

end ThreeDimensionalPeriodicCoarseKernelMoments
end NavierStokes
end SaturationMonoid
