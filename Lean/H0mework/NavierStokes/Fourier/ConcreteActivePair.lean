import H0mework.NavierStokes.Fourier.StretchingPairTable

/-!
# A concrete source-generated active three-dimensional stretching pair

This module supplies one premise-free calibration of the raw three-dimensional
Fourier source.  The source contains the non-collinear waves
`p = (1, 0, 0)` and `q = (0, 1, 0)`, with raw vorticities directed along the
second and third coordinate axes.  Reality symmetrization, transverse
projection, Biot--Savart inversion, and the ordered-pair stretching table are
all consumed exactly as generated by the source modules.

The ordered occurrence `(p, q)` has output `(1, 1, 0)`, contribution
`(-1/4, 0, 0)`, and hence positive squared-norm quantum `1/16`.  Nonvanishing,
an output frequency, and an active occurrence are conclusions rather than
fields or premises.  This fixed calibration does not claim survival under a
unit-cell enstrophy observer or a closed-triad pairing.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalVorticityCoefficientConcreteActivePair

open Matrix
open ThreeDimensionalPeriodicCoarseFilterCore
open ThreeDimensionalPeriodicIntegerCharacterCoarseFilter
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientStretchingPairTable

noncomputable section

/-! ## Concrete raw source -/

/-- The advecting-vorticity wave `p = (1, 0, 0)`. -/
def concreteAdvectingWave : IntegerWavevector :=
  ![1, 0, 0]

/-- The transported-velocity wave `q = (0, 1, 0)`. -/
def concreteTransportedWave : IntegerWavevector :=
  ![0, 1, 0]

/-- Raw vorticity at `p`, directed along `q`. -/
def concreteAdvectingRawVorticity : ComplexCoordinateVector :=
  ![0, 1, 0]

/-- Raw vorticity at `q`, directed along the third coordinate axis. -/
def concreteTransportedRawVorticity : ComplexCoordinateVector :=
  ![0, 0, 1]

/-- The unconstrained raw coefficient table used by the calibration source. -/
def concreteRawVorticity
    (wave : IntegerWavevector) : ComplexCoordinateVector :=
  if wave = concreteAdvectingWave then
    concreteAdvectingRawVorticity
  else if wave = concreteTransportedWave then
    concreteTransportedRawVorticity
  else 0

/--
The concrete source mouth contains only its finite raw inventory and raw
coefficient table.  All physical admission laws remain source-generated.
-/
def concreteActivePairSource : RawVorticityFourierSource where
  activeModes := {concreteAdvectingWave, concreteTransportedWave}
  rawVorticity := concreteRawVorticity

/-- The exact ordered pair whose stretching contribution is generated below. -/
def concreteStretchingPair : StretchingPair :=
  (concreteAdvectingWave, concreteTransportedWave)

/-- Exact pair output retained independently of any scalar observer. -/
def concreteStretchingOutput : IntegerWavevector :=
  ![1, 1, 0]

@[simp] theorem concreteAdvectingWave_ne_zero :
    concreteAdvectingWave ≠ 0 := by
  intro equality
  have := congrFun equality 0
  norm_num [concreteAdvectingWave] at this

@[simp] theorem concreteTransportedWave_ne_zero :
    concreteTransportedWave ≠ 0 := by
  intro equality
  have := congrFun equality 1
  norm_num [concreteTransportedWave] at this

theorem concrete_waves_not_complex_collinear :
    ¬ ∃ scale : ℂ,
      complexWavevector concreteTransportedWave =
        scale • complexWavevector concreteAdvectingWave := by
  rintro ⟨scale, equality⟩
  have := congrFun equality 1
  norm_num [complexWavevector, concreteAdvectingWave,
    concreteTransportedWave] at this

@[simp] theorem concreteAdvectingWave_mem_generatedSupport :
    concreteAdvectingWave ∈ generatedSupport concreteActivePairSource := by
  simp [generatedSupport, concreteActivePairSource,
    concreteAdvectingWave, concreteTransportedWave]

@[simp] theorem concreteTransportedWave_mem_generatedSupport :
    concreteTransportedWave ∈ generatedSupport concreteActivePairSource := by
  simp [generatedSupport, concreteActivePairSource,
    concreteAdvectingWave, concreteTransportedWave]

/-! ## Exact generated coefficients -/

theorem concrete_generatedVorticity_advecting :
    generatedVorticityCoefficient concreteActivePairSource
        concreteAdvectingWave =
      ![0, (1 / 2 : ℂ), 0] := by
  rw [generatedVorticityCoefficient,
    if_pos concreteAdvectingWave_mem_generatedSupport]
  funext coordinate
  fin_cases coordinate <;>
    simp [transverseProjection,
      realitySymmetrizedVorticity, supportedRawVorticity,
      concreteActivePairSource, concreteRawVorticity,
      concreteAdvectingRawVorticity,
      concreteAdvectingWave, concreteTransportedWave,
      waveNeg, complexWavevector,
      integerWaveNormSq, dotProduct, Fin.sum_univ_succ]

theorem concrete_generatedVorticity_transported :
    generatedVorticityCoefficient concreteActivePairSource
        concreteTransportedWave =
      ![0, 0, (1 / 2 : ℂ)] := by
  rw [generatedVorticityCoefficient,
    if_pos concreteTransportedWave_mem_generatedSupport]
  funext coordinate
  fin_cases coordinate <;>
    simp [transverseProjection,
      realitySymmetrizedVorticity, supportedRawVorticity,
      concreteActivePairSource, concreteRawVorticity,
      concreteTransportedRawVorticity,
      concreteAdvectingWave, concreteTransportedWave,
      waveNeg, complexWavevector,
      integerWaveNormSq, dotProduct, Fin.sum_univ_succ]

theorem concrete_generatedVelocity_transported :
    generatedVelocityCoefficient concreteActivePairSource
        concreteTransportedWave =
      ![(Complex.I / (((4 : ℝ) * Real.pi : ℝ) : ℂ)), 0, 0] := by
  rw [generatedVelocityCoefficient,
    concrete_generatedVorticity_transported]
  funext coordinate
  fin_cases coordinate
  all_goals
    simp [biotSavartVelocityCoefficient,
      concreteTransportedWave, complexWavevector,
      integerWaveNormSq, cross_apply, Fin.sum_univ_succ]
  all_goals ring_nf

/-! ## Source-generated active occurrence and quantum -/

@[simp] theorem concreteStretchingPair_mem_generatedTable :
    concreteStretchingPair ∈
        generatedStretchingPairTable concreteActivePairSource := by
  simp [concreteStretchingPair]

@[simp] theorem concreteStretchingPair_output :
    stretchingPairOutput concreteStretchingPair =
      concreteStretchingOutput := by
  funext coordinate
  fin_cases coordinate <;>
    norm_num [stretchingPairOutput, concreteStretchingPair,
      concreteStretchingOutput, concreteAdvectingWave,
      concreteTransportedWave]

theorem concreteStretchingPair_contribution :
    generatedStretchingPairContribution concreteActivePairSource
        concreteStretchingPair =
      ![(-1 / 4 : ℂ), 0, 0] := by
  simp only [concreteStretchingPair]
  rw [generatedStretchingPairContribution,
    concrete_generatedVorticity_advecting,
    concrete_generatedVelocity_transported]
  funext coordinate
  fin_cases coordinate
  all_goals
    simp [concreteTransportedWave, complexWavevector, dotProduct,
      Fin.sum_univ_succ]
  all_goals field_simp [Real.pi_ne_zero]
  all_goals ring_nf
  all_goals simp [Complex.I_sq]

theorem concreteStretchingPair_contribution_ne_zero :
    generatedStretchingPairContribution concreteActivePairSource
        concreteStretchingPair ≠ 0 := by
  rw [concreteStretchingPair_contribution]
  intro equality
  have := congrFun equality 0
  norm_num at this

@[simp] theorem concreteStretchingPair_mem_active :
    concreteStretchingPair ∈
        activeStretchingPairs concreteActivePairSource := by
  rw [mem_activeStretchingPairs_iff]
  exact ⟨concreteStretchingPair_mem_generatedTable,
    concreteStretchingPair_contribution_ne_zero⟩

/--
The source itself generates the active occurrence; callers supply no selected
pair, output, nonvanishing fact, or target.
-/
def concreteActiveStretchingPairOccurrence :
    ActiveStretchingPairOccurrence concreteActivePairSource :=
  ⟨concreteStretchingPair, concreteStretchingPair_mem_active⟩

@[simp] theorem concreteActiveStretchingPairOccurrence_pair :
    concreteActiveStretchingPairOccurrence.1 = concreteStretchingPair :=
  rfl

@[simp] theorem concreteActiveStretchingPairOccurrence_output :
    stretchingPairOutput concreteActiveStretchingPairOccurrence.1 =
      concreteStretchingOutput :=
  concreteStretchingPair_output

theorem concreteActiveStretchingPairOccurrence_quantum :
    activeStretchingPairQuantum concreteActivePairSource
        concreteActiveStretchingPairOccurrence = 1 / 16 := by
  rw [activeStretchingPairQuantum,
    concreteActiveStretchingPairOccurrence_pair,
    concreteStretchingPair_contribution]
  norm_num [complexCoordinateVectorNormSq, Complex.normSq,
    Fin.sum_univ_succ]

theorem concreteActiveStretchingPairOccurrence_quantum_pos :
    0 < activeStretchingPairQuantum concreteActivePairSource
      concreteActiveStretchingPairOccurrence :=
  activeStretchingPairQuantum_pos _ _

end

end ThreeDimensionalVorticityCoefficientConcreteActivePair
end NavierStokes
end SaturationMonoid
