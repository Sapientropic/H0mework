import H0mework.NavierStokes.InitialData.PhysicalCompiler
import H0mework.Realization.Residual.Process

/-!
# Source-owned coarse-filter process for three-dimensional Fourier vorticity

For a fixed physical `CoarseScale`, the actual normalized bump convolution
generates a real multiplier on every integer character.  This module writes
that multiplier back to the unconstrained raw vorticity table while preserving
the source's finite mode inventory.

Evenness of the multiplier is proved from the same integer characters.  It
then forces reality symmetrization, transverse projection, and Biot--Savart
inversion to commute with the source update.  Consequently the generated
vorticity-coefficient table is an `EffectiveResidualProcess` on the complete
coefficient carrier, with its trace uniquely fixed by residual conservation.

Finally, the generic full-signed physical compiler is proved to commute with
this coefficient keep on an arbitrary finite mode inventory.  Specializing
that whole-carrier square gives

```text
physicalVelocity (sourceUpdate s source)
  = coarseFilter s (physicalVelocity source).
```

No reality, injectivity, multiplier nonvanishing, selected mode, or observer
target is accepted as a premise.  Pair and closed-triad commutators are outside
this module.
-/

open MeasureTheory

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalVorticityCoefficientCoarseFilterProcess

open scoped BigOperators Matrix

open Matrix
open AffineRelaxation
open ResidualProjection
open ThreeDimensionalPeriodicCoarseFilterCore
open ThreeDimensionalPeriodicIntegerCharacterCoarseFilter
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientPhysicalCompiler

noncomputable section

/-! ## Even source-owned character multiplier -/

/-- Integer-frequency negation preserves the real cosine character. -/
theorem integerCosine_waveNeg
    (wave : IntegerWavevector) :
    integerCosine (waveNeg wave) = integerCosine wave := by
  funext x
  simp [integerCosine, integerWavePhase, waveNeg]

/-- The multiplier generated by the actual even kernel is even in frequency. -/
@[simp] theorem coarseCharacterMultiplier_waveNeg
    (s : CoarseScale) (wave : IntegerWavevector) :
    coarseCharacterMultiplier s (waveNeg wave) =
      coarseCharacterMultiplier s wave := by
  rw [coarseCharacterMultiplier, coarseCharacterMultiplier,
    integerCosine_waveNeg]

/-! ## Native raw-source update -/

/-- The complete complex coefficient-function carrier. -/
abbrev VorticityCoefficientCarrier :=
  IntegerWavevector → ComplexCoordinateVector

/--
The source-owned update keeps the raw mode inventory and multiplies every raw
coefficient by the actual coarse-character multiplier at that frequency.
-/
def coarseFilterSourceUpdate
    (s : CoarseScale)
    (source : RawVorticityFourierSource) : RawVorticityFourierSource where
  activeModes := source.activeModes
  rawVorticity := fun wave =>
    (coarseCharacterMultiplier s wave : ℂ) • source.rawVorticity wave

@[simp] theorem coarseFilterSourceUpdate_activeModes
    (s : CoarseScale)
    (source : RawVorticityFourierSource) :
    (coarseFilterSourceUpdate s source).activeModes = source.activeModes :=
  rfl

@[simp] theorem coarseFilterSourceUpdate_generatedSupport
    (s : CoarseScale)
    (source : RawVorticityFourierSource) :
    generatedSupport (coarseFilterSourceUpdate s source) =
      generatedSupport source :=
  rfl

/-- The coefficientwise multiplier as a linear keep on the whole carrier. -/
def coarseCoefficientKeep
    (s : CoarseScale) :
    VorticityCoefficientCarrier →ₗ[ℂ] VorticityCoefficientCarrier where
  toFun := fun coefficient wave =>
    (coarseCharacterMultiplier s wave : ℂ) • coefficient wave
  map_add' := by
    intro left right
    funext wave coordinate
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    ring
  map_smul' := by
    intro scalar coefficient
    funext wave coordinate
    simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
    ring

@[simp] theorem coarseCoefficientKeep_apply
    (s : CoarseScale)
    (coefficient : VorticityCoefficientCarrier)
    (wave : IntegerWavevector) :
    coarseCoefficientKeep s coefficient wave =
      (coarseCharacterMultiplier s wave : ℂ) • coefficient wave :=
  rfl

/-! ## Coefficient transport through the generated source laws -/

theorem supportedRawVorticity_coarseFilterSourceUpdate
    (s : CoarseScale)
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) :
    supportedRawVorticity (coarseFilterSourceUpdate s source) wave =
      (coarseCharacterMultiplier s wave : ℂ) •
        supportedRawVorticity source wave := by
  by_cases membership : wave ∈ source.activeModes
  · simp [supportedRawVorticity, coarseFilterSourceUpdate, membership]
  · simp [supportedRawVorticity, coarseFilterSourceUpdate, membership]

theorem realitySymmetrizedVorticity_coarseFilterSourceUpdate
    (s : CoarseScale)
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) :
    realitySymmetrizedVorticity (coarseFilterSourceUpdate s source) wave =
      (coarseCharacterMultiplier s wave : ℂ) •
        realitySymmetrizedVorticity source wave := by
  funext coordinate
  unfold realitySymmetrizedVorticity
  rw [supportedRawVorticity_coarseFilterSourceUpdate,
    supportedRawVorticity_coarseFilterSourceUpdate,
    coarseCharacterMultiplier_waveNeg]
  simp only [Pi.smul_apply, smul_eq_mul, map_mul,
    Complex.star_def, Complex.conj_ofReal]
  ring

/-- Transverse projection is complex-linear in its coefficient input. -/
theorem transverseProjection_smul
    (wave : IntegerWavevector)
    (scalar : ℂ)
    (coefficient : ComplexCoordinateVector) :
    transverseProjection wave (scalar • coefficient) =
      scalar • transverseProjection wave coefficient := by
  by_cases waveZero : wave = 0
  · subst wave
    simp [transverseProjection]
  · rw [transverseProjection, if_neg waveZero,
      transverseProjection, if_neg waveZero]
    funext coordinate
    simp [dotProduct_smul]
    ring

/--
The actual source update transports every generated vorticity coefficient by
the same whole-carrier keep.  There is no admission premise.
-/
theorem generatedVorticityCoefficient_coarseFilterSourceUpdate
    (s : CoarseScale)
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) :
    generatedVorticityCoefficient (coarseFilterSourceUpdate s source) wave =
      coarseCoefficientKeep s
        (generatedVorticityCoefficient source) wave := by
  by_cases membership : wave ∈ generatedSupport source
  · rw [generatedVorticityCoefficient,
      coarseFilterSourceUpdate_generatedSupport,
      if_pos membership,
      realitySymmetrizedVorticity_coarseFilterSourceUpdate,
      transverseProjection_smul,
      coarseCoefficientKeep_apply,
      generatedVorticityCoefficient,
      if_pos membership]
  · rw [generatedVorticityCoefficient,
      coarseFilterSourceUpdate_generatedSupport,
      if_neg membership,
      coarseCoefficientKeep_apply,
      generatedVorticityCoefficient,
      if_neg membership]
    rw [smul_zero]

/-- Biot--Savart inversion is complex-linear in the vorticity coefficient. -/
theorem biotSavartVelocityCoefficient_smul
    (wave : IntegerWavevector)
    (scalar : ℂ)
    (vorticity : ComplexCoordinateVector) :
    biotSavartVelocityCoefficient wave (scalar • vorticity) =
      scalar • biotSavartVelocityCoefficient wave vorticity := by
  by_cases waveZero : wave = 0
  · subst wave
    simp
  · rw [biotSavartVelocityCoefficient, if_neg waveZero,
      biotSavartVelocityCoefficient, if_neg waveZero]
    funext coordinate
    fin_cases coordinate <;>
      simp [cross_apply] <;>
      ring

/-- The same keep transports every generated velocity coefficient. -/
theorem generatedVelocityCoefficient_coarseFilterSourceUpdate
    (s : CoarseScale)
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) :
    generatedVelocityCoefficient (coarseFilterSourceUpdate s source) wave =
      coarseCoefficientKeep s
        (generatedVelocityCoefficient source) wave := by
  unfold generatedVelocityCoefficient
  rw [
    generatedVorticityCoefficient_coarseFilterSourceUpdate,
    coarseCoefficientKeep_apply,
    biotSavartVelocityCoefficient_smul,
    coarseCoefficientKeep_apply]

/-! ## Effective residual process and forced trace -/

/--
The generated vorticity table is the residual of the native source update.
The zero target is a reference field; the transport law itself is the actual
coefficient update proved above.
-/
def coarseVorticityCoefficientProcess
    (s : CoarseScale) :
    EffectiveResidualProcess ℂ VorticityCoefficientCarrier
      RawVorticityFourierSource where
  target := 0
  keep := coarseCoefficientKeep s
  residual := generatedVorticityCoefficient
  update := coarseFilterSourceUpdate s
  residual_transport_law := by
    intro source
    funext wave
    exact generatedVorticityCoefficient_coarseFilterSourceUpdate
      s source wave

/-- The old coefficient residual is the updated residual plus forced trace. -/
theorem coarseVorticityCoefficientProcess_residual_split
    (s : CoarseScale)
    (source : RawVorticityFourierSource) :
    generatedVorticityCoefficient source =
      generatedVorticityCoefficient
          (coarseFilterSourceUpdate s source) +
        linearResidualTrace (coarseCoefficientKeep s)
          (generatedVorticityCoefficient source) := by
  exact
    effectiveProcess_residual_eq_next_residual_add_trace
      (coarseVorticityCoefficientProcess s) source

/-- Any proposed trace in the actual source split is the canonical complement. -/
theorem coarseVorticityCoefficientProcess_trace_unique
    (s : CoarseScale)
    (source : RawVorticityFourierSource)
    (trace : VorticityCoefficientCarrier) :
    generatedVorticityCoefficient source =
        generatedVorticityCoefficient
            (coarseFilterSourceUpdate s source) + trace ↔
      trace = linearResidualTrace (coarseCoefficientKeep s)
        (generatedVorticityCoefficient source) := by
  exact
    effectiveProcess_trace_unique
      (coarseVorticityCoefficientProcess s) source trace

/-! ## Whole-carrier physical commuting square -/

@[simp] theorem coefficientReal_ofReal_smul
    (scalar : ℝ)
    (coefficient : ComplexCoordinateVector) :
    coefficientReal ((scalar : ℂ) • coefficient) =
      scalar • coefficientReal coefficient := by
  ext coordinate
  simp [coefficientReal]

@[simp] theorem coefficientImag_ofReal_smul
    (scalar : ℝ)
    (coefficient : ComplexCoordinateVector) :
    coefficientImag ((scalar : ℂ) • coefficient) =
      scalar • coefficientImag coefficient := by
  ext coordinate
  simp [coefficientImag]

private theorem coarseFilter_integerCosine_smul_const
    (s : CoarseScale)
    (wave : IntegerWavevector)
    (coefficient : PhysicalSpace)
    (x : PhysicalSpace) :
    coarseFilter s
        (fun y => integerCosine wave y • coefficient) x =
      (coarseCharacterMultiplier s wave * integerCosine wave x) •
        coefficient := by
  simp only [coarseFilter, convolution_def,
    ContinuousLinearMap.lsmul_apply]
  simp_rw [smul_smul]
  rw [integral_smul_const]
  change
    coarseFilter s (integerCosine wave) x • coefficient = _
  rw [coarseFilter_integerCosine_apply]

private theorem coarseFilter_integerSine_smul_const
    (s : CoarseScale)
    (wave : IntegerWavevector)
    (coefficient : PhysicalSpace)
    (x : PhysicalSpace) :
    coarseFilter s
        (fun y => integerSine wave y • coefficient) x =
      (coarseCharacterMultiplier s wave * integerSine wave x) •
        coefficient := by
  simp only [coarseFilter, convolution_def,
    ContinuousLinearMap.lsmul_apply]
  simp_rw [smul_smul]
  rw [integral_smul_const]
  change
    coarseFilter s (integerSine wave) x • coefficient = _
  rw [coarseFilter_integerSine_apply]

/-- The actual spatial filter agrees with coefficient keep on one full mode. -/
theorem coarseFilter_realComplexFourierMode
    (s : CoarseScale)
    (wave : IntegerWavevector)
    (coefficient : ComplexCoordinateVector) :
    coarseFilter s (realComplexFourierMode wave coefficient) =
      realComplexFourierMode wave
        ((coarseCharacterMultiplier s wave : ℂ) • coefficient) := by
  have cosineLocallyIntegrable :
      LocallyIntegrable
        (fun x => integerCosine wave x • coefficientReal coefficient)
        volume :=
    ((integerCosine_continuous wave).smul continuous_const)
      |>.locallyIntegrable
  have sineLocallyIntegrable :
      LocallyIntegrable
        (fun x => integerSine wave x • coefficientImag coefficient)
        volume :=
    ((integerSine_continuous wave).smul continuous_const)
      |>.locallyIntegrable
  funext x
  rw [show realComplexFourierMode wave coefficient =
      (fun y => integerCosine wave y • coefficientReal coefficient) -
        (fun y => integerSine wave y • coefficientImag coefficient) by
        rfl]
  rw [congrFun
    (coarseFilter_sub s _ _
      cosineLocallyIntegrable sineLocallyIntegrable) x]
  simp only [Pi.sub_apply]
  rw [coarseFilter_integerCosine_smul_const,
    coarseFilter_integerSine_smul_const]
  unfold realComplexFourierMode
  rw [coefficientReal_ofReal_smul,
    coefficientImag_ofReal_smul]
  ext coordinate
  simp only [PiLp.smul_apply, PiLp.sub_apply]
  ring

private theorem finiteRealComplexFourierField_insert
    (wave : IntegerWavevector)
    (modes : Finset IntegerWavevector)
    (notMem : wave ∉ modes)
    (coefficient : VorticityCoefficientCarrier) :
    finiteRealComplexFourierField (insert wave modes) coefficient =
      realComplexFourierMode wave (coefficient wave) +
        finiteRealComplexFourierField modes coefficient := by
  funext x
  simp [finiteRealComplexFourierField, notMem]

/--
The full-signed physical compiler commutes with coefficient keep on every
finite inventory and every coefficient table.
-/
theorem finiteRealComplexFourierField_coarseCoefficientKeep
    (s : CoarseScale)
    (modes : Finset IntegerWavevector)
    (coefficient : VorticityCoefficientCarrier) :
    finiteRealComplexFourierField modes
        (coarseCoefficientKeep s coefficient) =
      coarseFilter s
        (finiteRealComplexFourierField modes coefficient) := by
  classical
  induction modes using Finset.induction_on with
  | empty =>
      rw [show finiteRealComplexFourierField ∅
          (coarseCoefficientKeep s coefficient) = 0 by
        funext x
        simp [finiteRealComplexFourierField]]
      rw [show finiteRealComplexFourierField ∅ coefficient = 0 by
        funext x
        simp [finiteRealComplexFourierField]]
      exact (coarseFilter_const s (0 : PhysicalSpace)).symm
  | @insert wave modes notMem inductionHypothesis =>
      rw [finiteRealComplexFourierField_insert wave modes notMem,
        finiteRealComplexFourierField_insert wave modes notMem]
      have modeLocallyIntegrable :
          LocallyIntegrable
            (realComplexFourierMode wave (coefficient wave)) volume :=
        (realComplexFourierMode_contDiff wave (coefficient wave))
          |>.continuous.locallyIntegrable
      have remainderLocallyIntegrable :
          LocallyIntegrable
            (finiteRealComplexFourierField modes coefficient) volume :=
        (finiteRealComplexFourierField_contDiff modes coefficient)
          |>.continuous.locallyIntegrable
      rw [coarseFilter_add s _ _
        modeLocallyIntegrable remainderLocallyIntegrable]
      rw [coarseFilter_realComplexFourierMode,
        ← inductionHypothesis]
      rfl

/--
The native raw-source update and the actual spatial coarse filter form the
whole physical-velocity commuting square.
-/
theorem physicalVelocity_coarseFilterSourceUpdate
    (s : CoarseScale)
    (source : RawVorticityFourierSource) :
    physicalVelocity (coarseFilterSourceUpdate s source) =
      coarseFilter s (physicalVelocity source) := by
  rw [physicalVelocity, coarseFilterSourceUpdate_generatedSupport]
  have coefficientEquality :
      generatedVelocityCoefficient
          (coarseFilterSourceUpdate s source) =
        coarseCoefficientKeep s
          (generatedVelocityCoefficient source) := by
    funext wave
    exact generatedVelocityCoefficient_coarseFilterSourceUpdate
      s source wave
  rw [coefficientEquality,
    finiteRealComplexFourierField_coarseCoefficientKeep,
    physicalVelocity]

end

end ThreeDimensionalVorticityCoefficientCoarseFilterProcess
end NavierStokes
end SaturationMonoid
