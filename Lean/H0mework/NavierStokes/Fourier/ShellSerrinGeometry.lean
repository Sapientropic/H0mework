noncomputable section

/-! ## Exact physical endpoint decomposition -/

/-- Physical Biot--Savart velocity generated by the nonzero live rows of one
raw source. -/
def generatedSourcePhysicalVelocityField
    (source : RawVorticityFourierSource) :
    PhysicalSpace → PhysicalSpace :=
  finiteRealComplexFourierField
    (generatedLiveVorticityModes source)
    (generatedVelocityCoefficient source)

/-- Physical velocity field written by one literal generated whole-shell
receipt. -/
def generatedIntegerShellReceiptPhysicalVelocityField
    (receipt : GeneratedIntegerShellReceipt) :
    PhysicalSpace → PhysicalSpace :=
  finiteRealComplexFourierField receipt.wholeShellModes
    fun wave =>
      biotSavartVelocityCoefficient wave
        (generatedVorticityNonlinearCoefficientAt
          receipt.current wave)

/-- Chronological physical velocity field written by an actual finite
generated path. -/
def generatedIntegerShellReachablePhysicalVelocityField
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current) :
    PhysicalSpace → PhysicalSpace :=
  ((generatedIntegerShellReachableReceipts arrival).map
    generatedIntegerShellReceiptPhysicalVelocityField).sum

/-! ## Pointwise control by the Fourier velocity majorant -/

/-- Squared Euclidean amplitude of one complex Fourier vector row. -/
def complexCoordinateAmplitudeSq
    (coefficient : ComplexCoordinateVector) : ℝ :=
  ∑ coordinate : Coordinate,
    Complex.normSq (coefficient coordinate)

@[simp] theorem
    complexCoordinateAmplitudeSq_eq_complexCoordinateVectorNormSq
    (coefficient : ComplexCoordinateVector) :
    complexCoordinateAmplitudeSq coefficient =
      complexCoordinateVectorNormSq coefficient :=
  rfl

/-- Sum of complex-vector amplitudes of an arbitrary finite Fourier table. -/
def finiteVelocityFourierMajorant
    (modes : Finset IntegerWavevector)
    (coefficient : IntegerWavevector → ComplexCoordinateVector) : ℝ :=
  ∑ wave ∈ modes,
    Real.sqrt (complexCoordinateAmplitudeSq (coefficient wave))

/-- Exact Biot--Savart factor retained by the generated-shell Serrin
geometry. -/
def biotSavartSerrinConstant : ℝ :=
  ((2 * Real.pi) ^ 2)⁻¹

theorem biotSavartSerrinConstant_pos :
    0 < biotSavartSerrinConstant := by
  unfold biotSavartSerrinConstant
  positivity

theorem biotSavartSerrinConstant_nonneg :
    0 ≤ biotSavartSerrinConstant :=
  biotSavartSerrinConstant_pos.le

/-- One real Fourier mode has pointwise squared norm at most the squared
complex-coordinate amplitude of its coefficient. -/
theorem realComplexFourierMode_norm_sq_le_coefficientAmplitudeSq
    (wave : IntegerWavevector)
    (coefficient : ComplexCoordinateVector)
    (x : PhysicalSpace) :
    ‖realComplexFourierMode wave coefficient x‖ ^ 2 ≤
      complexCoordinateAmplitudeSq coefficient := by
  rw [EuclideanSpace.real_norm_sq_eq]
  unfold complexCoordinateAmplitudeSq
  change
    (∑ coordinate : Coordinate,
      (integerCosine wave x * (coefficient coordinate).re -
        integerSine wave x * (coefficient coordinate).im) ^ 2) ≤
      ∑ coordinate : Coordinate,
        Complex.normSq (coefficient coordinate)
  apply Finset.sum_le_sum
  intro coordinate coordinateMem
  rw [Complex.normSq_apply]
  have trigonometricIdentity :
      integerCosine wave x ^ 2 +
          integerSine wave x ^ 2 =
        1 := by
    exact Real.cos_sq_add_sin_sq (integerWavePhase wave x)
  nlinarith [
    sq_nonneg
      (integerSine wave x * (coefficient coordinate).re +
        integerCosine wave x * (coefficient coordinate).im)]

theorem complexCoordinateAmplitudeSq_nonneg
    (coefficient : ComplexCoordinateVector) :
    0 ≤ complexCoordinateAmplitudeSq coefficient :=
  Finset.sum_nonneg fun _ _ =>
    Complex.normSq_nonneg _

theorem finiteVelocityFourierMajorant_nonneg
    (modes : Finset IntegerWavevector)
    (coefficient : IntegerWavevector → ComplexCoordinateVector) :
    0 ≤ finiteVelocityFourierMajorant modes coefficient := by
  exact Finset.sum_nonneg fun _ _ =>
    Real.sqrt_nonneg _

/-- The finite physical field is pointwise bounded by its Fourier velocity
majorant. -/
theorem finiteRealComplexFourierField_norm_le_velocityMajorant
    (modes : Finset IntegerWavevector)
    (coefficient : IntegerWavevector → ComplexCoordinateVector)
    (x : PhysicalSpace) :
    ‖finiteRealComplexFourierField modes coefficient x‖ ≤
      finiteVelocityFourierMajorant modes coefficient := by
  rw [finiteRealComplexFourierField,
    finiteVelocityFourierMajorant]
  refine (norm_sum_le modes fun wave =>
    realComplexFourierMode wave (coefficient wave) x).trans ?_
  apply Finset.sum_le_sum
  intro wave waveMem
  exact
    Real.le_sqrt_of_sq_le
      (realComplexFourierMode_norm_sq_le_coefficientAmplitudeSq
        wave (coefficient wave) x)

/-- Squared pointwise form of the finite Fourier-majorant estimate. -/
theorem finiteRealComplexFourierField_norm_sq_le_velocityMajorant_sq
    (modes : Finset IntegerWavevector)
    (coefficient : IntegerWavevector → ComplexCoordinateVector)
    (x : PhysicalSpace) :
    ‖finiteRealComplexFourierField modes coefficient x‖ ^ 2 ≤
      finiteVelocityFourierMajorant modes coefficient ^ 2 := by
  exact
    (sq_le_sq₀
      (norm_nonneg _)
      (finiteVelocityFourierMajorant_nonneg modes coefficient)).mpr
      (finiteRealComplexFourierField_norm_le_velocityMajorant
        modes coefficient x)

/-- Fourier majorant of one source-owned selected shell. -/
def generatedIntegerShellReceiptVelocityMajorant
    (receipt : GeneratedIntegerShellReceipt) : ℝ :=
  finiteVelocityFourierMajorant receipt.wholeShellModes
    fun wave =>
      biotSavartVelocityCoefficient wave
        (generatedVorticityNonlinearCoefficientAt
          receipt.current wave)

/-- Sum of the chronological shell majorants on an actual generated path. -/
def generatedIntegerShellReachableVelocityMajorant
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current) : ℝ :=
  ((generatedIntegerShellReachableReceipts arrival).map
    generatedIntegerShellReceiptVelocityMajorant).sum

theorem generatedIntegerShellReceiptVelocityMajorant_nonneg
    (receipt : GeneratedIntegerShellReceipt) :
    0 ≤ generatedIntegerShellReceiptVelocityMajorant receipt :=
  finiteVelocityFourierMajorant_nonneg _ _

theorem generatedIntegerShellReachableVelocityMajorant_nonneg
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current) :
    0 ≤ generatedIntegerShellReachableVelocityMajorant arrival := by
  exact List.sum_nonneg fun majorant majorantMem => by
    rcases List.mem_map.mp majorantMem with
      ⟨receipt, _, rfl⟩
    exact generatedIntegerShellReceiptVelocityMajorant_nonneg receipt

/-- Reciprocal shell multiplicity contributed by one actual whole shell. -/
def generatedIntegerShellReceiptReciprocalCardWeight
    (receipt : GeneratedIntegerShellReceipt) : ℝ :=
  (receipt.wholeShellModes.card : ℝ) /
    (receipt.selectedShellSq : ℝ)

/-- Sum of `active shell card / shellSq` along the actual generated path. -/
def generatedIntegerShellReachableReciprocalCardWeight
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current) : ℝ :=
  ((generatedIntegerShellReachableReceipts arrival).map
    generatedIntegerShellReceiptReciprocalCardWeight).sum

/-- Unweighted squared vorticity amplitude on one actual selected whole
shell.  The reciprocal shell factor remains on the Biot--Savart side. -/
def generatedIntegerShellReceiptVorticityAmplitudeSqMass
    (receipt : GeneratedIntegerShellReceipt) : ℝ :=
  ∑ wave ∈ receipt.wholeShellModes,
    complexCoordinateAmplitudeSq
      (generatedVorticityNonlinearCoefficientAt
        receipt.current wave)

/-- Literal sum of unweighted squared vorticity amplitudes on the generated
path. -/
def generatedIntegerShellReachableVorticityAmplitudeSqMass
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current) : ℝ :=
  ((generatedIntegerShellReachableReceipts arrival).map
    generatedIntegerShellReceiptVorticityAmplitudeSqMass).sum

/-- Every selected squared shell is strictly positive, generated from an
actual nonzero outer frequency. -/
theorem generatedIntegerShellReceipt_selectedShellSq_pos
    (receipt : GeneratedIntegerShellReceipt) :
    0 < receipt.selectedShellSq := by
  rcases receipt.wholeShellModes_nonempty with
    ⟨wave, waveMembership⟩
  have outerMembership :
      wave ∈ generatedActiveOuterNonlinearModes receipt.current :=
    ((mem_generatedOuterNonlinearShellModes_iff
      receipt.current receipt.selectedShellSq wave).mp
      waveMembership).1
  have wave_ne_zero : wave ≠ 0 := by
    unfold generatedActiveOuterNonlinearModes at outerMembership
    split at outerMembership
    · simp at outerMembership
    · exact (Finset.mem_filter.mp outerMembership).2.1
  have waveShellPos :
      0 < integerWaveShellSq wave :=
    integerWaveShellSq_pos wave_ne_zero
  rwa [
    ((mem_generatedOuterNonlinearShellModes_iff
      receipt.current receipt.selectedShellSq wave).mp
      waveMembership).2] at waveShellPos

theorem generatedIntegerShellReceipt_selectedShellSq_cast_pos
    (receipt : GeneratedIntegerShellReceipt) :
    0 < (receipt.selectedShellSq : ℝ) := by
  exact_mod_cast
    generatedIntegerShellReceipt_selectedShellSq_pos receipt

theorem generatedIntegerShellReceiptReciprocalCardWeight_nonneg
    (receipt : GeneratedIntegerShellReceipt) :
    0 ≤ generatedIntegerShellReceiptReciprocalCardWeight receipt := by
  exact div_nonneg (Nat.cast_nonneg _)
    (generatedIntegerShellReceipt_selectedShellSq_cast_pos receipt).le

theorem generatedIntegerShellReceiptVorticityAmplitudeSqMass_nonneg
    (receipt : GeneratedIntegerShellReceipt) :
    0 ≤
      generatedIntegerShellReceiptVorticityAmplitudeSqMass receipt := by
  exact Finset.sum_nonneg fun _ _ =>
    complexCoordinateAmplitudeSq_nonneg _

theorem generatedIntegerShellReachableReciprocalCardWeight_nonneg
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current) :
    0 ≤ generatedIntegerShellReachableReciprocalCardWeight arrival := by
  exact List.sum_nonneg fun weight weightMem => by
    rcases List.mem_map.mp weightMem with
      ⟨receipt, _, rfl⟩
    exact
      generatedIntegerShellReceiptReciprocalCardWeight_nonneg receipt

theorem generatedIntegerShellReachableVorticityAmplitudeSqMass_nonneg
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current) :
    0 ≤
      generatedIntegerShellReachableVorticityAmplitudeSqMass arrival := by
  exact List.sum_nonneg fun energy energyMem => by
    rcases List.mem_map.mp energyMem with
      ⟨receipt, _, rfl⟩
    exact
      generatedIntegerShellReceiptVorticityAmplitudeSqMass_nonneg
        receipt

private theorem list_map_sum_sq_le_sum_mul_sum_of_sq_le_mul
    {α : Type}
    (entries : List α)
    (r f g : α → ℝ)
    (f_nonneg : ∀ entry ∈ entries, 0 ≤ f entry)
    (g_nonneg : ∀ entry ∈ entries, 0 ≤ g entry)
    (pointwise :
      ∀ entry ∈ entries,
        r entry ^ 2 ≤ f entry * g entry) :
    (entries.map r).sum ^ 2 ≤
      (entries.map f).sum * (entries.map g).sum := by
  have finiteBound :=
    Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul
      (Finset.univ : Finset (Fin entries.length))
      (r := fun index => r (entries.get index))
      (f := fun index => f (entries.get index))
      (g := fun index => g (entries.get index))
      (fun index _ =>
        f_nonneg _ (entries.get_mem index))
      (fun index _ =>
        g_nonneg _ (entries.get_mem index))
      (fun index _ =>
        pointwise _ (entries.get_mem index))
  have mapEq (function : α → ℝ) :
      List.ofFn (fun index => function (entries.get index)) =
        entries.map function := by
    change List.ofFn (function ∘ entries.get) =
      entries.map function
    rw [← List.map_ofFn, List.ofFn_get]
  simpa only [← List.sum_ofFn, mapEq] using finiteBound

private theorem list_map_sum_const_mul
    {α : Type}
    (entries : List α)
    (constant : ℝ)
    (value : α → ℝ) :
    (entries.map fun entry => constant * value entry).sum =
      constant * (entries.map value).sum := by
  induction entries with
  | nil =>
      simp
  | cons head tail inductionHypothesis =>
      simp [inductionHypothesis, mul_add]

/--
Finite-shell Cauchy helper.  The public generated theorem below supplies the
single-mode estimate from actual Biot--Savart inversion.
-/
private theorem finiteVelocityFourierMajorant_sq_le_shellCauchy
    (modes : Finset IntegerWavevector)
    (shellSq constant : ℝ)
    (vorticity velocity :
      IntegerWavevector → ComplexCoordinateVector)
    (shellSq_pos : 0 < shellSq)
    (constant_nonneg : 0 ≤ constant)
    (velocityAmplitudeBound :
      ∀ wave ∈ modes,
        complexCoordinateAmplitudeSq (velocity wave) ≤
          (constant / shellSq) *
            complexCoordinateAmplitudeSq (vorticity wave)) :
    finiteVelocityFourierMajorant modes velocity ^ 2 ≤
      constant * ((modes.card : ℝ) / shellSq) *
        ∑ wave ∈ modes,
          complexCoordinateAmplitudeSq (vorticity wave) := by
  have cauchyBound :=
    Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul
      modes
      (r := fun wave =>
        Real.sqrt
          (complexCoordinateAmplitudeSq (velocity wave)))
      (f := fun _ => constant / shellSq)
      (g := fun wave =>
        complexCoordinateAmplitudeSq (vorticity wave))
      (fun _ _ =>
        div_nonneg constant_nonneg shellSq_pos.le)
      (fun wave _ =>
        complexCoordinateAmplitudeSq_nonneg
          (vorticity wave))
      (fun wave waveMem => by
        rw [Real.sq_sqrt
          (complexCoordinateAmplitudeSq_nonneg
            (velocity wave))]
        calc
          complexCoordinateAmplitudeSq (velocity wave) ≤
              (constant / shellSq) *
                complexCoordinateAmplitudeSq
                  (vorticity wave) :=
            velocityAmplitudeBound wave waveMem
          _ = _ := rfl)
  unfold finiteVelocityFourierMajorant
  calc
    (∑ wave ∈ modes,
        √(complexCoordinateAmplitudeSq (velocity wave))) ^ 2 ≤
        (∑ _wave ∈ modes, constant / shellSq) *
          ∑ wave ∈ modes,
            complexCoordinateAmplitudeSq
              (vorticity wave) :=
      cauchyBound
    _ =
        constant * ((modes.card : ℝ) / shellSq) *
          ∑ wave ∈ modes,
            complexCoordinateAmplitudeSq
              (vorticity wave) := by
      rw [Finset.sum_const, nsmul_eq_mul]
      ring

/-- Exact receipt-local Biot--Savart amplitude, now in the amplitude notation
used by the Fourier majorant. -/
theorem generatedIntegerShellReceipt_biotSavartAmplitudeSq
    (receipt : GeneratedIntegerShellReceipt)
    {wave : IntegerWavevector}
    (waveMem : wave ∈ receipt.wholeShellModes) :
    complexCoordinateAmplitudeSq
        (biotSavartVelocityCoefficient wave
          (generatedVorticityNonlinearCoefficientAt
            receipt.current wave)) =
      complexCoordinateAmplitudeSq
          (generatedVorticityNonlinearCoefficientAt
            receipt.current wave) /
        ((2 * Real.pi) ^ 2 *
          (receipt.selectedShellSq : ℝ)) := by
  exact
    generatedIntegerShellReceipt_biotSavartNormSq
      receipt waveMem

/-- The exact source-selected shell row retains the full reciprocal-shell
Biot--Savart saving. -/
theorem generatedIntegerShellReceipt_biotSavartAmplitudeSq_le
    (receipt : GeneratedIntegerShellReceipt)
    {wave : IntegerWavevector}
    (waveMem : wave ∈ receipt.wholeShellModes) :
    complexCoordinateAmplitudeSq
        (biotSavartVelocityCoefficient wave
          (generatedVorticityNonlinearCoefficientAt
            receipt.current wave)) ≤
      (biotSavartSerrinConstant /
          (receipt.selectedShellSq : ℝ)) *
        complexCoordinateAmplitudeSq
          (generatedVorticityNonlinearCoefficientAt
            receipt.current wave) := by
  rw [generatedIntegerShellReceipt_biotSavartAmplitudeSq
    receipt waveMem]
  apply le_of_eq
  unfold biotSavartSerrinConstant
  have shellNe :
      (receipt.selectedShellSq : ℝ) ≠ 0 :=
    (generatedIntegerShellReceipt_selectedShellSq_cast_pos
      receipt).ne'
  have piNe : Real.pi ≠ 0 := Real.pi_ne_zero
  field_simp

/-- A source-owned receipt satisfies the sharp finite-shell Serrin
geometry, with no caller-supplied transversality or shell condition. -/
theorem generatedIntegerShellReceiptVelocityMajorant_sq_le
    (receipt : GeneratedIntegerShellReceipt) :
    generatedIntegerShellReceiptVelocityMajorant receipt ^ 2 ≤
      biotSavartSerrinConstant *
        generatedIntegerShellReceiptReciprocalCardWeight receipt *
        generatedIntegerShellReceiptVorticityAmplitudeSqMass receipt := by
  exact
    finiteVelocityFourierMajorant_sq_le_shellCauchy
      receipt.wholeShellModes
      (receipt.selectedShellSq : ℝ)
      biotSavartSerrinConstant
      (fun wave =>
        generatedVorticityNonlinearCoefficientAt
          receipt.current wave)
      (fun wave =>
        biotSavartVelocityCoefficient wave
          (generatedVorticityNonlinearCoefficientAt
            receipt.current wave))
      (generatedIntegerShellReceipt_selectedShellSq_cast_pos
        receipt)
      biotSavartSerrinConstant_nonneg
      (fun wave waveMem =>
        generatedIntegerShellReceipt_biotSavartAmplitudeSq_le
          receipt waveMem)

/--
Pathwise Cauchy aggregation.  The only analytic input is a receipt estimate;
the eventual public theorem supplies it from the exact generated
Biot--Savart row.
-/
private theorem
    generatedIntegerShellReachableVelocityMajorant_sq_le_of_receipt_bound
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (receiptBound :
      ∀ receipt ∈ generatedIntegerShellReachableReceipts arrival,
        generatedIntegerShellReceiptVelocityMajorant receipt ^ 2 ≤
          biotSavartSerrinConstant *
            generatedIntegerShellReceiptReciprocalCardWeight receipt *
            generatedIntegerShellReceiptVorticityAmplitudeSqMass
              receipt) :
    generatedIntegerShellReachableVelocityMajorant arrival ^ 2 ≤
      biotSavartSerrinConstant *
        generatedIntegerShellReachableReciprocalCardWeight arrival *
        generatedIntegerShellReachableVorticityAmplitudeSqMass
          arrival := by
  let receipts :=
    generatedIntegerShellReachableReceipts arrival
  have pathCauchy :=
    list_map_sum_sq_le_sum_mul_sum_of_sq_le_mul
      receipts
      generatedIntegerShellReceiptVelocityMajorant
      (fun receipt =>
        biotSavartSerrinConstant *
          generatedIntegerShellReceiptReciprocalCardWeight receipt)
      generatedIntegerShellReceiptVorticityAmplitudeSqMass
      (fun receipt receiptMem =>
        mul_nonneg biotSavartSerrinConstant_nonneg
          (generatedIntegerShellReceiptReciprocalCardWeight_nonneg
            receipt))
      (fun receipt receiptMem =>
        generatedIntegerShellReceiptVorticityAmplitudeSqMass_nonneg
          receipt)
      (fun receipt receiptMem =>
        receiptBound receipt receiptMem)
  rw [list_map_sum_const_mul] at pathCauchy
  exact pathCauchy

/-- The full actual receipt list satisfies one pathwise Fourier-majorant
bound.  The list, shell labels, and each shell's nonzero provenance all come
from `arrival`. -/
theorem generatedIntegerShellReachableVelocityMajorant_sq_le
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current) :
    generatedIntegerShellReachableVelocityMajorant arrival ^ 2 ≤
      biotSavartSerrinConstant *
        generatedIntegerShellReachableReciprocalCardWeight arrival *
        generatedIntegerShellReachableVorticityAmplitudeSqMass
          arrival := by
  exact
    generatedIntegerShellReachableVelocityMajorant_sq_le_of_receipt_bound
      arrival
      (fun receipt receiptMem =>
        generatedIntegerShellReceiptVelocityMajorant_sq_le
          receipt)

private theorem norm_list_sum_le_sum_norm
    (vectors : List PhysicalSpace) :
    ‖vectors.sum‖ ≤ (vectors.map norm).sum := by
  induction vectors with
  | nil =>
      simp
  | cons head tail inductionHypothesis =>
      calc
        ‖(head :: tail).sum‖ =
            ‖head + tail.sum‖ := by
          rw [List.sum_cons]
        _ ≤ ‖head‖ + ‖tail.sum‖ :=
          norm_add_le _ _
        _ ≤ ‖head‖ + (tail.map norm).sum :=
          add_le_add le_rfl inductionHypothesis
        _ = ((head :: tail).map norm).sum := by
          simp

private theorem list_sum_apply
    (fields : List (PhysicalSpace → PhysicalSpace))
    (x : PhysicalSpace) :
    fields.sum x = (fields.map fun field => field x).sum := by
  induction fields with
  | nil =>
      simp
  | cons head tail inductionHypothesis =>
      simp [inductionHypothesis]

/-- The generated physical shell field is pointwise bounded by the actual
chronological sum of its receipt majorants. -/
theorem generatedIntegerShellReachablePhysicalVelocityField_norm_le_majorant
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (x : PhysicalSpace) :
    ‖generatedIntegerShellReachablePhysicalVelocityField arrival x‖ ≤
      generatedIntegerShellReachableVelocityMajorant arrival := by
  let receipts :=
    generatedIntegerShellReachableReceipts arrival
  calc
    ‖generatedIntegerShellReachablePhysicalVelocityField arrival x‖ =
        ‖(receipts.map fun receipt =>
          generatedIntegerShellReceiptPhysicalVelocityField receipt x).sum‖ := by
      rw [generatedIntegerShellReachablePhysicalVelocityField,
        list_sum_apply]
      simp [List.map_map, Function.comp_def, receipts]
    _ ≤
        ((receipts.map fun receipt =>
          generatedIntegerShellReceiptPhysicalVelocityField receipt x).map
            norm).sum :=
      norm_list_sum_le_sum_norm _
    _ ≤
        (receipts.map
          generatedIntegerShellReceiptVelocityMajorant).sum := by
      rw [List.map_map]
      apply List.sum_le_sum
      intro receipt receiptMembership
      exact
        finiteRealComplexFourierField_norm_le_velocityMajorant
          receipt.wholeShellModes
          (fun wave =>
            biotSavartVelocityCoefficient wave
              (generatedVorticityNonlinearCoefficientAt
                receipt.current wave))
          x
    _ =
        generatedIntegerShellReachableVelocityMajorant arrival := by
      rfl

/-- Squared pointwise field bound by the source-generated Fourier
majorant. -/
theorem generatedIntegerShellReachablePhysicalVelocityField_norm_sq_le_majorant_sq
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (x : PhysicalSpace) :
    ‖generatedIntegerShellReachablePhysicalVelocityField arrival x‖ ^ 2 ≤
      generatedIntegerShellReachableVelocityMajorant arrival ^ 2 := by
  exact
    (sq_le_sq₀
      (norm_nonneg _)
      (generatedIntegerShellReachableVelocityMajorant_nonneg
        arrival)).mpr
      (generatedIntegerShellReachablePhysicalVelocityField_norm_le_majorant
        arrival x)

/-- One successful response adds exactly its selected physical shell field
and preserves every old live velocity row. -/
theorem generatedSourcePhysicalVelocityField_next
    (receipt : GeneratedIntegerShellReceipt) :
    generatedSourcePhysicalVelocityField receipt.next =
      generatedSourcePhysicalVelocityField receipt.current +
        generatedIntegerShellReceiptPhysicalVelocityField receipt := by
  funext x
  simp only [generatedSourcePhysicalVelocityField,
    generatedIntegerShellReceiptPhysicalVelocityField,
    finiteRealComplexFourierField, Pi.add_apply]
  rw [receipt.liveModes_next,
    Finset.sum_union receipt.liveModes_disjoint_wholeShell]
  congr 1
  · apply Finset.sum_congr rfl
    intro wave live
    rw [generatedVelocityCoefficient,
      generatedVelocityCoefficient,
      receipt.next_eq_extension,
      extendByGeneratedNonlinearShell_preserves_live_coefficient
        receipt.current receipt.selectedShellSq live]
  · apply Finset.sum_congr rfl
    intro wave shellMembership
    rw [generatedVelocityCoefficient,
      receipt.next_eq_extension,
      extendByGeneratedNonlinearShell_newShell_coefficient
        receipt.current receipt.selectedShellSq shellMembership]

/--
Exact endpoint residual split.  The seed velocity is the literal uncovered
residual; every subsequent summand is tied to an actual successful response.
-/
theorem generatedSourcePhysicalVelocityField_eq_seed_add_generatedShells
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current) :
    generatedSourcePhysicalVelocityField current =
      generatedSourcePhysicalVelocityField seed +
        generatedIntegerShellReachablePhysicalVelocityField arrival := by
  induction arrival with
  | initial =>
      simp [generatedIntegerShellReachablePhysicalVelocityField,
        generatedIntegerShellReachableReceipts]
  | @step prior arrival response generated inductionHypothesis =>
      let receipt : GeneratedIntegerShellReceipt :=
        ⟨prior, response, generated⟩
      calc
        generatedSourcePhysicalVelocityField response.1 =
            generatedSourcePhysicalVelocityField prior +
              generatedIntegerShellReceiptPhysicalVelocityField receipt :=
          generatedSourcePhysicalVelocityField_next receipt
        _ =
            generatedSourcePhysicalVelocityField seed +
              (generatedIntegerShellReachablePhysicalVelocityField arrival +
                generatedIntegerShellReceiptPhysicalVelocityField receipt) := by
          rw [inductionHypothesis]
          abel
        _ =
            generatedSourcePhysicalVelocityField seed +
              generatedIntegerShellReachablePhysicalVelocityField
                (NativeReachable.step arrival generated) := by
          simp [generatedIntegerShellReachablePhysicalVelocityField,
            generatedIntegerShellReachableReceipts_step,
            List.concat_eq_append, receipt]

/--
Pointwise endpoint-Serrin geometry on an arbitrary finite
source-generated shell path.  The first conjunct is the exact endpoint
write-back: the seed field remains as the literal uncovered residual.  The
second conjunct controls the complete generated part by

`(2π)⁻² * (sum shellCard / shellSq) * (sum vorticity amplitudeSq)`.

There is no shell coverage, cardinality bound, amplitude decay, occupancy,
trajectory, or target premise.
-/
theorem generatedIntegerShellReachable_endpointSerrinGeometry
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (x : PhysicalSpace) :
    generatedSourcePhysicalVelocityField current x =
        generatedSourcePhysicalVelocityField seed x +
          generatedIntegerShellReachablePhysicalVelocityField arrival x ∧
      ‖generatedIntegerShellReachablePhysicalVelocityField arrival x‖ ^ 2 ≤
        biotSavartSerrinConstant *
          generatedIntegerShellReachableReciprocalCardWeight arrival *
          generatedIntegerShellReachableVorticityAmplitudeSqMass
            arrival := by
  constructor
  · exact congrFun
      (generatedSourcePhysicalVelocityField_eq_seed_add_generatedShells
        arrival) x
  · exact
      (generatedIntegerShellReachablePhysicalVelocityField_norm_sq_le_majorant_sq
        arrival x).trans
        (generatedIntegerShellReachableVelocityMajorant_sq_le
          arrival)

/-! ## Whole-shell geometry on an arbitrary common vorticity state -/

/-- Biot--Savart field on one actual receipt shell, evaluated on an
arbitrary common vorticity state. -/
def generatedIntegerShellReceiptStatePhysicalVelocityField
    (receipt : GeneratedIntegerShellReceipt)
    (state : IntegerWavevector → ComplexCoordinateVector) :
    PhysicalSpace → PhysicalSpace :=
  finiteRealComplexFourierField receipt.wholeShellModes
    fun wave =>
      biotSavartVelocityCoefficient wave (state wave)

/-- Complete actual receipt path evaluated on one common vorticity state. -/
def generatedIntegerShellReachableStatePhysicalVelocityField
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (state : IntegerWavevector → ComplexCoordinateVector) :
    PhysicalSpace → PhysicalSpace :=
  ((generatedIntegerShellReachableReceipts arrival).map
    fun receipt =>
      generatedIntegerShellReceiptStatePhysicalVelocityField
        receipt state).sum

/-- Fourier velocity majorant of one actual receipt shell on a common
state. -/
def generatedIntegerShellReceiptStateVelocityMajorant
    (receipt : GeneratedIntegerShellReceipt)
    (state : IntegerWavevector → ComplexCoordinateVector) : ℝ :=
  finiteVelocityFourierMajorant receipt.wholeShellModes
    fun wave =>
      biotSavartVelocityCoefficient wave (state wave)

/-- Sum of actual receipt-shell velocity majorants on a common state. -/
def generatedIntegerShellReachableStateVelocityMajorant
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (state : IntegerWavevector → ComplexCoordinateVector) : ℝ :=
  ((generatedIntegerShellReachableReceipts arrival).map
    fun receipt =>
      generatedIntegerShellReceiptStateVelocityMajorant
        receipt state).sum

/-- Complete squared vorticity mass on one actual whole shell.  Unlike a
trace-support readout, this includes every coordinate of every wave in the
shell, so it controls the full Biot--Savart row of an arbitrary state. -/
def generatedIntegerShellReceiptWholeShellVorticityMass
    (receipt : GeneratedIntegerShellReceipt)
    (state : IntegerWavevector → ComplexCoordinateVector) : ℝ :=
  ∑ wave ∈ receipt.wholeShellModes,
    complexCoordinateAmplitudeSq (state wave)

/-- Complete whole-shell vorticity mass along an actual generated path. -/
def pathWholeShellVorticityMass
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (state : IntegerWavevector → ComplexCoordinateVector) : ℝ :=
  ((generatedIntegerShellReachableReceipts arrival).map
    fun receipt =>
      generatedIntegerShellReceiptWholeShellVorticityMass
        receipt state).sum

theorem generatedIntegerShellReceiptStateVelocityMajorant_nonneg
    (receipt : GeneratedIntegerShellReceipt)
    (state : IntegerWavevector → ComplexCoordinateVector) :
    0 ≤
      generatedIntegerShellReceiptStateVelocityMajorant
        receipt state :=
  finiteVelocityFourierMajorant_nonneg _ _

theorem generatedIntegerShellReachableStateVelocityMajorant_nonneg
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (state : IntegerWavevector → ComplexCoordinateVector) :
    0 ≤
      generatedIntegerShellReachableStateVelocityMajorant
        arrival state := by
  exact List.sum_nonneg fun majorant majorantMem => by
    rcases List.mem_map.mp majorantMem with
      ⟨receipt, _, rfl⟩
    exact
      generatedIntegerShellReceiptStateVelocityMajorant_nonneg
        receipt state

theorem generatedIntegerShellReceiptWholeShellVorticityMass_nonneg
    (receipt : GeneratedIntegerShellReceipt)
    (state : IntegerWavevector → ComplexCoordinateVector) :
    0 ≤
      generatedIntegerShellReceiptWholeShellVorticityMass
        receipt state := by
  exact Finset.sum_nonneg fun _ _ =>
    complexCoordinateAmplitudeSq_nonneg _

theorem pathWholeShellVorticityMass_nonneg
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (state : IntegerWavevector → ComplexCoordinateVector) :
    0 ≤ pathWholeShellVorticityMass arrival state := by
  exact List.sum_nonneg fun mass massMem => by
    rcases List.mem_map.mp massMem with
      ⟨receipt, _, rfl⟩
    exact
      generatedIntegerShellReceiptWholeShellVorticityMass_nonneg
        receipt state

/-- Every wave in an actual generated whole shell is nonzero. -/
theorem generatedIntegerShellReceipt_wave_ne_zero
    (receipt : GeneratedIntegerShellReceipt)
    {wave : IntegerWavevector}
    (waveMem : wave ∈ receipt.wholeShellModes) :
    wave ≠ 0 := by
  intro waveZero
  subst wave
  exact
    zero_not_mem_generatedOuterNonlinearShellModes
      receipt.current receipt.selectedShellSq waveMem

/--
General, non-transverse receipt-row Biot--Savart bound.  The cross-product
Lagrange inequality supplies the estimate for an arbitrary state; the actual
receipt supplies nonzero frequency and the exact shell denominator.
-/
theorem generatedIntegerShellReceipt_state_biotSavartAmplitudeSq_le
    (receipt : GeneratedIntegerShellReceipt)
    (state : IntegerWavevector → ComplexCoordinateVector)
    {wave : IntegerWavevector}
    (waveMem : wave ∈ receipt.wholeShellModes) :
    complexCoordinateAmplitudeSq
        (biotSavartVelocityCoefficient wave (state wave)) ≤
      (biotSavartSerrinConstant /
          (receipt.selectedShellSq : ℝ)) *
        complexCoordinateAmplitudeSq (state wave) := by
  have shellEq :
      integerWaveNormSq wave =
        (receipt.selectedShellSq : ℝ) := by
    rw [integerWaveNormSq_eq_integerWaveShellSq,
      ((mem_generatedOuterNonlinearShellModes_iff
        receipt.current receipt.selectedShellSq wave).mp
        waveMem).2]
  calc
    complexCoordinateAmplitudeSq
        (biotSavartVelocityCoefficient wave (state wave)) =
        complexCoordinateVectorNormSq
          (biotSavartVelocityCoefficient wave (state wave)) :=
      rfl
    _ ≤
        complexCoordinateVectorNormSq (state wave) /
          ((2 * Real.pi) ^ 2 *
            integerWaveNormSq wave) :=
      biotSavartVelocityCoefficient_normSq_le
        wave (state wave)
        (generatedIntegerShellReceipt_wave_ne_zero
          receipt waveMem)
    _ =
        complexCoordinateAmplitudeSq (state wave) /
          ((2 * Real.pi) ^ 2 *
            (receipt.selectedShellSq : ℝ)) := by
      rw [shellEq]
      rfl
    _ =
        (biotSavartSerrinConstant /
            (receipt.selectedShellSq : ℝ)) *
          complexCoordinateAmplitudeSq (state wave) := by
      unfold biotSavartSerrinConstant
      have shellNe :
          (receipt.selectedShellSq : ℝ) ≠ 0 :=
        (generatedIntegerShellReceipt_selectedShellSq_cast_pos
          receipt).ne'
      have piNe : Real.pi ≠ 0 := Real.pi_ne_zero
      field_simp

/-- Receipt-local finite-shell geometry on an arbitrary common state. -/
theorem generatedIntegerShellReceiptStateVelocityMajorant_sq_le
    (receipt : GeneratedIntegerShellReceipt)
    (state : IntegerWavevector → ComplexCoordinateVector) :
    generatedIntegerShellReceiptStateVelocityMajorant
        receipt state ^ 2 ≤
      biotSavartSerrinConstant *
        generatedIntegerShellReceiptReciprocalCardWeight receipt *
        generatedIntegerShellReceiptWholeShellVorticityMass
          receipt state := by
  exact
    finiteVelocityFourierMajorant_sq_le_shellCauchy
      receipt.wholeShellModes
      (receipt.selectedShellSq : ℝ)
      biotSavartSerrinConstant
      state
      (fun wave =>
        biotSavartVelocityCoefficient wave (state wave))
      (generatedIntegerShellReceipt_selectedShellSq_cast_pos
        receipt)
      biotSavartSerrinConstant_nonneg
      (fun wave waveMem =>
        generatedIntegerShellReceipt_state_biotSavartAmplitudeSq_le
          receipt state waveMem)

/-- Pathwise Fourier-majorant geometry on an arbitrary common state. -/
theorem generatedIntegerShellReachableStateVelocityMajorant_sq_le
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (state : IntegerWavevector → ComplexCoordinateVector) :
    generatedIntegerShellReachableStateVelocityMajorant
        arrival state ^ 2 ≤
      biotSavartSerrinConstant *
        generatedIntegerShellReachableReciprocalCardWeight arrival *
        pathWholeShellVorticityMass arrival state := by
  let receipts :=
    generatedIntegerShellReachableReceipts arrival
  have pathCauchy :=
    list_map_sum_sq_le_sum_mul_sum_of_sq_le_mul
      receipts
      (fun receipt =>
        generatedIntegerShellReceiptStateVelocityMajorant
          receipt state)
      (fun receipt =>
        biotSavartSerrinConstant *
          generatedIntegerShellReceiptReciprocalCardWeight receipt)
      (fun receipt =>
        generatedIntegerShellReceiptWholeShellVorticityMass
          receipt state)
      (fun receipt receiptMem =>
        mul_nonneg biotSavartSerrinConstant_nonneg
          (generatedIntegerShellReceiptReciprocalCardWeight_nonneg
            receipt))
      (fun receipt receiptMem =>
        generatedIntegerShellReceiptWholeShellVorticityMass_nonneg
          receipt state)
      (fun receipt receiptMem =>
        generatedIntegerShellReceiptStateVelocityMajorant_sq_le
          receipt state)
  rw [list_map_sum_const_mul] at pathCauchy
  exact pathCauchy

/-- The complete actual shell field of a common state is pointwise bounded
by its chronological path majorant. -/
theorem
    generatedIntegerShellReachableStatePhysicalVelocityField_norm_le_majorant
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (state : IntegerWavevector → ComplexCoordinateVector)
    (x : PhysicalSpace) :
    ‖generatedIntegerShellReachableStatePhysicalVelocityField
        arrival state x‖ ≤
      generatedIntegerShellReachableStateVelocityMajorant
        arrival state := by
  let receipts :=
    generatedIntegerShellReachableReceipts arrival
  calc
    ‖generatedIntegerShellReachableStatePhysicalVelocityField
        arrival state x‖ =
        ‖(receipts.map fun receipt =>
          generatedIntegerShellReceiptStatePhysicalVelocityField
            receipt state x).sum‖ := by
      rw [generatedIntegerShellReachableStatePhysicalVelocityField,
        list_sum_apply]
      simp [List.map_map, Function.comp_def, receipts]
    _ ≤
        ((receipts.map fun receipt =>
          generatedIntegerShellReceiptStatePhysicalVelocityField
            receipt state x).map norm).sum :=
      norm_list_sum_le_sum_norm _
    _ ≤
        (receipts.map fun receipt =>
          generatedIntegerShellReceiptStateVelocityMajorant
            receipt state).sum := by
      rw [List.map_map]
      apply List.sum_le_sum
      intro receipt receiptMembership
      exact
        finiteRealComplexFourierField_norm_le_velocityMajorant
          receipt.wholeShellModes
          (fun wave =>
            biotSavartVelocityCoefficient wave (state wave))
          x
    _ =
        generatedIntegerShellReachableStateVelocityMajorant
          arrival state := by
      rfl

/--
State-generic/path-indexed endpoint-Serrin geometry.  The source-generated
path owns every shell and reciprocal weight; `state` is any common
vorticity carrier, including each time slice of a downstream trajectory.
The RHS uses the complete whole-shell mass, so no hidden coordinate-support
invariance, transversality, shell coverage, or trajectory premise is needed.
-/
theorem generatedIntegerShellReachable_wholeShellStateSerrinGeometry
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (state : IntegerWavevector → ComplexCoordinateVector)
    (x : PhysicalSpace) :
    ‖generatedIntegerShellReachableStatePhysicalVelocityField
        arrival state x‖ ^ 2 ≤
      biotSavartSerrinConstant *
        generatedIntegerShellReachableReciprocalCardWeight arrival *
        pathWholeShellVorticityMass arrival state := by
  exact
    ((sq_le_sq₀
      (norm_nonneg _)
      (generatedIntegerShellReachableStateVelocityMajorant_nonneg
        arrival state)).mpr
      (generatedIntegerShellReachableStatePhysicalVelocityField_norm_le_majorant
        arrival state x)).trans
      (generatedIntegerShellReachableStateVelocityMajorant_sq_le
        arrival state)

/-! ## Embedding the generated shell mass into the endpoint carrier -/

/-- Every historical whole shell of an actual generated path is present in
the endpoint source support. -/
theorem
    generatedIntegerShellReachable_receipt_wholeShell_subset_endpointSupport
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    {receipt : GeneratedIntegerShellReceipt}
    (receiptMem :
      receipt ∈ generatedIntegerShellReachableReceipts arrival) :
    receipt.wholeShellModes ⊆ generatedSupport current := by
  induction arrival generalizing receipt with
  | initial =>
      simp [generatedIntegerShellReachableReceipts] at receiptMem
  | @step prior arrival response generated inductionHypothesis =>
      let lastReceipt : GeneratedIntegerShellReceipt :=
        ⟨prior, response, generated⟩
      rw [generatedIntegerShellReachableReceipts_step,
        List.concat_eq_append] at receiptMem
      simp only [List.mem_append, List.mem_singleton] at receiptMem
      rcases receiptMem with priorMem | lastReceiptEq
      · intro wave waveMem
        have priorSupport :
            wave ∈ generatedSupport prior :=
          inductionHypothesis priorMem waveMem
        change wave ∈ generatedSupport lastReceipt.next
        rw [lastReceipt.next_eq_extension,
          extendByGeneratedNonlinearShell_generatedSupport,
          extendByGeneratedNonlinearShell_activeModes]
        exact Finset.mem_union_left _ priorSupport
      · subst receipt
        intro wave waveMem
        change wave ∈ generatedSupport lastReceipt.next
        rw [lastReceipt.next_eq_extension,
          extendByGeneratedNonlinearShell_generatedSupport,
          extendByGeneratedNonlinearShell_activeModes]
        exact Finset.mem_union_right _ waveMem

/-- Distinct receipts of an actual generated path occupy disjoint whole
integer shells. -/
theorem generatedIntegerShellReachable_wholeShellModes_pairwise_disjoint
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current) :
    ((generatedIntegerShellReachableReceipts arrival).map
      fun receipt => receipt.wholeShellModes).Pairwise Disjoint := by
  have receiptShellsPairwise :
      (generatedIntegerShellReachableReceipts arrival).Pairwise
        (fun left right =>
          left.selectedShellSq < right.selectedShellSq) := by
    have shellPairwise :=
      generatedIntegerShellReachableShells_pairwise_lt arrival
    rw [←
      generatedIntegerShellReachableReceipts_map_selectedShellSq
        arrival] at shellPairwise
    simpa only [List.pairwise_map] using shellPairwise
  rw [List.pairwise_map]
  exact receiptShellsPairwise.imp fun {left right} shellLt => by
    rw [Finset.disjoint_left]
    intro wave leftMem rightMem
    have leftShell :
        integerWaveShellSq wave =
          left.selectedShellSq :=
      ((mem_generatedOuterNonlinearShellModes_iff
        left.current left.selectedShellSq wave).mp leftMem).2
    have rightShell :
        integerWaveShellSq wave =
          right.selectedShellSq :=
      ((mem_generatedOuterNonlinearShellModes_iff
        right.current right.selectedShellSq wave).mp rightMem).2
    omega

theorem
    list_sum_finset_sum_le_sum_of_pairwise_disjoint_of_subset
    {α : Type}
    [DecidableEq α]
    (sets : List (Finset α))
    (ambient : Finset α)
    (value : α → ℝ)
    (value_nonneg : ∀ index, 0 ≤ value index)
    (pairwise : sets.Pairwise Disjoint)
    (subsets :
      ∀ indices ∈ sets, indices ⊆ ambient) :
    (sets.map fun indices =>
      ∑ index ∈ indices, value index).sum ≤
        ∑ index ∈ ambient, value index := by
  induction sets generalizing ambient with
  | nil =>
      simp [Finset.sum_nonneg fun _ _ => value_nonneg _]
  | cons head tail inductionHypothesis =>
      rw [List.pairwise_cons] at pairwise
      have headSubset : head ⊆ ambient :=
        subsets head (by simp)
      have tailSubsetDifference :
          ∀ indices ∈ tail,
            indices ⊆ ambient \ head := by
        intro indices indicesMem index indexMem
        have indexUniverse :
            index ∈ ambient :=
          subsets indices (by simp [indicesMem]) indexMem
        have indexNotHead : index ∉ head := by
          intro indexHead
          exact
            (Finset.disjoint_left.mp
              (pairwise.1 indices indicesMem))
              indexHead indexMem
        exact Finset.mem_sdiff.mpr
          ⟨indexUniverse, indexNotHead⟩
      have tailBound :=
        inductionHypothesis
          (ambient \ head)
          pairwise.2
          tailSubsetDifference
      calc
        ((head :: tail).map fun indices =>
          ∑ index ∈ indices, value index).sum =
            (∑ index ∈ head, value index) +
              (tail.map fun indices =>
                ∑ index ∈ indices, value index).sum := by
          simp
        _ ≤
            (∑ index ∈ head, value index) +
              ∑ index ∈ ambient \ head,
                value index :=
          add_le_add_right tailBound _
        _ =
            ∑ index ∈ head ∪ (ambient \ head),
              value index := by
          rw [Finset.sum_union]
          exact Finset.disjoint_sdiff
        _ =
            ∑ index ∈ ambient, value index := by
          rw [Finset.union_sdiff_of_subset headSubset]

/-- Total squared vorticity mass on the finite endpoint source carrier. -/
def endpointGeneratedSupportVorticityMass
    (current : RawVorticityFourierSource)
    (state : IntegerWavevector → ComplexCoordinateVector) : ℝ :=
  ∑ wave ∈ generatedSupport current,
    complexCoordinateAmplitudeSq (state wave)

theorem endpointGeneratedSupportVorticityMass_nonneg
    (current : RawVorticityFourierSource)
    (state : IntegerWavevector → ComplexCoordinateVector) :
    0 ≤ endpointGeneratedSupportVorticityMass current state := by
  exact Finset.sum_nonneg fun _ _ =>
    complexCoordinateAmplitudeSq_nonneg _

/--
No generated shell mass is lost outside the endpoint carrier: pairwise
disjointness prevents double counting, and actual path write-back supplies
the endpoint-support inclusion.
-/
theorem pathWholeShellVorticityMass_le_endpointGeneratedSupport
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (state : IntegerWavevector → ComplexCoordinateVector) :
    pathWholeShellVorticityMass arrival state ≤
      endpointGeneratedSupportVorticityMass current state := by
  simpa [pathWholeShellVorticityMass,
    generatedIntegerShellReceiptWholeShellVorticityMass,
    endpointGeneratedSupportVorticityMass,
    List.map_map, Function.comp_def] using
    list_sum_finset_sum_le_sum_of_pairwise_disjoint_of_subset
      ((generatedIntegerShellReachableReceipts arrival).map
        fun receipt => receipt.wholeShellModes)
      (generatedSupport current)
      (fun wave =>
        complexCoordinateAmplitudeSq (state wave))
      (fun wave =>
        complexCoordinateAmplitudeSq_nonneg _)
      (generatedIntegerShellReachable_wholeShellModes_pairwise_disjoint
        arrival)
      (fun modes modesMem => by
        rcases List.mem_map.mp modesMem with
          ⟨receipt, receiptMem, rfl⟩
        exact
          generatedIntegerShellReachable_receipt_wholeShell_subset_endpointSupport
            arrival receiptMem)

/--
Direct endpoint-carrier form of the state-generic Serrin envelope.  This is
the bridge consumed by a downstream energy-dissipation or Parseval theorem:
the generated scale word fixes the reciprocal-shell geometry, while the
target state contributes only its actual finite endpoint vorticity mass.
-/
theorem
    generatedIntegerShellReachable_wholeShellStateSerrinGeometry_le_endpointMass
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (state : IntegerWavevector → ComplexCoordinateVector)
    (x : PhysicalSpace) :
    ‖generatedIntegerShellReachableStatePhysicalVelocityField
        arrival state x‖ ^ 2 ≤
      biotSavartSerrinConstant *
        generatedIntegerShellReachableReciprocalCardWeight arrival *
        endpointGeneratedSupportVorticityMass current state := by
  calc
    ‖generatedIntegerShellReachableStatePhysicalVelocityField
        arrival state x‖ ^ 2 ≤
        biotSavartSerrinConstant *
          generatedIntegerShellReachableReciprocalCardWeight arrival *
          pathWholeShellVorticityMass arrival state :=
      generatedIntegerShellReachable_wholeShellStateSerrinGeometry
        arrival state x
    _ ≤
        biotSavartSerrinConstant *
          generatedIntegerShellReachableReciprocalCardWeight arrival *
          endpointGeneratedSupportVorticityMass current state := by
      exact
        mul_le_mul_of_nonneg_left
          (pathWholeShellVorticityMass_le_endpointGeneratedSupport
            arrival state)
          (mul_nonneg biotSavartSerrinConstant_nonneg
            (generatedIntegerShellReachableReciprocalCardWeight_nonneg
              arrival))

end

