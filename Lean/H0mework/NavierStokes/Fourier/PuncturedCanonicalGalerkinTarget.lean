import H0mework.NavierStokes.Fourier.CanonicalExhaustiveGalerkinTarget

/-!
# Punctured canonical Galerkin target

The physical finite-trajectory producer uses Fourier mode sets which exclude
the zero vorticity wave.  This module therefore instantiates the genuine
infinite-row target on the canonical punctured cubes

```text
(integerWaveFrequencyCube radius).erase 0.
```

Every nonzero fixed wave is eventually retained.  On retained waves an
actual finite-mode trajectory satisfies the complete infinite nonlinear
Fourier row and its exact mild identity.  Membership is generated by lattice
exhaustion; no coverage certificate enters a theorem mouth.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalVorticityCoefficientPuncturedCanonicalGalerkinTarget

open scoped ENNReal Topology

open Set
open Filter
open ThreeDimensionalPeriodicIntegerCharacterCoarseFilter
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientFiniteSupportComplexTrajectory
open ThreeDimensionalVorticityCoefficientFiniteGalerkinMildDuhamel
open ThreeDimensionalVorticityCoefficientInfiniteFixedOutputNonlinearRow
open ThreeDimensionalVorticityCoefficientCanonicalExhaustiveGalerkinTarget

noncomputable section

/-- Canonical finite integer cube with the zero vorticity wave removed. -/
def puncturedIntegerWaveFrequencyCube
    (radius : ℕ) : Finset IntegerWavevector :=
  (integerWaveFrequencyCube radius).erase 0

@[simp] theorem zero_not_mem_puncturedIntegerWaveFrequencyCube
    (radius : ℕ) :
    (0 : IntegerWavevector) ∉
      puncturedIntegerWaveFrequencyCube radius := by
  simp [puncturedIntegerWaveFrequencyCube]

theorem puncturedIntegerWaveFrequencyCube_waveNeg_mem
    (radius : ℕ)
    {wave : IntegerWavevector}
    (waveMem :
      wave ∈ puncturedIntegerWaveFrequencyCube radius) :
    waveNeg wave ∈ puncturedIntegerWaveFrequencyCube radius := by
  rw [puncturedIntegerWaveFrequencyCube] at waveMem ⊢
  have waveNe : wave ≠ 0 := (Finset.mem_erase.mp waveMem).1
  have cubeMem := (Finset.mem_erase.mp waveMem).2
  rw [Finset.mem_erase]
  refine ⟨?_, ?_⟩
  · simpa using waveNe
  · rw [integerWaveFrequencyCube, Fintype.mem_piFinset] at cubeMem ⊢
    intro coordinate
    have coordinateMem := cubeMem coordinate
    rw [Finset.mem_Icc] at coordinateMem ⊢
    simp only [waveNeg_apply]
    constructor <;> omega

/-- Every fixed nonzero integer wave is eventually retained by the physical
punctured cube exhaustion. -/
theorem nonzero_integerWave_eventually_mem_puncturedFrequencyCube
    (wave : IntegerWavevector)
    (waveNe : wave ≠ 0) :
    ∀ᶠ radius : ℕ in atTop,
      wave ∈ puncturedIntegerWaveFrequencyCube radius := by
  filter_upwards
    [integerWave_eventually_mem_frequencyCube wave] with radius waveMem
  exact Finset.mem_erase.mpr ⟨waveNe, waveMem⟩

/-! ## Arbitrary finite-mode target compiler -/

/-- The infinite nonlinear row omitted by an arbitrary finite sharp
projection. -/
def finiteModesOmittedNonlinearDefectAt
    (modes : Finset IntegerWavevector)
    (state : ComplexVorticityHilbertState)
    (wave : IntegerWavevector) : ComplexCoordinateVector :=
  if wave ∈ modes then 0
  else wholeStateVorticityNonlinearCoefficientAt state wave

/-- A sharply supported finite Galerkin generator is the full infinite-row
tangent minus its explicit omitted nonlinear complement. -/
theorem finiteModes_generator_eq_wholeTangent_sub_omittedDefect
    (modes : Finset IntegerWavevector)
    (ν : ℝ)
    (state : ComplexVorticityHilbertState)
    (supported :
      ∀ wave : IntegerWavevector,
        wave ∉ modes → state wave = 0)
    (wave : IntegerWavevector) :
    finiteStateVorticityGenerator modes ν state wave =
      wholeLatticeVorticityFourierTangentAt ν state wave -
        finiteModesOmittedNonlinearDefectAt modes state wave := by
  have nonlinearEq :
      wholeStateVorticityNonlinearCoefficientAt state wave =
        finiteStateVorticityNonlinearCoefficientAt
          modes state wave :=
    wholeStateVorticityNonlinearCoefficientAt_eq_finite_of_supported
      modes state supported wave
  by_cases waveMem : wave ∈ modes
  · simp [finiteStateVorticityGenerator_apply,
      wholeLatticeVorticityFourierTangentAt,
      finiteModesOmittedNonlinearDefectAt,
      waveMem, nonlinearEq]
  · have stateZero := supported wave waveMem
    simp [finiteStateVorticityGenerator_apply,
      wholeLatticeVorticityFourierTangentAt,
      finiteModesOmittedNonlinearDefectAt,
      waveMem, stateZero]

/-- Every retained row of an actual arbitrary finite-mode trajectory already
satisfies the full infinite-row differential law. -/
theorem finiteModes_trajectoryWave_hasDerivAt_wholeTangent_of_mem
    (modes : Finset IntegerWavevector)
    (ν : ℝ)
    (trajectory : ℝ → ComplexVorticityHilbertState)
    (t : ℝ)
    (evolves :
      HasDerivAt trajectory
        (finiteStateVorticityGenerator
          modes ν (trajectory t)) t)
    (supported :
      ∀ wave : IntegerWavevector,
        wave ∉ modes → trajectory t wave = 0)
    (wave : IntegerWavevector)
    (waveMem : wave ∈ modes) :
    HasDerivAt
      (fun time => trajectory time wave)
      (wholeLatticeVorticityFourierTangentAt
        ν (trajectory t) wave)
      t := by
  have rowDerivative :=
    complexVorticityTrajectoryWave_hasDerivAt
      trajectory t
      (finiteStateVorticityGenerator
        modes ν (trajectory t))
      wave evolves
  rw [finiteModes_generator_eq_wholeTangent_sub_omittedDefect
    modes ν (trajectory t) supported wave] at rowDerivative
  simpa [finiteModesOmittedNonlinearDefectAt, waveMem] using
    rowDerivative

/-- The exact finite mild identity uses the genuine infinite nonlinear row
on every retained arbitrary finite mode. -/
theorem finiteModesWave_infiniteRow_mild_identity
    (modes : Finset IntegerWavevector)
    (wave : IntegerWavevector)
    (waveMem : wave ∈ modes)
    (ν : ℝ)
    (trajectory : ℝ → ComplexVorticityHilbertState)
    (a b : ℝ)
    (hab : a ≤ b)
    (evolves :
      ∀ t ∈ Icc a b,
        HasDerivAt trajectory
          (finiteStateVorticityGenerator
            modes ν (trajectory t)) t)
    (supported :
      ∀ t ∈ Icc a b,
        ∀ output : IntegerWavevector,
          output ∉ modes →
            trajectory t output = 0) :
    trajectory b wave =
      finiteStateVorticityHeatMultiplier ν (b - a) wave •
          trajectory a wave +
        ∫ t in a..b,
          finiteStateVorticityHeatMultiplier ν (b - t) wave •
            wholeStateVorticityNonlinearCoefficientAt
              (trajectory t) wave := by
  have finiteMild :=
    finiteGalerkinWave_mild_identity
      modes wave waveMem ν trajectory a b hab evolves
  rw [finiteMild]
  congr 1
  apply intervalIntegral.integral_congr
  intro t tMem
  have tInInterval : t ∈ Icc a b := by
    rwa [uIcc_of_le hab] at tMem
  change
    finiteStateVorticityHeatMultiplier ν (b - t) wave •
        finiteStateVorticityNonlinearCoefficientAt
          modes (trajectory t) wave =
      finiteStateVorticityHeatMultiplier ν (b - t) wave •
        wholeStateVorticityNonlinearCoefficientAt
          (trajectory t) wave
  rw [← wholeStateVorticityNonlinearCoefficientAt_eq_finite_of_supported
    modes (trajectory t) (supported t tInInterval) wave]

/-! ## Punctured exhaustive fixed-wave laws -/

theorem puncturedCube_trajectoryWave_eventually_hasDerivAt_wholeTangent
    (ν : ℝ)
    (trajectories : ℕ → ℝ → ComplexVorticityHilbertState)
    (t : ℝ)
    (evolves :
      ∀ radius,
        HasDerivAt (trajectories radius)
          (finiteStateVorticityGenerator
            (puncturedIntegerWaveFrequencyCube radius) ν
            (trajectories radius t))
          t)
    (supported :
      ∀ radius wave,
        wave ∉ puncturedIntegerWaveFrequencyCube radius →
          trajectories radius t wave = 0)
    (wave : IntegerWavevector)
    (waveNe : wave ≠ 0) :
    ∀ᶠ radius : ℕ in atTop,
      HasDerivAt
        (fun time => trajectories radius time wave)
        (wholeLatticeVorticityFourierTangentAt
          ν (trajectories radius t) wave)
        t := by
  filter_upwards
    [nonzero_integerWave_eventually_mem_puncturedFrequencyCube
      wave waveNe] with radius waveMem
  exact
    finiteModes_trajectoryWave_hasDerivAt_wholeTangent_of_mem
      (puncturedIntegerWaveFrequencyCube radius)
      ν (trajectories radius) t
      (evolves radius) (supported radius) wave waveMem

theorem puncturedCubeWave_eventually_infiniteRow_mild_identity
    (ν : ℝ)
    (trajectories : ℕ → ℝ → ComplexVorticityHilbertState)
    (a b : ℝ)
    (hab : a ≤ b)
    (evolves :
      ∀ radius t, t ∈ Icc a b →
        HasDerivAt (trajectories radius)
          (finiteStateVorticityGenerator
            (puncturedIntegerWaveFrequencyCube radius) ν
            (trajectories radius t)) t)
    (supported :
      ∀ radius t, t ∈ Icc a b →
        ∀ output : IntegerWavevector,
          output ∉ puncturedIntegerWaveFrequencyCube radius →
            trajectories radius t output = 0)
    (wave : IntegerWavevector)
    (waveNe : wave ≠ 0) :
    ∀ᶠ radius : ℕ in atTop,
      trajectories radius b wave =
        finiteStateVorticityHeatMultiplier ν (b - a) wave •
            trajectories radius a wave +
          ∫ t in a..b,
            finiteStateVorticityHeatMultiplier ν (b - t) wave •
              wholeStateVorticityNonlinearCoefficientAt
                (trajectories radius t) wave := by
  filter_upwards
    [nonzero_integerWave_eventually_mem_puncturedFrequencyCube
      wave waveNe] with radius waveMem
  exact
    finiteModesWave_infiniteRow_mild_identity
      (puncturedIntegerWaveFrequencyCube radius)
      wave waveMem ν (trajectories radius) a b hab
      (fun t tMem => evolves radius t tMem)
      (fun t tMem => supported radius t tMem)

end

end ThreeDimensionalVorticityCoefficientPuncturedCanonicalGalerkinTarget
