import H0mework.Realization.Residual.PathTransport
import H0mework.NavierStokes.FiniteVorticity.DoubleTriadActual

/-!
# Two native spectral cutoffs and their trace telescope

The connected double triad has two genuinely different adjacent sharp
cutoffs:

```text
full support
  -- P₅ --> squared norm ≤ 5
  -- P₂ --> squared norm ≤ 2.
```

The common residual carrier keeps three responsibilities separate:

```text
(base closure, middle trace, upper trace).
```

Here the upper trace is retained on the full `P₅` carrier instead of being
prematurely projected to `P₂`.  This is essential: its independent energy
consumer needs both retained coordinates.  Assembly projects that component
only when reconstructing the final `P₂` Galerkin tangent.

The two filters are native typed arrows.  Their actual update laws generate
a path-indexed residual transport, so the two-step trace cocycle and
live/memory write-back follow from the existing path machinery rather than
from a stored telescope premise.
-/

namespace SaturationMonoid.NavierStokes
namespace TwoDimensionalVorticityDoubleTriadNestedResidualTransport

noncomputable section

open AffineRelaxation
open ResidualProjection
open TwoDimensionalVorticityTriadActual
open TwoDimensionalVorticityDoubleTriadActual

/-! ## The two sharp spectral projectors -/

/-- Sharp `|k|² ≤ 5` projector. -/
def doubleTriadMiddlePass :
    DoubleTriadState →ₗ[ℚ] DoubleTriadState where
  toFun state := ![state 0, state 1, state 2, 0]
  map_add' := by
    intro left right
    funext mode
    fin_cases mode <;> simp
  map_smul' := by
    intro scalar state
    funext mode
    fin_cases mode <;> simp

/-- Sharp `|k|² ≤ 2` projector. -/
def doubleTriadLowPass :
    DoubleTriadState →ₗ[ℚ] DoubleTriadState where
  toFun state := ![state 0, state 1, 0, 0]
  map_add' := by
    intro left right
    funext mode
    fin_cases mode <;> simp
  map_smul' := by
    intro scalar state
    funext mode
    fin_cases mode <;> simp

theorem doubleTriadMiddlePass_eq_normSqCutoff
    (state : DoubleTriadState) (mode : Fin 4) :
    doubleTriadMiddlePass state mode =
      if waveNormSq (positiveDoubleTriadWave mode) ≤ 5
      then state mode
      else 0 := by
  fin_cases mode <;>
    simp [doubleTriadMiddlePass, positiveDoubleTriadWave,
      waveNormSq, doubleTriadWaveZero, doubleTriadWaveOne,
      doubleTriadWaveTwo, doubleTriadWaveThree]

theorem doubleTriadLowPass_eq_normSqCutoff
    (state : DoubleTriadState) (mode : Fin 4) :
    doubleTriadLowPass state mode =
      if waveNormSq (positiveDoubleTriadWave mode) ≤ 2
      then state mode
      else 0 := by
  fin_cases mode <;>
    norm_num [doubleTriadLowPass, positiveDoubleTriadWave,
      waveNormSq, doubleTriadWaveZero, doubleTriadWaveOne,
      doubleTriadWaveTwo, doubleTriadWaveThree]

@[simp] theorem doubleTriadMiddlePass_idempotent
    (state : DoubleTriadState) :
    doubleTriadMiddlePass (doubleTriadMiddlePass state) =
      doubleTriadMiddlePass state := by
  funext mode
  fin_cases mode <;> rfl

@[simp] theorem doubleTriadLowPass_idempotent
    (state : DoubleTriadState) :
    doubleTriadLowPass (doubleTriadLowPass state) =
      doubleTriadLowPass state := by
  funext mode
  fin_cases mode <;> rfl

@[simp] theorem doubleTriadLowPass_middlePass
    (state : DoubleTriadState) :
    doubleTriadLowPass (doubleTriadMiddlePass state) =
      doubleTriadLowPass state := by
  funext mode
  fin_cases mode <;> rfl

@[simp] theorem doubleTriadMiddlePass_lowPass
    (state : DoubleTriadState) :
    doubleTriadMiddlePass (doubleTriadLowPass state) =
      doubleTriadLowPass state := by
  funext mode
  fin_cases mode <;> rfl

/-! ## Actual adjacent-scale residuals -/

/-- Final `P₂` closure tangent. -/
def doubleTriadBaseClosure
    (ν : ℚ) (state : DoubleTriadState) : DoubleTriadState :=
  doubleTriadLowPass
    (doubleTriadNavierStokesGalerkinGenerator ν
      (doubleTriadLowPass state))

/-- Native trace generated by the `P₅ → P₂` update. -/
def doubleTriadMiddleTrace
    (ν : ℚ) (state : DoubleTriadState) : DoubleTriadState :=
  doubleTriadLowPass
      (doubleTriadNavierStokesGalerkinGenerator ν
        (doubleTriadMiddlePass state)) -
    doubleTriadBaseClosure ν state

/-- Native trace generated by the `full → P₅` update, retained on the
complete `P₅` carrier. -/
def doubleTriadUpperTrace
    (ν : ℚ) (state : DoubleTriadState) : DoubleTriadState :=
  doubleTriadMiddlePass
      (doubleTriadNavierStokesGalerkinGenerator ν state) -
    doubleTriadMiddlePass
      (doubleTriadNavierStokesGalerkinGenerator ν
        (doubleTriadMiddlePass state))

theorem doubleTriadBaseClosure_coordinates
    (ν : ℚ) (state : DoubleTriadState) :
    doubleTriadBaseClosure ν state =
      ![-ν * state 0, -(2 * ν) * state 1, 0, 0] := by
  funext mode
  fin_cases mode <;>
    simp [doubleTriadBaseClosure, doubleTriadLowPass,
      doubleTriadNavierStokesGalerkinGenerator,
      doubleTriadNonlinearGenerator_coordinates,
      doubleTriadViscousGenerator]

theorem doubleTriadMiddleTrace_coordinates
    (ν : ℚ) (state : DoubleTriadState) :
    doubleTriadMiddleTrace ν state =
      ![(-3 / 10 : ℚ) * state 1 * state 2,
        (4 / 5 : ℚ) * state 0 * state 2, 0, 0] := by
  funext mode
  fin_cases mode <;>
    simp [doubleTriadMiddleTrace, doubleTriadBaseClosure_coordinates,
      doubleTriadMiddlePass, doubleTriadLowPass,
      doubleTriadNavierStokesGalerkinGenerator,
      doubleTriadNonlinearGenerator_coordinates,
      doubleTriadViscousGenerator]

theorem doubleTriadUpperTrace_coordinates
    (ν : ℚ) (state : DoubleTriadState) :
    doubleTriadUpperTrace ν state =
      ![(-1 / 10 : ℚ) * state 2 * state 3, 0,
        (9 / 10 : ℚ) * state 0 * state 3, 0] := by
  funext mode
  fin_cases mode <;>
    simp [doubleTriadUpperTrace, doubleTriadMiddlePass,
      doubleTriadNavierStokesGalerkinGenerator,
      doubleTriadNonlinearGenerator_coordinates,
      doubleTriadViscousGenerator]

theorem doubleTriadMiddleTrace_independent_of_viscosity
    (ν : ℚ) (state : DoubleTriadState) :
    doubleTriadMiddleTrace ν state =
      doubleTriadMiddleTrace 0 state := by
  rw [doubleTriadMiddleTrace_coordinates,
    doubleTriadMiddleTrace_coordinates]

theorem doubleTriadUpperTrace_independent_of_viscosity
    (ν : ℚ) (state : DoubleTriadState) :
    doubleTriadUpperTrace ν state =
      doubleTriadUpperTrace 0 state := by
  rw [doubleTriadUpperTrace_coordinates,
    doubleTriadUpperTrace_coordinates]

theorem doubleTriadBaseClosure_middlePass
    (ν : ℚ) (state : DoubleTriadState) :
    doubleTriadBaseClosure ν (doubleTriadMiddlePass state) =
      doubleTriadBaseClosure ν state := by
  rw [doubleTriadBaseClosure_coordinates,
    doubleTriadBaseClosure_coordinates]
  funext mode
  fin_cases mode <;> rfl

theorem doubleTriadBaseClosure_lowPass
    (ν : ℚ) (state : DoubleTriadState) :
    doubleTriadBaseClosure ν (doubleTriadLowPass state) =
      doubleTriadBaseClosure ν state := by
  rw [doubleTriadBaseClosure_coordinates,
    doubleTriadBaseClosure_coordinates]
  funext mode
  fin_cases mode <;> rfl

theorem doubleTriadMiddleTrace_middlePass
    (ν : ℚ) (state : DoubleTriadState) :
    doubleTriadMiddleTrace ν (doubleTriadMiddlePass state) =
      doubleTriadMiddleTrace ν state := by
  rw [doubleTriadMiddleTrace_coordinates,
    doubleTriadMiddleTrace_coordinates]
  funext mode
  fin_cases mode <;> rfl

@[simp] theorem doubleTriadMiddleTrace_lowPass
    (ν : ℚ) (state : DoubleTriadState) :
    doubleTriadMiddleTrace ν (doubleTriadLowPass state) = 0 := by
  rw [doubleTriadMiddleTrace_coordinates]
  funext mode
  fin_cases mode <;> simp [doubleTriadLowPass]

@[simp] theorem doubleTriadUpperTrace_middlePass
    (ν : ℚ) (state : DoubleTriadState) :
    doubleTriadUpperTrace ν (doubleTriadMiddlePass state) = 0 := by
  rw [doubleTriadUpperTrace_coordinates]
  funext mode
  fin_cases mode <;> simp [doubleTriadMiddlePass]

@[simp] theorem doubleTriadUpperTrace_lowPass
    (ν : ℚ) (state : DoubleTriadState) :
    doubleTriadUpperTrace ν (doubleTriadLowPass state) = 0 := by
  rw [doubleTriadUpperTrace_coordinates]
  funext mode
  fin_cases mode <;> simp [doubleTriadLowPass]

/-! ## Common three-component carrier and its two keeps -/

abbrev DoubleTriadNestedLedger :=
  DoubleTriadState × DoubleTriadState × DoubleTriadState

/-- The upper update settles only the upper trace. -/
def doubleTriadMiddleKeep :
    DoubleTriadNestedLedger →ₗ[ℚ] DoubleTriadNestedLedger where
  toFun ledger := (ledger.1, ledger.2.1, 0)
  map_add' := by
    intro left right
    ext <;> simp
  map_smul' := by
    intro scalar ledger
    ext <;> simp

/-- The lower update settles both adjacent trace coordinates. -/
def doubleTriadLowKeep :
    DoubleTriadNestedLedger →ₗ[ℚ] DoubleTriadNestedLedger where
  toFun ledger := (ledger.1, 0, 0)
  map_add' := by
    intro left right
    ext <;> simp
  map_smul' := by
    intro scalar ledger
    ext <;> simp

def doubleTriadNestedResidual
    (ν : ℚ) (state : DoubleTriadState) :
    DoubleTriadNestedLedger :=
  (doubleTriadBaseClosure ν state,
    doubleTriadMiddleTrace ν state,
    doubleTriadUpperTrace ν state)

theorem doubleTriadNestedResidual_middlePass
    (ν : ℚ) (state : DoubleTriadState) :
    doubleTriadNestedResidual ν (doubleTriadMiddlePass state) =
      doubleTriadMiddleKeep
        (doubleTriadNestedResidual ν state) := by
  simp [doubleTriadNestedResidual, doubleTriadMiddleKeep,
    doubleTriadBaseClosure_middlePass,
    doubleTriadMiddleTrace_middlePass]

theorem doubleTriadNestedResidual_lowPass
    (ν : ℚ) (state : DoubleTriadState) :
    doubleTriadNestedResidual ν (doubleTriadLowPass state) =
      doubleTriadLowKeep
        (doubleTriadNestedResidual ν state) := by
  simp [doubleTriadNestedResidual, doubleTriadLowKeep,
    doubleTriadBaseClosure_lowPass]

theorem doubleTriadLowKeep_comp_middleKeep :
    doubleTriadLowKeep.comp doubleTriadMiddleKeep =
      doubleTriadLowKeep := by
  apply LinearMap.ext
  intro ledger
  rfl

/-! ## Native typed scale path -/

inductive DoubleTriadScaleEdge
    (source : DoubleTriadState) :
    DoubleTriadState → Type
  | middle :
      DoubleTriadScaleEdge source
        (doubleTriadMiddlePass source)
  | low :
      DoubleTriadScaleEdge source
        (doubleTriadLowPass source)

@[reducible] def doubleTriadScaleQuiver :
    Quiver DoubleTriadState where
  Hom := DoubleTriadScaleEdge

local instance doubleTriadScaleQuiverLocal :
    Quiver DoubleTriadState :=
  doubleTriadScaleQuiver

namespace DoubleTriadScaleEdge

def keep
    {source target : DoubleTriadState}
    (edge : DoubleTriadScaleEdge source target) :
    DoubleTriadNestedLedger →ₗ[ℚ] DoubleTriadNestedLedger :=
  match edge with
  | .middle => doubleTriadMiddleKeep
  | .low => doubleTriadLowKeep

def toPath
    {source target : DoubleTriadState}
    (edge : source ⟶ target) :
    Quiver.Path source target :=
  .cons .nil edge

end DoubleTriadScaleEdge

def doubleTriadNestedPathTransport
    (ν : ℚ) :
    PathIndexedResidualTransport ℚ
      DoubleTriadNestedLedger DoubleTriadState where
  residual := doubleTriadNestedResidual ν
  edgeKeep := DoubleTriadScaleEdge.keep
  edge_residual_transport := by
    intro source target edge
    change DoubleTriadScaleEdge source target at edge
    cases edge with
    | middle =>
        exact doubleTriadNestedResidual_middlePass ν source
    | low =>
        exact doubleTriadNestedResidual_lowPass ν source

def doubleTriadMiddlePath
    (state : DoubleTriadState) :
    Quiver.Path state (doubleTriadMiddlePass state) :=
  DoubleTriadScaleEdge.toPath .middle

def doubleTriadLowPath
    (state : DoubleTriadState) :
    Quiver.Path state (doubleTriadLowPass state) :=
  DoubleTriadScaleEdge.toPath .low

/-- The genuine two-edge cutoff path. -/
def doubleTriadTwoScalePath
    (state : DoubleTriadState) :
    Quiver.Path state
      (doubleTriadLowPass (doubleTriadMiddlePass state)) :=
  (doubleTriadMiddlePath state).comp
    (doubleTriadLowPath (doubleTriadMiddlePass state))

theorem doubleTriadMiddlePath_actual_update
    (ν : ℚ) (state : DoubleTriadState) :
    (doubleTriadNestedPathTransport ν).residual
        (doubleTriadMiddlePass state) =
      (doubleTriadNestedPathTransport ν).pathKeep
        (doubleTriadMiddlePath state)
        ((doubleTriadNestedPathTransport ν).residual state) :=
  (doubleTriadNestedPathTransport ν).residual_path_transport
    (doubleTriadMiddlePath state)

theorem doubleTriadTwoScalePath_actual_update
    (ν : ℚ) (state : DoubleTriadState) :
    (doubleTriadNestedPathTransport ν).residual
        (doubleTriadLowPass (doubleTriadMiddlePass state)) =
      (doubleTriadNestedPathTransport ν).pathKeep
        (doubleTriadTwoScalePath state)
        ((doubleTriadNestedPathTransport ν).residual state) :=
  (doubleTriadNestedPathTransport ν).residual_path_transport
    (doubleTriadTwoScalePath state)

/-! ## Generated trace cocycle and write-back -/

theorem doubleTriadMiddlePath_trace
    (ν : ℚ) (state : DoubleTriadState) :
    (doubleTriadNestedPathTransport ν).pathTrace
        (doubleTriadMiddlePath state) =
      (0, 0, doubleTriadUpperTrace ν state) := by
  simp [PathIndexedResidualTransport.pathTrace,
    PathIndexedResidualTransport.pathTraceAt,
    linearResidualTrace, doubleTriadMiddlePath,
    DoubleTriadScaleEdge.toPath,
    doubleTriadNestedPathTransport,
    DoubleTriadScaleEdge.keep,
    doubleTriadMiddleKeep, doubleTriadNestedResidual]

theorem doubleTriadLowAfterMiddlePath_trace
    (ν : ℚ) (state : DoubleTriadState) :
    (doubleTriadNestedPathTransport ν).pathTrace
        (doubleTriadLowPath (doubleTriadMiddlePass state)) =
      (0, doubleTriadMiddleTrace ν state, 0) := by
  rw [(doubleTriadNestedPathTransport ν).pathTrace_eq_source_sub_target]
  change
    doubleTriadNestedResidual ν (doubleTriadMiddlePass state) -
        doubleTriadNestedResidual ν
          (doubleTriadLowPass (doubleTriadMiddlePass state)) =
      (0, doubleTriadMiddleTrace ν state, 0)
  rw [doubleTriadNestedResidual_lowPass,
    doubleTriadNestedResidual_middlePass]
  simp [doubleTriadLowKeep, doubleTriadMiddleKeep,
    doubleTriadNestedResidual]

theorem doubleTriadTwoScalePath_trace
    (ν : ℚ) (state : DoubleTriadState) :
    (doubleTriadNestedPathTransport ν).pathTrace
        (doubleTriadTwoScalePath state) =
      (0, doubleTriadMiddleTrace ν state,
        doubleTriadUpperTrace ν state) := by
  rw [doubleTriadTwoScalePath,
    (doubleTriadNestedPathTransport ν).pathTrace_comp,
    doubleTriadMiddlePath_trace,
    doubleTriadLowAfterMiddlePath_trace]
  ext <;> simp

theorem doubleTriadTwoScalePath_writeBack
    (ν : ℚ) (state : DoubleTriadState) :
    (doubleTriadNestedPathTransport ν).pathWriteBack
        (doubleTriadTwoScalePath state) =
      ((doubleTriadBaseClosure ν state, 0, 0),
        (0, doubleTriadMiddleTrace ν state,
          doubleTriadUpperTrace ν state)) := by
  apply Prod.ext
  · change
      doubleTriadNestedResidual ν
          (doubleTriadLowPass (doubleTriadMiddlePass state)) =
        (doubleTriadBaseClosure ν state, 0, 0)
    rw [doubleTriadNestedResidual_lowPass,
      doubleTriadNestedResidual_middlePass]
    rfl
  · exact doubleTriadTwoScalePath_trace ν state

theorem doubleTriadTwoScalePath_recollects_source
    (ν : ℚ) (state : DoubleTriadState) :
    residualTraceWriteBackRecollection (K := ℚ)
        ((doubleTriadNestedPathTransport ν).pathWriteBack
          (doubleTriadTwoScalePath state)) =
      doubleTriadNestedResidual ν state :=
  (doubleTriadNestedPathTransport ν).pathWriteBack_recollects_source
    (doubleTriadTwoScalePath state)

/-! ## Assembly and the exact Germano telescope -/

/-- Assemble the final low closure, the native middle trace, and the
low projection of the native upper trace. -/
def doubleTriadNestedLedgerAssemble :
    DoubleTriadNestedLedger →ₗ[ℚ] DoubleTriadState where
  toFun ledger :=
    ledger.1 + ledger.2.1 +
      doubleTriadLowPass ledger.2.2
  map_add' := by
    intro left right
    simp
    abel
  map_smul' := by
    intro scalar ledger
    simp [smul_add]

theorem doubleTriadNestedResidual_assembles_lowProjectedGenerator
    (ν : ℚ) (state : DoubleTriadState) :
    doubleTriadNestedLedgerAssemble
        (doubleTriadNestedResidual ν state) =
      doubleTriadLowPass
        (doubleTriadNavierStokesGalerkinGenerator ν state) := by
  simp [doubleTriadNestedLedgerAssemble,
    doubleTriadNestedResidual, doubleTriadBaseClosure,
    doubleTriadMiddleTrace, doubleTriadUpperTrace,
    map_sub]

def doubleTriadDirectLowCommutator
    (ν : ℚ) (state : DoubleTriadState) : DoubleTriadState :=
  doubleTriadLowPass
      (doubleTriadNavierStokesGalerkinGenerator ν state) -
    doubleTriadBaseClosure ν state

/-- Exact two-cutoff Germano identity.  It is derived from the native
commutator definitions and nested projectors. -/
theorem doubleTriadDirectLowCommutator_telescope
    (ν : ℚ) (state : DoubleTriadState) :
    doubleTriadDirectLowCommutator ν state =
      doubleTriadMiddleTrace ν state +
        doubleTriadLowPass (doubleTriadUpperTrace ν state) := by
  simp [doubleTriadDirectLowCommutator,
    doubleTriadMiddleTrace, doubleTriadUpperTrace,
    doubleTriadBaseClosure, map_sub]

/-- Assembly of the written memory is exactly the direct low commutator. -/
theorem doubleTriadTwoScale_writtenMemory_assembles_directCommutator
    (ν : ℚ) (state : DoubleTriadState) :
    doubleTriadNestedLedgerAssemble
        ((doubleTriadNestedPathTransport ν).pathWriteBack
          (doubleTriadTwoScalePath state)).2 =
      doubleTriadDirectLowCommutator ν state := by
  rw [doubleTriadTwoScalePath_writeBack]
  simp [doubleTriadNestedLedgerAssemble,
    doubleTriadDirectLowCommutator_telescope]

end

end TwoDimensionalVorticityDoubleTriadNestedResidualTransport
end SaturationMonoid.NavierStokes
