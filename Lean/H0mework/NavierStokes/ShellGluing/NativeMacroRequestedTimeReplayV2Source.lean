open ThreeDimensionalVorticityCoefficientFiniteSupportRealityTrajectory
open
  ThreeDimensionalVorticityCoefficientFiniteGalerkinKineticCommonTimeExistence
open ThreeDimensionalVorticityCoefficientFinitePhysicalStateSupportLift
open
  ThreeDimensionalVorticityCoefficientGeneratedShellGluingResidualNativeMacroRedirectRuntime
open
  ThreeDimensionalVorticityCoefficientGeneratedShellGluingResidualNativeMacroRedirectRuntime.GeneratedRedirectedCompleteRoundInfiniteLineage
open
  ThreeDimensionalVorticityCoefficientGeneratedShellGluingResidualNativeMacroWholeResidualCriticalLineage
open
  ThreeDimensionalVorticityCoefficientGeneratedShellGluingResidualNativeMacroWholeResidualCommonTimeReplay
open
  ThreeDimensionalVorticityCoefficientGeneratedShellGluingResidualNativeMacroRequestedTimeReplaySource

noncomputable section

/-- The V2 source keeps the established full-time residual carrier. -/
abbrev GeneratedRequestedTimeReplayV2Stage
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (requestedTime : ℝ) :=
  GeneratedRequestedTimeReplayStage lineage requestedTime

namespace GeneratedRequestedTimeReplayV2Stage

/--
Construct a requested-time stage from one source-owned finite inventory.
The physical path is generated by unconditional finite Galerkin existence.
-/
private noncomputable def ofModes
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (requestedTime : ℝ)
    (requestedTimePos : 0 < requestedTime)
    (modes : Finset IntegerWavevector)
    (initialModesSubset :
      lineageReceiptModes lineage 0 ⊆ modes)
    (zeroNotMem : (0 : IntegerWavevector) ∉ modes)
    (negClosed :
      ∀ wave, wave ∈ modes → waveNeg wave ∈ modes) :
    GeneratedRequestedTimeReplayV2Stage lineage requestedTime := by
  have initialSupported :
      ∀ wave, wave ∉ modes →
        commonTimeReplayInitialState lineage wave = 0 :=
    finitePhysicalState_supported_on_superSupport
      initialModesSubset
      (commonTimeReplayInitialState_supported lineage)
  have initialTransverse :
      ∀ wave ∈ modes,
        complexWavevector wave ⬝ᵥ
            commonTimeReplayInitialState lineage wave =
          0 := by
    intro wave _waveMem
    exact commonTimeReplayInitialState_transverse lineage wave
  have initialReality :
      FiniteStateFourierReality
        (commonTimeReplayInitialState lineage) :=
    commonTimeReplayInitialState_reality lineage
  let trajectoryResult :=
    exists_finitePhysicalTrajectory_on_Icc
      modes zeroNotMem negClosed ν
      (commonTimeReplayInitialState lineage)
      initialSupported initialTransverse initialReality
      requestedTime requestedTimePos
  let trajectory : ℝ → ComplexVorticityHilbertState :=
    Classical.choose trajectoryResult
  have trajectorySpec :=
    Classical.choose_spec trajectoryResult
  exact
    { modes := modes
      initialModes_subset := initialModesSubset
      zero_not_mem := zeroNotMem
      waveNeg_mem := negClosed
      trajectory := trajectory
      initial := trajectorySpec.1
      physical := trajectorySpec.2 }

/--
Generate the next stage from the existing full-time residual inventory.
The initial physical state and requested interval are unchanged.
-/
noncomputable def wholeSpaceTimeNext
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {requestedTime : ℝ}
    (stage :
      GeneratedRequestedTimeReplayV2Stage lineage requestedTime)
    (requestedTimePos : 0 < requestedTime) :
    GeneratedRequestedTimeReplayV2Stage lineage requestedTime :=
  ofModes lineage requestedTime requestedTimePos
    (GeneratedRequestedTimeReplayStage.wholeSpaceTimeNextModes stage)
    (stage.initialModes_subset.trans
      (GeneratedRequestedTimeReplayStage.modes_subset_wholeSpaceTimeNextModes
        stage))
    (GeneratedRequestedTimeReplayStage.zero_not_mem_wholeSpaceTimeNextModes
      stage)
    (fun _wave waveMem =>
      GeneratedRequestedTimeReplayStage.wholeSpaceTimeNextModes_waveNeg_mem
        stage waveMem)

@[simp] theorem wholeSpaceTimeNext_modes
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {requestedTime : ℝ}
    (stage :
      GeneratedRequestedTimeReplayV2Stage lineage requestedTime)
    (requestedTimePos : 0 < requestedTime) :
    (wholeSpaceTimeNext stage requestedTimePos).modes =
      GeneratedRequestedTimeReplayStage.wholeSpaceTimeNextModes stage := by
  simp [wholeSpaceTimeNext, ofModes]

end GeneratedRequestedTimeReplayV2Stage

/--
Initial V2 stage generated from the first actual source support and common
source-owned physical initial state.
-/
noncomputable def initialRequestedTimeReplayV2Stage
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (requestedTime : ℝ)
    (requestedTimePos : 0 < requestedTime) :
    GeneratedRequestedTimeReplayV2Stage lineage requestedTime :=
  GeneratedRequestedTimeReplayV2Stage.ofModes
    lineage requestedTime requestedTimePos
    (lineageReceiptModes lineage 0)
    Finset.Subset.rfl
    (by
      unfold lineageReceiptModes
      exact zero_not_mem_generatedSupport _)
    (by
      intro wave waveMem
      unfold lineageReceiptModes at waveMem ⊢
      exact generatedSupport_waveNeg_mem _ waveMem)

@[simp] theorem initialRequestedTimeReplayV2Stage_modes
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (requestedTime : ℝ)
    (requestedTimePos : 0 < requestedTime) :
    (initialRequestedTimeReplayV2Stage
      lineage requestedTime requestedTimePos).modes =
      lineageReceiptModes lineage 0 := by
  simp [initialRequestedTimeReplayV2Stage,
    GeneratedRequestedTimeReplayV2Stage.ofModes]

/-- The initial V2 source supplies the actual unforced law on the interval. -/
theorem initialRequestedTimeReplayV2Stage_physical
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (requestedTime : ℝ)
    (requestedTimePos : 0 < requestedTime) :
    ∀ time ∈ Icc (0 : ℝ) requestedTime,
      HasDerivAt
          (initialRequestedTimeReplayV2Stage
            lineage requestedTime requestedTimePos).trajectory
          (finiteStateVorticityGenerator
            (initialRequestedTimeReplayV2Stage
              lineage requestedTime requestedTimePos).modes
            ν.coeff
            ((initialRequestedTimeReplayV2Stage
              lineage requestedTime requestedTimePos).trajectory time))
          time ∧
        (∀ wave,
          wave ∉
              (initialRequestedTimeReplayV2Stage
                lineage requestedTime requestedTimePos).modes →
            (initialRequestedTimeReplayV2Stage
              lineage requestedTime requestedTimePos).trajectory time wave =
              0) ∧
        (∀ wave,
          complexWavevector wave ⬝ᵥ
              (initialRequestedTimeReplayV2Stage
                lineage requestedTime requestedTimePos).trajectory time wave =
            0) ∧
        FiniteStateFourierReality
          ((initialRequestedTimeReplayV2Stage
            lineage requestedTime requestedTimePos).trajectory time) :=
  (initialRequestedTimeReplayV2Stage
    lineage requestedTime requestedTimePos).physical

/-- One native V2 full-time residual refinement edge. -/
inductive NativeRequestedTimeReplayV2Step
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (requestedTime : ℝ)
    (requestedTimePos : 0 < requestedTime) :
    GeneratedRequestedTimeReplayV2Stage lineage requestedTime →
      GeneratedRequestedTimeReplayV2Stage lineage requestedTime → Type
  | expand
      (current :
        GeneratedRequestedTimeReplayV2Stage lineage requestedTime)
      (missingNonempty :
        (GeneratedRequestedTimeReplayStage.rawWholeSpaceTimeMissingModes
          current).Nonempty) :
      NativeRequestedTimeReplayV2Step
        lineage requestedTime requestedTimePos
        current
        (GeneratedRequestedTimeReplayV2Stage.wholeSpaceTimeNext
          current requestedTimePos)

/--
Source-owned unconditional V2 responder.  No trajectory, branch, support
target, nonzero residual witness, or coverage certificate is supplied.
-/
noncomputable def generatedRequestedTimeReplayV2Respond
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (requestedTime : ℝ)
    (requestedTimePos : 0 < requestedTime)
    (current :
      GeneratedRequestedTimeReplayV2Stage lineage requestedTime) :
    Option
      (Response
        (NativeRequestedTimeReplayV2Step
          lineage requestedTime requestedTimePos)
        current) :=
  if missingNonempty :
      (GeneratedRequestedTimeReplayStage.rawWholeSpaceTimeMissingModes
        current).Nonempty then
    some
      ⟨GeneratedRequestedTimeReplayV2Stage.wholeSpaceTimeNext
          current requestedTimePos,
        .expand current missingNonempty⟩
  else
    none

/-- `none` is exactly punctured full-time residual closure. -/
theorem
    generatedRequestedTimeReplayV2Respond_eq_none_iff_puncturedResidual_zero
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (requestedTime : ℝ)
    (requestedTimePos : 0 < requestedTime)
    (current :
      GeneratedRequestedTimeReplayV2Stage lineage requestedTime) :
    generatedRequestedTimeReplayV2Respond
        lineage requestedTime requestedTimePos current =
      none ↔
        ∀ time ∈ Icc (0 : ℝ) requestedTime,
          ∀ wave : IntegerWavevector,
            wave ≠ 0 →
              GeneratedRequestedTimeReplayStage.wholeSpaceTimeResidual
                current time wave = 0 := by
  constructor
  · intro stopped
    have missingEmpty :
        GeneratedRequestedTimeReplayStage.rawWholeSpaceTimeMissingModes
            current =
          ∅ := by
      apply Finset.not_nonempty_iff_eq_empty.mp
      intro missingNonempty
      simp [generatedRequestedTimeReplayV2Respond,
        missingNonempty] at stopped
    exact
      (GeneratedRequestedTimeReplayStage.rawWholeSpaceTimeMissingModes_eq_empty_iff_puncturedResidual_zero
        current).mp missingEmpty
  · intro residualClosed
    have missingEmpty :
        GeneratedRequestedTimeReplayStage.rawWholeSpaceTimeMissingModes
            current =
          ∅ :=
      (GeneratedRequestedTimeReplayStage.rawWholeSpaceTimeMissingModes_eq_empty_iff_puncturedResidual_zero
        current).mpr residualClosed
    have missingNotNonempty :
        ¬ (GeneratedRequestedTimeReplayStage.rawWholeSpaceTimeMissingModes
          current).Nonempty := by
      simp [missingEmpty]
    simp [generatedRequestedTimeReplayV2Respond,
      missingNotNonempty]

namespace NativeRequestedTimeReplayV2Step

/-- Every generated V2 residual edge strictly enlarges support. -/
theorem modes_ssubset
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {requestedTime : ℝ}
    {requestedTimePos : 0 < requestedTime}
    {current next :
      GeneratedRequestedTimeReplayV2Stage lineage requestedTime}
    (step :
      NativeRequestedTimeReplayV2Step
        lineage requestedTime requestedTimePos current next) :
    current.modes ⊂ next.modes := by
  cases step with
  | expand missingNonempty =>
      rw [GeneratedRequestedTimeReplayV2Stage.wholeSpaceTimeNext_modes]
      exact
        GeneratedRequestedTimeReplayStage.modes_ssubset_wholeSpaceTimeNextModes
          current missingNonempty

/--
Every row in the old source-computed residual inventory is installed in the
next stage's physical law surface.  This is the componentwise native write
behind strict support growth.
-/
theorem rawMissing_subset_next_modes
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {requestedTime : ℝ}
    {requestedTimePos : 0 < requestedTime}
    {current next :
      GeneratedRequestedTimeReplayV2Stage lineage requestedTime}
    (step :
      NativeRequestedTimeReplayV2Step
        lineage requestedTime requestedTimePos current next) :
    GeneratedRequestedTimeReplayStage.rawWholeSpaceTimeMissingModes current ⊆
      next.modes := by
  cases step with
  | expand missingNonempty =>
      rw [GeneratedRequestedTimeReplayV2Stage.wholeSpaceTimeNext_modes]
      intro wave waveMem
      exact Finset.mem_union_right _
        (GeneratedRequestedTimeReplayStage.rawMissing_subset_missing
          current waveMem)

/--
After the generated support write, every row that was genuinely active in
the old full-time residual is identically silent in the next full-time
residual on the same requested physical interval.
-/
theorem rawMissing_next_residual_zero
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {requestedTime : ℝ}
    {requestedTimePos : 0 < requestedTime}
    {current next :
      GeneratedRequestedTimeReplayV2Stage lineage requestedTime}
    (step :
      NativeRequestedTimeReplayV2Step
        lineage requestedTime requestedTimePos current next)
    {wave : IntegerWavevector}
    (waveMem :
      wave ∈
        GeneratedRequestedTimeReplayStage.rawWholeSpaceTimeMissingModes
          current)
    {time : ℝ}
    (timeMem : time ∈ Icc (0 : ℝ) requestedTime) :
    GeneratedRequestedTimeReplayStage.wholeSpaceTimeResidual
        next time wave =
      0 :=
  GeneratedRequestedTimeReplayStage.wholeSpaceTimeResidual_eq_zero_of_mem
    next timeMem (step.rawMissing_subset_next_modes waveMem)

end NativeRequestedTimeReplayV2Step

end

