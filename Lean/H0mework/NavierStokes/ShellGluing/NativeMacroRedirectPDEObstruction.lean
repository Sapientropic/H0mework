/-! ## Exact physical-time ledger of the corrected lineage -/

def physicalTime
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (length : ℕ) : ℝ :=
  ∑ index ∈ Finset.range length,
    (lineage.physicalReceipt index).duration

def fieldWeightedTime
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (length : ℕ) : ℝ :=
  ∑ index ∈ Finset.range length,
    (lineage.physicalReceipt index).duration *
      (((lineage.physicalReceipt index).fieldBound : ℝ) + 1)

/-- The native target advances elapsed time by exactly its unforced receipt. -/
theorem elapsed_succ
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (index : ℕ) :
    (lineage.current (index + 1)).elapsed =
      (lineage.current index).elapsed +
        (lineage.physicalReceipt index).duration := by
  exact (lineage.step index).elapsed_next

theorem elapsed_eq_initial_add_physicalTime
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν) :
    ∀ length : ℕ,
      (lineage.current length).elapsed =
        (lineage.current 0).elapsed +
          physicalTime lineage length
  | 0 => by
      simp [physicalTime]
  | length + 1 => by
      rw [elapsed_succ lineage length,
        elapsed_eq_initial_add_physicalTime lineage length]
      simp [physicalTime, Finset.sum_range_succ]
      ring

/-- Exact source-owned field-weighted time debt of every finite prefix. -/
theorem four_mul_fieldWeightedTime_eq_length
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (length : ℕ) :
    4 * fieldWeightedTime lineage length = length := by
  unfold fieldWeightedTime
  rw [Finset.mul_sum]
  calc
    (∑ index ∈ Finset.range length,
        4 *
          ((lineage.physicalReceipt index).duration *
            (((lineage.physicalReceipt index).fieldBound : ℝ) + 1))) =
        ∑ _index ∈ Finset.range length, (1 : ℝ) := by
          apply Finset.sum_congr rfl
          intro index indexMem
          simpa only [mul_assoc] using
            (lineage.physicalReceipt index).four_mul_duration_mul_fieldBound_add_one
    _ = length := by
      simp

theorem physicalReceipt_duration_pos
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (index : ℕ) :
    0 < (lineage.physicalReceipt index).duration :=
  (lineage.physicalReceipt index).duration_pos

/-! ## Anti-Zeno on the same glued physical lineage -/

theorem fieldBound_unbounded_of_physicalTime_bounded
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (horizon : ℝ)
    (physicalTimeLe :
      ∀ length : ℕ,
        physicalTime lineage length ≤ horizon) :
    ∀ bound : ℝ,
      ∃ index : ℕ,
        bound <
          ((lineage.physicalReceipt index).fieldBound : ℝ) := by
  intro bound
  by_contra notEscape
  push Not at notEscape
  have boundNonneg : 0 ≤ bound :=
    (NNReal.coe_nonneg
      (lineage.physicalReceipt 0).fieldBound).trans
        (notEscape 0)
  have horizonNonneg : 0 ≤ horizon := by
    have atZero := physicalTimeLe 0
    simpa [physicalTime] using atZero
  have weightedLe :
      ∀ length : ℕ,
        fieldWeightedTime lineage length ≤
          (bound + 1) * physicalTime lineage length := by
    intro length
    unfold fieldWeightedTime physicalTime
    calc
      (∑ index ∈ Finset.range length,
          (lineage.physicalReceipt index).duration *
            (((lineage.physicalReceipt index).fieldBound : ℝ) + 1)) ≤
          ∑ index ∈ Finset.range length,
            (lineage.physicalReceipt index).duration *
              (bound + 1) := by
                apply Finset.sum_le_sum
                intro index indexMem
                exact
                  mul_le_mul_of_nonneg_left
                    (by linarith [notEscape index])
                    (physicalReceipt_duration_pos lineage index).le
      _ =
          (bound + 1) *
            (∑ index ∈ Finset.range length,
              (lineage.physicalReceipt index).duration) := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro index indexMem
            ring
  have weightedUniformLe :
      ∀ length : ℕ,
        fieldWeightedTime lineage length ≤
          (bound + 1) * horizon := by
    intro length
    exact
      (weightedLe length).trans
        (mul_le_mul_of_nonneg_left
          (physicalTimeLe length)
          (by linarith))
  obtain ⟨length, lengthLarge⟩ :=
    exists_nat_gt (4 * ((bound + 1) * horizon))
  have exactDebt :=
    four_mul_fieldWeightedTime_eq_length lineage length
  have debtLe :
      (length : ℝ) ≤
        4 * ((bound + 1) * horizon) := by
    calc
      (length : ℝ) =
          4 * fieldWeightedTime lineage length :=
        exactDebt.symm
      _ ≤ 4 * ((bound + 1) * horizon) :=
        mul_le_mul_of_nonneg_left
          (weightedUniformLe length) (by norm_num)
  exact (not_lt_of_ge debtLe) lengthLarge

/-! ## Resolve field growth on the exact physical receipt carrier -/

def nonlinearFieldBound
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (index : ℕ) : ℝ :=
  canonicalProjectedGeneratorFieldBound
    (generatedSupport
      (completeOmittedPhysicalLiftSource
        (lineage.current index).physicalSource))
    0
    (generatedTimeAdvanceInnerRadius
      (completeOmittedPhysicalLiftSource
        (lineage.current index).physicalSource) + 1)

def unitViscousFieldBound
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (index : ℕ) : ℝ :=
  canonicalProjectedViscousFieldBound
    (generatedSupport
      (completeOmittedPhysicalLiftSource
        (lineage.current index).physicalSource))
    1
    (generatedTimeAdvanceInnerRadius
      (completeOmittedPhysicalLiftSource
        (lineage.current index).physicalSource) + 1)

theorem physicalReceipt_fieldBound_le_nonlinear_add_viscous
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (index : ℕ) :
    ((lineage.physicalReceipt index).fieldBound : ℝ) ≤
      nonlinearFieldBound lineage index +
        |ν.coeff| * unitViscousFieldBound lineage index := by
  let source :=
    completeOmittedPhysicalLiftSource
      (lineage.current index).physicalSource
  let modes := generatedSupport source
  let radius := generatedTimeAdvanceInnerRadius source + 1
  change
    ((lineage.physicalReceipt index).fieldBound : ℝ) ≤
      (canonicalProjectedGeneratorFieldBound
          modes 0 radius : ℝ) +
        |ν.coeff| *
          (canonicalProjectedViscousFieldBound
            modes 1 radius : ℝ)
  have fieldEq :
      ((lineage.physicalReceipt index).fieldBound : ℝ) =
        (canonicalProjectedGeneratorFieldBound
          modes ν.coeff radius : ℝ) :=
    congrArg (fun bound : NNReal => (bound : ℝ))
      (lineage.physicalReceipt index).fieldBound_eq
  rw [fieldEq]
  exact
    (canonicalProjectedGeneratorFieldBound_le_nonlinear_add_viscous
      modes ν.coeff radius).trans
      (add_le_add le_rfl
        (canonicalProjectedViscousFieldBound_le_abs_mul_unit
          modes ν.coeff radius))

theorem
    unitViscous_unbounded_of_fieldBound_unbounded_of_nonlinear_not_unbounded
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (fieldUnbounded :
      ∀ bound : ℝ,
        ∃ index : ℕ,
          bound <
            ((lineage.physicalReceipt index).fieldBound : ℝ))
    (nonlinearNotUnbounded :
      ¬ ∀ bound : ℝ,
          ∃ index : ℕ,
            bound < nonlinearFieldBound lineage index) :
    ∀ bound : ℝ,
      ∃ index : ℕ,
        bound < unitViscousFieldBound lineage index := by
  push Not at nonlinearNotUnbounded
  let nonlinearCeiling : ℝ :=
    Classical.choose nonlinearNotUnbounded
  have nonlinearLe :
      ∀ index : ℕ,
        nonlinearFieldBound lineage index ≤ nonlinearCeiling :=
    Classical.choose_spec nonlinearNotUnbounded
  intro bound
  by_contra unitViscousNotEscape
  push Not at unitViscousNotEscape
  let combinedCeiling :=
    nonlinearCeiling + |ν.coeff| * bound
  obtain ⟨index, fieldEscape⟩ :=
    fieldUnbounded combinedCeiling
  have splitLe :=
    physicalReceipt_fieldBound_le_nonlinear_add_viscous
      lineage index
  have combinedLe :
      nonlinearFieldBound lineage index +
            |ν.coeff| *
              unitViscousFieldBound lineage index ≤
        combinedCeiling :=
    add_le_add (nonlinearLe index)
      (mul_le_mul_of_nonneg_left
        (unitViscousNotEscape index) (abs_nonneg _))
  exact
    (not_lt_of_ge (splitLe.trans combinedLe)) fieldEscape

/-! ## Source-owned PDE obstruction dispositions -/

inductive GeneratedRedirectedInfinitePDEObstruction
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν) : Type
  | physicalTimeUnbounded
      (escape :
        ∀ horizon : ℝ,
          ∃ length : ℕ,
            horizon < physicalTime lineage length)
  | nonlinearFieldUnbounded
      (escape :
        ∀ bound : ℝ,
          ∃ index : ℕ,
            bound < nonlinearFieldBound lineage index)
  | unitViscousFieldUnbounded
      (escape :
        ∀ bound : ℝ,
          ∃ index : ℕ,
            bound < unitViscousFieldBound lineage index)

/--
No finite-time bounded-field outlet is accepted.  The branch and every
ceiling are decided internally from the actual glued lineage.
-/
noncomputable def generatedRedirectedInfinitePDEObstruction
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν) :
    GeneratedRedirectedInfinitePDEObstruction lineage := by
  by_cases timeUnbounded :
      ∀ horizon : ℝ,
        ∃ length : ℕ,
          horizon < physicalTime lineage length
  · exact .physicalTimeUnbounded timeUnbounded
  · push Not at timeUnbounded
    let horizon : ℝ := Classical.choose timeUnbounded
    have physicalTimeLe :
        ∀ length : ℕ,
          physicalTime lineage length ≤ horizon :=
      Classical.choose_spec timeUnbounded
    have fieldUnbounded :=
      fieldBound_unbounded_of_physicalTime_bounded
        lineage horizon physicalTimeLe
    by_cases nonlinearUnbounded :
        ∀ bound : ℝ,
          ∃ index : ℕ,
            bound < nonlinearFieldBound lineage index
    · exact .nonlinearFieldUnbounded nonlinearUnbounded
    · exact
        .unitViscousFieldUnbounded
          (unitViscous_unbounded_of_fieldBound_unbounded_of_nonlinear_not_unbounded
            lineage fieldUnbounded nonlinearUnbounded)

/--
Global no-third-outlet theorem of the corrected source runtime.

The infinite-macro branches additionally retain, through `lineage`, the
machine-proved adjacent physical gluing and whole-carrier prefix transport.
-/
inductive GeneratedRedirectedGlobalPDEObstruction
    (ν : Viscosity)
    (seed : UnforcedScaleTimeCurrent) : Type
  | shellInfinite
      (run : GeneratedRedirectedCompleteRoundTerminalRun ν seed)
      (infiniteShell :
        GeneratedCompleteInfiniteShellAt
          (legacyCurrentReadout run.terminal))
  | physicalTimeUnbounded
      (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
      (startsAtSeed : lineage.current 0 = seed)
      (escape :
        ∀ horizon : ℝ,
          ∃ length : ℕ,
            horizon < physicalTime lineage length)
  | nonlinearFieldUnbounded
      (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
      (startsAtSeed : lineage.current 0 = seed)
      (escape :
        ∀ bound : ℝ,
          ∃ index : ℕ,
            bound < nonlinearFieldBound lineage index)
  | unitViscousFieldUnbounded
      (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
      (startsAtSeed : lineage.current 0 = seed)
      (escape :
        ∀ bound : ℝ,
          ∃ index : ℕ,
            bound < unitViscousFieldBound lineage index)

noncomputable def generatedRedirectedGlobalPDEObstruction
    (ν : Viscosity)
    (seed : UnforcedScaleTimeCurrent) :
    GeneratedRedirectedGlobalPDEObstruction ν seed := by
  cases
      generatedRedirectedCompleteRoundRuntimeDisposition
        ν seed with
  | shellInfinite run infiniteShell =>
      exact .shellInfinite run infiniteShell
  | macroInfinite lineage startsAtSeed =>
      cases generatedRedirectedInfinitePDEObstruction lineage with
      | physicalTimeUnbounded escape =>
          exact
            .physicalTimeUnbounded
              lineage startsAtSeed escape
      | nonlinearFieldUnbounded escape =>
          exact
            .nonlinearFieldUnbounded
              lineage startsAtSeed escape
      | unitViscousFieldUnbounded escape =>
          exact
            .unitViscousFieldUnbounded
              lineage startsAtSeed escape

end

