import H0mework.NavierStokes.ShellGluing.NativeMacroRequestedTimeWholeContinuousMildSerrin
import H0mework.NavierStokes.ShellGluing.NativeMacroRequestedTimeReplayV2LocalWholeUnforced

/-!
# Compile every native macro contact to its actual whole unforced update

The redirected macro lineage already owns every source response.  The
whole-flow compiler already starts its common-time replay with the first
native Galerkin receipt and, below the internally tested half-critical
boundary, produces a genuine whole mild/Serrin solution.

This module closes the missing source seam at every actual macro index:

```text
native lineage suffix at index
  -> its literal first native receipt
  -> source-owned common-time residual replay
  -> half-critical crossing
     or an actual whole unforced update on the same initial state and horizon.
```

The finite Galerkin endpoint is deliberately not identified with the whole
Navier--Stokes endpoint.  The former is the first chart of the compiler; the
latter is generated by the complete replay.  No branch, target solution,
continuation witness, cutoff, path equality, or smallness certificate is
accepted from a caller.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace
    ThreeDimensionalVorticityCoefficientGeneratedShellGluingResidualNativeMacroWholeUnforcedCompiler

open Set
open ThreeDimensionalPeriodicFilteredNavierStokesGenerator
open
  ThreeDimensionalVorticityCoefficientGeneratedScaleTimeDeferredMaterialization
open
  ThreeDimensionalVorticityCoefficientGeneratedShellGluingResidualNativeMacroRedirect
open
  ThreeDimensionalVorticityCoefficientGeneratedShellGluingResidualNativeMacroRedirectRuntime
open
  ThreeDimensionalVorticityCoefficientGeneratedShellGluingResidualNativeMacroRedirectRuntime.GeneratedRedirectedCompleteRoundInfiniteLineage
open
  ThreeDimensionalVorticityCoefficientGeneratedShellGluingResidualNativeMacroWholeResidualCriticalLineage
open
  ThreeDimensionalVorticityCoefficientGeneratedShellGluingResidualNativeMacroWholeResidualCommonTimeReplay
open
  ThreeDimensionalVorticityCoefficientGeneratedShellGluingResidualNativeMacroRequestedTimeWholeContinuousMildSerrin
open
  ThreeDimensionalVorticityCoefficientGeneratedShellGluingResidualNativeMacroRequestedTimeReplayV2LocalBudget
open
  ThreeDimensionalVorticityCoefficientGeneratedShellGluingResidualNativeMacroRequestedTimeReplayV2LocalWholeUnforced
open
  ThreeDimensionalVorticityCoefficientWholeContinuousMildSerrinUniqueness

noncomputable section

/-- Source-owned suffix beginning at one actual macro contact. -/
def dropLineage
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (offset : ℕ) :
    GeneratedRedirectedCompleteRoundInfiniteLineage ν where
  current index := lineage.current (offset + index)
  step index := lineage.step (offset + index)
  generated index := lineage.generated (offset + index)

@[simp] theorem drop_current
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (offset index : ℕ) :
    (dropLineage lineage offset).current index =
      lineage.current (offset + index) :=
  rfl

@[simp] theorem drop_step
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (offset index : ℕ) :
    (dropLineage lineage offset).step index =
      lineage.step (offset + index) :=
  rfl

@[simp] theorem drop_physicalReceipt
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (offset index : ℕ) :
    (dropLineage lineage offset).physicalReceipt index =
      lineage.physicalReceipt (offset + index) :=
  rfl

@[simp] theorem drop_halfCriticalCrossing_zero
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (offset : ℕ) :
    lineageHalfCriticalCrossing (dropLineage lineage offset) 0 ↔
      lineageHalfCriticalCrossing lineage offset := by
  simp [lineageHalfCriticalCrossing, lineageReceiptModes,
    dropLineage, physicalReceipt]

/-- The suffix replay begins at the exact physical state of that source
contact.  This equality is generated by the native macro edge itself. -/
theorem drop_commonTimeReplayInitialState
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (offset : ℕ) :
    commonTimeReplayInitialState (dropLineage lineage offset) =
      recollectedPhysicalState (lineage.current offset) := by
  have physical :=
    (lineage.step offset).physicalProjection_unforced_commutes
  simpa [commonTimeReplayInitialState, dropLineage, physicalReceipt] using
    physical.1

@[simp] theorem drop_commonTimeReplayDuration
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (offset : ℕ) :
    commonTimeReplayDuration (dropLineage lineage offset) =
      (lineage.physicalReceipt offset).duration := by
  simp [commonTimeReplayDuration, dropLineage, physicalReceipt]

/-- The first chart of the suffix whole-flow compiler is literally the
existing native finite Galerkin receipt, not a caller-supplied replay. -/
theorem drop_initialReplay_trajectory
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (offset : ℕ) :
    (initialCommonTimeReplayStage
        (dropLineage lineage offset)).trajectory =
      (lineage.physicalReceipt offset).trajectory := by
  rfl

/--
At every actual native macro contact, the source itself generates either the
fixed half-critical obstruction or an actual whole unforced Navier--Stokes
update from the exact current physical state on the exact native horizon.

The right summand is indexed by the old current and native duration, so a
consumer cannot substitute a target path or a different time window.
-/
noncomputable def generatedNativeMacroWholeUnforcedUpdateAt
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (offset : ℕ) :
    PLift (lineageHalfCriticalCrossing lineage offset) ⊕
      WholeContinuousMildSerrinReceipt
        ν
        (recollectedPhysicalState (lineage.current offset))
        (lineage.physicalReceipt offset).duration := by
  let suffix := dropLineage lineage offset
  have initialEq :
      commonTimeReplayInitialState suffix =
        recollectedPhysicalState (lineage.current offset) := by
    simpa [suffix] using
      drop_commonTimeReplayInitialState lineage offset
  have durationEq :
      commonTimeReplayDuration suffix =
        (lineage.physicalReceipt offset).duration := by
    exact drop_commonTimeReplayDuration lineage offset
  cases
      generatedRequestedTimeHalfCriticalOrWholeContinuousMildSerrin
        suffix
        (commonTimeReplayDuration suffix)
        (commonTimeReplayDuration_pos suffix) with
  | inl crossing =>
      exact Sum.inl
        ⟨(drop_halfCriticalCrossing_zero lineage offset).mp crossing.down⟩
  | inr receipt =>
      rw [initialEq, durationEq] at receipt
      exact Sum.inr receipt

/--
Every actual native macro contact unconditionally generates a whole
unforced Navier--Stokes update from its exact physical current.  The
positive horizon is computed by the source-owned local V2 producer on the
literal suffix beginning at that contact; neither a critical branch nor a
caller-selected duration remains in the theorem mouth.
-/
noncomputable def generatedNativeMacroWholeUnforcedLocalUpdateAt
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (offset : ℕ) :
    WholeContinuousMildSerrinReceipt
      ν
      (recollectedPhysicalState (lineage.current offset))
      (sourceOwnedLocalReplayV2Duration (dropLineage lineage offset)) := by
  let suffix := dropLineage lineage offset
  have initialEq :
      commonTimeReplayInitialState suffix =
        recollectedPhysicalState (lineage.current offset) := by
    simpa [suffix] using
      drop_commonTimeReplayInitialState lineage offset
  let receipt :=
    generatedSourceOwnedLocalWholeContinuousMildSerrinReceipt suffix
  rw [initialEq] at receipt
  exact receipt

end

end
    ThreeDimensionalVorticityCoefficientGeneratedShellGluingResidualNativeMacroWholeUnforcedCompiler
end NavierStokes
end SaturationMonoid
