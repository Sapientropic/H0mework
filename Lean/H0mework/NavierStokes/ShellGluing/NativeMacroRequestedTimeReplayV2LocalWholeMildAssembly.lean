/--
Choose the row data already generated by the requested-time replay
closure.  The choice does not select a target path: every witness
represents the same whole replay state and carries the same source-owned
initial trace.
-/
noncomputable def localReplayV2FixedWaveMildData
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {durationPos : 0 < sourceOwnedLocalReplayV2Duration lineage}
    {replay :
      GeneratedRequestedTimeReplayV2InfiniteLineage lineage
        (sourceOwnedLocalReplayV2Duration lineage) durationPos}
    (closure :
      GeneratedLocalReplayV2CriticalClosure replay)
    (wave : IntegerWavevector)
    (waveNonzero : wave ≠ 0) :
    FixedWaveContinuousMildData
      (sourceOwnedLocalReplayV2Duration lineage) ν.coeff wave
      (fun _index => commonTimeReplayInitialState lineage)
      closure.weakClosure.stateLimit
      (transverseSpaceTimeNonlinearRow
        closure.transverseLimit wave) :=
  Classical.choice
    (exists_fixedWaveContinuousMildData
      closure wave waveNonzero)

/--
The initial state carried by every chosen row is the source-owned common
initial state of the actual replay.
-/
theorem localReplayV2FixedWaveMildData_initialLimit
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {durationPos : 0 < sourceOwnedLocalReplayV2Duration lineage}
    {replay :
      GeneratedRequestedTimeReplayV2InfiniteLineage lineage
        (sourceOwnedLocalReplayV2Duration lineage) durationPos}
    (closure :
      GeneratedLocalReplayV2CriticalClosure replay)
    (wave : IntegerWavevector)
    (waveNonzero : wave ≠ 0) :
    (localReplayV2FixedWaveMildData
        closure wave waveNonzero).initialLimit =
      commonTimeReplayInitialState lineage := by
  exact
    tendsto_nhds_unique
      (localReplayV2FixedWaveMildData
        closure wave waveNonzero).initial_tendsto
      tendsto_const_nhds

/--
The source-owned common initial state has no zero Fourier vorticity row.
-/
theorem localReplayV2InitialState_zero_row
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {durationPos : 0 < sourceOwnedLocalReplayV2Duration lineage}
    {replay :
      GeneratedRequestedTimeReplayV2InfiniteLineage lineage
        (sourceOwnedLocalReplayV2Duration lineage) durationPos}
    (_closure :
      GeneratedLocalReplayV2CriticalClosure replay) :
    commonTimeReplayInitialState lineage 0 = 0 := by
  rw [← (replay.current 0).initial]
  exact
    ((replay.current 0).physical 0 ⟨le_rfl, durationPos.le⟩).2.1
      0 (replay.current 0).zero_not_mem

/--
The zero Fourier row vanishes in the same strong requested-time replay
limit.
-/
theorem localReplayV2StateLimit_zero_row
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {durationPos : 0 < sourceOwnedLocalReplayV2Duration lineage}
    {replay :
      GeneratedRequestedTimeReplayV2InfiniteLineage lineage
        (sourceOwnedLocalReplayV2Duration lineage) durationPos}
    (closure :
      GeneratedLocalReplayV2CriticalClosure replay) :
    fixedWaveSpaceTimeRestriction
        (sourceOwnedLocalReplayV2Duration lineage) 0 closure.weakClosure.stateLimit =
      0 := by
  have approximantZero :
      ∀ index : ℕ,
        fixedWaveSpaceTimeRestriction
            (sourceOwnedLocalReplayV2Duration lineage) 0
            (wholeTrajectorySpaceTimePath
              (sourceOwnedLocalReplayV2Duration lineage)
              (replay.current
                (closure.weakClosure.subsequence index)).trajectory
              (HasDerivAt.continuousOn
                (fun time timeMem =>
                  ((replay.current
                    (closure.weakClosure.subsequence index)).physical
                      time timeMem).1))) =
          0 := by
    intro index
    apply MeasureTheory.Lp.ext
    filter_upwards [
      fixedWaveSpaceTimeRestriction_coeFn
        (sourceOwnedLocalReplayV2Duration lineage) 0
        (wholeTrajectorySpaceTimePath
          (sourceOwnedLocalReplayV2Duration lineage)
          (replay.current
            (closure.weakClosure.subsequence index)).trajectory
          (HasDerivAt.continuousOn
            (fun time timeMem =>
              ((replay.current
                (closure.weakClosure.subsequence index)).physical
                  time timeMem).1))),
      BoundedContinuousFunction.coeFn_toLp
        (p := (2 : ℝ≥0∞))
        (μ := commonTimeMeasure (sourceOwnedLocalReplayV2Duration lineage))
        ℂ
        (wholeTrajectoryBoundedPath
          (sourceOwnedLocalReplayV2Duration lineage)
          (replay.current
            (closure.weakClosure.subsequence index)).trajectory
          (HasDerivAt.continuousOn
            (fun time timeMem =>
              ((replay.current
                (closure.weakClosure.subsequence index)).physical
                  time timeMem).1))),
      MeasureTheory.Lp.coeFn_zero
        ComplexCoordinateVector 2
        (commonTimeMeasure (sourceOwnedLocalReplayV2Duration lineage))] with
        time rowEq wholeEq zeroEq
    rw [rowEq, zeroEq]
    have statePoint :
        (wholeTrajectorySpaceTimePath
          (sourceOwnedLocalReplayV2Duration lineage)
          (replay.current
            (closure.weakClosure.subsequence index)).trajectory
          (HasDerivAt.continuousOn
            (fun actual actualMem =>
              ((replay.current
                (closure.weakClosure.subsequence index)).physical
                  actual actualMem).1))) time =
          (replay.current
            (closure.weakClosure.subsequence index)).trajectory
              time.1 := by
      have statePoint' :
          (wholeTrajectorySpaceTimePath
            (sourceOwnedLocalReplayV2Duration lineage)
            (replay.current
              (closure.weakClosure.subsequence index)).trajectory
            (HasDerivAt.continuousOn
              (fun actual actualMem =>
                ((replay.current
                  (closure.weakClosure.subsequence index)).physical
                    actual actualMem).1))) time =
            wholeTrajectoryBoundedPath
              (sourceOwnedLocalReplayV2Duration lineage)
              (replay.current
                (closure.weakClosure.subsequence index)).trajectory
              (HasDerivAt.continuousOn
                (fun actual actualMem =>
                  ((replay.current
                    (closure.weakClosure.subsequence index)).physical
                      actual actualMem).1)) time := by
        simpa [wholeTrajectorySpaceTimePath] using wholeEq
      exact statePoint'.trans rfl
    rw [statePoint]
    exact
      (replay.current
        (closure.weakClosure.subsequence index)).physical
          time.1 time.2 |>.2.1 0
          (replay.current
            (closure.weakClosure.subsequence index)).zero_not_mem
  have rowTendsto :
      Tendsto
        (fun index =>
          fixedWaveSpaceTimeRestriction
            (sourceOwnedLocalReplayV2Duration lineage) 0
            (wholeTrajectorySpaceTimePath
              (sourceOwnedLocalReplayV2Duration lineage)
              (replay.current
                (closure.weakClosure.subsequence index)).trajectory
              (HasDerivAt.continuousOn
                (fun time timeMem =>
                  ((replay.current
                    (closure.weakClosure.subsequence index)).physical
                      time timeMem).1))))
        atTop
        (𝓝
          (fixedWaveSpaceTimeRestriction
            (sourceOwnedLocalReplayV2Duration lineage) 0 closure.weakClosure.stateLimit)) :=
    (fixedWaveSpaceTimeRestriction
      (sourceOwnedLocalReplayV2Duration lineage) 0).continuous.tendsto
        closure.weakClosure.stateLimit |>.comp
          closure.weakClosure.state_tendsto
  have zeroTendsto :
      Tendsto
        (fun _ : ℕ =>
          (0 : FixedWaveSpaceTimeState (sourceOwnedLocalReplayV2Duration lineage)))
        atTop (𝓝 0) :=
    tendsto_const_nhds
  exact
    tendsto_nhds_unique rowTendsto <| by
      simpa only [approximantZero] using zeroTendsto

/--
All fields of the generic whole-mild compiler are generated on the same
actual requested-time replay closure.
-/
noncomputable def localReplayV2WholeMildAssemblyInput
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {durationPos : 0 < sourceOwnedLocalReplayV2Duration lineage}
    {replay :
      GeneratedRequestedTimeReplayV2InfiniteLineage lineage
        (sourceOwnedLocalReplayV2Duration lineage) durationPos}
    (closure :
      GeneratedLocalReplayV2CriticalClosure replay) :
    WholeMildAssemblyInput ν (sourceOwnedLocalReplayV2Duration lineage) where
  time_pos :=
    durationPos
  initialState :=
    commonTimeReplayInitialState lineage
  stateLimit :=
    closure.weakClosure.stateLimit
  negativeOneForcing :=
    negativeOneForcing closure
  nonlinearRow wave waveNonzero :=
    transverseSpaceTimeNonlinearRow
      closure.transverseLimit wave
  rowPath wave waveNonzero :=
    (localReplayV2FixedWaveMildData
      closure wave waveNonzero).rowPath
  row_represents wave waveNonzero :=
    (localReplayV2FixedWaveMildData
      closure wave waveNonzero).row_represents
  forcing_unweighted_row_ae wave waveNonzero :=
    negativeOneForcing_unweighted_row_ae
      closure wave waveNonzero
  row_mild_identity wave waveNonzero time := by
    have generated :=
      (localReplayV2FixedWaveMildData
        closure wave waveNonzero).mild_identity time
    rw [localReplayV2FixedWaveMildData_initialLimit
      closure wave waveNonzero] at generated
    exact generated
  stateLimit_zero_row :=
    localReplayV2StateLimit_zero_row closure
  initialState_zero_row :=
    localReplayV2InitialState_zero_row closure

/--
The actual requested-time replay compiles to one faithful whole continuous
mild path on the same requested horizon.
-/
noncomputable def localReplayV2WholeMildAssembly
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {durationPos : 0 < sourceOwnedLocalReplayV2Duration lineage}
    {replay :
      GeneratedRequestedTimeReplayV2InfiniteLineage lineage
        (sourceOwnedLocalReplayV2Duration lineage) durationPos}
    (closure :
      GeneratedLocalReplayV2CriticalClosure replay) :
    WholeContinuousMildAssembly
      (localReplayV2WholeMildAssemblyInput closure) :=
  (localReplayV2WholeMildAssemblyInput closure).assemble

/--
The assembled continuous path is exactly the pre-existing strong
requested-time replay limit in the whole `L²_t ℓ²` carrier.
-/
theorem localReplayV2WholeMildAssembly_toLp_eq
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {durationPos : 0 < sourceOwnedLocalReplayV2Duration lineage}
    {replay :
      GeneratedRequestedTimeReplayV2InfiniteLineage lineage
        (sourceOwnedLocalReplayV2Duration lineage) durationPos}
    (closure :
      GeneratedLocalReplayV2CriticalClosure replay) :
    BoundedContinuousFunction.toLp 2
        (commonTimeMeasure (sourceOwnedLocalReplayV2Duration lineage)) ℂ
        (localReplayV2WholeMildAssembly closure).wholePath =
      closure.weakClosure.stateLimit :=
  (localReplayV2WholeMildAssembly
    closure).wholePath_toLp_eq_stateLimit

/--
The requested-time critical gradient budget is carried by the same
assembled whole path.
-/
theorem localReplayV2WholeMildAssembly_gradient_mass_le
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {durationPos : 0 < sourceOwnedLocalReplayV2Duration lineage}
    {replay :
      GeneratedRequestedTimeReplayV2InfiniteLineage lineage
        (sourceOwnedLocalReplayV2Duration lineage) durationPos}
    (closure :
      GeneratedLocalReplayV2CriticalClosure replay) :
    wholeSpaceTimeVorticityGradientMass
        (sourceOwnedLocalReplayV2Duration lineage)
        (BoundedContinuousFunction.toLp 2
          (commonTimeMeasure (sourceOwnedLocalReplayV2Duration lineage)) ℂ
          (localReplayV2WholeMildAssembly closure).wholePath) ≤
      sourceOwnedLocalReplayV2GradientCeiling lineage := by
  rw [localReplayV2WholeMildAssembly_toLp_eq closure]
  exact closure.gradient_mass_le

end

