private theorem replayStage_zero_mem_time
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    (_stage : GeneratedCommonTimeReplayStage lineage) :
    (0 : ℝ) ∈ Icc 0 (commonTimeReplayDuration lineage) :=
  ⟨le_rfl, (commonTimeReplayDuration_pos lineage).le⟩

private theorem commonReplayInitial_supported_on_initialModes
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν) :
    ∀ wave,
      wave ∉ lineageReceiptModes lineage 0 →
        commonTimeReplayInitialState lineage wave = 0 := by
  intro wave waveNotMem
  have zeroMem :
      (0 : ℝ) ∈
        Icc (0 : ℝ) (lineage.physicalReceipt 0).duration :=
    ⟨le_rfl, (lineage.physicalReceipt 0).duration_pos.le⟩
  simpa [commonTimeReplayInitialState, lineageReceiptModes] using
    ((lineage.physicalReceipt 0).physical 0 zeroMem).2.1
      wave waveNotMem

namespace GeneratedCommonTimeReplayStage

theorem commonInitial_supported
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    (stage : GeneratedCommonTimeReplayStage lineage) :
    ∀ wave, wave ∉ stage.modes →
      commonTimeReplayInitialState lineage wave = 0 := by
  intro wave waveNotMem
  have supported :=
    (stage.physical 0 (replayStage_zero_mem_time stage)).2.1
      wave waveNotMem
  rwa [stage.initial] at supported

theorem commonInitial_transverse
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    (stage : GeneratedCommonTimeReplayStage lineage) :
    ∀ wave ∈ stage.modes,
      complexWavevector wave ⬝ᵥ
          commonTimeReplayInitialState lineage wave =
        0 := by
  intro wave waveMem
  have transverse :=
    (stage.physical 0 (replayStage_zero_mem_time stage)).2.2.1
      wave
  rwa [stage.initial] at transverse

theorem commonInitial_reality
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    (stage : GeneratedCommonTimeReplayStage lineage) :
    FiniteStateFourierReality
      (commonTimeReplayInitialState lineage) := by
  have reality :=
    (stage.physical 0 (replayStage_zero_mem_time stage)).2.2.2
  rwa [stage.initial] at reality

/--
The fixed source-owned initial state remains below the same half-critical
threshold on every replay support.  New support rows are initially zero, so
support refinement does not spend additional initial enstrophy.
-/
theorem commonInitial_halfCritical
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    (stage : GeneratedCommonTimeReplayStage lineage)
    (initialSubcritical :
      ¬ lineageHalfCriticalCrossing lineage 0) :
    criticalEnstrophyLatticeConstant *
          finiteStateVorticityCoefficientEnstrophy
            stage.modes
            (commonTimeReplayInitialState lineage) ≤
      (1 / 2 : ℝ) * ν.coeff ^ 2 *
        (2 * Real.pi) ^ 2 := by
  have baseCritical :
      criticalEnstrophyLatticeConstant *
            finiteStateVorticityCoefficientEnstrophy
              (lineageReceiptModes lineage 0)
              (commonTimeReplayInitialState lineage) ≤
        (1 / 2 : ℝ) * ν.coeff ^ 2 *
          (2 * Real.pi) ^ 2 := by
    simpa [lineageHalfCriticalCrossing,
      commonTimeReplayInitialState] using
      le_of_not_gt initialSubcritical
  have enstrophyLe :
      finiteStateVorticityCoefficientEnstrophy
          stage.modes
          (commonTimeReplayInitialState lineage) ≤
        finiteStateVorticityCoefficientEnstrophy
          (lineageReceiptModes lineage 0)
          (commonTimeReplayInitialState lineage) :=
    finiteStateVorticityCoefficientEnstrophy_le_of_supported
      stage.modes (lineageReceiptModes lineage 0)
      (commonTimeReplayInitialState lineage)
      (commonReplayInitial_supported_on_initialModes lineage)
  exact
    (mul_le_mul_of_nonneg_left enstrophyLe
      criticalEnstrophyLatticeConstant_nonneg).trans
      baseCritical

/--
Recompile one actual replay stage as a generated half-critical scale path.
The support and initial physical state are the exact stage data.
-/
def toCriticalScalePath
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    (stage : GeneratedCommonTimeReplayStage lineage)
    (initialSubcritical :
      ¬ lineageHalfCriticalCrossing lineage 0) :
    GeneratedCriticalScalePath ν (1 / 2 : ℝ) :=
  generatedCriticalScalePathOfFinitePhysicalState
    stage.modes stage.zero_not_mem stage.waveNeg_mem
    ν (1 / 2 : ℝ)
    (commonTimeReplayInitialState lineage)
    (commonInitial_supported stage)
    (commonInitial_transverse stage)
    (commonInitial_reality stage)
    (commonInitial_halfCritical stage initialSubcritical)

@[simp] theorem toCriticalScalePath_support
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    (stage : GeneratedCommonTimeReplayStage lineage)
    (initialSubcritical :
      ¬ lineageHalfCriticalCrossing lineage 0) :
    generatedSupport
        (toCriticalScalePath stage initialSubcritical).current =
      stage.modes := by
  change
    generatedSupport
        (rawSourceOfFiniteVorticityState stage.modes
          (commonTimeReplayInitialState lineage)) =
      stage.modes
  exact
    rawSourceOfFiniteVorticityState_generatedSupport
      stage.modes stage.zero_not_mem stage.waveNeg_mem
      (commonTimeReplayInitialState lineage)

@[simp] theorem toCriticalScalePath_initialState
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    (stage : GeneratedCommonTimeReplayStage lineage)
    (initialSubcritical :
      ¬ lineageHalfCriticalCrossing lineage 0) :
    generatedComplexVorticityState
        (toCriticalScalePath stage initialSubcritical).current
        (generatedSupport
          (toCriticalScalePath stage initialSubcritical).current) =
      commonTimeReplayInitialState lineage := by
  exact
    generatedCriticalScalePathOfFinitePhysicalState_initialState
      stage.modes stage.zero_not_mem stage.waveNeg_mem
      ν (1 / 2 : ℝ)
      (commonTimeReplayInitialState lineage)
      (commonInitial_supported stage)
      (commonInitial_transverse stage)
      (commonInitial_reality stage)
      (commonInitial_halfCritical stage initialSubcritical)

private theorem half_lt_one : (1 / 2 : ℝ) < 1 := by
  norm_num

/--
The trajectory selected by the existing compactness family is exactly the
same actual replay event on the common time interval.  This is the
same-support, same-initial, unforced Galerkin gluing theorem.
-/
theorem trajectory_eq_criticalPathTrajectory
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    (stage : GeneratedCommonTimeReplayStage lineage)
    (initialSubcritical :
      ¬ lineageHalfCriticalCrossing lineage 0) :
    EqOn stage.trajectory
      ((toCriticalScalePath stage initialSubcritical).commonTimeBudget
        half_lt_one (commonTimeReplayDuration_pos lineage)).trajectory
      (Icc 0 (commonTimeReplayDuration lineage)) := by
  let path := toCriticalScalePath stage initialSubcritical
  let budget :=
    path.commonTimeBudget
      half_lt_one (commonTimeReplayDuration_pos lineage)
  apply finiteGalerkinTrajectories_eqOn_Icc_of_same_initial
      stage.modes ν.coeff
      (commonTimeReplayDuration lineage)
      stage.trajectory budget.trajectory
  · intro time timeMem
    exact (stage.physical time timeMem).1
  · intro time timeMem
    simpa [path, budget] using
      (budget.physicalProperties time timeMem).1
  · calc
      stage.trajectory 0 =
          commonTimeReplayInitialState lineage :=
        stage.initial
      _ =
          generatedComplexVorticityState path.current
            (generatedSupport path.current) := by
        simpa [path] using
          (toCriticalScalePath_initialState
            stage initialSubcritical).symm
      _ = budget.trajectory 0 :=
        budget.initial.symm

/--
The strong-compactness space-time path is definitionally built from the
canonical trajectory.  Common-time gluing therefore identifies it with the
original replay trajectory on the exact physical interval.
-/
theorem criticalSpaceTimePath_eq_replayTrajectory
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    (stage : GeneratedCommonTimeReplayStage lineage)
    (initialSubcritical :
      ¬ lineageHalfCriticalCrossing lineage 0) :
    generatedCriticalSpaceTimePath
        half_lt_one (commonTimeReplayDuration_pos lineage)
        (toCriticalScalePath stage initialSubcritical) =
      wholeTrajectorySpaceTimePath
        (commonTimeReplayDuration lineage)
        stage.trajectory
        (HasDerivAt.continuousOn
          (fun time timeMem =>
            (stage.physical time timeMem).1)) := by
  unfold generatedCriticalSpaceTimePath
    generatedWholeBoundedPath generatedWholeTrajectory
    wholeTrajectorySpaceTimePath wholeTrajectoryBoundedPath
  congr 1
  apply BoundedContinuousFunction.ext
  intro time
  exact
    (trajectory_eq_criticalPathTrajectory
      stage initialSubcritical time.2).symm

end GeneratedCommonTimeReplayStage

open GeneratedCommonTimeReplayStage

/-- The compactness path generated from one exact replay support. -/
def replayCriticalPath
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {initialSubcritical :
      ¬ lineageHalfCriticalCrossing lineage 0}
    (replay :
      GeneratedCommonTimeReplayInfiniteLineage
        lineage initialSubcritical)
    (index : ℕ) :
    GeneratedCriticalScalePath ν (1 / 2 : ℝ) :=
  toCriticalScalePath
    (replay.current index) initialSubcritical

@[simp] theorem replayCriticalPath_support
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {initialSubcritical :
      ¬ lineageHalfCriticalCrossing lineage 0}
    (replay :
      GeneratedCommonTimeReplayInfiniteLineage
        lineage initialSubcritical)
    (index : ℕ) :
    generatedSupport (replayCriticalPath replay index).current =
      (replay.current index).modes := by
  exact
    toCriticalScalePath_support
      (replay.current index) initialSubcritical

/--
Any row already generated into one replay support remains present along
every strictly monotone compactness subsequence.
-/
theorem generatedReplayWave_eventually_mem_comp_strictMono
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {initialSubcritical :
      ¬ lineageHalfCriticalCrossing lineage 0}
    (replay :
      GeneratedCommonTimeReplayInfiniteLineage
        lineage initialSubcritical)
    (subsequence : ℕ → ℕ)
    (subsequenceMono : StrictMono subsequence)
    (wave : IntegerWavevector)
    (waveGenerated :
      ∃ entry : ℕ, wave ∈ (replay.current entry).modes) :
    ∀ᶠ index : ℕ in atTop,
      wave ∈
        generatedSupport
          (replayCriticalPath replay
            (subsequence index)).current := by
  rcases waveGenerated with ⟨entry, waveMem⟩
  have eventuallyInReplay :
      ∀ᶠ index : ℕ in atTop,
        wave ∈ (replay.current index).modes := by
    apply Filter.eventually_atTop.2
    refine ⟨entry, ?_⟩
    intro index entryLe
    exact
      ((GeneratedCommonTimeReplayInfiniteLineage.modes_strictMono
        replay).monotone entryLe) waveMem
  simpa only [replayCriticalPath_support] using
    subsequenceMono.tendsto_atTop.eventually
      eventuallyInReplay

/--
The original actual replay trajectories, not a parallel canonical family,
produce one whole-carrier strong subsequence on the source-owned common
positive interval.
-/
theorem exists_replayTrajectory_strong_subsequence
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {initialSubcritical :
      ¬ lineageHalfCriticalCrossing lineage 0}
    (replay :
      GeneratedCommonTimeReplayInfiniteLineage
        lineage initialSubcritical) :
    ∃ limit :
        SpaceTimeState (commonTimeReplayDuration lineage),
      limit ∈
          closure
            (generatedCriticalSpaceTimePathFamily
              (ν := ν) half_lt_one
              (commonTimeReplayDuration_pos lineage)) ∧
      ∃ subsequence : ℕ → ℕ,
        StrictMono subsequence ∧
        Tendsto
          (fun index =>
            wholeTrajectorySpaceTimePath
              (commonTimeReplayDuration lineage)
              (replay.current
                (subsequence index)).trajectory
              (HasDerivAt.continuousOn
                (fun time timeMem =>
                  ((replay.current
                    (subsequence index)).physical
                      time timeMem).1)))
          atTop (𝓝 limit) := by
  obtain
      ⟨limit, limitMem, subsequence, subsequenceMono,
        wholeTendsto, _wholeStrong, _fixedRows,
        _fixedRowsStrong⟩ :=
    generatedCriticalSpaceTimePath_strong_subsequence_with_fixed_wave_rows
      half_lt_one (commonTimeReplayDuration_pos lineage)
      (replayCriticalPath replay)
  refine
    ⟨limit, limitMem, subsequence, subsequenceMono, ?_⟩
  simpa only [
    replayCriticalPath,
    criticalSpaceTimePath_eq_replayTrajectory] using
      wholeTendsto

/--
Whole-carrier weak closure generated by one infinite native replay.  The
single state limit and subsequence work for every Fourier row that the
source lineage actually generates.
-/
structure GeneratedCommonTimeReplayWeakClosure
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {initialSubcritical :
      ¬ lineageHalfCriticalCrossing lineage 0}
    (replay :
      GeneratedCommonTimeReplayInfiniteLineage
        lineage initialSubcritical) where
  stateLimit :
    SpaceTimeState (commonTimeReplayDuration lineage)
  stateLimit_mem :
    stateLimit ∈
      closure
        (generatedCriticalSpaceTimePathFamily
          (ν := ν) half_lt_one
          (commonTimeReplayDuration_pos lineage))
  subsequence : ℕ → ℕ
  subsequence_strictMono : StrictMono subsequence
  state_tendsto :
    Tendsto
      (fun index =>
        wholeTrajectorySpaceTimePath
          (commonTimeReplayDuration lineage)
          (replay.current (subsequence index)).trajectory
          (HasDerivAt.continuousOn
            (fun time timeMem =>
              ((replay.current
                (subsequence index)).physical
                  time timeMem).1)))
      atTop (𝓝 stateLimit)
  generatedRow_weak :
    ∀ wave : IntegerWavevector,
      (∃ entry : ℕ,
        wave ∈ (replay.current entry).modes) →
      ∃ nonlinearLimit :
          NonlinearRowSpaceTimeState
            (commonTimeReplayDuration lineage),
        Tendsto
            (fun index =>
              wholeNonlinearRowSpaceTimePath
                (commonTimeReplayDuration lineage)
                (replay.current
                  (subsequence index)).trajectory
                (fun time timeMem =>
                  (((replay.current
                    (subsequence index)).physical
                      time timeMem).1).continuousAt.continuousWithinAt)
                (fun time timeMem =>
                  ((replay.current
                    (subsequence index)).physical
                      time timeMem).2.2.1)
                wave)
            atTop (𝓝 nonlinearLimit) ∧
          ∀ (test testDerivative : ℝ → ℂ),
            ∀ (testHasDeriv :
                ∀ time ∈
                    Icc (0 : ℝ)
                      (commonTimeReplayDuration lineage),
                  HasDerivAt test
                    (testDerivative time) time)
              (testDerivativeContinuous :
                ContinuousOn testDerivative
                  (Icc (0 : ℝ)
                    (commonTimeReplayDuration lineage)))
              (_testZero : test 0 = 0)
              (_testTerminalZero :
                test (commonTimeReplayDuration lineage) = 0),
            fixedWaveWeakAction
                (commonTimeReplayDuration lineage)
                ν.coeff wave
                (restrictedScalarL2
                  (commonTimeReplayDuration lineage) test
                  (fun time timeMem =>
                    (testHasDeriv
                      time timeMem).continuousAt.continuousWithinAt))
                (restrictedScalarL2
                  (commonTimeReplayDuration lineage)
                  testDerivative
                  testDerivativeContinuous)
                (restrictedScalarLInf
                  (commonTimeReplayDuration lineage) test
                  (fun time timeMem =>
                    (testHasDeriv
                      time timeMem).continuousAt.continuousWithinAt))
                stateLimit nonlinearLimit =
              0

/--
Generate the all-tests weak closure from the actual infinite replay.  The
compact limit, reindexing, nonlinear row limits, and eventual row inclusion
are all produced internally.
-/
noncomputable def generatedCommonTimeReplayWeakClosure
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {initialSubcritical :
      ¬ lineageHalfCriticalCrossing lineage 0}
    (replay :
      GeneratedCommonTimeReplayInfiniteLineage
        lineage initialSubcritical) :
    GeneratedCommonTimeReplayWeakClosure replay := by
  let strongExists :=
    exists_replayTrajectory_strong_subsequence replay
  let stateLimit := Classical.choose strongExists
  have stateLimitSpec := Classical.choose_spec strongExists
  have stateLimitMem := stateLimitSpec.1
  let subsequence := Classical.choose stateLimitSpec.2
  have subsequenceSpec :=
    Classical.choose_spec stateLimitSpec.2
  have subsequenceMono := subsequenceSpec.1
  have stateTendsto := subsequenceSpec.2
  refine
    { stateLimit := stateLimit
      stateLimit_mem := stateLimitMem
      subsequence := subsequence
      subsequence_strictMono := subsequenceMono
      state_tendsto := stateTendsto
      generatedRow_weak := ?_ }
  intro wave waveGenerated
  let modes : ℕ → Finset IntegerWavevector :=
    fun index =>
      (replay.current (subsequence index)).modes
  let trajectories :
      ℕ → ℝ → ComplexVorticityHilbertState :=
    fun index =>
      (replay.current (subsequence index)).trajectory
  have evolves :
      ∀ index time,
        time ∈
            Icc (0 : ℝ)
              (commonTimeReplayDuration lineage) →
          HasDerivAt (trajectories index)
            (finiteStateVorticityGenerator
              (modes index) ν.coeff
              (trajectories index time))
            time := by
    intro index time timeMem
    exact
      ((replay.current
        (subsequence index)).physical time timeMem).1
  have supported :
      ∀ index time,
        time ∈
            Icc (0 : ℝ)
              (commonTimeReplayDuration lineage) →
          ∀ output : IntegerWavevector,
            output ∉ modes index →
              trajectories index time output = 0 := by
    intro index time timeMem output outputNotMem
    exact
      ((replay.current
        (subsequence index)).physical time timeMem).2.1
        output outputNotMem
  have transverse :
      ∀ index time,
        time ∈
            Icc (0 : ℝ)
              (commonTimeReplayDuration lineage) →
          WholeStateTransverse (trajectories index time) := by
    intro index time timeMem output
    exact
      ((replay.current
        (subsequence index)).physical time timeMem).2.2.1
        output
  have waveEventuallyMem :
      ∀ᶠ index : ℕ in atTop,
        wave ∈ modes index := by
    simpa only [modes, replayCriticalPath_support] using
      generatedReplayWave_eventually_mem_comp_strictMono
        replay subsequence subsequenceMono wave waveGenerated
  simpa only [trajectories, evolves, transverse] using
    finiteModeSequence_fixedWave_weakLimit_all_tests_of_wholeTendsto
      ν.coeff (commonTimeReplayDuration lineage)
      (commonTimeReplayDuration_pos lineage)
      modes trajectories evolves supported transverse
      stateLimit stateTendsto wave waveEventuallyMem

theorem nativeReplayStep_missing_mem_next
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {initialSubcritical :
      ¬ lineageHalfCriticalCrossing lineage 0}
    {current next : GeneratedCommonTimeReplayStage lineage}
    (step :
      NativeCommonTimeReplayStep
        lineage initialSubcritical current next)
    {wave : IntegerWavevector}
    (waveMem :
      wave ∈
        generatedMissingNonlinearModes
          current.endpointSource) :
    wave ∈ next.modes := by
  cases step with
  | expand missingNonempty =>
      rw [
        GeneratedCommonTimeReplayStage.next_modes,
        GeneratedCommonTimeReplayStage.nextModes_eq_modes_union_missing]
      exact Finset.mem_union_right _ waveMem

/--
Every actual endpoint missing row is written into the very next replay
support.  This is the native residual-to-support redirect consumed by the
weak closure, not a global lattice-coverage premise.
-/
theorem replayMissingWave_generated
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {initialSubcritical :
      ¬ lineageHalfCriticalCrossing lineage 0}
    (replay :
      GeneratedCommonTimeReplayInfiniteLineage
        lineage initialSubcritical)
    (index : ℕ)
    {wave : IntegerWavevector}
    (waveMem :
      wave ∈
        generatedMissingNonlinearModes
          (replay.current index).endpointSource) :
    ∃ entry : ℕ,
      wave ∈ (replay.current entry).modes := by
  refine ⟨index + 1, ?_⟩
  exact
    nativeReplayStep_missing_mem_next
      (replay.step index) waveMem

/--
Final source-owned PDE disposition.  The native whole-residual producer
itself generates exactly one of:

* an actual half-critical crossing;
* finite faithful endpoint residual closure; or
* an infinite strict replay together with the weak all-tests closure of the
  original actual unforced trajectories on every generated row.

No branch, margin, trajectory, target limit, subsequence, or coverage
certificate appears in the mouth.
-/
inductive GeneratedWholeResidualCommonTimeReplayWeakDisposition
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν) : Type
  | halfCritical
      (crossing : lineageHalfCriticalCrossing lineage 0)
  | terminal
      (initialSubcritical :
        ¬ lineageHalfCriticalCrossing lineage 0)
      (run :
        GeneratedCommonTimeReplayTerminalRun
          lineage initialSubcritical)
  | infinite
      (initialSubcritical :
        ¬ lineageHalfCriticalCrossing lineage 0)
      (replay :
        GeneratedCommonTimeReplayInfiniteLineage
          lineage initialSubcritical)
      (startsAtInitial :
        replay.current 0 =
          initialCommonTimeReplayStage lineage)
      (weakClosure :
        GeneratedCommonTimeReplayWeakClosure replay)

/--
The native whole-residual lineage generates the complete critical /
terminal / infinite-weak alternative without caller-selected analytic or
runtime data.
-/
noncomputable def
    generatedWholeResidualCommonTimeReplayWeakDisposition
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν) :
    GeneratedWholeResidualCommonTimeReplayWeakDisposition lineage := by
  cases
      generatedWholeResidualCommonTimeReplayDisposition
        lineage with
  | halfCritical crossing =>
      exact .halfCritical crossing
  | terminal initialSubcritical run =>
      exact .terminal initialSubcritical run
  | infinite initialSubcritical replay startsAtInitial =>
      exact
        .infinite initialSubcritical replay startsAtInitial
          (generatedCommonTimeReplayWeakClosure replay)

end

