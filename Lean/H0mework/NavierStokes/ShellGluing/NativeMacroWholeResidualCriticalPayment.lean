/-! ## Literal embedding into the receipt's Galerkin enstrophy -/

/--
The active scalar residual coordinates are a literal nonnegative sub-sum of
the full vorticity-gradient mass on the same actual receipt carrier.
-/
theorem lineageActiveWholeResidualEnstrophyMass_le_receiptEnstrophy
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (index : ℕ)
    (state : ComplexVorticityHilbertState) :
    lineageActiveWholeResidualEnstrophyMass lineage index state ≤
      finiteStateVorticityEnstrophyMass
        (generatedSupport
          (completeOmittedPhysicalLiftSource
            (lineage.current index).physicalSource))
        state := by
  classical
  let modes :=
    generatedSupport
      (completeOmittedPhysicalLiftSource
        (lineage.current index).physicalSource)
  let value : IntegerWavevector × Coordinate → ℝ :=
    fun residualIndex =>
      (integerWaveShellSq residualIndex.1 : ℝ) *
        Complex.normSq
          (state residualIndex.1 residualIndex.2)
  calc
    lineageActiveWholeResidualEnstrophyMass lineage index state =
        ∑ residualIndex ∈
            lineageActiveWholeResidualCoordinates lineage index,
          value residualIndex := by
      rfl
    _ ≤
        ∑ residualIndex ∈
            modes.product (Finset.univ : Finset Coordinate),
          value residualIndex := by
      apply Finset.sum_le_sum_of_subset_of_nonneg
      · intro residualIndex residualIndexMem
        have supportData := Finset.mem_filter.mp residualIndexMem
        have outputMem :
            residualIndex.1 ∈
              lineageMissingResidualSupport lineage index :=
          (Finset.mem_product.mp supportData.1).1
        apply Finset.mem_product.mpr
        constructor
        · dsimp [modes]
          rw [redirectedMacroPhysicalSupport_eq_support_union_missing]
          exact Finset.mem_union_right _ outputMem
        · exact Finset.mem_univ _
      · intro residualIndex residualIndexNotMem residualIndexMem
        dsimp [value]
        exact
          mul_nonneg
            (by
              exact_mod_cast
                integerWaveShellSq_nonneg residualIndex.1)
            (Complex.normSq_nonneg _)
    _ =
        ∑ wave ∈ modes,
          ∑ coordinate : Coordinate,
            value (wave, coordinate) := by
      exact Finset.sum_product _ _ _
    _ = finiteStateVorticityEnstrophyMass modes state := by
      unfold finiteStateVorticityEnstrophyMass
      apply Finset.sum_congr rfl
      intro wave waveMem
      dsimp [value]
      rw [integerWaveNormSq_eq_integerWaveShellSq]
      unfold complexCoordinateVectorNormSq
      rw [Finset.mul_sum]

private theorem activeWholeResidualMass_continuousOn
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (index : ℕ)
    {localTime : ℝ}
    (localTimeLe :
      localTime ≤ (lineage.physicalReceipt index).duration) :
    ContinuousOn
      (fun time =>
        lineageActiveWholeResidualEnstrophyMass
          lineage index
          ((lineage.physicalReceipt index).trajectory time))
      (Icc (0 : ℝ) localTime) := by
  unfold lineageActiveWholeResidualEnstrophyMass
  apply continuousOn_finsetSum
  intro residualIndex residualIndexMem
  have trajectoryContinuous :
      ContinuousOn
        (lineage.physicalReceipt index).trajectory
        (Icc (0 : ℝ) localTime) :=
    (adaptiveTrajectory_continuousOn lineage index).mono
      (Icc_subset_Icc le_rfl localTimeLe)
  have rowContinuous :
      ContinuousOn
        (fun time =>
          (lineage.physicalReceipt index).trajectory
            time residualIndex.1)
        (Icc (0 : ℝ) localTime) :=
    (lp.evalCLM
      ℝ (fun _ : IntegerWavevector => ComplexCoordinateVector)
      2 residualIndex.1).continuous.comp_continuousOn
        trajectoryContinuous
  have coordinateContinuous :
      ContinuousOn
        (fun time =>
          (lineage.physicalReceipt index).trajectory
            time residualIndex.1 residualIndex.2)
        (Icc (0 : ℝ) localTime) :=
    (ContinuousLinearMap.proj
      (R := ℂ) residualIndex.2).continuous.comp_continuousOn
        rowContinuous
  exact
    (Complex.continuous_normSq.comp_continuousOn
      coordinateContinuous).const_mul
        (integerWaveShellSq residualIndex.1 : ℝ)

/-! ## The fixed half-critical local consumer -/

/--
One actual native macro occurrence internally exhausts the fixed
half-critical crossing, faithful whole-residual closure, and strictly paid
active redirect.

In the paid branch the absorption coefficient multiplies the exact cubic
residual quantum and the result is strictly below the actual endpoint
half-enstrophy drop.  No critical-margin premise is accepted.
-/
theorem generatedWholeResidualRedirect_halfCriticalCubicPayment
    {ν : Viscosity}
    (lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν)
    (index : ℕ) :
    (1 / 2 : ℝ) * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 <
        criticalEnstrophyLatticeConstant *
          finiteStateVorticityCoefficientEnstrophy
            (generatedSupport
              (completeOmittedPhysicalLiftSource
                (lineage.current index).physicalSource))
            ((lineage.physicalReceipt index).trajectory 0) ∨
      lineageOwnedWholeResidual lineage index = 0 ∨
      (lineageOwnedWholeResidual lineage index ≠ 0 ∧
        ∃ localTime : ℝ,
          0 < localTime ∧
            localTime < (lineage.physicalReceipt index).duration ∧
            criticalEnstrophyAbsorptionCoefficient (1 / 2) ν *
                  (localTime ^ 3 *
                      lineageWholeResidualEnstrophyQuantum
                        lineage index /
                    12) <
              finiteStateVorticityHalfEnstrophy
                  (generatedSupport
                    (completeOmittedPhysicalLiftSource
                      (lineage.current index).physicalSource))
                  ((lineage.physicalReceipt index).trajectory 0) -
                finiteStateVorticityHalfEnstrophy
                  (generatedSupport
                    (completeOmittedPhysicalLiftSource
                      (lineage.current index).physicalSource))
                  ((lineage.physicalReceipt index).trajectory
                    (lineage.physicalReceipt index).duration)) := by
  classical
  let modes :=
    generatedSupport
      (completeOmittedPhysicalLiftSource
        (lineage.current index).physicalSource)
  let trajectory := (lineage.physicalReceipt index).trajectory
  let duration := (lineage.physicalReceipt index).duration
  by_cases crossed :
      (1 / 2 : ℝ) * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 <
        criticalEnstrophyLatticeConstant *
          finiteStateVorticityCoefficientEnstrophy
            modes (trajectory 0)
  · exact Or.inl (by simpa [modes, trajectory] using crossed)
  · right
    rcases
        generatedWholeResidualRedirect_actualCubicPayment
          lineage index with
      residualZero | active
    · exact Or.inl residualZero
    · right
      rcases active with
        ⟨residualNonzero, localTime, localTimePos,
          localTimeLtDuration, localPayment⟩
      have durationPos : 0 < duration := by
        simpa [duration] using
          (lineage.physicalReceipt index).duration_pos
      have initialHalfMargin :
          criticalEnstrophyLatticeConstant *
                finiteStateVorticityCoefficientEnstrophy
                  modes (trajectory 0) ≤
              (1 / 2 : ℝ) * ν.coeff ^ 2 *
                (2 * Real.pi) ^ 2 :=
        not_lt.mp crossed
      have negClosed :
          ∀ wave, wave ∈ modes → waveNeg wave ∈ modes := by
        intro wave waveMem
        exact
          generatedSupport_waveNeg_mem
            (completeOmittedPhysicalLiftSource
              (lineage.current index).physicalSource)
            waveMem
      have evolves :
          ∀ time ∈ Icc (0 : ℝ) duration,
            HasDerivAt trajectory
              (finiteStateVorticityGenerator
                modes ν.coeff (trajectory time))
              time := by
        intro time timeMem
        simpa [trajectory, duration, modes] using
          ((lineage.physicalReceipt index).physical
            time (by simpa [duration] using timeMem)).1
      have reality :
          ∀ time ∈ Icc (0 : ℝ) duration,
            FiniteStateFourierReality (trajectory time) := by
        intro time timeMem
        simpa [trajectory, duration] using
          ((lineage.physicalReceipt index).physical
            time (by simpa [duration] using timeMem)).2.2.2
      have transverse :
          ∀ time ∈ Icc (0 : ℝ) duration,
            ∀ wave ∈ modes,
              complexWavevector wave ⬝ᵥ trajectory time wave = 0 := by
        intro time timeMem wave waveMem
        simpa [trajectory, duration] using
          ((lineage.physicalReceipt index).physical
            time (by simpa [duration] using timeMem)).2.2.1 wave
      have criticalBudget :=
        finiteStateVorticity_criticalSerrinBudget_on_Icc
          modes negClosed ν (1 / 2) (by norm_num)
          trajectory 0 duration durationPos.le
          evolves reality transverse initialHalfMargin
      have fullMassContinuous :
          ContinuousOn
            (fun time =>
              finiteStateVorticityEnstrophyMass
                modes (trajectory time))
            (Icc (0 : ℝ) duration) := by
        intro time timeMem
        exact
          (finiteStateVorticityEnstrophyMass_continuousAt_of_hasDerivAt
            modes trajectory time
            (finiteStateVorticityGenerator
              modes ν.coeff (trajectory time))
            (evolves time timeMem)).continuousWithinAt
      have fullMassIntegrable :
          IntervalIntegrable
            (fun time =>
              finiteStateVorticityEnstrophyMass
                modes (trajectory time))
            volume 0 duration :=
        ContinuousOn.intervalIntegrable_of_Icc
          durationPos.le fullMassContinuous
      have fullMassIntegrableLocal :
          IntervalIntegrable
            (fun time =>
              finiteStateVorticityEnstrophyMass
                modes (trajectory time))
            volume 0 localTime :=
        ContinuousOn.intervalIntegrable_of_Icc
          localTimePos.le
          (fullMassContinuous.mono
            (Icc_subset_Icc le_rfl localTimeLtDuration.le))
      have activeMassIntegrable :
          IntervalIntegrable
            (fun time =>
              lineageActiveWholeResidualEnstrophyMass
                lineage index
                ((lineage.physicalReceipt index).trajectory time))
            volume 0 localTime :=
        ContinuousOn.intervalIntegrable_of_Icc
          localTimePos.le
          (activeWholeResidualMass_continuousOn
            lineage index localTimeLtDuration.le)
      have activeIntegralLeLocalFull :
          (∫ time in (0 : ℝ)..localTime,
              lineageActiveWholeResidualEnstrophyMass
                lineage index
                ((lineage.physicalReceipt index).trajectory time)) ≤
            ∫ time in (0 : ℝ)..localTime,
              finiteStateVorticityEnstrophyMass
                modes (trajectory time) := by
        apply intervalIntegral.integral_mono_on
          localTimePos.le activeMassIntegrable fullMassIntegrableLocal
        intro time timeMem
        simpa [modes, trajectory] using
          lineageActiveWholeResidualEnstrophyMass_le_receiptEnstrophy
            lineage index
            ((lineage.physicalReceipt index).trajectory time)
      have localFullLeWhole :
          (∫ time in (0 : ℝ)..localTime,
              finiteStateVorticityEnstrophyMass
                modes (trajectory time)) ≤
            ∫ time in (0 : ℝ)..duration,
              finiteStateVorticityEnstrophyMass
                modes (trajectory time) := by
        exact
          intervalIntegral.integral_mono_interval
            (μ := volume)
            (c := (0 : ℝ))
            (d := duration)
            le_rfl localTimePos.le localTimeLtDuration.le
            (Filter.Eventually.of_forall fun time =>
              finiteStateVorticityEnstrophyMass_nonneg
                modes (trajectory time))
            fullMassIntegrable
      have residualCostLtWhole :
          localTime ^ 3 *
                  lineageWholeResidualEnstrophyQuantum lineage index /
                12 <
              ∫ time in (0 : ℝ)..duration,
                finiteStateVorticityEnstrophyMass
                  modes (trajectory time) := by
        have localPayment' :
            localTime ^ 3 *
                    lineageWholeResidualEnstrophyQuantum lineage index /
                  12 <
                ∫ time in (0 : ℝ)..localTime,
                  lineageActiveWholeResidualEnstrophyMass
                    lineage index
                    ((lineage.physicalReceipt index).trajectory time) := by
          simpa using localPayment
        exact
          localPayment'.trans_le
            (activeIntegralLeLocalFull.trans localFullLeWhole)
      have absorptionPositive :
          0 <
            criticalEnstrophyAbsorptionCoefficient (1 / 2) ν :=
        criticalEnstrophyAbsorptionCoefficient_pos
          (1 / 2) (by norm_num) ν
      have paid :
          criticalEnstrophyAbsorptionCoefficient (1 / 2) ν *
                (localTime ^ 3 *
                    lineageWholeResidualEnstrophyQuantum lineage index /
                  12) <
              finiteStateVorticityHalfEnstrophy
                  modes (trajectory 0) -
                finiteStateVorticityHalfEnstrophy
                  modes (trajectory duration) :=
        (mul_lt_mul_of_pos_left
          residualCostLtWhole absorptionPositive).trans_le
          criticalBudget.2.1
      exact
        ⟨residualNonzero, localTime, localTimePos,
          localTimeLtDuration,
          by simpa [modes, trajectory, duration] using paid⟩

end

