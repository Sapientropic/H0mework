/--
Choose the row data already generated by the requested-time replay
closure.  The choice does not select a target path: every witness
represents the same whole replay state and carries the same source-owned
initial trace.
-/
noncomputable def requestedTimeReplayFixedWaveMildData
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {initialSubcritical :
      ¬ lineageHalfCriticalCrossing lineage 0}
    {requestedTime : ℝ}
    {requestedTimePos : 0 < requestedTime}
    {replay :
      GeneratedRequestedTimeReplayInfiniteLineage
        lineage initialSubcritical requestedTime requestedTimePos}
    (closure :
      GeneratedRequestedTimeReplayCriticalClosure replay)
    (wave : IntegerWavevector)
    (waveNonzero : wave ≠ 0) :
    FixedWaveContinuousMildData
      requestedTime ν.coeff wave
      (fun _index => commonTimeReplayInitialState lineage)
      closure.weakClosure.stateLimit
      (transverseSpaceTimeNonlinearRow
        closure.transverseLimit wave) :=
  Classical.choice
    (exists_fixedWaveContinuousMildData
      closure wave waveNonzero)

/--
The initial state carried by every chosen row is the source-owned common
initial state of the actual replay.
-/
theorem requestedTimeReplayFixedWaveMildData_initialLimit
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {initialSubcritical :
      ¬ lineageHalfCriticalCrossing lineage 0}
    {requestedTime : ℝ}
    {requestedTimePos : 0 < requestedTime}
    {replay :
      GeneratedRequestedTimeReplayInfiniteLineage
        lineage initialSubcritical requestedTime requestedTimePos}
    (closure :
      GeneratedRequestedTimeReplayCriticalClosure replay)
    (wave : IntegerWavevector)
    (waveNonzero : wave ≠ 0) :
    (requestedTimeReplayFixedWaveMildData
        closure wave waveNonzero).initialLimit =
      commonTimeReplayInitialState lineage := by
  exact
    tendsto_nhds_unique
      (requestedTimeReplayFixedWaveMildData
        closure wave waveNonzero).initial_tendsto
      tendsto_const_nhds

/--
The source-owned common initial state has no zero Fourier vorticity row.
-/
theorem requestedTimeReplayInitialState_zero_row
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {initialSubcritical :
      ¬ lineageHalfCriticalCrossing lineage 0}
    {requestedTime : ℝ}
    {requestedTimePos : 0 < requestedTime}
    {replay :
      GeneratedRequestedTimeReplayInfiniteLineage
        lineage initialSubcritical requestedTime requestedTimePos}
    (_closure :
      GeneratedRequestedTimeReplayCriticalClosure replay) :
    commonTimeReplayInitialState lineage 0 = 0 := by
  exact
    GeneratedRequestedTimeReplayStage.requestedInitial_supported
      (replay.current 0) 0
      (replay.current 0).zero_not_mem

/--
The zero Fourier row vanishes in the same strong requested-time replay
limit.
-/
theorem requestedTimeReplayStateLimit_zero_row
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {initialSubcritical :
      ¬ lineageHalfCriticalCrossing lineage 0}
    {requestedTime : ℝ}
    {requestedTimePos : 0 < requestedTime}
    {replay :
      GeneratedRequestedTimeReplayInfiniteLineage
        lineage initialSubcritical requestedTime requestedTimePos}
    (closure :
      GeneratedRequestedTimeReplayCriticalClosure replay) :
    fixedWaveSpaceTimeRestriction
        requestedTime 0 closure.weakClosure.stateLimit =
      0 := by
  have approximantZero :
      ∀ index : ℕ,
        fixedWaveSpaceTimeRestriction
            requestedTime 0
            (wholeTrajectorySpaceTimePath
              requestedTime
              (replay.current
                (closure.weakClosure.subsequence index)).trajectory
              (HasDerivAt.continuousOn
                (fun time timeMem =>
                  ((replay.current
                    (closure.weakClosure.subsequence index)).physical
                      time timeMem).1))) =
          0 := by
    intro index
    apply MeasureTheory.Lp.ext
    filter_upwards [
      fixedWaveSpaceTimeRestriction_coeFn
        requestedTime 0
        (wholeTrajectorySpaceTimePath
          requestedTime
          (replay.current
            (closure.weakClosure.subsequence index)).trajectory
          (HasDerivAt.continuousOn
            (fun time timeMem =>
              ((replay.current
                (closure.weakClosure.subsequence index)).physical
                  time timeMem).1))),
      BoundedContinuousFunction.coeFn_toLp
        (p := (2 : ℝ≥0∞))
        (μ := commonTimeMeasure requestedTime)
        ℂ
        (wholeTrajectoryBoundedPath
          requestedTime
          (replay.current
            (closure.weakClosure.subsequence index)).trajectory
          (HasDerivAt.continuousOn
            (fun time timeMem =>
              ((replay.current
                (closure.weakClosure.subsequence index)).physical
                  time timeMem).1))),
      MeasureTheory.Lp.coeFn_zero
        ComplexCoordinateVector 2
        (commonTimeMeasure requestedTime)] with
        time rowEq wholeEq zeroEq
    rw [rowEq, zeroEq]
    have statePoint :
        (wholeTrajectorySpaceTimePath
          requestedTime
          (replay.current
            (closure.weakClosure.subsequence index)).trajectory
          (HasDerivAt.continuousOn
            (fun actual actualMem =>
              ((replay.current
                (closure.weakClosure.subsequence index)).physical
                  actual actualMem).1))) time =
          (replay.current
            (closure.weakClosure.subsequence index)).trajectory
              time.1 := by
      have statePoint' :
          (wholeTrajectorySpaceTimePath
            requestedTime
            (replay.current
              (closure.weakClosure.subsequence index)).trajectory
            (HasDerivAt.continuousOn
              (fun actual actualMem =>
                ((replay.current
                  (closure.weakClosure.subsequence index)).physical
                    actual actualMem).1))) time =
            wholeTrajectoryBoundedPath requestedTime
              (replay.current
                (closure.weakClosure.subsequence index)).trajectory
              (HasDerivAt.continuousOn
                (fun actual actualMem =>
                  ((replay.current
                    (closure.weakClosure.subsequence index)).physical
                      actual actualMem).1)) time := by
        simpa [wholeTrajectorySpaceTimePath] using wholeEq
      exact statePoint'.trans rfl
    rw [statePoint]
    exact
      (replay.current
        (closure.weakClosure.subsequence index)).physical
          time.1 time.2 |>.2.1 0
          (replay.current
            (closure.weakClosure.subsequence index)).zero_not_mem
  have rowTendsto :
      Tendsto
        (fun index =>
          fixedWaveSpaceTimeRestriction
            requestedTime 0
            (wholeTrajectorySpaceTimePath
              requestedTime
              (replay.current
                (closure.weakClosure.subsequence index)).trajectory
              (HasDerivAt.continuousOn
                (fun time timeMem =>
                  ((replay.current
                    (closure.weakClosure.subsequence index)).physical
                      time timeMem).1))))
        atTop
        (𝓝
          (fixedWaveSpaceTimeRestriction
            requestedTime 0 closure.weakClosure.stateLimit)) :=
    (fixedWaveSpaceTimeRestriction
      requestedTime 0).continuous.tendsto
        closure.weakClosure.stateLimit |>.comp
          closure.weakClosure.state_tendsto
  have zeroTendsto :
      Tendsto
        (fun _ : ℕ =>
          (0 : FixedWaveSpaceTimeState requestedTime))
        atTop (𝓝 0) :=
    tendsto_const_nhds
  exact
    tendsto_nhds_unique rowTendsto <| by
      simpa only [approximantZero] using zeroTendsto

/--
All fields of the generic whole-mild compiler are generated on the same
actual requested-time replay closure.
-/
noncomputable def requestedTimeReplayWholeMildAssemblyInput
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {initialSubcritical :
      ¬ lineageHalfCriticalCrossing lineage 0}
    {requestedTime : ℝ}
    {requestedTimePos : 0 < requestedTime}
    {replay :
      GeneratedRequestedTimeReplayInfiniteLineage
        lineage initialSubcritical requestedTime requestedTimePos}
    (closure :
      GeneratedRequestedTimeReplayCriticalClosure replay) :
    WholeMildAssemblyInput ν requestedTime where
  time_pos :=
    requestedTimePos
  initialState :=
    commonTimeReplayInitialState lineage
  stateLimit :=
    closure.weakClosure.stateLimit
  negativeOneForcing :=
    negativeOneForcing closure
  nonlinearRow wave waveNonzero :=
    transverseSpaceTimeNonlinearRow
      closure.transverseLimit wave
  rowPath wave waveNonzero :=
    (requestedTimeReplayFixedWaveMildData
      closure wave waveNonzero).rowPath
  row_represents wave waveNonzero :=
    (requestedTimeReplayFixedWaveMildData
      closure wave waveNonzero).row_represents
  forcing_unweighted_row_ae wave waveNonzero :=
    negativeOneForcing_unweighted_row_ae
      closure wave waveNonzero
  row_mild_identity wave waveNonzero time := by
    have generated :=
      (requestedTimeReplayFixedWaveMildData
        closure wave waveNonzero).mild_identity time
    rw [requestedTimeReplayFixedWaveMildData_initialLimit
      closure wave waveNonzero] at generated
    exact generated
  stateLimit_zero_row :=
    requestedTimeReplayStateLimit_zero_row closure
  initialState_zero_row :=
    requestedTimeReplayInitialState_zero_row closure

/--
The actual requested-time replay compiles to one faithful whole continuous
mild path on the same requested horizon.
-/
noncomputable def requestedTimeReplayWholeMildAssembly
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {initialSubcritical :
      ¬ lineageHalfCriticalCrossing lineage 0}
    {requestedTime : ℝ}
    {requestedTimePos : 0 < requestedTime}
    {replay :
      GeneratedRequestedTimeReplayInfiniteLineage
        lineage initialSubcritical requestedTime requestedTimePos}
    (closure :
      GeneratedRequestedTimeReplayCriticalClosure replay) :
    WholeContinuousMildAssembly
      (requestedTimeReplayWholeMildAssemblyInput closure) :=
  (requestedTimeReplayWholeMildAssemblyInput closure).assemble

/--
The assembled continuous path is exactly the pre-existing strong
requested-time replay limit in the whole `L²_t ℓ²` carrier.
-/
theorem requestedTimeReplayWholeMildAssembly_toLp_eq
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {initialSubcritical :
      ¬ lineageHalfCriticalCrossing lineage 0}
    {requestedTime : ℝ}
    {requestedTimePos : 0 < requestedTime}
    {replay :
      GeneratedRequestedTimeReplayInfiniteLineage
        lineage initialSubcritical requestedTime requestedTimePos}
    (closure :
      GeneratedRequestedTimeReplayCriticalClosure replay) :
    BoundedContinuousFunction.toLp 2
        (commonTimeMeasure requestedTime) ℂ
        (requestedTimeReplayWholeMildAssembly closure).wholePath =
      closure.weakClosure.stateLimit :=
  (requestedTimeReplayWholeMildAssembly
    closure).wholePath_toLp_eq_stateLimit

/--
The requested-time critical gradient budget is carried by the same
assembled whole path.
-/
theorem requestedTimeReplayWholeMildAssembly_gradient_mass_le
    {ν : Viscosity}
    {lineage : GeneratedRedirectedCompleteRoundInfiniteLineage ν}
    {initialSubcritical :
      ¬ lineageHalfCriticalCrossing lineage 0}
    {requestedTime : ℝ}
    {requestedTimePos : 0 < requestedTime}
    {replay :
      GeneratedRequestedTimeReplayInfiniteLineage
        lineage initialSubcritical requestedTime requestedTimePos}
    (closure :
      GeneratedRequestedTimeReplayCriticalClosure replay) :
    wholeSpaceTimeVorticityGradientMass
        requestedTime
        (BoundedContinuousFunction.toLp 2
          (commonTimeMeasure requestedTime) ℂ
          (requestedTimeReplayWholeMildAssembly closure).wholePath) ≤
      requestedTimeReplayGradientCeiling ν := by
  rw [requestedTimeReplayWholeMildAssembly_toLp_eq closure]
  exact closure.gradient_mass_le

end

