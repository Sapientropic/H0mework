import Mathlib.MeasureTheory.Function.L2Space
import H0mework.NavierStokes.Galerkin.NegativeSobolevTimeBudget

/-!
# Low-frequency time equicontinuity from the actual Galerkin update

For an actual finite Galerkin trajectory, the fundamental theorem of
calculus and time Cauchy--Schwarz give, at every nonzero retained frequency,

```text
‖ω(b,k) - ω(a,k)‖²
  ≤ (b-a) λₖ ∫ₐᵇ ‖∂ₜω(t)‖²_{H⁻¹(modes)} dt,
```

where `λₖ = (2π)² |k|²` is the exact Fourier multiplier of `-Δ`.
The derivative and its integrability are generated by the actual
`finiteStateVorticityGenerator` law; neither an increment estimate nor an
equicontinuity witness is accepted as a premise.

Summing over an arbitrary finite observed inventory gives a modulus uniform
in every larger Galerkin carrier.  This is the finite-projection
equicontinuity input for a later compactness consumer.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalVorticityCoefficientFiniteGalerkinTimeEquicontinuity

open scoped BigOperators Interval ENNReal

open Set
open Filter
open MeasureTheory
open ThreeDimensionalPeriodicCoarseFilterCore
open ThreeDimensionalPeriodicIntegerCharacterCoarseFilter
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientStretchingPairTable
open ThreeDimensionalVorticityCoefficientFiniteSupportComplexTrajectory
open ThreeDimensionalVorticityCoefficientFiniteGalerkinNegativeSobolevTimeBudget

noncomputable section

/-! ## Time Cauchy--Schwarz on an actual compact interval -/

private theorem norm_intervalIntegral_sq_le_length_mul_integral_norm_sq
    {E : Type*}
    [NormedAddCommGroup E]
    [NormedSpace ℝ E]
    (f : ℝ → E)
    (a b : ℝ)
    (hab : a ≤ b)
    (fContinuous : ContinuousOn f (Icc a b)) :
    ‖∫ t in a..b, f t‖ ^ 2 ≤
      (b - a) * ∫ t in a..b, ‖f t‖ ^ 2 := by
  let μ : Measure ℝ := volume.restrict (Ioc a b)
  have normContinuous :
      ContinuousOn (fun t => ‖f t‖) (Icc a b) :=
    fContinuous.norm
  have normSqContinuous :
      ContinuousOn (fun t => ‖f t‖ ^ 2) (Icc a b) :=
    normContinuous.pow 2
  have normSqIntegrable :
      Integrable (fun t => ‖f t‖ ^ 2) μ := by
    change IntegrableOn (fun t => ‖f t‖ ^ 2) (Ioc a b)
    exact
      normSqContinuous.integrableOn_Icc.mono_set
        Ioc_subset_Icc_self
  have normIntegrable :
      Integrable (fun t => ‖f t‖) μ := by
    change IntegrableOn (fun t => ‖f t‖) (Ioc a b)
    exact
      normContinuous.integrableOn_Icc.mono_set
        Ioc_subset_Icc_self
  have normMemLpNat :
      MemLp (fun t => ‖f t‖) 2 μ :=
    (memLp_two_iff_integrable_sq
      normIntegrable.aestronglyMeasurable).mpr normSqIntegrable
  have normMemLp :
      MemLp (fun t => ‖f t‖) (ENNReal.ofReal (2 : ℝ)) μ := by
    simpa using normMemLpNat
  have oneMemLp :
      MemLp (fun _ : ℝ => (1 : ℝ))
        (ENNReal.ofReal (2 : ℝ)) μ :=
    memLp_const 1
  have cauchy :=
    integral_mul_le_Lp_mul_Lq_of_nonneg
      Real.HolderConjugate.two_two
      (μ := μ)
      (f := fun _ : ℝ => (1 : ℝ))
      (g := fun t => ‖f t‖)
      (Filter.Eventually.of_forall fun _ => zero_le_one)
      (Filter.Eventually.of_forall fun t => norm_nonneg (f t))
      oneMemLp normMemLp
  have measureReal : μ.real univ = b - a := by
    dsimp [μ]
    rw [
      measureReal_def,
      Measure.restrict_apply_univ,
      Real.volume_Ioc,
      ENNReal.toReal_ofReal (sub_nonneg.mpr hab)]
  have cauchySqrt :
      ∫ t, ‖f t‖ ∂μ ≤
        Real.sqrt (b - a) *
          Real.sqrt (∫ t, ‖f t‖ ^ 2 ∂μ) := by
    norm_num [measureReal, Real.sqrt_eq_rpow] at cauchy ⊢
    exact cauchy
  rw [
    intervalIntegral.integral_of_le hab,
    intervalIntegral.integral_of_le hab]
  change
    ‖∫ t, f t ∂μ‖ ^ 2 ≤
      (b - a) * ∫ t, ‖f t‖ ^ 2 ∂μ
  have normIntegralLe :
      ‖∫ t, f t ∂μ‖ ≤ ∫ t, ‖f t‖ ∂μ :=
    norm_integral_le_integral_norm _
  have rhsSqrtNonneg :
      0 ≤
        Real.sqrt (b - a) *
          Real.sqrt (∫ t, ‖f t‖ ^ 2 ∂μ) :=
    mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
  have chained :
      ‖∫ t, f t ∂μ‖ ≤
        Real.sqrt (b - a) *
          Real.sqrt (∫ t, ‖f t‖ ^ 2 ∂μ) :=
    normIntegralLe.trans cauchySqrt
  have squared :=
    (sq_le_sq₀ (norm_nonneg _) rhsSqrtNonneg).mpr chained
  rw [
    mul_pow,
    Real.sq_sqrt (sub_nonneg.mpr hab),
    Real.sq_sqrt
      (integral_nonneg fun t => sq_nonneg ‖f t‖)] at squared
  exact squared

private theorem continuousAt_finset_sum
    {α E : Type*}
    [DecidableEq α]
    [TopologicalSpace E]
    [AddCommMonoid E]
    [ContinuousAdd E]
    (indices : Finset α)
    (summand : α → ℝ → E)
    (t : ℝ)
    (continuousSummand :
      ∀ index ∈ indices, ContinuousAt (summand index) t) :
    ContinuousAt
      (fun time => ∑ index ∈ indices, summand index time) t := by
  induction indices using Finset.induction_on with
  | empty =>
      simpa using
        (continuousAt_const :
          ContinuousAt (fun _ : ℝ => (0 : E)) t)
  | @insert index indices indexNotMem inductionHypothesis =>
      simp only [Finset.sum_insert indexNotMem]
      exact
        (continuousSummand index (by simp)).add
          (inductionHypothesis fun later laterMem =>
            continuousSummand later (by simp [laterMem]))

/-! ## Continuity generated by the actual update law -/

private theorem finiteGalerkinGeneratorRow_continuousOn
    (modes : Finset IntegerWavevector)
    (ν : ℝ)
    (trajectory : ℝ → ComplexVorticityHilbertState)
    (wave : IntegerWavevector)
    (a b : ℝ)
    (evolves :
      ∀ t ∈ Icc a b,
        HasDerivAt trajectory
          (finiteStateVorticityGenerator
            modes ν (trajectory t)) t) :
    ContinuousOn
      (fun t =>
        finiteStateVorticityGenerator
          modes ν (trajectory t) wave)
      (Icc a b) := by
  intro t tMem
  exact
    (((complexVorticityEvaluation_contDiff wave).continuous.comp
      (finiteStateVorticityGenerator_contDiff
        modes ν).continuous).continuousAt.comp
          (evolves t tMem).continuousAt).continuousWithinAt

/-- The actual Galerkin update makes its row-weighted `H⁻¹` tangent mass
continuous on every interval on which the update law holds. -/
theorem finiteGalerkinGeneratorNegativeOneMass_continuousOn
    (modes : Finset IntegerWavevector)
    (ν : ℝ)
    (trajectory : ℝ → ComplexVorticityHilbertState)
    (a b : ℝ)
    (evolves :
      ∀ t ∈ Icc a b,
        HasDerivAt trajectory
          (finiteStateVorticityGenerator
            modes ν (trajectory t)) t) :
    ContinuousOn
      (fun t =>
        finiteStateVorticityNegativeOneMass modes
          (finiteStateVorticityGenerator
            modes ν (trajectory t)))
      (Icc a b) := by
  intro t tMem
  have massContinuousAt :
      ContinuousAt
        (fun t =>
          finiteStateVorticityNegativeOneMass modes
            (finiteStateVorticityGenerator
              modes ν (trajectory t))) t := by
    unfold finiteStateVorticityNegativeOneMass
    apply continuousAt_finset_sum
    intro output outputMem
    by_cases outputZero : output = 0
    · simp only [if_pos outputZero]
      exact continuousAt_const
    · simp only [if_neg outputZero]
      have rowContinuous :
          ContinuousAt
            (fun time =>
              finiteStateVorticityGenerator
                modes ν (trajectory time) output) t := by
        exact
          (((complexVorticityEvaluation_contDiff output).continuous.comp
            (finiteStateVorticityGenerator_contDiff
              modes ν).continuous).continuousAt.comp
                (evolves t tMem).continuousAt)
      exact
        (rowContinuous.norm.pow 2).div_const _
  exact massContinuousAt.continuousWithinAt

/-! ## Fixed-row increment -/

private theorem finiteGalerkinGeneratorRow_sq_le_negativeOneMass
    (modes : Finset IntegerWavevector)
    (ν : ℝ)
    (state : ComplexVorticityHilbertState)
    (wave : IntegerWavevector)
    (waveMem : wave ∈ modes)
    (waveNe : wave ≠ 0) :
    ‖finiteStateVorticityGenerator modes ν state wave‖ ^ 2 ≤
      integerWaveViscousMultiplier wave *
        finiteStateVorticityNegativeOneMass modes
          (finiteStateVorticityGenerator modes ν state) := by
  have multiplierPos :
      0 < integerWaveViscousMultiplier wave := by
    unfold integerWaveViscousMultiplier
    exact
      mul_pos
        (sq_pos_of_pos (mul_pos (by norm_num) Real.pi_pos))
        (integerWaveNormSq_pos waveNe)
  have rowDensityLe :
      ‖finiteStateVorticityGenerator modes ν state wave‖ ^ 2 /
          integerWaveViscousMultiplier wave ≤
        finiteStateVorticityNegativeOneMass modes
          (finiteStateVorticityGenerator modes ν state) := by
    unfold finiteStateVorticityNegativeOneMass
    have termNonneg :
        ∀ output ∈ modes,
          0 ≤
            if output = 0 then 0
            else
              ‖finiteStateVorticityGenerator
                  modes ν state output‖ ^ 2 /
                integerWaveViscousMultiplier output := by
      intro output outputMem
      by_cases outputZero : output = 0
      · simp [outputZero]
      · rw [if_neg outputZero]
        exact
          div_nonneg (sq_nonneg _)
            (mul_nonneg (sq_nonneg _)
              (integerWaveNormSq_nonneg output))
    simpa [waveNe] using
      (Finset.single_le_sum termNonneg waveMem)
  calc
    ‖finiteStateVorticityGenerator modes ν state wave‖ ^ 2 =
      integerWaveViscousMultiplier wave *
        (‖finiteStateVorticityGenerator modes ν state wave‖ ^ 2 /
          integerWaveViscousMultiplier wave) := by
      field_simp [ne_of_gt multiplierPos]
    _ ≤
      integerWaveViscousMultiplier wave *
        finiteStateVorticityNegativeOneMass modes
          (finiteStateVorticityGenerator modes ν state) :=
      mul_le_mul_of_nonneg_left rowDensityLe multiplierPos.le

/-- A fixed retained nonzero Fourier row is `1/2`-Hölder in time with the
modulus generated by the actual `L²_t H⁻¹` tangent mass. -/
theorem finiteGalerkinWave_timeIncrement_sq_le_negativeOneMass
    (modes : Finset IntegerWavevector)
    (ν : ℝ)
    (trajectory : ℝ → ComplexVorticityHilbertState)
    (wave : IntegerWavevector)
    (waveMem : wave ∈ modes)
    (waveNe : wave ≠ 0)
    (a b : ℝ)
    (hab : a ≤ b)
    (evolves :
      ∀ t ∈ Icc a b,
        HasDerivAt trajectory
          (finiteStateVorticityGenerator
            modes ν (trajectory t)) t) :
    ‖trajectory b wave - trajectory a wave‖ ^ 2 ≤
      (b - a) * integerWaveViscousMultiplier wave *
        ∫ t in a..b,
          finiteStateVorticityNegativeOneMass modes
            (finiteStateVorticityGenerator
              modes ν (trajectory t)) := by
  let tangentRow : ℝ → ComplexCoordinateVector :=
    fun t =>
      finiteStateVorticityGenerator
        modes ν (trajectory t) wave
  have tangentRowContinuous :
      ContinuousOn tangentRow (Icc a b) :=
    finiteGalerkinGeneratorRow_continuousOn
      modes ν trajectory wave a b evolves
  have tangentRowIntegrable :
      IntervalIntegrable tangentRow volume a b :=
    ContinuousOn.intervalIntegrable_of_Icc
      hab tangentRowContinuous
  have rowFTC :
      (∫ t in a..b, tangentRow t) =
        trajectory b wave - trajectory a wave := by
    apply
      intervalIntegral.integral_eq_sub_of_hasDerivAt
        (f := fun t => trajectory t wave)
        (f' := tangentRow)
    · intro t tMem
      apply
        complexVorticityTrajectoryWave_hasDerivAt
          trajectory t
          (finiteStateVorticityGenerator
            modes ν (trajectory t)) wave
      apply evolves t
      rwa [uIcc_of_le hab] at tMem
    · exact tangentRowIntegrable
  have cauchy :
      ‖trajectory b wave - trajectory a wave‖ ^ 2 ≤
        (b - a) * ∫ t in a..b, ‖tangentRow t‖ ^ 2 := by
    rw [← rowFTC]
    exact
      norm_intervalIntegral_sq_le_length_mul_integral_norm_sq
        tangentRow a b hab tangentRowContinuous
  have massContinuous :
      ContinuousOn
        (fun t =>
          finiteStateVorticityNegativeOneMass modes
            (finiteStateVorticityGenerator
              modes ν (trajectory t)))
        (Icc a b) :=
    finiteGalerkinGeneratorNegativeOneMass_continuousOn
      modes ν trajectory a b evolves
  have tangentNormSqIntegrable :
      IntervalIntegrable
        (fun t => ‖tangentRow t‖ ^ 2) volume a b :=
    ContinuousOn.intervalIntegrable_of_Icc hab
      (tangentRowContinuous.norm.pow 2)
  have scaledMassIntegrable :
      IntervalIntegrable
        (fun t =>
          integerWaveViscousMultiplier wave *
            finiteStateVorticityNegativeOneMass modes
              (finiteStateVorticityGenerator
                modes ν (trajectory t)))
        volume a b :=
    (ContinuousOn.intervalIntegrable_of_Icc
      hab massContinuous).const_mul _
  have integratedRowLe :
      (∫ t in a..b, ‖tangentRow t‖ ^ 2) ≤
        ∫ t in a..b,
          integerWaveViscousMultiplier wave *
            finiteStateVorticityNegativeOneMass modes
              (finiteStateVorticityGenerator
                modes ν (trajectory t)) := by
    apply
      intervalIntegral.integral_mono_on
        hab tangentNormSqIntegrable scaledMassIntegrable
    intro t tMem
    exact
      finiteGalerkinGeneratorRow_sq_le_negativeOneMass
        modes ν (trajectory t) wave waveMem waveNe
  rw [intervalIntegral.integral_const_mul] at integratedRowLe
  calc
    ‖trajectory b wave - trajectory a wave‖ ^ 2 ≤
      (b - a) * ∫ t in a..b, ‖tangentRow t‖ ^ 2 :=
      cauchy
    _ ≤
      (b - a) *
        (integerWaveViscousMultiplier wave *
          ∫ t in a..b,
            finiteStateVorticityNegativeOneMass modes
              (finiteStateVorticityGenerator
                modes ν (trajectory t))) :=
      mul_le_mul_of_nonneg_left integratedRowLe
        (sub_nonneg.mpr hab)
    _ =
      (b - a) * integerWaveViscousMultiplier wave *
        ∫ t in a..b,
          finiteStateVorticityNegativeOneMass modes
            (finiteStateVorticityGenerator
              modes ν (trajectory t)) := by
      ring

/-! ## Uniform finite observed inventory -/

/-- Summed time equicontinuity on any finite nonzero observed inventory.
The constant depends only on the observed frequencies, not on the size or
largest frequency of the ambient Galerkin carrier. -/
theorem finiteGalerkinFiniteInventory_timeIncrement_sq_le_negativeOneMass
    (modes observed : Finset IntegerWavevector)
    (observedSubset : observed ⊆ modes)
    (observedZeroFree :
      ∀ wave ∈ observed, wave ≠ 0)
    (ν : ℝ)
    (trajectory : ℝ → ComplexVorticityHilbertState)
    (a b : ℝ)
    (hab : a ≤ b)
    (evolves :
      ∀ t ∈ Icc a b,
        HasDerivAt trajectory
          (finiteStateVorticityGenerator
            modes ν (trajectory t)) t) :
    (∑ wave ∈ observed,
        ‖trajectory b wave - trajectory a wave‖ ^ 2) ≤
      (b - a) *
        (∑ wave ∈ observed,
          integerWaveViscousMultiplier wave) *
        ∫ t in a..b,
          finiteStateVorticityNegativeOneMass modes
            (finiteStateVorticityGenerator
              modes ν (trajectory t)) := by
  calc
    (∑ wave ∈ observed,
        ‖trajectory b wave - trajectory a wave‖ ^ 2) ≤
      ∑ wave ∈ observed,
        ((b - a) * integerWaveViscousMultiplier wave *
          ∫ t in a..b,
            finiteStateVorticityNegativeOneMass modes
              (finiteStateVorticityGenerator
                modes ν (trajectory t))) := by
      apply Finset.sum_le_sum
      intro wave waveMem
      exact
        finiteGalerkinWave_timeIncrement_sq_le_negativeOneMass
          modes ν trajectory wave
          (observedSubset waveMem)
          (observedZeroFree wave waveMem)
          a b hab evolves
    _ =
      (b - a) *
        (∑ wave ∈ observed,
          integerWaveViscousMultiplier wave) *
        ∫ t in a..b,
          finiteStateVorticityNegativeOneMass modes
            (finiteStateVorticityGenerator
              modes ν (trajectory t)) := by
      rw [Finset.mul_sum, Finset.sum_mul]

private theorem finiteGalerkinObservedGeneratorSquare_le_multiplierCeiling
    (modes observed : Finset IntegerWavevector)
    (observedSubset : observed ⊆ modes)
    (observedZeroFree : ∀ wave ∈ observed, wave ≠ 0)
    (multiplierCeiling : ℝ)
    (multiplierNonneg : 0 ≤ multiplierCeiling)
    (multiplierLe :
      ∀ wave ∈ observed,
        integerWaveViscousMultiplier wave ≤ multiplierCeiling)
    (ν : ℝ)
    (state : ComplexVorticityHilbertState) :
    (∑ wave ∈ observed,
        ‖finiteStateVorticityGenerator modes ν state wave‖ ^ 2) ≤
      multiplierCeiling *
        finiteStateVorticityNegativeOneMass modes
          (finiteStateVorticityGenerator modes ν state) := by
  let tangent := finiteStateVorticityGenerator modes ν state
  have multiplierPos (wave : IntegerWavevector)
      (waveMem : wave ∈ observed) :
      0 < integerWaveViscousMultiplier wave := by
    unfold integerWaveViscousMultiplier
    exact
      mul_pos
        (sq_pos_of_pos (mul_pos (by norm_num) Real.pi_pos))
        (integerWaveNormSq_pos (observedZeroFree wave waveMem))
  have rowEq (wave : IntegerWavevector) (waveMem : wave ∈ observed) :
      ‖tangent wave‖ ^ 2 =
        integerWaveViscousMultiplier wave *
          (‖tangent wave‖ ^ 2 /
            integerWaveViscousMultiplier wave) := by
    field_simp [(multiplierPos wave waveMem).ne']
  have densityNonneg (wave : IntegerWavevector)
      (waveMem : wave ∈ observed) :
      0 ≤ ‖tangent wave‖ ^ 2 /
        integerWaveViscousMultiplier wave :=
    div_nonneg (sq_nonneg _) (multiplierPos wave waveMem).le
  have weightedLe :
      (∑ wave ∈ observed, ‖tangent wave‖ ^ 2) ≤
        multiplierCeiling *
          ∑ wave ∈ observed,
            (‖tangent wave‖ ^ 2 /
              integerWaveViscousMultiplier wave) := by
    rw [Finset.mul_sum]
    apply Finset.sum_le_sum
    intro wave waveMem
    calc
      ‖tangent wave‖ ^ 2 =
          integerWaveViscousMultiplier wave *
            (‖tangent wave‖ ^ 2 /
              integerWaveViscousMultiplier wave) := rowEq wave waveMem
      _ ≤ multiplierCeiling *
            (‖tangent wave‖ ^ 2 /
              integerWaveViscousMultiplier wave) :=
        mul_le_mul_of_nonneg_right
          (multiplierLe wave waveMem) (densityNonneg wave waveMem)
  have subsetLe :
      (∑ wave ∈ observed,
          (‖tangent wave‖ ^ 2 /
            integerWaveViscousMultiplier wave)) ≤
        finiteStateVorticityNegativeOneMass modes tangent := by
    unfold finiteStateVorticityNegativeOneMass
    have termNonneg :
        ∀ output ∈ modes,
          0 ≤ if output = 0 then 0
            else ‖tangent output‖ ^ 2 /
              integerWaveViscousMultiplier output := by
      intro output _outputMem
      split_ifs
      · exact le_rfl
      · exact
          div_nonneg (sq_nonneg _)
            (by
              unfold integerWaveViscousMultiplier
              exact mul_nonneg (sq_nonneg _)
                (integerWaveNormSq_nonneg output))
    have raw :=
      Finset.sum_le_sum_of_subset_of_nonneg observedSubset
        (fun wave waveMem _waveNotMem => termNonneg wave waveMem)
    calc
      (∑ wave ∈ observed,
          ‖tangent wave‖ ^ 2 /
            integerWaveViscousMultiplier wave) =
          ∑ wave ∈ observed,
            if wave = 0 then 0
            else ‖tangent wave‖ ^ 2 /
              integerWaveViscousMultiplier wave := by
        apply Finset.sum_congr rfl
        intro wave waveMem
        rw [if_neg (observedZeroFree wave waveMem)]
      _ ≤ ∑ wave ∈ modes,
            if wave = 0 then 0
            else ‖tangent wave‖ ^ 2 /
              integerWaveViscousMultiplier wave := raw
  exact weightedLe.trans
    (mul_le_mul_of_nonneg_left subsetLe multiplierNonneg)

/-- Summed time equicontinuity on a whole finite physical band.  Unlike the
rowwise estimate above, the constant is the largest retained Laplacian
multiplier, not the sum of all retained multipliers.  This is the form that
remains uniform when a fixed physical band is represented on expanding
periodic cells. -/
theorem finiteGalerkinFiniteInventory_timeIncrement_sq_le_multiplierCeiling
    (modes observed : Finset IntegerWavevector)
    (observedSubset : observed ⊆ modes)
    (observedZeroFree : ∀ wave ∈ observed, wave ≠ 0)
    (multiplierCeiling : ℝ)
    (multiplierNonneg : 0 ≤ multiplierCeiling)
    (multiplierLe :
      ∀ wave ∈ observed,
        integerWaveViscousMultiplier wave ≤ multiplierCeiling)
    (ν : ℝ)
    (trajectory : ℝ → ComplexVorticityHilbertState)
    (a b : ℝ)
    (hab : a ≤ b)
    (evolves :
      ∀ t ∈ Icc a b,
        HasDerivAt trajectory
          (finiteStateVorticityGenerator
            modes ν (trajectory t)) t) :
    (∑ wave ∈ observed,
        ‖trajectory b wave - trajectory a wave‖ ^ 2) ≤
      (b - a) * multiplierCeiling *
        ∫ t in a..b,
          finiteStateVorticityNegativeOneMass modes
            (finiteStateVorticityGenerator
              modes ν (trajectory t)) := by
  let tangentRow : IntegerWavevector → ℝ → ComplexCoordinateVector :=
    fun wave t =>
      finiteStateVorticityGenerator modes ν (trajectory t) wave
  have tangentRowContinuous (wave : IntegerWavevector) :
      ContinuousOn (tangentRow wave) (Icc a b) :=
    finiteGalerkinGeneratorRow_continuousOn
      modes ν trajectory wave a b evolves
  have tangentRowIntegrable (wave : IntegerWavevector) :
      IntervalIntegrable (tangentRow wave) volume a b :=
    ContinuousOn.intervalIntegrable_of_Icc hab
      (tangentRowContinuous wave)
  have rowIncrementLe (wave : IntegerWavevector) :
      ‖trajectory b wave - trajectory a wave‖ ^ 2 ≤
        (b - a) * ∫ t in a..b, ‖tangentRow wave t‖ ^ 2 := by
    have rowFTC :
        (∫ t in a..b, tangentRow wave t) =
          trajectory b wave - trajectory a wave := by
      apply
        intervalIntegral.integral_eq_sub_of_hasDerivAt
          (f := fun t => trajectory t wave)
          (f' := tangentRow wave)
      · intro t tMem
        exact
          complexVorticityTrajectoryWave_hasDerivAt
            trajectory t
            (finiteStateVorticityGenerator modes ν (trajectory t))
            wave (evolves t (by rwa [uIcc_of_le hab] at tMem))
      · exact tangentRowIntegrable wave
    rw [← rowFTC]
    exact
      norm_intervalIntegral_sq_le_length_mul_integral_norm_sq
        (tangentRow wave) a b hab (tangentRowContinuous wave)
  have sumIncrementLe :
      (∑ wave ∈ observed,
          ‖trajectory b wave - trajectory a wave‖ ^ 2) ≤
        (b - a) *
          ∫ t in a..b,
            ∑ wave ∈ observed, ‖tangentRow wave t‖ ^ 2 := by
    calc
      (∑ wave ∈ observed,
          ‖trajectory b wave - trajectory a wave‖ ^ 2) ≤
          ∑ wave ∈ observed,
            ((b - a) *
              ∫ t in a..b, ‖tangentRow wave t‖ ^ 2) := by
        apply Finset.sum_le_sum
        intro wave _waveMem
        exact rowIncrementLe wave
      _ = (b - a) *
          ∑ wave ∈ observed,
            (∫ t in a..b, ‖tangentRow wave t‖ ^ 2) := by
        rw [Finset.mul_sum]
      _ = (b - a) *
          ∫ t in a..b,
            ∑ wave ∈ observed, ‖tangentRow wave t‖ ^ 2 := by
        rw [intervalIntegral.integral_finsetSum]
        intro wave _waveMem
        exact
          ContinuousOn.intervalIntegrable_of_Icc hab
            ((tangentRowContinuous wave).norm.pow 2)
  have tangentSumContinuous :
      ContinuousOn
        (fun t => ∑ wave ∈ observed, ‖tangentRow wave t‖ ^ 2)
        (Icc a b) := by
    apply continuousOn_finsetSum
    intro wave _waveMem
    exact (tangentRowContinuous wave).norm.pow 2
  have tangentSumIntegrable :
      IntervalIntegrable
        (fun t => ∑ wave ∈ observed, ‖tangentRow wave t‖ ^ 2)
        volume a b :=
    ContinuousOn.intervalIntegrable_of_Icc hab tangentSumContinuous
  have massContinuous :=
    finiteGalerkinGeneratorNegativeOneMass_continuousOn
      modes ν trajectory a b evolves
  have scaledMassIntegrable :
      IntervalIntegrable
        (fun t => multiplierCeiling *
          finiteStateVorticityNegativeOneMass modes
            (finiteStateVorticityGenerator modes ν (trajectory t)))
        volume a b :=
    (ContinuousOn.intervalIntegrable_of_Icc hab massContinuous).const_mul _
  have integralLe :
      (∫ t in a..b,
          ∑ wave ∈ observed, ‖tangentRow wave t‖ ^ 2) ≤
        ∫ t in a..b, multiplierCeiling *
          finiteStateVorticityNegativeOneMass modes
            (finiteStateVorticityGenerator modes ν (trajectory t)) := by
    apply intervalIntegral.integral_mono_on hab
      tangentSumIntegrable scaledMassIntegrable
    intro t _tMem
    exact
      finiteGalerkinObservedGeneratorSquare_le_multiplierCeiling
        modes observed observedSubset observedZeroFree
        multiplierCeiling multiplierNonneg multiplierLe ν (trajectory t)
  rw [intervalIntegral.integral_const_mul] at integralLe
  calc
    (∑ wave ∈ observed,
        ‖trajectory b wave - trajectory a wave‖ ^ 2) ≤
      (b - a) *
        ∫ t in a..b,
          ∑ wave ∈ observed, ‖tangentRow wave t‖ ^ 2 :=
      sumIncrementLe
    _ ≤ (b - a) *
        (multiplierCeiling *
          ∫ t in a..b,
            finiteStateVorticityNegativeOneMass modes
              (finiteStateVorticityGenerator
                modes ν (trajectory t))) :=
      mul_le_mul_of_nonneg_left integralLe (sub_nonneg.mpr hab)
    _ = (b - a) * multiplierCeiling *
        ∫ t in a..b,
          finiteStateVorticityNegativeOneMass modes
            (finiteStateVorticityGenerator
              modes ν (trajectory t)) := by
      ring

end

