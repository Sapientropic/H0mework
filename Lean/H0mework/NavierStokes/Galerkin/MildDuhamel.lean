import H0mework.NavierStokes.InitialData.FiniteSupportComplexTrajectory
import Mathlib.MeasureTheory.Integral.IntervalIntegral.FundThmCalculus
import Mathlib.Analysis.SpecialFunctions.ExpDeriv
import Mathlib.Analysis.Calculus.Deriv.Mul
import Mathlib.Tactic.Ring

/-!
# Fourier mild identity for the actual finite vorticity Galerkin flow

The whole-carrier evolution already produced by
`finiteStateVorticityGenerator` contains an unbounded-in-frequency viscous
row.  This module moves that row exactly into its Fourier heat multiplier.
The integral that remains contains only the actual nonlinear tangent.

This is an integrating-factor consequence of the existing evolution law.
Neither the mild identity, an endpoint state, nor an analytic estimate is a
premise.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalVorticityCoefficientFiniteGalerkinMildDuhamel

open Set
open ThreeDimensionalPeriodicIntegerCharacterCoarseFilter
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientFiniteSupportComplexTrajectory

noncomputable section

/-- Fourier heat multiplier generated by the exact viscous row of the
finite Galerkin vorticity equation. -/
def finiteStateVorticityHeatMultiplier
    (ν duration : ℝ)
    (wave : IntegerWavevector) : ℝ :=
  Real.exp (-(ν * integerWaveViscousMultiplier wave) * duration)

/-- Differentiating the integrating-factor row cancels the complete viscous
tangent and leaves only the actual nonlinear coefficient. -/
private theorem finiteGalerkinWave_weighted_hasDerivAt
    (modes : Finset IntegerWavevector)
    (wave : IntegerWavevector)
    (waveMem : wave ∈ modes)
    (ν : ℝ)
    (trajectory : ℝ → ComplexVorticityHilbertState)
    (t : ℝ)
    (evolves :
      HasDerivAt trajectory
        (finiteStateVorticityGenerator modes ν (trajectory t)) t) :
    HasDerivAt
      (fun time =>
        Real.exp
            ((ν * integerWaveViscousMultiplier wave) * time) •
          trajectory time wave)
      (Real.exp
          ((ν * integerWaveViscousMultiplier wave) * t) •
        finiteStateVorticityNonlinearCoefficientAt
          modes (trajectory t) wave)
      t := by
  let c : ℝ := ν * integerWaveViscousMultiplier wave
  have rowDerivative :=
    complexVorticityTrajectoryWave_hasDerivAt
      trajectory t
      (finiteStateVorticityGenerator modes ν (trajectory t))
      wave evolves
  rw [finiteStateVorticityGenerator_apply, if_pos waveMem] at rowDerivative
  have weightedDerivative :=
    (((hasDerivAt_id t).const_mul c).exp).smul rowDerivative
  dsimp only [id_eq] at weightedDerivative
  have weightedFunction :
      ((fun x => Real.exp (c * x)) •
          (fun time => trajectory time wave)) =
        (fun time =>
          Real.exp (c * time) • trajectory time wave) := by
    funext time coordinate
    rfl
  rw [weightedFunction] at weightedDerivative
  rw [show ν * integerWaveViscousMultiplier wave = c by rfl] at rowDerivative weightedDerivative ⊢
  simpa only [
      smul_sub,
      smul_smul,
      one_mul,
      mul_one,
      sub_add_cancel] using weightedDerivative

/-- Exact integrating-factor ledger for one Fourier row of an actual finite
Galerkin trajectory.  Continuity and integrability are generated from the
evolution law rather than accepted separately. -/
theorem finiteGalerkinWave_integratingFactor_identity
    (modes : Finset IntegerWavevector)
    (wave : IntegerWavevector)
    (waveMem : wave ∈ modes)
    (ν : ℝ)
    (trajectory : ℝ → ComplexVorticityHilbertState)
    (a b : ℝ)
    (hab : a ≤ b)
    (evolves :
      ∀ t ∈ Icc a b,
        HasDerivAt trajectory
          (finiteStateVorticityGenerator modes ν (trajectory t)) t) :
    (∫ t in a..b,
        Real.exp
            ((ν * integerWaveViscousMultiplier wave) * t) •
          finiteStateVorticityNonlinearCoefficientAt
            modes (trajectory t) wave) =
      Real.exp
          ((ν * integerWaveViscousMultiplier wave) * b) •
        trajectory b wave -
      Real.exp
          ((ν * integerWaveViscousMultiplier wave) * a) •
        trajectory a wave := by
  let c : ℝ := ν * integerWaveViscousMultiplier wave
  have integrandContinuous :
      ContinuousOn
        (fun t =>
          Real.exp (c * t) •
            finiteStateVorticityNonlinearCoefficientAt
              modes (trajectory t) wave)
        (Icc a b) := by
    intro t ht
    have trajectoryContinuous : ContinuousAt trajectory t :=
      (evolves t ht).continuousAt
    have nonlinearContinuous :
        ContinuousAt
          (fun time =>
            finiteStateVorticityNonlinearCoefficientAt
              modes (trajectory time) wave)
          t :=
      (finiteStateVorticityNonlinearCoefficientAt_contDiff modes wave)
        |>.continuous
        |>.continuousAt.comp trajectoryContinuous
    have exponentialContinuous :
        ContinuousAt (fun time => Real.exp (c * time)) t :=
      (((hasDerivAt_id t).const_mul c).exp).continuousAt
    exact
      (exponentialContinuous.smul nonlinearContinuous).continuousWithinAt
  have integrable :
      IntervalIntegrable
        (fun t =>
          Real.exp (c * t) •
            finiteStateVorticityNonlinearCoefficientAt
              modes (trajectory t) wave)
        MeasureTheory.volume a b :=
    integrandContinuous.intervalIntegrable_of_Icc hab
  change
    (∫ t in a..b,
        Real.exp (c * t) •
          finiteStateVorticityNonlinearCoefficientAt
            modes (trajectory t) wave) =
      Real.exp (c * b) • trajectory b wave -
        Real.exp (c * a) • trajectory a wave
  refine
    intervalIntegral.integral_eq_sub_of_hasDerivAt
      (f := fun t =>
        Real.exp (c * t) • trajectory t wave)
      (f' := fun t =>
        Real.exp (c * t) •
          finiteStateVorticityNonlinearCoefficientAt
            modes (trajectory t) wave)
      ?_ integrable
  intro t ht
  apply
    finiteGalerkinWave_weighted_hasDerivAt
      modes wave waveMem ν trajectory t
  apply evolves t
  rwa [uIcc_of_le hab] at ht

/-- The actual finite Galerkin evolution has the exact Fourier mild form:
the viscous tangent is entirely contained in the heat multiplier, and the
Duhamel integral carries only the nonlinear tangent. -/
theorem finiteGalerkinWave_mild_identity
    (modes : Finset IntegerWavevector)
    (wave : IntegerWavevector)
    (waveMem : wave ∈ modes)
    (ν : ℝ)
    (trajectory : ℝ → ComplexVorticityHilbertState)
    (a b : ℝ)
    (hab : a ≤ b)
    (evolves :
      ∀ t ∈ Icc a b,
        HasDerivAt trajectory
          (finiteStateVorticityGenerator modes ν (trajectory t)) t) :
    trajectory b wave =
      finiteStateVorticityHeatMultiplier ν (b - a) wave •
          trajectory a wave +
        ∫ t in a..b,
          finiteStateVorticityHeatMultiplier ν (b - t) wave •
            finiteStateVorticityNonlinearCoefficientAt
              modes (trajectory t) wave := by
  let c : ℝ := ν * integerWaveViscousMultiplier wave
  have integratingFactor :=
    finiteGalerkinWave_integratingFactor_identity
      modes wave waveMem ν trajectory a b hab evolves
  change
    trajectory b wave =
      Real.exp (-c * (b - a)) • trajectory a wave +
        ∫ t in a..b,
          Real.exp (-c * (b - t)) •
            finiteStateVorticityNonlinearCoefficientAt
              modes (trajectory t) wave
  change
    (∫ t in a..b,
        Real.exp (c * t) •
          finiteStateVorticityNonlinearCoefficientAt
            modes (trajectory t) wave) =
      Real.exp (c * b) • trajectory b wave -
        Real.exp (c * a) • trajectory a wave
    at integratingFactor
  have endpointLedger :
      Real.exp (c * b) • trajectory b wave =
        (∫ t in a..b,
          Real.exp (c * t) •
            finiteStateVorticityNonlinearCoefficientAt
              modes (trajectory t) wave) +
        Real.exp (c * a) • trajectory a wave := by
    rw [integratingFactor]
    abel
  have expCancel (x : ℝ) :
      Real.exp (-c * x) * Real.exp (c * x) = 1 := by
    rw [← Real.exp_add]
    have hx : -c * x + c * x = 0 := by ring
    rw [hx, Real.exp_zero]
  have expTransport (t : ℝ) :
      Real.exp (-c * b) * Real.exp (c * t) =
        Real.exp (-c * (b - t)) := by
    rw [← Real.exp_add]
    congr 1
    ring
  have scaledIntegral :
      Real.exp (-c * b) •
          (∫ t in a..b,
            Real.exp (c * t) •
              finiteStateVorticityNonlinearCoefficientAt
                modes (trajectory t) wave) =
        ∫ t in a..b,
          Real.exp (-c * (b - t)) •
            finiteStateVorticityNonlinearCoefficientAt
              modes (trajectory t) wave := by
    rw [← intervalIntegral.integral_smul]
    apply intervalIntegral.integral_congr
    intro t ht
    change
      (Real.exp (-c * b) •
          (Real.exp (c * t) •
            finiteStateVorticityNonlinearCoefficientAt
              modes (trajectory t) wave) :
        ComplexCoordinateVector) =
      Real.exp (-c * (b - t)) •
        finiteStateVorticityNonlinearCoefficientAt
          modes (trajectory t) wave
    rw [smul_smul, expTransport t]
  calc
    trajectory b wave =
        Real.exp (-c * b) •
          (Real.exp (c * b) • trajectory b wave) := by
      rw [smul_smul, expCancel b, one_smul]
    _ =
        Real.exp (-c * b) •
          ((∫ t in a..b,
              Real.exp (c * t) •
                finiteStateVorticityNonlinearCoefficientAt
                  modes (trajectory t) wave) +
            Real.exp (c * a) • trajectory a wave) := by
      rw [endpointLedger]
    _ =
        Real.exp (-c * b) •
            (∫ t in a..b,
              Real.exp (c * t) •
                finiteStateVorticityNonlinearCoefficientAt
                  modes (trajectory t) wave) +
          Real.exp (-c * b) •
            (Real.exp (c * a) • trajectory a wave) := by
      rw [smul_add]
    _ =
        (∫ t in a..b,
          Real.exp (-c * (b - t)) •
            finiteStateVorticityNonlinearCoefficientAt
              modes (trajectory t) wave) +
          Real.exp (-c * (b - a)) • trajectory a wave := by
      rw [scaledIntegral, smul_smul, expTransport a]
    _ =
        Real.exp (-c * (b - a)) • trajectory a wave +
          ∫ t in a..b,
            Real.exp (-c * (b - t)) •
              finiteStateVorticityNonlinearCoefficientAt
                modes (trajectory t) wave := by
      rw [add_comm]

end

end ThreeDimensionalVorticityCoefficientFiniteGalerkinMildDuhamel
end NavierStokes
end SaturationMonoid
