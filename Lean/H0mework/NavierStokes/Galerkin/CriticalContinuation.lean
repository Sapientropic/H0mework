import Mathlib.Analysis.ODE.ExistUnique
import H0mework.NavierStokes.Galerkin.CriticalGronwall

/-!
# Quantitative restart and finite-endpoint continuation

This file isolates the analytic continuation mechanism required after a
cutoff-independent Galerkin barrier has bounded an actual trajectory.

The construction does not assume an endpoint value or a target continuation.
It restarts strictly before the finite endpoint, uses quantitative
Picard--Lindelöf data to generate a second actual solution, proves equality on
the overlap by ODE uniqueness, and then splices the two paths.

The resulting interface exposes the remaining Navier--Stokes obligation
without hiding it in a continuation witness:

* the actual trajectory must remain in a fixed inner ball;
* the generator must be bounded and Lipschitz on a fixed outer ball;
* the resulting Picard time must be positive.

At a fixed Fourier cutoff these are finite-dimensional polynomial
estimates.  They cannot be made cutoff-independent from the enstrophy
barrier alone: the separate theorem
`exists_physicalViscousTangent_exceeding_enstrophyMultiplier` generates
physical states on which the order-two viscous tangent exceeds every
proposed enstrophy multiple.  Thus the generic continuation mechanism below
is valid, while a cutoff-independent Navier--Stokes consumer must move to a
parabolic/mild restart norm that absorbs this derivative loss.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalVorticityCoefficientFiniteGalerkinCriticalContinuation

open Set ODE

noncomputable section

/-! ## Picard restart with its generated carrier bound -/

/--
The Picard fixed point generated by `IsPicardLindelof` remains in the outer
closed ball on which the vector-field estimates were proved.

Mathlib's public differential-form existence theorem does not expose this
range fact, although the internal Picard construction already proves it.
The range is needed below for overlap uniqueness.
-/
theorem exists_picard_path_hasDerivWithinAt_mem_closedBall
    {E : Type*}
    [NormedAddCommGroup E]
    [NormedSpace ℝ E]
    [CompleteSpace E]
    {field : ℝ → E → E}
    {tmin tmax : ℝ}
    {t₀ : Icc tmin tmax}
    {center initial : E}
    {outerRadius innerRadius fieldBound lipschitzBound : NNReal}
    (picard :
      IsPicardLindelof field t₀ center outerRadius innerRadius
        fieldBound lipschitzBound)
    (initialMem :
      initial ∈ Metric.closedBall center innerRadius) :
    ∃ path : ℝ → E,
      path t₀ = initial ∧
        ∀ t ∈ Icc tmin tmax,
          HasDerivWithinAt path
              (field t (path t)) (Icc tmin tmax) t ∧
            path t ∈ Metric.closedBall center outerRadius := by
  obtain ⟨path, pathFixed⟩ :=
    ODE.FunSpace.exists_isFixedPt_next picard initialMem
  refine ⟨path.compProj, ?_, ?_⟩
  · rw [ODE.FunSpace.compProj_val, ← pathFixed,
      ODE.FunSpace.next_apply₀]
  · intro t timeMem
    constructor
    · apply ODE.hasDerivWithinAt_picard_Icc t₀.2
          picard.continuousOn_uncurry
          path.continuous_compProj.continuousOn
          (fun _ _ =>
            path.compProj_mem_closedBall picard.mul_max_le)
          initial timeMem
        |>.congr_of_mem _ timeMem
      intro s sMem
      nth_rw 1 [← pathFixed]
      rw [ODE.FunSpace.compProj_of_mem sMem,
        ODE.FunSpace.next_apply]
    · exact
        path.compProj_mem_closedBall picard.mul_max_le

/-! ## A bounded actual path extends past every finite endpoint -/

/--
A bounded actual autonomous ODE trajectory extends past a finite right
endpoint whenever one quantitative Picard window works uniformly on the
same inner/outer carrier.

The restart is generated at a time strictly before `b`; hence no endpoint
limit, endpoint state, target solution, or continuation witness occurs in
the theorem mouth.
-/
theorem exists_extension_past_finite_endpoint_of_uniform_picard
    {E : Type*}
    [NormedAddCommGroup E]
    [NormedSpace ℝ E]
    [CompleteSpace E]
    {field : E → E}
    {trajectory : ℝ → E}
    {a b ε : ℝ}
    (intervalNonempty : a < b)
    (restartTimePos : 0 < ε)
    {center : E}
    {outerRadius innerRadius fieldBound lipschitzBound : NNReal}
    (evolves :
      ∀ t ∈ Ioo a b,
        HasDerivAt trajectory
          (field (trajectory t)) t)
    (trajectoryMem :
      ∀ t ∈ Ioo a b,
        trajectory t ∈
          Metric.closedBall center innerRadius)
    (uniformPicard :
      ∀ restartTime : ℝ,
        IsPicardLindelof (fun _ => field)
          (tmin := restartTime - ε)
          (tmax := restartTime + ε)
          ⟨restartTime, by
            constructor <;> linarith⟩
          center outerRadius innerRadius
          fieldBound lipschitzBound) :
    ∃ extendedUntil : ℝ,
      b < extendedUntil ∧
        ∃ extension : ℝ → E,
          EqOn extension trajectory (Ioo a b) ∧
            ∀ t ∈ Ioo a extendedUntil,
              HasDerivAt extension
                (field (extension t)) t := by
  let overlapLength : ℝ := min ε (b - a)
  have overlapLengthPos :
      0 < overlapLength := by
    exact lt_min restartTimePos
      (sub_pos.mpr intervalNonempty)
  have overlapLengthLeTime :
      overlapLength ≤ ε :=
    min_le_left _ _
  have overlapLengthLeInterval :
      overlapLength ≤ b - a :=
    min_le_right _ _
  let restartTime : ℝ := b - overlapLength / 2
  have restartTimeMem :
      restartTime ∈ Ioo a b := by
    dsimp [restartTime]
    constructor <;> linarith
  let extendedUntil : ℝ := restartTime + ε
  have endpointBeforeExtended :
      b < extendedUntil := by
    dsimp [extendedUntil, restartTime]
    linarith
  have restartTimeInPicardInterval :
      restartTime ∈
        Icc (restartTime - ε) (restartTime + ε) := by
    constructor <;> linarith
  let picard :
      IsPicardLindelof (fun _ => field)
        (tmin := restartTime - ε)
        (tmax := restartTime + ε)
        ⟨restartTime, restartTimeInPicardInterval⟩
        center outerRadius innerRadius
        fieldBound lipschitzBound :=
    uniformPicard restartTime
  obtain ⟨restart, restartInitial, restartProperties⟩ :=
    exists_picard_path_hasDerivWithinAt_mem_closedBall
      picard
      (trajectoryMem restartTime restartTimeMem)
  have innerRadiusLeOuterRadius :
      innerRadius ≤ outerRadius := by
    apply NNReal.coe_le_coe.mp
    have picardRoom := picard.mul_max_le
    simp only [add_sub_cancel_left, sub_sub_cancel, max_self] at picardRoom
    have nonnegativeTravel :
        0 ≤ (fieldBound : ℝ) * ε :=
      mul_nonneg (NNReal.coe_nonneg _) restartTimePos.le
    linarith
  have restartEvolves :
      ∀ t ∈ Ioo (restartTime - ε) (restartTime + ε),
        HasDerivAt restart (field (restart t)) t := by
    intro t timeMem
    exact
      (restartProperties t (Ioo_subset_Icc_self timeMem)).1
        |>.hasDerivAt
          (Icc_mem_nhds timeMem.1 timeMem.2)
  have restartMem :
      ∀ t ∈ Ioo (restartTime - ε) (restartTime + ε),
        restart t ∈
          Metric.closedBall center outerRadius := by
    intro t timeMem
    exact
      (restartProperties t
        (Ioo_subset_Icc_self timeMem)).2
  let overlapStart : ℝ := max a (restartTime - ε)
  have restartTimeInOverlap :
      restartTime ∈ Ioo overlapStart b := by
    dsimp [overlapStart]
    exact
      ⟨max_lt restartTimeMem.1 (by linarith),
        restartTimeMem.2⟩
  have overlapInOld :
      Ioo overlapStart b ⊆ Ioo a b := by
    intro t timeMem
    exact
      ⟨lt_of_le_of_lt
          (le_max_left a (restartTime - ε))
          timeMem.1,
        timeMem.2⟩
  have overlapInRestart :
      Ioo overlapStart b ⊆
        Ioo (restartTime - ε) (restartTime + ε) := by
    intro t timeMem
    exact
      ⟨lt_of_le_of_lt
          (le_max_right a (restartTime - ε))
          timeMem.1,
        lt_trans timeMem.2 endpointBeforeExtended⟩
  have oldMemOuter :
      ∀ t ∈ Ioo overlapStart b,
        trajectory t ∈
          Metric.closedBall center outerRadius := by
    intro t timeMem
    exact
      (Metric.closedBall_subset_closedBall
        (NNReal.coe_le_coe.mpr innerRadiusLeOuterRadius))
        (trajectoryMem t (overlapInOld timeMem))
  have oldEqRestart :
      EqOn trajectory restart (Ioo overlapStart b) := by
    apply ODE_solution_unique_of_mem_Ioo
      (v := fun _ => field)
      (s := fun _ =>
        Metric.closedBall center outerRadius)
      (K := lipschitzBound)
      (t₀ := restartTime)
    · intro t timeMem
      exact picard.lipschitzOnWith t
        (Ioo_subset_Icc_self
          (overlapInRestart timeMem))
    · exact restartTimeInOverlap
    · intro t timeMem
      exact
        ⟨evolves t (overlapInOld timeMem),
          oldMemOuter t timeMem⟩
    · intro t timeMem
      exact
        ⟨restartEvolves t
            (overlapInRestart timeMem),
          restartMem t
            (overlapInRestart timeMem)⟩
    · exact restartInitial.symm
  let extension : ℝ → E :=
    piecewise (Ioo a b) trajectory restart
  have extensionEqOld :
      EqOn extension trajectory (Ioo a b) := by
    intro t timeMem
    simp only [extension, piecewise, if_pos timeMem]
  have extensionEqRestart :
      EqOn extension restart
        (Ioo (restartTime - ε) (restartTime + ε)) := by
    intro t timeMem
    by_cases oldMem : t ∈ Ioo a b
    · simp only [extension, piecewise, if_pos oldMem]
      exact oldEqRestart
        ⟨max_lt oldMem.1 timeMem.1, oldMem.2⟩
    · simp only [extension, piecewise, if_neg oldMem]
  refine
    ⟨extendedUntil, endpointBeforeExtended,
      extension, extensionEqOld, ?_⟩
  intro t timeMem
  by_cases oldMem : t ∈ Ioo a b
  · have locallyOld :
        extension =ᶠ[nhds t] trajectory := by
      rw [Filter.eventuallyEq_iff_exists_mem]
      exact
        ⟨Ioo a b,
          Ioo_mem_nhds oldMem.1 oldMem.2,
          extensionEqOld⟩
    have actual :=
      (evolves t oldMem).congr_of_eventuallyEq
        locallyOld
    have valueEq :
        extension t = trajectory t :=
      extensionEqOld oldMem
    simpa only [valueEq] using actual
  · have endpointLeTime :
        b ≤ t := by
      by_contra endpointNotLe
      exact oldMem
        ⟨timeMem.1, lt_of_not_ge endpointNotLe⟩
    have restartIntervalMem :
        t ∈ Ioo
          (restartTime - ε) (restartTime + ε) := by
      exact
        ⟨lt_of_lt_of_le
            (by
              dsimp [restartTime]
              linarith)
            endpointLeTime,
          timeMem.2⟩
    have locallyRestart :
        extension =ᶠ[nhds t] restart := by
      rw [Filter.eventuallyEq_iff_exists_mem]
      exact
        ⟨Ioo (restartTime - ε)
            (restartTime + ε),
          Ioo_mem_nhds restartIntervalMem.1
            restartIntervalMem.2,
          extensionEqRestart⟩
    have actual :=
      (restartEvolves t restartIntervalMem)
        |>.congr_of_eventuallyEq locallyRestart
    have valueEq :
        extension t = restart t :=
      extensionEqRestart restartIntervalMem
    simpa only [valueEq] using actual

/-! ## Explicit quantitative data generate the uniform restart law -/

/--
Concrete field bounds on one fixed outer ball generate the uniform Picard
data consumed by the continuation theorem.

This is the exact analytic interface that a direct ODE restart would have to
discharge.  The viscous derivative-loss theorem shows that the critical
enstrophy barrier cannot supply its `fieldNormLe` clause uniformly in the
cutoff.  It contains no path, endpoint, target solution, or continuation
witness.
-/
theorem exists_extension_past_finite_endpoint_of_uniform_generator_bounds
    {E : Type*}
    [NormedAddCommGroup E]
    [NormedSpace ℝ E]
    [CompleteSpace E]
    {field : E → E}
    {trajectory : ℝ → E}
    {a b ε : ℝ}
    (intervalNonempty : a < b)
    (restartTimePos : 0 < ε)
    {center : E}
    {outerRadius innerRadius fieldBound lipschitzBound : NNReal}
    (evolves :
      ∀ t ∈ Ioo a b,
        HasDerivAt trajectory
          (field (trajectory t)) t)
    (trajectoryMem :
      ∀ t ∈ Ioo a b,
        trajectory t ∈
          Metric.closedBall center innerRadius)
    (fieldNormLe :
      ∀ state ∈ Metric.closedBall center outerRadius,
        ‖field state‖ ≤ fieldBound)
    (fieldLipschitz :
      LipschitzOnWith lipschitzBound field
        (Metric.closedBall center outerRadius))
    (picardRoom :
      (fieldBound : ℝ) * ε ≤
        (outerRadius : ℝ) - innerRadius) :
    ∃ extendedUntil : ℝ,
      b < extendedUntil ∧
        ∃ extension : ℝ → E,
          EqOn extension trajectory (Ioo a b) ∧
            ∀ t ∈ Ioo a extendedUntil,
              HasDerivAt extension
                (field (extension t)) t := by
  apply
    exists_extension_past_finite_endpoint_of_uniform_picard
      intervalNonempty restartTimePos evolves trajectoryMem
  intro restartTime
  exact IsPicardLindelof.of_time_independent
    fieldNormLe fieldLipschitz (by
      simpa only [add_sub_cancel_left,
        sub_sub_cancel, max_self] using picardRoom)

end

end ThreeDimensionalVorticityCoefficientFiniteGalerkinCriticalContinuation
end NavierStokes
end SaturationMonoid
