import H0mework.NavierStokes.SourceReadout.MomentumFlux

/-!
# Source pressure and the original turbulence action

The complete quadratic flux generates the actual velocity and vorticity
nonlinearities. Its filter commutator generates the original native correction
through curl-div, while its longitudinal contraction supplies the pressure.
-/

set_option autoImplicit false

namespace SaturationMonoid.NavierStokes.NativeStressSource

open scoped BigOperators
open ThreeDimensionalPeriodicCoarseFilterCore
open ThreeDimensionalPeriodicIntegerCharacterCoarseFilter
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientFiniteSupportComplexTrajectory
open ThreeDimensionalVorticityCoefficientFixedOutputNonlinearContinuity
open ThreeDimensionalVorticityCoefficientFiniteGalerkinAmbientNorm
open ThreeDimensionalVorticityCoefficientFiniteGalerkinKineticEnergyLedger
open ThreeDimensionalVorticityCoefficientGeneratedWholeRestartActualFourierConeAdvance
open ThreeDimensionalVorticityCoefficientCanonicalExhaustiveGalerkinTarget
open ThreeDimensionalVorticityCoefficientGeneratedShellSerrinGeometry
open ThreeDimensionalVorticityCoefficientInfiniteFixedOutputNonlinearRow
open ThreeDimensionalVorticityCoefficientGeneratedIntegerShellInfiniteLineageHilbertCompletion
open ThreeDimensionalVorticityCoefficientWholeVelocityFixedOutputNonlinearRow
open ThreeDimensionalVorticityCoefficientWholeVelocityPairDiagonalBudget
open ThreeDimensionalVorticityCoefficientStrongContinuationDifferenceKineticEnergy
open ThreeDimensionalVorticityCoefficientWholeReceiptKineticTimeModulus
open NativeStressCurlAlgebra
open ThreeDimensionalVorticityCoefficientNativeFluidMedium
open ThreeDimensionalVorticityCoefficientGeneratedWholeRestartNativeAccumulationNativeTurbulenceLaw

noncomputable section

theorem quadraticFlux_divergence (velocity : ComplexVorticityHilbertState)
    (transverse : WholeStateTransverse velocity) (wave : IntegerWavevector) :
    nativeFluidStressDivergenceCoefficient (quadraticFlux velocity) wave =
      wholeStateVelocityNonlinearCoefficientAt velocity wave :=
  nativeFluidStressDivergenceCoefficient_quadraticConvolution velocity transverse wave
    (flux_pair_summable velocity wave)

theorem quadraticFlux_biotSavart_action (state : ComplexVorticityHilbertState)
    (zero : state 0 = 0) (transverse : WholeStateTransverse state) (wave : IntegerWavevector) :
    nativeFluidConstitutiveVorticityAction (quadraticFlux (wholeBiotSavartVelocityState state)) wave =
      wholeStateVorticityNonlinearCoefficientAt state wave := by
  rw [nativeFluidConstitutiveVorticityAction,
    quadraticFlux_divergence _ (wholeBiotSavartVelocityState_transverse state)]
  exact (wholeStateVorticityNonlinearCoefficientAt_eq_fourierCurl_velocity
    state zero transverse wave).symm

/-- The original native correction is generated by the complete source momentum flux.
The stress is formed before applying curl-div; no inverse-force construction occurs. -/
theorem correctionStress_action (modes : Finset IntegerWavevector)
    (state : ComplexVorticityHilbertState) (zero : state 0 = 0)
    (transverse : WholeStateTransverse state) (wave : IntegerWavevector) :
    nativeFluidConstitutiveVorticityAction (correctionStress modes state) wave =
      nativeTurbulenceCorrectionAt modes state wave := by
  have stressEq : correctionStress modes state =
      (fun wave => if wave ∈ modes then quadraticFlux (wholeBiotSavartVelocityState state) wave else 0) -
        quadraticFlux (wholeBiotSavartVelocityState (complexSharpSupportProjection modes state)) := by
    funext wave output input
    by_cases inside : wave ∈ modes <;> simp [correctionStress, inside]
  have projectedZero : complexSharpSupportProjection modes state 0 = 0 := by
    simp [complexSharpSupportProjection_apply, zero]
  have projectedTransverse := wholeStateTransverse_projection modes state transverse
  rw [stressEq, ← wholeStressActionCLM_apply, map_sub]
  simp only [Pi.sub_apply]
  rw [wholeStressActionCLM_apply, wholeStressActionCLM_apply,
    nativeFluidConstitutiveVorticityAction_projection,
    quadraticFlux_biotSavart_action state zero transverse,
    quadraticFlux_biotSavart_action _ projectedZero projectedTransverse]
  rfl

/-- The pressure coordinate is read from the original complete momentum flux. -/
def sourcePressure (state : ComplexVorticityHilbertState) (wave : IntegerWavevector) : ℂ :=
  stressPressureCoefficient wave (quadraticFlux (wholeBiotSavartVelocityState state) wave)

/-- The actual velocity action includes its source pressure, without assigning a zero pressure field. -/
theorem source_momentum_action (nu : ℝ) (state : ComplexVorticityHilbertState)
    (zero : state 0 = 0) (transverse : WholeStateTransverse state)
    (wave : IntegerWavevector) (nonzero : wave ≠ 0) :
    biotSavartVelocityCoefficient wave (wholeLatticeVorticityFourierTangentAt nu state wave) =
      nativeFluidStressDivergenceCoefficient (quadraticFlux (wholeBiotSavartVelocityState state)) wave -
        ((Complex.I * (((2 * Real.pi : ℝ) : ℂ))) * sourcePressure state wave) • complexWavevector wave -
        (nu * integerWaveViscousMultiplier wave) • wholeBiotSavartVelocityState state wave := by
  have pressure := nativeFluidStressDivergenceCoefficient_eq_leray_add_pressure wave
    (quadraticFlux (wholeBiotSavartVelocityState state) wave)
  change nativeFluidStressDivergenceCoefficient
    (quadraticFlux (wholeBiotSavartVelocityState state)) wave = _ at pressure
  have pressureAction : transverseProjection wave (nativeFluidStressDivergenceCoefficient
      (quadraticFlux (wholeBiotSavartVelocityState state)) wave) =
      nativeFluidStressDivergenceCoefficient (quadraticFlux (wholeBiotSavartVelocityState state)) wave -
        ((Complex.I * (((2 * Real.pi : ℝ) : ℂ))) * sourcePressure state wave) • complexWavevector wave :=
    eq_sub_of_add_eq pressure.symm
  unfold wholeLatticeVorticityFourierTangentAt
  change biotSavartVelocityCLM wave (_ - _ • state wave) = _
  rw [map_sub, map_smul]
  simp only [biotSavartVelocityCLM_apply]
  rw [← quadraticFlux_biotSavart_action state zero transverse wave,
    nativeFluidConstitutiveVorticityAction,
    biotSavartVelocityCoefficient_fourierCurlCoefficient wave _ nonzero,
    pressureAction]
  rfl


end
end SaturationMonoid.NavierStokes.NativeStressSource
