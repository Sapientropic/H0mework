import H0mework.NavierStokes.InitialData.FiniteSupportRealityTrajectory

/-!
# Restart compiler for a finite physical vorticity state

A continuation argument must restart the Galerkin law from the endpoint of
an existing segment, not only from the first raw source.  This module proves
that every sharply supported, transverse, Fourier-real finite state is
exactly regenerated by the primitive raw-source compiler on the same mode
set.  The existing source-owned local trajectory producer can therefore be
reused at every physical endpoint without adding a trajectory or restart
certificate to the source mouth.

This is a local restart bridge.  It does not yet prove a uniform restart time
or global continuation.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalVorticityCoefficientFinitePhysicalStateRestart

open scoped BigOperators Topology ENNReal

open Set
open ThreeDimensionalPeriodicCoarseFilterCore
open ThreeDimensionalPeriodicIntegerCharacterCoarseFilter
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientFiniteSupportComplexTrajectory
open ThreeDimensionalVorticityCoefficientFiniteSupportPhysicalInvariantTrajectory
open ThreeDimensionalVorticityCoefficientFiniteSupportRealityTrajectory

noncomputable section

/-- Regard an existing finite coefficient state as primitive raw source data
on its exact owned mode set.  Physical closure is still regenerated below;
it is not stored in this source. -/
def rawSourceOfFiniteVorticityState
    (modes : Finset IntegerWavevector)
    (state : ComplexVorticityHilbertState) :
    RawVorticityFourierSource where
  activeModes := modes
  rawVorticity := state

@[simp] theorem rawSourceOfFiniteVorticityState_activeModes
    (modes : Finset IntegerWavevector)
    (state : ComplexVorticityHilbertState) :
    (rawSourceOfFiniteVorticityState modes state).activeModes = modes :=
  rfl

/-- A zero-free, negation-closed inventory is unchanged by the primitive
source support closure. -/
theorem rawSourceOfFiniteVorticityState_generatedSupport
    (modes : Finset IntegerWavevector)
    (zeroNotMem : 0 ∉ modes)
    (negClosed :
      ∀ wave, wave ∈ modes → waveNeg wave ∈ modes)
    (state : ComplexVorticityHilbertState) :
    generatedSupport (rawSourceOfFiniteVorticityState modes state) =
      modes := by
  have negImage : modes.image waveNeg = modes := by
    ext wave
    constructor
    · intro waveMem
      rcases Finset.mem_image.mp waveMem with
        ⟨prior, priorMem, equality⟩
      rw [← equality]
      exact negClosed prior priorMem
    · intro waveMem
      exact Finset.mem_image.mpr
        ⟨waveNeg wave, negClosed wave waveMem, by simp⟩
  simp [generatedSupport, rawSourceOfFiniteVorticityState,
    negImage, zeroNotMem]

/-- On physical input data, the reality symmetrizer is the identity at every
owned mode. -/
theorem realitySymmetrizedVorticity_rawSourceOfFiniteVorticityState
    (modes : Finset IntegerWavevector)
    (negClosed :
      ∀ wave, wave ∈ modes → waveNeg wave ∈ modes)
    (state : ComplexVorticityHilbertState)
    (reality : FiniteStateFourierReality state)
    {wave : IntegerWavevector}
    (waveMem : wave ∈ modes) :
    realitySymmetrizedVorticity
        (rawSourceOfFiniteVorticityState modes state) wave =
      state wave := by
  have negMem : waveNeg wave ∈ modes :=
    negClosed wave waveMem
  funext coordinate
  have realityCoordinate :=
    congrFun (reality wave) coordinate
  have conjugateNegative :
      star (state (waveNeg wave) coordinate) =
        state wave coordinate := by
    rw [realityCoordinate]
    simp [vectorConj]
  have supportedWave :
      supportedRawVorticity
          (rawSourceOfFiniteVorticityState modes state) wave =
        state wave := by
    simp [supportedRawVorticity, rawSourceOfFiniteVorticityState, waveMem]
  have supportedNegative :
      supportedRawVorticity
          (rawSourceOfFiniteVorticityState modes state) (waveNeg wave) =
        state (waveNeg wave) := by
    simp [supportedRawVorticity, rawSourceOfFiniteVorticityState, negMem]
  simp only [realitySymmetrizedVorticity]
  rw [supportedWave, supportedNegative]
  rw [conjugateNegative]
  ring

/-- The complete primitive source compiler is the identity on every finite
physical state.  Support closure, reality symmetrization, and transverse
projection are all discharged from the displayed state laws. -/
theorem generatedComplexVorticityState_rawSourceOfFinitePhysicalState
    (modes : Finset IntegerWavevector)
    (zeroNotMem : 0 ∉ modes)
    (negClosed :
      ∀ wave, wave ∈ modes → waveNeg wave ∈ modes)
    (state : ComplexVorticityHilbertState)
    (supported :
      ∀ wave, wave ∉ modes → state wave = 0)
    (transverse :
      ∀ wave ∈ modes,
        complexWavevector wave ⬝ᵥ state wave = 0)
    (reality : FiniteStateFourierReality state) :
    generatedComplexVorticityState
        (rawSourceOfFiniteVorticityState modes state)
        (generatedSupport
          (rawSourceOfFiniteVorticityState modes state)) =
      state := by
  rw [rawSourceOfFiniteVorticityState_generatedSupport
    modes zeroNotMem negClosed state]
  apply lp.ext
  funext wave
  by_cases waveMem : wave ∈ modes
  · rw [generatedComplexVorticityState_apply, if_pos waveMem,
      generatedVorticityCoefficient, if_pos]
    · rw [realitySymmetrizedVorticity_rawSourceOfFiniteVorticityState
        modes negClosed state reality waveMem]
      exact transverseProjection_eq_self_of_transverse
        (fun waveZero => zeroNotMem (waveZero ▸ waveMem))
        (transverse wave waveMem)
    · simpa [rawSourceOfFiniteVorticityState_generatedSupport
        modes zeroNotMem negClosed state] using waveMem
  · rw [generatedComplexVorticityState_apply, if_neg waveMem,
      supported wave waveMem]

/-- Every already physical finite endpoint can start another actual local
Galerkin segment on the same mode set.  The raw source used internally is
canonically reconstructed from that endpoint; no caller-supplied next state,
trajectory, lifespan, or invariant certificate is added to the primitive
source type. -/
theorem finitePhysicalState_transverseRealityLocalTrajectory
    (modes : Finset IntegerWavevector)
    (zeroNotMem : 0 ∉ modes)
    (negClosed :
      ∀ wave, wave ∈ modes → waveNeg wave ∈ modes)
    (ν : ℝ)
    (initialState : ComplexVorticityHilbertState)
    (supported :
      ∀ wave, wave ∉ modes → initialState wave = 0)
    (transverse :
      ∀ wave ∈ modes,
        complexWavevector wave ⬝ᵥ initialState wave = 0)
    (reality : FiniteStateFourierReality initialState) :
    ∃ (trajectory : ℝ → ComplexVorticityHilbertState)
        (physicalTime : ℝ),
      0 < physicalTime ∧
        trajectory 0 = initialState ∧
        ∀ t ∈ Icc (0 : ℝ) physicalTime,
          HasDerivAt trajectory
              (finiteStateVorticityGenerator
                modes ν (trajectory t)) t ∧
            (∀ wave, wave ∉ modes → trajectory t wave = 0) ∧
            (∀ wave,
              complexWavevector wave ⬝ᵥ trajectory t wave = 0) ∧
            FiniteStateFourierReality (trajectory t) := by
  let source := rawSourceOfFiniteVorticityState modes initialState
  have supportEq : generatedSupport source = modes := by
    exact rawSourceOfFiniteVorticityState_generatedSupport
      modes zeroNotMem negClosed initialState
  have compiledEq :
      generatedComplexVorticityState source
          (generatedSupport source) = initialState := by
    exact generatedComplexVorticityState_rawSourceOfFinitePhysicalState
      modes zeroNotMem negClosed initialState
      supported transverse reality
  obtain
      ⟨trajectory, physicalTime, physicalTimePos,
        initial, physicalProperties⟩ :=
    generatedSource_transverseRealityLocalTrajectory source ν
  refine ⟨trajectory, physicalTime, physicalTimePos, ?_, ?_⟩
  · exact initial.trans compiledEq
  · intro t timeMem
    have actual := physicalProperties t timeMem
    rw [supportEq] at actual
    exact actual

end

end ThreeDimensionalVorticityCoefficientFinitePhysicalStateRestart
end NavierStokes
end SaturationMonoid
