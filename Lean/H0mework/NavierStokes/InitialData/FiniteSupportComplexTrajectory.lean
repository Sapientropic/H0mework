import Mathlib.Tactic.FunProp
import H0mework.NavierStokes.ShellSources.Source

/-!
# Actual finite-dimensional trajectories for generated three-dimensional shell responses

This module builds the finite-dimensional complex Galerkin target needed to
give a source-generated integer-shell response physical time.  The vector
field is the actual three-dimensional vorticity nonlinearity (stretching
minus vorticity advection) together with the Fourier viscous multiplier for
the repository character `exp (I * 2 * pi * k dot x)`.

The first layer is deliberately uniform in the finite Fourier support.  It
constructs a genuine local ODE trajectory; it does not identify grammar
occurrence with time, accept a trajectory or lifespan as a premise, or claim
that a symbolic shell write-back is already a Navier--Stokes endpoint.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalVorticityCoefficientFiniteSupportComplexTrajectory

open scoped BigOperators ENNReal Topology Matrix

open Set
open Filter
open Matrix
open SourceGeneratedNativeResponseDisposition
open ThreeDimensionalPeriodicCoarseFilterCore
open ThreeDimensionalPeriodicIntegerCharacterCoarseFilter
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientStretchingPairTable
open ThreeDimensionalVorticityCoefficientNonlinearPairGenerator
open ThreeDimensionalVorticityCoefficientGeneratedIntegerShellSource

noncomputable section

/-! ## Common finite-energy coefficient carrier -/

/-- Common complex Fourier carrier for finite-dimensional vorticity ODEs. -/
abbrev ComplexVorticityHilbertState :=
  lp (fun _ : IntegerWavevector => ComplexCoordinateVector) 2

/-- Install a finite coefficient table in the common Fourier carrier. -/
def finiteComplexVorticityState
    (modes : Finset IntegerWavevector)
    (coefficient : IntegerWavevector → ComplexCoordinateVector) :
    ComplexVorticityHilbertState :=
  ∑ wave ∈ modes, lp.single 2 wave (coefficient wave)

@[simp] theorem finiteComplexVorticityState_apply
    (modes : Finset IntegerWavevector)
    (coefficient : IntegerWavevector → ComplexCoordinateVector)
    (wave : IntegerWavevector) :
    finiteComplexVorticityState modes coefficient wave =
      if wave ∈ modes then coefficient wave else 0 := by
  classical
  rw [finiteComplexVorticityState, lp.coeFn_sum]
  simp [lp.single_apply]

/-- Finite realization of the coefficient table generated by a raw source. -/
def generatedComplexVorticityState
    (source : RawVorticityFourierSource)
    (modes : Finset IntegerWavevector) :
    ComplexVorticityHilbertState :=
  finiteComplexVorticityState modes
    (generatedVorticityCoefficient source)

@[simp] theorem generatedComplexVorticityState_apply
    (source : RawVorticityFourierSource)
    (modes : Finset IntegerWavevector)
    (wave : IntegerWavevector) :
    generatedComplexVorticityState source modes wave =
      if wave ∈ modes
      then generatedVorticityCoefficient source wave
      else 0 := by
  simp [generatedComplexVorticityState]

/-- Sharp finite-support projection on the common complex Fourier carrier. -/
def complexSharpSupportProjection
    (modes : Finset IntegerWavevector)
    (state : ComplexVorticityHilbertState) :
    ComplexVorticityHilbertState :=
  finiteComplexVorticityState modes state

@[simp] theorem complexSharpSupportProjection_apply
    (modes : Finset IntegerWavevector)
    (state : ComplexVorticityHilbertState)
    (wave : IntegerWavevector) :
    complexSharpSupportProjection modes state wave =
      if wave ∈ modes then state wave else 0 := by
  simp [complexSharpSupportProjection]

@[simp] theorem complexSharpSupportProjection_generatedState_self
    (source : RawVorticityFourierSource)
    (modes : Finset IntegerWavevector) :
    complexSharpSupportProjection modes
        (generatedComplexVorticityState source modes) =
      generatedComplexVorticityState source modes := by
  ext wave
  by_cases waveMem : wave ∈ modes <;> simp [waveMem]

/-- Adding indices outside the actual generated support does not change the
compiled source state, because the source coefficient is already zero there. -/
theorem generatedComplexVorticityState_eq_generatedSupport_of_subset
    (source : RawVorticityFourierSource)
    (modes : Finset IntegerWavevector)
    (supportSubset : generatedSupport source ⊆ modes) :
    generatedComplexVorticityState source modes =
      generatedComplexVorticityState source (generatedSupport source) := by
  ext wave
  by_cases supportMem : wave ∈ generatedSupport source
  · have modesMem := supportSubset supportMem
    simp [supportMem, modesMem]
  · have coefficientZero :=
      generatedVorticityCoefficient_eq_zero_of_not_mem source supportMem
    by_cases modesMem : wave ∈ modes <;>
      simp [supportMem, modesMem, coefficientZero]

/-! ## Actual finite Galerkin vector field -/

/-- Biot--Savart velocity read from a state on the common Fourier carrier. -/
def finiteStateVelocityCoefficient
    (state : ComplexVorticityHilbertState)
    (wave : IntegerWavevector) : ComplexCoordinateVector :=
  biotSavartVelocityCoefficient wave (state wave)

/-- One actual vorticity nonlinear pair row on an arbitrary coefficient state. -/
def finiteStateVorticityNonlinearPairContribution
    (state : ComplexVorticityHilbertState)
    (pair : StretchingPair) : ComplexCoordinateVector :=
  (Complex.I * (((2 * Real.pi : ℝ) : ℂ)) *
      (complexWavevector pair.2 ⬝ᵥ state pair.1)) •
        finiteStateVelocityCoefficient state pair.2 -
    (Complex.I * (((2 * Real.pi : ℝ) : ℂ)) *
      (complexWavevector pair.2 ⬝ᵥ
        finiteStateVelocityCoefficient state pair.1)) •
          state pair.2

/-- Complete finite ordered-pair aggregation at an arbitrary output wave. -/
def finiteStateVorticityNonlinearCoefficientAt
    (modes : Finset IntegerWavevector)
    (state : ComplexVorticityHilbertState)
    (output : IntegerWavevector) : ComplexCoordinateVector :=
  ∑ first ∈ modes,
    ∑ second ∈ modes,
      if first + second = output then
        finiteStateVorticityNonlinearPairContribution state (first, second)
      else 0

@[simp] theorem finiteStateVorticityNonlinearPairContribution_zero_first
    (state : ComplexVorticityHilbertState)
    (pair : StretchingPair)
    (firstZero : state pair.1 = 0) :
    finiteStateVorticityNonlinearPairContribution state pair = 0 := by
  simp [finiteStateVorticityNonlinearPairContribution,
    finiteStateVelocityCoefficient, firstZero]

@[simp] theorem finiteStateVorticityNonlinearPairContribution_zero_second
    (state : ComplexVorticityHilbertState)
    (pair : StretchingPair)
    (secondZero : state pair.2 = 0) :
    finiteStateVorticityNonlinearPairContribution state pair = 0 := by
  simp [finiteStateVorticityNonlinearPairContribution,
    finiteStateVelocityCoefficient, secondZero]

/-- Enlarging a finite Galerkin index set after sharply projecting the state
back to a smaller support creates no spurious nonlinear row. -/
theorem finiteStateVorticityNonlinearCoefficientAt_projection_of_subset
    {smaller larger : Finset IntegerWavevector}
    (subset : smaller ⊆ larger)
    (state : ComplexVorticityHilbertState)
    (output : IntegerWavevector) :
    finiteStateVorticityNonlinearCoefficientAt larger
        (complexSharpSupportProjection smaller state) output =
      finiteStateVorticityNonlinearCoefficientAt smaller state output := by
  classical
  rw [finiteStateVorticityNonlinearCoefficientAt,
    finiteStateVorticityNonlinearCoefficientAt]
  symm
  apply Finset.sum_subset_zero_on_sdiff subset
  · intro first firstInDifference
    have firstNotMemSmaller := (Finset.mem_sdiff.mp firstInDifference).2
    apply Finset.sum_eq_zero
    intro second secondMem
    by_cases pairSum : first + second = output
    · rw [if_pos pairSum]
      apply finiteStateVorticityNonlinearPairContribution_zero_first
      simp [complexSharpSupportProjection_apply, firstNotMemSmaller]
    · simp [pairSum]
  · intro first firstMemSmaller
    apply Finset.sum_subset_zero_on_sdiff subset
    · intro second secondInDifference
      have secondNotMemSmaller :=
        (Finset.mem_sdiff.mp secondInDifference).2
      by_cases pairSum : first + second = output
      · rw [if_pos pairSum]
        apply finiteStateVorticityNonlinearPairContribution_zero_second
        simp [complexSharpSupportProjection_apply, secondNotMemSmaller]
      · simp [pairSum]
    · intro second secondMemSmaller
      by_cases pairSum : first + second = output
      · simp [pairSum, complexSharpSupportProjection_apply,
          firstMemSmaller, secondMemSmaller,
          finiteStateVorticityNonlinearPairContribution,
          finiteStateVelocityCoefficient]
      · simp [pairSum]

/-- On its exact generated support, the ambient finite-state formula is the
already generated complete source pair aggregation. -/
theorem finiteStateVorticityNonlinearCoefficientAt_generatedSource
    (source : RawVorticityFourierSource)
    (output : IntegerWavevector) :
    finiteStateVorticityNonlinearCoefficientAt
        (generatedSupport source)
        (generatedComplexVorticityState source (generatedSupport source))
        output =
      generatedVorticityNonlinearCoefficientAt source output := by
  classical
  rw [generatedVorticityNonlinearCoefficientAt_eq_fullPairTableSum]
  simp only [finiteStateVorticityNonlinearCoefficientAt,
    generatedStretchingPairTable, Finset.sum_product]
  apply Finset.sum_congr rfl
  intro first firstMem
  apply Finset.sum_congr rfl
  intro second secondMem
  by_cases pairSum : first + second = output
  · simp only [if_pos pairSum]
    simp [finiteStateVorticityNonlinearPairContribution,
      finiteStateVelocityCoefficient,
      generatedVorticityNonlinearPairContribution,
      generatedStretchingPairContribution,
      generatedVorticityAdvectionPairContribution,
      generatedVelocityCoefficient,
      stretchingPairOutput, firstMem, secondMem, pairSum]
  · simp [stretchingPairOutput, pairSum]

/-- The complete source nonlinear coefficient survives passage to any larger
finite Galerkin support containing the source support. -/
theorem finiteStateVorticityNonlinearCoefficientAt_generatedSource_of_subset
    (source : RawVorticityFourierSource)
    (modes : Finset IntegerWavevector)
    (supportSubset : generatedSupport source ⊆ modes)
    (output : IntegerWavevector) :
    finiteStateVorticityNonlinearCoefficientAt modes
        (generatedComplexVorticityState source modes) output =
      generatedVorticityNonlinearCoefficientAt source output := by
  rw [generatedComplexVorticityState_eq_generatedSupport_of_subset
    source modes supportSubset]
  rw [← complexSharpSupportProjection_generatedState_self
    source (generatedSupport source)]
  rw [finiteStateVorticityNonlinearCoefficientAt_projection_of_subset
    supportSubset]
  exact finiteStateVorticityNonlinearCoefficientAt_generatedSource
    source output

/-- Exact positive Fourier multiplier of `-Delta` on the integer torus. -/
def integerWaveViscousMultiplier
    (wave : IntegerWavevector) : ℝ :=
  (2 * Real.pi) ^ 2 * integerWaveNormSq wave

/-- Finite-rank three-dimensional vorticity Galerkin vector field. -/
def finiteStateVorticityGenerator
    (modes : Finset IntegerWavevector)
    (ν : ℝ)
    (state : ComplexVorticityHilbertState) :
    ComplexVorticityHilbertState :=
  ∑ output ∈ modes,
    (lp.singleContinuousLinearMap
      ℝ (fun _ : IntegerWavevector => ComplexCoordinateVector) 2 output)
      (finiteStateVorticityNonlinearCoefficientAt modes state output -
        (ν * integerWaveViscousMultiplier output) • state output)

@[simp] theorem finiteStateVorticityGenerator_apply
    (modes : Finset IntegerWavevector)
    (ν : ℝ)
    (state : ComplexVorticityHilbertState)
    (output : IntegerWavevector) :
    finiteStateVorticityGenerator modes ν state output =
      if output ∈ modes then
        finiteStateVorticityNonlinearCoefficientAt modes state output -
          (ν * integerWaveViscousMultiplier output) • state output
      else 0 := by
  classical
  simp only [finiteStateVorticityGenerator, lp.coeFn_sum,
    lp.singleContinuousLinearMap_apply, lp.coeFn_single,
    Finset.sum_apply, Finset.sum_pi_single]

/-! ## Smoothness and actual local trajectories -/

/-- Fourier-wave evaluation is a smooth vector observer. -/
theorem complexVorticityEvaluation_contDiff
    (wave : IntegerWavevector) :
    ContDiff ℝ 1
      (fun state : ComplexVorticityHilbertState => state wave) := by
  exact
    (lp.evalCLM
      ℝ (fun _ : IntegerWavevector => ComplexCoordinateVector) 2 wave).contDiff

/-- Every scalar Fourier coordinate is a smooth observer. -/
theorem complexVorticityCoordinateEvaluation_contDiff
    (wave : IntegerWavevector)
    (coordinate : Coordinate) :
    ContDiff ℝ 1
      (fun state : ComplexVorticityHilbertState => state wave coordinate) := by
  exact
    (contDiff_apply ℝ ℂ coordinate).comp
      (complexVorticityEvaluation_contDiff wave)

/-- Biot--Savart evaluation at one fixed wave is smooth on the ambient state. -/
theorem finiteStateVelocityCoefficient_contDiff
    (wave : IntegerWavevector) :
    ContDiff ℝ 1
      (fun state : ComplexVorticityHilbertState =>
        finiteStateVelocityCoefficient state wave) := by
  rw [contDiff_pi]
  intro coordinate
  by_cases waveZero : wave = 0
  · subst wave
    simp only [finiteStateVelocityCoefficient,
      biotSavartVelocityCoefficient_zero, Pi.zero_apply]
    exact contDiff_const
  · have coordinateZero :=
      complexVorticityCoordinateEvaluation_contDiff wave 0
    have coordinateOne :=
      complexVorticityCoordinateEvaluation_contDiff wave 1
    have coordinateTwo :=
      complexVorticityCoordinateEvaluation_contDiff wave 2
    fin_cases coordinate
    · have crossCoordinate :
          ContDiff ℝ 1
            (fun state : ComplexVorticityHilbertState =>
              (wave 1 : ℂ) * state wave 2 -
                (wave 2 : ℂ) * state wave 1) :=
        (contDiff_const.mul coordinateTwo).sub
          (contDiff_const.mul coordinateOne)
      simpa [finiteStateVelocityCoefficient,
        biotSavartVelocityCoefficient, waveZero, cross_apply,
        complexWavevector] using contDiff_const.mul crossCoordinate
    · have crossCoordinate :
          ContDiff ℝ 1
            (fun state : ComplexVorticityHilbertState =>
              (wave 2 : ℂ) * state wave 0 -
                (wave 0 : ℂ) * state wave 2) :=
        (contDiff_const.mul coordinateZero).sub
          (contDiff_const.mul coordinateTwo)
      simpa [finiteStateVelocityCoefficient,
        biotSavartVelocityCoefficient, waveZero, cross_apply,
        complexWavevector] using contDiff_const.mul crossCoordinate
    · have crossCoordinate :
          ContDiff ℝ 1
            (fun state : ComplexVorticityHilbertState =>
              (wave 0 : ℂ) * state wave 1 -
                (wave 1 : ℂ) * state wave 0) :=
        (contDiff_const.mul coordinateOne).sub
          (contDiff_const.mul coordinateZero)
      simpa [finiteStateVelocityCoefficient,
        biotSavartVelocityCoefficient, waveZero, cross_apply,
        complexWavevector] using contDiff_const.mul crossCoordinate

/-- Dotting a fixed integer frequency into one Fourier row is a smooth
scalar observer. -/
theorem finiteStateWaveDotCoefficient_contDiff
    (wave observed : IntegerWavevector) :
    ContDiff ℝ 1
      (fun state : ComplexVorticityHilbertState =>
        complexWavevector wave ⬝ᵥ state observed) := by
  unfold dotProduct
  apply ContDiff.sum
  intro coordinate coordinateMem
  exact contDiff_const.mul
    (complexVorticityCoordinateEvaluation_contDiff observed coordinate)

/-- Dotting a fixed integer frequency into a Biot--Savart row is smooth. -/
theorem finiteStateWaveDotVelocity_contDiff
    (wave observed : IntegerWavevector) :
    ContDiff ℝ 1
      (fun state : ComplexVorticityHilbertState =>
        complexWavevector wave ⬝ᵥ
          finiteStateVelocityCoefficient state observed) := by
  unfold dotProduct
  apply ContDiff.sum
  intro coordinate coordinateMem
  exact contDiff_const.mul
    ((contDiff_pi.mp
      (finiteStateVelocityCoefficient_contDiff observed)) coordinate)

/-- One actual pair row is a quadratic smooth vector readout. -/
theorem finiteStateVorticityNonlinearPairContribution_contDiff
    (pair : StretchingPair) :
    ContDiff ℝ 1
      (fun state : ComplexVorticityHilbertState =>
        finiteStateVorticityNonlinearPairContribution state pair) := by
  have stretchingScalar :
      ContDiff ℝ 1
        (fun state : ComplexVorticityHilbertState =>
          Complex.I * (((2 * Real.pi : ℝ) : ℂ)) *
            (complexWavevector pair.2 ⬝ᵥ state pair.1)) :=
    contDiff_const.mul
      (finiteStateWaveDotCoefficient_contDiff pair.2 pair.1)
  have advectionScalar :
      ContDiff ℝ 1
        (fun state : ComplexVorticityHilbertState =>
          Complex.I * (((2 * Real.pi : ℝ) : ℂ)) *
            (complexWavevector pair.2 ⬝ᵥ
              finiteStateVelocityCoefficient state pair.1)) :=
    contDiff_const.mul
      (finiteStateWaveDotVelocity_contDiff pair.2 pair.1)
  rw [contDiff_pi]
  intro coordinate
  unfold finiteStateVorticityNonlinearPairContribution
  simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
  exact
    (stretchingScalar.mul
      ((contDiff_pi.mp
        (finiteStateVelocityCoefficient_contDiff pair.2)) coordinate)).sub
      (advectionScalar.mul
        (complexVorticityCoordinateEvaluation_contDiff pair.2 coordinate))

/-- Each finite nonlinear output row is a quadratic smooth readout. -/
theorem finiteStateVorticityNonlinearCoefficientAt_contDiff
    (modes : Finset IntegerWavevector)
    (output : IntegerWavevector) :
    ContDiff ℝ 1
      (fun state : ComplexVorticityHilbertState =>
        finiteStateVorticityNonlinearCoefficientAt modes state output) := by
  classical
  rw [contDiff_pi]
  intro coordinate
  simp only [finiteStateVorticityNonlinearCoefficientAt,
    Finset.sum_apply]
  apply ContDiff.sum
  intro first firstMem
  apply ContDiff.sum
  intro second secondMem
  by_cases pairSum : first + second = output
  · simp only [if_pos pairSum]
    exact
      (contDiff_pi.mp
        (finiteStateVorticityNonlinearPairContribution_contDiff
          (first, second))) coordinate
  · simp only [if_neg pairSum]
    exact contDiff_const

/-- The finite-rank Galerkin vector field is `C^1` on the whole carrier. -/
theorem finiteStateVorticityGenerator_contDiff
    (modes : Finset IntegerWavevector)
    (ν : ℝ) :
    ContDiff ℝ 1 (finiteStateVorticityGenerator modes ν) := by
  unfold finiteStateVorticityGenerator
  apply ContDiff.sum
  intro output outputMem
  have viscousContDiff :
      ContDiff ℝ 1
        (fun state : ComplexVorticityHilbertState =>
          (ν * integerWaveViscousMultiplier output) • state output) := by
    rw [contDiff_pi]
    intro coordinate
    simp only [Pi.smul_apply]
    exact
      ContDiff.const_smul
        (ν * integerWaveViscousMultiplier output)
        (complexVorticityCoordinateEvaluation_contDiff output coordinate)
  have rowContDiff :
      ContDiff ℝ 1
        (fun state : ComplexVorticityHilbertState =>
          finiteStateVorticityNonlinearCoefficientAt modes state output -
            (ν * integerWaveViscousMultiplier output) • state output) :=
    (finiteStateVorticityNonlinearCoefficientAt_contDiff modes output).sub
      viscousContDiff
  exact contDiff_const.clm_apply rowContDiff

/-- Picard--Lindelof generates an actual local Galerkin trajectory from any
finite three-dimensional coefficient state.  The trajectory and radius are
conclusions, not source fields. -/
theorem exists_finiteStateVorticity_localTrajectory
    (modes : Finset IntegerWavevector)
    (ν : ℝ)
    (initialState : ComplexVorticityHilbertState) :
    ∃ trajectory : ℝ → ComplexVorticityHilbertState,
      trajectory 0 = initialState ∧
        ∃ ε > (0 : ℝ),
          ∀ t ∈ Ioo (-ε) ε,
            HasDerivAt trajectory
              (finiteStateVorticityGenerator modes ν (trajectory t)) t := by
  obtain ⟨trajectory, initial, ε, εPos, evolves⟩ :=
    (finiteStateVorticityGenerator_contDiff modes ν).contDiffAt
      |>.exists_forall_mem_closedBall_exists_eq_forall_mem_Ioo_hasDerivAt₀
        0
  exact ⟨trajectory, initial, ε, εPos, by simpa using evolves⟩

/-! ## Successful shell responses acquire actual PDE time -/

/-- Galerkin support generated by one successful whole-shell response. -/
def generatedIntegerShellGalerkinModes
    (current : RawVorticityFourierSource)
    (response : Response GeneratedIntegerShellStep current) :
    Finset IntegerWavevector :=
  generatedSupport current ∪
    generatedOuterNonlinearShellModes current response.2.shellSq

/-- Initial Galerkin state attached to the same response event. -/
def generatedIntegerShellGalerkinInitialState
    (current : RawVorticityFourierSource)
    (response : Response GeneratedIntegerShellStep current) :
    ComplexVorticityHilbertState :=
  generatedComplexVorticityState current
    (generatedIntegerShellGalerkinModes current response)

theorem generatedSupport_subset_generatedIntegerShellGalerkinModes
    (current : RawVorticityFourierSource)
    (response : Response GeneratedIntegerShellStep current) :
    generatedSupport current ⊆
      generatedIntegerShellGalerkinModes current response := by
  exact Finset.subset_union_left

theorem generatedOuterNonlinearShellModes_subset_galerkinModes
    (current : RawVorticityFourierSource)
    (response : Response GeneratedIntegerShellStep current) :
    generatedOuterNonlinearShellModes current response.2.shellSq ⊆
      generatedIntegerShellGalerkinModes current response := by
  exact Finset.subset_union_right

/-- A mode selected for the next outer shell is genuinely silent in the
current coefficient table. -/
theorem generatedVorticityCoefficient_eq_zero_of_mem_outerNonlinearShell
    (current : RawVorticityFourierSource)
    (shellSq : ℤ)
    {output : IntegerWavevector}
    (membership :
      output ∈ generatedOuterNonlinearShellModes current shellSq) :
    generatedVorticityCoefficient current output = 0 := by
  have activeMembership :
      output ∈ generatedActiveOuterNonlinearModes current :=
    ((mem_generatedOuterNonlinearShellModes_iff
      current shellSq output).mp membership).1
  have notLive : output ∉ generatedLiveVorticityModes current := by
    unfold generatedActiveOuterNonlinearModes at activeMembership
    split at activeMembership
    · simp at activeMembership
    · exact (Finset.mem_filter.mp activeMembership).2.2.1
  by_cases supportMembership : output ∈ generatedSupport current
  · by_contra coefficientNonzero
    exact notLive
      ((mem_generatedLiveVorticityModes_iff current output).mpr
        ⟨supportMembership, coefficientNonzero⟩)
  · exact generatedVorticityCoefficient_eq_zero_of_not_mem
      current supportMembership

/-- Every member of the selected active shell carries a nonzero complete
old-source nonlinear coefficient. -/
theorem generatedVorticityNonlinearCoefficientAt_ne_zero_of_mem_outerShell
    (current : RawVorticityFourierSource)
    (shellSq : ℤ)
    {output : IntegerWavevector}
    (membership :
      output ∈ generatedOuterNonlinearShellModes current shellSq) :
    generatedVorticityNonlinearCoefficientAt current output ≠ 0 := by
  have activeMembership :
      output ∈ generatedActiveOuterNonlinearModes current :=
    ((mem_generatedOuterNonlinearShellModes_iff
      current shellSq output).mp membership).1
  unfold generatedActiveOuterNonlinearModes at activeMembership
  split at activeMembership
  · simp at activeMembership
  · exact (Finset.mem_filter.mp activeMembership).2.2.2.2

@[simp] theorem generatedIntegerShellGalerkinInitialState_apply
    (current : RawVorticityFourierSource)
    (response : Response GeneratedIntegerShellStep current)
    (output : IntegerWavevector) :
    generatedIntegerShellGalerkinInitialState current response output =
      if output ∈ generatedIntegerShellGalerkinModes current response
      then generatedVorticityCoefficient current output
      else 0 := by
  simp [generatedIntegerShellGalerkinInitialState]

/-- The actual Galerkin tangent on every selected output is exactly the
complete source nonlinear row which generated the shell response. -/
theorem generatedIntegerShellGalerkinGenerator_selectedOutput
    (current : RawVorticityFourierSource)
    (response : Response GeneratedIntegerShellStep current)
    (ν : ℝ)
    {output : IntegerWavevector}
    (membership :
      output ∈ generatedOuterNonlinearShellModes
        current response.2.shellSq) :
    finiteStateVorticityGenerator
        (generatedIntegerShellGalerkinModes current response) ν
        (generatedIntegerShellGalerkinInitialState current response)
        output =
      generatedVorticityNonlinearCoefficientAt current output := by
  have outputMem :
      output ∈ generatedIntegerShellGalerkinModes current response :=
    generatedOuterNonlinearShellModes_subset_galerkinModes
      current response membership
  simp only [generatedIntegerShellGalerkinInitialState]
  rw [finiteStateVorticityGenerator_apply, if_pos outputMem]
  rw [finiteStateVorticityNonlinearCoefficientAt_generatedSource_of_subset
    current (generatedIntegerShellGalerkinModes current response)
    (generatedSupport_subset_generatedIntegerShellGalerkinModes
      current response)]
  rw [generatedComplexVorticityState_apply,
    if_pos outputMem,
    generatedVorticityCoefficient_eq_zero_of_mem_outerNonlinearShell
      current response.2.shellSq membership]
  simp

/-- A differentiable trajectory on the common carrier is differentiable in
every whole Fourier row. -/
theorem complexVorticityTrajectoryWave_hasDerivAt
    (trajectory : ℝ → ComplexVorticityHilbertState)
    (t : ℝ)
    (tangent : ComplexVorticityHilbertState)
    (wave : IntegerWavevector)
    (evolves : HasDerivAt trajectory tangent t) :
    HasDerivAt
      (fun time => trajectory time wave)
      (tangent wave) t := by
  have observed :
      HasDerivAt
        (fun time =>
          (lp.evalCLM
            ℝ (fun _ : IntegerWavevector => ComplexCoordinateVector) 2 wave)
              (trajectory time))
        ((lp.evalCLM
          ℝ (fun _ : IntegerWavevector => ComplexCoordinateVector) 2 wave)
            tangent) t := by
    simpa using
      ((hasDerivAt_const t
        (lp.evalCLM
          ℝ (fun _ : IntegerWavevector => ComplexCoordinateVector) 2 wave)).clm_apply
            evolves)
  exact observed

/-- A literal successful source response generates an actual local
three-dimensional Galerkin trajectory.  At time zero every whole-shell row
starts at zero with the exact nonzero nonlinear derivative that generated
the response.

This theorem supplies physical time and the actual update law; neither is a
field of `GeneratedIntegerShellStep`. -/
theorem generatedIntegerShellRespond_localTrajectory
    (current : RawVorticityFourierSource)
    (response : Response GeneratedIntegerShellStep current)
    (generated : generatedIntegerShellRespond current = some response)
    (ν : ℝ) :
    ∃ (trajectory : ℝ → ComplexVorticityHilbertState) (ε : ℝ),
      0 < ε ∧
        trajectory 0 =
          generatedIntegerShellGalerkinInitialState current response ∧
        generatedNextOuterNonlinearShellSq? current =
          some response.2.shellSq ∧
        (∀ t ∈ Ioo (-ε) ε,
          HasDerivAt trajectory
            (finiteStateVorticityGenerator
              (generatedIntegerShellGalerkinModes current response)
              ν (trajectory t)) t) ∧
        ∀ output ∈ generatedOuterNonlinearShellModes
            current response.2.shellSq,
          HasDerivAt
              (fun time => trajectory time output)
              (generatedVorticityNonlinearCoefficientAt current output) 0 ∧
            trajectory 0 output = 0 ∧
            generatedVorticityNonlinearCoefficientAt current output ≠ 0 := by
  obtain ⟨trajectory, initial, ε, εPos, evolves⟩ :=
    exists_finiteStateVorticity_localTrajectory
      (generatedIntegerShellGalerkinModes current response) ν
      (generatedIntegerShellGalerkinInitialState current response)
  have selected :=
    generatedIntegerShellRespond_selectedShell current response generated
  refine ⟨trajectory, ε, εPos, initial, selected, evolves, ?_⟩
  intro output membership
  have zeroInWindow : (0 : ℝ) ∈ Ioo (-ε) ε := by
    constructor <;> linarith
  have rowDerivative :=
    complexVorticityTrajectoryWave_hasDerivAt
      trajectory 0
      (finiteStateVorticityGenerator
        (generatedIntegerShellGalerkinModes current response)
        ν (trajectory 0)) output
      (evolves 0 zeroInWindow)
  rw [initial,
    generatedIntegerShellGalerkinGenerator_selectedOutput
      current response ν membership] at rowDerivative
  have outputMem :
      output ∈ generatedIntegerShellGalerkinModes current response :=
    generatedOuterNonlinearShellModes_subset_galerkinModes
      current response membership
  have initialZero : trajectory 0 output = 0 := by
    rw [initial, generatedIntegerShellGalerkinInitialState_apply,
      if_pos outputMem,
      generatedVorticityCoefficient_eq_zero_of_mem_outerNonlinearShell
        current response.2.shellSq membership]
  exact
    ⟨rowDerivative, initialZero,
      generatedVorticityNonlinearCoefficientAt_ne_zero_of_mem_outerShell
        current response.2.shellSq membership⟩

/-- A nonzero vector derivative at a zero row gives a quantitative linear
amplitude lower bound on a source-generated right neighborhood. -/
theorem eventually_norm_gt_time_mul_half_of_hasDerivAt_zero_ne
    {E : Type*}
    [NormedAddCommGroup E]
    [NormedSpace ℝ E]
    (f : ℝ → E)
    (derivative : E)
    (initial : f 0 = 0)
    (derivativeNonzero : derivative ≠ 0)
    (hasDerivative : HasDerivAt f derivative 0) :
    ∀ᶠ t in 𝓝[>] (0 : ℝ),
      t * (‖derivative‖ / 2) < ‖f t‖ := by
  have derivativeNormPos : 0 < ‖derivative‖ :=
    norm_pos_iff.mpr derivativeNonzero
  have eventuallySlope :
      ∀ᶠ t in 𝓝[>] (0 : ℝ),
        ‖derivative‖ / 2 <
          ‖t⁻¹ • (f (0 + t) - f 0)‖ :=
    hasDerivative.tendsto_slope_zero_right.norm.eventually
      (eventually_gt_nhds (by linarith))
  filter_upwards [eventuallySlope, self_mem_nhdsWithin] with t slope tPos
  have tPositive : 0 < t := tPos
  rw [zero_add, initial, sub_zero, norm_smul,
    Real.norm_eq_abs, abs_inv, abs_of_pos tPositive] at slope
  have slopeAsDivision :
      ‖derivative‖ / 2 < ‖f t‖ / t := by
    simpa [div_eq_mul_inv, mul_comm] using slope
  have multiplied := (lt_div_iff₀ tPositive).mp slopeAsDivision
  simpa [mul_comm] using multiplied

/-- A successful whole-shell response generates a common positive physical
time window on which every row of that shell is live along the same actual
Galerkin trajectory.

The common window is obtained by the finite intersection of the punctured
neighborhoods generated by the nonzero derivatives.  It is not a stored
duration, and the theorem does not identify the positive-time endpoint with
the symbolic tangent write-back `response.1`. -/
theorem generatedIntegerShellRespond_drives_actualShellActivation
    (current : RawVorticityFourierSource)
    (response : Response GeneratedIntegerShellStep current)
    (generated : generatedIntegerShellRespond current = some response)
    (ν : ℝ) :
    ∃ (trajectory : ℝ → ComplexVorticityHilbertState)
        (radius activationTime : ℝ),
      0 < activationTime ∧
        activationTime < radius ∧
        trajectory 0 =
          generatedIntegerShellGalerkinInitialState current response ∧
        generatedNextOuterNonlinearShellSq? current =
          some response.2.shellSq ∧
        (generatedOuterNonlinearShellModes
          current response.2.shellSq).Nonempty ∧
        (∀ t ∈ Ioo (-radius) radius,
          HasDerivAt trajectory
            (finiteStateVorticityGenerator
              (generatedIntegerShellGalerkinModes current response)
              ν (trajectory t)) t) ∧
        (∀ output ∈ generatedOuterNonlinearShellModes
            current response.2.shellSq,
          HasDerivAt
              (fun time => trajectory time output)
              (generatedVorticityNonlinearCoefficientAt current output) 0 ∧
            trajectory 0 output = 0 ∧
            generatedVorticityNonlinearCoefficientAt current output ≠ 0) ∧
        (∀ t ∈ Ioc (0 : ℝ) activationTime,
          ∀ output ∈ generatedOuterNonlinearShellModes
              current response.2.shellSq,
            t *
                (‖generatedVorticityNonlinearCoefficientAt current output‖ /
                  2) <
              ‖trajectory t output‖) ∧
        ∀ t ∈ Ioc (0 : ℝ) activationTime,
          ∀ output ∈ generatedOuterNonlinearShellModes
              current response.2.shellSq,
            trajectory t output ≠ 0 := by
  obtain
      ⟨trajectory, radius, radiusPos, initial, selected,
        evolves, shellDerivative⟩ :=
    generatedIntegerShellRespond_localTrajectory
      current response generated ν
  rcases
      exists_outer_mode_of_generatedNextOuterNonlinearShellSq?_eq_some
        current response.2.shellSq selected with
    ⟨witnessOutput, witnessOuter, witnessShell⟩
  have shellNonempty :
      (generatedOuterNonlinearShellModes
        current response.2.shellSq).Nonempty := by
    exact
      ⟨witnessOutput,
        (mem_generatedOuterNonlinearShellModes_iff
          current response.2.shellSq witnessOutput).mpr
          ⟨witnessOuter, witnessShell⟩⟩
  have eventuallyShellLowerBound :
      ∀ᶠ t in 𝓝[>] (0 : ℝ),
        ∀ output ∈ generatedOuterNonlinearShellModes
            current response.2.shellSq,
          t *
              (‖generatedVorticityNonlinearCoefficientAt current output‖ /
                2) <
            ‖trajectory t output‖ := by
    rw [eventually_all_finset]
    intro output membership
    obtain ⟨rowDerivative, initialZero, derivativeNonzero⟩ :=
      shellDerivative output membership
    exact
      eventually_norm_gt_time_mul_half_of_hasDerivAt_zero_ne
        (fun time => trajectory time output)
        (generatedVorticityNonlinearCoefficientAt current output)
        initialZero derivativeNonzero rowDerivative
  have eventuallyNeighborhood :
      ∀ᶠ t in 𝓝 (0 : ℝ),
        t ∈ Ioi (0 : ℝ) →
          ∀ output ∈ generatedOuterNonlinearShellModes
              current response.2.shellSq,
            t *
                (‖generatedVorticityNonlinearCoefficientAt current output‖ /
                  2) <
              ‖trajectory t output‖ :=
    eventually_nhdsWithin_iff.mp eventuallyShellLowerBound
  obtain ⟨liveRadius, liveRadiusPos, liveWithin⟩ :=
    Metric.eventually_nhds_iff.mp eventuallyNeighborhood
  let activationTime := min radius liveRadius / 2
  have commonRadiusPos : 0 < min radius liveRadius :=
    lt_min radiusPos liveRadiusPos
  have activationTimePos : 0 < activationTime := by
    dsimp [activationTime]
    linarith
  have activationTimeLtCommon :
      activationTime < min radius liveRadius := by
    dsimp [activationTime]
    linarith
  have activationTimeLtRadius : activationTime < radius :=
    lt_of_lt_of_le activationTimeLtCommon (min_le_left _ _)
  have activationTimeLtLiveRadius : activationTime < liveRadius :=
    lt_of_lt_of_le activationTimeLtCommon (min_le_right _ _)
  refine
    ⟨trajectory, radius, activationTime,
      activationTimePos, activationTimeLtRadius, initial, selected,
      shellNonempty, evolves, shellDerivative, ?_, ?_⟩
  intro t timeMembership output outputMembership
  have tPos : 0 < t := timeMembership.1
  have tLtLiveRadius : t < liveRadius :=
    lt_of_le_of_lt timeMembership.2 activationTimeLtLiveRadius
  exact liveWithin
    (by
      rw [Real.dist_eq, sub_zero, abs_of_pos tPos]
      exact tLtLiveRadius)
    tPos output outputMembership
  · intro t timeMembership output outputMembership
    have tPos : 0 < t := timeMembership.1
    have lowerBound := liveWithin
      (by
        rw [Real.dist_eq, sub_zero, abs_of_pos tPos]
        exact
          lt_of_le_of_lt timeMembership.2
            activationTimeLtLiveRadius)
      tPos output outputMembership
    have derivativeNonzero :=
      generatedVorticityNonlinearCoefficientAt_ne_zero_of_mem_outerShell
        current response.2.shellSq outputMembership
    have derivativeNormPos :
        0 < ‖generatedVorticityNonlinearCoefficientAt current output‖ :=
      norm_pos_iff.mpr derivativeNonzero
    intro outputZero
    rw [outputZero, norm_zero] at lowerBound
    have leftPositive :
        0 <
          t *
            (‖generatedVorticityNonlinearCoefficientAt current output‖ /
              2) :=
      mul_pos tPos (half_pos derivativeNormPos)
    linarith

end

