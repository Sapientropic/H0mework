import Mathlib.Data.Complex.BigOperators
import Mathlib.LinearAlgebra.CrossProduct
import H0mework.NavierStokes.Fourier.IntegerCharacterCoarseFilter

/-!
# Raw finite three-dimensional vorticity Fourier source

This module introduces the lower source carrier needed by the genuine
three-dimensional vorticity line.  A caller supplies only a finite set of
integer frequencies and an unconstrained complex vorticity table.  The source
itself then generates:

* closure of the finite support under `k ↦ -k`, with the zero wave removed;
* coordinatewise conjugate-reality symmetrization;
* projection of every generated vorticity coefficient to `k⊥`;
* the three-dimensional Biot--Savart velocity coefficient, including the
  `2π` dictated by the repository character `exp (i 2π k · x)`.

Reality, divergence freedom, coefficient nonvanishing, a selected output, and
a target trajectory are not fields of the source.  This module stops before
the physical exponential compiler and the ordered-pair nonlinear update.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalVorticityCoefficientRawSourceCore

open scoped BigOperators Matrix

open Matrix
open ThreeDimensionalPeriodicCoarseFilterCore
open ThreeDimensionalPeriodicIntegerCharacterCoarseFilter

noncomputable section

/-! ## Raw source and generated support -/

/-- Complex coordinate vectors used by the three-dimensional Fourier source. -/
abbrev ComplexCoordinateVector := Coordinate → ℂ

/--
The primitive source mouth.  Both fields are unconstrained caller data; all
physical closure laws are generated below.
-/
structure RawVorticityFourierSource where
  activeModes : Finset IntegerWavevector
  rawVorticity : IntegerWavevector → ComplexCoordinateVector

/-- Coordinatewise negation of an integer wavevector. -/
def waveNeg (wave : IntegerWavevector) : IntegerWavevector :=
  -wave

@[simp] theorem waveNeg_apply
    (wave : IntegerWavevector) (coordinate : Coordinate) :
    waveNeg wave coordinate = -wave coordinate :=
  rfl

@[simp] theorem waveNeg_involutive
    (wave : IntegerWavevector) :
    waveNeg (waveNeg wave) = wave := by
  simp [waveNeg]

@[simp] theorem waveNeg_eq_zero_iff
    (wave : IntegerWavevector) :
    waveNeg wave = 0 ↔ wave = 0 := by
  simp [waveNeg]

/--
The finite source support generated by adjoining every negative frequency and
then removing the zero wave.
-/
def generatedSupport
    (source : RawVorticityFourierSource) : Finset IntegerWavevector :=
  (source.activeModes ∪ source.activeModes.image waveNeg).erase 0

@[simp] theorem zero_not_mem_generatedSupport
    (source : RawVorticityFourierSource) :
    0 ∉ generatedSupport source := by
  simp [generatedSupport]

theorem generatedSupport_waveNeg_mem
    (source : RawVorticityFourierSource)
    {wave : IntegerWavevector}
    (membership : wave ∈ generatedSupport source) :
    waveNeg wave ∈ generatedSupport source := by
  rw [generatedSupport] at membership ⊢
  have wave_ne_zero : wave ≠ 0 := (Finset.mem_erase.mp membership).1
  have unionMembership := (Finset.mem_erase.mp membership).2
  rw [Finset.mem_erase]
  refine ⟨?_, ?_⟩
  · simpa using wave_ne_zero
  · rcases Finset.mem_union.mp unionMembership with original | generated
    · exact Finset.mem_union_right _ (Finset.mem_image.mpr ⟨wave, original, rfl⟩)
    · rcases Finset.mem_image.mp generated with ⟨originalWave, original, equality⟩
      have wave_eq : wave = waveNeg originalWave := equality.symm
      rw [wave_eq, waveNeg_involutive]
      exact Finset.mem_union_left _ original

@[simp] theorem mem_generatedSupport_waveNeg_iff
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) :
    waveNeg wave ∈ generatedSupport source ↔
      wave ∈ generatedSupport source := by
  constructor
  · intro membership
    simpa using generatedSupport_waveNeg_mem source membership
  · exact generatedSupport_waveNeg_mem source

/-! ## Complex vector and frequency algebra -/

/-- Coordinatewise complex conjugation. -/
def vectorConj (vector : ComplexCoordinateVector) : ComplexCoordinateVector :=
  fun coordinate => star (vector coordinate)

@[simp] theorem vectorConj_apply
    (vector : ComplexCoordinateVector) (coordinate : Coordinate) :
    vectorConj vector coordinate = star (vector coordinate) :=
  rfl

@[simp] theorem vectorConj_zero :
    vectorConj (0 : ComplexCoordinateVector) = 0 := by
  funext coordinate
  simp [vectorConj]

@[simp] theorem vectorConj_involutive
    (vector : ComplexCoordinateVector) :
    vectorConj (vectorConj vector) = vector := by
  funext coordinate
  simp [vectorConj]

@[simp] theorem vectorConj_sub
    (left right : ComplexCoordinateVector) :
    vectorConj (left - right) =
      vectorConj left - vectorConj right := by
  funext coordinate
  simp [vectorConj]

@[simp] theorem vectorConj_smul
    (scalar : ℂ) (vector : ComplexCoordinateVector) :
    vectorConj (scalar • vector) =
      star scalar • vectorConj vector := by
  funext coordinate
  simp [vectorConj]

/-- Cast an integer frequency coordinatewise to the complex coefficient ring. -/
def complexWavevector
    (wave : IntegerWavevector) : ComplexCoordinateVector :=
  fun coordinate => ((wave coordinate : ℝ) : ℂ)

@[simp] theorem complexWavevector_apply
    (wave : IntegerWavevector) (coordinate : Coordinate) :
    complexWavevector wave coordinate = ((wave coordinate : ℝ) : ℂ) :=
  rfl

@[simp] theorem complexWavevector_zero :
    complexWavevector 0 = 0 := by
  funext coordinate
  simp [complexWavevector]

@[simp] theorem complexWavevector_waveNeg
    (wave : IntegerWavevector) :
    complexWavevector (waveNeg wave) = -complexWavevector wave := by
  funext coordinate
  simp [complexWavevector, waveNeg]

@[simp] theorem vectorConj_complexWavevector
    (wave : IntegerWavevector) :
    vectorConj (complexWavevector wave) = complexWavevector wave := by
  funext coordinate
  simp [vectorConj, complexWavevector]

/-- Squared Euclidean length of an integer frequency, kept in `ℝ`. -/
def integerWaveNormSq (wave : IntegerWavevector) : ℝ :=
  ∑ coordinate : Coordinate, (wave coordinate : ℝ) ^ 2

theorem integerWaveNormSq_nonneg
    (wave : IntegerWavevector) :
    0 ≤ integerWaveNormSq wave := by
  unfold integerWaveNormSq
  exact Finset.sum_nonneg fun _ _ => sq_nonneg _

@[simp] theorem integerWaveNormSq_zero :
    integerWaveNormSq 0 = 0 := by
  simp [integerWaveNormSq]

@[simp] theorem integerWaveNormSq_waveNeg
    (wave : IntegerWavevector) :
    integerWaveNormSq (waveNeg wave) = integerWaveNormSq wave := by
  simp [integerWaveNormSq, waveNeg]

theorem integerWaveNormSq_eq_zero_iff
    (wave : IntegerWavevector) :
    integerWaveNormSq wave = 0 ↔ wave = 0 := by
  constructor
  · intro normZero
    funext coordinate
    have coordinateSqZero : (wave coordinate : ℝ) ^ 2 = 0 :=
      congrFun
        ((Fintype.sum_eq_zero_iff_of_nonneg
          fun i => sq_nonneg (wave i : ℝ)).mp normZero)
        coordinate
    have coordinateZero : (wave coordinate : ℝ) = 0 :=
      sq_eq_zero_iff.mp coordinateSqZero
    exact_mod_cast coordinateZero
  · rintro rfl
    exact integerWaveNormSq_zero

theorem integerWaveNormSq_pos
    {wave : IntegerWavevector}
    (wave_ne_zero : wave ≠ 0) :
    0 < integerWaveNormSq wave := by
  exact lt_of_le_of_ne (integerWaveNormSq_nonneg wave)
    (Ne.symm ((integerWaveNormSq_eq_zero_iff wave).not.mpr wave_ne_zero))

theorem integerWaveNormSq_ne_zero
    {wave : IntegerWavevector}
    (wave_ne_zero : wave ≠ 0) :
    integerWaveNormSq wave ≠ 0 :=
  ne_of_gt (integerWaveNormSq_pos wave_ne_zero)

theorem complexWavevector_dot_self
    (wave : IntegerWavevector) :
    complexWavevector wave ⬝ᵥ complexWavevector wave =
      (integerWaveNormSq wave : ℂ) := by
  unfold integerWaveNormSq complexWavevector dotProduct
  rw [Complex.ofReal_sum]
  apply Finset.sum_congr rfl
  intro coordinate _
  rw [Complex.ofReal_pow]
  simp [pow_two]

/-! ## Generated reality symmetrization -/

/-- Raw coefficients outside the caller's finite support are ignored. -/
def supportedRawVorticity
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) : ComplexCoordinateVector :=
  if wave ∈ source.activeModes then source.rawVorticity wave else 0

theorem supportedRawVorticity_eq_zero_of_not_mem
    (source : RawVorticityFourierSource)
    {wave : IntegerWavevector}
    (not_mem : wave ∉ source.activeModes) :
    supportedRawVorticity source wave = 0 := by
  simp [supportedRawVorticity, not_mem]

/--
Coordinatewise averaging with the conjugate negative-frequency row generates
the physical Fourier reality law from unconstrained raw data.
-/
def realitySymmetrizedVorticity
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) : ComplexCoordinateVector :=
  fun coordinate =>
    (supportedRawVorticity source wave coordinate +
        star
          (supportedRawVorticity source (waveNeg wave) coordinate)) / 2

theorem realitySymmetrizedVorticity_waveNeg
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) :
    realitySymmetrizedVorticity source (waveNeg wave) =
    vectorConj (realitySymmetrizedVorticity source wave) := by
  funext coordinate
  simp [realitySymmetrizedVorticity, vectorConj]
  ring

/-! ## Source-generated transverse vorticity -/

/-- Bilinear projection onto the plane perpendicular to a nonzero frequency. -/
def transverseProjection
    (wave : IntegerWavevector)
    (vector : ComplexCoordinateVector) : ComplexCoordinateVector :=
  if wave = 0 then 0
  else
    vector -
      ((complexWavevector wave ⬝ᵥ vector) /
          (integerWaveNormSq wave : ℂ)) •
        complexWavevector wave

theorem complexWavevector_dot_transverseProjection
    (wave : IntegerWavevector)
    (vector : ComplexCoordinateVector) :
    complexWavevector wave ⬝ᵥ transverseProjection wave vector = 0 := by
  by_cases waveZero : wave = 0
  · simp [transverseProjection, waveZero]
  · rw [transverseProjection, if_neg waveZero,
      dotProduct_sub, dotProduct_smul,
      complexWavevector_dot_self]
    have normComplex_ne_zero :
        (integerWaveNormSq wave : ℂ) ≠ 0 := by
      exact_mod_cast integerWaveNormSq_ne_zero waveZero
    simp only [smul_eq_mul]
    field_simp [normComplex_ne_zero]
    ring

theorem complexWavevector_waveNeg_dot_vectorConj
    (wave : IntegerWavevector)
    (vector : ComplexCoordinateVector) :
    complexWavevector (waveNeg wave) ⬝ᵥ vectorConj vector =
      -star (complexWavevector wave ⬝ᵥ vector) := by
  simp [dotProduct, vectorConj, complexWavevector, waveNeg]

@[simp] theorem vectorConj_crossProduct
    (left right : ComplexCoordinateVector) :
    vectorConj (left ⨯₃ right) =
      vectorConj left ⨯₃ vectorConj right := by
  funext coordinate
  fin_cases coordinate <;>
    simp [vectorConj, cross_apply]

theorem transverseProjection_waveNeg_vectorConj
    (wave : IntegerWavevector)
    (vector : ComplexCoordinateVector) :
    transverseProjection (waveNeg wave) (vectorConj vector) =
      vectorConj (transverseProjection wave vector) := by
  by_cases waveZero : wave = 0
  · subst wave
    simp [transverseProjection]
  · have negWave_ne_zero : waveNeg wave ≠ 0 := by
      simpa using waveZero
    rw [transverseProjection, if_neg negWave_ne_zero,
      transverseProjection, if_neg waveZero,
      complexWavevector_waveNeg_dot_vectorConj,
      integerWaveNormSq_waveNeg, complexWavevector_waveNeg,
      vectorConj_sub, vectorConj_smul,
      vectorConj_complexWavevector]
    funext coordinate
    simp only [Pi.sub_apply, Pi.smul_apply, Pi.neg_apply,
      vectorConj_apply, smul_eq_mul]
    simp
    ring

/--
Generated vorticity coefficient: support restriction, reality symmetrization,
and transverse projection occur in that order.
-/
def generatedVorticityCoefficient
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) : ComplexCoordinateVector :=
  if wave ∈ generatedSupport source then
    transverseProjection wave
      (realitySymmetrizedVorticity source wave)
  else 0

theorem generatedVorticityCoefficient_eq_zero_of_not_mem
    (source : RawVorticityFourierSource)
    {wave : IntegerWavevector}
    (not_mem : wave ∉ generatedSupport source) :
    generatedVorticityCoefficient source wave = 0 := by
  simp [generatedVorticityCoefficient, not_mem]

@[simp] theorem generatedVorticityCoefficient_zero
    (source : RawVorticityFourierSource) :
    generatedVorticityCoefficient source 0 = 0 := by
  exact generatedVorticityCoefficient_eq_zero_of_not_mem source
    (zero_not_mem_generatedSupport source)

theorem generatedVorticityCoefficient_waveNeg
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) :
    generatedVorticityCoefficient source (waveNeg wave) =
      vectorConj (generatedVorticityCoefficient source wave) := by
  by_cases membership : wave ∈ generatedSupport source
  · have negMembership : waveNeg wave ∈ generatedSupport source :=
      generatedSupport_waveNeg_mem source membership
    simp only [generatedVorticityCoefficient, if_pos membership,
      if_pos negMembership]
    rw [
      realitySymmetrizedVorticity_waveNeg,
      transverseProjection_waveNeg_vectorConj]
  · have negNotMembership : waveNeg wave ∉ generatedSupport source := by
      simpa using membership
    simp only [generatedVorticityCoefficient, if_neg membership,
      if_neg negNotMembership,
      vectorConj_zero]

theorem generatedVorticityCoefficient_transverse
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) :
    complexWavevector wave ⬝ᵥ
        generatedVorticityCoefficient source wave = 0 := by
  by_cases membership : wave ∈ generatedSupport source
  · rw [generatedVorticityCoefficient, if_pos membership]
    exact complexWavevector_dot_transverseProjection _ _
  · rw [generatedVorticityCoefficient, if_neg membership,
      dotProduct_zero]

/-! ## Source-generated Biot--Savart velocity -/

/--
The Fourier coefficient of the physical curl for the repository character
`exp (i 2π k · x)`.  The factor `2π` is therefore part of the operator,
not a later normalization convention.
-/
def fourierCurlCoefficient
    (wave : IntegerWavevector)
    (velocity : ComplexCoordinateVector) : ComplexCoordinateVector :=
  (Complex.I * (((2 * Real.pi : ℝ) : ℂ))) •
    (complexWavevector wave ⨯₃ velocity)

/--
Three-dimensional Biot--Savart inversion at a single nonzero integer
frequency.  The zero frequency is removed by definition.
-/
def biotSavartVelocityCoefficient
    (wave : IntegerWavevector)
    (vorticity : ComplexCoordinateVector) : ComplexCoordinateVector :=
  if wave = 0 then 0
  else
    (Complex.I /
        (((2 * Real.pi * integerWaveNormSq wave : ℝ) : ℂ))) •
      (complexWavevector wave ⨯₃ vorticity)

@[simp] theorem biotSavartVelocityCoefficient_zero
    (vorticity : ComplexCoordinateVector) :
    biotSavartVelocityCoefficient 0 vorticity = 0 := by
  simp [biotSavartVelocityCoefficient]

theorem biotSavartVelocityCoefficient_waveNeg_vectorConj
    (wave : IntegerWavevector)
    (vorticity : ComplexCoordinateVector) :
    biotSavartVelocityCoefficient (waveNeg wave) (vectorConj vorticity) =
      vectorConj (biotSavartVelocityCoefficient wave vorticity) := by
  by_cases waveZero : wave = 0
  · subst wave
    simp [waveNeg, biotSavartVelocityCoefficient]
  · have negWave_ne_zero : waveNeg wave ≠ 0 := by
      simpa using waveZero
    rw [biotSavartVelocityCoefficient, if_neg negWave_ne_zero,
      biotSavartVelocityCoefficient, if_neg waveZero,
      integerWaveNormSq_waveNeg, complexWavevector_waveNeg,
      vectorConj_smul, vectorConj_crossProduct,
      vectorConj_complexWavevector]
    funext coordinate
    fin_cases coordinate <;>
      simp [cross_apply, vectorConj] <;>
      ring

theorem complexWavevector_dot_biotSavartVelocityCoefficient
    (wave : IntegerWavevector)
    (vorticity : ComplexCoordinateVector) :
    complexWavevector wave ⬝ᵥ
        biotSavartVelocityCoefficient wave vorticity = 0 := by
  by_cases waveZero : wave = 0
  · subst wave
    simp
  · rw [biotSavartVelocityCoefficient, if_neg waveZero,
      dotProduct_smul, dot_self_cross]
    simp

@[simp] theorem biotSavartVelocityCoefficient_zero_vorticity
    (wave : IntegerWavevector) :
    biotSavartVelocityCoefficient wave 0 = 0 := by
  simp [biotSavartVelocityCoefficient]

/-- Velocity generated from the already symmetrized transverse vorticity. -/
def generatedVelocityCoefficient
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) : ComplexCoordinateVector :=
  biotSavartVelocityCoefficient wave
    (generatedVorticityCoefficient source wave)

@[simp] theorem generatedVelocityCoefficient_zero
    (source : RawVorticityFourierSource) :
    generatedVelocityCoefficient source 0 = 0 := by
  simp [generatedVelocityCoefficient]

theorem generatedVelocityCoefficient_waveNeg
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) :
    generatedVelocityCoefficient source (waveNeg wave) =
      vectorConj (generatedVelocityCoefficient source wave) := by
  rw [generatedVelocityCoefficient, generatedVelocityCoefficient,
    generatedVorticityCoefficient_waveNeg,
    biotSavartVelocityCoefficient_waveNeg_vectorConj]

theorem generatedVelocityCoefficient_transverse
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) :
    complexWavevector wave ⬝ᵥ
        generatedVelocityCoefficient source wave = 0 := by
  exact complexWavevector_dot_biotSavartVelocityCoefficient _ _

/-! ## Exact physical curl recovery -/

/--
The source-generated velocity is an exact Biot--Savart inverse of the
source-generated vorticity.  No caller-supplied divergence-free hypothesis is
needed: the transverse law consumed here was generated above.
-/
theorem fourierCurlCoefficient_generatedVelocityCoefficient
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) :
    fourierCurlCoefficient wave
        (generatedVelocityCoefficient source wave) =
      generatedVorticityCoefficient source wave := by
  by_cases waveZero : wave = 0
  · subst wave
    simp [fourierCurlCoefficient]
  · have normSq_ne_zero : integerWaveNormSq wave ≠ 0 :=
      integerWaveNormSq_ne_zero waveZero
    have normSqComplex_ne_zero :
        (integerWaveNormSq wave : ℂ) ≠ 0 := by
      exact_mod_cast normSq_ne_zero
    have twoPiNormSq_ne_zero :
        2 * Real.pi * integerWaveNormSq wave ≠ 0 := by
      positivity
    rw [fourierCurlCoefficient, generatedVelocityCoefficient,
      biotSavartVelocityCoefficient, if_neg waveZero,
      map_smul, cross_cross_eq_smul_sub_smul',
      generatedVorticityCoefficient_transverse,
      complexWavevector_dot_self]
    simp only [zero_smul, zero_sub]
    simp only [smul_smul, ← neg_smul]
    rw [← one_smul ℂ (generatedVorticityCoefficient source wave)]
    congr 1
    push_cast
    field_simp [twoPiNormSq_ne_zero]
    all_goals simp

/-! ## Definition-generated zero control -/

/-- The empty raw source, used as a definition-level negative control. -/
def zeroRawVorticitySource : RawVorticityFourierSource where
  activeModes := ∅
  rawVorticity := 0

@[simp] theorem zeroRawVorticitySource_generatedSupport :
    generatedSupport zeroRawVorticitySource = ∅ := by
  simp [generatedSupport, zeroRawVorticitySource]

@[simp] theorem zeroRawVorticitySource_generatedVorticityCoefficient
    (wave : IntegerWavevector) :
    generatedVorticityCoefficient zeroRawVorticitySource wave = 0 := by
  simp [generatedVorticityCoefficient]

@[simp] theorem zeroRawVorticitySource_generatedVelocityCoefficient
    (wave : IntegerWavevector) :
    generatedVelocityCoefficient zeroRawVorticitySource wave = 0 := by
  simp [generatedVelocityCoefficient]

end

end ThreeDimensionalVorticityCoefficientRawSourceCore
end NavierStokes
end SaturationMonoid
