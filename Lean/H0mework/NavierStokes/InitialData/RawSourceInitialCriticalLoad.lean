import H0mework.NavierStokes.Galerkin.KineticEnergyLedger
import H0mework.NavierStokes.InitialData.FiniteSupportCriticalSobolev

/-!
# Raw-source initial critical load

This module computes the cutoff-independent critical load of the actual
source-generated initial vorticity state:

```text
K₃ Y(0)
  = K₃ * sum_{k in generatedSupport}
      |transverseProjection k (realitySymmetrizedVorticity source k)|².
```

Here `K₃` is the global summable three-dimensional lattice constant and
`Y` is `finiteStateVorticityMass`.  The formula reads only the primitive raw
source; no cutoff, target trajectory, amplitude bound, viscosity relation,
or continuation certificate is a premise.

The primitive source has no native amplitude--viscosity coupling.  A derived
real scaling operation preserves its generated support and scales the exact
critical load quadratically.  Consequently every positive-load source has,
on the same finite support, scaled instances exceeding the viscous
absorption threshold `ν² (2π)²`.  This is an obstruction to automatic
source-generated smallness, not a small-data certificate.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalVorticityCoefficientRawSourceInitialCriticalLoad

open scoped BigOperators Matrix ENNReal

open ThreeDimensionalPeriodicCoarseFilterCore
open ThreeDimensionalPeriodicIntegerCharacterCoarseFilter
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientCoarseFilterProcess
open ThreeDimensionalVorticityCoefficientStretchingPairTable
open ThreeDimensionalVorticityCoefficientFiniteSupportComplexTrajectory
open ThreeDimensionalVorticityCoefficientGeneratedShellSerrinGeometry
open ThreeDimensionalVorticityCoefficientGeneratedShellViscousParseval
open ThreeDimensionalVorticityCoefficientFiniteSupportCriticalSobolev
open ThreeDimensionalVorticityCoefficientFiniteGalerkinKineticEnergyLedger
open ThreeDimensionalIntegerLatticeCriticalKernel

noncomputable section

/-! ## Exact source load -/

/-- The cutoff-independent three-dimensional constant `K₃` appearing in the
critical finite-Galerkin rate. -/
def finiteStateVorticityCriticalKernelConstant : ℝ :=
  biotSavartSerrinConstant *
    ∑' wave : IntegerWavevector, integerWaveCriticalKernel wave

theorem finiteStateVorticityCriticalKernelConstant_nonneg :
    0 ≤ finiteStateVorticityCriticalKernelConstant := by
  exact mul_nonneg biotSavartSerrinConstant_nonneg
    integerWaveCriticalKernel_tsum_nonneg

/-- The actual initial critical load generated by one primitive raw source. -/
def generatedSourceInitialCriticalLoad
    (source : RawVorticityFourierSource) : ℝ :=
  finiteStateVorticityCriticalKernelConstant *
    finiteStateVorticityMass
      (generatedSupport source)
      (generatedComplexVorticityState source
        (generatedSupport source))

/-- The initial unweighted vorticity mass is exactly the finite sum of the
source's reality-symmetrized, transverse-projected raw coefficients. -/
theorem finiteStateVorticityMass_generatedSource_eq_projectedRawSum
    (source : RawVorticityFourierSource) :
    finiteStateVorticityMass
        (generatedSupport source)
        (generatedComplexVorticityState source
          (generatedSupport source)) =
      ∑ wave ∈ generatedSupport source,
        complexCoordinateVectorNormSq
          (transverseProjection wave
            (realitySymmetrizedVorticity source wave)) := by
  unfold finiteStateVorticityMass
  apply Finset.sum_congr rfl
  intro wave waveMem
  rw [generatedComplexVorticityState_apply, if_pos waveMem,
    generatedVorticityCoefficient, if_pos waveMem]

/-- Exact primitive-source formula for `K₃ Y(0)`.  All frequency and
coefficient data on the right are generated from the same raw source. -/
theorem generatedSourceInitialCriticalLoad_eq_projectedRawSum
    (source : RawVorticityFourierSource) :
    generatedSourceInitialCriticalLoad source =
      finiteStateVorticityCriticalKernelConstant *
        ∑ wave ∈ generatedSupport source,
          complexCoordinateVectorNormSq
            (transverseProjection wave
              (realitySymmetrizedVorticity source wave)) := by
  rw [generatedSourceInitialCriticalLoad,
    finiteStateVorticityMass_generatedSource_eq_projectedRawSum]

theorem generatedSourceInitialCriticalLoad_nonneg
    (source : RawVorticityFourierSource) :
    0 ≤ generatedSourceInitialCriticalLoad source := by
  unfold generatedSourceInitialCriticalLoad finiteStateVorticityMass
  exact mul_nonneg finiteStateVorticityCriticalKernelConstant_nonneg <|
    Finset.sum_nonneg fun wave waveMem =>
      complexCoordinateVectorNormSq_nonneg _

@[simp] theorem zeroRawVorticitySource_initialCriticalLoad :
    generatedSourceInitialCriticalLoad zeroRawVorticitySource = 0 := by
  simp [generatedSourceInitialCriticalLoad, finiteStateVorticityMass]

/-! ## Same-support amplitude scaling obstruction -/

/-- Derived real scaling of the primitive raw coefficient table.  This is a
source transformer, not a new amplitude or viscosity field in the source. -/
def realScaleRawVorticitySource
    (scale : ℝ)
    (source : RawVorticityFourierSource) :
    RawVorticityFourierSource where
  activeModes := source.activeModes
  rawVorticity := fun wave =>
    (scale : ℂ) • source.rawVorticity wave

@[simp] theorem realScaleRawVorticitySource_activeModes
    (scale : ℝ)
    (source : RawVorticityFourierSource) :
    (realScaleRawVorticitySource scale source).activeModes =
      source.activeModes :=
  rfl

@[simp] theorem realScaleRawVorticitySource_generatedSupport
    (scale : ℝ)
    (source : RawVorticityFourierSource) :
    generatedSupport (realScaleRawVorticitySource scale source) =
      generatedSupport source :=
  rfl

theorem supportedRawVorticity_realScale
    (scale : ℝ)
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) :
    supportedRawVorticity
        (realScaleRawVorticitySource scale source) wave =
      (scale : ℂ) • supportedRawVorticity source wave := by
  by_cases waveMem : wave ∈ source.activeModes
  · simp [supportedRawVorticity, realScaleRawVorticitySource, waveMem]
  · simp [supportedRawVorticity, realScaleRawVorticitySource, waveMem]

theorem realitySymmetrizedVorticity_realScale
    (scale : ℝ)
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) :
    realitySymmetrizedVorticity
        (realScaleRawVorticitySource scale source) wave =
      (scale : ℂ) • realitySymmetrizedVorticity source wave := by
  funext coordinate
  unfold realitySymmetrizedVorticity
  rw [supportedRawVorticity_realScale,
    supportedRawVorticity_realScale]
  simp only [Pi.smul_apply, smul_eq_mul, map_mul,
    Complex.star_def, Complex.conj_ofReal]
  ring

/-- Source closure, reality symmetrization, and transverse projection all
commute with real amplitude scaling. -/
theorem generatedVorticityCoefficient_realScale
    (scale : ℝ)
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) :
    generatedVorticityCoefficient
        (realScaleRawVorticitySource scale source) wave =
      (scale : ℂ) • generatedVorticityCoefficient source wave := by
  by_cases waveMem : wave ∈ generatedSupport source
  · rw [generatedVorticityCoefficient,
      realScaleRawVorticitySource_generatedSupport,
      if_pos waveMem,
      realitySymmetrizedVorticity_realScale,
      transverseProjection_smul,
      generatedVorticityCoefficient,
      if_pos waveMem]
  · rw [generatedVorticityCoefficient,
      realScaleRawVorticitySource_generatedSupport,
      if_neg waveMem,
      generatedVorticityCoefficient,
      if_neg waveMem,
      smul_zero]

/-- The compiled finite initial state commutes with real source scaling on
every finite coefficient inventory. -/
theorem generatedComplexVorticityState_realScale
    (scale : ℝ)
    (source : RawVorticityFourierSource)
    (modes : Finset IntegerWavevector) :
    generatedComplexVorticityState
        (realScaleRawVorticitySource scale source) modes =
      (scale : ℂ) • generatedComplexVorticityState source modes := by
  apply lp.ext
  rw [lp.coeFn_smul]
  funext wave
  by_cases waveMem : wave ∈ modes
  · simp [waveMem, generatedVorticityCoefficient_realScale]
  · simp [waveMem]

/-- Scaling raw source amplitudes preserves the exact support and multiplies
the actual initial vorticity mass by `scale²`. -/
theorem finiteStateVorticityMass_generatedSource_realScale
    (scale : ℝ)
    (source : RawVorticityFourierSource) :
    finiteStateVorticityMass
        (generatedSupport (realScaleRawVorticitySource scale source))
        (generatedComplexVorticityState
          (realScaleRawVorticitySource scale source)
          (generatedSupport
            (realScaleRawVorticitySource scale source))) =
      scale ^ 2 *
        finiteStateVorticityMass
          (generatedSupport source)
          (generatedComplexVorticityState source
            (generatedSupport source)) := by
  rw [realScaleRawVorticitySource_generatedSupport]
  unfold finiteStateVorticityMass
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro wave waveMem
  rw [generatedComplexVorticityState_apply, if_pos waveMem,
    generatedVorticityCoefficient_realScale,
    generatedComplexVorticityState_apply, if_pos waveMem,
    complexCoordinateVectorNormSq_smul,
    Complex.normSq_ofReal]
  ring

/-- The cutoff-independent source load scales quadratically while its finite
support remains unchanged. -/
theorem generatedSourceInitialCriticalLoad_realScale
    (scale : ℝ)
    (source : RawVorticityFourierSource) :
    generatedSourceInitialCriticalLoad
        (realScaleRawVorticitySource scale source) =
      scale ^ 2 * generatedSourceInitialCriticalLoad source := by
  unfold generatedSourceInitialCriticalLoad
  rw [finiteStateVorticityMass_generatedSource_realScale]
  ring

/-- A positive-load source can cross every viscous absorption threshold by
real amplitude scaling without changing its generated support.

This rules out any automatic amplitude--viscosity smallness law in the
current primitive source mouth.  It does not rule out a later native source
producer that dynamically generates such a relation. -/
theorem exists_realScale_initialCriticalLoad_gt_viscousThreshold
    (source : RawVorticityFourierSource)
    (loadPos : 0 < generatedSourceInitialCriticalLoad source)
    (ν : ℝ) :
    ∃ scale : ℝ,
      generatedSupport (realScaleRawVorticitySource scale source) =
          generatedSupport source ∧
        ν ^ 2 * (2 * Real.pi) ^ 2 <
          generatedSourceInitialCriticalLoad
            (realScaleRawVorticitySource scale source) := by
  let threshold := ν ^ 2 * (2 * Real.pi) ^ 2
  let initialLoad := generatedSourceInitialCriticalLoad source
  have thresholdNonneg : 0 ≤ threshold := by
    exact mul_nonneg (sq_nonneg _) (sq_nonneg _)
  have initialLoadPos : 0 < initialLoad := by
    simpa [initialLoad] using loadPos
  have quotientNonneg :
      0 ≤ (threshold + 1) / initialLoad := by
    exact div_nonneg (by linarith) initialLoadPos.le
  let scale := Real.sqrt ((threshold + 1) / initialLoad)
  refine
    ⟨scale, realScaleRawVorticitySource_generatedSupport scale source,
      ?_⟩
  rw [generatedSourceInitialCriticalLoad_realScale]
  change threshold < scale ^ 2 * initialLoad
  rw [show scale ^ 2 = (threshold + 1) / initialLoad by
    exact Real.sq_sqrt quotientNonneg]
  have quotientMul :
      (threshold + 1) / initialLoad * initialLoad =
        threshold + 1 := by
    field_simp [initialLoadPos.ne']
  rw [quotientMul]
  linarith

end

end ThreeDimensionalVorticityCoefficientRawSourceInitialCriticalLoad
end NavierStokes
end SaturationMonoid
