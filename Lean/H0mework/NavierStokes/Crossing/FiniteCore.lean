noncomputable section

private theorem exists_wholeRestartCrossingFiniteCoreRadius
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    ∃ radius : ℕ,
      (1 / 2 : ℝ) * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 <
        criticalEnstrophyLatticeConstant *
          finiteStateVorticityCoefficientEnstrophy
            (wholeRestartModes radius)
            (run initial index).contact.physicalState := by
  have massTendsto :=
    finiteRestartInventoryMass_tendsto_wholeMass
      (run initial index).contact.physicalState
      (run initial index).contact.physicalState_zero
  have scaledTendsto :
      Tendsto
        (fun radius : ℕ =>
          criticalEnstrophyLatticeConstant *
            finiteStateVorticityCoefficientEnstrophy
              (wholeRestartModes radius)
              (run initial index).contact.physicalState)
        atTop
        (𝓝
          (criticalEnstrophyLatticeConstant *
            wholeVorticityEuclideanMass
              (run initial index).contact.physicalState)) :=
    tendsto_const_nhds.mul massTendsto
  have eventuallyCrossed :
      ∀ᶠ radius : ℕ in atTop,
        (1 / 2 : ℝ) * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 <
          criticalEnstrophyLatticeConstant *
            finiteStateVorticityCoefficientEnstrophy
              (wholeRestartModes radius)
              (run initial index).contact.physicalState :=
    scaledTendsto.eventually
      (eventually_gt_nhds (by
        simpa only [wholeRestartHalfCriticalCrossed] using crossed))
  exact eventuallyCrossed.exists

/-- The first canonical sharp radius whose finite core inherits the actual
whole contact's half-critical crossing. -/
noncomputable def wholeRestartCrossingFiniteCoreRadius
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) : ℕ :=
  Nat.find
    (exists_wholeRestartCrossingFiniteCoreRadius initial index crossed)

/-- The source-generated finite inventory at the crossing contact. -/
noncomputable def wholeRestartCrossingFiniteCoreModes
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    Finset IntegerWavevector :=
  wholeRestartModes
    (wholeRestartCrossingFiniteCoreRadius initial index crossed)

/-- The canonical sharp core of the same actual whole contact. -/
noncomputable def wholeRestartCrossingFiniteCoreState
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    ComplexVorticityHilbertState :=
  wholeRestartInitialState
    (run initial index).contact
    (wholeRestartCrossingFiniteCoreRadius initial index crossed)

/-- The omitted whole-carrier tail, retained before finite-source
recompilation. -/
noncomputable def wholeRestartCrossingFiniteTail
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    ComplexVorticityHilbertState :=
  (run initial index).contact.physicalState -
    wholeRestartCrossingFiniteCoreState initial index crossed

/-- Primitive finite raw data canonically reconstructed from the selected
sharp core.  This source does not own the actual whole physical endpoint. -/
noncomputable def wholeRestartCrossingFiniteRawSource
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    RawVorticityFourierSource :=
  rawSourceOfFiniteVorticityState
    (wholeRestartCrossingFiniteCoreModes initial index crossed)
    (wholeRestartCrossingFiniteCoreState initial index crossed)

theorem wholeRestartCrossingFiniteCoreRadius_crossed
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    (1 / 2 : ℝ) * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 <
      criticalEnstrophyLatticeConstant *
        finiteStateVorticityCoefficientEnstrophy
          (wholeRestartCrossingFiniteCoreModes initial index crossed)
          (run initial index).contact.physicalState := by
  exact Nat.find_spec
    (exists_wholeRestartCrossingFiniteCoreRadius initial index crossed)

/-- Every strictly smaller canonical radius is still below the half-critical
threshold.  This is the source-owned minimality law of the generated core,
not a cutoff assumption supplied by a downstream consumer. -/
theorem wholeRestartCrossingFiniteCoreRadius_minimal
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index)
    {radius : ℕ}
    (radiusLt :
      radius <
        wholeRestartCrossingFiniteCoreRadius initial index crossed) :
    criticalEnstrophyLatticeConstant *
          finiteStateVorticityCoefficientEnstrophy
            (wholeRestartModes radius)
            (run initial index).contact.physicalState ≤
      (1 / 2 : ℝ) * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 := by
  apply not_lt.mp
  intro radiusCrossed
  have selectedLe :
      wholeRestartCrossingFiniteCoreRadius initial index crossed ≤ radius := by
    exact Nat.find_min'
      (exists_wholeRestartCrossingFiniteCoreRadius initial index crossed)
      radiusCrossed
  exact (Nat.not_lt_of_ge selectedLe) radiusLt

/-- The finite core is literally the sharp projection of the actual crossing
contact on the internally generated inventory. -/
theorem wholeRestartCrossingFiniteCoreState_eq_sharpSupportProjection
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    wholeRestartCrossingFiniteCoreState initial index crossed =
      complexSharpSupportProjection
        (wholeRestartCrossingFiniteCoreModes initial index crossed)
        (run initial index).contact.physicalState := by
  rfl

/-- The original whole state is exactly its generated core plus its retained
tail. -/
theorem wholeRestartCrossingPhysicalState_eq_core_add_tail
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    (run initial index).contact.physicalState =
      wholeRestartCrossingFiniteCoreState initial index crossed +
        wholeRestartCrossingFiniteTail initial index crossed := by
  unfold wholeRestartCrossingFiniteTail
  abel

private theorem wholeVorticityEuclideanMass_sub_comm
    (left right : ComplexVorticityHilbertState) :
    wholeVorticityEuclideanMass (left - right) =
      wholeVorticityEuclideanMass (right - left) := by
  unfold wholeVorticityEuclideanMass
  apply tsum_congr
  intro wave
  have amplitudeEq :
      vorticityRowAmplitude (left - right) wave =
        vorticityRowAmplitude (right - left) wave := by
    unfold vorticityRowAmplitude
    congr 1
    unfold complexCoordinateAmplitudeSq
    apply Finset.sum_congr rfl
    intro coordinate _coordinateMem
    have coordinateEq :
        (left wave coordinate - right wave coordinate) =
          -(right wave coordinate - left wave coordinate) := by
      ring
    change
      Complex.normSq (left wave coordinate - right wave coordinate) =
        Complex.normSq (right wave coordinate - left wave coordinate)
    rw [coordinateEq, Complex.normSq_neg]
  rw [amplitudeEq]

/-- The selected core and its actual omitted tail form an exact Euclidean
mass partition on the whole carrier. -/
theorem wholeRestartCrossingPhysicalMass_eq_core_add_tail
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    wholeVorticityEuclideanMass
        (run initial index).contact.physicalState =
      wholeVorticityEuclideanMass
          (wholeRestartCrossingFiniteCoreState initial index crossed) +
        wholeVorticityEuclideanMass
          (wholeRestartCrossingFiniteTail initial index crossed) := by
  have partition :=
    wholeVorticityEuclideanMass_eq_projection_add_complement
      (wholeRestartCrossingFiniteCoreModes initial index crossed)
      (run initial index).contact.physicalState
  rw [wholeRestartCrossingFiniteCoreState_eq_sharpSupportProjection]
  rw [wholeVorticityEuclideanMass_sub_comm] at partition
  exact partition

/-- The internally selected finite core itself has crossed the same fixed
half-critical threshold. -/
theorem wholeRestartCrossingFiniteCoreState_halfCriticalCrossed
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    (1 / 2 : ℝ) * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 <
      criticalEnstrophyLatticeConstant *
        wholeVorticityEuclideanMass
          (wholeRestartCrossingFiniteCoreState initial index crossed) := by
  have coreCrossed :=
    wholeRestartCrossingFiniteCoreRadius_crossed initial index crossed
  rw [finiteStateVorticityCoefficientEnstrophy_eq_projectionMass] at coreCrossed
  exact coreCrossed

/-- Primitive support closure recovers exactly the internally selected
canonical inventory. -/
theorem wholeRestartCrossingFiniteRawSource_generatedSupport
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    generatedSupport
        (wholeRestartCrossingFiniteRawSource initial index crossed) =
      wholeRestartCrossingFiniteCoreModes initial index crossed := by
  exact rawSourceOfFiniteVorticityState_generatedSupport
    (wholeRestartCrossingFiniteCoreModes initial index crossed)
    (zero_not_mem_puncturedIntegerWaveFrequencyCube
      (wholeRestartCrossingFiniteCoreRadius initial index crossed))
    (fun _wave waveMem =>
      puncturedIntegerWaveFrequencyCube_waveNeg_mem
        (wholeRestartCrossingFiniteCoreRadius initial index crossed)
        waveMem)
    (wholeRestartCrossingFiniteCoreState initial index crossed)

/-- The complete primitive finite-source compiler reconstructs the sharp
core exactly; it does not manufacture or replace the actual whole endpoint. -/
theorem generatedComplexVorticityState_crossingFiniteRawSource
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    generatedComplexVorticityState
        (wholeRestartCrossingFiniteRawSource initial index crossed)
        (generatedSupport
          (wholeRestartCrossingFiniteRawSource initial index crossed)) =
      wholeRestartCrossingFiniteCoreState initial index crossed := by
  exact generatedComplexVorticityState_rawSourceOfFinitePhysicalState
    (wholeRestartCrossingFiniteCoreModes initial index crossed)
    (zero_not_mem_puncturedIntegerWaveFrequencyCube
      (wholeRestartCrossingFiniteCoreRadius initial index crossed))
    (fun _wave waveMem =>
      puncturedIntegerWaveFrequencyCube_waveNeg_mem
        (wholeRestartCrossingFiniteCoreRadius initial index crossed)
        waveMem)
    (wholeRestartCrossingFiniteCoreState initial index crossed)
    (wholeRestartInitialState_supported
      (run initial index).contact
      (wholeRestartCrossingFiniteCoreRadius initial index crossed))
    (wholeRestartInitialState_transverse
      (run initial index).contact
      (wholeRestartCrossingFiniteCoreRadius initial index crossed))
    (wholeRestartInitialState_reality
      (run initial index).contact
      (wholeRestartCrossingFiniteCoreRadius initial index crossed))

/-- Before quotienting to the finite raw core, every infinite nonlinear
output row retains the exact whole/core gluing responsibility. -/
theorem wholeRestartCrossingNonlinearCoefficient_sub_core
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index)
    (output : IntegerWavevector) :
    wholeStateVorticityNonlinearCoefficientAt
          (run initial index).contact.physicalState output -
        wholeStateVorticityNonlinearCoefficientAt
          (wholeRestartCrossingFiniteCoreState initial index crossed) output =
      wholeStateVorticityBilinearCoefficientAt
          (wholeRestartCrossingFiniteTail initial index crossed)
          (run initial index).contact.physicalState output +
        wholeStateVorticityBilinearCoefficientAt
          (wholeRestartCrossingFiniteCoreState initial index crossed)
          (wholeRestartCrossingFiniteTail initial index crossed) output := by
  exact wholeStateVorticityNonlinearCoefficientAt_sub
    (run initial index).contact.physicalState
    (wholeRestartCrossingFiniteCoreState initial index crossed)
    (run initial index).contact.transverse
    (wholeStateTransverse_sharpSupportProjection
      (wholeRestartCrossingFiniteCoreModes initial index crossed)
      (run initial index).contact.physicalState
      (run initial index).contact.transverse)
    output

end

end
  ThreeDimensionalVorticityCoefficientGeneratedWholeRestartCrossingFiniteCore
