/-! ## Same-receipt gluing variation -/

/-- The forced pointwise pair trace is exactly the variation of the tagged
complete outgoing gluing occurrence from its actual written terminal value.
The primitive source-self occurrence cancels because it is the same generated
baseline at both reads. -/
theorem wholeRestartPairOccurrenceTrace_eq_completeOutgoingGluing_sub_terminal
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index)
    (output first : IntegerWavevector)
    (time : Icc (0 : ℝ) (run initial index).nextContact.time.1) :
    wholeRestartPairOccurrenceTrace initial index output first time =
      wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
          initial index crossed output first time -
        wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
          initial index crossed output first
            ⟨(run initial index).nextContact.time.1,
              ⟨(run initial index).nextContact.time_pos.le, le_rfl⟩⟩ := by
  have timeSplit :=
    actualWholeContinuousPairVector_eq_crossingSourceSelf_add_completeGluing
      initial index crossed output first time
  have terminalSplit :=
    actualWholeContinuousPairVector_eq_crossingSourceSelf_add_completeGluing
      initial index crossed output first
        ⟨(run initial index).nextContact.time.1,
          ⟨(run initial index).nextContact.time_pos.le, le_rfl⟩⟩
  have terminalRead :=
    actualWholeContinuousPairVector_terminal_eq_next
      initial index output first
  have nextDecomposition :
      wholeRestartNextPairOccurrence initial index output first =
        wholeRestartCrossingFiniteComponentSelfPairOccurrence
            initial index crossed output first +
          wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
            initial index crossed output first
              ⟨(run initial index).nextContact.time.1,
                ⟨(run initial index).nextContact.time_pos.le, le_rfl⟩⟩ :=
    terminalRead.symm.trans terminalSplit
  unfold wholeRestartPairOccurrenceTrace
  rw [timeSplit, nextDecomposition]
  abel

/-- Causal heat transport preserves the same tagged gluing variation.  This
is the concrete downstream identity missing from the earlier causal-trace
readout: the trace is neither an unnamed path memory nor the contact-time
output aggregate. -/
theorem wholeRestartPairDuhamelCausalTrace_eq_completeOutgoingGluingVariation
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index)
    (output first : IntegerWavevector) :
    wholeRestartPairDuhamelCausalTrace initial index output first =
      ∫ earlier in Iic
          (⟨(run initial index).nextContact.time.1,
            ⟨(run initial index).nextContact.time_pos.le, le_rfl⟩⟩ :
            Icc (0 : ℝ) (run initial index).nextContact.time.1),
        finiteStateVorticityHeatMultiplier
            ν.coeff
            ((run initial index).nextContact.time.1 - earlier.1)
            output •
          (wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
              initial index crossed output first earlier -
            wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
              initial index crossed output first
                ⟨(run initial index).nextContact.time.1,
                  ⟨(run initial index).nextContact.time_pos.le, le_rfl⟩⟩)
        ∂(commonTimeMeasure (run initial index).nextContact.time.1) := by
  unfold wholeRestartPairDuhamelCausalTrace
  apply integral_congr_ae
  filter_upwards with earlier
  rw [wholeRestartPairOccurrenceTrace_eq_completeOutgoingGluing_sub_terminal
    initial index crossed output first earlier]

/-! ## Cross-round source/gluing cocycle -/

/-- Change of the primitive source-self presentation across one actual whole
restart.  Both presentations are generated internally by adjacent crossing
contacts of the same `run`. -/
def wholeRestartCrossingSourceSelfPairUpdate
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index)
    (nextCrossed : wholeRestartHalfCriticalCrossed initial (index + 1))
    (output first : IntegerWavevector) : ComplexCoordinateVector :=
  wholeRestartCrossingFiniteComponentSelfPairOccurrence
      initial (index + 1) nextCrossed output first -
    wholeRestartCrossingFiniteComponentSelfPairOccurrence
      initial index crossed output first

/-- The terminal tagged gluing occurrence is written through the actual whole
restart as the adjacent source-presentation trace plus the next crossing's
initial gluing keep. -/
theorem wholeRestartCrossingCompleteOutgoingPairGluing_terminal_cocycle
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index)
    (nextCrossed : wholeRestartHalfCriticalCrossed initial (index + 1))
    (output first : IntegerWavevector) :
    wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
        initial index crossed output first
          ⟨(run initial index).nextContact.time.1,
            ⟨(run initial index).nextContact.time_pos.le, le_rfl⟩⟩ =
      wholeRestartCrossingSourceSelfPairUpdate
          initial index crossed nextCrossed output first +
        wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
          initial (index + 1) nextCrossed output first
            ⟨0, ⟨le_rfl,
              (run initial (index + 1)).nextContact.time_pos.le⟩⟩ := by
  have terminalSplit :=
    actualWholeContinuousPairVector_eq_crossingSourceSelf_add_completeGluing
      initial index crossed output first
        ⟨(run initial index).nextContact.time.1,
          ⟨(run initial index).nextContact.time_pos.le, le_rfl⟩⟩
  have terminalRead :=
    actualWholeContinuousPairVector_terminal_eq_next
      initial index output first
  have nextZeroSplit :=
    actualWholeContinuousPairVector_eq_crossingSourceSelf_add_completeGluing
      initial (index + 1) nextCrossed output first
        ⟨0, ⟨le_rfl,
          (run initial (index + 1)).nextContact.time_pos.le⟩⟩
  have nextZeroRead :=
    actualWholeContinuousPairVector_zero_eq_contact
      initial (index + 1) output first
  have nextPairRead :=
    wholeRestartNextPairOccurrence_eq_contact_succ
      initial index output first
  have nextDecomposition :
      wholeRestartNextPairOccurrence initial index output first =
        wholeRestartCrossingFiniteComponentSelfPairOccurrence
            initial (index + 1) nextCrossed output first +
          wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
            initial (index + 1) nextCrossed output first
              ⟨0, ⟨le_rfl,
                (run initial (index + 1)).nextContact.time_pos.le⟩⟩ := by
    calc
      wholeRestartNextPairOccurrence initial index output first =
          wholeRestartContactPairOccurrenceTable
            initial (index + 1) output first := nextPairRead
      _ = actualWholeContinuousPairVector
            (run initial (index + 1)).nextContact.prefixReceipt
            output first
              ⟨0, ⟨le_rfl,
                (run initial (index + 1)).nextContact.time_pos.le⟩⟩ :=
        nextZeroRead.symm
      _ =
          wholeRestartCrossingFiniteComponentSelfPairOccurrence
              initial (index + 1) nextCrossed output first +
            wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
              initial (index + 1) nextCrossed output first
                ⟨0, ⟨le_rfl,
                  (run initial (index + 1)).nextContact.time_pos.le⟩⟩ :=
        nextZeroSplit
  rw [terminalRead] at terminalSplit
  rw [nextDecomposition] at terminalSplit
  unfold wholeRestartCrossingSourceSelfPairUpdate
  calc
    wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
          initial index crossed output first
            ⟨(run initial index).nextContact.time.1,
              ⟨(run initial index).nextContact.time_pos.le, le_rfl⟩⟩ =
        (wholeRestartCrossingFiniteComponentSelfPairOccurrence
              initial index crossed output first +
            wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
              initial index crossed output first
                ⟨(run initial index).nextContact.time.1,
                  ⟨(run initial index).nextContact.time_pos.le, le_rfl⟩⟩) -
          wholeRestartCrossingFiniteComponentSelfPairOccurrence
            initial index crossed output first := by abel
    _ =
        (wholeRestartCrossingFiniteComponentSelfPairOccurrence
              initial (index + 1) nextCrossed output first +
            wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
              initial (index + 1) nextCrossed output first
                ⟨0, ⟨le_rfl,
                  (run initial (index + 1)).nextContact.time_pos.le⟩⟩) -
          wholeRestartCrossingFiniteComponentSelfPairOccurrence
            initial index crossed output first := by rw [terminalSplit]
    _ =
        (wholeRestartCrossingFiniteComponentSelfPairOccurrence
              initial (index + 1) nextCrossed output first -
            wholeRestartCrossingFiniteComponentSelfPairOccurrence
              initial index crossed output first) +
          wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
            initial (index + 1) nextCrossed output first
              ⟨0, ⟨le_rfl,
                (run initial (index + 1)).nextContact.time_pos.le⟩⟩ := by
      abel

/-- At every time slice, the current tagged gluing occurrence has exactly
three generated destinations: same-receipt variation trace, adjacent source
presentation trace, and next-crossing initial gluing keep. -/
theorem wholeRestartCrossingCompleteOutgoingPairGluing_native_cocycle
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index)
    (nextCrossed : wholeRestartHalfCriticalCrossed initial (index + 1))
    (output first : IntegerWavevector)
    (time : Icc (0 : ℝ) (run initial index).nextContact.time.1) :
    wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
        initial index crossed output first time =
      wholeRestartPairOccurrenceTrace initial index output first time +
        wholeRestartCrossingSourceSelfPairUpdate
          initial index crossed nextCrossed output first +
        wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
          initial (index + 1) nextCrossed output first
            ⟨0, ⟨le_rfl,
              (run initial (index + 1)).nextContact.time_pos.le⟩⟩ := by
  rw [wholeRestartPairOccurrenceTrace_eq_completeOutgoingGluing_sub_terminal
    initial index crossed output first time]
  rw [wholeRestartCrossingCompleteOutgoingPairGluing_terminal_cocycle
    initial index crossed nextCrossed output first]
  abel

/-- Componentwise no-silent redirect for one nonzero tagged gluing
occurrence.  Positivity or a uniform component size is unnecessary. -/
theorem wholeRestartCrossingCompleteOutgoingPairGluing_ne_zero_redirect
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index)
    (nextCrossed : wholeRestartHalfCriticalCrossed initial (index + 1))
    (output first : IntegerWavevector)
    (time : Icc (0 : ℝ) (run initial index).nextContact.time.1)
    (gluingNonzero :
      wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
        initial index crossed output first time ≠ 0) :
    wholeRestartPairOccurrenceTrace initial index output first time ≠ 0 ∨
      wholeRestartCrossingSourceSelfPairUpdate
          initial index crossed nextCrossed output first ≠ 0 ∨
        wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
          initial (index + 1) nextCrossed output first
            ⟨0, ⟨le_rfl,
              (run initial (index + 1)).nextContact.time_pos.le⟩⟩ ≠ 0 := by
  by_cases traceNonzero :
      wholeRestartPairOccurrenceTrace initial index output first time ≠ 0
  · exact Or.inl traceNonzero
  right
  by_cases sourceUpdateNonzero :
      wholeRestartCrossingSourceSelfPairUpdate
        initial index crossed nextCrossed output first ≠ 0
  · exact Or.inl sourceUpdateNonzero
  · right
    intro nextGluingZero
    apply gluingNonzero
    rw [wholeRestartCrossingCompleteOutgoingPairGluing_native_cocycle
      initial index crossed nextCrossed output first time,
      not_ne_iff.mp traceNonzero,
      not_ne_iff.mp sourceUpdateNonzero,
      nextGluingZero]
    simp

/-- Positive complete-gluing square mass exposes a concrete tagged
occurrence on the same receipt and immediately redirects it through the
native three-term cocycle.  The time, pair coordinate, and adjacent crossing
are generated internally. -/
theorem
    wholeRestartCrossingCompleteOutgoingGluingVisibleSquareRow_pos_nativeRedirect
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index)
    (output : IntegerWavevector)
    (gluingPositive :
      0 <
        wholeRestartCrossingCompleteOutgoingGluingVisibleSquareRow
          initial index crossed output) :
    ∃ time : Icc (0 : ℝ) (run initial index).nextContact.time.1,
      ∃ first : IntegerWavevector,
        wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
            initial index crossed output first time ≠ 0 ∧
          (wholeRestartPairOccurrenceTrace
              initial index output first time ≠ 0 ∨
            wholeRestartCrossingSourceSelfPairUpdate
                initial index crossed
                  (elapsedTime_bddAbove_forces_every_halfCriticalCrossing
                    initial elapsedBounded (index + 1))
                output first ≠ 0 ∨
              wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
                initial (index + 1)
                  (elapsedTime_bddAbove_forces_every_halfCriticalCrossing
                    initial elapsedBounded (index + 1))
                output first
                  ⟨0, ⟨le_rfl,
                    (run initial
                      (index + 1)).nextContact.time_pos.le⟩⟩ ≠ 0) := by
  have existsAggregate :
      ∃ time : Icc (0 : ℝ) (run initial index).nextContact.time.1,
        wholeRestartCrossingCompleteOutgoingPairGluingAggregate
          initial index crossed output time ≠ 0 := by
    by_contra noAggregate
    push Not at noAggregate
    have rowZero :
        wholeRestartCrossingCompleteOutgoingGluingVisibleSquareRow
            initial index crossed output = 0 := by
      unfold
        wholeRestartCrossingCompleteOutgoingGluingVisibleSquareRow
      simp [noAggregate]
    exact (ne_of_gt gluingPositive) rowZero
  obtain ⟨time, aggregateNonzero⟩ := existsAggregate
  have existsFirst :
      ∃ first : IntegerWavevector,
        wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
          initial index crossed output first time ≠ 0 := by
    by_contra noFirst
    push Not at noFirst
    apply aggregateNonzero
    unfold wholeRestartCrossingCompleteOutgoingPairGluingAggregate
    simp [noFirst]
  obtain ⟨first, occurrenceNonzero⟩ := existsFirst
  let nextCrossed :=
    elapsedTime_bddAbove_forces_every_halfCriticalCrossing
      initial elapsedBounded (index + 1)
  exact
    ⟨time, first, occurrenceNonzero,
      wholeRestartCrossingCompleteOutgoingPairGluing_ne_zero_redirect
        initial index crossed nextCrossed output first time
        occurrenceNonzero⟩

/-! ## Componentwise kernel redirect under finite-time accumulation -/

/-- If a tagged gluing table lies in the scalar aggregation kernel, two
distinct nonzero components are retained and each is redirected through the
actual whole write.  Finite accumulated time generates both adjacent crossing
witnesses internally; they are not source premises. -/
theorem elapsedTime_bddAbove_crossingCompleteOutgoingPairKernel_nativeRedirect
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ)
    (output : IntegerWavevector)
    (time : Icc (0 : ℝ) (run initial index).nextContact.time.1)
    (tableNonzero :
      (fun first : IntegerWavevector =>
        wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
          initial index
            (elapsedTime_bddAbove_forces_every_halfCriticalCrossing
              initial elapsedBounded index)
            output first time) ≠ 0)
    (aggregateZero :
      (∑' first : IntegerWavevector,
        wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
          initial index
            (elapsedTime_bddAbove_forces_every_halfCriticalCrossing
              initial elapsedBounded index)
            output first time) = 0) :
    ∃ first second : IntegerWavevector,
      first ≠ second ∧
        wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
            initial index
              (elapsedTime_bddAbove_forces_every_halfCriticalCrossing
                initial elapsedBounded index)
              output first time ≠ 0 ∧
        wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
            initial index
              (elapsedTime_bddAbove_forces_every_halfCriticalCrossing
                initial elapsedBounded index)
              output second time ≠ 0 ∧
        ((∑' other : IntegerWavevector,
            if other = first then 0 else
              wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
                initial index
                  (elapsedTime_bddAbove_forces_every_halfCriticalCrossing
                    initial elapsedBounded index)
                  output other time) =
          -wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
            initial index
              (elapsedTime_bddAbove_forces_every_halfCriticalCrossing
                initial elapsedBounded index)
              output first time) ∧
        (wholeRestartPairOccurrenceTrace
              initial index output first time ≠ 0 ∨
          wholeRestartCrossingSourceSelfPairUpdate
              initial index
                (elapsedTime_bddAbove_forces_every_halfCriticalCrossing
                  initial elapsedBounded index)
                (elapsedTime_bddAbove_forces_every_halfCriticalCrossing
                  initial elapsedBounded (index + 1))
                output first ≠ 0 ∨
            wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
              initial (index + 1)
                (elapsedTime_bddAbove_forces_every_halfCriticalCrossing
                  initial elapsedBounded (index + 1))
                output first
                  ⟨0, ⟨le_rfl,
                    (run initial (index + 1)).nextContact.time_pos.le⟩⟩ ≠ 0) ∧
        (wholeRestartPairOccurrenceTrace
              initial index output second time ≠ 0 ∨
          wholeRestartCrossingSourceSelfPairUpdate
              initial index
                (elapsedTime_bddAbove_forces_every_halfCriticalCrossing
                  initial elapsedBounded index)
                (elapsedTime_bddAbove_forces_every_halfCriticalCrossing
                  initial elapsedBounded (index + 1))
                output second ≠ 0 ∨
            wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
              initial (index + 1)
                (elapsedTime_bddAbove_forces_every_halfCriticalCrossing
                  initial elapsedBounded (index + 1))
                output second
                  ⟨0, ⟨le_rfl,
                    (run initial (index + 1)).nextContact.time_pos.le⟩⟩ ≠ 0) := by
  let crossed :=
    elapsedTime_bddAbove_forces_every_halfCriticalCrossing
      initial elapsedBounded index
  let nextCrossed :=
    elapsedTime_bddAbove_forces_every_halfCriticalCrossing
      initial elapsedBounded (index + 1)
  let table : IntegerWavevector → ComplexCoordinateVector :=
    fun first =>
      wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
        initial index crossed output first time
  have tableSummable : Summable table :=
    summable_wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
      initial index crossed output time
  have existsFirst : ∃ first, table first ≠ 0 := by
    by_contra allZero
    push Not at allZero
    apply tableNonzero
    funext first
    exact allZero first
  obtain ⟨first, firstNonzero⟩ := existsFirst
  have aggregateSplit :
      (∑' other : IntegerWavevector, table other) =
        table first +
          ∑' other : IntegerWavevector,
            if other = first then 0 else table other :=
    tableSummable.tsum_eq_add_tsum_ite first
  have complementEq :
      (∑' other : IntegerWavevector,
        if other = first then 0 else table other) = -table first := by
    rw [aggregateZero] at aggregateSplit
    exact eq_neg_of_add_eq_zero_right aggregateSplit.symm
  have complementNonzero :
      (∑' other : IntegerWavevector,
        if other = first then 0 else table other) ≠ 0 := by
    rw [complementEq]
    exact neg_ne_zero.mpr firstNonzero
  have existsSecond :
      ∃ second : IntegerWavevector,
        second ≠ first ∧ table second ≠ 0 := by
    by_contra noSecond
    push Not at noSecond
    apply complementNonzero
    have complementFunctionZero :
        (fun second : IntegerWavevector =>
          if second = first then 0 else table second) = 0 := by
      funext second
      split_ifs with secondEq
      · rfl
      · exact noSecond second secondEq
    rw [complementFunctionZero]
    exact tsum_zero
  obtain ⟨second, secondNeFirst, secondNonzero⟩ := existsSecond
  refine ⟨first, second, secondNeFirst.symm,
    firstNonzero, secondNonzero, complementEq, ?_, ?_⟩
  · exact
      wholeRestartCrossingCompleteOutgoingPairGluing_ne_zero_redirect
        initial index crossed nextCrossed output first time firstNonzero
  · exact
      wholeRestartCrossingCompleteOutgoingPairGluing_ne_zero_redirect
        initial index crossed nextCrossed output second time secondNonzero

end

