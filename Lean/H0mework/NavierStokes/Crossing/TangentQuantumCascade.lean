open
  ThreeDimensionalVorticityCoefficientGeneratedWholeRestartCumulativeCriticalDissipation
open
  ThreeDimensionalVorticityCoefficientGeneratedWholeRestartFinitePrefixDualSquareLedger
open
  ThreeDimensionalVorticityCoefficientGeneratedWholeRestartPositiveOutputWorkDualBudget
open
  ThreeDimensionalVorticityCoefficientGeneratedWholeRestartCrossingTangentPaymentCascade
open
  ThreeDimensionalVorticityCoefficientGeneratedWholeRestartCrossingTangentCoercivity
open
  ThreeDimensionalVorticityCoefficientGeneratedWholeRestartCrossingTangentQuantumPayment
open
  ThreeDimensionalVorticityCoefficientGeneratedWholeRestartCrossingTangentCanonicalPersistence

noncomputable section

/-! ## One source-owned quantitative crossing receipt -/

/-- Complete finite carrier and physical-time payment generated by one
actual half-critical crossing. -/
structure WholeRestartCrossingTangentQuantumReceipt
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) where
  modes : Finset NonzeroIntegerWavevector
  localTime : ℝ
  density_zero_gt :
    wholeRestartCrossingTangentCoerciveQuantum ν <
      wholeRestartCrossingFiniteUnforcedTangentEuclideanDensity
        initial index modes 0
  localTime_pos : 0 < localTime
  localTime_lt : localTime < (run initial index).nextContact.time.1
  amplitude_time_le :
    localTime * (wholeRestartCrossingTangentCoerciveQuantum ν / 2) ≤
      ∫ time in (0 : ℝ)..localTime,
        wholeRestartCrossingFiniteUnforcedTangentEuclideanDensity
          initial index modes time
  payment_pos :
    0 <
      ∫ time in (0 : ℝ)..localTime,
        wholeRestartCrossingFiniteUnforcedTangentEuclideanDensity
          initial index modes time
  payment_le_whole_tangent :
    (∫ time in (0 : ℝ)..localTime,
        wholeRestartCrossingFiniteUnforcedTangentEuclideanDensity
          initial index modes time) ≤
      3 * ‖(run initial index).nextContact.prefixReceipt.wholeTangent‖ ^ 2

/-- The crossing itself generates its complete quantitative receipt. -/
noncomputable def wholeRestartCrossingTangentQuantumReceiptOfCrossed
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    WholeRestartCrossingTangentQuantumReceipt initial index where
  modes := wholeRestartCrossingTangentCanonicalModes initial index crossed
  localTime :=
    wholeRestartCrossingTangentCanonicalPersistenceTime
      initial index crossed
  density_zero_gt :=
    wholeRestartCrossingTangentCanonicalModes_density_zero_gt
      initial index crossed
  localTime_pos :=
    wholeRestartCrossingTangentCanonicalPersistenceTime_pos
      initial index crossed
  localTime_lt :=
    wholeRestartCrossingTangentCanonicalPersistenceTime_lt
      initial index crossed
  amplitude_time_le :=
    wholeRestartCrossingTangentCanonicalPersistence_amplitudeTime_le
      initial index crossed
  payment_pos :=
    wholeRestartCrossingTangentCanonicalPersistence_payment_pos
      initial index crossed
  payment_le_whole_tangent :=
    wholeRestartCrossingTangentCanonicalPersistence_payment_le
      initial index crossed

/-- Total source output: a crossing produces `some receipt`; the faithful
noncrossing branch produces no crossing receipt. -/
noncomputable def wholeRestartCrossingTangentQuantumReceipt?
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    Option (WholeRestartCrossingTangentQuantumReceipt initial index) := by
  classical
  exact if crossed : wholeRestartHalfCriticalCrossed initial index then
    some
      (wholeRestartCrossingTangentQuantumReceiptOfCrossed
        initial index crossed)
  else
    none

theorem wholeRestartCrossingTangentQuantumReceipt?_eq_some_of_crossed
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    wholeRestartCrossingTangentQuantumReceipt? initial index =
      some
        (wholeRestartCrossingTangentQuantumReceiptOfCrossed
          initial index crossed) := by
  simp [wholeRestartCrossingTangentQuantumReceipt?, crossed]

theorem wholeRestartCrossingTangentQuantumReceipt?_eq_none_of_not_crossed
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (notCrossed : ¬ wholeRestartHalfCriticalCrossed initial index) :
    wholeRestartCrossingTangentQuantumReceipt? initial index = none := by
  simp [wholeRestartCrossingTangentQuantumReceipt?, notCrossed]

/-- Source-owned physical lifetime of the finite quantum carrier. -/
noncomputable def wholeRestartCrossingTangentQuantumTime
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) : ℝ :=
  match wholeRestartCrossingTangentQuantumReceipt? initial index with
  | some receipt => receipt.localTime
  | none => 0

/-- Complete finite-carrier payment on the source-owned local window. -/
noncomputable def wholeRestartCrossingTangentQuantumPayment
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) : ℝ :=
  match wholeRestartCrossingTangentQuantumReceipt? initial index with
  | some receipt =>
      ∫ time in (0 : ℝ)..receipt.localTime,
        wholeRestartCrossingFiniteUnforcedTangentEuclideanDensity
          initial index receipt.modes time
  | none => 0

theorem wholeRestartCrossingTangentQuantumTime_of_crossed
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    wholeRestartCrossingTangentQuantumTime initial index =
      (wholeRestartCrossingTangentQuantumReceiptOfCrossed
        initial index crossed).localTime := by
  rw [wholeRestartCrossingTangentQuantumTime,
    wholeRestartCrossingTangentQuantumReceipt?_eq_some_of_crossed
      initial index crossed]

theorem wholeRestartCrossingTangentQuantumPayment_of_crossed
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    wholeRestartCrossingTangentQuantumPayment initial index =
      ∫ time in (0 : ℝ)..
          (wholeRestartCrossingTangentQuantumReceiptOfCrossed
            initial index crossed).localTime,
        wholeRestartCrossingFiniteUnforcedTangentEuclideanDensity
          initial index
          (wholeRestartCrossingTangentQuantumReceiptOfCrossed
            initial index crossed).modes time := by
  rw [wholeRestartCrossingTangentQuantumPayment,
    wholeRestartCrossingTangentQuantumReceipt?_eq_some_of_crossed
      initial index crossed]

theorem wholeRestartCrossingTangentQuantumTime_of_not_crossed
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (notCrossed : ¬ wholeRestartHalfCriticalCrossed initial index) :
    wholeRestartCrossingTangentQuantumTime initial index = 0 := by
  rw [wholeRestartCrossingTangentQuantumTime,
    wholeRestartCrossingTangentQuantumReceipt?_eq_none_of_not_crossed
      initial index notCrossed]

theorem wholeRestartCrossingTangentQuantumPayment_of_not_crossed
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (notCrossed : ¬ wholeRestartHalfCriticalCrossed initial index) :
    wholeRestartCrossingTangentQuantumPayment initial index = 0 := by
  rw [wholeRestartCrossingTangentQuantumPayment,
    wholeRestartCrossingTangentQuantumReceipt?_eq_none_of_not_crossed
      initial index notCrossed]

/-! ## Pointwise amplitude--time laws -/

theorem wholeRestartCrossingTangentQuantumTime_nonneg
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    0 ≤ wholeRestartCrossingTangentQuantumTime initial index := by
  by_cases crossed : wholeRestartHalfCriticalCrossed initial index
  · rw [wholeRestartCrossingTangentQuantumTime_of_crossed
      initial index crossed]
    exact
      (wholeRestartCrossingTangentQuantumReceiptOfCrossed
        initial index crossed).localTime_pos.le
  · rw [wholeRestartCrossingTangentQuantumTime_of_not_crossed
      initial index crossed]

theorem wholeRestartCrossingTangentQuantumTime_pos_of_crossed
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    0 < wholeRestartCrossingTangentQuantumTime initial index := by
  rw [wholeRestartCrossingTangentQuantumTime_of_crossed
    initial index crossed]
  exact
    (wholeRestartCrossingTangentQuantumReceiptOfCrossed
      initial index crossed).localTime_pos

theorem wholeRestartCrossingTangentQuantumTime_lt_nextContact
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    wholeRestartCrossingTangentQuantumTime initial index <
      (run initial index).nextContact.time.1 := by
  by_cases crossed : wholeRestartHalfCriticalCrossed initial index
  · rw [wholeRestartCrossingTangentQuantumTime_of_crossed
      initial index crossed]
    exact
      (wholeRestartCrossingTangentQuantumReceiptOfCrossed
        initial index crossed).localTime_lt
  · rw [wholeRestartCrossingTangentQuantumTime_of_not_crossed
      initial index crossed]
    exact (run initial index).nextContact.time_pos

theorem wholeRestartCrossingTangentQuantumPayment_nonneg
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    0 ≤ wholeRestartCrossingTangentQuantumPayment initial index := by
  by_cases crossed : wholeRestartHalfCriticalCrossed initial index
  · rw [wholeRestartCrossingTangentQuantumPayment_of_crossed
      initial index crossed]
    exact
      (wholeRestartCrossingTangentQuantumReceiptOfCrossed
        initial index crossed).payment_pos.le
  · rw [wholeRestartCrossingTangentQuantumPayment_of_not_crossed
      initial index crossed]

/-- Fixed amplitude times the generated physical lifetime is paid by the
same finite carrier. -/
theorem wholeRestartCrossingTangentQuantum_amplitudeTime_le_payment
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    wholeRestartCrossingTangentQuantumTime initial index *
          (wholeRestartCrossingTangentCoerciveQuantum ν / 2) ≤
      wholeRestartCrossingTangentQuantumPayment initial index := by
  by_cases crossed : wholeRestartHalfCriticalCrossed initial index
  · rw [wholeRestartCrossingTangentQuantumTime_of_crossed
      initial index crossed,
      wholeRestartCrossingTangentQuantumPayment_of_crossed
        initial index crossed]
    exact
      (wholeRestartCrossingTangentQuantumReceiptOfCrossed
        initial index crossed).amplitude_time_le
  · rw [wholeRestartCrossingTangentQuantumTime_of_not_crossed
      initial index crossed,
      wholeRestartCrossingTangentQuantumPayment_of_not_crossed
        initial index crossed]
    simp

/-- The finite quantum payment is charged once to the next actual restart
segment's existing whole dual-square budget. -/
theorem wholeRestartCrossingTangentQuantumPayment_le_segmentDualSquare
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    wholeRestartCrossingTangentQuantumPayment initial index ≤
      2 * ν.coeff *
        wholeRestartSegmentDualSquarePayment initial (index + 1) := by
  by_cases crossed : wholeRestartHalfCriticalCrossed initial index
  · rw [wholeRestartCrossingTangentQuantumPayment_of_crossed
      initial index crossed]
    calc
      (∫ time in (0 : ℝ)..
          (wholeRestartCrossingTangentQuantumReceiptOfCrossed
            initial index crossed).localTime,
        wholeRestartCrossingFiniteUnforcedTangentEuclideanDensity
          initial index
          (wholeRestartCrossingTangentQuantumReceiptOfCrossed
            initial index crossed).modes time) ≤
          3 * ‖(run initial index).nextContact.prefixReceipt.wholeTangent‖ ^ 2 :=
        (wholeRestartCrossingTangentQuantumReceiptOfCrossed
          initial index crossed).payment_le_whole_tangent
      _ ≤ 3 * ((2 * ν.coeff / 3) *
          wholeRestartSegmentDualSquarePayment initial (index + 1)) :=
        mul_le_mul_of_nonneg_left
          (nextContact_wholeTangent_norm_sq_le_segmentDualSquarePayment
            initial index) (by norm_num)
      _ = 2 * ν.coeff *
          wholeRestartSegmentDualSquarePayment initial (index + 1) := by
        ring
  · rw [wholeRestartCrossingTangentQuantumPayment_of_not_crossed
      initial index crossed]
    exact mul_nonneg
      (mul_nonneg (by norm_num) ν.coeff_pos.le)
      (wholeRestartSegmentDualSquarePayment_nonneg initial (index + 1))

/-! ## Finite-prefix accumulation on the single physical-time axis -/

/-- Total source-generated crossing lifetime before quotienting occurrence
identities. -/
def wholeRestartAccumulatedCrossingTangentQuantumTime
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (length : ℕ) : ℝ :=
  ∑ index ∈ Finset.range length,
    wholeRestartCrossingTangentQuantumTime initial index

/-- Total finite-carrier quantum payment. -/
def wholeRestartAccumulatedCrossingTangentQuantumPayment
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (length : ℕ) : ℝ :=
  ∑ index ∈ Finset.range length,
    wholeRestartCrossingTangentQuantumPayment initial index

theorem wholeRestartAccumulatedCrossingTangentQuantumTime_nonneg
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (length : ℕ) :
    0 ≤ wholeRestartAccumulatedCrossingTangentQuantumTime initial length := by
  unfold wholeRestartAccumulatedCrossingTangentQuantumTime
  exact Finset.sum_nonneg fun index indexMem =>
    wholeRestartCrossingTangentQuantumTime_nonneg initial index

theorem wholeRestartAccumulatedCrossingTangentQuantumPayment_nonneg
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (length : ℕ) :
    0 ≤ wholeRestartAccumulatedCrossingTangentQuantumPayment
      initial length := by
  unfold wholeRestartAccumulatedCrossingTangentQuantumPayment
  exact Finset.sum_nonneg fun index indexMem =>
    wholeRestartCrossingTangentQuantumPayment_nonneg initial index

private theorem shifted_segmentDualSquare_sum_le_accumulated
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (length : ℕ) :
    (∑ index ∈ Finset.range length,
        wholeRestartSegmentDualSquarePayment initial (index + 1)) ≤
      wholeRestartAccumulatedDualSquarePayment initial (length + 1) := by
  unfold wholeRestartAccumulatedDualSquarePayment
  induction length with
  | zero =>
      simpa using
        wholeRestartSegmentDualSquarePayment_nonneg initial 0
  | succ length inductionHypothesis =>
      simpa [Finset.sum_range_succ, Nat.succ_eq_add_one] using
        add_le_add_right inductionHypothesis
          (wholeRestartSegmentDualSquarePayment initial (length + 1))

/-- Exact finite-prefix amplitude--time responsibility. -/
theorem wholeRestartAccumulatedCrossingTangentQuantum_amplitudeTime_le_payment
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (length : ℕ) :
    (wholeRestartCrossingTangentCoerciveQuantum ν / 2) *
          wholeRestartAccumulatedCrossingTangentQuantumTime initial length ≤
      wholeRestartAccumulatedCrossingTangentQuantumPayment initial length := by
  unfold wholeRestartAccumulatedCrossingTangentQuantumTime
    wholeRestartAccumulatedCrossingTangentQuantumPayment
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro index indexMem
  simpa [mul_comm] using
    wholeRestartCrossingTangentQuantum_amplitudeTime_le_payment
      initial index

/-- All finite-carrier quantum payments are paid once by the existing
single-axis dual-square ledger. -/
theorem wholeRestartAccumulatedCrossingTangentQuantumPayment_le_dualSquare
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (length : ℕ) :
    wholeRestartAccumulatedCrossingTangentQuantumPayment initial length ≤
      2 * ν.coeff *
        wholeRestartAccumulatedDualSquarePayment initial (length + 1) := by
  unfold wholeRestartAccumulatedCrossingTangentQuantumPayment
  calc
    (∑ index ∈ Finset.range length,
        wholeRestartCrossingTangentQuantumPayment initial index) ≤
        ∑ index ∈ Finset.range length,
          2 * ν.coeff *
            wholeRestartSegmentDualSquarePayment initial (index + 1) := by
      exact Finset.sum_le_sum fun index indexMem =>
        wholeRestartCrossingTangentQuantumPayment_le_segmentDualSquare
          initial index
    _ = 2 * ν.coeff *
        (∑ index ∈ Finset.range length,
          wholeRestartSegmentDualSquarePayment initial (index + 1)) := by
      rw [Finset.mul_sum]
    _ ≤ 2 * ν.coeff *
        wholeRestartAccumulatedDualSquarePayment initial (length + 1) := by
      exact mul_le_mul_of_nonneg_left
        (shifted_segmentDualSquare_sum_le_accumulated initial length)
        (mul_nonneg (by norm_num) ν.coeff_pos.le)

/-- The source-generated quantum lifetimes occupy no more than their actual
successor receipt windows. -/
theorem wholeRestartAccumulatedCrossingTangentQuantumTime_le_elapsedTime
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    ∀ length : ℕ,
      wholeRestartAccumulatedCrossingTangentQuantumTime initial length ≤
        elapsedTime initial (length + 1)
  | 0 => by
      simp only [wholeRestartAccumulatedCrossingTangentQuantumTime,
        Finset.range_zero, Finset.sum_empty, zero_add, elapsedTime_succ,
        elapsedTime_zero]
      exact (run initial 0).contact.time_pos.le
  | length + 1 => by
      rw [wholeRestartAccumulatedCrossingTangentQuantumTime,
        Finset.sum_range_succ]
      change
        wholeRestartAccumulatedCrossingTangentQuantumTime initial length +
            wholeRestartCrossingTangentQuantumTime initial length ≤
          elapsedTime initial (length + 1 + 1)
      rw [elapsedTime_succ]
      have accumulatedLe :=
        wholeRestartAccumulatedCrossingTangentQuantumTime_le_elapsedTime
          initial length
      have timeLe :
          wholeRestartCrossingTangentQuantumTime initial length ≤
            (run initial (length + 1)).contact.time.1 := by
        change
          wholeRestartCrossingTangentQuantumTime initial length ≤
            (run initial length).nextContact.time.1
        exact
          (wholeRestartCrossingTangentQuantumTime_lt_nextContact
            initial length).le
      exact add_le_add accumulatedLe timeLe

/-! ## Exact occurrence windows on the global physical-time axis -/

/-- Global physical window occupied by one finite quantum carrier. -/
def wholeRestartCrossingTangentQuantumWindow
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) : Set ℝ :=
  Ioc
    (elapsedTime initial (index + 1))
    (elapsedTime initial (index + 1) +
      wholeRestartCrossingTangentQuantumTime initial index)

theorem wholeRestartCrossingTangentQuantumWindow_subset
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    wholeRestartCrossingTangentQuantumWindow initial index ⊆
      wholeRestartPhysicalWindow initial (index + 1) := by
  intro time timeMem
  unfold wholeRestartCrossingTangentQuantumWindow at timeMem
  unfold wholeRestartPhysicalWindow
  refine ⟨timeMem.1, ?_⟩
  exact (calc
      time ≤ elapsedTime initial (index + 1) +
            wholeRestartCrossingTangentQuantumTime initial index :=
        timeMem.2
      _ < elapsedTime initial (index + 1) +
            (run initial index).nextContact.time.1 := by
        simpa [add_comm] using
          add_lt_add_left
            (wholeRestartCrossingTangentQuantumTime_lt_nextContact
              initial index)
            (elapsedTime initial (index + 1))
      _ = elapsedTime initial ((index + 1) + 1) := by
        rw [elapsedTime_succ]
        rfl).le

theorem wholeRestartCrossingTangentQuantumWindow_disjoint
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    {left right : ℕ}
    (different : left ≠ right) :
    Disjoint
      (wholeRestartCrossingTangentQuantumWindow initial left)
      (wholeRestartCrossingTangentQuantumWindow initial right) := by
  exact
    (wholeRestartPhysicalWindow_disjoint initial
      (by omega : left + 1 ≠ right + 1)).mono
        (wholeRestartCrossingTangentQuantumWindow_subset initial left)
        (wholeRestartCrossingTangentQuantumWindow_subset initial right)

/-- The finite pre-quotient density selected by the total source receipt. -/
noncomputable def wholeRestartCrossingTangentQuantumDensity
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (actual : ℝ) : ℝ :=
  match wholeRestartCrossingTangentQuantumReceipt? initial index with
  | some receipt =>
      wholeRestartCrossingFiniteUnforcedTangentEuclideanDensity
        initial index receipt.modes actual
  | none => 0

/-- The same density translated before any occurrence quotient to its unique
global physical window. -/
noncomputable def wholeRestartCrossingTranslatedTangentQuantumDensity
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (time : ℝ) : ℝ :=
  wholeRestartCrossingTangentQuantumDensity initial index
    (time - elapsedTime initial (index + 1))

theorem wholeRestartCrossingTangentQuantumPayment_eq_globalWindowIntegral
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    wholeRestartCrossingTangentQuantumPayment initial index =
      ∫ time in
          elapsedTime initial (index + 1)..
            elapsedTime initial (index + 1) +
              wholeRestartCrossingTangentQuantumTime initial index,
        wholeRestartCrossingTranslatedTangentQuantumDensity
          initial index time := by
  by_cases crossed : wholeRestartHalfCriticalCrossed initial index
  · rw [wholeRestartCrossingTangentQuantumPayment_of_crossed
      initial index crossed,
      wholeRestartCrossingTangentQuantumTime_of_crossed
        initial index crossed]
    unfold wholeRestartCrossingTranslatedTangentQuantumDensity
      wholeRestartCrossingTangentQuantumDensity
    rw [wholeRestartCrossingTangentQuantumReceipt?_eq_some_of_crossed
      initial index crossed]
    rw [intervalIntegral.integral_comp_sub_right]
    simp
  · rw [wholeRestartCrossingTangentQuantumPayment_of_not_crossed
      initial index crossed,
      wholeRestartCrossingTangentQuantumTime_of_not_crossed
        initial index crossed]
    simp

theorem
    wholeRestartAccumulatedCrossingTangentQuantumPayment_eq_globalWindowIntegrals
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (length : ℕ) :
    wholeRestartAccumulatedCrossingTangentQuantumPayment initial length =
      ∑ index ∈ Finset.range length,
        ∫ time in
            elapsedTime initial (index + 1)..
              elapsedTime initial (index + 1) +
                wholeRestartCrossingTangentQuantumTime initial index,
          wholeRestartCrossingTranslatedTangentQuantumDensity
            initial index time := by
  unfold wholeRestartAccumulatedCrossingTangentQuantumPayment
  apply Finset.sum_congr rfl
  intro index indexMem
  exact
    wholeRestartCrossingTangentQuantumPayment_eq_globalWindowIntegral
      initial index

/-- Under finite-time accumulation, every actual round contributes a
strictly positive fixed-amplitude lifetime; the same source law also forces
the accumulated lifetime to remain on the bounded physical axis. -/
theorem elapsedTime_bddAbove_forces_positive_quantumTimes_and_bounded_prefixes
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    (∀ index : ℕ,
      0 < wholeRestartCrossingTangentQuantumTime initial index) ∧
      BddAbove
        (Set.range
          (wholeRestartAccumulatedCrossingTangentQuantumTime initial)) := by
  constructor
  · intro index
    exact wholeRestartCrossingTangentQuantumTime_pos_of_crossed
      initial index
      (elapsedTime_bddAbove_forces_every_halfCriticalCrossing
        initial elapsedBounded index)
  · obtain ⟨bound, boundSpec⟩ := elapsedBounded
    refine ⟨bound, ?_⟩
    rintro _ ⟨length, rfl⟩
    exact
      (wholeRestartAccumulatedCrossingTangentQuantumTime_le_elapsedTime
        initial length).trans
        (boundSpec ⟨length + 1, rfl⟩)

/-- Finite-time accumulation forces the source-owned quantum lifetimes to be
summable.  Together with their strict positivity this identifies the exact
remaining obstruction: the actual persistence windows must collapse. -/
theorem elapsedTime_bddAbove_forces_crossingTangentQuantumTime_summable
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    Summable (wholeRestartCrossingTangentQuantumTime initial) := by
  obtain ⟨bound, boundSpec⟩ := elapsedBounded
  apply summable_of_sum_le
  · exact wholeRestartCrossingTangentQuantumTime_nonneg initial
  · intro indices
    obtain ⟨length, indicesSubset⟩ :=
      Finset.exists_nat_subset_range indices
    calc
      (∑ index ∈ indices,
          wholeRestartCrossingTangentQuantumTime initial index) ≤
