/-! ## The zero row is generated by transversality -/

/-- The whole nonlinear Fourier row at zero vanishes for every transverse
state.  This is the missing zero-coordinate law needed to make the punctured
negative-one observation faithful. -/
theorem wholeStateVorticityNonlinearCoefficientAt_zero_of_transverse
    (state : ComplexVorticityHilbertState)
    (transverse : WholeStateTransverse state) :
    wholeStateVorticityNonlinearCoefficientAt state 0 = 0 := by
  unfold wholeStateVorticityNonlinearCoefficientAt
  have pairZero : ∀ first : IntegerWavevector,
      finiteStateVorticityNonlinearPairContribution
          state (first, (0 : IntegerWavevector) - first) = 0 := by
    intro first
    have secondWave :
        (0 : IntegerWavevector) - first = waveNeg first := by
      ext coordinate
      simp [waveNeg]
    have stateDot :
        complexWavevector ((0 : IntegerWavevector) - first) ⬝ᵥ
            state first = 0 := by
      rw [secondWave, complexWavevector_waveNeg]
      simpa using congrArg Neg.neg (transverse first)
    have velocityDot :
        complexWavevector ((0 : IntegerWavevector) - first) ⬝ᵥ
            finiteStateVelocityCoefficient state first = 0 := by
      rw [secondWave, complexWavevector_waveNeg, neg_dotProduct]
      simpa [finiteStateVelocityCoefficient] using
        congrArg Neg.neg
          (complexWavevector_dot_biotSavartVelocityCoefficient
            first (state first))
    unfold finiteStateVorticityNonlinearPairContribution
    rw [stateDot, velocityDot]
    simp
  simp only [pairZero]
  exact tsum_zero

/-! ## Generated finite-component self forcing -/

/-- The canonical finite component has finite whole gradient mass because
its support is the internally selected crossing-core inventory. -/
theorem wholeRestartCrossingFiniteComponent_gradient_summable
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    Summable fun wave : IntegerWavevector =>
      integerWaveNormSq wave *
        complexCoordinateAmplitudeSq
          (canonicalHalfCriticalComponent ν
            (wholeRestartCrossingFiniteCoreState initial index crossed)
            wave) :=
  summable_wholeStateVorticityGradientDensity_of_supported
    (wholeRestartCrossingFiniteCoreModes initial index crossed)
    (canonicalHalfCriticalComponent ν
      (wholeRestartCrossingFiniteCoreState initial index crossed))
    (wholeRestartCrossingFiniteComponent_supported initial index crossed)

/-- Physical nonlinear `H⁻¹` state of one generated canonical component. -/
def wholeRestartCrossingFiniteComponentNegativeOneState
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    lp (fun _ : IntegerWavevector => ComplexCoordinateVector) 2 :=
  wholeStateVorticityNonlinearNegativeOneState
    (canonicalHalfCriticalComponent ν
      (wholeRestartCrossingFiniteCoreState initial index crossed))
    (wholeRestartCrossingFiniteComponent_transverse initial index crossed)
    (wholeRestartCrossingFiniteComponent_gradient_summable
      initial index crossed)

/-- The primitive component self row is the generated count-fold sum of the
single canonical component row. -/
theorem wholeRestartCrossingFiniteComponentSelfRow_eq_nsmul
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index)
    (output : IntegerWavevector) :
    wholeRestartCrossingFiniteComponentSelfRow
        initial index crossed output =
      canonicalHalfCriticalComponentCount ν
          (wholeRestartCrossingFiniteCoreState initial index crossed) •
        wholeStateVorticityNonlinearCoefficientAt
          (canonicalHalfCriticalComponent ν
            (wholeRestartCrossingFiniteCoreState initial index crossed))
          output := by
  rw [wholeRestartCrossingFiniteComponentSelfRow_eq_componentStates]
  simp [wholeRestartCrossingFiniteComponents,
    canonicalHalfCriticalComponents]

/-- The complete finite-component self forcing in the same physical
negative-one carrier as the actual whole nonlinearity. -/
def wholeRestartCrossingFiniteComponentSelfNegativeOneState
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    lp (fun _ : IntegerWavevector => ComplexCoordinateVector) 2 :=
  canonicalHalfCriticalComponentCount ν
      (wholeRestartCrossingFiniteCoreState initial index crossed) •
    wholeRestartCrossingFiniteComponentNegativeOneState
      initial index crossed

/-- Coefficient readout of the generated finite-component self forcing. -/
theorem wholeRestartCrossingFiniteComponentSelfNegativeOneState_apply
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index)
    (output : IntegerWavevector) :
    wholeRestartCrossingFiniteComponentSelfNegativeOneState
        initial index crossed output =
      if output = 0 then 0
      else
        (Real.sqrt (integerWaveViscousMultiplier output))⁻¹ •
          wholeRestartCrossingFiniteComponentSelfRow
            initial index crossed output := by
  change
    canonicalHalfCriticalComponentCount ν
        (wholeRestartCrossingFiniteCoreState initial index crossed) •
      wholeStateVorticityNonlinearNegativeOneState
        (canonicalHalfCriticalComponent ν
          (wholeRestartCrossingFiniteCoreState initial index crossed))
        (wholeRestartCrossingFiniteComponent_transverse initial index crossed)
        (wholeRestartCrossingFiniteComponent_gradient_summable
          initial index crossed) output = _
  rw [wholeStateVorticityNonlinearNegativeOneState_apply]
  by_cases outputZero : output = 0
  · simp [wholeStateVorticityNonlinearNegativeOneWeightedCoefficient,
      outputZero]
  · rw [wholeStateVorticityNonlinearNegativeOneWeightedCoefficient,
      if_neg outputZero, if_neg outputZero,
      wholeRestartCrossingFiniteComponentSelfRow_eq_nsmul
        initial index crossed output]
    module

/-! ## Faithful physical image of the complete gluing residual -/

/-- The complete crossing gluing row with the physical inverse-square-root
Laplacian weight. -/
def wholeRestartCrossingCompleteSourceGluingNegativeOneWeightedCoefficient
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index)
    (output : IntegerWavevector) : ComplexCoordinateVector :=
  if output = 0 then 0
  else
    (Real.sqrt (integerWaveViscousMultiplier output))⁻¹ •
      wholeRestartCrossingCompleteSourceGluingResidual
        initial index crossed output

/-- The actual whole nonlinear forcing minus all generated primitive
component self forcing.  Membership in `H⁻¹` is inherited from the two
already generated physical states; it is not supplied as a certificate. -/
def wholeRestartCrossingCompleteSourceGluingNegativeOneState
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    lp (fun _ : IntegerWavevector => ComplexCoordinateVector) 2 :=
  wholeStateVorticityNonlinearNegativeOneState
      (run initial index).contact.physicalState
      (run initial index).contact.transverse
      (run initial index).contact.gradient_summable -
    wholeRestartCrossingFiniteComponentSelfNegativeOneState
      initial index crossed

/-- The physical negative-one state reads exactly the generated complete
cross/tail gluing row at every Fourier output. -/
theorem wholeRestartCrossingCompleteSourceGluingNegativeOneState_apply
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index)
    (output : IntegerWavevector) :
    wholeRestartCrossingCompleteSourceGluingNegativeOneState
        initial index crossed output =
      wholeRestartCrossingCompleteSourceGluingNegativeOneWeightedCoefficient
        initial index crossed output := by
  change
    wholeStateVorticityNonlinearNegativeOneWeightedCoefficient
          (run initial index).contact.physicalState output -
        wholeRestartCrossingFiniteComponentSelfNegativeOneState
          initial index crossed output = _
  rw [wholeRestartCrossingFiniteComponentSelfNegativeOneState_apply]
  unfold
    wholeRestartCrossingCompleteSourceGluingNegativeOneWeightedCoefficient
  by_cases outputZero : output = 0
  · simp [wholeStateVorticityNonlinearNegativeOneWeightedCoefficient,
      outputZero]
  · rw [wholeStateVorticityNonlinearNegativeOneWeightedCoefficient,
      if_neg outputZero, if_neg outputZero, if_neg outputZero]
    rw [wholeRestartCrossingWholeNonlinear_eq_sourceSelf_add_gluing
      initial index crossed output]
    module

/-- The complete crossing gluing row has no zero Fourier coordinate.  This
is generated from the actual whole and component transverse laws. -/
theorem wholeRestartCrossingCompleteSourceGluingResidual_zero_output
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    wholeRestartCrossingCompleteSourceGluingResidual
        initial index crossed 0 = 0 := by
  have wholeZero :=
    wholeStateVorticityNonlinearCoefficientAt_zero_of_transverse
      (run initial index).contact.physicalState
      (run initial index).contact.transverse
  have componentZero :=
    wholeStateVorticityNonlinearCoefficientAt_zero_of_transverse
      (canonicalHalfCriticalComponent ν
        (wholeRestartCrossingFiniteCoreState initial index crossed))
      (wholeRestartCrossingFiniteComponent_transverse initial index crossed)
  have selfZero :
      wholeRestartCrossingFiniteComponentSelfRow
          initial index crossed 0 = 0 := by
    rw [wholeRestartCrossingFiniteComponentSelfRow_eq_nsmul
      initial index crossed 0, componentZero]
    simp
  have ledger :=
    wholeRestartCrossingWholeNonlinear_eq_sourceSelf_add_gluing
      initial index crossed 0
  simpa [wholeZero, selfZero] using ledger.symm

/-- The physical `H⁻¹` observation has no kernel on the actual complete
crossing gluing row. -/
theorem wholeRestartCrossingCompleteSourceGluingNegativeOneState_eq_zero_iff
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    wholeRestartCrossingCompleteSourceGluingNegativeOneState
        initial index crossed = 0 ↔
      (fun output =>
        wholeRestartCrossingCompleteSourceGluingResidual
          initial index crossed output) = 0 := by
  constructor
  · intro observedZero
    funext output
    by_cases outputZero : output = 0
    · subst output
      exact wholeRestartCrossingCompleteSourceGluingResidual_zero_output
        initial index crossed
    · have coordinateObservedZero :
          wholeRestartCrossingCompleteSourceGluingNegativeOneState
              initial index crossed output = 0 := by
        rw [observedZero]
        rfl
      rw [wholeRestartCrossingCompleteSourceGluingNegativeOneState_apply,
        wholeRestartCrossingCompleteSourceGluingNegativeOneWeightedCoefficient,
        if_neg outputZero] at coordinateObservedZero
      have multiplierPos :
          0 < integerWaveViscousMultiplier output := by
        unfold integerWaveViscousMultiplier
        exact mul_pos
          (sq_pos_of_pos (mul_pos (by norm_num) Real.pi_pos))
          (integerWaveNormSq_pos outputZero)
      have weightNonzero :
          (Real.sqrt (integerWaveViscousMultiplier output))⁻¹ ≠ 0 :=
        inv_ne_zero (Real.sqrt_pos.2 multiplierPos).ne'
      exact (smul_eq_zero.mp coordinateObservedZero).resolve_left
        weightNonzero
  · intro residualZero
    apply lp.ext
    funext output
    rw [wholeRestartCrossingCompleteSourceGluingNegativeOneState_apply]
    unfold
      wholeRestartCrossingCompleteSourceGluingNegativeOneWeightedCoefficient
    by_cases outputZero : output = 0
    · simp [outputZero]
    · have coordinateZero := congrFun residualZero output
      simp [outputZero, coordinateZero]

/-- A native nonzero component-gluing obstruction survives exactly in the
physical `H⁻¹` carrier.  The `crossed` witness is generated by the actual
current and is used only to identify its canonical source decomposition. -/
theorem wholeRestartComponentGluingResidualRow_nonzero_iff_negativeOne
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    wholeRestartComponentGluingResidualRow initial index ≠ 0 ↔
      wholeRestartCrossingCompleteSourceGluingNegativeOneState
        initial index crossed ≠ 0 := by
  rw [ne_eq, ne_eq,
    not_congr
      (wholeRestartCrossingCompleteSourceGluingNegativeOneState_eq_zero_iff
        initial index crossed)]
  rw [wholeRestartComponentGluingResidualRow_of_crossed
    initial index crossed]

end

