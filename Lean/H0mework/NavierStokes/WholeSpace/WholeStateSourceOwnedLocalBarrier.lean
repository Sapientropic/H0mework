import H0mework.NavierStokes.InitialData.SourceOwnedLocalKernelAbsorption

/-!
# A whole-state source-owned local barrier

Canonical finite projections of one whole restart state have different
finite coefficient enstrophies.  The source must nevertheless generate one
physical time window for the complete projection family.  This module runs
the existing first-contact barrier with a single externally fixed ceiling
that is itself generated from the whole state.

The theorem below does not accept a cutoff, trajectory bound, smallness
parameter, or absorption certificate.  Its only numerical hypothesis says
that the actual initial finite enstrophy plus one lies below the common
ceiling; canonical whole-state projections will generate that inequality.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace
    ThreeDimensionalVorticityCoefficientWholeStateSourceOwnedLocalBarrier

open Set
open ThreeDimensionalPeriodicIntegerCharacterCoarseFilter
open ThreeDimensionalPeriodicFilteredNavierStokesGenerator
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientFiniteSupportComplexTrajectory
open ThreeDimensionalVorticityCoefficientFiniteSupportRealityTrajectory
open ThreeDimensionalVorticityCoefficientGeneratedShellSerrinGeometry
open ThreeDimensionalVorticityCoefficientFiniteSupportCriticalSobolev
open ThreeDimensionalVorticityCoefficientFiniteGalerkinEnstrophyBalance
open
  ThreeDimensionalVorticityCoefficientSourceOwnedLocalKernelAbsorption

noncomputable section

/-- Barrier slope selected once from viscosity and a common coefficient
enstrophy ceiling. -/
def sourceOwnedWholeStateBarrierSlope
    (ν : Viscosity)
    (ceiling : ℝ) : ℝ :=
  sourceOwnedLocalQuadraticCoefficient ν ceiling * ceiling ^ 2 + 1

theorem sourceOwnedWholeStateBarrierSlope_pos
    (ν : Viscosity)
    (ceiling : ℝ) :
    0 < sourceOwnedWholeStateBarrierSlope ν ceiling := by
  unfold sourceOwnedWholeStateBarrierSlope
  have coefficientNonneg :=
    sourceOwnedLocalQuadraticCoefficient_nonneg ν ceiling
  nlinarith [sq_nonneg ceiling]

/-- Viscosity-dependent seventh-order coefficient generated by the exact
canonical cube incidence. -/
def sourceOwnedWholeStateBarrierSeventhCoefficient
    (ν : Viscosity) : ℝ :=
  sourceOwnedLocalQuadraticFifthCoefficient ν

theorem sourceOwnedWholeStateBarrierSeventhCoefficient_pos
    (ν : Viscosity) :
    0 < sourceOwnedWholeStateBarrierSeventhCoefficient ν :=
  sourceOwnedLocalQuadraticFifthCoefficient_pos ν

/-- Seventh-order lower barrier.  This is the missing high-frequency
cardinality readout: the canonical radius is linear in the physical ceiling,
its exact cube frequency mass is fifth-order, and the enstrophy barrier adds
the remaining square. -/
theorem sourceOwnedWholeStateBarrierSeventh_le
    (ν : Viscosity)
    (ceiling : ℝ)
    (ceilingNonneg : 0 ≤ ceiling) :
    sourceOwnedWholeStateBarrierSeventhCoefficient ν * ceiling ^ 7 + 1 ≤
      sourceOwnedWholeStateBarrierSlope ν ceiling := by
  have coefficientLower :=
    sourceOwnedLocalQuadraticFifthCoefficient_mul_le ν ceiling
  have ceilingLe : ceiling ≤ max 0 ceiling + 1 := by
    rw [max_eq_right ceilingNonneg]
    linarith
  have fifthLe : ceiling ^ 5 ≤ (max 0 ceiling + 1) ^ 5 :=
    pow_le_pow_left₀ ceilingNonneg ceilingLe 5
  have seventhLe :
      sourceOwnedWholeStateBarrierSeventhCoefficient ν * ceiling ^ 7 ≤
        sourceOwnedLocalQuadraticFifthCoefficient ν *
          (max 0 ceiling + 1) ^ 5 * ceiling ^ 2 := by
    have coefficientNonneg :=
      (sourceOwnedWholeStateBarrierSeventhCoefficient_pos ν).le
    change
      sourceOwnedLocalQuadraticFifthCoefficient ν * ceiling ^ 7 ≤ _
    calc
      sourceOwnedLocalQuadraticFifthCoefficient ν * ceiling ^ 7 =
          sourceOwnedLocalQuadraticFifthCoefficient ν *
            ceiling ^ 5 * ceiling ^ 2 := by ring
      _ ≤ sourceOwnedLocalQuadraticFifthCoefficient ν *
            (max 0 ceiling + 1) ^ 5 * ceiling ^ 2 := by
        exact mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left fifthLe coefficientNonneg)
          (sq_nonneg ceiling)
  have scaledCoefficientLower := mul_le_mul_of_nonneg_right
    coefficientLower (sq_nonneg ceiling)
  unfold sourceOwnedWholeStateBarrierSlope
  linarith

/-- Explicit source-data upper barrier produced by the canonical lattice
core radius. -/
noncomputable def sourceOwnedWholeStateBarrierSlopeUpper
    (ν : Viscosity)
    (ceiling : ℝ) : ℝ :=
  sourceOwnedLocalQuadraticCoefficientUpper ν ceiling * ceiling ^ 2 + 1

theorem sourceOwnedWholeStateBarrierSlopeUpper_pos
    (ν : Viscosity)
    (ceiling : ℝ) :
    0 < sourceOwnedWholeStateBarrierSlopeUpper ν ceiling := by
  unfold sourceOwnedWholeStateBarrierSlopeUpper
  have coefficientNonneg :=
    sourceOwnedLocalQuadraticCoefficientUpper_nonneg ν ceiling
  nlinarith [sq_nonneg ceiling]

theorem sourceOwnedWholeStateBarrierSlope_le_upper
    (ν : Viscosity)
    (ceiling : ℝ) :
    sourceOwnedWholeStateBarrierSlope ν ceiling ≤
      sourceOwnedWholeStateBarrierSlopeUpper ν ceiling := by
  unfold sourceOwnedWholeStateBarrierSlope
    sourceOwnedWholeStateBarrierSlopeUpper
  simpa only [add_comm] using
    (add_le_add_right
      (mul_le_mul_of_nonneg_right
        (sourceOwnedLocalQuadraticCoefficient_le_upper ν ceiling)
        (sq_nonneg ceiling)) 1)

/-- Viscosity-dependent seventh-order majorant generated by the same
canonical lattice core. -/
noncomputable def sourceOwnedWholeStateBarrierSeventhCoefficientUpper
    (ν : Viscosity) : ℝ :=
  sourceOwnedLocalQuadraticFifthCoefficientUpper ν + 1

theorem sourceOwnedWholeStateBarrierSeventhCoefficientUpper_pos
    (ν : Viscosity) :
    0 < sourceOwnedWholeStateBarrierSeventhCoefficientUpper ν := by
  unfold sourceOwnedWholeStateBarrierSeventhCoefficientUpper
  linarith [sourceOwnedLocalQuadraticFifthCoefficientUpper_nonneg ν]

/-- The complete canonical barrier has seventh-order growth from above as
well as from below.  This upper row is what turns the chosen local horizon
into a quantitative source-owned residence debit. -/
theorem sourceOwnedWholeStateBarrierSlopeUpper_le_seventh
    (ν : Viscosity)
    (ceiling : ℝ)
    (ceilingNonneg : 0 ≤ ceiling) :
    sourceOwnedWholeStateBarrierSlopeUpper ν ceiling ≤
      sourceOwnedWholeStateBarrierSeventhCoefficientUpper ν *
        (ceiling + 1) ^ 7 := by
  have baseNonneg : 0 ≤ ceiling + 1 := by linarith
  have oneLeBase : 1 ≤ ceiling + 1 := by linarith
  have coefficientUpper :=
    sourceOwnedLocalQuadraticCoefficientUpper_le_fifth
      ν ceiling ceilingNonneg
  have squareLe : ceiling ^ 2 ≤ (ceiling + 1) ^ 2 :=
    pow_le_pow_left₀ ceilingNonneg (by linarith) 2
  have fifthCoefficientNonneg :=
    sourceOwnedLocalQuadraticFifthCoefficientUpper_nonneg ν
  have scaledCoefficientUpper :
      sourceOwnedLocalQuadraticCoefficientUpper ν ceiling * ceiling ^ 2 ≤
        sourceOwnedLocalQuadraticFifthCoefficientUpper ν *
          (ceiling + 1) ^ 7 := by
    calc
      sourceOwnedLocalQuadraticCoefficientUpper ν ceiling * ceiling ^ 2 ≤
          (sourceOwnedLocalQuadraticFifthCoefficientUpper ν *
            (ceiling + 1) ^ 5) * ceiling ^ 2 :=
        mul_le_mul_of_nonneg_right coefficientUpper (sq_nonneg ceiling)
      _ ≤ (sourceOwnedLocalQuadraticFifthCoefficientUpper ν *
            (ceiling + 1) ^ 5) * (ceiling + 1) ^ 2 :=
        mul_le_mul_of_nonneg_left squareLe
          (mul_nonneg fifthCoefficientNonneg (pow_nonneg baseNonneg 5))
      _ = sourceOwnedLocalQuadraticFifthCoefficientUpper ν *
            (ceiling + 1) ^ 7 := by ring
  have oneLeSeventh : 1 ≤ (ceiling + 1) ^ 7 := by
    simpa using (pow_le_pow_left₀ (by norm_num : (0 : ℝ) ≤ 1) oneLeBase 7)
  unfold sourceOwnedWholeStateBarrierSlopeUpper
    sourceOwnedWholeStateBarrierSeventhCoefficientUpper
  calc
    sourceOwnedLocalQuadraticCoefficientUpper ν ceiling * ceiling ^ 2 + 1 ≤
        sourceOwnedLocalQuadraticFifthCoefficientUpper ν *
          (ceiling + 1) ^ 7 + (ceiling + 1) ^ 7 :=
      add_le_add scaledCoefficientUpper oneLeSeventh
    _ = (sourceOwnedLocalQuadraticFifthCoefficientUpper ν + 1) *
          (ceiling + 1) ^ 7 := by ring

theorem sourceOwnedWholeStateBarrierSlope_le_seventhUpper
    (ν : Viscosity)
    (ceiling : ℝ)
    (ceilingNonneg : 0 ≤ ceiling) :
    sourceOwnedWholeStateBarrierSlope ν ceiling ≤
      sourceOwnedWholeStateBarrierSeventhCoefficientUpper ν *
        (ceiling + 1) ^ 7 :=
  (sourceOwnedWholeStateBarrierSlope_le_upper ν ceiling).trans
    (sourceOwnedWholeStateBarrierSlopeUpper_le_seventh
      ν ceiling ceilingNonneg)

/-- Every fixed nonzero lattice wave eventually forces a uniform positive
quadratic lower bound for the whole-state barrier.  The threshold and the
coefficient floor are both generated from the viscosity and fixed wave; no
ambient Galerkin cutoff is supplied. -/
theorem eventually_sourceOwnedLocalFixedWaveBarrierFloor_le
    (ν : Viscosity)
    (wave : IntegerWavevector)
    (waveNe : wave ≠ 0) :
    ∃ scaleFloor : ℝ,
      ∀ ceiling : ℝ, scaleFloor ≤ ceiling →
        sourceOwnedLocalFixedWaveQuadraticFloor ν wave * ceiling ^ 2 + 1 ≤
          sourceOwnedWholeStateBarrierSlope ν ceiling := by
  rcases eventually_sourceOwnedLocalFixedWaveQuadraticFloor_le
      ν wave waveNe with ⟨scaleFloor, coefficientFloor⟩
  refine ⟨scaleFloor, ?_⟩
  intro ceiling scaleLe
  have coefficientLe := coefficientFloor ceiling scaleLe
  have squareNonneg : 0 ≤ ceiling ^ 2 := sq_nonneg ceiling
  unfold sourceOwnedWholeStateBarrierSlope
  simpa only [add_comm] using
    (add_le_add_right
      (mul_le_mul_of_nonneg_right coefficientLe squareNonneg) 1)

/-- Positive common time generated from the same whole-state ceiling. -/
def sourceOwnedWholeStateDuration
    (ν : Viscosity)
    (ceiling : ℝ) : ℝ :=
  1 / (2 * sourceOwnedWholeStateBarrierSlope ν ceiling)

theorem sourceOwnedWholeStateDuration_pos
    (ν : Viscosity)
    (ceiling : ℝ) :
    0 < sourceOwnedWholeStateDuration ν ceiling := by
  unfold sourceOwnedWholeStateDuration
  exact div_pos (by norm_num)
    (mul_pos (by norm_num)
      (sourceOwnedWholeStateBarrierSlope_pos ν ceiling))

/-- Explicit positive lower horizon corresponding to the canonical core
majorant. -/
noncomputable def sourceOwnedWholeStateDurationLower
    (ν : Viscosity)
    (ceiling : ℝ) : ℝ :=
  1 / (2 * sourceOwnedWholeStateBarrierSlopeUpper ν ceiling)

theorem sourceOwnedWholeStateDurationLower_pos
    (ν : Viscosity)
    (ceiling : ℝ) :
    0 < sourceOwnedWholeStateDurationLower ν ceiling := by
  unfold sourceOwnedWholeStateDurationLower
  exact div_pos (by norm_num)
    (mul_pos (by norm_num)
      (sourceOwnedWholeStateBarrierSlopeUpper_pos ν ceiling))

theorem sourceOwnedWholeStateDurationLower_le
    (ν : Viscosity)
    (ceiling : ℝ) :
    sourceOwnedWholeStateDurationLower ν ceiling ≤
      sourceOwnedWholeStateDuration ν ceiling := by
  have denominatorLe :
      2 * sourceOwnedWholeStateBarrierSlope ν ceiling ≤
        2 * sourceOwnedWholeStateBarrierSlopeUpper ν ceiling :=
    mul_le_mul_of_nonneg_left
      (sourceOwnedWholeStateBarrierSlope_le_upper ν ceiling)
      (by norm_num)
  have denominatorPos :
      0 < 2 * sourceOwnedWholeStateBarrierSlope ν ceiling :=
    mul_pos (by norm_num)
      (sourceOwnedWholeStateBarrierSlope_pos ν ceiling)
  unfold sourceOwnedWholeStateDurationLower sourceOwnedWholeStateDuration
  simpa only [one_div] using
    (one_div_le_one_div_of_le denominatorPos denominatorLe)

/-- Polynomially explicit lower horizon.  Unlike the exact duration, this
row exposes the seventh-order scale dependence needed by the residence
fold while retaining only source-generated viscosity data. -/
noncomputable def sourceOwnedWholeStateSeventhDurationLower
    (ν : Viscosity)
    (ceiling : ℝ) : ℝ :=
  1 /
    (2 * sourceOwnedWholeStateBarrierSeventhCoefficientUpper ν *
      (ceiling + 1) ^ 7)

theorem sourceOwnedWholeStateSeventhDurationLower_pos
    (ν : Viscosity)
    (ceiling : ℝ)
    (ceilingNonneg : 0 ≤ ceiling) :
    0 < sourceOwnedWholeStateSeventhDurationLower ν ceiling := by
  have basePos : 0 < ceiling + 1 := by linarith
  unfold sourceOwnedWholeStateSeventhDurationLower
  exact one_div_pos.mpr
    (mul_pos
      (mul_pos (by norm_num)
        (sourceOwnedWholeStateBarrierSeventhCoefficientUpper_pos ν))
      (pow_pos basePos 7))

theorem sourceOwnedWholeStateSeventhDurationLower_le
    (ν : Viscosity)
    (ceiling : ℝ)
    (ceilingNonneg : 0 ≤ ceiling) :
    sourceOwnedWholeStateSeventhDurationLower ν ceiling ≤
      sourceOwnedWholeStateDuration ν ceiling := by
  have barrierLe :=
    sourceOwnedWholeStateBarrierSlope_le_seventhUpper
      ν ceiling ceilingNonneg
  have denominatorLe :
      2 * sourceOwnedWholeStateBarrierSlope ν ceiling ≤
        2 * sourceOwnedWholeStateBarrierSeventhCoefficientUpper ν *
          (ceiling + 1) ^ 7 := by
    calc
      2 * sourceOwnedWholeStateBarrierSlope ν ceiling ≤
          2 * (sourceOwnedWholeStateBarrierSeventhCoefficientUpper ν *
            (ceiling + 1) ^ 7) :=
        mul_le_mul_of_nonneg_left barrierLe (by norm_num)
      _ = 2 * sourceOwnedWholeStateBarrierSeventhCoefficientUpper ν *
            (ceiling + 1) ^ 7 := by ring
  have denominatorPos :
      0 < 2 * sourceOwnedWholeStateBarrierSlope ν ceiling :=
    mul_pos (by norm_num)
      (sourceOwnedWholeStateBarrierSlope_pos ν ceiling)
  unfold sourceOwnedWholeStateSeventhDurationLower
    sourceOwnedWholeStateDuration
  simpa only [one_div] using
    (one_div_le_one_div_of_le denominatorPos denominatorLe)

/--
Every actual finite Galerkin solution whose initial coefficient enstrophy
fits under one common ceiling stays below that ceiling on the common time
generated from it.  The tail absorption is still generated at a possible
first contact; it is not a premise.
-/
theorem finiteStateVorticity_sourceOwnedWholeStateBarrier_on_Icc
    (modes : Finset IntegerWavevector)
    (negClosed :
      ∀ wave, wave ∈ modes → waveNeg wave ∈ modes)
    (ν : Viscosity)
    (ceiling : ℝ)
    (trajectory : ℝ → ComplexVorticityHilbertState)
    (b : ℝ)
    (initialFits :
      finiteStateVorticityCoefficientEnstrophy
            modes (trajectory 0) + 1 ≤
        ceiling)
    (bLeDuration :
      b ≤ sourceOwnedWholeStateDuration ν ceiling)
    (evolves :
      ∀ t ∈ Icc (0 : ℝ) b,
        HasDerivAt trajectory
          (finiteStateVorticityGenerator
            modes ν.coeff (trajectory t)) t)
    (reality :
      ∀ t ∈ Icc (0 : ℝ) b,
        FiniteStateFourierReality (trajectory t))
    (transverse :
      ∀ t ∈ Icc (0 : ℝ) b,
        ∀ wave ∈ modes,
          complexWavevector wave ⬝ᵥ trajectory t wave = 0) :
    ∀ t ∈ Icc (0 : ℝ) b,
      finiteStateVorticityHalfEnstrophy modes (trajectory t) ≤
          finiteStateVorticityHalfEnstrophy modes (trajectory 0) +
            sourceOwnedWholeStateBarrierSlope ν ceiling * t ∧
        finiteStateVorticityCoefficientEnstrophy
            modes (trajectory t) ≤
          ceiling := by
  let slope := sourceOwnedWholeStateBarrierSlope ν ceiling
  let duration := sourceOwnedWholeStateDuration ν ceiling
  let halfEnstrophy : ℝ → ℝ := fun time =>
    finiteStateVorticityHalfEnstrophy modes (trajectory time)
  let exactRate : ℝ → ℝ := fun time =>
    finiteStateVorticityStretchingWork modes (trajectory time) -
      ν.coeff * (2 * Real.pi) ^ 2 *
        finiteStateVorticityEnstrophyMass modes (trajectory time)
  let barrier : ℝ → ℝ := fun time =>
    halfEnstrophy 0 + slope * time
  have slopePos : 0 < slope := by
    exact sourceOwnedWholeStateBarrierSlope_pos ν ceiling
  have durationEq : duration = 1 / (2 * slope) := by
    rfl
  have halfDerivative :
      ∀ t ∈ Icc (0 : ℝ) b,
        HasDerivAt halfEnstrophy (exactRate t) t := by
    intro t tMem
    exact finiteStateVorticityHalfEnstrophy_hasDerivAt_stretchingWork
      modes negClosed ν.coeff trajectory t
      (evolves t tMem)
      (reality t tMem)
  have halfContinuous :
      ContinuousOn halfEnstrophy (Icc (0 : ℝ) b) :=
    HasDerivAt.continuousOn halfDerivative
  have barrierDerivative :
      ∀ t : ℝ, HasDerivAt barrier slope t := by
    intro t
    change HasDerivAt
      (fun time : ℝ => halfEnstrophy 0 + slope * time) slope t
    simpa only [id_eq, mul_one] using
      ((hasDerivAt_id t).const_mul slope).const_add
        (halfEnstrophy 0)
  have boundaryRate :
      ∀ t ∈ Ico (0 : ℝ) b,
        halfEnstrophy t = barrier t → exactRate t < slope := by
    intro t tMem contact
    have tMemClosed : t ∈ Icc (0 : ℝ) b :=
      ⟨tMem.1, tMem.2.le⟩
    have tLtDuration : t < duration :=
      lt_of_lt_of_le tMem.2 bLeDuration
    have denominatorPos : 0 < 2 * slope :=
      mul_pos (by norm_num) slopePos
    have scaledTimeLt : t * (2 * slope) < 1 := by
      apply (lt_div_iff₀ denominatorPos).mp
      simpa [durationEq] using tLtDuration
    have contactEnstrophy :
        finiteStateVorticityCoefficientEnstrophy
            modes (trajectory t) =
          finiteStateVorticityCoefficientEnstrophy
              modes (trajectory 0) + 2 * slope * t := by
      dsimp [halfEnstrophy, barrier] at contact
      unfold finiteStateVorticityHalfEnstrophy at contact
      linarith
    have belowCeiling :
        finiteStateVorticityCoefficientEnstrophy
            modes (trajectory t) ≤ ceiling := by
      rw [contactEnstrophy]
      nlinarith
    have pointwise :=
      finiteStateVorticityHalfEnstrophy_hasDerivAt_and_le_sourceOwnedLocal
        modes negClosed ν ceiling trajectory t
        (evolves t tMemClosed)
        (reality t tMemClosed)
        (transverse t tMemClosed)
        belowCeiling
    have gradientNonneg :
        0 ≤ (2 * Real.pi) ^ 2 *
          finiteStateVorticityEnstrophyMass modes (trajectory t) :=
      mul_nonneg (sq_nonneg _)
        (finiteStateVorticityEnstrophyMass_nonneg modes (trajectory t))
    have enstrophyNonneg :
        0 ≤ finiteStateVorticityCoefficientEnstrophy
          modes (trajectory t) := by
      unfold finiteStateVorticityCoefficientEnstrophy
      exact Finset.sum_nonneg fun wave waveMem =>
        complexCoordinateAmplitudeSq_nonneg (trajectory t wave)
    have squareLe :
        finiteStateVorticityCoefficientEnstrophy
              modes (trajectory t) ^ 2 ≤ ceiling ^ 2 := by
      nlinarith
    have coefficientNonneg :
        0 ≤ sourceOwnedLocalQuadraticCoefficient ν ceiling :=
      sourceOwnedLocalQuadraticCoefficient_nonneg ν ceiling
    have rateLe :
        exactRate t ≤
          sourceOwnedLocalQuadraticCoefficient ν ceiling * ceiling ^ 2 := by
      calc
        exactRate t ≤
            -(3 * ν.coeff / 8) *
                ((2 * Real.pi) ^ 2 *
                  finiteStateVorticityEnstrophyMass modes (trajectory t)) +
              sourceOwnedLocalQuadraticCoefficient ν ceiling *
                finiteStateVorticityCoefficientEnstrophy
                  modes (trajectory t) ^ 2 := pointwise.2
        _ ≤ sourceOwnedLocalQuadraticCoefficient ν ceiling *
              finiteStateVorticityCoefficientEnstrophy
                modes (trajectory t) ^ 2 := by
          have viscousCoefficientNonneg : 0 ≤ 3 * ν.coeff / 8 := by
            exact div_nonneg
              (mul_nonneg (by norm_num) ν.coeff_pos.le)
              (by norm_num)
          have viscousTermNonpos :
              -(3 * ν.coeff / 8) *
                  ((2 * Real.pi) ^ 2 *
                    finiteStateVorticityEnstrophyMass
                      modes (trajectory t)) ≤ 0 :=
            mul_nonpos_of_nonpos_of_nonneg
              (neg_nonpos.mpr viscousCoefficientNonneg)
              gradientNonneg
          exact add_le_of_nonpos_left viscousTermNonpos
        _ ≤ sourceOwnedLocalQuadraticCoefficient ν ceiling *
              ceiling ^ 2 :=
          mul_le_mul_of_nonneg_left squareLe coefficientNonneg
    dsimp [slope, sourceOwnedWholeStateBarrierSlope]
    linarith
  have halfLeBarrier :
      ∀ t ∈ Icc (0 : ℝ) b,
        halfEnstrophy t ≤ barrier t := by
    have initialBarrier : halfEnstrophy 0 ≤ barrier 0 := by
      simp [barrier]
    intro t tMem
    exact image_le_of_deriv_right_lt_deriv_boundary
      (f' := exactRate) (B := barrier) (B' := fun _ => slope)
      halfContinuous
      (fun time timeMem =>
        (halfDerivative time
          ⟨timeMem.1, timeMem.2.le⟩).hasDerivWithinAt)
      initialBarrier barrierDerivative boundaryRate tMem
  intro t tMem
  have halfLe := halfLeBarrier t tMem
  have tLeDuration : t ≤ duration := tMem.2.trans bLeDuration
  have denominatorPos : 0 < 2 * slope :=
    mul_pos (by norm_num) slopePos
  have scaledTimeLe : t * (2 * slope) ≤ 1 := by
    apply (le_div_iff₀ denominatorPos).mp
    rw [← durationEq]
    exact tLeDuration
  have fullLe :
      finiteStateVorticityCoefficientEnstrophy modes (trajectory t) ≤
        ceiling := by
    dsimp [halfEnstrophy, barrier] at halfLe
    unfold finiteStateVorticityHalfEnstrophy at halfLe
    nlinarith
  exact
    ⟨by simpa [halfEnstrophy, barrier, slope] using halfLe,
      fullLe⟩

/-- The source-owned barrier controls every ordered enstrophy increment on
the same actual finite trajectory, not only the increment from time zero.
This is the reverse-time form needed to value a terminal state against the
kinetic density accumulated on its own prefix. -/
theorem finiteStateVorticity_sourceOwnedWholeStateBarrier_increment_le
    (modes : Finset IntegerWavevector)
    (negClosed :
      ∀ wave, wave ∈ modes → waveNeg wave ∈ modes)
    (ν : Viscosity)
    (ceiling : ℝ)
    (trajectory : ℝ → ComplexVorticityHilbertState)
    (b : ℝ)
    (initialFits :
      finiteStateVorticityCoefficientEnstrophy
            modes (trajectory 0) + 1 ≤
        ceiling)
    (bLeDuration :
      b ≤ sourceOwnedWholeStateDuration ν ceiling)
    (evolves :
      ∀ t ∈ Icc (0 : ℝ) b,
        HasDerivAt trajectory
          (finiteStateVorticityGenerator
            modes ν.coeff (trajectory t)) t)
    (reality :
      ∀ t ∈ Icc (0 : ℝ) b,
        FiniteStateFourierReality (trajectory t))
    (transverse :
      ∀ t ∈ Icc (0 : ℝ) b,
        ∀ wave ∈ modes,
          complexWavevector wave ⬝ᵥ trajectory t wave = 0)
    (left right : ℝ)
    (leftMem : left ∈ Icc (0 : ℝ) b)
    (rightMem : right ∈ Icc (0 : ℝ) b)
    (leftLeRight : left ≤ right) :
    finiteStateVorticityCoefficientEnstrophy modes (trajectory right) ≤
      finiteStateVorticityCoefficientEnstrophy modes (trajectory left) +
        2 * sourceOwnedWholeStateBarrierSlope ν ceiling *
          (right - left) := by
  let slope := sourceOwnedWholeStateBarrierSlope ν ceiling
  let halfEnstrophy : ℝ → ℝ := fun time ↦
    finiteStateVorticityHalfEnstrophy modes (trajectory time)
  let exactRate : ℝ → ℝ := fun time ↦
    finiteStateVorticityStretchingWork modes (trajectory time) -
      ν.coeff * (2 * Real.pi) ^ 2 *
        finiteStateVorticityEnstrophyMass modes (trajectory time)
  have bounded := finiteStateVorticity_sourceOwnedWholeStateBarrier_on_Icc
    modes negClosed ν ceiling trajectory b initialFits bLeDuration
      evolves reality transverse
  have halfDerivative :
      ∀ t ∈ Icc (0 : ℝ) b,
        HasDerivAt halfEnstrophy (exactRate t) t := by
    intro t tMem
    exact finiteStateVorticityHalfEnstrophy_hasDerivAt_stretchingWork
      modes negClosed ν.coeff trajectory t
      (evolves t tMem) (reality t tMem)
  have rateLe :
      ∀ t ∈ Icc (0 : ℝ) b, exactRate t ≤ slope := by
    intro t tMem
    have belowCeiling := (bounded t tMem).2
    have pointwise :=
      finiteStateVorticityHalfEnstrophy_hasDerivAt_and_le_sourceOwnedLocal
        modes negClosed ν ceiling trajectory t
        (evolves t tMem) (reality t tMem) (transverse t tMem)
        belowCeiling
    have gradientNonneg :
        0 ≤ (2 * Real.pi) ^ 2 *
          finiteStateVorticityEnstrophyMass modes (trajectory t) :=
      mul_nonneg (sq_nonneg _)
        (finiteStateVorticityEnstrophyMass_nonneg modes (trajectory t))
    have enstrophyNonneg :
        0 ≤ finiteStateVorticityCoefficientEnstrophy
          modes (trajectory t) := by
      unfold finiteStateVorticityCoefficientEnstrophy
      exact Finset.sum_nonneg fun wave _waveMem ↦
        complexCoordinateAmplitudeSq_nonneg (trajectory t wave)
    have ceilingNonneg : 0 ≤ ceiling :=
      enstrophyNonneg.trans belowCeiling
    have squareLe :
        finiteStateVorticityCoefficientEnstrophy
              modes (trajectory t) ^ 2 ≤ ceiling ^ 2 :=
      (sq_le_sq₀ enstrophyNonneg ceilingNonneg).2 belowCeiling
    have coefficientNonneg :
        0 ≤ sourceOwnedLocalQuadraticCoefficient ν ceiling :=
      sourceOwnedLocalQuadraticCoefficient_nonneg ν ceiling
    have viscousCoefficientNonneg : 0 ≤ 3 * ν.coeff / 8 :=
      div_nonneg (mul_nonneg (by norm_num) ν.coeff_pos.le) (by norm_num)
    have viscousTermNonpos :
        -(3 * ν.coeff / 8) *
            ((2 * Real.pi) ^ 2 *
              finiteStateVorticityEnstrophyMass modes (trajectory t)) ≤ 0 :=
      mul_nonpos_of_nonpos_of_nonneg
        (neg_nonpos.mpr viscousCoefficientNonneg) gradientNonneg
    calc
      exactRate t ≤
          -(3 * ν.coeff / 8) *
              ((2 * Real.pi) ^ 2 *
                finiteStateVorticityEnstrophyMass modes (trajectory t)) +
            sourceOwnedLocalQuadraticCoefficient ν ceiling *
              finiteStateVorticityCoefficientEnstrophy
                modes (trajectory t) ^ 2 := pointwise.2
      _ ≤ sourceOwnedLocalQuadraticCoefficient ν ceiling *
            finiteStateVorticityCoefficientEnstrophy
              modes (trajectory t) ^ 2 :=
        add_le_of_nonpos_left viscousTermNonpos
      _ ≤ sourceOwnedLocalQuadraticCoefficient ν ceiling *
            ceiling ^ 2 :=
        mul_le_mul_of_nonneg_left squareLe coefficientNonneg
      _ ≤ slope := by
        dsimp only [slope, sourceOwnedWholeStateBarrierSlope]
        linarith
  let fenced : ℝ → ℝ := fun time ↦ halfEnstrophy time - slope * time
  have halfContinuous : ContinuousOn halfEnstrophy (Icc (0 : ℝ) b) :=
    HasDerivAt.continuousOn halfDerivative
  have fencedContinuous : ContinuousOn fenced (Icc (0 : ℝ) b) := by
    exact halfContinuous.sub
      ((continuous_const.mul continuous_id).continuousOn)
  have fencedDerivative :
      ∀ t ∈ Icc (0 : ℝ) b,
        HasDerivAt fenced (exactRate t - slope) t := by
    intro t tMem
    have linearDerivative :
        HasDerivAt (fun time : ℝ ↦ slope * time) slope t := by
      simpa only [id_eq, mul_one] using
        (hasDerivAt_id t).const_mul slope
    exact (halfDerivative t tMem).sub linearDerivative
  have fencedAntitone : AntitoneOn fenced (Icc (0 : ℝ) b) := by
    apply antitoneOn_of_hasDerivWithinAt_nonpos
      (convex_Icc (0 : ℝ) b) fencedContinuous
    · intro t tMem
      exact (fencedDerivative t (interior_subset tMem)).hasDerivWithinAt
    · intro t tMem
      have generated := rateLe t (interior_subset tMem)
      linarith
  have compared := fencedAntitone leftMem rightMem leftLeRight
  dsimp [fenced, halfEnstrophy] at compared
  unfold finiteStateVorticityHalfEnstrophy at compared
  linarith

/-- Averaging the ordered increment fence over an actual prefix turns its
terminal coefficient mass into a quantitative lower bound for the complete
unweighted vorticity payment.  The additive unit is exactly the unit of
headroom built into the source-owned barrier duration. -/
theorem finiteStateVorticity_terminal_sub_one_mul_time_le_integral
    (modes : Finset IntegerWavevector)
    (negClosed :
      ∀ wave, wave ∈ modes → waveNeg wave ∈ modes)
    (ν : Viscosity)
    (ceiling : ℝ)
    (trajectory : ℝ → ComplexVorticityHilbertState)
    (b : ℝ)
    (initialFits :
      finiteStateVorticityCoefficientEnstrophy
            modes (trajectory 0) + 1 ≤
        ceiling)
    (bLeDuration :
      b ≤ sourceOwnedWholeStateDuration ν ceiling)
    (evolves :
      ∀ t ∈ Icc (0 : ℝ) b,
        HasDerivAt trajectory
          (finiteStateVorticityGenerator
            modes ν.coeff (trajectory t)) t)
    (reality :
      ∀ t ∈ Icc (0 : ℝ) b,
        FiniteStateFourierReality (trajectory t))
    (transverse :
      ∀ t ∈ Icc (0 : ℝ) b,
        ∀ wave ∈ modes,
          complexWavevector wave ⬝ᵥ trajectory t wave = 0)
    (time : ℝ)
    (timeMem : time ∈ Icc (0 : ℝ) b) :
    time *
        (finiteStateVorticityCoefficientEnstrophy modes (trajectory time) - 1) ≤
      ∫ actual in (0 : ℝ)..time,
        finiteStateVorticityCoefficientEnstrophy modes (trajectory actual) := by
  let slope := sourceOwnedWholeStateBarrierSlope ν ceiling
  let mass : ℝ → ℝ := fun actual ↦
    finiteStateVorticityCoefficientEnstrophy modes (trajectory actual)
  have slopePos : 0 < slope := by
    simpa only [slope] using
      sourceOwnedWholeStateBarrierSlope_pos ν ceiling
  have denominatorPos : 0 < 2 * slope := mul_pos (by norm_num) slopePos
  have timeLeDuration :
      time ≤ sourceOwnedWholeStateDuration ν ceiling :=
    timeMem.2.trans bLeDuration
  have scaledTimeLe : time * (2 * slope) ≤ 1 := by
    apply (le_div_iff₀ denominatorPos).mp
    simpa only [sourceOwnedWholeStateDuration] using timeLeDuration
  have pointwise :
      ∀ actual ∈ Icc (0 : ℝ) time, mass time - 1 ≤ mass actual := by
    intro actual actualMem
    have actualMemB : actual ∈ Icc (0 : ℝ) b :=
      ⟨actualMem.1, actualMem.2.trans timeMem.2⟩
    have increment :=
      finiteStateVorticity_sourceOwnedWholeStateBarrier_increment_le
        modes negClosed ν ceiling trajectory b initialFits bLeDuration
          evolves reality transverse actual time actualMemB timeMem actualMem.2
    have intervalNonneg : 0 ≤ time - actual := sub_nonneg.mpr actualMem.2
    have intervalLeTime : time - actual ≤ time := by linarith [actualMem.1]
    have incrementUnitLe : 2 * slope * (time - actual) ≤ 1 := by
      calc
        2 * slope * (time - actual) ≤ 2 * slope * time :=
          mul_le_mul_of_nonneg_left intervalLeTime
            (mul_nonneg (by norm_num) slopePos.le)
        _ = time * (2 * slope) := by ring
        _ ≤ 1 := scaledTimeLe
    dsimp only [mass]
    linarith
  have trajectoryContinuous : ContinuousOn trajectory (Icc (0 : ℝ) b) :=
    HasDerivAt.continuousOn evolves
  have massContinuous : ContinuousOn mass (Icc (0 : ℝ) time) := by
    let halfMass : ℝ → ℝ := fun actual ↦
      finiteStateVorticityHalfEnstrophy modes (trajectory actual)
    have halfDerivative :
        ∀ actual ∈ Icc (0 : ℝ) b,
          HasDerivAt halfMass
            (finiteStateVorticityStretchingWork modes (trajectory actual) -
              ν.coeff * (2 * Real.pi) ^ 2 *
                finiteStateVorticityEnstrophyMass
                  modes (trajectory actual)) actual := by
      intro actual actualMem
      exact finiteStateVorticityHalfEnstrophy_hasDerivAt_stretchingWork
        modes negClosed ν.coeff trajectory actual
          (evolves actual actualMem) (reality actual actualMem)
    have halfContinuous : ContinuousOn halfMass (Icc (0 : ℝ) time) :=
      (HasDerivAt.continuousOn halfDerivative).mono fun actual actualMem ↦
        ⟨actualMem.1, actualMem.2.trans timeMem.2⟩
    have scaledContinuous :
        ContinuousOn (fun actual ↦ 2 * halfMass actual) (Icc (0 : ℝ) time) :=
      continuousOn_const.mul halfContinuous
    have massEq : mass = fun actual ↦ 2 * halfMass actual := by
      funext actual
      dsimp only [mass, halfMass, finiteStateVorticityHalfEnstrophy]
      ring
    rw [massEq]
    exact scaledContinuous
  have integrated := intervalIntegral.integral_mono_on
    (μ := MeasureTheory.volume) timeMem.1
    (continuous_const.intervalIntegrable 0 time)
    (massContinuous.intervalIntegrable_of_Icc timeMem.1)
    pointwise
  simp only [mass, intervalIntegral.integral_const, smul_eq_mul,
    sub_zero] at integrated
  calc
    time *
          (finiteStateVorticityCoefficientEnstrophy
              modes (trajectory time) - 1) =
        time * finiteStateVorticityCoefficientEnstrophy
            modes (trajectory time) - time := by ring
    _ ≤ ∫ actual in (0 : ℝ)..time,
          finiteStateVorticityCoefficientEnstrophy
            modes (trajectory actual) := by linarith

end

end
    ThreeDimensionalVorticityCoefficientWholeStateSourceOwnedLocalBarrier
end NavierStokes
