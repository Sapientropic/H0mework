import Mathlib.Data.Fintype.Pi
import H0mework.NavierStokes.Fourier.FixedOutputNonlinearContinuity

/-!
# Infinite fixed-output nonlinear Fourier rows

At one fixed output frequency, the three-dimensional vorticity nonlinearity
is an absolutely summable convolution row on the actual whole
`ℓ²(ℤ³; ℂ³)` Fourier carrier.  This module defines that row directly by
`tsum` and proves:

* a cutoff-independent bilinear estimate in the ambient Hilbert norm;
* local Lipschitz continuity on the whole transverse carrier;
* exact agreement with the existing finite Galerkin row after sharp support
  projection;
* convergence of the finite rows along the canonical integer frequency
  cubes to the infinite row.

Thus the nonlinear passage is no longer tied to a caller-supplied finite
support witness.  Transversality remains a property of the actual whole
state, while summability and exhaustion are derived from the carrier itself.
The module does not assume a target limit, compactness witness, tail-silence
certificate, or continuation conclusion.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalVorticityCoefficientInfiniteFixedOutputNonlinearRow

open scoped BigOperators ENNReal Matrix Topology

open Filter
open Matrix
open ThreeDimensionalPeriodicCoarseFilterCore
open ThreeDimensionalPeriodicIntegerCharacterCoarseFilter
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientStretchingPairTable
open ThreeDimensionalVorticityCoefficientGeneratedShellSerrinGeometry
open ThreeDimensionalVorticityCoefficientFiniteSupportComplexTrajectory
open ThreeDimensionalVorticityCoefficientFiniteGalerkinAmbientNorm
open ThreeDimensionalVorticityCoefficientFiniteGalerkinNonlinearNegativeSobolev
open ThreeDimensionalVorticityCoefficientFixedOutputNonlinearContinuity

noncomputable section

/-- Transversality on every row of the actual whole Fourier carrier. -/
def WholeStateTransverse
    (state : ComplexVorticityHilbertState) : Prop :=
  ∀ wave : IntegerWavevector,
    complexWavevector wave ⬝ᵥ state wave = 0

theorem wholeStateTransverse_sub
    (left right : ComplexVorticityHilbertState)
    (leftTransverse : WholeStateTransverse left)
    (rightTransverse : WholeStateTransverse right) :
    WholeStateTransverse (left - right) := by
  intro wave
  simp [dotProduct_sub, leftTransverse wave, rightTransverse wave]

/-- Translation/reflection of the first input index at one fixed output. -/
def outputSubEquiv
    (output : IntegerWavevector) :
    IntegerWavevector ≃ IntegerWavevector where
  toFun first := output - first
  invFun second := output - second
  left_inv first := by
    ext coordinate
    simp
  right_inv second := by
    ext coordinate
    simp

@[simp] theorem outputSubEquiv_apply
    (output first : IntegerWavevector) :
    outputSubEquiv output first = output - first :=
  rfl

/-- Whole Euclidean coefficient mass.  Finiteness is generated by the
ambient `ℓ²(ℤ³; ℂ³_sup)` carrier, with only the fixed three-coordinate
comparison factor. -/
def wholeVorticityEuclideanMass
    (state : ComplexVorticityHilbertState) : ℝ :=
  ∑' wave : IntegerWavevector,
    vorticityRowAmplitude state wave ^ 2

theorem complexCoordinateAmplitudeSq_le_three_mul_norm_sq
    (vector : ComplexCoordinateVector) :
    complexCoordinateAmplitudeSq vector ≤
      3 * ‖vector‖ ^ 2 := by
  unfold complexCoordinateAmplitudeSq
  calc
    (∑ coordinate : Coordinate,
        Complex.normSq (vector coordinate)) ≤
        ∑ _coordinate : Coordinate, ‖vector‖ ^ 2 := by
      apply Finset.sum_le_sum
      intro coordinate coordinateMem
      rw [Complex.normSq_eq_norm_sq]
      exact
        (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mpr
          (norm_le_pi_norm vector coordinate)
    _ = 3 * ‖vector‖ ^ 2 := by
      norm_num [Fin.sum_univ_succ]

theorem summable_vorticityRowAmplitude_sq
    (state : ComplexVorticityHilbertState) :
    Summable fun wave : IntegerWavevector =>
      vorticityRowAmplitude state wave ^ 2 := by
  have normSqSummable :
      Summable fun wave : IntegerWavevector =>
        ‖state wave‖ ^ 2 := by
    simpa using
      (lp.hasSum_norm (p := (2 : ℝ≥0∞))
        (by norm_num) state).summable
  apply (normSqSummable.mul_left 3).of_nonneg_of_le
  · intro wave
    exact sq_nonneg _
  · intro wave
    rw [vorticityRowAmplitude_sq]
    exact complexCoordinateAmplitudeSq_le_three_mul_norm_sq
      (state wave)

theorem wholeVorticityEuclideanMass_le_three_mul_norm_sq
    (state : ComplexVorticityHilbertState) :
    wholeVorticityEuclideanMass state ≤
      3 * ‖state‖ ^ 2 := by
  have normSqSummable :
      Summable fun wave : IntegerWavevector =>
        ‖state wave‖ ^ 2 := by
    simpa using
      (lp.hasSum_norm (p := (2 : ℝ≥0∞))
        (by norm_num) state).summable
  have normIdentity :
      ‖state‖ ^ 2 =
        ∑' wave : IntegerWavevector,
          ‖state wave‖ ^ 2 := by
    simpa using
      (lp.norm_rpow_eq_tsum
        (p := (2 : ℝ≥0∞)) (by norm_num) state)
  unfold wholeVorticityEuclideanMass
  calc
    (∑' wave : IntegerWavevector,
        vorticityRowAmplitude state wave ^ 2) ≤
        ∑' wave : IntegerWavevector,
          3 * ‖state wave‖ ^ 2 :=
      Summable.tsum_le_tsum
        (fun wave => by
          rw [vorticityRowAmplitude_sq]
          exact
            complexCoordinateAmplitudeSq_le_three_mul_norm_sq
              (state wave))
        (summable_vorticityRowAmplitude_sq state)
        (normSqSummable.mul_left 3)
    _ =
        3 * ∑' wave : IntegerWavevector,
          ‖state wave‖ ^ 2 := by
      rw [tsum_mul_left]
    _ = 3 * ‖state‖ ^ 2 := by
      rw [← normIdentity]

theorem summable_fixedOutputVorticityAmplitudeProduct
    (left right : ComplexVorticityHilbertState)
    (output : IntegerWavevector) :
    Summable fun first : IntegerWavevector =>
      vorticityRowAmplitude left first *
        vorticityRowAmplitude right (output - first) := by
  have rightSqSummable :
      Summable fun first : IntegerWavevector =>
        vorticityRowAmplitude right (output - first) ^ 2 := by
    exact
      ((outputSubEquiv output).summable_iff).2
        (summable_vorticityRowAmplitude_sq right)
  exact
    (Real.summable_and_inner_le_Lp_mul_Lq_tsum_of_nonneg
      Real.HolderConjugate.two_two
      (vorticityRowAmplitude_nonneg left)
      (fun first =>
        vorticityRowAmplitude_nonneg right (output - first))
      (by
        simpa [Real.rpow_two] using
          summable_vorticityRowAmplitude_sq left)
      (by
        simpa [Real.rpow_two] using rightSqSummable)).1

theorem tsum_fixedOutputVorticityAmplitudeProduct_le_mass
    (left right : ComplexVorticityHilbertState)
    (output : IntegerWavevector) :
    (∑' first : IntegerWavevector,
        vorticityRowAmplitude left first *
          vorticityRowAmplitude right (output - first)) ≤
      Real.sqrt (wholeVorticityEuclideanMass left) *
        Real.sqrt (wholeVorticityEuclideanMass right) := by
  have rightSqSummable :
      Summable fun first : IntegerWavevector =>
        vorticityRowAmplitude right (output - first) ^ 2 := by
    exact
      ((outputSubEquiv output).summable_iff).2
        (summable_vorticityRowAmplitude_sq right)
  have cauchy :=
    (Real.summable_and_inner_le_Lp_mul_Lq_tsum_of_nonneg
      Real.HolderConjugate.two_two
      (vorticityRowAmplitude_nonneg left)
      (fun first =>
        vorticityRowAmplitude_nonneg right (output - first))
      (by
        simpa [Real.rpow_two] using
          summable_vorticityRowAmplitude_sq left)
      (by
        simpa [Real.rpow_two] using rightSqSummable)).2
  have shiftedMass :
      (∑' first : IntegerWavevector,
        vorticityRowAmplitude right (output - first) ^ 2) =
        wholeVorticityEuclideanMass right := by
    exact (outputSubEquiv output).tsum_eq
      (fun wave =>
        vorticityRowAmplitude right wave ^ 2)
  simpa [Real.rpow_two, one_div, wholeVorticityEuclideanMass,
    shiftedMass, Real.sqrt_eq_rpow] using cauchy

theorem tsum_fixedOutputVorticityAmplitudeProduct_le_three_mul_norm
    (left right : ComplexVorticityHilbertState)
    (output : IntegerWavevector) :
    (∑' first : IntegerWavevector,
        vorticityRowAmplitude left first *
          vorticityRowAmplitude right (output - first)) ≤
      3 * ‖left‖ * ‖right‖ := by
  have leftSqrtBound :
      Real.sqrt (wholeVorticityEuclideanMass left) ≤
        Real.sqrt 3 * ‖left‖ := by
    calc
      Real.sqrt (wholeVorticityEuclideanMass left) ≤
          Real.sqrt (3 * ‖left‖ ^ 2) :=
        Real.sqrt_le_sqrt
          (wholeVorticityEuclideanMass_le_three_mul_norm_sq left)
      _ = Real.sqrt 3 * ‖left‖ := by
        rw [Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 3)]
        rw [Real.sqrt_sq (norm_nonneg left)]
  have rightSqrtBound :
      Real.sqrt (wholeVorticityEuclideanMass right) ≤
        Real.sqrt 3 * ‖right‖ := by
    calc
      Real.sqrt (wholeVorticityEuclideanMass right) ≤
          Real.sqrt (3 * ‖right‖ ^ 2) :=
        Real.sqrt_le_sqrt
          (wholeVorticityEuclideanMass_le_three_mul_norm_sq right)
      _ = Real.sqrt 3 * ‖right‖ := by
        rw [Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 3)]
        rw [Real.sqrt_sq (norm_nonneg right)]
  calc
    (∑' first : IntegerWavevector,
        vorticityRowAmplitude left first *
          vorticityRowAmplitude right (output - first)) ≤
        Real.sqrt (wholeVorticityEuclideanMass left) *
          Real.sqrt (wholeVorticityEuclideanMass right) :=
      tsum_fixedOutputVorticityAmplitudeProduct_le_mass
        left right output
    _ ≤
        (Real.sqrt 3 * ‖left‖) *
          (Real.sqrt 3 * ‖right‖) :=
      mul_le_mul leftSqrtBound rightSqrtBound
        (Real.sqrt_nonneg _) (by positivity)
    _ =
        (Real.sqrt 3 * Real.sqrt 3) *
          (‖left‖ * ‖right‖) := by
      ring
    _ = 3 * ‖left‖ * ‖right‖ := by
      rw [show Real.sqrt 3 * Real.sqrt 3 = (3 : ℝ) by
        nlinarith [Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 3)]]
      ring

/-- Infinite fixed-output bilinear Fourier row on the actual whole carrier. -/
def wholeStateVorticityBilinearCoefficientAt
    (left right : ComplexVorticityHilbertState)
    (output : IntegerWavevector) : ComplexCoordinateVector :=
  ∑' first : IntegerWavevector,
    finiteStateVorticityBilinearPairContribution
      left right (first, output - first)

private theorem finiteStateVorticityBilinearCoefficientAt_eq_reducedSum
    (modes : Finset IntegerWavevector)
    (left right : ComplexVorticityHilbertState)
    (output : IntegerWavevector) :
    finiteStateVorticityBilinearCoefficientAt modes left right output =
      ∑ first ∈ modes,
        if output - first ∈ modes then
          finiteStateVorticityBilinearPairContribution
            left right (first, output - first)
        else 0 := by
  unfold finiteStateVorticityBilinearCoefficientAt
  apply Finset.sum_congr rfl
  intro first firstMem
  have incidence : ∀ second : IntegerWavevector,
      first + second = output ↔ second = output - first := by
    intro second
    constructor <;> intro equality
    · rw [← equality]
      abel
    · rw [equality]
      abel
  simp_rw [incidence]
  by_cases secondMem : output - first ∈ modes
  · simp [secondMem]
  · simp [secondMem]

/-- A complete whole bilinear row on two finitely supported states is
exactly its finite double-convolution presentation. -/
theorem wholeStateVorticityBilinearCoefficientAt_eq_finite_of_supported
    (modes : Finset IntegerWavevector)
    (left right : ComplexVorticityHilbertState)
    (leftSupported : ∀ wave : IntegerWavevector,
      wave ∉ modes → left wave = 0)
    (rightSupported : ∀ wave : IntegerWavevector,
      wave ∉ modes → right wave = 0)
    (output : IntegerWavevector) :
    wholeStateVorticityBilinearCoefficientAt left right output =
      finiteStateVorticityBilinearCoefficientAt
        modes left right output := by
  rw [wholeStateVorticityBilinearCoefficientAt,
    tsum_eq_sum (s := modes)]
  · rw [finiteStateVorticityBilinearCoefficientAt_eq_reducedSum]
    apply Finset.sum_congr rfl
    intro first firstMem
    by_cases translatedMem : output - first ∈ modes
    · simp [translatedMem]
    · rw [if_neg translatedMem]
      simp [finiteStateVorticityBilinearPairContribution,
        finiteStateVelocityCoefficient,
        rightSupported (output - first) translatedMem]
  · intro first firstNotMem
    simp [finiteStateVorticityBilinearPairContribution,
      finiteStateVelocityCoefficient, leftSupported first firstNotMem]

theorem summable_norm_wholeStateVorticityBilinearPair
    (left right : ComplexVorticityHilbertState)
    (leftTransverse : WholeStateTransverse left)
    (output : IntegerWavevector) :
    Summable fun first : IntegerWavevector =>
      ‖finiteStateVorticityBilinearPairContribution
        left right (first, output - first)‖ := by
  let angular : ℝ :=
    2 * Real.sqrt (integerWaveNormSq output)
  have productSummable :=
    summable_fixedOutputVorticityAmplitudeProduct
      left right output
  apply (productSummable.mul_left angular).of_nonneg_of_le
  · intro first
    exact norm_nonneg _
  · intro first
    have incidence : first + (output - first) = output := by
      abel
    simpa [angular, mul_assoc] using
      finiteStateVorticityBilinearPairContribution_norm_le
        left right output first (output - first)
        incidence (leftTransverse first)

theorem summable_wholeStateVorticityBilinearPair
    (left right : ComplexVorticityHilbertState)
    (leftTransverse : WholeStateTransverse left)
    (output : IntegerWavevector) :
    Summable fun first : IntegerWavevector =>
      finiteStateVorticityBilinearPairContribution
        left right (first, output - first) :=
  (summable_norm_wholeStateVorticityBilinearPair
    left right leftTransverse output).of_norm

/-- Absolute fixed-output pair mass obeys the same cutoff-independent whole
carrier bound as the aggregated row.  This is the pre-quotient estimate used
to justify time/pair Fubini on actual occurrence tables. -/
theorem tsum_norm_wholeStateVorticityBilinearPair_le
    (left right : ComplexVorticityHilbertState)
    (leftTransverse : WholeStateTransverse left)
    (output : IntegerWavevector) :
    (∑' first : IntegerWavevector,
        ‖finiteStateVorticityBilinearPairContribution
          left right (first, output - first)‖) ≤
      6 * Real.sqrt (integerWaveNormSq output) *
        ‖left‖ * ‖right‖ := by
  let angular : ℝ :=
    2 * Real.sqrt (integerWaveNormSq output)
  have angularNonneg : 0 ≤ angular := by
    dsimp [angular]
    positivity
  have normSummable :=
    summable_norm_wholeStateVorticityBilinearPair
      left right leftTransverse output
  have productSummable :=
    summable_fixedOutputVorticityAmplitudeProduct
      left right output
  calc
    (∑' first : IntegerWavevector,
        ‖finiteStateVorticityBilinearPairContribution
          left right (first, output - first)‖) ≤
        ∑' first : IntegerWavevector,
          angular *
            (vorticityRowAmplitude left first *
              vorticityRowAmplitude right (output - first)) := by
      exact Summable.tsum_le_tsum
        (fun first => by
          have incidence : first + (output - first) = output := by
            abel
          simpa [angular, mul_assoc] using
            finiteStateVorticityBilinearPairContribution_norm_le
              left right output first (output - first)
              incidence (leftTransverse first))
        normSummable
        (productSummable.mul_left angular)
    _ = angular *
          ∑' first : IntegerWavevector,
            vorticityRowAmplitude left first *
              vorticityRowAmplitude right (output - first) := by
      rw [tsum_mul_left]
    _ ≤ angular * (3 * ‖left‖ * ‖right‖) :=
      mul_le_mul_of_nonneg_left
        (tsum_fixedOutputVorticityAmplitudeProduct_le_three_mul_norm
          left right output)
        angularNonneg
    _ = 6 * Real.sqrt (integerWaveNormSq output) *
          ‖left‖ * ‖right‖ := by
      dsimp [angular]
      ring

theorem wholeStateVorticityBilinearCoefficientAt_norm_le
    (left right : ComplexVorticityHilbertState)
    (leftTransverse : WholeStateTransverse left)
    (output : IntegerWavevector) :
    ‖wholeStateVorticityBilinearCoefficientAt
        left right output‖ ≤
      6 * Real.sqrt (integerWaveNormSq output) *
        ‖left‖ * ‖right‖ := by
  have normSummable :=
    summable_norm_wholeStateVorticityBilinearPair
      left right leftTransverse output
  exact (norm_tsum_le_tsum_norm normSummable).trans
    (tsum_norm_wholeStateVorticityBilinearPair_le
      left right leftTransverse output)

/-- Infinite quadratic vorticity row at one fixed output frequency. -/
def wholeStateVorticityNonlinearCoefficientAt
    (state : ComplexVorticityHilbertState)
    (output : IntegerWavevector) : ComplexCoordinateVector :=
  ∑' first : IntegerWavevector,
    finiteStateVorticityNonlinearPairContribution
      state (first, output - first)

theorem bilinearPair_self_eq_nonlinearPair
    (state : ComplexVorticityHilbertState)
    (pair : StretchingPair) :
    finiteStateVorticityBilinearPairContribution
        state state pair =
      finiteStateVorticityNonlinearPairContribution state pair :=
  rfl

theorem wholeStateVorticityBilinearCoefficientAt_self
    (state : ComplexVorticityHilbertState)
    (output : IntegerWavevector) :
    wholeStateVorticityBilinearCoefficientAt state state output =
      wholeStateVorticityNonlinearCoefficientAt state output := by
  apply tsum_congr
  intro first
  exact bilinearPair_self_eq_nonlinearPair
    state (first, output - first)

theorem summable_wholeStateVorticityNonlinearPair
    (state : ComplexVorticityHilbertState)
    (stateTransverse : WholeStateTransverse state)
    (output : IntegerWavevector) :
    Summable fun first : IntegerWavevector =>
      finiteStateVorticityNonlinearPairContribution
        state (first, output - first) := by
  simpa only [← bilinearPair_self_eq_nonlinearPair] using
    summable_wholeStateVorticityBilinearPair
      state state stateTransverse output

theorem wholeStateVorticityNonlinearCoefficientAt_sub
    (left right : ComplexVorticityHilbertState)
    (leftTransverse : WholeStateTransverse left)
    (rightTransverse : WholeStateTransverse right)
    (output : IntegerWavevector) :
    wholeStateVorticityNonlinearCoefficientAt left output -
        wholeStateVorticityNonlinearCoefficientAt right output =
      wholeStateVorticityBilinearCoefficientAt
          (left - right) left output +
        wholeStateVorticityBilinearCoefficientAt
          right (left - right) output := by
  have leftSummable :=
    summable_wholeStateVorticityNonlinearPair
      left leftTransverse output
  have rightSummable :=
    summable_wholeStateVorticityNonlinearPair
      right rightTransverse output
  have differenceTransverse :=
    wholeStateTransverse_sub
      left right leftTransverse rightTransverse
  have firstBilinearSummable :=
    summable_wholeStateVorticityBilinearPair
      (left - right) left differenceTransverse output
  have secondBilinearSummable :=
    summable_wholeStateVorticityBilinearPair
      right (left - right) rightTransverse output
  unfold wholeStateVorticityNonlinearCoefficientAt
    wholeStateVorticityBilinearCoefficientAt
  rw [← leftSummable.tsum_sub rightSummable]
  rw [← firstBilinearSummable.tsum_add secondBilinearSummable]
  apply tsum_congr
  intro first
  exact
    finiteStateVorticityNonlinearPairContribution_sub
      left right (first, output - first)

theorem wholeStateVorticityNonlinearCoefficientAt_sub_norm_le
    (left right : ComplexVorticityHilbertState)
    (leftTransverse : WholeStateTransverse left)
    (rightTransverse : WholeStateTransverse right)
    (output : IntegerWavevector) :
    ‖wholeStateVorticityNonlinearCoefficientAt left output -
        wholeStateVorticityNonlinearCoefficientAt right output‖ ≤
      6 * Real.sqrt (integerWaveNormSq output) *
        ‖left - right‖ * (‖left‖ + ‖right‖) := by
  rw [wholeStateVorticityNonlinearCoefficientAt_sub
    left right leftTransverse rightTransverse output]
  calc
    ‖wholeStateVorticityBilinearCoefficientAt
          (left - right) left output +
        wholeStateVorticityBilinearCoefficientAt
          right (left - right) output‖ ≤
        ‖wholeStateVorticityBilinearCoefficientAt
          (left - right) left output‖ +
        ‖wholeStateVorticityBilinearCoefficientAt
          right (left - right) output‖ :=
      norm_add_le _ _
    _ ≤
        6 * Real.sqrt (integerWaveNormSq output) *
              ‖left - right‖ * ‖left‖ +
          6 * Real.sqrt (integerWaveNormSq output) *
              ‖right‖ * ‖left - right‖ :=
      add_le_add
        (wholeStateVorticityBilinearCoefficientAt_norm_le
          (left - right) left
          (wholeStateTransverse_sub
            left right leftTransverse rightTransverse)
          output)
        (wholeStateVorticityBilinearCoefficientAt_norm_le
          right (left - right) rightTransverse output)
    _ =
        6 * Real.sqrt (integerWaveNormSq output) *
          ‖left - right‖ * (‖left‖ + ‖right‖) := by
      ring

/-- The whole transverse Fourier carrier as the genuine domain of the
fixed-row nonlinear observer. -/
abbrev WholeTransverseVorticityState :=
  {state : ComplexVorticityHilbertState //
    WholeStateTransverse state}

theorem tendsto_wholeStateVorticityNonlinearCoefficientAt
    {α : Type*}
    {filter : Filter α}
    (states : α → ComplexVorticityHilbertState)
    (limit : ComplexVorticityHilbertState)
    (statesTransverse :
      ∀ index, WholeStateTransverse (states index))
    (limitTransverse : WholeStateTransverse limit)
    (statesTendsto : Filter.Tendsto states filter (𝓝 limit))
    (output : IntegerWavevector) :
    Filter.Tendsto
      (fun index =>
        wholeStateVorticityNonlinearCoefficientAt
          (states index) output)
      filter
      (𝓝
        (wholeStateVorticityNonlinearCoefficientAt
          limit output)) := by
  apply tendsto_iff_dist_tendsto_zero.mpr
  let angular : ℝ :=
    6 * Real.sqrt (integerWaveNormSq output)
  have differenceNormTends :
      Filter.Tendsto
        (fun index => ‖states index - limit‖)
        filter (𝓝 0) := by
    simpa using
      (statesTendsto.sub
        (tendsto_const_nhds :
          Filter.Tendsto
            (fun _ : α => limit) filter (𝓝 limit))).norm
  have stateNormSumTends :
      Filter.Tendsto
        (fun index => ‖states index‖ + ‖limit‖)
        filter (𝓝 (‖limit‖ + ‖limit‖)) :=
    statesTendsto.norm.add tendsto_const_nhds
  have boundTends :
      Filter.Tendsto
        (fun index =>
          angular * ‖states index - limit‖ *
            (‖states index‖ + ‖limit‖))
        filter (𝓝 0) := by
    simpa using
      ((tendsto_const_nhds.mul differenceNormTends).mul
        stateNormSumTends)
  exact squeeze_zero
    (g := fun index =>
      angular * ‖states index - limit‖ *
        (‖states index‖ + ‖limit‖))
    (fun _ => dist_nonneg)
    (fun index => by
      rw [dist_eq_norm]
      simpa [angular] using
        wholeStateVorticityNonlinearCoefficientAt_sub_norm_le
          (states index) limit
          (statesTransverse index) limitTransverse output)
    boundTends

theorem wholeStateVorticityNonlinearCoefficientAt_continuous
    (output : IntegerWavevector) :
    Continuous
      (fun state : WholeTransverseVorticityState =>
        wholeStateVorticityNonlinearCoefficientAt
          state.1 output) := by
  rw [continuous_iff_continuousAt]
  intro state
  exact
    tendsto_wholeStateVorticityNonlinearCoefficientAt
      (fun later : WholeTransverseVorticityState => later.1)
      state.1
      (fun later => later.2)
      state.2
      continuousAt_subtype_val
      output

theorem wholeStateTransverse_projection
    (modes : Finset IntegerWavevector)
    (state : ComplexVorticityHilbertState)
    (stateTransverse : WholeStateTransverse state) :
    WholeStateTransverse
      (complexSharpSupportProjection modes state) := by
  intro wave
  by_cases waveMem : wave ∈ modes
  · simp [complexSharpSupportProjection_apply, waveMem,
      stateTransverse wave]
  · simp [complexSharpSupportProjection_apply, waveMem]

theorem finiteStateVorticityNonlinearCoefficientAt_eq_reducedSum
    (modes : Finset IntegerWavevector)
    (state : ComplexVorticityHilbertState)
    (output : IntegerWavevector) :
    finiteStateVorticityNonlinearCoefficientAt modes state output =
      ∑ first ∈ modes,
        if output - first ∈ modes then
          finiteStateVorticityNonlinearPairContribution
            state (first, output - first)
        else 0 := by
  unfold finiteStateVorticityNonlinearCoefficientAt
  apply Finset.sum_congr rfl
  intro first firstMem
  have condition :
      ∀ second : IntegerWavevector,
        first + second = output ↔
          second = output - first := by
    intro second
    constructor <;> intro equality
    · rw [← equality]
      abel
    · rw [equality]
      abel
  simp_rw [condition]
  by_cases translatedMem : output - first ∈ modes
  · simp [translatedMem]
  · simp [translatedMem]

theorem wholeStateVorticityNonlinearCoefficientAt_projection_eq_finite
    (modes : Finset IntegerWavevector)
    (state : ComplexVorticityHilbertState)
    (output : IntegerWavevector) :
    wholeStateVorticityNonlinearCoefficientAt
        (complexSharpSupportProjection modes state) output =
      finiteStateVorticityNonlinearCoefficientAt
        modes state output := by
  rw [wholeStateVorticityNonlinearCoefficientAt,
    tsum_eq_sum (s := modes)]
  · rw [finiteStateVorticityNonlinearCoefficientAt_eq_reducedSum]
    apply Finset.sum_congr rfl
    intro first firstMem
    by_cases translatedMem : output - first ∈ modes
    · simp [translatedMem,
        finiteStateVorticityNonlinearPairContribution,
        finiteStateVelocityCoefficient,
        complexSharpSupportProjection_apply, firstMem]
    · simp [translatedMem,
        finiteStateVorticityNonlinearPairContribution,
        finiteStateVelocityCoefficient,
        complexSharpSupportProjection_apply, firstMem]
  · intro first firstNotMem
    apply finiteStateVorticityNonlinearPairContribution_zero_first
    simp [complexSharpSupportProjection_apply, firstNotMem]

theorem wholeStateVorticityNonlinearCoefficientAt_eq_finite_of_supported
    (modes : Finset IntegerWavevector)
    (state : ComplexVorticityHilbertState)
    (supported :
      ∀ wave : IntegerWavevector,
        wave ∉ modes → state wave = 0)
    (output : IntegerWavevector) :
    wholeStateVorticityNonlinearCoefficientAt state output =
      finiteStateVorticityNonlinearCoefficientAt
        modes state output := by
  have projectionEq :
      complexSharpSupportProjection modes state = state := by
    ext wave
    by_cases waveMem : wave ∈ modes
    · simp [complexSharpSupportProjection_apply, waveMem]
    · simp [complexSharpSupportProjection_apply, waveMem,
        supported wave waveMem]
  calc
    wholeStateVorticityNonlinearCoefficientAt state output =
        wholeStateVorticityNonlinearCoefficientAt
          (complexSharpSupportProjection modes state) output := by
      rw [projectionEq]
    _ =
        finiteStateVorticityNonlinearCoefficientAt
          modes state output :=
      wholeStateVorticityNonlinearCoefficientAt_projection_eq_finite
        modes state output

/-- Canonical finite cube exhausting the integer Fourier lattice. -/
def integerWaveFrequencyCube
    (radius : ℕ) : Finset IntegerWavevector :=
  Fintype.piFinset fun _ : Coordinate =>
    Finset.Icc (-(radius : ℤ)) (radius : ℤ)

/-- Source-free radius of one concrete integer wave. -/
def integerWaveCoordinateRadius
    (wave : IntegerWavevector) : ℕ :=
  Finset.univ.sup fun coordinate : Coordinate =>
    Int.natAbs (wave coordinate)

theorem integerWave_mem_frequencyCube_of_radius_le
    (wave : IntegerWavevector)
    (radius : ℕ)
    (radiusLe : integerWaveCoordinateRadius wave ≤ radius) :
    wave ∈ integerWaveFrequencyCube radius := by
  rw [integerWaveFrequencyCube, Fintype.mem_piFinset]
  intro coordinate
  rw [Finset.mem_Icc]
  have coordinateAbsLe :
      Int.natAbs (wave coordinate) ≤
        integerWaveCoordinateRadius wave :=
    Finset.le_sup
      (f := fun coordinate : Coordinate =>
        Int.natAbs (wave coordinate))
      (Finset.mem_univ coordinate)
  have coordinateAbsLeRadius :
      Int.natAbs (wave coordinate) ≤ radius :=
    coordinateAbsLe.trans radiusLe
  have coordinateAbsCastLe :
      (Int.natAbs (wave coordinate) : ℤ) ≤ radius := by
    exact_mod_cast coordinateAbsLeRadius
  have upper :
      wave coordinate ≤ (radius : ℤ) :=
    Int.le_natAbs.trans coordinateAbsCastLe
  have negWaveLeAbs :
      -wave coordinate ≤
        (Int.natAbs (wave coordinate) : ℤ) := by
    simpa only [Int.natAbs_neg] using
      (Int.le_natAbs (a := -wave coordinate))
  constructor
  · nlinarith
  · exact upper

theorem integerWave_eventually_mem_frequencyCube
    (wave : IntegerWavevector) :
    ∀ᶠ radius : ℕ in atTop,
      wave ∈ integerWaveFrequencyCube radius := by
  apply eventually_atTop.2
  exact
    ⟨integerWaveCoordinateRadius wave,
      fun radius radiusLe =>
        integerWave_mem_frequencyCube_of_radius_le
          wave radius radiusLe⟩

theorem integerWaveFrequencyCube_tendsto_atTop :
    Filter.Tendsto integerWaveFrequencyCube atTop atTop := by
  apply tendsto_atTop.2
  intro modes
  change
    ∀ᶠ radius : ℕ in atTop,
      ∀ wave ∈ modes,
        wave ∈ integerWaveFrequencyCube radius
  rw [Finset.eventually_all]
  intro wave waveMem
  exact integerWave_eventually_mem_frequencyCube wave

theorem sum_single_eq_complexSharpSupportProjection
    (modes : Finset IntegerWavevector)
    (state : ComplexVorticityHilbertState) :
    (∑ wave ∈ modes,
        lp.single (2 : ℝ≥0∞) wave (state wave)) =
      complexSharpSupportProjection modes state := by
  ext wave coordinate
  simp only [lp.coeFn_sum, Finset.sum_apply,
    lp.coeFn_single, complexSharpSupportProjection_apply]
  simpa only [Finset.sum_apply] using
    congrFun
      (Finset.sum_pi_single wave
        (fun index : IntegerWavevector => state index)
        modes)
      coordinate

theorem complexSharpSupportProjection_frequencyCube_tendsto
    (state : ComplexVorticityHilbertState) :
    Filter.Tendsto
      (fun radius =>
        complexSharpSupportProjection
          (integerWaveFrequencyCube radius) state)
      atTop
      (𝓝 state) := by
  have canonicalHasSum :=
    lp.hasSum_single
      (p := (2 : ℝ≥0∞)) (by simp) state
  change
    Filter.Tendsto
      (fun modes : Finset IntegerWavevector =>
        ∑ wave ∈ modes,
          lp.single (2 : ℝ≥0∞) wave (state wave))
      atTop (𝓝 state) at canonicalHasSum
  have composed :=
    canonicalHasSum.comp
      integerWaveFrequencyCube_tendsto_atTop
  change
    Filter.Tendsto
      ((fun modes : Finset IntegerWavevector =>
        complexSharpSupportProjection modes state) ∘
          integerWaveFrequencyCube)
      atTop (𝓝 state)
  exact composed

theorem finiteStateVorticityNonlinearCoefficientAt_frequencyCube_tendsto
    (state : ComplexVorticityHilbertState)
    (stateTransverse : WholeStateTransverse state)
    (output : IntegerWavevector) :
    Filter.Tendsto
      (fun radius =>
        finiteStateVorticityNonlinearCoefficientAt
          (integerWaveFrequencyCube radius) state output)
      atTop
      (𝓝
        (wholeStateVorticityNonlinearCoefficientAt
          state output)) := by
  have projectionTendsto :=
    complexSharpSupportProjection_frequencyCube_tendsto state
  have projectedTransverse :
      ∀ radius,
        WholeStateTransverse
          (complexSharpSupportProjection
            (integerWaveFrequencyCube radius) state) :=
    fun radius =>
      wholeStateTransverse_projection
        (integerWaveFrequencyCube radius)
        state stateTransverse
  have infiniteRowTendsto :=
    tendsto_wholeStateVorticityNonlinearCoefficientAt
      (fun radius =>
        complexSharpSupportProjection
          (integerWaveFrequencyCube radius) state)
      state projectedTransverse stateTransverse
      projectionTendsto output
  simpa only [
    wholeStateVorticityNonlinearCoefficientAt_projection_eq_finite]
    using infiniteRowTendsto

end

