import H0mework.Realization.Residual.Process
import H0mework.NavierStokes.Crossing.WholeSourceGluingLedger

/-!
# Native transport of the whole-restart component gluing residual

The canonical half-critical decomposition is computed from each actual whole
restart current.  Before any coefficient quotient is taken, its complete
ordered self/cross ledger leaves one whole nonlinear gluing row.  This module
makes that row part of the same source event that writes the next actual whole
unforced restart current.

The process state is the occurrence index of the already generated native
`run`.  Its residual carrier is the actual future tail of component-gluing
rows and its keep is literal left shift.  Hence

```text
actual current obstruction read
  = same-event occurrence-ledger write
  + actual whole unforced next current

residual (index + 1) = keep (residual index).
```

The occurrence ledger is not assigned a new metric and is not charged as PDE
energy.  It preserves the exact pre-quotient responsibility until a later
native relation or analytic consumer settles it.  No component count, branch,
path, residual, nonzero witness, cutoff, target state, or continuation
certificate enters the producer mouth.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace
    ThreeDimensionalVorticityCoefficientGeneratedWholeRestartComponentGluingResidualNativeProcess

open ThreeDimensionalPeriodicIntegerCharacterCoarseFilter
open ThreeDimensionalPeriodicFilteredNavierStokesGenerator
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientFiniteSupportComplexTrajectory
open ThreeDimensionalVorticityCoefficientInfiniteFixedOutputNonlinearRow
open
  ThreeDimensionalVorticityCoefficientGeneratedWholeRestartNativeRecursion
open
  ThreeDimensionalVorticityCoefficientGeneratedWholeRestartNativeRecursion.GeneratedWholeRestartCurrent
open
  ThreeDimensionalVorticityCoefficientGeneratedWholeRestartCumulativeCriticalDissipation
open
  ThreeDimensionalVorticityCoefficientGeneratedWholeRestartCrossingWholeSourceGluingLedger
open AffineRelaxation
open ResidualProjection

noncomputable section

/-! ## Actual update and occurrence write -/

/-- One complete component-gluing obstruction row on the whole Fourier
carrier. -/
abbrev WholeRestartComponentGluingResidualRow :=
  IntegerWavevector → ComplexCoordinateVector

/-- The complete source-gluing obstruction generated by one actual restart
occurrence.  A crossing internally produces the canonical finite component
sources and their complete cross/tail row.  A noncrossing occurrence has no
source-gluing debt because its same-event half-critical gradient payment is
already generated by the native update. -/
noncomputable def wholeRestartComponentGluingResidualRow
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) : WholeRestartComponentGluingResidualRow := by
  classical
  exact
    if crossed : wholeRestartHalfCriticalCrossed initial index then
      fun output =>
        wholeRestartCrossingCompleteSourceGluingResidual
          initial index crossed output
    else
      0

/-- On an actual crossing, the generated residual is definitionally the
complete finite-component cross plus retained-tail gluing row. -/
theorem wholeRestartComponentGluingResidualRow_of_crossed
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index) :
    wholeRestartComponentGluingResidualRow initial index =
      fun output =>
        wholeRestartCrossingCompleteSourceGluingResidual
          initial index crossed output := by
  classical
  simp [wholeRestartComponentGluingResidualRow, crossed]

/-- Noncrossing is a faithful zero of this gluing carrier; its analytic
responsibility is paid by the already generated gradient ledger. -/
theorem wholeRestartComponentGluingResidualRow_of_not_crossed
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (notCrossed : ¬ wholeRestartHalfCriticalCrossed initial index) :
    wholeRestartComponentGluingResidualRow initial index = 0 := by
  classical
  simp [wholeRestartComponentGluingResidualRow, notCrossed]

/-- On a crossing, the actual whole nonlinear row is exactly primitive
finite half-critical source self rows plus the native residual written here. -/
theorem wholeRestartComponentGluingResidualRow_crossed_exact
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (crossed : wholeRestartHalfCriticalCrossed initial index)
    (output : IntegerWavevector) :
    wholeStateVorticityNonlinearCoefficientAt
        (run initial index).contact.physicalState output =
      wholeRestartCrossingFiniteComponentSelfRow
          initial index crossed output +
        wholeRestartComponentGluingResidualRow initial index output := by
  rw [wholeRestartComponentGluingResidualRow_of_crossed
    initial index crossed]
  exact wholeRestartCrossingWholeNonlinear_eq_sourceSelf_add_gluing
    initial index crossed output

/-- The native write is the successor occurrence of the existing actual
whole restart run. -/
def wholeRestartComponentGluingNativeUpdate (index : ℕ) : ℕ :=
  index + 1

/-- Physical observation of the new native write is definitionally the
existing source-generated whole restart update. -/
theorem wholeRestartComponentGluingNativeUpdate_physical
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    run initial (wholeRestartComponentGluingNativeUpdate index) =
      (run initial index).next := by
  rfl

/-- The physical update begins with the exact old contact state on the actual
unforced receipt; the gluing row is not injected into the physical state. -/
theorem wholeRestartComponentGluingNativeUpdate_receipt_initial
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    let current := run initial index
    current.nextReceipt.wholePath
        ⟨0, ⟨le_rfl, current.nextReceipt.requestedTimePos.le⟩⟩ =
      current.contact.physicalState := by
  exact (run initial index).nextReceipt_initial

/-- Chronological pre-quotient ledger of the rows already read and written by
the actual process.  Newest occurrence comes first. -/
def wholeRestartComponentGluingOccurrenceLedger
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) : List WholeRestartComponentGluingResidualRow :=
  (List.range index).reverse.map
    (wholeRestartComponentGluingResidualRow initial)

/-- The same native event writes the complete current obstruction row into
the occurrence ledger before advancing the physical current. -/
theorem wholeRestartComponentGluingOccurrenceLedger_succ
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    wholeRestartComponentGluingOccurrenceLedger initial (index + 1) =
      wholeRestartComponentGluingResidualRow initial index ::
        wholeRestartComponentGluingOccurrenceLedger initial index := by
  simp [wholeRestartComponentGluingOccurrenceLedger, List.range_succ]

/-! ## Whole-carrier commuting residual transport -/

/-- The source-generated future component-gluing residual sequence beginning
at one actual occurrence. -/
abbrev WholeRestartComponentGluingResidualTail :=
  ℕ → WholeRestartComponentGluingResidualRow

/-- Forget exactly the row written by the current occurrence. -/
def wholeRestartComponentGluingResidualTailKeep :
    WholeRestartComponentGluingResidualTail →ₗ[ℂ]
      WholeRestartComponentGluingResidualTail where
  toFun residual offset := residual (offset + 1)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- Actual future residual tail of the native whole restart run. -/
def wholeRestartComponentGluingResidualTail
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) : WholeRestartComponentGluingResidualTail :=
  fun offset =>
    wholeRestartComponentGluingResidualRow initial (index + offset)

/-- The actual whole restart run is an effective residual process for its
complete pre-quotient component-gluing obstruction. -/
def generatedWholeRestartComponentGluingEffectiveProcess
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    EffectiveResidualProcess
      ℂ WholeRestartComponentGluingResidualTail ℕ where
  target := 0
  keep := wholeRestartComponentGluingResidualTailKeep
  residual := wholeRestartComponentGluingResidualTail initial
  update := wholeRestartComponentGluingNativeUpdate
  residual_transport_law := by
    intro index
    funext offset
    simp only [wholeRestartComponentGluingResidualTail,
      wholeRestartComponentGluingResidualTailKeep,
      wholeRestartComponentGluingNativeUpdate,
      LinearMap.coe_mk, AddHom.coe_mk]
    congr 1
    omega

@[simp] theorem
    generatedWholeRestartComponentGluingEffectiveProcess_update
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    (generatedWholeRestartComponentGluingEffectiveProcess initial).update
        index =
      index + 1 :=
  rfl

@[simp] theorem
    generatedWholeRestartComponentGluingEffectiveProcess_residual_head
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    (generatedWholeRestartComponentGluingEffectiveProcess initial).residual
        index 0 =
      wholeRestartComponentGluingResidualRow initial index := by
  simp [generatedWholeRestartComponentGluingEffectiveProcess,
    wholeRestartComponentGluingResidualTail]

/-- Whole-carrier commuting square for the actual source update. -/
theorem wholeRestartComponentGluingResidual_transport
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    wholeRestartComponentGluingResidualTail initial (index + 1) =
      wholeRestartComponentGluingResidualTailKeep
        (wholeRestartComponentGluingResidualTail initial index) :=
  (generatedWholeRestartComponentGluingEffectiveProcess
    initial).residual_transport_law index

/-- The trace written at the head is the uniquely forced difference between
the current and next actual component-gluing rows. -/
theorem wholeRestartComponentGluingResidual_trace_head
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    linearResidualTrace wholeRestartComponentGluingResidualTailKeep
          (wholeRestartComponentGluingResidualTail initial index) 0 =
      wholeRestartComponentGluingResidualRow initial index -
        wholeRestartComponentGluingResidualRow initial (index + 1) := by
  rfl

/-- Residual conservation on the same actual native write. -/
theorem wholeRestartComponentGluingResidual_eq_next_add_trace
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    wholeRestartComponentGluingResidualRow initial index =
      wholeRestartComponentGluingResidualRow initial (index + 1) +
        linearResidualTrace wholeRestartComponentGluingResidualTailKeep
          (wholeRestartComponentGluingResidualTail initial index) 0 := by
  rw [wholeRestartComponentGluingResidual_trace_head]
  abel

/-- A nonzero actual obstruction cannot disappear between successive whole
currents: it remains in the next keep or is written into the forced trace.
This is a consumer of the generated row, not a nonzero premise of the update. -/
theorem wholeRestartComponentGluingResidual_nonzero_next_or_trace
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (residualNonzero :
      wholeRestartComponentGluingResidualRow initial index ≠ 0) :
    wholeRestartComponentGluingResidualRow initial (index + 1) ≠ 0 ∨
      linearResidualTrace wholeRestartComponentGluingResidualTailKeep
          (wholeRestartComponentGluingResidualTail initial index) 0 ≠ 0 := by
  by_cases nextNonzero :
      wholeRestartComponentGluingResidualRow initial (index + 1) ≠ 0
  · exact Or.inl nextNonzero
  · right
    intro traceZero
    apply residualNonzero
    rw [wholeRestartComponentGluingResidual_eq_next_add_trace
      initial index, not_ne_iff.mp nextNonzero, traceZero, add_zero]

/-- Internal zero/transport/trace exhaustion.  The source event does not ask
a caller which branch occurs. -/
theorem wholeRestartComponentGluingResidual_zero_or_next_or_trace
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    wholeRestartComponentGluingResidualRow initial index = 0 ∨
      wholeRestartComponentGluingResidualRow initial (index + 1) ≠ 0 ∨
        linearResidualTrace wholeRestartComponentGluingResidualTailKeep
            (wholeRestartComponentGluingResidualTail initial index) 0 ≠ 0 := by
  by_cases residualZero :
      wholeRestartComponentGluingResidualRow initial index = 0
  · exact Or.inl residualZero
  · exact Or.inr
      (wholeRestartComponentGluingResidual_nonzero_next_or_trace
        initial index residualZero)

end

end
    ThreeDimensionalVorticityCoefficientGeneratedWholeRestartComponentGluingResidualNativeProcess
end NavierStokes
end SaturationMonoid
