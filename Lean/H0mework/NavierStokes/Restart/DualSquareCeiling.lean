noncomputable section

private theorem ae_comp_commonTimeInclusion
    {Tsmall Tbig : ℝ}
    (timeLe : Tsmall ≤ Tbig)
    {predicate : Icc (0 : ℝ) Tbig → Prop}
    (eventuallyBig :
      ∀ᵐ time ∂(commonTimeMeasure Tbig), predicate time) :
    ∀ᵐ time ∂(commonTimeMeasure Tsmall),
      predicate (commonTimeInclusion timeLe time) := by
  have onImage :
      ∀ᵐ time ∂
          (commonTimeMeasure Tbig).restrict
            (Set.range (commonTimeInclusion timeLe)),
        predicate time :=
    MeasureTheory.ae_restrict_le eventuallyBig
  exact
    (commonTimeInclusion_measurePreserving timeLe
      |>.quasiMeasurePreserving.tendsto_ae) onImage

/-! ## Generic whole-receipt payment -/

/-- The nonlinear state used by the output-work ledger is exactly the
canonical inverse-Laplacian weighted quadratic row of the same receipt. -/
theorem receiptNonlinearNegativeOneState_eq_canonical
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime coefficientCeiling : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (coefficientCeilingNonneg : 0 ≤ coefficientCeiling)
    (coefficientMassLe :
      ∀ᵐ time ∂(commonTimeMeasure requestedTime),
        wholeVorticityEuclideanMass
            (receipt.transverseLimit time).1 ≤
          coefficientCeiling) :
    receiptNonlinearNegativeOneState receipt =
      wholeSpaceTimeNonlinearNegativeOneState
        receipt.transverseLimit
        (by
          simpa only [receipt.stateLimit_eq_transverse] using
            receipt.gradient_summable)
        coefficientCeilingNonneg coefficientMassLe := by
  apply MeasureTheory.Lp.ext
  have sumAE :=
    MeasureTheory.Lp.coeFn_add
      receipt.wholeTangent
      (receiptViscousNegativeOneState receipt)
  have viscousAE :=
    wholeSpaceTimeViscousNegativeOneState_coeFn
      ν.coeff receipt.stateLimit receipt.gradient_summable
      (receiptPointwiseGradient_ae_summable receipt)
  have nonlinearAE :=
    wholeSpaceTimeNonlinearNegativeOneState_coeFn
      receipt.transverseLimit
      (by
        simpa only [receipt.stateLimit_eq_transverse] using
          receipt.gradient_summable)
      coefficientCeilingNonneg coefficientMassLe
  filter_upwards [sumAE, receipt.wholeTangent_eq_unforced_ae,
      viscousAE, nonlinearAE] with
      time sumEq tangentEq viscousEq nonlinearEq
  rw [receiptNonlinearNegativeOneState, sumEq]
  change
    receipt.wholeTangent time +
        wholeSpaceTimeViscousNegativeOneState
          ν.coeff receipt.stateLimit receipt.gradient_summable
            (receiptPointwiseGradient_ae_summable receipt) time = _
  rw [tangentEq, viscousEq, nonlinearEq]
  abel

/-- Complete dual-square payment of one whole receipt from any actual
coefficient and gradient ceilings on that same receipt. -/
theorem receiptDualSquarePayment_le_generatedCeilings
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime coefficientCeiling gradientCeiling : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (coefficientCeilingNonneg : 0 ≤ coefficientCeiling)
    (coefficientMassLe :
      ∀ᵐ time ∂(commonTimeMeasure requestedTime),
        wholeVorticityEuclideanMass
            (receipt.transverseLimit time).1 ≤
          coefficientCeiling)
    (gradientMassLe :
      wholeSpaceTimeVorticityGradientMass
          requestedTime receipt.stateLimit ≤
        gradientCeiling) :
    (3 / ν.coeff) *
          (‖receiptViscousNegativeOneState receipt‖ ^ 2 +
            ‖receiptNonlinearNegativeOneState receipt‖ ^ 2) ≤
      (3 / ν.coeff) *
        ((3 * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 +
            12 *
              (biotSavartSerrinConstant *
                (∑' wave : IntegerWavevector,
                  integerWaveCriticalKernel wave)) *
              coefficientCeiling) * gradientCeiling) := by
  have viscousBound :
      ‖receiptViscousNegativeOneState receipt‖ ^ 2 ≤
        3 * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 *
          gradientCeiling := by
    exact
      (wholeSpaceTimeViscousNegativeOneState_norm_sq_le
        ν.coeff receipt.stateLimit receipt.gradient_summable
        (receiptPointwiseGradient_ae_summable receipt)).trans
        (mul_le_mul_of_nonneg_left gradientMassLe
          (mul_nonneg
            (mul_nonneg (by norm_num) (sq_nonneg _))
            (sq_nonneg _)))
  have transverseGradientMass :
      wholeSpaceTimeVorticityGradientMass requestedTime
          (transverseSpaceTimeInclusion
            requestedTime receipt.transverseLimit) ≤
        gradientCeiling := by
    simpa only [receipt.stateLimit_eq_transverse] using gradientMassLe
  have nonlinearBound :
      ‖receiptNonlinearNegativeOneState receipt‖ ^ 2 ≤
        12 *
            (biotSavartSerrinConstant *
              (∑' wave : IntegerWavevector,
                integerWaveCriticalKernel wave)) *
            coefficientCeiling * gradientCeiling := by
    rw [receiptNonlinearNegativeOneState_eq_canonical
      receipt coefficientCeilingNonneg coefficientMassLe]
    exact
      (wholeSpaceTimeNonlinearNegativeOneState_norm_sq_le
        receipt.transverseLimit
        (by
          simpa only [receipt.stateLimit_eq_transverse] using
            receipt.gradient_summable)
        coefficientCeilingNonneg coefficientMassLe).trans
        (mul_le_mul_of_nonneg_left transverseGradientMass
          (mul_nonneg
            (mul_nonneg (by norm_num)
              (mul_nonneg biotSavartSerrinConstant_nonneg
                integerWaveCriticalKernel_tsum_nonneg))
            coefficientCeilingNonneg))
  have sumBound := add_le_add viscousBound nonlinearBound
  have coefficientNonneg : 0 ≤ 3 / ν.coeff :=
    div_nonneg (by norm_num) ν.coeff_pos.le
  apply mul_le_mul_of_nonneg_left _ coefficientNonneg
  calc
    ‖receiptViscousNegativeOneState receipt‖ ^ 2 +
          ‖receiptNonlinearNegativeOneState receipt‖ ^ 2 ≤
        3 * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 *
            gradientCeiling +
          12 *
              (biotSavartSerrinConstant *
                (∑' wave : IntegerWavevector,
                  integerWaveCriticalKernel wave)) *
              coefficientCeiling * gradientCeiling :=
      sumBound
    _ =
        (3 * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 +
            12 *
              (biotSavartSerrinConstant *
                (∑' wave : IntegerWavevector,
                  integerWaveCriticalKernel wave)) *
              coefficientCeiling) * gradientCeiling := by
      ring

/-! ## Restriction to the actual next contact -/

theorem prefixReceipt_gradientMass_le
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    {receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime}
    (contact : GeneratedPositiveWholeRestartContact receipt) :
    wholeSpaceTimeVorticityGradientMass
        contact.time.1 contact.prefixReceipt.stateLimit ≤
      wholeSpaceTimeVorticityGradientMass
        requestedTime receipt.stateLimit := by
  unfold wholeSpaceTimeVorticityGradientMass
  exact
    contact.prefixReceipt.gradient_summable.tsum_le_tsum
      (fun wave => by
        simpa only [GeneratedPositiveWholeRestartContact.prefixReceipt,
          restrictWholeContinuousMildSerrinReceipt] using
          wholeSpaceTimeVorticityGradientDensity_restrict_le
            contact.time.2.2 receipt.stateLimit wave)
      receipt.gradient_summable

theorem prefixReceipt_transverseCoefficientMass_ae_le
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime coefficientCeiling : ℝ}
    {receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime}
    (contact : GeneratedPositiveWholeRestartContact receipt)
    (fullMassLe :
      ∀ᵐ time ∂(commonTimeMeasure requestedTime),
        wholeVorticityEuclideanMass
            (receipt.transverseLimit time).1 ≤
          coefficientCeiling) :
    ∀ᵐ time ∂(commonTimeMeasure contact.time.1),
      wholeVorticityEuclideanMass
          (contact.prefixReceipt.transverseLimit time).1 ≤
        coefficientCeiling := by
  have pulled :=
    ae_comp_commonTimeInclusion contact.time.2.2 fullMassLe
  have restrictedAE :=
    restrictCommonTimeLp_apply_ae
      contact.time.2.2 receipt.transverseLimit
  filter_upwards [pulled, restrictedAE] with
      time massLe restrictedEq
  change
    wholeVorticityEuclideanMass
        ((restrictCommonTimeLp contact.time.2.2
          receipt.transverseLimit) time).1 ≤
      coefficientCeiling
  rw [restrictedEq]
  exact massLe

/-! ## Source-owned restart ceiling -/

/-- Explicit scalar ceiling generated by one actual whole contact. -/
def wholeRestartGeneratedDualSquareCeiling
    {ν : Viscosity}
    (current : GeneratedWholeRestartCurrent ν) : ℝ :=
  (3 / ν.coeff) *
    ((3 * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 +
        12 *
          (biotSavartSerrinConstant *
            (∑' wave : IntegerWavevector,
              integerWaveCriticalKernel wave)) *
          wholeRestartCoefficientCeiling current.contact) *
      wholeRestartGradientCeiling current.contact)

theorem wholeRestartGeneratedDualSquareCeiling_nonneg
    {ν : Viscosity}
    (current : GeneratedWholeRestartCurrent ν) :
    0 ≤ wholeRestartGeneratedDualSquareCeiling current := by
  unfold wholeRestartGeneratedDualSquareCeiling
  apply mul_nonneg
  · exact div_nonneg (by norm_num) ν.coeff_pos.le
  · apply mul_nonneg
    · apply add_nonneg
      · exact mul_nonneg
          (mul_nonneg (by norm_num) (sq_nonneg _)) (sq_nonneg _)
      · exact mul_nonneg
          (mul_nonneg (by norm_num)
            (mul_nonneg biotSavartSerrinConstant_nonneg
              integerWaveCriticalKernel_tsum_nonneg))
          (wholeRestartCoefficientCeiling_pos current.contact).le
    · exact wholeRestartGradientCeiling_nonneg current.contact

/-- The next source-selected physical receipt is paid by the ceilings
generated at the preceding actual contact. -/
theorem nextContact_prefixReceipt_dualSquarePayment_le
    {ν : Viscosity}
    (current : GeneratedWholeRestartCurrent ν) :
    (3 / ν.coeff) *
          (‖receiptViscousNegativeOneState
                current.nextContact.prefixReceipt‖ ^ 2 +
            ‖receiptNonlinearNegativeOneState
                current.nextContact.prefixReceipt‖ ^ 2) ≤
      wholeRestartGeneratedDualSquareCeiling current := by
  let replay := generatedWholeRestartCanonicalReplay current.contact
  let closure := generatedWholeRestartCriticalClosure replay
  have fullGradientMassLe :
      wholeSpaceTimeVorticityGradientMass
          (wholeRestartDuration current.contact)
          current.nextReceipt.stateLimit ≤
        wholeRestartGradientCeiling current.contact := by
    simpa [GeneratedWholeRestartCurrent.nextReceipt,
      generatedWholeRestartWholeContinuousMildSerrinReceipt,
      wholeRestartWholeContinuousMildSerrinReceipt,
      replay, closure] using closure.gradient_mass_le
  have prefixGradientMassLe :
      wholeSpaceTimeVorticityGradientMass
          current.nextContact.time.1
          current.nextContact.prefixReceipt.stateLimit ≤
        wholeRestartGradientCeiling current.contact :=
    (prefixReceipt_gradientMass_le current.nextContact).trans
      fullGradientMassLe
  have fullCoefficientMassLe :
      ∀ᵐ time ∂(commonTimeMeasure
        (wholeRestartDuration current.contact)),
        wholeVorticityEuclideanMass
            (current.nextReceipt.transverseLimit time).1 ≤
          wholeRestartCoefficientCeiling current.contact := by
    simpa [GeneratedWholeRestartCurrent.nextReceipt,
      generatedWholeRestartWholeContinuousMildSerrinReceipt,
      wholeRestartWholeContinuousMildSerrinReceipt,
      replay, closure] using
      wholeRestartTransverseCoefficientMass_ae_le closure
  have prefixCoefficientMassLe :=
    prefixReceipt_transverseCoefficientMass_ae_le
      current.nextContact fullCoefficientMassLe
  simpa [wholeRestartGeneratedDualSquareCeiling] using
    receiptDualSquarePayment_le_generatedCeilings
      current.nextContact.prefixReceipt
      (wholeRestartCoefficientCeiling_pos current.contact).le
      prefixCoefficientMassLe prefixGradientMassLe

/-- Every generated noninitial segment of the authoritative restart run is
paid by the preceding source contact's scalar ceiling. -/
theorem wholeRestartSegmentDualSquarePayment_succ_le_generatedCeiling
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    wholeRestartSegmentDualSquarePayment initial (index + 1) ≤
      wholeRestartGeneratedDualSquareCeiling (run initial index) := by
  unfold wholeRestartSegmentDualSquarePayment
  rw [run_succ]
  change
    (3 / ν.coeff) *
          (‖receiptViscousNegativeOneState
                (run initial index).nextContact.prefixReceipt‖ ^ 2 +
            ‖receiptNonlinearNegativeOneState
                (run initial index).nextContact.prefixReceipt‖ ^ 2) ≤
      wholeRestartGeneratedDualSquareCeiling (run initial index)
  exact nextContact_prefixReceipt_dualSquarePayment_le
    (run initial index)

/-! ## Exact finite-prefix reduction -/

/-- Scalar source ceiling for the initial receipt and the first `length`
generated successor receipts. -/
def wholeRestartAccumulatedGeneratedDualSquareCeiling
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (length : ℕ) : ℝ :=
  wholeRestartSegmentDualSquarePayment initial 0 +
    ∑ index ∈ Finset.range length,
      wholeRestartGeneratedDualSquareCeiling (run initial index)

theorem wholeRestartAccumulatedGeneratedDualSquareCeiling_nonneg
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (length : ℕ) :
    0 ≤ wholeRestartAccumulatedGeneratedDualSquareCeiling
      initial length := by
  unfold wholeRestartAccumulatedGeneratedDualSquareCeiling
  exact add_nonneg
    (wholeRestartSegmentDualSquarePayment_nonneg initial 0)
    (Finset.sum_nonneg fun index _indexMem =>
      wholeRestartGeneratedDualSquareCeiling_nonneg
        (run initial index))

/-- Every actual finite prefix is paid by the initial finite receipt plus
the source-generated ceiling of each preceding contact. -/
theorem wholeRestartAccumulatedDualSquarePayment_succ_le_generatedCeiling
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    ∀ length : ℕ,
      wholeRestartAccumulatedDualSquarePayment initial (length + 1) ≤
        wholeRestartAccumulatedGeneratedDualSquareCeiling
          initial length
  | 0 => by
      simp [wholeRestartAccumulatedDualSquarePayment,
        wholeRestartAccumulatedGeneratedDualSquareCeiling]
  | length + 1 => by
      have prefixBound :=
        wholeRestartAccumulatedDualSquarePayment_succ_le_generatedCeiling
          initial length
      have segmentBound :=
        wholeRestartSegmentDualSquarePayment_succ_le_generatedCeiling
          initial length
      unfold wholeRestartAccumulatedDualSquarePayment at prefixBound ⊢
      unfold wholeRestartAccumulatedGeneratedDualSquareCeiling at prefixBound ⊢
      calc
        (∑ index ∈ Finset.range (length + 1 + 1),
            wholeRestartSegmentDualSquarePayment initial index) =
            (∑ index ∈ Finset.range (length + 1),
              wholeRestartSegmentDualSquarePayment initial index) +
              wholeRestartSegmentDualSquarePayment initial (length + 1) := by
          rw [Finset.sum_range_succ]
        _ ≤
            (wholeRestartSegmentDualSquarePayment initial 0 +
              ∑ index ∈ Finset.range length,
                wholeRestartGeneratedDualSquareCeiling
                  (run initial index)) +
              wholeRestartGeneratedDualSquareCeiling
                (run initial length) :=
          add_le_add prefixBound segmentBound
        _ =
            wholeRestartSegmentDualSquarePayment initial 0 +
              ∑ index ∈ Finset.range (length + 1),
                wholeRestartGeneratedDualSquareCeiling
                  (run initial index) := by
          rw [Finset.sum_range_succ]
          ring

/-- Finite physical-time accumulation forces the explicit source-generated
scalar ceiling prefixes themselves to be unbounded. -/
theorem elapsedTime_bddAbove_forces_accumulatedGeneratedDualSquareCeiling_unbounded
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    ¬ BddAbove
      (Set.range
        (wholeRestartAccumulatedGeneratedDualSquareCeiling initial)) := by
  intro generatedBounded
  obtain ⟨bound, boundSpec⟩ := generatedBounded
  have boundNonneg : 0 ≤ bound :=
    (wholeRestartAccumulatedGeneratedDualSquareCeiling_nonneg
      initial 0).trans (boundSpec ⟨0, rfl⟩)
  apply
    (elapsedTime_bddAbove_forces_accumulatedDualSquarePayment_unbounded
      initial elapsedBounded)
  refine ⟨bound, ?_⟩
  rintro _ ⟨length, rfl⟩
  cases length with
  | zero =>
      simpa [wholeRestartAccumulatedDualSquarePayment] using boundNonneg
  | succ length =>
      exact
        (wholeRestartAccumulatedDualSquarePayment_succ_le_generatedCeiling
          initial length).trans
          (boundSpec ⟨length, rfl⟩)

/-- Equivalently, a finite-time write-chain forces nonsummability of the
one-dimensional source-generated scalar ceilings. -/
theorem elapsedTime_bddAbove_forces_generatedDualSquareCeiling_nonsummable
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    ¬ Summable fun index : ℕ =>
      wholeRestartGeneratedDualSquareCeiling (run initial index) := by
  intro ceilingSummable
  apply
    (elapsedTime_bddAbove_forces_accumulatedGeneratedDualSquareCeiling_unbounded
      initial elapsedBounded)
  let total :=
    wholeRestartSegmentDualSquarePayment initial 0 +
      ∑' index : ℕ,
        wholeRestartGeneratedDualSquareCeiling (run initial index)
  refine ⟨total, ?_⟩
  rintro _ ⟨length, rfl⟩
  unfold wholeRestartAccumulatedGeneratedDualSquareCeiling
  dsimp only [total]
  exact add_le_add le_rfl
    (ceilingSummable.sum_le_tsum
      (Finset.range length)
      (fun index _indexNotMem =>
        wholeRestartGeneratedDualSquareCeiling_nonneg
          (run initial index)))

end

