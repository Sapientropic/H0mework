theorem wholeRestartTransverseGradient_summable
    {ν : Viscosity}
    {Seed : Type}
    [WholeRestartPhysicalSeed ν Seed]
    {contact : Seed}
    {replay : GeneratedWholeRestartCanonicalReplay contact}
    (closure : GeneratedWholeRestartCriticalClosure replay) :
    Summable
      (fun wave : IntegerWavevector =>
        wholeSpaceTimeVorticityGradientDensity
          (wholeRestartDuration contact)
          (transverseSpaceTimeInclusion
            (wholeRestartDuration contact) closure.transverseLimit) wave) := by
  simpa only [closure.inclusion_eq] using closure.gradient_summable

theorem wholeRestartTransverseCoefficientMass_ae_le
    {ν : Viscosity}
    {Seed : Type}
    [WholeRestartPhysicalSeed ν Seed]
    {contact : Seed}
    {replay : GeneratedWholeRestartCanonicalReplay contact}
    (closure : GeneratedWholeRestartCriticalClosure replay) :
    ∀ᵐ time ∂(commonTimeMeasure (wholeRestartDuration contact)),
      wholeVorticityEuclideanMass (closure.transverseLimit time).1 ≤
        wholeRestartCoefficientCeiling contact := by
  have includedEq :
      ∀ᵐ time ∂(commonTimeMeasure (wholeRestartDuration contact)),
        transverseSpaceTimeInclusion
            (wholeRestartDuration contact) closure.transverseLimit time =
          closure.weakClosure.stateLimit time := by
    rw [closure.inclusion_eq]
    exact Filter.Eventually.of_forall fun _ => rfl
  filter_upwards [
    closure.coefficientMass_ae_le,
    transverseSpaceTimeInclusion_coeFn
      (wholeRestartDuration contact) closure.transverseLimit,
    includedEq] with time massLe transverseEq stateEq
  rw [← stateEq, transverseEq] at massLe
  exact massLe

/-- The inverse-Laplacian weighted nonlinear forcing generated by the same
transverse whole restart limit. -/
def wholeRestartNegativeOneForcing
    {ν : Viscosity}
    {Seed : Type}
    [WholeRestartPhysicalSeed ν Seed]
    {contact : Seed}
    {replay : GeneratedWholeRestartCanonicalReplay contact}
    (closure : GeneratedWholeRestartCriticalClosure replay) :
    SpaceTimeState (wholeRestartDuration contact) :=
  wholeSpaceTimeNonlinearNegativeOneState
    closure.transverseLimit
    (wholeRestartTransverseGradient_summable closure)
    (wholeRestartCoefficientCeiling_pos contact).le
    (wholeRestartTransverseCoefficientMass_ae_le closure)

theorem wholeRestartNegativeOneForcing_unweighted_row_ae
    {ν : Viscosity}
    {Seed : Type}
    [WholeRestartPhysicalSeed ν Seed]
    {contact : Seed}
    {replay : GeneratedWholeRestartCanonicalReplay contact}
    (closure : GeneratedWholeRestartCriticalClosure replay)
    (wave : IntegerWavevector)
    (waveNonzero : wave ≠ 0) :
    ∀ᵐ time ∂(commonTimeMeasure (wholeRestartDuration contact)),
      (Real.sqrt (integerWaveViscousMultiplier wave) : ℝ) •
          (wholeRestartNegativeOneForcing closure time) wave =
        transverseSpaceTimeNonlinearRow
          closure.transverseLimit wave time := by
  exact
    wholeSpaceTimeNonlinearNegativeOneState_unweighted_row_ae
      closure.transverseLimit
      (wholeRestartTransverseGradient_summable closure)
      (wholeRestartCoefficientCeiling_pos contact).le
      (wholeRestartTransverseCoefficientMass_ae_le closure)
      wave waveNonzero

/-- Choose the generated row together with the quantitative modulus retained
from the same finite-observation replay. -/
noncomputable def wholeRestartFixedWaveMildHolderReceipt
    {ν : Viscosity}
    {Seed : Type}
    [WholeRestartPhysicalSeed ν Seed]
    {contact : Seed}
    {replay : GeneratedWholeRestartCanonicalReplay contact}
    (closure : GeneratedWholeRestartCriticalClosure replay)
    (wave : IntegerWavevector)
    (waveNonzero : wave ≠ 0) :
    GeneratedWholeRestartFixedWaveMildHolderReceipt
      closure wave waveNonzero :=
  Classical.choice
    (GeneratedWholeRestartCriticalClosure.exists_fixedWaveContinuousMildHolderReceipt
      closure wave waveNonzero)

/-- The continuous mild row carried by the generated quantitative receipt. -/
noncomputable def wholeRestartFixedWaveMildData
    {ν : Viscosity}
    {Seed : Type}
    [WholeRestartPhysicalSeed ν Seed]
    {contact : Seed}
    {replay : GeneratedWholeRestartCanonicalReplay contact}
    (closure : GeneratedWholeRestartCriticalClosure replay)
    (wave : IntegerWavevector)
    (waveNonzero : wave ≠ 0) :
    FixedWaveContinuousMildData
      (wholeRestartDuration contact) ν.coeff wave
      (fun radius => (replay.current radius).trajectory 0)
      closure.weakClosure.stateLimit
      (transverseSpaceTimeNonlinearRow closure.transverseLimit wave) :=
  (wholeRestartFixedWaveMildHolderReceipt
    closure wave waveNonzero).mildData

/-- The source-owned finite-observation square-increment law survives on the
selected continuous mild row. -/
theorem wholeRestartFixedWaveMildData_increment_sq_le
    {ν : Viscosity}
    {Seed : Type}
    [WholeRestartPhysicalSeed ν Seed]
    {contact : Seed}
    {replay : GeneratedWholeRestartCanonicalReplay contact}
    (closure : GeneratedWholeRestartCriticalClosure replay)
    (wave : IntegerWavevector)
    (waveNonzero : wave ≠ 0)
    (first second : Icc (0 : ℝ) (wholeRestartDuration contact)) :
    dist
        ((wholeRestartFixedWaveMildData
          closure wave waveNonzero).rowPath first)
        ((wholeRestartFixedWaveMildData
          closure wave waveNonzero).rowPath second) ^ 2 ≤
      dist first second *
        wholeRestartFiniteObservedHalfHolderEnergy replay {wave} :=
  (wholeRestartFixedWaveMildHolderReceipt
    closure wave waveNonzero).increment_sq_le first second

theorem wholeRestartFixedWaveMildData_initialLimit
    {ν : Viscosity}
    {Seed : Type}
    [WholeRestartPhysicalSeed ν Seed]
    {contact : Seed}
    {replay : GeneratedWholeRestartCanonicalReplay contact}
    (closure : GeneratedWholeRestartCriticalClosure replay)
    (wave : IntegerWavevector)
    (waveNonzero : wave ≠ 0) :
    (wholeRestartFixedWaveMildData
      closure wave waveNonzero).initialLimit = (wholeRestartPhysicalState contact) :=
  tendsto_nhds_unique
    (wholeRestartFixedWaveMildData
      closure wave waveNonzero).initial_tendsto
    replay.initial_tendsto

theorem wholeRestartInitialState_zero_row
    {ν : Viscosity}
    {Seed : Type}
    [WholeRestartPhysicalSeed ν Seed]
    {contact : Seed}
    {_replay : GeneratedWholeRestartCanonicalReplay contact}
    (_closure : GeneratedWholeRestartCriticalClosure _replay) :
    (wholeRestartPhysicalState contact) 0 = 0 :=
  (wholeRestartPhysicalState_zero contact)

theorem wholeRestartStateLimit_zero_row
    {ν : Viscosity}
    {Seed : Type}
    [WholeRestartPhysicalSeed ν Seed]
    {contact : Seed}
    {replay : GeneratedWholeRestartCanonicalReplay contact}
    (closure : GeneratedWholeRestartCriticalClosure replay) :
    fixedWaveSpaceTimeRestriction
        (wholeRestartDuration contact) 0 closure.weakClosure.stateLimit = 0 := by
  have approximantZero :
      ∀ index : ℕ,
        fixedWaveSpaceTimeRestriction
            (wholeRestartDuration contact) 0
            (wholeTrajectorySpaceTimePath
              (wholeRestartDuration contact)
              (replay.current
                (closure.weakClosure.subsequence index)).trajectory
              (HasDerivAt.continuousOn fun time timeMem =>
                ((replay.current
                  (closure.weakClosure.subsequence index)).physical
                    time timeMem).1)) = 0 := by
    intro index
    apply MeasureTheory.Lp.ext
    filter_upwards [
      fixedWaveSpaceTimeRestriction_coeFn
        (wholeRestartDuration contact) 0
        (wholeTrajectorySpaceTimePath
          (wholeRestartDuration contact)
          (replay.current
            (closure.weakClosure.subsequence index)).trajectory
          (HasDerivAt.continuousOn fun time timeMem =>
            ((replay.current
              (closure.weakClosure.subsequence index)).physical
                time timeMem).1)),
      BoundedContinuousFunction.coeFn_toLp
        (p := (2 : ℝ≥0∞))
        (μ := commonTimeMeasure (wholeRestartDuration contact)) ℂ
        (wholeTrajectoryBoundedPath
          (wholeRestartDuration contact)
          (replay.current
            (closure.weakClosure.subsequence index)).trajectory
          (HasDerivAt.continuousOn fun time timeMem =>
            ((replay.current
              (closure.weakClosure.subsequence index)).physical
                time timeMem).1)),
      MeasureTheory.Lp.coeFn_zero ComplexCoordinateVector 2
        (commonTimeMeasure (wholeRestartDuration contact))] with
        time rowEq wholeEq zeroEq
    rw [rowEq, zeroEq]
    have statePoint :
        (wholeTrajectorySpaceTimePath
          (wholeRestartDuration contact)
          (replay.current
            (closure.weakClosure.subsequence index)).trajectory
          (HasDerivAt.continuousOn fun actual actualMem =>
            ((replay.current
              (closure.weakClosure.subsequence index)).physical
                actual actualMem).1)) time =
          (replay.current
            (closure.weakClosure.subsequence index)).trajectory time.1 := by
      have statePoint' :
          (wholeTrajectorySpaceTimePath
            (wholeRestartDuration contact)
            (replay.current
              (closure.weakClosure.subsequence index)).trajectory
            (HasDerivAt.continuousOn fun actual actualMem =>
              ((replay.current
                (closure.weakClosure.subsequence index)).physical
                  actual actualMem).1)) time =
            wholeTrajectoryBoundedPath
              (wholeRestartDuration contact)
              (replay.current
                (closure.weakClosure.subsequence index)).trajectory
              (HasDerivAt.continuousOn fun actual actualMem =>
                ((replay.current
                  (closure.weakClosure.subsequence index)).physical
                    actual actualMem).1) time := by
        simpa [wholeTrajectorySpaceTimePath] using wholeEq
      exact statePoint'.trans rfl
    rw [statePoint]
    exact
      (replay.current
        (closure.weakClosure.subsequence index)).physical
          time.1 time.2 |>.2.1 0
          (zero_not_mem_puncturedIntegerWaveFrequencyCube _)
  have rowTendsto :
      Tendsto
        (fun index =>
          fixedWaveSpaceTimeRestriction
            (wholeRestartDuration contact) 0
            (wholeTrajectorySpaceTimePath
              (wholeRestartDuration contact)
              (replay.current
                (closure.weakClosure.subsequence index)).trajectory
              (HasDerivAt.continuousOn fun time timeMem =>
                ((replay.current
                  (closure.weakClosure.subsequence index)).physical
                    time timeMem).1)))
        atTop
        (𝓝 (fixedWaveSpaceTimeRestriction
          (wholeRestartDuration contact) 0
          closure.weakClosure.stateLimit)) :=
    (fixedWaveSpaceTimeRestriction
      (wholeRestartDuration contact) 0).continuous.tendsto
        closure.weakClosure.stateLimit |>.comp
          closure.weakClosure.state_tendsto
  have zeroTendsto :
      Tendsto
        (fun _ : ℕ =>
          (0 : FixedWaveSpaceTimeState (wholeRestartDuration contact)))
        atTop (𝓝 0) := tendsto_const_nhds
  exact
    tendsto_nhds_unique rowTendsto <| by
      simpa only [approximantZero] using zeroTendsto

/-- All fields of the generic whole-mild compiler are generated from the
same canonical whole restart replay. -/
noncomputable def wholeRestartWholeMildAssemblyInput
    {ν : Viscosity}
    {Seed : Type}
    [WholeRestartPhysicalSeed ν Seed]
    {contact : Seed}
    {replay : GeneratedWholeRestartCanonicalReplay contact}
    (closure : GeneratedWholeRestartCriticalClosure replay) :
    WholeMildAssemblyInput ν (wholeRestartDuration contact) where
  time_pos := wholeRestartDuration_pos contact
  initialState := (wholeRestartPhysicalState contact)
  stateLimit := closure.weakClosure.stateLimit
  negativeOneForcing := wholeRestartNegativeOneForcing closure
  nonlinearRow wave _waveNonzero :=
    transverseSpaceTimeNonlinearRow closure.transverseLimit wave
  rowPath wave waveNonzero :=
    (wholeRestartFixedWaveMildData closure wave waveNonzero).rowPath
  row_represents wave waveNonzero :=
    (wholeRestartFixedWaveMildData closure wave waveNonzero).row_represents
  forcing_unweighted_row_ae wave waveNonzero :=
    wholeRestartNegativeOneForcing_unweighted_row_ae
      closure wave waveNonzero
  row_mild_identity wave waveNonzero time := by
    have generated :=
      (wholeRestartFixedWaveMildData
        closure wave waveNonzero).mild_identity time
    rw [wholeRestartFixedWaveMildData_initialLimit
      closure wave waveNonzero] at generated
    exact generated
  stateLimit_zero_row := wholeRestartStateLimit_zero_row closure
  initialState_zero_row := wholeRestartInitialState_zero_row closure

noncomputable def wholeRestartWholeMildAssembly
    {ν : Viscosity}
    {Seed : Type}
    [WholeRestartPhysicalSeed ν Seed]
    {contact : Seed}
    {replay : GeneratedWholeRestartCanonicalReplay contact}
    (closure : GeneratedWholeRestartCriticalClosure replay) :
    WholeContinuousMildAssembly
      (wholeRestartWholeMildAssemblyInput closure) :=
  (wholeRestartWholeMildAssemblyInput closure).assemble

/-- The assembled whole path reads each nonzero Fourier row from the same
generated quantitative receipt selected above. -/
theorem wholeRestartWholeMildAssembly_fixedWave_eq
    {ν : Viscosity}
    {Seed : Type}
    [WholeRestartPhysicalSeed ν Seed]
    {contact : Seed}
    {replay : GeneratedWholeRestartCanonicalReplay contact}
    (closure : GeneratedWholeRestartCriticalClosure replay)
    (wave : IntegerWavevector)
    (waveNonzero : wave ≠ 0)
    (time : Icc (0 : ℝ) (wholeRestartDuration contact)) :
    (wholeRestartWholeMildAssembly closure).wholePath time wave =
      (wholeRestartFixedWaveMildData
        closure wave waveNonzero).rowPath time := by
  change
    assemblyMildCoefficient
        (wholeRestartWholeMildAssemblyInput closure) time wave =
      (wholeRestartFixedWaveMildData
        closure wave waveNonzero).rowPath time
  rw [assemblyMildCoefficient_eq_rowPath
    (wholeRestartWholeMildAssemblyInput closure)
    time wave waveNonzero]
  rfl

/-- The actual assembled whole path restricted to one fixed finite Fourier
observation.  This is the target of the canonical Galerkin paths already
present in the restart compactness compiler. -/
noncomputable def wholeRestartWholeMildObservedBoundedPath
    {ν : Viscosity}
    {Seed : Type}
    [WholeRestartPhysicalSeed ν Seed]
    {contact : Seed}
    {replay : GeneratedWholeRestartCanonicalReplay contact}
    (closure : GeneratedWholeRestartCriticalClosure replay)
    (observed : Finset IntegerWavevector) :
    BoundedContinuousFunction
      (Icc (0 : ℝ) (wholeRestartDuration contact))
      (FiniteObservedCoefficientState observed) :=
  (finiteObservedRestriction observed).compLeftContinuousBounded
    (Icc (0 : ℝ) (wholeRestartDuration contact))
    (wholeRestartWholeMildAssembly closure).wholePath

/-- Read every Fourier coordinate row of one finite-observation path as a
bounded continuous path. -/
noncomputable def wholeRestartFiniteObservedRowsCLM
    (requestedTime : ℝ)
    (observed : Finset IntegerWavevector) :
    BoundedContinuousFunction
        (Icc (0 : ℝ) requestedTime)
        (FiniteObservedCoefficientState observed) →L[ℂ]
      ((wave : {actual : IntegerWavevector // actual ∈ observed}) →
        BoundedContinuousFunction
          (Icc (0 : ℝ) requestedTime) ComplexCoordinateVector) :=
  ContinuousLinearMap.pi fun wave =>
    (ContinuousLinearMap.proj wave).compLeftContinuousBounded
      (Icc (0 : ℝ) requestedTime)

theorem wholeRestartFiniteObservedRowsCLM_injective
    (requestedTime : ℝ)
    (observed : Finset IntegerWavevector) :
    Function.Injective
      (wholeRestartFiniteObservedRowsCLM requestedTime observed) := by
  intro left right rowsEq
  apply BoundedContinuousFunction.ext
  intro time
  funext wave
  have rowEq := congrFun rowsEq wave
  exact DFunLike.congr_fun rowEq time

/-- Every fixed finite zero-free Fourier observation of the canonical
Galerkin replay converges uniformly, along the already selected whole
weak-closure subsequence, to the same actual assembled whole receipt.

The proof uses all fixed-wave source rows at once; it introduces neither a
second subsequence nor a caller-selected limiting path. -/
theorem wholeRestartFiniteObservedBoundedPath_subsequence_tendsto_assembly
    {ν : Viscosity}
    {Seed : Type}
    [WholeRestartPhysicalSeed ν Seed]
    {contact : Seed}
    {replay : GeneratedWholeRestartCanonicalReplay contact}
    (closure : GeneratedWholeRestartCriticalClosure replay)
    (observed : Finset IntegerWavevector)
    (observedZeroFree : 0 ∉ observed) :
    Tendsto
      (fun index =>
        wholeRestartFiniteObservedBoundedPath replay observed
          (closure.weakClosure.subsequence index))
      atTop
      (𝓝 (wholeRestartWholeMildObservedBoundedPath closure observed)) := by
  let sequence : Nat →
      BoundedContinuousFunction
        (Icc (0 : ℝ) (wholeRestartDuration contact))
        (FiniteObservedCoefficientState observed) :=
    fun index =>
      wholeRestartFiniteObservedBoundedPath replay observed
        (closure.weakClosure.subsequence index)
  let target := wholeRestartWholeMildObservedBoundedPath closure observed
  let compact := _root_.closure
    (wholeRestartFiniteObservedPathFamily replay observed)
  have compactIsCompact : IsCompact compact :=
    wholeRestartFiniteObservedPathFamily_isCompact_closure replay observed
  have sequenceMem : ∀ index, sequence index ∈ compact := by
    intro index
    apply subset_closure
    exact ⟨closure.weakClosure.subsequence index, rfl⟩
  let rows := wholeRestartFiniteObservedRowsCLM
    (wholeRestartDuration contact) observed
  have mappedTendsto :
      Tendsto (fun index => rows (sequence index))
        atTop (𝓝 (rows target)) := by
    apply tendsto_pi_nhds.mpr
    intro wave
    have waveNonzero : wave.1 ≠ 0 := by
      intro waveZero
      apply observedZeroFree
      simpa only [waveZero] using wave.2
    have sourceEq :
        (fun index => rows (sequence index) wave) =
          wholeRestartFixedWaveCanonicalBoundedPath
            closure wave.1 := by
      funext index
      apply BoundedContinuousFunction.ext
      intro time
      rfl
    have targetEq :
        rows target wave =
          (wholeRestartFixedWaveMildData
            closure wave.1 waveNonzero).rowPath := by
      apply BoundedContinuousFunction.ext
      intro time
      exact wholeRestartWholeMildAssembly_fixedWave_eq
        closure wave.1 waveNonzero time
    rw [sourceEq, targetEq]
    exact
      (wholeRestartFixedWaveMildHolderReceipt
        closure wave.1 waveNonzero).row_full_tendsto
  change Tendsto sequence atTop (𝓝 target)
  apply tendsto_of_compact_of_continuous_injective_map_tendsto
    sequence target compact compactIsCompact sequenceMem rows
  · exact rows.continuous
  · exact wholeRestartFiniteObservedRowsCLM_injective
      (wholeRestartDuration contact) observed
  · exact mappedTendsto

/-- The quantitative finite-observation modulus is now a theorem about the
actual assembled whole unforced path, before any later Fourier quotient or
restart chart can erase it. -/
theorem wholeRestartWholeMildAssembly_fixedWave_increment_sq_le
    {ν : Viscosity}
    {Seed : Type}
    [WholeRestartPhysicalSeed ν Seed]
    {contact : Seed}
    {replay : GeneratedWholeRestartCanonicalReplay contact}
    (closure : GeneratedWholeRestartCriticalClosure replay)
    (wave : IntegerWavevector)
    (waveNonzero : wave ≠ 0)
    (first second : Icc (0 : ℝ) (wholeRestartDuration contact)) :
    dist
        ((wholeRestartWholeMildAssembly closure).wholePath first wave)
        ((wholeRestartWholeMildAssembly closure).wholePath second wave) ^ 2 ≤
      dist first second *
        wholeRestartFiniteObservedHalfHolderEnergy replay {wave} := by
  rw [wholeRestartWholeMildAssembly_fixedWave_eq
      closure wave waveNonzero first,
    wholeRestartWholeMildAssembly_fixedWave_eq
      closure wave waveNonzero second]
  exact
    wholeRestartFixedWaveMildData_increment_sq_le
      closure wave waveNonzero first second

/-- The same actual finite-observation extraction retains the sharper
kinetic velocity-row modulus before the vorticity observation is quotiented.
Its ceiling is generated by the source contact and is independent of the
Galerkin radius. -/
theorem wholeRestartWholeMildAssembly_fixedWave_velocity_increment_le
    {ν : Viscosity}
    {Seed : Type}
    [WholeRestartPhysicalSeed ν Seed]
    {contact : Seed}
    {replay : GeneratedWholeRestartCanonicalReplay contact}
    (closure : GeneratedWholeRestartCriticalClosure replay)
    (wave : IntegerWavevector)
    (waveNonzero : wave ≠ 0)
    (first second : Icc (0 : ℝ) (wholeRestartDuration contact)) :
    dist
        (biotSavartVelocityCoefficient wave
          ((wholeRestartWholeMildAssembly closure).wholePath first wave))
        (biotSavartVelocityCoefficient wave
          ((wholeRestartWholeMildAssembly closure).wholePath second wave)) ≤
      wholeRestartFixedWaveVelocitySpeedCeiling contact wave *
        dist first second := by
  rw [wholeRestartWholeMildAssembly_fixedWave_eq
      closure wave waveNonzero first,
    wholeRestartWholeMildAssembly_fixedWave_eq
      closure wave waveNonzero second]
  exact
    (wholeRestartFixedWaveMildHolderReceipt
      closure wave waveNonzero).velocity_increment_le first second

theorem wholeRestartWholeMildAssembly_toLp_eq
    {ν : Viscosity}
    {Seed : Type}
    [WholeRestartPhysicalSeed ν Seed]
    {contact : Seed}
    {replay : GeneratedWholeRestartCanonicalReplay contact}
    (closure : GeneratedWholeRestartCriticalClosure replay) :
    BoundedContinuousFunction.toLp 2
        (commonTimeMeasure (wholeRestartDuration contact)) ℂ
        (wholeRestartWholeMildAssembly closure).wholePath =
      closure.weakClosure.stateLimit :=
  (wholeRestartWholeMildAssembly closure).wholePath_toLp_eq_stateLimit

theorem wholeRestartWholeMildAssembly_gradient_mass_le
    {ν : Viscosity}
    {Seed : Type}
    [WholeRestartPhysicalSeed ν Seed]
    {contact : Seed}
    {replay : GeneratedWholeRestartCanonicalReplay contact}
    (closure : GeneratedWholeRestartCriticalClosure replay) :
    wholeSpaceTimeVorticityGradientMass
        (wholeRestartDuration contact)
        (BoundedContinuousFunction.toLp 2
          (commonTimeMeasure (wholeRestartDuration contact)) ℂ
          (wholeRestartWholeMildAssembly closure).wholePath) ≤
      wholeRestartGradientCeiling contact := by
  rw [wholeRestartWholeMildAssembly_toLp_eq closure]
  exact closure.gradient_mass_le

end

