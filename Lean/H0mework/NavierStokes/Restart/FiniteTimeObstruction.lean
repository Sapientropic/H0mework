import H0mework.NavierStokes.Restart.NativeRecursion

/-!
# Finite-time obstruction of the native whole-flow restart chain

The generated restart contact now lies in the late half of every actual
whole unforced receipt.  Consequently a bounded accumulated physical time
cannot come from an arbitrary near-zero choice: it forces the source-owned
local existence horizons to collapse.

Because those horizons are the exact reciprocals of the generated local
barrier slopes, finite-time accumulation forces an unbounded barrier.  The
barrier is then split along its actual factors:

```text
finite physical accumulation
→ unbounded source-owned local barrier
→ unbounded whole-vorticity ceiling
  or unbounded generated kernel-core coefficient.
```

No target solution, continuation oracle, cutoff, branch, smallness
parameter, or externally selected horizon enters these theorems.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalVorticityCoefficientGeneratedWholeRestartFiniteTimeObstruction

open Set
open ThreeDimensionalPeriodicFilteredNavierStokesGenerator
open
  ThreeDimensionalVorticityCoefficientInfiniteFixedOutputNonlinearRow
open
  ThreeDimensionalVorticityCoefficientGeneratedWholeRestartCanonicalReplay
open
  ThreeDimensionalVorticityCoefficientGeneratedWholeRestartNativeRecursion
open
  ThreeDimensionalVorticityCoefficientGeneratedWholeRestartNativeRecursion.GeneratedWholeRestartCurrent
open
  ThreeDimensionalVorticityCoefficientSourceOwnedLocalKernelAbsorption
open
  ThreeDimensionalVorticityCoefficientWholeStateSourceOwnedLocalBarrier

noncomputable section

/-- The actual whole-vorticity coefficient mass at the source-selected
physical contact. -/
def restartPhysicalVorticityMass
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) : ℝ :=
  wholeVorticityEuclideanMass
    (run initial index).contact.physicalState

/-- The actual whole-vorticity ceiling that generates the next local
whole-flow horizon at one native restart occurrence. -/
def restartCoefficientCeiling
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) : ℝ :=
  wholeRestartCoefficientCeiling (run initial index).contact

/-- The source-generated finite-core coefficient at one whole restart
occurrence. -/
def restartQuadraticCoefficient
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) : ℝ :=
  sourceOwnedLocalQuadraticCoefficient ν
    (restartCoefficientCeiling initial index)

/-- The exact local barrier whose reciprocal is the next whole-flow
horizon. -/
def restartBarrierSlope
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) : ℝ :=
  sourceOwnedWholeStateBarrierSlope ν
    (restartCoefficientCeiling initial index)

theorem restartCoefficientCeiling_pos
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    0 < restartCoefficientCeiling initial index :=
  wholeRestartCoefficientCeiling_pos (run initial index).contact

theorem restartQuadraticCoefficient_nonneg
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    0 ≤ restartQuadraticCoefficient initial index :=
  sourceOwnedLocalQuadraticCoefficient_nonneg ν
    (restartCoefficientCeiling initial index)

theorem restartBarrierSlope_pos
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    0 < restartBarrierSlope initial index :=
  sourceOwnedWholeStateBarrierSlope_pos ν
    (restartCoefficientCeiling initial index)

/-! ## Source-selected coefficient growth -/

/-- The next actual physical contact stays below the quantized ceiling
generated by the preceding current. -/
theorem restartPhysicalVorticityMass_succ_le_ceiling
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    restartPhysicalVorticityMass initial (index + 1) ≤
      restartCoefficientCeiling initial index := by
  rw [restartPhysicalVorticityMass, restartCoefficientCeiling, run_succ]
  exact nextContact_coefficientMass_le (run initial index)

/-- Quantization cannot create a skipped coefficient level: one native
whole update raises the generated level by at most one. -/
theorem restartCoefficientCeiling_succ_le_add_one
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    restartCoefficientCeiling initial (index + 1) ≤
      restartCoefficientCeiling initial index + 1 := by
  have physicalLe :=
    restartPhysicalVorticityMass_succ_le_ceiling initial index
  have rawLe :
      wholeRestartRawCoefficientCeiling
          (run initial (index + 1)).contact ≤
        ((wholeRestartCoefficientLevel
          (run initial index).contact + 1 : ℕ) : ℝ) := by
    rw [wholeRestartRawCoefficientCeiling_eq]
    calc
      wholeVorticityEuclideanMass
            (run initial (index + 1)).contact.physicalState + 1 ≤
          restartCoefficientCeiling initial index + 1 := by
        change
          restartPhysicalVorticityMass initial (index + 1) + 1 ≤
            restartCoefficientCeiling initial index + 1
        linarith
      _ =
          ((wholeRestartCoefficientLevel
            (run initial index).contact + 1 : ℕ) : ℝ) := by
        simp [restartCoefficientCeiling, wholeRestartCoefficientCeiling]
  have levelLe :
      wholeRestartCoefficientLevel
          (run initial (index + 1)).contact ≤
        wholeRestartCoefficientLevel
          (run initial index).contact + 1 := by
    exact Nat.ceil_le.mpr rawLe
  change
    ((wholeRestartCoefficientLevel
        (run initial (index + 1)).contact : ℕ) : ℝ) ≤
      (wholeRestartCoefficientLevel
        (run initial index).contact : ℝ) + 1
  exact_mod_cast levelLe

/-! ## Exact quantized-cell recurrence -/

/-- The natural-valued restart level before casting it into the real barrier
coordinate. -/
def restartCoefficientLevelNat
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) : ℕ :=
  wholeRestartCoefficientLevel (run initial index).contact

theorem restartCoefficientCeiling_eq_levelNat_cast
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    restartCoefficientCeiling initial index =
      (restartCoefficientLevelNat initial index : ℝ) := rfl

/-- The current physical mass lies below the upper wall of its quantized
cell. -/
theorem restartPhysicalVorticityMass_le_levelNat_sub_one
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    restartPhysicalVorticityMass initial index ≤
      (restartCoefficientLevelNat initial index : ℝ) - 1 := by
  have rawLe :=
    wholeRestartRawCoefficientCeiling_le (run initial index).contact
  change
    restartPhysicalVorticityMass initial index + 1 ≤
      (restartCoefficientLevelNat initial index : ℝ) at rawLe
  linarith

/-- Fractional mass still needed to cross the current cell's upper wall. -/
def restartCoefficientCellGap
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) : ℝ :=
  (restartCoefficientLevelNat initial index : ℝ) - 1 -
    restartPhysicalVorticityMass initial index

theorem restartCoefficientCellGap_nonneg
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    0 ≤ restartCoefficientCellGap initial index := by
  unfold restartCoefficientCellGap
  exact sub_nonneg.mpr
    (restartPhysicalVorticityMass_le_levelNat_sub_one initial index)

theorem restartCoefficientCellGap_lt_one
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    restartCoefficientCellGap initial index < 1 := by
  have massNonneg :
      0 ≤ restartPhysicalVorticityMass initial index := by
    unfold restartPhysicalVorticityMass wholeVorticityEuclideanMass
    exact tsum_nonneg fun wave => sq_nonneg _
  have ceilLt := Nat.ceil_lt_add_one
    (show 0 ≤ restartPhysicalVorticityMass initial index + 1 by linarith)
  change
    (restartCoefficientLevelNat initial index : ℝ) <
      (restartPhysicalVorticityMass initial index + 1) + 1 at ceilLt
  unfold restartCoefficientCellGap
  linarith

/-- With the existing no-upward-skip bound, exact `+1` at the next level is
equivalent to the next mass crossing the upper wall of the current cell. -/
theorem restartCoefficientLevelNat_succ_eq_add_one_iff_mass_crosses_cell
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    restartCoefficientLevelNat initial (index + 1) =
          restartCoefficientLevelNat initial index + 1 ↔
      (restartCoefficientLevelNat initial index : ℝ) - 1 <
        restartPhysicalVorticityMass initial (index + 1) := by
  let level := restartCoefficientLevelNat initial index
  let nextMass := restartPhysicalVorticityMass initial (index + 1)
  have nextMassLe : nextMass ≤ (level : ℝ) := by
    simpa only [nextMass, level,
      restartCoefficientCeiling_eq_levelNat_cast] using
      restartPhysicalVorticityMass_succ_le_ceiling initial index
  change
    Nat.ceil (nextMass + 1) = level + 1 ↔
      (level : ℝ) - 1 < nextMass
  rw [Nat.ceil_eq_iff (Nat.succ_ne_zero level)]
  norm_num [Nat.cast_add]
  constructor
  · rintro ⟨lower, _upper⟩
    linarith
  · intro lower
    exact ⟨by linarith, nextMassLe⟩

/-- Scale-relative form of the same exact crossing: the next segment's whole
mass gain must exceed the fractional gap left in the current ceil cell. -/
theorem restartCoefficientLevelNat_succ_eq_add_one_iff_gain_gt_cellGap
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    restartCoefficientLevelNat initial (index + 1) =
          restartCoefficientLevelNat initial index + 1 ↔
      restartCoefficientCellGap initial index <
        restartPhysicalVorticityMass initial (index + 1) -
          restartPhysicalVorticityMass initial index := by
  rw [restartCoefficientLevelNat_succ_eq_add_one_iff_mass_crosses_cell]
  unfold restartCoefficientCellGap
  constructor <;> intro crossed <;> linarith

/-- Real-valued barrier-coordinate version of the quantized cell law. -/
theorem restartCoefficientCeiling_succ_eq_add_one_iff_mass_crosses_cell
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    restartCoefficientCeiling initial (index + 1) =
          restartCoefficientCeiling initial index + 1 ↔
      restartCoefficientCeiling initial index - 1 <
        restartPhysicalVorticityMass initial (index + 1) := by
  constructor
  · intro equality
    change
      (restartCoefficientLevelNat initial (index + 1) : ℝ) =
        (restartCoefficientLevelNat initial index : ℝ) + 1 at equality
    have levelEquality :
        restartCoefficientLevelNat initial (index + 1) =
          restartCoefficientLevelNat initial index + 1 := by
      exact_mod_cast equality
    exact
      (restartCoefficientLevelNat_succ_eq_add_one_iff_mass_crosses_cell
        initial index).1 levelEquality
  · intro crossed
    have levelEquality :=
      (restartCoefficientLevelNat_succ_eq_add_one_iff_mass_crosses_cell
        initial index).2 crossed
    change
      (restartCoefficientLevelNat initial (index + 1) : ℝ) =
        (restartCoefficientLevelNat initial index : ℝ) + 1
    exact_mod_cast levelEquality

/-- Every actual coefficient level on the native run is bounded by its
initial level plus the number of source-owned writes already performed. -/
theorem restartCoefficientCeiling_le_initial_add_index
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    ∀ index : ℕ,
      restartCoefficientCeiling initial index ≤
        restartCoefficientCeiling initial 0 + index
  | 0 => by simp
  | index + 1 => by
      have step :=
        restartCoefficientCeiling_succ_le_add_one initial index
      have ih :=
        restartCoefficientCeiling_le_initial_add_index initial index
      norm_num [Nat.cast_succ] at *
      linarith

/-- An injective natural-valued scale with no upward skips cannot ever move
down.  A downward step would trap an arbitrarily long injective tail below
one finite level: crossing that level again would revisit an old value, while
remaining below it violates finite pigeonhole. -/
theorem natScale_eq_initial_add_index_of_injective_of_succ_le_add_one
    (scale : ℕ → ℕ)
    (injective : Function.Injective scale)
    (noSkip : ∀ index, scale (index + 1) ≤ scale index + 1) :
    ∀ index, scale index = scale 0 + index := by
  have stepEq : ∀ index, scale (index + 1) = scale index + 1 := by
    intro index
    have sourceNeTarget : scale (index + 1) ≠ scale index := by
      intro equality
      have := injective equality
      omega
    have sourceLtTarget : scale index < scale (index + 1) := by
      by_contra notLt
      have targetLtSource : scale (index + 1) < scale index :=
        Nat.lt_of_le_of_ne (Nat.le_of_not_gt notLt) sourceNeTarget
      have tailLt : ∀ offset : ℕ,
          scale (index + 1 + offset) < scale index := by
        intro offset
        induction offset with
        | zero => simpa using targetLtSource
        | succ offset inductionHypothesis =>
            have nextLe := noSkip (index + 1 + offset)
            have nextLeSource :
                scale (index + 1 + (offset + 1)) ≤ scale index := by
              rw [show index + 1 + (offset + 1) =
                (index + 1 + offset) + 1 by omega]
              exact nextLe.trans (Nat.succ_le_of_lt inductionHypothesis)
            exact lt_of_le_of_ne nextLeSource (by
              intro equality
              have indexEq := injective equality
              omega)
      let trapped : Fin (scale index + 1) → Fin (scale index) := fun offset =>
        ⟨scale (index + 1 + offset.1), tailLt offset.1⟩
      have trappedInjective : Function.Injective trapped := by
        intro left right equality
        have valueEq := congrArg Fin.val equality
        have indexEq := injective valueEq
        apply Fin.ext
        omega
      have cardLe := Fintype.card_le_of_injective trapped trappedInjective
      simp only [Fintype.card_fin] at cardLe
      omega
    exact Nat.le_antisymm (noSkip index)
      (Nat.succ_le_iff.mpr sourceLtTarget)
  intro index
  induction index with
  | zero => simp
  | succ index inductionHypothesis =>
      rw [show index + 1 = index + 1 by rfl, stepEq index,
        inductionHypothesis]
      omega

/-- Conditional exact growth law for the actual quantized restart ceiling.
The injectivity premise is deliberately explicit: causal-visit freshness by
itself does not make this coarse physical projection injective. -/
theorem restartCoefficientCeiling_eq_initial_add_index_of_injective
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (injective : Function.Injective
      (restartCoefficientCeiling initial)) :
    ∀ index : ℕ,
      restartCoefficientCeiling initial index =
        restartCoefficientCeiling initial 0 + index := by
  let scale : ℕ → ℕ := fun index =>
    wholeRestartCoefficientLevel (run initial index).contact
  have scaleInjective : Function.Injective scale := by
    intro left right equality
    apply injective
    change (scale left : ℝ) = (scale right : ℝ)
    exact_mod_cast equality
  have scaleNoSkip : ∀ index, scale (index + 1) ≤ scale index + 1 := by
    intro index
    have ceilingNoSkip :=
      restartCoefficientCeiling_succ_le_add_one initial index
    change (scale (index + 1) : ℝ) ≤ (scale index : ℝ) + 1 at ceilingNoSkip
    exact_mod_cast ceilingNoSkip
  have formula :=
    natScale_eq_initial_add_index_of_injective_of_succ_le_add_one
      scale scaleInjective scaleNoSkip
  intro index
  change (scale index : ℝ) = (scale 0 : ℝ) + index
  exact_mod_cast formula index

/-- The physical coefficient mass itself inherits the same source-owned
linear growth envelope. -/
theorem restartPhysicalVorticityMass_le_initialCeiling_add_index
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    ∀ index : ℕ,
      restartPhysicalVorticityMass initial index ≤
        restartCoefficientCeiling initial 0 + index
  | 0 => by
      apply le_trans _ (le_add_of_nonneg_right (Nat.cast_nonneg 0))
      change
        wholeVorticityEuclideanMass initial.contact.physicalState ≤
          wholeRestartCoefficientCeiling initial.contact
      exact
        (show
          wholeVorticityEuclideanMass initial.contact.physicalState ≤
            wholeRestartRawCoefficientCeiling initial.contact by
              rw [wholeRestartRawCoefficientCeiling_eq]
              simp only [wholeRestartPhysicalState_generatedPositiveWholeRestartContact]
              linarith).trans
          (wholeRestartRawCoefficientCeiling_le initial.contact)
  | index + 1 => by
      have step :=
        restartPhysicalVorticityMass_succ_le_ceiling initial index
      have ih :=
        restartCoefficientCeiling_le_initial_add_index initial index
      norm_num [Nat.cast_succ] at *
      linarith

/-- If accumulated physical time is bounded, the actual source-generated
next horizons become arbitrarily small.  The first, possibly differently
constructed seed receipt is removed internally; every returned horizon is
one generated `wholeRestartDuration`. -/
theorem wholeRestartDuration_arbitrarily_small_of_elapsedTime_bddAbove
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    ∀ ε : ℝ, 0 < ε →
      ∃ index : ℕ,
        wholeRestartDuration (run initial index).contact < ε := by
  intro ε εPos
  let small := min ε (initial.duration / 2)
  have initialDurationPos : 0 < initial.duration :=
    initial.receipt.requestedTimePos
  have smallPos : 0 < small := by
    exact lt_min εPos (half_pos initialDurationPos)
  obtain ⟨stage, stageSmall⟩ :=
    duration_arbitrarily_small_of_elapsedTime_bddAbove
      initial elapsedBounded small smallPos
  have stageNeZero : stage ≠ 0 := by
    intro stageZero
    subst stage
    rw [run_zero] at stageSmall
    have smallLeHalf : small ≤ initial.duration / 2 :=
      min_le_right _ _
    linarith
  obtain ⟨index, rfl⟩ := Nat.exists_eq_succ_of_ne_zero stageNeZero
  have durationLt :
      (run initial (index + 1)).duration < ε :=
    lt_of_lt_of_le stageSmall (min_le_left _ _)
  refine ⟨index, ?_⟩
  simpa only [run_succ, next_duration] using durationLt

/-- A finite physical accumulation forces the exact source-owned local
barrier to exceed every real bound. -/
theorem restartBarrierSlope_unbounded_of_elapsedTime_bddAbove
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    ∀ bound : ℝ,
      ∃ index : ℕ, bound < restartBarrierSlope initial index := by
  intro bound
  let target := max bound 0 + 1
  have targetPos : 0 < target := by
    dsimp only [target]
    linarith [le_max_right bound 0]
  let small := 1 / (2 * target)
  have smallPos : 0 < small := by
    exact one_div_pos.mpr (mul_pos (by norm_num) targetPos)
  obtain ⟨index, horizonSmall⟩ :=
    wholeRestartDuration_arbitrarily_small_of_elapsedTime_bddAbove
      initial elapsedBounded small smallPos
  have slopePos : 0 < restartBarrierSlope initial index :=
    restartBarrierSlope_pos initial index
  have reciprocalLt :
      1 / (2 * restartBarrierSlope initial index) <
        1 / (2 * target) := by
    simpa only [wholeRestartDuration, sourceOwnedWholeStateDuration,
      restartBarrierSlope, restartCoefficientCeiling, small] using
      horizonSmall
  have targetLtSlope : target < restartBarrierSlope initial index := by
    have doubled :
        2 * target < 2 * restartBarrierSlope initial index :=
      lt_of_one_div_lt_one_div
        (mul_pos (by norm_num) slopePos) reciprocalLt
    linarith
  exact ⟨index, lt_of_le_of_lt (le_max_left bound 0 |>.trans <|
    le_add_of_nonneg_right zero_le_one) targetLtSlope⟩

theorem restartBarrierSlope_not_bddAbove_of_elapsedTime_bddAbove
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    ¬ BddAbove (Set.range (restartBarrierSlope initial)) := by
  rintro ⟨bound, boundUpper⟩
  obtain ⟨index, indexLarge⟩ :=
    restartBarrierSlope_unbounded_of_elapsedTime_bddAbove
      initial elapsedBounded bound
  exact (not_lt_of_ge (boundUpper ⟨index, rfl⟩)) indexLarge

/-- If both actual factors of the local barrier remain bounded, then the
barrier itself remains bounded. -/
theorem restartBarrierSlope_bddAbove_of_factors_bddAbove
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (ceilingBounded :
      BddAbove (Set.range (restartCoefficientCeiling initial)))
    (coefficientBounded :
      BddAbove (Set.range (restartQuadraticCoefficient initial))) :
    BddAbove (Set.range (restartBarrierSlope initial)) := by
  rcases ceilingBounded with ⟨ceilingBound, ceilingUpper⟩
  rcases coefficientBounded with
    ⟨coefficientBound, coefficientUpper⟩
  refine
    ⟨max coefficientBound 0 * (max ceilingBound 0) ^ 2 + 1, ?_⟩
  rintro _ ⟨index, rfl⟩
  have ceilingNonneg :
      0 ≤ restartCoefficientCeiling initial index :=
    (restartCoefficientCeiling_pos initial index).le
  have ceilingLe :
      restartCoefficientCeiling initial index ≤
        max ceilingBound 0 :=
    (ceilingUpper ⟨index, rfl⟩).trans
      (le_max_left ceilingBound 0)
  have coefficientNonneg :
      0 ≤ restartQuadraticCoefficient initial index :=
    restartQuadraticCoefficient_nonneg initial index
  have coefficientLe :
      restartQuadraticCoefficient initial index ≤
        max coefficientBound 0 :=
    (coefficientUpper ⟨index, rfl⟩).trans
      (le_max_left coefficientBound 0)
  have squareLe :
      restartCoefficientCeiling initial index ^ 2 ≤
        (max ceilingBound 0) ^ 2 :=
    (sq_le_sq₀ ceilingNonneg (le_max_right ceilingBound 0)).2
      ceilingLe
  have productLe :
      restartQuadraticCoefficient initial index *
          restartCoefficientCeiling initial index ^ 2 ≤
        max coefficientBound 0 * (max ceilingBound 0) ^ 2 :=
    mul_le_mul coefficientLe squareLe
      (sq_nonneg _) (le_max_right coefficientBound 0)
  simp only [restartBarrierSlope,
    sourceOwnedWholeStateBarrierSlope,
    restartQuadraticCoefficient, restartCoefficientCeiling] at productLe ⊢
  nlinarith

/-- Quantized whole restart ceilings can visit only finitely many levels
when the underlying physical masses are bounded. -/
theorem restartCoefficientCeiling_bddAbove_of_physicalMass_bddAbove
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (physicalBounded :
      BddAbove (Set.range (restartPhysicalVorticityMass initial))) :
    BddAbove (Set.range (restartCoefficientCeiling initial)) := by
  rcases physicalBounded with ⟨physicalBound, physicalUpper⟩
  let rawBound := max (physicalBound + 1) 0
  let levelBound := Nat.ceil rawBound
  refine ⟨(levelBound : ℝ), ?_⟩
  rintro _ ⟨index, rfl⟩
  have physicalLe :
      restartPhysicalVorticityMass initial index ≤ physicalBound :=
    physicalUpper ⟨index, rfl⟩
  change
    wholeVorticityEuclideanMass
        (run initial index).contact.physicalState ≤
      physicalBound at physicalLe
  have rawLe :
      wholeRestartRawCoefficientCeiling (run initial index).contact ≤
        rawBound := by
    rw [wholeRestartRawCoefficientCeiling_eq]
    simp only [wholeRestartPhysicalState_generatedPositiveWholeRestartContact]
    dsimp only [rawBound]
    nlinarith [le_max_left (physicalBound + 1) 0]
  have levelLe :
      wholeRestartCoefficientLevel (run initial index).contact ≤
        levelBound := by
    exact Nat.ceil_le_ceil rawLe
  change
    (wholeRestartCoefficientLevel (run initial index).contact : ℝ) ≤
      (levelBound : ℝ)
  exact_mod_cast levelLe

/-- Once the whole restart ceiling is quantized, bounded physical ceilings
force the generated kernel-core coefficient to range over a finite set. -/
theorem restartQuadraticCoefficient_bddAbove_of_ceiling_bddAbove
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (ceilingBounded :
      BddAbove (Set.range (restartCoefficientCeiling initial))) :
    BddAbove (Set.range (restartQuadraticCoefficient initial)) := by
  rcases ceilingBounded with ⟨ceilingBound, ceilingUpper⟩
  let levelBound := Nat.ceil (max ceilingBound 0)
  let coefficientBound :=
    ∑ level ∈ Finset.range (levelBound + 1),
      sourceOwnedLocalQuadraticCoefficient ν (level : ℝ)
  refine ⟨coefficientBound, ?_⟩
  rintro _ ⟨index, rfl⟩
  let level :=
    wholeRestartCoefficientLevel (run initial index).contact
  have levelCastLe : (level : ℝ) ≤ max ceilingBound 0 := by
    have ceilingLe :
        restartCoefficientCeiling initial index ≤ ceilingBound :=
      ceilingUpper ⟨index, rfl⟩
    simpa only [restartCoefficientCeiling,
      wholeRestartCoefficientCeiling, level] using
      ceilingLe.trans (le_max_left ceilingBound 0)
  have levelLe : level ≤ levelBound := by
    have castLe : (level : ℝ) ≤ (levelBound : ℝ) :=
      levelCastLe.trans (Nat.le_ceil (max ceilingBound 0))
    exact_mod_cast castLe
  have levelMem : level ∈ Finset.range (levelBound + 1) :=
    Finset.mem_range.mpr (Nat.lt_succ_of_le levelLe)
  change
    sourceOwnedLocalQuadraticCoefficient ν (level : ℝ) ≤
      ∑ later ∈ Finset.range (levelBound + 1),
        sourceOwnedLocalQuadraticCoefficient ν (later : ℝ)
  exact Finset.single_le_sum
    (f := fun later : ℕ =>
      sourceOwnedLocalQuadraticCoefficient ν (later : ℝ))
    (s := Finset.range (levelBound + 1))
    (fun later laterMem =>
      sourceOwnedLocalQuadraticCoefficient_nonneg ν (later : ℝ))
    levelMem

/-- Main finite-time hard-gate reduction.  If the native whole-flow write
chain accumulates in finite physical time, then either the actual
whole-vorticity ceiling diverges or the source-generated kernel-core
coefficient diverges.  There is no third silent accumulation branch. -/
theorem elapsedTime_bddAbove_forces_physical_or_kernel_cascade
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    ¬ BddAbove (Set.range (restartCoefficientCeiling initial)) ∨
      ¬ BddAbove (Set.range (restartQuadraticCoefficient initial)) := by
  by_contra bothBounded
  push Not at bothBounded
  exact
    (restartBarrierSlope_not_bddAbove_of_elapsedTime_bddAbove
      initial elapsedBounded)
      (restartBarrierSlope_bddAbove_of_factors_bddAbove
        initial bothBounded.1 bothBounded.2)

/-- The quantized native producer removes the kernel-choice escape: bounded
accumulated time forces the actual whole-vorticity mass itself to be
unbounded along generated contacts. -/
theorem elapsedTime_bddAbove_forces_physicalVorticityMass_unbounded
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    ¬ BddAbove (Set.range (restartPhysicalVorticityMass initial)) := by
  intro physicalBounded
  have ceilingBounded :=
    restartCoefficientCeiling_bddAbove_of_physicalMass_bddAbove
      initial physicalBounded
  have coefficientBounded :=
    restartQuadraticCoefficient_bddAbove_of_ceiling_bddAbove
      initial ceilingBounded
  exact
    (restartBarrierSlope_not_bddAbove_of_elapsedTime_bddAbove
      initial elapsedBounded)
      (restartBarrierSlope_bddAbove_of_factors_bddAbove
        initial ceilingBounded coefficientBounded)

/-- Premise-free source exhaustion: the generated whole-flow time axis is
unbounded, or one of the two concrete PDE/source cascade observables is
unbounded. -/
theorem elapsedTime_unbounded_or_physical_or_kernel_cascade
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    ¬ BddAbove (Set.range (elapsedTime initial)) ∨
      ¬ BddAbove (Set.range (restartCoefficientCeiling initial)) ∨
        ¬ BddAbove
          (Set.range (restartQuadraticCoefficient initial)) := by
  by_cases elapsedBounded :
      BddAbove (Set.range (elapsedTime initial))
  · exact Or.inr
      (elapsedTime_bddAbove_forces_physical_or_kernel_cascade
        initial elapsedBounded)
  · exact Or.inl elapsedBounded

/-- Authoritative two-branch exhaustion of the actual whole-flow recursion:
either its generated physical time reaches arbitrarily far, or the actual
whole-vorticity coefficient mass is unbounded along the same contacts. -/
theorem elapsedTime_unbounded_or_physicalVorticityMass_unbounded
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    ¬ BddAbove (Set.range (elapsedTime initial)) ∨
      ¬ BddAbove
        (Set.range (restartPhysicalVorticityMass initial)) := by
  by_cases elapsedBounded :
      BddAbove (Set.range (elapsedTime initial))
  · exact Or.inr
      (elapsedTime_bddAbove_forces_physicalVorticityMass_unbounded
        initial elapsedBounded)
  · exact Or.inl elapsedBounded

end

end ThreeDimensionalVorticityCoefficientGeneratedWholeRestartFiniteTimeObstruction
