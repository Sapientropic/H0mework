/-! ## Same-receipt weighted states -/

/-- Pointwise gradient summability forced by the receipt's whole gradient
carrier. -/
theorem receiptPointwiseGradient_ae_summable
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime) :
    ∀ᵐ time ∂(commonTimeMeasure requestedTime),
      Summable fun wave : IntegerWavevector =>
        integerWaveNormSq wave *
          complexCoordinateAmplitudeSq (receipt.stateLimit time wave) :=
  wholePointwiseGradientDensity_ae_summable
    requestedTime receipt.stateLimit receipt.gradient_summable

/-- The actual inverse-Laplacian weighted viscous row of one receipt. -/
def receiptViscousNegativeOneState
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime) :
    SpaceTimeState requestedTime :=
  wholeSpaceTimeViscousNegativeOneState
    ν.coeff receipt.stateLimit receipt.gradient_summable
      (receiptPointwiseGradient_ae_summable receipt)

/-- The receipt's actual nonlinear negative-one state.  The unforced update
law generates it as tangent plus viscous row; no coefficient ceiling or
external forcing certificate is introduced. -/
def receiptNonlinearNegativeOneState
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime) :
    SpaceTimeState requestedTime :=
  receipt.wholeTangent + receiptViscousNegativeOneState receipt

theorem receiptStateLimit_eq_wholePath_ae
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime) :
    ∀ᵐ time ∂(commonTimeMeasure requestedTime),
      receipt.stateLimit time = receipt.wholePath time := by
  rw [← receipt.wholePath_toLp_eq_stateLimit]
  exact
    BoundedContinuousFunction.coeFn_toLp
      (p := (2 : ℝ≥0∞))
      (μ := commonTimeMeasure requestedTime) ℂ receipt.wholePath

/-- The weighted viscous state is pointwise the physical gradient row. -/
theorem receiptViscousNegativeOneState_row_ae
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (wave : IntegerWavevector) :
    ∀ᵐ time ∂(commonTimeMeasure requestedTime),
      (receiptViscousNegativeOneState receipt time) wave =
        (ν.coeff * Real.sqrt (integerWaveViscousMultiplier wave)) •
          receipt.wholePath time wave := by
  filter_upwards [
    wholeSpaceTimeViscousNegativeOneState_coeFn
      ν.coeff receipt.stateLimit receipt.gradient_summable
        (receiptPointwiseGradient_ae_summable receipt),
    receiptPointwiseGradient_ae_summable receipt,
    receiptStateLimit_eq_wholePath_ae receipt] with
      time viscousEq timeGradientSummable stateEq
  rw [receiptViscousNegativeOneState,
    viscousEq,
    wholeSpaceTimeViscousNegativeOneFunction_of_summable
      ν.coeff receipt.stateLimit time timeGradientSummable,
    wholeStateVorticityViscousNegativeOneState_apply,
    wholeStateVorticityViscousNegativeOneWeightedCoefficient,
    stateEq]

/-- Unweighting the generated nonlinear negative-one row recovers the actual
quadratic Fourier coefficient of the same receipt. -/
theorem receiptNonlinearNegativeOneState_row_ae
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (wave : IntegerWavevector)
    (waveNonzero : wave ≠ 0) :
    ∀ᵐ time ∂(commonTimeMeasure requestedTime),
      (Real.sqrt (integerWaveViscousMultiplier wave) : ℝ) •
          (receiptNonlinearNegativeOneState receipt time) wave =
        wholeStateVorticityBilinearCoefficientAt
          (receipt.transverseLimit time).1
          (receipt.transverseLimit time).1 wave := by
  filter_upwards [
    MeasureTheory.Lp.coeFn_add
      receipt.wholeTangent (receiptViscousNegativeOneState receipt),
    receipt.rowTangent_eq_wholeTangent_ae wave waveNonzero,
    receipt.rowTangent_eq_unforced_ae wave waveNonzero,
    wholeSpaceTimeViscousNegativeOneState_unweighted_row_ae
      ν.coeff receipt.stateLimit receipt.gradient_summable
        (receiptPointwiseGradient_ae_summable receipt) wave,
    receiptStateLimit_eq_wholePath_ae receipt] with
      time nonlinearEq tangentEq rowEq viscousEq stateEq
  rw [receiptNonlinearNegativeOneState,
    nonlinearEq]
  change
    (Real.sqrt (integerWaveViscousMultiplier wave) : ℝ) •
        ((receipt.wholeTangent time) wave +
          (receiptViscousNegativeOneState receipt time) wave) = _
  rw [smul_add]
  have tangentEqReal :
      (Real.sqrt (integerWaveViscousMultiplier wave) : ℝ) •
          (receipt.wholeTangent time) wave =
        receipt.rowTangent wave waveNonzero time := by
    ext coordinate
    have coordinateEq := congr_fun tangentEq coordinate
    simpa only [Pi.smul_apply, Complex.real_smul, smul_eq_mul]
      using coordinateEq
  have viscousEq' :
      (Real.sqrt (integerWaveViscousMultiplier wave) : ℝ) •
          (receiptViscousNegativeOneState receipt time) wave =
        (ν.coeff * integerWaveViscousMultiplier wave) •
          receipt.stateLimit time wave := by
    simpa only [receiptViscousNegativeOneState] using viscousEq
  rw [tangentEqReal, viscousEq', rowEq, stateEq]
  abel

/-! ## Whole space-time Cauchy payment -/

theorem spaceTime_norm_mul_norm_integrable
    (requestedTime : ℝ)
    (left right : SpaceTimeState requestedTime) :
    Integrable
      (fun time => ‖left time‖ * ‖right time‖)
      (commonTimeMeasure requestedTime) := by
  have leftSqIntegrable :
      Integrable (fun time => ‖left time‖ ^ 2)
        (commonTimeMeasure requestedTime) :=
    (MeasureTheory.Lp.memLp left).integrable_norm_pow (by norm_num)
  have rightSqIntegrable :
      Integrable (fun time => ‖right time‖ ^ 2)
        (commonTimeMeasure requestedTime) :=
    (MeasureTheory.Lp.memLp right).integrable_norm_pow (by norm_num)
  have envelopeIntegrable :
      Integrable
        (fun time =>
          (1 / 2 : ℝ) *
            (‖left time‖ ^ 2 + ‖right time‖ ^ 2))
        (commonTimeMeasure requestedTime) :=
    (leftSqIntegrable.add rightSqIntegrable).const_mul (1 / 2 : ℝ)
  apply envelopeIntegrable.mono'
  · exact
      (MeasureTheory.Lp.aestronglyMeasurable left).norm.mul
        (MeasureTheory.Lp.aestronglyMeasurable right).norm
  · filter_upwards with time
    rw [Real.norm_eq_abs,
      abs_of_nonneg (mul_nonneg (norm_nonneg _) (norm_nonneg _))]
    have square := sq_nonneg (‖left time‖ - ‖right time‖)
    nlinarith

theorem spaceTime_integral_norm_mul_norm_le
    (requestedTime : ℝ)
    (left right : SpaceTimeState requestedTime) :
    (∫ time,
        ‖left time‖ * ‖right time‖
          ∂(commonTimeMeasure requestedTime)) ≤
      ‖left‖ * ‖right‖ := by
  have leftMem :
      MemLp (fun time => left time)
        (ENNReal.ofReal (2 : ℝ))
        (commonTimeMeasure requestedTime) := by
    simpa using MeasureTheory.Lp.memLp left
  have rightMem :
      MemLp (fun time => right time)
        (ENNReal.ofReal (2 : ℝ))
        (commonTimeMeasure requestedTime) := by
    simpa using MeasureTheory.Lp.memLp right
  have cauchy :=
    integral_mul_norm_le_Lp_mul_Lq
      Real.HolderConjugate.two_two leftMem rightMem
  have leftIntegral :
      (∫ time, ‖left time‖ ^ 2
          ∂(commonTimeMeasure requestedTime)) = ‖left‖ ^ 2 := by
    exact (spaceTime_norm_sq_eq_integral requestedTime left).symm
  have rightIntegral :
      (∫ time, ‖right time‖ ^ 2
          ∂(commonTimeMeasure requestedTime)) = ‖right‖ ^ 2 := by
    exact (spaceTime_norm_sq_eq_integral requestedTime right).symm
  norm_num [Real.rpow_two] at cauchy
  rw [leftIntegral, rightIntegral] at cauchy
  have leftRoot :
      (‖left‖ ^ 2) ^ (1 / 2 : ℝ) = ‖left‖ := by
    have rootIdentity :=
      Real.pow_rpow_inv_natCast
        (norm_nonneg left) (by norm_num : (2 : ℕ) ≠ 0)
    norm_num at rootIdentity ⊢
    exact rootIdentity
  have rightRoot :
      (‖right‖ ^ 2) ^ (1 / 2 : ℝ) = ‖right‖ := by
    have rootIdentity :=
      Real.pow_rpow_inv_natCast
        (norm_nonneg right) (by norm_num : (2 : ℕ) ≠ 0)
    norm_num at rootIdentity ⊢
    exact rootIdentity
  simpa only [leftRoot, rightRoot] using cauchy

/-- Frequency Cauchy--Schwarz on an arbitrary finite output inventory.
The bound is the norm of the complete whole state, so no cutoff survives in
the theorem's right-hand side. -/
theorem finite_sum_row_norm_mul_norm_le
    (requestedTime : ℝ)
    (left right : SpaceTimeState requestedTime)
    (time : Icc (0 : ℝ) requestedTime)
    (outputs : Finset IntegerWavevector) :
    (∑ wave ∈ outputs,
        ‖left time wave‖ * ‖right time wave‖) ≤
      ‖left time‖ * ‖right time‖ := by
  have cauchy :=
    Real.sum_mul_le_sqrt_mul_sqrt outputs
      (fun wave => ‖left time wave‖)
      (fun wave => ‖right time wave‖)
  have leftHasSum :
      HasSum (fun wave : IntegerWavevector => ‖left time wave‖ ^ 2)
        (‖left time‖ ^ 2) := by
    simpa only [ENNReal.toReal_ofNat, Real.rpow_two] using
      (lp.hasSum_norm
        (p := (2 : ℝ≥0∞)) (by norm_num) (left time))
  have rightHasSum :
      HasSum (fun wave : IntegerWavevector => ‖right time wave‖ ^ 2)
        (‖right time‖ ^ 2) := by
    simpa only [ENNReal.toReal_ofNat, Real.rpow_two] using
      (lp.hasSum_norm
        (p := (2 : ℝ≥0∞)) (by norm_num) (right time))
  have leftFiniteLe :
      (∑ wave ∈ outputs, ‖left time wave‖ ^ 2) ≤
        ‖left time‖ ^ 2 := by
    rw [← leftHasSum.tsum_eq]
    exact leftHasSum.summable.sum_le_tsum outputs
      (fun wave _waveNotMem => sq_nonneg _)
  have rightFiniteLe :
      (∑ wave ∈ outputs, ‖right time wave‖ ^ 2) ≤
        ‖right time‖ ^ 2 := by
    rw [← rightHasSum.tsum_eq]
    exact rightHasSum.summable.sum_le_tsum outputs
      (fun wave _waveNotMem => sq_nonneg _)
  have leftSqrtLe :
      Real.sqrt (∑ wave ∈ outputs, ‖left time wave‖ ^ 2) ≤
        ‖left time‖ := by
    rw [← Real.sqrt_sq (norm_nonneg (left time))]
    exact Real.sqrt_le_sqrt leftFiniteLe
  have rightSqrtLe :
      Real.sqrt (∑ wave ∈ outputs, ‖right time wave‖ ^ 2) ≤
        ‖right time‖ := by
    rw [← Real.sqrt_sq (norm_nonneg (right time))]
    exact Real.sqrt_le_sqrt rightFiniteLe
  exact cauchy.trans
    (mul_le_mul leftSqrtLe rightSqrtLe
      (Real.sqrt_nonneg _) (norm_nonneg _))

/-! ## Physical output work on the weighted carrier -/

theorem receiptWholeNonlinearPower_aestronglyMeasurable
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (wave : IntegerWavevector) :
    AEStronglyMeasurable
      (fun time : Icc (0 : ℝ) requestedTime =>
        2 * complexCoordinateRealInner
          (receipt.wholePath time wave)
          (wholeStateVorticityBilinearCoefficientAt
            (receipt.transverseLimit time).1
            (receipt.transverseLimit time).1 wave))
      (commonTimeMeasure requestedTime) := by
  have pathMeasurable :
      AEStronglyMeasurable
        (fun time : Icc (0 : ℝ) requestedTime =>
          receipt.wholePath time wave)
        (commonTimeMeasure requestedTime) :=
    ((lp.evalCLM ℂ
      (fun _ : IntegerWavevector => ComplexCoordinateVector)
      2 wave).continuous.comp
        receipt.wholePath.continuous).aestronglyMeasurable
  have nonlinearMeasurable :
      AEStronglyMeasurable
        (fun time : Icc (0 : ℝ) requestedTime =>
          wholeStateVorticityBilinearCoefficientAt
            (receipt.transverseLimit time).1
            (receipt.transverseLimit time).1 wave)
        (commonTimeMeasure requestedTime) := by
    apply
      (transverseSpaceTimeNonlinearRowFunction_aestronglyMeasurable
        receipt.transverseLimit wave).congr
    filter_upwards with time
    exact
      (wholeStateVorticityBilinearCoefficientAt_self
        (receipt.transverseLimit time).1 wave).symm
  exact
    (continuous_const.mul complexCoordinateRealInner_prod_continuous)
      |>.comp_aestronglyMeasurable
        (pathMeasurable.prodMk nonlinearMeasurable)

/-- Pointwise physical nonlinear power is paid by the two weighted rows of
the identical unforced receipt. -/
theorem receiptWholeNonlinearPower_abs_ae_le
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (wave : IntegerWavevector)
    (waveNonzero : wave ≠ 0) :
    ∀ᵐ time ∂(commonTimeMeasure requestedTime),
      |2 * complexCoordinateRealInner
          (receipt.wholePath time wave)
          (wholeStateVorticityBilinearCoefficientAt
            (receipt.transverseLimit time).1
            (receipt.transverseLimit time).1 wave)| ≤
        (6 / ν.coeff) *
          (‖(receiptViscousNegativeOneState receipt time) wave‖ *
            ‖(receiptNonlinearNegativeOneState receipt time) wave‖) := by
  filter_upwards [
    receiptViscousNegativeOneState_row_ae receipt wave,
    receiptNonlinearNegativeOneState_row_ae
      receipt wave waveNonzero] with
      time viscousEq nonlinearEq
  rw [← nonlinearEq]
  have pairingBound :=
    abs_complexCoordinateRealInner_le_three_mul_norm
      (receipt.wholePath time wave)
      ((Real.sqrt (integerWaveViscousMultiplier wave) : ℝ) •
        (receiptNonlinearNegativeOneState receipt time) wave)
  have multiplierNonneg :
      0 ≤ Real.sqrt (integerWaveViscousMultiplier wave) :=
    Real.sqrt_nonneg _
  have viscosityNonneg : 0 ≤ ν.coeff := ν.coeff_pos.le
  calc
    |2 * complexCoordinateRealInner
          (receipt.wholePath time wave)
          ((Real.sqrt (integerWaveViscousMultiplier wave) : ℝ) •
            (receiptNonlinearNegativeOneState receipt time) wave)| =
        2 *
          |complexCoordinateRealInner
            (receipt.wholePath time wave)
            ((Real.sqrt (integerWaveViscousMultiplier wave) : ℝ) •
              (receiptNonlinearNegativeOneState receipt time) wave)| := by
      rw [abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
    _ ≤
        2 *
          (3 * ‖receipt.wholePath time wave‖ *
            ‖(Real.sqrt (integerWaveViscousMultiplier wave) : ℝ) •
              (receiptNonlinearNegativeOneState receipt time) wave‖) := by
      exact mul_le_mul_of_nonneg_left pairingBound (by norm_num)
    _ =
        6 * Real.sqrt (integerWaveViscousMultiplier wave) *
          ‖receipt.wholePath time wave‖ *
          ‖(receiptNonlinearNegativeOneState receipt time) wave‖ := by
      rw [norm_smul, Real.norm_eq_abs,
        abs_of_nonneg multiplierNonneg]
      ring
    _ =
        (6 / ν.coeff) *
          (‖(receiptViscousNegativeOneState receipt time) wave‖ *
            ‖(receiptNonlinearNegativeOneState receipt time) wave‖) := by
      rw [viscousEq, norm_smul, Real.norm_eq_abs,
        abs_of_nonneg (mul_nonneg viscosityNonneg multiplierNonneg)]
      field_simp [ne_of_gt ν.coeff_pos]

/-- The literal interval work is the common-time integral of the actual
whole row. -/
theorem actualWholeRowBilinearWork_eq_commonTimeIntegral
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (wave : IntegerWavevector)
    (waveNonzero : wave ≠ 0) :
    actualWholeRowBilinearWork receipt wave =
      ∫ time,
        2 * complexCoordinateRealInner
          (receipt.wholePath time wave)
          (wholeStateVorticityBilinearCoefficientAt
            (receipt.transverseLimit time).1
            (receipt.transverseLimit time).1 wave)
        ∂(commonTimeMeasure requestedTime) := by
  unfold actualWholeRowBilinearWork
  simp only [dif_neg waveNonzero]
  rw [← commonTime_integral_eq_intervalIntegral
    requestedTime receipt.requestedTimePos.le]
  apply integral_congr_ae
  filter_upwards with time
  rw [receipt.rowExtension_on_interval wave waveNonzero time]
  rw [commonTimeZeroExtension_of_mem
    requestedTime
    (fun time =>
      wholeStateVorticityBilinearCoefficientAt
        (receipt.transverseLimit time).1
        (receipt.transverseLimit time).1 wave)
    time.1 time.2]

/-- One output row's nonnegative weighted payment density. -/
def receiptRowDualDensity
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (wave : IntegerWavevector)
  (time : Icc (0 : ℝ) requestedTime) : ℝ :=
  (6 / ν.coeff) *
    (‖(receiptViscousNegativeOneState receipt time) wave‖ *
      ‖(receiptNonlinearNegativeOneState receipt time) wave‖)

theorem receiptRowDualDensity_nonneg
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (wave : IntegerWavevector)
    (time : Icc (0 : ℝ) requestedTime) :
    0 ≤ receiptRowDualDensity receipt wave time := by
  unfold receiptRowDualDensity
  exact mul_nonneg
    (div_nonneg (by norm_num) ν.coeff_pos.le)
    (mul_nonneg (norm_nonneg _) (norm_nonneg _))

theorem receiptRowDualDensity_integrable
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (wave : IntegerWavevector) :
    Integrable (receiptRowDualDensity receipt wave)
      (commonTimeMeasure requestedTime) := by
  let viscous := receiptViscousNegativeOneState receipt
  let nonlinear := receiptNonlinearNegativeOneState receipt
  have fullIntegrable :=
    (spaceTime_norm_mul_norm_integrable
      requestedTime viscous nonlinear).const_mul
        (6 / ν.coeff)
  apply fullIntegrable.mono'
  · change AEStronglyMeasurable
      (fun time =>
        (6 / ν.coeff) *
          (‖viscous time wave‖ * ‖nonlinear time wave‖))
      (commonTimeMeasure requestedTime)
    exact
      ((lp.evalCLM ℂ
        (fun _ : IntegerWavevector => ComplexCoordinateVector)
        2 wave).continuous.comp_aestronglyMeasurable
          (MeasureTheory.Lp.aestronglyMeasurable viscous)).norm
        |>.mul
          ((lp.evalCLM ℂ
            (fun _ : IntegerWavevector => ComplexCoordinateVector)
            2 wave).continuous.comp_aestronglyMeasurable
              (MeasureTheory.Lp.aestronglyMeasurable nonlinear)).norm
        |>.const_mul (6 / ν.coeff)
  · filter_upwards with time
    have coefficientNonneg : 0 ≤ 6 / ν.coeff :=
      div_nonneg (by norm_num) ν.coeff_pos.le
    have viscousRowLe :
        ‖viscous time wave‖ ≤ ‖viscous time‖ :=
      (lp.norm_apply_le_norm
        (p := (2 : ℝ≥0∞)) (by norm_num) (viscous time) wave)
    have nonlinearRowLe :
        ‖nonlinear time wave‖ ≤ ‖nonlinear time‖ :=
      (lp.norm_apply_le_norm
        (p := (2 : ℝ≥0∞)) (by norm_num) (nonlinear time) wave)
    rw [Real.norm_eq_abs,
      abs_of_nonneg (receiptRowDualDensity_nonneg receipt wave time)]
    unfold receiptRowDualDensity
    simpa only [viscous, nonlinear] using mul_le_mul_of_nonneg_left
      (mul_le_mul viscousRowLe nonlinearRowLe
        (norm_nonneg _) (norm_nonneg _))
      coefficientNonneg

/-- Every actual output row is paid before the output quotient by the
weighted whole-carrier density of the same receipt. -/
theorem max_actualWholeRowBilinearWork_le_integral_dualDensity
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (wave : IntegerWavevector) :
    max (actualWholeRowBilinearWork receipt wave) 0 ≤
      ∫ time, receiptRowDualDensity receipt wave time
        ∂(commonTimeMeasure requestedTime) := by
  by_cases waveZero : wave = 0
  · subst wave
    have workZero : actualWholeRowBilinearWork receipt 0 = 0 := by
      simp [actualWholeRowBilinearWork]
    rw [workZero, max_eq_right le_rfl]
    exact MeasureTheory.integral_nonneg fun time =>
      receiptRowDualDensity_nonneg receipt 0 time
  · let power := fun time : Icc (0 : ℝ) requestedTime =>
      2 * complexCoordinateRealInner
        (receipt.wholePath time wave)
        (wholeStateVorticityBilinearCoefficientAt
          (receipt.transverseLimit time).1
          (receipt.transverseLimit time).1 wave)
    have densityIntegrable :=
      receiptRowDualDensity_integrable receipt wave
    have pointwiseBound :=
      receiptWholeNonlinearPower_abs_ae_le
        receipt wave waveZero
    have powerIntegrable :
        Integrable power (commonTimeMeasure requestedTime) := by
      apply densityIntegrable.mono'
      · exact receiptWholeNonlinearPower_aestronglyMeasurable receipt wave
      · filter_upwards [pointwiseBound] with time bound
        rw [Real.norm_eq_abs]
        exact bound
    rw [actualWholeRowBilinearWork_eq_commonTimeIntegral
      receipt wave waveZero]
    change max (∫ time, power time
      ∂(commonTimeMeasure requestedTime)) 0 ≤ _
    calc
      max (∫ time, power time
            ∂(commonTimeMeasure requestedTime)) 0 ≤
          |∫ time, power time
            ∂(commonTimeMeasure requestedTime)| :=
        max_le (le_abs_self _) (abs_nonneg _)
      _ =
          ‖∫ time, power time
            ∂(commonTimeMeasure requestedTime)‖ :=
        (Real.norm_eq_abs _).symm
      _ ≤
          ∫ time, ‖power time‖
            ∂(commonTimeMeasure requestedTime) :=
        norm_integral_le_integral_norm power
      _ ≤
          ∫ time, receiptRowDualDensity receipt wave time
            ∂(commonTimeMeasure requestedTime) := by
        exact integral_mono_ae powerIntegrable.norm
          densityIntegrable pointwiseBound

/-- Every finite output family is paid by the complete whole-carrier
`H¹--H⁻¹` action.  All exact input-pair interference has already occurred. -/
theorem finite_sum_positiveOutputWork_le_dualBudget
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (outputs : Finset IntegerWavevector) :
    (∑ wave ∈ outputs,
        max (actualWholeRowBilinearWork receipt wave) 0) ≤
      (6 / ν.coeff) *
        (‖receiptViscousNegativeOneState receipt‖ *
          ‖receiptNonlinearNegativeOneState receipt‖) := by
  let viscous := receiptViscousNegativeOneState receipt
  let nonlinear := receiptNonlinearNegativeOneState receipt
  have coefficientNonneg : 0 ≤ 6 / ν.coeff :=
    div_nonneg (by norm_num) ν.coeff_pos.le
  have eachDensityIntegrable :
      ∀ wave ∈ outputs,
        Integrable (receiptRowDualDensity receipt wave)
          (commonTimeMeasure requestedTime) :=
    fun wave _waveMem => receiptRowDualDensity_integrable receipt wave
  have sumDensityIntegrable :
      Integrable
        (fun time =>
          ∑ wave ∈ outputs,
            receiptRowDualDensity receipt wave time)
        (commonTimeMeasure requestedTime) := by
    clear eachDensityIntegrable
    induction outputs using Finset.induction_on with
    | empty => simp
    | @insert wave outputs waveNotMem inductionHypothesis =>
        simp only [Finset.sum_insert waveNotMem]
        exact
          (receiptRowDualDensity_integrable receipt wave).add
            inductionHypothesis
  calc
    (∑ wave ∈ outputs,
        max (actualWholeRowBilinearWork receipt wave) 0) ≤
        ∑ wave ∈ outputs,
          ∫ time, receiptRowDualDensity receipt wave time
            ∂(commonTimeMeasure requestedTime) := by
      exact Finset.sum_le_sum fun wave _waveMem =>
        max_actualWholeRowBilinearWork_le_integral_dualDensity
          receipt wave
    _ =
        ∫ time,
          ∑ wave ∈ outputs,
            receiptRowDualDensity receipt wave time
          ∂(commonTimeMeasure requestedTime) := by
      exact (integral_finsetSum outputs eachDensityIntegrable).symm
    _ ≤
        ∫ time,
          (6 / ν.coeff) * (‖viscous time‖ * ‖nonlinear time‖)
          ∂(commonTimeMeasure requestedTime) := by
      apply integral_mono_ae
      · exact sumDensityIntegrable
      · exact
          (spaceTime_norm_mul_norm_integrable
            requestedTime viscous nonlinear).const_mul
              (6 / ν.coeff)
      · filter_upwards with time
        unfold receiptRowDualDensity
        rw [← Finset.mul_sum]
        exact mul_le_mul_of_nonneg_left
          (finite_sum_row_norm_mul_norm_le
            requestedTime viscous nonlinear time outputs)
          coefficientNonneg
    _ =
        (6 / ν.coeff) *
          (∫ time, ‖viscous time‖ * ‖nonlinear time‖
            ∂(commonTimeMeasure requestedTime)) := by
      rw [integral_const_mul]
    _ ≤
        (6 / ν.coeff) * (‖viscous‖ * ‖nonlinear‖) := by
      exact mul_le_mul_of_nonneg_left
        (spaceTime_integral_norm_mul_norm_le
          requestedTime viscous nonlinear)
        coefficientNonneg

/-- The complete positive output-row family of one actual receipt is
summable, with no frequency cutoff in its conclusion. -/
theorem summable_max_actualWholeRowBilinearWork
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime) :
    Summable fun wave : IntegerWavevector =>
      max (actualWholeRowBilinearWork receipt wave) 0 := by
  apply summable_of_sum_le
  · intro wave
    exact le_max_right _ _
  · intro outputs
    exact finite_sum_positiveOutputWork_le_dualBudget receipt outputs

theorem tsum_max_actualWholeRowBilinearWork_le_dualBudget
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime) :
    (∑' wave : IntegerWavevector,
        max (actualWholeRowBilinearWork receipt wave) 0) ≤
      (6 / ν.coeff) *
        (‖receiptViscousNegativeOneState receipt‖ *
          ‖receiptNonlinearNegativeOneState receipt‖) := by
  exact Real.tsum_le_of_sum_le
    (fun wave => le_max_right _ _)
    (finite_sum_positiveOutputWork_le_dualBudget receipt)

/-! ## Native restart-chain reduction -/

/-- One actual restart segment's whole weighted dual payment. -/
def wholeRestartSegmentDualPayment
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) : ℝ :=
  let receipt := (run initial index).contact.prefixReceipt
  (6 / ν.coeff) *
    (‖receiptViscousNegativeOneState receipt‖ *
      ‖receiptNonlinearNegativeOneState receipt‖)

theorem wholeRestartSegmentDualPayment_nonneg
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    0 ≤ wholeRestartSegmentDualPayment initial index := by
  unfold wholeRestartSegmentDualPayment
  exact mul_nonneg
    (div_nonneg (by norm_num) ν.coeff_pos.le)
    (mul_nonneg (norm_nonneg _) (norm_nonneg _))

theorem wholeRestartPositiveOutputWork_summable_at
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    Summable fun output : IntegerWavevector =>
      wholeRestartPositiveOutputWork initial (index, output) := by
  exact
    summable_max_actualWholeRowBilinearWork
      (run initial index).contact.prefixReceipt

theorem wholeRestartPositiveOutputWork_tsum_le_segmentDualPayment
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    (∑' output : IntegerWavevector,
        wholeRestartPositiveOutputWork initial (index, output)) ≤
      wholeRestartSegmentDualPayment initial index := by
  exact
    tsum_max_actualWholeRowBilinearWork_le_dualBudget
      (run initial index).contact.prefixReceipt

/-- Summability of the one-dimensional whole dual payment is sufficient to
pay the complete `(segment, output)` positive-work family. -/
theorem wholeRestartPositiveOutputWork_summable_of_dualPayment
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (dualPaymentSummable :
      Summable (wholeRestartSegmentDualPayment initial)) :
    Summable (wholeRestartPositiveOutputWork initial) := by
  have stageWorkSummable :
      Summable fun index : ℕ =>
        ∑' output : IntegerWavevector,
          wholeRestartPositiveOutputWork initial (index, output) := by
    exact dualPaymentSummable.of_nonneg_of_le
      (fun index =>
        tsum_nonneg fun output =>
          wholeRestartPositiveOutputWork_nonneg
            initial (index, output))
      (wholeRestartPositiveOutputWork_tsum_le_segmentDualPayment initial)
  rw [summable_prod_of_nonneg
    (fun occurrence =>
      wholeRestartPositiveOutputWork_nonneg initial occurrence)]
  exact ⟨wholeRestartPositiveOutputWork_summable_at initial,
    stageWorkSummable⟩

/-- A finite accumulated physical time would force the actual whole
`H¹--H⁻¹` payment itself to be nonsummable.  This is the one-dimensional
regularity hard gate left after exact pair and output aggregation. -/
theorem elapsedTime_bddAbove_forces_segmentDualPayment_nonsummable
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    ¬ Summable (wholeRestartSegmentDualPayment initial) := by
  intro dualPaymentSummable
  exact
    (elapsedTime_bddAbove_forces_positiveOutputWork_nonsummable
      initial elapsedBounded)
      (wholeRestartPositiveOutputWork_summable_of_dualPayment
        initial dualPaymentSummable)

/-- Positive formulation of the same hard-gate reduction: an actual global
dual payment closes finite-time accumulation on the generated whole run. -/
theorem elapsedTime_not_bddAbove_of_segmentDualPayment_summable
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (dualPaymentSummable :
      Summable (wholeRestartSegmentDualPayment initial)) :
    ¬ BddAbove (Set.range (elapsedTime initial)) := by
  intro elapsedBounded
  exact
    elapsedTime_bddAbove_forces_segmentDualPayment_nonsummable
      initial elapsedBounded dualPaymentSummable

/-- Quadratic version of the generated payment.  It is the form consumed by
global `L²_t H¹_x` and `L²_t H⁻¹_x` square budgets. -/
def wholeRestartSegmentDualSquarePayment
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) : ℝ :=
  let receipt := (run initial index).contact.prefixReceipt
  (3 / ν.coeff) *
    (‖receiptViscousNegativeOneState receipt‖ ^ 2 +
      ‖receiptNonlinearNegativeOneState receipt‖ ^ 2)

theorem wholeRestartSegmentDualSquarePayment_nonneg
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    0 ≤ wholeRestartSegmentDualSquarePayment initial index := by
  unfold wholeRestartSegmentDualSquarePayment
  exact mul_nonneg
    (div_nonneg (by norm_num) ν.coeff_pos.le)
    (add_nonneg (sq_nonneg _) (sq_nonneg _))

theorem wholeRestartSegmentDualPayment_le_squarePayment
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    wholeRestartSegmentDualPayment initial index ≤
      wholeRestartSegmentDualSquarePayment initial index := by
  unfold wholeRestartSegmentDualPayment
    wholeRestartSegmentDualSquarePayment
  let viscousNorm :=
    ‖receiptViscousNegativeOneState
      (run initial index).contact.prefixReceipt‖
  let nonlinearNorm :=
    ‖receiptNonlinearNegativeOneState
      (run initial index).contact.prefixReceipt‖
  have viscosityPos := ν.coeff_pos
  have square := sq_nonneg (viscousNorm - nonlinearNorm)
  dsimp only [viscousNorm, nonlinearNorm] at square ⊢
  field_simp [ne_of_gt viscosityPos]
  nlinarith

theorem elapsedTime_bddAbove_forces_segmentDualSquarePayment_nonsummable
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    ¬ Summable (wholeRestartSegmentDualSquarePayment initial) := by
  intro squarePaymentSummable
  have dualPaymentSummable :
      Summable (wholeRestartSegmentDualPayment initial) :=
    squarePaymentSummable.of_nonneg_of_le
      (wholeRestartSegmentDualPayment_nonneg initial)
      (wholeRestartSegmentDualPayment_le_squarePayment initial)
  exact
    elapsedTime_bddAbove_forces_segmentDualPayment_nonsummable
      initial elapsedBounded dualPaymentSummable

theorem elapsedTime_not_bddAbove_of_segmentDualSquarePayment_summable
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (squarePaymentSummable :
      Summable (wholeRestartSegmentDualSquarePayment initial)) :
    ¬ BddAbove (Set.range (elapsedTime initial)) := by
  intro elapsedBounded
  exact
    elapsedTime_bddAbove_forces_segmentDualSquarePayment_nonsummable
      initial elapsedBounded squarePaymentSummable

end

