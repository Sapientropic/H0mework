/-- Uniform coefficient ceiling forced by failure of the fixed half-critical
crossing. -/
def wholeRestartHalfCriticalCoefficientCeiling
    (ν : Viscosity) : ℝ :=
  ((1 / 2 : ℝ) * ν.coeff ^ 2 * (2 * Real.pi) ^ 2) /
    criticalEnstrophyLatticeConstant

theorem wholeRestartHalfCriticalCoefficientCeiling_nonneg
    (ν : Viscosity) :
    0 ≤ wholeRestartHalfCriticalCoefficientCeiling ν := by
  unfold wholeRestartHalfCriticalCoefficientCeiling
  exact div_nonneg
    (mul_nonneg
      (mul_nonneg (by norm_num) (sq_nonneg _)) (sq_nonneg _))
    criticalEnstrophyLatticeConstant_nonneg

theorem contact_coefficientMass_le_halfCriticalCeiling_of_notCrossed
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (notCrossed : ¬ wholeRestartHalfCriticalCrossed initial index) :
    wholeVorticityEuclideanMass
        (run initial index).contact.physicalState ≤
      wholeRestartHalfCriticalCoefficientCeiling ν := by
  have productLe :
      criticalEnstrophyLatticeConstant *
          wholeVorticityEuclideanMass
            (run initial index).contact.physicalState ≤
        (1 / 2 : ℝ) * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 :=
    le_of_not_gt notCrossed
  unfold wholeRestartHalfCriticalCoefficientCeiling
  exact (le_div_iff₀ criticalEnstrophyLatticeConstant_pos).2 (by
    simpa only [mul_comm] using productLe)

/-- On a crossing-free current, the whole closure supplies the uniform
pointwise coefficient ceiling required by the nonlinear negative-one
consumer. -/
theorem nextReceipt_transverseCoefficientMass_ae_le_halfCriticalCeiling
    {ν : Viscosity}
    (current : GeneratedWholeRestartCurrent ν)
    (notCrossed :
      ¬ ((1 / 2 : ℝ) * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 <
        criticalEnstrophyLatticeConstant *
          wholeVorticityEuclideanMass current.contact.physicalState)) :
    ∀ᵐ time ∂(commonTimeMeasure (wholeRestartDuration current.contact)),
      wholeVorticityEuclideanMass
          (current.nextReceipt.transverseLimit time).1 ≤
        wholeRestartHalfCriticalCoefficientCeiling ν := by
  let replay := generatedWholeRestartCanonicalReplay current.contact
  let closure := generatedWholeRestartCriticalClosure replay
  have wholeMargin :
      criticalEnstrophyLatticeConstant *
          wholeVorticityEuclideanMass current.contact.physicalState ≤
        (1 / 2 : ℝ) * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 :=
    le_of_not_gt notCrossed
  have stateMassAE :=
    criticalClosure_coefficientMass_ae_le_of_halfCritical
      closure wholeMargin
  have currentMassLe :
      wholeVorticityEuclideanMass current.contact.physicalState ≤
        wholeRestartHalfCriticalCoefficientCeiling ν := by
    unfold wholeRestartHalfCriticalCoefficientCeiling
    exact (le_div_iff₀ criticalEnstrophyLatticeConstant_pos).2 (by
      simpa only [mul_comm] using wholeMargin)
  have includedEq :
      ∀ᵐ time ∂(commonTimeMeasure (wholeRestartDuration current.contact)),
        transverseSpaceTimeInclusion
            (wholeRestartDuration current.contact)
            closure.transverseLimit time =
          closure.weakClosure.stateLimit time := by
    rw [closure.inclusion_eq]
    exact Filter.Eventually.of_forall fun _time => rfl
  have transverseMassAE :
      ∀ᵐ time ∂(commonTimeMeasure (wholeRestartDuration current.contact)),
        wholeVorticityEuclideanMass
            (closure.transverseLimit time).1 ≤
          wholeRestartHalfCriticalCoefficientCeiling ν := by
    filter_upwards [stateMassAE,
      transverseSpaceTimeInclusion_coeFn
        (wholeRestartDuration current.contact) closure.transverseLimit,
      includedEq] with time massLe transverseEq stateEq
    rw [← stateEq, transverseEq] at massLe
    exact massLe.trans currentMassLe
  simpa [GeneratedWholeRestartCurrent.nextReceipt,
    generatedWholeRestartWholeContinuousMildSerrinReceipt,
    wholeRestartWholeContinuousMildSerrinReceipt,
    replay, closure] using transverseMassAE

/-- Viscous plus nonlinear dual-square coefficient after the current mass
has been reduced to the generated half-critical ceiling. -/
def wholeRestartHalfCriticalDualGradientCoefficient
    (ν : Viscosity) : ℝ :=
  (3 / ν.coeff) *
    (3 * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 +
      12 *
        (biotSavartSerrinConstant *
          (∑' wave : IntegerWavevector,
            integerWaveCriticalKernel wave)) *
        wholeRestartHalfCriticalCoefficientCeiling ν)

theorem wholeRestartHalfCriticalDualGradientCoefficient_nonneg
    (ν : Viscosity) :
    0 ≤ wholeRestartHalfCriticalDualGradientCoefficient ν := by
  unfold wholeRestartHalfCriticalDualGradientCoefficient
  apply mul_nonneg
  · exact div_nonneg (by norm_num) ν.coeff_pos.le
  · exact add_nonneg
      (mul_nonneg (mul_nonneg (by norm_num) (sq_nonneg _))
        (sq_nonneg _))
      (mul_nonneg
        (mul_nonneg (by norm_num)
          (mul_nonneg biotSavartSerrinConstant_nonneg
            integerWaveCriticalKernel_tsum_nonneg))
        (wholeRestartHalfCriticalCoefficientCeiling_nonneg ν))

/-- One crossing-free successor segment's complete dual-square payment is
paid by the gradient mass of the very same positive-time receipt. -/
theorem nextContact_prefixReceipt_dualSquarePayment_le_halfCriticalGradient
    {ν : Viscosity}
    (current : GeneratedWholeRestartCurrent ν)
    (notCrossed :
      ¬ ((1 / 2 : ℝ) * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 <
        criticalEnstrophyLatticeConstant *
          wholeVorticityEuclideanMass current.contact.physicalState)) :
    (3 / ν.coeff) *
          (‖receiptViscousNegativeOneState
                current.nextContact.prefixReceipt‖ ^ 2 +
            ‖receiptNonlinearNegativeOneState
                current.nextContact.prefixReceipt‖ ^ 2) ≤
      wholeRestartHalfCriticalDualGradientCoefficient ν *
        wholePrefixVorticityGradientMass current.nextContact.time
          current.nextReceipt.stateLimit := by
  have fullCoefficientMassLe :=
    nextReceipt_transverseCoefficientMass_ae_le_halfCriticalCeiling
      current notCrossed
  have prefixCoefficientMassLe :=
    prefixReceipt_transverseCoefficientMass_ae_le
      current.nextContact fullCoefficientMassLe
  have prefixGradientMassLe :
      wholeSpaceTimeVorticityGradientMass
          current.nextContact.time.1
          current.nextContact.prefixReceipt.stateLimit ≤
        wholePrefixVorticityGradientMass current.nextContact.time
          current.nextReceipt.stateLimit := by
    rfl
  simpa [wholeRestartHalfCriticalDualGradientCoefficient, mul_assoc] using
    receiptDualSquarePayment_le_generatedCeilings
      current.nextContact.prefixReceipt
      (wholeRestartHalfCriticalCoefficientCeiling_nonneg ν)
      prefixCoefficientMassLe prefixGradientMassLe

/-- Conversion coefficient from the exact half-critical absorption payment
to the complete dual-square payment. -/
def wholeRestartHalfCriticalDualPaymentCoefficient
    (ν : Viscosity) : ℝ :=
  wholeRestartHalfCriticalDualGradientCoefficient ν /
    (2 * criticalEnstrophyAbsorptionCoefficient (1 / 2) ν)

theorem wholeRestartHalfCriticalDualPaymentCoefficient_nonneg
    (ν : Viscosity) :
    0 ≤ wholeRestartHalfCriticalDualPaymentCoefficient ν := by
  unfold wholeRestartHalfCriticalDualPaymentCoefficient
  exact div_nonneg
    (wholeRestartHalfCriticalDualGradientCoefficient_nonneg ν)
    (mul_nonneg (by norm_num)
      (criticalEnstrophyAbsorptionCoefficient_pos
        (1 / 2 : ℝ) (by norm_num) ν).le)

theorem halfCriticalDualGradient_eq_payment
    (ν : Viscosity)
    (gradientMass : ℝ) :
    wholeRestartHalfCriticalDualGradientCoefficient ν * gradientMass =
      wholeRestartHalfCriticalDualPaymentCoefficient ν *
        (2 * criticalEnstrophyAbsorptionCoefficient (1 / 2) ν *
          gradientMass) := by
  have absorptionNe :
      criticalEnstrophyAbsorptionCoefficient (1 / 2) ν ≠ 0 :=
    ne_of_gt (criticalEnstrophyAbsorptionCoefficient_pos
      (1 / 2 : ℝ) (by norm_num) ν)
  unfold wholeRestartHalfCriticalDualPaymentCoefficient
  field_simp [absorptionNe]

/-- The same one-step bound expressed directly in the payment carrier that
telescopes along the native run. -/
theorem wholeRestartSegmentDualSquarePayment_succ_le_halfCriticalPayment
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (notCrossed : ¬ wholeRestartHalfCriticalCrossed initial index) :
    wholeRestartSegmentDualSquarePayment initial (index + 1) ≤
      wholeRestartHalfCriticalDualPaymentCoefficient ν *
        wholeRestartNextCriticalGradientPayment initial index := by
  have segmentLe :=
    nextContact_prefixReceipt_dualSquarePayment_le_halfCriticalGradient
      (run initial index) notCrossed
  unfold wholeRestartSegmentDualSquarePayment
  rw [run_succ]
  calc
    (3 / ν.coeff) *
          (‖receiptViscousNegativeOneState
                (run initial index).nextContact.prefixReceipt‖ ^ 2 +
            ‖receiptNonlinearNegativeOneState
                (run initial index).nextContact.prefixReceipt‖ ^ 2) ≤
        wholeRestartHalfCriticalDualGradientCoefficient ν *
          wholePrefixVorticityGradientMass
            (run initial index).nextContact.time
            (run initial index).nextReceipt.stateLimit := segmentLe
    _ =
        wholeRestartHalfCriticalDualPaymentCoefficient ν *
          (2 * criticalEnstrophyAbsorptionCoefficient (1 / 2) ν *
            wholePrefixVorticityGradientMass
              (run initial index).nextContact.time
              (run initial index).nextReceipt.stateLimit) :=
      halfCriticalDualGradient_eq_payment ν _
    _ =
        wholeRestartHalfCriticalDualPaymentCoefficient ν *
          wholeRestartNextCriticalGradientPayment initial index := rfl

/-- Every crossing-free finite prefix of the physical dual-square ledger is
paid by its initial receipt plus the accumulated half-critical payment. -/
theorem wholeRestartAccumulatedDualSquarePayment_succ_le_halfCriticalPayment
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    ∀ length : ℕ,
      (∀ index : ℕ, index < length →
        ¬ wholeRestartHalfCriticalCrossed initial index) →
      wholeRestartAccumulatedDualSquarePayment initial (length + 1) ≤
        wholeRestartSegmentDualSquarePayment initial 0 +
          wholeRestartHalfCriticalDualPaymentCoefficient ν *
            wholeRestartAccumulatedCriticalGradientPayment initial length
  | 0 => by
      intro _noCrossing
      simp [wholeRestartAccumulatedDualSquarePayment,
        wholeRestartAccumulatedCriticalGradientPayment]
  | length + 1 => by
      intro noCrossing
      have prefixBound :=
        wholeRestartAccumulatedDualSquarePayment_succ_le_halfCriticalPayment
          initial length
          (fun index indexLt =>
            noCrossing index (indexLt.trans (Nat.lt_succ_self length)))
      have segmentBound :=
        wholeRestartSegmentDualSquarePayment_succ_le_halfCriticalPayment
          initial length (noCrossing length (Nat.lt_succ_self length))
      unfold wholeRestartAccumulatedDualSquarePayment at prefixBound ⊢
      unfold wholeRestartAccumulatedCriticalGradientPayment at prefixBound ⊢
      calc
        (∑ index ∈ Finset.range (length + 1 + 1),
            wholeRestartSegmentDualSquarePayment initial index) =
            (∑ index ∈ Finset.range (length + 1),
              wholeRestartSegmentDualSquarePayment initial index) +
              wholeRestartSegmentDualSquarePayment initial (length + 1) := by
          rw [Finset.sum_range_succ]
        _ ≤
            (wholeRestartSegmentDualSquarePayment initial 0 +
              wholeRestartHalfCriticalDualPaymentCoefficient ν *
                ∑ index ∈ Finset.range length,
                  wholeRestartNextCriticalGradientPayment initial index) +
              wholeRestartHalfCriticalDualPaymentCoefficient ν *
                wholeRestartNextCriticalGradientPayment initial length :=
          add_le_add prefixBound segmentBound
        _ =
            wholeRestartSegmentDualSquarePayment initial 0 +
              wholeRestartHalfCriticalDualPaymentCoefficient ν *
                ((∑ index ∈ Finset.range length,
                    wholeRestartNextCriticalGradientPayment initial index) +
                  wholeRestartNextCriticalGradientPayment initial length) := by
          ring
        _ =
            wholeRestartSegmentDualSquarePayment initial 0 +
              wholeRestartHalfCriticalDualPaymentCoefficient ν *
                ∑ index ∈ Finset.range (length + 1),
                  wholeRestartNextCriticalGradientPayment initial index := by
          rw [Finset.sum_range_succ]

/-- Crossing-free dual-square prefixes have one length-independent ceiling
generated entirely by the initial actual whole state and viscosity. -/
theorem wholeRestartAccumulatedDualSquarePayment_uniform_le_of_noCrossing
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (length : ℕ)
    (noCrossing :
      ∀ index : ℕ, index < length →
        ¬ wholeRestartHalfCriticalCrossed initial index) :
    wholeRestartAccumulatedDualSquarePayment initial (length + 1) ≤
      wholeRestartSegmentDualSquarePayment initial 0 +
        wholeRestartHalfCriticalDualPaymentCoefficient ν *
          wholeVorticityEuclideanMass initial.contact.physicalState := by
  exact
    (wholeRestartAccumulatedDualSquarePayment_succ_le_halfCriticalPayment
      initial length noCrossing).trans
      (add_le_add le_rfl
        (mul_le_mul_of_nonneg_left
          (wholeRestartAccumulatedCriticalGradientPayment_le_initial
            initial length noCrossing)
          (wholeRestartHalfCriticalDualPaymentCoefficient_nonneg ν)))

/-- A finite physical-time write-chain cannot remain in the crossing-free
half-critical region.  The forced crossing belongs to the actual native run,
not to an alternate Galerkin orbit. -/
theorem elapsedTime_bddAbove_forces_halfCriticalCrossing
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    ∃ index : ℕ, wholeRestartHalfCriticalCrossed initial index := by
  by_contra noCrossingExists
  have noCrossing :
      ∀ index : ℕ, ¬ wholeRestartHalfCriticalCrossed initial index := by
    intro index crossed
    exact noCrossingExists ⟨index, crossed⟩
  apply
    (elapsedTime_bddAbove_forces_accumulatedDualSquarePayment_unbounded
      initial elapsedBounded)
  let ceiling :=
    wholeRestartSegmentDualSquarePayment initial 0 +
      wholeRestartHalfCriticalDualPaymentCoefficient ν *
        wholeVorticityEuclideanMass initial.contact.physicalState
  refine ⟨ceiling, ?_⟩
  rintro _ ⟨length, rfl⟩
  cases length with
  | zero =>
      dsimp only [ceiling]
      have initialMassNonneg :
          0 ≤ wholeVorticityEuclideanMass
            initial.contact.physicalState := by
        unfold wholeVorticityEuclideanMass
        exact tsum_nonneg fun wave => sq_nonneg _
      simpa [wholeRestartAccumulatedDualSquarePayment] using
        add_nonneg
          (wholeRestartSegmentDualSquarePayment_nonneg initial 0)
          (mul_nonneg
            (wholeRestartHalfCriticalDualPaymentCoefficient_nonneg ν)
            initialMassNonneg)
  | succ length =>
      exact
        wholeRestartAccumulatedDualSquarePayment_uniform_le_of_noCrossing
          initial length (fun index _indexLt => noCrossing index)

/-- Once an actual run starts on the half-critical side, the coupled
endpoint ledger keeps every later source-generated contact on that side. -/
theorem no_halfCriticalCrossing_of_initial_margin
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (initialMargin :
      criticalEnstrophyLatticeConstant *
          wholeVorticityEuclideanMass initial.contact.physicalState ≤
        (1 / 2 : ℝ) * ν.coeff ^ 2 * (2 * Real.pi) ^ 2) :
    ∀ index : ℕ, ¬ wholeRestartHalfCriticalCrossed initial index := by
  intro index
  induction index with
  | zero =>
      exact not_lt_of_ge initialMargin
  | succ index inductionHypothesis =>
      have step :=
        run_contact_coefficientMass_add_criticalGradientPayment_succ_le
          initial index inductionHypothesis
      have paymentNonneg :=
        wholeRestartNextCriticalGradientPayment_nonneg initial index
      have massLe :
          wholeVorticityEuclideanMass
              (run initial (index + 1)).contact.physicalState ≤
            wholeVorticityEuclideanMass
              (run initial index).contact.physicalState := by
        linarith
      have currentMargin :
          criticalEnstrophyLatticeConstant *
              wholeVorticityEuclideanMass
                (run initial index).contact.physicalState ≤
            (1 / 2 : ℝ) * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 :=
        le_of_not_gt inductionHypothesis
      exact not_lt_of_ge <|
        (mul_le_mul_of_nonneg_left massLe
          criticalEnstrophyLatticeConstant_nonneg).trans currentMargin

/-- Direct global-time result for the generated whole restart below the
fixed critical threshold.  It is a consumer of actual initial smallness,
not a replacement for the remaining large-data crossing gate. -/
theorem elapsedTime_not_bddAbove_of_initial_halfCriticalMargin
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (initialMargin :
      criticalEnstrophyLatticeConstant *
          wholeVorticityEuclideanMass initial.contact.physicalState ≤
        (1 / 2 : ℝ) * ν.coeff ^ 2 * (2 * Real.pi) ^ 2) :
    ¬ BddAbove (Set.range (elapsedTime initial)) := by
  intro elapsedBounded
  obtain ⟨index, crossed⟩ :=
    elapsedTime_bddAbove_forces_halfCriticalCrossing
      initial elapsedBounded
  exact
    (no_halfCriticalCrossing_of_initial_margin
      initial initialMargin index) crossed

end

