/-! ## One real-line representative of an actual receipt -/

/-- Continuous real-line proof extension of one actual whole receipt.  On
its physical interval this is literally the receipt's `wholePath`. -/
def wholeRestartReceiptPhysicalTrajectory
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (time : ℝ) : ComplexVorticityHilbertState :=
  receipt.wholePath
    (projIcc 0 requestedTime receipt.requestedTimePos.le time)

theorem wholeRestartReceiptPhysicalTrajectory_continuous
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime) :
    Continuous (wholeRestartReceiptPhysicalTrajectory receipt) := by
  exact receipt.wholePath.continuous.comp continuous_projIcc

@[simp] theorem wholeRestartReceiptPhysicalTrajectory_zero
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime) :
    wholeRestartReceiptPhysicalTrajectory receipt 0 = initialState := by
  rw [wholeRestartReceiptPhysicalTrajectory,
    projIcc_of_mem receipt.requestedTimePos.le
      ⟨le_rfl, receipt.requestedTimePos.le⟩]
  exact receipt.wholePath_initial

theorem wholeRestartReceiptPhysicalTrajectory_contact
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    {receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime}
    (contact : GeneratedPositiveWholeRestartContact receipt) :
    wholeRestartReceiptPhysicalTrajectory
        contact.prefixReceipt contact.time.1 =
      contact.physicalState := by
  rw [wholeRestartReceiptPhysicalTrajectory,
    projIcc_of_mem contact.time_pos.le
      ⟨contact.time_pos.le, le_rfl⟩]
  exact contact.prefixReceipt_terminal

/-! ## The source-owned finite-prefix physical path -/

/-- Recursively splice the first `length` actual restart receipts at their
generated accumulated physical times. -/
def wholeRestartPrefixPhysicalTrajectory
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    ℕ → ℝ → ComplexVorticityHilbertState
  | 0 => fun _ => initial.initialState
  | length + 1 =>
      endpointSplice
        (elapsedTime initial length)
        (wholeRestartPrefixPhysicalTrajectory initial length)
        (wholeRestartReceiptPhysicalTrajectory
          (run initial length).contact.prefixReceipt)

@[simp] theorem wholeRestartPrefixPhysicalTrajectory_zero
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (time : ℝ) :
    wholeRestartPrefixPhysicalTrajectory initial 0 time =
      initial.initialState :=
  rfl

/-- The compiled prefix reaches the exact next native current. -/
theorem wholeRestartPrefixPhysicalTrajectory_endpoint
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    ∀ length : ℕ,
      wholeRestartPrefixPhysicalTrajectory initial length
          (elapsedTime initial length) =
        (run initial length).initialState
  | 0 => by simp
  | length + 1 => by
      have joinLt :
          elapsedTime initial length <
            elapsedTime initial (length + 1) :=
        elapsedTime_strictMono initial (Nat.lt_succ_self length)
      rw [wholeRestartPrefixPhysicalTrajectory,
        endpointSplice_of_lt _ _ _ _ joinLt,
        elapsedTime_succ]
      have localTime :
          elapsedTime initial length +
                (run initial length).contact.time.1 -
              elapsedTime initial length =
            (run initial length).contact.time.1 := by
        ring
      rw [localTime,
        wholeRestartReceiptPhysicalTrajectory_contact]
      exact (run_succ_initialState initial length).symm

private theorem endpointSplice_continuousOn
    {E : Type*}
    [TopologicalSpace E]
    (joinTime duration : ℝ)
    (prior restart : ℝ → E)
    (priorContinuous :
      ContinuousOn prior (Icc 0 joinTime))
    (restartContinuous :
      ContinuousOn restart (Icc 0 duration))
    (sameValue : restart 0 = prior joinTime) :
    ContinuousOn
      (endpointSplice joinTime prior restart)
      (Icc 0 (joinTime + duration)) := by
  unfold endpointSplice
  apply ContinuousOn.if
  · intro time timeMem
    have frontierMem := timeMem.2
    change time ∈ frontier (Iic joinTime) at frontierMem
    rw [frontier_Iic] at frontierMem
    have timeEq : time = joinTime := by
      simpa using frontierMem
    subst time
    simp [sameValue]
  · apply priorContinuous.mono
    intro time timeMem
    have closedMem := timeMem.2
    change time ∈ closure (Iic joinTime) at closedMem
    rw [closure_Iic] at closedMem
    exact ⟨timeMem.1.1, closedMem⟩
  · have shiftContinuous :
        ContinuousOn
          (fun time : ℝ => time - joinTime)
          (Icc joinTime (joinTime + duration)) :=
      (continuous_id.sub continuous_const).continuousOn
    have shiftMaps :
        MapsTo
          (fun time : ℝ => time - joinTime)
          (Icc joinTime (joinTime + duration))
          (Icc 0 duration) := by
      intro time timeMem
      constructor <;> linarith [timeMem.1, timeMem.2]
    have shifted :=
      restartContinuous.comp shiftContinuous shiftMaps
    have domainSubset :
        Icc (0 : ℝ) (joinTime + duration) ∩
              closure {time : ℝ | ¬ time ≤ joinTime} ⊆
          Icc joinTime (joinTime + duration) := by
      intro time timeMem
      have closedMem := timeMem.2
      have predicateEq :
          {time : ℝ | ¬ time ≤ joinTime} = Ioi joinTime := by
        ext point
        simp
      rw [predicateEq, closure_Ioi] at closedMem
      exact ⟨closedMem, timeMem.1.2⟩
    simpa [Function.comp_def] using
      shifted.mono domainSubset

/-- Every finite native prefix is one continuous whole physical path on
its exact accumulated time interval. -/
theorem wholeRestartPrefixPhysicalTrajectory_continuousOn
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    ∀ length : ℕ,
      ContinuousOn
        (wholeRestartPrefixPhysicalTrajectory initial length)
        (Icc 0 (elapsedTime initial length))
  | 0 => by
      change ContinuousOn
        (fun _ : ℝ => initial.initialState) (Icc 0 0)
      exact continuous_const.continuousOn
  | length + 1 => by
      have sameValue :
          wholeRestartReceiptPhysicalTrajectory
                (run initial length).contact.prefixReceipt 0 =
            wholeRestartPrefixPhysicalTrajectory initial length
              (elapsedTime initial length) := by
        rw [wholeRestartReceiptPhysicalTrajectory_zero,
          wholeRestartPrefixPhysicalTrajectory_endpoint]
      simpa [wholeRestartPrefixPhysicalTrajectory,
        elapsedTime_succ] using
        endpointSplice_continuousOn
          (elapsedTime initial length)
          (run initial length).contact.time.1
          (wholeRestartPrefixPhysicalTrajectory initial length)
          (wholeRestartReceiptPhysicalTrajectory
            (run initial length).contact.prefixReceipt)
          (wholeRestartPrefixPhysicalTrajectory_continuousOn
            initial length)
          (wholeRestartReceiptPhysicalTrajectory_continuous
            (run initial length).contact.prefixReceipt).continuousOn
          sameValue

/-- Every earlier receipt remains literally present on its own open-closed
physical window in every longer prefix. -/
theorem wholeRestartPrefixPhysicalTrajectory_eq_receipt
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    ∀ {length index : ℕ},
      index < length →
      ∀ {time : ℝ},
        time ∈
            Ioc
              (elapsedTime initial index)
              (elapsedTime initial (index + 1)) →
          wholeRestartPrefixPhysicalTrajectory initial length time =
            wholeRestartReceiptPhysicalTrajectory
              (run initial index).contact.prefixReceipt
              (time - elapsedTime initial index) := by
  intro length index indexLt time timeMem
  induction length generalizing index time with
  | zero => omega
  | succ length inductionHypothesis =>
      by_cases indexEq : index = length
      · subst index
        exact
          endpointSplice_of_lt
            (elapsedTime initial length)
            (wholeRestartPrefixPhysicalTrajectory initial length)
            (wholeRestartReceiptPhysicalTrajectory
              (run initial length).contact.prefixReceipt)
            time timeMem.1
      · have indexLtLength : index < length := by omega
        have timeLeJoin :
            time ≤ elapsedTime initial length := by
          exact timeMem.2.trans
            ((elapsedTime_strictMono initial).monotone (by omega))
        rw [wholeRestartPrefixPhysicalTrajectory,
          endpointSplice_of_le _ _ _ _ timeLeJoin]
        exact inductionHypothesis indexLtLength timeMem

/-! ## Exact physical windows and no duplicate allocation -/

/-- The half-open physical-time window written by one native restart edge. -/
def wholeRestartPhysicalWindow
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) : Set ℝ :=
  Ioc
    (elapsedTime initial index)
    (elapsedTime initial (index + 1))

/-- Distinct native occurrences occupy disjoint physical-time windows. -/
theorem wholeRestartPhysicalWindow_disjoint
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    {left right : ℕ}
    (different : left ≠ right) :
    Disjoint
      (wholeRestartPhysicalWindow initial left)
      (wholeRestartPhysicalWindow initial right) := by
  rw [Set.disjoint_left]
  intro time leftMem rightMem
  rcases lt_or_gt_of_ne different with leftLt | rightLt
  · have boundaryLe :
        elapsedTime initial (left + 1) ≤
          elapsedTime initial right :=
      (elapsedTime_strictMono initial).monotone
        (Nat.succ_le_of_lt leftLt)
    exact (not_lt_of_ge (leftMem.2.trans boundaryLe)) rightMem.1
  · have boundaryLe :
        elapsedTime initial (right + 1) ≤
          elapsedTime initial left :=
      (elapsedTime_strictMono initial).monotone
        (Nat.succ_le_of_lt rightLt)
    exact (not_lt_of_ge (rightMem.2.trans boundaryLe)) leftMem.1

/-- Every positive time before a finite prefix endpoint belongs to one and
only one actual restart window. -/
theorem wholeRestartPhysicalWindow_existsUnique
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    ∀ {length : ℕ} {time : ℝ},
      time ∈ Ioc 0 (elapsedTime initial length) →
      ∃! index : ℕ,
        index < length ∧
          time ∈ wholeRestartPhysicalWindow initial index := by
  intro length
  induction length with
  | zero =>
      intro time timeMem
      simp at timeMem
  | succ length inductionHypothesis =>
      intro time timeMem
      by_cases beforeJoin : time ≤ elapsedTime initial length
      · have priorMem :
            time ∈ Ioc 0 (elapsedTime initial length) :=
          ⟨timeMem.1, beforeJoin⟩
        obtain ⟨index, indexSpec, indexUnique⟩ :=
          inductionHypothesis priorMem
        refine ⟨index, ⟨indexSpec.1.trans (Nat.lt_succ_self length),
          indexSpec.2⟩, ?_⟩
        intro candidate candidateSpec
        by_cases candidateEq : candidate = length
        · subst candidate
          exact False.elim
            ((not_lt_of_ge beforeJoin) candidateSpec.2.1)
        · exact indexUnique candidate
            ⟨Nat.lt_of_le_of_ne
                (Nat.le_of_lt_succ candidateSpec.1) candidateEq,
              candidateSpec.2⟩
      · have afterJoin : elapsedTime initial length < time :=
          lt_of_not_ge beforeJoin
        refine ⟨length, ⟨Nat.lt_succ_self length,
          ⟨afterJoin, timeMem.2⟩⟩, ?_⟩
        intro candidate candidateSpec
        by_contra candidateNe
        have candidateLt : candidate < length :=
          Nat.lt_of_le_of_ne
            (Nat.le_of_lt_succ candidateSpec.1) candidateNe
        have boundaryLe :
            elapsedTime initial (candidate + 1) ≤
              elapsedTime initial length :=
          (elapsedTime_strictMono initial).monotone
            (Nat.succ_le_of_lt candidateLt)
        exact (not_lt_of_ge
          (candidateSpec.2.2.trans boundaryLe)) afterJoin

/-! ## Same-window dual-square payment -/

/-- Real-line zero extension of one receipt's complete dual-square density. -/
def receiptDualSquareDensity
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (time : ℝ) : ℝ :=
  commonTimeZeroExtension requestedTime
    (fun localTime =>
      (3 / ν.coeff) *
        (‖receiptViscousNegativeOneState receipt localTime‖ ^ 2 +
          ‖receiptNonlinearNegativeOneState receipt localTime‖ ^ 2))
    time

theorem receiptDualSquareDensity_nonneg
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (time : ℝ) :
    0 ≤ receiptDualSquareDensity receipt time := by
  unfold receiptDualSquareDensity commonTimeZeroExtension
  split_ifs
  · exact mul_nonneg
      (div_nonneg (by norm_num) ν.coeff_pos.le)
      (add_nonneg (sq_nonneg _) (sq_nonneg _))
  · exact le_rfl

/-- One segment payment is exactly the integral of the two same-event
whole states on that segment's own physical interval. -/
theorem wholeRestartSegmentDualSquarePayment_eq_intervalIntegral
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    wholeRestartSegmentDualSquarePayment initial index =
      ∫ time in (0 : ℝ)..(run initial index).contact.time.1,
        receiptDualSquareDensity
          (run initial index).contact.prefixReceipt time := by
  let receipt := (run initial index).contact.prefixReceipt
  have viscousIntegrable :
      Integrable
        (fun time =>
          ‖receiptViscousNegativeOneState receipt time‖ ^ 2)
        (commonTimeMeasure (run initial index).contact.time.1) :=
    (MeasureTheory.Lp.memLp
      (receiptViscousNegativeOneState receipt)).integrable_norm_pow
        (by norm_num)
  have nonlinearIntegrable :
      Integrable
        (fun time =>
          ‖receiptNonlinearNegativeOneState receipt time‖ ^ 2)
        (commonTimeMeasure (run initial index).contact.time.1) :=
    (MeasureTheory.Lp.memLp
      (receiptNonlinearNegativeOneState receipt)).integrable_norm_pow
        (by norm_num)
  unfold wholeRestartSegmentDualSquarePayment
  dsimp only [receipt]
  rw [spaceTime_norm_sq_eq_integral,
    spaceTime_norm_sq_eq_integral]
  calc
    (3 / ν.coeff) *
          ((∫ time,
              ‖receiptViscousNegativeOneState receipt time‖ ^ 2
                ∂(commonTimeMeasure
                  (run initial index).contact.time.1)) +
            ∫ time,
              ‖receiptNonlinearNegativeOneState receipt time‖ ^ 2
                ∂(commonTimeMeasure
                  (run initial index).contact.time.1)) =
        ∫ time,
          (3 / ν.coeff) *
            (‖receiptViscousNegativeOneState receipt time‖ ^ 2 +
              ‖receiptNonlinearNegativeOneState receipt time‖ ^ 2)
            ∂(commonTimeMeasure
              (run initial index).contact.time.1) := by
      rw [integral_const_mul,
        integral_add viscousIntegrable nonlinearIntegrable]
    _ =
        ∫ time,
          receiptDualSquareDensity receipt time.1
            ∂(commonTimeMeasure
              (run initial index).contact.time.1) := by
      apply integral_congr_ae
      filter_upwards with time
      rw [receiptDualSquareDensity,
        commonTimeZeroExtension_of_mem _ _ time.1 time.2]
    _ =
        ∫ time in (0 : ℝ)..(run initial index).contact.time.1,
          receiptDualSquareDensity receipt time :=
      commonTime_integral_eq_intervalIntegral
        (run initial index).contact.time.1
        (run_contact_time_pos initial index).le
        (receiptDualSquareDensity receipt)

/-- The same density translated to the exact accumulated time window of
its native occurrence. -/
def wholeRestartTranslatedDualSquareDensity
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (time : ℝ) : ℝ :=
  receiptDualSquareDensity
    (run initial index).contact.prefixReceipt
    (time - elapsedTime initial index)

theorem wholeRestartTranslatedDualSquareDensity_nonneg
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (time : ℝ) :
    0 ≤ wholeRestartTranslatedDualSquareDensity
      initial index time :=
  receiptDualSquareDensity_nonneg
    (run initial index).contact.prefixReceipt _

/-- Translation to global time preserves the exact segment payment. -/
theorem wholeRestartSegmentDualSquarePayment_eq_globalWindowIntegral
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    wholeRestartSegmentDualSquarePayment initial index =
      ∫ time in
          elapsedTime initial index..
            elapsedTime initial (index + 1),
        wholeRestartTranslatedDualSquareDensity
          initial index time := by
  rw [wholeRestartSegmentDualSquarePayment_eq_intervalIntegral]
  unfold wholeRestartTranslatedDualSquareDensity
  rw [elapsedTime_succ,
    intervalIntegral.integral_comp_sub_right]
  simp

/-! ## Exact finite-prefix square cascade -/

/-- Complete dual-square payment of the first actual restart segments. -/
def wholeRestartAccumulatedDualSquarePayment
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (length : ℕ) : ℝ :=
  ∑ index ∈ Finset.range length,
    wholeRestartSegmentDualSquarePayment initial index

theorem wholeRestartAccumulatedDualSquarePayment_nonneg
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (length : ℕ) :
    0 ≤ wholeRestartAccumulatedDualSquarePayment initial length := by
  unfold wholeRestartAccumulatedDualSquarePayment
  exact Finset.sum_nonneg fun index _indexMem =>
    wholeRestartSegmentDualSquarePayment_nonneg initial index

/-- The finite-prefix square cascade is exactly the sum of integrals on the
pairwise-disjoint actual physical windows. -/
theorem wholeRestartAccumulatedDualSquarePayment_eq_globalWindowIntegrals
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (length : ℕ) :
    wholeRestartAccumulatedDualSquarePayment initial length =
      ∑ index ∈ Finset.range length,
        ∫ time in
            elapsedTime initial index..
              elapsedTime initial (index + 1),
          wholeRestartTranslatedDualSquareDensity
            initial index time := by
  unfold wholeRestartAccumulatedDualSquarePayment
  apply Finset.sum_congr rfl
  intro index _indexMem
  exact
    wholeRestartSegmentDualSquarePayment_eq_globalWindowIntegral
      initial index

/-- Finite physical-time accumulation forces the actual dual-square prefix
payments themselves to be unbounded.  This is the source-owned
receipt-square cascade on the single physical-time axis. -/
theorem elapsedTime_bddAbove_forces_accumulatedDualSquarePayment_unbounded
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    ¬ BddAbove
      (Set.range (wholeRestartAccumulatedDualSquarePayment initial)) := by
  intro prefixBounded
  obtain ⟨bound, boundSpec⟩ := prefixBounded
  have squarePaymentSummable :
      Summable (wholeRestartSegmentDualSquarePayment initial) := by
    apply summable_of_sum_le
    · exact wholeRestartSegmentDualSquarePayment_nonneg initial
    · intro indices
      obtain ⟨length, indicesSubset⟩ :=
        Finset.exists_nat_subset_range indices
      calc
        (∑ index ∈ indices,
            wholeRestartSegmentDualSquarePayment initial index) ≤
            ∑ index ∈ Finset.range length,
              wholeRestartSegmentDualSquarePayment initial index :=
          Finset.sum_le_sum_of_subset_of_nonneg
            indicesSubset
            (fun index _indexMem _indexNotMem =>
              wholeRestartSegmentDualSquarePayment_nonneg
                initial index)
        _ = wholeRestartAccumulatedDualSquarePayment
              initial length := rfl
        _ ≤ bound := boundSpec ⟨length, rfl⟩
  exact
    elapsedTime_bddAbove_forces_segmentDualSquarePayment_nonsummable
      initial elapsedBounded squarePaymentSummable

end

