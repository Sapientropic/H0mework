  ThreeDimensionalVorticityCoefficientGeneratedCompleteOmittedUnforcedReceipt

noncomputable section

/-! ## The hidden zero-frequency source law -/

theorem generatedVorticityAdvectionPairContribution_eq_zero_of_output_eq_zero
    (source : RawVorticityFourierSource)
    (pair : StretchingPair)
    (outputZero : stretchingPairOutput pair = 0) :
    generatedVorticityAdvectionPairContribution source pair = 0 := by
  have secondWave :=
    pairSecond_eq_waveNeg_first_of_output_eq_zero pair outputZero
  have transverse :=
    generatedVelocityCoefficient_transverse source pair.1
  have dotZero :
      complexWavevector pair.2 ⬝ᵥ
          generatedVelocityCoefficient source pair.1 = 0 := by
    rw [secondWave, complexWavevector_waveNeg]
    simpa using congrArg Neg.neg transverse
  simp [generatedVorticityAdvectionPairContribution, dotZero]

theorem
    generatedVorticityNonlinearPairContribution_eq_zero_of_output_eq_zero
    (source : RawVorticityFourierSource)
    (pair : StretchingPair)
    (outputZero : stretchingPairOutput pair = 0) :
    generatedVorticityNonlinearPairContribution source pair = 0 := by
  rw [generatedVorticityNonlinearPairContribution,
    generatedStretchingPairContribution_eq_zero_of_output_eq_zero
      source pair outputZero,
    generatedVorticityAdvectionPairContribution_eq_zero_of_output_eq_zero
      source pair outputZero]
  simp

/-- The complete source-generated vorticity nonlinearity has no zero Fourier
row.  This is generated by transversality, not stored as an admission law. -/
@[simp] theorem generatedVorticityNonlinearCoefficientAt_zero
    (source : RawVorticityFourierSource) :
    generatedVorticityNonlinearCoefficientAt source 0 = 0 := by
  rw [generatedVorticityNonlinearCoefficientAt]
  apply Finset.sum_eq_zero
  intro pair pairMem
  exact
    generatedVorticityNonlinearPairContribution_eq_zero_of_output_eq_zero
      source pair
      ((mem_generatedStretchingPairFiber_iff source 0 pair).mp
        pairMem).2

/-! ## No nonlinear row remains outside the complete carrier -/

/--
Every nonlinear coefficient outside the complete generated carrier is zero.
This is the exact source-side coverage theorem generated by the missing-mode
filter itself.
-/
theorem generatedVorticityNonlinearCoefficientAt_eq_zero_of_not_complete
    (source : RawVorticityFourierSource)
    {output : IntegerWavevector}
    (outputNotComplete :
      output ∉ generatedCompleteNonlinearGalerkinModes source) :
    generatedVorticityNonlinearCoefficientAt source output = 0 := by
  by_contra coefficientNonzero
  have outputNotSupport :
      output ∉ generatedSupport source := by
    intro supportMem
    exact outputNotComplete
      (generatedSupport_subset_completeNonlinearGalerkinModes
        source supportMem)
  have outputNonzero : output ≠ 0 := by
    intro outputZero
    subst output
    exact coefficientNonzero
      (generatedVorticityNonlinearCoefficientAt_zero source)
  have outputInventory :
      output ∈ generatedStretchingOutputInventory source := by
    by_contra outputNotInventory
    exact coefficientNonzero
      (generatedVorticityNonlinearCoefficientAt_eq_zero_of_not_mem
        source outputNotInventory)
  have outputNotLive :
      output ∉ generatedLiveVorticityModes source := by
    intro liveMem
    exact outputNotSupport
      ((mem_generatedLiveVorticityModes_iff
        source output).mp liveMem).1
  have activeMem :
      output ∈ generatedActiveNonliveNonlinearModes source :=
    (mem_generatedActiveNonliveNonlinearModes_iff
      source output).mpr
      ⟨outputInventory, outputNonzero, outputNotLive,
        coefficientNonzero⟩
  have missingMem :
      output ∈ generatedMissingNonlinearModes source :=
    (mem_generatedMissingNonlinearModes_iff
      source output).mpr
      ⟨activeMem, outputNotSupport⟩
  exact outputNotComplete
    (generatedMissingNonlinearModes_subset_completeGalerkinModes
      source missingMem)

/-! ## Whole-carrier generator square -/

/--
The complete finite Galerkin generator is the whole-lattice unforced
vorticity tangent at the common physical state, at every Fourier frequency.
-/
theorem completeGalerkinGenerator_eq_wholeLatticeTangent
    (source : RawVorticityFourierSource)
    (ν : ℝ) :
    finiteStateVorticityGenerator
        (generatedCompleteNonlinearGalerkinModes source)
        ν
        (generatedCompleteNonlinearInitialState source) =
      wholeLatticeVorticityFourierTangentAt
        ν
        (generatedCompleteNonlinearInitialState source) := by
  ext output
  have wholeNonlinearEq :
      wholeStateVorticityNonlinearCoefficientAt
          (generatedCompleteNonlinearInitialState source)
          output =
        generatedVorticityNonlinearCoefficientAt source output := by
    rw [generatedCompleteNonlinearInitialState_eq_currentPhysicalState]
    exact wholeStateNonlinearCoefficient_generatedSource source output
  by_cases outputComplete :
      output ∈ generatedCompleteNonlinearGalerkinModes source
  · have nonlinearEq :
        finiteStateVorticityNonlinearCoefficientAt
            (generatedCompleteNonlinearGalerkinModes source)
            (generatedCompleteNonlinearInitialState source)
            output =
          generatedVorticityNonlinearCoefficientAt source output := by
      change
        finiteStateVorticityNonlinearCoefficientAt
            (generatedCompleteNonlinearGalerkinModes source)
            (generatedComplexVorticityState source
              (generatedCompleteNonlinearGalerkinModes source))
            output =
          generatedVorticityNonlinearCoefficientAt source output
      exact
        finiteStateVorticityNonlinearCoefficientAt_generatedSource_of_subset
          source
          (generatedCompleteNonlinearGalerkinModes source)
          (generatedSupport_subset_completeNonlinearGalerkinModes source)
          output
    rw [finiteStateVorticityGenerator_apply, if_pos outputComplete,
      wholeLatticeVorticityFourierTangentAt,
      nonlinearEq, wholeNonlinearEq]
  · have stateZero :
        generatedCompleteNonlinearInitialState source output = 0 := by
      rw [generatedCompleteNonlinearInitialState,
        generatedComplexVorticityState_apply,
        if_neg outputComplete]
    have nonlinearZero :
        generatedVorticityNonlinearCoefficientAt source output = 0 :=
      generatedVorticityNonlinearCoefficientAt_eq_zero_of_not_complete
        source outputComplete
    rw [finiteStateVorticityGenerator_apply, if_neg outputComplete,
      wholeLatticeVorticityFourierTangentAt,
      wholeNonlinearEq, nonlinearZero, stateZero]
    simp

/--
Equivalent residual form of the macro compiler: the complete time-zero
Galerkin tangent has no whole-lattice PDE residual at any frequency.
-/
theorem completeGalerkinWholeLatticePDEResidual_eq_zero
    (source : RawVorticityFourierSource)
    (ν : ℝ) :
    wholeLatticeVorticityFourierPDEResidualAt
        ν
        (generatedCompleteNonlinearInitialState source)
        (finiteStateVorticityGenerator
          (generatedCompleteNonlinearGalerkinModes source)
          ν
          (generatedCompleteNonlinearInitialState source)) =
      0 := by
  ext output
  rw [wholeLatticeVorticityFourierPDEResidualAt,
    completeGalerkinGenerator_eq_wholeLatticeTangent]
  simp

/-! ## The actual receipt consumes the whole tangent at the same event -/

/--
At time zero, the one generated positive-time unforced receipt differentiates
by the whole-lattice Navier--Stokes tangent on the entire carrier.
-/
theorem completeOmittedPhysicalTimeReceipt_wholeLatticeDerivative
    (source : RawVorticityFourierSource)
    (ν : Viscosity)
    (output : IntegerWavevector) :
    HasDerivAt
        (fun time =>
          (completeOmittedPhysicalTimeReceipt source ν).trajectory
            time output)
        (wholeLatticeVorticityFourierTangentAt
          ν.coeff
          (generatedCompleteNonlinearInitialState source)
          output)
        0 := by
  let receipt := completeOmittedPhysicalTimeReceipt source ν
  have zeroInTime :
      (0 : ℝ) ∈ Icc (0 : ℝ) receipt.duration :=
    ⟨le_rfl, receipt.duration_pos.le⟩
  have actualLaw := (receipt.physical 0 zeroInTime).1
  have rowLaw :=
    complexVorticityTrajectoryWave_hasDerivAt
      receipt.trajectory 0
      (finiteStateVorticityGenerator
        (generatedSupport (completeOmittedPhysicalLiftSource source))
        ν.coeff
        (receipt.trajectory 0))
      output actualLaw
  rw [show receipt.trajectory 0 =
        generatedCompleteNonlinearInitialState source by
      exact completeOmittedPhysicalTimeReceipt_initial source ν,
    completeOmittedPhysicalLiftSource_generatedSupport] at rowLaw
  have generatorEq :=
    congrFun
      (completeGalerkinGenerator_eq_wholeLatticeTangent
        source ν.coeff)
      output
  rw [generatorEq] at rowLaw
  exact rowLaw

/--
Whole-carrier checkpoint: one source generates a conservative support,
an exact unforced tangent compiler, a zero full residual, and the actual
positive-time receipt which owns that tangent.
-/
theorem generatedCompleteOmittedWholeCarrierCompiler_checkpoint
    (source : RawVorticityFourierSource)
    (ν : Viscosity) :
    generatedCompleteNonlinearInitialState source =
        generatedComplexVorticityState source
          (generatedSupport source) ∧
      finiteStateVorticityGenerator
          (generatedCompleteNonlinearGalerkinModes source)
          ν.coeff
          (generatedCompleteNonlinearInitialState source) =
        wholeLatticeVorticityFourierTangentAt
          ν.coeff
          (generatedCompleteNonlinearInitialState source) ∧
      wholeLatticeVorticityFourierPDEResidualAt
          ν.coeff
          (generatedCompleteNonlinearInitialState source)
          (finiteStateVorticityGenerator
            (generatedCompleteNonlinearGalerkinModes source)
            ν.coeff
          (generatedCompleteNonlinearInitialState source)) =
        0 ∧
      ∀ output : IntegerWavevector,
        HasDerivAt
            (fun time =>
              (completeOmittedPhysicalTimeReceipt source ν).trajectory
                time output)
            (wholeLatticeVorticityFourierTangentAt
              ν.coeff
              (generatedCompleteNonlinearInitialState source)
              output)
            0 := by
  exact
    ⟨generatedCompleteNonlinearInitialState_eq_currentPhysicalState
        source,
      completeGalerkinGenerator_eq_wholeLatticeTangent
        source ν.coeff,
      completeGalerkinWholeLatticePDEResidual_eq_zero
        source ν.coeff,
      completeOmittedPhysicalTimeReceipt_wholeLatticeDerivative
        source ν⟩

end

end
    ThreeDimensionalVorticityCoefficientGeneratedCompleteOmittedWholeCarrierCompiler
