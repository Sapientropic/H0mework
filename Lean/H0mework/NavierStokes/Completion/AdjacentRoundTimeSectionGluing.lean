import H0mework.NavierStokes.Completion.ScaleTimeRoundRuntime

/-!
# Gluing residual between adjacent complete-round time sections

Every complete macro round contains one actual positive-time unforced
Galerkin receipt.  The endpoint of round `i` is the next runtime current, but
round `i + 1` performs its source-owned zero-time shell burst before starting
its own unforced receipt.  Consequently the two local time sections do not
automatically form one unforced orbit.

This file computes the overlap defect on the physical Hilbert carrier:

```text
next local initial - previous local endpoint
  = next source-generated shell-path trace.
```

Thus overlap compatibility is exactly vanishing of that concrete trace.  A
positive next shell burst generates a nonzero defect, so its two local
enstrophy payments may not be charged as adjacent intervals of one unforced
trajectory.  No path, branch, target, overlap certificate, or nonzero trace is
accepted by the producer.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace
    ThreeDimensionalVorticityCoefficientGeneratedCompleteAdjacentRoundTimeSectionGluing

open ThreeDimensionalPeriodicFilteredNavierStokesGenerator
open ThreeDimensionalVorticityCoefficientFiniteSupportComplexTrajectory
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientGeneratedScaleTimeShellRound
open ThreeDimensionalVorticityCoefficientGeneratedScaleTimeShellJumpLedger
open
  ThreeDimensionalVorticityCoefficientGeneratedCompleteScaleTimeRoundRuntime
open
  ThreeDimensionalVorticityCoefficientGeneratedCompleteScaleTimeRoundRuntime.GeneratedCompleteInfiniteRoundLineage

noncomputable section

/--
The exact cross-window gluing residual is the next round's complete
source-generated shell trace.

Both sides live on the same physical Hilbert carrier and compare the literal
endpoint and initial state of the two adjacent actual time receipts.
-/
theorem
    adjacentTimeSectionGluingResidual_eq_nextShellTrace
    {ν : Viscosity}
    (lineage : GeneratedCompleteInfiniteRoundLineage ν)
    (index : ℕ) :
    (lineage.timeReceipt (index + 1)).trajectory 0 -
        (lineage.timeReceipt index).trajectory
          (lineage.timeReceipt index).duration =
      generatedIntegerShellPathStateTrace
        (lineage.round (index + 1)).shellRun.arrival := by
  have nextInitial :
      (lineage.timeReceipt (index + 1)).trajectory 0 =
        generatedComplexVorticityState
          (lineage.round (index + 1)).shellRun.terminal
          (generatedSupport
            (lineage.round (index + 1)).shellRun.terminal) := by
    simpa [
      GeneratedCompleteInfiniteRoundLineage.timeReceipt] using
      (lineage.round
        (index + 1)).completeTimeReceipt_initial
  have previousEndpoint :
      generatedComplexVorticityState
          (lineage.current (index + 1)).source
          (generatedSupport
            (lineage.current (index + 1)).source) =
        (lineage.timeReceipt index).trajectory
          (lineage.timeReceipt index).duration := by
    rw [lineage.current_succ_eq_completeNext index]
    simpa [
      GeneratedCompleteInfiniteRoundLineage.timeReceipt] using
      (lineage.round
        index).completeMacroPhysicalProjection_unforcedNS_commutes.2.2.1
  rw [nextInitial, ← previousEndpoint]
  exact
    generatedIntegerShellReachable_endpointState_sub_seed_eq_trace
      (lineage.round (index + 1)).shellRun.arrival

/--
Two adjacent canonical time sections agree at their common global-time
boundary exactly when the intervening source shell trace vanishes.
-/
theorem
    adjacentTimeSections_overlapCompatible_iff_nextShellTrace_eq_zero
    {ν : Viscosity}
    (lineage : GeneratedCompleteInfiniteRoundLineage ν)
    (index : ℕ) :
    (lineage.timeReceipt (index + 1)).trajectory 0 =
        (lineage.timeReceipt index).trajectory
          (lineage.timeReceipt index).duration ↔
      generatedIntegerShellPathStateTrace
        (lineage.round (index + 1)).shellRun.arrival = 0 := by
  constructor
  · intro compatible
    have residual :=
      adjacentTimeSectionGluingResidual_eq_nextShellTrace
        lineage index
    rw [compatible, sub_self] at residual
    exact residual.symm
  · intro traceZero
    have residual :=
      adjacentTimeSectionGluingResidual_eq_nextShellTrace
        lineage index
    rw [traceZero] at residual
    exact sub_eq_zero.mp residual

/--
If the next actual macro round contains a positive shell burst, the two
canonical unforced time sections are genuinely incompatible at the shared
elapsed time.  Positivity and nonvanishing are generated by the actual shell
path; neither is stored in a gluing certificate.
-/
theorem
    adjacentTimeSections_overlapIncompatible_of_nextShellLength_pos
    {ν : Viscosity}
    (lineage : GeneratedCompleteInfiniteRoundLineage ν)
    (index : ℕ)
    (shellLengthPos :
      0 < (lineage.round (index + 1)).shellLength) :
    (lineage.timeReceipt (index + 1)).trajectory 0 ≠
      (lineage.timeReceipt index).trajectory
        (lineage.timeReceipt index).duration := by
  intro compatible
  have traceZero :=
    (adjacentTimeSections_overlapCompatible_iff_nextShellTrace_eq_zero
      lineage index).mp compatible
  have shellWrite :=
    generatedIntegerShellReachable_endpointState_sub_seed_eq_trace
      (lineage.round (index + 1)).shellRun.arrival
  rw [traceZero] at shellWrite
  have endpointEq := sub_eq_zero.mp shellWrite
  exact
    (generatedIntegerShellReachable_endpointState_ne_seed
      (lineage.round (index + 1)).shellRun.arrival
      shellLengthPos) endpointEq

end

end
    ThreeDimensionalVorticityCoefficientGeneratedCompleteAdjacentRoundTimeSectionGluing
end NavierStokes
end SaturationMonoid
