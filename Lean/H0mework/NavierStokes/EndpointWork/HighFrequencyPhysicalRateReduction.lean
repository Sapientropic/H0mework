/-- A positive full-pair boundary trace cannot remain an unstructured
whole-tail anomaly.  Its own half-atom is transported into the actual
high-frequency producer.  At every radius the source then exposes one of
the three concrete PDE responsibilities already generated by that producer:

* the least finite interaction core escapes the radius;
* the complete gluing state is nonzero and writes a native next/trace;
* a faithful-zero finite aggregate has mass above the half-atom and obeys
  the same-event physical rate obstruction.

No tail-settlement, bounded-rate, cutoff, branch, or target regularity law is
assumed. -/
theorem
    fullPairForcedTrace_generates_zero_or_atomScaleHighFrequencyPhysicalRate
    {ν : Viscosity}
    (lineage : GeneratedInfiniteWholeRestartEndpointMacroLineage ν)
    (stage : ℕ) :
    infiniteEndpointMacroStageKineticDefect lineage stage = 0 ∨
      (0 < infiniteEndpointMacroStageKineticDefect lineage stage ∧
        ¬ Tendsto
          (fun index =>
            ‖wholeRestartAlignedResponsibilityToVelocityResidualTail
                ((linearResidualTrace wholeRestartEndpointFullPairMacroKeep
                  (wholeRestartEndpointFullPairMacroPending
                    (lineage.current stage)
                    (lineage.step stage).elapsedBounded
                    accumulationRead)).1) index‖ ^ 2)
          atTop (nhds 0) ∧
        ∀ radius : ℕ,
          ∃ index : ℕ,
            ∃ crossed :
                wholeRestartHalfCriticalCrossed
                  (lineage.current stage) index,
              radius <
                  wholeRestartCrossingFiniteCoreRadius
                    (lineage.current stage) index crossed ∧
                wholeStateVorticityNonlinearNegativeOneState
                      (run (lineage.current stage) index).contact.physicalState
                      (run (lineage.current stage) index).contact.transverse
                      (run (lineage.current stage) index).contact.gradient_summable =
                    ((canonicalHalfCriticalComponentCount ν
                        (wholeRestartCrossingFiniteCoreState
                          (lineage.current stage) index crossed) : ℝ)⁻¹ : ℂ) •
                      wholeRestartCrossingFiniteCoreNegativeOneState
                        (lineage.current stage) index crossed ∨
                ((wholeRestartCrossingCompleteSourceGluingNegativeOneState
                      (lineage.current stage) index crossed ≠ 0 ∧
                    (wholeRestartComponentGluingResidualRow
                          (lineage.current stage) (index + 1) ≠ 0 ∨
                      linearResidualTrace
                          wholeRestartComponentGluingResidualTailKeep
                          (wholeRestartComponentGluingResidualTail
                            (lineage.current stage) index) 0 ≠ 0) ∧
                    0 <
                      wholeRestartCrossingTangentPayment
                        (lineage.current stage) index) ∨
                  ∃ receipt :
                      WholeRestartHighFrequencyAggregatePersistenceReceipt
                        (lineage.current stage) index radius crossed
                        (infiniteEndpointMacroStageKineticDefect
                          lineage stage / 2),
                    infiniteEndpointMacroStageKineticDefect
                          lineage stage / 2 <
                        ∑ output ∈ receipt.outputs,
                          complexCoordinateAmplitudeSq
                            ((run (lineage.current stage) index).contact.physicalState
                              output) ∧
                      aggregatePhysicalRateObstruction receipt)) := by
  let endpointReceipt :=
    ((generatedWholeRestartVelocityEndpointUniformKineticViscousLedger
      (lineage.current stage)
      (lineage.step stage).elapsedBounded).family.endpointReceipt).kineticReceipt
  rcases endpointReceipt.defect_disposition with
      endpointDefectPositive | endpointDefectZero
  · have defectPositive :
        0 < infiniteEndpointMacroStageKineticDefect lineage stage := by
      simpa only [infiniteEndpointMacroStageKineticDefect,
        endpointReceipt] using endpointDefectPositive
    refine Or.inr
      ⟨defectPositive,
        lineage.fullPairForcedTrace_aligned_norm_sq_not_tendsto_zero_of_stageDefect_pos
          stage defectPositive,
        ?_⟩
    intro radius
    obtain ⟨index, crossed, responsibility⟩ :=
      elapsedTime_bddAbove_forces_aggregate_physicalRateObstruction
        (lineage.current stage)
        (lineage.step stage).elapsedBounded
        radius
        (infiniteEndpointMacroStageKineticDefect lineage stage / 2)
    refine ⟨index, crossed, ?_⟩
    rcases responsibility with coreEscapes | gluingOrAggregate
    · rcases
          wholeRestartCrossing_reduced_forcing_or_native_residual_transport
            (lineage.current stage) index crossed with
        reducedForcing | gluing
      · exact Or.inl ⟨coreEscapes, reducedForcing⟩
      · exact Or.inr
          (Or.inl
            ⟨gluing.1, gluing.2,
              wholeRestartCrossingTangentPayment_pos_of_crossed
                (lineage.current stage) index crossed⟩)
    rcases gluingOrAggregate with gluing | aggregate
    · exact Or.inr (Or.inl gluing)
    obtain ⟨receipt⟩ := aggregate
    refine Or.inr (Or.inr ⟨receipt, ?_, receipt.2⟩)
    exact
      (le_max_left
        (infiniteEndpointMacroStageKineticDefect lineage stage / 2)
        0).trans_lt receipt.1.initialMassLarge
  · exact Or.inl <| by
      simpa only [infiniteEndpointMacroStageKineticDefect,
        endpointReceipt] using endpointDefectZero.1

end GeneratedInfiniteWholeRestartEndpointMacroLineage

