noncomputable section

namespace GeneratedInfiniteWholeRestartEndpointMacroLineage

def wholeRestartCofinalReducedCoreResponsibility
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) : Prop :=
  ∀ start radius : ℕ,
    ∃ index : ℕ,
      ∃ crossed :
          wholeRestartHalfCriticalCrossed (run initial start) index,
        radius <
            wholeRestartCrossingFiniteCoreRadius
              (run initial start) index crossed ∧
          wholeRestartCrossingCompleteSourceGluingNegativeOneState
              (run initial start) index crossed = 0 ∧
            wholeStateVorticityNonlinearNegativeOneState
                  (run (run initial start) index).contact.physicalState
                  (run (run initial start) index).contact.transverse
                  (run (run initial start) index).contact.gradient_summable =
                ((canonicalHalfCriticalComponentCount ν
                    (wholeRestartCrossingFiniteCoreState
                      (run initial start) index crossed) : ℝ)⁻¹ : ℂ) •
                  wholeRestartCrossingFiniteCoreNegativeOneState
                    (run initial start) index crossed

def wholeRestartNativeGluingResponsibility
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) : Prop :=
  ∃ start index : ℕ,
    ∃ crossed :
        wholeRestartHalfCriticalCrossed (run initial start) index,
      (wholeRestartCrossingCompleteSourceGluingNegativeOneState
            (run initial start) index crossed ≠ 0 ∧
          (wholeRestartComponentGluingResidualRow
                (run initial start) (index + 1) ≠ 0 ∨
            linearResidualTrace
                wholeRestartComponentGluingResidualTailKeep
                (wholeRestartComponentGluingResidualTail
                  (run initial start) index) 0 ≠ 0)) ∧
        0 <
          wholeRestartCrossingTangentPayment
            (run initial start) index

def wholeRestartAtomScaleAggregateResponsibility
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (budget : ℝ) : Prop :=
  ∃ start coreBound : ℕ,
    (∀ index : ℕ,
      ∀ crossed :
          wholeRestartHalfCriticalCrossed (run initial start) index,
        wholeRestartCrossingFiniteCoreRadius
            (run initial start) index crossed ≤ coreBound) ∧
      ∀ radius : ℕ,
        ∃ index : ℕ,
          ∃ crossed :
              wholeRestartHalfCriticalCrossed
                (run initial start) index,
            ∃ receipt :
                WholeRestartHighFrequencyAggregatePersistenceReceipt
                  (run initial start) index (max coreBound radius)
                  crossed budget,
              budget <
                  ∑ output ∈ receipt.outputs,
                    complexCoordinateAmplitudeSq
                      ((run (run initial start) index).contact.physicalState
                        output) ∧
                aggregatePhysicalRateObstruction receipt

set_option maxHeartbeats 800000 in
/-- Bounded physical time globally exhausts the pointwise frequency response.
The source generates a cofinal reduced-core lineage, a native gluing redirect,
or an eventual bounded-core aggregate lineage at the requested mass budget. -/
theorem
    elapsedTime_bddAbove_generates_cofinalReducedCore_or_nativeGluing_or_atomScaleAggregateLineage
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (budget : ℝ) :
    wholeRestartCofinalReducedCoreResponsibility initial ∨
      wholeRestartNativeGluingResponsibility initial ∨
      wholeRestartAtomScaleAggregateResponsibility initial budget := by
  by_cases nativeGluing :
      ∃ start index : ℕ,
        ∃ crossed :
            wholeRestartHalfCriticalCrossed (run initial start) index,
          (wholeRestartCrossingCompleteSourceGluingNegativeOneState
                (run initial start) index crossed ≠ 0 ∧
              (wholeRestartComponentGluingResidualRow
                    (run initial start) (index + 1) ≠ 0 ∨
                linearResidualTrace
                    wholeRestartComponentGluingResidualTailKeep
                    (wholeRestartComponentGluingResidualTail
                      (run initial start) index) 0 ≠ 0)) ∧
            0 <
              wholeRestartCrossingTangentPayment
                (run initial start) index
  · exact Or.inr (Or.inl nativeGluing)
  have noNativeGluing :
      ∀ start index : ℕ,
        ∀ crossed :
            wholeRestartHalfCriticalCrossed (run initial start) index,
          ¬ ((wholeRestartCrossingCompleteSourceGluingNegativeOneState
                  (run initial start) index crossed ≠ 0 ∧
                (wholeRestartComponentGluingResidualRow
                      (run initial start) (index + 1) ≠ 0 ∨
                  linearResidualTrace
                      wholeRestartComponentGluingResidualTailKeep
                      (wholeRestartComponentGluingResidualTail
                        (run initial start) index) 0 ≠ 0)) ∧
              0 <
                wholeRestartCrossingTangentPayment
                  (run initial start) index) := by
    intro start index crossed gluing
    exact nativeGluing ⟨start, index, crossed, gluing⟩
  by_cases cofinalCoreEscape :
      ∀ start radius : ℕ,
        ∃ index : ℕ,
          ∃ crossed :
              wholeRestartHalfCriticalCrossed (run initial start) index,
            radius <
              wholeRestartCrossingFiniteCoreRadius
                (run initial start) index crossed
  · left
    intro start radius
    obtain ⟨index, crossed, radiusLt⟩ :=
      cofinalCoreEscape start radius
    have gluingZero :
        wholeRestartCrossingCompleteSourceGluingNegativeOneState
          (run initial start) index crossed = 0 := by
      by_contra gluingNonzero
      exact noNativeGluing start index crossed
        ⟨⟨gluingNonzero,
            wholeRestartComponentGluingResidual_nonzero_next_or_trace
              (run initial start) index
              ((wholeRestartComponentGluingResidualRow_nonzero_iff_negativeOne
                (run initial start) index crossed).2 gluingNonzero)⟩,
          wholeRestartCrossingTangentPayment_pos_of_crossed
            (run initial start) index crossed⟩
    exact
      ⟨index, crossed, radiusLt, gluingZero,
        wholeRestartCrossingWholeNegativeOneState_eq_core_smul_of_gluing_zero
          (run initial start) index crossed gluingZero⟩
  · right
    right
    push Not at cofinalCoreEscape
    obtain ⟨start, coreBound, coreBounded⟩ := cofinalCoreEscape
    refine ⟨start, coreBound, ?_, ?_⟩
    · intro index crossed
      exact coreBounded index crossed
    · intro radius
      let tail := run initial start
      let tailElapsedBounded :
          BddAbove (Set.range (elapsedTime tail)) :=
        elapsedTime_run_bddAbove initial elapsedBounded start
      obtain ⟨index, crossed, responsibility⟩ :=
        elapsedTime_bddAbove_forces_aggregate_physicalRateObstruction
          tail tailElapsedBounded (max coreBound radius)
          budget
      refine ⟨index, crossed, ?_⟩
      rcases responsibility with coreEscapes | gluingOrAggregate
      · exact False.elim <|
          (not_lt_of_ge (coreBounded index crossed))
            ((Nat.le_max_left coreBound radius).trans_lt coreEscapes)
      rcases gluingOrAggregate with gluing | aggregate
      · exact False.elim <|
          noNativeGluing start index crossed
            ⟨⟨gluing.1, gluing.2.1⟩, gluing.2.2⟩
      obtain ⟨receipt⟩ := aggregate
      exact
        ⟨receipt,
          (le_max_left budget 0).trans_lt receipt.1.initialMassLarge,
          receipt.2⟩

/-- A positive endpoint atom globally exhausts the high-frequency escape.
Either every actual tail and requested radius generates a larger faithful-zero
reduced core, one actual tail generates a nonzero native gluing redirect, or
some actual tail has uniformly bounded least cores and consequently generates
atom-scale aggregate rate obstructions at every larger scale.

The tail start, core bound, crossing indices, outputs, branches, and nonzero
witnesses are all selected internally. -/
theorem
    stageDefect_generates_zero_or_cofinalReducedCore_or_nativeGluing_or_atomScaleAggregateLineage
    {ν : Viscosity}
    (lineage : GeneratedInfiniteWholeRestartEndpointMacroLineage ν)
    (stage : ℕ) :
    infiniteEndpointMacroStageKineticDefect lineage stage = 0 ∨
      (0 < infiniteEndpointMacroStageKineticDefect lineage stage ∧
        (wholeRestartCofinalReducedCoreResponsibility
              (lineage.current stage) ∨
          wholeRestartNativeGluingResponsibility
              (lineage.current stage) ∨
          wholeRestartAtomScaleAggregateResponsibility
            (lineage.current stage)
            (infiniteEndpointMacroStageKineticDefect lineage stage / 2))) := by
  rcases
      lineage.fullPairForcedTrace_generates_zero_or_atomScaleHighFrequencyPhysicalRate
        stage with
    defectZero | ⟨defectPositive, _traceNonsettling, _radiusResponse⟩
  · exact Or.inl defectZero
  exact Or.inr
    ⟨defectPositive,
      elapsedTime_bddAbove_generates_cofinalReducedCore_or_nativeGluing_or_atomScaleAggregateLineage
        (lineage.current stage)
        (lineage.step stage).elapsedBounded
        (infiniteEndpointMacroStageKineticDefect lineage stage / 2)⟩

end GeneratedInfiniteWholeRestartEndpointMacroLineage

