/-- The actual source-Duhamel rate quantum on one ordered pair coordinate.
Its scale, pair, gain, and duration are all generated by the same node. -/
def WholeRestartReducedCoreScaleLineage.sourcePairDuhamelRateQuantum
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (scale : WholeRestartReducedCoreScaleLineage initial)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (step : ℕ)
    (output first : IntegerWavevector) : ℝ :=
  let tail := run initial (scale.start step)
  let index := scale.relativeIndex step
  let tailElapsedBounded :
      BddAbove (Set.range (elapsedTime tail)) :=
    elapsedTime_run_bddAbove initial elapsedBounded (scale.start step)
  (‖wholeRestartBoundedElapsedCrossingSourceSelfPairDuhamelOccurrence
      tail tailElapsedBounded index output first‖ ^ 2 / 16) /
    (run tail index).nextContact.time.1

/-- Exact visible outcome at one source-generated pair coordinate. -/
abbrev WholeRestartReducedCoreScaleLineage.pairDuhamelVisibleAt
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (scale : WholeRestartReducedCoreScaleLineage initial)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (step : ℕ)
    (output first : IntegerWavevector) : Prop :=
  let tail := run initial (scale.start step)
  let index := scale.relativeIndex step
  let crossed := scale.crossed step
  output ≠ 0 ∧
    0 <
      wholeRestartCrossingSourceSelfVisibleSquareRow
        tail index crossed output ∧
    (canonicalHalfCriticalComponentCount ν
          (wholeRestartCrossingFiniteCoreState
            tail index crossed) : ℝ) *
        wholeRestartCrossingSourceSelfVisibleSquareRow
          tail index crossed output ≤
      ν.coeff * (2 * Real.pi) ^ 2 *
        wholeStateVorticityGradientMass
          (wholeRestartCrossingFiniteCoreState
            tail index crossed) ∧
    0 <
      ‖wholeRestartCrossingFiniteComponentSelfPairOccurrence
          tail index crossed output first‖ ^ 2 ∧
    wholeRestartCrossingFiniteComponentSelfPairOccurrence
          tail index crossed output first =
      ((canonicalHalfCriticalComponentCount ν
          (wholeRestartCrossingFiniteCoreState
            tail index crossed) : ℝ)⁻¹ : ℂ) •
        finiteStateVorticityNonlinearPairContribution
          (wholeRestartCrossingFiniteCoreState
            tail index crossed)
          (first, output - first) ∧
    0 < scale.sourcePairDuhamelRateQuantum
      elapsedBounded step output first ∧
    scale.sourcePairDuhamelRateQuantum
        elapsedBounded step output first ≤
      wholeRestartExactCausalNonlinearSquareRow
        tail index output

/-- Exact native outcome at one source-generated pair coordinate.  It keeps
the positive source quantum in provenance for the zero-visible branch. -/
abbrev WholeRestartReducedCoreScaleLineage.pairDuhamelNativeAt
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (scale : WholeRestartReducedCoreScaleLineage initial)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (step : ℕ)
    (output first : IntegerWavevector) : Prop :=
  let tail := run initial (scale.start step)
  let index := scale.relativeIndex step
  let crossed := scale.crossed step
  let tailElapsedBounded :
      BddAbove (Set.range (elapsedTime tail)) :=
    elapsedTime_run_bddAbove initial elapsedBounded (scale.start step)
  let sourceSquare :=
    ‖wholeRestartBoundedElapsedCrossingSourceSelfPairDuhamelOccurrence
      tail tailElapsedBounded index output first‖ ^ 2
  output ≠ 0 ∧
    0 <
      wholeRestartCrossingSourceSelfVisibleSquareRow
        tail index crossed output ∧
    (canonicalHalfCriticalComponentCount ν
          (wholeRestartCrossingFiniteCoreState
            tail index crossed) : ℝ) *
        wholeRestartCrossingSourceSelfVisibleSquareRow
          tail index crossed output ≤
      ν.coeff * (2 * Real.pi) ^ 2 *
        wholeStateVorticityGradientMass
          (wholeRestartCrossingFiniteCoreState
            tail index crossed) ∧
    0 <
      ‖wholeRestartCrossingFiniteComponentSelfPairOccurrence
          tail index crossed output first‖ ^ 2 ∧
    wholeRestartCrossingFiniteComponentSelfPairOccurrence
          tail index crossed output first =
      ((canonicalHalfCriticalComponentCount ν
          (wholeRestartCrossingFiniteCoreState
            tail index crossed) : ℝ)⁻¹ : ℂ) •
        finiteStateVorticityNonlinearPairContribution
          (wholeRestartCrossingFiniteCoreState
            tail index crossed)
          (first, output - first) ∧
    0 < scale.sourcePairDuhamelRateQuantum
      elapsedBounded step output first ∧
    ((sourceSquare / 4 ≤
          ‖wholeRestartPairDuhamelOccurrence
            tail index output first‖ ^ 2 ∧
        ∀ steps : ℕ,
          wholeRestartPairDuhamelPathTable
                tail index steps output first ≠ 0 ∨
            ((generatedWholeRestartPairDuhamelEffectiveProcess
                tail index).pathTrace 0 steps)
              0 output first ≠ 0) ∨
      ∃ time : Icc (0 : ℝ) (run tail index).nextContact.time.1,
        sourceSquare / 4 ≤
            ‖wholeRestartBoundedElapsedCrossingCompleteGluingPairDuhamelOccurrence
              tail tailElapsedBounded index output first‖ ^ 2 ∧
          wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
              tail index
                (elapsedTime_bddAbove_forces_every_halfCriticalCrossing
                  tail tailElapsedBounded index)
              output first time ≠ 0 ∧
            (wholeRestartPairOccurrenceTrace
                tail index output first time ≠ 0 ∨
              wholeRestartCrossingSourceSelfPairUpdate
                  tail index
                    (elapsedTime_bddAbove_forces_every_halfCriticalCrossing
                      tail tailElapsedBounded index)
                    (elapsedTime_bddAbove_forces_every_halfCriticalCrossing
                      tail tailElapsedBounded (index + 1))
                  output first ≠ 0 ∨
                wholeRestartCrossingCompleteOutgoingPairGluingOccurrence
                  tail (index + 1)
                    (elapsedTime_bddAbove_forces_every_halfCriticalCrossing
                      tail tailElapsedBounded (index + 1))
                  output first
                    ⟨0, ⟨le_rfl,
                      (run tail
                        (index + 1)).nextContact.time_pos.le⟩⟩ ≠ 0))

/-- Source-owned scalar payment: the generated occurrence quantum is written
exactly when a visible witness exists; all other outcomes write zero. -/
noncomputable def WholeRestartReducedCoreScaleLineage.paidPairDuhamelQuantum
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (scale : WholeRestartReducedCoreScaleLineage initial)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (step : ℕ) : ℝ := by
  classical
  exact if visible :
      ∃ output first : IntegerWavevector,
        scale.pairDuhamelVisibleAt
          elapsedBounded step output first then
    let output := Classical.choose visible
    let first := Classical.choose (Classical.choose_spec visible)
    scale.sourcePairDuhamelRateQuantum
      elapsedBounded step output first
  else
    0

/-- The source-owned node disposition on the actual update and whole
residual carrier.  A positive paid coordinate retains its exact visible pair;
if no visible coordinate exists, zero retains the producer's annular or
concrete native pair/gluing responsibility. -/
abbrev WholeRestartReducedCoreScaleLineage.pairDuhamelQuantumDisposition
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (scale : WholeRestartReducedCoreScaleLineage initial)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (step : ℕ) : Prop :=
  let tail := run initial (scale.start step)
  let index := scale.relativeIndex step
  run tail (wholeRestartComponentGluingNativeUpdate index) =
      (run tail index).next ∧
    wholeRestartComponentGluingResidualTail tail (index + 1) =
      wholeRestartComponentGluingResidualTailKeep
        (wholeRestartComponentGluingResidualTail tail index) ∧
    ((0 < scale.paidPairDuhamelQuantum elapsedBounded step ∧
      ∃ output first : IntegerWavevector,
        scale.pairDuhamelVisibleAt elapsedBounded step output first ∧
          scale.paidPairDuhamelQuantum elapsedBounded step =
            scale.sourcePairDuhamelRateQuantum
              elapsedBounded step output first) ∨
    (scale.paidPairDuhamelQuantum elapsedBounded step = 0 ∧
      ((∃ actual : Ioo (0 : ℝ) (run tail index).nextContact.time.1,
          let initialMass :=
            finiteStateVorticityCoefficientEnstrophy
              (scale.annularModes step)
              (run tail index).contact.physicalState
          let charge := ν.coeff * actual.1 * initialMass
          0 < charge ∧
            charge ≤
              wholeRestartNextKineticDissipationPayment tail index ∧
            (2 * Real.pi) ^ 2 *
                  ((scale.requestedRadius step + 1 : ℕ) : ℝ) ^ 2 *
                  charge <
              initialMass -
                finiteStateVorticityCoefficientEnstrophy
                  (scale.annularModes step)
                  ((run tail index).nextContact.prefixReceipt.wholePath
                    ⟨actual.1, actual.2.1.le, actual.2.2.le⟩)) ∨
        ∃ output first : IntegerWavevector,
          scale.pairDuhamelNativeAt elapsedBounded step output first)))

/-- The paid coordinate and the actual producer disposition are aligned on
the same source node. -/
theorem WholeRestartReducedCoreScaleLineage.paidPairDuhamelQuantum_spec
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (scale : WholeRestartReducedCoreScaleLineage initial)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (step : ℕ) :
    scale.pairDuhamelQuantumDisposition elapsedBounded step := by
  classical
  dsimp only [
    WholeRestartReducedCoreScaleLineage.pairDuhamelQuantumDisposition]
  let tail := run initial (scale.start step)
  let index := scale.relativeIndex step
  have generated :=
    scale.node_pairDuhamelQuantitativeExhaustion elapsedBounded step
  dsimp only at generated
  rcases generated with
    ⟨updateEq, residualEq, outcome⟩
  by_cases visibleExists :
      ∃ output first : IntegerWavevector,
        scale.pairDuhamelVisibleAt
          elapsedBounded step output first
  · let selectedOutput := Classical.choose visibleExists
    let selectedFirst :=
      Classical.choose (Classical.choose_spec visibleExists)
    have selectedSpec :
        scale.pairDuhamelVisibleAt
          elapsedBounded step selectedOutput selectedFirst :=
      Classical.choose_spec (Classical.choose_spec visibleExists)
    have paidEq :
        scale.paidPairDuhamelQuantum elapsedBounded step =
          scale.sourcePairDuhamelRateQuantum
            elapsedBounded step selectedOutput selectedFirst := by
      simp only [
        WholeRestartReducedCoreScaleLineage.paidPairDuhamelQuantum,
        dif_pos visibleExists, selectedOutput, selectedFirst]
    refine ⟨updateEq, residualEq, Or.inl ?_⟩
    refine ⟨?_, selectedOutput, selectedFirst, selectedSpec, paidEq⟩
    rw [paidEq]
    exact selectedSpec.2.2.2.2.2.1
  · have paidZero :
        scale.paidPairDuhamelQuantum elapsedBounded step = 0 := by
      simp only [
        WholeRestartReducedCoreScaleLineage.paidPairDuhamelQuantum,
        dif_neg visibleExists]
    refine ⟨updateEq, residualEq, Or.inr ⟨paidZero, ?_⟩⟩
    rcases outcome with annular | pair
    · exact Or.inl annular
    · rcases pair with
        ⟨output, first, outputNonzero, outputSquarePos,
          outputSquareCountLe, selfPairSquarePos, selfPairEq,
          sourceRatePositive, exhaustion⟩
      rcases exhaustion with visiblePayment | native
      · exact False.elim (visibleExists
          ⟨output, first,
            ⟨outputNonzero, outputSquarePos, outputSquareCountLe,
              selfPairSquarePos, selfPairEq, sourceRatePositive,
              visiblePayment⟩⟩)
      · exact Or.inr
          ⟨output, first,
            ⟨outputNonzero, outputSquarePos, outputSquareCountLe,
              selfPairSquarePos, selfPairEq, sourceRatePositive,
              native⟩⟩

theorem WholeRestartReducedCoreScaleLineage.paidPairDuhamelQuantum_nonneg
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (scale : WholeRestartReducedCoreScaleLineage initial)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (step : ℕ) :
    0 ≤ scale.paidPairDuhamelQuantum elapsedBounded step := by
  rcases (scale.paidPairDuhamelQuantum_spec elapsedBounded step).2.2 with
    paid | silent
  · exact paid.1.le
  · rw [silent.1]

/-- Every paid occurrence quantum is charged once to the authoritative exact
causal payment at its absolute whole-run occurrence. -/
theorem WholeRestartReducedCoreScaleLineage.paidPairDuhamelQuantum_le_exactCausal
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (scale : WholeRestartReducedCoreScaleLineage initial)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (step : ℕ) :
    scale.paidPairDuhamelQuantum elapsedBounded step ≤
      wholeRestartExactCausalNonlinearSquarePayment
        initial (scale.absoluteOccurrence step) := by
  rcases (scale.paidPairDuhamelQuantum_spec elapsedBounded step).2.2 with
    paid | silent
  · obtain ⟨_paidPositive, output, first, visibleSpec, paidEq⟩ := paid
    have rowEq :
        wholeRestartExactCausalNonlinearSquareRow
            (run initial (scale.start step))
            (scale.relativeIndex step) output =
          wholeRestartExactCausalNonlinearSquareRow
            initial (scale.absoluteOccurrence step) output := by
      unfold wholeRestartExactCausalNonlinearSquareRow
        wholeRestartExactCausalRateHeadroom
      rw [run_run]
      rfl
    rw [paidEq]
    calc
      scale.sourcePairDuhamelRateQuantum
            elapsedBounded step output first ≤
          wholeRestartExactCausalNonlinearSquareRow
            (run initial (scale.start step))
            (scale.relativeIndex step) output :=
        visibleSpec.2.2.2.2.2.2
      _ =
          wholeRestartExactCausalNonlinearSquareRow
            initial (scale.absoluteOccurrence step) output :=
        rowEq
      _ ≤
          wholeRestartExactCausalNonlinearSquarePayment
            initial (scale.absoluteOccurrence step) := by
        unfold wholeRestartExactCausalNonlinearSquarePayment
        exact
          (summable_wholeRestartExactCausalNonlinearSquareRow
            initial (scale.absoluteOccurrence step)).le_tsum output
              (fun other _otherNe =>
                wholeRestartExactCausalNonlinearSquareRow_nonneg
                  initial (scale.absoluteOccurrence step) other)
  · rw [silent.1]
    exact
      wholeRestartExactCausalNonlinearSquarePayment_nonneg
        initial (scale.absoluteOccurrence step)

/-- Strict source occurrences make every finite prefix of paid primitive
pair-Duhamel quanta a genuine subledger of the authoritative exact-causal
whole-run prefix. -/
theorem
    WholeRestartReducedCoreScaleLineage.paidPairDuhamelQuantumPrefix_le_exactCausal
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (scale : WholeRestartReducedCoreScaleLineage initial)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (length : ℕ) :
    (∑ step ∈ Finset.range length,
        scale.paidPairDuhamelQuantum elapsedBounded step) ≤
      ∑ occurrence ∈ Finset.range (scale.absoluteOccurrence length),
        wholeRestartExactCausalNonlinearSquarePayment
          initial occurrence := by
  calc
    (∑ step ∈ Finset.range length,
        scale.paidPairDuhamelQuantum elapsedBounded step) ≤
        ∑ step ∈ Finset.range length,
          wholeRestartExactCausalNonlinearSquarePayment
            initial (scale.absoluteOccurrence step) :=
      Finset.sum_le_sum fun step _stepMem =>
        scale.paidPairDuhamelQuantum_le_exactCausal
          elapsedBounded step
    _ =
        ∑ occurrence ∈
            (Finset.range length).image scale.absoluteOccurrence,
          wholeRestartExactCausalNonlinearSquarePayment
            initial occurrence := by
      rw [Finset.sum_image]
      intro left _leftMem right _rightMem occurrenceEq
      exact scale.absoluteOccurrence_strict.injective occurrenceEq
    _ ≤
        ∑ occurrence ∈ Finset.range (scale.absoluteOccurrence length),
          wholeRestartExactCausalNonlinearSquarePayment
            initial occurrence := by
      apply Finset.sum_le_sum_of_subset_of_nonneg
      · intro occurrence occurrenceMem
        rw [Finset.mem_image] at occurrenceMem
        obtain ⟨step, stepMem, rfl⟩ := occurrenceMem
        rw [Finset.mem_range] at stepMem ⊢
        exact scale.absoluteOccurrence_strict stepMem
      · intro occurrence _occurrenceMem _occurrenceNotSelected
        exact
          wholeRestartExactCausalNonlinearSquarePayment_nonneg
            initial occurrence

/-- One source-generated finite prefix carries every node's actual
update/keep/disposition and injects all positive pair-Duhamel quanta into the
same authoritative exact-causal whole-run prefix. -/
theorem
    WholeRestartReducedCoreScaleLineage.finitePrefix_pairDuhamelQuantumCascade
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (scale : WholeRestartReducedCoreScaleLineage initial)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (length : ℕ) :
    (∀ step < length,
        scale.pairDuhamelQuantumDisposition elapsedBounded step) ∧
      (∑ step ∈ Finset.range length,
          scale.paidPairDuhamelQuantum elapsedBounded step) ≤
        ∑ occurrence ∈ Finset.range (scale.absoluteOccurrence length),
          wholeRestartExactCausalNonlinearSquarePayment
            initial occurrence := by
  constructor
  · intro step _stepLt
    exact scale.paidPairDuhamelQuantum_spec elapsedBounded step
  · exact
      scale.paidPairDuhamelQuantumPrefix_le_exactCausal
        elapsedBounded length

