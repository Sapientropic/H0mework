private theorem WholeRestartReducedCoreScaleLineage.image_range_subset
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (scale : WholeRestartReducedCoreScaleLineage initial)
    (length : ℕ) :
    (Finset.range length).image scale.absoluteOccurrence ⊆
      Finset.range (scale.absoluteOccurrence length) := by
  intro occurrence occurrenceMem
  rw [Finset.mem_image] at occurrenceMem
  obtain ⟨step, stepMem, rfl⟩ := occurrenceMem
  rw [Finset.mem_range] at stepMem ⊢
  exact scale.absoluteOccurrence_strict stepMem

private theorem WholeRestartReducedCoreScaleLineage.quantumTimePrefix_le_full
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (scale : WholeRestartReducedCoreScaleLineage initial)
    (length : ℕ) :
    scale.quantumTimePrefix length ≤
      wholeRestartAccumulatedCrossingTangentQuantumTime
        initial (scale.absoluteOccurrence length) := by
  let occurrences :=
    (Finset.range length).image scale.absoluteOccurrence
  have selectedEq :
      scale.quantumTimePrefix length =
        ∑ occurrence ∈ occurrences,
          wholeRestartCrossingTangentQuantumTime initial occurrence := by
    unfold WholeRestartReducedCoreScaleLineage.quantumTimePrefix
    rw [Finset.sum_image]
    intro left _leftMem right _rightMem occurrenceEq
    exact scale.absoluteOccurrence_strict.injective occurrenceEq
  rw [selectedEq]
  unfold wholeRestartAccumulatedCrossingTangentQuantumTime
  exact Finset.sum_le_sum_of_subset_of_nonneg
    (scale.image_range_subset length)
    (fun occurrence _occurrenceMem _occurrenceNotSelected =>
      wholeRestartCrossingTangentQuantumTime_nonneg initial occurrence)

