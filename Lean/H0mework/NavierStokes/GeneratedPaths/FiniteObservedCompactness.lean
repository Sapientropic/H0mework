/-! ## The actual source-generated family -/

/-- One member of the full family of finite source paths satisfying the
same strict critical margin.  The path is source provenance, while the
analytic margin is the classical continuation regime to be consumed. -/
structure GeneratedCriticalScalePath
    (ν : Viscosity)
    (θ : ℝ) where
  seed : RawVorticityFourierSource
  current : RawVorticityFourierSource
  arrival : GeneratedIntegerShellReachable seed current
  initialMargin :
    criticalEnstrophyLatticeConstant *
        finiteStateVorticityCoefficientEnstrophy
          (generatedSupport current)
          (generatedComplexVorticityState current
            (generatedSupport current)) ≤
      θ * ν.coeff ^ 2 * (2 * Real.pi) ^ 2

/-- Common coefficient-enstrophy ceiling forced by the shared critical
margin.  `max 0` makes the consumer constant meaningful even when the
source-generated family is empty. -/
def criticalCoefficientEnstrophyCeiling
    (ν : Viscosity)
    (θ : ℝ) : ℝ :=
  max 0
    (θ * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 /
      criticalEnstrophyLatticeConstant)

theorem criticalCoefficientEnstrophyCeiling_nonneg
    (ν : Viscosity)
    (θ : ℝ) :
    0 ≤ criticalCoefficientEnstrophyCeiling ν θ := by
  exact le_max_left _ _

theorem GeneratedCriticalScalePath.initialEnstrophy_le_ceiling
    {ν : Viscosity}
    {θ : ℝ}
    (path : GeneratedCriticalScalePath ν θ) :
    finiteStateVorticityCoefficientEnstrophy
        (generatedSupport path.current)
        (generatedComplexVorticityState path.current
          (generatedSupport path.current)) ≤
      criticalCoefficientEnstrophyCeiling ν θ := by
  have divided :
      finiteStateVorticityCoefficientEnstrophy
          (generatedSupport path.current)
          (generatedComplexVorticityState path.current
            (generatedSupport path.current)) ≤
        θ * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 /
          criticalEnstrophyLatticeConstant := by
    apply
      (le_div_iff₀ criticalEnstrophyLatticeConstant_pos).2
    simpa [mul_comm] using path.initialMargin
  exact divided.trans (le_max_right _ _)

/-- The already-generated common-time trajectory and its complete analytic
ledger, tied definitionally to the exact source path. -/
def GeneratedCriticalScalePath.commonTimeBudget
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (path : GeneratedCriticalScalePath ν θ)
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime) :
    GeneratedPathCommonTimeCompactnessBudget
      path.arrival ν θ requestedTime :=
  generatedIntegerShellReachableCommonTimeCompactnessBudget
    path.arrival ν θ θLtOne path.initialMargin
    requestedTime requestedTimePos

/-! ## Fixed finite observation carrier -/

/-- Coefficients retained by one arbitrary fixed finite observation. -/
abbrev FiniteObservedCoefficientState
    (observed : Finset IntegerWavevector) :=
  {wave : IntegerWavevector // wave ∈ observed} →
    ComplexCoordinateVector

/-- Read the fixed finite observation directly from the common coefficient
carrier. -/
def finiteObservedCoefficientState
    (observed : Finset IntegerWavevector)
    (state : ComplexVorticityHilbertState) :
    FiniteObservedCoefficientState observed :=
  fun wave => state wave.1

/-- The actual source-generated observed trajectory on the requested common
time interval. -/
def generatedFiniteObservedTrajectory
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (observed : Finset IntegerWavevector)
    (path : GeneratedCriticalScalePath ν θ)
    (time : Icc (0 : ℝ) requestedTime) :
    FiniteObservedCoefficientState observed :=
  finiteObservedCoefficientState observed
    ((path.commonTimeBudget θLtOne requestedTimePos).trajectory time.1)

/-- Every generated family member is an actual continuous finite-observation
path.  Continuity is read from the generated Galerkin derivative law. -/
theorem generatedFiniteObservedTrajectory_continuous
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (observed : Finset IntegerWavevector)
    (path : GeneratedCriticalScalePath ν θ) :
    Continuous
      (generatedFiniteObservedTrajectory
        θLtOne requestedTimePos observed path) := by
  apply continuous_pi
  intro wave
  rw [continuous_iff_continuousAt]
  intro time
  have evolves :=
    ((path.commonTimeBudget θLtOne requestedTimePos).physicalProperties
      time.1 time.2).1
  have rowContinuous :
      ContinuousAt
        (fun t =>
          (path.commonTimeBudget θLtOne requestedTimePos).trajectory t
            wave.1)
        time.1 :=
    (complexVorticityTrajectoryWave_hasDerivAt
      (path.commonTimeBudget θLtOne requestedTimePos).trajectory
      time.1
      (finiteStateVorticityGenerator
        (generatedSupport path.current) ν.coeff
        ((path.commonTimeBudget θLtOne requestedTimePos).trajectory
          time.1))
      wave.1 evolves).continuousAt
  exact rowContinuous.comp continuousAt_subtype_val

/-- Bounded-continuous realization used by the uniform-convergence
Arzelà--Ascoli consumer. -/
def generatedFiniteObservedBoundedPath
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (observed : Finset IntegerWavevector)
    (path : GeneratedCriticalScalePath ν θ) :
    BoundedContinuousFunction
      (Icc (0 : ℝ) requestedTime)
      (FiniteObservedCoefficientState observed) :=
  BoundedContinuousFunction.mkOfCompact
    ⟨generatedFiniteObservedTrajectory
        θLtOne requestedTimePos observed path,
      generatedFiniteObservedTrajectory_continuous
        θLtOne requestedTimePos observed path⟩

/-! ## Uniform pointwise coefficient bound -/

theorem generatedFiniteObservedTrajectory_norm_le_ceiling
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (observed : Finset IntegerWavevector)
    (path : GeneratedCriticalScalePath ν θ)
    (time : Icc (0 : ℝ) requestedTime) :
    ‖generatedFiniteObservedTrajectory
        θLtOne requestedTimePos observed path time‖ ≤
      Real.sqrt (criticalCoefficientEnstrophyCeiling ν θ) := by
  let budget :=
    path.commonTimeBudget θLtOne requestedTimePos
  have currentEnstrophyLeInitial :
      finiteStateVorticityCoefficientEnstrophy
          (generatedSupport path.current)
          (budget.trajectory time.1) ≤
        finiteStateVorticityCoefficientEnstrophy
          (generatedSupport path.current)
          (budget.trajectory 0) := by
    have halfLe :=
      (budget.criticalBarrier time.1 time.2).1
    unfold finiteStateVorticityHalfEnstrophy at halfLe
    linarith
  have initialEnstrophyLe :
      finiteStateVorticityCoefficientEnstrophy
          (generatedSupport path.current)
          (budget.trajectory 0) ≤
        criticalCoefficientEnstrophyCeiling ν θ := by
    rw [budget.initial]
    exact path.initialEnstrophy_le_ceiling
  have currentEnstrophyLe :
      finiteStateVorticityCoefficientEnstrophy
          (generatedSupport path.current)
          (budget.trajectory time.1) ≤
        criticalCoefficientEnstrophyCeiling ν θ :=
    currentEnstrophyLeInitial.trans initialEnstrophyLe
  have ambientSqLe :
      ‖budget.trajectory time.1‖ ^ 2 ≤
        finiteStateVorticityCoefficientEnstrophy
          (generatedSupport path.current)
          (budget.trajectory time.1) :=
    complexVorticityHilbertState_norm_sq_le_coefficientEnstrophy
      (generatedSupport path.current)
      (budget.trajectory time.1)
      (budget.physicalProperties time.1 time.2).2.1
  have ambientNormLe :
      ‖budget.trajectory time.1‖ ≤
        Real.sqrt (criticalCoefficientEnstrophyCeiling ν θ) := by
    exact
      (Real.le_sqrt (norm_nonneg _)
        (criticalCoefficientEnstrophyCeiling_nonneg ν θ)).2
        (ambientSqLe.trans currentEnstrophyLe)
  apply
    (pi_norm_le_iff_of_nonneg
      (Real.sqrt_nonneg _)).2
  intro wave
  exact
    (lp.norm_apply_le_norm (by norm_num)
      (budget.trajectory time.1) wave.1).trans ambientNormLe

/-! ## A single cutoff-independent modulus for the full family -/

/-- Uniform `L²_t H⁻¹` ceiling after replacing each member's initial
enstrophy by the common critical ceiling. -/
def criticalNegativeOneTimeCeiling
    (ν : Viscosity)
    (θ : ℝ) : ℝ :=
  (4 * criticalEnstrophyLatticeConstant *
          criticalCoefficientEnstrophyCeiling ν θ ^ 2 +
      ν.coeff ^ 2 * (2 * Real.pi) ^ 2 *
        criticalCoefficientEnstrophyCeiling ν θ) /
    criticalEnstrophyAbsorptionCoefficient θ ν

theorem criticalNegativeOneTimeCeiling_nonneg
    (ν : Viscosity)
    (θ : ℝ)
    (θLtOne : θ < 1) :
    0 ≤ criticalNegativeOneTimeCeiling ν θ := by
  unfold criticalNegativeOneTimeCeiling
  apply div_nonneg
  · exact add_nonneg
      (mul_nonneg
        (mul_nonneg (by norm_num)
          criticalEnstrophyLatticeConstant_nonneg)
        (sq_nonneg _))
      (mul_nonneg
        (mul_nonneg (sq_nonneg _) (sq_nonneg _))
        (criticalCoefficientEnstrophyCeiling_nonneg ν θ))
  · exact
      (criticalEnstrophyAbsorptionCoefficient_pos
        θ θLtOne ν).le

private theorem coefficientEnstrophy_nonneg
    (modes : Finset IntegerWavevector)
    (state : ComplexVorticityHilbertState) :
    0 ≤ finiteStateVorticityCoefficientEnstrophy modes state := by
  unfold finiteStateVorticityCoefficientEnstrophy
  exact Finset.sum_nonneg fun _ _ =>
    complexCoordinateAmplitudeSq_nonneg _

theorem GeneratedCriticalScalePath.negativeOneTimeBudget_le_ceiling
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (path : GeneratedCriticalScalePath ν θ)
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime) :
    (∫ t in (0 : ℝ)..requestedTime,
      finiteStateVorticityNegativeOneMass
        (generatedSupport path.current)
        (finiteStateVorticityGenerator
          (generatedSupport path.current) ν.coeff
          ((path.commonTimeBudget
            θLtOne requestedTimePos).trajectory t))) ≤
      criticalNegativeOneTimeCeiling ν θ := by
  let budget :=
    path.commonTimeBudget θLtOne requestedTimePos
  let initialEnstrophy :=
    finiteStateVorticityCoefficientEnstrophy
      (generatedSupport path.current) (budget.trajectory 0)
  let ceiling :=
    criticalCoefficientEnstrophyCeiling ν θ
  have initialEnstrophyNonneg :
      0 ≤ initialEnstrophy :=
    coefficientEnstrophy_nonneg _ _
  have ceilingNonneg : 0 ≤ ceiling :=
    criticalCoefficientEnstrophyCeiling_nonneg ν θ
  have initialEnstrophyLe : initialEnstrophy ≤ ceiling := by
    dsimp [initialEnstrophy, budget]
    rw [
      (path.commonTimeBudget
        θLtOne requestedTimePos).initial]
    exact path.initialEnstrophy_le_ceiling
  have initialSqLe : initialEnstrophy ^ 2 ≤ ceiling ^ 2 :=
    (sq_le_sq₀ initialEnstrophyNonneg ceilingNonneg).2
      initialEnstrophyLe
  have numeratorLe :
      4 * criticalEnstrophyLatticeConstant *
            initialEnstrophy ^ 2 +
          ν.coeff ^ 2 * (2 * Real.pi) ^ 2 *
            initialEnstrophy ≤
        4 * criticalEnstrophyLatticeConstant *
            ceiling ^ 2 +
          ν.coeff ^ 2 * (2 * Real.pi) ^ 2 *
            ceiling := by
    exact add_le_add
      (mul_le_mul_of_nonneg_left initialSqLe
        (mul_nonneg (by norm_num)
          criticalEnstrophyLatticeConstant_nonneg))
      (mul_le_mul_of_nonneg_left initialEnstrophyLe
        (mul_nonneg (sq_nonneg _) (sq_nonneg _)))
  have dividedLe :
      (4 * criticalEnstrophyLatticeConstant *
              initialEnstrophy ^ 2 +
            ν.coeff ^ 2 * (2 * Real.pi) ^ 2 *
              initialEnstrophy) /
          criticalEnstrophyAbsorptionCoefficient θ ν ≤
        criticalNegativeOneTimeCeiling ν θ := by
    unfold criticalNegativeOneTimeCeiling
    dsimp [ceiling] at numeratorLe ⊢
    exact
      (div_le_div_iff_of_pos_right
        (criticalEnstrophyAbsorptionCoefficient_pos
          θ θLtOne ν)).2 numeratorLe
  exact
    budget.negativeOneTimeBudget.trans (by
      simpa [initialEnstrophy, budget] using dividedLe)

/-- Exact multiplier sum of the fixed finite observation. -/
def finiteObservedMultiplierMass
    (observed : Finset IntegerWavevector) : ℝ :=
  ∑ wave ∈ observed, integerWaveViscousMultiplier wave

theorem finiteObservedMultiplierMass_nonneg
    (observed : Finset IntegerWavevector) :
    0 ≤ finiteObservedMultiplierMass observed := by
  unfold finiteObservedMultiplierMass
  apply Finset.sum_nonneg
  intro wave waveMem
  unfold integerWaveViscousMultiplier
  exact mul_nonneg (sq_nonneg _) (integerWaveNormSq_nonneg wave)

/-- Squared `1 / 2`-Hölder constant shared by the whole generated family. -/
def finiteObservedHalfHolderEnergy
    (ν : Viscosity)
    (θ : ℝ)
    (observed : Finset IntegerWavevector) : ℝ :=
  finiteObservedMultiplierMass observed *
    criticalNegativeOneTimeCeiling ν θ

theorem finiteObservedHalfHolderEnergy_nonneg
    (ν : Viscosity)
    (θ : ℝ)
    (θLtOne : θ < 1)
    (observed : Finset IntegerWavevector) :
    0 ≤ finiteObservedHalfHolderEnergy ν θ observed := by
  exact mul_nonneg
    (finiteObservedMultiplierMass_nonneg observed)
    (criticalNegativeOneTimeCeiling_nonneg ν θ θLtOne)

/-- Common `1 / 2`-Hölder constant as a nonnegative real. -/
def finiteObservedHalfHolderConstant
    (ν : Viscosity)
    (θ : ℝ)
    (observed : Finset IntegerWavevector) : NNReal :=
  ⟨Real.sqrt
      (finiteObservedHalfHolderEnergy ν θ observed),
    Real.sqrt_nonneg _⟩

private theorem GeneratedCriticalScalePath.negativeOneMass_interval_le_ceiling
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (path : GeneratedCriticalScalePath ν θ)
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (a b : Icc (0 : ℝ) requestedTime)
    (hab : a.1 ≤ b.1) :
    (∫ t in a.1..b.1,
      finiteStateVorticityNegativeOneMass
        (generatedSupport path.current)
        (finiteStateVorticityGenerator
          (generatedSupport path.current) ν.coeff
          ((path.commonTimeBudget
            θLtOne requestedTimePos).trajectory t))) ≤
      criticalNegativeOneTimeCeiling ν θ := by
  let budget :=
    path.commonTimeBudget θLtOne requestedTimePos
  let mass : ℝ → ℝ :=
    fun t =>
      finiteStateVorticityNegativeOneMass
        (generatedSupport path.current)
        (finiteStateVorticityGenerator
          (generatedSupport path.current) ν.coeff
          (budget.trajectory t))
  have evolves :
      ∀ t ∈ Icc (0 : ℝ) requestedTime,
        HasDerivAt budget.trajectory
          (finiteStateVorticityGenerator
            (generatedSupport path.current) ν.coeff
            (budget.trajectory t)) t := by
    intro t tMem
    exact (budget.physicalProperties t tMem).1
  have massContinuous :
      ContinuousOn mass (Icc (0 : ℝ) requestedTime) := by
    exact
      finiteGalerkinGeneratorNegativeOneMass_continuousOn
        (generatedSupport path.current) ν.coeff
        budget.trajectory 0 requestedTime evolves
  have massIntegrable :
      IntervalIntegrable mass volume (0 : ℝ) requestedTime :=
    ContinuousOn.intervalIntegrable_of_Icc
      requestedTimePos.le massContinuous
  have localLeFull :
      (∫ t in a.1..b.1, mass t) ≤
        ∫ t in (0 : ℝ)..requestedTime, mass t := by
    apply intervalIntegral.integral_mono_interval
    · exact a.2.1
    · exact hab
    · exact b.2.2
    · exact
        Filter.Eventually.of_forall fun t =>
          finiteStateVorticityNegativeOneMass_nonneg _ _
    · exact massIntegrable
  exact localLeFull.trans (by
    simpa [mass, budget] using
      path.negativeOneTimeBudget_le_ceiling
        θLtOne requestedTimePos)

private theorem activeObservedMultiplier_le
    (observed modes : Finset IntegerWavevector) :
    (∑ wave ∈ observed.filter (fun wave => wave ∈ modes),
        integerWaveViscousMultiplier wave) ≤
      finiteObservedMultiplierMass observed := by
  unfold finiteObservedMultiplierMass
  apply Finset.sum_le_sum_of_subset_of_nonneg
  · intro wave waveMem
    exact (Finset.mem_filter.mp waveMem).1
  · intro wave waveNotMem waveMem
    unfold integerWaveViscousMultiplier
    exact mul_nonneg (sq_nonneg _) (integerWaveNormSq_nonneg wave)

private theorem generatedFiniteObservedTrajectory_ordered_increment_sq_le
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (observed : Finset IntegerWavevector)
    (path : GeneratedCriticalScalePath ν θ)
    (a b : Icc (0 : ℝ) requestedTime)
    (hab : a.1 ≤ b.1) :
    dist
        (generatedFiniteObservedTrajectory
          θLtOne requestedTimePos observed path a)
        (generatedFiniteObservedTrajectory
          θLtOne requestedTimePos observed path b) ^ 2 ≤
      (b.1 - a.1) *
        finiteObservedHalfHolderEnergy ν θ observed := by
  let budget :=
    path.commonTimeBudget θLtOne requestedTimePos
  let modes := generatedSupport path.current
  let activeObserved :=
    observed.filter (fun wave => wave ∈ modes)
  have activeSubset : activeObserved ⊆ modes := by
    intro wave waveMem
    exact (Finset.mem_filter.mp waveMem).2
  have activeZeroFree :
      ∀ wave ∈ activeObserved, wave ≠ 0 := by
    intro wave waveMem waveZero
    subst wave
    exact zero_not_mem_generatedSupport path.current
      (activeSubset waveMem)
  have evolves :
      ∀ t ∈ Icc a.1 b.1,
        HasDerivAt budget.trajectory
          (finiteStateVorticityGenerator
            modes ν.coeff (budget.trajectory t)) t := by
    intro t tMem
    exact
      (budget.physicalProperties t
        ⟨a.2.1.trans tMem.1,
          tMem.2.trans b.2.2⟩).1
  have summedIncrementLe :
      (∑ wave ∈ activeObserved,
          ‖budget.trajectory b.1 wave -
            budget.trajectory a.1 wave‖ ^ 2) ≤
        (b.1 - a.1) *
          (∑ wave ∈ activeObserved,
            integerWaveViscousMultiplier wave) *
          ∫ t in a.1..b.1,
            finiteStateVorticityNegativeOneMass modes
              (finiteStateVorticityGenerator
                modes ν.coeff (budget.trajectory t)) := by
    exact
      finiteGalerkinFiniteInventory_timeIncrement_sq_le_negativeOneMass
        modes activeObserved activeSubset activeZeroFree
        ν.coeff budget.trajectory a.1 b.1 hab evolves
  have observedNormSqLe :
      dist
          (generatedFiniteObservedTrajectory
            θLtOne requestedTimePos observed path a)
          (generatedFiniteObservedTrajectory
            θLtOne requestedTimePos observed path b) ^ 2 ≤
        ∑ wave ∈ activeObserved,
          ‖budget.trajectory b.1 wave -
            budget.trajectory a.1 wave‖ ^ 2 := by
    let incrementMass : ℝ :=
      ∑ wave ∈ activeObserved,
        ‖budget.trajectory b.1 wave -
          budget.trajectory a.1 wave‖ ^ 2
    have incrementMassNonneg : 0 ≤ incrementMass := by
      dsimp [incrementMass]
      exact Finset.sum_nonneg fun _ _ => sq_nonneg _
    have coordinateSqLe :
        ∀ wave : {wave : IntegerWavevector // wave ∈ observed},
          ‖budget.trajectory a.1 wave.1 -
              budget.trajectory b.1 wave.1‖ ^ 2 ≤
            incrementMass := by
      intro wave
      by_cases waveMem : wave.1 ∈ modes
      · have activeMem : wave.1 ∈ activeObserved := by
          exact Finset.mem_filter.mpr ⟨wave.2, waveMem⟩
        dsimp [incrementMass]
        simpa [norm_sub_rev] using
          (Finset.single_le_sum
            (fun later _ => sq_nonneg
              ‖budget.trajectory b.1 later -
                budget.trajectory a.1 later‖)
            activeMem)
      · have aZero :
            budget.trajectory a.1 wave.1 = 0 :=
          (budget.physicalProperties a.1 a.2).2.1
            wave.1 waveMem
        have bZero :
            budget.trajectory b.1 wave.1 = 0 :=
          (budget.physicalProperties b.1 b.2).2.1
            wave.1 waveMem
        simp [aZero, bZero, incrementMassNonneg]
    have normLeSqrt :
        ‖generatedFiniteObservedTrajectory
              θLtOne requestedTimePos observed path a -
            generatedFiniteObservedTrajectory
              θLtOne requestedTimePos observed path b‖ ≤
          Real.sqrt incrementMass := by
      apply
        (pi_norm_le_iff_of_nonneg
          (Real.sqrt_nonneg _)).2
      intro wave
      exact
        (Real.le_sqrt (norm_nonneg _)
          incrementMassNonneg).2 (coordinateSqLe wave)
    rw [dist_eq_norm]
    exact
      calc
        ‖generatedFiniteObservedTrajectory
              θLtOne requestedTimePos observed path a -
            generatedFiniteObservedTrajectory
              θLtOne requestedTimePos observed path b‖ ^ 2 ≤
            (Real.sqrt incrementMass) ^ 2 :=
          (sq_le_sq₀ (norm_nonneg _)
            (Real.sqrt_nonneg _)).2 normLeSqrt
        _ = incrementMass :=
          Real.sq_sqrt incrementMassNonneg
  have localBudgetLe :=
    path.negativeOneMass_interval_le_ceiling
      θLtOne requestedTimePos a b hab
  have activeMultiplierLe :
      (∑ wave ∈ activeObserved,
          integerWaveViscousMultiplier wave) ≤
        finiteObservedMultiplierMass observed := by
    simpa [activeObserved, modes] using
      activeObservedMultiplier_le observed modes
  have intervalNonneg :
      0 ≤
        ∫ t in a.1..b.1,
          finiteStateVorticityNegativeOneMass modes
            (finiteStateVorticityGenerator
              modes ν.coeff (budget.trajectory t)) := by
    apply intervalIntegral.integral_nonneg hab
    intro t tMem
    exact finiteStateVorticityNegativeOneMass_nonneg _ _
  have intervalLengthNonneg : 0 ≤ b.1 - a.1 :=
    sub_nonneg.mpr hab
  calc
    dist
        (generatedFiniteObservedTrajectory
          θLtOne requestedTimePos observed path a)
        (generatedFiniteObservedTrajectory
          θLtOne requestedTimePos observed path b) ^ 2 ≤
      (∑ wave ∈ activeObserved,
        ‖budget.trajectory b.1 wave -
          budget.trajectory a.1 wave‖ ^ 2) :=
      observedNormSqLe
    _ ≤
      (b.1 - a.1) *
        (∑ wave ∈ activeObserved,
          integerWaveViscousMultiplier wave) *
        ∫ t in a.1..b.1,
          finiteStateVorticityNegativeOneMass modes
            (finiteStateVorticityGenerator
              modes ν.coeff (budget.trajectory t)) :=
      summedIncrementLe
    _ ≤
      (b.1 - a.1) *
        finiteObservedMultiplierMass observed *
        criticalNegativeOneTimeCeiling ν θ := by
      exact
        mul_le_mul
          (mul_le_mul_of_nonneg_left
            activeMultiplierLe intervalLengthNonneg)
          localBudgetLe
          intervalNonneg
          (mul_nonneg intervalLengthNonneg
            (finiteObservedMultiplierMass_nonneg observed))
    _ =
      (b.1 - a.1) *
        finiteObservedHalfHolderEnergy ν θ observed := by
      simp [finiteObservedHalfHolderEnergy, mul_assoc]

/-- Uniform squared `1 / 2`-Hölder estimate for every member of the actual
source-generated family.  The observation is arbitrary; no containment in
the member's generated support is assumed. -/
theorem generatedFiniteObservedTrajectory_increment_sq_le
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (observed : Finset IntegerWavevector)
    (path : GeneratedCriticalScalePath ν θ)
    (first second : Icc (0 : ℝ) requestedTime) :
    dist
        (generatedFiniteObservedTrajectory
          θLtOne requestedTimePos observed path first)
        (generatedFiniteObservedTrajectory
          θLtOne requestedTimePos observed path second) ^ 2 ≤
      dist first second *
        finiteObservedHalfHolderEnergy ν θ observed := by
  by_cases order : first.1 ≤ second.1
  · have ordered :=
      generatedFiniteObservedTrajectory_ordered_increment_sq_le
        θLtOne requestedTimePos observed path first second order
    have distanceEq :
        dist first second = second.1 - first.1 := by
      rw [Subtype.dist_eq, Real.dist_eq]
      rw [abs_of_nonpos (sub_nonpos.mpr order)]
      ring
    simpa only [distanceEq] using ordered
  · have reverseOrder : second.1 ≤ first.1 :=
      le_of_not_ge order
    have ordered :=
      generatedFiniteObservedTrajectory_ordered_increment_sq_le
        θLtOne requestedTimePos observed path second first
          reverseOrder
    have distanceEq :
        dist first second = first.1 - second.1 := by
      rw [Subtype.dist_eq, Real.dist_eq]
      exact abs_of_nonneg (sub_nonneg.mpr reverseOrder)
    rw [distanceEq]
    simpa only [dist_comm] using ordered

/-- Real form of the common `1 / 2`-Hölder modulus. -/
theorem generatedFiniteObservedTrajectory_halfHolder_dist
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (observed : Finset IntegerWavevector)
    (path : GeneratedCriticalScalePath ν θ)
    (first second : Icc (0 : ℝ) requestedTime) :
    dist
        (generatedFiniteObservedTrajectory
          θLtOne requestedTimePos observed path first)
        (generatedFiniteObservedTrajectory
          θLtOne requestedTimePos observed path second) ≤
      (finiteObservedHalfHolderConstant ν θ observed : ℝ) *
        dist first second ^ (1 / 2 : ℝ) := by
  let energy :=
    finiteObservedHalfHolderEnergy ν θ observed
  have energyNonneg : 0 ≤ energy :=
    finiteObservedHalfHolderEnergy_nonneg
      ν θ θLtOne observed
  have distanceProductNonneg :
      0 ≤ dist first second * energy :=
    mul_nonneg dist_nonneg energyNonneg
  have squareLe :
      dist
          (generatedFiniteObservedTrajectory
            θLtOne requestedTimePos observed path first)
          (generatedFiniteObservedTrajectory
            θLtOne requestedTimePos observed path second) ^ 2 ≤
        dist first second * energy := by
    simpa [energy] using
      generatedFiniteObservedTrajectory_increment_sq_le
        θLtOne requestedTimePos observed path first second
  have distanceLeSqrt :
      dist
          (generatedFiniteObservedTrajectory
            θLtOne requestedTimePos observed path first)
          (generatedFiniteObservedTrajectory
            θLtOne requestedTimePos observed path second) ≤
        Real.sqrt (dist first second * energy) :=
    (Real.le_sqrt dist_nonneg distanceProductNonneg).2 squareLe
  calc
    dist
        (generatedFiniteObservedTrajectory
          θLtOne requestedTimePos observed path first)
        (generatedFiniteObservedTrajectory
          θLtOne requestedTimePos observed path second) ≤
      Real.sqrt (dist first second * energy) :=
      distanceLeSqrt
    _ =
      Real.sqrt energy * Real.sqrt (dist first second) := by
      rw [mul_comm]
      exact Real.sqrt_mul energyNonneg _
    _ =
      (finiteObservedHalfHolderConstant ν θ observed : ℝ) *
        dist first second ^ (1 / 2 : ℝ) := by
      change
        Real.sqrt energy * Real.sqrt (dist first second) =
          Real.sqrt energy *
            dist first second ^ (1 / 2 : ℝ)
      simp only [Real.sqrt_eq_rpow]

/-- Machine-level common `1 / 2`-Hölder law for the full actual family. -/
theorem generatedFiniteObservedTrajectory_holderWith
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (observed : Finset IntegerWavevector)
    (path : GeneratedCriticalScalePath ν θ) :
    HolderWith
      (finiteObservedHalfHolderConstant ν θ observed)
      (1 / 2 : NNReal)
      (generatedFiniteObservedTrajectory
        θLtOne requestedTimePos observed path) := by
  intro first second
  rw [edist_nndist, edist_nndist]
  rw [← ENNReal.coe_rpow_of_nonneg
    (nndist first second) (by norm_num)]
  rw [← ENNReal.coe_mul]
  apply ENNReal.coe_le_coe.mpr
  apply NNReal.coe_le_coe.mp
  rw [coe_nndist, NNReal.coe_mul,
    NNReal.coe_rpow, coe_nndist]
  norm_num
  exact
    generatedFiniteObservedTrajectory_halfHolder_dist
      θLtOne requestedTimePos observed path first second

/-! ## Arzelà--Ascoli on the actual generated family -/

/-- The complete set of actual observed trajectories generated by all
finite source paths in the shared critical regime. -/
def generatedFiniteObservedPathFamily
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (observed : Finset IntegerWavevector) :
    Set
      (BoundedContinuousFunction
        (Icc (0 : ℝ) requestedTime)
        (FiniteObservedCoefficientState observed)) :=
  Set.range fun path : GeneratedCriticalScalePath ν θ =>
    generatedFiniteObservedBoundedPath
      θLtOne requestedTimePos observed path

theorem generatedFiniteObservedPathFamily_equicontinuous
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (observed : Finset IntegerWavevector) :
    Equicontinuous
      (fun member :
          generatedFiniteObservedPathFamily
            (ν := ν) θLtOne requestedTimePos observed =>
        (member.1 :
          Icc (0 : ℝ) requestedTime →
            FiniteObservedCoefficientState observed)) := by
  let holderConstant : ℝ :=
    finiteObservedHalfHolderConstant ν θ observed
  let modulus : ℝ → ℝ :=
    fun radius => holderConstant * Real.sqrt |radius|
  have modulusContinuous : Continuous modulus := by
    exact continuous_const.mul
      (Real.continuous_sqrt.comp continuous_abs)
  have modulusTendsToZero :
      Tendsto modulus (𝓝 0) (𝓝 0) := by
    have atZero : ContinuousAt modulus 0 :=
      modulusContinuous.continuousAt
    have modulusZero : modulus 0 = 0 := by
      simp [modulus]
    nth_rewrite 2 [← modulusZero]
    exact atZero
  apply
    Metric.equicontinuous_of_continuity_modulus
      modulus modulusTendsToZero
  intro first second member
  rcases member with ⟨function, ⟨path, functionEq⟩⟩
  subst function
  change
    dist
        (generatedFiniteObservedTrajectory
          θLtOne requestedTimePos observed path first)
        (generatedFiniteObservedTrajectory
          θLtOne requestedTimePos observed path second) ≤
      modulus (dist first second)
  calc
    dist
        (generatedFiniteObservedTrajectory
          θLtOne requestedTimePos observed path first)
        (generatedFiniteObservedTrajectory
          θLtOne requestedTimePos observed path second) ≤
      (finiteObservedHalfHolderConstant ν θ observed : ℝ) *
        dist first second ^ (1 / 2 : ℝ) :=
      generatedFiniteObservedTrajectory_halfHolder_dist
        θLtOne requestedTimePos observed path first second
    _ = modulus (dist first second) := by
      simp [modulus, holderConstant, abs_of_nonneg dist_nonneg,
        Real.sqrt_eq_rpow]

/-- Arzelà--Ascoli for the entire actual source-generated family on every
fixed finite Fourier observation.  The compact set is generated in the
conclusion as the uniform closure; no compactness witness or target limit
is accepted by the theorem. -/
theorem generatedFiniteObservedPathFamily_isCompact_closure
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (observed : Finset IntegerWavevector) :
    IsCompact
      (closure
        (generatedFiniteObservedPathFamily
          (ν := ν) θLtOne requestedTimePos observed)) := by
  let coefficientBall :
      Set (FiniteObservedCoefficientState observed) :=
    Metric.closedBall 0
      (Real.sqrt
        (criticalCoefficientEnstrophyCeiling ν θ))
  apply
    BoundedContinuousFunction.arzela_ascoli
      coefficientBall
      (isCompact_closedBall _ _)
  · intro function time functionMem
    rcases functionMem with ⟨path, rfl⟩
    rw [Metric.mem_closedBall, dist_zero_right]
    exact
      generatedFiniteObservedTrajectory_norm_le_ceiling
        θLtOne requestedTimePos observed path time
  · exact
      generatedFiniteObservedPathFamily_equicontinuous
        θLtOne requestedTimePos observed

end

