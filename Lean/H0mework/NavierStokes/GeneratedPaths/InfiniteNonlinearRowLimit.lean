/-! ## Continuous whole nonlinear rows on one transverse interval -/

theorem wholeStateVorticityNonlinearCoefficientAt_comp_continuousOn
    (trajectory : ℝ → ComplexVorticityHilbertState)
    (output : IntegerWavevector)
    (a b : ℝ)
    (trajectoryContinuous : ContinuousOn trajectory (Icc a b))
    (trajectoryTransverse :
      ∀ t ∈ Icc a b, WholeStateTransverse (trajectory t)) :
    ContinuousOn
      (fun t =>
        wholeStateVorticityNonlinearCoefficientAt
          (trajectory t) output)
      (Icc a b) := by
  rw [continuousOn_iff_continuous_restrict]
  change
    Continuous
      (fun t : Icc a b =>
        wholeStateVorticityNonlinearCoefficientAt
          (trajectory t.1) output)
  let lifted : Icc a b → WholeTransverseVorticityState :=
    fun t => ⟨trajectory t.1, trajectoryTransverse t.1 t.2⟩
  have liftedContinuous : Continuous lifted := by
    exact
      (trajectoryContinuous.restrict).subtype_mk
        (fun t => trajectoryTransverse t.1 t.2)
  have observedContinuous :
      Continuous
        (fun t : Icc a b =>
          wholeStateVorticityNonlinearCoefficientAt
            (lifted t).1 output) :=
    (wholeStateVorticityNonlinearCoefficientAt_continuous output).comp
      liftedContinuous
  exact observedContinuous

/-! ## The whole `L² × L² → L¹` row estimate -/

/--
Every fixed infinite nonlinear Fourier row is locally Lipschitz from the
whole transverse `L²_t(ℓ²)` carrier to `L¹_t`.
-/
theorem
    wholeStateVorticityNonlinearCoefficientAt_sub_norm_intervalIntegral_le
    (left right : ℝ → ComplexVorticityHilbertState)
    (output : IntegerWavevector)
    (a b : ℝ)
    (hab : a ≤ b)
    (leftContinuous : ContinuousOn left (Icc a b))
    (rightContinuous : ContinuousOn right (Icc a b))
    (leftTransverse :
      ∀ t ∈ Icc a b, WholeStateTransverse (left t))
    (rightTransverse :
      ∀ t ∈ Icc a b, WholeStateTransverse (right t)) :
    (∫ t in a..b,
        ‖wholeStateVorticityNonlinearCoefficientAt
              (left t) output -
            wholeStateVorticityNonlinearCoefficientAt
              (right t) output‖) ≤
      6 * Real.sqrt (integerWaveNormSq output) *
        Real.sqrt (∫ t in a..b, ‖left t - right t‖ ^ 2) *
        (Real.sqrt (∫ t in a..b, ‖left t‖ ^ 2) +
          Real.sqrt (∫ t in a..b, ‖right t‖ ^ 2)) := by
  let angular : ℝ :=
    6 * Real.sqrt (integerWaveNormSq output)
  let differenceAmplitude : ℝ → ℝ :=
    fun t => ‖left t - right t‖
  let leftAmplitude : ℝ → ℝ :=
    fun t => ‖left t‖
  let rightAmplitude : ℝ → ℝ :=
    fun t => ‖right t‖
  have differenceContinuous :
      ContinuousOn differenceAmplitude (Icc a b) := by
    exact (leftContinuous.sub rightContinuous).norm
  have leftAmplitudeContinuous :
      ContinuousOn leftAmplitude (Icc a b) :=
    leftContinuous.norm
  have rightAmplitudeContinuous :
      ContinuousOn rightAmplitude (Icc a b) :=
    rightContinuous.norm
  have leftNonlinearContinuous :=
    wholeStateVorticityNonlinearCoefficientAt_comp_continuousOn
      left output a b leftContinuous leftTransverse
  have rightNonlinearContinuous :=
    wholeStateVorticityNonlinearCoefficientAt_comp_continuousOn
      right output a b rightContinuous rightTransverse
  have nonlinearDifferenceNormContinuous :
      ContinuousOn
        (fun t =>
          ‖wholeStateVorticityNonlinearCoefficientAt
                (left t) output -
              wholeStateVorticityNonlinearCoefficientAt
                (right t) output‖)
        (Icc a b) :=
    (leftNonlinearContinuous.sub rightNonlinearContinuous).norm
  have pointwise :
      ∀ t ∈ Icc a b,
        ‖wholeStateVorticityNonlinearCoefficientAt
              (left t) output -
            wholeStateVorticityNonlinearCoefficientAt
              (right t) output‖ ≤
          angular *
            (differenceAmplitude t * leftAmplitude t +
              differenceAmplitude t * rightAmplitude t) := by
    intro t timeMem
    have base :=
      wholeStateVorticityNonlinearCoefficientAt_sub_norm_le
        (left t) (right t)
        (leftTransverse t timeMem)
        (rightTransverse t timeMem) output
    simpa [angular, differenceAmplitude, leftAmplitude,
      rightAmplitude, mul_add, mul_assoc] using base
  have nonlinearIntegrable :
      IntervalIntegrable
        (fun t =>
          ‖wholeStateVorticityNonlinearCoefficientAt
                (left t) output -
              wholeStateVorticityNonlinearCoefficientAt
                (right t) output‖)
        volume a b :=
    ContinuousOn.intervalIntegrable_of_Icc
      hab nonlinearDifferenceNormContinuous
  have differenceLeftIntegrable :
      IntervalIntegrable
        (fun t => differenceAmplitude t * leftAmplitude t)
        volume a b :=
    ContinuousOn.intervalIntegrable_of_Icc hab
      (differenceContinuous.mul leftAmplitudeContinuous)
  have differenceRightIntegrable :
      IntervalIntegrable
        (fun t => differenceAmplitude t * rightAmplitude t)
        volume a b :=
    ContinuousOn.intervalIntegrable_of_Icc hab
      (differenceContinuous.mul rightAmplitudeContinuous)
  have majorantIntegrable :
      IntervalIntegrable
        (fun t =>
          angular *
            (differenceAmplitude t * leftAmplitude t +
              differenceAmplitude t * rightAmplitude t))
        volume a b :=
    (differenceLeftIntegrable.add differenceRightIntegrable).const_mul
      angular
  have integratedPointwise :
      (∫ t in a..b,
          ‖wholeStateVorticityNonlinearCoefficientAt
                (left t) output -
              wholeStateVorticityNonlinearCoefficientAt
                (right t) output‖) ≤
        ∫ t in a..b,
          angular *
            (differenceAmplitude t * leftAmplitude t +
              differenceAmplitude t * rightAmplitude t) :=
    intervalIntegral.integral_mono_on
      hab nonlinearIntegrable majorantIntegrable pointwise
  have differenceLeftCauchy :
      (∫ t in a..b,
          differenceAmplitude t * leftAmplitude t) ≤
        Real.sqrt
            (∫ t in a..b, differenceAmplitude t ^ 2) *
          Real.sqrt
            (∫ t in a..b, leftAmplitude t ^ 2) :=
    intervalIntegral_mul_le_sqrt_integral_sq_mul_sqrt_integral_sq
      differenceAmplitude leftAmplitude a b hab
      differenceContinuous leftAmplitudeContinuous
      (fun t timeMem => norm_nonneg _)
      (fun t timeMem => norm_nonneg _)
  have differenceRightCauchy :
      (∫ t in a..b,
          differenceAmplitude t * rightAmplitude t) ≤
        Real.sqrt
            (∫ t in a..b, differenceAmplitude t ^ 2) *
          Real.sqrt
            (∫ t in a..b, rightAmplitude t ^ 2) :=
    intervalIntegral_mul_le_sqrt_integral_sq_mul_sqrt_integral_sq
      differenceAmplitude rightAmplitude a b hab
      differenceContinuous rightAmplitudeContinuous
      (fun t timeMem => norm_nonneg _)
      (fun t timeMem => norm_nonneg _)
  have angularNonneg : 0 ≤ angular := by
    dsimp [angular]
    positivity
  calc
    (∫ t in a..b,
        ‖wholeStateVorticityNonlinearCoefficientAt
              (left t) output -
            wholeStateVorticityNonlinearCoefficientAt
              (right t) output‖) ≤
        ∫ t in a..b,
          angular *
            (differenceAmplitude t * leftAmplitude t +
              differenceAmplitude t * rightAmplitude t) :=
      integratedPointwise
    _ =
        angular *
          ((∫ t in a..b,
              differenceAmplitude t * leftAmplitude t) +
            ∫ t in a..b,
              differenceAmplitude t * rightAmplitude t) := by
      rw [intervalIntegral.integral_const_mul,
        intervalIntegral.integral_add
          differenceLeftIntegrable differenceRightIntegrable]
    _ ≤
        angular *
          (Real.sqrt
                (∫ t in a..b, differenceAmplitude t ^ 2) *
              Real.sqrt
                (∫ t in a..b, leftAmplitude t ^ 2) +
            Real.sqrt
                (∫ t in a..b, differenceAmplitude t ^ 2) *
              Real.sqrt
                (∫ t in a..b, rightAmplitude t ^ 2)) :=
      mul_le_mul_of_nonneg_left
        (add_le_add differenceLeftCauchy differenceRightCauchy)
        angularNonneg
    _ =
        6 * Real.sqrt (integerWaveNormSq output) *
          Real.sqrt (∫ t in a..b, ‖left t - right t‖ ^ 2) *
          (Real.sqrt (∫ t in a..b, ‖left t‖ ^ 2) +
            Real.sqrt (∫ t in a..b, ‖right t‖ ^ 2)) := by
      dsimp [angular, differenceAmplitude,
        leftAmplitude, rightAmplitude]
      ring

/-! ## Exact generated-path specialization -/

/--
Two arbitrary source-generated critical paths satisfy the whole nonlinear
row estimate on their common requested interval.  All trajectory,
transversality, and regularity data are read from their actual generated
budgets.
-/
theorem generatedCriticalScalePaths_infiniteNonlinearRow_intervalIntegral_le
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (leftPath rightPath : GeneratedCriticalScalePath ν θ)
    (output : IntegerWavevector) :
    (∫ t in (0 : ℝ)..requestedTime,
        ‖wholeStateVorticityNonlinearCoefficientAt
              ((leftPath.commonTimeBudget
                θLtOne requestedTimePos).trajectory t) output -
            wholeStateVorticityNonlinearCoefficientAt
              ((rightPath.commonTimeBudget
                θLtOne requestedTimePos).trajectory t) output‖) ≤
      6 * Real.sqrt (integerWaveNormSq output) *
        Real.sqrt
          (∫ t in (0 : ℝ)..requestedTime,
            ‖(leftPath.commonTimeBudget
                  θLtOne requestedTimePos).trajectory t -
                (rightPath.commonTimeBudget
                  θLtOne requestedTimePos).trajectory t‖ ^ 2) *
        (Real.sqrt
            (∫ t in (0 : ℝ)..requestedTime,
              ‖(leftPath.commonTimeBudget
                θLtOne requestedTimePos).trajectory t‖ ^ 2) +
          Real.sqrt
            (∫ t in (0 : ℝ)..requestedTime,
              ‖(rightPath.commonTimeBudget
                θLtOne requestedTimePos).trajectory t‖ ^ 2)) := by
  let left :=
    (leftPath.commonTimeBudget θLtOne requestedTimePos).trajectory
  let right :=
    (rightPath.commonTimeBudget θLtOne requestedTimePos).trajectory
  have leftContinuous :
      ContinuousOn left (Icc (0 : ℝ) requestedTime) := by
    intro t timeMem
    exact
      ((leftPath.commonTimeBudget
          θLtOne requestedTimePos).physicalProperties t timeMem).1
        |>.continuousAt.continuousWithinAt
  have rightContinuous :
      ContinuousOn right (Icc (0 : ℝ) requestedTime) := by
    intro t timeMem
    exact
      ((rightPath.commonTimeBudget
          θLtOne requestedTimePos).physicalProperties t timeMem).1
        |>.continuousAt.continuousWithinAt
  have leftTransverse :
      ∀ t ∈ Icc (0 : ℝ) requestedTime,
        WholeStateTransverse (left t) := by
    intro t timeMem wave
    exact
      ((leftPath.commonTimeBudget
        θLtOne requestedTimePos).physicalProperties t timeMem).2.2.1 wave
  have rightTransverse :
      ∀ t ∈ Icc (0 : ℝ) requestedTime,
        WholeStateTransverse (right t) := by
    intro t timeMem wave
    exact
      ((rightPath.commonTimeBudget
        θLtOne requestedTimePos).physicalProperties t timeMem).2.2.1 wave
  simpa only [left, right] using
    wholeStateVorticityNonlinearCoefficientAt_sub_norm_intervalIntegral_le
      left right output 0 requestedTime requestedTimePos.le
      leftContinuous rightContinuous leftTransverse rightTransverse

/-! ## Exact alignment with the strong whole space-time carrier -/

theorem generatedCriticalSpaceTimePath_norm_sq_eq_intervalIntegral
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (path : GeneratedCriticalScalePath ν θ) :
    ‖generatedCriticalSpaceTimePath
        θLtOne requestedTimePos path‖ ^ 2 =
      ∫ t in (0 : ℝ)..requestedTime,
        ‖(path.commonTimeBudget
          θLtOne requestedTimePos).trajectory t‖ ^ 2 := by
  rw [spaceTime_norm_sq_eq_integral]
  have wholeAE :=
    BoundedContinuousFunction.coeFn_toLp
      (p := (2 : ℝ≥0∞))
      (μ := commonTimeMeasure requestedTime)
      ℂ
      (generatedWholeBoundedPath
        θLtOne requestedTimePos path)
  calc
    (∫ time,
        ‖(generatedCriticalSpaceTimePath
          θLtOne requestedTimePos path) time‖ ^ 2
        ∂(commonTimeMeasure requestedTime)) =
        ∫ time,
          ‖generatedWholeTrajectory
            θLtOne requestedTimePos path time‖ ^ 2
          ∂(commonTimeMeasure requestedTime) := by
      apply integral_congr_ae
      filter_upwards [wholeAE] with time wholeEq
      change
        ‖((BoundedContinuousFunction.toLp 2
            (commonTimeMeasure requestedTime) ℂ)
          (generatedWholeBoundedPath
            θLtOne requestedTimePos path)) time‖ ^ 2 =
          _
      rw [wholeEq]
      rfl
    _ =
        ∫ t in (0 : ℝ)..requestedTime,
          ‖(path.commonTimeBudget
            θLtOne requestedTimePos).trajectory t‖ ^ 2 := by
      simpa [generatedWholeTrajectory] using
        commonTime_integral_eq_intervalIntegral
          requestedTime requestedTimePos.le
          (fun t =>
            ‖(path.commonTimeBudget
              θLtOne requestedTimePos).trajectory t‖ ^ 2)

theorem generatedCriticalSpaceTimePath_sub_norm_sq_eq_intervalIntegral
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (leftPath rightPath : GeneratedCriticalScalePath ν θ) :
    ‖generatedCriticalSpaceTimePath
          θLtOne requestedTimePos leftPath -
        generatedCriticalSpaceTimePath
          θLtOne requestedTimePos rightPath‖ ^ 2 =
      ∫ t in (0 : ℝ)..requestedTime,
        ‖(leftPath.commonTimeBudget
              θLtOne requestedTimePos).trajectory t -
            (rightPath.commonTimeBudget
              θLtOne requestedTimePos).trajectory t‖ ^ 2 := by
  rw [spaceTime_norm_sq_eq_integral]
  have leftAE :=
    BoundedContinuousFunction.coeFn_toLp
      (p := (2 : ℝ≥0∞))
      (μ := commonTimeMeasure requestedTime)
      ℂ
      (generatedWholeBoundedPath
        θLtOne requestedTimePos leftPath)
  have rightAE :=
    BoundedContinuousFunction.coeFn_toLp
      (p := (2 : ℝ≥0∞))
      (μ := commonTimeMeasure requestedTime)
      ℂ
      (generatedWholeBoundedPath
        θLtOne requestedTimePos rightPath)
  have subAE :=
    MeasureTheory.Lp.coeFn_sub
      (generatedCriticalSpaceTimePath
        θLtOne requestedTimePos leftPath)
      (generatedCriticalSpaceTimePath
        θLtOne requestedTimePos rightPath)
  calc
    (∫ time,
        ‖(generatedCriticalSpaceTimePath
              θLtOne requestedTimePos leftPath -
            generatedCriticalSpaceTimePath
              θLtOne requestedTimePos rightPath) time‖ ^ 2
          ∂(commonTimeMeasure requestedTime)) =
        ∫ time,
          ‖generatedWholeTrajectory
                θLtOne requestedTimePos leftPath time -
              generatedWholeTrajectory
                θLtOne requestedTimePos rightPath time‖ ^ 2
          ∂(commonTimeMeasure requestedTime) := by
      apply integral_congr_ae
      filter_upwards [subAE, leftAE, rightAE] with
        time subEq leftEq rightEq
      rw [subEq]
      change
        ‖((BoundedContinuousFunction.toLp 2
              (commonTimeMeasure requestedTime) ℂ)
              (generatedWholeBoundedPath
                θLtOne requestedTimePos leftPath)) time -
            ((BoundedContinuousFunction.toLp 2
              (commonTimeMeasure requestedTime) ℂ)
              (generatedWholeBoundedPath
                θLtOne requestedTimePos rightPath)) time‖ ^ 2 =
          _
      rw [leftEq, rightEq]
      rfl
    _ =
        ∫ t in (0 : ℝ)..requestedTime,
          ‖(leftPath.commonTimeBudget
                θLtOne requestedTimePos).trajectory t -
              (rightPath.commonTimeBudget
                θLtOne requestedTimePos).trajectory t‖ ^ 2 := by
      simpa [generatedWholeTrajectory] using
        commonTime_integral_eq_intervalIntegral
          requestedTime requestedTimePos.le
          (fun t =>
            ‖(leftPath.commonTimeBudget
                  θLtOne requestedTimePos).trajectory t -
                (rightPath.commonTimeBudget
                  θLtOne requestedTimePos).trajectory t‖ ^ 2)

/--
The actual generated-path nonlinear row is locally Lipschitz from the exact
whole space-time `L²` carrier to scalar time `L¹`.  This is the direct
consumer of strong whole-carrier compactness.
-/
theorem generatedCriticalScalePaths_infiniteNonlinearRow_le_spaceTime
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (leftPath rightPath : GeneratedCriticalScalePath ν θ)
    (output : IntegerWavevector) :
    (∫ t in (0 : ℝ)..requestedTime,
        ‖wholeStateVorticityNonlinearCoefficientAt
              ((leftPath.commonTimeBudget
                θLtOne requestedTimePos).trajectory t) output -
            wholeStateVorticityNonlinearCoefficientAt
              ((rightPath.commonTimeBudget
                θLtOne requestedTimePos).trajectory t) output‖) ≤
      6 * Real.sqrt (integerWaveNormSq output) *
        ‖generatedCriticalSpaceTimePath
              θLtOne requestedTimePos leftPath -
            generatedCriticalSpaceTimePath
              θLtOne requestedTimePos rightPath‖ *
        (‖generatedCriticalSpaceTimePath
              θLtOne requestedTimePos leftPath‖ +
          ‖generatedCriticalSpaceTimePath
              θLtOne requestedTimePos rightPath‖) := by
  have integrated :=
    generatedCriticalScalePaths_infiniteNonlinearRow_intervalIntegral_le
      θLtOne requestedTimePos leftPath rightPath output
  rw [
    ← generatedCriticalSpaceTimePath_sub_norm_sq_eq_intervalIntegral
      θLtOne requestedTimePos leftPath rightPath,
    ← generatedCriticalSpaceTimePath_norm_sq_eq_intervalIntegral
      θLtOne requestedTimePos leftPath,
    ← generatedCriticalSpaceTimePath_norm_sq_eq_intervalIntegral
      θLtOne requestedTimePos rightPath,
    Real.sqrt_sq (norm_nonneg
      (generatedCriticalSpaceTimePath
          θLtOne requestedTimePos leftPath -
        generatedCriticalSpaceTimePath
          θLtOne requestedTimePos rightPath)),
    Real.sqrt_sq (norm_nonneg
      (generatedCriticalSpaceTimePath
        θLtOne requestedTimePos leftPath)),
    Real.sqrt_sq (norm_nonneg
      (generatedCriticalSpaceTimePath
        θLtOne requestedTimePos rightPath))] at integrated
  exact integrated

/-! ## The actual nonlinear `L¹_t` carrier -/

abbrev NonlinearRowSpaceTimeState (requestedTime : ℝ) :=
  ↥(MeasureTheory.Lp ComplexCoordinateVector 1
    (commonTimeMeasure requestedTime))

def generatedWholeTransverseTrajectory
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (path : GeneratedCriticalScalePath ν θ) :
    Icc (0 : ℝ) requestedTime → WholeTransverseVorticityState :=
  fun time =>
    ⟨generatedWholeTrajectory
        θLtOne requestedTimePos path time,
      fun wave =>
        ((path.commonTimeBudget
          θLtOne requestedTimePos).physicalProperties
            time.1 time.2).2.2.1 wave⟩

theorem generatedWholeTransverseTrajectory_continuous
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (path : GeneratedCriticalScalePath ν θ) :
    Continuous
      (generatedWholeTransverseTrajectory
        θLtOne requestedTimePos path) := by
  exact
    (generatedWholeTrajectory_continuous
      θLtOne requestedTimePos path).subtype_mk
      (fun time wave =>
        ((path.commonTimeBudget
          θLtOne requestedTimePos).physicalProperties
            time.1 time.2).2.2.1 wave)

def generatedWholeNonlinearRowBoundedPath
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (path : GeneratedCriticalScalePath ν θ)
    (output : IntegerWavevector) :
    BoundedContinuousFunction
      (Icc (0 : ℝ) requestedTime)
      ComplexCoordinateVector :=
  BoundedContinuousFunction.mkOfCompact
    ⟨fun time =>
        wholeStateVorticityNonlinearCoefficientAt
          (generatedWholeTransverseTrajectory
            θLtOne requestedTimePos path time).1 output,
      (wholeStateVorticityNonlinearCoefficientAt_continuous output).comp
        (generatedWholeTransverseTrajectory_continuous
          θLtOne requestedTimePos path)⟩

def generatedWholeNonlinearRowSpaceTimePath
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (path : GeneratedCriticalScalePath ν θ)
    (output : IntegerWavevector) :
    NonlinearRowSpaceTimeState requestedTime :=
  BoundedContinuousFunction.toLp 1
    (commonTimeMeasure requestedTime) ℂ
    (generatedWholeNonlinearRowBoundedPath
      θLtOne requestedTimePos path output)

theorem nonlinearRowSpaceTimeState_norm_eq_integral
    (requestedTime : ℝ)
    (state : NonlinearRowSpaceTimeState requestedTime) :
    ‖state‖ =
      ∫ time,
        ‖state time‖ ∂(commonTimeMeasure requestedTime) := by
  rw [MeasureTheory.Lp.norm_def]
  rw [MeasureTheory.toReal_eLpNorm
    (MeasureTheory.Lp.aestronglyMeasurable state)]
  rw [MeasureTheory.lpNorm_eq_integral_norm_rpow_toReal
    (p := (1 : ℝ≥0∞)) (by norm_num) (by simp)
    (MeasureTheory.Lp.aestronglyMeasurable state)]
  norm_num

theorem
    generatedWholeNonlinearRowSpaceTimePath_sub_norm_eq_intervalIntegral
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (leftPath rightPath : GeneratedCriticalScalePath ν θ)
    (output : IntegerWavevector) :
    ‖generatedWholeNonlinearRowSpaceTimePath
          θLtOne requestedTimePos leftPath output -
        generatedWholeNonlinearRowSpaceTimePath
          θLtOne requestedTimePos rightPath output‖ =
      ∫ t in (0 : ℝ)..requestedTime,
        ‖wholeStateVorticityNonlinearCoefficientAt
              ((leftPath.commonTimeBudget
                θLtOne requestedTimePos).trajectory t) output -
            wholeStateVorticityNonlinearCoefficientAt
              ((rightPath.commonTimeBudget
                θLtOne requestedTimePos).trajectory t) output‖ := by
  rw [nonlinearRowSpaceTimeState_norm_eq_integral]
  have leftAE :=
    BoundedContinuousFunction.coeFn_toLp
      (p := (1 : ℝ≥0∞))
      (μ := commonTimeMeasure requestedTime)
      ℂ
      (generatedWholeNonlinearRowBoundedPath
        θLtOne requestedTimePos leftPath output)
  have rightAE :=
    BoundedContinuousFunction.coeFn_toLp
      (p := (1 : ℝ≥0∞))
      (μ := commonTimeMeasure requestedTime)
      ℂ
      (generatedWholeNonlinearRowBoundedPath
        θLtOne requestedTimePos rightPath output)
  have subAE :=
    MeasureTheory.Lp.coeFn_sub
      (generatedWholeNonlinearRowSpaceTimePath
        θLtOne requestedTimePos leftPath output)
      (generatedWholeNonlinearRowSpaceTimePath
        θLtOne requestedTimePos rightPath output)
  calc
    (∫ time,
        ‖(generatedWholeNonlinearRowSpaceTimePath
              θLtOne requestedTimePos leftPath output -
            generatedWholeNonlinearRowSpaceTimePath
              θLtOne requestedTimePos rightPath output) time‖
        ∂(commonTimeMeasure requestedTime)) =
        ∫ time,
          ‖wholeStateVorticityNonlinearCoefficientAt
                (generatedWholeTrajectory
                  θLtOne requestedTimePos leftPath time) output -
              wholeStateVorticityNonlinearCoefficientAt
                (generatedWholeTrajectory
                  θLtOne requestedTimePos rightPath time) output‖
          ∂(commonTimeMeasure requestedTime) := by
      apply integral_congr_ae
      filter_upwards [subAE, leftAE, rightAE] with
        time subEq leftEq rightEq
      rw [subEq]
      change
        ‖((BoundedContinuousFunction.toLp 1
              (commonTimeMeasure requestedTime) ℂ)
              (generatedWholeNonlinearRowBoundedPath
                θLtOne requestedTimePos leftPath output)) time -
            ((BoundedContinuousFunction.toLp 1
              (commonTimeMeasure requestedTime) ℂ)
              (generatedWholeNonlinearRowBoundedPath
                θLtOne requestedTimePos rightPath output)) time‖ =
          _
      rw [leftEq, rightEq]
      rfl
    _ =
        ∫ t in (0 : ℝ)..requestedTime,
          ‖wholeStateVorticityNonlinearCoefficientAt
                ((leftPath.commonTimeBudget
                  θLtOne requestedTimePos).trajectory t) output -
              wholeStateVorticityNonlinearCoefficientAt
                ((rightPath.commonTimeBudget
                  θLtOne requestedTimePos).trajectory t) output‖ := by
      simpa [generatedWholeTrajectory] using
        commonTime_integral_eq_intervalIntegral
          requestedTime requestedTimePos.le
          (fun t =>
            ‖wholeStateVorticityNonlinearCoefficientAt
                  ((leftPath.commonTimeBudget
                    θLtOne requestedTimePos).trajectory t) output -
                wholeStateVorticityNonlinearCoefficientAt
                  ((rightPath.commonTimeBudget
                    θLtOne requestedTimePos).trajectory t) output‖)

theorem generatedWholeNonlinearRowSpaceTimePath_sub_norm_le
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (leftPath rightPath : GeneratedCriticalScalePath ν θ)
    (output : IntegerWavevector) :
    ‖generatedWholeNonlinearRowSpaceTimePath
          θLtOne requestedTimePos leftPath output -
        generatedWholeNonlinearRowSpaceTimePath
          θLtOne requestedTimePos rightPath output‖ ≤
      6 * Real.sqrt (integerWaveNormSq output) *
        ‖generatedCriticalSpaceTimePath
              θLtOne requestedTimePos leftPath -
            generatedCriticalSpaceTimePath
              θLtOne requestedTimePos rightPath‖ *
        (‖generatedCriticalSpaceTimePath
              θLtOne requestedTimePos leftPath‖ +
          ‖generatedCriticalSpaceTimePath
              θLtOne requestedTimePos rightPath‖) := by
  rw [
    generatedWholeNonlinearRowSpaceTimePath_sub_norm_eq_intervalIntegral]
  exact
    generatedCriticalScalePaths_infiniteNonlinearRow_le_spaceTime
      θLtOne requestedTimePos leftPath rightPath output

/-!
Strong whole-space compactness now survives the complete infinite
nonlinearity: the common subsequence of any generated path sequence is
Cauchy in time `L¹` at every fixed nonlinear Fourier row.
-/
theorem
    generatedCriticalSpaceTimePath_subsequence_nonlinearRow_cauchySeq
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    (θLtOne : θ < 1)
    (requestedTimePos : 0 < requestedTime)
    (paths : ℕ → GeneratedCriticalScalePath ν θ)
    (output : IntegerWavevector) :
    ∃ limit : SpaceTimeState requestedTime,
      limit ∈
          closure
            (generatedCriticalSpaceTimePathFamily
              (ν := ν) θLtOne requestedTimePos) ∧
      ∃ subsequence : ℕ → ℕ,
        StrictMono subsequence ∧
        Tendsto
            (fun index =>
              generatedCriticalSpaceTimePath
                θLtOne requestedTimePos
                (paths (subsequence index)))
            atTop
            (𝓝 limit) ∧
        CauchySeq
          (fun index =>
            generatedWholeNonlinearRowSpaceTimePath
              θLtOne requestedTimePos
              (paths (subsequence index)) output) := by
  obtain
      ⟨limit, limitMem, subsequence, subsequenceMono,
        wholeTendsto, wholeStrong, fixedWaveTendsto,
        fixedWaveStrong⟩ :=
    generatedCriticalSpaceTimePath_strong_subsequence_with_fixed_wave_rows
      θLtOne requestedTimePos paths
  let stateSequence : ℕ → SpaceTimeState requestedTime :=
    fun index =>
      generatedCriticalSpaceTimePath
        θLtOne requestedTimePos (paths (subsequence index))
  let nonlinearSequence :
      ℕ → NonlinearRowSpaceTimeState requestedTime :=
    fun index =>
      generatedWholeNonlinearRowSpaceTimePath
        θLtOne requestedTimePos (paths (subsequence index)) output
  have stateTendsto :
      Tendsto stateSequence atTop (𝓝 limit) := by
    simpa [stateSequence] using wholeTendsto
  have stateCauchy : CauchySeq stateSequence :=
    stateTendsto.cauchy_map
  have stateDistanceTendsto :
      Tendsto
        (fun indices : ℕ × ℕ =>
          dist (stateSequence indices.1)
            (stateSequence indices.2))
        atTop (𝓝 0) :=
    cauchySeq_iff_tendsto_dist_atTop_0.mp stateCauchy
  have fstAtTop :
      Tendsto (fun indices : ℕ × ℕ => indices.1)
        atTop atTop := by
    rw [← prod_atTop_atTop_eq]
    exact tendsto_fst
  have sndAtTop :
      Tendsto (fun indices : ℕ × ℕ => indices.2)
        atTop atTop := by
    rw [← prod_atTop_atTop_eq]
    exact tendsto_snd
  have stateNormSumTendsto :
      Tendsto
        (fun indices : ℕ × ℕ =>
          ‖stateSequence indices.1‖ +
            ‖stateSequence indices.2‖)
        atTop
        (𝓝 (‖limit‖ + ‖limit‖)) :=
    (stateTendsto.norm.comp fstAtTop).add
      (stateTendsto.norm.comp sndAtTop)
  let angular : ℝ :=
    6 * Real.sqrt (integerWaveNormSq output)
  have boundTendsto :
      Tendsto
        (fun indices : ℕ × ℕ =>
          angular *
            dist (stateSequence indices.1)
              (stateSequence indices.2) *
            (‖stateSequence indices.1‖ +
              ‖stateSequence indices.2‖))
        atTop (𝓝 0) := by
    simpa using
      ((tendsto_const_nhds.mul stateDistanceTendsto).mul
        stateNormSumTendsto)
  have nonlinearCauchy : CauchySeq nonlinearSequence := by
    apply cauchySeq_iff_tendsto_dist_atTop_0.mpr
    apply squeeze_zero
      (g := fun indices : ℕ × ℕ =>
        angular *
          dist (stateSequence indices.1)
            (stateSequence indices.2) *
          (‖stateSequence indices.1‖ +
            ‖stateSequence indices.2‖))
    · intro indices
      exact dist_nonneg
    · intro indices
      rw [dist_eq_norm]
      have bound :=
        generatedWholeNonlinearRowSpaceTimePath_sub_norm_le
          θLtOne requestedTimePos
          (paths (subsequence indices.1))
          (paths (subsequence indices.2)) output
      simpa [nonlinearSequence, stateSequence, angular,
        dist_eq_norm] using bound
    · exact boundTendsto
  exact
    ⟨limit, limitMem, subsequence, subsequenceMono,
      wholeTendsto, by simpa [nonlinearSequence] using nonlinearCauchy⟩

end

