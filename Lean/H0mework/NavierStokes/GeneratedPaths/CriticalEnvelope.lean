open ThreeDimensionalVorticityCoefficientGeneratedIntegerShellSource
open ThreeDimensionalVorticityCoefficientGeneratedIntegerShellPath
open ThreeDimensionalVorticityCoefficientGeneratedIntegerShellTraceCumulative
open ThreeDimensionalVorticityCoefficientFiniteSupportComplexTrajectory
open ThreeDimensionalVorticityCoefficientGeneratedIntegerShellPathTrajectory
open ThreeDimensionalVorticityCoefficientGeneratedShellSerrinGeometry
open ThreeDimensionalIntegerLatticeCriticalKernel

noncomputable section

/-! ## PDE-critical shell weights -/

/-- Reciprocal-fourth-power lattice weight contributed by one actual shell.
The shell label is `|k|^2`, hence its square is `|k|^4`. -/
def generatedIntegerShellReceiptCriticalKernelWeight
    (receipt : GeneratedIntegerShellReceipt) : ℝ :=
  (receipt.wholeShellModes.card : ℝ) /
    (receipt.selectedShellSq : ℝ) ^ 2

/-- Complete critical lattice weight generated by an actual finite path. -/
def generatedIntegerShellReachableCriticalKernelWeight
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current) : ℝ :=
  ((generatedIntegerShellReachableReceipts arrival).map
    generatedIntegerShellReceiptCriticalKernelWeight).sum

/-- One shell's exact Fourier `|nabla omega|^2` mass, before the physical
`(2*pi)^2` normalization. -/
def generatedIntegerShellReceiptEnstrophyMass
    (receipt : GeneratedIntegerShellReceipt)
    (state : IntegerWavevector → ComplexCoordinateVector) : ℝ :=
  (receipt.selectedShellSq : ℝ) *
    generatedIntegerShellReceiptWholeShellVorticityMass receipt state

/-- Exact shell-weighted vorticity mass along an actual generated path. -/
def pathWholeShellEnstrophyMass
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (state : IntegerWavevector → ComplexCoordinateVector) : ℝ :=
  ((generatedIntegerShellReachableReceipts arrival).map
    fun receipt =>
      generatedIntegerShellReceiptEnstrophyMass receipt state).sum

theorem generatedIntegerShellReceiptCriticalKernelWeight_nonneg
    (receipt : GeneratedIntegerShellReceipt) :
    0 ≤ generatedIntegerShellReceiptCriticalKernelWeight receipt := by
  exact div_nonneg (Nat.cast_nonneg _)
    (sq_nonneg (receipt.selectedShellSq : ℝ))

theorem generatedIntegerShellReachableCriticalKernelWeight_nonneg
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current) :
    0 ≤ generatedIntegerShellReachableCriticalKernelWeight arrival := by
  exact List.sum_nonneg fun weight weightMem => by
    rcases List.mem_map.mp weightMem with ⟨receipt, _, rfl⟩
    exact generatedIntegerShellReceiptCriticalKernelWeight_nonneg receipt

theorem generatedIntegerShellReceiptEnstrophyMass_nonneg
    (receipt : GeneratedIntegerShellReceipt)
    (state : IntegerWavevector → ComplexCoordinateVector) :
    0 ≤ generatedIntegerShellReceiptEnstrophyMass receipt state := by
  exact mul_nonneg
    (generatedIntegerShellReceipt_selectedShellSq_cast_pos receipt).le
    (generatedIntegerShellReceiptWholeShellVorticityMass_nonneg
      receipt state)

theorem pathWholeShellEnstrophyMass_nonneg
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (state : IntegerWavevector → ComplexCoordinateVector) :
    0 ≤ pathWholeShellEnstrophyMass arrival state := by
  exact List.sum_nonneg fun mass massMem => by
    rcases List.mem_map.mp massMem with ⟨receipt, _, rfl⟩
    exact generatedIntegerShellReceiptEnstrophyMass_nonneg receipt state

/-! ## Exact critical reweighting -/

/-- The energy-level and enstrophy-level factorizations of one shell are
literally equal.  Positivity of the denominator is generated by the actual
receipt. -/
theorem generatedIntegerShellReceipt_energyWeight_eq_criticalWeight
    (receipt : GeneratedIntegerShellReceipt)
    (state : IntegerWavevector → ComplexCoordinateVector) :
    generatedIntegerShellReceiptReciprocalCardWeight receipt *
        generatedIntegerShellReceiptWholeShellVorticityMass receipt state =
      generatedIntegerShellReceiptCriticalKernelWeight receipt *
        generatedIntegerShellReceiptEnstrophyMass receipt state := by
  have shellNe : (receipt.selectedShellSq : ℝ) ≠ 0 :=
    (generatedIntegerShellReceipt_selectedShellSq_cast_pos receipt).ne'
  unfold generatedIntegerShellReceiptReciprocalCardWeight
    generatedIntegerShellReceiptCriticalKernelWeight
    generatedIntegerShellReceiptEnstrophyMass
  field_simp

/-- One actual whole shell satisfies the endpoint-Serrin estimate with the
PDE-critical `|k|^-4` geometric weight and its exact enstrophy mass. -/
theorem generatedIntegerShellReceiptStateVelocityMajorant_sq_le_critical
    (receipt : GeneratedIntegerShellReceipt)
    (state : IntegerWavevector → ComplexCoordinateVector) :
    generatedIntegerShellReceiptStateVelocityMajorant receipt state ^ 2 ≤
      biotSavartSerrinConstant *
        generatedIntegerShellReceiptCriticalKernelWeight receipt *
        generatedIntegerShellReceiptEnstrophyMass receipt state := by
  calc
    generatedIntegerShellReceiptStateVelocityMajorant receipt state ^ 2 ≤
        biotSavartSerrinConstant *
          generatedIntegerShellReceiptReciprocalCardWeight receipt *
          generatedIntegerShellReceiptWholeShellVorticityMass receipt state :=
      generatedIntegerShellReceiptStateVelocityMajorant_sq_le
        receipt state
    _ =
        biotSavartSerrinConstant *
          generatedIntegerShellReceiptCriticalKernelWeight receipt *
          generatedIntegerShellReceiptEnstrophyMass receipt state := by
      rw [mul_assoc,
        generatedIntegerShellReceipt_energyWeight_eq_criticalWeight,
        ← mul_assoc]

private theorem list_map_sum_sq_le_sum_mul_sum_of_sq_le_mul
    {alpha : Type}
    (entries : List alpha)
    (r f g : alpha → ℝ)
    (f_nonneg : ∀ entry ∈ entries, 0 ≤ f entry)
    (g_nonneg : ∀ entry ∈ entries, 0 ≤ g entry)
    (pointwise :
      ∀ entry ∈ entries,
        r entry ^ 2 ≤ f entry * g entry) :
    (entries.map r).sum ^ 2 ≤
      (entries.map f).sum * (entries.map g).sum := by
  have finiteBound :=
    Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul
      (Finset.univ : Finset (Fin entries.length))
      (r := fun index => r (entries.get index))
      (f := fun index => f (entries.get index))
      (g := fun index => g (entries.get index))
      (fun index _ => f_nonneg _ (entries.get_mem index))
      (fun index _ => g_nonneg _ (entries.get_mem index))
      (fun index _ => pointwise _ (entries.get_mem index))
  have mapEq (function : alpha → ℝ) :
      List.ofFn (fun index => function (entries.get index)) =
        entries.map function := by
    change List.ofFn (function ∘ entries.get) = entries.map function
    rw [← List.map_ofFn, List.ofFn_get]
  simpa only [← List.sum_ofFn, mapEq] using finiteBound

private theorem list_map_sum_const_mul
    {alpha : Type}
    (entries : List alpha)
    (constant : ℝ)
    (value : alpha → ℝ) :
    (entries.map fun entry => constant * value entry).sum =
      constant * (entries.map value).sum := by
  induction entries with
  | nil => simp
  | cons head tail inductionHypothesis =>
      simp [inductionHypothesis, mul_add]

/-- Arbitrary-path Fourier majorant with a summable three-dimensional
geometric kernel and exact path enstrophy mass. -/
theorem generatedIntegerShellReachableStateVelocityMajorant_sq_le_critical
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (state : IntegerWavevector → ComplexCoordinateVector) :
    generatedIntegerShellReachableStateVelocityMajorant arrival state ^ 2 ≤
      biotSavartSerrinConstant *
        generatedIntegerShellReachableCriticalKernelWeight arrival *
        pathWholeShellEnstrophyMass arrival state := by
  let receipts := generatedIntegerShellReachableReceipts arrival
  have pathCauchy :=
    list_map_sum_sq_le_sum_mul_sum_of_sq_le_mul
      receipts
      (fun receipt =>
        generatedIntegerShellReceiptStateVelocityMajorant receipt state)
      (fun receipt =>
        biotSavartSerrinConstant *
          generatedIntegerShellReceiptCriticalKernelWeight receipt)
      (fun receipt =>
        generatedIntegerShellReceiptEnstrophyMass receipt state)
      (fun receipt receiptMem =>
        mul_nonneg biotSavartSerrinConstant_nonneg
          (generatedIntegerShellReceiptCriticalKernelWeight_nonneg receipt))
      (fun receipt receiptMem =>
        generatedIntegerShellReceiptEnstrophyMass_nonneg receipt state)
      (fun receipt receiptMem =>
        generatedIntegerShellReceiptStateVelocityMajorant_sq_le_critical
          receipt state)
  rw [list_map_sum_const_mul] at pathCauchy
  exact pathCauchy

/-- Pointwise critical envelope for every actual finite generated path and
every common vorticity state.  All shells and their frequency weights are
owned by `arrival`; the state supplies only the amplitudes at the observed
time slice. -/
theorem generatedIntegerShellReachable_wholeShellStateCriticalEnvelope
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (state : IntegerWavevector → ComplexCoordinateVector)
    (x : PhysicalSpace) :
    ‖generatedIntegerShellReachableStatePhysicalVelocityField
        arrival state x‖ ^ 2 ≤
      biotSavartSerrinConstant *
        generatedIntegerShellReachableCriticalKernelWeight arrival *
        pathWholeShellEnstrophyMass arrival state := by
  calc
    ‖generatedIntegerShellReachableStatePhysicalVelocityField
        arrival state x‖ ^ 2 ≤
        generatedIntegerShellReachableStateVelocityMajorant
          arrival state ^ 2 :=
      (sq_le_sq₀
        (norm_nonneg _)
        (generatedIntegerShellReachableStateVelocityMajorant_nonneg
          arrival state)).mpr
        (generatedIntegerShellReachableStatePhysicalVelocityField_norm_le_majorant
          arrival state x)
    _ ≤ _ :=
      generatedIntegerShellReachableStateVelocityMajorant_sq_le_critical
        arrival state

/-! ## Cutoff-independent three-dimensional lattice control -/

/-- Finite union of every whole shell generated by an actual path. -/
def generatedIntegerShellReachableWholeShellModes
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current) :
    Finset IntegerWavevector :=
  ((generatedIntegerShellReachableReceipts arrival).map
    fun receipt => receipt.wholeShellModes).foldr (.∪.) ∅

/-- One actual shell's critical cardinality weight is literally the sum of
the global reciprocal-fourth-power kernel on that shell. -/
theorem generatedIntegerShellReceiptCriticalKernelWeight_eq_sum
    (receipt : GeneratedIntegerShellReceipt) :
    generatedIntegerShellReceiptCriticalKernelWeight receipt =
      ∑ wave ∈ receipt.wholeShellModes,
        integerWaveCriticalKernel wave := by
  have shellNe : (receipt.selectedShellSq : ℝ) ≠ 0 :=
    (generatedIntegerShellReceipt_selectedShellSq_cast_pos receipt).ne'
  have kernelConstant :
      ∀ wave ∈ receipt.wholeShellModes,
        integerWaveCriticalKernel wave =
          ((receipt.selectedShellSq : ℝ))⁻¹ ^ 2 := by
    intro wave waveMem
    unfold integerWaveCriticalKernel
    rw [integerWaveNormSq_eq_integerWaveShellSq,
      ((mem_generatedOuterNonlinearShellModes_iff
        receipt.current receipt.selectedShellSq wave).mp waveMem).2]
  rw [generatedIntegerShellReceiptCriticalKernelWeight]
  calc
    (receipt.wholeShellModes.card : ℝ) /
          (receipt.selectedShellSq : ℝ) ^ 2 =
        (receipt.wholeShellModes.card : ℝ) *
          ((receipt.selectedShellSq : ℝ))⁻¹ ^ 2 := by
      field_simp
    _ =
        ∑ wave ∈ receipt.wholeShellModes,
          ((receipt.selectedShellSq : ℝ))⁻¹ ^ 2 := by
      rw [Finset.sum_const, nsmul_eq_mul]
    _ = _ := by
      apply Finset.sum_congr rfl
      intro wave waveMem
      exact (kernelConstant wave waveMem).symm

private theorem finset_disjoint_foldr_union_of_list_pairwise
    {alpha : Type}
    [DecidableEq alpha]
    {head : Finset alpha}
    {tail : List (Finset alpha)}
    (headDisjoint : ∀ later ∈ tail, Disjoint head later) :
    Disjoint head (tail.foldr (.∪.) ∅) := by
  rw [Finset.disjoint_left]
  intro index indexHead indexTail
  induction tail with
  | nil => simp at indexTail
  | cons later rest inductionHypothesis =>
      simp only [List.foldr_cons, Finset.mem_union] at indexTail
      rcases indexTail with indexLater | indexRest
      · exact
          (Finset.disjoint_left.mp
            (headDisjoint later (by simp))) indexHead indexLater
      · exact inductionHypothesis
          (fun remaining remainingMem =>
            headDisjoint remaining (by simp [remainingMem]))
          indexRest

private theorem list_sum_finset_sum_eq_foldr_union
    {alpha : Type}
    [DecidableEq alpha]
    (sets : List (Finset alpha))
    (value : alpha → ℝ)
    (pairwise : sets.Pairwise Disjoint) :
    (sets.map fun indices => ∑ index ∈ indices, value index).sum =
      ∑ index ∈ sets.foldr (.∪.) ∅, value index := by
  induction sets with
  | nil => simp
  | cons head tail inductionHypothesis =>
      rw [List.pairwise_cons] at pairwise
      simp only [List.map_cons, List.sum_cons, List.foldr_cons]
      rw [Finset.sum_union
        (finset_disjoint_foldr_union_of_list_pairwise pairwise.1),
        inductionHypothesis pairwise.2]

/-- The complete critical weight of an actual generated path is exactly the
global lattice kernel restricted to its pairwise-disjoint written shells. -/
theorem generatedIntegerShellReachableCriticalKernelWeight_eq_finiteSum
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current) :
    generatedIntegerShellReachableCriticalKernelWeight arrival =
      ∑ wave ∈ generatedIntegerShellReachableWholeShellModes arrival,
        integerWaveCriticalKernel wave := by
  rw [generatedIntegerShellReachableCriticalKernelWeight]
  have mappedWeights :
      (generatedIntegerShellReachableReceipts arrival).map
          generatedIntegerShellReceiptCriticalKernelWeight =
        (generatedIntegerShellReachableReceipts arrival).map
          fun receipt =>
            ∑ wave ∈ receipt.wholeShellModes,
              integerWaveCriticalKernel wave := by
    apply List.map_congr_left
    intro receipt receiptMem
    exact generatedIntegerShellReceiptCriticalKernelWeight_eq_sum receipt
  rw [mappedWeights]
  simpa [generatedIntegerShellReachableWholeShellModes,
    List.map_map, Function.comp_def] using
    list_sum_finset_sum_eq_foldr_union
      ((generatedIntegerShellReachableReceipts arrival).map
        fun receipt => receipt.wholeShellModes)
      integerWaveCriticalKernel
      (generatedIntegerShellReachable_wholeShellModes_pairwise_disjoint
        arrival)

/-- One receipt's shell-weighted vorticity mass is exactly the
frequency-weighted sum over its whole shell. -/
theorem generatedIntegerShellReceiptEnstrophyMass_eq_sum
    (receipt : GeneratedIntegerShellReceipt)
    (state : IntegerWavevector → ComplexCoordinateVector) :
    generatedIntegerShellReceiptEnstrophyMass receipt state =
      ∑ wave ∈ receipt.wholeShellModes,
        integerWaveNormSq wave * complexCoordinateAmplitudeSq (state wave) := by
  unfold generatedIntegerShellReceiptEnstrophyMass
    generatedIntegerShellReceiptWholeShellVorticityMass
  calc
    (receipt.selectedShellSq : ℝ) *
          ∑ wave ∈ receipt.wholeShellModes,
            complexCoordinateAmplitudeSq (state wave) =
        ∑ wave ∈ receipt.wholeShellModes,
          (receipt.selectedShellSq : ℝ) *
            complexCoordinateAmplitudeSq (state wave) := by
      rw [Finset.mul_sum]
    _ = _ := by
      apply Finset.sum_congr rfl
      intro wave waveMem
      rw [integerWaveNormSq_eq_integerWaveShellSq,
        ((mem_generatedOuterNonlinearShellModes_iff
          receipt.current receipt.selectedShellSq wave).mp waveMem).2]

/-- Exact flattened form of the complete path enstrophy mass.  Pairwise
shell disjointness prevents any frequency from being charged twice. -/
theorem pathWholeShellEnstrophyMass_eq_finiteSum
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (state : IntegerWavevector → ComplexCoordinateVector) :
    pathWholeShellEnstrophyMass arrival state =
      ∑ wave ∈ generatedIntegerShellReachableWholeShellModes arrival,
        integerWaveNormSq wave * complexCoordinateAmplitudeSq (state wave) := by
  rw [pathWholeShellEnstrophyMass]
  have mappedMasses :
      (generatedIntegerShellReachableReceipts arrival).map
          (fun receipt =>
            generatedIntegerShellReceiptEnstrophyMass receipt state) =
        (generatedIntegerShellReachableReceipts arrival).map
          (fun receipt =>
            ∑ wave ∈ receipt.wholeShellModes,
              integerWaveNormSq wave *
                complexCoordinateAmplitudeSq (state wave)) := by
    apply List.map_congr_left
    intro receipt receiptMem
    exact generatedIntegerShellReceiptEnstrophyMass_eq_sum receipt state
  rw [mappedMasses]
  simpa [generatedIntegerShellReachableWholeShellModes,
    List.map_map, Function.comp_def] using
    list_sum_finset_sum_eq_foldr_union
      ((generatedIntegerShellReachableReceipts arrival).map
        fun receipt => receipt.wholeShellModes)
      (fun wave =>
        integerWaveNormSq wave * complexCoordinateAmplitudeSq (state wave))
      (generatedIntegerShellReachable_wholeShellModes_pairwise_disjoint
        arrival)

private theorem list_foldr_union_subset_of_each_subset
    {alpha : Type}
    [DecidableEq alpha]
    (sets : List (Finset alpha))
    (ambient : Finset alpha)
    (subsets : ∀ indices ∈ sets, indices ⊆ ambient) :
    sets.foldr (.∪.) ∅ ⊆ ambient := by
  induction sets with
  | nil => simp
  | cons head tail inductionHypothesis =>
      simp only [List.foldr_cons]
      exact Finset.union_subset
        (subsets head (by simp))
        (inductionHypothesis fun indices indicesMem =>
          subsets indices (by simp [indicesMem]))

/-- Every frequency charged by the generated path belongs to the exact
support of its endpoint source. -/
theorem generatedIntegerShellReachableWholeShellModes_subset_endpointSupport
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current) :
    generatedIntegerShellReachableWholeShellModes arrival ⊆
      generatedSupport current := by
  unfold generatedIntegerShellReachableWholeShellModes
  apply list_foldr_union_subset_of_each_subset
  intro modes modesMem
  rcases List.mem_map.mp modesMem with ⟨receipt, receiptMem, rfl⟩
  exact
    generatedIntegerShellReachable_receipt_wholeShell_subset_endpointSupport
      arrival receiptMem

/-- Uniform, cutoff-independent bound for every source-generated finite path.
Increasing path length or highest shell cannot enlarge the geometric factor
beyond the one global three-dimensional lattice constant. -/
theorem generatedIntegerShellReachableCriticalKernelWeight_le_global
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current) :
    generatedIntegerShellReachableCriticalKernelWeight arrival ≤
      ∑' wave : IntegerWavevector, integerWaveCriticalKernel wave := by
  rw [generatedIntegerShellReachableCriticalKernelWeight_eq_finiteSum]
  exact finite_sum_integerWaveCriticalKernel_le_tsum _

/-- The arbitrary-path pointwise velocity envelope with the geometric factor
replaced by a single finite constant of the full integer lattice.  The only
remaining path-dependent quantity is the actual shell-weighted vorticity
mass. -/
theorem generatedIntegerShellReachable_wholeShellStateCriticalEnvelope_global
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (state : IntegerWavevector → ComplexCoordinateVector)
    (x : PhysicalSpace) :
    ‖generatedIntegerShellReachableStatePhysicalVelocityField
        arrival state x‖ ^ 2 ≤
      biotSavartSerrinConstant *
        (∑' wave : IntegerWavevector, integerWaveCriticalKernel wave) *
        pathWholeShellEnstrophyMass arrival state := by
  calc
    ‖generatedIntegerShellReachableStatePhysicalVelocityField
        arrival state x‖ ^ 2 ≤
        biotSavartSerrinConstant *
          generatedIntegerShellReachableCriticalKernelWeight arrival *
          pathWholeShellEnstrophyMass arrival state :=
      generatedIntegerShellReachable_wholeShellStateCriticalEnvelope
        arrival state x
    _ ≤
        biotSavartSerrinConstant *
          (∑' wave : IntegerWavevector, integerWaveCriticalKernel wave) *
          pathWholeShellEnstrophyMass arrival state := by
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left
          (generatedIntegerShellReachableCriticalKernelWeight_le_global
            arrival)
          biotSavartSerrinConstant_nonneg)
        (pathWholeShellEnstrophyMass_nonneg arrival state)

end

