/-! ## Exact source-side negative-one ceiling -/

/-- Exact cutoff-independent `L²_t H⁻¹` ceiling determined by the source
endpoint, viscosity, and strict critical parameter. -/
def generatedPathNegativeOneTimeCeiling
    (current : RawVorticityFourierSource)
    (ν : Viscosity)
    (θ : ℝ) : ℝ :=
  (4 * criticalEnstrophyLatticeConstant *
          finiteStateVorticityCoefficientEnstrophy
              (generatedSupport current)
              (generatedComplexVorticityState current
                (generatedSupport current)) ^ 2 +
      ν.coeff ^ 2 * (2 * Real.pi) ^ 2 *
        finiteStateVorticityCoefficientEnstrophy
          (generatedSupport current)
          (generatedComplexVorticityState current
            (generatedSupport current))) /
    criticalEnstrophyAbsorptionCoefficient θ ν

private theorem generatedInitialCoefficientEnstrophy_nonneg
    (current : RawVorticityFourierSource) :
    0 ≤
      finiteStateVorticityCoefficientEnstrophy
        (generatedSupport current)
        (generatedComplexVorticityState current
          (generatedSupport current)) := by
  unfold finiteStateVorticityCoefficientEnstrophy
  exact Finset.sum_nonneg fun _ _ =>
    complexCoordinateAmplitudeSq_nonneg _

theorem generatedPathNegativeOneTimeCeiling_nonneg
    (current : RawVorticityFourierSource)
    (ν : Viscosity)
    (θ : ℝ)
    (θLtOne : θ < 1) :
    0 ≤ generatedPathNegativeOneTimeCeiling current ν θ := by
  unfold generatedPathNegativeOneTimeCeiling
  apply div_nonneg
  · exact add_nonneg
      (mul_nonneg
        (mul_nonneg
          (by norm_num)
          criticalEnstrophyLatticeConstant_nonneg)
        (sq_nonneg _))
      (mul_nonneg
        (mul_nonneg (sq_nonneg _) (sq_nonneg _))
        (generatedInitialCoefficientEnstrophy_nonneg current))
  · exact
      (criticalEnstrophyAbsorptionCoefficient_pos
        θ θLtOne ν).le

/-! ## The generated frequency-cancelling time -/

/-- Positive lifetime generated by one exact receipt mass and the actual
cutoff-independent negative-one ceiling. -/
def generatedReceiptPersistenceTime
    (current : RawVorticityFourierSource)
    (receipt : GeneratedIntegerShellReceipt)
    (ν : Viscosity)
    (θ : ℝ) : ℝ :=
  coefficientCarrierNormSq
        (generatedIntegerShellReceiptTrace receipt) /
    (12 * (2 * Real.pi) ^ 2 *
      (receipt.selectedShellSq : ℝ) *
      max 1 (generatedPathNegativeOneTimeCeiling current ν θ))

theorem generatedReceiptPersistenceTime_pos
    (current : RawVorticityFourierSource)
    (receipt : GeneratedIntegerShellReceipt)
    (ν : Viscosity)
    (θ : ℝ) :
    0 < generatedReceiptPersistenceTime current receipt ν θ := by
  have tracePos :
      0 <
        coefficientCarrierNormSq
          (generatedIntegerShellReceiptTrace receipt) :=
    generatedIntegerShellReceiptTrace_normSq_pos receipt
  have frequencyPos :
      0 < (2 * Real.pi) ^ 2 :=
    sq_pos_of_pos (mul_pos (by norm_num) Real.pi_pos)
  have shellPos :
      0 < (receipt.selectedShellSq : ℝ) :=
    generatedIntegerShellReceipt_selectedShellSq_cast_pos receipt
  have ceilingPos :
      0 <
        max 1
          (generatedPathNegativeOneTimeCeiling current ν θ) :=
    lt_of_lt_of_le zero_lt_one (le_max_left _ _)
  unfold generatedReceiptPersistenceTime
  exact
    div_pos tracePos
      (mul_pos
        (mul_pos
          (mul_pos (by norm_num) frequencyPos)
          shellPos)
        ceilingPos)

/-- The generated lifetime cancels exactly one selected-shell frequency and
one protected negative-one ceiling. -/
theorem generatedReceiptPersistenceTime_frequency_cancel
    (current : RawVorticityFourierSource)
    (receipt : GeneratedIntegerShellReceipt)
    (ν : Viscosity)
    (θ : ℝ) :
    3 * (2 * Real.pi) ^ 2 *
          (receipt.selectedShellSq : ℝ) *
          (generatedReceiptPersistenceTime current receipt ν θ *
            max 1
              (generatedPathNegativeOneTimeCeiling current ν θ)) =
        coefficientCarrierNormSq
            (generatedIntegerShellReceiptTrace receipt) /
          4 := by
  have frequencyNe :
      (2 * Real.pi) ^ 2 ≠ 0 :=
    ne_of_gt (sq_pos_of_pos (mul_pos (by norm_num) Real.pi_pos))
  have shellNe :
      (receipt.selectedShellSq : ℝ) ≠ 0 :=
    ne_of_gt
      (generatedIntegerShellReceipt_selectedShellSq_cast_pos receipt)
  have ceilingNe :
      max 1
          (generatedPathNegativeOneTimeCeiling current ν θ) ≠ 0 :=
    ne_of_gt
      (lt_of_lt_of_le zero_lt_one (le_max_left _ _))
  unfold generatedReceiptPersistenceTime
  field_simp [frequencyNe, shellNe, ceilingNe]
  ring

/-- After multiplication by the receipt frequency and the retained quarter
mass, the generated lifetime contributes a frequency-free square of the
source trace mass. -/
theorem generatedReceiptPersistenceTime_weighted_trace_eq
    (current : RawVorticityFourierSource)
    (receipt : GeneratedIntegerShellReceipt)
    (ν : Viscosity)
    (θ : ℝ) :
    generatedReceiptPersistenceTime current receipt ν θ *
          ((receipt.selectedShellSq : ℝ) *
            coefficientCarrierNormSq
              (generatedIntegerShellReceiptTrace receipt) /
            4) =
        coefficientCarrierNormSq
              (generatedIntegerShellReceiptTrace receipt) ^ 2 /
          (48 * (2 * Real.pi) ^ 2 *
            max 1
              (generatedPathNegativeOneTimeCeiling current ν θ)) := by
  have frequencyNe :
      (2 * Real.pi) ^ 2 ≠ 0 :=
    ne_of_gt (sq_pos_of_pos (mul_pos (by norm_num) Real.pi_pos))
  have shellNe :
      (receipt.selectedShellSq : ℝ) ≠ 0 :=
    ne_of_gt
      (generatedIntegerShellReceipt_selectedShellSq_cast_pos receipt)
  have ceilingNe :
      max 1
          (generatedPathNegativeOneTimeCeiling current ν θ) ≠ 0 :=
    ne_of_gt
      (lt_of_lt_of_le zero_lt_one (le_max_left _ _))
  unfold generatedReceiptPersistenceTime
  field_simp [frequencyNe, shellNe, ceilingNe]
  ring

/-! ## Actual-update quarter persistence -/

private theorem receiptSupportDifferenceEnergy_comm
    (receipt : GeneratedIntegerShellReceipt)
    (left right : ComplexVorticityHilbertState) :
    receiptSupportDifferenceEnergy receipt left right =
      receiptSupportDifferenceEnergy receipt right left := by
  unfold receiptSupportDifferenceEnergy
  apply Finset.sum_congr rfl
  intro index indexMem
  rw [
    Complex.normSq_eq_norm_sq,
    Complex.normSq_eq_norm_sq,
    norm_sub_rev]

/-- If the actual Galerkin time cost stays below one quarter of a generated
receipt mass, that same actual update retains at least one quarter of the
whole receipt.  The support inclusion and initial reference are kept tied to
the exact generated path. -/
theorem
    generatedIntegerShellReachable_receiptEnergy_ge_quarter_of_actualCost
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    {receipt : GeneratedIntegerShellReceipt}
    (receiptMem :
      receipt ∈ generatedIntegerShellReachableReceipts arrival)
    (ν : ℝ)
    (trajectory : ℝ → ComplexVorticityHilbertState)
    (a b : ℝ)
    (hab : a ≤ b)
    (initial :
      trajectory a =
        generatedComplexVorticityState current
          (generatedSupport current))
    (evolves :
      ∀ t ∈ Icc a b,
        HasDerivAt trajectory
          (finiteStateVorticityGenerator
            (generatedSupport current) ν (trajectory t)) t)
    (costSmall :
      3 * (b - a) * (2 * Real.pi) ^ 2 *
            (receipt.selectedShellSq : ℝ) *
          (∫ t in a..b,
            finiteStateVorticityNegativeOneMass
              (generatedSupport current)
              (finiteStateVorticityGenerator
                (generatedSupport current) ν (trajectory t))) ≤
        coefficientCarrierNormSq
              (generatedIntegerShellReceiptTrace receipt) /
            4) :
    coefficientCarrierNormSq
          (generatedIntegerShellReceiptTrace receipt) /
        4 ≤
      receiptSupportEnergy receipt (trajectory b) := by
  have dynamicDifference :
      receiptSupportDifferenceEnergy receipt
          (trajectory b) (trajectory a) ≤
        coefficientCarrierNormSq
              (generatedIntegerShellReceiptTrace receipt) /
            4 := by
    exact
      (receiptSupportDifferenceEnergy_le_three_length_shell_integral_negativeOneMass
        (generatedSupport current) receipt
        (generatedIntegerShellReachable_receipt_wholeShell_subset_endpointSupport
          arrival receiptMem)
        ν trajectory a b hab evolves).trans costSmall
  apply
    generatedIntegerShellReachable_receiptEnergy_ge_quarter_of_difference
      arrival receiptMem
  rw [← initial, receiptSupportDifferenceEnergy_comm]
  exact dynamicDifference

/-! ## Common-trajectory persistence -/

private theorem
    generatedReceipt_persists_on_commonTimeBudget
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    {receipt : GeneratedIntegerShellReceipt}
    (receiptMem :
      receipt ∈ generatedIntegerShellReachableReceipts arrival)
    (ν : Viscosity)
    (θ : ℝ)
    (horizon : ℝ)
    (horizonPos : 0 < horizon)
    (budget :
      GeneratedPathCommonTimeCompactnessBudget
        arrival ν θ horizon)
    (persistenceTimeLe :
      generatedReceiptPersistenceTime
          current receipt ν θ ≤
        horizon) :
    ∀ t ∈
        Icc (0 : ℝ)
          (generatedReceiptPersistenceTime
            current receipt ν θ),
      coefficientCarrierNormSq
            (generatedIntegerShellReceiptTrace receipt) /
          4 ≤
        receiptSupportEnergy receipt (budget.trajectory t) := by
  let persistenceTime :=
    generatedReceiptPersistenceTime current receipt ν θ
  have persistenceTimePos :
      0 < persistenceTime := by
    exact
      generatedReceiptPersistenceTime_pos
        current receipt ν θ
  intro t tMem
  have evolvesFull :
      ∀ u ∈ Icc (0 : ℝ) horizon,
        HasDerivAt budget.trajectory
          (finiteStateVorticityGenerator
            (generatedSupport current) ν.coeff
            (budget.trajectory u)) u := by
    intro u uMem
    exact (budget.physicalProperties u uMem).1
  have evolvesSub :
      ∀ u ∈ Icc (0 : ℝ) t,
        HasDerivAt budget.trajectory
          (finiteStateVorticityGenerator
            (generatedSupport current) ν.coeff
            (budget.trajectory u)) u := by
    intro u uMem
    exact
      evolvesFull u
        ⟨uMem.1,
          (uMem.2.trans tMem.2).trans persistenceTimeLe⟩
  let mass : ℝ → ℝ :=
    fun u =>
      finiteStateVorticityNegativeOneMass
        (generatedSupport current)
        (finiteStateVorticityGenerator
          (generatedSupport current) ν.coeff
          (budget.trajectory u))
  have massContinuous :
      ContinuousOn mass (Icc (0 : ℝ) horizon) := by
    exact
      finiteGalerkinGeneratorNegativeOneMass_continuousOn
        (generatedSupport current) ν.coeff
        budget.trajectory 0 horizon evolvesFull
  have fullMassIntegrable :
      IntervalIntegrable mass volume 0 horizon :=
    ContinuousOn.intervalIntegrable_of_Icc
      horizonPos.le massContinuous
  have subMassLeFull :
      (∫ u in (0 : ℝ)..t, mass u) ≤
        ∫ u in (0 : ℝ)..horizon, mass u := by
    exact
      intervalIntegral.integral_mono_interval
        (μ := volume)
        (c := (0 : ℝ))
        (d := horizon)
        le_rfl tMem.1
        (tMem.2.trans persistenceTimeLe)
        (Filter.Eventually.of_forall fun u =>
          finiteStateVorticityNegativeOneMass_nonneg
            (generatedSupport current)
            (finiteStateVorticityGenerator
              (generatedSupport current) ν.coeff
              (budget.trajectory u)))
        fullMassIntegrable
  have fullMassLeCeiling :
      (∫ u in (0 : ℝ)..horizon, mass u) ≤
        generatedPathNegativeOneTimeCeiling current ν θ := by
    have budgetBound := budget.negativeOneTimeBudget
    rw [budget.initial] at budgetBound
    simpa [mass, generatedPathNegativeOneTimeCeiling] using
      budgetBound
  have subMassLeProtected :
      (∫ u in (0 : ℝ)..t, mass u) ≤
        max 1
          (generatedPathNegativeOneTimeCeiling current ν θ) :=
    subMassLeFull.trans
      (fullMassLeCeiling.trans (le_max_right _ _))
  have subMassNonneg :
      0 ≤ ∫ u in (0 : ℝ)..t, mass u :=
    intervalIntegral.integral_nonneg tMem.1
      (fun u uMem =>
        finiteStateVorticityNegativeOneMass_nonneg
          (generatedSupport current)
          (finiteStateVorticityGenerator
            (generatedSupport current) ν.coeff
            (budget.trajectory u)))
  have timeMassLe :
      t * (∫ u in (0 : ℝ)..t, mass u) ≤
        persistenceTime *
          max 1
            (generatedPathNegativeOneTimeCeiling current ν θ) :=
    mul_le_mul tMem.2 subMassLeProtected
      subMassNonneg persistenceTimePos.le
  have scaleNonneg :
      0 ≤
        3 * (2 * Real.pi) ^ 2 *
          (receipt.selectedShellSq : ℝ) :=
    mul_nonneg
      (mul_nonneg (by norm_num) (sq_nonneg _))
      (generatedIntegerShellReceipt_selectedShellSq_cast_pos receipt).le
  have costSmall :
      3 * (t - 0) * (2 * Real.pi) ^ 2 *
            (receipt.selectedShellSq : ℝ) *
          (∫ u in (0 : ℝ)..t,
            finiteStateVorticityNegativeOneMass
              (generatedSupport current)
              (finiteStateVorticityGenerator
                (generatedSupport current) ν.coeff
                (budget.trajectory u))) ≤
        coefficientCarrierNormSq
              (generatedIntegerShellReceiptTrace receipt) /
            4 := by
    calc
      3 * (t - 0) * (2 * Real.pi) ^ 2 *
            (receipt.selectedShellSq : ℝ) *
          (∫ u in (0 : ℝ)..t,
            finiteStateVorticityNegativeOneMass
              (generatedSupport current)
              (finiteStateVorticityGenerator
                (generatedSupport current) ν.coeff
                (budget.trajectory u))) =
        (3 * (2 * Real.pi) ^ 2 *
            (receipt.selectedShellSq : ℝ)) *
          (t * ∫ u in (0 : ℝ)..t, mass u) := by
        simp only [sub_zero, mass]
        ring
      _ ≤
        (3 * (2 * Real.pi) ^ 2 *
            (receipt.selectedShellSq : ℝ)) *
          (persistenceTime *
            max 1
              (generatedPathNegativeOneTimeCeiling current ν θ)) :=
        mul_le_mul_of_nonneg_left timeMassLe scaleNonneg
      _ =
        coefficientCarrierNormSq
              (generatedIntegerShellReceiptTrace receipt) /
            4 := by
        simpa [persistenceTime] using
          generatedReceiptPersistenceTime_frequency_cancel
            current receipt ν θ
  exact
    generatedIntegerShellReachable_receiptEnergy_ge_quarter_of_actualCost
      arrival receiptMem ν.coeff budget.trajectory
      0 t tMem.1 budget.initial evolvesSub costSmall

/-! ## Source-generated full persistence windows -/

/-- Every receipt of an arbitrary source-generated finite scale path
generates its own positive, frequency-cancelling lifetime and one actual
physical Galerkin trajectory on which at least one quarter of the entire
receipt mass remains visible throughout that lifetime.

The trajectory and analytic budget are generated in the conclusion. -/
theorem generatedIntegerShellReachable_receipt_persists_on_positive_window
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    {receipt : GeneratedIntegerShellReceipt}
    (receiptMem :
      receipt ∈ generatedIntegerShellReachableReceipts arrival)
    (ν : Viscosity)
    (θ : ℝ)
    (θLtOne : θ < 1)
    (initialMargin :
      criticalEnstrophyLatticeConstant *
          finiteStateVorticityCoefficientEnstrophy
            (generatedSupport current)
            (generatedComplexVorticityState current
              (generatedSupport current)) ≤
        θ * ν.coeff ^ 2 * (2 * Real.pi) ^ 2) :
    ∃ budget :
        GeneratedPathCommonTimeCompactnessBudget
          arrival ν θ
            (generatedReceiptPersistenceTime
              current receipt ν θ),
      ∀ t ∈
          Icc (0 : ℝ)
            (generatedReceiptPersistenceTime
              current receipt ν θ),
        coefficientCarrierNormSq
              (generatedIntegerShellReceiptTrace receipt) /
            4 ≤
          receiptSupportEnergy receipt (budget.trajectory t) := by
  have persistenceTimePos :=
    generatedReceiptPersistenceTime_pos
      current receipt ν θ
  let budget :
      GeneratedPathCommonTimeCompactnessBudget
        arrival ν θ
          (generatedReceiptPersistenceTime
            current receipt ν θ) :=
    generatedIntegerShellReachableCommonTimeCompactnessBudget
      arrival ν θ θLtOne initialMargin
      (generatedReceiptPersistenceTime
        current receipt ν θ)
      persistenceTimePos
  exact
    ⟨budget,
      generatedReceipt_persists_on_commonTimeBudget
        arrival receiptMem ν θ
        (generatedReceiptPersistenceTime
          current receipt ν θ)
        persistenceTimePos budget le_rfl⟩

/-- One positive horizon containing every internally generated receipt
lifetime of a finite source path. -/
def generatedPathPersistenceHorizon
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (ν : Viscosity)
    (θ : ℝ) : ℝ :=
  1 +
    ((generatedIntegerShellReachableReceipts arrival).map
      fun receipt =>
        generatedReceiptPersistenceTime
          current receipt ν θ).sum

theorem generatedPathPersistenceHorizon_pos
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (ν : Viscosity)
    (θ : ℝ) :
    0 < generatedPathPersistenceHorizon arrival ν θ := by
  have timeSumNonneg :
      0 ≤
        ((generatedIntegerShellReachableReceipts arrival).map
          fun receipt =>
            generatedReceiptPersistenceTime
              current receipt ν θ).sum := by
    apply List.sum_nonneg
    intro time timeMem
    rcases List.mem_map.mp timeMem with
      ⟨receipt, receiptMem, rfl⟩
    exact
      (generatedReceiptPersistenceTime_pos
        current receipt ν θ).le
  unfold generatedPathPersistenceHorizon
  linarith

theorem generatedReceiptPersistenceTime_le_pathHorizon
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    {receipt : GeneratedIntegerShellReceipt}
    (receiptMem :
      receipt ∈ generatedIntegerShellReachableReceipts arrival)
    (ν : Viscosity)
    (θ : ℝ) :
    generatedReceiptPersistenceTime current receipt ν θ ≤
      generatedPathPersistenceHorizon arrival ν θ := by
  let times :=
    (generatedIntegerShellReachableReceipts arrival).map
      fun later =>
        generatedReceiptPersistenceTime
          current later ν θ
  have eachNonneg :
      ∀ time ∈ times, 0 ≤ time := by
    intro time timeMem
    rcases List.mem_map.mp timeMem with
      ⟨later, laterMem, rfl⟩
    exact
      (generatedReceiptPersistenceTime_pos
        current later ν θ).le
  have ownMem :
      generatedReceiptPersistenceTime current receipt ν θ ∈
        times :=
    List.mem_map.mpr ⟨receipt, receiptMem, rfl⟩
  have ownLeSum :
      generatedReceiptPersistenceTime current receipt ν θ ≤
        times.sum :=
    List.single_le_sum eachNonneg _ ownMem
  unfold generatedPathPersistenceHorizon
  change
    generatedReceiptPersistenceTime current receipt ν θ ≤
      1 + times.sum
  linarith

/-- A single source-generated physical Galerkin trajectory simultaneously
retains every historical receipt on its own frequency-cancelling lifetime.
This is the common carrier consumed by the receipt-square cascade bound. -/
theorem
    generatedIntegerShellReachable_receipts_persist_on_common_horizon
    {seed current : RawVorticityFourierSource}
    (arrival : GeneratedIntegerShellReachable seed current)
    (ν : Viscosity)
    (θ : ℝ)
    (θLtOne : θ < 1)
    (initialMargin :
      criticalEnstrophyLatticeConstant *
          finiteStateVorticityCoefficientEnstrophy
            (generatedSupport current)
            (generatedComplexVorticityState current
              (generatedSupport current)) ≤
        θ * ν.coeff ^ 2 * (2 * Real.pi) ^ 2) :
    ∃ budget :
        GeneratedPathCommonTimeCompactnessBudget
          arrival ν θ
            (generatedPathPersistenceHorizon
              arrival ν θ),
      ∀ receipt ∈
          generatedIntegerShellReachableReceipts arrival,
        ∀ t ∈
            Icc (0 : ℝ)
              (generatedReceiptPersistenceTime
                current receipt ν θ),
          coefficientCarrierNormSq
                (generatedIntegerShellReceiptTrace receipt) /
              4 ≤
            receiptSupportEnergy receipt
              (budget.trajectory t) := by
  have horizonPos :=
    generatedPathPersistenceHorizon_pos arrival ν θ
  let budget :
      GeneratedPathCommonTimeCompactnessBudget
        arrival ν θ
          (generatedPathPersistenceHorizon arrival ν θ) :=
    generatedIntegerShellReachableCommonTimeCompactnessBudget
      arrival ν θ θLtOne initialMargin
      (generatedPathPersistenceHorizon arrival ν θ)
      horizonPos
  refine ⟨budget, ?_⟩
  intro receipt receiptMem
  exact
    generatedReceipt_persists_on_commonTimeBudget
      arrival receiptMem ν θ
      (generatedPathPersistenceHorizon arrival ν θ)
      horizonPos budget
      (generatedReceiptPersistenceTime_le_pathHorizon
        arrival receiptMem ν θ)

end

