/-!
# Separation and continuity of the whole kinetic difference carrier

The kinetic carrier generated by the nonzero Fourier lattice is a genuine
separating quadratic functional once the source-owned zero row is fixed.
The same carrier is continuous on the actual whole `ℓ²` state space, so its
value along a whole continuous mild path is continuous in physical time.

No frequency cutoff, terminal shell, smallness knob, path equality, or
separation certificate is supplied by a caller.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalVorticityCoefficientWholeKineticMassSeparation

open scoped BigOperators ENNReal Topology

open Set
open ThreeDimensionalPeriodicCoarseFilterCore
open ThreeDimensionalPeriodicIntegerCharacterCoarseFilter
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientStretchingPairTable
open ThreeDimensionalVorticityCoefficientFiniteSupportComplexTrajectory
open ThreeDimensionalVorticityCoefficientGeneratedShellSerrinGeometry
open ThreeDimensionalVorticityCoefficientInfiniteFixedOutputNonlinearRow
open ThreeDimensionalVorticityCoefficientGeneratedIntegerShellPointwiseMassLimit
open ThreeDimensionalVorticityCoefficientGeneratedIntegerShellStrongContinuationEnergyLedger
open ThreeDimensionalVorticityCoefficientStrongContinuationDifferenceKineticEnergy

noncomputable section

/-! ## Separation on the complete nonzero lattice -/

theorem puncturedWholeVorticityKineticMass_nonneg
    (state : ComplexVorticityHilbertState) :
    0 ≤ puncturedWholeVorticityKineticMass state := by
  unfold puncturedWholeVorticityKineticMass
  exact tsum_nonneg fun wave =>
    div_nonneg
      (complexCoordinateAmplitudeSq_nonneg _)
      (integerWaveViscousMultiplier_pos wave).le

/--
Zero kinetic mass kills every actual nonzero Fourier row.  This is a
conclusion of positivity and summability on the generated lattice.
-/
theorem puncturedWholeVorticityKineticMass_eq_zero_implies_nonzero_rows
    (state : ComplexVorticityHilbertState)
    (massZero : puncturedWholeVorticityKineticMass state = 0)
    (wave : IntegerWavevector)
    (waveNe : wave ≠ 0) :
    state wave = 0 := by
  let indexedWave : NonzeroIntegerWavevector := ⟨wave, waveNe⟩
  have summable :=
    summable_puncturedWholeVorticityKineticMass state
  have termNonneg :
      0 ≤
        complexCoordinateAmplitudeSq (state indexedWave.1) /
          integerWaveViscousMultiplier indexedWave.1 :=
    div_nonneg
      (complexCoordinateAmplitudeSq_nonneg _)
      (integerWaveViscousMultiplier_pos indexedWave).le
  have termLeMass :
      complexCoordinateAmplitudeSq (state indexedWave.1) /
          integerWaveViscousMultiplier indexedWave.1 ≤
        puncturedWholeVorticityKineticMass state := by
    unfold puncturedWholeVorticityKineticMass
    exact
      summable.le_tsum indexedWave fun other otherNe =>
        div_nonneg
          (complexCoordinateAmplitudeSq_nonneg _)
          (integerWaveViscousMultiplier_pos other).le
  have termZero :
      complexCoordinateAmplitudeSq (state wave) /
          integerWaveViscousMultiplier wave =
        0 := by
    change
      complexCoordinateAmplitudeSq (state indexedWave.1) /
          integerWaveViscousMultiplier indexedWave.1 =
        0
    rw [massZero] at termLeMass
    exact le_antisymm termLeMass termNonneg
  have amplitudeZero :
      complexCoordinateAmplitudeSq (state wave) = 0 := by
    exact
      (div_eq_zero_iff.mp termZero).resolve_right
        (ne_of_gt (integerWaveViscousMultiplier_pos indexedWave))
  rw [complexCoordinateAmplitudeSq_eq_complexCoordinateVectorNormSq]
    at amplitudeZero
  exact
    (complexCoordinateVectorNormSq_eq_zero_iff (state wave)).mp
      amplitudeZero

/--
On the source-owned zero-row carrier, kinetic mass vanishes exactly at the
zero whole state.
-/
theorem puncturedWholeVorticityKineticMass_eq_zero_iff_of_zero_row
    (state : ComplexVorticityHilbertState)
    (zeroRow : state 0 = 0) :
    puncturedWholeVorticityKineticMass state = 0 ↔ state = 0 := by
  constructor
  · intro massZero
    apply lp.ext
    funext wave
    by_cases waveNe : wave ≠ 0
    · rw [
        puncturedWholeVorticityKineticMass_eq_zero_implies_nonzero_rows
          state massZero wave waveNe]
      simp
    · have waveZero : wave = 0 := not_ne_iff.mp waveNe
      subst wave
      change state 0 = 0
      exact zeroRow
  · rintro rfl
    unfold puncturedWholeVorticityKineticMass
    simp [complexCoordinateAmplitudeSq]

/-! ## A continuous whole-carrier realization -/

/--
The lattice-generated square-root kinetic weight, installed as zero on the
source-owned zero mode.
-/
def wholeKineticFourierWeight
    (wave : IntegerWavevector) : ℂ :=
  if _waveNe : wave ≠ 0
  then ((Real.sqrt (integerWaveViscousMultiplier wave) : ℂ)⁻¹)
  else 0

private theorem one_le_twoPi_sq :
    (1 : ℝ) ≤ (2 * Real.pi) ^ 2 := by
  nlinarith [Real.pi_gt_three]

theorem wholeKineticFourierWeight_norm_le_one
    (wave : IntegerWavevector) :
    ‖wholeKineticFourierWeight wave‖ ≤ 1 := by
  by_cases waveNe : wave ≠ 0
  · let indexedWave : NonzeroIntegerWavevector := ⟨wave, waveNe⟩
    have multiplierOne :
        (1 : ℝ) ≤ integerWaveViscousMultiplier wave :=
      one_le_twoPi_sq.trans
        (twoPiSq_le_integerWaveViscousMultiplier indexedWave)
    have sqrtOne :
        (1 : ℝ) ≤
          Real.sqrt (integerWaveViscousMultiplier wave) :=
      Real.one_le_sqrt.mpr multiplierOne
    have invLe :
        (Real.sqrt
          (integerWaveViscousMultiplier wave))⁻¹ ≤ 1 :=
      inv_le_one_of_one_le₀ sqrtOne
    simpa [wholeKineticFourierWeight, waveNe,
      norm_inv, abs_of_nonneg (Real.sqrt_nonneg _)] using invLe
  · simp [wholeKineticFourierWeight, waveNe]

/--
One physical coordinate of the whole state after the canonical kinetic
Fourier weight.  The operator is bounded uniformly on the complete lattice;
there is no truncation radius in its definition.
-/
def wholeKineticCoordinateSliceCLM
    (coordinate : Coordinate) :
    ComplexVorticityHilbertState →L[ℂ]
      lp (fun _ : IntegerWavevector => ℂ) 2 :=
  lp.mapCLM 2
    (fun wave =>
      wholeKineticFourierWeight wave •
        (ContinuousLinearMap.proj coordinate :
          ComplexCoordinateVector →L[ℂ] ℂ))
    zero_le_one
    (fun wave => by
      apply ContinuousLinearMap.opNorm_le_bound _ zero_le_one
      intro vector
      calc
        ‖(wholeKineticFourierWeight wave •
            (ContinuousLinearMap.proj coordinate :
              ComplexCoordinateVector →L[ℂ] ℂ)) vector‖ =
            ‖wholeKineticFourierWeight wave‖ *
              ‖vector coordinate‖ := by
                simp
        _ ≤ 1 * ‖vector coordinate‖ :=
          mul_le_mul_of_nonneg_right
            (wholeKineticFourierWeight_norm_le_one wave)
            (norm_nonneg _)
        _ ≤ 1 * ‖vector‖ := by
          exact mul_le_mul_of_nonneg_left
            (norm_le_pi_norm vector coordinate)
            zero_le_one)

@[simp] theorem wholeKineticCoordinateSliceCLM_apply
    (coordinate : Coordinate)
    (state : ComplexVorticityHilbertState)
    (wave : IntegerWavevector) :
    wholeKineticCoordinateSliceCLM coordinate state wave =
      wholeKineticFourierWeight wave * state wave coordinate :=
  rfl

private theorem wholeKineticFourierWeight_mul_norm_sq
    (wave : IntegerWavevector)
    (waveNe : wave ≠ 0)
    (coefficient : ℂ) :
    ‖wholeKineticFourierWeight wave * coefficient‖ ^ 2 =
      Complex.normSq coefficient /
        integerWaveViscousMultiplier wave := by
  let indexedWave : NonzeroIntegerWavevector := ⟨wave, waveNe⟩
  have multiplierPos :
      0 < integerWaveViscousMultiplier wave :=
    integerWaveViscousMultiplier_pos indexedWave
  have sqrtNe :
      Real.sqrt (integerWaveViscousMultiplier wave) ≠ 0 :=
    ne_of_gt (Real.sqrt_pos.2 multiplierPos)
  rw [wholeKineticFourierWeight, dif_pos waveNe, norm_mul,
    norm_inv, Complex.norm_real,
    Real.norm_eq_abs,
    abs_of_nonneg (Real.sqrt_nonneg _), mul_pow,
    Complex.normSq_eq_norm_sq, inv_pow,
    Real.sq_sqrt multiplierPos.le]
  field_simp

private theorem summable_puncturedWholeKineticCoordinate
    (coordinate : Coordinate)
    (state : ComplexVorticityHilbertState) :
    Summable fun wave : NonzeroIntegerWavevector =>
      Complex.normSq (state wave.1 coordinate) /
        integerWaveViscousMultiplier wave.1 := by
  exact
    Summable.of_nonneg_of_le
      (fun wave =>
        div_nonneg
          (Complex.normSq_nonneg _)
          (integerWaveViscousMultiplier_pos wave).le)
      (fun wave => by
        apply div_le_div_of_nonneg_right
        · unfold complexCoordinateAmplitudeSq
          exact
            Finset.single_le_sum
              (fun index _ => Complex.normSq_nonneg
                (state wave.1 index))
              (Finset.mem_univ coordinate)
        · exact (integerWaveViscousMultiplier_pos wave).le)
      (summable_puncturedWholeVorticityKineticMass state)

/--
One weighted coordinate slice has squared `ℓ²` norm equal to its complete
nonzero-lattice kinetic mass.
-/
theorem wholeKineticCoordinateSliceCLM_norm_sq
    (coordinate : Coordinate)
    (state : ComplexVorticityHilbertState) :
    ‖wholeKineticCoordinateSliceCLM coordinate state‖ ^ 2 =
      ∑' wave : NonzeroIntegerWavevector,
        Complex.normSq (state wave.1 coordinate) /
          integerWaveViscousMultiplier wave.1 := by
  let fullTerm : IntegerWavevector → ℝ :=
    fun wave =>
      ‖wholeKineticFourierWeight wave *
        state wave coordinate‖ ^ 2
  have fullSummable : Summable fullTerm := by
    have sliceSummable :=
      (lp.hasSum_norm
        (p := (2 : ℝ≥0∞)) (by norm_num)
        (wholeKineticCoordinateSliceCLM coordinate state)).summable
    convert sliceSummable using 1
    all_goals
      norm_num [fullTerm, wholeKineticCoordinateSliceCLM_apply]
  have normIdentity :=
    lp.norm_rpow_eq_tsum
      (p := (2 : ℝ≥0∞)) (by norm_num)
      (wholeKineticCoordinateSliceCLM coordinate state)
  norm_num [wholeKineticCoordinateSliceCLM_apply] at normIdentity
  have normIdentity' :
      ‖wholeKineticCoordinateSliceCLM coordinate state‖ ^ 2 =
        ∑' wave : IntegerWavevector, fullTerm wave := by
    rw [normIdentity]
    apply tsum_congr
    intro wave
    simp [fullTerm]
  have complementZero :
      (∑' wave :
          ↥({ wave : IntegerWavevector | wave ≠ 0 }ᶜ :
            Set IntegerWavevector),
        fullTerm wave.1) =
        0 := by
    rw [show
        (fun wave :
            ↥({ wave : IntegerWavevector | wave ≠ 0 }ᶜ :
              Set IntegerWavevector) =>
          fullTerm wave.1) =
          0 by
        funext wave
        have waveZero : wave.1 = 0 := by
          simpa using wave.2
        simp [fullTerm, wholeKineticFourierWeight, waveZero]]
    exact tsum_zero
  have split :=
    fullSummable.tsum_subtype_add_tsum_subtype_compl
      { wave : IntegerWavevector | wave ≠ 0 }
  rw [normIdentity', ← split, complementZero, add_zero]
  apply tsum_congr
  intro wave
  exact
    wholeKineticFourierWeight_mul_norm_sq
      wave.1 wave.2 (state wave.1 coordinate)

/--
The complete kinetic mass is exactly the finite sum of the three continuous
weighted coordinate-slice norm squares.
-/
theorem puncturedWholeVorticityKineticMass_eq_coordinateSlices
    (state : ComplexVorticityHilbertState) :
    puncturedWholeVorticityKineticMass state =
      ∑ coordinate : Coordinate,
        ‖wholeKineticCoordinateSliceCLM coordinate state‖ ^ 2 := by
  unfold puncturedWholeVorticityKineticMass
  unfold complexCoordinateAmplitudeSq
  simp_rw [Finset.sum_div]
  rw [Summable.tsum_finsetSum
    (fun coordinate _coordinateMem =>
      summable_puncturedWholeKineticCoordinate coordinate state)]
  apply Finset.sum_congr rfl
  intro coordinate coordinateMem
  exact
    (wholeKineticCoordinateSliceCLM_norm_sq
      coordinate state).symm

/-- Kinetic mass is continuous on the actual whole Fourier carrier. -/
theorem continuous_puncturedWholeVorticityKineticMass :
    Continuous puncturedWholeVorticityKineticMass := by
  rw [continuous_iff_continuousAt]
  intro state
  rw [show
      puncturedWholeVorticityKineticMass =
        fun current =>
          ∑ coordinate : Coordinate,
            ‖wholeKineticCoordinateSliceCLM coordinate current‖ ^ 2 by
      funext current
      exact
        puncturedWholeVorticityKineticMass_eq_coordinateSlices current]
  fun_prop

end

