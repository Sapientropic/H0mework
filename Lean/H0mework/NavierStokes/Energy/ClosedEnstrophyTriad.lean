import H0mework.NavierStokes.Fourier.StretchingPairTable

/-!
# Source-generated closed enstrophy-triad carrier

The vorticity source first generates its complete signed support and its
complete ordered stretching-pair table.  This module forms every triple
`(r, p, q)` from those two inventories and only then filters the triples whose
total frequency is zero:

```text
r + p + q = 0.
```

Each surviving occurrence retains its own complex bilinear enstrophy
coefficient `omega_r dot B_(p,q)`.  Coordinate observers therefore see the
individual source occurrence before the ordinary zero-frequency observer is
allowed to sum different triples.  Active occurrences and their positive
quantum are generated by an internal nonzero filter; neither closure nor
nonvanishing is accepted at the source mouth.

This is the coefficient carrier.  Its equality with the physical
vortex-stretching field and the unit-cell integral are downstream compiler
theorems.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalVorticityCoefficientClosedEnstrophyTriad

open scoped BigOperators Matrix

open Matrix
open ThreeDimensionalPeriodicCoarseFilterCore
open ThreeDimensionalPeriodicIntegerCharacterCoarseFilter
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientStretchingPairTable

noncomputable section

/-! ## Complete source-generated closed-triad inventory -/

/-- A testing-vorticity frequency together with one ordered stretching pair. -/
abbrev EnstrophyTriad := IntegerWavevector × StretchingPair

/-- Simultaneous frequency negation of all three slots. -/
def enstrophyTriadNeg (triad : EnstrophyTriad) : EnstrophyTriad :=
  (waveNeg triad.1, stretchingPairNeg triad.2)

@[simp] theorem enstrophyTriadNeg_involutive
    (triad : EnstrophyTriad) :
    enstrophyTriadNeg (enstrophyTriadNeg triad) = triad := by
  rcases triad with ⟨testing, pair⟩
  simp [enstrophyTriadNeg]

/-- Negation as an involutive equivalence of the ambient triad carrier. -/
def enstrophyTriadNegEquiv : EnstrophyTriad ≃ EnstrophyTriad where
  toFun := enstrophyTriadNeg
  invFun := enstrophyTriadNeg
  left_inv := enstrophyTriadNeg_involutive
  right_inv := enstrophyTriadNeg_involutive

/-- Total character frequency carried by one enstrophy triple. -/
def enstrophyTriadFrequency (triad : EnstrophyTriad) : IntegerWavevector :=
  triad.1 + stretchingPairOutput triad.2

@[simp] theorem enstrophyTriadFrequency_triadNeg
    (triad : EnstrophyTriad) :
    enstrophyTriadFrequency (enstrophyTriadNeg triad) =
      waveNeg (enstrophyTriadFrequency triad) := by
  funext coordinate
  simp [enstrophyTriadFrequency, enstrophyTriadNeg,
    stretchingPairOutput, stretchingPairNeg, waveNeg]
  ring

@[simp] theorem enstrophyTriadFrequency_eq_zero_iff_pairOutput_eq_waveNeg
    (testing : IntegerWavevector)
    (pair : StretchingPair) :
    enstrophyTriadFrequency (testing, pair) = 0 ↔
      stretchingPairOutput pair = waveNeg testing := by
  change
    testing + stretchingPairOutput pair = 0 ↔
      stretchingPairOutput pair = -testing
  rw [add_comm, add_eq_zero_iff_eq_neg]

/--
Complete zero-frequency triple inventory generated from the two source-owned
tables.  Closure is a filter result, not caller data.
-/
def generatedClosedEnstrophyTriadInventory
    (source : RawVorticityFourierSource) : Finset EnstrophyTriad :=
  ((generatedSupport source) ×ˢ
      generatedStretchingPairTable source).filter
    (fun triad => enstrophyTriadFrequency triad = 0)

@[simp] theorem mem_generatedClosedEnstrophyTriadInventory_iff
    (source : RawVorticityFourierSource)
    (triad : EnstrophyTriad) :
    triad ∈ generatedClosedEnstrophyTriadInventory source ↔
      triad.1 ∈ generatedSupport source ∧
        triad.2.1 ∈ generatedSupport source ∧
        triad.2.2 ∈ generatedSupport source ∧
        triad.1 + (triad.2.1 + triad.2.2) = 0 := by
  rw [generatedClosedEnstrophyTriadInventory, Finset.mem_filter,
    Finset.mem_product, mem_generatedStretchingPairTable_iff]
  change
    ((triad.1 ∈ generatedSupport source ∧
        (triad.2.1 ∈ generatedSupport source ∧
          triad.2.2 ∈ generatedSupport source)) ∧
      triad.1 + (triad.2.1 + triad.2.2) = 0) ↔ _
  constructor
  · rintro ⟨⟨htesting, hadvecting, htransported⟩, hclosed⟩
    exact ⟨htesting, hadvecting, htransported, hclosed⟩
  · rintro ⟨htesting, hadvecting, htransported, hclosed⟩
    exact ⟨⟨htesting, hadvecting, htransported⟩, hclosed⟩

@[simp] theorem mem_generatedClosedEnstrophyTriadInventory_triadNeg_iff
    (source : RawVorticityFourierSource)
    (triad : EnstrophyTriad) :
    enstrophyTriadNeg triad ∈
        generatedClosedEnstrophyTriadInventory source ↔
      triad ∈ generatedClosedEnstrophyTriadInventory source := by
  simp only [generatedClosedEnstrophyTriadInventory,
    Finset.mem_filter, Finset.mem_product]
  change
    ((waveNeg triad.1 ∈ generatedSupport source ∧
        stretchingPairNeg triad.2 ∈
          generatedStretchingPairTable source) ∧
      enstrophyTriadFrequency (enstrophyTriadNeg triad) = 0) ↔
    ((triad.1 ∈ generatedSupport source ∧
        triad.2 ∈ generatedStretchingPairTable source) ∧
      enstrophyTriadFrequency triad = 0)
  rw [mem_generatedSupport_waveNeg_iff,
    mem_generatedStretchingPairTable_pairNeg_iff,
    enstrophyTriadFrequency_triadNeg,
    waveNeg_eq_zero_iff]

/-! ## Occurrence coefficients and conjugate symmetry -/

/-- Complex bilinear enstrophy coefficient of one ordered closed triple. -/
def closedEnstrophyTriadContribution
    (source : RawVorticityFourierSource)
    (triad : EnstrophyTriad) : ℂ :=
  generatedVorticityCoefficient source triad.1 ⬝ᵥ
    generatedStretchingPairContribution source triad.2

/-- Simultaneous negation sends an occurrence coefficient to its conjugate. -/
theorem closedEnstrophyTriadContribution_triadNeg
    (source : RawVorticityFourierSource)
    (triad : EnstrophyTriad) :
    closedEnstrophyTriadContribution source (enstrophyTriadNeg triad) =
      star (closedEnstrophyTriadContribution source triad) := by
  rw [closedEnstrophyTriadContribution,
    closedEnstrophyTriadContribution,
    enstrophyTriadNeg,
    generatedVorticityCoefficient_waveNeg,
    generatedStretchingPairContribution_pairNeg]
  simp [dotProduct, vectorConj]

/-! ## Path-sensitive occurrence frame and coordinate observers -/

/-- A closed triad carrying its exact membership proof in the source table. -/
abbrev GeneratedClosedEnstrophyTriadOccurrence
    (source : RawVorticityFourierSource) :=
  {triad : EnstrophyTriad //
    triad ∈ generatedClosedEnstrophyTriadInventory source}

/-- Whole occurrence carrier before any scalar aggregation. -/
abbrev ClosedEnstrophyTriadCarrier
    (source : RawVorticityFourierSource) :=
  GeneratedClosedEnstrophyTriadOccurrence source → ℂ

/-- The source-generated coefficient at every closed-triad occurrence. -/
def generatedClosedEnstrophyTriadFrame
    (source : RawVorticityFourierSource) :
    ClosedEnstrophyTriadCarrier source :=
  fun occurrence =>
    closedEnstrophyTriadContribution source occurrence.1

/-- One faithful coordinate readout on the whole occurrence carrier. -/
def closedEnstrophyTriadCoordinateObserver
    (source : RawVorticityFourierSource)
    (occurrence : GeneratedClosedEnstrophyTriadOccurrence source) :
    ClosedEnstrophyTriadCarrier source →ₗ[ℂ] ℂ where
  toFun := fun frame => frame occurrence
  map_add' := by intro left right; rfl
  map_smul' := by intro scalar frame; rfl

@[simp] theorem closedEnstrophyTriadCoordinateObserver_generatedFrame
    (source : RawVorticityFourierSource)
    (occurrence : GeneratedClosedEnstrophyTriadOccurrence source) :
    closedEnstrophyTriadCoordinateObserver source occurrence
        (generatedClosedEnstrophyTriadFrame source) =
      closedEnstrophyTriadContribution source occurrence.1 :=
  rfl

/-- Ordinary aggregation of all occurrence coordinates, kept as a downstream map. -/
def closedEnstrophyTriadTotalObserver
    (source : RawVorticityFourierSource) :
    ClosedEnstrophyTriadCarrier source →ₗ[ℂ] ℂ where
  toFun := fun frame => ∑ occurrence, frame occurrence
  map_add' := by intro left right; simp [Finset.sum_add_distrib]
  map_smul' := by
    intro scalar frame
    simp only [Pi.smul_apply, smul_eq_mul]
    rw [Finset.mul_sum]
    simp

/-! ## Definition-generated active occurrences and quantum -/

/-- Closed occurrences are filtered for scalar nonvanishing only after generation. -/
def activeClosedEnstrophyTriadOccurrences
    (source : RawVorticityFourierSource) :
    Finset (GeneratedClosedEnstrophyTriadOccurrence source) :=
  Finset.univ.filter
    (fun occurrence =>
      generatedClosedEnstrophyTriadFrame source occurrence ≠ 0)

@[simp] theorem mem_activeClosedEnstrophyTriadOccurrences_iff
    (source : RawVorticityFourierSource)
    (occurrence : GeneratedClosedEnstrophyTriadOccurrence source) :
    occurrence ∈ activeClosedEnstrophyTriadOccurrences source ↔
      generatedClosedEnstrophyTriadFrame source occurrence ≠ 0 := by
  simp [activeClosedEnstrophyTriadOccurrences]

/-- One definition-generated active scalar occurrence. -/
abbrev ActiveClosedEnstrophyTriadOccurrence
    (source : RawVorticityFourierSource) :=
  {occurrence : GeneratedClosedEnstrophyTriadOccurrence source //
    occurrence ∈ activeClosedEnstrophyTriadOccurrences source}

/-- Squared complex magnitude of one active closed-triad coordinate. -/
def activeClosedEnstrophyTriadQuantum
    (source : RawVorticityFourierSource)
    (occurrence : ActiveClosedEnstrophyTriadOccurrence source) : ℝ :=
  Complex.normSq
    (generatedClosedEnstrophyTriadFrame source occurrence.1)

theorem activeClosedEnstrophyTriadQuantum_pos
    (source : RawVorticityFourierSource)
    (occurrence : ActiveClosedEnstrophyTriadOccurrence source) :
    0 < activeClosedEnstrophyTriadQuantum source occurrence := by
  rw [activeClosedEnstrophyTriadQuantum,
    Complex.normSq_pos]
  exact
    (mem_activeClosedEnstrophyTriadOccurrences_iff source occurrence.1).mp
      occurrence.2

/-- Every generated active occurrence escapes its own coordinate kernel. -/
theorem generatedClosedEnstrophyTriadFrame_not_mem_coordinateKernel
    (source : RawVorticityFourierSource)
    (occurrence : ActiveClosedEnstrophyTriadOccurrence source) :
    generatedClosedEnstrophyTriadFrame source ∉
      LinearMap.ker
        (closedEnstrophyTriadCoordinateObserver source occurrence.1) := by
  rw [LinearMap.mem_ker]
  exact
    (mem_activeClosedEnstrophyTriadOccurrences_iff source occurrence.1).mp
      occurrence.2

/-! ## Downstream total zero-frequency observer -/

/-- Ordinary zero-frequency aggregation, deliberately downstream of the frame. -/
def generatedEnstrophyZeroFrequencyCoefficient
    (source : RawVorticityFourierSource) : ℂ :=
  ∑ triad ∈ generatedClosedEnstrophyTriadInventory source,
    closedEnstrophyTriadContribution source triad

/-- The ordinary coefficient is exactly the total projection of the frame. -/
theorem closedEnstrophyTriadTotalObserver_generatedFrame
    (source : RawVorticityFourierSource) :
    closedEnstrophyTriadTotalObserver source
        (generatedClosedEnstrophyTriadFrame source) =
      generatedEnstrophyZeroFrequencyCoefficient source := by
  rw [generatedEnstrophyZeroFrequencyCoefficient]
  change
    (∑ occurrence : GeneratedClosedEnstrophyTriadOccurrence source,
      closedEnstrophyTriadContribution source occurrence.1) = _
  rw [← Finset.attach_eq_univ,
    Finset.sum_attach]

/--
The downstream zero-frequency sum is exactly the outer-vorticity pairing with
the pair-table coefficient at the opposite frequency.  This is a regrouping
of the one complete source table; it neither selects nor discards an
occurrence.
-/
theorem generatedEnstrophyZeroFrequencyCoefficient_eq_outer_sum
    (source : RawVorticityFourierSource) :
    generatedEnstrophyZeroFrequencyCoefficient source =
      ∑ testing ∈ generatedSupport source,
        generatedVorticityCoefficient source testing ⬝ᵥ
          generatedStretchingCoefficientAt source (waveNeg testing) := by
  rw [generatedEnstrophyZeroFrequencyCoefficient,
    generatedClosedEnstrophyTriadInventory,
    Finset.sum_filter, Finset.sum_product]
  apply Finset.sum_congr rfl
  intro testing testingMembership
  rw [generatedStretchingCoefficientAt,
    generatedStretchingPairFiber,
    Finset.sum_filter,
    dotProduct_sum]
  apply Finset.sum_congr rfl
  intro pair pairMembership
  by_cases outputEquality :
      stretchingPairOutput pair = waveNeg testing
  · have frequencyZero :
        enstrophyTriadFrequency (testing, pair) = 0 :=
      (enstrophyTriadFrequency_eq_zero_iff_pairOutput_eq_waveNeg
        testing pair).mpr outputEquality
    simp [outputEquality, frequencyZero,
      closedEnstrophyTriadContribution]
  · have frequencyNonzero :
        enstrophyTriadFrequency (testing, pair) ≠ 0 :=
      (enstrophyTriadFrequency_eq_zero_iff_pairOutput_eq_waveNeg
        testing pair).not.mpr outputEquality
    simp [outputEquality, frequencyNonzero]

/-- The zero-frequency coefficient is real by source-generated signed symmetry. -/
theorem star_generatedEnstrophyZeroFrequencyCoefficient
    (source : RawVorticityFourierSource) :
    star (generatedEnstrophyZeroFrequencyCoefficient source) =
      generatedEnstrophyZeroFrequencyCoefficient source := by
  rw [generatedEnstrophyZeroFrequencyCoefficient,
    star_sum]
  symm
  refine Finset.sum_equiv enstrophyTriadNegEquiv ?_ ?_
  · intro triad
    exact
      (mem_generatedClosedEnstrophyTriadInventory_triadNeg_iff
        source triad).symm
  · intro triad membership
    change
      closedEnstrophyTriadContribution source triad =
        star
          (closedEnstrophyTriadContribution source
            (enstrophyTriadNeg triad))
    simpa using
      (closedEnstrophyTriadContribution_triadNeg source
        (enstrophyTriadNeg triad))

theorem generatedEnstrophyZeroFrequencyCoefficient_im_eq_zero
    (source : RawVorticityFourierSource) :
    (generatedEnstrophyZeroFrequencyCoefficient source).im = 0 := by
  have reality := star_generatedEnstrophyZeroFrequencyCoefficient source
  exact Complex.conj_eq_iff_im.mp (by simpa using reality)

/-! ## Empty-source negative controls -/

@[simp] theorem zeroRawVorticitySource_closedTriadInventory :
    generatedClosedEnstrophyTriadInventory zeroRawVorticitySource = ∅ := by
  simp [generatedClosedEnstrophyTriadInventory]

@[simp] theorem zeroRawVorticitySource_activeClosedOccurrences :
    activeClosedEnstrophyTriadOccurrences zeroRawVorticitySource = ∅ := by
  simp [activeClosedEnstrophyTriadOccurrences]

@[simp] theorem zeroRawVorticitySource_enstrophyZeroFrequencyCoefficient :
    generatedEnstrophyZeroFrequencyCoefficient zeroRawVorticitySource = 0 := by
  simp [generatedEnstrophyZeroFrequencyCoefficient]

end

end ThreeDimensionalVorticityCoefficientClosedEnstrophyTriad
end NavierStokes
end SaturationMonoid
