import H0mework.NavierStokes.Accumulation.BoundaryDisposition
import H0mework.NavierStokes.MacroRuntime.Runtime

/-!
# Conservative NS continuation after boundary recovery

The fixed inquiry outcome has already generated its sealed typed recovery.
This module is its original-NS consumer.  It restricts the recovery next to
the authoritative native temporal root and installs the exact physical
endpoint macro response generated by the same cofinal occurrence.

No landing, endpoint, target current, continuation, or runtime branch is
accepted from the caller.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalVorticityCoefficientGeneratedWholeRestartNativeAccumulationBoundaryContinuation

open Set
open ResponsibilityLifecycle
open ResponsibilityLifecycle.LivingLawEvolution
open ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
open ThreeDimensionalPeriodicFilteredNavierStokesGenerator
open ThreeDimensionalVorticityCoefficientGeneratedWholeRestartNativeRecursion
open ThreeDimensionalVorticityCoefficientGeneratedWholeRestartNativeRecursion.GeneratedWholeRestartCurrent
open ThreeDimensionalVorticityCoefficientGeneratedWholeRestartNativeAccumulationRoot
open ThreeDimensionalVorticityCoefficientGeneratedWholeRestartVelocityEndpointPositiveTimeH1Reentry
open ThreeDimensionalVorticityCoefficientGeneratedWholeRestartVelocityEndpointRecursiveMacroRuntime
open ThreeDimensionalVorticityCoefficientGeneratedWholeRestartNativeAccumulationBoundaryDisposition

noncomputable section

/-- Same-source package consumed by the original NS endpoint runtime. -/
structure NativeAccumulationBoundaryRecoveryNSContinuationAt
    {nu : Viscosity}
    (initial : GeneratedWholeRestartCurrent nu)
    {elapsedBounded : BddAbove (Set.range (elapsedTime initial))}
    (u8 : SourceGeneratedNativeAccumulationBoundaryU8At
      initial elapsedBounded) : Type where
  private mk ::
  next : GeneratedWholeRestartCurrent nu
  step : GeneratedWholeRestartEndpointMacroStep nu initial next
  rootNext_generated :
    ((nativeTemporalRoot initial).toRoot.evolutionAt
        (.galerkin 1 : NativeTemporalCurrent initial)).nextCurrent? =
      some
        u8.recoveryNativeCurrent

/-- The recovery next is consumed by the old root and the original endpoint
runtime in one result.  The first component is the physical recursive current;
the first proof is its actual macro edge, while the second proof identifies the
U8 recovery target with the next current already generated by the old root.
There is no second continuation carrier. -/
def sourceGeneratedNativeAccumulationBoundaryRecoveryNSContinuation
    {nu : Viscosity}
    (initial : GeneratedWholeRestartCurrent nu)
    {elapsedBounded : BddAbove (Set.range (elapsedTime initial))}
    (u8 : SourceGeneratedNativeAccumulationBoundaryU8At
      initial elapsedBounded) :
    NativeAccumulationBoundaryRecoveryNSContinuationAt
      initial u8 where
  next := generatedPositiveTimeH1NextCurrentOfNativeTemporalCofinalOccurrence
    initial (nativeTemporalCofinalVisitAuthority initial).toLedgerReadout.occurrence
  step := .advance initial elapsedBounded
  rootNext_generated := rfl

@[simp] theorem
    sourceGeneratedNativeAccumulationBoundaryRecoveryNSContinuation_next
    {nu : Viscosity}
    (initial : GeneratedWholeRestartCurrent nu)
    {elapsedBounded : BddAbove (Set.range (elapsedTime initial))}
    (u8 : SourceGeneratedNativeAccumulationBoundaryU8At
      initial elapsedBounded) :
    (sourceGeneratedNativeAccumulationBoundaryRecoveryNSContinuation
      initial u8).next =
        sourceGeneratedNativeTemporalPositiveTimeH1NextCurrent initial := by
  exact nativeTemporalCofinalVisitAuthority_positiveTimeH1NextCurrent initial

/-- Direct runtime consumer: a revised inquiry outcome cannot stop at its
U8 readout.  The original endpoint responder emits the physical edge
carried by the conservative recovery result. -/
theorem sourceGeneratedNativeAccumulationBoundaryRecovery_macroRespond_exact
    {nu : Viscosity}
    (initial : GeneratedWholeRestartCurrent nu)
    {elapsedBounded : BddAbove (Set.range (elapsedTime initial))}
    (u8 : SourceGeneratedNativeAccumulationBoundaryU8At
      initial elapsedBounded) :
    generatedWholeRestartEndpointMacroRespond initial =
      some
        ⟨(sourceGeneratedNativeAccumulationBoundaryRecoveryNSContinuation
            initial u8).next,
          (sourceGeneratedNativeAccumulationBoundaryRecoveryNSContinuation
            initial u8).step⟩ := by
  exact generatedWholeRestartEndpointMacroRespond_eq_some
    initial elapsedBounded

end

end ThreeDimensionalVorticityCoefficientGeneratedWholeRestartNativeAccumulationBoundaryContinuation
end NavierStokes
end SaturationMonoid
