import H0mework.NavierStokes.Accumulation.TemporalActionCoupling

/-!
# Source-native fluid medium and classical Navier--Stokes restriction

This module moves the authority boundary above the classical whole-vorticity
state.  A `NativeFluidMediumSource` fixes, before any downstream restriction,

* its state and source action;
* the action-generated successor;
* an internal medium state and constitutive stress law;
* the whole vorticity/pressure readout;
* clock, potential, density and scale rows; and
* local physical patches with their adjacent commuting boundary.

The classical Navier--Stokes tangent and every finite Galerkin tangent are
then restrictions of one generated medium occurrence.  The medium residual
is the Fourier curl-divergence of the source-owned constitutive stress.  The
Galerkin projection residual is defined separately, so a finite closure debt
cannot be renamed as evidence that the whole classical carrier omitted a
physical medium coordinate.

The concrete whole-restart source at the end is the faithful Newtonian
baseline: its internal fibre is trivial and its medium residual is zero.  It
validates the restriction square without claiming that a nontrivial real
fluid medium has already been selected.
-/

set_option autoImplicit false

open scoped BigOperators Matrix

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalVorticityCoefficientNativeFluidMedium

open Matrix
open ThreeDimensionalPeriodicCoarseFilterCore
open ThreeDimensionalPeriodicIntegerCharacterCoarseFilter
open ThreeDimensionalPeriodicFilteredNavierStokesGenerator
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientFiniteSupportComplexTrajectory
open ThreeDimensionalVorticityCoefficientFiniteSupportRealityTrajectory
open ThreeDimensionalVorticityCoefficientInfiniteFixedOutputNonlinearRow
open ThreeDimensionalVorticityCoefficientGeneratedWholeRestartCanonicalReplay
open ThreeDimensionalVorticityCoefficientGeneratedWholeRestartNativeRecursion
open ThreeDimensionalVorticityCoefficientGeneratedWholeRestartNativeRecursion.GeneratedWholeRestartCurrent
open ThreeDimensionalVorticityCoefficientStrongContinuationDifferenceKineticEnergy
open ThreeDimensionalVorticityCoefficientGeneratedWholeRestartKineticDissipationLedger
open ThreeDimensionalVorticityCoefficientGeneratedWholeRestartCumulativeKineticDissipation
open ThreeDimensionalVorticityCoefficientGeneratedWholeRestartNativeTemporalActionCoupling
open ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot.RootArithmeticIncidence

noncomputable section

/-! ## Concrete fluid constitutive carrier -/

/-- One Fourier coefficient of a spatial constitutive stress tensor. -/
abbrev NativeFluidStressCoefficient := Coordinate → Coordinate → Complex

/-- Whole integer-lattice constitutive stress carried by the medium. -/
abbrev NativeFluidStressFourierState :=
  IntegerWavevector → NativeFluidStressCoefficient

/-- Whole coefficient-space vorticity tangent. -/
abbrev NativeFluidVorticityTangent :=
  IntegerWavevector → ComplexCoordinateVector

/-- Fourier divergence of a constitutive stress for the repository character
`exp (i 2π k · x)`. -/
def nativeFluidStressDivergenceCoefficient
    (stress : NativeFluidStressFourierState)
    (wave : IntegerWavevector) : ComplexCoordinateVector :=
  fun outputCoordinate =>
    (Complex.I * (((2 * Real.pi : Real) : Complex))) *
      ∑ inputCoordinate : Coordinate,
        complexWavevector wave inputCoordinate *
          stress wave outputCoordinate inputCoordinate

/-- Vorticity forcing generated by the constitutive stress: `curl (div τ)`.
This operator is fixed here; a downstream restriction cannot submit an
unrelated correction row. -/
def nativeFluidConstitutiveVorticityAction
    (stress : NativeFluidStressFourierState) :
    NativeFluidVorticityTangent :=
  fun wave =>
    fourierCurlCoefficient wave
      (nativeFluidStressDivergenceCoefficient stress wave)

@[simp] theorem nativeFluidConstitutiveVorticityAction_zero :
    nativeFluidConstitutiveVorticityAction
        (0 : NativeFluidStressFourierState) = 0 := by
  funext wave coordinate
  fin_cases coordinate <;>
    simp [nativeFluidConstitutiveVorticityAction,
      nativeFluidStressDivergenceCoefficient, fourierCurlCoefficient,
      cross_apply]

/-- The unforced classical whole-vorticity vector field. -/
def classicalWholeNSVorticityTangent
    (nu : Viscosity)
    (vorticity : ComplexVorticityHilbertState) :
    NativeFluidVorticityTangent :=
  fun wave =>
    wholeStateVorticityNonlinearCoefficientAt vorticity wave -
      (nu.coeff * integerWaveViscousMultiplier wave) • vorticity wave

/-- Coefficient-space classical NS readout of one medium state.  Velocity is
not stored independently: it is generated by Biot--Savart from vorticity. -/
structure ClassicalNSFourierReadout (nu : Viscosity) where
  vorticity : ComplexVorticityHilbertState
  pressure : NSPressureField
  transverse : WholeStateTransverse vorticity
  reality : FiniteStateFourierReality vorticity

def ClassicalNSFourierReadout.velocityCoefficient
    {nu : Viscosity}
    (readout : ClassicalNSFourierReadout nu)
    (wave : IntegerWavevector) : ComplexCoordinateVector :=
  biotSavartVelocityCoefficient wave (readout.vorticity wave)

/-! ## Upstream source/action/constitutive law -/

/-- A source-native fluid medium law.

The constitutive stress is a function of the internal medium state and the
whole vorticity readout.  It is fixed in this source record before the
classical NS adapter below is available.  The successor is generated only as
`evolve state (actionAt state)`, and adjacent local patches commute at the
same generated edge. -/
structure NativeFluidMediumSource (nu : Viscosity) : Type 1 where
  State : Type
  InternalState : Type
  Action : Type
  initial : State
  actionAt : State → Action
  evolve : State → Action → State
  /-- Complete local effect emitted before the root compiler chooses its
  ledger disposition.  This is a dependent source field, not a downstream
  branch premise. -/
  OperationalEffectAt : State → Type
  operationalEffectAt : (state : State) → OperationalEffectAt state
  operationalArithmeticMaterialAt : {state : State} →
    OperationalEffectAt state → RootArithmeticMaterialAt
  operationalNetEnstrophyDebitAt : {state : State} →
    OperationalEffectAt state → Real
  operationalContactTimeAt : {state : State} →
    OperationalEffectAt state → Real
  operationalContactTime_pos : ∀ {state : State}
    (effect : OperationalEffectAt state),
      0 < operationalContactTimeAt effect
  OperationalResidualExpansionAt : {state : State} →
    (effect : OperationalEffectAt state) →
    GeneratedParallelResidualAt effect
      (operationalArithmeticMaterialAt effect) → Type
  generateOperationalResidualExpansionAt : ∀ {state : State}
    (effect : OperationalEffectAt state)
    (residual : GeneratedParallelResidualAt effect
      (operationalArithmeticMaterialAt effect)),
      OperationalResidualExpansionAt effect residual
  /-- Physical valuation generated by that same residual expansion.  It is
  medium-specific and therefore remains outside the generic arithmetic
  kernel, while retaining the complete effect/residual provenance. -/
  operationalResidualExpansionDebitAt : ∀ {state : State}
    (effect : OperationalEffectAt state)
    (residual : GeneratedParallelResidualAt effect
      (operationalArithmeticMaterialAt effect)),
      OperationalResidualExpansionAt effect residual → Real
  operationalResidualExpansionDebit_nonneg : ∀ {state : State}
    (effect : OperationalEffectAt state)
    (residual : GeneratedParallelResidualAt effect
      (operationalArithmeticMaterialAt effect))
    (expansion : OperationalResidualExpansionAt effect residual),
      0 ≤ operationalResidualExpansionDebitAt effect residual expansion
  vorticityAt : State → ComplexVorticityHilbertState
  pressureAt : State → NSPressureField
  internalAt : State → InternalState
  zeroInternal : InternalState
  constitutiveStressOf :
    InternalState → ComplexVorticityHilbertState →
      NativeFluidStressFourierState
  constitutiveStress_zero : ∀ vorticity,
    constitutiveStressOf zeroInternal vorticity = 0
  vorticityTangentOf :
    State → Action → NativeFluidVorticityTangent
  action_constitutive : ∀ state,
    vorticityTangentOf state (actionAt state) =
      classicalWholeNSVorticityTangent nu (vorticityAt state) +
        nativeFluidConstitutiveVorticityAction
          (constitutiveStressOf (internalAt state) (vorticityAt state))
  vorticity_transverse : ∀ state, WholeStateTransverse (vorticityAt state)
  vorticity_reality : ∀ state, FiniteStateFourierReality (vorticityAt state)
  clockAt : State → Real
  potentialAt : State → Real
  densityAt : State → Real
  scaleAt : State → Real
  clock_pos : ∀ state, 0 < clockAt state
  density_nonneg : ∀ state, 0 ≤ densityAt state
  temporal_action : ∀ state,
    potentialAt state - potentialAt (evolve state (actionAt state)) =
      clockAt state * densityAt state
  PatchAt : State → Type
  BoundaryAt : State → Type
  initialPatch : PatchAt initial
  advancePatch :
    (state : State) → PatchAt state →
      PatchAt (evolve state (actionAt state))
  restrictPatch :
    (state : State) → PatchAt (evolve state (actionAt state)) →
      PatchAt state
  advance_restricts : ∀ state patch,
    restrictPatch state (advancePatch state patch) = patch
  outgoingBoundaryAt :
    (state : State) → PatchAt state → BoundaryAt state
  incomingBoundaryAt :
    (state : State) →
      PatchAt (evolve state (actionAt state)) → BoundaryAt state
  boundary_commutes : ∀ state patch,
    incomingBoundaryAt state
        (advancePatch state patch) =
      outgoingBoundaryAt state patch

namespace NativeFluidMediumSource

variable {nu : Viscosity}

/-- The sole successor generated by the fixed source action. -/
def successor (source : NativeFluidMediumSource nu)
    (state : source.State) : source.State :=
  source.evolve state (source.actionAt state)

/-- The source-owned constitutive stress at one state. -/
def constitutiveStressAt (source : NativeFluidMediumSource nu)
    (state : source.State) : NativeFluidStressFourierState :=
  source.constitutiveStressOf (source.internalAt state)
    (source.vorticityAt state)

/-- Exact operational effect emitted by the same source/action occurrence. -/
def operationalEffect (source : NativeFluidMediumSource nu)
    (state : source.State) : source.OperationalEffectAt state :=
  source.operationalEffectAt state

/-- Arithmetic normal form of the complete source effect.  The effect itself
is the normalization provenance, so no qualitative adapter can separate the
normal form from its Real valuation. -/
def operationalParallelNormalForm (source : NativeFluidMediumSource nu)
    (state : source.State) :
    ParallelIncidenceNormalFormAt (source.operationalEffectAt state)
      (source.operationalArithmeticMaterialAt
        (source.operationalEffectAt state)) :=
  normalizeParallel (source.operationalEffectAt state)
    (source.operationalArithmeticMaterialAt
      (source.operationalEffectAt state))

/-- Exact state reached after finitely many source/action updates. -/
def stateAfter (source : NativeFluidMediumSource nu) : Nat → source.State
  | 0 => source.initial
  | index + 1 => source.successor (source.stateAfter index)

@[simp] theorem stateAfter_zero (source : NativeFluidMediumSource nu) :
    source.stateAfter 0 = source.initial := rfl

@[simp] theorem stateAfter_succ (source : NativeFluidMediumSource nu)
    (index : Nat) :
    source.stateAfter (index + 1) =
      source.successor (source.stateAfter index) := rfl

end NativeFluidMediumSource

/-! ## Source-generated actual occurrence -/

/-- Zero-information token for one actual source/action medium occurrence.
Every physical row below is recomputed from the fixed source and state. -/
structure NativeFluidMediumOccurrence
    {nu : Viscosity}
    (source : NativeFluidMediumSource nu)
    (_state : source.State) : Type where
  private mk ::

def NativeFluidMediumSource.generateOccurrence
    {nu : Viscosity}
    (source : NativeFluidMediumSource nu)
    (state : source.State) : NativeFluidMediumOccurrence source state :=
  .mk

namespace NativeFluidMediumOccurrence

variable {nu : Viscosity}
variable {source : NativeFluidMediumSource nu}
variable {state : source.State}

def toClassicalNS
    (_occurrence : NativeFluidMediumOccurrence source state) :
    ClassicalNSFourierReadout nu where
  vorticity := source.vorticityAt state
  pressure := source.pressureAt state
  transverse := source.vorticity_transverse state
  reality := source.vorticity_reality state

def constitutiveStress
    (_occurrence : NativeFluidMediumOccurrence source state) :
    NativeFluidStressFourierState :=
  source.constitutiveStressAt state

/-- Constitutive momentum-flux divergence generated from the same stress
coordinate. -/
def constitutiveFlux
    (occurrence : NativeFluidMediumOccurrence source state) :
    IntegerWavevector → ComplexCoordinateVector :=
  fun wave =>
    nativeFluidStressDivergenceCoefficient occurrence.constitutiveStress wave

/-- Whole vorticity mass of the same medium occurrence. -/
def vorticityMass
    (occurrence : NativeFluidMediumOccurrence source state) : Real :=
  wholeVorticityEuclideanMass occurrence.toClassicalNS.vorticity

/-- The omitted-medium residual compares two independently fixed rows: the
source/action tangent and the classical whole-NS tangent of its restriction. -/
def mediumResidual
    (occurrence : NativeFluidMediumOccurrence source state) :
    NativeFluidVorticityTangent :=
  source.vorticityTangentOf state (source.actionAt state) -
    classicalWholeNSVorticityTangent nu occurrence.toClassicalNS.vorticity

/-- Native whole-vorticity evolution generated by the medium occurrence. -/
def nativeVorticityTangent
    (_occurrence : NativeFluidMediumOccurrence source state) :
    NativeFluidVorticityTangent :=
  source.vorticityTangentOf state (source.actionAt state)

/-- Exact whole restriction equation
`Dπ(F_medium) = F_NS(πX) + T_medium(X)`. -/
theorem nativeVorticityTangent_eq_classical_add_mediumResidual
    (occurrence : NativeFluidMediumOccurrence source state) :
    occurrence.nativeVorticityTangent =
      classicalWholeNSVorticityTangent nu
          occurrence.toClassicalNS.vorticity +
        occurrence.mediumResidual := by
  unfold nativeVorticityTangent mediumResidual
  abel

/-- The source/action constitutive law identifies the independently measured
medium residual with `curl (div τ)` of the same occurrence's stress. -/
theorem mediumResidual_eq_constitutiveVorticityAction
    (occurrence : NativeFluidMediumOccurrence source state) :
    occurrence.mediumResidual =
      nativeFluidConstitutiveVorticityAction
        occurrence.constitutiveStress := by
  unfold mediumResidual constitutiveStress toClassicalNS
    NativeFluidMediumSource.constitutiveStressAt
  rw [source.action_constitutive state]
  abel

/-- Structural classical-realizability: the internal medium coordinate is
the source's distinguished zero fibre. -/
def ClassicalRealizable
    (_occurrence : NativeFluidMediumOccurrence source state) : Prop :=
  source.internalAt state = source.zeroInternal

theorem constitutiveStress_eq_zero_of_classicalRealizable
    (occurrence : NativeFluidMediumOccurrence source state)
    (realizable : occurrence.ClassicalRealizable) :
    occurrence.constitutiveStress = 0 := by
  unfold constitutiveStress NativeFluidMediumSource.constitutiveStressAt
  rw [realizable]
  exact source.constitutiveStress_zero _

/-- A classically realizable medium occurrence has no omitted-medium
vorticity action. -/
theorem mediumResidual_eq_zero_of_classicalRealizable
    (occurrence : NativeFluidMediumOccurrence source state)
    (realizable : occurrence.ClassicalRealizable) :
    occurrence.mediumResidual = 0 := by
  rw [occurrence.mediumResidual_eq_constitutiveVorticityAction,
    occurrence.constitutiveStress_eq_zero_of_classicalRealizable realizable,
    nativeFluidConstitutiveVorticityAction_zero]

/-- Classical whole NS is faithful at an occurrence exactly when the
source-generated medium residual vanishes. -/
theorem nativeVorticityTangent_eq_classical_iff_mediumResidual_eq_zero
    (occurrence : NativeFluidMediumOccurrence source state) :
    occurrence.nativeVorticityTangent =
        classicalWholeNSVorticityTangent nu
          occurrence.toClassicalNS.vorticity ↔
      occurrence.mediumResidual = 0 := by
  unfold nativeVorticityTangent mediumResidual
  constructor
  · intro equality
    exact sub_eq_zero.mpr equality
  · intro residualZero
    exact sub_eq_zero.mp residualZero

theorem nativeVorticityTangent_eq_classical_of_classicalRealizable
    (occurrence : NativeFluidMediumOccurrence source state)
    (realizable : occurrence.ClassicalRealizable) :
    occurrence.nativeVorticityTangent =
      classicalWholeNSVorticityTangent nu
        occurrence.toClassicalNS.vorticity :=
  (occurrence.nativeVorticityTangent_eq_classical_iff_mediumResidual_eq_zero
    ).2 (occurrence.mediumResidual_eq_zero_of_classicalRealizable realizable)

def clock (_occurrence : NativeFluidMediumOccurrence source state) : Real :=
  source.clockAt state

def potential
    (_occurrence : NativeFluidMediumOccurrence source state) : Real :=
  source.potentialAt state

def density (_occurrence : NativeFluidMediumOccurrence source state) : Real :=
  source.densityAt state

def scale (_occurrence : NativeFluidMediumOccurrence source state) : Real :=
  source.scaleAt state

theorem potential_drop_eq_clock_mul_density
    (occurrence : NativeFluidMediumOccurrence source state) :
    occurrence.potential -
        source.potentialAt (source.successor state) =
      occurrence.clock * occurrence.density :=
  source.temporal_action state

theorem generatedPatch_commutes
    (_occurrence : NativeFluidMediumOccurrence source state)
    (patch : source.PatchAt state) :
  source.incomingBoundaryAt state
        (source.advancePatch state patch) =
      source.outgoingBoundaryAt state patch :=
  source.boundary_commutes state patch

end NativeFluidMediumOccurrence

/-! ## Separate finite projection residual -/

/-- Plain finite row projection.  It is intentionally distinct from the
medium constitutive operator. -/
def nativeFluidFiniteRowProjection
    (modes : Finset IntegerWavevector)
    (row : NativeFluidVorticityTangent) : NativeFluidVorticityTangent :=
  fun wave => if wave ∈ modes then row wave else 0

/-- Classical finite Galerkin tangent generated from the projected whole
state. -/
def classicalFiniteNSVorticityTangent
    (nu : Viscosity)
    (modes : Finset IntegerWavevector)
    (vorticity : ComplexVorticityHilbertState) :
    NativeFluidVorticityTangent :=
  fun wave =>
    finiteStateVorticityGenerator modes nu.coeff
      (complexSharpSupportProjection modes vorticity) wave

/-- Finite representation debt of classical NS itself.  This is
`T_projection`, not `T_medium`. -/
def classicalNSProjectionResidual
    (nu : Viscosity)
    (modes : Finset IntegerWavevector)
    (vorticity : ComplexVorticityHilbertState) :
    NativeFluidVorticityTangent :=
  nativeFluidFiniteRowProjection modes
      (classicalWholeNSVorticityTangent nu vorticity) -
    classicalFiniteNSVorticityTangent nu modes vorticity

/-- Full finite restriction square.  The two corrections remain separate:

`P F_medium = F_Galerkin + T_projection + P T_medium`.
-/
theorem projectedNativeVorticityTangent_eq_finite_add_projection_add_medium
    {nu : Viscosity}
    {source : NativeFluidMediumSource nu}
    {state : source.State}
    (occurrence : NativeFluidMediumOccurrence source state)
    (modes : Finset IntegerWavevector) :
    nativeFluidFiniteRowProjection modes occurrence.nativeVorticityTangent =
      classicalFiniteNSVorticityTangent nu modes
          occurrence.toClassicalNS.vorticity +
        classicalNSProjectionResidual nu modes
          occurrence.toClassicalNS.vorticity +
        nativeFluidFiniteRowProjection modes occurrence.mediumResidual := by
  rw [occurrence.nativeVorticityTangent_eq_classical_add_mediumResidual]
  funext wave
  by_cases waveMem : wave ∈ modes
  · simp only [nativeFluidFiniteRowProjection, waveMem, if_true,
      classicalNSProjectionResidual,
      Pi.add_apply, Pi.sub_apply]
    abel
  · simp only [nativeFluidFiniteRowProjection, waveMem, if_false,
      classicalNSProjectionResidual, Pi.add_apply, Pi.sub_apply]
    abel

/-! ## Faithful Newtonian whole-restart baseline -/

/-- The existing whole-restart process, viewed as a concrete medium source
whose internal fibre is trivial.  This is the faithful classical baseline,
not evidence for a nonzero real-fluid medium correction. -/
def classicalWholeRestartMediumSource
    {nu : Viscosity}
    (initial : GeneratedWholeRestartCurrent nu) :
    NativeFluidMediumSource nu where
  State := GeneratedWholeRestartRuntimeCurrent nu
  InternalState := PUnit
  Action := PUnit
  initial :=
    { physical := initial
      standing := .clear
      cellEffect := generatedWholeRestartStandingCellEffect .clear }
  actionAt := fun _ => PUnit.unit
  evolve := fun current _ => current.next
  OperationalEffectAt := fun current =>
    NativeRestartStandingValuedArithmeticMaterialAt current.standing
  operationalEffectAt := fun current =>
    nativeRestartStandingValuedArithmeticMaterial current.cellEffect
  operationalArithmeticMaterialAt := fun material =>
    material.arithmeticMaterial
  operationalNetEnstrophyDebitAt := fun material =>
    material.rawValuedMaterial.netEnstrophyDebit
  operationalContactTimeAt := fun material => material.contactTime
  operationalContactTime_pos := fun material => material.contactTime_pos
  OperationalResidualExpansionAt := fun material residual =>
    material.GeneratedResidualExpansionAt residual
  generateOperationalResidualExpansionAt := fun material residual =>
    material.generatedResidualExpansion residual
  operationalResidualExpansionDebitAt := fun _material _residual expansion =>
    expansion.finiteNetEnstrophyDebit
  operationalResidualExpansionDebit_nonneg := fun _material _residual
      expansion => expansion.finiteNetEnstrophyDebit_nonneg
  vorticityAt := fun current => current.physical.contact.physicalState
  pressureAt := fun _ => 0
  internalAt := fun _ => PUnit.unit
  zeroInternal := PUnit.unit
  constitutiveStressOf := fun _ _ => 0
  constitutiveStress_zero := fun _ => rfl
  vorticityTangentOf := fun current _ =>
    classicalWholeNSVorticityTangent nu current.physical.contact.physicalState
  action_constitutive := by
    intro current
    rw [nativeFluidConstitutiveVorticityAction_zero, add_zero]
  vorticity_transverse := fun current =>
    wholeRestartPhysicalTransverse current.physical.contact
  vorticity_reality := fun current =>
    wholeRestartPhysicalReality current.physical.contact
  clockAt := fun current => current.physical.nextContact.time.1
  potentialAt := fun current =>
    puncturedWholeVorticityKineticMass current.physical.contact.physicalState
  densityAt := fun current =>
    2 * nu.coeff * successorMeanWholeVorticityDensity current.physical 0
  scaleAt := fun current =>
    wholeRestartCoefficientCeiling current.physical.contact
  clock_pos := fun current => current.physical.nextContact.time_pos
  density_nonneg := fun current =>
    mul_nonneg (mul_nonneg (by norm_num) nu.coeff_pos.le)
      (successorMeanWholeVorticityDensity_nonneg current.physical 0)
  temporal_action := by
    intro current
    have balance :=
      (sourceGeneratedWholeRestartKineticEntropyDefect current.physical 0).balance
    have clockLaw :=
      kineticDefect_eq_clock_mul_nativeDensity current.physical 0
    change
      puncturedWholeVorticityKineticMass current.physical.contact.physicalState -
          puncturedWholeVorticityKineticMass
            current.physical.next.contact.physicalState =
        current.physical.nextContact.time.1 *
          (2 * nu.coeff *
            successorMeanWholeVorticityDensity current.physical 0)
    simpa only [wholeRestartKineticEntropy, wholeRestartKineticDefect,
      wholeRestartNextKineticDissipationPayment, run_zero, run_succ,
      GeneratedWholeRestartCurrent.next] using
      (show
        wholeRestartKineticEntropy current.physical 0 -
            wholeRestartKineticEntropy current.physical 1 =
          (run current.physical 1).contact.time.1 *
            (2 * nu.coeff *
              successorMeanWholeVorticityDensity current.physical 0) by
        rw [← clockLaw]
        linarith [balance])
  PatchAt := fun current =>
    { patch : GeneratedWholeRestartRuntimeCurrent nu // patch = current }
  BoundaryAt := fun _ => ComplexVorticityHilbertState
  initialPatch :=
    ⟨{ physical := initial
       standing := .clear
       cellEffect := generatedWholeRestartStandingCellEffect .clear }, rfl⟩
  advancePatch := fun _ patch =>
    ⟨patch.1.next,
      congrArg GeneratedWholeRestartRuntimeCurrent.next patch.2⟩
  restrictPatch := fun current _ => ⟨current, rfl⟩
  advance_restricts := fun _ patch => Subtype.ext patch.2.symm
  outgoingBoundaryAt := fun _ patch =>
    patch.1.physical.contact.physicalState
  incomingBoundaryAt := fun _ targetPatch =>
    targetPatch.1.physical.initialState
  boundary_commutes := fun _ _ => rfl

def classicalWholeRestartMediumOccurrence
    {nu : Viscosity}
    (initial : GeneratedWholeRestartCurrent nu)
    (stage : Nat) :
    NativeFluidMediumOccurrence
      (classicalWholeRestartMediumSource initial)
      ((classicalWholeRestartMediumSource initial).stateAfter stage) :=
  (classicalWholeRestartMediumSource initial).generateOccurrence _

theorem classicalWholeRestartMediumOccurrence_is_classicalRealizable
    {nu : Viscosity}
    (initial : GeneratedWholeRestartCurrent nu)
    (stage : Nat) :
    (classicalWholeRestartMediumOccurrence initial stage
      ).ClassicalRealizable := by
  change (PUnit.unit : PUnit) = PUnit.unit
  rfl

theorem classicalWholeRestartMediumOccurrence_mediumResidual_eq_zero
    {nu : Viscosity}
    (initial : GeneratedWholeRestartCurrent nu)
    (stage : Nat) :
    (classicalWholeRestartMediumOccurrence initial stage
      ).mediumResidual = 0 :=
  (classicalWholeRestartMediumOccurrence initial stage
    ).mediumResidual_eq_zero_of_classicalRealizable
      (classicalWholeRestartMediumOccurrence_is_classicalRealizable
        initial stage)

end

end ThreeDimensionalVorticityCoefficientNativeFluidMedium
