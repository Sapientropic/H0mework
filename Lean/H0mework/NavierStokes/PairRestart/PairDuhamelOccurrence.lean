/-! ## Integrable complete pair table -/

/-- Every concrete pair vector is continuous on the receipt's actual compact
time carrier. -/
theorem actualWholeContinuousPairVector_continuous
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt ν initialState requestedTime)
    (output first : IntegerWavevector) :
    Continuous fun time : Icc (0 : ℝ) requestedTime =>
      actualWholeContinuousPairVector receipt output first time := by
  unfold actualWholeContinuousPairVector
  exact
    (finiteStateVorticityNonlinearPairContribution_contDiff
      (first, output - first)).continuous.comp
        receipt.wholePath.continuous

/-- Absolute summability of the complete pair-vector table before output
aggregation. -/
theorem summable_norm_actualWholeContinuousPairVector
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt ν initialState requestedTime)
    (output : IntegerWavevector)
    (time : Icc (0 : ℝ) requestedTime) :
    Summable fun first : IntegerWavevector =>
      ‖actualWholeContinuousPairVector
        receipt output first time‖ := by
  simpa [actualWholeContinuousPairVector,
    bilinearPair_self_eq_nonlinearPair] using
    (summable_norm_wholeStateVorticityBilinearPair
      (receipt.wholePath time) (receipt.wholePath time)
      (wholePath_transverse receipt time) output)

/-- Pointwise `ℓ¹` mass of the vector pair table. -/
def actualWholeContinuousPairVectorMass
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt ν initialState requestedTime)
    (output : IntegerWavevector)
    (time : Icc (0 : ℝ) requestedTime) : ℝ :=
  ∑' first : IntegerWavevector,
    ‖actualWholeContinuousPairVector receipt output first time‖

/-- The actual table mass obeys the existing cutoff-independent fixed-output
pair estimate. -/
theorem actualWholeContinuousPairVectorMass_le
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt ν initialState requestedTime)
    (output : IntegerWavevector)
    (time : Icc (0 : ℝ) requestedTime) :
    actualWholeContinuousPairVectorMass receipt output time ≤
      6 * Real.sqrt (integerWaveNormSq output) *
        ‖receipt.wholePath time‖ ^ 2 := by
  calc
    actualWholeContinuousPairVectorMass receipt output time =
        ∑' first : IntegerWavevector,
          ‖finiteStateVorticityBilinearPairContribution
            (receipt.wholePath time) (receipt.wholePath time)
            (first, output - first)‖ := by
      rfl
    _ ≤ 6 * Real.sqrt (integerWaveNormSq output) *
          ‖receipt.wholePath time‖ * ‖receipt.wholePath time‖ :=
      tsum_norm_wholeStateVorticityBilinearPair_le
        (receipt.wholePath time) (receipt.wholePath time)
        (wholePath_transverse receipt time) output
    _ = 6 * Real.sqrt (integerWaveNormSq output) *
          ‖receipt.wholePath time‖ ^ 2 := by ring

theorem actualWholeContinuousPairVectorMass_aestronglyMeasurable
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt ν initialState requestedTime)
    (output : IntegerWavevector) :
    AEStronglyMeasurable
      (actualWholeContinuousPairVectorMass receipt output)
      (commonTimeMeasure requestedTime) := by
  unfold actualWholeContinuousPairVectorMass
  exact
    (AEMeasurable.tsum fun first =>
      (actualWholeContinuousPairVector_continuous
        receipt output first).aestronglyMeasurable.norm.aemeasurable)
      |>.aestronglyMeasurable

/-- Physical `L²_t(ℓ²)` envelope of the same whole path. -/
def actualWholeContinuousPairVectorEnvelope
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt ν initialState requestedTime)
    (output : IntegerWavevector)
    (time : Icc (0 : ℝ) requestedTime) : ℝ :=
  6 * Real.sqrt (integerWaveNormSq output) *
    ‖(receipt.transverseLimit time).1‖ ^ 2

theorem actualWholeContinuousPairVectorEnvelope_integrable
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt ν initialState requestedTime)
    (output : IntegerWavevector) :
    Integrable
      (actualWholeContinuousPairVectorEnvelope receipt output)
      (commonTimeMeasure requestedTime) := by
  have squareIntegrable :
      Integrable
        (fun time : Icc (0 : ℝ) requestedTime =>
          ‖(receipt.transverseLimit time).1‖ ^ 2)
        (commonTimeMeasure requestedTime) :=
    (MeasureTheory.Lp.memLp receipt.transverseLimit).integrable_norm_pow
      (by norm_num)
  refine (squareIntegrable.const_mul
    (6 * Real.sqrt (integerWaveNormSq output))).congr ?_
  filter_upwards with time
  rfl

/-- The complete pre-quotient vector table belongs to `L¹` in actual physical
time. -/
theorem actualWholeContinuousPairVectorMass_integrable
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt ν initialState requestedTime)
    (output : IntegerWavevector) :
    Integrable
      (actualWholeContinuousPairVectorMass receipt output)
      (commonTimeMeasure requestedTime) := by
  apply Integrable.mono'
    (actualWholeContinuousPairVectorEnvelope_integrable receipt output)
    (actualWholeContinuousPairVectorMass_aestronglyMeasurable
      receipt output)
  filter_upwards [receipt.wholePath_eq_transverse_ae] with time pathEq
  rw [Real.norm_eq_abs, abs_of_nonneg]
  · calc
      actualWholeContinuousPairVectorMass receipt output time ≤
          6 * Real.sqrt (integerWaveNormSq output) *
            ‖receipt.wholePath time‖ ^ 2 :=
        actualWholeContinuousPairVectorMass_le receipt output time
      _ = actualWholeContinuousPairVectorEnvelope receipt output time := by
        rw [pathEq]
        rfl
  · exact tsum_nonneg fun first => norm_nonneg _

/-! ## Causal pair occurrences -/

/-- One typed input pair under the same causal heat kernel as the actual
nonlinear Duhamel row. -/
def actualWholeCausalPairVector
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt ν initialState requestedTime)
    (output first : IntegerWavevector)
    (endpoint earlier : Icc (0 : ℝ) requestedTime) :
    ComplexCoordinateVector :=
  finiteStateVorticityHeatMultiplier
      ν.coeff (endpoint.1 - earlier.1) output •
    actualWholeContinuousPairVector receipt output first earlier

theorem actualWholeCausalPairVector_continuous
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt ν initialState requestedTime)
    (output first : IntegerWavevector)
    (endpoint : Icc (0 : ℝ) requestedTime) :
    Continuous fun earlier : Icc (0 : ℝ) requestedTime =>
      actualWholeCausalPairVector
        receipt output first endpoint earlier := by
  have multiplierContinuous :
      Continuous fun earlier : Icc (0 : ℝ) requestedTime =>
        finiteStateVorticityHeatMultiplier
          ν.coeff (endpoint.1 - earlier.1) output := by
    unfold finiteStateVorticityHeatMultiplier
    fun_prop
  exact multiplierContinuous.smul
    (actualWholeContinuousPairVector_continuous
      receipt output first)

/-- On the causal interval the heat factor cannot enlarge a pair occurrence. -/
theorem norm_actualWholeCausalPairVector_le
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt ν initialState requestedTime)
    (output first : IntegerWavevector)
    (endpoint earlier : Icc (0 : ℝ) requestedTime)
    (earlierLe : earlier ≤ endpoint) :
    ‖actualWholeCausalPairVector
        receipt output first endpoint earlier‖ ≤
      ‖actualWholeContinuousPairVector
        receipt output first earlier‖ := by
  have durationNonneg : 0 ≤ endpoint.1 - earlier.1 :=
    sub_nonneg.mpr earlierLe
  have multiplierNonneg :=
    finiteStateVorticityHeatMultiplier_nonneg
      ν.coeff (endpoint.1 - earlier.1) output
  have multiplierLe :=
    finiteStateVorticityHeatMultiplier_le_one
      ν.coeff_pos.le durationNonneg output
  unfold actualWholeCausalPairVector
  rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg multiplierNonneg]
  simpa only [one_mul] using
    mul_le_mul_of_nonneg_right multiplierLe (norm_nonneg _)

/-- One completed causal Duhamel occurrence, integrated while its input-pair
identity is still present. -/
def actualWholePairDuhamelOccurrence
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt ν initialState requestedTime)
    (output first : IntegerWavevector)
    (endpoint : Icc (0 : ℝ) requestedTime) :
    ComplexCoordinateVector :=
  ∫ earlier in Iic endpoint,
    actualWholeCausalPairVector receipt output first endpoint earlier
    ∂(commonTimeMeasure requestedTime)

/-- A nonzero causal Duhamel occurrence is generated at a strictly earlier
physical time on the same receipt.  The endpoint itself is a null time slice,
so it cannot supply a nonzero time-integrated occurrence. -/
theorem
    actualWholePairDuhamelOccurrence_ne_zero_generates_strictEarlier_pairVector
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt ν initialState requestedTime)
    (output first : IntegerWavevector)
    (endpoint : Icc (0 : ℝ) requestedTime)
    (occurrenceNonzero :
      actualWholePairDuhamelOccurrence
        receipt output first endpoint ≠ 0) :
    ∃ earlier : Icc (0 : ℝ) requestedTime,
      earlier < endpoint ∧
        actualWholeContinuousPairVector
          receipt output first earlier ≠ 0 := by
  by_contra noEarlier
  push Not at noEarlier
  apply occurrenceNonzero
  unfold actualWholePairDuhamelOccurrence
  apply MeasureTheory.integral_eq_zero_of_ae
  have endpointSingleton :
      commonTimeMeasure requestedTime {endpoint} = 0 := by
    change
      Measure.comap
          (Subtype.val : Icc (0 : ℝ) requestedTime → ℝ)
          (volume.restrict (Icc (0 : ℝ) requestedTime))
          {endpoint} = 0
    rw [comap_subtype_coe_apply measurableSet_Icc]
    simp
  have aeEndpointNe :
      ∀ᵐ earlier ∂((commonTimeMeasure requestedTime).restrict (Iic endpoint)),
        earlier ≠ endpoint := by
    apply ae_restrict_of_ae
    rw [MeasureTheory.ae_iff]
    simpa only [not_not, setOf_eq_eq_singleton] using endpointSingleton
  filter_upwards [
    ae_restrict_mem measurableSet_Iic,
    aeEndpointNe] with earlier earlierLe earlierNe
  have earlierLt : earlier < endpoint :=
    lt_of_le_of_ne earlierLe earlierNe
  have pairZero :
      actualWholeContinuousPairVector
        receipt output first earlier = 0 :=
    noEarlier earlier earlierLt
  unfold actualWholeCausalPairVector
  rw [pairZero]
  simp

/-- Causal integration commutes with the complete input-pair series. -/
theorem hasSum_actualWholePairDuhamelOccurrence
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt ν initialState requestedTime)
    (output : IntegerWavevector)
    (endpoint : Icc (0 : ℝ) requestedTime) :
    HasSum
      (fun first : IntegerWavevector =>
        actualWholePairDuhamelOccurrence
          receipt output first endpoint)
      (∫ earlier in Iic endpoint,
        ∑' first : IntegerWavevector,
          actualWholeCausalPairVector
            receipt output first endpoint earlier
        ∂(commonTimeMeasure requestedTime)) := by
  apply
    MeasureTheory.hasSum_integral_of_dominated_convergence
      (fun first earlier =>
        ‖actualWholeContinuousPairVector
          receipt output first earlier‖)
      (fun first =>
        (actualWholeCausalPairVector_continuous
          receipt output first endpoint).aestronglyMeasurable)
  · intro first
    filter_upwards [ae_restrict_mem measurableSet_Iic] with
      earlier earlierMem
    exact norm_actualWholeCausalPairVector_le
      receipt output first endpoint earlier earlierMem
  · filter_upwards with earlier
    exact summable_norm_actualWholeContinuousPairVector
      receipt output earlier
  · change Integrable
      (actualWholeContinuousPairVectorMass receipt output)
      ((commonTimeMeasure requestedTime).restrict (Iic endpoint))
    exact
      (actualWholeContinuousPairVectorMass_integrable
        receipt output).integrableOn
  · filter_upwards [ae_restrict_mem measurableSet_Iic] with
      earlier earlierMem
    have normSummable :
        Summable fun first : IntegerWavevector =>
          ‖actualWholeCausalPairVector
            receipt output first endpoint earlier‖ :=
      (summable_norm_actualWholeContinuousPairVector
        receipt output earlier).of_nonneg_of_le
          (fun first => norm_nonneg _)
          (fun first =>
            norm_actualWholeCausalPairVector_le
              receipt output first endpoint earlier earlierMem)
    exact normSummable.of_norm.hasSum

theorem tsum_actualWholePairDuhamelOccurrence_eq_integral
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt ν initialState requestedTime)
    (output : IntegerWavevector)
    (endpoint : Icc (0 : ℝ) requestedTime) :
    (∑' first : IntegerWavevector,
      actualWholePairDuhamelOccurrence
        receipt output first endpoint) =
      ∫ earlier in Iic endpoint,
        ∑' first : IntegerWavevector,
          actualWholeCausalPairVector
            receipt output first endpoint earlier
        ∂(commonTimeMeasure requestedTime) :=
  (hasSum_actualWholePairDuhamelOccurrence
    receipt output endpoint).tsum_eq

/-- The complete causal pair table is exactly the receipt's existing nonlinear
Duhamel row. -/
theorem tsum_actualWholePairDuhamelOccurrence_eq_receiptDuhamel
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt ν initialState requestedTime)
    (output : IntegerWavevector)
    (outputNonzero : output ≠ 0)
    (endpoint : Icc (0 : ℝ) requestedTime) :
    (∑' first : IntegerWavevector,
      actualWholePairDuhamelOccurrence
        receipt output first endpoint) =
      receiptWeightedNonlinearDuhamelAt
        receipt output outputNonzero endpoint := by
  rw [tsum_actualWholePairDuhamelOccurrence_eq_integral,
    receiptWeightedNonlinearDuhamelAt_eq_actual_integral]
  apply integral_congr_ae
  have nonlinearAE :=
    (actualWholeContinuousNonlinearRow_ae_eq receipt output).filter_mono
      (ae_restrict_le (s := Iic endpoint))
  filter_upwards [nonlinearAE] with earlier nonlinearEq
  unfold actualWholeCausalPairVector
  have pairSummable :=
    summable_actualWholeContinuousPairVector
      receipt output earlier
  calc
    (∑' first : IntegerWavevector,
      finiteStateVorticityHeatMultiplier
          ν.coeff (endpoint.1 - earlier.1) output •
        actualWholeContinuousPairVector
          receipt output first earlier) =
        finiteStateVorticityHeatMultiplier
            ν.coeff (endpoint.1 - earlier.1) output •
          (∑' first : IntegerWavevector,
            actualWholeContinuousPairVector
              receipt output first earlier) := by
      exact (pairSummable.hasSum.const_smul
        (finiteStateVorticityHeatMultiplier
          ν.coeff (endpoint.1 - earlier.1) output)).tsum_eq
    _ = finiteStateVorticityHeatMultiplier
          ν.coeff (endpoint.1 - earlier.1) output •
        actualWholeContinuousNonlinearRow
          receipt output earlier.1 := by
      rw [tsum_actualWholeContinuousPairVector_eq_continuousNonlinearRow]
    _ = finiteStateVorticityHeatMultiplier
          ν.coeff (endpoint.1 - earlier.1) output •
        transverseSpaceTimeNonlinearRow
          receipt.transverseLimit output earlier := by
      rw [nonlinearEq]

/-- An endpoint row is either exactly the homogeneous heat transport of the
same receipt's initial row or is generated by a concrete pair interaction at
a strictly earlier physical time.  This retains the exact linear write in the
no-interaction branch instead of weakening it to mere support ancestry. -/
theorem
    sameReceipt_row_eq_heatInitial_or_strictEarlier_pairVector
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt ν initialState requestedTime)
    (output : IntegerWavevector)
    (outputNonzero : output ≠ 0)
    (endpoint : Icc (0 : ℝ) requestedTime) :
    receipt.wholePath endpoint output =
        finiteStateVorticityHeatMultiplier
          ν.coeff endpoint.1 output • initialState output ∨
      ∃ first : IntegerWavevector,
        ∃ earlier : Icc (0 : ℝ) requestedTime,
          earlier < endpoint ∧
            actualWholeContinuousPairVector
              receipt output first earlier ≠ 0 := by
  by_cases duhamelNonzero :
      receiptWeightedNonlinearDuhamelAt
        receipt output outputNonzero endpoint ≠ 0
  · right
    have aggregateNonzero :
        (∑' first : IntegerWavevector,
          actualWholePairDuhamelOccurrence
            receipt output first endpoint) ≠ 0 := by
      rw [tsum_actualWholePairDuhamelOccurrence_eq_receiptDuhamel
        receipt output outputNonzero endpoint]
      exact duhamelNonzero
    have existsFirst :
        ∃ first : IntegerWavevector,
          actualWholePairDuhamelOccurrence
            receipt output first endpoint ≠ 0 := by
      by_contra noFirst
      push Not at noFirst
      apply aggregateNonzero
      have tableZero :
          (fun first : IntegerWavevector =>
            actualWholePairDuhamelOccurrence
              receipt output first endpoint) = 0 := by
        funext first
        exact noFirst first
      rw [tableZero]
      exact tsum_zero
    obtain ⟨first, occurrenceNonzero⟩ := existsFirst
    obtain ⟨earlier, earlierLt, pairNonzero⟩ :=
      actualWholePairDuhamelOccurrence_ne_zero_generates_strictEarlier_pairVector
        receipt output first endpoint occurrenceNonzero
    exact ⟨first, earlier, earlierLt, pairNonzero⟩
  · left
    have duhamelZero :
        receiptWeightedNonlinearDuhamelAt
          receipt output outputNonzero endpoint = 0 :=
      not_ne_iff.mp duhamelNonzero
    have rowSubHeat :=
      wholeContinuousMildSerrinReceipt_row_sub_heat_eq
        receipt output outputNonzero endpoint
    rw [duhamelZero] at rowSubHeat
    exact sub_eq_zero.mp rowSubHeat

/-! ## Actual restart specialization -/

/-- One input-pair contribution to the actual nonlinear regeneration written
by one source-owned whole restart edge. -/
def wholeRestartPairDuhamelOccurrence
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output first : IntegerWavevector) : ComplexCoordinateVector :=
  actualWholePairDuhamelOccurrence
    (run initial index).nextContact.prefixReceipt output first
    ⟨(run initial index).nextContact.time.1,
      ⟨(run initial index).nextContact.time_pos.le, le_rfl⟩⟩

/-- The actual regeneration row is formed only after every typed causal pair
occurrence has been integrated. -/
theorem tsum_wholeRestartPairDuhamelOccurrence_eq_regeneration
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output : IntegerWavevector)
    (outputNonzero : output ≠ 0) :
    (∑' first : IntegerWavevector,
      wholeRestartPairDuhamelOccurrence
        initial index output first) =
      wholeRestartNonlinearRegenerationState
        initial index output := by
  calc
    (∑' first : IntegerWavevector,
      wholeRestartPairDuhamelOccurrence
        initial index output first) =
        receiptWeightedNonlinearDuhamelAt
          (run initial index).nextContact.prefixReceipt
          output outputNonzero
          ⟨(run initial index).nextContact.time.1,
            ⟨(run initial index).nextContact.time_pos.le, le_rfl⟩⟩ :=
      tsum_actualWholePairDuhamelOccurrence_eq_receiptDuhamel
        (run initial index).nextContact.prefixReceipt
        output outputNonzero _
    _ = wholeRestartNonlinearRegenerationState
          initial index output :=
      (wholeRestartNonlinearRegenerationState_apply_eq_actualDuhamel
        initial index output outputNonzero).symm

/-- The obstructing row rate is literally the square of the visible aggregate
of the same causal pair-occurrence table. -/
theorem wholeRestartRegenerationRowRate_eq_pairDuhamelAggregate
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output : IntegerWavevector)
    (outputNonzero : output ≠ 0) :
    ‖wholeRestartNonlinearRegenerationState initial index output‖ ^ 2 /
        (run initial index).nextContact.time.1 =
      ‖∑' first : IntegerWavevector,
        wholeRestartPairDuhamelOccurrence
          initial index output first‖ ^ 2 /
        (run initial index).nextContact.time.1 := by
  rw [tsum_wholeRestartPairDuhamelOccurrence_eq_regeneration
    initial index output outputNonzero]

/-! ## Actual Duhamel pair-occurrence residual process -/

/-- Complete output-by-input-pair table after causal integration but before
Fourier pair aggregation. -/
abbrev WholeRestartPairDuhamelTable :=
  IntegerWavevector → IntegerWavevector → ComplexCoordinateVector

/-- The pair-Duhamel table generated by one actual whole restart receipt. -/
def wholeRestartPairDuhamelTable
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) : WholeRestartPairDuhamelTable :=
  fun output first =>
    wholeRestartPairDuhamelOccurrence initial index output first

@[simp] theorem wholeRestartPairDuhamelTable_apply
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output first : IntegerWavevector) :
    wholeRestartPairDuhamelTable initial index output first =
      wholeRestartPairDuhamelOccurrence initial index output first := by
  rfl

/-- Every fixed-output row of the actual causal table is summable before pair
aggregation. -/
theorem summable_wholeRestartPairDuhamelOccurrence
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output : IntegerWavevector) :
    Summable fun first : IntegerWavevector =>
      wholeRestartPairDuhamelOccurrence initial index output first := by
  exact
    (hasSum_actualWholePairDuhamelOccurrence
      (run initial index).nextContact.prefixReceipt output
      ⟨(run initial index).nextContact.time.1,
        ⟨(run initial index).nextContact.time_pos.le, le_rfl⟩⟩).summable

/-- Terminal `HasSum` form of the same-receipt causal pair formation. -/
theorem hasSum_wholeRestartPairDuhamelOccurrence_eq_regeneration
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output : IntegerWavevector)
    (outputNonzero : output ≠ 0) :
    HasSum
      (fun first : IntegerWavevector =>
        wholeRestartPairDuhamelOccurrence initial index output first)
      (wholeRestartNonlinearRegenerationState initial index output) := by
  rw [← tsum_wholeRestartPairDuhamelOccurrence_eq_regeneration
    initial index output outputNonzero]
  exact
    (summable_wholeRestartPairDuhamelOccurrence
      initial index output).hasSum

/-- Actual chronological path of complete causal pair-Duhamel tables. -/
def wholeRestartPairDuhamelPathTable
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index stage : ℕ) : WholeRestartPairDuhamelTable :=
  wholeRestartPairDuhamelTable initial (index + stage)

@[simp] theorem wholeRestartPairDuhamelPathTable_zero
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    wholeRestartPairDuhamelPathTable initial index 0 =
      wholeRestartPairDuhamelTable initial index := by
  simp [wholeRestartPairDuhamelPathTable]

/-- Forced componentwise trace between consecutive actual causal pair tables. -/
def wholeRestartPairDuhamelTraceRow
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index stage : ℕ) : WholeRestartPairDuhamelTable :=
  wholeRestartPairDuhamelPathTable initial index stage -
    wholeRestartPairDuhamelPathTable initial index (stage + 1)

/-- Chronological write-back ledger retaining every pre-aggregation Duhamel
pair responsibility. -/
def wholeRestartPairDuhamelTraceLedger
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index steps : ℕ) : List WholeRestartPairDuhamelTable :=
  (List.range steps).reverse.map
    (wholeRestartPairDuhamelTraceRow initial index)

theorem wholeRestartPairDuhamelTraceLedger_succ
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index steps : ℕ) :
    wholeRestartPairDuhamelTraceLedger initial index (steps + 1) =
      wholeRestartPairDuhamelTraceRow initial index steps ::
        wholeRestartPairDuhamelTraceLedger initial index steps := by
  simp [wholeRestartPairDuhamelTraceLedger, List.range_succ]

/-- Future tail of the actual causal pair-Duhamel lineage. -/
abbrev WholeRestartPairDuhamelTail :=
  ℕ → WholeRestartPairDuhamelTable

/-- Forget exactly the causal pair table consumed by the current actual
restart stage. -/
def wholeRestartPairDuhamelTailKeep :
    WholeRestartPairDuhamelTail →ₗ[ℂ] WholeRestartPairDuhamelTail where
  toFun residual offset := residual (offset + 1)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- Actual future causal pair-Duhamel residual beginning at one restart
stage. -/
def wholeRestartPairDuhamelTail
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index stage : ℕ) : WholeRestartPairDuhamelTail :=
  fun offset =>
    wholeRestartPairDuhamelPathTable initial index (stage + offset)

/-- The source-owned whole restart recursion is an effective residual process
on the complete causal `output × input-pair` carrier.  Its update is the
actual next restart and its keep is the chronological tail shift. -/
def generatedWholeRestartPairDuhamelEffectiveProcess
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    EffectiveResidualProcess ℂ WholeRestartPairDuhamelTail ℕ where
  target := 0
  keep := wholeRestartPairDuhamelTailKeep
  residual := wholeRestartPairDuhamelTail initial index
  update := Nat.succ
  residual_transport_law := by
    intro stage
    funext offset
    simp only [wholeRestartPairDuhamelTail,
      wholeRestartPairDuhamelTailKeep,
      LinearMap.coe_mk, AddHom.coe_mk]
    congr 1
    omega

@[simp] theorem generatedWholeRestartPairDuhamelEffectiveProcess_pathState
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index stage steps : ℕ) :
    (generatedWholeRestartPairDuhamelEffectiveProcess
      initial index).pathState stage steps = stage + steps := by
  induction steps with
  | zero => simp
  | succ steps inductionHypothesis =>
      rw [EffectiveResidualProcess.pathState_succ,
        inductionHypothesis]
      rfl

/-- Whole-carrier commuting square for every actual restart stage after causal
pair integration and before pair aggregation. -/
theorem wholeRestartPairDuhamel_transport
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index stage : ℕ) :
    wholeRestartPairDuhamelTail initial index (stage + 1) =
      wholeRestartPairDuhamelTailKeep
        (wholeRestartPairDuhamelTail initial index stage) :=
  (generatedWholeRestartPairDuhamelEffectiveProcess
    initial index).residual_transport_law stage

/-- The generated trace at the head of each tail is exactly the
componentwise causal pair-Duhamel difference of that actual transition. -/
theorem wholeRestartPairDuhamel_trace_head
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index stage : ℕ) :
    linearResidualTrace wholeRestartPairDuhamelTailKeep
          (wholeRestartPairDuhamelTail initial index stage) 0 =
      wholeRestartPairDuhamelTraceRow initial index stage := by
  rfl

/-- Finite-path residual conservation on the complete causal
output-by-input-pair carrier. -/
theorem wholeRestartPairDuhamel_path_split
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index steps : ℕ) :
    wholeRestartPairDuhamelTable initial index =
      wholeRestartPairDuhamelPathTable initial index steps +
        ((generatedWholeRestartPairDuhamelEffectiveProcess
            initial index).pathTrace 0 steps) 0 := by
  have split :=
    (generatedWholeRestartPairDuhamelEffectiveProcess
      initial index).pathTrace_split 0 steps
  rw [generatedWholeRestartPairDuhamelEffectiveProcess_pathState]
    at split
  simpa [generatedWholeRestartPairDuhamelEffectiveProcess,
    wholeRestartPairDuhamelTail,
    wholeRestartPairDuhamelPathTable,
    wholeRestartPairDuhamelTable] using congrFun split 0

/-- A nonzero integrated pair occurrence cannot disappear after any finite
actual restart horizon: it is present in the concrete future Duhamel table or
in the uniquely generated componentwise path trace. -/
theorem wholeRestartPairDuhamelOccurrence_ne_zero_future_or_pathTrace
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output first : IntegerWavevector)
    (steps : ℕ)
    (currentNonzero :
      wholeRestartPairDuhamelOccurrence
        initial index output first ≠ 0) :
    wholeRestartPairDuhamelPathTable
          initial index steps output first ≠ 0 ∨
      ((generatedWholeRestartPairDuhamelEffectiveProcess
          initial index).pathTrace 0 steps) 0 output first ≠ 0 := by
  by_cases futureNonzero :
      wholeRestartPairDuhamelPathTable
        initial index steps output first ≠ 0
  · exact Or.inl futureNonzero
  · right
    intro traceZero
    apply currentNonzero
    have split := congrFun
      (congrFun
        (wholeRestartPairDuhamel_path_split
          initial index steps) output) first
    simp only [Pi.add_apply] at split
    rw [not_ne_iff.mp futureNonzero, traceZero, zero_add] at split
    simpa [wholeRestartPairDuhamelTable] using split

/-- Cancellation of the visible causal aggregate never erases its concrete
input-pair responsibilities.  A nonzero table in the aggregation kernel
contains two distinct nonzero occurrences; one is balanced by the complement
and survives at every finite horizon in the actual future table or generated
path trace. -/
theorem pairDuhamelAggregationKernel_componentwise_nativePathTransport
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output : IntegerWavevector)
    (tableNonzero :
      (fun first : IntegerWavevector =>
        wholeRestartPairDuhamelOccurrence
          initial index output first) ≠ 0)
    (aggregateZero :
      (∑' first : IntegerWavevector,
        wholeRestartPairDuhamelOccurrence
          initial index output first) = 0) :
    ∃ first second : IntegerWavevector,
      first ≠ second ∧
        wholeRestartPairDuhamelOccurrence
            initial index output first ≠ 0 ∧
        wholeRestartPairDuhamelOccurrence
            initial index output second ≠ 0 ∧
        ((∑' other : IntegerWavevector,
            if other = first then 0 else
              wholeRestartPairDuhamelOccurrence
                initial index output other) =
          -wholeRestartPairDuhamelOccurrence
            initial index output first) ∧
        ∀ steps : ℕ,
          wholeRestartPairDuhamelPathTable
                initial index steps output first ≠ 0 ∨
            ((generatedWholeRestartPairDuhamelEffectiveProcess
                initial index).pathTrace 0 steps)
              0 output first ≠ 0 := by
  let table : IntegerWavevector → ComplexCoordinateVector :=
    fun first =>
      wholeRestartPairDuhamelOccurrence initial index output first
  have tableSummable : Summable table :=
    summable_wholeRestartPairDuhamelOccurrence initial index output
  have existsFirst : ∃ first, table first ≠ 0 := by
    by_contra allZero
    push Not at allZero
    apply tableNonzero
    funext first
    exact allZero first
  obtain ⟨first, firstNonzero⟩ := existsFirst
  have aggregateSplit :
      (∑' other : IntegerWavevector, table other) =
        table first +
          ∑' other : IntegerWavevector,
            if other = first then 0 else table other :=
    tableSummable.tsum_eq_add_tsum_ite first
  have complementEq :
      (∑' other : IntegerWavevector,
        if other = first then 0 else table other) = -table first := by
    rw [aggregateZero] at aggregateSplit
    exact eq_neg_of_add_eq_zero_right aggregateSplit.symm
  have complementNonzero :
      (∑' other : IntegerWavevector,
        if other = first then 0 else table other) ≠ 0 := by
    rw [complementEq]
    exact neg_ne_zero.mpr firstNonzero
  have existsSecond :
      ∃ second : IntegerWavevector,
        second ≠ first ∧ table second ≠ 0 := by
    by_contra noSecond
    push Not at noSecond
    apply complementNonzero
    have complementFunctionZero :
        (fun second : IntegerWavevector =>
          if second = first then 0 else table second) = 0 := by
      funext second
      split_ifs with secondEq
      · rfl
      · exact noSecond second secondEq
    rw [complementFunctionZero]
    exact tsum_zero
  obtain ⟨second, secondNeFirst, secondNonzero⟩ := existsSecond
  refine ⟨first, second, secondNeFirst.symm, firstNonzero,
    secondNonzero, complementEq, ?_⟩
  intro steps
  exact
    wholeRestartPairDuhamelOccurrence_ne_zero_future_or_pathTrace
      initial index output first steps firstNonzero

/-- One nonzero actual pair-Duhamel occurrence is consumed before input-pair
aggregation.  A source-generated quarter of its square remains in the
visible aggregate, or the same occurrence is retained through every
future/path-trace split. -/
theorem
    wholeRestartPairDuhamelOccurrence_normSq_quarter_le_visible_or_nativePathTransport
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output first : IntegerWavevector)
    (occurrenceNonzero :
      wholeRestartPairDuhamelOccurrence
        initial index output first ≠ 0) :
    ‖wholeRestartPairDuhamelOccurrence
        initial index output first‖ ^ 2 / 4 ≤
        ‖∑' other : IntegerWavevector,
          wholeRestartPairDuhamelOccurrence
            initial index output other‖ ^ 2 ∨
      (‖∑' other : IntegerWavevector,
          wholeRestartPairDuhamelOccurrence
            initial index output other‖ ^ 2 <
          ‖wholeRestartPairDuhamelOccurrence
            initial index output first‖ ^ 2 / 4 ∧
        ∀ steps : ℕ,
          wholeRestartPairDuhamelPathTable
                initial index steps output first ≠ 0 ∨
            ((generatedWholeRestartPairDuhamelEffectiveProcess
                initial index).pathTrace 0 steps)
              0 output first ≠ 0) := by
  by_cases visibleLarge :
      ‖wholeRestartPairDuhamelOccurrence
          initial index output first‖ ^ 2 / 4 ≤
        ‖∑' other : IntegerWavevector,
          wholeRestartPairDuhamelOccurrence
            initial index output other‖ ^ 2
  · exact Or.inl visibleLarge
  · exact Or.inr
      ⟨lt_of_not_ge visibleLarge,
        fun steps =>
          wholeRestartPairDuhamelOccurrence_ne_zero_future_or_pathTrace
            initial index output first steps occurrenceNonzero⟩

/-- Exact rate-level visible/kernel split with no uniform quantum and no
caller-supplied branch.  For every nonzero output, the actual causal pair
table is identically zero, its visible aggregate pays a strictly positive
regeneration row rate, or a concrete aggregation-kernel component is carried
by every finite future/trace prefix. -/
theorem wholeRestartPairDuhamel_zero_or_positiveRate_or_nativePathTransport
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output : IntegerWavevector)
    (outputNonzero : output ≠ 0) :
    (fun first : IntegerWavevector =>
        wholeRestartPairDuhamelOccurrence
          initial index output first) = 0 ∨
      0 <
        ‖wholeRestartNonlinearRegenerationState
            initial index output‖ ^ 2 /
          (run initial index).nextContact.time.1 ∨
      ∃ first second : IntegerWavevector,
        first ≠ second ∧
          wholeRestartPairDuhamelOccurrence
              initial index output first ≠ 0 ∧
          wholeRestartPairDuhamelOccurrence
              initial index output second ≠ 0 ∧
          ((∑' other : IntegerWavevector,
              if other = first then 0 else
                wholeRestartPairDuhamelOccurrence
                  initial index output other) =
            -wholeRestartPairDuhamelOccurrence
              initial index output first) ∧
          ∀ steps : ℕ,
            wholeRestartPairDuhamelPathTable
                  initial index steps output first ≠ 0 ∨
              ((generatedWholeRestartPairDuhamelEffectiveProcess
                  initial index).pathTrace 0 steps)
                0 output first ≠ 0 := by
  by_cases tableZero :
      (fun first : IntegerWavevector =>
        wholeRestartPairDuhamelOccurrence
          initial index output first) = 0
  · exact Or.inl tableZero
  · right
    by_cases aggregateZero :
        (∑' first : IntegerWavevector,
          wholeRestartPairDuhamelOccurrence
            initial index output first) = 0
    · exact Or.inr
        (pairDuhamelAggregationKernel_componentwise_nativePathTransport
          initial index output tableZero aggregateZero)
    · left
      rw [wholeRestartRegenerationRowRate_eq_pairDuhamelAggregate
        initial index output outputNonzero]
      exact div_pos
        (sq_pos_of_pos (norm_pos_iff.mpr aggregateZero))
        (run initial index).nextContact.time_pos

end

