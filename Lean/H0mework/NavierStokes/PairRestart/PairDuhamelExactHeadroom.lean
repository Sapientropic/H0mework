/-! ## Source-owned exact causal payment -/

/-- Exact causal heat headroom after division by the same actual receipt
duration.  It is generated by the receipt; no scale or smallness parameter is
accepted from a caller. -/
def wholeRestartExactCausalRateHeadroom
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output : IntegerWavevector) : ℝ :=
  ((2 * ν.coeff)⁻¹ *
      (1 - Real.exp
        (-(2 * ν.coeff * integerWaveViscousMultiplier output) *
          (run initial index).nextContact.time.1))) /
    (run initial index).nextContact.time.1

theorem wholeRestartExactCausalRateHeadroom_nonneg
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output : IntegerWavevector) :
    0 ≤ wholeRestartExactCausalRateHeadroom initial index output := by
  have multiplierNonneg :
      0 ≤ integerWaveViscousMultiplier output := by
    unfold integerWaveViscousMultiplier
    exact mul_nonneg (sq_nonneg _) (integerWaveNormSq_nonneg output)
  have exponentNonpos :
      -(2 * ν.coeff * integerWaveViscousMultiplier output) *
          (run initial index).nextContact.time.1 ≤ 0 := by
    exact mul_nonpos_of_nonpos_of_nonneg
      (neg_nonpos.mpr
        (mul_nonneg
          (mul_nonneg (by norm_num) ν.coeff_pos.le)
          multiplierNonneg))
      (run initial index).nextContact.time_pos.le
  exact div_nonneg
    (mul_nonneg
      (inv_nonneg.mpr
        (mul_nonneg (by norm_num) ν.coeff_pos.le))
      (sub_nonneg.mpr (Real.exp_le_one_iff.mpr exponentNonpos)))
    (run initial index).nextContact.time_pos.le

/-- The exact factor is bounded by inverse physical time, but it is not
replaced by that coarse majorant in the payment itself. -/
theorem wholeRestartExactCausalRateHeadroom_le_invTime
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output : IntegerWavevector) :
    wholeRestartExactCausalRateHeadroom initial index output ≤
      (2 * ν.coeff)⁻¹ /
        (run initial index).nextContact.time.1 := by
  have exponentialNonneg :
      0 ≤ Real.exp
        (-(2 * ν.coeff * integerWaveViscousMultiplier output) *
          (run initial index).nextContact.time.1) :=
    Real.exp_nonneg _
  have oneSubLe :
      1 - Real.exp
        (-(2 * ν.coeff * integerWaveViscousMultiplier output) *
          (run initial index).nextContact.time.1) ≤ 1 := by
    linarith
  have inverseNonneg : 0 ≤ (2 * ν.coeff)⁻¹ :=
    inv_nonneg.mpr
      (mul_nonneg (show (0 : ℝ) ≤ 2 by norm_num) ν.coeff_pos.le)
  have numeratorLe :
      (2 * ν.coeff)⁻¹ *
          (1 - Real.exp
            (-(2 * ν.coeff * integerWaveViscousMultiplier output) *
              (run initial index).nextContact.time.1)) ≤
        (2 * ν.coeff)⁻¹ := by
    simpa only [mul_one] using
      mul_le_mul_of_nonneg_left oneSubLe inverseNonneg
  unfold wholeRestartExactCausalRateHeadroom
  exact div_le_div_of_nonneg_right
    numeratorLe
    (run initial index).nextContact.time_pos.le

/-- The complementary derivative bound retains the exact output frequency.
Together with `le_invTime`, it exposes the actual low/high scale split without
introducing a cutoff parameter. -/
theorem wholeRestartExactCausalRateHeadroom_le_multiplier
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output : IntegerWavevector) :
    wholeRestartExactCausalRateHeadroom initial index output ≤
      integerWaveViscousMultiplier output := by
  unfold wholeRestartExactCausalRateHeadroom
  exact weightedCausalHeatKernelRateFactor_le_multiplier
    ν.coeff ν.coeff_pos output
    (run initial index).nextContact.time.1
    (run initial index).nextContact.time_pos

theorem wholeRestartExactCausalRateHeadroom_le_min
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output : IntegerWavevector) :
    wholeRestartExactCausalRateHeadroom initial index output ≤
      min (integerWaveViscousMultiplier output)
        ((2 * ν.coeff)⁻¹ /
          (run initial index).nextContact.time.1) := by
  exact le_min
    (wholeRestartExactCausalRateHeadroom_le_multiplier
      initial index output)
    (wholeRestartExactCausalRateHeadroom_le_invTime
      initial index output)

/-- Dimensionless fraction of the visible nonlinear output square retained by
the exact causal rate.  It is defined from the actual receipt's frequency and
duration, not from a caller-selected cutoff. -/
def wholeRestartExactCausalVisibleFraction
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output : IntegerWavevector) : ℝ :=
  wholeRestartExactCausalRateHeadroom initial index output /
    integerWaveViscousMultiplier output

theorem wholeRestartExactCausalVisibleFraction_nonneg
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output : IntegerWavevector) :
    0 ≤ wholeRestartExactCausalVisibleFraction
      initial index output := by
  exact div_nonneg
    (wholeRestartExactCausalRateHeadroom_nonneg initial index output)
    (by
      unfold integerWaveViscousMultiplier
      exact mul_nonneg (sq_nonneg _) (integerWaveNormSq_nonneg output))

/-- On every physical output row the exact causal fraction is at most one. -/
theorem wholeRestartExactCausalVisibleFraction_le_one
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output : IntegerWavevector)
    (outputNonzero : output ≠ 0) :
    wholeRestartExactCausalVisibleFraction initial index output ≤ 1 := by
  apply (div_le_one
    (show 0 < integerWaveViscousMultiplier output by
      unfold integerWaveViscousMultiplier
      exact mul_pos
        (sq_pos_of_pos (mul_pos zero_lt_two Real.pi_pos))
        (integerWaveNormSq_pos outputNonzero))).2
  exact wholeRestartExactCausalRateHeadroom_le_multiplier
    initial index output

theorem wholeRestartExactCausalVisibleFraction_eq
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output : IntegerWavevector)
    (outputNonzero : output ≠ 0) :
    wholeRestartExactCausalVisibleFraction initial index output =
      (1 - Real.exp
        (-(2 * ν.coeff * integerWaveViscousMultiplier output) *
          (run initial index).nextContact.time.1)) /
        (2 * ν.coeff * integerWaveViscousMultiplier output *
          (run initial index).nextContact.time.1) := by
  have multiplierPos :
      0 < integerWaveViscousMultiplier output := by
    unfold integerWaveViscousMultiplier
    exact mul_pos
      (sq_pos_of_pos (mul_pos zero_lt_two Real.pi_pos))
      (integerWaveNormSq_pos outputNonzero)
  unfold wholeRestartExactCausalVisibleFraction
    wholeRestartExactCausalRateHeadroom
  field_simp [ν.coeff_pos.ne', multiplierPos.ne',
    (run initial index).nextContact.time_pos.ne']

/-- Exact visible payment at one output frequency. -/
def wholeRestartExactCausalNonlinearSquareRow
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output : IntegerWavevector) : ℝ :=
  wholeRestartExactCausalRateHeadroom initial index output *
    ‖fixedWaveSpaceTimeRestriction
      (run initial index).nextContact.time.1 output
      (receiptNonlinearNegativeOneState
        (run initial index).nextContact.prefixReceipt)‖ ^ 2

theorem wholeRestartExactCausalNonlinearSquareRow_nonneg
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output : IntegerWavevector) :
    0 ≤ wholeRestartExactCausalNonlinearSquareRow
      initial index output := by
  exact mul_nonneg
    (wholeRestartExactCausalRateHeadroom_nonneg initial index output)
    (sq_nonneg _)

/-- Exact causal rows are spatially summable on every actual receipt.  The
proof uses only that receipt's generated `H⁻¹` state and positive duration. -/
theorem summable_wholeRestartExactCausalNonlinearSquareRow
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    Summable
      (wholeRestartExactCausalNonlinearSquareRow initial index) := by
  let rowSquare : IntegerWavevector → ℝ := fun output =>
    ‖fixedWaveSpaceTimeRestriction
      (run initial index).nextContact.time.1 output
      (receiptNonlinearNegativeOneState
        (run initial index).nextContact.prefixReceipt)‖ ^ 2
  have rowSquareSummable : Summable rowSquare := by
    simpa [rowSquare] using
      summable_fixedWaveSpaceTimeRestriction_norm_sq
        (run initial index).nextContact.time.1
        (receiptNonlinearNegativeOneState
          (run initial index).nextContact.prefixReceipt)
  have majorantSummable :
      Summable fun output : IntegerWavevector =>
        ((2 * ν.coeff)⁻¹ /
          (run initial index).nextContact.time.1) * rowSquare output :=
    rowSquareSummable.mul_left _
  exact majorantSummable.of_nonneg_of_le
    (fun output =>
      wholeRestartExactCausalNonlinearSquareRow_nonneg
        initial index output)
    (fun output => by
      unfold wholeRestartExactCausalNonlinearSquareRow
      exact mul_le_mul_of_nonneg_right
        (wholeRestartExactCausalRateHeadroom_le_invTime
          initial index output)
        (sq_nonneg _))

/-! ## Same-event visible pair payment -/

/-- At every nonzero output, the duration-normalized nonlinear regeneration
is paid by the exact causal row of the same actual receipt. -/
theorem wholeRestartRegenerationRowRate_le_exactCausalNonlinearSquareRow
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output : IntegerWavevector)
    (outputNonzero : output ≠ 0) :
    ‖wholeRestartNonlinearRegenerationState initial index output‖ ^ 2 /
        (run initial index).nextContact.time.1 ≤
      wholeRestartExactCausalNonlinearSquareRow
        initial index output := by
  let contact := (run initial index).nextContact
  let terminal : Icc (0 : ℝ) contact.time.1 :=
    ⟨contact.time.1, ⟨contact.time_pos.le, le_rfl⟩⟩
  have convolutionLe :=
    fixedL2ScalarL2IntegralCLM_weightedCausalHeatKernel_norm_sq_le_exact
      contact.time.1 ν.coeff ν.coeff_pos output outputNonzero
      terminal
      (fixedWaveSpaceTimeRestriction contact.time.1 output
        (receiptNonlinearNegativeOneState contact.prefixReceipt))
  rw [wholeRestartNonlinearRegenerationState_apply_eq_actualDuhamel
    initial index output outputNonzero]
  unfold receiptWeightedNonlinearDuhamelAt
  calc
    ‖fixedL2ScalarL2IntegralCLM contact.time.1
          (weightedCausalHeatKernelL2
            contact.time.1 ν.coeff ν.coeff_pos output
            outputNonzero terminal)
          (fixedWaveSpaceTimeRestriction contact.time.1 output
            (receiptNonlinearNegativeOneState contact.prefixReceipt))‖ ^ 2 /
        contact.time.1 ≤
      (((2 * ν.coeff)⁻¹ *
          (1 - Real.exp
            (-(2 * ν.coeff * integerWaveViscousMultiplier output) *
              terminal.1))) *
        ‖fixedWaveSpaceTimeRestriction contact.time.1 output
          (receiptNonlinearNegativeOneState contact.prefixReceipt)‖ ^ 2) /
        contact.time.1 := by
      exact div_le_div_of_nonneg_right convolutionLe contact.time_pos.le
    _ = wholeRestartExactCausalNonlinearSquareRow
          initial index output := by
      simp only [terminal, contact]
      unfold wholeRestartExactCausalNonlinearSquareRow
      unfold wholeRestartExactCausalRateHeadroom
      ring

/-- Pair formation is consumed before quotient: the visible aggregate square
of the complete causal input-pair row is paid by that same exact causal row. -/
theorem wholeRestartPairDuhamelVisibleRate_le_exactCausalNonlinearSquareRow
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output : IntegerWavevector)
    (outputNonzero : output ≠ 0) :
    ‖∑' first : IntegerWavevector,
        wholeRestartPairDuhamelOccurrence initial index output first‖ ^ 2 /
        (run initial index).nextContact.time.1 ≤
      wholeRestartExactCausalNonlinearSquareRow
        initial index output := by
  rw [tsum_wholeRestartPairDuhamelOccurrence_eq_regeneration
    initial index output outputNonzero]
  exact
    wholeRestartRegenerationRowRate_le_exactCausalNonlinearSquareRow
      initial index output outputNonzero

/-- The exact payment is not an auxiliary provenance norm.  For every
nonzero output it is literally the source-generated fraction of the physical
time integral of the squared visible aggregation of the complete pair table. -/
theorem wholeRestartExactCausalNonlinearSquareRow_eq_visiblePairIntegral
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output : IntegerWavevector)
    (outputNonzero : output ≠ 0) :
    wholeRestartExactCausalNonlinearSquareRow initial index output =
      wholeRestartExactCausalVisibleFraction initial index output *
        ∫ time,
          ‖∑' first : IntegerWavevector,
            actualWholeContinuousPairVector
              (run initial index).nextContact.prefixReceipt
              output first time‖ ^ 2
          ∂(commonTimeMeasure
            (run initial index).nextContact.time.1) := by
  rw [←
    wholeRestartSegmentFrequencyWeightedNonlinearSquareRow_eq_pairTsum_integral
      initial index output outputNonzero]
  unfold wholeRestartExactCausalNonlinearSquareRow
    wholeRestartExactCausalVisibleFraction
    wholeRestartSegmentFrequencyWeightedNonlinearSquareRow
  have multiplierNe :
      integerWaveViscousMultiplier output ≠ 0 := by
    unfold integerWaveViscousMultiplier
    exact mul_ne_zero
      (pow_ne_zero 2 (mul_ne_zero (by norm_num) Real.pi_ne_zero))
      (ne_of_gt (integerWaveNormSq_pos outputNonzero))
  field_simp [multiplierNe]

theorem wholeRestartExactCausalNonlinearSquareRow_le_visiblePairIntegral
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ)
    (output : IntegerWavevector)
    (outputNonzero : output ≠ 0) :
    wholeRestartExactCausalNonlinearSquareRow initial index output ≤
      ∫ time,
        ‖∑' first : IntegerWavevector,
          actualWholeContinuousPairVector
            (run initial index).nextContact.prefixReceipt
            output first time‖ ^ 2
        ∂(commonTimeMeasure
          (run initial index).nextContact.time.1) := by
  rw [wholeRestartExactCausalNonlinearSquareRow_eq_visiblePairIntegral
    initial index output outputNonzero]
  exact mul_le_of_le_one_left
    (integral_nonneg fun _ => sq_nonneg _)
    (wholeRestartExactCausalVisibleFraction_le_one
      initial index output outputNonzero)

/-- A nonzero keep at any finite horizon immediately re-enters the same
actual restart exhaustion.  It either pays a positive visible rate bounded by
the shifted receipt's exact causal row, or yields a concrete aggregation-kernel
component that remains in every later future/trace split. -/
theorem wholeRestartPairDuhamelKeep_positiveExactPayment_or_kernelTransport
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index steps : ℕ)
    (output first : IntegerWavevector)
    (outputNonzero : output ≠ 0)
    (keepNonzero :
      wholeRestartPairDuhamelPathTable
        initial index steps output first ≠ 0) :
    (0 <
        ‖wholeRestartNonlinearRegenerationState
            initial (index + steps) output‖ ^ 2 /
          (run initial (index + steps)).nextContact.time.1 ∧
      ‖wholeRestartNonlinearRegenerationState
            initial (index + steps) output‖ ^ 2 /
          (run initial (index + steps)).nextContact.time.1 ≤
        wholeRestartExactCausalNonlinearSquareRow
          initial (index + steps) output) ∨
      ∃ component : IntegerWavevector,
        (∑' other : IntegerWavevector,
          wholeRestartPairDuhamelOccurrence
            initial (index + steps) output other) = 0 ∧
        wholeRestartPairDuhamelOccurrence
            initial (index + steps) output component ≠ 0 ∧
        ∀ horizon : ℕ,
          wholeRestartPairDuhamelPathTable
                initial (index + steps) horizon output component ≠ 0 ∨
            ((generatedWholeRestartPairDuhamelEffectiveProcess
                initial (index + steps)).pathTrace 0 horizon)
              0 output component ≠ 0 := by
  have shiftedTableNonzero :
      (fun component : IntegerWavevector =>
        wholeRestartPairDuhamelOccurrence
          initial (index + steps) output component) ≠ 0 := by
    intro tableZero
    apply keepNonzero
    simpa [wholeRestartPairDuhamelPathTable,
      wholeRestartPairDuhamelTable] using congrFun tableZero first
  rcases
      wholeRestartPairDuhamel_zero_or_positiveRate_or_nativePathTransport
        initial (index + steps) output outputNonzero with
    tableZero | positiveRate | kernelTransport
  · exact False.elim (shiftedTableNonzero tableZero)
  · exact Or.inl ⟨positiveRate,
      wholeRestartRegenerationRowRate_le_exactCausalNonlinearSquareRow
        initial (index + steps) output outputNonzero⟩
  · rcases kernelTransport with
      ⟨component, complement, componentNeComplement,
        componentNonzero, complementNonzero, complementSum,
        componentTransport⟩
    refine Or.inr ⟨component, ?_, componentNonzero,
      componentTransport⟩
    have aggregateSplit :=
      (summable_wholeRestartPairDuhamelOccurrence
        initial (index + steps) output).tsum_eq_add_tsum_ite component
    calc
      (∑' other : IntegerWavevector,
        wholeRestartPairDuhamelOccurrence
          initial (index + steps) output other) =
          wholeRestartPairDuhamelOccurrence
              initial (index + steps) output component +
            ∑' other : IntegerWavevector,
              if other = component then 0 else
                wholeRestartPairDuhamelOccurrence
                  initial (index + steps) output other :=
        aggregateSplit
      _ = wholeRestartPairDuhamelOccurrence
              initial (index + steps) output component +
            -wholeRestartPairDuhamelOccurrence
              initial (index + steps) output component := by
        rw [complementSum]
      _ = 0 := add_neg_cancel _

/-! ## Complete exact payment and finite-time obstruction -/

/-- Complete exact causal payment of one actual restart receipt. -/
def wholeRestartExactCausalNonlinearSquarePayment
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) : ℝ :=
  ∑' output : IntegerWavevector,
    wholeRestartExactCausalNonlinearSquareRow initial index output

theorem wholeRestartExactCausalNonlinearSquarePayment_nonneg
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    0 ≤ wholeRestartExactCausalNonlinearSquarePayment
      initial index := by
  exact tsum_nonneg fun output =>
    wholeRestartExactCausalNonlinearSquareRow_nonneg
      initial index output

/-- The complete nonlinear regeneration rate is paid by the exact causal
rows with no spatial summability premise in the theorem mouth. -/
theorem wholeRestartNonlinearRegenerationRateSquare_le_exactCausalPayment
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) :
    wholeRestartNonlinearRegenerationRateSquare initial index ≤
      wholeRestartExactCausalNonlinearSquarePayment initial index := by
  let regeneration :=
    wholeRestartNonlinearRegenerationState initial index
  let duration := (run initial index).nextContact.time.1
  have regenerationRowSummable :
      Summable fun output : IntegerWavevector =>
        ‖regeneration output‖ ^ 2 := by
    simpa only [ENNReal.toReal_ofNat, Real.rpow_two] using
      Memℓp.summable (by norm_num) regeneration.2
  have normalizedRegenerationRowSummable :
      Summable fun output : IntegerWavevector =>
        ‖regeneration output‖ ^ 2 / duration :=
    regenerationRowSummable.div_const duration
  have perOutput :
      ∀ output : IntegerWavevector,
        ‖regeneration output‖ ^ 2 / duration ≤
          wholeRestartExactCausalNonlinearSquareRow
            initial index output := by
    intro output
    by_cases outputNonzero : output ≠ 0
    · exact
        wholeRestartRegenerationRowRate_le_exactCausalNonlinearSquareRow
          initial index output outputNonzero
    · have outputZero : output = 0 := not_ne_iff.mp outputNonzero
      subst output
      calc
        ‖regeneration 0‖ ^ 2 / duration = 0 := by
          simp [regeneration]
        _ ≤ wholeRestartExactCausalNonlinearSquareRow
            initial index 0 :=
          wholeRestartExactCausalNonlinearSquareRow_nonneg
            initial index 0
  rw [wholeRestartNonlinearRegenerationRateSquare,
    wholeRestartNonlinearRegenerationNorm]
  rw [show
    ‖wholeRestartNonlinearRegenerationState initial index‖ ^ 2 =
      ∑' output : IntegerWavevector,
        ‖regeneration output‖ ^ 2 by
      simpa [regeneration] using
        (lp.norm_rpow_eq_tsum
          (p := (2 : ℝ≥0∞)) (by norm_num) regeneration)]
  rw [← tsum_div_const]
  exact Summable.tsum_le_tsum perOutput
    normalizedRegenerationRowSummable
    (summable_wholeRestartExactCausalNonlinearSquareRow
      initial index)

/-- Finite accumulated physical time forces nonsummability of the exact
same-receipt causal payments.  The previous spatial-nonsummability side branch
has disappeared: every individual payment is already a genuine convergent
output sum. -/
theorem elapsedTime_bddAbove_forces_exactCausalNonlinearSquarePayment_not_summable
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    ¬ Summable
      (wholeRestartExactCausalNonlinearSquarePayment initial) := by
  intro exactPaymentSummable
  have rateSummable :
      Summable
        (wholeRestartNonlinearRegenerationRateSquare initial) :=
    exactPaymentSummable.of_nonneg_of_le
      (wholeRestartNonlinearRegenerationRateSquare_nonneg initial)
      (fun index =>
        wholeRestartNonlinearRegenerationRateSquare_le_exactCausalPayment
          initial index)
  exact
    (elapsedTime_bddAbove_forces_nonlinearRegenerationRateSquare_not_summable
      initial elapsedBounded) rateSummable

/-- Premise-free physical exhaustion with the exact causal payment as the
single finite-time obstruction. -/
theorem elapsedTime_unbounded_or_exactCausalNonlinearSquarePayment_not_summable
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    ¬ BddAbove (Set.range (elapsedTime initial)) ∨
      ¬ Summable
        (wholeRestartExactCausalNonlinearSquarePayment initial) := by
  by_cases elapsedBounded :
      BddAbove (Set.range (elapsedTime initial))
  · exact Or.inr
      (elapsedTime_bddAbove_forces_exactCausalNonlinearSquarePayment_not_summable
        initial elapsedBounded)
  · exact Or.inl elapsedBounded

end

