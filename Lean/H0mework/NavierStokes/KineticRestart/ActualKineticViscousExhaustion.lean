/-- The canonical kinetic-scale viscous payment on one actual whole receipt.
The inventory and every nonzero denominator are generated by the canonical
punctured frequency cube. -/
def actualWholeKineticViscousPayment
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (radius : ℕ) : ℝ :=
  ∑ wave ∈ wholeRestartModes radius,
    actualWholeRowViscousPayment receipt wave /
      integerWaveViscousMultiplier wave

/-- Finite canonical coefficient mass along the identical actual physical
trajectory. -/
def actualWholeFiniteVorticityDensity
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (radius : ℕ)
    (actual : ℝ) : ℝ :=
  finiteStateVorticityCoefficientEnstrophy
    (wholeRestartModes radius)
    (wholeRestartReceiptPhysicalTrajectory receipt actual)

/-- Complete coefficient mass along the identical actual physical
trajectory. -/
def actualWholeVorticityDensity
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (actual : ℝ) : ℝ :=
  wholeVorticityEuclideanMass
    (wholeRestartReceiptPhysicalTrajectory receipt actual)

private theorem zero_not_mem_wholeRestartModes
    (radius : ℕ) :
    (0 : IntegerWavevector) ∉ wholeRestartModes radius := by
  exact zero_not_mem_puncturedIntegerWaveFrequencyCube radius

/-- Removing the row's generated viscous multiplier recovers exactly the
unweighted row mass accumulated by the same actual receipt. -/
theorem actualWholeRowViscousPayment_div_multiplier_eq
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (wave : IntegerWavevector)
    (waveNonzero : wave ≠ 0) :
    actualWholeRowViscousPayment receipt wave /
        integerWaveViscousMultiplier wave =
      ∫ actual in (0 : ℝ)..requestedTime,
        2 * ν.coeff *
          complexCoordinateAmplitudeSq
            (wholeRestartReceiptPhysicalTrajectory receipt actual wave) := by
  have multiplierNe :
      integerWaveViscousMultiplier wave ≠ 0 :=
    (integerWaveViscousMultiplier_pos
      ⟨wave, waveNonzero⟩).ne'
  unfold actualWholeRowViscousPayment
  rw [dif_neg waveNonzero, ← intervalIntegral.integral_div]
  apply intervalIntegral.integral_congr
  intro actual actualMem
  have actualIn : actual ∈ Icc (0 : ℝ) requestedTime := by
    simpa only [uIcc_of_le receipt.requestedTimePos.le] using actualMem
  have rowEq :
      receipt.rowExtension wave waveNonzero actual =
        wholeRestartReceiptPhysicalTrajectory receipt actual wave := by
    rw [wholeRestartReceiptPhysicalTrajectory,
      projIcc_of_mem receipt.requestedTimePos.le actualIn]
    exact receipt.rowExtension_on_interval
      wave waveNonzero ⟨actual, actualIn⟩
  change
    (2 * complexCoordinateRealInner
        (receipt.rowExtension wave waveNonzero actual)
        ((ν.coeff * integerWaveViscousMultiplier wave) •
          receipt.rowExtension wave waveNonzero actual)) /
        integerWaveViscousMultiplier wave =
      2 * ν.coeff *
        complexCoordinateAmplitudeSq
          (wholeRestartReceiptPhysicalTrajectory receipt actual wave)
  rw [complexCoordinateRealInner_real_smul_right,
    complexCoordinateRealInner_self,
    ← complexCoordinateAmplitudeSq_eq_complexCoordinateVectorNormSq,
    rowEq]
  field_simp [multiplierNe]

/-- A nonzero Fourier row of one actual whole receipt generates a strictly
positive kinetic viscous debit on that same receipt.  The time witness only
observes the existing path; continuity and the fixed positive viscosity
produce the payment. -/
theorem actualWholeRowKineticViscousWork_pos_of_wholePath_ne_zero
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt ν initialState requestedTime)
    (wave : NonzeroIntegerWavevector)
    (time : Icc (0 : ℝ) requestedTime)
    (rowNonzero : receipt.wholePath time wave.1 ≠ 0) :
    0 < actualWholeRowKineticViscousWork receipt wave := by
  let trajectory := wholeRestartReceiptPhysicalTrajectory receipt
  let density : ℝ → ℝ := fun actual =>
    2 * ν.coeff *
      complexCoordinateAmplitudeSq (trajectory actual wave.1)
  have trajectoryContinuous : Continuous trajectory :=
    wholeRestartReceiptPhysicalTrajectory_continuous receipt
  have rowContinuous :
      Continuous (fun actual => trajectory actual wave.1) :=
    (lp.evalCLM ℂ
      (fun _ : IntegerWavevector => ComplexCoordinateVector)
      2 wave.1).continuous.comp trajectoryContinuous
  have densityContinuous : Continuous density := by
    dsimp only [density]
    exact
      continuous_const.mul
        (continuous_complexCoordinateAmplitudeSq.comp rowContinuous)
  have densityNonneg :
      ∀ actual ∈ Icc (0 : ℝ) requestedTime,
        0 ≤ density actual := by
    intro actual _actualMem
    exact mul_nonneg
      (mul_nonneg (by norm_num) ν.coeff_pos.le)
      (complexCoordinateAmplitudeSq_nonneg _)
  have trajectoryAtTime :
      trajectory time.1 wave.1 = receipt.wholePath time wave.1 := by
    dsimp only [trajectory, wholeRestartReceiptPhysicalTrajectory]
    rw [projIcc_of_mem receipt.requestedTimePos.le time.2]
  have witnessAmplitudePositive :
      0 < complexCoordinateAmplitudeSq
        (receipt.wholePath time wave.1) := by
    rw [complexCoordinateAmplitudeSq_eq_complexCoordinateVectorNormSq]
    exact (complexCoordinateVectorNormSq_pos_iff _).2 rowNonzero
  have witnessPositive : 0 < density time.1 := by
    dsimp only [density]
    rw [trajectoryAtTime]
    exact mul_pos (mul_pos (by norm_num) ν.coeff_pos)
      witnessAmplitudePositive
  have integralPositive :
      0 < ∫ actual in (0 : ℝ)..requestedTime, density actual := by
    have strictIntegral :
        (∫ _actual in (0 : ℝ)..requestedTime, 0) <
          ∫ actual in (0 : ℝ)..requestedTime, density actual := by
      apply
        intervalIntegral.integral_lt_integral_of_continuousOn_of_le_of_exists_lt
          receipt.requestedTimePos continuousOn_const
          densityContinuous.continuousOn
      · intro actual actualMem
        exact densityNonneg actual ⟨actualMem.1.le, actualMem.2⟩
      · exact ⟨time.1, time.2, witnessPositive⟩
    simpa using strictIntegral
  unfold actualWholeRowKineticViscousWork
  rw [actualWholeRowViscousPayment_div_multiplier_eq
    receipt wave.1 wave.2]
  exact integralPositive

private theorem actualWholeFiniteVorticityDensity_continuous
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (radius : ℕ) :
    Continuous (actualWholeFiniteVorticityDensity receipt radius) := by
  unfold actualWholeFiniteVorticityDensity
    finiteStateVorticityCoefficientEnstrophy
  apply continuous_finsetSum
  intro wave _waveMem
  exact complexCoordinateAmplitudeSq_continuous.comp
    ((lp.evalCLM ℂ
      (fun _ : IntegerWavevector => ComplexCoordinateVector)
      2 wave).continuous.comp
        (wholeRestartReceiptPhysicalTrajectory_continuous receipt))

private theorem actualWholeVorticityDensity_continuous
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime) :
    Continuous (actualWholeVorticityDensity receipt) := by
  rw [continuous_iff_continuousAt]
  intro actual
  exact tendsto_wholeVorticityEuclideanMass
    (wholeRestartReceiptPhysicalTrajectory_continuous receipt).continuousAt

/-- The canonical normalized row ledger is exactly the finite physical
vorticity payment of the same receipt. -/
theorem actualWholeKineticViscousPayment_eq_intervalIntegral
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (radius : ℕ) :
    actualWholeKineticViscousPayment receipt radius =
      2 * ν.coeff *
        ∫ actual in (0 : ℝ)..requestedTime,
          actualWholeFiniteVorticityDensity receipt radius actual := by
  unfold actualWholeKineticViscousPayment
  have zeroNotMem := zero_not_mem_wholeRestartModes radius
  calc
    (∑ wave ∈ wholeRestartModes radius,
        actualWholeRowViscousPayment receipt wave /
          integerWaveViscousMultiplier wave) =
        ∑ wave ∈ wholeRestartModes radius,
          ∫ actual in (0 : ℝ)..requestedTime,
            2 * ν.coeff *
              complexCoordinateAmplitudeSq
                (wholeRestartReceiptPhysicalTrajectory
                  receipt actual wave) := by
      apply Finset.sum_congr rfl
      intro wave waveMem
      exact actualWholeRowViscousPayment_div_multiplier_eq
        receipt wave (fun waveZero => by
          subst wave
          exact zeroNotMem waveMem)
    _ =
        ∫ actual in (0 : ℝ)..requestedTime,
          ∑ wave ∈ wholeRestartModes radius,
            2 * ν.coeff *
              complexCoordinateAmplitudeSq
                (wholeRestartReceiptPhysicalTrajectory
                  receipt actual wave) := by
      rw [intervalIntegral.integral_finsetSum]
      intro wave _waveMem
      exact
        (continuous_const.mul
          (complexCoordinateAmplitudeSq_continuous.comp
            ((lp.evalCLM ℂ
              (fun _ : IntegerWavevector => ComplexCoordinateVector)
              2 wave).continuous.comp
                (wholeRestartReceiptPhysicalTrajectory_continuous
                  receipt)))).intervalIntegrable _ _
    _ =
        2 * ν.coeff *
          ∫ actual in (0 : ℝ)..requestedTime,
            actualWholeFiniteVorticityDensity
              receipt radius actual := by
      rw [← intervalIntegral.integral_const_mul]
      apply intervalIntegral.integral_congr
      intro actual _actualMem
      unfold actualWholeFiniteVorticityDensity
        finiteStateVorticityCoefficientEnstrophy
      simp only [Finset.mul_sum]

/-- Every canonical normalized viscous payment is nonnegative. -/
theorem actualWholeKineticViscousPayment_nonneg
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (radius : ℕ) :
    0 ≤ actualWholeKineticViscousPayment receipt radius := by
  unfold actualWholeKineticViscousPayment
  have zeroNotMem := zero_not_mem_wholeRestartModes radius
  exact Finset.sum_nonneg fun wave waveMem =>
    div_nonneg
      (actualWholeRowViscousPayment_nonneg receipt wave)
      (integerWaveViscousMultiplier_pos
        ⟨wave, fun waveZero => by
          subst wave
          exact zeroNotMem waveMem⟩).le

private theorem terminal_wholePrefixVorticityMass_eq_intervalIntegral
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime) :
    wholePrefixVorticityMass
        ⟨requestedTime,
          ⟨receipt.requestedTimePos.le, le_rfl⟩⟩
        receipt.stateLimit =
      ∫ actual in (0 : ℝ)..requestedTime,
        actualWholeVorticityDensity receipt actual := by
  let trajectory : ℝ → ComplexVorticityHilbertState :=
    wholeRestartReceiptPhysicalTrajectory receipt
  have trajectoryContinuous : Continuous trajectory :=
    wholeRestartReceiptPhysicalTrajectory_continuous receipt
  have stateLimitEq :
      receipt.stateLimit =
        wholeTrajectorySpaceTimePath requestedTime trajectory
          trajectoryContinuous.continuousOn := by
    rw [← receipt.wholePath_toLp_eq_stateLimit]
    unfold wholeTrajectorySpaceTimePath
    congr 1
    apply BoundedContinuousFunction.ext
    intro actual
    change
      receipt.wholePath actual =
        wholeRestartReceiptPhysicalTrajectory receipt actual.1
    rw [wholeRestartReceiptPhysicalTrajectory,
      projIcc_of_mem receipt.requestedTimePos.le actual.2]
  rw [stateLimitEq,
    wholePrefixVorticityMass_wholeTrajectorySpaceTimePath_eq_intervalIntegral]
  rfl

/-- A canonical finite payment is bounded by the complete receipt payment
on the identical physical interval. -/
theorem actualWholeKineticViscousPayment_le_full
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime)
    (radius : ℕ) :
    actualWholeKineticViscousPayment receipt radius ≤
      2 * ν.coeff *
        wholePrefixVorticityMass
          ⟨requestedTime,
            ⟨receipt.requestedTimePos.le, le_rfl⟩⟩
          receipt.stateLimit := by
  rw [actualWholeKineticViscousPayment_eq_intervalIntegral,
    terminal_wholePrefixVorticityMass_eq_intervalIntegral]
  apply mul_le_mul_of_nonneg_left _
    (mul_nonneg (by norm_num) ν.coeff_pos.le)
  refine intervalIntegral.integral_mono_on
    (μ := volume) (a := 0) (b := requestedTime)
    (hab := receipt.requestedTimePos.le)
    (hf := (actualWholeFiniteVorticityDensity_continuous
      receipt radius).intervalIntegrable 0 requestedTime)
    (hg := (actualWholeVorticityDensity_continuous
      receipt).intervalIntegrable 0 requestedTime) ?_
  intro actual _actualMem
  exact finiteStateVorticityCoefficientEnstrophy_le_wholeMass
    (wholeRestartModes radius)
    (wholeRestartReceiptPhysicalTrajectory receipt actual)

/-- Canonical source-owned inventories exhaust the complete kinetic viscous
payment of one actual whole mild receipt. -/
theorem actualWholeKineticViscousPayment_tendsto_full
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime) :
    Tendsto
      (actualWholeKineticViscousPayment receipt)
      atTop
      (𝓝
        (2 * ν.coeff *
          wholePrefixVorticityMass
            ⟨requestedTime,
              ⟨receipt.requestedTimePos.le, le_rfl⟩⟩
            receipt.stateLimit)) := by
  have integralTendsto :
      Tendsto
        (fun radius =>
          ∫ actual in (0 : ℝ)..requestedTime,
            actualWholeFiniteVorticityDensity
              receipt radius actual)
        atTop
        (𝓝
          (∫ actual in (0 : ℝ)..requestedTime,
            actualWholeVorticityDensity receipt actual)) := by
    apply
      intervalIntegral.tendsto_integral_filter_of_dominated_convergence
        (actualWholeVorticityDensity receipt)
    · exact Filter.Eventually.of_forall fun radius =>
        (actualWholeFiniteVorticityDensity_continuous
          receipt radius).aestronglyMeasurable
    · exact Filter.Eventually.of_forall fun radius =>
        Filter.Eventually.of_forall fun actual _actualMem => by
          rw [Real.norm_of_nonneg]
          · exact finiteStateVorticityCoefficientEnstrophy_le_wholeMass
              (wholeRestartModes radius)
              (wholeRestartReceiptPhysicalTrajectory receipt actual)
          · unfold actualWholeFiniteVorticityDensity
              finiteStateVorticityCoefficientEnstrophy
            exact Finset.sum_nonneg fun _wave _waveMem =>
              complexCoordinateAmplitudeSq_nonneg _
    · exact
        (actualWholeVorticityDensity_continuous receipt).intervalIntegrable
          0 requestedTime
    · exact Filter.Eventually.of_forall fun actual _actualMem => by
        have zeroRow :
            wholeRestartReceiptPhysicalTrajectory receipt actual 0 = 0 := by
          unfold wholeRestartReceiptPhysicalTrajectory
          exact receipt.wholePath_zero_row _
        exact finiteRestartInventoryMass_tendsto_wholeMass
          (wholeRestartReceiptPhysicalTrajectory receipt actual)
          zeroRow
  rw [show
      actualWholeKineticViscousPayment receipt =
        (fun radius =>
          2 * ν.coeff *
            ∫ actual in (0 : ℝ)..requestedTime,
              actualWholeFiniteVorticityDensity
                receipt radius actual) by
        funext radius
        exact actualWholeKineticViscousPayment_eq_intervalIntegral
          receipt radius]
  rw [terminal_wholePrefixVorticityMass_eq_intervalIntegral]
  exact tendsto_const_nhds.mul integralTendsto

/-! ## Same-event restriction seam -/

private theorem restrictCommonTimeLp_self
    {E : Type*}
    [NormedAddCommGroup E]
    {p : ℝ≥0∞}
    {requestedTime : ℝ}
    (value : MeasureTheory.Lp E p
      (commonTimeMeasure requestedTime)) :
    restrictCommonTimeLp (le_refl requestedTime) value = value := by
  apply MeasureTheory.Lp.ext
  filter_upwards [
    restrictCommonTimeLp_apply_ae
      (le_refl requestedTime) value] with time restrictedEq
  rw [restrictedEq]
  rfl

/-- Restricting an actual receipt to its source-selected contact preserves
the complete physical payment on that identical interval.  The proof uses
the literal restricted `L²` carrier, without replaying its Fourier rows or
reintegrating the trajectory. -/
theorem prefixReceipt_terminal_wholePrefixVorticityMass_eq
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    {receipt :
      WholeContinuousMildSerrinReceipt
        ν initialState requestedTime}
    (contact : GeneratedPositiveWholeRestartContact receipt) :
    wholePrefixVorticityMass
        ⟨contact.time.1, ⟨contact.time_pos.le, le_rfl⟩⟩
        contact.prefixReceipt.stateLimit =
      wholePrefixVorticityMass contact.time receipt.stateLimit := by
  have prefixStateEq :
      contact.prefixReceipt.stateLimit =
        restrictCommonTimeLp contact.time.2.2 receipt.stateLimit :=
    rfl
  unfold wholePrefixVorticityMass
  rw [restrictCommonTimeLpCLM_apply,
    restrictCommonTimeLpCLM_apply, prefixStateEq,
    restrictCommonTimeLp_self]

private theorem integerWaveNormSq_le_three_mul_radius_sq_of_mem
    (radius : ℕ)
    (wave : IntegerWavevector)
    (waveMem : wave ∈ wholeRestartModes radius) :
    integerWaveNormSq wave ≤ 3 * (radius : ℝ) ^ 2 := by
  have cubeMem : wave ∈ integerWaveFrequencyCube radius :=
    (Finset.mem_erase.mp waveMem).2
  rw [integerWaveFrequencyCube, Fintype.mem_piFinset] at cubeMem
  have h0 := cubeMem (0 : Fin 3)
  have h1 := cubeMem (1 : Fin 3)
  have h2 := cubeMem (2 : Fin 3)
  rw [Finset.mem_Icc] at h0 h1 h2
  have h0r :
      -((radius : ℕ) : ℝ) ≤ (wave (0 : Fin 3) : ℝ) ∧
        (wave (0 : Fin 3) : ℝ) ≤ (radius : ℝ) := by
    exact_mod_cast h0
  have h1r :
      -((radius : ℕ) : ℝ) ≤ (wave (1 : Fin 3) : ℝ) ∧
        (wave (1 : Fin 3) : ℝ) ≤ (radius : ℝ) := by
    exact_mod_cast h1
  have h2r :
      -((radius : ℕ) : ℝ) ≤ (wave (2 : Fin 3) : ℝ) ∧
        (wave (2 : Fin 3) : ℝ) ≤ (radius : ℝ) := by
    exact_mod_cast h2
  have h0sq :
      (wave (0 : Fin 3) : ℝ) ^ 2 ≤ (radius : ℝ) ^ 2 := by
    nlinarith
  have h1sq :
      (wave (1 : Fin 3) : ℝ) ^ 2 ≤ (radius : ℝ) ^ 2 := by
    nlinarith
  have h2sq :
      (wave (2 : Fin 3) : ℝ) ^ 2 ≤ (radius : ℝ) ^ 2 := by
    nlinarith
  rw [integerWaveNormSq]
  norm_num [Fin.sum_univ_succ]
  linarith

private theorem finiteViscousPayment_div_cubeWeight_le_normalized
    {ν : Viscosity}
    {initialState : ComplexVorticityHilbertState}
    {requestedTime : ℝ}
    (receipt :
      WholeContinuousMildSerrinReceipt ν initialState requestedTime)
    (radius : ℕ)
    (radiusPos : 0 < radius)
    (modes : Finset IntegerWavevector)
    (modesSub : modes ⊆ wholeRestartModes radius) :
    actualWholeFiniteViscousPayment receipt modes /
        ((2 * Real.pi) ^ 2 * (3 * (radius : ℝ) ^ 2)) ≤
      ∑ wave ∈ modes,
        actualWholeRowViscousPayment receipt wave /
          integerWaveViscousMultiplier wave := by
  unfold actualWholeFiniteViscousPayment
  rw [Finset.sum_div]
  apply Finset.sum_le_sum
  intro wave waveMem
  have wholeMem := modesSub waveMem
  have waveNe : wave ≠ 0 := fun waveZero => by
    subst wave
    exact zero_not_mem_puncturedIntegerWaveFrequencyCube radius wholeMem
  have multiplierPos : 0 < integerWaveViscousMultiplier wave :=
    integerWaveViscousMultiplier_pos ⟨wave, waveNe⟩
  have cubeWeightPos :
      0 < (2 * Real.pi) ^ 2 * (3 * (radius : ℝ) ^ 2) := by
    positivity
  have multiplierLe :
      integerWaveViscousMultiplier wave ≤
        (2 * Real.pi) ^ 2 * (3 * (radius : ℝ) ^ 2) := by
    unfold integerWaveViscousMultiplier
    exact mul_le_mul_of_nonneg_left
      (integerWaveNormSq_le_three_mul_radius_sq_of_mem
        radius wave wholeMem)
      (sq_nonneg _)
  exact (div_le_div_iff₀ cubeWeightPos multiplierPos).2
    (mul_le_mul_of_nonneg_left multiplierLe
      (actualWholeRowViscousPayment_nonneg receipt wave))

/-- Every finite shell selected inside one canonical cube is charged to the
same actual edge's complete kinetic dissipation, with the exact three-
dimensional cube weight. -/
theorem selected_shellViscousPayment_div_radiusSq_le_nextPayment
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index radius : ℕ)
    (radiusPos : 0 < radius)
    (modes : Finset IntegerWavevector)
    (modesSub : modes ⊆ wholeRestartModes radius) :
    actualWholeFiniteViscousPayment
          (run initial index).nextContact.prefixReceipt modes /
        ((2 * Real.pi) ^ 2 * (3 * (radius : ℝ) ^ 2)) ≤
      wholeRestartNextKineticDissipationPayment initial index := by
  calc
