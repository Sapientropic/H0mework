/-! ## Radius-uniform initial velocity square -/

/-- The canonical mode subtype embeds into the endpoint's nonzero-wave
carrier.  Nonzeroness is generated by the punctured canonical inventory. -/
def wholeRestartVelocityEndpointRetainedWaveEmbedding
    (radius : ℕ) :
    {wave : IntegerWavevector // wave ∈ wholeRestartModes radius} ↪
      NonzeroIntegerWavevector where
  toFun := fun wave =>
    Subtype.mk wave.1 (fun waveZero =>
      zero_not_mem_puncturedIntegerWaveFrequencyCube radius
        (waveZero ▸ wave.2))
  inj' := by
    intro left right equality
    apply Subtype.ext
    exact congrArg
      (fun value : NonzeroIntegerWavevector => value.1) equality

theorem wholeRestartVelocityEndpointFiniteProjection_row_norm_sq
    (radius : ℕ)
    (endpoint : WholeRestartVelocityEndpointState)
    (wave : {wave : IntegerWavevector // wave ∈ wholeRestartModes radius}) :
    complexCoordinateVectorNormSq
        (wholeRestartVelocityEndpointFiniteProjection
          radius endpoint wave.1) =
      ‖endpoint
        (wholeRestartVelocityEndpointRetainedWaveEmbedding radius wave)‖ ^ 2 := by
  let retained :=
    wholeRestartVelocityEndpointRetainedWaveEmbedding radius wave
  have waveNe : wave.1 ≠ 0 := retained.2
  have retainedEq :
      (⟨wave.1, waveNe⟩ : NonzeroIntegerWavevector) = retained := by
    apply Subtype.ext
    rfl
  rw [wholeRestartVelocityEndpointFiniteProjection_apply,
    if_pos wave.2,
    wholeRestartVelocityEndpointCoefficient_of_ne endpoint wave.1 waveNe,
    retainedEq]
  have normIdentity :=
    euclideanCoordinateRow_norm_sq
      (fun coordinate => endpoint retained coordinate)
  rw [complexCoordinateAmplitudeSq_eq_complexCoordinateVectorNormSq]
    at normIdentity
  change
    ‖endpoint retained‖ ^ 2 =
      complexCoordinateVectorNormSq
        (fun coordinate => endpoint retained coordinate)
    at normIdentity
  exact normIdentity.symm

/-- Every canonical finite projected velocity square is paid by the complete
endpoint `ℓ²` norm, with no radius-dependent constant. -/
theorem wholeRestartVelocityEndpointFiniteProjectedSquare_le_norm_sq
    (radius : ℕ)
    (endpoint : WholeRestartVelocityEndpointState) :
    wholeRestartVelocityEndpointFiniteProjectedSquare radius endpoint ≤
      ‖endpoint‖ ^ 2 := by
  let retained :=
    wholeRestartVelocityEndpointRetainedWaveEmbedding radius
  calc
    wholeRestartVelocityEndpointFiniteProjectedSquare radius endpoint =
        ∑ wave :
            ({wave : IntegerWavevector //
              wave ∈ wholeRestartModes radius}),
          complexCoordinateVectorNormSq
            (wholeRestartVelocityEndpointFiniteProjection
              radius endpoint wave.1) := by
      unfold wholeRestartVelocityEndpointFiniteProjectedSquare
      simpa using
        (Finset.sum_attach
          (wholeRestartModes radius)
          (fun wave =>
            complexCoordinateVectorNormSq
              (wholeRestartVelocityEndpointFiniteProjection
                radius endpoint wave))).symm
    _ = ∑ wave :
          ({wave : IntegerWavevector //
            wave ∈ wholeRestartModes radius}),
          ‖endpoint (retained wave)‖ ^ 2 := by
      apply Finset.sum_congr rfl
      intro wave _waveMem
      exact
        wholeRestartVelocityEndpointFiniteProjection_row_norm_sq
          radius endpoint wave
    _ = ∑ wave ∈ Finset.univ.map retained,
          ‖endpoint wave‖ ^ 2 := by
      rw [Finset.sum_map]
    _ ≤ ‖endpoint‖ ^ 2 := by
      simpa only [ENNReal.toReal_ofNat, Real.rpow_two] using
        lp.sum_rpow_le_norm_rpow
          (p := (2 : ℝ≥0∞)) (by norm_num) endpoint
          (Finset.univ.map retained)

/-! ## Radius-uniform physical velocity tail -/

/-- Rows in a finite inventory whose Euclidean frequency square lies above
the source-independent positive floor `(cutoff + 1)^2`. -/
def finiteStateVelocityHighFrequencyModes
    (modes : Finset IntegerWavevector)
    (cutoff : ℕ) : Finset IntegerWavevector :=
  modes.filter fun wave =>
    (((cutoff + 1 : ℕ) : ℝ) ^ 2) ≤ integerWaveNormSq wave

theorem finiteStateVelocityHighFrequencyModes_subset
    (modes : Finset IntegerWavevector)
    (cutoff : ℕ) :
    finiteStateVelocityHighFrequencyModes modes cutoff ⊆ modes :=
  Finset.filter_subset _ _

/-- Complete squared physical velocity carried above one positive frequency
floor.  It is written as twice the conventional kinetic energy so existing
finite Hodge and trajectory calculus apply without a second carrier. -/
def finiteStateVelocityHighFrequencySquare
    (modes : Finset IntegerWavevector)
    (cutoff : ℕ)
    (state : ComplexVorticityHilbertState) : ℝ :=
  2 * finiteStateVorticityKineticEnergy
    (finiteStateVelocityHighFrequencyModes modes cutoff) state

theorem finiteStateVelocityHighFrequencySquare_eq_sum
    (modes : Finset IntegerWavevector)
    (cutoff : ℕ)
    (state : ComplexVorticityHilbertState) :
    finiteStateVelocityHighFrequencySquare modes cutoff state =
      ∑ wave ∈ finiteStateVelocityHighFrequencyModes modes cutoff,
        complexCoordinateVectorNormSq
          (finiteStateVelocityCoefficient state wave) := by
  unfold finiteStateVelocityHighFrequencySquare
    finiteStateVorticityKineticEnergy
  ring

/-- The exact Fourier Hodge weight turns a positive frequency floor times
the velocity tail into a portion of the unweighted vorticity mass. -/
theorem finiteStateVelocityHighFrequencySquare_weighted_le_vorticityMass
    (modes : Finset IntegerWavevector)
    (zeroNotMem : 0 ∉ modes)
    (cutoff : ℕ)
    (state : ComplexVorticityHilbertState)
    (transverse : FiniteStateTransverseOn modes state) :
    (2 * Real.pi) ^ 2 * (((cutoff + 1 : ℕ) : ℝ) ^ 2) *
        finiteStateVelocityHighFrequencySquare modes cutoff state ≤
      finiteStateVorticityMass modes state := by
  let tailModes := finiteStateVelocityHighFrequencyModes modes cutoff
  let weight : ℝ :=
    (2 * Real.pi) ^ 2 * (((cutoff + 1 : ℕ) : ℝ) ^ 2)
  have rowBound :
      ∀ wave ∈ tailModes,
        weight *
            complexCoordinateVectorNormSq
              (finiteStateVelocityCoefficient state wave) ≤
          complexCoordinateVectorNormSq (state wave) := by
    intro wave waveMem
    have waveMemModes : wave ∈ modes :=
      finiteStateVelocityHighFrequencyModes_subset modes cutoff waveMem
    have waveNe : wave ≠ 0 := fun waveZero =>
      zeroNotMem (waveZero ▸ waveMemModes)
    have frequencyFloor :
        (((cutoff + 1 : ℕ) : ℝ) ^ 2) ≤ integerWaveNormSq wave := by
      exact (Finset.mem_filter.mp waveMem).2
    have normSqPos : 0 < integerWaveNormSq wave :=
      integerWaveNormSq_pos waveNe
    have twoPiSqPos : 0 < (2 * Real.pi) ^ 2 := by
      positivity
    have denominatorPos :
        0 < (2 * Real.pi) ^ 2 * integerWaveNormSq wave :=
      mul_pos twoPiSqPos normSqPos
    have weightLeDenominator :
        weight ≤ (2 * Real.pi) ^ 2 * integerWaveNormSq wave := by
      exact mul_le_mul_of_nonneg_left frequencyFloor twoPiSqPos.le
    have vorticityNonneg :
        0 ≤ complexCoordinateVectorNormSq (state wave) :=
      complexCoordinateVectorNormSq_nonneg _
    rw [finiteStateVelocityCoefficient,
      biotSavartVelocityCoefficient_normSq_of_transverse
        wave (state wave) waveNe (transverse wave waveMemModes)]
    calc
      weight *
            (complexCoordinateVectorNormSq (state wave) /
              ((2 * Real.pi) ^ 2 * integerWaveNormSq wave)) ≤
          ((2 * Real.pi) ^ 2 * integerWaveNormSq wave) *
            (complexCoordinateVectorNormSq (state wave) /
              ((2 * Real.pi) ^ 2 * integerWaveNormSq wave)) :=
        mul_le_mul_of_nonneg_right weightLeDenominator
          (div_nonneg vorticityNonneg denominatorPos.le)
      _ = complexCoordinateVectorNormSq (state wave) :=
        mul_div_cancel₀ _ denominatorPos.ne'
  rw [finiteStateVelocityHighFrequencySquare_eq_sum]
  unfold finiteStateVorticityMass
  calc
    weight *
          ∑ wave ∈ tailModes,
            complexCoordinateVectorNormSq
              (finiteStateVelocityCoefficient state wave) =
        ∑ wave ∈ tailModes,
          weight * complexCoordinateVectorNormSq
            (finiteStateVelocityCoefficient state wave) := by
      rw [Finset.mul_sum]
    _ ≤ ∑ wave ∈ tailModes,
          complexCoordinateVectorNormSq (state wave) :=
      Finset.sum_le_sum rowBound
    _ ≤ ∑ wave ∈ modes,
          complexCoordinateVectorNormSq (state wave) := by
      apply Finset.sum_le_sum_of_subset_of_nonneg
        (finiteStateVelocityHighFrequencyModes_subset modes cutoff)
      intro wave _waveMem _waveNotTail
      exact complexCoordinateVectorNormSq_nonneg _

/-! ## Exact prefix ledger on every generated stage -/

namespace GeneratedWholeRestartVelocityEndpointGalerkinStage

/-- Exact kinetic/viscous equality on every actual generated prefix. -/
theorem kineticViscousBalance
    {nu : Viscosity}
    {endpoint : WholeRestartVelocityEndpointState}
    {radius : ℕ}
    (stage : GeneratedWholeRestartVelocityEndpointGalerkinStage
      nu endpoint radius)
    (time : Icc (0 : ℝ) 1) :
    finiteStateVorticityKineticEnergy
          (wholeRestartModes radius) (stage.trajectory time.1) +
        nu.coeff *
          (∫ actual in (0 : ℝ)..time.1,
            finiteStateVorticityMass
              (wholeRestartModes radius) (stage.trajectory actual)) =
      finiteStateVorticityKineticEnergy
        (wholeRestartModes radius) (stage.trajectory 0) := by
  have exactLedger :=
    finiteStateVorticityKineticEnergy_integral_generator
      (wholeRestartModes radius)
      (zero_not_mem_puncturedIntegerWaveFrequencyCube radius)
      (fun _wave waveMem =>
        puncturedIntegerWaveFrequencyCube_waveNeg_mem radius waveMem)
      nu.coeff stage.trajectory 0 time.1 time.2.1
      (fun actual actualMem =>
        (stage.physical actual
          ⟨actualMem.1, actualMem.2.trans time.2.2⟩).1)
      (fun actual actualMem wave _waveMem =>
        (stage.physical actual
          ⟨actualMem.1, actualMem.2.trans time.2.2⟩).2.2.1 wave)
      (fun actual actualMem wave _waveMem =>
        (stage.physical actual
          ⟨actualMem.1, actualMem.2.trans time.2.2⟩).2.2.2 wave)
  rw [intervalIntegral.integral_const_mul] at exactLedger
  linarith

theorem kineticEnergy_nonneg
    {nu : Viscosity}
    {endpoint : WholeRestartVelocityEndpointState}
    {radius : ℕ}
    (stage : GeneratedWholeRestartVelocityEndpointGalerkinStage
      nu endpoint radius)
    (time : ℝ) :
    0 ≤ finiteStateVorticityKineticEnergy
      (wholeRestartModes radius) (stage.trajectory time) := by
  unfold finiteStateVorticityKineticEnergy
  apply mul_nonneg (by norm_num)
  exact Finset.sum_nonneg fun wave _waveMem =>
    complexCoordinateVectorNormSq_nonneg
      (finiteStateVelocityCoefficient (stage.trajectory time) wave)

theorem vorticityMassIntegral_nonneg
    {nu : Viscosity}
    {endpoint : WholeRestartVelocityEndpointState}
    {radius : ℕ}
    (stage : GeneratedWholeRestartVelocityEndpointGalerkinStage
      nu endpoint radius)
    (time : Icc (0 : ℝ) 1) :
    0 ≤
      ∫ actual in (0 : ℝ)..time.1,
        finiteStateVorticityMass
          (wholeRestartModes radius) (stage.trajectory actual) := by
  apply intervalIntegral.integral_nonneg time.2.1
  intro actual _actualMem
  unfold finiteStateVorticityMass
  exact Finset.sum_nonneg fun wave _waveMem =>
    complexCoordinateVectorNormSq_nonneg (stage.trajectory actual wave)

theorem highFrequencySquare_intervalIntegrable
    {nu : Viscosity}
    {endpoint : WholeRestartVelocityEndpointState}
    {radius : ℕ}
    (stage : GeneratedWholeRestartVelocityEndpointGalerkinStage
      nu endpoint radius)
    (cutoff : ℕ)
    (time : Icc (0 : ℝ) 1) :
    IntervalIntegrable
      (fun actual =>
        finiteStateVelocityHighFrequencySquare
          (wholeRestartModes radius) cutoff (stage.trajectory actual))
      volume 0 time.1 := by
  apply ContinuousOn.intervalIntegrable
  rw [uIcc_of_le time.2.1]
  intro actual actualMem
  have actualMemFull : actual ∈ Icc (0 : ℝ) 1 :=
    ⟨actualMem.1, actualMem.2.trans time.2.2⟩
  have energyDerivative :=
    finiteStateVorticityKineticEnergy_hasDerivAt
      (finiteStateVelocityHighFrequencyModes
        (wholeRestartModes radius) cutoff)
      stage.trajectory actual
      (finiteStateVorticityGenerator
        (wholeRestartModes radius) nu.coeff (stage.trajectory actual))
      (stage.physical actual actualMemFull).1
  exact (energyDerivative.const_mul 2).continuousAt.continuousWithinAt

theorem vorticityMass_intervalIntegrable
    {nu : Viscosity}
    {endpoint : WholeRestartVelocityEndpointState}
    {radius : ℕ}
    (stage : GeneratedWholeRestartVelocityEndpointGalerkinStage
      nu endpoint radius)
    (time : Icc (0 : ℝ) 1) :
    IntervalIntegrable
      (fun actual =>
        finiteStateVorticityMass
          (wholeRestartModes radius) (stage.trajectory actual))
      volume 0 time.1 := by
  apply ContinuousOn.intervalIntegrable
  rw [uIcc_of_le time.2.1]
  intro actual actualMem
  have actualMemFull : actual ∈ Icc (0 : ℝ) 1 :=
    ⟨actualMem.1, actualMem.2.trans time.2.2⟩
  exact
    (finiteStateVorticityMass_continuousAt_of_hasDerivAt
      (wholeRestartModes radius) stage.trajectory actual
      (finiteStateVorticityGenerator
        (wholeRestartModes radius) nu.coeff (stage.trajectory actual))
      (stage.physical actual actualMemFull).1).continuousWithinAt

/-- The Hodge frequency weight is retained after integration on the same
actual unforced prefix, uniformly in the outer Galerkin radius. -/
theorem highFrequencySquare_integral_weighted_le_vorticityMassIntegral
    {nu : Viscosity}
    {endpoint : WholeRestartVelocityEndpointState}
    {radius : ℕ}
    (stage : GeneratedWholeRestartVelocityEndpointGalerkinStage
      nu endpoint radius)
    (cutoff : ℕ)
    (time : Icc (0 : ℝ) 1) :
    (2 * Real.pi) ^ 2 * (((cutoff + 1 : ℕ) : ℝ) ^ 2) *
          (∫ actual in (0 : ℝ)..time.1,
            finiteStateVelocityHighFrequencySquare
              (wholeRestartModes radius) cutoff
              (stage.trajectory actual)) ≤
      ∫ actual in (0 : ℝ)..time.1,
        finiteStateVorticityMass
          (wholeRestartModes radius) (stage.trajectory actual) := by
  let weight : ℝ :=
    (2 * Real.pi) ^ 2 * (((cutoff + 1 : ℕ) : ℝ) ^ 2)
  have weightedIntegrable :
      IntervalIntegrable
        (fun actual =>
          weight *
            finiteStateVelocityHighFrequencySquare
              (wholeRestartModes radius) cutoff
              (stage.trajectory actual))
        volume 0 time.1 :=
    (GeneratedWholeRestartVelocityEndpointGalerkinStage.highFrequencySquare_intervalIntegrable
      stage cutoff time).const_mul weight
  have integralLe :=
    intervalIntegral.integral_mono_on time.2.1 weightedIntegrable
      (GeneratedWholeRestartVelocityEndpointGalerkinStage.vorticityMass_intervalIntegrable
        stage time)
      (fun actual actualMem =>
        finiteStateVelocityHighFrequencySquare_weighted_le_vorticityMass
          (wholeRestartModes radius)
          (zero_not_mem_puncturedIntegerWaveFrequencyCube radius)
          cutoff (stage.trajectory actual)
          (fun wave _waveMem =>
            (stage.physical actual
              ⟨actualMem.1, actualMem.2.trans time.2.2⟩).2.2.1 wave))
  rw [intervalIntegral.integral_const_mul] at integralLe
  exact integralLe

end GeneratedWholeRestartVelocityEndpointGalerkinStage

/-! ## Endpoint-indexed radius-uniform receipt -/

/-- Radius-uniform kinetic and viscous payment for a generated endpoint
Galerkin family. -/
structure GeneratedWholeRestartVelocityEndpointUniformKineticViscousLedgerCore
    (nu : Viscosity) where
  family : GeneratedWholeRestartVelocityEndpointGalerkinFamilyCore nu
  kinetic_energy_le :
    ∀ (radius : ℕ) (time : Icc (0 : ℝ) 1),
      finiteStateVorticityKineticEnergy
          (wholeRestartModes radius)
          ((family.stage radius).trajectory time.1) ≤
        (1 / 2 : ℝ) * ‖family.endpointReceipt.velocityEndpoint‖ ^ 2
  viscous_integral_le :
    ∀ (radius : ℕ) (time : Icc (0 : ℝ) 1),
      nu.coeff *
          (∫ actual in (0 : ℝ)..time.1,
            finiteStateVorticityMass
              (wholeRestartModes radius)
              ((family.stage radius).trajectory actual)) ≤
        (1 / 2 : ℝ) * ‖family.endpointReceipt.velocityEndpoint‖ ^ 2
  exact_balance :
    ∀ (radius : ℕ) (time : Icc (0 : ℝ) 1),
      finiteStateVorticityKineticEnergy
            (wholeRestartModes radius)
            ((family.stage radius).trajectory time.1) +
          nu.coeff *
            (∫ actual in (0 : ℝ)..time.1,
              finiteStateVorticityMass
                (wholeRestartModes radius)
                ((family.stage radius).trajectory actual)) =
        finiteStateVorticityKineticEnergy
          (wholeRestartModes radius)
          ((family.stage radius).trajectory 0)
  velocity_highFrequency_integral_le :
    ∀ (radius cutoff : ℕ) (time : Icc (0 : ℝ) 1),
      nu.coeff *
          ((2 * Real.pi) ^ 2 * (((cutoff + 1 : ℕ) : ℝ) ^ 2) *
            (∫ actual in (0 : ℝ)..time.1,
              finiteStateVelocityHighFrequencySquare
                (wholeRestartModes radius) cutoff
                ((family.stage radius).trajectory actual))) ≤
        (1 / 2 : ℝ) * ‖family.endpointReceipt.velocityEndpoint‖ ^ 2

/-- Generate the radius-uniform ledger from an endpoint-indexed Galerkin
family. -/
noncomputable def generatedWholeRestartVelocityEndpointUniformKineticViscousLedgerCore
    {nu : Viscosity}
    (family : GeneratedWholeRestartVelocityEndpointGalerkinFamilyCore nu) :
    GeneratedWholeRestartVelocityEndpointUniformKineticViscousLedgerCore nu := by
  have initialEnergyLe :
      ∀ radius : ℕ,
        finiteStateVorticityKineticEnergy
            (wholeRestartModes radius)
            ((family.stage radius).trajectory 0) ≤
          (1 / 2 : ℝ) *
            ‖family.endpointReceipt.velocityEndpoint‖ ^ 2 := by
    intro radius
    rw [(family.stage radius).initial,
      wholeRestartVelocityEndpointFiniteVorticityInitialState_kineticEnergy
        radius family.endpointReceipt.velocityEndpoint
          family.endpointReceipt.velocityEndpoint_transverse]
    exact mul_le_mul_of_nonneg_left
      (wholeRestartVelocityEndpointFiniteProjectedSquare_le_norm_sq
        radius family.endpointReceipt.velocityEndpoint)
      (by norm_num)
  refine
    { family := family
      kinetic_energy_le := ?_
      viscous_integral_le := ?_
      exact_balance := ?_
      velocity_highFrequency_integral_le := ?_ }
  · intro radius time
    have balance :=
      GeneratedWholeRestartVelocityEndpointGalerkinStage.kineticViscousBalance
        (family.stage radius) time
    have integralNonneg :=
      GeneratedWholeRestartVelocityEndpointGalerkinStage.vorticityMassIntegral_nonneg
        (family.stage radius) time
    have coefficientPos := nu.coeff_pos
    exact le_trans (by nlinarith) (initialEnergyLe radius)
  · intro radius time
    have balance :=
      GeneratedWholeRestartVelocityEndpointGalerkinStage.kineticViscousBalance
        (family.stage radius) time
    have terminalNonneg :=
      GeneratedWholeRestartVelocityEndpointGalerkinStage.kineticEnergy_nonneg
        (family.stage radius) time.1
    exact le_trans (by linarith) (initialEnergyLe radius)
  · intro radius time
    exact
      GeneratedWholeRestartVelocityEndpointGalerkinStage.kineticViscousBalance
        (family.stage radius) time
  · intro radius cutoff time
    have tailLe :=
      GeneratedWholeRestartVelocityEndpointGalerkinStage.highFrequencySquare_integral_weighted_le_vorticityMassIntegral
        (family.stage radius) cutoff time
    have scaledTailLe :=
      mul_le_mul_of_nonneg_left tailLe nu.coeff_pos.le
    have balance :=
      GeneratedWholeRestartVelocityEndpointGalerkinStage.kineticViscousBalance
        (family.stage radius) time
    have terminalNonneg :=
      GeneratedWholeRestartVelocityEndpointGalerkinStage.kineticEnergy_nonneg
        (family.stage radius) time.1
    have viscousLeInitial :
        nu.coeff *
            (∫ actual in (0 : ℝ)..time.1,
              finiteStateVorticityMass
                (wholeRestartModes radius)
                ((family.stage radius).trajectory actual)) ≤
          finiteStateVorticityKineticEnergy
            (wholeRestartModes radius)
            ((family.stage radius).trajectory 0) := by
      linarith
    exact scaledTailLe.trans
      (viscousLeInitial.trans (initialEnergyLe radius))

/-! ## Conditional bounded-time presentation -/

structure GeneratedWholeRestartVelocityEndpointUniformKineticViscousLedger
    {nu : Viscosity}
    (initial : GeneratedWholeRestartCurrent nu)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) where
  family :
    GeneratedWholeRestartVelocityEndpointGalerkinFamily
      initial elapsedBounded
  kinetic_energy_le :
    ∀ (radius : ℕ) (time : Icc (0 : ℝ) 1),
      finiteStateVorticityKineticEnergy
          (wholeRestartModes radius)
          ((family.stage radius).trajectory time.1) ≤
        (1 / 2 : ℝ) * ‖family.endpointReceipt.velocityEndpoint‖ ^ 2
  viscous_integral_le :
    ∀ (radius : ℕ) (time : Icc (0 : ℝ) 1),
      nu.coeff *
          (∫ actual in (0 : ℝ)..time.1,
            finiteStateVorticityMass
              (wholeRestartModes radius)
              ((family.stage radius).trajectory actual)) ≤
        (1 / 2 : ℝ) * ‖family.endpointReceipt.velocityEndpoint‖ ^ 2
  exact_balance :
    ∀ (radius : ℕ) (time : Icc (0 : ℝ) 1),
      finiteStateVorticityKineticEnergy
            (wholeRestartModes radius)
            ((family.stage radius).trajectory time.1) +
          nu.coeff *
            (∫ actual in (0 : ℝ)..time.1,
              finiteStateVorticityMass
                (wholeRestartModes radius)
                ((family.stage radius).trajectory actual)) =
        finiteStateVorticityKineticEnergy
          (wholeRestartModes radius)
          ((family.stage radius).trajectory 0)
  velocity_highFrequency_integral_le :
    ∀ (radius cutoff : ℕ) (time : Icc (0 : ℝ) 1),
      nu.coeff *
          ((2 * Real.pi) ^ 2 * (((cutoff + 1 : ℕ) : ℝ) ^ 2) *
            (∫ actual in (0 : ℝ)..time.1,
              finiteStateVelocityHighFrequencySquare
                (wholeRestartModes radius) cutoff
                ((family.stage radius).trajectory actual))) ≤
        (1 / 2 : ℝ) * ‖family.endpointReceipt.velocityEndpoint‖ ^ 2

/-- Generate the complete radius-uniform kinetic and viscous settlement from
the same bounded whole-restart source.  The endpoint, all radii, all actual
trajectories, and both bounds are internal outputs. -/
noncomputable def
    generatedWholeRestartVelocityEndpointUniformKineticViscousLedger
    {nu : Viscosity}
    (initial : GeneratedWholeRestartCurrent nu)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    GeneratedWholeRestartVelocityEndpointUniformKineticViscousLedger
      initial elapsedBounded := by
  let family :=
    generatedWholeRestartVelocityEndpointGalerkinFamily
      initial elapsedBounded
  let core :=
    generatedWholeRestartVelocityEndpointUniformKineticViscousLedgerCore
      family.toCore
  exact
    { family := family
      kinetic_energy_le := core.kinetic_energy_le
      viscous_integral_le := core.viscous_integral_le
      exact_balance := core.exact_balance
      velocity_highFrequency_integral_le :=
        core.velocity_highFrequency_integral_le }

