          fixedWaveHeatDuhamelValue 1 nu.coeff output
            (generatedVelocityEndpointGalerkinWaveBoundedPath ledger
              (subsequence (refinement index)) output zeroTime)
            (generatedVelocityEndpointGalerkinProjectedNonlinearRowSpaceTimePath
              ledger (subsequence (refinement index)) output)
            time) := by
      filter_upwards [outputEventuallyMem] with index outputMem
      rw [generatedVelocityEndpointGalerkinWaveBoundedPath_eq_wholeState,
        generatedVelocityEndpointGalerkinWaveBoundedPath_eq_wholeState]
