/-! ## Exact finite velocity mild identity -/

private theorem velocityWave_weighted_hasDerivAt
    (ν : ℝ)
    (wave : IntegerWavevector)
    (row forcing : ℝ → ComplexCoordinateVector)
    (time : ℝ)
    (evolves :
      HasDerivAt row
        (forcing time -
          (ν * integerWaveViscousMultiplier wave) • row time)
        time) :
    HasDerivAt
      (fun actual =>
        Real.exp
            ((ν * integerWaveViscousMultiplier wave) * actual) •
          row actual)
      (Real.exp
          ((ν * integerWaveViscousMultiplier wave) * time) •
        forcing time)
      time := by
  let c : ℝ := ν * integerWaveViscousMultiplier wave
  have weightedDerivative :=
    (((hasDerivAt_id time).const_mul c).exp).smul evolves
  dsimp only [id_eq] at weightedDerivative
  have weightedFunction :
      ((fun actual => Real.exp (c * actual)) • row) =
        (fun actual => Real.exp (c * actual) • row actual) := by
    funext actual coordinate
    rfl
  rw [weightedFunction] at weightedDerivative
  rw [show ν * integerWaveViscousMultiplier wave = c by rfl]
    at evolves weightedDerivative ⊢
  simpa only [smul_sub, smul_smul, one_mul, mul_one,
    sub_add_cancel] using weightedDerivative

private theorem velocityWave_mild_identity
    (ν : ℝ)
    (wave : IntegerWavevector)
    (row forcing : ℝ → ComplexCoordinateVector)
    (terminal : ℝ)
    (terminalNonneg : 0 ≤ terminal)
    (evolves :
      ∀ time ∈ Icc (0 : ℝ) terminal,
        HasDerivAt row
          (forcing time -
            (ν * integerWaveViscousMultiplier wave) • row time)
          time)
    (forcingContinuous :
      ContinuousOn forcing (Icc (0 : ℝ) terminal)) :
    row terminal =
      finiteStateVorticityHeatMultiplier ν terminal wave • row 0 +
        ∫ time in (0 : ℝ)..terminal,
          finiteStateVorticityHeatMultiplier ν (terminal - time) wave •
            forcing time := by
  let c : ℝ := ν * integerWaveViscousMultiplier wave
  have integrandContinuous :
      ContinuousOn
        (fun time => Real.exp (c * time) • forcing time)
        (Icc (0 : ℝ) terminal) := by
    exact
      ((Real.continuous_exp.comp
          (continuous_const.mul continuous_id)).continuousOn.smul
        forcingContinuous)
  have integrable :
      IntervalIntegrable
        (fun time => Real.exp (c * time) • forcing time)
        volume 0 terminal :=
    integrandContinuous.intervalIntegrable_of_Icc terminalNonneg
  have integratingFactor :
      (∫ time in (0 : ℝ)..terminal,
          Real.exp (c * time) • forcing time) =
        Real.exp (c * terminal) • row terminal - row 0 := by
    have derivative :
        ∀ time ∈ uIcc (0 : ℝ) terminal,
          HasDerivAt
            (fun actual => Real.exp (c * actual) • row actual)
            (Real.exp (c * time) • forcing time)
            time := by
      intro time timeMem
      apply velocityWave_weighted_hasDerivAt ν wave row forcing time
      apply evolves time
      simpa [uIcc_of_le terminalNonneg] using timeMem
    have fundamental :=
      intervalIntegral.integral_eq_sub_of_hasDerivAt
        derivative integrable
    simpa [c] using fundamental
  have endpointLedger :
      Real.exp (c * terminal) • row terminal =
        (∫ time in (0 : ℝ)..terminal,
          Real.exp (c * time) • forcing time) + row 0 := by
    rw [integratingFactor]
    abel
  have expCancel (x : ℝ) :
      Real.exp (-c * x) * Real.exp (c * x) = 1 := by
    rw [← Real.exp_add]
    have : -c * x + c * x = 0 := by ring
    rw [this, Real.exp_zero]
  have expTransport (time : ℝ) :
      Real.exp (-c * terminal) * Real.exp (c * time) =
        Real.exp (-c * (terminal - time)) := by
    rw [← Real.exp_add]
    congr 1
    ring
  have scaledIntegral :
      Real.exp (-c * terminal) •
          (∫ time in (0 : ℝ)..terminal,
            Real.exp (c * time) • forcing time) =
        ∫ time in (0 : ℝ)..terminal,
          Real.exp (-c * (terminal - time)) • forcing time := by
    rw [← intervalIntegral.integral_smul]
    apply intervalIntegral.integral_congr
    intro time _timeMem
    ext coordinate
    simp only [Pi.smul_apply, Complex.real_smul]
    have transportComplex :
        ((Real.exp (-c * terminal) : ℝ) : ℂ) *
            ((Real.exp (c * time) : ℝ) : ℂ) =
          ((Real.exp (-c * (terminal - time)) : ℝ) : ℂ) := by
      exact_mod_cast expTransport time
    rw [← mul_assoc, transportComplex]
  have scaledLedger := congrArg
    (fun value : ComplexCoordinateVector =>
      Real.exp (-c * terminal) • value)
    endpointLedger
  rw [smul_add, smul_smul, expCancel, one_smul,
    scaledIntegral] at scaledLedger
  simpa [finiteStateVorticityHeatMultiplier, c, sub_zero, add_comm] using
    scaledLedger

/-- Every retained row of the actual generated velocity Galerkin write has
the exact causal heat/Duhamel form with the same whole convection and Leray
projection used by the weak equation. -/
theorem generatedVelocityEndpointGalerkinWholeVelocityWave_mildIdentity
    {nu : Viscosity}
    (ledger : GeneratedWholeRestartVelocityEndpointUniformKineticViscousLedgerCore nu)
    (radius : ℕ)
    (output : IntegerWavevector)
    (outputMem : output ∈ wholeRestartModes radius)
    (time : Icc (0 : ℝ) 1) :
    generatedVelocityEndpointGalerkinWholeState ledger radius time output =
      fixedWaveHeatDuhamelValue 1 nu.coeff output
        (generatedVelocityEndpointGalerkinWholeState ledger radius
          ⟨0, by norm_num⟩ output)
        (generatedVelocityEndpointGalerkinProjectedNonlinearRowSpaceTimePath
          ledger radius output)
        time := by
  let row : ℝ → ComplexCoordinateVector := fun actual =>
    generatedVelocityEndpointGalerkinWholeStateAtTime
      ledger radius actual output
  let forcing : ℝ → ComplexCoordinateVector := fun actual =>
    transverseProjection output
      (wholeStateVelocityNonlinearCoefficientAt
        (generatedVelocityEndpointGalerkinWholeStateAtTime
          ledger radius actual) output)
  have evolves :
      ∀ actual ∈ Icc (0 : ℝ) time.1,
        HasDerivAt row
          (forcing actual -
            (nu.coeff * integerWaveViscousMultiplier output) • row actual)
          actual := by
    intro actual actualMem
    have actualUnit : actual ∈ Icc (0 : ℝ) 1 :=
      ⟨actualMem.1, actualMem.2.trans time.2.2⟩
    simpa [row, forcing,
      generatedVelocityEndpointGalerkinWholeStateAtTime,
      finiteStateWholeVelocity] using
      generatedVelocityEndpointGalerkinWholeVelocityWave_hasDerivAt
        ledger radius ⟨actual, actualUnit⟩ output outputMem
  have velocityContinuous :
      ContinuousOn
        (generatedVelocityEndpointGalerkinWholeStateAtTime ledger radius)
        (Icc (0 : ℝ) time.1) := by
    have velocityContinuousUnit :
        ContinuousOn
          (generatedVelocityEndpointGalerkinWholeStateAtTime ledger radius)
          (Icc (0 : ℝ) 1) := by
      rw [continuousOn_iff_continuous_restrict]
      change Continuous
        (generatedVelocityEndpointGalerkinWholeState ledger radius)
      exact generatedVelocityEndpointGalerkinWholeState_continuous
        ledger radius
    exact velocityContinuousUnit.mono fun actual actualMem =>
      ⟨actualMem.1, actualMem.2.trans time.2.2⟩
  have forcingContinuous :
      ContinuousOn forcing (Icc (0 : ℝ) time.1) := by
    unfold forcing
    exact
      (transverseProjectionCLM output).continuous.comp_continuousOn
        (wholeStateVelocityNonlinearCoefficientAt_comp_continuousOn
          (generatedVelocityEndpointGalerkinWholeStateAtTime ledger radius)
          output 0 time.1 velocityContinuous
          (fun actual _ =>
            generatedVelocityEndpointGalerkinWholeStateAtTime_transverse
              ledger radius actual))
  have mild :=
    velocityWave_mild_identity nu.coeff output row forcing time.1
      time.2.1 evolves forcingContinuous
  have nonlinearAE :=
    generatedVelocityEndpointGalerkinProjectedNonlinearRow_coeFn_ae
      ledger radius output
  have integralEq :
      (∫ actual in (0 : ℝ)..time.1,
          finiteStateVorticityHeatMultiplier
              nu.coeff (time.1 - actual) output • forcing actual) =
        ∫ earlier in Iic time,
          finiteStateVorticityHeatMultiplier
              nu.coeff (time.1 - earlier.1) output •
            generatedVelocityEndpointGalerkinProjectedNonlinearRowSpaceTimePath
              ledger radius output earlier
          ∂(commonTimeMeasure 1) := by
    rw [← commonTime_integral_Iic_eq_intervalIntegral
      1 (by norm_num : (0 : ℝ) ≤ 1) time]
    apply integral_congr_ae
    filter_upwards [ae_restrict_of_ae nonlinearAE] with earlier nonlinearEq
    rw [nonlinearEq]
    rfl
  rw [fixedWaveHeatDuhamelValue, ← integralEq]
  simpa [row, forcing,
    generatedVelocityEndpointGalerkinWholeState] using mild

/-! ## Continuous row generated before the time quotient -/

/-- One actual velocity row as a bounded-continuous path.  The definition is
the coordinate projection of the same finite observation used by the
source-generated Arzelà--Ascoli theorem. -/
noncomputable def generatedVelocityEndpointGalerkinWaveBoundedPath
    {nu : Viscosity}
    (ledger : GeneratedWholeRestartVelocityEndpointUniformKineticViscousLedgerCore nu)
    (radius : ℕ)
    (output : IntegerWavevector) :
    BoundedContinuousFunction (Icc (0 : ℝ) 1) ComplexCoordinateVector := by
  classical
  let observed : Finset IntegerWavevector := {output}
  let coordinate : {wave : IntegerWavevector // wave ∈ observed} :=
    ⟨output, by simp [observed]⟩
  let rowMap :
      BoundedContinuousFunction
          (Icc (0 : ℝ) 1) (FiniteObservedVelocityState observed) →L[ℂ]
        BoundedContinuousFunction
          (Icc (0 : ℝ) 1) ComplexCoordinateVector :=
    (ContinuousLinearMap.proj coordinate).compLeftContinuousBounded
      (Icc (0 : ℝ) 1)
  exact rowMap
    (generatedFiniteObservedVelocityBoundedPath ledger observed radius)

@[simp] theorem generatedVelocityEndpointGalerkinWaveBoundedPath_apply
    {nu : Viscosity}
    (ledger : GeneratedWholeRestartVelocityEndpointUniformKineticViscousLedgerCore nu)
    (radius : ℕ)
    (output : IntegerWavevector)
    (time : Icc (0 : ℝ) 1) :
    generatedVelocityEndpointGalerkinWaveBoundedPath
        ledger radius output time =
      generatedVelocityEndpointGalerkinWavePath
        ledger radius output time := by
  rfl

theorem generatedVelocityEndpointGalerkinWaveBoundedPath_eq_wholeState
    {nu : Viscosity}
    (ledger : GeneratedWholeRestartVelocityEndpointUniformKineticViscousLedgerCore nu)
    (radius : ℕ)
    (output : IntegerWavevector)
    (time : Icc (0 : ℝ) 1) :
    generatedVelocityEndpointGalerkinWaveBoundedPath
        ledger radius output time =
      generatedVelocityEndpointGalerkinWholeState
        ledger radius time output := by
  rw [generatedVelocityEndpointGalerkinWaveBoundedPath_apply]
  by_cases outputMem : output ∈ wholeRestartModes radius
  · simp [generatedVelocityEndpointGalerkinWavePath,
      generatedVelocityEndpointGalerkinWholeState_apply, outputMem]
  · have outputZero :
        (ledger.family.stage radius).trajectory time.1 output = 0 :=
      (ledger.family.stage radius).physical time.1 time.2 |>.2.1
        output outputMem
    simp [generatedVelocityEndpointGalerkinWavePath,
      generatedVelocityEndpointGalerkinWholeState_apply,
      finiteStateVelocityCoefficient, outputMem, outputZero]

/-- Passing one actual continuous row to `L²_t` is exactly the fixed-row
restriction of the complete actual velocity path. -/
theorem generatedVelocityEndpointGalerkinWaveBoundedPath_toLp_eq_fixedWave
    {nu : Viscosity}
    (ledger : GeneratedWholeRestartVelocityEndpointUniformKineticViscousLedgerCore nu)
    (radius : ℕ)
    (output : IntegerWavevector) :
    (BoundedContinuousFunction.toLp 2 (commonTimeMeasure 1) ℂ)
        (generatedVelocityEndpointGalerkinWaveBoundedPath
          ledger radius output) =
      fixedWaveSpaceTimeRestriction 1 output
        (generatedVelocityEndpointGalerkinSpaceTimePath ledger radius) := by
  apply MeasureTheory.Lp.ext
  have rowAE :=
    BoundedContinuousFunction.coeFn_toLp
      (p := (2 : ℝ≥0∞)) (μ := commonTimeMeasure 1) ℂ
      (generatedVelocityEndpointGalerkinWaveBoundedPath
        ledger radius output)
  have restrictionAE :=
    fixedWaveSpaceTimeRestriction_coeFn 1 output
      (generatedVelocityEndpointGalerkinSpaceTimePath ledger radius)
  have wholeAE :=
    BoundedContinuousFunction.coeFn_toLp
      (p := (2 : ℝ≥0∞)) (μ := commonTimeMeasure 1) ℂ
      (generatedVelocityEndpointGalerkinWholeBoundedPath ledger radius)
  filter_upwards [rowAE, restrictionAE, wholeAE] with
    time rowEq restrictionEq wholeEq
  rw [rowEq, restrictionEq]
  change
    generatedVelocityEndpointGalerkinWaveBoundedPath
        ledger radius output time =
      ((BoundedContinuousFunction.toLp 2 (commonTimeMeasure 1) ℂ)
        (generatedVelocityEndpointGalerkinWholeBoundedPath
          ledger radius)) time output
  rw [wholeEq]
  exact generatedVelocityEndpointGalerkinWaveBoundedPath_eq_wholeState
    ledger radius output time

/-- A fixed row's pre-quotient continuous limit together with its exact
initial trace and causal mild law.  The refinement is retained so the row
remains tied to the same source-selected whole-state subsequence. -/
structure GeneratedVelocityEndpointFixedWaveContinuousMildReceipt
    {nu : Viscosity}
    (ledger : GeneratedWholeRestartVelocityEndpointUniformKineticViscousLedgerCore nu)
    (subsequence : ℕ → ℕ)
    (stateLimit : SpaceTimeState 1)
    (nonlinearLimit : IntegerWavevector → NonlinearRowSpaceTimeState 1)
    (output : IntegerWavevector)
    (_outputNe : output ≠ 0) where
  refinement : ℕ → ℕ
  refinement_strictMono : StrictMono refinement
  rowPath :
    BoundedContinuousFunction (Icc (0 : ℝ) 1) ComplexCoordinateVector
  row_tendsto :
    Tendsto
      (fun index =>
        generatedVelocityEndpointGalerkinWaveBoundedPath ledger
          (subsequence (refinement index)) output)
      atTop (𝓝 rowPath)
  row_represents :
    ∀ᵐ time ∂(commonTimeMeasure 1),
      rowPath time =
        fixedWaveSpaceTimeRestriction 1 output stateLimit time
  row_initial :
    rowPath ⟨0, by norm_num⟩ =
      wholeRestartVelocityEndpointCoefficient
        ledger.family.endpointReceipt.velocityEndpoint output
  row_mild_identity :
    ∀ time : Icc (0 : ℝ) 1,
      rowPath time =
        fixedWaveHeatDuhamelValue 1 nu.coeff output
          (wholeRestartVelocityEndpointCoefficient
            ledger.family.endpointReceipt.velocityEndpoint output)
          (wholeVelocityLerayProjectionSpaceTime output
            (nonlinearLimit output))
          time

/-- Strong whole-state convergence, same-subsequence nonlinear convergence,
and finite-observation compactness generate one continuous mild row. -/
theorem exists_generatedVelocityEndpointFixedWaveContinuousMildReceipt
    {nu : Viscosity}
    (ledger : GeneratedWholeRestartVelocityEndpointUniformKineticViscousLedgerCore nu)
    (subsequence : ℕ → ℕ)
    (subsequenceMono : StrictMono subsequence)
    (stateLimit : SpaceTimeState 1)
    (stateTendsto :
      Tendsto
        (fun index =>
          generatedVelocityEndpointGalerkinSpaceTimePath ledger
            (subsequence index))
        atTop (𝓝 stateLimit))
    (nonlinearLimit : IntegerWavevector → NonlinearRowSpaceTimeState 1)
    (nonlinearTendsto :
      ∀ output : IntegerWavevector,
        Tendsto
          (fun index =>
            generatedVelocityEndpointGalerkinWholeNonlinearRowSpaceTimePath
              ledger (subsequence index) output)
          atTop (𝓝 (nonlinearLimit output)))
    (output : IntegerWavevector)
    (outputNe : output ≠ 0) :
    Nonempty
      (GeneratedVelocityEndpointFixedWaveContinuousMildReceipt
        ledger subsequence stateLimit nonlinearLimit output outputNe) := by
  classical
  let observed : Finset IntegerWavevector := {output}
  let coordinate : {wave : IntegerWavevector // wave ∈ observed} :=
    ⟨output, by simp [observed]⟩
  let observedSequence : ℕ →
      BoundedContinuousFunction
        (Icc (0 : ℝ) 1) (FiniteObservedVelocityState observed) :=
    fun index =>
      generatedFiniteObservedVelocityBoundedPath
        ledger observed (subsequence index)
  have observedSequenceMem :
      ∀ index : ℕ,
        observedSequence index ∈
          closure (generatedFiniteObservedVelocityPathFamily
            ledger observed) := by
    intro index
    apply subset_closure
    exact ⟨subsequence index, rfl⟩
  obtain ⟨observedLimit, _observedLimitMem, refinement,
      refinementStrictMono, observedTendsto⟩ :=
    (generatedFiniteObservedVelocityPathFamily_isCompact_closure
      ledger observed).tendsto_subseq observedSequenceMem
  let rowMap :
      BoundedContinuousFunction
          (Icc (0 : ℝ) 1) (FiniteObservedVelocityState observed) →L[ℂ]
        BoundedContinuousFunction
          (Icc (0 : ℝ) 1) ComplexCoordinateVector :=
    (ContinuousLinearMap.proj coordinate).compLeftContinuousBounded
      (Icc (0 : ℝ) 1)
  let rowPath := rowMap observedLimit
  have rowTendsto :
      Tendsto
        (fun index =>
          generatedVelocityEndpointGalerkinWaveBoundedPath ledger
            (subsequence (refinement index)) output)
        atTop (𝓝 rowPath) := by
    have mapped :=
      (rowMap.continuous.tendsto observedLimit).comp observedTendsto
    change
      Tendsto (rowMap ∘ observedSequence ∘ refinement)
        atTop (𝓝 rowPath)
    simpa only [rowPath] using mapped
  have rowSpaceTimeTendsto :
      Tendsto
        (fun index =>
          (BoundedContinuousFunction.toLp 2
            (commonTimeMeasure 1) ℂ)
            (generatedVelocityEndpointGalerkinWaveBoundedPath ledger
              (subsequence (refinement index)) output))
        atTop
        (𝓝 ((BoundedContinuousFunction.toLp 2
          (commonTimeMeasure 1) ℂ) rowPath)) :=
    ((BoundedContinuousFunction.toLp 2
      (commonTimeMeasure 1) ℂ).continuous.tendsto rowPath).comp rowTendsto
  have stateRefinedTendsto :
      Tendsto
        (fun index =>
          generatedVelocityEndpointGalerkinSpaceTimePath ledger
            (subsequence (refinement index)))
        atTop (𝓝 stateLimit) :=
    stateTendsto.comp refinementStrictMono.tendsto_atTop
  have fixedStateRefinedTendsto :
      Tendsto
        (fun index =>
          fixedWaveSpaceTimeRestriction 1 output
            (generatedVelocityEndpointGalerkinSpaceTimePath ledger
              (subsequence (refinement index))))
        atTop
        (𝓝 (fixedWaveSpaceTimeRestriction 1 output stateLimit)) :=
    ((fixedWaveSpaceTimeRestriction 1 output).continuous.tendsto
      stateLimit).comp stateRefinedTendsto
  have rowAsFixedTendsto :
      Tendsto
        (fun index =>
          fixedWaveSpaceTimeRestriction 1 output
            (generatedVelocityEndpointGalerkinSpaceTimePath ledger
              (subsequence (refinement index))))
        atTop
        (𝓝 ((BoundedContinuousFunction.toLp 2
          (commonTimeMeasure 1) ℂ) rowPath)) := by
    simpa only [
      generatedVelocityEndpointGalerkinWaveBoundedPath_toLp_eq_fixedWave]
      using rowSpaceTimeTendsto
  have rowSpaceTimeEq :
      (BoundedContinuousFunction.toLp 2
          (commonTimeMeasure 1) ℂ) rowPath =
        fixedWaveSpaceTimeRestriction 1 output stateLimit :=
    tendsto_nhds_unique rowAsFixedTendsto fixedStateRefinedTendsto
  have rowRepresents :
      ∀ᵐ time ∂(commonTimeMeasure 1),
        rowPath time =
          fixedWaveSpaceTimeRestriction 1 output stateLimit time := by
    have rowAE :=
      BoundedContinuousFunction.coeFn_toLp
        (p := (2 : ℝ≥0∞)) (μ := commonTimeMeasure 1) ℂ rowPath
    rw [rowSpaceTimeEq] at rowAE
    exact rowAE.symm
  have combinedTendsto :
      Tendsto (subsequence ∘ refinement) atTop atTop :=
    subsequenceMono.tendsto_atTop.comp
      refinementStrictMono.tendsto_atTop
  have outputEventuallyMem :
      ∀ᶠ index : ℕ in atTop,
        output ∈ wholeRestartModes
          (subsequence (refinement index)) :=
    combinedTendsto
      (nonzero_integerWave_eventually_mem_puncturedFrequencyCube
        output outputNe)
  let zeroTime : Icc (0 : ℝ) 1 := ⟨0, by norm_num⟩
  let endpointRow : ComplexCoordinateVector :=
    wholeRestartVelocityEndpointCoefficient
      ledger.family.endpointReceipt.velocityEndpoint output
  have actualInitialEventually :
      (fun index =>
        generatedVelocityEndpointGalerkinWaveBoundedPath ledger
          (subsequence (refinement index)) output zeroTime) =ᶠ[atTop]
        (fun _ : ℕ => endpointRow) := by
    filter_upwards [outputEventuallyMem] with index outputMem
    rw [generatedVelocityEndpointGalerkinWaveBoundedPath_eq_wholeState,
      generatedVelocityEndpointGalerkinWholeState_zero,
      wholeRestartVelocityEndpointFiniteProjection_apply,
      if_pos outputMem]
  have actualInitialTendsto :
      Tendsto
        (fun index =>
          generatedVelocityEndpointGalerkinWaveBoundedPath ledger
            (subsequence (refinement index)) output zeroTime)
        atTop (𝓝 endpointRow) :=
    (tendsto_const_nhds.congr' actualInitialEventually.symm)
  have rowInitialTendsto :
      Tendsto
        (fun index =>
          generatedVelocityEndpointGalerkinWaveBoundedPath ledger
            (subsequence (refinement index)) output zeroTime)
        atTop (𝓝 (rowPath zeroTime)) := by
    have evaluated :=
      ((BoundedContinuousFunction.evalCLM ℂ zeroTime).continuous.tendsto
        rowPath).comp rowTendsto
    exact evaluated
  have rowInitial : rowPath zeroTime = endpointRow :=
    tendsto_nhds_unique rowInitialTendsto actualInitialTendsto
  have projectedNonlinearRefinedTendsto :
      Tendsto
        (fun index =>
          generatedVelocityEndpointGalerkinProjectedNonlinearRowSpaceTimePath
            ledger (subsequence (refinement index)) output)
        atTop
        (𝓝 (wholeVelocityLerayProjectionSpaceTime output
          (nonlinearLimit output))) := by
    have nonlinearRefined :=
      (nonlinearTendsto output).comp
        refinementStrictMono.tendsto_atTop
    exact
      ((wholeVelocityLerayProjectionSpaceTime output).continuous.tendsto
        (nonlinearLimit output)).comp nonlinearRefined
  have rowMildIdentity :
      ∀ time : Icc (0 : ℝ) 1,
        rowPath time =
          fixedWaveHeatDuhamelValue 1 nu.coeff output endpointRow
            (wholeVelocityLerayProjectionSpaceTime output
              (nonlinearLimit output)) time := by
    intro time
    have rowValueTendsto :
        Tendsto
          (fun index =>
            generatedVelocityEndpointGalerkinWaveBoundedPath ledger
              (subsequence (refinement index)) output time)
          atTop (𝓝 (rowPath time)) :=
      ((BoundedContinuousFunction.evalCLM ℂ time).continuous.tendsto
        rowPath).comp rowTendsto
    have duhamelTendsto :
        Tendsto
          (fun index =>
            fixedWaveHeatDuhamelValue 1 nu.coeff output
              (generatedVelocityEndpointGalerkinWaveBoundedPath ledger
                (subsequence (refinement index)) output zeroTime)
              (generatedVelocityEndpointGalerkinProjectedNonlinearRowSpaceTimePath
                ledger (subsequence (refinement index)) output)
              time)
          atTop
          (𝓝 (fixedWaveHeatDuhamelValue 1 nu.coeff output endpointRow
            (wholeVelocityLerayProjectionSpaceTime output
              (nonlinearLimit output)) time)) :=
      tendsto_fixedWaveHeatDuhamelValue 1 nu.coeff nu.coeff_pos.le
        output time
        (fun index =>
          generatedVelocityEndpointGalerkinWaveBoundedPath ledger
            (subsequence (refinement index)) output zeroTime)
        (fun index =>
          generatedVelocityEndpointGalerkinProjectedNonlinearRowSpaceTimePath
            ledger (subsequence (refinement index)) output)
        endpointRow
        (wholeVelocityLerayProjectionSpaceTime output
          (nonlinearLimit output))
        actualInitialTendsto projectedNonlinearRefinedTendsto
    have finiteMildEventually :
        (fun index =>
          generatedVelocityEndpointGalerkinWaveBoundedPath ledger
            (subsequence (refinement index)) output time) =ᶠ[atTop]
