/-- The bounded whole-restart source generates one common strong velocity
subsequence and, on every nonzero Fourier row, an actual continuous mild
representative with the source endpoint as its time-zero trace.  Every row
still carries the all-test weak NSE law on the same state and nonlinear
limits.

The individual compactness refinements occur only after the common whole
state and nonlinear limits have been fixed; hence they cannot select a
different PDE future row by row. -/
theorem sourceGeneratedVelocityEndpoint_allNonzeroWaves_continuousMild
    {nu : Viscosity}
    (ledger : GeneratedWholeRestartVelocityEndpointUniformKineticViscousLedgerCore nu) :
    ∃ stateLimit : SpaceTimeState 1,
      stateLimit ∈
          closure
            (generatedVelocityEndpointGalerkinSpaceTimePathFamily ledger) ∧
      ∃ subsequence : ℕ → ℕ,
        StrictMono subsequence ∧
        Tendsto
            (fun index =>
              generatedVelocityEndpointGalerkinSpaceTimePath ledger
                (subsequence index))
            atTop (𝓝 stateLimit) ∧
        ∃ nonlinearLimit :
            IntegerWavevector → NonlinearRowSpaceTimeState 1,
          (∀ output : IntegerWavevector,
            Tendsto
              (fun index =>
                generatedVelocityEndpointGalerkinWholeNonlinearRowSpaceTimePath
                  ledger (subsequence index) output)
              atTop (𝓝 (nonlinearLimit output))) ∧
          (∀ output : IntegerWavevector,
            output ≠ 0 →
              WholeVelocityFixedWaveWeakNSE nu.coeff output stateLimit
                (wholeVelocityLerayProjectionSpaceTime output
                  (nonlinearLimit output))) ∧
          ∀ (output : IntegerWavevector) (outputNe : output ≠ 0),
            Nonempty
              (GeneratedVelocityEndpointFixedWaveContinuousMildReceipt
                ledger subsequence stateLimit nonlinearLimit
                output outputNe) := by
  obtain
      ⟨stateLimit, stateLimitMem, subsequence, subsequenceMono,
        stateTendsto, nonlinearLimit, nonlinearTendsto, weakNSE⟩ :=
    sourceGeneratedVelocityEndpoint_allNonzeroWaves_weakNSE ledger
  refine
    ⟨stateLimit, stateLimitMem, subsequence, subsequenceMono,
      stateTendsto, nonlinearLimit, nonlinearTendsto, weakNSE, ?_⟩
  intro output outputNe
  exact exists_generatedVelocityEndpointFixedWaveContinuousMildReceipt
    ledger subsequence subsequenceMono stateLimit stateTendsto
    nonlinearLimit nonlinearTendsto output outputNe

/-- The enriched source-generated Leray--Hopf core itself generates the
continuous mild representative of every nonzero row.  This is the exact
same-lineage adapter used by the endpoint read/write compiler: no second
whole-state limit or nonlinear family is selected. -/
theorem
    GeneratedWholeRestartVelocityEndpointLerayHopfCoreReceipt.exists_fixedWaveContinuousMildReceipt
    {nu : Viscosity}
    {ledger : GeneratedWholeRestartVelocityEndpointUniformKineticViscousLedgerCore nu}
    (receipt :
      GeneratedWholeRestartVelocityEndpointLerayHopfCoreReceipt ledger)
    (output : IntegerWavevector)
    (outputNe : output ≠ 0) :
    Nonempty
      (GeneratedVelocityEndpointFixedWaveContinuousMildReceipt
        ledger receipt.subsequence receipt.stateLimit
        receipt.nonlinearLimit output outputNe) :=
  exists_generatedVelocityEndpointFixedWaveContinuousMildReceipt
    ledger receipt.subsequence receipt.subsequence_strictMono
    receipt.stateLimit receipt.state_tendsto receipt.nonlinearLimit
    receipt.nonlinear_tendsto output outputNe

/-- Canonical source-owned choice of the continuous mild row attached to one
nonzero endpoint Fourier output. -/
noncomputable def
    GeneratedWholeRestartVelocityEndpointLerayHopfCoreReceipt.fixedWaveContinuousMildReceipt
    {nu : Viscosity}
    {ledger : GeneratedWholeRestartVelocityEndpointUniformKineticViscousLedgerCore nu}
    (receipt :
      GeneratedWholeRestartVelocityEndpointLerayHopfCoreReceipt ledger)
    (output : IntegerWavevector)
    (outputNe : output ≠ 0) :
  GeneratedVelocityEndpointFixedWaveContinuousMildReceipt
      ledger receipt.subsequence receipt.stateLimit
      receipt.nonlinearLimit output outputNe :=
  Classical.choice
    (GeneratedWholeRestartVelocityEndpointLerayHopfCoreReceipt.exists_fixedWaveContinuousMildReceipt
      receipt output outputNe)

end

