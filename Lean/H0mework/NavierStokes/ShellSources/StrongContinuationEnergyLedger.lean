noncomputable section

/-- The actual Fourier carrier on which the viscous Duhamel law has a
nondegenerate frequency multiplier. -/
abbrev NonzeroIntegerWavevector :=
  ↥({ wave : IntegerWavevector | wave ≠ 0 } :
    Set IntegerWavevector)

/-- Euclidean vorticity mass over every actual nonzero integer frequency. -/
def puncturedWholeVorticityEuclideanMass
    (state : ComplexVorticityHilbertState) : ℝ :=
  ∑' wave : NonzeroIntegerWavevector,
    complexCoordinateAmplitudeSq (state wave.1)

theorem summable_puncturedWholeVorticityEuclideanMass
    (state : ComplexVorticityHilbertState) :
    Summable fun wave : NonzeroIntegerWavevector =>
      complexCoordinateAmplitudeSq (state wave.1) := by
  have amplitudeSummable :=
    (summable_vorticityRowAmplitude_sq state).subtype
      { wave : IntegerWavevector | wave ≠ 0 }
  change
    Summable fun wave :
        ↥({ wave : IntegerWavevector | wave ≠ 0 } :
          Set IntegerWavevector) =>
      complexCoordinateAmplitudeSq (state wave.1)
  exact
    amplitudeSummable.congr fun wave => by
      simp only [Function.comp_apply, vorticityRowAmplitude_sq,
        complexCoordinateAmplitudeSq_eq_complexCoordinateVectorNormSq]

section ActualStrongReceipt

variable
    {lineage : GeneratedIntegerShellInfiniteLineage}
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    {θLtOne : θ < 1}
    {criticalMargin :
      ∀ length : ℕ,
        criticalEnstrophyLatticeConstant *
            finiteStateVorticityCoefficientEnstrophy
              (generatedSupport (lineage.current length))
              (generatedComplexVorticityState
                (lineage.current length)
                (generatedSupport (lineage.current length))) ≤
          θ * ν.coeff ^ 2 * (2 * Real.pi) ^ 2}
    {requestedTimePos : 0 < requestedTime}

/--
The exact nonlinear-minus-viscous work generated by one actual nonzero
Fourier row of a strong-continuation receipt.
-/
def actualWaveEnergyWork
    (receipt :
      StrongContinuationReceipt
        lineage ν θ requestedTime θLtOne criticalMargin
        requestedTimePos)
    (wave : NonzeroIntegerWavevector) : ℝ :=
  ∫ time in (0 : ℝ)..requestedTime,
    2 *
      complexCoordinateRealInner
        (WholeContinuousMildReceipt.actualWaveHeatDuhamelPath
          receipt.toWholeContinuousMildReceipt wave.1 time)
        (WholeContinuousMildReceipt.actualWaveNonlinearExtension
            receipt.toWholeContinuousMildReceipt wave.1 time -
          (ν.coeff * integerWaveViscousMultiplier wave.1) •
            WholeContinuousMildReceipt.actualWaveHeatDuhamelPath
              receipt.toWholeContinuousMildReceipt wave.1 time)

/--
Every nonzero-wave work entry is exactly its endpoint Euclidean-energy
increment on the same generated whole path.
-/
theorem actualWaveEnergyWork_eq
    (receipt :
      StrongContinuationReceipt
        lineage ν θ requestedTime θLtOne criticalMargin
        requestedTimePos)
    (wave : NonzeroIntegerWavevector) :
    actualWaveEnergyWork receipt wave =
      complexCoordinateAmplitudeSq
          (receipt.wholePath
            ⟨requestedTime,
              ⟨requestedTimePos.le, le_rfl⟩⟩ wave.1) -
        complexCoordinateAmplitudeSq
          (receipt.initialState wave.1) := by
  exact
    WholeContinuousMildReceipt.actualWave_endpointEnergy_identity
      receipt.toWholeContinuousMildReceipt wave.1 wave.2

/--
Exact finite-prefix energy ledger for an arbitrary generated family of
nonzero integer waves.
-/
theorem finiteWave_endpointEnergy_identity
    (receipt :
      StrongContinuationReceipt
        lineage ν θ requestedTime θLtOne criticalMargin
        requestedTimePos)
    (waves : Finset NonzeroIntegerWavevector) :
    (∑ wave ∈ waves,
        actualWaveEnergyWork receipt wave) =
      (∑ wave ∈ waves,
          complexCoordinateAmplitudeSq
            (receipt.wholePath
              ⟨requestedTime,
                ⟨requestedTimePos.le, le_rfl⟩⟩ wave.1)) -
        ∑ wave ∈ waves,
          complexCoordinateAmplitudeSq
            (receipt.initialState wave.1) := by
  rw [← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro wave waveMem
  exact actualWaveEnergyWork_eq receipt wave

/--
The complete nonzero-wave work is summable.  Summability is generated by
the two actual endpoint states; no analytic work-tail bound is supplied.
-/
theorem summable_actualWaveEnergyWork
    (receipt :
      StrongContinuationReceipt
        lineage ν θ requestedTime θLtOne criticalMargin
        requestedTimePos) :
    Summable (actualWaveEnergyWork receipt) := by
  have terminalSummable :
      Summable fun wave : NonzeroIntegerWavevector =>
        complexCoordinateAmplitudeSq
          (receipt.wholePath
            ⟨requestedTime,
              ⟨requestedTimePos.le, le_rfl⟩⟩ wave.1) :=
    summable_puncturedWholeVorticityEuclideanMass _
  have initialSummable :
      Summable fun wave : NonzeroIntegerWavevector =>
        complexCoordinateAmplitudeSq
          (receipt.initialState wave.1) :=
    summable_puncturedWholeVorticityEuclideanMass _
  exact
    (terminalSummable.sub initialSummable).congr
      (fun wave => (actualWaveEnergyWork_eq receipt wave).symm)

/--
All actual nonzero Fourier rows assemble into one exact whole endpoint
energy identity.

This is a true infinite-carrier conclusion: the left side is the generated
`tsum` of the rowwise nonlinear-minus-viscous work, and the right side is
the change in complete punctured Euclidean vorticity mass.
-/
theorem tsum_actualWaveEnergyWork_eq
    (receipt :
      StrongContinuationReceipt
        lineage ν θ requestedTime θLtOne criticalMargin
        requestedTimePos) :
    (∑' wave : NonzeroIntegerWavevector,
        actualWaveEnergyWork receipt wave) =
      puncturedWholeVorticityEuclideanMass
          (receipt.wholePath
            ⟨requestedTime,
              ⟨requestedTimePos.le, le_rfl⟩⟩) -
        puncturedWholeVorticityEuclideanMass
          receipt.initialState := by
  have terminalSummable :
      Summable fun wave : NonzeroIntegerWavevector =>
        complexCoordinateAmplitudeSq
          (receipt.wholePath
            ⟨requestedTime,
              ⟨requestedTimePos.le, le_rfl⟩⟩ wave.1) :=
    summable_puncturedWholeVorticityEuclideanMass _
  have initialSummable :
      Summable fun wave : NonzeroIntegerWavevector =>
        complexCoordinateAmplitudeSq
          (receipt.initialState wave.1) :=
    summable_puncturedWholeVorticityEuclideanMass _
  rw [show
      (fun wave : NonzeroIntegerWavevector =>
        actualWaveEnergyWork receipt wave) =
        (fun wave =>
          complexCoordinateAmplitudeSq
              (receipt.wholePath
                ⟨requestedTime,
                  ⟨requestedTimePos.le, le_rfl⟩⟩ wave.1) -
            complexCoordinateAmplitudeSq
              (receipt.initialState wave.1)) by
        funext wave
        exact actualWaveEnergyWork_eq receipt wave]
  rw [Summable.tsum_sub terminalSummable initialSummable]
  rfl

end ActualStrongReceipt

