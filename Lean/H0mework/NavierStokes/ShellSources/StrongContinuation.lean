/-! ## The actual whole time derivative -/

private theorem norm_sub_sq_le_two_mul
    {E : Type*}
    [NormedAddCommGroup E]
    (left right : E) :
    ‖left - right‖ ^ 2 ≤
      2 * ‖left‖ ^ 2 + 2 * ‖right‖ ^ 2 := by
  have normLe :
      ‖left - right‖ ≤ ‖left‖ + ‖right‖ :=
    norm_sub_le left right
  have squareLe :
      ‖left - right‖ ^ 2 ≤
        (‖left‖ + ‖right‖) ^ 2 :=
    (sq_le_sq₀ (norm_nonneg _)
      (add_nonneg (norm_nonneg _) (norm_nonneg _))).2 normLe
  calc
    ‖left - right‖ ^ 2 ≤
        (‖left‖ + ‖right‖) ^ 2 := squareLe
    _ ≤ 2 * ‖left‖ ^ 2 + 2 * ‖right‖ ^ 2 := by
      nlinarith [sq_nonneg (‖left‖ - ‖right‖)]

/-- Source-generated ceiling for the full negative-one time derivative. -/
def generatedWholeNegativeOneTangentCeiling
    (ν : Viscosity)
    (θ : ℝ) : ℝ :=
  2 *
      (6 *
        (biotSavartSerrinConstant *
          (∑' wave : IntegerWavevector,
            integerWaveCriticalKernel wave)) *
        criticalCoefficientEnstrophyCeiling ν θ ^ 2 /
        criticalEnstrophyAbsorptionCoefficient θ ν) +
    2 *
      (3 * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 *
        (((1 / 2 : ℝ) *
            criticalCoefficientEnstrophyCeiling ν θ) /
          criticalEnstrophyAbsorptionCoefficient θ ν))

/--
The same-carrier nonlinear-minus-viscous tangent has a finite explicit
`L²_t H⁻¹_x` bound.  Both summands and both bounds are generated by the
same infinite mild receipt.
-/
theorem
    InfiniteMildDuhamelForcingReceipt.wholeNegativeOneTangent_norm_sq_le
    {lineage : GeneratedIntegerShellInfiniteLineage}
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    {θLtOne : θ < 1}
    {criticalMargin :
      ∀ length : ℕ,
        criticalEnstrophyLatticeConstant *
            finiteStateVorticityCoefficientEnstrophy
              (generatedSupport (lineage.current length))
              (generatedComplexVorticityState
                (lineage.current length)
                (generatedSupport (lineage.current length))) ≤
          θ * ν.coeff ^ 2 * (2 * Real.pi) ^ 2}
    {requestedTimePos : 0 < requestedTime}
    (receipt :
      InfiniteMildDuhamelForcingReceipt
        lineage ν θ requestedTime θLtOne criticalMargin
        requestedTimePos) :
    ‖NonlinearNegativeOneForcingReceipt.wholeNegativeOneTangent
        receipt.toNonlinearNegativeOneForcingReceipt‖ ^ 2 ≤
      2 *
          (6 *
            (biotSavartSerrinConstant *
              (∑' wave : IntegerWavevector,
                integerWaveCriticalKernel wave)) *
            criticalCoefficientEnstrophyCeiling ν θ ^ 2 /
            criticalEnstrophyAbsorptionCoefficient θ ν) +
        2 *
          (3 * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 *
            wholeSpaceTimeVorticityGradientMass
              requestedTime receipt.stateLimit) := by
  calc
    ‖NonlinearNegativeOneForcingReceipt.wholeNegativeOneTangent
        receipt.toNonlinearNegativeOneForcingReceipt‖ ^ 2 ≤
      2 * ‖receipt.negativeOneForcing‖ ^ 2 +
        2 *
          ‖NonlinearNegativeOneForcingReceipt.wholeViscousNegativeOneForcing
            receipt.toNonlinearNegativeOneForcingReceipt‖ ^ 2 := by
      exact
        norm_sub_sq_le_two_mul
          receipt.negativeOneForcing
          (NonlinearNegativeOneForcingReceipt.wholeViscousNegativeOneForcing
            receipt.toNonlinearNegativeOneForcingReceipt)
    _ ≤
      2 *
          (6 *
            (biotSavartSerrinConstant *
              (∑' wave : IntegerWavevector,
                integerWaveCriticalKernel wave)) *
            criticalCoefficientEnstrophyCeiling ν θ ^ 2 /
            criticalEnstrophyAbsorptionCoefficient θ ν) +
        2 *
          (3 * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 *
            wholeSpaceTimeVorticityGradientMass
              requestedTime receipt.stateLimit) := by
      gcongr
      · exact receipt.negativeOneForcing_norm_sq_le_generated
      · exact
          NonlinearNegativeOneForcingReceipt.wholeViscousNegativeOneForcing_norm_sq_le
            receipt.toNonlinearNegativeOneForcingReceipt

/--
The whole tangent bound has no remaining state-dependent quantity: the
source-generated gradient estimate closes the last term.
-/
theorem
    InfiniteMildDuhamelForcingReceipt.wholeNegativeOneTangent_norm_sq_le_generated
    {lineage : GeneratedIntegerShellInfiniteLineage}
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    {θLtOne : θ < 1}
    {criticalMargin :
      ∀ length : ℕ,
        criticalEnstrophyLatticeConstant *
            finiteStateVorticityCoefficientEnstrophy
              (generatedSupport (lineage.current length))
              (generatedComplexVorticityState
                (lineage.current length)
                (generatedSupport (lineage.current length))) ≤
          θ * ν.coeff ^ 2 * (2 * Real.pi) ^ 2}
    {requestedTimePos : 0 < requestedTime}
    (receipt :
      InfiniteMildDuhamelForcingReceipt
        lineage ν θ requestedTime θLtOne criticalMargin
        requestedTimePos) :
    ‖NonlinearNegativeOneForcingReceipt.wholeNegativeOneTangent
        receipt.toNonlinearNegativeOneForcingReceipt‖ ^ 2 ≤
      generatedWholeNegativeOneTangentCeiling ν θ := by
  calc
    ‖NonlinearNegativeOneForcingReceipt.wholeNegativeOneTangent
        receipt.toNonlinearNegativeOneForcingReceipt‖ ^ 2 ≤
      2 *
          (6 *
            (biotSavartSerrinConstant *
              (∑' wave : IntegerWavevector,
                integerWaveCriticalKernel wave)) *
            criticalCoefficientEnstrophyCeiling ν θ ^ 2 /
            criticalEnstrophyAbsorptionCoefficient θ ν) +
        2 *
          (3 * ν.coeff ^ 2 * (2 * Real.pi) ^ 2 *
            wholeSpaceTimeVorticityGradientMass
              requestedTime receipt.stateLimit) :=
      ThreeDimensionalVorticityCoefficientGeneratedIntegerShellStrongContinuation.InfiniteMildDuhamelForcingReceipt.wholeNegativeOneTangent_norm_sq_le
        receipt
    _ ≤ generatedWholeNegativeOneTangentCeiling ν θ := by
      unfold generatedWholeNegativeOneTangentCeiling
      gcongr
      exact receipt.gradient_mass_le

/-! ## One actual coefficient strong-continuation receipt -/

/--
The strict-critical source lineage has generated one whole coefficient
solution on the requested interval.

The path is continuous in the whole spatial `ℓ²` carrier, represents the
same actual weak state, starts from the same generated Hilbert datum, and
satisfies every nonzero Fourier-row mild law.  The inherited receipt
supplies the cutoff-free `L²_t H¹_x` gradient and critical
`L²_t L∞_x` velocity-majorant budgets.  The additional tangent field records
the complete nonlinear-minus-viscous derivative in `L²_t H⁻¹_x`.

The receipt-square prefix budget and the tangent ceiling are conclusions.
No path, cutoff, terminal shell, continuation endpoint, tail witness, or
strong-solution certificate is supplied by a caller.
-/
structure StrongContinuationReceipt
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (ν : Viscosity)
    (θ requestedTime : ℝ)
    (θLtOne : θ < 1)
    (criticalMargin :
      ∀ length : ℕ,
        criticalEnstrophyLatticeConstant *
            finiteStateVorticityCoefficientEnstrophy
              (generatedSupport (lineage.current length))
              (generatedComplexVorticityState
                (lineage.current length)
                (generatedSupport (lineage.current length))) ≤
          θ * ν.coeff ^ 2 * (2 * Real.pi) ^ 2)
    (requestedTimePos : 0 < requestedTime)
    extends
      WholeContinuousMildReceipt
        lineage ν θ requestedTime θLtOne criticalMargin
        requestedTimePos where
  prefixReceiptBound :
    ∀ length : ℕ,
      lineage.prefixReceiptTraceSquareMass length ≤
        uniformReceiptTraceSquareCeiling ν θ
  wholeNegativeOneTangent_norm_sq_le_generated :
    ‖NonlinearNegativeOneForcingReceipt.wholeNegativeOneTangent
        toWholeContinuousMildReceipt.toInfiniteMildDuhamelForcingReceipt.toNonlinearNegativeOneForcingReceipt‖ ^ 2 ≤
      generatedWholeNegativeOneTangentCeiling ν θ

/--
The generated continuous path carries the inherited whole
`L²_t H¹_x` gradient budget on exactly the same time-`L²` state.
-/
theorem StrongContinuationReceipt.wholePath_gradient_mass_le
    {lineage : GeneratedIntegerShellInfiniteLineage}
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    {θLtOne : θ < 1}
    {criticalMargin :
      ∀ length : ℕ,
        criticalEnstrophyLatticeConstant *
            finiteStateVorticityCoefficientEnstrophy
              (generatedSupport (lineage.current length))
              (generatedComplexVorticityState
                (lineage.current length)
                (generatedSupport (lineage.current length))) ≤
          θ * ν.coeff ^ 2 * (2 * Real.pi) ^ 2}
    {requestedTimePos : 0 < requestedTime}
    (receipt :
      StrongContinuationReceipt
        lineage ν θ requestedTime θLtOne criticalMargin
        requestedTimePos) :
    wholeSpaceTimeVorticityGradientMass requestedTime
        (BoundedContinuousFunction.toLp 2
          (commonTimeMeasure requestedTime) ℂ receipt.wholePath) ≤
      ((1 / 2 : ℝ) *
          criticalCoefficientEnstrophyCeiling ν θ) /
        criticalEnstrophyAbsorptionCoefficient θ ν := by
  rw [receipt.wholePath_toLp_eq_stateLimit]
  exact receipt.toInfiniteMildDuhamelForcingReceipt.gradient_mass_le

/--
The same continuous path satisfies the cutoff-free critical Serrin
integrability generated by the lineage.
-/
theorem StrongContinuationReceipt.wholePath_velocityMajorantSq_integrable
    {lineage : GeneratedIntegerShellInfiniteLineage}
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    {θLtOne : θ < 1}
    {criticalMargin :
      ∀ length : ℕ,
        criticalEnstrophyLatticeConstant *
            finiteStateVorticityCoefficientEnstrophy
              (generatedSupport (lineage.current length))
              (generatedComplexVorticityState
                (lineage.current length)
                (generatedSupport (lineage.current length))) ≤
          θ * ν.coeff ^ 2 * (2 * Real.pi) ^ 2}
    {requestedTimePos : 0 < requestedTime}
    (receipt :
      StrongContinuationReceipt
        lineage ν θ requestedTime θLtOne criticalMargin
        requestedTimePos) :
    Integrable
      (fun time =>
        wholeStateVelocityMajorant
          ((BoundedContinuousFunction.toLp 2
            (commonTimeMeasure requestedTime) ℂ
            receipt.wholePath) time) ^ 2)
      (commonTimeMeasure requestedTime) := by
  rw [receipt.wholePath_toLp_eq_stateLimit]
  exact
    receipt.toInfiniteMildDuhamelForcingReceipt.velocityMajorantSq_integrable

/--
The source-generated Serrin integral has the same explicit ceiling after
the continuous-path identification.
-/
theorem
    StrongContinuationReceipt.wholePath_velocityMajorantSq_integral_le_generated
    {lineage : GeneratedIntegerShellInfiniteLineage}
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    {θLtOne : θ < 1}
    {criticalMargin :
      ∀ length : ℕ,
        criticalEnstrophyLatticeConstant *
            finiteStateVorticityCoefficientEnstrophy
              (generatedSupport (lineage.current length))
              (generatedComplexVorticityState
                (lineage.current length)
                (generatedSupport (lineage.current length))) ≤
          θ * ν.coeff ^ 2 * (2 * Real.pi) ^ 2}
    {requestedTimePos : 0 < requestedTime}
    (receipt :
      StrongContinuationReceipt
        lineage ν θ requestedTime θLtOne criticalMargin
        requestedTimePos) :
    (∫ time,
        wholeStateVelocityMajorant
          ((BoundedContinuousFunction.toLp 2
            (commonTimeMeasure requestedTime) ℂ
            receipt.wholePath) time) ^ 2
        ∂(commonTimeMeasure requestedTime)) ≤
      3 *
        (biotSavartSerrinConstant *
          (∑' wave : IntegerWavevector,
            integerWaveCriticalKernel wave)) *
        (((1 / 2 : ℝ) *
            criticalCoefficientEnstrophyCeiling ν θ) /
          criticalEnstrophyAbsorptionCoefficient θ ν) := by
  rw [receipt.wholePath_toLp_eq_stateLimit]
  exact
    receipt.toInfiniteMildDuhamelForcingReceipt.velocityMajorantSq_integral_le_generated

/--
The continuous whole path and the complete negative-one tangent satisfy
the actual Fourier weak equation on the same carrier.  This is the
path/tangent update law consumed by the strong-continuation receipt, not
two independent regularity readouts.
-/
theorem StrongContinuationReceipt.weak_action_via_wholePath_tangent
    {lineage : GeneratedIntegerShellInfiniteLineage}
    {ν : Viscosity}
    {θ requestedTime : ℝ}
    {θLtOne : θ < 1}
    {criticalMargin :
      ∀ length : ℕ,
        criticalEnstrophyLatticeConstant *
            finiteStateVorticityCoefficientEnstrophy
              (generatedSupport (lineage.current length))
              (generatedComplexVorticityState
                (lineage.current length)
                (generatedSupport (lineage.current length))) ≤
          θ * ν.coeff ^ 2 * (2 * Real.pi) ^ 2}
    {requestedTimePos : 0 < requestedTime}
    (receipt :
      StrongContinuationReceipt
        lineage ν θ requestedTime θLtOne criticalMargin
        requestedTimePos)
    (wave : IntegerWavevector)
    (waveNe : wave ≠ 0)
    (test testDerivative : ℝ → ℂ)
    (testHasDeriv :
      ∀ time ∈ Set.Icc (0 : ℝ) requestedTime,
        HasDerivAt test (testDerivative time) time)
    (testDerivativeContinuous :
      ContinuousOn testDerivative
        (Set.Icc (0 : ℝ) requestedTime))
    (testZero : test 0 = 0)
    (testRequestedTimeZero : test requestedTime = 0) :
    fixedL2ScalarL2IntegralCLM requestedTime
          (restrictedScalarL2 requestedTime testDerivative
            testDerivativeContinuous)
          (fixedWaveSpaceTimeRestriction
            requestedTime wave
            (BoundedContinuousFunction.toLp 2
              (commonTimeMeasure requestedTime) ℂ
              receipt.wholePath)) +
        fixedL2ScalarL2IntegralCLM requestedTime
          (restrictedScalarL2 requestedTime test
            (fun time timeMem =>
              (testHasDeriv time timeMem).continuousAt.continuousWithinAt))
          (NonlinearNegativeOneForcingReceipt.fixedWaveNegativeOneTangentL2
            receipt.toInfiniteMildDuhamelForcingReceipt.toNonlinearNegativeOneForcingReceipt
            wave) =
      0 := by
  rw [receipt.wholePath_toLp_eq_stateLimit]
  exact
    NonlinearNegativeOneForcingReceipt.weak_action_via_wholeNegativeOneTangent
      receipt.toInfiniteMildDuhamelForcingReceipt.toNonlinearNegativeOneForcingReceipt
      wave waveNe test testDerivative testHasDeriv
      testDerivativeContinuous testZero testRequestedTimeZero

/--
An actual strict-critical infinite source lineage generates the complete
coefficient strong-continuation receipt on every requested positive finite
time interval.

The construction uses the lineage's canonical infinite mild receipt,
continuous whole-state assembly, receipt-square cascade estimate, and
whole negative-one tangent.  It does not select a target solution.
-/
noncomputable def
    GeneratedIntegerShellInfiniteLineage.generates_strongContinuation
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (ν : Viscosity)
    (θ requestedTime : ℝ)
    (θLtOne : θ < 1)
    (criticalMargin :
      ∀ length : ℕ,
        criticalEnstrophyLatticeConstant *
            finiteStateVorticityCoefficientEnstrophy
              (generatedSupport (lineage.current length))
              (generatedComplexVorticityState
                (lineage.current length)
                (generatedSupport (lineage.current length))) ≤
          θ * ν.coeff ^ 2 * (2 * Real.pi) ^ 2)
    (requestedTimePos : 0 < requestedTime) :
    StrongContinuationReceipt
      lineage ν θ requestedTime θLtOne criticalMargin
      requestedTimePos := by
  let mildReceipt :=
    GeneratedIntegerShellInfiniteLineage.generates_infiniteMildDuhamelForcing
      lineage ν θ requestedTime θLtOne criticalMargin
      requestedTimePos
  exact
    { toInfiniteMildDuhamelForcingReceipt := mildReceipt
      wholePath := wholeMildPath mildReceipt
      wholePath_toLp_eq_stateLimit :=
        wholeMildPath_toLp_eq_stateLimit mildReceipt
      wholePath_initial :=
        wholeMildPath_initial mildReceipt
      wholePath_mild_identity :=
        fun wave waveNe time =>
          wholeMildPath_mild_identity mildReceipt wave waveNe time
      wholePath_norm_sq_le :=
        fun time => wholeMildPath_norm_sq_le mildReceipt time
      prefixReceiptBound :=
        fun length =>
          lineage.prefixReceiptTraceSquareMass_le_uniform
            ν θ θLtOne criticalMargin length
      wholeNegativeOneTangent_norm_sq_le_generated :=
        InfiniteMildDuhamelForcingReceipt.wholeNegativeOneTangent_norm_sq_le_generated
          mildReceipt }

/--
The producer is uniform in the requested positive finite horizon.  Each
horizon is generated from the same source lineage and the same canonical
initial Hilbert state construction; no runtime length or terminal time is
chosen in advance.
-/
noncomputable def
    GeneratedIntegerShellInfiniteLineage.generates_strongContinuation_on_arbitrary_finite_horizon
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (ν : Viscosity)
    (θ : ℝ)
    (θLtOne : θ < 1)
    (criticalMargin :
      ∀ length : ℕ,
        criticalEnstrophyLatticeConstant *
            finiteStateVorticityCoefficientEnstrophy
              (generatedSupport (lineage.current length))
              (generatedComplexVorticityState
                (lineage.current length)
                (generatedSupport (lineage.current length))) ≤
          θ * ν.coeff ^ 2 * (2 * Real.pi) ^ 2) :
    ∀ requestedTime : ℝ,
      ∀ requestedTimePos : 0 < requestedTime,
        StrongContinuationReceipt
          lineage ν θ requestedTime θLtOne criticalMargin
          requestedTimePos :=
  fun requestedTime requestedTimePos =>
    GeneratedIntegerShellInfiniteLineage.generates_strongContinuation
      lineage ν θ requestedTime θLtOne criticalMargin
      requestedTimePos

end

