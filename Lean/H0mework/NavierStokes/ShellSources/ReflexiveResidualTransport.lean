import H0mework.Realization.Residual.PathTransport
import H0mework.NavierStokes.ShellSources.ReflexiveWrite

/-!
# Residual transport of one reflexive integer-shell event

`ThreeDimensionalVorticityCoefficientGeneratedIntegerShellReflexiveWrite`
proves that reading the complete current obstruction either returns zero or
emits the exact nonzero receipt while writing the dependent native
successor.  This module puts that same event on one whole linear carrier.

The coefficient update is affine because a successful event adds its
source-generated receipt.  One homogeneous coordinate turns the update into
an actual linear keep.  For every current, without choosing its branch,

```text
frame(write current) = keep(current) (frame current).
```

The uniquely forced residual complement is the negative of the emitted
receipt in the live coordinate.  Thus the observation, receipt write-back,
next state, keep update, and conservation trace all belong to one event.
The sign distinguishes the receipt written into the next coefficient state
from the complementary trace in

```text
old residual = new residual + trace.
```

No scale, branch, path, nonzero witness, cutoff, critical margin, or
continuation receipt is supplied by the caller.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalVorticityCoefficientGeneratedIntegerShellReflexiveResidualTransport

open AffineRelaxation
open ResidualProjection
open SourceGeneratedNativeResponseDisposition
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientGeneratedIntegerShellSource
open ThreeDimensionalVorticityCoefficientGeneratedIntegerShellPath
open ThreeDimensionalVorticityCoefficientGeneratedIntegerShellTraceCumulative
open ThreeDimensionalVorticityCoefficientGeneratedIntegerShellInfiniteLineageReceiptSquare
open ThreeDimensionalVorticityCoefficientGeneratedIntegerShellReflexiveWrite

noncomputable section

/-! ## Homogeneous whole-coefficient carrier -/

/-- Complete finite coefficient state plus one homogeneous scalar. -/
abbrev HomogeneousCoefficientCarrier :=
  IntegerShellCoefficientCarrier × ℂ

/-- The actual source coefficient frame, with homogeneous coordinate one. -/
def homogeneousCoefficientFrame
    (current : RawVorticityFourierSource) :
    HomogeneousCoefficientCarrier :=
  (generatedCoefficientCarrier current, 1)

/--
Linearization of adding one already generated receipt trace.
-/
def homogeneousTraceKeep
    (trace : IntegerShellCoefficientCarrier) :
    HomogeneousCoefficientCarrier →ₗ[ℂ]
      HomogeneousCoefficientCarrier where
  toFun frame :=
    (frame.1 + frame.2 • trace, frame.2)
  map_add' := by
    intro left right
    ext <;> simp [add_smul]
    abel
  map_smul' := by
    intro scalar frame
    ext <;> simp [smul_add, mul_smul]

@[simp] theorem homogeneousTraceKeep_apply
    (trace : IntegerShellCoefficientCarrier)
    (frame : HomogeneousCoefficientCarrier) :
    homogeneousTraceKeep trace frame =
      (frame.1 + frame.2 • trace, frame.2) :=
  rfl

/--
The keep generated by the current source response itself.

The stopped branch is the identity.  The successful branch uses the complete
whole-shell trace selected by the literal dependent response.
-/
def reflexiveCoefficientKeep
    (current : RawVorticityFourierSource) :
    HomogeneousCoefficientCarrier →ₗ[ℂ]
      HomogeneousCoefficientCarrier :=
  match generatedIntegerShellRespond current with
  | none => LinearMap.id
  | some response =>
      homogeneousTraceKeep
        (generatedIntegerShellTrace current response.2.shellSq)

@[simp] theorem reflexiveCoefficientKeep_of_none
    (current : RawVorticityFourierSource)
    (stopped :
      generatedIntegerShellRespond current = none) :
    reflexiveCoefficientKeep current = LinearMap.id := by
  unfold reflexiveCoefficientKeep
  rw [stopped]

theorem reflexiveCoefficientKeep_of_some
    (current : RawVorticityFourierSource)
    (response : Response GeneratedIntegerShellStep current)
    (generated :
      generatedIntegerShellRespond current = some response) :
    reflexiveCoefficientKeep current =
      homogeneousTraceKeep
        (generatedIntegerShellTrace current response.2.shellSq) := by
  unfold reflexiveCoefficientKeep
  rw [generated]

/-! ## Actual update and unique conservation trace -/

/--
The source-owned reflexive write and the generated linear keep commute on
the complete actual coefficient frame.
-/
theorem reflexiveCoefficientFrame_actual_update
    (current : RawVorticityFourierSource) :
    homogeneousCoefficientFrame
        (integerShellReflexiveQuery.write current) =
      reflexiveCoefficientKeep current
        (homogeneousCoefficientFrame current) := by
  cases generated :
      generatedIntegerShellRespond current with
  | none =>
      rw [show integerShellReflexiveQuery.write current = current by
        exact reflexiveWrite_of_none current generated]
      rw [reflexiveCoefficientKeep_of_none current generated]
      rfl
  | some response =>
      let receipt :=
        receiptOfResponse current response generated
      have writeBack :
          generatedCoefficientCarrier response.1 =
            generatedCoefficientCarrier current +
              generatedIntegerShellReceiptTrace receipt :=
        coefficientCarrier_next receipt
      rw [show integerShellReflexiveQuery.write current = response.1 by
        exact reflexiveWrite_of_some current response generated]
      rw [reflexiveCoefficientKeep_of_some
        current response generated]
      apply Prod.ext
      · change
          generatedCoefficientCarrier response.1 =
            generatedCoefficientCarrier current +
              (1 : ℂ) •
                generatedIntegerShellTrace
                  current response.2.shellSq
        simpa [receipt, receiptOfResponse,
          generatedIntegerShellReceiptTrace,
          GeneratedIntegerShellReceipt.selectedShellSq] using
          writeBack
      · rfl

/-- Complement uniquely forced by the current event's actual keep. -/
def reflexiveCoefficientResidualTrace
    (current : RawVorticityFourierSource) :
    HomogeneousCoefficientCarrier :=
  linearResidualTrace
    (reflexiveCoefficientKeep current)
    (homogeneousCoefficientFrame current)

/--
Exact residual conservation for the same source event.
-/
theorem reflexiveCoefficientFrame_split
    (current : RawVorticityFourierSource) :
    homogeneousCoefficientFrame current =
      homogeneousCoefficientFrame
          (integerShellReflexiveQuery.write current) +
        reflexiveCoefficientResidualTrace current := by
  rw [reflexiveCoefficientFrame_actual_update current]
  unfold reflexiveCoefficientResidualTrace linearResidualTrace
  abel

/--
No independently supplied complement can alter the source-owned split.
-/
theorem reflexiveCoefficientResidualTrace_unique
    (current : RawVorticityFourierSource)
    (trace : HomogeneousCoefficientCarrier) :
    homogeneousCoefficientFrame current =
        homogeneousCoefficientFrame
            (integerShellReflexiveQuery.write current) +
          trace ↔
      trace = reflexiveCoefficientResidualTrace current := by
  rw [reflexiveCoefficientFrame_actual_update current]
  unfold reflexiveCoefficientResidualTrace
  constructor
  · intro split
    unfold linearResidualTrace
    calc
      trace =
          (reflexiveCoefficientKeep current
              (homogeneousCoefficientFrame current) + trace) -
            reflexiveCoefficientKeep current
              (homogeneousCoefficientFrame current) := by
        abel
      _ =
          homogeneousCoefficientFrame current -
            reflexiveCoefficientKeep current
              (homogeneousCoefficientFrame current) := by
        rw [← split]
  · intro traceEq
    rw [traceEq]
    unfold linearResidualTrace
    abel

/--
The conservation complement is exactly the negative of the receipt observed
by the same event.  This includes the stopped case, where both are zero.
-/
theorem reflexiveCoefficientResidualTrace_eq_neg_observation
    (current : RawVorticityFourierSource) :
    reflexiveCoefficientResidualTrace current =
      (-reflexiveObservation current, 0) := by
  cases generated :
      generatedIntegerShellRespond current with
  | none =>
      unfold reflexiveCoefficientResidualTrace
      rw [reflexiveCoefficientKeep_of_none current generated]
      rw [reflexiveObservation_of_none current generated]
      simp [linearResidualTrace]
      rfl
  | some response =>
      unfold reflexiveCoefficientResidualTrace
      rw [reflexiveCoefficientKeep_of_some
        current response generated]
      rw [reflexiveObservation_of_some
        current response generated]
      apply Prod.ext
      · simp [linearResidualTrace, homogeneousCoefficientFrame,
          homogeneousTraceKeep, receiptOfResponse,
          generatedIntegerShellReceiptTrace,
          GeneratedIntegerShellReceipt.selectedShellSq]
      · simp [linearResidualTrace, homogeneousCoefficientFrame,
          homogeneousTraceKeep]

/-! ## Every recursive source event carries the same update law -/

namespace ReflexiveLineage

/--
Every adjacent event of an actual infinite lineage satisfies the whole-frame
residual update law.
-/
theorem frame_actual_update
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (index : ℕ) :
    homogeneousCoefficientFrame (lineage.current (index + 1)) =
      reflexiveCoefficientKeep (lineage.current index)
        (homogeneousCoefficientFrame (lineage.current index)) := by
  rw [←
    ThreeDimensionalVorticityCoefficientGeneratedIntegerShellReflexiveWrite.ReflexiveLineage.iterated_stateAt_eq_current
      lineage (index + 1)]
  rw [reflexiveQueryIterated_stateAt_succ]
  rw [
    ThreeDimensionalVorticityCoefficientGeneratedIntegerShellReflexiveWrite.ReflexiveLineage.iterated_stateAt_eq_current
      lineage index]
  exact
    reflexiveCoefficientFrame_actual_update
      (lineage.current index)

/--
At every recursive event, the conservation trace is the negative of the
exact nonzero receipt whose squared norm enters the cascade.
-/
theorem residualTrace_eq_neg_receipt
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (index : ℕ) :
    reflexiveCoefficientResidualTrace (lineage.current index) =
      (-generatedIntegerShellReceiptTrace
          (lineage.receipt index), 0) := by
  rw [reflexiveCoefficientResidualTrace_eq_neg_observation]
  have observationEq :
      reflexiveObservation (lineage.current index) =
        generatedIntegerShellReceiptTrace
          (lineage.receipt index) := by
    simpa [
      GeneratedIntegerShellInfiniteLineage.receipt,
      GeneratedIntegerShellInfiniteLineage.response,
      receiptOfResponse,
      generatedIntegerShellReceiptTrace,
      GeneratedIntegerShellReceipt.selectedShellSq] using
      reflexiveObservation_of_some
        (lineage.current index)
        (lineage.response index)
        (lineage.response_generated index)
  rw [observationEq]

end ReflexiveLineage

end

end ThreeDimensionalVorticityCoefficientGeneratedIntegerShellReflexiveResidualTransport
end NavierStokes
end SaturationMonoid
