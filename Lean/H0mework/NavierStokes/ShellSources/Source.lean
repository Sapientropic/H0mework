import H0mework.Realization.Process.NativeResponseDisposition
import H0mework.NavierStokes.Fourier.ConcreteSpectralScaleEdge
import H0mework.NavierStokes.Fourier.StretchingOutputCarrier
import H0mework.NavierStokes.Fourier.SpectralNonlinearTraceLedger

/-!
# Source-generated integer-shell successors for three-dimensional vorticity

This module adds a versioned source grammar downstream of the unchanged raw
vorticity source.  A source first generates its nonzero live vorticity modes,
the maximal live integer shell, the complete nonlinear output inventory, and
all nonzero outputs on genuinely outer shells.  If that inventory is
nonempty, the source selects its least squared integer shell and writes the
whole shell back at once.

The extension is canonical at the generated coefficient level.  Old live
rows are rewritten from the already generated reality-symmetric transverse
coefficient table; rows on the new whole shell are generated by the complete
nonlinear output fibers.  Thus no raw value outside the old source's
observable support is treated as authoritative.

`generatedIntegerShellRespond` owns the optional branch, selected shell,
whole-shell extension, and dependent successor.  Least reachability and
typed disposition are inherited from `SourceGeneratedNativeResponseDisposition`.
The `none` branch says exactly that this grammar generated no active outer
nonlinear mode; it is not a PDE terminal or regularity conclusion.

This source update is a grammar/write-back state transition, not physical
Navier--Stokes time evolution.  A separate whole-carrier compiler must prove
that an actual PDE model realizes the generated scale edge.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalVorticityCoefficientGeneratedIntegerShellSource

open scoped BigOperators Matrix

open Matrix
open AffineRelaxation
open SourceGeneratedNativeResponseDisposition
open ThreeDimensionalPeriodicCoarseFilterCore
open ThreeDimensionalPeriodicIntegerCharacterCoarseFilter
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientStretchingPairTable
open ThreeDimensionalVorticityCoefficientStretchingOutputCarrier
open ThreeDimensionalVorticityCoefficientNonlinearPairGenerator
open ThreeDimensionalVorticityCoefficientConcreteSpectralScaleEdge
open ThreeDimensionalVorticityCoefficientSpectralNonlinearTraceLedger

noncomputable section

/-! ## Exact integer shells -/

/-- Exact squared integer shell of a three-dimensional Fourier wave. -/
def integerWaveShellSq
    (wave : IntegerWavevector) : ℤ :=
  ∑ coordinate : Coordinate, wave coordinate ^ 2

@[simp] theorem integerWaveShellSq_waveNeg
    (wave : IntegerWavevector) :
    integerWaveShellSq (waveNeg wave) =
      integerWaveShellSq wave := by
  simp [integerWaveShellSq, waveNeg]

@[simp] theorem integerWaveShellSq_zero :
    integerWaveShellSq 0 = 0 := by
  simp [integerWaveShellSq]

/-- The exact integer shell is the integer source of the existing real norm. -/
theorem integerWaveNormSq_eq_integerWaveShellSq
    (wave : IntegerWavevector) :
    integerWaveNormSq wave =
      (integerWaveShellSq wave : ℝ) := by
  simp [integerWaveNormSq, integerWaveShellSq]

theorem integerWaveShellSq_nonneg
    (wave : IntegerWavevector) :
    0 ≤ integerWaveShellSq wave := by
  unfold integerWaveShellSq
  exact Finset.sum_nonneg fun _ _ => sq_nonneg _

theorem integerWaveShellSq_pos
    {wave : IntegerWavevector}
    (wave_ne_zero : wave ≠ 0) :
    0 < integerWaveShellSq wave := by
  have realPos : 0 < integerWaveNormSq wave :=
    integerWaveNormSq_pos wave_ne_zero
  rw [integerWaveNormSq_eq_integerWaveShellSq] at realPos
  exact_mod_cast realPos

/-! ## Live modes and source-owned outer nonlinear inventory -/

/--
Nonzero vorticity modes filtered only after the raw source has generated its
complete signed transverse coefficient table.
-/
def generatedLiveVorticityModes
    (source : RawVorticityFourierSource) :
    Finset IntegerWavevector := by
  classical
  exact (generatedSupport source).filter fun wave =>
    generatedVorticityCoefficient source wave ≠ 0

@[simp] theorem mem_generatedLiveVorticityModes_iff
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) :
    wave ∈ generatedLiveVorticityModes source ↔
      wave ∈ generatedSupport source ∧
        generatedVorticityCoefficient source wave ≠ 0 := by
  simp [generatedLiveVorticityModes]

@[simp] theorem mem_generatedLiveVorticityModes_waveNeg_iff
    (source : RawVorticityFourierSource)
    (wave : IntegerWavevector) :
    waveNeg wave ∈ generatedLiveVorticityModes source ↔
      wave ∈ generatedLiveVorticityModes source := by
  rw [mem_generatedLiveVorticityModes_iff,
    mem_generatedLiveVorticityModes_iff,
    mem_generatedSupport_waveNeg_iff,
    generatedVorticityCoefficient_waveNeg]
  constructor
  · rintro ⟨membership, conjugateNonzero⟩
    refine ⟨membership, ?_⟩
    intro coefficientZero
    apply conjugateNonzero
    rw [coefficientZero, vectorConj_zero]
  · rintro ⟨membership, coefficientNonzero⟩
    refine ⟨membership, ?_⟩
    intro conjugateZero
    apply coefficientNonzero
    have := congrArg vectorConj conjugateZero
    simpa using this

@[simp] theorem zero_not_mem_generatedLiveVorticityModes
    (source : RawVorticityFourierSource) :
    0 ∉ generatedLiveVorticityModes source := by
  simp

/-- Exact squared shells occupied by the generated live coefficient table. -/
def generatedLiveVorticityShells
    (source : RawVorticityFourierSource) : Finset ℤ :=
  (generatedLiveVorticityModes source).image integerWaveShellSq

/-- Maximal live squared shell, absent exactly when the live table is empty. -/
def generatedCurrentLiveMaxShellSq?
    (source : RawVorticityFourierSource) : Option ℤ :=
  if shellsNonempty : (generatedLiveVorticityShells source).Nonempty
  then
    some
      ((generatedLiveVorticityShells source).max' shellsNonempty)
  else
    none

/--
Complete active outer nonlinear output inventory.  Every condition is
generated internally: output provenance, nonzero frequency, absence from the
live table, strict shell growth, and nonzero complete-fiber coefficient.
-/
def generatedActiveOuterNonlinearModes
    (source : RawVorticityFourierSource) :
    Finset IntegerWavevector := by
  classical
  exact
    match generatedCurrentLiveMaxShellSq? source with
    | none => ∅
    | some currentMax =>
        (generatedStretchingOutputInventory source).filter fun output =>
          output ≠ 0 ∧
            output ∉ generatedLiveVorticityModes source ∧
            currentMax < integerWaveShellSq output ∧
            generatedVorticityNonlinearCoefficientAt source output ≠ 0

@[simp] theorem mem_generatedActiveOuterNonlinearModes_waveNeg_iff
    (source : RawVorticityFourierSource)
    (output : IntegerWavevector) :
    waveNeg output ∈ generatedActiveOuterNonlinearModes source ↔
      output ∈ generatedActiveOuterNonlinearModes source := by
  rw [generatedActiveOuterNonlinearModes]
  cases currentMax :
      generatedCurrentLiveMaxShellSq? source with
  | none =>
      simp
  | some shellSq =>
      simp only [Finset.mem_filter,
        mem_generatedStretchingOutputInventory_waveNeg_iff,
        mem_generatedLiveVorticityModes_waveNeg_iff,
        integerWaveShellSq_waveNeg,
        generatedVorticityNonlinearCoefficientAt_waveNeg]
      constructor
      · rintro ⟨inventory, nonzero, notLive, outer, conjugateNonzero⟩
        have outputNonzero : output ≠ 0 := by
          simpa using nonzero
        refine ⟨inventory, outputNonzero, notLive, outer, ?_⟩
        intro coefficientZero
        apply conjugateNonzero
        rw [coefficientZero, vectorConj_zero]
      · rintro ⟨inventory, nonzero, notLive, outer, coefficientNonzero⟩
        have negOutputNonzero : waveNeg output ≠ 0 := by
          simpa using nonzero
        refine ⟨inventory, negOutputNonzero, notLive, outer, ?_⟩
        intro conjugateZero
        apply coefficientNonzero
        have := congrArg vectorConj conjugateZero
        simpa using this

@[simp] theorem zero_not_mem_generatedActiveOuterNonlinearModes
    (source : RawVorticityFourierSource) :
    0 ∉ generatedActiveOuterNonlinearModes source := by
  rw [generatedActiveOuterNonlinearModes]
  cases generatedCurrentLiveMaxShellSq? source <;> simp

/-- Squared shells of all source-generated active outer nonlinear outputs. -/
def generatedActiveOuterNonlinearShells
    (source : RawVorticityFourierSource) : Finset ℤ :=
  (generatedActiveOuterNonlinearModes source).image integerWaveShellSq

/-- Least active outer squared shell, computed entirely from the source. -/
def generatedNextOuterNonlinearShellSq?
    (source : RawVorticityFourierSource) : Option ℤ :=
  if shellsNonempty :
      (generatedActiveOuterNonlinearShells source).Nonempty
  then
    some
      ((generatedActiveOuterNonlinearShells source).min' shellsNonempty)
  else
    none

/-- The least-shell selector is absent exactly when no active outer mode was
generated. -/
theorem generatedNextOuterNonlinearShellSq?_eq_none_iff
    (source : RawVorticityFourierSource) :
    generatedNextOuterNonlinearShellSq? source = none ↔
      generatedActiveOuterNonlinearModes source = ∅ := by
  by_cases shellsNonempty :
      (generatedActiveOuterNonlinearShells source).Nonempty
  · have outerNonempty :
        (generatedActiveOuterNonlinearModes source).Nonempty := by
      simpa [generatedActiveOuterNonlinearShells] using
        Finset.image_nonempty.mp shellsNonempty
    simp [generatedNextOuterNonlinearShellSq?, shellsNonempty,
      Finset.nonempty_iff_ne_empty.mp outerNonempty]
  · have shellsEmpty :
        generatedActiveOuterNonlinearShells source = ∅ :=
      Finset.not_nonempty_iff_eq_empty.mp shellsNonempty
    have outerEmpty :
        generatedActiveOuterNonlinearModes source = ∅ := by
      have :
          (generatedActiveOuterNonlinearModes source).image
              integerWaveShellSq = ∅ := by
        simpa [generatedActiveOuterNonlinearShells] using shellsEmpty
      exact Finset.image_eq_empty.mp this
    simp [generatedNextOuterNonlinearShellSq?, shellsNonempty,
      outerEmpty]

/-- A selected least shell contains an actual source-generated outer mode. -/
theorem exists_outer_mode_of_generatedNextOuterNonlinearShellSq?_eq_some
    (source : RawVorticityFourierSource)
    (shellSq : ℤ)
    (selected :
      generatedNextOuterNonlinearShellSq? source = some shellSq) :
    ∃ output ∈ generatedActiveOuterNonlinearModes source,
      integerWaveShellSq output = shellSq := by
  by_cases shellsNonempty :
      (generatedActiveOuterNonlinearShells source).Nonempty
  · have shellMembership :
      (generatedActiveOuterNonlinearShells source).min' shellsNonempty ∈
        generatedActiveOuterNonlinearShells source :=
      Finset.min'_mem _ _
    have shellEquality :
        (generatedActiveOuterNonlinearShells source).min'
            shellsNonempty = shellSq := by
      have selectedSome :
          some
              ((generatedActiveOuterNonlinearShells source).min'
                shellsNonempty) =
            some shellSq := by
        simpa [generatedNextOuterNonlinearShellSq?,
          shellsNonempty] using selected
      exact Option.some.inj selectedSome
    rw [shellEquality] at shellMembership
    rcases Finset.mem_image.mp shellMembership with
      ⟨output, outputMembership, outputShell⟩
    exact ⟨output, outputMembership, outputShell⟩
  · simp [generatedNextOuterNonlinearShellSq?,
      shellsNonempty] at selected

/-- All active outer nonlinear modes on one squared integer shell. -/
def generatedOuterNonlinearShellModes
    (source : RawVorticityFourierSource)
    (shellSq : ℤ) : Finset IntegerWavevector :=
  (generatedActiveOuterNonlinearModes source).filter fun output =>
    integerWaveShellSq output = shellSq

@[simp] theorem mem_generatedOuterNonlinearShellModes_iff
    (source : RawVorticityFourierSource)
    (shellSq : ℤ)
    (output : IntegerWavevector) :
    output ∈ generatedOuterNonlinearShellModes source shellSq ↔
      output ∈ generatedActiveOuterNonlinearModes source ∧
        integerWaveShellSq output = shellSq := by
  simp [generatedOuterNonlinearShellModes]

@[simp] theorem mem_generatedOuterNonlinearShellModes_waveNeg_iff
    (source : RawVorticityFourierSource)
    (shellSq : ℤ)
    (output : IntegerWavevector) :
    waveNeg output ∈
        generatedOuterNonlinearShellModes source shellSq ↔
      output ∈ generatedOuterNonlinearShellModes source shellSq := by
  simp [generatedOuterNonlinearShellModes]

@[simp] theorem zero_not_mem_generatedOuterNonlinearShellModes
    (source : RawVorticityFourierSource)
    (shellSq : ℤ) :
    0 ∉ generatedOuterNonlinearShellModes source shellSq := by
  simp

/-! ## Canonical whole-shell coefficient write-back -/

/--
Canonical coefficient row written by a shell extension.  Existing generated
vorticity rows are used off the selected shell; complete nonlinear output
rows are used on the whole selected shell.
-/
def generatedNonlinearShellWriteRow
    (source : RawVorticityFourierSource)
    (shellSq : ℤ)
    (wave : IntegerWavevector) : ComplexCoordinateVector :=
  if wave ∈ generatedOuterNonlinearShellModes source shellSq
  then generatedVorticityNonlinearCoefficientAt source wave
  else generatedVorticityCoefficient source wave

/--
Versioned source extension generated by one whole nonlinear shell.

The old arbitrary raw table is not copied.  Instead, the already generated
physical coefficient table is canonically written back, with the selected
whole shell overwritten by its source-generated nonlinear aggregate.
-/
def extendByGeneratedNonlinearShell
    (source : RawVorticityFourierSource)
    (shellSq : ℤ) : RawVorticityFourierSource where
  activeModes :=
    generatedSupport source ∪
      generatedOuterNonlinearShellModes source shellSq
  rawVorticity :=
    generatedNonlinearShellWriteRow source shellSq

@[simp] theorem generatedNonlinearShellWriteRow_waveNeg
    (source : RawVorticityFourierSource)
    (shellSq : ℤ)
    (wave : IntegerWavevector) :
    generatedNonlinearShellWriteRow source shellSq (waveNeg wave) =
      vectorConj
        (generatedNonlinearShellWriteRow source shellSq wave) := by
  by_cases shellMembership :
      wave ∈ generatedOuterNonlinearShellModes source shellSq
  · have negMembership :
      waveNeg wave ∈
          generatedOuterNonlinearShellModes source shellSq :=
      (mem_generatedOuterNonlinearShellModes_waveNeg_iff
        source shellSq wave).mpr shellMembership
    simp [generatedNonlinearShellWriteRow, shellMembership,
      negMembership,
      generatedVorticityNonlinearCoefficientAt_waveNeg]
  · have negNotMembership :
      waveNeg wave ∉
          generatedOuterNonlinearShellModes source shellSq := by
      simpa using shellMembership
    simp [generatedNonlinearShellWriteRow, shellMembership,
      negNotMembership, generatedVorticityCoefficient_waveNeg]

theorem generatedNonlinearShellWriteRow_transverse
    (source : RawVorticityFourierSource)
    (shellSq : ℤ)
    (wave : IntegerWavevector) :
    complexWavevector wave ⬝ᵥ
        generatedNonlinearShellWriteRow source shellSq wave = 0 := by
  by_cases shellMembership :
      wave ∈ generatedOuterNonlinearShellModes source shellSq
  · rw [generatedNonlinearShellWriteRow, if_pos shellMembership]
    exact generatedVorticityNonlinearCoefficientAt_transverse source wave
  · rw [generatedNonlinearShellWriteRow, if_neg shellMembership]
    exact generatedVorticityCoefficient_transverse source wave

@[simp] theorem extendByGeneratedNonlinearShell_activeModes
    (source : RawVorticityFourierSource)
    (shellSq : ℤ) :
    (extendByGeneratedNonlinearShell source shellSq).activeModes =
      generatedSupport source ∪
        generatedOuterNonlinearShellModes source shellSq :=
  rfl

@[simp] theorem mem_extendByGeneratedNonlinearShell_activeModes_waveNeg_iff
    (source : RawVorticityFourierSource)
    (shellSq : ℤ)
    (wave : IntegerWavevector) :
    waveNeg wave ∈
        (extendByGeneratedNonlinearShell source shellSq).activeModes ↔
      wave ∈
        (extendByGeneratedNonlinearShell source shellSq).activeModes := by
  simp [extendByGeneratedNonlinearShell]

@[simp] theorem zero_not_mem_extendByGeneratedNonlinearShell_activeModes
    (source : RawVorticityFourierSource)
    (shellSq : ℤ) :
    0 ∉ (extendByGeneratedNonlinearShell source shellSq).activeModes := by
  simp [extendByGeneratedNonlinearShell]

theorem extendByGeneratedNonlinearShell_generatedSupport
    (source : RawVorticityFourierSource)
    (shellSq : ℤ) :
    generatedSupport (extendByGeneratedNonlinearShell source shellSq) =
      (extendByGeneratedNonlinearShell source shellSq).activeModes := by
  rw [generatedSupport]
  have negImage :
      (extendByGeneratedNonlinearShell source shellSq).activeModes.image
          waveNeg =
        (extendByGeneratedNonlinearShell source shellSq).activeModes := by
    ext wave
    constructor
    · intro membership
      rcases Finset.mem_image.mp membership with
        ⟨prior, priorMembership, equality⟩
      rw [← equality]
      exact
        (mem_extendByGeneratedNonlinearShell_activeModes_waveNeg_iff
          source shellSq prior).mpr priorMembership
    · intro membership
      refine Finset.mem_image.mpr
        ⟨waveNeg wave, ?_, waveNeg_involutive wave⟩
      exact
        (mem_extendByGeneratedNonlinearShell_activeModes_waveNeg_iff
          source shellSq wave).mpr membership
  rw [negImage, Finset.union_self]
  exact Finset.erase_eq_self.mpr
      (zero_not_mem_extendByGeneratedNonlinearShell_activeModes
        source shellSq)

theorem realitySymmetrizedVorticity_extendByGeneratedNonlinearShell
    (source : RawVorticityFourierSource)
    (shellSq : ℤ)
    {wave : IntegerWavevector}
    (membership :
      wave ∈ generatedSupport
        (extendByGeneratedNonlinearShell source shellSq)) :
    realitySymmetrizedVorticity
        (extendByGeneratedNonlinearShell source shellSq) wave =
      generatedNonlinearShellWriteRow source shellSq wave := by
  have activeMembership :
      wave ∈
        (extendByGeneratedNonlinearShell source shellSq).activeModes := by
    rwa [extendByGeneratedNonlinearShell_generatedSupport] at membership
  have negActiveMembership :
      waveNeg wave ∈
        (extendByGeneratedNonlinearShell source shellSq).activeModes :=
    (mem_extendByGeneratedNonlinearShell_activeModes_waveNeg_iff
      source shellSq wave).mpr activeMembership
  have supportedWave :
      supportedRawVorticity
          (extendByGeneratedNonlinearShell source shellSq) wave =
        generatedNonlinearShellWriteRow source shellSq wave := by
    rw [supportedRawVorticity, if_pos activeMembership]
    rfl
  have supportedNegWave :
      supportedRawVorticity
          (extendByGeneratedNonlinearShell source shellSq) (waveNeg wave) =
        generatedNonlinearShellWriteRow
          source shellSq (waveNeg wave) := by
    rw [supportedRawVorticity, if_pos negActiveMembership]
    rfl
  funext coordinate
  rw [realitySymmetrizedVorticity, supportedWave, supportedNegWave,
    generatedNonlinearShellWriteRow_waveNeg]
  simp [vectorConj]

private theorem transverseProjection_eq_self_of_transverse
    {wave : IntegerWavevector}
    {vector : ComplexCoordinateVector}
    (wave_ne_zero : wave ≠ 0)
    (transverse :
      complexWavevector wave ⬝ᵥ vector = 0) :
    transverseProjection wave vector = vector := by
  rw [transverseProjection, if_neg wave_ne_zero, transverse]
  simp

/--
The generated coefficient of the extension is exactly its canonical
piecewise write row on the whole carrier.
-/
theorem generatedVorticityCoefficient_extendByGeneratedNonlinearShell
    (source : RawVorticityFourierSource)
    (shellSq : ℤ)
    (wave : IntegerWavevector) :
    generatedVorticityCoefficient
        (extendByGeneratedNonlinearShell source shellSq) wave =
      generatedNonlinearShellWriteRow source shellSq wave := by
  by_cases membership :
      wave ∈ generatedSupport
        (extendByGeneratedNonlinearShell source shellSq)
  · have wave_ne_zero : wave ≠ 0 := by
      intro waveZero
      subst wave
      exact
        zero_not_mem_generatedSupport
          (extendByGeneratedNonlinearShell source shellSq)
          membership
    rw [generatedVorticityCoefficient, if_pos membership,
      realitySymmetrizedVorticity_extendByGeneratedNonlinearShell
        source shellSq membership,
      transverseProjection_eq_self_of_transverse
        wave_ne_zero
        (generatedNonlinearShellWriteRow_transverse
          source shellSq wave)]
  · have notActive :
      wave ∉
        (extendByGeneratedNonlinearShell source shellSq).activeModes := by
      rwa [extendByGeneratedNonlinearShell_generatedSupport] at membership
    have notOld : wave ∉ generatedSupport source := by
      intro oldMembership
      apply notActive
      simp [extendByGeneratedNonlinearShell, oldMembership]
    have notShell :
        wave ∉ generatedOuterNonlinearShellModes source shellSq := by
      intro shellMembership
      apply notActive
      simp [extendByGeneratedNonlinearShell, shellMembership]
    rw [generatedVorticityCoefficient, if_neg membership,
      generatedNonlinearShellWriteRow, if_neg notShell,
      generatedVorticityCoefficient_eq_zero_of_not_mem
        source notOld]

/-- Every old live coefficient survives the canonical whole-shell extension. -/
theorem extendByGeneratedNonlinearShell_preserves_live_coefficient
    (source : RawVorticityFourierSource)
    (shellSq : ℤ)
    {wave : IntegerWavevector}
    (live : wave ∈ generatedLiveVorticityModes source) :
    generatedVorticityCoefficient
        (extendByGeneratedNonlinearShell source shellSq) wave =
      generatedVorticityCoefficient source wave := by
  have notOuter : wave ∉ generatedActiveOuterNonlinearModes source := by
    intro outer
    unfold generatedActiveOuterNonlinearModes at outer
    split at outer
    · simp at outer
    · exact ((Finset.mem_filter.mp outer).2.2.1 live)
  have notShell :
      wave ∉ generatedOuterNonlinearShellModes source shellSq := by
    intro shellMembership
    exact notOuter
      ((mem_generatedOuterNonlinearShellModes_iff
        source shellSq wave).mp shellMembership).1
  rw [generatedVorticityCoefficient_extendByGeneratedNonlinearShell,
    generatedNonlinearShellWriteRow, if_neg notShell]

/--
Every row on the generated whole shell reads back as the complete old-source
nonlinear output coefficient which generated it.
-/
theorem extendByGeneratedNonlinearShell_newShell_coefficient
    (source : RawVorticityFourierSource)
    (shellSq : ℤ)
    {wave : IntegerWavevector}
    (membership :
      wave ∈ generatedOuterNonlinearShellModes source shellSq) :
    generatedVorticityCoefficient
        (extendByGeneratedNonlinearShell source shellSq) wave =
      generatedVorticityNonlinearCoefficientAt source wave := by
  rw [generatedVorticityCoefficient_extendByGeneratedNonlinearShell,
    generatedNonlinearShellWriteRow, if_pos membership]

/-! ## Dependent source response, reachability, and shell gap -/

/--
Dependent source-successor step.  Arbitrary shell helpers are transporters;
source ownership is supplied only by `generatedIntegerShellRespond`.
-/
inductive GeneratedIntegerShellStep
    (current : RawVorticityFourierSource) :
    RawVorticityFourierSource → Type
  | extend (shellSq : ℤ) :
      GeneratedIntegerShellStep current
        (extendByGeneratedNonlinearShell current shellSq)

namespace GeneratedIntegerShellStep

/-- Exact shell carried by a generated source step. -/
def shellSq
    {current next : RawVorticityFourierSource}
    (step : GeneratedIntegerShellStep current next) : ℤ :=
  match step with
  | .extend shellSq => shellSq

@[simp] theorem shellSq_extend
    (current : RawVorticityFourierSource)
    (shellSq : ℤ) :
    (GeneratedIntegerShellStep.extend
      (current := current) shellSq).shellSq = shellSq :=
  rfl

end GeneratedIntegerShellStep

/--
Source-owned optional successor.  The source computes both the branch and
the least whole shell before producing the dependent next source.
-/
def generatedIntegerShellRespond
    (current : RawVorticityFourierSource) :
    Option (Response GeneratedIntegerShellStep current) :=
  match generatedNextOuterNonlinearShellSq? current with
  | none => none
  | some shellSq =>
      some
        ⟨extendByGeneratedNonlinearShell current shellSq,
          GeneratedIntegerShellStep.extend shellSq⟩

/-- Least closure of the generated integer-shell response graph. -/
abbrev GeneratedIntegerShellReachable
    (seed current : RawVorticityFourierSource) :=
  NativeReachable seed generatedIntegerShellRespond current

/-- Every reachable current is exhausted by its own generated response. -/
def generatedIntegerShellDisposition
    {seed current : RawVorticityFourierSource}
    (reachable : GeneratedIntegerShellReachable seed current) :
    ReachableDisposition seed generatedIntegerShellRespond current :=
  reachable.disposition

/-- Successful response provenance recovers the internally selected shell. -/
theorem generatedIntegerShellRespond_selectedShell
    (current : RawVorticityFourierSource)
    (response : Response GeneratedIntegerShellStep current)
    (generated :
      generatedIntegerShellRespond current = some response) :
    generatedNextOuterNonlinearShellSq? current =
      some response.2.shellSq := by
  cases nextShell :
      generatedNextOuterNonlinearShellSq? current with
  | none =>
      simp [generatedIntegerShellRespond, nextShell] at generated
  | some shellSq =>
      simp only [generatedIntegerShellRespond, nextShell,
        Option.some.injEq] at generated
      cases generated
      rfl

/-- The optional response is absent exactly when the source generated no
active outer nonlinear mode. -/
theorem generatedIntegerShellRespond_eq_none_iff
    (current : RawVorticityFourierSource) :
    generatedIntegerShellRespond current = none ↔
      generatedActiveOuterNonlinearModes current = ∅ := by
  rw [← generatedNextOuterNonlinearShellSq?_eq_none_iff]
  cases nextShell :
      generatedNextOuterNonlinearShellSq? current with
  | none =>
      simp [generatedIntegerShellRespond, nextShell]
  | some shellSq =>
      simp [generatedIntegerShellRespond, nextShell]

/--
Every successful response generates a positive integer-shell gap from the
source's own current maximum.  Neither endpoint nor gap positivity is stored
in the step.
-/
theorem generatedIntegerShellRespond_shellGap
    (current : RawVorticityFourierSource)
    (response : Response GeneratedIntegerShellStep current)
    (generated :
      generatedIntegerShellRespond current = some response) :
    ∃ currentMax : ℤ,
      generatedCurrentLiveMaxShellSq? current = some currentMax ∧
        currentMax + 1 ≤ response.2.shellSq := by
  have selected :
      generatedNextOuterNonlinearShellSq? current =
        some response.2.shellSq :=
    generatedIntegerShellRespond_selectedShell
      current response generated
  rcases
      exists_outer_mode_of_generatedNextOuterNonlinearShellSq?_eq_some
        current response.2.shellSq selected with
    ⟨output, outputOuter, outputShell⟩
  cases currentMaxResult :
      generatedCurrentLiveMaxShellSq? current with
  | none =>
      unfold generatedActiveOuterNonlinearModes at outputOuter
      rw [currentMaxResult] at outputOuter
      simp at outputOuter
  | some currentMax =>
      refine ⟨currentMax, rfl, ?_⟩
      have outputOuterAtCurrentMax := outputOuter
      unfold generatedActiveOuterNonlinearModes at outputOuterAtCurrentMax
      rw [currentMaxResult] at outputOuterAtCurrentMax
      have outerLt :
          currentMax < integerWaveShellSq output :=
        (Finset.mem_filter.mp outputOuterAtCurrentMax).2.2.2.1
      rw [outputShell] at outerLt
      omega

/-! ## Fixed-edge anti-cascade regression -/

/-- Reapplying the fixed unit-shell raw update does not generate a new state. -/
theorem unitShellSharpSourceUpdate_idempotent
    (source : RawVorticityFourierSource) :
    unitShellSharpSourceUpdate (unitShellSharpSourceUpdate source) =
      unitShellSharpSourceUpdate source := by
  cases source with
  | mk activeModes rawVorticity =>
      simp only [unitShellSharpSourceUpdate]
      congr
      funext wave coordinate
      simp only [Pi.smul_apply, smul_eq_mul]
      have multiplierIdempotent :
          (unitShellSharpMultiplier wave : ℂ) *
              (unitShellSharpMultiplier wave : ℂ) =
            (unitShellSharpMultiplier wave : ℂ) := by
        exact_mod_cast unitShellSharpMultiplier_mul_self wave
      rw [← mul_assoc, multiplierIdempotent]

/--
The state-residual complement on a second fixed unit-shell application is
zero.  A surviving unprojected nonlinear outer row is therefore a demand for
a new shell, not a second copy of this idempotent state edge.
-/
theorem unitShell_second_state_trace_eq_zero
    (source : RawVorticityFourierSource) :
    linearResidualTrace unitShellCoefficientKeep
        (generatedVorticityCoefficient
          (unitShellSharpSourceUpdate source)) = 0 := by
  have retained :
      unitShellCoefficientKeep
          (generatedVorticityCoefficient
            (unitShellSharpSourceUpdate source)) =
        generatedVorticityCoefficient
          (unitShellSharpSourceUpdate source) := by
    funext wave
    rw [←
      generatedVorticityCoefficient_unitShellSharpSourceUpdate
        (unitShellSharpSourceUpdate source) wave,
      unitShellSharpSourceUpdate_idempotent]
  rw [linearResidualTrace, retained]
  simp

end

