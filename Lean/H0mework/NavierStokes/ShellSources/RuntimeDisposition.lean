import H0mework.NavierStokes.ShellSources.InfiniteLineageReceiptSquare

/-!
# Maximal runtime disposition of the generated integer-shell source

The integer-shell producer is a deterministic dependent response

```text
generatedIntegerShellRespond current :
  Option (Σ next, GeneratedIntegerShellStep current next).
```

Starting from one literal source, this module follows that response for as
long as it succeeds.  Classical case analysis yields exactly one of the two
maximal runtime shapes needed by the receipt-square cascade:

* a finite exact reachable current at which the same producer returns
  `none`; or
* an infinite lineage whose every adjacent dependent edge is the literal
  successful response of that producer.

The terminal current, branch, path length, infinite sequence, and edge
payloads are all outputs.  No termination certificate, continuation
target, shell coverage, or nonzero premise enters the producer mouth.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace ThreeDimensionalVorticityCoefficientGeneratedIntegerShellRuntimeDisposition

open SourceGeneratedNativeResponseDisposition
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientGeneratedIntegerShellSource
open ThreeDimensionalVorticityCoefficientGeneratedIntegerShellInfiniteLineageReceiptSquare

noncomputable section

/-- A finite maximal run generated by the actual integer-shell response. -/
structure GeneratedIntegerShellTerminalRun
    (seed : RawVorticityFourierSource) : Type where
  terminal : RawVorticityFourierSource
  arrival : GeneratedIntegerShellReachable seed terminal
  stopped : generatedIntegerShellRespond terminal = none

/-- At a generated finite terminal, the complete active outer nonlinear
support is empty. -/
theorem GeneratedIntegerShellTerminalRun.noActiveOuterNonlinearModes
    {seed : RawVorticityFourierSource}
    (run : GeneratedIntegerShellTerminalRun seed) :
    generatedActiveOuterNonlinearModes run.terminal = ∅ :=
  (generatedIntegerShellRespond_eq_none_iff run.terminal).mp run.stopped

/-- If no finite generated terminal exists, every exact reachable current
has a source-owned dependent response. -/
private theorem exists_forcedResponse
    (seed : RawVorticityFourierSource)
    (noTerminal : ¬ Nonempty (GeneratedIntegerShellTerminalRun seed))
    (node :
      Σ current : RawVorticityFourierSource,
        GeneratedIntegerShellReachable seed current) :
    ∃ response : Response GeneratedIntegerShellStep node.1,
      generatedIntegerShellRespond node.1 = some response := by
  cases generated : generatedIntegerShellRespond node.1 with
  | none =>
      exact False.elim <|
        noTerminal <|
          ⟨{ terminal := node.1
             arrival := node.2
             stopped := generated }⟩
  | some response =>
      exact ⟨response, rfl⟩

/-- The unique dependent response selected by the actual producer at one
reachable current in a nonterminating run. -/
private noncomputable def forcedResponse
    (seed : RawVorticityFourierSource)
    (noTerminal : ¬ Nonempty (GeneratedIntegerShellTerminalRun seed))
    (node :
      Σ current : RawVorticityFourierSource,
        GeneratedIntegerShellReachable seed current) :
    Response GeneratedIntegerShellStep node.1 :=
  Classical.choose (exists_forcedResponse seed noTerminal node)

/-- The forced response is still the literal output of the actual source
producer; `noTerminal` is used only to eliminate its impossible `none`
branch. -/
private theorem forcedResponse_generated
    (seed : RawVorticityFourierSource)
    (noTerminal : ¬ Nonempty (GeneratedIntegerShellTerminalRun seed))
    (node :
      Σ current : RawVorticityFourierSource,
        GeneratedIntegerShellReachable seed current) :
    generatedIntegerShellRespond node.1 =
      some (forcedResponse seed noTerminal node) := by
  exact Classical.choose_spec
    (exists_forcedResponse seed noTerminal node)

/-- The proof-relevant maximal run when no generated finite terminal
exists.  Every successor node is built by `NativeReachable.step` from the
same exact producer equality. -/
private noncomputable def infiniteReachableRun
    (seed : RawVorticityFourierSource)
    (noTerminal : ¬ Nonempty (GeneratedIntegerShellTerminalRun seed)) :
    ℕ →
      Σ current : RawVorticityFourierSource,
        GeneratedIntegerShellReachable seed current
  | 0 => ⟨seed, NativeReachable.initial⟩
  | index + 1 =>
      let node := infiniteReachableRun seed noTerminal index
      let response := forcedResponse seed noTerminal node
      ⟨response.1,
        NativeReachable.step node.2
          (forcedResponse_generated seed noTerminal node)⟩

/-- Absence of a finite terminal generates an actual infinite lineage.
Neither its currents nor its dependent steps are caller-selected. -/
private noncomputable def infiniteLineageOfNoTerminal
    (seed : RawVorticityFourierSource)
    (noTerminal : ¬ Nonempty (GeneratedIntegerShellTerminalRun seed)) :
    GeneratedIntegerShellInfiniteLineage where
  current index :=
    (infiniteReachableRun seed noTerminal index).1
  step index :=
    (forcedResponse seed noTerminal
      (infiniteReachableRun seed noTerminal index)).2
  generated index :=
    forcedResponse_generated seed noTerminal
      (infiniteReachableRun seed noTerminal index)

@[simp] theorem infiniteLineageOfNoTerminal_current_zero
    (seed : RawVorticityFourierSource)
    (noTerminal : ¬ Nonempty (GeneratedIntegerShellTerminalRun seed)) :
    (infiniteLineageOfNoTerminal seed noTerminal).current 0 = seed :=
  rfl

/-- Exhaustive maximal runtime generated from one literal source seed. -/
inductive GeneratedIntegerShellRuntimeDisposition
    (seed : RawVorticityFourierSource) : Type
  | terminal
      (run : GeneratedIntegerShellTerminalRun seed)
  | infinite
      (lineage : GeneratedIntegerShellInfiniteLineage)
      (startsAtSeed : lineage.current 0 = seed)

/-- Follow the actual dependent response maximally: it either generates a
finite exact terminal or an infinite exact lineage.

The case split is internal.  The caller supplies only the literal source
seed.
-/
noncomputable def generatedIntegerShellRuntimeDisposition
    (seed : RawVorticityFourierSource) :
    GeneratedIntegerShellRuntimeDisposition seed := by
  by_cases terminalExists :
      Nonempty (GeneratedIntegerShellTerminalRun seed)
  · exact .terminal (Classical.choice terminalExists)
  · exact
      .infinite
        (infiniteLineageOfNoTerminal seed terminalExists)
        (infiniteLineageOfNoTerminal_current_zero
          seed terminalExists)

end

end ThreeDimensionalVorticityCoefficientGeneratedIntegerShellRuntimeDisposition
end NavierStokes
end SaturationMonoid
