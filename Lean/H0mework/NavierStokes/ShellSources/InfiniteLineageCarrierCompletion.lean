namespace GeneratedIntegerShellInfiniteLineage

/-! ## One exact source-owned additive update -/

/-- Every nonzero flattened coordinate of the current source lies on a live
source wave. -/
private theorem current_live_of_mem_generatedCoefficientCarrier_support
    (source : RawVorticityFourierSource)
    {index : IntegerShellCoefficientCoordinate}
    (indexMem :
      index ∈ (generatedCoefficientCarrier source).support) :
    index.1 ∈ generatedLiveVorticityModes source := by
  have coordinateNonzero :
      generatedVorticityCoefficient source index.1 index.2 ≠ 0 := by
    simpa only [generatedCoefficientCarrier_apply] using
      (Finsupp.mem_support_iff.mp indexMem)
  have coefficientNonzero :
      generatedVorticityCoefficient source index.1 ≠ 0 := by
    intro coefficientZero
    exact coordinateNonzero
      (congrFun coefficientZero index.2)
  have waveMem : index.1 ∈ generatedSupport source := by
    by_contra waveNotMem
    exact coefficientNonzero
      (generatedVorticityCoefficient_eq_zero_of_not_mem
        source waveNotMem)
  exact
    (mem_generatedLiveVorticityModes_iff source index.1).mpr
      ⟨waveMem, coefficientNonzero⟩

/--
The current whole carrier support is disjoint from the support written by
its actual source-generated receipt.
-/
theorem generatedCoefficientCarrier_support_disjoint_receiptTrace
    (receipt : GeneratedIntegerShellReceipt) :
    Disjoint
      (generatedCoefficientCarrier receipt.current).support
      (generatedIntegerShellReceiptTrace receipt).support := by
  classical
  rw [Finset.disjoint_left]
  intro index currentMem traceMem
  have currentLive :
      index.1 ∈
        generatedLiveVorticityModes receipt.current :=
    current_live_of_mem_generatedCoefficientCarrier_support
      receipt.current currentMem
  have newShell :
      index.1 ∈ receipt.wholeShellModes :=
    (mem_generatedIntegerShellTrace_support_iff
      receipt.current receipt.selectedShellSq index).mp
        traceMem |>.1
  exact
    Finset.disjoint_left.mp
      receipt.liveModes_disjoint_wholeShell
      currentLive newShell

/--
Exact one-step carrier-mass write-back.  Positivity and disjointness are
generated by the receipt and are not theorem premises.
-/
theorem receipt_generatedCoefficientCarrier_normSq_next
    (receipt : GeneratedIntegerShellReceipt) :
    coefficientCarrierNormSq
        (generatedCoefficientCarrier receipt.next) =
      coefficientCarrierNormSq
          (generatedCoefficientCarrier receipt.current) +
        coefficientCarrierNormSq
          (generatedIntegerShellReceiptTrace receipt) := by
  rw [coefficientCarrier_next receipt,
    coefficientCarrierNormSq_add_of_disjoint_support
      (generatedCoefficientCarrier_support_disjoint_receiptTrace
        receipt)]

/-- One actual lineage response increases whole carrier mass by exactly its
generated positive quantum. -/
theorem generatedCoefficientCarrier_normSq_current_succ
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (index : ℕ) :
    coefficientCarrierNormSq
        (generatedCoefficientCarrier
          (lineage.current (index + 1))) =
      coefficientCarrierNormSq
          (generatedCoefficientCarrier
            (lineage.current index)) +
        lineage.receiptQuantum index := by
  rw [← lineage.receipt_next index]
  simpa [receiptQuantum] using
    receipt_generatedCoefficientCarrier_normSq_next
      (lineage.receipt index)

/-! ## Exact endpoint telescope and PDE enstrophy alignment -/

/-- Whole carrier mass at a finite endpoint is seed mass plus the exact sum
of all generated receipt quanta in the prefix. -/
theorem generatedCoefficientCarrier_normSq_current_eq_seed_add_sum_range
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (length : ℕ) :
    coefficientCarrierNormSq
        (generatedCoefficientCarrier
          (lineage.current length)) =
      coefficientCarrierNormSq
          (generatedCoefficientCarrier
            (lineage.current 0)) +
        ∑ index ∈ Finset.range length,
          lineage.receiptQuantum index := by
  induction length with
  | zero =>
      simp
  | succ length inductionHypothesis =>
      rw [generatedCoefficientCarrier_normSq_current_succ lineage
        length, inductionHypothesis, Finset.sum_range_succ]
      ring

/-- The flattened carrier support lies inside the source's finite wave
support times all vector coordinates. -/
private theorem generatedCoefficientCarrier_support_subset
    (source : RawVorticityFourierSource) :
    (generatedCoefficientCarrier source).support ⊆
      generatedSupport source ×ˢ
        (Finset.univ : Finset Coordinate) := by
  intro index indexMem
  rw [Finset.mem_product]
  constructor
  · by_contra waveNotMem
    have coefficientZero :
        generatedVorticityCoefficient source index.1 = 0 :=
      generatedVorticityCoefficient_eq_zero_of_not_mem
        source waveNotMem
    have carrierZero :
        generatedCoefficientCarrier source index = 0 := by
      rw [generatedCoefficientCarrier_apply, coefficientZero]
      rfl
    exact
      (Finsupp.mem_support_iff.mp indexMem) carrierZero
  · simp

/--
Exact identification of the finite flattened coefficient mass with the PDE
coefficient enstrophy at the same generated source.
-/
theorem generatedCoefficientCarrier_normSq_eq_coefficientEnstrophy
    (source : RawVorticityFourierSource) :
    coefficientCarrierNormSq
        (generatedCoefficientCarrier source) =
      finiteStateVorticityCoefficientEnstrophy
        (generatedSupport source)
        (generatedComplexVorticityState source
          (generatedSupport source)) := by
  classical
  rw [coefficientCarrierNormSq]
  rw [Finset.sum_subset
    (generatedCoefficientCarrier_support_subset source)]
  · rw [Finset.sum_product]
    unfold finiteStateVorticityCoefficientEnstrophy
      complexCoordinateAmplitudeSq
    apply Finset.sum_congr rfl
    intro wave waveMem
    simp only [generatedCoefficientCarrier_apply,
      generatedComplexVorticityState_apply, waveMem, if_true]
  · intro index indexMem indexNotSupport
    have carrierZero :
        generatedCoefficientCarrier source index = 0 :=
      Finsupp.notMem_support_iff.mp indexNotSupport
    simp [carrierZero]

/-- The lineage endpoint form of the same exact carrier/enstrophy bridge. -/
theorem generatedCoefficientCarrier_normSq_current_eq_coefficientEnstrophy
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (length : ℕ) :
    coefficientCarrierNormSq
        (generatedCoefficientCarrier
          (lineage.current length)) =
      finiteStateVorticityCoefficientEnstrophy
        (generatedSupport (lineage.current length))
        (generatedComplexVorticityState
          (lineage.current length)
          (generatedSupport (lineage.current length))) :=
  generatedCoefficientCarrier_normSq_eq_coefficientEnstrophy
    (lineage.current length)

/-! ## Linear receipt summability in one critical regime -/

/--
Every prefix sum of receipt quanta is controlled directly by the common
critical coefficient-enstrophy ceiling.
-/
theorem receiptQuantum_sum_range_le_criticalCeiling
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (ν : Viscosity)
    (θ : ℝ)
    (criticalMargin :
      ∀ length : ℕ,
        ThreeDimensionalVorticityCoefficientFiniteGalerkinCriticalEnstrophyBarrier.criticalEnstrophyLatticeConstant *
            finiteStateVorticityCoefficientEnstrophy
              (generatedSupport (lineage.current length))
              (generatedComplexVorticityState
                (lineage.current length)
                (generatedSupport (lineage.current length))) ≤
          θ * ν.coeff ^ 2 * (2 * Real.pi) ^ 2)
    (length : ℕ) :
    (∑ index ∈ Finset.range length,
        lineage.receiptQuantum index) ≤
      criticalCoefficientEnstrophyCeiling ν θ := by
  let path : GeneratedCriticalScalePath ν θ :=
    { seed := lineage.current 0
      current := lineage.current length
      arrival := lineage.prefixReachable length
      initialMargin := criticalMargin length }
  have endpointLe :
      coefficientCarrierNormSq
          (generatedCoefficientCarrier
            (lineage.current length)) ≤
        criticalCoefficientEnstrophyCeiling ν θ := by
    rw [generatedCoefficientCarrier_normSq_current_eq_coefficientEnstrophy
      lineage]
    simpa [path] using path.initialEnstrophy_le_ceiling
  have seedNonneg :
      0 ≤
        coefficientCarrierNormSq
          (generatedCoefficientCarrier
            (lineage.current 0)) :=
    coefficientCarrierNormSq_nonneg _
  rw [generatedCoefficientCarrier_normSq_current_eq_seed_add_sum_range
    lineage]
    at endpointLe
  linarith

/--
Strong source completion: receipt quanta themselves, not merely their
squares, form a summable series in every common strict-critical lineage.
-/
theorem receiptQuantum_summable
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (ν : Viscosity)
    (θ : ℝ)
    (criticalMargin :
      ∀ length : ℕ,
        ThreeDimensionalVorticityCoefficientFiniteGalerkinCriticalEnstrophyBarrier.criticalEnstrophyLatticeConstant *
            finiteStateVorticityCoefficientEnstrophy
              (generatedSupport (lineage.current length))
              (generatedComplexVorticityState
                (lineage.current length)
                (generatedSupport (lineage.current length))) ≤
          θ * ν.coeff ^ 2 * (2 * Real.pi) ^ 2) :
    Summable lineage.receiptQuantum := by
  apply summable_of_sum_range_le
  · intro index
    exact lineage.receiptQuantum_nonneg index
  · exact
      receiptQuantum_sum_range_le_criticalCeiling
        lineage ν θ criticalMargin

/-! ## Exact finite-prefix Cauchy ledger -/

/-- Literal whole-carrier trace written by one lineage occurrence. -/
def receiptTrace
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (index : ℕ) :
    IntegerShellCoefficientCarrier :=
  generatedIntegerShellReceiptTrace (lineage.receipt index)

/-- Cumulative trace on one finite lineage prefix. -/
def prefixCumulativeTrace
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (length : ℕ) :
    IntegerShellCoefficientCarrier :=
  generatedIntegerShellCumulativeTrace
    (lineage.prefixReachable length)

/-- Source-generated trace list on one prefix. -/
def prefixReceiptTraces
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (length : ℕ) :
    List IntegerShellCoefficientCarrier :=
  (List.range length).map (receiptTrace lineage)

theorem prefixCumulativeTrace_eq_prefixReceiptTraces_sum
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (length : ℕ) :
    prefixCumulativeTrace lineage length =
      (prefixReceiptTraces lineage length).sum := by
  unfold prefixCumulativeTrace prefixReceiptTraces
    generatedIntegerShellCumulativeTrace
    generatedIntegerShellReachableTraces
  rw [lineage.prefixReachable_receipts length]
  simp only [List.map_map]
  rfl

/-- Receipt traces in every actual prefix have pairwise-disjoint whole
flattened supports. -/
theorem prefixReceiptTraces_pairwise_disjoint
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (length : ℕ) :
    (prefixReceiptTraces lineage length).Pairwise
      (fun left right : IntegerShellCoefficientCarrier =>
        Disjoint left.support right.support) := by
  have pairwise :=
    generatedIntegerShellReachableTraces_pairwise_disjoint
      (lineage.prefixReachable length)
  unfold prefixReceiptTraces receiptTrace
  unfold generatedIntegerShellReachableTraces at pairwise
  rw [lineage.prefixReachable_receipts length] at pairwise
  simp only [List.map_map] at pairwise
  change
    ((List.range length).map
      (fun index =>
        generatedIntegerShellReceiptTrace
          (lineage.receipt index))).Pairwise
        (fun left right : IntegerShellCoefficientCarrier =>
          Disjoint left.support right.support)
    at pairwise
  exact pairwise

/-- Chronological receipt traces between prefix `start` and prefix
`start + length`. -/
def tailReceiptTraces
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (start length : ℕ) :
    List IntegerShellCoefficientCarrier :=
  (List.range length).map
    fun offset => receiptTrace lineage (start + offset)

/-- Whole carrier trace written by a finite lineage tail. -/
def tailCumulativeTrace
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (start length : ℕ) :
    IntegerShellCoefficientCarrier :=
  (tailReceiptTraces lineage start length).sum

theorem prefixCumulativeTrace_add_tail
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (start length : ℕ) :
    prefixCumulativeTrace lineage (start + length) =
      prefixCumulativeTrace lineage start +
        tailCumulativeTrace lineage start length := by
  rw [prefixCumulativeTrace_eq_prefixReceiptTraces_sum,
    prefixCumulativeTrace_eq_prefixReceiptTraces_sum]
  unfold prefixReceiptTraces tailCumulativeTrace tailReceiptTraces
  rw [List.range_add, List.map_append, List.sum_append]
  simp only [List.map_map, Function.comp_def]

theorem tailReceiptTraces_pairwise_disjoint
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (start length : ℕ) :
    (tailReceiptTraces lineage start length).Pairwise
      (fun left right : IntegerShellCoefficientCarrier =>
        Disjoint left.support right.support) := by
  have full :=
    prefixReceiptTraces_pairwise_disjoint
      lineage (start + length)
  have decomposition :
      prefixReceiptTraces lineage (start + length) =
        prefixReceiptTraces lineage start ++
          tailReceiptTraces lineage start length := by
    unfold prefixReceiptTraces tailReceiptTraces
    rw [List.range_add, List.map_append]
    simp only [List.map_map, Function.comp_def]
  rw [decomposition, List.pairwise_append] at full
  exact full.2.1

private theorem disjoint_support_list_sum
    (head : IntegerShellCoefficientCarrier)
    (tail : List IntegerShellCoefficientCarrier)
    (headDisjoint :
      ∀ later ∈ tail,
        Disjoint head.support later.support) :
    Disjoint head.support tail.sum.support := by
  classical
  rw [Finset.disjoint_left]
  intro index indexHead indexTail
  have indexUnion :
      index ∈
        tail.foldr (Finsupp.support · ⊔ ·) ∅ :=
    List.support_sum_subset tail indexTail
  rcases List.mem_foldr_sup_support_iff.mp indexUnion with
    ⟨later, laterMem, indexLater⟩
  exact
    Finset.disjoint_left.mp
      (headDisjoint later laterMem)
      indexHead indexLater

private theorem coefficientCarrierNormSq_list_sum
    (traces : List IntegerShellCoefficientCarrier)
    (pairwise :
      traces.Pairwise
        (fun left right : IntegerShellCoefficientCarrier =>
          Disjoint left.support right.support)) :
    coefficientCarrierNormSq traces.sum =
      (traces.map coefficientCarrierNormSq).sum := by
  induction traces with
  | nil =>
      simp [coefficientCarrierNormSq]
  | cons head tail inductionHypothesis =>
      rw [List.pairwise_cons] at pairwise
      rw [List.sum_cons, List.map_cons, List.sum_cons,
        coefficientCarrierNormSq_add_of_disjoint_support
          (disjoint_support_list_sum head tail pairwise.1),
        inductionHypothesis pairwise.2]

/-- Exact mass of a finite receipt tail. -/
theorem tailCumulativeTrace_normSq_eq_sum_range
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (start length : ℕ) :
    coefficientCarrierNormSq
        (tailCumulativeTrace lineage start length) =
      ∑ offset ∈ Finset.range length,
        lineage.receiptQuantum (start + offset) := by
  unfold tailCumulativeTrace
  rw [coefficientCarrierNormSq_list_sum
    (tailReceiptTraces lineage start length)
    (tailReceiptTraces_pairwise_disjoint lineage start length)]
  unfold tailReceiptTraces
  simp only [List.map_map, Function.comp_def]
  change
    ((List.range length).map
      (fun offset =>
        lineage.receiptQuantum (start + offset))).sum =
      ∑ offset ∈ Finset.range length,
        lineage.receiptQuantum (start + offset)
  simpa only [List.toFinset_range] using
    (List.sum_toFinset
      (fun offset =>
        lineage.receiptQuantum (start + offset))
      (List.nodup_range (n := length))).symm

/-- Exact source write-back across a finite interval of lineage prefixes. -/
theorem generatedCoefficientCarrier_sub_eq_tailCumulativeTrace
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (start length : ℕ) :
    generatedCoefficientCarrier
          (lineage.current (start + length)) -
        generatedCoefficientCarrier
          (lineage.current start) =
      tailCumulativeTrace lineage start length := by
  have endpointWrite :=
    generatedCoefficientCarrier_eq_seed_add_cumulativeTrace
      (lineage.prefixReachable (start + length))
  have startWrite :=
    generatedCoefficientCarrier_eq_seed_add_cumulativeTrace
      (lineage.prefixReachable start)
  have traceSplit :
      generatedIntegerShellCumulativeTrace
          (lineage.prefixReachable (start + length)) =
        generatedIntegerShellCumulativeTrace
            (lineage.prefixReachable start) +
          tailCumulativeTrace lineage start length :=
    prefixCumulativeTrace_add_tail lineage start length
  change
    generatedCoefficientCarrier
          (lineage.current (start + length)) -
        generatedCoefficientCarrier
          (lineage.current start) =
      tailCumulativeTrace lineage start length
  rw [endpointWrite, startWrite, traceSplit]
  abel

/--
Finite-prefix Cauchy ledger on the whole flattened coefficient carrier: the
exact squared `ℓ²` difference of two ordered prefixes is the intervening
receipt tail sum.
-/
theorem generatedCoefficientCarrier_sub_normSq_eq_tail_sum
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (start length : ℕ) :
    coefficientCarrierNormSq
        (generatedCoefficientCarrier
              (lineage.current (start + length)) -
            generatedCoefficientCarrier
              (lineage.current start)) =
      ∑ offset ∈ Finset.range length,
        lineage.receiptQuantum (start + offset) := by
  rw [generatedCoefficientCarrier_sub_eq_tailCumulativeTrace,
    tailCumulativeTrace_normSq_eq_sum_range]

/--
Forward Cauchy control of the actual whole carriers.  After one generated
prefix, every later finite source extension has arbitrarily small exact
flattened `ℓ²` difference mass.
-/
theorem generatedCoefficientCarrier_forwardCauchy
    (lineage : GeneratedIntegerShellInfiniteLineage)
    (ν : Viscosity)
    (θ : ℝ)
    (criticalMargin :
      ∀ length : ℕ,
        ThreeDimensionalVorticityCoefficientFiniteGalerkinCriticalEnstrophyBarrier.criticalEnstrophyLatticeConstant *
            finiteStateVorticityCoefficientEnstrophy
              (generatedSupport (lineage.current length))
              (generatedComplexVorticityState
                (lineage.current length)
                (generatedSupport (lineage.current length))) ≤
          θ * ν.coeff ^ 2 * (2 * Real.pi) ^ 2) :
    ∀ ε > 0,
      ∃ cutoff : ℕ,
        ∀ start ≥ cutoff,
          ∀ length : ℕ,
            coefficientCarrierNormSq
                (generatedCoefficientCarrier
                      (lineage.current (start + length)) -
                    generatedCoefficientCarrier
                      (lineage.current start)) <
              ε := by
  intro ε εPos
  have partialCauchy :
      CauchySeq
        (fun length =>
          ∑ index ∈ Finset.range length,
            lineage.receiptQuantum index) :=
    (receiptQuantum_summable
      lineage ν θ criticalMargin).hasSum.tendsto_sum_nat.cauchySeq
  rcases (Metric.cauchySeq_iff.mp partialCauchy)
      ε εPos with
    ⟨cutoff, partialClose⟩
  refine ⟨cutoff, ?_⟩
  intro start startGe length
  have startLeEnd : start ≤ start + length :=
    Nat.le_add_right start length
  have cutoffLeEnd : cutoff ≤ start + length :=
    startGe.trans startLeEnd
  have endpointClose :=
    partialClose (start + length) cutoffLeEnd
      start startGe
  have tailNonneg :
      0 ≤
        ∑ offset ∈ Finset.range length,
          lineage.receiptQuantum (start + offset) :=
    Finset.sum_nonneg fun offset offsetMem =>
      lineage.receiptQuantum_nonneg (start + offset)
  rw [generatedCoefficientCarrier_sub_normSq_eq_tail_sum]
  simpa [Finset.sum_range_add, Real.dist_eq,
    abs_of_nonneg tailNonneg] using endpointClose

end GeneratedIntegerShellInfiniteLineage

