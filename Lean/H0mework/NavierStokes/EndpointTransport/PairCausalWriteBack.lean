noncomputable section

/-- Every source-generated cofinal pair event is a literal coordinate of the
complete component-occurrence stream written by the endpoint macro.  This is
the same native index, not a post-hoc output or pair reindexing. -/
theorem wholeRestartEndpointMacro_writtenCofinalPairOccurrence
    {nu : Viscosity}
    (initial : GeneratedWholeRestartCurrent nu)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) :
    let receipt :=
      generatedWholeRestartCofinalPairCausalCommutatorReceipt
        initial elapsedBounded index
    wholeRestartEndpointComponentTraceLedger initial
        (wholeRestartEndpointComponentMacroUpdate accumulationRead)
        receipt.eventIndex =
      wholeRestartEndpointComponentOccurrenceStream
        initial receipt.eventIndex := by
  rfl

/-- The cofinal pair and its reflected companion are compiled on the same
actual restart receipt.  Both equalities precede scalar aggregation and use
the event index generated by the source lineage itself. -/
theorem wholeRestartEndpointMacro_writtenCofinalPair_relationCompilers
    {nu : Viscosity}
    (initial : GeneratedWholeRestartCurrent nu)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) :
    let receipt :=
      generatedWholeRestartCofinalPairCausalCommutatorReceipt
        initial elapsedBounded index
    wholeRestartPairDuhamelOccurrence initial receipt.eventIndex
          receipt.output receipt.first +
        wholeRestartPairDuhamelOccurrence initial receipt.eventIndex
          receipt.output receipt.second =
        fourierCurlCoefficient receipt.output
          (wholeRestartSymmetricVelocityPairDuhamelOccurrence
            initial receipt.eventIndex receipt.first receipt.second) ∧
      actualWholeVelocityBilinearEnergyDuhamelWork
            (run initial receipt.eventIndex).nextContact.prefixReceipt
            receipt.first receipt.second
            ⟨(run initial receipt.eventIndex).nextContact.time.1,
              ⟨(run initial receipt.eventIndex).nextContact.time_pos.le,
                le_rfl⟩⟩ +
          actualWholeVelocityBilinearEnergyDuhamelWork
            (run initial receipt.eventIndex).nextContact.prefixReceipt
            receipt.first
              (outputNegSecondEquiv receipt.first receipt.second)
            ⟨(run initial receipt.eventIndex).nextContact.time.1,
              ⟨(run initial receipt.eventIndex).nextContact.time_pos.le,
                le_rfl⟩⟩ =
        wholeRestartVelocityTriadHeatCommutatorTrace initial
          receipt.eventIndex receipt.first receipt.second := by
  dsimp only
  let receipt :=
    generatedWholeRestartCofinalPairCausalCommutatorReceipt
      initial elapsedBounded index
  exact
    ⟨receipt.pairDuhamel_add_swap_eq_velocityPair_curl,
      wholeRestartVelocityBilinearEnergyWork_add_reflect_eq_heatCommutator
        initial receipt.eventIndex receipt.first receipt.second⟩

/-- Exact consume-before-quotient checkpoint.  The actual endpoint write
contains the generated pair event in its complete occurrence ledger; that
same pair is nonzero and either leaves a visible causal commutator or, when
the commutator vanishes, writes an independently generated next-pair keep or
causal trace. -/
theorem wholeRestartEndpointMacro_writtenCofinalPair_noSilentLoss
    {nu : Viscosity}
    (initial : GeneratedWholeRestartCurrent nu)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) :
    let receipt :=
      generatedWholeRestartCofinalPairCausalCommutatorReceipt
        initial elapsedBounded index
    wholeRestartEndpointComponentTraceLedger initial
        (wholeRestartEndpointComponentMacroUpdate accumulationRead)
        receipt.eventIndex =
        wholeRestartEndpointComponentOccurrenceStream
          initial receipt.eventIndex ∧
      wholeRestartPairDuhamelOccurrence initial receipt.eventIndex
          receipt.output receipt.first ≠ 0 ∧
      (wholeRestartVelocityTriadHeatCommutatorTrace initial
            receipt.eventIndex receipt.first receipt.second ≠ 0 ∨
        (wholeRestartVelocityTriadHeatCommutatorTrace initial
              receipt.eventIndex receipt.first receipt.second = 0 ∧
          (wholeRestartNextPairOccurrence initial receipt.eventIndex
                receipt.output receipt.first ≠ 0 ∨
            wholeRestartPairDuhamelCausalTrace initial receipt.eventIndex
              receipt.output receipt.first ≠ 0))) := by
  dsimp only
  let receipt :=
    generatedWholeRestartCofinalPairCausalCommutatorReceipt
      initial elapsedBounded index
  have noSilent :=
    generatedWholeRestartCofinalPairCausalCommutatorLineage_noSilentLoss
      initial elapsedBounded index
  exact
    ⟨wholeRestartEndpointMacro_writtenCofinalPairOccurrence
        initial elapsedBounded index,
      noSilent.1,
      noSilent.2⟩

/-- The typed pair relation ledger and the aligned kinetic ledger are written
by one endpoint macro phase and have the same already-generated unforced
physical successor.  This equation does not interpret either trace as a
forcing term. -/
theorem wholeRestartEndpointMacro_causalPair_and_aligned_physicalWrite
    {nu : Viscosity}
    (initial : GeneratedWholeRestartCurrent nu)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    (wholeRestartEndpointComponentMacroFrame initial elapsedBounded
        (wholeRestartEndpointComponentMacroUpdate accumulationRead)).1 =
        afterCurrent initial elapsedBounded 0 ∧
      (wholeRestartEndpointAlignedMacroFrame initial elapsedBounded
        (wholeRestartEndpointComponentMacroUpdate accumulationRead)).1 =
        afterCurrent initial elapsedBounded 0 := by
  exact
    ⟨by
      rw [wholeRestartEndpointComponentMacroFrame_update, afterCurrent_zero],
      wholeRestartEndpointAlignedMacroFrame_physical_eq_afterCurrent
        elapsedBounded⟩

/-- The exact cofinal events embedded in the endpoint ledger approach the
same source-generated accumulation time.  Thus the written relation ledger
is an endpoint trace, not a collection of unrelated finite calibrations. -/
theorem wholeRestartEndpointMacro_writtenCofinalPairTime_tendsto_accumulation
    {nu : Viscosity}
    (initial : GeneratedWholeRestartCurrent nu)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    Tendsto
      (fun index =>
        elapsedTime initial
          (generatedWholeRestartCofinalPairCausalCommutatorIndex
            initial elapsedBounded index))
      atTop
      (nhds (wholeRestartVelocityAccumulationTime initial)) :=
  generatedWholeRestartCofinalPairCausalCommutatorTime_tendsto_endpoint
    initial elapsedBounded

end

