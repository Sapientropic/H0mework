noncomputable section

/-- Source-generated refinement index selecting the physical-velocity
subsequence inside the canonical kinetic endpoint lineage. -/
def wholeRestartEndpointKineticRefinementIndex
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) : ℕ :=
  (generatedWholeRestartVelocityEndpointUniformKineticViscousLedger
    initial elapsedBounded).family.endpointReceipt.velocitySubsubsequence index

/-- The kinetic residual attached to the exact velocity-refined endpoint
occurrence used by the physical endpoint compiler. -/
def wholeRestartEndpointAlignedKineticResidual
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) : WholeRestartKineticEndpointState :=
  let endpointReceipt :=
    (generatedWholeRestartVelocityEndpointUniformKineticViscousLedger
      initial elapsedBounded).family.endpointReceipt
  wholeRestartKineticEndpointResidual initial
    endpointReceipt.kineticReceipt.toGeneratedWholeRestartKineticWeakEndpoint
    (wholeRestartEndpointKineticRefinementIndex
      initial elapsedBounded index)

/-- The refined kinetic residual and the component macro ledger really use
the same actual whole-restart current. -/
theorem wholeRestartEndpointAlignedKineticResidual_sameCurrent
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) :
    let endpointReceipt :=
      (generatedWholeRestartVelocityEndpointUniformKineticViscousLedger
        initial elapsedBounded).family.endpointReceipt
    wholeRestartKineticEndpointSelectedCurrent initial
        endpointReceipt.kineticReceipt.toGeneratedWholeRestartKineticWeakEndpoint
        (wholeRestartEndpointKineticRefinementIndex
          initial elapsedBounded index) =
      run initial
        (wholeRestartEndpointSelectedOccurrenceIndex
          initial elapsedBounded index) := by
  rfl

/-- The shared actual indices form a genuine cofinal source lineage. -/
theorem wholeRestartEndpointSelectedOccurrenceIndex_strict
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) :
    wholeRestartEndpointSelectedOccurrenceIndex
        initial elapsedBounded index <
      wholeRestartEndpointSelectedOccurrenceIndex
        initial elapsedBounded (index + 1) := by
  let endpointReceipt :=
    (generatedWholeRestartVelocityEndpointUniformKineticViscousLedger
      initial elapsedBounded).family.endpointReceipt
  exact endpointReceipt.subsequence_strictMono (Nat.lt_succ_self index)

theorem wholeRestartEndpointKineticRefinementIndex_strict
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) :
    wholeRestartEndpointKineticRefinementIndex
        initial elapsedBounded index <
      wholeRestartEndpointKineticRefinementIndex
        initial elapsedBounded (index + 1) := by
  exact
    (generatedWholeRestartVelocityEndpointUniformKineticViscousLedger
      initial elapsedBounded).family.endpointReceipt.velocitySubsubsequence_strictMono
        (Nat.lt_succ_self index)

/-- Number of base kinetic-endpoint steps between consecutive velocity-refined
occurrences. -/
def wholeRestartEndpointKineticRefinementGap
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) : ℕ :=
  wholeRestartEndpointKineticRefinementIndex
      initial elapsedBounded (index + 1) -
    wholeRestartEndpointKineticRefinementIndex
      initial elapsedBounded index

theorem wholeRestartEndpointKineticRefinementGap_pos
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) :
    0 < wholeRestartEndpointKineticRefinementGap
      initial elapsedBounded index := by
  have strict :=
    wholeRestartEndpointKineticRefinementIndex_strict
      elapsedBounded index
  unfold wholeRestartEndpointKineticRefinementGap
  omega

/-- Number of literal old-run native updates between two consecutive refined
endpoint occurrences. -/
def wholeRestartEndpointSelectedOccurrenceGap
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) : ℕ :=
  wholeRestartEndpointSelectedOccurrenceIndex
      initial elapsedBounded (index + 1) -
    wholeRestartEndpointSelectedOccurrenceIndex
      initial elapsedBounded index

theorem wholeRestartEndpointSelectedOccurrenceGap_pos
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) :
    0 < wholeRestartEndpointSelectedOccurrenceGap
      initial elapsedBounded index := by
  have strict :=
    wholeRestartEndpointSelectedOccurrenceIndex_strict
      elapsedBounded index
  unfold wholeRestartEndpointSelectedOccurrenceGap
  omega

/-- Any finite offset in the authoritative whole run is literal iteration of
the source-owned native `.next` update. -/
theorem wholeRestart_run_add_eq_iterate_next
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (start steps : ℕ) :
    run initial (start + steps) =
      (GeneratedWholeRestartCurrent.next^[steps]) (run initial start) := by
  induction steps with
  | zero => simp
  | succ steps inductionHypothesis =>
      rw [Nat.add_succ, run_succ, inductionHypothesis,
        Function.iterate_succ_apply']

/-- Consecutive refined endpoint occurrences are connected by the exact
nonempty finite path of old source-owned unforced `.next` writes. -/
theorem wholeRestartEndpointSelectedCurrent_nativeGapPath
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) :
    run initial
        (wholeRestartEndpointSelectedOccurrenceIndex
          initial elapsedBounded (index + 1)) =
      (GeneratedWholeRestartCurrent.next^[
        wholeRestartEndpointSelectedOccurrenceGap
          initial elapsedBounded index])
        (run initial
          (wholeRestartEndpointSelectedOccurrenceIndex
            initial elapsedBounded index)) := by
  have strict :=
    wholeRestartEndpointSelectedOccurrenceIndex_strict
      elapsedBounded index
  rw [← wholeRestart_run_add_eq_iterate_next]
  congr 1
  unfold wholeRestartEndpointSelectedOccurrenceGap
  omega

/-- One aligned whole-carrier row before any finite Fourier or pair
aggregation: endpoint-written component occurrence plus kinetic endpoint
residual from the identical actual current. -/
abbrev WholeRestartEndpointAlignedResponsibility :=
  WholeRestartEndpointComponentOccurrence ×
    WholeRestartKineticEndpointState

/-- Complete source-selected aligned responsibility sequence. -/
def wholeRestartEndpointAlignedResponsibility
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) : WholeRestartEndpointAlignedResponsibility :=
  (wholeRestartEndpointComponentTraceLedger initial endpointWritten
      (wholeRestartEndpointSelectedOccurrenceIndex
        initial elapsedBounded index),
    wholeRestartEndpointAlignedKineticResidual
      initial elapsedBounded index)

/-! ## Original actual-occurrence process retained under reindexing -/

/-- Future full occurrence records beginning at one literal old-run index. -/
abbrev WholeRestartEndpointComponentOccurrenceTail :=
  ℕ → WholeRestartEndpointComponentOccurrence

def wholeRestartEndpointComponentOccurrenceTailKeep :
    WholeRestartEndpointComponentOccurrenceTail →ₗ[ℂ]
      WholeRestartEndpointComponentOccurrenceTail where
  toFun residual offset := residual (offset + 1)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

def wholeRestartEndpointComponentOccurrenceTail
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index : ℕ) : WholeRestartEndpointComponentOccurrenceTail :=
  fun offset =>
    wholeRestartEndpointComponentOccurrenceStream initial (index + offset)

/-- The unquotiented occurrence stream itself follows every literal native
old-run update, before endpoint subsequence refinement. -/
def generatedWholeRestartEndpointComponentOccurrenceEffectiveProcess
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    EffectiveResidualProcess ℂ
      WholeRestartEndpointComponentOccurrenceTail ℕ where
  target := 0
  keep := wholeRestartEndpointComponentOccurrenceTailKeep
  residual := wholeRestartEndpointComponentOccurrenceTail initial
  update := Nat.succ
  residual_transport_law := by
    intro index
    funext offset
    simp only [wholeRestartEndpointComponentOccurrenceTail,
      wholeRestartEndpointComponentOccurrenceTailKeep,
      LinearMap.coe_mk, AddHom.coe_mk]
    congr 1
    omega

@[simp] theorem
    generatedWholeRestartEndpointComponentOccurrenceEffectiveProcess_pathState
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index steps : ℕ) :
    (generatedWholeRestartEndpointComponentOccurrenceEffectiveProcess
      initial).pathState index steps = index + steps := by
  induction steps with
  | zero => simp
  | succ steps inductionHypothesis =>
      rw [EffectiveResidualProcess.pathState_succ,
        inductionHypothesis]
      rfl

@[simp] theorem
    generatedWholeRestartComponentGluingEffectiveProcess_pathState
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (index steps : ℕ) :
    (generatedWholeRestartComponentGluingEffectiveProcess
      initial).pathState index steps = index + steps := by
  induction steps with
  | zero => simp
  | succ steps inductionHypothesis =>
      rw [EffectiveResidualProcess.pathState_succ,
        inductionHypothesis]
      rfl

@[simp] theorem
    generatedWholeRestartKineticEndpointResidualEffectiveProcess_pathState
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (receipt : GeneratedWholeRestartKineticWeakEndpoint initial)
    (index steps : ℕ) :
    (generatedWholeRestartKineticEndpointResidualEffectiveProcess
      initial receipt).pathState index steps = index + steps := by
  induction steps with
  | zero => simp
  | succ steps inductionHypothesis =>
      rw [EffectiveResidualProcess.pathState_succ,
        inductionHypothesis]
      rfl

/-- Future aligned rows beginning at one source-selected endpoint occurrence. -/
abbrev WholeRestartEndpointAlignedResponsibilityTail :=
  ℕ → WholeRestartEndpointAlignedResponsibility

/-- Literal next selected occurrence on the aligned whole carrier. -/
def wholeRestartEndpointAlignedResponsibilityTailKeep :
    WholeRestartEndpointAlignedResponsibilityTail →ₗ[ℂ]
      WholeRestartEndpointAlignedResponsibilityTail where
  toFun residual offset := residual (offset + 1)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

def wholeRestartEndpointAlignedResponsibilityTail
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) : WholeRestartEndpointAlignedResponsibilityTail :=
  fun offset => wholeRestartEndpointAlignedResponsibility
    initial elapsedBounded (index + offset)

/-- The endpoint-written component ledger and kinetic residual form one
same-lineage effective process. -/
def generatedWholeRestartEndpointAlignedResponsibilityEffectiveProcess
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    EffectiveResidualProcess ℂ
      WholeRestartEndpointAlignedResponsibilityTail ℕ where
  target := 0
  keep := wholeRestartEndpointAlignedResponsibilityTailKeep
  residual := wholeRestartEndpointAlignedResponsibilityTail
    initial elapsedBounded
  update := Nat.succ
  residual_transport_law := by
    intro index
    funext offset
    simp only [wholeRestartEndpointAlignedResponsibilityTail,
      wholeRestartEndpointAlignedResponsibilityTailKeep,
      LinearMap.coe_mk, AddHom.coe_mk]
    congr 1
    omega

/-- Whole-carrier commuting update on the identical refined source lineage. -/
theorem wholeRestartEndpointAlignedResponsibility_transport
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) :
    wholeRestartEndpointAlignedResponsibilityTail
        initial elapsedBounded (index + 1) =
      wholeRestartEndpointAlignedResponsibilityTailKeep
        (wholeRestartEndpointAlignedResponsibilityTail
          initial elapsedBounded index) :=
  (generatedWholeRestartEndpointAlignedResponsibilityEffectiveProcess
    initial elapsedBounded).residual_transport_law index

/-- The generated trace splits component occurrence and kinetic residual
coordinatewise; neither can be erased by cancellation in the other. -/
theorem wholeRestartEndpointAlignedResponsibility_trace_head
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) :
    linearResidualTrace
        wholeRestartEndpointAlignedResponsibilityTailKeep
        (wholeRestartEndpointAlignedResponsibilityTail
          initial elapsedBounded index) 0 =
      ((wholeRestartEndpointAlignedResponsibility
            initial elapsedBounded index).1 -
          (wholeRestartEndpointAlignedResponsibility
            initial elapsedBounded (index + 1)).1,
        wholeRestartEndpointAlignedKineticResidual
            initial elapsedBounded index -
          wholeRestartEndpointAlignedKineticResidual
            initial elapsedBounded (index + 1)) := by
  rfl

/-- The component coordinate of one refined aligned trace is not a new
observation difference: it is exactly the path trace accumulated by every
literal old-run native update across the source-generated index gap. -/
theorem
    wholeRestartEndpointAlignedComponentTrace_eq_nativeGapPathTrace
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) :
    (linearResidualTrace
        wholeRestartEndpointAlignedResponsibilityTailKeep
        (wholeRestartEndpointAlignedResponsibilityTail
          initial elapsedBounded index) 0).1 =
      ((generatedWholeRestartEndpointComponentOccurrenceEffectiveProcess
          initial).pathTrace
        (wholeRestartEndpointSelectedOccurrenceIndex
          initial elapsedBounded index)
        (wholeRestartEndpointSelectedOccurrenceGap
          initial elapsedBounded index)) 0 := by
  have strict :=
    wholeRestartEndpointSelectedOccurrenceIndex_strict
      elapsedBounded index
  rw [wholeRestartEndpointAlignedResponsibility_trace_head,
    EffectiveResidualProcess.pathTrace,
    generatedWholeRestartEndpointComponentOccurrenceEffectiveProcess_pathState]
  change
    wholeRestartEndpointComponentOccurrenceStream initial
          (wholeRestartEndpointSelectedOccurrenceIndex
            initial elapsedBounded index) -
        wholeRestartEndpointComponentOccurrenceStream initial
          (wholeRestartEndpointSelectedOccurrenceIndex
            initial elapsedBounded (index + 1)) =
      wholeRestartEndpointComponentOccurrenceStream initial
          (wholeRestartEndpointSelectedOccurrenceIndex
            initial elapsedBounded index + 0) -
        wholeRestartEndpointComponentOccurrenceStream initial
          (wholeRestartEndpointSelectedOccurrenceIndex
              initial elapsedBounded index +
            wholeRestartEndpointSelectedOccurrenceGap
              initial elapsedBounded index + 0)
  unfold wholeRestartEndpointSelectedOccurrenceGap
  simp only [Nat.add_zero]
  rw [Nat.add_sub_of_le strict.le]

/-- Projecting the occurrence record to its live row recovers the path trace
of the pre-existing component-gluing residual process itself.  Thus the
aligned carrier does not manufacture a parallel notion of component debt. -/
theorem
    wholeRestartEndpointAlignedComponentRowTrace_eq_originalGapPathTrace
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) :
    (linearResidualTrace
        wholeRestartEndpointAlignedResponsibilityTailKeep
        (wholeRestartEndpointAlignedResponsibilityTail
          initial elapsedBounded index) 0).1.1 =
      ((generatedWholeRestartComponentGluingEffectiveProcess
          initial).pathTrace
        (wholeRestartEndpointSelectedOccurrenceIndex
          initial elapsedBounded index)
        (wholeRestartEndpointSelectedOccurrenceGap
          initial elapsedBounded index)) 0 := by
  have strict :=
    wholeRestartEndpointSelectedOccurrenceIndex_strict
      elapsedBounded index
  rw [wholeRestartEndpointAlignedResponsibility_trace_head,
    EffectiveResidualProcess.pathTrace,
    generatedWholeRestartComponentGluingEffectiveProcess_pathState]
  change
    wholeRestartComponentGluingResidualRow initial
          (wholeRestartEndpointSelectedOccurrenceIndex
            initial elapsedBounded index) -
        wholeRestartComponentGluingResidualRow initial
          (wholeRestartEndpointSelectedOccurrenceIndex
            initial elapsedBounded (index + 1)) =
      wholeRestartComponentGluingResidualRow initial
          (wholeRestartEndpointSelectedOccurrenceIndex
            initial elapsedBounded index + 0) -
        wholeRestartComponentGluingResidualRow initial
          (wholeRestartEndpointSelectedOccurrenceIndex
              initial elapsedBounded index +
            wholeRestartEndpointSelectedOccurrenceGap
              initial elapsedBounded index + 0)
  unfold wholeRestartEndpointSelectedOccurrenceGap
  simp only [Nat.add_zero]
  rw [Nat.add_sub_of_le strict.le]

/-- The kinetic coordinate is likewise the exact multi-step path trace of
the already generated kinetic endpoint residual process under the internal
velocity refinement. -/
theorem
    wholeRestartEndpointAlignedKineticTrace_eq_nativeGapPathTrace
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) :
    let endpointReceipt :=
      (generatedWholeRestartVelocityEndpointUniformKineticViscousLedger
        initial elapsedBounded).family.endpointReceipt
    (linearResidualTrace
        wholeRestartEndpointAlignedResponsibilityTailKeep
        (wholeRestartEndpointAlignedResponsibilityTail
          initial elapsedBounded index) 0).2 =
      ((generatedWholeRestartKineticEndpointResidualEffectiveProcess
          initial
          endpointReceipt.kineticReceipt.toGeneratedWholeRestartKineticWeakEndpoint).pathTrace
        (wholeRestartEndpointKineticRefinementIndex
          initial elapsedBounded index)
        (wholeRestartEndpointKineticRefinementGap
          initial elapsedBounded index)) 0 := by
  dsimp only
  have strict :=
    wholeRestartEndpointKineticRefinementIndex_strict
      elapsedBounded index
  rw [wholeRestartEndpointAlignedResponsibility_trace_head,
    EffectiveResidualProcess.pathTrace,
    generatedWholeRestartKineticEndpointResidualEffectiveProcess_pathState]
  change
    wholeRestartEndpointAlignedKineticResidual
          initial elapsedBounded index -
        wholeRestartEndpointAlignedKineticResidual
          initial elapsedBounded (index + 1) =
      wholeRestartKineticEndpointResidual initial
          ((generatedWholeRestartVelocityEndpointUniformKineticViscousLedger
              initial elapsedBounded).family.endpointReceipt.kineticReceipt.toGeneratedWholeRestartKineticWeakEndpoint)
          (wholeRestartEndpointKineticRefinementIndex
            initial elapsedBounded index + 0) -
        wholeRestartKineticEndpointResidual initial
          ((generatedWholeRestartVelocityEndpointUniformKineticViscousLedger
              initial elapsedBounded).family.endpointReceipt.kineticReceipt.toGeneratedWholeRestartKineticWeakEndpoint)
          (wholeRestartEndpointKineticRefinementIndex
              initial elapsedBounded index +
            wholeRestartEndpointKineticRefinementGap
              initial elapsedBounded index + 0)
  unfold wholeRestartEndpointAlignedKineticResidual
  unfold wholeRestartEndpointKineticRefinementGap
  simp only [Nat.add_zero]
  rw [Nat.add_sub_of_le strict.le]

/-- Full commuting trace square.  One refined aligned step is exactly the
product of the two native multi-step traces generated on its component and
kinetic source processes; the reindexing creates no new residual. -/
theorem wholeRestartEndpointAlignedTrace_eq_nativeProductGapPathTrace
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) :
    let endpointReceipt :=
      (generatedWholeRestartVelocityEndpointUniformKineticViscousLedger
        initial elapsedBounded).family.endpointReceipt
    linearResidualTrace
        wholeRestartEndpointAlignedResponsibilityTailKeep
        (wholeRestartEndpointAlignedResponsibilityTail
          initial elapsedBounded index) 0 =
      (((generatedWholeRestartEndpointComponentOccurrenceEffectiveProcess
            initial).pathTrace
          (wholeRestartEndpointSelectedOccurrenceIndex
            initial elapsedBounded index)
          (wholeRestartEndpointSelectedOccurrenceGap
            initial elapsedBounded index)) 0,
        ((generatedWholeRestartKineticEndpointResidualEffectiveProcess
            initial
            endpointReceipt.kineticReceipt.toGeneratedWholeRestartKineticWeakEndpoint).pathTrace
          (wholeRestartEndpointKineticRefinementIndex
            initial elapsedBounded index)
          (wholeRestartEndpointKineticRefinementGap
            initial elapsedBounded index)) 0) := by
  dsimp only
  apply Prod.ext
  · exact
      wholeRestartEndpointAlignedComponentTrace_eq_nativeGapPathTrace
        elapsedBounded index
  · exact
      wholeRestartEndpointAlignedKineticTrace_eq_nativeGapPathTrace
        elapsedBounded index

/-- The refined kinetic coordinate remains the existing endpoint residual
process, merely reindexed by the source-generated velocity refinement. -/
theorem wholeRestartEndpointAlignedKineticResidual_norm_sq_tendsto_defect
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    let endpointReceipt :=
      (generatedWholeRestartVelocityEndpointUniformKineticViscousLedger
        initial elapsedBounded).family.endpointReceipt
    Tendsto
      (fun index =>
        ‖wholeRestartEndpointAlignedKineticResidual
          initial elapsedBounded index‖ ^ 2)
      atTop
      (nhds
        (wholeRestartKineticWeakEndpointDefect initial
          endpointReceipt.kineticReceipt.endpoint)) := by
  dsimp only
  let endpointReceipt :=
    (generatedWholeRestartVelocityEndpointUniformKineticViscousLedger
      initial elapsedBounded).family.endpointReceipt
  exact
    (wholeRestartKineticEndpointResidual_norm_sq_tendsto_defect
      endpointReceipt.kineticReceipt.toGeneratedWholeRestartKineticWeakEndpoint).comp
        endpointReceipt.velocitySubsubsequence_strictMono.tendsto_atTop

/-- Every fixed finite Fourier observation still tends to zero on the
identical refined coordinate of the aligned whole carrier. -/
theorem wholeRestartEndpointAlignedKineticResidual_finiteProjection_tendsto_zero
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (modes : Finset NonzeroIntegerWavevector) :
    Tendsto
      (fun index =>
        wholeRestartKineticFiniteProjection modes
          (wholeRestartEndpointAlignedKineticResidual
            initial elapsedBounded index))
      atTop (nhds 0) := by
  let endpointReceipt :=
    (generatedWholeRestartVelocityEndpointUniformKineticViscousLedger
      initial elapsedBounded).family.endpointReceipt
  exact
    (wholeRestartKineticEndpointResidual_finiteProjection_tendsto_zero
      endpointReceipt.kineticReceipt.toGeneratedWholeRestartKineticWeakEndpoint
      modes).comp
        endpointReceipt.velocitySubsubsequence_strictMono.tendsto_atTop

end

