import H0mework.Realization.Process.NativeResponseDisposition
import H0mework.NavierStokes.VelocityEndpoint.AbsoluteWholeMildNativeContinuation

/-!
# Source-owned native reachability across a bounded restart accumulation

The absolute endpoint compiler already generates, from one bounded actual
whole-restart lineage, a whole-mild path on `[T, T + 1]`, a source-selected
time strictly after `T`, and the next native restart current at that same
event.  This module installs that generated event as the first dependent edge
of a source-owned response graph.

The runtime has one accumulation node and the ordinary native restart run
beginning at the generated endpoint current.  Its response is total: the
accumulation response carries the complete existing same-event continuation
receipt, while every later response is the original `GeneratedWholeRestartCurrent.next`
write.  Thus least reachability, the first time strictly past `T`, and the
absence of a terminal `none` branch are consequences of the responder itself.

No endpoint state, path, continuation, time, target, branch, coverage family,
or terminal certificate is accepted from a caller.
-/

namespace SaturationMonoid
namespace NavierStokes
namespace
  ThreeDimensionalVorticityCoefficientGeneratedWholeRestartVelocityEndpointNativeReachableContinuation

open Set
open SourceGeneratedNativeResponseDisposition
open ThreeDimensionalPeriodicFilteredNavierStokesGenerator
open ThreeDimensionalVorticityCoefficientGeneratedWholeRestartNativeRecursion
open
  ThreeDimensionalVorticityCoefficientGeneratedWholeRestartNativeRecursion.GeneratedWholeRestartCurrent
open
  ThreeDimensionalVorticityCoefficientGeneratedWholeRestartVelocityEndpointPositiveTimeH1Reentry
open
  ThreeDimensionalVorticityCoefficientGeneratedWholeRestartVelocityWeakEndpoint
open
  ThreeDimensionalVorticityCoefficientGeneratedWholeRestartVelocityEndpointAbsoluteWholeMildNativeContinuation

noncomputable section

/-- Runtime nodes generated by one bounded accumulation.  `after index` is
the literal old native restart run rooted at the endpoint-generated current;
it is not a separately selectable current. -/
inductive GeneratedWholeRestartVelocityEndpointRuntimeState
    {nu : Viscosity}
    (initial : GeneratedWholeRestartCurrent nu)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) where
  | accumulation
  | after (index : Nat)

namespace GeneratedWholeRestartVelocityEndpointRuntimeState

variable {nu : Viscosity}
variable (initial : GeneratedWholeRestartCurrent nu)
variable (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))

/-- The native current on the far side of the accumulation event.  Every
later row is the pre-existing source-owned `run` of the generated next
current. -/
noncomputable def afterCurrent (index : Nat) :
    GeneratedWholeRestartCurrent nu :=
  run
    (sourceGeneratedWholeRestartVelocityEndpointNextCurrent
      initial elapsedBounded)
    index

/-- Absolute physical clock of the endpoint runtime.  The first post-endpoint
clock is the selected time on the actual `[T, T + 1]` whole-mild write; later
clocks add the unmodified elapsed clock of the old native restart run. -/
noncomputable def absoluteTime :
    GeneratedWholeRestartVelocityEndpointRuntimeState
        initial elapsedBounded →
      Real
  | .accumulation => wholeRestartVelocityAccumulationTime initial
  | .after index =>
      (sourceGeneratedWholeRestartVelocityEndpointSelectedAbsoluteTime
        initial elapsedBounded).1 +
        elapsedTime
          (sourceGeneratedWholeRestartVelocityEndpointNextCurrent
            initial elapsedBounded)
          index

@[simp] theorem absoluteTime_accumulation :
    absoluteTime initial elapsedBounded (.accumulation) =
      wholeRestartVelocityAccumulationTime initial :=
  rfl

@[simp] theorem absoluteTime_after_zero :
    absoluteTime initial elapsedBounded (.after 0) =
      (sourceGeneratedWholeRestartVelocityEndpointSelectedAbsoluteTime
        initial elapsedBounded).1 := by
  simp [absoluteTime]

@[simp] theorem afterCurrent_zero :
    afterCurrent initial elapsedBounded 0 =
      sourceGeneratedWholeRestartVelocityEndpointNextCurrent
        initial elapsedBounded :=
  rfl

/-- Conservativity of the post-endpoint current: later runtime nodes are
exactly the original native successor chain. -/
@[simp] theorem afterCurrent_succ (index : Nat) :
    afterCurrent initial elapsedBounded (index + 1) =
      (afterCurrent initial elapsedBounded index).next :=
  rfl

/-- Conservativity of the post-endpoint clock: later runtime clocks use the
original elapsed-time function without a new time increment or rescaling. -/
@[simp] theorem absoluteTime_after_succ (index : Nat) :
    absoluteTime initial elapsedBounded (.after (index + 1)) =
      absoluteTime initial elapsedBounded (.after index) +
        (afterCurrent initial elapsedBounded index).contact.time.1 := by
  simp only [absoluteTime, elapsedTime_succ, afterCurrent]
  ring

/-- The first generated runtime node is at the exact selected absolute time
of the endpoint receipt, hence strictly beyond the old accumulation time. -/
theorem accumulation_lt_absoluteTime_after_zero :
    absoluteTime initial elapsedBounded (.accumulation) <
      absoluteTime initial elapsedBounded (.after 0) := by
  rw [absoluteTime_accumulation, absoluteTime_after_zero]
  exact
    (sourceGeneratedWholeRestartVelocityEndpointAbsoluteWholeMildNativeContinuation
      initial elapsedBounded).selectedAbsoluteTime_gt_accumulation

/-- Every post-endpoint native current remains strictly beyond the old
accumulation time. -/
theorem accumulation_lt_absoluteTime_after (index : Nat) :
    absoluteTime initial elapsedBounded (.accumulation) <
      absoluteTime initial elapsedBounded (.after index) := by
  rw [absoluteTime_accumulation]
  have selectedTimeGt :=
    (sourceGeneratedWholeRestartVelocityEndpointAbsoluteWholeMildNativeContinuation
      initial elapsedBounded).selectedAbsoluteTime_gt_accumulation
  have elapsedNonneg :=
    elapsedTime_nonneg
      (sourceGeneratedWholeRestartVelocityEndpointNextCurrent
        initial elapsedBounded)
      index
  simp only [absoluteTime]
  linarith

end GeneratedWholeRestartVelocityEndpointRuntimeState

open GeneratedWholeRestartVelocityEndpointRuntimeState

variable {nu : Viscosity}
variable (initial : GeneratedWholeRestartCurrent nu)
variable (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))

/-- Dependent native writes of the endpoint runtime.  The first constructor
stores the complete already-generated same-event absolute continuation as
the payload of the actual edge.  Later constructors are the original native
restart writes. -/
inductive GeneratedWholeRestartVelocityEndpointNativeStep :
    GeneratedWholeRestartVelocityEndpointRuntimeState initial elapsedBounded →
      GeneratedWholeRestartVelocityEndpointRuntimeState initial elapsedBounded →
      Type
  | endpointWrite
      (continuation :
        GeneratedWholeRestartVelocityEndpointAbsoluteWholeMildNativeContinuation
          initial elapsedBounded) :
      GeneratedWholeRestartVelocityEndpointNativeStep
        .accumulation (.after 0)
  | restartWrite (index : Nat) :
      GeneratedWholeRestartVelocityEndpointNativeStep
        (.after index) (.after (index + 1))

/-- The exact response generated at every endpoint-runtime node.  In
particular, the accumulation branch computes the canonical absolute
same-event receipt internally. -/
noncomputable def generatedWholeRestartVelocityEndpointNativeResponse :
    (current :
      GeneratedWholeRestartVelocityEndpointRuntimeState
        initial elapsedBounded) →
      Response
        (GeneratedWholeRestartVelocityEndpointNativeStep
          initial elapsedBounded)
        current
  | .accumulation =>
      ⟨.after 0,
        .endpointWrite
          (sourceGeneratedWholeRestartVelocityEndpointAbsoluteWholeMildNativeContinuation
            initial elapsedBounded)⟩
  | .after index =>
      ⟨.after (index + 1), .restartWrite index⟩

/-- Total source-owned responder.  No terminal branch is installed by the
endpoint runtime. -/
noncomputable def generatedWholeRestartVelocityEndpointNativeRespond
    (current :
      GeneratedWholeRestartVelocityEndpointRuntimeState
        initial elapsedBounded) :
    Option
      (Response
        (GeneratedWholeRestartVelocityEndpointNativeStep
          initial elapsedBounded)
        current) :=
  some
    (generatedWholeRestartVelocityEndpointNativeResponse
      initial elapsedBounded current)

@[simp] theorem generatedWholeRestartVelocityEndpointNativeRespond_eq_some
    (current :
      GeneratedWholeRestartVelocityEndpointRuntimeState
        initial elapsedBounded) :
    generatedWholeRestartVelocityEndpointNativeRespond
        initial elapsedBounded current =
      some
        (generatedWholeRestartVelocityEndpointNativeResponse
          initial elapsedBounded current) :=
  rfl

/-- The source responder generates the exact same-event continuation edge at
the accumulation node.  The edge payload is not reconstructed downstream. -/
@[simp] theorem
    generatedWholeRestartVelocityEndpointNativeResponse_accumulation :
    generatedWholeRestartVelocityEndpointNativeResponse
        initial elapsedBounded (.accumulation) =
      ⟨.after 0,
        .endpointWrite
          (sourceGeneratedWholeRestartVelocityEndpointAbsoluteWholeMildNativeContinuation
            initial elapsedBounded)⟩ :=
  rfl

/-- Every later response is the literal old native `run_succ` edge. -/
@[simp] theorem generatedWholeRestartVelocityEndpointNativeResponse_after
    (index : Nat) :
    generatedWholeRestartVelocityEndpointNativeResponse
        initial elapsedBounded (.after index) =
      ⟨.after (index + 1), .restartWrite index⟩ :=
  rfl

/-- Least source reachability crosses the bounded accumulation endpoint by
executing the exact responder edge. -/
def generatedWholeRestartVelocityEndpointAfterZeroReachable :
    NativeReachable
      (.accumulation :
        GeneratedWholeRestartVelocityEndpointRuntimeState
          initial elapsedBounded)
      (generatedWholeRestartVelocityEndpointNativeRespond
        initial elapsedBounded)
      (.after 0) :=
  NativeReachable.step
    (.initial :
      NativeReachable
        (.accumulation :
          GeneratedWholeRestartVelocityEndpointRuntimeState
            initial elapsedBounded)
        (generatedWholeRestartVelocityEndpointNativeRespond
          initial elapsedBounded)
        (.accumulation))
    (response :=
      generatedWholeRestartVelocityEndpointNativeResponse
        initial elapsedBounded .accumulation)
    rfl

/-- Continue least reachability through the unmodified native restart run on
the far side of the endpoint. -/
def generatedWholeRestartVelocityEndpointAfterReachable :
    (index : Nat) →
      NativeReachable
        (.accumulation :
          GeneratedWholeRestartVelocityEndpointRuntimeState
            initial elapsedBounded)
        (generatedWholeRestartVelocityEndpointNativeRespond
          initial elapsedBounded)
        (.after index)
  | 0 => generatedWholeRestartVelocityEndpointAfterZeroReachable
      initial elapsedBounded
  | index + 1 =>
      .step
        (generatedWholeRestartVelocityEndpointAfterReachable
          index)
        rfl

/-- The exact occurrence count records one endpoint crossing followed by the
ordinary native run prefix. -/
@[simp] theorem generatedWholeRestartVelocityEndpointAfterReachable_occurrence
    (index : Nat) :
    (generatedWholeRestartVelocityEndpointAfterReachable
      initial elapsedBounded index).occurrence = index + 1 := by
  induction index with
  | zero =>
      simp [generatedWholeRestartVelocityEndpointAfterReachable,
        generatedWholeRestartVelocityEndpointAfterZeroReachable,
        NativeReachable.occurrence]
  | succ index inductionHypothesis =>
      change
        (generatedWholeRestartVelocityEndpointAfterReachable
            initial elapsedBounded index).occurrence + 1 =
          (index + 1) + 1
      rw [inductionHypothesis]

/-- A literal terminal `none` outcome is impossible at every reachable
endpoint-runtime node because the same source responder computes an actual
dependent edge there. -/
theorem generatedWholeRestartVelocityEndpointNativeRespond_ne_none
    (current :
      GeneratedWholeRestartVelocityEndpointRuntimeState
        initial elapsedBounded) :
    generatedWholeRestartVelocityEndpointNativeRespond
        initial elapsedBounded current ≠ none := by
  rw [generatedWholeRestartVelocityEndpointNativeRespond_eq_some]
  exact Option.some_ne_none _

/-- Generic reachable disposition is definitionally the continued branch at
every node of this concrete runtime.  This is computed from `respond`; no
no-third-sink or continuation law is supplied as a premise. -/
@[simp] theorem
    generatedWholeRestartVelocityEndpointNativeReachable_disposition
    {current :
      GeneratedWholeRestartVelocityEndpointRuntimeState
        initial elapsedBounded}
    (arrival :
      NativeReachable
        (.accumulation :
          GeneratedWholeRestartVelocityEndpointRuntimeState
            initial elapsedBounded)
        (generatedWholeRestartVelocityEndpointNativeRespond
          initial elapsedBounded)
        current) :
    arrival.disposition =
      .continued arrival
        (generatedWholeRestartVelocityEndpointNativeResponse
          initial elapsedBounded current)
        rfl :=
  rfl

/-- Type-valued receipt produced by crossing the bounded accumulation node.
The arrival proof is least source reachability; the clock and current fields
refer to the very target selected by that dependent edge. -/
structure GeneratedWholeRestartVelocityEndpointAfterEndpointReceipt where
  arrival :
    NativeReachable
      (.accumulation :
        GeneratedWholeRestartVelocityEndpointRuntimeState
          initial elapsedBounded)
      (generatedWholeRestartVelocityEndpointNativeRespond
        initial elapsedBounded)
      (.after 0)
  absoluteTime_gt :
    absoluteTime initial elapsedBounded (.accumulation) <
      absoluteTime initial elapsedBounded (.after 0)
  current_eq :
    afterCurrent initial elapsedBounded 0 =
      sourceGeneratedWholeRestartVelocityEndpointNextCurrent
        initial elapsedBounded

/-- Source-owned maximality consumer for the bounded accumulation endpoint.
The exact continuation payload is executed as a least-reachable edge, its
target clock is strictly past the old supremum, and its physical current is
definitionally the endpoint-generated next current. -/
noncomputable def
    boundedAccumulation_generates_nativeReachable_afterEndpoint
    : GeneratedWholeRestartVelocityEndpointAfterEndpointReceipt
        initial elapsedBounded where
  arrival :=
    generatedWholeRestartVelocityEndpointAfterZeroReachable
      initial elapsedBounded
  absoluteTime_gt :=
    accumulation_lt_absoluteTime_after_zero initial elapsedBounded
  current_eq := afterCurrent_zero initial elapsedBounded

end

end
  ThreeDimensionalVorticityCoefficientGeneratedWholeRestartVelocityEndpointNativeReachableContinuation
end NavierStokes
end SaturationMonoid
