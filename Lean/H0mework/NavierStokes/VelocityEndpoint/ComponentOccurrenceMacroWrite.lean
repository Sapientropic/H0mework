noncomputable section

/-! ## The whole pre-quotient occurrence carrier -/

/-- One exact old-run occurrence, retaining both its complete gluing row and
the uniquely forced native trace written by the next old-run update. -/
abbrev WholeRestartEndpointComponentOccurrence :=
  WholeRestartComponentGluingResidualRow ×
    WholeRestartComponentGluingResidualRow

/-- The whole chronological occurrence carrier.  The occurrence coordinate
is not quotiented by Fourier output or by pair aggregation. -/
abbrev WholeRestartEndpointComponentOccurrenceStream :=
  ℕ → WholeRestartEndpointComponentOccurrence

/-- Every old source occurrence together with the trace generated by its
literal native successor. -/
def wholeRestartEndpointComponentOccurrenceStream
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    WholeRestartEndpointComponentOccurrenceStream :=
  fun index =>
    (wholeRestartComponentGluingResidualRow initial index,
      linearResidualTrace wholeRestartComponentGluingResidualTailKeep
        (wholeRestartComponentGluingResidualTail initial index) 0)

/-- Finite chronological prefix of the exact occurrence stream, newest first,
matching the already generated old occurrence-ledger convention. -/
def wholeRestartEndpointComponentOccurrencePrefix
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (length : ℕ) : List WholeRestartEndpointComponentOccurrence :=
  (List.range length).reverse.map
    (wholeRestartEndpointComponentOccurrenceStream initial)

/-- Forgetting the trace coordinate recovers the old occurrence ledger
literally at every finite prefix. -/
theorem wholeRestartEndpointComponentOccurrencePrefix_fst
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (length : ℕ) :
    (wholeRestartEndpointComponentOccurrencePrefix initial length).map
        Prod.fst =
      wholeRestartComponentGluingOccurrenceLedger initial length := by
  simp [wholeRestartEndpointComponentOccurrencePrefix,
    wholeRestartEndpointComponentOccurrenceStream,
    wholeRestartComponentGluingOccurrenceLedger,
    List.map_map]

/-! ## One source-owned endpoint read/write phase -/

/-- The bounded accumulation has one macro read and one written endpoint.
These are not physical microsteps: the write is the single source-generated
absolute endpoint continuation. -/
inductive WholeRestartEndpointComponentMacroPhase
  | accumulationRead
  | endpointWritten
  deriving DecidableEq

open WholeRestartEndpointComponentMacroPhase

/-- The macro write is source-owned and has no caller-selected branch. -/
def wholeRestartEndpointComponentMacroUpdate :
    WholeRestartEndpointComponentMacroPhase →
      WholeRestartEndpointComponentMacroPhase
  | accumulationRead => endpointWritten
  | endpointWritten => endpointWritten

/-- Before the endpoint write the whole occurrence stream is pending; after
the write no occurrence remains in the pending coordinate. -/
def wholeRestartEndpointComponentPending
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    WholeRestartEndpointComponentMacroPhase →
      WholeRestartEndpointComponentOccurrenceStream
  | accumulationRead => wholeRestartEndpointComponentOccurrenceStream initial
  | endpointWritten => 0

/-- The same macro event writes the complete occurrence stream into its trace
ledger.  Recording it does not assign any new metric to provenance. -/
def wholeRestartEndpointComponentTraceLedger
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    WholeRestartEndpointComponentMacroPhase →
      WholeRestartEndpointComponentOccurrenceStream
  | accumulationRead => 0
  | endpointWritten => wholeRestartEndpointComponentOccurrenceStream initial

/-- Finite inspection of the written endpoint ledger, retaining exact
occurrence order and both component coordinates. -/
def wholeRestartEndpointComponentTraceLedgerPrefix
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (phase : WholeRestartEndpointComponentMacroPhase)
    (length : ℕ) : List WholeRestartEndpointComponentOccurrence :=
  (List.range length).reverse.map
    (wholeRestartEndpointComponentTraceLedger initial phase)

/-- The endpoint macro forgets the pending coordinate because that complete
responsibility is written, without quotient, into the trace ledger. -/
def wholeRestartEndpointComponentMacroKeep :
    WholeRestartEndpointComponentOccurrenceStream →ₗ[ℂ]
      WholeRestartEndpointComponentOccurrenceStream :=
  0

/-- Native residual process of the endpoint macro read/write. -/
def generatedWholeRestartEndpointComponentMacroEffectiveProcess
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    EffectiveResidualProcess ℂ
      WholeRestartEndpointComponentOccurrenceStream
      WholeRestartEndpointComponentMacroPhase where
  target := 0
  keep := wholeRestartEndpointComponentMacroKeep
  residual := wholeRestartEndpointComponentPending initial
  update := wholeRestartEndpointComponentMacroUpdate
  residual_transport_law := by
    intro phase
    cases phase <;> rfl

/-- The same source contact is a reflexive read/write event: its read is the
whole pending occurrence stream and its write is the endpoint macro phase. -/
def generatedWholeRestartEndpointComponentMacroQuery
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    ReflexiveQuery WholeRestartEndpointComponentMacroPhase
      WholeRestartEndpointComponentOccurrenceStream where
  read := wholeRestartEndpointComponentPending initial
  write := wholeRestartEndpointComponentMacroUpdate

@[simp] theorem generatedWholeRestartEndpointComponentMacroQuery_run
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    (generatedWholeRestartEndpointComponentMacroQuery initial).run
        accumulationRead =
      (wholeRestartEndpointComponentOccurrenceStream initial,
        endpointWritten) := by
  rfl

/-- The whole-carrier trace of the macro read is exactly the unquotiented old
occurrence stream. -/
theorem wholeRestartEndpointComponentMacro_trace_eq_stream
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    linearResidualTrace wholeRestartEndpointComponentMacroKeep
        (wholeRestartEndpointComponentPending initial accumulationRead) =
      wholeRestartEndpointComponentOccurrenceStream initial := by
  simp [linearResidualTrace, wholeRestartEndpointComponentMacroKeep,
    wholeRestartEndpointComponentPending]

/-- Exact no-silent write-back: the forced residual trace is appended to the
ledger by the identical macro update. -/
theorem wholeRestartEndpointComponentMacro_ledger_writeBack
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    wholeRestartEndpointComponentTraceLedger initial
        (wholeRestartEndpointComponentMacroUpdate accumulationRead) =
      wholeRestartEndpointComponentTraceLedger initial accumulationRead +
        linearResidualTrace wholeRestartEndpointComponentMacroKeep
          (wholeRestartEndpointComponentPending initial accumulationRead) := by
  simp [wholeRestartEndpointComponentTraceLedger,
    wholeRestartEndpointComponentMacroUpdate,
    wholeRestartEndpointComponentMacro_trace_eq_stream]

/-- Moving pending responsibility into the trace ledger preserves the entire
pre-quotient carrier exactly. -/
theorem wholeRestartEndpointComponentMacro_noSilentLoss
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν) :
    wholeRestartEndpointComponentPending initial accumulationRead +
        wholeRestartEndpointComponentTraceLedger initial accumulationRead =
      wholeRestartEndpointComponentPending initial
          (wholeRestartEndpointComponentMacroUpdate accumulationRead) +
        wholeRestartEndpointComponentTraceLedger initial
          (wholeRestartEndpointComponentMacroUpdate accumulationRead) := by
  simp [wholeRestartEndpointComponentPending,
    wholeRestartEndpointComponentTraceLedger,
    wholeRestartEndpointComponentMacroUpdate]

/-- Every finite prefix read after the macro write is definitionally the old
chronological occurrence prefix; the endpoint carrier has not completed and
then projected away provenance. -/
theorem wholeRestartEndpointComponentMacro_writtenPrefix_fst
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (length : ℕ) :
    (wholeRestartEndpointComponentTraceLedgerPrefix initial
        (wholeRestartEndpointComponentMacroUpdate accumulationRead) length).map
          Prod.fst =
      wholeRestartComponentGluingOccurrenceLedger initial length := by
  change
    (wholeRestartEndpointComponentOccurrencePrefix initial length).map
        Prod.fst =
      wholeRestartComponentGluingOccurrenceLedger initial length
  exact wholeRestartEndpointComponentOccurrencePrefix_fst initial length

/-! ## Physical projection of the same macro write -/

/-- Physical state carried by the two macro phases.  The endpoint-written
phase is the existing source-generated native whole current. -/
def wholeRestartEndpointComponentMacroPhysicalCurrent
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    WholeRestartEndpointComponentMacroPhase → GeneratedWholeRestartCurrent ν
  | accumulationRead => initial
  | endpointWritten =>
      sourceGeneratedWholeRestartVelocityEndpointNextCurrent
        initial elapsedBounded

/-- The source macro frame contains the actual physical current, pending
whole occurrence carrier, and written trace ledger. -/
def wholeRestartEndpointComponentMacroFrame
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (phase : WholeRestartEndpointComponentMacroPhase) :
    GeneratedWholeRestartCurrent ν ×
      (WholeRestartEndpointComponentOccurrenceStream ×
        WholeRestartEndpointComponentOccurrenceStream) :=
  (wholeRestartEndpointComponentMacroPhysicalCurrent
      initial elapsedBounded phase,
    wholeRestartEndpointComponentPending initial phase,
    wholeRestartEndpointComponentTraceLedger initial phase)

/-- The native endpoint update writes the existing actual whole unforced next
current and the exact complete occurrence stream in one frame equation. -/
theorem wholeRestartEndpointComponentMacroFrame_update
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    wholeRestartEndpointComponentMacroFrame initial elapsedBounded
        (wholeRestartEndpointComponentMacroUpdate accumulationRead) =
      (sourceGeneratedWholeRestartVelocityEndpointNextCurrent
          initial elapsedBounded,
        0,
        wholeRestartEndpointComponentOccurrenceStream initial) := by
  rfl

/-- Physical projection of the macro frame is the already generated whole
unforced current beyond the accumulation endpoint. -/
theorem wholeRestartEndpointComponentMacroPhysicalCurrent_update
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    wholeRestartEndpointComponentMacroPhysicalCurrent initial elapsedBounded
        (wholeRestartEndpointComponentMacroUpdate accumulationRead) =
      sourceGeneratedWholeRestartVelocityEndpointNextCurrent
        initial elapsedBounded := by
  rfl

/-- The physical current written by the macro starts its actual unforced
receipt at its own initial state. -/
theorem wholeRestartEndpointComponentMacroPhysicalCurrent_receipt_initial
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial))) :
    let next := wholeRestartEndpointComponentMacroPhysicalCurrent
      initial elapsedBounded
      (wholeRestartEndpointComponentMacroUpdate accumulationRead)
    next.receipt.wholePath
        ⟨0, ⟨le_rfl, next.receipt.requestedTimePos.le⟩⟩ =
      next.initialState := by
  dsimp only [wholeRestartEndpointComponentMacroUpdate,
    wholeRestartEndpointComponentMacroPhysicalCurrent]
  exact
    (sourceGeneratedWholeRestartVelocityEndpointAbsoluteWholeMildNativeContinuation
      initial elapsedBounded).next_receipt_initial

/-- The same written current is attached to the generated absolute endpoint
path at its strictly post-accumulation selected time. -/
theorem wholeRestartEndpointComponentMacroPhysicalCurrent_absolutePath
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (wave : IntegerWavevector) :
    biotSavartVelocityCoefficient wave
        ((wholeRestartEndpointComponentMacroPhysicalCurrent
          initial elapsedBounded
          (wholeRestartEndpointComponentMacroUpdate accumulationRead)).initialState
            wave) =
      sourceGeneratedWholeRestartVelocityEndpointAbsoluteWholePath
        initial elapsedBounded
        (sourceGeneratedWholeRestartVelocityEndpointSelectedAbsoluteTime
          initial elapsedBounded)
        wave := by
  exact
    (sourceGeneratedWholeRestartVelocityEndpointAbsoluteWholeMildNativeContinuation
      initial elapsedBounded).next_initial_biotSavart_absolutePath wave

/-! ## Exact selected-occurrence access inside the endpoint ledger -/

/-- Source-selected occurrence index used by the endpoint construction. -/
def wholeRestartEndpointSelectedOccurrenceIndex
    {ν : Viscosity}
    (initial : GeneratedWholeRestartCurrent ν)
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) : ℕ :=
  (generatedWholeRestartVelocityEndpointUniformKineticViscousLedger
    initial elapsedBounded).family.endpointReceipt.subsequence index

/-- The selected occurrence is literally the head written by the old native
occurrence ledger at its successor prefix. -/
theorem wholeRestartEndpointSelectedOccurrence_is_oldLedgerHead
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) :
    wholeRestartComponentGluingOccurrenceLedger initial
        (wholeRestartEndpointSelectedOccurrenceIndex
          initial elapsedBounded index + 1) =
      (wholeRestartEndpointComponentOccurrenceStream initial
          (wholeRestartEndpointSelectedOccurrenceIndex
            initial elapsedBounded index)).1 ::
        wholeRestartComponentGluingOccurrenceLedger initial
          (wholeRestartEndpointSelectedOccurrenceIndex
            initial elapsedBounded index) := by
  simpa [wholeRestartEndpointComponentOccurrenceStream] using
    wholeRestartComponentGluingOccurrenceLedger_succ initial
      (wholeRestartEndpointSelectedOccurrenceIndex
        initial elapsedBounded index)

/-- At every source-selected occurrence, the endpoint ledger retains the
native zero/next/trace disposition componentwise, before any aggregation. -/
theorem wholeRestartEndpointSelectedOccurrence_zero_or_nativeNext_or_trace
    {ν : Viscosity}
    {initial : GeneratedWholeRestartCurrent ν}
    (elapsedBounded : BddAbove (Set.range (elapsedTime initial)))
    (index : ℕ) :
    let selected := wholeRestartEndpointSelectedOccurrenceIndex
      initial elapsedBounded index
    (wholeRestartEndpointComponentOccurrenceStream initial selected).1 = 0 ∨
      wholeRestartComponentGluingResidualRow initial (selected + 1) ≠ 0 ∨
        (wholeRestartEndpointComponentOccurrenceStream initial selected).2 ≠ 0 := by
  dsimp only [wholeRestartEndpointSelectedOccurrenceIndex]
  simpa [wholeRestartEndpointComponentOccurrenceStream] using
    wholeRestartComponentGluingResidual_zero_or_next_or_trace
      initial
      ((generatedWholeRestartVelocityEndpointUniformKineticViscousLedger
        initial elapsedBounded).family.endpointReceipt.subsequence index)

end

end
  ThreeDimensionalVorticityCoefficientGeneratedWholeRestartVelocityEndpointComponentOccurrenceMacroWrite
