import H0mework.Versions.R7e4da746.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Runtime.Visit

set_option autoImplicit false
set_option maxRecDepth 8192

namespace SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Runtime

open Capitalism.Universal.Source.Program
open Capitalism.Universal.Root
open Capitalism.Universal.Abolition.Accounting.Quantifiers.Assembly.Strengthening
open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot RootInquiryCompletion
open Reparation.Actual (StateAt)

noncomputable section

variable {Party Good Port Technology Instrument Community : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Port]
  [DecidableEq Instrument] [DecidableEq Community]

/-- Only proposed source instructions are supplied. The current and all
authority decisions are generated by the previous actual visit. -/
abbrev Menus (Party Good Port Technology Instrument : Type) :=
  Nat → RawCurrent Party Good Technology Instrument → List (RawEvent Party Good Port Technology Instrument)

variable {seed cut : Conflict.Root.Cut Party Good Port Technology Instrument} {community : Party → Community}
  (prior : StateAt seed community cut) (input : ProgrammeSource.Input Party Good Port Technology Instrument) (origin : RawCurrent Party Good Technology Instrument) (roster : List Party)
  (menus : Menus Party Good Port Technology Instrument)

def run : Nat → RootWrite seed community cut input origin roster
  | 0 => commit prior ⟨cut.state, menus 0 cut.raw⟩
  | n + 1 =>
    let previous := run n
    let before := previous.read.after
    commit previous.state ⟨before, menus (n + 1) before.raw⟩

abbrev eventAt (n : Nat) : Attempt input origin roster :=
  (run prior input origin roster menus n).read

def clockAt (n : Nat) : ℚ :=
  (eventAt prior input origin roster menus n).before.raw.clock

def Succeeds (n : Nat) : Prop :=
  (eventAt prior input origin roster menus n).Succeeds

def Refused (n : Nat) : Prop :=
  (eventAt prior input origin roster menus n).Refused

theorem the_next_attempt_reads_the_same_generated_physical_current (n : Nat) :
    (eventAt prior input origin roster menus (n + 1)).before =
      (eventAt prior input origin roster menus n).after :=
  rfl

theorem the_original_root_records_each_new_menu (n : Nat) :
    (eventAt prior input origin roster menus n).offers =
      menus n (eventAt prior input origin roster menus n).before.raw := by
  cases n <;> rfl

theorem every_actual_visit_keeps_the_original_rows (n : Nat) :
    (run prior input origin roster menus n).state.stack.balances = prior.stack.balances := by
  induction n with
  | zero => rfl
  | succ n kept => exact kept

theorem no_actual_service_or_refusal_causes_new_war_damage (n : Nat) :
    ∀ item ∈ (eventAt prior input origin roster menus n).items, ∀ key,
      Reparation.loss input.law community item key = 0 :=
  (eventAt prior input origin roster menus n).no_actual_damage community

theorem every_actual_visit_generates_the_original_whole_next (n : Nat) :
    let current := run prior input origin roster menus n
    let next := run prior input origin roster menus (n + 1)
    (⟨current.state.world, (Installation.Core.action current.state next.read true).target.targetAnswerAndNext.nextCurrent⟩ :
      AnyAuthoritativeRootCurrent) = next.state.resident.erase :=
  commit_writes_the_same_original_whole_successor _ _

theorem the_first_visit_writes_the_original_whole_next :
    let first := run prior input origin roster menus 0
    (⟨prior.world, (Installation.Core.action prior first.read true).target.targetAnswerAndNext.nextCurrent⟩ :
      AnyAuthoritativeRootCurrent) = first.state.resident.erase :=
  commit_writes_the_same_original_whole_successor _ _

theorem clock_mono : Monotone (clockAt prior input origin roster menus) := by
  apply monotone_nat_of_le_succ
  intro n
  exact (eventAt prior input origin roster menus n).original_time_never_decreases

theorem refused_visit_preserves_the_current_and_has_no_items (n : Nat)
    (refused : Refused prior input origin roster menus n) :
    (eventAt prior input origin roster menus (n + 1)).before =
      (eventAt prior input origin roster menus n).before ∧
    (eventAt prior input origin roster menus n).items = [] :=
  (eventAt prior input origin roster menus n).refusal_has_no_physical_effect refused

theorem an_actual_visit_advances_exactly_when_paid (n : Nat) :
    clockAt prior input origin roster menus n < clockAt prior input origin roster menus (n + 1) ↔
      Succeeds prior input origin roster menus n := by
  constructor
  · intro elapsed
    rcases (eventAt prior input origin roster menus n).pays_or_refuses with paid | failed
    · exact paid
    · have same := congrArg (fun current : Native Party Good Port Technology Instrument => current.raw.clock)
        (refused_visit_preserves_the_current_and_has_no_items prior input origin roster menus n failed).1
      exact ((ne_of_gt elapsed) same).elim
  · intro success
    let attempt := eventAt prior input origin roster menus n
    obtain ⟨_, paid, _, after⟩ := attempt.accepted_effect success
    change attempt.before.raw.clock < (attempt.after).raw.clock
    rw [after]
    change attempt.before.raw.clock < (input.law.next attempt.before.raw _).clock
    rw [paid.exact_clock]
    exact lt_add_of_pos_right _ paid.positiveClock

end

end SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Runtime
