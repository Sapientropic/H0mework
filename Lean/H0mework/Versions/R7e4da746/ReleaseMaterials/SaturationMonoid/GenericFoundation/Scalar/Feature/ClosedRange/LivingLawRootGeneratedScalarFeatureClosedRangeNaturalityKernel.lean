import H0mework.Realization.Feature.HilbertRealization
import H0mework.Versions.Rb81a4438.ReleaseMaterials.SaturationMonoid.GenericFoundation.Scalar.Feature.LivingLawRootGeneratedScalarFeatureNaturalityKernel
import H0mework.Realization.Topology.HilbertCokernel

/-!
# Closed-range realization and naturality of feature completions

The Hilbert completion generated by a source feature is canonically the
closed range of that feature in every complete target.  A source
factorization therefore induces a canonical map of completions by inclusion
of the corresponding closed ranges.  No chosen approximating sequence,
surjectivity premise or finite-dimensional hypothesis is used.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace SourceGeneratedComplexFeaturePerfectification

open SourceGeneratedHilbertCokernel

noncomputable section

universe c c' h

variable {C : Type c} [AddCommGroup C] [Module ℂ C]
variable {C' : Type c'} [AddCommGroup C'] [Module ℂ C']
variable {H : Type h} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
variable [CompleteSpace H]

/-- The canonical completion realization lands in the source-generated
closed range. -/
theorem hilbertAmbientRealization_mem_closedRange
    (feature : C →ₗ[ℂ] H) (value : HilbertAmbient feature) :
    hilbertAmbientRealization feature value ∈ closedRange feature := by
  induction value using UniformSpace.Completion.induction_on with
  | hp =>
      exact (closedRange feature).isClosed.preimage
        (hilbertAmbientRealization feature).continuous
  | ih rangeValue =>
      rw [hilbertAmbientRealization_range_readback]
      exact (LinearMap.range feature).le_topologicalClosure rangeValue.property

def hilbertAmbientClosedRangeIsometry (feature : C →ₗ[ℂ] H) :
    HilbertAmbient feature →ₗᵢ[ℂ] (closedRange feature).toSubmodule where
  toFun value :=
    ⟨hilbertAmbientRealization feature value,
      hilbertAmbientRealization_mem_closedRange feature value⟩
  map_add' left right := by
    apply Subtype.ext
    exact map_add (hilbertAmbientRealization feature) left right
  map_smul' coefficient value := by
    apply Subtype.ext
    exact map_smul (hilbertAmbientRealization feature) coefficient value
  norm_map' value := (hilbertAmbientRealization feature).norm_map value

theorem hilbertAmbientClosedRangeIsometry_surjective
    (feature : C →ₗ[ℂ] H) :
    Function.Surjective (hilbertAmbientClosedRangeIsometry feature) := by
  intro target
  have realizationRangeClosed :
      IsClosed (Set.range (hilbertAmbientRealization feature)) :=
    (hilbertAmbientRealization feature).isometry.isUniformInducing
      |>.isComplete_range.isClosed
  have sourceRange_le :
      (LinearMap.range feature : Set H) ⊆
        Set.range (hilbertAmbientRealization feature) := by
    rintro _ ⟨source, rfl⟩
    exact ⟨canonicalHilbertMap feature source,
      hilbertAmbientRealization_source_readback feature source⟩
  have target_mem_realizationRange :
      (target : H) ∈ Set.range (hilbertAmbientRealization feature) :=
    (show (target : H) ∈ closure (LinearMap.range feature : Set H) from
      target.property) |> closure_minimal sourceRange_le realizationRangeClosed
  rcases target_mem_realizationRange with ⟨source, source_eq⟩
  refine ⟨source, ?_⟩
  apply Subtype.ext
  exact source_eq

/-- Completion of the actual range is canonically its closed range. -/
def hilbertAmbientClosedRangeEquiv (feature : C →ₗ[ℂ] H) :
    HilbertAmbient feature ≃ₗᵢ[ℂ] (closedRange feature).toSubmodule :=
  LinearIsometryEquiv.ofSurjective
    (hilbertAmbientClosedRangeIsometry feature)
    (hilbertAmbientClosedRangeIsometry_surjective feature)

@[simp] theorem hilbertAmbientClosedRangeEquiv_realization
    (feature : C →ₗ[ℂ] H) (value : HilbertAmbient feature) :
    ((hilbertAmbientClosedRangeEquiv feature value :
      (closedRange feature).toSubmodule) : H) =
      hilbertAmbientRealization feature value :=
  rfl

@[simp] theorem hilbertAmbientClosedRangeEquiv_symm_realization
    (feature : C →ₗ[ℂ] H) (value : (closedRange feature).toSubmodule) :
    hilbertAmbientRealization feature
        ((hilbertAmbientClosedRangeEquiv feature).symm value) = value := by
  have readback := hilbertAmbientClosedRangeEquiv_realization feature
    ((hilbertAmbientClosedRangeEquiv feature).symm value)
  rw [(hilbertAmbientClosedRangeEquiv feature).apply_symm_apply] at readback
  exact readback.symm

@[simp] theorem hilbertAmbientClosedRangeEquiv_source
    (feature : C →ₗ[ℂ] H) (source : C) :
    hilbertAmbientClosedRangeEquiv feature
        (canonicalHilbertMap feature source) =
      ⟨feature source,
        (LinearMap.range feature).le_topologicalClosure ⟨source, rfl⟩⟩ := by
  apply Subtype.ext
  exact hilbertAmbientRealization_source_readback feature source

omit [CompleteSpace H] in
theorem featureSourceMorphism_closedRange_le
    (feature : C →ₗ[ℂ] H) (feature' : C' →ₗ[ℂ] H)
    (morphism : FeatureSourceMorphism feature feature') :
    (closedRange feature).toSubmodule ≤
      (closedRange feature').toSubmodule := by
  apply (LinearMap.range feature).topologicalClosure_minimal
  · rintro _ ⟨source, rfl⟩
    apply (LinearMap.range feature').le_topologicalClosure
    refine ⟨morphism.sourceMap source, ?_⟩
    exact LinearMap.congr_fun morphism.feature_commutes source
  · exact (closedRange feature').isClosed

def featureSourceMorphismClosedRangeInclusion
    (feature : C →ₗ[ℂ] H) (feature' : C' →ₗ[ℂ] H)
    (morphism : FeatureSourceMorphism feature feature') :
    (closedRange feature).toSubmodule →ₗᵢ[ℂ]
      (closedRange feature').toSubmodule where
  toFun value :=
    ⟨value, featureSourceMorphism_closedRange_le
      feature feature' morphism value.property⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  norm_map' _ := rfl

/-- A source factorization generates the map of completed ranges through the
same source-owned target. -/
def featureSourceMorphismHilbertAmbientMap
    (feature : C →ₗ[ℂ] H) (feature' : C' →ₗ[ℂ] H)
    (morphism : FeatureSourceMorphism feature feature') :
    HilbertAmbient feature →L[ℂ] HilbertAmbient feature' :=
  let toClosed := (hilbertAmbientClosedRangeEquiv feature).toContinuousLinearEquiv
    |>.toContinuousLinearMap
  let inclusion :=
    (featureSourceMorphismClosedRangeInclusion feature feature' morphism)
      |>.toContinuousLinearMap
  let fromClosed :=
    (hilbertAmbientClosedRangeEquiv feature').symm.toContinuousLinearEquiv
      |>.toContinuousLinearMap
  fromClosed.comp (inclusion.comp toClosed)

theorem featureSourceMorphismHilbertAmbientMap_realization
    (feature : C →ₗ[ℂ] H) (feature' : C' →ₗ[ℂ] H)
    (morphism : FeatureSourceMorphism feature feature')
    (value : HilbertAmbient feature) :
    hilbertAmbientRealization feature'
        (featureSourceMorphismHilbertAmbientMap
          feature feature' morphism value) =
      hilbertAmbientRealization feature value := by
  rw [← hilbertAmbientClosedRangeEquiv_realization feature']
  change
    (((hilbertAmbientClosedRangeEquiv feature')
      ((hilbertAmbientClosedRangeEquiv feature').symm
        (featureSourceMorphismClosedRangeInclusion feature feature' morphism
          (hilbertAmbientClosedRangeEquiv feature value))) :
        (closedRange feature').toSubmodule) : H) = _
  rw [(hilbertAmbientClosedRangeEquiv feature').apply_symm_apply]
  exact hilbertAmbientClosedRangeEquiv_realization feature value

@[simp] theorem featureSourceMorphismHilbertAmbientMap_source
    (feature : C →ₗ[ℂ] H) (feature' : C' →ₗ[ℂ] H)
    (morphism : FeatureSourceMorphism feature feature') (source : C) :
    featureSourceMorphismHilbertAmbientMap feature feature' morphism
        (canonicalHilbertMap feature source) =
      canonicalHilbertMap feature' (morphism.sourceMap source) := by
  apply (hilbertAmbientRealization feature').injective
  rw [featureSourceMorphismHilbertAmbientMap_realization,
    hilbertAmbientRealization_source_readback,
    hilbertAmbientRealization_source_readback]
  exact (LinearMap.congr_fun morphism.feature_commutes source).symm

end
end SourceGeneratedComplexFeaturePerfectification
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
