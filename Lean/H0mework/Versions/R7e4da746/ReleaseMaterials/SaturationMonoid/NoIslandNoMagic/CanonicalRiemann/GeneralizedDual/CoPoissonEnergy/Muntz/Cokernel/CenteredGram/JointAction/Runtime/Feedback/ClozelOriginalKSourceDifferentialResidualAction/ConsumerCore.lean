/-- The received complete residual, its inherited source contribution and the original R physics share one actual native whole. -/
def CompleteResidualRQuantityAcceptance : Prop :=
 (type_of% (complete_R_whole_complete observation nontrivial half initial origin mother packet)) ∧
 (type_of% (complete_R_inherited_action observation nontrivial half initial origin mother packet)) ∧
 (type_of% (complete_received_R_canonical_source observation nontrivial half initial origin mother packet)) ∧
 (type_of% (complete_received_R_roles observation nontrivial half initial origin mother packet)) ∧
 (type_of% (complete_received_R_paired_action observation nontrivial half initial origin mother packet)) ∧
 (type_of% (complete_R_inherited_four_feet observation nontrivial half initial origin mother packet)) ∧
 (type_of% (complete_R_physical_and_outside observation nontrivial half initial origin mother packet)) ∧
 (type_of% (complete_received_R_source_price observation nontrivial half initial origin mother packet)) ∧
 (type_of% (complete_R_whole_source_price observation nontrivial half initial origin mother packet)) ∧
 (type_of% (complete_R_physical_outside_prices observation nontrivial half initial origin mother packet)) ∧
 (∀ shift : ℝ,type_of% (complete_received_R_full_four_terms observation nontrivial half initial origin mother packet shift)) ∧
 (∀ {Result : Type} [AddCommGroup Result] (read : OriginalKFullSourceRAction.Prior.Branches→+Result),
  read (completeRSourceRead initial origin packet.1 (completeResidualRWholeTotal observation nontrivial half initial origin mother packet))=
  read (completeReceivedRQuartet observation nontrivial half initial origin mother packet)+
  read (completeRSourceRead initial origin packet.1 (completeResidualRInherited observation nontrivial half initial origin mother packet)))
attribute [local irreducible] CompleteResidualRQuantityAcceptance

theorem complete_residual_R_quantity_acceptance : CompleteResidualRQuantityAcceptance observation nontrivial half initial origin mother packet := by
 unfold CompleteResidualRQuantityAcceptance
 exact ⟨complete_R_whole_complete _ _ _ _ _ _ _,complete_R_inherited_action _ _ _ _ _ _ _,
  complete_received_R_canonical_source _ _ _ _ _ _ _,complete_received_R_roles _ _ _ _ _ _ _,
  complete_received_R_paired_action _ _ _ _ _ _ _,complete_R_inherited_four_feet _ _ _ _ _ _ _,
  complete_R_physical_and_outside _ _ _ _ _ _ _,complete_received_R_source_price _ _ _ _ _ _ _,
  complete_R_whole_source_price _ _ _ _ _ _ _,complete_R_physical_outside_prices _ _ _ _ _ _ _,
  fun shift=>complete_received_R_full_four_terms _ _ _ _ _ _ _ shift,
  fun read=>complete_R_whole_observer _ _ _ _ _ _ _ read⟩

/-- Direct joint consumption closes the actual source action, full inverse/cochain, source inventory, whole payment/current and independent physics/price consumers. -/
theorem complete_residual_R_action_acceptance :
 CompleteResidualRInstallationAcceptance observation nontrivial half initial origin mother packet ∧
 CompleteResidualRelationAcceptance initial origin packet ∧
 CompleteResidualRQuantityAcceptance observation nontrivial half initial origin mother packet :=
 ⟨complete_residual_R_installation_acceptance _ _ _ _ _ _ _,complete_residual_relation_acceptance _ _ _,
  complete_residual_R_quantity_acceptance _ _ _ _ _ _ _⟩

