private theorem cast_same {α β:Type} (left:α) (right:β) (same:HEq left right) :
    Eq.mp (type_eq_of_heq same) left=right := by
  cases same
  rfl

private noncomputable def occurrence_receipt {V Y:Unit→Type} [∀ target,AddCommGroup (V target)]
    {stock:SourceInventoryExecutionFeed.Inventory (V:=V) (X:=Y) (s:=())}
    (actual:{history:List (SourceInventoryExecutionFeed.Event (V:=V) (X:=Y) (s:=())) // history=stock.trace})
    (point:WR.RelationOccurrence stock) : {value:Formal ℤ V Y () // value=point.word} :=
  ⟨eventWord (actual.val.get (Fin.cast (congrArg List.length actual.property).symm (occurrenceIndex point))),
    congrArg eventWord ((get_cast actual.val stock.trace actual.property (occurrenceIndex point)).trans
      (occurrence_read point))⟩

variable (observation:GeneratedRiemannZeroObservation)
variable (nontrivial:¬ ∃ n:Nat, observation.coordinate = -2*(n+1))
variable (half:OriginalKCombCalculation.Half observation) (depth ordinal:Nat) (t:ℝ)
local notation "root" => Full.sourceRoot observation nontrivial half depth ordinal t
local notation "visit" => Full.sourceVisit observation nontrivial half depth ordinal t
local notation "u7" => Full.sourceU7 observation nontrivial half depth ordinal t
local notation "calculus" => Full.sourceCalculus observation nontrivial half depth ordinal t
local notation "reader" => Full.sourceReader observation nontrivial half depth ordinal t
local notation "raw" => C.wholeDebtRWaveSourceCode observation nontrivial depth half
local notation "native" => WN.native observation nontrivial half depth ordinal

noncomputable def sourceRoot := targetRoot root visit u7 calculus reader
noncomputable def sourceVisit := targetVisit root visit u7 calculus reader
theorem source_frame_root : type_of% (frame_root root visit u7 calculus reader) :=
  frame_root root visit u7 calculus reader
theorem source_frame_visit : type_of% (frame_visit root visit u7 calculus reader) :=
  frame_visit root visit u7 calculus reader
noncomputable def originFace := Full.actualOriginFace observation nontrivial half depth ordinal t

private theorem same_payload : HEq (originFace observation nontrivial half depth ordinal t).rootRead
    (Old.originPayload observation nontrivial half depth ordinal) :=
  (Full.target_source_payload observation nontrivial half depth ordinal t).trans
    ((Response.target_source_payload observation nontrivial half depth ordinal t).trans
      ((Native.target_source_payload observation nontrivial half depth ordinal t).trans
        ((Old.origin_payload observation nontrivial half depth ordinal).trans
          (heq_of_eq (Old.origin_source observation nontrivial half depth ordinal).symm))))

noncomputable def originPayload : type_of% (Old.originPayload observation nontrivial half depth ordinal) :=
  Eq.mp (type_eq_of_heq (same_payload observation nontrivial half depth ordinal t))
    (originFace observation nontrivial half depth ordinal t).rootRead
theorem origin_source : type_of% (cast_same
    (originFace observation nontrivial half depth ordinal t).rootRead
    (Old.originPayload observation nontrivial half depth ordinal)
    (same_payload observation nontrivial half depth ordinal t)) :=
  cast_same _ _ (same_payload observation nontrivial half depth ordinal t)
private noncomputable def payloadHistory
    (payload:type_of% (Old.originPayload observation nontrivial half depth ordinal))
    (same:payload=Old.originPayload observation nontrivial half depth ordinal) :
    {actual:type_of% (WN.beforeStock native).trace // actual=(WN.beforeStock native).trace} := by
  have source : payload.source.occurrences=Old.currentAdmissions observation nontrivial half depth ordinal := by
    unfold OriginalConstantFourierNativeOrigin.currentAdmissions
    exact congrArg (fun value=>value.source.occurrences) same
  let admitted : type_of% (Seed.retainedAdmission observation nontrivial half depth ordinal) :=
    payload.source.occurrences.get (Fin.cast (congrArg List.length source).symm
      (Seed.retainedSlot observation nontrivial half depth ordinal))
  exact ⟨admitted.1.before ++ .relation admitted.1.word :: admitted.1.after,admitted.1.trace_eq.symm⟩

private noncomputable def historyReceipt := payloadHistory observation nontrivial half depth ordinal
  (originPayload observation nontrivial half depth ordinal t)
  (origin_source observation nontrivial half depth ordinal t)
noncomputable def currentHistory := (historyReceipt observation nontrivial half depth ordinal t).val
theorem history_source : type_of% (historyReceipt observation nontrivial half depth ordinal t).property :=
  (historyReceipt observation nontrivial half depth ordinal t).property
private noncomputable def wordReceipt := occurrence_receipt
  (historyReceipt observation nontrivial half depth ordinal t)
  (Seed.originalOccurrence observation nontrivial half depth ordinal)
noncomputable def wholeWaveWord := (wordReceipt observation nontrivial half depth ordinal t).val
theorem whole_wave_source : type_of% ((wordReceipt observation nontrivial half depth ordinal t).property.trans
    (whole_wave_word_source observation nontrivial half depth ordinal).symm) :=
  (wordReceipt observation nontrivial half depth ordinal t).property.trans
    (whole_wave_word_source observation nontrivial half depth ordinal).symm

noncomputable def seedValue : BurnolL2 := physicalValue (AS.bornAfterNative native).1
  (decodeMap (remaining raw) Seed.seedPath (wholeWaveWord observation nontrivial half depth ordinal t))
theorem seed_value_source : seedValue observation nontrivial half depth ordinal t=
    Seed.seedValue observation nontrivial half depth ordinal :=
  congrArg (fun word=>physicalValue (AS.bornAfterNative native).1 (decodeMap (remaining raw) Seed.seedPath word))
    (whole_wave_source observation nontrivial half depth ordinal t)

noncomputable def seedTrace : Trace (C.receipt observation nontrivial depth half).1.environment
    Receipt.sourceCode (.const (seedValue observation nontrivial half depth ordinal t)) :=
  Eq.mp (congrArg (fun point=>Trace (C.receipt observation nontrivial depth half).1.environment Receipt.sourceCode (.const point))
    (seed_value_source observation nontrivial half depth ordinal t).symm) (Seed.seedTrace observation nontrivial half depth ordinal)
theorem seed_trace_source : type_of% (mp_heq
    (congrArg (fun point=>Trace (C.receipt observation nontrivial depth half).1.environment Receipt.sourceCode (.const point))
      (seed_value_source observation nontrivial half depth ordinal t).symm) (Seed.seedTrace observation nontrivial half depth ordinal)) :=
  mp_heq _ _
theorem seed_actual : seedValue observation nontrivial half depth ordinal t=
    burnolQuarterZeroExtension (intervalConstant (1/4:ℝ)) :=
  (seed_value_source observation nontrivial half depth ordinal t).trans
    (Seed.seed_value observation nontrivial half depth ordinal)

