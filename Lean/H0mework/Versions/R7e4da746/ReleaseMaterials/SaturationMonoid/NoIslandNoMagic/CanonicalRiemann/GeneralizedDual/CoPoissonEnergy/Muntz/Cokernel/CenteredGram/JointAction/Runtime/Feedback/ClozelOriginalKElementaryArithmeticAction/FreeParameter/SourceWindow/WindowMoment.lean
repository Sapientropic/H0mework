local notation "q" => (1/4:ℝ)
local notation "F" => fourierL2
local notation "D" => burnolMultiplicativeDilation
local notation "T" => burnolTateReciprocalL2
local notation "K" => burnolCompletedMellinRieszVector

def innerRadius (h:ℝ) : ℝ := q*Real.exp (-h)
private theorem innerRadius_pos (h:ℝ) : 0 < innerRadius h := by unfold innerRadius;positivity
private def tail (c:BurnolCompletedMellinCoordinate) (h:ℝ) : BurnolL2 :=
  burnolRadiusMellinTailKernelL2 (innerRadius h) (innerRadius_pos h) c.value c.rightHalf
private def evenTail (c:BurnolCompletedMellinCoordinate) (h:ℝ) : BurnolL2 :=
  tail c h+reflectL2 (tail c h)

private theorem evenTail_read (c:BurnolCompletedMellinCoordinate) (h:ℝ) :
    (evenTail c h:ℝ→ℂ)=ᵐ[volume] fun x=>
      if innerRadius h < |x| then ((|x|:ℝ):ℂ)^(-star c.value) else 0 := by
  have direct : (tail c h:ℝ→ℂ)=ᵐ[volume] burnolRadiusMellinTailKernelRaw (innerRadius h) c.value :=
    MemLp.coeFn_toLp (burnolRadiusMellinTailKernelRaw_memLp (innerRadius_pos h) c.value c.rightHalf)
  have reverse:=negMeasurePreserving.quasiMeasurePreserving.ae direct
  have parity:=Lp.coeFn_compMeasurePreserving (tail c h) negMeasurePreserving
  change (reflectL2 (tail c h):ℝ→ℂ)=ᵐ[volume] fun x=>tail c h (-x) at parity
  filter_upwards [direct,reverse,parity,Lp.coeFn_add (tail c h) (reflectL2 (tail c h))]
    with x source reversed reflected added
  change (tail c h+reflectL2 (tail c h)) x=_
  rw [added,Pi.add_apply,source,reflected,reversed]
  by_cases sign:0≤x
  · have notNegative:¬innerRadius h < -x:=by linarith [innerRadius_pos h]
    simp only [burnolRadiusMellinTailKernelRaw,mem_Ioi,if_neg notNegative,abs_of_nonneg sign,add_zero]
  · have negative:x<0:=lt_of_not_ge sign
    have notPositive:¬innerRadius h < x:=by linarith [innerRadius_pos h]
    simp only [burnolRadiusMellinTailKernelRaw,mem_Ioi,if_neg notPositive,abs_of_neg negative,zero_add]

/-- The full singular power window is generated by the original Mellin tail and actual Tate/dilation. -/
def powerWindow (c:BurnolCompletedMellinCoordinate) (h:ℝ) : BurnolL2 :=
  ((4:ℂ)*(16:ℂ)^(-star c.value)) • D (Real.log 16) (T (evenTail c h))

private theorem window_scalar (s:ℂ) (x:ℝ) (positive:0<x) :
    ((4:ℂ)*(16:ℂ)^(-s))*4*((16*x:ℝ):ℂ)⁻¹*
      (((16*x:ℝ)⁻¹:ℝ):ℂ)^(-s)=(x:ℂ)^(s-1) := by
  rw [Complex.ofReal_inv,Complex.inv_cpow_ofReal_nonneg (by positivity : 0≤16*x),
    Complex.cpow_neg,Complex.cpow_neg,inv_inv,Complex.ofReal_mul,
    Complex.mul_cpow_ofReal_nonneg (by norm_num:(0:ℝ)≤16) positive.le,
    Complex.cpow_sub s 1 (Complex.ofReal_ne_zero.mpr positive.ne'),Complex.cpow_one]
  have powerNe:(16:ℂ)^s≠0:=Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))
  norm_num only [Complex.ofReal_ofNat]
  field_simp [powerNe,Complex.ofReal_ne_zero.mpr positive.ne']
  ring

theorem actual_power_window_raw (c:BurnolCompletedMellinCoordinate) (h:ℝ) :
    (powerWindow c h:ℝ→ℂ)=ᵐ[volume] fun x=>
      if |x|<q*Real.exp h then ((|x|:ℝ):ℂ)^(star c.value-1) else 0 := by
  have raw:=evenTail_read c h
  have pulled:=burnolTateReciprocalRaw_ae_congr (Lp.memLp (evenTail c h))
    ((Lp.memLp (evenTail c h)).ae_eq raw) raw
  have tate:=(burnolTateReciprocalL2_coeFn (evenTail c h)).trans pulled
  have scaled:=(Measure.quasiMeasurePreserving_smul (μ:=(volume:Measure ℝ))
    (r:=Real.exp (Real.log 16)) (Real.exp_ne_zero _)).ae tate
  filter_upwards [Lp.coeFn_smul ((4:ℂ)*(16:ℂ)^(-star c.value)) (D (Real.log 16) (T (evenTail c h))),
    burnolMultiplicativeDilation_coeFn (Real.log 16) (T (evenTail c h)),scaled,volume.ae_ne (0:ℝ)]
    with x scalar dilation read nonzero
  change (((4:ℂ)*(16:ℂ)^(-star c.value)) • D (Real.log 16) (T (evenTail c h))) x=_
  rw [scalar,Pi.smul_apply,smul_eq_mul,dilation]
  change ((4:ℂ)*(16:ℂ)^(-star c.value))*((Real.exp (Real.log 16/2):ℂ)*
    (T (evenTail c h)) (Real.exp (Real.log 16)*x))=_
  rw [show (T (evenTail c h)) (Real.exp (Real.log 16)*x)=
    burnolTateReciprocalRaw (fun y=>if innerRadius h < |y| then ((|y|:ℝ):ℂ)^(-star c.value) else 0)
      (Real.exp (Real.log 16)*x) from read]
  rw [Real.exp_half,Real.exp_log (by norm_num:(0:ℝ)<16)]
  have squareRoot:Real.sqrt (16:ℝ)=4:=by
    rw [show (16:ℝ)=4^2 by norm_num,Real.sqrt_sq (by norm_num:(0:ℝ)≤4)]
  rw [squareRoot,burnolTateReciprocalRaw]
  have positive:0 < |x|:=abs_pos.mpr nonzero
  have product:innerRadius h*(16*(q*Real.exp h))=1 := by
    unfold innerRadius
    have cancel:Real.exp (-h)*Real.exp h=1:=by rw [←Real.exp_add];simp
    nlinarith [cancel]
  have inside:innerRadius h < |(16*x)⁻¹| ↔ |x|<q*Real.exp h := by
    rw [abs_inv,abs_mul,abs_of_pos (by norm_num:(0:ℝ)<16),←one_div,
      lt_div_iff₀ (by positivity:0<16*|x|)]
    constructor <;> intro condition <;> nlinarith [innerRadius_pos h]
  simp only [inside]
  split_ifs
  · rw [abs_inv,abs_mul,abs_of_pos (by norm_num:(0:ℝ)<16)]
    simpa only [mul_assoc,Complex.ofReal_ofNat] using window_scalar (star c.value) |x| positive
  · simp

private theorem moved_even (c:BurnolCompletedMellinCoordinate) (h:ℝ) :
    reflectL2 (movedTest c h)=movedTest c h := by
  have even:reflectL2 (K c:BurnolL2)=(K c:BurnolL2):=mem_evenL2ClosedFace_iff.mp (K c).property.2
  rw [movedTest,map_sub,map_smul,reflectL2_burnolMultiplicativeDilation,even]

private theorem moved_tail_read (c:BurnolCompletedMellinCoordinate) (h:ℝ) (nonnegative:0≤h) :
    inner ℂ (tail c h) (movedTest c h)=
      (reciprocalMellinTranslationCharacter c.value h-(Real.exp (h/2):ℂ))*kernelSelfSource c := by
  change burnolRadiusMellinTailEvaluator (innerRadius h) (innerRadius_pos h) c.value c.rightHalf (movedTest c h)=_
  rw [burnolRadiusMellinTailEvaluator_eq_integral,←actual_moved_power_integral c h]
  rw [←integral_indicator measurableSet_Ioi,←integral_indicator measurableSet_Ioi]
  apply integral_congr_ae
  filter_upwards [actual_moved_gap c h nonnegative] with x gap
  by_cases above:innerRadius h<x
  · have positive:0<x:=(innerRadius_pos h).trans above
    rw [indicator_of_mem (show x∈Ioi (innerRadius h) from above),indicator_of_mem (show x∈Ioi (0:ℝ) from positive)]
  · rw [indicator_of_notMem (show x∉Ioi (innerRadius h) from above)]
    by_cases positive:0<x
    · rw [indicator_of_mem (show x∈Ioi (0:ℝ) from positive),gap (by rw [abs_of_pos positive];exact le_of_not_gt above),mul_zero]
    · rw [indicator_of_notMem (show x∉Ioi (0:ℝ) from positive)]

/-- Exact full-window power price, including the two real half axes and the actual factor 16. -/
theorem actual_window_power_price (c:BurnolCompletedMellinCoordinate) (h:ℝ) (nonnegative:0≤h) :
    inner ℂ (F (OriginalKElementaryArithmeticAction.FreeParameter.RadiusConsumer.radiusTest c h)) (powerWindow c h)=
      ((8:ℂ)*(16:ℂ)^(-star c.value))*
        star ((reciprocalMellinTranslationCharacter c.value h-(Real.exp (h/2):ℂ))*kernelSelfSource c) := by
  change inner ℂ (F (shiftedUnitTest c h)) (powerWindow c h)=_
  rw [actual_shifted_test_fourier,powerWindow,inner_smul_right,
    (D (Real.log 16)).inner_map_map,OriginalRieszFiniteSynthesis.tate_pairing,burnolTateReciprocalL2_involutive,
    evenTail,inner_add_right]
  have parity:=reflectL2.inner_map_map (movedTest c h) (tail c h)
  rw [moved_even c h] at parity
  rw [parity,←inner_conj_symm (movedTest c h) (tail c h),moved_tail_read c h nonnegative]
  simp only [starRingEnd_apply]
  ring

theorem actual_radius_power_moment (c:BurnolCompletedMellinCoordinate) (h:ℝ) (nonnegative:0≤h) :
    (∫ x:ℝ, if |x|<q*Real.exp h then
      star (F (OriginalKElementaryArithmeticAction.FreeParameter.RadiusConsumer.radiusTest c h) x)*((|x|:ℝ):ℂ)^(star c.value-1) else 0)=
      ((8:ℂ)*(16:ℂ)^(-star c.value))*
        star ((reciprocalMellinTranslationCharacter c.value h-(Real.exp (h/2):ℂ))*kernelSelfSource c) := by
  rw [←actual_window_power_price c h nonnegative,L2.inner_def]
  apply integral_congr_ae
  filter_upwards [actual_power_window_raw c h] with x read
  rw [RCLike.inner_apply,starRingEnd_apply,read]
  split_ifs <;> simp only [mul_comm,zero_mul]

