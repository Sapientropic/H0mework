open private actualPaDelta from
  H0mework.Versions.R7e4da746.ReleaseMaterials.SaturationMonoid.NoIslandNoMagic.CanonicalRiemann.GeneralizedDual.CoPoissonEnergy.Muntz.Cokernel.CenteredGram.JointAction.Runtime.Feedback.ClozelOriginalKElementaryArithmeticAction.WholeDebtRAdjointContactReceiptConsumer

variable (observation : GeneratedRiemannZeroObservation)
variable (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
variable (half : OriginalKCombCalculation.Half observation) (depth ordinal : Nat)
local notation "c" => OriginalKCombCofinalTwoDirection.coordinate observation nontrivial half
local notation "phase" => M.returnPhase observation nontrivial half
local notation "sample" => fun value : BurnolL2 => burnolAnnulusSamplingL2 value 0
local notation "m" => generatedRiemannXiZeroOrder ActualAnalyticOwner observation.coordinate
local notation "e" => burnolAnalyticComplementExpectedPhysicalFourierRead ActualAnalyticOwner observation

private theorem actual_fields (index : Fin 3) :
    W.actualValue observation nontrivial half depth index =
      ![-FiniteMobiusResolventFlux.M (M.primitiveIncrement observation nontrivial half M.spread),
        M.kernelWindowSource observation nontrivial half,
        M.fourierPrimitiveWindowSource observation nontrivial half] index := by
  rw [W.actualValue, W.bound_code_value]
  exact OriginalKPrimitiveMobiusSourceCalculation.actual_code_field observation nontrivial half index

private theorem actual_position_field : W.actualValue observation nontrivial half depth 0 =
    -FiniteMobiusResolventFlux.M (M.primitiveIncrement observation nontrivial half M.spread) := by
  simpa using actual_fields observation nontrivial half depth 0

private theorem actual_kernel_field : W.actualValue observation nontrivial half depth 1 =
    M.kernelWindowSource observation nontrivial half := by
  simpa using actual_fields observation nontrivial half depth 1

private theorem actual_power_field : W.actualValue observation nontrivial half depth 2 =
    M.fourierPrimitiveWindowSource observation nontrivial half := by
  simpa using actual_fields observation nontrivial half depth 2

private theorem actual_effect_cotest : runtimeEffectCotest observation nontrivial half depth =
    A.effectCotest c := by
  unfold runtimeEffectCotest
  rw [actual_field]
  rfl

private def runtimeFieldPrice : ℂ :=
  star (M.primitivePhase observation nontrivial half M.spread *
      M.fourierPrimitivePhase observation nontrivial half M.spread) *
    inner ℂ (W.actualValue observation nontrivial half depth 1)
      (A.weight c • (sample (A.positionColumn c) + A.reciprocalCotest c)) +
  star phase * A.weight c * meanPrice c +
  star (M.primitivePhase observation nontrivial half M.spread *
      M.fourierKernelPhase observation M.spread) *
    inner ℂ (W.actualValue observation nontrivial half depth 2)
      (runtimeEffectCotest observation nontrivial half depth) -
  star (M.fourierKernelPhase observation M.spread *
      M.fourierPrimitivePhase observation nontrivial half M.spread) *
    inner ℂ (W.actualValue observation nontrivial half depth 0)
      (burnolTateReciprocalL2 (runtimeEffectCotest observation nontrivial half depth)) -
  star phase * star (FiniteMobiusResolventFlux.sourceA observation) *
    inner ℂ (FiniteMobiusResolventFlux.defectFlux (observation.coordinate / 2)
      (OriginalKCombCofinalTwoDirection.originalK observation nontrivial half))
      (runtimeEffectCotest observation nontrivial half depth)

private theorem actual_field_price :
    star phase * Prior.runtimePrice observation nontrivial half depth =
      runtimeFieldPrice observation nontrivial half depth := by
  rw [actual_price_source]
  unfold runtimeFieldPrice
  rw [actual_kernel_field, actual_power_field, actual_position_field, actual_effect_cotest]
  exact M.actual_native_return observation nontrivial half

def runtimeNativePrice : ℂ :=
  star (M.primitivePhase observation nontrivial half M.spread *
      M.fourierPrimitivePhase observation nontrivial half M.spread) *
    inner ℂ (W.actualValue observation nontrivial half depth 1)
      (A.weight c • (sample (A.positionColumn c) + A.reciprocalCotest c)) +
  star phase * A.weight c * meanPrice c -
  star (M.primitivePhase observation nontrivial half M.spread *
      M.fourierKernelPhase observation M.spread) *
    inner ℂ (FiniteMobiusResolventFlux.M
      (M.fourierPrimitiveIncrement observation nontrivial half M.spread))
      (runtimeEffectCotest observation nontrivial half depth) -
  star (M.fourierKernelPhase observation M.spread *
      M.fourierPrimitivePhase observation nontrivial half M.spread) *
    inner ℂ (W.actualValue observation nontrivial half depth 0)
      (burnolTateReciprocalL2 (runtimeEffectCotest observation nontrivial half depth)) +
  star phase * star (Native.jointUnitCoefficient observation nontrivial half) *
    inner ℂ (FiniteMobiusResolventFlux.interiorBase c)
      (runtimeEffectCotest observation nontrivial half depth)

private theorem actual_native_price :
    star phase * Prior.runtimePrice observation nontrivial half depth =
      runtimeNativePrice observation nontrivial half depth := by
  calc
    _ = runtimeFieldPrice observation nontrivial half depth :=
      actual_field_price observation nontrivial half depth
    _ = _ := by
      unfold runtimeFieldPrice runtimeNativePrice
      rw [actual_kernel_field, actual_power_field, actual_position_field, actual_effect_cotest]
      exact (M.actual_native_return observation nontrivial half).symm.trans
        (Native.actual_native_return observation nontrivial half)

private theorem actual_native_wave :
    (star phase * A.weight c) * inner ℂ (fourierL2 (generatedK c))
      (Wave.actualValue observation nontrivial half depth) =
        runtimeNativePrice observation nontrivial half depth := by
  rw [mul_assoc, actual_wave_return]
  exact actual_native_price observation nontrivial half depth

private theorem actual_native_rho :
    star phase * (A.weight c * ((2 * kernelMass c) *
      inner ℂ (BandFullStockEuler.correctionRaw c)
        (OriginalKCrossParameterRAdjointSource.PhysicalOutsideSource.physicalOutsideColumn c))) =
      runtimeNativePrice observation nontrivial half depth := by
  rw [actual_rho_return]
  exact actual_native_price observation nontrivial half depth

private theorem actual_native_pa :
    (∀ k : Nat, k < m → inner ℂ (sourceEffect c c)
      (CombSource.Division.rawIterate observation half.down k
        (actualPaDelta observation nontrivial half depth ordinal : BurnolL2)) = 0) ∧
    (star phase * (A.weight c * (2 * kernelMass c))) * inner ℂ (sourceEffect c c)
      (CombSource.Division.rawIterate observation half.down m
        (actualPaDelta observation nontrivial half depth ordinal : BurnolL2)) =
      star (sigma c c) *
        (OriginalKDirectRCofinalDivision.sourceCoefficient observation nontrivial half depth (ordinal+3) -
          OriginalKDirectRCofinalDivision.sourceCoefficient observation nontrivial half depth (ordinal+1)) *
        ((-2 * e) * runtimeNativePrice observation nontrivial half depth) := by
  have prior := actual_pa_release observation nontrivial half depth ordinal
  refine ⟨prior.1, ?_⟩
  calc
    _ = star phase * ((A.weight c * (2 * kernelMass c)) * inner ℂ (sourceEffect c c)
        (CombSource.Division.rawIterate observation half.down m
          (actualPaDelta observation nontrivial half depth ordinal : BurnolL2))) := by ring
    _ = star phase * (star (sigma c c) *
        (OriginalKDirectRCofinalDivision.sourceCoefficient observation nontrivial half depth (ordinal+3) -
          OriginalKDirectRCofinalDivision.sourceCoefficient observation nontrivial half depth (ordinal+1)) *
        ((-2 * e) * Prior.runtimePrice observation nontrivial half depth)) := by rw [prior.2]
    _ = star (sigma c c) *
        (OriginalKDirectRCofinalDivision.sourceCoefficient observation nontrivial half depth (ordinal+3) -
          OriginalKDirectRCofinalDivision.sourceCoefficient observation nontrivial half depth (ordinal+1)) *
        ((-2 * e) * (star phase * Prior.runtimePrice observation nontrivial half depth)) := by ring
    _ = _ := by rw [actual_native_price]

private theorem actual_ordered_source_occurrences :
    (OriginalKPrimitiveMobiusSourceWriteback.nextFace observation nontrivial half depth ordinal).rootRead.source.occurrences =
      OriginalKPrimitiveMobiusSourceWriteback.oldAdmissions observation nontrivial half depth ordinal ++
        OriginalKPrimitiveMobiusSourceWriteback.nativeAdmissions observation nontrivial half depth ordinal := by
  simpa only [OriginalKPrimitiveMobiusSourceWriteback.admissions] using
    W.source_occurrences observation nontrivial half depth ordinal

private noncomputable def Result : Sort _ :=
  Σ' prior : type_of% (Prior.actual_reciprocal_cotest_registered_whole_next
      observation nontrivial half depth ordinal),
    PProd (prior = Prior.actual_reciprocal_cotest_registered_whole_next
      observation nontrivial half depth ordinal) (
  Σ' action : type_of% (W.generatedAction observation nontrivial half depth ordinal),
    PProd (action = W.generatedAction observation nontrivial half depth ordinal)
      ((type_of% (W.actual_compiles observation nontrivial half depth ordinal)) ∧
       (type_of% (W.old_admissions_prefix observation nontrivial half depth ordinal)) ∧
       (type_of% (W.admissions_steps observation nontrivial half depth ordinal)) ∧
       (type_of% (W.admissions_words observation nontrivial half depth ordinal)) ∧
       (type_of% (W.words_sum observation nontrivial half depth ordinal)) ∧
       (∀ index : Fin 3, type_of% (W.actual_boundary observation nontrivial half depth index)) ∧
       (type_of% (W.source_word_split observation nontrivial half depth ordinal)) ∧
       (type_of% (actual_ordered_source_occurrences observation nontrivial half depth ordinal)) ∧
       (∀ index : Fin 3, type_of% (OriginalKPrimitiveMobiusSourceOccurrences.actual_positions
         observation nontrivial half depth ordinal index)) ∧
       (type_of% (W.source_effect observation nontrivial half depth ordinal)) ∧
       (type_of% (W.source_inverse observation nontrivial half depth ordinal)) ∧
       (type_of% (W.inverse_certificate observation nontrivial half depth ordinal)) ∧
       (type_of% (W.actual_born_kernel observation nontrivial half depth ordinal)) ∧
       (type_of% (W.whole_next observation nontrivial half depth ordinal)) ∧
       (type_of% (W.canonical_next observation nontrivial half depth ordinal)) ∧
       (type_of% (W.same_ledger observation nontrivial half depth ordinal)) ∧
       (type_of% (W.same_visit observation nontrivial half depth ordinal)) ∧
       (∀ index : Fin 3, type_of% (W.actual_value_runtime observation nontrivial half depth index)) ∧
       (∀ index : Fin 3, type_of% (actual_fields observation nontrivial half depth index)) ∧
       (M.returnPhase observation nontrivial half ≠ 0) ∧
       (type_of% (actual_field_price observation nontrivial half depth)) ∧
       (type_of% (actual_native_price observation nontrivial half depth)) ∧
       (type_of% (actual_native_wave observation nontrivial half depth)) ∧
       (type_of% (actual_native_rho observation nontrivial half depth)) ∧
       (type_of% (actual_native_pa observation nontrivial half depth ordinal))))

/-- All three registered fields enter the original Rr return before the same-FK unit and wall settle. -/
noncomputable opaque actual_primitive_mobius_registered_whole_next :
    Result observation nontrivial half depth ordinal := by
  exact ⟨Prior.actual_reciprocal_cotest_registered_whole_next observation nontrivial half depth ordinal,
    rfl, W.generatedAction observation nontrivial half depth ordinal, rfl,
    W.actual_compiles observation nontrivial half depth ordinal,
    W.old_admissions_prefix observation nontrivial half depth ordinal,
    W.admissions_steps observation nontrivial half depth ordinal,
    W.admissions_words observation nontrivial half depth ordinal,
    W.words_sum observation nontrivial half depth ordinal,
    (fun index => W.actual_boundary observation nontrivial half depth index),
    W.source_word_split observation nontrivial half depth ordinal,
    actual_ordered_source_occurrences observation nontrivial half depth ordinal,
    (fun index => OriginalKPrimitiveMobiusSourceOccurrences.actual_positions
      observation nontrivial half depth ordinal index),
    W.source_effect observation nontrivial half depth ordinal,
    W.source_inverse observation nontrivial half depth ordinal,
    W.inverse_certificate observation nontrivial half depth ordinal,
    W.actual_born_kernel observation nontrivial half depth ordinal,
    W.whole_next observation nontrivial half depth ordinal,
    W.canonical_next observation nontrivial half depth ordinal,
    W.same_ledger observation nontrivial half depth ordinal,
    W.same_visit observation nontrivial half depth ordinal,
    (fun index => W.actual_value_runtime observation nontrivial half depth index),
    (fun index => actual_fields observation nontrivial half depth index),
    M.return_phase_ne_zero observation nontrivial half,
    actual_field_price observation nontrivial half depth,
    actual_native_price observation nontrivial half depth,
    actual_native_wave observation nontrivial half depth,
    actual_native_rho observation nontrivial half depth,
    actual_native_pa observation nontrivial half depth ordinal⟩

end OriginalWholeDebtRPrimitiveMobiusRegisteredReceiptConsumer
