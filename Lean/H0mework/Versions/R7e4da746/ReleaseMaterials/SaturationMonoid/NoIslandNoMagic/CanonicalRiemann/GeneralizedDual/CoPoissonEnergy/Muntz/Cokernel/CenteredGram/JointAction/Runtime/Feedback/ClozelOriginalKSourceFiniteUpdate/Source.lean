/-- The second finite forcing input is generated by the first reverse orbit and its FC source. -/
def sourcePrimitive (coordinate : BurnolCompletedMellinCoordinate) (shift : ℝ) : Fin 2 → BurnolL2 :=
  ![nativeIntegral (sourceRate coordinate) (regularForcing coordinate 0) shift,
    secondPrimitiveSource coordinate shift]

theorem sourcePrimitive_actual (coordinate : BurnolCompletedMellinCoordinate) (shift : ℝ) (i : Fin 2) :
    sourcePrimitive coordinate shift i = nativeIntegral (sourceRate coordinate) (regularForcing coordinate i) shift := by
  fin_cases i
  · rfl
  · exact (second_primitive_source coordinate shift).symm

/-- Only the original forcing orbit and its complete C/FC contact enter this update. -/
def sourceFiniteOrbit (coordinate : BurnolCompletedMellinCoordinate) (shift : ℝ) (i : Fin 2) : BurnolL2 :=
  Complex.exp (-sourceRate coordinate * (shift : ℂ)) • regularColumns coordinate i +
    sourcePrimitive coordinate shift i +
      burnolMultiplicativeDilation shift (jumpColumns i)

theorem regular_columns_finite_action (coordinate : BurnolCompletedMellinCoordinate) (shift : ℝ) (i : Fin 2) :
    burnolMultiplicativeDilation shift (regularColumns coordinate i) =
      Complex.exp (-sourceRate coordinate * (shift : ℂ)) • regularColumns coordinate i +
        nativeIntegral (sourceRate coordinate) (regularForcing coordinate i) shift := by
  have generated := OriginalRieszFinitePairing.ColumnIntegral.action_of_euler coordinate
    (regularColumns coordinate i) (regularForcing coordinate i) (regularColumns_euler coordinate i) shift
  have character : fullMellinTranslationCharacter (star coordinate.value) shift =
      Complex.exp (-sourceRate coordinate * (shift : ℂ)) := by
    unfold fullMellinTranslationCharacter sourceRate
    congr 1
    ring
  rw [character] at generated
  exact generated

theorem source_columns_finite_action (coordinate : BurnolCompletedMellinCoordinate) (shift : ℝ) (i : Fin 2) :
    burnolMultiplicativeDilation shift (sourceColumns coordinate i) = sourceFiniteOrbit coordinate shift i := by
  unfold sourceFiniteOrbit
  rw [sourcePrimitive_actual, sourceColumns_from_regular_resolvent, map_add, regular_columns_finite_action]

/-- The finite source word contains neither a shifted Y target nor a boundary witness. -/
def sourceFiniteBoundaryColumn (coordinate : BurnolCompletedMellinCoordinate) (shift : ℝ) (i : Fin 2) : BurnolL2 :=
  pairedMellinTranslationCharacter coordinate.value shift •
      (regularColumns coordinate i + jumpColumns i) -
    (1/2 : ℂ) • (sourceFiniteOrbit coordinate shift i + sourceFiniteOrbit coordinate (-shift) i)

theorem source_columns_boundary_action (coordinate : BurnolCompletedMellinCoordinate) (shift : ℝ) (i : Fin 2) :
    finiteBoundaryAction coordinate shift (sourceColumns coordinate i) =
      sourceFiniteBoundaryColumn coordinate shift i := by
  unfold finiteBoundaryAction sourceFiniteBoundaryColumn
  rw [source_columns_finite_action, source_columns_finite_action, sourceColumns_from_regular_resolvent]

/-- Every entry consumes the actual forcing orbit, including both translated contacts. -/
def sourceOrbitGram (coordinate : BurnolCompletedMellinCoordinate) (shift : ℝ) (i j : Fin 2) : ℂ :=
  -inner ℂ (regularColumns coordinate i + jumpColumns i) (sourceFiniteBoundaryColumn coordinate shift j)

theorem source_finite_Gram_action (coordinate : BurnolCompletedMellinCoordinate) (shift : ℝ) (i j : Fin 2) :
    sourceFiniteGram coordinate shift i j = sourceOrbitGram coordinate shift i j := by
  unfold sourceOrbitGram
  rw [← source_columns_boundary_action]
  unfold sourceFiniteGram finiteBoundaryAction
  rw [inner_sub_right, inner_smul_right, inner_smul_right, ← sourceColumns_from_regular_resolvent]
  ring

/-- This word is built only from the original forcing columns, source coefficients and contacts. -/
def sourceFiniteBoundary (coordinate : BurnolCompletedMellinCoordinate) (shift : ℝ) : BurnolL2 :=
  ∑ i : Fin 2, sourceCoefficients coordinate i • sourceFiniteBoundaryColumn coordinate shift i

theorem generatedK_boundary_action (coordinate : BurnolCompletedMellinCoordinate) (shift : ℝ) :
    finiteBoundaryAction coordinate shift (generatedK coordinate) = sourceFiniteBoundary coordinate shift := by
  unfold sourceFiniteBoundary
  rw [Fin.sum_univ_two, ← source_columns_boundary_action, ← source_columns_boundary_action]
  simp only [finiteBoundaryAction, generatedK, sourceColumns, sourceCoefficients,
    Matrix.cons_val_zero, Matrix.cons_val_one, map_add, map_smul]
  module

theorem original_fixedResidual_forcing_orbit (coordinate : BurnolCompletedMellinCoordinate)
    (zero : riemannZeta coordinate.value = 0) :
    burnolPaFixedShiftResidual coordinate zero =
      ∑ i : Fin 2, ∑ j : Fin 2, star (sourceCoefficients coordinate i) * sourceCoefficients coordinate j *
        sourceOrbitGram coordinate (Real.log stageZeroSonineQ) i j := by
  rw [original_fixedResidual_source_Gram]
  simp only [source_finite_Gram_action]

theorem original_boundary_forcing_orbit (coordinate : BurnolCompletedMellinCoordinate)
    (zero : riemannZeta coordinate.value = 0) (shift : ℝ) :
    (burnolZeroPairedFixedAnnulusBoundary coordinate zero shift : BurnolL2) =
      (burnolEvenAmbientProjection (sourceFiniteBoundary coordinate shift) : BurnolL2) := by
  rw [← generatedK_boundary_action, ← sourceNormal_generated, source_fibre_projection]
  exact boundary_source_fibre coordinate zero shift

