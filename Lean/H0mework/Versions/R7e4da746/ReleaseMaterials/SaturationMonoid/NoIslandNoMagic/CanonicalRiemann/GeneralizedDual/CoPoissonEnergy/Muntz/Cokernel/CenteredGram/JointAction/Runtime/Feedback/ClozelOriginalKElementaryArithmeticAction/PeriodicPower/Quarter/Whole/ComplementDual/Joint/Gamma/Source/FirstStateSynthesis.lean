macro "firstStatePaid% " field:ident : term => do
  let paidOwnerPrefix := Lean.Name.num `_private.H0mework.Versions.R7e4da746.ReleaseMaterials.SaturationMonoid.NoIslandNoMagic.CanonicalRiemann.GeneralizedDual.CoPoissonEnergy.Muntz.Cokernel.CenteredGram.JointAction.Runtime.Feedback.ClozelOriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.ComplementDual.Joint.Gamma.Source.RelativeConductorStrongSource 0
  let scope := `SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot.NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.BurnolPhysicalState.OriginalGamma.Source.RelativeConductorStrong
  return Lean.mkIdent (paidOwnerPrefix.append (scope.append field.getId))

private theorem base_commute (c : BurnolCompletedMellinCoordinate)
    (operator : BurnolL2 →L[ℂ] BurnolL2)
    (covariance : ∀ h v, operator (burnolMultiplicativeDilation h v) =
      burnolMultiplicativeDilation h (operator v)) (value : BurnolL2) :
    operator (originalBaseSynthesis c value) = originalBaseSynthesis c (operator value) := by
  simp only [originalBaseSynthesis, add_apply, sub_apply, smul_apply,
    ContinuousLinearMap.id_apply, map_add, map_sub, map_smul]
  rw [returnSynthesis, tailSynthesis,
    (firstStatePaid% radial_commute) operator covariance,
    (firstStatePaid% radial_commute) operator covariance]

private theorem b_commute (c : BurnolCompletedMellinCoordinate)
    (operator : BurnolL2 →L[ℂ] BurnolL2)
    (covariance : ∀ h v, operator (burnolMultiplicativeDilation h v) =
      burnolMultiplicativeDilation h (operator v)) (value : BurnolL2) :
    operator (originalBSynthesis c value) = originalBSynthesis c (operator value) := by
  simp only [originalBSynthesis, sub_apply, smul_apply,
    ContinuousLinearMap.id_apply, map_sub, map_smul]
  rw [bSynthesis, (firstStatePaid% radial_commute) operator covariance]

private theorem original_K_synthesis (c : BurnolCompletedMellinCoordinate) :
    (K c : BurnolL2) = originalBaseSynthesis c ConstantDual.seed -
      fourierL2 (originalBSynthesis c ConstantDual.seed) := by
  rw [← original_base_synthesis, ← original_b_synthesis,
    KCountingSource.base_eq_kernel, add_sub_cancel_right]

private theorem dual_base (c : BurnolCompletedMellinCoordinate) (N : ℕ) (value : BurnolL2) :
    DualSource.source N (originalBaseSynthesis c value) =
      originalBaseSynthesis c (DualSource.source N value) := by
  simpa only [← CountingDual.dual_eq_adjoint] using
    base_commute c (CountingDual.sourceCLM N).adjoint (fun h v => by
      simpa only [← CountingDual.dual_eq_adjoint] using dual_dilation N h v) value

private theorem forward_b (c : BurnolCompletedMellinCoordinate) (N : ℕ) (value : BurnolL2) :
    FiniteForcing.source N (originalBSynthesis c value) =
      originalBSynthesis c (FiniteForcing.source N value) := by
  simpa only [CountingDual.sourceCLM_apply] using
    b_commute c (CountingDual.sourceCLM N) (fun h v => SeedCounting.source_dilation N h v) value

theorem original_first_finite (c : BurnolCompletedMellinCoordinate) (N : ℕ) :
    DualSource.source N (K c : BurnolL2) =
      originalBaseSynthesis c (DualSource.source N ConstantDual.seed) -
        fourierL2 (originalBSynthesis c (FiniteForcing.source N ConstantDual.seed)) := by
  rw [original_K_synthesis, CountingDual.dual_eq_adjoint, map_sub,
    ← CountingDual.dual_eq_adjoint, ← CountingDual.dual_eq_adjoint,
    dual_base, KCounting.dual_fourier, forward_b]

theorem original_first_synthesis (c : BurnolCompletedMellinCoordinate)
    (zero : riemannZeta c.value = 0) :
    originalFirstField c zero = originalBaseSynthesis c ConstantDual.value -
      fourierL2 (originalBSynthesis c ConstantForward.value) := by
  have base := ((originalBaseSynthesis c).continuous.tendsto ConstantDual.value).comp
    ConstantDual.original_tendsto
  have b := (fourierL2.continuous.tendsto (originalBSynthesis c ConstantForward.value)).comp
    (((originalBSynthesis c).continuous.tendsto ConstantForward.value).comp ConstantForward.original_tendsto)
  have source := (base.sub b).congr' (Eventually.of_forall (fun N => (original_first_finite c N).symm))
  exact tendsto_nhds_unique (KCounting.original_tendsto c zero) source

private def inverseJoint : BurnolL2 →L[ℂ] BurnolL2 :=
  burnolTateReciprocalL2.comp fourierL2.toContinuousLinearEquiv.toContinuousLinearMap

private theorem inverse_joint_apply (value : BurnolL2) :
    inverseJoint value = burnolTateReciprocalL2 (fourierL2 value) := rfl

private theorem inverse_joint_dilation (h : ℝ) (value : BurnolL2) :
    inverseJoint (burnolMultiplicativeDilation h value) =
      burnolMultiplicativeDilation h (inverseJoint value) := by
  rw [inverse_joint_apply, fourierL2_burnolMultiplicativeDilation,
    ← burnolTateReciprocalL2_dilation_inverse h, inverse_joint_apply]

private theorem inverse_joint_first : inverseJoint ConstantForward.value = ConstantDual.value := by
  rw [inverse_joint_apply, ConstantFourier.original_square, burnolTateReciprocalL2_involutive]

theorem original_dual_synthesis (c : BurnolCompletedMellinCoordinate)
    (zero : riemannZeta c.value = 0) :
    originalDualField c zero = burnolTateReciprocalL2 (originalBaseSynthesis c ConstantDual.value) -
      originalBSynthesis c ConstantDual.value := by
  rw [originalDualField, original_first_synthesis, map_sub,
    ← inverse_joint_apply, b_commute c inverseJoint inverse_joint_dilation, inverse_joint_first]

