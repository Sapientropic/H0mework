local instance periodPositive : Fact (0<(1:ℝ)) := ⟨by norm_num⟩
local notation "CircleL2" => Lp ℂ 2 (AddCircle.haarAddCircle (T:=(1:ℝ)))

private theorem circle_pair_right (left right : BurnolL2)
    (support:originalPhysicalCutoff (1/2) right=right) :
    inner ℂ (circleMap left) (circleMap right)=inner ℂ left right := by
  have read:=circle_inner right left
  rw [supported_interval_inner right left support] at read
  have reverse:=congrArg (starRingEnd ℂ) read
  simpa only [inner_conj_symm,←circleMap_original] using reverse

private theorem shifted_B_mean (c : BurnolCompletedMellinCoordinate) (h : ℝ)
    (bounded:h≤Real.log 2) :
    inner ℂ (_root_.fourierBasis (T:=(1:ℝ)) 0) (circleMap (D (-h) (E (b c:Hq))))=0 := by
  rw [←_root_.fourierBasis.repr_apply_apply,circleMap_original,circle_coefficient,
    interval_fourier_sample _ (shifted_quarter_supported _ h bounded)]
  simp only [fourierSample,actual_dilation_fourier_point,Int.cast_zero,mul_zero,
    actual_extension_fourier_point,actual_original_origin,mul_zero]

private theorem B_mean (c : BurnolCompletedMellinCoordinate) :
    inner ℂ (_root_.fourierBasis (T:=(1:ℝ)) 0) (circleMap (E (b c:Hq)))=0 := by
  simpa only [neg_zero,burnolMultiplicativeDilation_zero] using
    shifted_B_mean c 0 (Real.log_nonneg (by norm_num))

/-- Every nonzero translate remains in the source pairing; convergence is generated by the paid tail. -/
theorem actual_alias_pair_hasSum (c : BurnolCompletedMellinCoordinate) (test : BurnolL2) :
    HasSum (fun k:ℤ=>inner ℂ (aliasPiece c k) (circleMap test))
      (inner ℂ (aliasValue c) (circleMap test)) := by
  exact ((ContinuousLinearMap.apply ℂ ℂ (circleMap test)).comp (innerSL ℂ)).hasSum
    (aliasPiece_summable_norm c).of_norm.hasSum

theorem actual_alias_reverse_hasSum (c : BurnolCompletedMellinCoordinate) (test : BurnolL2) :
    HasSum (fun k:ℤ=>inner ℂ (circleMap test) (aliasPiece c k))
      (inner ℂ (circleMap test) (aliasValue c)) :=
  (innerSL ℂ (circleMap test)).hasSum (aliasPiece_summable_norm c).of_norm.hasSum

/-- The original shifted cross now reads the full alias field and the exact removed jump. -/
theorem actual_power_B_alias (c : BurnolCompletedMellinCoordinate) (h : ℝ)
    (bounded:h≤Real.log 2) :
    powerBPrice c h=(1/2:ℂ)*(
      inner ℂ (F (elementarySource c)) (D (-h) (E (b c:Hq)))-
      star (jumpCoefficient c)*inner ℂ (F C) (D (-h) (E (b c:Hq)))+
      inner ℂ (aliasValue c) (circleMap (D (-h) (E (b c:Hq))))) := by
  have read:=congrArg (fun value:CircleL2=>inner ℂ value (circleMap (D (-h) (E (b c:Hq)))))
    (actual_periodized_source c)
  rw [periodizedValue,inner_add_left,inner_add_left,inner_smul_left,
    shifted_B_mean c h bounded,mul_zero,add_zero,
    circle_pair_right _ _ (shifted_quarter_supported _ h bounded)] at read
  rw [resolvedSource,map_sub,map_smul,inner_sub_left,inner_smul_left,starRingEnd_apply] at read
  rw [actual_power_B_contact c h bounded,←circleMap_original,←read]

theorem actual_B_power_alias (c : BurnolCompletedMellinCoordinate) :
    bPowerPrice c=(1/2:ℂ)*(
      inner ℂ (E (b c:Hq)) (F (elementarySource c))-
      jumpCoefficient c*inner ℂ (E (b c:Hq)) (F C)+
      inner ℂ (circleMap (E (b c:Hq))) (aliasValue c)) := by
  have mean : inner ℂ (circleMap (E (b c:Hq))) (_root_.fourierBasis (T:=(1:ℝ)) 0)=0 := by
    simpa only [inner_conj_symm,map_zero] using congrArg (starRingEnd ℂ) (B_mean c)
  have read:=congrArg (fun value:CircleL2=>inner ℂ (circleMap (E (b c:Hq))) value)
    (actual_periodized_source c)
  rw [periodizedValue,inner_add_right,inner_add_right,inner_smul_right,mean,mul_zero,add_zero] at read
  have pair : inner ℂ (circleMap (E (b c:Hq))) (circleMap (F (resolvedSource c)))=
      inner ℂ (E (b c:Hq)) (F (resolvedSource c)) := by
    simpa only [inner_conj_symm] using congrArg (starRingEnd ℂ)
      (circle_pair_right (F (resolvedSource c)) (E (b c:Hq)) (quarter_supported _))
  rw [pair,resolvedSource,map_sub,map_smul,inner_sub_right,inner_smul_right] at read
  rw [actual_B_power_contact,←circleMap_original,←read]

/-- The same K lattice producer consumes both complete alias contacts and all original B terms. -/
theorem actual_original_K_alias_price (c : BurnolCompletedMellinCoordinate) (h : ℝ)
    (lower:-Real.log 2≤h) (upper:h≤Real.log 2) :
    HasSum (fun n:ℕ=>star (burnolRieszStateRaw c (n+1))*burnolRieszDilationRaw c h (n+1))
      (fullMellinTranslationCharacter (star c.value) h*((1/4:ℂ)*riemannZeta (c.value+star c.value))-
        (1/2:ℂ)*(inner ℂ (F (elementarySource c)) (D (-h) (E (b c:Hq)))-
          star (jumpCoefficient c)*inner ℂ (F C) (D (-h) (E (b c:Hq)))+
          inner ℂ (aliasValue c) (circleMap (D (-h) (E (b c:Hq)))))-
        fullMellinTranslationCharacter (star c.value) h*((1/2:ℂ)*(
          inner ℂ (E (b c:Hq)) (F (elementarySource c))-
          jumpCoefficient c*inner ℂ (E (b c:Hq)) (F C)+
          inner ℂ (circleMap (E (b c:Hq))) (aliasValue c)))+
        (1/2:ℂ)*inner ℂ (F (E (b c:Hq))) (D h (F (E (b c:Hq))))) := by
  simpa only [actual_power_B_alias c h upper,actual_B_power_alias] using
    actual_original_K_lattice_price c h lower upper

