noncomputable section
local notation "q" => (1 / 4 : ℝ)
local notation "μq" => (volume.restrict (symmetricInterval q))
local notation "Hq" => BurnolQuarterIntervalL2

def frequency : ℂ := 2 * (Real.pi : ℂ)
def scale : ℂ := frequency * (q : ℂ)

def kernel (x y : ℝ) : ℂ := Complex.cos (frequency * (x : ℂ) * (y : ℂ))

def act (f : ℝ → ℂ) (x : ℝ) : ℂ :=
  -((q : ℂ) ^ 2 - (x : ℂ) ^ 2) * deriv (deriv f) x + 2 * (x : ℂ) * deriv f x +
    (2 * (Real.pi : ℂ) * (q : ℂ)) ^ 2 * (x : ℂ) ^ 2 * f x

def meanRaw (f : ℝ → ℂ) : ℂ := 2 * ∫ x : ℝ in (-q)..q, f x

def centerRaw (f : ℝ → ℂ) (x : ℝ) : ℂ := f x - meanRaw f

theorem scale_read : scale = (Real.pi : ℂ) / 2 := by unfold scale frequency; norm_num; ring

theorem original_return_kernel (coordinate : BurnolCompletedMellinCoordinate) (x : ℝ) :
    InverseTail.smoothFourier coordinate x =
      ∫ y : ℝ in symmetricInterval q, kernel x y * burnolRieszReturnRaw coordinate y := by
  exact ReturnedArithmeticKernel.smooth_cosine coordinate x

theorem kernel_hasDerivAt (x y : ℝ) :
    HasDerivAt (fun x : ℝ => kernel x y)
      (-frequency * (y : ℂ) * Complex.sin (frequency * (x : ℂ) * (y : ℂ))) x := by
  have inner := ((hasDerivAt_id (x : ℂ)).const_mul frequency).mul_const (y : ℂ)
  have source := ((Complex.hasDerivAt_cos (frequency * (x : ℂ) * (y : ℂ))).comp (x : ℂ) inner).comp_ofReal
  convert! source using 1
  ring

theorem kernel_deriv (y : ℝ) : deriv (fun x : ℝ => kernel x y) =
    fun x : ℝ => -frequency * (y : ℂ) * Complex.sin (frequency * (x : ℂ) * (y : ℂ)) := by
  funext x
  exact (kernel_hasDerivAt x y).deriv

theorem kernel_second_hasDerivAt (x y : ℝ) :
    HasDerivAt (fun x : ℝ => -frequency * (y : ℂ) * Complex.sin (frequency * (x : ℂ) * (y : ℂ)))
      (-(frequency ^ 2) * (y : ℂ) ^ 2 * kernel x y) x := by
  have inner := ((hasDerivAt_id (x : ℂ)).const_mul frequency).mul_const (y : ℂ)
  have source := (((Complex.hasDerivAt_sin (frequency * (x : ℂ) * (y : ℂ))).comp (x : ℂ) inner).const_mul
    (-frequency * (y : ℂ))).comp_ofReal
  convert! source using 1
  unfold kernel
  ring

theorem kernel_second (x y : ℝ) :
    deriv (deriv (fun x : ℝ => kernel x y)) x =
      -(frequency ^ 2) * (y : ℂ) ^ 2 * kernel x y := by
  rw [kernel_deriv]
  exact (kernel_second_hasDerivAt x y).deriv


private theorem action_kernel (x y : ℝ) :
    act (fun x : ℝ => kernel x y) x =
      -2 * frequency * (x : ℂ) * (y : ℂ) * Complex.sin (frequency * (x : ℂ) * (y : ℂ)) +
      frequency ^ 2 * ((q : ℂ) ^ 2 * ((x : ℂ) ^ 2 + (y : ℂ) ^ 2) - (x : ℂ) ^ 2 * (y : ℂ) ^ 2) * kernel x y := by
  rw [act, kernel_second, kernel_deriv]
  unfold frequency kernel
  ring

/-- Both differential readings are generated by the same original normalized cosine kernel. -/
theorem kernel_joint_action (x y : ℝ) :
    act (fun x : ℝ => kernel x y) x = act (fun y => kernel x y) y := by
  have symmetry : kernel x y = kernel y x := by unfold kernel; congr 1; ring
  have columns : (fun y => kernel x y) = fun y => kernel y x := by
    funext y
    unfold kernel
    congr 1
    ring
  rw [columns, action_kernel, action_kernel]
  rw [← symmetry]
  have argument : frequency * (y : ℂ) * (x : ℂ) = frequency * (x : ℂ) * (y : ℂ) := by ring
  rw [argument]
  ring

theorem act_continuous {f : ℝ → ℂ} (regular : ContDiff ℝ 2 f) : Continuous (act f) := by
  have first : ContDiff ℝ 1 (deriv f) := regular.deriv'
  have df := first.continuous
  have ddf := first.continuous_deriv_one
  unfold act
  fun_prop

private theorem flux_derivative {f : ℝ → ℂ} (regular : ContDiff ℝ 2 f) (x : ℝ) :
    HasDerivAt (fun x : ℝ => ((q : ℂ) ^ 2 - (x : ℂ) ^ 2) * deriv f x)
      (-2 * (x : ℂ) * deriv f x + ((q : ℂ) ^ 2 - (x : ℂ) ^ 2) * deriv (deriv f) x) x := by
  have polynomial : HasDerivAt (fun x : ℝ => (q : ℂ) ^ 2 - (x : ℂ) ^ 2) (-2 * (x : ℂ)) x := by
    simpa only [Pi.pow_apply, id_eq, Nat.cast_ofNat, show (2 : ℕ) - 1 = 1 by decide, pow_one, mul_one, neg_mul] using
      (((hasDerivAt_id (x : ℂ)).pow 2).const_sub ((q : ℂ) ^ 2)).comp_ofReal
  exact polynomial.mul (regular.differentiable_deriv_two x).hasDerivAt

/-- The actual differential action is the divergence action, with no endpoint-domain assumption. -/
theorem act_divergence {f : ℝ → ℂ} (regular : ContDiff ℝ 2 f) (x : ℝ) :
    act f x = -(deriv (fun x : ℝ => ((q : ℂ) ^ 2 - (x : ℂ) ^ 2) * deriv f x) x) +
      scale ^ 2 * (x : ℂ) ^ 2 * f x := by
  rw [(flux_derivative regular x).deriv]
  unfold act scale frequency
  ring


/-- The mean is the original q-projection coefficient; the interval has volume 1/2. -/
theorem meanRaw_coefficient (f : ℝ → ℂ) (continuous : Continuous f) :
    burnolQuarterMeanCoefficient (Constructor.compact f continuous) = meanRaw f :=
  Constructor.mean_compact f continuous

/-- The complete original mean of the prolate action is its quadratic moment contact. -/
theorem mean_act {f : ℝ → ℂ} (regular : ContDiff ℝ 2 f) :
    meanRaw (act f) = 2 * scale ^ 2 * ∫ x : ℝ in (-q)..q, (x : ℂ) ^ 2 * f x := by
  have first : ContDiff ℝ 1 (deriv f) := regular.deriv'
  have df := first.continuous
  have ddf := first.continuous_deriv_one
  let g : ℝ → ℂ := fun x => -2 * (x : ℂ) * deriv f x +
    ((q : ℂ) ^ 2 - (x : ℂ) ^ 2) * deriv (deriv f) x
  have gc : Continuous g := by dsimp [g]; fun_prop
  have gi : IntervalIntegrable g volume (-q) q := gc.intervalIntegrable (-q) q
  have integralFlux := intervalIntegral.integral_eq_sub_of_hasDerivAt
    (fun x _ => flux_derivative regular x) gi
  have fluxZero : (∫ x : ℝ in (-q)..q, g x) = 0 := by
    convert! integralFlux using 1
    push_cast
    ring
  have potential : Continuous (fun x : ℝ => scale ^ 2 * (x : ℂ) ^ 2 * f x) := by fun_prop
  have law : (fun x : ℝ => act f x) = fun x : ℝ => -g x + scale ^ 2 * (x : ℂ) ^ 2 * f x := by
    funext x
    unfold act scale frequency
    dsimp [g]
    ring
  have giNeg : IntervalIntegrable (fun x : ℝ => -g x) volume (-q) q := by
    simpa only [Pi.neg_apply] using! gi.neg
  unfold meanRaw
  rw [law, intervalIntegral.integral_add giNeg (potential.intervalIntegrable (-q) q),
    intervalIntegral.integral_neg, fluxZero, neg_zero, zero_add]
  have source : (∫ x : ℝ in (-q)..q, scale ^ 2 * (x : ℂ) ^ 2 * f x) =
      scale ^ 2 * ∫ x : ℝ in (-q)..q, (x : ℂ) ^ 2 * f x := by
    rw [← intervalIntegral.integral_const_mul]
    apply intervalIntegral.integral_congr
    intro x _
    ring
  rw [source]
  ring

private theorem act_sub_constant (f : ℝ → ℂ) (c : ℂ) (x : ℝ) :
    act (fun x : ℝ => f x - c) x = act f x - scale ^ 2 * (x : ℂ) ^ 2 * c := by
  unfold act
  rw [deriv_sub_const_fun]
  unfold scale frequency
  ring

private theorem projection_contact_raw {f : ℝ → ℂ} (regular : ContDiff ℝ 2 f) (x : ℝ) :
    centerRaw (act f) x = act (centerRaw f) x +
      scale ^ 2 * (meanRaw f * (x : ℂ) ^ 2 - 2 * ∫ y : ℝ in (-q)..q, (y : ℂ) ^ 2 * f y) := by
  change act f x - meanRaw (act f) = act (fun x : ℝ => f x - meanRaw f) x + _
  rw [act_sub_constant, mean_act regular]
  ring

theorem zeroMean_compact_read (f : ℝ → ℂ) (continuous : Continuous f) :
    ((Constructor.zeroMean (Constructor.compact f continuous) : Hq) : ℝ → ℂ) =ᵐ[μq] centerRaw f := by
  have source := Constructor.zeroMean_read (Constructor.compact f continuous)
  rw [meanRaw_coefficient] at source
  rw [source]
  filter_upwards [Lp.coeFn_sub (Constructor.compact f continuous) (meanRaw f • intervalConstant q),
    Constructor.compact_read f continuous, Lp.coeFn_smul (meanRaw f) (intervalConstant q),
    intervalConstant_coeFn q] with x subAt rawAt scaleAt constantAt
  rw [subAt]
  change Constructor.compact f continuous x - (meanRaw f • intervalConstant q) x = centerRaw f x
  rw [rawAt, scaleAt]
  simp only [Pi.smul_apply, smul_eq_mul, constantAt, mul_one, centerRaw]

/-- The rank-two contact belongs to the actual mean-zero projection of the original q interval. -/
theorem mean_projection_contact {f : ℝ → ℂ} (regular : ContDiff ℝ 2 f) :
    ((Constructor.zeroMean (Constructor.compact (act f) (act_continuous regular)) : Hq) : ℝ → ℂ) =ᵐ[μq]
      fun x : ℝ => act (centerRaw f) x +
        scale ^ 2 * (meanRaw f * (x : ℂ) ^ 2 - 2 * ∫ y : ℝ in (-q)..q, (y : ℂ) ^ 2 * f y) := by
  filter_upwards [zeroMean_compact_read (act f) (act_continuous regular)] with x read
  exact read.trans (projection_contact_raw regular x)

end
