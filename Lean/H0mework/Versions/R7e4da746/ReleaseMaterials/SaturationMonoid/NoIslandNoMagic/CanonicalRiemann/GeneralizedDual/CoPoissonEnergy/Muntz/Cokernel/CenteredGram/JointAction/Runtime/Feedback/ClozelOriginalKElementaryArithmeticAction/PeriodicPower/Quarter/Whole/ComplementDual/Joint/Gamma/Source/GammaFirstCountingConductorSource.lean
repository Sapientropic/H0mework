local notation "F" => fourierL2

/-- The same original first count source is acted through both original base and B channels. -/
macro "smoothGammaLogPaid% " field:ident : term => do
  let owner:=Lean.Name.num `_private.H0mework.Versions.R7e4da746.ReleaseMaterials.SaturationMonoid.NoIslandNoMagic.CanonicalRiemann.GeneralizedDual.CoPoissonEnergy.Muntz.Cokernel.CenteredGram.JointAction.Runtime.Feedback.ClozelOriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.ComplementDual.Joint.Gamma.Source.GammaMobiusActedDLogSource 0
  let scope:=`SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot.NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.BurnolPhysicalState.OriginalGamma.Source.GammaMobiusActedDLog
  return Lean.mkIdent (owner.append (scope.append field.getId))

def originalFirstFieldGamma (c:BurnolCompletedMellinCoordinate) : BurnolL2 :=
  originalBaseSynthesis c dualFirstConductor-F (originalBSynthesis c firstConductorValue)
def originalFirstFieldPositionLog (c:BurnolCompletedMellinCoordinate) : BurnolL2 :=
  (kGammaDualPaid% basePositionLog) c ConstantDual.value dualFirstLog-
    F (originalBSynthesis c firstConductorValue-(kGammaDualPaid% bPositionLog) c ConstantForward.value forwardFirstLog)
def originalFirstFieldFrequencyLog (c:BurnolCompletedMellinCoordinate) : BurnolL2 :=
  fourierL2.symm (originalFirstFieldGamma c-originalFirstFieldPositionLog c)

/-- Both original seed conductors pay the whole Gamma first-counting source, retaining the complete Fourier B channel. -/
theorem actual_original_first_field_complete_Gamma_source (c:BurnolCompletedMellinCoordinate)
    (zero:riemannZeta c.value=0) : GammaPair (originalFirstField c zero) (originalFirstFieldGamma c) := by
  have base:=(phiGammaPaid% gamma_pair_base) c ConstantDual.value dualFirstConductor original_dual_first_conductor
  have b:=(programmeGammaFourierPaid% gamma_pair_fourier) _ _
    ((phiGammaPaid% gamma_pair_b) c ConstantForward.value firstConductorValue original_first_whole_conductor)
  intro test
  rw [original_first_synthesis c zero,inner_sub_right,base test,b test,originalFirstFieldGamma,inner_sub_right]

private theorem first_position_source (c:BurnolCompletedMellinCoordinate) (zero:riemannZeta c.value=0) :
    LogPair (originalFirstField c zero) (originalFirstFieldPositionLog c) := by
  have base:=(kGammaDualPaid% base_position_log_source) c ConstantDual.value dualFirstLog original_dual_first_log
  have bGamma:=(phiGammaPaid% gamma_pair_b) c ConstantForward.value firstConductorValue original_first_whole_conductor
  have bPosition:=(kGammaDualPaid% b_position_log_source) c ConstantForward.value forwardFirstLog original_forward_first_log
  have bFrequency:=(smoothGammaLogPaid% inverse_log_from_complete_source) _ _ _ bGamma bPosition
  have bReflected:=(kGammaDualPaid% log_pair_reflect) _ _ bFrequency
  have same (v:BurnolL2) : reflectL2 (fourierL2.symm v)=F v := by
    rw [fourierL2_symm_eq_reflect_fourierL2,reflectL2_reflectL2]
  rw [same,same] at bReflected
  rw [original_first_synthesis c zero]
  exact (dualFourierPaid% logPair_sub) _ _ _ _ base bReflected

/-- The complete inverse-Fourier domain is generated by the actual Gamma source and its original position slot. -/
theorem actual_original_first_field_complete_log_sources (c:BurnolCompletedMellinCoordinate)
    (zero:riemannZeta c.value=0) :
    LogPair (originalFirstField c zero) (originalFirstFieldPositionLog c) ∧
      LogPair (fourierL2.symm (originalFirstField c zero)) (originalFirstFieldFrequencyLog c) :=
  ⟨first_position_source c zero,(smoothGammaLogPaid% inverse_log_from_complete_source) _ _ _
    (actual_original_first_field_complete_Gamma_source c zero) (first_position_source c zero)⟩

