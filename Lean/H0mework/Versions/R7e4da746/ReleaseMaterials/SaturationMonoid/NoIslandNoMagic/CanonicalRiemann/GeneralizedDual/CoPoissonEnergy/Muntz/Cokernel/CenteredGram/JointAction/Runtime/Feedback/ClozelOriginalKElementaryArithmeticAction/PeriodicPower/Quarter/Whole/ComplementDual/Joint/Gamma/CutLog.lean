def rankRaw (coordinate : BurnolCompletedMellinCoordinate) (u : ℝ) : ℂ :=
  if q < |u| ∧ |u|≤4 then ((|u| : ℝ) : ℂ)^(-coordinate.value) else 0

private theorem weighted_rank (coordinate : BurnolCompletedMellinCoordinate) (u : ℝ) (positive : 0<u) :
    (u : ℂ)^(coordinate.value-1)*rankRaw coordinate u=(Ioc q 4).indicator (fun u : ℝ => (u : ℂ)⁻¹) u := by
  unfold rankRaw
  rw [abs_of_pos positive]
  by_cases inside : u∈Ioc q (4 : ℝ)
  · rw [if_pos (show q<u ∧ u≤4 from inside),indicator_of_mem inside,
      ←Complex.cpow_add _ _ (Complex.ofReal_ne_zero.mpr positive.ne'),
      show coordinate.value-1+(-coordinate.value)=(-1 : ℂ) by ring,Complex.cpow_neg_one]
  · rw [if_neg (show ¬(q<u ∧ u≤4) from inside),indicator_of_notMem inside,mul_zero]

/-- The actual finite primitive retains its lower q and upper four contacts. -/
theorem actual_rank_primitive (coordinate : BurnolCompletedMellinCoordinate)
    (a : ℝ) (nonnegative : 0≤a) :
    (∫ u : ℝ in (0 : ℝ)..a,(u : ℂ)^(coordinate.value-1)*rankRaw coordinate u)=
      if q<a then (Real.log (min 4 a/q) : ℂ) else 0 := by
  have intersection : Ioc q (4 : ℝ)∩Ioc 0 a=Ioc q (min 4 a) := by
    ext u
    simp only [mem_inter_iff,mem_Ioc,le_min_iff]
    constructor
    · rintro ⟨⟨lower,upper⟩,⟨_,bounded⟩⟩
      exact ⟨lower,upper,bounded⟩
    · rintro ⟨lower,upper,bounded⟩
      exact ⟨⟨lower,upper⟩,⟨by linarith,bounded⟩⟩
  have source : (∫ u : ℝ in (0 : ℝ)..a,(u : ℂ)^(coordinate.value-1)*rankRaw coordinate u)=
      ∫ u : ℝ in Ioc q (min 4 a),(u : ℂ)⁻¹ := by
    rw [intervalIntegral.integral_of_le nonnegative]
    calc
      _=∫ u : ℝ in Ioc 0 a,(Ioc q (4 : ℝ)).indicator (fun u : ℝ => (u : ℂ)⁻¹) u := by
        apply setIntegral_congr_fun measurableSet_Ioc
        intro u inside
        exact weighted_rank coordinate u inside.1
      _=_ := by rw [integral_indicator measurableSet_Ioc,Measure.restrict_restrict measurableSet_Ioc,intersection]
  rw [source]
  by_cases active : q<a
  · have ordered : q≤min 4 a := le_min (by norm_num) active.le
    rw [if_pos active,←intervalIntegral.integral_of_le ordered]
    simp_rw [←Complex.ofReal_inv]
    rw [intervalIntegral.integral_ofReal,integral_inv_of_pos (by norm_num : (0 : ℝ)<q)
      (lt_min (by norm_num) (lt_trans (by norm_num : (0 : ℝ)<q) active))]
  · rw [if_neg active,Ioc_eq_empty_of_le ((min_le_right (4 : ℝ) a).trans (le_of_not_gt active)),setIntegral_empty]

def logValue (coordinate : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  (2 : ℂ) • R coordinate (rankValue coordinate)-
    ((4 : ℂ)*(Real.log 16 : ℂ)) • burnolRadiusNormalizedUnitTail coordinate 4 (by norm_num)

def logGamma (coordinate : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  (2 : ℂ) • R coordinate (rankGamma coordinate)-
    ((4 : ℂ)*(Real.log 16 : ℂ)) • fourTailGamma coordinate

def logRaw (coordinate : BurnolCompletedMellinCoordinate) (u : ℝ) : ℂ :=
  if q < |u| ∧ |u|≤4 then -(4 : ℂ)*((|u| : ℝ) : ℂ)^(-coordinate.value)*(Real.log (|u|/q) : ℂ) else 0

/-- The logarithmic cut is generated by R on the rank source, with its entire original exterior counterterm. -/
theorem actual_log_raw (coordinate : BurnolCompletedMellinCoordinate) :
    (logValue coordinate : ℝ → ℂ)=ᵐ[volume] logRaw coordinate := by
  have rankRead : (rankValue coordinate : ℝ → ℂ)=ᵐ[volume] rankRaw coordinate := actual_rank_raw coordinate
  have acted := actual_R_raw coordinate (rankValue coordinate) (rankRaw coordinate) rankRead (actual_rank_even coordinate)
  filter_upwards [Lp.coeFn_sub ((2 : ℂ) • R coordinate (rankValue coordinate))
    (((4 : ℂ)*(Real.log 16 : ℂ)) • burnolRadiusNormalizedUnitTail coordinate 4 (by norm_num)),
    Lp.coeFn_smul (2 : ℂ) (R coordinate (rankValue coordinate)),
    Lp.coeFn_smul ((4 : ℂ)*(Real.log 16 : ℂ)) (burnolRadiusNormalizedUnitTail coordinate 4 (by norm_num)),
    acted,burnolRadiusUnitTail_coeFn coordinate 4 (by norm_num)] with u difference first second action tail
  change ((2 : ℂ) • R coordinate (rankValue coordinate)-
    ((4 : ℂ)*(Real.log 16 : ℂ)) • burnolRadiusNormalizedUnitTail coordinate 4 (by norm_num)) u=_
  rw [difference,Pi.sub_apply,first,second,Pi.smul_apply,Pi.smul_apply]
  change 2*burnolDirectRightResolvent (coordinate.value/2) (rankValue coordinate) u-
    (4*(Real.log 16 : ℂ))*burnolRadiusNormalizedUnitTail coordinate 4 (by norm_num) u=_
  rw [action,tail,prefixRaw,actual_rank_primitive coordinate |u| (abs_nonneg u)]
  unfold logRaw
  by_cases lower : q < |u|
  · by_cases upper : |u|≤4
    · rw [if_pos lower,min_eq_right upper,if_neg (not_lt_of_ge upper),if_pos ⟨lower,upper⟩]
      ring
    · rw [if_pos lower,min_eq_left (le_of_not_ge upper),if_pos (lt_of_not_ge upper),
        if_neg (fun inside => upper inside.2)]
      norm_num
      ring
  · have notUpper : ¬4 < |u| := by linarith
    rw [if_neg lower,if_neg notUpper,if_neg (fun inside => lower inside.1)]
    ring

/-- The actual rank and endpoint Gamma fields generate the complete whole log-cut Gamma source. -/
theorem actual_log_Gamma (coordinate : BurnolCompletedMellinCoordinate) :
    GammaPair (logValue coordinate) (logGamma coordinate) := by
  intro test
  rw [logValue,logGamma,inner_sub_right,inner_sub_right,inner_smul_right,inner_smul_right,
    inner_smul_right,inner_smul_right,actual_Gamma_R coordinate _ _ (actual_rank_Gamma coordinate) test,
    actual_four_tail_Gamma coordinate test]

