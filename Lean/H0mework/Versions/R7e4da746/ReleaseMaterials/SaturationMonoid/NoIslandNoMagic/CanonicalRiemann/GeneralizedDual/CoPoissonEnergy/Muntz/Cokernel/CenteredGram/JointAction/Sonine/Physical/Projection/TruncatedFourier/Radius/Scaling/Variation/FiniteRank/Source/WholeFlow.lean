attribute [local instance 1100] Module.complexToReal NormedSpace.complexToReal
local notation "Hq" => BurnolQuarterIntervalL2
local notation "M" => BurnolQuarterMeanZeroCarrier
local notation "q" => (1/4:ℝ)
local notation "Tq" => burnolTruncatedFourier
local notation "C" => intervalConstant q
local notation "ι" => Submodule.subtypeL burnolQuarterMeanZeroClosedFace.toSubmodule

def sourceMu : ℂ := burnolQuarterMeanCoefficient (Tq (Response.u:Hq))
def sourceNu : ℂ := burnolQuarterMeanCoefficient (Tq (Response.v:Hq))
def fullForcing : Hq := (Response.eta:Hq)-sourceNu • C-sourceMu • Tq C
def sourceU : H := quarterChart (Response.u:Hq)
def sourceF : H := quarterChart fullForcing

def etaPath (t:ℝ) : M := Constructor.zeroMean (originalSource t)
def uPath (t:ℝ) : M := burnolMeanZeroBlockInverse (etaPath t)
def vPath (t:ℝ) : M := burnolMeanZeroTruncatedFourier (uPath t)
def muPath (t:ℝ) : ℂ := burnolQuarterMeanCoefficient (Tq (uPath t:Hq))
def nuPath (t:ℝ) : ℂ := burnolQuarterMeanCoefficient (Tq (vPath t:Hq))
def forcingPath (t:ℝ) : Hq := (etaPath t:Hq)-nuPath t • C-muPath t • Tq C

/-- Both removed means are generated by the same actual unprojected source path. -/
theorem actual_mean_velocities :
    HasDerivAt muPath sourceMu 0 ∧ HasDerivAt nuPath sourceNu 0 := by
  have uDerivative := ((ι).restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt 0 original_u_hasDerivAt
  have vDerivative := ((ι).restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt 0 original_v_hasDerivAt
  have duT := ((Tq).restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt 0 uDerivative
  have dvT := ((Tq).restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt 0 vDerivative
  have duMean := ((innerSL ℂ C).restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt 0 duT
  have dvMean := ((innerSL ℂ C).restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt 0 dvT
  exact ⟨duMean.div_const (((‖C‖^2:ℝ):ℂ)),dvMean.div_const (((‖C‖^2:ℝ):ℂ))⟩

/-- The complete fixed-window equation holds before taking its source velocity. -/
theorem actual_full_path_equation (t:ℝ) :
    (uPath t:Hq)-Tq (Tq (uPath t:Hq))=forcingPath t := by
  have inverse := congrArg (fun operator:M →L[ℂ] M => operator (etaPath t))
    burnolMeanZeroBlockInverse_right
  change uPath t-burnolMeanZeroTruncatedFourier (vPath t)=etaPath t at inverse
  have ambient := congrArg (fun value:M => (value:Hq)) inverse
  change (uPath t:Hq)-(Constructor.zeroMean (Tq (vPath t:Hq)):Hq)=(etaPath t:Hq) at ambient
  rw [Constructor.zeroMean_read] at ambient
  change (uPath t:Hq)-(Tq (vPath t:Hq)-nuPath t • C)=(etaPath t:Hq) at ambient
  have returned : (vPath t:Hq)=Tq (uPath t:Hq)-muPath t • C := Constructor.zeroMean_read _
  have effect := congrArg Tq returned
  rw [map_sub,map_smul] at effect
  rw [effect] at ambient
  unfold forcingPath
  linear_combination (norm:=module) ambient

/-- The original complete forcing is the derivative of this one actual source family. -/
theorem actual_full_forcing_velocity : HasDerivAt forcingPath fullForcing 0 := by
  have etaDerivative := ((ι).restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt 0 original_centered_hasDerivAt
  have generated := (etaDerivative.sub
    (actual_mean_velocities.2.smul (hasDerivAt_const (0:ℝ) C))).sub
      (actual_mean_velocities.1.smul (hasDerivAt_const (0:ℝ) (Tq C)))
  simpa only [smul_zero,zero_add] using! generated

/-- The existing complete inverse consumes the same path, with neither mean supplied externally. -/
theorem actual_existing_inverse_path (t:ℝ) :
    sourceInverse q (quarterChart (forcingPath t))=quarterChart (uPath t:Hq) := by
  have source := congrArg quarterChart (actual_full_path_equation t)
  rw [map_sub,←quarter_fourier_chart,←quarter_fourier_chart] at source
  have generated := congrArg (sourceInverse q) source
  have restore := congrArg (fun operator:H →L[ℂ] H => operator (quarterChart (uPath t:Hq)))
    (actual_source_inverse q (by norm_num) (by norm_num)).2
  change sourceInverse q (quarterChart (uPath t:Hq)-
    burnolRechartedTruncatedFourierOperator q
      (burnolRechartedTruncatedFourierOperator q (quarterChart (uPath t:Hq))))=
      quarterChart (uPath t:Hq) at restore
  exact generated.symm.trans restore

theorem actual_existing_inverse_velocity :
    HasDerivAt (fun t:ℝ => sourceInverse q (quarterChart (forcingPath t))) sourceU 0 := by
  have generated := (quarterChart.toContinuousLinearEquiv.toContinuousLinearMap.restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt
    0 (((ι).restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt 0 original_u_hasDerivAt)
  change HasDerivAt (fun t:ℝ => quarterChart (uPath t:Hq)) sourceU 0 at generated
  exact generated.congr_of_eventuallyEq (Filter.Eventually.of_forall actual_existing_inverse_path)

/-- The original complete forcing is read from the derivative of that same path. -/
theorem actual_original_inverse_source : sourceInverse q sourceF=sourceU := by
  have charted := (quarterChart.toContinuousLinearEquiv.toContinuousLinearMap.restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt
    0 actual_full_forcing_velocity
  have generated := ((sourceInverse q).restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt 0 charted
  exact generated.unique actual_existing_inverse_velocity

