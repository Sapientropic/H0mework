/-- The counted outgoing read is generated by the complete original Unit programme at the same N. -/
theorem actual_counted_tail_limit (c:BurnolCompletedMellinCoordinate) (j:ℕ) (value:BurnolL2)
    (even:reflectL2 value=value):
    Tendsto (fun N:ℕ=>burnolRadiusMellinTailEvaluator 4 (by norm_num) (barC c).value (barC c).rightHalf
      (((sourceVolterraResolvent (barC c))^j) (DualSource.source N value))) atTop
      (𝓝 ((-1/2:ℂ)*inner ℂ (((R c)^j) (burnolUnitTailResponse c 4)) value)):=by
  have native:=(actual_native_unit_forward c j).const_smul (-1/2:ℂ)
  have finiteCovector (N:ℕ):FiniteForcing.source N (tailCovector (barC c) j)=
      (-1/2:ℂ) • FiniteForcing.source N
        (OriginalKCenteredMobiusRSource.UnitTailActionSource.nativeUnitMuSource c j):=by
    change CountingDual.sourceCLM N ((-1/2:ℂ) •
      OriginalKCenteredMobiusRSource.UnitTailActionSource.nativeUnitMuSource (barC (barC c)) j)=_
    rw [bar_bar,map_smul]
    rfl
  have covector:=native.congr' (Eventually.of_forall (fun N=>(finiteCovector N).symm))
  have price:=covector.inner (𝕜:=ℂ) (tendsto_const_nhds (x:=value))
  have scalar:inner ℂ ((-1/2:ℂ) • (((R c)^j) (burnolUnitTailResponse c 4))) value=
      (-1/2:ℂ)*inner ℂ (((R c)^j) (burnolUnitTailResponse c 4)) value:=by
    simp only [inner_smul_left,map_div₀,map_neg,map_one,map_ofNat]
  rw [scalar] at price
  have finite (N:ℕ):burnolRadiusMellinTailEvaluator 4 (by norm_num) (barC c).value (barC c).rightHalf
      (((sourceVolterraResolvent (barC c))^j) (DualSource.source N value))=
      inner ℂ (FiniteForcing.source N (tailCovector (barC c) j)) value:=by
    have parity:reflectL2 (DualSource.source N value)=DualSource.source N value:=by
      rw [dual_reflect,even]
    rw [actual_outgoing_tail_price _ _ _ parity]
    exact (CountingDual.source_pairing N _ _).symm
  exact price.congr' (Eventually.of_forall (fun N=>(finite N).symm))

private theorem dilation_power (c:BurnolCompletedMellinCoordinate) (j:ℕ) (shift:ℝ) (value:BurnolL2):
    D shift (((sourceVolterraResolvent (barC c))^j) value)=
      ((sourceVolterraResolvent (barC c))^j) (D shift value):=by
  induction j with
  | zero=>simp only [pow_zero,one_apply_eq_self]
  | succ j previous=>
    rw [pow_succ',mul_apply_eq_comp,←outward_dilation,previous,mul_apply_eq_comp]

/-- The independent Unit price reads the specified whole original field after genuine action and displacement. -/
theorem actual_joint_moving_tail (c:BurnolCompletedMellinCoordinate) (zero:riemannZeta c.value=0)
    (h:ℝ) (positive:0<h) (j:ℕ) (shift:ℝ):
    burnolRadiusMellinTailEvaluator 4 (by norm_num) (barC c).value (barC c).rightHalf
        (D shift (T (directValue c zero h positive j)))=
      (-1/2:ℂ)*inner ℂ (((R c)^j) (burnolUnitTailResponse c 4)) (D shift (jointSource c)):=by
  have graph:=((D shift).continuous.tendsto _).comp (actual_original_joint_reverse_graph c zero h positive j)
  have moved:Tendsto (fun N:ℕ=>DualSource.source N (D shift (tateSource c j))) atTop
      (𝓝 (D shift (T (directValue c zero h positive j)))):=
    graph.congr' (Eventually.of_forall (fun N=>(dual_dilation N shift (tateSource c j)).symm))
  have left:=((burnolRadiusMellinTailEvaluator 4 (by norm_num) (barC c).value (barC c).rightHalf).continuous.tendsto _).comp moved
  have parity:reflectL2 (D shift (jointSource c))=D shift (jointSource c):=by
    rw [reflectL2_burnolMultiplicativeDilation,joint_even]
  have right:=actual_counted_tail_limit c j (D shift (jointSource c)) parity
  have finite (N:ℕ):DualSource.source N (D shift (tateSource c j))=
      ((sourceVolterraResolvent (barC c))^j) (DualSource.source N (D shift (jointSource c))):=by
    rw [actual_tate_outgoing,dilation_power,reverse_power]
  have same:=left.congr' (Eventually.of_forall (fun N=>congrArg
    (burnolRadiusMellinTailEvaluator 4 (by norm_num) (barC c).value (barC c).rightHalf) (finite N)))
  exact tendsto_nhds_unique same right

/-- The original compact H−B head is retained together with the full moved native return. -/
theorem actual_complete_moving_tail (c:BurnolCompletedMellinCoordinate) (zero:riemannZeta c.value=0)
    (h:ℝ) (positive:0<h) (j:ℕ) (shift:ℝ):
    burnolRadiusMellinTailEvaluator 4 (by norm_num) (barC c).value (barC c).rightHalf
        (D shift (T (directValue c zero h positive j)))=
