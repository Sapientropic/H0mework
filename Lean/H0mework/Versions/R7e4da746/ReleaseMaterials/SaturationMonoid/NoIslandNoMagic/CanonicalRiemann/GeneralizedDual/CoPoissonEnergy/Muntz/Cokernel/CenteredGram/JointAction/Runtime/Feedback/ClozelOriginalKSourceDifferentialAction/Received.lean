/-- Source installation keeps the actual frame and full seed and installs the calculation before its genuine native admission. -/
def sourceDifferentialPacket : AS.AdmissionPacket (W:=W) (X:=X) (s:=()) :=
 ⟨packet.1,packet.2.1,SF.cfg (sourceDifferentialFactory mother) packet.1 packet.2.1.2,⟨rfl⟩⟩

def sourceDifferentialMaterial := R.actualMaterial packet.2.1.1
 (SF.cfg (sourceDifferentialFactory mother) packet.1 packet.2.1.2)

/-- This is the complete native source total with its own inherited environment effect. -/
def sourceDifferentialNativeTotal : PairValue (L.Value W packet.1) () :=
 WB.oldPaid packet.2.1.1 (SF.cfg (sourceDifferentialFactory mother) packet.1 packet.2.1.2)+
 (show PairValue (L.Value W packet.1) () from
  Native.nativeValue (sourceDifferentialFactory mother) (sourceDifferentialPacket mother packet))

def sourceDifferentialInheritedEffect : PairValue (L.Value W packet.1) () :=
 (sourceDifferentialMaterial mother packet).raw.effect
  (sourceDifferentialMaterial mother packet).environment (sourceDifferentialMaterial mother packet).increment

/-- The original delta-word source pair is recovered without claiming that the native updated environment equals its old source environment. -/
theorem source_differential_native_two_fees :
 sourceDifferentialNativeTotal mother packet=
 (sourceDifferentialMaterial mother packet).raw.eval (sourceDifferentialMaterial mother packet).environment+
 sourceDifferentialInheritedEffect mother packet :=
 (Prior.source_actual_native_total (sourceDifferentialFactory mother) (sourceDifferentialPacket mother packet)).trans
  (Expr.eval_update (sourceDifferentialMaterial mother packet).raw
   (sourceDifferentialMaterial mother packet).environment (sourceDifferentialMaterial mother packet).increment)

/-- The current raw material is the supplied original source occurrence's actual differential programme. -/
theorem source_differential_material_raw :
 (sourceDifferentialMaterial mother packet).raw=sourceMaterialCode (A.epoch packet.2.1.1) (S.actualOccurrence packet.2.1.1) ∧
 (sourceDifferentialMaterial mother packet).environment=sourceMaterialEnvironment (A.epoch packet.2.1.1) (S.actualOccurrence packet.2.1.1) := ⟨rfl,rfl⟩

/-- The existing writer consumes all native fees before producing the actual born environment. -/
theorem source_differential_received_write : type_of%
 (Prior.source_actual_born_write (sourceDifferentialFactory mother) (sourceDifferentialPacket mother packet)) :=
 Prior.source_actual_born_write _ _

