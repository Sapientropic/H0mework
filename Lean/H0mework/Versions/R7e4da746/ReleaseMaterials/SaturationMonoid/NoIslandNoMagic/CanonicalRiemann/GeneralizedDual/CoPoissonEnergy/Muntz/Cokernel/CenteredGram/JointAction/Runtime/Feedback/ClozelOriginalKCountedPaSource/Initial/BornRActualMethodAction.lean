theorem raw_whole_action (n:Nat)
 (frame:RootGeneratedDebtActivationJointSource.Successor.Inquiry.Continuation.Frame
  (Value:=Lower.Value A.W n) (Var:=A.X) (sort:=slot)) :
 (raw observation nontrivial half n frame).expression.eval (raw observation nontrivial half n frame).environment=
 (A.actionAt observation nontrivial half n ((retainedCode n frame).eval frame.registered.input.environment),0) := by
 have paired:=BornRSourceMethodConsumer.Generic.pair_zero (retainedCode n frame) frame.registered.input.environment
 change (@pairAction (Lower.Value A.W n slot) (BornRCanonicalMethodRuntime.levelGroups n slot)
  (A.actionAt observation nontrivial half n))
  ((liftExpr (retainedCode n frame)).eval (pairEnvironment frame.registered.input.environment 0))=_
 rw [paired]
 change (A.actionAt observation nontrivial half n ((retainedCode n frame).eval frame.registered.input.environment),
  A.actionAt observation nontrivial half n 0)=_
 rw [map_zero]

theorem factory_reader (n:Nat)
 (seed:RootedAccountedUnfolding (PresentedRelationEventAt (Expr (Lower.Value A.W n) A.X slot)))
 (frame:RootGeneratedDebtActivationJointSource.Successor.Inquiry.Continuation.Frame
  (Value:=Lower.Value A.W n) (Var:=A.X) (sort:=slot)) :
 R.actionReader frame (SF.cfg factory n seed) (S.actualOccurrence frame)=
 raw observation nontrivial half n frame := rfl

theorem native_whole_value (n:Nat)
 (source:RootGeneratedDebtActivationJointSource.Successor.Inquiry.Continuation.Frame
  (Value:=Lower.Value A.W n) (Var:=A.X) (sort:=slot))
 (seed:RootedAccountedUnfolding (PresentedRelationEventAt (Expr (Lower.Value A.W n) A.X slot)))
 (datum:type_of% (SF.cfg factory n seed).datum)
 (inventory:type_of% (SF.cfg factory n seed).nextInventory)
 (pairInventory:type_of% (SF.cfg factory n seed).nextPairInventory)
 (frame:RootGeneratedDebtActivationJointSource.Successor.Inquiry.Continuation.Frame
  (Value:=Lower.Value A.W (n+1)) (Var:=A.X) (sort:=slot)) :
 let cfg:SourceOperationInquiry.Context.Faces.Execution.Activation.Programme
  (PhysicalValue:=Lower.Value A.W n) (PhysicalVar:=A.X) (sort:=slot):=
  {LowVar:=A.X,datum:=datum,nextInventory:=inventory,nextPairInventory:=pairInventory}
 (R.actionResultAt frame (AS.stockCfg (AS.nextBase factory n (source,seed) cfg rfl))
  (S.actualOccurrence frame)).2.2.1=
 (A.actionAt observation nontrivial half (n+1)
   ((retainedCode (n+1) frame).eval frame.registered.input.environment),0) := by
 dsimp only
 let cfg:SourceOperationInquiry.Context.Faces.Execution.Activation.Programme
  (PhysicalValue:=Lower.Value A.W n) (PhysicalVar:=A.X) (sort:=slot):=
  {LowVar:=A.X,datum:=datum,nextInventory:=inventory,nextPairInventory:=pairInventory}
 let programme:=AS.stockCfg (AS.nextBase factory n (source,seed) cfg rfl)
 have sourceRaw:=AS.next_action_reader factory n (source,seed) cfg rfl frame (S.actualOccurrence frame)
 have templateRaw:=factory_reader observation nontrivial half (n+1)
  (AS.nextSeed factory n (source,seed) cfg rfl) frame
 have read:=congrArg (fun input:RootGeneratedDebtActivationJointSource.OwnerFree.Raw
  (Value:=PairValue (Lower.Value A.W (n+1))) (Var:=A.X) (sort:=slot)=>input.expression.eval input.environment)
  (sourceRaw.trans templateRaw)
 have generated:=OF.source_value (S.baseRoot frame programme).toAuthoritativeRoot
  (R.actionReader frame programme) (S.actualOccurrence frame)
 exact generated.trans (read.trans (raw_whole_action observation nontrivial half (n+1) frame))

def WholeStep
 (packet next:AS.AdmissionPacket (W:=A.W) (X:=A.X) (s:=slot)) : Prop :=
 HEq
  (R.actionResultAt next.2.1.1 next.2.2.1 (S.actualOccurrence next.2.1.1)).2.2.1
  ((@pairAction (Lower.Value A.W packet.1 slot) (BornRCanonicalMethodRuntime.levelGroups packet.1 slot)
    (A.actionAt observation nontrivial half packet.1))
    (R.actionResultAt packet.2.1.1 packet.2.2.1 (S.actualOccurrence packet.2.1.1)).2.2.1,
   (0:PairValue (Lower.Value A.W packet.1) slot))

private theorem after_native_whole_action
 (packet:AS.AdmissionPacket (W:=A.W) (X:=A.X) (s:=slot)) :
 WholeStep observation nontrivial half packet (AS.bornAfterNative (AS.nativeAfterAdmission factory packet)) := by
 unfold WholeStep
 have feed:=after_native_value observation nontrivial half packet
 rcases packet with ⟨n,⟨source,seed⟩,⟨Y,datum,inventory,pairInventory⟩,⟨language⟩⟩
 cases language
 let cfg:SourceOperationInquiry.Context.Faces.Execution.Activation.Programme
  (PhysicalValue:=Lower.Value A.W n) (PhysicalVar:=A.X) (sort:=slot):=
  {LowVar:=A.X,datum:=datum,nextInventory:=inventory,nextPairInventory:=pairInventory}
 let packet:AS.AdmissionPacket (W:=A.W) (X:=A.X) (s:=slot):=⟨n,⟨source,seed⟩,cfg,⟨rfl⟩⟩
 let next:=AS.bornAfterNative (AS.nativeAfterAdmission factory packet)
 have generated:=native_whole_value observation nontrivial half n source seed datum inventory pairInventory next.2.1.1
 have sourceFeed:=congrArg (fun value:Lower.Value A.W (n+1) slot=>
  (A.actionAt observation nontrivial half (n+1) value,
   (0:Lower.Value A.W (n+1) slot))) (eq_of_heq feed)
 dsimp only [retainedValue,AS.nativeAfterAdmission,AS.bornAfterNative,AS.localNativeReceipt,packetTransport,id] at sourceFeed
 dsimp only [next,packet,cfg,AS.nativeAfterAdmission,AS.bornAfterNative,AS.localNativeReceipt,packetTransport,id] at generated
 dsimp only [AS.nativeAfterAdmission,AS.bornAfterNative,AS.localNativeReceipt,packetTransport,id]
 exact heq_of_eq (generated.trans sourceFeed)

theorem actual_whole_R_step (update:Nat) :
 WholeStep observation nontrivial half (Admissions.packetAt factory initial pR rfl update)
  (Admissions.packetAt factory initial pR rfl (update+1)) := by
 exact (congrArg (fun next=>WholeStep observation nontrivial half
  (Admissions.packetAt factory initial pR rfl update) next)
  (Admissions.packetAt_successor factory initial pR rfl update)).mpr
   (after_native_whole_action observation nontrivial half (Admissions.packetAt factory initial pR rfl update))

def actual_method_step (update:Nat) :=
 PProd.mk (Admissions.actual_index factory initial pR rfl update) <|
 PProd.mk (Admissions.historyAt factory initial pR rfl update)
 (actual_whole_R_step observation nontrivial half depth ordinal update)
end CountedPaInitial.BornRActualMethodAction
