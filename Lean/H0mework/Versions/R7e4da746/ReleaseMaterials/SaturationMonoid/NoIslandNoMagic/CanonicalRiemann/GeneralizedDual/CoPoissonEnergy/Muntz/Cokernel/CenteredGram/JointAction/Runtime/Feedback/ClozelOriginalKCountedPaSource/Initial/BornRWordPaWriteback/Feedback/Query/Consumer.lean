theorem affine_equation
 (fac : ActualCofinalSourceAction.SF.Factory A.W A.X slot)
 (packet : AS.AdmissionPacket (W := A.W) (X := A.X) (s := slot))
 (relation : RelationAt packet) :
 (actionRelation fac packet relation).val = Cfa.sourceWordAction packet relation.val -
  constantMap (R := ℤ) (Value := Lower.Value A.W (packet.1 + 1)) (Var := packet.2.2.1.LowVar)
   (kappa fac packet relation) := by
 simpa only [kappa, environment_source] using actionRelation_equation fac packet relation

