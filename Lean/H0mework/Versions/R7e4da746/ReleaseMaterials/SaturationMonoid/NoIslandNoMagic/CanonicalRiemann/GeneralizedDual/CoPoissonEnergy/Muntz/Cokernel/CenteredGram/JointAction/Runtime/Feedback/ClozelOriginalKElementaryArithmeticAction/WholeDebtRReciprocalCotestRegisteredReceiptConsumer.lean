variable (observation : GeneratedRiemannZeroObservation)
variable (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
variable (half : OriginalKCombCalculation.Half observation) (depth ordinal : Nat)
local notation "c" => OriginalKCombCofinalTwoDirection.coordinate observation nontrivial half
local notation "sample" => fun value : BurnolL2 => burnolAnnulusSamplingL2 value 0
local notation "m" => generatedRiemannXiZeroOrder ActualAnalyticOwner observation.coordinate
local notation "e" => burnolAnalyticComplementExpectedPhysicalFourierRead ActualAnalyticOwner observation

private theorem actual_ordered_source_occurrences :
    (OriginalKReciprocalCotestSourceWriteback.nextFace observation nontrivial half depth ordinal).rootRead.source.occurrences =
      OriginalKReciprocalCotestSourceWriteback.oldAdmissions observation nontrivial half depth ordinal ++
        OriginalKReciprocalCotestSourceWriteback.rrAdmissions observation nontrivial half depth ordinal := by
  simpa only [OriginalKReciprocalCotestSourceWriteback.admissions] using
    W.source_occurrences observation nontrivial half depth ordinal

private theorem actual_field : W.actualValue observation nontrivial half depth = A.weightedField c := by
  rw [W.actualValue, W.bound_code_value]
  exact OriginalKReciprocalCotestSourceCalculation.actual_code_value c _

private def runtimeEffectCotest : BurnolL2 :=
  A.weight c • A.reciprocalCotest c +
    star (A.sourceA c) • W.actualValue observation nontrivial half depth

def runtimePrice : ℂ :=
  inner ℂ (M (fourierL2 (generatedK c)))
    (A.weight c • (sample (A.positionColumn c) + A.reciprocalCotest c)) +
    A.weight c * meanPrice c +
    inner ℂ (defectForcing observation nontrivial half)
      (runtimeEffectCotest observation nontrivial half depth)

private theorem actual_price_source : runtimePrice observation nontrivial half depth =
    OriginalWholeDebtRReciprocalCotestReturnSource.returnPrice observation nontrivial half := by
  unfold runtimePrice runtimeEffectCotest
  rw [actual_field]
  rfl

private theorem actual_R_action : W.actualValue observation nontrivial half depth =
    A.weight c • burnolDirectRightResolventCLM c (A.reciprocalCotest c) := by
  rw [actual_field]
  exact A.weighted_field_action c

private theorem actual_fee :
    star (A.weight c) * inner ℂ (sample (A.fourierColumn c))
      (D (fourierL2 (generatedK c))) =
        inner ℂ (runtimeEffectCotest observation nontrivial half depth)
          (defectForcing observation nontrivial half) := by
  unfold runtimeEffectCotest
  rw [actual_field]
  exact A.actual_defect_fee observation nontrivial half

private theorem actual_wave_return :
    A.weight c * inner ℂ (fourierL2 (generatedK c))
      (Wave.actualValue observation nontrivial half depth) =
        runtimePrice observation nontrivial half depth := by
  rw [actual_price_source, actual_wave_source observation nontrivial half depth]
  exact OriginalWholeDebtRReciprocalCotestReturnSource.actual_weighted_wave observation nontrivial half

private theorem actual_rho_return :
    A.weight c * ((2 * kernelMass c) * inner ℂ (BandFullStockEuler.correctionRaw c)
      (OriginalKCrossParameterRAdjointSource.PhysicalOutsideSource.physicalOutsideColumn c)) =
        runtimePrice observation nontrivial half depth := by
  rw [actual_price_source]
  exact OriginalWholeDebtRReciprocalCotestReturnSource.actual_rho observation nontrivial half

private theorem actual_pa_release :
    (∀ k : Nat, k < m → inner ℂ (sourceEffect c c)
      (CombSource.Division.rawIterate observation half.down k
        (actualPaDelta observation nontrivial half depth ordinal : BurnolL2)) = 0) ∧
    (A.weight c * (2 * kernelMass c)) * inner ℂ (sourceEffect c c)
      (CombSource.Division.rawIterate observation half.down m
        (actualPaDelta observation nontrivial half depth ordinal : BurnolL2)) =
      star (sigma c c) *
        (OriginalKDirectRCofinalDivision.sourceCoefficient observation nontrivial half depth (ordinal+3) -
          OriginalKDirectRCofinalDivision.sourceCoefficient observation nontrivial half depth (ordinal+1)) *
        ((-2 * e) * runtimePrice observation nontrivial half depth) := by
  rw [actual_price_source]
  exact actual_pa_return observation nontrivial half depth ordinal

private noncomputable def Result : Sort _ :=
  Σ' prior : type_of% (OriginalWholeDebtRReciprocalCotestReceiptConsumer.actual_reciprocal_cotest_return
      observation nontrivial half depth ordinal),
    PProd (prior = OriginalWholeDebtRReciprocalCotestReceiptConsumer.actual_reciprocal_cotest_return
      observation nontrivial half depth ordinal) (
  Σ' action : type_of% (W.generatedAction observation nontrivial half depth ordinal),
    PProd (action = W.generatedAction observation nontrivial half depth ordinal)
      ((type_of% (W.actual_compiles observation nontrivial half depth ordinal)) ∧
       (type_of% (W.old_admissions_prefix observation nontrivial half depth ordinal)) ∧
       (type_of% (W.admissions_steps observation nontrivial half depth ordinal)) ∧
       (type_of% (W.admissions_words observation nontrivial half depth ordinal)) ∧
       (type_of% (W.words_sum observation nontrivial half depth ordinal)) ∧
       (type_of% (W.actual_boundary observation nontrivial half depth)) ∧
       (type_of% (W.source_word_split observation nontrivial half depth ordinal)) ∧
       (type_of% (actual_ordered_source_occurrences observation nontrivial half depth ordinal)) ∧
       (type_of% (OriginalKReciprocalCotestSourceOccurrences.actual_positions observation nontrivial half depth ordinal)) ∧
       (type_of% (W.source_effect observation nontrivial half depth ordinal)) ∧
       (type_of% (W.source_inverse observation nontrivial half depth ordinal)) ∧
       (type_of% (W.inverse_certificate observation nontrivial half depth ordinal)) ∧
       (type_of% (W.actual_born_kernel observation nontrivial half depth ordinal)) ∧
       (type_of% (W.whole_next observation nontrivial half depth ordinal)) ∧
       (type_of% (W.canonical_next observation nontrivial half depth ordinal)) ∧
       (type_of% (W.same_ledger observation nontrivial half depth ordinal)) ∧
       (type_of% (W.same_visit observation nontrivial half depth ordinal)) ∧
       (type_of% (W.actual_value_runtime observation nontrivial half depth)) ∧
       (type_of% (actual_R_action observation nontrivial half depth)) ∧
       (type_of% (actual_fee observation nontrivial half depth)) ∧
       (type_of% (actual_wave_return observation nontrivial half depth)) ∧
       (type_of% (actual_rho_return observation nontrivial half depth)) ∧
       (type_of% (actual_pa_release observation nontrivial half depth ordinal))))

/-- The actual registered R result enters the full return with its source word and successor. -/
noncomputable opaque actual_reciprocal_cotest_registered_whole_next :
    Result observation nontrivial half depth ordinal := by
  exact ⟨OriginalWholeDebtRReciprocalCotestReceiptConsumer.actual_reciprocal_cotest_return
      observation nontrivial half depth ordinal, rfl,
    W.generatedAction observation nontrivial half depth ordinal, rfl,
    W.actual_compiles observation nontrivial half depth ordinal,
    W.old_admissions_prefix observation nontrivial half depth ordinal,
    W.admissions_steps observation nontrivial half depth ordinal,
    W.admissions_words observation nontrivial half depth ordinal,
    W.words_sum observation nontrivial half depth ordinal,
    W.actual_boundary observation nontrivial half depth,
    W.source_word_split observation nontrivial half depth ordinal,
    actual_ordered_source_occurrences observation nontrivial half depth ordinal,
    OriginalKReciprocalCotestSourceOccurrences.actual_positions observation nontrivial half depth ordinal,
    W.source_effect observation nontrivial half depth ordinal,
    W.source_inverse observation nontrivial half depth ordinal,
    W.inverse_certificate observation nontrivial half depth ordinal,
    W.actual_born_kernel observation nontrivial half depth ordinal,
    W.whole_next observation nontrivial half depth ordinal,
    W.canonical_next observation nontrivial half depth ordinal,
    W.same_ledger observation nontrivial half depth ordinal,
    W.same_visit observation nontrivial half depth ordinal,
    W.actual_value_runtime observation nontrivial half depth,
    actual_R_action observation nontrivial half depth,
    actual_fee observation nontrivial half depth,
    actual_wave_return observation nontrivial half depth,
    actual_rho_return observation nontrivial half depth,
    actual_pa_release observation nontrivial half depth ordinal⟩

