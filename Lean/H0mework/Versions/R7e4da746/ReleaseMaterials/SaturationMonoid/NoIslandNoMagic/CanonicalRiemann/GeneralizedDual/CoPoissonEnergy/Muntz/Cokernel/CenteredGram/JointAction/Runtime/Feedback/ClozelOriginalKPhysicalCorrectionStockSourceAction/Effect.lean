local notation "P" => burnolEvenAmbientProjection
local notation "Z" => burnolQuarterZeroExtension

def actualPhysicalProjectionStock (value : BurnolL2) (N : ℕ) : BurnolL2 :=
  burnolAmbientEvenPart value - burnolAmbientEvenPart
    (Z (actualFirstCorrectionStock value N : BurnolQuarterIntervalL2) +
      fourierL2 (Z (actualSecondCorrectionStock value N : BurnolQuarterIntervalL2)))

def actualPhysicalCorrectionTail (value : BurnolL2) (N : ℕ) : BurnolL2 :=
  burnolAmbientEvenPart
    (Z (actualFirstCorrectionTail value N : BurnolQuarterIntervalL2) +
      fourierL2 (Z (actualSecondCorrectionTail value N : BurnolQuarterIntervalL2)))

/-- The full physical projection is generated by the finite two-block source action and the same correction tail. -/
theorem actual_physical_projection_stock_complete (value : BurnolL2) (N : ℕ) :
    (P value : BurnolL2) = actualPhysicalProjectionStock value N - actualPhysicalCorrectionTail value N := by
  have source := actual_correction_source_stock_complete value N
  change ((evenBurnolClosedFace (1/4:ℝ)).toSubmodule.orthogonalProjectionOnto value : BurnolL2) = _
  rw [burnolEvenOrthogonalProjectionOnto_eq_resolventFormula]
  unfold burnolAmbientExtendedSonineProjectionFormula burnolAmbientEvenMeanZeroCorrection
    burnolAmbientRawMeanZeroCorrection actualPhysicalProjectionStock actualPhysicalCorrectionTail
  rw [source.1,source.2]
  simp only [Submodule.coe_add,map_add]
  unfold burnolAmbientEvenPart
  simp only [map_add]
  module

theorem actual_physical_projection_stock_closure (value : BurnolL2) :
    Tendsto (actualPhysicalProjectionStock value) atTop (𝓝 (P value : BurnolL2)) := by
  have source := actual_correction_source_stock_closure value
  let extension := OriginalKCvelSourceAction.actualStockExtension
  have first := (extension.continuous.tendsto _).comp source.1
  have second := (extension.continuous.tendsto _).comp source.2
  have secondFT := (fourierL2.continuous.tendsto _).comp second
  have combined := first.add secondFT
  have reflected := (reflectL2.continuous.tendsto _).comp combined
  have both := (combined.add reflected).const_smul (1/2:ℂ)
  change Tendsto (actualPhysicalProjectionStock value) atTop (𝓝 ((evenBurnolClosedFace (1/4:ℝ)).toSubmodule.orthogonalProjectionOnto value : BurnolL2))
  rw [burnolEvenOrthogonalProjectionOnto_eq_resolventFormula]
  exact tendsto_const_nhds.sub both

end NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.CenteredGram.IntegralGraphJointAction.OriginalKPhysicalCorrectionStockSourceAction
