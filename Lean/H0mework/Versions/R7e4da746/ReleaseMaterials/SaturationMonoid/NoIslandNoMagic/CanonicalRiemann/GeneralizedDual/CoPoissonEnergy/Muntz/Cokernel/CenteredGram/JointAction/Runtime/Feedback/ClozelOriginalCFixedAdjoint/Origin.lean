theorem correction_value_source : correctionValue observation nontrivial half depth ordinal t=
    Root.correctionValue observation nontrivial half depth ordinal :=
  congrArg (fun word => physicalValue (AS.bornAfterNative native).1 (decodeMap (remaining raw) correctionPath word))
    (correction_word_source observation nontrivial half depth ordinal t)
noncomputable def correctionTrace : Trace (C.receipt observation nontrivial depth half).1.environment
    (Child.childCode observation nontrivial half depth 1)
    (.const (correctionValue observation nontrivial half depth ordinal t)) :=
  Eq.mp (congrArg (fun point => Trace (C.receipt observation nontrivial depth half).1.environment
    (Child.childCode observation nontrivial half depth 1) (.const point))
      (correction_value_source observation nontrivial half depth ordinal t).symm)
    (Root.correctionTrace observation nontrivial half depth ordinal)
theorem correction_trace_source : type_of% ((mp_heq
    (congrArg (fun point => Trace (C.receipt observation nontrivial depth half).1.environment
      (Child.childCode observation nontrivial half depth 1) (.const point))
        (correction_value_source observation nontrivial half depth ordinal t).symm)
    (Root.correctionTrace observation nontrivial half depth ordinal)).trans
      (Root.correctionTrace_heq observation nontrivial half depth ordinal)) :=
  (mp_heq _ _).trans (Root.correctionTrace_heq observation nontrivial half depth ordinal)
