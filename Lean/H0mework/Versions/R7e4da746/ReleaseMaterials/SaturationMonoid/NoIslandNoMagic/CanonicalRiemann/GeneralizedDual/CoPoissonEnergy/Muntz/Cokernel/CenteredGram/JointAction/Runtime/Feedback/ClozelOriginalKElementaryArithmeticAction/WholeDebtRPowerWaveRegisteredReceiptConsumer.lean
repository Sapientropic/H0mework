       (type_of% (W.actual_born_kernel observation nontrivial half depth ordinal)) ∧
       (type_of% (W.actual_whole_next observation nontrivial half depth ordinal)) ∧
       (type_of% (W.actual_canonical_next observation nontrivial half depth ordinal)) ∧
       (type_of% (W.actual_same_ledger observation nontrivial half depth ordinal)) ∧
       (type_of% (W.actual_same_visit observation nontrivial half depth ordinal)) ∧
       (type_of% (W.actual_value_runtime observation nontrivial half depth)) ∧
       (type_of% (actual_pair observation nontrivial half depth)) ∧
       (type_of% (actual_return observation nontrivial half depth)) ∧
       (type_of% (actual_unit observation nontrivial half depth)) ∧
       (type_of% (actual_pa_release observation nontrivial half depth ordinal))))

