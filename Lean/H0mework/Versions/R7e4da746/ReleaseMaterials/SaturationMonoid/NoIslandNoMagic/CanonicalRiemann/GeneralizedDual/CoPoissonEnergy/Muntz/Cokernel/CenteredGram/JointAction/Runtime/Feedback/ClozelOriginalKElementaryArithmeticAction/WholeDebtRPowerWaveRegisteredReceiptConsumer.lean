private theorem actual_ordered_source_occurrences :
    (OriginalKPowerWaveSourceWriteback.nextFace observation nontrivial half depth ordinal).rootRead.source.occurrences =
      OriginalKPowerWaveSourceWriteback.oldAdmissions observation nontrivial half depth ordinal ++
        OriginalKPowerWaveSourceWriteback.waveAdmissions observation nontrivial half depth ordinal := by
  simpa only [OriginalKPowerWaveSourceWriteback.admissions] using
    W.source_occurrences observation nontrivial half depth ordinal

private theorem actual_wave_source : wave = pairedSource c junctionShift := by
  rw [OriginalKPowerWaveSourceWriteback.actualValue, W.bound_code_value]
  exact OriginalKPowerWaveSourceCalculation.code_eval c junctionShift _

private theorem actual_pair :
    (2 * kernelMass c) • pairedBurnolMultiplicativeDilation junctionShift (powerWave c) =
      ((2 * kernelMass c) * pairedMellinTranslationCharacter (c).value junctionShift) • powerWave c + wave := by
  rw [actual_wave_source]
  exact actual_pair_action c junctionShift

private theorem actual_return :
    (2 * kernelMass c) * inner ℂ (C c) (physicalOutsideColumn c) =
      inner ℂ (fourierL2 (generatedK c)) wave := by
  rw [actual_wave_source]
  exact rho_return c

private theorem actual_unit :
    OriginalWholeDebtRQuarterUnitSettlementSource.sourcePrice c • powerWave c =
      returnRatio c • fourierL2 (C (barC c)) - (damping c : ℂ)⁻¹ • C c -
        O wave - O (sourceField c (barC c)) := by
  rw [actual_wave_source]
  exact actual_price_unit c

private theorem actual_pa_release :
    (∀ k : Nat, k < m → inner ℂ (sourceEffect c c)
      (CombSource.Division.rawIterate observation half.down k
        (actualPaDelta observation nontrivial half depth ordinal : BurnolL2)) = 0) ∧
    (2 * kernelMass c) * inner ℂ (sourceEffect c c)
      (CombSource.Division.rawIterate observation half.down m
        (actualPaDelta observation nontrivial half depth ordinal : BurnolL2)) =
      star (sigma c c) *
        (OriginalKDirectRCofinalDivision.sourceCoefficient observation nontrivial half depth (ordinal + 3) -
          OriginalKDirectRCofinalDivision.sourceCoefficient observation nontrivial half depth (ordinal + 1)) *
        ((-2 * e) * inner ℂ (fourierL2 (generatedK c)) wave) := by
  rw [actual_wave_source]
  exact actual_pa_wave_release observation nontrivial half depth ordinal

