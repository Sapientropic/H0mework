local instance baseGroups : ∀ target, AddCommGroup (A.W target) :=
 BornRCanonicalMethodRuntime.levelGroups 0
local instance levelGroups (grade : Nat) (target : CompletedSourceRCalculation.Slot) :
 AddCommGroup (Lower.Value A.W grade target) := BornRCanonicalMethodRuntime.levelGroups grade target
local notation "slot" => CompletedSourceRCalculation.Slot.branches

/-- The complete relation span of this exact recorded packet. -/
structure RelationAt {X : CompletedSourceRCalculation.Slot → Type}
 (packet : AS.AdmissionPacket (W := A.W) (X := X) (s := slot)) where
 inventory : RootedAccountedUnfolding (PresentedRelationEventAt (Expr (Lower.Value A.W packet.1) X slot))
 installed : packet.2.1.1.inventory = some inventory
 val : Formal ℤ (Lower.Value A.W packet.1) X slot
 member : val ∈ SourceInventoryExecutionFeed.relationSpace inventory

private def castStock {m n : Nat} (same : m = n)
 {X : CompletedSourceRCalculation.Slot → Type}
 (stock : RootedAccountedUnfolding (PresentedRelationEventAt (Expr (Lower.Value A.W m) X slot))) :
 RootedAccountedUnfolding (PresentedRelationEventAt (Expr (Lower.Value A.W n) X slot)) := same ▸ stock
private def castWord {m n : Nat} (same : m = n)
 {X : CompletedSourceRCalculation.Slot → Type}
 (word : Formal ℤ (Lower.Value A.W m) X slot) :
 Formal ℤ (Lower.Value A.W n) X slot := same ▸ word
private theorem castMember {m n : Nat} (same : m = n)
 {X : CompletedSourceRCalculation.Slot → Type}
 (stock : RootedAccountedUnfolding (PresentedRelationEventAt (Expr (Lower.Value A.W m) X slot)))
 (word : Formal ℤ (Lower.Value A.W m) X slot)
 (member : word ∈ SourceInventoryExecutionFeed.relationSpace stock) :
 castWord same word ∈ SourceInventoryExecutionFeed.relationSpace (castStock same stock) := by
 cases same
 exact member
private theorem castWord_heq {m n : Nat} (same : m = n)
 {X : CompletedSourceRCalculation.Slot → Type}
 (word : Formal ℤ (Lower.Value A.W m) X slot) : HEq (castWord same word) word := by
 cases same
 exact HEq.rfl
private theorem bornGrade {X : CompletedSourceRCalculation.Slot → Type}
 (native : AS.AdmissionPacket (W := A.W) (X := X) (s := slot)) :
 (AS.bornAfterNative native).1 = native.1 := rfl
private theorem bornStock_registered
 (native : AS.AdmissionPacket (W := A.W) (X := A.X) (s := slot)) :
 (AS.bornAfterNative native).2.1.1.inventory =
 some (castStock (bornGrade native).symm (AN.bornStock (selected native) native.2.2.1)) := by
 cases bornGrade native
 rfl
private theorem registeredSpan
 {X : CompletedSourceRCalculation.Slot → Type}
 (packet : AS.AdmissionPacket (W := A.W) (X := X) (s := slot))
 (stock : RootedAccountedUnfolding (PresentedRelationEventAt (Expr (Lower.Value A.W packet.1) X slot)))
 (registered : packet.2.1.1.inventory = some stock)
 (word : Formal ℤ (Lower.Value A.W packet.1) X slot)
 (member : word ∈ SourceInventoryExecutionFeed.relationSpace stock) :
 word ∈ Submodule.span ℤ {relation | ∃ prior,
  packet.2.1.1.inventory = some prior ∧ PresentedRelationEventAt.relation relation ∈ prior.trace} := by
 refine (Submodule.span_mono (R := ℤ) ?_) member
 intro relation belongs
 change PresentedRelationEventAt.relation relation ∈ stock.trace at belongs
 exact ⟨stock, registered, belongs⟩

theorem RelationAt.property
 {X : CompletedSourceRCalculation.Slot → Type}
 {packet : AS.AdmissionPacket (W := A.W) (X := X) (s := slot)}
 (relation : RelationAt packet) :
 relation.val ∈ Submodule.span ℤ {word | ∃ prior,
  packet.2.1.1.inventory = some prior ∧ PresentedRelationEventAt.relation word ∈ prior.trace} :=
 registeredSpan packet relation.inventory relation.installed relation.val relation.member

/-- Eliminate the born history while its native packet is still a local variable. -/
noncomputable def nativeRelation
 (native : AS.AdmissionPacket (W := A.W) (X := A.X) (s := slot))
 (relation : (AN.bornHistory (selected native) native.2.2.1).relationClosure) :
 RelationAt (AS.bornAfterNative native) := by
 have member : relation.val ∈ SourceInventoryExecutionFeed.relationSpace
   (AN.bornStock (selected native) native.2.2.1) := by
  simpa only [AN.bornHistory, Feed.history_relation_space] using relation.property
 exact {
  inventory := castStock (bornGrade native).symm (AN.bornStock (selected native) native.2.2.1)
  installed := bornStock_registered native
  val := castWord (bornGrade native).symm relation.val
  member := castMember (bornGrade native).symm _ _ member }

theorem nativeRelation_source
 (native : AS.AdmissionPacket (W := A.W) (X := A.X) (s := slot))
 (relation : (AN.bornHistory (selected native) native.2.2.1).relationClosure) :
 HEq (nativeRelation native relation).val relation.val :=
 castWord_heq (bornGrade native).symm relation.val

variable (observation : GeneratedRiemannZeroObservation)
variable (nontrivial : ¬∃ n : Nat, observation.coordinate = -2 * (n + 1))
variable (half : OriginalKCombCalculation.Half observation) (depth ordinal : Nat)
local notation "factory" => A.fixedRFactory observation nontrivial half

/-- This is the original born packet; its source identity is supplied by actual_born_packet. -/
noncomputable def currentPacket (update cutoff : Nat) :
 AS.AdmissionPacket (W := A.W) (X := A.X) (s := slot) :=
 AS.bornAfterNative (AS.nativeAfterAdmission factory
  (source observation nontrivial half depth ordinal update cutoff))
attribute [irreducible] currentPacket

/-- The already generated original R relation feeds its actual packet's full span. -/
noncomputable def currentRelation (update cutoff : Nat) :
 RelationAt (currentPacket observation nontrivial half depth ordinal update cutoff) := by
 unfold currentPacket
 exact nativeRelation
  (AS.nativeAfterAdmission factory (source observation nontrivial half depth ordinal update cutoff))
  (actualBornRelation observation nontrivial half depth ordinal update cutoff).1

theorem currentRelation_source (update cutoff : Nat) :
 HEq (currentRelation observation nontrivial half depth ordinal update cutoff).val
  (actualGamma observation nontrivial half depth ordinal update cutoff) := by
 unfold currentRelation currentPacket
 exact (nativeRelation_source
  (AS.nativeAfterAdmission factory (source observation nontrivial half depth ordinal update cutoff))
  (actualBornRelation observation nontrivial half depth ordinal update cutoff).1).trans
  (actualBornRelation observation nontrivial half depth ordinal update cutoff).2

/-- The existing source execution creates the full affine relation in its own born stock. -/
noncomputable def actionRelation
 {X : CompletedSourceRCalculation.Slot → Type}
 (fac : ActualCofinalSourceAction.SF.Factory A.W X slot)
 (packet : AS.AdmissionPacket (W := A.W) (X := X) (s := slot))
 (relation : RelationAt packet) :
 (AN.bornHistory (Cfa.selected fac packet) (Cfa.nativePacket fac packet).2.2.1).relationClosure :=
 ActualNativeRelationTransport.normalizeSource
  (Cfa.selected fac packet) (Cfa.nativePacket fac packet).2.2.1
  ⟨Cfa.sourceWordAction packet relation.val,
   Cfa.source_span_before_birth fac packet relation.val relation.property⟩

/-- Full value word is retained; no physical or quotient zero is an input. -/
theorem actionRelation_equation
 {X : CompletedSourceRCalculation.Slot → Type}
 (fac : ActualCofinalSourceAction.SF.Factory A.W X slot)
 (packet : AS.AdmissionPacket (W := A.W) (X := X) (s := slot))
 (relation : RelationAt packet) :
 (actionRelation fac packet relation).val =
 Cfa.sourceWordAction packet relation.val -
  constantMap (R := ℤ) (Value := Lower.Value A.W (packet.1 + 1)) (Var := packet.2.2.1.LowVar)
   (valueMap (R := ℤ) (Value := Lower.Value A.W (packet.1 + 1)) (Var := packet.2.2.1.LowVar)
    (S.nextBorn (Cfa.selected fac packet)
     (AS.stockCfg (Cfa.nativePacket fac packet).2.2.1)).activeEnvironment
    (Cfa.sourceWordAction packet relation.val)) := rfl

/-- The original R relation is actually consumed by the existing source action. -/
noncomputable def currentAction (update cutoff : Nat) :
 (AN.bornHistory
  (Cfa.selected factory (currentPacket observation nontrivial half depth ordinal update cutoff))
  (Cfa.nativePacket factory (currentPacket observation nontrivial half depth ordinal update cutoff)).2.2.1).relationClosure :=
 actionRelation factory (currentPacket observation nontrivial half depth ordinal update cutoff)
  (currentRelation observation nontrivial half depth ordinal update cutoff)

/-- The same receiver/birth owns the acted relation; eliminate its dependent language once. -/
noncomputable def actionNextRelation
 (fac : ActualCofinalSourceAction.SF.Factory A.W A.X slot)
 (packet : AS.AdmissionPacket (W := A.W) (X := A.X) (s := slot))
 (relation : RelationAt packet) :
 RelationAt (AS.bornAfterNative (AS.nativeAfterAdmission fac packet)) := by
 rcases packet with ⟨n, ⟨frame, seed⟩, ⟨Y, datum, scalar, pair⟩, ⟨language⟩⟩
 cases language
 let packet : AS.AdmissionPacket (W := A.W) (X := A.X) (s := slot) :=
  ⟨n, ⟨frame, seed⟩, ⟨A.X, datum, scalar, pair⟩, ⟨rfl⟩⟩
 exact nativeRelation (Cfa.nativePacket fac packet) (actionRelation fac packet relation)

theorem actionNextRelation_source
 (fac : ActualCofinalSourceAction.SF.Factory A.W A.X slot)
 (packet : AS.AdmissionPacket (W := A.W) (X := A.X) (s := slot))
 (relation : RelationAt packet) :
 HEq (actionNextRelation fac packet relation).val (actionRelation fac packet relation).val := by
 rcases packet with ⟨n, ⟨frame, seed⟩, ⟨Y, datum, scalar, pair⟩, ⟨language⟩⟩
 cases language
 let packet : AS.AdmissionPacket (W := A.W) (X := A.X) (s := slot) :=
  ⟨n, ⟨frame, seed⟩, ⟨A.X, datum, scalar, pair⟩, ⟨rfl⟩⟩
 exact nativeRelation_source (Cfa.nativePacket fac packet) (actionRelation fac packet relation)

private noncomputable def transportRelation
 {before after : AS.AdmissionPacket (W := A.W) (X := A.X) (s := slot)}
 (same : before = after) (relation : RelationAt before) : RelationAt after := same ▸ relation
private theorem transportRelation_source
 {before after : AS.AdmissionPacket (W := A.W) (X := A.X) (s := slot)}
 (same : before = after) (relation : RelationAt before) :
 HEq (transportRelation same relation).val relation.val := by
 cases same
 exact HEq.rfl

