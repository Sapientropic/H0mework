private theorem joint_even (c:BurnolCompletedMellinCoordinate):reflectL2 (jointSource c)=jointSource c:=by
  apply burnolReflectL2_eq_of_even_raw _ _ (actual_joint_homogeneous_raw c)
  intro x
  rw [actual_quarter_even,actual_dual_fourier_even,abs_neg]

def directSource (c:BurnolCompletedMellinCoordinate) (j:ℕ):BurnolL2:=
  ((burnolDirectRightResolventCLM (barC c))^j) (T (jointSource c))

def directValue (c:BurnolCompletedMellinCoordinate) (zero:riemannZeta c.value=0)
    (h:ℝ) (positive:0<h) (j:ℕ):BurnolL2:=
  ((burnolDirectRightResolventCLM (barC c))^j) (fourierL2 (jointValue c zero h positive))

def tateSource (c:BurnolCompletedMellinCoordinate) (j:ℕ):BurnolL2:=T (directSource c j)

private theorem tate_even (c:BurnolCompletedMellinCoordinate) (j:ℕ):
    reflectL2 (tateSource c j)=tateSource c j:=by
  have initial:reflectL2 (T (jointSource c))=T (jointSource c):=by
    rw [←burnolTateReciprocal_reflect,joint_even]
  have generated:=actual_iterate_even (barC c) (T (jointSource c)) initial j
  rw [actual_iterate_power] at generated
  rw [tateSource,←burnolTateReciprocal_reflect]
  exact congrArg T generated

/-- The conjugate parameter acts on F Whole+C itself, with the original Xi order available unchanged. -/
theorem actual_direct_realizes (c:BurnolCompletedMellinCoordinate) (zero:riemannZeta c.value=0)
    (h:ℝ) (positive:0<h) (j:ℕ) (test:SchwartzMap ℝ ℂ):
    burnolRemainderSourceRead (directSource c j) test=
      (Lp.toTemperedDistributionCLM ℂ volume 2 (directValue c zero h positive j)) test:=by
  exact realizes_power (barC c) _ _
    (burnolRemainderRealization_fourier _ _ (actual_joint_realizes c zero h positive)) j test

def actualPa (c:BurnolCompletedMellinCoordinate) (j:ℕ):BurnolPaAmbientCarrier:=
  sourceVolterraPhysical (barC c) (tateSource c j)

theorem actual_pa_mem (c:BurnolCompletedMellinCoordinate) (j:ℕ):
    actualPa c j∈burnolCompactCoPoissonClosedRange:=sourceVolterraPhysical_mem _ _

/-- Actual Pa is generated by the original shell integral from this same source, with no membership input. -/
theorem actual_pa_source (c:BurnolCompletedMellinCoordinate) (j:ℕ):
    T (burnolMobiusSourceL2 (actualPa c j))=
      sourceVolterraWindow (barC c) (A (tateSource c j)):=
  sourceVolterraPhysical_source_cut _ _ (tate_even c j)

def residualSource (c:BurnolCompletedMellinCoordinate) (j:ℕ):BurnolL2:=
  sourceVolterraResolvent (barC c) (tateSource c j)-
    sourceVolterraWindow (barC c) (A (tateSource c j))

def residualValue (c:BurnolCompletedMellinCoordinate) (zero:riemannZeta c.value=0)
    (h:ℝ) (positive:0<h) (j:ℕ):BurnolL2:=
  fourierL2 (directValue c zero h positive (j+1))-fourierL2 (actualPa c j:BurnolL2)

/-- The complete leftover source realizes the full actual difference after Pa generation. -/
theorem actual_residual_realizes (c:BurnolCompletedMellinCoordinate) (zero:riemannZeta c.value=0)
    (h:ℝ) (positive:0<h) (j:ℕ) (test:SchwartzMap ℝ ℂ):
    burnolRemainderSourceRead (residualSource c j) test=
      (Lp.toTemperedDistributionCLM ℂ volume 2 (residualValue c zero h positive j)) test:=by
  have next:sourceVolterraResolvent (barC c) (tateSource c j)=T (directSource c (j+1)):=by
    simp only [sourceVolterraResolvent,ContinuousLinearMap.comp_apply,tateSource,
      burnolTateReciprocalL2_involutive,directSource,pow_succ',mul_apply_eq_comp]
  rw [residualSource,next,←actual_pa_source,←burnolRemainderSourceReadCLM_apply,map_sub,
    burnolRemainderSourceReadCLM_apply,burnolRemainderSourceReadCLM_apply,
    burnolRemainderRealization_fourier _ _ (actual_direct_realizes c zero h positive (j+1)) test,
    original_tate_source_realizes _ (actual_pa_mem c j) test,residualValue,map_sub]
  rfl

private theorem tail_difference (d:BurnolCompletedMellinCoordinate) (value:BurnolL2)
    (x:ℝ) (inside:x∈Ioo q 4):
    burnolRadiusMellinTailEvaluator x (by linarith [inside.1]) d.value d.rightHalf (value-A value)=
      burnolRadiusMellinTailEvaluator 4 (by norm_num) d.value d.rightHalf value:=by
  rw [burnolRadiusMellinTailEvaluator_eq_integral,burnolRadiusMellinTailEvaluator_eq_integral,
    ←integral_indicator measurableSet_Ioi,←integral_indicator measurableSet_Ioi]
  apply integral_congr_ae
  filter_upwards [Lp.coeFn_sub value (A value),sourceAnnulusCut_coeFn value] with u subtraction cut
  by_cases after:4<u
  · have before:x<u:=lt_trans inside.2 after
    rw [indicator_of_mem (show u∈Ioi x from before),indicator_of_mem (show u∈Ioi (4:ℝ) from after),subtraction,Pi.sub_apply,cut,
      if_neg (by rw [abs_of_pos (by linarith:0<u)];exact fun h=>not_le.mpr after h.2),sub_zero]
  · rw [indicator_of_notMem (show u∉Ioi (4:ℝ) from after)]
    by_cases before:x<u
    · have band:q < |u| ∧ |u|≤4:=by rw [abs_of_pos (by linarith [inside.1]:0<u)];exact ⟨lt_trans inside.1 before,le_of_not_gt after⟩
      rw [indicator_of_mem (show u∈Ioi x from before),subtraction,Pi.sub_apply,cut,if_pos band,sub_self,mul_zero]
    · rw [indicator_of_notMem (show u∉Ioi x from before)]

/-- Inside the original annulus the entire unconsumed source is one actual upper-tail coefficient. -/
theorem actual_residual_source_profile (c:BurnolCompletedMellinCoordinate) (j:ℕ):
    ∀ᵐx:ℝ∂volume,∀_positive:0<x,
      residualSource c j x=if q<x∧x≤4 then
        (-2:ℂ)*(x:ℂ)^((barC c).value-1)*
          burnolRadiusMellinTailEvaluator 4 (by norm_num) (barC c).value (barC c).rightHalf (tateSource c j)
        else sourceVolterraResolvent (barC c) (tateSource c j) x:=by
  filter_upwards [Lp.coeFn_sub (sourceVolterraResolvent (barC c) (tateSource c j))
      (sourceVolterraWindow (barC c) (A (tateSource c j))),
    sourceAnnulusCut_coeFn (sourceVolterraResolvent (barC c) (A (tateSource c j))),
    sourceVolterraResolvent_positive_profile (barC c) (tateSource c j),
    sourceVolterraResolvent_positive_profile (barC c) (A (tateSource c j)),
    volume.ae_ne (4:ℝ)] with x subtraction cut full finite notEndpoint positive
  change (sourceVolterraResolvent (barC c) (tateSource c j)-
    sourceVolterraWindow (barC c) (A (tateSource c j))) x=_
  rw [subtraction,Pi.sub_apply]
  change sourceVolterraResolvent (barC c) (tateSource c j) x-
    sourceAnnulusCut (sourceVolterraResolvent (barC c) (A (tateSource c j))) x=_
  rw [cut,abs_of_pos positive]
  by_cases band:q<x∧x≤4
  · rw [if_pos band,if_pos band,full positive,finite positive]
    have tail:=tail_difference (barC c) (tateSource c j) x
      ⟨band.1,lt_of_le_of_ne band.2 notEndpoint⟩
    rw [map_sub] at tail
    linear_combination (-2*(x:ℂ)^((barC c).value-1))*tail
  · rw [if_neg band,if_neg band,sub_zero]

/-- The original zero-owned K independently consumes the generated Pa state and retains the complete residue. -/
theorem actual_original_K_consumer (c:BurnolCompletedMellinCoordinate) (zero:riemannZeta c.value=0)
    (h:ℝ) (positive:0<h) (j:ℕ):
    inner ℂ (burnolCompletedMellinRieszVector c:BurnolL2) (directValue c zero h positive (j+1))=
      inner ℂ (fourierL2 (burnolCompletedMellinRieszVector c:BurnolL2))
        (residualValue c zero h positive j):=by
  have orthogonal:=riemannZeta_zero_burnolCompletedMellinRieszVector_mem_Pa_orthogonal c zero
  have paid:inner ℂ (burnolCompletedMellinRieszVector c:BurnolL2) (actualPa c j:BurnolL2)=0:=by
    exact inner_eq_zero_symm.mpr ((Submodule.mem_orthogonal _ _).mp orthogonal _ (actual_pa_mem c j))
  rw [residualValue,inner_sub_right,fourierL2.inner_map_map,fourierL2.inner_map_map,paid,sub_zero]

