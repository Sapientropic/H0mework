def actualGammaSeed : BurnolL2 := logSeedSynthesis C+F (kGammaFourierPaid% seedFourierLog)

def actualGammaKernel (c : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  originalBaseSynthesis c actualGammaSeed-F (originalBSynthesis c actualGammaSeed)

private theorem gamma_pair_fourier (v gamma : BurnolL2) (source : GammaPair v gamma) :
    GammaPair (F v) (F gamma) := by
  intro test
  have inverseGamma : wholeConductorTest (𝓕⁻ test)=fourierL2.symm (wholeConductorTest test) := by
    apply fourierL2.injective
    rw [← original_whole_Gamma_fourier_source,FourierTransform.fourier_fourierInv_eq,
      LinearIsometryEquiv.apply_symm_apply]
  have inverseTest : (𝓕⁻ test).toLp 2 volume=fourierL2.symm (test.toLp 2 volume) := by
    apply fourierL2.injective
    rw [LinearIsometryEquiv.apply_symm_apply]
    change 𝓕 ((𝓕⁻ test).toLp 2 volume)=test.toLp 2 volume
    rw [SchwartzMap.toLp_fourier_eq,FourierTransform.fourier_fourierInv_eq]
  have left := fourierL2.inner_map_map (fourierL2.symm (wholeConductorTest test)) v
  rw [LinearIsometryEquiv.apply_symm_apply] at left
  rw [left,← inverseGamma,source,inverseTest]
  have right := fourierL2.inner_map_map (fourierL2.symm (test.toLp 2 volume)) gamma
  rw [LinearIsometryEquiv.apply_symm_apply] at right
  exact right.symm

theorem actual_gamma_seed_source : GammaPair C actualGammaSeed := by
  have frequency := kGammaFourierPaid% seed_fourier_log_pair
  have inverseSeed : fourierL2.symm C=F C := by
    rw [fourierL2_symm_eq_reflect_fourierL2,← fourierL2_reflectL2_commute,
      tailGammaPaid% seed_even]
  rw [← inverseSeed] at frequency
  exact gamma_pair_of_log_pairs C (logSeedSynthesis C) (kGammaFourierPaid% seedFourierLog)
    (kGammaSeedPaid% seed_log_domain) frequency

theorem actual_gamma_original_kernel (c : BurnolCompletedMellinCoordinate) :
    GammaPair (K c:BurnolL2) (actualGammaKernel c) := by
  have base := (phiGammaPaid% gamma_pair_base) c C actualGammaSeed actual_gamma_seed_source
  have b := gamma_pair_fourier _ _
    ((phiGammaPaid% gamma_pair_b) c C actualGammaSeed actual_gamma_seed_source)
  intro test
  rw [forwardFirstPaid% original_K_synthesis,inner_sub_right,base test,b test,
    actualGammaKernel,inner_sub_right]

def actualKernelPositionLog (c : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  (kGammaDualPaid% basePositionLog) c C (logSeedSynthesis C)-
    (kGammaDualPaid% bFrequencyLog) c C (kGammaFourierPaid% seedFourierLog)

def actualKernelFrequencyLog (c : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  fourierL2.symm (actualGammaKernel c-actualKernelPositionLog c)

private theorem actual_kernel_position_log (c : BurnolCompletedMellinCoordinate) :
    LogPair (K c:BurnolL2) (actualKernelPositionLog c) := by
  have base := (kGammaDualPaid% base_position_log_source) c C (logSeedSynthesis C)
    (kGammaSeedPaid% seed_log_domain)
  have inverseSeed : fourierL2.symm C=F C := by
    rw [fourierL2_symm_eq_reflect_fourierL2,← fourierL2_reflectL2_commute,
      tailGammaPaid% seed_even]
  have seedFrequency := kGammaFourierPaid% seed_fourier_log_pair
  rw [← inverseSeed] at seedFrequency
  have b := (kGammaDualPaid% b_frequency_log_source) c C
    (kGammaFourierPaid% seedFourierLog) seedFrequency
  have evenB : reflectL2 (originalBSynthesis c C)=originalBSynthesis c C := by
    change reflectL2.toContinuousLinearMap (originalBSynthesis c C)=_
    rw [(forwardFirstPaid% b_commute) c reflectL2.toContinuousLinearMap reflectL2_burnolMultiplicativeDilation]
    change originalBSynthesis c (reflectL2 C)=_
    rw [tailGammaPaid% seed_even]
  have inverseB : fourierL2.symm (originalBSynthesis c C)=F (originalBSynthesis c C) := by
    rw [fourierL2_symm_eq_reflect_fourierL2,← fourierL2_reflectL2_commute,evenB]
  rw [inverseB] at b
  rw [forwardFirstPaid% original_K_synthesis]
  exact (dualFourierPaid% logPair_sub) _ _ _ _ base b

theorem actual_kernel_complete_log_sources (c : BurnolCompletedMellinCoordinate) :
    LogPair (K c:BurnolL2) (actualKernelPositionLog c) ∧
      LogPair (fourierL2.symm (K c:BurnolL2)) (actualKernelFrequencyLog c) := by
  refine ⟨actual_kernel_position_log c,?_⟩
  apply kGammaDualPaid% log_pair_of_weak
  intro test
  have gamma := actual_gamma_original_kernel c (𝓕 test)
  have position := (dualStrongPaid% log_pair_pairing) _ _ _ _
    (original_log_schwartz_domain (𝓕 test)) (actual_kernel_position_log c)
  rw [wholeConductorTest,inner_add_left,position,
    FourierTransform.fourierInv_fourier_eq] at gamma
  rw [← SchwartzMap.toLp_fourier_eq] at gamma
  change inner ℂ (F (test.toLp 2 volume)) (actualKernelPositionLog c)+
    inner ℂ (F (logSchwartzL2 test)) (K c:BurnolL2)=
    inner ℂ (F (test.toLp 2 volume)) (actualGammaKernel c) at gamma
  rw [fourierL2.inner_map_eq_flip,fourierL2.inner_map_eq_flip,fourierL2.inner_map_eq_flip] at gamma
  rw [actualKernelFrequencyLog,map_sub,inner_sub_right]
  linear_combination gamma

