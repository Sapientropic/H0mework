def firstTateConductorValue : BurnolL2 := fourierL2.symm firstConductorValue

theorem original_first_tate_conductor (test : SchwartzMap ℝ ℂ) :
    inner ℂ (OriginalGamma.Source.JointLogConductor.wholeConductorTest test)
        (burnolTateReciprocalL2 ConstantDual.value) =
      inner ℂ (test.toLp 2 volume) firstTateConductorValue := by
  have source := (firstReadbackPaid% gamma_pair_inverse_fourier) ConstantForward.value firstConductorValue
    original_first_whole_conductor
  rw [original_first_joint, joint_apply, fourierL2.symm_apply_apply] at source
  exact source test

