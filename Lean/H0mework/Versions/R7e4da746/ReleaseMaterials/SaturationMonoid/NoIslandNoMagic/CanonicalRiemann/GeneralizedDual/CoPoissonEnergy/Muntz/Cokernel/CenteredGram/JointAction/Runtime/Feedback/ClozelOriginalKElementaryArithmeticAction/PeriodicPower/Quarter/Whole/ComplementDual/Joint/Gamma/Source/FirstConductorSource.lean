private theorem seed_log_domain : LogPair ConstantDual.seed (logSeedSynthesis ConstantDual.seed) := by
  have source := firstSeedPaid% compact_log_domain
  rw [firstSeedPaid% log_seed_source] at source
  exact source

private theorem log_seed_dilation (h : ℝ) (value : BurnolL2) :
    logSeedSynthesis (burnolMultiplicativeDilation h value) =
      burnolMultiplicativeDilation h (logSeedSynthesis value) := by
  rw [firstSeedPaid% log_seed_synthesis_apply, firstSeedPaid% log_seed_synthesis_apply,
    map_sub, map_smul]
  congr 1
  have covariance (time : ℝ) (v : BurnolL2) :
      burnolMultiplicativeDilation h (burnolMultiplicativeDilation time v) =
        burnolMultiplicativeDilation time (burnolMultiplicativeDilation h v) := by
    rw [burnolMultiplicativeDilation_add, burnolMultiplicativeDilation_add, add_comm]
  exact ((firstSeedPaid% radial_commute)
    (burnolMultiplicativeDilation h).toContinuousLinearEquiv.toContinuousLinearMap covariance
    (Ioc 0 q) measurableSet_Ioc Ioc_subset_Ioi_self (fun t : ℝ => (t : ℂ)⁻¹)
    (by fun_prop) (firstSeedPaid% inv_weighted) value).symm

private theorem log_seed_count (direction : ℝ) (N : ℕ) (value : BurnolL2) :
    logSeedSynthesis (countProgramme direction N value) = countProgramme direction N (logSeedSynthesis value) := by
  have channel (t : ℝ) : logSeedSynthesis (ContinuousChannels.channel direction t value) =
      ContinuousChannels.channel direction t (logSeedSynthesis value) := by
    simp only [ContinuousChannels.channel, map_smul, log_seed_dilation]
  unfold countProgramme
  rw [map_sub, map_sum]
  simp_rw [channel]
  congr 1
  rw [← logSeedSynthesis.integral_comp_comm (ContinuousChannels.channel_integrable direction N value)]
  apply integral_congr_ae
  exact Eventually.of_forall channel

private theorem finite_first_log_domain (direction : ℝ) (N : ℕ) :
    LogPair (countProgramme direction N ConstantDual.seed)
      (logSeedSynthesis (countProgramme direction N ConstantDual.seed) -
        (direction : ℂ) • logProgramme direction N ConstantDual.seed) := by
  have source := original_finite_log_domain direction N ConstantDual.seed
    (logSeedSynthesis ConstantDual.seed) seed_log_domain
  rw [← log_seed_count] at source
  exact source

def dualFirstLog : BurnolL2 := logSeedSynthesis ConstantDual.value - d
def forwardFirstLog : BurnolL2 := logSeedSynthesis ConstantForward.value + a
def firstConductorValue : BurnolL2 := a + joint d

theorem original_dual_first_log : LogPair ConstantDual.value dualFirstLog := by
  have field := ConstantDual.original_tendsto
  have logged := OriginalGamma.Source.WholePrimeLog.original_log_step_tendsto
  have source := (((logSeedSynthesis.continuous.tendsto ConstantDual.value).comp field).sub logged)
  apply logPair_of_tendsto _ _ _ _ field source
  intro N
  simpa only [original_reverse_source, ← CountingDual.dual_eq_adjoint, ofReal_one, one_smul,
    LogD, logCountingCLM_apply, Function.comp_def] using finite_first_log_domain 1 N

theorem original_forward_first_log : LogPair ConstantForward.value forwardFirstLog := by
  have field := ConstantForward.original_tendsto
  have logged := OriginalGamma.Source.ForwardLogStep.original_log_step_tendsto
  have source := (((logSeedSynthesis.continuous.tendsto ConstantForward.value).comp field).add logged)
  apply logPair_of_tendsto _ _ _ _ field source
  intro N
  simpa only [original_forward_source, ofReal_neg, ofReal_one, neg_one_smul, sub_neg_eq_add,
    LogA, logCountingCLM_apply, CountingDual.sourceCLM_apply, Function.comp_def] using finite_first_log_domain (-1) N

private theorem original_dual_even : reflectL2 ConstantDual.value = ConstantDual.value := by
  have pulled := negMeasurePreserving.quasiMeasurePreserving.ae ConstantDual.value_coeFn
  apply Lp.ext
  filter_upwards [Lp.coeFn_compMeasurePreserving ConstantDual.value negMeasurePreserving,
    pulled, ConstantDual.value_coeFn] with x reflected negative positive
  change reflectL2 ConstantDual.value x = ConstantDual.value (-x) at reflected
  rw [reflected, negative, positive]
  simp only [ConstantDual.sawtoothRaw, abs_neg]

theorem original_first_joint : ConstantForward.value = joint ConstantDual.value := by
  apply fourierL2.injective
  rw [ConstantFourier.original_square, joint_apply, fourierL2_fourierL2,
    ← burnolTateReciprocal_reflect, original_dual_even]

theorem original_first_conductor_value :
    forwardFirstLog - joint dualFirstLog = firstConductorValue := by
  unfold forwardFirstLog dualFirstLog firstConductorValue
  rw [original_first_joint, firstSeedPaid% log_seed_synthesis_joint, map_sub]
  module

theorem original_first_whole_conductor (test : SchwartzMap ℝ ℂ) :
    inner ℂ (OriginalGamma.Source.JointLogConductor.wholeConductorTest test) ConstantForward.value =
      inner ℂ (test.toLp 2 volume) firstConductorValue := by
  rw [original_first_joint]
  rw [← OriginalGamma.Source.JointLogConductor.original_whole_joint_log_conductor]
  unfold OriginalGamma.Source.JointLogConductor.weakJointLogRead
  rw [← original_first_joint,
    (firstSeedPaid% log_pair_pairing) _ _ _ _ (original_log_schwartz_domain test) original_forward_first_log,
    (firstSeedPaid% log_pair_pairing) _ _ _ _
      (OriginalGamma.Source.JointLogConductor.original_joint_adjoint_log_domain test) original_dual_first_log,
    OriginalGamma.Source.JointLogConductor.original_joint_adjoint_pairing,
    ← inner_sub_right, original_first_conductor_value]

