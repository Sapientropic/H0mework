def actualDPositionLog (c : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  (ordinaryDPaid% bPositionLog) c ConstantDual.value dualFirstLog

def actualDFrequencyLog (c : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  (ordinaryDPaid% bFrequencyLog) c ConstantDual.value (ordinaryDPaid% firstFourierLog)

/-- Ordinary D pays both actual log domains through the same original b/constant-count synthesis. -/
theorem actual_original_D_full_log_sources (c : BurnolCompletedMellinCoordinate) :
    LogPair (CountingDual.value c) (actualDPositionLog c) ∧
      LogPair (fourierL2.symm (CountingDual.value c)) (actualDFrequencyLog c) := by
  have position:=(ordinaryDPaid% b_position_log_source) c ConstantDual.value dualFirstLog original_dual_first_log
  have frequency:=(ordinaryDPaid% b_frequency_log_source) c ConstantDual.value
    (ordinaryDPaid% firstFourierLog) (ordinaryDPaid% original_first_fourier_log)
  rw [(ordinaryDWholePaid% original_b_first) c] at position frequency
  exact ⟨position,frequency⟩

def actualDGamma (c : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  actualDPositionLog c+F (actualDFrequencyLog c)

private theorem actual_D_gamma_same_native_seed (c : BurnolCompletedMellinCoordinate) :
    actualDGamma c=originalBSynthesis c
      (OriginalGamma.Source.WholePrimeLog.logStepValue+
        T (F OriginalGamma.Source.ForwardLogStep.logStepValue)) := by
  have source:=(phiGammaPaid% gamma_pair_b) c ConstantDual.value
    (OriginalGamma.Source.WholePrimeLog.logStepValue+T (F OriginalGamma.Source.ForwardLogStep.logStepValue))
    OriginalGamma.Source.TateConductor.original_dual_first_conductor
  rw [(ordinaryDWholePaid% original_b_first) c] at source
  exact (gamma_value_of_log_pairs _ _ _ _ source
    (actual_original_D_full_log_sources c).1 (actual_original_D_full_log_sources c).2).symm

end
