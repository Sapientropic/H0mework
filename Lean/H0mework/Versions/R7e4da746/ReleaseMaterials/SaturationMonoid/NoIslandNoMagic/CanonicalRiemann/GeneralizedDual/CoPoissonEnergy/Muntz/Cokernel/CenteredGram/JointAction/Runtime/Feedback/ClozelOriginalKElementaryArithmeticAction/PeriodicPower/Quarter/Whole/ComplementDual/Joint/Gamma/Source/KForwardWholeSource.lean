macro "forwardFirstPaid% " field:ident : term => do
  let owner := Lean.Name.num `_private.H0mework.Versions.R7e4da746.ReleaseMaterials.SaturationMonoid.NoIslandNoMagic.CanonicalRiemann.GeneralizedDual.CoPoissonEnergy.Muntz.Cokernel.CenteredGram.JointAction.Runtime.Feedback.ClozelOriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.ComplementDual.Joint.Gamma.Source.FirstStateSynthesis 0
  let scope := `SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot.NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.BurnolPhysicalState.OriginalGamma.Source.FirstStateSynthesis
  return Lean.mkIdent (owner.append (scope.append field.getId))

theorem original_forward_K_finite_source (c : BurnolCompletedMellinCoordinate) (N : ℕ) :
    CountingDual.sourceCLM N (burnolCompletedMellinRieszVector c : BurnolL2) =
      originalBaseSynthesis c (CountingDual.sourceCLM N ConstantDual.seed) -
        fourierL2 (originalBSynthesis c (DualSource.source N ConstantDual.seed)) := by
  have base := (forwardFirstPaid% base_commute) c (CountingDual.sourceCLM N)
    (fun h v => SeedCounting.source_dilation N h v) ConstantDual.seed
  have b : DualSource.source N (originalBSynthesis c ConstantDual.seed) =
      originalBSynthesis c (DualSource.source N ConstantDual.seed) := by
    simpa only [← CountingDual.dual_eq_adjoint] using
      (forwardFirstPaid% b_commute) c (CountingDual.sourceCLM N).adjoint (fun h v => by
        simpa only [← CountingDual.dual_eq_adjoint] using dual_dilation N h v) ConstantDual.seed
  rw [(forwardFirstPaid% original_K_synthesis) c, map_sub, source_fourier, base, b]

theorem original_forward_K_whole_source (c : BurnolCompletedMellinCoordinate)
    (zero : riemannZeta c.value = 0) :
    Tendsto (fun N : ℕ => CountingDual.sourceCLM N (burnolCompletedMellinRieszVector c : BurnolL2)) atTop
      (𝓝 (fourierL2 (originalDualField c zero))) := by
  have forward : Tendsto (fun N : ℕ => CountingDual.sourceCLM N ConstantDual.seed) atTop
      (𝓝 ConstantForward.value) := by
    simpa only [CountingDual.sourceCLM_apply] using ConstantForward.original_tendsto
  have base := ((originalBaseSynthesis c).continuous.tendsto ConstantForward.value).comp forward
  have b := (fourierL2.continuous.tendsto (originalBSynthesis c ConstantDual.value)).comp
    (((originalBSynthesis c).continuous.tendsto ConstantDual.value).comp ConstantDual.original_tendsto)
  have source := (base.sub b).congr' (Eventually.of_forall (fun N => (original_forward_K_finite_source c N).symm))
  have value : originalBaseSynthesis c ConstantForward.value - fourierL2 (originalBSynthesis c ConstantDual.value) =
      fourierL2 (originalDualField c zero) := by
    rw [OriginalGamma.Source.FirstStateSynthesis.original_dual_synthesis c zero, map_sub]
    have joint := OriginalGamma.Source.QuadraticDivisorReadback.original_base_joint c ConstantDual.value
    rw [← OriginalGamma.Source.DivisorJoint.original_forward_joint] at joint
    change originalBaseSynthesis c ConstantForward.value =
      fourierL2 (burnolTateReciprocalL2 (originalBaseSynthesis c ConstantDual.value)) at joint
    rw [joint]
  rw [value] at source
  exact source

private theorem actual_dual_even (c : BurnolCompletedMellinCoordinate)
    (zero : riemannZeta c.value = 0) : reflectL2 (originalDualField c zero) = originalDualField c zero := by
  have position := burnolReflectL2_eq_of_even_raw (PositionCounting.value c zero) _
    (PositionCounting.value_coeFn c zero) (fun x => by
      simp only [PositionCounting.eventRaw, DualSourceRaw.channels, abs_neg])
  have b := burnolReflectL2_eq_of_even_raw (CountingDual.value c) _
    (DualLanding.original_coeFn c) (fun x => by
      simp only [DualSourceRaw.eventRaw, DualSourceRaw.channels, abs_neg])
  unfold originalDualField originalFirstField
  rw [← burnolTateReciprocal_reflect, map_sub, map_neg, ← burnolTateReciprocal_reflect, position, b]

end
