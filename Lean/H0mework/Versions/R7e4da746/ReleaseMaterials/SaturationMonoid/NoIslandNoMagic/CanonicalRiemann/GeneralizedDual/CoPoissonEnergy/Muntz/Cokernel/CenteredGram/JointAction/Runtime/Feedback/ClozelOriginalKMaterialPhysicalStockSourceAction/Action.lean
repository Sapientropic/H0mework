def physicalStockCode (N : ℕ) : Expr (PairValue (PairValue C.Value)) C.Var () :=
  .linear (s := ()) (t := ()) (sourceMaterialPhysicalStockAction N).toLinearMap.toAddMonoidHom (.var ())

def physicalTailCode (N : ℕ) : Expr (PairValue (PairValue C.Value)) C.Var () :=
  .linear (s := ()) (t := ()) (sourceMaterialPhysicalTailAction N).toLinearMap.toAddMonoidHom (.var ())

def physicalProjectionCode : Expr (PairValue (PairValue C.Value)) C.Var () :=
  .linear (s := ()) (t := ()) sourceMaterialPhysicalProjection.toLinearMap.toAddMonoidHom (.var ())

theorem physical_stock_source_code_read (environment : Env (PairValue (PairValue C.Value)) C.Var) (N : ℕ) :
    (physicalStockCode N).eval environment = sourceMaterialPhysicalStockAction N (environment () ()) := rfl

theorem physical_tail_source_code_read (environment : Env (PairValue (PairValue C.Value)) C.Var) (N : ℕ) :
    (physicalTailCode N).eval environment = sourceMaterialPhysicalTailAction N (environment () ()) := rfl

/-- Expr effects are generated by the actual material increment; a precomputed target price is never the source code. -/
theorem physical_stock_source_code_effect (environment increment : Env (PairValue (PairValue C.Value)) C.Var) (N : ℕ) :
    (physicalStockCode N).effect environment increment = sourceMaterialPhysicalStockAction N (increment () ()) := by
  have generated := Expr.eval_update (physicalStockCode N) environment increment
  rw [physical_stock_source_code_read,physical_stock_source_code_read] at generated
  change sourceMaterialPhysicalStockAction N (environment () ()+increment () ()) = _ at generated
  rw [map_add] at generated
  exact add_left_cancel generated.symm

theorem physical_tail_source_code_effect (environment increment : Env (PairValue (PairValue C.Value)) C.Var) (N : ℕ) :
    (physicalTailCode N).effect environment increment = sourceMaterialPhysicalTailAction N (increment () ()) := by
  have generated := Expr.eval_update (physicalTailCode N) environment increment
  rw [physical_tail_source_code_read,physical_tail_source_code_read] at generated
  change sourceMaterialPhysicalTailAction N (environment () ()+increment () ()) = _ at generated
  rw [map_add] at generated
  exact add_left_cancel generated.symm

/-- Both complete material programmes are generated from this source slot before a scalar cotest. -/
theorem physical_source_code_complete (environment : Env (PairValue (PairValue C.Value)) C.Var) (N : ℕ) :
    physicalProjectionCode.eval environment = (physicalStockCode N).eval environment - (physicalTailCode N).eval environment :=
  source_material_physical_stock_complete (environment () ()) N

