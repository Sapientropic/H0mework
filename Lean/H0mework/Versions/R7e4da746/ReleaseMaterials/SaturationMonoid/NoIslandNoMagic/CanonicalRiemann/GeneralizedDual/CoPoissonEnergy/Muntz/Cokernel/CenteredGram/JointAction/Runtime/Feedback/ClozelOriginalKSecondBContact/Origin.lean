def pairCode (first second:BurnolL2) : Expr C.Value C.Var () :=
  .add (.const first)
    (.linear (s := ()) fourierL2.toContinuousLinearEquiv.toContinuousLinearMap.toLinearMap.toAddMonoidHom
      (.const second))
variable (first second:BurnolL2) {env:Env C.Value C.Var} {total:BurnolL2}
variable (actual:Trace env (pairCode first second) (.const total))
noncomputable def pair := Trace.splitAdd actual
noncomputable def fourier := Trace.splitLinear (pair first second actual).rightTrace
noncomputable def firstReceipt : Trace.SourceReceipt actual (.const first) :=
  ⟨(pair first second actual).leftValue,(pair first second actual).leftTrace,
    .left (pair first second actual) (.refl _)⟩
noncomputable def secondReceipt : Trace.SourceReceipt actual (.const second) :=
  ⟨(fourier first second actual).input,(fourier first second actual).trace,
    .right (pair first second actual) (.linear (fourier first second actual) (.refl _))⟩
theorem first_source : (firstReceipt first second actual).value=first :=
  (firstReceipt first second actual).trace.sound.symm
theorem second_source : (secondReceipt first second actual).value=second :=
  (secondReceipt first second actual).trace.sound.symm
theorem first_address : (firstReceipt first second actual).retained.address=[0] := rfl
theorem second_address : (secondReceipt first second actual).retained.address=[1,2] := rfl
theorem complete_equation : total=(firstReceipt first second actual).value+
    fourierL2 (secondReceipt first second actual).value := by
  rw [first_source,second_source]
  exact actual.sound.symm
end Traced
