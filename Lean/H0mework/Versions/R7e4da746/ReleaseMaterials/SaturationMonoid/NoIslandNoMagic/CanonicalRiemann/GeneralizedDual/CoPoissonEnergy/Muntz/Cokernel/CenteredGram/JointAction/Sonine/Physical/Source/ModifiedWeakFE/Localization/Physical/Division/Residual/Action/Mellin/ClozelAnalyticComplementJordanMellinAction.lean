import H0mework.Versions.R7e4da746.ReleaseMaterials.SaturationMonoid.NoIslandNoMagic.CanonicalRiemann.GeneralizedDual.CoPoissonEnergy.Muntz.Cokernel.CenteredGram.JointAction.Sonine.Physical.Source.ModifiedWeakFE.Localization.Physical.Division.Residual.Action.ClozelAnalyticComplementExactOrderPaJordanAction

/-!
# Mellin character generated by the exact-order source action

The same zero annihilates every preterminal Fourier read.  Applying the
continuous completed-Mellin read to the actual residual Jordan chain therefore
removes every lower-order term and leaves its generated nonzero terminal read.
The resulting character law concerns the evolved source representative.
-/

set_option autoImplicit false
set_option maxHeartbeats 800000

namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace NoIslandNoMagic.CanonicalRiemann

open Complex MeasureTheory Set
open SourceGeneratedComplexFeaturePerfectification SourceGeneratedHilbertCokernel
open ClozelGeneralizedDual ClozelGeneralizedDual.BurnolPhysicalState
open scoped InnerProductSpace

noncomputable section

local instance jordanMellinAmbientComplete : CompleteSpace BurnolPaAmbientCarrier := by
  apply IsComplete.completeSpace_coe
  exact (evenBurnolClosedFace burnolUnscaledCommonGapRadius).isClosed.isComplete

local instance (priority := 10000) jordanMellinResidualRealModule :
    Module ℝ BurnolPaResidual := Module.restrictScalars ℝ ℂ BurnolPaResidual
local instance (priority := 10000) jordanMellinResidualRealNormedSpace :
    NormedSpace ℝ BurnolPaResidual := NormedSpace.restrictScalars ℝ ℂ BurnolPaResidual
local instance jordanMellinResidualComplete : CompleteSpace BurnolPaResidual := by
  apply IsComplete.completeSpace_coe
  exact burnolPaOrthogonalClosedFace.isClosed.isComplete

private theorem jordanMellinRead_intervalIntegral (L : BurnolPaResidual →L[ℂ] ℂ)
    (f : ℝ → BurnolPaResidual) (shift : ℝ)
    (integrable : IntervalIntegrable f volume 0 shift) :
    (∫ base : ℝ in (0 : ℝ)..shift, L (f base)) =
      L (∫ base : ℝ in (0 : ℝ)..shift, f base) := by
  exact @ContinuousLinearMap.intervalIntegral_comp_comm ℂ BurnolPaResidual ℂ
    inferInstance jordanMellinResidualRealNormedSpace 0 shift volume f
    inferInstance inferInstance inferInstance inferInstance inferInstance inferInstance
    jordanMellinResidualComplete L integrable

theorem burnolCompletedMellinEvaluator_residual
    (coordinate : BurnolCompletedMellinCoordinate)
    (zero : riemannZeta coordinate.value = 0) (value : BurnolPaAmbientCarrier) :
    burnolCompletedMellinEvaluator coordinate
        (residual burnolCompactCoPoissonLanding value : BurnolPaAmbientCarrier) =
      burnolCompletedMellinEvaluator coordinate value := by
  let riesz := burnolZeroPaRieszState coordinate zero
  have projectionRead := burnolPaOrthogonalClosedFace.toSubmodule
    |>.inner_orthogonalProjectionOnto_eq_of_mem_left riesz value
  change inner ℂ (riesz : BurnolL2)
      (residual burnolCompactCoPoissonLanding value : BurnolL2) =
    inner ℂ (riesz : BurnolL2) (value : BurnolL2) at projectionRead
  simpa only [riesz, burnolZeroPaRieszState_readback] using projectionRead

def burnolPaFourierMellinRead (coordinate : BurnolCompletedMellinCoordinate) :
    BurnolPaResidual →L[ℂ] ℂ :=
  (burnolCompletedMellinEvaluator coordinate).comp
    (((evenFaceFourierEquiv burnolUnscaledCommonGapRadius).toContinuousLinearEquiv
      ).toContinuousLinearMap.comp burnolPaOrthogonalClosedFace.toSubmodule.subtypeL)

theorem burnolPaFourierMellinRead_residual
    (coordinate : BurnolCompletedMellinCoordinate)
    (zero : riemannZeta coordinate.value = 0) (value : BurnolPaAmbientCarrier) :
    burnolPaFourierMellinRead coordinate
        (residual burnolCompactCoPoissonLanding value) =
      burnolCompletedMellinEvaluator coordinate
        (evenFaceFourierEquiv burnolUnscaledCommonGapRadius value) := by
  change burnolCompletedMellinEvaluator coordinate
      (burnolCompactCoPoissonActionSquare.orthogonalAction
        (residual burnolCompactCoPoissonLanding value) : BurnolPaAmbientCarrier) = _
  rw [burnolCompactCoPoissonActionSquare.orthogonalAction_residual]
  exact burnolCompletedMellinEvaluator_residual coordinate zero _

theorem burnolPaFourierMellinRead_preterminal
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (rightHalf : 1 / 2 < observation.coordinate.re)
    (order : ℕ) (beforeOrder : order < generatedRiemannXiZeroOrder owner observation.coordinate) :
    burnolPaFourierMellinRead
        (burnolAnalyticComplementCompletedMellinCoordinate observation rightHalf)
        (burnolPaResidualRead (observation.coordinate / 2)
          (burnolAnalyticComplementDivisionState observation nontrivial order)) = 0 := by
  have physical := burnolAnalyticComplementDivisionAdditiveState_mem_evenBurnolClosedFace
    observation nontrivial rightHalf order beforeOrder.le
  rw [burnolPaResidualRead, ContinuousLinearMap.comp_apply,
    burnolPaFourierMellinRead_residual _ observation.mathlibZero]
  have projectionEq :
      burnolSourceFeatureCompletionPhysicalMap (observation.coordinate / 2)
          (burnolAnalyticComplementDivisionState observation nontrivial order) =
        ⟨burnolAnalyticComplementDivisionAdditiveState observation nontrivial order,
          physical⟩ := by
    apply Subtype.ext
    exact Submodule.starProjection_eq_self_iff.mpr physical
  rw [projectionEq]
  exact burnolAnalyticComplementDivisionRawFourierRead_zero
    observation nontrivial rightHalf order beforeOrder

theorem burnolPaFourierMellinRead_jordan_preterminal
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (rightHalf : 1 / 2 < observation.coordinate.re)
    (order : ℕ) (beforeOrder : order < generatedRiemannXiZeroOrder owner observation.coordinate)
    (shift : ℝ) :
    burnolPaFourierMellinRead
        (burnolAnalyticComplementCompletedMellinCoordinate observation rightHalf)
        (burnolPaResidualJordanCoordinate (observation.coordinate / 2)
          (burnolAnalyticComplementCompletionSource observation nontrivial) order shift) = 0 := by
  induction order generalizing shift with
  | zero => simp [burnolPaResidualJordanCoordinate]
  | succ order ih =>
    let L := burnolPaFourierMellinRead
      (burnolAnalyticComplementCompletedMellinCoordinate observation rightHalf)
    let source := burnolAnalyticComplementCompletionSource observation nontrivial
    have stageRead := burnolPaFourierMellinRead_preterminal
      observation nontrivial rightHalf (order + 1) beforeOrder
    have previousZero : ∀ base : ℝ,
        L (burnolPaResidualJordanCoordinate
          (observation.coordinate / 2) source order base) = 0 :=
      fun base => ih (by omega) base
    change L (burnolPaResidualRead (observation.coordinate / 2)
        (quarterFeatureCompletionRightResolventIterate (observation.coordinate / 2)
          (order + 1) source) +
        ∫ base : ℝ in (0 : ℝ)..shift,
          burnolPaResidualJordanCoordinate (observation.coordinate / 2) source order base) = 0
    rw [map_add, ← jordanMellinRead_intervalIntegral L _ shift
      ((burnolPaResidualJordanCoordinate_continuous
        (observation.coordinate / 2) source order).intervalIntegrable 0 shift)]
    change L (burnolPaResidualRead (observation.coordinate / 2)
      (burnolAnalyticComplementDivisionState observation nontrivial (order + 1))) + _ = 0
    rw [stageRead]
    simp only [previousZero, intervalIntegral.integral_zero, add_zero]

/-- All lower Jordan terms vanish under the Fourier Mellin read generated at
the same zero, leaving the terminal read for every shift. -/
theorem burnolPaFourierMellinRead_jordan_exactOrder
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (rightHalf : 1 / 2 < observation.coordinate.re) (shift : ℝ) :
    burnolPaFourierMellinRead
        (burnolAnalyticComplementCompletedMellinCoordinate observation rightHalf)
        (burnolAnalyticComplementExactOrderPaResidualJordanCoordinate
          observation nontrivial shift) =
      burnolAnalyticComplementExpectedPhysicalFourierRead owner observation := by
  let L := burnolPaFourierMellinRead
    (burnolAnalyticComplementCompletedMellinCoordinate observation rightHalf)
  let source := burnolAnalyticComplementCompletionSource observation nontrivial
  obtain ⟨order, orderEq⟩ := Nat.exists_eq_succ_of_ne_zero
    (Nat.ne_of_gt (generatedRiemannXiZeroOrder_pos observation nontrivial))
  change generatedRiemannXiZeroOrder owner observation.coordinate = order + 1 at orderEq
  have previousZero : ∀ base : ℝ,
      L (burnolPaResidualJordanCoordinate
        (observation.coordinate / 2) source order base) = 0 := by
    intro base
    exact burnolPaFourierMellinRead_jordan_preterminal
      observation nontrivial rightHalf order (by omega) base
  have terminalRead :
      L (burnolPaResidualRead (observation.coordinate / 2)
        (quarterFeatureCompletionRightResolventIterate (observation.coordinate / 2)
          (order + 1) source)) =
        burnolAnalyticComplementExpectedPhysicalFourierRead owner observation := by
    rw [← orderEq]
    change burnolPaFourierMellinRead _
      (residual burnolCompactCoPoissonLanding
        (burnolAnalyticComplementExactOrderPhysicalState observation nontrivial)) = _
    rw [burnolPaFourierMellinRead_residual _ observation.mathlibZero]
    exact burnolAnalyticComplementExactOrderPhysicalFourierRead_eq_expected
      observation nontrivial rightHalf
  unfold burnolAnalyticComplementExactOrderPaResidualJordanCoordinate
  rw [orderEq]
  change L (burnolPaResidualRead (observation.coordinate / 2)
      (quarterFeatureCompletionRightResolventIterate (observation.coordinate / 2)
        (order + 1) source) +
      ∫ base : ℝ in (0 : ℝ)..shift,
        burnolPaResidualJordanCoordinate (observation.coordinate / 2) source order base) = _
  rw [map_add, terminalRead, ← jordanMellinRead_intervalIntegral L _ shift
    ((burnolPaResidualJordanCoordinate_continuous
      (observation.coordinate / 2) source order).intervalIntegrable 0 shift)]
  simp only [previousZero, intervalIntegral.integral_zero, add_zero]

/-- Actual source evolution generates the character equation on its physical
Fourier read.  The action precedes the `P_a` residual projection. -/
theorem burnolAnalyticComplementExactOrderPhysicalAction_fourierRead
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (rightHalf : 1 / 2 < observation.coordinate.re)
    (shift : ℝ) (shiftLower : -Real.log (16 / 9 : ℝ) ≤ shift) (bounded : shift ≤ Real.log 16) :
    burnolPaFourierMellinRead
        (burnolAnalyticComplementCompletedMellinCoordinate observation rightHalf)
        (residual burnolCompactCoPoissonLanding
          (burnolEvenAmbientProjection
            (burnolMultiplicativeDilation (-shift / 2)
              (burnolAnalyticComplementExactOrderAdditiveState observation nontrivial)))) =
      positiveMellinQuarterRightResolventCharacter (observation.coordinate / 2) shift *
        burnolAnalyticComplementExpectedPhysicalFourierRead owner observation := by
  rw [burnolAnalyticComplementExactOrderPaResidual_signed_dilation_jordanAction
    observation nontrivial rightHalf shift shiftLower bounded,
    map_smul, burnolPaFourierMellinRead_jordan_exactOrder]
  rfl

theorem burnolAnalyticComplementExactOrderPhysicalAction_fourierRead_ne_zero
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (rightHalf : 1 / 2 < observation.coordinate.re)
    (shift : ℝ) (shiftLower : -Real.log (16 / 9 : ℝ) ≤ shift) (bounded : shift ≤ Real.log 16) :
    burnolPaFourierMellinRead
        (burnolAnalyticComplementCompletedMellinCoordinate observation rightHalf)
        (residual burnolCompactCoPoissonLanding
          (burnolEvenAmbientProjection
            (burnolMultiplicativeDilation (-shift / 2)
              (burnolAnalyticComplementExactOrderAdditiveState observation nontrivial)))) ≠ 0 := by
  rw [burnolAnalyticComplementExactOrderPhysicalAction_fourierRead
    observation nontrivial rightHalf shift shiftLower bounded]
  exact mul_ne_zero (Complex.exp_ne_zero _)
    (burnolAnalyticComplementExpectedPhysicalFourierRead_ne_zero observation nontrivial)

end
