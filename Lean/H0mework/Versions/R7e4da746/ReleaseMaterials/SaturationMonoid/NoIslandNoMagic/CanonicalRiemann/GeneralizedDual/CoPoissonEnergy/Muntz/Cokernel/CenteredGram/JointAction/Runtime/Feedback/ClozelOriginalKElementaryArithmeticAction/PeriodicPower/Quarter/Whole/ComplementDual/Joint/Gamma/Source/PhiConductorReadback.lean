private theorem original_tate_base (c : BurnolCompletedMellinCoordinate) :
    T (originalBaseSynthesis c ConstantDual.value) =
      fourierL2.symm (originalBaseSynthesis c ConstantForward.value) := by
  rw [original_first_joint, ← (phiStatePaid% base_commute) c joint joint_dilation, joint_apply,
    fourierL2.symm_apply_apply]

private theorem original_gamma_first_field (c : BurnolCompletedMellinCoordinate)
    (zero : riemannZeta c.value = 0)
    (source : GammaPair ConstantDual.value (d + T (F a))) :
    GammaPair (originalDualField c zero)
      (fourierL2.symm (originalBaseSynthesis c firstConductorValue) - originalBSynthesis c (d + T (F a))) := by
  have base := (phiGammaPaid% gamma_pair_base) c ConstantForward.value firstConductorValue
    original_first_whole_conductor
  have tate := (phiGammaPaid% gamma_pair_inverse_fourier) _ _ base
  have b := (phiGammaPaid% gamma_pair_b) c ConstantDual.value (d + T (F a)) source
  intro test
  rw [original_dual_synthesis, original_tate_base, inner_sub_right, tate test, b test, inner_sub_right]

private theorem original_inverse_fourier_base_joint (c : BurnolCompletedMellinCoordinate) (value : BurnolL2) :
    fourierL2.symm (originalBaseSynthesis c (joint value)) = T (originalBaseSynthesis c value) := by
  rw [← (phiStatePaid% base_commute) c joint joint_dilation, joint_apply, fourierL2.symm_apply_apply]

private theorem original_base_a_even (c : BurnolCompletedMellinCoordinate) :
    reflectL2 (originalBaseSynthesis c a) = originalBaseSynthesis c a := by
  change reflectL2.toContinuousLinearMap (originalBaseSynthesis c a) = originalBaseSynthesis c a
  rw [(phiStatePaid% base_commute) c reflectL2.toContinuousLinearMap reflectL2_burnolMultiplicativeDilation]
  change originalBaseSynthesis c (reflectL2 a) = originalBaseSynthesis c a
  rw [phiLogPaid% forward_log_even]

private theorem original_b_d_even (c : BurnolCompletedMellinCoordinate) :
    reflectL2 (originalBSynthesis c d) = originalBSynthesis c d := by
  change reflectL2.toContinuousLinearMap (originalBSynthesis c d) = originalBSynthesis c d
  rw [(phiStatePaid% b_commute) c reflectL2.toContinuousLinearMap reflectL2_burnolMultiplicativeDilation]
  change originalBSynthesis c (reflectL2 d) = originalBSynthesis c d
  rw [phiLogPaid% dual_log_even]

private theorem original_inverse_fourier_base_a (c : BurnolCompletedMellinCoordinate) :
    fourierL2.symm (originalBaseSynthesis c a) = F (originalBaseSynthesis c a) := by
  rw [fourierL2_symm_eq_reflect_fourierL2, ← fourierL2_reflectL2_commute, original_base_a_even]

private theorem original_b_reverse_joint (c : BurnolCompletedMellinCoordinate) :
    originalBSynthesis c (T (F a)) = T (F (originalBSynthesis c a)) := by
  have source := (phiStatePaid% b_commute) c (phiStatePaid% inverseJoint)
    (phiStatePaid% inverse_joint_dilation) a
  exact source.symm

private theorem original_gamma_value (c : BurnolCompletedMellinCoordinate) :
    fourierL2.symm (originalBaseSynthesis c firstConductorValue) - originalBSynthesis c (d + T (F a)) =
      originalDualLogValue c := by
  simp only [firstConductorValue, map_add, map_sub, originalDualLogValue, originalLogAValue,
    originalLogDValue]
  rw [original_inverse_fourier_base_a, original_inverse_fourier_base_joint,
    original_b_reverse_joint, fourierL2_fourierL2, original_b_d_even]
  module

private theorem original_dual_gamma_from_source (c : BurnolCompletedMellinCoordinate)
    (zero : riemannZeta c.value = 0)
    (source : GammaPair ConstantDual.value (d + T (F a))) :
    GammaPair (originalDualField c zero) (originalDualLogValue c) := by
  have generated := original_gamma_first_field c zero source
  rw [original_gamma_value] at generated
  exact generated

theorem original_dual_field_conductor (c : BurnolCompletedMellinCoordinate)
    (zero : riemannZeta c.value = 0) :
    GammaPair (originalDualField c zero) (originalDualLogValue c) :=
  original_dual_gamma_from_source c zero OriginalGamma.Source.TateConductor.original_dual_first_conductor

