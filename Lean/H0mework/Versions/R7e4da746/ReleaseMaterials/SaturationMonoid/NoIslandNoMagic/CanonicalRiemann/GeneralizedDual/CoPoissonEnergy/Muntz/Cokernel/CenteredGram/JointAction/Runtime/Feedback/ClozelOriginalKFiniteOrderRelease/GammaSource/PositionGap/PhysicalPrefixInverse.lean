/-- The approximation space is generated by the original current and its actual write. -/
def physicalSpan (ordinal : Nat) : Submodule ℂ PositionField :=
  Submodule.span ℂ ({field ordinal, field (ordinal+1)} : Set PositionField)

/-- These are the unaltered physical slots at positive indices of the original Division. -/
def recordedPhysicalPrefix (ordinal last : Nat) : Prefix last :=
  WithLp.toLp 2 fun i : Fin (last+1) => (input (ordinal+(i.val+1))).1

local notation "recorded" => recordedPhysicalPrefix observation nontrivial half depth
local notation "stock" => physicalSpan observation nontrivial half depth

theorem actual_recorded_physical_prefix (ordinal last : Nat) :
    recorded ordinal last =
      FiniteRestriction.hilbertPrefix (positionR c) (physicalSuccessor c) last (field ordinal) := by
  apply (PiLp.continuousLinearEquiv 2 ℂ (fun _ : Fin (last+1) => BurnolL2)).injective
  funext i
  change (input (ordinal+(i.val+1))).1 =
    FiniteRestriction.hilbertPrefix (positionR c) (physicalSuccessor c) last (field ordinal) i
  rw [FiniteRestriction.hilbertPrefix_read]
  exact (literal_physical_successor observation nontrivial half depth ordinal i.val).symm

/-- One bounded inverse reads both original pairs from their own finite physical successor prefixes. -/
theorem actual_division_physical_prefix_inverse (ordinal : Nat) :
    ∃ (last : Nat) (decode : Prefix last →L[ℂ] stock ordinal),
      let readback := splitField.comp (stock ordinal).subtypeL;
      readback (decode (recorded ordinal last)) = input ordinal ∧
      readback (decode (recorded (ordinal+1) last)) = input (ordinal+1) ∧
      (∀ received : Prefix last, ‖readback (decode received) - input ordinal‖ ≤
        ‖(P).prod O‖ * (‖decode‖ * ‖received - recorded ordinal last‖)) ∧
      (∀ received : Prefix last, ‖readback (decode received) - input (ordinal+1)‖ ≤
        ‖(P).prod O‖ * (‖decode‖ * ‖received - recorded (ordinal+1) last‖)) := by
  let S := stock ordinal
  let left : S := ⟨field ordinal, Submodule.subset_span (by simp)⟩
  let right : S := ⟨field (ordinal+1), Submodule.subset_span (by simp)⟩
  have : FiniteDimensional ℂ S :=
    FiniteDimensional.span_of_finite ℂ ((Set.finite_singleton _).insert _)
  obtain ⟨last, decode, exactRead, error⟩ :=
    FiniteRestriction.bounded_prefix_inverse (positionR c) (physicalSuccessor c) S
      (physical_history_injective c)
  let readback : S →L[ℂ] BurnolL2 × BurnolL2 := splitField.comp S.subtypeL
  have fits (i : Nat) (v : S) (source : (v : PositionField) = field i) :
      decode (recorded i last) = v := by
    rw [actual_recorded_physical_prefix, ← source, exactRead]
  have decoded (i : Nat) (v : S) (source : (v : PositionField) = field i) :
      readback (decode (recorded i last)) = input i := by
    rw [fits i v source]
    change (P (((v : PositionField) : BurnolL2)), O (((v : PositionField) : BurnolL2))) = input i
    rw [source]
    exact literal_split observation nontrivial half depth i
  have bound (i : Nat) (v : S) (source : (v : PositionField) = field i) (received : Prefix last) :
      ‖readback (decode received) - input i‖ ≤ ‖(P).prod O‖ *
        (‖decode‖ * ‖received - recorded i last‖) := by
    rw [← decoded i v source, ← map_sub, fits i v source]
    have opBound := ((P).prod O).le_opNorm (((decode received - v : S) : PositionField) : BurnolL2)
    have paid := error v received
    rw [source, ← actual_recorded_physical_prefix] at paid
    exact opBound.trans (mul_le_mul_of_nonneg_left paid (norm_nonneg ((P).prod O)))
  exact ⟨last, decode, decoded ordinal left rfl, decoded (ordinal+1) right rfl,
    bound ordinal left rfl, bound (ordinal+1) right rfl⟩

/-- A finite visible original successor has a nonzero price against an independent original K. -/
theorem actual_division_physical_K_visible (ordinal : Nat) :
    ∃ (j : Nat) (test : BurnolCompletedMellinCoordinate), 0 < j ∧ test.value.re = 3/4 ∧
      inner ℂ (burnolCompletedMellinRieszVector test : BurnolL2) (input (ordinal+j)).1 ≠ 0 := by
  obtain ⟨_, _, _, _, j, _, positive, _, visible⟩ :=
    actual_division_finite_physical_visibility observation nontrivial half depth ordinal
  let p := burnolEvenAmbientProjection (Div.raw observation nontrivial half depth (ordinal+j))
  have read : (p : BurnolL2) = (input (ordinal+j)).1 :=
    congrArg Prod.fst (literal_split observation nontrivial half depth (ordinal+j))
  have probe : ∃ test : BurnolCompletedMellinCoordinate, test.value.re = 3/4 ∧
      inner ℂ (burnolCompletedMellinRieszVector test : BurnolL2) (input (ordinal+j)).1 ≠ 0 := by
    by_contra! silent
    apply visible
    rw [← read]
    apply actual_mellin_separates_positionGap _ p.property.1.1 (mem_evenL2ClosedFace_iff.mp p.property.2)
    intro test line
    have restrict := congrArg (fun f : BurnolPaAmbientCarrier →L[ℂ] ℂ => f p)
      (burnolAmbientCompletedMellinEvaluator_restrict test)
    change burnolAmbientCompletedMellinEvaluator test (p : BurnolL2) =
      burnolCompletedMellinEvaluator test p at restrict
    rw [restrict, ← burnolCompletedMellinRieszVector_readback]
    change inner ℂ (burnolCompletedMellinRieszVector test : BurnolL2) (p : BurnolL2) = 0
    rw [read]
    exact silent test line
  obtain ⟨test, line, paid⟩ := probe
  exact ⟨j, test, positive, line, paid⟩

