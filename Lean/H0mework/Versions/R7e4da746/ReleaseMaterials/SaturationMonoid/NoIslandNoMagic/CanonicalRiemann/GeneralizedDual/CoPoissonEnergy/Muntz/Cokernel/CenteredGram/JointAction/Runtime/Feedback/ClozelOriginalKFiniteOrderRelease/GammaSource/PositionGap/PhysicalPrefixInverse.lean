local notation "P" => OriginalKCombPhysicalAction.physicalProjection
local notation "O" => OriginalKCombPhysicalAction.physicalRemainder
local instance : CompleteSpace PositionField :=
  positionSpace.isClosed.isComplete.completeSpace_coe

private def splitField : PositionField →L[ℂ] BurnolL2 × BurnolL2 :=
  ((P).prod O).comp positionSpace.toSubmodule.subtypeL

private abbrev Prefix (last : Nat) := PiLp 2 (fun _ : Fin (last+1) => BurnolL2)

variable (observation : GeneratedRiemannZeroObservation)
variable (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2*(n+1))
