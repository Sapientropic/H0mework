def actualEvenQuarterFoot (state : BurnolQuarterMeanZeroCarrier) : BurnolQuarterMeanZeroCarrier :=
  ⟨(1/2:ℂ) • ((state:BurnolQuarterIntervalL2) + reflectRestricted (1/4:ℝ) (state:BurnolQuarterIntervalL2)),
    burnolQuarterMeanZeroClosedFace.toSubmodule.smul_mem _
      (burnolQuarterMeanZeroClosedFace.toSubmodule.add_mem state.property
        (reflectRestricted_quarter_preserves_meanZero state.property))⟩

def actualQuarterCorrectionFeet (source : BurnolQuarterMeanZeroCarrier × BurnolQuarterMeanZeroCarrier) :
    BurnolQuarterMeanZeroCarrier × BurnolQuarterMeanZeroCarrier :=
  (actualEvenQuarterFoot (burnolMeanZeroBlockFirst source),actualEvenQuarterFoot (burnolMeanZeroBlockSecond source))

private theorem even_quarter_extension (state : BurnolQuarterMeanZeroCarrier) :
    burnolAmbientEvenPart (burnolQuarterZeroExtension (state:BurnolQuarterIntervalL2)) =
      burnolQuarterZeroExtension (actualEvenQuarterFoot state : BurnolQuarterIntervalL2) := by
  unfold burnolAmbientEvenPart actualEvenQuarterFoot
  change (1/2:ℂ) • (burnolQuarterZeroExtension _ + reflectL2 (burnolQuarterZeroExtension _)) =
    burnolQuarterZeroExtension ((1/2:ℂ) • (_+_))
  have reflected : reflectL2 (burnolQuarterZeroExtension (state:BurnolQuarterIntervalL2)) =
      burnolQuarterZeroExtension (reflectRestricted (1/4:ℝ) (state:BurnolQuarterIntervalL2)) :=
    burnolRadiusZeroExtension_reflect (1/4:ℝ) _
  rw [map_smul,map_add,reflected]

private theorem even_fourier_commutes (value : BurnolL2) :
    burnolAmbientEvenPart (fourierL2 value) = fourierL2 (burnolAmbientEvenPart value) := by
  unfold burnolAmbientEvenPart
  rw [map_smul,map_add,fourierL2_reflectL2_commute]

/-- Both full quarter correction feet are generated by the same block inverse; the second Fourier foot survives intact. -/
theorem actual_outside_quarter_programme_fields (source : BurnolQuarterMeanZeroCarrier × BurnolQuarterMeanZeroCarrier) :
    actualOutsideQuarterProgramme source =
      burnolQuarterZeroExtension ((actualQuarterCorrectionFeet source).1 : BurnolQuarterIntervalL2) +
      fourierL2 (burnolQuarterZeroExtension ((actualQuarterCorrectionFeet source).2 : BurnolQuarterIntervalL2)) := by
  unfold actualOutsideQuarterProgramme burnolAmbientEvenPart
  rw [map_add]
  have sum : (1/2:ℂ) • ((burnolQuarterZeroExtension (burnolMeanZeroBlockFirst source : BurnolQuarterIntervalL2) +
      fourierL2 (burnolQuarterZeroExtension (burnolMeanZeroBlockSecond source : BurnolQuarterIntervalL2))) +
    (reflectL2 (burnolQuarterZeroExtension (burnolMeanZeroBlockFirst source : BurnolQuarterIntervalL2)) +
      reflectL2 (fourierL2 (burnolQuarterZeroExtension (burnolMeanZeroBlockSecond source : BurnolQuarterIntervalL2))))) =
    burnolAmbientEvenPart (burnolQuarterZeroExtension (burnolMeanZeroBlockFirst source : BurnolQuarterIntervalL2)) +
      burnolAmbientEvenPart (fourierL2 (burnolQuarterZeroExtension (burnolMeanZeroBlockSecond source : BurnolQuarterIntervalL2))) := by
    unfold burnolAmbientEvenPart
    module
  rw [sum,even_fourier_commutes,even_quarter_extension,even_quarter_extension]
  rfl

/-- The four actual correction-source feet generate an interval Gram, with both Fourier cross terms retained. -/
def actualQuarterSourceGram (left right : BurnolQuarterMeanZeroCarrier × BurnolQuarterMeanZeroCarrier) : ℂ :=
  let l := actualQuarterCorrectionFeet left
  let r := actualQuarterCorrectionFeet right
  inner ℂ l.1 r.1 + inner ℂ l.2 r.2 +
    inner ℂ l.1 (burnolMeanZeroTruncatedFourier r.2) +
    star (inner ℂ r.1 (burnolMeanZeroTruncatedFourier l.2))

theorem actual_outside_quarter_source_Gram (left right : BurnolQuarterMeanZeroCarrier × BurnolQuarterMeanZeroCarrier) :
    inner ℂ (actualOutsideQuarterProgramme left) (actualOutsideQuarterProgramme right) =
      actualQuarterSourceGram left right := by
  rw [actual_outside_quarter_programme_fields,actual_outside_quarter_programme_fields]
  rw [inner_add_left,inner_add_right,inner_add_right,fourierL2.inner_map_map,
    OriginalRieszSourceGreen.quarter_extension_inner,OriginalRieszSourceGreen.quarter_extension_inner,
    OriginalRieszSourceGreen.extension_fourier_pairing]
  have reverse : inner ℂ
    (fourierL2 (burnolQuarterZeroExtension ((actualQuarterCorrectionFeet left).2 : BurnolQuarterIntervalL2)))
    (burnolQuarterZeroExtension ((actualQuarterCorrectionFeet right).1 : BurnolQuarterIntervalL2)) =
      star (inner ℂ (actualQuarterCorrectionFeet right).1
        (burnolMeanZeroTruncatedFourier (actualQuarterCorrectionFeet left).2)) := by
    rw [←inner_conj_symm,
      OriginalRieszSourceGreen.extension_fourier_pairing]
    rfl
  rw [reverse]
  unfold actualQuarterSourceGram
  dsimp only
  change inner ℂ (actualQuarterCorrectionFeet left).1 (actualQuarterCorrectionFeet right).1 +
    inner ℂ (actualQuarterCorrectionFeet left).1 (burnolMeanZeroTruncatedFourier (actualQuarterCorrectionFeet right).2) +
    (star (inner ℂ (actualQuarterCorrectionFeet right).1 (burnolMeanZeroTruncatedFourier (actualQuarterCorrectionFeet left).2)) +
    inner ℂ (actualQuarterCorrectionFeet left).2 (actualQuarterCorrectionFeet right).2) = _
  ring

