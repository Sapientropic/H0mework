private theorem born_packet_literal :
    Cfa.packetTransport method.source.2.2.2.down (Cfa.sourceBorn factory method.source) = site (update+2) :=
  (congrArg (fun source : AS.AdmissionPacket (W := A.W) (X := A.X) (s := slot) =>
    Cfa.packetTransport source.2.2.2.down (Cfa.sourceBorn factory source)) method.source_literal).trans
    (Cfa.actual_next_packet factory initial programme rfl (update+1)).symm

def actualStepWord (index : StepIndex observation nontrivial half method.source) :
    Tower.Words factory initial programme rfl (update+2) :=
  packetWordTransport (born_packet_literal observation nontrivial half depth ordinal method)
    (packetLanguageWord method.source.2.2.2.down (Cfa.sourceBorn factory method.source)
      (bornStep observation nontrivial half method.source index).word)

private theorem actualStep_member (index : StepIndex observation nontrivial half method.source) :
    Model.WordInInventory (site (update+2))
      (actualStepWord observation nontrivial half depth ordinal method index) :=
  inventory_packet_transport (born_packet_literal observation nontrivial half depth ordinal method) _
    (inventory_language_transport method.source.2.2.2.down (Cfa.sourceBorn factory method.source) _
      (step_in_born observation nontrivial half method.source index))

private def sourceBoundary : RF.RelationAt (Cfa.sourceBorn factory method.source) where
  inventory := Cfa.bornStock factory method.source
  installed := Cfa.born_inventory factory method.source
  val := ((bornSteps observation nontrivial half method.source).map (fun step => step.word)).sum
  member := (born_steps_boundary observation nontrivial half method.source).symm ▸
    Q.Actual.boundary_written observation nontrivial half depth ordinal method

def actualBoundary : RF.RelationAt (site (update+2)) :=
  transportRelation (born_packet_literal observation nontrivial half depth ordinal method)
    (languageRelation method.source.2.2.2.down (Cfa.sourceBorn factory method.source)
      (sourceBoundary observation nontrivial half depth ordinal method))

theorem actualBoundary_source : HEq (actualBoundary observation nontrivial half depth ordinal method).val
    (boundaryWord observation nontrivial half method.source) :=
  (transportRelation_source (born_packet_literal observation nontrivial half depth ordinal method) _).trans
    ((languageRelation_word method.source.2.2.2.down (Cfa.sourceBorn factory method.source) _).trans
      (heq_of_eq (born_steps_boundary observation nontrivial half method.source)))

def nextBoundary : RF.RelationAt (site ((update+2)+1)) :=
  transportRelation (D.packetAt_successor factory initial programme rfl (update+2)).symm
    (RF.actionNextRelation factory (site (update+2))
      (actualBoundary observation nontrivial half depth ordinal method))

def actedBoundaryWord :=
  let current := site (update+2)
  let value := Cfa.sourceWordAction current (actualBoundary observation nontrivial half depth ordinal method).val
  value - constantMap (R := ℤ) (Value := Lower.Value A.W (current.1+1)) (Var := current.2.2.1.LowVar)
    (valueMap (R := ℤ) (Value := Lower.Value A.W (current.1+1)) (Var := current.2.2.1.LowVar)
      (Shared.nextBorn (Cfa.selected factory current) (Q.stockCfg (Cfa.nativePacket factory current).2.2.1)).activeEnvironment value)

theorem nextBoundary_source : HEq (nextBoundary observation nontrivial half depth ordinal method).val
    (actedBoundaryWord observation nontrivial half depth ordinal method) :=
  (transportRelation_source (D.packetAt_successor factory initial programme rfl (update+2)).symm _).trans
    ((RF.actionNextRelation_source factory (site (update+2))
      (actualBoundary observation nontrivial half depth ordinal method)).trans
      (heq_of_eq (RF.actionRelation_equation factory (site (update+2))
        (actualBoundary observation nontrivial half depth ordinal method))))

def nextJointBoundary : (jointHistoryAt (site ((update+2)+1))).relationClosure :=
  ⟨liftMap (R := ℤ) (nextBoundary observation nontrivial half depth ordinal method).val, by
    simpa only [jointHistoryAt,Feed.history_relation_space] using
      RF.jointRelation_member (site ((update+2)+1)) (nextBoundary observation nontrivial half depth ordinal method)⟩

local notation "nextJoint" => jointHistoryAt (site ((update+2)+1))
local notation "nextTick" => D.index factory initial programme rfl ((update+2)+1)-1

/-- The ordered physical operations enter the original common action, and their full boundary the original next cochain. -/
theorem actual_physical_gamma_boundary_feedback :
    (∀ i : StepIndex observation nontrivial half method.source,
      Model.WordInInventory (site ((update+2)+1))
        (Model.siteAction factory initial programme rfl (update+2)
          (actualStepWord observation nontrivial half depth ordinal method i)) ∧
      Model.modelAction factory initial programme rfl
        (Model.projection factory initial programme rfl
          (DFinsupp.single (update+2) (actualStepWord observation nontrivial half depth ordinal method i))) =
      Model.projection factory initial programme rfl
        (DFinsupp.single ((update+2)+1) (Model.siteAction factory initial programme rfl (update+2)
          (actualStepWord observation nontrivial half depth ordinal method i)))) ∧
    HEq (nextBoundary observation nontrivial half depth ordinal method).val
      (actedBoundaryWord observation nontrivial half depth ordinal method) ∧
    (nextJoint).completionProjection
      (((Cx.natComplex nextJoint).d 0 1).hom (nextJointBoundary observation nontrivial half depth ordinal method)) = 0 ∧
    type_of% (SF.actual_whole factory initial programme rfl nextTick) ∧
    ((A.sourceRuntime observation nontrivial half depth ordinal).tickAt nextTick).next.node =
      .active (AS.admissionPresentation factory (site ((update+2)+1))) := by
  refine ⟨?_,nextBoundary_source observation nontrivial half depth ordinal method,
    Cx.completion_kills_generated_differential nextJoint (nextJointBoundary observation nontrivial half depth ordinal method),
    SF.actual_whole factory initial programme rfl nextTick,
    BornRSealedSourceWriteback.actual_written_born_next observation nontrivial half depth ordinal (update+2)⟩
  intro i
  let actual := Model.actual_source_word_step factory initial programme rfl (update+2)
    (actualStepWord observation nontrivial half depth ordinal method i)
    (actualStep_member observation nontrivial half depth ordinal method i)
  exact ⟨actual.2.1,actual.2.2.1⟩

