private theorem execution_trace_append {S : Type u} {V X : S → Type u}
    [∀ t, AddCommGroup (V t)] {s : S} (decoder : Env V X)
    (left right : List (Feed.Request (V := V) (X := X) (s := s))) :
    RootedAccountedUnfolding.traceBranches (Feed.executionBranches decoder (left ++ right)) =
      RootedAccountedUnfolding.traceBranches (Feed.executionBranches decoder left) ++
      RootedAccountedUnfolding.traceBranches (Feed.executionBranches decoder right) := by
  induction left with
  | nil => rfl
  | cons head rest previous =>
    let exposure := P.exposure (SourceInventoryExecutionFeed.receipt decoder head)
    change exposure.trace ++ RootedAccountedUnfolding.traceBranches (Feed.executionBranches decoder (rest ++ right)) =
      (exposure.trace ++ RootedAccountedUnfolding.traceBranches (Feed.executionBranches decoder rest)) ++
        RootedAccountedUnfolding.traceBranches (Feed.executionBranches decoder right)
    rw [previous,List.append_assoc]

