/-- This is the executed block of the exact admitted request, including every contextual step. -/
def receiptSegment : SourceInventoryTraceSegment (P.exposure paid) born := by
  let point := Q.sourceOccurrence observation nontrivial half packet
  let front := Feed.requestsFrom 0 point.before
  let back := Feed.requestsFrom (point.before.length+1) point.after
  have split : Feed.requests stock = front ++ ask :: back :=
    (congrArg (Feed.requestsFrom 0) point.trace_eq).trans (by
      rw [requestsFrom_append]
      simp only [front,back,Nat.zero_add,Feed.requestsFrom,Feed.eventItems,
        List.map_cons,List.map_nil,List.singleton_append]
      rfl)
  let executedFront := RootedAccountedUnfolding.traceBranches (Feed.executionBranches decoder front)
  let executedBack := RootedAccountedUnfolding.traceBranches (Feed.executionBranches decoder back)
  refine ⟨(stock).trace ++ executedFront, executedBack, ?_⟩
  change (Feed.written decoder stock).trace = _
  rw [Feed.written_trace,split,execution_trace_append]
  change (stock).trace ++ (executedFront ++ ((P.exposure paid).trace ++ executedBack)) =
    ((stock).trace ++ executedFront) ++ (P.exposure paid).trace ++ executedBack
  simp only [List.append_assoc]

abbrev StepIndex := Fin (P.words paid).length

def bornStep (index : StepIndex observation nontrivial half packet) : WR.RelationOccurrence born :=
  (P.stepOccurrence paid index).transport (receiptSegment observation nontrivial half packet)

theorem step_word (index : StepIndex observation nontrivial half packet) :
    (bornStep observation nontrivial half packet index).word = (P.words paid).get index :=
  ((P.stepOccurrence paid index).transport_word (receiptSegment observation nontrivial half packet)).trans
    (P.stepOccurrence_word paid index)

theorem step_position (index : StepIndex observation nontrivial half packet) :
    (bornStep observation nontrivial half packet index).before.length =
      (receiptSegment observation nontrivial half packet).before.length + 1 + index.val := by
  rw [bornStep,SourceInventoryExecutionFeed.WordReceipt.RelationOccurrence.transport_position,
    P.stepOccurrence_before_length,Nat.add_assoc]

theorem step_count : (P.words paid).length = 13 :=
  (P.complete_steps paid).trans (Q.receipt_cost observation nontrivial half packet)

def bornSteps : List (WR.RelationOccurrence born) :=
  List.ofFn (bornStep observation nontrivial half packet)

theorem born_steps_words : (bornSteps observation nontrivial half packet).map (fun step => step.word) =
    P.words paid := by
  rw [bornSteps,List.map_ofFn]
  simp only [Function.comp_def,step_word,List.ofFn_get]

def boundaryWord : Formal ℤ (Lower.Value A.W (packet.1+1)) packet.2.2.1.LowVar slot :=
  Finsupp.single (ask).expression 1 - Finsupp.single (.const ((ask).expression.eval decoder)) 1

/-- The complete boundary is the sum of the actual paid atoms, not itself a selected atom. -/
theorem born_steps_boundary : ((bornSteps observation nontrivial half packet).map (fun step => step.word)).sum =
    boundaryWord observation nontrivial half packet :=
  (congrArg List.sum (born_steps_words observation nontrivial half packet)).trans
    ((P.paid_boundary paid).trans ((paid).relation_boundary (R := ℤ)))

private theorem step_in_born (index : StepIndex observation nontrivial half packet) :
    Model.WordInInventory (Cfa.sourceBorn factory packet)
      (bornStep observation nontrivial half packet index).word := by
  let point := bornStep observation nontrivial half packet index
  refine ⟨born,Cfa.born_inventory factory packet,?_⟩
  rw [point.trace_eq]
  exact List.mem_append_right _ List.mem_cons_self

private def languageRelation {Y Z : CompletedSourceRCalculation.Slot → Type} (same : Y = Z)
    (source : AS.AdmissionPacket (W := A.W) (X := Y) (s := slot)) (relation : RF.RelationAt source) :
    RF.RelationAt (Cfa.packetTransport same source) := by
  cases same
  exact relation

private theorem languageRelation_word {Y Z : CompletedSourceRCalculation.Slot → Type} (same : Y = Z)
    (source : AS.AdmissionPacket (W := A.W) (X := Y) (s := slot)) (relation : RF.RelationAt source) :
    HEq (languageRelation same source relation).val relation.val := by
  cases same
  rfl

