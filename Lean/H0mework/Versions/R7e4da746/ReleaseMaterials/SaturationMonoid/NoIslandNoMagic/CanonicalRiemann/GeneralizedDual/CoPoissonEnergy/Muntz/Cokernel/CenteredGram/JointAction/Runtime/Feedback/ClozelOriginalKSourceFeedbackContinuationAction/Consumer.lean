/-- The source-owned native continuation consumes the real receipt, whole material effect, typed source stock and independent complete raw prices. -/
theorem main (test : BurnolQuarterMeanZeroCarrier) :
 (Environment.At (continuationSourceBorn t factory packet)
  (continuationSourceWrite t factory packet (continuationSourceUpdatedTotal t factory packet))) ∧
 (type_of% (continuation_whole_registered_material_effect t factory packet)) ∧
 (type_of% (continuation_material_actual_update t factory packet)) ∧
 (type_of% (continuation_whole_material_input_receipt t factory packet)) ∧
 (type_of% (continuation_whole_material_generates_raw_next t factory packet)) ∧
 (type_of% (continuation_whole_material_raw_fee t factory packet test)) ∧
 (type_of% (continuation_whole_material_tail_budget t factory packet)) ∧
 (type_of% (continuation_before_fee_keeps_inherited t factory packet test)) ∧
 (∀ event (_present : event∈(SourceOperationPaidRelations.exposure
  (continuationSourceTrace t factory packet (continuationSourceSelected t factory packet))).trace),
  event∈((continuationSourceBorn t factory packet).inventory.get (by rfl)).trace) ∧
 (∀ event (_present : event∈(SourceOperationPaidRelations.exposure
  (continuationSourcePairTrace t factory packet (continuationSourceSelected t factory packet))).trace),
  event∈((continuationSourceBorn t factory packet).pairInventory.get (by rfl)).trace) ∧
 (∀ prior (_actual : (Parent.actualNextSourceFrame t factory packet).inventory=some prior) event (_present : event∈prior.trace),
  SourceStock.liftEvent event∈((continuationSourceBorn t factory packet).inventory.get (by rfl)).trace) ∧
 (∀ prior (_actual : (Parent.actualNextSourceFrame t factory packet).pairInventory=some prior) event (_present : event∈prior.trace),
  SourceOperationInquiry.Context.Faces.Execution.Activation.InventoryProgramme.Pair.Residual.liftEvent event∈
   ((continuationSourceBorn t factory packet).pairInventory.get (by rfl)).trace) ∧
 (type_of% (AN.new_relation_in_born (continuationSourceSelected t factory packet) (continuationSourceStockEmitter t factory packet))) ∧
 (type_of% (AN.new_relation_face (continuationSourceSelected t factory packet))) ∧
 (type_of% (AN.new_cochain_face (continuationSourceSelected t factory packet))) ∧
 (type_of% (AN.new_differential (continuationSourceSelected t factory packet))) ∧
 (type_of% (AN.new_whole_recovery (continuationSourceSelected t factory packet))) ∧
 (type_of% (AN.new_full_trace (continuationSourceSelected t factory packet))) ∧
 (type_of% ((continuationActualWhole t factory packet).actual_step)) ∧
 (type_of% ((continuationActualWhole t factory packet).same_ledger)) ∧
 (type_of% ((continuationActualWhole t factory packet).same_visit)) ∧
 (type_of% ((continuationActualWhole t factory packet).payment.strictDebit)) ∧
 (type_of% ((continuationActualWhole t factory packet).entry)) ∧
 (type_of% ((continuationActualWhole t factory packet).whole_destination)) ∧
 (type_of% (continuation_actual_root t factory packet)) ∧
 (type_of% (continuation_actual_current t factory packet)) :=
 ⟨@continuation_actual_born_environment t factory packet,
 continuation_whole_registered_material_effect t factory packet,
 continuation_material_actual_update t factory packet,
 continuation_whole_material_input_receipt t factory packet,
 continuation_whole_material_generates_raw_next t factory packet,
 continuation_whole_material_raw_fee t factory packet test,
 continuation_whole_material_tail_budget t factory packet,
 continuation_before_fee_keeps_inherited t factory packet test,
 fun event present=>continuation_source_nodes_in_born t factory packet event present,
 fun event present=>continuation_source_pair_nodes_in_born t factory packet event present,
 fun prior actual event present=>continuation_old_scalar_nodes_in_born t factory packet prior actual event present,
 fun prior actual event present=>continuation_old_pair_nodes_in_born t factory packet prior actual event present,
 AN.new_relation_in_born (continuationSourceSelected t factory packet) (continuationSourceStockEmitter t factory packet),
 AN.new_relation_face (continuationSourceSelected t factory packet),
 AN.new_cochain_face (continuationSourceSelected t factory packet),
 AN.new_differential (continuationSourceSelected t factory packet),
 AN.new_whole_recovery (continuationSourceSelected t factory packet),
 AN.new_full_trace (continuationSourceSelected t factory packet),
 (continuationActualWhole t factory packet).actual_step,
 (continuationActualWhole t factory packet).same_ledger,
 (continuationActualWhole t factory packet).same_visit,
 (continuationActualWhole t factory packet).payment.strictDebit,
 (continuationActualWhole t factory packet).entry,
 (continuationActualWhole t factory packet).whole_destination,
 continuation_actual_root t factory packet,
 continuation_actual_current t factory packet⟩
