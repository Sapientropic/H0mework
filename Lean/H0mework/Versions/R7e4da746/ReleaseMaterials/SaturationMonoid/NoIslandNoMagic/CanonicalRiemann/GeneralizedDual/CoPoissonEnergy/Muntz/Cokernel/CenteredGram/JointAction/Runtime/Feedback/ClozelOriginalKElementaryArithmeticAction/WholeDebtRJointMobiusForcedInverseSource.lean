local notation "c" => OriginalKCombCofinalTwoDirection.coordinate observation nontrivial half

private theorem fourier_power_projection_zero (d : BurnolCompletedMellinCoordinate) :
    P (F (hPowerPhysicalCorrection d))=0 := by
  have zero:=orthogonal_P _ (powerCorrection_orthogonal d)
  have square:=fourierL2_evenBurnolPhysicalProjection burnolUnscaledCommonGapRadius (hPowerPhysicalCorrection d)
  change F (P (hPowerPhysicalCorrection d))=P (F (hPowerPhysicalCorrection d)) at square
  rw [zero,map_zero] at square
  exact square.symm

/-- Coefficients are identified only after both full K/FK/B actions are executed on the same source. -/
theorem actual_direction_match : sourceForwardRatio c=sourceAdjointRatio (barC c) := by
  have source:=source_Cayley_F (barC c) (generatedK c)
  have adjoint:=source_Uadj_Kbar (barC c)
  rw [conjugate_twice] at adjoint source
  rw [sourceCayley_actual_adjoint] at adjoint
  rw [source_U_FK,adjoint,map_sub,map_smul,fourierL2_fourierL2,kernel_even] at source
  have projected:=congrArg P source
  simp only [map_sub,map_smul,generated_projection,
    orthogonal_P _ (outsideColumn_orthogonal c),fourier_power_projection_zero,
    smul_zero,sub_zero] at projected
  have native:generatedK (barC c)≠0:=conjugate_generated_kernel_ne_zero observation nontrivial half.down
  have difference : (sourceForwardRatio c-sourceAdjointRatio (barC c)) • generatedK (barC c)=0 := by
    rw [sub_smul,projected,sub_self]
  exact sub_eq_zero.mp ((smul_eq_zero.mp difference).resolve_right native)

/-- The existing B-power inverse balance supplies the determinant of the actual conjugate forcing loop. -/
theorem actual_forcing_determinant :
    1-coupling c*coupling (barC c)=((forcingDeterminant c : ℝ) : ℂ) := by
  rw [actual_coupling,actual_coupling,conjugate_twice,←actual_direction_match observation nontrivial half]
  have source:=(actual_scalar_balance_source observation nontrivial half).2.1
  change sourceForwardRatio c*sourceAdjointRatio c=1-
    4*(sourceDamping c : ℂ)^2*((‖generatedK c‖^2 : ℝ) : ℂ)*
      ((‖hPowerPhysicalCorrection (barC c)‖^2 : ℝ) : ℂ) at source
  unfold forcingDeterminant
  push_cast at source ⊢
  linear_combination -source

/-- Positivity is an output of actual nonzero original K and B sources, never an inverse constructor premise. -/
theorem actual_forcing_determinant_pos : 0<forcingDeterminant c := by
  have damping:=sourceDamping_pos c
  have kernel:generatedK c≠0:=generated_kernel_ne_zero observation nontrivial half.down
  have power:=powerCorrection_ne_zero (barC c)
  have km:0<‖generatedK c‖^2:=sq_pos_of_ne_zero (norm_ne_zero_iff.mpr kernel)
  have pm:0<‖hPowerPhysicalCorrection (barC c)‖^2:=sq_pos_of_ne_zero (norm_ne_zero_iff.mpr power)
  unfold forcingDeterminant
  positivity

private theorem determinant_ne_zero : ((forcingDeterminant c : ℝ) : ℂ)≠0 :=
  Complex.ofReal_ne_zero.mpr (actual_forcing_determinant_pos observation nontrivial half).ne'

/-- The c/barc responses are eliminated by the complete same-source forcing loop and its source-paid determinant. -/
theorem actual_forcing_response : forcingResponse c=u c := by
  unfold forcingResponse
  simp only [actual_calculated_forcing]
  change ((forcingDeterminant c : ℝ) : ℂ)⁻¹ • wholeLoop c=u c
  rw [actual_source_loop observation nontrivial half,actual_forcing_determinant observation nontrivial half,
    smul_smul,inv_mul_cancel₀ (determinant_ne_zero observation nontrivial half),one_smul]

theorem actual_forcing_input : forcingInput c=
    (OriginalWholeDebtRJointMobiusRActionSource.sourceInput observation nontrivial half : BurnolL2) := by
  rw [forcingInput,actual_forcing_response observation nontrivial half]
  rfl

/-- The original source-next read is produced by this literal new R action; no actor/cofinal admission is asserted. -/
theorem actual_forcing_next : forcingNext c=
    OriginalWholeDebtRJointMobiusRActionSource.sourceNext observation nontrivial half := by
  rw [forcingNext,actual_forcing_input observation nontrivial half]
  rfl

/-- The existing independent original-R consumer keeps the whole physical/B next. -/
theorem actual_forcing_whole_next : forcingNext c=
    (burnolEvenAmbientProjection (forcingNext c) : BurnolL2)+
      (2*OriginalNextEndpointProgramme.programmePrice c (Real.log stageZeroSonineQ)) •
        OriginalKCrossParameterRAdjointSource.PhysicalOutsideSource.physicalOutsideColumn c := by
