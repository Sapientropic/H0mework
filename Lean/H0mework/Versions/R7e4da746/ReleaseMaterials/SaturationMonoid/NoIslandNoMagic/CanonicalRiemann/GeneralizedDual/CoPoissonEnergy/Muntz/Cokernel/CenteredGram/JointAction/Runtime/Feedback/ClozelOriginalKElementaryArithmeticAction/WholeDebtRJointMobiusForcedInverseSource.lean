/-- This mass is generated by the original two full B-power/K actions. -/
def forcingDeterminant (c : BurnolCompletedMellinCoordinate) : ℝ :=
  4*(sourceDamping c)^2*‖generatedK c‖^2*‖hPowerPhysicalCorrection (barC c)‖^2

/-- The complete forcing consumes the finite native calculation and the same actual outside contact field. -/
def calculatedForcing (c : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  (coupling c*(OriginalWholeDebtRJointMobiusSource.character c-
    OriginalWholeDebtRJointMobiusSource.character (barC c))) • F (generatedK (barC c))-
    coupling c • F (OriginalKPairedBEulerJunctionSource.BandFullStockEuler.correctionRaw (barC c))+
    (OriginalWholeDebtRPowerWaveDilationSource.damping c : ℂ) •
      OriginalWholeDebtRPowerWaveDilationSource.pairedSource c OriginalKPairedBEulerJunctionSource.junctionShift+
    (1/2 : ℂ) •
      (OriginalWholeDebtRJointMobiusContactPsiPriceSource.nativeGamma c (barC c) • F (generatedK (barC c))+
        OriginalKCombPhysicalAction.physicalRemainder (OriginalWholeDebtRAdjointContactSource.sourceEffect c (barC c)))+
    coupling c • F (correctionInput (barC c))-sourceAdjointCayley (barC c) (correctionInput c)

/-- Every signed contact and both mean fields remain in the same full source. -/
theorem actual_calculated_forcing (c : BurnolCompletedMellinCoordinate) :
    calculatedForcing c=coupledForcing c := by
  have projected:=OriginalWholeDebtRJointMobiusContactPsiPriceSource.actual_calculated_input c (barC c)
  change P (OriginalWholeDebtRAdjointContactSource.sourceEffect c (barC c))=_ at projected
  have whole : OriginalWholeDebtRAdjointContactSource.sourceEffect c (barC c)=
      P (OriginalWholeDebtRAdjointContactSource.sourceEffect c (barC c))+
        OriginalKCombPhysicalAction.physicalRemainder (OriginalWholeDebtRAdjointContactSource.sourceEffect c (barC c)) := by
    have outside : OriginalKCombPhysicalAction.physicalRemainder (OriginalWholeDebtRAdjointContactSource.sourceEffect c (barC c))=
        OriginalWholeDebtRAdjointContactSource.sourceEffect c (barC c)-P (OriginalWholeDebtRAdjointContactSource.sourceEffect c (barC c)) :=
      Submodule.starProjection_orthogonal_val _
    rw [outside]
    module
  rw [projected] at whole
  unfold calculatedForcing coupledForcing
  rw [←whole]
  rfl

/-- The complete original forcing fields enter before the actual U/F inverse is taken. -/
def forcingResponse (c : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  ((forcingDeterminant c : ℝ) : ℂ)⁻¹ •
    (coupling c • F (calculatedForcing (barC c))+sourceCayley (barC c) (calculatedForcing c))

def forcingInput (c : BurnolCompletedMellinCoordinate) : BurnolL2 := F (forcingResponse c)

/-- Literal original R executes the newly generated full forcing input. -/
def forcingNext (c : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  burnolDirectRightResolventCLM c (forcingInput c)

variable (observation : GeneratedRiemannZeroObservation)
