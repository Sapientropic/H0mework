local notation "native" => WN.native observation nontrivial half depth ordinal

abbrev sourceRoot := (Action.actualTarget observation nontrivial half depth ordinal).targetRoot
abbrev sourceVisit := (Action.actualTarget observation nontrivial half depth ordinal).targetVisit

noncomputable def childCode : Expr C.Value C.Var () := Prog.waveCode c Prog.fixedShift

/-- The R/debt/subtraction cuts retain the original scaled wave and its actual history. -/
noncomputable def originalChild : Trace.SourceReceipt trace (childCode observation nontrivial half) := by
  let r := Trace.splitLinear trace
  let debt := Trace.splitAdd r.trace
  let wave := Trace.splitAdd debt.leftTrace
  exact ⟨wave.leftValue, wave.leftTrace, .linear r (.left debt (.left wave (.refl _)))⟩

theorem original_child_address :
    (originalChild observation nontrivial half depth).retained.address = [2, 0, 0] := rfl

noncomputable def sourceScale : ℂ := sourceFactor Prog.fixedShift

theorem source_scale_actual : sourceScale = -(Real.exp (Prog.fixedShift / 4) : ℂ) / 2 := rfl

theorem original_value : (originalChild observation nontrivial half depth).value = sourceScale •
    (OriginalRieszFinitePairing.CoPoisson.positionWave c Prog.fixedShift +
      fourierL2 (OriginalRieszFinitePairing.CoPoisson.fourierWave c Prog.fixedShift)) :=
  (originalChild observation nontrivial half depth).trace.sound.symm

private theorem first_positive : 0 < (PT.words trace).length := by
  rw [PT.complete_steps, (trace).length_to_const]
  change 0 < _ + 1
  omega

private noncomputable def firstIndex : Fin (PT.words trace).length :=
  ⟨0, first_positive observation nontrivial half depth⟩

private noncomputable def originalWord : Formal ℤ C.Value C.Var () :=
  (PT.words trace).get (firstIndex observation nontrivial half depth)

/-- The whole-debt occurrence is inside the complete original inventory, before the later power-wave programme. -/
private noncomputable def originalSegment : SourceInventoryTraceSegment (PT.exposure trace)
    (C.sourcePaidInventory observation nontrivial depth half) :=
  (SourceInventoryTraceSegment.right
    (C.priorSourceCalculationInventory observation nontrivial depth half) (PT.exposure trace)).trans
    ((SourceInventoryTraceSegment.left
      (C.wholeDebtRCalculationInventory observation nontrivial depth half)
      (PT.exposure (C.wholeDebtRWaveSourceTrace observation nontrivial depth half))).trans
      ((C.sourceCalculationPriorSegment observation nontrivial depth half).trans
        (SourceInventoryTraceSegment.right
          (PT.exposure (C.receipt observation nontrivial depth half).2.1.2)
          (C.sourceCalculationInventory observation nontrivial depth half))))

private noncomputable def originalPoint : WR.RelationOccurrence (C.sourcePaidInventory observation nontrivial depth half) :=
  (PT.stepOccurrence trace (firstIndex observation nontrivial half depth)).transport
    (originalSegment observation nontrivial half depth)

private noncomputable def initialPoint : WR.RelationOccurrence (Born.initialStock observation nontrivial half depth) := by
  let original := originalPoint observation nontrivial half depth
  let block := initialBlock observation nontrivial depth half
  let lift := ActualCofinalSourceAction.T.liftEvent (W := C.Value) (X := C.Var) (s := ())
  refine ⟨block.before ++ original.before.map lift, liftMap original.word,
    original.after.map lift ++ block.after, ?_⟩
  have mapped := congrArg (List.map lift) original.trace_eq
  simp only [List.map_append, List.map_cons] at mapped
  exact block.trace_eq.trans
    ((congrArg (fun middle => block.before ++ middle ++ block.after) mapped).trans (by
      simp only [List.cons_append, List.append_assoc]
      rfl))

private noncomputable def pointAt : (tick : Nat) →
    WR.RelationOccurrence (stockAt observation nontrivial half depth tick)
  | 0 => initialPoint observation nontrivial half depth
  | tick + 1 => reindexPoint
      (A.actual_next_packet factory (D.initial observation nontrivial half depth)
        (D.firstCfg observation nontrivial half depth) rfl tick).symm _
      (languagePoint (packet tick).2.2.2.down (A.sourceBorn factory (packet tick)) _
        (SR.born factory (packet tick) (stockAt observation nontrivial half depth tick)
          (stock_inventory observation nontrivial half depth tick) (pointAt tick)))

private theorem point_word (tick : Nat) :
    (pointAt observation nontrivial half depth tick).word =
      R.wordMapAt observation nontrivial half depth tick (originalWord observation nontrivial half depth) := by
  induction tick with
  | zero => rfl
  | succ tick previous =>
      dsimp only [pointAt]
      rw [reindexPoint_word, languagePoint_word, SR.born_word, previous]
      rfl

private noncomputable def nativeOccurrence : WR.RelationOccurrence (WN.oldStock native) :=
  nativePoint factory (packet (ordinal + 1)) (stockAt observation nontrivial half depth (ordinal + 1))
    (stock_inventory observation nontrivial half depth (ordinal + 1))
    (pointAt observation nontrivial half depth (ordinal + 1))

private noncomputable def originalOccurrence : WR.RelationOccurrence (WN.beforeStock native) :=
  WN.relationTransport (AS.bornAfterNative native).2.2.2.down.symm
    (nativeOccurrence observation nontrivial half depth ordinal)

private theorem original_word : (originalOccurrence observation nontrivial half depth ordinal).word =
    A.wordTransport (AS.bornAfterNative native).2.2.2.down.symm
      (NW.admissionWord factory (packet (ordinal + 1))
        (liftMap (R := ℤ) (R.wordMapAt observation nontrivial half depth (ordinal + 1)
          (originalWord observation nontrivial half depth)))) := by
  rw [originalOccurrence, relationTransport_word, nativeOccurrence, nativePoint_word, point_word]

noncomputable def currentAdmissions : type_of% (Root.rootAdmissions observation nontrivial half depth ordinal) :=
  (Action.actualOriginFace observation nontrivial half depth ordinal).rootRead.source.occurrences

private theorem projection_admissions_source : type_of% (retained_read
    (Action.sourceRoot observation nontrivial half depth ordinal)
    (Action.sourceVisit observation nontrivial half depth ordinal)
    (Action.sourceU7 observation nontrivial half depth ordinal)
    (Action.sourceCalculus observation nontrivial half depth ordinal)
    (Action.sourceReader observation nontrivial half depth ordinal)
    (Action.originFace observation nontrivial half depth ordinal)
    (fun payload => payload.source.occurrences)) :=
  retained_read
    (Action.sourceRoot observation nontrivial half depth ordinal)
    (Action.sourceVisit observation nontrivial half depth ordinal)
    (Action.sourceU7 observation nontrivial half depth ordinal)
    (Action.sourceCalculus observation nontrivial half depth ordinal)
    (Action.sourceReader observation nontrivial half depth ordinal)
    (Action.originFace observation nontrivial half depth ordinal)
    (fun payload => payload.source.occurrences)

private theorem r_admissions_source : type_of% (congrArg (fun payload => payload.source.occurrences)
    (eq_of_heq (OriginalKOutsideCorrectionRAction.target_source_payload observation nontrivial half depth ordinal))) :=
  congrArg (fun payload => payload.source.occurrences)
    (eq_of_heq (OriginalKOutsideCorrectionRAction.target_source_payload observation nontrivial half depth ordinal))

private theorem current_admissions_source : currentAdmissions observation nontrivial half depth ordinal =
    Root.rootAdmissions observation nontrivial half depth ordinal :=
  (projection_admissions_source observation nontrivial half depth ordinal).trans
    ((r_admissions_source observation nontrivial half depth ordinal).trans
      (OriginalKOutsideCorrectionRSource.final_admissions_source observation nontrivial half depth ordinal))

attribute [local irreducible] currentAdmissions AS.nativeAfterAdmission physicalValue

noncomputable def retainedSlot : Fin (currentAdmissions observation nontrivial half depth ordinal).length :=
  Fin.cast (congrArg List.length (current_admissions_source observation nontrivial half depth ordinal)).symm
    (Root.rootSlot observation nontrivial half depth ordinal)

noncomputable def retainedAdmission : type_of% (Root.rootAdmission observation nontrivial half depth ordinal) :=
  (currentAdmissions observation nontrivial half depth ordinal).get
    (retainedSlot observation nontrivial half depth ordinal)

/-- Each retained occurrence stores the complete ordered source trace, including unselected earlier words. -/
noncomputable def currentHistory : type_of% (WN.beforeStock native).trace :=
  let admitted := retainedAdmission observation nontrivial half depth ordinal
  admitted.1.before ++ .relation admitted.1.word :: admitted.1.after

private theorem current_history_source : currentHistory observation nontrivial half depth ordinal =
    (WN.beforeStock native).trace :=
  (retainedAdmission observation nontrivial half depth ordinal).1.trace_eq.symm

noncomputable def wholeDebtSlot : Fin (currentHistory observation nontrivial half depth ordinal).length :=
  Fin.cast (congrArg List.length (current_history_source observation nontrivial half depth ordinal)).symm
    (occurrenceIndex (originalOccurrence observation nontrivial half depth ordinal))

noncomputable def wholeDebtWord : type_of% (originalOccurrence observation nontrivial half depth ordinal).word :=
  eventWord ((currentHistory observation nontrivial half depth ordinal).get
    (wholeDebtSlot observation nontrivial half depth ordinal))

private theorem whole_debt_word_source : wholeDebtWord observation nontrivial half depth ordinal =
    (originalOccurrence observation nontrivial half depth ordinal).word :=
  congrArg eventWord ((get_cast (currentHistory observation nontrivial half depth ordinal)
    (WN.beforeStock native).trace (current_history_source observation nontrivial half depth ordinal)
    (occurrenceIndex (originalOccurrence observation nontrivial half depth ordinal))).trans
      (occurrence_read (originalOccurrence observation nontrivial half depth ordinal)))

/-- The current root's fixed whole-debt Step supplies the scaled original two-wave child. -/
noncomputable def waveValue : BurnolL2 :=
  physicalValue (AS.bornAfterNative native).1
    (decodeMap (remaining raw) wavePath (wholeDebtWord observation nontrivial half depth ordinal))

private theorem child_syntax : childAt wavePath raw = childCode observation nontrivial half := rfl

theorem wave_value_source : waveValue observation nontrivial half depth ordinal =
    (originalChild observation nontrivial half depth).value := by
  have word := (whole_debt_word_source observation nontrivial half depth ordinal).trans
    (original_word observation nontrivial half depth ordinal)
  refine (congrArg (fun item => physicalValue (AS.bornAfterNative native).1
    (decodeMap (remaining raw) wavePath item)) word).trans ?_
  refine (physical_native_word (remaining raw) wavePath factory (packet (ordinal + 1))
    (R.wordMapAt observation nontrivial half depth (ordinal + 1)
      (originalWord observation nontrivial half depth))).trans ?_
  refine (physical_word observation nontrivial half depth (remaining raw) wavePath
    (originalWord observation nontrivial half depth) (ordinal + 1)).trans ?_
  refine (first_word_decode wavePath trace (first_positive observation nontrivial half depth)).trans ?_
  rw [child_syntax]
  exact (originalChild observation nontrivial half depth).trace.sound

noncomputable def waveTrace : Trace (C.receipt observation nontrivial depth half).1.environment
    (childCode observation nontrivial half) (.const (waveValue observation nontrivial half depth ordinal)) :=
  Eq.mp (congrArg (fun point => Trace (C.receipt observation nontrivial depth half).1.environment
    (childCode observation nontrivial half) (.const point))
      (wave_value_source observation nontrivial half depth ordinal).symm)
    (originalChild observation nontrivial half depth).trace

theorem wave_trace_source : type_of% (mp_heq
    (congrArg (fun point => Trace (C.receipt observation nontrivial depth half).1.environment
      (childCode observation nontrivial half) (.const point))
        (wave_value_source observation nontrivial half depth ordinal).symm)
    (originalChild observation nontrivial half depth).trace) :=
  mp_heq _ _

theorem wave_value : waveValue observation nontrivial half depth ordinal = sourceScale •
    (OriginalRieszFinitePairing.CoPoisson.positionWave c Prog.fixedShift +
      fourierL2 (OriginalRieszFinitePairing.CoPoisson.fourierWave c Prog.fixedShift)) :=
  (wave_value_source observation nontrivial half depth ordinal).trans
    (original_value observation nontrivial half depth)

