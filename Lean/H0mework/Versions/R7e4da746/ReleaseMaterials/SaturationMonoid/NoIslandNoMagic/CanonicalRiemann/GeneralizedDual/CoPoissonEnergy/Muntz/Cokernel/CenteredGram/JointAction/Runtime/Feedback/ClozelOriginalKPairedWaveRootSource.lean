private theorem retained_read {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (sourceRoot : SourceNativeLivingRootClosure N V)
    (sourceVisit : SourceNativeTemporalVisitAt sourceRoot.toAuthoritativeRoot.toLedgerRoot)
    (sourceU7 : U7ProducerCalculus N) (sourceCalculus : U7ObstructionEvolutionCalculus N sourceU7)
    {Sorts : Type u} {Value Var : Sorts → Type u} [∀ sort, AddCommGroup (Value sort)] {sort : Sorts}
    (reader : sourceRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.actual.OccurrenceAt
      sourceVisit.current → RootGeneratedDebtActivationJointSource.OwnerFree.Raw
        (Value := Value) (Var := Var) (sort := sort))
    (face : RootInquiryCompletion.SourceNativeRootSemanticFaceAt sourceRoot sourceVisit)
    {Z : Sort v} (read : face.Restriction → Z) :
    read (targetSourceFace sourceRoot sourceVisit sourceU7 sourceCalculus reader face).rootRead =
      read face.rootRead := rfl

local instance levelGroups (grade : Nat) (target : Unit) :
    AddCommGroup (L.Value (PairValue C.Value) grade target) := L.groups (PairValue C.Value) grade target
local instance lowGroups : ∀ target, AddCommGroup (L.Value C.Value 0 target) := L.groups C.Value 0
local instance firstPairGroups : ∀ target, AddCommGroup (PairValue (L.Value C.Value 0) target) :=
  L.groups C.Value 1

private noncomputable def wavePath : List Bool := [false, false, false]

private noncomputable def occurrenceIndex {V Y : Unit → Type} [∀ t, AddCommGroup (V t)]
    {source : SourceInventoryExecutionFeed.Inventory (V := V) (X := Y) (s := ())}
    (point : WR.RelationOccurrence source) : Fin source.trace.length :=
  ⟨point.before.length, by rw [point.trace_eq, List.length_append, List.length_cons]; omega⟩

private theorem occurrence_read {V Y : Unit → Type} [∀ t, AddCommGroup (V t)]
    {source : SourceInventoryExecutionFeed.Inventory (V := V) (X := Y) (s := ())}
    (point : WR.RelationOccurrence source) :
    source.trace.get (occurrenceIndex point) = .relation point.word := by
  simp only [List.get_eq_getElem, occurrenceIndex, point.trace_eq]
  simp

private noncomputable def eventWord {V Y : Unit → Type} [∀ t, AddCommGroup (V t)] :
    SourceInventoryExecutionFeed.Event (V := V) (X := Y) (s := ()) → Formal ℤ V Y ()
  | .relation word => word
  | .generator _ => 0

private theorem relationTransport_word {V Y Z : Unit → Type} [∀ t, AddCommGroup (V t)]
    (same : Y = Z) {source : SourceInventoryExecutionFeed.Inventory (V := V) (X := Y) (s := ())}
    (point : WR.RelationOccurrence source) :
    (WN.relationTransport same point).word = A.wordTransport same point.word := by
  cases same
  rfl

