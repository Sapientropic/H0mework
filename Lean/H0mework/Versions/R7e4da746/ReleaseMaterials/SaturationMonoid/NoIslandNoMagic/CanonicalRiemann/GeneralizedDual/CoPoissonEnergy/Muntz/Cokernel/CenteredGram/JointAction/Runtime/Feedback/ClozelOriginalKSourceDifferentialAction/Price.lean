variable {W X : Unit→Type} [∀ target,AddCommGroup (W target)]
local instance priceGroups (grade : Nat) : ∀ target,AddCommGroup (L.Value W grade target) := L.groups W grade
variable (mother : SF.Factory W X ())
variable (packet : AS.AdmissionPacket (W:=W) (X:=X) (s:=()))

/-- The actual installed trace factory retains every environmental/syntax source node and all prior source roles. -/
def actualDifferentialRecovered := sourceRecoveredDifferential (sourceDifferentialTraceFactory mother) packet

def actualDifferentialWholeTotal := sourceDifferentialWholeTotal (sourceDifferentialTraceFactory mother) packet

def actualDifferentialInherited := sourceDifferentialInheritedEffect (sourceDifferentialTraceFactory mother) packet

/-- An independent additive observer sees both the recovered mother variation and the genuine inherited native fee. -/
theorem source_whole_observer_full_fees {Result : Type} [AddCommGroup Result]
 (read : PairValue (L.Value W packet.1) ()→+Result) :
 read (actualDifferentialWholeTotal mother packet)=
 read (actualDifferentialRecovered mother packet)+read (actualDifferentialInherited mother packet) :=
 (congrArg read (source_whole_differential_partition (sourceDifferentialTraceFactory mother) packet)).trans
 (map_add read _ _)

/-- The complete original source total is reconstructed from the actual whole's received before/change feet. -/
theorem source_whole_recovers_same_mother :
 (actualDifferentialRecovered mother packet).1+(actualDifferentialRecovered mother packet).2=
 (I.nextRawAt (A.epoch packet.2.1.1) (S.actualOccurrence packet.2.1.1)).expression.eval
 (I.nextRawAt (A.epoch packet.2.1.1) (S.actualOccurrence packet.2.1.1)).environment :=
 (congrArg (fun value : PairValue (L.Value W packet.1) ()=>value.1+value.2)
  (source_recovered_differential_actual_change (sourceDifferentialTraceFactory mother) packet)).trans
 (by dsimp only [Prod.fst,Prod.snd]; abel)

/-- Both original source roles are recovered from its actual whole; no readout identity chooses an occurrence. -/
theorem source_whole_registered_faces : type_of%
 (source_recovered_differential_actual_change (sourceDifferentialTraceFactory mother) packet) :=
 source_recovered_differential_actual_change _ _

