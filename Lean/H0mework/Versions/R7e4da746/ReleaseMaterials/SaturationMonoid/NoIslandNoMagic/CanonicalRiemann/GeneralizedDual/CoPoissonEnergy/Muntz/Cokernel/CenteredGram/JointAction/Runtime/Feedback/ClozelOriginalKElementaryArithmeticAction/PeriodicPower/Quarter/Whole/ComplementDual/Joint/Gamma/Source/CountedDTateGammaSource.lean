/-- The actual original unit Gamma field and original first-Tate conductor are recognized before the ordinary zero is transported through their true q scale. -/
private theorem same_tate_seed :
    GammaPair (T ConstantDual.value) (T dualFirstConductor) := by
  have same:T dualFirstConductor=tateFirstStrongConductor := by
    rw [←countedTateSeedPaid% dual_first_conductor_readback,burnolTateReciprocalL2_involutive]
  rw [same]
  exact original_tate_strong_conductor

private theorem tate_radial (t:ℝ) (v:BurnolL2) :
    T (radialOrbit t v)=(Real.exp (Real.log (4*t)/2):ℂ) •
      burnolMultiplicativeDilation (Real.log (4*t)) (T v) := by
  rw [radialOrbit,map_smul]
  exact congrArg (fun v:BurnolL2=>(Real.exp (Real.log (4*t)/2):ℂ) • v)
    (burnolTateReciprocalL2_dilation_inverse (Real.log (4*t)) v).symm

private theorem same_tate_radial_Gamma (t:ℝ) :
    GammaPair (T (radialOrbit t ConstantDual.value))
      (T (radialOrbit t dualFirstConductor)) := by
  have source:=(phiGammaPaid% gamma_pair_dilation) (Real.log (4*t)) _ _ same_tate_seed
  intro test
  rw [tate_radial,tate_radial,inner_smul_right,inner_smul_right,source test]

private theorem same_tate_b_integral_Gamma (c:BurnolCompletedMellinCoordinate) :
    GammaPair (T (bSynthesis c ConstantDual.value))
      (T (bSynthesis c dualFirstConductor)) := by
  have vd:IntegrableOn (fun t:ℝ=>sourceRawDerivative c t • radialOrbit t ConstantDual.value) (Ioc 0 q) :=
    (phiGammaPaid% radial_integrable) _ measurableSet_Ioc Ioc_subset_Ioi_self _
      (source_slope_measurable c) (b_weighted_slope_integrable c) _
  have gd:IntegrableOn (fun t:ℝ=>sourceRawDerivative c t • radialOrbit t dualFirstConductor) (Ioc 0 q) :=
    (phiGammaPaid% radial_integrable) _ measurableSet_Ioc Ioc_subset_Ioi_self _
      (source_slope_measurable c) (b_weighted_slope_integrable c) _
  intro test
  change inner ℂ (wholeConductorTest test)
      (T (∫ t:ℝ in Ioc 0 q,sourceRawDerivative c t • radialOrbit t ConstantDual.value))=
    inner ℂ (test.toLp 2 volume)
      (T (∫ t:ℝ in Ioc 0 q,sourceRawDerivative c t • radialOrbit t dualFirstConductor))
  rw [←burnolTateReciprocalL2.integral_comp_comm vd,←burnolTateReciprocalL2.integral_comp_comm gd]
  have left:=(innerSL ℂ (wholeConductorTest test)).integral_comp_comm (burnolTateReciprocalL2.integrable_comp vd)
  have right:=(innerSL ℂ (test.toLp 2 volume)).integral_comp_comm (burnolTateReciprocalL2.integrable_comp gd)
  simp only [innerSL_apply_apply] at left right
  rw [←left,←right]
  apply integral_congr_ae
  filter_upwards with t
  rw [map_smul,map_smul,inner_smul_right,inner_smul_right,same_tate_radial_Gamma t test]

/-- The actual Tate constant-count seed and the original b radial integral generate this specific complete Gamma/T reaction. -/
theorem actual_original_counted_D_Tate_complete_Gamma_source (c:BurnolCompletedMellinCoordinate) :
    GammaPair (T (CountingDual.value c)) (T (actualDGamma c)) := by
  rw [←(ordinaryDWholePaid% original_b_first) c,(GammaDIdentityPaid% actual_D_gamma_same_native_seed) c]
  have integralSource:=same_tate_b_integral_Gamma c
  intro test
  simp only [originalBSynthesis,sub_apply,smul_apply,ContinuousLinearMap.id_apply,
    map_sub,map_smul,inner_sub_right,inner_smul_right]
  rw [same_tate_seed test,integralSource test]
  rfl

end
