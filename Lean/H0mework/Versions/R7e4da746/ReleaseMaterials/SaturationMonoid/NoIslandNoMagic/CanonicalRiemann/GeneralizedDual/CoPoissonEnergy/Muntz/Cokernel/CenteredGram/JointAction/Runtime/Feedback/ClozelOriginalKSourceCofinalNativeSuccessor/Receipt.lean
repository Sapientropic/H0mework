private theorem receipt_raw_preserved
 {Value Var : Unit→Type} [∀ target,AddCommGroup (Value target)]
 (cfg : A.Programme (PhysicalValue:=Value) (PhysicalVar:=Var) (sort:=()))
 (initial : M.Frame (Value:=Value) (Var:=Var) (sort:=())) :
 (SourceOperationInquiry.Context.Faces.Execution.Activation.Shared.Completion.atReceipt cfg initial 0).rawRead=initial.rawRead := by
 apply Prefix.receipt_read cfg initial (fun offset=>(Frames.frames initial cfg offset).rawRead)
 intro offset paid actual
 have step : Frames.frames initial cfg (offset+1)=(Frames.frames initial cfg offset).mathNext := by
  change Frames.next _ _=_
  unfold Frames.next
  rw [actual]
 exact (congrArg (fun next : M.Frame (Value:=Value) (Var:=Var) (sort:=())=>next.rawRead) step).trans rfl

/-- The native receipt reads this original runtime packet's own cfg and source material. -/
theorem source_actual_receipt_endpoint :
 Native.nativeValue fixedFactory packet=
 (N.expression (R.actualMaterial packet.2.1.1 packet.2.2.1)).eval
 (N.input (R.actualMaterial packet.2.1.1 packet.2.2.1)).environment := by
 have paid:=SourceOperationExecutionDebt.completed_value
  (Native.selected fixedFactory packet).event.state (Native.receipt fixedFactory packet).2.1
 change Native.nativeValue fixedFactory packet=
  (Native.selected fixedFactory packet).rawRead.expression.eval
   (Native.selected fixedFactory packet).rawRead.environment at paid
 have unchanged : (Native.selected fixedFactory packet).rawRead=
 (Native.nativePacket fixedFactory packet).2.1.1.rawRead :=
  receipt_raw_preserved (AS.stockCfg (Native.nativePacket fixedFactory packet).2.2.1)
   (Native.nativePacket fixedFactory packet).2.1.1
 exact paid.trans (congrArg (fun raw=>raw.expression.eval raw.environment) unchanged)

/-- The complete old paid source and actual receipt total are generated by the original material's actual update. -/
theorem source_actual_native_total :
 WB.oldPaid packet.2.1.1 packet.2.2.1+Native.nativeValue fixedFactory packet=
 (R.actualMaterial packet.2.1.1 packet.2.2.1).raw.eval
 (N.input (R.actualMaterial packet.2.1.1 packet.2.2.1)).environment := by
 have native:=(source_actual_receipt_endpoint fixedFactory packet).trans
  (WB.native_value packet.2.1.1 packet.2.2.1
   (AS.write fixedFactory packet.1 packet.2.1 packet.2.2.1 packet.2.2.2.down)).symm
 exact (congrArg (fun value=>WB.oldPaid packet.2.1.1 packet.2.2.1+value) native).trans
  (WB.updated_total packet.2.1.1 packet.2.2.1 _)

/-- The existing native writer consumes that source total at the same actual birth. -/
theorem source_actual_born_write :
 (Native.sourceBorn fixedFactory packet).2.1.1.activeEnvironment=
 AS.write fixedFactory packet.1 packet.2.1 packet.2.2.1 packet.2.2.2.down
 ((R.actualMaterial packet.2.1.1 packet.2.2.1).raw.eval
 (N.input (R.actualMaterial packet.2.1.1 packet.2.2.1)).environment) := by
 rw [←source_actual_native_total fixedFactory packet]
 exact Native.born_environment fixedFactory packet

