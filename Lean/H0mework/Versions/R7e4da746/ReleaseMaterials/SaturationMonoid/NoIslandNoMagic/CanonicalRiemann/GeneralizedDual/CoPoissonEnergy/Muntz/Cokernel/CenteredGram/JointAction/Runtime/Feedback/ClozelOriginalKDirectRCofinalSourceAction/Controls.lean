/-- The two decoder reads are applied to the actual face image at this canonical born E-read. -/
def BornCofinalFaceAt : Prop :=
 CanonicalBornSourceAt observation nontrivial half depth ordinal ∧
 type_of% (actual_source_root observation nontrivial half depth (ordinal+1)) ∧
 type_of% (actual_source_trace observation nontrivial half depth (ordinal+1)) ∧
 type_of% (actual_whole_paid_trace observation nontrivial half depth (ordinal+1)) ∧
 type_of% (actual_source_input observation nontrivial half depth (ordinal+1)) ∧
 type_of% (actual_source_point_from_packet observation nontrivial half depth (ordinal+1)) ∧
 type_of% (actual_cofinal_injective observation nontrivial half depth (ordinal+1)) ∧
 (∀ stage,type_of% (actual_cofinal_window_read observation nontrivial half depth (ordinal+1) stage)) ∧
 type_of% (actual_cofinal_source_successor observation nontrivial half depth ordinal) ∧
 (∀ stage,type_of% (actual_window_transition_successor observation nontrivial half depth ordinal stage)) ∧
 type_of% (actual_face_image_value observation nontrivial half depth (ordinal+1)) ∧
 (Window.sourceDecoder (actualFaceImage observation nontrivial half depth (ordinal+1))).val=PA.E (PC.bornRead observation nontrivial half depth ordinal) ∧
 Window.inverseSourceDecoder (actualFaceImage observation nontrivial half depth (ordinal+1))=burnolMobiusSourceL2 (PA.E (PC.bornRead observation nontrivial half depth ordinal)) ∧
 type_of% (actual_face_decoder_successor observation nontrivial half depth ordinal) ∧
 type_of% (actual_face_inverse_decoder_successor observation nontrivial half depth ordinal)

def InheritedBornAt : Prop :=
 type_of% (OriginalKDirectRCofinalPaUpdate.source_correction_memPa observation nontrivial half depth ordinal) ∧ type_of% (OriginalKDirectRCofinalPaUpdate.source_correction_finite_source observation nontrivial half depth ordinal) ∧
 PC.BornPaFaceAt observation nontrivial half depth ordinal ∧
 type_of% (OriginalKDirectRCofinalResidual.actual_residual_successor observation nontrivial half depth ordinal) ∧
 type_of% (OriginalKDirectRCofinalResidual.actual_residual_inventory observation nontrivial half depth ordinal) ∧
 type_of% (OriginalKDirectRCofinalResidual.actual_reentry_successor observation nontrivial half depth ordinal) ∧
 type_of% (OriginalKDirectRCofinalDivision.actual_original_K_read observation nontrivial half depth ordinal) ∧
 type_of% (OriginalKDirectRCofinalDivision.actual_original_FourierK_read observation nontrivial half depth ordinal) ∧
 type_of% (OriginalKDirectRCofinalDivision.actual_Q_complete_gram observation nontrivial half depth ordinal) ∧
 type_of% (Prior.RC.original_whole (Prior.D.factory observation nontrivial half) (Prior.D.initial observation nontrivial half depth) (Prior.D.firstCfg observation nontrivial half depth) rfl (ordinal+1)) ∧
 type_of% (Prior.RC.actual_generated_current (Prior.D.factory observation nontrivial half) (Prior.D.initial observation nontrivial half depth) (Prior.D.firstCfg observation nontrivial half depth) rfl (ordinal+1)) ∧
 type_of% (Prior.consumed_request_source observation nontrivial half depth ordinal) ∧
 type_of% (OriginalKDirectRCofinalMaterial.actual_native_value observation nontrivial half depth ordinal) ∧
 type_of% (OriginalKDirectRCofinalMaterial.actual_successor observation nontrivial half depth ordinal)

theorem actual_canonical_born_source : CanonicalBornSourceAt observation nontrivial half depth ordinal := actual_born_source_projection observation nontrivial half depth ordinal

theorem window_stage_independent_of_time (firstStage secondStage : Nat) :
 CanonicalBornSourceAt observation nontrivial half depth ordinal ∧
 type_of% (actual_cofinal_window_read observation nontrivial half depth (ordinal+1) firstStage) ∧
 type_of% (actual_cofinal_window_read observation nontrivial half depth (ordinal+1) secondStage) :=
 ⟨actual_born_source_projection observation nontrivial half depth ordinal,actual_cofinal_window_read observation nontrivial half depth (ordinal+1) firstStage,actual_cofinal_window_read observation nontrivial half depth (ordinal+1) secondStage⟩

theorem actual_value_in_both_decoders :
 type_of% (actual_face_image_value observation nontrivial half depth (ordinal+1)) ∧
 type_of% (actual_face_decoder observation nontrivial half depth (ordinal+1)) ∧
 type_of% (actual_face_inverse_decoder observation nontrivial half depth (ordinal+1)) :=
 ⟨actual_face_image_value observation nontrivial half depth (ordinal+1),actual_face_decoder observation nontrivial half depth (ordinal+1),actual_face_inverse_decoder observation nontrivial half depth (ordinal+1)⟩

theorem nonPa_has_no_qualified_source (value : BurnolPaAmbientCarrier)
 (nonPa : value∉burnolCompactCoPoissonClosedRange.toSubmodule) :
 ¬∃ source : Window.PaSourceCarrier,source.val=value := by
 rintro ⟨source,same⟩
 exact nonPa (same ▸ source.property)

theorem same_value_does_not_identify_occurrence :
 let first : (Nat × ℂ) := (0,1)
 let second : (Nat × ℂ) := (1,1)
 first.2=second.2 ∧ first≠second := by norm_num

theorem zero_coefficient_keeps_correction_and_reentry
 (zero : Division.sourceCoefficient observation nontrivial half depth ordinal=0) :
 Window.sourceDecoder (actualFaceImage observation nontrivial half depth (ordinal+1))=correctionSource observation nontrivial half depth ordinal+reentrySource observation nontrivial half depth ordinal := by
 have generated:=actual_face_decoder_successor observation nontrivial half depth ordinal
 rw [zero,zero_smul,add_zero] at generated
 exact generated

theorem zero_reentry_keeps_Ewhole_unit
 (zero : reentrySource observation nontrivial half depth ordinal=0) :
 Window.sourceDecoder (actualFaceImage observation nontrivial half depth (ordinal+1))=correctionSource observation nontrivial half depth ordinal+
 Division.sourceCoefficient observation nontrivial half depth ordinal • wholeUnitSource observation nontrivial half := by
 have generated:=actual_face_decoder_successor observation nontrivial half depth ordinal
 rw [zero,add_zero] at generated
 exact generated

private theorem source_point_raw :
 (actualPaSource observation nontrivial half depth (ordinal+1)).val=
 PA.E (D.raw observation nontrivial half depth (ordinal+1)) := rfl

private theorem decode_born (image : LinearMap.range Window.sourceCompletionMap.hom)
 (point : Window.PaSourceCarrier) (raw born : BurnolL2)
 (pointRaw : point.val=PA.E raw) (same : born=raw)
 (decode : Window.sourceDecoder image=point)
 (inverse : Window.inverseSourceDecoder image=burnolMobiusSourceL2 point.val) :
 (Window.sourceDecoder image).val=PA.E born ∧
 Window.inverseSourceDecoder image=burnolMobiusSourceL2 (PA.E born) := by
 have read : (Window.sourceDecoder image).val=point.val :=
  congrArg (fun source : Window.PaSourceCarrier=>source.val) decode
 exact ⟨(read.trans pointRaw).trans (congrArg PA.E same.symm),
  (inverse.trans (congrArg burnolMobiusSourceL2 pointRaw)).trans
   (congrArg burnolMobiusSourceL2 (congrArg PA.E same.symm))⟩

set_option maxHeartbeats 2000000 in
/-- The full packet equality identifies the occurrence; the actual face image supplies the decoder reads. -/
theorem actual_born_cofinal_same_whole :
 BornCofinalFaceAt observation nontrivial half depth ordinal ∧ InheritedBornAt observation nontrivial half depth ordinal := by
 refine consume_actual_cofinal_source observation nontrivial half depth ordinal
  (Result:=BornCofinalFaceAt observation nontrivial half depth ordinal ∧ InheritedBornAt observation nontrivial half depth ordinal) ?_
 intro born_projection source_root source_trace source_paid_trace source_input source_point cofinal_injective cofinal_reads cofinal_action window_transitions face_image face_decoder face_inverse_decoder face_action face_inverse_action
  correction_memPa whole_source Pa_source Mobius_source finite_source compressed_source forced_complete unit_rank forced_energy forced_inverse forced_cost residual_successor residual_inventory reentry_successor response_value response_gap response_Q source_R_split Q_successor K_read FourierK_read complete_gram request model compiles whole material_increment material_input native_value native_expression old_paid_code old_paid_branches old_paid_R receipt_zero born_old_paid successor successor_paid_value successor_branches receiver_input receiver_ast native_packet receipt_bound receipt_action receipt_macro_next receipt_compiles born_ast decoder born_inventory born_pair_inventory source_word_inventory actual_next_packet old_events old_pair_events whole_paid_in_born generated_joint_in_born full_paid_steps source_boundary whole_paid_trace actual_inverse actual_effect relation_recovery native_full_trace native_relation_face native_relation_in_born root_generated_current rooted_material_source source_gap source_strong raw_successor next_pair full_history paid_prefix_stocks paid_prefix native_coordinate_zero root_future
 have calculated:=Prior.Full.complete_of_branches observation nontrivial half _ _ successor_branches
 have bornR : PC.bornRead observation nontrivial half depth ordinal=P.R observation nontrivial half (D.raw observation nontrivial half depth ordinal) := calculated.2.2.1
 have raw : PC.bornRead observation nontrivial half depth ordinal=D.raw observation nontrivial half depth (ordinal+1) := bornR.trans raw_successor.symm
 have bornWhole:=raw.trans whole_source
 have samePa:=congrArg PA.E raw
 have bornPa:=samePa.trans Pa_source
 have bornMobius:=(congrArg burnolMobiusSourceL2 samePa).trans Mobius_source
 have forced : PC.bornForcedPa observation nontrivial half depth ordinal=Prior.forcedPaSource observation nontrivial half depth ordinal :=
  congrArg (fun material : BurnolPaAmbientCarrier=>material-PC.actualEReturn observation nontrivial half depth ordinal) samePa
 have bornComplete:=forced.trans forced_complete
 have bornCompressed:=compressed_source.trans forced.symm
 have bornEnergy:=forced_energy
 rw [←forced] at bornEnergy
 have bornCost:=forced_cost
 rw [←forced] at bornCost
 have fibre : ∀ candidate : Prior.Paid.PaSourceCarrier,
  Prior.Paid.compressedR observation nontrivial half candidate=PC.bornForcedPa observation nontrivial half depth ordinal→candidate=Prior.actualPaSource observation nontrivial half depth ordinal :=
  fun candidate produces=>forced_inverse candidate (produces.trans forced)
 have inherited : InheritedBornAt observation nontrivial half depth ordinal := ⟨correction_memPa,finite_source,
  ⟨bornWhole,bornPa,bornMobius,bornComplete,bornCompressed,unit_rank,bornEnergy,fibre,bornCost⟩,
  residual_successor,residual_inventory,reentry_successor,K_read,FourierK_read,complete_gram,
  whole,root_generated_current,Prior.consumed_request_source observation nontrivial half depth ordinal,native_value,successor⟩
 have anchored:=born_projection successor
 have decodedBorn:=decode_born
  (actualFaceImage observation nontrivial half depth (ordinal+1))
  (actualPaSource observation nontrivial half depth (ordinal+1))
  (D.raw observation nontrivial half depth (ordinal+1))
  (PC.bornRead observation nontrivial half depth ordinal)
  (source_point_raw observation nontrivial half depth ordinal) raw face_decoder face_inverse_decoder
 exact ⟨⟨anchored,source_root,source_trace,source_paid_trace,source_input,source_point,cofinal_injective,cofinal_reads,
  cofinal_action,window_transitions,face_image,decodedBorn.1,decodedBorn.2,face_action,face_inverse_action⟩,inherited⟩

