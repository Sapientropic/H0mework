def gammaCombo (coordinate : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  jQuarterAmplitude coordinate • actualGammaKernel coordinate -
    hQuarterAmplitude coordinate • F (actualGammaKernel coordinate)

private theorem combo_graph (coordinate : BurnolCompletedMellinCoordinate) :
    GammaPair (sourceKernelCombo coordinate) (gammaCombo coordinate) := by
  have first := actual_gamma_original_kernel coordinate
  have second := gamma_pair_fourier _ _ first
  intro test
  rw [sourceKernelCombo_actual, gammaCombo, inner_sub_right, inner_smul_right,
    inner_smul_right, first test, second test, inner_sub_right, inner_smul_right,
    inner_smul_right]

private theorem step_graph (coordinate : BurnolCompletedMellinCoordinate)
    (value gamma : BurnolL2) (source : GammaPair value gamma) :
    GammaPair (sourceStep coordinate value) (sourceStep coordinate gamma) := by
  have inverse := gamma_pair_inverse_fourier value gamma source
  have resolved :=
    OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.ComplementDual.Joint.Gamma.CutPower.actual_Gamma_R
      (barC coordinate) _ _ inverse
  change GammaPair
    (sourceResolvent coordinate (fourierL2.symm value))
    (sourceResolvent coordinate (fourierL2.symm gamma)) at resolved
  have forward := gamma_pair_fourier _ _ resolved
  rw [sourceStep_fourier_source, sourceStep_fourier_source]
  exact forward

def gammaField (coordinate : BurnolCompletedMellinCoordinate) : Nat → BurnolL2
  | 0 => gammaCombo coordinate
  | next+1 => sourceStep coordinate (gammaField coordinate next)

/-- Both columns are generated by the literal original source operation at every order. -/
theorem actual_source_graph (coordinate : BurnolCompletedMellinCoordinate) (order : Nat) :
    GammaPair (sourceField coordinate order) (gammaField coordinate order) := by
  induction order with
  | zero => exact combo_graph coordinate
  | succ order previous => exact step_graph coordinate _ _ previous

