theorem actual_original_counted_position_complete_Gamma_source
    (c:BurnolCompletedMellinCoordinate) (zero:riemannZeta c.value=0) :
    GammaPair (PositionCounting.value c zero) (originalCountedPositionGamma c) := by
  have source:=(phiGammaPaid% gamma_pair_base) c ConstantDual.value dualFirstConductor
    original_dual_first_conductor
  rw [original_base_first_source c zero] at source
  intro test
  have read:=congrArg (fun z:ℂ=>-z) (source test)
  simpa only [originalCountedPositionGamma,inner_neg_right,neg_neg] using read

theorem actual_original_counted_position_Tate_D_joint_Gamma_source
    (c:BurnolCompletedMellinCoordinate) (zero:riemannZeta c.value=0) :
    originalFirstFieldGamma c= -originalCountedPositionGamma c-T (actualDGamma c) := by
  have joint:GammaPair (originalFirstField c zero)
      (-originalCountedPositionGamma c-T (actualDGamma c)) := by
    intro test
    rw [originalFirstField,inner_sub_right,inner_neg_right,
      actual_original_counted_position_complete_Gamma_source c zero test,
      actual_original_counted_D_Tate_complete_Gamma_source c test,inner_sub_right,inner_neg_right]
  have logs:=actual_original_first_field_complete_log_sources c zero
  exact (gamma_value_of_log_pairs _ _ _ _
    (actual_original_first_field_complete_Gamma_source c zero) logs.1 logs.2).trans
      (gamma_value_of_log_pairs _ _ _ _ joint logs.1 logs.2).symm

