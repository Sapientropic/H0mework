namespace Traced
variable {env:Env C.Value C.Var} {body:Expr C.Value C.Var ()} {total:BurnolL2}
variable (operation:BurnolL2 →+ BurnolL2) (actual:Trace env (.linear (s:=()) (t:=()) operation body) (.const total))
def path : List Bool := [false]
noncomputable def split := Trace.splitLinear actual
noncomputable def child : Trace.SourceReceipt actual body :=
  ⟨(split operation actual).input,(split operation actual).trace,.linear (split operation actual) (.refl _)⟩
noncomputable def cursor : Trace.Cursor (s:=()) (before:=.linear (s:=()) (t:=()) operation body) (after:=.const total) actual := (split operation actual).interleaving.lastCursor
set_option backward.isDefEq.respectTransparency false in
theorem cursor_stored : childAt path (cursor operation actual).beforeExpr=.const (child operation actual).value := by
  unfold cursor
  rw [last_before]
  rfl
noncomputable def index : Fin (PT.words actual).length :=
  ⟨(cursor operation actual).position,by rw [PT.complete_steps];exact (cursor operation actual).position_lt⟩
noncomputable def occurrence := PT.stepOccurrence actual (index operation actual)
theorem occurrence_word : (occurrence operation actual).word=relation (R:=ℤ) env
    (.inl ⟨(cursor operation actual).beforeExpr,(cursor operation actual).afterExpr,(cursor operation actual).paidStep.toDerivation⟩) :=
  word_at (cursor operation actual)
noncomputable def storedValue : BurnolL2 :=
  decodeMap (remaining (cursor operation actual).beforeExpr) path (occurrence operation actual).word
theorem stored_value : storedValue operation actual=(child operation actual).value := by
  unfold storedValue
  rw [occurrence_word]
  exact OriginalConstantFourierPriceCursor.CursorRead.decode_before (cursor operation actual).paidStep path
    (child operation actual).value (cursor_stored operation actual)
theorem child_address : (child operation actual).retained.address=[2] := rfl
private noncomputable def repoint (point:BurnolL2) (same:point=(child operation actual).value) :
    Trace.SourceReceipt actual body := by
  refine ⟨point,Eq.mp (congrArg (fun v=>Trace env body (.const v)) same.symm) (child operation actual).trace,?_⟩
  cases same
  exact (child operation actual).retained
private theorem repoint_value (point:BurnolL2) (same:point=(child operation actual).value) :
    (repoint operation actual point same).value=point := rfl
end Traced

private def directOperation (coordinate:BurnolCompletedMellinCoordinate) : BurnolL2 →+ BurnolL2 :=
  (burnolDirectRightResolventCLM coordinate).toLinearMap.toAddMonoidHom

variable (observation:GeneratedRiemannZeroObservation)
variable (nontrivial:¬ ∃ n:Nat,observation.coordinate=-2*(n+1))
variable (half:OriginalKCombCalculation.Half observation) (depth ordinal:Nat) (t:ℝ) (N:Nat)
local notation "c"=>OriginalKCombCofinalTwoDirection.coordinate observation nontrivial half
local notation "op"=>directOperation c
local notation "native"=>WN.native observation nontrivial half depth ordinal
local notation "factory"=>D.factory observation nontrivial half
local notation "packet"=>Born.packetAt observation nontrivial half depth
noncomputable def parentTrace : Trace (C.receipt observation nontrivial depth half).1.environment
    (.linear (s:=()) (t:=()) op (C.returnJordanPrefixCode observation nontrivial depth half))
    (.const (W.actualValue observation nontrivial half depth 1)) :=
  C.returnJordanSourceTrace observation nontrivial depth half 1
noncomputable def originalChild := Traced.child op (parentTrace observation nontrivial half depth)
noncomputable def originalCursor := Traced.cursor op (parentTrace observation nontrivial half depth)
noncomputable def originalIndex : Occ.Index observation nontrivial half depth 1 :=
  Traced.index op (parentTrace observation nontrivial half depth)
noncomputable def originalOccurrence :=
  WN.relationTransport (AS.bornAfterNative native).2.2.2.down.symm
    (Occ.actualOccurrence observation nontrivial half depth ordinal 1 (originalIndex observation nontrivial half depth))
noncomputable abbrev original_word : (originalOccurrence observation nontrivial half depth ordinal).word=
    ActualCofinalSourceAction.wordTransport (AS.bornAfterNative native).2.2.2.down.symm
      (NW.admissionWord factory (packet (ordinal+1))
        (liftMap (R:=ℤ) (R.wordMapAt observation nontrivial half depth (ordinal+1)
          ((PT.words (parentTrace observation nontrivial half depth)).get (originalIndex observation nontrivial half depth))))) := by
  rw [originalOccurrence,relationTransport_word,Occ.actual_word]
  rfl
noncomputable def originalStoredValue : BurnolL2 := physicalValue (AS.bornAfterNative native).1
  (decodeMap (remaining (originalCursor observation nontrivial half depth).beforeExpr) Traced.path
    (originalOccurrence observation nontrivial half depth ordinal).word)
include observation nontrivial half depth ordinal in
theorem original_stored_child : originalStoredValue observation nontrivial half depth ordinal=
    (originalChild observation nontrivial half depth).value := by
  let word := (PT.words (parentTrace observation nontrivial half depth)).get (originalIndex observation nontrivial half depth)
  refine (congrArg (fun item=>physicalValue (AS.bornAfterNative native).1
    (decodeMap (remaining (originalCursor observation nontrivial half depth).beforeExpr) Traced.path item))
    (original_word observation nontrivial half depth ordinal)).trans ?_
  refine (physical_native_word (remaining (originalCursor observation nontrivial half depth).beforeExpr)
    Traced.path factory (packet (ordinal+1)) (R.wordMapAt observation nontrivial half depth (ordinal+1) word)).trans ?_
  refine (physical_word observation nontrivial half depth
    (remaining (originalCursor observation nontrivial half depth).beforeExpr) Traced.path word (ordinal+1)).trans ?_
  exact Traced.stored_value op (parentTrace observation nontrivial half depth)

