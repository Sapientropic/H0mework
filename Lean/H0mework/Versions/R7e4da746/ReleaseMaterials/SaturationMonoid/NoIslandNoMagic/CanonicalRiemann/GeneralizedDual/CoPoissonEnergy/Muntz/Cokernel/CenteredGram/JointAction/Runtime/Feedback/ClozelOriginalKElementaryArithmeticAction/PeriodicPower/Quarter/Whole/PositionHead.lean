/-- The compact power and regular sources are restrictions of the original H itself. -/
theorem actual_source_split (c:BurnolCompletedMellinCoordinate) (zero:riemannZeta c.value=0):
    quarterWave c=λc c • powerSource c+regularSource c zero:=by
  apply Lp.ext
  filter_upwards [actual_quarter_raw c,actual_power_raw c,actual_regular_source_raw c zero,
    Lp.coeFn_add (λc c • powerSource c) (regularSource c zero),Lp.coeFn_smul (λc c) (powerSource c),
    volume.ae_ne (0:ℝ),volume.ae_ne q,volume.ae_ne (-q)]
    with x whole power regular added scalar notZero notPlus notMinus
  rw [whole,added,Pi.add_apply,scalar,Pi.smul_apply,smul_eq_mul,power,regular]
  have notBoundary:|x|≠q:=by
    intro same
    rcases eq_or_eq_neg_of_abs_eq same with atPlus|atMinus
    · exact notPlus atPlus
    · exact notMinus (by linarith)
  by_cases inside:|x|<q
  · have member:x∈symmetricInterval q:=abs_le.mp inside.le
    rw [quarterRaw,indicator_of_mem member,powerRaw,indicator_of_mem member,
      SingularCounting.powerRaw,regularCompactRaw,
      indicator_of_mem (show x∈Ioo (-q) q from abs_lt.mp inside),
      regularLocal,min_eq_right inside.le]
    have even:periodicRaw c x=periodicRaw c |x|:=by
      rcases le_total 0 x with positive|negative
      · rw [abs_of_nonneg positive]
      · rw [abs_of_nonpos negative,actual_periodic_even]
    rw [even]
    have native:=OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.Tail.actual_periodic_split c |x| (abs_pos.mpr notZero)
    simpa only [show -(1-star c.value)=star c.value-1 by ring] using native
  · have outside:x∉symmetricInterval q:=fun member=>inside
      (lt_of_le_of_ne (abs_le.mpr member) notBoundary)
    rw [quarterRaw,indicator_of_notMem outside,powerRaw,indicator_of_notMem outside,
      actual_regular_outer_zero c x (le_of_not_gt inside),mul_zero,zero_add]

def regularValue (c:BurnolCompletedMellinCoordinate) (zero:riemannZeta c.value=0)
    (h:ℝ) (positive:0<h):BurnolL2:=wholeValue c zero h positive-λc c • powerValue c

/-- The regular value is generated by subtracting two actual realizations of the same source split. -/
theorem actual_regular_realizes (c:BurnolCompletedMellinCoordinate) (zero:riemannZeta c.value=0)
    (h:ℝ) (positive:0<h) (test:SchwartzMap ℝ ℂ):
    burnolRemainderSourceRead (regularSource c zero) test=
      (Lp.toTemperedDistributionCLM ℂ volume 2 (regularValue c zero h positive)) test:=by
  have native:=actual_whole_realizes c zero h positive test
  rw [actual_source_split c zero,←burnolRemainderSourceReadCLM_apply,map_add,map_smul,
    burnolRemainderSourceReadCLM_apply,burnolRemainderSourceReadCLM_apply,
    actual_power_realizes] at native
  rw [regularValue,map_sub,map_smul,sub_apply,smul_apply,smul_eq_mul]
  linear_combination native

theorem actual_regular_value_raw (c:BurnolCompletedMellinCoordinate) (zero:riemannZeta c.value=0)
    (h:ℝ) (positive:0<h):
    (regularValue c zero h positive:ℝ→ℂ)=ᵐ[volume] regularForwardRaw c:=by
  obtain ⟨L,nonnegative,growth⟩:=actual_regular_global_growth c zero
  have native:=source_forward_realization (regularSource c zero) (regularValue c zero h positive)
    (regularCompactRaw c) (actual_regular_source_raw c zero) (actual_regular_measurable c)
    (actual_regular_origin c zero) (actual_regular_even c) L nonnegative growth
    (actual_regular_outer_zero c) (actual_regular_realizes c zero h positive)
  change (regularValue c zero h positive:ℝ→ℂ)=ᵐ[volume]
    (fun x=>burnolInnerGapForward (regularCompactRaw c) x-regularReciprocalMean c)
  simpa only [actual_regular_mean] using native

def wholeHeadRaw (c:BurnolCompletedMellinCoordinate) (x:ℝ):ℂ:=
  burnolInnerGapForward (regularCompactRaw c) x-wholeReciprocalFinitePart c

/-- The original Whole's position head is calculated with its complete reciprocal Unit. -/
theorem actual_whole_head (c:BurnolCompletedMellinCoordinate) (zero:riemannZeta c.value=0)
    (h:ℝ) (positive:0<h):
    (wholeValue c zero h positive:ℝ→ℂ)=ᵐ[volume.restrict (symmetricInterval q)] wholeHeadRaw c:=by
  filter_upwards [ae_restrict_of_ae (actual_regular_value_raw c zero h positive),
    actual_power_value_raw_quarter c zero,
    ae_restrict_of_ae (Lp.coeFn_sub (wholeValue c zero h positive) (λc c • powerValue c)),
    ae_restrict_of_ae (Lp.coeFn_smul (λc c) (powerValue c))] with x regular power subtracted scalar
  change (wholeValue c zero h positive-λc c • powerValue c:BurnolL2) x=regularForwardRaw c x at regular
  rw [subtracted,Pi.sub_apply,scalar,Pi.smul_apply,smul_eq_mul,power] at regular
  unfold regularForwardRaw at regular
  unfold wholeHeadRaw wholeReciprocalFinitePart
  linear_combination regular

theorem actual_head_channels (c:BurnolCompletedMellinCoordinate) (zero:riemannZeta c.value=0)
    (x:ℝ):Summable (fun n:ℕ=>‖((n+1:ℕ):ℂ)⁻¹*regularCompactRaw c (x/(n+1:ℕ))‖):=by
  obtain ⟨L,_,growth⟩:=actual_regular_global_growth c zero
  exact channel_summable _ L growth x

theorem actual_head_series (c:BurnolCompletedMellinCoordinate) (x:ℝ):
    wholeHeadRaw c x=(∑'n:ℕ,((n+1:ℕ):ℂ)⁻¹*regularCompactRaw c (x/(n+1:ℕ)))-
      wholeReciprocalFinitePart c:=by
  rw [wholeHeadRaw,forward_reindex]
  rfl

