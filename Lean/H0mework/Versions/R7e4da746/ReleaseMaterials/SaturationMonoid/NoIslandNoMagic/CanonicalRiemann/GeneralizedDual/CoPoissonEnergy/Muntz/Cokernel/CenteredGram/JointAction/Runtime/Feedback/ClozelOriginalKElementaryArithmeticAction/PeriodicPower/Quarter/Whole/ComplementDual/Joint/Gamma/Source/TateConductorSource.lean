  have frequencyInt := (tateClockPaid% norm_product_integrable) u v
  have budget := timeInt.mul_prod frequencyInt
  have coefficient : Measurable (fun p : ℝ×ℝ => (p.1 : ℂ)⁻¹*
      (((Real.exp (-p.1) : ℝ) : ℂ)-((Real.exp (-(p.1*p.2^2)) : ℝ) : ℂ))) := by fun_prop
