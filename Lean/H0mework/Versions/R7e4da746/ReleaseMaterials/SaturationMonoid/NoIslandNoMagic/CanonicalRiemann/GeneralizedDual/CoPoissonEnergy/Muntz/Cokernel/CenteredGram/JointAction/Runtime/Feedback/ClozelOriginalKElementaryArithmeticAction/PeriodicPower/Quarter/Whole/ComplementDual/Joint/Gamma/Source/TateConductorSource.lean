    apply (L2.integrable_inner (𝕜 := ℂ) u (heatMultiplier time positive.le v)).congr
    filter_upwards [(tateClockPaid% heat_multiplier_raw) time positive.le v] with frequency actual
    change ((heatMultiplier time positive.le) v) frequency = _ at actual
    rw [RCLike.inner_apply, starRingEnd_apply, actual]
    ring
  rw [point, integral_const_mul, integral_sub (product.const_mul _) heated, integral_const_mul]
  have original : (∫ frequency : ℝ, star (u frequency)*v frequency) = inner ℂ u v := by
    rw [L2.inner_def]
    apply integral_congr_ae
    filter_upwards with frequency
    rw [RCLike.inner_apply, starRingEnd_apply]
    ring
  have acted : (∫ frequency : ℝ, star (u frequency)*
      (((Real.exp (-(time*frequency^2)) : ℝ) : ℂ)*v frequency)) = inner ℂ u (heatMultiplier time positive.le v) := by
    rw [L2.inner_def]
    apply integral_congr_ae
    filter_upwards [(tateClockPaid% heat_multiplier_raw) time positive.le v] with frequency actual
    change ((heatMultiplier time positive.le) v) frequency = _ at actual
    rw [RCLike.inner_apply, starRingEnd_apply, actual]
    ring
  rw [original, acted]

