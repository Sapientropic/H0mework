private def pointHeat (time x : ℝ) : ℂ :=
  ∫ z : ℝ, heatKernel 1 z * ConstantDual.sawtoothRaw (x - Real.sqrt time * z)

private theorem point_heat_measured : Measurable (fun p : ℝ×ℝ => pointHeat p.1 p.2) := by
  have integrand : Measurable (fun p : (ℝ×ℝ)×ℝ =>
      heatKernel 1 p.2 * ConstantDual.sawtoothRaw (p.1.2 - Real.sqrt p.1.1 * p.2)) := by
    unfold heatKernel ConstantDual.sawtoothRaw
    change Measurable (fun p : (ℝ×ℝ)×ℝ =>
      (((Real.sqrt (Real.pi / 1) * Real.exp (-(Real.pi ^ 2 * p.2 ^ 2 / 1))) : ℝ) : ℂ) *
        -((Int.fract (q / |p.1.2 - Real.sqrt p.1.1 * p.2|) : ℝ) : ℂ))
    fun_prop
  exact (integrand.stronglyMeasurable.integral_prod_right' (ν := volume)).measurable

private theorem point_heat_integrable (time x : ℝ) :
    Integrable (fun z : ℝ => heatKernel 1 z * ConstantDual.sawtoothRaw (x - Real.sqrt time * z)) := by
  have measured : Measurable (fun z : ℝ => heatKernel 1 z * ConstantDual.sawtoothRaw (x - Real.sqrt time * z)) := by
    unfold heatKernel ConstantDual.sawtoothRaw
    change Measurable (fun z : ℝ =>
      ((((Real.sqrt (Real.pi / 1) * Real.exp (-(Real.pi ^ 2 * z ^ 2 / 1))) : ℝ) : ℂ)) *
        -((Int.fract (q / |x - Real.sqrt time * z|) : ℝ) : ℂ))
    fun_prop
  apply ((tateClockPaid% heat_kernel_integrable) 1 (by norm_num)).norm.mono' measured.aestronglyMeasurable
  filter_upwards with z
  rw [norm_mul]
  exact mul_le_of_le_one_right (norm_nonneg _) (ConstantDual.sawtooth_bounds _).1

private theorem point_heat_norm (time x : ℝ) : ‖pointHeat time x‖ ≤ 1 := by
  calc
    _ ≤ ∫ z : ℝ, ‖heatKernel 1 z * ConstantDual.sawtoothRaw (x - Real.sqrt time * z)‖ :=
      norm_integral_le_integral_norm _
    _ ≤ ∫ z : ℝ, ‖heatKernel 1 z‖ := by
      apply integral_mono_ae (point_heat_integrable time x).norm ((tateClockPaid% heat_kernel_integrable) 1 (by norm_num)).norm
      filter_upwards with z
      rw [norm_mul]
      exact mul_le_of_le_one_right (norm_nonneg _) (ConstantDual.sawtooth_bounds _).1
    _ = 1 := original_heat_norm_mass 1 (by norm_num)

private theorem source_continuous_ae : ∀ᵐ x : ℝ ∂volume, ContinuousAt ConstantDual.sawtoothRaw x := by
  let bad := Set.range (fun n : ℤ => q / (n : ℝ)) ∪ Set.range (fun n : ℤ => -q / (n : ℝ))
  have finiteGrid : bad.Countable := Set.countable_range _ |>.union (Set.countable_range _)
  filter_upwards [finiteGrid.ae_notMem volume, volume.ae_ne (0 : ℝ)] with x good xne
  have noninteger : q / |x| ≠ ((⌊q / |x|⌋ : ℤ) : ℝ) := by
    intro equal
    let n : ℤ := ⌊q / |x|⌋
    have npos : 0 < (n : ℝ) := by
      dsimp only [n]
      rw [← equal]
      exact div_pos (by norm_num) (abs_pos.mpr xne)
    have recover : |x| = q / (n : ℝ) := by
      apply (eq_div_iff npos.ne').mpr
      have paid := (div_eq_iff (abs_ne_zero.mpr xne)).mp equal
      simpa only [mul_comm] using paid.symm
    apply good
    change x ∈ Set.range (fun n : ℤ => q / (n : ℝ)) ∨
      x ∈ Set.range (fun n : ℤ => -q / (n : ℝ))
    rcases le_or_gt 0 x with positive | negative
    · left
      exact ⟨n, by dsimp only; rw [← recover, abs_of_nonneg positive]⟩
    · right
      refine ⟨n, ?_⟩
      dsimp only
      rw [neg_div, ← recover, abs_of_neg negative]
      ring
  have innerSource : ContinuousAt (fun y : ℝ => q / |y|) x :=
    continuousAt_const.div continuous_abs.continuousAt (abs_ne_zero.mpr xne)
  have frac : ContinuousAt (fun v : ℝ => Int.fract v) (q / |x|) := continuousAt_fract noninteger
  have joined : ContinuousAt (fun y : ℝ => Int.fract (q / |y|)) x :=
    ContinuousAt.comp (f := fun y : ℝ => q / |y|) (x := x) frac innerSource
  exact (Complex.continuous_ofReal.continuousAt.comp joined).neg

private theorem point_heat_cold (time : ℕ → ℝ) (limit : Tendsto time atTop (𝓝 0))
    (x : ℝ) (continuous : ContinuousAt ConstantDual.sawtoothRaw x) :
    Tendsto (fun N => pointHeat (time N) x) atTop (𝓝 (ConstantDual.sawtoothRaw x)) := by
  have source := tendsto_integral_of_dominated_convergence
    (f := fun z : ℝ => heatKernel 1 z * ConstantDual.sawtoothRaw x)
    (fun z : ℝ => ‖heatKernel 1 z‖)
    (fun N => (point_heat_integrable (time N) x).aestronglyMeasurable)
    ((tateClockPaid% heat_kernel_integrable) 1 (by norm_num)).norm ?_ ?_
  · have read : (∫ z : ℝ, heatKernel 1 z * ConstantDual.sawtoothRaw x) = ConstantDual.sawtoothRaw x := by
      rw [integral_mul_const, original_heat_mass 1 (by norm_num), one_mul]
    simpa only [pointHeat, read] using source
  · intro N
    filter_upwards with z
    rw [norm_mul]
    exact mul_le_of_le_one_right (norm_nonneg _) (ConstantDual.sawtooth_bounds _).1
  · filter_upwards with z
    have root := Real.continuous_sqrt.tendsto 0 |>.comp limit
    have argument : Tendsto (fun N => x - Real.sqrt (time N) * z) atTop (𝓝 x) := by
      simpa only [Function.comp_apply, Real.sqrt_zero, zero_mul, sub_zero] using (root.mul_const z).const_sub x
    have field := continuous.tendsto.comp argument
    simpa only [Function.comp_apply] using field.const_mul (heatKernel 1 z)

private theorem source_tail_zero (values : ℕ → ℝ) (grow : Tendsto (fun N => |values N|) atTop atTop) :
    Tendsto (fun N => ConstantDual.sawtoothRaw (values N)) atTop (𝓝 0) := by
  apply tendsto_zero_iff_norm_tendsto_zero.mpr
  have bound : ∀ N, ‖ConstantDual.sawtoothRaw (values N)‖ ≤ q * |values N|⁻¹ := by
    intro N
    simpa only [div_eq_mul_inv] using (ConstantDual.sawtooth_bounds (values N)).2
  have limit : Tendsto (fun N => q * |values N|⁻¹) atTop (𝓝 0) := by
    simpa only [mul_zero, Function.comp_apply] using (tendsto_inv_atTop_zero.comp grow).const_mul q
  exact squeeze_zero (fun N => norm_nonneg _) bound limit

private theorem point_heat_hot (time : ℕ → ℝ) (limit : Tendsto time atTop atTop) (x : ℝ) :
    Tendsto (fun N => pointHeat (time N) x) atTop (𝓝 0) := by
  have source := tendsto_integral_of_dominated_convergence (f := fun _ : ℝ => (0 : ℂ))
    (fun z : ℝ => ‖heatKernel 1 z‖)
    (fun N => (point_heat_integrable (time N) x).aestronglyMeasurable)
    ((tateClockPaid% heat_kernel_integrable) 1 (by norm_num)).norm ?_ ?_
  · simpa only [pointHeat, integral_zero] using source
  · intro N
    filter_upwards with z
    rw [norm_mul]
    exact mul_le_of_le_one_right (norm_nonneg _) (ConstantDual.sawtooth_bounds _).1
  · filter_upwards [volume.ae_ne (0 : ℝ)] with z zne
    have root := Real.tendsto_sqrt_atTop.comp limit
    have growing : Tendsto (fun N => Real.sqrt (time N) * |z| - |x|) atTop atTop := by
      simpa only [Function.comp_apply, sub_eq_add_neg] using
        tendsto_atTop_add_const_right _ (-|x|) (root.atTop_mul_const (abs_pos.mpr zne))
    have actual : Tendsto (fun N => |x - Real.sqrt (time N) * z|) atTop atTop := by
      apply tendsto_atTop_mono _ growing
      intro N
      have reverse := abs_sub_abs_le_abs_sub (Real.sqrt (time N) * z) x
      simpa only [abs_mul, abs_of_nonneg (Real.sqrt_nonneg _), abs_sub_comm] using reverse
    have field := source_tail_zero _ actual
    simpa only [mul_zero] using field.const_mul (heatKernel 1 z)

private theorem heat_source_scale (time z : ℝ) (positive : 0 < time) :
    heatKernel time (Real.sqrt time * z) = ((Real.sqrt time : ℂ)⁻¹) * heatKernel 1 z := by
  have rootPos := Real.sqrt_pos.mpr positive
  unfold heatKernel
  change (((Real.sqrt (Real.pi / time) *
      Real.exp (-(Real.pi ^ 2 * (Real.sqrt time * z) ^ 2 / time))) : ℝ) : ℂ) =
    (Real.sqrt time : ℂ)⁻¹ * ((((Real.sqrt (Real.pi / 1) * Real.exp (-(Real.pi ^ 2 * z ^ 2 / 1)))) : ℝ) : ℂ)
  rw [Real.sqrt_div Real.pi_pos.le, div_one, mul_pow, Real.sq_sqrt positive.le]
  have exponent : Real.pi ^ 2 * (time * z ^ 2) / time = Real.pi ^ 2 * z ^ 2 := by field_simp
  rw [exponent]
  push_cast
  field_simp

private theorem point_heat_physical (time x : ℝ) (positive : 0 < time) :
    (∫ y : ℝ, ConstantDual.sawtoothRaw y * heatKernel time (x-y)) = pointHeat time x := by
  let g : ℝ → ℂ := fun z => heatKernel time z * ConstantDual.sawtoothRaw (x-z)
  have source := Measure.integral_comp_mul_left g (Real.sqrt time)
  have scaled : (∫ z : ℝ, g (Real.sqrt time * z)) = (Real.sqrt time : ℂ)⁻¹ * pointHeat time x := by
    unfold g pointHeat
    simp_rw [heat_source_scale time _ positive, mul_assoc]
    exact integral_const_mul _ _
  have rootPos := Real.sqrt_pos.mpr positive
  have reshape : |(Real.sqrt time)⁻¹| • (∫ z : ℝ, g z) =
      (Real.sqrt time : ℂ)⁻¹ * (∫ z : ℝ, g z) := by
    rw [abs_of_pos (inv_pos.mpr rootPos), Complex.real_smul, Complex.ofReal_inv]
  rw [scaled, reshape] at source
  have cancel : (∫ z : ℝ, g z) = pointHeat time x :=
    mul_left_cancel₀ (inv_ne_zero (Complex.ofReal_ne_zero.mpr rootPos.ne')) source.symm
  have original := integral_sub_left_eq_self (fun y : ℝ => ConstantDual.sawtoothRaw y * heatKernel time (x-y)) volume x
  rw [← original]
  convert cancel using 1
  congr 1
  funext z
  unfold g
  rw [sub_sub_cancel]
  ring

private theorem log_weighted_schwartz_integrable (test : SchwartzMap ℝ ℂ) :
    Integrable (fun x : ℝ => ‖test x‖ * |Real.log (|x|)|) := by
  let C := SchwartzMap.seminorm ℝ 0 0 test
  have Cpos : 0 ≤ C := (norm_nonneg (test 0)).trans (test.norm_le_seminorm ℝ 0)
  have head : IntegrableOn (fun x : ℝ => |Real.log (|x|)|) (Icc (-1) 1) := by
    have original := (intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num : (-1 : ℝ) ≤ 1)).mp
      (intervalIntegral.intervalIntegrable_log' («a» := (-1 : ℝ)) (b := 1)).norm
    simpa only [Real.norm_eq_abs, Real.log_abs] using original
  let moment : SchwartzMap ℝ ℂ := SchwartzMap.smulLeftCLM ℂ (fun x : ℝ => (x : ℂ)) test
  have whole := (head.integrable_indicator measurableSet_Icc).const_mul C |>.add moment.integrable.norm
  apply whole.mono' ((by fun_prop : Measurable (fun x : ℝ => ‖test x‖ * |Real.log (|x|)|)).aestronglyMeasurable)
  filter_upwards with x
  rw [Real.norm_of_nonneg (mul_nonneg (norm_nonneg _) (abs_nonneg _))]
  simp only [Pi.add_apply]
  have momentRead : ‖moment x‖ = |x| * ‖test x‖ := by
    have raw : moment x = (x : ℂ) * test x := SchwartzMap.smulLeftCLM_apply_apply (by fun_prop) test x
    rw [raw, norm_mul, Complex.norm_real, Real.norm_eq_abs]
  by_cases inside : x ∈ Icc (-1 : ℝ) 1
  · rw [indicator_of_mem inside]
    have estimate := mul_le_mul_of_nonneg_right (test.norm_le_seminorm ℝ x) (abs_nonneg (Real.log |x|))
    dsimp only [C] at *
    linarith [norm_nonneg (moment x)]
  · rw [indicator_of_notMem inside, mul_zero, zero_add, momentRead]
    have beyond : 1 < |x| := lt_of_not_ge (fun bounded => inside (abs_le.mp bounded))
    have logarithm := Real.log_le_sub_one_of_pos (by linarith : 0 < |x|)
    rw [abs_of_nonneg (Real.log_nonneg beyond.le)]
    have bound : Real.log |x| ≤ |x| := by linarith
    nlinarith [norm_nonneg (test x)]

private theorem heat_source_integrable (time x : ℝ) (positive : 0 < time) :
    Integrable (fun y : ℝ => ConstantDual.sawtoothRaw y * heatKernel time (x-y)) := by
  have gaussian := (volume.measurePreserving_sub_left x).integrable_comp_of_integrable
    ((tateClockPaid% heat_kernel_integrable) time positive)
  have measured : Measurable (fun y : ℝ => ConstantDual.sawtoothRaw y * heatKernel time (x-y)) := by
    unfold ConstantDual.sawtoothRaw heatKernel
    change Measurable (fun y : ℝ => -((Int.fract (q / |y|) : ℝ) : ℂ) *
      ((((Real.sqrt (Real.pi / time) * Real.exp (-(Real.pi ^ 2 * (x-y) ^ 2 / time)))) : ℝ) : ℂ))
    fun_prop
  apply gaussian.norm.mono' measured.aestronglyMeasurable
  filter_upwards with y
  rw [norm_mul]
  exact mul_le_of_le_one_left (norm_nonneg _) (ConstantDual.sawtooth_bounds y).1

private theorem heat_source_norm (time x : ℝ) (positive : 0 < time) :
    (∫ y : ℝ, ‖ConstantDual.sawtoothRaw y * heatKernel time (x-y)‖) ≤ 1 := by
  calc
    _ ≤ ∫ y : ℝ, ‖heatKernel time (x-y)‖ := by
      apply integral_mono_ae (heat_source_integrable time x positive).norm
        ((volume.measurePreserving_sub_left x).integrable_comp_of_integrable
          ((tateClockPaid% heat_kernel_integrable) time positive).norm)
      filter_upwards with y
      rw [norm_mul]
      exact mul_le_of_le_one_left (norm_nonneg _) (ConstantDual.sawtooth_bounds y).1
    _ = 1 := by
      rw [integral_sub_left_eq_self (fun y : ℝ => ‖heatKernel time y‖) volume x,
        original_heat_norm_mass time positive]

private theorem clock_rescale (time factor distance : ℝ) (positive : 0 < time) (factorPos : 0 < factor) :
    clockBand time (time * factor) distance =
      ∫ r : ℝ in 1..factor, (r : ℂ)⁻¹ * heatKernel (time*r) distance := by
  have point : ∀ r : ℝ, 0 < r →
      (time : ℂ) * clockDensity distance (r*time) = (r : ℂ)⁻¹ * heatKernel (time*r) distance := by
    intro r rPos
    unfold clockDensity
    rw [Complex.ofReal_mul, mul_comm r time]
    field_simp [Complex.ofReal_ne_zero.mpr positive.ne']
  calc
    _ = (time : ℂ) * ∫ r : ℝ in 1..factor, clockDensity distance (r*time) := by
      have source := intervalIntegral.smul_integral_comp_mul_right (clockDensity distance) time
        («a» := 1) (b := factor)
      simpa only [clockBand, one_mul, mul_comm factor time, Complex.real_smul] using source.symm
    _ = _ := by
      rw [← intervalIntegral.integral_const_mul]
      apply intervalIntegral.integral_congr
      intro r inside
      exact point r (lt_of_lt_of_le (lt_min (by norm_num : (0 : ℝ) < 1) factorPos) inside.1)

private def fixedClock (time x : ℝ) (p : ℝ×ℝ) : ℂ :=
  (p.1 : ℂ)⁻¹ * (ConstantDual.sawtoothRaw p.2 * heatKernel (time*p.1) (x-p.2))

private theorem fixed_clock_integrable (time factor x : ℝ) (positive : 0 < time) (factorPos : 0 < factor) :
    Integrable (fixedClock time x) ((volume.restrict (uIoc 1 factor)).prod volume) := by
  have measured : Measurable (fixedClock time x) := by
    unfold fixedClock ConstantDual.sawtoothRaw heatKernel
    change Measurable (fun p : ℝ×ℝ => (p.1 : ℂ)⁻¹ * (-((Int.fract (q / |p.2|) : ℝ) : ℂ) *
      (((Real.sqrt (Real.pi / (time*p.1)) * Real.exp (-(Real.pi ^ 2 * (x-p.2)^2 / (time*p.1)))) : ℝ) : ℂ)))
    fun_prop
  have positiveInterval : uIoc (1 : ℝ) factor ⊆ Ioi 0 := by
    intro r inside
    exact lt_of_lt_of_le (lt_min (by norm_num : (0 : ℝ) < 1) factorPos) inside.1.le
  have inverse : IntegrableOn (fun r : ℝ => r⁻¹) (uIoc 1 factor) := by
    apply (intervalIntegrable_iff).mp
    exact ((show ContinuousOn (fun r : ℝ => r⁻¹) (Ioi 0) from
      fun r inside => (continuousAt_id.inv₀ (ne_of_gt inside)).continuousWithinAt).mono
        (by intro r inside; exact lt_of_lt_of_le (lt_min (by norm_num : (0 : ℝ) < 1) factorPos) inside.1)).intervalIntegrable
  apply (integrable_prod_iff measured.aestronglyMeasurable).mpr
  constructor
  · filter_upwards [ae_restrict_mem measurableSet_uIoc] with r inside
    exact (heat_source_integrable (time*r) x (mul_pos positive (positiveInterval inside))).const_mul (r : ℂ)⁻¹
  · apply inverse.mono'
      (measured.stronglyMeasurable.norm.integral_prod_right' (ν := volume)).aestronglyMeasurable
    filter_upwards [ae_restrict_mem measurableSet_uIoc] with r inside
    have rPos : 0 < r := positiveInterval inside
    have source := heat_source_norm (time*r) x (mul_pos positive rPos)
    have normIntegral : (∫ y : ℝ, ‖fixedClock time x (r,y)‖) =
        r⁻¹ * ∫ y : ℝ, ‖ConstantDual.sawtoothRaw y * heatKernel (time*r) (x-y)‖ := by
      simp_rw [fixedClock, norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos rPos]
      exact integral_const_mul _ _
    rw [Real.norm_of_nonneg (integral_nonneg (fun _ => norm_nonneg _)), normIntegral]
    exact mul_le_of_le_one_right (inv_nonneg.mpr rPos.le) source

private def fixedBandInner (time x : ℝ) : ℂ :=
  ∫ y : ℝ, ConstantDual.sawtoothRaw y * clockBand time (time * x^4) (x-y)

private theorem fixed_band_clock_read (time x : ℝ) (positive : 0 < time) (xne : x ≠ 0) :
    fixedBandInner time x = ∫ r : ℝ in 1..x^4, (r : ℂ)⁻¹ * pointHeat (time*r) x := by
  have xFourth : 0 < x^4 := by nlinarith [sq_pos_of_ne_zero (pow_ne_zero 2 xne)]
  have swapped := intervalIntegral_integral_swap
    (f := fun r y : ℝ => (r : ℂ)⁻¹ * (ConstantDual.sawtoothRaw y * heatKernel (time*r) (x-y)))
    (fixed_clock_integrable time (x^4) x positive xFourth)
  calc
    _ = ∫ y : ℝ, ∫ r : ℝ in 1..x^4,
        (r : ℂ)⁻¹ * (ConstantDual.sawtoothRaw y * heatKernel (time*r) (x-y)) := by
      unfold fixedBandInner
      simp_rw [clock_rescale time (x^4) _ positive xFourth, ← intervalIntegral.integral_const_mul]
      apply integral_congr_ae
      filter_upwards with y
      apply intervalIntegral.integral_congr
      intro r _
      ring
    _ = ∫ r : ℝ in 1..x^4, ∫ y : ℝ,
        (r : ℂ)⁻¹ * (ConstantDual.sawtoothRaw y * heatKernel (time*r) (x-y)) := swapped.symm
    _ = _ := by
      apply intervalIntegral.integral_congr
      intro r inside
      have rPos := lt_of_lt_of_le (lt_min (by norm_num : (0 : ℝ) < 1) xFourth) inside.1
      dsimp only
      rw [integral_const_mul, point_heat_physical (time*r) x (mul_pos positive rPos)]

private theorem fixed_band_source_bound (time x : ℝ) (positive : 0 < time) (xne : x ≠ 0) :
    ‖fixedBandInner time x‖ ≤ 4 * |Real.log (|x|)| := by
  have xFourth : 0 < x^4 := by nlinarith [sq_pos_of_ne_zero (pow_ne_zero 2 xne)]
  have inverse : IntervalIntegrable (fun r : ℝ => r⁻¹) volume 1 (x^4) :=
    ((show ContinuousOn (fun r : ℝ => r⁻¹) (Ioi 0) from
      fun r inside => (continuousAt_id.inv₀ (ne_of_gt inside)).continuousWithinAt).mono
        (by intro r inside; exact lt_of_lt_of_le (lt_min (by norm_num : (0 : ℝ) < 1) xFourth) inside.1)).intervalIntegrable
  rw [fixed_band_clock_read time x positive xne]
  have bound := intervalIntegral.norm_integral_le_abs_of_norm_le
    (f := fun r : ℝ => (r : ℂ)⁻¹ * pointHeat (time*r) x) (g := fun r : ℝ => r⁻¹)
    («a» := 1) (b := x^4) ?_ inverse
  · rw [integral_inv_of_pos (by norm_num : (0 : ℝ) < 1) xFourth, div_one,
      Real.log_pow, ← Real.log_abs x, abs_mul] at bound
    norm_num at bound
    simpa only [Real.log_abs] using bound
  · filter_upwards [ae_restrict_mem measurableSet_uIoc] with r inside
    have rPos := lt_of_lt_of_le (lt_min (by norm_num : (0 : ℝ) < 1) xFourth) inside.1.le
    rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos rPos]
    exact mul_le_of_le_one_right (inv_nonneg.mpr rPos.le) (point_heat_norm _ _)

private theorem fixed_band_point_limit (time : ℕ → ℝ) (positive : ∀ N, 0 < time N)
    (x : ℝ) (xne : x ≠ 0) (value : ℂ)
    (point : ∀ r : ℝ, 0 < r → Tendsto (fun N => pointHeat (time N*r) x) atTop (𝓝 value)) :
    Tendsto (fun N => fixedBandInner (time N) x) atTop
      (𝓝 (((4 * Real.log |x| : ℝ) : ℂ) * value)) := by
  have xFourth : 0 < x^4 := by nlinarith [sq_pos_of_ne_zero (pow_ne_zero 2 xne)]
  have inverse : IntervalIntegrable (fun r : ℝ => r⁻¹) volume 1 (x^4) :=
    ((show ContinuousOn (fun r : ℝ => r⁻¹) (Ioi 0) from
      fun r inside => (continuousAt_id.inv₀ (ne_of_gt inside)).continuousWithinAt).mono
        (by intro r inside; exact lt_of_lt_of_le (lt_min (by norm_num : (0 : ℝ) < 1) xFourth) inside.1)).intervalIntegrable
  have source := intervalIntegral.tendsto_integral_filter_of_dominated_convergence
    (l := atTop) («F» := fun N r => (r : ℂ)⁻¹ * pointHeat (time N*r) x)
    (f := fun r : ℝ => (r : ℂ)⁻¹ * value) (fun r : ℝ => r⁻¹) ?_ ?_ inverse ?_
  · have read : (∫ r : ℝ in 1..x^4, (r : ℂ)⁻¹ * value) =
        (((4 * Real.log |x| : ℝ) : ℂ) * value) := by
      rw [intervalIntegral.integral_mul_const]
      have invRead : (∫ r : ℝ in 1..x^4, (r : ℂ)⁻¹) = ((4*Real.log |x| : ℝ) : ℂ) := by
        simp_rw [← Complex.ofReal_inv]
        rw [intervalIntegral.integral_ofReal, integral_inv_of_pos (by norm_num : (0 : ℝ) < 1) xFourth, div_one,
          Real.log_pow, Real.log_abs]
        norm_num
      rw [invRead]
    rw [read] at source
    apply source.congr'
    exact Eventually.of_forall (fun N => (fixed_band_clock_read (time N) x (positive N) xne).symm)
  · apply Eventually.of_forall
    intro N
    have measured := point_heat_measured.comp (by fun_prop : Measurable (fun r : ℝ => (time N*r,x)))
    exact ((by fun_prop : Measurable (fun r : ℝ => (r : ℂ)⁻¹)).mul measured).aestronglyMeasurable
  · apply Eventually.of_forall
    intro N
    filter_upwards with r inside
    have rPos := lt_of_lt_of_le (lt_min (by norm_num : (0 : ℝ) < 1) xFourth) inside.1.le
    rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos rPos]
    exact mul_le_of_le_one_right (inv_nonneg.mpr rPos.le) (point_heat_norm _ _)
  · filter_upwards with r inside
    have rPos := lt_of_lt_of_le (lt_min (by norm_num : (0 : ℝ) < 1) xFourth) inside.1.le
    exact (point r rPos).const_mul (r : ℂ)⁻¹

private theorem fixed_band_measured (time : ℝ) : Measurable (fixedBandInner time) := by
  have source := (tateClockPaid% clock_band_measured).comp (by fun_prop : Measurable (fun p : ℝ×ℝ =>
    ((time,time*p.1^4),p.1-p.2)))
  have field : Measurable (fun p : ℝ×ℝ => ConstantDual.sawtoothRaw p.2) := by
    unfold ConstantDual.sawtoothRaw
    fun_prop
  exact ((field.mul source).stronglyMeasurable.integral_prod_right' (ν := volume)).measurable

private theorem fixed_boundary_source_limit (time : ℕ → ℝ) (positive : ∀ N, 0 < time N)
    (values : ℝ → ℂ) (test : SchwartzMap ℝ ℂ)
    (point : ∀ᵐ x : ℝ ∂volume, Tendsto (fun N => fixedBandInner (time N) x) atTop (𝓝 (values x))) :
    Tendsto (fun N => fixedBoundaryRead (time N) test) atTop
      (𝓝 (∫ x : ℝ, star (test x) * values x)) := by
  have source := tendsto_integral_of_dominated_convergence (f := fun x : ℝ => star (test x) * values x)
    (fun x : ℝ => 4 * (‖test x‖ * |Real.log (|x|)|))
    (fun N => ((by fun_prop : Measurable (fun x : ℝ => star (test x))).mul
      (fixed_band_measured (time N))).aestronglyMeasurable)
    ((log_weighted_schwartz_integrable test).const_mul 4) ?_ ?_
  · apply source.congr'
    apply Eventually.of_forall
    intro N
    unfold fixedBoundaryRead
    apply integral_congr_ae
    filter_upwards with x
    dsimp only [Pi.mul_apply, fixedBandInner]
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with y
    ring
  · intro N
    filter_upwards [volume.ae_ne (0 : ℝ)] with x xne
    dsimp only [Pi.mul_apply]
    rw [norm_mul, norm_star]
    calc
      _ ≤ ‖test x‖ * (4*|Real.log (|x|)|) := by gcongr; exact fixed_band_source_bound (time N) x (positive N) xne
      _ = _ := by ring
  · filter_upwards [point] with x native
    exact native.const_mul (star (test x))

/-- The true first reverse field pays the complete diagonal mass, including the origin limit. -/
theorem original_fixed_boundary_cold (time : ℕ → ℝ) (positive : ∀ N, 0 < time N)
    (limit : Tendsto time atTop (𝓝 0)) (test : SchwartzMap ℝ ℂ) :
    Tendsto (fun N => fixedBoundaryRead (time N) test) atTop
      (𝓝 ((4 : ℂ) * inner ℂ (logSchwartzL2 test) ConstantDual.value)) := by
  have source := fixed_boundary_source_limit time positive
    (fun x : ℝ => (((4*Real.log |x| : ℝ) : ℂ) * ConstantDual.sawtoothRaw x)) test ?_
  · have actual : (∫ x : ℝ, star (test x) * (((4*Real.log |x| : ℝ) : ℂ) * ConstantDual.sawtoothRaw x)) =
        (4 : ℂ) * inner ℂ (logSchwartzL2 test) ConstantDual.value := by
      rw [L2.inner_def, ← integral_const_mul]
      apply integral_congr_ae
      filter_upwards [original_log_schwartz_raw test, ConstantDual.value_coeFn] with x logged field
      rw [RCLike.inner_apply, logged, field, starRingEnd_apply, star_mul]
      simp only [Complex.star_def, Complex.conj_ofReal, Complex.ofReal_mul, Complex.ofReal_ofNat]
      ring
    rw [actual] at source
    exact source
  · filter_upwards [source_continuous_ae, volume.ae_ne (0 : ℝ)] with x continuous xne
    apply fixed_band_point_limit time positive x xne (ConstantDual.sawtoothRaw x)
    intro r rPos
    exact point_heat_cold _ (by simpa using limit.mul_const r) x continuous

theorem original_fixed_boundary_hot (time : ℕ → ℝ) (positive : ∀ N, 0 < time N)
    (limit : Tendsto time atTop atTop) (test : SchwartzMap ℝ ℂ) :
    Tendsto (fun N => fixedBoundaryRead (time N) test) atTop (𝓝 0) := by
  have source := fixed_boundary_source_limit time positive (fun _ : ℝ => (0 : ℂ)) test ?_
  · simpa only [mul_zero, integral_zero] using source
  · filter_upwards [volume.ae_ne (0 : ℝ)] with x xne
    have clock := fixed_band_point_limit time positive x xne 0
      (fun r rPos => point_heat_hot _ (limit.atTop_mul_const rPos) x)
    simpa only [mul_zero] using clock

private theorem fixed_band_raw_eq (time x y : ℝ) (positive : 0 < time) (xne : x ≠ 0) :
    ConstantDual.sawtoothRaw y * clockBand time (time*x^4) (x-y) =
      ∫ r : ℝ in 1..x^4, fixedClock time x (r,y) := by
  have xFourth : 0 < x^4 := by nlinarith [sq_pos_of_ne_zero (pow_ne_zero 2 xne)]
  rw [clock_rescale time (x^4) (x-y) positive xFourth, ← intervalIntegral.integral_const_mul]
  apply intervalIntegral.integral_congr
  intro r _
  unfold fixedClock
  ring

private theorem fixed_band_raw_integrable (time x : ℝ) (positive : 0 < time) (xne : x ≠ 0) :
    Integrable (fun y : ℝ => ConstantDual.sawtoothRaw y * clockBand time (time*x^4) (x-y)) := by
  have xFourth : 0 < x^4 := by nlinarith [sq_pos_of_ne_zero (pow_ne_zero 2 xne)]
  have source := (fixed_clock_integrable time (x^4) x positive xFourth).swap.integral_prod_left
  have directed : Integrable (fun y : ℝ => ∫ r : ℝ in 1..x^4, fixedClock time x (r,y)) := by
    simp_rw [intervalIntegral.intervalIntegral_eq_integral_uIoc]
    exact source.smul (if (1 : ℝ) ≤ x^4 then (1 : ℝ) else -1)
  exact directed.congr (Eventually.of_forall (fun y => (fixed_band_raw_eq time x y positive xne).symm))

private theorem boundary_rows_source (time x : ℝ) (positive : 0 < time) (xne : x ≠ 0) :
    (fun y : ℝ => ConstantDual.sawtoothRaw y * clockBand time (time*(x*y)^2) (x-y)) =ᵐ[volume]
      fun y : ℝ => ConstantDual.sawtoothRaw y * clockBand time (time*x^4) (x-y) +
        (tateClockPaid% variableBand) time x y := by
  have xFourth : 0 < x^4 := by nlinarith [sq_pos_of_ne_zero (pow_ne_zero 2 xne)]
  filter_upwards [volume.ae_ne (0 : ℝ)] with y yne
  have xyPos := sq_pos_of_ne_zero (mul_ne_zero xne yne)
  have joined := intervalIntegral.integral_add_adjacent_intervals
    ((tateClockPaid% clock_density_interval) (x-y) time (time*x^4) positive (mul_pos positive xFourth))
    ((tateClockPaid% clock_density_interval) (x-y) (time*x^4) (time*(x*y)^2)
      (mul_pos positive xFourth) (mul_pos positive xyPos))
  change clockBand time (time*x^4) (x-y) + clockBand (time*x^4) (time*(x*y)^2) (x-y) =
    clockBand time (time*(x*y)^2) (x-y) at joined
  rw [← joined, mul_add]
  rfl

private theorem boundary_raw_integrable (time x : ℝ) (positive : 0 < time) (xne : x ≠ 0) :
    Integrable (fun y : ℝ => ConstantDual.sawtoothRaw y * clockBand time (time*(x*y)^2) (x-y)) :=
  ((fixed_band_raw_integrable time x positive xne).add
    ((tateClockPaid% variable_band_integrable) time x positive xne)).congr
      (boundary_rows_source time x positive xne).symm

private theorem boundary_row_split (time x : ℝ) (positive : 0 < time) (xne : x ≠ 0) :
    (∫ y : ℝ, ConstantDual.sawtoothRaw y * clockBand time (time*(x*y)^2) (x-y)) =
      fixedBandInner time x + ∫ y : ℝ, (tateClockPaid% variableBand) time x y := by
  rw [integral_congr_ae (boundary_rows_source time x positive xne),
    integral_add (fixed_band_raw_integrable time x positive xne)
      ((tateClockPaid% variable_band_integrable) time x positive xne)]
  rfl

private theorem boundary_outer_integrable (time : ℝ) (positive : 0 < time) (test : SchwartzMap ℝ ℂ) :
    Integrable (fun x : ℝ => ∫ y : ℝ, star (test x)*ConstantDual.sawtoothRaw y*
      clockBand time (time*(x*y)^2) (x-y)) := by
  let C := (tateClockPaid% bandBudget)*‖ConstantDual.value‖*‖tateClockPaid% tailField‖
  have budget := ((log_weighted_schwartz_integrable test).const_mul 4).add
    (((tateClockPaid% half_weighted_schwartz_integrable) test).const_mul C)
  have clock := (tateClockPaid% clock_band_measured).comp (by fun_prop : Measurable (fun p : ℝ×ℝ =>
    ((time,time*(p.1*p.2)^2),p.1-p.2)))
  have wave : Measurable (fun p : ℝ×ℝ => star (test p.1)*ConstantDual.sawtoothRaw p.2) := by
    unfold ConstantDual.sawtoothRaw
    fun_prop
  apply budget.mono' ((wave.mul clock).stronglyMeasurable.integral_prod_right' (ν := volume)).aestronglyMeasurable
  filter_upwards [volume.ae_ne (0 : ℝ)] with x xne
  dsimp only [Pi.add_apply, Pi.mul_apply, Function.comp_apply]
  simp only [mul_assoc]
  rw [integral_const_mul, boundary_row_split time x positive xne, norm_mul, norm_star]
  have fixed := fixed_band_source_bound time x positive xne
  have varyingBound := (norm_integral_le_integral_norm (μ := volume) ((tateClockPaid% variableBand) time x)).trans
    ((tateClockPaid% variable_band_norm_source) time x positive xne)
  calc
    _ ≤ ‖test x‖ * (‖fixedBandInner time x‖ + ‖∫ y : ℝ, (tateClockPaid% variableBand) time x y‖) :=
      mul_le_mul_of_nonneg_left (norm_add_le _ _) (norm_nonneg _)
    _ ≤ ‖test x‖ * (4*|Real.log (|x|)| + C*(Real.sqrt |x|)⁻¹) := by
      exact mul_le_mul_of_nonneg_left (add_le_add fixed varyingBound) (norm_nonneg _)
    _ = _ := by ring

private theorem boundary_read_split (time : ℝ) (positive : 0 < time) (test : SchwartzMap ℝ ℂ) :
    boundaryRead time test = fixedBoundaryRead time test + boundaryRemainder time test := by
  let variableInner := fun x : ℝ => ∫ y : ℝ, (tateClockPaid% variableBand) time x y
  have fixedInt : Integrable (fun x : ℝ => star (test x) * fixedBandInner time x) := by
    apply ((log_weighted_schwartz_integrable test).const_mul 4).mono'
      (((by fun_prop : Measurable (fun x : ℝ => star (test x))).mul
        (fixed_band_measured time)).aestronglyMeasurable)
    filter_upwards [volume.ae_ne (0 : ℝ)] with x xne
    dsimp only [Pi.mul_apply]
    rw [norm_mul, norm_star]
    have bound := mul_le_mul_of_nonneg_left (fixed_band_source_bound time x positive xne) (norm_nonneg (test x))
    nlinarith
  let C := (tateClockPaid% bandBudget) * ‖ConstantDual.value‖ * ‖tateClockPaid% tailField‖
  have variableInt : Integrable (fun x : ℝ => star (test x) * variableInner x) := by
    apply (((tateClockPaid% half_weighted_schwartz_integrable) test).const_mul C).mono'
      (((by fun_prop : Measurable (fun x : ℝ => star (test x))).mul
        (((tateClockPaid% variable_band_measured) time).stronglyMeasurable.integral_prod_right'
          (ν := volume)).measurable).aestronglyMeasurable)
    filter_upwards [volume.ae_ne (0 : ℝ)] with x xne
    dsimp only [Pi.mul_apply]
    rw [norm_mul, norm_star]
    have source := (tateClockPaid% variable_band_norm_source) time x positive xne
    have actual := norm_integral_le_integral_norm (μ := volume) ((tateClockPaid% variableBand) time x)
    calc
      _ ≤ ‖test x‖ * (C*(Real.sqrt |x|)⁻¹) := by
        exact mul_le_mul_of_nonneg_left (actual.trans source) (norm_nonneg (test x))
      _ = _ := by ring
  have leftRead : fixedBoundaryRead time test = ∫ x : ℝ, star (test x) * fixedBandInner time x := by
    unfold fixedBoundaryRead fixedBandInner
    apply integral_congr_ae
    filter_upwards with x
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with y
    ring
  have rightRead : boundaryRemainder time test = ∫ x : ℝ, star (test x) * variableInner x := by
    unfold boundaryRemainder variableInner
    apply integral_congr_ae
    filter_upwards with x
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with y
    change _ = star (test x) * (ConstantDual.sawtoothRaw y * clockBand (time*x^4) (time*(x*y)^2) (x-y))
    ring
  rw [leftRead, rightRead, ← integral_add fixedInt variableInt]
  unfold boundaryRead
  apply integral_congr_ae
  filter_upwards [volume.ae_ne (0 : ℝ)] with x xne
  simp only [mul_assoc]
  rw [integral_const_mul, boundary_row_split time x positive xne]
  change star (test x) * (fixedBandInner time x + variableInner x) = _
  ring

/-- The inverse clock's entire cold boundary is the original logarithmic contact. -/
theorem original_inverse_boundary_cold (time : ℕ → ℝ) (positive : ∀ N, 0 < time N)
    (limit : Tendsto time atTop (𝓝 0)) (test : SchwartzMap ℝ ℂ) :
    Tendsto (fun N => boundaryRead (time N) test) atTop
      (𝓝 ((4 : ℂ)*inner ℂ (logSchwartzL2 test) ConstantDual.value)) := by
  have source := (original_fixed_boundary_cold time positive limit test).add
    (original_variable_boundary_zero time positive (Or.inl limit) test)
  apply (show Tendsto (fun N => fixedBoundaryRead (time N) test + boundaryRemainder (time N) test)
      atTop (𝓝 ((4 : ℂ)*inner ℂ (logSchwartzL2 test) ConstantDual.value)) by simpa only [add_zero] using source).congr'
  exact Eventually.of_forall (fun N => (boundary_read_split (time N) (positive N) test).symm)

theorem original_inverse_boundary_hot (time : ℕ → ℝ) (positive : ∀ N, 0 < time N)
    (limit : Tendsto time atTop atTop) (test : SchwartzMap ℝ ℂ) :
    Tendsto (fun N => boundaryRead (time N) test) atTop (𝓝 0) := by
  have source := (original_fixed_boundary_hot time positive limit test).add
    (original_variable_boundary_zero time positive (Or.inr limit) test)
  apply (show Tendsto (fun N => fixedBoundaryRead (time N) test + boundaryRemainder (time N) test)
      atTop (𝓝 0) by simpa only [add_zero] using source).congr'
  exact Eventually.of_forall (fun N => (boundary_read_split (time N) (positive N) test).symm)

private def logCut (N : ℕ) (x : ℝ) : ℝ := (gaussianPaid% heatLogCut) N x

private theorem log_cut_dominate (N : ℕ) (v logged : BurnolL2) (domain : LogPair v logged) :
    ∀ᵐ x : ℝ ∂volume, ‖((logCut N x : ℝ) : ℂ) * v x‖ ≤ 2 * ‖logged x‖ := by
  filter_upwards [domain, volume.ae_ne (0 : ℝ)] with x actual xne
  rw [actual, norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, Complex.norm_real, Real.norm_eq_abs]
  calc
    _ ≤ (2*|Real.log (|x|)|)*‖v x‖ := by
      gcongr
      exact (gaussianPaid% heat_log_cut_bound) N x xne
    _ = _ := by ring

private theorem log_cut_mem (N : ℕ) (v logged : BurnolL2) (domain : LogPair v logged) :
    MemLp (fun x : ℝ => ((logCut N x : ℝ) : ℂ)*v x) 2 volume := by
  apply ((Lp.memLp logged).norm.const_mul 2).of_le
    (((gaussianPaid% heat_log_cut_measurable) N).complex_ofReal.aestronglyMeasurable.mul (Lp.aestronglyMeasurable v))
  filter_upwards [log_cut_dominate N v logged domain] with x actual
  simpa only [Pi.mul_apply, logCut, Real.norm_of_nonneg (by positivity : 0 ≤ 2*‖logged x‖)] using actual

private def cutField (N : ℕ) (v logged : BurnolL2) (domain : LogPair v logged) : BurnolL2 :=
  (log_cut_mem N v logged domain).toLp (fun x : ℝ => ((logCut N x : ℝ) : ℂ)*v x)

private theorem cut_field_raw (N : ℕ) (v logged : BurnolL2) (domain : LogPair v logged) :
    (cutField N v logged domain : ℝ → ℂ) =ᵐ[volume] fun x : ℝ => ((logCut N x : ℝ) : ℂ)*v x := MemLp.coeFn_toLp _

private theorem cut_field_source_limit (v logged : BurnolL2) (domain : LogPair v logged) :
    Tendsto (fun N => cutField N v logged domain) atTop (𝓝 logged) := by
  let raw := fun N x => ((logCut N x : ℝ) : ℂ)*v x
  have measured (N : ℕ) : MemLp (raw N) 2 volume := log_cut_mem N v logged domain
  have energy := tendsto_integral_of_dominated_convergence (fun x : ℝ => 9*‖logged x‖^2)
    («F» := fun N x => ‖raw N x-logged x‖^2) (f := fun _ : ℝ => (0 : ℝ))
