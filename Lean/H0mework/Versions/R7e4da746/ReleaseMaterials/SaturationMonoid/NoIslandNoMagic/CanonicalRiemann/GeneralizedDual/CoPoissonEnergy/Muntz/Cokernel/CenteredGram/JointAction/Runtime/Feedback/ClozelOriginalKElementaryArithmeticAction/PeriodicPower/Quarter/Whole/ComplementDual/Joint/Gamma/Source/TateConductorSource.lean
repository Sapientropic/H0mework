  filter_upwards [Measure.quasiMeasurePreserving_fst.ae (ae_restrict_mem measurableSet_uIoc)] with p inside
  have positive := lt_of_lt_of_le (lt_min lowerPos upperPos) inside.1.le
  have difference : ‖(((Real.exp (-p.1) : ℝ) : ℂ)-((Real.exp (-(p.1*p.2^2)) : ℝ) : ℂ))‖ ≤ 2 := by
    calc
      _ ≤ ‖((Real.exp (-p.1) : ℝ) : ℂ)‖ + ‖((Real.exp (-(p.1*p.2^2)) : ℝ) : ℂ)‖ := norm_sub_le _ _
      _ = Real.exp (-p.1)+Real.exp (-(p.1*p.2^2)) := by
        simp only [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
      _ ≤ 2 := by
        have first := Real.exp_le_one_iff.mpr (neg_nonpos.mpr positive.le)
