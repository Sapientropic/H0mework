private theorem clock_frequency_point (time : ℝ) (positive : 0 < time) (u v : BurnolL2) :
    (∫ frequency : ℝ, clockFrequency u v (time,frequency)) =
      (time : ℂ)⁻¹ * (((Real.exp (-time) : ℝ) : ℂ)*inner ℂ u v -
        inner ℂ u (heatMultiplier time positive.le v)) := by
