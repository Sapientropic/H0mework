    funext frequency
    unfold clockFrequency
    ring
  have product : Integrable (fun frequency : ℝ => star (u frequency)*v frequency) := by
    apply (L2.integrable_inner (𝕜 := ℂ) u v).congr
    filter_upwards with frequency
    rw [RCLike.inner_apply, starRingEnd_apply]
    ring
  have heated : Integrable (fun frequency : ℝ => star (u frequency)*
