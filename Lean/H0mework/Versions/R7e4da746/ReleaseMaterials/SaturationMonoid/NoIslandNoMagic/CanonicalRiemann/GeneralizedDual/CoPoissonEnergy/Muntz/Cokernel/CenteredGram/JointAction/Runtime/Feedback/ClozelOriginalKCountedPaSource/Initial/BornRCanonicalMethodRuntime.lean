 (H.admitted observation nontrivial half depth ordinal).target
 (Registry.Stock.read initial) (Registry.noFaithful initial)

theorem exact_initial : (sourceRuntime observation nontrivial half depth ordinal).initialState.engine.node.erase=
 ⟨(observedAdmissionTarget observation nontrivial half depth ordinal).TargetN,
  (observedAdmissionTarget observation nontrivial half depth ordinal).targetAnswerAndNext.nextCurrent⟩ := by
 have original:=SourceOperationNative.Tree.Fold.Dependent.Branch.JointQuery.Actor.Operation.Query.Inventory.Observer.CurrentChild.Dynamic.Live.Native.Action.Intake.Lower.target_next
  sourceBorn C.sourceConfiguration pR
  (SourceGeneratedInquiryReceiptAction.sourceEvent sourceBorn C.sourceConfiguration)
 have generated:=(observed_target_next observation nontrivial half depth ordinal).trans
  (congrArg (fun current=>Registry.Material.current current (Registry.Stock.read initial)) original)
 have wrapped:=congrArg
  (fun current=>(⟨(observedAdmissionTarget observation nontrivial half depth ordinal).TargetN,current⟩ :
   AnyAuthoritativeRootCurrent)) generated
 exact wrapped.symm

def first_typed_activation :=
 PProd.mk (exact_initial observation nontrivial half depth ordinal) <|
 PProd.mk (observed_target_next observation nontrivial half depth ordinal) <|
 PProd.mk (SF.actual_first_activation_full factory initial pR rfl)
 (SF.actual_whole factory initial pR rfl 0)
