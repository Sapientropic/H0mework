theorem completePairOutput_query (n:Nat)
 (seed:RootedAccountedUnfolding (PresentedRelationEventAt (Expr (Lower.Value W n) X slot)))
 (frame:RootGeneratedDebtActivationJointSource.Successor.Inquiry.Continuation.Frame
  (Value:=Lower.Value W n) (Var:=X) (sort:=slot)) :
 ∀ event∈(completeQueryWritten n frame).trace,event∈(completePairOutput n seed frame).trace := by
 unfold completePairOutput Stock.preserve
 cases (SF.defaultFactory W X slot).nextPairInventory n seed frame with
 | none=>exact fun _ present=>present
 | some prior=>exact (SourceHistoryCommon.parallel_right _ _ _).1

