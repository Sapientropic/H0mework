local notation "slot"=>CountedPaInitial.CompletedSourceRCalculation.Slot.branches
local instance levelGroups (n:Nat) (s:CountedPaInitial.CompletedSourceRCalculation.Slot) :
 AddCommGroup (Lower.Value W n s) := Lower.groups W n s
private def pairAction {A:Type} [AddCommGroup A] (r:A→+A) : A×A→+A×A where
 toFun:=fun value=>(r value.1,r value.2)
 map_zero':=Prod.ext r.map_zero r.map_zero
 map_add':=fun left right=>Prod.ext (r.map_add left.1 right.1) (r.map_add left.2 right.2)
private def baseAction : W slot→+W slot :=
 let r:=(OriginalKFullSourceRAction.variableAction observation nontrivial half).toLinearMap.toAddMonoidHom
 r.prodMap r

def actionAt (n:Nat) : Lower.Value W n slot→+Lower.Value W n slot := by
 induction n with
 | zero=>exact baseAction observation nontrivial half
 | succ n previous=>
  exact @pairAction (Lower.Value W n slot)
   (Lower.groups W n slot) previous

private def retainedCode (n:Nat)
 (frame:RootGeneratedDebtActivationJointSource.Successor.Inquiry.Continuation.Frame
  (Value:=Lower.Value W n) (Var:=X) (sort:=slot)) : Expr (Lower.Value W n) X slot :=
 match frame.registered.input.expression with
 | .add (.add _ paid) _=>.linear (-AddMonoidHom.id (Lower.Value W n slot)) paid
 | .add _ paid=>.linear (-AddMonoidHom.id (Lower.Value W n slot)) paid
 | source=>source

private def raw (n:Nat)
 (frame:RootGeneratedDebtActivationJointSource.Successor.Inquiry.Continuation.Frame
  (Value:=Lower.Value W n) (Var:=X) (sort:=slot)) :
 RootGeneratedDebtActivationJointSource.OwnerFree.Raw
  (Value:=PairValue (Lower.Value W n)) (Var:=X) (sort:=slot) :=
 ⟨pairEnvironment frame.registered.input.environment 0,
  .linear (@pairAction (Lower.Value W n slot)
   (Lower.groups W n slot)
   (actionAt observation nontrivial half n))
   (liftExpr (retainedCode n frame))⟩

