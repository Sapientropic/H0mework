def nativeGammaActionOccurrence (n:Nat) (seed:SF.Seed (W:=W) (X:=X) (s:=slot) n)
 (frame:RootGeneratedDebtActivationJointSource.Successor.Inquiry.Continuation.Frame
  (Value:=Lower.Value W n) (Var:=X) (sort:=slot)) :
 SourceInventoryExecutionFeed.AdmissionReceipt.GeneratorOccurrence
  (nativeGammaActionScalar observation nontrivial half n seed frame) where
 before := (nativeWordScalar observation nontrivial half n seed frame).root ::
  (nativeWordScalar observation nontrivial half n seed frame).trace
 expression := BornRNativeGammaInstall.ActionSource.atGrade observation nontrivial half
  (nativeGammaActionData observation nontrivial half n frame) (n+1)
 after := []
 trace_eq := rfl

def fixedRFactory : SF.Factory W X slot :=
 SourceFamilyCurrentAffineWrite.enrich
 { SF.defaultFactory W X slot with
   nextPairInventory:=fun n seed frame=>some (completePairOutput n seed frame)
   extraScalar:=fun n seed frame=>some (nativeGammaActionScalar observation nontrivial half n seed frame)
   datum:=fun n _seed frame=>
    { component:=some (nativeSourceComponent observation nontrivial half n frame)
      reader:=fun {_current} _supplied=>raw observation nontrivial half n frame
      calculationReader:=some (fun {_current} _supplied=>raw observation nontrivial half n frame) } }
theorem fixedRFactory_extraScalar (n:Nat) (seed:SF.Seed (W:=W) (X:=X) (s:=slot) n)
 (frame:RootGeneratedDebtActivationJointSource.Successor.Inquiry.Continuation.Frame
  (Value:=Lower.Value W n) (Var:=X) (sort:=slot)) :
 (fixedRFactory observation nontrivial half).extraScalar n seed frame =
  some (nativeGammaActionScalar observation nontrivial half n seed frame) := rfl

