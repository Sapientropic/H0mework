/-- An exact reverse slot selects its source Step's full Joint contribution and future fibre. -/
def actualSourceStepJointBlock :=
  fun (position : Nat) word lower upper actual =>
    let source := readSource position word lower upper actual
    let index := source.origin.sourceIndex
    let choice := selectedAt index
    let joint := stepCochain index
    PProd.mk source <|
    PProd.mk (Batch.sourceRequestAt_interval_address factory current born _ source.origin) <|
    PProd.mk (stepJoint index) <|
    PProd.mk (stepAtJoint index) <|
    PProd.mk joint <|
    PProd.mk (Cx.completion_kills_generated_differential (jointHistoryAt nextSite) joint)
      (Interval.actual_interval_fibre observation nontrivial half depth ordinal method choice.first choice.count)

