local notation "base" => (Cfa.nativePacket fac packet).2.2.1
local notation "decoder" => Cfa.stockDecodedEnvironment frame base
local notation "stock" => Cfa.bornStock fac packet
local notation "installed" => Cfa.born_inventory fac packet

private theorem intervalWrite_action
    (language : packet.2.2.1.LowVar = A.X) (same : Cfa.packetTransport language native = target)
    (next : Cfa.bornAfterNative (Cfa.nativeAfterAdmission fac packet) = target)
    (source : RF.RelationAt packet)
    (requests : List (F.Request (V := Cfa.Value A.W (native).1) (X := packet.2.2.1.LowVar) (s := slot)))
    (block : OccurrenceBlock (F.executedTrace decoder requests) (stock).trace)
    (balance : ((requests.map (F.requestWord decoder)).sum) = F.affine decoder (Cfa.sourceWordAction packet source.val)) :
    intervalWrite native target language same stock installed decoder requests block =
      transportRelation next (RF.actionNextRelation fac packet source) := by
  apply relation_eq
  let total := (requests.map (F.requestWord decoder)).sum
  let acted := Cfa.sourceWordAction packet source.val
  have read : HEq (intervalWrite native target language same stock installed decoder requests block).val total :=
    reindexed_word_source native target language same total
  have equation : (RF.actionRelation fac packet source).val =
      F.affine (Shared.nextBorn frame (Cfa.stockCfg base)).activeEnvironment acted :=
    RF.actionRelation_equation fac packet source
  have decoderEq := congrArg (fun env => F.affine env acted) (Cfa.decoded_environment frame base)
  have old := (transportRelation_source next (RF.actionNextRelation fac packet source)).trans
    ((RF.actionNextRelation_source fac packet source).trans
      (heq_of_eq (equation.trans (decoderEq.trans balance.symm))))
  exact eq_of_heq (read.trans old.symm)
end Action
