private theorem reindexed_boundary_member
    (native : Cfa.AdmissionPacket (W := A.W) (X := X) (s := slot))
    (target : Cfa.AdmissionPacket (W := A.W) (X := Y) (s := slot))
    (language : X = Y) (same : Cfa.packetTransport language native = target)
    (stock : R.InventoryAt native) (installed : native.2.1.1.inventory = some stock)
    (decoder : Env (Cfa.Value A.W native.1) X)
    (requests : List (F.Request (V := Cfa.Value A.W native.1) (X := X) (s := slot)))
    (block : OccurrenceBlock (F.executedTrace decoder requests) stock.trace) :
    M.packetWordTransport same (M.packetLanguageWord language native
      ((requests.map (F.requestWord decoder)).sum)) ∈
      F.relationSpace (block_reindex native target language same stock installed
        (F.executedTrace decoder requests) block).1 := by
  cases language
  cases same
  have identityBlock : OccurrenceBlock ((F.executedTrace decoder requests).map id) stock.trace := by
    simpa only [List.map_id] using block
  exact mapped_boundary_member decoder requests id (LinearMap.id) (fun _ => rfl) identityBlock

private theorem reindexed_joint_member
    (native : Cfa.AdmissionPacket (W := A.W) (X := X) (s := slot))
    (target : Cfa.AdmissionPacket (W := A.W) (X := Y) (s := slot))
    (language : X = Y) (same : Cfa.packetTransport language native = target)
    (stock : R.InventoryAt native) (installed : native.2.1.1.inventory = some stock)
    (decoder : Env (Cfa.Value A.W native.1) X)
    (requests : List (F.Request (V := Cfa.Value A.W native.1) (X := X) (s := slot)))
    (block : OccurrenceBlock (F.executedTrace decoder requests) stock.trace)
    (jointStock : F.Inventory (V := PairValue (Cfa.Value A.W target.1)) (X := Y) (s := slot))
    (jointBlock : OccurrenceBlock
      (((block_reindex native target language same stock installed
        (F.executedTrace decoder requests) block).2.1).map Pair.liftEvent) jointStock.trace) :
    liftMap (R := ℤ) (M.packetWordTransport same (M.packetLanguageWord language native
      ((requests.map (F.requestWord decoder)).sum))) ∈ F.relationSpace jointStock := by
  cases language
  cases same
  exact mapped_boundary_member decoder requests Pair.liftEvent (liftMap (R := ℤ))
    (fun _ => rfl) jointBlock

private theorem reindexed_word_source
    (native : Cfa.AdmissionPacket (W := A.W) (X := X) (s := slot))
    (target : Cfa.AdmissionPacket (W := A.W) (X := Y) (s := slot))
    (language : X = Y) (same : Cfa.packetTransport language native = target)
    (word : Formal ℤ (Cfa.Value A.W native.1) X slot) :
    HEq (M.packetWordTransport same (M.packetLanguageWord language native word)) word := by
  cases language
  cases same
  exact HEq.rfl

private theorem relation_eq
    {packet : Cfa.AdmissionPacket (W := A.W) (X := X) (s := slot)}
    (left right : RF.RelationAt packet) (same : left.val = right.val) : left = right := by
  rcases left with ⟨stock, installed, word, member⟩
  rcases right with ⟨other, recognized, value, belongs⟩
  have stockEq : stock = other := Option.some.inj (installed.symm.trans recognized)
  change word = value at same
  cases stockEq
  cases same
  rfl

