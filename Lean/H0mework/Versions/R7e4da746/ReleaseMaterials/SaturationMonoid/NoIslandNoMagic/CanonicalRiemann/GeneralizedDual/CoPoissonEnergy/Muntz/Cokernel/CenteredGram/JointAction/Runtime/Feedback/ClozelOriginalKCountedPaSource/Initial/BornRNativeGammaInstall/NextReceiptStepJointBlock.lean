private theorem mapped_boundary_member {S : Type u} {V W X : S → Type u}
    [∀ t, AddCommGroup (V t)] [∀ t, AddCommGroup (W t)] {s : S}
    (decoder : Env V X) (requests : List (F.Request (V := V) (X := X) (s := s)))
    (eventMap : F.Event (V := V) (X := X) (s := s) → F.Event (V := W) (X := X) (s := s))
    (wordMap : Formal ℤ V X s →ₗ[ℤ] Formal ℤ W X s)
    (relationMap : ∀ word, eventMap (.relation word) = .relation (wordMap word))
    {stock : F.Inventory (V := W) (X := X) (s := s)}
    (block : OccurrenceBlock ((F.executedTrace decoder requests).map eventMap) stock.trace) :
    wordMap ((requests.map (F.requestWord decoder)).sum) ∈ F.relationSpace stock := by
  rw [map_list_sum, List.map_map]
  apply _root_.list_sum_mem
  intro value member
  obtain ⟨request, present, rfl⟩ := List.mem_map.mp member
  change wordMap (request.coefficient • (P.words (F.receipt decoder request)).sum) ∈ _
  rw [map_smul, map_list_sum]
  apply Submodule.smul_mem
  apply _root_.list_sum_mem
  intro image member
  obtain ⟨word, paid, rfl⟩ := List.mem_map.mp member
  have event := request_exposure decoder requests request present
    (.relation word) (word_exposure (F.receipt decoder request) word paid)
  have lifted : .relation (wordMap word) ∈ (F.executedTrace decoder requests).map eventMap :=
    (relationMap word) ▸ List.mem_map_of_mem event
  apply Submodule.subset_span
  change PresentedRelationEventAt.relation (wordMap word) ∈ stock.trace
  rw [block.trace_eq]
  exact List.mem_append_left _ (List.mem_append_right _ lifted)

