private def jointBlockOf
    (packet : Cfa.AdmissionPacket (W := A.W) (X := A.X) (s := slot))
    (stock : R.InventoryAt packet) (installed : packet.2.1.1.inventory = some stock)
    (events : List (F.Event (V := Cfa.Value A.W packet.1) (X := A.X) (s := slot)))
    (block : OccurrenceBlock events stock.trace) :
    OccurrenceBlock (events.map Pair.liftEvent) (jointInventoryAt packet).trace := by
  let joint : SourceInventoryTraceSegment (stock.map Pair.liftEvent) (jointInventoryAt packet) :=
    Pair.installedScalarSegment (I.seed packet.2.1.1) packet.2.1.1 stock installed
  have mapped : (stock.map Pair.liftEvent).trace =
      block.before.map Pair.liftEvent ++ events.map Pair.liftEvent ++ block.after.map Pair.liftEvent :=
    (Stock.mapped_trace Pair.liftEvent stock).trans
      ((congrArg (List.map Pair.liftEvent) block.trace_eq).trans (by simp only [List.map_append]))
  refine ⟨joint.before ++ block.before.map Pair.liftEvent,
    block.after.map Pair.liftEvent ++ joint.after, joint.trace_eq.trans ?_⟩
  exact (congrArg (fun middle => joint.before ++ middle ++ joint.after) mapped).trans
    (by simp only [List.append_assoc])

private theorem jointBlockOf_position
    (packet : Cfa.AdmissionPacket (W := A.W) (X := A.X) (s := slot))
    (stock : R.InventoryAt packet) (installed : packet.2.1.1.inventory = some stock)
    (events : List (F.Event (V := Cfa.Value A.W packet.1) (X := A.X) (s := slot)))
    (block : OccurrenceBlock events stock.trace) :
    (jointBlockOf packet stock installed events block).before.length =
      (Pair.installedScalarSegment (I.seed packet.2.1.1) packet.2.1.1 stock installed).before.length +
        block.before.length := by
  let segment := Pair.installedScalarSegment (I.seed packet.2.1.1) packet.2.1.1 stock installed
  exact List.length_append.trans (congrArg (segment.before.length + ·) (List.length_map Pair.liftEvent))
private def intervalWrite
    (native : Cfa.AdmissionPacket (W := A.W) (X := X) (s := slot))
    (target : Cfa.AdmissionPacket (W := A.W) (X := Y) (s := slot))
    (language : X = Y) (same : Cfa.packetTransport language native = target)
    (stock : R.InventoryAt native) (installed : native.2.1.1.inventory = some stock)
    (decoder : Env (Cfa.Value A.W native.1) X)
    (requests : List (F.Request (V := Cfa.Value A.W native.1) (X := X) (s := slot)))
    (block : OccurrenceBlock (F.executedTrace decoder requests) stock.trace) :
    RF.RelationAt target :=
  let literal := block_reindex native target language same stock installed (F.executedTrace decoder requests) block
  ⟨literal.1, literal.2.2.property.1,
    M.packetWordTransport same (M.packetLanguageWord language native ((requests.map (F.requestWord decoder)).sum)),
    reindexed_boundary_member native target language same stock installed decoder requests block⟩

private def intervalJoint
    (native : Cfa.AdmissionPacket (W := A.W) (X := X) (s := slot))
    (target : Cfa.AdmissionPacket (W := A.W) (X := A.X) (s := slot))
    (language : X = A.X) (same : Cfa.packetTransport language native = target)
    (stock : R.InventoryAt native) (installed : native.2.1.1.inventory = some stock)
    (decoder : Env (Cfa.Value A.W native.1) X)
    (requests : List (F.Request (V := Cfa.Value A.W native.1) (X := X) (s := slot)))
    (block : OccurrenceBlock (F.executedTrace decoder requests) stock.trace) :
    (jointHistoryAt target).relationClosure := by
  let literal := block_reindex native target language same stock installed (F.executedTrace decoder requests) block
  let paired := jointBlockOf target literal.1 literal.2.2.property.1 literal.2.1 literal.2.2.val
  let value := M.packetWordTransport same (M.packetLanguageWord language native
    ((requests.map (F.requestWord decoder)).sum))
  refine ⟨liftMap (R := ℤ) value, ?_⟩
  have member := reindexed_joint_member native target language same stock installed decoder requests block
    (jointInventoryAt target) paired
  simpa only [jointHistoryAt, F.history_relation_space] using member

private theorem intervalJoint_source
    (native : Cfa.AdmissionPacket (W := A.W) (X := X) (s := slot))
    (target : Cfa.AdmissionPacket (W := A.W) (X := A.X) (s := slot))
    (language : X = A.X) (same : Cfa.packetTransport language native = target)
    (stock : R.InventoryAt native) (installed : native.2.1.1.inventory = some stock)
    (decoder : Env (Cfa.Value A.W native.1) X)
    (requests : List (F.Request (V := Cfa.Value A.W native.1) (X := X) (s := slot)))
    (block : OccurrenceBlock (F.executedTrace decoder requests) stock.trace) :
    intervalJoint native target language same stock installed decoder requests block =
      jointFromRelation (intervalWrite native target language same stock installed decoder requests block) := by
  apply Subtype.ext
  rfl

