private theorem elementary_projection (c:BurnolCompletedMellinCoordinate):
    P (elementarySource c)=burnolCompletedMellinRieszVector c:=by
  unfold elementarySource
  have odd:P (burnolAmbientCompletedMellinKernelFormula c-
      burnolAmbientEvenPart (burnolAmbientCompletedMellinKernelFormula c))=0:=by
    apply Submodule.orthogonalProjectionOnto_eq_zero_iff.mpr
    intro test membership
    rw [inner_eq_zero_symm]
    exact burnolAmbientOddResidual_inner_physical_eq_zero _ ⟨test,membership⟩
  rw [map_sub] at odd
  rw [←sub_eq_zero.mp odd]
  rw [←burnolAmbientCompletedMellinRieszVector_eq_kernelFormula,
    burnolCompletedMellinRieszVector_eq_ambientProjection]
  rfl

/-- The original K and the complete compact Unit are generated by this actual full source. -/
theorem actual_joint_physical_source (c:BurnolCompletedMellinCoordinate):
    P (jointSource c)=burnolQuarterMeanCoefficient (Rq (quarterWave c)) • P (E Cq)-
      F (burnolCompletedMellinRieszVector c):=by
  rw [jointSource,map_add,map_sub,projection_fourier,
    meanZero_extension_orthogonal,map_zero,add_zero,ForcingWhole.whole,projection_fourier]
  change P (E (OriginalKElementaryArithmeticAction.PeriodicPower.Endpoint.Source.periodicQuarter c))-F (P (elementarySource c))=_
  rw [actual_compact_projection,elementary_projection,quarterWave,burnolQuarterRestriction_zeroExtension]

private theorem source_fourier_compact_zero (c:BurnolCompletedMellinCoordinate) (j:ℕ) (state:M):
    inner ℂ (sourceField c j) (fourierL2 (E (state:Hq)))=0:=by
  have transformed:=fourierL2.inner_map_map (fourierL2.symm (sourceField c j)) (E (state:Hq))
  rw [fourierL2.apply_symm_apply] at transformed
  rw [transformed,show E=burnolQuarterRestriction.adjoint from rfl,ContinuousLinearMap.adjoint_inner_right,
    source_inverseFourier_quarter,inner_smul_left]
  have zero:inner ℂ Cq (state:Hq)=0:=
    (Submodule.mem_orthogonal _ _).mp state.property _ (Submodule.mem_span_singleton_self _)
  rw [zero,mul_zero]

/-- The actual mean-zero correction is consumed at every full adjoint source order. -/
theorem actual_joint_complete_source_price (c:BurnolCompletedMellinCoordinate) (j:ℕ):
    inner ℂ (sourceField c j) (jointSource c)=
      inner ℂ (sourceField c j) (quarterWave c)-
        inner ℂ (sourceField c j) (ForcingWhole.whole c):=by
