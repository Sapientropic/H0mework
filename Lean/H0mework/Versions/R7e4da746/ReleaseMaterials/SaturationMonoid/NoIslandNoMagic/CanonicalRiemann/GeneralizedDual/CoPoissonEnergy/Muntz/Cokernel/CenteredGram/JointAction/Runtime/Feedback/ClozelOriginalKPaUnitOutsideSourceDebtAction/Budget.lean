/-- This finite conservation is generated by the actual unitary source action, for every mathematical shift. -/
theorem source_split_finite_budget (source : Branches) (shift : ℝ) :
 fullSplitBudget (splitAction shift source)=fullSplitBudget (splitAction 0 source) := by
 change fullSplitBudget (splitProjection (burnolMultiplicativeDilation (-shift/2) (sourceRRead source))) =
 fullSplitBudget (splitProjection (burnolMultiplicativeDilation (-(0 : ℝ)/2) (sourceRRead source)))
 rw [split_projection_full_budget,split_projection_full_budget]
 rw [(burnolMultiplicativeDilation (-shift/2)).norm_map,(burnolMultiplicativeDilation (-(0 : ℝ)/2)).norm_map]

