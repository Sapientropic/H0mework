def fullSplitBudget (stock : Branches) : ℝ := ‖stock.1.1‖^2+‖stock.1.2‖^2+‖stock.2.1‖^2

/-- Both exact source projections are used, retaining the whole outside and unit costs. -/
theorem split_projection_full_budget (value : BurnolL2) : fullSplitBudget (splitProjection value)=‖value‖^2 := by
 have physical := Submodule.norm_sq_eq_add_norm_sq_starProjection value BurnolPaAmbientCarrier
 have pa := Submodule.norm_sq_eq_add_norm_sq_starProjection (burnolEvenAmbientProjection value)
  burnolCompactCoPoissonClosedRange.toSubmodule
 change ‖value‖^2=‖burnolEvenAmbientProjection value‖^2+‖outsideProjection value‖^2 at physical
 change ‖burnolEvenAmbientProjection value‖^2=‖paProjection value‖^2+‖unitProjection value‖^2 at pa
 change ‖paProjection value‖^2+‖unitProjection value‖^2+‖outsideProjection value‖^2=‖value‖^2
