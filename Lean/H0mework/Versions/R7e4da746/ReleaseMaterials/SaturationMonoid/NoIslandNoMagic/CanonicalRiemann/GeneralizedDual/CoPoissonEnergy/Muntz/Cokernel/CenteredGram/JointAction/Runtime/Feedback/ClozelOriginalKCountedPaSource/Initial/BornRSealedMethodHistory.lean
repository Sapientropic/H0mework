/-- This is a restriction of the actual complete carrier, before the physical projection. -/

theorem wholeProjection_action (n:Nat) (value:Lower.Value A.W n slot) :
 wholeProjection n (A.actionAt observation nontrivial half n value)=
 OriginalKFullSourceRAction.variableAction observation nontrivial half (wholeProjection n value) := by
 induction n with
 | zero=>rfl
 | succ n previous=>exact previous value.1

def packetStock (packet:AS.AdmissionPacket (W:=A.W) (X:=A.X) (s:=slot)) : C.Value slot :=
 wholeProjection packet.1
  (R.actionResultAt packet.2.1.1 packet.2.2.1 (S.actualOccurrence packet.2.1.1)).2.2.1.1

theorem initialStock_read
 (sourceFactory:SF.Factory A.W A.X slot)
 (frame:RootGeneratedDebtActivationJointSource.Successor.Inquiry.Continuation.Frame
  (Value:=A.W) (Var:=A.X) (sort:=slot))
 (cfg:SourceOperationInquiry.Context.Faces.Execution.Activation.Programme
  (PhysicalValue:=A.W) (PhysicalVar:=A.X) (sort:=slot)) (language:cfg.LowVar=A.X) :
 packetStock (Admissions.packetAt sourceFactory frame cfg language 0)=
  (R.actionResultAt frame cfg (S.actualOccurrence frame)).2.2.1.1.1 := by
 rw [Generic.initial_packet frame cfg sourceFactory language]
 rfl

theorem initialStock_value
 (sourceFactory:SF.Factory A.W A.X slot)
 (frame:RootGeneratedDebtActivationJointSource.Successor.Inquiry.Continuation.Frame
  (Value:=A.W) (Var:=A.X) (sort:=slot))
 (cfg:SourceOperationInquiry.Context.Faces.Execution.Activation.Programme
  (PhysicalValue:=A.W) (PhysicalVar:=A.X) (sort:=slot)) (language:cfg.LowVar=A.X)
 (value:C.Value slot)
 (paid:(R.actionResultAt frame cfg (S.actualOccurrence frame)).2.2.1=((value,0),0)) :
 packetStock (Admissions.packetAt sourceFactory frame cfg language 0)=value := by
 have first:=initialStock_read sourceFactory frame cfg language
 exact first.trans (congrArg (fun result:PairValue A.W slot=>result.1.1) paid)

theorem wholeStep_restriction
 (packet next:AS.AdmissionPacket (W:=A.W) (X:=A.X) (s:=slot))
 (grade:next.1=packet.1+1)
 (step:BornRActualMethodAction.WholeStep observation nontrivial half packet next) :
 packetStock next=OriginalKFullSourceRAction.variableAction observation nontrivial half (packetStock packet) := by
 rcases packet with ⟨n,⟨frame,seed⟩,cfg,language⟩
 rcases next with ⟨m,⟨nextFrame,nextSeed⟩,nextCfg,nextLanguage⟩
 change m=n+1 at grade
 cases grade
 unfold packetStock
 unfold BornRActualMethodAction.WholeStep at step
 have read:=congrArg (fun value:PairValue (Lower.Value A.W (n+1)) slot=>wholeProjection (n+1) value.1)
  (eq_of_heq step)
 have action:=wholeProjection_action observation nontrivial half (n+1)
  (R.actionResultAt frame cfg (S.actualOccurrence frame)).2.2.1
 exact read.trans action


private theorem wholeProjection_add (n:Nat) (left right:Lower.Value A.W n slot) :
 wholeProjection n (left+right)=wholeProjection n left+wholeProjection n right := by
 induction n with
 | zero=>rfl
 | succ n previous=>exact previous left.1 right.1

-- Both coordinates are evaluated at THIS math residual's current environment.
def actionCurrentCoordinates (packet:AS.AdmissionPacket (W:=A.W) (X:=A.X) (s:=slot)) : C.Value slot×C.Value slot := by
 rcases packet with ⟨n,⟨source,seed⟩,⟨Y,datum,inventory,pairInventory⟩,⟨language⟩⟩
 cases language
 let cfg:SourceOperationInquiry.Context.Faces.Execution.Activation.Programme
  (PhysicalValue:=Lower.Value A.W n) (PhysicalVar:=A.X) (sort:=slot):=
  {LowVar:=A.X,datum:=datum,nextInventory:=inventory,nextPairInventory:=pairInventory}
 let packet:AS.AdmissionPacket (W:=A.W) (X:=A.X) (s:=slot):=⟨n,⟨source,seed⟩,cfg,⟨rfl⟩⟩
 let native:=AS.nativeAfterAdmission factory packet
 let frame:RootGeneratedDebtActivationJointSource.Successor.Inquiry.Continuation.Frame
  (Value:=Lower.Value A.W (n+1)) (Var:=A.X) (sort:=slot):=selected native
 let environment:Env (Lower.Value A.W (n+1)) A.X:=Affine.updatedEnvironment (Act.epoch frame) (S.actualOccurrence frame)
 let action:=R.actualMaterial source cfg
 exact (wholeProjection (n+1) (action.raw.eval environment),
  wholeProjection (n+1) (action.state.1.eval environment))

def affineMathPaid (packet:AS.AdmissionPacket (W:=A.W) (X:=A.X) (s:=slot)) : C.Value slot :=
 let native:=AS.nativeAfterAdmission factory packet
 let frame:=selected native
 let m:=Affine.paid (Act.epoch frame) (S.actualOccurrence frame)
 wholeProjection native.1 (m.state.1.eval (Affine.updatedEnvironment (Act.epoch frame) (S.actualOccurrence frame)))

def affineResidual (packet:AS.AdmissionPacket (W:=A.W) (X:=A.X) (s:=slot)) : C.Value slot :=
 let native:=AS.nativeAfterAdmission factory packet
 let frame:=selected native
 wholeProjection native.1 (ScalarRelationPresentation.freeEvaluation (R:=ℤ) (Lower.Value A.W native.1 slot)
  (Affine.nu (Act.epoch frame) (S.actualOccurrence frame)))

theorem current_request_telescope (packet:AS.AdmissionPacket (W:=A.W) (X:=A.X) (s:=slot)) :
 (actionCurrentCoordinates observation nontrivial half packet).1=
 (actionCurrentCoordinates observation nontrivial half packet).2+
 affineMathPaid observation nontrivial half packet+affineResidual observation nontrivial half packet := by
 rcases packet with ⟨n,⟨source,seed⟩,⟨Y,datum,inventory,pairInventory⟩,⟨language⟩⟩
 cases language
 let cfg:SourceOperationInquiry.Context.Faces.Execution.Activation.Programme
  (PhysicalValue:=Lower.Value A.W n) (PhysicalVar:=A.X) (sort:=slot):=
  {LowVar:=A.X,datum:=datum,nextInventory:=inventory,nextPairInventory:=pairInventory}
 let packet:AS.AdmissionPacket (W:=A.W) (X:=A.X) (s:=slot):=⟨n,⟨source,seed⟩,cfg,⟨rfl⟩⟩
 let native:=AS.nativeAfterAdmission factory packet
 let frame:RootGeneratedDebtActivationJointSource.Successor.Inquiry.Continuation.Frame
  (Value:=Lower.Value A.W (n+1)) (Var:=A.X) (sort:=slot):=selected native
 let environment:Env (Lower.Value A.W (n+1)) A.X:=Affine.updatedEnvironment (Act.epoch frame) (S.actualOccurrence frame)
 let m:=Affine.paid (Act.epoch frame) (S.actualOccurrence frame)
 let action:=R.actualMaterial source cfg
 have registered:m.raw=N.expression action:=
  eq_of_heq (BornRSealedSourceWriteback.affine_registered_request observation nontrivial half packet)
 have residual:ScalarRelationPresentation.freeEvaluation (R:=ℤ) (Lower.Value A.W (n+1) slot)
   (Affine.nu (Act.epoch frame) (S.actualOccurrence frame))=
  m.raw.eval environment-m.state.1.eval environment:=BornRSealedSourceWriteback.Generic.affine_current_residual frame
 let actionRaw:Lower.Value A.W (n+1) slot:=action.raw.eval environment
 let actionPaid:Lower.Value A.W (n+1) slot:=action.state.1.eval environment
 have requestEval:m.raw.eval environment=actionRaw-actionPaid:=
  (congrArg (fun expression:Expr (Lower.Value A.W (n+1)) A.X slot=>expression.eval environment) registered).trans
   (N.expression_eval action environment)
 have currentResidual:ScalarRelationPresentation.freeEvaluation (R:=ℤ) (Lower.Value A.W (n+1) slot)
   (Affine.nu (Act.epoch frame) (S.actualOccurrence frame))=
  actionRaw-actionPaid-m.state.1.eval environment:=
  residual.trans (congrArg (fun value:Lower.Value A.W (n+1) slot=>value-m.state.1.eval environment) requestEval)
 have telescope:actionRaw=actionPaid+m.state.1.eval environment+
  ScalarRelationPresentation.freeEvaluation (R:=ℤ) (Lower.Value A.W (n+1) slot)
   (Affine.nu (Act.epoch frame) (S.actualOccurrence frame)) := by
  rw [currentResidual]
  abel
 have projected:=congrArg (wholeProjection (n+1)) telescope
 rw [wholeProjection_add,wholeProjection_add] at projected
 exact projected

def actualStock (update:Nat) : C.Value slot :=
 packetStock (Admissions.packetAt factory initial pR rfl update)

theorem actualStock_step (update:Nat) : actualStock observation nontrivial half depth ordinal (update+1)=
 OriginalKFullSourceRAction.variableAction observation nontrivial half
  (actualStock observation nontrivial half depth ordinal update) := by
 exact wholeStep_restriction observation nontrivial half
  (Admissions.packetAt factory initial pR rfl update) (Admissions.packetAt factory initial pR rfl (update+1))
  (Admissions.packetAt_successor_grade factory initial pR rfl update)
  (BornRActualMethodAction.actual_whole_R_step observation nontrivial half depth ordinal update)

theorem actualStock_zero : actualStock observation nontrivial half depth ordinal 0=
 OriginalKFullSourceRAction.variableAction observation nontrivial half
  (BornWholeStockRConsumer.registeredValue observation nontrivial half depth ordinal) := by
 exact initialStock_value factory initial pR rfl
  (OriginalKFullSourceRAction.variableAction observation nontrivial half
   (BornWholeStockRConsumer.registeredValue observation nontrivial half depth ordinal))
  ((Generic.paid_value initial pR).symm.trans
   (BornRSourceMethodConsumer.registered_whole_R observation nontrivial half depth ordinal))

local notation "c"=>burnolDivisionZeroCompletedMellinCoordinate observation half.down
local notation "r"=>burnolDirectRightResolventCLM
local notation "current"=>actualStock observation nontrivial half depth ordinal

theorem physical_step (update:Nat) : (current (update+1)).1.1=r c (current update).1.1 := by
 rw [actualStock_step]
 rfl

theorem actual_even (update:Nat) : reflectL2 (current update).1.1=(current update).1.1 := by
 induction update with
 | zero=>
  rw [actualStock_zero]
  change reflectL2 (r c (BornWholeStockRConsumer.registeredValue observation nontrivial half depth ordinal).1.1)=_
  apply inward_even
  rw [BornWholeStockRConsumer.actual_R_squared]
  exact inward_even c _ (CompletedPaEulerTateBoundary.next_source_even observation nontrivial half depth)
 | succ update previous=>
  rw [physical_step]
  exact inward_even c _ previous

theorem independent_four_term (update:Nat) (shift:ℝ) :
 OriginalKCombCofinalTwoDirection.fourTerms observation nontrivial half shift
  (OriginalKFullSourceRAction.originalField (current update))=
 burnolMultiplicativeDilation shift (current (update+1)).1.1 := by
 rw [actualStock_step]
 exact OriginalKFullSourceRAction.complete_four_term_source observation nontrivial half shift (current update)

theorem independent_B (update:Nat) :
 burnolAmbientMeanZeroFirstCorrection (current (update+1)).1.1=
  G.secondNext (OriginalPrimitiveRankBalance.conjugateCoordinate c) (fourierL2 (current update).1.1) ∧
 burnolAmbientMeanZeroSecondCorrection (current (update+1)).1.1=
  G.firstNext (OriginalPrimitiveRankBalance.conjugateCoordinate c) (fourierL2 (current update).1.1) := by
 rw [physical_step]
 exact G.actual_forward_R_B c (current update).1.1 (actual_even observation nontrivial half depth ordinal update)


theorem actualStock_division (update:Nat) : current (update+1)=
 Div.pa observation nontrivial half (current update)+Div.nonPa observation nontrivial half (current update) :=
 (actualStock_step observation nontrivial half depth ordinal update).trans
  (Div.sum observation nontrivial half (current update))

theorem actualStock_outside (update:Nat) :
 (current (update+1)).1.1-(burnolEvenAmbientProjection (current (update+1)).1.1:BurnolL2)=
 (Div.nonPa observation nontrivial half (current update)).1.1-
  (burnolEvenAmbientProjection (Div.nonPa observation nontrivial half (current update)).1.1:BurnolL2) := by
 rw [actualStock_step]
 exact Div.outside observation nontrivial half (current update)

def actual_division_readout (update:Nat) :=
 PProd.mk (Div.qualified (current update)) <|
 PProd.mk (Div.pa_gap observation nontrivial half (current update)) <|
 PProd.mk (Div.pa_unit_rank observation nontrivial half (current update)) <|
 PProd.mk (actualStock_division observation nontrivial half depth ordinal update)
  (actualStock_outside observation nontrivial half depth ordinal update)

/-- The fuel is the existing engine's emitted macro index; each R count carries its actual segment. -/
def finiteHistory (updates:Nat) :=
 (A.sourceRuntime observation nontrivial half depth ordinal).run
  (Admissions.index factory initial pR rfl (updates+1)+1)

theorem step_within_history (updates:Nat) (update:Fin (updates+1)) :
 Admissions.index factory initial pR rfl (update.val+1)+1≤
 Admissions.index factory initial pR rfl (updates+1)+1 := by
 apply Nat.succ_le_succ
 apply (Admissions.strictMono factory initial pR rfl).monotone
 omega

def actual_source_method_step (update:Nat) :=
 PProd.mk (BornRSealedSourceWriteback.actual_source_writeback_step observation nontrivial half depth ordinal update) <|
 PProd.mk (actualStock_step observation nontrivial half depth ordinal update) <|
 PProd.mk (current_request_telescope observation nontrivial half (Admissions.packetAt factory initial pR rfl update)) <|
 PProd.mk (actual_division_readout observation nontrivial half depth ordinal update) <|
 PProd.mk (independent_B observation nontrivial half depth ordinal update) <|
 PProd.mk (fun shift:ℝ=>independent_four_term observation nontrivial half depth ordinal update shift) <|
 PProd.mk (Admissions.complete_word factory initial pR rfl update)
 (Admissions.actual_source_action factory initial pR rfl (Admissions.index factory initial pR rfl update))

def finite_source_method_history (updates:Nat) :=
 PProd.mk (A.exact_initial observation nontrivial half depth ordinal) <|
 PProd.mk (finiteHistory observation nontrivial half depth ordinal updates)
 (fun update:Fin (updates+1)=>
  PProd.mk (step_within_history observation nontrivial half depth ordinal updates update)
   (actual_source_method_step observation nontrivial half depth ordinal update.val))
