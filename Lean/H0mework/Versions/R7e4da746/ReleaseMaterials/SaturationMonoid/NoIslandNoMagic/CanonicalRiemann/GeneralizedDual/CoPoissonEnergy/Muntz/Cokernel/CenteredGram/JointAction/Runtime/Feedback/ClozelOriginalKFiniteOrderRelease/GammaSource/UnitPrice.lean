private theorem logPair_add (v lv w lw : BurnolL2) (left : LogPair v lv) (right : LogPair w lw) :
    LogPair (v+w) (lv+lw) := by
  filter_upwards [left,right,Lp.coeFn_add v w,Lp.coeFn_add lv lw] with x first second raw logged
  rw [raw,logged]
  simp only [Pi.add_apply]
  rw [first,second,mul_add]

private theorem right_parameter (c : BurnolCompletedMellinCoordinate) : 1/4 < (c.value/2).re := by
  rw [Complex.div_re]
  norm_num
  linarith [c.rightHalf]

private def quarterPosition (c : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  (q : ℂ)^(-c.value) • (logSeedSynthesis C+(c.value/2) •
    (R c (logSeedSynthesis C)-BurnolPhysicalState.OriginalRSourceJointContact.LogAction.directLogMoment (c.value/2) C))

private theorem quarter_position_source (c : BurnolCompletedMellinCoordinate) :
    LogPair (burnolRadiusNormalizedUnitTail c q (by norm_num)) (quarterPosition c) := by
  have resolved := BurnolPhysicalState.OriginalRSourceJointContact.LogAction.actual_direct_R_log
    (c.value/2) (right_parameter c) _ _ seed_log_domain
  have sum := logPair_add _ _ _ _ seed_log_domain (logPair_smul (c.value/2) _ _ resolved)
  have scaled := logPair_smul ((q : ℂ)^(-c.value)) _ _ sum
  rw [actual_seed_quarter_tail c]
  exact scaled

private def zeroPosition (c : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  scaleFactor c • (burnolMultiplicativeDilation (-Real.log 16) (quarterPosition c)-
    ((-Real.log 16 : ℝ) : ℂ) • burnolMultiplicativeDilation (-Real.log 16)
      (burnolRadiusNormalizedUnitTail c q (by norm_num)))

private theorem zero_position_source (c : BurnolCompletedMellinCoordinate) :
    LogPair (nativeUnitMuSource c 0) (zeroPosition c) := by
  have moved := logPair_smul (scaleFactor c) _ _
    (logPair_dilation (-Real.log 16) _ _ (quarter_position_source c))
  rw [← actual_four_tail_source c] at moved
  rw [native_zero_source]
  exact moved

/-- The Gamma and both log columns are generated from the literal full Unit source. -/
def unitGamma (c : BurnolCompletedMellinCoordinate) (j : Nat) : BurnolL2 := ((R c)^j) (fourTailGamma c)
def unitPosition (c : BurnolCompletedMellinCoordinate) : Nat → BurnolL2
  | 0 => zeroPosition c
  | j+1 => R c (unitPosition c j)-
      BurnolPhysicalState.OriginalRSourceJointContact.LogAction.directLogMoment (c.value/2) (nativeUnitMuSource c j)
def unitFrequency (c : BurnolCompletedMellinCoordinate) (j : Nat) : BurnolL2 :=
  fourierL2.symm (unitGamma c j-unitPosition c j)

theorem actual_unit_source_Gamma (c : BurnolCompletedMellinCoordinate) (j : Nat) :
    GammaPair (nativeUnitMuSource c j) (unitGamma c j) := by
  induction j with
  | zero =>
    rw [native_zero_source]
    exact actual_four_tail_Gamma c
  | succ j previous =>
    rw [← native_unit_source_action c j]
    rw [unitGamma,pow_succ',mul_apply_eq_comp]
    exact actual_Gamma_R c _ _ previous

theorem actual_unit_source_position (c : BurnolCompletedMellinCoordinate) (j : Nat) :
    LogPair (nativeUnitMuSource c j) (unitPosition c j) := by
  induction j with
  | zero => exact zero_position_source c
  | succ j previous =>
    have generated := BurnolPhysicalState.OriginalRSourceJointContact.LogAction.actual_direct_R_log
      (c.value/2) (right_parameter c) _ _ previous
    rw [native_unit_source_action c j] at generated
    exact generated

theorem actual_unit_source_two_logs (c : BurnolCompletedMellinCoordinate) (j : Nat) :
    LogPair (nativeUnitMuSource c j) (unitPosition c j) ∧
      LogPair (fourierL2.symm (nativeUnitMuSource c j)) (unitFrequency c j) :=
  ⟨actual_unit_source_position c j,inverse_log_from_complete_source _ _ _
    (actual_unit_source_Gamma c j) (actual_unit_source_position c j)⟩

private theorem finite_K_price (c : BurnolCompletedMellinCoordinate) (j N : Nat) :
    inner ℂ (DN N (actualGammaKernel c)) (nativeUnitMuSource c j) =
      inner ℂ (DN N (K c : BurnolL2)) (unitGamma c j) := by
  have graph := actual_original_gamma_kernel_complete_count c N
  have position := counted_kernel_position_source c N
  have frequency := inverse_log_from_complete_source _ _ _ graph position
  exact whole_conductor_dual _ _ _ _ _ _ _ _ graph (actual_unit_source_Gamma c j)
    position frequency (actual_unit_source_two_logs c j).1 (actual_unit_source_two_logs c j).2

/-- The first head reads the actual full Unit forward source, with its Tate q-face intact. -/
theorem actual_original_Unit_Gamma_price (c : BurnolCompletedMellinCoordinate)
    (zero : riemannZeta c.value = 0) (j : Nat) :
    inner ℂ (actualGammaKernel c) (((R c)^j) (burnolUnitTailResponse c 4)) =
      inner ℂ (originalDualLogValue c) (T (nativeUnitMuSource c j)) := by
  have forward := (tendsto_const_nhds (x := actualGammaKernel c)).inner (𝕜 := ℂ)
    (actual_native_unit_forward c j)
  have actual : Tendsto (fun N : Nat => inner ℂ (DN N (actualGammaKernel c)) (nativeUnitMuSource c j)) atTop
      (𝓝 (inner ℂ (actualGammaKernel c) (((R c)^j) (burnolUnitTailResponse c 4)))) := by
    apply forward.congr'
    exact Eventually.of_forall (fun N =>
      (ContinuousLinearMap.adjoint_inner_left (CountingDual.sourceCLM N)
        (nativeUnitMuSource c j) (actualGammaKernel c)).symm.trans
          (by rw [← CountingDual.dual_eq_adjoint]))
  have counted := (KCounting.original_tendsto c zero).inner (𝕜 := ℂ)
    (tendsto_const_nhds (x := unitGamma c j))
  have paired := whole_conductor_dual _ _ _ _ _ _ _ _
    (actual_original_first_field_complete_Gamma_source c zero) (actual_unit_source_Gamma c j)
    (actual_original_first_field_complete_log_sources c zero).1
    (actual_original_first_field_complete_log_sources c zero).2
    (actual_unit_source_two_logs c j).1 (actual_unit_source_two_logs c j).2
  change Tendsto _ atTop (𝓝 (inner ℂ (originalFirstField c zero) (unitGamma c j))) at counted
  rw [← paired] at counted
  have price := tendsto_nhds_unique actual
    (counted.congr' (Eventually.of_forall (fun N => (finite_K_price c j N).symm)))
  calc
    _ = inner ℂ (originalFirstFieldGamma c) (nativeUnitMuSource c j) := price
    _ = inner ℂ (T (originalFirstFieldGamma c)) (T (nativeUnitMuSource c j)) := by
      rw [OriginalRieszFiniteSynthesis.tate_pairing,burnolTateReciprocalL2_involutive]
    _ = _ := by rw [actual_original_counted_first_dual_same_Gamma_occurrence c zero]

private theorem finite_FK_price (c : BurnolCompletedMellinCoordinate) (j N : Nat) :
    inner ℂ (DN N (F (actualGammaKernel c))) (nativeUnitMuSource c j) =
      inner ℂ (F (AN N (K c : BurnolL2))) (unitGamma c j) := by
  have graph := gamma_pair_fourier _ _ (actual_original_forward_gamma_kernel_count_source c N)
  have paid := whole_conductor_dual _ _ _ _ _ _ _ _ graph (actual_unit_source_Gamma c j)
    (actual_forward_gamma_position_log_source c N) (actual_forward_gamma_frequency_log_source c N)
    (actual_unit_source_two_logs c j).1 (actual_unit_source_two_logs c j).2
  change inner ℂ (F (AN N (actualGammaKernel c))) (nativeUnitMuSource c j) =
    inner ℂ (F (AN N (K c : BurnolL2))) (unitGamma c j) at paid
  rw [← KCounting.dual_fourier N (actualGammaKernel c)] at paid
  exact paid

/-- The Fourier head uses the original Fourier-forward count and the complete uncut native tail. -/
theorem actual_original_Unit_FourierGamma_price (c : BurnolCompletedMellinCoordinate)
    (zero : riemannZeta c.value = 0) (j : Nat) :
    inner ℂ (F (actualGammaKernel c)) (((R c)^j) (burnolUnitTailResponse c 4)) =
      inner ℂ (originalDualLogValue c) (nativeUnitMuSource c j) := by
  have forward := (tendsto_const_nhds (x := F (actualGammaKernel c))).inner (𝕜 := ℂ)
    (actual_native_unit_forward c j)
  have actual : Tendsto (fun N : Nat => inner ℂ (DN N (F (actualGammaKernel c))) (nativeUnitMuSource c j)) atTop
      (𝓝 (inner ℂ (F (actualGammaKernel c)) (((R c)^j) (burnolUnitTailResponse c 4)))) := by
    apply forward.congr'
    exact Eventually.of_forall (fun N =>
      (ContinuousLinearMap.adjoint_inner_left (CountingDual.sourceCLM N)
        (nativeUnitMuSource c j) (F (actualGammaKernel c))).symm.trans
          (by rw [← CountingDual.dual_eq_adjoint]))
  have counted := (actual_original_fourier_forward_K_whole_source c zero).inner (𝕜 := ℂ)
    (tendsto_const_nhds (x := unitGamma c j))
  have paired := whole_conductor_dual _ _ _ _ _ _ _ _ (original_dual_field_conductor c zero)
    (actual_unit_source_Gamma c j) (original_dual_field_log_pairs c zero).1
    (original_dual_field_log_pairs c zero).2
    (actual_unit_source_two_logs c j).1 (actual_unit_source_two_logs c j).2
  rw [← paired] at counted
  exact tendsto_nhds_unique actual
    (counted.congr' (Eventually.of_forall (fun N => (finite_FK_price c j N).symm)))

