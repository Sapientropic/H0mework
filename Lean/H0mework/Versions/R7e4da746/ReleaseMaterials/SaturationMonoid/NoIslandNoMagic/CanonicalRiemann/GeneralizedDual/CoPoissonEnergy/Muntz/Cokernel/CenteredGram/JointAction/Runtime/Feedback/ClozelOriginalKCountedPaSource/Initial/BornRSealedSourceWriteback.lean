theorem actual_complete_query_written (packet:AS.AdmissionPacket (W:=A.W) (X:=A.X) (s:=slot)) :
 ∀ event∈(A.completeQueryWritten (AS.nativeAfterAdmission factory packet).1
   (selected (AS.nativeAfterAdmission factory packet))).trace,
 event∈(writtenStock (AS.nativeAfterAdmission factory packet)).trace := by
 rcases packet with ⟨n,⟨frame,seed⟩,⟨Y,datum,inventory,pairInventory⟩,⟨language⟩⟩
 cases language
 let cfg:SourceOperationInquiry.Context.Faces.Execution.Activation.Programme
  (PhysicalValue:=Lower.Value A.W n) (PhysicalVar:=A.X) (sort:=slot):=
  {LowVar:=A.X,datum:=datum,nextInventory:=inventory,nextPairInventory:=pairInventory}
 let nextSeed:=AS.nextSeed factory n (frame,seed) cfg rfl
 let native:AS.AdmissionPacket (W:=A.W) (X:=A.X) (s:=slot):=
  ⟨n+1,⟨AS.receiver factory n (frame,seed) cfg rfl,nextSeed⟩,
   AS.nextBase factory n (frame,seed) cfg rfl,⟨rfl⟩⟩
 have callback:native.2.2.1.nextPairInventory (selected native)=
  some (A.completePairOutput (n+1) nextSeed (selected native)) := rfl
 have carried:=Generic.birth_keeps_callback (selected native) native.2.2.1
  (A.completePairOutput (n+1) nextSeed (selected native)) callback
 intro event present
 dsimp only [AS.nativeAfterAdmission,packetTransport,id,writtenStock] at present ⊢
 exact carried event (A.completePairOutput_query (n+1) nextSeed (selected native) event present)

/-- The actual registered R word is consumed through the complete query write, including every disposition. -/
theorem actual_registered_word_written (packet:AS.AdmissionPacket (W:=A.W) (X:=A.X) (s:=slot)) :
 PresentedRelationEventAt.generator (liftExpr (AS.nativeAfterAdmission factory packet).2.1.1.registered.input.expression)∈
  (writtenStock (AS.nativeAfterAdmission factory packet)).trace := by
 let native:=AS.nativeAfterAdmission factory packet
 have kept:(selected native).registered.input.expression=native.2.1.1.registered.input.expression:=
  BornRAdmissionStockLaw.Generic.paid_prefix_expression native.2.1.1 (AS.stockCfg native.2.2.1)
   (AS.localNativeReceipt native).1 (Nat.le_refl _)
 have source:PresentedRelationEventAt.generator (liftExpr (selected native).registered.input.expression)∈
  (A.completeQueryWritten native.1 (selected native)).trace :=
  BornRInventorySourceConservation.Generic.registered_in_query_source (selected native)
 have registered:= (congrArg (fun expression:Expr (Lower.Value A.W native.1) A.X slot=>
  PresentedRelationEventAt.generator (liftExpr expression)∈
   (A.completeQueryWritten native.1 (selected native)).trace) kept).mp source
 exact actual_complete_query_written observation nontrivial half packet _ registered


-- This is the original owner template; the affine component is inherited before its query is emitted.
def affineTemplateFace (n:Nat) (data:SF.Packet (W:=A.W) (X:=A.X) (s:=slot) n)
 (sourceCfg:SourceOperationInquiry.Context.Faces.Execution.Activation.Programme
  (PhysicalValue:=Lower.Value A.W n) (PhysicalVar:=A.X) (sort:=slot))
 (language:sourceCfg.LowVar=A.X)
 (frame:RootGeneratedDebtActivationJointSource.Successor.Inquiry.Continuation.Frame
  (Value:=Lower.Value A.W (n+1)) (Var:=sourceCfg.LowVar) (sort:=slot)) :
 SourceNativeRootSemanticFaceAt (S.root frame (AS.nextCfg factory n data sourceCfg language))
  (S.visit frame (AS.nextCfg factory n data sourceCfg language)) := by
 cases sourceCfg with
 | mk Y datum inventory pairInventory =>
  change Y=A.X at language
  cases language
  let cfg:SourceOperationInquiry.Context.Faces.Execution.Activation.Programme
   (PhysicalValue:=Lower.Value A.W n) (PhysicalVar:=A.X) (sort:=slot):=⟨A.X,datum,inventory,pairInventory⟩
  let base:=AS.nextBase factory n data cfg rfl
  let prior:SourceOperationInquiry.Context.Faces.Execution.Activation.Programme
   (PhysicalValue:=Lower.Value A.W (n+1)) (PhysicalVar:=A.X) (sort:=slot):=
   {base with datum:=fun current=>{base.datum current with component:=some (A.nativeSourceComponent observation nontrivial half (n+1) current)}}
  let actual:=AS.stockCfg base
  let epoch:=SourceOperationInquiry.Context.Faces.Execution.Activation.epoch frame
  let installed:=(SourceNativeProjectionLaw.InstallationAt.componentCoface
   (SourceOperationInquiry.Context.Faces.Execution.Activation.optionalSourceRoot
    (S.base epoch).root (prior.datum epoch).component).source.base (Affine.component epoch)) |>.trans
   (SourceNativeProjectionLaw.InstallationAt.inheritedCoface
    {(S.base epoch).root.source.base with projectionLaw:=Affine.combined epoch prior}
    (I.stockLaw epoch base)) |>.trans
   (SourceNativeProjectionLaw.InstallationAt.componentCoface (S.base frame).root.source.base (I.component epoch base)) |>.trans
   (SourceNativeProjectionLaw.InstallationAt.inheritedCoface (S.baseRoot frame actual).source.base (S.queryLaw epoch actual)) |>.trans
   (SourceNativeProjectionLaw.InstallationAt.inheritedCoface (S.queryRoot frame actual).source.base (S.resultLaw epoch actual)) |>.trans
   (SourceNativeProjectionLaw.InstallationAt.inheritedCoface (S.resultRoot frame actual).source.base (S.consumerLaw epoch actual)) |>.trans
   (SourceNativeProjectionLaw.InstallationAt.inheritedCoface (S.consumerRoot frame actual).source.base (S.compilationLaw epoch actual))
  exact {
   projection:=installed.embed PUnit.unit
   active:=PUnit.unit
   classifier_eq:=rfl }

