def nextAffineReceipt (packet:AS.AdmissionPacket (W:=A.W) (X:=A.X) (s:=slot)) :
 Affine.PacketReceipt (AS.bornAfterNative (AS.nativeAfterAdmission factory packet)) := by
 let native:=AS.nativeAfterAdmission factory packet
 let frame:=selected native
 let epoch:=SourceOperationInquiry.Context.Faces.Execution.Activation.epoch frame
 let occurrence:=S.actualOccurrence frame
 have belongs:Affine.gamma epoch occurrence∈(AN.bornHistory frame native.2.2.1).relationClosure:=
  (affineNativeGamma observation nontrivial half packet).property
 rw [Feed.history_relation_space] at belongs
 exact {
  environment:=Affine.updatedEnvironment epoch occurrence
  beta:=Affine.beta epoch occurrence
  nu:=Affine.nu epoch occurrence
  gamma:=Affine.gamma epoch occurrence
  certificate:=Affine.certificate epoch occurrence
  certificate_source:=Affine.affine_certificate epoch occurrence
  split:=(sub_add_cancel _ _).symm
  oldTrace:=Affine.sourceInventory epoch occurrence
  written:=Affine.written epoch occurrence
  inventory:=AN.bornStock frame native.2.2.1
  actual_inventory:=AN.born_stock frame native.2.2.1
  every_written:=affineNativeWritten observation nontrivial half packet frame
  gamma_in_inventory:=belongs }

