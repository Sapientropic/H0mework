theorem affineTemplateWritten (n:Nat) (data:SF.Packet (W:=A.W) (X:=A.X) (s:=slot) n)
 (sourceCfg:SourceOperationInquiry.Context.Faces.Execution.Activation.Programme
  (PhysicalValue:=Lower.Value A.W n) (PhysicalVar:=A.X) (sort:=slot))
 (language:sourceCfg.LowVar=A.X)
 (frame:RootGeneratedDebtActivationJointSource.Successor.Inquiry.Continuation.Frame
  (Value:=Lower.Value A.W (n+1)) (Var:=sourceCfg.LowVar) (sort:=slot)) :
 ∀ event∈(Affine.written (SourceOperationInquiry.Context.Faces.Execution.Activation.epoch frame) (S.actualOccurrence frame)).trace,
 event∈(AN.bornStock frame (AS.nextBase factory n data sourceCfg language)).trace := by
 cases sourceCfg with
 | mk Y datum inventory pairInventory =>
  change Y=A.X at language
  cases language
  let cfg:SourceOperationInquiry.Context.Faces.Execution.Activation.Programme
   (PhysicalValue:=Lower.Value A.W n) (PhysicalVar:=A.X) (sort:=slot):=⟨A.X,datum,inventory,pairInventory⟩
  let seed:=AS.nextSeed factory n data cfg rfl
  let base:=AS.nextBase factory n data cfg rfl
  have callback:base.nextInventory frame=some (Affine.callback (SF.defaultFactory A.W A.X slot) (n+1) seed frame):=rfl
  intro event present
  apply Feed.original_preserved (AS.stockDecodedEnvironment frame base) (AS.stockScalar frame base) event
  unfold AS.stockScalar
  apply Generic.preserves_generated frame.inventory _ event
  rw [callback]
  exact (SourceHistoryCommon.parallel_left _ _ _).1 event
   (Affine.callback_keeps_trace (SF.defaultFactory A.W A.X slot) (n+1) seed frame event present)

