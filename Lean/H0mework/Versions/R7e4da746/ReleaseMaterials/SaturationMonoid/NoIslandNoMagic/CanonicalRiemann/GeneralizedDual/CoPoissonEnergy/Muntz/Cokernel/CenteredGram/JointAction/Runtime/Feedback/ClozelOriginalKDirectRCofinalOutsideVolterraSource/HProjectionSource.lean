local notation "q" => (1/4:ℝ)
local notation "S" => burnolMeanZeroTruncatedFourier
local instance hProjectionPhysicalComplete : CompleteSpace BurnolPaAmbientCarrier := by
  apply IsComplete.completeSpace_coe
  exact (evenBurnolClosedFace burnolUnscaledCommonGapRadius).isClosed.isComplete
local instance hProjectionQuarterComplete : CompleteSpace BurnolQuarterMeanZeroCarrier := by
  apply IsComplete.completeSpace_coe
  exact burnolQuarterMeanZeroClosedFace.isClosed.isComplete

/-- A fixed source B column replaces the B solve on the complete adjoint field. -/
def hPhysicalField (coordinate : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  sourceAdjointField coordinate-hQuarterAmplitude coordinate • hPowerPhysicalCorrection coordinate

def hQField (coordinate : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  hPhysicalField coordinate-(paAdjointSource coordinate : BurnolL2)

theorem h_power_B_source (coordinate : BurnolCompletedMellinCoordinate) :
    hPowerBColumn coordinate+S (hPowerBSecond coordinate)=SingularCounting.centeredPower coordinate ∧
      S (hPowerBColumn coordinate)+hPowerBSecond coordinate=0 := by
  constructor
  · change hPowerBColumn coordinate+S (-S (hPowerBColumn coordinate))=_
    rw [map_neg,←sub_eq_add_neg]
    change (burnolMeanZeroOneMinusSquare*burnolMeanZeroBlockInverse) (SingularCounting.centeredPower coordinate)=_
    rw [burnolMeanZeroBlockInverse_right]
    rfl
  · exact add_neg_cancel _

theorem h_source_even (coordinate : BurnolCompletedMellinCoordinate) :
    reflectL2 (sourceAdjointField coordinate)=sourceAdjointField coordinate := by
  rw [h_adjoint_full_volterra,sourceVolterraResolvent_reflect,generatedK_eq_original]
  rw [mem_evenL2ClosedFace_iff.mp (burnolCompletedMellinRieszVector coordinate).property.2]

private theorem h_evenPart (coordinate : BurnolCompletedMellinCoordinate) :
    burnolAmbientEvenPart (sourceAdjointField coordinate)=sourceAdjointField coordinate := by
  unfold burnolAmbientEvenPart
  rw [h_source_even]
  module

private theorem h_fourier_eq_inverseFourier (coordinate : BurnolCompletedMellinCoordinate) :
    fourierL2 (sourceAdjointField coordinate)=fourierL2.symm (sourceAdjointField coordinate) := by
  apply fourierL2.injective
  rw [fourierL2_fourierL2,h_source_even,fourierL2.apply_symm_apply]

private theorem h_position_source (coordinate : BurnolCompletedMellinCoordinate) :
    burnolAmbientMeanZeroPosition (sourceAdjointField coordinate)=
      hQuarterAmplitude coordinate • SingularCounting.centeredPower coordinate := by
  change quarterCotest (burnolAmbientEvenPart (sourceAdjointField coordinate))=_
  rw [h_evenPart,h_quarter_source]
  rfl

private theorem h_fourier_source (coordinate : BurnolCompletedMellinCoordinate) :
    burnolAmbientMeanZeroFourier (sourceAdjointField coordinate)=0 := by
  change quarterCotest (fourierL2 (burnolAmbientEvenPart (sourceAdjointField coordinate)))=0
  rw [h_evenPart,h_fourier_eq_inverseFourier,adjoint_inverseFourier_quarterCotest_zero]

/-- Both coordinates of the complete actual B(H) solve are generated by this one power column. -/
theorem h_B_first_source (coordinate : BurnolCompletedMellinCoordinate) :
    burnolAmbientMeanZeroFirstCorrection (sourceAdjointField coordinate)=
      hQuarterAmplitude coordinate • hPowerBColumn coordinate := by
  change burnolMeanZeroBlockInverse
    (burnolAmbientMeanZeroPosition (sourceAdjointField coordinate)-
      S (burnolAmbientMeanZeroFourier (sourceAdjointField coordinate)))=_
  rw [h_position_source,h_fourier_source,map_zero,sub_zero,map_smul]
  rfl

theorem h_B_second_source (coordinate : BurnolCompletedMellinCoordinate) :
    burnolAmbientMeanZeroSecondCorrection (sourceAdjointField coordinate)=
      hQuarterAmplitude coordinate • hPowerBSecond coordinate := by
  change burnolAmbientMeanZeroFourier (sourceAdjointField coordinate)-
    S (burnolAmbientMeanZeroFirstCorrection (sourceAdjointField coordinate))=_
  rw [h_fourier_source,h_B_first_source,map_smul,zero_sub]
  simp only [hPowerBSecond,smul_neg]

private theorem evenPart_smul (scalar : ℂ) (value : BurnolL2) :
    burnolAmbientEvenPart (scalar • value)=scalar • burnolAmbientEvenPart value := by
  unfold burnolAmbientEvenPart
  rw [map_smul]
  module

/-- The complete physical correction is generated before the target physical projection is read. -/
theorem h_complete_correction_source (coordinate : BurnolCompletedMellinCoordinate) :
    burnolAmbientEvenMeanZeroCorrection (sourceAdjointField coordinate)=
      hQuarterAmplitude coordinate • hPowerPhysicalCorrection coordinate := by
  unfold burnolAmbientEvenMeanZeroCorrection burnolAmbientRawMeanZeroCorrection
  rw [h_B_first_source,h_B_second_source]
  simp only [SetLike.val_smul,map_smul]
  rw [←smul_add,evenPart_smul]
  rfl

theorem hPhysicalField_formula (coordinate : BurnolCompletedMellinCoordinate) :
    burnolAmbientExtendedSonineProjectionFormula (sourceAdjointField coordinate)=hPhysicalField coordinate := by
  unfold burnolAmbientExtendedSonineProjectionFormula
  rw [h_evenPart,h_complete_correction_source]
  rfl

theorem hPhysicalField_actual (coordinate : BurnolCompletedMellinCoordinate) :
    (burnolEvenAmbientProjection (sourceAdjointField coordinate) : BurnolL2)=hPhysicalField coordinate := by
  exact (burnolEvenOrthogonalProjectionOnto_eq_resolventFormula (sourceAdjointField coordinate)).trans
    (hPhysicalField_formula coordinate)

theorem hPhysicalField_mem (coordinate : BurnolCompletedMellinCoordinate) :
    hPhysicalField coordinate∈evenBurnolClosedFace q := by
  rw [←hPhysicalField_formula]
  exact burnolAmbientExtendedSonineProjectionFormula_mem _

/-- The prior complete Q source is now computed without applying B to H. -/
theorem hQField_eq_paid (coordinate : BurnolCompletedMellinCoordinate) :
    hQField coordinate=qAdjointSource coordinate := by
  unfold hQField qAdjointSource
  rw [hPhysicalField_formula]

theorem hQField_actual (coordinate : BurnolCompletedMellinCoordinate)
    (orthogonal : burnolCompletedMellinRieszVector coordinate∈burnolCompactCoPoissonClosedRange.toSubmoduleᗮ) :
    (PA.Q (sourceAdjointField coordinate) : BurnolL2)=hQField coordinate := by
  rw [hQField_eq_paid]
  exact qAdjointSource_actual coordinate orthogonal

/-- The full vector cost is the actual fixed B-power source, with its original complex amplitude. -/
theorem h_projection_loss_source (coordinate : BurnolCompletedMellinCoordinate) :
    sourceAdjointField coordinate-(burnolEvenAmbientProjection (sourceAdjointField coordinate) : BurnolL2)=
      hQuarterAmplitude coordinate • hPowerPhysicalCorrection coordinate := by
  rw [hPhysicalField_actual,hPhysicalField]
  module

theorem h_projection_loss_energy (coordinate : BurnolCompletedMellinCoordinate) :
    ‖sourceAdjointField coordinate‖^2-‖hPhysicalField coordinate‖^2=
      ‖hQuarterAmplitude coordinate‖^2*‖hPowerPhysicalCorrection coordinate‖^2 := by
  have orthogonal := (evenBurnolClosedFace q).toSubmodule.starProjection_inner_eq_zero
    (sourceAdjointField coordinate) (hPhysicalField coordinate) (hPhysicalField_mem coordinate)
  change inner ℂ (sourceAdjointField coordinate-
    (burnolEvenAmbientProjection (sourceAdjointField coordinate) : BurnolL2)) (hPhysicalField coordinate)=0 at orthogonal
  rw [h_projection_loss_source] at orthogonal
  have split := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero _ _ orthogonal
  have recovered : hQuarterAmplitude coordinate • hPowerPhysicalCorrection coordinate+hPhysicalField coordinate=
      sourceAdjointField coordinate := by unfold hPhysicalField;module
  rw [recovered] at split
  simp only [←pow_two] at split
  rw [norm_smul,mul_pow] at split
  linarith

/-- This computes the same original actual Q successor using the fixed B power source and full Pa fee. -/
theorem actual_nextQ_B_power_source (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬∃ n:Nat,observation.coordinate=-2*(n+1))
    (half : OriginalKCombCalculation.Half observation) (depth ordinal : Nat) :
    let coordinate := OriginalKCombCofinalTwoDirection.coordinate observation nontrivial half
    let K := (burnolCompletedMellinRieszVector coordinate : BurnolL2)
    inner ℂ K (PA.Q (D.raw observation nontrivial half depth ((ordinal+1)+1)) : BurnolL2)=
      OriginalKDirectRCofinalDivision.sourceCoefficient observation nontrivial half depth (ordinal+1)*
        inner ℂ K (OriginalKDirectRCofinalDivision.sourceUnit observation nontrivial half : BurnolL2)+
      inner ℂ (hQField coordinate) (D.raw observation nontrivial half depth (ordinal+1))-
      star (hQuarterAmplitude coordinate)*inner ℂ (SingularCounting.centeredPower coordinate)
        (S (sourceOutsideColumn coordinate (D.raw observation nontrivial half depth ordinal))) := by
  dsimp only
  rw [hQField_eq_paid]
  exact actual_nextQ_power_source observation nontrivial half depth ordinal

