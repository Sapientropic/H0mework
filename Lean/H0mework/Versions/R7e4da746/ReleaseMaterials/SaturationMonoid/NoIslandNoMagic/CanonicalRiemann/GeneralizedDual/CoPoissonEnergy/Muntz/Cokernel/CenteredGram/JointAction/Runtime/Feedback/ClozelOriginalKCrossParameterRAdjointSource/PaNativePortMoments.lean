private theorem finite_log_primitive_real (n : Nat) {u : ℝ} (inside : q ≤ u) :
    (∫ t : ℝ in q..u, t⁻¹ * Real.log (t / q) ^ n) =
      Real.log (u / q) ^ (n + 1) / (n + 1 : ℝ) := by
  have hq : q ≠ 0 := by norm_num
  have hn : (n + 1 : ℝ) ≠ 0 := by positivity
  have ht : ∀ t ∈ uIcc q u, t ≠ 0 := by
    intro t admitted
    rw [uIcc_of_le inside] at admitted
    exact ne_of_gt (lt_of_lt_of_le (by norm_num : (0 : ℝ) < q) admitted.1)
  have derivative : ∀ t ∈ uIcc q u,
      HasDerivAt (fun s : ℝ => Real.log (s / q) ^ (n + 1) / (n + 1 : ℝ))
        (t⁻¹ * Real.log (t / q) ^ n) t := by
    intro t admitted
    have htn := ht t admitted
    have hlog := ((hasDerivAt_id t).div_const q).log (div_ne_zero htn hq)
    dsimp only [id_eq] at hlog
    convert (hlog.fun_pow (n + 1)).div_const (n + 1 : ℝ) using 1 <;>
      first | rfl | (simp only [Nat.add_sub_cancel, Nat.cast_add, Nat.cast_one]
                     field_simp [htn, hq, hn])
  have continuous : ContinuousOn (fun t : ℝ => t⁻¹ * Real.log (t / q) ^ n) (uIcc q u) :=
    (continuousOn_id.inv₀ ht).mul
      (((continuousOn_id.div_const q).log
        (fun t admitted => div_ne_zero (ht t admitted) hq)).pow n)
  have evaluated := intervalIntegral.integral_eq_sub_of_hasDerivAt derivative continuous.intervalIntegrable
  simpa only [div_self hq, Real.log_one, zero_pow (Nat.succ_ne_zero n),
    zero_div, sub_zero] using evaluated

private theorem finite_log_primitive (n : Nat) {u : ℝ} (inside : q ≤ u) :
    (∫ t : ℝ in q..u, (t : ℂ)⁻¹ * (Real.log (t / q) : ℂ) ^ n) =
      (Real.log (u / q) : ℂ) ^ (n + 1) / (n + 1 : ℂ) := by
  simp_rw [← Complex.ofReal_inv, ← Complex.ofReal_pow, ← Complex.ofReal_mul]
  rw [intervalIntegral.integral_ofReal, finite_log_primitive_real n inside,
    Complex.ofReal_div, Complex.ofReal_pow]
  simp only [Complex.ofReal_add, Complex.ofReal_natCast, Complex.ofReal_one]

/-- The continuous covector is generated by the same Pa correction at every rung. -/
private def portCovector (c : BurnolCompletedMellinCoordinate) : Nat → (↥Pa →L[ℂ] ℂ)
  | 0 => (burnolPaResolventSourceCoefficient c).comp Pa.subtypeL
  | n + 1 => (portCovector c n).comp (correction c)

private theorem portCovector_actual (c : BurnolCompletedMellinCoordinate)
    (n : Nat) (input : ↥Pa) : portCovector c n input = port c n input := by
  induction n generalizing input with
  | zero => rfl
  | succ n previous =>
    change portCovector c n (correction c input) = _
    rw [previous]
    unfold port loop
    rw [Function.iterate_succ_apply]

/-- Projection extends the covector only for Bochner elimination; all actual arguments are Pa. -/
private def ambientPortCovector (c : BurnolCompletedMellinCoordinate) (n : Nat) :
    BurnolPaAmbientCarrier →L[ℂ] ℂ :=
  (portCovector c n).comp Pa.orthogonalProjectionOnto

private theorem ambientPortCovector_actual (c : BurnolCompletedMellinCoordinate)
    (n : Nat) (input : ↥Pa) :
    ambientPortCovector c n input.val = port c n input := by
  change portCovector c n (Pa.orthogonalProjectionOnto input.val) = _
  rw [Submodule.orthogonalProjectionOnto_mem_subspace_eq_self]
  exact portCovector_actual c n input

/-- The next covector is calculated from the existing actual physical shell synthesis. -/
private theorem actual_port_shell_synthesis (c : BurnolCompletedMellinCoordinate)
    (n : Nat) (input : ↥Pa) :
    port c (n + 1) input = ∫ u : ℝ in Icc q 4,
      volterraSourceDensity c (sourceMap input) u *
        port c n ⟨volterraPhysicalShell c u, volterraPhysicalShell_mem c u⟩ := by
  have next : port c (n + 1) input = port c n (correction c input) := by
    unfold port loop
    rw [Function.iterate_succ_apply]
  rw [next, ← ambientPortCovector_actual]
  change ambientPortCovector c n (burnolPaSourceCorrection c input) = _
  rw [← sourceVolterraPhysical_original_correction c input.val input.property]
  unfold sourceVolterraPhysical
  change ambientPortCovector c n (∫ u : ℝ in Icc q 4,
    volterraSourceDensity c (sourceMap input) u • volterraPhysicalShell c u) = _
  rw [← (ambientPortCovector c n).integral_comp_comm
    (sourceVolterraPhysical_integrable c (sourceMap input))]
  apply setIntegral_congr_fun measurableSet_Icc
  intro u _
  dsimp only
  rw [map_smul]
  change volterraSourceDensity c (sourceMap input) u *
    ambientPortCovector c n (volterraPhysicalShell c u) = _
  rw [ambientPortCovector_actual c n
    ⟨volterraPhysicalShell c u, volterraPhysicalShell_mem c u⟩]

/-- The true shell source calculates the logarithmic moment, including both endpoints. -/
private theorem actual_shell_log_moment (c : BurnolCompletedMellinCoordinate)
    (n : Nat) (u : ℝ) (inside : u ∈ Icc q 4) :
    (∫ t : ℝ in Icc q 4,
      (t : ℂ) ^ (-c.value) * (Real.log (t / q) : ℂ) ^ n *
        sourceMap ⟨volterraPhysicalShell c u, volterraPhysicalShell_mem c u⟩ t) =
      (Real.log (u / q) : ℂ) ^ (n + 1) / (n + 1 : ℂ) := by
  have native := volterraPhysicalShell_tate_source_raw c u inside
  have profile : (fun t : ℝ => (t : ℂ) ^ (-c.value) *
      (Real.log (t / q) : ℂ) ^ n *
      sourceMap ⟨volterraPhysicalShell c u, volterraPhysicalShell_mem c u⟩ t)
      =ᵐ[volume.restrict (Icc q 4)]
        (Ioc q u).indicator (fun t : ℝ => (t : ℂ)⁻¹ * (Real.log (t / q) : ℂ) ^ n) := by
    filter_upwards [ae_restrict_of_ae native, ae_restrict_mem measurableSet_Icc,
      ae_restrict_of_ae (volume.ae_ne q), ae_restrict_of_ae (volume.ae_ne u)]
      with t sourceRead admitted notQuarter notUpper
    have positive : 0 < t := lt_of_lt_of_le (by norm_num : (0 : ℝ) < q) admitted.1
    change sourceMap ⟨volterraPhysicalShell c u, volterraPhysicalShell_mem c u⟩ t = _ at sourceRead
    rw [sourceRead, abs_of_pos positive]
    by_cases upper : t ≤ u
    · have above : q < t := lt_of_le_of_ne admitted.1 notQuarter.symm
      rw [if_pos ⟨admitted.1, lt_of_le_of_ne upper notUpper⟩,
        indicator_of_mem (show t ∈ Ioc q u from ⟨above, upper⟩)]
      calc
        _ = ((t : ℂ) ^ (-c.value) * (t : ℂ) ^ (c.value - 1)) *
            (Real.log (t / q) : ℂ) ^ n := by ring
        _ = _ := by
          rw [← Complex.cpow_add _ _ (Complex.ofReal_ne_zero.mpr positive.ne'),
            show -c.value + (c.value - 1) = (-1 : ℂ) by ring, Complex.cpow_neg_one]
    · rw [if_neg (fun h => upper h.2.le),
        indicator_of_notMem (show t ∉ Ioc q u from fun h => upper h.2), mul_zero]
  rw [integral_congr_ae profile, setIntegral_indicator measurableSet_Ioc]
  have domain : Icc q 4 ∩ Ioc q u = Ioc q u := by
    apply inter_eq_right.mpr
    intro t admitted
    exact ⟨admitted.1.le, admitted.2.trans inside.2⟩
  rw [domain, ← intervalIntegral.integral_of_le inside.1, finite_log_primitive n inside.1]

private theorem actual_port_zero_moment (c : BurnolCompletedMellinCoordinate) (input : ↥Pa) :
    port c 0 input = 2 * ∫ t : ℝ in Icc q 4,
      (t : ℂ) ^ (-c.value) * (Real.log (t / q) : ℂ) ^ 0 * sourceMap input t := by
  have integrable := burnolMellinWeight_integrableOn_tail c.value c.rightHalf (sourceMap input)
  have split := intervalIntegral.integral_Ioi_sub_Ioi integrable (by norm_num : q ≤ (4 : ℝ))
  change (∫ t : ℝ in Ioi q, (t : ℂ) ^ (-c.value) * sourceMap input t) -
    (∫ t : ℝ in Ioi (4 : ℝ), (t : ℂ) ^ (-c.value) * sourceMap input t) =
    (∫ t : ℝ in q..4, (t : ℂ) ^ (-c.value) * sourceMap input t) at split
  have outer : (∫ t : ℝ in Ioi (4 : ℝ), (t : ℂ) ^ (-c.value) * sourceMap input t) = 0 := by
    rw [← burnolRadiusMellinTailEvaluator_eq_integral]
    exact source_annulus_outer_tail_zero c (sourceMap input)
      (sourceAnnulusCut_original_pa input.val input.property)
  rw [outer, sub_zero] at split
  change 2 * burnolMellinTailEvaluator c.value c.rightHalf (sourceMap input) = _
  rw [burnolMellinTailEvaluator_eq_integral]
  change 2 * (∫ t : ℝ in Ioi q, (t : ℂ) ^ (-c.value) * sourceMap input t) = _
  rw [split, intervalIntegral.integral_of_le (by norm_num : q ≤ (4 : ℝ)),
    ← integral_Icc_eq_integral_Ioc]
  simp only [pow_zero, mul_one]

/-- Every port is generated by its actual correction history and the complete original source. -/
theorem actual_port_log_moment (c : BurnolCompletedMellinCoordinate) (n : Nat) (input : ↥Pa) :
    port c n input = (2 : ℂ) * (-2 : ℂ) ^ n / (n.factorial : ℂ) *
      ∫ t : ℝ in Icc q 4,
        (t : ℂ) ^ (-c.value) * (Real.log (t / q) : ℂ) ^ n * sourceMap input t := by
  induction n generalizing input with
  | zero => simpa only [pow_zero, Nat.factorial_zero, Nat.cast_one, mul_one, div_one]
      using actual_port_zero_moment c input
  | succ n previous =>
    rw [actual_port_shell_synthesis]
    have shell (u : ℝ) (inside : u ∈ Icc q 4) :
        port c n ⟨volterraPhysicalShell c u, volterraPhysicalShell_mem c u⟩ =
          (2 : ℂ) * (-2 : ℂ) ^ n / (n.factorial : ℂ) *
            ((Real.log (u / q) : ℂ) ^ (n + 1) / (n + 1 : ℂ)) := by
      rw [previous, actual_shell_log_moment c n u inside]
    calc
      _ = ∫ u : ℝ in Icc q 4,
          ((2 : ℂ) * (-2 : ℂ) ^ (n + 1) / ((n + 1).factorial : ℂ)) *
            ((u : ℂ) ^ (-c.value) * (Real.log (u / q) : ℂ) ^ (n + 1) * sourceMap input u) := by
        apply setIntegral_congr_fun measurableSet_Icc
        intro u inside
        dsimp only
        rw [shell u inside]
        unfold volterraSourceDensity
        rw [Nat.factorial_succ, Nat.cast_mul, pow_succ]
        push_cast
        field_simp
        ring
      _ = _ := integral_const_mul _ _

