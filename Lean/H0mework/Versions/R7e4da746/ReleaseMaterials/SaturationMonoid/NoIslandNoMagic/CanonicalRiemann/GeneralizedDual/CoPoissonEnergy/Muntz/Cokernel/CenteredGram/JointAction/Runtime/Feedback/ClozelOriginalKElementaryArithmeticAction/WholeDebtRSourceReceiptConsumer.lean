private def mixedPrice : ℂ :=
  -((pairedMellinTranslationCharacter (c).value h0-
      pairedMellinTranslationCharacter (star (c).value) h0)*OriginalRieszFinitePairing.kernelSelfSource c+
    (1/2:ℂ)*star
      (2*(mixedCurrent c junctionPoint-qFlux c+
        (∫ x : ℝ in junctionPoint..(1/4:ℝ),mixedForcing c x)-
        (2*(c).value-1)*(∫ x : ℝ in junctionPoint..(1/4:ℝ),mixedMass c x))-
      4*(meanCharge c 0*(∫ x : ℝ in junctionPoint..(1/4:ℝ),star (sourceProfile c 0 x))+
        meanCharge c 1*(∫ x : ℝ in junctionPoint..(1/4:ℝ),star (sourceProfile c 1 x)))))

private theorem mixed_source_price :
    burnolPaFixedShiftResidual c observation.mathlibZero=mixedPrice observation nontrivial half := by
  have generated := BandFiniteSourcePrice.original_fixed_residual_finite_price c observation.mathlibZero
  have source := actual_finite_price_mixed_green c
  simp only [junctionShift] at source
  rw [source] at generated
  simpa only [mixedPrice,junctionShift,neg_neg] using congrArg (fun price : ℂ => -price) generated

private theorem mixed_price_equation :
    sourcePrice observation nontrivial half=mixedPrice observation nontrivial half :=
  (OriginalSBWholeAnnulusPrice.original_fixedResidual_programme observation nontrivial half).symm.trans
    (mixed_source_price observation nontrivial half)

open private consumeWritten from
  H0mework.Versions.R7e4da746.ReleaseMaterials.SaturationMonoid.NoIslandNoMagic.CanonicalRiemann.GeneralizedDual.CoPoissonEnergy.Muntz.Cokernel.CenteredGram.JointAction.Runtime.Feedback.ClozelOriginalKCofinalFullBranchFibre.KernelWrite.NativeDelta.BetaDecoder.Word.Reentry.Action.Pa.Block.TotalSource.BSelfSBCompactPriceConsumer

private def consumeMixedWritten
    (maternal : type_of% (OriginalKCofinalFullBranchFibre.KernelWrite.OriginalKInheritance.originalMaterial observation nontrivial half depth))
    (receipt : type_of% (((runtimeEffectRecognition observation nontrivial).effectLaw.eventVocabulary.emit maternal.1).effect.originalK.receiptAt half.down))
    (self : type_of% (Self.selfCalculation observation nontrivial half depth maternal))
    (source : self=BS.result observation nontrivial half maternal.1)
    (nonzero : self.2.2.1≠0)
    (value : self.2.2.1= -receipt.1.fixedResidual • OriginalRieszFinitePairing.CoPoisson.Ward.ConstantDual.seed)
    (written : M.ResultAt observation nontrivial half depth maternal receipt self source nonzero value)
    (original : maternal=OriginalKCofinalFullBranchFibre.KernelWrite.OriginalKInheritance.originalMaterial observation nontrivial half depth) :=
  have occurrence : maternal.1=(runtimeEffectRuntimeAt observation nontrivial depth).emittedOccurrence :=
    (congrArg (fun material : type_of% maternal => material.1) original).trans rfl
  have sourceHEq : HEq self (runtimeCoefficientBSelfCalculationResultAt observation nontrivial depth half) :=
    (heq_of_eq source).trans
      ((congr_arg_heq (BS.result observation nontrivial half) occurrence).trans
        (heq_of_eq (runtimeCoefficientBSelfCalculationResultAt_source observation nontrivial depth half).symm))
  have componentValue : (BS.result observation nontrivial half maternal.1).2.2.1=
      (BS.result observation nontrivial half
        (runtimeEffectRuntimeAt observation nontrivial depth).emittedOccurrence).2.2.1 :=
    congrArg (fun event : type_of% maternal.1 => (BS.result observation nontrivial half event).2.2.1) occurrence
  have facadeValue := congrArg
    (fun material : type_of% (runtimeCoefficientBSelfCalculationResultAt observation nontrivial depth half) => material.2.2.1)
    (runtimeCoefficientBSelfCalculationResultAt_source observation nontrivial depth half)
  have currentValue : self.2.2.1=
      (runtimeCoefficientBSelfCalculationResultAt observation nontrivial depth half).2.2.1 :=
    (congrArg (fun material : type_of% self => material.2.2.1) source).trans
      (componentValue.trans facadeValue.symm)
  let prior := consumeWritten observation nontrivial half depth maternal receipt self source nonzero value written
  let equation := mixed_price_equation observation nontrivial half
  let price := prior.1.trans equation
  let computedValue := prior.2.1.trans
    (congrArg (fun z : ℂ => -z • OriginalRieszFinitePairing.CoPoisson.Ward.ConstantDual.seed) equation)
  let computedNext := prior.2.2.trans
    (congrArg (fun z : ℂ => (Expr.const (-z • OriginalRieszFinitePairing.CoPoisson.Ward.ConstantDual.seed) :
      Expr BS.Value BS.Var ())) equation)
  let namedValue := currentValue.symm.trans computedValue
  PProd.mk (runtimeCoefficientBSelfCalculationReadoutAt_factorizes observation nontrivial depth half)
    (PProd.mk occurrence (PProd.mk sourceHEq (PProd.mk currentValue
      (PProd.mk namedValue (PProd.mk price (PProd.mk computedValue computedNext))))))

