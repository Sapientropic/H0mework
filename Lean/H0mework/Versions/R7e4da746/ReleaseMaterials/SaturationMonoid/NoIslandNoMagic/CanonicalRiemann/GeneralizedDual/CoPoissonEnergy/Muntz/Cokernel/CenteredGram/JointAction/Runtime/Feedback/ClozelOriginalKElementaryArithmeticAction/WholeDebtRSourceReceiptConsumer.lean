  have square:=whole_debt_projection_R_square c
  unfold correctedValue
  rw [actual_value_source]
  rw [←original_source_action observation nontrivial half]
  linear_combination (norm:=module) square

/-- The original finite-price consumer now reads the endpoint of this actual written R source. -/
