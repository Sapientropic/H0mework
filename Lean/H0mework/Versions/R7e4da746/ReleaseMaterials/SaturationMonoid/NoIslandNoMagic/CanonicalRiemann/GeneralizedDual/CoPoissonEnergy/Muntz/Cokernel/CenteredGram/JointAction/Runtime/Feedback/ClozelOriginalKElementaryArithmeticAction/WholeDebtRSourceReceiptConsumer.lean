local elab "mixedWritten% " writtenStx:term ", " originalStx:term : term => do
  let written ← Lean.Elab.Term.elabTerm writtenStx none
  Lean.Elab.Term.synthesizeSyntheticMVarsNoPostponing
  let written ← Lean.instantiateMVars written
  let indexed ← Lean.Meta.whnf (← Lean.Meta.inferType written)
  unless indexed.getAppFn.constName? == some ``M.ResultAt do
    throwError "expected the same original ten-index BSelf whole-write carrier"
  let arguments := indexed.getAppArgs
  unless arguments.size == 10 do
    throwError "unexpected original BSelf whole-write source arity"
  let original ← Lean.Elab.Term.elabTerm originalStx none
  Lean.Elab.Term.synthesizeSyntheticMVarsNoPostponing
  let original ← Lean.instantiateMVars original
  let consumer ← Lean.Meta.mkConstWithFreshMVarLevels ``consumeMixedWritten
  return Lean.mkAppN consumer (arguments ++ #[written,original])

private theorem written_original (ordinal : Nat)
    (paid : type_of% (originalRead observation nontrivial half depth ordinal)) :
    (OriginalKCofinalFullBranchFibre.KernelWrite.NativeDelta.BetaDecoder.OriginalTotalSourceBFiniteResidualSource.originalRead
      observation nontrivial half depth ordinal).1.1.1.1.1.1=
      OriginalKCofinalFullBranchFibre.KernelWrite.OriginalKInheritance.originalMaterial observation nontrivial half depth := by
  have retained := paid.1.1.1.1.1.1.1.1.2.2
  exact (congrArg
    (fun residual : type_of% (OriginalKCofinalFullBranchFibre.KernelWrite.NativeDelta.BetaDecoder.OriginalTotalSourceBFiniteResidualSource.originalRead
      observation nontrivial half depth ordinal) => residual.1.1.1.1.1.1)
    paid.1.1.2.1).symm.trans retained

private def MixedResult (ordinal : Nat) : Sort _ :=
  Σ' paid : type_of% (originalRead observation nontrivial half depth ordinal),
    PProd (paid=originalRead observation nontrivial half depth ordinal)
      (PProd (type_of% (actual_correction_action_source_whole_next observation nontrivial half depth ordinal))
        (PProd
          ((∀ (i : Fin 2) (x : ℝ) (inside : junctionPoint/2<x),
              type_of% (actual_source_current_derivative c i x inside)) ∧
            (∀ (i : Fin 2) (x : ℝ) (member : x∈Set.Icc junctionPoint (1/4:ℝ)),
              type_of% (actual_R_current c i x member)) ∧
            (∀ i : Fin 2,type_of% (actual_q_current c i)) ∧
            (type_of% (actual_finite_price_mixed_green c)) ∧
            (type_of% (mixed_source_price observation nontrivial half)))
          (type_of% (mixedWritten% paid.1.1.2.2, written_original observation nontrivial half depth ordinal paid))))

/-- The two actual packages retain their own indices while the same K source Green law
rewrites the original receipt, installed self value and written next expression. -/
opaque actual_mixed_green_source_whole_next (ordinal : Nat) :
    MixedResult observation nontrivial half depth ordinal := by
  unfold MixedResult
  let paid := originalRead observation nontrivial half depth ordinal
  exact ⟨paid,⟨rfl,⟨actual_correction_action_source_whole_next observation nontrivial half depth ordinal,
    ⟨⟨(fun i x inside => actual_source_current_derivative c i x inside),
      (fun i x member => actual_R_current c i x member),
      (fun i => actual_q_current c i),actual_finite_price_mixed_green c,
      mixed_source_price observation nontrivial half⟩,
      mixedWritten% paid.1.1.2.2, written_original observation nontrivial half depth ordinal paid⟩⟩⟩⟩

