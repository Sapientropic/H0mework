/-- Both original source subtrees identify the input before the R node is executed. -/
theorem debt_code_source (coordinate : BurnolCompletedMellinCoordinate) :
    (Calc.debtCode coordinate h0).eval B.sourceEnvironment=
      BandFullStockAction.wholeDebt coordinate := by
  rw [Calc.debt_code_eval]
  simp only [OriginalKCoefficientBSelfCalculation.Semantics.kernel_code_eval,sourceKernel_original]
  change upperSourceWave coordinate h0-(2*u) •
    pairedBurnolMultiplicativeDilation h0 (K coordinate:BurnolL2)+
    (2*u*pairedMellinTranslationCharacter (star coordinate.value) h0) •
      (K coordinate:BurnolL2)=BandFullStockAction.wholeDebt coordinate
  exact (BandFullStockAction.whole_debt_raw_source coordinate).symm

