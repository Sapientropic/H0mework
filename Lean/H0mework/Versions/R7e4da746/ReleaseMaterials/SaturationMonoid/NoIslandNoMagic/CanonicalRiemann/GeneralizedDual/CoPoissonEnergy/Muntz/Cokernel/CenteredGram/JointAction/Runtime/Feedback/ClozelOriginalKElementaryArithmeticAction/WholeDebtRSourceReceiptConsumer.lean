private theorem born_word_event (word : Formal ℤ Calc.Value Calc.Var ())
    (present : PresentedRelationEventAt.relation word∈
      (C.sourceCalculationInventory observation nontrivial depth half).trace) (ordinal : Nat) :
    PresentedRelationEventAt.relation (bornWordMap observation nontrivial half depth ordinal word)∈
      (Born.sourceBornExposure observation nontrivial half depth ordinal).trace := by
  rw [Born.sourceBornExposure,Act.T.mapped_trace]
  exact List.mem_map.mpr ⟨PresentedRelationEventAt.relation
    (wordMapAt observation nontrivial half depth (ordinal+1) word),
    word_event_at observation nontrivial half depth word present (ordinal+1),
    Act.source_word_action_relation (Dyn.packet observation nontrivial half depth ordinal) _⟩

private theorem born_word_relation (word : Formal ℤ Calc.Value Calc.Var ())
    (present : PresentedRelationEventAt.relation word∈
      (C.sourceCalculationInventory observation nontrivial depth half).trace) (ordinal : Nat) :
    bornWordMap observation nontrivial half depth ordinal word∈
      (Born.sourceBornHistory observation nontrivial half depth ordinal).relationClosure := by
  apply (Born.sourceBornHistory observation nontrivial half depth ordinal).relationStage_le_closure 0
  apply Submodule.subset_span
  change PresentedRelationEventAt.relation
    (bornWordMap observation nontrivial half depth ordinal word)∈
      (Born.sourceBornHistory observation nontrivial half depth ordinal).observedEvents 0
  simpa only [RootGeneratedCofinalHistoryAt.observedEvents,List.range_succ,List.range_zero,
    List.nil_append,List.flatMap_singleton,RootGeneratedCofinalHistoryAt.observation_zero,
    RootGeneratedCofinalHistoryAt.seed] using
      born_word_event observation nontrivial half depth word present ordinal

/-- Every paid Step coefficient of this boundary is consumed, including its complete integer sum. -/
theorem born_boundary_written (ordinal : Nat) :
    bornBoundary observation nontrivial half depth ordinal∈
      (Born.sourceBornHistory observation nontrivial half depth ordinal).relationClosure := by
  have each (word) (belongs : word∈PT.words trace) :=
    born_word_relation observation nontrivial half depth word
      (C.whole_debt_R_source_preserved observation nontrivial depth half
        (PresentedRelationEventAt.relation word)
        (by
          apply List.mem_cons_of_mem
          change PresentedRelationEventAt.relation word∈
            RootedAccountedUnfolding.traceBranches (SourceOperationPaidRelations.events trace)
          rw [SourceOperationPaidRelations.events_trace]
          exact List.mem_map.mpr ⟨word,belongs,rfl⟩)) ordinal
  have sum_mem : ∀ items : List (Formal ℤ Calc.Value Calc.Var ()),
      (∀ word∈items,bornWordMap observation nontrivial half depth ordinal word∈
        (Born.sourceBornHistory observation nontrivial half depth ordinal).relationClosure) →
      bornWordMap observation nontrivial half depth ordinal items.sum∈
        (Born.sourceBornHistory observation nontrivial half depth ordinal).relationClosure := by
    intro items
    induction items with
    | nil => intro _; rw [List.sum_nil,map_zero]; exact Submodule.zero_mem _
    | cons head tail previous =>
      intro all
      rw [List.sum_cons,map_add]
      exact Submodule.add_mem _ (all head List.mem_cons_self)
        (previous (fun word belongs=>all word (List.mem_cons_of_mem head belongs)))
  unfold bornBoundary boundary
  rw [←PT.paid_boundary]
  exact sum_mem (PT.words trace) each

/-- This particular original R boundary, after its actual word actions, enters the actual born kernel. -/
theorem actual_boundary_kernel (ordinal : Nat) :
    (Born.actualBornHistory observation nontrivial half depth ordinal).completionProjection
      ((Submodule.inclusion
        (Born.actualBornHistory observation nontrivial half depth ordinal).relationClosure_le_generatorClosure)
        ⟨bornBoundary observation nontrivial half depth ordinal,
          Born.actual_source_relations_in_born observation nontrivial half depth ordinal
            (born_boundary_written observation nontrivial half depth ordinal)⟩)=0 :=
  (Submodule.Quotient.mk_eq_zero _).2
    (Born.actual_source_relations_in_born observation nontrivial half depth ordinal
      (born_boundary_written observation nontrivial half depth ordinal))

