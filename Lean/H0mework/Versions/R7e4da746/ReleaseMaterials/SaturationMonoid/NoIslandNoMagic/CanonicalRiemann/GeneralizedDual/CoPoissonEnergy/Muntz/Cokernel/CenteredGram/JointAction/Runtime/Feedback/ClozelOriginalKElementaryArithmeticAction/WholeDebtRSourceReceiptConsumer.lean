  change (Calc.code c h0).eval
    (runtimeCoefficientBSelfCalculationResultAt observation nontrivial depth half).1.environment=_
  rw [(OriginalKCoefficientBSelfCalculation.MaterialConsumer.installed_source_raw
    observation nontrivial half depth).1,Calc.code_eval,debt_code_source]

