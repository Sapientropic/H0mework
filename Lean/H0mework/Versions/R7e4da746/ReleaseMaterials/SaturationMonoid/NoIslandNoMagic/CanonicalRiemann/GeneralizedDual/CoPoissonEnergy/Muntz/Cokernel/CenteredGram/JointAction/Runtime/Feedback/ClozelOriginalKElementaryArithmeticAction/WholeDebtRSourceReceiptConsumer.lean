abbrev WordAt {Y : Unit → Type} (packet : Born.Packet Y) :=
  Formal ℤ (Act.L.Value (PairValue Calc.Value) packet.1) Y ()

private def reindexWord {left right : Born.Packet Calc.Var} (same : left=right) :
    WordAt left ≃ₗ[ℤ] WordAt right := by
  cases same
  exact LinearEquiv.refl ℤ _

private def languageWord {Y Z : Unit → Type} (same : Y=Z) (packet : Born.Packet Y) :
    WordAt packet ≃ₗ[ℤ] WordAt (Act.packetTransport same packet) := by
  cases same
  exact LinearEquiv.refl ℤ _

private def stepWord (packet : Born.Packet Calc.Var) :
    WordAt packet →ₗ[ℤ]
      WordAt (Act.packetTransport packet.2.2.2.down
        (Act.sourceBorn (Dyn.factory observation nontrivial half) packet)) :=
  (languageWord packet.2.2.2.down
    (Act.sourceBorn (Dyn.factory observation nontrivial half) packet)).toLinearMap.comp
      (Act.sourceWordAction packet)

/-- The one original boundary is transported by the actual packet word actions. -/
def wordMapAt : (tick : Nat) →
    Formal ℤ Calc.Value Calc.Var () →ₗ[ℤ]
      WordAt (Born.packetAt observation nontrivial half depth tick)
  | 0 => liftMap (R := ℤ)
  | tick+1 =>
    (reindexWord (Act.actual_next_packet (Dyn.factory observation nontrivial half)
      (Dyn.initial observation nontrivial half depth)
      (Dyn.firstCfg observation nontrivial half depth) rfl tick).symm).toLinearMap.comp
      ((stepWord observation nontrivial half
        (Born.packetAt observation nontrivial half depth tick)).comp (wordMapAt tick))

private theorem reindex_member {left right : Born.Packet Calc.Var} (same : left=right)
    (stock : Born.StockAt left) (word : WordAt left)
    (present : PresentedRelationEventAt.relation word∈stock.trace) :
    PresentedRelationEventAt.relation (reindexWord same word)∈(reindexStock same stock).trace := by
  cases same
  exact present

private theorem language_member {Y Z : Unit → Type} (same : Y=Z)
    (packet : Born.Packet Y) (stock : Born.StockAt packet) (word : WordAt packet)
    (present : PresentedRelationEventAt.relation word∈stock.trace) :
    PresentedRelationEventAt.relation (languageWord same packet word)∈
      (Born.stockTransport same packet stock).trace := by
  cases same
  exact present

private theorem advanced_member (packet : Born.Packet Calc.Var) (stock : Born.StockAt packet)
    (word : WordAt packet) (present : PresentedRelationEventAt.relation word∈stock.trace) :
    PresentedRelationEventAt.relation (stepWord observation nontrivial half packet word)∈
      (advancedStock observation nontrivial half packet stock).trace := by
  apply language_member
  rw [Act.T.mapped_trace]
  exact List.mem_map.mpr
    ⟨PresentedRelationEventAt.relation word,present,Act.source_word_action_relation packet word⟩

private theorem word_event_at (word : Formal ℤ Calc.Value Calc.Var ())
    (present : PresentedRelationEventAt.relation word∈
      (C.sourceCalculationInventory observation nontrivial depth half).trace) (tick : Nat) :
    PresentedRelationEventAt.relation (wordMapAt observation nontrivial half depth tick word)∈
      (Born.sourceExposureAt observation nontrivial half depth tick).trace := by
  induction tick with
  | zero =>
    change PresentedRelationEventAt.relation (liftMap (R := ℤ) word)∈
      (Born.initialSourceExposure observation nontrivial half depth).trace
    rw [Born.initialSourceExposure,Act.T.mapped_trace]
    exact List.mem_map.mpr ⟨PresentedRelationEventAt.relation word,present,rfl⟩
  | succ tick previous =>
    exact reindex_member _ _ _
      (advanced_member observation nontrivial half
        (Born.packetAt observation nontrivial half depth tick)
        (Born.sourceExposureAt observation nontrivial half depth tick)
        (wordMapAt observation nontrivial half depth tick word) previous)

