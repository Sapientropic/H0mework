/-- The installed source face and its written physical read share the actual whole ledger and next. -/
theorem actual_installed_source_whole_next (ordinal : Nat) :
    (type_of% (runtimeWholeDebtRCalculationReadoutAt_factorizes observation nontrivial depth half)) ∧
      (type_of% (actual_value_source observation nontrivial half depth)) ∧
      (type_of% (actual_boundary_kernel observation nontrivial half depth ordinal)) ∧
      (type_of% (actual_finite_price observation nontrivial half depth)) :=
  ⟨runtimeWholeDebtRCalculationReadoutAt_factorizes observation nontrivial depth half,
    actual_value_source observation nontrivial half depth,
    actual_boundary_kernel observation nontrivial half depth ordinal,
    actual_finite_price observation nontrivial half depth⟩

theorem actual_contact_source_whole_next (ordinal : Nat) :
    (type_of% (actual_installed_source_whole_next observation nontrivial half depth ordinal)) ∧
      (∀ i : Fin 2,
        type_of% (OriginalWholeDebtRContactSource.original_contact_source observation nontrivial half i)) ∧
      OriginalWholeDebtRContactSource.contactDeterminant c •
          correctedValue observation nontrivial half depth =
        OriginalWholeDebtRContactSource.settledField c := by
  refine ⟨actual_installed_source_whole_next observation nontrivial half depth ordinal,
    (fun i => OriginalWholeDebtRContactSource.original_contact_source observation nontrivial half i), ?_⟩
  have point := (actual_corrected_source observation nontrivial half depth).trans
    (OriginalWholeDebtRProjectionSource.original_source_action observation nontrivial half).symm
  exact (congrArg (fun value : BurnolL2 =>
    OriginalWholeDebtRContactSource.contactDeterminant c • value) point).trans
      (OriginalWholeDebtRContactSource.original_settled_source_action observation nontrivial half)

theorem actual_unweighted_source_whole_next (ordinal : Nat) :
