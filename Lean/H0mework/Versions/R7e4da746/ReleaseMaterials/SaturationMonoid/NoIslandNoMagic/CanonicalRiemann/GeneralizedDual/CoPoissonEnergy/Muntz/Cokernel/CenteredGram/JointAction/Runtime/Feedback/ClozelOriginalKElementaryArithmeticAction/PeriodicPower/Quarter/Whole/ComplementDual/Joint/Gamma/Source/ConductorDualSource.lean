private def reverseOrbit (t : ℝ) (v : BurnolL2) : BurnolL2 :=
  (Real.exp (Real.log (4*t)/2) : ℂ) • burnolMultiplicativeDilation (Real.log (4*t)) v

private theorem inverse_fourier_radial (t : ℝ) (v : BurnolL2) :
    fourierL2.symm (radialOrbit t v) = reverseOrbit t (fourierL2.symm v) := by
  rw [radialOrbit, map_smul, dualReadbackPaid% inverse_fourier_dilation, neg_neg]
  rfl

private def reverseRadialLog (t : ℝ) (v inverseLog : BurnolL2) : BurnolL2 :=
  reverseOrbit t inverseLog - (Real.log (4*t) : ℂ) • fourierL2.symm (radialOrbit t v)

private theorem reverse_radial_log_source (t : ℝ) (v inverseLog : BurnolL2)
    (source : LogPair (fourierL2.symm v) inverseLog) :
    LogPair (fourierL2.symm (radialOrbit t v)) (reverseRadialLog t v inverseLog) := by
  have paid := (dualFourierPaid% logPair_smul) (Real.exp (Real.log (4*t)/2) : ℂ) _ _
    ((dualFourierPaid% logPair_dilation) (Real.log (4*t)) _ _ source)
  have native : (Real.exp (Real.log (4*t)/2) : ℂ) •
      (burnolMultiplicativeDilation (Real.log (4*t)) inverseLog -
        (Real.log (4*t) : ℂ) • burnolMultiplicativeDilation (Real.log (4*t)) (fourierL2.symm v)) =
      reverseRadialLog t v inverseLog := by
    rw [reverseRadialLog, inverse_fourier_radial]
    unfold reverseOrbit
    module
  rw [native] at paid
  rw [inverse_fourier_radial]
  exact paid

private theorem reverse_synthesis_log_source (s : Set ℝ) (hs : MeasurableSet s) (positive : s ⊆ Ioi 0)
    (coefficient : ℝ → ℂ) (measured : Measurable coefficient)
    (weighted : IntegrableOn (fun t => Real.sqrt t * ‖coefficient t‖) s)
    (logWeighted : IntegrableOn (fun t => Real.sqrt t * |Real.log (4*t)| * ‖coefficient t‖) s)
    (v inverseLog : BurnolL2) (source : LogPair (fourierL2.symm v) inverseLog) :
    LogPair (fourierL2.symm (radialSynthesisCLM s hs positive coefficient measured weighted v))
      (fourierL2.symm (radialSynthesisCLM s hs positive coefficient measured weighted (F inverseLog) -
        radialLogSynthesis s coefficient v)) := by
  let inverseCLM := fourierL2.symm.toContinuousLinearEquiv.toContinuousLinearMap
  have inverseApply (value : BurnolL2) : inverseCLM value = fourierL2.symm value := rfl
  have original := (dualStrongPaid% radial_integrable) s hs positive coefficient measured weighted v
  have shifted := log_radial_integrable s hs positive coefficient measured weighted logWeighted v
  have logged := (dualStrongPaid% radial_integrable) s hs positive coefficient measured weighted (F inverseLog)
  have first : IntegrableOn (fun t => coefficient t • fourierL2.symm (radialOrbit t v)) s := by
    simpa only [IntegrableOn, map_smul, inverseApply] using inverseCLM.integrable_comp original
  have second : IntegrableOn (fun t => coefficient t • fourierL2.symm (radialOrbit t (F inverseLog))) s := by
    simpa only [IntegrableOn, map_smul, inverseApply] using inverseCLM.integrable_comp logged
  have shift : IntegrableOn (fun t => ((Real.log (4*t) : ℂ) * coefficient t) •
      fourierL2.symm (radialOrbit t v)) s := by
    simpa only [IntegrableOn, map_smul, inverseApply] using inverseCLM.integrable_comp shifted
  have all : IntegrableOn (fun t => coefficient t • reverseRadialLog t v inverseLog) s := by
    apply (second.sub shift).congr
    filter_upwards with t
    change coefficient t • fourierL2.symm (radialOrbit t (F inverseLog)) -
      ((Real.log (4*t) : ℂ) * coefficient t) • fourierL2.symm (radialOrbit t v) = _
    rw [inverse_fourier_radial, LinearIsometryEquiv.symm_apply_apply]
    unfold reverseRadialLog
    module
  have generated := logPair_integral (volume.restrict s) _ _ first all
    (Eventually.of_forall (fun t => (dualFourierPaid% logPair_smul) (coefficient t) _ _ (reverse_radial_log_source t v inverseLog source)))
  have firstRead : (∫ t : ℝ in s, coefficient t • fourierL2.symm (radialOrbit t v)) =
      fourierL2.symm (radialSynthesisCLM s hs positive coefficient measured weighted v) := by
    rw [radialSynthesisCLM_apply]
    simpa only [map_smul, inverseApply] using inverseCLM.integral_comp_comm original
  have logRead : (∫ t : ℝ in s, coefficient t • fourierL2.symm (radialOrbit t (F inverseLog))) =
      fourierL2.symm (radialSynthesisCLM s hs positive coefficient measured weighted (F inverseLog)) := by
    rw [radialSynthesisCLM_apply]
    simpa only [map_smul, inverseApply] using inverseCLM.integral_comp_comm logged
  have shiftRead : (∫ t : ℝ in s, ((Real.log (4*t) : ℂ) * coefficient t) • fourierL2.symm (radialOrbit t v)) =
      fourierL2.symm (radialLogSynthesis s coefficient v) := by
    simpa only [radialLogSynthesis, map_smul, inverseApply] using inverseCLM.integral_comp_comm shifted
  have allRead : (∫ t : ℝ in s, coefficient t • reverseRadialLog t v inverseLog) =
      (∫ t : ℝ in s, coefficient t • fourierL2.symm (radialOrbit t (F inverseLog))) -
        ∫ t : ℝ in s, ((Real.log (4*t) : ℂ) * coefficient t) • fourierL2.symm (radialOrbit t v) := by
    rw [← integral_sub second shift]
    apply integral_congr_ae
    filter_upwards with t
    rw [inverse_fourier_radial, LinearIsometryEquiv.symm_apply_apply]
    unfold reverseRadialLog
    module
  rw [firstRead, allRead, logRead, shiftRead, ← map_sub] at generated
  exact generated


