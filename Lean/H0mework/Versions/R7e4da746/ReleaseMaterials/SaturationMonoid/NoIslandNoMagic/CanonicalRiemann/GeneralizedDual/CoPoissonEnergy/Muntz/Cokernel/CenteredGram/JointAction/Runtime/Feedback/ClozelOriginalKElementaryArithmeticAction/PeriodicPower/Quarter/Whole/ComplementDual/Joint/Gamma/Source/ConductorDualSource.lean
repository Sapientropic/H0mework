private theorem log_pair_of_weak (v w : BurnolL2)
    (source : ∀ test : SchwartzMap ℝ ℂ,
      inner ℂ (logSchwartzL2 test) v = inner ℂ (test.toLp 2 volume) w) : LogPair v w := by
  let U : Set ℝ := ({0} : Set ℝ)ᶜ
  have openU : IsOpen U := isClosed_singleton.isOpen_compl
  have logContinuous : ContinuousOn (fun x : ℝ => (Real.log |x| : ℂ)) U := by
    intro x outside
    have xne : x ≠ 0 := by simpa only [U, mem_compl_iff, mem_singleton_iff] using outside
    exact (Complex.continuous_ofReal.continuousAt.comp
      (continuous_abs.continuousAt.log (abs_ne_zero.mpr xne))).continuousWithinAt
  have localV := ((Lp.memLp v).locallyIntegrable (by norm_num : (1 : ℝ≥0∞) ≤ 2)).locallyIntegrableOn U
  have localW := ((Lp.memLp w).locallyIntegrable (by norm_num : (1 : ℝ≥0∞) ≤ 2)).locallyIntegrableOn U
  have localLog := localV.continuousOn_mul logContinuous openU.isLocallyClosed
  have vanished := openU.ae_eq_zero_of_integral_contDiff_smul_eq_zero (localLog.sub localW) ?_
  · filter_upwards [vanished, volume.ae_ne (0 : ℝ)] with x read xne
    exact (sub_eq_zero.mp (read (by simpa only [U, mem_compl_iff, mem_singleton_iff] using xne))).symm
  · intro g smooth compact support
    have complexCompact : HasCompactSupport (Complex.ofRealCLM ∘ g) := compact.comp_left rfl
    let test : SchwartzMap ℝ ℂ := complexCompact.toSchwartzMap (Complex.ofRealCLM.contDiff.comp smooth)
    have paired := source test
    have leftRead : inner ℂ (logSchwartzL2 test) v =
        ∫ x : ℝ, g x • ((Real.log |x| : ℂ) * v x) := by
      rw [L2.inner_def]
      apply integral_congr_ae
      filter_upwards [original_log_schwartz_domain test, test.coeFn_toLp 2 volume] with x logged native
      rw [logged, native, RCLike.inner_apply]
      change v x * star ((Real.log |x| : ℂ) * (g x : ℂ)) = _
      rw [star_mul, Complex.star_def, Complex.conj_ofReal, Complex.conj_ofReal, Complex.real_smul]
      ring
    have rightRead : inner ℂ (test.toLp 2 volume) w = ∫ x : ℝ, g x • w x := by
      rw [L2.inner_def]
      apply integral_congr_ae
      filter_upwards [test.coeFn_toLp 2 volume] with x actual
      rw [actual, RCLike.inner_apply]
      change w x * star (g x : ℂ) = _
      rw [Complex.star_def, Complex.conj_ofReal, Complex.real_smul, mul_comm]
    have intLeft : Integrable (fun x : ℝ => g x • ((Real.log |x| : ℂ) * v x)) := by
      have actual := L2.integrable_inner (𝕜 := ℂ) (logSchwartzL2 test) v
      apply actual.congr
      filter_upwards [original_log_schwartz_domain test, test.coeFn_toLp 2 volume] with x logged native
      rw [logged, native, RCLike.inner_apply]
      change v x * star ((Real.log |x| : ℂ) * (g x : ℂ)) = _
      rw [star_mul, Complex.star_def, Complex.conj_ofReal, Complex.conj_ofReal, Complex.real_smul]
      ring
    have intRight := ((Lp.memLp w).locallyIntegrable (by norm_num : (1 : ℝ≥0∞) ≤ 2)).integrable_smul_left_of_hasCompactSupport
      smooth.continuous compact
    change (∫ x : ℝ, g x • ((Real.log |x| : ℂ) * v x - w x)) = 0
    simp_rw [smul_sub]
    rw [integral_sub intLeft intRight, ← leftRead, ← rightRead, paired, sub_self]


theorem gamma_pair_of_log_pairs (v logarithm inverseLog : BurnolL2)
    (position : LogPair v logarithm) (frequency : LogPair (fourierL2.symm v) inverseLog) :
    GammaPair v (logarithm + F inverseLog) := by
  intro test
  have first := (dualStrongPaid% log_pair_pairing) _ _ _ _ (original_log_schwartz_domain test) position
  have second := (dualStrongPaid% log_pair_pairing) _ _ _ _ (original_log_schwartz_domain (𝓕⁻ test)) frequency
  rw [wholeConductorTest, inner_add_left, first, fourierL2.inner_map_eq_flip]
  rw [inner_add_right]
  congr 1
  change inner ℂ (logSchwartzL2 (𝓕⁻ test)) (fourierL2.symm v) = _
  rw [second]
  have inverseRead : (𝓕⁻ test).toLp 2 volume = fourierL2.symm (test.toLp 2 volume) := by
    apply fourierL2.injective
    rw [LinearIsometryEquiv.apply_symm_apply]
    change 𝓕 ((𝓕⁻ test).toLp 2 volume) = test.toLp 2 volume
    rw [SchwartzMap.toLp_fourier_eq, FourierTransform.fourier_fourierInv_eq]
  rw [inverseRead]
  have native := fourierL2.inner_map_map (fourierL2.symm (test.toLp 2 volume)) inverseLog
  simpa only [LinearIsometryEquiv.apply_symm_apply] using native.symm

theorem gamma_value_of_log_pairs (v gamma logarithm inverseLog : BurnolL2)
    (source : GammaPair v gamma) (position : LogPair v logarithm)
    (frequency : LogPair (fourierL2.symm v) inverseLog) : gamma = logarithm + F inverseLog := by
  have strong := gamma_pair_of_log_pairs v logarithm inverseLog position frequency
  apply ext_inner_left ℂ
  intro cotest
  have dense : DenseRange (SchwartzMap.toLpCLM ℝ ℂ 2 (volume : Measure ℝ)) := SchwartzMap.denseRange_toLpCLM (by norm_num)
  refine dense.induction_on (p := fun u : BurnolL2 => inner ℂ u gamma =
      inner ℂ u (logarithm + F inverseLog)) cotest ?_ ?_
  · exact isClosed_eq (continuous_id.inner continuous_const) (continuous_id.inner continuous_const)
  intro test
  change inner ℂ (test.toLp 2 volume) gamma = inner ℂ (test.toLp 2 volume) (logarithm + F inverseLog)
  exact (source test).symm.trans (strong test)

theorem whole_conductor_dual (v gammaV logV inverseLogV w gammaW logW inverseLogW : BurnolL2)
    (sourceV : GammaPair v gammaV) (sourceW : GammaPair w gammaW)
    (positionV : LogPair v logV) (frequencyV : LogPair (fourierL2.symm v) inverseLogV)
    (positionW : LogPair w logW) (frequencyW : LogPair (fourierL2.symm w) inverseLogW) :
    inner ℂ gammaV w = inner ℂ v gammaW := by
  rw [gamma_value_of_log_pairs v gammaV logV inverseLogV sourceV positionV frequencyV,
    gamma_value_of_log_pairs w gammaW logW inverseLogW sourceW positionW frequencyW,
    inner_add_left, inner_add_right, (dualStrongPaid% log_pair_pairing) _ _ _ _ positionV positionW,
    fourierL2.inner_map_eq_flip, (dualStrongPaid% log_pair_pairing) _ _ _ _ frequencyV frequencyW]
  congr 1
  have source := fourierL2.inner_map_map (fourierL2.symm v) inverseLogW
  simpa only [LinearIsometryEquiv.apply_symm_apply] using source.symm

private def firstFourierLog : BurnolL2 :=
  fourierL2.symm (OriginalGamma.Source.TateConductor.dualFirstConductor - dualFirstLog)

private theorem original_first_fourier_log : LogPair (fourierL2.symm ConstantDual.value) firstFourierLog := by
  apply log_pair_of_weak
  intro test
  have gamma := OriginalGamma.Source.TateConductor.original_dual_first_conductor (𝓕 test)
  have position := (dualStrongPaid% log_pair_pairing) _ _ _ _
    (original_log_schwartz_domain (𝓕 test)) original_dual_first_log
  rw [wholeConductorTest, inner_add_left, position,
    FourierTransform.fourierInv_fourier_eq] at gamma
  rw [← SchwartzMap.toLp_fourier_eq] at gamma
  change inner ℂ (F (test.toLp 2 volume)) dualFirstLog +
    inner ℂ (F (logSchwartzL2 test)) ConstantDual.value =
    inner ℂ (F (test.toLp 2 volume)) OriginalGamma.Source.TateConductor.dualFirstConductor at gamma
  rw [fourierL2.inner_map_eq_flip, fourierL2.inner_map_eq_flip, fourierL2.inner_map_eq_flip] at gamma
  rw [firstFourierLog, map_sub, inner_sub_right]
  linear_combination gamma


