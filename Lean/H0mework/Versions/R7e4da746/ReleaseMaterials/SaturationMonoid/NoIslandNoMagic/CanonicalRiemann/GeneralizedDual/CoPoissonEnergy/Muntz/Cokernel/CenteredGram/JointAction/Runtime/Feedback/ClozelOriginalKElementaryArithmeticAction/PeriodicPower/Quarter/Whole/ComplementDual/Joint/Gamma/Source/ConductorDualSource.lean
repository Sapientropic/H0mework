private theorem log_pair_add (v logV w logW : BurnolL2)
    (hv : LogPair v logV) (hw : LogPair w logW) : LogPair (v + w) (logV + logW) := by
  filter_upwards [hv, hw, Lp.coeFn_add v w, Lp.coeFn_add logV logW] with x first second raw logged
  rw [raw, logged]
  simp only [Pi.add_apply]
  rw [first, second, mul_add]

private theorem log_pair_reflect (v w : BurnolL2) (source : LogPair v w) :
    LogPair (reflectL2 v) (reflectL2 w) := by
  have pulled := negMeasurePreserving.quasiMeasurePreserving.ae source
  filter_upwards [Lp.coeFn_compMeasurePreserving v negMeasurePreserving,
    Lp.coeFn_compMeasurePreserving w negMeasurePreserving, pulled] with x raw logged actual
  change reflectL2 v x = v (-x) at raw
  change reflectL2 w x = w (-x) at logged
  rw [logged, raw, actual, abs_neg]

private theorem tail_log_weighted_integrable (c : BurnolCompletedMellinCoordinate) :
    IntegrableOn (fun t : ℝ => Real.sqrt t * |Real.log (4 * t)| * ‖(t : ℂ) ^ (-star c.value - 1)‖) (Ioi q) := by
  let p : ℝ := -c.value.re - 1 / 2
  let epsilon : ℝ := (c.value.re - 1 / 2) / 2
  have positive : 0 < epsilon := by dsimp only [epsilon]; linarith [c.rightHalf]
  have pp : p < -1 := by dsimp only [p]; linarith [c.rightHalf]
  have lower : p - epsilon < -1 := by dsimp only [p, epsilon]; linarith [c.rightHalf]
  have upper : p + epsilon < -1 := by dsimp only [p, epsilon]; linarith [c.rightHalf]
  have main := (integrableOn_Ioi_rpow_of_lt pp (by norm_num : (0 : ℝ) < q)).const_mul |Real.log 4|
  have lo := integrableOn_Ioi_rpow_of_lt lower (by norm_num : (0 : ℝ) < q)
  have hi := integrableOn_Ioi_rpow_of_lt upper (by norm_num : (0 : ℝ) < q)
  apply (main.add ((hi.add lo).const_mul epsilon⁻¹)).mono'
    (((Real.continuous_sqrt.measurable.mul (by fun_prop)).mul (whole_tail_measurable c).norm).aestronglyMeasurable)
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with t inside
  have tpos : 0 < t := lt_trans (by norm_num) inside
  have first := Real.log_le_sub_one_of_pos (Real.rpow_pos_of_pos tpos epsilon)
  have second := Real.log_le_sub_one_of_pos (Real.rpow_pos_of_pos tpos (-epsilon))
  rw [Real.log_rpow tpos] at first second
  have budget : |Real.log t| ≤ epsilon⁻¹ * (t ^ epsilon + t ^ (-epsilon)) := by
    rw [abs_le, ← div_eq_inv_mul]
    constructor
    · rw [neg_le]
      apply (le_div_iff₀ positive).mpr
      nlinarith [Real.rpow_nonneg tpos.le epsilon]
    · apply (le_div_iff₀ positive).mpr
      nlinarith [Real.rpow_nonneg tpos.le (-epsilon)]
  have split : |Real.log (4 * t)| ≤ |Real.log 4| + epsilon⁻¹ * (t ^ epsilon + t ^ (-epsilon)) := by
    rw [Real.log_mul (by norm_num : (4 : ℝ) ≠ 0) tpos.ne']
    exact (abs_add_le _ _).trans (add_le_add le_rfl budget)
  have weight : Real.sqrt t * ‖(t : ℂ) ^ (-star c.value - 1)‖ = t ^ p := by
    rw [Real.sqrt_eq_rpow, Complex.norm_cpow_eq_rpow_re_of_pos tpos, ← Real.rpow_add tpos]
    congr 1
    dsimp only [p]
    simp only [sub_re, neg_re, star_def, conj_re, one_re]
    ring
  simp only [Pi.mul_apply, Pi.add_apply]
  rw [Real.norm_of_nonneg (by positivity : 0 ≤ Real.sqrt t * |Real.log (4*t)| * ‖(t : ℂ)^(-star c.value-1)‖)]
  calc
    _ = |Real.log (4*t)| * t ^ p := by rw [← weight]; ring
    _ ≤ (|Real.log 4| + epsilon⁻¹ * (t ^ epsilon + t ^ (-epsilon))) * t ^ p :=
      mul_le_mul_of_nonneg_right split (Real.rpow_nonneg tpos.le _)
    _ = _ := by
      rw [add_mul, mul_assoc, add_mul, ← Real.rpow_add tpos, ← Real.rpow_add tpos]
      ring_nf

private def logRadialOrbit (t : ℝ) (v logged : BurnolL2) : BurnolL2 :=
  radialOrbit t logged + (Real.log (4*t) : ℂ) • radialOrbit t v

private theorem radial_log_source (t : ℝ) (v logged : BurnolL2) (source : LogPair v logged) :
    LogPair (radialOrbit t v) (logRadialOrbit t v logged) := by
  have paid := (dualFourierPaid% logPair_smul) (Real.exp (Real.log (4*t)/2) : ℂ) _ _
    ((dualFourierPaid% logPair_dilation) (-Real.log (4*t)) v logged source)
  have native : (Real.exp (Real.log (4*t)/2) : ℂ) •
      (burnolMultiplicativeDilation (-Real.log (4*t)) logged -
        ((-Real.log (4*t) : ℝ) : ℂ) • burnolMultiplicativeDilation (-Real.log (4*t)) v) =
      logRadialOrbit t v logged := by
    unfold logRadialOrbit radialOrbit
    push_cast
    module
  rw [native] at paid
  exact paid

private theorem log_radial_integrable (s : Set ℝ) (hs : MeasurableSet s) (positive : s ⊆ Ioi 0)
    (coefficient : ℝ → ℂ) (measured : Measurable coefficient)
    (_weighted : IntegrableOn (fun t => Real.sqrt t * ‖coefficient t‖) s)
    (logWeighted : IntegrableOn (fun t => Real.sqrt t * |Real.log (4*t)| * ‖coefficient t‖) s)
    (v : BurnolL2) : IntegrableOn (fun t => ((Real.log (4*t) : ℂ) * coefficient t) • radialOrbit t v) s := by
  apply (dualStrongPaid% radial_integrable) s hs positive _ (by fun_prop) _ v
  apply logWeighted.congr
  filter_upwards [ae_restrict_mem hs] with t inside
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
  ring

private def radialLogSynthesis (s : Set ℝ) (coefficient : ℝ → ℂ) (v : BurnolL2) : BurnolL2 :=
  ∫ t : ℝ in s, ((Real.log (4*t) : ℂ) * coefficient t) • radialOrbit t v

private theorem radial_synthesis_log_source (s : Set ℝ) (hs : MeasurableSet s) (positive : s ⊆ Ioi 0)
    (coefficient : ℝ → ℂ) (measured : Measurable coefficient)
    (weighted : IntegrableOn (fun t => Real.sqrt t * ‖coefficient t‖) s)
    (logWeighted : IntegrableOn (fun t => Real.sqrt t * |Real.log (4*t)| * ‖coefficient t‖) s)
    (v logged : BurnolL2) (source : LogPair v logged) :
    LogPair (radialSynthesisCLM s hs positive coefficient measured weighted v)
      (radialSynthesisCLM s hs positive coefficient measured weighted logged + radialLogSynthesis s coefficient v) := by
  have first := (dualStrongPaid% radial_integrable) s hs positive coefficient measured weighted v
  have second := (dualStrongPaid% radial_integrable) s hs positive coefficient measured weighted logged
  have shift := log_radial_integrable s hs positive coefficient measured weighted logWeighted v
  have all : IntegrableOn (fun t => coefficient t • logRadialOrbit t v logged) s := by
    apply (second.add shift).congr
    filter_upwards with t
    change coefficient t • radialOrbit t logged + ((Real.log (4*t) : ℂ) * coefficient t) • radialOrbit t v =
      coefficient t • logRadialOrbit t v logged
    unfold logRadialOrbit
    module
  have generated := logPair_integral (volume.restrict s) _ _ first all
    (Eventually.of_forall (fun t => (dualFourierPaid% logPair_smul) (coefficient t) _ _ (radial_log_source t v logged source)))
  rw [radialSynthesisCLM_apply, radialSynthesisCLM_apply, radialLogSynthesis]
  have read : (∫ t : ℝ in s, coefficient t • logRadialOrbit t v logged) =
      (∫ t : ℝ in s, coefficient t • radialOrbit t logged) +
        ∫ t : ℝ in s, ((Real.log (4*t) : ℂ) * coefficient t) • radialOrbit t v := by
    rw [← integral_add second shift]
    apply integral_congr_ae
    filter_upwards with t
    change coefficient t • logRadialOrbit t v logged = coefficient t • radialOrbit t logged +
