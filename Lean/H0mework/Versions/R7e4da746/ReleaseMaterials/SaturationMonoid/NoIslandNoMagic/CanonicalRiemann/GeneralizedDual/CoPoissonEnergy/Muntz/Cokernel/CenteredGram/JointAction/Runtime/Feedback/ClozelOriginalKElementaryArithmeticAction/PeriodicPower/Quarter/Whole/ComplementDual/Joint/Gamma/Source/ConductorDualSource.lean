private theorem base_position_log_source (c : BurnolCompletedMellinCoordinate)
    (v logged : BurnolL2) (source : LogPair v logged) :
    LogPair (originalBaseSynthesis c v) (basePositionLog c v logged) := by
  have returned := radial_synthesis_log_source (Ioc 0 q) measurableSet_Ioc Ioc_subset_Ioi_self
    (burnolRieszReturnRawDerivative c) (burnolRieszReturnRawDerivative_continuous c).measurable
    (return_weighted_integrable c) ((dualFourierPaid% return_log_weighted_integrable) c) v logged source
  have tail := radial_synthesis_log_source (Ioi q) measurableSet_Ioi (Ioi_subset_Ioi (by norm_num))
    (fun t : ℝ => (t : ℂ)^(-star c.value-1)) (whole_tail_measurable c) (tail_weighted_integrable c)
    (tail_log_weighted_integrable c) v logged source
  change LogPair (returnSynthesis c v)
    (returnSynthesis c logged + radialLogSynthesis (Ioc 0 q) (burnolRieszReturnRawDerivative c) v) at returned
  change LogPair (tailSynthesis c v)
    (tailSynthesis c logged + radialLogSynthesis (Ioi q) (fun t : ℝ => (t : ℂ)^(-star c.value-1)) v) at tail
  have head := (dualFourierPaid% logPair_smul) (Kernel.A c) v logged source
  have first := (dualFourierPaid% logPair_sub) _ _ _ _ head returned
  have last := (dualFourierPaid% logPair_smul) (star c.value/2) _ _ tail
  have all := log_pair_add _ _ _ _ first last
  change LogPair (originalBaseSynthesis c v) _ at all
  have read : Kernel.A c • logged -
      (returnSynthesis c logged + radialLogSynthesis (Ioc 0 q) (burnolRieszReturnRawDerivative c) v) +
      (star c.value/2) • (tailSynthesis c logged + radialLogSynthesis (Ioi q) (fun t : ℝ => (t : ℂ)^(-star c.value-1)) v) =
      basePositionLog c v logged := by
    simp only [basePositionLog, originalBaseSynthesis, add_apply, sub_apply, smul_apply, ContinuousLinearMap.id_apply]
    module
  rw [read] at all
  exact all

private theorem b_position_log_source (c : BurnolCompletedMellinCoordinate)
