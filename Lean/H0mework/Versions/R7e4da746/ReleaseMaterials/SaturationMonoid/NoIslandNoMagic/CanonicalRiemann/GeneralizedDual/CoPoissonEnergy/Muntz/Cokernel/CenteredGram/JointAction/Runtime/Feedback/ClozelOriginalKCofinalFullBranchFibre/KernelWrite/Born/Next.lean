section FamilyReceipt
variable {W X : Unit → Type} [∀ target,AddCommGroup (W target)]
local instance familyReceiptGroups (grade : Nat) : ∀ target,AddCommGroup (L.Value W grade target) := L.groups W grade
variable (factory : SF.Factory W X ())
variable (initial : A.M.Frame (Value:=W) (Var:=X) (sort:=()))
variable (cfg : A.Programme (PhysicalValue:=W) (PhysicalVar:=X) (sort:=()))
variable (language : cfg.LowVar=X) (ordinal : Nat)

/-- The existing family source identifies the whole next presentation of its actual born admission. -/
theorem family_born_native_next :
 ((Admissions.sourceRuntime factory initial cfg language).tickAt
  (Admissions.index factory initial cfg language (ordinal+1))).next.node=
 .active (AS.nativePresentation
  (AS.nativeAfterAdmission factory (AS.bornAfterNative
   (AS.nativeAfterAdmission factory (Admissions.packetAt factory initial cfg language ordinal)))) 0) := by
 have full:=AS.admission_native_full factory initial cfg language
  (Admissions.startAt factory initial cfg language (ordinal+1)) 0 (Nat.zero_le _)
 rw [← Admissions.index_eq_stop] at full
 simp only [Nat.add_zero] at full
 have next:=(Family.actual_next factory initial cfg language
  (Admissions.index factory initial cfg language (ordinal+1))).trans
  (congrArg RootInquiryProcessNode.active full)
 exact next.trans (congrArg (fun packet => RootInquiryProcessNode.active
  (AS.nativePresentation (AS.nativeAfterAdmission factory packet) 0))
  (Admissions.packetAt_successor factory initial cfg language ordinal))
end FamilyReceipt

