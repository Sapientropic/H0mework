def tateFirstLog : BurnolL2 := -T OriginalGamma.Source.FirstConductor.dualFirstLog

def tateFirstStrongConductor : BurnolL2 :=
  tateFirstLog + F OriginalGamma.Source.FirstConductor.forwardFirstLog

theorem original_tate_first_log : LogPair (T ConstantDual.value) tateFirstLog :=
  original_tate_log_domain _ _ OriginalGamma.Source.FirstConductor.original_dual_first_log

private theorem inverse_fourier_tate_first : fourierL2.symm (T ConstantDual.value) = ConstantForward.value := by
  apply fourierL2.injective
  rw [fourierL2.apply_symm_apply, OriginalGamma.Source.FirstConductor.original_first_joint,
    OriginalGamma.Source.DivisorJoint.joint_apply, fourierL2_fourierL2,
    ← burnolTateReciprocal_reflect, firstFieldPaid% original_dual_even]

theorem original_tate_strong_conductor : GammaPair (T ConstantDual.value) tateFirstStrongConductor := by
  intro test
  have position := (logPairPaid% log_pair_pairing) (test.toLp 2 volume) (logSchwartzL2 test)
    (T ConstantDual.value) tateFirstLog (original_log_schwartz_domain test) original_tate_first_log
  have spectral := (logPairPaid% log_pair_pairing) ((𝓕⁻ test).toLp 2 volume) (logSchwartzL2 (𝓕⁻ test))
    ConstantForward.value OriginalGamma.Source.FirstConductor.forwardFirstLog
    (original_log_schwartz_domain _) OriginalGamma.Source.FirstConductor.original_forward_first_log
  unfold wholeConductorTest tateFirstStrongConductor
  rw [inner_add_left, inner_add_right, position, fourierL2.inner_map_eq_flip,
    inverse_fourier_tate_first, spectral]
  rw [← SchwartzMap.toLp_fourierInv_eq]
  have paired := fourierL2.inner_map_map (fourierL2.symm (test.toLp 2 volume))
    OriginalGamma.Source.FirstConductor.forwardFirstLog
  rw [fourierL2.apply_symm_apply] at paired
  exact congrArg (fun z : ℂ => inner ℂ (test.toLp 2 volume) tateFirstLog + z) paired.symm

theorem original_tate_strong_readback :
    tateFirstStrongConductor = OriginalGamma.Source.FirstConductor.firstTateConductorValue := by
  have density := SchwartzMap.denseRange_toLpCLM (E := ℝ) («F» := ℂ) (p := 2) (μ := volume) (by norm_num)
  have equal := density.equalizer
    (show Continuous (fun v : BurnolL2 => inner ℂ v tateFirstStrongConductor) from continuous_id.inner continuous_const)
    (show Continuous (fun v : BurnolL2 => inner ℂ v OriginalGamma.Source.FirstConductor.firstTateConductorValue) from continuous_id.inner continuous_const)
    (by
      funext test
      exact (original_tate_strong_conductor test).symm.trans
        (OriginalGamma.Source.FirstConductor.original_first_tate_conductor test))
  apply ext_inner_left ℂ
  intro value
  exact congrFun equal value

theorem original_clock_band_whole_bound (lower upper distance : ℝ)
    (lowerPos : 0 < lower) (upperPos : 0 < upper) (nonzero : distance ≠ 0) :
    ‖clockBand lower upper distance‖ ≤ |distance|⁻¹ := by
  have whole := (gaussianPaid% kernel_clock_integrable) distance nonzero
  have mass := (gaussianPaid% kernel_clock_norm_payment) distance nonzero
  change IntegrableOn (clockDensity distance) (Ioi 0) at whole
  change (∫ time : ℝ in Ioi 0, ‖clockDensity distance time‖) = |distance|⁻¹ at mass
  calc
    _ ≤ ∫ time : ℝ in Set.uIoc lower upper, ‖clockDensity distance time‖ :=
      intervalIntegral.norm_integral_le_integral_norm_uIoc
    _ ≤ ∫ time : ℝ in Ioi 0, ‖clockDensity distance time‖ := by
      apply setIntegral_mono_set whole.norm (Eventually.of_forall (fun _ => norm_nonneg _))
      apply Eventually.of_forall
      intro t inside
      exact lt_of_lt_of_le (lt_min lowerPos upperPos) inside.1.le
    _ = _ := mass

private theorem heat_kernel_integrable (time : ℝ) (positive : 0 < time) :
    Integrable (heatKernel time) := by
  have source : Integrable ((gaussianPaid% sourceHeat) time positive) volume :=
    ((gaussianPaid% sourceHeat) time positive).integrable
  convert source using 1
  ext x
  exact ((gaussianPaid% source_heat_physical) time positive x).symm

theorem original_heat_mass (time : ℝ) (positive : 0 < time) : ∫ x : ℝ, heatKernel time x = 1 := by
  have source := (gaussianPaid% source_heat_frequency) time positive 0
  rw [SchwartzMap.fourier_coe, Real.fourier_eq] at source
  simp only [inner_zero_right, neg_zero, zero_pow (by norm_num : 2 ≠ 0),
    mul_zero, Real.exp_zero, Complex.ofReal_one] at source
  have point := (gaussianPaid% source_heat_physical) time positive
  convert source using 1
  congr 1
  funext x
  rw [point]
  simp [heatKernel]

theorem original_heat_norm_mass (time : ℝ) (positive : 0 < time) :
    ∫ x : ℝ, ‖heatKernel time x‖ = 1 := by
  have point : ∀ x : ℝ, Complex.ofReal ‖heatKernel time x‖ = heatKernel time x := by
    intro x
    change Complex.ofReal ‖((Real.sqrt (Real.pi / time) * Real.exp (-(Real.pi ^ 2 * x ^ 2 / time)) : ℝ) : ℂ)‖ = _
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (Real.sqrt_nonneg _) (Real.exp_pos _).le)]
    rfl
  apply Complex.ofReal_injective
  rw [← integral_complex_ofReal, integral_congr_ae (Eventually.of_forall point), original_heat_mass time positive]
  rfl

private def translated (distance : ℝ) (value : BurnolL2) : BurnolL2 :=
  (DomAddAct.mk (-distance) : DomAddAct ℝ) +ᵥ value

private theorem translated_raw (distance : ℝ) (value : BurnolL2) :
    (translated distance value : ℝ → ℂ) =ᵐ[volume] fun x => value (x - distance) := by
  have actual := DomAddAct.vadd_Lp_ae_eq (DomAddAct.mk (-distance) : DomAddAct ℝ) value
  change (translated distance value : ℝ → ℂ) =ᵐ[volume] fun x => value (-distance + x) at actual
  simpa only [sub_eq_add_neg, add_comm] using actual

private theorem translated_norm (distance : ℝ) (value : BurnolL2) : ‖translated distance value‖ = ‖value‖ :=
  DomAddAct.norm_vadd_Lp _ _

private theorem translated_continuous (value : BurnolL2) : Continuous (fun z : ℝ => translated z value) := by
  have : Fact ((2 : ℝ≥0∞) ≠ ∞) := ⟨by norm_num⟩
  unfold translated
  exact (DomAddAct.continuous_mk.comp continuous_neg).vadd continuous_const

private theorem physical_heat_integrable (time : ℝ) (positive : 0 < time) (value : BurnolL2) :
    Integrable (fun z : ℝ => heatKernel time z • translated z value) := by
  apply (integrable_norm_iff ?_).mp
  · apply ((heat_kernel_integrable time positive).norm.mul_const ‖value‖).congr
    filter_upwards with z
    rw [norm_smul, translated_norm]
  · exact (heat_kernel_integrable time positive).aestronglyMeasurable.smul
      (translated_continuous value).aestronglyMeasurable

def physicalHeatValue (time : ℝ) (value : BurnolL2) : BurnolL2 :=
  ∫ z : ℝ, heatKernel time z • translated z value

theorem original_physical_heat_norm (time : ℝ) (positive : 0 < time) (value : BurnolL2) :
    ‖physicalHeatValue time value‖ ≤ ‖value‖ := by
  calc
    _ ≤ ∫ z : ℝ, ‖heatKernel time z • translated z value‖ := norm_integral_le_integral_norm _
    _ = (∫ z : ℝ, ‖heatKernel time z‖) * ‖value‖ := by
      simp_rw [norm_smul, translated_norm]
      rw [integral_mul_const]
    _ = _ := by rw [original_heat_norm_mass time positive, one_mul]

theorem original_physical_heat_raw (time : ℝ) (positive : 0 < time) (value : BurnolL2) :
    (physicalHeatValue time value : ℝ → ℂ) =ᵐ[volume]
      fun x : ℝ => ∫ z : ℝ, heatKernel time z * value (x - z) := by
  apply OriginalPaPhysicalGreen.source_l2_bochner_coeFn volume _
    (physical_heat_integrable time positive value) (fun p : ℝ × ℝ => heatKernel time p.1 * value (p.2 - p.1))
  · have measured : Measurable (heatKernel time) := by
      change Measurable (fun x : ℝ => ((Real.sqrt (Real.pi / time) * Real.exp (-(Real.pi ^ 2 * x ^ 2 / time)) : ℝ) : ℂ))
      fun_prop
    exact (measured.comp measurable_fst).mul ((Lp.stronglyMeasurable value).measurable.comp (by fun_prop))
  · filter_upwards with z
    filter_upwards [Lp.coeFn_smul (heatKernel time z) (translated z value), translated_raw z value]
      with x scalar shifted
    rw [scalar, Pi.smul_apply, smul_eq_mul, shifted]

private theorem heat_kernel_star (time x : ℝ) : star (heatKernel time x) = heatKernel time x := by
  change star (Complex.ofReal (Real.sqrt (Real.pi / time) * Real.exp (-(Real.pi ^ 2 * x ^ 2 / time)))) = _
  exact Complex.conj_ofReal _

private theorem physical_heat_schwartz (time : ℝ) (positive : 0 < time) (test : SchwartzMap ℝ ℂ) :
    physicalHeatValue time (test.toLp 2 volume) = ((gaussianPaid% sourceHeatCotest) time positive test).toLp 2 volume := by
  apply Lp.ext
  filter_upwards [original_physical_heat_raw time positive (test.toLp 2 volume),
    ((gaussianPaid% sourceHeatCotest) time positive test).coeFn_toLp 2 volume] with x source actual
  rw [source, actual, (gaussianPaid% source_heat_cotest_physical) time positive test x]
  have pulled := (volume.measurePreserving_sub_left x).quasiMeasurePreserving.ae (test.coeFn_toLp 2 volume)
  calc
    _ = ∫ z : ℝ, heatKernel time z * test (x - z) := by
      apply integral_congr_ae
      filter_upwards [pulled] with z value
      rw [value]
    _ = _ := by
      have shifted := integral_sub_left_eq_self (fun z : ℝ => heatKernel time (x - z) * test z) volume x
      simpa only [sub_sub_cancel, heatKernel] using shifted

private theorem spectral_heat_schwartz (time : ℝ) (positive : 0 < time) (test : SchwartzMap ℝ ℂ) :
    heatValue time positive.le (test.toLp 2 volume) =
      ((gaussianPaid% sourceHeatCotest) time positive test).toLp 2 volume := by
  apply fourierL2.symm.injective
  rw [heatValue, fourierL2.symm_apply_apply]
  change heatMultiplier time positive.le (𝓕⁻ (test.toLp 2 volume)) =
    𝓕⁻ (((gaussianPaid% sourceHeatCotest) time positive test).toLp 2 volume)
  rw [SchwartzMap.toLp_fourierInv_eq, SchwartzMap.toLp_fourierInv_eq]
  apply Lp.ext
  filter_upwards [heat_multiplier_raw time positive.le ((𝓕⁻ test).toLp 2 volume),
    (𝓕⁻ test).coeFn_toLp 2 volume,
    (𝓕⁻ ((gaussianPaid% sourceHeatCotest) time positive test)).coeFn_toLp 2 volume]
    with x source first second
  change heatMultiplierValue time positive.le ((𝓕⁻ test).toLp 2 volume) x = _
  rw [source, first, second,
    (gaussianPaid% source_heat_cotest_inverse), SchwartzMap.pairing_apply_apply,
    (gaussianPaid% source_heat_inverse_frequency)]
  rfl

private theorem translated_add (z : ℝ) (v w : BurnolL2) :
    translated z (v + w) = translated z v + translated z w := DomAddAct.vadd_Lp_add _ _ _

private theorem translated_smul (z : ℝ) (scalar : ℂ) (v : BurnolL2) :
    translated z (scalar • v) = scalar • translated z v := by
  rcases v with ⟨⟨⟩, _⟩
  rfl

def physicalHeat (time : ℝ) (positive : 0 < time) : BurnolL2 →L[ℂ] BurnolL2 :=
  ({ toFun := physicalHeatValue time
     map_add' := by
       intro v w
       simp only [physicalHeatValue, translated_add, smul_add]
       exact integral_add (physical_heat_integrable time positive v) (physical_heat_integrable time positive w)
     map_smul' := by
       intro scalar v
       have comm (z : ℝ) : heatKernel time z • (scalar • translated z v) =
           scalar • (heatKernel time z • translated z v) := smul_comm _ _ _
       simp only [physicalHeatValue, translated_smul]
       simp_rw [comm]
       exact integral_smul scalar _ } : BurnolL2 →ₗ[ℂ] BurnolL2).mkContinuous 1 (by
         intro v
         change ‖physicalHeatValue time v‖ ≤ 1 * ‖v‖
         simpa only [one_mul] using original_physical_heat_norm time positive v)

def spectralHeat (time : ℝ) (positive : 0 < time) : BurnolL2 →L[ℂ] BurnolL2 :=
  fourierL2.toContinuousLinearEquiv.toContinuousLinearMap.comp
    ((heatMultiplier time positive.le).comp fourierL2.symm.toContinuousLinearEquiv.toContinuousLinearMap)

theorem original_heat_physical_source (time : ℝ) (positive : 0 < time) (value : BurnolL2) :
    heatValue time positive.le value = physicalHeatValue time value := by
  have density := SchwartzMap.denseRange_toLpCLM (E := ℝ) («F» := ℂ) (p := 2) (μ := volume) (by norm_num)
  have equal := density.equalizer (spectralHeat time positive).continuous (physicalHeat time positive).continuous
    (by
      funext test
      change heatValue time positive.le (test.toLp 2 volume) = physicalHeatValue time (test.toLp 2 volume)
      exact (spectral_heat_schwartz time positive test).trans (physical_heat_schwartz time positive test).symm)
  exact congrFun equal value

theorem original_clock_band_log_bound (lower upper distance : ℝ)
    (lowerPos : 0 < lower) (upperPos : 0 < upper) (nonzero : distance ≠ 0) :
    ‖clockBand lower upper distance‖ ≤
      ((1 + Real.pi⁻¹) * |distance|⁻¹) * |Real.log (upper / lower)| := by
  have inverseInt : IntervalIntegrable (fun t : ℝ => t⁻¹) volume lower upper := by
    apply (show ContinuousOn (fun t : ℝ => t⁻¹) (Ioi 0) from
      fun t pos => (continuousAt_id.inv₀ (ne_of_gt pos)).continuousWithinAt).mono ?_ |>.intervalIntegrable
    intro t inside
    exact lt_of_lt_of_le (lt_min lowerPos upperPos) inside.1
  have bound := intervalIntegral.norm_integral_le_abs_of_norm_le
    (f := clockDensity distance) (g := fun t : ℝ => ((1 + Real.pi⁻¹) * |distance|⁻¹) * t⁻¹)
    («a» := lower) (b := upper) ?_ (inverseInt.const_mul _)
  · rw [intervalIntegral.integral_const_mul, integral_inv_of_pos lowerPos upperPos, abs_mul,
      abs_of_nonneg (by positivity : 0 ≤ (1 + Real.pi⁻¹) * |distance|⁻¹)] at bound
    exact bound
  · filter_upwards [ae_restrict_mem measurableSet_uIoc] with t inside
    have positive : 0 < t := lt_of_lt_of_le (lt_min lowerPos upperPos) inside.1.le
    rw [clockDensity, norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos positive]
    calc
      _ ≤ t⁻¹ * ((1 + Real.pi⁻¹) * |distance|⁻¹) := by
        gcongr
        exact original_heat_distance_bound t distance positive nonzero
      _ = _ := by ring

def boundaryRead (time : ℝ) (test : SchwartzMap ℝ ℂ) : ℂ :=
  ∫ x : ℝ, ∫ y : ℝ, star (test x) * ConstantDual.sawtoothRaw y *
    clockBand time (time * (x * y) ^ 2) (x - y)

def fixedBoundaryRead (time : ℝ) (test : SchwartzMap ℝ ℂ) : ℂ :=
  ∫ x : ℝ, ∫ y : ℝ, star (test x) * ConstantDual.sawtoothRaw y *
    clockBand time (time * x ^ 4) (x - y)

def boundaryRemainder (time : ℝ) (test : SchwartzMap ℝ ℂ) : ℂ :=
  ∫ x : ℝ, ∫ y : ℝ, star (test x) * ConstantDual.sawtoothRaw y *
    clockBand (time * x ^ 4) (time * (x * y) ^ 2) (x - y)

private theorem clock_density_integrable (distance : ℝ) (nonzero : distance ≠ 0) :
    Integrable (clockDensity distance) := by
  have inside := (gaussianPaid% kernel_clock_integrable) distance nonzero
  change IntegrableOn (clockDensity distance) (Ioi 0) at inside
  have erased : clockDensity distance = (Ioi 0).indicator (clockDensity distance) := by
    funext time
    by_cases positive : 0 < time
    · rw [indicator_of_mem (show time ∈ Ioi 0 from positive)]
    · rw [indicator_of_notMem (show time ∉ Ioi 0 from positive)]
      have sign : Real.pi / time ≤ 0 := div_nonpos_of_nonneg_of_nonpos Real.pi_pos.le (le_of_not_gt positive)
      change (time : ℂ)⁻¹ * Complex.ofReal
        (Real.sqrt (Real.pi / time) * Real.exp (-(Real.pi ^ 2 * distance ^ 2 / time))) = 0
      rw [Real.sqrt_eq_zero_of_nonpos sign, zero_mul, Complex.ofReal_zero, mul_zero]
  rw [erased]
  exact inside.integrable_indicator measurableSet_Ioi

private theorem clock_band_difference (lower upper distance : ℝ) (nonzero : distance ≠ 0) :
    clockBand lower upper distance = clockBand 0 upper distance - clockBand 0 lower distance := by
  have whole := clock_density_integrable distance nonzero
  have adjacent := intervalIntegral.integral_add_adjacent_intervals
    (whole.intervalIntegrable («a» := 0) (b := lower)) (whole.intervalIntegrable («a» := lower) (b := upper))
  change clockBand 0 lower distance + clockBand lower upper distance = clockBand 0 upper distance at adjacent
  exact eq_sub_of_add_eq' adjacent

theorem original_clock_band_small (lower upper : ℕ → ℝ) (distance : ℝ) (nonzero : distance ≠ 0)
    (lowerLimit : Tendsto lower atTop (𝓝 0)) (upperLimit : Tendsto upper atTop (𝓝 0)) :
    Tendsto (fun N => clockBand (lower N) (upper N) distance) atTop (𝓝 0) := by
  have continuous := intervalIntegral.continuous_primitive
    (fun l u => (clock_density_integrable distance nonzero).intervalIntegrable («a» := l) (b := u)) 0
  have first := continuous.tendsto 0 |>.comp upperLimit
  have second := continuous.tendsto 0 |>.comp lowerLimit
  have result := first.sub second
  apply (show Tendsto (fun N => clockBand 0 (upper N) distance - clockBand 0 (lower N) distance)
    atTop (𝓝 0) by simpa only [clockBand, intervalIntegral.integral_same, sub_self, Function.comp_apply] using result).congr'
  exact Eventually.of_forall (fun N => (clock_band_difference (lower N) (upper N) distance nonzero).symm)

theorem original_clock_band_large (lower upper : ℕ → ℝ) (distance : ℝ) (nonzero : distance ≠ 0)
    (lowerLimit : Tendsto lower atTop atTop) (upperLimit : Tendsto upper atTop atTop) :
    Tendsto (fun N => clockBand (lower N) (upper N) distance) atTop (𝓝 0) := by
  have inside := (gaussianPaid% kernel_clock_integrable) distance nonzero
  change IntegrableOn (clockDensity distance) (Ioi 0) at inside
  have first := intervalIntegral_tendsto_integral_Ioi 0 inside upperLimit
  have second := intervalIntegral_tendsto_integral_Ioi 0 inside lowerLimit
  have result := first.sub second
  apply (show Tendsto (fun N => clockBand 0 (upper N) distance - clockBand 0 (lower N) distance)
    atTop (𝓝 0) by simpa only [clockBand, sub_self] using result).congr'
  exact Eventually.of_forall (fun N => (clock_band_difference (lower N) (upper N) distance nonzero).symm)

private theorem near_log_bound (u : ℝ) (lower : 1 / 2 ≤ u) (_upper : u ≤ 2) :
    |Real.log u| ≤ 2 * |1 - u| := by
  have positive : 0 < u := by linarith
  rcases le_or_gt 1 u with one | one
  · rw [abs_of_nonneg (Real.log_nonneg one), abs_of_nonpos (by linarith : 1 - u ≤ 0)]
    have source := Real.log_le_sub_one_of_pos positive
    linarith
  · have source := Real.log_le_sub_one_of_pos (inv_pos.mpr positive)
    have estimate : u⁻¹ - 1 ≤ 2 * (1 - u) := by
      have paid : 1 / u ≤ 2 * (1 - u) + 1 := by
        apply (div_le_iff₀ positive).mpr
        nlinarith
      rw [inv_eq_one_div]
      linarith
    rw [abs_of_nonpos (Real.log_nonpos positive.le one.le), abs_of_nonneg (by linarith : 0 ≤ 1 - u)]
    rw [Real.log_inv] at source
    linarith

private theorem far_ratio_bound (u : ℝ) (outside : ¬(1 / 2 ≤ u ∧ u ≤ 2)) :
    1 + |u| ≤ 3 * |1 - u| := by
  rcases le_or_gt u 0 with nonpositive | positive
  · rw [abs_of_nonpos nonpositive, abs_of_nonneg (by linarith : 0 ≤ 1 - u)]
    linarith
  · rw [abs_of_pos positive]
    rcases lt_or_ge u (1 / 2) with small | large
    · rw [abs_of_nonneg (by linarith : 0 ≤ 1 - u)]
      linarith
    · have bigger : 2 < u := lt_of_not_ge (fun fails => outside ⟨large, fails⟩)
      rw [abs_of_nonpos (by linarith : 1 - u ≤ 0)]
      linarith

private def bandBudget : ℝ := 12 * (2 + Real.pi⁻¹)

private theorem band_budget_positive : 0 < bandBudget := by unfold bandBudget; positivity

/-- The changing inverse clock retains its near-diagonal logarithmic cancellation. -/
theorem original_variable_band_point_bound (time x y : ℝ) (positive : 0 < time)
    (xne : x ≠ 0) (yne : y ≠ 0) (apart : x - y ≠ 0) :
    ‖clockBand (time * x ^ 4) (time * (x * y) ^ 2) (x - y)‖ ≤
      bandBudget * |x|⁻¹ * (1 + |y / x|)⁻¹ := by
  let u := y / x
  have xPos : 0 < |x| := abs_pos.mpr xne
  have uNe : u ≠ 0 := div_ne_zero yne xne
  have uApart : 1 - u ≠ 0 := by
    intro fails
    have equality : y = x := by dsimp only [u] at fails; field_simp [xne] at fails; linarith
    exact apart (by rw [equality]; ring)
  have distance : |x - y| = |x| * |1 - u| := by
    rw [← abs_mul]
    congr 1
    dsimp only [u]
    field_simp
  have fourth : 0 < x ^ 4 := by nlinarith [sq_pos_of_ne_zero (pow_ne_zero 2 xne)]
  have lowerPos : 0 < time * x ^ 4 := mul_pos positive fourth
  have upperPos : 0 < time * (x * y) ^ 2 := mul_pos positive (sq_pos_of_ne_zero (mul_ne_zero xne yne))
  have denominatorPos : 0 < 1 + |u| := by positivity
  have budget : 12 * (1 + Real.pi⁻¹) ≤ bandBudget := by unfold bandBudget; linarith
  by_cases near : 1 / 2 ≤ u ∧ u ≤ 2
  · have uPos : 0 < u := by linarith [near.1]
    have ratio : (time * (x * y) ^ 2) / (time * x ^ 4) = u ^ 2 := by
      dsimp only [u]
      field_simp [positive.ne', xne]
    have logarithm : |Real.log ((time * (x * y) ^ 2) / (time * x ^ 4))| ≤ 4 * |1 - u| := by
      rw [ratio, Real.log_pow, abs_mul]
      norm_num only [Nat.cast_ofNat, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
      have logSource := near_log_bound u near.1 near.2
      linarith
    have localBound := original_clock_band_log_bound (time * x ^ 4) (time * (x * y) ^ 2)
      (x - y) lowerPos upperPos apart
    have normal : ‖clockBand (time * x ^ 4) (time * (x * y) ^ 2) (x - y)‖ ≤
        4 * (1 + Real.pi⁻¹) * |x|⁻¹ := by
      calc
        _ ≤ ((1 + Real.pi⁻¹) * |x - y|⁻¹) * |Real.log ((time * (x * y) ^ 2) / (time * x ^ 4))| := localBound
        _ ≤ ((1 + Real.pi⁻¹) * |x - y|⁻¹) * (4 * |1 - u|) := by gcongr
        _ = _ := by rw [distance, mul_inv]; field_simp [abs_ne_zero.mpr uApart]
    have small : 1 + |u| ≤ 3 := by rw [abs_of_pos uPos]; linarith [near.2]
    calc
      _ ≤ 4 * (1 + Real.pi⁻¹) * |x|⁻¹ := normal
      _ ≤ bandBudget * |x|⁻¹ * (1 + |u|)⁻¹ := by
        apply (le_mul_inv_iff₀ denominatorPos).mpr
        calc
          _ ≤ (4 * (1 + Real.pi⁻¹) * |x|⁻¹) * 3 := by gcongr
          _ ≤ _ := by nlinarith [inv_nonneg.mpr xPos.le]
  · have whole := original_clock_band_whole_bound (time * x ^ 4) (time * (x * y) ^ 2)
      (x - y) lowerPos upperPos apart
    have ratio := far_ratio_bound u near
    have budgetThree : 3 ≤ bandBudget := by unfold bandBudget; have pi := inv_pos.mpr Real.pi_pos; linarith
    calc
      _ ≤ |x - y|⁻¹ := whole
      _ ≤ bandBudget * |x|⁻¹ * (1 + |u|)⁻¹ := by
        rw [distance, mul_inv]
        have inverseBound : |1-u|⁻¹ ≤ bandBudget * (1+|u|)⁻¹ := by
          apply (le_mul_inv_iff₀ denominatorPos).mpr
          rw [mul_comm, ← div_eq_mul_inv]
          apply (div_le_iff₀ (abs_pos.mpr uApart)).mpr
          calc
            _ ≤ 3 * |1 - u| := ratio
            _ ≤ _ := by gcongr
        calc
          _ ≤ |x|⁻¹ * (bandBudget * (1+|u|)⁻¹) := mul_le_mul_of_nonneg_left inverseBound (inv_nonneg.mpr xPos.le)
          _ = _ := by ring

private def tailField : BurnolL2 :=
  ((gaussianPaid% tail_weight_memLp).ofReal (K := ℂ)).toLp
    (fun u : ℝ => (((gaussianPaid% tailWeight) u : ℝ) : ℂ))

private theorem tail_field_raw : (tailField : ℝ → ℂ) =ᵐ[volume]
    fun u : ℝ => (((gaussianPaid% tailWeight) u : ℝ) : ℂ) := MemLp.coeFn_toLp _

private def scaledTail (x : ℝ) : BurnolL2 :=
  (Real.sqrt |x| : ℂ)⁻¹ • burnolMultiplicativeDilation (-Real.log |x|) tailField

private theorem scaled_tail_raw (x : ℝ) (xne : x ≠ 0) : (scaledTail x : ℝ → ℂ) =ᵐ[volume]
    fun y : ℝ => ((|x|⁻¹ * (1 + |y / x|)⁻¹ : ℝ) : ℂ) := by
  have scaled := (Measure.quasiMeasurePreserving_smul (μ := (volume : Measure ℝ))
    (Real.exp_ne_zero (-Real.log |x|))).ae tail_field_raw
  filter_upwards [Lp.coeFn_smul (Real.sqrt |x| : ℂ)⁻¹
      (burnolMultiplicativeDilation (-Real.log |x|) tailField),
    burnolMultiplicativeDilation_coeFn (-Real.log |x|) tailField, scaled] with y scalar source raw
  simp only [smul_eq_mul] at raw
  unfold scaledTail
  rw [scalar]
  change (Real.sqrt |x| : ℂ)⁻¹ * burnolMultiplicativeDilation (-Real.log |x|) tailField y = _
  rw [source]
  simp only [burnolL2RawNormalizedDilation, ← mul_assoc]
  rw [raw]
  have rate : Real.exp (-Real.log |x|) = |x|⁻¹ := by rw [Real.exp_neg, Real.exp_log (abs_pos.mpr xne)]
  have half : Real.exp (-Real.log |x| / 2) = (Real.sqrt |x|)⁻¹ := by
    rw [neg_div, Real.exp_neg, Real.sqrt_eq_rpow, Real.rpow_def_of_pos (abs_pos.mpr xne)]
    congr 2
    ring
  have inverseArgument : |(|x|⁻¹ * y)| = |y / x| := by
    rw [abs_mul, abs_inv, abs_abs, abs_div]
    ring
  rw [rate, half]
  change (Real.sqrt |x| : ℂ)⁻¹ * ((Real.sqrt |x|)⁻¹ : ℝ) *
    (((1 + |(|x|⁻¹ * y)|)⁻¹ : ℝ) : ℂ) = _
  rw [inverseArgument]
  push_cast
  rw [← pow_two, inv_pow, ← Complex.ofReal_pow,
    Real.sq_sqrt (abs_nonneg x)]

private theorem scaled_tail_norm (x : ℝ) :
    ‖scaledTail x‖ = (Real.sqrt |x|)⁻¹ * ‖tailField‖ := by
  rw [scaledTail, norm_smul, norm_inv, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (Real.sqrt_nonneg _),
    (burnolMultiplicativeDilation (-Real.log |x|)).norm_map]

private theorem norm_product_integrable (v w : BurnolL2) :
    Integrable (fun y : ℝ => ‖v y‖ * ‖w y‖) := by
  have actual := (L2.integrable_inner (𝕜 := ℂ) v w).norm
  convert actual using 1
  ext y
  simp [RCLike.inner_apply, mul_comm]

private theorem norm_product_bound (v w : BurnolL2) :
    (∫ y : ℝ, ‖v y‖ * ‖w y‖) ≤ ‖v‖ * ‖w‖ := by
  have normIntegral (v : BurnolL2) :
      (∫ y : ℝ, ‖v y‖ ^ (2 : ℝ)) ^ (1 / (2 : ℝ)) = ‖v‖ := by
    rw [Lp.norm_def, MemLp.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num) (Lp.memLp v),
      ENNReal.toReal_ofReal (by positivity)]
    norm_num
  have source := integral_mul_norm_le_Lp_mul_Lq (p := (2 : ℝ)) («q» := (2 : ℝ))
    (Real.holderConjugate_iff.mpr ⟨by norm_num, by norm_num⟩)
    (show MemLp v (ENNReal.ofReal 2) volume by simpa using Lp.memLp v)
    (show MemLp w (ENNReal.ofReal 2) volume by simpa using Lp.memLp w)
  simpa only [normIntegral] using source

private theorem clock_band_measured : Measurable (fun p : (ℝ × ℝ) × ℝ =>
    clockBand p.1.1 p.1.2 p.2) := by
  have source : StronglyMeasurable (fun p : ((ℝ × ℝ) × ℝ) × ℝ =>
      if p.1.1.1 < p.2 ∧ p.2 ≤ p.1.1.2 then clockDensity p.1.2 p.2 else 0) := by
    apply Measurable.stronglyMeasurable
    unfold clockDensity heatKernel
    change Measurable (fun p : ((ℝ × ℝ) × ℝ) × ℝ =>
      if p.1.1.1 < p.2 ∧ p.2 ≤ p.1.1.2 then (p.2 : ℂ)⁻¹ *
        ((Real.sqrt (Real.pi / p.2) * Real.exp (-(Real.pi ^ 2 * p.1.2 ^ 2 / p.2)) : ℝ) : ℂ) else 0)
    apply Measurable.ite
    · exact (measurableSet_lt
        (by fun_prop : Measurable (fun p : ((ℝ×ℝ)×ℝ)×ℝ => p.1.1.1))
        (by fun_prop : Measurable (fun p : ((ℝ×ℝ)×ℝ)×ℝ => p.2))).inter
        (measurableSet_le
          (by fun_prop : Measurable (fun p : ((ℝ×ℝ)×ℝ)×ℝ => p.2))
          (by fun_prop : Measurable (fun p : ((ℝ×ℝ)×ℝ)×ℝ => p.1.1.2)))
    · fun_prop
    · fun_prop
  have flipped : StronglyMeasurable (fun p : ((ℝ × ℝ) × ℝ) × ℝ =>
      if p.1.1.2 < p.2 ∧ p.2 ≤ p.1.1.1 then clockDensity p.1.2 p.2 else 0) := by
    convert source.comp_measurable (by fun_prop : Measurable (fun p : ((ℝ × ℝ) × ℝ) × ℝ =>
      (((p.1.1.2, p.1.1.1), p.1.2), p.2))) using 1
    rfl
  have first := (source.integral_prod_right' (ν := volume)).measurable
  have second := (flipped.integral_prod_right' (ν := volume)).measurable
  convert first.sub second using 1
  funext p
  change (∫ t : ℝ in Ioc p.1.1 p.1.2, clockDensity p.2 t) -
      (∫ t : ℝ in Ioc p.1.2 p.1.1, clockDensity p.2 t) =
    (∫ t : ℝ, if p.1.1 < t ∧ t ≤ p.1.2 then clockDensity p.2 t else 0) -
      (∫ t : ℝ, if p.1.2 < t ∧ t ≤ p.1.1 then clockDensity p.2 t else 0)
  rw [← integral_indicator measurableSet_Ioc, ← integral_indicator measurableSet_Ioc]
  simp only [Set.indicator, mem_Ioc]

private theorem half_weighted_schwartz_integrable (test : SchwartzMap ℝ ℂ) :
    Integrable (fun x : ℝ => ‖test x‖ * (Real.sqrt |x|)⁻¹) := by
  let C := SchwartzMap.seminorm ℝ 0 0 test
  have Cpos : 0 ≤ C := (norm_nonneg (test 0)).trans (test.norm_le_seminorm ℝ 0)
  have power : IntervalIntegrable (fun x : ℝ => (x : ℂ) ^ ((-(1 / 2 : ℝ)) : ℂ)) volume (-1) 1 :=
    intervalIntegral.intervalIntegrable_cpow' (by norm_num)
  have head : IntegrableOn (fun x : ℝ => (Real.sqrt |x|)⁻¹) (Icc (-1) 1) := by
    have source := (intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num : (-1 : ℝ) ≤ 1)).mp power.norm
    apply source.congr
    filter_upwards with x
    rw [← Complex.ofReal_neg, Complex.norm_cpow_real, Complex.norm_real, Real.norm_eq_abs,
      Real.sqrt_eq_rpow, Real.rpow_neg (abs_nonneg x)]
  have whole := (head.integrable_indicator measurableSet_Icc).const_mul C |>.add test.integrable.norm
  apply whole.mono' (by fun_prop)
  filter_upwards with x
  have squareRoot : 0 ≤ (Real.sqrt |x|)⁻¹ := by positivity
  rw [Real.norm_of_nonneg (mul_nonneg (norm_nonneg _) squareRoot)]
  simp only [Pi.add_apply]
  by_cases inside : x ∈ Icc (-1 : ℝ) 1
  · rw [indicator_of_mem inside]
    have estimate := mul_le_mul_of_nonneg_right (test.norm_le_seminorm ℝ x) squareRoot
    dsimp only [C] at *
    linarith [norm_nonneg (test x)]
  · rw [indicator_of_notMem inside, mul_zero, zero_add]
    have beyond : 1 < |x| := lt_of_not_ge (fun bounded => inside (abs_le.mp bounded))
    have rootOne : 1 ≤ Real.sqrt |x| := by
      rw [Real.le_sqrt (by norm_num)]
      · nlinarith
      · exact abs_nonneg x
    exact mul_le_of_le_one_right (norm_nonneg _) (inv_le_one_of_one_le₀ rootOne)

private def variableBand (time x y : ℝ) : ℂ :=
  ConstantDual.sawtoothRaw y * clockBand (time * x ^ 4) (time * (x * y) ^ 2) (x - y)

private theorem variable_band_measured (time : ℝ) :
    Measurable (fun p : ℝ × ℝ => variableBand time p.1 p.2) := by
  have clock := clock_band_measured.comp (by fun_prop : Measurable (fun p : ℝ × ℝ =>
    ((time * p.1 ^ 4, time * (p.1 * p.2) ^ 2), p.1 - p.2)))
  have field : Measurable (fun p : ℝ × ℝ => ConstantDual.sawtoothRaw p.2) := by
    unfold ConstantDual.sawtoothRaw
    fun_prop
  exact field.mul clock

private theorem variable_band_budget (time x : ℝ) (positive : 0 < time) (xne : x ≠ 0) :
    ∀ᵐ y : ℝ ∂volume, ‖variableBand time x y‖ ≤
      bandBudget * (‖ConstantDual.value y‖ * ‖scaledTail x y‖) := by
  filter_upwards [ConstantDual.value_coeFn, scaled_tail_raw x xne,
    volume.ae_ne (0 : ℝ), volume.ae_ne x] with y field tail yne apart
  have distance : x - y ≠ 0 := sub_ne_zero.mpr apart.symm
  rw [variableBand, norm_mul, ← field, tail, Complex.norm_real,
    Real.norm_of_nonneg (by positivity : 0 ≤ |x|⁻¹ * (1 + |y / x|)⁻¹)]
  calc
    _ ≤ ‖ConstantDual.value y‖ * (bandBudget * |x|⁻¹ * (1 + |y / x|)⁻¹) := by
      gcongr
      exact original_variable_band_point_bound time x y positive xne yne distance
    _ = _ := by ring

private theorem variable_band_integrable (time x : ℝ) (positive : 0 < time) (xne : x ≠ 0) :
    Integrable (variableBand time x) := by
  have measured := (variable_band_measured time).comp (by fun_prop : Measurable (fun y : ℝ => (x,y)))
  exact ((norm_product_integrable ConstantDual.value (scaledTail x)).const_mul bandBudget).mono'
    measured.aestronglyMeasurable (variable_band_budget time x positive xne)

private theorem variable_band_norm_source (time x : ℝ) (positive : 0 < time) (xne : x ≠ 0) :
    (∫ y : ℝ, ‖variableBand time x y‖) ≤
      (bandBudget * ‖ConstantDual.value‖ * ‖tailField‖) * (Real.sqrt |x|)⁻¹ := by
  calc
    _ ≤ ∫ y : ℝ, bandBudget * (‖ConstantDual.value y‖ * ‖scaledTail x y‖) :=
      integral_mono_ae (variable_band_integrable time x positive xne).norm
        ((norm_product_integrable ConstantDual.value (scaledTail x)).const_mul bandBudget)
        (variable_band_budget time x positive xne)
    _ = bandBudget * ∫ y : ℝ, ‖ConstantDual.value y‖ * ‖scaledTail x y‖ := integral_const_mul _ _
    _ ≤ bandBudget * (‖ConstantDual.value‖ * ‖scaledTail x‖) :=
      mul_le_mul_of_nonneg_left (norm_product_bound ConstantDual.value (scaledTail x)) band_budget_positive.le
    _ = _ := by rw [scaled_tail_norm]; ring

private theorem variable_band_inner_zero (time : ℕ → ℝ) (positive : ∀ N, 0 < time N)
    (limit : Tendsto time atTop (𝓝 0) ∨ Tendsto time atTop atTop) (x : ℝ) (xne : x ≠ 0) :
    Tendsto (fun N => ∫ y : ℝ, variableBand (time N) x y) atTop (𝓝 0) := by
  have source := tendsto_integral_of_dominated_convergence (f := fun _ : ℝ => (0 : ℂ))
    (fun y : ℝ => bandBudget * (‖ConstantDual.value y‖ * ‖scaledTail x y‖))
    (fun N => ((variable_band_measured (time N)).comp
      (by fun_prop : Measurable (fun y : ℝ => (x,y)))).aestronglyMeasurable)
    ((norm_product_integrable ConstantDual.value (scaledTail x)).const_mul bandBudget)
    (fun N => variable_band_budget (time N) x (positive N) xne) ?_
  · simpa using source
  · filter_upwards [volume.ae_ne (0 : ℝ), volume.ae_ne x] with y yne apart
    have distance : x - y ≠ 0 := sub_ne_zero.mpr apart.symm
    have clock : Tendsto
        (fun N => clockBand (time N * x ^ 4) (time N * (x * y) ^ 2) (x-y)) atTop (𝓝 0) := by
      rcases limit with cold | hot
      · exact original_clock_band_small _ _ _ distance
          (by simpa using cold.mul_const (x ^ 4)) (by simpa using cold.mul_const ((x*y)^2))
      · have xFourth : 0 < x ^ 4 := by nlinarith [sq_pos_of_ne_zero (pow_ne_zero 2 xne)]
        exact original_clock_band_large _ _ _ distance
          (hot.atTop_mul_const xFourth) (hot.atTop_mul_const (sq_pos_of_ne_zero (mul_ne_zero xne yne)))
    simpa only [variableBand, mul_zero, Function.comp_apply] using clock.const_mul (ConstantDual.sawtoothRaw y)

/-- Both extreme clocks erase only the changing-clock remainder, not the diagonal mass. -/
theorem original_variable_boundary_zero (time : ℕ → ℝ) (positive : ∀ N, 0 < time N)
    (limit : Tendsto time atTop (𝓝 0) ∨ Tendsto time atTop atTop) (test : SchwartzMap ℝ ℂ) :
    Tendsto (fun N => boundaryRemainder (time N) test) atTop (𝓝 0) := by
  let C := bandBudget * ‖ConstantDual.value‖ * ‖tailField‖
  have measured (N : ℕ) : AEStronglyMeasurable (fun x : ℝ =>
      star (test x) * ∫ y : ℝ, variableBand (time N) x y) :=
    ((by fun_prop : Measurable (fun x : ℝ => star (test x))).mul
      ((variable_band_measured (time N)).stronglyMeasurable.integral_prod_right'.measurable)).aestronglyMeasurable
  have source := tendsto_integral_of_dominated_convergence (f := fun _ : ℝ => (0 : ℂ))
    (fun x : ℝ => C * (‖test x‖ * (Real.sqrt |x|)⁻¹)) measured
    ((half_weighted_schwartz_integrable test).const_mul C) ?_ ?_
  · have clean := source
    simp only [integral_zero] at clean
    apply clean.congr'
    apply Eventually.of_forall
    intro N
    unfold boundaryRemainder
    apply integral_congr_ae
    filter_upwards with x
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with y
    unfold variableBand
    ring
  · intro N
    filter_upwards [volume.ae_ne (0 : ℝ)] with x xne
    rw [norm_mul, norm_star]
    calc
      _ ≤ ‖test x‖ * ∫ y : ℝ, ‖variableBand (time N) x y‖ := by gcongr; exact norm_integral_le_integral_norm _
      _ ≤ ‖test x‖ * (C * (Real.sqrt |x|)⁻¹) := by
        gcongr
        exact variable_band_norm_source (time N) x (positive N) xne
      _ = _ := by ring
  · filter_upwards [volume.ae_ne (0 : ℝ)] with x xne
    simpa using (variable_band_inner_zero time positive limit x xne).const_mul (star (test x))

end
