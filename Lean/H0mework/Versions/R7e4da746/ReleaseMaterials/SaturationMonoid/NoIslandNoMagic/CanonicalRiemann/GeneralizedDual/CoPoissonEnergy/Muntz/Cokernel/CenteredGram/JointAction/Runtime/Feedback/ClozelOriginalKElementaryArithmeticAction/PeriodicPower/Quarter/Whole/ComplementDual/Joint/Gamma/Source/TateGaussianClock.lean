def heatKernel (time distance : ℝ) : ℂ := (gaussianPaid% offDiagonalHeat) time distance

def reciprocalHeat (time x y : ℝ) : ℂ :=
  (Complex.ofReal |x|)⁻¹ * (Complex.ofReal |y|)⁻¹ * heatKernel time (x⁻¹ - y⁻¹)

theorem original_heat_inversion_clock (time x y : ℝ) (positive : 0 < time)
    (xne : x ≠ 0) (yne : y ≠ 0) :
    reciprocalHeat time x y = heatKernel (time * (x * y) ^ 2) (x - y) := by
  have scale : Real.sqrt (Real.pi / (time * (x * y) ^ 2)) =
      Real.sqrt (Real.pi / time) / |x * y| := by
    rw [← div_div, Real.sqrt_div, Real.sqrt_sq_eq_abs]
    positivity
  have rate : (x⁻¹ - y⁻¹) ^ 2 / time = (x - y) ^ 2 / (time * (x * y) ^ 2) := by
    field_simp [positive.ne', xne, yne]
    ring
  unfold reciprocalHeat heatKernel
  change (Complex.ofReal |x|)⁻¹ * (Complex.ofReal |y|)⁻¹ *
    ((Real.sqrt (Real.pi / time) * Real.exp (-(Real.pi ^ 2 * (x⁻¹ - y⁻¹) ^ 2 / time)) : ℝ) : ℂ) =
      ((Real.sqrt (Real.pi / (time * (x * y) ^ 2)) *
        Real.exp (-(Real.pi ^ 2 * (x - y) ^ 2 / (time * (x * y) ^ 2))) : ℝ) : ℂ)
  rw [scale, abs_mul]
  have exponent : -(Real.pi ^ 2 * (x⁻¹ - y⁻¹) ^ 2 / time) =
      -(Real.pi ^ 2 * (x - y) ^ 2 / (time * (x * y) ^ 2)) := by
    rw [mul_div_assoc, rate]
    ring
  rw [exponent]
  push_cast
  field_simp [Complex.ofReal_ne_zero.mpr (abs_ne_zero.mpr xne),
    Complex.ofReal_ne_zero.mpr (abs_ne_zero.mpr yne)]

def clockDensity (distance time : ℝ) : ℂ := (time : ℂ)⁻¹ * heatKernel time distance

def clockBand (lower upper distance : ℝ) : ℂ :=
  ∫ time : ℝ in lower..upper, clockDensity distance time

private theorem clock_density_interval (distance lower upper : ℝ)
    (lowerPos : 0 < lower) (upperPos : 0 < upper) :
    IntervalIntegrable (clockDensity distance) volume lower upper := by
  have continuous : ContinuousOn (clockDensity distance) (Ioi 0) := by
    intro t pos
    unfold clockDensity heatKernel
    change ContinuousWithinAt (fun time : ℝ => (time : ℂ)⁻¹ *
      ((Real.sqrt (Real.pi / time) * Real.exp (-(Real.pi ^ 2 * distance ^ 2 / time)) : ℝ) : ℂ)) (Ioi 0) t
    apply ContinuousAt.continuousWithinAt
    have nonzero : t ≠ 0 := ne_of_gt pos
    apply (Complex.continuous_ofReal.continuousAt.inv₀ (Complex.ofReal_ne_zero.mpr nonzero)).mul
    exact Complex.continuous_ofReal.continuousAt.comp (by fun_prop)
  apply (continuous.mono ?_).intervalIntegrable
  intro t inside
  exact lt_of_lt_of_le (lt_min lowerPos upperPos) inside.1

theorem original_inverse_clock_band (lower upper x y : ℝ) (lowerPos : 0 < lower)
    (upperPos : 0 < upper) (xne : x ≠ 0) (yne : y ≠ 0) :
    (∫ time : ℝ in lower..upper, (time : ℂ)⁻¹ * reciprocalHeat time x y) =
      clockBand (lower * (x * y) ^ 2) (upper * (x * y) ^ 2) (x - y) := by
  have scale : (x * y) ^ 2 ≠ 0 := pow_ne_zero _ (mul_ne_zero xne yne)
  have point : ∀ time : ℝ, 0 < time →
      (time : ℂ)⁻¹ * reciprocalHeat time x y =
        (((x * y) ^ 2 : ℝ) : ℂ) * clockDensity (x - y) (time * (x * y) ^ 2) := by
    intro time positive
    rw [original_heat_inversion_clock time x y positive xne yne, clockDensity, Complex.ofReal_mul,
      Complex.ofReal_pow]
    field_simp [Complex.ofReal_ne_zero.mpr xne, Complex.ofReal_ne_zero.mpr yne,
      Complex.ofReal_ne_zero.mpr positive.ne']
  calc
    _ = ∫ time : ℝ in lower..upper,
        (((x * y) ^ 2 : ℝ) : ℂ) * clockDensity (x - y) (time * (x * y) ^ 2) := by
      apply intervalIntegral.integral_congr
      intro t inside
      exact point t (lt_of_lt_of_le (lt_min lowerPos upperPos) inside.1)
    _ = _ := by
      rw [intervalIntegral.integral_const_mul]
      exact intervalIntegral.smul_integral_comp_mul_right (clockDensity (x - y)) ((x * y) ^ 2)

theorem original_inverse_clock_boundary (lower upper x y : ℝ)
    (lowerPos : 0 < lower) (upperPos : 0 < upper) (xne : x ≠ 0) (yne : y ≠ 0) :
    (∫ time : ℝ in lower..upper, (time : ℂ)⁻¹ *
      (reciprocalHeat time x y - heatKernel time (x - y))) =
      clockBand upper (upper * (x * y) ^ 2) (x - y) -
        clockBand lower (lower * (x * y) ^ 2) (x - y) := by
  have rhoPos : 0 < (x * y) ^ 2 := sq_pos_of_ne_zero (mul_ne_zero xne yne)
  have band := original_inverse_clock_band lower upper x y lowerPos upperPos xne yne
  have original := clock_density_interval (x - y) lower upper lowerPos upperPos
  have inverted := clock_density_interval (x - y) (lower * (x * y) ^ 2) (upper * (x * y) ^ 2)
    (mul_pos lowerPos rhoPos) (mul_pos upperPos rhoPos)
  have high := intervalIntegral.integral_add_adjacent_intervals original
    (clock_density_interval (x - y) upper (upper * (x * y) ^ 2) upperPos (mul_pos upperPos rhoPos))
  have low := intervalIntegral.integral_add_adjacent_intervals
    (clock_density_interval (x - y) lower (lower * (x * y) ^ 2) lowerPos (mul_pos lowerPos rhoPos)) inverted
  change clockBand lower upper (x - y) + clockBand upper (upper * (x * y) ^ 2) (x - y) = _ at high
  change clockBand lower (lower * (x * y) ^ 2) (x - y) + clockBand (lower * (x * y) ^ 2) (upper * (x * y) ^ 2) (x - y) = _ at low
  have linked := high.trans low.symm
  have inverseInt : IntervalIntegrable (fun time : ℝ => (time : ℂ)⁻¹ * reciprocalHeat time x y)
      volume lower upper := by
    have localBand := clock_density_interval (x⁻¹ - y⁻¹) lower upper lowerPos upperPos
    convert localBand.const_mul ((Complex.ofReal |x|)⁻¹ * (Complex.ofReal |y|)⁻¹) using 1
    ext t
    unfold reciprocalHeat clockDensity
    ring
  calc
    _ = clockBand (lower * (x * y) ^ 2) (upper * (x * y) ^ 2) (x - y) - clockBand lower upper (x - y) := by
      simp_rw [mul_sub]
      change (∫ time : ℝ in lower..upper, (time : ℂ)⁻¹ * reciprocalHeat time x y - clockDensity (x - y) time) = _
      rw [intervalIntegral.integral_sub inverseInt original, band]
      rfl
    _ = _ := by linear_combination -linked

private theorem heat_multiplier_bound (time : ℝ) (positive : 0 ≤ time) (x : ℝ) :
    ‖(Real.exp (-(time * x ^ 2)) : ℂ)‖ ≤ 1 := by
  rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
  exact Real.exp_le_one_iff.mpr (neg_nonpos.mpr (mul_nonneg positive (sq_nonneg _)))

private theorem heat_multiplier_mem (time : ℝ) (positive : 0 ≤ time) (value : BurnolL2) :
    MemLp (fun x : ℝ => (Real.exp (-(time * x ^ 2)) : ℂ) * value x) 2 volume := by
  apply (Lp.memLp value).mono
    ((by fun_prop : Measurable (fun x : ℝ => (Real.exp (-(time * x ^ 2)) : ℂ))).aestronglyMeasurable.mul
      (Lp.memLp value).aestronglyMeasurable)
  filter_upwards with x
  dsimp only [Pi.mul_apply]
  rw [norm_mul]
  exact mul_le_of_le_one_left (norm_nonneg _) (heat_multiplier_bound time positive x)

private def heatMultiplierValue (time : ℝ) (positive : 0 ≤ time) (value : BurnolL2) : BurnolL2 :=
  (heat_multiplier_mem time positive value).toLp (fun x : ℝ => (Real.exp (-(time * x ^ 2)) : ℂ) * value x)

private theorem heat_multiplier_raw (time : ℝ) (positive : 0 ≤ time) (value : BurnolL2) :
    (heatMultiplierValue time positive value : ℝ → ℂ) =ᵐ[volume]
      fun x : ℝ => (Real.exp (-(time * x ^ 2)) : ℂ) * value x := MemLp.coeFn_toLp _

private theorem heat_multiplier_norm (time : ℝ) (positive : 0 ≤ time) (value : BurnolL2) :
    ‖heatMultiplierValue time positive value‖ ≤ ‖value‖ := by
  apply Lp.norm_le_norm_of_ae_le
  filter_upwards [heat_multiplier_raw time positive value] with x actual
  rw [actual, norm_mul]
  exact mul_le_of_le_one_left (norm_nonneg _) (heat_multiplier_bound time positive x)

def heatMultiplier (time : ℝ) (positive : 0 ≤ time) : BurnolL2 →L[ℂ] BurnolL2 :=
  ({ toFun := heatMultiplierValue time positive
     map_add' := by
       intro v w
       apply Lp.ext
       filter_upwards [heat_multiplier_raw time positive (v + w), Lp.coeFn_add v w,
         Lp.coeFn_add (heatMultiplierValue time positive v) (heatMultiplierValue time positive w),
         heat_multiplier_raw time positive v, heat_multiplier_raw time positive w] with x whole input output first second
       rw [whole, input, output]
       simp only [Pi.add_apply]
       rw [first, second]
       ring
     map_smul' := by
       intro z v
       apply Lp.ext
       simp only [RingHom.id_apply]
       filter_upwards [heat_multiplier_raw time positive (z • v), Lp.coeFn_smul z v,
         Lp.coeFn_smul z (heatMultiplierValue time positive v), heat_multiplier_raw time positive v]
         with x whole input output original
       rw [whole, input, output]
       simp only [Pi.smul_apply, smul_eq_mul]
       rw [original]
       ring } : BurnolL2 →ₗ[ℂ] BurnolL2).mkContinuous 1 (by
         intro v
         change ‖heatMultiplierValue time positive v‖ ≤ 1 * ‖v‖
         simpa only [one_mul] using heat_multiplier_norm time positive v)

def heatValue (time : ℝ) (positive : 0 ≤ time) (value : BurnolL2) : BurnolL2 :=
  F (heatMultiplier time positive (fourierL2.symm value))

theorem original_heat_distance_bound (time distance : ℝ) (positive : 0 < time) (nonzero : distance ≠ 0) :
    ‖heatKernel time distance‖ ≤ (1 + Real.pi⁻¹) * |distance|⁻¹ := by
  let scale : ℝ := Real.sqrt (Real.pi / time) * |distance|
  have scalePos : 0 ≤ scale := mul_nonneg (Real.sqrt_nonneg _) (abs_nonneg _)
  have square : scale ^ 2 = Real.pi / time * distance ^ 2 := by
    dsimp only [scale]
    rw [mul_pow, Real.sq_sqrt (div_nonneg Real.pi_pos.le positive.le), sq_abs]
  have exponent : Real.pi * scale ^ 2 = Real.pi ^ 2 * distance ^ 2 / time := by
    rw [square]
    ring
  have reciprocal : Real.pi * Real.pi⁻¹ = 1 := mul_inv_cancel₀ Real.pi_ne_zero
  have elementary : scale ≤ (1 + Real.pi⁻¹) * Real.exp (Real.pi * scale ^ 2) := by
    have linear : scale ≤ Real.pi * scale ^ 2 + Real.pi⁻¹ := by
      apply le_of_mul_le_mul_left _ Real.pi_pos
      nlinarith [sq_nonneg (Real.pi * scale - 1 / 2)]
    calc
      scale ≤ (1 + Real.pi⁻¹) * (Real.pi * scale ^ 2 + 1) := by
        have inverseNonnegative := (inv_pos.mpr Real.pi_pos).le
        nlinarith [mul_nonneg inverseNonnegative (mul_nonneg Real.pi_pos.le (sq_nonneg scale))]
      _ ≤ _ := mul_le_mul_of_nonneg_left (Real.add_one_le_exp _) (by positivity)
  have bound : scale * Real.exp (-(Real.pi * scale ^ 2)) ≤ 1 + Real.pi⁻¹ := by
    calc
      _ ≤ (1 + Real.pi⁻¹) * Real.exp (Real.pi * scale ^ 2) * Real.exp (-(Real.pi * scale ^ 2)) :=
        mul_le_mul_of_nonneg_right elementary (Real.exp_pos _).le
      _ = _ := by rw [mul_assoc, ← Real.exp_add, add_neg_cancel, Real.exp_zero, mul_one]
  have rawNorm : ‖heatKernel time distance‖ =
      Real.sqrt (Real.pi / time) * Real.exp (-(Real.pi ^ 2 * distance ^ 2 / time)) := by
    change ‖((Real.sqrt (Real.pi / time) * Real.exp (-(Real.pi ^ 2 * distance ^ 2 / time)) : ℝ) : ℂ)‖ = _
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (Real.sqrt_nonneg _) (Real.exp_pos _).le)]
  rw [rawNorm]
  apply le_of_mul_le_mul_right _ (abs_pos.mpr nonzero)
  simp only [mul_assoc, inv_mul_cancel₀ (abs_ne_zero.mpr nonzero), mul_one]
  rw [exponent] at bound
  dsimp only [scale] at bound
  convert bound using 1 <;> first | rfl | ring

