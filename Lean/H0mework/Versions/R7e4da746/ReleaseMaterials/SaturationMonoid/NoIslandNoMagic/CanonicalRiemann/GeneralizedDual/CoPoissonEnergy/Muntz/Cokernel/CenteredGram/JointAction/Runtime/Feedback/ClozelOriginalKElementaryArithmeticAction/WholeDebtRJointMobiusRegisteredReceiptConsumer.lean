variable (observation : GeneratedRiemannZeroObservation)
variable (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
variable (half : OriginalKCombCalculation.Half observation) (depth ordinal : Nat)
local notation "c" => OriginalKCombCofinalTwoDirection.coordinate observation nontrivial half

private theorem actual_field : W.actualValue observation nontrivial half depth 0 = J.inverseSource c := by
  rw [W.actualValue, W.bound_code_value]
  exact OriginalKJointMobiusSourceCalculation.actual_code_field c

private theorem actual_complete_input_raw :
    (burnolEvenAmbientProjection (W.sourceValue observation nontrivial half depth) : ℝ → ℂ) =ᵐ[volume]
      J.jointRaw c := by
  rw [W.source_projection_joint]
  exact J.actual_joint_raw c

/-- The actual registered inverse, rather than an admitted target wave, feeds the remainder action. -/
private theorem actual_source_action (test : SchwartzMap ℝ ℂ) :
    burnolRemainderSourceRead (W.actualValue observation nontrivial half depth 0) test =
      ∫ x : ℝ, test x * (J.paWave c) x := by
  rw [actual_field]
  simpa only [Lp.toTemperedDistributionCLM_apply, Lp.toTemperedDistribution_apply,
    smul_eq_mul] using OriginalWholeDebtRJointMobiusSource.actual_source_action c test

private theorem actual_pa_wave : J.paWave c ∈ burnolOriginalPaInL2 :=
  OriginalWholeDebtRJointMobiusSource.actual_pa_wave c

private theorem actual_complete_joint_action :
    (J.jointValue c : BurnolL2) = J.paWave c +
      (U.unitCoefficient c • burnolUnitTailResponse c 4 + U.response c) := by
  rw [OriginalWholeDebtRJointMobiusProgramme.actual_joint_wave_response, U.actual_source_update]

private theorem actual_generated_R_source :
    (fourierL2 (W.actualValue observation nontrivial half depth 1) : ℝ → ℂ) =ᵐ[volume]
      G.actionRaw c := by
  rw [R.actual_field]
  exact G.actual_whole_action observation nontrivial half

private theorem actual_forward_foot_required :
    ¬ (fourierL2 (W.actualValue observation nontrivial half depth 1) : ℝ → ℂ) =ᵐ[volume]
      burnolInnerGapForward (G.outwardRaw c) := by
  intro stripped
  have same := (actual_generated_R_source observation nontrivial half depth).symm.trans stripped
  obtain ⟨x, equal, nonzero⟩ := (same.and (volume.ae_ne (0 : ℝ))).exists
  have footZero : G.homogeneousCoefficient c * G.powerRaw c x = 0 := by
    change burnolInnerGapForward (G.outwardRaw c) x + G.homogeneousCoefficient c * G.powerRaw c x =
      burnolInnerGapForward (G.outwardRaw c) x at equal
    linear_combination equal
  apply mul_ne_zero (G.actual_homogeneous_ne_zero observation nontrivial half) ?_ footZero
  change ((|x| : ℝ) : ℂ) ^ ((c).value - 1) ≠ 0
  exact Complex.cpow_ne_zero_iff.mpr (Or.inl (Complex.ofReal_ne_zero.mpr (abs_ne_zero.mpr nonzero)))

private theorem actual_generated_R_writeback :
    fourierL2.symm (G.updatedWave observation nontrivial half) =
      W.actualValue observation nontrivial half depth 1 := by
  rw [R.actual_field]
  exact G.actual_source_writeback observation nontrivial half

private theorem actual_generated_R_B_writeback :
    fourierL2.symm (G.updatedWave observation nontrivial half) =
      (burnolEvenAmbientProjection (W.actualValue observation nontrivial half depth 1) : BurnolL2) +
        G.homogeneousCoefficient c •
          OriginalKCrossParameterRAdjointSource.PhysicalOutsideSource.physicalOutsideColumn c := by
  rw [R.actual_field]
  exact G.actual_complete_B_writeback observation nontrivial half

