       (type_of% (U.actual_zero_window c)) ∧
       (type_of% (U.actual_physical observation nontrivial half)) ∧
       (type_of% (U.actual_programme_price observation nontrivial half)) ∧
       (type_of% (R.actual_source_equation observation nontrivial half depth)) ∧
