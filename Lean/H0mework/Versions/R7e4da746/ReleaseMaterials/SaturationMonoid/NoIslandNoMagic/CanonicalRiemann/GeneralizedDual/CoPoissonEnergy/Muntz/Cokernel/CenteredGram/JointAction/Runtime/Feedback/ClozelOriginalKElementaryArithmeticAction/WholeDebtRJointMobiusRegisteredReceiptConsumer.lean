       (∀ test : SchwartzMap ℝ ℂ, type_of% (Tate.actual_tate_action c test)) ∧
       (∀ (test : SchwartzMap ℝ ℂ) (supported : ∀ x : ℝ, (1 / 4 : ℝ) < |x| → test x = 0),
         type_of% (Tate.actual_tate_normalization observation nontrivial half test supported))))))))

