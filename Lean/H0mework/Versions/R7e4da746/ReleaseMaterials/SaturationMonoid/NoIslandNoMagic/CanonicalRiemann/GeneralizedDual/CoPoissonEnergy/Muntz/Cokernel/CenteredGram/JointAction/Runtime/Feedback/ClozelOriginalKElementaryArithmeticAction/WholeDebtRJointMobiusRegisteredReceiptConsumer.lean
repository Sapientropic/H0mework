       (type_of% (R.actual_not_physical observation nontrivial half depth)) ∧
       (type_of% (actual_generated_R_source observation nontrivial half depth)) ∧
       (type_of% (actual_forward_foot_required observation nontrivial half depth)) ∧
       (∀ (x : ℝ) (inside : |x| ≤ (4 : ℝ)), type_of% (G.actual_outward_gap c inside)) ∧
       (∀ (x : ℝ) (positive : 0 < x), type_of% (G.actual_forward_outward c positive)) ∧
       (∀ (t : ℝ) (positive : 0 < t) (before : t ≤ (1 / 4 : ℝ)),
