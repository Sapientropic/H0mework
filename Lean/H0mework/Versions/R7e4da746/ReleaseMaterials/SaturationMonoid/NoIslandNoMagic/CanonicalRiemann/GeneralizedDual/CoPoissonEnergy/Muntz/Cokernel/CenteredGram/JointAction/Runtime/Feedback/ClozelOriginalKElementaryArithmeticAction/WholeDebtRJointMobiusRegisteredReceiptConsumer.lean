       (type_of% (R.actual_position_mean observation nontrivial half depth)) ∧
       (type_of% (R.actual_physical_position_update observation nontrivial half depth)) ∧
       (∀ x : ℝ, type_of% (Prefix.actual_complete_prefix observation nontrivial half x)) ∧
