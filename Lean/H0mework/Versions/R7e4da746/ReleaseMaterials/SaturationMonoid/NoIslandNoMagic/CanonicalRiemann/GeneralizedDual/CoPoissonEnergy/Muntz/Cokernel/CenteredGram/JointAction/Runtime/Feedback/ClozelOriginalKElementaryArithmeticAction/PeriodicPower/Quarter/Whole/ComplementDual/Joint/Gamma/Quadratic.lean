private theorem tate_window_is_actual_nu
    (c : BurnolCompletedMellinCoordinate) (zero : riemannZeta c.value = 0) :
    tateWindow c (originalDualLogValue c) = ν (limitingPa c) := by
  have source := actual_tate_window_source c (originalDualLogValue c) (limiting_Gamma_even c zero)
  rw [← sourceVolterraPhysical_annulus c (originalDualLogValue c)] at source
  exact source

private theorem actual_nu_forward
    (c : BurnolCompletedMellinCoordinate) (zero : riemannZeta c.value = 0) :
    Tendsto (fun N : ℕ => AN N (tateWindow c (originalDualLogValue c))) atTop
      (𝓝 (limitingPa c : BurnolL2)) := by
  have reverse := actual_volterra_reverse c (A (originalDualLogValue c))
  have source := (burnolTateReciprocalL2.continuous.tendsto (T (limitingPa c : BurnolL2))).comp reverse
  rw [burnolTateReciprocalL2_involutive] at source
  apply source.congr'
  apply Eventually.of_forall
  intro N
  dsimp only [Function.comp_apply]
  rw [dual_tate, burnolTateReciprocalL2_involutive, tate_window_is_actual_nu c zero]
  rfl

private theorem actual_finite_Gamma_nu_price
    (c : BurnolCompletedMellinCoordinate) (zero : riemannZeta c.value = 0) (N : ℕ) :
    inner ℂ (DN N (actualGammaKernel c)) (tateWindow c (originalDualLogValue c)) =
      inner ℂ (DN N (K c : BurnolL2)) (tateWindowGamma c (originalDualLogValue c)) := by
  have source := actual_original_gamma_kernel_complete_count c N
  have position := counted_kernel_position_source c N
  have frequency := inverse_log_from_complete_source _ _ _ source position
  have logs := actual_tate_window_two_sources c (originalDualLogValue c) (limiting_Gamma_even c zero)
  exact whole_conductor_dual _ _ _ _ _ _ _ _ source
    (actual_tate_window_Gamma c (originalDualLogValue c) (limiting_Gamma_even c zero))
    position frequency logs.1 logs.2

private theorem actual_Gamma_nu_price_limit
    (c : BurnolCompletedMellinCoordinate) (zero : riemannZeta c.value = 0) :
    Tendsto (fun N : ℕ => inner ℂ (DN N (actualGammaKernel c))
      (tateWindow c (originalDualLogValue c))) atTop
      (𝓝 (inner ℂ (originalFirstFieldGamma c) (tateWindow c (originalDualLogValue c)))) := by
  have source := (KCounting.original_tendsto c zero).inner (𝕜 := ℂ)
    (tendsto_const_nhds (x := tateWindowGamma c (originalDualLogValue c)))
  change Tendsto _ atTop (𝓝 (inner ℂ (originalFirstField c zero)
    (tateWindowGamma c (originalDualLogValue c)))) at source
  have logs := actual_tate_window_two_sources c (originalDualLogValue c) (limiting_Gamma_even c zero)
  have complete := whole_conductor_dual _ _ _ _ _ _ _ _
    (actual_original_first_field_complete_Gamma_source c zero)
    (actual_tate_window_Gamma c (originalDualLogValue c) (limiting_Gamma_even c zero))
    (actual_original_first_field_complete_log_sources c zero).1
    (actual_original_first_field_complete_log_sources c zero).2 logs.1 logs.2
  rw [← complete] at source
  apply source.congr'
  exact Eventually.of_forall (fun N => (actual_finite_Gamma_nu_price c zero N).symm)

/-- The same source generates both Gamma legs and the genuine Volterra quadratic price; no Gamma/Tate commutation or Gamma-count strong premise is used. -/
theorem actual_original_Gamma_Pa_quadratic_source
    (c : BurnolCompletedMellinCoordinate) (zero : riemannZeta c.value = 0) :
    inner ℂ (actualGammaKernel c) (limitingPa c : BurnolL2) =
      inner ℂ (A (originalDualLogValue c)) (V c (A (originalDualLogValue c))) := by
  have left := (tendsto_const_nhds (x := actualGammaKernel c)).inner (𝕜 := ℂ)
    (actual_nu_forward c zero)
  have same : Tendsto (fun N : ℕ => inner ℂ (DN N (actualGammaKernel c))
      (tateWindow c (originalDualLogValue c))) atTop
      (𝓝 (inner ℂ (actualGammaKernel c) (limitingPa c : BurnolL2))) := by
    apply left.congr'
    apply Eventually.of_forall
    intro N
    exact (ContinuousLinearMap.adjoint_inner_left (CountingDual.sourceCLM N)
      (tateWindow c (originalDualLogValue c)) (actualGammaKernel c)).symm.trans
        (by rw [← CountingDual.dual_eq_adjoint])
  have price := tendsto_nhds_unique same (actual_Gamma_nu_price_limit c zero)
  change inner ℂ (actualGammaKernel c) (limitingPa c : BurnolL2) =
    inner ℂ (originalFirstFieldGamma c) (T (A (V c (A (originalDualLogValue c))))) at price
  rw [← OriginalRieszFiniteSynthesis.tate_pairing,
    actual_original_counted_first_dual_same_Gamma_occurrence c zero, ← annulus_pair] at price
  exact price

/-- The original full resolvent Gram consumes the new Gamma quadratic source and produces its signed norm reserve. -/
theorem actual_original_Gamma_Pa_source_energy
    (c : BurnolCompletedMellinCoordinate) (zero : riemannZeta c.value = 0) :
    -4 * (inner ℂ (actualGammaKernel c) (limitingPa c : BurnolL2)).re =
      (2*c.value.re-1) * ‖V c (A (originalDualLogValue c))‖^2 := by
  rw [actual_original_Gamma_Pa_quadratic_source c zero]
  exact volterra_energy c _

