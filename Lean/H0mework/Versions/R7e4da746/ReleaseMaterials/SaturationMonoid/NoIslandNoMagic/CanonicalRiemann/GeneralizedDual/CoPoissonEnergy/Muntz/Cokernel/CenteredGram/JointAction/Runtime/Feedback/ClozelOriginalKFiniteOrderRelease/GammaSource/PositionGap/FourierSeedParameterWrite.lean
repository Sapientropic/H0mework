local notation "seed" => (burnolPaCombApproximation 0:BurnolL2)

/-- The actual variable-parameter original first action writes its complete exterior column. -/
theorem original_first_outside (parameter : BurnolCompletedMellinCoordinate) :
    O (R parameter seed) = (-2 * arithmeticMoment parameter.value) • V parameter := by
  have gap : R parameter seed ∈ locallyConstantFace q :=
    WidePositionGap.original_R_preserves_position_radius parameter (by norm_num) _
      (burnolPaCombApproximation 0).property.1.1
  have even : reflectL2 (R parameter seed) = R parameter seed := by
    change reflectL2 (burnolDirectRightResolvent (parameter.value/2) seed) =
      burnolDirectRightResolvent (parameter.value/2) seed
    rw [actual_R_reflect, mem_evenL2ClosedFace_iff.mp (burnolPaCombApproximation 0).property.2]
  let value : PositionField := ⟨R parameter seed, gap, mem_evenL2ClosedFace_iff.mpr even⟩
  have B := actual_original_B_outside parameter ((basis parameter).repr value)
  rw [LinearIsometryEquiv.symm_apply_apply] at B
  have centered : centeredFourier parameter ((basis parameter).repr value) =
      (-2 * arithmeticMoment parameter.value) • centeredLogColumn (barC parameter) 0 := by
    change Z (Rq (F (((basis parameter).repr.symm ((basis parameter).repr value)) : BurnolL2))) = _
    rw [LinearIsometryEquiv.symm_apply_apply]
    change Z (Rq (F (burnolDirectRightResolvent (parameter.value/2) seed))) = _
    simpa only [map_add, map_smul, OriginalRieszSource.Constructor.zeroMean_constant,
      smul_zero, zero_add, centeredLogColumn] using congrArg Z (source_first_quarter parameter)
  rw [centered, map_smul, map_smul] at B
  rw [physicalOutsideColumn_embedding]
  exact B

private def exteriorRead : BurnolQuarterIntervalL2 →L[ℂ] BurnolL2 :=
  outsideEmbedding.comp ((BI).comp Z)

private def exteriorScale (s : ℂ) : ℂ :=
  (s-1) / (2*(q:ℂ)^(1-s))

/-- The variable original exterior column is generated by the already paid quarter unit programme. -/
def exteriorFamily (s : ℂ) : BurnolL2 := exteriorScale s • exteriorRead (unitQuarterFamily s)

theorem exteriorFamily_actual (parameter : BurnolCompletedMellinCoordinate) :
    exteriorFamily parameter.value = V parameter := by
  have unit : unitQuarterFamily parameter.value = finiteLogUnit parameter 1 := by
    have native := (unit_quarter_source parameter 1).trans (quarter_power_logs parameter 1)
    rw [pow_one] at native
    exact native
  have unitWrite : finiteLogUnit parameter 1 =
      (2/(1-parameter.value)) • intervalConstant q -
        quarterScale parameter • dividedLogColumn (barC parameter) 0 := by
    simp [finiteLogUnit, quarterScale]
  have centered : Z (finiteLogUnit parameter 1) =
      (-quarterScale parameter) • centeredLogColumn (barC parameter) 0 := by
    simp only [unitWrite, map_sub, map_smul, OriginalRieszSource.Constructor.zeroMean_constant,
      smul_zero, zero_sub, neg_smul, centeredLogColumn]
  have lifted : exteriorRead (unitQuarterFamily parameter.value) = (-quarterScale parameter) • V parameter := by
    change outsideEmbedding (BI (Z (unitQuarterFamily parameter.value))) = _
    rw [unit, centered, map_smul, map_smul, physicalOutsideColumn_embedding]
    rfl
  have powNonzero : (q:ℂ)^(1-parameter.value) ≠ 0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))
  have scalar : exteriorScale parameter.value * (-quarterScale parameter) = 1 := by
    unfold exteriorScale quarterScale
    field_simp [coordinate_ne_one parameter, powNonzero]
    try ring
  rw [exteriorFamily, lifted, smul_smul, scalar, one_smul]

theorem exteriorFamily_analytic (parameter : BurnolCompletedMellinCoordinate) :
    AnalyticAt ℂ exteriorFamily parameter.value := by
  have base : Differentiable ℂ (fun s : ℂ => (1:ℂ)-s) :=
    (differentiable_const (𝕜 := ℂ) (E := ℂ) (1:ℂ)).sub differentiable_id
  have power : AnalyticAt ℂ (fun s : ℂ => (q:ℂ)^(1-s)) parameter.value :=
    (base.const_cpow (Or.inl (by norm_num : (q:ℂ) ≠ 0))).analyticAt _
  have powNonzero : (q:ℂ)^(1-parameter.value) ≠ 0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))
  have scalar : AnalyticAt ℂ exteriorScale parameter.value :=
    (analyticAt_id.sub analyticAt_const).div (analyticAt_const.mul power)
      (mul_ne_zero (by norm_num) powNonzero)
  exact scalar.smul ((exteriorRead.analyticAt _).comp (unit_quarter_analytic parameter))

