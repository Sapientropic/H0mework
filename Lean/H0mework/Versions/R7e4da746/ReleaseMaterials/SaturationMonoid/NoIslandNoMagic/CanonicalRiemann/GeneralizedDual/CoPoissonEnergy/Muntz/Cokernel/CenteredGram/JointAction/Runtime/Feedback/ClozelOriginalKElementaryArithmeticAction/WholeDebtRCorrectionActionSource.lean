private theorem input_read (c : BurnolCompletedMellinCoordinate) (i : Fin 2) :
    (face i (C c) : ℝ → ℂ)=ᵐ[volume] inputRaw c i := by
  have first : (sourceFirst c : ℝ → ℂ)=ᵐ[volume.restrict (symmetricInterval q)] sourceRaw c 0 :=
    source_correction_read c 0
  have second : (sourceSecond c : ℝ → ℂ)=ᵐ[volume.restrict (symmetricInterval q)] sourceRaw c 1 :=
    source_correction_read c 1
  have bare : (face i (C c) : ℝ → ℂ)=ᵐ[volume] bareInputRaw c i := by
    fin_cases i
    · filter_upwards [Lp.coeFn_add (Eq (sourceFirst c : Hq)) (F (Eq (sourceSecond c : Hq))),
        extension_read _ _ first,burnolRadiusFourierL2_zeroExtension_ae_eq_raw (sourceSecond c : Hq)]
        with x sumRead one two
      change (Eq (sourceFirst c : Hq)+F (Eq (sourceSecond c : Hq)) : BurnolL2) x=_
      rw [sumRead]
      change (Eq (sourceFirst c : Hq)) x+(F (Eq (sourceSecond c : Hq))) x=_
      change (F (Eq (sourceSecond c : Hq))) x=_ at two
      rw [one,two]
      rfl
    · change (F (Eq (sourceFirst c : Hq)+F (Eq (sourceSecond c : Hq))) : ℝ → ℂ)=ᵐ[volume] _
      rw [map_add,fourierL2_fourierL2]
      have secondEven : reflectL2 (Eq (sourceSecond c : Hq))=Eq (sourceSecond c : Hq) := by
        change reflectL2 (burnolRadiusZeroExtension q (sourceSecond c : Hq))=_
        rw [burnolRadiusZeroExtension_reflect]
        exact congrArg Eq (source_correction_even c 1)
      rw [secondEven]
      filter_upwards [Lp.coeFn_add (F (Eq (sourceFirst c : Hq))) (Eq (sourceSecond c : Hq)),
        burnolRadiusFourierL2_zeroExtension_ae_eq_raw (sourceFirst c : Hq),extension_read _ _ second]
        with x sumRead one two
      rw [sumRead]
      change (F (Eq (sourceFirst c : Hq))) x+(Eq (sourceSecond c : Hq)) x=_
      change (F (Eq (sourceFirst c : Hq))) x=_ at one
      rw [one,two]
      rfl
  have even := burnolEvenRaw_ae (face i (C c)) _ bare
  rw [evenPart_of_even _ (input_even c i)] at even
  exact even

private def prefixRaw (c : BurnolCompletedMellinCoordinate) (raw : ℝ → ℂ) (x : ℝ) : ℂ :=
  -2*((|x| : ℝ) : ℂ)^(-c.value)*(∫ s : ℝ in 0..|x|,(s : ℂ)^(c.value-1)*raw s)

private theorem prefix_integrable (c : BurnolCompletedMellinCoordinate) (raw : ℝ → ℂ)
    (native : MemLp raw 2 volume) (stop : ℝ) (large : q≤stop) :
    IntervalIntegrable (fun s : ℝ => (s : ℂ)^(c.value-1)*raw s) volume 0 stop := by
  have weight : MemLp (SingularCounting.powerRaw (barC c)) 2
      (volume.restrict (symmetricInterval q)) :=
    (memLp_congr_ae (SingularCounting.power_coeFn (barC c))).mp (Lp.memLp _)
  have rawQuarter := native.mono_measure (Measure.restrict_le_self : volume.restrict (symmetricInterval q)≤volume)
  have product : MemLp (fun s => SingularCounting.powerRaw (barC c) s*raw s) 1
      (volume.restrict (symmetricInterval q)) := rawQuarter.mul' weight
  have first : IntervalIntegrable (fun s : ℝ => (s : ℂ)^(c.value-1)*raw s) volume 0 q := by
    apply (intervalIntegrable_iff_integrableOn_Ioc_of_le (by norm_num : (0 : ℝ)≤q)).mpr
    have whole : IntegrableOn (fun s => SingularCounting.powerRaw (barC c) s*raw s) (symmetricInterval q) volume :=
      memLp_one_iff_integrable.mp product
    have integrable := whole.mono_set
      (show Ioc 0 q⊆symmetricInterval q from fun _ hx => ⟨by linarith [hx.1],hx.2⟩)
    apply integrable.congr
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with s hs
    simp only [SingularCounting.powerRaw,abs_of_pos hs.1,
      OriginalPrimitiveRankBalance.conjugateCoordinate,star_star]
  let safe : ℝ → ℂ := fun s => ((max q s : ℝ) : ℂ)^(c.value-1)
  have smooth : Continuous safe := by
    have base := Complex.continuous_ofReal.comp (continuous_const.max continuous_id : Continuous (fun s : ℝ => max q s))
    exact continuousOn_univ.mp (base.continuousOn.cpow_const (fun s _ =>
      Complex.ofReal_mem_slitPlane.mpr (lt_of_lt_of_le (by norm_num : (0 : ℝ)<q) (le_max_left q s))))
  have localRaw := native.locallyIntegrable (by norm_num)
  have second : IntervalIntegrable (fun s : ℝ => (s : ℂ)^(c.value-1)*raw s) volume q stop := by
    have rawSegment : IntervalIntegrable raw volume q stop :=
      (localRaw.integrableOn_isCompact isCompact_uIcc).intervalIntegrable
    have bounded := rawSegment.continuousOn_mul smooth.continuousOn
    apply bounded.congr_ae
    filter_upwards [ae_restrict_mem measurableSet_uIoc] with s hs
    have after : q≤s := by rw [uIoc_of_le large] at hs;exact hs.1.le
    simp only [safe,max_eq_right after]
  exact first.trans second

private theorem prefix_continuous (c : BurnolCompletedMellinCoordinate) (raw : ℝ → ℂ)
    (native : MemLp raw 2 volume) {x : ℝ} (nz : x≠0) : ContinuousAt (prefixRaw c raw) x := by
  have positive := abs_pos.mpr nz
  have paid := prefix_integrable c raw native (q+|x|+1) (by linarith)
  have primitive : ContinuousOn (fun y : ℝ => ∫ s : ℝ in 0..y,(s : ℂ)^(c.value-1)*raw s)
      (Icc 0 (q+|x|+1)) := by
    simpa only [uIcc_of_le (by positivity : (0 : ℝ)≤q+|x|+1)] using
      intervalIntegral.continuousOn_primitive_interval' paid left_mem_uIcc
  have atPoint : ContinuousAt (fun y : ℝ => ∫ s : ℝ in 0..y,(s : ℂ)^(c.value-1)*raw s) |x| :=
    primitive.continuousAt (Icc_mem_nhds positive (by linarith))
  have power := (Complex.continuousAt_ofReal_cpow_const |x| (-c.value) (Or.inr positive.ne')).comp continuous_abs.continuousAt
  exact (continuousAt_const.mul power).mul (atPoint.comp continuous_abs.continuousAt)

private def actedRaw (c : BurnolCompletedMellinCoordinate) (i : Fin 2) : ℝ → ℂ :=
  ![prefixRaw c (inputRaw c 0),outwardRaw c (F (C c))] i

private theorem acted_even (c : BurnolCompletedMellinCoordinate) (i : Fin 2) :
    reflectL2 (face i (R c (C c)))=face i (R c (C c)) := by
  have first := inward_even c (C c) (correction_raw_even c)
