  · exact inward_restriction c (C c)
  · have even := input_even c 1
    change reflectL2 (F (C c))=F (C c) at even
    have paid := source_quarter_step (barC c) (F (C c)) even
    rw [source_fourier,bar_twice] at paid
    exact paid

/-- Only input raw, actual quarter means and the generated opposite foot occur in this constructor. -/
def nativeRaw (c : BurnolCompletedMellinCoordinate) (i : Fin 2) (x : ℝ) : ℂ :=
  actedRaw c i x-mu (nativeQuarter c i)-burnolMeanZeroFourierRaw (nativeFoot c (flip i)) x

def nativeEndpoint (c : BurnolCompletedMellinCoordinate) (i : Fin 2) : ℂ :=
  burnolEvenRaw (nativeRaw c i) q

private theorem native_read (c : BurnolCompletedMellinCoordinate) (i : Fin 2) :
    (nativeFoot c i : ℝ → ℂ)=ᵐ[volume.restrict (symmetricInterval q)] nativeRaw c i := by
  have paid := burnolFirstCorrection_ae_raw (face i (R c (C c))) (actedRaw c i) (acted_read c i)
  rw [(actual_face_feet c i).1] at paid
  have rawEven : ∀ x,actedRaw c i (-x)=actedRaw c i x := by
    intro x
    fin_cases i
    · change prefixRaw c (inputRaw c 0) (-x)=prefixRaw c (inputRaw c 0) x
      simp only [prefixRaw,abs_neg]
    · change outwardRaw c (F (C c)) (-x)=outwardRaw c (F (C c)) x
      simp only [outwardRaw,abs_neg]
  have evenRaw : burnolEvenRaw (actedRaw c i)=actedRaw c i := by
    funext x
    unfold burnolEvenRaw
    rw [rawEven]
    ring
  filter_upwards [paid] with x hx
  change (nativeFoot c i : Hq) x=(burnolEvenRaw (actedRaw c i) x-
    mu (Rq (burnolAmbientEvenPart (face i (R c (C c))))))-
      burnolMeanZeroFourierRaw (burnolAmbientMeanZeroSecondCorrection (face i (R c (C c)))) x at hx
  rw [evenPart_of_even _ (acted_even c i),actual_quarters,evenRaw,(actual_face_feet c i).2] at hx
  exact hx

private theorem native_continuous (c : BurnolCompletedMellinCoordinate) (i : Fin 2)
    {x : ℝ} (nz : x≠0) : ContinuousAt (nativeRaw c i) x := by
  have meanFourier : Continuous (burnolMeanZeroFourierRaw (nativeFoot c (flip i))) :=
    (burnolRadiusTruncatedFourierRaw_continuous _).sub continuous_const
  exact ((acted_continuous c i nz).sub continuousAt_const).sub meanFourier.continuousAt

def nativeOutside (c : BurnolCompletedMellinCoordinate) : BurnolL2 :=
