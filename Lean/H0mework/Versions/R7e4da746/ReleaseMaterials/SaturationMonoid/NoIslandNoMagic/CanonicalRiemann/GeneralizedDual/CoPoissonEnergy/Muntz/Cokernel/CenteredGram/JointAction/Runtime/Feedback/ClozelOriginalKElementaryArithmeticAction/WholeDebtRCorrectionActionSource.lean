  · exact first
  · exact (fourierL2_reflectL2_commute (R c (C c))).symm.trans (congrArg F first)

private theorem acted_read (c : BurnolCompletedMellinCoordinate) (i : Fin 2) :
    (face i (R c (C c)) : ℝ → ℂ)=ᵐ[volume] actedRaw c i := by
  fin_cases i
  · apply even_read (R c (C c)) (prefixRaw c (inputRaw c 0)) (acted_even c 0)
      (by intro x;simp only [prefixRaw,abs_neg])
    filter_upwards [actual_direct_R_positive_kernel c (C c) _ (input_read c 0)] with x paid positive
    change burnolDirectRightResolvent (c.value/2) (C c) x=prefixRaw c (inputRaw c 0) x
    simpa only [prefixRaw,abs_of_pos positive] using paid positive
  · apply even_read (F (R c (C c))) (outwardRaw c (F (C c))) (acted_even c 1)
      (by intro x;simp only [outwardRaw,abs_neg])
    have actual := sourceVolterraResolvent_positive_profile c (F (C c))
    have identity : sourceVolterraResolvent c (F (C c))=F (R c (C c)) :=
      OriginalKDirectRCofinalOutsideVolterraSource.source_fourier_input c (C c)
    rw [identity] at actual
    filter_upwards [actual] with x profile positive
    simpa only [outwardRaw,abs_of_pos positive,burnolRadiusMellinTailEvaluator_eq_integral] using profile positive

private theorem acted_continuous (c : BurnolCompletedMellinCoordinate) (i : Fin 2)
    {x : ℝ} (nz : x≠0) : ContinuousAt (actedRaw c i) x := by
  fin_cases i
  · exact prefix_continuous c _ ((memLp_congr_ae (input_read c 0)).mp (Lp.memLp _)) nz
  · exact outward_continuous c (F (C c)) nz

