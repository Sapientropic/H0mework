private def drive (c : BurnolCompletedMellinCoordinate) : M := sourceFirst c+S (sourceSecond c)

/-- The actual input C supplies both means, the full tail, backward drive and all six contacts. -/
def nativeSecond (c : BurnolCompletedMellinCoordinate) : M :=
  centeredQuarterStep (barC c) (sourceSecond c)+
    currentAmplitude (barC c) (F (C c)) • logBFirst (barC c) 0-
    BI (contactAction (barC c) (sourceSecond c : Hq))+
    BI (backwardContact (barC c) (drive c))

def nativeFirst (c : BurnolCompletedMellinCoordinate) : M :=
  centeredInwardStep (barC c) (drive c)-S (nativeSecond c)

def nativeFoot (c : BurnolCompletedMellinCoordinate) (i : Fin 2) : M := ![nativeFirst c,nativeSecond c] i

theorem actual_native_feet (c : BurnolCompletedMellinCoordinate) :
    burnolAmbientMeanZeroFirstCorrection (R c (C c))=nativeFirst c ∧
      burnolAmbientMeanZeroSecondCorrection (R c (C c))=nativeSecond c := by
  have actual := actual_forward_R_B c (C c) (correction_raw_even c)
  have input := correction_B c
  have swap := B_fourier (C c)
  have firstInput : burnolAmbientMeanZeroFirstCorrection (F (C c))=sourceSecond c := swap.1.trans input.2
  have fourierInput : burnolAmbientMeanZeroFourier (F (C c))=drive c := by
    rw [fourier_fourier]
    have block := burnolMeanZeroBlock_first_equation (burnolAmbientMeanZeroBlockRhs (C c))
    change burnolAmbientMeanZeroFirstCorrection (C c)+S (burnolAmbientMeanZeroSecondCorrection (C c))=_ at block
    rw [input.1,input.2] at block
    exact block.symm
  have generated : firstNext (barC c) (F (C c))=nativeSecond c := by
    unfold firstNext nativeSecond
    rw [firstInput,fourierInput]
  rw [generated] at actual
  refine ⟨?_,actual.2⟩
  rw [actual.1,secondNext,fourierInput,generated]
  rfl

private theorem actual_face_feet (c : BurnolCompletedMellinCoordinate) (i : Fin 2) :
    burnolAmbientMeanZeroFirstCorrection (face i (R c (C c)))=nativeFoot c i ∧
      burnolAmbientMeanZeroSecondCorrection (face i (R c (C c)))=nativeFoot c (flip i) := by
  have actual := actual_native_feet c
  fin_cases i
  · exact actual
  · have swap := B_fourier (R c (C c))
    exact ⟨swap.1.trans actual.2,swap.2.trans actual.1⟩

