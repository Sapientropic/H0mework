private def flip (i : Fin 2) : Fin 2 := ![(1 : Fin 2),0] i

private theorem correction_B (c : BurnolCompletedMellinCoordinate) :
    burnolAmbientMeanZeroFirstCorrection (C c)=sourceFirst c ∧
      burnolAmbientMeanZeroSecondCorrection (C c)=sourceSecond c := by
  have physical := physical_fibres (P (sourceAction c))
  have first := congrArg firstMap (BandFullStockEuler.source_action_projection c)
  have second := congrArg secondMap (BandFullStockEuler.source_action_projection c)
  rw [map_sub] at first second
  change firstMap (P (sourceAction c) : BurnolL2)=0 ∧ secondMap (P (sourceAction c) : BurnolL2)=0 at physical
  rw [physical.1] at first
  rw [physical.2] at second
  constructor
  · change 0=sourceFirst c-burnolAmbientMeanZeroFirstCorrection (C c) at first
    exact (sub_eq_zero.mp first.symm).symm
  · change 0=sourceSecond c-burnolAmbientMeanZeroSecondCorrection (C c) at second
    exact (sub_eq_zero.mp second.symm).symm

private theorem correction_outside (c : BurnolCompletedMellinCoordinate) : O (C c)=C c := by
  have same : C c=O (sourceAction c) := by
    rw [OriginalKCombPhysicalAction.physicalRemainder,Submodule.starProjection_orthogonal_val]
    change C c=sourceAction c-(P (sourceAction c) : BurnolL2)
    rw [BandFullStockEuler.source_action_projection]
    module
  rw [same]
  change (evenBurnolClosedFace burnolUnscaledCommonGapRadius).toSubmoduleᗮ.starProjection
    ((evenBurnolClosedFace burnolUnscaledCommonGapRadius).toSubmoduleᗮ.starProjection (sourceAction c))=_
  exact Submodule.starProjection_eq_self_iff.mpr (Submodule.starProjection_apply_mem _ _)

private theorem power_fourier_quarter (c : BurnolCompletedMellinCoordinate) :
    quarterCotest (fourierL2.symm (hPowerPhysicalCorrection c))=0 := by
  have heven : sourceMeanZeroReflection (hPowerBColumn c)=hPowerBColumn c := log_B_even c 0
  have zero := embedding_position (hPowerBColumn c) heven
  have actual : fourierL2.symm (hPowerPhysicalCorrection c)=
      OutsideQuarterAction.outsideEmbedding (hPowerBColumn c) := by
    have paid := OutsideQuarterAction.physicalOutsideColumn_embedding (barC c)
    simpa only [OriginalKCrossParameterRAdjointSource.PhysicalOutsideSource.physicalOutsideColumn,
      bar_twice] using paid
  rw [←actual] at zero
  have even := embedding_even (hPowerBColumn c) heven
  rw [←actual] at even
  rw [position_read _ even] at zero
  exact zero

/-- The complete two-leg correction price consumes the paid power quarter and homogeneous Fourier leg. -/
theorem actual_alpha_source (c : BurnolCompletedMellinCoordinate) :
    alpha c=inner ℂ (SingularCounting.centeredPower c) (sourceFirst c) := by
  unfold OriginalWholeDebtRProjectionSource.powerReturnPrice BandFullStockEuler.correctionRaw
  have moved : inner ℂ (hPowerPhysicalCorrection c) (F (Eq (sourceSecond c : Hq)))=
      inner ℂ (fourierL2.symm (hPowerPhysicalCorrection c)) (Eq (sourceSecond c : Hq)) := by
    simpa only [fourierL2.apply_symm_apply] using
      fourierL2.inner_map_map (fourierL2.symm (hPowerPhysicalCorrection c)) (Eq (sourceSecond c : Hq))
  rw [inner_add_right,moved,quarter_pair,quarter_pair,power_fourier_quarter c,
    inner_zero_left,add_zero,OriginalKCrossParameterRAdjointSource.UnweightedCayleySource.powerCorrection_quarter_source c]

