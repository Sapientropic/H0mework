private theorem actual_outside_source (c : BurnolCompletedMellinCoordinate) :
    O (R c (C c))=nativeOutside c := by
  have projection := burnolEvenOrthogonalProjectionOnto_eq_resolventFormula (R c (C c))
  unfold burnolAmbientExtendedSonineProjectionFormula at projection
  have even := evenPart_of_even (R c (C c)) (acted_even c 0)
  rw [even] at projection
  change (P (R c (C c)) : BurnolL2)=R c (C c)-burnolAmbientEvenMeanZeroCorrection (R c (C c)) at projection
  rw [OriginalKCombPhysicalAction.physicalRemainder,Submodule.starProjection_orthogonal_val]
  change R c (C c)-(P (R c (C c)) : BurnolL2)=nativeOutside c
  rw [projection]
  have actual := actual_native_feet c
  unfold burnolAmbientEvenMeanZeroCorrection burnolAmbientRawMeanZeroCorrection
  rw [actual.1,actual.2]
  change R c (C c)-(R c (C c)-nativeOutside c)=nativeOutside c
  module

/-- This is the complete source action, including the two functions consumed below at their native endpoints. -/
theorem actual_correction_action (c : BurnolCompletedMellinCoordinate) :
    R c (C c)=(-2*nativeAlpha c) • (K (barC c) : BurnolL2)+nativeOutside c := by
  have returned := original_R_outside_physical_generatedK c (C c)
  rw [correction_outside] at returned
  change (P (R c (C c)) : BurnolL2)=(-2*alpha c) • OriginalKSourceResolventReconstruction.generatedK (barC c) at returned
  rw [actual_alpha_source,OriginalKSourceResolventReconstruction.generatedK_eq_original] at returned
  have split := (evenBurnolClosedFace q).toSubmodule.starProjection_add_starProjection_orthogonal (R c (C c))
  change (P (R c (C c)) : BurnolL2)+O (R c (C c))=R c (C c) at split
  rw [returned,actual_outside_source] at split
  exact split.symm

private def outsideRaw (c : BurnolCompletedMellinCoordinate) (i : Fin 2) : ℝ → ℂ :=
  burnolEvenRaw (fun x => (symmetricInterval q).indicator (nativeRaw c i) x+
    burnolRadiusTruncatedFourierRaw q (nativeFoot c (flip i) : Hq) x)

private theorem outside_faces (c : BurnolCompletedMellinCoordinate) (i : Fin 2) :
    face i (nativeOutside c)=burnolAmbientEvenPart
      (Eq (nativeFoot c i : Hq)+F (Eq (nativeFoot c (flip i) : Hq))) := by
  fin_cases i
  · rfl
  · change F (nativeOutside c)=burnolAmbientEvenPart (Eq (nativeSecond c : Hq)+F (Eq (nativeFirst c : Hq)))
    unfold nativeOutside
    rw [fourierL2_burnolAmbientEvenPart,map_add,fourierL2_fourierL2]
    unfold burnolAmbientEvenPart
    simp only [map_add,reflectL2_reflectL2]
    module

private theorem outside_read (c : BurnolCompletedMellinCoordinate) (i : Fin 2) :
    (face i (nativeOutside c) : ℝ → ℂ)=ᵐ[volume] outsideRaw c i := by
  rw [outside_faces]
  apply burnolEvenRaw_ae
  filter_upwards [Lp.coeFn_add (Eq (nativeFoot c i : Hq)) (F (Eq (nativeFoot c (flip i) : Hq))),
    extension_read _ _ (native_read c i),
    burnolRadiusFourierL2_zeroExtension_ae_eq_raw (nativeFoot c (flip i) : Hq)] with x sumRead one two
  rw [sumRead]
  change (Eq (nativeFoot c i : Hq)) x+(F (Eq (nativeFoot c (flip i) : Hq))) x=_
  change (F (Eq (nativeFoot c (flip i) : Hq))) x=_ at two
  rw [one,two]

private def regularRaw (c : BurnolCompletedMellinCoordinate) (i : Fin 2) : ℝ → ℂ :=
  burnolEvenRaw (burnolRadiusTruncatedFourierRaw q (nativeFoot c (flip i) : Hq))
private def fullRaw (c : BurnolCompletedMellinCoordinate) (i : Fin 2) (x : ℝ) : ℂ :=
  (-2*nativeAlpha c)*kernelRaw (barC c) i x+outsideRaw c i x
private def innerRaw (c : BurnolCompletedMellinCoordinate) (i : Fin 2) (x : ℝ) : ℂ :=
  (-2*nativeAlpha c)*kernelInner (barC c) i+burnolEvenRaw (nativeRaw c i) x+regularRaw c i x
private def outerRaw (c : BurnolCompletedMellinCoordinate) (i : Fin 2) (x : ℝ) : ℂ :=
  (-2*nativeAlpha c)*kernelOuter (barC c) i x+regularRaw c i x

private theorem full_read (c : BurnolCompletedMellinCoordinate) (i : Fin 2) :
    actedRaw c i=ᵐ[volume] fullRaw c i := by
  have action : face i (R c (C c))=(-2*nativeAlpha c) • face i (K (barC c) : BurnolL2)+face i (nativeOutside c) := by
    fin_cases i
    · exact actual_correction_action c
    · change F (R c (C c))=(-2*nativeAlpha c) • F (K (barC c) : BurnolL2)+F (nativeOutside c)
      simpa only [map_add,map_smul] using congrArg F (actual_correction_action c)
  have combined : (((-2*nativeAlpha c) • face i (K (barC c) : BurnolL2)+face i (nativeOutside c) : BurnolL2) : ℝ → ℂ)
      =ᵐ[volume] fullRaw c i := by
    filter_upwards [Lp.coeFn_add ((-2*nativeAlpha c) • face i (K (barC c) : BurnolL2)) (face i (nativeOutside c)),
      Lp.coeFn_smul (-2*nativeAlpha c) (face i (K (barC c) : BurnolL2)),
      kernel_read (barC c) i,outside_read c i] with x sumRead scale native outside
    simp only [sumRead,Pi.add_apply,scale,Pi.smul_apply,smul_eq_mul,native,outside,fullRaw]
  exact (acted_read c i).symm.trans (by rw [action];exact combined)

/-- The actual input-C programme, not a supplied endpoint, generates both canonical q values. -/
theorem actual_native_endpoints (c : BurnolCompletedMellinCoordinate) (i : Fin 2) :
    nativeEndpoint c i=![2*nativeAlpha c*Kernel.A (barC c),-2*nativeAlpha c*Kernel.beta (barC c)] i := by
  have regular : Continuous (regularRaw c i) := by
    have paid := burnolRadiusTruncatedFourierRaw_continuous (nativeFoot c (flip i) : Hq)
    exact continuous_const.mul (paid.add (paid.comp continuous_neg))
  have evenNative {x : ℝ} (nz : x≠0) : ContinuousAt (burnolEvenRaw (nativeRaw c i)) x :=
    continuousAt_const.mul ((native_continuous c i nz).add
      ((native_continuous c i (neg_ne_zero.mpr nz)).comp continuousAt_neg))
  have limits := continuous_junction (inside := innerRaw c i) (outside := outerRaw c i) (full_read c i)
    (fun x positive small => by
      dsimp only [fullRaw,innerRaw,outsideRaw,regularRaw,burnolEvenRaw]
      have inside : x∈symmetricInterval q := ⟨by linarith,small.le⟩
      have reverse : -x∈symmetricInterval q := ⟨by linarith,by linarith⟩
      rw [kernel_inner (barC c) i positive small.le,indicator_of_mem inside,indicator_of_mem reverse]
      ring)
    (fun x large => by
      dsimp only [fullRaw,outerRaw,outsideRaw,regularRaw,burnolEvenRaw]
      have after : x∉symmetricInterval q := by intro hx;exact (not_le_of_gt large) hx.2
      have reverse : -x∉symmetricInterval q := by intro hx;linarith [hx.1]
      rw [kernel_outer (barC c) i large,indicator_of_notMem after,indicator_of_notMem reverse]
      ring)
    (fun x positive => (acted_continuous c i positive.ne').continuousWithinAt)
    (fun x positive => ((continuousAt_const.add (evenNative positive.ne')).add regular.continuousAt).continuousWithinAt)
    (fun x positive => ((continuousAt_const.mul (kernel_outer_continuous (barC c) i positive)).add regular.continuousAt).continuousWithinAt)
  unfold outerRaw innerRaw at limits
  have jump := kernel_jump (barC c) i
  fin_cases i
  · simp only [Fin.mk_zero] at limits jump
    change kernelOuter (barC c) 0 q-kernelInner (barC c) 0= -Kernel.A (barC c) at jump
    change nativeEndpoint c 0=2*nativeAlpha c*Kernel.A (barC c)
    unfold nativeEndpoint
    linear_combination -limits-(2*nativeAlpha c)*jump
  · simp only [Fin.mk_one] at limits jump
    change kernelOuter (barC c) 1 q-kernelInner (barC c) 1=Kernel.beta (barC c) at jump
    change nativeEndpoint c 1= -2*nativeAlpha c*Kernel.beta (barC c)
    unfold nativeEndpoint
    linear_combination -limits-(2*nativeAlpha c)*jump

