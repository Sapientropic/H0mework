local notation "F" => fourierL2
local notation "barC" => OriginalPrimitiveRankBalance.conjugateCoordinate
local notation "T" => OriginalWholeDebtRAdjointContactSource.T
local notation "K" => OriginalKSourceResolventReconstruction.generatedK
local notation "chi" => OriginalWholeDebtRJointMobiusSource.character
local notation "J" => OriginalWholeDebtRJointMobiusSource.jointValue
local notation "C" => correctionRaw
local notation "u" => OriginalWholeDebtRJointMobiusUnitSource.response

/-- Both corrections are the actual original Pa source and the source-priced true whole unit. -/
def correctionInput (c : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  OriginalWholeDebtRJointMobiusSource.paWave c+
    OriginalWholeDebtRJointMobiusUnitSource.unitCoefficient c • burnolUnitTailResponse c 4

def coupling (c : BurnolCompletedMellinCoordinate) : ℂ := (damping c : ℂ)*returnRatio c

/-- The original C field cancels only after the complete regular/contact source action is executed. -/
def contactForcing (c : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  coupling c • dualKernelBoundary c+(damping c : ℂ) • pairedSource c junctionShift+
    (1/2 : ℂ) • (T (barC c) (regularSource c)+OriginalWholeDebtRAdjointContactSource.contactLift c (barC c))

/-- These are complete same-source forcing fields; no forcing value is assumed to vanish. -/
def coupledForcing (c : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  (coupling c*(chi c-chi (barC c))) • F (K (barC c))-
    coupling c • F (C (barC c))+(damping c : ℂ) • pairedSource c junctionShift+
    (1/2 : ℂ) • (T (barC c) (regularSource c)+OriginalWholeDebtRAdjointContactSource.contactLift c (barC c))+
    coupling c • F (correctionInput (barC c))-sourceAdjointCayley (barC c) (correctionInput c)

/-- The next source input is the actual conjugate source response and the complete forcing. -/
def coupledInput (c : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  coupling c • F (u (barC c))+coupledForcing c

private theorem actual_joint_complete (c : BurnolCompletedMellinCoordinate) :
    (J c : BurnolL2)=kernelBoundary c+C c := by
  have joint:=congrArg (fun v : BurnolPaAmbientCarrier => (v : BurnolL2))
    (OriginalWholeDebtRJointMobiusSource.actual_joint_carrier c)
  change (J c : BurnolL2)=chi c • (burnolCompletedMellinRieszVector c : BurnolL2)-
    (burnolEvenAmbientProjection (sourceAction c) : BurnolL2) at joint
  rw [source_action_projection] at joint
  unfold kernelBoundary
  rw [←action_source,OriginalKSourceResolventReconstruction.generatedK_eq_original]
  linear_combination (norm:=module) joint

private theorem actual_correction_balance (c : BurnolCompletedMellinCoordinate) :
    (J c : BurnolL2)=correctionInput c+u c := by
  rw [OriginalWholeDebtRJointMobiusProgramme.actual_joint_wave_response,
    OriginalWholeDebtRJointMobiusUnitSource.actual_source_update]
  unfold correctionInput
  module

private theorem sigma_damping (c : BurnolCompletedMellinCoordinate) :
    OriginalWholeDebtRAdjointContactSource.sigma c (barC c)=2*(damping c : ℂ) := by
  simpa only [OriginalWholeDebtRAdjointContactSource.sigma,OriginalPrimitiveRankBalance.conjugateCoordinate,
    star_star,add_comm] using damping_twice c

private theorem adjoint_cayley_read (c : BurnolCompletedMellinCoordinate) (value : BurnolL2) :
    sourceAdjointCayley (barC c) value=value+(damping c : ℂ) • T (barC c) value := by
  rw [sourceAdjointCayley,←actualAdjoint_read]
  rfl

/-- The source-generated sigma=2delta law removes the C child from this actual whole update. -/
theorem actual_contact_update (c : BurnolCompletedMellinCoordinate) :
    sourceAdjointCayley (barC c) (J c : BurnolL2)=contactForcing c := by
  have nonzero : (damping c : ℂ)≠0 := Complex.ofReal_ne_zero.mpr (sub_pos.mpr c.rightHalf).ne'
  have cancel : (damping c : ℂ)*(2*(damping c : ℂ))⁻¹=(1/2 : ℂ) := by
    field_simp
  rw [adjoint_cayley_read,actual_finite_forcing,finiteForcing,regularContact,sigma_damping]
  rw [actual_joint_complete]
  unfold contactForcing coupling
  simp only [smul_add,smul_sub,smul_smul,mul_inv_cancel₀ nonzero,cancel,one_smul]
  match_scalars <;> field_simp [nonzero] <;> ring

/-- The complete original response is written by the real finite regular/contact source. -/
theorem actual_response_update (c : BurnolCompletedMellinCoordinate) :
    sourceAdjointCayley (barC c) (u c)=
      contactForcing c-sourceAdjointCayley (barC c) (correctionInput c) := by
  have source:=congrArg ((sourceCayley (barC c)).adjoint) (actual_correction_balance c)
  rw [sourceCayley_actual_adjoint,actual_contact_update,map_add,
    sourceCayley_actual_adjoint,sourceCayley_actual_adjoint] at source
  linear_combination (norm:=module) -source

private theorem actual_dual_boundary (c : BurnolCompletedMellinCoordinate) :
    dualKernelBoundary c=F (J (barC c) : BurnolL2)+
      (chi c-chi (barC c)) • F (K (barC c))-F (C (barC c)) := by
  rw [actual_joint_complete,map_add,kernelBoundary,map_sub,map_smul,
    ←pairedBurnolMultiplicativeDilation_fourier]
  unfold dualKernelBoundary
  module

/-- The actual Cayley step now consumes the same source's conjugate response with every forcing leg retained. -/
theorem actual_coupled_update (c : BurnolCompletedMellinCoordinate) :
    sourceAdjointCayley (barC c) (u c)=coupledInput c := by
  rw [actual_response_update,contactForcing,actual_dual_boundary,actual_correction_balance,
    map_add]
  unfold coupledInput coupledForcing
  module

/-- The displayed source coupling is calculated from the original B-power action. -/
theorem actual_coupling (c : BurnolCompletedMellinCoordinate) :
    coupling c=OriginalKCrossParameterRAdjointSource.UnweightedCayleySource.sourceAdjointRatio (barC c) := by
  unfold coupling returnRatio
  exact mul_div_cancel₀ _ (Complex.ofReal_ne_zero.mpr (sub_pos.mpr c.rightHalf).ne')

/-- The existing independent whole-Cayley consumer reads this new actual input directly. -/
theorem actual_inverse_update (c : BurnolCompletedMellinCoordinate) :
    sourceCayley (barC c) (coupledInput c)=u c := by
  rw [←actual_coupled_update,←sourceCayley_actual_adjoint]
  exact source_right_inverse (barC c) (u c)

def projectedReturn (c : BurnolCompletedMellinCoordinate) : BurnolPaAmbientCarrier :=
  burnolEvenAmbientProjection (sourceCayley (barC c) (burnolEvenAmbientProjection (coupledInput c)))

variable (observation : GeneratedRiemannZeroObservation)
variable (nontrivial : ¬∃ n : Nat,observation.coordinate=-2*(n+1))
variable (half : OriginalKCombCalculation.Half observation)
local notation "c" => OriginalKCombCofinalTwoDirection.coordinate observation nontrivial half

private theorem actual_physical_input :
    (burnolEvenAmbientProjection (coupledInput c) : BurnolL2)=
      OriginalWholeDebtRJointMobiusReturnAction.returnInput observation nontrivial half := by
  rw [←actual_coupled_update]
  exact actual_inside_adjoint observation nontrivial half

/-- The same complete input retains the original B foot before physical restriction. -/
theorem actual_complete_B : OriginalKCombPhysicalAction.physicalRemainder (coupledInput c)=
    ((sourceDamping (barC c) : ℂ)*OriginalWholeDebtRJointMobiusTateRSource.homogeneousCoefficient c) •
      OriginalKDirectRCofinalOutsideVolterraSource.hPowerPhysicalCorrection (barC c) := by
  rw [←actual_coupled_update]
  exact actual_outside_adjoint observation nontrivial half

/-- The physical consumer keeps the source-born rank-one K defect from this same coupled input. -/
theorem actual_projected_return : (projectedReturn c : BurnolL2)=u c+
    OriginalWholeDebtRJointMobiusReturnAction.returnAmplitude observation nontrivial half •
      (burnolCompletedMellinRieszVector c : BurnolL2) := by
  unfold projectedReturn
  rw [actual_physical_input]
  exact OriginalWholeDebtRJointMobiusReturnAction.actual_complete_return observation nontrivial half

end OriginalWholeDebtRJointMobiusCoupledCayleySource
