local notation "q" => (1/4 : ℝ)
local notation "F" => fourierL2
local notation "P" => burnolEvenAmbientProjection
local notation "barC" => OriginalPrimitiveRankBalance.conjugateCoordinate
local notation "A" => pairedBurnolMultiplicativeDilation junctionShift
local notation "C" => BandFullStockEuler.correctionRaw
local notation "T" => OriginalWholeDebtRAdjointContactSource.T
local notation "K" => OriginalKSourceResolventReconstruction.generatedK
local notation "chi" => OriginalWholeDebtRJointMobiusSource.character
local instance : CompleteSpace BurnolPaAmbientCarrier :=
  IsComplete.completeSpace_coe (evenBurnolClosedFace q).isClosed.isComplete

/-- These are the literal original finite boundary actions, at the original source character. -/
def kernelBoundary (c : BurnolCompletedMellinCoordinate) : BurnolL2 := chi c • K c-A (K c)
def dualKernelBoundary (c : BurnolCompletedMellinCoordinate) : BurnolL2 := chi c • F (K (barC c))-A (F (K (barC c)))

/-- Both regular and contact sources enter before the actual resolvent action. -/
def regularContact (c : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  (OriginalWholeDebtRAdjointContactSource.sigma c (barC c))⁻¹ •
    (T (barC c) (BandFullStockEuler.regularSource c)+
      OriginalWholeDebtRAdjointContactSource.contactLift c (barC c)-(2 : ℂ) • C c)

/-- No response, terminal price, or next vector is supplied to this finite source constructor. -/
def finiteForcing (c : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  returnRatio c • dualKernelBoundary c-
    (damping c : ℂ)⁻¹ • kernelBoundary c+
    pairedSource c junctionShift+regularContact c

private theorem regularContact_actual (c : BurnolCompletedMellinCoordinate) : regularContact c=T (barC c) (C c) :=
  (OriginalWholeDebtRAdjointContactSource.actual_source_action c (barC c)).symm

/-- The full power-wave forcing is generated by both signed source actions, not dropped into a scalar price. -/
theorem actual_finite_forcing (c : BurnolCompletedMellinCoordinate) :
    T (barC c) ((OriginalWholeDebtRJointMobiusSource.jointValue c : BurnolL2))=finiteForcing c := by
  have input : (OriginalWholeDebtRJointMobiusSource.jointValue c : BurnolL2)=kernelBoundary c+C c := by
    have joint:=congrArg (fun v : BurnolPaAmbientCarrier => (v : BurnolL2))
      (OriginalWholeDebtRJointMobiusSource.actual_joint_carrier c)
    change (OriginalWholeDebtRJointMobiusSource.jointValue c : BurnolL2)=
      chi c • (burnolCompletedMellinRieszVector c : BurnolL2)-(P (sourceAction c) : BurnolL2) at joint
    rw [source_action_projection] at joint
    change _=chi c • (burnolCompletedMellinRieszVector c : BurnolL2)-
      (sourceAction c-C c) at joint
    unfold kernelBoundary
    rw [←action_source,OriginalKSourceResolventReconstruction.generatedK_eq_original]
    linear_combination (norm:=module) joint
  have native:=native_adjoint c
  have boundary : T (barC c) (kernelBoundary c)=
      returnRatio c • dualKernelBoundary c-
        (damping c : ℂ)⁻¹ • kernelBoundary c+
        pairedSource c junctionShift := by
    unfold kernelBoundary dualKernelBoundary
    rw [map_sub,map_smul,adjoint_paired,native]
    simp only [map_sub,map_smul]
    have source:=actual_pair_action c junctionShift
    dsimp only [OriginalWholeDebtRJointMobiusSource.character] at *
    linear_combination (norm:=module) source
  rw [input,map_add,boundary]
  exact congrArg (fun v : BurnolL2 => _+v) (regularContact_actual c).symm

/-- The original actual Pa and true-unit inputs are retained as whole L² actions. -/
def sourceUpdate (c : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  finiteForcing c-T (barC c) (OriginalWholeDebtRJointMobiusSource.paWave c)-
    OriginalWholeDebtRJointMobiusUnitSource.unitCoefficient c • T (barC c) (burnolUnitTailResponse c 4)

theorem actual_response_action (c : BurnolCompletedMellinCoordinate) :
    T (barC c) (OriginalWholeDebtRJointMobiusUnitSource.response c)=sourceUpdate c := by
  have input:=OriginalWholeDebtRJointMobiusProgramme.actual_joint_wave_response c
  rw [OriginalWholeDebtRJointMobiusUnitSource.actual_source_update] at input
  have source:=congrArg (T (barC c)) input
  rw [actual_finite_forcing,map_add,map_add,map_smul] at source
  unfold sourceUpdate
  linear_combination (norm:=module) -source

variable (observation : GeneratedRiemannZeroObservation)
variable (nontrivial : ¬∃ n : Nat,observation.coordinate=-2*(n+1))
variable (half : OriginalKCombCalculation.Half observation)
local notation "c" => OriginalKCombCofinalTwoDirection.coordinate observation nontrivial half

/-- This finite regular/contact source generates the same literal original next, with no new occurrence admission. -/
theorem actual_original_next :
    fourierL2 (OriginalWholeDebtRJointMobiusRActionSource.sourceNext observation nontrivial half)=sourceUpdate c := by
  rw [←OriginalWholeDebtRJointMobiusTateRSource.actual_updated_wave,actual_adjoint]
  rw [←actualAdjoint_read]
  exact actual_response_action c

end OriginalWholeDebtRJointMobiusCoupledCayleySource
