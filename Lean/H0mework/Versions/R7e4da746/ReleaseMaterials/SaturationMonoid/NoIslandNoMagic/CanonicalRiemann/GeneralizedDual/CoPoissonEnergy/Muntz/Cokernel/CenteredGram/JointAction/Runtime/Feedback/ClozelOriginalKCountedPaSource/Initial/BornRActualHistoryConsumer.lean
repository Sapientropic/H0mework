theorem first_consumes_registered : firstRetainedValue observation nontrivial half depth ordinal=
 G.registeredValue observation nontrivial half depth ordinal := by
 let material:=previousMaterial observation nontrivial half depth ordinal
 let newEnvironment:=(firstFrame observation nontrivial half depth ordinal).registered.input.environment
 have source:=congrArg (fun expr:Expr (PairValue A.W) A.X slot=>expr.eval newEnvironment)
  (first_retained_code observation nontrivial half depth ordinal)
 have normal:=Generic.paid_expression initial pR
 have newRead:=congrArg (fun expr:Expr (PairValue A.W) A.X slot=>expr.eval newEnvironment) normal
 have oldRead:=congrArg (fun expr:Expr (PairValue A.W) A.X slot=>expr.eval material.environment) normal
 exact source.trans <|
  (BornRSourceMethodConsumer.Generic.negate_paid material.state.1 newEnvironment).trans <|
   newRead.trans oldRead.symm

