private structure PriceRowReceipt {NW:WorldRelationNetwork} {Vocab:Vocabulary}
 (old:RootInquiryStateAt NW Vocab) (oldQuery:old.Query) (Payload:Type) (value:Payload) where
 state:RootInquiryStateAt NW Vocab
 input:SourceNativeRootInquiryInputAt state.root state.visit state.Query
 face:SourceNativeRootSemanticFaceAt state.root state.visit
 consumer:SourceNativeInquiryAnswerConsumerAt (root:=state.root) (visit:=state.visit)
  input.query (ULift.up.{1,0} (state.root.emitted state.visit.current)) (state.entryAt input.query) face
 compiled:state.compileInquiry input.query=.answered face consumer
 readback:HEq face.rootRead (PProd.mk old.visit.current value)
 sameLedger:state.root.toAuthoritativeRoot.toLedgerRoot=old.root.toAuthoritativeRoot.toLedgerRoot
 sameVisit:HEq state.visit old.visit
 sameEntry:HEq (state.entryAt input.query) (old.entryAt oldQuery)
 canonicalWhole:SourceNativeLedgerEvolutionAt old.root.toAuthoritativeRoot.toLedgerRoot.source.source
  (old.root.emitted old.visit.current)
 canonicalWhole_read:canonicalWhole=old.root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt old.visit.current
 sameWhole:HEq (state.root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt state.visit.current) canonicalWhole
 successor:SourceNativeLedgerGeneratedSuccessorAt (state.root.emitted state.visit.current)
  (state.root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt state.visit.current)
 generatedNext:state.root.generatedNextCurrentAt state.visit=
  ⟨Vocab,state.root.toAuthoritativeRoot,state.visit.next successor.next_eq⟩
 originalSuccessor:SourceNativeLedgerGeneratedSuccessorAt (old.root.emitted old.visit.current)
  (old.root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt old.visit.current)
 originalNext:old.root.generatedNextCurrentAt old.visit=
  ⟨Vocab,old.root.toAuthoritativeRoot,old.visit.next originalSuccessor.next_eq⟩
 node:RootInquiryProcessNode
 node_source:node=.answered ⟨NW,Vocab,.create state⟩ input.query
 actualNext:node.erase=(⟨NW,state.root.generatedNextCurrentAt state.visit⟩:AnyAuthoritativeRootCurrent)

