-- A subordinate assembler receives only the source-generated answer below. Authority remains the same exact R row.
private def install_price_at_inquiry {NW:WorldRelationNetwork} {Vocab:Vocabulary}
 (sourceRoot:SourceNativeLivingRootClosure NW Vocab)
 (sourceVisit:SourceNativeTemporalVisitAt sourceRoot.toAuthoritativeRoot.toLedgerRoot)
 (sourceU7:U7ProducerCalculus NW) (sourceCalculus:U7ObstructionEvolutionCalculus NW sourceU7)
 {Sorts:Type} {Value Var:Sorts→Type} [∀t,AddCommGroup (Value t)] {sort:Sorts}
 (reader:sourceRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.actual.OccurrenceAt sourceVisit.current→
  OF.Raw (Value:=Value) (Var:=Var) (sort:=sort)) (count:Nat) {Payload:Type} (answer:Payload) :
 PriceRowReceipt (OwnInquiry.state sourceRoot sourceVisit sourceU7 sourceCalculus reader count)
  PUnit.unit Payload answer :=
 let oldRoot:=OwnInquiry.root sourceRoot sourceVisit sourceU7 sourceCalculus reader count
 let currentVisit:=OwnInquiry.visit sourceRoot sourceVisit reader count
 let currentEntry:=OwnInquiry.entry sourceRoot sourceVisit reader count
 let Answer:=PProd (OwnInquiry.Readout sourceRoot sourceVisit reader) Payload
 let readPrice:=fun {current} (occurrence:RootGeneratedDebtActivationJointSource.OwnerFree.Installation.Math.Inquiry.Source.Occurrence
  sourceRoot sourceVisit reader current)=>PProd.mk (OwnInquiry.readout sourceRoot sourceVisit reader occurrence) answer
 let priceLaw:SourceNativeProjectionLaw (OwnInquiry.Ledger sourceRoot sourceVisit reader):={
  Projection:=PUnit.{1}
  ActiveAt:=OwnInquiry.ActiveAt sourceRoot sourceVisit reader count
  InactiveAt:=OwnInquiry.InactiveAt sourceRoot sourceVisit reader count
  classify:=OwnInquiry.classify sourceRoot sourceVisit reader count
  PayloadAt:=fun _ {_current} _ _=>Answer
  project:=fun _ {_current} occurrence _=>readPrice occurrence }
 let pricedRoot:=oldRoot.withProjectionCoface priceLaw
 let consumerLaw:SourceNativeProjectionLaw (OwnInquiry.Ledger sourceRoot sourceVisit reader):={
  Projection:=PUnit.{1}
  ActiveAt:=OwnInquiry.ActiveAt sourceRoot sourceVisit reader count
  InactiveAt:=OwnInquiry.InactiveAt sourceRoot sourceVisit reader count
  classify:=OwnInquiry.classify sourceRoot sourceVisit reader count
  PayloadAt:=fun _ {_current} occurrence active=>SourceNativeInquiryAnswerConsumerTokenAt
   PUnit.unit (ULift.up.{1,0} occurrence) (OwnInquiry.entryAt sourceRoot sourceVisit reader count occurrence active)
   (readPrice occurrence)
  project:=fun _ {_current} _ _=>.canonical }
 let consumerRoot:=pricedRoot.withProjectionCoface consumerLaw
 let compilationLaw:SourceNativeProjectionLaw (OwnInquiry.Ledger sourceRoot sourceVisit reader):={
  Projection:=PUnit.{1}
  ActiveAt:=OwnInquiry.ActiveAt sourceRoot sourceVisit reader count
  InactiveAt:=OwnInquiry.InactiveAt sourceRoot sourceVisit reader count
  classify:=OwnInquiry.classify sourceRoot sourceVisit reader count
  PayloadAt:=fun _ {_current} occurrence active=>SourceNativeInquiryCompilationTokenAt
   (U7:=OwnInquiry.U7 sourceRoot sourceVisit sourceU7 reader)
   (calculus:=OwnInquiry.calculus sourceRoot sourceVisit sourceU7 sourceCalculus reader)
   (oldTheory:=oldRoot.source.base.lawSurface)
   (OwnInquiry.entryAt sourceRoot sourceVisit reader count occurrence active)
   PUnit.unit (ULift.up.{1,0} occurrence) .answered Answer
  project:=fun _ {_current} occurrence _=>.canonical (readPrice occurrence) }
 let root:=consumerRoot.withProjectionCoface compilationLaw
 let face:SourceNativeRootSemanticFaceAt root currentVisit:={
  projection:=.inherited (.inherited (.component PUnit.unit))
  active:=⟨⟨rfl⟩⟩
  classifier_eq:=classify_actual sourceRoot sourceVisit reader count }
 let event:=ULift.up.{1,0} (root.emitted currentVisit.current)
 let consumed:SourceNativeInquiryAnswerConsumerAt (root:=root) (visit:=currentVisit)
  PUnit.unit event currentEntry face:={
  projection:=.inherited (.component PUnit.unit)
  active:=⟨⟨rfl⟩⟩
  classifier_eq:=classify_actual sourceRoot sourceVisit reader count
  project_heq:=HEq.rfl }
 let authority:=(((OwnInquiry.entryAuthority sourceRoot sourceVisit sourceU7 sourceCalculus reader count).withProjectionCoface
  priceLaw).withProjectionCoface consumerLaw).withProjectionCoface compilationLaw
 let program:SourceNativeInquiryCompilationProgramAt root currentVisit
  (OwnInquiry.U7 sourceRoot sourceVisit sourceU7 reader)
  (OwnInquiry.calculus sourceRoot sourceVisit sourceU7 sourceCalculus reader)
  oldRoot.source.base.lawSurface PUnit.unit event currentEntry authority:={
  compile:=fun _=>.answered face consumed }
 let state:RootInquiryStateAt (OwnInquiry.World sourceRoot sourceVisit reader)
  (RootGeneratedDebtActivationJointSource.OwnerFree.vocabulary sourceRoot.toAuthoritativeRoot sourceVisit.current reader):={
  root:=root
  visit:=currentVisit
  U7:=OwnInquiry.U7 sourceRoot sourceVisit sourceU7 reader
  calculus:=OwnInquiry.calculus sourceRoot sourceVisit sourceU7 sourceCalculus reader
  Query:=PUnit.{1}
  entryAt:=fun _=>currentEntry
  authorityAt:=fun _=>authority
  compilationProgramAt:=fun question=>by cases question;exact program
  compilationFaceAt:=fun question=>by
   cases question
   exact {
    projection:=.component PUnit.unit
    active:=⟨⟨rfl⟩⟩
    classifier_eq:=classify_actual sourceRoot sourceVisit reader count
    project_heq:=HEq.rfl }
  u7RootDisposition_commutes:=by intro _ _ _ impossible;exact nomatch impossible }
 let priorInput:=OwnInquiry.input sourceRoot sourceVisit sourceU7 sourceCalculus reader count
 let input:SourceNativeRootInquiryInputAt state.root state.visit state.Query:={
  projection:=.inherited (.inherited (.inherited priorInput.projection))
  active:=priorInput.active
  classifier_eq:=priorInput.classifier_eq
  queryType_eq:=priorInput.queryType_eq }
 let compiled:state.compileInquiry input.query=.answered face consumed:=rfl
 let readback:HEq face.rootRead (PProd.mk (OwnInquiry.readout sourceRoot sourceVisit reader
  (oldRoot.emitted currentVisit.current)) answer):=HEq.rfl
 let sameLedger:root.toAuthoritativeRoot.toLedgerRoot=oldRoot.toAuthoritativeRoot.toLedgerRoot:=rfl
 let successor:=RootGeneratedDebtActivationJointSource.OwnerFree.sourceSuccessor
  sourceRoot.toAuthoritativeRoot sourceVisit.current reader currentVisit.current
 let generatedNext:=generated_next root currentVisit successor
 let originalNext:=generated_next oldRoot currentVisit successor
 let sameWhole:HEq (root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt currentVisit.current)
  (oldRoot.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt currentVisit.current):=HEq.rfl
 let node:=RootInquiryProcessNode.answered
  ⟨OwnInquiry.World sourceRoot sourceVisit reader,
   RootGeneratedDebtActivationJointSource.OwnerFree.vocabulary sourceRoot.toAuthoritativeRoot sourceVisit.current reader,
   .create state⟩ input.query
 let actualNext:node.erase=(⟨OwnInquiry.World sourceRoot sourceVisit reader,
  root.generatedNextCurrentAt currentVisit⟩:AnyAuthoritativeRootCurrent):=rfl
 {
  state:=state
  input:=input
  face:=face
  consumer:=consumed
  compiled:=compiled
  readback:=readback
  sameLedger:=sameLedger
  sameVisit:=HEq.rfl
  sameEntry:=HEq.rfl
  canonicalWhole:=oldRoot.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt currentVisit.current
  canonicalWhole_read:=rfl
  sameWhole:=sameWhole
  successor:=successor
  generatedNext:=generatedNext
  originalSuccessor:=successor
  originalNext:=originalNext
  node:=node
  node_source:=rfl
  actualNext:=actualNext }

private def emit_price_at_row (source:AS.AdmissionPacket (W:=A.W) (X:=A.X) (s:=slot))
 (N:Nat) (answer:PriceAnswer observation nontrivial half source N)
