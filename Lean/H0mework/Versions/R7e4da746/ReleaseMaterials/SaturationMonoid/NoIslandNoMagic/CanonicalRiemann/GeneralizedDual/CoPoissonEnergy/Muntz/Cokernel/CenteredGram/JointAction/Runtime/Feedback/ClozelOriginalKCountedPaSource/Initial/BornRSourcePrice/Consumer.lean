 rfl

def ReaderSource (source:AS.AdmissionPacket (W:=A.W) (X:=A.X) (s:=slot)) : Prop :=
 HEq (R.actionReader source.2.1.1 source.2.2.1 (S.actualOccurrence source.2.1.1))
  (raw observation nontrivial half source.1 source.2.1.1)

private theorem after_native_reader (source:AS.AdmissionPacket (W:=A.W) (X:=A.X) (s:=slot)) :
 ReaderSource observation nontrivial half (AS.bornAfterNative (AS.nativeAfterAdmission factory source)) := by
 rcases source with ⟨n,⟨frame,seed⟩,⟨Y,datum,inventory,pairInventory⟩,⟨language⟩⟩
 cases language
 let cfg:SourceOperationInquiry.Context.Faces.Execution.Activation.Programme
  (PhysicalValue:=Lower.Value A.W n) (PhysicalVar:=A.X) (sort:=slot):=
  {LowVar:=A.X,datum:=datum,nextInventory:=inventory,nextPairInventory:=pairInventory}
 let source:AS.AdmissionPacket (W:=A.W) (X:=A.X) (s:=slot):=⟨n,⟨frame,seed⟩,cfg,⟨rfl⟩⟩
 let next:=AS.bornAfterNative (AS.nativeAfterAdmission factory source)
 have read:=AS.next_action_reader factory n (frame,seed) cfg rfl next.2.1.1 (S.actualOccurrence next.2.1.1)
 have literal:=BornRActualMethodAction.factory_reader observation nontrivial half (n+1)
  (AS.nextSeed factory n (frame,seed) cfg rfl) next.2.1.1
 exact heq_of_eq (read.trans literal)

private theorem input_restriction
 (before after:AS.AdmissionPacket (W:=A.W) (X:=A.X) (s:=slot))
 (grade:after.1=before.1+1)
 (feed:HEq (retainedValue after)
  (R.actionResultAt before.2.1.1 before.2.2.1 (S.actualOccurrence before.2.1.1)).2.2.1) :
 inputAtPacket after=M.packetStock before := by
 rcases before with ⟨n,⟨frame,seed⟩,cfg,language⟩
 rcases after with ⟨j,⟨nextFrame,nextSeed⟩,nextCfg,nextLanguage⟩
 change j=n+1 at grade
 cases grade
 exact congrArg (M.wholeProjection (n+1)) (eq_of_heq feed)

theorem actual_reader_next (update:Nat) : ReaderSource observation nontrivial half (packet (update+1)) :=
 (congrArg (ReaderSource observation nontrivial half) (D.packetAt_successor factory initial pR rfl update)).mpr
  (after_native_reader observation nontrivial half (packet update))

theorem actual_input_source (update:Nat) : inputAtPacket (packet (update+1))=
 M.actualStock observation nontrivial half depth ordinal update :=
 input_restriction (packet update) (packet (update+1))
  (D.packetAt_successor_grade factory initial pR rfl update)
  (BornRAdmissionPaidReadout.actual_successor_paid observation nontrivial half depth ordinal update)

def sourceInput (update:Nat) : BurnolL2 := (inputAtPacket (packet (update+1))).1.1

-- The next R node owns this full-expression calculation row, rather than the registered math residual row.
def own_action_row (source:AS.AdmissionPacket (W:=A.W) (X:=A.X) (s:=slot)) :=
 let frame:=source.2.1.1
 let cfg:=source.2.2.1
 let old:=(S.baseRoot frame cfg).toAuthoritativeRoot
 let origin:=(S.actualVisit frame).current
 let reader:old.toLedgerRoot.source.source.toRootSource.actual.OccurrenceAt origin→
  OF.Raw (Value:=PairValue (Lower.Value A.W source.1)) (Var:=cfg.LowVar) (sort:=slot):=
  fun _=>R.actionReader frame cfg (S.actualOccurrence frame)
 let state:=OF.initial old origin reader
 PProd.mk (OF.mathEntry old origin reader state) <|
 PProd.mk (OF.destination_math old origin reader state) <|
 PProd.mk (OF.origin_math old origin reader state)
  (BornRSealedSourceWriteback.Generic.calculation_whole_next frame cfg)

theorem actual_kernel_action (update:Nat) (kernel:BurnolL2) :
 inner ℂ kernel (M.actualStock observation nontrivial half depth ordinal (update+1)).1.1-
 inner ℂ kernel (sourceInput observation nontrivial half depth ordinal update)=
 inner ℂ (sourceDelta observation nontrivial half kernel) (sourceInput observation nontrivial half depth ordinal update) := by
 unfold sourceInput
 rw [actual_input_source,M.physical_step]
 simpa only [inner_sub_right, OriginalKCombCofinalTwoDirection.coordinate, originalKCoordinate,
  burnolDivisionZeroCompletedMellinCoordinate] using (source_delta_read observation nontrivial half kernel
  (M.actualStock observation nontrivial half depth ordinal update).1.1).symm

theorem actual_price_bill (update N:Nat) :
 CofinalQSource.priceCLM observation half N (M.actualStock observation nontrivial half depth ordinal (update+1)).1.1-
 CofinalQSource.priceCLM observation half N (sourceInput observation nontrivial half depth ordinal update)=
 generatedBill observation nontrivial half N (sourceInput observation nontrivial half depth ordinal update) := by
 unfold sourceInput
 rw [actual_input_source,M.physical_step]
 simpa only [OriginalKCombCofinalTwoDirection.coordinate, originalKCoordinate,
  burnolDivisionZeroCompletedMellinCoordinate] using
  price_generated_bill observation nontrivial half N (M.actualStock observation nontrivial half depth ordinal update).1.1

structure PriceAnswer (source:AS.AdmissionPacket (W:=A.W) (X:=A.X) (s:=slot)) (N:Nat) where
 bill : ℂ
 originalKDelta : ℂ
 originalFKDelta : ℂ
 KHeadDelta : ℂ
 FKHeadDelta : ℂ
 paFee : ℂ
 outside : ℂ
 bill_source : bill=generatedBill observation nontrivial half N (inputAtPacket source).1.1
 K_source : originalKDelta=inner ℂ
  (sourceDelta observation nontrivial half (counted N (originalK observation nontrivial half))) (inputAtPacket source).1.1
 FK_source : originalFKDelta=inner ℂ
  (sourceDelta observation nontrivial half (counted N (originalFK observation nontrivial half))) (inputAtPacket source).1.1
 K_head_source : KHeadDelta=KHeadMoment observation nontrivial half N (inputAtPacket source).1.1
 FK_head_source : FKHeadDelta=FKHeadMoment observation nontrivial half N (inputAtPacket source).1.1
 pa_source : paFee=paFeeMoment observation nontrivial half N (inputAtPacket source).1.1
 outside_source : outside=outsideMoment observation nontrivial half N (inputAtPacket source).1.1
 K_read : inner ℂ (counted N (originalK observation nontrivial half)) (M.packetStock source).1.1-
  inner ℂ (counted N (originalK observation nontrivial half)) (inputAtPacket source).1.1=originalKDelta
 FK_read : inner ℂ (counted N (originalFK observation nontrivial half)) (M.packetStock source).1.1-
  inner ℂ (counted N (originalFK observation nontrivial half)) (inputAtPacket source).1.1=originalFKDelta
 K_head_read : inner ℂ (counted N (KHead observation nontrivial half)) (M.packetStock source).1.1-
  inner ℂ (counted N (KHead observation nontrivial half)) (inputAtPacket source).1.1=KHeadDelta
 FK_head_read : inner ℂ (counted N (FKHead observation nontrivial half)) (M.packetStock source).1.1-
  inner ℂ (counted N (FKHead observation nontrivial half)) (inputAtPacket source).1.1=FKHeadDelta
 price_read : CofinalQSource.priceCLM observation half N (M.packetStock source).1.1-
  CofinalQSource.priceCLM observation half N (inputAtPacket source).1.1=bill

def actualPriceAnswer (update N:Nat) : PriceAnswer observation nontrivial half (packet (update+1)) N where
 bill:=generatedBill observation nontrivial half N (sourceInput observation nontrivial half depth ordinal update)
 originalKDelta:=inner ℂ (sourceDelta observation nontrivial half (counted N (originalK observation nontrivial half)))
  (sourceInput observation nontrivial half depth ordinal update)
 originalFKDelta:=inner ℂ (sourceDelta observation nontrivial half (counted N (originalFK observation nontrivial half)))
  (sourceInput observation nontrivial half depth ordinal update)
 KHeadDelta:=KHeadMoment observation nontrivial half N (sourceInput observation nontrivial half depth ordinal update)
 FKHeadDelta:=FKHeadMoment observation nontrivial half N (sourceInput observation nontrivial half depth ordinal update)
 paFee:=paFeeMoment observation nontrivial half N (sourceInput observation nontrivial half depth ordinal update)
 outside:=outsideMoment observation nontrivial half N (sourceInput observation nontrivial half depth ordinal update)
 bill_source:=rfl
 K_source:=rfl
 FK_source:=rfl
 K_head_source:=rfl
 FK_head_source:=rfl
 pa_source:=rfl
 outside_source:=rfl
 K_read:=actual_kernel_action observation nontrivial half depth ordinal update (counted N (originalK observation nontrivial half))
 FK_read:=actual_kernel_action observation nontrivial half depth ordinal update (counted N (originalFK observation nontrivial half))
 K_head_read:=actual_kernel_action observation nontrivial half depth ordinal update (counted N (KHead observation nontrivial half))
 FK_head_read:=actual_kernel_action observation nontrivial half depth ordinal update (counted N (FKHead observation nontrivial half))
 price_read:=actual_price_bill observation nontrivial half depth ordinal update N

