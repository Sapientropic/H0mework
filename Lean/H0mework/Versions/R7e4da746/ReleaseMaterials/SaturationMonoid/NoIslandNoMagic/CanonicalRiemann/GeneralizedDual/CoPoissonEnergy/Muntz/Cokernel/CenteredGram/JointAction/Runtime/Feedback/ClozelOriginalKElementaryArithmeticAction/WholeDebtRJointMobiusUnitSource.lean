/-- The coefficient is generated by the actual outer response's gap and the original unit action. -/

theorem actual_unit_gap_balance (c : BurnolCompletedMellinCoordinate) :
    unitCoefficient c * unitGap c = actualGap c := by
  have nonzero : c.value ≠ 0 := by
    intro zero
    have right := c.rightHalf
    rw [zero] at right
    norm_num at right
  have power : (4 : ℂ) ^ c.value ≠ 0 :=
    Complex.cpow_ne_zero_iff.mpr (Or.inl (by norm_num))
  unfold unitCoefficient unitGap
  rw [Complex.cpow_neg]
  field_simp [nonzero, power]



theorem actual_unit_mean (c : BurnolCompletedMellinCoordinate) :
    (∫ u : ℝ in Ioi 0, (u : ℂ)⁻¹ * unitRaw c u) = -unitGap c := by
  rw [unitRaw, burnolRadiusUnitTail_reciprocalMean c 4 (by norm_num)]
  unfold unitGap
  simp only [Complex.ofReal_ofNat]
  ring

theorem actual_tate_source (c : BurnolCompletedMellinCoordinate) (x : ℝ) :
    burnolTateReciprocalRaw (sourceRaw c) x =
      burnolTateReciprocalRaw (Q.outsideSourceRaw c) x -
        unitCoefficient c * burnolTateReciprocalRaw (unitRaw c) x := by
  unfold burnolTateReciprocalRaw sourceRaw
  ring

private theorem outside_zero (c : BurnolCompletedMellinCoordinate) {x : ℝ}
    (inside : |x| ≤ (4 : ℝ)) : Q.outsideSourceRaw c x = 0 := by
  have window : x ∈ symmetricInterval (4 : ℝ) := abs_le.mp inside
  exact Set.indicator_of_notMem (not_not.mpr window) _

theorem actual_source_zero_window (c : BurnolCompletedMellinCoordinate) {x : ℝ}
    (inside : |x| ≤ (4 : ℝ)) : sourceRaw c x = 0 := by
  rw [sourceRaw, outside_zero c inside]
  simp only [unitRaw, burnolRadiusUnitTailRaw, if_neg (not_lt.mpr inside), mul_zero, sub_zero]

private theorem forward_zero_window (raw : ℝ → ℂ)
    (zero : ∀ {x : ℝ}, |x| ≤ (4 : ℝ) → raw x = 0) {x : ℝ}
    (inside : |x| ≤ (4 : ℝ)) : burnolInnerGapForward raw x = 0 := by
  unfold burnolInnerGapForward
  calc
    _ = ∑' _ : ℕ+, (0 : ℂ) := by
      apply tsum_congr
      intro n
      have positive : (0 : ℝ) < (n : ℕ) := by exact_mod_cast n.pos
      have atLeastOne : (1 : ℝ) ≤ (n : ℕ) := by exact_mod_cast n.pos
      have scaled : |x / (n : ℕ)| ≤ (4 : ℝ) := by
        rw [abs_div, abs_of_pos positive, div_le_iff₀ positive]
        linarith
      rw [zero scaled, mul_zero]
    _ = 0 := tsum_zero

theorem actual_response_zero_window (c : BurnolCompletedMellinCoordinate) {x : ℝ}
    (inside : |x| ≤ (4 : ℝ)) : responseRaw c x = 0 :=
  forward_zero_window _ (actual_source_zero_window c) inside

private theorem forward_source_action (c : BurnolCompletedMellinCoordinate) (x : ℝ) :
    responseRaw c x = burnolInnerGapForward (Q.outsideSourceRaw c) x -
      unitCoefficient c * burnolInnerGapForward (unitRaw c) x := by
  have outsideGap : ∀ {x : ℝ}, |x| ≤ q → Q.outsideSourceRaw c x = 0 :=
    fun inside => outside_zero c (by linarith)
  have unitQuarter : ∀ {x : ℝ}, |x| ≤ q → unitRaw c x = 0 := by
    intro x inside
    exact if_neg (not_lt.mpr (by linarith))
  have sourceGap : ∀ {x : ℝ}, |x| ≤ q → sourceRaw c x = 0 :=
    fun inside => actual_source_zero_window c (by linarith)
  rw [responseRaw, forward_cut _ sourceGap, forward_cut _ outsideGap,
    forward_cut _ unitQuarter, Finset.mul_sum, ← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro n _
  unfold sourceRaw
  ring

private theorem unit_response_read (c : BurnolCompletedMellinCoordinate) :
    (burnolUnitTailResponse c 4 : ℝ → ℂ) =ᵐ[volume]
      fun x => burnolInnerGapForward (unitRaw c) x + unitGap c := by
  filter_upwards [burnolUnitTailResponse_coeFn c 4 (by norm_num) (by norm_num)] with x actual
  rw [actual]
  unfold unitRaw unitGap burnolUnitTailDirichletRaw
  rw [burnolRadiusUnitTail_finiteCoSum c.value 4 x (by norm_num)]
  simp only [Complex.ofReal_ofNat]
  ring

private theorem response_read (c : BurnolCompletedMellinCoordinate) :
    ((Q.outsideResponse c - unitCoefficient c • burnolUnitTailResponse c 4 : BurnolL2) : ℝ → ℂ)
      =ᵐ[volume] responseRaw c := by
  filter_upwards [Lp.coeFn_sub (Q.outsideResponse c)
    (unitCoefficient c • burnolUnitTailResponse c 4),
    Lp.coeFn_smul (unitCoefficient c) (burnolUnitTailResponse c 4),
    OriginalWholeDebtRJointMobiusProgramme.actual_outside_response_raw c,
    unit_response_read c] with x difference scalar outside unit
  rw [difference]
  change Q.outsideResponse c x - (unitCoefficient c • burnolUnitTailResponse c 4 : BurnolL2) x = _
  rw [scalar]
  change Q.outsideResponse c x - unitCoefficient c * burnolUnitTailResponse c 4 x = _
  rw [outside, unit, forward_source_action]
  change burnolInnerGapForward (Q.outsideSourceRaw c) x + J.jointMean c + Q.sourceMean c -
    unitCoefficient c * (burnolInnerGapForward (unitRaw c) x + unitGap c) = _
  rw [mul_add, actual_unit_gap_balance]
  unfold actualGap
  ring

private theorem response_memLp (c : BurnolCompletedMellinCoordinate) :
    MemLp (responseRaw c) 2 volume :=
  (Lp.memLp (Q.outsideResponse c - unitCoefficient c • burnolUnitTailResponse c 4)).ae_eq (response_read c)

def response (c : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  (response_memLp c).toLp (responseRaw c)

theorem actual_raw (c : BurnolCompletedMellinCoordinate) :
    (response c : ℝ → ℂ) =ᵐ[volume] responseRaw c := (response_memLp c).coeFn_toLp

theorem actual_source_update (c : BurnolCompletedMellinCoordinate) :
    Q.outsideResponse c = unitCoefficient c • burnolUnitTailResponse c 4 + response c := by
  have read : Q.outsideResponse c - unitCoefficient c • burnolUnitTailResponse c 4 = response c :=
    Lp.ext ((response_read c).trans (actual_raw c).symm)
  exact (sub_eq_iff_eq_add.mp read).trans (add_comm _ _)

theorem actual_fourier_update (c : BurnolCompletedMellinCoordinate) :
    fourierL2 (Q.outsideResponse c) =
      unitCoefficient c • fourierL2 (burnolUnitTailResponse c 4) + fourierL2 (response c) := by
  rw [actual_source_update, map_add, map_smul]

theorem actual_zero_window (c : BurnolCompletedMellinCoordinate) :
    (response c : ℝ → ℂ) =ᵐ[volume.restrict (symmetricInterval (4 : ℝ))] fun _ => 0 := by
  filter_upwards [ae_restrict_of_ae (actual_raw c),
    ae_restrict_mem (measurableSet_symmetricInterval (4 : ℝ))] with x raw inside
  exact raw.trans (actual_response_zero_window c (abs_le.mpr inside))

private theorem coordinate_eq {left right : BurnolCompletedMellinCoordinate}
    (same : left.value = right.value) : left = right := by
  cases left
  cases right
  cases same
  rfl

