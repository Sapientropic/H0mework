theorem actual_physical : response c ∈ evenBurnolClosedFace q := by
  have jointPa := OriginalWholeDebtRJointMobiusSource.actual_pa_wave c
  obtain ⟨ambient, _, wave⟩ := Submodule.mem_map.mp jointPa
  have ambientMem : J.paWave c ∈ (evenBurnolClosedFace q).toSubmodule := by
    rw [← wave]
    exact ambient.property
  have outsideMem : Q.outsideResponse c ∈ (evenBurnolClosedFace q).toSubmodule := by
    have eq : Q.outsideResponse c = (J.jointValue c : BurnolL2) - J.paWave c := by
      rw [OriginalWholeDebtRJointMobiusProgramme.actual_joint_wave_response]
      abel
    rw [eq]
    exact Submodule.sub_mem _ (J.jointValue c).property ambientMem
  have unitMem := burnolZeroOwnedUnitTailResponse_physical observation nontrivial half.down
  have same : burnolDivisionZeroCompletedMellinCoordinate observation half.down = c := by
    apply coordinate_eq
    rfl
  rw [same] at unitMem
  have eq : response c = Q.outsideResponse c - unitCoefficient c • burnolUnitTailResponse c 4 := by
    rw [actual_source_update]
    abel
  rw [eq]
  exact Submodule.sub_mem _ outsideMem (Submodule.smul_mem _ _ unitMem)

theorem actual_programme_price :
    OriginalNextEndpointProgramme.programmePrice c (Real.log stageZeroSonineQ) =
      -inner ℂ (K c : BurnolL2) (response c) := by
  have unitPrice := OriginalKCrossParameterRAdjointSource.UnitKSource.wholeUnitSourcePrice_zero
    observation nontrivial half
  unfold OriginalKDirectRCofinalOutsideVolterraSource.wholeUnitSourcePrice at unitPrice
  rw [OriginalKSourceResolventReconstruction.generatedK_eq_original] at unitPrice
  rw [OriginalWholeDebtRJointMobiusProgramme.actual_programme_price observation nontrivial half,
    actual_source_update, inner_add_right, inner_smul_right, unitPrice, mul_zero, zero_add]

