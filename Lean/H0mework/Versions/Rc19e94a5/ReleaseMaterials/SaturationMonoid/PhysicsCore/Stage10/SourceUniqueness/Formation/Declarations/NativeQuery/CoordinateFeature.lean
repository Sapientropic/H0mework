import H0mework.Versions.Rc19e94a5.ReleaseMaterials.SaturationMonoid.PhysicsCore.Stage10.SourceUniqueness.Formation.Declarations.NativeQuery.ValuePairingReceiptConsumer
import H0mework.Realization.Coherent.Completion

/-!
# All coordinate Hilbert features of the original duration evaluator

The conductor carrier contains an entire function of Schwartz test and real
scale. Its point evaluations form a complete family of actual integer-linear
features; no coordinate is selected as source authority. Each feature may
use the existing complexification and Hilbert Gram machinery, while the
joint kernel retains precisely the original whole-function evaluation.
-/

set_option autoImplicit false

namespace SaturationMonoid.PhysicsCore.Stage10.SourceUniqueness.MotherNativeQuery

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open RawGeneratedRoot.CofinalAction
open SourceGeneratedIntegralCoherentCompletion
open SourceGeneratedComplexFeaturePerfectification
open scoped ComplexConjugate

noncomputable section

abbrev Test := SchwartzMap ℝ ℂ

def coordinateRead (test : Test) (scale : ℝ) :
    MotherPhysicalSource.Carrier →ₗ[ℤ] ℂ where
  toFun := fun value => value test scale
  map_add' := by intros; rfl
  map_smul' := by intros; rfl

def coordinateFeature (law : MotherPhysicalLaws.Law)
    {current : MotherPhysicalSource.Current}
    (occurrence : MotherPhysicalSource.OccurrenceAt current)
    (test : Test) (scale : ℝ) :
    (MotherPhysicalSource.Generator →₀ ℤ) →ₗ[ℤ] ℂ :=
  (coordinateRead test scale).comp
    ((faithfulLaw (MotherPhysicalSource.receiptAction law)
      ).faithfulAt occurrence).freeEvaluation

/-- The family, rather than one chosen test/scale, is the source readout. -/
def coordinateFamily (law : MotherPhysicalLaws.Law)
    {current : MotherPhysicalSource.Current}
    (occurrence : MotherPhysicalSource.OccurrenceAt current) :=
  fun test scale => coordinateFeature law occurrence test scale

theorem coordinateFamily_joint_kernel (law : MotherPhysicalLaws.Law)
    {current : MotherPhysicalSource.Current}
    (occurrence : MotherPhysicalSource.OccurrenceAt current)
    (word : MotherPhysicalSource.Generator →₀ ℤ) :
    (∀ test : Test, ∀ scale : ℝ,
      coordinateFamily law occurrence test scale word = 0) ↔
      ((faithfulLaw (MotherPhysicalSource.receiptAction law)
        ).faithfulAt occurrence).freeEvaluation word = 0 := by
  constructor
  · intro allZero
    funext test scale
    exact allZero test scale
  · intro zero test scale
    change (((faithfulLaw (MotherPhysicalSource.receiptAction law)
      ).faithfulAt occurrence).freeEvaluation word) test scale = 0
    rw [zero]
    rfl

/-- The existing complex feature producer computes the Gram of one actual
coordinate. It is a coordinate Hilbert Gram, not an L² norm on all conductor
functions. -/
theorem coordinate_generated_gram (law : MotherPhysicalLaws.Law)
    {current : MotherPhysicalSource.Current}
    (occurrence : MotherPhysicalSource.OccurrenceAt current)
    (test : Test) (scale : ℝ)
    (left right : MotherPhysicalSource.Generator →₀ ℤ) :
    gramEvaluation (complexifiedFeature (coordinateFeature law occurrence test scale))
        (1 ⊗ₜ[ℤ] left) (1 ⊗ₜ[ℤ] right) =
      inner ℂ
        ((((faithfulLaw (MotherPhysicalSource.receiptAction law)
          ).faithfulAt occurrence).freeEvaluation left) test scale)
        ((((faithfulLaw (MotherPhysicalSource.receiptAction law)
          ).faithfulAt occurrence).freeEvaluation right) test scale) := by
  rw [gramEvaluation_apply, complexifiedFeature_one_tmul,
    complexifiedFeature_one_tmul]
  rfl

/-- The exact correction between the old function-valued bilinear product
and the Hilbert coordinate Gram is generated by conjugating the left actual
source read. No norm, positivity or zero correction is assumed. -/
theorem coordinate_hermitian_correction (law : MotherPhysicalLaws.Law)
    {current : MotherPhysicalSource.Current}
    (occurrence : MotherPhysicalSource.OccurrenceAt current)
    (test : Test) (scale : ℝ)
    (left right : MotherPhysicalSource.Generator →₀ ℤ) :
    let sourceLaw := MotherPhysicalSource.receiptAction law
    let first := (((faithfulLaw sourceLaw).faithfulAt occurrence).freeEvaluation left) test scale
    let last := (((faithfulLaw sourceLaw).faithfulAt occurrence).freeEvaluation right) test scale
    gramEvaluation (complexifiedFeature (coordinateFeature law occurrence test scale))
        (1 ⊗ₜ[ℤ] left) (1 ⊗ₜ[ℤ] right) -
      (valuePairing sourceLaw occurrence left right) test scale =
        (conj first - first) * last := by
  let first : ℂ := (((faithfulLaw (MotherPhysicalSource.receiptAction law)
    ).faithfulAt occurrence).freeEvaluation left) test scale
  let last : ℂ := (((faithfulLaw (MotherPhysicalSource.receiptAction law)
    ).faithfulAt occurrence).freeEvaluation right) test scale
  rw [coordinate_generated_gram, RCLike.inner_apply']
  change conj first * last - first * last = (conj first - first) * last
  ring

theorem coordinate_coherent_readback (law : MotherPhysicalLaws.Law)
    {current : MotherPhysicalSource.Current}
    (occurrence : MotherPhysicalSource.OccurrenceAt current)
    (test : Test) (scale : ℝ)
    (word : MotherPhysicalSource.Generator →₀ ℤ) :
    coherentCompletionRealization (coordinateFeature law occurrence test scale)
        (discreteToCoherentCompletion (coordinateFeature law occurrence test scale) word) =
      (((faithfulLaw (MotherPhysicalSource.receiptAction law)
        ).faithfulAt occurrence).freeEvaluation word) test scale := by
  rw [discreteToCoherentCompletion_actual_readback]
  rfl

/-- Reassemble the complete conductor function from all of its actual
coordinate coherent realizations. No inverse of one selected observation is
claimed or supplied. -/
def recoverWholeValue (law : MotherPhysicalLaws.Law)
    {current : MotherPhysicalSource.Current}
    (occurrence : MotherPhysicalSource.OccurrenceAt current)
    (word : MotherPhysicalSource.Generator →₀ ℤ) :
    MotherPhysicalSource.Carrier :=
  fun test scale =>
    coherentCompletionRealization (coordinateFeature law occurrence test scale)
      (discreteToCoherentCompletion (coordinateFeature law occurrence test scale) word)

theorem recoverWholeValue_eq_actual (law : MotherPhysicalLaws.Law)
    {current : MotherPhysicalSource.Current}
    (occurrence : MotherPhysicalSource.OccurrenceAt current)
    (word : MotherPhysicalSource.Generator →₀ ℤ) :
    recoverWholeValue law occurrence word =
      ((faithfulLaw (MotherPhysicalSource.receiptAction law)
        ).faithfulAt occurrence).freeEvaluation word := by
  funext test scale
  exact coordinate_coherent_readback law occurrence test scale word

#print axioms coordinateFamily_joint_kernel
#print axioms coordinate_generated_gram
#print axioms coordinate_hermitian_correction
#print axioms coordinate_coherent_readback
#print axioms recoverWholeValue_eq_actual

end
