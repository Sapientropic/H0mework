import Mathlib.AlgebraicGeometry.EllipticCurve.Affine.Point
import Mathlib.RingTheory.PicardGroup
import H0mework.Versions.Rb81a4438.ReleaseMaterials.SaturationMonoid.GenericFoundation.Scalar.Determinant.LivingLawRootGeneratedScalarFiniteFreeDeterminantDispositionKernel
import H0mework.Versions.Rb81a4438.ReleaseMaterials.SaturationMonoid.GenericFoundation.Scalar.Determinant.LivingLawRootGeneratedScalarPicardBoundaryKernel

/-!
# Nontrivial Picard-line regression

An actual nonzero point on the explicit rational elliptic curve
`y² = x³ - x` supplies a nontrivial ideal class.  Its representative in the
Picard group is invertible and projective but not free, so determinant lines
cannot be collapsed to globally chosen scalar coordinates.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace SourceGeneratedScalarNontrivialPicardLineRegression

open CommRing
open WeierstrassCurve
open SourceGeneratedScalarPerfectification
open SourceGeneratedScalarBoundedObservationDisposition
open SourceGeneratedScalarFiniteProjectiveDuality
open SourceGeneratedScalarFiniteFreeDeterminantDisposition

noncomputable section

universe u

variable {F : Type u} [Field F]

/-- The Picard class generated by the same actual affine-point occurrence. -/
noncomputable def pointPic (curve : WeierstrassCurve.Affine F)
    (point : curve.Point) : Pic curve.CoordinateRing := by
  classical
  exact ClassGroup.equivPic curve.CoordinateRing
    (Additive.toMul
      (WeierstrassCurve.Affine.Point.toClass (W := curve) point))

theorem pointPic_ne_one (curve : WeierstrassCurve.Affine F)
    {point : curve.Point} (nonzero : point ≠ 0) :
    pointPic curve point ≠ 1 := by
  classical
  intro equality
  let idealClass := Additive.toMul
    (WeierstrassCurve.Affine.Point.toClass (W := curve) point)
  change ClassGroup.equivPic curve.CoordinateRing idealClass = 1 at equality
  have classTrivial : idealClass = (1 : ClassGroup curve.CoordinateRing) :=
    (ClassGroup.equivPic curve.CoordinateRing).injective
      (by simpa only [map_one] using equality)
  apply nonzero
  rw [← WeierstrassCurve.Affine.Point.toClass_eq_zero (W := curve) point]
  apply Additive.toMul.injective
  simpa [idealClass] using classTrivial

theorem pointPic_not_free (curve : WeierstrassCurve.Affine F)
    {point : curve.Point} (nonzero : point ≠ 0) :
    ¬ Module.Free curve.CoordinateRing (pointPic curve point) := by
  intro free
  let _ : Module.Free curve.CoordinateRing (pointPic curve point) := free
  have classTrivial := Pic.mk_eq_one curve.CoordinateRing (pointPic curve point)
  rw [Pic.mk_eq_self] at classTrivial
  exact pointPic_ne_one curve nonzero classTrivial

def rationalCurve : WeierstrassCurve ℚ :=
  ⟨0, 0, 0, -1, 0⟩

instance : rationalCurve.IsElliptic := by
  rw [WeierstrassCurve.isElliptic_iff]
  norm_num [rationalCurve, WeierstrassCurve.Δ, WeierstrassCurve.b₂,
    WeierstrassCurve.b₄, WeierstrassCurve.b₆, WeierstrassCurve.b₈]

theorem rationalPoint_equation : rationalCurve.toAffine.Equation 1 0 := by
  rw [WeierstrassCurve.Affine.equation_iff]
  norm_num [rationalCurve]

def rationalPoint : rationalCurve.toAffine.Point :=
  .mk rationalPoint_equation

theorem rationalPoint_ne_zero : rationalPoint ≠ 0 := by
  exact WeierstrassCurve.Affine.Point.some_ne_zero _

/-- A concrete nonfree Picard line over the affine coordinate ring of `y² = x³ - x`. -/
theorem rationalPointPic_not_free :
    ¬ Module.Free rationalCurve.toAffine.CoordinateRing
      (pointPic rationalCurve.toAffine rationalPoint) :=
  pointPic_not_free rationalCurve.toAffine rationalPoint_ne_zero

abbrev RationalRing := rationalCurve.toAffine.CoordinateRing

abbrev RationalPicLine := pointPic rationalCurve.toAffine rationalPoint

noncomputable def rationalPicEvaluation :
    RationalPicLine →ₗ[RationalRing]
      Module.Dual RationalRing (Module.Dual RationalRing RationalPicLine) :=
  Module.Dual.eval RationalRing RationalPicLine

theorem rationalPicEvaluation_injective :
    Function.Injective rationalPicEvaluation := by
  exact (Module.evalEquiv RationalRing RationalPicLine).injective

noncomputable def rationalPicObservation :
    PerfectificationCarrier rationalPicEvaluation →ₗ[RationalRing]
      RationalPicLine :=
  quotientToSource rationalPicEvaluation rationalPicEvaluation_injective

theorem rationalPicObservation_bijective :
    Function.Bijective rationalPicObservation :=
  quotientToSource_bijective rationalPicEvaluation
    rationalPicEvaluation_injective

theorem rationalPicClass_ne_one :
    CommRing.Pic.mk RationalRing RationalPicLine ≠ 1 := by
  simpa only [CommRing.Pic.mk_eq_self] using
    pointPic_ne_one rationalCurve.toAffine rationalPoint_ne_zero

/-- The actual nontrivial Picard line reaches the projective-nonfree branch
of the generic determinant disposition; its Picard coordinate remains
nontrivial and no frame is generated. -/
theorem rationalPicLine_settles_projectiveNonfree :
    ∃ (equivalence :
        PerfectificationCarrier rationalPicEvaluation ≃ₗ[RationalRing]
          RationalPicLine)
      (finite : Module.Finite RationalRing RationalPicLine)
      (projective : Module.Projective RationalRing RationalPicLine)
      (duality : TensorDuality (R := RationalRing) RationalPicLine),
      SourceGeneratedScalarBoundedObservationDisposition.settle
          rationalPicEvaluation rationalPicObservation =
        .boundedDualizable equivalence finite projective duality ∧
      SourceGeneratedScalarFiniteFreeDeterminantDisposition.settle
          (observation := rationalPicObservation)
          (.boundedDualizable (observation := rationalPicObservation)
            equivalence finite projective duality) =
        .picardEligibleResidual (observation := rationalPicObservation)
          equivalence finite projective duality
          (.projectiveNonfree rationalPointPic_not_free) ∧
      CommRing.Pic.mk RationalRing RationalPicLine ≠ 1 := by
  let equivalence := LinearEquiv.ofBijective rationalPicObservation
    rationalPicObservation_bijective
  let finite : Module.Finite RationalRing RationalPicLine := inferInstance
  let projective : Module.Projective RationalRing RationalPicLine := inferInstance
  let duality := SourceGeneratedScalarFiniteProjectiveDuality.generate
    finite projective
  refine ⟨equivalence, finite, projective, duality, ?_, ?_,
    rationalPicClass_ne_one⟩
  · exact SourceGeneratedScalarBoundedObservationDisposition.settle_eq_boundedDualizable
      rationalPicEvaluation rationalPicObservation equivalence
      (SourceGeneratedScalarObservationDisposition.settle_eq_exact_of_bijective
        rationalPicObservation rationalPicObservation_bijective)
      finite projective
  · exact settle_bounded_projectiveNonfree equivalence finite projective
      duality rationalPointPic_not_free

example : Module.Invertible rationalCurve.toAffine.CoordinateRing
    (pointPic rationalCurve.toAffine rationalPoint) := inferInstance

example : Module.Projective rationalCurve.toAffine.CoordinateRing
    (pointPic rationalCurve.toAffine rationalPoint) := inferInstance

end
end SourceGeneratedScalarNontrivialPicardLineRegression
end ConstructiveRoot
end LivingLawEvolution
