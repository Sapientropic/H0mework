import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.NoIslandNoMagic.Consciousness.Culture.M14.Institution.Interface.SourceNativeM14InstitutionalSpan
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.NoIslandNoMagic.Consciousness.Culture.M14.Consumer.IndependentM14CultureConsumers

/-!
# Independent institutional-authority consumer

The occurrence domain is the source-generated platform revision candidate:
the two existing paid channels plus the exact new platform gate.  Forgetting
institutional authority sends every channel to the same relation-side culture
occurrence.  A separately declared low-universe readout retains the actual
channel seed, actor, target role, selection, inherited observer/admission
state, and platform material code.

The new readout escapes the old occurrence kernel before any revised culture
carrier is imported.  High-universe paid-U8/full-admission evidence appears
only in grounding the readout.  No culture source material, representation,
quotient, root installation, or successor is defined here.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace NoIslandNoMagic
namespace Consciousness
namespace Culture
namespace M14
namespace Institution
namespace Consumer

open ProcessGame Society
open ProcessGame.Society.M14EssentialAccessRelationFixture
open ProcessGame.Society.M14EssentialAccessSectorRegression
open ProcessGame.Society.M14SourceGeneratedContributionCapacityEssentialAccessChannel
open ProcessGame.Society.M14SourceGeneratedPlatformChannelRevisionCandidate
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Representation
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Culture.M14.Interface
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Culture.M14.Consumer
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Culture.M14.Institution.Interface

noncomputable section

abbrev M14InstitutionalChannelOccurrenceAt (boundary : Nat) :=
  RevisedPaidEssentialAccessChannelAt
    (sourceGeneratedPlatformChannelRevisionCandidateAt boundary).obstruction

def m14InstitutionalTenureOccurrenceAt (boundary : Nat) :
    M14InstitutionalChannelOccurrenceAt boundary :=
  .inl tenureAuthority

def m14InstitutionalHealthOccurrenceAt (boundary : Nat) :
    M14InstitutionalChannelOccurrenceAt boundary :=
  .inl healthAuthority

def m14InstitutionalPlatformOccurrenceAt (boundary : Nat) :
    M14InstitutionalChannelOccurrenceAt boundary :=
  .inr (sourceGeneratedPlatformChannelRevisionCandidateAt boundary).gate

/-- Forgetting institutional channel authority returns the one relation-side
culture occurrence from which the Payment U8 branches. -/
def m14InstitutionalOldCultureViewAt (boundary : Nat) :
    M14InstitutionalChannelOccurrenceAt boundary →
      M14CultureOccurrenceAt (m14InstitutionalBaseAt boundary) :=
  fun _channel => false

@[simp] theorem m14InstitutionalOldCultureView_depth_exact
    (boundary : Nat) (channel : M14InstitutionalChannelOccurrenceAt boundary) :
    sourceM14CultureDepthAt (m14InstitutionalBaseAt boundary)
        (m14InstitutionalOldCultureViewAt boundary channel) =
      ProcessGame.Society.M14SourceGeneratedPlatformGateAffectedBearerIncidence.platformGateAffectedBearerDepthAt
        boundary :=
  m14InstitutionalCultureDepth_false boundary

def m14InstitutionalChannelCodeAt
    {boundary : Nat} : M14InstitutionalChannelOccurrenceAt boundary → Nat
  | .inl (.tenure _) => 0
  | .inl (.health _) => 1
  | .inr _gate => 2

def m14InstitutionalChannelSeedAt
    {boundary : Nat} : M14InstitutionalChannelOccurrenceAt boundary →
      essentialAccessRelationCompiler.ExactRelationSeed
  | .inl channel => channelSeed channel
  | .inr gate => gate.seed

def m14InstitutionalChannelActorAt
    {boundary : Nat} (channel : M14InstitutionalChannelOccurrenceAt boundary) :
    essentialAccessRelationCompiler.Actor :=
  (m14InstitutionalChannelSeedAt channel).actor
    essentialAccessRelationCompiler

def m14InstitutionalChannelTargetRoleAt
    {boundary : Nat} : M14InstitutionalChannelOccurrenceAt boundary →
      EssentialAccessRole
  | .inl channel => channelTargetRole channel
  | .inr gate => gate.targetRole

def m14InstitutionalChannelIsNewPlatformAt
    {boundary : Nat} : M14InstitutionalChannelOccurrenceAt boundary → Bool
  | .inl _channel => false
  | .inr _gate => true

def m14InstitutionalChannelMaterialAt
    {boundary : Nat} : M14InstitutionalChannelOccurrenceAt boundary →
      Option M14InstitutionalMaterialCode
  | .inl _channel => none
  | .inr _gate => some (m14InstitutionalMaterialCodeAt boundary)

/-- One low-universe power-sensitive readout.  The channel code is a compact
runtime coordinate generated by the three actual authority constructors; the
remaining fields preserve their source semantics. -/
structure M14InstitutionalAuthorityReadout : Type where
  channelCode : Nat
  seed : essentialAccessRelationCompiler.ExactRelationSeed
  actor : essentialAccessRelationCompiler.Actor
  targetRole : EssentialAccessRole
  isNewPlatform : Bool
  selection : M14InstitutionalSelectionCode
  exposureAdmission : M14InstitutionalAdmissionCode
  material : Option M14InstitutionalMaterialCode

def m14InstitutionalAuthorityReadAt
    (oldVisit : ProcessGame.Society.M14SourceGeneratedContributionMergeActionSource.OldVisit)
    (sourceIndex boundary : Nat)
    (channel : M14InstitutionalChannelOccurrenceAt boundary) :
    M14InstitutionalAuthorityReadout where
  channelCode := m14InstitutionalChannelCodeAt channel
  seed := m14InstitutionalChannelSeedAt channel
  actor := m14InstitutionalChannelActorAt channel
  targetRole := m14InstitutionalChannelTargetRoleAt channel
  isNewPlatform := m14InstitutionalChannelIsNewPlatformAt channel
  selection := m14InstitutionalSelectionCodeAt boundary
  exposureAdmission :=
    m14InstitutionalAdmissionCodeAt oldVisit sourceIndex boundary
  material := m14InstitutionalChannelMaterialAt channel

theorem m14InstitutionalChannelCode_injective (boundary : Nat) :
    Function.Injective
      (@m14InstitutionalChannelCodeAt boundary) := by
  intro left right sameCode
  cases left with
  | inl left =>
      cases left with
      | tenure leftInterest =>
          cases right with
          | inl right =>
              cases right with
              | tenure rightInterest =>
                  exact congrArg (fun interest => Sum.inl
                    (EssentialAccessRelationAuthority.tenure interest))
                    (Subsingleton.elim leftInterest rightInterest)
              | health rightInterest =>
                  simp [m14InstitutionalChannelCodeAt] at sameCode
          | inr rightGate =>
              simp [m14InstitutionalChannelCodeAt] at sameCode
      | health leftInterest =>
          cases right with
          | inl right =>
              cases right with
              | tenure rightInterest =>
                  simp [m14InstitutionalChannelCodeAt] at sameCode
              | health rightInterest =>
                  exact congrArg (fun interest => Sum.inl
                    (EssentialAccessRelationAuthority.health interest))
                    (Subsingleton.elim leftInterest rightInterest)
          | inr rightGate =>
              simp [m14InstitutionalChannelCodeAt] at sameCode
  | inr leftGate =>
      cases right with
      | inl right =>
          cases right <;>
            simp [m14InstitutionalChannelCodeAt] at sameCode
      | inr rightGate =>
          exact congrArg Sum.inr (Subsingleton.elim leftGate rightGate)

/-- Exact relation seed, not the runtime constructor code, already recovers
the generated authority occurrence. -/
theorem m14InstitutionalChannelSeed_injective (boundary : Nat) :
    Function.Injective
      (@m14InstitutionalChannelSeedAt boundary) := by
  intro left right sameSeed
  cases left with
  | inl left =>
      cases left with
      | tenure leftInterest =>
          cases right with
          | inl right =>
              cases right with
              | tenure rightInterest =>
                  exact congrArg (fun interest => Sum.inl
                    (EssentialAccessRelationAuthority.tenure interest))
                    (Subsingleton.elim leftInterest rightInterest)
              | health rightInterest =>
                  have events := congrArg Subtype.val sameSeed
                  cases events
          | inr rightGate =>
              have seedCollapse :
                  exactEssentialAccessSeed .tenure =
                    exactEssentialAccessSeed .platform :=
                sameSeed.trans rightGate.seed_eq_platform
              have events := congrArg Subtype.val seedCollapse
              cases events
      | health leftInterest =>
          cases right with
          | inl right =>
              cases right with
              | tenure rightInterest =>
                  have events := congrArg Subtype.val sameSeed
                  cases events
              | health rightInterest =>
                  exact congrArg (fun interest => Sum.inl
                    (EssentialAccessRelationAuthority.health interest))
                    (Subsingleton.elim leftInterest rightInterest)
          | inr rightGate =>
              have seedCollapse :
                  exactEssentialAccessSeed .health =
                    exactEssentialAccessSeed .platform :=
                sameSeed.trans rightGate.seed_eq_platform
              have events := congrArg Subtype.val seedCollapse
              cases events
  | inr leftGate =>
      cases right with
      | inl right =>
          cases right with
          | tenure rightInterest =>
              have seedCollapse :
                  exactEssentialAccessSeed .platform =
                    exactEssentialAccessSeed .tenure :=
                leftGate.seed_eq_platform.symm.trans sameSeed
              have events := congrArg Subtype.val seedCollapse
              cases events
          | health rightInterest =>
              have seedCollapse :
                  exactEssentialAccessSeed .platform =
                    exactEssentialAccessSeed .health :=
                leftGate.seed_eq_platform.symm.trans sameSeed
              have events := congrArg Subtype.val seedCollapse
              cases events
      | inr rightGate =>
          exact congrArg Sum.inr (Subsingleton.elim leftGate rightGate)

theorem m14InstitutionalAuthorityRead_injective
    (oldVisit : ProcessGame.Society.M14SourceGeneratedContributionMergeActionSource.OldVisit)
    (sourceIndex boundary : Nat) :
    Function.Injective
      (m14InstitutionalAuthorityReadAt oldVisit sourceIndex boundary) := by
  intro left right sameRead
  apply m14InstitutionalChannelSeed_injective boundary
  exact congrArg M14InstitutionalAuthorityReadout.seed sameRead

def m14InstitutionalAuthorityReadoutAt
    (oldVisit : ProcessGame.Society.M14SourceGeneratedContributionMergeActionSource.OldVisit)
    (sourceIndex boundary : Nat) :
    IndependentReadout (M14InstitutionalChannelOccurrenceAt boundary) where
  Output := M14InstitutionalAuthorityReadout
  read := m14InstitutionalAuthorityReadAt oldVisit sourceIndex boundary

def m14InstitutionalReindexedCultureConsumersAt (boundary : Nat) :=
  (m14CultureConsumersAt (m14InstitutionalBaseAt boundary)).reindex
    (m14InstitutionalOldCultureViewAt boundary)

def m14InstitutionalCultureConsumersAt
    (oldVisit : ProcessGame.Society.M14SourceGeneratedContributionMergeActionSource.OldVisit)
    (sourceIndex boundary : Nat) :=
  (m14InstitutionalReindexedCultureConsumersAt boundary).adjoin
    (m14InstitutionalAuthorityReadoutAt oldVisit sourceIndex boundary)

@[simp] theorem m14InstitutionalOldCultureView_tenure_eq_platform
    (boundary : Nat) :
    m14InstitutionalOldCultureViewAt boundary
        (m14InstitutionalTenureOccurrenceAt boundary) =
      m14InstitutionalOldCultureViewAt boundary
        (m14InstitutionalPlatformOccurrenceAt boundary) :=
  rfl

theorem m14InstitutionalAuthority_tenure_ne_platform
    (oldVisit : ProcessGame.Society.M14SourceGeneratedContributionMergeActionSource.OldVisit)
    (sourceIndex boundary : Nat) :
    m14InstitutionalAuthorityReadAt oldVisit sourceIndex boundary
        (m14InstitutionalTenureOccurrenceAt boundary) ≠
      m14InstitutionalAuthorityReadAt oldVisit sourceIndex boundary
        (m14InstitutionalPlatformOccurrenceAt boundary) := by
  intro sameRead
  have sameOccurrence := m14InstitutionalAuthorityRead_injective oldVisit
    sourceIndex boundary sameRead
  cases sameOccurrence

theorem m14InstitutionalAuthorityKernelEscapeAt
    (oldVisit : ProcessGame.Society.M14SourceGeneratedContributionMergeActionSource.OldVisit)
    (sourceIndex boundary : Nat) :
    FaceKernelEscapeAt (m14InstitutionalOldCultureViewAt boundary)
      (m14InstitutionalAuthorityReadoutAt oldVisit sourceIndex boundary) :=
  ⟨m14InstitutionalTenureOccurrenceAt boundary,
    m14InstitutionalPlatformOccurrenceAt boundary,
    m14InstitutionalOldCultureView_tenure_eq_platform boundary,
    m14InstitutionalAuthority_tenure_ne_platform oldVisit sourceIndex
      boundary⟩

theorem m14InstitutionalAuthority_oldFactorization_isEmpty
    (oldVisit : ProcessGame.Society.M14SourceGeneratedContributionMergeActionSource.OldVisit)
    (sourceIndex boundary : Nat) :
    ¬ Function.FactorsThrough
      (m14InstitutionalAuthorityReadAt oldVisit sourceIndex boundary)
      (m14InstitutionalOldCultureViewAt boundary) :=
  (m14InstitutionalAuthorityKernelEscapeAt oldVisit sourceIndex boundary
    ).not_factorsThrough

/-- The independent readout is grounded by the same source span, actual paid
U8, and full admission that generated the new platform channel. -/
theorem m14InstitutionalAuthorityConsumer_grounded
    (oldVisit : ProcessGame.Society.M14SourceGeneratedContributionMergeActionSource.OldVisit)
    (sourceIndex boundary : Nat) :
    type_of% (sourceGeneratedM14InstitutionalSpan_directConsumer oldVisit
      sourceIndex boundary) ∧
      type_of% (sourceGeneratedM14InstitutionalPaidU8_directConsumer oldVisit
        sourceIndex boundary) ∧
      type_of% (sourceGeneratedM14InstitutionalFullAdmission_directConsumer
        oldVisit sourceIndex boundary) ∧
      Function.Injective
        (m14InstitutionalAuthorityReadAt oldVisit sourceIndex boundary) ∧
      type_of% (m14InstitutionalAuthorityKernelEscapeAt oldVisit sourceIndex
        boundary) :=
  ⟨sourceGeneratedM14InstitutionalSpan_directConsumer oldVisit sourceIndex
      boundary,
    sourceGeneratedM14InstitutionalPaidU8_directConsumer oldVisit sourceIndex
      boundary,
    sourceGeneratedM14InstitutionalFullAdmission_directConsumer oldVisit
      sourceIndex boundary,
    m14InstitutionalAuthorityRead_injective oldVisit sourceIndex boundary,
    m14InstitutionalAuthorityKernelEscapeAt oldVisit sourceIndex boundary⟩

end
