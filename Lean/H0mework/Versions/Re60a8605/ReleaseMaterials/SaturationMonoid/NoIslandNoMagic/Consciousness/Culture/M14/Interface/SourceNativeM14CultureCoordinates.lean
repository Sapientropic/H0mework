open M14ProofCarryingActualRelationThreeCycleResidual
open M14SourceGeneratedActualRelationRoleReflexiveRing
open M14SourceGeneratedActualRelationCycleMemoryWitnessPublication
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Beauty.SharedKernel
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Culture.M14.Communication

noncomputable section

/-! ## Exact downstream two-point occurrence -/

/-- The Boolean is only the exact finite restriction generated by the
source-witness refinement. -/
abbrev M14CultureOccurrenceAt (_base : Nat) := Bool

def sourceM14CultureDepthAt
    (base : Nat) (occurrence : M14CultureOccurrenceAt base) : Nat :=
  (cycleMemoryKernelRefinementAt base).exactOccurrence occurrence

@[simp] theorem sourceM14CultureDepthAt_true (base : Nat) :
    sourceM14CultureDepthAt base true = base + 3 :=
  rfl

@[simp] theorem sourceM14CultureDepthAt_false (base : Nat) :
    sourceM14CultureDepthAt base false = base :=
  rfl

def sourceM14CulturePublicationRead
    (base : Nat) (occurrence : M14CultureOccurrenceAt base) : Bool :=
  (cycleMemoryPublicationAt base).publicationTag
    (sourceM14CultureDepthAt base occurrence)

/-- Honest publication recovers the downstream two-point side; the side is
not supplied to a separate replay classifier. -/
@[simp] theorem sourceM14CulturePublicationRead_exact
    (base : Nat) (occurrence : M14CultureOccurrenceAt base) :
    sourceM14CulturePublicationRead base occurrence = occurrence := by
  exact (cycleMemoryKernelRefinementAt base).twoPointObserver_forget occurrence

theorem sourceM14CulturePublicationRead_true_ne_false (base : Nat) :
    sourceM14CulturePublicationRead base true ≠
      sourceM14CulturePublicationRead base false := by
  simpa only [sourceM14CulturePublicationRead_exact] using
    (by decide : true ≠ false)

/-! ## Naming, member evaluation, and the joint kernel bundle -/

structure M14CultureNamingReadout : Type where
  actor : essentialAccessRelationCompiler.Actor

structure M14CultureMemberEvaluationReadout : Type where
  score : Int

def sourceM14CultureNamingRead
    (base : Nat) (occurrence : M14CultureOccurrenceAt base) :
    M14CultureNamingReadout where
  actor := actualRelationActorAt (sourceM14CultureDepthAt base occurrence)

def sourceM14CultureMemberEvaluationRead
    (base : Nat) (member : ThreeCycleTime)
    (occurrence : M14CultureOccurrenceAt base) :
    M14CultureMemberEvaluationReadout where
  score := actualRelationIncomingRoleReadAt base member
    (actualRelationTargetRoleAt
      (sourceM14CultureDepthAt base occurrence))

/-- All local evaluation restrictions share the exact action-occurrence
authority generated by the original cross runtime. -/
def m14CultureObserverFamilyAt (base : Nat) :
    CommonAuthorityObserverFamily Nat AnyAuthoritativeRootCurrent where
  Member := ThreeCycleTime
  Visible := fun _ => M14CultureMemberEvaluationReadout
  forget := fun member depth =>
    ⟨actualRelationIncomingRoleReadAt base member
      (actualRelationTargetRoleAt depth)⟩
  authorityK := cycleMemoryAuthorityObserver.authorityK
  positive := ⟨.t0⟩

abbrev M14CultureJointKernelBundleReadoutAt (base : Nat) :=
  (m14CultureObserverFamilyAt base).JointVisible

def sourceM14CultureJointKernelBundleRead
    (base : Nat) (occurrence : M14CultureOccurrenceAt base) :
    M14CultureJointKernelBundleReadoutAt base :=
  (m14CultureObserverFamilyAt base).jointForget
    (sourceM14CultureDepthAt base occurrence)

theorem actualRelationTargetRole_add_three_eq (base : Nat) :
    actualRelationTargetRoleAt (base + 3) =
      actualRelationTargetRoleAt base := by
  unfold actualRelationTargetRoleAt actualRelationAt
  rw [(sourceGeneratedActualRelationThreeCycleAt base).seedClosure]

theorem sourceM14CultureNamingRead_true_eq_false (base : Nat) :
    sourceM14CultureNamingRead base true =
      sourceM14CultureNamingRead base false := by
  exact congrArg M14CultureNamingReadout.mk
    (sourceGeneratedActualRelationThreeCycleAt base).actorClosure

theorem sourceM14CultureMemberEvaluationRead_true_eq_false
    (base : Nat) (member : ThreeCycleTime) :
    sourceM14CultureMemberEvaluationRead base member true =
      sourceM14CultureMemberEvaluationRead base member false := by
  exact congrArg M14CultureMemberEvaluationReadout.mk <|
    congrArg (actualRelationIncomingRoleReadAt base member)
      (actualRelationTargetRole_add_three_eq base)

theorem sourceM14CultureJointKernelBundleRead_true_eq_false
    (base : Nat) :
    sourceM14CultureJointKernelBundleRead base true =
      sourceM14CultureJointKernelBundleRead base false := by
  funext member
  exact sourceM14CultureMemberEvaluationRead_true_eq_false base member

/-! ## Publication-generated transmission replay -/

def m14CultureEmptyReplayPathAt (base : Nat) :
    SourceOwnedTransportPath (M14CultureCommunicationAt base) .t0 .t0 :=
  @SourceOwnedTransportPath.nil (M14CultureWorldAt base)
    (M14CultureCommunicationAt base) ThreeCycleTime.t0

def sourceM14CultureReplayPathAt
    (base : Nat) (occurrence : M14CultureOccurrenceAt base) :
    SourceOwnedTransportPath (M14CultureCommunicationAt base) .t0 .t0 :=
  if sourceM14CulturePublicationRead base occurrence then
    m14CultureCyclePathAt base
  else
    m14CultureEmptyReplayPathAt base

def sourceM14CultureReplayDeliveryAt
    (base : Nat) (occurrence : M14CultureOccurrenceAt base) :
    GeneratedDeliveryAt (M14CultureCommunicationAt base)
      (m14CultureOperationalSourcesAt base) .t0 .t0 where
  path := sourceM14CultureReplayPathAt base occurrence

def m14CultureContactEventSupport
    {base : Nat} (event : SourceGeneratedM14CultureContactEventAt base) :
    ThreeCycleTime :=
  event.support

def m14CultureCycleSupportTraceAt (base : Nat) : List ThreeCycleTime :=
  (m14CultureCyclePathAt base).events.map m14CultureContactEventSupport

def sourceM14CultureTransmissionSupportTraceRead
    (base : Nat) (occurrence : M14CultureOccurrenceAt base) :
    List ThreeCycleTime :=
  (sourceM14CultureReplayPathAt base occurrence).events.map
    m14CultureContactEventSupport

structure M14CultureTransmissionReplayReadout : Type where
  publication : Bool
  supportTrace : List ThreeCycleTime

def sourceM14CultureTransmissionReplayRead
    (base : Nat) (occurrence : M14CultureOccurrenceAt base) :
    M14CultureTransmissionReplayReadout where
  publication := sourceM14CulturePublicationRead base occurrence
  supportTrace :=
    sourceM14CultureTransmissionSupportTraceRead base occurrence

@[simp] theorem m14CultureCycleSupportTraceAt_exact (base : Nat) :
    m14CultureCycleSupportTraceAt base = [.t0, .t1, .t2] := by
  unfold m14CultureCycleSupportTraceAt
  rw [m14CultureCyclePath_events_exact]
  rfl

@[simp] theorem sourceM14CultureReplayPathAt_false (base : Nat) :
    sourceM14CultureReplayPathAt base false =
      m14CultureEmptyReplayPathAt base := by
  simp [sourceM14CultureReplayPathAt]

@[simp] theorem sourceM14CultureReplayPathAt_true (base : Nat) :
    sourceM14CultureReplayPathAt base true =
      m14CultureCyclePathAt base := by
  simp [sourceM14CultureReplayPathAt]

@[simp] theorem sourceM14CultureTransmissionSupportTraceRead_false
    (base : Nat) :
    sourceM14CultureTransmissionSupportTraceRead base false = [] := by
  unfold sourceM14CultureTransmissionSupportTraceRead
  rw [sourceM14CultureReplayPathAt_false]
  rfl

@[simp] theorem sourceM14CultureTransmissionSupportTraceRead_true
    (base : Nat) :
    sourceM14CultureTransmissionSupportTraceRead base true =
      [.t0, .t1, .t2] := by
  rw [sourceM14CultureTransmissionSupportTraceRead,
    sourceM14CultureReplayPathAt_true]
  exact m14CultureCycleSupportTraceAt_exact base

theorem sourceM14CultureTransmissionSupportTraceRead_injective
    (base : Nat) :
    Function.Injective
      (sourceM14CultureTransmissionSupportTraceRead base) := by
  intro left right traceEq
  cases left <;> cases right
  · rfl
  · have lengthEq := congrArg List.length traceEq
    simp at lengthEq
  · have lengthEq := congrArg List.length traceEq
    simp at lengthEq
  · rfl

/-- Stable short name for downstream consumer files.  Its proof is the
`[]` versus generated three-support trace argument above, not inversion of
the publication bit. -/
abbrev m14CultureTransmissionTraceRead :=
  sourceM14CultureTransmissionSupportTraceRead

theorem m14CultureTransmissionTraceRead_injective (base : Nat) :
    Function.Injective (m14CultureTransmissionTraceRead base) :=
  sourceM14CultureTransmissionSupportTraceRead_injective base

theorem sourceM14CultureTransmissionSupportTraceRead_true_ne_false
    (base : Nat) :
    sourceM14CultureTransmissionSupportTraceRead base true ≠
      sourceM14CultureTransmissionSupportTraceRead base false := by
  intro equality
  exact (by decide : true ≠ false)
    (sourceM14CultureTransmissionSupportTraceRead_injective base equality)

/-! ## Gluing residual and H¹ availability code -/

structure M14CultureGluingReadout : Type where
  residual : Int
  hasH1 : Bool

def sourceM14CultureGluingRead
    (base : Nat) (occurrence : M14CultureOccurrenceAt base) :
    M14CultureGluingReadout :=
  if sourceM14CulturePublicationRead base occurrence then
    ⟨threeAgentRingResidual (actualRelationCycleCochain base), true⟩
  else
    ⟨0, false⟩

@[simp] theorem sourceM14CultureGluingRead_false (base : Nat) :
    sourceM14CultureGluingRead base false = ⟨0, false⟩ := by
  simp [sourceM14CultureGluingRead]

@[simp] theorem sourceM14CultureGluingRead_true (base : Nat) :
    sourceM14CultureGluingRead base true = ⟨3, true⟩ := by
  simp [sourceM14CultureGluingRead,
    actualRelationCycle_residual_eq_three]

theorem sourceM14CultureGluingRead_true_ne_false (base : Nat) :
    sourceM14CultureGluingRead base true ≠
      sourceM14CultureGluingRead base false := by
  intro equality
  have residualEquality := congrArg M14CultureGluingReadout.residual equality
  rw [sourceM14CultureGluingRead_true,
    sourceM14CultureGluingRead_false] at residualEquality
  norm_num at residualEquality

theorem sourceM14CultureGluingRead_true_h1_grounded (base : Nat) :
    CechAdditiveCover.H1Obstruction
      (identityPairZeroTripleCover ThreeCycleTime Int)
      (actualRelationCycleCochain base) :=
  actualRelationCycle_nontrivial_h1 base

/-! ## Practice medium and target evaluation -/

structure M14CulturePracticeMediumReadout : Type where
  medium : EssentialAccessRole
  effect : Int

def sourceM14CulturePracticeMediumRead
    (base : Nat) (occurrence : M14CultureOccurrenceAt base) :
    M14CulturePracticeMediumReadout where
  medium := (sourceM14CultureReplayDeliveryAt base occurrence
    ).targetObservation
  effect := show Int from
    (sourceM14CultureReplayDeliveryAt base occurrence).effect

theorem sourceM14CulturePracticeMediumRead_medium_exact
    (base : Nat) (occurrence : M14CultureOccurrenceAt base) :
    (sourceM14CulturePracticeMediumRead base occurrence).medium =
      actualRelationCycleTargetRoleAt base .t2 := by
  change (sourceM14CultureReplayDeliveryAt base occurrence).targetValue.1 = _
  exact (sourceM14CultureReplayDeliveryAt base occurrence
    ).targetValue.property

theorem sourceM14CulturePracticeMediumRead_effect_eq_one
    (base : Nat) (occurrence : M14CultureOccurrenceAt base) :
    (sourceM14CulturePracticeMediumRead base occurrence).effect = 1 := by
  change actualRelationIncomingRoleReadAt base .t0
    (sourceM14CultureReplayDeliveryAt base occurrence).targetValue.1 = 1
  rw [(sourceM14CultureReplayDeliveryAt base occurrence).targetValue.property]
  exact
    (actualRelationIncomingRoleReadAt_target_eq_one_iff
      base .t2 .t0).2 rfl

theorem sourceM14CulturePracticeMediumRead_true_eq_false (base : Nat) :
    sourceM14CulturePracticeMediumRead base true =
      sourceM14CulturePracticeMediumRead base false := by
  exact congrArg₂ M14CulturePracticeMediumReadout.mk
    ((sourceM14CulturePracticeMediumRead_medium_exact base true).trans
      (sourceM14CulturePracticeMediumRead_medium_exact base false).symm)
    ((sourceM14CulturePracticeMediumRead_effect_eq_one base true).trans
      (sourceM14CulturePracticeMediumRead_effect_eq_one base false).symm)

/-! ## Low-universe shared-lineage code and exact authority recovery -/

structure M14CultureSharedLineageReadout : Type where
  seed : ExactRelationSeed
  actor : essentialAccessRelationCompiler.Actor
  publication : Bool
  actionOccurrenceKDepth : Nat

namespace M14CultureSharedLineageReadout

/-- Recover the literal source action-occurrence authority from the low
depth code. -/
def actionOccurrenceK (lineage : M14CultureSharedLineageReadout) :
    AnyAuthoritativeRootCurrent :=
  cycleMemoryAuthorityObserver.authorityK lineage.actionOccurrenceKDepth

end M14CultureSharedLineageReadout

def sourceM14CultureSharedLineageRead
    (base : Nat) (occurrence : M14CultureOccurrenceAt base) :
    M14CultureSharedLineageReadout where
  seed := actualRelationSeedAt (sourceM14CultureDepthAt base occurrence)
  actor := actualRelationActorAt (sourceM14CultureDepthAt base occurrence)
  publication := sourceM14CulturePublicationRead base occurrence
  actionOccurrenceKDepth := sourceM14CultureDepthAt base occurrence

@[simp] theorem sourceM14CultureSharedLineageRead_actionOccurrenceK_exact
    (base : Nat) (occurrence : M14CultureOccurrenceAt base) :
    (sourceM14CultureSharedLineageRead base occurrence).actionOccurrenceK =
      cycleMemoryAuthorityObserver.authorityK
        (sourceM14CultureDepthAt base occurrence) :=
  rfl

theorem sourceM14CultureSharedLineageRead_seed_true_eq_false
    (base : Nat) :
    (sourceM14CultureSharedLineageRead base true).seed =
      (sourceM14CultureSharedLineageRead base false).seed :=
  (sourceGeneratedActualRelationThreeCycleAt base).seedClosure

theorem sourceM14CultureSharedLineageRead_actor_true_eq_false
    (base : Nat) :
    (sourceM14CultureSharedLineageRead base true).actor =
      (sourceM14CultureSharedLineageRead base false).actor :=
  (sourceGeneratedActualRelationThreeCycleAt base).actorClosure

theorem sourceM14CultureSharedLineageRead_actionOccurrenceK_true_ne_false
    (base : Nat) :
    (sourceM14CultureSharedLineageRead base true).actionOccurrenceK ≠
      (sourceM14CultureSharedLineageRead base false).actionOccurrenceK := by
  exact (cycleMemoryKernelPairAt base).authority_ne

/-! ## Grounding mouths for independent downstream consumers -/

theorem sourceM14CultureTransmissionReplay_grounded (base : Nat) :
    type_of%
        (sourceGeneratedM14ActualRelationCultureNetwork_directConsumer base) ∧
      type_of% (m14CultureCyclePath_events_exact base) ∧
      (∀ occurrence,
        sourceM14CulturePublicationRead base occurrence = occurrence) ∧
      sourceM14CultureTransmissionSupportTraceRead base false = [] ∧
      sourceM14CultureTransmissionSupportTraceRead base true =
        [.t0, .t1, .t2] :=
  ⟨sourceGeneratedM14ActualRelationCultureNetwork_directConsumer base,
    m14CultureCyclePath_events_exact base,
    sourceM14CulturePublicationRead_exact base,
    sourceM14CultureTransmissionSupportTraceRead_false base,
    sourceM14CultureTransmissionSupportTraceRead_true base⟩

theorem sourceM14CulturePublicationRefinement_grounded (base : Nat) :
    type_of% (cycleMemoryKernelRefinementAt base) ∧
      (∀ occurrence,
        sourceM14CulturePublicationRead base occurrence = occurrence) :=
  ⟨cycleMemoryKernelRefinementAt base,
    sourceM14CulturePublicationRead_exact base⟩

theorem sourceM14CultureKernelBundle_grounded (base : Nat) :
    (∀ member,
        sourceM14CultureMemberEvaluationRead base member true =
          sourceM14CultureMemberEvaluationRead base member false) ∧
      sourceM14CultureJointKernelBundleRead base true =
        sourceM14CultureJointKernelBundleRead base false ∧
      (sourceM14CultureSharedLineageRead base true).actionOccurrenceK ≠
        (sourceM14CultureSharedLineageRead base false).actionOccurrenceK :=
  ⟨sourceM14CultureMemberEvaluationRead_true_eq_false base,
    sourceM14CultureJointKernelBundleRead_true_eq_false base,
    sourceM14CultureSharedLineageRead_actionOccurrenceK_true_ne_false base⟩

theorem sourceM14CultureGluing_grounded (base : Nat) :
    sourceM14CultureGluingRead base false = ⟨0, false⟩ ∧
      sourceM14CultureGluingRead base true = ⟨3, true⟩ ∧
      sourceM14CultureGluingRead base true ≠
        sourceM14CultureGluingRead base false ∧
      CechAdditiveCover.H1Obstruction
        (identityPairZeroTripleCover ThreeCycleTime Int)
        (actualRelationCycleCochain base) :=
  ⟨sourceM14CultureGluingRead_false base,
    sourceM14CultureGluingRead_true base,
    sourceM14CultureGluingRead_true_ne_false base,
    sourceM14CultureGluingRead_true_h1_grounded base⟩

/-- Stable C1 source mouth for the observer-kernel coordinate. -/
theorem sourceGeneratedM14CultureObserverKernelBundle_directConsumer
    (base : Nat) :
    type_of% (actualRelationThreeCycle_directConsumer base) ∧
      type_of% (sourceM14CultureKernelBundle_grounded base) :=
  ⟨actualRelationThreeCycle_directConsumer base,
    sourceM14CultureKernelBundle_grounded base⟩

/-- Stable C1 source mouth for the exact gluing residual coordinate. -/
theorem sourceGeneratedM14CultureGluingResidual_directConsumer
    (base : Nat) :
    type_of% (actualRelationThreeCycleResidual_directConsumer base) ∧
      type_of% (sourceM14CultureGluing_grounded base) :=
  ⟨actualRelationThreeCycleResidual_directConsumer base,
    sourceM14CultureGluing_grounded base⟩

/-- Stable C1 source mouth for honest cycle-memory publication. -/
theorem sourceGeneratedM14CulturePublication_directConsumer
    (base : Nat) :
    type_of% (cycleMemoryKernelRefinementAt base) ∧
      type_of% (sourceM14CulturePublicationRefinement_grounded base) :=
  ⟨cycleMemoryKernelRefinementAt base,
    sourceM14CulturePublicationRefinement_grounded base⟩

theorem sourceM14CultureSameNamingEvaluationPractice_differentTraceAndK
    (base : Nat) :
    sourceM14CultureNamingRead base true =
        sourceM14CultureNamingRead base false ∧
      (∀ member,
        sourceM14CultureMemberEvaluationRead base member true =
          sourceM14CultureMemberEvaluationRead base member false) ∧
      sourceM14CultureJointKernelBundleRead base true =
        sourceM14CultureJointKernelBundleRead base false ∧
      sourceM14CulturePracticeMediumRead base true =
        sourceM14CulturePracticeMediumRead base false ∧
      sourceM14CultureTransmissionSupportTraceRead base true ≠
        sourceM14CultureTransmissionSupportTraceRead base false ∧
      (sourceM14CultureSharedLineageRead base true).actionOccurrenceK ≠
        (sourceM14CultureSharedLineageRead base false).actionOccurrenceK :=
  ⟨sourceM14CultureNamingRead_true_eq_false base,
    sourceM14CultureMemberEvaluationRead_true_eq_false base,
    sourceM14CultureJointKernelBundleRead_true_eq_false base,
    sourceM14CulturePracticeMediumRead_true_eq_false base,
    sourceM14CultureTransmissionSupportTraceRead_true_ne_false base,
    sourceM14CultureSharedLineageRead_actionOccurrenceK_true_ne_false base⟩

