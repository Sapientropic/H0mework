noncomputable section

/-! ## Exact route root at the refusal target Payment depth -/

def m14UrbanDepthAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) : Nat :=
  m14StructuralClassPriceDepthAt oldVisit sourceIndex boundary

def m14UrbanRouteRestorationAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    SourceGeneratedPeriodicRouteOutageRestorationAt
      (m14UrbanDepthAt oldVisit sourceIndex boundary) :=
  sourceGeneratedPeriodicRouteOutageRestorationAt
    (m14UrbanDepthAt oldVisit sourceIndex boundary)

@[simp] theorem m14UrbanDepth_eq_refusalTargetDepth
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    m14UrbanDepthAt oldVisit sourceIndex boundary =
      m14StructuralClassPriceDepthAt oldVisit sourceIndex boundary :=
  rfl

theorem m14UrbanRouteRoot_eq_refusalTargetPaymentRoot
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (m14UrbanRouteRestorationAt oldVisit sourceIndex boundary).rootOccurrence =
      (m14StructuralClassPriceTargetPaymentAt oldVisit sourceIndex boundary
        ).rootOccurrence := by
  exact (m14UrbanRouteRestorationAt oldVisit sourceIndex boundary
    ).rootOccurrenceExact.trans
      (m14StructuralClassPriceTargetPayment_rootExact oldVisit sourceIndex
        boundary).symm

theorem m14UrbanRoutePayment_eq_periodic
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    m14StructuralClassPriceTargetPaymentAt oldVisit sourceIndex boundary =
      periodicSourceBackedPaymentAt
        (m14UrbanDepthAt oldVisit sourceIndex boundary) :=
  m14StructuralClassPriceTargetPayment_eq_periodic oldVisit sourceIndex
    boundary

/-! ## Same-route blocked/restored dependent occurrences -/

structure M14UrbanBlockedRouteAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) : Type 18 where
  private mk ::
  rootOccurrence : type_of%
    (m14UrbanRouteRestorationAt oldVisit sourceIndex boundary).rootOccurrence
  rootOccurrenceExact : rootOccurrence =
    (m14UrbanRouteRestorationAt oldVisit sourceIndex boundary).rootOccurrence
  crossing : ConcreteCrossing
  crossingExact : crossing = routeRestorationTargetCrossingAt
    (m14UrbanDepthAt oldVisit sourceIndex boundary)
  routeMissing : IsEmpty
    (RouteOutageRoutesAt ExitFutureCode.leave crossing)

def m14UrbanBlockedRouteAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    M14UrbanBlockedRouteAt oldVisit sourceIndex boundary :=
  let restoration := m14UrbanRouteRestorationAt oldVisit sourceIndex boundary
  { rootOccurrence := restoration.rootOccurrence
    rootOccurrenceExact := rfl
    crossing := routeRestorationTargetCrossingAt
      (m14UrbanDepthAt oldVisit sourceIndex boundary)
    crossingExact := rfl
    routeMissing := restoration.sourceRouteMissing _ }

structure M14UrbanRestoredRouteAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) : Type 18 where
  private mk ::
  rootOccurrence : type_of%
    (m14UrbanRouteRestorationAt oldVisit sourceIndex boundary).rootOccurrence
  rootOccurrenceExact : rootOccurrence =
    (m14UrbanRouteRestorationAt oldVisit sourceIndex boundary).rootOccurrence
  crossing : ConcreteCrossing
  crossingExact : crossing = routeRestorationTargetCrossingAt
    (m14UrbanDepthAt oldVisit sourceIndex boundary)
  routeReceipt : SourceGeneratedUBIRouteReceiptAt ExitFutureCode.leave crossing
  feasibleExit : ExactFeasibleExitEdgeAt
    (geometryCompilerAt (m14UrbanDepthAt oldVisit sourceIndex boundary + 1))
    ExitFutureCode.leave
      (firstSlotAt (m14UrbanDepthAt oldVisit sourceIndex boundary + 1))
  capacityExact :
    (geometryCompilerAt (m14UrbanDepthAt oldVisit sourceIndex boundary + 1)
      ).actionableExitCapacity = 1

def m14UrbanRestoredRouteAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    M14UrbanRestoredRouteAt oldVisit sourceIndex boundary :=
  let restoration := m14UrbanRouteRestorationAt oldVisit sourceIndex boundary
  { rootOccurrence := restoration.rootOccurrence
    rootOccurrenceExact := rfl
    crossing := routeRestorationTargetCrossingAt
      (m14UrbanDepthAt oldVisit sourceIndex boundary)
    crossingExact := rfl
    routeReceipt := restoration.targetRouteReceipt
    feasibleExit := restoration.targetFeasibleExit
    capacityExact := restoration.targetCapacityExact }

abbrev M14UrbanSpatialCarrier := ConcreteCrossing × Option Nat

/-- Low-universe blocked restriction.  High root/route authority appears only
as proposition-valued source indices and is not stored in the face carrier. -/
abbrev M14UrbanBlockedOccurrenceAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :=
  { occurrence : M14UrbanSpatialCarrier //
    occurrence =
        (routeRestorationTargetCrossingAt
          (m14UrbanDepthAt oldVisit sourceIndex boundary), none) ∧
      IsEmpty (RouteOutageRoutesAt ExitFutureCode.leave occurrence.1) ∧
      (m14UrbanRouteRestorationAt oldVisit sourceIndex boundary
        ).rootOccurrence =
        (m14StructuralClassPriceTargetPaymentAt oldVisit sourceIndex boundary
          ).rootOccurrence }

/-- Low-universe restored restriction generated by the same route root. -/
abbrev M14UrbanRestoredOccurrenceAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :=
  { occurrence : M14UrbanSpatialCarrier //
    occurrence =
        (routeRestorationTargetCrossingAt
          (m14UrbanDepthAt oldVisit sourceIndex boundary), some 1) ∧
      Nonempty (SourceGeneratedUBIRouteReceiptAt ExitFutureCode.leave
        occurrence.1) ∧
      Nonempty (ExactFeasibleExitEdgeAt
        (geometryCompilerAt
          (m14UrbanDepthAt oldVisit sourceIndex boundary + 1))
        ExitFutureCode.leave
          (firstSlotAt
            (m14UrbanDepthAt oldVisit sourceIndex boundary + 1))) ∧
      (geometryCompilerAt
        (m14UrbanDepthAt oldVisit sourceIndex boundary + 1)
        ).actionableExitCapacity = 1 ∧
      (m14UrbanRouteRestorationAt oldVisit sourceIndex boundary
        ).rootOccurrence =
        (m14StructuralClassPriceTargetPaymentAt oldVisit sourceIndex boundary
          ).rootOccurrence }

abbrev M14UrbanSpatialOccurrenceAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :=
  M14UrbanBlockedOccurrenceAt oldVisit sourceIndex boundary ⊕
    M14UrbanRestoredOccurrenceAt oldVisit sourceIndex boundary

def m14UrbanBlockedOccurrenceAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    M14UrbanSpatialOccurrenceAt oldVisit sourceIndex boundary :=
  let restoration := m14UrbanRouteRestorationAt oldVisit sourceIndex boundary
  .inl ⟨(routeRestorationTargetCrossingAt
      (m14UrbanDepthAt oldVisit sourceIndex boundary), none),
    rfl,
    restoration.sourceRouteMissing _,
    m14UrbanRouteRoot_eq_refusalTargetPaymentRoot oldVisit sourceIndex
      boundary⟩

def m14UrbanRestoredOccurrenceAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    M14UrbanSpatialOccurrenceAt oldVisit sourceIndex boundary :=
  let restoration := m14UrbanRouteRestorationAt oldVisit sourceIndex boundary
  .inr ⟨(routeRestorationTargetCrossingAt
      (m14UrbanDepthAt oldVisit sourceIndex boundary), some 1),
    rfl,
    ⟨restoration.targetRouteReceipt⟩,
    ⟨restoration.targetFeasibleExit⟩,
    restoration.targetCapacityExact,
    m14UrbanRouteRoot_eq_refusalTargetPaymentRoot oldVisit sourceIndex
      boundary⟩

def m14UrbanCrossingReadAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat} :
    M14UrbanSpatialOccurrenceAt oldVisit sourceIndex boundary →
      ConcreteCrossing
  | .inl occurrence => occurrence.1.1
  | .inr occurrence => occurrence.1.1

theorem m14UrbanBlockedRestored_sameRouteOccurrence
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (m14UrbanBlockedRouteAt oldVisit sourceIndex boundary).rootOccurrence =
      (m14UrbanRestoredRouteAt oldVisit sourceIndex boundary).rootOccurrence ∧
    (m14UrbanBlockedRouteAt oldVisit sourceIndex boundary).crossing =
      (m14UrbanRestoredRouteAt oldVisit sourceIndex boundary).crossing :=
  ⟨rfl, rfl⟩

theorem m14UrbanSpatialOccurrences_sameRootAndCrossing
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (m14UrbanRouteRestorationAt oldVisit sourceIndex boundary).rootOccurrence =
        (m14StructuralClassPriceTargetPaymentAt oldVisit sourceIndex boundary
          ).rootOccurrence ∧
      m14UrbanCrossingReadAt
          (m14UrbanBlockedOccurrenceAt oldVisit sourceIndex boundary) =
        m14UrbanCrossingReadAt
          (m14UrbanRestoredOccurrenceAt oldVisit sourceIndex boundary) :=
  ⟨m14UrbanRouteRoot_eq_refusalTargetPaymentRoot oldVisit sourceIndex boundary,
    rfl⟩

/-! ## Independent Type-0 spatial reads -/

/-- Proof-bearing route accessibility.  A constructor cannot be produced from
the local occurrence tag alone: it carries the exact empty fibre or generated
route receipt for the same crossing. -/
inductive M14UrbanAccessibilityReadout : Type
  | blocked (crossing : ConcreteCrossing)
      (routeMissing : IsEmpty
        (RouteOutageRoutesAt ExitFutureCode.leave crossing))
  | restored (crossing : ConcreteCrossing)
      (routeReceipt : Nonempty
        (SourceGeneratedUBIRouteReceiptAt ExitFutureCode.leave crossing))

/-- `none` means the exact route fibre is empty; `some n` means a generated
route receipt and feasible edge expose the target actionable capacity `n`. -/
abbrev M14UrbanCapacityReadout := Option Nat

def m14UrbanAccessibilityReadAt
  {oldVisit : OldVisit} {sourceIndex boundary : Nat} :
    M14UrbanSpatialOccurrenceAt oldVisit sourceIndex boundary →
      M14UrbanAccessibilityReadout
  | .inl occurrence =>
      .blocked occurrence.1.1 occurrence.property.2.1
  | .inr occurrence =>
      .restored occurrence.1.1 occurrence.property.2.1

def m14UrbanCapacityReadAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat} :
    M14UrbanSpatialOccurrenceAt oldVisit sourceIndex boundary →
      M14UrbanCapacityReadout
  | .inl occurrence => occurrence.1.2
  | .inr occurrence => occurrence.1.2

theorem m14UrbanSpatialRead_sourceExact
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (∃ routeMissing : IsEmpty (RouteOutageRoutesAt ExitFutureCode.leave
        (m14UrbanCrossingReadAt
          (m14UrbanBlockedOccurrenceAt oldVisit sourceIndex boundary))),
      m14UrbanAccessibilityReadAt
          (m14UrbanBlockedOccurrenceAt oldVisit sourceIndex boundary) =
        .blocked
          (m14UrbanCrossingReadAt
            (m14UrbanBlockedOccurrenceAt oldVisit sourceIndex boundary))
          routeMissing) ∧
      (∃ routeReceipt : Nonempty
          (SourceGeneratedUBIRouteReceiptAt ExitFutureCode.leave
            (m14UrbanCrossingReadAt
              (m14UrbanRestoredOccurrenceAt oldVisit sourceIndex boundary))),
        m14UrbanAccessibilityReadAt
            (m14UrbanRestoredOccurrenceAt oldVisit sourceIndex boundary) =
          .restored
            (m14UrbanCrossingReadAt
              (m14UrbanRestoredOccurrenceAt oldVisit sourceIndex boundary))
            routeReceipt) ∧
      m14UrbanCapacityReadAt
          (m14UrbanBlockedOccurrenceAt oldVisit sourceIndex boundary) = none ∧
      m14UrbanCapacityReadAt
          (m14UrbanRestoredOccurrenceAt oldVisit sourceIndex boundary) =
            some 1 ∧
      IsEmpty (RouteOutageRoutesAt ExitFutureCode.leave
        (m14UrbanCrossingReadAt
          (m14UrbanBlockedOccurrenceAt oldVisit sourceIndex boundary))) ∧
      Nonempty (SourceGeneratedUBIRouteReceiptAt ExitFutureCode.leave
        (m14UrbanCrossingReadAt
          (m14UrbanRestoredOccurrenceAt oldVisit sourceIndex boundary))) := by
  let restoration := m14UrbanRouteRestorationAt oldVisit sourceIndex boundary
  exact ⟨⟨_, rfl⟩, ⟨_, rfl⟩, rfl, rfl,
    restoration.sourceRouteMissing _, ⟨restoration.targetRouteReceipt⟩⟩

theorem m14UrbanAccessibilityRead_injective
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    Function.Injective
      (m14UrbanAccessibilityReadAt (oldVisit := oldVisit)
        (sourceIndex := sourceIndex) (boundary := boundary)) := by
  intro left right sameRead
  cases left with
  | inl leftBlocked =>
      cases right with
      | inl rightBlocked =>
          apply congrArg Sum.inl
          apply Subtype.ext
          exact leftBlocked.property.1.trans rightBlocked.property.1.symm
      | inr rightRestored =>
          cases sameRead
  | inr leftRestored =>
      cases right with
      | inl rightBlocked =>
          cases sameRead
      | inr rightRestored =>
          apply congrArg Sum.inr
          apply Subtype.ext
          exact leftRestored.property.1.trans rightRestored.property.1.symm

theorem m14UrbanCapacityRead_injective
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    Function.Injective
      (m14UrbanCapacityReadAt (oldVisit := oldVisit)
        (sourceIndex := sourceIndex) (boundary := boundary)) := by
  intro left right sameRead
  cases left with
  | inl leftBlocked =>
      cases right with
      | inl rightBlocked =>
          exact congrArg Sum.inl (Subtype.ext
            (leftBlocked.property.1.trans rightBlocked.property.1.symm))
      | inr rightRestored =>
          have leftCode := congrArg Prod.snd leftBlocked.property.1
          have rightCode := congrArg Prod.snd rightRestored.property.1
          have impossible : (none : Option Nat) = some 1 :=
            leftCode.symm.trans (sameRead.trans rightCode)
          cases impossible
  | inr leftRestored =>
      cases right with
      | inl rightBlocked =>
          have leftCode := congrArg Prod.snd leftRestored.property.1
          have rightCode := congrArg Prod.snd rightBlocked.property.1
          have impossible : (none : Option Nat) = some 1 :=
            rightCode.symm.trans (sameRead.symm.trans leftCode)
          cases impossible
      | inr rightRestored =>
          exact congrArg Sum.inr (Subtype.ext
            (leftRestored.property.1.trans rightRestored.property.1.symm))

theorem m14UrbanSpatialRead_blocked_ne_restored
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    m14UrbanAccessibilityReadAt
        (m14UrbanBlockedOccurrenceAt oldVisit sourceIndex boundary) ≠
      m14UrbanAccessibilityReadAt
        (m14UrbanRestoredOccurrenceAt oldVisit sourceIndex boundary) ∧
      m14UrbanCapacityReadAt
          (m14UrbanBlockedOccurrenceAt oldVisit sourceIndex boundary) ≠
        m14UrbanCapacityReadAt
          (m14UrbanRestoredOccurrenceAt oldVisit sourceIndex boundary) := by
  let exactRead := m14UrbanSpatialRead_sourceExact oldVisit sourceIndex
    boundary
  constructor
  · intro sameRead
    cases sameRead
  · intro sameRead
    have impossible : (none : Option Nat) = some 1 :=
      exactRead.2.2.1.symm.trans
        (sameRead.trans exactRead.2.2.2.1)
    cases impossible

/-! ## Source token and direct consumer -/

inductive SourceGeneratedM14UrbanSpatialCoordinatesAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) : Type 20
  | private generated

def sourceGeneratedM14UrbanSpatialCoordinatesAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    SourceGeneratedM14UrbanSpatialCoordinatesAt oldVisit sourceIndex boundary :=
  .generated

namespace SourceGeneratedM14UrbanSpatialCoordinatesAt

variable {oldVisit : OldVisit} {sourceIndex boundary : Nat}

def restoration
    (source : SourceGeneratedM14UrbanSpatialCoordinatesAt oldVisit sourceIndex
      boundary) : SourceGeneratedPeriodicRouteOutageRestorationAt
        (m14UrbanDepthAt oldVisit sourceIndex boundary) := by
  cases source
  exact m14UrbanRouteRestorationAt oldVisit sourceIndex boundary

def blocked
    (source : SourceGeneratedM14UrbanSpatialCoordinatesAt oldVisit sourceIndex
      boundary) : M14UrbanSpatialOccurrenceAt oldVisit sourceIndex boundary := by
  cases source
  exact m14UrbanBlockedOccurrenceAt oldVisit sourceIndex boundary

def restored
    (source : SourceGeneratedM14UrbanSpatialCoordinatesAt oldVisit sourceIndex
      boundary) : M14UrbanSpatialOccurrenceAt oldVisit sourceIndex boundary := by
  cases source
  exact m14UrbanRestoredOccurrenceAt oldVisit sourceIndex boundary

theorem rootLedgerAndNext
    (_source : SourceGeneratedM14UrbanSpatialCoordinatesAt oldVisit sourceIndex
      boundary) : type_of% (periodicRouteRootLedgerAndNextExact
        (m14UrbanDepthAt oldVisit sourceIndex boundary)) :=
  periodicRouteRootLedgerAndNextExact
    (m14UrbanDepthAt oldVisit sourceIndex boundary)

theorem restoresMissingAxis
    (_source : SourceGeneratedM14UrbanSpatialCoordinatesAt oldVisit sourceIndex
      boundary) : type_of% (periodicRouteRestoresTheMissingAxis
        (m14UrbanDepthAt oldVisit sourceIndex boundary)) :=
  periodicRouteRestoresTheMissingAxis
    (m14UrbanDepthAt oldVisit sourceIndex boundary)

end SourceGeneratedM14UrbanSpatialCoordinatesAt

theorem sourceNativeM14UrbanSpatialCoordinates_directConsumer
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    let source := sourceGeneratedM14UrbanSpatialCoordinatesAt oldVisit
      sourceIndex boundary
    Nonempty (SourceGeneratedM14UrbanSpatialCoordinatesAt oldVisit sourceIndex
        boundary) ∧
      source.restoration =
        m14UrbanRouteRestorationAt oldVisit sourceIndex boundary ∧
      source.blocked =
        m14UrbanBlockedOccurrenceAt oldVisit sourceIndex boundary ∧
      source.restored =
        m14UrbanRestoredOccurrenceAt oldVisit sourceIndex boundary ∧
      type_of% (m14UrbanRouteRoot_eq_refusalTargetPaymentRoot oldVisit
        sourceIndex boundary) ∧
      type_of% (periodicRouteRootLedgerAndNextExact
        (m14UrbanDepthAt oldVisit sourceIndex boundary)) ∧
      type_of% (periodicRouteRestoresTheMissingAxis
        (m14UrbanDepthAt oldVisit sourceIndex boundary)) ∧
      type_of% (m14UrbanBlockedRestored_sameRouteOccurrence oldVisit
        sourceIndex boundary) ∧
      type_of% (m14UrbanSpatialRead_sourceExact oldVisit sourceIndex boundary) ∧
      type_of% (m14UrbanAccessibilityRead_injective oldVisit sourceIndex
        boundary) ∧
      type_of% (m14UrbanCapacityRead_injective oldVisit sourceIndex boundary) ∧
      type_of% (m14UrbanSpatialRead_blocked_ne_restored oldVisit sourceIndex
        boundary) := by
  let source := sourceGeneratedM14UrbanSpatialCoordinatesAt oldVisit sourceIndex
    boundary
  exact ⟨⟨source⟩, rfl, rfl, rfl,
    m14UrbanRouteRoot_eq_refusalTargetPaymentRoot oldVisit sourceIndex boundary,
    source.rootLedgerAndNext, source.restoresMissingAxis,
    m14UrbanBlockedRestored_sameRouteOccurrence oldVisit sourceIndex boundary,
    m14UrbanSpatialRead_sourceExact oldVisit sourceIndex boundary,
    m14UrbanAccessibilityRead_injective oldVisit sourceIndex boundary,
    m14UrbanCapacityRead_injective oldVisit sourceIndex boundary,
    m14UrbanSpatialRead_blocked_ne_restored oldVisit sourceIndex boundary⟩

end
