open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Beauty.SharedKernel
open ProcessGame.Society.M14EssentialAccessRelationFixture
open ProcessGame.Society.M14SourceGeneratedEssentialAccessCriticalAction
open ProcessGame.Society.M14SourceGeneratedCrossCompilerRelationCurrentRecurrence
open ProcessGame.Society.M14SourceGeneratedCrossCompilerRelationAppendPresentation
open ProcessGame.Society.M14SourceGeneratedCrossCompilerRelationAppendRuntime
open ProcessGame.Society.M14SourceGeneratedActualRelationThreeCycle
open ProcessGame.Society.M14ProofCarryingActualRelationThreeCycleResidual
open ProcessGame.Society.M14SourceGeneratedActualRelationRoleReflexiveRing
open ProcessGame.Society.M14SourceGeneratedActualRelationCycleMemoryWitnessPublication

noncomputable section

abbrev M14CultureObserverMember := ThreeCycleTime

/-- One cycle member evaluates the current actual target role with its fixed
incoming-role readout. -/
def m14CultureMemberVisibleReadAt
    (base : Nat) (member : M14CultureObserverMember) (current : Nat) : Int :=
  actualRelationIncomingRoleReadAt base member
    (actualRelationTargetRoleAt current)

/-- The three incoming-role restrictions share the exact cross-action
presentation as their common authority coordinate. -/
def m14CultureObserverFamilyAt (base : Nat) :
    CommonAuthorityObserverFamily Nat AnyAuthoritativeRootCurrent where
  Member := M14CultureObserverMember
  Visible := fun _member => Int
  forget := m14CultureMemberVisibleReadAt base
  authorityK := fun current =>
    (crossCompilerActionPresentationAt current).erase
  positive := ⟨ThreeCycleTime.t0⟩

@[simp] theorem m14CultureAuthorityK_exact (base current : Nat) :
    (m14CultureObserverFamilyAt base).authorityK current =
      (crossCompilerActionPresentationAt current).erase :=
  rfl

/-- Three actual renewals preserve the target-role evaluation because they
preserve the source-generated exact relation seed. -/
@[simp] theorem m14CultureTargetRole_add_three (base : Nat) :
    actualRelationTargetRoleAt (base + 3) =
      actualRelationTargetRoleAt base := by
  have seedEq := (periodThreeSeed_differentCrossCompilerOccurrence base).1
  exact congrArg
    (fun seed => essentialAccessRelationCompiler.roleAt
      (essentialAccessCriticalRelation seed.1) Relations.EdgeSide.target)
    seedEq

/-- Every member restriction identifies the renewed and original depths. -/
@[simp] theorem m14CultureMemberVisible_add_three
    (base : Nat) (member : M14CultureObserverMember) :
    (m14CultureObserverFamilyAt base).forget member (base + 3) =
      (m14CultureObserverFamilyAt base).forget member base := by
  change actualRelationIncomingRoleReadAt base member
      (actualRelationTargetRoleAt (base + 3)) =
    actualRelationIncomingRoleReadAt base member
      (actualRelationTargetRoleAt base)
  rw [m14CultureTargetRole_add_three]

/-- The complete three-member observation therefore identifies the two
depths without comparing independent tuples. -/
theorem m14CultureJointVisible_add_three (base : Nat) :
    (m14CultureObserverFamilyAt base).jointForget (base + 3) =
      (m14CultureObserverFamilyAt base).jointForget base :=
  (m14CultureObserverFamilyAt base).jointForget_eq_iff.mpr
    (m14CultureMemberVisible_add_three base)

/-- Exact joint-kernel pair generated by the period-three source recurrence.
The pair's residual is the actual cross-action presentation, not the renewed
seed or actor identity. -/
def m14CultureJointKernelPairAt (base : Nat) :
    AuthorityKernelPair
      (m14CultureObserverFamilyAt base).jointAuthorityObserver :=
  (m14CultureObserverFamilyAt base).jointAuthorityKernelPair
    (base + 3) base (by omega)
    (m14CultureMemberVisible_add_three base)
    (periodThreeSeed_differentCrossCompilerOccurrence base).2

/-- The joint kernel loses the exact action-occurrence authority. -/
def m14CultureAuthorityHiddenNullWitnessAt (base : Nat) :
    HiddenNullWitness
      (m14CultureObserverFamilyAt base).jointForget
      (m14CultureObserverFamilyAt base).authorityK :=
  (m14CultureObserverFamilyAt base).jointKernelPairHiddenNullWitness
    (m14CultureJointKernelPairAt base)

/-- Same seed, actor, and every member observation coexist with different
exact action occurrences. -/
theorem m14CultureSameSeedActorMemberObservationsDifferentAuthority
    (base : Nat) :
    actualRelationSeedAt (base + 3) = actualRelationSeedAt base ∧
      actualRelationActorAt (base + 3) = actualRelationActorAt base ∧
      (∀ member : M14CultureObserverMember,
        (m14CultureObserverFamilyAt base).forget member (base + 3) =
          (m14CultureObserverFamilyAt base).forget member base) ∧
      (crossCompilerActionPresentationAt (base + 3)).erase ≠
        (crossCompilerActionPresentationAt base).erase := by
  have seedEq := (periodThreeSeed_differentCrossCompilerOccurrence base).1
  refine ⟨seedEq, ?_, m14CultureMemberVisible_add_three base,
    (periodThreeSeed_differentCrossCompilerOccurrence base).2⟩
  exact congrArg (fun seed => seed.actor essentialAccessRelationCompiler) seedEq

/-! ## Shared lineage from the existing cycle-memory publication -/

/-- Reuse the inhabited/empty cycle-memory split on the newly generated
joint observer pair.  Neither endpoint nor a desired refined distinction is
accepted as a new premise. -/
theorem m14CultureSharedLineageRefinementAt (base : Nat) :
    SourceWitnessKernelRefinementAt
      (cycleMemoryPublicationAt base) (m14CultureJointKernelPairAt base) where
  leftWitness := (cycleMemoryKernelRefinementAt base).leftWitness
  rightWitnessEmpty := (cycleMemoryKernelRefinementAt base).rightWitnessEmpty

/-- Joint incoming-role observation plus the honest cycle-memory publication
bit.  The exact action authority is inherited unchanged. -/
def m14CultureSharedLineageObserverAt (base : Nat) :=
  sourceWitnessRefinedObserver
    (m14CultureObserverFamilyAt base).jointAuthorityObserver
    (cycleMemoryPublicationAt base)

@[simp] theorem m14CultureSharedLineage_laterPublished (base : Nat) :
    (cycleMemoryPublicationAt base).publicationTag (base + 3) = true :=
  (m14CultureSharedLineageRefinementAt base).left_publicationTag_eq_true

@[simp] theorem m14CultureSharedLineage_baseUnpublished (base : Nat) :
    (cycleMemoryPublicationAt base).publicationTag base = false :=
  (m14CultureSharedLineageRefinementAt base).right_publicationTag_eq_false

/-- The unrefined member bundle honestly preserves the old gluing kernel. -/
theorem m14CultureSharedLineage_coarse_eq (base : Nat) :
    (m14CultureObserverFamilyAt base).jointForget (base + 3) =
      (m14CultureObserverFamilyAt base).jointForget base :=
  (m14CultureSharedLineageRefinementAt base).coarseVisible_eq

/-- Published cycle memory separates the renewed occurrence from its earlier
incarnation while retaining the same action authority map. -/
theorem m14CultureSharedLineage_refined_ne (base : Nat) :
    (m14CultureSharedLineageObserverAt base).forget (base + 3) ≠
      (m14CultureSharedLineageObserverAt base).forget base :=
  (m14CultureSharedLineageRefinementAt base).refinedVisible_ne

/-! ## Source-owned bundle -/

/-- Source-owned observer-kernel and shared-lineage material at one cycle
base.  Its private constructor stores only already generated source facts and
their exact canonical readouts. -/
structure SourceGeneratedM14CultureObserverKernelBundleAt
    (base : Nat) where
  private mk ::
  actualCycle : type_of% (actualRelationThreeCycle_directConsumer base)
  roleRing : type_of% (actualRelationRoleReflexiveRing_directConsumer base)
  jointPair : AuthorityKernelPair
    (m14CultureObserverFamilyAt base).jointAuthorityObserver
  jointPairExact : jointPair = m14CultureJointKernelPairAt base
  authorityResidual : HiddenNullWitness
    (m14CultureObserverFamilyAt base).jointForget
    (m14CultureObserverFamilyAt base).authorityK
  authorityResidualExact :
    authorityResidual = m14CultureAuthorityHiddenNullWitnessAt base
  sharedLineagePublication : SourceWitnessPublicationAt
    (SourceGeneratedActualRelationCycleMemoryWitnessAt base)
  sharedLineagePublicationExact :
    sharedLineagePublication = cycleMemoryPublicationAt base
  sharedLineageRefinement : SourceWitnessKernelRefinementAt
    sharedLineagePublication (m14CultureJointKernelPairAt base)

/-- Sole source producer. -/
def sourceGeneratedM14CultureObserverKernelBundleAt
    (base : Nat) : SourceGeneratedM14CultureObserverKernelBundleAt base where
  actualCycle := actualRelationThreeCycle_directConsumer base
  roleRing := actualRelationRoleReflexiveRing_directConsumer base
  jointPair := m14CultureJointKernelPairAt base
  jointPairExact := rfl
  authorityResidual := m14CultureAuthorityHiddenNullWitnessAt base
  authorityResidualExact := rfl
  sharedLineagePublication := cycleMemoryPublicationAt base
  sharedLineagePublicationExact := rfl
  sharedLineageRefinement := m14CultureSharedLineageRefinementAt base

/-- Independent readout of all capability added by this subordinate C1b
producer. -/
theorem sourceGeneratedM14CultureObserverKernelBundle_directConsumer
    (base : Nat) :
    let bundle := sourceGeneratedM14CultureObserverKernelBundleAt base
    Nonempty (SourceGeneratedM14CultureObserverKernelBundleAt base) ∧
      type_of% (actualRelationThreeCycle_directConsumer base) ∧
      type_of% (actualRelationRoleReflexiveRing_directConsumer base) ∧
      bundle.jointPair = m14CultureJointKernelPairAt base ∧
      bundle.authorityResidual =
        m14CultureAuthorityHiddenNullWitnessAt base ∧
      bundle.sharedLineagePublication = cycleMemoryPublicationAt base ∧
      type_of%
        (m14CultureSameSeedActorMemberObservationsDifferentAuthority base) ∧
      type_of% (m14CultureJointVisible_add_three base) ∧
      Not (ConsumerSafe
        (m14CultureObserverFamilyAt base).jointForget
        (m14CultureObserverFamilyAt base).authorityK) ∧
      type_of% (m14CultureSharedLineage_laterPublished base) ∧
      type_of% (m14CultureSharedLineage_baseUnpublished base) ∧
      type_of% (m14CultureSharedLineage_coarse_eq base) ∧
      type_of% (m14CultureSharedLineage_refined_ne base) := by
  let bundle := sourceGeneratedM14CultureObserverKernelBundleAt base
  exact ⟨⟨bundle⟩, bundle.actualCycle, bundle.roleRing,
    bundle.jointPairExact, bundle.authorityResidualExact,
    bundle.sharedLineagePublicationExact,
    m14CultureSameSeedActorMemberObservationsDifferentAuthority base,
    m14CultureJointVisible_add_three base,
    (m14CultureObserverFamilyAt base).jointKernelPair_not_consumerSafe
      (m14CultureJointKernelPairAt base),
    m14CultureSharedLineage_laterPublished base,
    m14CultureSharedLineage_baseUnpublished base,
    m14CultureSharedLineage_coarse_eq base,
    m14CultureSharedLineage_refined_ne base⟩

end
