import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.NoIslandNoMagic.Consciousness.Culture.M14.Teaching.Interface.SourceNativeM14TeachingCoordinates

/-!
# Source-generated M14 platform teaching delivery

One low-universe joint event recovers three already generated sources: the
renewed material action admitted by the platform gate, its actual M14
`t0 -> t1` contact, and the honest M12 publication contact.  Its whole carrier
transport moves both the exact culture practice medium and the aesthetic
context.  The target effect is recomputed from the resulting role and
alignment.

The material action supplies its own next.  This file does not identify that
next with the distinct paid-platform root next and does not install a new
root row.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace NoIslandNoMagic
namespace Consciousness
namespace Culture
namespace M14
namespace Teaching
namespace Source

open ProcessGame Society
open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open ConstructiveRoot.RootInquiryCompletion
open ProcessGame.Society.M14EssentialAccessRelationFixture
open ProcessGame.Society.M14SourceGeneratedContributionMergeActionSource
open ProcessGame.Society.M14ProofCarryingActualRelationThreeCycleResidual
open ProcessGame.Society.M14SourceGeneratedActualRelationRoleReflexiveRing
open ProcessGame.Society.M14SourceGeneratedPlatformGateRenewedActualService
open ProcessGame.Society.M14ProofCarryingPlatformGateFullAdmission
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Beauty.M12
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Beauty.M12.SharedKernel
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Beauty.M12.SharedKernel.Communication
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Culture.M14.Communication
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Culture.M14.Teaching.Interface

noncomputable section

/-- Low-universe teaching carrier.  Its two coordinates are transformed by
the same joint contact; this is not a consumer-product representation. -/
abbrev M14TeachingPracticeAt (boundary : Nat) (support : ThreeCycleTime) :=
  CulturePracticeMediumAt (m14TeachingDepthAt boundary) support ×
    SourceGeneratedM12AestheticContextOccurrence

structure M14TeachingObservation where
  role : EssentialAccessRole
  alignment : M12AestheticAlignmentReadout

structure M14TeachingEffect where
  incomingRoleScore : Int
  proposal : M12PublicAestheticProposal

/-- Private joint occurrence.  Its low universe permits use as an actual
communication event; all high source receipts are recovered from its fixed
indices below. -/
inductive SourceGeneratedM14TeachingContactEventAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) : Type
  | private generated

def sourceGeneratedM14TeachingContactEventAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    SourceGeneratedM14TeachingContactEventAt oldVisit sourceIndex boundary :=
  .generated

namespace SourceGeneratedM14TeachingContactEventAt

variable {oldVisit : OldVisit} {sourceIndex boundary : Nat}
  (event : SourceGeneratedM14TeachingContactEventAt oldVisit sourceIndex
    boundary)

def cultureContact : SourceGeneratedM14CultureContactEventAt
    (m14TeachingDepthAt boundary) := by
  cases event
  exact m14TeachingCultureContactAt boundary

def publicationContact : SourceGeneratedM12PublicationContact := by
  cases event
  exact sourceGeneratedM12PublicationContact

def fullAdmission : ProofCarryingPlatformGateFullAdmissionAt oldVisit
    sourceIndex boundary := by
  cases event
  exact proofCarryingPlatformGateFullAdmission oldVisit sourceIndex boundary

def materialService : SourceGeneratedPlatformGateRenewedActualServiceAt
    oldVisit sourceIndex boundary :=
  (fullAdmission event).materialFulfillment.materialService

@[simp] theorem cultureContact_exact :
    cultureContact event = m14TeachingCultureContactAt boundary := by
  cases event
  rfl

@[simp] theorem publicationContact_exact :
    publicationContact event = sourceGeneratedM12PublicationContact := by
  cases event
  rfl

@[simp] theorem fullAdmission_exact :
    fullAdmission event =
      proofCarryingPlatformGateFullAdmission oldVisit sourceIndex boundary := by
  cases event
  rfl

end SourceGeneratedM14TeachingContactEventAt

/-- Product presentation generated by the two exact contact presentations. -/
def m14TeachingPracticePresentationAt
    (boundary : Nat) :
    ConstructivePresentation
      (M14TeachingPracticeAt boundary .t0)
      (M14TeachingPracticeAt boundary .t1) :=
  let culturePresentation := culturePracticeMediumPresentationAt
    (m14TeachingCultureContactAt boundary)
  { forward := fun value =>
      ⟨culturePresentation.forward value.1,
        contextSwapPresentation.forward value.2⟩
    backward := fun value =>
      ⟨culturePresentation.backward value.1,
        contextSwapPresentation.backward value.2⟩
    backward_forward := by
      intro value
      apply Prod.ext
      · exact culturePresentation.backward_forward value.1
      · exact contextSwap_involutive value.2
    forward_backward := by
      intro value
      apply Prod.ext
      · exact culturePresentation.forward_backward value.1
      · exact contextSwap_involutive value.2 }

/-- Joint actual communication at the one admitted material-action contact. -/
def m14TeachingCommunicationAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    ActualCommunicationNetwork
      (M14CultureWorldAt (m14TeachingDepthAt boundary)) where
  Carrier := M14TeachingPracticeAt boundary
  Observation := fun _support => M14TeachingObservation
  observe := fun _support value =>
    { role := value.1.1
      alignment := sourceAlignmentRead value.2 }
  ContactAt := SourceGeneratedM14CultureContactAt
    (m14TeachingDepthAt boundary)
  IncidenceTransportAt := SourceGeneratedM14CultureIncidenceTransportAt
    (m14TeachingDepthAt boundary)
  LineageTransportAt := SourceGeneratedM14CultureLineageTransportAt
    (m14TeachingDepthAt boundary)
  Event := SourceGeneratedM14TeachingContactEventAt oldVisit sourceIndex
    boundary
  sourceSupport := fun _event => .t0
  targetSupport := fun _event => .t1
  contact := fun event =>
    ⟨event.cultureContact, rfl, rfl⟩
  incidenceTransport := fun event =>
    ⟨event.cultureContact, rfl, rfl⟩
  lineageTransport := fun event =>
    ⟨event.cultureContact, rfl, rfl,
      actualRelationCycleLineage_targetGenerated
        (m14TeachingDepthAt boundary) .t0⟩
  carrierTransport := fun _event =>
    m14TeachingPracticePresentationAt boundary

def m14TeachingPayloadSourceAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    ActualPayloadSource
      (m14TeachingCommunicationAt oldVisit sourceIndex boundary) where
  EventAt := fun _support => PUnit
  emit := fun _support => PUnit.unit
  payload := fun {support} _event =>
    ⟨culturePracticeMediumAt (m14TeachingDepthAt boundary) support, .coarse⟩

def m14TeachingTargetConsumerSourceAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    ActualTargetConsumerSource
      (m14TeachingCommunicationAt oldVisit sourceIndex boundary) where
  EventAt := fun _support _observation => PUnit
  emit := fun _support _observation => PUnit.unit
  EffectAt := fun _support => M14TeachingEffect
  effectFromObservation := fun support observation =>
    { incomingRoleScore := actualRelationIncomingRoleReadAt
        (m14TeachingDepthAt boundary) support observation.role
      proposal := publicProposalOfEvaluation observation.alignment.phase }
  openEntryAt := fun {support} {_observation} _event =>
    ⟨support, ⟨rfl⟩⟩

def m14TeachingOperationalSourcesAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    ActualOperationalSeparationSources
      (m14TeachingCommunicationAt oldVisit sourceIndex boundary) where
  payloadSource := m14TeachingPayloadSourceAt oldVisit sourceIndex boundary
  consumerSource :=
    m14TeachingTargetConsumerSourceAt oldVisit sourceIndex boundary
  CutEventAt := fun _source _target => PEmpty
  cutSide := fun event => nomatch event
  cut_source_side := fun event => nomatch event
  cut_target_side := fun event => nomatch event
  cut_blocks := fun event => nomatch event
  cutObstruction := fun event => nomatch event

def m14TeachingContactEdgeAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    ActualContactEdgeAt
      (m14TeachingCommunicationAt oldVisit sourceIndex boundary) .t0 .t1 :=
  ActualContactEdgeAt.canonical
    (sourceGeneratedM14TeachingContactEventAt oldVisit sourceIndex boundary)

def m14TeachingPathAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    SourceOwnedTransportPath
      (m14TeachingCommunicationAt oldVisit sourceIndex boundary) .t0 .t1 :=
  .cons (m14TeachingContactEdgeAt oldVisit sourceIndex boundary)
    (@SourceOwnedTransportPath.nil
      (M14CultureWorldAt (m14TeachingDepthAt boundary))
      (m14TeachingCommunicationAt oldVisit sourceIndex boundary) .t1)

def m14TeachingDeliveryAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    GeneratedDeliveryAt
      (m14TeachingCommunicationAt oldVisit sourceIndex boundary)
      (m14TeachingOperationalSourcesAt oldVisit sourceIndex boundary)
      .t0 .t1 where
  path := m14TeachingPathAt oldVisit sourceIndex boundary

@[simp] theorem m14TeachingPath_length
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (m14TeachingPathAt oldVisit sourceIndex boundary).length = 1 :=
  rfl

@[simp] theorem m14TeachingPath_events_exact
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (m14TeachingPathAt oldVisit sourceIndex boundary).events =
      [sourceGeneratedM14TeachingContactEventAt oldVisit sourceIndex
        boundary] :=
  rfl

@[simp] theorem m14TeachingDelivery_sourceContext
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (m14TeachingDeliveryAt oldVisit sourceIndex boundary).sourceValue.2 =
      .coarse :=
  rfl

@[simp] theorem m14TeachingDelivery_targetContext
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (m14TeachingDeliveryAt oldVisit sourceIndex boundary).targetValue.2 =
      .refined :=
  rfl

@[simp] theorem m14TeachingDelivery_targetMedium
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (m14TeachingDeliveryAt oldVisit sourceIndex boundary).targetValue.1.1 =
      EssentialAccessRole.platformProvider := by
  change (culturePracticeMediumAt (m14TeachingDepthAt boundary) .t1).1 =
    EssentialAccessRole.platformProvider
  exact m14TeachingTargetMedium_platformProvider boundary

@[simp] theorem m14TeachingDelivery_effect_exact
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (m14TeachingDeliveryAt oldVisit sourceIndex boundary).effect =
      { incomingRoleScore := 1
        proposal := M12PublicAestheticProposal.endorse } := by
  have scoreExact : actualRelationIncomingRoleReadAt
      (m14TeachingDepthAt boundary) .t1
      (culturePracticeMediumAt (m14TeachingDepthAt boundary) .t1).1 = 1 := by
    rw [(culturePracticeMediumAt
      (m14TeachingDepthAt boundary) .t1).property]
    exact (actualRelationIncomingRoleReadAt_target_eq_one_iff
      (m14TeachingDepthAt boundary) .t0 .t1).2 rfl
  have proposalExact : publicProposalOfEvaluation
      (sourceAlignmentRead SourceGeneratedM12AestheticContextOccurrence.refined
        ).phase = .endorse := by
    rw [sourceAlignmentRead_refined_phase]
    rfl
  have observationRoleExact :
      (m14TeachingDeliveryAt oldVisit sourceIndex boundary
        ).targetObservation.role =
        (culturePracticeMediumAt (m14TeachingDepthAt boundary) .t1).1 :=
    rfl
  have observationAlignmentExact :
      (m14TeachingDeliveryAt oldVisit sourceIndex boundary
        ).targetObservation.alignment =
        sourceAlignmentRead .refined :=
    rfl
  change M14TeachingEffect.mk _ _ = M14TeachingEffect.mk 1 .endorse
  rw [observationRoleExact, observationAlignmentExact, scoreExact,
    proposalExact]

theorem m14TeachingDelivery_writeBack_exact
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (m14TeachingDeliveryAt oldVisit sourceIndex boundary).writeBack =
      (m14TeachingPathAt oldVisit sourceIndex boundary).generatedWriteBack
        (m14TeachingDeliveryAt oldVisit sourceIndex boundary).sourceValue :=
  rfl

/-- The next is generated by the same material action that generated the
joint contact; it is not borrowed from the paid platform root. -/
theorem m14TeachingMaterialActionNext_exact
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    let event := sourceGeneratedM14TeachingContactEventAt oldVisit sourceIndex
      boundary
    event.materialService.generatedNext =
      ⟨event.materialService.sourceAction.target.TargetV,
        event.materialService.sourceAction.target.targetRoot.toAuthoritativeRoot,
        event.materialService.sourceAction.target.targetVisit⟩ := by
  dsimp
  exact (sourceGeneratedM14TeachingContactEventAt oldVisit sourceIndex
    boundary).materialService.generatedNextExact

theorem sourceGeneratedM14PlatformTeachingDelivery_directConsumer
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    type_of% (m14TeachingContact_actionOccurrence_exact boundary) ∧
      type_of% (m14TeachingContact_sourceActionRuntime oldVisit sourceIndex
        boundary) ∧
      type_of% (m14TeachingSourceActor_gate_exact oldVisit sourceIndex
        boundary) ∧
      type_of% (m14TeachingTargetMedium_platformProvider boundary) ∧
      type_of% m14TeachingPublication_refinement_exact ∧
      (m14TeachingPathAt oldVisit sourceIndex boundary).length = 1 ∧
      (m14TeachingPathAt oldVisit sourceIndex boundary).events =
        [sourceGeneratedM14TeachingContactEventAt oldVisit sourceIndex
          boundary] ∧
      (m14TeachingDeliveryAt oldVisit sourceIndex boundary).sourceValue.2 =
        .coarse ∧
      (m14TeachingDeliveryAt oldVisit sourceIndex boundary).targetValue.2 =
        .refined ∧
      (m14TeachingDeliveryAt oldVisit sourceIndex boundary).targetValue.1.1 =
        EssentialAccessRole.platformProvider ∧
      (m14TeachingDeliveryAt oldVisit sourceIndex boundary).effect =
        { incomingRoleScore := 1
          proposal := M12PublicAestheticProposal.endorse } ∧
      type_of% (m14TeachingDelivery_writeBack_exact oldVisit sourceIndex
        boundary) ∧
      type_of% (m14TeachingMaterialActionNext_exact oldVisit sourceIndex
        boundary) ∧
      type_of% (sourceGeneratedM12AestheticPublicCommunication_directConsumer) ∧
      type_of% (platformGateFullAdmission_directConsumer oldVisit sourceIndex
        boundary) :=
  ⟨m14TeachingContact_actionOccurrence_exact boundary,
    m14TeachingContact_sourceActionRuntime oldVisit sourceIndex boundary,
    m14TeachingSourceActor_gate_exact oldVisit sourceIndex boundary,
    m14TeachingTargetMedium_platformProvider boundary,
    m14TeachingPublication_refinement_exact,
    m14TeachingPath_length oldVisit sourceIndex boundary,
    m14TeachingPath_events_exact oldVisit sourceIndex boundary,
    m14TeachingDelivery_sourceContext oldVisit sourceIndex boundary,
    m14TeachingDelivery_targetContext oldVisit sourceIndex boundary,
    m14TeachingDelivery_targetMedium oldVisit sourceIndex boundary,
    m14TeachingDelivery_effect_exact oldVisit sourceIndex boundary,
    m14TeachingDelivery_writeBack_exact oldVisit sourceIndex boundary,
    m14TeachingMaterialActionNext_exact oldVisit sourceIndex boundary,
    sourceGeneratedM12AestheticPublicCommunication_directConsumer,
    platformGateFullAdmission_directConsumer oldVisit sourceIndex boundary⟩

end
