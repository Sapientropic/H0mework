import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.Proposition133
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.Proposition178

/-!
# Proposition 179: Strategy-D cascade closure

P177 constructs a P94/P104 seven-facet system from the typed primitive axiom
class.  P178 proves projection uniqueness under primitive equivalence.  P133
already turns any structure-determined seven-facet system into the packed
obstruction-memory ontology isomorphism.

This file packages the whole Strategy-D path:

```text
primitive slogans
  -> seven-facet projection/pullback
  -> structure-determined seven-facet system
  -> finite foundation certificate
  -> obstruction-memory ontology iso
```

Boundary: the cascade is machine-checked conditional on the primitive axiom
class fields.  It closes the formal bridge once those fields are supplied; it
does not audit production code for the fields.
-/

namespace SaturationMonoid

namespace AippocampusPrimitiveAxiomClass

variable {State : Type*}

/-! ## The named Strategy-D cascade generators -/

/-- THEOREM 1: upstream P94 projection generated by the primitive axiom class.
-/
def strategyDProjection
    (A : AippocampusPrimitiveAxiomClass State) :
    SemanticBoolProjectionCertificate A.sevenFacetPredicates :=
  A.toSemanticBoolProjectionCertificate

/-- THEOREM 2: upstream P94 pullback generated by the primitive axiom class. -/
noncomputable def strategyDPullback
    (A : AippocampusPrimitiveAxiomClass State) :
    SemanticBoolMemoryPullback A.sevenFacetPredicates A.memoryContract :=
  A.toSemanticBoolMemoryPullback

/-- THEOREM 3: downstream P100 foundation generated through P104. -/
noncomputable def strategyDFoundation
    (A : AippocampusPrimitiveAxiomClass State) :
    FiniteDiscoveryFoundationCertificate A.sevenFacetPredicates
      A.memoryContract :=
  (A.toStructureDeterminedSevenFacetSystem).foundationCertificate

/-- THEOREM 4: downstream P133 ontology isomorphism generated through P104. -/
noncomputable def ontologyIso
    (A : AippocampusPrimitiveAxiomClass State) :
    ObstructionMemoryOntologyIso A.sevenFacetPredicates A.memoryContract :=
  (A.toStructureDeterminedSevenFacetSystem).ontologyIso

/-! ## Upstream closure: primitive slogans really reach P94/P104 -/

/-- THEOREM 2: the cascade projection is the primitive projection. -/
theorem cascade_projection_eq
    (A : AippocampusPrimitiveAxiomClass State) :
    A.strategyDProjection.project = A.sevenFacetProjection := by
  rfl

/-- THEOREM 3: the cascade projection preserves every primitive semantic atom.
-/
theorem cascade_projection_atom_iff
    (A : AippocampusPrimitiveAxiomClass State)
    (x : State) (a : SemanticAtom) :
    (semanticObligationSemantics A.sevenFacetPredicates).holds a x ↔
      (semanticObligationSemantics semanticBoolPredicates).holds a
        (A.strategyDProjection.project x) :=
  A.sevenFacetProjection_atom_iff x a

/-- THEOREM 4: the cascade memory contract is the P94 semantic-Boolean
pullback. -/
theorem cascade_memory_pullback
    (A : AippocampusPrimitiveAxiomClass State)
    (x : State) (a : SemanticAtom) :
    A.memoryContract.produces x a ↔
      semanticBoolMemoryContract.produces
        (A.strategyDProjection.project x) a :=
  A.memory_pullback x a

/-- THEOREM 5: the primitive axiom class reaches the P104
`StructureDeterminedSevenFacetSystem` interface. -/
noncomputable def cascade_structureSystem
    (A : AippocampusPrimitiveAxiomClass State) :
    StructureDeterminedSevenFacetSystem State :=
  A.toStructureDeterminedSevenFacetSystem

/-! ## Downstream closure: P133 consequences are forced -/

/-- THEOREM 6: quotient memory production in the generated ontology is exactly
semantic obstruction support. -/
theorem ontologyIso_support_iff
    (A : AippocampusPrimitiveAxiomClass State)
    (x : State) (q : MemorySupportQuotient A.memoryContract) :
    (memorySupportQuotientContract A.memoryContract).produces x q ↔
      AtomFailure (semanticObligationSemantics A.sevenFacetPredicates) x
        ((A.ontologyIso).atomEquiv q) :=
  (A.ontologyIso).support_iff x q

/-- THEOREM 7: quotient memory silence in the generated ontology is exactly
`C_safe`. -/
theorem ontologyIso_silent_iff_csafe
    (A : AippocampusPrimitiveAxiomClass State) (x : State) :
    (memorySupportQuotientContract A.memoryContract).memorySilent x ↔
      CSafe A.sevenFacetPredicates x :=
  (A.ontologyIso).silent_iff_safe x

/-- THEOREM 8: the generated ontology produces some quotient memory atom
exactly off `C_safe`. -/
theorem ontologyIso_nonempty_iff_unsafe
    (A : AippocampusPrimitiveAxiomClass State) (x : State) :
    (∃ q, (memorySupportQuotientContract A.memoryContract).produces x q) ↔
      (CSafe A.sevenFacetPredicates x → False) :=
  (A.ontologyIso).production_nonempty_iff_unsafe x

/-- THEOREM 9: any sound-and-complete presentation of the generated quotient
memory ontology is forced to decode exactly the ontology support. -/
theorem ontologyIso_presentation_forced
    (A : AippocampusPrimitiveAxiomClass State)
    {O : Type*}
    (pres :
      MemoryContractPresentation
        (memorySupportQuotientContract A.memoryContract) O)
    (x : State) (q : MemorySupportQuotient A.memoryContract) :
    pres.decodes (pres.classify x) q ↔
      AtomFailure (semanticObligationSemantics A.sevenFacetPredicates) x
        ((A.ontologyIso).atomEquiv q) :=
  (A.ontologyIso).presentation_forced pres x q

/-! ## Strategy-D uniqueness seam -/

/-- THEOREM 10: if two primitive axiom classes are equivalent, their generated
Strategy-D projections are identical on every state. -/
theorem cascade_projection_unique_of_equivalent
    {A B : AippocampusPrimitiveAxiomClass State}
    (h : Equivalent A B)
    (x : State) :
    A.strategyDProjection.project x =
      B.strategyDProjection.project x :=
  projection_eq_of_equivalent h x

/-- THEOREM 11: if two primitive axiom classes are equivalent, their induced
primitive memory production supports are identical. -/
theorem cascade_memory_unique_of_equivalent
    {A B : AippocampusPrimitiveAxiomClass State}
    (h : Equivalent A B)
    (x : State) (a : SemanticAtom) :
    A.memoryContract.produces x a ↔ B.memoryContract.produces x a :=
  memoryContract_produces_iff_of_equivalent h x a

end AippocampusPrimitiveAxiomClass

/-!
  Summary:
  - P179 is the formal Strategy-D close: primitive axiom class -> P94/P104
    structure -> P133 obstruction-memory ontology iso.
  - Uniqueness is inherited from P178 and all downstream ontology support is
    inherited from P133.
-/


end SaturationMonoid
