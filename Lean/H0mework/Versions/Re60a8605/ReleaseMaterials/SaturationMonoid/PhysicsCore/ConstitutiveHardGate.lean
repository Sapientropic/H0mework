import H0mework.Physics.Constitutive.ConstitutiveOperator
import H0mework.Physics.Exterior.PlebanskiVariations
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.PhysicsCore.SourceConstitutiveGeneration

/-!
# Shared constitutive producer hard gates

The first section preserves the stage-one schema under `Legacy...` names so
its `Unit` vacuity boundary remains machine-checkable.  The second section
removes the arbitrary generation predicates, target gauge block, generic GR
residual, and untyped cross-compatibility predicate.
-/

namespace SaturationMonoid
namespace PhysicsCore

universe uSource uConstitutive uSMBlock uBivector uTetrad uResidual
universe uGravityVariationResidual
universe uScalar uGaugeTwoForm uMetric uInternal
universe uConnection uMultiplier uMatter
universe uDeltaB uDeltaPhi uDeltaOmega uDeltaE
universe uActionValue

/-! ## Stage-one legacy schema -/

/-- A chosen constitutive law is genuinely generated and unique when it is
generated by each admissible source and every other generated candidate is
equal to it.

This first hard gate deliberately uses equality rather than an arbitrary
"equivalent" relation, which could otherwise make control vacuous.  A future
quotient-valued controlled version must first prove that its equivalence
preserves both physical projections. -/
def LegacySourceConstitutiveGeneratedAndUniqueObligation
    {Source : Type uSource} {Constitutive : Type uConstitutive}
    (admissible : Source → Prop)
    (generatedBySource : Source → Constitutive → Prop)
    (sourceConstitutive : Source → Constitutive) : Prop :=
  (∀ χ : Source, admissible χ →
      generatedBySource χ (sourceConstitutive χ)) ∧
    (∀ (χ : Source), admissible χ →
      ∀ K : Constitutive, generatedBySource χ K →
        K = sourceConstitutive χ)

/-- Standard-Model projection obligation.  `expectedGaugeBlock χ` is where
the three typed operators `g₃²* ⊕ g₂²* ⊕ g₁²*` must be constructed;
this gate does not manufacture them. -/
def LegacySourceGeneratedStandardModelConstitutiveHardGateObligation
    {Source : Type uSource} {Constitutive : Type uConstitutive}
    {StandardModelBlock : Type uSMBlock}
    (admissible : Source → Prop)
    (sourceConstitutive : Source → Constitutive)
    (standardModelProjection : Constitutive → StandardModelBlock)
    (gaugeBlockGeneratedBySource :
      Source → StandardModelBlock → Prop)
    (expectedGaugeBlock : Source → StandardModelBlock) : Prop :=
  ∀ χ : Source, admissible χ →
    gaugeBlockGeneratedBySource χ (expectedGaugeBlock χ) ∧
      (∀ block : StandardModelBlock,
        gaugeBlockGeneratedBySource χ block →
          block = expectedGaugeBlock χ) ∧
      standardModelProjection (sourceConstitutive χ) = expectedGaugeBlock χ

/-- The single shared hard gate: one controlled source-generated law must
satisfy both the Standard-Model block equation and the gravitational
simplicity/nondegeneracy/branch equation.

This legacy schema can be abused if its generation relations are defined
post hoc.  A physical theorem must fix those relations in an upstream source
module before proving this obligation; the repository has no such source-
backed instance today. -/
def LegacySourceGeneratedUniqueSMGRConstitutiveHardGateObligation
    {Source : Type uSource} {Constitutive : Type uConstitutive}
    {StandardModelBlock : Type uSMBlock}
    {BivectorTwoForm : Type uBivector} {Tetrad : Type uTetrad}
    {SimplicityResidual : Type uResidual}
    {GravityVariationResidual : Type uGravityVariationResidual}
    [AddCommGroup BivectorTwoForm] [Zero SimplicityResidual]
    [Zero GravityVariationResidual]
    (admissible : Source → Prop)
    (generatedBySource : Source → Constitutive → Prop)
    (sourceConstitutive : Source → Constitutive)
    (standardModelProjection : Constitutive → StandardModelBlock)
    (gaugeBlockGeneratedBySource :
      Source → StandardModelBlock → Prop)
    (expectedGaugeBlock : Source → StandardModelBlock)
    (gravityVariationResidual :
      Constitutive → BivectorTwoForm → GravityVariationResidual)
    (crossProjectionCompatible :
      Source → StandardModelBlock → BivectorTwoForm → Prop)
    (P : PlebanskiBranchKinematics BivectorTwoForm Tetrad
      SimplicityResidual) : Prop :=
  (∃ χ : Source, admissible χ) ∧
    LegacySourceConstitutiveGeneratedAndUniqueObligation admissible
      generatedBySource sourceConstitutive ∧
    LegacySourceGeneratedStandardModelConstitutiveHardGateObligation admissible
      sourceConstitutive standardModelProjection gaugeBlockGeneratedBySource
      expectedGaugeBlock ∧
    LegacySourceGeneratedGravityConstitutiveHardGateObligation admissible
      sourceConstitutive gravityVariationResidual P ∧
    ∀ (χ : Source), admissible χ →
      ∀ B : BivectorTwoForm,
        gravityVariationResidual (sourceConstitutive χ) B = 0 →
          crossProjectionCompatible χ (expectedGaugeBlock χ) B

/-! ## Stage-two typed hard gate -/

/-- Construct the typed Standard-Model gauge block from the metric stored in
an upstream-generated law.  There is no separately supplied expected block.
-/
def standardModelGaugeBlockOfGeneratedLaw
    {Scalar : Type uScalar} {GaugeTwoForm : Type uGaugeTwoForm}
    {Metric : Type uMetric} {InternalConstitutive : Type uInternal}
    [Field Scalar] [AddCommGroup GaugeTwoForm] [Module Scalar GaugeTwoForm]
    (hodgeOfMetric : Metric → GaugeTwoForm ≃ₗ[Scalar] GaugeTwoForm)
    (law : SourceGeneratedConstitutiveLaw Scalar Metric
      InternalConstitutive) :
    StandardModelGaugeConstitutiveBlock Scalar GaugeTwoForm where
  spacetimeHodge := hodgeOfMetric law.spacetimeMetric
  strongCouplingSquared := law.strongCouplingSquared
  weakCouplingSquared := law.weakCouplingSquared
  hyperchargeCouplingSquared := law.hyperchargeCouplingSquared

/-- Faithfulness on the physically relevant slice: each variation channel is
nonzero somewhere for a law generated by an admissible source.  This is
stronger than global function nonconstancy, while remaining only a
non-vacuity firewall rather than a proof of smooth variational correctness. -/
def SourceGeneratedVariationChannelsNontrivial
    {Source : Type uSource} {Scalar : Type uScalar} {Tetrad : Type uTetrad}
    {Metric : Type uMetric} {InternalConstitutive : Type uInternal}
    {Connection : Type uConnection} {BivectorTwoForm : Type uBivector}
    {Multiplier : Type uMultiplier} {Matter : Type uMatter}
    {ActionValue : Type uActionValue}
    {DeltaBResidual : Type uDeltaB}
    {DeltaPhiResidual : Type uDeltaPhi}
    {DeltaOmegaResidual : Type uDeltaOmega}
    {DeltaEResidual : Type uDeltaE}
    [Field Scalar]
    [Zero DeltaBResidual] [Zero DeltaPhiResidual]
    [Zero DeltaOmegaResidual] [Zero DeltaEResidual]
    (G : SourceMetricConstitutiveGeometry Source Scalar Tetrad Metric
      InternalConstitutive)
    (S : PlebanskiActionVariationSystem
      (SourceGeneratedConstitutiveLaw Scalar Metric InternalConstitutive)
      Connection BivectorTwoForm Multiplier Matter Tetrad ActionValue
      DeltaBResidual DeltaPhiResidual DeltaOmegaResidual DeltaEResidual) :
    Prop :=
  (∃ (χ : Source), G.admissible χ ∧
      ∃ q : PlebanskiMasterConfiguration Connection BivectorTwoForm
          Multiplier Matter,
        S.residuals.deltaBResidual (G.generatedLaw χ) q ≠ 0) ∧
    (∃ (χ : Source), G.admissible χ ∧
      ∃ q : PlebanskiMasterConfiguration Connection BivectorTwoForm
          Multiplier Matter,
        S.residuals.deltaPhiResidual (G.generatedLaw χ) q ≠ 0) ∧
    (∃ (χ : Source), G.admissible χ ∧
      ∃ q : PlebanskiMasterConfiguration Connection BivectorTwoForm
          Multiplier Matter,
        S.residuals.deltaOmegaResidual (G.generatedLaw χ) q ≠ 0) ∧
    (∃ (χ : Source), G.admissible χ ∧
      ∃ (q : PlebanskiMasterConfiguration Connection BivectorTwoForm
          Multiplier Matter) (e : Tetrad),
        S.residuals.deltaEAfterIIPlusResidual (G.generatedLaw χ) q e ≠ 0)

/-- The stage-two shared hard gate.

Differences from the legacy schema:

* generation is the fixed upstream equality relation `G.GeneratedBySource`;
* the Standard-Model block is constructed from the generated metric;
* `δB`, `δφ`, `δω`, and post-`II+` `δe` have distinct carriers and are
  definitionally obtained from one typed action-variation system;
* `II+` is selected by restricting the source configuration domain to the
  bivector constructed from `tetradOf χ`, not inferred from unconstrained
  Plebanski stationarity;
* cross-projection coherence is the definitionally constructed typed equality
  `*_SM = *_(g(e))`, not an arbitrary proposition or a metric/Hodge producer.

This proposition asks only for a source-selected stationary configuration.  It
does not claim that the other three standard Plebanski sectors cease to exist.
`G` remains an abstract source-geometry premise bundle.  Physical closure
requires either a genuine richer common source with independent internal and
smooth-geometry producer axes, or an information-insufficiency theorem; the
existing SU(7) thin datum must not be attached directly to arbitrary terminal
geometry fields. -/
def SourceGeneratedUniqueSMGRConstitutiveHardGateObligation
    {Source : Type uSource} {Scalar : Type uScalar}
    {GaugeTwoForm : Type uGaugeTwoForm} {Tetrad : Type uTetrad}
    {Metric : Type uMetric} {InternalConstitutive : Type uInternal}
    {Connection : Type uConnection} {BivectorTwoForm : Type uBivector}
    {Multiplier : Type uMultiplier} {Matter : Type uMatter}
    {ActionValue : Type uActionValue}
    {DeltaBResidual : Type uDeltaB}
    {DeltaPhiResidual : Type uDeltaPhi}
    {DeltaOmegaResidual : Type uDeltaOmega}
    {DeltaEResidual : Type uDeltaE}
    [Field Scalar] [AddCommGroup GaugeTwoForm] [Module Scalar GaugeTwoForm]
    [Nontrivial GaugeTwoForm] [Nontrivial Tetrad] [Nontrivial Metric]
    [AddCommGroup BivectorTwoForm] [Nontrivial BivectorTwoForm]
    [Zero DeltaBResidual] [Zero DeltaPhiResidual]
    [Zero DeltaOmegaResidual] [Zero DeltaEResidual]
    (G : SourceMetricConstitutiveGeometry Source Scalar Tetrad Metric
      InternalConstitutive)
    (hodgeOfMetric : Metric → GaugeTwoForm ≃ₗ[Scalar] GaugeTwoForm)
    (S : PlebanskiActionVariationSystem
      (SourceGeneratedConstitutiveLaw Scalar Metric InternalConstitutive)
      Connection BivectorTwoForm Multiplier Matter Tetrad ActionValue
      DeltaBResidual DeltaPhiResidual DeltaOmegaResidual DeltaEResidual)
    (P : PlebanskiIIPlusBranchGeometry BivectorTwoForm Tetrad) : Prop :=
  (∃ χ : Source, G.admissible χ) ∧
    SourceGeneratedVariationChannelsNontrivial G S ∧
    (∀ (χ : Source)
      (law : SourceGeneratedConstitutiveLaw Scalar Metric
        InternalConstitutive),
      G.GeneratedBySource χ law → law = G.generatedLaw χ) ∧
    ∀ (χ : Source), G.admissible χ →
      ∃ (q : PlebanskiMasterConfiguration Connection BivectorTwoForm
          Multiplier Matter)
        (e : Tetrad),
        S.residuals.MasterOnShell (G.generatedLaw χ) q ∧
          P.nondegenerate q.bivector ∧
          PlebanskiIIPlusSelectionEvidence
            (fun source configuration =>
              configuration.bivector =
                P.gravitationalBivector (G.tetradOf source))
            (fun _configuration => False)
            (fun _source _configuration => False)
            χ q .sourceConfigurationDomainRestriction ∧
          q.bivector = P.gravitationalBivector e ∧
          P.sector q.bivector = .gravitationalPlus ∧
          S.residuals.DeltaEOnShell (G.generatedLaw χ) q e ∧
          (G.generatedLaw χ).spacetimeMetric = G.metricOfTetrad e ∧
          (standardModelGaugeBlockOfGeneratedLaw hodgeOfMetric
              (G.generatedLaw χ)).spacetimeHodge =
            hodgeOfMetric (G.metricOfTetrad e)

end PhysicsCore
end SaturationMonoid
