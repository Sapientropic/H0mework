import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.CriticalKomi.PositionFace
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.CriticalKomi.Forcing

/-!
Executable action on the source-generated positional face.  The representative
below is a calculation carrier only: original replay is retained by the caller,
and every emitted move is lifted through the original native compiler.
-/

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Go.CriticalKomi

open ComplexityProjection.SATSource.InterferenceProgram

namespace RetainedPosition

/-- The list is generated by native history, so no quotient representative is chosen. -/
structure State (n : Nat) where
  visible : VisiblePosition n
  boards : List (BoardSignature n)

def face {n : Nat} (state : State n) : PositionFace.State n :=
  ⟨state.visible, state.boards.toFinset⟩

def capture {n : Nat} (frame : Frame n) : State n :=
  ⟨frame.visible, (frame.positionHistory.map Situation.board).eraseDups⟩

theorem capture_face {n : Nat} (frame : Frame n) :
    face (capture frame) = PositionFace.read frame := by
  unfold face capture PositionFace.read
  congr 1
  ext board
  simp

/-- Historical control labels and list order are irrelevant to positional superko.
This representative never supplies actual occurrence or lineage authority. -/
def calculationFrame {n : Nat} (state : State n) : Frame n :=
  ⟨state.visible, state.boards.map (fun board => ⟨board, .positive⟩)⟩

theorem read_calculationFrame {n : Nat} (state : State n) :
    PositionFace.read (calculationFrame state) = face state := by
  simp [PositionFace.read, calculationFrame, face, List.map_map, Function.comp_def]

def advance {n : Nat} (state : State n) (visible : VisiblePosition n) : State n :=
  ⟨visible, if visible.situation.board ∈ state.boards then state.boards
    else state.boards ++ [visible.situation.board]⟩

theorem advance_face {n : Nat} (state : State n) (visible : VisiblePosition n) :
    face (advance state visible) = PositionFace.advance (face state) visible := by
  unfold advance
  split
  · rename_i member
    simp [face, PositionFace.advance, member]
  · simp [face, PositionFace.advance]

def step? {n : Nat} (state : State n) (move : Move n) : Option (State n) :=
  (stepVisible? (Law.positionalSuperko 0) (calculationFrame state) move).map
    (advance state)

theorem step_original {n : Nat} (state : State n) (frame : Frame n)
    (represented : face state = PositionFace.read frame) (move : Move n) :
    (step? state move).map face =
      (nativeStep? (Law.positionalSuperko 0) frame move).map PositionFace.read := by
  have same := PositionFace.nativeStep_equal (calculationFrame state) frame
    ((read_calculationFrame state).trans represented) move
  rw [← same]
  simp only [step?, nativeStep?, Option.map_map]
  congr 1
  funext visible
  simp only [Function.comp_apply, PositionFace.read_advance,
    read_calculationFrame, advance_face]

theorem step_lifts {n : Nat} (state : State n) (frame : Frame n)
    (represented : face state = PositionFace.read frame) (move : Move n) (next : State n)
    (generated : step? state move = some next) :
    ∃ target, LegalStep (Law.positionalSuperko 0) frame move target ∧
      face next = PositionFace.read target := by
  have projected := step_original state frame represented move
  rw [generated, Option.map_some] at projected
  cases actual : nativeStep? (Law.positionalSuperko 0) frame move with
  | none => simp [actual] at projected
  | some target => exact ⟨target, actual, Option.some.inj (by simpa [actual] using projected)⟩

end RetainedPosition

/-- All successor obligations live on the action-stable source face. -/
theorem preimage_face_congr {n : Nat} (beneficiary : Polarity) (left right : Frame n)
    (same : PositionFace.read left = PositionFace.read right)
    (post : PositionFace.State n → Bool) :
    truth ((preimageProgram beneficiary left).eval
      (childEnvironment (scoringExpansion left) (post ∘ PositionFace.read))) =
    truth ((preimageProgram beneficiary right).eval
      (childEnvironment (scoringExpansion right) (post ∘ PositionFace.read))) := by
  have visible : left.visible = right.visible := congrArg PositionFace.State.visible same
  apply Bool.eq_iff_iff.mpr
  by_cases owned : left.visible.toMove = beneficiary
  · have rightOwned : right.visible.toMove = beneficiary := by simpa [← visible] using owned
    rw [preimage_own _ _ _ owned, preimage_own _ _ _ rightOwned]
    simpa only [Function.comp_apply, and_left_comm] using
      PositionFace.exists_good_iff left right same (fun move => move ≠ .resign)
        (fun state => post state = true)
  · have rightOther : right.visible.toMove ≠ beneficiary := by simpa [← visible] using owned
    rw [preimage_opponent _ _ _ owned, preimage_opponent _ _ _ rightOther]
    constructor
    · intro all move target step scoring
      obtain ⟨prior, priorStep, priorFace⟩ := PositionFace.legalStep_lift same.symm step
      simpa only [Function.comp_apply, ← priorFace] using all move prior priorStep scoring
    · intro all move target step scoring
      obtain ⟨next, nextStep, nextFace⟩ := PositionFace.legalStep_lift same step
      simpa only [Function.comp_apply, ← nextFace] using all move next nextStep scoring

theorem forcing_face_congr {n : Nat} (beneficiary : Polarity) (threshold : Int)
    (left right : Frame n) (same : PositionFace.read left = PositionFace.read right)
    (post : PositionFace.State n → Bool) :
    forcingRead beneficiary threshold left (post ∘ PositionFace.read) =
      forcingRead beneficiary threshold right (post ∘ PositionFace.read) := by
  have visible : left.visible = right.visible := congrArg PositionFace.State.visible same
  unfold forcingRead
  cases status : right.visible.status with
  | playing => simpa only [visible, status] using preimage_face_congr beneficiary left right same post
  | terminal reason => simp [visible, status, terminalGood]

end SaturationMonoid.ProcessGame.Go.CriticalKomi
