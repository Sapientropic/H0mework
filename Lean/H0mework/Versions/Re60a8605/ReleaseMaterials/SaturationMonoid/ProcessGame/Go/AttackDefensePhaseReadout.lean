import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.TacticalConstraintPhase

/-!
# Attack, defense and initiative as relation-phase readouts

The predicates in this file are downstream of one exact `RelationPhaseEdge`.
They do not accept an attack/defense label.  Attack is strict contraction of
the common move-word freedom carrier; defense additionally carries an exact
earlier compression and recovered word; conversion is provenance through the
fixed relation-transport law; counterattack is their transported contraction
intersection.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Go

namespace RelationPhaseEdge

/-! ## The edge phase is generated by its exact comparison -/

@[simp] theorem phaseStep_eq_relationPhaseStep {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {ply : GeneratedReplay.ActualPly replay}
    (edge : RelationPhaseEdge horizon transport ply) :
    edge.phaseStep = relationPhaseStep transport edge.comparison :=
  transition_generatedTargetState transport edge.sourceState edge.comparison

theorem phaseStep_ne_zero_iff_transport_or_comparison {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {ply : GeneratedReplay.ActualPly replay}
    (edge : RelationPhaseEdge horizon transport ply) :
    edge.phaseStep ≠ 0 ↔
      transport = RelationTransportLaw.advanceTurn n ∨
        edge.comparison ≠ .equal := by
  rw [edge.phaseStep_eq_relationPhaseStep]
  cases transport <;> cases edge.comparison <;>
    simp [relationPhaseStep, RelationTransportLaw.advanceTurn,
      freedomPhaseStep] <;> decide

theorem bearerDisposition_eq_handoff_iff_transport_or_comparison
    {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {ply : GeneratedReplay.ActualPly replay}
    (edge : RelationPhaseEdge horizon transport ply) :
    edge.bearerDisposition = .handoff ↔
      transport = RelationTransportLaw.advanceTurn n ∨
        edge.comparison ≠ .equal := by
  unfold bearerDisposition generatedBearerDisposition
  cases transport <;> cases edge.comparison <;>
    simp [RelationTransportLaw.advanceTurn]

/-! ## Generated tactical predicates -/

/-- Future-freedom attack: exact strict contraction on this lifted edge. -/
def AttackAt {n : Nat} {law : Law} {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {ply : GeneratedReplay.ActualPly replay}
    (edge : RelationPhaseEdge horizon transport ply) : Prop :=
  edge.comparison = .shrink

/-- Transport provenance has one generated target occurrence. -/
def ConversionAt {n : Nat} {law : Law} {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {ply : GeneratedReplay.ActualPly replay}
    (edge : RelationPhaseEdge horizon transport ply) : Prop :=
  edge.transportResult = .advanceTurn

/-- Generated constraint-owner flip on the relation-bearer lineage.  A later
lifecycle realization may identify this bearer with a generated player; G4
does not install a bearer registry or pretend the actual mover is the bearer. -/
def ConstraintOwnerFlipAt {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {ply : GeneratedReplay.ActualPly replay}
    (edge : RelationPhaseEdge horizon transport ply) : Prop :=
  edge.bearerDisposition = .handoff

/-- Initiative handoff is a change of the generated absolute relation phase,
not equality of primitive player labels. -/
def InitiativeHandoffAt {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {ply : GeneratedReplay.ActualPly replay}
    (edge : RelationPhaseEdge horizon transport ply) : Prop :=
  edge.sourceState ≠ edge.targetState

theorem attack_iff_strict_freedom_contraction {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {ply : GeneratedReplay.ActualPly replay}
    (edge : RelationPhaseEdge horizon transport ply) :
    AttackAt edge ↔
      StrictFreedomSubset
        (relationFreedom ply.extended horizon edge.targetRelation)
        (relationFreedom replay horizon edge.sourceRelation) := by
  unfold AttackAt RelationPhaseEdge.comparison relationComparisonAt
  exact compareFreedom_eq_shrink_iff _ _

theorem attack_of_retained_shrink {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {ply : GeneratedReplay.ActualPly replay}
    (edge : RelationPhaseEdge horizon transport ply)
    (retained : edge.transportResult = .retained)
    (shrinks : FreedomShrinksAt ply horizon edge.sourceRelation) :
    AttackAt edge := by
  apply (edge.attack_iff_strict_freedom_contraction).mpr
  have targetEq : edge.targetRelation = edge.sourceRelation := by
    unfold targetRelation
    rw [show edge.transportResult = .retained from retained]
    rfl
  rw [targetEq]
  exact shrinks

theorem attack_phaseStep_nonzero {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {ply : GeneratedReplay.ActualPly replay}
    {edge : RelationPhaseEdge horizon transport ply}
    (attack : AttackAt edge) :
    edge.phaseStep ≠ 0 := by
  exact (edge.phaseStep_ne_zero_iff_transport_or_comparison).mpr
    (Or.inr (by rw [attack]; decide))

theorem conversion_target_is_generated {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {ply : GeneratedReplay.ActualPly replay}
    {edge : RelationPhaseEdge horizon transport ply}
    (conversion : ConversionAt edge) :
    edge.targetRelation = sourceTurnRelationAt ply.extended := by
  unfold targetRelation
  rw [conversion]
  rfl

theorem ConversionAt.transport_eq_advanceTurn {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {ply : GeneratedReplay.ActualPly replay}
    {edge : RelationPhaseEdge horizon transport ply}
    (conversion : ConversionAt edge) :
    transport = RelationTransportLaw.advanceTurn n := by
  cases transport with
  | keep => cases conversion
  | turn => rfl

theorem ConversionAt.phaseStep_eq_two {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {ply : GeneratedReplay.ActualPly replay}
    {edge : RelationPhaseEdge horizon transport ply}
    (conversion : ConversionAt edge) : edge.phaseStep = 2 := by
  cases transport with
  | keep => cases conversion
  | turn =>
      rw [edge.phaseStep_eq_relationPhaseStep]
      rfl

theorem ConversionAt.flips_constraint_owner {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {ply : GeneratedReplay.ActualPly replay}
    {edge : RelationPhaseEdge horizon transport ply}
    (conversion : ConversionAt edge) : ConstraintOwnerFlipAt edge := by
  unfold ConstraintOwnerFlipAt
  apply (edge.bearerDisposition_eq_handoff_iff_transport_or_comparison).mpr
  exact Or.inl conversion.transport_eq_advanceTurn

/-! ## Recovery-indexed defense -/

/-- Build the next exact relation edge from the generated target lineage of
the previous one.  Horizon and transport law are fixed by the lineage type. -/
def nextEdge {n : Nat} {law : Law} {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {ply : GeneratedReplay.ActualPly replay}
    (edge : RelationPhaseEdge horizon transport ply)
    (nextPly : GeneratedReplay.ActualPly ply.extended) :
    RelationPhaseEdge horizon transport nextPly where
  sourceRelation := edge.targetRelation
  sourceState := edge.targetState
  sourceLineage := edge.targetLineage

/-- Defense requires a particular earlier compression on the same relation
lineage and a concrete word restored by this exact response. -/
structure DefenseAt {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (transport : RelationTransportLaw n)
    (pressure : GeneratedReplay.ActualPly replay)
    (response : GeneratedReplay.ActualPly pressure.extended)
    (pressureEdge : RelationPhaseEdge horizon transport pressure) where
  pressureRetained : pressureEdge.transportResult = .retained
  responseRetained :
    (pressureEdge.nextEdge response).transportResult = .retained
  recovery : FreedomRecoveryAt pressure response horizon
    pressureEdge.sourceRelation

theorem DefenseAt.comparison_eq_grow {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {pressure : GeneratedReplay.ActualPly replay}
    {response : GeneratedReplay.ActualPly pressure.extended}
    {pressureEdge : RelationPhaseEdge horizon transport pressure}
    (defense : DefenseAt horizon transport pressure response pressureEdge) :
    (pressureEdge.nextEdge response).comparison = .grow := by
  let responseEdge := pressureEdge.nextEdge response
  have sourceEq : responseEdge.sourceRelation =
      pressureEdge.sourceRelation := by
    change pressureEdge.targetRelation = pressureEdge.sourceRelation
    unfold RelationPhaseEdge.targetRelation
    rw [defense.pressureRetained]
    rfl
  unfold RelationPhaseEdge.comparison relationComparisonAt
  rw [show (transport.result response responseEdge.sourceRelation).target =
      responseEdge.sourceRelation by
    change responseEdge.transportResult.target = responseEdge.sourceRelation
    rw [defense.responseRetained]
    rfl]
  rw [sourceEq]
  exact (compareFreedom_eq_grow_iff _ _).mpr
    defense.recovery.expanded

theorem DefenseAt.phaseStep_nonzero {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {pressure : GeneratedReplay.ActualPly replay}
    {response : GeneratedReplay.ActualPly pressure.extended}
    {pressureEdge : RelationPhaseEdge horizon transport pressure}
    (defense : DefenseAt horizon transport pressure response pressureEdge) :
    (pressureEdge.nextEdge response).phaseStep ≠ 0 := by
  apply (phaseStep_ne_zero_iff_transport_or_comparison
    (pressureEdge.nextEdge response)).mpr
  apply Or.inr
  rw [defense.comparison_eq_grow]
  decide

theorem attack_and_defense_directions_disjoint {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {pressure : GeneratedReplay.ActualPly replay}
    {response : GeneratedReplay.ActualPly pressure.extended}
    {pressureEdge : RelationPhaseEdge horizon transport pressure}
    (defense : DefenseAt horizon transport pressure response pressureEdge) :
    ¬ AttackAt (pressureEdge.nextEdge response) := by
  intro attack
  unfold AttackAt at attack
  rw [defense.comparison_eq_grow] at attack
  cases attack

/-- Counterattack couples two independently marked relations on the same
exact response ply: the baseline relation recovers its compressed freedom,
while the opponent relation is strictly contracted.  Owner handoff is
generated from that second nonzero phase; it is not a stored field. -/
structure CounterattackAt {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat)
    (baselineTransport opponentTransport : RelationTransportLaw n)
    (pressure : GeneratedReplay.ActualPly replay)
    (response : GeneratedReplay.ActualPly pressure.extended)
    (pressureEdge : RelationPhaseEdge horizon baselineTransport pressure)
    (opponentEdge : RelationPhaseEdge horizon opponentTransport response) where
  defense : DefenseAt horizon baselineTransport pressure response pressureEdge
  independent : opponentEdge.sourceRelation ≠ pressureEdge.sourceRelation
  opponentAttack : AttackAt opponentEdge

theorem CounterattackAt.flips_constraint_owner {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat}
    {baselineTransport opponentTransport : RelationTransportLaw n}
    {pressure : GeneratedReplay.ActualPly replay}
    {response : GeneratedReplay.ActualPly pressure.extended}
    {pressureEdge : RelationPhaseEdge horizon baselineTransport pressure}
    {opponentEdge : RelationPhaseEdge horizon opponentTransport response}
    (counterattack : CounterattackAt horizon baselineTransport
      opponentTransport pressure response pressureEdge opponentEdge) :
    ConstraintOwnerFlipAt opponentEdge := by
  unfold ConstraintOwnerFlipAt
  apply (bearerDisposition_eq_handoff_iff_transport_or_comparison
    opponentEdge).mpr
  apply Or.inr
  rw [counterattack.opponentAttack]
  decide

/-! ## Handoff, rotation and exact lineage transport -/

theorem initiativeHandoff_iff_phaseStep_ne_zero {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {ply : GeneratedReplay.ActualPly replay}
    (edge : RelationPhaseEdge horizon transport ply) :
    InitiativeHandoffAt edge ↔ edge.phaseStep ≠ 0 := by
  unfold InitiativeHandoffAt phaseStep
  rw [ne_eq, ne_eq]
  exact not_congr (TacticalState.transition_eq_zero_iff
    edge.sourceState edge.targetState).symm

theorem CounterattackAt.initiative_handoff {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat}
    {baselineTransport opponentTransport : RelationTransportLaw n}
    {pressure : GeneratedReplay.ActualPly replay}
    {response : GeneratedReplay.ActualPly pressure.extended}
    {pressureEdge : RelationPhaseEdge horizon baselineTransport pressure}
    {opponentEdge : RelationPhaseEdge horizon opponentTransport response}
    (counterattack : CounterattackAt horizon baselineTransport
      opponentTransport pressure response pressureEdge opponentEdge) :
    InitiativeHandoffAt opponentEdge := by
  apply (opponentEdge.initiativeHandoff_iff_phaseStep_ne_zero).mpr
  exact attack_phaseStep_nonzero counterattack.opponentAttack

theorem initiativeHandoff_iff_nontrivial_rotation {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {ply : GeneratedReplay.ActualPly replay}
    (edge : RelationPhaseEdge horizon transport ply) :
    InitiativeHandoffAt edge ↔
      TacticalPhase.rotation edge.phaseStep ≠ 1 := by
  rw [edge.initiativeHandoff_iff_phaseStep_ne_zero]
  exact (TacticalPhase.rotation_ne_one_iff edge.phaseStep).symm

theorem ownerFlip_iff_nontrivial_rotation {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {ply : GeneratedReplay.ActualPly replay}
    (edge : RelationPhaseEdge horizon transport ply) :
    ConstraintOwnerFlipAt edge ↔
      TacticalPhase.rotation edge.phaseStep ≠ 1 := by
  unfold ConstraintOwnerFlipAt
  rw [edge.bearerDisposition_eq_handoff_iff_transport_or_comparison,
    ← edge.phaseStep_ne_zero_iff_transport_or_comparison]
  exact (TacticalPhase.rotation_ne_one_iff edge.phaseStep).symm

/-- The generated target lineage is the exact handoff/retained successor of
the source lineage. -/
theorem targetLineage_preserves_relation_bearer {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {ply : GeneratedReplay.ActualPly replay}
    (edge : RelationPhaseEdge horizon transport ply) :
    Nonempty (RelationLineage horizon transport ply.extended
      edge.targetRelation edge.targetState) :=
  ⟨edge.targetLineage⟩

/-! ## Consecutive composition and simultaneous obligations -/

theorem continue_phaseStep_compose {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {ply : GeneratedReplay.ActualPly replay}
    (edge : RelationPhaseEdge horizon transport ply)
    (nextPly : GeneratedReplay.ActualPly ply.extended) :
    TacticalPhase.compose
        (edge.nextEdge nextPly).phaseStep edge.phaseStep =
      TacticalState.transition edge.sourceState
        (edge.nextEdge nextPly).targetState := by
  exact TacticalState.transition_compose edge.sourceState edge.targetState
    (edge.nextEdge nextPly).targetState

theorem targetLineage_phaseProduct {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {transport : RelationTransportLaw n}
    {ply : GeneratedReplay.ActualPly replay}
    (edge : RelationPhaseEdge horizon transport ply) :
    edge.targetLineage.phaseProduct =
      TacticalPhase.compose edge.phaseStep edge.sourceLineage.phaseProduct := by
  rfl

/-- One actual ply may settle any finite list of independently marked
relations.  The common `ply` index prevents move-effect singleization without
introducing an obligation registry. -/
def settleMany {n : Nat} {law : Law} {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (transport : RelationTransportLaw n)
    (ply : GeneratedReplay.ActualPly replay)
    (edges : List (RelationPhaseEdge horizon transport ply)) :
    List TacticalPhase :=
  edges.map phaseStep

@[simp] theorem settleMany_length {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (transport : RelationTransportLaw n)
    (ply : GeneratedReplay.ActualPly replay)
    (edges : List (RelationPhaseEdge horizon transport ply)) :
    (settleMany horizon transport ply edges).length = edges.length := by
  simp [settleMany]

end RelationPhaseEdge

end Go
end ProcessGame
end SaturationMonoid
