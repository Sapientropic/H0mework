import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.Obligation.RelationObligation
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Price.SettlementPriceObserver

/-!
# Price-domain readout of generated Go obligation keys

This is deliberately a key-level consumer of G6 `targetFace`.  A Go key is
not promoted to a framework `AdmittedObligation`; strong settlement
authority requires a separate source-owned realization.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Go
namespace Obligation

open Society.Price

universe u v

/-- Exact key-level open fibre generated by a G6 obligation update. -/
abbrev GeneratedOpenKeyAt
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {Incidence : Type u} [DecidableEq Incidence]
    {face : OpenRelationObligationFace replay Incidence}
    {ply : GeneratedReplay.ActualPly replay}
    (update : GeneratedObligationUpdate face ply) :=
  { key : ObligationKey Incidence // key ∈ update.targetFace }

/-- A key-level price observer is the generic price readout specialized to
the exact G6 target face. -/
abbrev OpenKeyPriceObserverAt
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {Incidence : Type u} [DecidableEq Incidence]
    {face : OpenRelationObligationFace replay Incidence}
    {ply : GeneratedReplay.ActualPly replay}
    (update : GeneratedObligationUpdate face ply) (Value : Type v) :=
  PriceObserverAt (GeneratedOpenKeyAt update) Value

/-- The key-level price domain is exactly target-face inhabitation. -/
theorem openKeyPrice_nonempty_iff_targetFace_nonempty
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {Incidence : Type u} [DecidableEq Incidence]
    {face : OpenRelationObligationFace replay Incidence}
    {ply : GeneratedReplay.ActualPly replay}
    (update : GeneratedObligationUpdate face ply) (Value : Type v)
    (observer : OpenKeyPriceObserverAt update Value) :
    Nonempty (PriceObservationAt observer) ↔
      ∃ key : ObligationKey Incidence, key ∈ update.targetFace := by
  rw [priceObservation_nonempty_iff_openSettlement_nonempty]
  constructor
  · rintro ⟨⟨key, member⟩⟩
    exact ⟨key, member⟩
  · rintro ⟨key, member⟩
    exact ⟨⟨key, member⟩⟩

/-- An empty generated target face removes the key-price domain. -/
theorem noOpenKeyPrice_of_targetFace_empty
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {Incidence : Type u} [DecidableEq Incidence]
    {face : OpenRelationObligationFace replay Incidence}
    {ply : GeneratedReplay.ActualPly replay}
    (update : GeneratedObligationUpdate face ply)
    (empty : update.targetFace = ∅)
    {Value : Type v} (observer : OpenKeyPriceObserverAt update Value) :
    ¬ Nonempty (PriceObservationAt observer) := by
  apply noPriceObservation_of_noOpenSettlement
  refine ⟨?_⟩
  rintro ⟨key, member⟩
  rw [empty] at member
  simp at member

end Obligation
end Go
end ProcessGame
end SaturationMonoid
