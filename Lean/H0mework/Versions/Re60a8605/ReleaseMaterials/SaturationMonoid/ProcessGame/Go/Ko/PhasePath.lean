import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.Ko.ReachableCycle
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.AttackDefensePhaseReadout

/-!
# Exact relation-phase path around the reachable ko loop

The marked relation is generated entirely at the reachable setup: the remote
threat point is empty and control is still on the setup channel.  Capture
flips control and strictly removes that freedom.  The played threat then
occupies the remote point, so the same fixed relation stays false through the
answer and delayed recapture.  This yields one nonzero local `C4` step followed
by three zero steps on the exact four-ply lifted path.

No phase is a function of `Frame`, and no P259/P260 transition cochain is
defined here.  The output is the accumulated phase of one fixed-horizon,
fixed-law, replay-anchored relation lineage.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Go
namespace Ko

open KoReachableCycle

/-- Source-generated ko-threat control relation.  It reads only the exact
setup current and the fixed remote threat point; no target frame or path
verdict enters the probe. -/
def koThreatControlProbe (rule : RepetitionRule) : RelationProbe 3 where
  holds := fun frame => decide
    (frame.visible.board p22 = none ∧
      frame.visible.toMove = (setupReplay rule).final.visible.toMove)

private theorem relationFreedom_eq_empty_of_root_false {n : Nat}
    {law : Law} {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves)
    (horizon : Nat) (relation : RelationProbe n)
    (rootFalse : relation.holds replay.final = false) :
    relationFreedom replay horizon relation = ∅ := by
  have survivesFalse : ∀ word,
      relationSurvivesWord law relation replay.final word = false := by
    intro word
    cases word <;> simp [relationSurvivesWord, rootFalse]
  ext word
  simp [relationFreedom, survivesFalse]

def koPhaseTransport : RelationTransportLaw 3 :=
  RelationTransportLaw.retain 3

def koThreatControlLineage (rule : RepetitionRule) :
    RelationLineage 1 koPhaseTransport (setupReplay rule)
      (koThreatControlProbe rule) .impose :=
  .marked (setupReplay rule) (koThreatControlProbe rule) (by trivial)

/-- Capture is the first exact phase edge. -/
def capturePhaseEdge (rule : RepetitionRule) :
    RelationPhaseEdge 1 koPhaseTransport (capturePly rule) where
  sourceRelation := koThreatControlProbe rule
  sourceState := .impose
  sourceLineage := koThreatControlLineage rule

/-- The remote threat continues the exact lineage generated by capture. -/
def threatPhaseEdge (rule : RepetitionRule) :
    RelationPhaseEdge 1 koPhaseTransport (threatPly rule) :=
  (capturePhaseEdge rule).nextEdge (threatPly rule)

/-- The answering pass continues the same horizon and transport law. -/
def answerPassPhaseEdge (rule : RepetitionRule) :
    RelationPhaseEdge 1 koPhaseTransport (answerPassPly rule) :=
  (threatPhaseEdge rule).nextEdge (answerPassPly rule)

/-- Delayed recapture is the fourth edge of the same lifted lineage. -/
def recapturePhaseEdge (rule : RepetitionRule) :
    RelationPhaseEdge 1 koPhaseTransport (recapturePly rule) :=
  (answerPassPhaseEdge rule).nextEdge (recapturePly rule)

theorem capture_comparison_eq_shrink (rule : RepetitionRule) :
    (capturePhaseEdge rule).comparison = .shrink := by
  have sourceTrue :
      (koThreatControlProbe rule).holds (setupReplay rule).final = true := by
    cases rule <;> decide
  have targetFalse :
      (koThreatControlProbe rule).holds (afterCaptureReplay rule).final =
        false := by
    cases rule <;> decide
  have targetEmpty : relationFreedom (afterCaptureReplay rule) 1
      (koThreatControlProbe rule) = ∅ :=
    relationFreedom_eq_empty_of_root_false _ _ _ targetFalse
  have sourceEmptyWord : ([] : List (Move 3)) ∈
      relationFreedom (setupReplay rule) 1 (koThreatControlProbe rule) := by
    apply (mem_relationFreedom_iff _ _ _ _).mpr
    exact ⟨by simp, rfl, by simpa [relationSurvivesWord] using sourceTrue⟩
  unfold RelationPhaseEdge.comparison relationComparisonAt
  change compareFreedom
    (relationFreedom (setupReplay rule) 1 (koThreatControlProbe rule))
    (relationFreedom (afterCaptureReplay rule) 1
      (koThreatControlProbe rule)) = .shrink
  rw [targetEmpty]
  apply (compareFreedom_eq_shrink_iff _ _).mpr
  exact ⟨by simp, [], sourceEmptyWord, by simp⟩

theorem threat_comparison_eq_equal (rule : RepetitionRule) :
    (threatPhaseEdge rule).comparison = .equal := by
  have sourceFalse :
      (koThreatControlProbe rule).holds (afterCaptureReplay rule).final =
        false := by
    cases rule <;> decide
  have targetFalse :
      (koThreatControlProbe rule).holds (afterThreatReplay rule).final =
        false := by
    cases rule <;> decide
  have sourceEmpty := relationFreedom_eq_empty_of_root_false
    (afterCaptureReplay rule) 1 (koThreatControlProbe rule) sourceFalse
  have targetEmpty := relationFreedom_eq_empty_of_root_false
    (afterThreatReplay rule) 1 (koThreatControlProbe rule) targetFalse
  unfold RelationPhaseEdge.comparison relationComparisonAt
  change compareFreedom
    (relationFreedom (afterCaptureReplay rule) 1
      (koThreatControlProbe rule))
    (relationFreedom (afterThreatReplay rule) 1
      (koThreatControlProbe rule)) = .equal
  rw [sourceEmpty, targetEmpty]
  rfl

theorem answerPass_comparison_eq_equal (rule : RepetitionRule) :
    (answerPassPhaseEdge rule).comparison = .equal := by
  have sourceFalse :
      (koThreatControlProbe rule).holds (afterThreatReplay rule).final =
        false := by
    cases rule <;> decide
  have targetFalse :
      (koThreatControlProbe rule).holds (beforeRecaptureReplay rule).final =
        false := by
    cases rule <;> decide
  have sourceEmpty := relationFreedom_eq_empty_of_root_false
    (afterThreatReplay rule) 1 (koThreatControlProbe rule) sourceFalse
  have targetEmpty := relationFreedom_eq_empty_of_root_false
    (beforeRecaptureReplay rule) 1 (koThreatControlProbe rule) targetFalse
  unfold RelationPhaseEdge.comparison relationComparisonAt
  change compareFreedom
    (relationFreedom (afterThreatReplay rule) 1
      (koThreatControlProbe rule))
    (relationFreedom (beforeRecaptureReplay rule) 1
      (koThreatControlProbe rule)) = .equal
  rw [sourceEmpty, targetEmpty]
  rfl

theorem recapture_comparison_eq_equal (rule : RepetitionRule) :
    (recapturePhaseEdge rule).comparison = .equal := by
  have sourceFalse :
      (koThreatControlProbe rule).holds (beforeRecaptureReplay rule).final =
        false := by
    cases rule <;> decide
  have targetFalse :
      (koThreatControlProbe rule).holds (cycleReplay rule).final = false := by
    cases rule <;> decide
  have sourceEmpty := relationFreedom_eq_empty_of_root_false
    (beforeRecaptureReplay rule) 1 (koThreatControlProbe rule) sourceFalse
  have targetEmpty := relationFreedom_eq_empty_of_root_false
    (cycleReplay rule) 1 (koThreatControlProbe rule) targetFalse
  unfold RelationPhaseEdge.comparison relationComparisonAt
  change compareFreedom
    (relationFreedom (beforeRecaptureReplay rule) 1
      (koThreatControlProbe rule))
    (relationFreedom (cycleReplay rule) 1
      (koThreatControlProbe rule)) = .equal
  rw [sourceEmpty, targetEmpty]
  rfl

theorem capture_phaseStep_eq_one (rule : RepetitionRule) :
    (capturePhaseEdge rule).phaseStep = 1 := by
  rw [(capturePhaseEdge rule).phaseStep_eq_relationPhaseStep,
    capture_comparison_eq_shrink]
  rfl

theorem threat_phaseStep_eq_zero (rule : RepetitionRule) :
    (threatPhaseEdge rule).phaseStep = 0 := by
  rw [(threatPhaseEdge rule).phaseStep_eq_relationPhaseStep,
    threat_comparison_eq_equal]
  rfl

theorem answerPass_phaseStep_eq_zero (rule : RepetitionRule) :
    (answerPassPhaseEdge rule).phaseStep = 0 := by
  rw [(answerPassPhaseEdge rule).phaseStep_eq_relationPhaseStep,
    answerPass_comparison_eq_equal]
  rfl

theorem recapture_phaseStep_eq_zero (rule : RepetitionRule) :
    (recapturePhaseEdge rule).phaseStep = 0 := by
  rw [(recapturePhaseEdge rule).phaseStep_eq_relationPhaseStep,
    recapture_comparison_eq_equal]
  rfl

/-- Dependent package of the canonical exact path endpoint. -/
structure KoPhasePath (rule : RepetitionRule) where
  finalState : TacticalState
  lineage : RelationLineage 1 koPhaseTransport
    (recapturePly rule).extended
    (recapturePhaseEdge rule).targetRelation finalState

/-- Canonical four-edge path; every continuation was built by `nextEdge`. -/
def generatedKoPhasePath (rule : RepetitionRule) : KoPhasePath rule where
  finalState := (recapturePhaseEdge rule).targetState
  lineage := (recapturePhaseEdge rule).targetLineage

def KoPhasePath.phaseProduct {rule : RepetitionRule}
    (path : KoPhasePath rule) : TacticalPhase :=
  path.lineage.phaseProduct

/-- The exact local cochain accumulated chronologically along capture,
threat, answering pass and delayed recapture. -/
def koPhaseProduct (rule : RepetitionRule) : TacticalPhase :=
  (generatedKoPhasePath rule).phaseProduct

theorem koPhaseProduct_eq_four_edge_composition (rule : RepetitionRule) :
    koPhaseProduct rule =
      TacticalPhase.compose (recapturePhaseEdge rule).phaseStep
        (TacticalPhase.compose (answerPassPhaseEdge rule).phaseStep
          (TacticalPhase.compose (threatPhaseEdge rule).phaseStep
            (capturePhaseEdge rule).phaseStep)) := by
  unfold koPhaseProduct KoPhasePath.phaseProduct generatedKoPhasePath
  rw [(recapturePhaseEdge rule).targetLineage_phaseProduct]
  change TacticalPhase.compose (recapturePhaseEdge rule).phaseStep
    (answerPassPhaseEdge rule).targetLineage.phaseProduct = _
  rw [(answerPassPhaseEdge rule).targetLineage_phaseProduct]
  change TacticalPhase.compose (recapturePhaseEdge rule).phaseStep
    (TacticalPhase.compose (answerPassPhaseEdge rule).phaseStep
      (threatPhaseEdge rule).targetLineage.phaseProduct) = _
  rw [(threatPhaseEdge rule).targetLineage_phaseProduct]
  change TacticalPhase.compose (recapturePhaseEdge rule).phaseStep
    (TacticalPhase.compose (answerPassPhaseEdge rule).phaseStep
      (TacticalPhase.compose (threatPhaseEdge rule).phaseStep
        (capturePhaseEdge rule).targetLineage.phaseProduct)) = _
  rw [(capturePhaseEdge rule).targetLineage_phaseProduct]
  have seedZero : (capturePhaseEdge rule).sourceLineage.phaseProduct = 0 := by
    rfl
  rw [seedZero, TacticalPhase.compose_zero_right]

theorem koPhaseProduct_eq_one (rule : RepetitionRule) :
    koPhaseProduct rule = 1 := by
  rw [koPhaseProduct_eq_four_edge_composition,
    recapture_phaseStep_eq_zero, answerPass_phaseStep_eq_zero,
    threat_phaseStep_eq_zero, capture_phaseStep_eq_one]
  decide

theorem koPhaseProduct_ne_zero (rule : RepetitionRule) :
    koPhaseProduct rule ≠ 0 := by
  rw [koPhaseProduct_eq_one]
  decide

theorem koPhaseRotation_ne_one (rule : RepetitionRule) :
    TacticalPhase.rotation (koPhaseProduct rule) ≠ 1 :=
  (TacticalPhase.rotation_ne_one_iff (koPhaseProduct rule)).mpr
    (koPhaseProduct_ne_zero rule)

/-- The same exact four plies carry the nonzero phase and close only after
the local projection forgets the remote threat/history. -/
theorem koPhasePath_projects_to_reachable_loop (rule : RepetitionRule) :
    localProjection (setupReplay rule).final =
        localProjection (cycleReplay rule).final ∧
      (generatedKoPhasePath rule).lineage =
        (recapturePhaseEdge rule).targetLineage ∧
      koPhaseProduct rule ≠ 0 :=
  ⟨local_projection_loop rule, rfl, koPhaseProduct_ne_zero rule⟩

end Ko
end Go
end ProcessGame
end SaturationMonoid
