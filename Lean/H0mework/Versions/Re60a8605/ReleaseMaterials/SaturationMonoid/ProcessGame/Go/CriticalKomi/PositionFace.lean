import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.ReplayContinuation

/-!
The positional-superko calculation face keeps the visible position and the
set of boards already generated by the source history.  It forgets only
history order, duplicate entries and historical turn labels.  Actual replay
and occurrence identity remain on their original carriers.
-/

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Go.CriticalKomi.PositionFace

structure State (n : Nat) where
  visible : VisiblePosition n
  seenBoards : Finset (BoardSignature n)
  deriving DecidableEq

def read {n : Nat} (frame : Frame n) : State n :=
  ⟨frame.visible, (frame.positionHistory.map Situation.board).toFinset⟩

def advance {n : Nat} (state : State n) (visible : VisiblePosition n) :
    State n :=
  ⟨visible, state.seenBoards ∪ {visible.situation.board}⟩

theorem repetition_iff {n : Nat} (frame : Frame n) (next : Situation n) :
    violatesRepetition .positionalSuperko frame.positionHistory next ↔
      next.board ∈ (read frame).seenBoards := by
  simp [violatesRepetition, read]

theorem read_advance {n : Nat} (frame : Frame n) (visible : VisiblePosition n) :
    read (frame.advance visible) = advance (read frame) visible := by
  simp [read, Frame.advance, advance]

theorem visibleStep_equal {n : Nat} (left right : Frame n)
    (same : read left = read right) (move : Move n) :
    stepVisible? (Law.positionalSuperko 0) left move =
      stepVisible? (Law.positionalSuperko 0) right move := by
  have visible : left.visible = right.visible := congrArg State.visible same
  have seen : (read left).seenBoards = (read right).seenBoards :=
    congrArg State.seenBoards same
  have repetition (next : Situation n) :
      violatesRepetition .positionalSuperko left.positionHistory next ↔
        violatesRepetition .positionalSuperko right.positionHistory next := by
    rw [repetition_iff, repetition_iff, seen]
  cases move with
  | play point =>
      simp only [stepVisible?, playVisible?, visible, Law.positionalSuperko,
        repetition]
      rfl
  | pass =>
      simp [stepVisible?, passVisible?, Law.positionalSuperko, visible]
  | resign =>
      simp [stepVisible?, resignVisible?, visible]

theorem nativeStep_equal {n : Nat} (left right : Frame n)
    (same : read left = read right) (move : Move n) :
    (nativeStep? (Law.positionalSuperko 0) left move).map read =
      (nativeStep? (Law.positionalSuperko 0) right move).map read := by
  unfold nativeStep?
  rw [visibleStep_equal left right same move]
  cases stepVisible? (Law.positionalSuperko 0) right move with
  | none => rfl
  | some visible =>
      simp only [Option.map_some, read_advance]
      rw [same]

theorem legalStep_lift {n : Nat} {left right target : Frame n}
    (same : read left = read right) {move : Move n}
    (step : LegalStep (Law.positionalSuperko 0) left move target) :
    ∃ rightTarget, LegalStep (Law.positionalSuperko 0) right move rightTarget ∧
      read target = read rightTarget := by
  have equal := nativeStep_equal left right same move
  change nativeStep? (Law.positionalSuperko 0) left move = some target at step
  rw [step, Option.map_some] at equal
  cases nextEq : nativeStep? (Law.positionalSuperko 0) right move with
  | none => simp [nextEq] at equal
  | some rightTarget =>
      exact ⟨rightTarget, nextEq, Option.some.inj (by simpa [nextEq] using equal)⟩

theorem exists_good_iff {n : Nat} (left right : Frame n)
    (same : read left = read right) (allowed : Move n → Prop)
    (good : State n → Prop) :
    (∃ move target, allowed move ∧
      LegalStep (Law.positionalSuperko 0) left move target ∧ good (read target)) ↔
    (∃ move target, allowed move ∧
      LegalStep (Law.positionalSuperko 0) right move target ∧ good (read target)) := by
  constructor
  · rintro ⟨move, target, permitted, step, holds⟩
    obtain ⟨next, nextStep, nextRead⟩ := legalStep_lift same step
    exact ⟨move, next, permitted, nextStep, nextRead ▸ holds⟩
  · rintro ⟨move, target, permitted, step, holds⟩
    obtain ⟨next, nextStep, nextRead⟩ := legalStep_lift same.symm step
    exact ⟨move, next, permitted, nextStep, nextRead ▸ holds⟩

theorem forall_good_iff {n : Nat} (left right : Frame n)
    (same : read left = read right) (allowed : Move n → Prop)
    (good : State n → Prop) :
    (∀ move target, allowed move →
      LegalStep (Law.positionalSuperko 0) left move target → good (read target)) ↔
    (∀ move target, allowed move →
      LegalStep (Law.positionalSuperko 0) right move target → good (read target)) := by
  constructor
  · intro allGood move target permitted step
    obtain ⟨next, nextStep, nextRead⟩ := legalStep_lift same.symm step
    rw [nextRead]
    exact allGood move next permitted nextStep
  · intro allGood move target permitted step
    obtain ⟨next, nextStep, nextRead⟩ := legalStep_lift same step
    rw [nextRead]
    exact allGood move next permitted nextStep

theorem actual_update {n : Nat} {moves : List (Move n)}
    {replay : GeneratedReplay (Law.positionalSuperko 0) (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replay) :
    read ply.target = advance (read replay.final) ply.target.visible := by
  simp [read, advance, nativeStep_positionHistory_eq ply.step]

end SaturationMonoid.ProcessGame.Go.CriticalKomi.PositionFace
