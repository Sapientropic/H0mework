import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.Society.GeneratedRelationRole

/-!
# Relation roles of M1 boundary group actors

This adapter keeps the affected actor on the exact M1 source-group face.  An
occupied source stone generates both its boundary `SnapshotGroup` actor and
the existing G4 group-survival relation.  Player controllers remain on the
independent G2 lineage face; this file does not coerce groups into players or
introduce a common actor registry.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Go
namespace Society
namespace GeneratedGroupRelationRole

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open ProcessGame.Society Lifecycle Universal Relations
open GeneratedRelationRole

/-- Closed group-interest seeds are exactly occupied stones of the actual
ply's source board. -/
abbrev RelationSeed
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (_ply : GeneratedReplay.ActualPly replayPrefix) :=
  OccupiedStone replayPrefix.final.visible.board

def relationSeedAt
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix)
    (_source : GeneratedReplay law (Frame.initial n)
      (moves ++ [ply.emitted]))
    (state : Frame n) (_stone : RelationSeed ply) : Prop :=
  state = replayPrefix.final

/-- Existing G4 relation edge generated by the same occupied stone that
generates the M1 boundary group actor. -/
def phaseEdge
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (stone : RelationSeed ply) :
    RelationPhaseEdge horizon (RelationTransportLaw.retain n) ply where
  sourceRelation := groupRelationProbe (snapshotGroupOf stone)
  sourceState := .impose
  sourceLineage := .marked replayPrefix
    (groupRelationProbe (snapshotGroupOf stone)) (by trivial)

/-- Universal generated-interest/role compiler on M1's exact source-group
actor face. -/
abbrev compiler
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix) :
    SourceOwnedRelationRoleCompiler
      (@goOccurrenceOf n law (moves ++ [ply.emitted]))
      (goProcessGame ply.extended) (BoundaryGroupActor.sourceFace ply) where
  RelationSeed := RelationSeed ply
  RelationLineage := fun _ =>
    RelationPhaseEdge horizon (RelationTransportLaw.retain n) ply
  relationSeedAt := relationSeedAt ply
  relationLineageOf := fun _ seed => phaseEdge horizon ply seed.1
  beneficiaryActorSeed := id
  beneficiaryActor_active := by
    intro source state stone active
    exact active
  Role := fun _ => TacticalState
  Phase := fun _ => TacticalPhase
  sourceRoleOf := fun _ edge => edge.sourceState
  phaseStepOf := fun _ edge => edge.phaseStep
  advanceRole := fun _ phase role => advanceTacticalRole phase role
  FutureCode := List (Move n)
  futureCodeDecidableEq := inferInstance
  futureCodeCarrier := (moveWordsUpTo n horizon).toFinset
  futureIdle := fun word => word = []
  FutureContinuationAt := fun edge side word =>
    Future.HabitableContinuationAt edge
      (GeneratedRelationRole.toFutureSide side) word
  futureBoundaryState := fun _ side =>
    match side with
    | .source => replayPrefix.final
    | .target => ply.target
  futureBoundaryState_mem := by
    intro edge side
    cases side with
    | source => exact (BoundaryGroupActor.core ply).source_state_mem
    | target => exact (BoundaryGroupActor.core ply).target_state_mem
  FutureContinuationWitnessAt := fun edge side _word continuation =>
    continuation.continuation.stateTrace ∈
      rootedPaths
        (futureConeAt
          (Future.replayAt edge
            (GeneratedRelationRole.toFutureSide side)).2 horizon)
  futureContinuation_witnessed := by
    intro edge side word continuation
    exact continuation.factors_through_futureCone

def exactRelationSeed
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (stone : RelationSeed ply) :
    (compiler horizon ply).ExactRelationSeed :=
  ⟨stone, replayPrefix.final,
    (BoundaryGroupActor.core ply).source_state_mem, rfl⟩

def generatedRelationOf
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (stone : RelationSeed ply) :
    (compiler horizon ply).GeneratedRelation :=
  (compiler horizon ply).relationOf
    (exactRelationSeed horizon ply stone)

/-- Exact M1 source boundary group actor generated by the relation seed. -/
def affectedGroupActor
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (stone : RelationSeed ply) : (compiler horizon ply).Actor :=
  (exactRelationSeed horizon ply stone).actor (compiler horizon ply)

@[simp] theorem affectedGroupActor_value
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (stone : RelationSeed ply) :
    (affectedGroupActor horizon ply stone).1 = snapshotGroupOf stone :=
  rfl

/-- The affected carrier is definitionally M1's lifecycle source actor, not
a generated player with matching polarity. -/
def asM1SourceActor
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (stone : RelationSeed ply) :
    (BoundaryGroupActor.core ply).SourceActor :=
  affectedGroupActor horizon ply stone

theorem exactSeed_generates_group_interest
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (stone : RelationSeed ply) :
    (compiler horizon ply).GeneratedInterestAt
      (affectedGroupActor horizon ply stone)
      (generatedRelationOf horizon ply stone) :=
  ⟨exactRelationSeed horizon ply stone, rfl, rfl⟩

@[simp] theorem generated_phaseStep_eq_G4_edge
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (stone : RelationSeed ply) :
    (compiler horizon ply).phaseStep
        (generatedRelationOf horizon ply stone) =
      (phaseEdge horizon ply stone).phaseStep :=
  rfl

@[simp] theorem generated_target_role_eq_G4_state
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (stone : RelationSeed ply) :
    (compiler horizon ply).roleAt
        (generatedRelationOf horizon ply stone) .target =
      (phaseEdge horizon ply stone).targetState := by
  let edge := phaseEdge horizon ply stone
  change advanceTacticalRole edge.phaseStep edge.sourceState = edge.targetState
  rw [edge.phaseStep_eq_relationPhaseStep]
  change advanceTacticalRole (freedomPhaseStep edge.comparison)
    edge.sourceState = edge.targetState
  rw [advanceTacticalRole_freedomPhaseStep]
  rfl

end GeneratedGroupRelationRole
end Society
end Go
end ProcessGame
end SaturationMonoid
