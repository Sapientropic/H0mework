import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.BoardKernel
import Mathlib.Data.Rat.Defs

/-!
# Generated Go rules kernel

This module defines the deterministic finite-board rule law consumed by the
process-generated game instance.  A raw `Frame` is only the current calculation
carrier and the position prefix needed by positional superko; only
`nativeStep?` extends that prefix.  Exact event history and authority are added
by the generated-run layer, not stored twice here.  The module does not define
players, group identities, search authority, a domain root, or a second ledger.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Go

/-- Board-repetition semantics used by play.  All three required rulesets share
the same deterministic transition compiler. -/
inductive RepetitionRule where
  | simpleKo
  | positionalSuperko
  | situationalSuperko
  deriving DecidableEq, Repr

/-- Pass repetition is an explicit rule branch.  The standard positional
superko instance exempts pass; the strict branch subjects its unchanged board
to the same repetition test. -/
inductive PassRepetitionPolicy where
  | exempt
  | subjectToPositionalSuperko
  deriving DecidableEq, Repr

/-- Fixed rules that are not already determined by the board type. -/
structure Law where
  repetition : RepetitionRule
  passRepetition : PassRepetitionPolicy
  komi : ℚ
  deriving DecidableEq, Repr

namespace Law

/-- The first authoritative instance: positional superko, pass exempt,
Chinese-style area score and rational komi. -/
def positionalSuperko (komi : ℚ) : Law where
  repetition := .positionalSuperko
  passRepetition := .exempt
  komi := komi

/-- Simple-ko rules with the same pass and scoring conventions. -/
def simpleKo (komi : ℚ) : Law where
  repetition := .simpleKo
  passRepetition := .exempt
  komi := komi

/-- Situational-superko rules with the same pass and scoring conventions. -/
def situationalSuperko (komi : ℚ) : Law where
  repetition := .situationalSuperko
  passRepetition := .exempt
  komi := komi

end Law

/-- Terminal causes generated by the move law. -/
inductive TerminalReason where
  | twoPasses
  | resignation (winner : Polarity)
  deriving DecidableEq, Repr

/-- Whether actual play is still open. -/
inductive Status where
  | playing
  | terminal (reason : TerminalReason)
  deriving DecidableEq, Repr

/-- The repetition-sensitive situation.  Positional superko projects to
`board`; situational superko retains `toMove`. -/
structure Situation (n : Nat) where
  board : BoardSignature n
  toMove : Polarity
  deriving DecidableEq

/-- The visible position.  Superko history is deliberately not stored here. -/
structure VisiblePosition (n : Nat) where
  board : Board n
  toMove : Polarity
  consecutivePasses : Nat
  status : Status
  deriving DecidableEq

namespace VisiblePosition

@[ext] theorem ext {n : Nat} {left right : VisiblePosition n}
    (board_eq : left.board = right.board)
    (toMove_eq : left.toMove = right.toMove)
    (passes_eq : left.consecutivePasses = right.consecutivePasses)
    (status_eq : left.status = right.status) :
    left = right := by
  cases left
  cases right
  cases board_eq
  cases toMove_eq
  cases passes_eq
  cases status_eq
  rfl

/-- Repetition-sensitive restriction of a visible position. -/
def situation {n : Nat} (visible : VisiblePosition n) : Situation n where
  board := boardSignature visible.board
  toMove := visible.toMove

end VisiblePosition

/-- Source-emittable Go moves. -/
inductive Move (n : Nat) where
  | play (point : Point n)
  | pass
  | resign
  deriving DecidableEq, Repr

/-- A raw current carrier: visible position plus the generated board prefix
needed by positional superko.  A `Frame` alone has no actual-history authority;
the generated-run layer proves reachability from `initial`. -/
structure Frame (n : Nat) where
  visible : VisiblePosition n
  positionHistory : List (Situation n)
  deriving DecidableEq

namespace Frame

/-- The generated empty-board initial current. -/
def initial (n : Nat) : Frame n where
  visible := {
    board := Board.empty
    toMove := .positive
    consecutivePasses := 0
    status := .playing
  }
  positionHistory := [{ board := boardSignature Board.empty, toMove := .positive }]

/-- The unique current extension by one generated visible event. -/
def advance {n : Nat} (frame : Frame n) (nextVisible : VisiblePosition n) : Frame n where
  visible := nextVisible
  positionHistory := frame.positionHistory ++ [nextVisible.situation]

end Frame

/-- Whether the generated child would violate the selected repetition rule. -/
def violatesRepetition {n : Nat} (rule : RepetitionRule)
    (history : List (Situation n)) (next : Situation n) : Prop :=
  match rule with
  | .simpleKo =>
      match history.reverse.drop 1 with
      | [] => False
      | previous :: _ => previous.board = next.board
  | .positionalSuperko =>
      ∃ previous ∈ history, previous.board = next.board
  | .situationalSuperko => next ∈ history

instance {n : Nat} (rule : RepetitionRule) (history : List (Situation n))
    (next : Situation n) : Decidable (violatesRepetition rule history next) := by
  cases rule with
  | simpleKo =>
      cases dropped : history.reverse.drop 1 with
      | nil =>
          simpa [violatesRepetition, dropped] using
            (inferInstance : Decidable False)
      | cons previous tail =>
          simpa [violatesRepetition, dropped] using
            (inferInstance : Decidable (previous.board = next.board))
  | positionalSuperko =>
      unfold violatesRepetition
      infer_instance
  | situationalSuperko =>
      unfold violatesRepetition
      infer_instance

/-- The visible result of a placement, including capture, suicide and
positional-superko checks. -/
def playVisible? {n : Nat} (law : Law) (frame : Frame n) (point : Point n) :
    Option (VisiblePosition n) :=
  match frame.visible.status with
  | .terminal _ => none
  | .playing =>
      if frame.visible.board point = none then
        let nextBoard := boardAfterPlay frame.visible.board frame.visible.toMove point
        if stoneHasLiberty nextBoard point then
          let nextToMove := frame.visible.toMove.other
          if violatesRepetition law.repetition frame.positionHistory
              { board := boardSignature nextBoard, toMove := nextToMove } then
            none
          else
            some {
              board := nextBoard
              toMove := nextToMove
              consecutivePasses := 0
              status := .playing
            }
        else
          none
      else
        none

/-- The visible result of pass under the law's explicit repetition branch. -/
def passVisible? {n : Nat} (law : Law) (frame : Frame n) :
    Option (VisiblePosition n) :=
  match frame.visible.status with
  | .terminal _ => none
  | .playing =>
      let nextSituation : Situation n := {
        board := boardSignature frame.visible.board
        toMove := frame.visible.toMove.other
      }
      if law.passRepetition = .subjectToPositionalSuperko ∧
          violatesRepetition law.repetition frame.positionHistory nextSituation then
        none
      else
        let nextPasses := frame.visible.consecutivePasses + 1
        some {
          board := frame.visible.board
          toMove := frame.visible.toMove.other
          consecutivePasses := nextPasses
          status := if 2 ≤ nextPasses then .terminal .twoPasses else .playing
        }

/-- The visible result of resignation. -/
def resignVisible? {n : Nat} (frame : Frame n) : Option (VisiblePosition n) :=
  match frame.visible.status with
  | .terminal _ => none
  | .playing => some {
      board := frame.visible.board
      toMove := frame.visible.toMove
      consecutivePasses := frame.visible.consecutivePasses
      status := .terminal (.resignation frame.visible.toMove.other)
    }

/-- The deterministic fixed-law visible transition. -/
def stepVisible? {n : Nat} (law : Law) (frame : Frame n) (move : Move n) :
    Option (VisiblePosition n) :=
  match move with
  | .play point => playVisible? law frame point
  | .pass => passVisible? law frame
  | .resign => resignVisible? frame

/-- The sole native Go current update.  Actual event and position histories are
extended only after the visible transition has been generated. -/
def nativeStep? {n : Nat} (law : Law) (frame : Frame n) (move : Move n) :
    Option (Frame n) :=
  (stepVisible? law frame move).map (Frame.advance frame)

/-- A legal step is exactly one successful image of the fixed compiler. -/
def LegalStep {n : Nat} (law : Law) (frame : Frame n) (move : Move n)
    (target : Frame n) : Prop :=
  nativeStep? law frame move = some target

/-- A legal move exposes some generated target but does not let the caller
choose it. -/
def LegalMove {n : Nat} (law : Law) (frame : Frame n) (move : Move n) : Prop :=
  ∃ target, LegalStep law frame move target

/-- Fixed law plus exact current and event determine a unique target. -/
theorem legalStep_target_unique {n : Nat} {law : Law} {frame : Frame n}
    {move : Move n} {left right : Frame n}
    (leftStep : LegalStep law frame move left)
    (rightStep : LegalStep law frame move right) :
    left = right := by
  exact Option.some.inj (leftStep.symm.trans rightStep)

/-- Every actual child appends exactly the board generated by the event. -/
theorem nativeStep_positionHistory_eq {n : Nat} {law : Law}
    {frame target : Frame n} {move : Move n}
    (step : LegalStep law frame move target) :
    target.positionHistory =
      frame.positionHistory ++ [target.visible.situation] := by
  unfold LegalStep nativeStep? at step
  cases generated : stepVisible? law frame move with
  | none => simp [generated] at step
  | some nextVisible =>
      simp [generated, Frame.advance] at step
      subst target
      rfl

/-- The target visible state is the same value generated before history
write-back; no target shell is accepted by the compiler. -/
theorem nativeStep_visible_eq {n : Nat} {law : Law} {frame target : Frame n}
    {move : Move n} (step : LegalStep law frame move target) :
    stepVisible? law frame move = some target.visible := by
  unfold LegalStep nativeStep? at step
  cases generated : stepVisible? law frame move with
  | none => simp [generated] at step
  | some nextVisible =>
      simp [generated, Frame.advance] at step
      subst target
      rfl

end Go
end ProcessGame
end SaturationMonoid
