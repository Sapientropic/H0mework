import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.AttackDefensePhaseReadout
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.Lifecycle.BoundaryGroupActor
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.Society.ExactFutureFreedom
import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Relations.GeneratedRelationRole

/-!
# Source-generated Go relation roles

One exact `ActualPly` supplies a closed relation-beneficiary seed family at
the source boundary of the original `ply.extended.toOccurrence`.  The family
contains the mover-turn aspect, its opponent-turn aspect, and relations
generated by occupied source-board stones.  It contains no constructor for an
arbitrary `RelationProbe`.

The beneficiary actor uses the existing Go control seed and G2 lineage fold.
The relation lineage is the existing G4 `RelationPhaseEdge`; its tactical role
and phase are readouts of that edge.  No player, role, relation registry, or
second occurrence is introduced.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Go
namespace Society
namespace GeneratedRelationRole

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open ProcessGame.Society Lifecycle Universal Relations

/-! ## Exact source-boundary actor face -/

private theorem goSeedAt_all_controls
    {n : Nat} {law : Law} {moves : List (Move n)}
    (source : GeneratedReplay law (Frame.initial n) moves)
    (state : Frame n) (control : Polarity) :
    goSeedAt source state control := by
  cases toMoveEq : state.visible.toMove <;>
    cases control <;> simp [goSeedAt, toMoveEq]

/-- A control seed is active here exactly at the actual ply's source
boundary.  The second conjunct retains the existing G2 Go-seed provenance. -/
def actorSeedAt
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix)
    (source : GeneratedReplay law (Frame.initial n)
      (moves ++ [ply.emitted]))
    (state : Frame n) (control : Polarity) : Prop :=
  state = replayPrefix.final ∧ goSeedAt source state control

/-- The source boundary occurs in the original extended replay occurrence. -/
theorem sourceBoundary_mem_occurrence
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix) :
    replayPrefix.final ∈ (goProcessGame ply.extended).occurrence.trace :=
  (BoundaryGroupActor.core ply).source_state_mem

/-- Exact control seed at the source boundary of `ply.extended`. -/
def exactActorSeed
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix) (control : Polarity) :
    SourceSeed (@goOccurrenceOf n law (moves ++ [ply.emitted])) Polarity
      (actorSeedAt ply) ply.extended :=
  ⟨control, ⟨replayPrefix.final, sourceBoundary_mem_occurrence ply,
    rfl, goSeedAt_all_controls ply.extended replayPrefix.final control⟩⟩

/-- M0 actor face restricted to this exact event boundary.  Its lineage is
the already generated G2 player lineage, not a new player carrier. -/
def actorFace
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix) :
    M0BoundaryFace (@goOccurrenceOf n law (moves ++ [ply.emitted])) where
  Seed := Polarity
  Lineage := goLineage
  SeedAt := actorSeedAt ply
  lineageOf := fun source seed => source.lineage seed.1
  state := fun _ => replayPrefix.final
  seedAt_state := fun _ _ _ active => active.1

/-! ## Closed relation-beneficiary seed family -/

/-- The opposite-turn aspect generated from one exact replay current. -/
def opponentTurnRelationAt {n : Nat} {law : Law} {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) :
    RelationProbe n where
  holds := fun frame => decide
    (frame.visible.toMove ≠ replay.final.visible.toMove)

@[simp] theorem opponentTurnRelationAt_fails_current
    {n : Nat} {law : Law} {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) :
    (opponentTurnRelationAt replay).holds replay.final = false := by
  simp [opponentTurnRelationAt]

/-- Closed source-generated relation seeds.  In particular, there is no
constructor carrying a caller-selected `RelationProbe`. -/
inductive RelationSeed
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix) where
  | moverTurn
  | opponentTurn
  | sourceGroup
      (stone : OccupiedStone replayPrefix.final.visible.board)

/-- The relation probe generated by each closed source seed. -/
def relationProbe
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix) :
    RelationSeed ply → RelationProbe n
  | .moverTurn => sourceTurnRelationAt replayPrefix
  | .opponentTurn => opponentTurnRelationAt replayPrefix
  | .sourceGroup stone => groupRelationProbe (snapshotGroupOf stone)

/-- Both turn aspects benefit the actual mover lineage.  A group relation
benefits the generated control lineage of its occupied representative. -/
def beneficiaryControl
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix) :
    RelationSeed ply → Polarity
  | .moverTurn => replayPrefix.final.visible.toMove
  | .opponentTurn => replayPrefix.final.visible.toMove
  | .sourceGroup stone => stone.polarity

/-- Relation seeds are admitted only at the same exact source boundary as
their beneficiary actor seeds. -/
def relationSeedAt
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix)
    (_source : GeneratedReplay law (Frame.initial n)
      (moves ++ [ply.emitted]))
    (state : Frame n) (_seed : RelationSeed ply) : Prop :=
  state = replayPrefix.final

/-! ## Existing G4 edge as the relation lineage -/

/-- Every closed seed starts one exact retained G4 relation lineage and then
crosses the supplied actual ply.  Horizon is fixed in the compiler instance;
the transport law is the closed retention law. -/
def phaseEdge
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (seed : RelationSeed ply) :
    RelationPhaseEdge horizon (RelationTransportLaw.retain n) ply where
  sourceRelation := relationProbe ply seed
  sourceState := .impose
  sourceLineage := .marked replayPrefix (relationProbe ply seed) (by trivial)

/-- Canonical `C4` action on tactical states. -/
def advanceTacticalRole (phase : TacticalPhase)
    (role : TacticalState) : TacticalState :=
  if phase = 0 then role
  else if phase = 1 then advanceStateByComparison role .shrink
  else if phase = 2 then advanceStateByComparison role .incomparable
  else advanceStateByComparison role .grow

@[simp] theorem advanceTacticalRole_freedomPhaseStep
    (comparison : FreedomComparison) (role : TacticalState) :
    advanceTacticalRole (freedomPhaseStep comparison) role =
      advanceStateByComparison role comparison := by
  cases comparison <;> cases role <;> decide

def toFutureSide : EdgeSide → Future.RelationEdgeSide
  | .source => .source
  | .target => .target

/-! ## Universal compiler installation -/

/-- Universal relation-role compiler installed on the original
`ply.extended.toOccurrence`.  Its relation lineage value is exactly the G4
`RelationPhaseEdge`; role and phase are its existing generated readouts. -/
abbrev compiler
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix) :
    SourceOwnedRelationRoleCompiler
      (@goOccurrenceOf n law (moves ++ [ply.emitted]))
      (goProcessGame ply.extended) (actorFace ply) where
  RelationSeed := RelationSeed ply
  RelationLineage := fun _ =>
    RelationPhaseEdge horizon (RelationTransportLaw.retain n) ply
  relationSeedAt := relationSeedAt ply
  relationLineageOf := fun _ seed => phaseEdge horizon ply seed.1
  beneficiaryActorSeed := beneficiaryControl ply
  beneficiaryActor_active := by
    intro source state seed active
    refine ⟨active, ?_⟩
    exact goSeedAt_all_controls source state (beneficiaryControl ply seed)
  Role := fun _ => TacticalState
  Phase := fun _ => TacticalPhase
  sourceRoleOf := fun _ edge => edge.sourceState
  phaseStepOf := fun _ edge => edge.phaseStep
  advanceRole := fun _ phase role => advanceTacticalRole phase role
  FutureCode := List (Move n)
  futureCodeDecidableEq := inferInstance
  futureCodeCarrier := (moveWordsUpTo n horizon).toFinset
  futureIdle := fun word => word = []
  FutureContinuationAt := fun edge side word =>
    Future.HabitableContinuationAt edge (toFutureSide side) word
  futureBoundaryState := fun _ side =>
    match side with
    | .source => replayPrefix.final
    | .target => ply.target
  futureBoundaryState_mem := by
    intro edge side
    cases side with
    | source => exact (BoundaryGroupActor.core ply).source_state_mem
    | target => exact (BoundaryGroupActor.core ply).target_state_mem
  FutureContinuationWitnessAt := fun edge side _word continuation =>
    continuation.continuation.stateTrace ∈
      rootedPaths
        (futureConeAt (Future.replayAt edge (toFutureSide side)).2 horizon)
  futureContinuation_witnessed := by
    intro edge side word continuation
    exact continuation.factors_through_futureCone

/-- Exact relation seed with the source-boundary occurrence witness. -/
def exactRelationSeed
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (seed : RelationSeed ply) :
    (compiler horizon ply).ExactRelationSeed :=
  ⟨seed, ⟨replayPrefix.final, sourceBoundary_mem_occurrence ply, rfl⟩⟩

/-- Generated relation image of one closed exact seed. -/
def generatedRelationOf
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (seed : RelationSeed ply) :
    (compiler horizon ply).GeneratedRelation :=
  (compiler horizon ply).relationOf (exactRelationSeed horizon ply seed)

/-! ## Exact actor, interest, phase, and role bridges -/

/-- The boundary M0 actor image is exactly the existing G2 generated-player
carrier. -/
def generatedActorEquiv
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix) :
    (compiler horizon ply).Actor ≃
      GeneratedReplay.GeneratedPlayer ply.extended :=
  {
    toFun := fun actor => ⟨actor.1, by
      rcases actor.2 with ⟨seed, generated⟩
      exact ⟨seed.1, by
        simpa [compiler, actorFace, goLineage] using generated⟩⟩
    invFun := fun player => ⟨player.1, by
      rcases player.2 with ⟨control, generated⟩
      exact ⟨exactActorSeed ply control, by
        simpa [compiler, actorFace, goLineage, exactActorSeed] using generated⟩⟩
    left_inv := by intro actor; apply Subtype.ext; rfl
    right_inv := by intro player; apply Subtype.ext; rfl
  }

@[simp] theorem generatedActorEquiv_exactRelationSeed_actor
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (seed : RelationSeed ply) :
    generatedActorEquiv horizon ply
        ((exactRelationSeed horizon ply seed).actor (compiler horizon ply)) =
      ply.extended.player (beneficiaryControl ply seed) :=
  rfl

/-- Every closed seed directly generates its actor--relation interest. -/
theorem exactSeed_generates_interest
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (seed : RelationSeed ply) :
    (compiler horizon ply).GeneratedInterestAt
      ((exactRelationSeed horizon ply seed).actor (compiler horizon ply))
      (generatedRelationOf horizon ply seed) :=
  ⟨exactRelationSeed horizon ply seed, rfl, rfl⟩

/-- Go-level restatement of exact same-occurrence interest provenance. -/
theorem exactSeed_interest_provenance
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (seed : RelationSeed ply) :
    ∃ state ∈ (goProcessGame ply.extended).occurrence.trace,
      state = replayPrefix.final ∧
      relationSeedAt ply ply.extended state seed ∧
      actorSeedAt ply ply.extended state (beneficiaryControl ply seed) := by
  simpa [actorFace, compiler, exactRelationSeed] using
    (exactRelationSeed horizon ply seed).exact_state_provenance
      (compiler horizon ply)

@[simp] theorem generated_phaseStep_eq_G4_edge
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (seed : RelationSeed ply) :
    (compiler horizon ply).phaseStep (generatedRelationOf horizon ply seed) =
      (phaseEdge horizon ply seed).phaseStep :=
  rfl

@[simp] theorem generated_source_role_eq_G4_state
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (seed : RelationSeed ply) :
    (compiler horizon ply).roleAt (generatedRelationOf horizon ply seed)
        .source =
      (phaseEdge horizon ply seed).sourceState :=
  rfl

@[simp] theorem generated_target_role_eq_G4_state
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (seed : RelationSeed ply) :
    (compiler horizon ply).roleAt (generatedRelationOf horizon ply seed)
        .target =
      (phaseEdge horizon ply seed).targetState := by
  let edge := phaseEdge horizon ply seed
  change advanceTacticalRole edge.phaseStep edge.sourceState = edge.targetState
  rw [edge.phaseStep_eq_relationPhaseStep]
  change advanceTacticalRole (freedomPhaseStep edge.comparison)
    edge.sourceState = edge.targetState
  rw [advanceTacticalRole_freedomPhaseStep]
  rfl

/-- Fixed actor, generated relation, and edge side have exactly one generated
tactical role. -/
theorem exactSeed_role_total_unique
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (seed : RelationSeed ply) (side : EdgeSide) :
    ∃! role : TacticalState,
      (compiler horizon ply).RelationRoleAt
        ((exactRelationSeed horizon ply seed).actor (compiler horizon ply))
        (generatedRelationOf horizon ply seed) side role :=
  (compiler horizon ply).relationRoleAt_total_unique
    (exactSeed_generates_interest horizon ply seed) side

/-! ## Existing G2 ownership and closed-family separation -/

/-- Index of this exact actual ply inside the extended occurrence's emitted
event list. -/
def actualEventIndex
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix) :
    Fin (moves ++ [ply.emitted]).length :=
  ⟨moves.length, by simp⟩

@[simp] theorem moverAt_actualEventIndex
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix) :
    ply.extended.moverAt (actualEventIndex ply) =
      replayPrefix.final.visible.toMove := by
  simp [GeneratedReplay.moverAt, actualEventIndex,
    GeneratedReplay.ActualPly.extended]

/-- Both turn-aspect interests land on the same occurrence-generated actor. -/
theorem turn_aspects_same_generated_actor
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix) :
    (exactRelationSeed horizon ply (.moverTurn : RelationSeed ply)).actor
        (compiler horizon ply) =
      (exactRelationSeed horizon ply (.opponentTurn : RelationSeed ply)).actor
        (compiler horizon ply) :=
  rfl

/-- The common turn-aspect beneficiary is exactly G2's owner of this actual
ply, not merely a player with the same visible polarity. -/
theorem turn_aspect_beneficiary_owns_actual_event
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix) :
    ply.extended.EventOwnedBy (actualEventIndex ply)
      (generatedActorEquiv horizon ply
        ((exactRelationSeed horizon ply
          (.moverTurn : RelationSeed ply)).actor (compiler horizon ply))) := by
  rw [generatedActorEquiv_exactRelationSeed_actor]
  unfold GeneratedReplay.EventOwnedBy
  exact moverAt_actualEventIndex ply |>.symm

/-- A source-group interest reads as the existing generated player of its
occupied representative's polarity. -/
theorem sourceGroup_beneficiary_is_existing_generatedPlayer
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (stone : OccupiedStone replayPrefix.final.visible.board) :
    generatedActorEquiv horizon ply
        ((exactRelationSeed horizon ply
          (.sourceGroup stone : RelationSeed ply)).actor
            (compiler horizon ply)) =
      ply.extended.player stone.polarity :=
  rfl

/-- The two turn probes are genuinely distinct at their exact source current. -/
theorem moverTurnRelation_ne_opponentTurnRelation
    {n : Nat} {law : Law} {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) :
    sourceTurnRelationAt replay ≠ opponentTurnRelationAt replay := by
  intro equal
  have atCurrent := congrArg
    (fun relation : RelationProbe n => relation.holds replay.final) equal
  simp [opponentTurnRelationAt] at atCurrent

/-- One actor therefore bears two distinct source-generated relation
interests on the same actual ply.  Downstream concrete freedom comparisons
may and do give these two relations different tactical roles. -/
theorem turn_aspects_generate_distinct_interests_for_same_actor
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix) :
    let moverSeed : RelationSeed ply := .moverTurn
    let opponentSeed : RelationSeed ply := .opponentTurn
    let actor := (exactRelationSeed horizon ply moverSeed).actor
      (compiler horizon ply)
    (compiler horizon ply).GeneratedInterestAt actor
        (generatedRelationOf horizon ply moverSeed) ∧
      (compiler horizon ply).GeneratedInterestAt actor
        (generatedRelationOf horizon ply opponentSeed) ∧
      generatedRelationOf horizon ply moverSeed ≠
        generatedRelationOf horizon ply opponentSeed := by
  dsimp
  refine ⟨exactSeed_generates_interest horizon ply .moverTurn, ?_, ?_⟩
  · simpa [turn_aspects_same_generated_actor horizon ply] using
      exactSeed_generates_interest horizon ply
        (.opponentTurn : RelationSeed ply)
  · intro equal
    have edgeEqual := congrArg Subtype.val equal
    have relationEqual := congrArg RelationPhaseEdge.sourceRelation edgeEqual
    exact moverTurnRelation_ne_opponentTurnRelation replayPrefix relationEqual

end GeneratedRelationRole
