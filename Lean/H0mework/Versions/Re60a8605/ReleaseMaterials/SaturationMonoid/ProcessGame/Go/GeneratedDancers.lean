import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.GeneratedPlayerLineage
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.GeneratedGroupLineage

/-!
# Combined generated dancers

This module is the G2 integration seam.  For one replay generated from the
fixed initial current it combines exact-ply player ownership with snapshot
group decomposition.  It introduces neither a player enumeration nor a group
identifier; both carriers are the outputs of their same-occurrence lineage
producers.  Tactical roles remain absent until G4 relation phase generation.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Go

/-- Timed snapshot group generated by an occupied stone at one exact replay
state. -/
def timedSnapshotGroupOf {n : Nat} {law : Law} {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    (time : Fin replay.toOccurrence.trace.length)
    (stone : OccupiedStone ((replay.toOccurrence.trace.get time).visible.board)) :
    ReplaySnapshotGroup replay where
  time := time
  group := snapshotGroupOf stone

/-- G2's joint consumer mouth.  Every field is generated from the supplied
actual replay; callers do not submit a partition, group registry or naming. -/
structure GeneratedDancersAt {n : Nat} {law : Law} {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) where
  owner : Fin moves.length → GeneratedReplay.GeneratedPlayer replay
  owner_exact : ∀ index, replay.EventOwnedBy index (owner index)
  owner_unique : ∀ index candidate,
    replay.EventOwnedBy index candidate → candidate = owner index
  snapshotGroup : ∀ (time : Fin replay.toOccurrence.trace.length),
    OccupiedStone ((replay.toOccurrence.trace.get time).visible.board) →
      SnapshotGroup ((replay.toOccurrence.trace.get time).visible.board)
  snapshot_exact : ∀ (time : Fin replay.toOccurrence.trace.length)
      (stone : OccupiedStone ((replay.toOccurrence.trace.get time).visible.board)),
    StoneBelongsToSnapshotGroup stone (snapshotGroup time stone)
  snapshot_unique : ∀ (time : Fin replay.toOccurrence.trace.length)
      (stone : OccupiedStone ((replay.toOccurrence.trace.get time).visible.board))
      (candidate : SnapshotGroup ((replay.toOccurrence.trace.get time).visible.board)),
    StoneBelongsToSnapshotGroup stone candidate →
      candidate = snapshotGroup time stone

/-- Player and snapshot-group carriers are jointly generated from one actual
replay. -/
def generatedDancersAt {n : Nat} {law : Law} {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) :
    GeneratedDancersAt replay where
  owner := replay.generatedOwner
  owner_exact := fun _ => rfl
  owner_unique := by
    intro index candidate owned
    exact (replay.everyMoveOwnedByExactlyOneGeneratedPlayer index).unique owned rfl
  snapshotGroup := fun _ stone => snapshotGroupOf stone
  snapshot_exact := fun _ _ => rfl
  snapshot_unique := by
    intro time stone candidate belongs
    exact belongs.symm

/-- Persistent identity readout for the exact timed snapshot group generated
by a stone.  Identity is the replay-wide exact transport closure. -/
def GeneratedDancersAt.groupIdentity {n : Nat} {law : Law}
    {moves : List (Move n)} {replay : GeneratedReplay law (Frame.initial n) moves}
    (_generated : GeneratedDancersAt replay)
    (time : Fin replay.toOccurrence.trace.length)
    (stone : OccupiedStone ((replay.toOccurrence.trace.get time).visible.board)) :
    GeneratedGroupIdentity replay :=
  generatedGroupIdentityOf (timedSnapshotGroupOf time stone)

end Go
end ProcessGame
end SaturationMonoid
