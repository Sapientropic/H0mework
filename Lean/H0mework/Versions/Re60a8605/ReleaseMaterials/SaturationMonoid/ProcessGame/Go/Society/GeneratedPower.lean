/-!
# Actual Go action power from generated relation freedom

The existing actual ply generates an exact controller through G2's mover
lineage.  A closed relation-beneficiary seed generates the affected actor and
G4 phase, while exact G3/G4 future fibres supply the actionable change.  The
result is an instance of the universal action-power mouth on the original
`ply.extended.toOccurrence`.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Go
namespace Society
namespace GeneratedPower

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open ProcessGame.Society Lifecycle Universal Relations Power
open GeneratedRelationRole
open Future

/-! ## Exact controller generated by the actual ply -/

/-- The sole action seed is the supplied exact actual ply itself.  It is
admitted at the generated target state and compiles to the source mover's G2
lineage in the same extended occurrence. -/
def controllerCompiler
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix) :
    SourceOwnedActionControllerCompiler (goProcessGame ply.extended)
      (actorFace ply) where
  ActionSeed := Unit
  actionAdmittedAt := fun _ => True
  actionState := fun _ => ply.target
  actionState_mem := (BoundaryGroupActor.core ply).target_state_mem
  actorState_mem := sourceBoundary_mem_occurrence ply
  actorSeed := fun _ => replayPrefix.final.visible.toMove
  actorSeed_active := by
    intro action admitted
    refine ⟨rfl, ?_⟩
    change replayPrefix.final.visible.toMove =
        replayPrefix.final.visible.toMove ∨
      replayPrefix.final.visible.toMove =
        replayPrefix.final.visible.toMove.other
    exact Or.inl rfl

/-- Exact target-state action occurrence. -/
def exactActionSeed
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix) :
    (controllerCompiler ply).ExactActionSeed :=
  ⟨(), ply.target, (BoundaryGroupActor.core ply).target_state_mem, rfl, trivial⟩

/-- Generated controller actor of this exact action. -/
def controllerActor
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix) :
    (compiler 0 ply).Actor :=
  (exactActionSeed ply).actor (controllerCompiler ply)

/-- The controller actor is independent of the horizon used for a relation
readout; all horizons consume the same M0 actor face. -/
def controllerActorAt
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix) :
    (compiler horizon ply).Actor :=
  (exactActionSeed ply).actor (controllerCompiler ply)

/-- The exact controller is the existing G2 owner of the last actual event. -/
theorem controllerActor_is_existing_actual_owner
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix) :
    ply.extended.EventOwnedBy (actualEventIndex ply)
      (generatedActorEquiv horizon ply (controllerActorAt horizon ply)) := by
  change ply.extended.EventOwnedBy (actualEventIndex ply)
    (ply.extended.player replayPrefix.final.visible.toMove)
  unfold GeneratedReplay.EventOwnedBy
  exact (moverAt_actualEventIndex ply).symm

/-! ## Exact future fibres and universal power installation -/

/-- The Go relation compiler's phase type is exactly the existing `C4`. -/
instance generatedRelationPhaseZero
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix) :
    Zero ((compiler horizon ply).Phase (goProcessGame ply.extended).source) := by
  change Zero TacticalPhase
  infer_instance

abbrev WordIdle {n : Nat} (word : List (Move n)) : Prop :=
  word = []

noncomputable abbrev SourceCodes
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {ply : GeneratedReplay.ActualPly replayPrefix}
    (seed : RelationSeed ply) :=
  (compiler horizon ply).futureCodesAt
    (generatedRelationOf horizon ply seed) .source

noncomputable abbrev TargetCodes
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat} {ply : GeneratedReplay.ActualPly replayPrefix}
    (seed : RelationSeed ply) :=
  (compiler horizon ply).futureCodesAt
    (generatedRelationOf horizon ply seed) .target

/-- Exact generated-interest beneficiary of one closed relation seed. -/
def affectedActor
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (seed : RelationSeed ply) : (compiler horizon ply).Actor :=
  (exactRelationSeed horizon ply seed).actor (compiler horizon ply)

/-- Nontrivial relation phase over the exact generated interest.  No actual
controller is claimed at this weaker constraint mouth. -/
theorem constraintPowerOf
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (seed : RelationSeed ply)
    (phaseNonzero : (phaseEdge horizon ply seed).phaseStep ≠ 0) :
    ConstraintPowerOverAt (compiler horizon ply)
      (affectedActor horizon ply seed)
      (generatedRelationOf horizon ply seed) where
  interest := exactSeed_generates_interest horizon ply seed
  phase_nonzero := by
    rw [generated_phaseStep_eq_G4_edge]
    exact phaseNonzero

/-- Full actual power constructor.  Actor labels, relation, future fibres and
change kind are all fixed by exact seeds/witnesses; the caller supplies only
the mathematical proof that the already generated phase is nonzero and the
exact actionable-delta witness. -/
noncomputable def actionPowerOf
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (seed : RelationSeed ply)
    (phaseNonzero : (phaseEdge horizon ply seed).phaseStep ≠ 0)
    (change : ActionableFreedomChange (@WordIdle n)
      (SourceCodes (horizon := horizon) seed)
      (TargetCodes (horizon := horizon) seed)) :
    ActionPowerOverAt (compiler horizon ply) (controllerCompiler ply)
      (controllerActorAt horizon ply) (affectedActor horizon ply seed)
      (generatedRelationOf horizon ply seed) where
  action := exactActionSeed ply
  controller_exact := rfl
  constraint := constraintPowerOf horizon ply seed phaseNonzero
  freedomChange := change

/-- Search-side opportunity from one exact actionable future code.  It has
no action seed or controller field. -/
noncomputable def opportunityOf
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (horizon : Nat) (ply : GeneratedReplay.ActualPly replayPrefix)
    (seed : RelationSeed ply) (side : EdgeSide)
    (word : List (Move n))
    (actionable : word ∈
      ActionableFutureFreedomCodesAt (phaseEdge horizon ply seed)
        (RelationFutureAuthority.toGoSide side)) :
    PowerOpportunityAt (compiler horizon ply)
      (affectedActor horizon ply seed)
      (generatedRelationOf horizon ply seed)
      side := by
  have facts :=
    (mem_ActionableFutureFreedomCodesAt_iff
      (phaseEdge horizon ply seed)
      (RelationFutureAuthority.toGoSide side) word).mp actionable
  exact {
    interest := exactSeed_generates_interest horizon ply seed
    code := word
    actionable := ⟨by
      rw [RelationFutureAuthority.player_codesAt_eq_exactFutureFreedom]
      exact (mem_FutureFreedomCodesAt_iff
        (phaseEdge horizon ply seed)
        (RelationFutureAuthority.toGoSide side) word).mpr facts.1,
      facts.2⟩
  }

end GeneratedPower
end Society
end Go
