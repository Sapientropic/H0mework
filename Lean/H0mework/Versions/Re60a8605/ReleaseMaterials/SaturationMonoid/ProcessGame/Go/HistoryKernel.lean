import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.RulesKernel
import H0mework.Foundation.Source.AccountedUnfolding

/-!
# Actual Go history on the shared rooted unfolding

`GeneratedReplay` is the dependent actual spine: every event carries the exact
`LegalStep` generated by the fixed rule compiler.  The public producer starts
only from `Frame.initial`; callers supply neither a target, a seen-set nor a
completed history.

The spine is represented by the existing one-constructor
`RootedAccountedUnfolding`.  Its situation trace is exactly the final frame's
positional-superko accumulator, and its sole fold computes the same final
visible position as replay.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Go

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot

/-- A finite actual replay from `start`, indexed by the exact emitted move
list.  There is no invalid, unknown or caller-selected target constructor. -/
inductive GeneratedReplay {n : Nat} (law : Law) :
    (start : Frame n) → List (Move n) → Type where
  | nil (start : Frame n) : GeneratedReplay law start []
  | cons {start next : Frame n} {moves : List (Move n)}
      (move : Move n)
      (step : LegalStep law start move next)
      (tail : GeneratedReplay law next moves) :
      GeneratedReplay law start (move :: moves)

namespace GeneratedReplay

/-- Final current generated by the exact replay. -/
def final {n : Nat} {law : Law} {start : Frame n} {moves : List (Move n)} :
    GeneratedReplay law start moves → Frame n
  | .nil _ => start
  | .cons _ _ tail => tail.final

/-- The actual current lineage, including the initial and final currents. -/
def stateTrace {n : Nat} {law : Law} {start : Frame n}
    {moves : List (Move n)} :
    GeneratedReplay law start moves → List (Frame n)
  | .nil _ => [start]
  | .cons _ _ tail => start :: tail.stateTrace

/-- Generated child situations, excluding the supplied start current. -/
def tailSituations {n : Nat} {law : Law} {start : Frame n}
    {moves : List (Move n)} :
    GeneratedReplay law start moves → List (Situation n)
  | .nil _ => []
  | @cons _ _ start next moves move step tail =>
      next.visible.situation :: tail.tailSituations

/-- The exact singleton occurrence spine in the existing shared unfolding. -/
def toOccurrence {n : Nat} {law : Law} {start : Frame n}
    {moves : List (Move n)} :
    GeneratedReplay law start moves → RootedAccountedUnfolding (Frame n)
  | .nil _ => .zero start
  | .cons _ _ tail =>
      .occur start (AccountedBranches.singleton tail.toOccurrence)

/-- The sole actual-final evaluator algebra.  Actual replay has zero or one
child at each node; G3's possibility siblings are never fed to this algebra as
actual authority. -/
def finalAlgebra {n : Nat} (current : Frame n) : List (Frame n) → Frame n
  | [] => current
  | child :: _ => child

@[simp] theorem trace_zero {n : Nat} (frame : Frame n) :
    (RootedAccountedUnfolding.zero frame).trace = [frame] := by
  unfold RootedAccountedUnfolding.zero RootedAccountedUnfolding.trace
  rfl

@[simp] theorem trace_occur_singleton {n : Nat} (frame : Frame n)
    (child : RootedAccountedUnfolding (Frame n)) :
    (RootedAccountedUnfolding.occur frame
      (AccountedBranches.singleton child)).trace = frame :: child.trace := by
  unfold RootedAccountedUnfolding.trace AccountedBranches.singleton
  simp

theorem occurrence_trace_eq_stateTrace {n : Nat} {law : Law}
    {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves) :
    replay.toOccurrence.trace = replay.stateTrace := by
  induction replay with
  | nil => simp [toOccurrence, stateTrace]
  | @cons start next moves move step tail ih =>
      simp [toOccurrence, stateTrace, ih]

theorem stateTrace_situations_eq {n : Nat} {law : Law}
    {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves) :
    replay.stateTrace.map (fun frame => frame.visible.situation) =
      start.visible.situation :: replay.tailSituations := by
  induction replay with
  | nil => simp [stateTrace, tailSituations]
  | @cons start next moves move step tail ih =>
      simp [stateTrace, tailSituations, ih]

/-- Native child write-back accumulates exactly the situations generated by
the actual spine. -/
theorem final_positionHistory_eq {n : Nat} {law : Law}
    {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves) :
    replay.final.positionHistory =
      start.positionHistory ++ replay.tailSituations := by
  induction replay with
  | nil => simp [final, tailSituations]
  | @cons start next moves move step tail ih =>
      calc
        tail.final.positionHistory =
            next.positionHistory ++ tail.tailSituations := ih
        _ = (start.positionHistory ++ [next.visible.situation]) ++
              tail.tailSituations := by
            rw [nativeStep_positionHistory_eq step]
        _ = start.positionHistory ++
              (next.visible.situation :: tail.tailSituations) := by
            simp [List.append_assoc]

/-- The existing occurrence fold computes the generated final current. -/
theorem occurrence_fold_eq_final {n : Nat} {law : Law}
    {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves) :
    replay.toOccurrence.fold finalAlgebra = replay.final := by
  induction replay with
  | nil => rfl
  | @cons start next moves move step tail ih =>
      change finalAlgebra start [tail.toOccurrence.fold finalAlgebra] = tail.final
      exact ih

/-- Direct consumption of `fold_unique`: every evaluator commuting with the
one occurrence constructor factors through the same generated final current. -/
theorem evaluator_eq_final {n : Nat} {law : Law}
    {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves)
    (candidate : RootedAccountedUnfolding (Frame n) → Frame n)
    (commutes : ∀ (origin : Frame n)
        (branches : AccountedBranches (Frame n)),
      candidate (.occur origin branches) =
        finalAlgebra origin
          (RootedAccountedUnfolding.candidateValues candidate branches)) :
    candidate replay.toOccurrence = replay.final := by
  calc
    candidate replay.toOccurrence =
        replay.toOccurrence.fold finalAlgebra :=
      RootedAccountedUnfolding.fold_unique finalAlgebra candidate commutes _
    _ = replay.final := occurrence_fold_eq_final replay

end GeneratedReplay

/-- Internal recursion used only to implement the source-fixed producer. -/
private def generateFrom? {n : Nat} (law : Law) (start : Frame n) :
    (moves : List (Move n)) → Option (GeneratedReplay law start moves)
  | [] => some (.nil start)
  | move :: moves =>
      match generated : nativeStep? law start move with
      | none => none
      | some next =>
          match generateFrom? law next moves with
          | none => none
          | some tail => some (.cons move generated tail)

/-- Linear executable projection of the same fixed compiler.  It has no
authority by itself; the theorem below identifies it with `GeneratedReplay`'s
final current whenever the source-fixed producer succeeds. -/
def replayFrom? {n : Nat} (law : Law) :
    Frame n → List (Move n) → Option (Frame n)
  | start, [] => some start
  | start, move :: moves =>
      match nativeStep? law start move with
      | none => none
      | some next => replayFrom? law next moves

private theorem replayFrom_eq_final {n : Nat} {law : Law}
    {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves) :
    replayFrom? law start moves = some replay.final := by
  induction replay with
  | nil => rfl
  | @cons start next moves move step tail ih =>
      unfold LegalStep at step
      change (match nativeStep? law start move with
        | none => none
        | some generatedNext => replayFrom? law generatedNext moves) =
          some tail.final
      rw [step]
      exact ih

/-- Public actual-history producer.  The caller supplies only the fixed law,
board size and source event list; the initial current, every target and the
entire position prefix are generated. -/
def generate? (law : Law) (n : Nat) (moves : List (Move n)) :
    Option (GeneratedReplay law (Frame.initial n) moves) :=
  generateFrom? law (Frame.initial n) moves

/-- Raw final-frame readout of the authoritative producer. -/
def replay? (law : Law) (n : Nat) (moves : List (Move n)) : Option (Frame n) :=
  replayFrom? law (Frame.initial n) moves

/-- A successfully generated history carries its replay value definitionally;
no second replay relation or target witness is introduced. -/
theorem replay_eq_some_final {n : Nat} {law : Law} {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) :
    replay? law n moves = some replay.final := by
  exact replayFrom_eq_final replay

/-- For histories generated from the fixed initial current, the final superko
prefix is exactly the situation projection of the same root occurrence trace.
This is the no-forged-seen-set theorem. -/
theorem generated_occurrence_situations_eq_positionHistory {n : Nat}
    {law : Law} {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) :
    replay.toOccurrence.trace.map (fun frame => frame.visible.situation) =
      replay.final.positionHistory := by
  calc
    replay.toOccurrence.trace.map (fun frame => frame.visible.situation) =
        replay.stateTrace.map (fun frame => frame.visible.situation) := by
      rw [replay.occurrence_trace_eq_stateTrace]
    _ = (Frame.initial n).visible.situation :: replay.tailSituations :=
      replay.stateTrace_situations_eq
    _ = (Frame.initial n).positionHistory ++ replay.tailSituations := rfl
    _ = replay.final.positionHistory := replay.final_positionHistory_eq.symm

/-- Event fold and visible replay are the same readout of the same actual
occurrence. -/
theorem generated_occurrence_fold_visible_eq_replay {n : Nat}
    {law : Law} {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) :
    (replay.toOccurrence.fold GeneratedReplay.finalAlgebra).visible =
      replay.final.visible := by
  exact congrArg Frame.visible replay.occurrence_fold_eq_final

end Go
end ProcessGame
end SaturationMonoid
