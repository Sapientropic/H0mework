import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.HistoryKernel
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.ComponentCorrectness
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.ReplayContinuation

/-!
# Generated Go group lineage

Snapshot groups are quotients of occupied stones by the exact component
carrier computed by `groupAt`.  Consequently a group has no primitive name or
identifier: its identity is precisely its board-generated carrier.

Across two boards, transport is witnessed only by one exact stone occurrence
which remains at the same point with the same polarity.  Merge and split are
then opposite failures of injectivity/functionality of that transport;
capture is the terminal removal of an entire generated carrier.  Raw
`LegalStep` restrictions remain subordinate compiler semantics; actual mouths
are indexed by `GeneratedReplay.ActualPly`, which extends a replay generated
from `Frame.initial` without introducing a second occurrence or ledger.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Go

/-- An occupied point together with the polarity generated by the board. -/
structure OccupiedStone {n : Nat} (board : Board n) where
  point : Point n
  polarity : Polarity
  occupied : board point = some polarity

/-- Two occupied stones present the same snapshot group exactly when the
existing board kernel computes the same component carrier from them. -/
def SameSnapshotGroup {n : Nat} {board : Board n}
    (left right : OccupiedStone board) : Prop :=
  groupAt board left.point = groupAt board right.point

/-- Equality of generated component carriers is the snapshot-group setoid. -/
def snapshotGroupSetoid {n : Nat} (board : Board n) :
    Setoid (OccupiedStone board) where
  r := SameSnapshotGroup
  iseqv := {
    refl := fun _ => rfl
    symm := fun equalCarrier => equalCarrier.symm
    trans := fun left middle => left.trans middle
  }

/-- A snapshot group is a presentation quotient of occupied stones.  There is
no `GroupId`: changing the exact generated carrier changes the group. -/
abbrev SnapshotGroup {n : Nat} (board : Board n) :=
  Quotient (snapshotGroupSetoid board)

/-- The unique snapshot group generated by an occupied stone. -/
def snapshotGroupOf {n : Nat} {board : Board n}
    (stone : OccupiedStone board) : SnapshotGroup board :=
  Quotient.mk _ stone

namespace SnapshotGroup

/-- The component carrier descends through the quotient definitionally. -/
def carrier {n : Nat} {board : Board n} :
    SnapshotGroup board → Finset (Point n) :=
  Quotient.lift
    (fun stone : OccupiedStone board => groupAt board stone.point)
    (fun _ _ equalCarrier => equalCarrier)

@[simp] theorem carrier_snapshotGroupOf {n : Nat} {board : Board n}
    (stone : OccupiedStone board) :
    carrier (snapshotGroupOf stone) = groupAt board stone.point :=
  rfl

/-- Snapshot-group equality is exactly equality of the generated component
carrier, not equality of a name, shape tag or external identifier. -/
theorem eq_iff_carrier_eq {n : Nat} {board : Board n}
    {left right : SnapshotGroup board} :
    left = right ↔ carrier left = carrier right := by
  constructor
  · intro equalGroups
    exact congrArg carrier equalGroups
  · refine Quotient.inductionOn₂ left right ?_
    intro leftStone rightStone equalCarrier
    exact Quotient.sound equalCarrier

/-- The board-generated polarity descends through exact carrier equality. -/
def polarity {n : Nat} {board : Board n} : SnapshotGroup board → Polarity :=
  Quotient.lift OccupiedStone.polarity (fun left right equalCarrier => by
    have leftMember : left.point ∈ groupAt board left.point :=
      occupied_point_mem_groupAt left.occupied
    have leftMemberRight : left.point ∈ groupAt board right.point := by
      rw [← equalCarrier]
      exact leftMember
    have rightColour : board left.point = some right.polarity :=
      groupAt_member_colour right.occupied leftMemberRight
    exact Option.some.inj (left.occupied.symm.trans rightColour))

@[simp] theorem polarity_snapshotGroupOf {n : Nat} {board : Board n}
    (stone : OccupiedStone board) :
    polarity (snapshotGroupOf stone) = stone.polarity :=
  rfl

end SnapshotGroup

/-- Canonical membership in the snapshot partition: an occupied stone belongs
to exactly the quotient class generated by its board component. -/
def StoneBelongsToSnapshotGroup {n : Nat} {board : Board n}
    (stone : OccupiedStone board) (group : SnapshotGroup board) : Prop :=
  snapshotGroupOf stone = group

/-- Every occupied stone lies in the carrier of its generated quotient class. -/
theorem occupiedStone_mem_snapshotGroup_carrier {n : Nat}
    {board : Board n} (stone : OccupiedStone board) :
    stone.point ∈ (snapshotGroupOf stone).carrier := by
  exact occupied_point_mem_groupAt stone.occupied

/-- Carrier membership and quotient-class membership are the same generated
snapshot decomposition.  This consumes worklist saturation rather than merely
restating the quotient constructor. -/
theorem stoneBelongsToSnapshotGroup_iff_mem_carrier {n : Nat}
    {board : Board n} (stone : OccupiedStone board)
    (group : SnapshotGroup board) :
    StoneBelongsToSnapshotGroup stone group ↔ stone.point ∈ group.carrier := by
  refine Quotient.inductionOn group ?_
  intro representative
  constructor
  · intro belongs
    have equalCarrier := SnapshotGroup.eq_iff_carrier_eq.mp belongs
    rw [← equalCarrier]
    exact occupiedStone_mem_snapshotGroup_carrier stone
  · intro member
    apply SnapshotGroup.eq_iff_carrier_eq.mpr
    exact groupAt_eq_of_mem representative.occupied member

/-- Every occupied stone has one and only one generated snapshot group, and
the board-kernel correctness theorem puts the stone inside that carrier. -/
theorem occupiedStone_unique_snapshotGroup {n : Nat} {board : Board n}
    (stone : OccupiedStone board) :
    ∃! group : SnapshotGroup board,
      StoneBelongsToSnapshotGroup stone group ∧ stone.point ∈ group.carrier := by
  refine ⟨snapshotGroupOf stone,
    ⟨rfl, occupiedStone_mem_snapshotGroup_carrier stone⟩, ?_⟩
  intro group belongs
  exact belongs.1.symm

/-- Every quotient class has an occupied representative contained in its
exact component carrier. -/
theorem snapshotGroup_has_occupied_member {n : Nat} {board : Board n}
    (group : SnapshotGroup board) :
    ∃ stone : OccupiedStone board,
      StoneBelongsToSnapshotGroup stone group ∧ stone.point ∈ group.carrier := by
  refine Quotient.inductionOn group ?_
  intro stone
  exact ⟨stone, rfl, occupiedStone_mem_snapshotGroup_carrier stone⟩

/-- Two snapshot carriers that overlap at any board point are the same
generated group; distinct classes are therefore disjoint. -/
theorem snapshotGroup_eq_of_common_point {n : Nat} {board : Board n}
    {left right : SnapshotGroup board} {point : Point n}
    (leftMember : point ∈ left.carrier)
    (rightMember : point ∈ right.carrier) :
    left = right := by
  rcases snapshotGroup_has_occupied_member left with
    ⟨representative, representativeBelongs, _⟩
  have pointOccupied : board point = some representative.polarity := by
    have leftCarrierEq : left.carrier = groupAt board representative.point := by
      rw [← representativeBelongs]
      rfl
    rw [leftCarrierEq] at leftMember
    exact groupAt_member_colour representative.occupied leftMember
  let stone : OccupiedStone board := {
    point := point
    polarity := representative.polarity
    occupied := pointOccupied
  }
  have belongsLeft : StoneBelongsToSnapshotGroup stone left :=
    (stoneBelongsToSnapshotGroup_iff_mem_carrier stone left).2 leftMember
  have belongsRight : StoneBelongsToSnapshotGroup stone right :=
    (stoneBelongsToSnapshotGroup_iff_mem_carrier stone right).2 rightMember
  exact belongsLeft.symm.trans belongsRight

/-- An exact stone occurrence surviving from `before` to `after`.  Same point
and same polarity are data of the witness, so a lookalike stone elsewhere
cannot transport group identity. -/
structure SurvivingStone {n : Nat} (before after : Board n) where
  point : Point n
  polarity : Polarity
  before_occupied : before point = some polarity
  after_occupied : after point = some polarity

namespace SurvivingStone

def source {n : Nat} {before after : Board n}
    (stone : SurvivingStone before after) : OccupiedStone before where
  point := stone.point
  polarity := stone.polarity
  occupied := stone.before_occupied

def target {n : Nat} {before after : Board n}
    (stone : SurvivingStone before after) : OccupiedStone after where
  point := stone.point
  polarity := stone.polarity
  occupied := stone.after_occupied

def sourceGroup {n : Nat} {before after : Board n}
    (stone : SurvivingStone before after) : SnapshotGroup before :=
  snapshotGroupOf stone.source

def targetGroup {n : Nat} {before after : Board n}
    (stone : SurvivingStone before after) : SnapshotGroup after :=
  snapshotGroupOf stone.target

@[simp] theorem sourceGroup_carrier {n : Nat} {before after : Board n}
    (stone : SurvivingStone before after) :
    stone.sourceGroup.carrier = groupAt before stone.point :=
  rfl

@[simp] theorem targetGroup_carrier {n : Nat} {before after : Board n}
    (stone : SurvivingStone before after) :
    stone.targetGroup.carrier = groupAt after stone.point :=
  rfl

end SurvivingStone

/-- Exact group transport is inhabited by a same-point, same-polarity stone
occurrence whose source and target component classes are the stated groups. -/
def ExactGroupTransport {n : Nat} {before after : Board n}
    (source : SnapshotGroup before) (target : SnapshotGroup after) : Prop :=
  ∃ stone : SurvivingStone before after,
    stone.sourceGroup = source ∧ stone.targetGroup = target

/-- Exact same-stone transport preserves the generated group polarity. -/
theorem exactGroupTransport_polarity_eq {n : Nat} {before after : Board n}
    {source : SnapshotGroup before} {target : SnapshotGroup after}
    (transport : ExactGroupTransport source target) :
    source.polarity = target.polarity := by
  rcases transport with ⟨stone, source_eq, target_eq⟩
  rw [← source_eq, ← target_eq]
  rfl

/-- Data-bearing survive disposition for direct consumers. -/
structure SurviveDisposition {n : Nat} {before after : Board n}
    (source : SnapshotGroup before) (target : SnapshotGroup after) where
  stone : SurvivingStone before after
  source_eq : stone.sourceGroup = source
  target_eq : stone.targetGroup = target

namespace SurviveDisposition

theorem exactTransport {n : Nat} {before after : Board n}
    {source : SnapshotGroup before} {target : SnapshotGroup after}
    (survives : SurviveDisposition source target) :
    ExactGroupTransport source target :=
  ⟨survives.stone, survives.source_eq, survives.target_eq⟩

end SurviveDisposition

/-- Two distinct source groups merge when exact surviving stones from them
land in one generated target component. -/
structure MergeDisposition {n : Nat} (before after : Board n) where
  left : SurvivingStone before after
  right : SurvivingStone before after
  distinctSources : left.sourceGroup ≠ right.sourceGroup
  commonTarget : left.targetGroup = right.targetGroup

namespace MergeDisposition

/-- The target class carried by the first exact surviving stone. -/
def successor {n : Nat} {before after : Board n}
    (merge : MergeDisposition before after) : SnapshotGroup after :=
  merge.left.targetGroup

theorem left_transports_to_successor {n : Nat} {before after : Board n}
    (merge : MergeDisposition before after) :
    ExactGroupTransport merge.left.sourceGroup merge.successor :=
  ⟨merge.left, rfl, rfl⟩

theorem right_transports_to_successor {n : Nat} {before after : Board n}
    (merge : MergeDisposition before after) :
    ExactGroupTransport merge.right.sourceGroup merge.successor :=
  ⟨merge.right, rfl, merge.commonTarget.symm⟩

end MergeDisposition

/-- A generic board transporter records a split exactly when two surviving
stones leave one source component but land in distinct target components.
This type is intentionally not itself actual-play authority. -/
structure SplitDisposition {n : Nat} (before after : Board n) where
  left : SurvivingStone before after
  right : SurvivingStone before after
  commonSource : left.sourceGroup = right.sourceGroup
  distinctTargets : left.targetGroup ≠ right.targetGroup

namespace SplitDisposition

def leftDescendant {n : Nat} {before after : Board n}
    (split : SplitDisposition before after) : SnapshotGroup after :=
  split.left.targetGroup

def rightDescendant {n : Nat} {before after : Board n}
    (split : SplitDisposition before after) : SnapshotGroup after :=
  split.right.targetGroup

theorem descendants_distinct {n : Nat} {before after : Board n}
    (split : SplitDisposition before after) :
    split.leftDescendant ≠ split.rightDescendant :=
  split.distinctTargets

theorem left_exactTransport {n : Nat} {before after : Board n}
    (split : SplitDisposition before after) :
    ExactGroupTransport split.left.sourceGroup split.leftDescendant :=
  ⟨split.left, rfl, rfl⟩

theorem right_exactTransport {n : Nat} {before after : Board n}
    (split : SplitDisposition before after) :
    ExactGroupTransport split.left.sourceGroup split.rightDescendant :=
  ⟨split.right, split.commonSource.symm, rfl⟩

end SplitDisposition

/-- A generated group is terminally captured when every point of its exact
source carrier is absent from the successor board. -/
structure CaptureTerminalDisposition {n : Nat} (before after : Board n) where
  source : SnapshotGroup before
  removed : ∀ point ∈ source.carrier, after point = none

/-- A whole-carrier capture has no exact surviving-stone transport. -/
theorem CaptureTerminalDisposition.noExactTransport {n : Nat}
    {before after : Board n}
    (capture : CaptureTerminalDisposition before after)
    (target : SnapshotGroup after) :
    ¬ ExactGroupTransport capture.source target := by
  rintro ⟨stone, source_eq, target_eq⟩
  have point_mem : stone.point ∈ capture.source.carrier := by
    rw [← source_eq]
    exact occupiedStone_mem_snapshotGroup_carrier stone.source
  have removed := capture.removed stone.point point_mem
  have occupied := stone.after_occupied
  rw [removed] at occupied
  cases occupied

/-- Functionality of the surviving-stone relation on each source component.
This is the exact local law whose failure would be a partial split. -/
def SourceSuccessorCoherent {n : Nat} (before after : Board n) : Prop :=
  ∀ left right : SurvivingStone before after,
    left.sourceGroup = right.sourceGroup →
      left.targetGroup = right.targetGroup

/-- Executable carrier-level form of source coherence.  It quantifies over
finite points and polarities rather than proof-bearing surviving stones, so a
concrete actual transition can discharge it by kernel reduction. -/
def CarrierSuccessorCoherent {n : Nat} (before after : Board n) : Prop :=
  ∀ (leftPoint rightPoint : Point n)
      (leftPolarity rightPolarity : Polarity),
    before leftPoint = some leftPolarity →
    after leftPoint = some leftPolarity →
    before rightPoint = some rightPolarity →
    after rightPoint = some rightPolarity →
    groupAt before leftPoint = groupAt before rightPoint →
      groupAt after leftPoint = groupAt after rightPoint

instance {n : Nat} (before after : Board n) :
    Decidable (CarrierSuccessorCoherent before after) := by
  unfold CarrierSuccessorCoherent
  infer_instance

/-- Carrier coherence is exactly strong enough to descend surviving stones to
a functional map on snapshot quotient classes. -/
theorem sourceSuccessorCoherent_of_carrier {n : Nat}
    {before after : Board n}
    (coherent : CarrierSuccessorCoherent before after) :
    SourceSuccessorCoherent before after := by
  intro left right equalSource
  apply SnapshotGroup.eq_iff_carrier_eq.mpr
  apply coherent left.point right.point left.polarity right.polarity
      left.before_occupied left.after_occupied
      right.before_occupied right.after_occupied
  exact SnapshotGroup.eq_iff_carrier_eq.mp equalSource

namespace MergeDisposition

/-- Under the exact no-split coherence law, every surviving stone from either
merged parent lands in the one generated successor. -/
theorem successor_unique_of_parent {n : Nat} {before after : Board n}
    (merge : MergeDisposition before after)
    (coherent : SourceSuccessorCoherent before after)
    (stone : SurvivingStone before after)
    (fromParent : stone.sourceGroup = merge.left.sourceGroup ∨
      stone.sourceGroup = merge.right.sourceGroup) :
    stone.targetGroup = merge.successor := by
  rcases fromParent with fromLeft | fromRight
  · exact coherent stone merge.left fromLeft
  · exact (coherent stone merge.right fromRight).trans merge.commonTarget.symm

end MergeDisposition

/-- A source-coherent transition has no split disposition. -/
theorem no_split_of_sourceSuccessorCoherent {n : Nat}
    {before after : Board n}
    (coherent : SourceSuccessorCoherent before after) :
    IsEmpty (SplitDisposition before after) :=
  ⟨fun split =>
    split.distinctTargets
      (coherent split.left split.right split.commonSource)⟩

/-! ## Compiler-step subordinate mouths

The following are dependent restrictions of a raw `LegalStep`.  Since G1
deliberately gives raw frames no reachability authority, these are named
`Step*`, not `Actual*`.  The actual mouths indexed by a replay from
`Frame.initial` follow below.
-/

abbrev StepExactGroupTransport {n : Nat} {law : Law}
    {frame target : Frame n} {move : Move n}
    (_step : LegalStep law frame move target)
    (source : SnapshotGroup frame.visible.board)
    (successor : SnapshotGroup target.visible.board) : Prop :=
  ExactGroupTransport source successor

abbrev StepMergeDisposition {n : Nat} {law : Law}
    {frame target : Frame n} {move : Move n}
    (_step : LegalStep law frame move target) :=
  MergeDisposition frame.visible.board target.visible.board

abbrev StepSplitDisposition {n : Nat} {law : Law}
    {frame target : Frame n} {move : Move n}
    (_step : LegalStep law frame move target) :=
  SplitDisposition frame.visible.board target.visible.board

abbrev StepCaptureTerminalDisposition {n : Nat} {law : Law}
    {frame target : Frame n} {move : Move n}
    (_step : LegalStep law frame move target) :=
  CaptureTerminalDisposition frame.visible.board target.visible.board

/-- Once source coherence is established for a compiler step, the generic
split transporter is uninhabited at that step.  Actual authority is added only
by the replay-indexed mouth below. -/
theorem stepSplitDisposition_isEmpty_of_sourceSuccessorCoherent
    {n : Nat} {law : Law} {frame target : Frame n} {move : Move n}
    (step : LegalStep law frame move target)
    (coherent : SourceSuccessorCoherent
      frame.visible.board target.visible.board) :
    IsEmpty (StepSplitDisposition step) :=
  no_split_of_sourceSuccessorCoherent coherent

/-! ## Actual reachable ply

An actual ply starts at the final current of a replay generated from
`Frame.initial`.  Appending its exact compiler step extends that same replay;
the source and target are therefore adjacent in the same occurrence trace.
-/

abbrev ActualExactGroupTransport {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix)
    (source : SnapshotGroup replayPrefix.final.visible.board)
    (successor : SnapshotGroup ply.target.visible.board) : Prop :=
  ExactGroupTransport source successor

abbrev ActualMergeDisposition {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix) :=
  MergeDisposition replayPrefix.final.visible.board ply.target.visible.board

abbrev ActualSplitDisposition {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix) :=
  SplitDisposition replayPrefix.final.visible.board ply.target.visible.board

abbrev ActualCaptureTerminalDisposition {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix) :=
  CaptureTerminalDisposition replayPrefix.final.visible.board ply.target.visible.board

/-- A successful play step's target board is exactly the board generated by
the existing capture compiler. -/
theorem legalPlay_target_board_eq_boardAfterPlay {n : Nat} {law : Law}
    {frame target : Frame n} {played : Point n}
    (step : LegalStep law frame (.play played) target) :
    target.visible.board =
      boardAfterPlay frame.visible.board frame.visible.toMove played := by
  have generated := nativeStep_visible_eq step
  simp only [stepVisible?] at generated
  unfold playVisible? at generated
  split at generated <;> simp_all
  exact congrArg VisiblePosition.board generated.2.2.2.symm

/-- A successful placement certifies that its source point was empty; this is
read from the fixed compiler, not supplied to group transport. -/
theorem legalPlay_source_empty {n : Nat} {law : Law}
    {frame target : Frame n} {played : Point n}
    (step : LegalStep law frame (.play played) target) :
    frame.visible.board played = none := by
  have generated := nativeStep_visible_eq step
  simp only [stepVisible?] at generated
  unfold playVisible? at generated
  split at generated <;> simp_all

/-- Pass preserves the complete board at its compiler-generated target. -/
theorem legalPass_target_board_eq {n : Nat} {law : Law}
    {frame target : Frame n}
    (step : LegalStep law frame (.pass : Move n) target) :
    target.visible.board = frame.visible.board := by
  have generated := nativeStep_visible_eq step
  simp only [stepVisible?] at generated
  unfold passVisible? at generated
  split at generated <;> simp_all
  simpa using congrArg VisiblePosition.board generated.2.symm

/-- Resignation preserves the complete board at its compiler-generated
terminal target. -/
theorem legalResign_target_board_eq {n : Nat} {law : Law}
    {frame target : Frame n}
    (step : LegalStep law frame (.resign : Move n) target) :
    target.visible.board = frame.visible.board := by
  have generated := nativeStep_visible_eq step
  simp only [stepVisible?] at generated
  unfold resignVisible? at generated
  split at generated <;> simp_all
  simpa using congrArg VisiblePosition.board generated.symm

/-- Every compiler-generated Go step is functional on surviving snapshot
components.  Placement can add a bridge or remove an entire opponent group,
but it cannot delete only an internal bridge of an old group; pass and resign
leave the board unchanged. -/
theorem carrierSuccessorCoherent_of_legalStep {n : Nat} {law : Law}
    {frame target : Frame n} {move : Move n}
    (step : LegalStep law frame move target) :
    CarrierSuccessorCoherent frame.visible.board target.visible.board := by
  intro leftPoint rightPoint leftPolarity rightPolarity
    leftBefore leftAfter rightBefore rightAfter sameBefore
  cases move with
  | play played =>
      have targetBoard := legalPlay_target_board_eq_boardAfterPlay step
      have empty := legalPlay_source_empty step
      rw [targetBoard] at leftAfter rightAfter ⊢
      exact boardAfterPlay_groupAt_eq_of_sourceGroup_eq_of_survives
        empty leftBefore rightBefore sameBefore leftAfter rightAfter
  | pass =>
      rw [legalPass_target_board_eq step]
      exact sameBefore
  | resign =>
      rw [legalResign_target_board_eq step]
      exact sameBefore

/-- Actual whole-capture producer.  The caller supplies only the source group
and the source-side fact that its carrier lies in the compiler-generated
capture set; target absence is derived from the exact reachable ply. -/
def actualCaptureTerminal_of_carrier_subset_captured
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix)
    (played : Point n) (emitted_eq : ply.emitted = .play played)
    (source : SnapshotGroup replayPrefix.final.visible.board)
    (captured : ∀ point ∈ source.carrier,
      point ∈ capturedStonesAfterPlay replayPrefix.final.visible.board
        replayPrefix.final.visible.toMove played) :
    ActualCaptureTerminalDisposition ply := by
  have playStep : LegalStep law replayPrefix.final (.play played) ply.target := by
    simpa [emitted_eq] using ply.step
  refine {
    source := source
    removed := fun point member => ?_
  }
  rw [legalPlay_target_board_eq_boardAfterPlay playStep]
  exact boardAfterPlay_eq_none_of_mem_captured (captured point member)

theorem actualSplitDisposition_isEmpty_of_sourceSuccessorCoherent
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix)
    (coherent : SourceSuccessorCoherent
      replayPrefix.final.visible.board ply.target.visible.board) :
    IsEmpty (ActualSplitDisposition ply) :=
  no_split_of_sourceSuccessorCoherent coherent

/-- Universal actual no-partial-split theorem.  Its only input is the exact
reachable ply; source coherence is generated from that ply's legal step. -/
theorem actualPly_noPartialChainSplit
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix) :
    IsEmpty (ActualSplitDisposition ply) :=
  actualSplitDisposition_isEmpty_of_sourceSuccessorCoherent ply
    (sourceSuccessorCoherent_of_carrier
      (carrierSuccessorCoherent_of_legalStep ply.step))

/-! ## Replay-wide exact lineage closure

Snapshot identity persists across arbitrarily many plies by taking the
equivalence closure of exact adjacent surviving-stone transports in the one
generated replay trace.  Merge is represented by two incoming edges to one
node; a terminal capture has no outgoing witness.  No persistent group name is
stored anywhere.
-/

/-- One snapshot group at one exact state index of the actual replay. -/
structure ReplaySnapshotGroup {n : Nat} {law : Law}
    {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) where
  time : Fin replay.toOccurrence.trace.length
  group : SnapshotGroup
    ((replay.toOccurrence.trace.get time).visible.board)

/-- A directed adjacent-ply lineage edge, witnessed by exact stone transport.
The boards are read directly from consecutive entries of the existing rooted
occurrence trace. -/
structure ReplayGroupTransportEdge {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    (source target : ReplaySnapshotGroup replay) : Prop where
  consecutive : target.time.val = source.time.val + 1
  transport : ExactGroupTransport source.group target.group

/-- Reflexive, symmetric and transitive closure of exact replay edges.  The
symmetry is identity comparison, not reverse temporal authority. -/
inductive ExactReplayGroupLineage {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves} :
    ReplaySnapshotGroup replay → ReplaySnapshotGroup replay → Prop where
  | refl (node : ReplaySnapshotGroup replay) :
      ExactReplayGroupLineage node node
  | forward {source target : ReplaySnapshotGroup replay}
      (edge : ReplayGroupTransportEdge source target) :
      ExactReplayGroupLineage source target
  | symm {left right : ReplaySnapshotGroup replay}
      (lineage : ExactReplayGroupLineage left right) :
      ExactReplayGroupLineage right left
  | trans {left middle right : ReplaySnapshotGroup replay}
      (first : ExactReplayGroupLineage left middle)
      (second : ExactReplayGroupLineage middle right) :
      ExactReplayGroupLineage left right

/-- Exact replay lineage is an equivalence relation on timed snapshot groups. -/
def exactReplayGroupLineageSetoid {n : Nat} {law : Law}
    {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) :
    Setoid (ReplaySnapshotGroup replay) where
  r := ExactReplayGroupLineage
  iseqv := {
    refl := ExactReplayGroupLineage.refl
    symm := ExactReplayGroupLineage.symm
    trans := ExactReplayGroupLineage.trans
  }

/-- Persistent group identity generated by the whole exact replay lineage. -/
abbrev GeneratedGroupIdentity {n : Nat} {law : Law}
    {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) :=
  Quotient (exactReplayGroupLineageSetoid replay)

/-- Identity readout of one timed snapshot group. -/
def generatedGroupIdentityOf {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    (node : ReplaySnapshotGroup replay) : GeneratedGroupIdentity replay :=
  Quotient.mk _ node

/-- Persistent identity is neither same shape nor same name: it is exactly
the closure of same-occurrence, adjacent-ply stone transports. -/
theorem generatedGroupIdentity_eq_iff_exactReplayLineage
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {left right : ReplaySnapshotGroup replay} :
    generatedGroupIdentityOf left = generatedGroupIdentityOf right ↔
      ExactReplayGroupLineage left right := by
  constructor
  · exact Quotient.exact
  · intro lineage
    unfold generatedGroupIdentityOf
    exact Quotient.sound lineage

/-- Every adjacent exact transport enters the replay-wide lineage closure. -/
theorem ReplayGroupTransportEdge.exactLineage {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {source target : ReplaySnapshotGroup replay}
    (edge : ReplayGroupTransportEdge source target) :
    ExactReplayGroupLineage source target :=
  ExactReplayGroupLineage.forward edge

/-- Replay-wide exact lineage preserves the board-generated polarity. -/
theorem ExactReplayGroupLineage.polarity_eq {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {left right : ReplaySnapshotGroup replay}
    (lineage : ExactReplayGroupLineage left right) :
    left.group.polarity = right.group.polarity := by
  induction lineage with
  | refl => rfl
  | forward edge => exact exactGroupTransport_polarity_eq edge.transport
  | symm lineage ih => exact ih.symm
  | trans first second first_ih second_ih => exact first_ih.trans second_ih

/-- Lookalike snapshot carriers of different generated polarities cannot be
identified by the persistent replay lineage quotient. -/
theorem generatedGroupIdentity_ne_of_polarity_ne
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {left right : ReplaySnapshotGroup replay}
    (different : left.group.polarity ≠ right.group.polarity) :
    generatedGroupIdentityOf left ≠ generatedGroupIdentityOf right := by
  intro equalIdentity
  apply different
  exact (generatedGroupIdentity_eq_iff_exactReplayLineage.mp equalIdentity).polarity_eq

