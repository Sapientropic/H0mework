import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.GeneratedGroupLineage
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.ProcessGameInstance
import H0mework.Foundation.Agency.LifecycleSeeds

/-!
# Boundary-local Go group actors

An exact actual ply installs the universal lifecycle boundary core on the one
`ply.extended` occurrence.  Source and target actors are generated separately
from occupied stones at the adjacent boards.  Exact surviving stones generate
all cross-boundary links and identity transports; no replay-wide group name or
identity registry is introduced.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Go

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Society Lifecycle Universal

namespace BoundaryGroupActor

/-- An actual capture together with an occupied representative of its exact
source snapshot group. -/
structure ExitSeed {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix) where
  capture : ActualCaptureTerminalDisposition ply
  representative : OccupiedStone replayPrefix.final.visible.board
  representative_group :
    snapshotGroupOf representative = capture.source

/-- A target occupied stone is fresh exactly when no same-point,
same-polarity stone transports any source group to its target group. -/
structure FreshSeed {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix) where
  representative : OccupiedStone ply.target.visible.board
  noPredecessor :
    ¬ ∃ stone : SurvivingStone replayPrefix.final.visible.board
        ply.target.visible.board,
      stone.targetGroup = snapshotGroupOf representative

/-- The final state occurs at the index determined by the replay's emitted
move list. -/
theorem stateTrace_getElem?_movesLength
    {n : Nat} {law : Law} {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves) :
    replay.stateTrace[moves.length]? = some replay.final := by
  induction replay with
  | nil => rfl
  | @cons source next tailMoves move step tail ih =>
      simpa [GeneratedReplay.stateTrace, GeneratedReplay.final] using ih

/-- The state trace contains one state more than emitted moves. -/
theorem stateTrace_length
    {n : Nat} {law : Law} {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves) :
    replay.stateTrace.length = moves.length + 1 := by
  induction replay with
  | nil => rfl
  | @cons source next tailMoves move step tail ih =>
      simp [GeneratedReplay.stateTrace, ih, Nat.add_assoc]

def sourceSeedAt
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix)
    (_source : GeneratedReplay law (Frame.initial n)
      (moves ++ [ply.emitted]))
    (state : Frame n)
    (_seed : OccupiedStone replayPrefix.final.visible.board) : Prop :=
  state = replayPrefix.final

def targetSeedAt
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix)
    (_source : GeneratedReplay law (Frame.initial n)
      (moves ++ [ply.emitted]))
    (state : Frame n)
    (_seed : OccupiedStone ply.target.visible.board) : Prop :=
  state = ply.target

/-- The source boundary M0 face.  Its lineage is the source-board snapshot
component generated by the occupied-stone seed. -/
def sourceFace
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix) :
    M0BoundaryFace (@goOccurrenceOf n law (moves ++ [ply.emitted])) where
  Seed := OccupiedStone replayPrefix.final.visible.board
  Lineage := fun _ => SnapshotGroup replayPrefix.final.visible.board
  SeedAt := sourceSeedAt ply
  lineageOf := fun _ seed => snapshotGroupOf seed.1
  state := fun _ => replayPrefix.final
  seedAt_state := fun _ _ _ active => active

/-- The target boundary M0 face.  It is not a replay-wide quotient of the
source face; merge therefore remains visible to the lifecycle relation. -/
def targetFace
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix) :
    M0BoundaryFace (@goOccurrenceOf n law (moves ++ [ply.emitted])) where
  Seed := OccupiedStone ply.target.visible.board
  Lineage := fun _ => SnapshotGroup ply.target.visible.board
  SeedAt := targetSeedAt ply
  lineageOf := fun _ seed => snapshotGroupOf seed.1
  state := fun _ => ply.target
  seedAt_state := fun _ _ _ active => active

/-- The non-toy Go installation of the source-owned boundary core.  Its only
source is `ply.extended`; both adjacent states and every link seed live in
that same occurrence. -/
def core
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix) :
    SourceOwnedLifecycleCore
      (@goOccurrenceOf n law (moves ++ [ply.emitted]))
      (goProcessGame ply.extended) where
  sourceFace := sourceFace ply
  targetFace := targetFace ply
  HistorySeed := Empty
  HistoryLineage := fun _ => Empty
  historySeedAt := fun _ _ seed => nomatch seed
  historyLineageOf := fun _ seed => nomatch seed.1
  LinkSeed := SurvivingStone replayPrefix.final.visible.board
    ply.target.visible.board
  linkAdmittedAt := fun _ => True
  linkSource := SurvivingStone.source
  linkTarget := SurvivingStone.target
  linkSource_active := fun _ _ => rfl
  linkTarget_active := fun _ _ => rfl
  IdentitySeed := SurvivingStone replayPrefix.final.visible.board
    ply.target.visible.board
  identityAdmittedAt := fun _ => True
  identitySource := SurvivingStone.source
  identityTarget := SurvivingStone.target
  identitySource_active := fun _ _ => rfl
  identityTarget_active := fun _ _ => rfl
  ExitSeed := ExitSeed ply
  exitAdmittedAt := fun _ => True
  exitSource := fun exit => exit.representative
  exitSource_active := fun _ _ => rfl
  FreshSeed := FreshSeed ply
  freshAdmittedAt := fun _ => True
  freshTarget := fun fresh => fresh.representative
  freshTarget_active := fun _ _ => rfl
  ReappearanceSeed := Empty
  reappearanceAdmittedAt := fun seed => nomatch seed
  reappearanceHistory := fun seed => nomatch seed
  reappearanceHistoryState := fun seed => nomatch seed
  reappearanceHistory_active := fun seed => nomatch seed
  reappearanceTarget := fun seed => nomatch seed
  reappearanceTarget_active := fun seed => nomatch seed
  sourceIndex := moves.length
  source_state_mem := by
    rw [goProcessGame_occurrence_trace, ply.extended_stateTrace_eq]
    exact List.mem_append_left _ (List.mem_of_getElem?
      (stateTrace_getElem?_movesLength replayPrefix))
  target_state_mem := by
    change ply.target ∈ (goProcessGame ply.extended).occurrence.trace
    rw [goProcessGame_occurrence_trace, ply.extended_stateTrace_eq]
    exact List.mem_append_right _ (by simp)
  source_at_index := by
    rw [goProcessGame_occurrence_trace, ply.extended_stateTrace_eq]
    rw [List.getElem?_append_left]
    · exact stateTrace_getElem?_movesLength replayPrefix
    · rw [stateTrace_length replayPrefix]
      exact Nat.lt_succ_self moves.length
  target_follows_source := by
    change (goProcessGame ply.extended).occurrence.trace[moves.length + 1]? =
      some ply.target
    rw [goProcessGame_occurrence_trace, ply.extended_stateTrace_eq]
    rw [show moves.length + 1 = replayPrefix.stateTrace.length by
      exact (stateTrace_length replayPrefix).symm]
    simp
  history_before_event := fun _ seed => nomatch seed

@[simp] theorem core_sourceIndex
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix) :
    (core ply).sourceIndex = moves.length :=
  rfl

/-- A surviving stone packaged at the target state of the exact occurrence. -/
def exactLinkSeed
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix)
    (stone : SurvivingStone replayPrefix.final.visible.board
      ply.target.visible.board) :
    (core ply).ExactLinkSeed :=
  ⟨stone, ⟨ply.target, (core ply).target_state_mem, rfl, trivial⟩⟩

/-- The same surviving stone is also the exact domain identity seed. -/
def exactIdentitySeed
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix)
    (stone : SurvivingStone replayPrefix.final.visible.board
      ply.target.visible.board) :
    (core ply).ExactIdentitySeed :=
  ⟨stone, ⟨ply.target, (core ply).target_state_mem, rfl, trivial⟩⟩

@[simp] theorem exactLinkSeed_sourceActor_value
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix)
    (link : (core ply).ExactLinkSeed) :
    (link.sourceActor (core ply)).1 = link.1.sourceGroup :=
  rfl

@[simp] theorem exactLinkSeed_targetActor_value
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix)
    (link : (core ply).ExactLinkSeed) :
    (link.targetActor (core ply)).1 = link.1.targetGroup :=
  rfl

@[simp] theorem exactIdentitySeed_sourceActor_value
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix)
    (identity : (core ply).ExactIdentitySeed) :
    (identity.sourceActor (core ply)).1 = identity.1.sourceGroup :=
  rfl

@[simp] theorem exactIdentitySeed_targetActor_value
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix)
    (identity : (core ply).ExactIdentitySeed) :
    (identity.targetActor (core ply)).1 = identity.1.targetGroup :=
  rfl

/-- The universal actor relation is exactly the existing actual
surviving-stone group transport. -/
theorem actorRelated_iff_actualExactGroupTransport
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix)
    (source : (core ply).SourceActor) (target : (core ply).TargetActor) :
    (core ply).ActorRelated source target ↔
      ActualExactGroupTransport ply source.1 target.1 := by
  constructor
  · rintro ⟨link, source_eq, target_eq⟩
    have source_value_eq := congrArg Subtype.val source_eq
    have target_value_eq := congrArg Subtype.val target_eq
    change link.1.sourceGroup = source.1 at source_value_eq
    change link.1.targetGroup = target.1 at target_value_eq
    exact ⟨link.1, source_value_eq, target_value_eq⟩
  · rintro ⟨stone, source_eq, target_eq⟩
    refine ⟨exactLinkSeed ply stone, ?_, ?_⟩
    · apply Subtype.ext
      exact source_eq
    · apply Subtype.ext
      exact target_eq

/-- Domain identity transport introduces no second identity notion: it is
equivalent to the same existing exact group transport. -/
theorem domainIdentityTransportAt_iff_actualExactGroupTransport
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix)
    (source : (core ply).SourceActor) (target : (core ply).TargetActor) :
    Nonempty ((core ply).DomainIdentityTransportAt source target) ↔
      ActualExactGroupTransport ply source.1 target.1 := by
  constructor
  · rintro ⟨⟨identity, source_eq, target_eq⟩⟩
    have source_value_eq := congrArg Subtype.val source_eq
    have target_value_eq := congrArg Subtype.val target_eq
    change identity.1.sourceGroup = source.1 at source_value_eq
    change identity.1.targetGroup = target.1 at target_value_eq
    exact ⟨identity.1, source_value_eq, target_value_eq⟩
  · rintro ⟨stone, source_eq, target_eq⟩
    refine ⟨⟨exactIdentitySeed ply stone, ?_, ?_⟩⟩
    · apply Subtype.ext
      exact source_eq
    · apply Subtype.ext
      exact target_eq

/-- An exact capture-authorized source actor has no descendant link. -/
theorem domainExitAuthority_no_descendant
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix)
    (source : (core ply).SourceActor)
    (authority : (core ply).DomainExitAuthorityAt source)
    (target : (core ply).TargetActor) :
    ¬ (core ply).ActorRelated source target := by
  intro related
  have transport :=
    (actorRelated_iff_actualExactGroupTransport ply source target).1 related
  have source_actor_eq := congrArg Subtype.val authority.source_eq
  change snapshotGroupOf authority.exit.1.representative = source.1 at source_actor_eq
  have source_eq : authority.exit.1.capture.source = source.1 := by
    exact authority.exit.1.representative_group.symm.trans source_actor_eq
  apply authority.exit.1.capture.noExactTransport target.1
  simpa [source_eq] using transport

/-- A fresh-origin target actor has no predecessor link. -/
theorem domainFreshOrigin_no_predecessor
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix)
    (target : (core ply).TargetActor)
    (authority : (core ply).DomainFreshOriginAt target)
    (source : (core ply).SourceActor) :
    ¬ (core ply).ActorRelated source target := by
  intro related
  rcases (actorRelated_iff_actualExactGroupTransport ply source target).1
      related with ⟨stone, _source_eq, target_eq⟩
  have target_actor_eq := congrArg Subtype.val authority.target_eq
  change snapshotGroupOf authority.fresh.1.representative = target.1 at target_actor_eq
  apply authority.fresh.1.noPredecessor
  refine ⟨stone, ?_⟩
  exact target_eq.trans target_actor_eq.symm

/-- Strict snapshot identity does not reconnect a recreated group to an old
history actor. -/
theorem domainReappearance_isEmpty
    {n : Nat} {law : Law} {moves : List (Move n)}
    {replayPrefix : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replayPrefix)
    (historical : (core ply).HistoricalActorBefore)
    (target : (core ply).TargetActor) :
    IsEmpty ((core ply).DomainReappearanceAt historical target) :=
  ⟨fun reappearance => nomatch reappearance.reappearance.1⟩

end BoundaryGroupActor
