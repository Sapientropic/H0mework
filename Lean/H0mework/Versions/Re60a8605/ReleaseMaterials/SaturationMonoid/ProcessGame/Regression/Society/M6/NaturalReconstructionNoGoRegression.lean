import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Observer.ObserverObstructionDirection
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M6.FaithfulReconstructionNoGoRegression

/-!
# M6 Society natural-reconstruction no-go

The same M5 source-path fibre admits an ordinary surrogate right section but
no natural one.  Its admissible vertical automorphism exchanges the two actual
source paths, fixes the common normalized image, and transports the exact
authority values by `Equiv.swap (1 : ℚ) 0`.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M6NaturalReconstructionNoGoRegression

noncomputable section

open Classical.GeneratedTerminalExchange
open M5SourceFirstCrossOccurrenceFixture
open M5SourceFirstCrossOccurrenceResidual
open M6NormalizedAuthorityObserverFixture
open M6FaithfulReconstructionNoGoRegression
open Observer

/-- The source-path swap is a genuine observer automorphism: the visible
square and exact fulfilled-authority square commute on every actual path. -/
def societyVerticalAutomorphism :
    AdmissibleObserverAutomorphism societyObserver where
  occurrenceEquiv := verticalSwapEquiv
  visibleEquiv := visibleIdentityEquiv
  authorityEquiv := residualSwapEquiv
  forget_commutes := verticalSwap_forget_commutes
  authority_commutes := fun path =>
    (residualSwap_authority_commutes path).symm

/-- Authority change is checked on the whole reachable normalized fibre. -/
def societyAuthorityChangingVertical :
    AuthorityChangingVerticalAutomorphism societyObserver where
  automorphism := societyVerticalAutomorphism
  anchor := commonImage
  anchorOccurrence := leftPath
  anchor_reachable := rfl
  fixesVisible := rfl
  changesAuthorityOnFiber := fun path _inFiber =>
    residualSwap_changes_authority path

/-- The existing vertical obstruction itself canonically generates the exact
rooted kernel.  This is a local observer obstruction, not a new social or
living-law root. -/
def societyRootedObserverObstruction :
    RootedObserverObstructionAt societyAuthorityChangingVertical :=
  rootedObserverObstruction societyAuthorityChangingVertical

/-- The attaching direction is generated by the exact rooted obstruction;
there is no caller-selected direction or boundary. -/
def societySourceGeneratedAttachingDirection :
    SourceGeneratedObserverAttachingDirectionAt
      societyRootedObserverObstruction :=
  canonicalObserverObstructionDirection
    societyAuthorityChangingVertical

theorem society_rooted_kernel_is_canonical :
    societyRootedObserverObstruction.kernelPair =
      canonicalAuthorityKernelPair societyAuthorityChangingVertical :=
  rfl

theorem society_rooted_kernel_left :
    societyRootedObserverObstruction.kernelPair.left = leftPath :=
  rfl

theorem society_rooted_kernel_right :
    societyRootedObserverObstruction.kernelPair.right = rightPath :=
  rfl

theorem society_attaching_boundary_exact :
    societySourceGeneratedAttachingDirection.boundaryKernelPair =
      societyRootedObserverObstruction.kernelPair :=
  canonicalObserverObstructionDirection_boundary
    societyAuthorityChangingVertical

def society_attaching_boundary_law :
    GeneratedObserverDirectionBoundaryAt
      societyRootedObserverObstruction
      societySourceGeneratedAttachingDirection.direction
      societyRootedObserverObstruction.kernelPair :=
  canonicalObserverObstructionDirection_boundaryLaw
    societyAuthorityChangingVertical

theorem society_attaching_boundary_no_authority_factorization :
    ¬ Nonempty (AuthorityFactorization societyObserver) :=
  societySourceGeneratedAttachingDirection.boundaryKernelPair
    |>.noAuthorityFactorization

theorem society_attaching_boundary_no_faithful_reconstruction :
    ¬ Nonempty (FaithfulAuthorityReconstruction societyObserver) :=
  societySourceGeneratedAttachingDirection.boundaryKernelPair
    |>.noFaithfulAuthorityReconstruction

theorem society_attaching_boundary_no_natural_reconstruction :
    ¬ Nonempty (NaturalAuthorityReconstruction societyObserver) :=
  societySourceGeneratedAttachingDirection.boundaryKernelPair
    |>.noNaturalAuthorityReconstruction

theorem society_no_natural_surrogate_section :
    ¬ Nonempty (NaturalSurrogateSection societyObserver) :=
  societyAuthorityChangingVertical.noNaturalSurrogateSection

theorem society_no_natural_authority_reconstruction_from_vertical :
    ¬ Nonempty (NaturalAuthorityReconstruction societyObserver) :=
  societyAuthorityChangingVertical.noNaturalAuthorityReconstruction

theorem society_no_natural_authority_reconstruction_from_kernel :
    ¬ Nonempty (NaturalAuthorityReconstruction societyObserver) :=
  societyKernelPair.noNaturalAuthorityReconstruction

/-- Whole Society M6 consumer.  The positive ordinary section, faithful
left-inverse obstruction, authority-factorization obstruction, and genuinely
natural section obstruction are all consumed together. -/
structure SocietyNaturalReconstructionNoGoCertificate : Prop where
  leftExactConsumer : TerminalAuthorityConsumerAt leftProgram leftTerminal
  rightExactConsumer : TerminalAuthorityConsumerAt rightProgram rightTerminal
  faithfulConsumer : SocietyFaithfulReconstructionNoGoCertificate
  ordinarySurrogate : Nonempty (SurrogateRightSection societyObserver)
  verticalForgetCommutes : ∀ path,
    societyObserver.forget
        (societyVerticalAutomorphism.occurrenceEquiv path) =
      societyVerticalAutomorphism.visibleEquiv
        (societyObserver.forget path)
  verticalAuthorityCommutes : ∀ path,
    societyObserver.authorityK
        (societyVerticalAutomorphism.occurrenceEquiv path) =
      societyVerticalAutomorphism.authorityEquiv
        (societyObserver.authorityK path)
  verticalFixesImage :
    societyVerticalAutomorphism.visibleEquiv commonImage = commonImage
  verticalChangesAuthorityOnFiber : ∀ path,
    societyObserver.forget path = commonImage →
      societyVerticalAutomorphism.authorityEquiv
          (societyObserver.authorityK path) ≠
        societyObserver.authorityK path
  rootedKernelIsCanonical :
    societyRootedObserverObstruction.kernelPair =
      canonicalAuthorityKernelPair societyAuthorityChangingVertical
  rootedKernelLeft :
    societyRootedObserverObstruction.kernelPair.left = leftPath
  rootedKernelRight :
    societyRootedObserverObstruction.kernelPair.right = rightPath
  sourceGeneratedAttachingDirection : Nonempty
    (SourceGeneratedObserverAttachingDirectionAt
      societyRootedObserverObstruction)
  attachingBoundaryExact :
    societySourceGeneratedAttachingDirection.boundaryKernelPair =
      societyRootedObserverObstruction.kernelPair
  attachingBoundaryLaw : Nonempty
    (GeneratedObserverDirectionBoundaryAt
      societyRootedObserverObstruction
      societySourceGeneratedAttachingDirection.direction
      societyRootedObserverObstruction.kernelPair)
  attachingBoundaryNoAuthorityFactorization :
    ¬ Nonempty (AuthorityFactorization societyObserver)
  attachingBoundaryNoFaithfulReconstruction :
    ¬ Nonempty (FaithfulAuthorityReconstruction societyObserver)
  attachingBoundaryNoNaturalReconstruction :
    ¬ Nonempty (NaturalAuthorityReconstruction societyObserver)
  noFaithfulReconstruction :
    ¬ Nonempty (FaithfulAuthorityReconstruction societyObserver)
  noNaturalSurrogate :
    ¬ Nonempty (NaturalSurrogateSection societyObserver)
  noNaturalAuthorityReconstruction :
    ¬ Nonempty (NaturalAuthorityReconstruction societyObserver)

theorem societyNaturalReconstructionNoGoDirectConsumer :
    SocietyNaturalReconstructionNoGoCertificate where
  leftExactConsumer := left_exact_authority_consumer
  rightExactConsumer := right_exact_authority_consumer
  faithfulConsumer := societyFaithfulReconstructionNoGoDirectConsumer
  ordinarySurrogate := ⟨societySurrogateRightSection⟩
  verticalForgetCommutes := societyVerticalAutomorphism.forget_commutes
  verticalAuthorityCommutes :=
    societyVerticalAutomorphism.authority_commutes
  verticalFixesImage := societyAuthorityChangingVertical.fixesVisible
  verticalChangesAuthorityOnFiber :=
    societyAuthorityChangingVertical.changesAuthorityOnFiber
  rootedKernelIsCanonical := society_rooted_kernel_is_canonical
  rootedKernelLeft := society_rooted_kernel_left
  rootedKernelRight := society_rooted_kernel_right
  sourceGeneratedAttachingDirection :=
    ⟨societySourceGeneratedAttachingDirection⟩
  attachingBoundaryExact := society_attaching_boundary_exact
  attachingBoundaryLaw := ⟨society_attaching_boundary_law⟩
  attachingBoundaryNoAuthorityFactorization :=
    society_attaching_boundary_no_authority_factorization
  attachingBoundaryNoFaithfulReconstruction :=
    society_attaching_boundary_no_faithful_reconstruction
  attachingBoundaryNoNaturalReconstruction :=
    society_attaching_boundary_no_natural_reconstruction
  noFaithfulReconstruction :=
    society_no_faithful_authority_reconstruction
  noNaturalSurrogate := society_no_natural_surrogate_section
  noNaturalAuthorityReconstruction :=
    society_attaching_boundary_no_natural_reconstruction

end
end M6NaturalReconstructionNoGoRegression
end Society
end ProcessGame
end SaturationMonoid
