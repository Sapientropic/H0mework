import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M5.GoCrossOccurrenceResidualRegression
import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Observer.ObserverObstructionDirection

/-!
# M6 Go natural authority reconstruction no-go

The observer below uses the existing G1 ko/fresh replay pair.  Its occurrence
carrier is the already installed `PathIndex`; each endpoint is anchored back
to its unequal actual `RootedAccountedUnfolding`.  At every observation
horizon the full generated normal-form projection is a singleton visible
carrier, so choosing the ko path gives an honest surrogate right section.

The admissible vertical swap exchanges the two actual replay paths while the
visible normal form stays fixed.  Their replay-native `actualizationK` values
are exchanged by the genuine residual automorphism swapping `1` and `0`.
Thus this file consumes
the generic M6 observer theorem without replacing the two replays by
restrictions of one occurrence or fixing the observation horizon.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M6GoNaturalAuthorityReconstructionRegression

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Go.CrossOccurrencePathResidual
open Go.CrossOccurrenceClassicalResidual
open _root_.SaturationMonoid.ProcessGame.Go.Classical
open Observer

/-- The existing M5 path carrier, not a second Go occurrence registry. -/
abbrev ActualPath := PathIndex

/-- The complete normalized classical image at an arbitrary horizon. -/
abbrev NormalizedImage (horizon : Nat) :=
  NormalFormProjection (terminalGame koTerminalReplay horizon)

/-- Existing M5 normalization into the common generated representative. -/
def normalizedForget (horizon : Nat) : ActualPath → NormalizedImage horizon :=
  Forget horizon

/-- Exact actual occurrence selected by an existing cross-occurrence path. -/
def actualOccurrence : ActualPath → RootedAccountedUnfolding (Go.Frame 2) :=
  fun path =>
    if path = koPath then koTerminalReplay.toOccurrence
    else freshTerminalReplay.toOccurrence

@[simp] theorem actualOccurrence_ko :
    actualOccurrence koPath = koTerminalReplay.toOccurrence := by
  simp [actualOccurrence]

@[simp] theorem actualOccurrence_fresh :
    actualOccurrence freshPath = freshTerminalReplay.toOccurrence := by
  simp [actualOccurrence, koPath_ne_freshPath.symm]

theorem actualOccurrences_ne :
    actualOccurrence koPath ≠ actualOccurrence freshPath := by
  simpa using terminal_occurrences_ne

/-- Authority readout from each selected replay's own emitted-move fold. -/
def pathAuthorityK : ActualPath → Go.TacticalPhase :=
  fun path =>
    if path = koPath then actualizationK koTerminalReplay
    else actualizationK freshTerminalReplay

@[simp] theorem pathAuthorityK_ko : pathAuthorityK koPath = 1 := by
  simp [pathAuthorityK, koTerminalK_eq_one]

@[simp] theorem pathAuthorityK_fresh : pathAuthorityK freshPath = 0 := by
  simp [pathAuthorityK, koPath_ne_freshPath.symm, freshTerminalK_eq_zero]

theorem pathAuthorityK_ko_replay :
    pathAuthorityK koPath = actualizationK koTerminalReplay := by
  simp [pathAuthorityK]

theorem pathAuthorityK_fresh_replay :
    pathAuthorityK freshPath = actualizationK freshTerminalReplay := by
  simp [pathAuthorityK, koPath_ne_freshPath.symm]

theorem pathAuthorityK_ne :
    pathAuthorityK koPath ≠ pathAuthorityK freshPath := by
  rw [pathAuthorityK_ko, pathAuthorityK_fresh]
  decide

theorem normalizedForget_paths_equal (horizon : Nat) :
    normalizedForget horizon koPath = normalizedForget horizon freshPath :=
  Forget_ko_eq_fresh horizon

/-- Ordinary object-level choice of the ko representative. -/
def koSurrogateSection (horizon : Nat) : NormalizedImage horizon → ActualPath :=
  fun _image => koPath

/-- The complete normal-form carrier is generated by its unique constructor,
so the ordinary choice really is a right section at every horizon. -/
theorem koSurrogateSection_rightInverse (horizon : Nat) :
    Function.RightInverse (koSurrogateSection horizon)
      (normalizedForget horizon) := by
  intro image
  cases image
  simp [koSurrogateSection, normalizedForget, Forget, koNormalForm,
    terminalNormalForm, toNormalForm]

/-- Generic M6 observer installed on the arbitrary-horizon Go pair. -/
def goAuthorityObserver (horizon : Nat) :
    AuthorityObserver ActualPath (NormalizedImage horizon) Go.TacticalPhase where
  forget := normalizedForget horizon
  authorityK := pathAuthorityK

/-- The existing ko/fresh witnesses form an exact nontrivial authority fibre. -/
def goAuthorityKernelPair (horizon : Nat) :
    AuthorityKernelPair (goAuthorityObserver horizon) where
  left := koPath
  right := freshPath
  occurrence_ne := koPath_ne_freshPath
  visible_eq := normalizedForget_paths_equal horizon
  authority_ne := pathAuthorityK_ne

/-- M4-style object-level surrogate selection remains available. -/
def goSurrogateRightSection (horizon : Nat) :
    SurrogateRightSection (goAuthorityObserver horizon) where
  lift := koSurrogateSection horizon
  lift_forget := koSurrogateSection_rightInverse horizon

/-- The common normal form cannot carry a visible-only readout of the two
replay-native authority values. -/
theorem go_has_no_authority_factorization (horizon : Nat) :
    ¬ Nonempty (AuthorityFactorization (goAuthorityObserver horizon)) :=
  (goAuthorityKernelPair horizon).noAuthorityFactorization

/-- The common normal form cannot recover both actual path witnesses. -/
theorem go_has_no_occurrence_leftInverse (horizon : Nat) :
    ¬ ∃ reconstruct : NormalizedImage horizon → ActualPath,
      Function.LeftInverse reconstruct (normalizedForget horizon) :=
  (goAuthorityKernelPair horizon).noOccurrenceLeftInverse

/-- In particular no faithful authority reconstruction exists, even though
the ordinary surrogate right section above is inhabited. -/
theorem go_has_no_faithful_authority_reconstruction (horizon : Nat) :
    ¬ Nonempty (FaithfulAuthorityReconstruction
      (goAuthorityObserver horizon)) :=
  (goAuthorityKernelPair horizon).noFaithfulAuthorityReconstruction

/-- Vertical automorphism of the already installed two-path fibre. -/
def verticalSwap : ActualPath → ActualPath :=
  fun path => if path = koPath then freshPath else koPath

@[simp] theorem verticalSwap_ko : verticalSwap koPath = freshPath := by
  simp [verticalSwap]

@[simp] theorem verticalSwap_fresh : verticalSwap freshPath = koPath := by
  simp [verticalSwap, koPath_ne_freshPath.symm]

def verticalSwapEquiv : ActualPath ≃ ActualPath where
  toFun := verticalSwap
  invFun := verticalSwap
  left_inv path := by fin_cases path <;> rfl
  right_inv path := by fin_cases path <;> rfl

def visibleIdentityEquiv (horizon : Nat) :
    NormalizedImage horizon ≃ NormalizedImage horizon :=
  Equiv.refl _

/-- The swap is invisible to the complete normalized classical readout. -/
theorem verticalSwap_forget_commutes (horizon : Nat) (path : ActualPath) :
    normalizedForget horizon (verticalSwap path) =
      normalizedForget horizon path := by
  cases normalizedForget horizon (verticalSwap path)
  cases normalizedForget horizon path
  rfl

theorem verticalSwap_has_no_fixed_path (path : ActualPath) :
    verticalSwap path ≠ path := by
  fin_cases path <;> decide

/-- Genuine residual automorphism exchanging exactly the two generated
authority values. -/
def residualSwapEquiv : Go.TacticalPhase ≃ Go.TacticalPhase :=
  Equiv.swap 1 0

abbrev residualSwap : Go.TacticalPhase → Go.TacticalPhase :=
  residualSwapEquiv

/-- The vertical swap commutes with replay-native authority after applying
the corresponding residual transport. -/
theorem verticalSwap_authority_commutes (path : ActualPath) :
    pathAuthorityK (verticalSwap path) = residualSwap (pathAuthorityK path) := by
  fin_cases path
  · change pathAuthorityK (verticalSwap koPath) =
      residualSwap (pathAuthorityK koPath)
    rw [verticalSwap_ko, pathAuthorityK_fresh, pathAuthorityK_ko]
    rfl
  · change pathAuthorityK (verticalSwap freshPath) =
      residualSwap (pathAuthorityK freshPath)
    rw [verticalSwap_fresh, pathAuthorityK_ko, pathAuthorityK_fresh]
    rfl

theorem verticalSwap_changes_authority (path : ActualPath) :
    pathAuthorityK (verticalSwap path) ≠ pathAuthorityK path := by
  fin_cases path <;> decide

/-- Genuine automorphism of all three observer coordinates.  Its two
commuting squares are the existing M5 normal-form equality and replay-native
`K` transport, respectively. -/
def goAdmissibleVerticalAutomorphism (horizon : Nat) :
    AdmissibleObserverAutomorphism (goAuthorityObserver horizon) where
  occurrenceEquiv := verticalSwapEquiv
  visibleEquiv := visibleIdentityEquiv horizon
  authorityEquiv := residualSwapEquiv
  forget_commutes := by
    intro path
    exact verticalSwap_forget_commutes horizon path
  authority_commutes := by
    intro path
    exact verticalSwap_authority_commutes path

/-- The common normal form is reachable by the ko occurrence and fixed by
the vertical observer automorphism, while its entire two-path fibre changes
authority. -/
def goAuthorityChangingVerticalAutomorphism (horizon : Nat) :
    AuthorityChangingVerticalAutomorphism (goAuthorityObserver horizon) where
  automorphism := goAdmissibleVerticalAutomorphism horizon
  anchor := normalizedForget horizon koPath
  anchorOccurrence := koPath
  anchor_reachable := rfl
  fixesVisible := rfl
  changesAuthorityOnFiber := by
    intro path _inFiber fixedAuthority
    apply verticalSwap_changes_authority path
    exact (verticalSwap_authority_commutes path).trans fixedAuthority

/-- Strong natural-section obstruction: even a non-faithful surrogate choice
cannot be natural under every admissible observer automorphism. -/
theorem go_has_no_natural_surrogate_section (horizon : Nat) :
    ¬ Nonempty (NaturalSurrogateSection (goAuthorityObserver horizon)) :=
  (goAuthorityChangingVerticalAutomorphism horizon).noNaturalSurrogateSection

theorem go_has_no_natural_authority_reconstruction (horizon : Nat) :
    ¬ Nonempty (NaturalAuthorityReconstruction
      (goAuthorityObserver horizon)) :=
  (goAuthorityChangingVerticalAutomorphism horizon).noNaturalAuthorityReconstruction

/-! ## Obstruction-generated attaching direction -/

/-- The rooted observer obstruction is canonically generated from the same
Go vertical automorphism; it is not another Go or living-law root. -/
def goRootedObserverObstruction (horizon : Nat) :
    RootedObserverObstructionAt
      (goAuthorityChangingVerticalAutomorphism horizon) :=
  rootedObserverObstruction (goAuthorityChangingVerticalAutomorphism horizon)

/-- The existing ko path is the exact left endpoint of the rooted kernel. -/
theorem goRootedObserverObstruction_left (horizon : Nat) :
    (goRootedObserverObstruction horizon).kernelPair.left = koPath :=
  rfl

/-- The vertical image is exactly the existing fresh path, so no sibling
occurrence is introduced by rooting the obstruction. -/
theorem goRootedObserverObstruction_right (horizon : Nat) :
    (goRootedObserverObstruction horizon).kernelPair.right = freshPath := by
  change verticalSwap koPath = freshPath
  exact verticalSwap_ko

/-- Unique zero-information attaching direction generated by the exact
rooted Go observer obstruction. -/
def goSourceGeneratedObserverAttachingDirection (horizon : Nat) :
    SourceGeneratedObserverAttachingDirectionAt
      (goRootedObserverObstruction horizon) :=
  canonicalObserverObstructionDirection
    (goAuthorityChangingVerticalAutomorphism horizon)

/-- Its public boundary is definitionally the kernel stored in the very same
rooted obstruction. -/
theorem goObserverAttachingDirection_boundary_eq_rooted (horizon : Nat) :
    (goSourceGeneratedObserverAttachingDirection horizon).boundaryKernelPair =
      (goRootedObserverObstruction horizon).kernelPair :=
  canonicalObserverObstructionDirection_boundary
    (goAuthorityChangingVerticalAutomorphism horizon)

/-- Exact boundary mouth back to the existing M5 pair.  The boundary carries
the ko/fresh endpoints, their common full normal form, and unequal replay K. -/
theorem goObserverAttachingDirection_exact_boundary (horizon : Nat) :
    (goSourceGeneratedObserverAttachingDirection horizon).boundaryKernelPair.left =
        koPath ∧
      (goSourceGeneratedObserverAttachingDirection horizon).boundaryKernelPair.right =
        freshPath ∧
      normalizedForget horizon
          (goSourceGeneratedObserverAttachingDirection horizon).boundaryKernelPair.left =
        normalizedForget horizon
          (goSourceGeneratedObserverAttachingDirection horizon).boundaryKernelPair.right ∧
      pathAuthorityK
          (goSourceGeneratedObserverAttachingDirection horizon).boundaryKernelPair.left ≠
        pathAuthorityK
          (goSourceGeneratedObserverAttachingDirection horizon).boundaryKernelPair.right := by
  rw [goObserverAttachingDirection_boundary_eq_rooted horizon]
  exact ⟨goRootedObserverObstruction_left horizon,
    goRootedObserverObstruction_right horizon,
    (goRootedObserverObstruction horizon).kernelPair.visible_eq,
    (goRootedObserverObstruction horizon).kernelPair.authority_ne⟩

/-- The generated boundary, rather than a parallel hand-selected pair,
directly rejects every visible-only authority factorization. -/
theorem goObserverAttachingBoundary_no_authority_factorization
    (horizon : Nat) :
    ¬ Nonempty (AuthorityFactorization (goAuthorityObserver horizon)) :=
  (goSourceGeneratedObserverAttachingDirection horizon)
    |>.boundary_noAuthorityFactorization

theorem goObserverAttachingBoundary_no_occurrence_leftInverse
    (horizon : Nat) :
    ¬ ∃ reconstruct : NormalizedImage horizon → ActualPath,
      Function.LeftInverse reconstruct (normalizedForget horizon) :=
  (goSourceGeneratedObserverAttachingDirection horizon)
    |>.boundary_noOccurrenceLeftInverse

theorem goObserverAttachingBoundary_no_faithful_authority_reconstruction
    (horizon : Nat) :
    ¬ Nonempty (FaithfulAuthorityReconstruction
      (goAuthorityObserver horizon)) :=
  (goSourceGeneratedObserverAttachingDirection horizon).boundaryKernelPair
    |>.noFaithfulAuthorityReconstruction

/-- End-to-end obstruction direction consumer: its exact boundary directly
rules out the full natural authority reconstruction. -/
theorem goObserverAttachingBoundary_no_natural_authority_reconstruction
    (horizon : Nat) :
    ¬ Nonempty (NaturalAuthorityReconstruction
      (goAuthorityObserver horizon)) :=
  (goSourceGeneratedObserverAttachingDirection horizon)
    |>.boundary_noNaturalAuthorityReconstruction

/-- Full arbitrary-horizon M6 Go certificate. -/
structure GoNaturalAuthorityNoGoCertificate (horizon : Nat) : Prop where
  differentReplaySpines :
    koTerminalReplay.stateTrace ≠ freshTerminalReplay.stateTrace
  koActualOccurrenceAnchor :
    actualOccurrence koPath = koTerminalReplay.toOccurrence
  freshActualOccurrenceAnchor :
    actualOccurrence freshPath = freshTerminalReplay.toOccurrence
  differentActualOccurrences :
    actualOccurrence koPath ≠ actualOccurrence freshPath
  honestNormalFormTransport :
    Nonempty (CrossReplayNormalFormEquivalence
      koTerminalReplay freshTerminalReplay horizon)
  differentActualizationK :
    pathAuthorityK koPath ≠ pathAuthorityK freshPath
  koAuthorityAnchor :
    pathAuthorityK koPath = actualizationK koTerminalReplay
  freshAuthorityAnchor :
    pathAuthorityK freshPath = actualizationK freshTerminalReplay
  equalVisibleImage :
    normalizedForget horizon koPath = normalizedForget horizon freshPath
  exactAuthorityKernelPair :
    Nonempty (AuthorityKernelPair (goAuthorityObserver horizon))
  surrogateRightSectionExists :
    Nonempty (SurrogateRightSection (goAuthorityObserver horizon))
  noVisibleAuthorityFactorization :
    ¬ Nonempty (AuthorityFactorization (goAuthorityObserver horizon))
  noFaithfulReconstruction :
    ¬ Nonempty (FaithfulAuthorityReconstruction
      (goAuthorityObserver horizon))
  noActualOccurrenceReconstruction :
    ¬ ∃ reconstruct : NormalizedImage horizon →
        RootedAccountedUnfolding (Go.Frame 2),
      reconstruct (normalizedForget horizon koPath) =
          koTerminalReplay.toOccurrence ∧
        reconstruct (normalizedForget horizon freshPath) =
          freshTerminalReplay.toOccurrence
  admissibleVerticalAutomorphism :
    Nonempty (AdmissibleObserverAutomorphism (goAuthorityObserver horizon))
  authorityChangingVerticalAutomorphism :
    Nonempty (AuthorityChangingVerticalAutomorphism
      (goAuthorityObserver horizon))
  rootedObserverObstruction :
    Nonempty (RootedObserverObstructionAt
      (goAuthorityChangingVerticalAutomorphism horizon))
  sourceGeneratedAttachingDirection :
    Nonempty (SourceGeneratedObserverAttachingDirectionAt
      (goRootedObserverObstruction horizon))
  attachingBoundaryEqualsRootedKernel :
    (goSourceGeneratedObserverAttachingDirection horizon).boundaryKernelPair =
      (goRootedObserverObstruction horizon).kernelPair
  exactAttachingBoundary :
    (goSourceGeneratedObserverAttachingDirection horizon).boundaryKernelPair.left =
        koPath ∧
      (goSourceGeneratedObserverAttachingDirection horizon).boundaryKernelPair.right =
        freshPath ∧
      normalizedForget horizon
          (goSourceGeneratedObserverAttachingDirection horizon).boundaryKernelPair.left =
        normalizedForget horizon
          (goSourceGeneratedObserverAttachingDirection horizon).boundaryKernelPair.right ∧
      pathAuthorityK
          (goSourceGeneratedObserverAttachingDirection horizon).boundaryKernelPair.left ≠
        pathAuthorityK
          (goSourceGeneratedObserverAttachingDirection horizon).boundaryKernelPair.right
  boundaryNoAuthorityFactorization :
    ¬ Nonempty (AuthorityFactorization (goAuthorityObserver horizon))
  boundaryNoOccurrenceLeftInverse :
    ¬ ∃ reconstruct : NormalizedImage horizon → ActualPath,
      Function.LeftInverse reconstruct (normalizedForget horizon)
  boundaryNoNaturalAuthorityReconstruction :
    ¬ Nonempty (NaturalAuthorityReconstruction
      (goAuthorityObserver horizon))
  noNaturalSurrogateSection :
    ¬ Nonempty (NaturalSurrogateSection (goAuthorityObserver horizon))
  noNaturalAuthorityReconstruction :
    ¬ Nonempty (NaturalAuthorityReconstruction
      (goAuthorityObserver horizon))

theorem goNaturalAuthorityNoGoDirectConsumer (horizon : Nat) :
    GoNaturalAuthorityNoGoCertificate horizon where
  differentReplaySpines := terminal_stateTraces_ne
  koActualOccurrenceAnchor := actualOccurrence_ko
  freshActualOccurrenceAnchor := actualOccurrence_fresh
  differentActualOccurrences := actualOccurrences_ne
  honestNormalFormTransport := ⟨normalFormEquivalence horizon⟩
  differentActualizationK := pathAuthorityK_ne
  koAuthorityAnchor := pathAuthorityK_ko_replay
  freshAuthorityAnchor := pathAuthorityK_fresh_replay
  equalVisibleImage := normalizedForget_paths_equal horizon
  exactAuthorityKernelPair :=
    ⟨(goRootedObserverObstruction horizon).kernelPair⟩
  surrogateRightSectionExists := ⟨goSurrogateRightSection horizon⟩
  noVisibleAuthorityFactorization :=
    goObserverAttachingBoundary_no_authority_factorization horizon
  noFaithfulReconstruction :=
    goObserverAttachingBoundary_no_faithful_authority_reconstruction horizon
  noActualOccurrenceReconstruction :=
    Forget_has_no_occurrence_reconstruction horizon
  admissibleVerticalAutomorphism :=
    ⟨goAdmissibleVerticalAutomorphism horizon⟩
  authorityChangingVerticalAutomorphism :=
    ⟨goAuthorityChangingVerticalAutomorphism horizon⟩
  rootedObserverObstruction := ⟨goRootedObserverObstruction horizon⟩
  sourceGeneratedAttachingDirection :=
    ⟨goSourceGeneratedObserverAttachingDirection horizon⟩
  attachingBoundaryEqualsRootedKernel :=
    goObserverAttachingDirection_boundary_eq_rooted horizon
  exactAttachingBoundary :=
    goObserverAttachingDirection_exact_boundary horizon
  boundaryNoAuthorityFactorization :=
    goObserverAttachingBoundary_no_authority_factorization horizon
  boundaryNoOccurrenceLeftInverse :=
    goObserverAttachingBoundary_no_occurrence_leftInverse horizon
  boundaryNoNaturalAuthorityReconstruction :=
    goObserverAttachingBoundary_no_natural_authority_reconstruction horizon
  noNaturalSurrogateSection := go_has_no_natural_surrogate_section horizon
  noNaturalAuthorityReconstruction :=
    goObserverAttachingBoundary_no_natural_authority_reconstruction horizon

/-- Compact public mouth separating harmless object-level surjectivity from
the impossible faithful and natural reconstruction contracts. -/
theorem go_surrogate_exists_but_faithful_and_natural_reconstruction_do_not
    (horizon : Nat) :
    Nonempty (SurrogateRightSection (goAuthorityObserver horizon)) ∧
      ¬ Nonempty (FaithfulAuthorityReconstruction
        (goAuthorityObserver horizon)) ∧
      ¬ Nonempty (NaturalSurrogateSection
        (goAuthorityObserver horizon)) ∧
      ¬ Nonempty (NaturalAuthorityReconstruction
        (goAuthorityObserver horizon)) :=
  ⟨⟨goSurrogateRightSection horizon⟩,
    go_has_no_faithful_authority_reconstruction horizon,
    go_has_no_natural_surrogate_section horizon,
    go_has_no_natural_authority_reconstruction horizon⟩

theorem existing_G1_G5_G7_crossOccurrence_mouth (horizon : Nat) :
    koTerminalReplay.stateTrace ≠ freshTerminalReplay.stateTrace ∧
      actualOccurrence koPath ≠ actualOccurrence freshPath ∧
      Nonempty (CrossReplayNormalFormEquivalence
        koTerminalReplay freshTerminalReplay horizon) ∧
      pathAuthorityK koPath ≠ pathAuthorityK freshPath ∧
      normalizedForget horizon koPath = normalizedForget horizon freshPath :=
  ⟨terminal_stateTraces_ne, actualOccurrences_ne,
    ⟨normalFormEquivalence horizon⟩, pathAuthorityK_ne,
    normalizedForget_paths_equal horizon⟩

end M6GoNaturalAuthorityReconstructionRegression
end Society
end ProcessGame
end SaturationMonoid
