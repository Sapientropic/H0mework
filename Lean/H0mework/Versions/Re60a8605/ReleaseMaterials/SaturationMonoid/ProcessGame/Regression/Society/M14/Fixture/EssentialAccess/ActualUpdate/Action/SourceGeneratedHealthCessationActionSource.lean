def healthCessationActionSourceVisitAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    SourceNativeTemporalVisitAt
      mandateSuccessorTargetRoot.toAuthoritativeRoot.toLedgerRoot :=
  (generatedMandateSuccessionActionAt initial depth).target.targetVisit

def healthCessationActionSourceEntryAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    OpenResponsibilityAt M14SourceGeneratedMandateSuccessorTargetRoot.N
      ((mandateSuccessorTargetRoot.toAuthoritativeRoot.toLedgerRoot.source.source
        ).toRootSource.account.supportOf
          (mandateSuccessorTargetRoot.emitted
            (healthCessationActionSourceVisitAt initial depth).current)) :=
  (generatedMandateSuccessionActionAt initial depth).target.targetEntry

def healthCessationActionSourceAuthorityAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    SourceNativeLivingTemporalCausalEntryAuthorityAt mandateSuccessorTargetRoot
      (healthCessationActionSourceVisitAt initial depth)
      (healthCessationActionSourceEntryAt initial depth) :=
  (generatedMandateSuccessionActionAt initial depth).target.targetAuthority

def healthCessationActionExactSourceEventAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    ExactTemporalCausalRootEventAt
      mandateSuccessorTargetRoot.toAuthoritativeRoot.toLedgerRoot
        (healthCessationActionSourceVisitAt initial depth) :=
  mandateSuccessorTargetRoot.toAuthoritativeRoot.toLedgerRoot
    |>.exactTemporalCausalEventAt
      (healthCessationActionSourceVisitAt initial depth)

theorem healthCessationActionSource_is_successionMacroNext
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    (generatedMandateSuccessionActionAt initial depth
      ).target.targetAnswerAndNext.nextCurrent =
      ⟨M14SourceGeneratedMandateSuccessorTargetRoot.V,
        mandateSuccessorTargetRoot.toAuthoritativeRoot,
        healthCessationActionSourceVisitAt initial depth⟩ :=
  generatedMandateSuccessionAction_macroNext_exact initial depth

def installedHealthCessationSourceUBIAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    SourceInstalledRenewalAt mandateSuccessorTargetUBIRecognition
      (healthCessationActionSourceVisitAt initial depth) :=
  SourceInstalledRenewalAt.generate PUnit.unit rfl

def healthCessationActionSourcePaymentReceiptAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (_initial : CycleAt oldVisit sourceIndex boundary) (_depth : Nat) :
    SourceBackedUBIPaymentReceiptAt
      exitCapacityProgram.purchasingPowerStanding ExitFutureCode.leave :=
  SourceBackedUBIPaymentReceiptAt.generate

@[simp] theorem installedHealthCessationSourceUBI_consumer_exact
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    (installedHealthCessationSourceUBIAt initial depth).payload.consumer =
      sourceGeneratedUBIRootRestriction :=
  rfl

theorem installedHealthCessationSourceUBI_factorizes
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    (installedHealthCessationSourceUBIAt initial depth
      ).RootAnswerAndNextFactorizes :=
  (installedHealthCessationSourceUBIAt initial depth
    ).rootAnswerAndNext_factorizes

def healthCessationChannelIndexAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) : Nat :=
  cycleLifecycleIndex initial (depth + 3) + 2

def healthCessationHealthChannelAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :=
  sourceGeneratedContributionCapacityPostSettlementEssentialAccessChannelAt
    oldVisit sourceIndex (healthCessationChannelIndexAt initial depth)
      healthAuthority

theorem healthCessationChannelCurrent_eq_constitutionDepth
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    contributionCapacityPostSettlementEssentialAccessChannelCurrentAt
        oldVisit sourceIndex (healthCessationChannelIndexAt initial depth) =
      mandateConstitutionDepthAt initial (depth + 3) :=
  rfl

theorem healthCessationChannelPayment_eq_constitutionPayment
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    (healthCessationHealthChannelAt initial depth
      ).actualExit.paymentOccurrence.rootOccurrence =
      (canonicalConstitutionEmbeddedPaymentAt initial (depth + 3)
        ).rootOccurrence := by
  rw [canonicalConstitutionEmbeddedPayment_eq_periodic]
  rw [(healthCessationHealthChannelAt initial depth
    ).paymentRootOccurrence_exact]
  have depthExact :=
    healthCessationChannelCurrent_eq_constitutionDepth initial depth
  cases depthExact
  rfl

/-- Visible occurrence transporter only; it does not identify exact root-event
authority across the canonical and successor-target roots. -/
def healthCessationConstitutionSourcePresentationAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    ConstructivePresentation
      (jointRoot.toAuthoritativeRoot.toRoot.actual.OccurrenceAt
        (temporalVisitAt
          (mandateConstitutionDepthAt initial (depth + 3))).current)
      (mandateSuccessorTargetRoot.toAuthoritativeRoot.toRoot.actual.OccurrenceAt
        (healthCessationActionSourceVisitAt initial depth).current) :=
  ConstructivePresentation.refl _

theorem healthCessationConstitution_to_sourcePayment_commutes
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    (healthCessationConstitutionSourcePresentationAt initial depth).forward
      (canonicalConstitutionEmbeddedPaymentAt initial (depth + 3)
          ).rootOccurrence.occurrence =
      (healthCessationActionExactSourceEventAt initial depth
        ).occurrence := by
  rw [canonicalConstitutionEmbeddedPayment_eq_periodic]
  rfl

/-- Dependent Payment/Constitution incidence for the health-native `.t2`
bearer.  No bearer equality to the canonical exit worker occurs. -/
structure HealthPaymentConstitutionIncidenceAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) : Type 32 where
  private mk ::
  healthAction : SourceGeneratedEssentialAccessCriticalActionAt .health
  healthActionExact : healthAction = sourceGeneratedHealthCriticalAction
  healthBearer : Lifecycle.ActorBearer
  healthBearerExact : healthBearer = Lifecycle.ActorBearer.target .t2
  criticalBearerIsHealthBearer :
    healthAction.criticalBearer.commonBearer = healthBearer
  healthChannel :
    SourceGeneratedContributionCapacityPostSettlementEssentialAccessChannelAt
      oldVisit sourceIndex (healthCessationChannelIndexAt initial depth)
        healthAuthority
  healthChannelExact : healthChannel =
    healthCessationHealthChannelAt initial depth
  relationWitness :
    healthChannel.witnessReturn.1.actor essentialAccessRelationCompiler =
        healthActor ∧
      essentialAccessRelationCompiler.relationOf
        healthChannel.witnessReturn.1 = healthRelation
  channelPaymentIsConstitutionPayment :
    healthChannel.actualExit.paymentOccurrence.rootOccurrence =
      (canonicalConstitutionEmbeddedPaymentAt initial (depth + 3)
        ).rootOccurrence
  constitutionToSourcePayment :
    (healthCessationConstitutionSourcePresentationAt initial depth).forward
      (canonicalConstitutionEmbeddedPaymentAt initial (depth + 3)
          ).rootOccurrence.occurrence =
      (healthCessationActionExactSourceEventAt initial depth).occurrence

def healthPaymentConstitutionIncidenceAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    HealthPaymentConstitutionIncidenceAt initial depth :=
  let channel := healthCessationHealthChannelAt initial depth
  { healthAction := sourceGeneratedHealthCriticalAction
    healthActionExact := rfl
    healthBearer := Lifecycle.ActorBearer.target .t2
    healthBearerExact := rfl
    criticalBearerIsHealthBearer := rfl
    healthChannel := channel
    healthChannelExact := rfl
    relationWitness := channel.relationWitness_returns_exactSource
    channelPaymentIsConstitutionPayment :=
      healthCessationChannelPayment_eq_constitutionPayment initial depth
    constitutionToSourcePayment :=
      healthCessationConstitution_to_sourcePayment_commutes initial depth }

end
