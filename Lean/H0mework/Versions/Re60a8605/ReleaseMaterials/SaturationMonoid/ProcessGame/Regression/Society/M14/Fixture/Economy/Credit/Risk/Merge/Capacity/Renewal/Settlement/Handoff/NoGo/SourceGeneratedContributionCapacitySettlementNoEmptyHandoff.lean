import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Fixture.Economy.Credit.Risk.Merge.Capacity.Renewal.Settlement.Support.SourceGeneratedContributionCapacitySettlementSupport

/-!
# No empty handoff inside the contribution-capacity reopening world

Every support of the existing reopening network already carries a live row.
Consequently a faithful terminal may not advertise an empty post-settlement
landing while preserving this exact world network.  A debt-free continuation
must be generated by a real representation change rather than by selecting a
hidden empty face of the current carrier.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceGeneratedContributionCapacitySettlementNoEmptyHandoff

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open M14SourceGeneratedContributionMergeActionSource
open M14SourceGeneratedContributionCapacityCutWorld
open M14SourceGeneratedContributionCapacityCutActionSource
open M14SourceGeneratedContributionCapacityReopeningWorld
open M14SourceGeneratedContributionCapacityReopeningRoot
open M14SourceGeneratedContributionCapacitySettlementSupport

/-- Every support in the fixed reopening network has a concrete live row. -/
def contributionCapacityReopeningLiveEntryAt
    (oldVisit : OldVisit)
    (support : (ReopeningNAt oldVisit).Support) :
    OpenResponsibilityAt (ReopeningNAt oldVisit) support :=
  contributionCapacityReopeningDefaultEntryAt oldVisit support

/-- There is no hidden support whose complete live ledger is empty. -/
theorem contributionCapacityReopeningNoEmptySupport
    (oldVisit : OldVisit) :
    IsEmpty
      { support : (ReopeningNAt oldVisit).Support //
        IsEmpty (OpenResponsibilityAt (ReopeningNAt oldVisit) support) } :=
  ⟨fun indexed =>
    indexed.2.false
      (contributionCapacityReopeningLiveEntryAt oldVisit indexed.1)⟩

/-- Complete-ledger formulation used by terminal-handoff consumers. -/
theorem contributionCapacityReopeningNoEmptyCompleteLedger
    (oldVisit : OldVisit) :
    IsEmpty
      { ledger : CompleteLiveLedgerAt (ReopeningNAt oldVisit) //
        IsEmpty ledger.Entry } :=
  ⟨fun indexed =>
    indexed.2.false
      (contributionCapacityReopeningLiveEntryAt oldVisit indexed.1.support)⟩

abbrev AnyContributionCapacitySurvivorDebtTargetAt
    (oldVisit : OldVisit)
    (support : (ReopeningNAt oldVisit).Support)
    (entryIndex : Fin 2) :=
  Sigma fun targetEntry :
      OpenResponsibilityAt (ReopeningNAt oldVisit) support =>
    RootDebtLineageAt (ReopeningNAt oldVisit)
      (contributionCapacitySettlementSurvivorEntryAt oldVisit entryIndex)
      targetEntry

/-- Every support of the same law epoch retains at least one of the two
survivor debts.  Thus a dormant nonempty support cannot disguise a final
joint settlement. -/
def contributionCapacityReopeningRetainedSurvivorDebtAt
    (oldVisit : OldVisit)
    (support : (ReopeningNAt oldVisit).Support) :
    Sigma fun entryIndex : Fin 2 =>
      AnyContributionCapacitySurvivorDebtTargetAt oldVisit support
        entryIndex := by
  rcases support with ⟨u8Support, reopeningPhase⟩
  cases u8Support with
  | inl cutSupport =>
      rcases cutSupport with ⟨mergeSupport, cutPhase⟩
      rcases mergeSupport with ⟨lossSupport, mergePhase⟩
      rcases lossSupport with ⟨cofaceSupport, lossPhase⟩
      cases cofaceSupport with
      | inl oldSupport =>
          refine ⟨0, contributionCapacityReopeningDefaultEntryAt oldVisit
            (.inl (((.inl oldSupport, lossPhase), mergePhase), cutPhase),
              reopeningPhase), ⟨rfl, ?_⟩⟩
          cases oldSupport <;> cases lossPhase <;>
            cases mergePhase <;> cases cutPhase <;> rfl
      | inr direction =>
          cases direction
          cases lossPhase with
          | false =>
              refine ⟨1, contributionCapacityReopeningDefaultEntryAt oldVisit
                (.inl (((.inr .completion, false), mergePhase), cutPhase),
                  reopeningPhase), ⟨rfl, ?_⟩⟩
              cases mergePhase <;> cases cutPhase <;> rfl
          | true =>
              refine ⟨0, contributionCapacityReopeningDefaultEntryAt oldVisit
                (.inl (((.inr .completion, true), mergePhase), cutPhase),
                  reopeningPhase), ⟨rfl, ?_⟩⟩
              cases mergePhase <;> cases cutPhase <;> rfl
  | inr direction =>
      cases direction
      let inherited := contributionCapacityCutTargetContribution
        (capacityActionRootedAt oldVisit)
      refine ⟨0, ⟨.inl inherited.1, inherited.2⟩, ⟨rfl, rfl⟩⟩

/-- No support in the fixed reopening network can exclude continuations of
both survivor debts.  Empty supports are ruled out vacuously, and every
nonempty dormant face is ruled out by the retained-debt producer above. -/
theorem contributionCapacityReopeningNoSupportClearsBothSurvivorDebts
    (oldVisit : OldVisit) :
    IsEmpty
      { support : (ReopeningNAt oldVisit).Support //
        (entryIndex : Fin 2) →
          IsEmpty
            (AnyContributionCapacitySurvivorDebtTargetAt oldVisit support
              entryIndex) } :=
  ⟨fun target => by
    rcases contributionCapacityReopeningRetainedSurvivorDebtAt oldVisit
        target.1 with ⟨entryIndex, targetEntry, sameDebt⟩
    exact (target.2 entryIndex).false ⟨targetEntry, sameDebt⟩⟩

end
end M14SourceGeneratedContributionCapacitySettlementNoEmptyHandoff
end Society
