abbrev RevisedQNAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :=
  M9ProofCarryingRenewalU8RevisedWorld.NewNAt
    (oldRootVisitAt oldVisit sourceIndex boundary)

/-- Pair-free raw syntax: no `Complete`, every-tail predicate, incidence,
replay identity or K coordinate occurs in this type. -/
abbrev PairFreeRawProgramAt (boundary : Nat) :=
  FinitePrefixOperationalProgramAt boundary

def constantRawProgramAt (boundary code : Nat) :
    PairFreeRawProgramAt boundary :=
  fun _ => code

/-- The already generated M9 coface direction.  It is an existing claim
coordinate, not a new obstruction generated by the later replay pair. -/
def oldGeneratedDirectionClaimAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (RevisedQNAt oldVisit sourceIndex boundary).Claim :=
  Sum.inr .completion

/-- One canonical existing obstruction at revised-Q target support. -/
def inheritedOperationalObstructionAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (RevisedQNAt oldVisit sourceIndex boundary).ObstructionAt
      (lossAllocationTargetSupport
        (rootedFailureAt oldVisit sourceIndex boundary)) :=
  ⟨true, ()⟩

/-- Every obstruction claim in revised Q is inherited from the old network;
the loss-allocation phase adds no obstruction-claim branch. -/
theorem everyRevisedQObstructionClaim_isInherited
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    {support : (RevisedQNAt oldVisit sourceIndex boundary).Support}
    (obstruction :
      (RevisedQNAt oldVisit sourceIndex boundary).ObstructionAt support) :
    ∃ oldClaim : M9ProofCarryingRenewalU8Failure.N.Claim,
      (RevisedQNAt oldVisit sourceIndex boundary).obstructionClaim obstruction =
        Sum.inl oldClaim := by
  rcases obstruction with ⟨oldSupport, oldObstruction⟩
  exact
    ⟨M9ProofCarryingRenewalU8Failure.N.obstructionClaim oldObstruction, rfl⟩

/-- In this fixture the inherited claim is `Unit`, so every existing
obstruction has literally the same claim. -/
theorem existingRevisedQObstructionClaim_isConstant
    (oldVisit : OldVisit) (sourceIndex boundary : Nat)
    (support : (RevisedQNAt oldVisit sourceIndex boundary).Support)
    (obstruction :
      (RevisedQNAt oldVisit sourceIndex boundary).ObstructionAt support) :
    (RevisedQNAt oldVisit sourceIndex boundary).obstructionClaim obstruction =
      (Sum.inl () : (RevisedQNAt oldVisit sourceIndex boundary).Claim) := by
  rcases everyRevisedQObstructionClaim_isInherited obstruction with
    ⟨oldClaim, claim_eq⟩
  cases oldClaim
  exact claim_eq

/-- The current claim carrier is exhausted by the inherited unit and the
unique old generated direction. -/
theorem everyRevisedQClaim_isInheritedOrOldGenerated
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (claim : (RevisedQNAt oldVisit sourceIndex boundary).Claim) :
    claim = Sum.inl () ∨
      claim = oldGeneratedDirectionClaimAt oldVisit sourceIndex boundary := by
  cases claim with
  | inl oldClaim =>
      cases oldClaim
      exact .inl rfl
  | inr direction =>
      exact .inr <| congrArg Sum.inr
        (GeneratedDirectionAt.eq_completion direction)

/-- The old generated direction is not the claim of any obstruction in the
current network.  This is the exact carrier obstruction. -/
theorem oldGeneratedDirectionClaim_hasNoObstructionPreimage
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    IsEmpty
      (Sigma fun support :
          (RevisedQNAt oldVisit sourceIndex boundary).Support =>
        Sigma fun obstruction :
            (RevisedQNAt oldVisit sourceIndex boundary).ObstructionAt support =>
          PLift
            ((RevisedQNAt oldVisit sourceIndex boundary).obstructionClaim
                obstruction =
              oldGeneratedDirectionClaimAt oldVisit sourceIndex boundary)) := by
  constructor
  rintro ⟨support, obstruction, claim_eq⟩
  have inherited_eq := existingRevisedQObstructionClaim_isConstant oldVisit
    sourceIndex boundary support obstruction
  rw [inherited_eq] at claim_eq
  exact nomatch claim_eq.down

/-! ## Strong arbitrary-support K-faithful control -/

/-- Completely unconstrained replay-indexed selection of one existing
revised-Q support and obstruction. -/
structure RawObstructionClaimEncodingAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) : Type 28 where
  supportAt :
    AnyContributionCapacityPostSettlementPaidReplay oldVisit sourceIndex →
      (RevisedQNAt oldVisit sourceIndex boundary).Support
  obstructionAt : (replay :
      AnyContributionCapacityPostSettlementPaidReplay oldVisit sourceIndex) →
    (RevisedQNAt oldVisit sourceIndex boundary).ObstructionAt
      (supportAt replay)

/-- Existing obstruction values are genuinely available. -/
def rawObstructionClaimEncodingAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    RawObstructionClaimEncodingAt oldVisit sourceIndex boundary where
  supportAt := fun _ =>
    lossAllocationTargetSupport (rootedFailureAt oldVisit sourceIndex boundary)
  obstructionAt := fun _ => ⟨true, ()⟩

/-- Equality of selected obstruction claims is required to reflect equality
of actual K, while support and obstruction choices remain arbitrary. -/
structure KFaithfulObstructionClaimEncodingAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) : Type 28
    extends RawObstructionClaimEncodingAt oldVisit sourceIndex boundary where
  claimEquality_reflectsActualK :
    ∀ left right :
      AnyContributionCapacityPostSettlementPaidReplay oldVisit sourceIndex,
    (RevisedQNAt oldVisit sourceIndex boundary).obstructionClaim
          (obstructionAt left) =
        (RevisedQNAt oldVisit sourceIndex boundary).obstructionClaim
          (obstructionAt right) →
      (finitePrefixInstalledAuthorityObserverAt oldVisit sourceIndex boundary
        ).authorityK left =
        (finitePrefixInstalledAuthorityObserverAt oldVisit sourceIndex boundary
          ).authorityK right

/-- Later same-visible/different-K replays break every faithful use of the
existing obstruction-claim carrier, even with arbitrary support selection. -/
theorem kFaithfulObstructionClaimEncoding_isEmpty
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    IsEmpty
      (KFaithfulObstructionClaimEncodingAt oldVisit sourceIndex boundary) := by
  constructor
  intro encoding
  let incidence := canonicalIncidenceAt oldVisit sourceIndex boundary
  have claim_eq :
      (RevisedQNAt oldVisit sourceIndex boundary).obstructionClaim
          (encoding.obstructionAt incidence.leftReplay) =
        (RevisedQNAt oldVisit sourceIndex boundary).obstructionClaim
          (encoding.obstructionAt incidence.rightReplay) := by
    rw [existingRevisedQObstructionClaim_isConstant,
      existingRevisedQObstructionClaim_isConstant]
  exact incidence.finiteKernelPair.authority_ne
    (encoding.claimEquality_reflectsActualK incidence.leftReplay
      incidence.rightReplay claim_eq)

/-! ## Pair-free raw theory consequences -/

/-- Raw theory schema.  Syntax and denotation mention only the pair-free
function carrier; the law inventory is an independent source input. -/
def pairFreeRawTheoryAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat)
    (inventory : LawInventory (RevisedQNAt oldVisit sourceIndex boundary))
    (denotation : PairFreeRawProgramAt boundary →
      (RevisedQNAt oldVisit sourceIndex boundary).Claim) :
    TheoryState (RevisedQNAt oldVisit sourceIndex boundary) where
  inventory := inventory
  ExpressionAt := fun _ => PairFreeRawProgramAt boundary
  denotes := denotation
  TheoremAt := fun {support} expression =>
    (RevisedQNAt oldVisit sourceIndex boundary).HoldsAt support
      (denotation expression)
  theoremPresentation := fun _ => ConstructivePresentation.refl _

/-- Any alleged failure forces the raw denotation to be extensionally
constant at the old generated direction.  Pair-sensitive non-expressibility
has therefore already been smuggled into the denotation. -/
theorem actualFailure_forces_characteristicOldDirectionDenotation
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (inventory : LawInventory (RevisedQNAt oldVisit sourceIndex boundary))
    (denotation : PairFreeRawProgramAt boundary →
      (RevisedQNAt oldVisit sourceIndex boundary).Claim)
    {support : (RevisedQNAt oldVisit sourceIndex boundary).Support}
    (obstruction :
      (RevisedQNAt oldVisit sourceIndex boundary).ObstructionAt support)
    (failure : ActualExpressibilityFailure
      (pairFreeRawTheoryAt oldVisit sourceIndex boundary inventory denotation)
      obstruction) :
    ∀ program : PairFreeRawProgramAt boundary,
      denotation program =
        oldGeneratedDirectionClaimAt oldVisit sourceIndex boundary := by
  intro program
  rcases everyRevisedQClaim_isInheritedOrOldGenerated
      (denotation program) with inherited | generated
  · exfalso
    exact failure.notExpressible.false
      ⟨program, inherited.trans
        (existingRevisedQObstructionClaim_isConstant oldVisit sourceIndex
          boundary support obstruction).symm⟩
  · exact generated

/-- One pair-free raw intent denoting the actual obstruction claim
constructively eliminates failure, independently of inventory. -/
theorem actualFailure_isEmpty_of_obstructionDenotingIntent
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (inventory : LawInventory (RevisedQNAt oldVisit sourceIndex boundary))
    (denotation : PairFreeRawProgramAt boundary →
      (RevisedQNAt oldVisit sourceIndex boundary).Claim)
    {support : (RevisedQNAt oldVisit sourceIndex boundary).Support}
    (obstruction :
      (RevisedQNAt oldVisit sourceIndex boundary).ObstructionAt support)
    (intent : PairFreeRawProgramAt boundary)
    (intent_denotes : denotation intent =
      (RevisedQNAt oldVisit sourceIndex boundary).obstructionClaim
        obstruction) :
    IsEmpty
      (ActualExpressibilityFailure
        (pairFreeRawTheoryAt oldVisit sourceIndex boundary inventory denotation)
        obstruction) := by
  constructor
  intro failure
  exact failure.notExpressible.false ⟨intent, intent_denotes⟩

/-- Fully pair-free obstruction intent: raw programs denote the actual inherited
obstruction claim already present in revised Q. -/
def pairFreeObstructionIntentDenotationAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    PairFreeRawProgramAt boundary →
      (RevisedQNAt oldVisit sourceIndex boundary).Claim :=
  fun _ =>
    (RevisedQNAt oldVisit sourceIndex boundary).obstructionClaim
      (inheritedOperationalObstructionAt oldVisit sourceIndex boundary)

theorem pairFreeObstructionIntentTheory_actualFailure_isEmpty
    (oldVisit : OldVisit) (sourceIndex boundary : Nat)
    (inventory : LawInventory (RevisedQNAt oldVisit sourceIndex boundary)) :
    IsEmpty
      (ActualExpressibilityFailure
        (pairFreeRawTheoryAt oldVisit sourceIndex boundary inventory
          (pairFreeObstructionIntentDenotationAt oldVisit sourceIndex boundary))
        (inheritedOperationalObstructionAt oldVisit sourceIndex boundary)) :=
  actualFailure_isEmpty_of_obstructionDenotingIntent inventory
    (pairFreeObstructionIntentDenotationAt oldVisit sourceIndex boundary)
    (inheritedOperationalObstructionAt oldVisit sourceIndex boundary)
    (constantRawProgramAt boundary 0) rfl

/-- A theory epoch can change expressions and realizations, but on the fixed
network it cannot manufacture the missing obstruction-claim coordinate. -/
theorem anyTheoryEpoch_preservesExistingObstructionClaimShape
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (_theory : TheoryState (RevisedQNAt oldVisit sourceIndex boundary))
    {support : (RevisedQNAt oldVisit sourceIndex boundary).Support}
    (obstruction :
      (RevisedQNAt oldVisit sourceIndex boundary).ObstructionAt support) :
    (RevisedQNAt oldVisit sourceIndex boundary).obstructionClaim obstruction =
      (Sum.inl () : (RevisedQNAt oldVisit sourceIndex boundary).Claim) :=
  existingRevisedQObstructionClaim_isConstant oldVisit sourceIndex boundary
    support obstruction

/-- Direct consumer: the real later pair, inhabited raw obstruction carrier,
K-faithful no-go, missing old-direction obstruction preimage, and pair-free
intent failure emptiness are consumed together. -/
theorem pairFreeOperationalFailureNoGo_directConsumer
    (oldVisit : OldVisit) (sourceIndex boundary : Nat)
    (inventory : LawInventory (RevisedQNAt oldVisit sourceIndex boundary)) :
    let breaking :=
      sourceGeneratedFinitePrefixRepresentationBreakingAt oldVisit sourceIndex
        boundary
    Nonempty (RawObstructionClaimEncodingAt oldVisit sourceIndex boundary) ∧
      type_of% breaking.sameInstalledVisibleDifferentK ∧
      IsEmpty
        (KFaithfulObstructionClaimEncodingAt oldVisit sourceIndex boundary) ∧
      IsEmpty
        (Sigma fun support :
            (RevisedQNAt oldVisit sourceIndex boundary).Support =>
          Sigma fun obstruction :
              (RevisedQNAt oldVisit sourceIndex boundary).ObstructionAt support =>
            PLift
              ((RevisedQNAt oldVisit sourceIndex boundary).obstructionClaim
                  obstruction =
                oldGeneratedDirectionClaimAt oldVisit sourceIndex boundary)) ∧
      IsEmpty
        (ActualExpressibilityFailure
          (pairFreeRawTheoryAt oldVisit sourceIndex boundary inventory
            (pairFreeObstructionIntentDenotationAt oldVisit sourceIndex boundary))
          (inheritedOperationalObstructionAt oldVisit sourceIndex boundary)) := by
  dsimp
  let breaking :=
    sourceGeneratedFinitePrefixRepresentationBreakingAt oldVisit sourceIndex
      boundary
  exact
    ⟨⟨rawObstructionClaimEncodingAt oldVisit sourceIndex boundary⟩,
      breaking.sameInstalledVisibleDifferentK,
      kFaithfulObstructionClaimEncoding_isEmpty oldVisit sourceIndex boundary,
      oldGeneratedDirectionClaim_hasNoObstructionPreimage oldVisit sourceIndex
        boundary,
      pairFreeObstructionIntentTheory_actualFailure_isEmpty oldVisit sourceIndex
        boundary inventory⟩

end
