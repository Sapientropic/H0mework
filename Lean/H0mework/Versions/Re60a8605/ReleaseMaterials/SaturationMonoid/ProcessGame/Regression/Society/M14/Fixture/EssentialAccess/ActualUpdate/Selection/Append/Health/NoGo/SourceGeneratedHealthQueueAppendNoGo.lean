import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Fixture.EssentialAccess.ActualUpdate.Selection.Append.Health.Action.SourceGeneratedSequentialHealthQueueAppend

/-!
# Health queue-append no-go

The health append installs exactly the event generated by the middle queue
lineage.  Platform cannot be selected at that same occurrence, two different
events cannot share it, and the retained successor cannot replay selection.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceGeneratedHealthQueueAppendNoGo

noncomputable section

open M14SourceGeneratedSelectedEssentialAccessCriticalEvent
open M14SourceGeneratedEssentialAccessCriticalActionAppendLedger
open M14SourceGeneratedEssentialAccessCriticalActionAppendRoot
open M14SourceGeneratedTenureQueueAppendTarget
open M14SourceGeneratedHealthQueueActionAtTenureRoot
open M14SourceGeneratedSequentialHealthQueueAppend

abbrev HealthAppendedCurrent :=
  appendedCriticalSelectionCurrent healthAppendPrior healthQueueAction

abbrev PlatformAtHealthAppendOccurrence :=
  CallerSelectedCriticalEventAt HealthAppendedCurrent .platform

theorem platformAtHealthAppendOccurrence_isEmpty :
    IsEmpty PlatformAtHealthAppendOccurrence := by
  apply callerSelectedCriticalEvent_isEmpty
  intro equality
  cases equality

theorem twoEventsAtHealthAppendOccurrence_isEmpty :
    IsEmpty (TwoSelectedCriticalEventsAt HealthAppendedCurrent) :=
  twoSelectedCriticalEventsAt_isEmpty HealthAppendedCurrent

theorem retainedHealthSelectionReplay_isEmpty :
    IsEmpty (AppendedSelectionReplayAt tenureAppendTargetRoot
      healthAppendExactEvent.occurrence healthAppendPrior healthQueueAction) :=
  generatedHealthQueueAppend_selectionReplay_isEmpty

theorem healthQueueAppendBoundary_directConsumer :
    IsEmpty PlatformAtHealthAppendOccurrence ∧
      IsEmpty (TwoSelectedCriticalEventsAt HealthAppendedCurrent) ∧
      IsEmpty (AppendedSelectionReplayAt tenureAppendTargetRoot
        healthAppendExactEvent.occurrence healthAppendPrior healthQueueAction) :=
  ⟨platformAtHealthAppendOccurrence_isEmpty,
    twoEventsAtHealthAppendOccurrence_isEmpty,
    retainedHealthSelectionReplay_isEmpty⟩

end
end M14SourceGeneratedHealthQueueAppendNoGo
end Society
end ProcessGame
end SaturationMonoid

