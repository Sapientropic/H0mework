import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M3.SettlementDispositionRegression

/-!
# M8 relationship maintenance fixture

One M3 exchange leg and its generated counterparty supply both sides of a
relationship.  An actual `.maintain` boundary event regenerates standing on
the same stable obligation slot.  Renewal control and debt direction are
read from exact actor/responsibility incidences, source events, bearers, and
live residuals; no love, relationship identity, or asymmetry label is stored.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M8RelationshipMaintenanceFixture

open ResponsibilityLifecycle
open Lifecycle Universal Relations Exchange Settlement
open M3FiniteExchangeFixture
open M3SettlementDispositionRegression

/-- Relationship standing generated by the exact relation seed and one
actual maintained responsibility edge. -/
structure MaintenanceGeneratedRelationshipStandingAt (leg : Leg) where
  generatedInterest : relationCompiler.GeneratedInterestAt
    (exactExchangeSeed.actor exchangeCompiler leg)
    (exactExchangeSeed.relation exchangeCompiler leg)
  exactResponsibility : incidence.TargetResponsibilityAt
    (exactExchangeSeed.actor exchangeCompiler leg)
    (exactExchangeSeed.obligation exchangeCompiler leg)
    (exactExchangeSeed.sourceEvent exchangeCompiler leg)
  sourceOwnership : SourceOwnsResponsibilityIncidence V
    (exactExchangeSeed.sourceEvent exchangeCompiler leg)
    (exactExchangeSeed.obligation exchangeCompiler leg)
  bearerExact :
    (exactExchangeSeed.obligation exchangeCompiler leg).bearer =
      exchangeLaw.bearerOfActor
        (exactExchangeSeed.actor exchangeCompiler leg)
  beneficiaryExact :
    (exactExchangeSeed.obligation exchangeCompiler leg).beneficiary =
      exchangeLaw.protectedInterestOfActor
        (exactExchangeSeed.actor exchangeCompiler
          (exactExchangeSeed.counterparty exchangeCompiler leg))
  maintenanceOpen : ExactSettlementEdge.LiveResidualAt
    (settlementOf leg .maintain)
  maintenanceDisposition :
    (settlementOf leg .maintain).disposition =
      .carry (.maintained ())

def maintenanceGeneratedRelationshipStanding (leg : Leg) :
    MaintenanceGeneratedRelationshipStandingAt leg where
  generatedInterest := exactExchangeSeed.interest exchangeCompiler leg
  exactResponsibility := exchangeLaw.responsibilityAt exactExchangeSeed leg
  sourceOwnership := exactExchangeSeed.admissionOwnership exchangeCompiler leg
  bearerExact := exchangeLaw.bearer_eq exactExchangeSeed leg
  beneficiaryExact := exchangeLaw.beneficiary_eq exactExchangeSeed leg
  maintenanceOpen := maintainOpen leg
  maintenanceDisposition := rfl

/-- Exact renewal controller is the bearer actor of the maintained leg. -/
abbrev renewalController (leg : Leg) :=
  exactExchangeSeed.actor exchangeCompiler leg

/-- Exact affected counterparty is generated by the same exchange seed and
the source-owned counterparty involution. -/
abbrev affectedCounterparty (leg : Leg) :=
  exactExchangeSeed.actor exchangeCompiler
    (exactExchangeSeed.counterparty exchangeCompiler leg)

theorem renewalController_ne_affectedCounterparty (leg : Leg) :
    renewalController leg ≠ affectedCounterparty leg :=
  exchangeLaw.counterparty_actors_distinct exactExchangeSeed leg

/-- Source-owned permission for one exact maintenance controller and its
generated counterparty.  The permission contains the actual maintained
responsibility consumer; it is not a Boolean control label. -/
structure SelectedMaintenanceControlAt
    (event : Lifecycle.TargetToken) (controller subject : Leg) where
  event_eq : event = legToken controller
  subject_eq : subject = counterparty controller
  maintained : MaintenanceGeneratedRelationshipStandingAt controller

def selectedMaintenanceControl (leg : Leg) :
    SelectedMaintenanceControlAt (legToken leg) leg (counterparty leg) where
  event_eq := rfl
  subject_eq := rfl
  maintained := maintenanceGeneratedRelationshipStanding leg

/-- At the same exact source event the reversed controller permission fibre
is empty.  The contradiction is source-event identity, not a post-hoc actor
inequality tag. -/
theorem reverseMaintenanceControl_empty (leg : Leg) :
    SelectedMaintenanceControlAt (legToken leg) (counterparty leg) leg →
      False := by
  cases leg <;> intro reverse <;> cases reverse.event_eq

/-- Source-owned debt flow at one exact maintenance event.  The selected
fibre retains the actual admitted obligation, its bearer/beneficiary
equations, source ownership and live maintained residual.  It is not inferred
from a slot address or from inequality of the parties. -/
structure SelectedMaintenanceDebtFlowAt
    (event : Lifecycle.TargetToken) (debtor beneficiary : Leg) where
  event_eq : event = legToken debtor
  beneficiary_eq : beneficiary = counterparty debtor
  exactDebt : MaintenanceGeneratedRelationshipStandingAt debtor

def selectedMaintenanceDebtFlow (leg : Leg) :
    SelectedMaintenanceDebtFlowAt (legToken leg) leg (counterparty leg) where
  event_eq := rfl
  beneficiary_eq := rfl
  exactDebt := maintenanceGeneratedRelationshipStanding leg

/-- The reciprocal obligation belongs to its own reciprocal source event.
It cannot be replayed as a reverse debt flow at this exact event. -/
theorem reverseMaintenanceDebtFlow_empty (leg : Leg) :
    SelectedMaintenanceDebtFlowAt (legToken leg) (counterparty leg) leg →
      False := by
  cases leg <;> intro reverse <;> cases reverse.event_eq

end M8RelationshipMaintenanceFixture
end Society
end ProcessGame
end SaturationMonoid
