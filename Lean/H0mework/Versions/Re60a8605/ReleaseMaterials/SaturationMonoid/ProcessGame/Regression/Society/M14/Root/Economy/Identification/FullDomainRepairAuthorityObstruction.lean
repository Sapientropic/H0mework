import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Root.Economy.Identification.FullDomainReachabilityCollision
import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Observer.ObserverObstructionDirection

/-!
# M14 full-domain repair-authority obstruction

The full-domain observation is installed as the visible coordinate of the
existing generic authority-observer interface.  A source-native involution
exchanges every tenure-capture origin with the route-bottleneck origin and a
second involution exchanges the two existing exact repairs.  Both observer
squares commute on the whole `RepairFailureOriginAt depth` carrier, while the
repair authority changes at every point of the anchored visible fibre.

This file generates the vertical obstruction and its canonical rooted
direction.  Visible repair readouts and downstream reconstruction no-gos are
consumer responsibilities.  No cause/repair registry, root, occurrence,
trace, probability object, or completed future is introduced.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14FullDomainRepairAuthorityObstruction

noncomputable section

open UBI Policy
open Observer
open M14TenureCaptureRouteRepairNoGoRegression
open M14ProofCarryingExitRepairRegression
open M14FullDomainReachabilityCollision

/-! ## Existing observer and its generated kernel pair -/

/-- The strongest current visible repair observer.  Its authority coordinate
is the existing source-compiled canonical repair, not a second `K`. -/
def fullDomainRepairObserverAt (depth : Nat) :
    AuthorityObserver (RepairFailureOriginAt depth)
      FullDomainReachabilityObservation ExactExitRepair where
  forget := fullDomainReachabilityObservationAt depth
  authorityK := canonicalRepairAt

/-- The already generated collision is exactly an authority kernel pair for
the full-domain observer. -/
def fullDomainRepairKernelPairAt (depth : Nat) :
    AuthorityKernelPair (fullDomainRepairObserverAt depth) := by
  let collision := sourceGeneratedFullDomainReachabilityCollisionAt depth
  exact
    { left := tenureCaptureOriginAt depth
      right := routeBottleneckOriginAt depth
      occurrence_ne := collision.originsDistinct
      visible_eq := collision.sameObservation
      authority_ne := collision.repairsDistinct }

/-! ## Whole-carrier cause and repair involutions -/

/-- Swap the two existing exact-source constructors.  Proof payloads are
regenerated by the existing canonical source producers. -/
def fullDomainRepairCauseSwapAt (depth : Nat) :
    RepairFailureOriginAt depth → RepairFailureOriginAt depth
  | .tenureCapture _ => routeBottleneckOriginAt depth
  | .routeBottleneck _ => tenureCaptureOriginAt depth

theorem fullDomainRepairCauseSwap_involutive
    (depth : Nat) (origin : RepairFailureOriginAt depth) :
    fullDomainRepairCauseSwapAt depth
        (fullDomainRepairCauseSwapAt depth origin) = origin := by
  cases origin <;>
    simp [fullDomainRepairCauseSwapAt, tenureCaptureOriginAt,
      routeBottleneckOriginAt]

/-- Genuine equivalence on the entire dependent failure-origin carrier, not
an equivalence merely between the two canonical endpoint terms. -/
def fullDomainRepairCauseSwapEquivAt (depth : Nat) :
    RepairFailureOriginAt depth ≃ RepairFailureOriginAt depth where
  toFun := fullDomainRepairCauseSwapAt depth
  invFun := fullDomainRepairCauseSwapAt depth
  left_inv := fullDomainRepairCauseSwap_involutive depth
  right_inv := fullDomainRepairCauseSwap_involutive depth

@[simp] theorem fullDomainRepairCauseSwap_tenure (depth : Nat) :
    fullDomainRepairCauseSwapEquivAt depth (tenureCaptureOriginAt depth) =
      routeBottleneckOriginAt depth :=
  rfl

@[simp] theorem fullDomainRepairCauseSwap_route (depth : Nat) :
    fullDomainRepairCauseSwapEquivAt depth (routeBottleneckOriginAt depth) =
      tenureCaptureOriginAt depth :=
  rfl

/-- Swap the two existing repair constructors. -/
def fullDomainRepairSwap : ExactExitRepair → ExactExitRepair
  | .removeCapture => .restoreRoute
  | .restoreRoute => .removeCapture

theorem fullDomainRepairSwap_involutive (repair : ExactExitRepair) :
    fullDomainRepairSwap (fullDomainRepairSwap repair) = repair := by
  cases repair <;> rfl

def fullDomainRepairSwapEquiv : ExactExitRepair ≃ ExactExitRepair where
  toFun := fullDomainRepairSwap
  invFun := fullDomainRepairSwap
  left_inv := fullDomainRepairSwap_involutive
  right_inv := fullDomainRepairSwap_involutive

theorem fullDomainRepairSwap_ne (repair : ExactExitRepair) :
    fullDomainRepairSwapEquiv repair ≠ repair := by
  cases repair <;> decide

/-! ## Observer commuting squares on every exact origin -/

theorem fullDomainRepairCauseSwap_forget_commutes
    (depth : Nat) (origin : RepairFailureOriginAt depth) :
    (fullDomainRepairObserverAt depth).forget
        (fullDomainRepairCauseSwapEquivAt depth origin) =
      (Equiv.refl FullDomainReachabilityObservation)
        ((fullDomainRepairObserverAt depth).forget origin) := by
  cases origin with
  | tenureCapture failure =>
      change fullDomainReachabilityObservationAt depth
          (routeBottleneckOriginAt depth) =
        fullDomainReachabilityObservationAt depth (.tenureCapture failure)
      have originExact : tenureCaptureOriginAt depth =
          RepairFailureOriginAt.tenureCapture failure := by
        apply congrArg RepairFailureOriginAt.tenureCapture
        exact Subsingleton.elim _ _
      exact (canonical_full_observations_equal depth).symm.trans
        (congrArg (fullDomainReachabilityObservationAt depth) originExact)
  | routeBottleneck failure =>
      change fullDomainReachabilityObservationAt depth
          (tenureCaptureOriginAt depth) =
        fullDomainReachabilityObservationAt depth (.routeBottleneck failure)
      have originExact : routeBottleneckOriginAt depth =
          RepairFailureOriginAt.routeBottleneck failure := by
        apply congrArg RepairFailureOriginAt.routeBottleneck
        exact Subsingleton.elim _ _
      exact (canonical_full_observations_equal depth).trans
        (congrArg (fullDomainReachabilityObservationAt depth) originExact)

theorem fullDomainRepairCauseSwap_authority_commutes
    (depth : Nat) (origin : RepairFailureOriginAt depth) :
    (fullDomainRepairObserverAt depth).authorityK
        (fullDomainRepairCauseSwapEquivAt depth origin) =
      fullDomainRepairSwapEquiv
        ((fullDomainRepairObserverAt depth).authorityK origin) := by
  cases origin <;> rfl

/-- All three coordinates are genuine equivalences and both squares commute
for every source origin. -/
def fullDomainRepairAdmissibleAutomorphismAt (depth : Nat) :
    AdmissibleObserverAutomorphism (fullDomainRepairObserverAt depth) where
  occurrenceEquiv := fullDomainRepairCauseSwapEquivAt depth
  visibleEquiv := Equiv.refl _
  authorityEquiv := fullDomainRepairSwapEquiv
  forget_commutes := fullDomainRepairCauseSwap_forget_commutes depth
  authority_commutes :=
    fullDomainRepairCauseSwap_authority_commutes depth

/-! ## Depth-only vertical producer and canonical rooted direction -/

/-- Sole public obstruction producer.  The canonical tenure-capture origin
anchors a reachable fibre; repair swapping has no fixed point anywhere, so
every origin in that fibre changes authority. -/
def fullDomainRepairVerticalAt (depth : Nat) :
    AuthorityChangingVerticalAutomorphism
      (fullDomainRepairObserverAt depth) where
  automorphism := fullDomainRepairAdmissibleAutomorphismAt depth
  anchor := fullDomainReachabilityObservationAt depth
    (tenureCaptureOriginAt depth)
  anchorOccurrence := tenureCaptureOriginAt depth
  anchor_reachable := rfl
  fixesVisible := rfl
  changesAuthorityOnFiber := by
    intro origin _inFiber
    exact fullDomainRepairSwap_ne
      ((fullDomainRepairObserverAt depth).authorityK origin)

def fullDomainRepairRootedObserverObstructionAt (depth : Nat) :
    RootedObserverObstructionAt (fullDomainRepairVerticalAt depth) :=
  rootedObserverObstruction (fullDomainRepairVerticalAt depth)

def fullDomainRepairCanonicalDirectionAt (depth : Nat) :
    SourceGeneratedObserverAttachingDirectionAt
      (fullDomainRepairRootedObserverObstructionAt depth) :=
  canonicalObserverObstructionDirection (fullDomainRepairVerticalAt depth)

theorem fullDomainRepair_rooted_kernel_is_collision (depth : Nat) :
    (fullDomainRepairRootedObserverObstructionAt depth).kernelPair =
      fullDomainRepairKernelPairAt depth :=
  rfl

theorem fullDomainRepair_rooted_kernel_left (depth : Nat) :
    (fullDomainRepairRootedObserverObstructionAt depth).kernelPair.left =
      tenureCaptureOriginAt depth :=
  rfl

theorem fullDomainRepair_rooted_kernel_right (depth : Nat) :
    (fullDomainRepairRootedObserverObstructionAt depth).kernelPair.right =
      routeBottleneckOriginAt depth :=
  rfl

theorem fullDomainRepair_direction_boundary_eq_rooted (depth : Nat) :
    (fullDomainRepairCanonicalDirectionAt depth).boundaryKernelPair =
      (fullDomainRepairRootedObserverObstructionAt depth).kernelPair :=
  canonicalObserverObstructionDirection_boundary
    (fullDomainRepairVerticalAt depth)

theorem fullDomainRepair_direction_boundary_is_collision (depth : Nat) :
    (fullDomainRepairCanonicalDirectionAt depth).boundaryKernelPair =
      fullDomainRepairKernelPairAt depth := by
  rw [fullDomainRepair_direction_boundary_eq_rooted,
    fullDomainRepair_rooted_kernel_is_collision]

def fullDomainRepair_direction_boundary_law (depth : Nat) :
    GeneratedObserverDirectionBoundaryAt
      (fullDomainRepairRootedObserverObstructionAt depth)
      (fullDomainRepairCanonicalDirectionAt depth).direction
      (fullDomainRepairRootedObserverObstructionAt depth).kernelPair :=
  canonicalObserverObstructionDirection_boundaryLaw
    (fullDomainRepairVerticalAt depth)

theorem fullDomainRepair_obstruction_mouth_has_no_registry_trace_or_probability
    (depth : Nat) : True := by
  let vertical := fullDomainRepairVerticalAt depth
  fail_if_success exact vertical.causeRegistry
  fail_if_success exact vertical.repairRegistry
  fail_if_success exact vertical.root
  fail_if_success exact vertical.occurrenceTrace
  fail_if_success exact vertical.probability
  fail_if_success exact vertical.weights
  fail_if_success exact vertical.support
  fail_if_success exact vertical.coverage
  fail_if_success exact vertical.completedHistory
  fail_if_success exact vertical.futureTable
  trivial

end
end M14FullDomainRepairAuthorityObstruction
end Society
end ProcessGame
end SaturationMonoid

