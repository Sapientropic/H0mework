import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Fixture.EssentialAccess.ActualUpdate.Selection.U8.Revised.SourceGeneratedHealthTargetCriticalEventSelectionU8Compilation
import H0mework.Foundation.Runtime.Inquiry

/-!
# Health-target critical-event selection U8 engine

The depth-one health-target occurrence is installed as one inquiry state.
Its source compiler is the already generated U8 program, and its compilation
face is the inquiry coordinate inherited by the same health-cessation root.
The canonical one-step process exposes the exact revised resolution, its full
coface answer-and-next receipt and the generated revised-root successor.  It
does not add a sibling root, ledger, occurrence or revision source.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceGeneratedHealthTargetCriticalEventSelectionU8Runtime

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open ConstructiveRoot.RootInquiryCompletion
open ConstructiveRoot.ObstructionGeneratedMinimalCoface
open ConstructiveRoot.TypedSemanticWorldNetworkU8
open M9SourceHealthCessationSuffix
open M14SourceGeneratedHealthCessationTargetRoot
open M14SourceGeneratedHealthCessationTargetHistory
open M14SourceGeneratedHealthTargetCriticalEventSelectionU8Frontier
open M14SourceGeneratedCriticalEventSelectionRevisedLedger
open M14SourceGeneratedCriticalEventSelectionRevisedRoot
open M14SourceGeneratedHealthTargetCriticalEventSelectionU8Compilation

abbrev N := M14SourceGeneratedHealthCessationTargetRoot.N
abbrev V := M14SourceGeneratedHealthCessationTargetRoot.V

/-- The inherited inquiry coordinate certifies the exact output of the fixed
health-target U8 compiler at depth one. -/
def healthTargetSelectionCompilationFace :
    SourceNativeRootInquiryCompilationFaceCoreAt
      healthCessationTargetRoot
      (healthCessationTargetTemporalVisitAt 1) ()
      healthTargetSelectionInquiryEvent
      RootInquiryU8CompletionRegression.entry
      (healthTargetFailureLivingAuthorityAt 1)
      generatedHealthTargetSelectionU8Compilation.output where
  projection := M9SourceHealthCessationSuffix.inquiryProjection
  active := PUnit.unit
  classifier_eq := rfl
  project_heq := HEq.rfl

/-- Fixed old-root inquiry state.  No core, target current or revised root is
accepted as a field: all of them are generated by the installed compiler. -/
def healthTargetSelectionInquiryState : RootInquiryStateAt N V where
  root := healthCessationTargetRoot
  visit := healthCessationTargetTemporalVisitAt 1
  U7 := M14SourceGeneratedHealthTargetCriticalEventSelectionU8Frontier.U7
  calculus := RootInquiryU8CompletionRegression.theoryAuditCalculus
  Query := Unit
  entryAt := fun _ => RootInquiryU8CompletionRegression.entry
  authorityAt := fun _ => healthTargetFailureLivingAuthorityAt 1
  compilationProgramAt := fun _ => healthTargetSelectionRequiresU8Program
  compilationFaceAt := fun _ => healthTargetSelectionCompilationFace
  u7RootDisposition_commutes := by
    intro _query _obstruction _audit audit_eq
    cases audit_eq
    exact healthTargetTheoryAuditRootDispositionCommutesAt 1

def healthTargetSelectionEngineState : RootInquiryEngineStateAt N V :=
  RootInquiryEngineStateAt.create healthTargetSelectionInquiryState

def healthTargetSelectionPresentation : RootInquiryStatePresentation where
  N := N
  V := V
  state := healthTargetSelectionEngineState

/-- Canonical finite process for this one source occurrence.  The answered
node retains the generated revised target and exposes no replay query. -/
def healthTargetSelectionOneStepProcess : SourceNativeInquiryEngineProcess.{0} :=
  healthTargetSelectionPresentation.oneShotProcess

def healthTargetSelectionEngine : Engine healthTargetSelectionOneStepProcess :=
  Engine.initial healthTargetSelectionOneStepProcess

def healthTargetSelectionActivation :
    Engine.SourceNativeInquiryActivationAt healthTargetSelectionEngine :=
  healthTargetSelectionEngine.uniqueInquiryActivation () (by
    intro candidate
    cases candidate
    rfl)

/-- Exact execution of the installed depth-one compiler. -/
def healthTargetSelectionOccurrence :=
  healthTargetSelectionEngine.ask healthTargetSelectionActivation

/-- State-indexed spelling of the already generated core. -/
def healthTargetSelectionCompletion :
    SourceGeneratedInquiryU8CompletionAt healthTargetSelectionInquiryState ()
      RootInquiryU8CompletionRegression.obstruction
      RootInquiryU8CompletionRegression.u7Gate
      RootInquiryU8CompletionRegression.failure :=
  healthTargetSelectionU8Core

@[simp] theorem healthTargetSelectionCompletion_exact :
    healthTargetSelectionCompletion = healthTargetSelectionU8Core :=
  rfl

@[simp] theorem healthTargetSelectionOccurrence_resolution_exact :
    healthTargetSelectionOccurrence.resolution =
      .revised RootInquiryU8CompletionRegression.obstruction
        RootInquiryU8CompletionRegression.u7Gate
        RootInquiryU8CompletionRegression.failure
        healthTargetSelectionU8Core :=
  rfl

set_option linter.defProp false in
def healthTargetSelectionInstalledCompilation_factorizes :=
  healthTargetSelectionEngineState.generatedCompilation_factorizes ()

/-- The revised answer authority is the initial-coface factorization and
first actual write of the same typed revision source. -/
def healthTargetSelectionRevisedAnswerAuthority_factorizes :=
  healthTargetSelectionCompletion.revisedAnswerAuthority_factorizes

/-- Complete U8 receipt: coface factorization/realization plus both live-row
answer-and-next receipts. -/
def healthTargetSelectionCofaceAnswerAndNextReceipt :
    healthTargetSelectionCompletion.CofaceAnswerAndNextReceiptAt :=
  healthTargetSelectionOccurrence.receipt.2

def healthTargetSelectionOldRowAnswerAndNext :=
  healthTargetSelectionCofaceAnswerAndNextReceipt.2.1

def healthTargetSelectionNewRowAnswerAndNext :=
  healthTargetSelectionCofaceAnswerAndNextReceipt.2.2

@[simp] theorem healthTargetSelectionRows_share_generatedNext :
    healthTargetSelectionOldRowAnswerAndNext.nextCurrent =
      healthTargetSelectionNewRowAnswerAndNext.nextCurrent :=
  rfl

/-- The one-step successor erases to the authoritative root generated by the
typed revision; its root component is exactly the existing revised living
root, not a sibling presentation. -/
theorem healthTargetSelectionNext_preserves_exact_revisedLivingRoot :
    HEq healthTargetSelectionOccurrence.next.node.erase.current.root
      revisedLivingRoot.toAuthoritativeRoot :=
  HEq.rfl

set_option linter.defProp false in
def healthTargetSelectionNext_erases_to_generated :=
  healthTargetSelectionOccurrence.next_erases_to_generated

/-- The canonical one-step helper deliberately has no recursive runtime:
after its exact occurrence the query fibre is empty.  A later runtime file
must therefore install inquiry states generated by the revised root instead
of replaying this old-root occurrence. -/
theorem healthTargetSelectionOneStepRuntime_isEmpty :
    IsEmpty (SourceNativeInquiryRuntime healthTargetSelectionOneStepProcess) :=
  by
    constructor
    intro runtime
    have impossible : PEmpty :=
      (runtime.activationLaw.nextAt none
        runtime.activationLaw.initial).query
    exact nomatch impossible

/-- Public consumer of the single state/compiler/receipt/next chain. -/
theorem healthTargetSelectionU8Engine_directConsumer :
    healthTargetSelectionInquiryState.compilationProgramAt () =
        healthTargetSelectionRequiresU8Program ∧
      healthTargetSelectionInquiryState.compilationFaceAt () =
        healthTargetSelectionCompilationFace ∧
      healthTargetSelectionOccurrence.resolution =
        .revised RootInquiryU8CompletionRegression.obstruction
          RootInquiryU8CompletionRegression.u7Gate
          RootInquiryU8CompletionRegression.failure
          healthTargetSelectionU8Core ∧
      Nonempty healthTargetSelectionCompletion.CofaceAnswerAndNextReceiptAt ∧
      HEq healthTargetSelectionOccurrence.next.node.erase.current.root
        revisedLivingRoot.toAuthoritativeRoot :=
  ⟨rfl, rfl, rfl, ⟨healthTargetSelectionCofaceAnswerAndNextReceipt⟩,
    HEq.rfl⟩

end
end M14SourceGeneratedHealthTargetCriticalEventSelectionU8Runtime
