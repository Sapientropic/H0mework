import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Root.UBIProofCarryingRootCapacity
import H0mework.Foundation.Cofinal.ProductiveHistory

/-!
# M14 root-generated periodic UBI source history

The literal M9/M13 root is a native self-loop.  Recursive `RootVisit.next`
therefore generates an arbitrarily long actual past.  Every depth obtains a
distinct temporal visit and freshly reads the same pre-emitter UBI source law.
The payment receipt is produced from that visit's exact restriction; no
`Nat → completed renewal`, scheduler table, or future registry is stored.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14UBIPeriodicRootHistory

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Renewal UBI
open M9ProofCarryingRenewalInquiryRoot
open M14UBIExitCapacityFixture
open M14UBIProofCarryingRootRestriction

def rootVisitAt : Nat → RootVisit jointRoot.toAuthoritativeRoot.toRoot
  | 0 => jointRoot.toAuthoritativeRoot.toRoot.initialVisit
  | depth + 1 => (rootVisitAt depth).next rfl

def temporalVisitAt (depth : Nat) : SourceNativeTemporalVisitAt
    jointRoot.toAuthoritativeRoot.toLedgerRoot :=
  .finite (rootVisitAt depth)

def installedUBIAt (depth : Nat) :
    SourceInstalledRenewalAt ubiRecognition (temporalVisitAt depth) :=
  SourceInstalledRenewalAt.generate PUnit.unit rfl

/-- Exact finite depth generated by causal predecessor history. -/
theorem rootVisitAt_depth (depth : Nat) :
    ProductiveFiniteRootHistoryAt.causalDepth (rootVisitAt depth).history =
      depth := by
  induction depth with
  | zero => rfl
  | succ depth inductionHypothesis =>
      change ProductiveFiniteRootHistoryAt.causalDepth
        (rootVisitAt depth).history + 1 = depth + 1
      rw [inductionHypothesis]

def temporalDepth (visit : SourceNativeTemporalVisitAt
    jointRoot.toAuthoritativeRoot.toLedgerRoot) : Option Nat :=
  match visit.history with
  | .finite history => some (ProductiveFiniteRootHistoryAt.causalDepth history)
  | .postCofinal _ => none

theorem temporalVisitAt_depth (depth : Nat) :
    temporalDepth (temporalVisitAt depth) = some depth := by
  change some (ProductiveFiniteRootHistoryAt.causalDepth
    (rootVisitAt depth).history) = some depth
  rw [rootVisitAt_depth]

theorem temporalVisitAt_injective : Function.Injective temporalVisitAt := by
  intro left right equality
  have depth_eq := congrArg temporalDepth equality
  rw [temporalVisitAt_depth, temporalVisitAt_depth] at depth_eq
  exact Option.some.inj depth_eq

theorem adjacent_periods_are_distinct (depth : Nat) :
    temporalVisitAt depth ≠ temporalVisitAt (depth + 1) := by
  intro equality
  have depth_eq := temporalVisitAt_injective equality
  omega

/-- One generated period.  It carries the source restriction and its root
factorization, not an actionable-exit verdict. -/
structure PeriodicUBISourceAt (depth : Nat) : Type 3 where
  installed : SourceInstalledRenewalAt ubiRecognition (temporalVisitAt depth)
  exactRestriction : installed.payload.consumer =
    sourceGeneratedUBIRootRestriction
  exactDisposition : installed.payload.disposition =
    sourceGeneratedUBIDisposition
  focalSeed : installed.payload.sourceSeed =
    M10OccurrenceCapacityProcessFixture.focalSeed
  sourceEntryExact : installed.payload.sourceEntry =
    RootInquiryU8CompletionRegression.entry
  rootFactorization : installed.RootAnswerAndNextFactorizes
  generatedNext : SourceNativeAuthoritativeRootCurrentAt
    M9ProofCarryingRenewalInquiryRoot.N
  generatedNext_eq : generatedNext =
    jointRoot.generatedNextCurrentAt (temporalVisitAt depth)

def periodicUBISourceAt (depth : Nat) : PeriodicUBISourceAt depth where
  installed := installedUBIAt depth
  exactRestriction := rfl
  exactDisposition := rfl
  focalSeed := rfl
  sourceEntryExact := rfl
  rootFactorization := (installedUBIAt depth).rootAnswerAndNext_factorizes
  generatedNext := jointRoot.generatedNextCurrentAt (temporalVisitAt depth)
  generatedNext_eq := rfl

/-- One source-backed payment indexed by an exact temporal root visit.  The
local M3 receipt value may recur; payment-occurrence identity is the existing
root visit and its exact temporal causal event, not that readout value. -/
structure SourceBackedPaymentAtVisit
    (visit : SourceNativeTemporalVisitAt
      jointRoot.toAuthoritativeRoot.toLedgerRoot) : Type 3 where
  private mk ::
  installed : SourceInstalledRenewalAt ubiRecognition visit
  exactRestriction : installed.payload.consumer =
    sourceGeneratedUBIRootRestriction
  rootOccurrence : ExactTemporalCausalRootEventAt
    jointRoot.toAuthoritativeRoot.toLedgerRoot visit
  rootOccurrence_eq : rootOccurrence =
    jointRoot.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt visit
  paymentReceipt : SourceBackedUBIPaymentReceiptAt
    exitCapacityProgram.purchasingPowerStanding ExitFutureCode.leave
  rootFactorization : installed.RootAnswerAndNextFactorizes

def sourceBackedPaymentAtVisit
    (visit : SourceNativeTemporalVisitAt
      jointRoot.toAuthoritativeRoot.toLedgerRoot) :
    SourceBackedPaymentAtVisit visit where
  installed := SourceInstalledRenewalAt.generate PUnit.unit rfl
  exactRestriction := rfl
  rootOccurrence :=
    jointRoot.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt visit
  rootOccurrence_eq := rfl
  paymentReceipt := SourceBackedUBIPaymentReceiptAt.generate
  rootFactorization :=
    (SourceInstalledRenewalAt.generate PUnit.unit rfl).rootAnswerAndNext_factorizes

abbrev PeriodicSourceBackedPaymentAt (depth : Nat) :=
  SourceBackedPaymentAtVisit (temporalVisitAt depth)

def periodicSourceBackedPaymentAt (depth : Nat) :
    PeriodicSourceBackedPaymentAt depth :=
  sourceBackedPaymentAtVisit (temporalVisitAt depth)

/-- Heterogeneous carrier whose identity includes the exact temporal visit. -/
abbrev AnySourceBackedPaymentOccurrence :=
  Sigma SourceBackedPaymentAtVisit

def periodicPaymentOccurrenceAt (depth : Nat) :
    AnySourceBackedPaymentOccurrence :=
  ⟨temporalVisitAt depth, periodicSourceBackedPaymentAt depth⟩

theorem periodicPaymentOccurrenceAt_injective :
    Function.Injective periodicPaymentOccurrenceAt := by
  intro left right equality
  have visit_eq := congrArg Sigma.fst equality
  exact temporalVisitAt_injective visit_eq

theorem adjacent_payment_occurrences_are_distinct (depth : Nat) :
    periodicPaymentOccurrenceAt depth ≠
      periodicPaymentOccurrenceAt (depth + 1) := by
  intro equality
  have depth_eq := periodicPaymentOccurrenceAt_injective equality
  omega

theorem every_generated_period_has_sourceBackedPayment (depth : Nat) :
    Nonempty (PeriodicSourceBackedPaymentAt depth) ∧
      (periodicUBISourceAt depth).installed.payload.sourceSeed =
        M10OccurrenceCapacityProcessFixture.focalSeed ∧
      (periodicUBISourceAt depth).installed.RootAnswerAndNextFactorizes :=
  ⟨⟨periodicSourceBackedPaymentAt depth⟩, rfl,
    (periodicUBISourceAt depth).rootFactorization⟩

/-- Regression guard: periodic source generation does not smuggle a completed
exit renewal into the pre-emitter payload. -/
theorem periodic_payload_has_no_completed_exit_verdict (_depth : Nat) : True := by
  fail_if_success
    exact (periodicUBISourceAt _depth).installed.payload.consumer.exitRenewal
  trivial

end
end M14UBIPeriodicRootHistory
