import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Observer.SourceWitnessRefinement

/-!
# Source publication of actual-cycle reflexive memory

The period-three relation seed readout identifies two cross depths whose actual
action occurrences differ.  The later occurrence owns the canonical P130/P45
cycle-memory witness generated by the same runtime; the earlier endpoint does
not.  Honest publication of that dependent fibre refines the exact observer
kernel without creating an occurrence registry or changing authority `K`.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceGeneratedActualRelationCycleMemoryWitnessPublication

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open ConstructiveRoot.RootInquiryCompletion
open Observer
open M14SourceGeneratedCrossCompilerRelationCurrentRecurrence
open M14SourceGeneratedCrossCompilerRelationAppendPresentation
open M14SourceGeneratedCrossCompilerRelationAppendRuntime
open M14SourceGeneratedActualRelationThreeCycle
open M14ProofCarryingActualRelationCycleReflexiveMemory

/-- Coarse observation reads the generated relation identity; authority reads
the exact action occurrence presentation at that same cross depth. -/
def cycleMemoryAuthorityObserver :
    AuthorityObserver Nat ExactRelationSeed AnyAuthoritativeRootCurrent where
  forget := actualRelationSeedAt
  authorityK := fun depth =>
    (crossCompilerActionPresentationAt depth).erase

/-- The later renewed lineage and its earlier incarnation share the coarse
seed while remaining different actual occurrences. -/
def cycleMemoryKernelPairAt (base : Nat) :
    AuthorityKernelPair cycleMemoryAuthorityObserver where
  left := base + 3
  right := base
  occurrence_ne := by omega
  visible_eq := (periodThreeSeed_differentCrossCompilerOccurrence base).1
  authority_ne := (periodThreeSeed_differentCrossCompilerOccurrence base).2

/-- A dependent publication fibre at the later occurrence.  Its evidence is
the already generated P130/P45 consumer at this exact cycle base. -/
structure SourceGeneratedActualRelationCycleMemoryWitnessAt
    (base depth : Nat) : Type where
  private mk ::
  actualCycle :
    type_of% (actualRelationThreeCycle_directConsumer base)
  cycleMemory :
    type_of% (actualRelationRoleRing_p130_reflexiveMemory base)
  recollectableMemory :
    type_of% (actualRelationRoleRing_p130_recollectablePotential base)
  depth_eq : depth = base + 3

/-- Sole witness producer. -/
def sourceGeneratedActualRelationCycleMemoryWitnessAt (base : Nat) :
    SourceGeneratedActualRelationCycleMemoryWitnessAt base (base + 3) where
  actualCycle := actualRelationThreeCycle_directConsumer base
  cycleMemory := actualRelationRoleRing_p130_reflexiveMemory base
  recollectableMemory := actualRelationRoleRing_p130_recollectablePotential base
  depth_eq := rfl

theorem cycleMemoryWitnessAt_base_isEmpty (base : Nat) :
    IsEmpty (SourceGeneratedActualRelationCycleMemoryWitnessAt base base) :=
  ⟨fun witness => by
    have impossible := witness.depth_eq
    omega⟩

/-- The published fibre itself projects back to the same-runtime three-edge
producer; this provenance is not borrowed from a sibling whole-sink field. -/
theorem cycleMemoryWitnessAt_actualCycle
    {base depth : Nat}
    (witness : SourceGeneratedActualRelationCycleMemoryWitnessAt base depth) :
    type_of% (actualRelationThreeCycle_directConsumer base) :=
  witness.actualCycle

/-- Total public bit.  It is a readout whose honesty is proved below, not an
input to the witness producer. -/
def cycleMemoryPublicationTag (base depth : Nat) : Bool :=
  decide (depth = base + 3)

theorem cycleMemoryPublicationTag_true_iff (base depth : Nat) :
    cycleMemoryPublicationTag base depth = true ↔
      Nonempty (SourceGeneratedActualRelationCycleMemoryWitnessAt base depth) := by
  constructor
  · intro published
    have depth_eq : depth = base + 3 := by
      simpa [cycleMemoryPublicationTag] using published
    subst depth
    exact ⟨sourceGeneratedActualRelationCycleMemoryWitnessAt base⟩
  · rintro ⟨witness⟩
    have depth_eq := witness.depth_eq
    subst depth
    simp [cycleMemoryPublicationTag]

def cycleMemoryPublicationAt (base : Nat) :
    SourceWitnessPublicationAt
      (SourceGeneratedActualRelationCycleMemoryWitnessAt base) where
  publicationTag := cycleMemoryPublicationTag base
  publicationTag_eq_true_iff :=
    cycleMemoryPublicationTag_true_iff base

/-- Existing generic refinement consumes the exact inhabited/empty split. -/
theorem cycleMemoryKernelRefinementAt (base : Nat) :
    SourceWitnessKernelRefinementAt
      (cycleMemoryPublicationAt base) (cycleMemoryKernelPairAt base) := by
  apply sourceWitnessKernelRefinement
  · exact ⟨sourceGeneratedActualRelationCycleMemoryWitnessAt base⟩
  · exact cycleMemoryWitnessAt_base_isEmpty base

def cycleMemoryRefinedObserverAt (base : Nat) :=
  sourceWitnessRefinedObserver cycleMemoryAuthorityObserver
    (cycleMemoryPublicationAt base)

theorem cycleMemory_coarseVisible_eq (base : Nat) :
    cycleMemoryAuthorityObserver.forget (base + 3) =
      cycleMemoryAuthorityObserver.forget base :=
  (cycleMemoryKernelRefinementAt base).coarseVisible_eq

theorem cycleMemory_refinedVisible_ne (base : Nat) :
    (cycleMemoryRefinedObserverAt base).forget (base + 3) ≠
      (cycleMemoryRefinedObserverAt base).forget base :=
  (cycleMemoryKernelRefinementAt base).refinedVisible_ne

end
end M14SourceGeneratedActualRelationCycleMemoryWitnessPublication
end Society
end ProcessGame
end SaturationMonoid

