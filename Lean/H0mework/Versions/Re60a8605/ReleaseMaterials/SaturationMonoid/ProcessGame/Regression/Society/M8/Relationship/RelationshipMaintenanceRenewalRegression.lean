import H0mework.Society.Renewal.RenewalFaceSource
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Relationship.SourceGeneratedMaintenanceAsymmetry
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M8.Relationship.MaintenanceRelationshipFixture

/-!
# M8 relationship renewal face

The local renewal face is generated from the exact M0 actor seed underlying
one M2 relation.  Its consumer and disposition are the M3 maintained edge on
the same exchange leg.  Control is induced from an exact source-selected
maintenance-permission type whose reverse fibre is empty.  Debt direction is
the exact obligation/residual fibre selected at that same event; its reverse
fibre is empty.  The generic relations below are readouts, not caller labels.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M8RelationshipMaintenanceRenewalRegression

open ResponsibilityLifecycle
open Lifecycle Universal Relations Exchange Settlement Renewal
open Relationship
open Lifecycle.Universal.FixedAdapter
open M3FiniteExchangeFixture
open M3SettlementDispositionRegression
open M8RelationshipMaintenanceFixture

/-- Every target token has a canonical M2 relation seed at the fixed exact
`.after` occurrence state.  This avoids eliminating a Prop-valued trace
witness into data. -/
def canonicalRelationSeed (token : Lifecycle.TargetToken) :
    relationCompiler.ExactRelationSeed :=
  ⟨token, .after, by simp [Lifecycle.actualEventOccurrenceOf], rfl⟩

def relationshipStandingOf
    (seed : SourceSeed Lifecycle.actualEventOccurrenceOf
      targetFace.Seed targetFace.SeedAt Lifecycle.actualEventGame.source) :
    relationCompiler.GeneratedRelation :=
  relationCompiler.relationOf (canonicalRelationSeed seed.1)

/-- Seed-indexed exact consumer; the leg and actor seed must be the ones
generated by the same exchange restriction. -/
structure RelationshipConsumerAt
    (seed : SourceSeed Lifecycle.actualEventOccurrenceOf
      targetFace.Seed targetFace.SeedAt Lifecycle.actualEventGame.source) where
  leg : Leg
  seed_eq : seed =
    (exactExchangeSeed.relationExactSeed exchangeCompiler leg).actorSeed
      relationCompiler
  exactConsumer : MaintenanceGeneratedRelationshipStandingAt leg

/-- The local disposition stores the exact M3 maintained boundary equation,
not a standing value or a future schedule. -/
structure RelationshipDispositionAt
    (seed : SourceSeed Lifecycle.actualEventOccurrenceOf
      targetFace.Seed targetFace.SeedAt Lifecycle.actualEventGame.source) where
  leg : Leg
  seed_eq : seed =
    (exactExchangeSeed.relationExactSeed exchangeCompiler leg).actorSeed
      relationCompiler
  maintained :
    (settlementOf leg .maintain).disposition = .carry (.maintained ())

abbrev RelationshipRenewalFace :=
  SourceGeneratedRenewalFace Lifecycle.actualEventGame
    targetFace.Seed targetFace.SeedAt targetFace.Lineage targetFace.lineageOf
    relationCompiler.GeneratedRelation relationshipStandingOf
    RelationshipConsumerAt RelationshipDispositionAt

def relationshipRenewalSeed :
    SourceSeed Lifecycle.actualEventOccurrenceOf
      targetFace.Seed targetFace.SeedAt Lifecycle.actualEventGame.source :=
  (exactExchangeSeed.relationExactSeed exchangeCompiler .a).actorSeed
    relationCompiler

def relationshipConsumer : RelationshipConsumerAt relationshipRenewalSeed where
  leg := .a
  seed_eq := rfl
  exactConsumer := maintenanceGeneratedRelationshipStanding .a

def relationshipDisposition :
    RelationshipDispositionAt relationshipRenewalSeed where
  leg := .a
  seed_eq := rfl
  maintained := rfl

/-- Source-generated local relationship face.  Operational standing still
requires the separate root-installation layer. -/
def relationshipRenewalFace : RelationshipRenewalFace :=
  SourceGeneratedRenewalFace.generate relationshipRenewalSeed
    relationshipConsumer relationshipDisposition

@[simp] theorem relationshipRenewalFace_event :
    relationshipRenewalFace.event = legToken .a :=
  rfl

theorem relationshipRenewalFace_event_mem_trace :
    ∃ state ∈ Lifecycle.actualEventGame.occurrence.trace,
      targetFace.SeedAt Lifecycle.actualEventGame.source state
        relationshipRenewalFace.event :=
  relationshipRenewalFace.event_mem_source_trace

theorem relationshipRenewalFace_actor_exact :
    relationshipRenewalFace.actor = renewalController .a :=
  rfl

theorem relationshipRenewalFace_standing_exact :
    relationshipRenewalFace.standing =
      exactExchangeSeed.relation exchangeCompiler .a :=
  by
    apply Subtype.ext
    rfl

/-- Relationship parties are exact exchange restrictions.  Actors are still
generated from those restrictions by `renewalController`; no party registry
is introduced. -/
abbrev RelationshipParty := Leg

/-- Exact maintenance permission selected by the source event.  Its reversed
permission fibre is empty at that same event. -/
def sourceRenewalControlAsymmetry :
    SourceGeneratedMaintenanceControlAsymmetryAt
      relationshipRenewalFace.event SelectedMaintenanceControlAt
      (.a : RelationshipParty) (counterparty .a) where
  selected := selectedMaintenanceControl .a
  reverseEmpty := reverseMaintenanceControl_empty .a

/-- Debt direction is the exact obligation/residual fibre selected by this
maintenance event.  The reciprocal obligation lives at its reciprocal event
and therefore cannot witness a reverse flow here. -/
def sourceDebtFlowAsymmetry :
    SourceGeneratedMaintenanceDebtFlowAsymmetryAt
      relationshipRenewalFace.event SelectedMaintenanceDebtFlowAt
      (.a : RelationshipParty) (counterparty .a) where
  selected := selectedMaintenanceDebtFlow .a
  reverseEmpty := reverseMaintenanceDebtFlow_empty .a

/-- Both source-native asymmetries share the exact local renewal event. -/
def sourceMaintenanceDebtAsymmetry :
    SourceGeneratedMaintenanceDebtAsymmetryAt
      relationshipRenewalFace.event SelectedMaintenanceControlAt
      SelectedMaintenanceDebtFlowAt
      (.a : RelationshipParty) (counterparty .a)
      (.a : RelationshipParty) (counterparty .a) where
  control := sourceRenewalControlAsymmetry
  debtFlow := sourceDebtFlowAsymmetry

theorem relationshipControlAsymmetry :
    RenewalControlAsymmetryAt relationshipRenewalFace RelationshipParty
      sourceRenewalControlAsymmetry.ControlsAt .a (counterparty .a) where
  controls := sourceRenewalControlAsymmetry.controls
  noReverseControl := sourceRenewalControlAsymmetry.noReverseControl

theorem relationshipDebtFlowAsymmetry :
    DebtFlowAsymmetryAt relationshipRenewalFace RelationshipParty
      sourceDebtFlowAsymmetry.DebtFlowsAt .a (counterparty .a) where
  flows := sourceDebtFlowAsymmetry.flows
  noReverseFlow := sourceDebtFlowAsymmetry.noReverseFlow

/-- Structural exploitation signature: independent exact control and debt
directions on one source-generated renewal event. -/
theorem relationshipRenewalDebtAsymmetry :
    RenewalDebtAsymmetryAt relationshipRenewalFace RelationshipParty
      sourceRenewalControlAsymmetry.ControlsAt
      sourceDebtFlowAsymmetry.DebtFlowsAt
      .a (counterparty .a) .a (counterparty .a) where
  renewalControl := relationshipControlAsymmetry
  debtFlow := relationshipDebtFlowAsymmetry

/-- Empty relation seeds cannot manufacture a local relationship standing. -/
def noRelationshipSeedAt
    (_source : Unit) (_state : Lifecycle.EventState) (_seed : Empty) : Prop :=
  False

def noRelationshipLineage (_source : Unit) := Empty

def noRelationshipLineageOf
    (source : Unit)
    (seed : SourceSeed Lifecycle.actualEventOccurrenceOf Empty
      noRelationshipSeedAt source) : noRelationshipLineage source :=
  nomatch seed.1

theorem no_free_relationship_standing :
    SourceGeneratedRenewalFace Lifecycle.actualEventGame
      Empty noRelationshipSeedAt noRelationshipLineage noRelationshipLineageOf
      relationCompiler.GeneratedRelation
      (fun seed => nomatch seed.1)
      (fun seed => nomatch seed.1)
      (fun seed => nomatch seed.1) → False :=
  noSourceSeed_noRenewalFace (fun seed => nomatch seed.1)

/-- Local relationship certificate.  It records one exact maintained face
and the two independently evidenced asymmetries, without claiming root-level
operational standing. -/
structure RelationshipLocalRenewalFaceCertificate where
  traceWitnessed :
    ∃ state ∈ Lifecycle.actualEventGame.occurrence.trace,
      targetFace.SeedAt Lifecycle.actualEventGame.source state
        relationshipRenewalFace.event
  actorExact : relationshipRenewalFace.actor = renewalController .a
  relationStandingExact :
    relationshipRenewalFace.standing =
      exactExchangeSeed.relation exchangeCompiler .a
  exactConsumer : RelationshipConsumerAt relationshipRenewalFace.sourceSeed
  exactDisposition :
    RelationshipDispositionAt relationshipRenewalFace.sourceSeed
  sourceSelectedControl :
    SelectedMaintenanceControlAt relationshipRenewalFace.event .a
      (counterparty .a)
  reverseControlPermissionEmpty :
    SelectedMaintenanceControlAt relationshipRenewalFace.event
      (counterparty .a) .a → False
  sourceControlAsymmetry :
    SourceGeneratedMaintenanceControlAsymmetryAt
      relationshipRenewalFace.event SelectedMaintenanceControlAt
      (.a : RelationshipParty) (counterparty .a)
  sourceSelectedDebtFlow :
    SelectedMaintenanceDebtFlowAt relationshipRenewalFace.event .a
      (counterparty .a)
  reverseDebtFlowEmpty :
    SelectedMaintenanceDebtFlowAt relationshipRenewalFace.event
      (counterparty .a) .a → False
  exactDebtResponsibility : incidence.TargetResponsibilityAt
    (renewalController .a)
    (exactExchangeSeed.obligation exchangeCompiler .a)
    (exactExchangeSeed.sourceEvent exchangeCompiler .a)
  exactDebtLiveResidual :
    ExactSettlementEdge.LiveResidualAt (settlementOf .a .maintain)
  sourceDebtAsymmetry :
    SourceGeneratedMaintenanceDebtFlowAsymmetryAt
      relationshipRenewalFace.event SelectedMaintenanceDebtFlowAt
      (.a : RelationshipParty) (counterparty .a)
  sourceCombinedAsymmetry :
    SourceGeneratedMaintenanceDebtAsymmetryAt
      relationshipRenewalFace.event SelectedMaintenanceControlAt
      SelectedMaintenanceDebtFlowAt
      (.a : RelationshipParty) (counterparty .a)
      (.a : RelationshipParty) (counterparty .a)
  controlAsymmetry :
    RenewalControlAsymmetryAt relationshipRenewalFace RelationshipParty
      sourceRenewalControlAsymmetry.ControlsAt .a (counterparty .a)
  debtAsymmetry :
    DebtFlowAsymmetryAt relationshipRenewalFace RelationshipParty
      sourceDebtFlowAsymmetry.DebtFlowsAt .a (counterparty .a)
  combinedAsymmetry :
    RenewalDebtAsymmetryAt relationshipRenewalFace RelationshipParty
      sourceRenewalControlAsymmetry.ControlsAt
      sourceDebtFlowAsymmetry.DebtFlowsAt
      .a (counterparty .a) .a (counterparty .a)

def relationshipLocalRenewalFaceDirectConsumer :
    RelationshipLocalRenewalFaceCertificate where
  traceWitnessed := relationshipRenewalFace_event_mem_trace
  actorExact := relationshipRenewalFace_actor_exact
  relationStandingExact := relationshipRenewalFace_standing_exact
  exactConsumer := relationshipRenewalFace.responsibilityConsumer
  exactDisposition := relationshipRenewalFace.exactDisposition
  sourceSelectedControl := selectedMaintenanceControl .a
  reverseControlPermissionEmpty := reverseMaintenanceControl_empty .a
  sourceControlAsymmetry := sourceRenewalControlAsymmetry
  sourceSelectedDebtFlow := selectedMaintenanceDebtFlow .a
  reverseDebtFlowEmpty := reverseMaintenanceDebtFlow_empty .a
  exactDebtResponsibility :=
    (selectedMaintenanceDebtFlow .a).exactDebt.exactResponsibility
  exactDebtLiveResidual :=
    (selectedMaintenanceDebtFlow .a).exactDebt.maintenanceOpen
  sourceDebtAsymmetry := sourceDebtFlowAsymmetry
  sourceCombinedAsymmetry := sourceMaintenanceDebtAsymmetry
  controlAsymmetry := relationshipControlAsymmetry
  debtAsymmetry := relationshipDebtFlowAsymmetry
  combinedAsymmetry := relationshipRenewalDebtAsymmetry

end M8RelationshipMaintenanceRenewalRegression
end Society
end ProcessGame
end SaturationMonoid
