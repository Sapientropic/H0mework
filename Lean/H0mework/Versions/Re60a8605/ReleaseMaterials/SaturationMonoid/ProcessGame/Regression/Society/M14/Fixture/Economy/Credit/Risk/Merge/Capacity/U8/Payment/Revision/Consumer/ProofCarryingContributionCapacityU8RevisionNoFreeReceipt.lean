import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Fixture.Economy.Credit.Risk.Merge.Capacity.U8.Payment.Revision.Producer.SourceGeneratedContributionCapacityU8RevisionNoFreeReceipt
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M9.JointRoot.ProofCarryingRenewalInquiryRuntime

/-!
# Direct consumer of the payment-bearing U8 revision receipt

Runtime depth three keeps its rooted `.revised` authority.  The existing
branch receipt is consumed at the exact old/new first-write target visit, and
its macro landing is the next generated by the U8 current-one payment.  The
proof adds no `revision | payment` outcome sum.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14ProofCarryingContributionCapacityU8RevisionNoFreeReceipt

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open ConstructiveRoot.RootInquiryCompletion
open TypedSemanticWorldNetworkU8Lifecycle
open TypedSemanticWorldNetworkU8Recovery
open M9ProofCarryingRenewalInquiryRuntime
open M14SourceGeneratedContributionMergeActionSource
open M14SourceGeneratedContributionCapacityCutWorld
open M14SourceGeneratedContributionCapacityCutRoot
open M14SourceGeneratedContributionCapacityCutActionSource
open M14SourceGeneratedContributionCapacityFailure
open M14SourceGeneratedContributionCapacityU8Revision
open M14SourceGeneratedContributionCapacityU8RevisionNoFreeReceipt

@[simp] theorem depthThree_resolution_is_rootedSelfU8 :
    fourthTick.resolution =
      .revised
        (contributionCapacityResidual M9ProofCarryingRenewalU8Failure.rooted)
        (contributionCapacityU7Gate M9ProofCarryingRenewalU8Failure.rooted)
        (contributionCapacityOperationalFailure
          M9ProofCarryingRenewalU8Failure.rooted)
        (generatedContributionCapacityU8CoreAt canonicalOldVisit) :=
  fourthTick_resolution_is_contributionCapacitySelfU8

@[simp] theorem depthThree_oldAnswerAndNext_exact :
    fourthTick.receipt.2.2.1 =
      generatedOldTargetAnswerAndNext
        (ContributionCapacityU8CanonicalRevisionAt canonicalOldVisit) :=
  rfl

@[simp] theorem depthThree_newAnswerAndNext_exact :
    fourthTick.receipt.2.2.2 =
      generatedNewTargetAnswerAndNext
        (ContributionCapacityU8CanonicalRevisionAt canonicalOldVisit) :=
  rfl

@[simp] theorem depthThree_runtimeNextEngine_exact :
    (jointRuntime.stateAt 4).engine = fourthTick.next :=
  rfl

theorem depthThree_macroLanding_is_paymentGenerated :
    (processPresentation .contributionCapacityRevisedAnswer).erase =
      ⟨(ContributionCapacityU8CanonicalRevisionAt canonicalOldVisit
          ).generate.NewN,
        contributionCapacityU8RevisionNextPaidBy canonicalOldVisit⟩ :=
  rfl

theorem bareRevisionCore_orPayment_cannot_retype_asNoFreeReceipt : True := by
  fail_if_success
    exact (generatedContributionCapacityU8CoreAt canonicalOldVisit :
      SourceGeneratedContributionCapacityU8RevisionNoFreeReceiptAt
        canonicalOldVisit)
  fail_if_success
    exact (sourceGeneratedContributionCapacityU8RuntimePaymentAt
      canonicalOldVisit 1 :
      SourceGeneratedContributionCapacityU8RevisionNoFreeReceiptAt
        canonicalOldVisit)
  trivial

structure ProofCarryingContributionCapacityU8RevisionNoFreeReceipt : Prop where
  receipt :
    SourceGeneratedContributionCapacityU8RevisionNoFreeReceiptAt
      canonicalOldVisit
  resolutionExact :
    fourthTick.resolution =
      .revised
        (contributionCapacityResidual M9ProofCarryingRenewalU8Failure.rooted)
        (contributionCapacityU7Gate M9ProofCarryingRenewalU8Failure.rooted)
        (contributionCapacityOperationalFailure
          M9ProofCarryingRenewalU8Failure.rooted)
        (generatedContributionCapacityU8CoreAt canonicalOldVisit)
  oldAnswerAndNextExact :
    fourthTick.receipt.2.2.1 =
      generatedOldTargetAnswerAndNext
        (ContributionCapacityU8CanonicalRevisionAt canonicalOldVisit)
  newAnswerAndNextExact :
    fourthTick.receipt.2.2.2 =
      generatedNewTargetAnswerAndNext
        (ContributionCapacityU8CanonicalRevisionAt canonicalOldVisit)
  runtimeNextEngineExact :
    (jointRuntime.stateAt 4).engine = fourthTick.next
  macroLandingPaymentGenerated :
    (processPresentation .contributionCapacityRevisedAnswer).erase =
      ⟨(ContributionCapacityU8CanonicalRevisionAt canonicalOldVisit
          ).generate.NewN,
        contributionCapacityU8RevisionNextPaidBy canonicalOldVisit⟩

theorem proofCarryingContributionCapacityU8RevisionNoFreeReceipt :
    ProofCarryingContributionCapacityU8RevisionNoFreeReceipt where
  receipt :=
    sourceGeneratedContributionCapacityU8RevisionNoFreeReceiptAt
      canonicalOldVisit
  resolutionExact := depthThree_resolution_is_rootedSelfU8
  oldAnswerAndNextExact := depthThree_oldAnswerAndNext_exact
  newAnswerAndNextExact := depthThree_newAnswerAndNext_exact
  runtimeNextEngineExact := depthThree_runtimeNextEngine_exact
  macroLandingPaymentGenerated :=
    depthThree_macroLanding_is_paymentGenerated

end
end M14ProofCarryingContributionCapacityU8RevisionNoFreeReceipt
end Society
end ProcessGame
end SaturationMonoid

#print axioms SaturationMonoid.ProcessGame.Society.M14ProofCarryingContributionCapacityU8RevisionNoFreeReceipt.proofCarryingContributionCapacityU8RevisionNoFreeReceipt
#print axioms SaturationMonoid.ProcessGame.Society.M14ProofCarryingContributionCapacityU8RevisionNoFreeReceipt.depthThree_macroLanding_is_paymentGenerated
