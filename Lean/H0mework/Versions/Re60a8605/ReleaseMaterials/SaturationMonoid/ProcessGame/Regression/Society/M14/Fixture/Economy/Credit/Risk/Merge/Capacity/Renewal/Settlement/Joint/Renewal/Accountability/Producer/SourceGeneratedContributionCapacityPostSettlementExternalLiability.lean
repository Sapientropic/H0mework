/-!
# Post-settlement external-liability accountability

The post-settlement local ledger is empty, but every reachable root event
still generates an actual service whose payment authority lives at the exact
original joint-root visit.  This file joins those already generated objects
without adding a liability ledger, fiscal actor, currency carrier, receipt
registry, second occurrence, or completed future.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceGeneratedContributionCapacityPostSettlementExternalLiability

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Renewal Lifecycle Universal Relations Exchange Settlement Price Money UBI
open Capacity Space CrossingCost
open M3FiniteExchangeFixture M3ExchangeSettlementPriceRegression
open M14UBIExitCapacityFixture
open M14UBIProofCarryingRootRestriction
open M14UBIPeriodicRootHistory
open M14UBIPeriodicActualServiceCapacity
open M9ProofCarryingRenewalInquiryRoot
open M14SourceGeneratedContributionMergeActionSource
open M14SourceGeneratedContributionCapacityJointSettlementWorld
open M14SourceGeneratedContributionCapacityPostSettlementRenewalCompiler
open M14SourceGeneratedContributionCapacityPostSettlementRenewalRoot
open M14SourceGeneratedContributionCapacityJointSettlementConsumer

/-- The exact current already generated by the existing post-root visit fold. -/
def contributionCapacityPostSettlementReachableCurrentAt
    (oldVisit : OldVisit) (sourceIndex index : Nat) : Nat :=
  show Nat from
    (contributionCapacityPostSettlementRenewalVisitAt oldVisit sourceIndex
      index).current

@[simp] theorem contributionCapacityPostSettlementReachableCurrentAt_exact
    (oldVisit : OldVisit) (sourceIndex index : Nat) :
    contributionCapacityPostSettlementReachableCurrentAt oldVisit sourceIndex
        index =
      contributionCapacityPostSettlementRenewalInitialCurrentAt sourceIndex +
        index :=
  contributionCapacityPostSettlementRenewalVisit_current_exact oldVisit
    sourceIndex index

/-- Exact post-root temporal event.  Its occurrence field is the emitted
renewal event at the reachable current; no second event token is introduced. -/
def contributionCapacityPostSettlementExactRootEventAt
    (oldVisit : OldVisit) (sourceIndex index : Nat) :
    ExactTemporalCausalRootEventAt
      (ContributionCapacityPostSettlementRenewalRootAt oldVisit sourceIndex
        ).toAuthoritativeRoot.toLedgerRoot
      (contributionCapacityPostSettlementRenewalVisitAt oldVisit sourceIndex
        index) :=
  (ContributionCapacityPostSettlementRenewalRootAt oldVisit sourceIndex
    ).toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
      (contributionCapacityPostSettlementRenewalVisitAt oldVisit sourceIndex
        index)

abbrev ContributionCapacityPostSettlementPaymentSourceOwnership :=
  SourceOwnsResponsibilityIncidence V
    (P.boundarySource
      exitCapacityProgram.purchasingPowerStanding.activatedConsumer.activation)
    (exactOpenSettlement exactResidualActivation).obligation

abbrev ContributionCapacityPostSettlementPaymentRootConsumerForExitAt
    {oldVisit : OldVisit} {sourceIndex index : Nat}
    (actualExit : PeriodicActualServiceExitAt
      (contributionCapacityPostSettlementReachableCurrentAt oldVisit
        sourceIndex index)) :=
  RenewalResponsibilityConsumerAt
    actualExit.paymentOccurrence.installed.operationalAuthority

/-- Responsibility carried by an actual-exit witness generated inside the
exact post-root event.  Every dependent authority is projected from that
witness; the canonical periodic accessor is deliberately absent. -/
structure PostSettlementGeneratedExternalLiabilityAt
    (oldVisit : OldVisit) (sourceIndex index : Nat)
    (rootEvent : ExactTemporalCausalRootEventAt
      (ContributionCapacityPostSettlementRenewalRootAt oldVisit sourceIndex
        ).toAuthoritativeRoot.toLedgerRoot
      (contributionCapacityPostSettlementRenewalVisitAt oldVisit sourceIndex
        index))
    (actualExit : PeriodicActualServiceExitAt
      (contributionCapacityPostSettlementReachableCurrentAt oldVisit
        sourceIndex index)) : Prop where
  private mk ::
  paymentInstalledExact : actualExit.paymentOccurrence.installed =
    installedUBIAt
      (contributionCapacityPostSettlementReachableCurrentAt oldVisit
        sourceIndex index)
  paymentRootOccurrenceExact :
    actualExit.paymentOccurrence.rootOccurrence =
      jointRoot.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
        (temporalVisitAt
          (contributionCapacityPostSettlementReachableCurrentAt oldVisit
            sourceIndex index))
  paymentTrace :
    ∃ state ∈ Lifecycle.actualEventGame.occurrence.trace,
      residualConsumerCompiler.activationSeedAt
        Lifecycle.actualEventGame.source state
        (PurchasingPowerStandingAt.renewalEvent
          exitCapacityProgram.purchasingPowerStanding)
  paymentTraceExact : paymentTrace =
    actualExit.paymentOccurrence.paymentReceipt.eventTrace
  sourceOwnedResidual :
    Nonempty ContributionCapacityPostSettlementPaymentSourceOwnership
  rootConsumer : Nonempty
    (ContributionCapacityPostSettlementPaymentRootConsumerForExitAt actualExit)
  actualSettlement : Nonempty
    { settlement : ExactServedCrossingDebitedRunAt
        (anomiePhaseAt
          (contributionCapacityPostSettlementReachableCurrentAt oldVisit
            sourceIndex index))
        M10OccurrenceCapacityDebitedRunFixture.debited
        (serviceCompilerAt
          (contributionCapacityPostSettlementReachableCurrentAt oldVisit
            sourceIndex index)) //
      settlement = actualExit.actualSettlement }
  actionableRenewal : Nonempty
    { renewal :
        (geometryCompilerAt
          (contributionCapacityPostSettlementReachableCurrentAt oldVisit
            sourceIndex index)).SourceGeneratedActionableExitRenewalAt //
      renewal = actualExit.actionableRenewal }
  rootFactorization :
    actualExit.paymentOccurrence.installed.RootAnswerAndNextFactorizes
  crossRootOccurrenceDistinct :
    (Sum.inl rootEvent :
      ExactTemporalCausalRootEventAt
          (ContributionCapacityPostSettlementRenewalRootAt oldVisit sourceIndex
            ).toAuthoritativeRoot.toLedgerRoot
          (contributionCapacityPostSettlementRenewalVisitAt oldVisit
            sourceIndex index) ⊕
        ExactTemporalCausalRootEventAt
          jointRoot.toAuthoritativeRoot.toLedgerRoot
          (temporalVisitAt
            (contributionCapacityPostSettlementReachableCurrentAt oldVisit
              sourceIndex index))) ≠
      Sum.inr actualExit.paymentOccurrence.rootOccurrence

abbrev ContributionCapacityPostSettlementExternalPaymentAuthorityAt
    (oldVisit : OldVisit) (sourceIndex index : Nat)
    (rootEvent : ExactTemporalCausalRootEventAt
      (ContributionCapacityPostSettlementRenewalRootAt oldVisit sourceIndex
        ).toAuthoritativeRoot.toLedgerRoot
      (contributionCapacityPostSettlementRenewalVisitAt oldVisit sourceIndex
        index)) : Prop :=
  ∃ actualExit : PeriodicActualServiceExitAt
      (contributionCapacityPostSettlementReachableCurrentAt oldVisit
        sourceIndex index),
    PostSettlementGeneratedExternalLiabilityAt oldVisit sourceIndex index
      rootEvent actualExit

/-- Stable exact witness selected only from this event's generated
`Nonempty`.  It is not the old current-indexed canonical accessor. -/
def contributionCapacityPostSettlementActualExitOfRootEventAt
    (oldVisit : OldVisit) (sourceIndex index : Nat)
    (rootEvent : ExactTemporalCausalRootEventAt
      (ContributionCapacityPostSettlementRenewalRootAt oldVisit sourceIndex
        ).toAuthoritativeRoot.toLedgerRoot
      (contributionCapacityPostSettlementRenewalVisitAt oldVisit sourceIndex
        index)) :
    PeriodicActualServiceExitAt
      (contributionCapacityPostSettlementReachableCurrentAt oldVisit
        sourceIndex index) :=
  Classical.choice rootEvent.occurrence.2.periodicExitGenerated

/-- Complete liability of the exact event-selected witness. -/
theorem contributionCapacityPostSettlementGeneratedExternalLiabilityOfRootEventAt
    (oldVisit : OldVisit) (sourceIndex index : Nat)
    (rootEvent : ExactTemporalCausalRootEventAt
      (ContributionCapacityPostSettlementRenewalRootAt oldVisit sourceIndex
        ).toAuthoritativeRoot.toLedgerRoot
      (contributionCapacityPostSettlementRenewalVisitAt oldVisit sourceIndex
        index)) :
    PostSettlementGeneratedExternalLiabilityAt oldVisit sourceIndex index
      rootEvent
      (contributionCapacityPostSettlementActualExitOfRootEventAt oldVisit
        sourceIndex index rootEvent) := by
  let actualExit :=
    contributionCapacityPostSettlementActualExitOfRootEventAt oldVisit
      sourceIndex index rootEvent
  exact
    { paymentInstalledExact := actualExit.paymentInstalled_eq
      paymentRootOccurrenceExact :=
        actualExit.paymentOccurrence.rootOccurrence_eq
      paymentTrace := actualExit.paymentOccurrence.paymentReceipt.eventTrace
      paymentTraceExact := rfl
      sourceOwnedResidual :=
        ⟨exitCapacityProgram.purchasingPowerStanding.sourceOwnership⟩
      rootConsumer :=
        ⟨actualExit.paymentOccurrence.installed.rootResponsibilityConsumer⟩
      actualSettlement := ⟨⟨actualExit.actualSettlement, rfl⟩⟩
      actionableRenewal := ⟨⟨actualExit.actionableRenewal, rfl⟩⟩
      rootFactorization := actualExit.rootFactorization
      crossRootOccurrenceDistinct := by
        intro equality
        cases equality }

/-- One reachable post-root occurrence with its complete external payment
responsibility.  The actual exit is eliminated from the exact event's
`periodicExitGenerated`; a caller cannot submit a payment, bearer, consumer,
settlement, or canonical periodic readout. -/
structure PostSettlementExternalLiabilityAccountedAt
    (oldVisit : OldVisit) (sourceIndex index : Nat)
    (rootEvent : ExactTemporalCausalRootEventAt
      (ContributionCapacityPostSettlementRenewalRootAt oldVisit sourceIndex
        ).toAuthoritativeRoot.toLedgerRoot
      (contributionCapacityPostSettlementRenewalVisitAt oldVisit sourceIndex
        index)) : Prop where
  private mk ::
  currentExact :
    contributionCapacityPostSettlementReachableCurrentAt oldVisit sourceIndex
        index =
      contributionCapacityPostSettlementRenewalInitialCurrentAt sourceIndex +
        index
  rootEventExact : rootEvent =
    contributionCapacityPostSettlementExactRootEventAt oldVisit sourceIndex
      index
  localLedgerEmpty :
    IsEmpty (contributionCapacityJointSettlementEmptyLedger oldVisit).Entry
  occurrenceLocalLedgerEmpty :
    IsEmpty
      (OpenResponsibilityAt (JointSettlementNAt oldVisit)
        rootEvent.occurrence.1)
  generatedExternalPaymentAuthority :
    ContributionCapacityPostSettlementExternalPaymentAuthorityAt oldVisit
      sourceIndex index rootEvent

abbrev CanonicalPostSettlementExternalLiabilityAccountedAt
    (oldVisit : OldVisit) (sourceIndex index : Nat) :=
  PostSettlementExternalLiabilityAccountedAt oldVisit sourceIndex index
    (contributionCapacityPostSettlementExactRootEventAt oldVisit sourceIndex
      index)

/-- Sole pointwise producer.  Every field is projected from the exact
post-root event or from the payment occurrence carried by its actual exit. -/
theorem sourceGeneratedContributionCapacityPostSettlementExternalLiabilityAt
    (oldVisit : OldVisit) (sourceIndex index : Nat) :
    CanonicalPostSettlementExternalLiabilityAccountedAt oldVisit sourceIndex
      index where
  currentExact :=
    contributionCapacityPostSettlementReachableCurrentAt_exact oldVisit
      sourceIndex index
  rootEventExact := rfl
  localLedgerEmpty :=
    contributionCapacityJointSettlementEmptyLedger_isEmpty oldVisit
  occurrenceLocalLedgerEmpty := by
    rw [(contributionCapacityPostSettlementExactRootEventAt oldVisit
      sourceIndex index).occurrence.2.supportExact.down]
    exact contributionCapacityJointSettlementEmptyLedger_isEmpty oldVisit
  generatedExternalPaymentAuthority := by
    exact
      ⟨contributionCapacityPostSettlementActualExitOfRootEventAt oldVisit
          sourceIndex index
          (contributionCapacityPostSettlementExactRootEventAt oldVisit
            sourceIndex index),
        contributionCapacityPostSettlementGeneratedExternalLiabilityOfRootEventAt
          oldVisit sourceIndex index
          (contributionCapacityPostSettlementExactRootEventAt oldVisit
            sourceIndex index)⟩

/-- Local ledger emptiness cannot erase the event-generated existential
payment authority.  This is the direct counterexample to treating an empty
local debt fibre as an absence of external payment responsibility. -/
theorem contributionCapacityPostSettlementEmptyLedger_doesNotEraseExternalLiability
    (oldVisit : OldVisit) (sourceIndex index : Nat) :
    ¬ (IsEmpty
          (OpenResponsibilityAt (JointSettlementNAt oldVisit)
            (contributionCapacityPostSettlementExactRootEventAt oldVisit
              sourceIndex index).occurrence.1) →
        ¬ ContributionCapacityPostSettlementExternalPaymentAuthorityAt
          oldVisit sourceIndex index
          (contributionCapacityPostSettlementExactRootEventAt oldVisit
            sourceIndex index)) := by
  intro erases
  let accounted :=
    sourceGeneratedContributionCapacityPostSettlementExternalLiabilityAt
      oldVisit sourceIndex index
  exact erases accounted.occurrenceLocalLedgerEmpty
    accounted.generatedExternalPaymentAuthority

end
end M14SourceGeneratedContributionCapacityPostSettlementExternalLiability
