/-! ## Two independent bottleneck geometries -/

/-- Same uncaptured program and actual service, but no payment incidence is
available to the exit geometry. -/
def paymentIncidenceMissingGeometryAt (depth : Nat) :
    SourceOwnedExitGeometryCompilerAt exitCapacityProgram
      (anomiePhaseAt depth) (crossingCompilerAt depth)
        M10OccurrenceCapacityDebitedRunFixture.run (serviceCompilerAt depth)
          (actualSettlementAt depth) where
  PaysForAt := fun _standing _code => PEmpty
  RoutesAt := SourceGeneratedUBIRouteReceiptAt

/-- Same uncaptured program, payment, and actual service, but no generated
route incidence joins the exit to a served crossing. -/
def routeIncidenceMissingGeometryAt (depth : Nat) :
    SourceOwnedExitGeometryCompilerAt exitCapacityProgram
      (anomiePhaseAt depth) (crossingCompilerAt depth)
        M10OccurrenceCapacityDebitedRunFixture.run (serviceCompilerAt depth)
          (actualSettlementAt depth) where
  PaysForAt := SourceBackedUBIPaymentReceiptAt
  RoutesAt := fun _code _crossing => PEmpty

def firstServicedCrossingAt (depth : Nat) :
    (crossingCompilerAt depth).ExactCrossing :=
  ExactServedCrossingDebitedRunAt.servicedCrossingAt
    (phase := anomiePhaseAt depth)
    (crossingCompiler := crossingCompilerAt depth) (firstSlotAt depth)

theorem payment_incidence_missing_at (depth : Nat) (code) :
    IsEmpty ((paymentIncidenceMissingGeometryAt depth).PaysForAt
      exitCapacityProgram.purchasingPowerStanding code) := by
  change IsEmpty PEmpty
  infer_instance

theorem route_incidence_missing_at (depth : Nat) (code) (crossing) :
    IsEmpty ((routeIncidenceMissingGeometryAt depth).RoutesAt
      code crossing) := by
  change IsEmpty PEmpty
  infer_instance

theorem payment_missing_capacity_eq_zero_at (depth : Nat) :
    (paymentIncidenceMissingGeometryAt depth).actionableExitCapacity = 0 :=
  (paymentIncidenceMissingGeometryAt depth)
    |>.no_payment_receipts_no_exit_capacity
      (payment_incidence_missing_at depth)

theorem route_missing_capacity_eq_zero_at (depth : Nat) :
    (routeIncidenceMissingGeometryAt depth).actionableExitCapacity = 0 :=
  (routeIncidenceMissingGeometryAt depth)
    |>.no_route_receipts_no_exit_capacity
      (route_incidence_missing_at depth)

theorem captured_payment_and_route_present_at (depth : Nat) :
    Nonempty ((capturedGeometryCompilerAt depth).PaysForAt
        capturedProgram.purchasingPowerStanding ExitFutureCode.leave) ∧
      Nonempty ((capturedGeometryCompilerAt depth).RoutesAt
        ExitFutureCode.leave (firstServicedCrossingAt depth)) :=
  ⟨⟨SourceBackedUBIPaymentReceiptAt.generate⟩,
    ⟨SourceGeneratedUBIRouteReceiptAt.generate _⟩⟩

theorem payment_missing_route_present_at (depth : Nat) :
    Nonempty ((paymentIncidenceMissingGeometryAt depth).RoutesAt
      ExitFutureCode.leave (firstServicedCrossingAt depth)) :=
  ⟨SourceGeneratedUBIRouteReceiptAt.generate _⟩

theorem route_missing_payment_present_at (depth : Nat) :
    Nonempty ((routeIncidenceMissingGeometryAt depth).PaysForAt
      exitCapacityProgram.purchasingPowerStanding ExitFutureCode.leave) :=
  ⟨SourceBackedUBIPaymentReceiptAt.generate⟩

abbrev ActualServiceAt (depth : Nat) :=
  ExactServedCrossingDebitedRunAt (anomiePhaseAt depth)
    M10OccurrenceCapacityDebitedRunFixture.debited (serviceCompilerAt depth)

theorem actual_service_present_at (depth : Nat) :
    Nonempty (ActualServiceAt depth) :=
  ⟨actualSettlementAt depth⟩

/-! ## Three source-backed causal signatures -/

structure PriceCaptureSignatureAt (depth : Nat) : Prop where
  captured : fullCapture.Captures ExitFutureCode.leave
  captureDisposition : UBI.Capture.SourceAccountedCaptureDispositionAt
    capturedProgram ExitFutureCode.leave leave_is_captured
  exactTemporalPayment :
    (periodicSourceBackedPaymentAt depth).rootOccurrence =
      M9ProofCarryingRenewalInquiryRoot.jointRoot.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
        (temporalVisitAt depth)
  paymentPresent : Nonempty ((capturedGeometryCompilerAt depth).PaysForAt
    capturedProgram.purchasingPowerStanding ExitFutureCode.leave)
  routePresent : Nonempty ((capturedGeometryCompilerAt depth).RoutesAt
    ExitFutureCode.leave (firstServicedCrossingAt depth))
  servicePresent : Nonempty (ActualServiceAt depth)

structure PaymentIncidenceMissingSignatureAt (depth : Nat) : Prop where
  uncaptured : ¬ noCapture.Captures ExitFutureCode.leave
  exactTemporalPayment :
    (periodicSourceBackedPaymentAt depth).rootOccurrence =
      M9ProofCarryingRenewalInquiryRoot.jointRoot.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
        (temporalVisitAt depth)
  paymentMissing : IsEmpty ((paymentIncidenceMissingGeometryAt depth).PaysForAt
    exitCapacityProgram.purchasingPowerStanding ExitFutureCode.leave)
  routePresent : Nonempty ((paymentIncidenceMissingGeometryAt depth).RoutesAt
    ExitFutureCode.leave (firstServicedCrossingAt depth))
  servicePresent : Nonempty (ActualServiceAt depth)

structure RouteIncidenceMissingSignatureAt (depth : Nat) : Prop where
  uncaptured : ¬ noCapture.Captures ExitFutureCode.leave
  exactTemporalPayment :
    (periodicSourceBackedPaymentAt depth).rootOccurrence =
      M9ProofCarryingRenewalInquiryRoot.jointRoot.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
        (temporalVisitAt depth)
  paymentPresent : Nonempty ((routeIncidenceMissingGeometryAt depth).PaysForAt
    exitCapacityProgram.purchasingPowerStanding ExitFutureCode.leave)
  routeMissing : IsEmpty ((routeIncidenceMissingGeometryAt depth).RoutesAt
    ExitFutureCode.leave (firstServicedCrossingAt depth))
  servicePresent : Nonempty (ActualServiceAt depth)

theorem priceCaptureSignatureAt (depth : Nat) :
    PriceCaptureSignatureAt depth where
  captured := leave_is_captured
  captureDisposition := fixedCaptureDisposition
  exactTemporalPayment :=
    (periodicSourceBackedPaymentAt depth).rootOccurrence_eq
  paymentPresent := (captured_payment_and_route_present_at depth).1
  routePresent := (captured_payment_and_route_present_at depth).2
  servicePresent := actual_service_present_at depth

theorem paymentIncidenceMissingSignatureAt (depth : Nat) :
    PaymentIncidenceMissingSignatureAt depth where
  uncaptured := uncaptured_leave_has_no_capture_verdict
  exactTemporalPayment :=
    (periodicSourceBackedPaymentAt depth).rootOccurrence_eq
  paymentMissing := payment_incidence_missing_at depth ExitFutureCode.leave
  routePresent := payment_missing_route_present_at depth
  servicePresent := actual_service_present_at depth

theorem routeIncidenceMissingSignatureAt (depth : Nat) :
    RouteIncidenceMissingSignatureAt depth where
  uncaptured := uncaptured_leave_has_no_capture_verdict
  exactTemporalPayment :=
    (periodicSourceBackedPaymentAt depth).rootOccurrence_eq
  paymentPresent := route_missing_payment_present_at depth
  routeMissing := route_incidence_missing_at depth ExitFutureCode.leave
    (firstServicedCrossingAt depth)
  servicePresent := actual_service_present_at depth

/-- Downstream diagnostic carrier.  Each constructor requires its exact
source signature; it is not stored in the root and accepts no capacity
result as a premise. -/
inductive ZeroCapacityCausalOriginAt (depth : Nat) : Type 17 where
  | priceCapture (signature : PriceCaptureSignatureAt depth)
  | paymentIncidenceMissing
      (signature : PaymentIncidenceMissingSignatureAt depth)
  | routeIncidenceMissing
      (signature : RouteIncidenceMissingSignatureAt depth)

def priceCaptureOriginAt (depth : Nat) : ZeroCapacityCausalOriginAt depth :=
  .priceCapture (priceCaptureSignatureAt depth)

def paymentIncidenceMissingOriginAt (depth : Nat) :
    ZeroCapacityCausalOriginAt depth :=
  .paymentIncidenceMissing (paymentIncidenceMissingSignatureAt depth)

def routeIncidenceMissingOriginAt (depth : Nat) :
    ZeroCapacityCausalOriginAt depth :=
  .routeIncidenceMissing (routeIncidenceMissingSignatureAt depth)

/-- The visible matching/capacity observer. -/
noncomputable def capacityReadoutAt (depth : Nat) :
    ZeroCapacityCausalOriginAt depth → Nat
  | .priceCapture _ =>
      (capturedGeometryCompilerAt depth).actionableExitCapacity
  | .paymentIncidenceMissing _ =>
      (paymentIncidenceMissingGeometryAt depth).actionableExitCapacity
  | .routeIncidenceMissing _ =>
      (routeIncidenceMissingGeometryAt depth).actionableExitCapacity

theorem capacityReadout_eq_zero_at (depth : Nat)
    (origin : ZeroCapacityCausalOriginAt depth) :
    capacityReadoutAt depth origin = 0 := by
  cases origin with
  | priceCapture _ => exact captured_nominal_capacity_eq_zero_at depth
  | paymentIncidenceMissing _ =>
      exact payment_missing_capacity_eq_zero_at depth
  | routeIncidenceMissing _ =>
      exact route_missing_capacity_eq_zero_at depth

theorem three_causal_origins_are_pairwise_distinct (depth : Nat) :
    priceCaptureOriginAt depth ≠ paymentIncidenceMissingOriginAt depth ∧
      priceCaptureOriginAt depth ≠ routeIncidenceMissingOriginAt depth ∧
      paymentIncidenceMissingOriginAt depth ≠
        routeIncidenceMissingOriginAt depth := by
  constructor
  · intro equality
    cases equality
  constructor
  · intro equality
    cases equality
  · intro equality
    cases equality

/-- Strong fibre theorem: the visible zero-capacity value has at least three
constructively distinct exact causal origins. -/
theorem zero_capacity_fiber_has_three_distinct_origins (depth : Nat) :
    capacityReadoutAt depth (priceCaptureOriginAt depth) = 0 ∧
      capacityReadoutAt depth (paymentIncidenceMissingOriginAt depth) = 0 ∧
      capacityReadoutAt depth (routeIncidenceMissingOriginAt depth) = 0 ∧
      priceCaptureOriginAt depth ≠ paymentIncidenceMissingOriginAt depth ∧
      priceCaptureOriginAt depth ≠ routeIncidenceMissingOriginAt depth ∧
      paymentIncidenceMissingOriginAt depth ≠
        routeIncidenceMissingOriginAt depth :=
  ⟨capacityReadout_eq_zero_at depth _,
    capacityReadout_eq_zero_at depth _,
    capacityReadout_eq_zero_at depth _,
    three_causal_origins_are_pairwise_distinct depth⟩

theorem capacityReadout_not_injective_at (depth : Nat) :
    ¬ Function.Injective (capacityReadoutAt depth) := by
  intro injective
  have equalReadout :
      capacityReadoutAt depth (priceCaptureOriginAt depth) =
        capacityReadoutAt depth (paymentIncidenceMissingOriginAt depth) := by
    rw [capacityReadout_eq_zero_at, capacityReadout_eq_zero_at]
  exact (three_causal_origins_are_pairwise_distinct depth).1
    (injective equalReadout)

/-- No observer which sees only the natural-number capacity can recover the
exact causal origin on this three-point source fibre. -/
theorem no_capacity_only_causal_reconstruction_at (depth : Nat) :
    ¬ ∃ reconstruct : Nat → ZeroCapacityCausalOriginAt depth,
      Function.LeftInverse reconstruct (capacityReadoutAt depth) := by
  rintro ⟨reconstruct, leftInverse⟩
  have equalReadout :
      capacityReadoutAt depth (priceCaptureOriginAt depth) =
        capacityReadoutAt depth (paymentIncidenceMissingOriginAt depth) := by
    rw [capacityReadout_eq_zero_at, capacityReadout_eq_zero_at]
  have originsEqual :
      priceCaptureOriginAt depth = paymentIncidenceMissingOriginAt depth := by
    calc
      priceCaptureOriginAt depth =
          reconstruct (capacityReadoutAt depth (priceCaptureOriginAt depth)) :=
        (leftInverse (priceCaptureOriginAt depth)).symm
      _ = reconstruct
          (capacityReadoutAt depth (paymentIncidenceMissingOriginAt depth)) :=
        congrArg reconstruct equalReadout
      _ = paymentIncidenceMissingOriginAt depth :=
        leftInverse (paymentIncidenceMissingOriginAt depth)
  exact (three_causal_origins_are_pairwise_distinct depth).1 originsEqual

theorem all_three_interventions_share_program_axes :
    capturedProgram.payment = exitCapacityProgram.payment ∧
      capturedProgram.purchasingPowerStanding =
        exitCapacityProgram.purchasingPowerStanding ∧
      capturedProgram.employmentLoss = exitCapacityProgram.employmentLoss ∧
      capturedProgram.exitInterest = exitCapacityProgram.exitInterest :=
  ⟨captured_counterfactual_same_payment,
    captured_counterfactual_same_purchasingPowerStanding,
    captured_counterfactual_same_employmentLoss,
    captured_counterfactual_same_exitInterest⟩

structure ZeroCapacityCausalNonidentifiabilityCertificate : Prop where
  sharedProgramAxes :
    capturedProgram.payment = exitCapacityProgram.payment ∧
      capturedProgram.purchasingPowerStanding =
        exitCapacityProgram.purchasingPowerStanding ∧
      capturedProgram.employmentLoss = exitCapacityProgram.employmentLoss ∧
      capturedProgram.exitInterest = exitCapacityProgram.exitInterest
  everyDepthThreePointFibre : ∀ depth : Nat,
    capacityReadoutAt depth (priceCaptureOriginAt depth) = 0 ∧
      capacityReadoutAt depth (paymentIncidenceMissingOriginAt depth) = 0 ∧
      capacityReadoutAt depth (routeIncidenceMissingOriginAt depth) = 0 ∧
      priceCaptureOriginAt depth ≠ paymentIncidenceMissingOriginAt depth ∧
      priceCaptureOriginAt depth ≠ routeIncidenceMissingOriginAt depth ∧
      paymentIncidenceMissingOriginAt depth ≠
        routeIncidenceMissingOriginAt depth
  everyDepthReadoutNoninjective : ∀ depth : Nat,
    ¬ Function.Injective (capacityReadoutAt depth)
  everyDepthNoCausalReconstruction : ∀ depth : Nat,
    ¬ ∃ reconstruct : Nat → ZeroCapacityCausalOriginAt depth,
      Function.LeftInverse reconstruct (capacityReadoutAt depth)
  captureResponsibilityRetained : ∀ depth : Nat,
    PeriodicCaptureResponsibilityAt depth
      (periodicSourceBackedPaymentAt depth)
  captureHasPaymentAndRoute : ∀ depth : Nat,
    Nonempty ((capturedGeometryCompilerAt depth).PaysForAt
        capturedProgram.purchasingPowerStanding ExitFutureCode.leave) ∧
      Nonempty ((capturedGeometryCompilerAt depth).RoutesAt
        ExitFutureCode.leave (firstServicedCrossingAt depth))
  paymentMissingButRoutePresent : ∀ depth : Nat,
    IsEmpty ((paymentIncidenceMissingGeometryAt depth).PaysForAt
        exitCapacityProgram.purchasingPowerStanding ExitFutureCode.leave) ∧
      Nonempty ((paymentIncidenceMissingGeometryAt depth).RoutesAt
        ExitFutureCode.leave (firstServicedCrossingAt depth))
  routeMissingButPaymentPresent : ∀ depth : Nat,
    IsEmpty ((routeIncidenceMissingGeometryAt depth).RoutesAt
        ExitFutureCode.leave (firstServicedCrossingAt depth)) ∧
      Nonempty ((routeIncidenceMissingGeometryAt depth).PaysForAt
        exitCapacityProgram.purchasingPowerStanding ExitFutureCode.leave)

theorem zeroCapacityCausalNonidentifiabilityDirectConsumer :
    ZeroCapacityCausalNonidentifiabilityCertificate where
  sharedProgramAxes := all_three_interventions_share_program_axes
  everyDepthThreePointFibre := zero_capacity_fiber_has_three_distinct_origins
  everyDepthReadoutNoninjective := capacityReadout_not_injective_at
  everyDepthNoCausalReconstruction :=
    no_capacity_only_causal_reconstruction_at
  captureResponsibilityRetained := periodicCaptureResponsibilityAt
  captureHasPaymentAndRoute := captured_payment_and_route_present_at
  paymentMissingButRoutePresent := fun depth =>
    ⟨payment_incidence_missing_at depth ExitFutureCode.leave,
      payment_missing_route_present_at depth⟩
  routeMissingButPaymentPresent := fun depth =>
    ⟨route_incidence_missing_at depth ExitFutureCode.leave
        (firstServicedCrossingAt depth),
      route_missing_payment_present_at depth⟩

end
