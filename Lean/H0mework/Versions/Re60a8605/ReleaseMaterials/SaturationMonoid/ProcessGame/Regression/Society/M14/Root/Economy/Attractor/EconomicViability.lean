import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Root.Economy.Attractor.PeriodicNormalizedViableDisposition

/-!
# M14 source-generated economic viability

Maintenance failure, capture failure, and a repaired target must be evaluated
by one predicate before a hitting time can be meaningful.  `EconomicViabilityAt`
is that dependent face.  Its state axes are only the existing portfolio source
and capture compiler; its occurrence, image, and landing are witnessed by the
existing portfolio-viable receipt.

There is no viability tag, Bool classifier, state registry, rank, path table,
new root, ledger, fold, or completed history.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14EconomicViability

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Renewal UBI Capacity Space CrossingCost
open M14UBIExitCapacityFixture
open M14UBIPeriodicRootHistory
open M14UBIPeriodicActualServiceCapacity
open M14ActionableFuturePortfolio
open M14EconomicSingleFold
open M14GeneratedEconomicDisposition
open M14PortfolioCaptureDeath
open M14CaptureResponsibilityDispositionRegression
open M14PeriodicDeathRepairNormalization
open M14PeriodicNormalizedViableDisposition

/-- One viability predicate for every existing portfolio-source/capture pair.
The viable economic occurrence is a witness generated by the existing viable
receipt, not a caller-supplied state tag. -/
structure EconomicViabilityAt
    (visitDepth : Nat)
    (source : EssentialPortfolioSourceAt visitDepth)
    (capture : CaptureCompiler) : Type 18 where
  private mk ::
  portfolio : CompletePortfolioAt visitDepth source
  uncaptured : ¬ capture.Captures ExitFutureCode.leave
  occurrence : RootedAccountedUnfolding ExactEconomicAtom
  image : EconomicFoldImage
  landing : EconomicLanding
  viable : SourceGeneratedPortfolioViableEconomicDispositionAt
    occurrence image landing
  viableVisitExact : viable.depth + 1 = visitDepth
  samePortfolio : HEq portfolio viable.portfolio

namespace EconomicViabilityAt

/-- Viability lands directly in the existing four-way disposition's viable
summand.  No duplicate disposition field is stored. -/
def toDisposition
    {visitDepth : Nat}
    {source : EssentialPortfolioSourceAt visitDepth}
    {capture : CaptureCompiler}
    (viability : EconomicViabilityAt visitDepth source capture) :
    EconomicDispositionAt viability.occurrence viability.image
      viability.landing :=
  .inl viability.viable.viable

end EconomicViabilityAt

/-! ## Source failures under the same predicate -/

instance maintenanceEconomicViability_isEmpty (depth : Nat) :
    IsEmpty (EconomicViabilityAt depth
      (stablePortfolioSourceAt depth) noCapture) :=
  ⟨fun viability =>
    (stableSource_completePortfolio_isEmpty depth).false
      viability.portfolio⟩

instance captureEconomicViability_isEmpty (depth : Nat) :
    IsEmpty (EconomicViabilityAt depth
      (fullPortfolioSourceAt depth) fullCapture) :=
  ⟨fun viability => viability.uncaptured leave_is_captured⟩

theorem maintenance_viability_is_empty (depth : Nat) :
    IsEmpty (EconomicViabilityAt depth
      (stablePortfolioSourceAt depth) noCapture) :=
  maintenanceEconomicViability_isEmpty depth

theorem capture_viability_is_empty (depth : Nat) :
    IsEmpty (EconomicViabilityAt depth
      (fullPortfolioSourceAt depth) fullCapture) :=
  captureEconomicViability_isEmpty depth

/-! ## Periodic repaired target -/

/-- Sole positive viability producer.  Every witness is read from the actual
periodic normalized viable entry at `depth`; callers provide only `depth`. -/
def sourceGeneratedPeriodicEconomicViabilityAt (depth : Nat) :
    EconomicViabilityAt (depth + 1)
      (fullPortfolioSourceAt (depth + 1)) noCapture := by
  let entry := sourceGeneratedPeriodicNormalizedViableDispositionAt depth
  exact
    { portfolio := entry.normalization.normalForm.targetPortfolio
      uncaptured := entry.targetUncaptured
      occurrence := postRepairViableExposureAt depth
      image := postRepairViableImageAt depth
      landing := ordinaryEconomicLandingAt depth
      viable := entry.viable
      viableVisitExact :=
        congrArg (fun currentDepth => currentDepth + 1)
          entry.viableDepthExact
      samePortfolio := entry.targetPortfolioExact }

theorem every_generated_period_has_economic_viability (depth : Nat) :
    Nonempty (EconomicViabilityAt (depth + 1)
      (fullPortfolioSourceAt (depth + 1)) noCapture) :=
  ⟨sourceGeneratedPeriodicEconomicViabilityAt depth⟩

/-! ## Exact counterfactuals -/

instance targetStableEconomicViability_isEmpty (depth : Nat) :
    IsEmpty (EconomicViabilityAt (depth + 1)
      (stablePortfolioSourceAt (depth + 1)) noCapture) :=
  maintenanceEconomicViability_isEmpty (depth + 1)

instance targetCapturedEconomicViability_isEmpty (depth : Nat) :
    IsEmpty (EconomicViabilityAt (depth + 1)
      (fullPortfolioSourceAt (depth + 1)) fullCapture) :=
  captureEconomicViability_isEmpty (depth + 1)

/-- Positive scalar capacity does not construct the unified viability face:
the maintenance source already has capacity one while its viability type is
empty. -/
theorem positive_capacity_does_not_generate_viability (depth : Nat) :
    (stableGeometryCompilerAt depth).actionableExitCapacity = 1 ∧
      IsEmpty (EconomicViabilityAt depth
        (stablePortfolioSourceAt depth) noCapture) :=
  ⟨stablePortfolioCapacity_eq_one depth,
    maintenanceEconomicViability_isEmpty depth⟩

theorem economic_viability_mouth_has_no_rank_or_completed_history
    (depth : Nat) : True := by
  let viability := sourceGeneratedPeriodicEconomicViabilityAt depth
  fail_if_success exact viability.rank
  fail_if_success exact viability.steps
  fail_if_success exact viability.decreases
  fail_if_success exact viability.coverage
  fail_if_success exact viability.completedHistory
  fail_if_success exact viability.u8Gate
  trivial

end
end M14EconomicViability
end Society
end ProcessGame
end SaturationMonoid

