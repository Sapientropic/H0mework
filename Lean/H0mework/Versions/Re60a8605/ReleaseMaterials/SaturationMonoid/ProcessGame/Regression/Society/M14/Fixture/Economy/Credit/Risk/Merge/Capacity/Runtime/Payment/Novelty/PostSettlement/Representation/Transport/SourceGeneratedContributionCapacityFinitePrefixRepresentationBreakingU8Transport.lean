open M14SourceGeneratedContributionCapacityFinitePrefixRepresentationBreaking.SourceGeneratedFinitePrefixRepresentationBreakingAt
open M14SourceGeneratedPostSettlementObserverSubmissionU8
open M14SourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislation
open M14SourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislation.SourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislationAt
open M14ProofCarryingPostSettlementObserverSubmissionExternalPaymentLegislation
open M14ProofCarryingContributionCapacityCofinalNoveltySelfU8
open M14SourceGeneratedContributionCapacityCofinalNoveltyU8Runtime

/-- Private restriction of the existing cross-occurrence U8 span by the exact
P-side representation breaking. -/
inductive SourceGeneratedFinitePrefixRepresentationBreakingU8TransportAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (breaking :
      CanonicalFinitePrefixRepresentationBreakingAt oldVisit sourceIndex
        boundary) : Type 32
  | private transported

def sourceGeneratedFinitePrefixRepresentationBreakingU8TransportAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (breaking :
      CanonicalFinitePrefixRepresentationBreakingAt oldVisit sourceIndex
        boundary) :
    SourceGeneratedFinitePrefixRepresentationBreakingU8TransportAt breaking :=
  .transported

namespace SourceGeneratedFinitePrefixRepresentationBreakingU8TransportAt

variable {oldVisit : OldVisit} {sourceIndex boundary : Nat}
  {breaking :
    CanonicalFinitePrefixRepresentationBreakingAt oldVisit sourceIndex
      boundary}
  (transport :
    SourceGeneratedFinitePrefixRepresentationBreakingU8TransportAt breaking)

def externalSpan :
    SourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislationAt
      oldVisit sourceIndex boundary := by
  cases transport
  exact
    sourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislationAt
      oldVisit sourceIndex boundary

include transport in
theorem externalSpanConsumer :
    ProofCarryingPostSettlementObserverSubmissionExternalPaymentLegislationAt
      (externalSpan transport) := by
  cases transport
  exact
    proofCarryingPostSettlementObserverSubmissionExternalPaymentLegislation
      (sourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislationAt
        oldVisit sourceIndex boundary)

/-- The local no-extension fibre and the target old-language expression fibre
are both empty for this exact breaking.  The presentation is proof-only and
stores neither fibre. -/
def expressionFailurePresentation
    (_receipt :
      SourceGeneratedFinitePrefixRepresentationBreakingU8TransportAt
        breaking) :
    ConstructivePresentation
      (AnyFinitePrefixCompleteRepresentationAt oldVisit sourceIndex boundary)
      (RootInquiryU8CompletionRegression.oldTheory.ExpressesAt true
        (M9ProofCarryingRenewalInquiryRoot.N.obstructionClaim
          RootInquiryU8CompletionRegression.obstruction)) where
  forward := fun sourceExtension =>
    False.elim
      (breaking.completeRepresentationIsEmpty.false sourceExtension)
  backward := fun target => nomatch target.1
  backward_forward := fun sourceExtension =>
    False.elim
      (breaking.completeRepresentationIsEmpty.false sourceExtension)
  forward_backward := fun target => nomatch target.1

/-- The same source-generated no-extension also presents the empty complete
law-realization fibre of the exact M9 failure. -/
def realizationFailurePresentation
    (_receipt :
      SourceGeneratedFinitePrefixRepresentationBreakingU8TransportAt
        breaking) :
    ConstructivePresentation
      (AnyFinitePrefixCompleteRepresentationAt oldVisit sourceIndex boundary)
      (RootInquiryU8CompletionRegression.oldTheory.inventory.RealizationAt
        RootInquiryU8CompletionRegression.obstruction) where
  forward := fun sourceExtension =>
    False.elim
      (breaking.completeRepresentationIsEmpty.false sourceExtension)
  backward := fun target => nomatch target
  backward_forward := fun sourceExtension =>
    False.elim
      (breaking.completeRepresentationIsEmpty.false sourceExtension)
  forward_backward := fun target => nomatch target

/-- The target demand is Q's already installed U7 demand.  The local
presentations restrict the exact P-side breaking to this target occurrence;
they do not regenerate Q's independently empty `PEmpty` fibres. -/
def existingRevisionDemand
    (_receipt :
      SourceGeneratedFinitePrefixRepresentationBreakingU8TransportAt
        breaking) :
    TheoryRevisionDemandAt M9ProofCarryingRenewalU8Failure.U7
      RootInquiryU8CompletionRegression.failure :=
  theoryRevisionDemandOfFailure M9ProofCarryingRenewalU8Failure.U7
    RootInquiryU8CompletionRegression.failure

/-- Exact failure authority already installed at the Q Payment occurrence. -/
def existingFailureFace
    (_receipt :
      SourceGeneratedFinitePrefixRepresentationBreakingU8TransportAt
        breaking) :
    SourceNativeRootExpressibilityFailureFaceAt
      jointRoot.toAuthoritativeRoot
      (.finite (oldRootVisitAt oldVisit sourceIndex boundary))
      (U7 := M9ProofCarryingRenewalU8Failure.U7)
      RootInquiryU8CompletionRegression.failure :=
  failureFaceAt (oldRootVisitAt oldVisit sourceIndex boundary)

def existingRootedFailure
    (_receipt :
      SourceGeneratedFinitePrefixRepresentationBreakingU8TransportAt
        breaking) :
    RootedActualExpressibilityFailureAt
      jointRoot.toAuthoritativeRoot
      (.finite (oldRootVisitAt oldVisit sourceIndex boundary))
      M9ProofCarryingRenewalU8Failure.U7
      RootInquiryU8CompletionRegression.failure :=
  rootedAt (oldRootVisitAt oldVisit sourceIndex boundary)

def existingMinimalCoface
    (receipt :
      SourceGeneratedFinitePrefixRepresentationBreakingU8TransportAt
        breaking) :
    GeneratedMinimalCofaceAt (existingRootedFailure receipt) :=
  cofaceAt (oldRootVisitAt oldVisit sourceIndex boundary)

theorem rightPEvent_isExistingSpanSource :
    (canonicalIncidenceAt oldVisit sourceIndex boundary).rightReplay.2.rootEvent =
      (externalSpan transport).sourceSubmission.exactEvent := by
  cases transport
  rfl

theorem pAndQOccurrencesDistinct :
    Sum.inl (externalSpan transport).sourceSubmission.exactEvent ≠
      Sum.inr (externalSpan transport).targetPaymentOccurrence.rootOccurrence :=
  (externalSpan transport).sourceTargetOccurrencesDistinct

include transport in
theorem qPaymentAndEntryExact :
    type_of% breaking.exactQOccurrenceAndEntry := by
  cases transport
  exact breaking.exactQOccurrenceAndEntry

def rootedFailure := rootedFailureAt oldVisit sourceIndex boundary

def minimalCoface := canonicalCofaceAt oldVisit sourceIndex boundary

def execution := (externalSpan transport).targetExecution

def selfU8 := (externalSpan transport).targetSelfU8

theorem selfU8_failure_isExistingFailure :
    (selfU8 transport).failure =
      RootInquiryU8CompletionRegression.failure := by
  cases transport
  rfl

theorem selfU8_rooted_isExistingPaidRooted :
    (selfU8 transport).rooted = rootedFailureAt oldVisit sourceIndex boundary :=
  selfU8_rooted_isPaidVisitRooted (execution transport)

theorem selfU8_coface_isExistingPaidCoface :
    (selfU8 transport).minimalCoface =
      canonicalCofaceAt oldVisit sourceIndex boundary :=
  selfU8_coface_isPaidVisitCoface (execution transport)

theorem selfU8_runtimeConsumesExistingCore :
    SourceNativeInquiryRuntime.CofaceRealizationResumptionAt
      (execution transport).core
      (M14SourceGeneratedContributionCapacityCofinalNoveltyU8Runtime.runtime
        (execution transport)) 0 :=
  selfU8_runtimeConsumesExactCore (execution transport)

theorem selfU8_firstWrite_isExistingCompilerWrite :
    (selfU8 transport).firstWrite =
      (externalSpan transport).targetRevisionBridge.rightFirstWrite :=
  selfU8_firstWrite_isCompilerGenerated (execution transport)

theorem selfU8_revisedRowsShareOneNext :
    (selfU8 transport).oldRowAnswerAndNext.nextCurrent =
      (selfU8 transport).newRowAnswerAndNext.nextCurrent :=
  selfU8_revisedRows_shareGeneratedNext (execution transport)

include transport in
theorem ordinaryPNextPreserved :
    type_of% breaking.ordinaryRightPaymentGeneratesCanonicalNext := by
  cases transport
  exact breaking.ordinaryRightPaymentGeneratesCanonicalNext

include transport in
theorem everyChannelStillReturns
    (channel :
      M14SourceGeneratedContributionCapacityEssentialAccessChannel.EssentialAccessChannel) :
    type_of% (breaking.independentConsumerReturnsEveryChannel channel) := by
  cases transport
  exact breaking.independentConsumerReturnsEveryChannel channel

include transport in
theorem sourceOwnershipAndRootConsumerPreserved :
    type_of% breaking.independentConsumerOwnsAndConsumes := by
  cases transport
  exact breaking.independentConsumerOwnsAndConsumes

end SourceGeneratedFinitePrefixRepresentationBreakingU8TransportAt

theorem finitePrefixRepresentationBreakingU8Transport_cofinal
    (oldVisit : OldVisit) (sourceIndex : Nat) :
    ∀ boundary : Nat,
      Nonempty
        (SourceGeneratedFinitePrefixRepresentationBreakingU8TransportAt
          (sourceGeneratedFinitePrefixRepresentationBreakingAt oldVisit
            sourceIndex boundary)) :=
  fun boundary =>
    ⟨sourceGeneratedFinitePrefixRepresentationBreakingU8TransportAt
      (sourceGeneratedFinitePrefixRepresentationBreakingAt oldVisit sourceIndex
        boundary)⟩

set_option linter.unusedVariables false in
theorem transportExposesNoActionTargetOrThirdNext
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) : True := by
  let breaking :=
    sourceGeneratedFinitePrefixRepresentationBreakingAt oldVisit sourceIndex
      boundary
  let transport :=
    sourceGeneratedFinitePrefixRepresentationBreakingU8TransportAt breaking
  fail_if_success exact transport.actionProgram
  fail_if_success exact transport.actionTarget
  fail_if_success exact transport.thirdNext
  fail_if_success exact transport.future
  fail_if_success exact transport.registry
  trivial

end
end M14SourceGeneratedContributionCapacityFinitePrefixRepresentationBreakingU8Transport
