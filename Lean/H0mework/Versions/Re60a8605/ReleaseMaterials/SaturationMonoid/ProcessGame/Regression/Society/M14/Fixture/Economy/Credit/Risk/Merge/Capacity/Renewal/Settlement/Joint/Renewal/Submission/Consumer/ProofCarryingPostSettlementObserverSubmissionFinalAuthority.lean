      ).newOnlyEntryRow.sourceRow
  temporalRowExact : HEq
    (activatedSubmissionAt oldVisit sourceIndex boundary).temporalSelectedRow
    (generatedTypedRevisionAt oldVisit sourceIndex boundary).newOnlyEntryRow
  successorExact : HEq
    (activatedSubmissionAt oldVisit sourceIndex boundary).payload.successor
