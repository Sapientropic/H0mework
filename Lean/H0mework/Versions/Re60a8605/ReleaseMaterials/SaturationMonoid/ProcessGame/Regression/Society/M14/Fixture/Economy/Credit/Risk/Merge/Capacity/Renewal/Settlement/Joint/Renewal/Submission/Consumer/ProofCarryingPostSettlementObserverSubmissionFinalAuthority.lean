theorem proofCarryingPostSettlementObserverSubmissionFinalAuthority
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    ProofCarryingPostSettlementObserverSubmissionFinalAuthorityAt
      oldVisit sourceIndex boundary where
  universalExhaustion :=
    proofCarryingUniversalObserverConsumerExhaustionDirectConsumer
  rightPaymentOccurrenceExact :=
    exactProblemOccurrence_isRightPaymentOccurrence oldVisit sourceIndex
      boundary
  rightPaymentInstallationExact :=
    (rootedBridgeAt oldVisit sourceIndex boundary).rightPaymentInstalled_exact
  canonicalSubmissionCurrentExact :=
    canonicalSubmissionCurrent_eq_rightReplayCurrent oldVisit sourceIndex
      boundary
  canonicalSubmissionExactEvent :=
    canonicalSubmission_exactEvent_eq_rightReplayPostRootEvent oldVisit
      sourceIndex boundary
  canonicalSubmissionSourceOccurrence :=
    canonicalSubmission_sourceOccurrence_eq_rightReplayPostRootOccurrence
      oldVisit sourceIndex boundary
  installedPayloadCertificate :=
    augmentedInstalledPayload_carriesCanonicalCertificate oldVisit sourceIndex
      boundary
  installedPayloadRootedAuthority :=
    augmentedInstalledPayload_carriesRootedAuthority oldVisit sourceIndex
      boundary
  canonicalSubmissionRooted :=
    canonicalSubmission_isRooted oldVisit sourceIndex boundary
  sourceCompilerOutputExact :=
    sourceGeneratedOutput_exact oldVisit sourceIndex boundary
  eventProjectionExact :=
    actualFirstEvent_projectionOutcome_heq_sourceLaw oldVisit sourceIndex
      boundary
  sourceEntryExact :=
    submissionFace_sourceEntry_eq_newOnlyEntry oldVisit sourceIndex boundary
  selectedSourceRowExact :=
    submissionFace_selectedRow_heq_generatedNewOnlyRow oldVisit sourceIndex
      boundary
  temporalRowExact := HEq.rfl
  successorExact :=
    submissionFace_successor_heq_generatedSuccessor oldVisit sourceIndex
      boundary
  rootConsumer :=
    ⟨(activatedSubmissionAt oldVisit sourceIndex boundary
      ).rootResponsibilityConsumer⟩
  submissionRootMicroFactorization :=
    (activatedSubmissionAt oldVisit sourceIndex boundary
      ).rootAnswerAndNext_factorizes
  attachedFirstWrite :=
    ⟨(generatedTypedRevisionAt oldVisit sourceIndex boundary
      ).attachedCofaceRealization⟩
  runtimeResumption :=
    runtimeConsumesExactCore oldVisit sourceIndex boundary
  runtimeInstallation :=
    cofaceRealizationInstalled oldVisit sourceIndex boundary
  u8MacroNextExact :=
    firstTick_next_is_revisedTarget oldVisit sourceIndex boundary
  cofinalSelfU8ConsumesSameOccurrence :=
    M14ProofCarryingContributionCapacityCofinalNoveltySelfU8.proofCarryingContributionCapacityCofinalNoveltySelfU8At
      oldVisit sourceIndex boundary
  cofinalExecutionCoreExact :=
    M14SourceGeneratedContributionCapacityCofinalNoveltyU8Runtime.executionCore_isAugmentedCore
      _
  cofinalRuntimeExact :=
    M14SourceGeneratedContributionCapacityCofinalNoveltyU8Runtime.runtime_isSubmissionRuntime
      _

theorem registeredNewOnlyEntry_hasNoOldPreimage
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    IsEmpty
      (Sigma fun oldEntry : OpenResponsibilityAt
          M9ProofCarryingRenewalInquiryRoot.N
          (jointRoot.toAuthoritativeRoot.toRoot.supportAt
            (rootedFailureAt oldVisit sourceIndex boundary
              ).oldSuccessor.next) =>
        PLift
          ((canonicalCofaceAt oldVisit sourceIndex boundary
            ).cofaceLedgerRetract.forward oldEntry =
            (generatedTypedRevisionAt oldVisit sourceIndex boundary
              ).newOnlyEntry)) :=
  (generatedTypedRevisionAt oldVisit sourceIndex boundary
    ).newOnlyEntry_hasNoOldPreimage

