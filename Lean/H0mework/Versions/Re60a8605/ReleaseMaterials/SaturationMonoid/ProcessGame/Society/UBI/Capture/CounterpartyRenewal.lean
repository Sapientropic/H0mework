import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.UBI.Capture.ResidualDisposition

/-!
# Relation-owned counterparty renewal under UBI price capture

The beneficiary of a captured UBI exit is not supplied as an asset-holder
label.  The exact payment seed already determines an exchange counterparty
actor and relation.  Their interest, phase, and target role are generated by
the existing relation compiler; the capture disposition supplies the exact
open residual, activated consumer, source ownership, and generated next.

This module joins those two authorities.  It proves counterparty-side capture
renewal without introducing an actor, sector, creditor, asset, relation, role,
ledger, or future registry.  A later domain specialization may call the
relation rent/health/platform only after its source phase generates that
meaning.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace UBI
namespace Capture

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Lifecycle Universal Relations Exchange Settlement Price Money Power
open Settlement.SourceOwnedSettlementCompiler

universe u v wa wc x y z q s r e c

variable {Source : Type u} {State : Type v}
variable {occurrenceOf : Source → RootedAccountedUnfolding State}
variable {game : SaturationMonoid.ProcessGame occurrenceOf}
variable {core : SourceOwnedLifecycleCore.{u, v, wa} occurrenceOf game}
variable {V : Vocabulary.{x}}
variable {P : NativeResponsibilityProcess V}
variable {incidence : ActorResponsibilityIncidence core V}
variable
  {exchangeRelationCompiler : SourceOwnedRelationRoleCompiler.{u, v, wa, y}
    occurrenceOf game core.targetFace}
variable
  {exchangeLaw : SourceOwnedExchangeLaw.{u, v, wa, x, y, z}
    core V P incidence exchangeRelationCompiler}
variable
  {settlementCompiler : SourceOwnedSettlementCompiler.{u, v, wa, x, y, z, q}
    exchangeLaw}
variable
  {activationCompiler :
    SourceOwnedResidualConsumerCompiler.{u, v, wa, x, y, z, q, s}
      settlementCompiler}

variable {controllerFace : M0BoundaryFace.{u, v, wc} occurrenceOf}
variable
  {exitRelationCompiler : SourceOwnedRelationRoleCompiler.{u, v, wa, e}
    occurrenceOf game core.targetFace}
variable
  {employmentController : SourceOwnedActionControllerCompiler.{u, v, wc, c}
    game controllerFace}
variable [Zero (exitRelationCompiler.Phase game.source)]

variable {paymentSeed : activationCompiler.ExactActivationSeed}
variable {PriceValue : Type r}
variable {observer : ExchangePriceObserverAt
  (settlementCompiler := settlementCompiler)
  (paymentSeed.occurrence activationCompiler) PriceValue}
variable {employer : employmentController.Actor}
variable {worker : exitRelationCompiler.Actor}
variable {employment exitRelation : exitRelationCompiler.GeneratedRelation}
variable {capture : SourceOwnedPriceCaptureCompilerAt exitRelationCompiler
  (OpenSettlementAt settlementCompiler
    (paymentSeed.occurrence activationCompiler))
  (exactOpenSettlement paymentSeed)}

/-- Counterparty relation generated by the reciprocal leg of the exact open
settlement which backs this payment seed. -/
def exactCaptureCounterpartyRelation :
    exchangeRelationCompiler.GeneratedRelation :=
  (exactExchangeSeed paymentSeed).relation exchangeLaw.compiler
    (exactCounterpartyLeg paymentSeed)

def exactCaptureCounterpartyPhase :
    exchangeRelationCompiler.Phase game.source :=
  exchangeRelationCompiler.phaseStep
    (exactCaptureCounterpartyRelation (paymentSeed := paymentSeed))

def exactCaptureCounterpartyTargetRole :
    exchangeRelationCompiler.Role game.source :=
  exchangeRelationCompiler.roleAt
    (exactCaptureCounterpartyRelation (paymentSeed := paymentSeed)) .target

theorem exactCaptureCounterpartyInterest :
    exchangeRelationCompiler.GeneratedInterestAt
      (exactCounterpartyActor paymentSeed)
      (exactCaptureCounterpartyRelation (paymentSeed := paymentSeed)) :=
  (exchangeLaw.native_reciprocity (exactExchangeSeed paymentSeed)
    (exactCounterpartyLeg paymentSeed)).1

theorem exactCaptureCounterpartyRole :
    exchangeRelationCompiler.RelationRoleAt
      (exactCounterpartyActor paymentSeed)
      (exactCaptureCounterpartyRelation (paymentSeed := paymentSeed)) .target
      (exactCaptureCounterpartyTargetRole (paymentSeed := paymentSeed)) :=
  ⟨exactCaptureCounterpartyInterest, rfl⟩

@[simp] theorem exactCaptureCounterpartyPhase_eq_lineage_readout :
    exactCaptureCounterpartyPhase (paymentSeed := paymentSeed) =
      exchangeRelationCompiler.phaseStepOf game.source
        (exactCaptureCounterpartyRelation
          (paymentSeed := paymentSeed)).1 :=
  rfl

/-- Strong join: the exact captured-code disposition is renewed on the
source-generated counterparty relation and target role.  No caller supplies
an actor, relation, phase, role, residual, consumer, or next. -/
structure SourceGeneratedCounterpartyCaptureRenewalAt
    (program : ExitCapacityProgramAt paymentSeed observer employer worker
      employment exitRelation capture)
    (code : exitRelationCompiler.FutureCode)
    (captured : capture.Captures code) : Prop where
  private mk ::
  captureDisposition :
    SourceAccountedCaptureDispositionAt program code captured
  counterpartyInterest :
    exchangeRelationCompiler.GeneratedInterestAt
      (exactCounterpartyActor paymentSeed)
      (exactCaptureCounterpartyRelation (paymentSeed := paymentSeed))
  counterpartyTargetRole :
    exchangeRelationCompiler.RelationRoleAt
      (exactCounterpartyActor paymentSeed)
      (exactCaptureCounterpartyRelation (paymentSeed := paymentSeed)) .target
      (exactCaptureCounterpartyTargetRole (paymentSeed := paymentSeed))
  phaseGenerated :
    exactCaptureCounterpartyPhase (paymentSeed := paymentSeed) =
      exchangeRelationCompiler.phaseStepOf game.source
        (exactCaptureCounterpartyRelation
          (paymentSeed := paymentSeed)).1

namespace SourceGeneratedCounterpartyCaptureRenewalAt

theorem generate
    (program : ExitCapacityProgramAt paymentSeed observer employer worker
      employment exitRelation capture)
    (code : exitRelationCompiler.FutureCode)
    (captured : capture.Captures code) :
    SourceGeneratedCounterpartyCaptureRenewalAt program code captured where
  captureDisposition :=
    SourceAccountedCaptureDispositionAt.generate program code captured
  counterpartyInterest := exactCaptureCounterpartyInterest
  counterpartyTargetRole := exactCaptureCounterpartyRole
  phaseGenerated := exactCaptureCounterpartyPhase_eq_lineage_readout

theorem exact_relation_actor_provenance
    {program : ExitCapacityProgramAt paymentSeed observer employer worker
      employment exitRelation capture}
    {code : exitRelationCompiler.FutureCode}
    {captured : capture.Captures code}
    (renewal : SourceGeneratedCounterpartyCaptureRenewalAt
      program code captured) :
    ∃ seed : exchangeRelationCompiler.ExactRelationSeed,
      (∃ state ∈ game.occurrence.trace,
        state = core.targetFace.state game.source ∧
        exchangeRelationCompiler.relationSeedAt game.source state seed.1 ∧
        core.targetFace.SeedAt game.source state
          (exchangeRelationCompiler.beneficiaryActorSeed seed.1)) ∧
      seed.actor exchangeRelationCompiler = exactCounterpartyActor paymentSeed ∧
      exchangeRelationCompiler.relationOf seed =
        exactCaptureCounterpartyRelation (paymentSeed := paymentSeed) :=
  renewal.counterpartyInterest.exact_state_provenance

theorem activated_consumer_generates_payment_next
    {program : ExitCapacityProgramAt paymentSeed observer employer worker
      employment exitRelation capture}
    {code : exitRelationCompiler.FutureCode}
    {captured : capture.Captures code}
    (renewal : SourceGeneratedCounterpartyCaptureRenewalAt
      program code captured) :
    program.purchasingPowerStanding.activatedConsumer.nextGeneratedState =
      program.payment.nextGenerated :=
  renewal.captureDisposition.consumerNextIsPaymentNext

end SourceGeneratedCounterpartyCaptureRenewalAt

end Capture
end UBI
end Society
end ProcessGame
end SaturationMonoid

#print axioms SaturationMonoid.ProcessGame.Society.UBI.Capture.SourceGeneratedCounterpartyCaptureRenewalAt.generate
#print axioms SaturationMonoid.ProcessGame.Society.UBI.Capture.SourceGeneratedCounterpartyCaptureRenewalAt.exact_relation_actor_provenance
