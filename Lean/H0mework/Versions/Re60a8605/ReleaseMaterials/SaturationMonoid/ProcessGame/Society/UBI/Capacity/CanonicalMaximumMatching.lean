import Mathlib.Data.Finset.Card
import Mathlib.Data.Finset.Lattice.Fold
import Mathlib.Data.Finset.Prod
import Mathlib.Data.Finset.Powerset

/-!
# Canonical finite maximum matching

This is a neutral finite calculation used by actionable-exit capacity.  The
caller supplies only two finite carriers and a fixed feasibility predicate.
The matching family is the canonical powerset filter and capacity is its
canonical supremum; no selected matching, optimizer certificate, or registry
is stored.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace UBI
namespace Capacity

universe u v

variable {Left : Type u} {Right : Type v}

/-- Fixed finite feasibility data.  In the UBI specialization both carriers
and the positive feasibility receipts are generated by the same occurrence. -/
structure CanonicalBipartiteFeasibility
    (Left : Type u) (Right : Type v) where
  leftCarrier : Finset Left
  rightCarrier : Finset Right
  Feasible : Left → Right → Prop
  feasibleDecidable : ∀ left right, Decidable (Feasible left right)

namespace CanonicalBipartiteFeasibility

variable (geometry : CanonicalBipartiteFeasibility Left Right)

/-- All feasible edges, enumerated from the two fixed finite carriers. -/
noncomputable def edgeCarrier : Finset (Left × Right) := by
  classical
  exact (geometry.leftCarrier ×ˢ geometry.rightCarrier).filter fun edge =>
    geometry.Feasible edge.1 edge.2

theorem mem_edgeCarrier_iff (edge : Left × Right) :
    edge ∈ geometry.edgeCarrier ↔
      edge.1 ∈ geometry.leftCarrier ∧
      edge.2 ∈ geometry.rightCarrier ∧
      geometry.Feasible edge.1 edge.2 := by
  classical
  simp only [edgeCarrier, Finset.mem_filter, Finset.mem_product]
  tauto

/-- Matching law: neither endpoint may be reused. -/
def IsMatching
    (_geometry : CanonicalBipartiteFeasibility Left Right)
    (matching : Finset (Left × Right)) : Prop :=
  Set.InjOn Prod.fst (matching : Set (Left × Right)) ∧
    Set.InjOn Prod.snd (matching : Set (Left × Right))

/-- All source-determined matchings.  Membership in the powerset supplies
feasibility; `IsMatching` supplies left/right uniqueness. -/
noncomputable def matchings : Finset (Finset (Left × Right)) := by
  classical
  exact geometry.edgeCarrier.powerset.filter geometry.IsMatching

/-- Canonical maximum simultaneous capacity. -/
noncomputable def maximumMatchingCapacity : Nat :=
  geometry.matchings.sup Finset.card

theorem empty_isMatching : geometry.IsMatching ∅ := by
  constructor <;> intro left leftMem <;> simp at leftMem

theorem singleton_isMatching (edge : Left × Right) :
    geometry.IsMatching {edge} := by
  constructor
  · intro left leftMem right rightMem _equal
    have left_eq : left = edge := by simpa using leftMem
    have right_eq : right = edge := by simpa using rightMem
    exact left_eq.trans right_eq.symm
  · intro left leftMem right rightMem _equal
    have left_eq : left = edge := by simpa using leftMem
    have right_eq : right = edge := by simpa using rightMem
    exact left_eq.trans right_eq.symm

theorem singleton_mem_matchings
    {edge : Left × Right} (feasible : edge ∈ geometry.edgeCarrier) :
    {edge} ∈ geometry.matchings := by
  classical
  simp [matchings, feasible, geometry.singleton_isMatching edge]

theorem edge_generates_positive_capacity
    {edge : Left × Right} (feasible : edge ∈ geometry.edgeCarrier) :
    0 < geometry.maximumMatchingCapacity := by
  classical
  have lower : ({edge} : Finset (Left × Right)).card ≤
      geometry.maximumMatchingCapacity :=
    Finset.le_sup (geometry.singleton_mem_matchings feasible)
  exact Nat.succ_le_iff.mp lower

theorem edgeCarrier_empty_generates_zero_capacity
    (empty : geometry.edgeCarrier = ∅) :
    geometry.maximumMatchingCapacity = 0 := by
  have matchings_eq : geometry.matchings = {∅} := by
    classical
    unfold matchings
    rw [empty, Finset.powerset_empty]
    apply Finset.filter_eq_self.mpr
    intro matching member
    have matching_eq : matching = ∅ := Finset.mem_singleton.mp member
    subst matching
    exact geometry.empty_isMatching
  simp [maximumMatchingCapacity, matchings_eq]

theorem positive_capacity_iff_feasible_edge :
    0 < geometry.maximumMatchingCapacity ↔ geometry.edgeCarrier.Nonempty := by
  constructor
  · intro positive
    by_contra noEdge
    have empty : geometry.edgeCarrier = ∅ :=
      Finset.not_nonempty_iff_eq_empty.mp noEdge
    rw [geometry.edgeCarrier_empty_generates_zero_capacity empty] at positive
    exact Nat.lt_irrefl 0 positive
  · rintro ⟨edge, feasible⟩
    exact geometry.edge_generates_positive_capacity feasible

theorem matching_subset_edgeCarrier
    {matching : Finset (Left × Right)}
    (member : matching ∈ geometry.matchings) :
    matching ⊆ geometry.edgeCarrier := by
  classical
  exact Finset.mem_powerset.mp (Finset.mem_filter.mp member).1

theorem matching_laws
    {matching : Finset (Left × Right)}
    (member : matching ∈ geometry.matchings) :
    geometry.IsMatching matching := by
  classical
  exact (Finset.mem_filter.mp member).2

theorem matching_card_le_left
    {matching : Finset (Left × Right)}
    (member : matching ∈ geometry.matchings) :
    matching.card ≤ geometry.leftCarrier.card := by
  classical
  have injected : Set.InjOn Prod.fst (matching : Set (Left × Right)) :=
    (geometry.matching_laws member).1
  have imageSubset : matching.image Prod.fst ⊆ geometry.leftCarrier := by
    intro left leftMem
    rcases Finset.mem_image.mp leftMem with ⟨edge, edgeMem, rfl⟩
    exact (geometry.mem_edgeCarrier_iff edge).mp
      (geometry.matching_subset_edgeCarrier member edgeMem) |>.1
  rw [← Finset.card_image_iff.mpr injected]
  exact Finset.card_le_card imageSubset

theorem matching_card_le_right
    {matching : Finset (Left × Right)}
    (member : matching ∈ geometry.matchings) :
    matching.card ≤ geometry.rightCarrier.card := by
  classical
  have injected : Set.InjOn Prod.snd (matching : Set (Left × Right)) :=
    (geometry.matching_laws member).2
  have imageSubset : matching.image Prod.snd ⊆ geometry.rightCarrier := by
    intro right rightMem
    rcases Finset.mem_image.mp rightMem with ⟨edge, edgeMem, rfl⟩
    exact (geometry.mem_edgeCarrier_iff edge).mp
      (geometry.matching_subset_edgeCarrier member edgeMem) |>.2.1
  rw [← Finset.card_image_iff.mpr injected]
  exact Finset.card_le_card imageSubset

theorem maximumMatchingCapacity_le_left :
    geometry.maximumMatchingCapacity ≤ geometry.leftCarrier.card := by
  apply Finset.sup_le
  intro matching member
  exact geometry.matching_card_le_left member

theorem maximumMatchingCapacity_le_right :
    geometry.maximumMatchingCapacity ≤ geometry.rightCarrier.card := by
  apply Finset.sup_le
  intro matching member
  exact geometry.matching_card_le_right member

end CanonicalBipartiteFeasibility

end Capacity
end UBI
end Society
end ProcessGame
end SaturationMonoid
