import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Space.GeneratedSocialSpace
import H0mework.Society.Renewal.InstalledRenewalProjection
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Capacity.OccurrenceCapacityConsumer

/-!
# Source-installed boundary maintenance

Boundary standing is not generated by a site name, boundary seed, or
classifier tag.  A fixed M8 renewal consumer carries one exact boundary
certificate together with one source-owned lifecycle debit event before the
root emits its occurrence.  The installed consumer then derives the exact
maintenance debit, singleton debited run, live target standing, root
responsibility consumer, whole-ledger write-back, and the existing root next.

No social root, process, ledger, receipt registry, social next, completed
future, or policy target is introduced here.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace Space

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Renewal Capacity

universe u

variable {Source State Seed : Type u}
variable {occurrenceOf : Source → RootedAccountedUnfolding State}
variable {game : SaturationMonoid.ProcessGame occurrenceOf}
variable {SeedAt : Source → State → Seed → Prop}
variable {Lineage : Source → Type u}
variable {lineageOf : ∀ source,
  SourceSeed occurrenceOf Seed SeedAt source → Lineage source}
variable {focal : SourceSeed occurrenceOf Seed SeedAt game.source}
variable {rateCompiler : SourceOwnedOccurrenceRateCompiler.{u, u, u, u, u}
  game Seed SeedAt Lineage lineageOf focal}
variable {crossingCompiler : SourceOwnedCrossingCompiler.{u, u, u, u, u,
  u, u, u, u, u, u} rateCompiler}
variable {socialSpace : SourceGeneratedSocialSpaceAt crossingCompiler}

variable {BoundaryV : ResponsibilityLifecycle.Vocabulary.{u}}
variable {P : NativeResponsibilityProcess BoundaryV}
variable {B : NativeCarryDebitProcess P}

/-! ## Pre-emitter exact restriction -/

/-- Exact boundary/service restriction installed as the M8 local consumer.

`seed_eq_focal` binds the renewal occurrence to the fixed rate/crossing
compiler.  `boundaryLineage_heq` binds the source-generated boundary lineage
to the lifecycle lineage of the actual debit event. -/
structure BoundaryMaintenanceRestrictionAt
    (socialSpace : SourceGeneratedSocialSpaceAt crossingCompiler)
    (P : NativeResponsibilityProcess BoundaryV)
    (B : NativeCarryDebitProcess P)
    (seed : SourceSeed occurrenceOf Seed SeedAt game.source) : Type u where
  certificate : crossingCompiler.AnyBoundaryCertificate
  certificate_mem : certificate ∈ socialSpace.boundaryCertificates
  seed_eq_focal : seed = focal
  sourceState : ResponsibilityState BoundaryV
  edge : P.Edge sourceState
  lineage : BoundaryV.Lineage
  debitEvent : B.DebitEvent edge lineage
  boundaryLineage_heq : HEq
    (crossingCompiler.boundaryLineageOf game.source certificate.sourceSeed)
    lineage

/-- Exact consumer family to install in the M8 renewal law. -/
abbrev BoundaryMaintenanceRestrictionConsumerAt
    (socialSpace : SourceGeneratedSocialSpaceAt crossingCompiler)
    (P : NativeResponsibilityProcess BoundaryV)
    (B : NativeCarryDebitProcess P)
    (seed : SourceSeed occurrenceOf Seed SeedAt game.source) : Type u :=
  BoundaryMaintenanceRestrictionAt socialSpace P B seed

/-- M8 recognition whose pre-emitter consumer is definitionally the exact
boundary-maintenance restriction. -/
abbrev SourceNativeBoundaryMaintenanceRecognitionAt
    {N : WorldRelationNetwork.{u}}
    {RootV : ConstructiveRoot.Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N RootV)
    (socialSpace : SourceGeneratedSocialSpaceAt crossingCompiler)
    (P : NativeResponsibilityProcess BoundaryV)
    (B : NativeCarryDebitProcess P)
    (DispositionAt :
      SourceSeed occurrenceOf Seed SeedAt game.source → Type u) :=
  SourceNativeRenewalRecognitionAt root game Seed SeedAt
    (BoundaryMaintenanceRestrictionConsumerAt socialSpace P B) DispositionAt

variable {N : WorldRelationNetwork.{u}}
variable {RootV : ConstructiveRoot.Vocabulary.{u}}
variable {root : SourceNativeLivingRootClosure N RootV}
variable {DispositionAt :
  SourceSeed occurrenceOf Seed SeedAt game.source → Type u}
variable {recognition : SourceNativeBoundaryMaintenanceRecognitionAt
  root socialSpace P B DispositionAt}
variable {visit : SourceNativeTemporalVisitAt
  root.toAuthoritativeRoot.toLedgerRoot}
variable {installed : SourceInstalledRenewalAt recognition visit}

/-! ## Installed boundary maintenance -/

/-- Zero-field seal over the already-installed renewal occurrence.  All
substantive data remain in the M8 payload consumer and existing root. -/
structure SourceInstalledBoundaryMaintenanceAt
    (installed : SourceInstalledRenewalAt recognition visit) : Type (u + 2) where
  private mk ::

/-- Sole installed-maintenance producer.  It accepts no crossing, standing,
edge, debit, root next, or completed run. -/
def sourceInstalledBoundaryMaintenance
    (installed : SourceInstalledRenewalAt recognition visit) :
    SourceInstalledBoundaryMaintenanceAt installed :=
  ⟨⟩

namespace SourceInstalledBoundaryMaintenanceAt

variable (maintenance : SourceInstalledBoundaryMaintenanceAt installed)

/-- Exact restriction read only from the pre-emitter M8 consumer. -/
def restriction : BoundaryMaintenanceRestrictionAt socialSpace P B
    installed.payload.sourceSeed := by
  cases maintenance
  exact installed.payload.consumer

/-- Source-classified boundary certificate. -/
def boundaryCertificate : crossingCompiler.AnyBoundaryCertificate :=
  maintenance.restriction.certificate

theorem boundaryCertificate_mem :
    maintenance.boundaryCertificate ∈ socialSpace.boundaryCertificates :=
  maintenance.restriction.certificate_mem

/-- Exact crossing and classifier provenance recovered from social space. -/
theorem boundaryCertificate_provenance :
    maintenance.boundaryCertificate.crossing ∈ socialSpace.crossingTrace ∧
      crossingCompiler.boundaryCertificate?
          maintenance.boundaryCertificate.crossing =
        some maintenance.boundaryCertificate.proof :=
  socialSpace.boundaryCertificate_provenance
    maintenance.boundaryCertificate maintenance.boundaryCertificate_mem

def exactCrossing : crossingCompiler.ExactCrossing :=
  maintenance.boundaryCertificate.crossing

def boundarySourceSeed : SourceSeed occurrenceOf
    crossingCompiler.BoundarySeed crossingCompiler.BoundarySeedAt game.source :=
  maintenance.boundaryCertificate.sourceSeed

/-- Source-generated boundary image at the exact crossing. -/
def boundary : crossingCompiler.Boundary :=
  maintenance.boundaryCertificate.boundary

@[simp] theorem renewalSeed_eq_focal
    (maintenance : SourceInstalledBoundaryMaintenanceAt installed) :
    installed.payload.sourceSeed = focal :=
  BoundaryMaintenanceRestrictionAt.seed_eq_focal maintenance.restriction

/-- Actual maintenance debit generated by the exact pre-emitter debit event. -/
def actualMaintenanceDebit : ActualMaintenanceDebit P B.budgetAt
    maintenance.restriction.edge maintenance.restriction.lineage :=
  B.debitReceipt maintenance.restriction.debitEvent

/-- Exact one-edge maintenance run. -/
def maintenanceRun : P.Run maintenance.restriction.sourceState
    maintenance.restriction.edge.target :=
  .step .nil maintenance.restriction.edge

/-- Every edge in the run is covered by the same source-owned debit process. -/
def nativeDebitedRun : NativeDebitedRun P B maintenance.restriction.lineage
    maintenance.maintenanceRun := by
  change NativeDebitedRun P B maintenance.restriction.lineage
    (.step .nil maintenance.restriction.edge)
  exact .step (.nil maintenance.restriction.sourceState)
    maintenance.restriction.edge maintenance.restriction.debitEvent

/-- Boundary standing is the maintained obligation generated by the actual
maintenance event, not the boundary seed or classifier. -/
def boundaryStanding : AdmittedObligation BoundaryV :=
  maintenance.actualMaintenanceDebit.obligation

theorem boundaryStanding_live_at_source :
    maintenance.restriction.sourceState.slots[
      maintenance.actualMaintenanceDebit.slot]? =
        some (.live maintenance.boundaryStanding) :=
  maintenance.actualMaintenanceDebit.source_live

theorem boundaryStanding_live_at_target :
    maintenance.restriction.edge.target.slots[
      maintenance.actualMaintenanceDebit.slot]? =
        some (.live maintenance.boundaryStanding) :=
  maintenance.actualMaintenanceDebit.target_live

/-- Exact `.maintained` lifecycle event which generated the target standing. -/
theorem boundaryStanding_generatedByMaintenance :
    maintenance.restriction.edge.lifecycleEvent =
      .carried maintenance.actualMaintenanceDebit.slot
        maintenance.boundaryStanding
        maintenance.actualMaintenanceDebit.sourceEvent
        (.maintained maintenance.actualMaintenanceDebit.receipt) :=
  maintenance.actualMaintenanceDebit.event_eq

/-- Boundary-image lineage and maintained standing lineage are the same
source-generated lineage, even when their carrier presentations differ. -/
theorem boundaryStanding_lineage_heq_boundaryLineage : HEq
    maintenance.boundaryStanding.lineage
    (crossingCompiler.boundaryLineageOf game.source
      maintenance.boundarySourceSeed) :=
  (heq_of_eq maintenance.actualMaintenanceDebit.lineage_eq).trans
    maintenance.restriction.boundaryLineage_heq.symm

/-- Independent M8 responsibility consumer at the exact root row. -/
def rootConsumer :
    RenewalResponsibilityConsumerAt installed.operationalAuthority := by
  cases maintenance
  exact installed.rootResponsibilityConsumer

/-- Whole-ledger write-back at the installed renewal occurrence. -/
def wholeLedgerWriteBack :
    SourceNativeLedgerEvolutionAt
      root.toAuthoritativeRoot.toLedgerRoot.source.source
      (root.toAuthoritativeRoot.toLedgerRoot
        |>.generatedAtTemporalVisit visit).occurrence := by
  cases maintenance
  exact (root.toAuthoritativeRoot.toLedgerRoot
    |>.generatedAtTemporalVisit visit).wholeLedgerWriteBack

/-- Existing root-generated next; local maintenance emits no social next. -/
def generatedNext : SourceNativeAuthoritativeRootCurrentAt N :=
  by
    cases maintenance
    exact root.generatedNextCurrentAt visit

theorem rootAnswerAndNext_factorizes
    (maintenance : SourceInstalledBoundaryMaintenanceAt installed) :
    installed.RootAnswerAndNextFactorizes := by
  cases maintenance
  exact installed.rootAnswerAndNext_factorizes

end SourceInstalledBoundaryMaintenanceAt

/-! ## Independent root consumer -/

structure BoundaryMaintenanceConsumerAt
    (maintenance : SourceInstalledBoundaryMaintenanceAt installed) :
    Type (u + 4) where
  private mk ::
  certificate : crossingCompiler.AnyBoundaryCertificate
  certificate_eq : certificate = maintenance.boundaryCertificate
  certificate_mem : certificate ∈ socialSpace.boundaryCertificates
  exactCrossing : crossingCompiler.ExactCrossing
  exactCrossing_eq : exactCrossing = maintenance.exactCrossing
  boundary : crossingCompiler.Boundary
  boundary_eq : boundary = maintenance.boundary
  actualDebit : ActualMaintenanceDebit P B.budgetAt
    maintenance.restriction.edge maintenance.restriction.lineage
  debitedRun : NativeDebitedRun P B maintenance.restriction.lineage
    maintenance.maintenanceRun
  boundaryStanding : AdmittedObligation BoundaryV
  boundaryStanding_eq : boundaryStanding = maintenance.boundaryStanding
  target_live : maintenance.restriction.edge.target.slots[
    actualDebit.slot]? = some (.live boundaryStanding)
  rootConsumer : RenewalResponsibilityConsumerAt installed.operationalAuthority
  wholeLedgerWriteBack :
    SourceNativeLedgerEvolutionAt
      root.toAuthoritativeRoot.toLedgerRoot.source.source
      (root.toAuthoritativeRoot.toLedgerRoot
        |>.generatedAtTemporalVisit visit).occurrence
  generatedNext : SourceNativeAuthoritativeRootCurrentAt N
  generatedNext_eq : generatedNext = root.generatedNextCurrentAt visit
  rootFactorization : installed.RootAnswerAndNextFactorizes

/-- Direct independent consumer of the installed boundary maintenance. -/
def SourceInstalledBoundaryMaintenanceAt.independentConsumer
    (maintenance : SourceInstalledBoundaryMaintenanceAt installed) :
    BoundaryMaintenanceConsumerAt maintenance where
  certificate := maintenance.boundaryCertificate
  certificate_eq := rfl
  certificate_mem := maintenance.boundaryCertificate_mem
  exactCrossing := maintenance.exactCrossing
  exactCrossing_eq := rfl
  boundary := maintenance.boundary
  boundary_eq := rfl
  actualDebit := maintenance.actualMaintenanceDebit
  debitedRun := maintenance.nativeDebitedRun
  boundaryStanding := maintenance.boundaryStanding
  boundaryStanding_eq := rfl
  target_live := maintenance.boundaryStanding_live_at_target
  rootConsumer := maintenance.rootConsumer
  wholeLedgerWriteBack := maintenance.wholeLedgerWriteBack
  generatedNext := maintenance.generatedNext
  generatedNext_eq := rfl
  rootFactorization := maintenance.rootAnswerAndNext_factorizes

/-! ## Anomie boundary-failure consequence -/

namespace SourceInstalledBoundaryMaintenanceAt

/-- The rate compiler reindexed only by the equality generated inside the
pre-emitter restriction.  No new queue law is constructed. -/
def phaseRateCompiler
    (maintenance : SourceInstalledBoundaryMaintenanceAt installed) :
    SourceOwnedOccurrenceRateCompiler.{u, u, u, u, u}
      game Seed SeedAt Lineage lineageOf installed.payload.sourceSeed := by
  rw [maintenance.renewalSeed_eq_focal]
  exact rateCompiler

end SourceInstalledBoundaryMaintenanceAt

variable {maintenance : SourceInstalledBoundaryMaintenanceAt installed}
variable {exactPrefix : SourceGeneratedExactQueuePrefixAt
  maintenance.phaseRateCompiler}
variable {phase : SourceGeneratedOccurrenceCapacityPhaseAt installed
  maintenance.phaseRateCompiler exactPrefix}

/-- Exact classifier property saying every debt occurrence in this phase
prefix is a boundary crossing of the same transported compiler.  This is the
only extra premise needed when the crossing law permits non-boundary units. -/
structure ExactBoundarySaturatedPhaseAt
    (maintenance : SourceInstalledBoundaryMaintenanceAt installed)
    (phase : SourceGeneratedOccurrenceCapacityPhaseAt installed
      maintenance.phaseRateCompiler exactPrefix) : Prop where
  classifies : (unit : maintenance.phaseRateCompiler.QueueUnit) →
    unit ∈ phase.queuePrefix →
      ∃ sourceUnit : rateCompiler.QueueUnit,
        HEq unit sourceUnit ∧
          ∃ certificate,
            crossingCompiler.boundaryCertificate?
                (crossingCompiler.exactCrossingOf sourceUnit) =
              some certificate

/-- Exact unpaid boundary occurrence extracted from an anomie backlog.  The
private constructor prevents a caller from submitting a failing tag, an
inequality, a crossing, or a boundary certificate. -/
structure FailingBoundaryLineageAt
    (maintenance : SourceInstalledBoundaryMaintenanceAt installed)
    (phase : SourceGeneratedOccurrenceCapacityPhaseAt installed
      maintenance.phaseRateCompiler exactPrefix) : Type u where
  private mk ::
  unit : maintenance.phaseRateCompiler.QueueUnit
  backlog_mem : unit ∈ phase.backlog
  sourceUnit : rateCompiler.QueueUnit
  sameOccurrence : HEq unit sourceUnit
  certificate : crossingCompiler.BoundaryCertificateAt
    (crossingCompiler.exactCrossingOf sourceUnit)
  classified : crossingCompiler.boundaryCertificate?
      (crossingCompiler.exactCrossingOf sourceUnit) =
    some certificate

namespace FailingBoundaryLineageAt

variable (failure : FailingBoundaryLineageAt maintenance phase)

def exactCrossing : crossingCompiler.ExactCrossing :=
  crossingCompiler.exactCrossingOf failure.sourceUnit

def boundarySourceSeed : SourceSeed occurrenceOf
    crossingCompiler.BoundarySeed
    crossingCompiler.BoundarySeedAt game.source :=
  failure.certificate.sourceSeed

def boundary : crossingCompiler.Boundary :=
  failure.certificate.boundary

def boundaryLineage : crossingCompiler.BoundaryLineage game.source :=
  crossingCompiler.boundaryLineageOf game.source failure.boundarySourceSeed

theorem unit_mem_compilerQueue : failure.unit ∈
    maintenance.phaseRateCompiler.queue :=
  phase.backlog_mem_queue failure.unit failure.backlog_mem

theorem crossing_mem_generatedTrace : failure.exactCrossing ∈
    crossingCompiler.crossingTrace :=
  crossingCompiler.exactCrossing_mem failure.exactCrossing

end FailingBoundaryLineageAt

/-- In anomie, source-generated debt exceeds capacity-allocated occurrences
plus retained headroom.  This is an allocation statement; actual settled
service requires the eventwise debit interface in `CrossingCostPhase`. -/
theorem anomie_boundaryDebt_gt_allocatedService_add_headroom
    (_saturated : ExactBoundarySaturatedPhaseAt maintenance phase)
    (anomie : phase.phaseTag = .anomie) :
    phase.served.length + phase.spare < phase.rate := by
  have capacity_lt_rate := phase.phaseTag_eq_anomie_iff.mp anomie
  rw [phase.served_length, min_eq_left capacity_lt_rate.le]
  unfold SourceGeneratedOccurrenceCapacityPhaseAt.spare
  omega

/-- Conditional consequence of the exact source classifier and generated
anomie phase: the backlog contains a canonical boundary-lineage witness.  The
premises are readouts of the fixed source law, not a zero-choice producer. -/
theorem anomie_hasFailingBoundaryLineage
    (saturated : ExactBoundarySaturatedPhaseAt maintenance phase)
    (anomie : phase.phaseTag = .anomie) :
    Nonempty (FailingBoundaryLineageAt maintenance phase) := by
  have backlog_ne_nil := phase.anomie_backlog_ne_nil anomie
  cases backlog_eq : phase.backlog with
  | nil => exact False.elim (backlog_ne_nil backlog_eq)
  | cons unit rest =>
      have unit_mem_backlog : unit ∈ phase.backlog := by
        rw [backlog_eq]
        simp
      have unit_mem_prefix : unit ∈ phase.queuePrefix := by
        rw [← phase.served_append_backlog]
        exact List.mem_append_right _ unit_mem_backlog
      rcases saturated.classifies unit unit_mem_prefix with
        ⟨sourceUnit, sameOccurrence, certificate, classified⟩
      exact ⟨⟨unit, unit_mem_backlog, sourceUnit, sameOccurrence,
        certificate, classified⟩⟩

end Space
end Society
end ProcessGame
end SaturationMonoid
