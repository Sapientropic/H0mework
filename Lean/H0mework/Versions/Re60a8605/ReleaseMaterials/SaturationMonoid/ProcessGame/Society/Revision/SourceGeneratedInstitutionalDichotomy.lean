import H0mework.Foundation.Runtime.Inquiry

/-!
# Canonical-runtime-generated institutional dichotomy

Institutional reform versus revolution is not a caller-selected sum.  One
reachable canonical inquiry-runtime tick already contains the complete
source-generated resolution, branch receipt, and heterogeneous next root.
This module exposes that compiler image as a zero-choice institutional
revision mouth.

The bounded path is the recursively generated macro-runtime prefix
`runtime.run depth`, not one local ledger patch.  Direct, U7-settled,
old-language, and sequential actual-action answers are reform readouts.  Only
the exact `.revised` compiler constructor is revolutionary, and that branch
automatically proves that the same named runtime consumed its U8 core.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace Revision

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open ConstructiveRoot.RootInquiryCompletion
open ConstructiveRoot.ObstructionGeneratedMinimalCoface
open ConstructiveRoot.TypedSemanticWorldNetworkU8
open ConstructiveRoot.TypedSemanticWorldNetworkU8Recovery

universe u

/-- Presentation-only revision kind.  It has no constructor back into the
authority carrier below. -/
inductive SourceGeneratedInstitutionalRevisionKind
  | reform
  | revolution
  deriving DecidableEq

/-- Eliminate the exact dependent resolution itself.  This helper is private
so the public API exposes only the kind generated by a canonical runtime
tick, never a constructor accepting a caller-selected resolution. -/
private def sourceGeneratedInstitutionalRevisionKind
    {node : RootInquiryProcessNode.{u}}
    {query : node.Query}
    (resolution : node.ResolutionAt query) :
    SourceGeneratedInstitutionalRevisionKind :=
  match node with
  | .answered _ _ => nomatch query
  | .active _ =>
      match resolution with
      | .directlyAnswered _ _ => .reform
      | .u7Answered _ _ _ _ => .reform
      | .oldLanguageAnswered _ _ _ _ _ => .reform
      | .actualAction _ => .reform
      | .revised _ _ _ _ => .revolution

/-- Zero-choice institutional revision at one recursively reachable inquiry
runtime depth.  The private empty constructor stores no resolution, branch
tag, core, answer, receipt, or next current. -/
structure SourceGeneratedInstitutionalDichotomyAt
    {process : SourceNativeInquiryEngineProcess.{u}}
    (runtime : SourceNativeInquiryRuntime process)
    (depth : Nat) : Type (u + 14) where
  private mk ::

/-- Exact revolutionary branch of one already generated resolution.

The private constructor stores the proof that its core is literally contained
in the indexed resolution.  A standalone field-grounded candidate cannot
inhabit this carrier. -/
structure SourceGeneratedRevolutionaryResolutionAt
    {node : RootInquiryProcessNode.{u}}
    {query : node.Query}
    (resolution : node.ResolutionAt query) : Type (u + 14) where
  private mk ::
  state : RootInquiryStatePresentation.{u}
  stateQuery : state.Query
  obstruction : state.N.ObstructionAt state.state.base.support
  u7Gate : state.state.base.U7RequestsTheoryAuditAt obstruction
  failure : ActualExpressibilityFailure state.state.base.oldTheory obstruction
  core : SourceGeneratedInquiryU8CompletionAt state.state.base stateQuery
    obstruction u7Gate failure
  contains_core :
    SourceNativeInquiryRuntime.RootInquiryProcessNode.ResolutionAt.ContainsU8Core
      resolution core

/-- Runtime-specialized spelling.  Its index is exactly
`runtime.tickAt depth |>.resolution`; no equality receipt is added. -/
abbrev SourceGeneratedRevolutionaryTickAt
    {process : SourceNativeInquiryEngineProcess.{u}}
    (runtime : SourceNativeInquiryRuntime process)
    (depth : Nat) : Type (u + 14) :=
  SourceGeneratedRevolutionaryResolutionAt
    (runtime.tickAt depth).resolution

/-- Internal dependent eliminator.  Indexing the result by the resolution
lets Lean expose the revised core without casting an engine node. -/
private def sourceGeneratedRevolutionaryResolution?
    {node : RootInquiryProcessNode.{u}}
    {query : node.Query}
    (resolution : node.ResolutionAt query) :
    Option (SourceGeneratedRevolutionaryResolutionAt resolution) :=
  match node with
  | .answered _ _ => nomatch query
  | .active state =>
      match resolution with
      | .directlyAnswered _ _ => none
      | .u7Answered _ _ _ _ => none
      | .oldLanguageAnswered _ _ _ _ _ => none
      | .actualAction _ => none
      | .revised obstruction u7Gate failure core =>
          some ⟨state, query, obstruction, u7Gate, failure, core, by
            unfold SourceNativeInquiryRuntime.RootInquiryProcessNode.ResolutionAt.ContainsU8Core
            rfl⟩

namespace SourceGeneratedInstitutionalDichotomyAt

variable {process : SourceNativeInquiryEngineProcess.{u}}
variable {runtime : SourceNativeInquiryRuntime process}
variable {depth : Nat}

/-- Sole producer.  Runtime and depth determine every subsequent readout. -/
def generate
    (runtime : SourceNativeInquiryRuntime process)
    (depth : Nat) :
    SourceGeneratedInstitutionalDichotomyAt runtime depth :=
  ⟨⟩

variable (dichotomy : SourceGeneratedInstitutionalDichotomyAt runtime depth)

/-- Source-generated finite macro path from the sealed initial activation to
the current depth.  Fuel exhaustion is only the endpoint of this bounded
readout, never a terminal world verdict. -/
def finitePrefix
    (_dichotomy : SourceGeneratedInstitutionalDichotomyAt runtime depth) :
    SourceNativeInquiryRuntime.HistoryAt runtime depth runtime.initialState :=
  runtime.run depth

/-- The one authority-bearing occurrence immediately after the generated
finite prefix. -/
def tick
    (_dichotomy : SourceGeneratedInstitutionalDichotomyAt runtime depth) :
    SourceNativeInquiryRuntime.ExactActivatedInquiryOccurrenceAt
      (runtime.stateAt depth) :=
  runtime.tickAt depth

/-- Exact compiler-generated resolution of this tick. -/
def resolution
    (_dichotomy : SourceGeneratedInstitutionalDichotomyAt runtime depth) :=
  (runtime.tickAt depth).resolution

/-- Reform versus revolution is computed from the exact tick resolution.
No tag is supplied to the producer. -/
def revisionKind : SourceGeneratedInstitutionalRevisionKind :=
  sourceGeneratedInstitutionalRevisionKind dichotomy.resolution

/-- Branch-dependent answer generated by the same sealed tick. -/
def answer : RootInquiryProcessNode.AnswerAt dichotomy.resolution :=
  dichotomy.tick.answer

/-- Independent branch consumer.  On reform branches this contains the exact
root answer consumer and old-row answer-and-next; on revolution it contains
the initial-coface/first-write and two-row answer-and-next receipt. -/
def independentConsumerReceipt :
    RootInquiryProcessNode.ReceiptAt dichotomy.resolution :=
  dichotomy.tick.receipt

/-- Heterogeneous actual next emitted by the exact macro tick. -/
def actualNext : AnyAuthoritativeRootCurrent.{u} :=
  dichotomy.tick.next.node.erase

set_option linter.defProp false in
/-- The heterogeneous actual next is exactly the compiler-generated next of
the same resolution.  Its dependent RHS remains sealed by the inquiry
kernel; this module does not reconstruct a branch-local next. -/
def next_erases_to_generated :=
  dichotomy.tick.next_erases_to_generated

/-- Automatically recover the revolutionary core exactly when the current
tick's private compiler selected `.revised`.  The other four constructors
return `none`; no caller supplies a branch tag or core. -/
def revolutionaryTick? :
    Option (SourceGeneratedRevolutionaryTickAt runtime depth) :=
  sourceGeneratedRevolutionaryResolution? dichotomy.resolution

end SourceGeneratedInstitutionalDichotomyAt

namespace SourceGeneratedRevolutionaryTickAt

variable {process : SourceNativeInquiryEngineProcess.{u}}
variable {runtime : SourceNativeInquiryRuntime process}
variable {depth : Nat}

variable (revolution : SourceGeneratedRevolutionaryTickAt runtime depth)

/-- Same-row equality generated by the U8 core's fixed frontier. -/
theorem rootEntry_eq :
    revolution.core.face.rootEntry =
      revolution.state.state.base.entryAt revolution.stateQuery :=
  revolution.core.rootEntry_eq

/-- The same named runtime consumed this exact core at this exact depth. -/
theorem resumption : SourceNativeInquiryRuntime.CofaceRealizationResumptionAt
    revolution.core runtime depth :=
  ⟨revolution.contains_core⟩

/-- Exact rooted expressibility failure consumed by the runtime branch. -/
def rooted :=
  revolution.core.rooted

/-- Canonical minimal coface generated by that rooted failure. -/
def minimalCoface :=
  root_obstruction_generates_minimal_coface revolution.rooted

/-- Initial factorization and attached first-write realization generated by
the source-owned concrete core. -/
def cofaceFactorizationAndFirstWrite :=
  revolution.core.cofaceFactorization

/-- Canonical initial coface factorization. -/
def initialFactorization :=
  revolution.cofaceFactorizationAndFirstWrite.1

/-- Every lawful factorization into this concrete revised source is the
canonical initial one. -/
theorem initialFactorization_unique
    (morphism : FaithfulCofaceMorphism revolution.minimalCoface
      revolution.core.revision.generate.toAdmissibleMinimalCoface) :
    morphism = revolution.initialFactorization := by
  exact minimal_coface_factorization_unique morphism

/-- Attached direction and exact revised-root first write. -/
def firstWriteRealization :=
  revolution.cofaceFactorizationAndFirstWrite.2

/-- Canonical first-write token of the revised living root. -/
def firstWrite :=
  revolution.firstWriteRealization.firstWrite

/-- The obstruction-generated row is consumed by that exact first write. -/
def firstWriteConsumes :=
  revolution.firstWriteRealization.firstWriteConsumes

/-- Full initial factorization, first-write realization, and both revised
live-row answer-and-next consumers. -/
def twoRowAnswerAndNext :=
  factorizesThroughInitialCofaceAnswerAndNext revolution.core.revision

/-- Migrated old-row answer-and-next. -/
def oldRowAnswerAndNext :=
  revolution.twoRowAnswerAndNext.2.1

/-- New-only obstruction-row answer-and-next. -/
def newRowAnswerAndNext :=
  revolution.twoRowAnswerAndNext.2.2

/-- Both revised rows generate the same downstream current. -/
theorem twoRows_share_generatedNext :
    revolution.oldRowAnswerAndNext.nextCurrent =
      revolution.newRowAnswerAndNext.nextCurrent :=
  rfl

/-- Heterogeneous revised next generated by the new-only row consumer. -/
def revisedNext : AnyAuthoritativeRootCurrent.{u} :=
  ⟨revolution.core.revision.generate.NewN,
    revolution.newRowAnswerAndNext.nextCurrent⟩

end SourceGeneratedRevolutionaryTickAt

end Revision
end Society
end ProcessGame
end SaturationMonoid
