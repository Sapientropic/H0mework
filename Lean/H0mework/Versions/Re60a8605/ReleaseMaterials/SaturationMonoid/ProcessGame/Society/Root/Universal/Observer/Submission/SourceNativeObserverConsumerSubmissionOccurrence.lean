import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Root.Universal.Observer.SourceNativeObserverConsumerExhaustion

/-!
# Source-generated observer / consumer submission occurrences

This module separates an arbitrary observer body from a submitted social
occurrence.  A fixed submission program consumes the exact temporal event of
the existing Society root and emits one proof-carrying material value.  Its
execution token has a private zero-field constructor, following the existing
source inquiry-program pattern.

Different programs are different program-execution occurrences even when they
read the same root event.  The same program at the same temporal event has one
material value and one execution token.  This is the deterministic lower
layer, not by itself a registered ledger occurrence: final Society authority
must additionally consume a source-installed renewal row generated by U8.
A later lower token can be attached through the existing root-generated next
current; that attachment keeps the earlier program output immutable but does
not manufacture the missing row.

No root, ledger, occurrence ontology, registry or completed future is added.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace UniversalRootGrammar

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Observer

universe u v w x

/-! ## Root-fixed authority K and arbitrary body -/

structure SourceNativeObserverRootAuthorityKAt
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    (recognition : SourceNativeDependentFaceFamilyRecognitionAt root) :
    Type (u + 3) where
  visit : SourceNativeTemporalVisitAt
    root.toAuthoritativeRoot.toLedgerRoot
  exactEvent : ExactTemporalCausalRootEventAt
    root.toAuthoritativeRoot.toLedgerRoot visit
  actualAuthority : SourceNativeScenarioActualWriteAuthorityAt
    recognition.law.vocabulary recognition.law.vocabulary.actualScenario
  rootEvolution : SourceNativeLivingRootCausalEvolutionAt root
    (ULift.up visit)

def sourceNativeObserverRootAuthorityKAt
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    (recognition : SourceNativeDependentFaceFamilyRecognitionAt root)
    (event : ExactTemporalCausalRootEvent
      root.toAuthoritativeRoot.toLedgerRoot) :
    SourceNativeObserverRootAuthorityKAt recognition where
  visit := event.1
  exactEvent := event.2
  actualAuthority := .actual
  rootEvolution := root.canonicalCausalAnswerAndNext (ULift.up event.1)

namespace SourceNativeObserverRootAuthorityKAt

variable {N : WorldRelationNetwork.{u}}
  {V : ConstructiveRoot.Vocabulary.{u}}
  {root : SourceNativeLivingRootClosure N V}
  {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
  (authorityK : SourceNativeObserverRootAuthorityKAt recognition)

theorem exactEvent_eq_generated :
    authorityK.exactEvent =
      root.toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit
        authorityK.visit :=
  authorityK.exactEvent.eq_generated

theorem installedAuthority_factorizes :
    authorityK.rootEvolution.generated =
        root.toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit
          authorityK.visit ∧
      HEq (authorityK.rootEvolution.generated.projectionOutcome
          recognition.rootProjection)
        (recognition.law.toProjectionLaw.outcomeAt PUnit.unit
          (root.emitted authorityK.visit.current)) ∧
      authorityK.rootEvolution.nextCurrent =
        root.generatedNextCurrentAt authorityK.visit :=
  authorityK.rootEvolution.installedSubsystemAuthority_factorizes
    recognition.installation PUnit.unit

end SourceNativeObserverRootAuthorityKAt

structure SourceNativeSocietyObserverAt
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    (recognition : SourceNativeDependentFaceFamilyRecognitionAt root)
    (Visible : Type v) : Type (max (u + 2) (v + 1)) where
  forget : ExactTemporalCausalRootEvent
    root.toAuthoritativeRoot.toLedgerRoot → Visible

def SourceNativeSocietyObserverAt.toAuthorityObserver
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {Visible : Type v}
    (observer : SourceNativeSocietyObserverAt recognition Visible) :
    AuthorityObserver
      (ExactTemporalCausalRootEvent
        root.toAuthoritativeRoot.toLedgerRoot)
      Visible (SourceNativeObserverRootAuthorityKAt recognition) where
  forget := observer.forget
  authorityK := sourceNativeObserverRootAuthorityKAt recognition

/-- Arbitrary computation body.  It carries no intent, certificate, source
program, result, failure, write or next. -/
structure SourceNativeObserverConsumerAttemptAt
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    (recognition : SourceNativeDependentFaceFamilyRecognitionAt root)
    (visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot)
    (scenario : recognition.law.vocabulary.Scenario)
    (Visible : Type v) (Output : Type w) (ClaimedEffect : Type x) :
    Type (max (u + 3) (v + 1) (w + 1) (x + 1)) where
  observer : SourceNativeSocietyObserverAt recognition Visible
  readout : OccurrenceReadout
    (ExactTemporalCausalRootEvent
      root.toAuthoritativeRoot.toLedgerRoot) Output
  consumer : Output → ClaimedEffect

namespace SourceNativeObserverConsumerAttemptAt

variable {N : WorldRelationNetwork.{u}}
  {V : ConstructiveRoot.Vocabulary.{u}}
  {root : SourceNativeLivingRootClosure N V}
  {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
  {visit : SourceNativeTemporalVisitAt
    root.toAuthoritativeRoot.toLedgerRoot}
  {scenario : recognition.law.vocabulary.Scenario}
  {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
  (attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
    Visible Output ClaimedEffect)

def exactEvent
    (_body : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect) : ExactTemporalCausalRootEvent
    root.toAuthoritativeRoot.toLedgerRoot :=
  ⟨visit, recognition.exactEventAt visit⟩

def consumedReadout : OccurrenceReadout
    (ExactTemporalCausalRootEvent
      root.toAuthoritativeRoot.toLedgerRoot) ClaimedEffect where
  read := fun event => attempt.consumer (attempt.readout.read event)

def presentedEffect : ClaimedEffect :=
  attempt.consumedReadout.read attempt.exactEvent

end SourceNativeObserverConsumerAttemptAt

