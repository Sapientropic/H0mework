    (attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect) : Type (max (u + 3) v w x) where
  factorization : ReadoutFactorization
    attempt.observer.toAuthorityObserver attempt.consumedReadout
  kernelPair : AuthorityKernelPair attempt.observer.toAuthorityObserver

namespace SourceNativeSubmittedKernelChallengeAt

variable {N : WorldRelationNetwork.{u}}
  {V : ConstructiveRoot.Vocabulary.{u}}
  {root : SourceNativeLivingRootClosure N V}
  {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
  {visit : SourceNativeTemporalVisitAt
    root.toAuthoritativeRoot.toLedgerRoot}
  {scenario : recognition.law.vocabulary.Scenario}
  {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
  {attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
    Visible Output ClaimedEffect}
  (challenge : SourceNativeSubmittedKernelChallengeAt attempt)

def hiddenBearer : HiddenNullWitness
    attempt.observer.toAuthorityObserver.forget
    attempt.observer.toAuthorityObserver.authorityK :=
  authorityKernelPair_hiddenBearer challenge.kernelPair

theorem authorityCompleteEmpty
    (submitted : SourceNativeSubmittedKernelChallengeAt attempt) : IsEmpty
    (AuthorityCompleteReadoutAt
      attempt.observer.toAuthorityObserver attempt.consumedReadout) :=
  authorityKernelPair_factoredReadout_authorityComplete_isEmpty
    submitted.kernelPair submitted.factorization

end SourceNativeSubmittedKernelChallengeAt

theorem submittedCertificateAndKernelChallenge_isEmpty
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    (attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect) :
    IsEmpty (SourceNativeSubmittedEffectCertificateAt attempt ×
      SourceNativeSubmittedKernelChallengeAt attempt) :=
  ⟨fun both => both.2.kernelPair.noAuthorityFactorization
    ⟨both.1.factorization.toAuthorityFactorization both.1.complete⟩⟩

inductive SourceNativeObserverConsumerSubmissionMaterialAt
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    (attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect) : Type (max (u + 3) v w x)
  | presentation
  | authorityCertified
      (certificate : SourceNativeSubmittedEffectCertificateAt attempt)
  | authorityChallenged
      (challenge : SourceNativeSubmittedKernelChallengeAt attempt)
  | authorityUncertified

/-! ## Fixed source program and private execution occurrence -/

/-- One registered submission program.  Its only input is the exact temporal
root occurrence.  Material is recomputed from that event and is not stored in
the execution token. -/
structure SourceNativeObserverConsumerSubmissionProgramAt
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    (attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect) : Type (max (u + 3) v w x) where
  compile : ExactTemporalCausalRootEventAt
    root.toAuthoritativeRoot.toLedgerRoot visit →
      SourceNativeObserverConsumerSubmissionMaterialAt attempt

/-- Private zero-choice execution token of one fixed program at the exact
registered root visit. -/
structure SourceGeneratedObserverConsumerSubmissionAt
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    {attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect}
    (program : SourceNativeObserverConsumerSubmissionProgramAt attempt)
    (material : SourceNativeObserverConsumerSubmissionMaterialAt attempt) :
    Prop where
  private mk ::
  material_eq : material = program.compile (recognition.exactEventAt visit)

namespace SourceNativeObserverConsumerSubmissionProgramAt

theorem generate
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    {attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect}
    (program : SourceNativeObserverConsumerSubmissionProgramAt attempt) :
    SourceGeneratedObserverConsumerSubmissionAt program
      (program.compile (recognition.exactEventAt visit)) :=
  .mk rfl

end SourceNativeObserverConsumerSubmissionProgramAt

namespace SourceGeneratedObserverConsumerSubmissionAt

variable {N : WorldRelationNetwork.{u}}
  {V : ConstructiveRoot.Vocabulary.{u}}
  {root : SourceNativeLivingRootClosure N V}
  {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
  {visit : SourceNativeTemporalVisitAt
    root.toAuthoritativeRoot.toLedgerRoot}
  {scenario : recognition.law.vocabulary.Scenario}
  {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
  {attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
    Visible Output ClaimedEffect}
  {program : SourceNativeObserverConsumerSubmissionProgramAt attempt}
  {submitted : SourceNativeObserverConsumerSubmissionMaterialAt attempt}
  (generated : SourceGeneratedObserverConsumerSubmissionAt program submitted)

instance instSubsingleton :
    Subsingleton
      (SourceGeneratedObserverConsumerSubmissionAt program submitted) :=
  ⟨fun left right => by cases left; cases right; rfl⟩

def exactEvent
    (_submission : SourceGeneratedObserverConsumerSubmissionAt program
      submitted) :
    ExactTemporalCausalRootEventAt
    root.toAuthoritativeRoot.toLedgerRoot visit :=
  recognition.exactEventAt visit

def material
    (_submission : SourceGeneratedObserverConsumerSubmissionAt program
      submitted) :
    SourceNativeObserverConsumerSubmissionMaterialAt attempt :=
  submitted

theorem material_eq_program :
    generated.material = program.compile (recognition.exactEventAt visit) :=
  generated.material_eq

def presentedEffect
    (_submission : SourceGeneratedObserverConsumerSubmissionAt program
      submitted) :
    ClaimedEffect :=
  attempt.presentedEffect

def sourceOccurrence
    (submission : SourceGeneratedObserverConsumerSubmissionAt program
      submitted) :
    ExactTemporalCausalRootEvent
    root.toAuthoritativeRoot.toLedgerRoot :=
  ⟨visit, submission.exactEvent⟩

def rootEvolution
    (_submission : SourceGeneratedObserverConsumerSubmissionAt program
      submitted) :
    SourceNativeLivingRootCausalEvolutionAt root
    (ULift.up visit) :=
  root.canonicalCausalAnswerAndNext (ULift.up visit)

theorem rootLedgerAndNext_factorize :
    generated.rootEvolution.generated =
        root.toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit visit ∧
      HEq (generated.rootEvolution.generated.projectionOutcome
          recognition.rootProjection)
        (recognition.installedFiberAt visit) ∧
      HEq (recognition.wholeLedgerWriteBackAt visit)
        (root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt
          visit.current) ∧
      generated.rootEvolution.nextCurrent = recognition.generatedNextAt
        visit :=
  recognition.installedTraceAuthority_factorizes visit

theorem sameProgram_material_unique
    {leftMaterial rightMaterial :
      SourceNativeObserverConsumerSubmissionMaterialAt attempt}
    (left : SourceGeneratedObserverConsumerSubmissionAt program leftMaterial)
    (right : SourceGeneratedObserverConsumerSubmissionAt program
      rightMaterial) :
    left.material = right.material := by
  exact left.material_eq.trans right.material_eq.symm

end SourceGeneratedObserverConsumerSubmissionAt

/-- Uniform package used only to compare submission occurrences generated by
different fixed programs. -/
structure AnySourceGeneratedObserverConsumerSubmissionAt
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    (attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect) : Type (max (u + 3) v w x) where
  program : SourceNativeObserverConsumerSubmissionProgramAt attempt
  material : SourceNativeObserverConsumerSubmissionMaterialAt attempt
  generated : SourceGeneratedObserverConsumerSubmissionAt program material

def SourceNativeObserverConsumerSubmissionProgramAt.packGenerated
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    {attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect}
    (program : SourceNativeObserverConsumerSubmissionProgramAt attempt) :
    AnySourceGeneratedObserverConsumerSubmissionAt attempt :=
  ⟨program, program.compile (recognition.exactEventAt visit),
    program.generate⟩

theorem generatedSubmission_ne_of_material_ne
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    {attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect}
    (left right : SourceNativeObserverConsumerSubmissionProgramAt attempt)
    (material_ne :
      left.compile (recognition.exactEventAt visit) ≠
        right.compile (recognition.exactEventAt visit)) :
    left.packGenerated ≠ right.packGenerated := by
  intro sameOccurrence
  apply material_ne
  exact congrArg
    AnySourceGeneratedObserverConsumerSubmissionAt.material sameOccurrence

/-! ## One-step generated-next attachment -/

/-- A later program-execution token on the same living root is attached only
when the old root occurrence itself generates its temporal visit as next.
Both tokens remain dependent indices; no future table is stored.  Registration
authority is intentionally absent from this lower interface. -/
structure SourceGeneratedObserverConsumerSubmissionSuccessorAt
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit nextVisit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario nextScenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    {nextVisible : Type v} {nextOutput : Type w}
    {nextClaimedEffect : Type x}
    {attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect}
    {nextAttempt : SourceNativeObserverConsumerAttemptAt recognition nextVisit
      nextScenario nextVisible nextOutput nextClaimedEffect}
    {program : SourceNativeObserverConsumerSubmissionProgramAt attempt}
    {material : SourceNativeObserverConsumerSubmissionMaterialAt attempt}
    (generated : SourceGeneratedObserverConsumerSubmissionAt program material)
    {nextProgram : SourceNativeObserverConsumerSubmissionProgramAt nextAttempt}
    {nextMaterial :
      SourceNativeObserverConsumerSubmissionMaterialAt nextAttempt}
    (nextGenerated : SourceGeneratedObserverConsumerSubmissionAt nextProgram
      nextMaterial) : Prop where
  private mk ::
  generatedNextExact : root.generatedNextCurrentAt visit =
    ⟨V, root.toAuthoritativeRoot, nextVisit⟩

namespace SourceGeneratedObserverConsumerSubmissionSuccessorAt

theorem generate
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit nextVisit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario nextScenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    {nextVisible : Type v} {nextOutput : Type w}
    {nextClaimedEffect : Type x}
    {attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect}
    {nextAttempt : SourceNativeObserverConsumerAttemptAt recognition nextVisit
      nextScenario nextVisible nextOutput nextClaimedEffect}
    {program : SourceNativeObserverConsumerSubmissionProgramAt attempt}
    {material : SourceNativeObserverConsumerSubmissionMaterialAt attempt}
    (generated : SourceGeneratedObserverConsumerSubmissionAt program material)
    {nextProgram : SourceNativeObserverConsumerSubmissionProgramAt nextAttempt}
    {nextMaterial :
      SourceNativeObserverConsumerSubmissionMaterialAt nextAttempt}
    (nextGenerated : SourceGeneratedObserverConsumerSubmissionAt nextProgram
      nextMaterial)
    (generatedNextExact : root.generatedNextCurrentAt visit =
      ⟨V, root.toAuthoritativeRoot, nextVisit⟩) :
    SourceGeneratedObserverConsumerSubmissionSuccessorAt generated
      nextGenerated :=
  .mk generatedNextExact

variable {N : WorldRelationNetwork.{u}}
  {V : ConstructiveRoot.Vocabulary.{u}}
  {root : SourceNativeLivingRootClosure N V}
  {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
  {visit nextVisit : SourceNativeTemporalVisitAt
    root.toAuthoritativeRoot.toLedgerRoot}
  {scenario nextScenario : recognition.law.vocabulary.Scenario}
  {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
  {nextVisible : Type v} {nextOutput : Type w}
  {nextClaimedEffect : Type x}
  {attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
    Visible Output ClaimedEffect}
  {nextAttempt : SourceNativeObserverConsumerAttemptAt recognition nextVisit
    nextScenario nextVisible nextOutput nextClaimedEffect}
  {program : SourceNativeObserverConsumerSubmissionProgramAt attempt}
  {material : SourceNativeObserverConsumerSubmissionMaterialAt attempt}
  {generated : SourceGeneratedObserverConsumerSubmissionAt program material}
  {nextProgram : SourceNativeObserverConsumerSubmissionProgramAt nextAttempt}
  {nextMaterial : SourceNativeObserverConsumerSubmissionMaterialAt nextAttempt}
  {nextGenerated : SourceGeneratedObserverConsumerSubmissionAt nextProgram
    nextMaterial}
  (successor : SourceGeneratedObserverConsumerSubmissionSuccessorAt generated
    nextGenerated)

/-- A later submission cannot retroactively install different material at the
old program occurrence. -/
theorem oldOccurrence_material_immutable
    (_successor :
      SourceGeneratedObserverConsumerSubmissionSuccessorAt generated
        nextGenerated)
    {candidate : SourceNativeObserverConsumerSubmissionMaterialAt attempt}
    (candidateGenerated : SourceGeneratedObserverConsumerSubmissionAt program
      candidate) :
    candidate = material :=
  (SourceGeneratedObserverConsumerSubmissionAt.sameProgram_material_unique
    generated candidateGenerated).symm

end SourceGeneratedObserverConsumerSubmissionSuccessorAt

