import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.UBI.EmploymentIndependentExit

/-!
# Source-accounted disposition of price-captured UBI exits

Price capture does not make responsibility disappear.  Every positive
capture verdict already returns the exact open settlement which indexed the
UBI program.  That settlement exposes its residual bearer and protected
interest, carries the existing source-owned residual incidence, and has the
already activated downstream consumer which generates the payment next.

The interface below is a proposition indexed by one captured code.  It adds
no asset/creditor ontology, actor registry, receipt registry, settlement
ledger, or completed future.  Domain claims such as rent, health-care, or
platform capture must later be generated by their own relation phases.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace UBI
namespace Capture

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Lifecycle Universal Relations Exchange Settlement Price Money Power
open Settlement.SourceOwnedSettlementCompiler

universe u v wa wc x y z q s r e c

variable {Source : Type u} {State : Type v}
variable {occurrenceOf : Source → RootedAccountedUnfolding State}
variable {game : SaturationMonoid.ProcessGame occurrenceOf}
variable {core : SourceOwnedLifecycleCore.{u, v, wa} occurrenceOf game}
variable {V : Vocabulary.{x}}
variable {P : NativeResponsibilityProcess V}
variable {incidence : ActorResponsibilityIncidence core V}
variable
  {exchangeRelationCompiler : SourceOwnedRelationRoleCompiler.{u, v, wa, y}
    occurrenceOf game core.targetFace}
variable
  {exchangeLaw : SourceOwnedExchangeLaw.{u, v, wa, x, y, z}
    core V P incidence exchangeRelationCompiler}
variable
  {settlementCompiler : SourceOwnedSettlementCompiler.{u, v, wa, x, y, z, q}
    exchangeLaw}
variable
  {activationCompiler :
    SourceOwnedResidualConsumerCompiler.{u, v, wa, x, y, z, q, s}
      settlementCompiler}

variable {controllerFace : M0BoundaryFace.{u, v, wc} occurrenceOf}
variable
  {exitRelationCompiler : SourceOwnedRelationRoleCompiler.{u, v, wa, e}
    occurrenceOf game core.targetFace}
variable
  {employmentController : SourceOwnedActionControllerCompiler.{u, v, wc, c}
    game controllerFace}
variable [Zero (exitRelationCompiler.Phase game.source)]

variable {paymentSeed : activationCompiler.ExactActivationSeed}
variable {PriceValue : Type r}
variable {observer : ExchangePriceObserverAt
  (settlementCompiler := settlementCompiler)
  (paymentSeed.occurrence activationCompiler) PriceValue}
variable {employer : employmentController.Actor}
variable {worker : exitRelationCompiler.Actor}
variable {employment exitRelation : exitRelationCompiler.GeneratedRelation}
variable {capture : SourceOwnedPriceCaptureCompilerAt exitRelationCompiler
  (OpenSettlementAt settlementCompiler
    (paymentSeed.occurrence activationCompiler))
  (exactOpenSettlement paymentSeed)}
variable {program : ExitCapacityProgramAt paymentSeed observer employer worker
  employment exitRelation capture}

/-- Complete responsibility disposition of one captured code.  All data
fields are propositions or `Nonempty` witnesses, so this cannot become a
parallel receipt carrier. -/
structure SourceAccountedCaptureDispositionAt
    (program : ExitCapacityProgramAt paymentSeed observer employer worker
      employment exitRelation capture)
    (code : exitRelationCompiler.FutureCode)
    (captured : capture.Captures code) : Prop where
  private mk ::
  exactSettlement :
    capture.captureSettlement code captured = exactOpenSettlement paymentSeed
  bearerRetained :
    OpenSettlementAt.residualBearer
        (capture.captureSettlement code captured) =
      OpenSettlementAt.residualBearer (exactOpenSettlement paymentSeed)
  residualRetained :
    OpenSettlementAt.residual (capture.captureSettlement code captured) =
      OpenSettlementAt.residual (exactOpenSettlement paymentSeed)
  beneficiaryGenerated :
    OpenSettlementAt.protectedInterest
        (capture.captureSettlement code captured) =
      exchangeLaw.protectedInterestOfActor
        (exactCounterpartyActor paymentSeed)
  acceptingCounterpartyBearerGenerated :
    (exactCounterpartyObligation paymentSeed).bearer =
      exchangeLaw.bearerOfActor (exactCounterpartyActor paymentSeed)
  priceDomainExact :
    program.purchasingPowerStanding.priceObservation.openSettlement =
      exactOpenSettlement paymentSeed
  activatedResidualConsumer :
    Nonempty (OpenSettlementAt.ActivatedResidualConsumerAt
      (exactOpenSettlement paymentSeed))
  sourceOwnedResidual :
    Nonempty (SourceOwnsResponsibilityIncidence V
      (P.boundarySource
        program.purchasingPowerStanding.activatedConsumer.activation)
      (exactOpenSettlement paymentSeed).obligation)
  consumerNextIsPaymentNext :
    program.purchasingPowerStanding.activatedConsumer.nextGeneratedState =
      program.payment.nextGenerated

namespace SourceAccountedCaptureDispositionAt

/-- Sole generic producer.  A caller supplies only the already generated
capture verdict; every responsibility field is read from the indexed source
program and its exact open settlement. -/
theorem generate
    (program : ExitCapacityProgramAt paymentSeed observer employer worker
      employment exitRelation capture)
    (code : exitRelationCompiler.FutureCode)
    (captured : capture.Captures code) :
    SourceAccountedCaptureDispositionAt program code captured := by
  have settlementEq :
      capture.captureSettlement code captured = exactOpenSettlement paymentSeed :=
    capture.captureSettlement_eq code captured
  refine ⟨settlementEq, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact congrArg OpenSettlementAt.residualBearer settlementEq
  · exact congrArg OpenSettlementAt.residual settlementEq
  · rw [settlementEq]
    exact program.purchasingPowerStanding.counterpartyAcceptance
      |>.tenderBeneficiary_eq
  · exact program.purchasingPowerStanding.counterpartyAcceptance
      |>.reciprocalBearer_eq
  · exact program.purchasingPowerStanding.price_open_eq
  · exact ⟨program.purchasingPowerStanding.activatedConsumer⟩
  · exact ⟨program.purchasingPowerStanding.sourceOwnership⟩
  · calc
      program.purchasingPowerStanding.activatedConsumer.nextGeneratedState =
          PurchasingPowerStandingAt.nextGeneratedState
            program.purchasingPowerStanding :=
        PurchasingPowerStandingAt.activatedConsumer_nextGenerated_exact _
      _ = program.payment.nextGenerated := program.payment.next_eq.symm

end SourceAccountedCaptureDispositionAt

end Capture
end UBI
end Society
end ProcessGame
end SaturationMonoid

#print axioms SaturationMonoid.ProcessGame.Society.UBI.Capture.SourceAccountedCaptureDispositionAt.generate
