import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Money.PurchasingPowerStanding

/-!
# Source-owned payment purpose

A payment purpose is not a string, sector label, or observer classification.
It is a source-law map from an exact residual-consumer activation to an exact
relation seed in the same process-game occurrence.  The mapped relation seed
must generate the payment's accepting counterparty actor.

The compiler stores no payment result, price, capture verdict, sector value,
ledger, registry, or completed future.  It only fixes which already exact
relation incidence gives the payment its purpose.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace UBI
namespace Capture

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Lifecycle Universal Relations Exchange Settlement Price Money
open Settlement.SourceOwnedSettlementCompiler

universe u v w x y z q s p

variable {Source : Type u} {State : Type v}
variable {occurrenceOf : Source → RootedAccountedUnfolding State}
variable {game : SaturationMonoid.ProcessGame occurrenceOf}
variable {core : SourceOwnedLifecycleCore.{u, v, w} occurrenceOf game}
variable {V : Vocabulary.{x}}
variable {P : NativeResponsibilityProcess V}
variable {incidence : ActorResponsibilityIncidence core V}
variable
  {exchangeRelationCompiler : SourceOwnedRelationRoleCompiler.{u, v, w, y}
    occurrenceOf game core.targetFace}
variable
  {exchangeLaw : SourceOwnedExchangeLaw.{u, v, w, x, y, z}
    core V P incidence exchangeRelationCompiler}
variable
  {settlementCompiler : SourceOwnedSettlementCompiler.{u, v, w, x, y, z, q}
    exchangeLaw}
variable
  {activationCompiler :
    SourceOwnedResidualConsumerCompiler.{u, v, w, x, y, z, q, s}
      settlementCompiler}
variable
  {purposeRelationCompiler : SourceOwnedRelationRoleCompiler.{u, v, w, p}
    occurrenceOf game core.targetFace}

/-- Source-law incidence from each exact payment activation to the exact
relation which gives that payment its purpose.  The equality is between two
actors already generated by the common M0 actor face; no actor or purpose is
accepted by the downstream producer. -/
structure SourceOwnedPaymentPurposeCompiler where
  purposeSeed : activationCompiler.ExactActivationSeed →
    purposeRelationCompiler.ExactRelationSeed
  purposeActor_eq : ∀ paymentSeed,
    (purposeSeed paymentSeed).actor purposeRelationCompiler =
      exactCounterpartyActor paymentSeed

namespace SourceOwnedPaymentPurposeCompiler

variable
  (compiler : SourceOwnedPaymentPurposeCompiler
    (activationCompiler := activationCompiler)
    (purposeRelationCompiler := purposeRelationCompiler))

/-- Relation generated by the source-selected purpose seed. -/
def purposeRelation
    (paymentSeed : activationCompiler.ExactActivationSeed) :
    purposeRelationCompiler.GeneratedRelation :=
  purposeRelationCompiler.relationOf (compiler.purposeSeed paymentSeed)

/-- Purpose phase read directly from the selected relation lineage. -/
def purposePhase
    (paymentSeed : activationCompiler.ExactActivationSeed) :
    purposeRelationCompiler.Phase game.source :=
  purposeRelationCompiler.phaseStep (compiler.purposeRelation paymentSeed)

/-- Target role generated by the selected relation lineage and its phase. -/
def purposeTargetRole
    (paymentSeed : activationCompiler.ExactActivationSeed) :
    purposeRelationCompiler.Role game.source :=
  purposeRelationCompiler.roleAt (compiler.purposeRelation paymentSeed) .target

/-- The purpose relation and accepting counterparty are the image of the
compiler-selected exact relation seed. -/
theorem purposeInterest
    (paymentSeed : activationCompiler.ExactActivationSeed) :
    purposeRelationCompiler.GeneratedInterestAt
      (exactCounterpartyActor paymentSeed)
      (compiler.purposeRelation paymentSeed) :=
  ⟨compiler.purposeSeed paymentSeed,
    compiler.purposeActor_eq paymentSeed, rfl⟩

theorem purposeTargetRole_generated
    (paymentSeed : activationCompiler.ExactActivationSeed) :
    purposeRelationCompiler.RelationRoleAt
      (exactCounterpartyActor paymentSeed)
      (compiler.purposeRelation paymentSeed) .target
      (compiler.purposeTargetRole paymentSeed) :=
  ⟨compiler.purposeInterest paymentSeed, rfl⟩

/-- Exact source-generated payment-purpose incidence.  Both the activation
and purpose relation retain their own trace witnesses in the same fixed game
occurrence and meet at the same generated counterparty actor. -/
structure SourceGeneratedPaymentPurposeAt
    (paymentSeed : activationCompiler.ExactActivationSeed) : Prop where
  private mk ::
  paymentSource :
    ∃ state ∈ game.occurrence.trace,
      state = core.targetFace.state game.source ∧
        activationCompiler.activationAdmittedAt paymentSeed.1
  purposeSource :
    ∃ state ∈ game.occurrence.trace,
      state = core.targetFace.state game.source ∧
        purposeRelationCompiler.relationSeedAt game.source state
          (compiler.purposeSeed paymentSeed).1 ∧
        core.targetFace.SeedAt game.source state
          (purposeRelationCompiler.beneficiaryActorSeed
            (compiler.purposeSeed paymentSeed).1)
  purposeInterest :
    purposeRelationCompiler.GeneratedInterestAt
      (exactCounterpartyActor paymentSeed)
      (compiler.purposeRelation paymentSeed)
  purposeTargetRole :
    purposeRelationCompiler.RelationRoleAt
      (exactCounterpartyActor paymentSeed)
      (compiler.purposeRelation paymentSeed) .target
      (compiler.purposeTargetRole paymentSeed)

namespace SourceGeneratedPaymentPurposeAt

/-- Sole producer.  The caller supplies only an exact payment seed; the
source compiler chooses the purpose seed, relation, actor, phase, and role. -/
theorem generate
    (paymentSeed : activationCompiler.ExactActivationSeed) :
    compiler.SourceGeneratedPaymentPurposeAt paymentSeed where
  paymentSource := paymentSeed.exact_state_provenance activationCompiler
  purposeSource :=
    (compiler.purposeSeed paymentSeed).exact_state_provenance
      purposeRelationCompiler
  purposeInterest := compiler.purposeInterest paymentSeed
  purposeTargetRole := compiler.purposeTargetRole_generated paymentSeed

theorem exact_relation_actor_provenance
    {paymentSeed : activationCompiler.ExactActivationSeed}
    (purpose : compiler.SourceGeneratedPaymentPurposeAt paymentSeed) :
    ∃ seed : purposeRelationCompiler.ExactRelationSeed,
      (∃ state ∈ game.occurrence.trace,
        state = core.targetFace.state game.source ∧
          purposeRelationCompiler.relationSeedAt game.source state seed.1 ∧
          core.targetFace.SeedAt game.source state
            (purposeRelationCompiler.beneficiaryActorSeed seed.1)) ∧
      seed.actor purposeRelationCompiler = exactCounterpartyActor paymentSeed ∧
      purposeRelationCompiler.relationOf seed =
        compiler.purposeRelation paymentSeed :=
  purpose.purposeInterest.exact_state_provenance

end SourceGeneratedPaymentPurposeAt
end SourceOwnedPaymentPurposeCompiler

end Capture
end UBI
end Society
end ProcessGame
end SaturationMonoid

#print axioms SaturationMonoid.ProcessGame.Society.UBI.Capture.SourceOwnedPaymentPurposeCompiler.SourceGeneratedPaymentPurposeAt.generate
