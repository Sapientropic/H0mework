import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Space.SourceGeneratedCrossing
import Mathlib.Logic.Relation

/-!
# Generated social space

Social space is a zero-choice seal over one source-owned crossing compiler.
Its crossing trace is exactly the canonical M10 queue map.  Adjacency means
that an exact crossing has the requested endpoints, accessibility is exactly
the reflexive-transitive closure of that relation, and flow is the full fibre
of exact crossing occurrences over two endpoints.  Boundary certificates are
read directly from the compiler's source classifier.

No graph, territory, site registry, boundary registry, adjacency relation, or
crossing list is accepted from a caller.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace Space

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Capacity

universe uSource uState uSeed uLineage uUnit
universe uSiteSeed uSiteLineage uFlow
universe uBoundarySeed uBoundaryLineage uBoundaryClass uCarrier

variable {Source : Type uSource}
variable {State : Type uState}
variable {occurrenceOf : Source → RootedAccountedUnfolding State}
variable {game : SaturationMonoid.ProcessGame occurrenceOf}
variable {Seed : Type uSeed}
variable {SeedAt : Source → State → Seed → Prop}
variable {Lineage : Source → Type uLineage}
variable {lineageOf : ∀ source,
  SourceSeed occurrenceOf Seed SeedAt source → Lineage source}
variable {focal : SourceSeed occurrenceOf Seed SeedAt game.source}
variable {rateCompiler : SourceOwnedOccurrenceRateCompiler
  game Seed SeedAt Lineage lineageOf focal}
variable {compiler : SourceOwnedCrossingCompiler rateCompiler}

noncomputable section

/-- Zero-field seal witnessing the unique social space generated by a fixed
crossing compiler. -/
inductive SourceGeneratedSocialSpaceAt
    (compiler : SourceOwnedCrossingCompiler rateCompiler) : Type where
  | private generated

namespace SourceGeneratedSocialSpaceAt

/-- Sole producer of the social-space seal. -/
def generate (compiler : SourceOwnedCrossingCompiler rateCompiler) :
    SourceGeneratedSocialSpaceAt compiler :=
  .generated

/-- There is no caller choice of social space for one compiler. -/
theorem eq_generate (space : SourceGeneratedSocialSpaceAt compiler) :
    space = generate compiler := by
  cases space
  rfl

variable (space : SourceGeneratedSocialSpaceAt compiler)

/-- Canonical exact crossing trace generated by the M10 queue map. -/
def crossingTrace
    (_space : SourceGeneratedSocialSpaceAt compiler) :
    List compiler.ExactCrossing :=
  compiler.crossingTrace

theorem crossingTrace_eq_canonical_queue_map :
    space.crossingTrace =
      rateCompiler.queue.map compiler.exactCrossingOf :=
  rfl

theorem crossingTrace_nodup : space.crossingTrace.Nodup :=
  SourceOwnedCrossingCompiler.crossingTrace_nodup compiler

/-- Every exact crossing occurs in this generated space's canonical trace. -/
theorem exactCrossing_mem (crossing : compiler.ExactCrossing) :
    crossing ∈ space.crossingTrace :=
  SourceOwnedCrossingCompiler.exactCrossing_mem compiler crossing

/-- Directed adjacency is generated only by an exact crossing occurrence. -/
def Adjacent
    (_space : SourceGeneratedSocialSpaceAt compiler)
    (origin target : compiler.Site) : Prop :=
  ∃ crossing : compiler.ExactCrossing,
    crossing.originSite compiler = origin ∧
      crossing.targetSite compiler = target

theorem adjacent_iff_exact_crossing
    (origin target : compiler.Site) :
    space.Adjacent origin target ↔
      ∃ crossing : compiler.ExactCrossing,
        crossing.originSite compiler = origin ∧
          crossing.targetSite compiler = target :=
  Iff.rfl

/-- The adjacency witness is not merely a queue subtype: it is present in the
canonical crossing trace generated by this same compiler. -/
theorem adjacent_iff_crossingTrace
    (origin target : compiler.Site) :
    space.Adjacent origin target ↔
      ∃ crossing : compiler.ExactCrossing,
        crossing ∈ space.crossingTrace ∧
          crossing.originSite compiler = origin ∧
            crossing.targetSite compiler = target := by
  constructor
  · rintro ⟨crossing, originEq, targetEq⟩
    exact ⟨crossing, space.exactCrossing_mem crossing, originEq, targetEq⟩
  · rintro ⟨crossing, _crossingMem, originEq, targetEq⟩
    exact ⟨crossing, originEq, targetEq⟩

/-- Accessibility is exactly the reflexive-transitive closure of generated
adjacency. -/
def Accessible
    (_space : SourceGeneratedSocialSpaceAt compiler)
    (origin target : compiler.Site) : Prop :=
  Relation.ReflTransGen _space.Adjacent origin target

theorem accessible_iff_reflTransGen
    (origin target : compiler.Site) :
    space.Accessible origin target ↔
      Relation.ReflTransGen space.Adjacent origin target :=
  Iff.rfl

theorem accessible_refl (site : compiler.Site) :
    space.Accessible site site :=
  .refl

theorem adjacent_accessible {origin target : compiler.Site}
    (adjacent : space.Adjacent origin target) :
    space.Accessible origin target :=
  .single adjacent

theorem accessible_trans {origin middle target : compiler.Site}
    (first : space.Accessible origin middle)
    (second : space.Accessible middle target) :
    space.Accessible origin target :=
  first.trans second

/-- Least reflexive-transitive universal property.  Any reflexive and
transitive relation containing generated adjacency contains accessibility. -/
theorem accessible_least
    (relation : compiler.Site → compiler.Site → Prop)
    (relation_refl : ∀ site, relation site site)
    (relation_trans : ∀ {origin middle target},
      relation origin middle → relation middle target →
        relation origin target)
    (contains_adjacent : ∀ {origin target},
      space.Adjacent origin target → relation origin target) :
    space.Accessible ≤ relation := by
  intro origin target accessible
  induction accessible with
  | refl => exact relation_refl origin
  | tail first last inductionHypothesis =>
      exact relation_trans inductionHypothesis (contains_adjacent last)

/-- Full flow fibre over two generated sites.  Distinct exact occurrences are
not quotiented merely because their endpoints coincide. -/
def FlowAt
    (_space : SourceGeneratedSocialSpaceAt compiler)
    (origin target : compiler.Site) :=
  { crossing : compiler.ExactCrossing //
    crossing.originSite compiler = origin ∧
      crossing.targetSite compiler = target }

theorem nonempty_flowAt_iff_adjacent
    (origin target : compiler.Site) :
    Nonempty (space.FlowAt origin target) ↔
      space.Adjacent origin target := by
  constructor
  · rintro ⟨flow⟩
    exact ⟨flow.1, flow.2⟩
  · rintro ⟨crossing, endpoints⟩
    exact ⟨⟨crossing, endpoints⟩⟩

namespace FlowAt

variable {origin target : compiler.Site}
variable (flow : space.FlowAt origin target)

/-- Exact crossing occurrence retained by this endpoint fibre. -/
def crossing : compiler.ExactCrossing := flow.1

theorem crossing_mem : flow.crossing ∈ space.crossingTrace :=
  space.exactCrossing_mem flow.crossing

theorem origin_eq : flow.crossing.originSite compiler = origin :=
  flow.2.1

theorem target_eq : flow.crossing.targetSite compiler = target :=
  flow.2.2

/-- Payload is read from the retained exact crossing, never assigned to a
pre-existing graph edge. -/
def payload : compiler.FlowPayloadAt flow.crossing :=
  flow.crossing.flowPayload compiler

/-- Projection to the exact crossing is injective on every endpoint fibre. -/
theorem crossing_injective :
    Function.Injective
      (fun flow : space.FlowAt origin target => flow.crossing) := by
  intro left right crossingEq
  exact Subtype.ext crossingEq

/-- Even in one common endpoint fibre, distinct source-trace positions remain
distinct flow occurrences. -/
theorem ne_of_position_ne
    {left right : space.FlowAt origin target}
    (position_ne :
      Capacity.SourceOwnedOccurrenceRateCompiler.ExactQueueUnit.position
          rateCompiler left.crossing ≠
        Capacity.SourceOwnedOccurrenceRateCompiler.ExactQueueUnit.position
          rateCompiler right.crossing) :
    left ≠ right := by
  intro flowEq
  exact position_ne (congrArg
    (fun flow : space.FlowAt origin target =>
      Capacity.SourceOwnedOccurrenceRateCompiler.ExactQueueUnit.position
        rateCompiler flow.crossing) flowEq)

end FlowAt

/-- Boundary-certificate readout produced by the compiler's classifier over
the canonical crossing trace. -/
def boundaryCertificates
    (_space : SourceGeneratedSocialSpaceAt compiler) :
    List compiler.AnyBoundaryCertificate :=
  compiler.boundaryCertificates

theorem boundaryCertificates_eq_source_filterMap :
    space.boundaryCertificates =
      compiler.crossingTrace.filterMap
        compiler.boundaryCertificateEntry? :=
  rfl

/-- Every boundary readout recovers its exact crossing and its source-derived
boundary seed; no registry lookup is involved. -/
theorem boundaryCertificate_provenance
    (certificate : compiler.AnyBoundaryCertificate)
    (membership : certificate ∈ space.boundaryCertificates) :
    certificate.crossing ∈ space.crossingTrace ∧
      compiler.boundaryCertificate? certificate.crossing =
        some certificate.proof :=
  SourceOwnedCrossingCompiler.AnyBoundaryCertificate.provenance
    compiler certificate membership

/-- M11 folds are the M10 canonical queue fold with each queue unit upgraded
to its exact crossing. -/
def canonicalFoldReadout
    (_space : SourceGeneratedSocialSpaceAt compiler)
    {Carrier : Type uCarrier}
    (initial : Carrier)
    (step : compiler.ExactCrossing → Carrier → Carrier) :
    rateCompiler.CanonicalQueueFoldReadout initial
      (fun unit accumulated =>
        step (compiler.exactCrossingOf unit) accumulated) :=
  Capacity.SourceOwnedOccurrenceRateCompiler.CanonicalQueueFoldReadout.generate
    rateCompiler

/-- The readout value is definitionally the fold over the generated crossing
trace, not a separately supplied spatial aggregate. -/
theorem canonicalFoldReadout_value_eq_crossingTrace_foldr
    {Carrier : Type uCarrier}
    (initial : Carrier)
    (step : compiler.ExactCrossing → Carrier → Carrier) :
    Capacity.SourceOwnedOccurrenceRateCompiler.CanonicalQueueFoldReadout.value
        rateCompiler (space.canonicalFoldReadout initial step) =
      space.crossingTrace.foldr step initial := by
  change rateCompiler.queue.foldr
      (fun unit accumulated =>
        step (compiler.exactCrossingOf unit) accumulated) initial =
    (rateCompiler.queue.map compiler.exactCrossingOf).foldr step initial
  rw [List.foldr_map]

/-- Canonical fold tokens are unique because they are exactly M10 canonical
queue-fold readouts. -/
theorem canonicalFoldReadout_unique
    {Carrier : Type uCarrier}
    (initial : Carrier)
    (step : compiler.ExactCrossing → Carrier → Carrier)
    (readout : rateCompiler.CanonicalQueueFoldReadout initial
      (fun unit accumulated =>
        step (compiler.exactCrossingOf unit) accumulated)) :
    readout = space.canonicalFoldReadout initial step := by
  rw [Capacity.SourceOwnedOccurrenceRateCompiler.CanonicalQueueFoldReadout.eq_generated
    rateCompiler readout]

end SourceGeneratedSocialSpaceAt

end
end Space
end Society
end ProcessGame
end SaturationMonoid
