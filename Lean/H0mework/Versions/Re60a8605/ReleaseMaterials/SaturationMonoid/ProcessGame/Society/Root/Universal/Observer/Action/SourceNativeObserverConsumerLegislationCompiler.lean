import H0mework.Foundation.Inquiry.Protocol

/-!
# Source-installed observer / consumer legislation

Observer use has three authority dispositions: presentation, rooted authority,
and typed rejection.  A rooted use does not automatically write the world.
It is submitted to one inquiry program installed at the same root before
emission.  That program may answer under the current law, generate an actual
sequential action, or generate the sole same-occurrence U8 realization.

The public compiler consumes only a private execution token.  It accepts no
answer, action, failure, U8 core, installed face, or branch equation.  Its
four public classes are lawful presentation, typed rejection, installed
actual action, and same-occurrence U8.  The first class includes a rooted
inquiry that current law can already answer.  Hence world writing implies
rooted authority, while rooted authority need not write the world.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace UniversalRootGrammar

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open ConstructiveRoot.RootInquiryCompletion

universe u v w x

/-- A zero-information query at the root universe. -/
abbrev SourceNativeObserverLegislationQuery : Type u :=
  ULift.{u, 0} Unit

def sourceNativeObserverLegislationQuery :
    SourceNativeObserverLegislationQuery.{u} :=
  ULift.up ()

/-! ## Unified pre-emitter program and private execution -/

/-- One pre-emitter source-program identity simultaneously fixes the observer
submission program and its legislation inquiry program.  A second value at
the same lower submission program is a different source-program occurrence;
it cannot be selected after execution because the generated token below is
indexed by this complete bundle.

The literal inquiry output, including any sequential action or U8 core, is
already installed as a root inquiry face. -/
structure SourceNativeObserverConsumerLegislationProgramAt
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    {attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect}
    (submissionProgram :
      SourceNativeObserverConsumerSubmissionProgramAt attempt) :
    Type (max (u + 12) v w x) where
  entry : OpenResponsibilityAt N
    (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
      (root.emitted visit.current))
  entryAuthority : SourceNativeLivingTemporalCausalEntryAuthorityAt
    root visit entry
  U7 : U7ProducerCalculus N
  calculus : U7ObstructionEvolutionCalculus N U7
  inquiryProgram : SourceNativeInquiryCompilationProgramAt
    root visit U7 calculus root.toAuthoritativeRoot.source.lawSurface
    sourceNativeObserverLegislationQuery
    (ULift.up.{u + 1, u} (root.emitted visit.current))
    entry entryAuthority
  installedFace : SourceNativeRootInquiryCompilationFaceCoreAt
    root visit sourceNativeObserverLegislationQuery
    (ULift.up.{u + 1, u} (root.emitted visit.current))
    entry entryAuthority inquiryProgram.generate.output

/-- Private zero-choice execution token of the complete pre-emitter bundle.
It stores neither submission material nor inquiry output. -/
structure SourceGeneratedObserverConsumerLegislationAt
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    {attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect}
    {submissionProgram :
      SourceNativeObserverConsumerSubmissionProgramAt attempt}
    (program : SourceNativeObserverConsumerLegislationProgramAt
      submissionProgram) :
    Type (max (u + 12) v w x) where
  private mk ::

namespace SourceNativeObserverConsumerLegislationProgramAt

/-- The base submission is generated by the submission program already fixed
in the complete bundle's type. -/
theorem generatedSubmission
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    {attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect}
    {submissionProgram :
      SourceNativeObserverConsumerSubmissionProgramAt attempt}
    (_program : SourceNativeObserverConsumerLegislationProgramAt
      submissionProgram) :
    SourceGeneratedObserverConsumerSubmissionAt submissionProgram
      (submissionProgram.compile (recognition.exactEventAt visit)) :=
  submissionProgram.generate

/-- Execute the complete source program.  No generated submission, source
component, branch, or completed output is an argument. -/
def generate
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    {attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect}
    {submissionProgram :
      SourceNativeObserverConsumerSubmissionProgramAt attempt}
    (program : SourceNativeObserverConsumerLegislationProgramAt
      submissionProgram) :
    SourceGeneratedObserverConsumerLegislationAt program :=
  .mk

end SourceNativeObserverConsumerLegislationProgramAt

namespace SourceGeneratedObserverConsumerLegislationAt

/-- Readout of the base submission generated by the same complete bundle. -/
theorem submission
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    {attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect}
    {submissionProgram :
      SourceNativeObserverConsumerSubmissionProgramAt attempt}
    {program : SourceNativeObserverConsumerLegislationProgramAt
      submissionProgram}
    (_execution : SourceGeneratedObserverConsumerLegislationAt program) :
    SourceGeneratedObserverConsumerSubmissionAt submissionProgram
      (submissionProgram.compile (recognition.exactEventAt visit)) :=
  program.generatedSubmission

/-- Readout of the face installed before execution. -/
def installedCompilationFace
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    {attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect}
    {submissionProgram :
      SourceNativeObserverConsumerSubmissionProgramAt attempt}
    {program : SourceNativeObserverConsumerLegislationProgramAt
      submissionProgram}
    (_execution : SourceGeneratedObserverConsumerLegislationAt program) :
    SourceNativeRootInquiryCompilationFaceCoreAt
      root visit sourceNativeObserverLegislationQuery
      (ULift.up.{u + 1, u} (root.emitted visit.current))
      program.entry program.entryAuthority
      program.inquiryProgram.generate.output :=
  program.installedFace

end SourceGeneratedObserverConsumerLegislationAt

/-! ## Exact dependent compilation -/

/-- Exact result indexed simultaneously by observer authority disposition and
the installed inquiry program output.  Answering branches are lawful
presentation, not world writes.  Action and U8 constructors carry the
existing generated producer tokens rather than caller-selected payloads. -/
inductive SourceNativeCompiledObserverConsumerLegislationAt
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    {attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect}
    {submissionProgram :
      SourceNativeObserverConsumerSubmissionProgramAt attempt}
    {program : SourceNativeObserverConsumerLegislationProgramAt
      submissionProgram}
    (execution : SourceGeneratedObserverConsumerLegislationAt program) :
    SourceNativeObserverConsumerUseDispositionAt program.generatedSubmission →
      SourceNativeInquiryCompilationAt
        root visit program.U7 program.calculus
        root.toAuthoritativeRoot.source.lawSurface
        sourceNativeObserverLegislationQuery
        (ULift.up.{u + 1, u} (root.emitted visit.current))
        program.entry program.entryAuthority →
      Type (max (u + 12) v w x)
  | observerPresentation :
      SourceNativeCompiledObserverConsumerLegislationAt execution
        .presentation program.inquiryProgram.generate.output
  | rejected
      (rejection : SourceNativeObserverConsumerRejectionAt
        program.generatedSubmission) :
      SourceNativeCompiledObserverConsumerLegislationAt execution
        (.rejected rejection) program.inquiryProgram.generate.output
  | rootedAnswered
      (rooted : SourceNativeObserverConsumerRootedAuthorityAt
        program.generatedSubmission)
      (answerFace : SourceNativeRootSemanticFaceAt root visit)
      (consumer : SourceNativeInquiryAnswerConsumerAt
        sourceNativeObserverLegislationQuery
        (ULift.up.{u + 1, u} (root.emitted visit.current))
        program.entry answerFace)
      (outputExact :
        ((.answered answerFace consumer) : SourceNativeInquiryCompilationAt
          root visit program.U7 program.calculus
          root.toAuthoritativeRoot.source.lawSurface
          sourceNativeObserverLegislationQuery
          (ULift.up.{u + 1, u} (root.emitted visit.current))
          program.entry program.entryAuthority) =
            program.inquiryProgram.generate.output) :
      SourceNativeCompiledObserverConsumerLegislationAt execution
        (.rooted rooted) (.answered answerFace consumer)
  | rootedU7Answered
      (rooted : SourceNativeObserverConsumerRootedAuthorityAt
        program.generatedSubmission)
      (obstruction : N.ObstructionAt
        (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
          (root.emitted visit.current)))
      (u7Disposition : SourceNativeU7AnswersAt program.calculus obstruction)
      (answerFace : SourceNativeRootSemanticFaceAt root visit)
      (consumer : SourceNativeInquiryAnswerConsumerAt
        sourceNativeObserverLegislationQuery
        (ULift.up.{u + 1, u} (root.emitted visit.current))
        program.entry answerFace)
      (outputExact :
        ((.u7Answered obstruction u7Disposition answerFace consumer) :
          SourceNativeInquiryCompilationAt
            root visit program.U7 program.calculus
            root.toAuthoritativeRoot.source.lawSurface
            sourceNativeObserverLegislationQuery
            (ULift.up.{u + 1, u} (root.emitted visit.current))
            program.entry program.entryAuthority) =
              program.inquiryProgram.generate.output) :
      SourceNativeCompiledObserverConsumerLegislationAt execution
        (.rooted rooted)
        (.u7Answered obstruction u7Disposition answerFace consumer)
  | rootedOldLanguageAnswered
      (rooted : SourceNativeObserverConsumerRootedAuthorityAt
        program.generatedSubmission)
      (obstruction : N.ObstructionAt
        (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
          (root.emitted visit.current)))
      (gate : SourceNativeU7TheoryAuditAt program.calculus
        (program.calculus.generated obstruction).1)
      (oldAnswer : OldLanguageAnswerAt
        root.toAuthoritativeRoot.source.lawSurface obstruction)
      (answerFace : SourceNativeRootSemanticFaceAt root visit)
      (consumer : SourceNativeInquiryAnswerConsumerAt
        sourceNativeObserverLegislationQuery
        (ULift.up.{u + 1, u} (root.emitted visit.current))
        program.entry answerFace)
      (outputExact :
        ((.oldLanguageAnswered obstruction gate oldAnswer answerFace
          consumer) : SourceNativeInquiryCompilationAt
            root visit program.U7 program.calculus
            root.toAuthoritativeRoot.source.lawSurface
            sourceNativeObserverLegislationQuery
            (ULift.up.{u + 1, u} (root.emitted visit.current))
            program.entry program.entryAuthority) =
              program.inquiryProgram.generate.output) :
      SourceNativeCompiledObserverConsumerLegislationAt execution
        (.rooted rooted)
        (.oldLanguageAnswered obstruction gate oldAnswer answerFace consumer)
  | installedAction
      (rooted : SourceNativeObserverConsumerRootedAuthorityAt
        program.generatedSubmission)
      {actionProgram : SourceNativeSequentialActualActionProgramAt
        root visit program.entry program.entryAuthority}
      {sourceEvent : ExactTemporalCausalRootEventAt
        root.toAuthoritativeRoot.toLedgerRoot visit}
      (action : SourceGeneratedSequentialActualActionAt actionProgram
        sourceEvent)
      (outputExact :
        ((.actualAction action) : SourceNativeInquiryCompilationAt
          root visit program.U7 program.calculus
          root.toAuthoritativeRoot.source.lawSurface
          sourceNativeObserverLegislationQuery
          (ULift.up.{u + 1, u} (root.emitted visit.current))
          program.entry program.entryAuthority) =
            program.inquiryProgram.generate.output) :
      SourceNativeCompiledObserverConsumerLegislationAt execution
        (.rooted rooted) (.actualAction action)
  | sameOccurrenceU8
      (rooted : SourceNativeObserverConsumerRootedAuthorityAt
        program.generatedSubmission)
      (obstruction : N.ObstructionAt
        (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
          (root.emitted visit.current)))
      (gate : SourceNativeU7TheoryAuditAt program.calculus
        (program.calculus.generated obstruction).1)
      (failure : ActualExpressibilityFailure
        root.toAuthoritativeRoot.source.lawSurface obstruction)
      (core : SourceGeneratedInquiryU8RevisionCoreAt
        root visit program.U7 program.calculus
        root.toAuthoritativeRoot.source.lawSurface
        sourceNativeObserverLegislationQuery
        (ULift.up.{u + 1, u} (root.emitted visit.current))
        program.entry program.entryAuthority obstruction gate failure)
      (outputExact :
        ((.requiresU8 obstruction gate failure core) :
          SourceNativeInquiryCompilationAt
            root visit program.U7 program.calculus
            root.toAuthoritativeRoot.source.lawSurface
            sourceNativeObserverLegislationQuery
            (ULift.up.{u + 1, u} (root.emitted visit.current))
            program.entry program.entryAuthority) =
              program.inquiryProgram.generate.output) :
      SourceNativeCompiledObserverConsumerLegislationAt execution
        (.rooted rooted) (.requiresU8 obstruction gate failure core)

/-- Sole public compiler.  The only explicit operational input is the private
execution token emitted by the installed program. -/
def compileSourceNativeObserverConsumerLegislationAt
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    {attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect}
    {submissionProgram :
      SourceNativeObserverConsumerSubmissionProgramAt attempt}
    {program : SourceNativeObserverConsumerLegislationProgramAt
      submissionProgram}
    (execution : SourceGeneratedObserverConsumerLegislationAt program) :
    SourceNativeCompiledObserverConsumerLegislationAt execution
      (compileSourceNativeObserverConsumerSubmissionAt
        program.generatedSubmission
        ).useDisposition program.inquiryProgram.generate.output := by
  cases execution
  let compiledSubmission :=
    compileSourceNativeObserverConsumerSubmissionAt
      program.generatedSubmission
  match compiledSubmission.useDisposition with
  | .presentation => exact .observerPresentation
  | .rejected rejection => exact .rejected rejection
  | .rooted rooted =>
      match outputExact : program.inquiryProgram.generate.output with
      | .answered answerFace consumer =>
          exact .rootedAnswered rooted answerFace consumer outputExact.symm
      | .u7Answered obstruction disposition answerFace consumer =>
          exact .rootedU7Answered rooted obstruction disposition answerFace
            consumer outputExact.symm
      | .oldLanguageAnswered obstruction gate oldAnswer answerFace consumer =>
          exact .rootedOldLanguageAnswered rooted obstruction gate oldAnswer
            answerFace consumer outputExact.symm
      | .actualAction action =>
          exact .installedAction rooted action outputExact.symm
      | .requiresU8 obstruction gate failure core =>
          exact .sameOccurrenceU8 rooted obstruction gate failure core
            outputExact.symm

/-! ## Public branch classifiers -/

namespace SourceNativeCompiledObserverConsumerLegislationAt

variable
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    {attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect}
    {submissionProgram :
      SourceNativeObserverConsumerSubmissionProgramAt attempt}
    {program : SourceNativeObserverConsumerLegislationProgramAt
      submissionProgram}
    {execution : SourceGeneratedObserverConsumerLegislationAt program}
    {disposition : SourceNativeObserverConsumerUseDispositionAt
      program.generatedSubmission}
    {inquiryOutput : SourceNativeInquiryCompilationAt
      root visit program.U7 program.calculus
      root.toAuthoritativeRoot.source.lawSurface
      sourceNativeObserverLegislationQuery
      (ULift.up.{u + 1, u} (root.emitted visit.current))
      program.entry program.entryAuthority}
    (compiled : SourceNativeCompiledObserverConsumerLegislationAt execution
      disposition inquiryOutput)

/-- Marker for observer presentation or a rooted inquiry answered by the
installed current law.  It is a classifier, not an authority token. -/
def LawfulPresentationBranchAt : Type :=
  match compiled with
  | .observerPresentation => PUnit
  | .rootedAnswered _ _ _ _ => PUnit
  | .rootedU7Answered _ _ _ _ _ _ => PUnit
  | .rootedOldLanguageAnswered _ _ _ _ _ _ _ => PUnit
  | .rejected _ => PEmpty
  | .installedAction _ _ _ => PEmpty
  | .sameOccurrenceU8 _ _ _ _ _ _ => PEmpty

/-- Marker for typed rejection. -/
def RejectedBranchAt : Type :=
  match compiled with
  | .rejected _ => PUnit
  | _ => PEmpty

/-- Marker for the installed sequential-action leaf. -/
def InstalledActionAt : Type :=
  match compiled with
  | .installedAction _ _ _ => PUnit
  | _ => PEmpty

/-- Marker for the same-occurrence U8 leaf. -/
def SameOccurrenceU8At : Type :=
  match compiled with
  | .sameOccurrenceU8 _ _ _ _ _ _ => PUnit
  | _ => PEmpty

/-- Marker for the two world-writing leaves.  Actual authority remains in the
generated action or U8 core carried by the outcome. -/
def WorldWritingBranchAt : Type :=
  match compiled with
  | .installedAction _ _ _ => PUnit
  | .sameOccurrenceU8 _ _ _ _ _ _ => PUnit
  | _ => PEmpty

/-- The installed face transported to the literal output index carried by
this outcome.  A raw action or U8 constructor can inhabit the result only by
proving that its leaf is the installed program's own output. -/
def installedCompilationFace :
    SourceNativeRootInquiryCompilationFaceCoreAt
      root visit sourceNativeObserverLegislationQuery
      (ULift.up.{u + 1, u} (root.emitted visit.current))
      program.entry program.entryAuthority inquiryOutput := by
  cases compiled with
  | observerPresentation => exact program.installedFace
  | rejected _ => exact program.installedFace
  | rootedAnswered _ _ _ outputExact =>
      rw [outputExact]
      exact program.installedFace
  | rootedU7Answered _ _ _ _ _ outputExact =>
      rw [outputExact]
      exact program.installedFace
  | rootedOldLanguageAnswered _ _ _ _ _ _ outputExact =>
      rw [outputExact]
      exact program.installedFace
  | installedAction _ _ outputExact =>
      rw [outputExact]
      exact program.installedFace
  | sameOccurrenceU8 _ _ _ _ _ outputExact =>
      rw [outputExact]
      exact program.installedFace

/-- Strong anti-smuggling mouth: an outcome at any inquiry leaf different
from the complete bundle's installed output is uninhabited, even though the
raw indexed constructors are public. -/
theorem outputMismatch_isEmpty
    (mismatch : inquiryOutput ≠ program.inquiryProgram.generate.output) :
    IsEmpty (SourceNativeCompiledObserverConsumerLegislationAt execution
      disposition inquiryOutput) := by
  constructor
  intro candidate
  cases candidate with
  | observerPresentation => exact mismatch rfl
  | rejected _ => exact mismatch rfl
  | rootedAnswered _ _ _ outputExact => exact mismatch outputExact
  | rootedU7Answered _ _ _ _ _ outputExact => exact mismatch outputExact
  | rootedOldLanguageAnswered _ _ _ _ _ _ outputExact =>
      exact mismatch outputExact
  | installedAction _ _ outputExact => exact mismatch outputExact
  | sameOccurrenceU8 _ _ _ _ _ outputExact => exact mismatch outputExact

theorem worldWritingBranch_implies_rooted :
    Nonempty compiled.WorldWritingBranchAt → disposition.IsRooted := by
  cases compiled with
  | observerPresentation =>
      rintro ⟨impossible⟩
      exact nomatch impossible
  | rejected _ =>
      rintro ⟨impossible⟩
      exact nomatch impossible
  | rootedAnswered _ _ _ _ =>
      rintro ⟨impossible⟩
      exact nomatch impossible
  | rootedU7Answered _ _ _ _ _ _ =>
      rintro ⟨impossible⟩
      exact nomatch impossible
  | rootedOldLanguageAnswered _ _ _ _ _ _ _ =>
      rintro ⟨impossible⟩
      exact nomatch impossible
  | installedAction _ _ _ =>
      intro _
      trivial
  | sameOccurrenceU8 _ _ _ _ _ _ =>
      intro _
      trivial

theorem nonrooted_worldWritingBranch_isEmpty
    (outside : ¬ disposition.IsRooted) :
    IsEmpty compiled.WorldWritingBranchAt :=
  ⟨fun write => outside (compiled.worldWritingBranch_implies_rooted ⟨write⟩)⟩

theorem worldWritingBranch_iff_action_or_u8 :
    Nonempty compiled.WorldWritingBranchAt ↔
      Nonempty compiled.InstalledActionAt ∨
        Nonempty compiled.SameOccurrenceU8At := by
  cases compiled <;> simp [WorldWritingBranchAt, InstalledActionAt,
    SameOccurrenceU8At]

theorem rooted_exhaustive
    {rooted : SourceNativeObserverConsumerRootedAuthorityAt
      program.generatedSubmission}
    (compiled : SourceNativeCompiledObserverConsumerLegislationAt execution
      (.rooted rooted) inquiryOutput) :
    Nonempty compiled.LawfulPresentationBranchAt ∨
      Nonempty compiled.InstalledActionAt ∨
        Nonempty compiled.SameOccurrenceU8At := by
  cases compiled with
  | rootedAnswered _ _ _ _ => exact .inl ⟨PUnit.unit⟩
  | rootedU7Answered _ _ _ _ _ _ => exact .inl ⟨PUnit.unit⟩
  | rootedOldLanguageAnswered _ _ _ _ _ _ _ => exact .inl ⟨PUnit.unit⟩
  | installedAction _ _ _ => exact .inr (.inl ⟨PUnit.unit⟩)
  | sameOccurrenceU8 _ _ _ _ _ _ => exact .inr (.inr ⟨PUnit.unit⟩)

theorem exhaustive_fourClasses :
    Nonempty compiled.LawfulPresentationBranchAt ∨
      Nonempty compiled.RejectedBranchAt ∨
        Nonempty compiled.InstalledActionAt ∨
          Nonempty compiled.SameOccurrenceU8At := by
  cases compiled with
  | observerPresentation => exact .inl ⟨PUnit.unit⟩
  | rejected _ => exact .inr (.inl ⟨PUnit.unit⟩)
  | rootedAnswered _ _ _ _ => exact .inl ⟨PUnit.unit⟩
  | rootedU7Answered _ _ _ _ _ _ => exact .inl ⟨PUnit.unit⟩
  | rootedOldLanguageAnswered _ _ _ _ _ _ _ => exact .inl ⟨PUnit.unit⟩
  | installedAction _ _ _ => exact .inr (.inr (.inl ⟨PUnit.unit⟩))
  | sameOccurrenceU8 _ _ _ _ _ _ =>
      exact .inr (.inr (.inr ⟨PUnit.unit⟩))

theorem presentation_worldWritingBranch_isEmpty
    (presented : Nonempty compiled.LawfulPresentationBranchAt) :
    IsEmpty compiled.WorldWritingBranchAt := by
  cases compiled with
  | observerPresentation =>
      change IsEmpty PEmpty
      exact ⟨fun impossible => nomatch impossible⟩
  | rejected _ =>
      change Nonempty PEmpty at presented
      rcases presented with ⟨impossible⟩
      exact nomatch impossible
  | rootedAnswered _ _ _ _ =>
      change IsEmpty PEmpty
      exact ⟨fun impossible => nomatch impossible⟩
  | rootedU7Answered _ _ _ _ _ _ =>
      change IsEmpty PEmpty
      exact ⟨fun impossible => nomatch impossible⟩
  | rootedOldLanguageAnswered _ _ _ _ _ _ _ =>
      change IsEmpty PEmpty
      exact ⟨fun impossible => nomatch impossible⟩
  | installedAction _ _ _ =>
      change Nonempty PEmpty at presented
      rcases presented with ⟨impossible⟩
      exact nomatch impossible
  | sameOccurrenceU8 _ _ _ _ _ _ =>
      change Nonempty PEmpty at presented
      rcases presented with ⟨impossible⟩
      exact nomatch impossible

theorem rejection_worldWritingBranch_isEmpty
    (rejected : Nonempty compiled.RejectedBranchAt) :
    IsEmpty compiled.WorldWritingBranchAt := by
  cases compiled with
  | rejected _ =>
      change IsEmpty PEmpty
      exact ⟨fun impossible => nomatch impossible⟩
  | observerPresentation =>
      change Nonempty PEmpty at rejected
      rcases rejected with ⟨impossible⟩
      exact nomatch impossible
  | rootedAnswered _ _ _ _ =>
      change Nonempty PEmpty at rejected
      rcases rejected with ⟨impossible⟩
      exact nomatch impossible
  | rootedU7Answered _ _ _ _ _ _ =>
      change Nonempty PEmpty at rejected
      rcases rejected with ⟨impossible⟩
      exact nomatch impossible
  | rootedOldLanguageAnswered _ _ _ _ _ _ _ =>
      change Nonempty PEmpty at rejected
      rcases rejected with ⟨impossible⟩
      exact nomatch impossible
  | installedAction _ _ _ =>
      change Nonempty PEmpty at rejected
      rcases rejected with ⟨impossible⟩
      exact nomatch impossible
  | sameOccurrenceU8 _ _ _ _ _ _ =>
      change Nonempty PEmpty at rejected
      rcases rejected with ⟨impossible⟩
      exact nomatch impossible

theorem action_u8_disjoint :
    IsEmpty (compiled.InstalledActionAt × compiled.SameOccurrenceU8At) := by
  cases compiled with
  | installedAction _ _ _ =>
      change IsEmpty (PUnit × PEmpty)
      exact ⟨fun pair => nomatch pair.2⟩
  | sameOccurrenceU8 _ _ _ _ _ _ =>
      change IsEmpty (PEmpty × PUnit)
      exact ⟨fun pair => nomatch pair.1⟩
  | observerPresentation =>
      change IsEmpty (PEmpty × PEmpty)
      exact ⟨fun pair => nomatch pair.1⟩
  | rejected _ =>
      change IsEmpty (PEmpty × PEmpty)
      exact ⟨fun pair => nomatch pair.1⟩
  | rootedAnswered _ _ _ _ =>
      change IsEmpty (PEmpty × PEmpty)
      exact ⟨fun pair => nomatch pair.1⟩
  | rootedU7Answered _ _ _ _ _ _ =>
      change IsEmpty (PEmpty × PEmpty)
      exact ⟨fun pair => nomatch pair.1⟩
  | rootedOldLanguageAnswered _ _ _ _ _ _ _ =>
      change IsEmpty (PEmpty × PEmpty)
      exact ⟨fun pair => nomatch pair.1⟩

end SourceNativeCompiledObserverConsumerLegislationAt

/-! ## Maximum and local-ledger no-go -/

/-- Every compiled use is exactly one of the four public classes. -/
theorem compiledObserverConsumerLegislation_hasNoFifthClass
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    {attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect}
    {submissionProgram :
      SourceNativeObserverConsumerSubmissionProgramAt attempt}
    {program : SourceNativeObserverConsumerLegislationProgramAt
      submissionProgram}
    (execution : SourceGeneratedObserverConsumerLegislationAt program) :
    let compiled := compileSourceNativeObserverConsumerLegislationAt execution
    Nonempty compiled.LawfulPresentationBranchAt ∨
      Nonempty compiled.RejectedBranchAt ∨
        Nonempty compiled.InstalledActionAt ∨
          Nonempty compiled.SameOccurrenceU8At :=
  (compileSourceNativeObserverConsumerLegislationAt execution
    ).exhaustive_fourClasses

/-- All possible same-occurrence installed components and their private
execution tokens for one generated submission. -/
abbrev SourceNativeObserverConsumerSameOccurrenceLegislationAt
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    {attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect}
    {submissionProgram :
      SourceNativeObserverConsumerSubmissionProgramAt attempt}
    {material : SourceNativeObserverConsumerSubmissionMaterialAt attempt}
    (_generated : SourceGeneratedObserverConsumerSubmissionAt submissionProgram
      material) :=
  Sigma fun program :
      SourceNativeObserverConsumerLegislationProgramAt submissionProgram =>
    SourceGeneratedObserverConsumerLegislationAt program

/-- An empty local open ledger eliminates the entire same-occurrence
legislation fibre before a program, action, or U8 realization can exist. -/
theorem emptyLocalLedger_sameOccurrenceLegislation_isEmpty
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    {attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect}
    {submissionProgram :
      SourceNativeObserverConsumerSubmissionProgramAt attempt}
    {material : SourceNativeObserverConsumerSubmissionMaterialAt attempt}
    (generated : SourceGeneratedObserverConsumerSubmissionAt submissionProgram
      material)
    (localEmpty : IsEmpty (OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current)))) :
    IsEmpty
      (SourceNativeObserverConsumerSameOccurrenceLegislationAt generated) :=
  ⟨fun execution => localEmpty.false execution.1.entry⟩

