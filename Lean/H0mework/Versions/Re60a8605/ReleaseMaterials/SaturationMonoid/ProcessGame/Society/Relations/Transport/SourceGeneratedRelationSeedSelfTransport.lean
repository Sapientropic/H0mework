import H0mework.Realization.Descent.P259

/-!
# Source-generated relation-seed self transport

Persistent relation identity is transported through the exact principal
cocycle at one generated phase.  The construction is polymorphic in the phase
and seed carriers and adds no actor, relation, compiler or registry.  A domain
specialization must still obtain its phase and seed from its exact source
occurrence.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace SourceGeneratedRelationSeedSelfTransport

open AffineRelaxation

universe uPhase uSeed

/-- Canonical gauge potential used only to express persistent identity as
principal transport.  It does not select a seed or a phase. -/
def canonicalRelationSeedPotential
    (Phase : Type uPhase) (Seed : Type uSeed) :
    Phase → Equiv.Perm Seed :=
  fun _ => Equiv.refl Seed

/-- Exact principal transition generated by the canonical potential. -/
def canonicalRelationSeedTransition
    (Phase : Type uPhase) (Seed : Type uSeed) :
    Phase → Phase → Equiv.Perm Seed :=
  principalExactTransition (canonicalRelationSeedPotential Phase Seed)

/-- Transport one already generated seed at its already generated phase. -/
def transportedRelationSeed
    {Phase : Type uPhase} {Seed : Type uSeed}
    (phase : Phase) (seed : Seed) : Seed :=
  principalTransport (canonicalRelationSeedTransition Phase Seed)
    phase phase seed

@[simp] theorem transportedRelationSeed_exact
    {Phase : Type uPhase} {Seed : Type uSeed}
    (phase : Phase) (seed : Seed) :
    transportedRelationSeed phase seed = seed :=
  principalExactTransport_self
    (canonicalRelationSeedPotential Phase Seed) phase seed

theorem canonicalRelationSeedTransition_flat
    (Phase : Type uPhase) (Seed : Type uSeed) :
    FlatPrincipalConnection
      (canonicalRelationSeedTransition Phase Seed) :=
  principalExactTransition_flat
    (canonicalRelationSeedPotential Phase Seed)

theorem canonicalRelationSeedTransition_holonomy_one
    (Phase : Type uPhase) (Seed : Type uSeed) :
    ∀ left middle right,
      principalTriangleHolonomy
        (canonicalRelationSeedTransition Phase Seed)
          left middle right = 1 :=
  principalExactTransition_holonomy_one
    (canonicalRelationSeedPotential Phase Seed)

theorem relationSeedSelfTransport_directConsumer
    {Phase : Type uPhase} {Seed : Type uSeed}
    (phase : Phase) (seed : Seed) :
    transportedRelationSeed phase seed = seed ∧
      FlatPrincipalConnection
        (canonicalRelationSeedTransition Phase Seed) ∧
      (∀ left middle right,
        principalTriangleHolonomy
          (canonicalRelationSeedTransition Phase Seed)
            left middle right = 1) :=
  ⟨transportedRelationSeed_exact phase seed,
    canonicalRelationSeedTransition_flat Phase Seed,
    canonicalRelationSeedTransition_holonomy_one Phase Seed⟩

end SourceGeneratedRelationSeedSelfTransport
end Society
end ProcessGame
end SaturationMonoid

#print axioms SaturationMonoid.ProcessGame.Society.SourceGeneratedRelationSeedSelfTransport.transportedRelationSeed_exact
#print axioms SaturationMonoid.ProcessGame.Society.SourceGeneratedRelationSeedSelfTransport.relationSeedSelfTransport_directConsumer
