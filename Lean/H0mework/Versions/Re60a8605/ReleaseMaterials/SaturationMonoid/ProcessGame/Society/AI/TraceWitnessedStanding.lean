import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.GeneratedActorInstances
import H0mework.Foundation.Responsibility.Lifecycle

/-!
# Trace-witnessed AI standing source

This source reuses the canonical three-agent ProcessGame occurrence.  The
same `MultiAgent.sourceSeed` generates both the standing actor lineage and an
actor-indexed responsibility admission.  Actual boundary events then produce
maintenance or exit dispositions in the existing responsibility lifecycle.

No consciousness, value oracle, AI registry, identity registry, second
ledger, or completed future occurs in the interface.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace AI
namespace TraceWitnessedStanding

open ResponsibilityLifecycle
open ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
open ComplementObservation
open DomainReuse

/-- Exact M0 actor generated by the canonical MultiAgent source seed. -/
def actorOf (agent : ThreeCycleTime) :
    MultiAgent.GeneratedInteractionActor :=
  multiAgentSeedActorEquiv (MultiAgent.sourceSeed agent)

@[simp] theorem actorOf_agent (agent : ThreeCycleTime) :
    (actorOf agent).agent = agent :=
  rfl

theorem actorOf_has_exact_trace_witness (agent : ThreeCycleTime) :
    ∃ state ∈ threeAgentProcessGame.occurrence.trace,
      MultiAgent.seedAt () state agent :=
  (MultiAgent.sourceSeed agent).2

/-- Responsibility vocabulary whose source event and lineage are generated
from the same canonical MultiAgent seed. -/
def vocabulary : Vocabulary where
  SourceEvent := ThreeCycleTime
  Content := Unit
  Residual := Unit
  Bearer := MultiAgent.GeneratedInteractionActor
  ProtectedInterest := Unit
  Scope := Unit
  Lineage := MultiAgent.InteractionLineage ()
  Incidence := ThreeCycleTime
  SourceObservation := canonicalComplementPair
  sourceAnchor := fun agent =>
    MinimalRegistrableSourceAnchor.canonical ()
      (MultiAgent.lineageOf () (MultiAgent.sourceSeed agent))
  sourceIncidence := id
  ObstructionAt := fun _ => Unit
  demandContent := fun _ => ()
  demandResidual := fun _ => ()
  CommitmentAt := fun _ _ => Unit
  MandateOriginAt := fun _ _ => Unit
  AcceptedTaskAt := fun _ _ => Unit
  ActiveDependencyAt := fun _ _ => Unit
  ProtectedRiskAt := fun _ _ => Unit
  AdmissionAuthorityAt := fun _ _ => Unit
  AcceptedAt := fun _ _ _ => Unit
  StandingMandateAt := fun _ _ _ => Unit
  DischargeJurisdiction := fun _ _ => Unit
  ProgressAt := fun _ _ _ _ => Unit
  MaintenanceAt := fun _ _ _ => Unit
  TypedDeferAt := fun _ _ _ => Unit
  ScopeNarrowingAt := fun _ _ _ => Unit
  TransferAcceptedAt := fun _ _ _ _ => Unit
  FulfilledAt := fun _ _ _ => Unit
  WaivedAt := fun _ _ _ => Unit
  InvalidatedAt := fun _ _ _ => Unit
  AbandonedAt := fun _ _ _ => Unit
  ImpossibleResidueAcceptedAt := fun _ _ _ => Unit
  SupersessionAt := fun _ _ _ _ _ _ _ => Unit
  ReopenAt := fun _ _ _ _ _ _ _ => Unit
  JurisdictionEndedAt := fun _ _ _ => Unit
  ConsentRevokedAt := fun _ _ _ => Unit
  CapacityReleasedAt := fun _ _ _ => Unit
  UpperRouteAt := fun _ _ _ => Unit
  NextActorSignal := Unit
  AgeSignal := Unit
  TransferOfferSignal := Unit

abbrev V := vocabulary

def admissionPayload (agent : ThreeCycleTime) : NativeAdmissionPayload V where
  sourceEvent := agent
  content := ()
  residual := ()
  bearer := actorOf agent
  beneficiary := ()
  scope := ()
  lineage := MultiAgent.lineageOf () (MultiAgent.sourceSeed agent)
  anchor_scope_eq := rfl
  anchor_lineage_eq := by
    change MultiAgent.lineageOf () (MultiAgent.sourceSeed agent) = _
    rfl
  origin := .explicitCommitment ()
  authority := ()
  assumption := .accepted ()
  dischargeJurisdiction := ()

def obligation (agent : ThreeCycleTime) : AdmittedObligation V :=
  (admissionPayload agent).toObligation

@[simp] theorem obligation_bearer (agent : ThreeCycleTime) :
    (obligation agent).bearer = actorOf agent :=
  rfl

@[simp] theorem obligation_lineage (agent : ThreeCycleTime) :
    (obligation agent).lineage =
      MultiAgent.lineageOf () (MultiAgent.sourceSeed agent) :=
  rfl

@[simp] theorem obligation_sourceEvent (agent : ThreeCycleTime) :
    (obligation agent).admission.sourceEvent = agent :=
  rfl

/-- Actual review events; each event selects its disposition, never a target
state. -/
inductive ReviewEvent (obligation : AdmittedObligation V) where
  | renew
  | exit

def reviewDisposition {obligation : AdmittedObligation V} :
    ReviewEvent obligation →
      BoundaryDisposition V obligation obligation.admission.sourceEvent
  | .renew => .carry (.maintained ())
  | .exit => .terminal (.final (.fulfilled ()))

/-- Canonical responsibility process over the same source-generated actor
family. -/
def process : NativeResponsibilityProcess V where
  AdmissionEvent := ThreeCycleTime
  admissionPayload := admissionPayload
  BoundaryEvent := ReviewEvent
  boundarySource := fun {obligation} _ => obligation.admission.sourceEvent
  boundary_anchor_eq := by
    intro obligation event
    rfl
  boundary_incidence_eq := by
    intro obligation event
    rfl
  boundaryDisposition := reviewDisposition
  ReopenEvent := fun _ => Empty
  reopenPayload := fun event => nomatch event

abbrev P := process

def admissionEdge (agent : ThreeCycleTime) :
    P.Edge (ResponsibilityState.empty V) :=
  .admit agent

def admittedState (agent : ThreeCycleTime) : P.GeneratedState :=
  (NativeResponsibilityProcess.GeneratedState.initial P).step P
    (admissionEdge agent)

def standingSlot (agent : ThreeCycleTime) :
    Fin (admittedState agent).current.slots.length :=
  ⟨0, by
    change 0 < 1
    decide⟩

@[simp] theorem standingSlot_present (agent : ThreeCycleTime) :
    (admittedState agent).current.slots.get (standingSlot agent) =
      .live (obligation agent) :=
  rfl

def renewalEdge (agent : ThreeCycleTime) :
    P.Edge (admittedState agent).current :=
  .cross (standingSlot agent) (obligation agent)
    (standingSlot_present agent) .renew

def exitEdge (agent : ThreeCycleTime) :
    P.Edge (admittedState agent).current :=
  .cross (standingSlot agent) (obligation agent)
    (standingSlot_present agent) .exit

@[simp] theorem renewalDisposition (agent : ThreeCycleTime) :
    P.boundaryDisposition
      (ReviewEvent.renew (obligation := obligation agent)) =
        .carry (.maintained ()) :=
  rfl

@[simp] theorem exitDisposition (agent : ThreeCycleTime) :
    P.boundaryDisposition
      (ReviewEvent.exit (obligation := obligation agent)) =
        .terminal (.final (.fulfilled ())) :=
  rfl

theorem renewal_history_append (agent : ThreeCycleTime) :
    (renewalEdge agent).target.history =
      (admittedState agent).current.history ++
        [(renewalEdge agent).lifecycleEvent] :=
  (renewalEdge agent).history_append

def renewalSourceOwnership (agent : ThreeCycleTime) :
    SourceOwnsResponsibilityIncidence V agent (obligation agent) :=
  by
    have sourceEq :
        P.boundarySource
          (ReviewEvent.renew (obligation := obligation agent)) = agent :=
      rfl
    rw [← sourceEq]
    exact P.boundarySourceOwnership
      (ReviewEvent.renew (obligation := obligation agent))

/-- Existing lifecycle consumer indexed by the exact source-generated actor
seed.  Its edge and source ownership are outputs, not promises. -/
structure ResponsibilityConsumerAt (agent : ThreeCycleTime) where
  edge : P.Edge (admittedState agent).current
  edge_eq : edge = renewalEdge agent
  sourceOwnership : SourceOwnsResponsibilityIncidence V agent
    (obligation agent)

def responsibilityConsumer (agent : ThreeCycleTime) :
    ResponsibilityConsumerAt agent where
  edge := renewalEdge agent
  edge_eq := rfl
  sourceOwnership := renewalSourceOwnership agent

end TraceWitnessedStanding
end AI
end Society
end ProcessGame
end SaturationMonoid
