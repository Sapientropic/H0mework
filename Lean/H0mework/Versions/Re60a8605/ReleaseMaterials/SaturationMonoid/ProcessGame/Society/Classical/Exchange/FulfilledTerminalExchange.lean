import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Classical.Exchange.GeneratedTerminalExchange
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Settlement.AutomaticFullFulfillment

/-!
# Whole fulfilled settlement of a generated terminal exchange

The terminal exchange process has one fixed native fulfillment event at every
leg.  The generic finite fulfillment fold consumes that authority and creates
the dependent whole-ledger run.  Recovered utility is the residual of the
resulting exact fulfilled player leg; a zero-player terminal still generates
and fulfills its two clearing legs.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace Classical
namespace GeneratedTerminalExchange

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Lifecycle Universal Relations
open Source Source.FreeStrategicSyntax
open _root_.SaturationMonoid.ProcessGame.Society.Exchange
open _root_.SaturationMonoid.ProcessGame.Society.Settlement
open Settlement.SourceOwnedSettlementCompiler
open Settlement.AutomaticFullFulfillment

/-- Fixed process-native fulfillment authority.  It is a compiler constant,
not an every-leg witness accepted by the public recovery mouth. -/
def terminalFulfillmentAuthority (program : FreeStrategicSyntax) :
    ExactExchangeFulfillmentAuthority
      (exchangeLaw := terminalExchangeLaw program) :=
  fun _seed _leg =>
    { event := ()
      receipt := ()
      disposition_eq := rfl }

/-- Whole-settlement compiler generated from the fixed authority. -/
def terminalSettlementCompiler (program : FreeStrategicSyntax) :=
  Settlement.AutomaticFullFulfillment.settlementCompiler
    (terminalFulfillmentAuthority program)

/-- Exact whole-settlement occurrence generated by one terminal restriction. -/
def terminalSettlement (program : FreeStrategicSyntax)
    (terminal : program.ExactWorldTerminalRestriction) :
    (terminalSettlementCompiler program).GeneratedSettlementOccurrence :=
  Settlement.AutomaticFullFulfillment.settlementOccurrence
    (terminalFulfillmentAuthority program)
    (exactTerminalExchangeSeed program terminal)

/-- Exact fulfilled archive of one payoff-bearing player leg. -/
noncomputable def terminalFulfilledPlayerLeg
    (program : FreeStrategicSyntax)
    (terminal : program.ExactWorldTerminalRestriction)
    (player : program.Player) :
    FulfilledExchangeLegAt (terminalSettlementCompiler program)
      (terminalSettlement program terminal)
      (terminalPlayerLeg program terminal player) :=
  Settlement.AutomaticFullFulfillment.fulfilledExchangeLeg
    (terminalFulfillmentAuthority program)
    (exactTerminalExchangeSeed program terminal)
    (terminalPlayerLeg program terminal player)

/-- Strong whole settlement, including clearing legs. -/
noncomputable def terminalFullyFulfilled
    (program : FreeStrategicSyntax)
    (terminal : program.ExactWorldTerminalRestriction) :
    FullyFulfilledExchangeAt (terminalSettlementCompiler program)
      (terminalSettlement program terminal) :=
  Settlement.AutomaticFullFulfillment.fullyFulfilled
    (terminalFulfillmentAuthority program)
    (exactTerminalExchangeSeed program terminal)

/-- Utility coordinate read only from the exact fulfilled exchange leg. -/
noncomputable def terminalUtility
    (program : FreeStrategicSyntax)
    (terminal : program.ExactWorldTerminalRestriction)
    (player : program.Player) : ℚ :=
  (terminalFulfilledPlayerLeg program terminal player).obligation.residual

/-- Distinguished source-native authority leg.  It is the counterparty of
the first exchange base and is deliberately absent from the classical Player
and utility carriers. -/
def terminalAuthorityLeg (program : FreeStrategicSyntax)
    (terminal : program.ExactWorldTerminalRestriction) :
    (exactTerminalExchangeSeed program terminal).Leg :=
  (firstTerminalLegBase program, true)

noncomputable def terminalFulfilledAuthorityLeg
    (program : FreeStrategicSyntax)
    (terminal : program.ExactWorldTerminalRestriction) :
    FulfilledExchangeLegAt (terminalSettlementCompiler program)
      (terminalSettlement program terminal)
      (terminalAuthorityLeg program terminal) :=
  Settlement.AutomaticFullFulfillment.fulfilledExchangeLeg
    (terminalFulfillmentAuthority program)
    (exactTerminalExchangeSeed program terminal)
    (terminalAuthorityLeg program terminal)

/-- Source-native `K`: residual archived by the exact fulfilled authority
leg, not a label attached to the classical image. -/
noncomputable def terminalAuthorityK
    (program : FreeStrategicSyntax)
    (terminal : program.ExactWorldTerminalRestriction) : ℚ :=
  (terminalFulfilledAuthorityLeg program terminal).obligation.residual

@[simp] theorem terminalAuthorityK_eq_sourceResidual
    (program : FreeStrategicSyntax)
    (terminal : program.ExactWorldTerminalRestriction) :
    terminalAuthorityK program terminal =
      program.authorityResidual (terminalProfile program terminal)
        (firstTerminalLegBase program) := by
  change
    (TerminalExchangeAdmission.residual
      (⟨terminal, (firstTerminalLegBase program, true)⟩ :
        TerminalExchangeAdmission program)) = _
  rfl

@[simp] theorem terminalAuthorityLeg_sourceEvent_eq_atom
    (program : FreeStrategicSyntax)
    (terminal : program.ExactWorldTerminalRestriction) :
    (exactTerminalExchangeSeed program terminal).sourceEvent
        (terminalExchangeCompiler program)
        (terminalAuthorityLeg program terminal) =
      program.authorityAtom (terminalProfile program terminal)
        (firstTerminalLegBase program) :=
  rfl

theorem terminalAuthorityLeg_sourceEvent_carries_K
    (program : FreeStrategicSyntax)
    (terminal : program.ExactWorldTerminalRestriction) :
    (exactTerminalExchangeSeed program terminal).sourceEvent
        (terminalExchangeCompiler program)
        (terminalAuthorityLeg program terminal) =
      .authorityResidual
        (program.profileIndex (terminalProfile program terminal))
        (firstTerminalLegBase program).val
        (terminalAuthorityK program terminal) := by
  rw [terminalAuthorityLeg_sourceEvent_eq_atom,
    terminalAuthorityK_eq_sourceResidual]
  rfl

structure TerminalAuthorityConsumerAt
    (program : FreeStrategicSyntax)
    (terminal : program.ExactWorldTerminalRestriction) : Prop where
  fulfilled : Nonempty (FulfilledExchangeLegAt
    (terminalSettlementCompiler program)
    (terminalSettlement program terminal)
    (terminalAuthorityLeg program terminal))
  wholeFulfilled : Nonempty (FullyFulfilledExchangeAt
    (terminalSettlementCompiler program)
    (terminalSettlement program terminal))
  exactSource :
    (exactTerminalExchangeSeed program terminal).sourceEvent
        (terminalExchangeCompiler program)
        (terminalAuthorityLeg program terminal) ∈ program.occurrence.trace
  exactSourceEvent :
    (exactTerminalExchangeSeed program terminal).sourceEvent
        (terminalExchangeCompiler program)
        (terminalAuthorityLeg program terminal) =
      program.authorityAtom (terminalProfile program terminal)
        (firstTerminalLegBase program)
  sourceEventCarriesK :
    (exactTerminalExchangeSeed program terminal).sourceEvent
        (terminalExchangeCompiler program)
        (terminalAuthorityLeg program terminal) =
      .authorityResidual
        (program.profileIndex (terminalProfile program terminal))
        (firstTerminalLegBase program).val
        (terminalAuthorityK program terminal)
  nativeResponsibility :
    Nonempty ((terminalExchangeIncidence program).TargetResponsibilityAt
      ((exactTerminalExchangeSeed program terminal).actor
        (terminalExchangeCompiler program)
        (terminalAuthorityLeg program terminal))
      ((exactTerminalExchangeSeed program terminal).obligation
        (terminalExchangeCompiler program)
        (terminalAuthorityLeg program terminal))
      ((exactTerminalExchangeSeed program terminal).sourceEvent
        (terminalExchangeCompiler program)
        (terminalAuthorityLeg program terminal)))
  residual_eq : terminalAuthorityK program terminal =
    program.authorityResidual (terminalProfile program terminal)
      (firstTerminalLegBase program)

theorem terminalAuthorityK_has_exact_consumer
    (program : FreeStrategicSyntax)
    (terminal : program.ExactWorldTerminalRestriction) :
    TerminalAuthorityConsumerAt program terminal where
  fulfilled := ⟨terminalFulfilledAuthorityLeg program terminal⟩
  wholeFulfilled := ⟨terminalFullyFulfilled program terminal⟩
  exactSource := terminalExchangeLeg_sourceEvent_mem_trace program terminal
    (terminalAuthorityLeg program terminal)
  exactSourceEvent := terminalAuthorityLeg_sourceEvent_eq_atom program terminal
  sourceEventCarriesK :=
    terminalAuthorityLeg_sourceEvent_carries_K program terminal
  nativeResponsibility :=
    (terminalExchange_native_reciprocity program terminal
      (terminalAuthorityLeg program terminal)).2.1
  residual_eq := terminalAuthorityK_eq_sourceResidual program terminal

@[simp] theorem terminalUtility_eq_settlementValue
    (program : FreeStrategicSyntax)
    (terminal : program.ExactWorldTerminalRestriction)
    (player : program.Player) :
    terminalUtility program terminal player =
      program.settlementValue (terminalProfile program terminal) player := by
  change
    ((exactTerminalExchangeSeed program terminal).obligation
      (terminalExchangeCompiler program)
      (terminalPlayerLeg program terminal player)).residual = _
  exact terminalPlayerLeg_obligation_residual program terminal player

theorem terminalUtility_exact_bearer
    (program : FreeStrategicSyntax)
    (terminal : program.ExactWorldTerminalRestriction)
    (player : program.Player) :
    (terminalFulfilledPlayerLeg program terminal player).obligation.bearer =
      program.actorOf (program.playerActorIndex player) := by
  change
    ((exactTerminalExchangeSeed program terminal).obligation
      (terminalExchangeCompiler program)
      (terminalPlayerLeg program terminal player)).bearer = _
  exact terminalPlayerLeg_obligation_bearer program terminal player

theorem terminalUtility_exchange_settlement_provenance
    (program : FreeStrategicSyntax)
    (terminal : program.ExactWorldTerminalRestriction)
    (player : program.Player) :
    (terminalFulfilledPlayerLeg program terminal player).obligation.residual =
        terminalUtility program terminal player ∧
      (terminalFulfilledPlayerLeg program terminal player).obligation.bearer =
        program.actorOf (program.playerActorIndex player) ∧
      Nonempty ((terminalExchangeIncidence program).TargetResponsibilityAt
        ((exactTerminalExchangeSeed program terminal).actor
          (terminalExchangeCompiler program)
          (terminalPlayerLeg program terminal player))
        ((exactTerminalExchangeSeed program terminal).obligation
          (terminalExchangeCompiler program)
          (terminalPlayerLeg program terminal player))
        ((exactTerminalExchangeSeed program terminal).sourceEvent
          (terminalExchangeCompiler program)
          (terminalPlayerLeg program terminal player))) := by
  refine ⟨rfl, terminalUtility_exact_bearer program terminal player, ?_⟩
  exact (terminalExchange_native_reciprocity program terminal
    (terminalPlayerLeg program terminal player)).2.1

/-- The continuation in the generated occurrence is exactly the automatic
dependent run from the whole exchange admission state. -/
theorem terminalSettlement_whole_run
    (program : FreeStrategicSyntax)
    (terminal : program.ExactWorldTerminalRestriction) :
    Nonempty ((TerminalExchangeP program).Run
      ((exactTerminalExchangeSeed program terminal).generatedState
        (terminalExchangeCompiler program)).current
      ((terminalSettlement program terminal).current
        (terminalSettlementCompiler program))) :=
  ⟨(terminalSettlement program terminal).continuation
    (terminalSettlementCompiler program)⟩

/-- Full fulfillment removes the complete open-settlement fibre. -/
theorem terminalSettlement_open_isEmpty
    (program : FreeStrategicSyntax)
    (terminal : program.ExactWorldTerminalRestriction) :
    IsEmpty (OpenSettlementAt (terminalSettlementCompiler program)
      (terminalSettlement program terminal)) :=
  (terminalFullyFulfilled program terminal).openSettlement_isEmpty

end
end GeneratedTerminalExchange
end Classical
end Society
end ProcessGame
end SaturationMonoid
