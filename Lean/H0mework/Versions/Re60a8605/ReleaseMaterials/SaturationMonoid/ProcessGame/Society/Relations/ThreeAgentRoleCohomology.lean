import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Relations.GeneratedRelationRole
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.ThreeAgentH1Face

/-!
# Three generated relation roles as a cohomology face

Three distinct generated actors carry three exact generated interests.  Their
relation-lineage phase steps populate the selected edges of the existing
three-agent ring.  The ring residual is then generated by the existing fixed
ProcessGame fold; it is never accepted as a field of this cycle.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace Relations

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Lifecycle Universal

universe u v w x

variable {Source : Type u} {State : Type v}
variable {occurrenceOf : Source → RootedAccountedUnfolding State}
variable {game : SaturationMonoid.ProcessGame occurrenceOf}
variable {actorFace : M0BoundaryFace.{u, v, w} occurrenceOf}

/-- Three distinct generated actors and their exact relation-beneficiary
incidences.  Relation `i` supplies the phase on the selected edge
`i → threeCycleNext i`. -/
structure ThreeAgentGeneratedRoleCycle
    (compiler : SourceOwnedRelationRoleCompiler.{u, v, w, x}
      occurrenceOf game actorFace)
    [AddCommGroup (compiler.Phase game.source)] where
  actor : ThreeCycleTime → compiler.Actor
  actor_injective : Function.Injective actor
  relation : ThreeCycleTime → compiler.GeneratedRelation
  interest : ∀ index,
    compiler.GeneratedInterestAt (actor index) (relation index)

namespace ThreeAgentGeneratedRoleCycle

variable
    {compiler : SourceOwnedRelationRoleCompiler.{u, v, w, x}
      occurrenceOf game actorFace}
    [AddCommGroup (compiler.Phase game.source)]

/-- Generated selected-edge cochain.  Off-ring pairs carry zero; the three
ring values are read directly from generated relation lineages. -/
def cochain (cycle : ThreeAgentGeneratedRoleCycle compiler) :
    ThreeCycleTime → ThreeCycleTime → compiler.Phase game.source :=
  fun source target =>
    if target = threeCycleNext source then
      compiler.phaseStep (cycle.relation source)
    else
      0

@[simp] theorem cochain_selected_edge
    (cycle : ThreeAgentGeneratedRoleCycle compiler)
    (index : ThreeCycleTime) :
    cycle.cochain index (threeCycleNext index) =
      compiler.phaseStep (cycle.relation index) := by
  simp [cochain]

/-- The three selected roles remain source-generated and unique at either
edge side; the cohomology consumer never supplies a role value. -/
theorem role_total_unique
    (cycle : ThreeAgentGeneratedRoleCycle compiler)
    (index : ThreeCycleTime) (side : EdgeSide) :
    ∃! role : compiler.Role game.source,
      compiler.RelationRoleAt (cycle.actor index) (cycle.relation index)
        side role :=
  compiler.relationRoleAt_total_unique (cycle.interest index) side

/-- Sum of the three generated local phase steps. -/
def phaseSum (cycle : ThreeAgentGeneratedRoleCycle compiler) :
    compiler.Phase game.source :=
  compiler.phaseStep (cycle.relation .t0) +
    compiler.phaseStep (cycle.relation .t1) +
      compiler.phaseStep (cycle.relation .t2)

/-- The existing ring residual is calculated from the exact generated local
phases; there is no residual premise or residual field. -/
theorem ringResidual_eq_phaseSum
    (cycle : ThreeAgentGeneratedRoleCycle compiler) :
    threeAgentRingResidual cycle.cochain = cycle.phaseSum := by
  simp [threeAgentRingResidual, cochain, phaseSum, threeCycleNext]

/-- Existing source-only three-agent fold applied to generated role phases. -/
def foldReadout (cycle : ThreeAgentGeneratedRoleCycle compiler) :
    FoldReadout threeAgentProcessGame (threeAgentAlgebra cycle.cochain) :=
  threeAgentFoldReadout cycle.cochain

theorem foldReadout_value_eq_phaseSum
    (cycle : ThreeAgentGeneratedRoleCycle compiler) :
    cycle.foldReadout.value = cycle.phaseSum := by
  rw [threeAgentFoldReadout_value_eq_ringResidual,
    cycle.ringResidual_eq_phaseSum]

/-- P117: a noncancelled sum of exact role phases generates nontrivial H¹. -/
theorem nonzero_h1
    (cycle : ThreeAgentGeneratedRoleCycle compiler)
    (nonzero : cycle.phaseSum ≠ 0) :
    CechAdditiveCover.H1Obstruction
      (identityPairZeroTripleCover ThreeCycleTime
        (compiler.Phase game.source)) cycle.cochain :=
  threeAgentFoldReadout_nonzero_h1 cycle.cochain <| by
    rwa [cycle.foldReadout_value_eq_phaseSum]

/-- P116: the same generated value rules out path additivity. -/
theorem nonzero_not_pathAdditive
    (cycle : ThreeAgentGeneratedRoleCycle compiler)
    (nonzero : cycle.phaseSum ≠ 0) :
    ¬ PathAdditive cycle.cochain :=
  threeAgentFoldReadout_nonzero_not_pathAdditive cycle.cochain <| by
    rwa [cycle.foldReadout_value_eq_phaseSum]

/-- P121: every cohomologous presentation has the same generated fold value. -/
theorem foldReadout_eq_of_cohomologous
    (cycle : ThreeAgentGeneratedRoleCycle compiler)
    {other : ThreeCycleTime → ThreeCycleTime →
      compiler.Phase game.source}
    (cohomologous : ThreeAgentRingCohomologous cycle.cochain other) :
    (threeAgentFoldReadout other).value = cycle.foldReadout.value :=
  threeAgentFoldReadout_eq_of_cohomologous cohomologous

end ThreeAgentGeneratedRoleCycle
end Relations
end Society
end ProcessGame
end SaturationMonoid
