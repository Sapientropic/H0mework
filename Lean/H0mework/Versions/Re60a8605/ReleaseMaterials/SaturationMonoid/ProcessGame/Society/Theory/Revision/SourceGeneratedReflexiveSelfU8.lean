import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Legislation.ProofCarryingLegislation

/-!
# Reflexive self-U8 generated by an exact theory occurrence

This module does not construct another revision mechanism.  It seals the
strongest already generated M9 path: one source-installed renewal occurrence,
the same canonical inquiry-runtime tick, its compiler-selected revolutionary
resolution, the obstruction-generated minimal coface, and the revised first
write with both answer-and-next rows.

The carrier is indexed by the exact revolutionary consumption.  Consequently
an unrooted expressibility failure, a coface frontier, or an uninstalled
revision candidate cannot inhabit it.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace Theory
namespace Revision

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Society.Renewal Society.Observer Society.Settlement
open Society.Legislation
open ConstructiveRoot.RootInquiryCompletion

universe u

variable {LocalSource LocalState Seed : Type u}
variable {occurrenceOf : LocalSource → RootedAccountedUnfolding LocalState}
variable {game : SaturationMonoid.ProcessGame occurrenceOf}
variable {SeedAt : LocalSource → LocalState → Seed → Prop}

variable {N : WorldRelationNetwork.{u}}
variable {RootV : ConstructiveRoot.Vocabulary.{u}}
variable {root : SourceNativeLivingRootClosure N RootV}

variable {W : ResponsibilityLifecycle.Vocabulary.{u}}
variable {P : NativeResponsibilityProcess W}
variable {Occurrence Visible AuthorityResidual : Type u}
variable {observer : AuthorityObserver Occurrence Visible AuthorityResidual}
variable {LocalConsumerAt LocalLifecycleAt DispositionAt :
  SourceSeed occurrenceOf Seed SeedAt game.source → Type u}

variable {recognition :
  SourceNativeProofCarryingRenewalRecognitionAt root P observer
    LocalConsumerAt LocalLifecycleAt DispositionAt}
variable {visit : SourceNativeTemporalVisitAt
  root.toAuthoritativeRoot.toLedgerRoot}
variable {installed : SourceInstalledRenewalAt recognition visit}

variable {process : SourceNativeInquiryEngineProcess.{u}}
variable {runtime : SourceNativeInquiryRuntime process}
variable {depth : Nat}
variable {splice :
  SourceInstalledRenewalRuntimeSpliceAt installed runtime depth}

variable {legislation :
  ProofCarryingLegislationAt installed runtime depth splice}
variable {revolution :
  Society.Revision.SourceGeneratedRevolutionaryTickAt runtime depth}
variable {consumption :
  ProofCarryingRevolutionaryConsumptionAt legislation revolution}

/-- Zero-field self-revision seal.  Its indices already contain the exact
runtime-selected revolutionary branch and its PCL consumption receipt. -/
structure SourceGeneratedReflexiveSelfU8At
    (legislation : ProofCarryingLegislationAt installed runtime depth splice)
    (revolution :
      Society.Revision.SourceGeneratedRevolutionaryTickAt runtime depth)
    (_consumption :
      ProofCarryingRevolutionaryConsumptionAt legislation revolution) :
    Type (u + 14) where
  private mk ::

namespace SourceGeneratedReflexiveSelfU8At

/-- Sole producer: consume the already compiler-selected revolutionary
occurrence.  No failure, coface, revised theory, answer, or next is accepted
separately. -/
def generate
    (consumption :
      ProofCarryingRevolutionaryConsumptionAt legislation revolution) :
    SourceGeneratedReflexiveSelfU8At legislation revolution consumption :=
  ⟨⟩

variable (selfU8 :
  SourceGeneratedReflexiveSelfU8At legislation revolution consumption)

instance instSubsingleton :
    Subsingleton
      (SourceGeneratedReflexiveSelfU8At legislation revolution consumption) :=
  ⟨fun left right => by cases left; cases right; rfl⟩

/-- The failed law surface is the theory already installed in the exact root
state of this runtime tick. -/
def oldTheory
    (_selfU8 :
      SourceGeneratedReflexiveSelfU8At legislation revolution consumption) :
    TheoryState revolution.state.N :=
  revolution.state.state.base.root.toAuthoritativeRoot.source.lawSurface

/-- Exact actual expressibility failure chosen by the runtime compiler. -/
def failure :
    ActualExpressibilityFailure selfU8.oldTheory revolution.obstruction := by
  cases selfU8
  exact revolution.failure

/-- Exact U7 audit gate of the same revolutionary tick. -/
def u7TheoryAudit := by
  cases selfU8
  exact revolution.u7Gate

/-- The failure is already rooted in the source-installed occurrence. -/
def rooted := by
  cases selfU8
  exact revolution.rooted

/-- Canonical obstruction-generated minimal coface. -/
def minimalCoface := by
  cases selfU8
  exact consumption.minimalCoface

/-- Canonical initial factorization into the installed revised source. -/
def initialFactorization := by
  cases selfU8
  exact consumption.initialFactorization

/-- The same named runtime consumed this exact U8 core. -/
theorem runtime_consumes_core
    (selfU8 :
      SourceGeneratedReflexiveSelfU8At legislation revolution consumption) :
    SourceNativeInquiryRuntime.CofaceRealizationResumptionAt
      revolution.core runtime depth := by
  cases selfU8
  exact consumption.resumption

/-- Runtime-consumed revised first write. -/
def firstWrite := by
  cases selfU8
  exact consumption.firstWrite

/-- The obstruction row is consumed by that exact first write. -/
def firstWriteConsumes := by
  cases selfU8
  exact consumption.firstWriteConsumes

/-- Migrated inherited-row answer-and-next. -/
def oldRowAnswerAndNext := by
  cases selfU8
  exact consumption.oldRowAnswerAndNext

/-- New-only obstruction-row answer-and-next. -/
def newRowAnswerAndNext := by
  cases selfU8
  exact consumption.newRowAnswerAndNext

/-- Both revised rows generate one literal downstream current. -/
theorem revised_rows_share_generatedNext :
    selfU8.oldRowAnswerAndNext.nextCurrent =
      selfU8.newRowAnswerAndNext.nextCurrent := by
  cases selfU8
  exact consumption.twoRows_share_generatedNext

/-- Heterogeneous revised next generated by the new-only row consumer. -/
def revisedNext : AnyAuthoritativeRootCurrent.{u} := by
  cases selfU8
  exact consumption.revisedNext

/-- The theory tick and renewal installation name the same root. -/
theorem sameRoot
    (selfU8 :
      SourceGeneratedReflexiveSelfU8At legislation revolution consumption) : HEq
    (sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).1.state.base.root
    root := by
  cases selfU8
  exact legislation.inquiryRoot_heq_installedRoot

/-- The theory tick and renewal installation name the same temporal visit. -/
theorem sameVisit
    (selfU8 :
      SourceGeneratedReflexiveSelfU8At legislation revolution consumption) : HEq
    (sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).1.state.base.visit
    visit := by
  cases selfU8
  exact legislation.inquiryVisit_heq_installedVisit

/-- The failed theory row is the installed renewal row. -/
theorem sameRow
    (selfU8 :
      SourceGeneratedReflexiveSelfU8At legislation revolution consumption) : HEq
    ((sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).1.state.base.entryAt
      (sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).2)
    installed.payload.sourceEntry := by
  cases selfU8
  exact legislation.inquiryRow_heq_installedRenewalRow

/-- Both faces are restrictions of one exact causal occurrence. -/
theorem sameOccurrence
    (selfU8 :
      SourceGeneratedReflexiveSelfU8At legislation revolution consumption) : HEq
    ((sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).1.state.base.root
      |>.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
        (sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).1.state.base.visit)
    (root.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt visit) := by
  cases selfU8
  exact legislation.inquiryOccurrence_heq_installedOccurrence

/-- Whole-ledger write-back of the old-root occurrence. -/
def wholeLedgerWriteBack :
    SourceNativeLedgerEvolutionAt
      root.toAuthoritativeRoot.toLedgerRoot.source.source
      (root.toAuthoritativeRoot.toLedgerRoot
        |>.generatedAtTemporalVisit visit).occurrence := by
  cases selfU8
  exact legislation.wholeLedgerWriteBack

/-- The installed renewal answer-and-next still factors through the same
fixed root. -/
theorem rootAnswerAndNext_factorizes
    (selfU8 :
      SourceGeneratedReflexiveSelfU8At legislation revolution consumption) :
    installed.RootAnswerAndNextFactorizes := by
  cases selfU8
  exact legislation.rootAnswerAndNext_factorizes

end SourceGeneratedReflexiveSelfU8At

end Revision
end Theory
end Society
end ProcessGame
end SaturationMonoid
