import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Classical.Independent.FiniteStrategicGame
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Classical.Recovery.GeneratedStrategicGame

/-!
# Independent strategic-game readout of a free source program

The recovered target has no fields beyond coordinates already generated by
the decoded source program.  Its players are M0 lineage actors, its dependent
strategy fibres are M2 actionable continuation fibres, and its optional
outcome is the M3 fully fulfilled exchange-settlement fold.  A public `ValidCode` is decoded
before recovery; no target game, equivalence, normalizer, or payoff table is
accepted by this module.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace Classical
namespace Recovery

noncomputable section

open Independent Source
open Source.FreeStrategicSyntax
open GeneratedTerminalExchange
open Settlement.SourceOwnedSettlementCompiler

/-- The independent finite strategic game generated by one decoded free
program. -/
def recoveredOfProgram (program : FreeStrategicSyntax) :
    FiniteStrategicGame where
  Player := program.GeneratedPlayer
  playerFintype := inferInstance
  playerDecidableEq := inferInstance
  Strategy := program.GeneratedStrategyFor
  strategyFintype := fun _ => inferInstance
  strategyDecidableEq := fun _ => inferInstance
  outcome := program.generatedOutcome

/-- Public recovery consumes only a valid natural-number source code. -/
def recovered (code : ValidCode) : FiniteStrategicGame :=
  recoveredOfProgram (syntaxOf code)

@[simp] theorem recoveredOfProgram_Player
    (program : FreeStrategicSyntax) :
    (recoveredOfProgram program).Player = program.GeneratedPlayer :=
  rfl

@[simp] theorem recoveredOfProgram_Strategy
    (program : FreeStrategicSyntax)
    (player : (recoveredOfProgram program).Player) :
    (recoveredOfProgram program).Strategy player =
      program.GeneratedStrategyFor player :=
  rfl

@[simp] theorem recoveredOfProgram_outcome
    (program : FreeStrategicSyntax)
    (profile : (recoveredOfProgram program).Profile) :
    (recoveredOfProgram program).outcome profile =
      program.generatedOutcome profile :=
  rfl

/-- Strong recovered utility provenance through one fully fulfilled finite
exchange, including all clearing legs. -/
theorem recoveredOfProgram_outcome_has_exact_exchange_settlement
    (program : FreeStrategicSyntax)
    (profile : (recoveredOfProgram program).Profile)
    (terminal : program.isWorldTerminal
      (program.generatedProfileEquivCanonical profile) = true) :
    Nonempty (FullyFulfilledExchangeAt
      (terminalSettlementCompiler program)
      (terminalSettlement program
        (program.generatedTerminalRestriction profile terminal))) ∧
      (recoveredOfProgram program).outcome profile =
        some (fun player =>
          (terminalFulfilledPlayerLeg program
            (program.generatedTerminalRestriction profile terminal)
            (program.generatedPlayerIndex player)).obligation.residual) ∧
      ∀ player : (recoveredOfProgram program).Player,
        (terminalFulfilledPlayerLeg program
          (program.generatedTerminalRestriction profile terminal)
          (program.generatedPlayerIndex player)).obligation.bearer = player.1 :=
  (program.recoverExtensiveGame).outcome_is_M3_exchange_settlement_fold
    profile terminal

/-- Normal-form recovery remains a readout: evaluating a generated profile
does not change the source occurrence or its trace. -/
theorem recoveredOfProgram_search_noninterference
    (program : FreeStrategicSyntax)
    (profile : (recoveredOfProgram program).Profile) :
    (program.processGame).occurrence = program.occurrence ∧
      program.occurrence.trace = .origin :: program.programEvents ∧
      FreeClassicalAtom.origin ∈ program.occurrence.trace :=
  (program.recoverExtensiveGame).search_actual_noninterference profile

/-- Source-first producer certificate at one public code.  No independent
target, equivalence, normalizer, payoff function, or every-profile witness is
an input: all fields are recomputed from the decoded occurrence. -/
structure SourceNativeRecoveryAt (code : ValidCode) : Prop where
  player_generated :
    (recovered code).Player = (syntaxOf code).GeneratedPlayer
  strategy_generated : ∀ player : (recovered code).Player,
    (recovered code).Strategy player =
      (syntaxOf code).GeneratedStrategyFor player
  outcome_generated : ∀ profile : (recovered code).Profile,
    (recovered code).outcome profile =
      (syntaxOf code).generatedOutcome profile
  participation_generated : ∀ player : (recovered code).Player,
    (syntaxOf code).relationCompiler.GeneratedInterestAt player.1
      ((syntaxOf code).generatedRelation
        ((syntaxOf code).generatedPlayerIndex player))
  terminal_exchange_generated :
    ∀ (profile : (recovered code).Profile)
      (terminal : (syntaxOf code).isWorldTerminal
        ((syntaxOf code).generatedProfileEquivCanonical profile) = true),
      Nonempty (FullyFulfilledExchangeAt
        (terminalSettlementCompiler (syntaxOf code))
        (terminalSettlement (syntaxOf code)
          ((syntaxOf code).generatedTerminalRestriction profile terminal))) ∧
        (recovered code).outcome profile =
          some (fun player =>
            (terminalFulfilledPlayerLeg (syntaxOf code)
              ((syntaxOf code).generatedTerminalRestriction profile terminal)
              ((syntaxOf code).generatedPlayerIndex player)).obligation.residual) ∧
        ∀ player : (recovered code).Player,
          (terminalFulfilledPlayerLeg (syntaxOf code)
            ((syntaxOf code).generatedTerminalRestriction profile terminal)
            ((syntaxOf code).generatedPlayerIndex player)).obligation.bearer =
              player.1
  search_noninterference : ∀ _profile : (recovered code).Profile,
    ((syntaxOf code).processGame).occurrence = (syntaxOf code).occurrence ∧
      (syntaxOf code).occurrence.trace =
        .origin :: (syntaxOf code).programEvents ∧
      FreeClassicalAtom.origin ∈ (syntaxOf code).occurrence.trace

/-- Universal no-target-smuggling producer: every decoded source code
generates its own classical game and exact authority certificate. -/
theorem recovered_source_native (code : ValidCode) :
    SourceNativeRecoveryAt code where
  player_generated := rfl
  strategy_generated := fun _ => rfl
  outcome_generated := fun _ => rfl
  participation_generated := fun player =>
    (syntaxOf code).generatedPlayer_has_exact_participation_relation player
  terminal_exchange_generated := fun profile terminal =>
    recoveredOfProgram_outcome_has_exact_exchange_settlement
      (syntaxOf code) profile terminal
  search_noninterference := fun profile =>
    recoveredOfProgram_search_noninterference (syntaxOf code) profile

end
end Recovery
end Classical
end Society
end ProcessGame
end SaturationMonoid
