import Mathlib.Data.Set.Basic
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Exchange.GeneratedExchange
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Settlement.GeneratedSettlement

/-!
# Exchange-indexed settlement occurrences

A settlement occurrence is generated by an exact source seed.  Its current
responsibility state is the target of a dependent run beginning at the whole
finite-leg exchange state; callers cannot submit a current state, a run, an
open fibre, or a completed future to the public producer.

Open settlement membership is exact stable-slot membership for a generated
exchange obligation occurrence.  Bare lineage equality, aggregate balance,
and beneficiary standing are insufficient.  The residual consumer is a
mouth waiting for a later process activation; an actual next edge exists only
after such an activation is supplied by a downstream occurrence.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace Settlement

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Lifecycle Universal Relations Exchange

universe u v w x y z q s

variable {Source : Type u} {State : Type v}
variable {occurrenceOf : Source → RootedAccountedUnfolding State}
variable {game : SaturationMonoid.ProcessGame occurrenceOf}
variable {core : SourceOwnedLifecycleCore.{u, v, w} occurrenceOf game}
variable {V : Vocabulary.{x}}
variable {P : NativeResponsibilityProcess V}
variable {incidence : ActorResponsibilityIncidence core V}
variable
  {relationCompiler : SourceOwnedRelationRoleCompiler.{u, v, w, y}
    occurrenceOf game core.targetFace}
variable
  {exchangeLaw : SourceOwnedExchangeLaw.{u, v, w, x, y, z}
    core V P incidence relationCompiler}

/-! ## Slot persistence along the existing responsibility fold -/

theorem edge_slots_length_le_target
    {source : ResponsibilityState V} (edge : P.Edge source) :
    source.slots.length ≤ edge.target.slots.length := by
  cases edge <;> simp [NativeResponsibilityProcess.Edge.target]

theorem run_slots_length_le
    {source target : ResponsibilityState V} (run : P.Run source target) :
    source.slots.length ≤ target.slots.length := by
  induction run with
  | nil => exact Nat.le_refl _
  | step prior edge ih =>
      exact ih.trans (edge_slots_length_le_target edge)

/-! ## Source-owned settlement compiler -/

/-- A source law maps each settlement seed to an already exact exchange and
to the dependent responsibility run that has actually occurred since that
exchange.  The target state is the first projection of the run output, not a
caller argument. -/
structure SourceOwnedSettlementCompiler
    (exchangeLaw : SourceOwnedExchangeLaw.{u, v, w, x, y, z}
      core V P incidence relationCompiler) where
  SettlementSeed : Type q
  settlementAdmittedAt : SettlementSeed → Prop
  exchangeSeed : SettlementSeed → exchangeLaw.ExactExchangeSeed
  continuation : ∀ seed : SettlementSeed,
    Sigma fun target : ResponsibilityState V =>
      P.Run
        ((exchangeSeed seed).generatedState exchangeLaw.compiler).current
        target

namespace SourceOwnedSettlementCompiler

variable
  (compiler : SourceOwnedSettlementCompiler.{u, v, w, x, y, z, q}
    exchangeLaw)

/-- Exact settlement seeds remain restrictions of the same source-owned
process-game occurrence. -/
def settlementSeedAt
    (_source : Source) (state : State) (seed : compiler.SettlementSeed) : Prop :=
  state = core.targetFace.state game.source ∧
    compiler.settlementAdmittedAt seed

abbrev ExactSettlementSeed :=
  SourceSeed occurrenceOf compiler.SettlementSeed compiler.settlementSeedAt
    game.source

namespace ExactSettlementSeed

theorem admitted (seed : compiler.ExactSettlementSeed) :
    compiler.settlementAdmittedAt seed.1 := by
  rcases seed.2 with ⟨state, _inTrace, _atTarget, admitted⟩
  exact admitted

theorem exact_state_provenance (seed : compiler.ExactSettlementSeed) :
    ∃ state ∈ game.occurrence.trace,
      state = core.targetFace.state game.source ∧
        compiler.settlementAdmittedAt seed.1 := by
  rcases seed.2 with ⟨state, inTrace, atTarget, admitted⟩
  exact ⟨state, inTrace, atTarget, admitted⟩

def exchangeSeed (seed : compiler.ExactSettlementSeed) :
    exchangeLaw.ExactExchangeSeed :=
  compiler.exchangeSeed seed.1

def current (seed : compiler.ExactSettlementSeed) : ResponsibilityState V :=
  (compiler.continuation seed.1).1

def continuation (seed : compiler.ExactSettlementSeed) :
    P.Run ((seed.exchangeSeed compiler).generatedState
      exchangeLaw.compiler).current (seed.current compiler) :=
  (compiler.continuation seed.1).2

/-- Whole-ledger state: the exchange admissions and settlement continuation
are one dependent run from the existing process root. -/
def generatedState (seed : compiler.ExactSettlementSeed) : P.GeneratedState :=
  ⟨seed.current compiler,
    NativeResponsibilityProcess.Run.concatRuns P
      ((seed.exchangeSeed compiler).generatedState
        exchangeLaw.compiler).generated
      (seed.continuation compiler)⟩

end ExactSettlementSeed

/-- Public settlement occurrences are exactly the image of the fixed
compiler on exact source seeds.  The whole compiler value is retained as an
authority seal, and the exact seed is projected without representative
choice. -/
def GeneratedSettlementOccurrence :=
  { _seed : compiler.ExactSettlementSeed // compiler = compiler }

def occurrenceOfSeed (seed : compiler.ExactSettlementSeed) :
    compiler.GeneratedSettlementOccurrence :=
  ⟨seed, rfl⟩

theorem generatedOccurrence_has_exact_seed
    (occurrence : compiler.GeneratedSettlementOccurrence) :
    ∃ seed : compiler.ExactSettlementSeed,
      compiler.occurrenceOfSeed seed = occurrence :=
  ⟨occurrence.1, Subtype.ext rfl⟩

namespace GeneratedSettlementOccurrence

def exactSeed (occurrence : compiler.GeneratedSettlementOccurrence) :
    compiler.ExactSettlementSeed :=
  occurrence.1

def exchangeSeed (occurrence : compiler.GeneratedSettlementOccurrence) :
    exchangeLaw.ExactExchangeSeed :=
  (occurrence.exactSeed compiler).exchangeSeed compiler

abbrev Leg (occurrence : compiler.GeneratedSettlementOccurrence) :=
  (occurrence.exchangeSeed compiler).Leg

def current (occurrence : compiler.GeneratedSettlementOccurrence) :
    ResponsibilityState V :=
  (occurrence.exactSeed compiler).current compiler

def continuation (occurrence : compiler.GeneratedSettlementOccurrence) :
    P.Run ((occurrence.exchangeSeed compiler).generatedState
      exchangeLaw.compiler).current (occurrence.current compiler) :=
  (occurrence.exactSeed compiler).continuation compiler

def generatedState (occurrence : compiler.GeneratedSettlementOccurrence) :
    P.GeneratedState :=
  (occurrence.exactSeed compiler).generatedState compiler

def originalObligation
    (occurrence : compiler.GeneratedSettlementOccurrence)
    (leg : occurrence.Leg compiler) : AdmittedObligation V :=
  (occurrence.exchangeSeed compiler).obligation exchangeLaw.compiler leg

def slotIndex
    (occurrence : compiler.GeneratedSettlementOccurrence)
    (leg : occurrence.Leg compiler) : Nat :=
  (occurrence.exchangeSeed compiler).obligationSlotIndex
    exchangeLaw.compiler leg

/-- The exchange slot remains a valid stable slot after every exact
settlement continuation edge. -/
def slot
    (occurrence : compiler.GeneratedSettlementOccurrence)
    (leg : occurrence.Leg compiler) :
    Fin (occurrence.current compiler).slots.length :=
  ⟨occurrence.slotIndex compiler leg, by
    exact lt_of_lt_of_le
      ((occurrence.exchangeSeed compiler).obligationSlotIndex_lt
        exchangeLaw.compiler leg)
      (run_slots_length_le (occurrence.continuation compiler))⟩

theorem exact_source_provenance
    (occurrence : compiler.GeneratedSettlementOccurrence) :
    ∃ state ∈ game.occurrence.trace,
      state = core.targetFace.state game.source ∧
        compiler.settlementAdmittedAt occurrence.1.1 :=
  (occurrence.exactSeed compiler).exact_state_provenance compiler

end GeneratedSettlementOccurrence

/-! ## Exact open, closed, and fulfilled fibres -/

/-- Exact live exchange obligation at its stable slot in the source-generated
settlement current. -/
structure OpenSettlementAt
    (occurrence : compiler.GeneratedSettlementOccurrence) where
  leg : occurrence.Leg compiler
  obligation : AdmittedObligation V
  present :
    (occurrence.current compiler).slots.get
      (occurrence.slot compiler leg) = .live obligation

namespace OpenSettlementAt

variable {compiler}
variable {occurrence : compiler.GeneratedSettlementOccurrence}

def residualBearer (openSettlement : OpenSettlementAt compiler occurrence) : V.Bearer :=
  openSettlement.obligation.bearer

def protectedInterest
    (openSettlement : OpenSettlementAt compiler occurrence) : V.ProtectedInterest :=
  openSettlement.obligation.beneficiary

def residual (openSettlement : OpenSettlementAt compiler occurrence) : V.Residual :=
  openSettlement.obligation.residual

/-- Activation type of the already installed process.  No value of this type
is stored in the open settlement itself. -/
abbrev ResidualConsumerActivationAt
    (openSettlement : OpenSettlementAt compiler occurrence) :=
  P.BoundaryEvent openSettlement.obligation

/-- Independent residual-consumer mouth.  The next edge is generated only
when a later source occurrence supplies an actual process activation. -/
def consumerEdge (openSettlement : OpenSettlementAt compiler occurrence)
    (activation : openSettlement.ResidualConsumerActivationAt) :
    P.Edge (occurrence.current compiler) :=
  .cross (occurrence.slot compiler openSettlement.leg)
    openSettlement.obligation openSettlement.present activation

/-- Explicit activated consumer, kept separate from open authority so the
current occurrence does not preinstall a completed future. -/
structure ActivatedResidualConsumerAt
    (openSettlement : OpenSettlementAt compiler occurrence) where
  activation : openSettlement.ResidualConsumerActivationAt

def ActivatedResidualConsumerAt.edge
    {openSettlement : OpenSettlementAt compiler occurrence}
    (consumer : ActivatedResidualConsumerAt openSettlement) :
    P.Edge (occurrence.current compiler) :=
  openSettlement.consumerEdge consumer.activation

def ActivatedResidualConsumerAt.nextGeneratedState
    {openSettlement : OpenSettlementAt compiler occurrence}
  (consumer : ActivatedResidualConsumerAt openSettlement) :
    P.GeneratedState :=
  (occurrence.generatedState compiler).step P consumer.edge

theorem ActivatedResidualConsumerAt.history_append
    {openSettlement : OpenSettlementAt compiler occurrence}
    (consumer : ActivatedResidualConsumerAt openSettlement) :
    consumer.edge.target.history =
      (occurrence.current compiler).history ++
        [consumer.edge.lifecycleEvent] :=
  consumer.edge.history_append

def ActivatedResidualConsumerAt.sourceOwnership
    {openSettlement : OpenSettlementAt compiler occurrence}
    (consumer : ActivatedResidualConsumerAt openSettlement) :
    SourceOwnsResponsibilityIncidence V
      (P.boundarySource consumer.activation) openSettlement.obligation :=
  P.boundarySourceOwnership consumer.activation

end OpenSettlementAt

/-! ## Source-owned later activation of the residual consumer -/

/-- A separate source compiler activates one open residual.  The open
settlement and boundary event are both outputs of the activation seed.  No
activation value is stored in the earlier settlement occurrence. -/
structure SourceOwnedResidualConsumerCompiler
    (settlementCompiler :
      SourceOwnedSettlementCompiler.{u, v, w, x, y, z, q} exchangeLaw) where
  ActivationSeed : Type s
  activationAdmittedAt : ActivationSeed → Prop
  settlementSeed : ActivationSeed → settlementCompiler.ExactSettlementSeed
  openSettlement : ∀ seed : ActivationSeed,
    OpenSettlementAt settlementCompiler
      (settlementCompiler.occurrenceOfSeed (settlementSeed seed))
  boundaryEvent : ∀ seed : ActivationSeed,
    P.BoundaryEvent (openSettlement seed).obligation

namespace SourceOwnedResidualConsumerCompiler

variable
  {settlementCompiler :
    SourceOwnedSettlementCompiler.{u, v, w, x, y, z, q} exchangeLaw}
variable
  (activationCompiler :
    SourceOwnedResidualConsumerCompiler.{u, v, w, x, y, z, q, s}
      settlementCompiler)

def activationSeedAt
    (_source : Source) (state : State)
    (seed : activationCompiler.ActivationSeed) : Prop :=
  state = core.targetFace.state game.source ∧
    activationCompiler.activationAdmittedAt seed

abbrev ExactActivationSeed :=
  SourceSeed occurrenceOf activationCompiler.ActivationSeed
    activationCompiler.activationSeedAt game.source

namespace ExactActivationSeed

theorem admitted (seed : activationCompiler.ExactActivationSeed) :
    activationCompiler.activationAdmittedAt seed.1 := by
  rcases seed.2 with ⟨state, _inTrace, _atTarget, admitted⟩
  exact admitted

theorem exact_state_provenance
    (seed : activationCompiler.ExactActivationSeed) :
    ∃ state ∈ game.occurrence.trace,
      state = core.targetFace.state game.source ∧
        activationCompiler.activationAdmittedAt seed.1 := by
  rcases seed.2 with ⟨state, inTrace, atTarget, admitted⟩
  exact ⟨state, inTrace, atTarget, admitted⟩

def occurrence (seed : activationCompiler.ExactActivationSeed) :
    settlementCompiler.GeneratedSettlementOccurrence :=
  settlementCompiler.occurrenceOfSeed
    (activationCompiler.settlementSeed seed.1)

def openSettlement (seed : activationCompiler.ExactActivationSeed) :
    OpenSettlementAt settlementCompiler (seed.occurrence activationCompiler) :=
  activationCompiler.openSettlement seed.1

def activation (seed : activationCompiler.ExactActivationSeed) :
    P.BoundaryEvent (seed.openSettlement activationCompiler).obligation :=
  activationCompiler.boundaryEvent seed.1

/-- The exact source-owned activation generates the already installed
consumer adapter; the adapter was not present in the open occurrence. -/
def activatedConsumer (seed : activationCompiler.ExactActivationSeed) :
    OpenSettlementAt.ActivatedResidualConsumerAt
      (seed.openSettlement activationCompiler) :=
  ⟨seed.activation activationCompiler⟩

def edge (seed : activationCompiler.ExactActivationSeed) :
    P.Edge ((seed.occurrence activationCompiler).current
      settlementCompiler) :=
  (seed.activatedConsumer activationCompiler).edge

def nextGeneratedState (seed : activationCompiler.ExactActivationSeed) :
    P.GeneratedState :=
  (seed.activatedConsumer activationCompiler).nextGeneratedState

theorem history_append (seed : activationCompiler.ExactActivationSeed) :
    (seed.edge activationCompiler).target.history =
      ((seed.occurrence activationCompiler).current
        settlementCompiler).history ++
        [(seed.edge activationCompiler).lifecycleEvent] :=
  (seed.activatedConsumer activationCompiler).history_append

def sourceOwnership (seed : activationCompiler.ExactActivationSeed) :
    SourceOwnsResponsibilityIncidence V
      (P.boundarySource (seed.activation activationCompiler))
      (seed.openSettlement activationCompiler).obligation :=
  (seed.activatedConsumer activationCompiler).sourceOwnership

end ExactActivationSeed

/-- Sealed public image of exact later activation seeds. -/
def GeneratedResidualConsumerOccurrence :=
  { _seed : activationCompiler.ExactActivationSeed //
    activationCompiler = activationCompiler }

def consumerOfSeed (seed : activationCompiler.ExactActivationSeed) :
    activationCompiler.GeneratedResidualConsumerOccurrence :=
  ⟨seed, rfl⟩

theorem generatedConsumer_has_exact_seed
    (consumer : activationCompiler.GeneratedResidualConsumerOccurrence) :
    ∃ seed : activationCompiler.ExactActivationSeed,
      activationCompiler.consumerOfSeed seed = consumer :=
  ⟨consumer.1, Subtype.ext rfl⟩

namespace GeneratedResidualConsumerOccurrence

def exactSeed
    (consumer : activationCompiler.GeneratedResidualConsumerOccurrence) :
    activationCompiler.ExactActivationSeed :=
  consumer.1

def edge
    (consumer : activationCompiler.GeneratedResidualConsumerOccurrence) :
    P.Edge (((consumer.exactSeed activationCompiler).occurrence
      activationCompiler).current settlementCompiler) :=
  (consumer.exactSeed activationCompiler).edge activationCompiler

def nextGeneratedState
    (consumer : activationCompiler.GeneratedResidualConsumerOccurrence) :
    P.GeneratedState :=
  (consumer.exactSeed activationCompiler).nextGeneratedState
    activationCompiler

@[simp] theorem nextGeneratedState_current
    (consumer : activationCompiler.GeneratedResidualConsumerOccurrence) :
    consumer.nextGeneratedState.current = consumer.edge.target :=
  rfl

/-- Whole-ledger consumer fact: the later exact activation appends its edge
to the generated run from the responsibility root, not merely to a history
readout. -/
@[simp] theorem nextGeneratedState_generated
    (consumer : activationCompiler.GeneratedResidualConsumerOccurrence) :
    consumer.nextGeneratedState.generated =
      .step
        ((((consumer.exactSeed activationCompiler).occurrence
          activationCompiler).generatedState settlementCompiler).generated)
        consumer.edge :=
  rfl

theorem history_append
    (consumer : activationCompiler.GeneratedResidualConsumerOccurrence) :
    consumer.edge.target.history =
      (((consumer.exactSeed activationCompiler).occurrence
        activationCompiler).current settlementCompiler).history ++
        [consumer.edge.lifecycleEvent] :=
  (consumer.exactSeed activationCompiler).history_append
    activationCompiler

end GeneratedResidualConsumerOccurrence
end SourceOwnedResidualConsumerCompiler

/-- Exact terminal archive at one generated exchange leg's stable slot. -/
structure ClosedExchangeLegAt
    (occurrence : compiler.GeneratedSettlementOccurrence)
    (leg : occurrence.Leg compiler) where
  archive : TerminalArchive V
  present :
    (occurrence.current compiler).slots.get
      (occurrence.slot compiler leg) = .terminal archive

/-- Whole exchange closure quantifies the full source-generated leg carrier;
its scope is not a caller Finset or a fixed binary pair. -/
structure FullyClosedExchangeAt
    (occurrence : compiler.GeneratedSettlementOccurrence) where
  closed : ∀ leg : occurrence.Leg compiler,
    ClosedExchangeLegAt compiler occurrence leg

/-- Exact fulfilled terminal archive at one generated exchange leg. -/
structure FulfilledExchangeLegAt
    (occurrence : compiler.GeneratedSettlementOccurrence)
    (leg : occurrence.Leg compiler) where
  obligation : AdmittedObligation V
  sourceEvent : V.SourceEvent
  receipt : V.FulfilledAt sourceEvent obligation.content obligation.scope
  present :
    (occurrence.current compiler).slots.get
      (occurrence.slot compiler leg) =
        .terminal ⟨obligation, sourceEvent, .fulfilled receipt⟩

namespace FulfilledExchangeLegAt

variable {compiler}
variable {occurrence : compiler.GeneratedSettlementOccurrence}
variable {leg : occurrence.Leg compiler}

def closed (fulfilled : FulfilledExchangeLegAt compiler occurrence leg) :
    ClosedExchangeLegAt compiler occurrence leg :=
  ⟨⟨fulfilled.obligation, fulfilled.sourceEvent,
      .fulfilled fulfilled.receipt⟩,
    fulfilled.present⟩

end FulfilledExchangeLegAt

namespace OpenSettlementAt

variable {compiler}
variable {occurrence : compiler.GeneratedSettlementOccurrence}

/-- One stable exchange slot cannot be both live/open and fulfilled/terminal
at the same settlement occurrence.  The contradiction uses only the two
exact slot-membership witnesses; no balance, price, or completion premise is
needed. -/
theorem fulfilledLeg_isEmpty
    (openSettlement : OpenSettlementAt compiler occurrence) :
    IsEmpty (FulfilledExchangeLegAt compiler occurrence openSettlement.leg) := by
  refine ⟨fun fulfilled => ?_⟩
  have impossible :
      ObligationSlot.live openSettlement.obligation =
        .terminal ⟨fulfilled.obligation, fulfilled.sourceEvent,
          .fulfilled fulfilled.receipt⟩ :=
    openSettlement.present.symm.trans fulfilled.present
  cases impossible

end OpenSettlementAt

/-- Strong full settlement: every obligation occurrence generated by the
exchange is terminal through the exact `fulfilled` constructor. -/
structure FullyFulfilledExchangeAt
    (occurrence : compiler.GeneratedSettlementOccurrence) where
  fulfilled : ∀ leg : occurrence.Leg compiler,
    FulfilledExchangeLegAt compiler occurrence leg

namespace FullyFulfilledExchangeAt

variable {compiler}
variable {occurrence : compiler.GeneratedSettlementOccurrence}

def closed (fully : FullyFulfilledExchangeAt compiler occurrence) :
    FullyClosedExchangeAt compiler occurrence :=
  ⟨fun leg => (fully.fulfilled leg).closed⟩

/-- Exact fulfillment of every generated exchange leg removes the entire
open-settlement fibre. -/
theorem openSettlement_isEmpty
    (fully : FullyFulfilledExchangeAt compiler occurrence) :
    IsEmpty (OpenSettlementAt compiler occurrence) := by
  refine ⟨fun openSettlement => ?_⟩
  let fulfilled := fully.fulfilled openSettlement.leg
  have impossible :
      ObligationSlot.live openSettlement.obligation =
        .terminal ⟨fulfilled.obligation, fulfilled.sourceEvent,
          .fulfilled fulfilled.receipt⟩ :=
    openSettlement.present.symm.trans fulfilled.present
  cases impossible

end FullyFulfilledExchangeAt

namespace FullyClosedExchangeAt

variable {compiler}
variable {occurrence : compiler.GeneratedSettlementOccurrence}

theorem openSettlement_isEmpty
    (closed : FullyClosedExchangeAt compiler occurrence) :
    IsEmpty (OpenSettlementAt compiler occurrence) := by
  refine ⟨fun openSettlement => ?_⟩
  let terminal := closed.closed openSettlement.leg
  have impossible :
      ObligationSlot.live openSettlement.obligation =
        .terminal terminal.archive :=
    openSettlement.present.symm.trans terminal.present
  cases impossible

end FullyClosedExchangeAt

end SourceOwnedSettlementCompiler
end Settlement
end Society
end ProcessGame
end SaturationMonoid

#print axioms SaturationMonoid.ProcessGame.Society.Settlement.SourceOwnedSettlementCompiler.OpenSettlementAt.fulfilledLeg_isEmpty
