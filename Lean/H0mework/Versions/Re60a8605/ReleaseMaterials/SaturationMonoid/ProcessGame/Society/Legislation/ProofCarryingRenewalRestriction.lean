import H0mework.Society.Renewal.InstalledRenewalProjection
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Settlement.GeneratedSettlement
import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Observer.ObserverObstructionDirection

/-!
# Source-installed proof-carrying renewal restriction

A proof-carrying institutional restriction is the local consumer generated by
the M8 renewal law itself.  Its type is indexed by the complete exact
`SourceSeed`; consequently the pre-emitter `SourceNativeRenewalProjectionLaw`
must generate the local consumer, lifecycle evidence, existing live residual,
and M6 vertical obstruction together.

There is no post-hoc seed mapper.  A later PCL may only read this restriction
from `SourceInstalledRenewalAt.payload.consumer`.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace Legislation

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Renewal Settlement Observer

universe u

variable {LocalSource LocalState Seed : Type u}
variable {occurrenceOf : LocalSource → RootedAccountedUnfolding LocalState}
variable {game : SaturationMonoid.ProcessGame occurrenceOf}
variable {SeedAt : LocalSource → LocalState → Seed → Prop}

/-- One already-live lifecycle residual.  No obligation or bearer is generated
by legislation; both are read from an existing exact settlement edge. -/
structure ExistingResidualBearerAt
    {W : ResponsibilityLifecycle.Vocabulary.{u}}
    (P : NativeResponsibilityProcess W) : Type u where
  sourceState : ResponsibilityState W
  settlement : ExactSettlementEdge P sourceState
  liveResidual : ExactSettlementEdge.LiveResidualAt settlement

namespace ExistingResidualBearerAt

variable {W : ResponsibilityLifecycle.Vocabulary.{u}}
variable {P : NativeResponsibilityProcess W}

def bearer (residual : ExistingResidualBearerAt P) : W.Bearer :=
  residual.liveResidual.residualBearer

def residual (existing : ExistingResidualBearerAt P) : W.Residual :=
  existing.liveResidual.residual

end ExistingResidualBearerAt

/-- Exact seed-dependent consumer generated inside the M8 renewal payload.

`LocalConsumerAt` preserves the domain's original local consumer.
`LocalLifecycleAt` lets the same pre-emitter law carry its exact M1 lifecycle
restriction without forcing one concrete lifecycle vocabulary on the generic
interface.  Both families occur in the consumer type itself, so they cannot be
replaced after the root has emitted its occurrence. -/
structure ProofCarryingRenewalRestrictionAt
    {W : ResponsibilityLifecycle.Vocabulary.{u}}
    (P : NativeResponsibilityProcess W)
    {Occurrence Visible AuthorityResidual : Type u}
    (observer : AuthorityObserver Occurrence Visible AuthorityResidual)
    (LocalConsumerAt LocalLifecycleAt :
      SourceSeed occurrenceOf Seed SeedAt game.source → Type u)
    (seed : SourceSeed occurrenceOf Seed SeedAt game.source) : Type u where
  localConsumer : LocalConsumerAt seed
  localLifecycle : LocalLifecycleAt seed
  existingResidual : ExistingResidualBearerAt P
  observerVertical : AuthorityChangingVerticalAutomorphism observer

/-- The exact consumer family to use in
`SourceNativeRenewalProjectionLaw ... ConsumerAt DispositionAt`.
It is an abbreviation, not a registry or an installable mapper. -/
abbrev ProofCarryingRenewalConsumerAt
    {W : ResponsibilityLifecycle.Vocabulary.{u}}
    (P : NativeResponsibilityProcess W)
    {Occurrence Visible AuthorityResidual : Type u}
    (observer : AuthorityObserver Occurrence Visible AuthorityResidual)
    (LocalConsumerAt LocalLifecycleAt :
      SourceSeed occurrenceOf Seed SeedAt game.source → Type u)
    (seed : SourceSeed occurrenceOf Seed SeedAt game.source) : Type u :=
  ProofCarryingRenewalRestrictionAt P observer LocalConsumerAt
    LocalLifecycleAt seed

/-- Recognition type whose installed M8 consumer coordinate is definitionally
the exact proof-carrying restriction above.  This abbreviation adds no second
recognition or installation record. -/
abbrev SourceNativeProofCarryingRenewalRecognitionAt
    {N : WorldRelationNetwork.{u}}
    {RootV : ConstructiveRoot.Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N RootV)
    {W : ResponsibilityLifecycle.Vocabulary.{u}}
    (P : NativeResponsibilityProcess W)
    {Occurrence Visible AuthorityResidual : Type u}
    (observer : AuthorityObserver Occurrence Visible AuthorityResidual)
    (LocalConsumerAt LocalLifecycleAt DispositionAt :
      SourceSeed occurrenceOf Seed SeedAt game.source → Type u) :=
  SourceNativeRenewalRecognitionAt root game Seed SeedAt
    (ProofCarryingRenewalConsumerAt P observer LocalConsumerAt LocalLifecycleAt)
    DispositionAt

namespace ProofCarryingRenewalRestrictionAt

variable {W : ResponsibilityLifecycle.Vocabulary.{u}}
variable {P : NativeResponsibilityProcess W}
variable {Occurrence Visible AuthorityResidual : Type u}
variable {observer : AuthorityObserver Occurrence Visible AuthorityResidual}
variable {LocalConsumerAt LocalLifecycleAt :
  SourceSeed occurrenceOf Seed SeedAt game.source → Type u}
variable {seed : SourceSeed occurrenceOf Seed SeedAt game.source}

/-- Existing residual bearer carried by this exact renewal seed. -/
def residualBearer
    (restriction : ProofCarryingRenewalRestrictionAt P observer
      LocalConsumerAt LocalLifecycleAt seed) : W.Bearer :=
  restriction.existingResidual.bearer

/-- Hidden standing is the anchor occurrence of the seed's M6 vertical
obstruction; it is not supplied separately to PCL. -/
def hiddenStanding
    (restriction : ProofCarryingRenewalRestrictionAt P observer
      LocalConsumerAt LocalLifecycleAt seed) : Occurrence :=
  restriction.observerVertical.anchorOccurrence

/-- Canonical M6 authority kernel generated from the same seed-dependent
vertical obstruction. -/
def observerKernel
    (restriction : ProofCarryingRenewalRestrictionAt P observer
      LocalConsumerAt LocalLifecycleAt seed) : AuthorityKernelPair observer :=
  canonicalAuthorityKernelPair restriction.observerVertical

@[simp] theorem observerKernel_left_eq_hiddenStanding
    (restriction : ProofCarryingRenewalRestrictionAt P observer
      LocalConsumerAt LocalLifecycleAt seed) :
    restriction.observerKernel.left = restriction.hiddenStanding :=
  rfl

end ProofCarryingRenewalRestrictionAt

end Legislation
end Society
end ProcessGame
end SaturationMonoid
