import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.Proposition7
import H0mework.Realization.Fields.SectionCover
import H0mework.Realization.Reflexive.Iteration
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.LivingLawEvolutionKernel

/-!
# Atom-field separation at the living-law boundary

P7/P17/P68 already distinguish source-backed local sections from their glued
field presentation.  P55/P75/P98/P99 already show that time fields are
generated by actual writes and that every finite execution lands at the
corresponding generated section.  This module lifts those existing laws into
the later living-law carrier boundary.

An ambient carrier may remain infinite.  What is newly required for actual
current authority is an explicit, fixed P68 presentation and a proof that the
surface's `update`, `residual`, and `keep` factor through every generated
finite prefix.  A `Nat -> A` carrier may therefore be used as a mathematical
field, but a shift which reads coordinate `n + 1` cannot masquerade as an
update at scope `n` under its pointwise temporal presentation.

The fixed-law readout at the bottom is not a primitive infinite current.  It
returns, for every finite depth, a source-backed P7 section, the exact
same-admission `GeneratedPrefix`, and its dependent equality with P98/P99's
generated time field.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution

universe u

/-- A registered P68 section-valued presentation whose index is the generated
time coordinate.  `Ambient` may be a continuum or function space; `Local`
names the actual section visible at one coordinate. -/
structure AtomFieldPresentation (Ambient : Type u) : Type (u + 1) where
  Local : Nat -> Type u
  Overlap : Nat -> Nat -> Type u
  cover : SectionIndexedCover Nat Ambient Local Overlap
  descent : SectionDescentCertificate cover

/-- The local-family data visible no later than `scope`.  The finite index is
temporal provenance only; it does not assert that the ambient mathematical
carrier is finite. -/
def AtomFieldPresentation.FiniteSection
    {Ambient : Type u} (P : AtomFieldPresentation Ambient)
    (scope : Nat) : Type u :=
  (index : Fin (scope + 1)) -> P.Local index

/-- Restrict an ambient field to the generated prefix ending at `scope`. -/
def AtomFieldPresentation.restrict
    {Ambient : Type u} (P : AtomFieldPresentation Ambient)
    (ambient : Ambient) (scope : Nat) : P.FiniteSection scope :=
  fun index => P.cover.toLocal index ambient

/-- A forbidden completed-field decoder at one finite scope.  Such a decoder
would recover the whole ambient object from the finitely indexed local
section, turning a field/history into one current atom. -/
structure AtomFieldPresentation.CompletedAmbientAt
    {Ambient : Type u} (P : AtomFieldPresentation Ambient)
    (scope : Nat) : Type u where
  recover : P.FiniteSection scope -> Ambient
  recover_restrict : (ambient : Ambient) ->
    recover (P.restrict ambient scope) = ambient

/-- Genuine finite local sections do not contain a decoder for the completed
ambient field at any finite scope.  This is a property of a registered field
presentation, not a ban on infinite ambient mathematics. -/
structure AtomFieldPresentation.ProperFiniteSections
    {Ambient : Type u} (P : AtomFieldPresentation Ambient) : Type u where
  noCompletedAmbient : (scope : Nat) ->
    IsEmpty (P.CompletedAmbientAt scope)

/-- A map is prefix-local when its section at `scope` is determined by the
registered input sections at coordinates `0 .. scope`.  This is the exact
recognition wall between a current atom and a completed time field. -/
structure PrefixLocalMap
    {Source Target : Type u}
    (source : AtomFieldPresentation Source)
    (target : AtomFieldPresentation Target)
    (map : Source -> Target) : Type (u + 1) where
  localStep : (scope : Nat) -> source.FiniteSection scope -> target.Local scope
  commutes : (value : Source) -> (scope : Nat) ->
    target.cover.toLocal scope (map value) =
      localStep scope (source.restrict value scope)

namespace PrefixLocalMap

/-- Equal generated prefixes force equal output sections at that scope. -/
theorem eq_at_of_restrict_eq
    {Source Target : Type u}
    {source : AtomFieldPresentation Source}
    {target : AtomFieldPresentation Target}
    {map : Source -> Target}
    (locality : PrefixLocalMap source target map)
    {left right : Source} {scope : Nat}
    (prefix_eq : source.restrict left scope = source.restrict right scope) :
    target.cover.toLocal scope (map left) =
      target.cover.toLocal scope (map right) := by
  rw [locality.commutes left scope, locality.commutes right scope, prefix_eq]

end PrefixLocalMap

/-! ## P7 source-backed temporal sections -/

/-- The canonical source-backed P7 metadata for a finite generated temporal
prefix.  Authority is kept at the source level; increasing the observation
depth does not mint authority. -/
def generatedTemporalSection (scope : Nat) : Section Nat where
  scope := { index | index <= scope }
  authority := 0
  hasSource := true

theorem generatedTemporalSection_discipline (scope ceiling : Nat) :
    satisfiesDiscipline (generatedTemporalSection scope) ceiling := by
  exact ⟨rfl, Nat.zero_le ceiling⟩

/-- Restriction shortens temporal scope and is definitionally P7 restriction;
it neither increases authority nor loses the source handle. -/
theorem generatedTemporalSection_restriction
    {smaller larger : Nat} (within : smaller <= larger) :
    restrictSection (generatedTemporalSection larger)
        (generatedTemporalSection smaller).scope (by
          intro index index_le_smaller
          exact index_le_smaller.trans within) =
      generatedTemporalSection smaller := by
  rfl

/-! ## Living-law presentation recognition -/

open ResidualProjection
open EffectiveResidualUpdate

variable {K E : Type u}
variable [Field K] [AddCommGroup E] [Module K E]

/-- The atom/field charts are registered before a surface update is admitted.
This prevents a proof from changing presentation merely to make one update
look local.  A different registration requires an explicit transport at a
higher layer. -/
structure CarrierAtomFieldRegistry
    (C : Carrier (K := K) (E := E)) : Type (u + 1) where
  state : (surface : C.LawSurface) ->
    AtomFieldPresentation (C.State surface)
  residual : (surface : C.LawSurface) -> AtomFieldPresentation E

/-- Exact recognition that one registered living-law surface respects its
atom/field boundary.  No update, residual, keep, chart, or target is supplied
by this certificate. -/
structure SurfaceAtomFieldRecognition
    (C : Carrier (K := K) (E := E))
    (registry : CarrierAtomFieldRegistry C)
    (surface : C.LawSurface) : Type (u + 1) where
  update_local : PrefixLocalMap (registry.state surface)
    (registry.state surface) (C.process surface).update
  residual_local : PrefixLocalMap (registry.state surface)
    (registry.residual surface) (C.process surface).residual
  keep_local : PrefixLocalMap (registry.residual surface)
    (registry.residual surface) (C.process surface).keep

/-- Every law surface of one carrier uses its already registered atom/field
charts. -/
structure CarrierAtomFieldRecognition
    (C : Carrier (K := K) (E := E))
    (registry : CarrierAtomFieldRegistry C) : Type (u + 1) where
  surface : (lawSurface : C.LawSurface) ->
    SurfaceAtomFieldRecognition C registry lawSurface

/-! ## P98/P99 generated field and living-law finite sections -/

/-- The P98 time field generated by the exact effective-process read/write
pair at a current surface.  This is a field readout, never a primitive
`Current`. -/
def Carrier.generatedTimeField
    (C : Carrier (K := K) (E := E)) (current : Current C) :
    TimeMemoryField Nat (C.State current.surface) E :=
  reflexiveQueryIteratedTimeField
    { read := (C.process current.surface).residual
      write := (C.process current.surface).update }
    current.residual.state

/-- The exact-target native prefix and the P98/P99 time field are two readouts
of the same fixed-law update recursion. -/
theorem FixedLawNativeTotal.generatedPrefix_target_state_eq_generatedTimeField
    {C : Carrier (K := K) (E := E)} {V : Vocabulary C}
    (T : FixedLawNativeTotal V) (source : Current C) :
    (scope : Nat) ->
      HEq (T.generatedPrefix source scope).target.residual.state
        ((Carrier.generatedTimeField C source).stateAt scope)
  | 0 => by
      simp [Carrier.generatedTimeField, reflexiveQueryIteratedTimeField,
        FixedLawNativeTotal.generatedPrefix, GeneratedPrefix.target]
  | scope + 1 => by
      let next := (T.write source).next
      have tail :=
        T.generatedPrefix_target_state_eq_generatedTimeField next scope
      have shifted := reflexiveQueryIterated_stateAt_shift
        { read := (C.process source.surface).residual
          write := (C.process source.surface).update }
        source.residual.state scope
      exact tail.trans (heq_of_eq shifted)

/-- One generated finite temporal section.  It combines a presentation
recognition, the exact same-admission native prefix, P7 source-backed scope,
and the dependent identity with P98/P99's generated time field.  This is a
readout; root authority is supplied only by the fixed-root recognition layer. -/
structure GeneratedLocalSectionAt
    {C : Carrier (K := K) (E := E)} {V : Vocabulary C}
    (T : FixedLawNativeTotal V)
    {registry : CarrierAtomFieldRegistry C}
    (recognition : CarrierAtomFieldRecognition C registry)
    (source : Current C)
    (scope : Nat) : Type u where
  generated : GeneratedPrefix T source scope
  stateSection :
    (registry.state generated.target.surface).Local scope
  stateSection_eq : stateSection =
    (registry.state generated.target.surface).cover.toLocal
      scope generated.target.residual.state
  residualSection :
    (registry.residual generated.target.surface).Local scope
  residualSection_eq : residualSection =
    (registry.residual generated.target.surface).cover.toLocal
      scope generated.target.residual.value
  target_state_eq_generatedField :
    HEq generated.target.residual.state
      ((Carrier.generatedTimeField C source).stateAt scope)

namespace GeneratedLocalSectionAt

def temporalSection
    {C : Carrier (K := K) (E := E)} {V : Vocabulary C}
    {T : FixedLawNativeTotal V}
    {registry : CarrierAtomFieldRegistry C}
    {recognition : CarrierAtomFieldRecognition C registry}
    {source : Current C}
    {scope : Nat}
    (_localSection : GeneratedLocalSectionAt T recognition source scope) :
    Section Nat :=
  generatedTemporalSection scope

theorem sourceBacked
    {C : Carrier (K := K) (E := E)} {V : Vocabulary C}
    {T : FixedLawNativeTotal V}
    {registry : CarrierAtomFieldRegistry C}
    {recognition : CarrierAtomFieldRecognition C registry}
    {source : Current C}
    {scope : Nat}
    (localSection : GeneratedLocalSectionAt T recognition source scope) :
    satisfiesC1 localSection.temporalSection := by
  rfl

theorem disciplined
    {C : Carrier (K := K) (E := E)} {V : Vocabulary C}
    {T : FixedLawNativeTotal V}
    {registry : CarrierAtomFieldRegistry C}
    {recognition : CarrierAtomFieldRecognition C registry}
    {source : Current C}
    {scope : Nat}
    (localSection : GeneratedLocalSectionAt T recognition source scope)
    (ceiling : Nat) :
    satisfiesDiscipline localSection.temporalSection ceiling :=
  generatedTemporalSection_discipline scope ceiling

theorem target_anchor_eq
    {C : Carrier (K := K) (E := E)} {V : Vocabulary C}
    {T : FixedLawNativeTotal V}
    {registry : CarrierAtomFieldRegistry C}
    {recognition : CarrierAtomFieldRecognition C registry}
    {source : Current C}
    {scope : Nat}
    (localSection : GeneratedLocalSectionAt T recognition source scope) :
    localSection.generated.target.anchor = source.anchor :=
  localSection.generated.target_anchor_eq

theorem target_incidence_eq
    {C : Carrier (K := K) (E := E)} {V : Vocabulary C}
    {T : FixedLawNativeTotal V}
    {registry : CarrierAtomFieldRegistry C}
    {recognition : CarrierAtomFieldRecognition C registry}
    {source : Current C}
    {scope : Nat}
    (localSection : GeneratedLocalSectionAt T recognition source scope) :
    localSection.generated.target.incidence = source.incidence :=
  localSection.generated.target_incidence_eq

theorem target_lawLineage_eq
    {C : Carrier (K := K) (E := E)} {V : Vocabulary C}
    {T : FixedLawNativeTotal V}
    {registry : CarrierAtomFieldRegistry C}
    {recognition : CarrierAtomFieldRecognition C registry}
    {source : Current C}
    {scope : Nat}
    (localSection : GeneratedLocalSectionAt T recognition source scope) :
    localSection.generated.target.lawLineage =
      source.lawLineage :=
  localSection.generated.target_lawLineage_eq

end GeneratedLocalSectionAt

/-- Existing fixed-law totality now generates a P7/P68/P98-recognized local
section at every finite depth. -/
def FixedLawNativeTotal.generatedLocalSection
    {C : Carrier (K := K) (E := E)} {V : Vocabulary C}
    (T : FixedLawNativeTotal V)
    {registry : CarrierAtomFieldRegistry C}
    (recognition : CarrierAtomFieldRecognition C registry)
    (source : Current C)
    (scope : Nat) : GeneratedLocalSectionAt T recognition source scope := by
  let generated := T.generatedPrefix source scope
  exact
    { generated := generated
      stateSection :=
        (registry.state
          generated.target.surface).cover.toLocal
            scope generated.target.residual.state
      stateSection_eq := rfl
      residualSection :=
        (registry.residual
          generated.target.surface).cover.toLocal
            scope generated.target.residual.value
      residualSection_eq := rfl
      target_state_eq_generatedField :=
        T.generatedPrefix_target_state_eq_generatedTimeField
          source scope }

/-- Restriction is regenerated from the same source, total producer, registry,
and recognition.  No field value is allowed to become a new source mouth. -/
def GeneratedLocalSectionAt.restrict
    {C : Carrier (K := K) (E := E)} {V : Vocabulary C}
    {T : FixedLawNativeTotal V}
    {registry : CarrierAtomFieldRegistry C}
    {recognition : CarrierAtomFieldRecognition C registry}
    {source : Current C}
    {larger : Nat}
    (_localSection : GeneratedLocalSectionAt T recognition source larger)
    (smaller : Nat) (_within : smaller <= larger) :
    GeneratedLocalSectionAt T recognition source smaller :=
  T.generatedLocalSection recognition source smaller

theorem GeneratedLocalSectionAt.section_restrict_eq
    {C : Carrier (K := K) (E := E)} {V : Vocabulary C}
    {T : FixedLawNativeTotal V}
    {registry : CarrierAtomFieldRegistry C}
    {recognition : CarrierAtomFieldRecognition C registry}
    {source : Current C}
    {larger smaller : Nat}
    (localSection : GeneratedLocalSectionAt T recognition source larger)
    (within : smaller <= larger) :
    restrictSection localSection.temporalSection
        (localSection.restrict smaller within).temporalSection.scope (by
          intro index index_le_smaller
          exact index_le_smaller.trans within) =
      (localSection.restrict smaller within).temporalSection :=
  generatedTemporalSection_restriction within

/-- The global `Nat`-indexed object exported by the framework is a family of
finite generated-section receipts.  Each coordinate retains the same source,
registry, actual producer and incidence; the function itself is a readout. -/
def FixedLawNativeTotal.generatedFieldReadout
    {C : Carrier (K := K) (E := E)} {V : Vocabulary C}
    (T : FixedLawNativeTotal V)
    {registry : CarrierAtomFieldRegistry C}
    (recognition : CarrierAtomFieldRecognition C registry)
    (source : Current C) :
    (scope : Nat) -> GeneratedLocalSectionAt T recognition source scope :=
  fun scope =>
    T.generatedLocalSection recognition source scope

end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
