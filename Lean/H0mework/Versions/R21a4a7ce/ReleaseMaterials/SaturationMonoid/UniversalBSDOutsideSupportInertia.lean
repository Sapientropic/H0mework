import Mathlib.NumberTheory.Padics.Complex
import Mathlib.RingTheory.Valuation.RamificationGroup
import H0mework.Versions.R21a4a7ce.ReleaseMaterials.SaturationMonoid.CochainH1KernelConditionProducer
import H0mework.Versions.R21a4a7ce.ReleaseMaterials.SaturationMonoid.UniversalBSDFiniteSupportSelmerComplex

/-!
# Universal BSD outside-support inertia carrier

This module generates local inertia restriction, its unramified H1-kernel condition, and the
closed normal subgroup of the global absolute Galois group generated by all inertia images outside
the source-generated finite support.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace UniversalBSDOutsideSupportInertia

open CategoryTheory
open UniversalBSDGeometricGalois
open UniversalBSDFinitePlaceFullPoint
open UniversalBSDFinitePlaceNTorsionCohomology
open UniversalBSDFiniteSupportSelmer
open CochainH1KernelConditionProducer
open scoped Pointwise

noncomputable section

/-- Valuation subring in the chosen algebraic closure of the actual q-adic field. -/
noncomputable def localValuationSubring (q : Nat.Primes) :
    ValuationSubring (FiniteAlgebraicClosure q) :=
  (PadicAlgCl.valued (q : ℕ)).v.valuationSubring

/-- Decomposition group of the chosen q-adic valuation. -/
noncomputable abbrev LocalDecompositionGroup (q : Nat.Primes) :=
  (localValuationSubring q).decompositionSubgroup (FiniteLocalField q)

theorem localAut_valuation_eq (q : Nat.Primes)
    (σ : FiniteAlgebraicClosure q ≃ₐ[FiniteLocalField q]
      FiniteAlgebraicClosure q) (x : FiniteAlgebraicClosure q) :
    Valued.v (σ x) = Valued.v x := by
  apply NNReal.eq
  rw [PadicAlgCl.valuation_coe, PadicAlgCl.valuation_coe]
  rw [← PadicAlgCl.spectralNorm_eq, ← PadicAlgCl.spectralNorm_eq]
  exact (spectralNorm_eq_of_equiv σ x).symm

theorem localAut_smul_localValuationSubring (q : Nat.Primes)
    (σ : FiniteAlgebraicClosure q ≃ₐ[FiniteLocalField q]
      FiniteAlgebraicClosure q) :
    σ • localValuationSubring q = localValuationSubring q := by
  apply ValuationSubring.ext
  intro x
  rw [ValuationSubring.mem_pointwise_smul_iff_inv_smul_mem]
  change Valued.v (σ⁻¹ x) ≤ 1 ↔ Valued.v x ≤ 1
  rw [localAut_valuation_eq]

/-- Every local Galois automorphism preserves the canonical valuation subring. -/
theorem localDecompositionGroup_eq_top (q : Nat.Primes) :
    LocalDecompositionGroup q = ⊤ := by
  ext σ
  rw [MulAction.mem_stabilizer_iff]
  simp only [Subgroup.mem_top, iff_true]
  exact localAut_smul_localValuationSubring q σ

/-- Inertia subgroup of the chosen q-adic valuation. -/
noncomputable abbrev LocalInertiaGroup (q : Nat.Primes) :=
  (localValuationSubring q).inertiaSubgroup (FiniteLocalField q)

/-- The actual inertia embedding into the local absolute Galois group. -/
noncomputable def localInertiaToGalois (q : Nat.Primes) :
    LocalInertiaGroup q →* Field.absoluteGaloisGroup (FiniteLocalField q) :=
  (LocalDecompositionGroup q).subtype.comp (LocalInertiaGroup q).subtype

noncomputable instance localInertiaTopologicalSpace (q : Nat.Primes) :
    TopologicalSpace (LocalInertiaGroup q) :=
  TopologicalSpace.induced (localInertiaToGalois q)
    (Field.instTopologicalSpaceAbsoluteGaloisGroup (FiniteLocalField q))

noncomputable instance localInertiaIsTopologicalGroup (q : Nat.Primes) :
    IsTopologicalGroup (LocalInertiaGroup q) :=
  topologicalGroup_induced (localInertiaToGalois q)

/-- The inertia embedding with its source-generated induced topology. -/
noncomputable def localInertiaToGaloisContinuous (q : Nat.Primes) :
    LocalInertiaGroup q →ₜ* Field.absoluteGaloisGroup (FiniteLocalField q) :=
  ContinuousMonoidHom.mk (localInertiaToGalois q) continuous_induced_dom

/-- Actual local E[n] representation restricted to inertia. -/
noncomputable abbrev FiniteLocalNTorsionInertiaTopRep
    (source : RationalEllipticCurveSource) (n : ℕ) (q : Nat.Primes) :=
  TopRep.res (localInertiaToGalois q)
    (FiniteLocalNTorsionTopRep source n q)

/-- Actual restriction from local E[n] cochains to inertia cochains. -/
noncomputable def inertiaRestrictionCochainMap
    (source : RationalEllipticCurveSource) (n : ℕ) (q : Nat.Primes) :
    FiniteLocalNTorsionCochainComplex source n q ⟶
      TopRep.homogeneousCochains
        (FiniteLocalNTorsionInertiaTopRep source n q) :=
  ContinuousCohomology.cochainsMap
    (localInertiaToGaloisContinuous q)
    (𝟙 (FiniteLocalNTorsionInertiaTopRep source n q))

private noncomputable abbrev forgetTopModuleComplexNat :=
  (forget₂ (TopModuleCat ℤ) (ModuleCat ℤ)).mapHomologicalComplex
    (ComplexShape.up ℕ)

/-- Inertia restriction after forgetting topology. -/
noncomputable def inertiaRestrictionModuleMap
    (source : RationalEllipticCurveSource) (n : ℕ) (q : Nat.Primes) :=
  forgetTopModuleComplexNat.map (inertiaRestrictionCochainMap source n q)

/-- Unramified local H1 classes as the kernel of actual restriction to inertia. -/
noncomputable abbrev FiniteLocalUnramifiedH1
    (source : RationalEllipticCurveSource) (n : ℕ) (q : Nat.Primes) :=
  ConditionH1 (inertiaRestrictionModuleMap source n q)

/-- Two-term cochain model whose H1 is the actual unramified local condition. -/
noncomputable abbrev FiniteLocalUnramifiedConditionComplex
    (source : RationalEllipticCurveSource) (n : ℕ) (q : Nat.Primes) :=
  ConditionComplex (inertiaRestrictionModuleMap source n q)

/-- The same local inertia occurrence embedded in the global absolute Galois group. -/
noncomputable def localInertiaToGlobal (q : Nat.Primes) :
    LocalInertiaGroup q →* Field.absoluteGaloisGroup ℚ :=
  (localToGlobalGaloisHom q).toMonoidHom.comp
    (localInertiaToGaloisContinuous q).toMonoidHom

/-- Primes outside the source-generated equation/coefficient support. -/
abbrev OutsidePrime
    (source : RationalEllipticCurveSource) (p : Nat.Primes) :=
  { q : Nat.Primes // q ∉ finitePrimeSupport source p }

/-- Subgroup generated by all global inertia images outside support. -/
noncomputable def outsideInertiaSubgroup
    (source : RationalEllipticCurveSource) (p : Nat.Primes) :
    Subgroup (Field.absoluteGaloisGroup ℚ) :=
  ⨆ q : OutsidePrime source p, (localInertiaToGlobal q.1).range

/-- Closed normal subgroup generated by all outside-support inertia images. -/
noncomputable def outsideInertiaClosedNormal
    (source : RationalEllipticCurveSource) (p : Nat.Primes) :
    Subgroup (Field.absoluteGaloisGroup ℚ) :=
  (Subgroup.normalClosure
    (outsideInertiaSubgroup source p : Set (Field.absoluteGaloisGroup ℚ))).topologicalClosure

theorem localInertiaRange_le_outsideInertiaClosedNormal
    (source : RationalEllipticCurveSource) (p : Nat.Primes)
    (q : OutsidePrime source p) :
    (localInertiaToGlobal q.1).range ≤ outsideInertiaClosedNormal source p := by
  intro sigma hsigma
  apply Subgroup.le_topologicalClosure
  apply Subgroup.subset_normalClosure
  exact (le_iSup (fun r : OutsidePrime source p ↦
    (localInertiaToGlobal r.1).range) q) hsigma

noncomputable instance outsideInertiaClosedNormal_normal
    (source : RationalEllipticCurveSource) (p : Nat.Primes) :
    (outsideInertiaClosedNormal source p).Normal := by
  apply Subgroup.is_normal_topologicalClosure

/-- Source-generated role carrier for the Galois group unramified outside the finite support. -/
noncomputable abbrev GaloisUnramifiedOutside
    (source : RationalEllipticCurveSource) (p : Nat.Primes) :=
  Field.absoluteGaloisGroup ℚ ⧸ outsideInertiaClosedNormal source p

@[simp]
theorem quotient_kills_outsideInertia
    (source : RationalEllipticCurveSource) (p : Nat.Primes)
    (q : OutsidePrime source p) (σ : LocalInertiaGroup q.1) :
    QuotientGroup.mk' (outsideInertiaClosedNormal source p)
        (localInertiaToGlobal q.1 σ) = 1 := by
  apply (QuotientGroup.eq_one_iff _).mpr
  apply localInertiaRange_le_outsideInertiaClosedNormal source p q
  exact ⟨σ, rfl⟩

end

end UniversalBSDOutsideSupportInertia
end SaturationMonoid
