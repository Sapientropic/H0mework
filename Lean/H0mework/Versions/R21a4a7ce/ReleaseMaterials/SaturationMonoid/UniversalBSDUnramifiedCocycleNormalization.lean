import H0mework.Versions.R21a4a7ce.ReleaseMaterials.SaturationMonoid.CochainH1KernelConditionContainment
import H0mework.Versions.R21a4a7ce.ReleaseMaterials.SaturationMonoid.UniversalBSDFinitePlaceH1KernelCondition
import H0mework.Versions.R21a4a7ce.ReleaseMaterials.SaturationMonoid.UniversalBSDOutsideSupportInertia

/-!
# Universal BSD unramified cocycle normalization

This module replaces an inertia-trivial local H1 cycle by a cohomologous
actual cocycle whose restriction to inertia is identically zero.  The
construction generates the required degree-zero boundary and extends its
basepoint orbit to the full local Galois group.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace UniversalBSDUnramifiedCocycleNormalization

open CategoryTheory
open CategoryTheory.Limits
open UniversalBSDGeometricGalois
open UniversalBSDGeometricNTorsion
open UniversalBSDFinitePlaceFullPoint
open UniversalBSDFinitePlaceNTorsionCohomology
open UniversalBSDFinitePlaceH1KernelCondition
open UniversalBSDOutsideSupportInertia
open CochainH1KernelConditionProducer
open CochainH1KernelConditionContainment

noncomputable section

set_option maxHeartbeats 3000000

private noncomputable abbrev FiniteInertiaModuleComplex
    (source : RationalEllipticCurveSource) (n : ℕ) (q : Nat.Primes) :=
  ((forget₂ (TopModuleCat ℤ) (ModuleCat ℤ)).mapHomologicalComplex
    (ComplexShape.up ℕ)).obj
      (TopRep.homogeneousCochains
        (FiniteLocalNTorsionInertiaTopRep source n q))

/-- Vanishing of the inertia H1 class generates an actual inertia
degree-zero boundary for the restricted cocycle. -/
theorem exists_inertiaBoundary_of_h1_eq_zero
    (source : RationalEllipticCurveSource) (n : ℕ) (q : Nat.Primes)
    (z : (NTorsionModuleComplex source n q).cycles 1)
    (hzero :
      (h1Map (inertiaRestrictionModuleMap source n q)).hom
          (((NTorsionModuleComplex source n q).homologyπ 1).hom z) = 0) :
    ∃ qI :
        (TopRep.homogeneousCochains
          (FiniteLocalNTorsionInertiaTopRep source n q)).X 0,
      ((inertiaRestrictionCochainMap source n q).f 1).hom
          (((NTorsionModuleComplex source n q).iCycles 1).hom z) =
        ((TopRep.homogeneousCochains
          (FiniteLocalNTorsionInertiaTopRep source n q)).d 0 1).hom qI := by
  let C := NTorsionModuleComplex source n q
  let I := FiniteInertiaModuleComplex source n q
  let restriction := inertiaRestrictionModuleMap source n q
  have hnat := ConcreteCategory.congr_hom
    (HomologicalComplex.homologyπ_naturality restriction 1) z
  simp only [ConcreteCategory.comp_apply] at hnat
  have hrestrictedHomologyZero :
      (I.homologyπ 1).hom
          ((HomologicalComplex.cyclesMap restriction 1).hom z) = 0 :=
    hnat.symm.trans hzero
  obtain ⟨qI, hqI⟩ := exists_degreeOne_boundary_of_homologyπ_eq_zero
    I ((HomologicalComplex.cyclesMap restriction 1).hom z)
      hrestrictedHomologyZero
  have hcyclesMap := ConcreteCategory.congr_hom
    (HomologicalComplex.cyclesMap_i restriction 1) z
  simp only [ConcreteCategory.comp_apply] at hcyclesMap
  refine ⟨qI, ?_⟩
  exact hcyclesMap.symm.trans hqI.symm

/-- The homogeneous orbit zero-cochain generated by one coefficient point. -/
noncomputable def orbitZeroCochain
    {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    (X : TopRep ℤ G) (point : X)
    (hcontinuous : Continuous (fun sigma : G ↦ X.ρ sigma point)) :
    (TopRep.homogeneousCochains X).X 0 := by
  refine ⟨⟨fun sigma ↦ X.ρ sigma point, ?_⟩, ?_⟩
  · exact hcontinuous
  · intro t
    ext sigma
    change X.ρ t (X.ρ (t⁻¹ * sigma) point) = X.ρ sigma point
    change ((X.ρ t) * (X.ρ (t⁻¹ * sigma))) point = X.ρ sigma point
    rw [← map_mul]
    simp

@[simp]
theorem orbitZeroCochain_apply
    {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    (X : TopRep ℤ G) (point : X)
    (hcontinuous : Continuous (fun sigma : G ↦ X.ρ sigma point))
    (sigma : G) :
    (orbitZeroCochain X point hcontinuous).1 sigma = X.ρ sigma point :=
  rfl

private theorem homogeneousZeroCochain_apply_eq_action
    {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    (X : TopRep ℤ G)
    (q₀ : (TopRep.homogeneousCochains X).X 0)
    (sigma : G) :
    q₀.1 sigma = X.ρ sigma (q₀.1 1) := by
  have h := DFunLike.ext_iff.1 (q₀.2 sigma) sigma
  simpa [ContRepresentation.coind₁_apply_apply] using h.symm

private theorem finiteLocalNTorsion_orbit_continuous
    (source : RationalEllipticCurveSource) (n : ℕ) (q : Nat.Primes)
    (point : FiniteLocalNTorsionTopRep source n q) :
    Continuous (fun sigma : Field.absoluteGaloisGroup (FiniteLocalField q) ↦
      (FiniteLocalNTorsionTopRep source n q).ρ sigma point) := by
  let point' : GeometricNTorsion source n := point
  change Continuous (fun sigma : Field.absoluteGaloisGroup (FiniteLocalField q) ↦
    (localToGlobalGaloisHom q sigma) • point')
  fun_prop

/-- An inertia-trivial H1 class has a cohomologous actual cocycle whose
restriction cochain is identically zero. -/
theorem exists_cohomologous_cycle_restriction_eq_zero
    (source : RationalEllipticCurveSource) (n : ℕ) (q : Nat.Primes)
    (z : (NTorsionModuleComplex source n q).cycles 1)
    (hzero :
      (h1Map (inertiaRestrictionModuleMap source n q)).hom
          (((NTorsionModuleComplex source n q).homologyπ 1).hom z) = 0) :
    ∃ z' : (NTorsionModuleComplex source n q).cycles 1,
      ((NTorsionModuleComplex source n q).homologyπ 1).hom z' =
          ((NTorsionModuleComplex source n q).homologyπ 1).hom z ∧
        (HomologicalComplex.cyclesMap
          (inertiaRestrictionModuleMap source n q) 1).hom z' = 0 := by
  let C := NTorsionModuleComplex source n q
  let I := FiniteInertiaModuleComplex source n q
  let restriction := inertiaRestrictionModuleMap source n q
  obtain ⟨qI, hboundaryI⟩ :=
    exists_inertiaBoundary_of_h1_eq_zero source n q z hzero
  let point : FiniteLocalNTorsionTopRep source n q := qI.1 1
  let qGTop : (FiniteLocalNTorsionCochainComplex source n q).X 0 :=
    orbitZeroCochain (FiniteLocalNTorsionTopRep source n q) point
      (finiteLocalNTorsion_orbit_continuous source n q point)
  let qG : C.X 0 := qGTop
  have hrestrictQTop :
      ((inertiaRestrictionCochainMap source n q).f 0).hom qGTop = qI := by
    apply Subtype.ext
    ext sigma
    change (FiniteLocalNTorsionTopRep source n q).ρ
        (localInertiaToGalois q sigma) point = qI.1 sigma
    exact (homogeneousZeroCochain_apply_eq_action
      (FiniteLocalNTorsionInertiaTopRep source n q) qI sigma).symm
  have hrestrictQ : (restriction.f 0).hom qG = qI := by
    exact hrestrictQTop
  let z' : C.cycles 1 := z - (C.toCycles 0 1).hom qG
  refine ⟨z', ?_, ?_⟩
  · dsimp [z']
    rw [map_sub]
    have hboundaryHomology := ConcreteCategory.congr_hom
      (C.toCycles_comp_homologyπ 0 1) qG
    simp only [ConcreteCategory.comp_apply] at hboundaryHomology
    have hboundaryHomology' :
        (C.homologyπ 1).hom ((C.toCycles 0 1).hom qG) = 0 := by
      simpa only [ModuleCat.hom_zero, LinearMap.zero_apply] using hboundaryHomology
    rw [hboundaryHomology', sub_zero]
  · apply (ModuleCat.mono_iff_injective (I.iCycles 1)).mp inferInstance
    rw [map_zero]
    have hcyclesMap := ConcreteCategory.congr_hom
      (HomologicalComplex.cyclesMap_i restriction 1) z'
    simp only [ConcreteCategory.comp_apply] at hcyclesMap
    rw [hcyclesMap]
    have hiz : (C.iCycles 1).hom z' =
        (C.iCycles 1).hom z - (C.d 0 1).hom qG := by
      dsimp [z']
      rw [map_sub]
      have htoCycles := ConcreteCategory.congr_hom (C.toCycles_i 0 1) qG
      simp only [ConcreteCategory.comp_apply] at htoCycles
      rw [htoCycles]
    rw [hiz, map_sub]
    have hcomm := ConcreteCategory.congr_hom (restriction.comm 0 1) qG
    simp only [ConcreteCategory.comp_apply] at hcomm
    have hboundaryIModule :
        (restriction.f 1).hom ((C.iCycles 1).hom z) = (I.d 0 1).hom qI := by
      exact hboundaryI
    rw [hboundaryIModule, ← hcomm, hrestrictQ, sub_self]

end

end UniversalBSDUnramifiedCocycleNormalization
end SaturationMonoid

