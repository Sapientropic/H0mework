import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Root.Epoch.Finance.Future.Continuation.Family
import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Root.Epoch.Finance.Future.Structure
import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Root.Epoch.Finance.Future.Finiteness
import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Root.Epoch.Finance.Future.FoundationKeys

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Root.Epoch.Finance.Future.Installed

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Root

noncomputable section

variable {Party Good Port Technology Instrument : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Port] [DecidableEq Instrument]
  (input : ProgrammeSource.Input Party Good Port Technology Instrument)
  (depth count sourceDepth sourceCount : Nat)
  {current : ResponsibilityState (vocabulary input depth count)}
  (run : (process input depth count).Run (initial input depth count sourceDepth sourceCount).current current)
  (account : (process input depth count).GeneratedState)
  (native : Nonempty ((process input depth count).Run current account.current))

include native in
private theorem later {target : (process input depth count).GeneratedState}
    (tail : Continuation.NativeTail input depth count account target) :
    Nonempty ((process input depth count).Run current target.current) := by
  obtain ⟨prior⟩ := native
  exact tail.map fun future => prior.concatRuns (process input depth count) future

/-- The continuation family is generated by the same installed shape and
actual native suffix that generated its current world. -/
def accountFamily : Continuation.AccountFamily input depth count
    (Future.world input depth count (base input depth count sourceDepth sourceCount)
      (initial input depth count sourceDepth sourceCount) run) account where
  support := fun target tail => support input depth count sourceDepth sourceCount run target
    (later input depth count account native tail)
  owner := fun target tail => owner input depth count sourceDepth sourceCount run target
    (later input depth count account native tail)
  itemEvolution := fun target tail item => itemEvolution input depth count sourceDepth sourceCount run target
    (later input depth count account native tail) item
  item_keys := fun target tail item =>
    Structure.future_evolution_keys input depth count _ _ _
      (Structure.shape_evolution_keys input depth count _ _ _ target _ item) run target
      (later input depth count account native tail) item
  entries_finite := fun target tail =>
    Finiteness.future_support_finite input depth count _ _
      (Finiteness.shape_support_finite input depth count _ _ target _) run target
      (later input depth count account native tail)
  open_fibres := Structure.future_fibres input depth count _
    (Structure.shape_fibres input depth count _) run
  entry := canonicalEntry input depth count sourceDepth sourceCount run
  entry_key := canonicalEntry_key input depth count sourceDepth sourceCount run
  disposition := canonicalDisposition input depth count sourceDepth sourceCount run

theorem continuation_starts_at_the_same_complete_account :
    (accountFamily input depth count sourceDepth sourceCount run account native).initial = account ∧
      (accountFamily input depth count sourceDepth sourceCount run account native).currentSupport =
        support input depth count sourceDepth sourceCount run account native := ⟨rfl, rfl⟩

theorem continuation_consumes_the_same_original_item
    (item : ActualItem input depth count) :
    (accountFamily input depth count sourceDepth sourceCount run account native).itemEvolution account ⟨.nil⟩ item =
      itemEvolution input depth count sourceDepth sourceCount run account native item := rfl

#print axioms accountFamily
#print axioms continuation_starts_at_the_same_complete_account
#print axioms continuation_consumes_the_same_original_item

end
end SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Root.Epoch.Finance.Future.Installed
