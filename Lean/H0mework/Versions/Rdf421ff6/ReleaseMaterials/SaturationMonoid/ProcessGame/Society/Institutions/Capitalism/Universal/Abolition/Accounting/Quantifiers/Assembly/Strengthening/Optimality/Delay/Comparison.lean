import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Accounting.Quantifiers.Assembly.Strengthening.Optimality.Delay.History
import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Accounting.Quantifiers.Coalition.Restitution.Settlement

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Accounting.Quantifiers.Assembly.Strengthening.Optimality.Delay

open Source.Program Innovation
noncomputable section
attribute [local irreducible] Joint.actualLaw

variable {Party Good Port Technology Instrument : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Port] [DecidableEq Instrument]
  {mechanism : Trials.Mechanism Party Good Port Technology Instrument}
  {past : List (RawEvent Party Good Port Technology Instrument)} {nature : mechanism.Nature}
  {response : Control.HistoryResponse (Party := Party) (Good := Good) (Port := Port)
    (Technology := Technology) (Instrument := Instrument)}
  (seed : Global.Seed (mechanism := mechanism) (past := past) (nature := nature) (response := response))
  (claim : Entitlement.Source.Claim (Joint.window seed))

/-- Both candidates start at the same original cursor. The complete payoff
difference is generated by real retained effects, not by postponing this origin's debt. -/
theorem any_two_programs_preserve_the_entire_payoff_difference
    (current : Joint.Current seed claim)
    (delayed baseline : List (RawEvent Party Good Port Technology Instrument)) :
    (income seed claim current delayed +
        Coalition.Restitution.liability seed claim (Joint.Boundary.afterInputs seed claim current delayed)) -
      (income seed claim current baseline +
        Coalition.Restitution.liability seed claim (Joint.Boundary.afterInputs seed claim current baseline)) =
      retained seed claim current delayed - retained seed claim current baseline := by
  rw [every_program_prefix_is_charged_against_its_original_liability,
    every_program_prefix_is_charged_against_its_original_liability]
  abel

theorem every_coalition_retains_all_real_contributions_and_other_positions
    (current : Joint.Current seed claim)
    (delayed baseline : List (RawEvent Party Good Port Technology Instrument))
    (members : Party → Bool) (good : Good) :
    Coalition.read members good (income seed claim current delayed +
        Coalition.Restitution.liability seed claim (Joint.Boundary.afterInputs seed claim current delayed)) -
      Coalition.read members good (income seed claim current baseline +
        Coalition.Restitution.liability seed claim (Joint.Boundary.afterInputs seed claim current baseline)) =
      Coalition.read members good (retained seed claim current delayed) -
        Coalition.read members good (retained seed claim current baseline) := by
  simpa only [map_sub] using congrArg (Coalition.read members good)
    (any_two_programs_preserve_the_entire_payoff_difference seed claim current delayed baseline)

theorem no_coalition_has_an_extra_original_control_return_at_any_prefix
    (current : Joint.Current seed claim)
    (delayed baseline : List (RawEvent Party Good Port Technology Instrument))
    (members : Party → Bool) (good : Good) :
    Coalition.read members good ((income seed claim current delayed +
        Coalition.Restitution.liability seed claim (Joint.Boundary.afterInputs seed claim current delayed)) -
      (income seed claim current baseline +
        Coalition.Restitution.liability seed claim (Joint.Boundary.afterInputs seed claim current baseline)) -
      (retained seed claim current delayed - retained seed claim current baseline)) = 0 := by
  rw [any_two_programs_preserve_the_entire_payoff_difference,sub_self,map_zero]

/-- A consumer of actual terminal debt facts; the generic comparison above
already covers every unpaid prefix and does not assume these endpoints. -/
theorem completed_programs_keep_exactly_their_other_real_flows
    (current : Joint.Current seed claim)
    (delayed baseline : List (RawEvent Party Good Port Technology Instrument))
    (delayedPaid : Joint.Current.grossPaid seed claim (Joint.Boundary.afterInputs seed claim current delayed))
    (baselinePaid : Joint.Current.grossPaid seed claim (Joint.Boundary.afterInputs seed claim current baseline)) :
    income seed claim current delayed - income seed claim current baseline =
      retained seed claim current delayed - retained seed claim current baseline := by
  have compared := any_two_programs_preserve_the_entire_payoff_difference seed claim current delayed baseline
  rw [Coalition.Restitution.a_paid_original_matrix_has_no_remaining_restitution_position seed claim _ delayedPaid,
    Coalition.Restitution.a_paid_original_matrix_has_no_remaining_restitution_position seed claim _ baselinePaid,
    add_zero,add_zero] at compared
  exact compared

end
end SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Accounting.Quantifiers.Assembly.Strengthening.Optimality.Delay
