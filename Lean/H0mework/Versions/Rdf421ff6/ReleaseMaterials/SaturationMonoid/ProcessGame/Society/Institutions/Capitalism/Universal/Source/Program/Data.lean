import Mathlib.Algebra.Order.Ring.Unbundled.Rat
import Mathlib.Data.List.Basic

/-!
# Raw local socioeconomic instructions

Party and relation keys are source seeds, never actor identities.  Their
actors and roles are generated by the original occurrence's lineage and
relation compilers.  Stocks and financial positions are economic state;
responsibility authority remains exclusively in the original root ledger.
-/

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Source.Program

universe u

variable (Party Good Port Technology Instrument : Type u)

abbrev Bundle := List (Good × ℚ)

def amount [DecidableEq Good] (bundle : Bundle Good) (good : Good) : ℚ :=
  (bundle.map (fun item => if item.1 = good then item.2 else 0)).sum

def NonnegativeBundle (bundle : Bundle Good) : Prop :=
  ∀ item ∈ bundle, 0 ≤ item.2

instance (bundle : Bundle Good) : Decidable (NonnegativeBundle Good bundle) :=
  inferInstanceAs (Decidable (∀ item ∈ bundle, 0 ≤ item.2))

structure Technique where
  inputs : Bundle Good
  outputs : Bundle Good
  maintenance : Bundle Good
  requiredPorts : List Port

/-- These categories describe uses in the source programme, not economic
systems or dependence verdicts.  Investment remains distinct from required
maintenance and actual necessity delivery. -/
inductive Use
  | necessity | maintenance | investment | contribution | external
  deriving DecidableEq

inductive Operation
  | produce (operator : Party)
  | transfer (sender recipient : Party) (goods : Bundle Good)
  | use (bearer : Party) (goods : Bundle Good) (purpose : Use)
  | issue (instrument : Instrument) (issuer beneficiary : Party) (quantity : ℚ)
  | assign (instrument : Instrument) (issuer sender recipient : Party) (quantity : ℚ)
  | settle (instrument : Instrument) (debtor creditor : Party) (quantity : ℚ)
  | revise (operator : Party) (technology : Technology)
  | present

structure Request where
  signer : Party
  consents : List Party
  purpose : Port
  gates : List Port
  operation : Operation Party Good Technology Instrument

structure RawCurrent where
  stock : Party → Good → ℚ
  claims : Instrument → Party → Party → ℚ
  technology : Technology
  clock : ℚ
  round : Nat

theorem RawCurrent.ext {left right : RawCurrent Party Good Technology Instrument}
    (stock : left.stock = right.stock) (claims : left.claims = right.claims)
    (technology : left.technology = right.technology) (clock : left.clock = right.clock)
    (round : left.round = right.round) : left = right := by
  cases left
  cases right
  cases stock
  cases claims
  cases technology
  cases clock
  cases round
  rfl

end SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Source.Program
