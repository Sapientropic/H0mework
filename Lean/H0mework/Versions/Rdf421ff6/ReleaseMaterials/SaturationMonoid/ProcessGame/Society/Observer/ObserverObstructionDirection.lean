import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Observer.NaturalReconstruction

/-!
# Observer obstruction-generated direction

An authority-changing vertical automorphism already contains enough source
data to generate its exact kernel pair: the anchored occurrence and its
automorphism image.  This module seals that pair as one rooted observer
obstruction and lets the obstruction generate a unique zero-information
attaching direction whose boundary is exactly the rooted pair.

This is a local observer construction.  It creates no living-law root,
ledger, receipt registry, occurrence registry, revision, or completed future.
No finiteness or chosen calibration scope enters the interface.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace Observer

universe uOccurrence uVisible uResidual

variable {Occurrence : Type uOccurrence}
variable {Visible : Type uVisible}
variable {Residual : Type uResidual}
variable {O : AuthorityObserver Occurrence Visible Residual}

/-- The exact authority kernel pair canonically generated by the anchor of a
vertical automorphism.  Inequality and both commuting facts are derived from
the automorphism laws; no pair is accepted from the caller. -/
def canonicalAuthorityKernelPair
    (vertical : AuthorityChangingVerticalAutomorphism O) :
    AuthorityKernelPair O where
  left := vertical.anchorOccurrence
  right := vertical.automorphism.occurrenceEquiv vertical.anchorOccurrence
  occurrence_ne := by
    intro occurrenceEq
    apply vertical.changesAuthorityOnFiber
      vertical.anchorOccurrence vertical.anchor_reachable
    calc
      vertical.automorphism.authorityEquiv
          (O.authorityK vertical.anchorOccurrence) =
          O.authorityK
            (vertical.automorphism.occurrenceEquiv
              vertical.anchorOccurrence) :=
        (vertical.automorphism.authority_commutes
          vertical.anchorOccurrence).symm
      _ = O.authorityK vertical.anchorOccurrence :=
        congrArg O.authorityK occurrenceEq.symm
  visible_eq := by
    calc
      O.forget vertical.anchorOccurrence = vertical.anchor :=
        vertical.anchor_reachable
      _ = vertical.automorphism.visibleEquiv vertical.anchor :=
        vertical.fixesVisible.symm
      _ = vertical.automorphism.visibleEquiv
          (O.forget vertical.anchorOccurrence) :=
        congrArg vertical.automorphism.visibleEquiv
          vertical.anchor_reachable.symm
      _ = O.forget
          (vertical.automorphism.occurrenceEquiv
            vertical.anchorOccurrence) :=
        (vertical.automorphism.forget_commutes
          vertical.anchorOccurrence).symm
  authority_ne := by
    intro authorityEq
    apply vertical.changesAuthorityOnFiber
      vertical.anchorOccurrence vertical.anchor_reachable
    calc
      vertical.automorphism.authorityEquiv
          (O.authorityK vertical.anchorOccurrence) =
          O.authorityK
            (vertical.automorphism.occurrenceEquiv
              vertical.anchorOccurrence) :=
        (vertical.automorphism.authority_commutes
          vertical.anchorOccurrence).symm
      _ = O.authorityK vertical.anchorOccurrence := authorityEq.symm

@[simp] theorem canonicalAuthorityKernelPair_left
    (vertical : AuthorityChangingVerticalAutomorphism O) :
    (canonicalAuthorityKernelPair vertical).left =
      vertical.anchorOccurrence :=
  rfl

@[simp] theorem canonicalAuthorityKernelPair_right
    (vertical : AuthorityChangingVerticalAutomorphism O) :
    (canonicalAuthorityKernelPair vertical).right =
      vertical.automorphism.occurrenceEquiv vertical.anchorOccurrence :=
  rfl

/-- One rooted obstruction indexed by the exact vertical automorphism.  The
private constructor prevents a caller from substituting a sibling kernel
pair while retaining the same vertical index. -/
structure RootedObserverObstructionAt
    (vertical : AuthorityChangingVerticalAutomorphism O) where
  private mk ::
  kernelPair : AuthorityKernelPair O
  left_eq_anchor : kernelPair.left = vertical.anchorOccurrence
  right_eq_image : kernelPair.right =
    vertical.automorphism.occurrenceEquiv vertical.anchorOccurrence

/-- Canonical rooted obstruction generated directly from the vertical
automorphism. -/
def rootedObserverObstruction
    (vertical : AuthorityChangingVerticalAutomorphism O) :
    RootedObserverObstructionAt vertical :=
  ⟨canonicalAuthorityKernelPair vertical, rfl, rfl⟩

namespace RootedObserverObstructionAt

variable {vertical : AuthorityChangingVerticalAutomorphism O}

/-- The private rooted carrier contains no choice: every inhabitant is the
canonical obstruction generated by its vertical index. -/
theorem eq_canonical (rooted : RootedObserverObstructionAt vertical) :
    rooted = rootedObserverObstruction vertical := by
  cases rooted
  rename_i kernelPair leftEq rightEq
  cases kernelPair
  rename_i left right occurrenceNe visibleEq authorityNe
  dsimp at leftEq rightEq
  subst left
  subst right
  rfl

end RootedObserverObstructionAt

/-- The unique zero-information direction generated by one exact rooted
observer obstruction.  Its information is entirely in the dependent index. -/
inductive GeneratedObserverDirectionAt
    {vertical : AuthorityChangingVerticalAutomorphism O}
    (rooted : RootedObserverObstructionAt vertical) : Type
  | generated

namespace GeneratedObserverDirectionAt

variable {vertical : AuthorityChangingVerticalAutomorphism O}
variable {rooted : RootedObserverObstructionAt vertical}

/-- Boundary readout of a generated direction.  It is definitionally the
exact kernel pair stored in the rooted obstruction. -/
def boundary (_direction : GeneratedObserverDirectionAt rooted) :
    AuthorityKernelPair O :=
  rooted.kernelPair

@[simp] theorem generated_boundary_eq :
    boundary (rooted := rooted) .generated = rooted.kernelPair :=
  rfl

/-- The failure-indexed direction carries no caller-selectable information. -/
theorem eq_generated (direction : GeneratedObserverDirectionAt rooted) :
    direction = .generated := by
  cases direction
  rfl

end GeneratedObserverDirectionAt

/-- Dependent attaching law: the generated direction lands on the exact
kernel-pair boundary of the same rooted obstruction. -/
inductive GeneratedObserverDirectionBoundaryAt
    {vertical : AuthorityChangingVerticalAutomorphism O}
    (rooted : RootedObserverObstructionAt vertical) :
    (direction : GeneratedObserverDirectionAt rooted) →
      AuthorityKernelPair O → Type
  | exact : GeneratedObserverDirectionBoundaryAt
      rooted .generated rooted.kernelPair

/-- Sealed attaching direction generated by one exact rooted obstruction.
The private constructor prevents callers from pairing a valid boundary with
an independently selected direction. -/
structure SourceGeneratedObserverAttachingDirectionAt
    {vertical : AuthorityChangingVerticalAutomorphism O}
    (rooted : RootedObserverObstructionAt vertical) where
  private mk ::
  direction : GeneratedObserverDirectionAt rooted
  boundaryLaw : GeneratedObserverDirectionBoundaryAt
    rooted direction rooted.kernelPair

/-- The rooted obstruction canonically generates its attaching direction;
there is no semantic payload parameter. -/
def sourceGeneratedObserverAttachingDirection
    {vertical : AuthorityChangingVerticalAutomorphism O}
    (rooted : RootedObserverObstructionAt vertical) :
    SourceGeneratedObserverAttachingDirectionAt rooted :=
  ⟨.generated, .exact⟩

/-- End-to-end producer from a vertical observer obstruction to its sealed
attaching direction. -/
def canonicalObserverObstructionDirection
    (vertical : AuthorityChangingVerticalAutomorphism O) :
    SourceGeneratedObserverAttachingDirectionAt
      (rootedObserverObstruction vertical) :=
  sourceGeneratedObserverAttachingDirection
    (rootedObserverObstruction vertical)

namespace SourceGeneratedObserverAttachingDirectionAt

variable {vertical : AuthorityChangingVerticalAutomorphism O}
variable {rooted : RootedObserverObstructionAt vertical}

/-- Public boundary readout of a sealed attachment. -/
def boundaryKernelPair
    (attachment : SourceGeneratedObserverAttachingDirectionAt rooted) :
    AuthorityKernelPair O :=
  attachment.direction.boundary

@[simp] theorem boundaryKernelPair_eq_rooted
    (attachment : SourceGeneratedObserverAttachingDirectionAt rooted) :
    attachment.boundaryKernelPair = rooted.kernelPair :=
  rfl

/-- The generated boundary itself carries the visible-authority
factorization obstruction. -/
theorem boundary_noAuthorityFactorization
    (attachment : SourceGeneratedObserverAttachingDirectionAt rooted) :
    ¬ Nonempty (AuthorityFactorization O) :=
  attachment.boundaryKernelPair.noAuthorityFactorization

/-- The generated boundary itself rules out an occurrence-valued left
inverse of the observer. -/
theorem boundary_noOccurrenceLeftInverse
    (attachment : SourceGeneratedObserverAttachingDirectionAt rooted) :
    ¬ ∃ reconstruct : Visible → Occurrence,
      Function.LeftInverse reconstruct O.forget :=
  attachment.boundaryKernelPair.noOccurrenceLeftInverse

/-- The generated boundary directly emits the full natural authority
reconstruction no-go. -/
theorem boundary_noNaturalAuthorityReconstruction
    (attachment : SourceGeneratedObserverAttachingDirectionAt rooted) :
    ¬ Nonempty (NaturalAuthorityReconstruction O) :=
  attachment.boundaryKernelPair.noNaturalAuthorityReconstruction

/-- Every sealed attachment at one rooted obstruction is the canonical one.
Uniqueness follows from the dependent boundary law, not proof-irrelevant
postselection. -/
theorem eq_canonical
    (attachment : SourceGeneratedObserverAttachingDirectionAt rooted) :
    attachment = sourceGeneratedObserverAttachingDirection rooted := by
  cases attachment
  rename_i direction boundaryLaw
  cases boundaryLaw
  rfl

end SourceGeneratedObserverAttachingDirectionAt

@[simp] theorem canonicalObserverObstructionDirection_boundary
    (vertical : AuthorityChangingVerticalAutomorphism O) :
    (canonicalObserverObstructionDirection vertical).boundaryKernelPair =
      (rootedObserverObstruction vertical).kernelPair :=
  rfl

/-- The canonical attaching object carries the exact dependent boundary law. -/
def canonicalObserverObstructionDirection_boundaryLaw
    (vertical : AuthorityChangingVerticalAutomorphism O) :
    GeneratedObserverDirectionBoundaryAt
      (rootedObserverObstruction vertical)
      (canonicalObserverObstructionDirection vertical).direction
      (rootedObserverObstruction vertical).kernelPair :=
  (canonicalObserverObstructionDirection vertical).boundaryLaw

end Observer
end Society
end ProcessGame
end SaturationMonoid
