import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.PublicFunction.Protocol.SymbolicAuthentication.RecoveryRun
import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.PublicFunction.Protocol.SymbolicAuthentication.InterferenceValidity

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Society.PublicFunction.Protocol.SymbolicAuthentication.BatchRecoveryPlan

open Distributed Reaction Reaction.Feedback
open Institutions.Capitalism.Universal.Source.Program Institutions.Capitalism.Universal.Root
open Distributed.Recall.Information.Agency.Protocol Continuation

variable {Party Good Port Technology Instrument : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Port]
  [DecidableEq Technology] [DecidableEq Instrument]
  (model : Native.Authority.Bound (Party := Party) (Good := Good) (Port := Port)
    (Technology := Technology) (Instrument := Instrument))
  (start : Cursor model.source.code)
  (vocabulary : OwnedAttestation.Vocabulary (Party := Party) (Good := Good) (Port := Port)
    (Technology := Technology) (Instrument := Instrument))
  (encoding : StageTransport.Encoding (code := model.source.code)) (law : StageReception.Law model.source.code)

abbrev State := CompletionState.State model
abbrev Stages := BatchReentry.Stages model
abbrev Task := Stages model × Fin model.source.code.sites

def tasks (state : State model) : List (Task model) :=
  (state.batches.flatMap fun entry =>
    (List.finRange model.source.code.sites).map fun site => (entry, site)).filter fun task => decide
      (RetainedIntent.intent vocabulary encoding law start task.1 task.2 ≠ [] ∧
        ¬ InterferenceValidity.served model start vocabulary encoding law task.1 state.past task.2)

def select (state : State model) := (tasks model start vocabulary encoding law state).head?
def recoveryProgram (state : State model) (task : Task model) :=
  RecoveryWindow.program model start state.past task.1.length vocabulary encoding law

inductive Plan (state : State model) where
  | queued (head : Rule model.source.code) (tail : List (Rule model.source.code))
      (actual : state.todo = head :: tail)
  | recovery (task : Task model)
      (selected : select model start vocabulary encoding law state = some task)
      (nonempty : recoveryProgram model start vocabulary encoding law state task ≠ [])

def program {state : State model} : Plan model start vocabulary encoding law state → List (Rule model.source.code)
  | .queued head tail _ => head :: tail
  | .recovery task _ _ => recoveryProgram model start vocabulary encoding law state task

def jobs {state : State model} : Plan model start vocabulary encoding law state → List (Stages model)
  | .queued _ _ _ => state.batches
  | .recovery _ _ _ => state.batches

theorem program_nonempty {state : State model} (plan : Plan model start vocabulary encoding law state) :
    program model start vocabulary encoding law plan ≠ [] := by
  cases plan with
  | queued => simp [program]
  | recovery task selected nonempty => exact nonempty

def rule {state : State model} (plan : Plan model start vocabulary encoding law state) :=
  (program model start vocabulary encoding law plan).headD SilentWindow.quiet

def after (state : State model) (plan : Plan model start vocabulary encoding law state)
    (move : Move model.source.code) : State model :=
  ⟨state.past ++ [(rule model start vocabulary encoding law plan, EventStep.fixed move)],
    (program model start vocabulary encoding law plan).drop 1, jobs model start vocabulary encoding law plan⟩

inductive Halt where
  | noRecoveryTime | noOutstandingTask
  deriving DecidableEq
inductive Preparation (state : State model) where
  | ready (plan : Plan model start vocabulary encoding law state)
  | halted (reason : Halt)

def prepare (state : State model) : Preparation model start vocabulary encoding law state :=
  match pending : state.todo with
  | head :: tail => .ready (.queued head tail pending)
  | [] => match chosen : select model start vocabulary encoding law state with
    | some task =>
      if nonempty : recoveryProgram model start vocabulary encoding law state task ≠ [] then
        .ready (.recovery task chosen nonempty)
      else .halted .noRecoveryTime
    | none => .halted .noOutstandingTask

def initial (past : Stages model) : State model := ⟨past, [], []⟩
-- This entry also preserves a registry already generated by the original producer.
def original (past : Stages model) : State model :=
  let prior := BatchReentry.produce model start vocabulary encoding law past
  ⟨prior.stages, [], prior.batches⟩

theorem a_selected_task_is_an_outstanding_original_entry (state : State model) (task : Task model)
    (selected : select model start vocabulary encoding law state = some task) :
    task.1 ∈ state.batches ∧
    RetainedIntent.intent vocabulary encoding law start task.1 task.2 ≠ [] ∧
    ¬ InterferenceValidity.served model start vocabulary encoding law task.1 state.past task.2 := by
  have member : task ∈ tasks model start vocabulary encoding law state := List.mem_of_head? selected
  have filtered := List.mem_filter.mp member
  obtain ⟨entry, present, siteMember⟩ := List.mem_flatMap.mp filtered.1
  obtain ⟨site, _, same⟩ := List.mem_map.mp siteMember
  cases same
  exact ⟨present, of_decide_eq_true filtered.2⟩

theorem the_selected_program_uses_the_literal_registered_snapshot
    (state : State model) (task : Task model)
    (retained : CompletionState.entriesAreActualPrefixes model state)
    (selected : select model start vocabulary encoding law state = some task) :
    recoveryProgram model start vocabulary encoding law state task =
      List.replicate (RecoveryWindow.supplyCount model start state.past)
        (LocalSupply.protocol vocabulary law start state.past) ++
      List.replicate (RecoveryWindow.serviceCount model start state.past)
        (RetainedIntent.protocol vocabulary encoding law start task.1) := by
  have registered := (a_selected_task_is_an_outstanding_original_entry model start vocabulary encoding law state task selected).1
  have kept := retained task.1 registered
  have literal : state.past.take task.1.length = task.1 := (List.prefix_iff_eq_take.mp kept).symm
  simp only [recoveryProgram, RecoveryWindow.program, RecoveryWindow.entry, literal]

theorem every_edge_preserves_the_literal_original_registry (state : State model)
    (plan : Plan model start vocabulary encoding law state) (move : Move model.source.code) :
    (after model start vocabulary encoding law state plan move).batches = state.batches := by
  cases plan <;> rfl

theorem every_edge_keeps_all_old_entries (state : State model)
    (plan : Plan model start vocabulary encoding law state) (move : Move model.source.code) :
    state.batches ⊆ (after model start vocabulary encoding law state plan move).batches := by
  cases plan with
  | queued => exact fun _ member => member
  | recovery => exact fun _ member => member

theorem every_edge_keeps_all_actual_prefixes (state : State model)
    (plan : Plan model start vocabulary encoding law state) (move : Move model.source.code)
    (retained : CompletionState.entriesAreActualPrefixes model state) :
    CompletionState.entriesAreActualPrefixes model (after model start vocabulary encoding law state plan move) := by
  have extension : state.past <+: (after model start vocabulary encoding law state plan move).past := List.prefix_append _ _
  cases plan with
  | queued => exact fun entry member => (retained entry member).trans extension
  | recovery task selected nonempty =>
    exact fun entry member => (retained entry member).trans extension

theorem original_entries_are_actual (past : Stages model) :
    CompletionState.entriesAreActualPrefixes model (original model start vocabulary encoding law past) := by
  intro entry member
  have recorded := BatchReentry.every_recorded_batch_is_executed_in_the_final_history model start vocabulary encoding law
    (BatchReentry.fuel model start past) past entry member
  exact (IntentServiceRun.every_result_keeps_the_whole_original_prefix vocabulary encoding law start entry (OriginQueue.environment start)).trans recorded.2

end SaturationMonoid.ProcessGame.Society.PublicFunction.Protocol.SymbolicAuthentication.BatchRecoveryPlan
