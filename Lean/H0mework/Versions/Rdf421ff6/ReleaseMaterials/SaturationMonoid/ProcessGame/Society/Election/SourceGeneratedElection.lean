import H0mework.Foundation.Agency.Boundary

/-!
# Source-generated election occurrences

An election source is an inductively accumulated history of actual mandate
events.  Each event contains only a term, office seed, controller seed, and
the current mandate disposition.  It contains no voter carrier, preference
profile, aggregation rule, truth value, term bound, or completed future.

The current event is the root of the generated occurrence; prior history is
its accounted branch.  Office and controller identities are generated by
separate lineage folds from exact current-event restrictions.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace Election

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Lifecycle Universal

universe u

/-- Source-owned disposition of the mandate created by the current event. -/
inductive MandateDisposition where
  | continue
  | exit
  deriving DecidableEq, Repr

/-- One actual election/mandate event. -/
structure MandateEvent
    (Period OfficeSeed ControllerSeed : Type u) where
  period : Period
  officeSeed : OfficeSeed
  controllerSeed : ControllerSeed
  disposition : MandateDisposition

/-- Arbitrarily long actual past.  A successor stores one newly occurred
event, never a table of future events. -/
inductive MandateHistory (Event : Type u) where
  | first (event : Event)
  | next (prior : MandateHistory Event) (event : Event)

namespace MandateHistory

variable {Event : Type u}

def current : MandateHistory Event → Event
  | .first event => event
  | .next _ event => event

def occurrence : MandateHistory Event → RootedAccountedUnfolding Event
  | .first event => .zero event
  | .next prior event => .occur event (.singleton prior.occurrence)

@[simp] theorem occurrence_root (history : MandateHistory Event) :
    history.occurrence.root = history.current := by
  cases history <;> rfl

theorem current_mem_occurrence_trace (history : MandateHistory Event) :
    history.current ∈ history.occurrence.trace := by
  rw [← history.occurrence_root]
  exact history.occurrence.root_mem_trace

theorem prior_current_mem_next_trace
    (prior : MandateHistory Event) (event : Event) :
    prior.current ∈ (MandateHistory.next prior event).occurrence.trace := by
  simp only [MandateHistory.occurrence, RootedAccountedUnfolding.trace,
    AccountedBranches.singleton, AccountedList.append_nil, List.mem_cons]
  exact Or.inr prior.current_mem_occurrence_trace

end MandateHistory

variable {Period OfficeSeed ControllerSeed Office Controller : Type u}

abbrev Event := MandateEvent Period OfficeSeed ControllerSeed
abbrev Source := MandateHistory (Event
  (Period := Period) (OfficeSeed := OfficeSeed)
  (ControllerSeed := ControllerSeed))

/-- Fixed source-to-occurrence compiler. -/
def electionOccurrenceOf
    (source : Source (Period := Period) (OfficeSeed := OfficeSeed)
      (ControllerSeed := ControllerSeed)) :
    RootedAccountedUnfolding
      (Event (Period := Period) (OfficeSeed := OfficeSeed)
        (ControllerSeed := ControllerSeed)) :=
  source.occurrence

def electionGame
    (source : Source (Period := Period) (OfficeSeed := OfficeSeed)
      (ControllerSeed := ControllerSeed)) :
    SaturationMonoid.ProcessGame
      (electionOccurrenceOf (Period := Period) (OfficeSeed := OfficeSeed)
        (ControllerSeed := ControllerSeed)) where
  source := source

/-- Lineage compilers generate office/controller identities from event seeds;
the lineages themselves are not stored in the source. -/
structure ElectionLineageCompiler (Period : Type u) where
  officeOf : OfficeSeed → Office
  controllerOf : ControllerSeed → Controller

variable (source : Source (Period := Period) (OfficeSeed := OfficeSeed)
  (ControllerSeed := ControllerSeed))

def currentEventSeedAt
    (actualSource : Source (Period := Period) (OfficeSeed := OfficeSeed)
      (ControllerSeed := ControllerSeed))
    (state seed : Event (Period := Period) (OfficeSeed := OfficeSeed)
      (ControllerSeed := ControllerSeed)) : Prop :=
  state = actualSource.current ∧ seed = actualSource.current

def officeSeedAt
    (actualSource : Source (Period := Period) (OfficeSeed := OfficeSeed)
      (ControllerSeed := ControllerSeed))
    (state : Event (Period := Period) (OfficeSeed := OfficeSeed)
      (ControllerSeed := ControllerSeed))
    (seed : OfficeSeed) : Prop :=
  state = actualSource.current ∧ seed = actualSource.current.officeSeed

def controllerSeedAt
    (actualSource : Source (Period := Period) (OfficeSeed := OfficeSeed)
      (ControllerSeed := ControllerSeed))
    (state : Event (Period := Period) (OfficeSeed := OfficeSeed)
      (ControllerSeed := ControllerSeed))
    (seed : ControllerSeed) : Prop :=
  state = actualSource.current ∧ seed = actualSource.current.controllerSeed

def exactCurrentEventSeed :
    SourceSeed
      (electionOccurrenceOf (Period := Period) (OfficeSeed := OfficeSeed)
        (ControllerSeed := ControllerSeed))
      (Event (Period := Period) (OfficeSeed := OfficeSeed)
        (ControllerSeed := ControllerSeed))
      currentEventSeedAt source :=
  ⟨source.current, source.current, source.current_mem_occurrence_trace,
    rfl, rfl⟩

def exactOfficeSeed :
    SourceSeed
      (electionOccurrenceOf (Period := Period) (OfficeSeed := OfficeSeed)
        (ControllerSeed := ControllerSeed))
      OfficeSeed officeSeedAt source :=
  ⟨source.current.officeSeed, source.current,
    source.current_mem_occurrence_trace, rfl, rfl⟩

def exactControllerSeed :
    SourceSeed
      (electionOccurrenceOf (Period := Period) (OfficeSeed := OfficeSeed)
        (ControllerSeed := ControllerSeed))
      ControllerSeed controllerSeedAt source :=
  ⟨source.current.controllerSeed, source.current,
    source.current_mem_occurrence_trace, rfl, rfl⟩

def officeFace
    (compiler : ElectionLineageCompiler
      (Period := Period) (OfficeSeed := OfficeSeed)
      (ControllerSeed := ControllerSeed)
      (Office := Office) (Controller := Controller)) :
    M0BoundaryFace
      (electionOccurrenceOf (Period := Period) (OfficeSeed := OfficeSeed)
        (ControllerSeed := ControllerSeed)) where
  Seed := OfficeSeed
  Lineage := fun _ => Office
  SeedAt := officeSeedAt
  lineageOf := fun _ seed => compiler.officeOf seed.1
  state := fun actualSource => actualSource.current
  seedAt_state := by
    intro _ state seed active
    exact active.1

def controllerFace
    (compiler : ElectionLineageCompiler
      (Period := Period) (OfficeSeed := OfficeSeed)
      (ControllerSeed := ControllerSeed)
      (Office := Office) (Controller := Controller)) :
    M0BoundaryFace
      (electionOccurrenceOf (Period := Period) (OfficeSeed := OfficeSeed)
        (ControllerSeed := ControllerSeed)) where
  Seed := ControllerSeed
  Lineage := fun _ => Controller
  SeedAt := controllerSeedAt
  lineageOf := fun _ seed => compiler.controllerOf seed.1
  state := fun actualSource => actualSource.current
  seedAt_state := by
    intro _ state seed active
    exact active.1

def generatedOffice
    (compiler : ElectionLineageCompiler
      (Period := Period) (OfficeSeed := OfficeSeed)
      (ControllerSeed := ControllerSeed)
      (Office := Office) (Controller := Controller)) :=
  generatedActorOf (electionGame source) OfficeSeed officeSeedAt
    (fun _ => Office) (officeFace compiler).lineageOf
    (exactOfficeSeed source)

def generatedController
    (compiler : ElectionLineageCompiler
      (Period := Period) (OfficeSeed := OfficeSeed)
      (ControllerSeed := ControllerSeed)
      (Office := Office) (Controller := Controller)) :=
  generatedActorOf (electionGame source) ControllerSeed
    controllerSeedAt (fun _ => Controller)
    (controllerFace compiler).lineageOf
    (exactControllerSeed source)

@[simp] theorem generatedOffice_value
    (compiler : ElectionLineageCompiler
      (Period := Period) (OfficeSeed := OfficeSeed)
      (ControllerSeed := ControllerSeed)
      (Office := Office) (Controller := Controller)) :
    (generatedOffice source compiler).1 =
      compiler.officeOf source.current.officeSeed :=
  rfl

@[simp] theorem generatedController_value
    (compiler : ElectionLineageCompiler
      (Period := Period) (OfficeSeed := OfficeSeed)
      (ControllerSeed := ControllerSeed)
      (Office := Office) (Controller := Controller)) :
    (generatedController source compiler).1 =
      compiler.controllerOf source.current.controllerSeed :=
  rfl

end Election
end Society
end ProcessGame
end SaturationMonoid
