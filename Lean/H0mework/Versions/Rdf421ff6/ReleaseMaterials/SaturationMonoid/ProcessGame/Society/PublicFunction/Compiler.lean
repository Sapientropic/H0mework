import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.PublicFunction.Planning

/-!
# A complete finite public-service compiler

Completeness quantifies exactly over words in the source alphabet up to the
stated budget. No failed option is interpreted as an unbounded no-go. A
capture obstruction includes an actual physical plan and an original denied
instruction; physical absence and control blockage are disjoint.

`PaidServicePlan` settles the material planning obligation. Future standing,
mandate revocation and public replacement authority are separate consumers.
-/

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Society.PublicFunction

open Institutions.Capitalism.Universal.Source.Program

universe u
variable {Party Good Port Technology Instrument : Type u}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Instrument]

private inductive Search {α : Type u} (predicate : α → Prop) (items : List α) where
  | found (value : α) (inside : value ∈ items) (checked : predicate value)
  | absent (refuted : ∀ value ∈ items, ¬ predicate value)

private def search {α : Type u} (predicate : α → Prop) [DecidablePred predicate] :
    (items : List α) → Search predicate items
  | [] => .absent (by simp)
  | value :: tail =>
      if checked : predicate value then .found value List.mem_cons_self checked
      else match search predicate tail with
        | .found other inside proof => .found other (List.mem_cons_of_mem _ inside) proof
        | .absent refuted => .absent (by
            intro other inside
            rcases List.mem_cons.mp inside with same | member
            · subst other; exact checked
            · exact refuted other member)

variable (law : RawLaw Party Good Port Technology Instrument)
  (current : RawCurrent Party Good Technology Instrument)
  (task : PublicTaskSpec Party Good)
  (alphabet : List (Request Party Good Port Technology Instrument)) (budget : Nat)

structure PaidServicePlan where
  private mk ::
  word : RawEvent Party Good Port Technology Instrument
  generated : word ∈ words alphabet budget
  physical : PhysicallyFeasible law current task word
  authorized : Authorized law current word

structure BoundedPhysicalObstruction : Prop where
  private mk ::
  no_plan : ∀ word ∈ words alphabet budget,
    ¬ PhysicallyFeasible law current task word

structure CaptureBlockage where
  private mk ::
  physicalWord : RawEvent Party Good Port Technology Instrument
  generated : physicalWord ∈ words alphabet budget
  feasible : PhysicallyFeasible law current task physicalWord
  no_legal_plan : ∀ word ∈ words alphabet budget,
    ¬ (PhysicallyFeasible law current task word ∧ Authorized law current word)

inductive PlanningOutcome where
  | paid : PaidServicePlan law current task alphabet budget →
      PlanningOutcome
  | physical : BoundedPhysicalObstruction law current task alphabet budget →
      PlanningOutcome
  | capture : CaptureBlockage law current task alphabet budget →
      PlanningOutcome

namespace PlanningOutcome

variable {law current task alphabet budget}

def word :
    PlanningOutcome law current task alphabet budget → RawEvent Party Good Port Technology Instrument
  | .paid plan => plan.word
  | .physical _ | .capture _ => []

end PlanningOutcome

def compile : PlanningOutcome law current task alphabet budget :=
  match search (fun word =>
      PhysicallyFeasible law current task word ∧ Authorized law current word)
      (words alphabet budget) with
  | .found word generated checked => .paid ⟨word, generated, checked.1, checked.2⟩
  | .absent noLegal =>
      match search (PhysicallyFeasible law current task) (words alphabet budget) with
      | .found word generated physical => .capture ⟨word, generated, physical, noLegal⟩
      | .absent noPhysical => .physical ⟨noPhysical⟩

namespace PaidServicePlan

variable {law current task alphabet budget}

/-- Checker for a word already generated by the bounded source enumerator.
Financing and other source constraints may search the same word inventory
before paying the ordinary service and authorization checks. -/
def checkCandidate (word : RawEvent Party Good Port Technology Instrument)
    (generated : word ∈ words alphabet budget) :
    Option (PaidServicePlan law current task alphabet budget) :=
  if physical : PhysicallyFeasible law current task word then
    if authorized : Authorized law current word then
      some ⟨word, generated, physical, authorized⟩
    else none
  else none

theorem checkCandidate_word (word : RawEvent Party Good Port Technology Instrument)
    (generated : word ∈ words alphabet budget)
    (plan : PaidServicePlan law current task alphabet budget)
    (checked : checkCandidate word generated = some plan) : plan.word = word := by
  unfold checkCandidate at checked
  split at checked
  · split at checked
    · cases Option.some.inj checked; rfl
    · cases checked
  · cases checked

def next (plan : PaidServicePlan law current task alphabet budget) :=
  law.next current plan.word

def providers (plan : PaidServicePlan law current task alphabet budget) : List Party :=
  plan.word.map Request.signer

theorem sound (plan : PaidServicePlan law current task alphabet budget) :
    ServiceAdequate law current task plan.word ∧
    (∀ item ∈ law.rawItems current plan.word, law.Valid item.before item.request) :=
  service_actual_of_authorized law current task plan.word plan.physical plan.authorized

theorem pointwise_service (plan : PaidServicePlan law current task alphabet budget)
    (slot : ServiceSlot Party Good) (inside : slot ∈ task.slots) :
    Institutions.Capitalism.Universal.Exit.Necessity.BundlePaid law current
      plan.word slot.bearer slot.goods slot.purpose :=
  plan.sound.1.2.2 slot inside

theorem material_balance (plan : PaidServicePlan law current task alphabet budget)
    (bearer : Party) (good : Good) :
    plan.next.stock bearer good + law.totalDebit (law.rawItems current plan.word) bearer good =
      current.stock bearer good + law.totalCredit (law.rawItems current plan.word) bearer good :=
  law.actual_next_material_balance current plan.word bearer good

theorem financial_balance (plan : PaidServicePlan law current task alphabet budget)
    (code : Instrument) (debtor creditor : Party) :
    plan.next.claims code debtor creditor = current.claims code debtor creditor +
      (plan.word.map (fun request => RawLaw.claimDelta request code debtor creditor)).sum :=
  law.accepted_next_financial_balance current plan.word plan.sound.2 code debtor creditor

theorem nonempty_execution (plan : PaidServicePlan law current task alphabet budget) :
    plan.word ≠ [] := by
  obtain ⟨slot, inside, requirement, required, _positive⟩ := task.demand
  rcases plan.pointwise_service slot inside with empty | ⟨item, member, _valid, _matched⟩
  · rw [empty] at required
    exact False.elim (List.not_mem_nil required)
  · intro empty
    rw [empty] at member
    simp only [RawLaw.rawItems, RawLaw.execute, List.not_mem_nil] at member

theorem own_next_is_fresh (plan : PaidServicePlan law current task alphabet budget) :
    current.round < plan.next.round := law.next_round_fresh current plan.word

end PaidServicePlan

namespace CaptureBlockage

variable {law current task alphabet budget}

theorem denied_original_item (blockage : CaptureBlockage law current task alphabet budget) :
    ∃ item ∈ (physicalLaw law).rawItems current blockage.physicalWord,
      ¬ law.Valid item.before item.request := by
  classical
  have refused : ¬ Authorized law current blockage.physicalWord :=
    fun authorized => blockage.no_legal_plan _ blockage.generated ⟨blockage.feasible, authorized⟩
  simpa only [Authorized, not_forall, exists_prop] using refused

theorem not_physical (blockage : CaptureBlockage law current task alphabet budget) :
    ¬ BoundedPhysicalObstruction law current task alphabet budget :=
  fun obstruction => obstruction.no_plan _ blockage.generated blockage.feasible

theorem policy_or_control_gate (blockage : CaptureBlockage law current task alphabet budget) :
    ∃ item ∈ (physicalLaw law).rawItems current blockage.physicalWord,
      law.operationAllowed item.before item.request ≠ true ∨
      ∃ port ∈ law.requiredPorts item.before item.request,
        law.allowed item.before.technology port item.request.signer ≠ true ∧
        law.controller item.before.technology port ∉ item.request.consents := by
  classical
  obtain ⟨item, inside, denied⟩ := blockage.denied_original_item
  refine ⟨item, inside, ?_⟩
  have physical := blockage.feasible.1 item inside
  by_cases policy : law.operationAllowed item.before item.request = true
  · right
    by_contra noGate
    have gates : ∀ port ∈ law.requiredPorts item.before item.request,
        law.allowed item.before.technology port item.request.signer = true ∨
        law.controller item.before.technology port ∈ item.request.consents := by
      intro port inside
      by_cases permitted : law.allowed item.before.technology port item.request.signer = true
      · exact Or.inl permitted
      · right
        by_contra noConsent
        exact noGate ⟨port, inside, permitted, noConsent⟩
    exact denied ⟨⟨physical.1.1, policy⟩, gates, physical.2.2⟩
  · exact Or.inl policy

end CaptureBlockage

namespace BoundedPhysicalObstruction

variable {law current task alphabet budget}

theorem original_failure (obstruction : BoundedPhysicalObstruction law current task alphabet budget)
    (word : RawEvent Party Good Port Technology Instrument)
    (generated : word ∈ words alphabet budget) :
    (∃ item ∈ (physicalLaw law).rawItems current word,
      ¬ (physicalLaw law).Valid item.before item.request) ∨
    ¬ (task.earliest ≤ current.clock ∧
      ((physicalLaw law).next current word).clock ≤ task.deadline) ∨
    (∃ slot ∈ task.slots,
      ¬ Institutions.Capitalism.Universal.Exit.Necessity.BundlePaid
        (physicalLaw law) current word slot.bearer slot.goods slot.purpose) := by
  classical
  have absent := obstruction.no_plan word generated
  by_cases valid : ∀ item ∈ (physicalLaw law).rawItems current word,
      (physicalLaw law).Valid item.before item.request
  · right
    by_cases window : task.earliest ≤ current.clock ∧
        ((physicalLaw law).next current word).clock ≤ task.deadline
    · right
      have unpaid : ¬ ∀ slot ∈ task.slots,
          Institutions.Capitalism.Universal.Exit.Necessity.BundlePaid
            (physicalLaw law) current word slot.bearer slot.goods slot.purpose :=
        fun paid => absent ⟨valid, window.1, window.2, paid⟩
      simpa only [not_forall, exists_prop] using unpaid
    · exact Or.inl window
  · left
    simpa only [not_forall, exists_prop] using valid

end BoundedPhysicalObstruction

theorem compile_complete
    (word : RawEvent Party Good Port Technology Instrument)
    (bounded : word.length ≤ budget)
    (supported : ∀ request ∈ word, request ∈ alphabet)
    (physical : PhysicallyFeasible law current task word)
    (authorized : Authorized law current word) :
    ∃ plan, compile law current task alphabet budget = .paid plan := by
  have generated := (mem_words_iff alphabet budget word).mpr ⟨bounded, supported⟩
  generalize result_eq : compile law current task alphabet budget = result
  cases result with
  | paid plan => exact ⟨plan, rfl⟩
  | physical obstruction => exact False.elim (obstruction.no_plan word generated physical)
  | capture blockage => exact False.elim (blockage.no_legal_plan word generated ⟨physical, authorized⟩)

end SaturationMonoid.ProcessGame.Society.PublicFunction
