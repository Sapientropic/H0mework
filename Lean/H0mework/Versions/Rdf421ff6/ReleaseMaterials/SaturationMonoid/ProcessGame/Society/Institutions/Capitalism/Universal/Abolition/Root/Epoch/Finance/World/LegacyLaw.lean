import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Root.Epoch.Finance.History
import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Root.Epoch.Finance.Legacy.Allocation
import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Root.Financial.Activation

/-! A source representation extension of one original debt law. An inherited
state is retained literally until its actual native continuation is read.
Every current state then refers to the same extended native account. -/

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Root.Epoch.Finance.World.LegacyLaw

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot DebtActivationWorld
open SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Root

noncomputable section

variable {Party Good Port Technology Instrument : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Port] [DecidableEq Instrument]
  (input : ProgrammeSource.Input Party Good Port Technology Instrument) (depth count : Nat)

/-- Both endpoints are generated by the original Run, then mapped by the
already paid native edge fold. No new endpoint is selected. -/
def runImage {first last : (Financial.process input).GeneratedState}
    (run : (Financial.process input).Run first.current last.current) :
    (process input depth count).Run (Legacy.generated input depth count first).current
      (Legacy.generated input depth count last).current := by
  rw [Legacy.generated_current, Legacy.generated_current]
  let generated := Legacy.foldRun input depth count run
  exact generated.faithful ▸ generated.run

variable (before : (Financial.process input).GeneratedState) (claim : Financial.IssuedClaim input)

abbrev oldLaw := Financial.Activation.law input before claim
abbrev oldAdmitted := Financial.admit input before claim

inductive State
  | legacy (original : (oldLaw input before claim).DebtState)
  | current (account : (process input depth count).GeneratedState)
      (native : Nonempty ((process input depth count).Run
        (Legacy.generated input depth count (oldAdmitted input before claim)).current account.current))

def backward : State input depth count before claim → (oldLaw input before claim).DebtState
  | .legacy original => original
  | .current _ _ => .pending

def stateRetract : ConstructiveRetract (oldLaw input before claim).DebtState (State input depth count before claim) :=
  ⟨State.legacy, backward input depth count before claim, fun _ => rfl⟩

def budget : State input depth count before claim → Nat
  | .legacy original => (oldLaw input before claim).budget original
  | .current _ _ => 0

def entered (account : (Financial.process input).GeneratedState)
    (native : Nonempty ((Financial.process input).Run (oldAdmitted input before claim).current account.current)) :
    State input depth count before claim :=
  .current (Legacy.generated input depth count account)
    (native.map (runImage input depth count))

def afterItem (account : (process input depth count).GeneratedState)
    (native : Nonempty ((process input depth count).Run
      (Legacy.generated input depth count (oldAdmitted input before claim)).current account.current))
    (item : ActualItem input depth count) : State input depth count before claim :=
  .current ((consume input depth count item account).next input depth count)
    (native.map fun prior => prior.concatRuns (process input depth count)
      ((consume input depth count item account).transition input depth count))

def enterThenItem (account : (Financial.process input).GeneratedState)
    (native : Nonempty ((Financial.process input).Run (oldAdmitted input before claim).current account.current))
    (item : ActualItem input depth count) : State input depth count before claim :=
  afterItem input depth count before claim (Legacy.generated input depth count account)
    (native.map (runImage input depth count)) item

def originalAllocation (account : (Financial.process input).GeneratedState)
    (origin : Financial.InstructionOrigin input) (source : Financial.Movement input origin) :=
  Legacy.transportAllocation input depth count account source.quantity
    (Financial.allocate input origin account source.quantity (source.quantity_nonnegative input))

def afterOriginalMovement (account : (Financial.process input).GeneratedState)
    (native : Nonempty ((process input depth count).Run
      (Legacy.generated input depth count (oldAdmitted input before claim)).current
      (Legacy.generated input depth count account).current))
    (origin : Financial.InstructionOrigin input) (source : Financial.Movement input origin) : State input depth count before claim :=
  .current (originalAllocation input depth count account origin source).after
    (native.map fun prior => prior.concatRuns (process input depth count)
      (originalAllocation input depth count account origin source).transition)


inductive Step : State input depth count before claim → State input depth count before claim → Type
  | legacy {source target : (oldLaw input before claim).DebtState}
      (step : (oldLaw input before claim).StepAt source target) : Step (.legacy source) (.legacy target)

inductive Transport : State input depth count before claim → State input depth count before claim → Type
  | legacy {source target : (oldLaw input before claim).DebtState}
      (transport : (oldLaw input before claim).TransportAt source target) : Transport (.legacy source) (.legacy target)
  | enter (account : (Financial.process input).GeneratedState)
      (native : Nonempty ((Financial.process input).Run (oldAdmitted input before claim).current account.current)) :
      Transport (.legacy (.registered account native)) (entered input depth count before claim account native)
  | enterAndItem (account : (Financial.process input).GeneratedState)
      (native : Nonempty ((Financial.process input).Run (oldAdmitted input before claim).current account.current))
      (item : ActualItem input depth count) :
      Transport (.legacy (.registered account native)) (enterThenItem input depth count before claim account native item)
  | actualItem (account : (process input depth count).GeneratedState)
      (native : Nonempty ((process input depth count).Run
        (Legacy.generated input depth count (oldAdmitted input before claim)).current account.current))
      (item : ActualItem input depth count) :
      Transport (.current account native) (afterItem input depth count before claim account native item)
  | originalMovement (account : (Financial.process input).GeneratedState)
      (native : Nonempty ((process input depth count).Run
        (Legacy.generated input depth count (oldAdmitted input before claim)).current
        (Legacy.generated input depth count account).current))
      (origin : Financial.InstructionOrigin input) (source : Financial.Movement input origin) :
      Transport (.current (Legacy.generated input depth count account) native)
        (afterOriginalMovement input depth count before claim account native origin source)
  | unchanged (state : State input depth count before claim) : Transport state state

def SettlementAt : State input depth count before claim → Type
  | .legacy original => (oldLaw input before claim).SettlementAt original
  | .current account _ =>
      { archive : TerminalArchive (vocabulary input depth count) //
        account.current.slots[before.current.slots.length]? = some (.terminal archive) ∧
        archive.obligation.content = .inl claim }

def ObstructionAt : State input depth count before claim → Type
  | .legacy original => (oldLaw input before claim).ObstructionAt original
  | .current account _ =>
      { obligation : AdmittedObligation (vocabulary input depth count) //
        account.current.slots[before.current.slots.length]? = some (.live obligation) ∧
        obligation.content = .inl claim }

def law : DebtActivationLaw where
  DebtState := State input depth count before claim
  DebtId := (oldLaw input before claim).DebtId
  DebtClaim := (oldLaw input before claim).DebtClaim
  debtId := (oldLaw input before claim).debtId
  debtClaim := (oldLaw input before claim).debtClaim
  budget := budget input depth count before claim
  StepAt := Step input depth count before claim
  step_budget_lt := fun step => by
    cases step with
    | legacy original => exact (oldLaw input before claim).step_budget_lt original
  transportLaw? := some {
    EventAt := Transport input depth count before claim
    budget_le := fun transport => by
      cases transport with
      | legacy original => exact (oldLaw input before claim).transport_budget_le original
      | enter _ _ => exact Nat.le_refl 0
      | enterAndItem _ _ _ => exact Nat.le_refl 0
      | actualItem _ _ _ => exact Nat.le_refl 0
      | originalMovement _ _ _ _ => exact Nat.le_refl 0
      | unchanged _ => exact Nat.le_refl _ }
  SettlementAt := SettlementAt input depth count before claim
  settlement_budget_zero := fun {state} settled => by
    cases state with
    | legacy original => exact (oldLaw input before claim).settlement_budget_zero settled
    | current _ _ => rfl
  ObstructionAt := ObstructionAt input depth count before claim


theorem entry_reads_the_same_whole_account (account : (Financial.process input).GeneratedState)
    (native : Nonempty ((Financial.process input).Run (oldAdmitted input before claim).current account.current)) :
    entered input depth count before claim account native =
      .current (Legacy.generated input depth count account) (native.map (runImage input depth count)) := rfl

theorem original_claim_and_identity_are_literal :
    (law input depth count before claim).debtId = (oldLaw input before claim).debtId ∧
      (law input depth count before claim).debtClaim = (oldLaw input before claim).debtClaim := ⟨rfl, rfl⟩

end
end SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Root.Epoch.Finance.World.LegacyLaw

