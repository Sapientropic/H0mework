/-- Consumer of the original installed legislation; no target entry or fresh
responsibility is generated by rejecting the registration. -/
def rejectedAtTheOriginalRoot : TypedRejectionVisibleResidualAt
    (legislation root boundary recognition failure lawProgram) where
  branch := ⟨PUnit.unit⟩
  rejection := .uncertified rfl
  dispositionExact := rfl
  residualBearer := SourceNativeObserverConsumerRejectionAt.residualBearer
    (generated := lawProgram.generatedSubmission)
  residualBearerExact := rfl
  rootLedgerAndNextFactorize := lawProgram.generatedSubmission.rootLedgerAndNext_factorize
  worldWritingEmpty := ⟨fun impossible => nomatch impossible⟩

theorem the_root_law_refusal_keeps_the_exact_original_failure :
    (rejectedAtTheOriginalRoot root boundary recognition failure lawProgram).residualBearer.generated.presentedEffect =
      failure := rfl

end
