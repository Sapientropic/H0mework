import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Accounting.Quantifiers.Assembly.Strengthening.Total.Complete
import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Accounting.Quantifiers.Assembly.Strengthening.Evolving.Consumers.Actual

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Accounting.Quantifiers.Assembly.Strengthening.Total.Consumers

open Source.Program Innovation
open SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Root
open Abolition.Root.Registered Abolition.Root.Registered.Macro
open Quantifiers.Joint.Consumers.Compact (seed grossClaim the_source_generates_its_own_sufficient_plan)
noncomputable section

theorem the_registered_original_root_consumes_the_complete_strengthened_capital_theorem :
    CapitalLineStrengthenedAt seed grossClaim :=
  the_original_root_closes_the_full_strengthened_capital_quantifiers seed grossClaim

theorem the_same_registered_root_closes_every_actual_epoch (n : Nat) :
    Evolving.Epoch.Current.ClosedAt (Evolving.Epoch.History.currentAt
      (Evolving.Epoch.Source.initial Evolving.Consumers.original) n) :=
  the_registered_original_root_consumes_the_complete_strengthened_capital_theorem.every_actual_epoch
    the_source_generates_its_own_sufficient_plan Evolving.Consumers.reader n

theorem the_same_registered_root_never_regenerates_a_capital_relation (n : Nat) :
    Global.NoCapital (Evolving.Epoch.History.currentAt
      (Evolving.Epoch.Source.initial Evolving.Consumers.original) n).native.handlerFace.rootRead :=
  the_registered_original_root_consumes_the_complete_strengthened_capital_theorem.no_capital_regeneration
    the_source_generates_its_own_sufficient_plan Evolving.Consumers.reader n

theorem the_same_registered_root_keeps_the_original_quantifier_contract :
    Completion.CapitalQuantifiersClosedAt seed grossClaim :=
  the_registered_original_root_consumes_the_complete_strengthened_capital_theorem.toCapitalQuantifiersClosedAt

end
end SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Accounting.Quantifiers.Assembly.Strengthening.Total.Consumers
