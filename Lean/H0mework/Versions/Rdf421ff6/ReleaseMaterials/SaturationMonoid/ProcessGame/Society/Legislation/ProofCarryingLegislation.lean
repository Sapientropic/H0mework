import H0mework.Versions.Rfde5c14d.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Legislation.ProofCarryingRenewalRestriction
import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Revision.SourceGeneratedInstitutionalDichotomy

/-!
# Proof-carrying legislation from one exact inquiry occurrence

Proof-carrying legislation is a dependent consumer of authority already
generated by two source laws. The M8 renewal payload supplies the exact
seed-dependent restriction before emission; the canonical inquiry runtime
supplies the reform/revolution dichotomy, branch receipt, and heterogeneous
next current at one recursively reached tick.

The splice below proves that those two views name the same root, temporal
visit, whole-ledger occurrence, and responsibility row. PCL has no policy
field, branch selector, revision target, registry, court, ledger, or root.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace Legislation

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Renewal Settlement Observer
open ConstructiveRoot.RootInquiryCompletion

universe u

variable {LocalSource LocalState Seed : Type u}
variable {occurrenceOf : LocalSource → RootedAccountedUnfolding LocalState}
variable {game : SaturationMonoid.ProcessGame occurrenceOf}
variable {SeedAt : LocalSource → LocalState → Seed → Prop}

variable {N : WorldRelationNetwork.{u}}
variable {RootV : ConstructiveRoot.Vocabulary.{u}}
variable {root : SourceNativeLivingRootClosure N RootV}

variable {W : ResponsibilityLifecycle.Vocabulary.{u}}
variable {P : NativeResponsibilityProcess W}
variable {Occurrence Visible AuthorityResidual : Type u}
variable {observer : AuthorityObserver Occurrence Visible AuthorityResidual}
variable {LocalConsumerAt LocalLifecycleAt DispositionAt :
  SourceSeed occurrenceOf Seed SeedAt game.source → Type u}

variable {recognition :
  SourceNativeProofCarryingRenewalRecognitionAt root P observer
    LocalConsumerAt LocalLifecycleAt DispositionAt}
variable {visit : SourceNativeTemporalVisitAt
  root.toAuthoritativeRoot.toLedgerRoot}
variable {installed : SourceInstalledRenewalAt recognition visit}

variable {process : SourceNativeInquiryEngineProcess.{u}}
variable {runtime : SourceNativeInquiryRuntime process}
variable {depth : Nat}

/-! ## Exact installed-renewal / runtime splice -/

/-- The active state and query already sealed in one reachable runtime state.

The answered process node has an empty query fibre, so the existing runtime
activation eliminates that branch. This is a readout, not another process
state or query registry. -/
def sourceGeneratedRuntimeInquiryCoordinateAt
    (runtime : SourceNativeInquiryRuntime process)
    (depth : Nat) :
    Sigma fun state : RootInquiryStatePresentation.{u} => state.Query :=
  match node_eq : (runtime.stateAt depth).engine.node with
  | .active state =>
      ⟨state, cast (congrArg RootInquiryProcessNode.Query node_eq)
        (runtime.stateAt depth).activation.query⟩
  | .answered _state _priorQuery =>
      nomatch (cast (congrArg RootInquiryProcessNode.Query node_eq)
        (runtime.stateAt depth).activation.query : PEmpty)

/-- Exact commuting splice between an installed M8 renewal and the inquiry
occurrence at one generated runtime depth.

All four equalities are heterogeneous because the runtime may hide its
network and vocabulary. They certify identity only; none can manufacture a
row, occurrence, answer, revision, or next current. -/
structure SourceInstalledRenewalRuntimeSpliceAt
    (installed : SourceInstalledRenewalAt recognition visit)
    (runtime : SourceNativeInquiryRuntime process)
    (depth : Nat) : Prop where
  sameRoot : HEq
    (sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).1.state.base.root
    root
  sameVisit : HEq
    (sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).1.state.base.visit
    visit
  sameRow : HEq
    ((sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).1.state.base.entryAt
      (sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).2)
    installed.payload.sourceEntry
  sameOccurrence : HEq
    ((sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).1.state.base.root
      |>.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
        (sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).1.state.base.visit)
    (root.toAuthoritativeRoot.toLedgerRoot
      |>.exactTemporalCausalEventAt visit)

variable {splice : SourceInstalledRenewalRuntimeSpliceAt installed runtime depth}

/-! ## Zero-choice PCL seal -/

/-- Proof-carrying legislation at the automatic dichotomy of one sealed
runtime tick. The private empty constructor stores no policy or authority
data; all content is recovered from its dependent indices. -/
structure ProofCarryingLegislationAt
    (installed : SourceInstalledRenewalAt recognition visit)
    (runtime : SourceNativeInquiryRuntime process)
    (depth : Nat)
    (_splice : SourceInstalledRenewalRuntimeSpliceAt installed runtime depth) :
    Type (u + 14) where
  private mk ::

/-- Sole producer. The caller proves only that its already-installed renewal
is the same occurrence as the already-generated runtime tick. The runtime,
not this mouth, chooses the institutional branch and next current. -/
def sourceGeneratedProofCarryingLegislation
    (installed : SourceInstalledRenewalAt recognition visit)
    (runtime : SourceNativeInquiryRuntime process)
    (depth : Nat)
    (splice : SourceInstalledRenewalRuntimeSpliceAt installed runtime depth) :
    ProofCarryingLegislationAt installed runtime depth splice :=
  ⟨⟩

namespace ProofCarryingLegislationAt

variable (legislation :
  ProofCarryingLegislationAt installed runtime depth splice)

/-- The automatic dichotomy is regenerated from the named runtime and depth;
there is no caller-supplied reform/revolution sum. -/
def dichotomy : Revision.SourceGeneratedInstitutionalDichotomyAt runtime depth :=
  by
    cases legislation
    exact Revision.SourceGeneratedInstitutionalDichotomyAt.generate runtime depth

/-- Recursively generated finite inquiry prefix ending immediately before the
authority-bearing tick consumed by this PCL. -/
def finitePrefix :
    SourceNativeInquiryRuntime.HistoryAt runtime depth runtime.initialState :=
  legislation.dichotomy.finitePrefix

/-- Exact authority-bearing runtime occurrence. -/
def tick : SourceNativeInquiryRuntime.ExactActivatedInquiryOccurrenceAt
    (runtime.stateAt depth) :=
  legislation.dichotomy.tick

/-- The branch kind is a readout of the exact tick resolution. -/
def revisionKind : Revision.SourceGeneratedInstitutionalRevisionKind :=
  legislation.dichotomy.revisionKind

/-- Exact compiler-generated resolution, retained dependently. -/
def resolution := legislation.dichotomy.resolution

/-- Exact answer generated by the same runtime tick. -/
def inquiryAnswer : RootInquiryProcessNode.AnswerAt legislation.resolution :=
  legislation.dichotomy.answer

/-- Independent branch receipt. Its revolutionary constructor contains the
minimal-coface first write and both revised answer-and-next rows. -/
def inquiryConsumerReceipt :
    RootInquiryProcessNode.ReceiptAt legislation.resolution :=
  legislation.dichotomy.independentConsumerReceipt

/-- Exact M8 source seed, including its trace membership witness. -/
def renewalSeed : SourceSeed occurrenceOf Seed SeedAt game.source :=
  by
    cases legislation
    exact installed.payload.sourceSeed

/-- Renewal event is a restriction of the exact source seed. -/
def renewalEvent : Seed := legislation.renewalSeed.1

/-- Exact source-trace occurrence evidence. -/
theorem renewalEvent_mem_source_trace :
    ∃ state ∈ game.occurrence.trace,
      SeedAt game.source state legislation.renewalEvent :=
  legislation.renewalSeed.2

/-- The complete pre-emitter restriction is read only from the exact M8
payload consumer. -/
def renewalRestriction :
    ProofCarryingRenewalRestrictionAt P observer LocalConsumerAt
      LocalLifecycleAt legislation.renewalSeed :=
  installed.payload.consumer

/-- Original local M8 consumer, carried before emission at this seed. -/
def localResponsibilityConsumer : LocalConsumerAt legislation.renewalSeed :=
  legislation.renewalRestriction.localConsumer

/-- Exact seed-dependent lifecycle disposition carried by the renewal law. -/
def localLifecycle : LocalLifecycleAt legislation.renewalSeed :=
  legislation.renewalRestriction.localLifecycle

/-- M8 disposition from the same installed payload. -/
def localDisposition : DispositionAt legislation.renewalSeed :=
  installed.payload.disposition

/-- Existing residual bearer from the pre-emitter restriction. -/
def existingResidual : ExistingResidualBearerAt P :=
  legislation.renewalRestriction.existingResidual

/-- Existing bearer; PCL cannot allocate a new lifecycle responsibility. -/
def residualBearer : W.Bearer :=
  legislation.renewalRestriction.residualBearer

/-- Hidden standing of the exact seed-carried M6 vertical obstruction. -/
def hiddenStanding : Occurrence :=
  legislation.renewalRestriction.hiddenStanding

/-- Canonical M6 observer kernel from that same vertical obstruction. -/
def observerKernel : AuthorityKernelPair observer :=
  legislation.renewalRestriction.observerKernel

@[simp] theorem observerKernel_left_eq_hiddenStanding :
    legislation.observerKernel.left = legislation.hiddenStanding :=
  legislation.renewalRestriction.observerKernel_left_eq_hiddenStanding

/-- Exact canonical row selected by the installed renewal occurrence. -/
def selectedRenewalRow :
    (root.toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit visit)
      |>.GeneratedEntryRowAt installed.payload.sourceEntry :=
  by
    cases legislation
    exact installed.temporalSelectedRow

/-- Independent M8 root responsibility consumer. -/
def renewalRootConsumer :
    RenewalResponsibilityConsumerAt installed.operationalAuthority :=
  by
    cases legislation
    exact installed.rootResponsibilityConsumer

/-- Whole-ledger write-back of the exact installed renewal occurrence. -/
def wholeLedgerWriteBack :
    SourceNativeLedgerEvolutionAt
      root.toAuthoritativeRoot.toLedgerRoot.source.source
      (root.toAuthoritativeRoot.toLedgerRoot
        |>.generatedAtTemporalVisit visit).occurrence :=
  by
    cases legislation
    exact (root.toAuthoritativeRoot.toLedgerRoot
      |>.generatedAtTemporalVisit visit).wholeLedgerWriteBack

/-- Same-root coordinate supplied by the exact occurrence splice. -/
theorem inquiryRoot_heq_installedRoot
    (legislation :
      ProofCarryingLegislationAt installed runtime depth splice) : HEq
    (sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).1.state.base.root
    root :=
  by
    cases legislation
    exact splice.sameRoot

/-- Same temporal visit supplied by the exact occurrence splice. -/
theorem inquiryVisit_heq_installedVisit
    (legislation :
      ProofCarryingLegislationAt installed runtime depth splice) : HEq
    (sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).1.state.base.visit
    visit :=
  by
    cases legislation
    exact splice.sameVisit

/-- Same responsibility row supplied by the exact occurrence splice. -/
theorem inquiryRow_heq_installedRenewalRow
    (legislation :
      ProofCarryingLegislationAt installed runtime depth splice) : HEq
    ((sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).1.state.base.entryAt
      (sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).2)
    installed.payload.sourceEntry :=
  by
    cases legislation
    exact splice.sameRow

/-- The runtime receipt and installed renewal are the same whole-ledger
occurrence, not sibling U8 and PCL fixtures. -/
theorem inquiryOccurrence_heq_installedOccurrence
    (legislation :
      ProofCarryingLegislationAt installed runtime depth splice) : HEq
    ((sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).1.state.base.root
      |>.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
        (sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).1.state.base.visit)
    (root.toAuthoritativeRoot.toLedgerRoot
      |>.exactTemporalCausalEventAt visit) :=
  by
    cases legislation
    exact splice.sameOccurrence

/-- Whole-root M8 answer-and-next factorization at the spliced occurrence. -/
theorem rootAnswerAndNext_factorizes
    (legislation :
      ProofCarryingLegislationAt installed runtime depth splice) :
    installed.RootAnswerAndNextFactorizes :=
  by
    cases legislation
    exact installed.rootAnswerAndNext_factorizes

/-- Heterogeneous actual next generated by the exact runtime tick. In the
revolutionary branch this is the revised network/current, never the old root. -/
def generatedNext : AnyAuthoritativeRootCurrent.{u} :=
  legislation.dichotomy.actualNext

@[simp] theorem generatedNext_eq_tick_erasure :
    legislation.generatedNext = legislation.tick.next.node.erase :=
  rfl

set_option linter.defProp false in
/-- Exact proof that the tick erasure is its compiler-generated dependent
next. The RHS stays sealed by the inquiry kernel. -/
def next_erases_to_generated :=
  legislation.dichotomy.next_erases_to_generated

/-- Revolution evidence can only be recovered when this same automatic tick
resolved through the `.revised` constructor. -/
def revolutionaryTick? :
    Option (Revision.SourceGeneratedRevolutionaryTickAt runtime depth) :=
  legislation.dichotomy.revolutionaryTick?

end ProofCarryingLegislationAt

/-! ## Exact revolutionary consumption -/

/-- Zero-choice seal that one exact revolutionary runtime object is the one
recovered from this PCL's automatic dichotomy. -/
structure ProofCarryingRevolutionaryConsumptionAt
    (legislation :
      ProofCarryingLegislationAt installed runtime depth splice)
    (revolution : Revision.SourceGeneratedRevolutionaryTickAt runtime depth) :
    Type (u + 14) where
  private mk ::
  selected : legislation.revolutionaryTick? = some revolution

namespace ProofCarryingRevolutionaryConsumptionAt

variable {legislation :
  ProofCarryingLegislationAt installed runtime depth splice}
variable {revolution : Revision.SourceGeneratedRevolutionaryTickAt runtime depth}
variable (consumption :
  ProofCarryingRevolutionaryConsumptionAt legislation revolution)

/-- Exact U8 core selected by the runtime resolution. -/
def core := by
  cases consumption
  exact revolution.core

/-- Proof that the same named runtime tick consumed that core. -/
theorem resumption
    (consumption :
      ProofCarryingRevolutionaryConsumptionAt legislation revolution) :
    SourceNativeInquiryRuntime.CofaceRealizationResumptionAt
    revolution.core runtime depth :=
  by
    cases consumption
    exact revolution.resumption

/-- Core frontier entry equals the inquiry row of this tick. -/
theorem coreRootEntry_eq
    (consumption :
      ProofCarryingRevolutionaryConsumptionAt legislation revolution) :
    revolution.core.face.rootEntry =
      revolution.state.state.base.entryAt revolution.stateQuery :=
  by
    cases consumption
    exact revolution.rootEntry_eq

/-- Obstruction-generated minimal coface. -/
def minimalCoface :=
  by
    cases consumption
    exact revolution.minimalCoface

/-- Canonical initial coface factorization. -/
def initialFactorization :=
  by
    cases consumption
    exact revolution.initialFactorization

/-- Attached direction and exact revised-root first-write realization. -/
def firstWriteRealization :=
  by
    cases consumption
    exact revolution.firstWriteRealization

/-- Canonical revised-root first write. -/
def firstWrite :=
  by
    cases consumption
    exact revolution.firstWrite

/-- Proof that the obstruction row is consumed by the exact first write. -/
def firstWriteConsumes :=
  by
    cases consumption
    exact revolution.firstWriteConsumes

/-- Initial factorization, first write, and both revised live-row
answer-and-next consumers. -/
def twoRowAnswerAndNext :=
  by
    cases consumption
    exact revolution.twoRowAnswerAndNext

/-- Revised old-row answer-and-next consumer. -/
def oldRowAnswerAndNext :=
  by
    cases consumption
    exact revolution.oldRowAnswerAndNext

/-- Revised new-only row answer-and-next consumer. -/
def newRowAnswerAndNext :=
  by
    cases consumption
    exact revolution.newRowAnswerAndNext

/-- Both revised rows generate the same downstream current. -/
theorem twoRows_share_generatedNext :
    consumption.oldRowAnswerAndNext.nextCurrent =
      consumption.newRowAnswerAndNext.nextCurrent :=
  by
    cases consumption
    exact revolution.twoRows_share_generatedNext

/-- Heterogeneous revised current generated by the exact new-only row. -/
def revisedNext : AnyAuthoritativeRootCurrent.{u} :=
  by
    cases consumption
    exact revolution.revisedNext

end ProofCarryingRevolutionaryConsumptionAt

namespace ProofCarryingLegislationAt

variable (legislation :
  ProofCarryingLegislationAt installed runtime depth splice)

/-- Automatically expose the revolutionary consumer exactly when this
runtime tick generated it. No branch tag or U8 core is accepted. -/
def revolutionaryConsumption? :
    Option (Sigma fun revolution :
      Revision.SourceGeneratedRevolutionaryTickAt runtime depth =>
        ProofCarryingRevolutionaryConsumptionAt legislation revolution) :=
  match selected : legislation.revolutionaryTick? with
  | none => none
  | some revolution => some ⟨revolution, ⟨selected⟩⟩

end ProofCarryingLegislationAt

/-! ## Independent consumer mouth -/

/-- Independent downstream consumption of a PCL occurrence. Every field is
read from the exact installed renewal, exact splice, or automatic runtime
dichotomy. No field can prescribe policy content or replace the root's
generated answer/next. -/
structure ProofCarryingLegislationConsumerAt
    (legislation :
      ProofCarryingLegislationAt installed runtime depth splice) :
    Type (u + 14) where
  private mk ::
  renewalSeed : SourceSeed occurrenceOf Seed SeedAt game.source
  renewalSeed_eq : renewalSeed = installed.payload.sourceSeed
  renewalRestriction : ProofCarryingRenewalRestrictionAt P observer
    LocalConsumerAt LocalLifecycleAt renewalSeed
  localConsumer : LocalConsumerAt renewalSeed
  localLifecycle : LocalLifecycleAt renewalSeed
  localDisposition : DispositionAt renewalSeed
  rootConsumer : RenewalResponsibilityConsumerAt installed.operationalAuthority
  residualBearer : W.Bearer
  hiddenStanding : Occurrence
  observerKernel : AuthorityKernelPair observer
  kernelLeft_eq_hiddenStanding : observerKernel.left = hiddenStanding
  sameRoot : HEq
    (sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).1.state.base.root
    root
  sameVisit : HEq
    (sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).1.state.base.visit
    visit
  sameRow : HEq
    ((sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).1.state.base.entryAt
      (sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).2)
    installed.payload.sourceEntry
  sameOccurrence : HEq
    ((sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).1.state.base.root
      |>.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
        (sourceGeneratedRuntimeInquiryCoordinateAt runtime depth).1.state.base.visit)
    (root.toAuthoritativeRoot.toLedgerRoot
      |>.exactTemporalCausalEventAt visit)
  branchKind : Revision.SourceGeneratedInstitutionalRevisionKind
  inquiryAnswer : RootInquiryProcessNode.AnswerAt legislation.resolution
  inquiryReceipt : RootInquiryProcessNode.ReceiptAt legislation.resolution
  wholeLedgerWriteBack :
    SourceNativeLedgerEvolutionAt
      root.toAuthoritativeRoot.toLedgerRoot.source.source
      (root.toAuthoritativeRoot.toLedgerRoot
        |>.generatedAtTemporalVisit visit).occurrence
  generatedNext : AnyAuthoritativeRootCurrent.{u}
  generatedNext_eq : generatedNext = legislation.tick.next.node.erase
  rootFactorization : installed.RootAnswerAndNextFactorizes
  revolutionaryConsumption :
    Option (Sigma fun revolution :
      Revision.SourceGeneratedRevolutionaryTickAt runtime depth =>
        ProofCarryingRevolutionaryConsumptionAt legislation revolution)

/-- Direct independent consumer generated solely from the PCL seal. -/
def ProofCarryingLegislationAt.independentConsumer
    (legislation :
      ProofCarryingLegislationAt installed runtime depth splice) :
    ProofCarryingLegislationConsumerAt legislation where
  renewalSeed := legislation.renewalSeed
  renewalSeed_eq := rfl
  renewalRestriction := legislation.renewalRestriction
  localConsumer := legislation.localResponsibilityConsumer
  localLifecycle := legislation.localLifecycle
  localDisposition := legislation.localDisposition
  rootConsumer := legislation.renewalRootConsumer
  residualBearer := legislation.residualBearer
  hiddenStanding := legislation.hiddenStanding
  observerKernel := legislation.observerKernel
  kernelLeft_eq_hiddenStanding :=
    legislation.observerKernel_left_eq_hiddenStanding
  sameRoot := legislation.inquiryRoot_heq_installedRoot
  sameVisit := legislation.inquiryVisit_heq_installedVisit
  sameRow := legislation.inquiryRow_heq_installedRenewalRow
  sameOccurrence := legislation.inquiryOccurrence_heq_installedOccurrence
  branchKind := legislation.revisionKind
  inquiryAnswer := legislation.inquiryAnswer
  inquiryReceipt := legislation.inquiryConsumerReceipt
  wholeLedgerWriteBack := legislation.wholeLedgerWriteBack
  generatedNext := legislation.generatedNext
  generatedNext_eq := legislation.generatedNext_eq_tick_erasure
  rootFactorization := legislation.rootAnswerAndNext_factorizes
  revolutionaryConsumption := legislation.revolutionaryConsumption?

end Legislation
end Society
end ProcessGame
end SaturationMonoid
