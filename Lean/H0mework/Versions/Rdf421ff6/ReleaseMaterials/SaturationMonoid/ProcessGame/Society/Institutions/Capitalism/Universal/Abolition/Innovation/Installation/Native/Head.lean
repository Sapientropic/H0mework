set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Innovation.Installation.Native

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot RootInquiryCompletion
open SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Root
open Abolition.Root Abolition.Root.Registered Source.Program

noncomputable section

variable {Party Good Port Technology Instrument : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Port] [DecidableEq Instrument]
  {input : ProgrammeSource.Input Party Good Port Technology Instrument}
  {depth count prefixLimit renewalLimit sourceDepth sourceCount : Nat}
  {review : Option (ReviewPhase.ContextAt input)}
  {origin : Functions.Revision.Context (input := input) (review := review)
    depth count prefixLimit renewalLimit sourceDepth sourceCount}
  {admission : Functions.Revision.InitialAdmissionAt origin}
  (frame : Macro.Public.Runtime.Frame origin admission)

theorem the_new_raw_reentry_starts_at_its_original_first_head (complete : ¬ frame.HasWork) :
    frame.next.actual.actual.position = 0 := by
  rw [Macro.Public.Runtime.Frame.next,dif_neg complete]
  rfl

theorem every_original_accounting_item_keeps_its_public_interpreter
    (item : Epoch.Finance.ActualItem input depth count)
    (member : item ∈ Macro.Public.Accounting.items input depth count prefixLimit renewalLimit
      origin.germ.snapshot.past frame.start) :
    item.interpreter input depth count = Physical.Public.interpreter input := by
  unfold Macro.Public.Accounting.items Epoch.Finance.inventory at member
  obtain ⟨position,rfl⟩ := List.mem_ofFn.mp member
  rfl

omit [DecidableEq Port] [DecidableEq Instrument] in
theorem the_signed_public_issue_is_valid
    (before : RawCurrent Party Good Technology Instrument)
    (instrument : Instrument) (debtor holder : Party) (quantity : ℚ) (purpose : Port)
    (nonnegative : 0 ≤ quantity) :
    (Physical.Public.interpreter input).Valid before
      ⟨debtor,[],purpose,[],.issue instrument debtor holder quantity⟩ := by
  simpa [Physical.Public.interpreter,PublicFunction.physicalLaw,RawLaw.Valid,
    RawLaw.SignerMatches,RawLaw.operationAllowed,RawPolicy.eval,RawLaw.requiredPorts,
    RawLaw.debit,RawLaw.credit,RawLaw.ClaimGuard,NonnegativeBundle] using nonnegative

theorem the_original_valid_public_primitive_has_its_singleton_inventory
    (cursor : Physical.Cursor Party Good Port Technology Instrument)
    (request : Request Party Good Port Technology Instrument)
    (valid : (Physical.Public.interpreter input).Valid
      (Physical.Public.stateAt input depth count prefixLimit renewalLimit origin.germ.snapshot.past cursor.past).raw
      (request.resign request.signer)) :
    (Physical.Public.execution input depth count prefixLimit renewalLimit origin.germ.snapshot.past
      (Physical.receive cursor (.primitive request))).items =
        [⟨0,(Physical.Public.stateAt input depth count prefixLimit renewalLimit
          origin.germ.snapshot.past cursor.past).raw,request.resign request.signer⟩] := by
  let before := Physical.Public.stateAt input depth count prefixLimit renewalLimit origin.germ.snapshot.past cursor.past
  change (Physical.Public.compile input before (.primitive request)).execution.items = _
  cases produced : Physical.Public.compile input before (.primitive request) with
  | accepted word selected checked =>
      have same : [request.resign request.signer] = word := Option.some.inj selected
      subst word
      rfl
  | refused word selected item listed failed =>
      have same : [request.resign request.signer] = word := Option.some.inj selected
      subst word
      have original : item = ⟨0,before.raw,request.resign request.signer⟩ := by
        simpa only [RawLaw.rawItems,RawLaw.execute,List.mem_singleton] using listed
      subst item
      exact (failed valid).elim
  | metadata selected => cases selected

/-- The registration is generated by the live reader from this original
singleton inventory; no registration or native endpoint is a premise. -/
theorem an_actual_single_issue_generates_its_registration_and_live_slot
    (before : RawCurrent Party Good Technology Instrument)
    (request : Request Party Good Port Technology Instrument)
    (position : frame.actual.actual.position = 0)
    (body : (Physical.Public.execution input depth count prefixLimit renewalLimit
      origin.germ.snapshot.past frame.start).items = [⟨0,before,request⟩])
    (instrument : Instrument) (debtor holder : Party) (quantity : ℚ)
    (operation : request.operation = .issue instrument debtor holder quantity)
    (accepted : (Physical.Public.interpreter input).Valid before request) :
    ∃ registered : Macro.Public.Accounting.Registration input depth count prefixLimit renewalLimit
        origin.germ.snapshot.past frame.start frame.actual.actual,
      Macro.Public.Accounting.registration? input depth count prefixLimit renewalLimit
          origin.germ.snapshot.past frame.start frame.actual.actual = some registered ∧
        registered.claim.quantity = quantity ∧
        frame.next = frame.born registered ∧
        frame.next.account.current.slots[frame.account.current.slots.length]? =
          some (.live (Epoch.Finance.admission input depth count (.inr registered.claim)).toObligation) := by
  have mapped := Macro.Public.Accounting.actual_items_are_the_same_public_execution
    input depth count prefixLimit renewalLimit origin.germ.snapshot.past frame.start
  rw [body] at mapped
  cases inventory : Macro.Public.Accounting.items input depth count prefixLimit renewalLimit
      origin.germ.snapshot.past frame.start with
  | nil => rw [inventory] at mapped; cases mapped
  | cons item tail =>
      have instruction : item.instruction input depth count = ⟨0,before,request⟩ := by
        rw [inventory] at mapped
        exact (List.cons.inj mapped).1
      have member : item ∈ Macro.Public.Accounting.items input depth count prefixLimit renewalLimit
          origin.germ.snapshot.past frame.start := by rw [inventory]; exact List.mem_cons_self
      have interpreter := every_original_accounting_item_keeps_its_public_interpreter frame item member
      have head : Macro.Public.Accounting.item? input depth count prefixLimit renewalLimit
          origin.germ.snapshot.past frame.start frame.actual.actual = some item := by
        simp only [Macro.Public.Accounting.item?,frame.paid,if_true,position,inventory]
        rfl
      have sourceOperation : (item.instruction input depth count).request.operation =
          .issue instrument debtor holder quantity := by rw [instruction]; exact operation
      have sourceAccepted : (item.interpreter input depth count).Valid
          (item.instruction input depth count).before (item.instruction input depth count).request := by
        rw [interpreter,instruction]
        exact accepted
      have found := the_paid_original_issue_head_generates_its_registration input depth count
        prefixLimit renewalLimit origin.germ.snapshot.past frame.start frame.actual.actual frame.paid
        item head instrument debtor holder quantity sourceOperation sourceAccepted
      let registered := (Macro.Public.Accounting.registration? input depth count prefixLimit renewalLimit
        origin.germ.snapshot.past frame.start frame.actual.actual).get found
      have parsed : Macro.Public.Accounting.registration? input depth count prefixLimit renewalLimit
          origin.germ.snapshot.past frame.start frame.actual.actual = some registered :=
        (Option.some_get found).symm
      have work : frame.HasWork := Or.inr (by rw [head]; rfl)
      have selected : frame.next = frame.born registered := by
        rw [Macro.Public.Runtime.Frame.next,dif_pos work]
        unfold Macro.Public.Runtime.Frame.internalNext
        split
        · rename_i actual returned
          have same : actual = registered := Option.some.inj (returned.symm.trans parsed)
          subst actual
          rfl
        · rename_i absent
          cases absent.symm.trans parsed
      have original : registered.item = item := Option.some.inj (registered.present.symm.trans head)
      have issued := registered.claim.operation
      rw [registered.the_new_row_has_the_same_actual_source,original,instruction] at issued
      have quantityEq := (Operation.issue.inj (operation.symm.trans issued)).2.2.2.symm
      refine ⟨registered,parsed,quantityEq,selected,?_⟩
      rw [selected]
      exact registered.the_first_write_installs_the_original_native_slot

end
end SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Innovation.Installation.Native
