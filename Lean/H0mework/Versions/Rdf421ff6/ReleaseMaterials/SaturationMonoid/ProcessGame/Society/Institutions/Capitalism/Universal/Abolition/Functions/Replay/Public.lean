import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Functions.Replay.Services
import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Functions.NoControl

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Functions.Replay

open Source.Program Source.ProgrammeControl Exit

universe u
variable {Party Good Port Technology Instrument : Type u}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Instrument]
  (law : RawLaw Party Good Port Technology Instrument)
  (current : RawCurrent Party Good Technology Instrument)
  (original : RawEvent Party Good Port Technology Instrument)

/-- The replay has actual public authorization at each original position;
the absence of private gates is generated by the existing interpretation. -/
theorem every_replay_port_is_open_without_controller_consents :
    ∀ item ∈ (PublicFunction.physicalLaw law).rawItems current (wordAt law current original),
      (PublicFunction.physicalLaw law).Valid item.before item.request ∧
      item.request.consents = [] ∧
      ∀ port ∈ (PublicFunction.physicalLaw law).requiredPorts item.before item.request,
        (PublicFunction.physicalLaw law).allowed item.before.technology port item.request.signer = true := by
  intro item present
  have actual := every_replay_item_is_lawful_and_has_no_controller_consents law current 0 original item present
  exact ⟨actual.1, actual.2, fun _ _ => rfl⟩

theorem every_actual_word_has_a_source_generated_public_functional_replay
    (members : List Party) (task : PublicFunction.PublicTaskSpec Party Good) :
    (wordAt law current original).length = original.length ∧
    (PublicFunction.physicalLaw law).next current (wordAt law current original) = law.next current original ∧
    (PublicFunction.physicalLaw law).rawItems current (wordAt law current original) =
      (law.rawItems current original).map (itemAt law) ∧
    (Necessity.AllNeedsPaid (PublicFunction.physicalLaw law) current members (wordAt law current original) ↔
      Necessity.AllNeedsPaid law current members original) ∧
    (PublicFunction.ServiceAdequate (PublicFunction.physicalLaw law) current task (wordAt law current original) ↔
      PublicFunction.ServiceAdequate law current task original) ∧
    ¬ Nonempty (Kernel.CapitalRelationKernel (PublicFunction.physicalLaw law) current (wordAt law current original)) :=
  ⟨replay_keeps_every_original_instruction_position law current original,
    replay_preserves_the_original_full_next law current original,
    (replay_execution_has_the_same_actual_currents law current 0 original).2,
    every_original_livelihood_and_maintenance_requirement_is_preserved law current original members,
    original_services_keep_their_actual_bearers_bundles_and_windows law current original task,
    open_permissions_have_no_capital_kernel (PublicFunction.physicalLaw law) (fun _ _ _ => rfl)
      current (wordAt law current original)⟩

section GeneratedControl
variable [DecidableEq Port]

theorem replay_generates_no_private_control_family
    (localAttempts : RawCurrent Party Good Technology Instrument → RawEvent Party Good Port Technology Instrument)
    (item : OriginalItem (PublicFunction.physicalLaw law) current (wordAt law current original)) :
    Kernel.AssetAuthority.generatedFamily (PublicFunction.physicalLaw law) current
        (wordAt law current original) localAttempts item = [] ∧
    Kernel.ActualSurplus.familyAt (PublicFunction.physicalLaw law) current (wordAt law current original) item = [] :=
  open_interpretation_generated_families_empty law current (wordAt law current original) localAttempts item

end GeneratedControl

end SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Functions.Replay

