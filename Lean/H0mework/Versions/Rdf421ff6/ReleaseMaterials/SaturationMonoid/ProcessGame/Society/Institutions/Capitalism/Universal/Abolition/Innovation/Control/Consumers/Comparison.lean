open Source.Program
open Scenario

theorem one_original_capital_source_has_paid_contributions_and_a_strict_control_blockage :
    Nonempty (Source.ProgrammeControl.Kernel.CapitalRelationKernel law
      (actualExecution (discovery 2) retaliation 1).before
      (actualExecution (discovery 2) retaliation 1).submitted) ∧
      (after false (discovery 2) retaliation).claims = seed.claims ∧
      (after true (discovery 2) retaliation).claims = seed.claims ∧
      controlLoss law openLaw (actualExecution (discovery 2) retaliation 2).interpreted.items
        (execution true (discovery 2) retaliation).items .material = 18 ∧
      controlLoss law openLaw (actualExecution (discovery 2) retaliation 2).interpreted.items
        (execution true (discovery 2) retaliation).items .result = 3 := by
  exact ⟨the_original_capital_relation_is_generated_before_the_future_trial _ _,
    every_old_financial_address_is_retained_after_real_repayment.1,
    every_old_financial_address_is_retained_after_real_repayment.2,
    removal_has_strict_physical_gain_after_all_real_costs.1,
    removal_has_strict_physical_gain_after_all_real_costs.2.2⟩

theorem the_controller_is_not_needed_for_the_generated_material_successor :
    (openLaw.execute seed 0 (withoutOwnerConsents (word true (discovery 2) retaliation))).final =
      after true (discovery 2) retaliation ∧
    (∀ request ∈ withoutOwnerConsents (word true (discovery 2) retaliation), request.consents = []) :=
  ⟨the_complete_public_material_result_keeps_no_owner_consent_gate _ _ _,
    fun request original => every_cleared_request_has_only_its_original_own_signature _ request original⟩

theorem the_original_root_retains_the_actual_control_case_ledger_and_next :
    type_of% (the_actual_source_consumes_its_original_execution_ledger_and_next
      (discovery 2) retaliation) :=
  the_actual_source_consumes_its_original_execution_ledger_and_next (discovery 2) retaliation

end SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Innovation.Control.Consumers
