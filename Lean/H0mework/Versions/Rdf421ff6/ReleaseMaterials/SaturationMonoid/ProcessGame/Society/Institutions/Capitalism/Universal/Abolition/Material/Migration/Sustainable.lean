import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Material.Migration.Renewal
import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Material.Migration.Transport
import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Material.Continuation.Accumulation

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Material.Migration

open Source.Program Continuation

variable {Party Good Port Technology Instrument : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Port] [DecidableEq Instrument]
  (input : Root.ProgrammeSource.Input Party Good Port Technology Instrument)
  (timing : input.law.TimeIndependent) (policy : input.law.ReserveInsensitive)
  (origin current : RawCurrent Party Good Technology Instrument)
  (members : List Party) (word : RawEvent Party Good Port Technology Instrument)

include timing policy

/-- Future payments are generated by the finite interpreter, source-local
time/reserve laws and the finite support check. No tail is an argument. -/
theorem renewal_generates_every_finite_period
    (checked : RenewalChecks input origin current members word) (n : Nat) :
    PeriodChecks input ((repeatPeriod input current word).currentAt n) members word ∧
    OriginalNeedFloor input origin ((repeatPeriod input current word).currentAt n) members word ∧
    ((repeatPeriod input current word).currentAt n).claims = current.claims := by
  have actual := Balance.checked_productive_period input.law current word checked.2.2.1
  have accepted := fun item present => (checked.1.1 item present).1
  refine ⟨?_, productive_period_keeps_original_need_floor input timing policy current word
    (Balance.gain input.law current word) actual.2 origin members actual.1 accepted checked.2.1 n,
    (productive_period_exact_resources input timing policy current word
      (Balance.gain input.law current word) actual.2 actual.1 accepted n).2.1⟩
  obtain ⟨clock, round, same⟩ := generated_current_has_only_paid_accumulation input timing policy
    current word (Balance.gain input.law current word) actual.2 actual.1 accepted n
  rw [same]
  let reserve := accumulatedReserve (Balance.gain input.law current word) n
  have nonnegative := accumulatedReserve_nonnegative (Balance.gain input.law current word) actual.2 n
  have enlargedNeeds : Exit.Necessity.AllNeedsPaid input.law (current.addReserve reserve) members word := by
    intro person present
    rw [policy.necessities, policy.maintenance]
    exact ⟨bundlePaid_addReserve input policy current reserve nonnegative word accepted
      person _ _ (checked.1.2.1 person present).1,
      bundlePaid_addReserve input policy current reserve nonnegative word accepted
        person _ _ (checked.1.2.1 person present).2⟩
  rcases checked.2.2.2 with self | shared
  · apply periodChecks_of_self_items input _ members word _
      ((needsPaid_retime input timing _ clock round members word).mpr enlargedNeeds) checked.1.2.2.2.2
    have enlargedTrace := executed_items_addReserve input policy current reserve nonnegative 0 word accepted
    have retimedTrace := Exit.AutonomousProduction.executed_items_retime input.law timing
      (current.addReserve reserve) clock round 0 word
    change input.law.rawItems (current.addReserve reserve) word =
      (input.law.rawItems current word).map (reserved reserve) at enlargedTrace
    change input.law.rawItems ((current.addReserve reserve).retime clock round) word =
      (input.law.rawItems (current.addReserve reserve) word).map
        (Exit.AutonomousProduction.retimed clock round) at retimedTrace
    intro item present
    rw [retimedTrace, enlargedTrace] at present
    obtain ⟨enlarged, enlargedMember, rfl⟩ := List.mem_map.mp present
    obtain ⟨original, source, rfl⟩ := List.mem_map.mp enlargedMember
    apply (Exit.AutonomousProduction.at_retime input.law timing _ clock round).mpr
    have own := self original source
    exact ⟨own.1, own.2.1, input.law.valid_addReserve policy _ reserve nonnegative _ own.2.2.1,
      own.2.2.2⟩
  · have enlarged := actualAndIndependent_addReserve input policy current reserve nonnegative word checked.1.1
    refine ⟨(actualAndIndependent_retime input timing _ clock round word).mpr enlarged,
      (needsPaid_retime input timing _ clock round members word).mpr enlargedNeeds,
      finiteShared_noFreshControl input _ word ?_, ?_, checked.1.2.2.2.2⟩
    · apply (finiteShared_retime input timing _ clock round word).mpr
      exact finiteShared_addReserve input policy current reserve nonnegative word accepted shared
    · intro person _present
      have target := next_of_productive_period input timing policy current word
        (Balance.gain input.law current word) actual.1 accepted reserve nonnegative clock round
      change TechniqueDominates (input.law.technique current.technology person)
        (input.law.technique (input.law.next ((current.addReserve reserve).retime clock round) word).technology person)
      rw [target]
      simp [RawCurrent.retime, RawCurrent.addReserve, TechniqueDominates]

end SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Material.Migration

#print axioms SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Material.Migration.renewal_generates_every_finite_period
