import H0mework.Foundation.Agency.Boundary
import Mathlib.Logic.ExistsUnique
import Mathlib.Data.Finset.Basic

/-!
# Source-generated relations, interests, and edge roles

One exact seed in the source occurrence generates both a relation lineage and
its beneficiary actor seed.  `GeneratedInterestAt` is the image of that
single incidence seed; it is not a caller supplied actor--relation predicate.

Roles are read from the generated relation lineage.  The target-side role is
obtained by applying the lineage-generated phase step to its source-side role,
so neither a target role nor a phase verdict is accepted by the public
predicates below.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace Relations

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Lifecycle Universal

universe u v w x

/-- The two role readouts of one actual relation edge. -/
inductive EdgeSide where
  | source
  | target
  deriving DecidableEq, Repr

/-- Source-owned compiler data for relation lineages and their beneficiary
incidences.  An admitted relation seed must simultaneously admit the actor
seed at the same occurrence state.  The role action is fixed once here;
public theorems never receive a role or phase verdict. -/
structure SourceOwnedRelationRoleCompiler
    {Source : Type u} {State : Type v}
    (occurrenceOf : Source → RootedAccountedUnfolding State)
    (game : SaturationMonoid.ProcessGame occurrenceOf)
    (actorFace : M0BoundaryFace.{u, v, w} occurrenceOf) where
  RelationSeed : Type x
  RelationLineage : Source → Type x
  relationSeedAt : Source → State → RelationSeed → Prop
  relationLineageOf : ∀ source,
    SourceSeed occurrenceOf RelationSeed relationSeedAt source →
      RelationLineage source
  beneficiaryActorSeed : RelationSeed → actorFace.Seed
  beneficiaryActor_active : ∀ source state seed,
    relationSeedAt source state seed →
      actorFace.SeedAt source state (beneficiaryActorSeed seed)
  Role : Source → Type x
  Phase : Source → Type x
  sourceRoleOf : ∀ source, RelationLineage source → Role source
  phaseStepOf : ∀ source, RelationLineage source → Phase source
  advanceRole : ∀ source, Phase source → Role source → Role source
  FutureCode : Type x
  futureCodeDecidableEq : DecidableEq FutureCode
  futureCodeCarrier : Finset FutureCode
  futureIdle : FutureCode → Prop
  FutureContinuationAt :
    RelationLineage game.source → EdgeSide → FutureCode → Type x
  futureBoundaryState : RelationLineage game.source → EdgeSide → State
  futureBoundaryState_mem : ∀ lineage side,
    futureBoundaryState lineage side ∈ game.occurrence.trace
  FutureContinuationWitnessAt : ∀ lineage side code,
    FutureContinuationAt lineage side code → Prop
  futureContinuation_witnessed : ∀ lineage side code continuation,
    FutureContinuationWitnessAt lineage side code continuation

variable {Source : Type u} {State : Type v}
variable {occurrenceOf : Source → RootedAccountedUnfolding State}
variable {game : SaturationMonoid.ProcessGame occurrenceOf}
variable {actorFace : M0BoundaryFace.{u, v, w} occurrenceOf}

namespace SourceOwnedRelationRoleCompiler

variable
    (compiler : SourceOwnedRelationRoleCompiler.{u, v, w, x}
      occurrenceOf game actorFace)

/-- The already classified M0 actor carrier consumed by this compiler. -/
abbrev Actor :=
  let _authority := compiler
  GeneratedActor game actorFace.Seed actorFace.SeedAt actorFace.Lineage
    actorFace.lineageOf

/-- A relation-beneficiary seed witnessed in the exact source occurrence. -/
abbrev ExactRelationSeed :=
  SourceSeed occurrenceOf compiler.RelationSeed compiler.relationSeedAt
    game.source

/-- Generated relations are exactly the image of the fixed relation-lineage
compiler on occurrence-witnessed seeds.  The reflexive authority seal keeps
the entire compiler value in the carrier type, so a consumer cannot record-
update its future fields and reuse a relation generated by the original law. -/
def GeneratedRelation :=
  { lineage : compiler.RelationLineage game.source //
    compiler = compiler ∧
      ∃ seed : compiler.ExactRelationSeed,
        lineage = compiler.relationLineageOf game.source seed }

namespace ExactRelationSeed

/-- The beneficiary seed uses the very same trace state that admitted the
relation seed. -/
def actorSeed (seed : compiler.ExactRelationSeed) :
    SourceSeed occurrenceOf actorFace.Seed actorFace.SeedAt game.source := by
  have inTrace : actorFace.state game.source ∈ game.occurrence.trace := by
    rcases seed.2 with ⟨state, stateInTrace, admitted⟩
    have actorActive :=
      compiler.beneficiaryActor_active game.source state seed.1 admitted
    rw [← actorFace.seedAt_state game.source state
      (compiler.beneficiaryActorSeed seed.1) actorActive]
    exact stateInTrace
  have relationActive :
      compiler.relationSeedAt game.source
        (actorFace.state game.source) seed.1 := by
    rcases seed.2 with ⟨state, _stateInTrace, admitted⟩
    have actorActive :=
      compiler.beneficiaryActor_active game.source state seed.1 admitted
    rw [← actorFace.seedAt_state game.source state
      (compiler.beneficiaryActorSeed seed.1) actorActive]
    exact admitted
  exact ⟨compiler.beneficiaryActorSeed seed.1,
    ⟨actorFace.state game.source, inTrace,
      compiler.beneficiaryActor_active game.source
        (actorFace.state game.source) seed.1 relationActive⟩⟩

/-- The M0 actor generated by this exact relation-beneficiary seed. -/
def actor (seed : compiler.ExactRelationSeed) : compiler.Actor :=
  generatedActorOf game actorFace.Seed actorFace.SeedAt actorFace.Lineage
    actorFace.lineageOf (seed.actorSeed compiler)

/-- Exact same-occurrence and exact-state provenance of both outputs of the
relation-beneficiary incidence seed. -/
theorem exact_state_provenance (seed : compiler.ExactRelationSeed) :
    ∃ state ∈ game.occurrence.trace,
      state = actorFace.state game.source ∧
      compiler.relationSeedAt game.source state seed.1 ∧
      actorFace.SeedAt game.source state
        (compiler.beneficiaryActorSeed seed.1) := by
  rcases seed.2 with ⟨state, inTrace, admitted⟩
  have actorActive :=
    compiler.beneficiaryActor_active game.source state seed.1 admitted
  exact ⟨state, inTrace,
    actorFace.seedAt_state game.source state
      (compiler.beneficiaryActorSeed seed.1) actorActive,
    admitted, actorActive⟩

end ExactRelationSeed

/-- Canonical relation generated by one exact relation-beneficiary seed. -/
def relationOf (seed : compiler.ExactRelationSeed) :
    compiler.GeneratedRelation :=
  ⟨compiler.relationLineageOf game.source seed, rfl, seed, rfl⟩

@[simp] theorem relationOf_value (seed : compiler.ExactRelationSeed) :
    (compiler.relationOf seed).1 =
      compiler.relationLineageOf game.source seed :=
  rfl

/-- Every generated relation exposes an exact relation-beneficiary seed at
the actor face's source-owned boundary state. -/
theorem generatedRelation_has_exact_seed
    (relation : compiler.GeneratedRelation) :
    ∃ seed : compiler.ExactRelationSeed,
      (∃ state ∈ game.occurrence.trace,
        state = actorFace.state game.source ∧
        compiler.relationSeedAt game.source state seed.1 ∧
        actorFace.SeedAt game.source state
          (compiler.beneficiaryActorSeed seed.1)) ∧
      compiler.relationOf seed = relation := by
  rcases relation.2.2 with ⟨seed, generated⟩
  refine ⟨seed, seed.exact_state_provenance compiler, Subtype.ext ?_⟩
  exact generated.symm

/-- Actor--relation standing is exactly the image of one same-occurrence
relation-beneficiary incidence seed. -/
def GeneratedInterestAt
    (actor : compiler.Actor) (relation : compiler.GeneratedRelation) : Prop :=
  ∃ seed : compiler.ExactRelationSeed,
    seed.actor compiler = actor ∧ compiler.relationOf seed = relation

theorem generatedInterestAt_iff_exact_seed_image
    (actor : compiler.Actor) (relation : compiler.GeneratedRelation) :
    compiler.GeneratedInterestAt actor relation ↔
      ∃ seed : compiler.ExactRelationSeed,
        seed.actor compiler = actor ∧
          compiler.relationOf seed = relation :=
  Iff.rfl

/-- Every generated relation carries at least one beneficiary generated by
the exact seed that generated the relation itself. -/
theorem generatedRelation_has_generated_beneficiary
    (relation : compiler.GeneratedRelation) :
    ∃ actor : compiler.Actor,
      compiler.GeneratedInterestAt actor relation := by
  rcases relation.2.2 with ⟨seed, generated⟩
  refine ⟨seed.actor compiler, seed, rfl, Subtype.ext ?_⟩
  exact generated.symm

/-- Exact trace/state provenance can be recovered from every generated
actor--relation incidence, without choosing a representative of an actor
lineage fibre. -/
theorem GeneratedInterestAt.exact_state_provenance
    {actor : compiler.Actor} {relation : compiler.GeneratedRelation}
    (interest : compiler.GeneratedInterestAt actor relation) :
    ∃ seed : compiler.ExactRelationSeed,
      (∃ state ∈ game.occurrence.trace,
        state = actorFace.state game.source ∧
        compiler.relationSeedAt game.source state seed.1 ∧
        actorFace.SeedAt game.source state
          (compiler.beneficiaryActorSeed seed.1)) ∧
      seed.actor compiler = actor ∧
      compiler.relationOf seed = relation := by
  rcases interest with ⟨seed, actorEq, relationEq⟩
  exact ⟨seed, seed.exact_state_provenance compiler, actorEq, relationEq⟩

/-- Phase is a readout of the generated relation lineage itself. -/
def phaseStep (relation : compiler.GeneratedRelation) :
    compiler.Phase game.source :=
  compiler.phaseStepOf game.source relation.1

/-- Source-side role is read from the generated lineage; target-side role is
the action of its generated phase step. -/
def roleAt (relation : compiler.GeneratedRelation) :
    EdgeSide → compiler.Role game.source
  | .source => compiler.sourceRoleOf game.source relation.1
  | .target => compiler.advanceRole game.source
      (compiler.phaseStep relation)
      (compiler.sourceRoleOf game.source relation.1)

@[simp] theorem roleAt_source (relation : compiler.GeneratedRelation) :
    compiler.roleAt relation .source =
      compiler.sourceRoleOf game.source relation.1 :=
  rfl

@[simp] theorem roleAt_target (relation : compiler.GeneratedRelation) :
    compiler.roleAt relation .target =
      compiler.advanceRole game.source (compiler.phaseStep relation)
        (compiler.roleAt relation .source) :=
  rfl

@[simp] theorem phaseStep_eq_lineage_readout
    (relation : compiler.GeneratedRelation) :
    compiler.phaseStep relation =
      compiler.phaseStepOf game.source relation.1 :=
  rfl

/-- A role is authoritative only when the actor and relation share an exact
generated-interest incidence; its value is then calculated from the relation
lineage and the requested edge side. -/
def RelationRoleAt
    (actor : compiler.Actor) (relation : compiler.GeneratedRelation)
    (side : EdgeSide) (role : compiler.Role game.source) : Prop :=
  compiler.GeneratedInterestAt actor relation ∧
    role = compiler.roleAt relation side

theorem relationRoleAt_iff_generated_interest_and_eq
    (actor : compiler.Actor) (relation : compiler.GeneratedRelation)
    (side : EdgeSide) (role : compiler.Role game.source) :
    compiler.RelationRoleAt actor relation side role ↔
      compiler.GeneratedInterestAt actor relation ∧
        role = compiler.roleAt relation side :=
  Iff.rfl

/-- For a fixed actor, generated relation lineage and edge side, the role is
total and unique.  The only premise is the source-generated incidence. -/
theorem relationRoleAt_total_unique
    {actor : compiler.Actor} {relation : compiler.GeneratedRelation}
    (interest : compiler.GeneratedInterestAt actor relation)
    (side : EdgeSide) :
    ∃! uniqueRole : compiler.Role game.source,
      compiler.RelationRoleAt actor relation side uniqueRole := by
  refine ⟨compiler.roleAt relation side, ⟨interest, rfl⟩, ?_⟩
  intro candidate generated
  exact generated.2

end SourceOwnedRelationRoleCompiler
end Relations
end Society
end ProcessGame
end SaturationMonoid
