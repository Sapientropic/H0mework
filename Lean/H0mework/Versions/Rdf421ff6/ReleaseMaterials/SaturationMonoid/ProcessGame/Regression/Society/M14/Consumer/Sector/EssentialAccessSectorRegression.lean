import H0mework.Versions.Rfde5c14d.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Fixture.EssentialAccessRelationFixture
import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Consumer.Capture.CounterpartyCaptureRenewalRegression

/-!
# M14 source-generated tenure capture renewal

The existing payment counterparty is also the actor generated by the exact
`tenure` relation event.  Full UBI price capture therefore joins to a tenure
relation whose phase and target role are generated from that event's lineage.
The exact capture beneficiary, tenure actor, tenure role, source-owned
residual, and consumer-generated payment next commute.

An exact `health` relation supplies the adversarial control.  Tenure and
health have distinct actors, relations, phases, and roles but the same old
`ProtectedInterest = Unit` readout.  That readout admits no reconstruction of
the relation authority or sector phase.  Domain meaning comes from the actual
relation seed, never from an administrative label.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14EssentialAccessSectorRegression

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Lifecycle Universal Relations Exchange Settlement Price Money UBI
open Renewal Capacity Space CrossingCost
open Settlement.SourceOwnedSettlementCompiler
open UBI.Capture
open M3FiniteExchangeFixture M3ExchangeSettlementPriceRegression
open M14UBIExitCapacityFixture
open M14UBIPeriodicRootHistory
open M14CaptureResponsibilityDispositionRegression
open M14CounterpartyCaptureRenewalRegression
open M14EssentialAccessRelationFixture

/-- Fixed domain join.  It stores only propositions and accepts no sector,
actor, relation, phase, role, consumer, or next as a premise. -/
structure SourceGeneratedTenureCaptureRenewalAt : Prop where
  private mk ::
  counterpartyRenewal : SourceGeneratedCounterpartyCaptureRenewalAt
    capturedProgram ExitFutureCode.leave leave_is_captured
  tenureInterest : essentialAccessRelationCompiler.GeneratedInterestAt
    tenureActor tenureRelation
  tenureActor_eq_counterparty :
    tenureActor = exactCounterpartyActor exactResidualActivation
  tenurePhase : essentialAccessRelationCompiler.phaseStep tenureRelation =
    .tenure
  tenureTargetRole :
    essentialAccessRelationCompiler.RelationRoleAt tenureActor tenureRelation
      .target .tenureProvider

theorem tenureCaptureRenewal : SourceGeneratedTenureCaptureRenewalAt where
  counterpartyRenewal := fixedCounterpartyCaptureRenewal
  tenureInterest := tenureInterest
  tenureActor_eq_counterparty := tenure_actor_is_exact_payment_counterparty
  tenurePhase := tenure_phase_is_generated
  tenureTargetRole := ⟨tenureInterest, tenure_target_role_is_generated.symm⟩

/-- Exact commuting mouth: the sector relation is not a label attached after
the fact; it shares the generated counterparty actor with the capture
beneficiary and the exact residual consumer next. -/
theorem tenure_beneficiary_role_residual_next_commute :
    OpenSettlementAt.protectedInterest
        (fullCapture.captureSettlement ExitFutureCode.leave
          leave_is_captured) =
      exchangeLaw.protectedInterestOfActor tenureActor ∧
    essentialAccessRelationCompiler.RelationRoleAt tenureActor tenureRelation
      .target .tenureProvider ∧
    Nonempty (SourceOwnsResponsibilityIncidence M3FiniteExchangeFixture.V
      (M3FiniteExchangeFixture.P.boundarySource
        capturedProgram.purchasingPowerStanding.activatedConsumer.activation)
      (exactOpenSettlement exactResidualActivation).obligation) ∧
    capturedProgram.purchasingPowerStanding.activatedConsumer.nextGeneratedState =
      capturedProgram.payment.nextGenerated := by
  constructor
  · rw [tenure_actor_is_exact_payment_counterparty]
    exact fixedCounterpartyCaptureRenewal.captureDisposition
      |>.beneficiaryGenerated
  exact ⟨tenureCaptureRenewal.tenureTargetRole,
    fixedCounterpartyCaptureRenewal.captureDisposition.sourceOwnedResidual,
    fixedCounterpartyCaptureRenewal.captureDisposition
      |>.consumerNextIsPaymentNext⟩

theorem tenure_relation_has_exact_trace_provenance :
    ∃ seed : essentialAccessRelationCompiler.ExactRelationSeed,
      (∃ state ∈ Lifecycle.actualEventGame.occurrence.trace,
        state = Lifecycle.Universal.FixedAdapter.core.targetFace.state
          Lifecycle.actualEventGame.source ∧
        essentialAccessRelationCompiler.relationSeedAt
          Lifecycle.actualEventGame.source state seed.1 ∧
        Lifecycle.Universal.FixedAdapter.core.targetFace.SeedAt
          Lifecycle.actualEventGame.source state
          (essentialAccessRelationCompiler.beneficiaryActorSeed seed.1)) ∧
      seed.actor essentialAccessRelationCompiler = tenureActor ∧
      essentialAccessRelationCompiler.relationOf seed = tenureRelation :=
  tenureInterest.exact_state_provenance

/-! ## Protected-interest observer no-go -/

/-- Two exact relation authorities.  Each constructor carries its actual
generated interest; this is a finite test fibre, not a sector registry. -/
inductive EssentialAccessRelationAuthority where
  | tenure (interest : essentialAccessRelationCompiler.GeneratedInterestAt
      tenureActor tenureRelation)
  | health (interest : essentialAccessRelationCompiler.GeneratedInterestAt
      healthActor healthRelation)

def tenureAuthority : EssentialAccessRelationAuthority :=
  .tenure tenureInterest

def healthAuthority : EssentialAccessRelationAuthority :=
  .health healthInterest

def protectedInterestReadout : EssentialAccessRelationAuthority →
    M3FiniteExchangeFixture.V.ProtectedInterest
  | .tenure _ => exchangeLaw.protectedInterestOfActor tenureActor
  | .health _ => exchangeLaw.protectedInterestOfActor healthActor

def sectorPhaseReadout : EssentialAccessRelationAuthority →
    EssentialAccessSector
  | .tenure _ => essentialAccessRelationCompiler.phaseStep tenureRelation
  | .health _ => essentialAccessRelationCompiler.phaseStep healthRelation

theorem tenure_and_health_authorities_distinct :
    tenureAuthority ≠ healthAuthority := by
  intro equality
  cases equality

theorem protectedInterestReadout_same :
    protectedInterestReadout tenureAuthority =
      protectedInterestReadout healthAuthority :=
  tenure_health_protectedInterest_readouts_eq

theorem sectorPhaseReadout_different :
    sectorPhaseReadout tenureAuthority ≠ sectorPhaseReadout healthAuthority :=
  tenure_health_phases_ne

theorem protectedInterestReadout_not_injective :
    ¬ Function.Injective protectedInterestReadout := by
  intro injective
  exact tenure_and_health_authorities_distinct
    (injective protectedInterestReadout_same)

theorem no_protectedInterest_authority_reconstruction :
    ¬ ∃ reconstruct : M3FiniteExchangeFixture.V.ProtectedInterest →
        EssentialAccessRelationAuthority,
      Function.LeftInverse reconstruct protectedInterestReadout := by
  rintro ⟨reconstruct, leftInverse⟩
  have authoritiesEqual : tenureAuthority = healthAuthority := by
    calc
      tenureAuthority = reconstruct (protectedInterestReadout tenureAuthority) :=
        (leftInverse tenureAuthority).symm
      _ = reconstruct (protectedInterestReadout healthAuthority) :=
        congrArg reconstruct protectedInterestReadout_same
      _ = healthAuthority := leftInverse healthAuthority
  exact tenure_and_health_authorities_distinct authoritiesEqual

theorem protectedInterest_cannot_reconstruct_sector_phase :
    ¬ ∃ reconstruct : M3FiniteExchangeFixture.V.ProtectedInterest →
        EssentialAccessSector,
      reconstruct (protectedInterestReadout tenureAuthority) =
          sectorPhaseReadout tenureAuthority ∧
      reconstruct (protectedInterestReadout healthAuthority) =
          sectorPhaseReadout healthAuthority := by
  rintro ⟨reconstruct, tenureExact, healthExact⟩
  have phasesEqual :
      sectorPhaseReadout tenureAuthority =
        sectorPhaseReadout healthAuthority := by
    calc
      _ = reconstruct (protectedInterestReadout tenureAuthority) :=
        tenureExact.symm
      _ = reconstruct (protectedInterestReadout healthAuthority) :=
        congrArg reconstruct protectedInterestReadout_same
      _ = _ := healthExact
  exact sectorPhaseReadout_different phasesEqual

def administrativeSectorReadout (_label : Bool) : EssentialAccessSector :=
  essentialAccessRelationCompiler.phaseStep tenureRelation

@[simp] theorem administrative_label_does_not_control_sector :
    administrativeSectorReadout false = administrativeSectorReadout true :=
  rfl

/-! ## Periodic tenure capture authority -/

structure PeriodicTenureCaptureRenewalAt
    (depth : Nat)
    (payment : PeriodicSourceBackedPaymentAt depth) : Prop where
  periodicCounterparty : PeriodicCounterpartyCaptureRenewalAt depth payment
  tenureRenewal : SourceGeneratedTenureCaptureRenewalAt
  exactSector : essentialAccessRelationCompiler.phaseStep tenureRelation =
    .tenure
  exactRole : essentialAccessRelationCompiler.RelationRoleAt
    tenureActor tenureRelation .target .tenureProvider

theorem periodicTenureCaptureRenewalAt (depth : Nat) :
    PeriodicTenureCaptureRenewalAt depth
      (periodicSourceBackedPaymentAt depth) where
  periodicCounterparty := periodicCounterpartyCaptureRenewalAt depth
  tenureRenewal := tenureCaptureRenewal
  exactSector := tenure_phase_is_generated
  exactRole := tenureCaptureRenewal.tenureTargetRole

structure EssentialAccessSectorCertificate : Prop where
  everyDepth : ∀ depth : Nat,
    PeriodicTenureCaptureRenewalAt depth
      (periodicSourceBackedPaymentAt depth)
  actorIsExactCounterparty :
    tenureActor = exactCounterpartyActor exactResidualActivation
  tenureTraceProvenance :
    ∃ seed : essentialAccessRelationCompiler.ExactRelationSeed,
      (∃ state ∈ Lifecycle.actualEventGame.occurrence.trace,
        state = Lifecycle.Universal.FixedAdapter.core.targetFace.state
          Lifecycle.actualEventGame.source ∧
        essentialAccessRelationCompiler.relationSeedAt
          Lifecycle.actualEventGame.source state seed.1 ∧
        Lifecycle.Universal.FixedAdapter.core.targetFace.SeedAt
          Lifecycle.actualEventGame.source state
          (essentialAccessRelationCompiler.beneficiaryActorSeed seed.1)) ∧
      seed.actor essentialAccessRelationCompiler = tenureActor ∧
      essentialAccessRelationCompiler.relationOf seed = tenureRelation
  tenureHealthActorsDistinct : tenureActor ≠ healthActor
  tenureHealthRelationsDistinct : tenureRelation ≠ healthRelation
  tenureHealthPhasesDistinct :
    essentialAccessRelationCompiler.phaseStep tenureRelation ≠
      essentialAccessRelationCompiler.phaseStep healthRelation
  sameProtectedInterestReadout :
    protectedInterestReadout tenureAuthority =
      protectedInterestReadout healthAuthority
  protectedInterestNoninjective :
    ¬ Function.Injective protectedInterestReadout
  noAuthorityReconstruction :
    ¬ ∃ reconstruct : M3FiniteExchangeFixture.V.ProtectedInterest →
        EssentialAccessRelationAuthority,
      Function.LeftInverse reconstruct protectedInterestReadout
  noSectorReconstruction :
    ¬ ∃ reconstruct : M3FiniteExchangeFixture.V.ProtectedInterest →
        EssentialAccessSector,
      reconstruct (protectedInterestReadout tenureAuthority) =
          sectorPhaseReadout tenureAuthority ∧
      reconstruct (protectedInterestReadout healthAuthority) =
          sectorPhaseReadout healthAuthority
  administrativeObserverNonAuthority :
    administrativeSectorReadout false = administrativeSectorReadout true
  beneficiaryRoleResidualNextCommute :
    OpenSettlementAt.protectedInterest
        (fullCapture.captureSettlement ExitFutureCode.leave
          leave_is_captured) =
      exchangeLaw.protectedInterestOfActor tenureActor ∧
    essentialAccessRelationCompiler.RelationRoleAt tenureActor tenureRelation
      .target .tenureProvider ∧
    Nonempty (SourceOwnsResponsibilityIncidence M3FiniteExchangeFixture.V
      (M3FiniteExchangeFixture.P.boundarySource
        capturedProgram.purchasingPowerStanding.activatedConsumer.activation)
      (exactOpenSettlement exactResidualActivation).obligation) ∧
    capturedProgram.purchasingPowerStanding.activatedConsumer.nextGeneratedState =
      capturedProgram.payment.nextGenerated

theorem essentialAccessSectorDirectConsumer :
    EssentialAccessSectorCertificate where
  everyDepth := periodicTenureCaptureRenewalAt
  actorIsExactCounterparty := tenure_actor_is_exact_payment_counterparty
  tenureTraceProvenance := tenure_relation_has_exact_trace_provenance
  tenureHealthActorsDistinct := tenure_health_actors_ne
  tenureHealthRelationsDistinct := tenure_health_relations_ne
  tenureHealthPhasesDistinct := tenure_health_phases_ne
  sameProtectedInterestReadout := protectedInterestReadout_same
  protectedInterestNoninjective := protectedInterestReadout_not_injective
  noAuthorityReconstruction := no_protectedInterest_authority_reconstruction
  noSectorReconstruction := protectedInterest_cannot_reconstruct_sector_phase
  administrativeObserverNonAuthority :=
    administrative_label_does_not_control_sector
  beneficiaryRoleResidualNextCommute :=
    tenure_beneficiary_role_residual_next_commute

end
end M14EssentialAccessSectorRegression
end Society
end ProcessGame
end SaturationMonoid

