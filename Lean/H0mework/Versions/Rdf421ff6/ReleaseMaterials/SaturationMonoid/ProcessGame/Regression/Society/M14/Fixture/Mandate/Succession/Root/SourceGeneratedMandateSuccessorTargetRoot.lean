import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M9.JointRoot.Mandate.SourceSuppliedMandateSuffix
import H0mework.Versions.Rfde5c14d.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Fixture.Mandate.Succession.SourceMandateSuccession

/-!
# Source-generated successor-mandate target root

This is the one-slot target representation for the new admission generated by
the post-exit election-history fold.  The old exit current remains in the
history trace, but the installed coordinate is indexed only by the successor
history and its fresh controller.  The same root representation retains the
existing UBI Payment coordinate and whole-ledger compiler.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceGeneratedMandateSuccessorTargetRoot

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Renewal Election Relations Power UBI
open M8ActualElectionMandateRenewalRegression
open M9ProofCarryingRenewalInquiryRoot
open M9SourceSuppliedMandateSuffix
open M14SourceMandateRenewal
open M14SourceMandateSuccession
open M14UBIExitCapacityFixture
open M14UBIProofCarryingRootRestriction

abbrev N := M9ProofCarryingRenewalInquiryRoot.N
abbrev V := M9ProofCarryingRenewalInquiryRoot.V

/-- One-slot successor representation generated from the exact successor
history.  It is not a sibling canonical runtime. -/
def mandateSuccessorTargetRoot : SourceNativeLivingRootClosure N V :=
  jointRootFor sourceMandateSuccessorHistory

def mandateSuccessorTargetInitialVisit : SourceNativeTemporalVisitAt
    mandateSuccessorTargetRoot.toAuthoritativeRoot.toLedgerRoot :=
  jointVisitFor sourceMandateSuccessorHistory

def mandateSuccessorTargetRecognition : SourceNativeRenewalRecognitionAt
    mandateSuccessorTargetRoot SourceMandateSuccessorGame
      SourceMandateSuccessorSeed SourceMandateSuccessorSeedAt
        SourceMandateSuccessorConsumerAt
          SourceMandateSuccessorDispositionAt :=
  mandateRecognitionFor sourceMandateSuccessorHistory

def installedMandateSuccessor : SourceInstalledRenewalAt
    mandateSuccessorTargetRecognition mandateSuccessorTargetInitialVisit :=
  SourceInstalledRenewalAt.generate PUnit.unit rfl

def installedMandateSuccessorLocalFace :
    SourceMandateSuccessorRenewalFace :=
  installedMandateSuccessor.localFace
    (fun _ exactSeed =>
      lineageCompiler.controllerOf exactSeed.1.controllerSeed)
    (mandateStandingOf sourceMandateSuccessorHistory lineageCompiler)

def mandateSuccessorTargetUBIRecognition : SourceNativeRenewalRecognitionAt
    mandateSuccessorTargetRoot M14UBIProofCarryingRootRestriction.LocalGame
      M14UBIProofCarryingRootRestriction.LocalSeed
      M14UBIProofCarryingRootRestriction.LocalSeedAt
      M14UBIProofCarryingRootRestriction.UBIConsumerAt
      M14UBIProofCarryingRootRestriction.UBIDispositionAt :=
  ubiRecognitionFor sourceMandateSuccessorHistory

def installedMandateSuccessorTargetUBI : SourceInstalledRenewalAt
    mandateSuccessorTargetUBIRecognition
      mandateSuccessorTargetInitialVisit :=
  SourceInstalledRenewalAt.generate PUnit.unit rfl

structure MandateSuccessorTargetSourceBackedPaymentAt : Type 3 where
  private mk ::
  installed : SourceInstalledRenewalAt mandateSuccessorTargetUBIRecognition
    mandateSuccessorTargetInitialVisit
  exactRestriction : installed.payload.consumer =
    sourceGeneratedUBIRootRestriction
  rootOccurrence : ExactTemporalCausalRootEventAt
    mandateSuccessorTargetRoot.toAuthoritativeRoot.toLedgerRoot
      mandateSuccessorTargetInitialVisit
  rootOccurrenceExact : rootOccurrence =
    (mandateSuccessorTargetRoot.toAuthoritativeRoot.toLedgerRoot
      ).exactTemporalCausalEventAt mandateSuccessorTargetInitialVisit
  paymentReceipt : SourceBackedUBIPaymentReceiptAt
    exitCapacityProgram.purchasingPowerStanding ExitFutureCode.leave
  rootFactorization : installed.RootAnswerAndNextFactorizes

def mandateSuccessorTargetSourceBackedPaymentAt :
    MandateSuccessorTargetSourceBackedPaymentAt where
  installed := installedMandateSuccessorTargetUBI
  exactRestriction := rfl
  rootOccurrence :=
    mandateSuccessorTargetRoot.toAuthoritativeRoot.toLedgerRoot
      |>.exactTemporalCausalEventAt mandateSuccessorTargetInitialVisit
  rootOccurrenceExact := rfl
  paymentReceipt := SourceBackedUBIPaymentReceiptAt.generate
  rootFactorization :=
    installedMandateSuccessorTargetUBI.rootAnswerAndNext_factorizes

def mandateSuccessorTargetOccurrence : ExactTemporalCausalRootEventAt
    mandateSuccessorTargetRoot.toAuthoritativeRoot.toLedgerRoot
      mandateSuccessorTargetInitialVisit :=
  mandateSuccessorTargetRoot.toAuthoritativeRoot.toLedgerRoot
    |>.exactTemporalCausalEventAt mandateSuccessorTargetInitialVisit

def mandateSuccessorTargetInitialGenerated :
    SourceNativeTemporalVisitGeneratedEvolutionAt
      mandateSuccessorTargetRoot.toAuthoritativeRoot.toLedgerRoot
        mandateSuccessorTargetInitialVisit :=
  mandateSuccessorTargetRoot.toAuthoritativeRoot.toLedgerRoot
    |>.generatedAtTemporalVisit mandateSuccessorTargetInitialVisit

def mandateSuccessorTargetEntry : OpenResponsibilityAt N true :=
  RootInquiryU8CompletionRegression.entry

def mandateSuccessorTargetEntryRow :
    mandateSuccessorTargetInitialGenerated.GeneratedEntryRowAt
      mandateSuccessorTargetEntry :=
  (mandateSuccessorTargetInitialGenerated.canonicalGeneratedEntryRow?
    mandateSuccessorTargetEntry).get (by rfl)

def mandateSuccessorTargetFirstSuccessor :
    SourceNativeLedgerGeneratedSuccessorAt
      mandateSuccessorTargetInitialGenerated.occurrence
      mandateSuccessorTargetInitialGenerated.wholeLedgerWriteBack :=
  (SourceNativeLedgerGeneratedSuccessorAt.ofGenerated?
    mandateSuccessorTargetInitialGenerated.wholeLedgerWriteBack).get (by rfl)

@[simp] theorem installedMandateSuccessor_face_exact :
    installedMandateSuccessorLocalFace = sourceMandateSuccessorFace :=
  rfl

theorem installedMandateSuccessor_retains_exit_trace :
    sourceMandateExitHistory.current ∈
      sourceMandateSuccessorHistory.occurrence.trace :=
  sourceMandateSuccessor_retains_exit_current

theorem installedMandateSuccessor_controller_fresh :
    installedMandateSuccessorLocalFace.actor.1 ≠
        sourceMandateHistory.current.controllerSeed ∧
      installedMandateSuccessorLocalFace.actor.1 ≠
        sourceMandateExitHistory.current.controllerSeed := by
  rw [installedMandateSuccessor_face_exact]
  exact sourceMandateSuccessor_controller_is_fresh

@[simp] theorem installedMandateSuccessor_phase_renew :
    (officeControllerRelationCompiler sourceMandateSuccessorHistory
      lineageCompiler).phaseStep
        (generatedOfficeControllerRelation sourceMandateSuccessorHistory
          lineageCompiler) = MandatePhase.renew :=
  sourceMandateSuccessor_relation_phase_is_renew

@[simp] theorem installedMandateSuccessor_role_held :
    (officeControllerRelationCompiler sourceMandateSuccessorHistory
      lineageCompiler).roleAt
        (generatedOfficeControllerRelation sourceMandateSuccessorHistory
          lineageCompiler) .target = MandateRole.held :=
  sourceMandateSuccessor_target_role_is_held

@[simp] theorem installedMandateSuccessor_power_restored :
    (installedMandateSuccessorLocalFace.responsibilityConsumer.1.1
      ).freedomChange.kind = FreedomChangeKind.restored := by
  rw [installedMandateSuccessor_face_exact]
  exact sourceMandateSuccessor_power_is_restored

theorem installedMandateSuccessor_obligation_live :
    installedMandateSuccessorLocalFace.exactDisposition.1.target.slots[
        (mandateSlot lineageCompiler
          sourceMandateSuccessorHistory.current).val]? =
      some (.live (mandateObligation lineageCompiler
        sourceMandateSuccessorHistory.current)) := by
  rw [installedMandateSuccessor_face_exact]
  exact sourceMandateSuccessor_obligation_is_live

@[simp] theorem installedMandateSuccessorTargetUBI_consumer_exact :
    installedMandateSuccessorTargetUBI.payload.consumer =
      sourceGeneratedUBIRootRestriction :=
  rfl

abbrev SuccessorMandateCoordinateSeparation : Prop :=
    mandateProjectionFor sourceMandateSuccessorHistory ≠
        recognitionWitnessProjectionFor sourceMandateSuccessorHistory ∧
      mandateProjectionFor sourceMandateSuccessorHistory ≠
        ubiProjectionFor sourceMandateSuccessorHistory ∧
      mandateProjectionFor sourceMandateSuccessorHistory ≠
        proofCarryingProjectionFor sourceMandateSuccessorHistory ∧
      mandateProjectionFor sourceMandateSuccessorHistory ≠
        inquiryProjectionFor sourceMandateSuccessorHistory ∧
      mandateProjectionFor sourceMandateSuccessorHistory ≠
        essentialServiceProjectionFor sourceMandateSuccessorHistory ∧
      mandateProjectionFor sourceMandateSuccessorHistory ≠
        routeProjectionFor sourceMandateSuccessorHistory ∧
      mandateProjectionFor sourceMandateSuccessorHistory ≠
        commonClearingProjectionFor sourceMandateSuccessorHistory ∧
      mandateProjectionFor sourceMandateSuccessorHistory ≠
        clearingBackstopProjectionFor sourceMandateSuccessorHistory

theorem successor_inventory_has_one_named_mandate_coordinate :
    SuccessorMandateCoordinateSeparation :=
  mandateProjection_distinct_from_other_named_coordinates
    sourceMandateSuccessorHistory

/-- The installed mandate component itself has one `PUnit` coordinate.  Its
embedding cannot expose two different mandate coordinates in the successor
inventory. -/
abbrev SuccessorMandateComponentProjection :=
  (sourceMandateRenewalLawFor sourceMandateSuccessorHistory
    mandateRootShell).toProjectionLaw.Projection

def SecondInstalledSuccessorMandateCoordinate : Prop :=
  ∃ left right : SuccessorMandateComponentProjection,
    (mandateInstallationFor sourceMandateSuccessorHistory).embed left ≠
      (mandateInstallationFor sourceMandateSuccessorHistory).embed right

theorem secondInstalledSuccessorMandateCoordinate_isEmpty :
    IsEmpty SecondInstalledSuccessorMandateCoordinate := by
  constructor
  rintro ⟨left, right, distinct⟩
  cases left
  cases right
  exact distinct rfl

end
end M14SourceGeneratedMandateSuccessorTargetRoot
end Society
end ProcessGame
end SaturationMonoid

