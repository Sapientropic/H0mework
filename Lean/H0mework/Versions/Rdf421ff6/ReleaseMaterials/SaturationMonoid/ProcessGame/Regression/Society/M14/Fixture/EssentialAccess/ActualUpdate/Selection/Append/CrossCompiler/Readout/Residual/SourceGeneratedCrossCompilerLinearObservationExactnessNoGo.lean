import H0mework.Realization.Relations.P116

/-!
# Linear P98/P99 observation exactness no-go

Composing the exact cross-runtime replay with any additive-valued observer
still yields a linear-time observation-difference cochain.  P102 makes that
cochain a coboundary; P116 therefore makes it path-additive and rules out a
nontrivial H¹ obstruction.  A cyclic social residual must be generated by
actual relation incidence, not inferred from this calculation trace.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceGeneratedCrossCompilerLinearObservationExactnessNoGo

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open ConstructiveRoot.RootInquiryCompletion
open M14SourceGeneratedTenureQueueAppendRuntime
open M14SourceGeneratedCrossCompilerRelationAppendRuntime
open M14SourceGeneratedCrossCompilerP98P99RuntimeTrace

/-- An arbitrary additive-valued readout of the exact runtime occurrence.
Only the observation changes; the write is still the unique runtime's
two-tick successor. -/
def crossCompilerObservedRuntimeQuery
    {A : Type*} [AddCommGroup A]
    (observer : AnyAuthoritativeRootCurrent → A) :
    ReflexiveQuery runtime.State A where
  read := fun state => observer state.engine.node.erase
  write := crossCompilerRuntimeReplayQuery.write

/-- Changing the observer does not change P98's exact runtime-state section. -/
theorem crossCompilerObservedP98_stateAt_exact
    {A : Type*} [AddCommGroup A]
    (observer : AnyAuthoritativeRootCurrent → A) (depth : Nat) :
    (reflexiveQueryIteratedTimeField
      (crossCompilerObservedRuntimeQuery observer)
      crossCompilerRuntimeReplayInitial).stateAt depth =
        runtime.stateAt (crossActionRuntimeDepth depth) := by
  induction depth with
  | zero => rfl
  | succ depth inductionHypothesis =>
      rw [reflexiveQueryIterated_stateAt_succ, inductionHypothesis]
      change
        ((runtime.stateAt (crossActionRuntimeDepth depth)).tick.nextState
          ).tick.nextState =
            runtime.stateAt (crossActionRuntimeDepth (depth + 1))
      rw [crossActionRuntimeDepth]
      rfl

/-- The observer-valued linear cochain computed from the P98 section. -/
abbrev crossCompilerLinearObservationCochain
    {A : Type*} [AddCommGroup A]
    (observer : AnyAuthoritativeRootCurrent → A) : Nat → Nat → A :=
  reflexiveIteratedObservationCochain
    (crossCompilerObservedRuntimeQuery observer)
    crossCompilerRuntimeReplayInitial

/-- P102: every such linear observation cochain is globally potential
explainable. -/
theorem crossCompilerLinearObservation_is_coboundary
    {A : Type*} [AddCommGroup A]
    (observer : AnyAuthoritativeRootCurrent → A) :
    CechAdditiveCover.OneCoboundary
      (identityPairZeroTripleCover Nat A)
      (crossCompilerLinearObservationCochain observer) :=
  reflexiveIteratedObservationCochain_is_coboundary
    (crossCompilerObservedRuntimeQuery observer)
    crossCompilerRuntimeReplayInitial

/-- P116: the same cochain is path-additive. -/
theorem crossCompilerLinearObservation_pathAdditive
    {A : Type*} [AddCommGroup A]
    (observer : AnyAuthoritativeRootCurrent → A) :
    PathAdditive (crossCompilerLinearObservationCochain observer) :=
  (oneCoboundary_iff_pathAdditive
    (crossCompilerLinearObservationCochain observer)).mp
      (crossCompilerLinearObservation_is_coboundary observer)

/-- Strong negative result: no observer of the linear P98/P99 trace can turn
that trace alone into nontrivial H¹. -/
theorem crossCompilerLinearObservation_not_h1
    {A : Type*} [AddCommGroup A]
    (observer : AnyAuthoritativeRootCurrent → A) :
    Not (CechAdditiveCover.H1Obstruction
      (identityPairZeroTripleCover Nat A)
      (crossCompilerLinearObservationCochain observer)) := by
  intro obstruction
  exact
    ((h1Obstruction_iff_not_pathAdditive
      (crossCompilerLinearObservationCochain observer)).mp obstruction)
        (crossCompilerLinearObservation_pathAdditive observer)

/-- Direct consumer keeps the exact P98/P99 runtime trace and its strongest
cohomological no-go in one downstream readout. -/
theorem crossCompilerLinearObservationExactness_directConsumer
    {A : Type*} [AddCommGroup A]
    (observer : AnyAuthoritativeRootCurrent → A) (depth : Nat) :
    type_of% (crossCompilerP98P99_directConsumer depth) ∧
      (reflexiveQueryIteratedTimeField
        (crossCompilerObservedRuntimeQuery observer)
        crossCompilerRuntimeReplayInitial).stateAt depth =
          runtime.stateAt (9 + 2 * depth) ∧
      CechAdditiveCover.OneCoboundary
        (identityPairZeroTripleCover Nat A)
        (crossCompilerLinearObservationCochain observer) ∧
      PathAdditive (crossCompilerLinearObservationCochain observer) ∧
      Not (CechAdditiveCover.H1Obstruction
        (identityPairZeroTripleCover Nat A)
        (crossCompilerLinearObservationCochain observer)) := by
  refine ⟨crossCompilerP98P99_directConsumer depth, ?_,
    crossCompilerLinearObservation_is_coboundary observer,
    crossCompilerLinearObservation_pathAdditive observer,
    crossCompilerLinearObservation_not_h1 observer⟩
  simpa only [crossActionRuntimeDepth_closed] using
    (crossCompilerObservedP98_stateAt_exact observer depth)

end
