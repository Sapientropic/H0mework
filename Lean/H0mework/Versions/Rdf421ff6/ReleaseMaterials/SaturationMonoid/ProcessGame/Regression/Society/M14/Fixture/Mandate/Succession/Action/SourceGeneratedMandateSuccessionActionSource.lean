import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Fixture.Mandate.Exit.Continuation.Producer.SourceGeneratedPostExitTerminalContinuation
import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Fixture.Mandate.Succession.Root.SourceGeneratedMandateSuccessorTargetRoot

/-!
# Source occurrence for mandate succession

The source of succession is not the bare exit target root.  It is exactly the
first target visit generated by the ordinary-exit action's macro next, with
the translated source ledger entry and its continued actual authority.  The
terminal exit face and source-backed Payment are consumed from that same
post-exit occurrence before any successor representation is compiled.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceGeneratedMandateSuccessionActionSource

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open ConstructiveRoot.RootInquiryCompletion
open Renewal Election Power
open M9ProofCarryingRenewalInquiryRoot
open M14SourceGeneratedContributionMergeActionSource
open M14SourceGeneratedPostSettlementObserverFinitePaidSelfU8Iteration
open M14SourceMandateRenewal
open M14SourceGeneratedMandateExitTargetRoot
open M14SourceGeneratedSequentialMandateExit
open M14SourceGeneratedMandateExitTargetHistory
open M14SourceGeneratedPostExitTerminalContinuation

def mandateSuccessionActionSourceVisitAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (_initial : CycleAt oldVisit sourceIndex boundary) (_depth : Nat) :
    SourceNativeTemporalVisitAt
      mandateExitTargetRoot.toAuthoritativeRoot.toLedgerRoot :=
  mandateExitTargetTemporalVisitAt 1

@[simp] theorem mandateSuccessionActionSourceVisitAt_exact
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    mandateSuccessionActionSourceVisitAt initial depth =
      mandateExitTargetTemporalVisitAt 1 :=
  rfl

def mandateSuccessionActionExactSourceEventAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    ExactTemporalCausalRootEventAt
      mandateExitTargetRoot.toAuthoritativeRoot.toLedgerRoot
        (mandateSuccessionActionSourceVisitAt initial depth) :=
  mandateExitTargetRoot.toAuthoritativeRoot.toLedgerRoot
    |>.exactTemporalCausalEventAt
      (mandateSuccessionActionSourceVisitAt initial depth)

def mandateSuccessionActionSourceEntryAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    OpenResponsibilityAt M14SourceGeneratedMandateExitTargetRoot.N
      ((mandateExitTargetRoot.toAuthoritativeRoot.toLedgerRoot.source.source
        ).toRootSource.account.supportOf
          (mandateExitTargetRoot.emitted
            (mandateSuccessionActionSourceVisitAt initial depth).current)) :=
  (generatedMandateExitActionAt initial depth).target.targetEntry

def mandateSuccessionActionSourceAuthorityAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    SourceNativeLivingTemporalCausalEntryAuthorityAt mandateExitTargetRoot
      (mandateSuccessionActionSourceVisitAt initial depth)
      (mandateSuccessionActionSourceEntryAt initial depth) :=
  (generatedMandateExitActionAt initial depth).target.targetAuthority

theorem mandateSuccessionActionSource_is_exitMacroNext
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    (generatedMandateExitActionAt initial depth
      ).target.targetAnswerAndNext.nextCurrent =
      ⟨M14SourceGeneratedMandateExitTargetRoot.V,
        mandateExitTargetRoot.toAuthoritativeRoot,
        mandateSuccessionActionSourceVisitAt initial depth⟩ :=
  generatedMandateExitAction_macroNext_exact initial depth

theorem mandateSuccessionActionSource_consumes_postExitOccurrence
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    HEq (mandateSuccessionActionExactSourceEventAt initial depth)
      (sourceGeneratedPostExitTerminalContinuationAt initial depth
        ).rootOccurrence := by
  rw [(sourceGeneratedPostExitTerminalContinuationAt initial depth
    ).rootOccurrenceExact]
  simp [mandateSuccessionActionExactSourceEventAt]

theorem mandateSuccessionActionSource_retains_terminalExit
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    ∃ archive,
      (sourceGeneratedPostExitTerminalContinuationAt initial depth
        ).mandateFace.exactDisposition.1.target.slots[
          (mandateSlot M8ActualElectionMandateRenewalRegression.lineageCompiler
            sourceMandateExitHistory.current).val]? =
        some (.terminal archive) :=
  (sourceGeneratedPostExitTerminalContinuationAt initial depth
    ).terminalDisposition

theorem mandateSuccessionActionSource_hasPaymentAndWholeWrite
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    Nonempty PostExitSourceBackedPaymentAt ∧
      (sourceGeneratedPostExitTerminalContinuationAt initial depth
        ).wholeLedgerWriteBack =
        (mandateExitTargetRoot.toAuthoritativeRoot.toLedgerRoot
          |>.generatedAtTemporalVisit
            (mandateExitTargetTemporalVisitAt 1)).wholeLedgerWriteBack :=
  ⟨⟨(sourceGeneratedPostExitTerminalContinuationAt initial depth).payment⟩,
    (sourceGeneratedPostExitTerminalContinuationAt initial depth
      ).wholeLedgerWriteBackExact⟩

end
end M14SourceGeneratedMandateSuccessionActionSource
end Society
end ProcessGame
end SaturationMonoid

