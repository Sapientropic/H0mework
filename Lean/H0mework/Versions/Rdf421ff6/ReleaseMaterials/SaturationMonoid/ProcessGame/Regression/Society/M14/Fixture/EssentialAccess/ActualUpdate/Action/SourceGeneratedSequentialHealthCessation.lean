def healthCessationOccurrencePresentationAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    ConstructivePresentation
      (mandateSuccessorTargetRoot.toAuthoritativeRoot.toRoot.actual.OccurrenceAt
        (healthCessationActionSourceVisitAt initial depth).current)
      (healthCessationTargetRoot.toAuthoritativeRoot.toRoot.actual.OccurrenceAt
        healthCessationTargetInitialVisit.current) :=
  ConstructivePresentation.refl _

@[simp] theorem healthCessationOccurrencePresentation_commutes
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat)
    (exactSource : ExactTemporalCausalRootEventAt
      mandateSuccessorTargetRoot.toAuthoritativeRoot.toLedgerRoot
        (healthCessationActionSourceVisitAt initial depth)) :
    (healthCessationOccurrencePresentationAt initial depth).forward
        exactSource.occurrence =
      healthCessationTargetRoot.emitted
        healthCessationTargetInitialVisit.current := by
  rw [exactSource.eq_generated]
  rfl

/-- Low-universe source seal.  The sequential action starts at the literal
macro next generated by mandate succession; its entry, authority and UBI
Payment are projections of that source occurrence. -/
structure HealthCessationActionSourceReceiptAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat)
    (exactSource : ExactTemporalCausalRootEventAt
      mandateSuccessorTargetRoot.toAuthoritativeRoot.toLedgerRoot
        (healthCessationActionSourceVisitAt initial depth)) : Prop where
  exactSourceCanonical : exactSource =
    healthCessationActionExactSourceEventAt initial depth
  successionMacroNext :
    (generatedMandateSuccessionActionAt initial depth
      ).target.targetAnswerAndNext.nextCurrent =
      ⟨M14SourceGeneratedMandateSuccessorTargetRoot.V,
        mandateSuccessorTargetRoot.toAuthoritativeRoot,
        healthCessationActionSourceVisitAt initial depth⟩
  sourceEntryFromSuccession : HEq
    (healthCessationActionSourceEntryAt initial depth)
    (generatedMandateSuccessionActionAt initial depth).target.targetEntry
  sourceAuthorityFromSuccession : HEq
    (healthCessationActionSourceAuthorityAt initial depth)
    (generatedMandateSuccessionActionAt initial depth).target.targetAuthority
  sourceUBIConsumerExact :
    (installedHealthCessationSourceUBIAt initial depth).payload.consumer =
      sourceGeneratedUBIRootRestriction
  sourceUBIFactorization :
    (installedHealthCessationSourceUBIAt initial depth
      ).RootAnswerAndNextFactorizes
  sourcePaymentReceipt : Nonempty
    (SourceBackedUBIPaymentReceiptAt
      exitCapacityProgram.purchasingPowerStanding ExitFutureCode.leave)

/-- The relation-native health action, `.t2` bearer and terminal lifecycle
are one exact local update.  Nothing here mentions the high-universe service
channel or Constitution carrier. -/
structure HealthCessationActionLocalReceipt : Prop where
  powerLost :
    sourceGeneratedHealthCriticalAction.loss.power.freedomChange =
      .lost .health healthCriticalAction_sourceActionable
        healthCriticalAction_targetAbsent
  bearerT2 :
    sourceGeneratedHealthCriticalAction.criticalBearer.commonBearer =
      Lifecycle.ActorBearer.target .t2
  bearerNotT1 :
    sourceGeneratedHealthCriticalAction.criticalBearer.commonBearer ≠
      Lifecycle.ActorBearer.target .t1
  phaseHealth : essentialAccessRelationCompiler.phaseStep healthRelation =
    .health
  roleHealthProvider :
    essentialAccessRelationCompiler.roleAt healthRelation .target =
      .healthProvider
  exactRelationProvenance :
    ∃ seed : essentialAccessRelationCompiler.ExactRelationSeed,
      (∃ state ∈ Lifecycle.actualEventGame.occurrence.trace,
        state = Lifecycle.Universal.FixedAdapter.targetFace.state
            Lifecycle.actualEventGame.source ∧
        essentialAccessRelationCompiler.relationSeedAt
            Lifecycle.actualEventGame.source state seed.1 ∧
        Lifecycle.Universal.FixedAdapter.targetFace.SeedAt
            Lifecycle.actualEventGame.source state
            (essentialAccessRelationCompiler.beneficiaryActorSeed seed.1)) ∧
      seed.actor essentialAccessRelationCompiler = healthActor ∧
      essentialAccessRelationCompiler.relationOf seed = healthRelation
  exactControllerProvenance :
    ∃ state ∈ Lifecycle.actualEventGame.occurrence.trace,
      state = (essentialAccessCriticalActionController .health).actionState
          Lifecycle.actualEventGame.source ∧
      (essentialAccessCriticalActionController .health).actionAdmittedAt
        sourceGeneratedHealthCriticalAction.loss.power.action.1
  updateExact : sourceGeneratedHealthCriticalActualUpdate =
    sourceGeneratedEssentialAccessCriticalActualUpdateAt .health
  bearerCommutes :
    sourceGeneratedHealthCriticalAction.criticalBearer.commonBearer =
      (criticalRelationObligation essentialAccessCriticalBearerOf .health
        ).bearer
  admissionKind :
    (essentialAccessCriticalTerminalAt .health).admission.lifecycleEvent.kind =
      LifecycleKind.admitted
  terminal : ∃ archive,
    (essentialAccessCriticalTerminalAt .health).terminal.target.slots[
        (criticalRelationSlot essentialAccessCriticalBearerOf .health).val]? =
      some (.terminal archive)
  noReopen : ∀ archive : TerminalArchive Lifecycle.LifecycleVocabulary,
    IsEmpty ((criticalRelationTerminalProcess
      essentialAccessCriticalBearerOf).ReopenEvent archive)

/-- The target payload seal is independent of the sequential-program knot:
it names the exact target root, installed health update, UBI Payment and first
whole-ledger successor before the action target is assembled. -/
structure HealthCessationActionTargetReceiptAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat)
    (exactSource : ExactTemporalCausalRootEventAt
      mandateSuccessorTargetRoot.toAuthoritativeRoot.toLedgerRoot
        (healthCessationActionSourceVisitAt initial depth)) : Prop where
  targetRootExact : healthCessationTargetRoot =
    M9SourceHealthCessationSuffix.jointRoot
  installedConsumerExact : installedHealthCessationConsumer =
    sourceHealthCessationConsumer
  installedDispositionExact : installedHealthCessationDisposition =
    sourceHealthCessationDisposition
  installedUpdateExact : installedHealthCessationDisposition.update =
    sourceGeneratedHealthCriticalActualUpdate
  installedHealthFactorization :
    installedHealthCessation.RootAnswerAndNextFactorizes
  successorMandateFaceExact : installedSuccessorMandateLocalFace =
    sourceMandateSuccessorFace
  successorMandateRestored :
    (installedSuccessorMandateLocalFace.responsibilityConsumer.1.1
      ).freedomChange.kind = FreedomChangeKind.restored
  successorMandateLive :
    installedSuccessorMandateLocalFace.exactDisposition.1.target.slots[
        (mandateSlot lineageCompiler
          sourceMandateSuccessorHistory.current).val]? =
      some (.live (mandateObligation lineageCompiler
        sourceMandateSuccessorHistory.current))
  successorMandateFactorization :
    installedSuccessorMandate.RootAnswerAndNextFactorizes
  targetPaymentPresentation :
    (healthCessationOccurrencePresentationAt initial depth).forward
        exactSource.occurrence =
      healthCessationTargetSourceBackedPaymentAt.rootOccurrence.occurrence
  targetPaymentFactorization :
    healthCessationTargetSourceBackedPaymentAt.installed
      |>.RootAnswerAndNextFactorizes
  targetGenerated : Nonempty
    (SourceNativeTemporalVisitGeneratedEvolutionAt
      healthCessationTargetRoot.toAuthoritativeRoot.toLedgerRoot
        healthCessationTargetInitialVisit)
  firstWholeLedgerSuccessor : Nonempty
    (SourceNativeLedgerGeneratedSuccessorAt
      healthCessationTargetInitialGenerated.occurrence
      healthCessationTargetInitialGenerated.wholeLedgerWriteBack)

/-- Meaningful receipt provenance kept in `Prop`; the action kernel can lift
it to its required small receipt universe without erasing any authority. -/
structure HealthCessationActionReceiptProvenanceAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat)
    (exactSource : ExactTemporalCausalRootEventAt
      mandateSuccessorTargetRoot.toAuthoritativeRoot.toLedgerRoot
        (healthCessationActionSourceVisitAt initial depth)) : Prop where
  source : HealthCessationActionSourceReceiptAt initial depth exactSource
  localSeal : HealthCessationActionLocalReceipt
  target : HealthCessationActionTargetReceiptAt initial depth exactSource

theorem healthCessationActionReceiptProvenanceAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat)
    (exactSource : ExactTemporalCausalRootEventAt
      mandateSuccessorTargetRoot.toAuthoritativeRoot.toLedgerRoot
        (healthCessationActionSourceVisitAt initial depth)) :
    HealthCessationActionReceiptProvenanceAt initial depth exactSource :=
  { source :=
      { exactSourceCanonical := by
          exact exactSource.eq_generated
        successionMacroNext :=
          healthCessationActionSource_is_successionMacroNext initial depth
        sourceEntryFromSuccession := HEq.rfl
        sourceAuthorityFromSuccession := HEq.rfl
        sourceUBIConsumerExact :=
          installedHealthCessationSourceUBI_consumer_exact initial depth
        sourceUBIFactorization :=
          installedHealthCessationSourceUBI_factorizes initial depth
        sourcePaymentReceipt :=
          ⟨healthCessationActionSourcePaymentReceiptAt initial depth⟩ }
    localSeal :=
      { powerLost := healthCriticalAction_freedomLoss_exact
        bearerT2 := rfl
        bearerNotT1 := healthCriticalBearer_ne_t1
        phaseHealth := healthCriticalAction_phase_exact
        roleHealthProvider := healthCriticalAction_targetRole_exact
        exactRelationProvenance := healthCriticalAction_exact_provenance.1
        exactControllerProvenance := healthCriticalAction_exact_provenance.2
        updateExact := rfl
        bearerCommutes := healthCriticalActualUpdate_bearer_commutes
        admissionKind := healthCriticalTerminal_admission_kind
        terminal := healthCriticalTerminal_disposition
        noReopen := healthCriticalTerminal_no_reopen }
    target :=
      { targetRootExact := rfl
        installedConsumerExact := installedHealthCessation_consumer_exact
        installedDispositionExact :=
          installedHealthCessation_disposition_exact
        installedUpdateExact := installedHealthCessation_update_exact
        installedHealthFactorization := installedHealthCessation_factorizes
        successorMandateFaceExact := installedSuccessorMandate_face_exact
        successorMandateRestored := installedSuccessorMandate_power_restored
        successorMandateLive := installedSuccessorMandate_obligation_live
        successorMandateFactorization :=
          installedSuccessorMandate_factorizes
        targetPaymentPresentation := by
          change
            (healthCessationOccurrencePresentationAt initial depth).forward
                exactSource.occurrence =
              healthCessationTargetRoot.emitted
                healthCessationTargetInitialVisit.current
          exact healthCessationOccurrencePresentation_commutes initial depth
            exactSource
        targetPaymentFactorization :=
          healthCessationTargetSourceBackedPaymentAt.rootFactorization
        targetGenerated := ⟨healthCessationTargetInitialGenerated⟩
        firstWholeLedgerSuccessor :=
          ⟨healthCessationTargetFirstSuccessor⟩ } }

def ExactHealthCessationActionReceiptAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat)
    (_exactSource : ExactTemporalCausalRootEventAt
      mandateSuccessorTargetRoot.toAuthoritativeRoot.toLedgerRoot
        (healthCessationActionSourceVisitAt initial depth))
    (_answer : PUnit) : Type 3 :=
  ULift.{3, 0} (PLift
    (HealthCessationActionReceiptProvenanceAt initial depth _exactSource))

def exactHealthCessationActionReceiptAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat)
    (exactSource : ExactTemporalCausalRootEventAt
      mandateSuccessorTargetRoot.toAuthoritativeRoot.toLedgerRoot
        (healthCessationActionSourceVisitAt initial depth))
    (answer : PUnit) :
    ExactHealthCessationActionReceiptAt initial depth exactSource answer :=
  ULift.up (PLift.up
    (healthCessationActionReceiptProvenanceAt initial depth exactSource))

theorem ExactHealthCessationActionReceiptAt.provenance
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    {initial : CycleAt oldVisit sourceIndex boundary} {depth : Nat}
    {exactSource : ExactTemporalCausalRootEventAt
      mandateSuccessorTargetRoot.toAuthoritativeRoot.toLedgerRoot
        (healthCessationActionSourceVisitAt initial depth)}
    {answer : PUnit}
    (receipt : ExactHealthCessationActionReceiptAt initial depth exactSource
      answer) :
    HealthCessationActionReceiptProvenanceAt initial depth exactSource :=
  receipt.down.down

def healthCessationActionTargetAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat)
    (exactSource : ExactTemporalCausalRootEventAt
      mandateSuccessorTargetRoot.toAuthoritativeRoot.toLedgerRoot
        (healthCessationActionSourceVisitAt initial depth)) :
    SourceNativeSequentialActualActionTargetAt mandateSuccessorTargetRoot
      (healthCessationActionSourceVisitAt initial depth) exactSource
      (healthCessationActionSourceEntryAt initial depth)
      (healthCessationActionSourceAuthorityAt initial depth) := by
  rw [exactSource.eq_generated]
  exact
    { TargetN := M14SourceGeneratedHealthCessationTargetRoot.N
      translation := mandateExitIdentityTranslation
      TargetV := M14SourceGeneratedHealthCessationTargetRoot.V
      targetRoot := healthCessationTargetRoot
      targetTheory := RootInquiryU8CompletionRegression.oldTheory
      lawSurface_heq := HEq.rfl
      targetTheory_rootSemantic :=
        { compile := fun expression => nomatch expression
          commuting := fun expression => nomatch expression }
      occurrencePresentation :=
        healthCessationOccurrencePresentationAt initial depth
      occurrence_commutes :=
        healthCessationOccurrencePresentation_commutes initial depth
          (healthCessationActionExactSourceEventAt initial depth)
      initialSupport_heq := HEq.rfl
      initialOpenLedger := mandateExitIdentityTranslation.oldOpenLedger true
      initialOpenLedger_heq := HEq.rfl
      initialLedger_responsibility_commutes := fun _ => rfl
      initialLedger_claim_commutes := fun _ => rfl
      initialLedger_budget_conservative := fun _ => Nat.le_refl _
      initialLedgerNoFresh := fun targetEntry =>
        ⟨⟨targetEntry, PLift.up rfl⟩⟩
      translatedSourceEntryRow := healthCessationTargetEntryRow
      firstSuccessor := healthCessationTargetFirstSuccessor
      canonical_targetNextVisit_eq := rfl
      Answer := PUnit
      answer := PUnit.unit
      Receipt := fun answer =>
        ExactHealthCessationActionReceiptAt initial depth
          (healthCessationActionExactSourceEventAt initial depth) answer
      receipt := exactHealthCessationActionReceiptAt initial depth
        (healthCessationActionExactSourceEventAt initial depth) PUnit.unit }

def healthCessationActionProgramAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    SourceNativeSequentialActualActionProgramAt mandateSuccessorTargetRoot
      (healthCessationActionSourceVisitAt initial depth)
      (healthCessationActionSourceEntryAt initial depth)
      (healthCessationActionSourceAuthorityAt initial depth) where
  targetAt := healthCessationActionTargetAt initial depth

def generatedHealthCessationActionAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    SourceGeneratedSequentialActualActionAt
      (healthCessationActionProgramAt initial depth)
      (healthCessationActionExactSourceEventAt initial depth) :=
  (healthCessationActionProgramAt initial depth).generate
    (healthCessationActionExactSourceEventAt initial depth)

def healthCessationInquiryEventAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :=
  ULift.up.{1, 0}
    (mandateSuccessorTargetRoot.emitted
      (healthCessationActionSourceVisitAt initial depth).current)

def healthCessationActualActionCompilationAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat)
    (exactSource : ExactTemporalCausalRootEventAt
      mandateSuccessorTargetRoot.toAuthoritativeRoot.toLedgerRoot
        (healthCessationActionSourceVisitAt initial depth)) :
    SourceNativeInquiryCompilationAt mandateSuccessorTargetRoot
      (healthCessationActionSourceVisitAt initial depth)
      M9ProofCarryingRenewalU8Failure.U7
      RootInquiryU8CompletionRegression.theoryAuditCalculus
      RootInquiryU8CompletionRegression.oldTheory ()
      (healthCessationInquiryEventAt initial depth)
      (healthCessationActionSourceEntryAt initial depth)
      (healthCessationActionSourceAuthorityAt initial depth) :=
  .actualAction ((healthCessationActionProgramAt initial depth).generate
    exactSource)

@[simp] theorem generatedHealthCessationAction_targetRoot_exact
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    (generatedHealthCessationActionAt initial depth).target.targetRoot =
      healthCessationTargetRoot :=
  rfl

theorem generatedHealthCessationAction_targetPayment_commutes
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    (generatedHealthCessationActionAt initial depth
      ).target.occurrencePresentation.forward
        (healthCessationActionExactSourceEventAt initial depth).occurrence =
      healthCessationTargetSourceBackedPaymentAt.rootOccurrence.occurrence :=
  rfl

theorem generatedHealthCessationAction_macroNext_exact
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    (generatedHealthCessationActionAt initial depth
      ).target.targetAnswerAndNext.nextCurrent =
      ⟨(generatedHealthCessationActionAt initial depth).target.TargetV,
        (generatedHealthCessationActionAt initial depth
          ).target.targetRoot.toAuthoritativeRoot,
        (generatedHealthCessationActionAt initial depth).target.targetVisit⟩ :=
  (generatedHealthCessationActionAt initial depth).target
    |>.targetAnswerAndNext_next_eq

abbrev AnyHealthCessationActionOccurrenceAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) :=
  Sigma fun depth : Nat =>
    SourceGeneratedSequentialActualActionAt
      (healthCessationActionProgramAt initial depth)
      (healthCessationActionExactSourceEventAt initial depth)

def healthCessationActionOccurrenceAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    AnyHealthCessationActionOccurrenceAt initial :=
  ⟨depth, generatedHealthCessationActionAt initial depth⟩

theorem healthCessationActionOccurrenceAt_injective
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) :
    Function.Injective (healthCessationActionOccurrenceAt initial) := by
  intro left right equality
  exact congrArg Sigma.fst equality

theorem no_single_healthCessationAction_occurrence_carries_all_depths
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) :
    ¬ ∃ occurrence : AnyHealthCessationActionOccurrenceAt initial,
      ∀ depth : Nat,
        healthCessationActionOccurrenceAt initial depth = occurrence := by
  rintro ⟨occurrence, allDepths⟩
  have equality := (allDepths 0).trans (allDepths 1).symm
  have depthEquality := healthCessationActionOccurrenceAt_injective
    initial equality
  omega

end
