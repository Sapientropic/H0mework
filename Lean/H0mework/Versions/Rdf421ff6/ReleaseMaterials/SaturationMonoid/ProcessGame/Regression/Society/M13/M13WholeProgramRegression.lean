import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M13.Consumer.ReflexiveTheoryConsumerRegression

/-!
# M13 whole-program sink

The sink retains causal adoption, exact effect consumption, observer-kernel
non-reconstruction, arbitrary-law audit machinery, the actual mother-law
breaking occurrence, self-U8 runtime consumption, revised-first-occurrence
claim migration, and later actual retirement.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M13WholeProgramRegression

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Observer Settlement Theory Revision
open ConstructiveRoot.RootInquiryCompletion

noncomputable section

structure M13WholeProgramCertificate : Type 16 where
  reflexiveTheory :
    M13ReflexiveTheoryConsumerRegression.ReflexiveTheoryConsumerCertificate
  exactClassification :
    M13ProofCarryingTheoryAdoptionRegression.adoption.classificationReadout.read
      M13ProofCarryingTheoryAdoptionRegression.adoption.exactSourceSeed = true
  exactPolicy :
    M13ProofCarryingTheoryAdoptionRegression.adoption.policyReadout.read
      M13ProofCarryingTheoryAdoptionRegression.adoption.exactSourceSeed = true
  actualEffectConsumed : Nonempty
    (M9ProofCarryingRenewalInquiryRoot.theoryFeedbackCompiler.EffectConsumerAt
      M13ProofCarryingTheoryAdoptionRegression.adoption.exactSourceSeed
      M13ProofCarryingTheoryAdoptionRegression.adoption.actualEffect)
  fixedLawNextPreservesTheory :
    M13ProofCarryingTheoryAdoptionRegression.adoption.generatedNext.root.source.lawSurface =
      M13ProofCarryingTheoryAdoptionRegression.adoption.theoryState
  observerCannotRecoverAuthority :
    ¬ Nonempty (AuthorityFactorization
      (M6GoNaturalAuthorityReconstructionRegression.goAuthorityObserver 1))
  selectedMotherLaw : M13MotherLawBreakingRegression.audit.auditedLaw = ()
  exactDeletionNearMiss :
    M13MotherLawBreakingRegression.audit.deletionAudit =
      LawDeletionAuditAt.nearMiss ()
  installedFailureIsSelfU8 :
    M13MotherLawBreakingRegression.u8Gate.rooted =
      M13SelfU8Regression.selfU8.rooted
  canonicalCofaceIsSelfU8 :
    M13MotherLawBreakingRegression.u8Gate.minimalCoface =
      M13SelfU8Regression.selfU8.minimalCoface
  runtimeConsumesCore :
    SourceNativeInquiryRuntime.CofaceRealizationResumptionAt
      M9ProofCarryingRenewalU8Revision.jointCore
      M9ProofCarryingRenewalInquiryRuntime.jointRuntime 0
  uniqueSelfU8 : ∀ candidate : SourceGeneratedReflexiveSelfU8At
      M9ProofCarryingLegislationRegression.proofCarryingLegislation
      M13SelfU8Regression.exactRevolution
      M13SelfU8Regression.exactConsumption,
    candidate = M13SelfU8Regression.selfU8
  migrationFaceInstalled :
    M9ProofCarryingRenewalU8RevisedWorld.revisedLivingRoot.toAuthoritativeRoot.source.projectionLaw.project
      .claimMigration
      (M9ProofCarryingRenewalU8RevisedWorld.revisedLivingRoot.emitted (0 : Nat))
      ⟨rfl⟩ = M13ClaimMigrationRetirementRegression.migrationFace
  retirementFaceInstalled :
    M9ProofCarryingRenewalU8RevisedWorld.revisedLivingRoot.toAuthoritativeRoot.source.projectionLaw.project
      .claimRetirement
      (M9ProofCarryingRenewalU8RevisedWorld.revisedLivingRoot.emitted (1 : Nat))
      ⟨rfl⟩ = M13ClaimMigrationRetirementRegression.retirementFace
  firstAndLaterCurrentDistinct :
    M13ClaimMigrationRetirementRegression.firstVisit.current ≠
      M13ClaimMigrationRetirementRegression.laterVisit.current
  firstWriteTargetsLaterVisit :
    M13ClaimMigrationRetirementRegression.runtimeFirstWrite.targetVisit =
      M9ProofCarryingRenewalU8RevisedWorld.revisedVisitAt 1
  laterNextIsRevisedRows :
    M13ClaimMigrationRetirementRegression.laterGeneratedNext =
      M13SelfU8Regression.selfU8.oldRowAnswerAndNext.nextCurrent
  replacementRetainsLiveClaim : Nonempty
    (ExactSettlementEdge.LiveResidualAt
      M13ClaimMigrationRetirementRegression.migration.firstWriteSettlement)
  replacementIsNotRetirement : ¬ Nonempty
    (ExactSettlementEdge.ClosedSettlementAt
      M13ClaimMigrationRetirementRegression.migration.firstWriteSettlement)
  laterFulfilled :
    (M13ClaimMigrationRetirementRegression.migration.laterSettlement
      M13ClaimMigrationRetirementRegression.laterConsumer).classification =
        ExactSettlementEdge.Class.fulfilled
  laterActualRetirement : ResponsibilityState.DisappearsAt
    M13ClaimMigrationRetirementRegression.migration.firstWriteSettlement.edge.target
    (M13ClaimMigrationRetirementRegression.migration.laterSettlement
      M13ClaimMigrationRetirementRegression.laterConsumer).edge.target
    (M13ClaimMigrationRetirementRegression.migration.laterSettlement
      M13ClaimMigrationRetirementRegression.laterConsumer).slot.val
  oldAndRevisedNextDoNotMix :
    (⟨M9ProofCarryingRenewalInquiryRoot.N,
      M13ProofCarryingTheoryAdoptionRegression.adoption.generatedNext⟩ :
      AnyAuthoritativeRootCurrent) ≠ M13SelfU8Regression.selfU8.revisedNext
  bareTheoryEffectNoAuthority : True
  bareDeletionAuditNoU8 : True
  bareFailureNoSelfU8 : True
  sparseOmissionNoRetirement : ¬ Nonempty
    (ExactSettlementEdge.ClosedSettlementAt
      M13ClaimMigrationRetirementRegression.migration.firstWriteSettlement)

def m13WholeProgramConsumer : M13WholeProgramCertificate where
  reflexiveTheory :=
    M13ReflexiveTheoryConsumerRegression.reflexiveTheoryDirectConsumer
  exactClassification :=
    M13ProofCarryingTheoryAdoptionRegression.exact_classification_is_focal
  exactPolicy :=
    M13ProofCarryingTheoryAdoptionRegression.exact_policy_is_maintain
  actualEffectConsumed :=
    M13ProofCarryingTheoryAdoptionRegression.effect_has_dependent_consumer
  fixedLawNextPreservesTheory :=
    M13ProofCarryingTheoryAdoptionRegression.fixedLaw_next_preserves_adoptedTheory
  observerCannotRecoverAuthority :=
    M13ProofCarryingTheoryAdoptionRegression.visible_observer_cannot_recover_hidden_authority
  selectedMotherLaw :=
    M13MotherLawBreakingRegression.selected_law_is_exact_old_law
  exactDeletionNearMiss :=
    M13MotherLawBreakingRegression.deletion_audit_is_nearMiss
  installedFailureIsSelfU8 :=
    M13ReflexiveTheoryConsumerRegression.motherLaw_gate_is_selfU8_rooted
  canonicalCofaceIsSelfU8 :=
    M13ReflexiveTheoryConsumerRegression.motherLaw_coface_is_selfU8_coface
  runtimeConsumesCore :=
    M13SelfU8Regression.runtime_consumes_exact_joint_core
  uniqueSelfU8 := M13SelfU8Regression.selfU8_unique
  migrationFaceInstalled :=
    M13ClaimMigrationRetirementRegression.migrationFace_is_revisedRoot_projection
  retirementFaceInstalled :=
    M13ClaimMigrationRetirementRegression.retirementFace_is_revisedRoot_projection
  firstAndLaterCurrentDistinct :=
    M13ClaimMigrationRetirementRegression.first_and_later_current_distinct
  firstWriteTargetsLaterVisit :=
    M13ClaimMigrationRetirementRegression.runtimeFirstWrite_targetVisit_eq_laterRootVisit
  laterNextIsRevisedRows :=
    M13ClaimMigrationRetirementRegression.laterGeneratedNext_eq_selfU8_revisedRows
  replacementRetainsLiveClaim :=
    M13ClaimMigrationRetirementRegression.replaced_claim_is_still_live_and_not_closed.1
  replacementIsNotRetirement :=
    M13ClaimMigrationRetirementRegression.replaced_claim_is_still_live_and_not_closed.2
  laterFulfilled :=
    M13ClaimMigrationRetirementRegression.later_classification_is_fulfilled
  laterActualRetirement :=
    M13ClaimMigrationRetirementRegression.later_event_closes_migrated_claim
  oldAndRevisedNextDoNotMix :=
    M13ReflexiveTheoryConsumerRegression.oldRoot_next_ne_revisedNext
  bareTheoryEffectNoAuthority :=
    M13ProofCarryingTheoryAdoptionRegression.bare_effect_cannot_replace_installed_adoption
  bareDeletionAuditNoU8 :=
    M13MotherLawBreakingRegression.nearMiss_alone_cannot_open_U8
  bareFailureNoSelfU8 :=
    M13SelfU8Regression.bare_failure_cannot_generate_selfU8
  sparseOmissionNoRetirement :=
    M13ClaimMigrationRetirementRegression.sparse_omission_is_not_retirement

end
end M13WholeProgramRegression
end Society
end ProcessGame
end SaturationMonoid

#print axioms SaturationMonoid.ProcessGame.Society.M13WholeProgramRegression.m13WholeProgramConsumer
