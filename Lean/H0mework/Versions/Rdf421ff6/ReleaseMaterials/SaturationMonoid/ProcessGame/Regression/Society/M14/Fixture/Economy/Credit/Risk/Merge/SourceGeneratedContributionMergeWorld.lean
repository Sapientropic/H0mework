import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Fixture.Economy.Credit.Risk.SourceGeneratedLossAllocationWorld

/-!
# M14 source-generated contribution-merge world

For any exact loss-allocation rooted failure, the already generated split
world is admitted conservatively at phase `false`.  Every old support and
every live row enters injectively, and the distinguished initial support is
exactly the existing split target.

At the actual phase-`true` merge target there are exactly two live rows: one
merged continuation of the existing contribution responsibility/claim and
the existing obstruction continuity row.  Other phase-`true` supports retain
their old open ledger conservatively; they are representation fibres and are
never selected by the emitter.  This file introduces no participant, share,
pool, bearer, root, runtime, occurrence, ledger registry, or action receipt.
A later source-native compiler must still generate the actual merge and its
bearer.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceGeneratedContributionMergeWorld

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open ObstructionGeneratedMinimalCoface TypedSemanticWorldNetworkU8
open M14SourceGeneratedLossAllocationWorld

variable
    {OldV : ConstructiveRoot.Vocabulary}
    {oldWorld : SourceNativeAuthoritativeRootClosure
      M14SourceGeneratedLossAllocationWorld.OldN OldV}
    {oldVisit : SourceNativeTemporalVisitAt oldWorld.toLedgerRoot}
    {U7 : U7ProducerCalculus M14SourceGeneratedLossAllocationWorld.OldN}
    {oldTheory : TheoryState M14SourceGeneratedLossAllocationWorld.OldN}
    {support : M14SourceGeneratedLossAllocationWorld.OldN.Support}
    {obstruction :
      M14SourceGeneratedLossAllocationWorld.OldN.ObstructionAt support}
    {failure : ActualExpressibilityFailure oldTheory obstruction}

local notation "RootedFailure" => RootedActualExpressibilityFailureAt
  oldWorld oldVisit U7 failure

/-- The actual split world is the complete old network for this conservative
cross-root ingress. -/
abbrev OldN (rooted : RootedFailure) := LossN rooted

/-- Existing support with one generated merge phase.  The Boolean is only a
local source/target face, not a scheduler or completed future. -/
abbrev TargetSupport (rooted : RootedFailure) :=
  (OldN rooted).Support × Bool

abbrev TargetResponsibility (rooted : RootedFailure) :=
  (OldN rooted).Responsibility

abbrev TargetClaim (rooted : RootedFailure) :=
  (OldN rooted).Claim

/-- Exact split support already generated by C7. -/
def contributionMergeSourceSupport (rooted : RootedFailure) :
    (OldN rooted).Support :=
  lossAllocationTargetSupport rooted

/-- The merged contribution retains the existing A/B responsibility.  A and
B already have the same responsibility and claim; no new pool identity is
postulated here. -/
def contributionResponsibility (rooted : RootedFailure) :
    (OldN rooted).Responsibility :=
  (lossAllocationTargetChildA rooted).1

def contributionClaim (rooted : RootedFailure) :
    (OldN rooted).Claim :=
  (lossAllocationTargetChildA rooted).claim

def contributionObstructionResponsibility (rooted : RootedFailure) :
    (OldN rooted).Responsibility :=
  (lossAllocationTargetObstruction rooted).1

def contributionObstructionClaim (rooted : RootedFailure) :
    (OldN rooted).Claim :=
  (lossAllocationTargetObstruction rooted).claim

/-- At phase `false` every old row is retained definitionally.  At phase
`true`, non-target supports retain the same old fibre.  The unique concrete
target pattern `((.inr _, true), true)` is equality-restricted to the existing
contribution and obstruction responsibilities. -/
def contributionMergeOpenAt (rooted : RootedFailure) :
    TargetSupport rooted -> TargetResponsibility rooted -> Type
  | (oldSupport, false), responsibility =>
      (OldN rooted).OpenAt oldSupport responsibility
  | ((.inl oldSupport, lossPhase), true), responsibility =>
      (OldN rooted).OpenAt (.inl oldSupport, lossPhase) responsibility
  | ((.inr direction, false), true), responsibility =>
      (OldN rooted).OpenAt (.inr direction, false) responsibility
  | (oldSupport@(.inr _, true), true), responsibility =>
      PLift (oldSupport = contributionMergeSourceSupport rooted ∧
          responsibility = contributionResponsibility rooted) ⊕
        PLift (oldSupport = contributionMergeSourceSupport rooted ∧
          responsibility = contributionObstructionResponsibility rooted)

def contributionMergeOpenClaimAt (rooted : RootedFailure) :
    {indexedSupport : TargetSupport rooted} ->
    {responsibility : TargetResponsibility rooted} ->
    contributionMergeOpenAt rooted indexedSupport responsibility ->
      TargetClaim rooted
  | (_oldSupport, false), _responsibility, isOpen =>
      (OldN rooted).openClaimAt isOpen
  | ((.inl _oldSupport, _lossPhase), true), _responsibility, isOpen =>
      (OldN rooted).openClaimAt isOpen
  | ((.inr _direction, false), true), _responsibility, isOpen =>
      (OldN rooted).openClaimAt isOpen
  | ((.inr _direction, true), true), _responsibility, .inl _ =>
      contributionClaim rooted
  | ((.inr _direction, true), true), _responsibility, .inr _ =>
      contributionObstructionClaim rooted

def contributionMergeOpenProgressBudgetAt (rooted : RootedFailure) :
    {indexedSupport : TargetSupport rooted} ->
    {responsibility : TargetResponsibility rooted} ->
    contributionMergeOpenAt rooted indexedSupport responsibility -> Nat
  | (_oldSupport, false), _responsibility, isOpen =>
      (OldN rooted).openProgressBudgetAt isOpen
  | ((.inl _oldSupport, _lossPhase), true), _responsibility, isOpen =>
      (OldN rooted).openProgressBudgetAt isOpen
  | ((.inr _direction, false), true), _responsibility, isOpen =>
      (OldN rooted).openProgressBudgetAt isOpen
  | ((.inr _direction, true), true), _responsibility, .inl _ => 1
  | ((.inr _direction, true), true), _responsibility, .inr _ => 0

/-- Conservative richer world.  Every semantic field is an existing `OldN`
field restricted along the first support coordinate. -/
def contributionMergeWorld (rooted : RootedFailure) : WorldRelationNetwork where
  Support := TargetSupport rooted
  Anchor := (OldN rooted).Anchor
  Incidence := (OldN rooted).Incidence
  Lineage := (OldN rooted).Lineage
  Responsibility := TargetResponsibility rooted
  Claim := TargetClaim rooted
  anchorAt := fun indexedSupport => (OldN rooted).anchorAt indexedSupport.1
  incidenceAt := fun indexedSupport =>
    (OldN rooted).incidenceAt indexedSupport.1
  lineageAt := fun indexedSupport =>
    (OldN rooted).lineageAt indexedSupport.1
  OpenAt := contributionMergeOpenAt rooted
  openClaimAt := contributionMergeOpenClaimAt rooted
  openProgressBudgetAt := contributionMergeOpenProgressBudgetAt rooted
  HoldsAt := fun indexedSupport claim =>
    (OldN rooted).HoldsAt indexedSupport.1 claim
  ObstructionAt := fun indexedSupport =>
    (OldN rooted).ObstructionAt indexedSupport.1
  obstructionClaim := fun indexedObstruction =>
    (OldN rooted).obstructionClaim indexedObstruction
  SemanticChangeAt := fun indexedSupport sourceClaim targetClaim =>
    (OldN rooted).SemanticChangeAt indexedSupport.1 sourceClaim targetClaim
  DispositionAt := fun indexedSupport kind =>
    (OldN rooted).DispositionAt indexedSupport.1 kind

abbrev TargetN (rooted : RootedFailure) := contributionMergeWorld rooted

/-- Concrete inhabitant of every already existing loss-world support.  The
definition follows the actual nested `Sum × Bool` representation and makes
no equality decision or global choice. -/
private def contributionMergeOldDefaultEntryAt
    (rooted : RootedFailure) :
    (oldSupport : (OldN rooted).Support) →
      OpenResponsibilityAt (OldN rooted) oldSupport
  | (.inl oldSupport, false) => ⟨.inl (), ()⟩
  | (.inl oldSupport, true) => ⟨.inl (), ()⟩
  | (.inr direction, false) => ⟨.inr direction, .same direction⟩
  | (.inr direction, true) => by
      cases direction
      exact lossAllocationTargetChildA rooted

/-! ## Conservative translation -/

def contributionMergeTranslation (rooted : RootedFailure) :
    TypedSemanticWorldNetworkTranslationAt (OldN rooted) (TargetN rooted) where
  support :=
    { forward := fun oldSupport => (oldSupport, false)
      backward := Prod.fst
      backward_forward := fun _ => rfl }
  anchor :=
    { forward := id
      backward := id
      backward_forward := fun _ => rfl }
  incidence :=
    { forward := id
      backward := id
      backward_forward := fun _ => rfl }
  lineage :=
    { forward := id
      backward := id
      backward_forward := fun _ => rfl }
  responsibility :=
    { forward := id
      backward := id
      backward_forward := fun _ => rfl }
  claim :=
    { forward := id
      backward := id
      backward_forward := fun _ => rfl }
  anchor_commutes := fun _ => rfl
  incidence_commutes := fun _ => rfl
  lineage_commutes := fun _ => rfl
  oldOpenLedger := fun _oldSupport =>
    { forward := fun oldEntry => ⟨oldEntry.1, oldEntry.2⟩
      backward := fun targetEntry => ⟨targetEntry.1, targetEntry.2⟩
      backward_forward := fun _ => rfl }
  oldOpenClaim_commutes := fun _ _ => rfl
  oldOpenProgressBudget_commutes := fun _ _ => rfl
  oldHoldsSurvives := fun _ _ proof => proof
  oldDispositionSurvives := fun _ _ proof => proof

/-! ## Exact source and target ledgers -/

def contributionMergeInitialSupport (rooted : RootedFailure) :
    (TargetN rooted).Support :=
  (contributionMergeTranslation rooted).support.forward
    (lossAllocationTargetLedger rooted).support

def contributionMergeTargetSupport (rooted : RootedFailure) :
    (TargetN rooted).Support :=
  (contributionMergeSourceSupport rooted, true)

def contributionMergeInitialLedger (rooted : RootedFailure) :
    CompleteLiveLedgerAt (TargetN rooted) :=
  ⟨contributionMergeInitialSupport rooted⟩

def contributionMergeTargetLedger (rooted : RootedFailure) :
    CompleteLiveLedgerAt (TargetN rooted) :=
  ⟨contributionMergeTargetSupport rooted⟩

/-- Definitionally translated old split row. -/
def contributionMergeInitialEntry
    (rooted : RootedFailure)
    (entry : (lossAllocationTargetLedger rooted).Entry) :
    (contributionMergeInitialLedger rooted).Entry :=
  ⟨entry.1, entry.2⟩

def mergedContributionEntry (rooted : RootedFailure) :
    (contributionMergeTargetLedger rooted).Entry :=
  ⟨contributionResponsibility rooted,
    .inl (PLift.up ⟨rfl, rfl⟩)⟩

def mergedObstructionEntry (rooted : RootedFailure) :
    (contributionMergeTargetLedger rooted).Entry :=
  ⟨contributionObstructionResponsibility rooted,
    .inr (PLift.up ⟨rfl, rfl⟩)⟩

/-- Total representation inhabitant required by a lawful target-world U7
calculus.  Non-target supports reuse an existing loss-world row.  The unique
actual merge target selects the already defined merged contribution row.
The source emitter remains restricted to the initial and actual target
supports and never reads the conservative off-target branches. -/
def contributionMergeDefaultEntryAt
    (rooted : RootedFailure) :
    (indexedSupport : (TargetN rooted).Support) →
      OpenResponsibilityAt (TargetN rooted) indexedSupport
  | (oldSupport, false) =>
      contributionMergeOldDefaultEntryAt rooted oldSupport
  | ((.inl oldSupport, lossPhase), true) =>
      contributionMergeOldDefaultEntryAt rooted (.inl oldSupport, lossPhase)
  | ((.inr direction, false), true) =>
      contributionMergeOldDefaultEntryAt rooted (.inr direction, false)
  | ((.inr direction, true), true) => by
      cases direction
      exact mergedContributionEntry rooted

@[simp] theorem contributionMergeDefaultEntryAt_target_exact
    (rooted : RootedFailure) :
    contributionMergeDefaultEntryAt rooted
        (contributionMergeTargetSupport rooted) =
      mergedContributionEntry rooted :=
  rfl

@[simp] theorem contributionMerge_initialSupport_exact
    (rooted : RootedFailure) :
    contributionMergeInitialSupport rooted =
      (contributionMergeTranslation rooted).support.forward
        (lossAllocationTargetLedger rooted).support :=
  rfl

/-- Every initial target entry comes from exactly the old split ledger; no
merged contribution is preinstalled at ingress. -/
theorem contributionMerge_initialLedger_noFresh
    (rooted : RootedFailure)
    (targetEntry : (contributionMergeInitialLedger rooted).Entry) :
    Nonempty (Sigma fun oldEntry : (lossAllocationTargetLedger rooted).Entry =>
      PLift (contributionMergeInitialEntry rooted oldEntry = targetEntry)) := by
  rcases targetEntry with ⟨responsibility, isOpen⟩
  exact ⟨⟨⟨responsibility, isOpen⟩, PLift.up rfl⟩⟩

@[simp] theorem contributionMerge_initial_childA_exact
    (rooted : RootedFailure) :
    contributionMergeInitialEntry rooted
        (lossAllocationTargetChildA rooted) =
      ((contributionMergeTranslation rooted).oldOpenLedger
        (lossAllocationTargetLedger rooted).support).forward
        (lossAllocationTargetChildA rooted) :=
  rfl

@[simp] theorem contributionMerge_initial_childB_exact
    (rooted : RootedFailure) :
    contributionMergeInitialEntry rooted
        (lossAllocationTargetChildB rooted) =
      ((contributionMergeTranslation rooted).oldOpenLedger
        (lossAllocationTargetLedger rooted).support).forward
        (lossAllocationTargetChildB rooted) :=
  rfl

@[simp] theorem contributionMerge_initial_obstruction_exact
    (rooted : RootedFailure) :
    contributionMergeInitialEntry rooted
        (lossAllocationTargetObstruction rooted) =
      ((contributionMergeTranslation rooted).oldOpenLedger
        (lossAllocationTargetLedger rooted).support).forward
        (lossAllocationTargetObstruction rooted) :=
  rfl

/-! ## Exact two-row target -/

theorem contributionMergeTargetEntry_cases
    (rooted : RootedFailure)
    (entry : (contributionMergeTargetLedger rooted).Entry) :
    entry = mergedContributionEntry rooted ∨
      entry = mergedObstructionEntry rooted := by
  rcases entry with ⟨responsibility, isOpen⟩
  rcases isOpen with contribution | obstruction
  · rcases contribution.down with ⟨support_eq, responsibility_eq⟩
    cases support_eq
    cases responsibility_eq
    exact .inl (by congr)
  · rcases obstruction.down with ⟨support_eq, responsibility_eq⟩
    cases support_eq
    cases responsibility_eq
    exact .inr (by congr)

theorem mergedEntries_distinct (rooted : RootedFailure) :
    mergedContributionEntry rooted ≠ mergedObstructionEntry rooted := by
  intro equality
  have responsibility_eq := congrArg Sigma.fst equality
  change (lossAllocationTargetChildA rooted).1 =
    (lossAllocationTargetObstruction rooted).1 at responsibility_eq
  exact nomatch responsibility_eq

@[simp] theorem mergedContribution_budget (rooted : RootedFailure) :
    (mergedContributionEntry rooted).progressBudget = 1 :=
  rfl

@[simp] theorem mergedObstruction_budget (rooted : RootedFailure) :
    (mergedObstructionEntry rooted).progressBudget = 0 :=
  rfl

theorem mergedContribution_preserves_existing_content
    (rooted : RootedFailure) :
    (mergedContributionEntry rooted).1 =
        (lossAllocationTargetChildA rooted).1 ∧
      (mergedContributionEntry rooted).claim =
        (lossAllocationTargetChildA rooted).claim ∧
      (mergedContributionEntry rooted).claim =
        (lossAllocationTargetChildB rooted).claim ∧
      (TargetN rooted).lineageAt (contributionMergeTargetSupport rooted) =
        (OldN rooted).lineageAt (lossAllocationTargetLedger rooted).support :=
  ⟨rfl, rfl, rfl, rfl⟩

theorem mergedObstruction_is_existing_continuity
    (rooted : RootedFailure) :
    (mergedObstructionEntry rooted).1 =
        (lossAllocationTargetObstruction rooted).1 ∧
      (mergedObstructionEntry rooted).claim =
        (lossAllocationTargetObstruction rooted).claim ∧
      (mergedObstructionEntry rooted).progressBudget =
        (lossAllocationTargetObstruction rooted).progressBudget :=
  ⟨rfl, rfl, rfl⟩

end
end M14SourceGeneratedContributionMergeWorld
end Society
end ProcessGame
end SaturationMonoid

