/-! ## Existing t1 worker and independent exit relation -/

def birthBearerExitRelationSeedAt
    (_source : Unit) (state : Lifecycle.EventState)
    (_seed : ExitRelationSeed) : Prop :=
  state = .after

/--
The existing M14 relation grammar, now beneficiary-indexed by `.t1`, the
actor whose exchange bearer is the loss-allocation parent bearer.
-/
def birthBearerExitRelationCompiler : SourceOwnedRelationRoleCompiler
    Lifecycle.actualEventOccurrenceOf Lifecycle.actualEventGame targetFace where
  RelationSeed := ExitRelationSeed
  RelationLineage := fun _ => ExitRelationSeed
  relationSeedAt := birthBearerExitRelationSeedAt
  relationLineageOf := fun _ seed => seed.1
  beneficiaryActorSeed := fun _ => .t1
  beneficiaryActor_active := by
    intro _source _state _seed admitted
    exact admitted
  Role := fun _ => ExitRole
  Phase := fun _ => Int
  sourceRoleOf := fun _ lineage =>
    match lineage with
    | .employment => .employed
    | .independentExit => .independent
    | .newJob => .employed
  phaseStepOf := fun _ lineage =>
    match lineage with
    | .employment => 1
    | .independentExit => 0
    | .newJob => 0
  advanceRole := fun _ phase role =>
    if phase = 0 then role else .released
  FutureCode := ExitFutureCode
  futureCodeDecidableEq := inferInstance
  futureCodeCarrier := {.idle, .work, .leave}
  futureIdle := fun code => code = .idle
  FutureContinuationAt := fun lineage side code =>
    match lineage, side, code with
    | .employment, .source, .work => PUnit
    | .independentExit, .target, .leave => PUnit
    | .newJob, .target, .work => PUnit
    | _, _, _ => PEmpty
  futureBoundaryState := fun _ side =>
    match side with
    | .source => .before
    | .target => .after
  futureBoundaryState_mem := by
    intro _lineage side
    cases side <;>
      change _ ∈ [Lifecycle.EventState.before, Lifecycle.EventState.after] <;>
      simp
  FutureContinuationWitnessAt := fun _ _ _ _ => True
  futureContinuation_witnessed := by
    intro _ _ _ _
    trivial

def birthBearerExactRelationSeed (seed : ExitRelationSeed) :
    birthBearerExitRelationCompiler.ExactRelationSeed :=
  ⟨seed, .after, by
    change Lifecycle.EventState.after ∈
      [Lifecycle.EventState.before, Lifecycle.EventState.after]
    simp, rfl⟩

/-- Existing `.t1` actor, generated by the exact employment relation seed. -/
def birthBearerWorker : birthBearerExitRelationCompiler.Actor :=
  (birthBearerExactRelationSeed .employment).actor
    birthBearerExitRelationCompiler

@[simp] theorem birthBearerWorker_seed_exact :
    birthBearerWorker.1 = Lifecycle.TargetToken.t1 :=
  rfl

/-- The exact bearer seam which the former t0-indexed geometry lacked. -/
theorem birthBearerWorker_bearer_exact :
    exchangeLaw.bearerOfActor birthBearerWorker =
      sourceGeneratedLossAllocationMaterial.parentBearer := by
  change Lifecycle.ActorBearer.target Lifecycle.TargetToken.t1 =
    Lifecycle.ActorBearer.target Lifecycle.TargetToken.t1
  rfl

def birthBearerEmploymentRelation :
    birthBearerExitRelationCompiler.GeneratedRelation :=
  birthBearerExitRelationCompiler.relationOf
    (birthBearerExactRelationSeed .employment)

def birthBearerIndependentExitRelation :
    birthBearerExitRelationCompiler.GeneratedRelation :=
  birthBearerExitRelationCompiler.relationOf
    (birthBearerExactRelationSeed .independentExit)

theorem birthBearerEmploymentInterest :
    birthBearerExitRelationCompiler.GeneratedInterestAt
      birthBearerWorker birthBearerEmploymentRelation :=
  ⟨birthBearerExactRelationSeed .employment, rfl, rfl⟩

theorem birthBearerIndependentExitInterest :
    birthBearerExitRelationCompiler.GeneratedInterestAt
      birthBearerWorker birthBearerIndependentExitRelation :=
  ⟨birthBearerExactRelationSeed .independentExit, rfl, rfl⟩

theorem birthBearerEmployment_ne_independentExit :
    birthBearerEmploymentRelation ≠ birthBearerIndependentExitRelation := by
  intro equality
  have lineage_eq := congrArg Subtype.val equality
  exact ExitRelationSeed.noConfusion lineage_eq

/-! ## Existing t0 employment controller and exact employment loss -/

def birthBearerEmploymentController : SourceOwnedActionControllerCompiler
    Lifecycle.actualEventGame targetFace where
  ActionSeed := EmploymentActionSeed
  actionAdmittedAt := fun _ => True
  actionState := fun _ => .after
  actionState_mem := by
    change Lifecycle.EventState.after ∈
      [Lifecycle.EventState.before, Lifecycle.EventState.after]
    simp
  actorState_mem := by
    change Lifecycle.EventState.after ∈
      [Lifecycle.EventState.before, Lifecycle.EventState.after]
    simp
  actorSeed := fun _ => .t0
  actorSeed_active := by
    intro _action _admitted
    rfl

def birthBearerExactEmploymentAction :
    birthBearerEmploymentController.ExactActionSeed :=
  ⟨.terminate, .after, by
    change Lifecycle.EventState.after ∈
      [Lifecycle.EventState.before, Lifecycle.EventState.after]
    simp, rfl, trivial⟩

def birthBearerEmployer : birthBearerEmploymentController.Actor :=
  birthBearerExactEmploymentAction.actor birthBearerEmploymentController

@[simp] theorem birthBearerEmployer_seed_exact :
    birthBearerEmployer.1 = Lifecycle.TargetToken.t0 :=
  rfl

instance birthBearerExitRelationPhaseZero :
    Zero (birthBearerExitRelationCompiler.Phase
      Lifecycle.actualEventGame.source) := by
  change Zero Int
  infer_instance

local instance birthBearerExitFutureCodeDecidableEq :
    DecidableEq birthBearerExitRelationCompiler.FutureCode :=
  birthBearerExitRelationCompiler.futureCodeDecidableEq

theorem birthBearerWork_source_actionable :
    ActionableAt birthBearerExitRelationCompiler.futureIdle
      (birthBearerExitRelationCompiler.futureCodesAt
        birthBearerEmploymentRelation .source) .work := by
  constructor
  · apply
      (birthBearerExitRelationCompiler.mem_futureCodesAt_iff
        birthBearerEmploymentRelation .source .work).mpr
    exact ⟨by
      change ExitFutureCode.work ∈
        ({.idle, .work, .leave} : Finset ExitFutureCode)
      simp, ⟨PUnit.unit⟩⟩
  · simp [birthBearerExitRelationCompiler]

theorem birthBearerWork_target_absent :
    ExitFutureCode.work ∉
      birthBearerExitRelationCompiler.futureCodesAt
        birthBearerEmploymentRelation .target := by
  intro member
  have generated :=
    (birthBearerExitRelationCompiler.mem_futureCodesAt_iff
      birthBearerEmploymentRelation .target .work).mp member
  exact nomatch Classical.choice generated.2

def birthBearerEmploymentFreedomLoss : ActionableFreedomChange
    birthBearerExitRelationCompiler.futureIdle
    (birthBearerExitRelationCompiler.futureCodesAt
      birthBearerEmploymentRelation .source)
    (birthBearerExitRelationCompiler.futureCodesAt
      birthBearerEmploymentRelation .target) :=
  .lost .work birthBearerWork_source_actionable
    birthBearerWork_target_absent

def birthBearerEmploymentActionPower : ActionPowerOverAt
    birthBearerExitRelationCompiler birthBearerEmploymentController
    birthBearerEmployer birthBearerWorker birthBearerEmploymentRelation where
  action := birthBearerExactEmploymentAction
  controller_exact := rfl
  constraint := ⟨birthBearerEmploymentInterest, by
    change (1 : Int) ≠ 0
    norm_num⟩
  freedomChange := birthBearerEmploymentFreedomLoss

def birthBearerEmploymentLoss : SourceGeneratedEmploymentLossAt
    (occurrenceOf := Lifecycle.actualEventOccurrenceOf)
    (game := Lifecycle.actualEventGame)
    (core := Lifecycle.Universal.FixedAdapter.core)
    (controllerFace := Lifecycle.Universal.FixedAdapter.targetFace)
    (exitRelationCompiler := birthBearerExitRelationCompiler)
    (employmentController := birthBearerEmploymentController)
    birthBearerEmployer birthBearerWorker birthBearerEmploymentRelation where
  power := birthBearerEmploymentActionPower
  lostCode := .work
  sourceActionable := birthBearerWork_source_actionable
  targetAbsent := birthBearerWork_target_absent
  freedomChange_eq := rfl

theorem birthBearerLeave_target_actionable :
    ActionableAt birthBearerExitRelationCompiler.futureIdle
      (birthBearerExitRelationCompiler.futureCodesAt
        birthBearerIndependentExitRelation .target) .leave := by
  constructor
  · apply
      (birthBearerExitRelationCompiler.mem_futureCodesAt_iff
        birthBearerIndependentExitRelation .target .leave).mpr
    exact ⟨by
      change ExitFutureCode.leave ∈
        ({.idle, .work, .leave} : Finset ExitFutureCode)
      simp, ⟨PUnit.unit⟩⟩
  · simp [birthBearerExitRelationCompiler]

/-! ## Source-owned bearer exit exercise -/

/--
The exit action reuses the existing future-code grammar as its source seed.
Only `.leave` is admitted, and the existing target-face lineage compiler maps
that exact action occurrence to the already generated `.t1` bearer.  There is
no action registry, controller selector, or completed exit verdict.
-/
def birthBearerExitExerciseController : SourceOwnedActionControllerCompiler
    Lifecycle.actualEventGame targetFace where
  ActionSeed := ExitFutureCode
  actionAdmittedAt := fun code => code = .leave
  actionState := fun _ => .after
  actionState_mem := by
    change Lifecycle.EventState.after ∈
      [Lifecycle.EventState.before, Lifecycle.EventState.after]
    simp
  actorState_mem := by
    change Lifecycle.EventState.after ∈
      [Lifecycle.EventState.before, Lifecycle.EventState.after]
    simp
  actorSeed := fun _ => .t1
  actorSeed_active := by
    intro _action _admitted
    rfl

/-- The sole exact bearer-owned exit action. -/
def birthBearerExactExitExerciseAction :
    birthBearerExitExerciseController.ExactActionSeed :=
  ⟨.leave, .after, by
    change Lifecycle.EventState.after ∈
      [Lifecycle.EventState.before, Lifecycle.EventState.after]
    simp, rfl, rfl⟩

@[simp] theorem birthBearerExitExerciseAction_code_exact :
    birthBearerExactExitExerciseAction.1 = ExitFutureCode.leave :=
  rfl

@[simp] theorem birthBearerExitExerciseActor_eq_worker :
    birthBearerExactExitExerciseAction.actor
        birthBearerExitExerciseController = birthBearerWorker := by
  apply Subtype.ext
  rfl

theorem birthBearerExitExerciseController_exact :
    birthBearerExitExerciseController.ControllerAt
      birthBearerExactExitExerciseAction birthBearerWorker :=
  birthBearerExitExerciseActor_eq_worker

theorem birthBearerExitExercise_source_provenance :
    ∃ state ∈ Lifecycle.actualEventGame.occurrence.trace,
      state = birthBearerExitExerciseController.actionState
          Lifecycle.actualEventGame.source ∧
        birthBearerExitExerciseController.actionAdmittedAt
          birthBearerExactExitExerciseAction.1 :=
  birthBearerExitExerciseController.controller_provenance
    birthBearerExitExerciseController_exact

/-- The real employment-termination controller is `.t0`, not the `.t1`
bearer who owns the independent leave exercise. -/
theorem birthBearerEmployer_ne_birthBearerWorker :
    birthBearerEmployer ≠ birthBearerWorker := by
  intro equality
  have values := congrArg Subtype.val equality
  cases values

/-- Search-side opportunity retained as a negative control.  It has no exact
action seed and therefore cannot replace the exercise authority above. -/
def birthBearerLeavePowerOpportunity : PowerOpportunityAt
    birthBearerExitRelationCompiler birthBearerWorker
      birthBearerIndependentExitRelation .target where
  interest := birthBearerIndependentExitInterest
  code := .leave
  actionable := birthBearerLeave_target_actionable

/-! ## Bearer-specific uncaptured/captured source programs -/

def birthBearerNoCapture : SourceOwnedPriceCaptureCompilerAt
    birthBearerExitRelationCompiler
    (OpenSettlementAt settlementCompiler openOccurrence)
    (exactOpenSettlement exactResidualActivation) where
  Captures := fun _ => False
  capturesDecidable := fun _ => inferInstance
  captureSettlement := fun _ captured => nomatch captured
  captureSettlement_eq := fun _ captured => nomatch captured

def birthBearerFullCapture : SourceOwnedPriceCaptureCompilerAt
    birthBearerExitRelationCompiler
    (OpenSettlementAt settlementCompiler openOccurrence)
    (exactOpenSettlement exactResidualActivation) where
  Captures := fun code => code = .leave
  capturesDecidable := fun code =>
    birthBearerExitFutureCodeDecidableEq code ExitFutureCode.leave
  captureSettlement := fun _ _ => exactOpenSettlement exactResidualActivation
  captureSettlement_eq := fun _ _ => rfl

def birthBearerExitCapacityProgram : ExitCapacityProgramAt
    exactResidualActivation (rootPriceObserver exactResidualActivation)
    birthBearerEmployer birthBearerWorker birthBearerEmploymentRelation
    birthBearerIndependentExitRelation birthBearerNoCapture :=
  ExitCapacityProgramAt.generate rootPurchasingPowerStep
    birthBearerEmploymentLoss birthBearerIndependentExitInterest
    birthBearerEmployment_ne_independentExit

def birthBearerCapturedProgram : ExitCapacityProgramAt
    exactResidualActivation (rootPriceObserver exactResidualActivation)
    birthBearerEmployer birthBearerWorker birthBearerEmploymentRelation
    birthBearerIndependentExitRelation birthBearerFullCapture :=
  ExitCapacityProgramAt.generate rootPurchasingPowerStep
    birthBearerEmploymentLoss birthBearerIndependentExitInterest
    birthBearerEmployment_ne_independentExit

/-- The purchasing-power standing and the exit program name the same existing
`.t1` actor.  Payment is therefore not generated for one bearer while exit is
silently granted to another. -/
@[simp] theorem birthBearerProgramStanding_counterparty_exact :
    PurchasingPowerStandingAt.counterparty
        birthBearerExitCapacityProgram.purchasingPowerStanding =
      birthBearerWorker :=
  rfl

theorem birthBearerProgramStanding_bearer_exact :
    exchangeLaw.bearerOfActor
        (PurchasingPowerStandingAt.counterparty
          birthBearerExitCapacityProgram.purchasingPowerStanding) =
      sourceGeneratedLossAllocationMaterial.parentBearer := by
  rw [birthBearerProgramStanding_counterparty_exact]
  exact birthBearerWorker_bearer_exact

def birthBearerActionableExit :
    birthBearerExitCapacityProgram.exitCone.ActionableExitAt :=
  ⟨.leave,
    (SourceOwnedPriceCaptureCompilerAt.mem_survivingExitCodes_iff
      birthBearerNoCapture birthBearerIndependentExitRelation .leave).mpr
      ⟨by
        change ExitFutureCode.leave ∈
          ({.idle, .work, .leave} : Finset ExitFutureCode)
        simp, ⟨PUnit.unit⟩,
        by simp [birthBearerExitRelationCompiler],
        by simp [birthBearerNoCapture]⟩⟩

theorem birthBearerCapturedProgram_fullPriceCapture :
    birthBearerCapturedProgram.exitCone.FullPriceCaptureAt := by
  intro code actionable
  have generated :=
    (birthBearerExitRelationCompiler.mem_futureCodesAt_iff
      birthBearerIndependentExitRelation .target code).mp actionable.1
  cases code with
  | idle => exact False.elim (actionable.2 rfl)
  | work => exact nomatch Classical.choice generated.2
  | leave => rfl

theorem birthBearerNominalTransfer :
    NominalTransferReadoutAt birthBearerCapturedProgram :=
  NominalTransferReadoutAt.generate
    birthBearerCapturedProgram_fullPriceCapture

/-! ## Existing periodic payment/service reindexed by the t1 bearer program -/

def birthBearerPaymentReceipt : SourceBackedUBIPaymentReceiptAt
    birthBearerExitCapacityProgram.purchasingPowerStanding
    ExitFutureCode.leave := by
  change SourceBackedUBIPaymentReceiptAt
    exitCapacityProgram.purchasingPowerStanding ExitFutureCode.leave
  exact SourceBackedUBIPaymentReceiptAt.generate

def birthBearerGeometryCompilerAt (depth : Nat) :
    SourceOwnedExitGeometryCompilerAt birthBearerExitCapacityProgram
      (anomiePhaseAt depth) (crossingCompilerAt depth) run
      (serviceCompilerAt depth) (actualSettlementAt depth) where
  PaysForAt := SourceBackedUBIPaymentReceiptAt
  RoutesAt := SourceGeneratedUBIRouteReceiptAt

def birthBearerCapturedGeometryCompilerAt (depth : Nat) :
    SourceOwnedExitGeometryCompilerAt birthBearerCapturedProgram
      (anomiePhaseAt depth) (crossingCompilerAt depth) run
      (serviceCompilerAt depth) (actualSettlementAt depth) where
  PaysForAt := SourceBackedUBIPaymentReceiptAt
  RoutesAt := SourceGeneratedUBIRouteReceiptAt

def birthBearerFirstFeasibleExitAt (depth : Nat) :
    ExactFeasibleExitEdgeAt (birthBearerGeometryCompilerAt depth)
      ExitFutureCode.leave (firstSlotAt depth) :=
  FeasibleExitEdgeAt.generate
    (actualSettlement := actualSettlementAt depth)
    birthBearerActionableExit.2 birthBearerPaymentReceipt
      (SourceGeneratedUBIRouteReceiptAt.generate _)

def birthBearerActionableExitRenewalAt (depth : Nat) :
    (birthBearerGeometryCompilerAt depth
      ).SourceGeneratedActionableExitRenewalAt where
  code := .leave
  slot := firstSlotAt depth
  feasible := birthBearerFirstFeasibleExitAt depth

theorem birthBearerCapacity_positive_at (depth : Nat) :
    0 < (birthBearerGeometryCompilerAt depth).actionableExitCapacity :=
  (birthBearerGeometryCompilerAt depth
    ).capacity_positive_iff_actionableExitRenewal.mpr
      ⟨birthBearerActionableExitRenewalAt depth⟩

theorem birthBearerSurvivingCodes_card_eq_one :
    birthBearerExitCapacityProgram.exitCone.survivingCodes.card = 1 := by
  classical
  rw [Finset.card_eq_one]
  refine ⟨ExitFutureCode.leave,
    Finset.eq_singleton_iff_unique_mem.mpr
      ⟨birthBearerActionableExit.2, ?_⟩⟩
  intro code member
  have generated :=
    (SourceOwnedPriceCaptureCompilerAt.mem_survivingExitCodes_iff
      birthBearerNoCapture birthBearerIndependentExitRelation code).mp member
  cases code with
  | idle => exact False.elim (generated.2.2.1 rfl)
  | work =>
      have continuation := Classical.choice generated.2.1
      exact nomatch continuation
  | leave => rfl

/-- Exactly one independent, bearer-compatible leave survives. -/
theorem birthBearerActionableExitCapacity_eq_one_at (depth : Nat) :
    (birthBearerGeometryCompilerAt depth).actionableExitCapacity = 1 := by
  have upper :=
    (birthBearerGeometryCompilerAt depth
      ).capacity_le_surviving_actionable_codes
  rw [birthBearerSurvivingCodes_card_eq_one] at upper
  have lower :
      1 ≤ (birthBearerGeometryCompilerAt depth).actionableExitCapacity :=
    Nat.succ_le_iff.mpr (birthBearerCapacity_positive_at depth)
  exact Nat.le_antisymm upper lower

/-- Full capture removes the only bearer-compatible independent exit. -/
theorem birthBearerCapturedCapacity_eq_zero_at (depth : Nat) :
    (birthBearerCapturedGeometryCompilerAt depth).actionableExitCapacity = 0 :=
  (birthBearerCapturedGeometryCompilerAt depth
    ).nominal_transfer_no_exit_capacity birthBearerNominalTransfer

/-! ## Carrier indexed by the existing periodic actual exit -/

/--
The bearer-specific exit retains the exact payment occurrence and exact
settlement projected from one existing periodic actual-exit authority.  The
worker and bearer are generated internally and cannot be caller-selected.
-/
structure SourceGeneratedContributionCapacityBirthBearerExitAt
    (depth : Nat)
    (existingActualExit : PeriodicActualServiceExitAt depth) : Type 18 where
  private mk ::
  existingPaymentOccurrence : PeriodicSourceBackedPaymentAt depth
  existingPaymentOccurrence_eq :
    existingPaymentOccurrence = existingActualExit.paymentOccurrence
  existingActualSettlement : ExactServedCrossingDebitedRunAt
    (anomiePhaseAt depth) debited (serviceCompilerAt depth)
  existingActualSettlement_eq :
    existingActualSettlement = existingActualExit.actualSettlement
  workerBearer_eq_parent :
    exchangeLaw.bearerOfActor birthBearerWorker =
      sourceGeneratedLossAllocationMaterial.parentBearer
  standingCounterparty_eq_worker :
    PurchasingPowerStandingAt.counterparty
        birthBearerExitCapacityProgram.purchasingPowerStanding =
      birthBearerWorker
  feasibleEdge : ExactFeasibleExitEdgeAt
    (birthBearerGeometryCompilerAt depth)
    ExitFutureCode.leave (firstSlotAt depth)
  feasibleEdgeExact : feasibleEdge = birthBearerFirstFeasibleExitAt depth
  actionableRenewal :
    (birthBearerGeometryCompilerAt depth
      ).SourceGeneratedActionableExitRenewalAt
  actionableRenewalExact : actionableRenewal =
    birthBearerActionableExitRenewalAt depth
  exitExerciseAction :
    birthBearerExitExerciseController.ExactActionSeed
  exitExerciseActionExact : exitExerciseAction =
    birthBearerExactExitExerciseAction
  exitExerciseControllerExact :
    birthBearerExitExerciseController.ControllerAt
      exitExerciseAction birthBearerWorker
  exitExerciseCode_eq_renewalCode :
    exitExerciseAction.1 = actionableRenewal.code
  exactCapacity :
    (birthBearerGeometryCompilerAt depth).actionableExitCapacity = 1
  capturedCapacity :
    (birthBearerCapturedGeometryCompilerAt depth).actionableExitCapacity = 0

/--
The sole producer accepts only an existing periodic actual-exit authority.
It accepts no actor, bearer, participant, score, target, or future.
-/
def sourceGeneratedContributionCapacityBirthBearerExitAt
    (depth : Nat) (existingActualExit : PeriodicActualServiceExitAt depth) :
    SourceGeneratedContributionCapacityBirthBearerExitAt
      depth existingActualExit where
  existingPaymentOccurrence := existingActualExit.paymentOccurrence
  existingPaymentOccurrence_eq := rfl
  existingActualSettlement := existingActualExit.actualSettlement
  existingActualSettlement_eq := rfl
  workerBearer_eq_parent := birthBearerWorker_bearer_exact
  standingCounterparty_eq_worker :=
    birthBearerProgramStanding_counterparty_exact
  feasibleEdge := birthBearerFirstFeasibleExitAt depth
  feasibleEdgeExact := rfl
  actionableRenewal := birthBearerActionableExitRenewalAt depth
  actionableRenewalExact := rfl
  exitExerciseAction := birthBearerExactExitExerciseAction
  exitExerciseActionExact := rfl
  exitExerciseControllerExact := birthBearerExitExerciseController_exact
  exitExerciseCode_eq_renewalCode := rfl
  exactCapacity := birthBearerActionableExitCapacity_eq_one_at depth
  capturedCapacity := birthBearerCapturedCapacity_eq_zero_at depth

namespace SourceGeneratedContributionCapacityBirthBearerExitAt

variable {depth : Nat} {existingActualExit : PeriodicActualServiceExitAt depth}
  (birthExit : SourceGeneratedContributionCapacityBirthBearerExitAt
    depth existingActualExit)

/-- The retained payment is the exact payment occurrence of the input authority. -/
theorem paymentOccurrence_eq_input :
    birthExit.existingPaymentOccurrence =
      existingActualExit.paymentOccurrence :=
  birthExit.existingPaymentOccurrence_eq

/-- Hence it is the canonical source-backed payment at this depth. -/
theorem paymentOccurrence_eq_canonical :
    birthExit.existingPaymentOccurrence =
      periodicSourceBackedPaymentAt depth :=
  birthExit.existingPaymentOccurrence_eq.trans
    existingActualExit.paymentOccurrence_eq

/-- The retained settlement is the exact settlement of the input authority. -/
theorem actualSettlement_eq_input :
    birthExit.existingActualSettlement =
      existingActualExit.actualSettlement :=
  birthExit.existingActualSettlement_eq

/-- Hence geometry and input authority consume one canonical actual settlement. -/
theorem actualSettlement_eq_geometry :
    birthExit.existingActualSettlement = actualSettlementAt depth :=
  birthExit.existingActualSettlement_eq.trans
    existingActualExit.actualSettlement_eq

def paymentReceipt := birthExit.feasibleEdge.paymentReceipt

def routeReceipt := birthExit.feasibleEdge.routeReceipt

def serviceReceipt := birthExit.feasibleEdge.serviceReceipt

/-- The exact action authority carried by this visit-indexed root payload
exposes its own source trace. -/
theorem exitExerciseSourceProvenance :
    ∃ state ∈ Lifecycle.actualEventGame.occurrence.trace,
      state = birthBearerExitExerciseController.actionState
          Lifecycle.actualEventGame.source ∧
        birthBearerExitExerciseController.actionAdmittedAt
          birthExit.exitExerciseAction.1 :=
  birthBearerExitExerciseController.controller_provenance
    birthExit.exitExerciseControllerExact

/-- The indexed input retains its original root factorization. -/
theorem inputRootFactorization :
    existingActualExit.paymentOccurrence.installed.RootAnswerAndNextFactorizes :=
  existingActualExit.rootFactorization

end SourceGeneratedContributionCapacityBirthBearerExitAt

/-- The public carrier has no caller identity or completed-future payload. -/
theorem contributionCapacityBirthBearerExit_hasNoCallerPayload
    (depth : Nat) (existingActualExit : PeriodicActualServiceExitAt depth) :
    True := by
  let birthExit :=
    sourceGeneratedContributionCapacityBirthBearerExitAt
      depth existingActualExit
  fail_if_success exact birthExit.actor
  fail_if_success exact birthExit.bearer
  fail_if_success exact birthExit.participant
  fail_if_success exact birthExit.score
  fail_if_success exact birthExit.target
  fail_if_success exact birthExit.future
  fail_if_success exact birthExit.registry
  trivial

end
end M14SourceGeneratedContributionCapacityBirthBearerExit
end Society
end ProcessGame
