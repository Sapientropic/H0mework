import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Fixture.Economy.Credit.Risk.Merge.Capacity.Runtime.Payment.Novelty.PostSettlement.Representation.Intent.Source.SourceGeneratedContributionCapacityRepresentationIntentActionMaterial
import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Fixture.Economy.Credit.Risk.Merge.Capacity.Runtime.Payment.Novelty.PostSettlement.Representation.NoGo.SourceGeneratedContributionCapacityPairFreeOperationalFailureNoGo

/-!
# Source-generated ordered-pair representation claim world

The existing revised-Q support, anchor, incidence, lineage, responsibility,
open ledger, budgets and dispositions are preserved exactly.  Its constant
obstruction-claim carrier is extended by one contentful ordered-pair intent.
The pair is the two actual current codes generated by the canonical
same-visible/different-K incidence; it is not a proof-only marker.

The generated obstruction has a private constructor and exists only at the
already emitted current-`1` revised-Q target support.  This file remains a
target-world producer.  Sequential installation, a fixed law surface,
failure, U7 and self-U8 are downstream responsibilities.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceGeneratedContributionCapacityRepresentationClaimWorld

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open M14SourceGeneratedContributionMergeActionSource
open M14SourceGeneratedContributionCapacityFinitePrefixResponsibilityDifference
open M14SourceGeneratedContributionCapacityFinitePrefixRepresentationBreaking
open M14SourceGeneratedContributionCapacityFinitePrefixOperationalCode
open M14SourceGeneratedContributionCapacityPairFreeOperationalFailureNoGo
open M14SourceGeneratedContributionCapacityRepresentationIntentActionMaterial
open M14SourceGeneratedPostSettlementObserverSubmissionU8

abbrev BaseNAt (oldVisit : OldVisit) (sourceIndex boundary : Nat) :=
  ActionSourceNAt oldVisit sourceIndex boundary

abbrev RepresentationPairIntent := Nat × Nat

/-- The exact existing revised-Q support at the action source current `1`. -/
def representationIntentSupportAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (BaseNAt oldVisit sourceIndex boundary).Support :=
  (representationIntentActionSourceRootAt oldVisit sourceIndex boundary
    ).toAuthoritativeRoot.toRoot.supportAt 1

@[simp] theorem representationIntentSupport_existingTarget_exact
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    representationIntentSupportAt oldVisit sourceIndex boundary =
      M14SourceGeneratedLossAllocationWorld.lossAllocationTargetSupport
        (rootedFailureAt oldVisit sourceIndex boundary) :=
  rfl

/-- Content generated by the actual later pair. -/
def actualRepresentationPairIntentAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    RepresentationPairIntent :=
  let incidence := canonicalIncidenceAt oldVisit sourceIndex boundary
  (replayAuthorityCurrentCodeAt incidence.leftReplay,
    replayAuthorityCurrentCodeAt incidence.rightReplay)

abbrev RepresentationClaimAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :=
  (BaseNAt oldVisit sourceIndex boundary).Claim ⊕ RepresentationPairIntent

def generatedRepresentationClaimAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    RepresentationClaimAt oldVisit sourceIndex boundary :=
  .inr (actualRepresentationPairIntentAt oldVisit sourceIndex boundary)

def representationBoundaryClaimAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (BaseNAt oldVisit sourceIndex boundary).Claim :=
  (M9ProofCarryingRenewalU8RevisedLedger.revisedTargetObstructionAt
    (oldRootVisitAt oldVisit sourceIndex boundary)).claim

/-- Exact source-owned revelation from the live revised-Q boundary claim to
the new ordered-pair obstruction claim.  The live row is not falsely called
claim-equal to the residual; this semantic-change coordinate records the
otherwise visible mismatch before U8 creates the new claim-bearing coface
entry. -/
inductive SourceGeneratedRepresentationSemanticChangeAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (BaseNAt oldVisit sourceIndex boundary).Support →
      RepresentationClaimAt oldVisit sourceIndex boundary →
      RepresentationClaimAt oldVisit sourceIndex boundary → Type
  | private generated :
      SourceGeneratedRepresentationSemanticChangeAt oldVisit sourceIndex
        boundary (representationIntentSupportAt oldVisit sourceIndex boundary)
        (.inl (representationBoundaryClaimAt oldVisit sourceIndex boundary))
        (generatedRepresentationClaimAt oldVisit sourceIndex boundary)

/-- The new obstruction is generated only at the existing current-`1`
support.  Caller code cannot manufacture a sibling obstruction value. -/
inductive SourceGeneratedRepresentationPairObstructionAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (BaseNAt oldVisit sourceIndex boundary).Support → Type
  | private generated :
      SourceGeneratedRepresentationPairObstructionAt oldVisit sourceIndex
        boundary (representationIntentSupportAt oldVisit sourceIndex boundary)

def sourceGeneratedRepresentationPairObstructionAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    SourceGeneratedRepresentationPairObstructionAt oldVisit sourceIndex
      boundary (representationIntentSupportAt oldVisit sourceIndex boundary) :=
  .generated

def representationClaimWorld
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    WorldRelationNetwork where
  Support := (BaseNAt oldVisit sourceIndex boundary).Support
  Anchor := (BaseNAt oldVisit sourceIndex boundary).Anchor
  Incidence := (BaseNAt oldVisit sourceIndex boundary).Incidence
  Lineage := (BaseNAt oldVisit sourceIndex boundary).Lineage
  Responsibility := (BaseNAt oldVisit sourceIndex boundary).Responsibility
  Claim := RepresentationClaimAt oldVisit sourceIndex boundary
  anchorAt := (BaseNAt oldVisit sourceIndex boundary).anchorAt
  incidenceAt := (BaseNAt oldVisit sourceIndex boundary).incidenceAt
  lineageAt := (BaseNAt oldVisit sourceIndex boundary).lineageAt
  OpenAt := (BaseNAt oldVisit sourceIndex boundary).OpenAt
  openClaimAt := fun isOpen =>
    .inl ((BaseNAt oldVisit sourceIndex boundary).openClaimAt isOpen)
  openProgressBudgetAt :=
    (BaseNAt oldVisit sourceIndex boundary).openProgressBudgetAt
  HoldsAt := fun support claim =>
    match claim with
    | .inl oldClaim =>
        (BaseNAt oldVisit sourceIndex boundary).HoldsAt support oldClaim
    | .inr intent =>
        PLift (intent = actualRepresentationPairIntentAt oldVisit sourceIndex
          boundary)
  ObstructionAt := fun support =>
    (BaseNAt oldVisit sourceIndex boundary).ObstructionAt support ⊕
      SourceGeneratedRepresentationPairObstructionAt oldVisit sourceIndex
        boundary support
  obstructionClaim := fun obstruction =>
    match obstruction with
    | .inl oldObstruction =>
        .inl ((BaseNAt oldVisit sourceIndex boundary).obstructionClaim
          oldObstruction)
    | .inr _generated =>
        generatedRepresentationClaimAt oldVisit sourceIndex boundary
  SemanticChangeAt := fun support sourceClaim targetClaim =>
    match sourceClaim, targetClaim with
    | .inl oldSource, .inl oldTarget =>
        (BaseNAt oldVisit sourceIndex boundary).SemanticChangeAt support
          oldSource oldTarget
    | sourceClaim, targetClaim =>
        SourceGeneratedRepresentationSemanticChangeAt oldVisit sourceIndex
          boundary support sourceClaim targetClaim
  DispositionAt := (BaseNAt oldVisit sourceIndex boundary).DispositionAt

abbrev RepresentationClaimNAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :=
  representationClaimWorld oldVisit sourceIndex boundary

def representationClaimTranslation
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    TypedSemanticWorldNetworkTranslationAt
      (BaseNAt oldVisit sourceIndex boundary)
      (RepresentationClaimNAt oldVisit sourceIndex boundary) where
  support :=
    { forward := id
      backward := id
      backward_forward := fun _ => rfl }
  anchor :=
    { forward := id
      backward := id
      backward_forward := fun _ => rfl }
  incidence :=
    { forward := id
      backward := id
      backward_forward := fun _ => rfl }
  lineage :=
    { forward := id
      backward := id
      backward_forward := fun _ => rfl }
  responsibility :=
    { forward := id
      backward := id
      backward_forward := fun _ => rfl }
  claim :=
    { forward := Sum.inl
      backward := fun claim =>
        match claim with
        | .inl oldClaim => oldClaim
        | .inr _ =>
            (M9ProofCarryingRenewalU8RevisedLedger.newRevisedEntryAt
              (oldRootVisitAt oldVisit sourceIndex boundary)).claim
      backward_forward := fun _ => rfl }
  anchor_commutes := fun _ => rfl
  incidence_commutes := fun _ => rfl
  lineage_commutes := fun _ => rfl
  oldOpenLedger := fun _ =>
    { forward := fun oldEntry => ⟨oldEntry.1, oldEntry.2⟩
      backward := fun newEntry => ⟨newEntry.1, newEntry.2⟩
      backward_forward := fun _ => rfl }
  oldOpenClaim_commutes := fun _ _ => rfl
  oldOpenProgressBudget_commutes := fun _ _ => rfl
  oldHoldsSurvives := fun _ _ proof => proof
  oldDispositionSurvives := fun _ _ receipt => receipt

/-- Public dependent eliminator which preserves the private generated
constructor.  Downstream inventories may assign semantics to the generated
obstruction without gaining authority to manufacture it. -/
def representationObstructionCasesAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat)
    {support : (RepresentationClaimNAt oldVisit sourceIndex boundary).Support}
    (oldCase :
      (BaseNAt oldVisit sourceIndex boundary).ObstructionAt support → Type)
    (generatedCase : Type) :
    (RepresentationClaimNAt oldVisit sourceIndex boundary).ObstructionAt
        support → Type
  | .inl oldObstruction => oldCase oldObstruction
  | .inr .generated => generatedCase

def generatedRepresentationObstructionAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (RepresentationClaimNAt oldVisit sourceIndex boundary).ObstructionAt
      (representationIntentSupportAt oldVisit sourceIndex boundary) :=
  .inr
    (sourceGeneratedRepresentationPairObstructionAt oldVisit sourceIndex
      boundary)

/-- Existing revised-Q target-obstruction row, retained as the visible
boundary bearer at the failure occurrence. -/
def representationResidualBearerAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    OpenResponsibilityAt
      (RepresentationClaimNAt oldVisit sourceIndex boundary)
      (representationIntentSupportAt oldVisit sourceIndex boundary) :=
  let entry :=
    M9ProofCarryingRenewalU8RevisedLedger.revisedTargetObstructionAt
      (oldRootVisitAt oldVisit sourceIndex boundary)
  ⟨entry.1, entry.2⟩

def sourceGeneratedRepresentationSemanticChangeAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (RepresentationClaimNAt oldVisit sourceIndex boundary).SemanticChangeAt
      (representationIntentSupportAt oldVisit sourceIndex boundary)
      (representationResidualBearerAt oldVisit sourceIndex boundary).claim
      (generatedRepresentationClaimAt oldVisit sourceIndex boundary) :=
  .generated

@[simp] theorem representationResidualBearer_claim_boundary_exact
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (representationResidualBearerAt oldVisit sourceIndex boundary).claim =
      (Sum.inl (representationBoundaryClaimAt oldVisit sourceIndex boundary) :
        RepresentationClaimAt oldVisit sourceIndex boundary) :=
  rfl

theorem representationResidualBearer_claim_ne_obstructionClaim
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (representationResidualBearerAt oldVisit sourceIndex boundary).claim ≠
      (RepresentationClaimNAt oldVisit sourceIndex boundary).obstructionClaim
        (generatedRepresentationObstructionAt oldVisit sourceIndex boundary) := by
  intro claim_eq
  change Sum.inl (representationBoundaryClaimAt oldVisit sourceIndex boundary) =
    Sum.inr (actualRepresentationPairIntentAt oldVisit sourceIndex boundary) at claim_eq
  cases claim_eq

@[simp] theorem generatedRepresentationObstruction_claim_exact
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (RepresentationClaimNAt oldVisit sourceIndex boundary).obstructionClaim
        (generatedRepresentationObstructionAt oldVisit sourceIndex boundary) =
      generatedRepresentationClaimAt oldVisit sourceIndex boundary :=
  rfl

theorem generatedRepresentationClaim_hasNoBasePreimage
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    IsEmpty
      (Sigma fun oldClaim : (BaseNAt oldVisit sourceIndex boundary).Claim =>
        PLift
          ((representationClaimTranslation oldVisit sourceIndex boundary
            ).claim.forward oldClaim =
            generatedRepresentationClaimAt oldVisit sourceIndex boundary)) := by
  constructor
  rintro ⟨oldClaim, claim_eq⟩
  have impossible := claim_eq.down
  change (Sum.inl oldClaim : RepresentationClaimAt oldVisit sourceIndex
      boundary) =
    Sum.inr (actualRepresentationPairIntentAt oldVisit sourceIndex boundary) at impossible
  cases impossible

theorem actualRepresentationPairIntent_nondiagonal
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (actualRepresentationPairIntentAt oldVisit sourceIndex boundary).1 ≠
      (actualRepresentationPairIntentAt oldVisit sourceIndex boundary).2 := by
  exact Nat.ne_of_lt
    (canonicalIncidenceAt oldVisit sourceIndex boundary
      ).leftCurrent_lt_rightCurrent

theorem representationClaimWorld_directConsumer
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    let sourceEvent :=
      representationIntentActionExactSourceEventAt oldVisit sourceIndex boundary
    let material := sourceGeneratedRepresentationIntentActionMaterialAt
      oldVisit sourceIndex boundary sourceEvent
    type_of% material.sourceOccurrenceExact ∧
      type_of% material.breakingGenerated.sameInstalledVisibleDifferentK ∧
      (actualRepresentationPairIntentAt oldVisit sourceIndex boundary).1 ≠
        (actualRepresentationPairIntentAt oldVisit sourceIndex boundary).2 ∧
      Nonempty
        ((RepresentationClaimNAt oldVisit sourceIndex boundary).ObstructionAt
          (representationIntentSupportAt oldVisit sourceIndex boundary)) ∧
      Nonempty
        ((RepresentationClaimNAt oldVisit sourceIndex boundary).SemanticChangeAt
          (representationIntentSupportAt oldVisit sourceIndex boundary)
          (representationResidualBearerAt oldVisit sourceIndex boundary).claim
          (generatedRepresentationClaimAt oldVisit sourceIndex boundary)) ∧
      (representationResidualBearerAt oldVisit sourceIndex boundary).claim ≠
        (RepresentationClaimNAt oldVisit sourceIndex boundary).obstructionClaim
          (generatedRepresentationObstructionAt oldVisit sourceIndex boundary) ∧
      (RepresentationClaimNAt oldVisit sourceIndex boundary).obstructionClaim
          (generatedRepresentationObstructionAt oldVisit sourceIndex boundary) =
        generatedRepresentationClaimAt oldVisit sourceIndex boundary ∧
      IsEmpty
        (Sigma fun oldClaim : (BaseNAt oldVisit sourceIndex boundary).Claim =>
          PLift
            ((representationClaimTranslation oldVisit sourceIndex boundary
              ).claim.forward oldClaim =
              generatedRepresentationClaimAt oldVisit sourceIndex boundary)) := by
  dsimp
  let sourceEvent :=
    representationIntentActionExactSourceEventAt oldVisit sourceIndex boundary
  let material := sourceGeneratedRepresentationIntentActionMaterialAt oldVisit
    sourceIndex boundary sourceEvent
  exact
    ⟨material.sourceOccurrenceExact,
      material.breakingGenerated.sameInstalledVisibleDifferentK,
      actualRepresentationPairIntent_nondiagonal oldVisit sourceIndex boundary,
      ⟨generatedRepresentationObstructionAt oldVisit sourceIndex boundary⟩,
      ⟨sourceGeneratedRepresentationSemanticChangeAt oldVisit sourceIndex
        boundary⟩,
      representationResidualBearer_claim_ne_obstructionClaim oldVisit
        sourceIndex boundary,
      generatedRepresentationObstruction_claim_exact oldVisit sourceIndex
        boundary,
      generatedRepresentationClaim_hasNoBasePreimage oldVisit sourceIndex
        boundary⟩

end
