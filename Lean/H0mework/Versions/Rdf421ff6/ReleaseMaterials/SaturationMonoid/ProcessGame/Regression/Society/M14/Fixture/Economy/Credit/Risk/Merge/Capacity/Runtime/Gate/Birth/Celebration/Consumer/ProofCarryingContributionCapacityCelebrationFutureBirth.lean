abbrev CanonicalContributionCapacityFutureBirthAt (index : Nat) :=
  SourceGeneratedContributionCapacityNewCompatibleFutureBirthAt
    canonicalOldVisit 1 index

def canonicalContributionCapacityFutureBirthAt (index : Nat) :
    CanonicalContributionCapacityFutureBirthAt index :=
  sourceGeneratedContributionCapacityNewCompatibleFutureBirthAt
    canonicalOldVisit 1 index

structure CanonicalContributionCapacityFutureBirthAuditAt
    (index : Nat) : Prop where
  generated : Nonempty (CanonicalContributionCapacityFutureBirthAt index)
  initialBirthAdmission : Nonempty
    (ExactGeneratedContributionCapacityResidualBirthAdmissionAt
      canonicalOldVisit)
  crossRootActionPayment : Nonempty
    (ContributionCapacityReopeningActionPaymentAt canonicalOldVisit 1)
  positiveRuntimePayment :
    SourceGeneratedContributionCapacityReopeningRuntimePaymentAt
      canonicalOldVisit 1 index
  residualCarry : Nonempty
    (SourceGeneratedReopeningResidualCarryAt canonicalOldVisit 1
      (M14SourceGeneratedContributionCapacityReopeningRuntimePayment.CanonicalReopeningSourceEventAt
        canonicalOldVisit 1) index)
  laterAuthority : Nonempty
    (SourceNativeLivingTemporalCausalEntryAuthorityAt
      (M14SourceGeneratedContributionCapacityReopeningState.CanonicalReopeningRootAt
        canonicalOldVisit 1)
      (contributionCapacityReopenedVisitAt canonicalOldVisit 1 index)
      (contributionCapacityReopeningTargetResidual canonicalOldVisit))
  laterConsumer : Nonempty
    (SourceNativeInquiryAnswerConsumerAt ()
      (contributionCapacityReopenedInquiryEventAt canonicalOldVisit 1 index)
      (contributionCapacityReopeningTargetResidual canonicalOldVisit)
      (contributionCapacityReopenedAnswerFaceAt canonicalOldVisit 1 index))
  laterCompilation : Nonempty
    (SourceNativeInquiryCompilationAt
      (M14SourceGeneratedContributionCapacityReopeningState.CanonicalReopeningRootAt
        canonicalOldVisit 1)
      (contributionCapacityReopenedVisitAt canonicalOldVisit 1 index)
      (contributionCapacityReopeningU7 canonicalOldVisit)
      (contributionCapacityReopeningCalculus canonicalOldVisit)
      (contributionCapacityReopeningTheory canonicalOldVisit) ()
      (contributionCapacityReopenedInquiryEventAt canonicalOldVisit 1 index)
      (contributionCapacityReopeningTargetResidual canonicalOldVisit)
      (contributionCapacityReopenedAuthorityAt canonicalOldVisit 1 index))
  installedBearerExitProjectionExact :
    (contributionCapacityFutureBirthBearerExitFaceAt canonicalOldVisit 1
      index).projection =
      ContributionCapacityReopeningProjection.birthBearerExit
  rootInstalledBearerExit : Nonempty
    (SourceGeneratedContributionCapacityBirthBearerExitAt
      (contributionCapacityFutureBirthDepth 1 index)
      (contributionCapacityFutureBirthActualExitAt canonicalOldVisit 1 index))
  runtimePaymentActualExitChoiceExact :
    Classical.choice
        (SourceGeneratedContributionCapacityNewCompatibleFutureBirthAt.runtimePaymentGeneratesActualExit
          (canonicalContributionCapacityFutureBirthAt index)) =
      SourceGeneratedContributionCapacityNewCompatibleFutureBirthAt.actualExit
        (canonicalContributionCapacityFutureBirthAt index)
  paymentWorkerBirthBearerExact :
    PurchasingPowerStandingAt.counterparty
        birthBearerExitCapacityProgram.purchasingPowerStanding =
        birthBearerWorker ∧
      M3FiniteExchangeFixture.exchangeLaw.bearerOfActor birthBearerWorker =
        (sourceGeneratedContributionCapacityResidualBirthAdmission
          canonicalOldVisit).obligation.bearer
  residualDispositionExact :
    ((contributionCapacityReopeningLedgerCompiler canonicalOldVisit 1
        (M14SourceGeneratedContributionCapacityReopeningRuntimePayment.CanonicalReopeningSourceEventAt
          canonicalOldVisit 1)).compile
      (contributionCapacityFutureBirthResidualCarryAt canonicalOldVisit 1
        index).sourceOccurrence).entryDisposition
        (contributionCapacityFutureBirthResidualCarryAt canonicalOldVisit 1
          index).sourceEntry =
      .evolved
        (contributionCapacityFutureBirthResidualCarryAt canonicalOldVisit 1
          index).evolution
  residualClaimPreserved :
    (contributionCapacityFutureBirthResidualCarryAt canonicalOldVisit 1
        index).sourceEntry.claim =
      (contributionCapacityFutureBirthResidualCarryAt canonicalOldVisit 1
        index).targetEntry.claim
  residualBudgetsZero :
    (contributionCapacityFutureBirthResidualCarryAt canonicalOldVisit 1
        index).sourceEntry.progressBudget = 0 ∧
      (contributionCapacityFutureBirthResidualCarryAt canonicalOldVisit 1
        index).targetEntry.progressBudget = 0
  refusalCapableNonWork :
    ExitFutureCode.work ∉
        birthBearerExitRelationCompiler.futureCodesAt
          birthBearerEmploymentRelation .target ∧
      birthBearerEmploymentRelation ≠
        birthBearerIndependentExitRelation ∧
      Nonempty (birthBearerExitRelationCompiler.FutureContinuationAt
        birthBearerIndependentExitRelation.1 .target ExitFutureCode.leave) ∧
      ¬ birthBearerExitRelationCompiler.futureIdle ExitFutureCode.leave ∧
      ¬ birthBearerNoCapture.Captures ExitFutureCode.leave ∧
      ExitFutureCode.leave ≠ ExitFutureCode.work
  exitCapacityOneCaptureZero :
    (birthBearerGeometryCompilerAt
        (contributionCapacityFutureBirthDepth 1 index)
      ).actionableExitCapacity = 1 ∧
      (birthBearerCapturedGeometryCompilerAt
        (contributionCapacityFutureBirthDepth 1 index)
      ).actionableExitCapacity = 0
  actionOccurrenceNotReplayed :
    periodicActualServiceExitOccurrenceAt
        (contributionCapacityReopeningDepthAt 1) ≠
      periodicActualServiceExitOccurrenceAt
        (contributionCapacityFutureBirthDepth 1 index)

theorem canonicalContributionCapacityFutureBirthAuditAt (index : Nat) :
    CanonicalContributionCapacityFutureBirthAuditAt index := by
  let birth := canonicalContributionCapacityFutureBirthAt index
  exact
    { generated := ⟨birth⟩
      initialBirthAdmission := ⟨birth.birthAdmission⟩
      crossRootActionPayment := ⟨birth.reopeningActionPayment⟩
      positiveRuntimePayment := birth.runtimePayment
      residualCarry := birth.runtimePayment_contains_residualCarry
      laterAuthority := ⟨birth.laterAuthority⟩
      laterConsumer := ⟨birth.laterConsumer⟩
      laterCompilation := ⟨birth.laterCompilation⟩
      installedBearerExitProjectionExact := rfl
      rootInstalledBearerExit := birth.installedBearerExitAuthority.down
      runtimePaymentActualExitChoiceExact :=
        birth.runtimePaymentChoice_eq_actualExit
      paymentWorkerBirthBearerExact := birth.paymentWorkerBirthBearer_exact
      residualDispositionExact := birth.residualCompilerDisposition_exact
      residualClaimPreserved := birth.residualClaim_preserved
      residualBudgetsZero := birth.residualBudgets_zero
      refusalCapableNonWork :=
        SourceGeneratedContributionCapacityNewCompatibleFutureBirthAt.refusalCapable_nonWork_contract
      exitCapacityOneCaptureZero := birth.exitCapacityOne_captureZero
      actionOccurrenceNotReplayed :=
        SourceGeneratedContributionCapacityNewCompatibleFutureBirthAt.actionAndFutureActualExitOccurrences_distinct
          (sourceIndex := 1) (index := index) }

theorem bareBirth_exit_carry_consumer_orPulse_cannot_retype_asFutureBirth :
    True := by
  let birth := canonicalContributionCapacityFutureBirthAt 0
  fail_if_success exact
    (birth.birthAdmission : CanonicalContributionCapacityFutureBirthAt 0)
  fail_if_success exact
    (birth.actualExit : CanonicalContributionCapacityFutureBirthAt 0)
  fail_if_success exact
    (birth.residualCarry : CanonicalContributionCapacityFutureBirthAt 0)
  fail_if_success exact
    (birth.laterConsumer : CanonicalContributionCapacityFutureBirthAt 0)
  fail_if_success exact
    ((1 : ContributionCapacityFutureBirthPulse) :
      CanonicalContributionCapacityFutureBirthAt 0)
  fail_if_success exact
    (birthBearerNominalTransfer : CanonicalContributionCapacityFutureBirthAt 0)
  trivial

structure ProofCarryingContributionCapacityCelebrationFutureBirth : Prop where
  targetInventoryBirth :
    ProofCarryingContributionCapacityTargetOriginOrBirth
  existingResidualCarryRuntime : Nonempty
    ProofCarryingContributionCapacityReopeningResidualCarryCertificate
  everyPositiveFutureBirth : ∀ index : Nat,
    CanonicalContributionCapacityFutureBirthAuditAt index
  firstFutureDepthExact : contributionCapacityFutureBirthDepth 1 0 = 6
  secondFutureDepthExact : contributionCapacityFutureBirthDepth 1 1 = 7
  everyFiniteFrontierNodup : ∀ start horizon : Nat,
    (sourceGeneratedFiniteContributionCapacityFutureBirthFrontier
      canonicalOldVisit 1 start horizon).Nodup
  everyFinitePulseExact : ∀ start horizon : Nat,
    sourceGeneratedContributionCapacityFutureBirthPulse canonicalOldVisit 1
        start horizon =
      horizon
  cofinalOnReopeningRoot : ∀ index : Nat, ∃ later : Nat, index < later ∧
    Nonempty
      (SourceGeneratedContributionCapacityNewCompatibleFutureBirthAt
        canonicalOldVisit 1 later)
  pulseCannotReconstructOccurrence :
    ¬ ∃ reconstruct : ContributionCapacityFutureBirthPulse →
        AnyContributionCapacityFutureBirth canonicalOldVisit 1,
      Function.LeftInverse reconstruct
        (contributionCapacityFutureBirthPulseObserver canonicalOldVisit
          1).forget
  pulseCannotFactorAuthority :
    ¬ Nonempty
      (AuthorityFactorization
        (contributionCapacityFutureBirthPulseObserver canonicalOldVisit 1))
  pulseCannotFaithfullyReconstruct :
    ¬ Nonempty
      (FaithfulAuthorityReconstruction
        (contributionCapacityFutureBirthPulseObserver canonicalOldVisit 1))
  pulseCannotFactorGeneratedNext :
    ¬ Nonempty
      (AuthorityFactorization
        (contributionCapacityFutureBirthNextPulseObserver canonicalOldVisit
          1))

theorem proofCarryingContributionCapacityCelebrationFutureBirth :
    ProofCarryingContributionCapacityCelebrationFutureBirth where
  targetInventoryBirth :=
    proofCarryingContributionCapacityTargetOriginOrBirth
  existingResidualCarryRuntime :=
    ⟨proofCarryingContributionCapacityReopeningResidualCarryCertificate⟩
  everyPositiveFutureBirth :=
    canonicalContributionCapacityFutureBirthAuditAt
  firstFutureDepthExact := rfl
  secondFutureDepthExact := rfl
  everyFiniteFrontierNodup :=
    contributionCapacityFutureBirthFrontier_nodup canonicalOldVisit 1
  everyFinitePulseExact :=
    contributionCapacityFutureBirthPulse_eq_horizon canonicalOldVisit 1
  cofinalOnReopeningRoot :=
    sourceGeneratedContributionCapacityFutureBirth_cofinalOnReopeningRoot
      canonicalOldVisit 1
  pulseCannotReconstructOccurrence :=
    contributionCapacityFutureBirthPulse_noOccurrenceReconstruction
      canonicalOldVisit 1 0
  pulseCannotFactorAuthority :=
    contributionCapacityFutureBirthPulse_noAuthorityFactorization
      canonicalOldVisit 1 0
  pulseCannotFaithfullyReconstruct :=
    contributionCapacityFutureBirthPulse_noFaithfulReconstruction
      canonicalOldVisit 1 0
  pulseCannotFactorGeneratedNext :=
    contributionCapacityFutureBirthPulse_noNextFactorization
      canonicalOldVisit 1 0

end
