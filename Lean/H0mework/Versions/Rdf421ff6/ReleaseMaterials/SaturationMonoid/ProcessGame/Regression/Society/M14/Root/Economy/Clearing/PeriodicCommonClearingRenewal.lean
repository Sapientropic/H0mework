open M8ActualElectionMandateRenewalRegression
open M9ProofCarryingRenewalInquiryRoot
open M14SourceMandateRenewal
open M14SourceCommonClearingRenewal
open M14UBIPeriodicRootHistory
open M14PeriodicMandatePowerRenewal

/-! ## Same-visit installations and policy coordinates -/

def installedCommonClearingAt (depth : Nat) :
    SourceInstalledRenewalAt commonClearingRecognition
      (temporalVisitAt depth) :=
  SourceInstalledRenewalAt.generate PUnit.unit rfl

/-- Same-depth PCL installation, defined at the root/periodic layer rather
than imported from a downstream power consumer. -/
def installedProofCarryingRenewalAt (depth : Nat) :
    SourceInstalledRenewalAt jointRecognition (temporalVisitAt depth) :=
  SourceInstalledRenewalAt.generate PUnit.unit rfl

theorem commonClearingPolicyCoordinateAt (depth : Nat) :
    SourceInstalledPolicyCoordinateAt
      (installedProofCarryingRenewalAt depth)
      (installedCommonClearingAt depth) where
  sourceEntry_eq := rfl
  selectedRow_heq := HEq.rfl
  successor_heq := HEq.rfl

theorem mandatePolicyCoordinateAt (depth : Nat) :
    SourceInstalledPolicyCoordinateAt
      (installedProofCarryingRenewalAt depth)
      (periodicMandatePowerRenewalAt depth).installed where
  sourceEntry_eq := rfl
  selectedRow_heq := HEq.rfl
  successor_heq := HEq.rfl

/-! ## Full visit-indexed actual carrier -/

structure SourceGeneratedProofCarryingPeriodicSymmetricClearingAt
    (depth : Nat) : Type 18 where
  private mk ::
  installed : SourceInstalledRenewalAt commonClearingRecognition
    (temporalVisitAt depth)
  installedExact : installed = installedCommonClearingAt depth
  seedExact : installed.payload.sourceSeed = commonClearingSeed
  consumerExact : installed.payload.consumer =
    sourceCommonClearingRestriction
  dispositionExact : installed.payload.disposition =
    sourceGeneratedCommonClearingDisposition
  pclInstalled : SourceInstalledRenewalAt jointRecognition
    (temporalVisitAt depth)
  pclInstalledExact : pclInstalled = installedProofCarryingRenewalAt depth
  mandate : SourceGeneratedProofCarryingPeriodicMandatePowerRenewalAt depth
  mandateExact : mandate = periodicMandatePowerRenewalAt depth
  pclCoordinate : SourceInstalledPolicyCoordinateAt pclInstalled installed
  mandateCoordinate : SourceInstalledPolicyCoordinateAt pclInstalled
    mandate.installed
  mandateComponentOutcomeExact :
    mandateRecognition.law.toProjectionLaw.outcomeAt PUnit.unit
        (jointRoot.emitted (temporalVisitAt depth).current) =
      (.inl ⟨mandate.installed.active, mandate.installed.payload⟩ :
        SourceNativeProjectionFiberAt
          mandateRecognition.law.toProjectionLaw PUnit.unit
          (jointRoot.emitted (temporalVisitAt depth).current))
  mandateRootOccurrenceExact : mandate.rootOccurrence =
    jointRoot.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
      (temporalVisitAt depth)
  mandateWholeLedgerExact : mandate.wholeLedgerWriteBack =
    (jointRoot.toAuthoritativeRoot.toLedgerRoot
      |>.generatedAtTemporalVisit
        (temporalVisitAt depth)).wholeLedgerWriteBack
  mandateGeneratedNextExact : mandate.generatedNext =
    jointRoot.generatedNextCurrentAt (temporalVisitAt depth)
  mandatePowerRestored :
    mandate.localFace.responsibilityConsumer.1.1.freedomChange.kind =
      FreedomChangeKind.restored
  mandateM1Consumer : Nonempty (SourceOwnsResponsibilityIncidence
    (mandateVocabulary lineageCompiler)
    sourceMandateHistory.current
    (mandateObligation lineageCompiler sourceMandateHistory.current))
  mandateDispositionLive :
    mandate.localFace.exactDisposition.1.target.slots[
        (mandateSlot lineageCompiler sourceMandateHistory.current).val]? =
      some (.live
        (mandateObligation lineageCompiler sourceMandateHistory.current))
  rootOccurrence : ExactTemporalCausalRootEventAt
    jointRoot.toAuthoritativeRoot.toLedgerRoot (temporalVisitAt depth)
  rootOccurrenceExact : rootOccurrence =
    jointRoot.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
      (temporalVisitAt depth)
  componentOutcomeExact :
    commonClearingRecognition.law.toProjectionLaw.outcomeAt PUnit.unit
        (jointRoot.emitted (temporalVisitAt depth).current) =
      (.inl ⟨installed.active, installed.payload⟩ :
        SourceNativeProjectionFiberAt
          commonClearingRecognition.law.toProjectionLaw PUnit.unit
          (jointRoot.emitted (temporalVisitAt depth).current))
  sourceEntryExact : installed.payload.sourceEntry =
    RootInquiryU8CompletionRegression.entry
  clearingAndPCLSelectedRowShared :
    HEq installed.payload.selectedRow pclInstalled.payload.selectedRow
  clearingAndPCLSuccessorShared :
    HEq installed.payload.successor pclInstalled.payload.successor
  clearingAndMandateOperationalAuthorityShared :
    HEq installed.operationalAuthority mandate.installed.operationalAuthority
  appliedReform : SourceNativeBoundedInstitutionalReformAt
    installed.operationalAuthority
  selectedWriteExact : appliedReform.residualRow =
    installed.temporalSelectedRow
  selectedWriteCommutes :
    appliedReform.residualRow.sourceRow.CommutesWithWorld
  rootConsumer : RenewalResponsibilityConsumerAt
    installed.operationalAuthority
  wholeLedgerExact : appliedReform.wholeLedgerWriteBack =
    (jointRoot.toAuthoritativeRoot.toLedgerRoot
      |>.generatedAtTemporalVisit
        (temporalVisitAt depth)).wholeLedgerWriteBack
  rootFactorization : installed.RootAnswerAndNextFactorizes
  pclRootFactorization : pclInstalled.RootAnswerAndNextFactorizes
  mandateRootFactorization : mandate.installed.RootAnswerAndNextFactorizes
  generatedNextExact : appliedReform.generatedNext =
    jointRoot.generatedNextCurrentAt (temporalVisitAt depth)
  lawSurfacePreserved : appliedReform.generatedNext.root.source.lawSurface =
    jointRoot.source.base.lawSurface
  nextVisitExact : appliedReform.generatedNext.visit =
    temporalVisitAt (depth + 1)
  localSettlementOccurrence :
    automaticCompiler.GeneratedSettlementOccurrence
  localSettlementOccurrenceFromInstalledSeed :
    localSettlementOccurrence =
      automaticCompiler.occurrenceOfSeed installed.payload.sourceSeed
  localSettlementOccurrenceExact : localSettlementOccurrence =
    automaticOccurrence
  everyLegTwoSided : (leg : exactExchangeSeed.Leg) →
    ∃ face : SourceGeneratedSymmetricClearingAt fulfillmentAuthority
        exactExchangeSeed leg,
      Nonempty (ExactLegFulfillmentAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed leg) ∧
      Nonempty (ExactLegFulfillmentAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed
          face.counterpartyLeg) ∧
      Nonempty (SourceOwnsResponsibilityIncidence V
        (P.boundarySource face.legConsumer.event)
        (exactExchangeSeed.obligation exchangeCompiler leg)) ∧
      Nonempty (SourceOwnsResponsibilityIncidence V
        (P.boundarySource face.counterpartyConsumer.event)
        (exactExchangeSeed.obligation exchangeCompiler
          face.counterpartyLeg)) ∧
      face.legActor ≠ face.counterpartyActor ∧
      face.legSlotIndex ≠ face.counterpartySlotIndex ∧
      Nonempty (AutomaticFullFulfillment.FulfilledSlotAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed
          face.fullResult.current leg) ∧
      Nonempty (AutomaticFullFulfillment.FulfilledSlotAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed
          face.fullResult.current face.counterpartyLeg)
  fullResultExact : installed.payload.disposition.fullResult =
    AutomaticFullFulfillment.fullResult fulfillmentAuthority
      exactExchangeSeed
  fullRunExact : HEq installed.payload.disposition.fullRun automaticWholeRun
  closedTarget : IsEmpty
    (OpenSettlementAt automaticCompiler automaticOccurrence)
  projectionDistinct :
    jointCommonClearingProjection ≠
        jointRouteOutageRestorationProjection ∧
      jointCommonClearingProjection ≠
        jointEssentialServiceRestorationProjection ∧
      jointCommonClearingProjection ≠ jointMandateProjection ∧
      jointCommonClearingProjection ≠
        jointRecognitionWitnessProjection ∧
      jointCommonClearingProjection ≠ jointUBIProjection ∧
      jointCommonClearingProjection ≠ jointProofCarryingProjection ∧
      jointCommonClearingProjection ≠ jointInquiryProjection ∧
      jointCommonClearingProjection ≠ jointFailureProjection

/-- Sole periodic producer.  No local run, leg coverage, mandate, policy
coordinate, root occurrence, row, or next is accepted from the caller. -/
def sourceGeneratedProofCarryingPeriodicSymmetricClearingAt (depth : Nat) :
    SourceGeneratedProofCarryingPeriodicSymmetricClearingAt depth := by
  let installed := installedCommonClearingAt depth
  let pcl := installedProofCarryingRenewalAt depth
  let mandate := periodicMandatePowerRenewalAt depth
  let reform := SourceNativeBoundedInstitutionalReformAt.generate
    installed.operationalAuthority
  have automaticRun : HEq automaticWholeRun
      (AutomaticFullFulfillment.fullResult fulfillmentAuthority
        exactExchangeSeed).run := by
    rfl
  exact
    { installed := installed
      installedExact := rfl
      seedExact := rfl
      consumerExact := rfl
      dispositionExact := rfl
      pclInstalled := pcl
      pclInstalledExact := rfl
      mandate := mandate
      mandateExact := rfl
      pclCoordinate := commonClearingPolicyCoordinateAt depth
      mandateCoordinate := mandatePolicyCoordinateAt depth
      mandateComponentOutcomeExact :=
        mandate.installed.componentOutcome_eq_activePayload
      mandateRootOccurrenceExact := mandate.rootOccurrenceExact
      mandateWholeLedgerExact := mandate.wholeLedgerWriteBackExact
      mandateGeneratedNextExact := mandate.generatedNextExact
      mandatePowerRestored := mandate.local_power_is_restored
      mandateM1Consumer :=
        SourceGeneratedProofCarryingPeriodicMandatePowerRenewalAt.local_M1_consumer
      mandateDispositionLive := mandate.local_disposition_stays_live
      rootOccurrence :=
        jointRoot.toAuthoritativeRoot.toLedgerRoot
          |>.exactTemporalCausalEventAt (temporalVisitAt depth)
      rootOccurrenceExact := rfl
      componentOutcomeExact := installed.componentOutcome_eq_activePayload
      sourceEntryExact := rfl
      clearingAndPCLSelectedRowShared := HEq.rfl
      clearingAndPCLSuccessorShared := HEq.rfl
      clearingAndMandateOperationalAuthorityShared := HEq.rfl
      appliedReform := reform
      selectedWriteExact := rfl
      selectedWriteCommutes :=
        reform.residualRow_commutes_with_wholeLedger
      rootConsumer := installed.rootResponsibilityConsumer
      wholeLedgerExact := rfl
      rootFactorization := installed.rootAnswerAndNext_factorizes
      pclRootFactorization := pcl.rootAnswerAndNext_factorizes
      mandateRootFactorization := mandate.rootFactorization
      generatedNextExact := reform.generatedNext_eq_rootCompiler
      lawSurfacePreserved := reform.lawSurface_preserved
      nextVisitExact := rfl
      localSettlementOccurrence :=
        automaticCompiler.occurrenceOfSeed installed.payload.sourceSeed
      localSettlementOccurrenceFromInstalledSeed := rfl
      localSettlementOccurrenceExact := rfl
      everyLegTwoSided :=
        installed.payload.disposition.every_leg_has_two_sided_clearing
      fullResultExact :=
        installed.payload.disposition.fullResult_is_existing
      fullRunExact :=
        installed.payload.disposition.full_run_is_existing.trans
          automaticRun.symm
      closedTarget :=
        SourceAppliedCommonClearingAt.target_openSettlement_isEmpty
      projectionDistinct :=
        commonClearing_projection_distinct_from_existing_coordinates }

theorem every_generated_period_has_actual_commonClearing (depth : Nat) :
    Nonempty
      (SourceGeneratedProofCarryingPeriodicSymmetricClearingAt depth) :=
  ⟨sourceGeneratedProofCarryingPeriodicSymmetricClearingAt depth⟩

theorem periodic_commonClearing_indices_exact (depth : Nat) :
    let clearing :=
      sourceGeneratedProofCarryingPeriodicSymmetricClearingAt depth
    clearing.installed = installedCommonClearingAt depth ∧
      clearing.pclInstalled = installedProofCarryingRenewalAt depth ∧
      clearing.mandate = periodicMandatePowerRenewalAt depth :=
  let clearing :=
    sourceGeneratedProofCarryingPeriodicSymmetricClearingAt depth
  ⟨clearing.installedExact, clearing.pclInstalledExact,
    clearing.mandateExact⟩

theorem periodic_commonClearing_source_action_exact (depth : Nat) :
    let clearing :=
      sourceGeneratedProofCarryingPeriodicSymmetricClearingAt depth
    clearing.installed.payload.sourceSeed = commonClearingSeed ∧
      clearing.installed.payload.consumer =
        sourceCommonClearingRestriction ∧
      clearing.installed.payload.disposition =
        sourceGeneratedCommonClearingDisposition :=
  let clearing :=
    sourceGeneratedProofCarryingPeriodicSymmetricClearingAt depth
  ⟨clearing.seedExact, clearing.consumerExact,
    clearing.dispositionExact⟩

theorem periodic_commonClearing_every_leg_exact
    (depth : Nat) (leg : exactExchangeSeed.Leg) :
    ∃ face : SourceGeneratedSymmetricClearingAt fulfillmentAuthority
        exactExchangeSeed leg,
      Nonempty (ExactLegFulfillmentAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed leg) ∧
      Nonempty (ExactLegFulfillmentAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed
          face.counterpartyLeg) ∧
      Nonempty (SourceOwnsResponsibilityIncidence V
        (P.boundarySource face.legConsumer.event)
        (exactExchangeSeed.obligation exchangeCompiler leg)) ∧
      Nonempty (SourceOwnsResponsibilityIncidence V
        (P.boundarySource face.counterpartyConsumer.event)
        (exactExchangeSeed.obligation exchangeCompiler
          face.counterpartyLeg)) ∧
      face.legActor ≠ face.counterpartyActor ∧
      face.legSlotIndex ≠ face.counterpartySlotIndex ∧
      Nonempty (AutomaticFullFulfillment.FulfilledSlotAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed
          face.fullResult.current leg) ∧
      Nonempty (AutomaticFullFulfillment.FulfilledSlotAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed
          face.fullResult.current face.counterpartyLeg) :=
  (sourceGeneratedProofCarryingPeriodicSymmetricClearingAt depth
    ).everyLegTwoSided leg

theorem periodic_commonClearing_root_policy_and_closure_exact (depth : Nat) :
    let clearing :=
      sourceGeneratedProofCarryingPeriodicSymmetricClearingAt depth
    clearing.rootOccurrence =
        (jointRoot.toAuthoritativeRoot.toLedgerRoot
          |>.exactTemporalCausalEventAt (temporalVisitAt depth)) ∧
      commonClearingRecognition.law.toProjectionLaw.outcomeAt PUnit.unit
          (jointRoot.emitted (temporalVisitAt depth).current) =
        (.inl ⟨clearing.installed.active, clearing.installed.payload⟩ :
          SourceNativeProjectionFiberAt
            commonClearingRecognition.law.toProjectionLaw PUnit.unit
            (jointRoot.emitted (temporalVisitAt depth).current)) ∧
      SourceInstalledPolicyCoordinateAt
        clearing.pclInstalled clearing.installed ∧
      SourceInstalledPolicyCoordinateAt
        clearing.pclInstalled clearing.mandate.installed ∧
      HEq clearing.installed.operationalAuthority
        clearing.mandate.installed.operationalAuthority ∧
      Nonempty (RenewalResponsibilityConsumerAt
        clearing.installed.operationalAuthority) ∧
      clearing.installed.payload.sourceEntry =
        RootInquiryU8CompletionRegression.entry ∧
      clearing.appliedReform.residualRow =
        clearing.installed.temporalSelectedRow ∧
      clearing.appliedReform.residualRow.sourceRow.CommutesWithWorld ∧
      clearing.appliedReform.wholeLedgerWriteBack =
        (jointRoot.toAuthoritativeRoot.toLedgerRoot
          |>.generatedAtTemporalVisit
            (temporalVisitAt depth)).wholeLedgerWriteBack ∧
      clearing.installed.RootAnswerAndNextFactorizes ∧
      clearing.pclInstalled.RootAnswerAndNextFactorizes ∧
      clearing.mandate.installed.RootAnswerAndNextFactorizes ∧
      clearing.appliedReform.generatedNext =
        jointRoot.generatedNextCurrentAt (temporalVisitAt depth) ∧
      clearing.installed.payload.disposition.fullResult =
        AutomaticFullFulfillment.fullResult fulfillmentAuthority
          exactExchangeSeed ∧
      HEq clearing.installed.payload.disposition.fullRun automaticWholeRun ∧
      IsEmpty (OpenSettlementAt automaticCompiler automaticOccurrence) :=
  let clearing :=
    sourceGeneratedProofCarryingPeriodicSymmetricClearingAt depth
  ⟨clearing.rootOccurrenceExact,
    clearing.componentOutcomeExact,
    clearing.pclCoordinate,
    clearing.mandateCoordinate,
    clearing.clearingAndMandateOperationalAuthorityShared,
    ⟨clearing.rootConsumer⟩,
    clearing.sourceEntryExact,
    clearing.selectedWriteExact,
    clearing.selectedWriteCommutes,
    clearing.wholeLedgerExact,
    clearing.rootFactorization,
    clearing.pclRootFactorization,
    clearing.mandateRootFactorization,
    clearing.generatedNextExact,
    clearing.fullResultExact,
    clearing.fullRunExact,
    clearing.closedTarget⟩

theorem periodic_commonClearing_mandate_authority_exact (depth : Nat) :
    let clearing :=
      sourceGeneratedProofCarryingPeriodicSymmetricClearingAt depth
    clearing.mandate.installed.payload.sourceSeed = sourceMandateSeed ∧
      clearing.mandate.installed.payload.consumer = sourceMandateConsumer ∧
      clearing.mandate.installed.payload.disposition =
        sourceMandateDisposition ∧
      (∃ state ∈ SourceMandateGame.occurrence.trace,
        SourceMandateSeedAt SourceMandateGame.source state
          clearing.mandate.localFace.event) ∧
      mandateRecognition.law.toProjectionLaw.outcomeAt PUnit.unit
          (jointRoot.emitted (temporalVisitAt depth).current) =
        (.inl
          ⟨clearing.mandate.installed.active,
            clearing.mandate.installed.payload⟩ :
          SourceNativeProjectionFiberAt
            mandateRecognition.law.toProjectionLaw PUnit.unit
            (jointRoot.emitted (temporalVisitAt depth).current)) ∧
      clearing.mandate.rootOccurrence =
        (jointRoot.toAuthoritativeRoot.toLedgerRoot
          |>.exactTemporalCausalEventAt (temporalVisitAt depth)) ∧
      clearing.mandate.wholeLedgerWriteBack =
        (jointRoot.toAuthoritativeRoot.toLedgerRoot
          |>.generatedAtTemporalVisit
            (temporalVisitAt depth)).wholeLedgerWriteBack ∧
      clearing.mandate.generatedNext =
        jointRoot.generatedNextCurrentAt (temporalVisitAt depth) ∧
      clearing.mandate.localFace.responsibilityConsumer.1.1.freedomChange.kind =
        FreedomChangeKind.restored ∧
      Nonempty (SourceOwnsResponsibilityIncidence
        (mandateVocabulary lineageCompiler)
        sourceMandateHistory.current
        (mandateObligation lineageCompiler sourceMandateHistory.current)) ∧
      clearing.mandate.localFace.exactDisposition.1.target.slots[
          (mandateSlot lineageCompiler sourceMandateHistory.current).val]? =
        some (.live
          (mandateObligation lineageCompiler sourceMandateHistory.current)) :=
  let clearing :=
    sourceGeneratedProofCarryingPeriodicSymmetricClearingAt depth
  ⟨clearing.mandate.seedExact,
    clearing.mandate.consumerExact,
    clearing.mandate.dispositionExact,
    clearing.mandate.local_event_has_exact_trace,
    clearing.mandateComponentOutcomeExact,
    clearing.mandateRootOccurrenceExact,
    clearing.mandateWholeLedgerExact,
    clearing.mandateGeneratedNextExact,
    clearing.mandatePowerRestored,
    clearing.mandateM1Consumer,
    clearing.mandateDispositionLive⟩

/-! ## Visit-indexed non-eternity -/

structure CommonClearingRenewalAtVisit
    (visit : SourceNativeTemporalVisitAt
      jointRoot.toAuthoritativeRoot.toLedgerRoot) : Type 18 where
  private mk ::
  depth : Nat
  visitExact : visit = temporalVisitAt depth
  clearing : SourceGeneratedProofCarryingPeriodicSymmetricClearingAt depth

abbrev AnyPeriodicCommonClearingOccurrence :=
  Sigma CommonClearingRenewalAtVisit

def periodicCommonClearingOccurrenceAt
    (depth : Nat) : AnyPeriodicCommonClearingOccurrence :=
  ⟨temporalVisitAt depth,
    ⟨depth, rfl,
      sourceGeneratedProofCarryingPeriodicSymmetricClearingAt depth⟩⟩

theorem periodicCommonClearingOccurrenceAt_injective :
    Function.Injective periodicCommonClearingOccurrenceAt := by
  intro left right equality
  have visitEquality := congrArg Sigma.fst equality
  exact temporalVisitAt_injective visitEquality

theorem adjacentCommonClearingOccurrences_distinct (depth : Nat) :
    periodicCommonClearingOccurrenceAt depth ≠
      periodicCommonClearingOccurrenceAt (depth + 1) := by
  intro equality
  have depthEquality :=
    periodicCommonClearingOccurrenceAt_injective equality
  omega

theorem no_single_commonClearing_occurrence_carries_all_depths :
    ¬ ∃ occurrence : AnyPeriodicCommonClearingOccurrence,
      ∀ depth : Nat,
        periodicCommonClearingOccurrenceAt depth = occurrence := by
  rintro ⟨occurrence, allDepths⟩
  have equality := (allDepths 0).trans (allDepths 1).symm
  have depthEquality :=
    periodicCommonClearingOccurrenceAt_injective equality
  omega

theorem periodic_commonClearing_mouth_has_no_submitted_authority_or_future
    (depth : Nat) : True := by
  let clearing :=
    sourceGeneratedProofCarryingPeriodicSymmetricClearingAt depth
  fail_if_success exact clearing.submittedRun
  fail_if_success exact clearing.coveragePremise
  fail_if_success exact clearing.mandatePremise
  fail_if_success exact clearing.pclPremise
  fail_if_success exact clearing.rootCandidate
  fail_if_success exact clearing.rowCandidate
  fail_if_success exact clearing.nextPremise
  fail_if_success exact clearing.legislation
  fail_if_success exact clearing.localOccurrenceIsRootOccurrence
  fail_if_success exact clearing.completedFuture
  trivial

end
