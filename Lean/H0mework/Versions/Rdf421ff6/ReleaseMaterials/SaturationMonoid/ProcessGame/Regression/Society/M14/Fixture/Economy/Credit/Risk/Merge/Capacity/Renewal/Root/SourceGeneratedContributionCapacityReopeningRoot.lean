abbrev ContributionCapacityReopeningRootVisitAt
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : ReopeningSourceEventAt oldVisit sourceIndex) :=
  SourceNativeTemporalVisitAt
    ((ReopeningRootAt oldVisit sourceIndex sourceEvent).toAuthoritativeRoot.toLedgerRoot)

/-- Exact installed bearer-aligned exit face at one reopening visit. -/
def contributionCapacityReopeningBirthBearerExitFaceAt
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : ReopeningSourceEventAt oldVisit sourceIndex)
    (visit : ContributionCapacityReopeningRootVisitAt oldVisit sourceIndex
      sourceEvent) :
    SourceNativeRootSemanticFaceAt
      (ReopeningRootAt oldVisit sourceIndex sourceEvent) visit where
  projection := ContributionCapacityReopeningProjection.birthBearerExit
  active := PUnit.unit
  classifier_eq := rfl

/-- The payload is read from the root projection compiler itself. -/
def contributionCapacityReopeningRootGeneratedBirthBearerExitAt
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : ReopeningSourceEventAt oldVisit sourceIndex)
    (visit : ContributionCapacityReopeningRootVisitAt oldVisit sourceIndex
      sourceEvent) :
    PLift (Nonempty
      (SourceGeneratedContributionCapacityBirthBearerExitAt
        (contributionCapacityReopeningDepthAtCurrent sourceIndex
          visit.current)
        (periodicActualServiceExitAt
          (contributionCapacityReopeningDepthAtCurrent sourceIndex
            visit.current)))) :=
  (contributionCapacityReopeningBirthBearerExitFaceAt oldVisit sourceIndex
    sourceEvent visit).rootRead

def contributionCapacityReopeningInitialVisit
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : ReopeningSourceEventAt oldVisit sourceIndex) :
    ContributionCapacityReopeningRootVisitAt oldVisit sourceIndex sourceEvent :=
  .finite
    ((ReopeningRootAt oldVisit sourceIndex sourceEvent).toAuthoritativeRoot.toRoot.initialVisit)

def contributionCapacityReopeningInitialGenerated
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : ReopeningSourceEventAt oldVisit sourceIndex) :=
  (ReopeningRootAt oldVisit sourceIndex sourceEvent).toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit
    (contributionCapacityReopeningInitialVisit oldVisit sourceIndex sourceEvent)

def contributionCapacityReopeningInitialResidual
    (oldVisit : OldVisit) :
    (contributionCapacityReopeningInitialLedger oldVisit).Entry :=
  contributionCapacityReopeningResidualEntryAt oldVisit false

def contributionCapacityReopeningTargetResidual
    (oldVisit : OldVisit) :
    (contributionCapacityReopeningTargetLedger oldVisit).Entry :=
  contributionCapacityReopeningResidualEntryAt oldVisit true

def contributionCapacityReopeningInitialResidualRow
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : ReopeningSourceEventAt oldVisit sourceIndex) :
    (contributionCapacityReopeningInitialGenerated oldVisit sourceIndex
      sourceEvent).GeneratedEntryRowAt
        (contributionCapacityReopeningInitialResidual oldVisit) :=
  ((contributionCapacityReopeningInitialGenerated oldVisit sourceIndex
    sourceEvent).canonicalGeneratedEntryRow?
      (contributionCapacityReopeningInitialResidual oldVisit)).get (by rfl)

def contributionCapacityReopeningFirstSuccessor
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : ReopeningSourceEventAt oldVisit sourceIndex) :
    SourceNativeLedgerGeneratedSuccessorAt
      (contributionCapacityReopeningInitialGenerated oldVisit sourceIndex
        sourceEvent).occurrence
      (contributionCapacityReopeningInitialGenerated oldVisit sourceIndex
        sourceEvent).wholeLedgerWriteBack :=
  PUnit.unit

@[simp] theorem contributionCapacityReopeningFirstSuccessor_targetCurrent
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : ReopeningSourceEventAt oldVisit sourceIndex) :
    (contributionCapacityReopeningFirstSuccessor oldVisit sourceIndex
      sourceEvent).targetCurrent = (1 : Nat) :=
  rfl

