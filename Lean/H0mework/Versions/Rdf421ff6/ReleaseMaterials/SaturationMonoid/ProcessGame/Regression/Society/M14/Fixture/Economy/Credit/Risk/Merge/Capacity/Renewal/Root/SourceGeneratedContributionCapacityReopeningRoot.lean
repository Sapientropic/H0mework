def contributionCapacityReopeningDefaultEntryAt
    (oldVisit : OldVisit) :
    (support : (ReopeningNAt oldVisit).Support) →
      OpenResponsibilityAt (ReopeningNAt oldVisit) support :=
  fun support =>
    ⟨(contributionCapacityU8DefaultEntryAt oldVisit support.1).1,
      (contributionCapacityU8DefaultEntryAt oldVisit support.1).2⟩

/-- Emitted reopening faces follow the generated residual row; non-emitted
old faces retain a total default solely for U7 totality. -/
def contributionCapacityReopeningInquiryEntryAt
    (oldVisit : OldVisit) :
    (support : (ReopeningNAt oldVisit).Support) →
      OpenResponsibilityAt (ReopeningNAt oldVisit) support
  | (.inl oldSupport, phase) =>
      contributionCapacityReopeningDefaultEntryAt oldVisit
        (.inl oldSupport, phase)
  | (.inr direction, phase) => by
      cases direction
      let residual := contributionCapacityU8GeneratedResidual oldVisit
      exact ⟨residual.1, residual.2⟩

def contributionCapacityReopeningTransferDispositionAt
    (oldVisit : OldVisit)
    (support : (CapacityU8NAt oldVisit).Support) :
    (CapacityU8NAt oldVisit).DispositionAt support .transfer := by
  cases support with
  | inl oldSupport =>
      exact contributionCapacityU8TransferDispositionAt oldVisit oldSupport
  | inr direction =>
      cases direction
      exact GeneratedMinimalCofaceAt.CofaceTargetDispositionAt.ofTarget
        (contributionCapacityU8TransferDispositionAt oldVisit
          (contributionCapacityCutTargetSupport
            (capacityActionRootedAt oldVisit)))

def contributionCapacityReopeningU7
    (oldVisit : OldVisit) : U7ProducerCalculus (ReopeningNAt oldVisit) where
  DemandAt := fun _ => Unit
  generateDemand := fun _ => ()

def contributionCapacityReopeningU7Source
    (oldVisit : OldVisit) :
    U7ActualSuccessorSource (ReopeningNAt oldVisit)
      (contributionCapacityReopeningU7 oldVisit) where
  EventAt := SourceGeneratedU7DemandAt (contributionCapacityReopeningU7 oldVisit)
  emit := fun obstruction => .canonical obstruction
  demandGeneratedAt := fun event => event
  demandEntryAt := fun {support} {_obstruction} {_demand} _event =>
    contributionCapacityReopeningDefaultEntryAt oldVisit support

def contributionCapacityReopeningCalculus
    (oldVisit : OldVisit) :
    U7ObstructionEvolutionCalculus (ReopeningNAt oldVisit)
      (contributionCapacityReopeningU7 oldVisit) where
  source := contributionCapacityReopeningU7Source oldVisit
  compile := by
    intro support obstruction demand event
    let receipt := contributionCapacityReopeningTransferDispositionAt
      oldVisit support.1
    exact
      { disposition := .redirected ⟨receipt, rfl⟩
        demandEntryDisposition :=
          ⟨LedgerEntryEvolutionAt.transferred receipt rfl rfl
            (Nat.le_refl _), rfl⟩ }

def contributionCapacityReopeningTheory
    (oldVisit : OldVisit) : TheoryState (ReopeningNAt oldVisit) :=
  TheoryState.rootSemantic (ReopeningNAt oldVisit)

def contributionCapacityReopeningInquiryAudit
    (oldVisit : OldVisit)
    (support : (ReopeningNAt oldVisit).Support) :
    SourceNativeInquiryFrontAuditAt
      (contributionCapacityReopeningU7 oldVisit)
      (contributionCapacityReopeningCalculus oldVisit)
      (contributionCapacityReopeningTheory oldVisit) support :=
  .answered

inductive ContributionCapacityReopeningProjection
  | ledger
  | renewal
  | birthBearerExit
  | inquiry
  | answer
  | consumer

def contributionCapacityReopeningAnswerPayloadAt
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : ReopeningSourceEventAt oldVisit sourceIndex) : Nat → Type
  | 0 => PUnit
  | index + 1 => PLift (Nonempty
      (SourceGeneratedReopeningResidualCarryAt oldVisit sourceIndex
        sourceEvent index))

def contributionCapacityReopeningAnswerPayload
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : ReopeningSourceEventAt oldVisit sourceIndex) :
    (current : Nat) →
      contributionCapacityReopeningAnswerPayloadAt oldVisit sourceIndex
        sourceEvent current
  | 0 => PUnit.unit
  | index + 1 => PLift.up
      ⟨SourceGeneratedReopeningResidualCarryAt.generate oldVisit
        sourceIndex sourceEvent index⟩

abbrev contributionCapacityReopeningProjectionLaw
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : ReopeningSourceEventAt oldVisit sourceIndex) :
    SourceNativeProjectionLaw
      (contributionCapacityReopeningRestructuringSource oldVisit sourceIndex
        sourceEvent).toLedgerSource where
  Projection := ContributionCapacityReopeningProjection
  ActiveAt := fun _ {_} _ => PUnit
  InactiveAt := fun _ {_} _ => PEmpty
  classify := fun _ {_} _ => .inl PUnit.unit
  PayloadAt := fun projection {current} occurrence _ =>
    match projection with
    | .ledger => SourceNativeLedgerEvolutionAt
        (contributionCapacityReopeningSource oldVisit sourceIndex sourceEvent)
        occurrence
    | .renewal => PLift (Nonempty (PeriodicActualServiceExitAt
        (contributionCapacityReopeningDepthAtCurrent sourceIndex current)))
    | .birthBearerExit => PLift (Nonempty
        (SourceGeneratedContributionCapacityBirthBearerExitAt
          (contributionCapacityReopeningDepthAtCurrent sourceIndex current)
          (periodicActualServiceExitAt
            (contributionCapacityReopeningDepthAtCurrent sourceIndex
              current))))
    | .inquiry => SourceNativeInquiryCompilationTokenAt
        (contributionCapacityReopeningInquiryEntryAt oldVisit occurrence.1) ()
        (ULift.up.{1, 0} occurrence)
        (contributionCapacityReopeningInquiryAudit oldVisit occurrence.1)
        (contributionCapacityReopeningAnswerPayloadAt oldVisit sourceIndex
          sourceEvent (show Nat from current))
    | .answer => contributionCapacityReopeningAnswerPayloadAt oldVisit
        sourceIndex sourceEvent (show Nat from current)
    | .consumer => SourceNativeInquiryAnswerConsumerTokenAt
        () (ULift.up.{1, 0} occurrence)
        (contributionCapacityReopeningInquiryEntryAt oldVisit occurrence.1)
        (contributionCapacityReopeningAnswerPayload oldVisit sourceIndex
          sourceEvent (show Nat from current))
  project := by
    intro projection current occurrence active
    cases projection with
    | ledger =>
        exact (contributionCapacityReopeningLedgerCompiler oldVisit sourceIndex
          sourceEvent).compile occurrence
    | renewal => exact PLift.up occurrence.2.periodicExitGenerated
    | birthBearerExit =>
        exact PLift.up ⟨sourceGeneratedContributionCapacityBirthBearerExitAt
          (contributionCapacityReopeningDepthAtCurrent sourceIndex current)
          (periodicActualServiceExitAt
            (contributionCapacityReopeningDepthAtCurrent sourceIndex
              current))⟩
    | inquiry =>
        exact .canonical (contributionCapacityReopeningAnswerPayload oldVisit
          sourceIndex sourceEvent (show Nat from current))
    | answer =>
        exact (contributionCapacityReopeningAnswerPayload oldVisit sourceIndex
          sourceEvent (show Nat from current))
    | consumer => exact .canonical

def contributionCapacityReopeningAuthoritySource
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : ReopeningSourceEventAt oldVisit sourceIndex) :
    SourceNativeAuthoritySource (ReopeningNAt oldVisit)
      (ReopeningVAt oldVisit sourceIndex) where
  restructuringSource :=
    contributionCapacityReopeningRestructuringSource oldVisit sourceIndex
      sourceEvent
  eventInventoryAdmission :=
    .reflOfNoFaithfulTerminal
      (contributionCapacityReopeningRestructuringSource oldVisit sourceIndex
        sourceEvent)
      (fun _ => ⟨fun terminal => nomatch terminal⟩)
  lawSurface := contributionCapacityReopeningTheory oldVisit
  projectionLaw := contributionCapacityReopeningProjectionLaw oldVisit
    sourceIndex sourceEvent

def contributionCapacityReopeningAuthoritativeRoot
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : ReopeningSourceEventAt oldVisit sourceIndex) :
    SourceNativeAuthoritativeRootClosure (ReopeningNAt oldVisit)
      (ReopeningVAt oldVisit sourceIndex) where
  source := contributionCapacityReopeningAuthoritySource oldVisit sourceIndex
    sourceEvent
  emitted := contributionCapacityReopeningEmitted oldVisit sourceIndex
    sourceEvent
  compiler_commutes := fun _ => rfl

def contributionCapacityReopeningLivingRoot
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : ReopeningSourceEventAt oldVisit sourceIndex) :
    SourceNativeLivingRootClosure (ReopeningNAt oldVisit)
      (ReopeningVAt oldVisit sourceIndex) :=
  (contributionCapacityReopeningAuthoritativeRoot oldVisit sourceIndex
    sourceEvent).toLivingWithoutFaithfulTerminal
      (fun _ => ⟨fun terminal => nomatch terminal⟩)

abbrev ReopeningRootAt
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : ReopeningSourceEventAt oldVisit sourceIndex) :=
  contributionCapacityReopeningLivingRoot oldVisit sourceIndex sourceEvent

@[simp] theorem contributionCapacityReopeningRoot_lawSurface_exact
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : ReopeningSourceEventAt oldVisit sourceIndex) :
    (ReopeningRootAt oldVisit sourceIndex sourceEvent).source.base.lawSurface =
      TheoryState.rootSemantic (ReopeningNAt oldVisit) :=
