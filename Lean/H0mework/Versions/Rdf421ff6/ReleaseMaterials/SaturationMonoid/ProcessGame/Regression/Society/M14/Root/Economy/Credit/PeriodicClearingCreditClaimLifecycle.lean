/-!
# M14 periodic proof-carrying clearing credit

This dependent child reads purchasing-power standing, exchange interest,
downside bearer, default provenance, claim lineage, and restructuring from
the canonical C5 backstop at one exact visit.  It adds no authority coordinate
or world action.  The fixed root row is definitionally carried with budget
`2 -> 2`; that identity readout is not a haircut, loss allocation, or risk
mutualization.

The local obligation content and the living-root semantic claim happen to
reduce to `Unit` in this fixture.  They remain separate readouts: this module
deliberately defines no equality or transporter between them.
-/

/-! ## Fixed-instance controls used by the private carrier -/

private theorem fixed_row_evolution_is_carried (depth : Nat) :
    let backstop :=
      sourceGeneratedProofCarryingPeriodicClearingBackstopAt depth
    backstop.appliedReform.rowEvolution =
      LedgerEntryEvolutionAt.carried rfl HEq.rfl := by
  rfl

/-- The beneficiary of the reciprocal `a` leg cannot be retyped as the
borrower-interest incidence generated by the `b` relation. -/
theorem creditor_not_generatedInterest_in_B_relation :
    IsEmpty
      (relationCompiler.GeneratedInterestAt creditorActor creditRelation) := by
  refine ⟨fun interest => ?_⟩
  rcases interest with ⟨seed, actorEquality, relationEquality⟩
  have relationValue := congrArg Subtype.val relationEquality
  have actorValue := congrArg Subtype.val actorEquality
  change seed.1 = Lifecycle.TargetToken.t1 at relationValue
  change seed.1 = Lifecycle.TargetToken.t0 at actorValue
  rw [relationValue] at actorValue
  cases actorValue

/-- The generated C5 next has a terminal fulfilled value at the exact B slot,
so its state-indexed live-B fibre is empty.  This does not manufacture a
second settlement occurrence merely to state the control. -/
private theorem canonicalBackstopNext_B_not_live (depth : Nat) :
    IsEmpty
      { obligation : AdmittedObligation M3FiniteExchangeFixture.V //
        (sourceGeneratedProofCarryingPeriodicClearingBackstopAt depth
          ).localActivation.nextGeneratedState.current.slots[
            exactExchangeSeed.obligationSlotIndex exchangeCompiler
              (.b : Leg)]? = some (ObligationSlot.live obligation) } := by
  refine ⟨fun liveB => ?_⟩
  rcases
      (sourceGeneratedProofCarryingPeriodicClearingBackstopAt depth
        ).localNextFulfilledB with
    ⟨fulfilledB⟩
  have impossible := liveB.2.symm.trans fulfilledB.present
  cases impossible

/-! ## Canonical depth-only credit carrier -/

structure SourceGeneratedProofCarryingPeriodicClearingCreditAt
    (depth : Nat) : Type 18 where
  private mk ::
  backstop : SourceGeneratedProofCarryingPeriodicClearingBackstopAt depth
  backstopExact : backstop =
    sourceGeneratedProofCarryingPeriodicClearingBackstopAt depth
  standing : PurchasingPowerStandingAt
    sourceGeneratedClearingBackstopExactSeed partialZeroObserver
  standingExact : standing = sourceGeneratedClearingBackstopCreditStanding
  standingSourceSeedExact : backstop.installed.payload.sourceSeed =
    sourceGeneratedClearingBackstopExactSeed
  standingTenderExact : standing.tender = backstopTender
  standingAcceptanceExact : HEq standing.counterpartyAcceptance
    backstopCounterpartyAcceptedTender
  standingReceiptProvenance :
    backstopTender.sourceEvent =
        M3FiniteExchangeFixture.P.boundarySource
          canonicalAClearingFace.counterpartyConsumer.event ∧
      backstopCounterpartyAcceptedTender.reciprocalAssumption =
        BearerAssumption.accepted
          backstopCounterpartyAcceptedTender.acceptanceReceipt ∧
      (exactCounterpartyObligation
          sourceGeneratedClearingBackstopExactSeed).content =
        backstopTender.medium ∧
      (exactCounterpartyObligation
          sourceGeneratedClearingBackstopExactSeed).bearer =
        exchangeLaw.bearerOfActor creditorActor ∧
      partialOpenB.obligation.beneficiary =
        exchangeLaw.protectedInterestOfActor creditorActor
  standingSourceTrace :
    ∃ state ∈ Lifecycle.actualEventGame.occurrence.trace,
      partialBResidualConsumerCompiler.activationSeedAt
        Lifecycle.actualEventGame.source state
        (PurchasingPowerStandingAt.renewalEvent standing)
  standingSourceOwnership : Nonempty
    (SourceOwnsResponsibilityIncidence M3FiniteExchangeFixture.V
      (M3FiniteExchangeFixture.P.boundarySource
        canonicalAClearingFace.counterpartyConsumer.event)
      partialOpenB.obligation)
  standingNextExact : PurchasingPowerStandingAt.nextGeneratedState standing =
    backstop.localActivation.nextGeneratedState
  standingWholeGeneratedStepExact :
    (PurchasingPowerStandingAt.nextGeneratedState standing).generated =
      .step (partialOccurrence.generatedState settlementCompiler).generated
        fulfillB
  standingHistoryExact : fulfillB.target.history =
    (partialOccurrence.current settlementCompiler).history ++
      [fulfillB.lifecycleEvent]
  borrower : core.TargetActor
  borrowerExact : borrower = borrowerActor
  creditor : core.TargetActor
  creditorExact : creditor = creditorActor
  borrowerCreditorDistinct : borrower ≠ creditor
  relation : relationCompiler.GeneratedRelation
  relationExact : relation = creditRelation
  generatedInterest :
    relationCompiler.GeneratedInterestAt borrower relation
  creditorInterestEmpty :
    IsEmpty (relationCompiler.GeneratedInterestAt creditor relation)
  localObligationContent : M3FiniteExchangeFixture.V.Content
  localObligationContentExact : localObligationContent =
    partialOpenB.obligation.content
  downsideBearer : Lifecycle.ActorBearer
  downsideBearerExact : downsideBearer = partialOpenB.obligation.bearer
  defaultOccurrence : SourceGeneratedClearingConsumerDeathAt partialOpenB
  defaultOccurrenceExact : defaultOccurrence =
    sourceGeneratedClearingConsumerDeath
  oldBFulfilledEmpty : IsEmpty
    (FulfilledExchangeLegAt settlementCompiler partialOccurrence (.b : Leg))
  backstopNextBFulfilled : Nonempty
    (AutomaticFullFulfillment.FulfilledSlotAt
      (exchangeLaw := exchangeLaw) exactExchangeSeed
      backstop.localActivation.nextGeneratedState.current (.b : Leg))
  backstopNextBNotLive : IsEmpty
    { obligation : AdmittedObligation M3FiniteExchangeFixture.V //
      backstop.localActivation.nextGeneratedState.current.slots[
        exactExchangeSeed.obligationSlotIndex exchangeCompiler (.b : Leg)]? =
          some (ObligationSlot.live obligation) }
  rootConsumer :
    RenewalResponsibilityConsumerAt backstop.installed.operationalAuthority
  rootConsumerExact : rootConsumer = backstop.rootConsumer
  sourceClaim : M9ProofCarryingRenewalInquiryRoot.N.Claim
  sourceClaimExact : sourceClaim =
    backstop.installed.payload.sourceEntry.claim
  futureClaim : M9ProofCarryingRenewalInquiryRoot.N.Claim
  futureClaimExact : futureClaim = backstop.appliedReform.targetEntry.claim
  debtLineage : RootDebtLineageAt M9ProofCarryingRenewalInquiryRoot.N
    backstop.installed.payload.sourceEntry backstop.appliedReform.targetEntry
  debtLineageExact : debtLineage = backstop.appliedReform.debtLineage
  sameClaimFromDebtLineage : sourceClaim = futureClaim
  rowEvolution : LedgerEntryEvolutionAt
    M9ProofCarryingRenewalInquiryRoot.N
    backstop.installed.payload.sourceEntry backstop.appliedReform.targetEntry
  rowEvolutionExact : rowEvolution = backstop.appliedReform.rowEvolution
  fixedRowEvolutionCarried : rowEvolution =
    LedgerEntryEvolutionAt.carried rfl HEq.rfl
  operationalDisposition : LedgerEntryDispositionAt
    M9ProofCarryingRenewalInquiryRoot.N
    backstop.installed.payload.sourceEntry
  operationalDispositionConsumerExact : operationalDisposition =
    rootConsumer.exactDisposition
  operationalDispositionAuthorityExact : operationalDisposition =
    backstop.installed.operationalAuthority.disposition
  sourceBudgetExact :
    backstop.installed.payload.sourceEntry.progressBudget = 2
  targetBudgetExact : backstop.appliedReform.targetEntry.progressBudget = 2
  budgetCarriedExact :
    backstop.appliedReform.targetEntry.progressBudget =
      backstop.installed.payload.sourceEntry.progressBudget
  noStrictBudgetDebit : ¬
    (backstop.appliedReform.targetEntry.progressBudget <
      backstop.installed.payload.sourceEntry.progressBudget)
  generatedRootNext : SourceNativeAuthoritativeRootCurrentAt
    M9ProofCarryingRenewalInquiryRoot.N
  generatedRootNextExact : generatedRootNext =
    backstop.appliedReform.generatedNext
  rootCompilerNextExact : generatedRootNext =
    jointRoot.generatedNextCurrentAt (temporalVisitAt depth)
  rootFactorization : backstop.installed.RootAnswerAndNextFactorizes
  selectedWriteExact : backstop.appliedReform.residualRow =
    backstop.installed.temporalSelectedRow
  selectedWriteCommutes :
    backstop.appliedReform.residualRow.sourceRow.CommutesWithWorld
  wholeLedgerExact : backstop.appliedReform.wholeLedgerWriteBack =
    (jointRoot.toAuthoritativeRoot.toLedgerRoot
      |>.generatedAtTemporalVisit
        (temporalVisitAt depth)).wholeLedgerWriteBack
  lawSurfacePreserved :
    backstop.appliedReform.generatedNext.root.source.lawSurface =
      jointRoot.source.base.lawSurface
  oldCompilerCannotSelectB :
    ¬ ∃ activation : residualConsumerCompiler.ExactActivationSeed,
      (activation.openSettlement residualConsumerCompiler).leg = .b
  oldCompilerCannotPointPartial :
    ¬ ∃ activation : residualConsumerCompiler.ExactActivationSeed,
      activation.occurrence residualConsumerCompiler = partialOccurrence
  oneSidedAEdgeExact : canonicalAClearingFace.oneSidedEdge = fulfillA
  oneSidedABFulfilledEmpty : IsEmpty
    (AutomaticFullFulfillment.FulfilledSlotAt
      (exchangeLaw := exchangeLaw) exactExchangeSeed
      canonicalAClearingFace.oneSidedEdge.target (.b : Leg))
  automaticTargetClosed :
    IsEmpty (OpenSettlementAt automaticCompiler automaticOccurrence)
  nilTargetOpen : Nonempty
    (OpenSettlementAt nilOpenCompiler nilOpenOccurrence)
  nilTargetAFulfillmentEmpty : IsEmpty
    (FulfilledExchangeLegAt nilOpenCompiler nilOpenOccurrence nilOpenA.leg)
  nilTargetNotFullyFulfilled :
    ¬ Nonempty (FullyFulfilledExchangeAt nilOpenCompiler nilOpenOccurrence)

/-- Sole C6 producer.  Its only argument is the temporal depth; the canonical
C5 backstop, standing, claims, default provenance, and restructuring are all
generated or read internally. -/
def sourceGeneratedProofCarryingPeriodicClearingCreditAt (depth : Nat) :
    SourceGeneratedProofCarryingPeriodicClearingCreditAt depth := by
  let backstop :=
    sourceGeneratedProofCarryingPeriodicClearingBackstopAt depth
  let standing := sourceGeneratedClearingBackstopCreditStanding
  let borrower := borrowerActor
  let creditor := creditorActor
  let relation := creditRelation
  let sourceClaim := backstop.installed.payload.sourceEntry.claim
  let futureClaim := backstop.appliedReform.targetEntry.claim
  let lineage := backstop.appliedReform.debtLineage
  let evolution := backstop.appliedReform.rowEvolution
  let rootNext := backstop.appliedReform.generatedNext
  exact
    { backstop := backstop
      backstopExact := rfl
      standing := standing
      standingExact := rfl
      standingSourceSeedExact := backstop.sourceSeedExact
      standingTenderExact := rfl
      standingAcceptanceExact := HEq.rfl
      standingReceiptProvenance := acceptedTender_receipt_provenance
      standingSourceTrace := standing_source_trace_provenance
      standingSourceOwnership := standing_source_ownership
      standingNextExact := rfl
      standingWholeGeneratedStepExact :=
        standing_next_whole_run_and_history_exact.1
      standingHistoryExact :=
        standing_next_whole_run_and_history_exact.2.1
      borrower := borrower
      borrowerExact := rfl
      creditor := creditor
      creditorExact := rfl
      borrowerCreditorDistinct := borrower_ne_creditor
      relation := relation
      relationExact := rfl
      generatedInterest := creditInterest
      creditorInterestEmpty := creditor_not_generatedInterest_in_B_relation
      localObligationContent := partialOpenB.obligation.content
      localObligationContentExact := rfl
      downsideBearer := partialOpenB.obligation.bearer
      downsideBearerExact := rfl
      defaultOccurrence := sourceGeneratedClearingConsumerDeath
      defaultOccurrenceExact := rfl
      oldBFulfilledEmpty := backstop.oldLocalOccurrenceStillOpenB
      backstopNextBFulfilled := backstop.localNextFulfilledB
      backstopNextBNotLive := canonicalBackstopNext_B_not_live depth
      rootConsumer := backstop.rootConsumer
      rootConsumerExact := rfl
      sourceClaim := sourceClaim
      sourceClaimExact := rfl
      futureClaim := futureClaim
      futureClaimExact := rfl
      debtLineage := lineage
      debtLineageExact := rfl
      sameClaimFromDebtLineage := lineage.claim_eq
      rowEvolution := evolution
      rowEvolutionExact := rfl
      fixedRowEvolutionCarried := fixed_row_evolution_is_carried depth
      operationalDisposition := backstop.rootConsumer.exactDisposition
      operationalDispositionConsumerExact := rfl
      operationalDispositionAuthorityExact :=
        backstop.rootConsumer.disposition_eq
      sourceBudgetExact := rfl
      targetBudgetExact := rfl
      budgetCarriedExact := rfl
      noStrictBudgetDebit := by
        intro strictDebit
        have budgetEquality :
            backstop.appliedReform.targetEntry.progressBudget =
              backstop.installed.payload.sourceEntry.progressBudget := by
          rfl
        rw [budgetEquality] at strictDebit
        exact (Nat.lt_irrefl _) strictDebit
      generatedRootNext := rootNext
      generatedRootNextExact := rfl
      rootCompilerNextExact := backstop.generatedNextExact
      rootFactorization := backstop.rootFactorization
      selectedWriteExact := backstop.selectedWriteExact
      selectedWriteCommutes := backstop.selectedWriteCommutes
      wholeLedgerExact := backstop.wholeLedgerExact
      lawSurfacePreserved := backstop.lawSurfacePreserved
      oldCompilerCannotSelectB :=
        sourceGeneratedClearingConsumerDeath.residualCannotSelectMissing
      oldCompilerCannotPointPartial :=
        sourceGeneratedClearingConsumerDeath.residualCannotPointPartial
      oneSidedAEdgeExact := oneSidedA_cannot_supply_backstop_credit_next.1
      oneSidedABFulfilledEmpty :=
        oneSidedA_cannot_supply_backstop_credit_next.2.1
      automaticTargetClosed :=
        sourceGeneratedClearingConsumerDeath.automaticTargetClosed
      nilTargetOpen := sourceGeneratedClearingConsumerDeath.nilTargetOpen
      nilTargetAFulfillmentEmpty :=
        sourceGeneratedClearingConsumerDeath.nilTargetAFulfillmentEmpty
      nilTargetNotFullyFulfilled :=
        sourceGeneratedClearingConsumerDeath.nilTargetNotFullyFulfilled }

theorem every_generated_period_has_actual_clearing_credit (depth : Nat) :
    Nonempty (SourceGeneratedProofCarryingPeriodicClearingCreditAt depth) :=
  ⟨sourceGeneratedProofCarryingPeriodicClearingCreditAt depth⟩

theorem periodic_clearingCredit_source_standing_and_interest_exact
    (depth : Nat) :
    let credit :=
      sourceGeneratedProofCarryingPeriodicClearingCreditAt depth
    credit.backstop =
        sourceGeneratedProofCarryingPeriodicClearingBackstopAt depth ∧
      credit.standing = sourceGeneratedClearingBackstopCreditStanding ∧
      credit.standing.tender = backstopTender ∧
      credit.borrower = borrowerActor ∧
      credit.creditor = creditorActor ∧
      credit.borrower ≠ credit.creditor ∧
      credit.relation = creditRelation ∧
      relationCompiler.GeneratedInterestAt credit.borrower credit.relation ∧
      IsEmpty
        (relationCompiler.GeneratedInterestAt credit.creditor credit.relation) ∧
      PurchasingPowerStandingAt.nextGeneratedState credit.standing =
        credit.backstop.localActivation.nextGeneratedState :=
  let credit :=
    sourceGeneratedProofCarryingPeriodicClearingCreditAt depth
  ⟨credit.backstopExact,
    credit.standingExact,
    credit.standingTenderExact,
    credit.borrowerExact,
    credit.creditorExact,
    credit.borrowerCreditorDistinct,
    credit.relationExact,
    credit.generatedInterest,
    credit.creditorInterestEmpty,
    credit.standingNextExact⟩

theorem periodic_clearingCredit_standing_provenance_exact
    (depth : Nat) :
    let credit :=
      sourceGeneratedProofCarryingPeriodicClearingCreditAt depth
    credit.backstop.installed.payload.sourceSeed =
        sourceGeneratedClearingBackstopExactSeed ∧
      credit.standing.tender = backstopTender ∧
      HEq credit.standing.counterpartyAcceptance
        backstopCounterpartyAcceptedTender ∧
      backstopTender.sourceEvent =
        M3FiniteExchangeFixture.P.boundarySource
          canonicalAClearingFace.counterpartyConsumer.event ∧
      backstopCounterpartyAcceptedTender.reciprocalAssumption =
        BearerAssumption.accepted
          backstopCounterpartyAcceptedTender.acceptanceReceipt ∧
      (exactCounterpartyObligation
          sourceGeneratedClearingBackstopExactSeed).content =
        backstopTender.medium ∧
      (exactCounterpartyObligation
          sourceGeneratedClearingBackstopExactSeed).bearer =
        exchangeLaw.bearerOfActor creditorActor ∧
      partialOpenB.obligation.beneficiary =
        exchangeLaw.protectedInterestOfActor creditorActor ∧
      (∃ state ∈ Lifecycle.actualEventGame.occurrence.trace,
        partialBResidualConsumerCompiler.activationSeedAt
          Lifecycle.actualEventGame.source state
          (PurchasingPowerStandingAt.renewalEvent credit.standing)) ∧
      Nonempty (SourceOwnsResponsibilityIncidence
        M3FiniteExchangeFixture.V
        (M3FiniteExchangeFixture.P.boundarySource
          canonicalAClearingFace.counterpartyConsumer.event)
        partialOpenB.obligation) ∧
      (PurchasingPowerStandingAt.nextGeneratedState
        credit.standing).generated =
          .step
            (partialOccurrence.generatedState settlementCompiler).generated
            fulfillB ∧
      fulfillB.target.history =
        (partialOccurrence.current settlementCompiler).history ++
          [fulfillB.lifecycleEvent] :=
  let credit :=
    sourceGeneratedProofCarryingPeriodicClearingCreditAt depth
  ⟨credit.standingSourceSeedExact,
    credit.standingTenderExact,
    credit.standingAcceptanceExact,
    credit.standingReceiptProvenance.1,
    credit.standingReceiptProvenance.2.1,
    credit.standingReceiptProvenance.2.2.1,
    credit.standingReceiptProvenance.2.2.2.1,
    credit.standingReceiptProvenance.2.2.2.2,
    credit.standingSourceTrace,
    credit.standingSourceOwnership,
    credit.standingWholeGeneratedStepExact,
    credit.standingHistoryExact⟩

theorem periodic_clearingCredit_downside_bearer_exact (depth : Nat) :
    let credit :=
      sourceGeneratedProofCarryingPeriodicClearingCreditAt depth
    credit.downsideBearer = partialOpenB.obligation.bearer ∧
      credit.downsideBearer =
        exchangeLaw.bearerOfActor credit.borrower ∧
      credit.downsideBearer =
        Lifecycle.ActorBearer.target Lifecycle.TargetToken.t1 := by
  let credit :=
    sourceGeneratedProofCarryingPeriodicClearingCreditAt depth
  exact ⟨credit.downsideBearerExact, rfl, rfl⟩

/-- The content and claim are deliberately returned as separate readouts.
There is no content-to-claim equality in this contract. -/
theorem periodic_clearingCredit_separate_local_content_and_root_claim
    (depth : Nat) :
    let credit :=
      sourceGeneratedProofCarryingPeriodicClearingCreditAt depth
    credit.localObligationContent = partialOpenB.obligation.content ∧
      credit.sourceClaim =
        credit.backstop.installed.payload.sourceEntry.claim ∧
      credit.futureClaim = credit.backstop.appliedReform.targetEntry.claim :=
  let credit :=
    sourceGeneratedProofCarryingPeriodicClearingCreditAt depth
  ⟨credit.localObligationContentExact,
    credit.sourceClaimExact,
    credit.futureClaimExact⟩

theorem periodic_clearingCredit_same_claim_restructuring_exact
    (depth : Nat) :
    let credit :=
      sourceGeneratedProofCarryingPeriodicClearingCreditAt depth
    credit.debtLineage = credit.backstop.appliedReform.debtLineage ∧
      credit.sourceClaim = credit.futureClaim ∧
      credit.rowEvolution = credit.backstop.appliedReform.rowEvolution ∧
      credit.rowEvolution = LedgerEntryEvolutionAt.carried rfl HEq.rfl ∧
      credit.operationalDisposition =
        credit.rootConsumer.exactDisposition ∧
      credit.operationalDisposition =
        credit.backstop.installed.operationalAuthority.disposition ∧
      credit.backstop.installed.payload.sourceEntry.progressBudget = 2 ∧
      credit.backstop.appliedReform.targetEntry.progressBudget = 2 ∧
      credit.backstop.appliedReform.targetEntry.progressBudget =
        credit.backstop.installed.payload.sourceEntry.progressBudget ∧
      (¬ (credit.backstop.appliedReform.targetEntry.progressBudget <
        credit.backstop.installed.payload.sourceEntry.progressBudget)) ∧
      credit.generatedRootNext =
        jointRoot.generatedNextCurrentAt (temporalVisitAt depth) ∧
      credit.backstop.appliedReform.generatedNext.visit =
        temporalVisitAt (depth + 1) ∧
      credit.backstop.installed.RootAnswerAndNextFactorizes :=
  let credit :=
    sourceGeneratedProofCarryingPeriodicClearingCreditAt depth
  ⟨credit.debtLineageExact,
    credit.sameClaimFromDebtLineage,
    credit.rowEvolutionExact,
    credit.fixedRowEvolutionCarried,
    credit.operationalDispositionConsumerExact,
    credit.operationalDispositionAuthorityExact,
    credit.sourceBudgetExact,
    credit.targetBudgetExact,
    credit.budgetCarriedExact,
    credit.noStrictBudgetDebit,
    credit.rootCompilerNextExact,
    credit.backstop.nextVisitExact,
    credit.rootFactorization⟩

