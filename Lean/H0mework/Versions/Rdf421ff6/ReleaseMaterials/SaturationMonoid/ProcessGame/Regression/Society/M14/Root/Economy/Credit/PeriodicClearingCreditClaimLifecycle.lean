theorem periodic_clearingCredit_default_and_controls_exact (depth : Nat) :
    let credit :=
      sourceGeneratedProofCarryingPeriodicClearingCreditAt depth
    credit.downsideBearer = partialOpenB.obligation.bearer ∧
      credit.defaultOccurrence = sourceGeneratedClearingConsumerDeath ∧
      IsEmpty (FulfilledExchangeLegAt settlementCompiler partialOccurrence
        (.b : Leg)) ∧
      Nonempty (AutomaticFullFulfillment.FulfilledSlotAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed
        credit.backstop.localActivation.nextGeneratedState.current
        (.b : Leg)) ∧
      IsEmpty
        { obligation : AdmittedObligation M3FiniteExchangeFixture.V //
          credit.backstop.localActivation.nextGeneratedState.current.slots[
            exactExchangeSeed.obligationSlotIndex exchangeCompiler
              (.b : Leg)]? = some (ObligationSlot.live obligation) } ∧
      Nonempty (RenewalResponsibilityConsumerAt
        credit.backstop.installed.operationalAuthority) ∧
      (¬ ∃ activation : residualConsumerCompiler.ExactActivationSeed,
        (activation.openSettlement residualConsumerCompiler).leg = .b) ∧
      (¬ ∃ activation : residualConsumerCompiler.ExactActivationSeed,
        activation.occurrence residualConsumerCompiler = partialOccurrence) ∧
      canonicalAClearingFace.oneSidedEdge = fulfillA ∧
      IsEmpty (AutomaticFullFulfillment.FulfilledSlotAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed
        canonicalAClearingFace.oneSidedEdge.target (.b : Leg)) ∧
      IsEmpty (OpenSettlementAt automaticCompiler automaticOccurrence) ∧
      Nonempty (OpenSettlementAt nilOpenCompiler nilOpenOccurrence) ∧
      IsEmpty (FulfilledExchangeLegAt nilOpenCompiler nilOpenOccurrence
        nilOpenA.leg) ∧
      (¬ Nonempty
        (FullyFulfilledExchangeAt nilOpenCompiler nilOpenOccurrence)) :=
  let credit :=
    sourceGeneratedProofCarryingPeriodicClearingCreditAt depth
  ⟨credit.downsideBearerExact,
    credit.defaultOccurrenceExact,
    credit.oldBFulfilledEmpty,
    credit.backstopNextBFulfilled,
    credit.backstopNextBNotLive,
    ⟨credit.rootConsumer⟩,
    credit.oldCompilerCannotSelectB,
    credit.oldCompilerCannotPointPartial,
    credit.oneSidedAEdgeExact,
    credit.oneSidedABFulfilledEmpty,
    credit.automaticTargetClosed,
    credit.nilTargetOpen,
    credit.nilTargetAFulfillmentEmpty,
    credit.nilTargetNotFullyFulfilled⟩

/-! ## Existing C5 occurrence-indexed non-eternity -/

/-- C6 is a dependent child of the canonical C5 carrier.  It does not stamp
or wrap that carrier in a second credit occurrence. -/
theorem periodic_clearingCredit_is_exact_backstop_dependent_child
    (depth : Nat) :
    let credit :=
      sourceGeneratedProofCarryingPeriodicClearingCreditAt depth
    credit.backstop =
        sourceGeneratedProofCarryingPeriodicClearingBackstopAt depth ∧
      Sigma.fst (periodicClearingBackstopOccurrenceAt depth) =
        temporalVisitAt depth :=
  let credit :=
    sourceGeneratedProofCarryingPeriodicClearingCreditAt depth
  ⟨credit.backstopExact, rfl⟩

theorem periodic_clearingCredit_backstopOccurrence_injective :
    Function.Injective periodicClearingBackstopOccurrenceAt :=
  periodicClearingBackstopOccurrenceAt_injective

theorem adjacent_clearingCredit_backstopOccurrences_distinct (depth : Nat) :
    periodicClearingBackstopOccurrenceAt depth ≠
      periodicClearingBackstopOccurrenceAt (depth + 1) :=
  adjacentClearingBackstopOccurrences_distinct depth

theorem no_single_backstop_occurrence_carries_all_clearingCredit_depths :
    ¬ ∃ occurrence : AnyPeriodicClearingBackstopOccurrence,
      ∀ depth : Nat,
        periodicClearingBackstopOccurrenceAt depth = occurrence :=
  no_single_clearingBackstop_occurrence_carries_all_depths

theorem periodic_clearingCredit_mouth_has_no_new_authority_or_future
    (depth : Nat) : True := by
  let credit := sourceGeneratedProofCarryingPeriodicClearingCreditAt depth
  fail_if_success exact credit.submittedBackstop
  fail_if_success exact credit.submittedStanding
  fail_if_success exact credit.submittedTender
  fail_if_success exact credit.submittedAcceptance
  fail_if_success exact credit.futureClaimPremise
  fail_if_success exact credit.defaultPremise
  fail_if_success exact credit.localContentToRootClaimTransporter
  fail_if_success exact credit.creditKind
  fail_if_success exact credit.defaultKind
  fail_if_success exact credit.riskPool
  fail_if_success exact credit.haircut
  fail_if_success exact credit.lossMutualization
  fail_if_success exact credit.eleventhCoordinate
  fail_if_success exact credit.secondRoot
  fail_if_success exact credit.secondOccurrence
  fail_if_success exact credit.parallelRun
  fail_if_success exact credit.ledgerCandidate
  fail_if_success exact credit.coveragePremise
  fail_if_success exact credit.scheduler
  fail_if_success exact credit.completedFuture
  trivial

end
end M14PeriodicClearingCreditClaimLifecycle
