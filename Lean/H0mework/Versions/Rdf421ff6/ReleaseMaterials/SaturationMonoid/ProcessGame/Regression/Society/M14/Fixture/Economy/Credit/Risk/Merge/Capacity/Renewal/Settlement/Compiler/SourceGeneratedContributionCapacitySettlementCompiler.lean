open M14SourceGeneratedContributionCapacitySettlementSupport
open M14SourceGeneratedContributionCapacitySettlementActionSource

abbrev SettlementNAt (oldVisit : OldVisit) := ReopeningNAt oldVisit

abbrev SettlementSourceRootAt
    (oldVisit : OldVisit) (sourceIndex : Nat) :=
  ContributionCapacitySettlementActionRootAt oldVisit sourceIndex

abbrev SettlementSourceVisitAt
    (oldVisit : OldVisit) (sourceIndex : Nat) :=
  contributionCapacitySettlementActionVisitAt oldVisit sourceIndex

abbrev SettlementSourceEventAt
    (oldVisit : OldVisit) (sourceIndex : Nat) :=
  ContributionCapacitySettlementSourceEventAt oldVisit sourceIndex

/-! ## Full three-row ledger enumerator -/

def contributionCapacitySettlementFullEntryAt
    (oldVisit : OldVisit) :
    Fin 3 → (contributionCapacitySettlementFullLedger oldVisit).Entry :=
  contributionCapacityReopeningEntryAt oldVisit true

def contributionCapacitySettlementFullEntryIndex
    (oldVisit : OldVisit) :
    (contributionCapacitySettlementFullLedger oldVisit).Entry → Fin 3 :=
  contributionCapacityReopeningEntryIndex oldVisit true

theorem contributionCapacitySettlementFullEntryAt_index
    (oldVisit : OldVisit)
    (entry : (contributionCapacitySettlementFullLedger oldVisit).Entry) :
    contributionCapacitySettlementFullEntryAt oldVisit
        (contributionCapacitySettlementFullEntryIndex oldVisit entry) = entry :=
  contributionCapacityReopeningEntryAt_index oldVisit true entry

theorem contributionCapacitySettlementFullEntry_cases
    (oldVisit : OldVisit)
    (entry : (contributionCapacitySettlementFullLedger oldVisit).Entry) :
    entry = contributionCapacitySettlementFullEntryAt oldVisit 0 ∨
      entry = contributionCapacitySettlementFullEntryAt oldVisit 1 ∨
      entry = contributionCapacitySettlementFullEntryAt oldVisit 2 :=
  contributionCapacityReopeningEntry_cases oldVisit true entry

/-! ## Source-native write then faithful terminal -/

inductive ContributionCapacitySettlementNativeWriteAt : Bool → Type
  | ingress : ContributionCapacitySettlementNativeWriteAt false

inductive ContributionCapacitySettlementFaithfulTerminalAt : Bool → Type
  | settled : ContributionCapacitySettlementFaithfulTerminalAt true

def contributionCapacitySettlementVocabulary
    (oldVisit : OldVisit) : ConstructiveRoot.Vocabulary where
  Current := Bool
  Anchor := (SettlementNAt oldVisit).Anchor
  Incidence := (SettlementNAt oldVisit).Incidence
  Lineage := (SettlementNAt oldVisit).Lineage
  anchorAt := fun _ => (SettlementNAt oldVisit).anchorAt
    (contributionCapacitySettlementFullSupport oldVisit)
  incidenceAt := fun _ => (SettlementNAt oldVisit).incidenceAt
    (contributionCapacitySettlementFullSupport oldVisit)
  lineageAt := fun _ => (SettlementNAt oldVisit).lineageAt
    (contributionCapacitySettlementFullSupport oldVisit)
  NativeWriteAt := ContributionCapacitySettlementNativeWriteAt
  RelationWriteAt := fun _ => PEmpty
  ContinuedTransportAt := fun _ => PEmpty
  BorromeanRedirectAt := fun _ => PEmpty
  FaithfulTerminalAt := ContributionCapacitySettlementFaithfulTerminalAt
  nativeTarget := fun write => match write with | .ingress => true
  relationTarget := PEmpty.elim
  continuedTarget := PEmpty.elim
  redirectTarget := PEmpty.elim

abbrev SettlementVAt (oldVisit : OldVisit) :=
  contributionCapacitySettlementVocabulary oldVisit

inductive SourceGeneratedContributionCapacitySettlementEventAt
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex) :
    (current : Bool) → (SettlementNAt oldVisit).Support → Type
  | private ingress : SourceGeneratedContributionCapacitySettlementEventAt
      oldVisit sourceIndex sourceEvent false
      (contributionCapacitySettlementFullSupport oldVisit)
  | private terminal : SourceGeneratedContributionCapacitySettlementEventAt
      oldVisit sourceIndex sourceEvent true
      (contributionCapacitySettlementFullSupport oldVisit)

def contributionCapacitySettlementEventLaw
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex) :
    SourceNativeEventAlgebra (SettlementNAt oldVisit) (SettlementVAt oldVisit) where
  EventAt := SourceGeneratedContributionCapacitySettlementEventAt oldVisit
    sourceIndex sourceEvent
  compile := fun event => match event with
    | .ingress => .nativeWrite .ingress
    | .terminal => .faithfulTerminal .settled
  AffectedInventoryAt := fun {_} {support} _ =>
    OpenResponsibilityAt (SettlementNAt oldVisit) support
  affectedInventoryPresentation := fun _ => ConstructivePresentation.refl _
  anchorKey := id
  incidenceKey := id
  lineageKey := id
  anchor_commutes := by intro current support event; cases event <;> rfl
  incidence_commutes := by intro current support event; cases event <;> rfl
  lineage_commutes := by intro current support event; cases event <;> rfl

def contributionCapacitySettlementSource
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex) :
    SourceNativeSource (SettlementNAt oldVisit) (SettlementVAt oldVisit) where
  initial := false
  law := contributionCapacitySettlementEventLaw oldVisit sourceIndex sourceEvent

def contributionCapacitySettlementEmitted
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex) :
    (current : Bool) →
      (contributionCapacitySettlementSource oldVisit sourceIndex sourceEvent)
        |>.toRootSource.actual.OccurrenceAt current
  | false => ⟨contributionCapacitySettlementFullSupport oldVisit, .ingress⟩
  | true => ⟨contributionCapacitySettlementFullSupport oldVisit, .terminal⟩

theorem contributionCapacitySettlementOccurrence_eq_emitted
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex)
    {current : Bool}
    (occurrence :
      (contributionCapacitySettlementSource oldVisit sourceIndex sourceEvent)
        |>.toRootSource.actual.OccurrenceAt current) :
    occurrence = contributionCapacitySettlementEmitted oldVisit sourceIndex
      sourceEvent current := by
  rcases occurrence with ⟨support, event⟩
  cases event <;> rfl

def ContributionCapacitySettlementExactTransitionAt
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex) :
    {current : Bool} →
    (occurrence :
      (contributionCapacitySettlementSource oldVisit sourceIndex sourceEvent)
        |>.toRootSource.actual.OccurrenceAt current) →
    {targetSupport : (SettlementNAt oldVisit).Support} →
    OpenResponsibilityAt (SettlementNAt oldVisit) occurrence.1 →
    OpenResponsibilityAt (SettlementNAt oldVisit) targetSupport → Type :=
  fun {_} _ {_} sourceEntry targetEntry =>
    LedgerEntryEvolutionAt (SettlementNAt oldVisit) sourceEntry targetEntry

def contributionCapacitySettlementWriteRowSource
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex) :
    LedgerWriteRowSourceAt
      (contributionCapacitySettlementSource oldVisit sourceIndex sourceEvent)
      (ContributionCapacitySettlementExactTransitionAt oldVisit sourceIndex
        sourceEvent) where
  IncidenceOccurrenceAt := fun {_} _ {_} sourceEntry targetEntry =>
    LedgerEntryEvolutionAt (SettlementNAt oldVisit) sourceEntry targetEntry
  compileEvolution := id
  compileExact := id

def contributionCapacitySettlementWriteRows
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex)
    (occurrence :
      (contributionCapacitySettlementSource oldVisit sourceIndex sourceEvent)
        |>.toRootSource.actual.OccurrenceAt false) :
    FiniteGeneratedLedgerWriteRowsAt
      (contributionCapacitySettlementWriteRowSource oldVisit sourceIndex
        sourceEvent) occurrence
      (contributionCapacitySettlementFullLedger oldVisit) := by
  rw [contributionCapacitySettlementOccurrence_eq_emitted oldVisit sourceIndex
    sourceEvent occurrence]
  exact
    { size := 3
      sourceEntryAt := contributionCapacitySettlementFullEntryAt oldVisit
      targetEntryAt := contributionCapacitySettlementFullEntryAt oldVisit
      rowAt := fun index =>
        (contributionCapacitySettlementWriteRowSource oldVisit sourceIndex
          sourceEvent).generate (.carried rfl HEq.rfl) }

def contributionCapacitySettlementWritePatch
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex)
    (occurrence :
      (contributionCapacitySettlementSource oldVisit sourceIndex sourceEvent)
        |>.toRootSource.actual.OccurrenceAt false) :
    FiniteGeneratedLedgerWritePatchAt
      (contributionCapacitySettlementWriteRowSource oldVisit sourceIndex
        sourceEvent) occurrence
      (contributionCapacitySettlementFullLedger oldVisit) := by
  rcases occurrence with ⟨support, event⟩
  cases event
  exact .complete
    (contributionCapacitySettlementWriteRows oldVisit sourceIndex sourceEvent
      (contributionCapacitySettlementEmitted oldVisit sourceIndex sourceEvent
        false))
    { destinationIndex := contributionCapacitySettlementFullEntryIndex oldVisit
      originIndex := contributionCapacitySettlementFullEntryIndex oldVisit
      destination_sound := contributionCapacitySettlementFullEntryAt_index oldVisit
      origin_sound := contributionCapacitySettlementFullEntryAt_index oldVisit }

def contributionCapacitySettlementWriteEvolution
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex)
    (occurrence :
      (contributionCapacitySettlementSource oldVisit sourceIndex sourceEvent)
        |>.toRootSource.actual.OccurrenceAt false) :
    LedgerWriteEvolutionAt (SettlementNAt oldVisit)
      (contributionCapacitySettlementFullLedger oldVisit)
      (contributionCapacitySettlementFullLedger oldVisit) := by
  rcases occurrence with ⟨support, event⟩
  cases event
  exact (contributionCapacitySettlementWritePatch oldVisit sourceIndex sourceEvent
    (contributionCapacitySettlementEmitted oldVisit sourceIndex sourceEvent
      false)).toLedgerWriteEvolution

theorem contributionCapacitySettlementSourceEvent_eq_exact
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex) :
    sourceEvent = contributionCapacitySettlementActionExactSourceEventAt
      oldVisit sourceIndex := by
  exact sourceEvent.eq_generated

/-! ## Source-indexed faithful-terminal incidence -/

inductive SourceGeneratedContributionCapacitySettlementTerminalIncidenceAt
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex) :
    (occurrence :
      (contributionCapacitySettlementSource oldVisit sourceIndex sourceEvent)
        |>.toRootSource.actual.OccurrenceAt true) →
    OpenResponsibilityAt (SettlementNAt oldVisit) occurrence.1 → Type
  | private row (index : Fin 3) :
      SourceGeneratedContributionCapacitySettlementTerminalIncidenceAt
        oldVisit sourceIndex sourceEvent
        (contributionCapacitySettlementEmitted oldVisit sourceIndex sourceEvent
          true)
        (contributionCapacitySettlementFullEntryAt oldVisit index)

private def contributionCapacitySettlementSupportReceiptAt
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex)
    {occurrence :
      (contributionCapacitySettlementSource oldVisit sourceIndex sourceEvent)
        |>.toRootSource.actual.OccurrenceAt true}
    {entry : OpenResponsibilityAt (SettlementNAt oldVisit) occurrence.1}
    (incidence : SourceGeneratedContributionCapacitySettlementTerminalIncidenceAt
      oldVisit sourceIndex sourceEvent occurrence entry) :
    (SettlementNAt oldVisit).DispositionAt occurrence.1 .supportSettlement := by
  cases incidence
  exact GeneratedMinimalCofaceAt.CofaceTargetDispositionAt.ofTarget
    (GeneratedMinimalCofaceAt.CofaceTargetDispositionAt.ofTarget ())

def contributionCapacitySettlementTerminalRowSource
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex) :
    LedgerTerminalRowSourceAt
      (contributionCapacitySettlementSource oldVisit sourceIndex sourceEvent) where
  IncidenceOccurrenceAt := fun {current} occurrence entry =>
    match current with
    | false => PEmpty
    | true =>
        SourceGeneratedContributionCapacitySettlementTerminalIncidenceAt
          oldVisit sourceIndex sourceEvent occurrence entry
  compile := by
    intro current occurrence entry incidence
    cases current with
    | false => exact nomatch incidence
    | true =>
        exact ⟨contributionCapacitySettlementSupportReceiptAt oldVisit
          sourceIndex sourceEvent incidence⟩

def contributionCapacitySettlementTerminalPatch
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex)
    (occurrence :
      (contributionCapacitySettlementSource oldVisit sourceIndex sourceEvent)
        |>.toRootSource.actual.OccurrenceAt true) :
    FiniteGeneratedLedgerTerminalPatchAt
      (contributionCapacitySettlementTerminalRowSource oldVisit sourceIndex
        sourceEvent) occurrence := by
  rw [contributionCapacitySettlementOccurrence_eq_emitted oldVisit sourceIndex
    sourceEvent occurrence]
  exact
    { size := 3
      entryAt := contributionCapacitySettlementFullEntryAt oldVisit
      rowAt := fun index =>
        (contributionCapacitySettlementTerminalRowSource oldVisit sourceIndex
          sourceEvent).generate (.row index)
      entryIndex := contributionCapacitySettlementFullEntryIndex oldVisit
      entry_sound := contributionCapacitySettlementFullEntryAt_index oldVisit }

def contributionCapacitySettlementTerminalEvolution
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex)
    (occurrence :
      (contributionCapacitySettlementSource oldVisit sourceIndex sourceEvent)
        |>.toRootSource.actual.OccurrenceAt true) :
    LedgerTerminalEvolutionAt (SettlementNAt oldVisit)
      (contributionCapacitySettlementFullLedger oldVisit) := by
  rcases occurrence with ⟨support, event⟩
  cases event
  exact (contributionCapacitySettlementTerminalPatch oldVisit sourceIndex
    sourceEvent
    (contributionCapacitySettlementEmitted oldVisit sourceIndex sourceEvent
      true)).toLedgerTerminalEvolution

def contributionCapacitySettlementLedgerCompiler
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex) :
    SourceNativeLedgerCompiler
      (contributionCapacitySettlementSource oldVisit sourceIndex sourceEvent) where
  IncidenceTransitionAt := fun _ _ _ => Unit
  ExactTransitionAt := ContributionCapacitySettlementExactTransitionAt oldVisit
    sourceIndex sourceEvent
  exact_incidence := fun _ => ()
  exact_lineage := by
    intro current occurrence targetSupport sourceEntry targetEntry evolution
    cases evolution with
    | carried support_eq entry_eq => cases support_eq; cases entry_eq; rfl
    | maintained _ _ lineage_eq _ _ _ => exact lineage_eq
    | transferred _ lineage_eq _ _ => exact lineage_eq
  writeRowSource := contributionCapacitySettlementWriteRowSource oldVisit
    sourceIndex sourceEvent
  terminalRowSource := contributionCapacitySettlementTerminalRowSource oldVisit
    sourceIndex sourceEvent
  compile := by
    intro current occurrence
    rcases occurrence with ⟨support, event⟩
    cases event
    · exact .nativeWrite .ingress rfl
        (contributionCapacitySettlementEmitted oldVisit sourceIndex sourceEvent
          true)
        (contributionCapacitySettlementWriteEvolution oldVisit sourceIndex
          sourceEvent
          (contributionCapacitySettlementEmitted oldVisit sourceIndex
            sourceEvent false))
    · exact .faithfulTerminal .settled rfl
        (contributionCapacitySettlementTerminalEvolution oldVisit sourceIndex
          sourceEvent
          (contributionCapacitySettlementEmitted oldVisit sourceIndex
            sourceEvent true))
  compilePatch := by
    intro current occurrence
    rcases occurrence with ⟨support, event⟩
    cases event
    · exact ⟨contributionCapacitySettlementWritePatch oldVisit sourceIndex
        sourceEvent
        (contributionCapacitySettlementEmitted oldVisit sourceIndex sourceEvent
          false), rfl⟩
    · exact ⟨.finite (contributionCapacitySettlementTerminalPatch oldVisit sourceIndex
        sourceEvent
        (contributionCapacitySettlementEmitted oldVisit sourceIndex sourceEvent
          true)), rfl⟩

theorem contributionCapacitySettlementWriteEvolution_destination
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex)
    (occurrence :
      (contributionCapacitySettlementSource oldVisit sourceIndex sourceEvent)
        |>.toRootSource.actual.OccurrenceAt false)
    (entry : (contributionCapacitySettlementFullLedger oldVisit).Entry) :
    ((contributionCapacitySettlementWriteEvolution oldVisit sourceIndex
      sourceEvent occurrence).destination entry).1 = entry := by
  rw [contributionCapacitySettlementOccurrence_eq_emitted oldVisit sourceIndex
    sourceEvent occurrence]
  rcases contributionCapacitySettlementFullEntry_cases oldVisit entry with
      entry_eq | entry_eq | entry_eq <;> subst entry <;> rfl

theorem contributionCapacitySettlementWriteEvolution_origin
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex)
    (occurrence :
      (contributionCapacitySettlementSource oldVisit sourceIndex sourceEvent)
        |>.toRootSource.actual.OccurrenceAt false)
    (entry : (contributionCapacitySettlementFullLedger oldVisit).Entry) :
    ((contributionCapacitySettlementWriteEvolution oldVisit sourceIndex
      sourceEvent occurrence).origin entry).1 = entry := by
  rw [contributionCapacitySettlementOccurrence_eq_emitted oldVisit sourceIndex
    sourceEvent occurrence]
  rcases contributionCapacitySettlementFullEntry_cases oldVisit entry with
      entry_eq | entry_eq | entry_eq <;> subst entry <;> rfl

/-! ## Existing lifecycle restructuring certification -/

def contributionCapacitySettlementRestructuringVocabulary
    (oldVisit : OldVisit) : RestructuringVocabulary where
  base := ContributionCapacityU8LifecycleV oldVisit
  DescendantAt := fun _ parentIncidence parentContent childIncidence childContent =>
    PLift (parentIncidence = childIncidence) × PLift (parentContent = childContent)
  SplitCoverageAt := fun _ _ _ => PEmpty
  MergeCoverageAt := fun _ _ _ => PEmpty
  LocalDischargePreservedAt := fun _ parentContent childContent =>
    PLift (parentContent = childContent)
  RenameAt := fun _ oldContent newContent => PLift (oldContent = newContent)

def contributionCapacitySettlementRestructuringLaw
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex) :
    SourceNativeLedgerRestructuringLaw
      (contributionCapacitySettlementSource oldVisit sourceIndex sourceEvent) where
  vocabulary := contributionCapacitySettlementRestructuringVocabulary oldVisit
  sourceEventAt := fun occurrence =>
    (occurrence.1.1, exactSourceGeneratedLossAllocationMaterialWitness)
  obligationAt := by
    intro current occurrence support entry
    exact contributionCapacityU8ObligationAt oldVisit
      exactSourceGeneratedLossAllocationMaterialWitness
      (⟨entry.1, entry.2⟩ : OpenResponsibilityAt
        (CapacityU8NAt oldVisit) support.1)
  responsibilityKey := AdmittedObligation.content
  anchorKey := fun _ => ()
  incidenceKey := id
  lineageKey := id
  responsibility_commutes := by intros; rfl
  anchor_commutes := by intros; rfl
  incidence_commutes := by intros; rfl
  lineage_commutes := by intros; rfl
  obligationAt_injective := by
    intro current occurrence support left right equality
    exact contributionCapacityU8ObligationAt_injective oldVisit
      exactSourceGeneratedLossAllocationMaterialWitness equality

def contributionCapacitySettlementRestructuringCertification
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex)
    {current : Bool}
    (occurrence :
      (contributionCapacitySettlementSource oldVisit sourceIndex sourceEvent)
        |>.toRootSource.actual.OccurrenceAt current) :
    SourceNativeLedgerRestructuringCertificationAt
      (contributionCapacitySettlementRestructuringLaw oldVisit sourceIndex
        sourceEvent)
      ((contributionCapacitySettlementLedgerCompiler oldVisit sourceIndex
        sourceEvent).compile occurrence) := by
  rcases occurrence with ⟨support, event⟩
  cases event
  · apply ExactLedgerRestructuringCertificationAt.ofInjective
    · intro left right equality
      exact (contributionCapacitySettlementWriteEvolution_origin oldVisit
        sourceIndex sourceEvent
        (contributionCapacitySettlementEmitted oldVisit sourceIndex sourceEvent
          false) left).symm.trans
        (equality.trans
          (contributionCapacitySettlementWriteEvolution_origin oldVisit
            sourceIndex sourceEvent
            (contributionCapacitySettlementEmitted oldVisit sourceIndex
              sourceEvent false) right))
    · intro left right equality
      exact (contributionCapacitySettlementWriteEvolution_destination oldVisit
        sourceIndex sourceEvent
        (contributionCapacitySettlementEmitted oldVisit sourceIndex sourceEvent
          false) left).symm.trans
        (equality.trans
          (contributionCapacitySettlementWriteEvolution_destination oldVisit
            sourceIndex sourceEvent
            (contributionCapacitySettlementEmitted oldVisit sourceIndex
              sourceEvent false) right))
  · exact PUnit.unit

def contributionCapacitySettlementRestructuringCompiler
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex) :
    SourceNativeRestructuringLedgerCompiler
      (contributionCapacitySettlementSource oldVisit sourceIndex sourceEvent) where
  ledgerCompiler := contributionCapacitySettlementLedgerCompiler oldVisit
    sourceIndex sourceEvent
  restructuringLaw := contributionCapacitySettlementRestructuringLaw oldVisit
    sourceIndex sourceEvent
  certifyRestructuring := contributionCapacitySettlementRestructuringCertification
    oldVisit sourceIndex sourceEvent

def contributionCapacitySettlementRestructuringSource
    (oldVisit : OldVisit) (sourceIndex : Nat)
    (sourceEvent : SettlementSourceEventAt oldVisit sourceIndex) :
    SourceNativeRestructuringLedgerSource
      (SettlementNAt oldVisit) (SettlementVAt oldVisit) where
  source := contributionCapacitySettlementSource oldVisit sourceIndex sourceEvent
  compiler := contributionCapacitySettlementRestructuringCompiler oldVisit
    sourceIndex sourceEvent

end
