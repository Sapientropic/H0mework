import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Legislation.ProofCarryingPolicyCoordinate
import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M9.JointRoot.ProofCarryingRenewalInquiryRoot
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M3.ExchangeSettlementPriceRegression
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M8.Relationship.MaintenanceRelationshipFixture

/-!
# M14 same-root common-clearing coordinate

The root-independent symmetric clearing law is now a ninth pre-emitter
coordinate of the literal M9/M13/M14 root.  Its local settlement occurrence
remains definitionally the existing M4 automatic occurrence, while its root
entry, selected row, operational consumer, whole-ledger successor, and PCL
coordination are generated by the same root as UBI and the public mandate.

The controls reject an open nil occurrence, a one-sided fulfillment edge,
the M3 singleton residual activation, and the M8 reverse debt fibre.  None of
those one-sided objects can be retyped as symmetric common clearing.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14ProofCarryingSameRootCommonClearingCoordinateRegression

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Lifecycle Universal Relations Exchange Settlement Renewal Clearing
open Legislation
open Settlement.SourceOwnedSettlementCompiler
open M3FiniteExchangeFixture M3ExchangeSettlementPriceRegression
open M4AutomaticFullFulfillmentRegression
open M8RelationshipMaintenanceFixture
open M9ProofCarryingRenewalInquiryRoot
open M14SourceCommonClearingRenewal

def canonicalClearingFace (leg : exactExchangeSeed.Leg) :
    SourceGeneratedSymmetricClearingAt fulfillmentAuthority exactExchangeSeed
      leg :=
  SourceGeneratedSymmetricClearingAt.generate fulfillmentAuthority
    exactExchangeSeed leg

/-! ## Exact installed coordinate -/

theorem installedCommonClearingExact :
    Nonempty (SourceInstalledRenewalAt commonClearingRecognition jointVisit) ∧
      installedCommonClearing.payload.sourceSeed = commonClearingSeed ∧
      installedCommonClearing.payload.consumer =
        sourceCommonClearingRestriction ∧
      installedCommonClearing.payload.disposition =
        sourceGeneratedCommonClearingDisposition :=
  ⟨⟨installedCommonClearing⟩, rfl, rfl, rfl⟩

theorem localSettlementOccurrenceIsExisting :
    automaticCompiler.occurrenceOfSeed commonClearingSeed =
      automaticOccurrence :=
  commonClearing_occurrence_is_existing

theorem everyLegHasIndependentCounterpartyClearing
    (leg : exactExchangeSeed.Leg) :
    let face := canonicalClearingFace leg
    Nonempty (ExactLegFulfillmentAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed leg) ∧
      Nonempty (ExactLegFulfillmentAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed
          face.counterpartyLeg) ∧
      Nonempty (SourceOwnsResponsibilityIncidence V
        (P.boundarySource face.legConsumer.event)
        (exactExchangeSeed.obligation exchangeCompiler leg)) ∧
      Nonempty (SourceOwnsResponsibilityIncidence V
        (P.boundarySource face.counterpartyConsumer.event)
        (exactExchangeSeed.obligation exchangeCompiler
          face.counterpartyLeg)) ∧
      face.legActor ≠ face.counterpartyActor ∧
      face.legSlotIndex ≠ face.counterpartySlotIndex ∧
      Nonempty (AutomaticFullFulfillment.FulfilledSlotAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed
          face.fullResult.current leg) ∧
      Nonempty (AutomaticFullFulfillment.FulfilledSlotAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed
          face.fullResult.current face.counterpartyLeg) :=
  (canonicalClearingFace leg).two_sides_exact

theorem exhaustiveRunAndTargetAreExisting :
    sourceGeneratedCommonClearingDisposition.fullResult =
        AutomaticFullFulfillment.fullResult fulfillmentAuthority
          exactExchangeSeed ∧
      HEq sourceGeneratedCommonClearingDisposition.fullRun
        automaticWholeRun ∧
      IsEmpty (OpenSettlementAt automaticCompiler automaticOccurrence) := by
  have actionRun :=
    sourceGeneratedCommonClearingDisposition.full_run_is_existing
  have automaticRun : HEq automaticWholeRun
      (AutomaticFullFulfillment.fullResult fulfillmentAuthority
        exactExchangeSeed).run := by
    rfl
  exact ⟨rfl, actionRun.trans automaticRun.symm,
    automaticFullyFulfilled.openSettlement_isEmpty⟩

/-! ## PCL, mandate, and root authority -/

theorem commonClearingPolicyCoordinate :
    SourceInstalledPolicyCoordinateAt installedRenewal
      installedCommonClearing where
  sourceEntry_eq := rfl
  selectedRow_heq := HEq.rfl
  successor_heq := HEq.rfl

theorem mandatePolicyCoordinate :
    SourceInstalledPolicyCoordinateAt installedRenewal installedMandate where
  sourceEntry_eq := rfl
  selectedRow_heq := HEq.rfl
  successor_heq := HEq.rfl

theorem commonClearingAndMandateShareRootAuthority :
    installedCommonClearing.payload.sourceEntry =
        installedMandate.payload.sourceEntry ∧
      HEq installedCommonClearing.payload.selectedRow
        installedMandate.payload.selectedRow ∧
      HEq installedCommonClearing.payload.successor
        installedMandate.payload.successor ∧
      HEq installedCommonClearing.operationalAuthority
        installedMandate.operationalAuthority ∧
      Nonempty (RenewalResponsibilityConsumerAt
        installedCommonClearing.operationalAuthority) ∧
      installedCommonClearing.RootAnswerAndNextFactorizes ∧
      jointAuthoritySource.restructuringSource =
        (RootInquiryU8CompletionRegression.root.toAuthoritativeRoot.source
          ).restructuringSource := by
  exact ⟨commonClearing_shares_mandate_sourceEntry,
    commonClearing_shares_mandate_selectedRow,
    commonClearing_shares_mandate_successor,
    HEq.rfl,
    ⟨installedCommonClearing.rootResponsibilityConsumer⟩,
    commonClearing_root_factorization,
    joint_restructuringSource_is_original⟩

theorem commonClearingCoordinateIsIndependent :
    jointCommonClearingProjection ≠ jointRouteOutageRestorationProjection ∧
      jointCommonClearingProjection ≠
        jointEssentialServiceRestorationProjection ∧
      jointCommonClearingProjection ≠ jointMandateProjection ∧
      jointCommonClearingProjection ≠
        jointRecognitionWitnessProjection ∧
      jointCommonClearingProjection ≠ jointUBIProjection ∧
      jointCommonClearingProjection ≠ jointProofCarryingProjection ∧
      jointCommonClearingProjection ≠ jointInquiryProjection ∧
      jointCommonClearingProjection ≠ jointFailureProjection :=
  commonClearing_projection_distinct_from_existing_coordinates

/-! ## One-sided controls -/

theorem singletonResidualCannotSelectCounterparty :
    ¬ ∃ activation : residualConsumerCompiler.ExactActivationSeed,
      (activation.openSettlement residualConsumerCompiler).leg =
        exactExchangeSeed.counterparty exchangeCompiler .a := by
  rintro ⟨activation, equality⟩
  change Leg.a = Leg.b at equality
  cases equality

theorem reverseMaintenanceDebtCannotBeSymmetric :
    IsEmpty (SelectedMaintenanceDebtFlowAt (legToken .a)
      (counterparty .a) .a) :=
  ⟨reverseMaintenanceDebtFlow_empty .a⟩

theorem strictCommonClearingControls :
    (¬ Nonempty
      (FullyFulfilledExchangeAt nilOpenCompiler nilOpenOccurrence)) ∧
      (∀ leg : exactExchangeSeed.Leg,
        let face := canonicalClearingFace leg
        IsEmpty (AutomaticFullFulfillment.FulfilledSlotAt
          (exchangeLaw := exchangeLaw) exactExchangeSeed
          face.oneSidedEdge.target face.counterpartyLeg)) ∧
      (¬ ∃ activation : residualConsumerCompiler.ExactActivationSeed,
        (activation.openSettlement residualConsumerCompiler).leg =
          exactExchangeSeed.counterparty exchangeCompiler .a) ∧
      IsEmpty (SelectedMaintenanceDebtFlowAt (legToken .a)
        (counterparty .a) .a) :=
  ⟨nilOpenOccurrence_cannot_be_commonClearing,
    fun leg => (canonicalClearingFace leg
      ).oneSided_counterpartyFulfilled_isEmpty,
    singletonResidualCannotSelectCounterparty,
    reverseMaintenanceDebtCannotBeSymmetric⟩

/-! ## Prop-only direct sink -/

structure ProofCarryingSameRootCommonClearingCoordinateCertificate : Prop where
  installedExact :
    Nonempty (SourceInstalledRenewalAt commonClearingRecognition jointVisit) ∧
      installedCommonClearing.payload.sourceSeed = commonClearingSeed ∧
      installedCommonClearing.payload.consumer =
        sourceCommonClearingRestriction ∧
      installedCommonClearing.payload.disposition =
        sourceGeneratedCommonClearingDisposition
  existingSettlementOccurrence :
    automaticCompiler.occurrenceOfSeed commonClearingSeed =
      automaticOccurrence
  everyLeg : ∀ leg : exactExchangeSeed.Leg,
    let face := canonicalClearingFace leg
    Nonempty (ExactLegFulfillmentAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed leg) ∧
      Nonempty (ExactLegFulfillmentAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed
          face.counterpartyLeg) ∧
      Nonempty (SourceOwnsResponsibilityIncidence V
        (P.boundarySource face.legConsumer.event)
        (exactExchangeSeed.obligation exchangeCompiler leg)) ∧
      Nonempty (SourceOwnsResponsibilityIncidence V
        (P.boundarySource face.counterpartyConsumer.event)
        (exactExchangeSeed.obligation exchangeCompiler
          face.counterpartyLeg)) ∧
      face.legActor ≠ face.counterpartyActor ∧
      face.legSlotIndex ≠ face.counterpartySlotIndex ∧
      Nonempty (AutomaticFullFulfillment.FulfilledSlotAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed
          face.fullResult.current leg) ∧
      Nonempty (AutomaticFullFulfillment.FulfilledSlotAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed
          face.fullResult.current face.counterpartyLeg)
  existingRunAndClosedTarget :
    sourceGeneratedCommonClearingDisposition.fullResult =
        AutomaticFullFulfillment.fullResult fulfillmentAuthority
          exactExchangeSeed ∧
      HEq sourceGeneratedCommonClearingDisposition.fullRun
        automaticWholeRun ∧
      IsEmpty (OpenSettlementAt automaticCompiler automaticOccurrence)
  pclCoordinate : SourceInstalledPolicyCoordinateAt installedRenewal
    installedCommonClearing
  mandateCoordinate : SourceInstalledPolicyCoordinateAt installedRenewal
    installedMandate
  sameRootAuthority :
    installedCommonClearing.payload.sourceEntry =
        installedMandate.payload.sourceEntry ∧
      HEq installedCommonClearing.payload.selectedRow
        installedMandate.payload.selectedRow ∧
      HEq installedCommonClearing.payload.successor
        installedMandate.payload.successor ∧
      HEq installedCommonClearing.operationalAuthority
        installedMandate.operationalAuthority ∧
      Nonempty (RenewalResponsibilityConsumerAt
        installedCommonClearing.operationalAuthority) ∧
      installedCommonClearing.RootAnswerAndNextFactorizes ∧
      jointAuthoritySource.restructuringSource =
        (RootInquiryU8CompletionRegression.root.toAuthoritativeRoot.source
          ).restructuringSource
  independentAuthority :
    jointCommonClearingProjection ≠ jointRouteOutageRestorationProjection ∧
      jointCommonClearingProjection ≠
        jointEssentialServiceRestorationProjection ∧
      jointCommonClearingProjection ≠ jointMandateProjection ∧
      jointCommonClearingProjection ≠
        jointRecognitionWitnessProjection ∧
      jointCommonClearingProjection ≠ jointUBIProjection ∧
      jointCommonClearingProjection ≠ jointProofCarryingProjection ∧
      jointCommonClearingProjection ≠ jointInquiryProjection ∧
      jointCommonClearingProjection ≠ jointFailureProjection
  controls :
    (¬ Nonempty
      (FullyFulfilledExchangeAt nilOpenCompiler nilOpenOccurrence)) ∧
      (∀ leg : exactExchangeSeed.Leg,
        let face := canonicalClearingFace leg
        IsEmpty (AutomaticFullFulfillment.FulfilledSlotAt
          (exchangeLaw := exchangeLaw) exactExchangeSeed
          face.oneSidedEdge.target face.counterpartyLeg)) ∧
      (¬ ∃ activation : residualConsumerCompiler.ExactActivationSeed,
        (activation.openSettlement residualConsumerCompiler).leg =
          exactExchangeSeed.counterparty exchangeCompiler .a) ∧
      IsEmpty (SelectedMaintenanceDebtFlowAt (legToken .a)
        (counterparty .a) .a)

theorem proofCarryingSameRootCommonClearingCoordinateDirectConsumer :
    ProofCarryingSameRootCommonClearingCoordinateCertificate where
  installedExact := installedCommonClearingExact
  existingSettlementOccurrence := localSettlementOccurrenceIsExisting
  everyLeg := everyLegHasIndependentCounterpartyClearing
  existingRunAndClosedTarget := exhaustiveRunAndTargetAreExisting
  pclCoordinate := commonClearingPolicyCoordinate
  mandateCoordinate := mandatePolicyCoordinate
  sameRootAuthority := commonClearingAndMandateShareRootAuthority
  independentAuthority := commonClearingCoordinateIsIndependent
  controls := strictCommonClearingControls

end
end M14ProofCarryingSameRootCommonClearingCoordinateRegression
end Society
end ProcessGame
end SaturationMonoid

