import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M9.JointRoot.ProofCarryingRenewalInquiryRuntime

/-!
# Source-generated reopening runtime payment

Every positive current of the action-generated reopening root writes the
actual-service witness generated by that same exact event.  The complete
three-row ledger and the already certified residual carry remain indexed by
the same occurrence.  Runtime depths six, seven and eight are direct
restrictions of these paid root events; no inquiry tick is renamed as a
payment.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceGeneratedContributionCapacityReopeningRuntimePayment

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open ConstructiveRoot.RootInquiryCompletion
open M9ProofCarryingRenewalInquiryRuntime
open M14SourceGeneratedContributionMergeActionSource
open M14SourceGeneratedContributionCapacityReopeningWorld
open M14SourceGeneratedContributionCapacityReopeningCompiler
open M14SourceGeneratedContributionCapacityReopeningResidualCarry
open M14SourceGeneratedContributionCapacityReopeningRoot
open M14SourceGeneratedContributionCapacityReopeningState

abbrev CanonicalReopeningSourceEventAt
    (oldVisit : OldVisit) (sourceIndex : Nat) :=
  M14SourceGeneratedContributionCapacityReopeningState.CanonicalReopeningSourceEventAt
    oldVisit sourceIndex

abbrev CanonicalReopeningRootAt
    (oldVisit : OldVisit) (sourceIndex : Nat) :=
  M14SourceGeneratedContributionCapacityReopeningState.CanonicalReopeningRootAt
    oldVisit sourceIndex

abbrev CanonicalReopeningCompilerAt
    (oldVisit : OldVisit) (sourceIndex : Nat) :=
  contributionCapacityReopeningLedgerCompiler oldVisit sourceIndex
    (CanonicalReopeningSourceEventAt oldVisit sourceIndex)

/-- Positive current `index + 1`; this is the exact current used by the
existing residual-carry carrier. -/
def contributionCapacityReopeningRuntimePaymentCurrentAt
    (oldVisit : OldVisit) (sourceIndex index : Nat) : Nat :=
  show Nat from
    (contributionCapacityReopenedVisitAt oldVisit sourceIndex index).current

@[simp] theorem contributionCapacityReopeningRuntimePaymentCurrentAt_exact
    (oldVisit : OldVisit) (sourceIndex index : Nat) :
    contributionCapacityReopeningRuntimePaymentCurrentAt oldVisit sourceIndex
        index =
      index + 1 := by
  exact contributionCapacityReopeningVisit_current_exact oldVisit sourceIndex
    (index + 1)

def contributionCapacityReopeningRuntimePaymentRootEventAt
    (oldVisit : OldVisit) (sourceIndex index : Nat) :
    ExactTemporalCausalRootEventAt
      (CanonicalReopeningRootAt oldVisit sourceIndex).toAuthoritativeRoot.toLedgerRoot
      (contributionCapacityReopenedVisitAt oldVisit sourceIndex index) :=
  (CanonicalReopeningRootAt oldVisit sourceIndex).toAuthoritativeRoot.toLedgerRoot
    |>.exactTemporalCausalEventAt
      (contributionCapacityReopenedVisitAt oldVisit sourceIndex index)

@[simp] theorem contributionCapacityReopeningRuntimePaymentRootEvent_occurrence_exact
    (oldVisit : OldVisit) (sourceIndex index : Nat) :
    (contributionCapacityReopeningRuntimePaymentRootEventAt oldVisit sourceIndex
      index).occurrence =
      contributionCapacityReopeningEmitted oldVisit sourceIndex
        (CanonicalReopeningSourceEventAt oldVisit sourceIndex)
        (contributionCapacityReopeningRuntimePaymentCurrentAt oldVisit
          sourceIndex index) :=
  rfl

/-- The write is extracted from the exact event, never reconstructed from a
numerical period or supplied by a caller. -/
def contributionCapacityReopeningRuntimePaymentAt
    (oldVisit : OldVisit) (sourceIndex index : Nat) :
    ContributionCapacityReopeningExactWholeLedgerPaymentAt sourceIndex
      (contributionCapacityReopeningRuntimePaymentCurrentAt oldVisit
        sourceIndex index) :=
  PLift.up
    (contributionCapacityReopeningRuntimePaymentRootEventAt oldVisit sourceIndex
      index).occurrence.2.periodicExitGenerated

def contributionCapacityReopeningRuntimePaymentRowEvolutionAt
    (oldVisit : OldVisit) (sourceIndex index : Nat) (entryIndex : Fin 3) :=
  (contributionCapacityReopeningEvolution oldVisit sourceIndex
    (CanonicalReopeningSourceEventAt oldVisit sourceIndex)
    (contributionCapacityReopeningRuntimePaymentRootEventAt oldVisit sourceIndex
      index).occurrence).destination
      (contributionCapacityReopeningCurrentEntryAt oldVisit
        (contributionCapacityReopeningRuntimePaymentCurrentAt oldVisit
          sourceIndex index) entryIndex) |>.2

theorem contributionCapacityReopeningRuntimePaymentCompiler_nativeWrite_exact
    (oldVisit : OldVisit) (sourceIndex index : Nat) :
    (CanonicalReopeningCompilerAt oldVisit sourceIndex).compile
        (contributionCapacityReopeningRuntimePaymentRootEventAt oldVisit
          sourceIndex index).occurrence =
      .nativeWrite
        (contributionCapacityReopeningRuntimePaymentAt oldVisit sourceIndex
          index) rfl
        (contributionCapacityReopeningEmitted oldVisit sourceIndex
          (CanonicalReopeningSourceEventAt oldVisit sourceIndex)
          (contributionCapacityReopeningRuntimePaymentCurrentAt oldVisit
            sourceIndex index + 1))
        (contributionCapacityReopeningEvolution oldVisit sourceIndex
          (CanonicalReopeningSourceEventAt oldVisit sourceIndex)
          (contributionCapacityReopeningRuntimePaymentRootEventAt oldVisit
            sourceIndex index).occurrence) :=
  rfl

theorem contributionCapacityReopeningRuntimePaymentRootReceipt_nativeWrite_exact
    (oldVisit : OldVisit) (sourceIndex index : Nat) :
    (contributionCapacityReopeningRuntimePaymentRootEventAt oldVisit sourceIndex
      index).wholeLedgerWriteBack =
      (CanonicalReopeningCompilerAt oldVisit sourceIndex).compile
        (contributionCapacityReopeningRuntimePaymentRootEventAt oldVisit
          sourceIndex index).occurrence :=
  rfl

/-- All three live rows are disposed by the same event that generated the
payment write. -/
theorem contributionCapacityReopeningRuntimePayment_everyRow_evolved
    (oldVisit : OldVisit) (sourceIndex index : Nat) (entryIndex : Fin 3) :
    (contributionCapacityReopeningRuntimePaymentRootEventAt oldVisit sourceIndex
      index).wholeLedgerWriteBack.entryDisposition
        (contributionCapacityReopeningCurrentEntryAt oldVisit
          (contributionCapacityReopeningRuntimePaymentCurrentAt oldVisit
            sourceIndex index) entryIndex) =
      .evolved
        (contributionCapacityReopeningRuntimePaymentRowEvolutionAt oldVisit
          sourceIndex index entryIndex) := by
  rw [contributionCapacityReopeningRuntimePaymentRootReceipt_nativeWrite_exact]
  rw [contributionCapacityReopeningRuntimePaymentCompiler_nativeWrite_exact]
  rfl

def contributionCapacityReopeningRuntimeResidualCarryAt
    (oldVisit : OldVisit) (sourceIndex index : Nat) :
    SourceGeneratedReopeningResidualCarryAt oldVisit sourceIndex
      (CanonicalReopeningSourceEventAt oldVisit sourceIndex) index :=
  SourceGeneratedReopeningResidualCarryAt.generate oldVisit sourceIndex
    (CanonicalReopeningSourceEventAt oldVisit sourceIndex) index

/-- Strong positive-current payment seal.  The payment and old-residual carry
are generated at one indexed root event; neither claims a strict old-debt
debit. -/
structure SourceGeneratedContributionCapacityReopeningRuntimePaymentAt
    (oldVisit : OldVisit) (sourceIndex index : Nat) : Prop where
  private mk ::
  currentExact :
    contributionCapacityReopeningRuntimePaymentCurrentAt oldVisit sourceIndex
        index =
      index + 1
  rootReceiptNativeWriteExact :
    (contributionCapacityReopeningRuntimePaymentRootEventAt oldVisit sourceIndex
      index).wholeLedgerWriteBack =
      (CanonicalReopeningCompilerAt oldVisit sourceIndex).compile
        (contributionCapacityReopeningRuntimePaymentRootEventAt oldVisit
          sourceIndex index).occurrence
  compilerNativeWriteExact :
    (CanonicalReopeningCompilerAt oldVisit sourceIndex).compile
        (contributionCapacityReopeningRuntimePaymentRootEventAt oldVisit
          sourceIndex index).occurrence =
      .nativeWrite
        (contributionCapacityReopeningRuntimePaymentAt oldVisit sourceIndex
          index) rfl
        (contributionCapacityReopeningEmitted oldVisit sourceIndex
          (CanonicalReopeningSourceEventAt oldVisit sourceIndex)
          (contributionCapacityReopeningRuntimePaymentCurrentAt oldVisit
            sourceIndex index + 1))
        (contributionCapacityReopeningEvolution oldVisit sourceIndex
          (CanonicalReopeningSourceEventAt oldVisit sourceIndex)
          (contributionCapacityReopeningRuntimePaymentRootEventAt oldVisit
            sourceIndex index).occurrence)
  everyRowEvolved : ∀ entryIndex : Fin 3,
    (contributionCapacityReopeningRuntimePaymentRootEventAt oldVisit sourceIndex
      index).wholeLedgerWriteBack.entryDisposition
        (contributionCapacityReopeningCurrentEntryAt oldVisit
          (contributionCapacityReopeningRuntimePaymentCurrentAt oldVisit
            sourceIndex index) entryIndex) =
      .evolved
        (contributionCapacityReopeningRuntimePaymentRowEvolutionAt oldVisit
          sourceIndex index entryIndex)
  residualCarry : Nonempty
    (SourceGeneratedReopeningResidualCarryAt oldVisit sourceIndex
      (CanonicalReopeningSourceEventAt oldVisit sourceIndex) index)

theorem sourceGeneratedContributionCapacityReopeningRuntimePaymentAt
    (oldVisit : OldVisit) (sourceIndex index : Nat) :
    SourceGeneratedContributionCapacityReopeningRuntimePaymentAt oldVisit
      sourceIndex index where
  currentExact :=
    contributionCapacityReopeningRuntimePaymentCurrentAt_exact oldVisit
      sourceIndex index
  rootReceiptNativeWriteExact :=
    contributionCapacityReopeningRuntimePaymentRootReceipt_nativeWrite_exact
      oldVisit sourceIndex index
  compilerNativeWriteExact :=
    contributionCapacityReopeningRuntimePaymentCompiler_nativeWrite_exact
      oldVisit sourceIndex index
  everyRowEvolved :=
    contributionCapacityReopeningRuntimePayment_everyRow_evolved oldVisit
      sourceIndex index
  residualCarry :=
    ⟨contributionCapacityReopeningRuntimeResidualCarryAt oldVisit sourceIndex
      index⟩

@[simp] theorem canonicalRuntimeDepthSix_reopeningPaymentRootEvent_exact :
    seventhTick.receipt.1 =
      contributionCapacityReopeningRuntimePaymentRootEventAt canonicalOldVisit
        1 0 :=
  rfl

@[simp] theorem canonicalRuntimeDepthSeven_reopeningPaymentRootEvent_exact :
    eighthTick.receipt.1 =
      contributionCapacityReopeningRuntimePaymentRootEventAt canonicalOldVisit
        1 1 :=
  rfl

@[simp] theorem canonicalRuntimeDepthEight_reopeningPaymentRootEvent_exact :
    ninthTick.receipt.1 =
      contributionCapacityReopeningRuntimePaymentRootEventAt canonicalOldVisit
        1 2 :=
  rfl

theorem contributionCapacityReopeningRuntimePayment_hasNoNextOrTarget
    (oldVisit : OldVisit) (sourceIndex index : Nat) : True := by
  let payment := contributionCapacityReopeningRuntimePaymentAt oldVisit
    sourceIndex index
  fail_if_success exact payment.next
  fail_if_success exact payment.target
  fail_if_success exact payment.future
  trivial

end
end M14SourceGeneratedContributionCapacityReopeningRuntimePayment
end Society
end ProcessGame
end SaturationMonoid

