/-- The whole-sink certificate for the finite bootstrap followed by the
unbounded family of finite heterogeneous append stages.  `depth` belongs only
to the already-established health checkpoint; cross recurrence itself is
universally quantified and source-generated. -/
structure RootControlledCriticalEventSelectionCrossCompilerRecurrenceAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) : Type 15 where
  private mk ::
  healthCheckpoint :
    RootControlledCriticalEventSelectionU8TenureHealthAppendAt initial depth
  platformRuntime : type_of% runtime_platformAppend_directConsumer
  finiteQueueExhausted : IsEmpty RecurrentQueueCriticalActionSuccessorAt
  homogeneousBootstrap :
    type_of% relationLineageBootstrapRuntime_directConsumer
  everyCrossActionResumed : ∀ recurrenceDepth : Nat,
    SourceNativeInquiryRuntime.SequentialActualActionResumptionAt
      (generatedCrossCompilerRelationAppendActionAt recurrenceDepth) runtime
        (crossActionRuntimeDepth recurrenceDepth)
  everyCrossRuntimeReceipt : ∀ recurrenceDepth : Nat,
    type_of% (crossCompilerRuntime_directConsumer recurrenceDepth)
  everyInheritedUBI : ∀ recurrenceDepth : Nat,
    type_of% (crossCompilerUBI_directConsumer recurrenceDepth)
  everyP98P99CalculationTrace : ∀ recurrenceDepth : Nat,
    type_of% (crossCompilerP98P99_directConsumer recurrenceDepth)
  periodThreeSeedP98DistinctOccurrence : ∀ recurrenceDepth : Nat,
    type_of% (periodThreeSeed_doesNotCollapseP98Occurrence recurrenceDepth)
  everyActualRelationCycleResidual : ∀ cycleBase : Nat,
    type_of% (actualRelationThreeCycleResidual_directConsumer cycleBase)
  everyActualRelationCycleReflexiveMemory : ∀ cycleBase : Nat,
    type_of% (actualRelationCycleReflexiveMemoryCore_directConsumer cycleBase)
  everyActualRelationCycleMemoryKernelEscape : ∀ cycleBase : Nat,
    type_of% (actualRelationCycleMemoryKernelEscape_directConsumer cycleBase)
  cycleOnlyP133P179NoGo :
    type_of% sourceGeneratedCycleOnlyP133P179NoGo_directConsumer
  everyActualRelationPrincipalHolonomy : ∀ cycleBase : Nat,
    type_of% (actualRelationPrincipalHolonomy_directConsumer cycleBase)
  cycleMemoryPlatformGateActualPaidU8Update :
    ProofCarryingCycleMemoryPlatformGateActualPaidU8UpdateAt
      oldVisit sourceIndex boundary
  platformGateAdmissionMaterialObligation :
    ProofCarryingPlatformGateAdmissionMaterialObligationAt oldVisit
      sourceIndex boundary
  platformGateFullAdmission :
    ProofCarryingPlatformGateFullAdmissionAt oldVisit sourceIndex boundary
  platformGateCofinalFiniteLawDiagonal :
    ProofCarryingPlatformGateCofinalFiniteLawDiagonalAt initial
  canonicalSocietyLawFinalRuntimeOpen :
    ProofCarryingCanonicalSocietyLawFinalRuntimeOpenAt initial
  canonicalSocietyFivefoldConstitution :
    ProofCarryingCanonicalSocietyFivefoldConstitutionAt initial
  canonicalSocietyUniversalGrammarTotality :
    ProofCarryingCanonicalSocietyUniversalGrammarTotalityAt
      canonicalSocietyFivefoldConstitution
  canonicalSocietyUniversalFailurePaidSelfU8 :
    ProofCarryingCanonicalSocietyUniversalFailurePaidSelfU8TotalityAt
      canonicalSocietyFivefoldConstitution
  canonicalSocietyUniversalActualPaymentNext :
    ProofCarryingCanonicalSocietyUniversalActualPaymentNextTotalityAt
      canonicalSocietyFivefoldConstitution
  cofinalRepresentationBreakingSelfU8 : ∀ representationBoundary : Nat,
    Nonempty
      (ConsumedCofinalRepresentationBreakingSelfU8At oldVisit sourceIndex
        representationBoundary)
  oldOnlyReconstructionEmpty : ∀ recurrenceDepth : Nat,
    type_of%
      (crossCompilerCurrentStageAt_oldOnlyReconstruction_isEmpty recurrenceDepth)
  callerTargetSeedReplacementEmpty : ∀ recurrenceDepth : Nat,
    type_of%
      (crossCompilerCurrentStageAt_callerTargetSeedReplacement_isEmpty
        recurrenceDepth)
  noDormantHomogeneousSibling :
    type_of% noDormantHomogeneousRelationActionOne

def sourceGeneratedRootControlledCriticalEventSelectionCrossCompilerRecurrenceAt
