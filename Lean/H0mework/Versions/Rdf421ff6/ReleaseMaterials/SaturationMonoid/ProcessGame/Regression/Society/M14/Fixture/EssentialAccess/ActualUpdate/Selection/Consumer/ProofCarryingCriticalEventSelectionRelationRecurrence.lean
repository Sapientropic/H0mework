  cofinalRepresentationBreakingSelfU8 :=
    cofinalRepresentationBreakingAndSelfU8 oldVisit sourceIndex
  oldOnlyReconstructionEmpty :=
    crossCompilerCurrentStageAt_oldOnlyReconstruction_isEmpty
  callerTargetSeedReplacementEmpty :=
    crossCompilerCurrentStageAt_callerTargetSeedReplacement_isEmpty
