theorem cycle_rootControlledCriticalEventSelectionCrossCompilerRecurrence
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    Nonempty
      (RootControlledCriticalEventSelectionCrossCompilerRecurrenceAt
        initial depth) :=
  ⟨sourceGeneratedRootControlledCriticalEventSelectionCrossCompilerRecurrenceAt
    initial depth⟩

theorem rootControlledRecurrence_pairIntentReflexiveSelfU8OpenRuntime
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat)
    (representationBoundary : Nat) :
    Nonempty
        (ConsumedCofinalRepresentationBreakingSelfU8At oldVisit sourceIndex
          representationBoundary) ∧
      Nonempty
        (type_of%
          (M14ProofCarryingContributionCapacityRepresentationPairIntentSelfU8.representationIntentReflexiveSelfU8
            oldVisit sourceIndex representationBoundary)) ∧
      type_of%
        (M14ProofCarryingContributionCapacityRepresentationPairIntentSelfU8.representationIntentReflexiveSelfU8_sameOccurrence
          oldVisit sourceIndex representationBoundary) ∧
      type_of%
        (M14SourceGeneratedContributionCapacityRepresentationPairIntentU8Runtime.representationIntentU8Runtime_allFiniteGeneratedContinuation
          oldVisit sourceIndex representationBoundary) := by
  dsimp
  let recurrence :=
    sourceGeneratedRootControlledCriticalEventSelectionCrossCompilerRecurrenceAt
      initial depth
  rcases recurrence.cofinalRepresentationBreakingSelfU8 representationBoundary
    with ⟨consumed⟩
  exact
    ⟨⟨consumed⟩,
      consumed.2.pairIntentReflexiveSelfU8,
      consumed.2.pairIntentSelfU8SameOccurrence,
      consumed.2.pairIntentAllFiniteGeneratedContinuation⟩

/-- Direct consumer exposing the semantic maximum: one registered bootstrap,
then every finite heterogeneous action in the same runtime, together with its
whole-write receipt, inherited UBI restriction, path-sensitive occurrence,
and the three impossibility faces preventing rechart or a dormant sibling. -/
theorem rootControlledCriticalEventSelectionCrossCompilerRecurrence_directConsumer
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    Nonempty
        (RootControlledCriticalEventSelectionCrossCompilerRecurrenceAt
          initial depth) ∧
      IsEmpty RecurrentQueueCriticalActionSuccessorAt ∧
      SourceNativeInquiryRuntime.SequentialActualActionResumptionAt
        (stageAt 0).generatedAction runtime 7 ∧
      (∀ recurrenceDepth : Nat,
        SourceNativeInquiryRuntime.SequentialActualActionResumptionAt
          (generatedCrossCompilerRelationAppendActionAt recurrenceDepth) runtime
            (9 + 2 * recurrenceDepth)) ∧
      (∀ recurrenceDepth : Nat,
        type_of% (crossCompilerRuntime_directConsumer recurrenceDepth)) ∧
      (∀ recurrenceDepth : Nat,
        HEq (crossCompilerUBIPayloadAt recurrenceDepth).consumer
          sourceGeneratedUBIRootRestriction) ∧
      (∀ recurrenceDepth : Nat,
        type_of% (crossCompilerP98P99_directConsumer recurrenceDepth)) ∧
      (∀ recurrenceDepth : Nat,
        type_of%
          (periodThreeSeed_doesNotCollapseP98Occurrence recurrenceDepth)) ∧
      (∀ cycleBase : Nat,
        type_of% (actualRelationThreeCycleResidual_directConsumer cycleBase)) ∧
      (∀ cycleBase : Nat,
        type_of%
          (actualRelationCycleReflexiveMemoryCore_directConsumer cycleBase)) ∧
      (∀ cycleBase : Nat,
        type_of% (actualRelationCycleMemoryKernelEscape_directConsumer cycleBase)) ∧
      type_of% sourceGeneratedCycleOnlyP133P179NoGo_directConsumer ∧
      (∀ cycleBase : Nat,
        type_of% (actualRelationPrincipalHolonomy_directConsumer cycleBase)) ∧
      ProofCarryingCycleMemoryPlatformGateActualPaidU8UpdateAt
        oldVisit sourceIndex boundary ∧
      ProofCarryingPlatformGateAdmissionMaterialObligationAt oldVisit
        sourceIndex boundary ∧
      Nonempty (ProofCarryingPlatformGateFullAdmissionAt oldVisit sourceIndex
        boundary) ∧
      ProofCarryingPlatformGateCofinalFiniteLawDiagonalAt initial ∧
      ProofCarryingCanonicalSocietyLawFinalRuntimeOpenAt initial ∧
      Nonempty (ProofCarryingCanonicalSocietyFivefoldConstitutionAt initial) ∧
      ProofCarryingCanonicalSocietyUniversalGrammarTotalityAt
        (proofCarryingCanonicalSocietyFivefoldConstitution initial) ∧
      ProofCarryingCanonicalSocietyUniversalFailurePaidSelfU8TotalityAt
        (proofCarryingCanonicalSocietyFivefoldConstitution initial) ∧
      ProofCarryingCanonicalSocietyUniversalActualPaymentNextTotalityAt
        (proofCarryingCanonicalSocietyFivefoldConstitution initial) ∧
      (∀ representationBoundary : Nat,
        Nonempty
          (ConsumedCofinalRepresentationBreakingSelfU8At oldVisit sourceIndex
            representationBoundary)) ∧
      (∀ recurrenceDepth : Nat,
        type_of%
          (crossCompilerCurrentStageAt_oldOnlyReconstruction_isEmpty
            recurrenceDepth)) ∧
      (∀ recurrenceDepth : Nat,
        type_of%
          (crossCompilerCurrentStageAt_callerTargetSeedReplacement_isEmpty
            recurrenceDepth)) ∧
      IsEmpty { index : Fin 1 // index.val = 1 } := by
  refine ⟨cycle_rootControlledCriticalEventSelectionCrossCompilerRecurrence
      initial depth,
    recurrentQueueCriticalActionSuccessor_isEmpty,
    relationActionRuntimeResumption 0, ?_,
    crossCompilerRuntime_directConsumer,
    crossCompilerUBIPayloadConsumer_exact,
    crossCompilerP98P99_directConsumer,
    periodThreeSeed_doesNotCollapseP98Occurrence,
    actualRelationThreeCycleResidual_directConsumer,
    actualRelationCycleReflexiveMemoryCore_directConsumer,
    actualRelationCycleMemoryKernelEscape_directConsumer,
    sourceGeneratedCycleOnlyP133P179NoGo_directConsumer,
    actualRelationPrincipalHolonomy_directConsumer,
    proofCarryingCycleMemoryPlatformGateActualPaidU8Update oldVisit sourceIndex
      boundary,
    proofCarryingPlatformGateAdmissionMaterialObligation oldVisit sourceIndex
      boundary,
    ⟨proofCarryingPlatformGateFullAdmission oldVisit sourceIndex boundary⟩,
    proofCarryingPlatformGateCofinalFiniteLawDiagonal initial,
    proofCarryingCanonicalSocietyLawFinalRuntimeOpen initial,
    ⟨proofCarryingCanonicalSocietyFivefoldConstitution initial⟩,
    proofCarryingCanonicalSocietyUniversalGrammarTotality
      (proofCarryingCanonicalSocietyFivefoldConstitution initial),
    proofCarryingCanonicalSocietyUniversalFailurePaidSelfU8Totality
      (proofCarryingCanonicalSocietyFivefoldConstitution initial),
    proofCarryingCanonicalSocietyUniversalActualPaymentNextTotality
      (proofCarryingCanonicalSocietyFivefoldConstitution initial),
    cofinalRepresentationBreakingAndSelfU8 oldVisit sourceIndex,
    crossCompilerCurrentStageAt_oldOnlyReconstruction_isEmpty,
    crossCompilerCurrentStageAt_callerTargetSeedReplacement_isEmpty,
    noDormantHomogeneousRelationActionOne⟩
  intro recurrenceDepth
  simpa using crossActionRuntimeResumption recurrenceDepth

universe uMemoryPresentation uMemoryPresentationOne uMemoryPresentationTwo

/-- P45 remains universe-polymorphic downstream of the same whole-runtime
certificate; no presentation carrier is stored in the runtime record. -/
theorem rootControlledCriticalEventSelectionMemoryPresentation_unique
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (healthDepth cycleBase : Nat)
    (index : ThreeCycleTime)
    {O : Type uMemoryPresentation}
    (presentation : ReflexiveMemoryPresentation
      ((ActualRelationRoleRingAt cycleBase).edgeReflexiveQuery index) O) :
    Nonempty
        (RootControlledCriticalEventSelectionCrossCompilerRecurrenceAt
          initial healthDepth) ∧
      type_of% (actualRelationRoleMemoryPresentation_unique_support
        cycleBase index presentation) :=
  ⟨cycle_rootControlledCriticalEventSelectionCrossCompilerRecurrence
      initial healthDepth,
    actualRelationRoleMemoryPresentation_unique_support
      cycleBase index presentation⟩

theorem rootControlledCriticalEventSelectionMemoryPresentations_equivalent
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (healthDepth cycleBase : Nat)
    (index : ThreeCycleTime)
    {O₁ : Type uMemoryPresentationOne}
    {O₂ : Type uMemoryPresentationTwo}
    (first : ReflexiveMemoryPresentation
      ((ActualRelationRoleRingAt cycleBase).edgeReflexiveQuery index) O₁)
    (second : ReflexiveMemoryPresentation
      ((ActualRelationRoleRingAt cycleBase).edgeReflexiveQuery index) O₂) :
    Nonempty
        (RootControlledCriticalEventSelectionCrossCompilerRecurrenceAt
          initial healthDepth) ∧
      type_of% (actualRelationRoleMemoryPresentations_equivalent
        cycleBase index first second) :=
  ⟨cycle_rootControlledCriticalEventSelectionCrossCompilerRecurrence
      initial healthDepth,
    actualRelationRoleMemoryPresentations_equivalent
      cycleBase index first second⟩

/-- A universe-polymorphic downstream observer may calculate the exact trace,
but P102/P116 force its linear difference cochain to be exact and hence not a
nontrivial H¹ authority. -/
theorem rootControlledCriticalEventSelectionCrossCompilerLinearObservationNoGo
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary)
    (healthDepth recurrenceDepth : Nat)
    {A : Type*} [AddCommGroup A]
    (observer : AnyAuthoritativeRootCurrent → A) :
    Nonempty
        (RootControlledCriticalEventSelectionCrossCompilerRecurrenceAt
          initial healthDepth) ∧
      type_of%
        (crossCompilerLinearObservationExactness_directConsumer
          observer recurrenceDepth) :=
  ⟨cycle_rootControlledCriticalEventSelectionCrossCompilerRecurrence
      initial healthDepth,
    crossCompilerLinearObservationExactness_directConsumer
      observer recurrenceDepth⟩

