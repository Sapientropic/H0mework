      initial depth
  platformRuntime := runtime_platformAppend_directConsumer
  finiteQueueExhausted := recurrentQueueCriticalActionSuccessor_isEmpty
  homogeneousBootstrap := relationLineageBootstrapRuntime_directConsumer
  everyCrossActionResumed := crossActionRuntimeResumption
  everyCrossRuntimeReceipt := crossCompilerRuntime_directConsumer
  everyInheritedUBI := crossCompilerUBI_directConsumer
  everyP98P99CalculationTrace := crossCompilerP98P99_directConsumer
  periodThreeSeedP98DistinctOccurrence :=
    periodThreeSeed_doesNotCollapseP98Occurrence
  everyActualRelationCycleResidual :=
    actualRelationThreeCycleResidual_directConsumer
  everyActualRelationCycleReflexiveMemory :=
    actualRelationCycleReflexiveMemoryCore_directConsumer
  everyActualRelationCycleMemoryKernelEscape :=
    actualRelationCycleMemoryKernelEscape_directConsumer
  cycleOnlyP133P179NoGo :=
    sourceGeneratedCycleOnlyP133P179NoGo_directConsumer
  everyActualRelationPrincipalHolonomy :=
    actualRelationPrincipalHolonomy_directConsumer
  cycleMemoryPlatformGateActualPaidU8Update :=
    proofCarryingCycleMemoryPlatformGateActualPaidU8Update oldVisit
      sourceIndex boundary
  platformGateAdmissionMaterialObligation :=
    proofCarryingPlatformGateAdmissionMaterialObligation oldVisit sourceIndex
      boundary
  platformGateFullAdmission :=
    proofCarryingPlatformGateFullAdmission oldVisit sourceIndex boundary
  platformGateCofinalFiniteLawDiagonal :=
    proofCarryingPlatformGateCofinalFiniteLawDiagonal initial
  canonicalSocietyLawFinalRuntimeOpen :=
    proofCarryingCanonicalSocietyLawFinalRuntimeOpen initial
  canonicalSocietyFivefoldConstitution :=
    proofCarryingCanonicalSocietyFivefoldConstitution initial
  canonicalSocietyUniversalGrammarTotality :=
    proofCarryingCanonicalSocietyUniversalGrammarTotality
      (proofCarryingCanonicalSocietyFivefoldConstitution initial)
  canonicalSocietyUniversalFailurePaidSelfU8 :=
    proofCarryingCanonicalSocietyUniversalFailurePaidSelfU8Totality
      (proofCarryingCanonicalSocietyFivefoldConstitution initial)
  canonicalSocietyUniversalActualPaymentNext :=
