import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Root.Economy.Probability.ActualRepairFailureCountingMeasure
import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Root.Economy.Identification.FullDomainRepairAuthorityObstruction
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Probability.Kernel.NormalizedFiniteObserverKernelFold

/-!
# M14 actual repair-failure observer probability

The canonical paired actual-failure trace is counted directly, without
retyping an M14 occurrence as an M11 crossing.  Its strongest current coarse
visible coordinate combines the exact root occurrence with the existing
full-domain reachability observation.  Source-native repair remains the
authority coordinate.

At every depth the actual tenure and route occurrences share this visible
image but retain different repair authority.  A normalized finite observer
fold is generated from the prefix through that depth.  Probability is a
derived readout of the counting measure, never a submitted field or an
authority decoder.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14ActualRepairFailureObserverKernelFold

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open UBI Policy
open Observer
open Probability Measure Kernel
open M14TenureCaptureRouteRepairNoGoRegression
open M14UBIPeriodicRootHistory
open M14ActualRepairFailureOccurrence
open M14FiniteActualRepairFailureTrace
open M14ActualRepairFailureCountingMeasure
open M14FullDomainReachabilityCollision

/-- Strongest current coarse visible value: exact temporal root plus the full
domain capacity/reachability mask. -/
abbrev ActualRepairFailureVisible :=
  AnyActualRepairFailure.AnyExactRootOccurrence ×
    FullDomainReachabilityObservation

local instance actualRepairFailureVisibleDecidableEq :
    DecidableEq ActualRepairFailureVisible :=
  Classical.decEq _

/-- Coarse observer over the already generated actual carrier.  Neither
coordinate is a caller label. -/
def actualRepairFailureObserver :
    AuthorityObserver AnyActualRepairFailure
      ActualRepairFailureVisible ExactExitRepair where
  forget := fun occurrence =>
    (occurrence.erasedRootOccurrence,
      fullDomainReachabilityObservationAt
        occurrence.depth occurrence.origin)
  authorityK := fun occurrence => occurrence.actual.repair

/-- The event is generated by the installed repair authority itself. -/
def removeCaptureEvent (occurrence : AnyActualRepairFailure) : Prop :=
  occurrence.actual.repair = .removeCapture

instance removeCaptureEventDecidable :
    DecidablePred removeCaptureEvent :=
  fun occurrence => inferInstanceAs
    (Decidable (occurrence.actual.repair = ExactExitRepair.removeCapture))

@[simp] theorem tenure_removeCaptureEvent (depth : Nat) :
    removeCaptureEvent (tenureRepairFailureOccurrenceAt depth) := by
  rfl

@[simp] theorem route_not_removeCaptureEvent (depth : Nat) :
    ¬ removeCaptureEvent (routeRepairFailureOccurrenceAt depth) := by
  intro impossible
  change ExactExitRepair.restoreRoute =
    ExactExitRepair.removeCapture at impossible
  cases impossible

/-- Although the event is stated on installed repair authority, the existing
source compiler makes it exactly the tenure-capture failure-kind event.  This
rules out a second submitted event label. -/
theorem removeCaptureEvent_iff_tenureFailureKind
    (occurrence : AnyActualRepairFailure) :
    removeCaptureEvent occurrence ↔
      occurrence.failureKind = ExactExitFailureKind.tenureCapture := by
  rcases occurrence with ⟨depth, origin, actual⟩
  cases origin <;> simp [removeCaptureEvent,
    AnyActualRepairFailure.failureKind,
    AnyActualRepairFailure.origin,
    AnyActualRepairFailure.actual,
    ActualRepairFailureAt.repair,
    RepairFailureOriginAt.failureKind]

theorem canonical_actual_pair_visible_equal (depth : Nat) :
    actualRepairFailureObserver.forget
        (tenureRepairFailureOccurrenceAt depth) =
      actualRepairFailureObserver.forget
        (routeRepairFailureOccurrenceAt depth) := by
  apply Prod.ext
  · exact sameDepth_tenure_route_rootOccurrence_equal depth
  · exact canonical_full_observations_equal depth

theorem canonical_actual_pair_authority_distinct (depth : Nat) :
    actualRepairFailureObserver.authorityK
        (tenureRepairFailureOccurrenceAt depth) ≠
      actualRepairFailureObserver.authorityK
        (routeRepairFailureOccurrenceAt depth) := by
  change ExactExitRepair.removeCapture ≠ ExactExitRepair.restoreRoute
  decide

theorem canonical_actual_pair_occurrences_distinct (depth : Nat) :
    tenureRepairFailureOccurrenceAt depth ≠
      routeRepairFailureOccurrenceAt depth := by
  intro equality
  have kindEquality :=
    congrArg AnyActualRepairFailure.failureKind equality
  cases kindEquality

/-- Actual kernel pair generated from the two existing branch occurrences at
one depth. -/
def actualRepairFailureKernelPairAt (depth : Nat) :
    AuthorityKernelPair actualRepairFailureObserver where
  left := tenureRepairFailureOccurrenceAt depth
  right := routeRepairFailureOccurrenceAt depth
  occurrence_ne := canonical_actual_pair_occurrences_distinct depth
  visible_eq := canonical_actual_pair_visible_equal depth
  authority_ne := canonical_actual_pair_authority_distinct depth

/-- Horizon-only normalized fold over the exact requested actual prefix. -/
def sourceGeneratedActualRepairFailureKernelFoldForHorizon (horizon : Nat) :
    NormalizedFiniteObserverKernelFoldAt
      (actualRepairFailureCountingMeasure horizon)
      actualRepairFailureObserver removeCaptureEvent :=
  NormalizedFiniteObserverKernelFoldAt.generate
    (actualRepairFailureCountingMeasure horizon)
    actualRepairFailureObserver removeCaptureEvent

/-- Depth-only fold whose canonical prefix includes both actual occurrences at
that depth. -/
def sourceGeneratedActualRepairFailureKernelFoldAt (depth : Nat) :
    NormalizedFiniteObserverKernelFoldAt
      (actualRepairFailureCountingMeasure (depth + 1))
      actualRepairFailureObserver removeCaptureEvent :=
  sourceGeneratedActualRepairFailureKernelFoldForHorizon (depth + 1)

def visibleAt (depth : Nat) : ActualRepairFailureVisible :=
  actualRepairFailureObserver.forget
    (tenureRepairFailureOccurrenceAt depth)

theorem tenure_visible_eq_visibleAt_iff (index depth : Nat) :
    actualRepairFailureObserver.forget
        (tenureRepairFailureOccurrenceAt index) = visibleAt depth ↔
      index = depth := by
  constructor
  · intro equality
    have rootEquality := congrArg Prod.fst equality
    have visitEquality := congrArg Sigma.fst rootEquality
    exact temporalVisitAt_injective visitEquality
  · rintro rfl
    rfl

theorem route_visible_eq_visibleAt_iff (index depth : Nat) :
    actualRepairFailureObserver.forget
        (routeRepairFailureOccurrenceAt index) = visibleAt depth ↔
      index = depth := by
  constructor
  · intro equality
    have rootEquality := congrArg Prod.fst equality
    have visitEquality := congrArg Sigma.fst rootEquality
    exact temporalVisitAt_injective visitEquality
  · rintro rfl
    exact (canonical_actual_pair_visible_equal _).symm

private theorem range_succ_filter_eq_last (depth : Nat) :
    (List.range (depth + 1)).filter (fun index => index = depth) =
      [depth] := by
  rw [show depth + 1 = depth.succ by omega, List.range_succ,
    List.filter_append]
  have prefixEmpty :
      (List.range depth).filter (fun index => index = depth) = [] := by
    apply List.filter_eq_nil_iff.mpr
    intro index membership
    simpa using Nat.ne_of_lt (List.mem_range.mp membership)
  rw [prefixEmpty]
  simp

theorem sourceGeneratedFold_fibre_exact (depth : Nat) :
    let fold := sourceGeneratedActualRepairFailureKernelFoldAt depth
    fold.fibre (visibleAt depth) =
      [tenureRepairFailureOccurrenceAt depth,
        routeRepairFailureOccurrenceAt depth] := by
  dsimp only
  unfold NormalizedFiniteObserverKernelFoldAt.fibre
  rw [countingMeasure_occurrenceTrace]
  unfold sourceGeneratedFiniteActualRepairFailureTrace
    finiteActualTenureRepairFailureTrace
    finiteActualRouteRepairFailureTrace
  rw [List.filter_append, List.filter_map, List.filter_map]
  change
    List.map tenureRepairFailureOccurrenceAt
        ((List.range (depth + 1)).filter fun index =>
          actualRepairFailureObserver.forget
              (tenureRepairFailureOccurrenceAt index) = visibleAt depth) ++
      List.map routeRepairFailureOccurrenceAt
        ((List.range (depth + 1)).filter fun index =>
          actualRepairFailureObserver.forget
              (routeRepairFailureOccurrenceAt index) = visibleAt depth) =
      [tenureRepairFailureOccurrenceAt depth,
        routeRepairFailureOccurrenceAt depth]
  simp_rw [tenure_visible_eq_visibleAt_iff,
    route_visible_eq_visibleAt_iff]
  rw [range_succ_filter_eq_last]
  rfl

theorem sourceGeneratedFold_eventFibre_exact (depth : Nat) :
    let fold := sourceGeneratedActualRepairFailureKernelFoldAt depth
    fold.eventFibre (visibleAt depth) =
      [tenureRepairFailureOccurrenceAt depth] := by
  dsimp only
  unfold NormalizedFiniteObserverKernelFoldAt.eventFibre
  rw [countingMeasure_occurrenceTrace]
  unfold sourceGeneratedFiniteActualRepairFailureTrace
    finiteActualTenureRepairFailureTrace
    finiteActualRouteRepairFailureTrace
  rw [List.filter_append, List.filter_map, List.filter_map]
  change
    List.map tenureRepairFailureOccurrenceAt
        ((List.range (depth + 1)).filter fun index =>
          actualRepairFailureObserver.forget
                (tenureRepairFailureOccurrenceAt index) = visibleAt depth ∧
            removeCaptureEvent (tenureRepairFailureOccurrenceAt index)) ++
      List.map routeRepairFailureOccurrenceAt
        ((List.range (depth + 1)).filter fun index =>
          actualRepairFailureObserver.forget
                (routeRepairFailureOccurrenceAt index) = visibleAt depth ∧
            removeCaptureEvent (routeRepairFailureOccurrenceAt index)) =
      [tenureRepairFailureOccurrenceAt depth]
  simp_rw [tenure_removeCaptureEvent, and_true,
    route_not_removeCaptureEvent, and_false,
    tenure_visible_eq_visibleAt_iff]
  rw [range_succ_filter_eq_last]
  simp

theorem sourceGeneratedFold_fibreMass_exact (depth : Nat) :
    let fold := sourceGeneratedActualRepairFailureKernelFoldAt depth
    fold.fibreMass (visibleAt depth) = 2 := by
  dsimp only
  unfold NormalizedFiniteObserverKernelFoldAt.fibreMass
  rw [countingMeasure_eventMass_eq_filtered_length]
  have fibreExact := sourceGeneratedFold_fibre_exact depth
  change
    ((actualRepairFailureCountingMeasure (depth + 1)).occurrenceTrace.filter
      (fun occurrence =>
        actualRepairFailureObserver.forget occurrence = visibleAt depth)) =
      [tenureRepairFailureOccurrenceAt depth,
        routeRepairFailureOccurrenceAt depth] at fibreExact
  rw [fibreExact]
  rfl

theorem sourceGeneratedFold_eventMass_exact (depth : Nat) :
    let fold := sourceGeneratedActualRepairFailureKernelFoldAt depth
    fold.eventMass (visibleAt depth) = 1 := by
  dsimp only
  unfold NormalizedFiniteObserverKernelFoldAt.eventMass
  rw [countingMeasure_eventMass_eq_filtered_length]
  have eventFibreExact := sourceGeneratedFold_eventFibre_exact depth
  change
    ((actualRepairFailureCountingMeasure (depth + 1)).occurrenceTrace.filter
      (fun occurrence =>
        actualRepairFailureObserver.forget occurrence = visibleAt depth ∧
          removeCaptureEvent occurrence)) =
      [tenureRepairFailureOccurrenceAt depth] at eventFibreExact
  rw [eventFibreExact]
  rfl

theorem sourceGeneratedFold_readVisible_exact (depth : Nat) :
    let fold := sourceGeneratedActualRepairFailureKernelFoldAt depth
    fold.readVisible (visibleAt depth) = some (1 / 2 : ℚ≥0) := by
  dsimp only
  let fold := sourceGeneratedActualRepairFailureKernelFoldAt depth
  have positive : 0 < fold.fibreMass (visibleAt depth) := by
    rw [sourceGeneratedFold_fibreMass_exact]
    norm_num
  rw [fold.readVisible_eq_some_ratio positive,
    sourceGeneratedFold_eventMass_exact,
    sourceGeneratedFold_fibreMass_exact]

theorem zeroHorizon_fibre_empty
    (visible : ActualRepairFailureVisible) :
    (sourceGeneratedActualRepairFailureKernelFoldForHorizon 0).fibre
        visible = [] := by
  unfold sourceGeneratedActualRepairFailureKernelFoldForHorizon
    NormalizedFiniteObserverKernelFoldAt.fibre
  rw [countingMeasure_zero_occurrenceTrace]
  rfl

theorem zeroHorizon_readVisible_none
    (visible : ActualRepairFailureVisible) :
    (sourceGeneratedActualRepairFailureKernelFoldForHorizon 0).readVisible
        visible = none :=
  (sourceGeneratedActualRepairFailureKernelFoldForHorizon 0)
    |>.empty_fibre_readVisible_none (zeroHorizon_fibre_empty visible)

theorem sourceGeneratedFold_pair_probability_equal (depth : Nat) :
    let fold := sourceGeneratedActualRepairFailureKernelFoldAt depth
    fold.probabilityReadout.read
        (tenureRepairFailureOccurrenceAt depth) =
      fold.probabilityReadout.read
        (routeRepairFailureOccurrenceAt depth) :=
  (sourceGeneratedActualRepairFailureKernelFoldAt depth)
    |>.kernelPair_equivalence (actualRepairFailureKernelPairAt depth)

theorem sourceGeneratedFold_probability_not_authority_complete
    (depth : Nat) :
    let fold := sourceGeneratedActualRepairFailureKernelFoldAt depth
    ¬ Nonempty
      (AuthorityCompleteReadoutAt actualRepairFailureObserver
        fold.probabilityReadout) :=
  (sourceGeneratedActualRepairFailureKernelFoldAt depth)
    |>.noAuthorityCompleteProbability
      (actualRepairFailureKernelPairAt depth)

/-- Strongest pointwise probability theorem: the exact same-root actual pair
is the full retained fibre, the installed remove-capture event occupies one
of its two occurrences, the derived probability is one half, and that
visible probability still cannot recover repair authority. -/
theorem actualRepairFailure_normalized_probability_exact (depth : Nat) :
    let fold := sourceGeneratedActualRepairFailureKernelFoldAt depth
    fold.fibre (visibleAt depth) =
        [tenureRepairFailureOccurrenceAt depth,
          routeRepairFailureOccurrenceAt depth] ∧
      fold.eventFibre (visibleAt depth) =
        [tenureRepairFailureOccurrenceAt depth] ∧
      fold.fibreMass (visibleAt depth) = 2 ∧
      fold.eventMass (visibleAt depth) = 1 ∧
      fold.readVisible (visibleAt depth) = some (1 / 2 : ℚ≥0) ∧
      fold.probabilityReadout.read
          (tenureRepairFailureOccurrenceAt depth) =
        fold.probabilityReadout.read
          (routeRepairFailureOccurrenceAt depth) ∧
      ¬ Nonempty
        (AuthorityCompleteReadoutAt actualRepairFailureObserver
          fold.probabilityReadout) :=
  ⟨sourceGeneratedFold_fibre_exact depth,
    sourceGeneratedFold_eventFibre_exact depth,
    sourceGeneratedFold_fibreMass_exact depth,
    sourceGeneratedFold_eventMass_exact depth,
    sourceGeneratedFold_readVisible_exact depth,
    sourceGeneratedFold_pair_probability_equal depth,
    sourceGeneratedFold_probability_not_authority_complete depth⟩

theorem actualRepairFailureProbability_mouth_has_no_submitted_authority
    (depth : Nat) : True := by
  let fold := sourceGeneratedActualRepairFailureKernelFoldAt depth
  fail_if_success exact fold.submittedVisible
  fail_if_success exact fold.submittedEvent
  fail_if_success exact fold.submittedWeights
  fail_if_success exact fold.submittedSupport
  fail_if_success exact fold.submittedProbability
  fail_if_success exact fold.normalizer
  fail_if_success exact fold.authorityDecoder
  fail_if_success exact fold.occurrenceRegistry
  fail_if_success exact fold.completedFuture
  trivial

end
end M14ActualRepairFailureObserverKernelFold
