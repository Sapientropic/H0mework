theorem platformGateRegisteredNewOnlyEntry_hasNoOldPreimage
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    IsEmpty
      (Sigma fun oldEntry : OpenResponsibilityAt
          M9ProofCarryingRenewalInquiryRoot.N
          (jointRoot.toAuthoritativeRoot.toRoot.supportAt
            (rootedFailureAt oldVisit sourceIndex boundary
              ).oldSuccessor.next) =>
        PLift
          ((canonicalCofaceAt oldVisit sourceIndex boundary
            ).cofaceLedgerRetract.forward oldEntry =
            (platformGateGeneratedTypedRevisionAt oldVisit sourceIndex
              boundary).newOnlyEntry)) :=
  (platformGateGeneratedTypedRevisionAt oldVisit sourceIndex boundary
    ).newOnlyEntry_hasNoOldPreimage

/-- The old observer-submission root cannot be retrofitted with the exact
platform component installation: that installation targets the richer source
born with the additional coordinate. -/
theorem observerSubmissionRoot_rejectsPosthocPlatformInstallation
    (_oldVisit : OldVisit) (_sourceIndex _boundary : Nat) : True := by
  fail_if_success
    exact ({
      law := platformGateRenewalLawAt _oldVisit _sourceIndex _boundary
      installation :=
        platformGateInstallationAt _oldVisit _sourceIndex _boundary
    } : SourceNativeRenewalRecognitionAt
      (augmentedRevisedLivingRootAt _oldVisit _sourceIndex _boundary)
      (localGame _oldVisit _sourceIndex _boundary) PlatformGateSeed
      (PlatformGateSeedAt _oldVisit _sourceIndex _boundary)
      (PlatformGateConsumerAt _oldVisit _sourceIndex _boundary)
      (PlatformGateDispositionAt _oldVisit _sourceIndex _boundary))
  trivial

structure ProofCarryingCycleMemoryPlatformGateActualPaidU8UpdateAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) : Prop where
  priorObserverSubmissionAuthority :
    ProofCarryingPostSettlementObserverSubmissionFinalAuthorityAt
      oldVisit sourceIndex boundary
  cofinalCycleMemoryObstruction :
    type_of% (cycleMemoryPlatformGateObstruction_directConsumer boundary)
  channelRevisionCandidate :
    type_of% (platformChannelRevisionCandidate_directConsumer boundary)
  crossOccurrencePaymentLineage :
    type_of% (platformGatePaymentLineageTransport_directConsumer oldVisit
      sourceIndex boundary)
  exactRightPaymentOccurrence :
    jointRoot.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
        (.finite (oldRootVisitAt oldVisit sourceIndex boundary)) =
      ((rightReplayAt oldVisit sourceIndex boundary).2.futureBirth.actualExit
        ).paymentOccurrence.rootOccurrence
  exactRightPaymentInstallation :
    ((rightReplayAt oldVisit sourceIndex boundary).2.futureBirth.actualExit
      ).paymentOccurrence.installed =
      installedUBIAt (rightCurrentAt oldVisit sourceIndex boundary)
  installedTransportExact :
    (platformGateInstalledRenewalAt oldVisit sourceIndex boundary
      ).payload.consumer =
      platformGateConsumer oldVisit sourceIndex boundary
  installedCandidateExact :
    (platformGateInstalledRenewalAt oldVisit sourceIndex boundary
      ).payload.disposition =
      platformGateDisposition oldVisit sourceIndex boundary
  sourceCompilerOutputExact :
    (platformGateSourceGeneratedCompilationAt oldVisit sourceIndex boundary
      ).output =
      platformGateSourceCompilationAt oldVisit sourceIndex boundary
  sourceCompilerFactorization :
    type_of% (platformGateInstalledCompilation_factorizes oldVisit sourceIndex
      boundary)
  sourceEntryExact :
    (platformGateInstalledRenewalAt oldVisit sourceIndex boundary
      ).payload.sourceEntry =
      (platformGateGeneratedTypedRevisionAt oldVisit sourceIndex boundary
        ).newOnlyEntry
  selectedSourceRowExact : HEq
    (platformGateInstalledRenewalAt oldVisit sourceIndex boundary
      ).payload.selectedRow
    (platformGateGeneratedTypedRevisionAt oldVisit sourceIndex boundary
      ).newOnlyEntryRow.sourceRow
  temporalRowExact : HEq
    (platformGateInstalledRenewalAt oldVisit sourceIndex boundary
      ).temporalSelectedRow
    (platformGateGeneratedTypedRevisionAt oldVisit sourceIndex boundary
      ).newOnlyEntryRow
  successorExact : HEq
    (platformGateInstalledRenewalAt oldVisit sourceIndex boundary
      ).payload.successor
    (platformGateGeneratedFirstSuccessorAt oldVisit sourceIndex boundary)
  priorFirstRowPreserved : HEq
    (platformGateGeneratedTypedRevisionAt oldVisit sourceIndex boundary
      ).newOnlyEntryRow
    (M14SourceGeneratedPostSettlementObserverSubmissionU8.generatedTypedRevisionAt
      oldVisit sourceIndex boundary).newOnlyEntryRow
  priorSuccessorPreserved : HEq
    (platformGateGeneratedFirstSuccessorAt oldVisit sourceIndex boundary)
    (M14SourceGeneratedPostSettlementObserverSubmissionU8.generatedFirstSuccessorAt
      oldVisit sourceIndex boundary)
  inheritedObserverAuthority : Nonempty
    (SourceNativeObserverConsumerRootedAuthorityAt
      (canonicalSubmissionAt oldVisit sourceIndex boundary))
  rootConsumer : Nonempty
    (RenewalResponsibilityConsumerAt
      (platformGateInstalledRenewalAt oldVisit sourceIndex boundary
        ).operationalAuthority)
  rootAnswerAndNext :
    (platformGateInstalledRenewalAt oldVisit sourceIndex boundary
      ).RootAnswerAndNextFactorizes
  attachedFirstWrite : Nonempty
    (SourceGeneratedAttachedCofaceRealizationAt
      (platformGateGeneratedTypedRevisionAt oldVisit sourceIndex boundary))
  runtimeResumption :
    SourceNativeInquiryRuntime.CofaceRealizationResumptionAt
      (platformGateU8CoreAt oldVisit sourceIndex boundary)
      (platformGateRuntimeAt oldVisit sourceIndex boundary) 0
  runtimeInstallation :
    SourceNativeInquiryRuntime.CofaceRealizationInstalledAt
      (platformGateFailureFrontierAt oldVisit sourceIndex boundary)
      (platformGateRealizationCandidateAt oldVisit sourceIndex boundary)
      (platformGateRuntimeAt oldVisit sourceIndex boundary) 0
  runtimeNextExact :
    ((platformGateRuntimeAt oldVisit sourceIndex boundary).stateAt 1
      ).engine.node.erase =
      (platformGateFirstTickAt oldVisit sourceIndex boundary).next.node.erase
  oldCarrierPlatformFibreEmpty :
    IsEmpty (ExistingPaidEssentialAccessChannelRepresentationAt
      (exactEssentialAccessSeed .platform))
  registeredNewOnlyEntryNoOldPreimage :
    IsEmpty
      (Sigma fun oldEntry : OpenResponsibilityAt
          M9ProofCarryingRenewalInquiryRoot.N
          (jointRoot.toAuthoritativeRoot.toRoot.supportAt
            (rootedFailureAt oldVisit sourceIndex boundary
              ).oldSuccessor.next) =>
        PLift
          ((canonicalCofaceAt oldVisit sourceIndex boundary
            ).cofaceLedgerRetract.forward oldEntry =
            (platformGateGeneratedTypedRevisionAt oldVisit sourceIndex
              boundary).newOnlyEntry))

theorem proofCarryingCycleMemoryPlatformGateActualPaidU8Update
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    ProofCarryingCycleMemoryPlatformGateActualPaidU8UpdateAt
      oldVisit sourceIndex boundary where
  priorObserverSubmissionAuthority :=
    proofCarryingPostSettlementObserverSubmissionFinalAuthority oldVisit
      sourceIndex boundary
  cofinalCycleMemoryObstruction :=
    cycleMemoryPlatformGateObstruction_directConsumer boundary
  channelRevisionCandidate :=
    platformChannelRevisionCandidate_directConsumer boundary
  crossOccurrencePaymentLineage :=
    platformGatePaymentLineageTransport_directConsumer oldVisit sourceIndex
      boundary
  exactRightPaymentOccurrence :=
    platformGateExactProblemOccurrence_isRightPaymentOccurrence oldVisit
      sourceIndex boundary
  exactRightPaymentInstallation :=
    (rootedBridgeAt oldVisit sourceIndex boundary).rightPaymentInstalled_exact
  installedTransportExact :=
    platformGateInstalledPayload_consumer_exact oldVisit sourceIndex boundary
  installedCandidateExact :=
    platformGateInstalledPayload_disposition_exact oldVisit sourceIndex
      boundary
  sourceCompilerOutputExact :=
    platformGateSourceGeneratedOutput_exact oldVisit sourceIndex boundary
  sourceCompilerFactorization :=
    platformGateInstalledCompilation_factorizes oldVisit sourceIndex boundary
  sourceEntryExact :=
    platformGateFace_sourceEntry_eq_newOnlyEntry oldVisit sourceIndex boundary
  selectedSourceRowExact :=
    platformGateFace_selectedRow_heq_generatedNewOnlyRow oldVisit sourceIndex
      boundary
  temporalRowExact := HEq.rfl
  successorExact :=
    platformGateFace_successor_heq_generatedSuccessor oldVisit sourceIndex
      boundary
  priorFirstRowPreserved := HEq.rfl
  priorSuccessorPreserved := HEq.rfl
  inheritedObserverAuthority :=
    inheritedSubmissionPayload_carriesRootedAuthority oldVisit sourceIndex
      boundary
  rootConsumer :=
    ⟨(platformGateInstalledRenewalAt oldVisit sourceIndex boundary
      ).rootResponsibilityConsumer⟩
  rootAnswerAndNext :=
    (platformGateInstalledRenewalAt oldVisit sourceIndex boundary
      ).rootAnswerAndNext_factorizes
  attachedFirstWrite :=
    ⟨(platformGateGeneratedTypedRevisionAt oldVisit sourceIndex boundary
      ).attachedCofaceRealization⟩
  runtimeResumption :=
    platformGateRuntimeConsumesExactCore oldVisit sourceIndex boundary
  runtimeInstallation :=
    platformGateCofaceRealizationInstalled oldVisit sourceIndex boundary
  runtimeNextExact :=
    platformGateFirstTick_next_is_revisedTarget oldVisit sourceIndex boundary
  oldCarrierPlatformFibreEmpty :=
    existingPaidChannel_platformRepresentation_isEmpty
  registeredNewOnlyEntryNoOldPreimage :=
    platformGateRegisteredNewOnlyEntry_hasNoOldPreimage oldVisit sourceIndex
      boundary

theorem platformGateActualPaidU8RuntimeCore_unique
    (oldVisit : OldVisit) (sourceIndex boundary : Nat)
    {Core : Type 11} {candidate : Core}
    (resumed : SourceNativeInquiryRuntime.CofaceRealizationResumptionAt
      candidate (platformGateRuntimeAt oldVisit sourceIndex boundary) 0) :
    HEq candidate (platformGateU8CoreAt oldVisit sourceIndex boundary) :=
  platformGateRuntimeCore_unique oldVisit sourceIndex boundary resumed

