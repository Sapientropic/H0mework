/-- Exact classical current of the local revised visit at one generated
finite depth. -/
def pairIntentClassicalCurrentAt
    (oldVisit : OldVisit) (sourceIndex boundary depth : Nat) : Bool :=
  (representationIntentU8TemporalVisitAt oldVisit sourceIndex boundary
    (depth + 2)).current

theorem pairIntentClassicalCurrentAt_eq_true
    (oldVisit : OldVisit) (sourceIndex boundary depth : Nat) :
    pairIntentClassicalCurrentAt oldVisit sourceIndex boundary depth = true := by
  induction depth with
  | zero => rfl
  | succ depth _inductionHypothesis =>
      unfold pairIntentClassicalCurrentAt
      change
        representationIntentU8NativeTarget
            (representationIntentU8TemporalVisitAt oldVisit sourceIndex boundary
              (depth + 2)).current = true
      cases (representationIntentU8TemporalVisitAt oldVisit sourceIndex boundary
        (depth + 2)).current <;> rfl

/-- Exact authoritative erasure of the same named local runtime state. -/
def pairIntentRuntimeAuthorityAt
    (oldVisit : OldVisit) (sourceIndex boundary depth : Nat) :
    AnyAuthoritativeRootCurrent :=
  ((representationIntentU8Runtime oldVisit sourceIndex boundary).stateAt
    (depth + 1)).engine.node.erase

/-- Source-derived classical/authority pair at one generated depth. -/
def pairIntentClassicalAuthorityPairAt
    (oldVisit : OldVisit) (sourceIndex boundary depth : Nat) :
    Bool × AnyAuthoritativeRootCurrent :=
  (pairIntentClassicalCurrentAt oldVisit sourceIndex boundary depth,
    pairIntentRuntimeAuthorityAt oldVisit sourceIndex boundary depth)

abbrev PairIntentTrueAuthorityFibre :=
  { pair : Bool × AnyAuthoritativeRootCurrent.{0} // pair.1 = true }

def pairIntentTrueAuthorityFibrePointAt
    (oldVisit : OldVisit) (sourceIndex boundary depth : Nat) :
    PairIntentTrueAuthorityFibre :=
  ⟨pairIntentClassicalAuthorityPairAt oldVisit sourceIndex boundary depth,
    pairIntentClassicalCurrentAt_eq_true oldVisit sourceIndex boundary depth⟩

/-- The exact true-current fibre contains an injective copy of all generated
finite runtime depths. -/
theorem pairIntentTrueAuthorityFibrePointAt_injective
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    Function.Injective
      (pairIntentTrueAuthorityFibrePointAt oldVisit sourceIndex boundary) := by
  intro left right equality
  apply representationIntentU8RevisedStates_injective oldVisit sourceIndex
    boundary
  have authorityEquality :=
    congrArg
      (fun point : PairIntentTrueAuthorityFibre => point.1.2)
      equality
  simpa [pairIntentTrueAuthorityFibrePointAt,
    pairIntentClassicalAuthorityPairAt, pairIntentRuntimeAuthorityAt] using
    authorityEquality

/-- A raw Bool reconstructor is genuine inhabited syntax, independently of
every reconstruction failure theorem.  Both branches read already named
runtime states; neither stores a future table. -/
def pairIntentRawReconstructor
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    Bool → AnyAuthoritativeRootCurrent
  | false =>
      ((representationIntentU8Runtime oldVisit sourceIndex boundary).stateAt
        0).engine.node.erase
  | true => pairIntentRuntimeAuthorityAt oldVisit sourceIndex boundary 0

theorem pairIntentRawReconstructor_nonempty
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    Nonempty (Bool → AnyAuthoritativeRootCurrent.{0}) :=
  ⟨pairIntentRawReconstructor oldVisit sourceIndex boundary⟩

/-- Every raw reconstructor misses the exact runtime authority at depth zero
or depth one.  These are the concrete generated revised states `stateAt 1`
and `stateAt 2`. -/
theorem pairIntentRawReconstructor_misses_depthZero_or_one
    (oldVisit : OldVisit) (sourceIndex boundary : Nat)
    (reconstruct : Bool → AnyAuthoritativeRootCurrent) :
    reconstruct
          (pairIntentClassicalCurrentAt oldVisit sourceIndex boundary 0) ≠
        pairIntentRuntimeAuthorityAt oldVisit sourceIndex boundary 0 ∨
      reconstruct
          (pairIntentClassicalCurrentAt oldVisit sourceIndex boundary 1) ≠
        pairIntentRuntimeAuthorityAt oldVisit sourceIndex boundary 1 := by
  by_cases exactZero :
      reconstruct
          (pairIntentClassicalCurrentAt oldVisit sourceIndex boundary 0) =
        pairIntentRuntimeAuthorityAt oldVisit sourceIndex boundary 0
  · right
    intro exactOne
    have exactZeroAtTrue :
        reconstruct true =
          pairIntentRuntimeAuthorityAt oldVisit sourceIndex boundary 0 := by
      simpa [pairIntentClassicalCurrentAt_eq_true] using exactZero
    have exactOneAtTrue :
        reconstruct true =
          pairIntentRuntimeAuthorityAt oldVisit sourceIndex boundary 1 := by
      simpa [pairIntentClassicalCurrentAt_eq_true] using exactOne
    have authorityEquality :
        pairIntentRuntimeAuthorityAt oldVisit sourceIndex boundary 0 =
          pairIntentRuntimeAuthorityAt oldVisit sourceIndex boundary 1 :=
      exactZeroAtTrue.symm.trans exactOneAtTrue
    have depthEquality : (0 : Nat) = 1 :=
      representationIntentU8RevisedStates_injective oldVisit sourceIndex
        boundary (by
          simpa [pairIntentRuntimeAuthorityAt] using authorityEquality)
    omega
  · exact Or.inl exactZero

theorem pairIntentRawReconstructor_cannot_recover_everyDepth
    (oldVisit : OldVisit) (sourceIndex boundary : Nat)
    (reconstruct : Bool → AnyAuthoritativeRootCurrent) :
    ¬ ∀ depth : Nat,
      reconstruct
          (pairIntentClassicalCurrentAt oldVisit sourceIndex boundary depth) =
        pairIntentRuntimeAuthorityAt oldVisit sourceIndex boundary depth := by
  intro exactAtEveryDepth
  rcases pairIntentRawReconstructor_misses_depthZero_or_one oldVisit sourceIndex
      boundary reconstruct with missesZero | missesOne
  · exact missesZero (exactAtEveryDepth 0)
  · exact missesOne (exactAtEveryDepth 1)

/-- A proposed exact factorization through the classical Bool readout.  This
is an ordinary candidate type, not a registry or a failure-defined syntax. -/
structure PairIntentAuthorityFactorizationThroughBoolAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) where
  reconstruct : Bool → AnyAuthoritativeRootCurrent
  commutes : ∀ depth : Nat,
    reconstruct
        (pairIntentClassicalCurrentAt oldVisit sourceIndex boundary depth) =
      pairIntentRuntimeAuthorityAt oldVisit sourceIndex boundary depth

/-- Stronger than failure of a faithful section: no exact authority
factorization through the stationary Bool readout exists. -/
theorem pairIntentAuthorityFactorizationThroughBool_isEmpty
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    IsEmpty
      (PairIntentAuthorityFactorizationThroughBoolAt oldVisit sourceIndex
        boundary) :=
  ⟨fun factorization =>
    pairIntentRawReconstructor_cannot_recover_everyDepth oldVisit sourceIndex
      boundary factorization.reconstruct factorization.commutes⟩

/-- Direct consumer of the infinite classical fibre, every exact generated
next, the inhabited raw language and the reconstruction no-section. -/
theorem pairIntentOpenRuntimeClassicalNoSection_directConsumer
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (∀ depth : Nat,
      pairIntentClassicalCurrentAt oldVisit sourceIndex boundary depth =
        true) ∧
      Function.Injective
        (pairIntentTrueAuthorityFibrePointAt oldVisit sourceIndex boundary) ∧
      (∀ depth : Nat,
        type_of%
          (representationIntentU8EveryRevisedTick_generatesNext oldVisit
            sourceIndex boundary depth)) ∧
      Nonempty (Bool → AnyAuthoritativeRootCurrent.{0}) ∧
      (∀ reconstruct : Bool → AnyAuthoritativeRootCurrent,
        reconstruct
              (pairIntentClassicalCurrentAt oldVisit sourceIndex boundary 0) ≠
            pairIntentRuntimeAuthorityAt oldVisit sourceIndex boundary 0 ∨
          reconstruct
              (pairIntentClassicalCurrentAt oldVisit sourceIndex boundary 1) ≠
            pairIntentRuntimeAuthorityAt oldVisit sourceIndex boundary 1) ∧
      IsEmpty
        (PairIntentAuthorityFactorizationThroughBoolAt oldVisit sourceIndex
          boundary) :=
  ⟨pairIntentClassicalCurrentAt_eq_true oldVisit sourceIndex boundary,
    pairIntentTrueAuthorityFibrePointAt_injective oldVisit sourceIndex
      boundary,
    representationIntentU8EveryRevisedTick_generatesNext oldVisit sourceIndex
      boundary,
    pairIntentRawReconstructor_nonempty oldVisit sourceIndex boundary,
    pairIntentRawReconstructor_misses_depthZero_or_one oldVisit sourceIndex
      boundary,
    pairIntentAuthorityFactorizationThroughBool_isEmpty oldVisit sourceIndex
      boundary⟩

end
