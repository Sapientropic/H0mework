open M14SourceGeneratedContributionCapacityCofinalNoveltyU8Compilation
open M14SourceGeneratedContributionCapacityCofinalNoveltyU8Runtime
open M14ProofCarryingContributionCapacityCofinalNoveltySelfU8
open M14SourceGeneratedPostSettlementObserverSubmissionU8
open M14ProofCarryingUniversalObserverConsumerExhaustionRegression
open UniversalRootGrammar

/-- One source-program occurrence generated from the fixed right replay. -/
inductive SourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislationAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) : Type 31
  | private generated

/-- Sole producer.  Only the three indices selecting the existing replay are
public inputs. -/
def sourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislationAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    SourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislationAt
      oldVisit sourceIndex boundary :=
  .generated

namespace SourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislationAt

variable {oldVisit : OldVisit} {sourceIndex boundary : Nat}
  (transport :
    SourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislationAt
      oldVisit sourceIndex boundary)

include transport

/-- Exact paid replay which generates both endpoints of the span. -/
def replay := by
  cases transport
  exact (rightReplayAt oldVisit sourceIndex boundary).2

/-- Canonical lower submission generated at the post-root endpoint. -/
theorem sourceSubmission :
    SourceGeneratedObserverConsumerSubmissionAt
      (canonicalProgramAt oldVisit sourceIndex boundary)
      (.authorityCertified
        (canonicalCertificateAt oldVisit sourceIndex boundary)) := by
  cases transport
  exact canonicalSubmissionAt oldVisit sourceIndex boundary

/-- External Payment generated by the same replay. -/
def targetPaymentOccurrence :=
  (replay transport).futureBirth.actualExit.paymentOccurrence

/-- Existing responsibility row at the external Payment endpoint. -/
def targetEntry
    (_transport :
      SourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislationAt
        oldVisit sourceIndex boundary) :=
  M9ProofCarryingRenewalU8Failure.entry

/-- Existing temporal authority of that Payment row. -/
def targetEntryAuthority
    (transport :
      SourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislationAt
        oldVisit sourceIndex boundary) :
    SourceNativeLivingTemporalCausalEntryAuthorityAt jointRoot
      (.finite (oldRootVisitAt oldVisit sourceIndex boundary))
      (targetEntry transport) :=
  M9ProofCarryingRenewalU8Failure.authorityAt
    (oldRootVisitAt oldVisit sourceIndex boundary)

/-- Complete external-liability provenance of the target Payment. -/
theorem externalLiability :
    PostSettlementGeneratedExternalLiabilityAt oldVisit sourceIndex
      (rightReplayAt oldVisit sourceIndex boundary).1
      (replay transport).rootEvent
      (replay transport).futureBirth.actualExit := by
  cases transport
  exact (rightReplayAt oldVisit sourceIndex boundary).2.futureBirth
    |>.externalLiability

/-- Existing cofinal revision bridge selected by the same replay boundary. -/
def targetRevisionBridge
    (_transport :
      SourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislationAt
        oldVisit sourceIndex boundary) :=
  M14SourceGeneratedContributionCapacityCofinalNoveltyU8Revision.sourceGeneratedContributionCapacityCofinalNoveltyU8RevisionAt
    (rootedBridgeAt oldVisit sourceIndex boundary)

/-- Existing compilation execution; no core is accepted here. -/
def targetExecution
    (transport :
      SourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislationAt
        oldVisit sourceIndex boundary) :=
  M14SourceGeneratedContributionCapacityCofinalNoveltyU8Compilation.sourceGeneratedContributionCapacityCofinalNoveltyU8CompilationAt
    (targetRevisionBridge transport)

/-- Exact PCL type fixed by the target execution. -/
abbrev TargetLegislationAt
    (transport :
      SourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislationAt
        oldVisit sourceIndex boundary) :=
  ProofCarryingLegislationAt
    (M14SourceGeneratedContributionCapacityCofinalNoveltyU8Runtime.sourceInstalled
      (targetExecution transport))
    (M14SourceGeneratedContributionCapacityCofinalNoveltyU8Runtime.runtime
      (targetExecution transport)) 0
    (M14SourceGeneratedContributionCapacityCofinalNoveltyU8Runtime.runtimeSplice
      (targetExecution transport))

/-- Existing Payment-side proof-carrying legislation. -/
def targetLegislation : TargetLegislationAt transport :=
  M14ProofCarryingContributionCapacityCofinalNoveltySelfU8.legislation
    (targetExecution transport)

/-- Exact independent-consumer type of the target PCL. -/
abbrev TargetLegislationConsumerAt
    (transport :
      SourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislationAt
        oldVisit sourceIndex boundary) :=
  ProofCarryingLegislationConsumerAt (targetLegislation transport)

/-- Independent PCL consumer at the Payment occurrence. -/
def targetConsumer : TargetLegislationConsumerAt transport :=
  (targetLegislation transport).independentConsumer

/-- Automatic revolutionary consumption selected by the named runtime. -/
def targetRevolutionaryConsumption :=
  M14ProofCarryingContributionCapacityCofinalNoveltySelfU8.exactRevolutionaryConsumption
    (targetExecution transport)

/-- Exact reflexive self-U8 seal already generated at the Payment endpoint. -/
def targetSelfU8 :=
  M14ProofCarryingContributionCapacityCofinalNoveltySelfU8.selfU8
    (targetExecution transport)

theorem sourceExactEvent_isReplayPostRootEvent :
    (sourceSubmission transport).exactEvent = (replay transport).rootEvent := by
  cases transport
  exact canonicalSubmission_exactEvent_eq_rightReplayPostRootEvent oldVisit
    sourceIndex boundary

/-- Rooted authority produced independently by the source compiler's actual
branch.  It is not recovered from the target installed disposition. -/
theorem sourceRootedAuthority :
    Nonempty
      (SourceNativeObserverConsumerRootedAuthorityAt
        (sourceSubmission transport)) := by
  cases transport
  exact universalSocietyActualRawAttempt_rootedAuthority_nonempty oldVisit
    sourceIndex (submissionIndexAt oldVisit sourceIndex boundary)

theorem sourceLocalLegislation_isEmpty :
    IsEmpty
      (CanonicalSubmissionLocalLegislationAt oldVisit sourceIndex boundary) := by
  cases transport
  exact canonicalSubmissionLocalLegislation_isEmpty oldVisit sourceIndex
    boundary

/-- The replay-generated span is cross-root.  This is the authoritative
negative against replacing provenance by occurrence equality. -/
theorem sourceTargetOccurrencesDistinct :
    Sum.inl (sourceSubmission transport).exactEvent ≠
      Sum.inr (targetPaymentOccurrence transport).rootOccurrence := by
  rw [sourceExactEvent_isReplayPostRootEvent transport]
  exact (externalLiability transport).crossRootOccurrenceDistinct

theorem targetPaymentRootOccurrenceExact :
    (targetPaymentOccurrence transport).rootOccurrence =
      jointRoot.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
        (.finite (oldRootVisitAt oldVisit sourceIndex boundary)) := by
  cases transport
  exact rightPaymentRootOccurrence_exact oldVisit sourceIndex boundary

/-- The UBI Payment face and the proof-carrying legislation coordinate select
the same existing target row. -/
theorem targetPaymentAndLegislation_shareRow : HEq
    (targetPaymentOccurrence transport).installed.payload.sourceEntry
    (M14SourceGeneratedContributionCapacityCofinalNoveltyU8Runtime.sourceInstalled
      (targetExecution transport)).payload.sourceEntry := by
  cases transport
  exact HEq.rfl

theorem targetLegislationOccurrence_isPaymentOccurrence : HEq
    ((sourceGeneratedRuntimeInquiryCoordinateAt
      (M14SourceGeneratedContributionCapacityCofinalNoveltyU8Runtime.runtime
        (targetExecution transport)) 0
      ).1.state.base.root.toAuthoritativeRoot.toLedgerRoot
        |>.exactTemporalCausalEventAt
          (sourceGeneratedRuntimeInquiryCoordinateAt
            (M14SourceGeneratedContributionCapacityCofinalNoveltyU8Runtime.runtime
              (targetExecution transport)) 0).1.state.base.visit)
    (targetPaymentOccurrence transport).rootOccurrence := by
  cases transport
  exact
    M14ProofCarryingContributionCapacityCofinalNoveltySelfU8.selfU8_sameOccurrenceAsRightPayment
      (targetExecution
        (sourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislationAt
          oldVisit sourceIndex boundary))

theorem targetCore_isAugmentedCore :
    (targetRevolutionaryConsumption transport).1.core =
      generatedU8CoreAt oldVisit sourceIndex boundary := by
  cases transport
  rfl

theorem targetRuntimeConsumesAugmentedCore :
    SourceNativeInquiryRuntime.CofaceRealizationResumptionAt
      (generatedU8CoreAt oldVisit sourceIndex boundary)
      (runtimeAt oldVisit sourceIndex boundary) 0 := by
  cases transport
  exact runtimeConsumesExactCore oldVisit sourceIndex boundary

end SourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislationAt

/-- Illegal collapse of the two endpoints.  It adds only the forbidden
equality and no positive authority data. -/
structure IllegalCollapsedExternalPaymentLegislationAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (transport :
      SourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislationAt
        oldVisit sourceIndex boundary) : Prop where
  collapse :
    Sum.inl
        (SourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislationAt.sourceSubmission
          transport).exactEvent =
      Sum.inr
        (SourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislationAt.targetPaymentOccurrence
          transport).rootOccurrence

theorem illegalCollapsedExternalPaymentLegislation_isEmpty
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (transport :
      SourceGeneratedPostSettlementObserverSubmissionExternalPaymentLegislationAt
        oldVisit sourceIndex boundary) :
    IsEmpty (IllegalCollapsedExternalPaymentLegislationAt transport) :=
  ⟨fun illegal =>
    transport.sourceTargetOccurrencesDistinct illegal.collapse⟩

end
