local instance actionComplete : CompleteSpace BurnolPaAmbientCarrier := by
 apply IsComplete.completeSpace_coe
 exact (evenBurnolClosedFace burnolUnscaledCommonGapRadius).isClosed.isComplete
variable (observation : GeneratedRiemannZeroObservation)
variable (nontrivial : ¬∃ n:Nat,observation.coordinate=-2*(n+1))
variable (half : OriginalKCombCalculation.Half observation) (depth ordinal : Nat)

/-- Only the original input source enters the actual continuous-shell synthesis. -/
def generatedCorrection : BurnolPaAmbientCarrier :=
 sourceVolterraPhysical (burnolDivisionZeroCompletedMellinCoordinate observation half.down)
  (burnolTateReciprocalL2
   (burnolMobiusSourceL2 (PA.actualPa observation nontrivial half depth ordinal)))

theorem generated_correction_integral :
 generatedCorrection observation nontrivial half depth ordinal =
 ∫ u : ℝ in Icc (1/4:ℝ) 4,
  volterraSourceDensity (burnolDivisionZeroCompletedMellinCoordinate observation half.down)
   (burnolTateReciprocalL2
    (burnolMobiusSourceL2 (PA.actualPa observation nontrivial half depth ordinal))) u •
  volterraPhysicalShell (burnolDivisionZeroCompletedMellinCoordinate observation half.down) u := rfl

/-- Physical Pa qualification is generated by the shell integral itself. -/
theorem generated_correction_memPa :
 generatedCorrection observation nontrivial half depth ordinal ∈ burnolCompactCoPoissonClosedRange :=
 sourceVolterraPhysical_mem _ _

/-- Evenness and the complete annulus are supplied by the original Pa source producer. -/
theorem generated_correction_Tate_source :
 burnolTateReciprocalL2
  (burnolMobiusSourceL2 (generatedCorrection observation nontrivial half depth ordinal)) =
 sourceVolterraWindow (burnolDivisionZeroCompletedMellinCoordinate observation half.down)
  (burnolTateReciprocalL2
   (burnolMobiusSourceL2 (PA.actualPa observation nontrivial half depth ordinal))) := by
 exact sourceVolterraPhysical_source
  (burnolDivisionZeroCompletedMellinCoordinate observation half.down)
  (burnolTateReciprocalL2
   (burnolMobiusSourceL2 (PA.actualPa observation nontrivial half depth ordinal)))
  (original_tate_source_even (PA.actualPa observation nontrivial half depth ordinal))
  (sourceAnnulusCut_original_pa
   (PA.actualPa observation nontrivial half depth ordinal)
   (PA.actualPa_mem observation nontrivial half depth ordinal))

theorem generated_correction_original :
 generatedCorrection observation nontrivial half depth ordinal =
 Prior.sourceCorrection observation nontrivial half depth ordinal := by
 rw [source_correction_original]
 exact sourceVolterraPhysical_original_correction
  (burnolDivisionZeroCompletedMellinCoordinate observation half.down)
  (PA.actualPa observation nontrivial half depth ordinal)
  (PA.actualPa_mem observation nontrivial half depth ordinal)

/-- The original whole successor is now produced by the actual source shell integral. -/
theorem actual_whole_successor_from_source :
 D.raw observation nontrivial half depth (ordinal+1) =
 (generatedCorrection observation nontrivial half depth ordinal : BurnolL2) +
 Prior.sourceCoefficient observation nontrivial half depth ordinal •
  (Prior.sourceWholeUnit observation nontrivial half : BurnolL2) +
 P.R observation nontrivial half (PA.invisible (D.raw observation nontrivial half depth ordinal)) := by
 rw [generated_correction_original]
 exact OriginalKDirectRCofinalPaUpdate.actual_whole_source_successor
  observation nontrivial half depth ordinal

/-- This actual source production is consumed before E, so both E feet remain literal. -/
theorem actual_Pa_successor_from_source :
 PA.actualPa observation nontrivial half depth (ordinal+1) =
 generatedCorrection observation nontrivial half depth ordinal +
 Prior.sourceCoefficient observation nontrivial half depth ordinal •
  PA.E (Prior.sourceWholeUnit observation nontrivial half : BurnolL2) +
 PA.E (P.R observation nontrivial half (PA.invisible (D.raw observation nontrivial half depth ordinal))) := by
 rw [generated_correction_original]
 exact Prior.actual_Pa_source_successor observation nontrivial half depth ordinal

/-- The actual whole/Pa/Mobius update is consumed together at the same original ordinal. -/
theorem actual_source_action_step :
 generatedCorrection observation nontrivial half depth ordinal ∈ burnolCompactCoPoissonClosedRange ∧
 D.raw observation nontrivial half depth (ordinal+1) =
  (generatedCorrection observation nontrivial half depth ordinal : BurnolL2) +
  Prior.sourceCoefficient observation nontrivial half depth ordinal •
   (Prior.sourceWholeUnit observation nontrivial half : BurnolL2) +
  P.R observation nontrivial half (PA.invisible (D.raw observation nontrivial half depth ordinal)) ∧
 PA.actualPa observation nontrivial half depth (ordinal+1) =
  generatedCorrection observation nontrivial half depth ordinal +
  Prior.sourceCoefficient observation nontrivial half depth ordinal •
   PA.E (Prior.sourceWholeUnit observation nontrivial half : BurnolL2) +
  PA.E (P.R observation nontrivial half (PA.invisible (D.raw observation nontrivial half depth ordinal))) ∧
 burnolMobiusSourceL2 (PA.actualPa observation nontrivial half depth (ordinal+1)) =
  burnolTateReciprocalL2
   (sourceVolterraWindow (burnolDivisionZeroCompletedMellinCoordinate observation half.down)
    (burnolTateReciprocalL2
     (burnolMobiusSourceL2 (PA.actualPa observation nontrivial half depth ordinal)))) +
  Prior.sourceCoefficient observation nontrivial half depth ordinal •
   burnolMobiusSourceL2 (PA.E (Prior.sourceWholeUnit observation nontrivial half : BurnolL2)) +
  burnolMobiusSourceL2
   (PA.E (P.R observation nontrivial half (PA.invisible (D.raw observation nontrivial half depth ordinal)))) :=
 ⟨generated_correction_memPa observation nontrivial half depth ordinal,
  actual_whole_successor_from_source observation nontrivial half depth ordinal,
  actual_Pa_successor_from_source observation nontrivial half depth ordinal,
  actual_Mobius_source_successor_Volterra observation nontrivial half depth ordinal⟩

end NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.CenteredGram.IntegralGraphJointAction.OriginalKDirectRCofinalMobiusSourceAction
