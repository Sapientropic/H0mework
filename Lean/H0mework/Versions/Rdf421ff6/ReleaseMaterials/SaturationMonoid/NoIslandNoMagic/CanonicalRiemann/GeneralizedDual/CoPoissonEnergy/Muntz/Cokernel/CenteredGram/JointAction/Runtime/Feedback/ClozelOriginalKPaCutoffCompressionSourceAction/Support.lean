/-- Literal support is generated by restriction and the actual zero extension. -/
theorem outside_tail_actual_support (radius : ℝ) (value : BurnolL2) :
 (outsideTailAction radius value : ℝ → ℂ) =ᵐ[volume]
  (symmetricInterval radius)ᶜ.indicator (value : ℝ → ℂ) := by
 have restricted := (ae_restrict_iff' (measurableSet_symmetricInterval radius)).mp
  (LpToLpRestrictCLM_coeFn ℂ (symmetricInterval radius) value)
 filter_upwards [burnolRadiusZeroExtension_coe (burnolRadiusRestriction radius value),restricted,
  Lp.coeFn_sub value (cutoffAction radius value)] with x extension restriction subtract
 change (value-cutoffAction radius value) x = _
 rw [subtract]
 change value x - cutoffAction radius value x = _
 change cutoffAction radius value x = _ at extension
 rw [extension]
 change x ∈ symmetricInterval radius → (burnolRadiusRestriction radius value) x = value x at restriction
 by_cases inside : x ∈ symmetricInterval radius
 · rw [Set.indicator_of_mem inside,restriction inside,Set.indicator_of_notMem (by simpa only [Set.mem_compl_iff,not_not] using inside),sub_self]
 · rw [Set.indicator_of_notMem inside,Set.indicator_of_mem inside,sub_zero]

theorem outside_tail_actual_energy (radius : ℝ) (value : BurnolL2) :
 ‖outsideTailAction radius value‖^2 = ∫ x : ℝ in (symmetricInterval radius)ᶜ, ‖value x‖^2 := by
 rw [burnolL2_norm_sq_eq_integral_norm_sq,←integral_indicator (measurableSet_symmetricInterval radius).compl]
 apply integral_congr_ae
 filter_upwards [outside_tail_actual_support radius value] with x source
 rw [source]
 by_cases inside : x ∈ (symmetricInterval radius)ᶜ
 · rw [Set.indicator_of_mem inside,Set.indicator_of_mem inside]
 · rw [Set.indicator_of_notMem inside,Set.indicator_of_notMem inside,norm_zero,zero_pow (by norm_num : (2:Nat)≠0)]

theorem outside_tail_energy_tendsto (value : BurnolL2) :
 Tendsto (fun N : Nat => ‖outsideTailAction (N+1:ℝ) value‖^2) atTop (𝓝 0) := by
 let regions : Nat → Set ℝ := fun N => (symmetricInterval (N+1:ℝ))ᶜ
 have decreasing : Antitone regions := by
  intro i j order
  apply Set.compl_subset_compl.mpr
  intro x inside
  have le : (i:ℝ)≤j := by exact_mod_cast order
  change -(i+1:ℝ)≤x ∧ x≤(i+1:ℝ) at inside
  change -(j+1:ℝ)≤x ∧ x≤(j+1:ℝ)
  constructor <;> linarith [inside.1,inside.2]
 have exhausts : (⋂ N : Nat, regions N) = ∅ := by
  apply Set.eq_empty_iff_forall_notMem.mpr
  intro x everywhere
  have atBound := Set.mem_iInter.mp everywhere ⌈|x|⌉₊
  have inside : x ∈ symmetricInterval (⌈|x|⌉₊+1:ℝ) := by
   change -((⌈|x|⌉₊:Nat)+1:ℝ)≤x ∧ x≤((⌈|x|⌉₊:Nat)+1:ℝ)
   exact abs_le.mp (by linarith [Nat.le_ceil |x|])
  exact atBound inside
 have source := tendsto_setIntegral_of_antitone
  (fun N : Nat => (measurableSet_symmetricInterval (N+1:ℝ)).compl) decreasing
  (show ∃ N, IntegrableOn (fun x : ℝ => ‖value x‖^2) (regions N) volume from
   ⟨0,(Lp.memLp value).integrable_norm_pow (by norm_num) |>.integrableOn⟩)
 rw [exhausts,setIntegral_empty] at source
 exact source.congr (fun N => (outside_tail_actual_energy (N+1:ℝ) value).symm)

theorem outside_tail_norm_tendsto (value : BurnolL2) :
 Tendsto (fun N : Nat => ‖outsideTailAction (N+1:ℝ) value‖) atTop (𝓝 0) := by
 have source := Real.continuous_sqrt.continuousAt.tendsto.comp (outside_tail_energy_tendsto value)
 convert source using 1
 · funext N; exact (Real.sqrt_sq (norm_nonneg _)).symm
 · exact (congrArg nhds Real.sqrt_zero).symm

