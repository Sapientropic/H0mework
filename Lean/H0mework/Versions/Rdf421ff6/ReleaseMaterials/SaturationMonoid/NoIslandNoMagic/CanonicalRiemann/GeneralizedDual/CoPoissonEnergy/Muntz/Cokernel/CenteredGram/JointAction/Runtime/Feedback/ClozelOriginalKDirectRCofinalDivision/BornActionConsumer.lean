/-- The original receipt's four born branches are evaluated before its whole/next is returned.
The Pa response gap is consumed by its next R action, retaining the complete invisible return. -/
theorem actual_born_division_action (w : ℂ) (wRight : 1/4 < w.re) (wBelow : w.re < 1/2) :
 let read := burnolAmbientCompletedMellinEvaluator
  (burnolDivisionCompletedMellinCoordinate w wRight wBelow)
 read (bornRead observation nontrivial half depth ordinal) =
  (-(1/(observation.coordinate/2+w-(1/2 : ℂ)))) *
   read (D.raw observation nontrivial half depth ordinal) ∧
 read (bornRead observation nontrivial half depth ordinal) =
  read (sourceResponse observation nontrivial half depth ordinal : BurnolL2) +
  read (P.R observation nontrivial half
   (PA.invisible (D.raw observation nontrivial half depth ordinal))) ∧
 read (P.R observation nontrivial half (bornRead observation nontrivial half depth ordinal)) =
  (-(1/(observation.coordinate/2+w-(1/2 : ℂ)))) *
   read (sourceResponse observation nontrivial half depth ordinal : BurnolL2) +
  read (P.R observation nontrivial half (P.R observation nontrivial half
   (PA.invisible (D.raw observation nontrivial half depth ordinal)))) ∧
 BornDivisionFaceAt observation nontrivial half depth ordinal ∧
 type_of% (Parent.RC.original_whole (Parent.D.factory observation nontrivial half)
  (Parent.D.initial observation nontrivial half depth)
  (Parent.D.firstCfg observation nontrivial half depth) rfl (ordinal+1)) ∧
 type_of% (Parent.RC.actual_generated_current (Parent.D.factory observation nontrivial half)
  (Parent.D.initial observation nontrivial half depth)
  (Parent.D.firstCfg observation nontrivial half depth) rfl (ordinal+1)) ∧
 type_of% (OriginalKDirectRCofinalMaterial.actual_successor observation nontrivial half depth ordinal) ∧
 type_of% (OriginalKCombFirstFullSourceDynamics.next_pair observation nontrivial half depth ordinal) := by
 intro read
 apply consume_actual_direct_R observation nontrivial half depth ordinal
 intro request model compiles whole material_increment material_input native_value native_expression
  old_paid_code old_paid_branches old_paid_R receipt_zero born_old_paid successor successor_paid_value
  successor_branches receiver_input receiver_ast native_packet receipt_bound receipt_action receipt_macro_next
  receipt_compiles born_ast decoder born_inventory born_pair_inventory source_word_inventory actual_next_packet
  old_events old_pair_events whole_paid_in_born generated_joint_in_born full_paid_steps source_boundary
  whole_paid_trace actual_inverse actual_effect relation_recovery native_full_trace native_relation_face
  native_relation_in_born root_generated_current rooted_material_source source_gap source_strong raw_successor
  next_pair full_history paid_prefix_stocks paid_prefix native_coordinate_zero root_future
 have calculated := Parent.Full.complete_of_branches observation nontrivial half _ _ successor_branches
 have bornR : bornRead observation nontrivial half depth ordinal =
  P.R observation nontrivial half (D.raw observation nontrivial half depth ordinal) := calculated.2.2.1
 have bornRaw : bornRead observation nontrivial half depth ordinal =
  D.raw observation nontrivial half depth (ordinal+1) := bornR.trans raw_successor.symm
 have bornEquation := (congrArg read bornRaw).trans
  (actual_source_scalar_action_generated observation nontrivial half depth ordinal w wRight wBelow)
 have bornSplit := bornRaw.trans (actual_R_source_split observation nontrivial half depth ordinal)
 have bornReadSplit := (congrArg read bornSplit).trans (map_add read _ _)
 have responseEquation :
  read (P.R observation nontrivial half (sourceResponse observation nontrivial half depth ordinal : BurnolL2)) =
   (-(1/(observation.coordinate/2+w-(1/2 : ℂ)))) *
    read (sourceResponse observation nontrivial half depth ordinal : BurnolL2) := by
  rw [OriginalKCombCofinalRAction.original_R_direct]
  exact Pricing.ambient_R_scalar_action (observation.coordinate/2)
   (parameter_rightQuarter observation half) _
   (source_response_positionGap observation nontrivial half depth ordinal) w wRight wBelow
 have bornNextSplit := congrArg (fun value : BurnolL2 => read (P.R observation nontrivial half value)) bornSplit
 rw [map_add,map_add,responseEquation] at bornNextSplit
 have sameQ := congrArg PA.Q bornRaw
 have bornQ := sameQ.trans (actual_Q_successor observation nontrivial half depth ordinal)
 have bornK := (congrArg (fun value : BurnolPaAmbientCarrier =>
  inner ℂ (K.originalK observation nontrivial half) (value : BurnolL2)) sameQ).trans
   (actual_original_K_read observation nontrivial half depth ordinal)
 have bornFourierK := (congrArg (fun value : BurnolPaAmbientCarrier =>
  inner ℂ (K.originalFourierK observation nontrivial half) (value : BurnolL2)) sameQ).trans
   (actual_original_FourierK_read observation nontrivial half depth ordinal)
 have bornGram := (congrArg (fun value : BurnolPaAmbientCarrier => ‖value‖^2) sameQ).trans
  (actual_Q_complete_gram observation nontrivial half depth ordinal)
 exact ⟨bornEquation,bornReadSplit,bornNextSplit,⟨bornQ,bornK,bornFourierK,bornGram⟩,
  whole,root_generated_current,successor,next_pair⟩

