/-- The source callback, its same actual receipt and whole source fields produce all four raw feet. -/
theorem actual_cofinal_whole_literal_read : type_of%
 (source_whole_literal_read (actualCofinalLiteralCode t factory packet)
  (actualCofinalMotherFactory t factory packet) (actualIncomingBornPacket t factory packet)
  (OriginalKSourceFeedbackContinuationAction.actualNativeTotalRead t factory packet)
