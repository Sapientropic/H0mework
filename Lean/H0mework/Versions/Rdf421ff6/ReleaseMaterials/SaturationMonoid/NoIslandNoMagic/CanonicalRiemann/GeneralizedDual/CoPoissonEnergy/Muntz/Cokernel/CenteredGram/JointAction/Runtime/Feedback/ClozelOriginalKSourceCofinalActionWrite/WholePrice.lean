  (OriginalKSourceFeedbackContinuationAction.actualNativeTotalRead t factory packet)
  OriginalKSourceFeedbackSuccessorAction.sourceSlotNext ()
  (actual_literal_current_environment_action t factory packet)

theorem actual_cofinal_whole_raw_action :
 actualCofinalWholeRaw t factory packet=OriginalKSourceFeedbackSuccessorAction.sourceFeedbackNext
  (actualCofinalInputRaw t factory packet) := by
 unfold actualCofinalWholeRaw
 rw [actual_cofinal_whole_literal_read]
 unfold OriginalKSourceFeedbackSuccessorAction.sourceSlotNext
 exact OriginalKSourceFeedbackSuccessorAction.source_slots_recover_raw _

/-- An independent observer consumes the same whole's complete finite-plus-tail source price. -/
theorem actual_cofinal_whole_raw_fee (test : BurnolQuarterMeanZeroCarrier) :
 let input:=actualCofinalInputRaw t factory packet
 let whole:=actualCofinalWholeRaw t factory packet
 inner ℂ (input.1.1+input.2.1) test=inner ℂ whole.1.1 test+inner ℂ whole.2.1 test ∧
 inner ℂ (input.1.2+input.2.2) test=inner ℂ whole.1.2 test+inner ℂ whole.2.2 test := by
 dsimp only
 rw [actual_cofinal_whole_raw_action]
 have conserved := OriginalKSourceFeedbackSuccessorAction.source_feedback_whole_conserved (actualCofinalInputRaw t factory packet)
 constructor
 · rw [←conserved.1,inner_add_left]
 · rw [←conserved.2,inner_add_left]

/-- The owned analytic tail budget is consumed by the whole reader; payment remains the existing native debt. -/
theorem actual_cofinal_whole_tail_budget :
 ‖(actualCofinalWholeRaw t factory packet).2.1‖≤(1/2:ℝ)*‖(actualCofinalInputRaw t factory packet).2.1‖ ∧
 ‖(actualCofinalWholeRaw t factory packet).2.2‖≤(1/2:ℝ)*‖(actualCofinalInputRaw t factory packet).2.2‖ := by
 rw [actual_cofinal_whole_raw_action]
 constructor
 · exact (le_trans (OriginalKRawDualFeedbackSourceAction.plusFeedback.le_opNorm _)
    (mul_le_mul_of_nonneg_right (OriginalKRawDualFeedbackSourceAction.source_feedback_norm).1 (norm_nonneg _)))
 · exact (le_trans (OriginalKRawDualFeedbackSourceAction.minusFeedback.le_opNorm _)
    (mul_le_mul_of_nonneg_right (OriginalKRawDualFeedbackSourceAction.source_feedback_norm).2 (norm_nonneg _)))

