/-- The source-side outward Volterra is the actual full adjoint, with its original parameter. -/
def sourceStep (c : BurnolCompletedMellinCoordinate) : BurnolL2 →L[ℂ] BurnolL2 :=
  sourceVolterraResolvent (barC c)

def quarterStep (c : BurnolCompletedMellinCoordinate) : Hq →L[ℂ] Hq :=
  burnolQuarterRestriction.comp ((sourceStep c).comp burnolQuarterZeroExtension)

def sourceTail (c : BurnolCompletedMellinCoordinate) : BurnolL2 →L[ℂ] ℂ :=
  burnolRadiusMellinTailEvaluator q (by norm_num) (star c.value)
    (by simpa only [Complex.star_def,Complex.conj_re] using c.rightHalf)

def sourceField (c : BurnolCompletedMellinCoordinate) : Nat → BurnolL2
  | 0 => sourceKernelCombo c
  | j+1 => sourceStep c (sourceField c j)

/-- Divided-log columns are generated by an actual bounded quarter operation; L2 is intrinsic. -/
def dividedLogColumn (c : BurnolCompletedMellinCoordinate) : Nat → Hq
  | 0 => SingularCounting.powerL2 c
  | k+1 => -(1/2:ℂ) • quarterStep c (dividedLogColumn c k)

def sourceConstant (c : BurnolCompletedMellinCoordinate) : Nat → ℂ
  | 0 => burnolQuarterMeanCoefficient (Rq (sourceKernelCombo c))
  | j+1 => 2*sourceConstant c j/(1-star c.value)

def sourceAmplitude (c : BurnolCompletedMellinCoordinate) (j : Nat) : ℂ :=
  -2*(sourceTail c (sourceField c j)+sourceConstant c j*(q:ℂ)^(1-star c.value)/(1-star c.value))

theorem sourceStep_actual (c : BurnolCompletedMellinCoordinate) (value : BurnolL2) :
    (burnolDirectRightResolventCLM c).adjoint value=sourceStep c value := by
  have right : 1/4<(c.value/2).re := by
    rw [Complex.div_re]; norm_num; linarith [c.rightHalf]
  have starRight : 1/4<(star c.value/2).re := by
    rw [Complex.div_re]; norm_num; linarith [c.rightHalf]
  have native : FiniteMobiusResolventFlux.Rplus (star c.value/2) value=sourceStep c value :=
    FiniteMobiusResolventFlux.Rplus_tate (star c.value/2) starRight value
  apply ext_inner_right ℂ
  intro test
  rw [ContinuousLinearMap.adjoint_inner_left]
  change inner ℂ value (burnolDirectRightResolvent (c.value/2) test)=_
  have actual:=OriginalKCompactAdjointRSource.actual_original_R_adjoint (c.value/2) right value test
  simpa only [star_div₀,star_ofNat,native] using actual

theorem sourceField_actual (c : BurnolCompletedMellinCoordinate) (j : Nat) :
    sourceField c j=((burnolDirectRightResolventCLM c)^j).adjoint (sourceKernelCombo c) := by
  induction j with
  | zero => simp [sourceField]
  | succ j ih =>
    rw [sourceField,←sourceStep_actual,ih]
    change _=(star ((burnolDirectRightResolventCLM c)^(j+1))) (sourceKernelCombo c)
    rw [pow_succ,star_mul,mul_apply_eq_comp]
    rfl

theorem sourceField_one (c : BurnolCompletedMellinCoordinate) : sourceField c 1=sourceL c := by
  apply ext_inner_right ℂ
  intro test
  rw [sourceField,sourceField,←sourceStep_actual,ContinuousLinearMap.adjoint_inner_left]
  exact original_R_sourceL_read c test

private theorem source_combo_even (c : BurnolCompletedMellinCoordinate) :
    reflectL2 (sourceKernelCombo c)=sourceKernelCombo c := by
  rw [sourceKernelCombo_actual,map_sub,map_smul,map_smul,
    ←fourierL2_reflectL2_commute,
    mem_evenL2ClosedFace_iff.mp (burnolCompletedMellinRieszVector c).property.2]

theorem sourceField_even (c : BurnolCompletedMellinCoordinate) (j : Nat) :
    reflectL2 (sourceField c j)=sourceField c j := by
  induction j with
  | zero => exact source_combo_even c
  | succ j ih =>
    change reflectL2 (sourceVolterraResolvent (barC c) (sourceField c j))=_
    rw [sourceVolterraResolvent_reflect,ih]
    rfl

private theorem sourceTail_extension_zero (c : BurnolCompletedMellinCoordinate) (state : Hq) :
    sourceTail c (Eq state)=0 := by
  rw [sourceTail,burnolRadiusMellinTailEvaluator_eq_integral]
  apply integral_eq_zero_of_ae
  filter_upwards [ae_restrict_of_ae (burnolRadiusZeroExtension_coe state),ae_restrict_mem measurableSet_Ioi]
    with x raw outside
  have excluded : x∉symmetricInterval q := by
    intro inside
    exact not_le_of_gt outside inside.2
  change burnolQuarterZeroExtension state x=_ at raw
  rw [raw,Set.indicator_of_notMem excluded,mul_zero]
  rfl

private theorem extension_restriction_even (value : BurnolL2) (even : reflectL2 value=value) :
    reflectL2 (Eq (Rq value))=Eq (Rq value) := by
  change reflectL2 (burnolRadiusZeroExtension q (restrictToInterval q value))=_
  rw [burnolRadiusZeroExtension_reflect,←restrictToInterval_reflectL2,even]
  rfl

/-- The whole previous source tail produces the independent power contact in the next quarter step. -/
theorem source_quarter_step (c : BurnolCompletedMellinCoordinate) (value : BurnolL2)
    (even : reflectL2 value=value) :
    Rq (sourceStep c value)=quarterStep c (Rq value)+
      (-2*sourceTail c value) • SingularCounting.powerL2 c := by
  let remainder:=value-Eq (Rq value)
  have gap : Rq remainder=(0:ℂ) • Cq := by
    dsimp only [remainder]
    rw [map_sub,burnolQuarterRestriction_zeroExtension,sub_self,zero_smul]
  have parity : reflectL2 remainder=remainder := by
    dsimp only [remainder]
    rw [map_sub,even,extension_restriction_even value even]
  have actual:=paidConjugateVolterraQuarter c remainder 0 gap parity
  have tail : sourceTail c remainder=sourceTail c value := by
    dsimp only [remainder]
    rw [map_sub,sourceTail_extension_zero,sub_zero]
  change Rq (sourceStep c remainder)=_ at actual
  change sourceTail c remainder=sourceTail c value at tail
  change Rq (sourceStep c remainder)=(2*0/(1-star c.value)) • Cq+
    (-2*(sourceTail c remainder+0*(q:ℂ)^(1-star c.value)/(1-star c.value))) • SingularCounting.powerL2 c at actual
  simp only [mul_zero,zero_div,zero_smul,zero_add,tail] at actual
  dsimp only [remainder] at actual
  rw [map_sub,map_sub] at actual
  change Rq (sourceStep c value)-quarterStep c (Rq value)=_ at actual
  linear_combination (norm := module) actual

/-- The constant column is evaluated by the already generated zero-tail Volterra action. -/
theorem quarterStep_constant (c : BurnolCompletedMellinCoordinate) :
    quarterStep c Cq=(2/(1-star c.value)) • Cq-
      (2*(q:ℂ)^(1-star c.value)/(1-star c.value)) • SingularCounting.powerL2 c := by
  have gap : Rq (Eq Cq)=(1:ℂ) • Cq := by rw [burnolQuarterRestriction_zeroExtension,one_smul]
  have even : reflectL2 (Eq Cq)=Eq Cq := by
    change reflectL2 (burnolRadiusZeroExtension q Cq)=_
    rw [burnolRadiusZeroExtension_reflect,reflectRestricted_intervalConstant]
    rfl
  have actual:=paidConjugateVolterraQuarter c (Eq Cq) 1 gap even
  change quarterStep c Cq=(2*1/(1-star c.value)) • Cq+
    (-2*(sourceTail c (Eq Cq)+1*(q:ℂ)^(1-star c.value)/(1-star c.value))) • SingularCounting.powerL2 c at actual
  rw [sourceTail_extension_zero] at actual
  convert actual using 1
  module

private theorem source_combo_physical (c : BurnolCompletedMellinCoordinate) :
    sourceKernelCombo c∈evenBurnolClosedFace burnolUnscaledCommonGapRadius := by
  rw [sourceKernelCombo_actual]
  exact (evenBurnolClosedFace burnolUnscaledCommonGapRadius).sub_mem
    ((evenBurnolClosedFace burnolUnscaledCommonGapRadius).smul_mem _
      (burnolCompletedMellinRieszVector c).property)
    ((evenBurnolClosedFace burnolUnscaledCommonGapRadius).smul_mem _
      (fourierL2_mem_evenBurnolClosedFace (burnolCompletedMellinRieszVector c).property))

theorem source_initial_quarter (c : BurnolCompletedMellinCoordinate) :
    Rq (sourceField c 0)=sourceConstant c 0 • Cq := by
  have centered:=(burnolQuarterMeanZeroProjection_eq_zero_iff _).mpr
    (source_combo_physical c).1.1
  rw [burnolMeanZeroProjection_eq_sub_constant] at centered
  exact sub_eq_zero.mp centered

/-- The first power contact cancels by the two actual source amplitudes, before any target projection. -/
theorem source_initial_amplitude_zero (c : BurnolCompletedMellinCoordinate) :
    sourceAmplitude c 0=0 := by
  unfold sourceAmplitude sourceTail
  simp only [sourceField,sourceConstant,sourceKernelCombo,map_sub,map_smul,smul_eq_mul,
    hQuarterAmplitude,jQuarterAmplitude,hQuarterGap,jQuarterGap]
  unfold burnolQuarterMeanCoefficient
  simp only [inner_sub_right,inner_smul_right]
  ring

def sourceCoefficient (c : BurnolCompletedMellinCoordinate) : Nat → Nat → ℂ
  | 0,_ => 0
  | j+1,0 => sourceAmplitude c j
  | j+1,k+1 => -2*sourceCoefficient c j k

def finiteQuarterSource (c : BurnolCompletedMellinCoordinate) (j : Nat) : Hq :=
  ∑ k∈Finset.range j,sourceCoefficient c j k • dividedLogColumn c k

def centeredLogColumn (c : BurnolCompletedMellinCoordinate) (k : Nat) : BurnolQuarterMeanZeroCarrier :=
  OriginalRieszSource.Constructor.zeroMean (dividedLogColumn c k)

def finiteBDrive (c : BurnolCompletedMellinCoordinate) (j : Nat) : BurnolQuarterMeanZeroCarrier :=
  ∑ k∈Finset.range j,sourceCoefficient c j k • centeredLogColumn c k

theorem quarterStep_log_column (c : BurnolCompletedMellinCoordinate) (k : Nat) :
    quarterStep c (dividedLogColumn c k)=(-2:ℂ) • dividedLogColumn c (k+1) := by
  rw [dividedLogColumn]
  module

theorem finiteQuarterSource_succ (c : BurnolCompletedMellinCoordinate) (j : Nat) :
    finiteQuarterSource c (j+1)=sourceAmplitude c j • dividedLogColumn c 0+
      quarterStep c (finiteQuarterSource c j) := by
  unfold finiteQuarterSource
  rw [Finset.sum_range_succ']
  simp only [sourceCoefficient,map_sum,map_smul,quarterStep_log_column,smul_smul]
  rw [add_comm]
  congr 1
  apply Finset.sum_congr rfl
  intro k _
  congr 1
  ring

/-- The finite columns are generated from previous full-source tails; no H_j quarter is a constructor input. -/
theorem source_quarter_finite (c : BurnolCompletedMellinCoordinate) (j : Nat) :
    Rq (sourceField c j)=sourceConstant c j • Cq+finiteQuarterSource c j := by
  induction j with
  | zero => simpa only [finiteQuarterSource,Finset.range_zero,Finset.sum_empty,add_zero] using source_initial_quarter c
  | succ j ih =>
    rw [sourceField,source_quarter_step c _ (sourceField_even c j),ih,map_add,map_smul,
      quarterStep_constant,finiteQuarterSource_succ]
    change _=(2*sourceConstant c j/(1-star c.value)) • Cq+
      (sourceAmplitude c j • SingularCounting.powerL2 c+quarterStep c (finiteQuarterSource c j))
    unfold sourceAmplitude
    module

/-- This is the computed finite source input to the original B inverse. -/
theorem source_centered_quarter (c : BurnolCompletedMellinCoordinate) (j : Nat) :
    quarterCotest (sourceField c j)=finiteBDrive c j := by
  change OriginalRieszSource.Constructor.zeroMean (Rq (sourceField c j))=_
  rw [source_quarter_finite,map_add,map_smul,OriginalRieszSource.Constructor.zeroMean_constant,
    smul_zero,zero_add]
  simp only [finiteQuarterSource,finiteBDrive,centeredLogColumn,map_sum,map_smul]

def logBFirst (c : BurnolCompletedMellinCoordinate) (k : Nat) : BurnolQuarterMeanZeroCarrier :=
  burnolMeanZeroBlockInverse (centeredLogColumn c k)

def logBSecond (c : BurnolCompletedMellinCoordinate) (k : Nat) : BurnolQuarterMeanZeroCarrier :=
  -burnolMeanZeroTruncatedFourier (logBFirst c k)

def logOutsideColumn (c : BurnolCompletedMellinCoordinate) (k : Nat) : BurnolL2 :=
  burnolAmbientEvenPart (Eq (logBFirst c k: Hq)+fourierL2 (Eq (logBSecond c k: Hq)))

def sourceOutside (c : BurnolCompletedMellinCoordinate) (j : Nat) : BurnolL2 :=
  ∑ k∈Finset.range j,sourceCoefficient c j k • logOutsideColumn c k

theorem log_B_source (c : BurnolCompletedMellinCoordinate) (k : Nat) :
    logBFirst c k+burnolMeanZeroTruncatedFourier (logBSecond c k)=centeredLogColumn c k ∧
      burnolMeanZeroTruncatedFourier (logBFirst c k)+logBSecond c k=0 := by
  constructor
  · change logBFirst c k+burnolMeanZeroTruncatedFourier (-burnolMeanZeroTruncatedFourier (logBFirst c k))=_
    rw [map_neg,←sub_eq_add_neg]
    change (burnolMeanZeroOneMinusSquare*burnolMeanZeroBlockInverse) (centeredLogColumn c k)=_
    rw [burnolMeanZeroBlockInverse_right]
    rfl
  · exact add_neg_cancel _

theorem zeroth_log_B_is_paid (c : BurnolCompletedMellinCoordinate) :
    logBFirst c 0=hPowerBColumn c ∧ logBSecond c 0=hPowerBSecond c ∧
      logOutsideColumn c 0=hPowerPhysicalCorrection c := by
  exact ⟨rfl,rfl,rfl⟩

theorem sourceStep_fourier_source (c : BurnolCompletedMellinCoordinate) (value : BurnolL2) :
    sourceStep c value=fourierL2 (sourceResolvent c (fourierL2.symm value)) := by
  apply ext_inner_right ℂ
  intro test
  rw [←sourceStep_actual,ContinuousLinearMap.adjoint_inner_left]
  change inner ℂ value (burnolDirectRightResolvent (c.value/2) test)=_
  have actual:=sourceResolvent_actual_adjoint_read c (fourierL2.symm value) test
  rw [fourierL2.apply_symm_apply] at actual
  exact actual.symm

theorem sourceStep_inverseFourier (c : BurnolCompletedMellinCoordinate) (value : BurnolL2) :
    fourierL2.symm (sourceStep c value)=sourceResolvent c (fourierL2.symm value) := by
  rw [sourceStep_fourier_source,fourierL2.symm_apply_apply]

def sourceFourierConstant (c : BurnolCompletedMellinCoordinate) : Nat → ℂ
  | 0 => burnolQuarterMeanCoefficient (Rq (fourierL2.symm (sourceKernelCombo c)))
  | j+1 => -sourceFourierConstant c j/(star c.value/2)

private theorem source_inverseFourier_physical (c : BurnolCompletedMellinCoordinate) :
    fourierL2.symm (sourceKernelCombo c)∈evenBurnolClosedFace burnolUnscaledCommonGapRadius := by
  have same : fourierL2.symm (sourceKernelCombo c)=fourierL2 (sourceKernelCombo c) := by
    apply fourierL2.injective
    rw [fourierL2.apply_symm_apply,fourierL2_fourierL2,source_combo_even]
  rw [same]
  exact fourierL2_mem_evenBurnolClosedFace (source_combo_physical c)

/-- The independent Fourier mean is generated by the actual inward resolvent, at every finite order. -/
theorem source_inverseFourier_quarter (c : BurnolCompletedMellinCoordinate) (j : Nat) :
    Rq (fourierL2.symm (sourceField c j))=sourceFourierConstant c j • Cq := by
  induction j with
  | zero =>
    have centered:=(burnolQuarterMeanZeroProjection_eq_zero_iff _).mpr
      (source_inverseFourier_physical c).1.1
    rw [burnolMeanZeroProjection_eq_sub_constant] at centered
    exact sub_eq_zero.mp centered
  | succ j ih =>
    rw [sourceField,sourceStep_inverseFourier]
    exact OriginalKForcingGapAction.right_resolvent_quarter_constant (star c.value/2)
      (by rw [Complex.div_re]; norm_num; linarith [c.rightHalf])
      (fourierL2.symm (sourceField c j)) (sourceFourierConstant c j) ih

theorem source_fourier_quarter_zero (c : BurnolCompletedMellinCoordinate) (j : Nat) :
    quarterCotest (fourierL2 (sourceField c j))=0 := by
  have same : fourierL2 (sourceField c j)=fourierL2.symm (sourceField c j) := by
    apply fourierL2.injective
    rw [fourierL2_fourierL2,sourceField_even,fourierL2.apply_symm_apply]
  change OriginalRieszSource.Constructor.zeroMean (Rq (fourierL2 (sourceField c j)))=0
  rw [same,source_inverseFourier_quarter,map_smul,OriginalRieszSource.Constructor.zeroMean_constant,smul_zero]

private theorem source_evenPart (c : BurnolCompletedMellinCoordinate) (j : Nat) :
    burnolAmbientEvenPart (sourceField c j)=sourceField c j := by
  unfold burnolAmbientEvenPart
  rw [sourceField_even]
  module

theorem source_B_first (c : BurnolCompletedMellinCoordinate) (j : Nat) :
    burnolAmbientMeanZeroFirstCorrection (sourceField c j)=
      ∑ k∈Finset.range j,sourceCoefficient c j k • logBFirst c k := by
  have position : burnolAmbientMeanZeroPosition (sourceField c j)=finiteBDrive c j := by
    change quarterCotest (burnolAmbientEvenPart (sourceField c j))=_
    rw [source_evenPart,source_centered_quarter]
  have fourier : burnolAmbientMeanZeroFourier (sourceField c j)=0 := by
    change quarterCotest (fourierL2 (burnolAmbientEvenPart (sourceField c j)))=0
    rw [source_evenPart,source_fourier_quarter_zero]
  change burnolMeanZeroBlockInverse
    (burnolAmbientMeanZeroPosition (sourceField c j)-
      burnolMeanZeroTruncatedFourier (burnolAmbientMeanZeroFourier (sourceField c j)))=_
  rw [position,fourier,map_zero,sub_zero]
  simp only [finiteBDrive,map_sum,map_smul,logBFirst]

theorem source_B_second (c : BurnolCompletedMellinCoordinate) (j : Nat) :
    burnolAmbientMeanZeroSecondCorrection (sourceField c j)=
      ∑ k∈Finset.range j,sourceCoefficient c j k • logBSecond c k := by
  have fourier : burnolAmbientMeanZeroFourier (sourceField c j)=0 := by
    change quarterCotest (fourierL2 (burnolAmbientEvenPart (sourceField c j)))=0
    rw [source_evenPart,source_fourier_quarter_zero]
  change burnolAmbientMeanZeroFourier (sourceField c j)-
    burnolMeanZeroTruncatedFourier (burnolAmbientMeanZeroFirstCorrection (sourceField c j))=_
  rw [fourier,source_B_first,zero_sub]
  simp only [map_sum,map_smul,logBSecond,smul_neg,Finset.sum_neg_distrib]

private theorem evenPart_smul (scalar : ℂ) (value : BurnolL2) :
    burnolAmbientEvenPart (scalar • value)=scalar • burnolAmbientEvenPart value := by
  unfold burnolAmbientEvenPart
  rw [map_smul]
  module

private theorem evenPart_sum {ι : Type*} (index : Finset ι) (f : ι → BurnolL2) :
    burnolAmbientEvenPart (∑ i∈index,f i)=∑ i∈index,burnolAmbientEvenPart (f i) := by
  unfold burnolAmbientEvenPart
  rw [map_sum,←Finset.sum_add_distrib,Finset.smul_sum]

/-- The original full B projection is now an explicit finite sum of generated source columns. -/
theorem source_complete_B_correction (c : BurnolCompletedMellinCoordinate) (j : Nat) :
    burnolAmbientEvenMeanZeroCorrection (sourceField c j)=sourceOutside c j := by
  unfold burnolAmbientEvenMeanZeroCorrection burnolAmbientRawMeanZeroCorrection
  rw [source_B_first,source_B_second]
  simp only [Submodule.coe_sum,SetLike.val_smul,map_sum,map_smul]
  rw [←Finset.sum_add_distrib]
  simp_rw [←smul_add]
  rw [evenPart_sum]
  simp only [evenPart_smul,sourceOutside,logOutsideColumn]

def sourcePhysical (c : BurnolCompletedMellinCoordinate) (j : Nat) : BurnolL2 :=
  sourceField c j-sourceOutside c j

theorem source_physical_actual (c : BurnolCompletedMellinCoordinate) (j : Nat) :
    (burnolEvenAmbientProjection (sourceField c j):BurnolL2)=sourcePhysical c j := by
  have projected:=burnolEvenOrthogonalProjectionOnto_eq_resolventFormula (sourceField c j)
  change (burnolEvenAmbientProjection (sourceField c j):BurnolL2)=_ at projected
  rw [projected]
  unfold burnolAmbientExtendedSonineProjectionFormula
  rw [source_evenPart,source_complete_B_correction]
  rfl

theorem source_outside_actual (c : BurnolCompletedMellinCoordinate) (j : Nat) :
    sourceField c j-(burnolEvenAmbientProjection (sourceField c j):BurnolL2)=sourceOutside c j := by
  rw [source_physical_actual,sourcePhysical]
  module

theorem source_outside_orthogonal (c : BurnolCompletedMellinCoordinate) (j : Nat) :
    sourceOutside c j∈(evenBurnolClosedFace burnolUnscaledCommonGapRadius).toSubmoduleᗮ := by
  intro value inside
  rw [←source_outside_actual]
  exact inner_eq_zero_symm.mp
    ((evenBurnolClosedFace burnolUnscaledCommonGapRadius).toSubmodule.starProjection_inner_eq_zero
      (sourceField c j) value inside)

/-- This replaces the opaque whole outside price, retaining every finite column and its complex coefficient. -/
theorem source_outside_price (c : BurnolCompletedMellinCoordinate) (j : Nat) (raw : BurnolL2) :
    inner ℂ (sourceField c j) (raw-(burnolEvenAmbientProjection raw:BurnolL2))=
      ∑ k∈Finset.range j,star (sourceCoefficient c j k)*inner ℂ (logOutsideColumn c k) raw := by
  have selfadjoint := (evenBurnolClosedFace burnolUnscaledCommonGapRadius).toSubmodule.inner_starProjection_left_eq_right
    (sourceField c j) raw
  change inner ℂ (burnolEvenAmbientProjection (sourceField c j):BurnolL2) raw=
    inner ℂ (sourceField c j) (burnolEvenAmbientProjection raw:BurnolL2) at selfadjoint
  rw [inner_sub_right,←selfadjoint,←inner_sub_left,source_outside_actual]
  simp only [sourceOutside,sum_inner,inner_smul_left,starRingEnd_apply]

private theorem extension_tail_band (c : BurnolCompletedMellinCoordinate) (state : Hq)
    (x : ℝ) (positive : 0<x) (small : x≤q) :
    burnolRadiusMellinTailEvaluator x positive (star c.value)
      (by simpa only [Complex.star_def,Complex.conj_re] using c.rightHalf) (Eq state)=
      ∫ t:ℝ in x..q,(t:ℂ)^(-star c.value)*state t := by
  let f:ℝ→ℂ:=fun t=>(t:ℂ)^(-star c.value)*(Eq state) t
  have full:=burnolRadiusMellinWeight_integrableOn_tail x positive (star c.value)
    (by simpa only [Complex.star_def,Complex.conj_re] using c.rightHalf) (Eq state)
  have upper:=burnolRadiusMellinWeight_integrableOn_tail q (by norm_num) (star c.value)
    (by simpa only [Complex.star_def,Complex.conj_re] using c.rightHalf) (Eq state)
  have union : Ioc x q ∪ Ioi q=Ioi x := by
    ext t
    simp only [mem_union,mem_Ioc,mem_Ioi]
    constructor
    · rintro (inside|after)
      · exact inside.1
      · exact small.trans_lt after
    · intro after
      by_cases below:t≤q
      · exact Or.inl ⟨after,below⟩
      · exact Or.inr (lt_of_not_ge below)
  have disjoint : Disjoint (Ioc x q) (Ioi q) := by
    apply Set.disjoint_left.mpr
    intro t first second
    exact not_lt_of_ge first.2 second
  have split : (∫ t in Ioi x,f t)=(∫ t in Ioc x q,f t)+∫ t in Ioi q,f t := by
    rw [←union]
    exact setIntegral_union disjoint measurableSet_Ioi
      (full.mono_set (fun _ inside=>inside.1)) upper
  have tailZero : (∫ t in Ioi q,f t)=0 := by
    simpa only [sourceTail,burnolRadiusMellinTailEvaluator_eq_integral,f] using sourceTail_extension_zero c state
  rw [tailZero,add_zero] at split
  rw [burnolRadiusMellinTailEvaluator_eq_integral]
  change (∫ t in Ioi x,f t)=_
  rw [split,intervalIntegral.integral_of_le small]
  apply integral_congr_ae
  filter_upwards [ae_restrict_of_ae (burnolRadiusZeroExtension_coe state),ae_restrict_mem measurableSet_Ioc]
    with t raw inside
  have belongs : t∈symmetricInterval q := ⟨by linarith [inside.1],inside.2⟩
  dsimp only [f]
  change (Eq state:BurnolL2) t=_ at raw
  rw [raw,Set.indicator_of_mem belongs]

/-- The quarter native operation is evaluated on its actual input representative, without a caller L2 witness. -/
theorem quarterStep_positive_profile (c : BurnolCompletedMellinCoordinate) (state : Hq) :
    ∀ᵐ x:ℝ ∂volume.restrict (symmetricInterval q), ∀ _positive:0<x,
      quarterStep c state x=-2*(x:ℂ)^(star c.value-1)*
        (∫ t:ℝ in x..q,(t:ℂ)^(-star c.value)*state t) := by
  filter_upwards [LpToLpRestrictCLM_coeFn ℂ (symmetricInterval q) (sourceStep c (Eq state)),
    ae_restrict_of_ae (sourceVolterraResolvent_positive_profile (barC c) (Eq state)),
    ae_restrict_mem (measurableSet_symmetricInterval q)] with x restricted profile inside positive
  change quarterStep c state x=sourceStep c (Eq state) x at restricted
  have actual:=profile positive
  change sourceStep c (Eq state) x=-2*(x:ℂ)^(star c.value-1)*
    burnolRadiusMellinTailEvaluator x positive (star c.value)
      (by simpa only [Complex.star_def,Complex.conj_re] using c.rightHalf) (Eq state) at actual
  rw [restricted,actual,extension_tail_band c state x positive inside.2]

private theorem finite_log_primitive_real (k : ℕ) {radius x : ℝ}
    (hx : 0 < x) (hxq : x ≤ radius) :
    (∫ t : ℝ in x..radius, t⁻¹ * Real.log (radius / t) ^ k) =
      Real.log (radius / x) ^ (k + 1) / (k + 1 : ℝ) := by
  have hq : 0 < radius := lt_of_lt_of_le hx hxq
  have hn : (k + 1 : ℝ) ≠ 0 := by positivity
  have ht : ∀ t ∈ uIcc x radius, t ≠ 0 := by
    intro t ht
    rw [uIcc_of_le hxq] at ht
    exact ne_of_gt (lt_of_lt_of_le hx ht.1)
  have hd : ∀ t ∈ uIcc x radius,
      HasDerivAt (fun s : ℝ => -(Real.log (radius / s) ^ (k + 1)) / (k + 1 : ℝ))
        (t⁻¹ * Real.log (radius / t) ^ k) t := by
    intro t htx
    have htn := ht t htx
    have hquot := (hasDerivAt_const t radius).div (hasDerivAt_id t) htn
    have hlog := hquot.log (div_ne_zero (ne_of_gt hq) htn)
    dsimp only [Pi.div_apply, id_eq] at hlog
    convert ((hlog.fun_pow (k + 1)).neg.div_const (k + 1 : ℝ)) using 1 <;>
      first | rfl | (simp only [Nat.add_sub_cancel, Nat.cast_add, Nat.cast_one, zero_mul]
                     field_simp [htn, ne_of_gt hq, hn]; ring)
  have hc : ContinuousOn (fun t : ℝ => t⁻¹ * Real.log (radius / t) ^ k) (uIcc x radius) :=
    (continuousOn_id.inv₀ ht).mul
      (((continuousOn_const.div continuousOn_id ht).log
        (fun t htx => div_ne_zero (ne_of_gt hq) (ht t htx))).pow k)
  have heq := intervalIntegral.integral_eq_sub_of_hasDerivAt hd hc.intervalIntegrable
  simpa only [div_self (ne_of_gt hq), Real.log_one, zero_pow (Nat.succ_ne_zero k),
    neg_zero, zero_div, zero_sub, neg_div, neg_neg] using heq

private theorem finite_log_primitive_complex (k : ℕ) {radius x : ℝ}
    (hx : 0 < x) (hxq : x ≤ radius) :
    (∫ t : ℝ in x..radius,
      (t : ℂ)⁻¹ * ((Real.log (radius / t) : ℂ) ^ k / (k.factorial : ℂ))) =
      (Real.log (radius / x) : ℂ) ^ (k + 1) / ((k + 1).factorial : ℂ) := by
  simp_rw [← mul_div_assoc, ← Complex.ofReal_inv, ← Complex.ofReal_pow,
    ← Complex.ofReal_mul]
  rw [intervalIntegral.integral_div, intervalIntegral.integral_ofReal,
    finite_log_primitive_real k hx hxq, Complex.ofReal_div, Complex.ofReal_pow]
  rw [div_div, Nat.factorial_succ, Nat.cast_mul]
  simp only [Complex.ofReal_add, Complex.ofReal_natCast, Complex.ofReal_one,
    Nat.cast_add, Nat.cast_one]


theorem quarterStep_reflect (c : BurnolCompletedMellinCoordinate) (state : Hq) :
    reflectRestricted q (quarterStep c state)=quarterStep c (reflectRestricted q state) := by
  change reflectRestricted q (restrictToInterval q
    (sourceVolterraResolvent (barC c) (burnolRadiusZeroExtension q state)))=_
  rw [←restrictToInterval_reflectL2,sourceVolterraResolvent_reflect,burnolRadiusZeroExtension_reflect]
  rfl

private theorem initial_power_even (c : BurnolCompletedMellinCoordinate) :
    reflectRestricted q (SingularCounting.powerL2 c)=SingularCounting.powerL2 c := by
  apply Lp.ext
  let reflection:=negMeasurePreserving_restrict q
  filter_upwards [Lp.coeFn_compMeasurePreserving (SingularCounting.powerL2 c) reflection,
    reflection.quasiMeasurePreserving.ae (SingularCounting.power_coeFn c),SingularCounting.power_coeFn c]
    with x reflected negative direct
  change reflectRestricted q (SingularCounting.powerL2 c) x=SingularCounting.powerL2 c (-x) at reflected
  rw [reflected,negative,direct]
  simp only [SingularCounting.powerRaw,abs_neg]

theorem dividedLogColumn_even (c : BurnolCompletedMellinCoordinate) (k : Nat) :
    reflectRestricted q (dividedLogColumn c k)=dividedLogColumn c k := by
  induction k with
  | zero => exact initial_power_even c
  | succ k ih =>
    change reflectRestricted q (-(1/2:ℂ) • quarterStep c (dividedLogColumn c k))=_
    rw [map_smul,quarterStep_reflect,ih]
    rfl

def dividedLogRaw (c : BurnolCompletedMellinCoordinate) (k : Nat) (x : ℝ) : ℂ :=
  SingularCounting.powerRaw c x*(Real.log (q/|x|):ℂ)^k/(k.factorial:ℂ)

private theorem quarter_raw_of_even (value : Hq) (raw : ℝ → ℂ)
    (even : reflectRestricted q value=value) (rawEven : ∀ x,raw (-x)=raw x)
    (positive : ∀ᵐ x:ℝ ∂volume.restrict (symmetricInterval q), ∀ _hx:0<x,value x=raw x) :
    (value:ℝ→ℂ)=ᵐ[volume.restrict (symmetricInterval q)] raw := by
  let reflection:=negMeasurePreserving_restrict q
  have parity:=Lp.coeFn_compMeasurePreserving value reflection
  change (reflectRestricted q value:ℝ→ℂ)=ᵐ[volume.restrict (symmetricInterval q)]
    (value:ℝ→ℂ) ∘ (fun x=>-x) at parity
  rw [even] at parity
  have reverse:=reflection.quasiMeasurePreserving.ae positive
  filter_upwards [positive,reverse,parity,ae_restrict_of_ae (volume.ae_ne (0:ℝ))]
    with x direct backward reflected nonzero
  by_cases pos:0<x
  · exact direct pos
  · have neg:x<0:=lt_of_le_of_ne (le_of_not_gt pos) nonzero
    change value x=value (-x) at reflected
    rw [reflected,backward (by linarith),rawEven]

/-- Each finite native column has its actual divided log-power representative. -/
theorem dividedLogColumn_profile (c : BurnolCompletedMellinCoordinate) (k : Nat) :
    (dividedLogColumn c k:ℝ→ℂ)=ᵐ[volume.restrict (symmetricInterval q)] dividedLogRaw c k := by
  induction k with
  | zero =>
    filter_upwards [SingularCounting.power_coeFn c] with x raw
    simpa only [dividedLogColumn,dividedLogRaw,pow_zero,mul_one,Nat.factorial_zero,Nat.cast_one,div_one] using raw
  | succ k ih =>
    have integralRead (x:ℝ) (pos:0<x) (small:x≤q) :
        (∫ t:ℝ in x..q,(t:ℂ)^(-star c.value)*dividedLogColumn c k t)=
          (Real.log (q/x):ℂ)^(k+1)/((k+1).factorial:ℂ) := by
      calc
        _=(∫ t:ℝ in x..q,(t:ℂ)⁻¹*((Real.log (q/t):ℂ)^k/(k.factorial:ℂ))) := by
          rw [intervalIntegral.integral_of_le small,intervalIntegral.integral_of_le small]
          apply integral_congr_ae
          have global:=(ae_restrict_iff' (measurableSet_symmetricInterval q)).mp ih
          filter_upwards [ae_restrict_of_ae global,ae_restrict_mem measurableSet_Ioc] with t profile inside
          have positive:0<t:=pos.trans inside.1
          have belongs:t∈symmetricInterval q:=⟨by linarith,inside.2⟩
          rw [profile belongs]
          unfold dividedLogRaw SingularCounting.powerRaw
          rw [abs_of_pos positive]
          have power : (t:ℂ)^(-star c.value)*(t:ℂ)^(star c.value-1)=(t:ℂ)⁻¹ := by
            rw [←Complex.cpow_add _ _ (Complex.ofReal_ne_zero.mpr positive.ne'),
              show -star c.value+(star c.value-1)= -1 by ring,Complex.cpow_neg_one]
          calc
            _=((t:ℂ)^(-star c.value)*(t:ℂ)^(star c.value-1))*
                ((Real.log (q/t):ℂ)^k/(k.factorial:ℂ)) := by ring
            _=_ := by rw [power]
        _=_ := finite_log_primitive_complex k pos small
    apply quarter_raw_of_even _ _ (dividedLogColumn_even c (k+1))
      (fun x=>by simp only [dividedLogRaw,SingularCounting.powerRaw,abs_neg])
    filter_upwards [Lp.coeFn_smul (-(1/2:ℂ)) (quarterStep c (dividedLogColumn c k)),
      quarterStep_positive_profile c (dividedLogColumn c k),
      ae_restrict_mem (measurableSet_symmetricInterval q)] with x scalar actual inside positive
    change (-(1/2:ℂ) • quarterStep c (dividedLogColumn c k):Hq) x=_ at scalar
    rw [dividedLogColumn,scalar,Pi.smul_apply,smul_eq_mul,actual positive,integralRead x positive inside.2]
    unfold dividedLogRaw SingularCounting.powerRaw
    rw [abs_of_pos positive]
    ring

