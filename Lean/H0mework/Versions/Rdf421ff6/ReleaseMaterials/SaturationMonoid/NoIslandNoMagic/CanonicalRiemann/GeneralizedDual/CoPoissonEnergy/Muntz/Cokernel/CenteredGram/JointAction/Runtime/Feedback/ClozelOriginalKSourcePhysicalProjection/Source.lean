import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.NoIslandNoMagic.CanonicalRiemann.GeneralizedDual.CoPoissonEnergy.Muntz.Cokernel.CenteredGram.JointAction.Runtime.Feedback.ClozelOriginalKForcingGapAction.FourierGate
import H0mework.Versions.Rdf421ff6.ReleaseMaterials.SaturationMonoid.NoIslandNoMagic.CanonicalRiemann.GeneralizedDual.CoPoissonEnergy.Muntz.Cokernel.CenteredGram.JointAction.Runtime.Feedback.ClozelOriginalKGapProjectionEulerSource.Whole

set_option autoImplicit false
set_option Elab.async false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1000000
noncomputable section
namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.CenteredGram.IntegralGraphJointAction.OriginalKSourcePhysicalProjection
open Complex MeasureTheory Set
open BurnolPhysicalState BurnolPhysicalState.OriginalRieszSource
open OriginalKSourceResolventReconstruction OriginalKSourceGramAction OriginalKForcingGapAction
open OriginalRieszFinitePairing.CoPoisson.Ward
open scoped InnerProductSpace
local notation "q" => (1/4 : ℝ)

abbrev constantResponse := OriginalKGapProjectionEulerSource.actualGapResponse
abbrev constantReturn := burnolMeanZeroTruncatedFourier constantResponse
abbrev constantPhysicalVector := OriginalKGapProjectionEulerSource.actualGapWhole

def constantResponseMean : ℂ :=
  burnolQuarterMeanCoefficient (burnolTruncatedFourier (constantResponse : BurnolQuarterIntervalL2))

def constantReturnMean : ℂ :=
  burnolQuarterMeanCoefficient (burnolTruncatedFourier (constantReturn : BurnolQuarterIntervalL2))

private theorem seed_quarter : burnolQuarterRestriction ConstantDual.seed = intervalConstant q :=
  burnolQuarterRestriction_zeroExtension _

private theorem constantSource_read : OriginalKGapProjectionEulerSource.actualGapSource =
    Constructor.zeroMean (burnolTruncatedFourier (intervalConstant q)) := by
  unfold OriginalKGapProjectionEulerSource.actualGapSource burnolAmbientMeanZeroFourier
  rw [OriginalKGapProjectionEulerSource.actual_seed_even_part]
  rfl

/-- The response is generated by the original B inverse from the fixed C forcing. -/
theorem constantResponse_inverse : constantResponse =
    burnolMeanZeroBlockInverse (Constructor.zeroMean (burnolTruncatedFourier (intervalConstant q))) := by
  have source := OriginalKGapProjectionEulerSource.actual_gap_response_equation
  rw [constantSource_read] at source
  have inverseLeft : burnolMeanZeroBlockInverse * burnolMeanZeroOneMinusSquare = 1 :=
    Ring.inverse_mul_cancel _ burnolMeanZeroOneMinusSquare_isUnit
  have recovered := congrArg burnolMeanZeroBlockInverse source
  change (burnolMeanZeroBlockInverse * burnolMeanZeroOneMinusSquare) constantResponse = _ at recovered
  rw [inverseLeft] at recovered
  exact recovered

theorem constantPhysicalVector_source : constantPhysicalVector = ConstantDual.seed -
    fourierL2 (burnolQuarterZeroExtension (constantResponse : BurnolQuarterIntervalL2)) +
    burnolQuarterZeroExtension (constantReturn : BurnolQuarterIntervalL2) := by
  unfold constantPhysicalVector OriginalKGapProjectionEulerSource.actualGapWhole
  module

theorem constantPhysicalVector_projection :
    (burnolEvenAmbientProjection ConstantDual.seed : BurnolL2) = constantPhysicalVector := by
  have paid := OriginalKGapProjectionEulerSource.actual_gap_mean_whole_source
  unfold OriginalRieszFiniteSynthesis.gapMeanVector at paid
  change (burnolEvenAmbientProjection (burnolAmbientGapRieszVector q) : BurnolL2) =
    (2 : ℂ) • constantPhysicalVector at paid
  rw [OriginalKGapProjectionEulerSource.actual_raw_gap_seed,map_smul] at paid
  change (2 : ℂ) • (burnolEvenAmbientProjection ConstantDual.seed : BurnolL2) =
    (2 : ℂ) • constantPhysicalVector at paid
  have recovered := congrArg (fun value : BurnolL2 => (1/2 : ℂ) • value) paid
  simpa only [smul_smul,show (1/2 : ℂ)*2=1 by norm_num,one_smul] using recovered

theorem constantPhysicalVector_mem : constantPhysicalVector ∈ evenBurnolClosedFace q := by
  rw [←constantPhysicalVector_projection]
  exact (burnolEvenAmbientProjection ConstantDual.seed).property

def constantPhysical : BurnolPaAmbientCarrier := ⟨constantPhysicalVector,constantPhysicalVector_mem⟩

/-- Complete residual orthogonality comes from the paid physical projection of the same C. -/
theorem constantPhysicalVector_orthogonal (value : BurnolPaAmbientCarrier) :
    inner ℂ (ConstantDual.seed-constantPhysicalVector) (value : BurnolL2) = 0 := by
  rw [←constantPhysicalVector_projection]
  exact (evenBurnolClosedFace q).toSubmodule.starProjection_inner_eq_zero _ _ value.property

private theorem constantReturn_read : (constantReturn : BurnolQuarterIntervalL2) =
    burnolTruncatedFourier (constantResponse : BurnolQuarterIntervalL2) -
      constantResponseMean • intervalConstant q := Constructor.zeroMean_read _

theorem constantPhysicalVector_quarter : burnolQuarterRestriction constantPhysicalVector =
    (1-constantResponseMean) • intervalConstant q := by
  rw [constantPhysicalVector_source,map_add,map_sub]
  change burnolQuarterRestriction ConstantDual.seed -
    burnolTruncatedFourier (constantResponse : BurnolQuarterIntervalL2) +
    burnolQuarterRestriction (burnolQuarterZeroExtension (constantReturn : BurnolQuarterIntervalL2)) = _
  rw [seed_quarter,burnolQuarterRestriction_zeroExtension,constantReturn_read]
  module

theorem constantPhysicalVector_fourier_quarter :
    burnolQuarterRestriction (fourierL2 constantPhysicalVector) =
      (burnolQuarterMeanCoefficient (burnolTruncatedFourier (intervalConstant q))+
        constantReturnMean) • intervalConstant q := by
  have source := congrArg (fun state : BurnolQuarterMeanZeroCarrier => (state : BurnolQuarterIntervalL2))
    OriginalKGapProjectionEulerSource.actual_gap_response_equation
  change (constantResponse : BurnolQuarterIntervalL2) -
    (Constructor.zeroMean (burnolTruncatedFourier (constantReturn : BurnolQuarterIntervalL2)) :
      BurnolQuarterIntervalL2) = (OriginalKGapProjectionEulerSource.actualGapSource : BurnolQuarterIntervalL2) at source
  rw [constantSource_read,Constructor.zeroMean_read,Constructor.zeroMean_read] at source
  rw [constantPhysicalVector_source,map_add,map_sub,fourierL2_fourierL2,map_add,map_sub]
  change burnolTruncatedFourier (intervalConstant q) -
    burnolQuarterRestriction (reflectL2 (burnolRadiusZeroExtension q (constantResponse : BurnolQuarterIntervalL2))) +
    burnolTruncatedFourier (constantReturn : BurnolQuarterIntervalL2) = _
  rw [burnolRadiusZeroExtension_reflect,OriginalKGapProjectionEulerSource.actual_gap_response_even]
  change burnolTruncatedFourier (intervalConstant q) -
    burnolQuarterRestriction (burnolQuarterZeroExtension (constantResponse : BurnolQuarterIntervalL2)) +
    burnolTruncatedFourier (constantReturn : BurnolQuarterIntervalL2) = _
  rw [burnolQuarterRestriction_zeroExtension]
  change _ = (burnolQuarterMeanCoefficient (burnolTruncatedFourier (intervalConstant q))+
    burnolQuarterMeanCoefficient (burnolTruncatedFourier (constantReturn : BurnolQuarterIntervalL2))) • _
  linear_combination (norm := module) -source

private theorem seed_inner : inner ℂ ConstantDual.seed ConstantDual.seed = (1/2 : ℂ) := by
  have gap : burnolQuarterRestriction ConstantDual.seed = (1 : ℂ) • intervalConstant q := by
    rw [seed_quarter,one_smul]
  have read := inward_constant_contact _ _ gap 0 (by norm_num)
  simpa only [neg_zero,zero_div,Real.exp_zero,Complex.ofReal_one,burnolMultiplicativeDilation_zero,star_one,mul_one] using read

private theorem seed_constant_inner : inner ℂ (intervalConstant q) (intervalConstant q) = (1/2 : ℂ) := by
  have adjoint : inner ℂ ConstantDual.seed ConstantDual.seed =
      inner ℂ (intervalConstant q) (burnolQuarterRestriction ConstantDual.seed) :=
    ContinuousLinearMap.adjoint_inner_left burnolQuarterRestriction _ _
  rw [seed_quarter,seed_inner] at adjoint
  exact adjoint.symm

/-- The B response mean is the exact physical projection cost, rather than a free margin. -/
theorem constantPhysicalVector_energy : ((‖constantPhysicalVector‖^2 : ℝ) : ℂ) =
    (1-constantResponseMean)/2 := by
  have orthogonal := constantPhysicalVector_orthogonal constantPhysical
  have contact : inner ℂ ConstantDual.seed constantPhysicalVector = (1-constantResponseMean)/2 := by
    have adjoint : inner ℂ ConstantDual.seed constantPhysicalVector =
        inner ℂ (intervalConstant q) (burnolQuarterRestriction constantPhysicalVector) :=
      ContinuousLinearMap.adjoint_inner_left burnolQuarterRestriction _ _
    rw [adjoint,constantPhysicalVector_quarter,inner_smul_right,seed_constant_inner]
    ring
  change inner ℂ (ConstantDual.seed-constantPhysicalVector) constantPhysicalVector = 0 at orthogonal
  rw [inner_sub_left,contact] at orthogonal
  have self : inner ℂ constantPhysicalVector constantPhysicalVector = (1-constantResponseMean)/2 :=
    (sub_eq_zero.mp orthogonal).symm
  have normRead := inner_self_eq_norm_sq_to_K (𝕜 := ℂ) (constantPhysicalVector : BurnolL2)
  simpa only [RCLike.ofReal_eq_complex_ofReal,Complex.ofReal_pow] using normRead.symm.trans self

theorem constantPhysicalVector_loss_energy :
    ((‖ConstantDual.seed-constantPhysicalVector‖^2 : ℝ) : ℂ) = constantResponseMean/2 := by
  have orthogonal := constantPhysicalVector_orthogonal constantPhysical
  change inner ℂ (ConstantDual.seed-constantPhysicalVector) constantPhysicalVector = 0 at orthogonal
  have reverseOrthogonal := inner_eq_zero_symm.mp orthogonal
  have decomposition : ConstantDual.seed = constantPhysicalVector+(ConstantDual.seed-constantPhysicalVector) := by module
  have paired := seed_inner
  nth_rw 1 [decomposition] at paired
  nth_rw 2 [decomposition] at paired
  rw [inner_add_left,inner_add_right,inner_add_right,orthogonal,reverseOrthogonal] at paired
  rw [inner_self_eq_norm_sq_to_K,inner_self_eq_norm_sq_to_K] at paired
  simp only [RCLike.ofReal_eq_complex_ofReal] at paired
  have cost := constantPhysicalVector_energy
  push_cast at cost ⊢
  linear_combination paired-cost

end NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.CenteredGram.IntegralGraphJointAction.OriginalKSourcePhysicalProjection
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
