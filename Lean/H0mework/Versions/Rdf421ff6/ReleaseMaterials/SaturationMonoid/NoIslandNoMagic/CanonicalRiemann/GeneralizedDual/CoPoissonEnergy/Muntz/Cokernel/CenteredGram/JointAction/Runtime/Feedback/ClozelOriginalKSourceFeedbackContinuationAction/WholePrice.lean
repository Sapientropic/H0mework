/-- Decode the raw feet only after the actual whole material has generated the complete input and registered residual. -/
def continuationWholeRawInput := Parent.sourceSlotsRead
 (actualNativeTotalRead t factory packet (continuationWholeMaterialInput t factory packet))

/-- The independently received raw state is produced by the actual whole material's source input. -/
theorem continuation_whole_material_generates_raw_next :
 continuationReceivedRawState t factory packet=Parent.sourceFeedbackNext (continuationWholeRawInput t factory packet) := by
 unfold continuationWholeRawInput
 rw [continuation_whole_material_input_receipt]
 exact continuation_received_raw_source t factory packet

/-- The whole's material update is consumed by complete finite-plus-tail observer prices. -/
theorem continuation_whole_material_raw_fee (test : BurnolQuarterMeanZeroCarrier) :
 let raw:=continuationWholeRawInput t factory packet
 let received:=continuationReceivedRawState t factory packet
 inner ℂ (raw.1.1+raw.2.1) test=inner ℂ received.1.1 test+inner ℂ received.2.1 test ∧
 inner ℂ (raw.1.2+raw.2.2) test=inner ℂ received.1.2 test+inner ℂ received.2.2 test := by
 dsimp only
 unfold continuationWholeRawInput
 rw [continuation_whole_material_input_receipt]
 exact continuation_received_full_raw_fee t factory packet test

/-- This budget is for the source input recovered from the same actual whole; no numerical debit is used to choose its branch. -/
theorem continuation_whole_material_tail_budget :
 ‖(continuationReceivedRawState t factory packet).2.1‖≤(1/2:ℝ)*‖(continuationWholeRawInput t factory packet).2.1‖ ∧
 ‖(continuationReceivedRawState t factory packet).2.2‖≤(1/2:ℝ)*‖(continuationWholeRawInput t factory packet).2.2‖ := by
 unfold continuationWholeRawInput
 rw [continuation_whole_material_input_receipt]
 exact continuation_received_tail_bound t factory packet

