private theorem packet_transport_source_value {Y Z : Unit → Type} (same : Y=Z)
 (source : AP.AdmissionPacket (W:=PairValue C.Value) (X:=Y) (s:=()))
 (targetGrade : Nat) (sourceGrade : source.1=targetGrade)
 (transportedGrade : (NT.packetTransport same source).1=targetGrade) (name : Z ()) :
 cast (congrArg sourceValueAt transportedGrade)
  (SlotSource.physicalEnvironment (NT.packetTransport same source).2.1.1
   (SlotSource.Shared.actualOccurrence (NT.packetTransport same source).2.1.1) () name)=
 cast (congrArg sourceValueAt sourceGrade)
  (source.2.1.1.activeEnvironment () (same.symm ▸ name)) := by
 cases same
 rfl

/-- The before-slots of this actual next action are generated by the original initialization receipt; N0 is not a premise or recognition test. -/
theorem actual_source_before_is_generated_initial :
 actualSourceBeforeValue t factory packet=sourceRawSlots (sourceRawFeet (actualInitQuarterSource t factory packet) 0) := by
 let native := AP.bornAfterNative (sourceInitNativePacket t factory packet)
 have nativeGrade : native.1=packet.1+1 := by
  unfold native AP.bornAfterNative sourceInitNativePacket
  rfl
 have transportedGrade : (NT.packetTransport packet.2.2.2.down native).1=packet.1+1 := by
  have actual := source_init_born_grade t factory packet
  unfold sourceInitBornPacket at actual
  exact actual
 have raw := packet_transport_source_value packet.2.2.2.down native (packet.1+1)
  nativeGrade transportedGrade ()
 unfold actualSourceBeforeValue sourceNextFrame sourceInitBornPacket
 change CF.collapseValue packet.1
  (cast (congrArg sourceValueAt transportedGrade)
   (SlotSource.physicalEnvironment (NT.packetTransport packet.2.2.2.down native).2.1.1
    (SlotSource.Shared.actualOccurrence (NT.packetTransport packet.2.2.2.down native).2.1.1) () ()))=_
 rw [raw]
 have sameSource :
  cast (congrArg sourceValueAt nativeGrade)
   (native.2.1.1.activeEnvironment () (packet.2.2.2.down.symm ▸ ()))=
  (sourceInitBorn t (actualSourceSlotSuccessorFactory factory) packet.1 packet.2.1 packet.2.2.1 packet.2.2.2.down).activeEnvironment ()
   (packet.2.2.2.down.symm ▸ ()) := by
  unfold native AP.bornAfterNative sourceInitNativePacket
  rfl
 rw [sameSource]
 exact source_init_original_raw_mouth _ _ _ _

