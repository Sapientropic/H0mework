/-- Query n supplies the shell integral; the resulting source action is read on canonical born n+1. -/
def QueryVolterraBornAt : Prop :=
 type_of% (OriginalKDirectRCofinalSourceAction.actual_cofinal_preserves_history observation nontrivial half depth ordinal) ∧
 type_of% (Face.actual_source_root observation nontrivial half depth ordinal) ∧
 type_of% (Face.actual_source_trace observation nontrivial half depth ordinal) ∧
 type_of% (Face.actual_source_point_from_packet observation nontrivial half depth ordinal) ∧
 (∀ stage,type_of% (Face.actual_cofinal_window_read observation nontrivial half depth ordinal stage)) ∧
 type_of% (Face.actual_face_image_value observation nontrivial half depth ordinal) ∧
 type_of% (actual_query_source observation nontrivial half depth ordinal) ∧
 type_of% (actual_query_correction_integral observation nontrivial half depth ordinal) ∧
 type_of% (actual_query_correction_memPa observation nontrivial half depth ordinal) ∧
 type_of% (actual_query_correction_Tate_source observation nontrivial half depth ordinal) ∧
 type_of% (actual_query_correction_original observation nontrivial half depth ordinal) ∧
 type_of% (Face.actual_whole_paid_trace observation nontrivial half depth ordinal) ∧
 PC.bornRead observation nontrivial half depth ordinal=(actualQueryCorrection observation nontrivial half depth ordinal : BurnolL2)+
 Prior.sourceCoefficient observation nontrivial half depth ordinal • (Prior.sourceWholeUnit observation nontrivial half : BurnolL2)+
 P.R observation nontrivial half (PA.invisible (D.raw observation nontrivial half depth ordinal)) ∧
 PA.E (PC.bornRead observation nontrivial half depth ordinal)=actualQueryCorrection observation nontrivial half depth ordinal+
 Prior.sourceCoefficient observation nontrivial half depth ordinal • PA.E (Prior.sourceWholeUnit observation nontrivial half : BurnolL2)+PC.actualEReturn observation nontrivial half depth ordinal ∧
 burnolMobiusSourceL2 (PA.E (PC.bornRead observation nontrivial half depth ordinal))=
 burnolTateReciprocalL2 (sourceVolterraWindow (burnolDivisionZeroCompletedMellinCoordinate observation half.down) (actualQueryTate observation nontrivial half depth ordinal))+
 Prior.sourceCoefficient observation nontrivial half depth ordinal • burnolMobiusSourceL2 (PA.E (Prior.sourceWholeUnit observation nontrivial half : BurnolL2))+
 burnolMobiusSourceL2 (PC.actualEReturn observation nontrivial half depth ordinal) ∧
 burnolTateReciprocalL2 (burnolMobiusSourceL2 (PA.E (PC.bornRead observation nontrivial half depth ordinal)))=
 sourceVolterraWindow (burnolDivisionZeroCompletedMellinCoordinate observation half.down) (actualQueryTate observation nontrivial half depth ordinal)+
 Prior.sourceCoefficient observation nontrivial half depth ordinal • burnolTateReciprocalL2 (burnolMobiusSourceL2 (PA.E (Prior.sourceWholeUnit observation nontrivial half : BurnolL2)))+
 burnolTateReciprocalL2 (burnolMobiusSourceL2 (PC.actualEReturn observation nontrivial half depth ordinal)) ∧
 actualQuerySource observation nontrivial half depth (ordinal+1)=burnolMobiusSourceL2 (PA.E (PC.bornRead observation nontrivial half depth ordinal))

theorem query_occurrence_retains_current_paid_trace :
 type_of% (OriginalKDirectRCofinalSourceAction.actual_cofinal_preserves_history observation nontrivial half depth ordinal) ∧
 type_of% (Face.actual_source_root observation nontrivial half depth ordinal) ∧ type_of% (Face.actual_source_trace observation nontrivial half depth ordinal) ∧
 type_of% (Face.actual_whole_paid_trace observation nontrivial half depth ordinal) :=
 ⟨OriginalKDirectRCofinalSourceAction.actual_cofinal_preserves_history observation nontrivial half depth ordinal,
 Face.actual_source_root observation nontrivial half depth ordinal,Face.actual_source_trace observation nontrivial half depth ordinal,Face.actual_whole_paid_trace observation nontrivial half depth ordinal⟩

theorem actual_decoded_source_drives_integral :
 type_of% (Face.actual_face_image_value observation nontrivial half depth ordinal) ∧ type_of% (actual_query_source observation nontrivial half depth ordinal) ∧
 type_of% (actual_query_correction_integral observation nontrivial half depth ordinal) ∧ type_of% (actual_query_correction_memPa observation nontrivial half depth ordinal) :=
 ⟨Face.actual_face_image_value observation nontrivial half depth ordinal,actual_query_source observation nontrivial half depth ordinal,actual_query_correction_integral observation nontrivial half depth ordinal,actual_query_correction_memPa observation nontrivial half depth ordinal⟩

theorem query_time_independent_of_window_stage (stage : Nat) :
 type_of% (Face.actual_cofinal_window_read observation nontrivial half depth ordinal stage) ∧ type_of% (actual_query_source_successor observation nontrivial half depth ordinal) :=
 ⟨Face.actual_cofinal_window_read observation nontrivial half depth ordinal stage,actual_query_source_successor observation nontrivial half depth ordinal⟩

theorem zero_coefficient_preserves_Volterra_and_return (zero : Prior.sourceCoefficient observation nontrivial half depth ordinal=0) :
 actualQuerySource observation nontrivial half depth (ordinal+1)=
 burnolTateReciprocalL2 (sourceVolterraWindow (burnolDivisionZeroCompletedMellinCoordinate observation half.down) (actualQueryTate observation nontrivial half depth ordinal))+
 burnolMobiusSourceL2 (PC.actualEReturn observation nontrivial half depth ordinal) := by
 have generated:=actual_query_source_successor observation nontrivial half depth ordinal
 rw [zero,zero_smul,add_zero] at generated
 exact generated

theorem zero_Ereturn_preserves_Volterra_and_Eunit (zero : PC.actualEReturn observation nontrivial half depth ordinal=0) :
 actualQuerySource observation nontrivial half depth (ordinal+1)=
 burnolTateReciprocalL2 (sourceVolterraWindow (burnolDivisionZeroCompletedMellinCoordinate observation half.down) (actualQueryTate observation nontrivial half depth ordinal))+
 Prior.sourceCoefficient observation nontrivial half depth ordinal • burnolMobiusSourceL2 (PA.E (Prior.sourceWholeUnit observation nontrivial half : BurnolL2)) := by
 have generated:=actual_query_source_successor observation nontrivial half depth ordinal
 change actualQuerySource observation nontrivial half depth (ordinal+1)=_+burnolMobiusSourceL2 (PC.actualEReturn observation nontrivial half depth ordinal) at generated
 rw [zero,map_zero,add_zero] at generated
 exact generated

theorem zero_generated_correction_preserves_both_feet (zero : actualQueryCorrection observation nontrivial half depth ordinal=0) :
 PA.actualPa observation nontrivial half depth (ordinal+1)=Prior.sourceCoefficient observation nontrivial half depth ordinal • PA.E (Prior.sourceWholeUnit observation nontrivial half : BurnolL2)+PC.actualEReturn observation nontrivial half depth ordinal := by
 have generated:=actual_Pa_successor_from_face observation nontrivial half depth ordinal
 rw [zero,zero_add] at generated
 exact generated

theorem total_cancellation_does_not_erase_source_terms :
 let source : ℂ := 1
 let returning : ℂ := -1
 source≠0 ∧ returning≠0 ∧ source+returning=0 := by norm_num

private theorem source_point_raw :
 (actualPaSource observation nontrivial half depth (ordinal+1)).val=
 PA.E (D.raw observation nontrivial half depth (ordinal+1)) := rfl

private theorem decode_born (image : LinearMap.range Window.sourceCompletionMap.hom)
 (point : Window.PaSourceCarrier) (raw born : BurnolL2)
 (pointRaw : point.val=PA.E raw) (same : born=raw)
 (decode : Window.sourceDecoder image=point)
 (inverse : Window.inverseSourceDecoder image=burnolMobiusSourceL2 point.val) :
 (Window.sourceDecoder image).val=PA.E born ∧
 Window.inverseSourceDecoder image=burnolMobiusSourceL2 (PA.E born) := by
 have read : (Window.sourceDecoder image).val=point.val :=
  congrArg (fun source : Window.PaSourceCarrier=>source.val) decode
 exact ⟨(read.trans pointRaw).trans (congrArg PA.E same.symm),
  (inverse.trans (congrArg burnolMobiusSourceL2 pointRaw)).trans
   (congrArg burnolMobiusSourceL2 (congrArg PA.E same.symm))⟩

set_option maxHeartbeats 3000000 in
/-- Both source phases are connected through the actual query, complete shell action and full successor packet. -/
theorem actual_query_Volterra_same_born_whole :
 QueryVolterraBornAt observation nontrivial half depth ordinal ∧ BornCofinalFaceAt observation nontrivial half depth ordinal ∧ InheritedBornAt observation nontrivial half depth ordinal := by
 refine consume_actual_query_Volterra observation nontrivial half depth ordinal
  (Result:=QueryVolterraBornAt observation nontrivial half depth ordinal ∧ BornCofinalFaceAt observation nontrivial half depth ordinal ∧ InheritedBornAt observation nontrivial half depth ordinal) ?_
 intro query_history query_root query_trace query_point query_reads query_image query_source query_integral query_memPa query_Tate_source query_correction query_whole query_Pa query_next_source query_next_Tate
  born_projection source_root source_trace source_paid_trace source_input source_point cofinal_injective cofinal_reads cofinal_action window_transitions face_image face_decoder face_inverse_decoder face_action face_inverse_action correction_memPa whole_source Pa_source Mobius_source finite_source compressed_source forced_complete unit_rank forced_energy forced_inverse forced_cost residual_successor residual_inventory reentry_successor response_value response_gap response_Q source_R_split Q_successor K_read FourierK_read complete_gram request model compiles whole material_increment material_input native_value native_expression old_paid_code old_paid_branches old_paid_R receipt_zero born_old_paid successor successor_paid_value successor_branches receiver_input receiver_ast native_packet receipt_bound receipt_action receipt_macro_next receipt_compiles born_ast decoder born_inventory born_pair_inventory source_word_inventory actual_next_packet old_events old_pair_events whole_paid_in_born generated_joint_in_born full_paid_steps source_boundary whole_paid_trace actual_inverse actual_effect relation_recovery native_full_trace native_relation_face native_relation_in_born root_generated_current rooted_material_source source_gap source_strong raw_successor next_pair full_history paid_prefix_stocks paid_prefix native_coordinate_zero root_future
 have calculated:=Prior.Full.complete_of_branches observation nontrivial half _ _ successor_branches
 have bornR : PC.bornRead observation nontrivial half depth ordinal=P.R observation nontrivial half (D.raw observation nontrivial half depth ordinal) := calculated.2.2.1
 have raw : PC.bornRead observation nontrivial half depth ordinal=D.raw observation nontrivial half depth (ordinal+1) := bornR.trans raw_successor.symm
 have bornWhole:=raw.trans whole_source
 have samePa:=congrArg PA.E raw
 have bornPa:=samePa.trans Pa_source
 have bornMobius:=(congrArg burnolMobiusSourceL2 samePa).trans Mobius_source
 have forced : PC.bornForcedPa observation nontrivial half depth ordinal=Prior.forcedPaSource observation nontrivial half depth ordinal :=
  congrArg (fun material : BurnolPaAmbientCarrier=>material-PC.actualEReturn observation nontrivial half depth ordinal) samePa
 have bornComplete:=forced.trans forced_complete
 have bornCompressed:=compressed_source.trans forced.symm
 have bornEnergy:=forced_energy
 rw [←forced] at bornEnergy
 have bornCost:=forced_cost
 rw [←forced] at bornCost
 have fibre : ∀ candidate : Prior.Paid.PaSourceCarrier,
  Prior.Paid.compressedR observation nontrivial half candidate=PC.bornForcedPa observation nontrivial half depth ordinal→candidate=Prior.actualPaSource observation nontrivial half depth ordinal :=
  fun candidate produces=>forced_inverse candidate (produces.trans forced)
 have inherited : InheritedBornAt observation nontrivial half depth ordinal := ⟨correction_memPa,finite_source,
  ⟨bornWhole,bornPa,bornMobius,bornComplete,bornCompressed,unit_rank,bornEnergy,fibre,bornCost⟩,
  residual_successor,residual_inventory,reentry_successor,K_read,FourierK_read,complete_gram,
  whole,root_generated_current,Prior.consumed_request_source observation nontrivial half depth ordinal,native_value,successor⟩
 have anchored:=born_projection successor
 have decodedBorn:=decode_born
  (actualFaceImage observation nontrivial half depth (ordinal+1))
  (actualPaSource observation nontrivial half depth (ordinal+1))
  (D.raw observation nontrivial half depth (ordinal+1))
  (PC.bornRead observation nontrivial half depth ordinal)
  (source_point_raw observation nontrivial half depth ordinal) raw face_decoder face_inverse_decoder
 have cofinal : BornCofinalFaceAt observation nontrivial half depth ordinal :=
  ⟨anchored,source_root,source_trace,source_paid_trace,source_input,source_point,cofinal_injective,cofinal_reads,
   cofinal_action,window_transitions,face_image,decodedBorn.1,decodedBorn.2,face_action,face_inverse_action⟩
 have bornQueryWhole:=raw.trans query_whole
 have bornQueryPa:=samePa.trans query_Pa
 have bornQuerySource : actualQuerySource observation nontrivial half depth (ordinal+1)=burnolMobiusSourceL2 (PA.E (PC.bornRead observation nontrivial half depth ordinal)) := by
  change Window.inverseSourceDecoder (actualFaceImage observation nontrivial half depth (ordinal+1))=_
  exact decodedBorn.2
 have bornQueryMobius:=bornQuerySource.symm.trans query_next_source
 have bornQueryTateRead : actualQueryTate observation nontrivial half depth (ordinal+1)=
  burnolTateReciprocalL2 (burnolMobiusSourceL2 (PA.E (PC.bornRead observation nontrivial half depth ordinal))) :=
  congrArg burnolTateReciprocalL2 bornQuerySource
 have bornQueryTate:=bornQueryTateRead.symm.trans query_next_Tate
 have queryPaid : type_of% (Face.actual_whole_paid_trace observation nontrivial half depth ordinal) := Face.actual_whole_paid_trace observation nontrivial half depth ordinal
 exact ⟨⟨query_history,query_root,query_trace,query_point,query_reads,query_image,query_source,query_integral,query_memPa,
  query_Tate_source,query_correction,queryPaid,bornQueryWhole,bornQueryPa,bornQueryMobius,bornQueryTate,bornQuerySource⟩,
  cofinal,inherited⟩

