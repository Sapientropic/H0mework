private theorem stocked_right {α : Type} (prior : Option (RootedAccountedUnfolding α))
 (next : RootedAccountedUnfolding α) (event : α) (present : event∈next.trace) : event∈(Stock.preserve prior next).trace := by
 cases prior with
 | none=>exact present
 | some prior=>exact (SourceHistoryCommon.parallel_right _ _ _).1 event present

/-- Every literal old/change source child enters the scalar born stock of the actual R receipt. -/
theorem complete_R_residual_scalar_nodes (event)
 (present : event∈(SourceOperationPaidRelations.exposure (sourceResidualExecution packet.1 packet.2.1.1)).trace) :
 event∈(Native.bornStock (completeResidualRFactory observation nontrivial half initial origin mother)
  (completeResidualRPacket observation nontrivial half initial origin mother packet)).trace := by
 apply SourceInventoryExecutionFeed.original_preserved
 change event∈(Stock.preserve (Native.selected (completeResidualRFactory observation nontrivial half initial origin mother)
  (completeResidualRPacket observation nontrivial half initial origin mother packet)).inventory _).trace
 rw [(Native.paid_prefix_stocks (completeResidualRFactory observation nontrivial half initial origin mother)
  (completeResidualRPacket observation nontrivial half initial origin mother packet) _ (Nat.le_refl _)).1]
 apply (SourceHistoryCommon.parallel_left _ _ _).1
 apply SourceOperationNative.Tree.Fold.Dependent.Branch.JointQuery.Actor.Operation.Query.Inventory.Observer.CurrentChild.Dynamic.Live.Native.Action.Coupled.Registry.Calculation.Common.Feedback.Continuation.Lower.SourceFamily.ActivationSource.QueryStock.scalar_legacy_preserved
 apply (SourceHistoryCommon.parallel_left _ _ _).1
 exact stocked_right _ _ _ present

/-- Its query-zero paired lift retains both typed residual roles in the same actual R born stock. -/
theorem complete_R_residual_pair_nodes (event)
 (present : event∈(SourceOperationPaidRelations.exposure (sourceResidualPairExecution packet.1 packet.2.1.1)).trace) :
 event∈(Native.bornPairStock (completeResidualRFactory observation nontrivial half initial origin mother)
  (completeResidualRPacket observation nontrivial half initial origin mother packet)).trace := by
 change event∈(Stock.preserve (Native.selected (completeResidualRFactory observation nontrivial half initial origin mother)
  (completeResidualRPacket observation nontrivial half initial origin mother packet)).pairInventory _).trace
 rw [(Native.paid_prefix_stocks (completeResidualRFactory observation nontrivial half initial origin mother)
  (completeResidualRPacket observation nontrivial half initial origin mother packet) _ (Nat.le_refl _)).2]
 apply (SourceHistoryCommon.parallel_left _ _ _).1
 apply (SourceHistoryCommon.parallel_left _ _ _).1
 exact stocked_right _ _ _ present

/-- One actual source installation consumes its original receipt, all old/new inventory, AN6 and full same-ledger payment/current. -/
def CompleteResidualRInstallationAcceptance : Prop :=
 (type_of% (P.source_actual_write_acceptance (completeResidualRFactory observation nontrivial half initial origin mother)
  (completeResidualRPacket observation nontrivial half initial origin mother packet))) ∧
 (type_of% (P.source_actual_inventory_acceptance (completeResidualRFactory observation nontrivial half initial origin mother)
  (completeResidualRPacket observation nontrivial half initial origin mother packet))) ∧
 (type_of% (P.source_actual_whole_acceptance (completeResidualRFactory observation nontrivial half initial origin mother)
  (completeResidualRPacket observation nontrivial half initial origin mother packet))) ∧
 (type_of% (P.source_actual_whole_root (completeResidualRFactory observation nontrivial half initial origin mother)
  (completeResidualRPacket observation nontrivial half initial origin mother packet))) ∧
 (type_of% (P.source_actual_whole_current (completeResidualRFactory observation nontrivial half initial origin mother)
  (completeResidualRPacket observation nontrivial half initial origin mother packet))) ∧
 (type_of% (complete_R_residual_scalar_nodes observation nontrivial half initial origin mother packet)) ∧
 (type_of% (complete_R_residual_pair_nodes observation nontrivial half initial origin mother packet))
attribute [local irreducible] CompleteResidualRInstallationAcceptance

theorem complete_residual_R_installation_acceptance : CompleteResidualRInstallationAcceptance observation nontrivial half initial origin mother packet := by
 unfold CompleteResidualRInstallationAcceptance
 exact ⟨P.source_actual_write_acceptance _ _,P.source_actual_inventory_acceptance _ _,
  P.source_actual_whole_acceptance _ _,P.source_actual_whole_root _ _,P.source_actual_whole_current _ _,
  complete_R_residual_scalar_nodes _ _ _ _ _ _ _,complete_R_residual_pair_nodes _ _ _ _ _ _ _⟩

