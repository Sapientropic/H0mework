opaque wholeDebtRSourceTrace : Trace
    (receipt observation nontrivial depth half).1.environment
    (wholeDebtRSourceCode observation nontrivial depth half)
    (.const ((wholeDebtRSourceCode observation nontrivial depth half).eval
      (receipt observation nontrivial depth half).1.environment)) := by
  let sourceCode := OriginalKWholeDebtRSourceCalculation.code
    (OriginalKCoefficientBSelfCalculation.coordinate observation nontrivial half
      (runtimeEffectRuntimeAt observation nontrivial depth).emittedOccurrence)
    OriginalKBFiniteCalculation.fixedShift
  let sourceReceipt := runtimeWholeDebtRCalculationResultAt observation nontrivial depth half
  have terminal : sourceReceipt.2.1.1 =
      (.const (sourceCode.eval OriginalKWholeDebtRCalculationFace.sourceEnvironment) : Expr Value Var ()) := by
    dsimp only [sourceReceipt]
    rw [runtimeWholeDebtRCalculationResultAt_source]
    exact (OriginalKWholeDebtRCalculationFace.result_expression observation nontrivial half
      (runtimeEffectRuntimeAt observation nontrivial depth).emittedOccurrence).trans
        (congrArg (fun value : Value () => (Expr.const value : Expr Value Var ()))
          (OriginalKWholeDebtRCalculationFace.result_value observation nontrivial half
            (runtimeEffectRuntimeAt observation nontrivial depth).emittedOccurrence))
  have nativeTrace : Trace OriginalKWholeDebtRCalculationFace.sourceEnvironment sourceCode
      (.const (sourceCode.eval OriginalKWholeDebtRCalculationFace.sourceEnvironment)) :=
    Eq.mp (congrArg (fun last : Expr Value Var () =>
      Trace OriginalKWholeDebtRCalculationFace.sourceEnvironment sourceCode last) terminal)
      sourceReceipt.2.1.2
  change Trace (receipt observation nontrivial depth half).1.environment
    (sourceCode.subst (bSelfSourceBinding observation nontrivial depth half))
    (.const ((sourceCode.subst (bSelfSourceBinding observation nontrivial depth half)).eval
      (receipt observation nontrivial depth half).1.environment))
  have valueSource :
      (sourceCode.subst (bSelfSourceBinding observation nontrivial depth half)).eval
          (receipt observation nontrivial depth half).1.environment =
        sourceCode.eval OriginalKWholeDebtRCalculationFace.sourceEnvironment := by
    rw [Expr.eval_subst]
    rfl
  exact Eq.mp (congrArg (fun value : Value () =>
    Trace (receipt observation nontrivial depth half).1.environment
      (sourceCode.subst (bSelfSourceBinding observation nontrivial depth half)) (.const value)) valueSource.symm)
    (Trace.substitutedTrace (bSelfSourceBinding observation nontrivial depth half)
      (receipt observation nontrivial depth half).1.environment nativeTrace)

