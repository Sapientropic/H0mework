/-- The original actual Pa input is passed to the paid full-space correction operator. -/
theorem source_correction_original :
 Prior.sourceCorrection observation nontrivial half depth ordinal =
 burnolPaSourceCorrection (burnolDivisionZeroCompletedMellinCoordinate observation half.down)
  ⟨PA.actualPa observation nontrivial half depth ordinal,
   PA.actualPa_mem observation nontrivial half depth ordinal⟩ := by
 apply Subtype.ext
 rfl

/-- The complete vector is generated by the input source's actual resolvent action. -/
theorem source_correction_Mobius_resolvent :
 burnolMobiusSourceL2 (Prior.sourceCorrection observation nontrivial half depth ordinal) =
 burnolDirectRightResolvent (observation.coordinate/2)
  (burnolMobiusSourceL2 (PA.actualPa observation nontrivial half depth ordinal)) -
 Prior.sourceCoefficient observation nontrivial half depth ordinal •
  burnolNormalizedFirstSourceUnitTail
   (burnolDivisionZeroCompletedMellinCoordinate observation half.down) := by
 rw [source_correction_original]
 exact correction_source_resolvent
  (burnolDivisionZeroCompletedMellinCoordinate observation half.down)
  (PA.actualPa observation nontrivial half depth ordinal)
  (PA.actualPa_mem observation nontrivial half depth ordinal)

/-- The bounded Volterra window acts on the whole original Tate--Mobius source. -/
theorem source_correction_Tate_Volterra :
 burnolTateReciprocalL2
  (burnolMobiusSourceL2 (Prior.sourceCorrection observation nontrivial half depth ordinal)) =
 sourceVolterraWindow (burnolDivisionZeroCompletedMellinCoordinate observation half.down)
  (burnolTateReciprocalL2
   (burnolMobiusSourceL2 (PA.actualPa observation nontrivial half depth ordinal))) := by
 rw [source_correction_original]
 exact (sourceVolterraWindow_original_pa
  (burnolDivisionZeroCompletedMellinCoordinate observation half.down)
  (PA.actualPa observation nontrivial half depth ordinal)
  (PA.actualPa_mem observation nontrivial half depth ordinal)).symm

theorem source_correction_Mobius_Volterra :
 burnolMobiusSourceL2 (Prior.sourceCorrection observation nontrivial half depth ordinal) =
 burnolTateReciprocalL2
  (sourceVolterraWindow (burnolDivisionZeroCompletedMellinCoordinate observation half.down)
   (burnolTateReciprocalL2
    (burnolMobiusSourceL2 (PA.actualPa observation nontrivial half depth ordinal)))) := by
 have actual := congrArg burnolTateReciprocalL2
  (source_correction_Tate_Volterra observation nontrivial half depth ordinal)
 simpa only [burnolTateReciprocalL2_involutive] using actual

/-- The generated source wave pays the original next source, retaining both actual E terms. -/
theorem actual_Mobius_source_successor_Volterra :
 burnolMobiusSourceL2 (PA.actualPa observation nontrivial half depth (ordinal+1)) =
 burnolTateReciprocalL2
  (sourceVolterraWindow (burnolDivisionZeroCompletedMellinCoordinate observation half.down)
   (burnolTateReciprocalL2
    (burnolMobiusSourceL2 (PA.actualPa observation nontrivial half depth ordinal)))) +
 Prior.sourceCoefficient observation nontrivial half depth ordinal •
  burnolMobiusSourceL2 (PA.E (Prior.sourceWholeUnit observation nontrivial half : BurnolL2)) +
 burnolMobiusSourceL2
  (PA.E (P.R observation nontrivial half (PA.invisible (D.raw observation nontrivial half depth ordinal)))) := by
 rw [Prior.actual_Mobius_source_successor, source_correction_Mobius_Volterra]

/-- The Tate input action and the same two E feet generate the entire actual Tate successor. -/
theorem actual_Tate_source_successor_Volterra :
 burnolTateReciprocalL2
  (burnolMobiusSourceL2 (PA.actualPa observation nontrivial half depth (ordinal+1))) =
 sourceVolterraWindow (burnolDivisionZeroCompletedMellinCoordinate observation half.down)
  (burnolTateReciprocalL2
   (burnolMobiusSourceL2 (PA.actualPa observation nontrivial half depth ordinal))) +
 Prior.sourceCoefficient observation nontrivial half depth ordinal •
  burnolTateReciprocalL2
   (burnolMobiusSourceL2 (PA.E (Prior.sourceWholeUnit observation nontrivial half : BurnolL2))) +
 burnolTateReciprocalL2
  (burnolMobiusSourceL2
   (PA.E (P.R observation nontrivial half (PA.invisible (D.raw observation nontrivial half depth ordinal))))) := by
 rw [actual_Mobius_source_successor_Volterra, map_add, map_add, map_smul,
  burnolTateReciprocalL2_involutive]

