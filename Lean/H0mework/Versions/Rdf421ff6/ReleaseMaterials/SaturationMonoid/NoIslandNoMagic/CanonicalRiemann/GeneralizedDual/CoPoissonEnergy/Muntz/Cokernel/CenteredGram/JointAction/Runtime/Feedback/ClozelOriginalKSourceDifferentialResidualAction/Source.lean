/-- The original paid source state and its exact environment change generate the residual word before any canonical residual read. -/
def sourceResidualMaterial := (D.sourceMaterialRaw frame supplied).paid

def sourceResidualRequest := N.input (sourceResidualMaterial frame supplied)

def sourceResidualRaw : D.O.Raw (Value:=Value) (Var:=Var) (sort:=()) :=
 ⟨(sourceResidualRequest frame supplied).environment,(sourceResidualRequest frame supplied).expression⟩

def sourceResidualCode := D.sourceRawDifferentialCode
