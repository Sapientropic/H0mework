/-- The already generated relation boundary of the source paid state carries both syntax endpoints. -/
theorem source_residual_boundary : type_of%
 (N.relation_boundary (R:=ℤ) (sourceResidualMaterial frame supplied)) :=
 N.relation_boundary (R:=ℤ) (sourceResidualMaterial frame supplied)

/-- The actual source update generates the residual price; its canonical residual is a later consumer. -/
theorem source_residual_generated_effect :
 (sourceResidualRaw frame supplied).expression.eval (sourceResidualRaw frame supplied).environment=
 effectEvaluator (R:=ℤ) (sourceResidualMaterial frame supplied).environment
  (sourceResidualMaterial frame supplied).increment
  (relationMap (R:=ℤ) (sourceResidualMaterial frame supplied).environment
   (N.relations (R:=ℤ) (sourceResidualMaterial frame supplied))) :=
 N.updated_value (R:=ℤ) (sourceResidualMaterial frame supplied)

/-- The literal source action recovers the old source value and the residual change as two distinct roles. -/
theorem source_residual_literal_faces :
 (sourceResidualCode frame supplied).eval (sourceResidualEnvironment frame supplied)=
 ((D.I.rawAt frame supplied).expression.eval (D.I.rawAt frame supplied).environment,
  (sourceResidualRaw frame supplied).expression.eval (sourceResidualRaw frame supplied).environment-
   (D.I.rawAt frame supplied).expression.eval (D.I.rawAt frame supplied).environment) :=
 D.source_raw_differential_actual_change _ _

/-- Canonical residual realization is read from the actual relation action, never supplied as its source value. -/
theorem source_residual_canonical_read : type_of%
 (N.residual_value (R:=ℤ) (sourceResidualMaterial frame supplied)) :=
 N.residual_value (R:=ℤ) (sourceResidualMaterial frame supplied)

