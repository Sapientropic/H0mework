/-- The observer consumes the full actual source input and the actually received finite-plus-tail roles. No previous raw value is identified with this material input. -/
theorem actual_cofinal_full_raw_fee (test : BurnolQuarterMeanZeroCarrier) :
 let input:=actualCofinalInputRaw t factory packet
 let received:=actualCofinalReceivedRaw t factory packet
 inner ℂ (input.1.1+input.2.1) test=inner ℂ received.1.1 test+inner ℂ received.2.1 test ∧
 inner ℂ (input.1.2+input.2.2) test=inner ℂ received.1.2 test+inner ℂ received.2.2 test := by
 dsimp only
 rw [actual_cofinal_received_raw_source]
 have actual := OriginalKSourceFeedbackSuccessorAction.source_feedback_whole_conserved (actualCofinalInputRaw t factory packet)
 constructor
 · rw [←actual.1,inner_add_left]
 · rw [←actual.2,inner_add_left]

/-- The owned source feedback pays this tail budget for its complete actual native input; this norm is not a runtime debit. -/
theorem actual_cofinal_own_tail_budget :
 ‖(actualCofinalReceivedRaw t factory packet).2.1‖≤(1/2:ℝ)*‖(actualCofinalInputRaw t factory packet).2.1‖ ∧
 ‖(actualCofinalReceivedRaw t factory packet).2.2‖≤(1/2:ℝ)*‖(actualCofinalInputRaw t factory packet).2.2‖ := by
 rw [actual_cofinal_received_raw_source]
 constructor
 · exact (le_trans (OriginalKRawDualFeedbackSourceAction.plusFeedback.le_opNorm _)
    (mul_le_mul_of_nonneg_right (OriginalKRawDualFeedbackSourceAction.source_feedback_norm).1 (norm_nonneg _)))
 · exact (le_trans (OriginalKRawDualFeedbackSourceAction.minusFeedback.le_opNorm _)
    (mul_le_mul_of_nonneg_right (OriginalKRawDualFeedbackSourceAction.source_feedback_norm).2 (norm_nonneg _)))

