theorem actual_successor_paid_value :
 let packet:=D.packet observation nontrivial half depth ordinal
 let successor:=D.packet observation nontrivial half depth (ordinal+1)
 HEq (successor.2.1.1.activeEnvironment () ()) (WB.oldPaid packet.2.1.1 packet.2.2.1) := by
 let packet:=D.packet observation nontrivial half depth ordinal
 let material:=R.actualMaterial packet.2.1.1 packet.2.2.1
 have born:=Dyn.cofinal_native_value (D.factory observation nontrivial half)
  (D.initial observation nontrivial half depth) (D.firstCfg observation nontrivial half depth) rfl (ordinal+1) ()
 exact born.trans (heq_of_eq ((congrArg material.raw.eval
  (actual_material_input observation nontrivial half depth ordinal)).trans
   (WB.old_paid_value packet.2.1.1 packet.2.2.1).symm))

theorem actual_successor_branches :
 let packet:=D.packet observation nontrivial half depth (ordinal+1)
 CF.collapseValue packet.1 (packet.2.1.1.activeEnvironment () (),0)=
 Full.branches observation nontrivial half (D.input observation nontrivial half depth ordinal) :=
