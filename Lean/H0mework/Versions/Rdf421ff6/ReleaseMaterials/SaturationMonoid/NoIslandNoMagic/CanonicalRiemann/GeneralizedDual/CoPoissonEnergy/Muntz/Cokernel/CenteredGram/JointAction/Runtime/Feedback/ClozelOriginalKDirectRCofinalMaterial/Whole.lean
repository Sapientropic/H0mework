  (AD.packetAt_successor_grade (D.factory observation nontrivial half)
   (D.initial observation nontrivial half depth) (D.firstCfg observation nontrivial half depth) rfl (ordinal+1)) _ _
  (actual_successor_paid_value observation nontrivial half depth ordinal)).trans
