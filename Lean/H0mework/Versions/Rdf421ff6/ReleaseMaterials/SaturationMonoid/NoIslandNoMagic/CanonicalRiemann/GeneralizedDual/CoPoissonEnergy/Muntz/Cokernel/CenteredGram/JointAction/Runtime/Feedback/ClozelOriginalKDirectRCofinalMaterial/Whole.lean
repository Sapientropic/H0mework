/-- The paid value belongs to the original literal code and its actual cofinal input. -/
theorem actual_old_paid_code :
 let packet:=D.packet observation nontrivial half depth ordinal
 WB.oldPaid packet.2.1.1 packet.2.2.1 =
 (CF.codeAt (FR.jointCode (P.code observation nontrivial half)) packet.1).eval
  (pairEnvironment packet.2.1.1.activeEnvironment 0) := by
 let packet:=D.packet observation nontrivial half depth ordinal
 let material:=R.actualMaterial packet.2.1.1 packet.2.2.1
 have old : material.raw.eval (N.input material).environment=WB.oldPaid packet.2.1.1 packet.2.2.1 :=
  (congrArg material.raw.eval (actual_material_input observation nontrivial half depth ordinal)).trans
   (WB.old_paid_value packet.2.1.1 packet.2.2.1).symm
 have generated:=Dyn.programme_updated_value (FR.jointCode (P.code observation nontrivial half))
  packet.1 packet.2.2.1 packet.2.2.2.down packet.2.1.1
  (AI.cofinal_actual_input (FR.jointCode (P.code observation nontrivial half))
   (SF.defaultFactory (PairValue C.Value) C.Var ())
   (D.initial observation nontrivial half depth) (D.firstCfg observation nontrivial half depth) rfl ordinal)
 have active:=Dyn.cofinal_next_active (D.factory observation nontrivial half)
  (D.initial observation nontrivial half depth) (D.firstCfg observation nontrivial half depth) rfl ordinal
 exact old.symm.trans ((eq_of_heq generated).trans
  (congrArg (fun environment => (CF.codeAt (FR.jointCode (P.code observation nontrivial half)) packet.1).eval
   (pairEnvironment environment 0)) active))

theorem actual_old_paid_branches :
 let packet:=D.packet observation nontrivial half depth ordinal
 CF.collapseValue packet.1 (WB.oldPaid packet.2.1.1 packet.2.2.1)=
 Full.branches observation nontrivial half (D.input observation nontrivial half depth ordinal) :=
 ((congrArg (CF.collapseValue _) (actual_old_paid_code observation nontrivial half depth ordinal)).trans
  (CF.code_base_value (FR.jointCode (P.code observation nontrivial half)) _ _)).trans
   (Full.joint_source_value observation nontrivial half _)

theorem actual_old_paid_R :
 let packet:=D.packet observation nontrivial half depth ordinal
 let result:=CF.collapseValue packet.1 (WB.oldPaid packet.2.1.1 packet.2.2.1)
 result.1.1+result.1.2=P.R observation nontrivial half (D.input observation nontrivial half depth ordinal).1 ∧
 result.2.1+result.2.2=P.R observation nontrivial half (D.input observation nontrivial half depth ordinal).2 ∧
 (result.1.1+result.1.2)+(result.2.1+result.2.2)=P.R observation nontrivial half (D.raw observation nontrivial half depth ordinal) := by
 have action:=Full.complete_of_branches observation nontrivial half _ _
  (actual_old_paid_branches observation nontrivial half depth ordinal)
 exact ⟨action.1,action.2.1,action.2.2.1⟩

/-- This is the settlement selected by the native receiver of this original packet. -/
theorem actual_native_receipt_zero :
 IC.nativeValue (D.factory observation nontrivial half) (D.packet observation nontrivial half depth ordinal)=0 :=
 actual_native_value observation nontrivial half depth ordinal

theorem actual_born_old_paid :
 let packet:=D.packet observation nontrivial half depth ordinal
 (IC.sourceBorn (D.factory observation nontrivial half) packet).2.1.1.activeEnvironment=
 AS.write (D.factory observation nontrivial half) packet.1 packet.2.1 packet.2.2.1 packet.2.2.2.down
  (WB.oldPaid packet.2.1.1 packet.2.2.1) := by
 dsimp only
 have born:=IC.born_environment (D.factory observation nontrivial half) (D.packet observation nontrivial half depth ordinal)
 rw [actual_native_receipt_zero,add_zero] at born
 exact born

