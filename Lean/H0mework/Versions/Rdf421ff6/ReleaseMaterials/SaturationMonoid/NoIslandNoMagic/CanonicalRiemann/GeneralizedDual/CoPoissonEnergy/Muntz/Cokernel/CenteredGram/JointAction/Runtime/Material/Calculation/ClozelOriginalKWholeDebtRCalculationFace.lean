private def addInputs {environment : Env Value Var} {left right : E} {point : Value ()} :
    Trace environment (.add left right) (.const point) →
      Σ first : Value (), Σ second : Value (), Trace environment left (.const first) ×
        Trace environment right (.const second) × PLift (first+second=point)
  | .cons (.addConst first second) rest => ⟨first,second,.nil _,.nil _,⟨rest.sound⟩⟩
  | .cons (.addLeft step) rest =>
      let previous := addInputs rest
      ⟨previous.1,previous.2.1,.cons step previous.2.2.1,previous.2.2.2.1,previous.2.2.2.2⟩
  | .cons (.addRight step) rest =>
      let previous := addInputs rest
      ⟨previous.1,previous.2.1,previous.2.2.1,.cons step previous.2.2.2.1,previous.2.2.2.2⟩
termination_by trace => trace.length
decreasing_by
  all_goals
    simp only [Trace.length]
    omega

