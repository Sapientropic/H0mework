  (AS.template (actualCurrentSourceFactory t factory packet) 0 (actualCurrentSourceData t factory packet)
   (actualCurrentSourceBase t factory packet) rfl).nextInventory ∧
 (continuationSourceEmitter t factory packet).nextPairInventory=
