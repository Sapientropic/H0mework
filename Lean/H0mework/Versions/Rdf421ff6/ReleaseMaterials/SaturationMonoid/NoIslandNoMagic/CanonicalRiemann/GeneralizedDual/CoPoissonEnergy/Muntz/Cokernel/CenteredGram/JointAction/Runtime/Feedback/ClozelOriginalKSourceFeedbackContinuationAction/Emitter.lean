/-- After the actual AS nextBase constructs its old-paid/native writer, its dependent source callback installs the literal tail action on that complete same-receipt total. Every template inventory port stays inherited. -/
def continuationSourceEmitter :=
 { AS.nextBase (actualCurrentSourceFactory t factory packet) 0 (actualCurrentSourceData t factory packet)
   (actualCurrentSourceBase t factory packet) rfl with
  datum := fun nativeFrame =>
   { (AS.nextBase (actualCurrentSourceFactory t factory packet) 0 (actualCurrentSourceData t factory packet)
     (actualCurrentSourceBase t factory packet) rfl).datum nativeFrame with
    nextEnvironmentReadAt :=
     ((WB.programme (actualCurrentSourceData t factory packet).1 (actualCurrentSourceBase t factory packet)
      (continuationSourceWrite t factory packet)).datum nativeFrame).nextEnvironmentReadAt } }

/-- The callback consumes the actual queried occurrence's native receipt; no target next state or tail equation is supplied. -/
theorem continuation_source_decoder (nativeFrame)
 {current : RootGeneratedDebtActivationJointSource.Successor.CompilerFromPacketSourceLaw.Current nativeFrame.registered}
 (supplied : SourceOperationInquiry.Context.Installation.Occurrence nativeFrame (current:=current)) (paid) :
 (((continuationSourceEmitter t factory packet).datum nativeFrame).nextEnvironmentReadAt.get (by rfl)) supplied paid=
 continuationSourceWrite t factory packet
  (WB.oldPaid (actualCurrentSourceData t factory packet).1 (actualCurrentSourceBase t factory packet)+
   WB.nativeAt (actualCurrentSourceBase t factory packet) nativeFrame supplied) := rfl

theorem continuation_source_keeps_template_inventory :
