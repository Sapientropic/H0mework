/-- The full original source coefficient and unit-tail norm remain in the generated energy responsibility. -/
theorem source_Pa_unit_complete_energy :
 -(inner ℂ (PaSourceR observation nontrivial half depth ordinal h H N)
  (OriginalKDecodedPaRSourceSuccessor.decodedPaSource observation nontrivial half depth ordinal h H N).val).re =
 (observation.coordinate/2-1/4).re *
  (‖PaSourceR observation nontrivial half depth ordinal h H N‖^2+
   ‖sourceRankCoefficient observation nontrivial half depth ordinal h H N • originalUnitRank observation nontrivial half‖^2) := by
 rw [←source_actual_unit_rank]
 exact source_Pa_complete_energy _ _ _ _ _ _ _ _

include half in
theorem source_lambda_positive : 0<(observation.coordinate/2-1/4).re := by
 have quarter := OriginalKCombCofinalRAction.parameter_rightQuarter observation half
 have read : (observation.coordinate/2-1/4).re=(observation.coordinate/2).re-(1/4 : ℝ) := by norm_num [Complex.sub_re]
 rw [read]
 exact sub_pos.mpr quarter

/-- Kernel separation is generated by the source energy and its actual vector equation. -/
theorem source_Pa_kernel_separated
 (vanishes : PaSourceR observation nontrivial half depth ordinal h H N=0) :
 Four.sourceA observation nontrivial half depth ordinal h H N=0 := by
 have pairing := source_Pa_inner_read observation nontrivial half depth ordinal h H N
 rw [vanishes,inner_zero_left] at pairing
 have energy := source_R_energy observation nontrivial half depth ordinal h H N
 rw [←pairing] at energy
 simp only [Complex.zero_re] at energy
 have normSquared : ‖sourceR observation nontrivial half depth ordinal h H N‖^2=0 := by
  have product : (observation.coordinate/2-1/4).re * ‖sourceR observation nontrivial half depth ordinal h H N‖^2=0 := by linarith
  exact (mul_eq_zero.mp product).resolve_left (ne_of_gt (source_lambda_positive observation half))
 have rzero : sourceR observation nontrivial half depth ordinal h H N=0 := norm_eq_zero.mp (by nlinarith [norm_nonneg (sourceR observation nontrivial half depth ordinal h H N)])
 have action := source_R_vector_action observation nontrivial half depth ordinal h H N
 rw [rzero] at action
 simp only [map_zero,smul_zero,zero_add] at action
 exact action.unique (hasDerivAt_const (0 : ℝ) (0 : BurnolL2))

