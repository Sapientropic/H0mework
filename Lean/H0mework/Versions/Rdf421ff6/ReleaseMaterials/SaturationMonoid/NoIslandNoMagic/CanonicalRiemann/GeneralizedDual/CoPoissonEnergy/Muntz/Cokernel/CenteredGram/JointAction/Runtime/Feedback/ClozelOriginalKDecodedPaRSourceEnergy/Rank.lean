   (OriginalKCombCofinalTwoDirection.coordinate observation nontrivial half).rightHalf)

theorem physical_source_response : physicalSourceR observation nontrivial half depth ordinal h H N =
 burnolPaResolventPhysicalResponse observation nontrivial
  (OriginalKCombCofinalTwoDirection.coordinate observation nontrivial half).rightHalf
  (OriginalKDecodedPaRSourceSuccessor.decodedPaSource observation nontrivial half depth ordinal h H N).val
  (OriginalKDecodedPaRSourceSuccessor.decoded_pa_source_qualified observation nontrivial half depth ordinal h H N) := by
