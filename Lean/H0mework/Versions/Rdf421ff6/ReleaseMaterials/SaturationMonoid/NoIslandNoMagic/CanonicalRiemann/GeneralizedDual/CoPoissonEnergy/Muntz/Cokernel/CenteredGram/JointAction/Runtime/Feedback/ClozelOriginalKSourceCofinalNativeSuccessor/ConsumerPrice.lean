/-- The source packet is read from the same original runtime, after its actual native admission. -/
def actualFuturePacket (ordinal : Nat) := cofinalSourcePacket (actualFutureLiteral t factory packet)
 (actualFutureMother t factory packet) (actualFutureInitial t factory packet)
 (actualFutureProgramme t factory packet) rfl ordinal

def actualFutureInputRaw (ordinal : Nat) := FAction.sourceSlotsRead
 (actualFutureReader t factory packet (CF.collapseValue (actualFuturePacket t factory packet ordinal).1
  (cofinalSourceInput (actualFutureLiteral t factory packet) (actualFutureMother t factory packet)
   (actualFutureInitial t factory packet) (actualFutureProgramme t factory packet) rfl ordinal () ())))

def actualFutureWholeRaw (ordinal : Nat) := FAction.sourceSlotsRead
 (actualFutureReader t factory packet (CF.collapseValue (actualFuturePacket t factory packet ordinal).1
  (sourcePacketWholeTotal (actualFutureFactory t factory packet) (actualFuturePacket t factory packet ordinal))))

/-- The full raw next roles are generated by the real whole's source update. -/
theorem actual_future_whole_raw_action (ordinal : Nat) :
 actualFutureWholeRaw t factory packet ordinal=
 FAction.sourceFeedbackNext (actualFutureInputRaw t factory packet ordinal) := by
 unfold actualFutureWholeRaw actualFutureFactory actualFuturePacket
 have source:=congrArg FAction.sourceSlotsRead (actual_future_whole_read t factory packet ordinal)
 exact source.trans (FAction.source_slots_recover_raw _)

/-- Every real admission preserves the complete finite-plus-tail price for an independent observer. -/
theorem actual_future_whole_raw_fee (ordinal : Nat) (test : BurnolQuarterMeanZeroCarrier) :
 let input:=actualFutureInputRaw t factory packet ordinal
 let whole:=actualFutureWholeRaw t factory packet ordinal
 inner ℂ (input.1.1+input.2.1) test=inner ℂ whole.1.1 test+inner ℂ whole.2.1 test ∧
 inner ℂ (input.1.2+input.2.2) test=inner ℂ whole.1.2 test+inner ℂ whole.2.2 test := by
 dsimp only
 rw [actual_future_whole_raw_action]
 have conserved:=FAction.source_feedback_whole_conserved (actualFutureInputRaw t factory packet ordinal)
 constructor
 · rw [←conserved.1,inner_add_left]
 · rw [←conserved.2,inner_add_left]

/-- Each tail budget is paid by that event's own complete material input. -/
theorem actual_future_whole_tail_budget (ordinal : Nat) :
 ‖(actualFutureWholeRaw t factory packet ordinal).2.1‖≤(1/2:ℝ)*‖(actualFutureInputRaw t factory packet ordinal).2.1‖ ∧
 ‖(actualFutureWholeRaw t factory packet ordinal).2.2‖≤(1/2:ℝ)*‖(actualFutureInputRaw t factory packet ordinal).2.2‖ := by
 rw [actual_future_whole_raw_action]
 constructor
 · exact le_trans (RawAction.plusFeedback.le_opNorm _)
    (mul_le_mul_of_nonneg_right (RawAction.source_feedback_norm).1 (norm_nonneg _))
 · exact le_trans (RawAction.minusFeedback.le_opNorm _)
    (mul_le_mul_of_nonneg_right (RawAction.source_feedback_norm).2 (norm_nonneg _))

