local instance intertwiningPhysicalComplete : CompleteSpace BurnolPaAmbientCarrier := by
  apply IsComplete.completeSpace_coe
  exact (evenBurnolClosedFace burnolUnscaledCommonGapRadius).isClosed.isComplete

/-- The actual physical restriction of the transparent original-R Cayley action. -/
def sourceCompression (c : BurnolCompletedMellinCoordinate) : BurnolPaAmbientCarrier →L[ℂ] BurnolPaAmbientCarrier :=
  burnolEvenAmbientProjection.comp ((U c).comp
    (evenBurnolClosedFace burnolUnscaledCommonGapRadius).toSubmodule.subtypeL)

private theorem full_split (value : BurnolL2) : value=P value+O value := by
  have outside : O value=value-P value := Submodule.starProjection_orthogonal_val value
  rw [outside]
  module
private theorem physical_P (v : BurnolPaAmbientCarrier) : P (v:BurnolL2)=v := by
  exact congrArg (fun x:BurnolPaAmbientCarrier => (x:BurnolL2))
    (Submodule.orthogonalProjectionOnto_mem_subspace_eq_self v)
private theorem physical_O (v : BurnolPaAmbientCarrier) : O (v:BurnolL2)=0 := by
  have split := full_split (v:BurnolL2)
  rw [physical_P] at split
  linear_combination (norm := module) -split
private theorem P_O (value : BurnolL2) : P (O value)=0 := by
  have outside : O value=value-P value := Submodule.starProjection_orthogonal_val value
  rw [outside,map_sub]
  have retract := physical_P (burnolEvenAmbientProjection value)
  change P (P value)=P value at retract
  rw [retract,sub_self]
private theorem orthogonal_O (value : BurnolL2)
    (inside : value∈(evenBurnolClosedFace burnolUnscaledCommonGapRadius).toSubmoduleᗮ) : O value=value :=
  Submodule.starProjection_eq_self_iff.mpr inside
private theorem orthogonal_P (value : BurnolL2)
    (inside : value∈(evenBurnolClosedFace burnolUnscaledCommonGapRadius).toSubmoduleᗮ) : P value=0 := by
  have zero := P_O value
  rw [orthogonal_O value inside] at zero
  exact zero

private theorem zeroExtension_pair (state : BurnolQuarterMeanZeroCarrier) (v : BurnolPaAmbientCarrier) :
    inner ℂ (burnolQuarterZeroExtension (state:BurnolQuarterIntervalL2)) (v:BurnolL2)=0 := by
  unfold burnolQuarterZeroExtension burnolRadiusZeroExtension
  rw [ContinuousLinearMap.adjoint_inner_left,inner_eq_zero_symm]
  exact state.property _ v.property.1.1

/-- Orthogonality is generated by both actual mean-zero B columns, without division by an amplitude. -/
theorem powerCorrection_orthogonal (c : BurnolCompletedMellinCoordinate) :
    hPowerPhysicalCorrection c∈(evenBurnolClosedFace burnolUnscaledCommonGapRadius).toSubmoduleᗮ := by
  intro test member
  let v : BurnolPaAmbientCarrier := ⟨test,member⟩
  have even : reflectL2 test=test := mem_evenL2ClosedFace_iff.mp member.2
  let raw := burnolQuarterZeroExtension (hPowerBColumn c:BurnolQuarterIntervalL2)+
    fourierL2 (burnolQuarterZeroExtension (hPowerBSecond c:BurnolQuarterIntervalL2))
  have second : inner ℂ (fourierL2 (burnolQuarterZeroExtension (hPowerBSecond c:BurnolQuarterIntervalL2))) test=0 := by
    have paired := fourierL2.inner_map_map
      (burnolQuarterZeroExtension (hPowerBSecond c:BurnolQuarterIntervalL2)) (fourierL2 test)
    rw [fourierL2_fourierL2,even] at paired
    exact paired.trans (zeroExtension_pair (hPowerBSecond c) (Fphys v))
  have rawZero : inner ℂ raw test=0 := by
    change inner ℂ (_+_) test=0
    rw [inner_add_left,zeroExtension_pair (hPowerBColumn c) v,second,zero_add]
  have reflected : inner ℂ (reflectL2 raw) test=0 := by
    have paired := reflectL2.inner_map_map raw test
    rw [even] at paired
    exact paired.trans rawZero
  rw [inner_eq_zero_symm]
  change inner ℂ (burnolAmbientEvenPart raw) test=0
  unfold burnolAmbientEvenPart
  rw [inner_smul_left,inner_add_left,rawZero,reflected]
  simp

theorem outsideColumn_orthogonal (c : BurnolCompletedMellinCoordinate) :
    physicalOutsideColumn c∈(evenBurnolClosedFace burnolUnscaledCommonGapRadius).toSubmoduleᗮ := by
  intro test member
  have paired := fourierL2.inner_map_map test (physicalOutsideColumn c)
  change inner ℂ (fourierL2 test) (fourierL2 (fourierL2.symm (hPowerPhysicalCorrection (barC c))))=_ at paired
  rw [fourierL2.apply_symm_apply] at paired
  exact paired.symm.trans (powerCorrection_orthogonal (barC c) _ (Fphys ⟨test,member⟩).property)

theorem sourceCompression_actual_adjoint (c : BurnolCompletedMellinCoordinate) (v : BurnolPaAmbientCarrier) :
    (sourceCompression c).adjoint v=burnolEvenAmbientProjection (sourceAdjointCayley c v) := by
  apply ext_inner_right ℂ
  intro test
  rw [ContinuousLinearMap.adjoint_inner_left]
  change inner ℂ v (burnolEvenAmbientProjection (U c test))=_
  have left := (evenBurnolClosedFace burnolUnscaledCommonGapRadius).toSubmodule.inner_orthogonalProjectionOnto_eq_of_mem_left
    v (U c test)
  change inner ℂ v (burnolEvenAmbientProjection (U c test))=_ at left
  rw [left]
  calc
    inner ℂ (v:BurnolL2) (U c test)=inner ℂ ((U c).adjoint v) (test:BurnolL2) :=
      (ContinuousLinearMap.adjoint_inner_left (U c) (test:BurnolL2) (v:BurnolL2)).symm
    _ = inner ℂ (sourceAdjointCayley c v) (test:BurnolL2) := by rw [sourceCayley_actual_adjoint]
    _ = inner ℂ (burnolEvenAmbientProjection (sourceAdjointCayley c v)) test :=
      ((evenBurnolClosedFace burnolUnscaledCommonGapRadius).toSubmodule.inner_orthogonalProjectionOnto_eq_of_mem_right
        test (sourceAdjointCayley c v)).symm

private theorem source_left_inverse (c : BurnolCompletedMellinCoordinate) (value : BurnolL2) :
    (U c).adjoint (U c value)=value := by
  apply ext_inner_left ℂ
  intro test
  rw [ContinuousLinearMap.adjoint_inner_right,sourceCayley_inner]

private theorem source_right_inverse (c : BurnolCompletedMellinCoordinate) (value : BurnolL2) :
    U c ((U c).adjoint value)=value := by
  let inverse : BurnolL2 →ₗᵢ[ℂ] BurnolL2 := {
    (U c).adjoint.toLinearMap with
    norm_map' := fun x => by
      change ‖(U c).adjoint x‖=‖x‖
      rw [sourceCayley_actual_adjoint,sourceAdjointCayley_norm] }
  apply ext_inner_right ℂ
  intro test
  rw [←ContinuousLinearMap.adjoint_inner_right]
  exact inverse.inner_map_map value test

private theorem source_B_block (c : BurnolCompletedMellinCoordinate) (value : BurnolL2) :
    P (U c (O value))=
      (-2*(sourceDamping c:ℂ)*inner ℂ (hPowerPhysicalCorrection c) (O value)) • generatedK (barC c) := by
  rw [sourceCayley_apply,map_add,map_smul,P_O,zero_add]
  change (sourceDamping c:ℂ) •
    (burnolEvenAmbientProjection (burnolDirectRightResolvent (c.value/2) (O value)):BurnolL2)=_
  rw [original_R_outside_physical_generatedK,smul_smul]
  congr 1
  ring

private theorem source_C_block (c : BurnolCompletedMellinCoordinate) (v : BurnolPaAmbientCarrier) :
    O (U c v)=(-2*(sourceDamping c:ℂ)*inner ℂ (fourierL2 (generatedK c)) (v:BurnolL2)) • physicalOutsideColumn c := by
  rw [sourceCayley_apply,map_add,map_smul,physical_O,zero_add,original_R_physical_outside_source,smul_smul]
  congr 1
  ring

private theorem source_C_adjoint_block (c : BurnolCompletedMellinCoordinate) (value : BurnolL2) :
    P ((U c).adjoint (O value))=
      (-2*(sourceDamping c:ℂ)*inner ℂ (physicalOutsideColumn c) (O value)) • fourierL2 (generatedK c) := by
  let f := Fphys (K c)
  have physicalRhs : (-2*(sourceDamping c:ℂ)*inner ℂ (physicalOutsideColumn c) (O value)) • fourierL2 (generatedK c)∈
      evenBurnolClosedFace burnolUnscaledCommonGapRadius := by
    rw [generatedK_eq_original]
    exact (evenBurnolClosedFace burnolUnscaledCommonGapRadius).toSubmodule.smul_mem _ f.property
  suffices equality : burnolEvenAmbientProjection ((U c).adjoint (O value))=
      (⟨(-2*(sourceDamping c:ℂ)*inner ℂ (physicalOutsideColumn c) (O value)) • fourierL2 (generatedK c),physicalRhs⟩:BurnolPaAmbientCarrier) by
    exact congrArg (fun x:BurnolPaAmbientCarrier => (x:BurnolL2)) equality
  apply ext_inner_left ℂ
  intro test
  have projected := (evenBurnolClosedFace burnolUnscaledCommonGapRadius).toSubmodule.inner_orthogonalProjectionOnto_eq_of_mem_left
    test ((U c).adjoint (O value))
  change inner ℂ test (burnolEvenAmbientProjection ((U c).adjoint (O value)))=_ at projected
  rw [projected,ContinuousLinearMap.adjoint_inner_right]
  change inner ℂ (U c test) (O value)=inner ℂ (test:BurnolL2)
    ((-2*(sourceDamping c:ℂ)*inner ℂ (physicalOutsideColumn c) (O value)) • fourierL2 (generatedK c))
  have split := full_split (U c test)
  have orthogonal : O value∈(evenBurnolClosedFace burnolUnscaledCommonGapRadius).toSubmoduleᗮ :=
    Submodule.starProjection_apply_mem _ _
  have killed : inner ℂ (P (U c test)) (O value)=0 := orthogonal _ (burnolEvenAmbientProjection (U c test)).property
  rw [split,inner_add_left,killed,zero_add,source_C_block,inner_smul_left,inner_smul_right]
  have reversed : inner ℂ (test:BurnolL2) (fourierL2 (generatedK c))=
      star (inner ℂ (fourierL2 (generatedK c)) (test:BurnolL2)) := (inner_conj_symm _ _).symm
  rw [reversed]
  have realScalar : (starRingEnd ℂ) (sourceDamping c:ℂ)=(sourceDamping c:ℂ) := Complex.conj_ofReal _
  simp only [map_mul,map_neg,map_ofNat,realScalar,starRingEnd_apply]
  ring

private theorem nonzeroDamping (c : BurnolCompletedMellinCoordinate) : -2*(sourceDamping c:ℂ)≠0 :=
  mul_ne_zero (by norm_num) (Complex.ofReal_ne_zero.mpr (ne_of_gt (sourceDamping_pos c)))

/-- The coupling coefficient comes from the B-power source action, with no target readback in its definition. -/
theorem source_FK_compression_action (c : BurnolCompletedMellinCoordinate) :
    ((‖hPowerPhysicalCorrection (barC c)‖^2:ℝ):ℂ) • (sourceCompression c (Fphys (K c)):BurnolL2)=
      sourceSigma c • generatedK (barC c) := by
  let W := hPowerPhysicalCorrection c
  let V := physicalOutsideColumn c
  let adjV := (U c).adjoint V
  have Vo : O V=V := orthogonal_O V (outsideColumn_orthogonal c)
  have Vp : P V=0 := orthogonal_P V (outsideColumn_orthogonal c)
  have first := source_C_adjoint_block c V
  rw [Vo] at first
  have self : inner ℂ V V=((‖V‖^2:ℝ):ℂ) := by
    rw [inner_self_eq_norm_sq_to_K]
    exact (Complex.ofReal_pow _ _).symm
  rw [self] at first
  change P adjV=(-2*(sourceDamping c:ℂ)*((‖V‖^2:ℝ):ℂ)) • fourierL2 (generatedK c) at first
  have left := (evenBurnolClosedFace burnolUnscaledCommonGapRadius).toSubmoduleᗮ.inner_orthogonalProjectionOnto_eq_of_mem_left
    ⟨W,powerCorrection_orthogonal c⟩ adjV
  have right := (evenBurnolClosedFace burnolUnscaledCommonGapRadius).toSubmoduleᗮ.inner_orthogonalProjectionOnto_eq_of_mem_right
    ⟨V,outsideColumn_orthogonal c⟩ (U c W)
  change inner ℂ W (O adjV)=inner ℂ W adjV at left
  change inner ℂ (O (U c W)) V=inner ℂ (U c W) V at right
  have price : inner ℂ W (O adjV)=-sourceSigma c := by
    rw [left,ContinuousLinearMap.adjoint_inner_right,←right,sourceSigma,neg_neg]
    rfl
  have zero := congrArg P (source_right_inverse c V)
  change P (U c adjV)=P V at zero
  rw [Vp,full_split adjV,map_add,map_add,first,map_smul,map_smul,source_B_block,price] at zero
  simp only [generatedK_eq_original] at zero
  change (-2*(sourceDamping c:ℂ)*((‖V‖^2:ℝ):ℂ)) • (sourceCompression c (Fphys (K c)):BurnolL2)+
    (-2*(sourceDamping c:ℂ)*(-sourceSigma c)) • (K (barC c):BurnolL2)=0 at zero
  have factored : (-2*(sourceDamping c:ℂ)) •
      (((‖V‖^2:ℝ):ℂ) • (sourceCompression c (Fphys (K c)):BurnolL2)-
        sourceSigma c • (K (barC c):BurnolL2))=0 := by
    linear_combination (norm := module) zero
  have calculated := sub_eq_zero.mp ((smul_eq_zero.mp factored).resolve_left (nonzeroDamping c))
  have normV : ‖V‖=‖hPowerPhysicalCorrection (barC c)‖ := fourierL2.symm.norm_map _
  rw [normV] at calculated
  simpa only [generatedK_eq_original] using calculated

theorem source_conjugateK_adjoint_compression_action (c : BurnolCompletedMellinCoordinate) :
    ((‖hPowerPhysicalCorrection c‖^2:ℝ):ℂ) • ((sourceCompression c).adjoint (K (barC c)):BurnolL2)=
      star (sourceSigma c) • fourierL2 (generatedK c) := by
  let W := hPowerPhysicalCorrection c
  let V := physicalOutsideColumn c
  let UW := U c W
  have Wo : O W=W := orthogonal_O W (powerCorrection_orthogonal c)
  have Wp : P W=0 := orthogonal_P W (powerCorrection_orthogonal c)
  have first := source_B_block c W
  rw [Wo] at first
  have self : inner ℂ W W=((‖W‖^2:ℝ):ℂ) := by
    rw [inner_self_eq_norm_sq_to_K]
    exact (Complex.ofReal_pow _ _).symm
  rw [self] at first
  change P UW=(-2*(sourceDamping c:ℂ)*((‖W‖^2:ℝ):ℂ)) • generatedK (barC c) at first
  have price : inner ℂ V (O UW)=-star (sourceSigma c) := by
    have hermitian : inner ℂ V (O UW)=star (inner ℂ (O UW) V) := (inner_conj_symm _ _).symm
    rw [hermitian,sourceSigma,star_neg,neg_neg]
    rfl
  have zero := congrArg P (source_left_inverse c W)
  change P ((U c).adjoint UW)=P W at zero
  rw [Wp,full_split UW,map_add,map_add,first,map_smul,map_smul,source_C_adjoint_block,price] at zero
  simp only [generatedK_eq_original] at zero
  rw [sourceCayley_actual_adjoint] at zero
  change (-2*(sourceDamping c:ℂ)*((‖W‖^2:ℝ):ℂ)) •
    (burnolEvenAmbientProjection (sourceAdjointCayley c (K (barC c))):BurnolL2)+
    (-2*(sourceDamping c:ℂ)*(-star (sourceSigma c))) • fourierL2 (K c:BurnolL2)=0 at zero
  rw [←sourceCompression_actual_adjoint] at zero
  have factored : (-2*(sourceDamping c:ℂ)) •
      (((‖W‖^2:ℝ):ℂ) • ((sourceCompression c).adjoint (K (barC c)):BurnolL2)-
        star (sourceSigma c) • fourierL2 (K c:BurnolL2))=0 := by
    linear_combination (norm := module) zero
  have calculated := sub_eq_zero.mp ((smul_eq_zero.mp factored).resolve_left (nonzeroDamping c))
  simpa only [generatedK_eq_original] using calculated

/-- The original FK receives a complete, unprojected source action, including its outside vector. -/
theorem source_FK_full_action (c : BurnolCompletedMellinCoordinate) :
    ((‖hPowerPhysicalCorrection (barC c)‖^2:ℝ):ℂ) •
      (fourierL2 (generatedK c)+(sourceDamping c:ℂ) •
        burnolDirectRightResolvent (c.value/2) (fourierL2 (generatedK c))+
        (2*(sourceDamping c:ℂ)*((‖generatedK c‖^2:ℝ):ℂ)) • physicalOutsideColumn c)=
      sourceSigma c • generatedK (barC c) := by
  have compressed := source_FK_compression_action c
  have defect := source_C_block c (Fphys (K c))
  rw [generatedK_eq_original] at defect
  change O (U c (fourierL2 (K c:BurnolL2)))=
    (-2*(sourceDamping c:ℂ)*inner ℂ (fourierL2 (K c:BurnolL2)) (fourierL2 (K c:BurnolL2))) • physicalOutsideColumn c at defect
  have self : inner ℂ (K c:BurnolL2) (K c:BurnolL2)=((‖(K c:BurnolL2)‖^2:ℝ):ℂ) := by
    rw [inner_self_eq_norm_sq_to_K]
    exact (Complex.ofReal_pow _ _).symm
  rw [fourierL2.inner_map_map,self] at defect
  have complete := full_split (U c (fourierL2 (K c:BurnolL2)))
  rw [defect] at complete
  change fourierL2 (K c:BurnolL2)+(sourceDamping c:ℂ) • burnolDirectRightResolvent (c.value/2) (fourierL2 (K c:BurnolL2))=
    P (U c (fourierL2 (K c:BurnolL2)))+
      (-2*(sourceDamping c:ℂ)*((‖(K c:BurnolL2)‖^2:ℝ):ℂ)) • physicalOutsideColumn c at complete
  have projection : (sourceCompression c (Fphys (K c)):BurnolL2)=
      fourierL2 (K c:BurnolL2)+(sourceDamping c:ℂ) • burnolDirectRightResolvent (c.value/2) (fourierL2 (K c:BurnolL2))+
        (2*(sourceDamping c:ℂ)*((‖(K c:BurnolL2)‖^2:ℝ):ℂ)) • physicalOutsideColumn c := by
    change P (U c (fourierL2 (K c:BurnolL2)))=_
    linear_combination (norm := module) -complete
  rw [projection] at compressed
  simpa only [generatedK_eq_original] using compressed

theorem source_conjugateK_full_adjoint_action (c : BurnolCompletedMellinCoordinate) :
    ((‖hPowerPhysicalCorrection c‖^2:ℝ):ℂ) •
      (generatedK (barC c)+(sourceDamping c:ℂ) • sourceAdjoint c (generatedK (barC c))+
        (2*(sourceDamping c:ℂ)*((‖generatedK (barC c)‖^2:ℝ):ℂ)) • hPowerPhysicalCorrection c)=
      star (sourceSigma c) • fourierL2 (generatedK c) := by
  have compressed := source_conjugateK_adjoint_compression_action c
  have amplitude : physicalAmplitude c (K (barC c))=-2*inner ℂ (generatedK (barC c)) (K (barC c):BurnolL2) := by
    rw [←outsidePhysicalSource_read,outsidePhysicalSource,inner_smul_left]
    change star (-2:ℂ)*inner ℂ (generatedK (barC c)) (K (barC c):BurnolL2)=_
    simp only [star_neg,star_ofNat]
  have defect := physical_adjoint_full_defect c (K (barC c))
  rw [amplitude,generatedK_eq_original] at defect
  have self : inner ℂ (K (barC c):BurnolL2) (K (barC c):BurnolL2)=((‖(K (barC c):BurnolL2)‖^2:ℝ):ℂ) := by
    rw [inner_self_eq_norm_sq_to_K]
    exact (Complex.ofReal_pow _ _).symm
  rw [self] at defect
  change sourceAdjoint c (K (barC c)) - P (sourceAdjoint c (K (barC c)))=
    (-2*((‖(K (barC c):BurnolL2)‖^2:ℝ):ℂ)) • hPowerPhysicalCorrection c at defect
  rw [sourceCompression_actual_adjoint,sourceAdjointCayley] at compressed
  have projection : (burnolEvenAmbientProjection
      ((K (barC c):BurnolL2)+(sourceDamping c:ℂ) • sourceAdjoint c (K (barC c))):BurnolL2)=
      (K (barC c):BurnolL2)+(sourceDamping c:ℂ) • sourceAdjoint c (K (barC c))+
      (2*(sourceDamping c:ℂ)*((‖(K (barC c):BurnolL2)‖^2:ℝ):ℂ)) • hPowerPhysicalCorrection c := by
    change P ((K (barC c):BurnolL2)+(sourceDamping c:ℂ) • sourceAdjoint c (K (barC c)))=_
    rw [map_add,map_smul,physical_P]
    linear_combination (norm := module) (sourceDamping c:ℂ) • -defect
  rw [projection] at compressed
  simpa only [generatedK_eq_original] using compressed

