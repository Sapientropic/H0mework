local notation "E" => OriginalKCombCofinalPaAction.E

/-- Qualification is generated by the actual Pa projection of the complete material R field. -/
def actualPaField (material : F.Branches) : BurnolPaAmbientCarrier :=
 E (OriginalKFullSourceRAction.originalField material)

def actualNu (material : F.Branches) : BurnolL2 :=
 burnolMobiusSourceL2 (actualPaField material)

/-- The first inverse is this actual compression, not a caller's completed reconstruction. -/
theorem actual_inverse_compression_source (radius : ℝ) (material : F.Branches) :
 F.firstInverseResidual radius (Native.sourceFields (actualNu material)) =
 burnolMobiusSourceL2 (physicalTailAction radius (actualPaField material)) := by
 unfold F.firstInverseResidual
 rw [Native.source_fields_first,F.finite_word_source_value,Native.source_fields_first]
 have source := burnolSourceOnlyCoPoissonWindow_replay radius (actualPaField material)
  (OriginalKMaterialPaWindowSourceAction.source_pa_qualified material)
 change burnolSourceOnlyCoPoissonWindow radius (burnolMobiusSourceL2 (actualPaField material)) = _ at source
 simp only [F.windowEnvironment,Native.source_fields_first,actualNu]
 rw [source]
 change burnolMobiusSourceL2 (actualPaField material) - burnolMobiusSourceL2
  (physicalCutoffAction radius (actualPaField material)) = _
 exact (map_sub _ _ _).symm

theorem actual_inverse_residual_norm_cost (radius : ℝ) (material : F.Branches) :
 ‖F.firstInverseResidual radius (Native.sourceFields (actualNu material))‖ ≤
 ‖burnolMobiusSourceL2‖ * ‖outsideTailAction radius (actualPaField material : BurnolL2)‖ := by
 rw [actual_inverse_compression_source]
 exact (burnolMobiusSourceL2.le_opNorm _).trans
  (mul_le_mul_of_nonneg_left (physical_tail_norm_le_outside radius (actualPaField material)) (ContinuousLinearMap.opNorm_nonneg _))

theorem actual_source_recovery_is_finite_inverse (radius : ℝ) (material : F.Branches) :
 actualNu material - F.firstInverseResidual radius (Native.sourceFields (actualNu material)) =
 burnolMobiusSourceL2 (physicalCutoffAction radius (actualPaField material)) := by
 rw [actual_inverse_compression_source]
 change burnolMobiusSourceL2 (actualPaField material) - burnolMobiusSourceL2
  (actualPaField material-physicalCutoffAction radius (actualPaField material)) = _
 rw [map_sub]
 abel

