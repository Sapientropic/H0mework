private def linear (action : BurnolL2 →L[ℂ] BurnolL2) (input : E) : E :=
  .linear action.toLinearMap.toAddMonoidHom input
private def scale (scalar : ℂ) (input : E) : E :=
  linear (scalar • ContinuousLinearMap.id ℂ BurnolL2) input
private def sub (left right : E) : E := .add left (scale (-1) right)

/-- The complete original source retains its generated Pa and genuine unit subtractions. -/
def responseCode (c : BurnolCompletedMellinCoordinate) : E :=
  sub
    (sub
      (linear burnolEvenAmbientProjectionEndomorphism (OriginalKJointMobiusSourceCalculation.sourceCode c))
      (.const (OriginalWholeDebtRJointMobiusSource.paWave c)))
    (scale (OriginalWholeDebtRJointMobiusUnitSource.unitCoefficient c)
      (.const (burnolUnitTailResponse c 4)))

def inputCode (c : BurnolCompletedMellinCoordinate) : E :=
  linear fourierL2.toContinuousLinearEquiv.toContinuousLinearMap (responseCode c)

/-- The R output is generated by its actual Fourier input, never supplied as a leaf. -/
def code (c : BurnolCompletedMellinCoordinate) : E :=
  linear (burnolDirectRightResolventCLM c) (inputCode c)

theorem code_eval (c : BurnolCompletedMellinCoordinate) (environment : Env Value Var) :
    (code c).eval environment =
      burnolDirectRightResolventCLM c ((inputCode c).eval environment) := rfl

theorem code_effect (c : BurnolCompletedMellinCoordinate)
    (environment increment : Env Value Var) :
    (code c).effect environment increment =
      burnolDirectRightResolventCLM c ((inputCode c).effect environment increment) := rfl

theorem operation_budget (c : BurnolCompletedMellinCoordinate) :
    0 < remaining (code c) := by
  change 0 < remaining (inputCode c) + 1
  omega

def reader (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (half : Half observation) {current : CanonicalUnitArithmeticRoot.V.Current}
    (occurrence : Base.toLedgerRoot.source.source.toRootSource.actual.OccurrenceAt current) :
    RootGeneratedDebtActivationJointSource.OwnerFree.Raw (Value := Value) (Var := Var) (sort := ()) :=
  { environment := sourceEnvironment
    expression := code (coordinate observation nontrivial half occurrence) }

theorem reader_source (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (half : Half observation) {current : CanonicalUnitArithmeticRoot.V.Current}
    (occurrence : Base.toLedgerRoot.source.source.toRootSource.actual.OccurrenceAt current) :
    (reader observation nontrivial half occurrence).environment = sourceEnvironment ∧
      (coordinate observation nontrivial half occurrence).value = observation.coordinate ∧
      (reader observation nontrivial half occurrence).expression =
        code (coordinate observation nontrivial half occurrence) := ⟨rfl, rfl, rfl⟩

