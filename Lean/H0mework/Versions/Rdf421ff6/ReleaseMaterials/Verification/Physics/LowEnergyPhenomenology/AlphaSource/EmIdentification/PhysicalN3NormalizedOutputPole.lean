  materialJointNumerator jointGenerator jointResolvent jointPolynomial compressionPolynomial
  physicalN3InputEnergyRead physicalN3InputEnergyNumerator
  physicalN3OutputEnergyNumerator physicalN3OutputEnergyGerm actualElectronPhysicalUnit

/-- The whole-output order is generated from the original vector germ, not identified with
the order visible to its seed pairing. -/
def physicalN3OutputPoleOrder (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (leg : CompositeLeg) (pole : N3SourceEnergyPole p F leg) : ℕ :=
  (-(meromorphicOrderAt (physicalN3OutputEnergyGerm p F leg) pole.val).untop₀).toNat

/-- The canonical whole-output leading vector of the original source germ at the pole. -/
def physicalN3OutputPoleLeading (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (leg : CompositeLeg) (pole : N3SourceEnergyPole p F leg) : H :=
  meromorphicTrailingCoeffAt (physicalN3OutputEnergyGerm p F leg) pole.val

/-- The normalized exterior-state vector generated by the source pole. -/
def physicalN3OutputPoleUnit (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (leg : CompositeLeg) (pole : N3SourceEnergyPole p F leg) : H :=
  (‖physicalN3OutputPoleLeading p F leg pole‖ : ℂ)⁻¹ •
    physicalN3OutputPoleLeading p F leg pole

/-- The nonreal boundary curve `a + iσ` converges inside the source nonreal domain. -/
private theorem n3_boundary_curve (a : ℂ) (ha : a.im = 0) :
    Tendsto (fun σ : ℝ => a + Complex.I * (σ:ℂ)) (nhdsWithin 0 (Set.Ioi 0))
      (nhdsWithin a {z : ℂ | z.im ≠ 0}) := by
  rw [tendsto_nhdsWithin_iff]
  constructor
  · have cont : Continuous (fun σ : ℝ => a + Complex.I * (σ:ℂ)) :=
      continuous_const.add (continuous_const.mul Complex.continuous_ofReal)
    simpa [ha] using (cont.tendsto 0).mono_left nhdsWithin_le_nhds
  · filter_upwards [self_mem_nhdsWithin] with σ hσ
    have pos : 0 < σ := Set.mem_Ioi.mp hσ
    have him : (a + Complex.I * (σ:ℂ)).im = σ := by
      simp only [Complex.add_im, Complex.mul_im, Complex.I_re, Complex.I_im,
        Complex.ofReal_re, Complex.ofReal_im, zero_mul, one_mul, zero_add, ha]
    rw [him]
    exact ne_of_gt pos

/-- The nonreal boundary filter at a real pole is nonempty: the `a+iσ` curve reaches it. -/
private theorem n3_boundary_neBot (a : ℂ) (ha : a.im = 0) :
    (nhdsWithin a {z : ℂ | z.im ≠ 0}).NeBot := by
  have hf : NeBot (nhdsWithin (0:ℝ) (Set.Ioi 0)) := inferInstance
  exact (hf.map (fun σ : ℝ => a + Complex.I * (σ:ℂ))).mono (n3_boundary_curve a ha)

/-- The nonreal boundary filter sits inside the punctured neighborhood of a real pole. -/
private theorem n3_boundary_le_nhdsNE (a : ℂ) (ha : a.im = 0) :
    nhdsWithin a {z : ℂ | z.im ≠ 0} ≤ 𝓝[≠] a :=
  nhdsWithin_mono _ (fun _z hz hmem =>
    hz ((congrArg Complex.im (Set.mem_singleton_iff.mp hmem)).trans ha))

/-- Generic inner pairing convergence on an abstract Hilbert space. -/
private theorem n3_inner_tendsto {I E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (x : E) {v : I → E} {L : E} {l : Filter I}
    (hv : Tendsto v l (𝓝 L)) :
    Tendsto (fun z => inner ℂ x (v z)) l (𝓝 (inner ℂ x L)) :=
  Filter.Tendsto.inner (tendsto_const_nhds : Tendsto (fun _ : I => x) l (𝓝 x)) hv

/-- Generic diagonal pairing convergence through a continuous linear map. -/
private theorem n3_inner_A_tendsto {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] (A : E→L[ℂ]E) {u : ℂ → E} {v : E} {l : Filter ℂ}
    (hu : Tendsto u l (𝓝 v)) :
    Tendsto (fun z => inner ℂ (u z) (A (u z))) l (𝓝 (inner ℂ v (A v))) :=
  Filter.Tendsto.inner hu ((A.continuous.tendsto v).comp hu)

/-- Scalar pullback of a pairing. -/
private theorem n3_inner_smul {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (x : E) (v : E) (c : ℂ) : inner ℂ x (c • v) = c * inner ℂ x v :=
  inner_smul_right _ _ _

/-- Phase invariance of the diagonal pairing: a unit-modulus scalar cancels. -/
private theorem n3_phase_inner {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (ζ : ℂ) (hζ : ‖ζ‖ = 1) (A : E→L[ℂ]E) (v : E) :
    inner ℂ (ζ • v) (A (ζ • v)) = inner ℂ v (A v) := by
  have hmul : ζ * (starRingEnd ℂ) ζ = 1 := by
    simpa [hζ] using RCLike.mul_conj ζ
  rw [map_smul, inner_smul_right, inner_smul_left, ← mul_assoc, hmul, one_mul]

/-- Seed pairing of the germ is the scalar input read on the nonreal domain. -/
private theorem n3_pair_germ_read (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (leg : CompositeLeg) {z : ℂ} (nonreal : z.im ≠ 0) :
    inner ℂ (actualElectronPhysicalSeed leg) (physicalN3OutputEnergyGerm p F leg z) =
      physicalN3InputEnergyRead p F leg z := by
  rw [physical_n3_output_germ_original p F leg z nonreal,
    ← physicalN3InputEnergyRead.eq_def]

/-- The whole-output meromorphic order at a source pole is strictly negative: a
nonnegative order would give the seed pairing a finite limit along the boundary curve,
and the positive scalar pole order would force the nonzero canonical leading to be zero. -/
theorem physical_n3_output_order_negative (p : PhysicalMomentum)
    (F : GaussUnitaryHistory.Index) (leg : CompositeLeg)
    (pole : N3SourceEnergyPole p F leg) :
    meromorphicOrderAt (physicalN3OutputEnergyGerm p F leg) pole.val < 0 := by
  by_contra hneg
  have ho : (0 : WithTop ℤ) ≤ meromorphicOrderAt
      (physicalN3OutputEnergyGerm p F leg) pole.val := le_of_not_gt hneg
  obtain ⟨c, hc⟩ := tendsto_nhds_of_meromorphicOrderAt_nonneg
    (physical_n3_output_germ_meromorphic p F leg pole.val) ho
  have hreal : pole.val.im = 0 :=
    physical_n3_energy_pole_real p F leg pole.val pole.property
  have curve : Tendsto (fun σ : ℝ => pole.val + Complex.I * (σ:ℂ))
      (nhdsWithin 0 (Set.Ioi 0)) (𝓝[≠] pole.val) := by
    rw [tendsto_nhdsWithin_iff]
    constructor
    · have cont : Continuous (fun σ : ℝ => pole.val + Complex.I * (σ:ℂ)) :=
        continuous_const.add (continuous_const.mul Complex.continuous_ofReal)
      simpa [hreal] using (cont.tendsto 0).mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with σ hσ
      have pos : 0 < σ := Set.mem_Ioi.mp hσ
      simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
      intro heq
      have him := congrArg Complex.im heq
      simp only [Complex.add_im, Complex.mul_im, Complex.I_re, Complex.I_im,
        Complex.ofReal_re, Complex.ofReal_im, zero_mul, one_mul, zero_add, hreal] at him
      linarith
  have pairlim : Tendsto (fun σ : ℝ => inner ℂ (actualElectronPhysicalSeed leg)
      (physicalN3OutputEnergyGerm p F leg (pole.val + Complex.I * (σ:ℂ))))
      (nhdsWithin 0 (Set.Ioi 0))
      (𝓝 (inner ℂ (actualElectronPhysicalSeed leg) c)) :=
    (n3_inner_tendsto (actualElectronPhysicalSeed leg) hc).comp curve
  have base : Tendsto (fun σ : ℝ => pole.val + Complex.I * (σ:ℂ) - pole.val)
      (nhdsWithin 0 (Set.Ioi 0)) (𝓝 0) := by
    have cont : Continuous (fun σ : ℝ => pole.val + Complex.I * (σ:ℂ) - pole.val) :=
      (continuous_const.add (continuous_const.mul Complex.continuous_ofReal)).sub
        continuous_const
    simpa [hreal] using (cont.tendsto 0).mono_left nhdsWithin_le_nhds
  have mpos := physical_n3_energy_pole_order_positive p F leg pole.val pole.property
  have hpow : Tendsto (fun σ : ℝ =>
      (pole.val + Complex.I * (σ:ℂ) - pole.val)^
        (poleOrder (physicalN3InputEnergyFraction p F leg) pole.val))
      (nhdsWithin 0 (Set.Ioi 0)) (𝓝 0) := by
    simpa only [zero_pow mpos.ne'] using
      base.pow (poleOrder (physicalN3InputEnergyFraction p F leg) pole.val)
  have prod : Tendsto (fun σ : ℝ =>
      (pole.val + Complex.I * (σ:ℂ) - pole.val)^
        (poleOrder (physicalN3InputEnergyFraction p F leg) pole.val) *
        inner ℂ (actualElectronPhysicalSeed leg)
          (physicalN3OutputEnergyGerm p F leg (pole.val + Complex.I * (σ:ℂ))))
      (nhdsWithin 0 (Set.Ioi 0)) (𝓝 0) := by
    simpa only [Function.comp_apply, zero_mul] using hpow.mul pairlim
  have heq : (fun σ : ℝ =>
      (pole.val + Complex.I * (σ:ℂ) - pole.val)^
        (poleOrder (physicalN3InputEnergyFraction p F leg) pole.val) *
        inner ℂ (actualElectronPhysicalSeed leg)
          (physicalN3OutputEnergyGerm p F leg (pole.val + Complex.I * (σ:ℂ))))
      =ᶠ[nhdsWithin 0 (Set.Ioi 0)]
      fun σ : ℝ => (pole.val + Complex.I * (σ:ℂ) - pole.val)^
        (poleOrder (physicalN3InputEnergyFraction p F leg) pole.val) *
        physicalN3InputEnergyRead p F leg (pole.val + Complex.I * (σ:ℂ)) := by
    filter_upwards [self_mem_nhdsWithin] with σ hσ
    have pos : 0 < σ := Set.mem_Ioi.mp hσ
    have him : (pole.val + Complex.I * (σ:ℂ)).im = σ := by
      simp only [Complex.add_im, Complex.mul_im, Complex.I_re, Complex.I_im,
        Complex.ofReal_re, Complex.ofReal_im, zero_mul, one_mul, zero_add, hreal]
    have nonreal : (pole.val + Complex.I * (σ:ℂ)).im ≠ 0 := by
      rw [him]
      exact ne_of_gt pos
    rw [n3_pair_germ_read p F leg nonreal]
  have hlim := physical_n3_energy_pole_boundary_limit p F leg pole
  have uniq := tendsto_nhds_unique (prod.congr' heq) hlim
  exact (physical_n3_energy_pole_leading_nonzero p F leg pole.val pole.property)
    uniq.symm

/-- The extracted whole-output pole order is positive. -/
theorem physical_n3_output_pole_order_positive (p : PhysicalMomentum)
    (F : GaussUnitaryHistory.Index) (leg : CompositeLeg)
    (pole : N3SourceEnergyPole p F leg) :
    0 < physicalN3OutputPoleOrder p F leg pole := by
  have hneg := physical_n3_output_order_negative p F leg pole
  have hnetop : meromorphicOrderAt (physicalN3OutputEnergyGerm p F leg) pole.val ≠ ⊤ :=
    ne_of_lt (lt_of_lt_of_le hneg le_top)
  have hlt : (meromorphicOrderAt (physicalN3OutputEnergyGerm p F leg) pole.val).untop₀
      < 0 := by
    have hcoe := WithTop.coe_untop₀_of_ne_top hnetop
    rw [← hcoe] at hneg
    exact WithTop.coe_lt_coe.mp hneg
  show 0 < (-(meromorphicOrderAt (physicalN3OutputEnergyGerm p F leg)
      pole.val).untop₀).toNat
  apply Nat.pos_iff_ne_zero.mpr
  intro hzero
  exact (not_le_of_gt (neg_pos.mpr hlt)) (Int.toNat_eq_zero.mp hzero)

/-- The canonical whole-output leading vector is nonzero. -/
theorem physical_n3_output_pole_leading_nonzero (p : PhysicalMomentum)
    (F : GaussUnitaryHistory.Index) (leg : CompositeLeg)
    (pole : N3SourceEnergyPole p F leg) :
    physicalN3OutputPoleLeading p F leg pole ≠ 0 := by
  have hnetop : meromorphicOrderAt (physicalN3OutputEnergyGerm p F leg) pole.val ≠ ⊤ :=
    ne_of_lt (lt_of_lt_of_le
      (physical_n3_output_order_negative p F leg pole) le_top)
  exact (physical_n3_output_germ_meromorphic p F leg
    pole.val).meromorphicTrailingCoeffAt_ne_zero hnetop

/-- The whole-output weighted limit on the nonreal boundary: `(z - pole)^M • germ z`
tends to the canonical leading vector. This is the vector counterpart of the scalar
weighted pole limit, with natural-power weighting `M = physicalN3OutputPoleOrder`. -/
private theorem n3_output_germ_pole_boundary_limit (p : PhysicalMomentum)
    (F : GaussUnitaryHistory.Index) (leg : CompositeLeg)
    (pole : N3SourceEnergyPole p F leg) :
    Tendsto (fun z : ℂ => (z - pole.val)^(physicalN3OutputPoleOrder p F leg pole) •
        physicalN3OutputEnergyGerm p F leg z)
      (nhdsWithin pole.val {z : ℂ | z.im ≠ 0})
      (𝓝 (physicalN3OutputPoleLeading p F leg pole)) := by
  have hreal := physical_n3_energy_pole_real p F leg pole.val pole.property
  have hlim := (physical_n3_output_germ_meromorphic p F leg
      pole.val).tendsto_nhds_meromorphicTrailingCoeffAt.mono_left
    (n3_boundary_le_nhdsNE pole.val hreal)
  have hneg := physical_n3_output_order_negative p F leg pole
  have hnetop : meromorphicOrderAt (physicalN3OutputEnergyGerm p F leg) pole.val ≠ ⊤ :=
    ne_of_lt (lt_of_lt_of_le hneg le_top)
  have hlt : (meromorphicOrderAt (physicalN3OutputEnergyGerm p F leg) pole.val).untop₀
      < 0 := by
    have hcoe := WithTop.coe_untop₀_of_ne_top hnetop
    rw [← hcoe] at hneg
    exact WithTop.coe_lt_coe.mp hneg
  have hM : ((physicalN3OutputPoleOrder p F leg pole : ℕ) : ℤ) =
      -(meromorphicOrderAt (physicalN3OutputEnergyGerm p F leg) pole.val).untop₀ := by
    show ((Int.toNat (-(meromorphicOrderAt (physicalN3OutputEnergyGerm p F leg)
        pole.val).untop₀) : ℕ) : ℤ) =
      -(meromorphicOrderAt (physicalN3OutputEnergyGerm p F leg) pole.val).untop₀
    exact Int.toNat_of_nonneg (le_of_lt (neg_pos.mpr hlt))
  refine hlim.congr' ?_
  filter_upwards with z
  show (z - pole.val)^(-(meromorphicOrderAt (physicalN3OutputEnergyGerm p F leg)
      pole.val).untop₀) • physicalN3OutputEnergyGerm p F leg z =
      (z - pole.val)^(physicalN3OutputPoleOrder p F leg pole) •
        physicalN3OutputEnergyGerm p F leg z
  rw [← zpow_natCast, hM]

theorem physical_n3_output_pole_boundary_limit (p : PhysicalMomentum)
    (F : GaussUnitaryHistory.Index) (leg : CompositeLeg)
    (pole : N3SourceEnergyPole p F leg) :
    Tendsto (fun z : ℂ => (z - pole.val)^physicalN3OutputPoleOrder p F leg pole •
        actualElectronPhysicalResponse p F z leg)
      (nhdsWithin pole.val {z : ℂ | z.im ≠ 0})
      (𝓝 (physicalN3OutputPoleLeading p F leg pole)) := by
  apply (n3_output_germ_pole_boundary_limit p F leg pole).congr'
  filter_upwards [self_mem_nhdsWithin] with z hz
  exact congrArg (fun v : H => (z - pole.val)^physicalN3OutputPoleOrder p F leg pole • v)
    (physical_n3_output_germ_original p F leg z hz)

/-- Generic pole kernel on an abstract normed space: if `(T - z·1)(v z) = x` eventually on
the boundary and `(z-a)^M • v z → L` with `M > 0`, then `(T - a·1) L = 0`. The scaled
original identity `(T-z·1)Rseed = seed` forces `(z-a)^M • x → 0`, while the operator pencil
applied to the weighted germ converges to `(T-a·1)L`. -/
private theorem n3_output_pole_kernel {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (T : E→L[ℂ]E) (a : ℂ) (M : ℕ) (v : ℂ → E) (x L : E) {l : Filter ℂ} [l.NeBot]
    (hl : Tendsto (fun z : ℂ => z) l (𝓝 a))
    (hv : Tendsto (fun z => (z - a)^M • v z) l (𝓝 L))
    (heq : ∀ᶠ z in l, (T - z•(1 : E→L[ℂ]E)) (v z) = x)
    (Mpos : 0 < M) :
    (T - a•(1 : E→L[ℂ]E)) L = 0 := by
  have hz : Tendsto (fun z : ℂ => z - a) l (𝓝 0) := by
    simpa using hl.sub
      (tendsto_const_nhds : Tendsto (fun _ : ℂ => a) l (𝓝 a))
  have hpow : Tendsto (fun z : ℂ => (z - a)^M) l (𝓝 0) := by
    simpa only [zero_pow Mpos.ne'] using hz.pow M
  have hleft : Tendsto (fun z => (T - a•(1 : E→L[ℂ]E)) ((z - a)^M • v z)) l
      (𝓝 ((T - a•(1 : E→L[ℂ]E)) L)) :=
    ((T - a•(1 : E→L[ℂ]E)).continuous.tendsto L).comp hv
  have hright : Tendsto (fun z => (a - z) • ((z - a)^M • v z)) l (𝓝 0) := by
    have hz' : Tendsto (fun z : ℂ => a - z) l (𝓝 (a - a)) :=
      (tendsto_const_nhds : Tendsto (fun _ : ℂ => a) l (𝓝 a)).sub hl
    have hz'' : Tendsto (fun z : ℂ => a - z) l (𝓝 0) := by
      simpa using hz'
    have hsmul := hz''.smul hv
    rw [zero_smul] at hsmul
    exact hsmul
  have key : ∀ z : ℂ, (T - z•(1 : E→L[ℂ]E)) ((z - a)^M • v z) =
      (T - a•(1 : E→L[ℂ]E)) ((z - a)^M • v z) + (a - z) • ((z - a)^M • v z) := by
    intro z
    have hsplit : (T - z•(1 : E→L[ℂ]E)) =
        (T - a•(1 : E→L[ℂ]E)) + (a - z)•(1 : E→L[ℂ]E) := by
      rw [sub_smul]
      exact (sub_add_sub_cancel _ _ _).symm
    rw [hsplit, add_apply, smul_apply, one_apply_eq_self]
  have hmain : Tendsto (fun z => (T - z•(1 : E→L[ℂ]E)) ((z - a)^M • v z)) l
      (𝓝 ((T - a•(1 : E→L[ℂ]E)) L)) := by
    have hsum := hleft.add hright
    rw [add_zero] at hsum
    exact hsum.congr' (Eventually.of_forall (fun z => (key z).symm))
  have hzero : Tendsto (fun z => (T - z•(1 : E→L[ℂ]E)) ((z - a)^M • v z)) l (𝓝 0) := by
    have hp := hpow.smul
      (tendsto_const_nhds : Tendsto (fun _ : ℂ => x) l (𝓝 x))
    rw [zero_smul] at hp
    apply Tendsto.congr' _ hp
    filter_upwards [heq] with z hz2
    rw [map_smul, hz2]
  exact tendsto_nhds_unique hmain hzero

attribute [local irreducible] physicalN3OutputPoleLeading physicalN3OutputPoleUnit

/-- The canonical whole-output leading vector lies in the kernel of the original
physical generator at the pole: the scaled seed identity `(T-z·1)Rseed = seed` vanishes
to positive order along the nonreal boundary. -/
theorem physical_n3_output_pole_kernel (p : PhysicalMomentum)
    (F : GaussUnitaryHistory.Index) (leg : CompositeLeg)
    (pole : N3SourceEnergyPole p F leg) :
    jointGenerator p F pole.val 0 (physicalN3OutputPoleLeading p F leg pole) = (0 : H) := by
  have hreal := physical_n3_energy_pole_real p F leg pole.val pole.property
  let : (nhdsWithin pole.val {z : ℂ | z.im ≠ 0}).NeBot := n3_boundary_neBot _ hreal
  have hlim : Tendsto (fun z : ℂ => z) (nhdsWithin pole.val {z : ℂ | z.im ≠ 0})
      (𝓝 pole.val) := continuous_id.continuousWithinAt
  have heq : ∀ᶠ z in nhdsWithin pole.val {z : ℂ | z.im ≠ 0},
      (jointGenerator p F 0 0 - z•(1 : H→L[ℂ]H))
        (actualElectronPhysicalResponse p F z leg) = actualElectronPhysicalSeed leg := by
    filter_upwards [self_mem_nhdsWithin] with z hz
    have hop : (jointGenerator p F 0 0 - z•(1 : H→L[ℂ]H))
        (actualElectronPhysicalResponse p F z leg) = actualElectronPhysicalSeed leg :=
      (congrArg (fun A : H→L[ℂ]H => A (actualElectronPhysicalResponse p F z leg))
        (PreparationVacuumCurrentRegularAnchor.jointGenerator_spectral_shift p F z
          (0:Field289)).symm).trans
        (actual_electron_physical_response_equation p F z hz leg)
    exact hop
  have hgen := n3_output_pole_kernel (jointGenerator p F 0 0) pole.val
    (physicalN3OutputPoleOrder p F leg pole) (fun z => actualElectronPhysicalResponse p F z leg)
    (actualElectronPhysicalSeed leg) (physicalN3OutputPoleLeading p F leg pole) hlim
    (physical_n3_output_pole_boundary_limit p F leg pole) heq
    (physical_n3_output_pole_order_positive p F leg pole)
  exact (congrArg (fun A : H→L[ℂ]H => A (physicalN3OutputPoleLeading p F leg pole))
    (PreparationVacuumCurrentRegularAnchor.jointGenerator_spectral_shift p F pole.val
      (0:Field289))).trans hgen

/-- The normalized exterior-state vector has norm one. -/
theorem physical_n3_output_pole_unit_norm (p : PhysicalMomentum)
    (F : GaussUnitaryHistory.Index) (leg : CompositeLeg)
    (pole : N3SourceEnergyPole p F leg) :
    ‖physicalN3OutputPoleUnit p F leg pole‖ = 1 := by
  unfold physicalN3OutputPoleUnit
  rw [norm_smul, norm_inv, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (norm_nonneg _)]
  exact inv_mul_cancel₀ (norm_ne_zero_iff.mpr
    (physical_n3_output_pole_leading_nonzero p F leg pole))

/-- The normalized exterior-state vector still lies in the original generator kernel. -/
theorem physical_n3_output_pole_unit_kernel (p : PhysicalMomentum)
    (F : GaussUnitaryHistory.Index) (leg : CompositeLeg)
    (pole : N3SourceEnergyPole p F leg) :
    jointGenerator p F pole.val 0 (physicalN3OutputPoleUnit p F leg pole) = (0 : H) := by
  unfold physicalN3OutputPoleUnit
  rw [map_smul, physical_n3_output_pole_kernel p F leg pole, smul_zero]

/-- The whole-output order dominates the scalar input-visible order: if `m_input > M`,
the positive-remainder factor would force the nonzero scalar leading coefficient to zero.
The orders are never identified; the whole germ may carry strictly more. -/
theorem physical_n3_output_order_ge_input (p : PhysicalMomentum)
    (F : GaussUnitaryHistory.Index) (leg : CompositeLeg)
    (pole : N3SourceEnergyPole p F leg) :
    poleOrder (physicalN3InputEnergyFraction p F leg) pole.val ≤
      physicalN3OutputPoleOrder p F leg pole := by
  set m := poleOrder (physicalN3InputEnergyFraction p F leg) pole.val with hm
  set M := physicalN3OutputPoleOrder p F leg pole with hM
  by_contra hcon
  push Not at hcon
  have hreal := physical_n3_energy_pole_real p F leg pole.val pole.property
  have hbnd := n3_boundary_curve pole.val hreal
  have hvec := (n3_output_germ_pole_boundary_limit p F leg pole).comp hbnd
  have hpair : Tendsto (fun σ : ℝ => inner ℂ (actualElectronPhysicalSeed leg)
      ((pole.val + Complex.I * (σ:ℂ) - pole.val)^M •
        physicalN3OutputEnergyGerm p F leg (pole.val + Complex.I * (σ:ℂ))))
      (nhdsWithin 0 (Set.Ioi 0))
      (𝓝 (inner ℂ (actualElectronPhysicalSeed leg)
        (physicalN3OutputPoleLeading p F leg pole))) :=
    n3_inner_tendsto (actualElectronPhysicalSeed leg) hvec
  have hpair' : Tendsto (fun σ : ℝ =>
      (pole.val + Complex.I * (σ:ℂ) - pole.val)^M *
        inner ℂ (actualElectronPhysicalSeed leg)
          (physicalN3OutputEnergyGerm p F leg (pole.val + Complex.I * (σ:ℂ))))
      (nhdsWithin 0 (Set.Ioi 0))
      (𝓝 (inner ℂ (actualElectronPhysicalSeed leg)
        (physicalN3OutputPoleLeading p F leg pole))) :=
    hpair.congr' (Eventually.of_forall (fun σ =>
      n3_inner_smul (actualElectronPhysicalSeed leg) _ _))
  have base : Tendsto (fun σ : ℝ => pole.val + Complex.I * (σ:ℂ) - pole.val)
      (nhdsWithin 0 (Set.Ioi 0)) (𝓝 0) := by
    have cont : Continuous (fun σ : ℝ => pole.val + Complex.I * (σ:ℂ) - pole.val) :=
      (continuous_const.add (continuous_const.mul Complex.continuous_ofReal)).sub
        continuous_const
    simpa [hreal] using (cont.tendsto 0).mono_left nhdsWithin_le_nhds
  have subpos : 0 < m - M := Nat.sub_pos_of_lt hcon
  have hpow0 : Tendsto (fun σ : ℝ =>
      (pole.val + Complex.I * (σ:ℂ) - pole.val)^(m - M))
      (nhdsWithin 0 (Set.Ioi 0)) (𝓝 0) := by
    simpa only [zero_pow subpos.ne'] using base.pow (m - M)
  have hprod : Tendsto (fun σ : ℝ =>
      (pole.val + Complex.I * (σ:ℂ) - pole.val)^(m - M) *
        ((pole.val + Complex.I * (σ:ℂ) - pole.val)^M *
          inner ℂ (actualElectronPhysicalSeed leg)
            (physicalN3OutputEnergyGerm p F leg (pole.val + Complex.I * (σ:ℂ)))))
      (nhdsWithin 0 (Set.Ioi 0)) (𝓝 0) := by
    simpa only [Function.comp_apply, zero_mul] using hpow0.mul hpair'
  have hprod' : Tendsto (fun σ : ℝ =>
      (pole.val + Complex.I * (σ:ℂ) - pole.val)^m *
        physicalN3InputEnergyRead p F leg (pole.val + Complex.I * (σ:ℂ)))
      (nhdsWithin 0 (Set.Ioi 0)) (𝓝 0) := by
    apply hprod.congr'
    filter_upwards [self_mem_nhdsWithin] with σ hσ
    have pos : 0 < σ := Set.mem_Ioi.mp hσ
    have him : (pole.val + Complex.I * (σ:ℂ)).im = σ := by
      simp only [Complex.add_im, Complex.mul_im, Complex.I_re, Complex.I_im,
        Complex.ofReal_re, Complex.ofReal_im, zero_mul, one_mul, zero_add, hreal]
    have nonreal : (pole.val + Complex.I * (σ:ℂ)).im ≠ 0 := by
      rw [him]
      exact ne_of_gt pos
    rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hcon.le]
    rw [n3_pair_germ_read p F leg nonreal]
  have hinput := physical_n3_energy_pole_boundary_limit p F leg pole
  have uniq := tendsto_nhds_unique hprod' hinput
  exact (physical_n3_energy_pole_leading_nonzero p F leg pole.val pole.property)
    uniq.symm

/-- Generic normalized pole read on an abstract Hilbert space: the weighted-vector limit
`(z-a)^M • v z → L` with nonzero `L` lifts to a diagonal-pairing limit of the normalized
vector, invariant under the nonvanishing scalar phase `(z-a)^M/‖(z-a)^M‖`. -/
private theorem n3_normalized_pole_read {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] (a : ℂ) (M : ℕ) (v : ℂ → E) (L : E) (A : E→L[ℂ]E)
    {l : Filter ℂ}
    (hlim : Tendsto (fun z : ℂ => (z - a)^M • v z) l (𝓝 L))
    (hne : ∀ᶠ z in l, z - a ≠ 0)
    (hnz : L ≠ 0) :
    Tendsto (fun z : ℂ => inner ℂ ((‖v z‖ : ℂ)⁻¹ • v z) (A ((‖v z‖ : ℂ)⁻¹ • v z)))
      l (𝓝 (inner ℂ ((‖L‖ : ℂ)⁻¹ • L) (A ((‖L‖ : ℂ)⁻¹ • L)))) := by
  have hnorm : Tendsto (fun z : ℂ =>
      (‖(z - a)^M • v z‖ : ℂ)⁻¹ • ((z - a)^M • v z))
      l (𝓝 ((‖L‖ : ℂ)⁻¹ • L)) := by
    have hnv : Tendsto (fun z : ℂ => ‖(z - a)^M • v z‖) l (𝓝 ‖L‖) := hlim.norm
    have hof : Tendsto (fun z : ℂ => (‖(z - a)^M • v z‖ : ℂ)) l (𝓝 (‖L‖ : ℂ)) :=
      (Complex.continuous_ofReal.tendsto ‖L‖).comp hnv
    have hinv : Tendsto (fun z : ℂ => ((‖(z - a)^M • v z‖ : ℂ))⁻¹) l
        (𝓝 ((‖L‖ : ℂ)⁻¹)) :=
      hof.inv₀ (by exact_mod_cast (norm_ne_zero_iff.mpr hnz))
    exact hinv.smul hlim
  have hpair : Tendsto (fun z : ℂ => inner ℂ
      ((‖(z - a)^M • v z‖ : ℂ)⁻¹ • ((z - a)^M • v z))
      (A ((‖(z - a)^M • v z‖ : ℂ)⁻¹ • ((z - a)^M • v z))))
      l (𝓝 (inner ℂ ((‖L‖ : ℂ)⁻¹ • L) (A ((‖L‖ : ℂ)⁻¹ • L)))) :=
    n3_inner_A_tendsto A hnorm
  have hphase : (fun z : ℂ => inner ℂ
      ((‖(z - a)^M • v z‖ : ℂ)⁻¹ • ((z - a)^M • v z))
      (A ((‖(z - a)^M • v z‖ : ℂ)⁻¹ • ((z - a)^M • v z))))
      =ᶠ[l]
      fun z : ℂ => inner ℂ ((‖v z‖ : ℂ)⁻¹ • v z) (A ((‖v z‖ : ℂ)⁻¹ • v z)) := by
    filter_upwards [hne] with z hz
    have hs : (z - a)^M ≠ 0 := pow_ne_zero _ hz
    have hζ : ‖(z - a)^M / ‖(z - a)^M‖‖ = 1 := by
      rw [norm_div, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (norm_nonneg _)]
      exact div_self (norm_ne_zero_iff.mpr hs)
    have hdecomp : (‖(z - a)^M • v z‖ : ℂ)⁻¹ • ((z - a)^M • v z) =
        ((z - a)^M / ‖(z - a)^M‖) • ((‖v z‖ : ℂ)⁻¹ • v z) := by
      rw [norm_smul, smul_smul, smul_smul]
      congr 1
      push_cast
      rw [mul_inv, div_eq_mul_inv]
      ring
    rw [hdecomp]
    exact n3_phase_inner ((z - a)^M / ‖(z - a)^M‖) hζ A ((‖v z‖ : ℂ)⁻¹ • v z)
  exact hpair.congr' hphase

/-- The normalized external-state detector read on the whole-output germ: a thin
specialization of the generic normalized-pole read to the source pole boundary. -/
private theorem n3_normalized_germ_pole_read (p : PhysicalMomentum)
    (F : GaussUnitaryHistory.Index) (leg : CompositeLeg)
    (pole : N3SourceEnergyPole p F leg) (A : H→L[ℂ]H) :
    Tendsto (fun z : ℂ => inner ℂ
        ((‖physicalN3OutputEnergyGerm p F leg z‖ : ℂ)⁻¹ •
          physicalN3OutputEnergyGerm p F leg z)
        (A ((‖physicalN3OutputEnergyGerm p F leg z‖ : ℂ)⁻¹ •
          physicalN3OutputEnergyGerm p F leg z)))
      (nhdsWithin pole.val {z : ℂ | z.im ≠ 0})
      (𝓝 (inner ℂ ((‖physicalN3OutputPoleLeading p F leg pole‖ : ℂ)⁻¹ •
        physicalN3OutputPoleLeading p F leg pole)
        (A ((‖physicalN3OutputPoleLeading p F leg pole‖ : ℂ)⁻¹ •
          physicalN3OutputPoleLeading p F leg pole)))) := by
  have hreal := physical_n3_energy_pole_real p F leg pole.val pole.property
  have hne : ∀ᶠ z in nhdsWithin pole.val {z : ℂ | z.im ≠ 0}, z - pole.val ≠ 0 := by
    filter_upwards [self_mem_nhdsWithin] with z hz
    exact sub_ne_zero.mpr (fun h => hz ((congrArg Complex.im h).trans hreal))
  have hgen := n3_normalized_pole_read pole.val (physicalN3OutputPoleOrder p F leg pole)
    (physicalN3OutputEnergyGerm p F leg) (physicalN3OutputPoleLeading p F leg pole) A
    (n3_output_germ_pole_boundary_limit p F leg pole) hne
    (physical_n3_output_pole_leading_nonzero p F leg pole)
  exact hgen

theorem physical_n3_normalized_output_pole_read (p : PhysicalMomentum)
    (F : GaussUnitaryHistory.Index) (leg : CompositeLeg)
    (pole : N3SourceEnergyPole p F leg) (A : H→L[ℂ]H) :
    Tendsto (fun z : ℂ => inner ℂ (actualElectronPhysicalUnit p F z leg)
        (A (actualElectronPhysicalUnit p F z leg)))
      (nhdsWithin pole.val {z : ℂ | z.im ≠ 0})
      (𝓝 (inner ℂ (physicalN3OutputPoleUnit p F leg pole)
        (A (physicalN3OutputPoleUnit p F leg pole)))) := by
  rw [physicalN3OutputPoleUnit.eq_def]
  apply (n3_normalized_germ_pole_read p F leg pole A).congr'
  filter_upwards [self_mem_nhdsWithin] with z hz
  have unit : (‖physicalN3OutputEnergyGerm p F leg z‖ : ℂ)⁻¹ •
      physicalN3OutputEnergyGerm p F leg z = actualElectronPhysicalUnit p F z leg := by
    rw [physical_n3_output_germ_original p F leg z hz]
    exact (actualElectronPhysicalUnit.eq_def p F z leg).symm
  rw [unit]

