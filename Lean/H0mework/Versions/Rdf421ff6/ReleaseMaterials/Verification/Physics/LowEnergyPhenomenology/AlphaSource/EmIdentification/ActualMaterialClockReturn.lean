local instance clockRealOperators : NormedAlgebra ℝ (H→L[ℂ]H):=NormedAlgebra.restrictScalars ℝ ℂ _
local instance clockRationalOperators : NormedAlgebra ℚ (H→L[ℂ]H):=NormedAlgebra.restrictScalars ℚ ℂ _

theorem matching_clock_same_source : sourceMaterialClock=sourceRestMatchingClock := by
  simp only [sourceMaterialClock,sourceRestMatchingClock,GaussNativeEnergy.source_time_generated,
    Matrix.cons_val_zero,spinScale]

theorem matching_clock_positive : 0<sourceMaterialClock := by
  rw [matching_clock_same_source]
  exact sourceRestMatchingClock_pos

theorem matching_clock_square : sourceMaterialClock^2=108/125 := by
  rw [matching_clock_same_source,sourceRestMatchingClock,mul_pow,lapse_sq,spinScale_sq]
  norm_num

/-- The matching c and the unique action momentum are generated by the same source lapse and spin scale. -/
theorem matching_clock_action_product : ActionNormalization.phaseMomentum*sourceMaterialClock=8*GaussNativeEnergy.sourceTime 0 := by
  rw [matching_clock_same_source,sourceRestMatchingClock,ActionNormalization.phaseMomentum_source]
  have time : GaussNativeEnergy.sourceTime 0=lapse := by
    rw [GaussNativeEnergy.source_time_generated]
    rfl
  rw [time]
  calc
    _=4*lapse*spinScale^2 := by ring
    _=8*lapse := by rw [spinScale_sq];ring

theorem matching_clock_bare_sheet_debt (branch : Fin 2) : sourceSpeed branch<sourceMaterialClock := by
  have square:=sourceSpeed_square branch
  have positive:=sourceSpeed_positive branch
  have clock:=matching_clock_positive
  have cq:=matching_clock_square
  split_ifs at square <;> nlinarith

def sourceNormalizedPhysicalTime (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (tau : ℝ) (h : Field289) : H→L[ℂ]H :=
  SourceFiniteUnitary.time (((sourceMaterialClock:ℂ)⁻¹) • jointGenerator p F 0 h) tau

/-- Original matching time tau=c*t returns the entire uncut Gauss time, including configuration and Y. -/
theorem matching_clock_whole_time (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (age : ℝ) (h : Field289) :
    sourceNormalizedPhysicalTime p F (sourceMaterialClock*age) h=physicalTime p F age h := by
  unfold sourceNormalizedPhysicalTime physicalTime SourceFiniteUnitary.time
  apply congrArg NormedSpace.exp
  have clock : (sourceMaterialClock:ℂ)≠0:=Complex.ofReal_ne_zero.mpr matching_clock_positive.ne'
  apply ContinuousLinearMap.ext
  intro x
  change ((sourceMaterialClock*age:ℝ):ℂ) •
    ((-Complex.I) • (((sourceMaterialClock:ℂ)⁻¹) • (jointGenerator p F 0 h x)))=
      (age:ℂ) • ((-Complex.I) • (jointGenerator p F 0 h x))
  simp only [smul_smul,Complex.ofReal_mul]
  apply congrArg (fun q : ℂ=>q • (jointGenerator p F 0 h x))
  field_simp [clock]

