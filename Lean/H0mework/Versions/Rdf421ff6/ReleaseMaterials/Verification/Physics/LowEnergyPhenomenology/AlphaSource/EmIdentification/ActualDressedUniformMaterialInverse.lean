attribute [local irreducible] jointGenerator jointResolvent jointPolynomial compressionPolynomial
  compression compressionCarrier sourceCompressionEnd chargeJointPolynomial

private theorem symmetric_restriction {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (A : E→L[ℂ]E) (W : Submodule ℂ E) (closed : ∀x∈W,A x∈W)
    (symmetric : A.toLinearMap.IsSymmetric) : (A.toLinearMap.restrict closed).IsSymmetric := by
  intro x y
  exact symmetric x y

private theorem nonreal_charpoly {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [FiniteDimensional ℂ E] (A : Module.End ℂ E) (symmetric : A.IsSymmetric)
    (z : ℂ) (nonreal : z.im≠0) : A.charpoly.eval z≠0 := by
  intro zero
  have eigen := (Module.End.hasEigenvalue_iff_isRoot_charpoly A z).mpr zero
  exact nonreal (Complex.conj_eq_iff_im.mp (symmetric.conj_eigenvalue_eq_self eigen))

theorem source_joint_polynomial_nonreal (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (z : ℂ) (nonreal : z.im≠0) : (jointPolynomial p F).eval z≠0 := by
  have symmetric : (sourceCompressionEnd p F).IsSymmetric := by
    unfold sourceCompressionEnd
    exact symmetric_restriction (compression p F) (compressionCarrier F)
      (fun x _=>sourceCompression_mem p F x) (compression_selfAdjoint p F).isSymmetric
  have primitive:=nonreal_charpoly (sourceCompressionEnd p F) symmetric z nonreal
  have nonzero : z≠0 := fun zero=>nonreal (by rw [zero];rfl)
  simpa only [jointPolynomial,compressionPolynomial,eval_pow,eval_mul,eval_X] using
    pow_ne_zero 57 (mul_ne_zero primitive nonzero)

private theorem polynomial_inverse {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (T : E→L[ℂ]E) (P : ℂ[X]) (annihilated : aeval T P=0) (z : ℂ)
    (unit : IsUnit (T-z • 1)) :
    P.eval z • Ring.inverse (T-z • 1)= -(aeval T (P/ₘ(X-C z))) := by
  have divide:=congrArg (aeval T) (modByMonic_add_div P (X-C z))
  rw [modByMonic_X_sub_C_eq_C_eval,map_add,map_mul,map_sub,aeval_C,aeval_X,aeval_C,annihilated] at divide
  have pencil : (T-z • 1)*(-(aeval T (P/ₘ(X-C z))))=P.eval z • (1:E→L[ℂ]E) := by
    simpa only [Algebra.algebraMap_eq_smul_one,mul_neg,neg_eq_iff_add_eq_zero,add_comm] using divide
  have closed:=congrArg (fun A : E→L[ℂ]E=>Ring.inverse (T-z • 1)*A) pencil
  rw [←mul_assoc,Ring.inverse_mul_cancel _ unit,one_mul,mul_smul_comm,mul_one] at closed
  exact closed.symm

def materialJointNumerator (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) (z : ℂ) : H→L[ℂ]H :=
  -(aeval (jointGenerator p F 0 0) ((jointPolynomial p F)/ₘ(X-C z)))

attribute [local irreducible] materialJointNumerator

/-- The nonreal-energy unit is generated by the original source, then its actual Ring.inverse is cleared. -/
theorem actual_material_joint_inverse_clear (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (z : ℂ) (nonreal : z.im≠0) :
    (jointPolynomial p F).eval z • jointResolvent p F z 0=materialJointNumerator p F z := by
  have shifted:=PreparationVacuumCurrentRegularAnchor.jointGenerator_spectral_shift p F z 0
  have unit : IsUnit (jointGenerator p F 0 0-z • (1:H→L[ℂ]H)) :=
    shifted ▸ jointGenerator_unit p F z nonreal
  have aligned : (jointPolynomial p F).eval z • jointResolvent p F z 0=
      (jointPolynomial p F).eval z • Ring.inverse (jointGenerator p F 0 0-z • (1:H→L[ℂ]H)) := by
    unfold jointResolvent
    exact congrArg (fun A : H→L[ℂ]H=>(jointPolynomial p F).eval z • Ring.inverse A) shifted
  unfold materialJointNumerator
  exact aligned.trans (polynomial_inverse (jointGenerator p F 0 0) (jointPolynomial p F)
    (actualJoint_annihilated p F) z unit)

/-- A single polynomial, evaluated at the original material energy, controls the moving left leg. -/
def materialChargeDenominator (event : DressedEvent) (n : PhysicalMomentum) : ℂ[X] :=
  (chargeJointPolynomial event.momentum n event.frame).eval (C event.energy)

theorem material_charge_denominator_eval (event : DressedEvent) (n : PhysicalMomentum) (e : ℝ) :
    (materialChargeDenominator event n).eval (e:ℂ)=
      (jointPolynomial (event.momentum-(e^2:ℝ) • n) event.frame).eval event.energy := by
  unfold materialChargeDenominator
  have commuted:=eval_map_apply (p:=chargeJointPolynomial event.momentum n event.frame) (evalRingHom (e:ℂ)) (C event.energy)
  rw [charge_joint_eval] at commuted
  simpa only [coe_evalRingHom,eval_C] using commuted.symm

theorem material_charge_denominator_nonzero (event : DressedEvent) (n : PhysicalMomentum) (e : ℝ) :
    (materialChargeDenominator event n).eval (e:ℂ)≠0 := by
  rw [material_charge_denominator_eval]
  exact source_joint_polynomial_nonreal _ _ _ event.nonreal

end LowEnergy.GaussComposite.ActualDressedUniformMaterialCoefficients
