attribute [local irreducible] compositeProfile actualElectronInputInverseNorm
  actualElectronPhysicalSeed actualElectronAmputatedLeg compositeInput candidate candidateTest

def actualMaterialAmplitude (leg : CompositeLeg) (z : SourceCoordinateSlice) : ℂ :=
  actualElectronInputInverseNorm leg * compositeProfile leg.dual z

theorem actual_amputated_source_value (leg : CompositeLeg) (z : SourceCoordinateSlice) :
    actualElectronAmputatedLeg leg z=actualMaterialAmplitude leg z • candidate leg.dual := by
  have h:=congrArg (fun f : QuantumTest=>f z) (actual_electron_amputated_source leg)
  change actualElectronAmputatedLeg leg z=
    actualElectronInputInverseNorm leg • (ActualCompositeFieldCurrent.compositeInput leg z) at h
  have original : ActualCompositeFieldCurrent.compositeInput leg z=
      compositeProfile leg.dual z • candidate leg.dual := by
    unfold ActualCompositeFieldCurrent.compositeInput MixedSpectatorCandidate.candidateTest
    rfl
  rw [original,smul_smul] at h
  exact h

private theorem candidate_off_number (dual : Bool) (word : Occupation) (different : word.card≠3) :
    candidate dual word=0 := by
  have h:=congrArg (fun v : FockFiber=>v word) (actual_candidate_bottom_sector dual)
  rw [GaussCoreLabel.fiberPiece_apply,if_neg] at h
  · exact h.symm
  · intro same
    exact different (congrArg (fun g : NativeHistoryGrade.Label=>g.1.val) same)

/-- The source's own Number-three support fixes the configuration weight before every material word. -/
theorem source_candidate_pair_sample (dual : Bool) (z : SourceCoordinateSlice) (v : FockFiber) :
    pairSample z (candidate dual) v=complexDensity 3 z * inner ℂ (candidate dual) v := by
  rw [pairSample,PiLp.inner_apply]
  simp only [RCLike.inner_apply,Finset.mul_sum,starRingEnd_apply]
  apply Finset.sum_congr rfl
  intro word _
  by_cases same : word.card=3
  · rw [same]
    ring
  · simp only [candidate_off_number dual word same,star_zero,mul_zero,zero_mul]

def actualMaterialProbabilityDensity (leg : CompositeLeg) (z : SourceCoordinateSlice) : ℂ :=
  2*complexDensity 3 z*star (actualMaterialAmplitude leg z)*actualMaterialAmplitude leg z

theorem actual_material_pair_sample (leg : CompositeLeg) (z : SourceCoordinateSlice) (A : FockFiber→L[ℂ]FockFiber) :
    pairSample z (actualElectronAmputatedLeg leg z) (A (actualElectronAmputatedLeg leg z))=
      (actualMaterialProbabilityDensity leg z/2)*inner ℂ (candidate leg.dual) (A (candidate leg.dual)) := by
  rw [actual_amputated_source_value,map_smul,pairSample_smul_left,pairSample_smul_right,
    source_candidate_pair_sample]
  unfold actualMaterialProbabilityDensity
  ring

/-- The probability mass is generated by the actual full-source amputation and normalization. -/
theorem actual_material_probability_mass (leg : CompositeLeg) :
    (∫z,actualMaterialProbabilityDensity leg z ∂GaussHistoryHilbert.configurationMeasure)=1 := by
  have unit:=actual_electron_amputated_pair leg
  rw [sourcePair_integral] at unit
  have same : (∫z,GaussFockPair.densityPair (actualElectronAmputatedLeg leg)
      (actualElectronAmputatedLeg leg) z ∂GaussHistoryHilbert.configurationMeasure)=
      ∫z,actualMaterialProbabilityDensity leg z ∂GaussHistoryHilbert.configurationMeasure := by
    apply integral_congr_ae
    apply Filter.Eventually.of_forall
    intro z
    rw [←pairSample_source]
    have point:=actual_material_pair_sample leg z (1:FockFiber→L[ℂ]FockFiber)
    simp only [one_apply_eq_self,actual_candidate_norm_sq] at point
    exact point.trans (by ring)
  exact same.symm.trans unit

/-- The genuine full289 raw current reduces to an original scalar configuration integral of a finite CAR contraction. -/
theorem actual_prepared_raw_current_integral (leg : CompositeLeg) (reader : Field289) (p : PhysicalMomentum) :
    rawForm reader p (actualElectronAmputatedLeg leg) (actualElectronAmputatedLeg leg) 0=
      ∫z,(actualMaterialProbabilityDensity leg z/2)*
        inner ℂ (candidate leg.dual) (rawStateFiber reader p (sourceState z) (candidate leg.dual))
        ∂GaussHistoryHilbert.configurationMeasure := by
  rw [rawForm_original]
  apply integral_congr_ae
  exact Filter.Eventually.of_forall fun z=>actual_material_pair_sample leg z (rawStateFiber reader p (sourceState z))

/-- The actual raw contact has its own finite CAR coefficient under the same generated configuration density. -/
theorem actual_prepared_raw_contact_integral (leg : CompositeLeg) (reader force : Field289) (p : PhysicalMomentum) :
    rawContactForm reader force p (actualElectronAmputatedLeg leg) (actualElectronAmputatedLeg leg)=
      ∫z,(actualMaterialProbabilityDensity leg z/2)*
        inner ℂ (candidate leg.dual) (rawContactFiber reader force p z (candidate leg.dual))
        ∂GaussHistoryHilbert.configurationMeasure := by
  rw [rawContactForm_original]
  apply integral_congr_ae
  exact Filter.Eventually.of_forall fun z=>actual_material_pair_sample leg z (rawContactFiber reader force p z)

