private theorem quantized_sign (A : FullMatrix) (source : sourceTimeSignMatrix*A=A*sourceTimeSignMatrix) :
    sourceTimeSignFiber*quantized A=quantized A*sourceTimeSignFiber := by
  have paid:=congrArg quantizer (sub_eq_zero.mpr source)
  rw [paidCoframeQuantizerComm%,map_zero] at paid
  exact sub_eq_zero.mp paid

private abbrev End := QuantumTest→ₗ[ℂ]QuantumTest
local instance signedWeightTorqueEnd : Semiring End := Module.End.instSemiring (R:=ℂ) (M:=QuantumTest)

private theorem branch_multiply (c : SourceCoordinateSlice→ℝ)
    (smooth : ∀z : physicalChart,ContDiffAt ℝ ∞ c z.val) :
    Commute sourceTimeSignCore (GaussNativeForm.multiply c smooth) :=
  (sourceTimeSign_multiply c smooth).symm

private theorem branch_sandwich (v w : Ambient) (c : SourceCoordinateSlice→ℝ)
    (smooth : ∀z : physicalChart,ContDiffAt ℝ ∞ c z.val) :
    Commute sourceTimeSignCore (GaussNativeForm.sandwich v w c smooth) := by
  have adj : Commute (sourceTimeSignCore:End) (GaussMomentumAdjoint.adjoint v:End):=
    (sourceTimeSign_adjoint v).symm
  have middle : Commute (sourceTimeSignCore:End) (GaussNativeForm.multiply c smooth:End):=
    branch_multiply c smooth
  have cov : Commute (sourceTimeSignCore:End) (covariantMomentum w:End):=
    (sourceTimeSign_covariant w).symm
  change Commute (sourceTimeSignCore:End)
    ((GaussMomentumAdjoint.adjoint v:End)*((GaussNativeForm.multiply c smooth:End)*(covariantMomentum w:End)))
  let composition : Semigroup End := (Module.End.instMonoid (R:=ℂ) (M:=QuantumTest)).toSemigroup
  exact @_root_.Commute.mul_right End composition sourceTimeSignCore (GaussMomentumAdjoint.adjoint v)
    ((GaussNativeForm.multiply c smooth).comp (covariantMomentum w)) adj
    (@_root_.Commute.mul_right End composition sourceTimeSignCore (GaussNativeForm.multiply c smooth)
      (covariantMomentum w) middle cov)

/-- The relative phase commutes with the complete original scalar and gauge kinetic action. -/
theorem sourceTimeSign_nativeCore : Commute sourceTimeSignCore GaussNativeForm.nativeAction := by
  have each (v w : Ambient) (c : SourceCoordinateSlice→ℝ)
      (smooth : ∀z : physicalChart,ContDiffAt ℝ ∞ c z.val) (f : QuantumTest) :
      sourceTimeSignCore (GaussNativeForm.sandwich v w c smooth f)=
        GaussNativeForm.sandwich v w c smooth (sourceTimeSignCore f) :=
    LinearMap.congr_fun (branch_sandwich v w c smooth).eq f
  have scalar (c : SourceCoordinateSlice→ℝ)
      (smooth : ∀z : physicalChart,ContDiffAt ℝ ∞ c z.val) (f : QuantumTest) :
      sourceTimeSignCore (GaussNativeForm.multiply c smooth f)=
        GaussNativeForm.multiply c smooth (sourceTimeSignCore f) :=
    LinearMap.congr_fun (branch_multiply c smooth).eq f
  apply LinearMap.ext
  intro f
  simp only [Module.End.mul_apply,GaussNativeForm.nativeAction,GaussNativeForm.scalarKinetic,
    GaussNativeForm.gaugeKinetic,LinearMap.add_apply,LinearMap.smul_apply,LinearMap.sum_apply,
    map_add,map_smul,map_sum,each,scalar]


theorem sourceTimeSign_numberCore : Commute sourceTimeSignCore GaussCoframeForm.number := by
  apply LinearMap.ext
  intro f
  apply DFunLike.ext
  intro z
  have each (g : QuantumTest) : GaussCoframeForm.number g z=SourceQuantumFockGauge.fiberNumber (g z) := by
    apply PiLp.ext
    intro word
    rw [GaussCoframeForm.number_apply,SourceQuantumFockGauge.fiberNumber_apply]
  change sourceTimeSignFiber (GaussCoframeForm.number f z)=
    GaussCoframeForm.number (sourceTimeSignCore f) z
  rw [each,each]
  exact congrArg (fun A : FockFiber→L[ℂ]FockFiber=>A (f z))
    (GaussQuantumMultiplier.number_commute sourceTimeSignMatrix).symm.eq


theorem sourceTimeSign_coframeDerivative (v : SourceCoordinateSlice) (f : QuantumTest) :
    GaussCoframeCore.derivative v (sourceTimeSignCore f)=
      sourceTimeSignCore (GaussCoframeCore.derivative v f) := by
  apply DFunLike.ext
  intro z
  change (TestFunction.lineDerivCLM (n:=⊤) (k:=⊤) ℂ v (sourceTimeSignCore f)) z=
    sourceTimeSignFiber ((TestFunction.lineDerivCLM (n:=⊤) (k:=⊤) ℂ v f) z)
  rw [TestFunction.lineDerivCLM_apply_of_le (by simp),TestFunction.lineDerivCLM_apply_of_le (by simp),
    (sourceTimeSignCore f).contDiff.differentiable (by simp) |>.differentiableAt.lineDeriv_eq_fderiv,
    f.contDiff.differentiable (by simp) |>.differentiableAt.lineDeriv_eq_fderiv]
  have derivative:=(sourceTimeSignFiber.restrictScalars ℝ).hasFDerivAt.comp z
    (f.contDiff.differentiable (by simp)).differentiableAt.hasFDerivAt
  change (fderiv ℝ ((sourceTimeSignFiber.restrictScalars ℝ) ∘ f) z) v=_
  rw [derivative.fderiv]
  rfl

theorem sourceTimeSign_coframeMomentum (i : Fin 6) :
    Commute sourceTimeSignCore (GaussCoframeCore.momentum i) := by
  apply Commute.symm
  apply LinearMap.ext
  intro f
  change (-Complex.I) • GaussCoframeCore.derivative (GaussCoframeCore.coframeDirection i) (sourceTimeSignCore f)=
    sourceTimeSignCore ((-Complex.I) • GaussCoframeCore.derivative (GaussCoframeCore.coframeDirection i) f)
  rw [sourceTimeSign_coframeDerivative,map_smul]

theorem sourceTimeSign_coframeAdjoint (i : Fin 6) :
    Commute sourceTimeSignCore (GaussCoframeCore.adjoint i) := by
  apply Commute.symm
  apply LinearMap.ext
  intro g
  have pair (f : QuantumTest) :
      sourcePair f (GaussCoframeCore.adjoint i (sourceTimeSignCore g))=
        sourcePair f (sourceTimeSignCore (GaussCoframeCore.adjoint i g)) := by
    rw [GaussCoframeKinetic.adjoint_pair,sourceTimeSign_pair]
    have commute:=LinearMap.congr_fun (sourceTimeSign_coframeMomentum i).eq f
    change sourceTimeSignCore (GaussCoframeCore.momentum i f)=
      GaussCoframeCore.momentum i (sourceTimeSignCore f) at commute
    rw [commute,←GaussCoframeKinetic.adjoint_pair,←sourceTimeSign_pair]
  apply sub_eq_zero.mp
  apply embed_injective
  rw [map_zero]
  apply (inner_self_eq_zero (𝕜:=ℂ)).mp
  let d:=GaussCoframeCore.adjoint i (sourceTimeSignCore g)-
    sourceTimeSignCore (GaussCoframeCore.adjoint i g)
  have paid:=pair d
  change sourcePair d d=0
  unfold d sourcePair
  rw [map_sub,inner_sub_right]
  simpa only [sourcePair,d,map_sub] using (sub_eq_zero.mpr paid)


private theorem branch_mixed (i : Fin 6) (a : Fin 7) (c : SourceCoordinateSlice→ℝ)
    (smooth : ∀z : physicalChart,ContDiffAt ℝ ∞ c z.val) :
    Commute sourceTimeSignCore (GaussCoframeForm.mixed i a c smooth) := by
  apply LinearMap.ext
  intro f
  have spin (v : QuantumTest) := LinearMap.congr_fun (sourceTimeSign_spinCore a).eq v
  have scalar (v : QuantumTest) := LinearMap.congr_fun (branch_multiply c smooth).eq v
  have momentum (v : QuantumTest) := LinearMap.congr_fun (sourceTimeSign_coframeMomentum i).eq v
  have adjoint (v : QuantumTest) := LinearMap.congr_fun (sourceTimeSign_coframeAdjoint i).eq v
  simp only [Module.End.mul_apply] at spin scalar momentum adjoint
  simp only [Module.End.mul_apply,GaussCoframeForm.mixed,LinearMap.smul_apply,LinearMap.add_apply,
    LinearMap.comp_apply,map_smul,map_add,spin,scalar,momentum,adjoint]


/-- Every original coframe kinetic, spin/current, number and volume term consumes the same relative charge. -/
theorem sourceTimeSign_coframeCore : Commute sourceTimeSignCore GaussCoframeForm.coframeAction := by
  have spin (a : Fin 7) (v : QuantumTest) := LinearMap.congr_fun (sourceTimeSign_spinCore a).eq v
  have scalar (c : SourceCoordinateSlice→ℝ)
      (smooth : ∀z : physicalChart,ContDiffAt ℝ ∞ c z.val) (v : QuantumTest) :=
    LinearMap.congr_fun (branch_multiply c smooth).eq v
  have momentum (i : Fin 6) (v : QuantumTest) := LinearMap.congr_fun (sourceTimeSign_coframeMomentum i).eq v
  have adjoint (i : Fin 6) (v : QuantumTest) := LinearMap.congr_fun (sourceTimeSign_coframeAdjoint i).eq v
  have number (v : QuantumTest) := LinearMap.congr_fun sourceTimeSign_numberCore.eq v
  have mixed (i : Fin 6) (a : Fin 7) (c : SourceCoordinateSlice→ℝ)
      (smooth : ∀z : physicalChart,ContDiffAt ℝ ∞ c z.val) (v : QuantumTest) :=
    LinearMap.congr_fun (branch_mixed i a c smooth).eq v
  simp only [Module.End.mul_apply] at spin scalar momentum adjoint number mixed
  apply LinearMap.ext
  intro f
  simp only [Module.End.mul_apply,GaussCoframeForm.coframeAction,GaussCoframeKinetic.kinetic,
    GaussCoframeKinetic.term,GaussCoframeForm.currentAction,GaussCoframeForm.spinSquare,
    GaussCoframeForm.numberShift,LinearMap.add_apply,LinearMap.smul_apply,LinearMap.sum_apply,
    LinearMap.comp_apply,map_add,map_smul,map_sum,spin,scalar,momentum,adjoint,number,mixed]


theorem sourceTimeSign_matterCore : Commute sourceTimeSignCore GaussMatterCore.matterAction := by
  apply LinearMap.ext
  intro f
  simp only [Module.End.mul_apply,GaussMatterCore.matterAction,LinearMap.sum_apply,map_sum]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro b _
  apply DFunLike.ext
  intro z
  have matrix : sourceTimeSignMatrix*GaussMatterCore.localMatrix i b z=
      GaussMatterCore.localMatrix i b z*sourceTimeSignMatrix := by
    have spin : Commute sourceTimeSignMatrix (GaussCoframeSpin.full (Fin.castAdd 4 b)) :=
      sourceTimeSign_spin (Fin.castAdd 4 b)
    have native : Commute sourceTimeSignMatrix (nativeFull (GaussNativePotential.connectionField z i)) :=
      sourceTimeSign_native _
    exact ((spin.smul_right Complex.I).mul_right native).smul_right _
  exact congrArg (fun A : FockFiber→L[ℂ]FockFiber=>A (f z)) (quantized_sign _ matrix)

theorem sourceTimeSign_diagonalCore : Commute sourceTimeSignCore GaussDiagonalHistory.diagonalAction :=
  (sourceTimeSign_nativeCore.add_right sourceTimeSign_coframeCore).add_right sourceTimeSign_matterCore


theorem sourceTimeSign_momentumMatrix (z : SourceCoordinateSlice) (p : PhysicalMomentum) :
    sourceTimeSignMatrix*momentumMatrix z p=momentumMatrix z p*sourceTimeSignMatrix := by
  simp only [momentumMatrix,mul_neg,neg_mul,Finset.mul_sum,Finset.sum_mul,mul_smul_comm,smul_mul_assoc]
  congr 1
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro b _
  exact congrArg (fun A : FullMatrix=>((p i*GaussMatterCore.coefficient i b z:ℝ):ℂ) • A)
    (sourceTimeSign_spin (Fin.castAdd 4 b))

theorem sourceTimeSign_momentumCore (p : PhysicalMomentum) :
    Commute (momentumAction p) sourceTimeSignCore := by
  apply LinearMap.ext
  intro f
  apply DFunLike.ext
  intro z
  exact congrArg (fun A : FockFiber→L[ℂ]FockFiber=>A (f z))
    (quantized_sign (momentumMatrix z p) (sourceTimeSign_momentumMatrix z p)).symm

theorem sourceTimeSign_physicalCore (p : PhysicalMomentum) :
    Commute (physicalAction p) sourceTimeSignCore :=
  sourceTimeSign_diagonalCore.symm.add_left (sourceTimeSign_momentumCore p)

private theorem physical_volume (p : PhysicalMomentum) :
    physicalAction p*SourceCoframeVolume.volumeAction-SourceCoframeVolume.volumeAction*physicalAction p=
      (-3*Complex.I*(GaussNativeEnergy.sourceTime 0:ℂ)/4) • SourceCoframeVolumeCurrent.dilation := by
  have momentum : Commute (momentumAction p) SourceCoframeVolume.volumeAction:=
    SourceCoframeVolumeCurrent.scalar_volume_commutes _ (CanonicalGradedSpatial.sourceMomentum_smooth p)
  rw [physicalAction,add_mul,mul_add,momentum.eq]
  have cancel : (GaussDiagonalHistory.diagonalAction*SourceCoframeVolume.volumeAction+
      SourceCoframeVolume.volumeAction*momentumAction p)-
      (SourceCoframeVolume.volumeAction*GaussDiagonalHistory.diagonalAction+
      SourceCoframeVolume.volumeAction*momentumAction p)=
      GaussDiagonalHistory.diagonalAction*SourceCoframeVolume.volumeAction-
        SourceCoframeVolume.volumeAction*GaussDiagonalHistory.diagonalAction := by abel
  exact cancel.trans SourceHamiltonianVolume.full_source_volume_current

/-- The complete original physical core consumes its actual signed volume weight. -/
theorem sourceWeightCore_physicalTorque (p : PhysicalMomentum) :
    (physicalAction p).comp weightCore-weightCore.comp (physicalAction p)=
      (Stage10.ActionNormalization.phaseMomentum:ℂ) •
        (((-3*Complex.I*(GaussNativeEnergy.sourceTime 0:ℂ)/4) • SourceCoframeVolumeCurrent.dilation).comp sourceTimeSignCore) := by
  rw [sourceWeightCore_factor]
  change physicalAction p*((Stage10.ActionNormalization.phaseMomentum:ℂ) •
      (SourceCoframeVolume.volumeAction*sourceTimeSignCore))-
    ((Stage10.ActionNormalization.phaseMomentum:ℂ) •
      (SourceCoframeVolume.volumeAction*sourceTimeSignCore))*physicalAction p=_
  simp only [mul_smul_comm,smul_mul_assoc,←smul_sub]
  congr 1
  have product : physicalAction p*(SourceCoframeVolume.volumeAction*sourceTimeSignCore)-
      (SourceCoframeVolume.volumeAction*sourceTimeSignCore)*physicalAction p=
      (physicalAction p*SourceCoframeVolume.volumeAction-SourceCoframeVolume.volumeAction*physicalAction p)*sourceTimeSignCore+
        SourceCoframeVolume.volumeAction*(physicalAction p*sourceTimeSignCore-sourceTimeSignCore*physicalAction p) := by
    noncomm_ring
  rw [product,(sourceTimeSign_physicalCore p).eq,sub_self,mul_zero,add_zero,physical_volume]
  rfl

open PreparationVacuumUncutYukawa GaussNativePotential

def sourceTimeSignYukawaCore (phi : CanonicalGradedLocalCurrent.Localizer) : End :=
  (sourceRetainedYukawaCore phi).comp sourceTimeSignCore-sourceTimeSignCore.comp (sourceRetainedYukawaCore phi)

theorem sourceTimeSignYukawaCore_generated (phi : CanonicalGradedLocalCurrent.Localizer)
    (f : QuantumTest) (z : SourceCoordinateSlice) :
    sourceTimeSignYukawaCore phi f z=(phi z:ℂ) •
      quantized (sourceTimeSignYukawaMatrix (scalarField z)) (f z) := by
  have paid:=congrArg (fun A : FockFiber→L[ℂ]FockFiber=>(phi z:ℂ) • A (f z))
    (sourceTimeSignYukawa_fiber (scalarField z))
  change (phi z:ℂ) • (GaussYukawaCoefficient.sourceMap (scalarField (fieldCoordinateCurve 0 0 z))
      (sourceTimeSignFiber (f z)))-
    sourceTimeSignFiber ((phi z:ℂ) • GaussYukawaCoefficient.sourceMap
      (scalarField (fieldCoordinateCurve 0 0 z)) (f z))=_
  rw [PreparationVacuumGradedTransport.curve_zero,map_smul]
  simpa only [sub_apply,mul_apply_eq_comp,smul_sub,GaussQuantumMultiplier.quantizer,
    LinearMap.coe_mk,AddHom.coe_mk] using paid.symm

theorem sourceWeightCore_retainedTorque (phi : CanonicalGradedLocalCurrent.Localizer) :
    (sourceRetainedYukawaCore phi).comp weightCore-weightCore.comp (sourceRetainedYukawaCore phi)=
      (Stage10.ActionNormalization.phaseMomentum:ℂ) •
        (SourceCoframeVolume.volumeAction.comp (sourceTimeSignYukawaCore phi)) := by
  have volume : Commute (sourceRetainedYukawaCore phi) SourceCoframeVolume.volumeAction:=
    SourceCoframeVolumeCurrent.scalar_volume_commutes _ _
  rw [sourceWeightCore_factor]
  change sourceRetainedYukawaCore phi*((Stage10.ActionNormalization.phaseMomentum:ℂ) •
      (SourceCoframeVolume.volumeAction*sourceTimeSignCore))-
    ((Stage10.ActionNormalization.phaseMomentum:ℂ) •
      (SourceCoframeVolume.volumeAction*sourceTimeSignCore))*sourceRetainedYukawaCore phi=_
  simp only [mul_smul_comm,smul_mul_assoc,←smul_sub]
  congr 1
  have commute : (sourceRetainedYukawaCore phi).comp SourceCoframeVolume.volumeAction=
      SourceCoframeVolume.volumeAction.comp (sourceRetainedYukawaCore phi) := volume.eq
  change (sourceRetainedYukawaCore phi).comp (SourceCoframeVolume.volumeAction.comp sourceTimeSignCore)-
    (SourceCoframeVolume.volumeAction.comp sourceTimeSignCore).comp (sourceRetainedYukawaCore phi)=
    SourceCoframeVolume.volumeAction.comp ((sourceRetainedYukawaCore phi).comp sourceTimeSignCore-
      sourceTimeSignCore.comp (sourceRetainedYukawaCore phi))
  simp only [LinearMap.comp_sub,←LinearMap.comp_assoc]
  rw [commute]

def sourceSignedWeightCoreTorque (phi : CanonicalGradedLocalCurrent.Localizer) : End :=
  (Stage10.ActionNormalization.phaseMomentum:ℂ) •
    (((-3*Complex.I*(GaussNativeEnergy.sourceTime 0:ℂ)/4) • SourceCoframeVolumeCurrent.dilation).comp sourceTimeSignCore+
      SourceCoframeVolume.volumeAction.comp (sourceTimeSignYukawaCore phi))

theorem sourceSignedWeightCoreTorque_generated (p : PhysicalMomentum) (phi : CanonicalGradedLocalCurrent.Localizer) :
    (physicalAction p+sourceRetainedYukawaCore phi).comp weightCore-
      weightCore.comp (physicalAction p+sourceRetainedYukawaCore phi)=sourceSignedWeightCoreTorque phi := by
  simp only [LinearMap.add_comp,LinearMap.comp_add]
  have reorder : (physicalAction p).comp weightCore+(sourceRetainedYukawaCore phi).comp weightCore-
      (weightCore.comp (physicalAction p)+weightCore.comp (sourceRetainedYukawaCore phi))=
      ((physicalAction p).comp weightCore-weightCore.comp (physicalAction p))+
      ((sourceRetainedYukawaCore phi).comp weightCore-weightCore.comp (sourceRetainedYukawaCore phi)) := by abel
  rw [reorder,sourceWeightCore_physicalTorque,sourceWeightCore_retainedTorque]
  exact (smul_add _ _ _).symm

