private theorem affine_difference {P V : Type*} [AddCommMonoid P] [AddCommGroup V]
    (L : P→+V) (f : P→V) (base : V) (paid : ∀p,f p=base+L p) (p k : P) :f (p+k)-f p=L k := by
  rw [paid,paid,L.map_add]
  abel

private theorem double_operator_bound {P V W : Type*}
    [NormedAddCommGroup P] [NormedSpace ℝ P] [NormedAddCommGroup V] [NormedSpace ℝ V]
    [NormedAddCommGroup W] [NormedSpace ℝ W] (L : P→L[ℝ](V→L[ℝ]W)) (p : P) (v : V) :
    ‖L p v‖≤‖L‖*‖p‖*‖v‖ :=
  ((L p).le_opNorm v).trans (mul_le_mul_of_nonneg_right (L.le_opNorm p) (norm_nonneg v))

/-- The exact affine map is generated by all original current source words on the common frame. -/
theorem actual_full_current_momentum_difference (p k : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (z : ℂ) (force : Field289) :
    jointCurrent (p+k) F z 0 force-jointCurrent p F z 0 force=jointCurrentMomentum F z k force := by
  have difference:=affine_difference (jointCurrentMomentum F z).toLinearMap.toAddMonoidHom
    (fun q : PhysicalMomentum=>jointCurrent q F z 0) (jointCurrent 0 F z 0) (joint_current_affine F z) p k
  exact congrArg (fun A : Field289→L[ℝ](H→L[ℂ]H)=>A force) difference

theorem actual_full_current_momentum_price (p k : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (z : ℂ) (force : Field289) :
    ‖jointCurrent (p+k) F z 0 force-jointCurrent p F z 0 force‖≤
      ‖jointCurrentMomentum F z‖*‖k‖*‖force‖ := by
  exact (congrArg norm (actual_full_current_momentum_difference p k F z force)).le.trans
    (double_operator_bound (jointCurrentMomentum F z) k force)

private theorem variation_corner {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    (C B : E→L[ℂ]E) (t : ℝ) :
    CanonicalGradedVariation.variation C B t=
      corner (SourceFiniteUnitary.time (diagonal C C+upper B) t) := by
  have block:=triangular_time C C B (1:ℂ) t
  simp only [one_smul] at block
  rw [block,map_add,corner_diagonal,corner_upper,zero_add]
  rw [crossTime_integral]
  simp only [CanonicalGradedVariation.variation,CanonicalGradedVariation.variationBetween,zero_smul,add_zero]

private theorem variation_continuous {P E : Type*} [TopologicalSpace P]
    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    (C B : P→E→L[ℂ]E) (hc : Continuous C) (hb : Continuous B) (t : ℝ) :
    Continuous (fun p=>CanonicalGradedVariation.variation (C p) (B p) t) := by
  let : Fact ((1:ENNReal)≤2):=⟨by norm_num⟩
  let : NormedAddCommGroup (Channel E):=WithLp.instProdNormedAddCommGroup 2 E E
  let : NormedSpace ℂ (Channel E):=WithLp.instProdNormedSpace 2 ℂ E E
  let : InnerProductSpace ℂ (Channel E):=WithLp.instProdInnerProductSpace
  let : NormedAlgebra ℝ (Channel E→L[ℂ]Channel E):=NormedAlgebra.restrictScalars ℝ ℂ _
  let : NormedAlgebra ℚ (Channel E→L[ℂ]Channel E):=NormedAlgebra.restrictScalars ℚ ℂ _
  have diagonalContinuous:=(diagonalMap (E:=E)).continuous.comp (hc.prodMk hc)
  have upperContinuous:=(blockMap (E:=E) injectOut projectIn).continuous.comp hb
  have blockContinuous:=diagonalContinuous.add upperContinuous
  have exponential:=NormedSpace.exp_continuous.comp ((blockContinuous.const_smul (-Complex.I)).const_smul t)
  have observed:=(corner (E:=E)).continuous.comp exponential
  simpa only [variation_corner,SourceFiniteUnitary.time,diagonalMap,add_apply,
    ContinuousLinearMap.comp_apply,ContinuousLinearMap.coe_fst',ContinuousLinearMap.coe_snd'] using! observed

/-- The actual full time variation is generated from the original uncut Hamiltonian and full affine current. -/
theorem actual_full_time_slope_momentum_continuous (F : GaussUnitaryHistory.Index) (force : Field289) (age : ℝ) :
    Continuous (fun p : PhysicalMomentum=>timeSlope force p F age) := by
  have current : Continuous (fun p : PhysicalMomentum=>jointCurrent p F 0 0 force):=
    (joint_current_momentum_continuous F 0).clm_apply continuous_const
  have generated:=variation_continuous (fun p : PhysicalMomentum=>jointGenerator p F 0 0)
    (fun p : PhysicalMomentum=>jointCurrent p F 0 0 force) (jointGenerator_base_continuous F 0) current age
  simpa only [timeSlope] using! generated

