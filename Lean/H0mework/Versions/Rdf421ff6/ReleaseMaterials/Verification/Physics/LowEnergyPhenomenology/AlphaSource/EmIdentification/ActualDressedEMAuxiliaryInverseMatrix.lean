import H0mework.Versions.Rdf421ff6.ReleaseMaterials.Verification.Physics.LowEnergyPhenomenology.AlphaSource.EmIdentification.ActualDressedEMQuantumAuxiliarySchur
import Mathlib.LinearAlgebra.Matrix.ToLin

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency true
noncomputable section
namespace LowEnergy.GaussComposite.ActualDressedEMAuxiliaryFeedback
open ActualDressedEMNativeAuxiliary
open scoped Matrix BigOperators

private theorem inverse_add (u v : (Fin 6 × Fin 12) → ℂ) :
    nativeAuxiliaryInverse (u+v)=nativeAuxiliaryInverse u+nativeAuxiliaryInverse v := by
  funext i
  simp only [Pi.add_apply]
  unfold nativeAuxiliaryInverse auxiliaryLieInverse
  split_ifs <;> simp only [Pi.add_apply] <;> ring1

private theorem inverse_scale (r : ℂ) (v : (Fin 6 × Fin 12) → ℂ) :
    nativeAuxiliaryInverse (r • v)=r • nativeAuxiliaryInverse v := by
  funext i
  simp only [Pi.smul_apply,smul_eq_mul]
  unfold nativeAuxiliaryInverse auxiliaryLieInverse
  split_ifs <;> simp only [Pi.smul_apply,smul_eq_mul] <;> ring1

private def inverseLinear : ((Fin 6 × Fin 12) → ℂ) →ₗ[ℂ] (Fin 6 × Fin 12) → ℂ where
  toFun := nativeAuxiliaryInverse
  map_add' := inverse_add
  map_smul' r v := by simpa only [RingHom.id_apply] using inverse_scale r v

/-- This matrix is generated by the already-paid original source colour/lapse inverse. -/
def nativeAuxiliaryInverseMatrix : Matrix (Fin 6 × Fin 12) (Fin 6 × Fin 12) ℂ :=
  LinearMap.toMatrix' inverseLinear

theorem native_auxiliary_inverse_matrix_action (v : (Fin 6 × Fin 12) → ℂ) :
    nativeAuxiliaryInverseMatrix*ᵥv=nativeAuxiliaryInverse v :=
  LinearMap.toMatrix'_mulVec inverseLinear v

theorem actual_native_auxiliary_matrix_left (p : Fin 4 → ℂ) :
    nativeAuxiliaryInverseMatrix*originalGaugeAuxiliaryPencil p=1 := by
  apply Matrix.mulVec_injective
  funext v
  rw [← Matrix.mulVec_mulVec,native_auxiliary_inverse_matrix_action,
    actual_native_auxiliary_inverse_left,Matrix.one_mulVec]

theorem actual_native_auxiliary_matrix_right (p : Fin 4 → ℂ) :
    originalGaugeAuxiliaryPencil p*nativeAuxiliaryInverseMatrix=1 := by
  apply Matrix.mulVec_injective
  funext v
  rw [← Matrix.mulVec_mulVec,native_auxiliary_inverse_matrix_action,
    actual_native_auxiliary_inverse_right,Matrix.one_mulVec]

end LowEnergy.GaussComposite.ActualDressedEMAuxiliaryFeedback
