/-- The projected source current is inserted into all the original physical inverse and time legs. -/
def sourceProjectedInteraction (T : FullMaterialMatrix→L[ℂ]FullMaterialMatrix)
    (event : DressedEvent) (transfer : PhysicalMomentum) (reader : Field289) (age : ℝ) (h : Field289) : H→L[ℂ]H :=
  physicalTime (event.momentum-transfer) event.frame (-age) h*
    jointResolvent (event.momentum-transfer) event.frame event.energy h*
    projectedNoetherReader T reader event.momentum event.frame h*
    jointResolvent event.momentum event.frame event.energy h*physicalTime event.momentum event.frame age h

def sourceProjectedVariation (T : FullMaterialMatrix→L[ℂ]FullMaterialMatrix)
    (event : DressedEvent) (transfer : PhysicalMomentum) (reader force : Field289) (age : ℝ) : H→L[ℂ]H :=
  let p:=event.momentum-transfer
  let TL:=physicalTime p event.frame (-age) 0
  let L:=jointResolvent p event.frame event.energy 0
  let J:=projectedNoetherReader T reader event.momentum event.frame 0
  let R:=jointResolvent event.momentum event.frame event.energy 0
  let TR:=physicalTime event.momentum event.frame age 0
  let dTL:=timeSlope force p event.frame (-age)
  let dL:=-(L*jointCurrent p event.frame event.energy 0 force*L)
  let dJ:=projectedNoetherReaderContact T reader force event.momentum event.frame
  let dR:=-(R*jointCurrent event.momentum event.frame event.energy 0 force*R)
  let dTR:=timeSlope force event.momentum event.frame age
  (((dTL*L+TL*dL)*J+(TL*L)*dJ)*R+((TL*L)*J)*dR)*TR+(((TL*L)*J)*R)*dTR

/-- Every physical leg is differentiated; the projected contact is generated by the actual Noether transport. -/
theorem source_projected_interaction_generated (T : FullMaterialMatrix→L[ℂ]FullMaterialMatrix)
    (event : DressedEvent) (transfer : PhysicalMomentum) (reader force : Field289) (age : ℝ) :
    HasDerivAt (fun r : ℝ=>sourceProjectedInteraction T event transfer reader age (r • force))
      (sourceProjectedVariation T event transfer reader force age) 0 := by
  have tl:=physicalTime_direction force (event.momentum-transfer) event.frame (-age)
  have l:=inverse_direction (event.momentum-transfer) event.frame event.energy event.nonreal force
  have j:=projected_noether_reader_generated T reader force event.momentum event.frame
  have r:=inverse_direction event.momentum event.frame event.energy event.nonreal force
  have tr:=physicalTime_direction force event.momentum event.frame age
  simpa only [sourceProjectedInteraction,sourceProjectedVariation,zero_smul,Pi.mul_apply] using!
    (((tl.mul l).mul j).mul r).mul tr

/-- The complete five-J interaction response is exhausted by source light and the explicit source heavy/cross/outside arms. -/
theorem actual_full_noether_source_rest_light_partition (event : DressedEvent) (transfer : PhysicalMomentum)
    (reader force : Field289) (age : ℝ) :
    actualFullNoetherVariation event transfer reader force age=
      sourceProjectedVariation sourceRestLightMap event transfer reader force age+
        sourceProjectedVariation sourceRestRemainderMap event transfer reader force age := by
  let TL:=physicalTime (event.momentum-transfer) event.frame (-age) 0
  let L:=jointResolvent (event.momentum-transfer) event.frame event.energy 0
  let R:=jointResolvent event.momentum event.frame event.energy 0
  let TR:=physicalTime event.momentum event.frame age 0
  let dTL:=timeSlope force (event.momentum-transfer) event.frame (-age)
  let dL:=-(L*jointCurrent (event.momentum-transfer) event.frame event.energy 0 force*L)
  let dR:=-(R*jointCurrent event.momentum event.frame event.energy 0 force*R)
  let dTR:=timeSlope force event.momentum event.frame age
  let response (J dJ : H→L[ℂ]H):=
    (((dTL*L+TL*dL)*J+(TL*L)*dJ)*R+((TL*L)*J)*dR)*TR+(((TL*L)*J)*R)*dTR
  let JL:=sourceLightNoetherReader reader event.momentum event.frame 0
  let JR:=sourceRemainderNoetherReader reader event.momentum event.frame 0
  let dJL:=sourceLightNoetherReaderContact reader force event.momentum event.frame
  let dJR:=sourceRemainderNoetherReaderContact reader force event.momentum event.frame
  have current : JL+JR=noetherReader reader event.momentum event.frame 0:=
    source_rest_noether_reader_partition reader event.momentum event.frame
  have contact : dJL+dJR=noetherReaderContact reader force event.momentum event.frame:=
    source_rest_noether_reader_contact_partition reader force event.momentum event.frame
  have additive (J K dJ dK : H→L[ℂ]H) : response (J+K) (dJ+dK)=response J dJ+response K dK := by
    unfold response;noncomm_ring
  change response (noetherReader reader event.momentum event.frame 0)
    (noetherReaderContact reader force event.momentum event.frame)=response JL dJL+response JR dJR
  exact ((congrArg (fun J=>response J (noetherReaderContact reader force event.momentum event.frame)) current.symm).trans
    (congrArg (response (JL+JR)) contact.symm)).trans (additive JL JR dJL dJR)

def sourceProjectedPhysicalResponse (T : FullMaterialMatrix→L[ℂ]FullMaterialMatrix)
    (event : DressedEvent) (leg : CompositeLeg) (reader force : Field289) (age : ℝ) (k : PhysicalMomentum) : ℂ :=
  actualPhysicalEulerObserver event leg (sourceProjectedVariation T event (-k) reader force age)

/-- The same normalized physical N3-minus-background observer consumes the source split on the original complete circuit. -/
theorem actual_physical_full_response_source_rest_light_partition (event : DressedEvent) (leg : CompositeLeg)
    (reader force : Field289) (age : ℝ) (k : PhysicalMomentum) :
    actualPhysicalFullResponse event leg reader force age k=
      sourceProjectedPhysicalResponse sourceRestLightMap event leg reader force age k+
        sourceProjectedPhysicalResponse sourceRestRemainderMap event leg reader force age k := by
  change actualPhysicalEulerObserver event leg (actualFullNoetherVariation event (-k) reader force age)=_
  exact (congrArg (actualPhysicalEulerObserver event leg)
    (actual_full_noether_source_rest_light_partition event (-k) reader force age)).trans
    ((actualPhysicalEulerObserver event leg).map_add _ _)

theorem actual_physical_source_light_response_generated (event : DressedEvent) (leg : CompositeLeg)
    (transfer : PhysicalMomentum) (reader force : Field289) (age : ℝ) :
    HasDerivAt (fun r : ℝ=>actualPhysicalEulerObserver event leg
      (sourceProjectedInteraction sourceRestLightMap event transfer reader age (r • force)))
      (actualPhysicalEulerObserver event leg
        (sourceProjectedVariation sourceRestLightMap event transfer reader force age)) 0 :=
  ((actualPhysicalEulerObserver event leg).restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt 0
    (source_projected_interaction_generated sourceRestLightMap event transfer reader force age)

