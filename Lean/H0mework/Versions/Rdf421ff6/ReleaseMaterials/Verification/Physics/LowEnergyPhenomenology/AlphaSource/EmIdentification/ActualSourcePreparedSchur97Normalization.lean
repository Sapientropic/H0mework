private theorem update_blocks {M A : Type*} [DecidableEq M] [DecidableEq A]
    (P : Matrix M M ℂ) (B : Matrix M A ℂ) (C : Matrix A M ℂ) (D : Matrix A A ℂ)
    (i j : M) :
    (Matrix.fromBlocks P B C D).updateRow (Sum.inl j) (Pi.single (Sum.inl i) 1)=
      Matrix.fromBlocks (P.updateRow j (Pi.single i 1)) (B.updateRow j 0) C D := by
  ext (x|x) (y|y) <;> simp [Matrix.updateRow_apply,Matrix.fromBlocks,Pi.single_apply]

private theorem update_schur {M A : Type*} [Fintype A] [DecidableEq M]
    (P : Matrix M M ℂ) (B : Matrix M A ℂ) (C : Matrix A M ℂ) (H : Matrix A A ℂ)
    (i j : M) :
    P.updateRow j (Pi.single i 1)-B.updateRow j 0*H*C=
      (P-B*H*C).updateRow j (Pi.single i 1) := by
  ext x y
  by_cases same : x=j
  · subst x
    simp [Matrix.updateRow_apply,Matrix.mul_apply,Pi.single_apply]
  · simp [Matrix.updateRow_apply,same,Matrix.mul_apply]

/-- A pure block identity generated by the native inverse alone. The whole
matrix and its Schur determinant may be singular. -/
private theorem active_adjugate_block {M A : Type*}
    [Fintype M] [DecidableEq M] [Fintype A] [DecidableEq A]
    (P : Matrix M M ℂ) (B : Matrix M A ℂ) (C : Matrix A M ℂ) (D H : Matrix A A ℂ)
    (left : H*D=1) (right : D*H=1) :
    (Matrix.fromBlocks P B C D).adjugate.submatrix Sum.inl Sum.inl=
      D.det • (P-B*H*C).adjugate := by
  let : Invertible D := ⟨H,left,right⟩
  ext i j
  rw [Matrix.submatrix_apply,Matrix.adjugate_apply,update_blocks,
    Matrix.det_fromBlocks₂₂,update_schur,←Matrix.adjugate_apply]
  rfl

private theorem blocks {M A I : Type*} [Fintype M] [Fintype A]
    (e : M ⊕ A ≃ I) (P : Matrix I I ℂ) :
    P.submatrix e e=Matrix.fromBlocks
      (P.submatrix (e ∘ Sum.inl) (e ∘ Sum.inl))
      (P.submatrix (e ∘ Sum.inl) (e ∘ Sum.inr))
      (P.submatrix (e ∘ Sum.inr) (e ∘ Sum.inl))
      (P.submatrix (e ∘ Sum.inr) (e ∘ Sum.inr)) := by
  ext (i|i) (j|j) <;> rfl

private theorem reindexed_adjugate {M A I : Type*}
    [Fintype M] [DecidableEq M] [Fintype A] [DecidableEq A] [Fintype I] [DecidableEq I]
    (e : M ⊕ A ≃ I) (P : Matrix I I ℂ) (H : Matrix A A ℂ)
    (left : H*P.submatrix (e ∘ Sum.inr) (e ∘ Sum.inr)=1)
    (right : P.submatrix (e ∘ Sum.inr) (e ∘ Sum.inr)*H=1) :
    P.adjugate.submatrix (e ∘ Sum.inl) (e ∘ Sum.inl)=
      (P.submatrix (e ∘ Sum.inr) (e ∘ Sum.inr)).det •
        (P.submatrix (e ∘ Sum.inl) (e ∘ Sum.inl)-
          P.submatrix (e ∘ Sum.inl) (e ∘ Sum.inr)*H*
            P.submatrix (e ∘ Sum.inr) (e ∘ Sum.inl)).adjugate := by
  have generated := active_adjugate_block
    (P.submatrix (e ∘ Sum.inl) (e ∘ Sum.inl))
    (P.submatrix (e ∘ Sum.inl) (e ∘ Sum.inr))
    (P.submatrix (e ∘ Sum.inr) (e ∘ Sum.inl))
    (P.submatrix (e ∘ Sum.inr) (e ∘ Sum.inr)) H left right
  rw [←blocks e P,Matrix.adjugate_submatrix_equiv_self] at generated
  exact generated

private theorem native_block (event : DressedEvent) (n : PhysicalMomentum) (eps sigma : ℝ) :
    (sourceMatterNativeMatrix event n eps sigma).submatrix
      (Subtype.val : NativeInactive → Fin 289) Subtype.val=nativeInactiveBlock (frequencyRay eps 0 n) := by
  ext i j
  have outside : (73 ≤ i.val.val ∧ i.val.val < 121) ∨ 145 ≤ i.val.val := i.property
  simp only [sourceMatterNativeMatrix,Matrix.submatrix_apply,Matrix.map_apply,
    sourceMatterClockPencil,if_pos outside,nativeInactiveBlock]
  have source := congrFun (congrFun (common_jacobi_eval n eps sigma 0) i.val) j.val
  change MvPolynomial.eval (irValues eps sigma 0) (commonJacobi n i.val j.val)=_ at source
  change (clockSpecialize eps (staticIRClockSlice (commonJacobi n i.val j.val))).eval (sigma:ℂ)=_
  rw [ir_clock_specialize,damping_slice_eval]
  exact source

/-- The full prepared cofactor restricts to the same97 cofactor, including
singular full matrices. Only the already generated native192 inverse is used. -/
theorem source_schur97_adjugate_active (event : DressedEvent) (n : PhysicalMomentum)
    (eps sigma : ℝ) (unit : spatialSquare n=1) (positive : 0<eps) (small : eps≤1/2) :
    (sourceMatterNativeMatrix event n eps sigma).adjugate.submatrix
      (Subtype.val : NativeActive → Fin 289) Subtype.val=
      (nativeInactiveBlock (frequencyRay eps 0 n)).det •
        (sourceMatterNativeSchur event n eps sigma).adjugate := by
  have right : (nativeWholeIndex ∘ Sum.inr : NativeInactive → Fin 289)=Subtype.val := rfl
  have left : (nativeWholeIndex ∘ Sum.inl : NativeActive → Fin 289)=Subtype.val := rfl
  have inverse := source_inactive_native_physical_inverse eps n unit positive small
  have generated := reindexed_adjugate nativeWholeIndex (sourceMatterNativeMatrix event n eps sigma)
    (nativeInactiveInverse (frequencyRay eps 0 n))
    (by rw [right,native_block];exact inverse.1)
    (by rw [right,native_block];exact inverse.2)
  rw [right,left,native_block] at generated
  exact generated

/-- The native clearing cancels on the full97 adjugate and determinant
simultaneously, before choosing a current or evaluating an IR limit. -/
theorem source_schur97_adjugate_cross (event : DressedEvent) (n : PhysicalMomentum)
    (eps sigma : ℝ) (unit : spatialSquare n=1) (positive : 0<eps) (small : eps≤1/2) :
    (sourceClockEval eps sigma (nativeClockDenominator n)*
      sourceMatterClockActualDeterminant event n eps sigma) •
        ((sourceSchur97Polynomial event n).map (sourceClockEval eps sigma)).adjugate=
    ((sourceSchur97Polynomial event n).map (sourceClockEval eps sigma)).det •
      (sourceMatterNativeMatrix event n eps sigma).adjugate.submatrix
        (Subtype.val : NativeActive → Fin 289) Subtype.val := by
  rw [source_schur97_adjugate_active event n eps sigma unit positive small,
    source_matter_native_schur_determinant event n eps sigma unit positive small,
    source_schur97_polynomial_eval event n eps sigma unit positive small,
    Matrix.adjugate_smul,Matrix.det_smul,source_inactive_native_dimensions.2]
  ext i j
  simp only [Matrix.smul_apply,smul_eq_mul]
  ring

/-- Independent detector/source currents consume the same normalized
cofactor; every active coupling and mixed direction remains present. -/
theorem source_schur97_current_cofactor_cross (event : DressedEvent) (n : PhysicalMomentum)
    (eps sigma : ℝ) (unit : spatialSquare n=1) (positive : 0<eps) (small : eps≤1/2)
    (detector source : NativeActive → ℂ) :
    (sourceClockEval eps sigma (nativeClockDenominator n)*
      sourceMatterClockActualDeterminant event n eps sigma)*
      dotProduct detector (((sourceSchur97Polynomial event n).map (sourceClockEval eps sigma)).adjugate*ᵥsource)=
    ((sourceSchur97Polynomial event n).map (sourceClockEval eps sigma)).det*
      dotProduct detector ((sourceMatterNativeMatrix event n eps sigma).adjugate.submatrix
        (Subtype.val : NativeActive → Fin 289) Subtype.val*ᵥsource) := by
  have generated := congrArg (fun M : Matrix NativeActive NativeActive ℂ => dotProduct detector (M*ᵥsource))
    (source_schur97_adjugate_cross event n eps sigma unit positive small)
  simpa only [Matrix.smul_mulVec,dotProduct_smul,smul_eq_mul] using generated

