/-- The field strength uses the curl generated by the original action's seventy-two auxiliary
momentum rows; its potential is read only after the whole field has propagated. -/
def sourceEMFieldStrength (p : Fin 4 → ℂ) (v : Fin 289 → ℂ) : Fin 6 → ℂ :=
  nativeMomentumCurl p (emInsertion.transpose*ᵥv)

def sourceEMExcitation (p : Fin 4 → ℂ) (v : Fin 289 → ℂ) : Fin 6 → ℂ :=
  fun pair => (nativeAuxiliaryWeight pair)⁻¹*sourceEMFieldStrength p v pair

def sourceEMExternalCurrent (p : Fin 4 → ℂ) (forcing : Fin 289 → ℂ) : Fin 4 → ℂ :=
  nativeEMRestInsertion.transpose*ᵥnativeCompleteForceRead p forcing

def sourceEMInducedCurrent (p : Fin 4 → ℂ) (Q : Matrix (Fin 289) (Fin 289) ℂ)
    (v : Fin 289 → ℂ) : Fin 4 → ℂ :=
  nativeEMRestInsertion.transpose*ᵥnativeCompleteCorrection p Q v

/-- This contraction is the physical Fourier continuity equation, including the induced current. -/
def sourceEMContinuity (p : Fin 4 → ℂ) (current : Fin 4 → ℂ) : ℂ :=
  dotProduct p current

private theorem original_curl_continuity (p : Fin 4 → ℂ) (b : Fin 6 → ℂ) :
    dotProduct p (nativeMomentumDivergence p b)=0 := by
  simp only [dotProduct,Fin.sum_univ_four,nativeMomentumDivergence]
  dsimp only [Matrix.vecCons,Matrix.vecHead,Matrix.vecTail,Fin.cons,Fin.cases,Fin.induction,Fin.induction.go,Fin.succ,Fin.castAdd]
  simp only [eq_mpr_eq_cast,cast_eq]
  ring1

private theorem original_curl_pairing (p v : Fin 4 → ℂ) (b : Fin 6 → ℂ) :
    dotProduct v (nativeMomentumDivergence p b)=dotProduct (nativeMomentumCurl p v) b := by
  simp only [dotProduct,Fin.sum_univ_four,Fin.sum_univ_six,nativeMomentumDivergence,nativeMomentumCurl]
  dsimp only [Matrix.vecCons,Matrix.vecHead,Matrix.vecTail,Fin.cons,Fin.cases,Fin.induction,Fin.induction.go,Fin.succ,Fin.castAdd]
  simp only [eq_mpr_eq_cast,cast_eq]
  ring1

/-- The full original action Schur generates the Maxwell curl/divergence, all external forcing,
all quantum auxiliary forcing, and both native background/lower terms in one equation. -/
theorem source_em_maxwell_whole_action (p : Fin 4 → ℂ) (Q : Matrix (Fin 289) (Fin 289) ℂ)
    (v : Fin 289 → ℂ) :
    nativeMomentumDivergence p (sourceEMExcitation p v)=
      sourceEMExternalCurrent p ((emOriginalJacobi p-Q)*ᵥv)+sourceEMInducedCurrent p Q v := by
  change nativeMomentumDivergence p (fun pair => (nativeAuxiliaryWeight pair)⁻¹*
    nativeMomentumCurl p (emInsertion.transpose*ᵥv) pair)=_
  rw [←actual_native_em_momentum_matrix_action]
  exact actual_native_forced_principal p Q v

/-- The actual positive-damping inverse pays the forcing equation before its EM field strength is read. -/
theorem actual_corrected_maxwell_generated (event : DressedEvent) (eps s sigma : ℝ) (n : PhysicalMomentum)
    (positive : 0<sigma) (regular : correctedDet event eps s sigma n≠0) (forcing : Fin 289 → ℂ) :
    let p := frequencyRay eps s n
    let Q := frequencyQuantumCorrection event ((eps^2 : ℝ) • n) (frequencyRay eps s n) (dampedFourierClock (sourceFrequency eps s) sigma)
    let v := correctedResponse event eps s sigma n forcing
    nativeMomentumDivergence p (sourceEMExcitation p v)=
      sourceEMExternalCurrent p forcing+sourceEMInducedCurrent p Q v ∧
      sourceEMContinuity p (sourceEMExternalCurrent p forcing+sourceEMInducedCurrent p Q v)=0 := by
  dsimp only
  have source := source_em_maxwell_whole_action (frequencyRay eps s n)
    (frequencyQuantumCorrection event ((eps^2 : ℝ) • n) (frequencyRay eps s n) (dampedFourierClock (sourceFrequency eps s) sigma))
    (correctedResponse event eps s sigma n forcing)
  have equation := actual_corrected_response_equation event eps s sigma n positive regular forcing
  unfold frequencyResponsePencil at equation
  change (emOriginalJacobi (frequencyRay eps s n)-
    frequencyQuantumCorrection event ((eps^2 : ℝ) • n) (frequencyRay eps s n) (dampedFourierClock (sourceFrequency eps s) sigma))*ᵥ
      correctedResponse event eps s sigma n forcing=forcing at equation
  rw [equation] at source
  refine ⟨source,?_⟩
  rw [sourceEMContinuity,←source]
  exact original_curl_continuity _ _

/-- This is a source Hessian pairing; the complete induced-current work remains on its right side. -/
theorem actual_corrected_maxwell_action_pairing (event : DressedEvent) (eps s sigma : ℝ)
    (n : PhysicalMomentum) (positive : 0<sigma) (regular : correctedDet event eps s sigma n≠0)
    (forcing : Fin 289 → ℂ) :
    let p := frequencyRay eps s n
    let Q := frequencyQuantumCorrection event ((eps^2 : ℝ) • n) (frequencyRay eps s n) (dampedFourierClock (sourceFrequency eps s) sigma)
    let v := correctedResponse event eps s sigma n forcing
    dotProduct (sourceEMFieldStrength p v) (sourceEMExcitation p v)=
      dotProduct (emInsertion.transpose*ᵥv) (sourceEMExternalCurrent p forcing+sourceEMInducedCurrent p Q v) := by
  dsimp only
  have source := (actual_corrected_maxwell_generated event eps s sigma n positive regular forcing).1
  rw [←source]
  exact (original_curl_pairing _ _ _).symm

def sourcePhysicalElectric (omega : ℝ) (k : PhysicalMomentum) (v : Fin 289 → ℂ) : Fin 3 → ℂ :=
  fun i => Complex.I*sourceEMFieldStrength (physicalFrequencyMomentum omega k) v ⟨3+i.val,by omega⟩

def sourcePhysicalMagnetic (omega : ℝ) (k : PhysicalMomentum) (v : Fin 289 → ℂ) : Fin 3 → ℂ :=
  fun i => -Complex.I*sourceEMFieldStrength (physicalFrequencyMomentum omega k) v ⟨i.val,by omega⟩

def sourceSpatialDot (k : PhysicalMomentum) (e : Fin 3 → ℂ) : ℂ :=
  (k 0 : ℂ)*e 0+(k 1 : ℂ)*e 1+(k 2 : ℂ)*e 2

def sourceSpatialCross (k : PhysicalMomentum) (e : Fin 3 → ℂ) : Fin 3 → ℂ :=
  ![(k 1 : ℂ)*e 2-(k 2 : ℂ)*e 1,(k 2 : ℂ)*e 0-(k 0 : ℂ)*e 2,
    (k 0 : ℂ)*e 1-(k 1 : ℂ)*e 0]

private theorem four_zero (v : Fin 4 → ℂ) (h : 0<4) : v (⟨0,h⟩ : Fin 4)=v 0 := rfl
private theorem four_one (v : Fin 4 → ℂ) (h : 1<4) : v (⟨1,h⟩ : Fin 4)=v 1 := rfl
private theorem four_two (v : Fin 4 → ℂ) (h : 2<4) : v (⟨2,h⟩ : Fin 4)=v 2 := rfl
private theorem four_three (v : Fin 4 → ℂ) (h : 3<4) : v (⟨3,h⟩ : Fin 4)=v 3 := rfl
private theorem three_zero (v : Fin 3 → ℝ) (h : 0<3) : v (⟨0,h⟩ : Fin 3)=v 0 := rfl
private theorem three_one (v : Fin 3 → ℝ) (h : 1<3) : v (⟨1,h⟩ : Fin 3)=v 1 := rfl
private theorem three_two (v : Fin 3 → ℝ) (h : 2<3) : v (⟨2,h⟩ : Fin 3)=v 2 := rfl

theorem source_electric_coordinates (omega : ℝ) (k : PhysicalMomentum) (v : Fin 289 → ℂ) :
    sourcePhysicalElectric omega k v=fun i =>
      (omega : ℂ)*(emInsertion.transpose*ᵥv) i.succ+(k i : ℂ)*(emInsertion.transpose*ᵥv) 0 := by
  funext i
  fin_cases i <;>
    simp only [sourcePhysicalElectric,sourceEMFieldStrength,nativeMomentumCurl,physicalFrequencyMomentum]
  all_goals dsimp only [Matrix.vecCons,Matrix.vecHead,Matrix.vecTail,Fin.cons,Fin.cases,Fin.induction,Fin.induction.go,Fin.succ,Fin.castAdd]
  all_goals simp only [eq_mpr_eq_cast,cast_eq,Fin.reduceFinMk,four_one,four_two,four_three]
  all_goals ring_nf
  all_goals try simp only [Complex.I_sq]
  all_goals ring1

theorem source_magnetic_coordinates (omega : ℝ) (k : PhysicalMomentum) (v : Fin 289 → ℂ) :
    sourcePhysicalMagnetic omega k v=sourceSpatialCross k (fun i => (emInsertion.transpose*ᵥv) i.succ) := by
  funext i
  fin_cases i <;>
    simp only [sourcePhysicalMagnetic,sourceEMFieldStrength,nativeMomentumCurl,physicalFrequencyMomentum,sourceSpatialCross]
  all_goals dsimp only [Matrix.vecCons,Matrix.vecHead,Matrix.vecTail,Fin.cons,Fin.cases,Fin.induction,Fin.induction.go,Fin.succ,Fin.castAdd]
  all_goals simp only [eq_mpr_eq_cast,cast_eq,Fin.reduceFinMk,four_one,four_two,four_three]
  all_goals ring_nf
  all_goals try simp only [Complex.I_sq]
  all_goals ring1

/-- Faraday and magnetic Gauss are identities of the same action-generated field strength,
without a transverse-potential, on-shell, isotropy, or native-speed assumption. -/
theorem source_em_physical_bianchi (omega : ℝ) (k : PhysicalMomentum) (v : Fin 289 → ℂ) :
    sourceSpatialDot k (sourcePhysicalMagnetic omega k v)=0 ∧
    sourceSpatialCross k (sourcePhysicalElectric omega k v)=(omega : ℂ) • sourcePhysicalMagnetic omega k v := by
  rw [source_electric_coordinates,source_magnetic_coordinates]
  constructor
  · simp only [sourceSpatialDot,sourceSpatialCross]
    dsimp only [Matrix.vecCons,Matrix.vecHead,Matrix.vecTail,Fin.cons,Fin.cases,Fin.induction,Fin.induction.go]
    simp only [eq_mpr_eq_cast,cast_eq]
    ring1
  · funext i
    fin_cases i <;> simp only [sourceSpatialCross,Pi.smul_apply,smul_eq_mul]
    all_goals dsimp only [Matrix.vecCons,Matrix.vecHead,Matrix.vecTail,Fin.cons,Fin.cases,Fin.induction,Fin.induction.go,Fin.succ]
    all_goals simp only [eq_mpr_eq_cast,cast_eq,four_one,four_two,four_three]
    all_goals ring1

def sourcePhysicalMaxwellRead (omega : ℝ) (k : PhysicalMomentum) (v : Fin 289 → ℂ) : Fin 4 → ℂ :=
  Fin.cons (2*(lapse : ℂ)*sourceSpatialDot k (sourcePhysicalElectric omega k v))
    (fun i => 2*(lapse : ℂ)*(omega : ℂ)*sourcePhysicalElectric omega k v i+
      2*(lapse : ℂ)⁻¹*sourceSpatialCross k (sourcePhysicalMagnetic omega k v) i)

/-- The electric coefficient and magnetic coefficient come from the original auxiliary action,
with the physical Fourier signs retained. -/
theorem source_em_physical_maxwell_principal (omega : ℝ) (k : PhysicalMomentum) (v : Fin 289 → ℂ) :
    sourcePhysicalMaxwellRead omega k v=nativePhysicalEMPrincipal omega k (emInsertion.transpose*ᵥv) := by
  rw [sourcePhysicalMaxwellRead,source_electric_coordinates,source_magnetic_coordinates]
  funext mu
  fin_cases mu <;> simp only [nativePhysicalEMPrincipal,sourceSpatialDot,sourceSpatialCross]
  all_goals dsimp only [Matrix.vecCons,Matrix.vecHead,Matrix.vecTail,Fin.cons,Fin.cases,Fin.induction,Fin.induction.go,Fin.succ,Fin.castAdd]
  all_goals simp only [eq_mpr_eq_cast,cast_eq,four_one,four_two,four_three,three_zero,three_one,three_two]
  all_goals ring1

/-- All sixteen actual forcing columns and their full induced currents enter the Maxwell read. -/
theorem actual_corrected_all_sixteen_maxwell (event : DressedEvent) (eps s : ℝ) (n : PhysicalMomentum)
    (nu : Fin 4) (balanced : PencilClockBalanced event eps n)
    (finite : EMColumnsClockFinite event eps n)
    (dRegular : (zeroClockClearing event eps n).eval (s : ℂ)≠0)
    (DRegular : (zeroClockFrequencyDenominator event eps n).eval (s : ℂ)≠0) :
    sourcePhysicalMaxwellRead (sourceFrequency eps s) ((eps^2 : ℝ) • n)
      (zeroClockEMColumnRead event eps s n nu)=
        ((3/4 : ℂ) • Pi.single nu 1)+sourceEMInducedCurrent (frequencyRay eps s n)
          (zeroClockQuantumResponse event eps s n) (zeroClockEMColumnRead event eps s n nu) := by
  rw [source_em_physical_maxwell_principal]
  exact actual_corrected_em_principal_source event eps s n nu balanced finite dRegular DRegular

/-- The same original composite vertex pays both its full quantized action read and contact.
It is not replaced by a bare charge or an EM-only forcing. -/
theorem actual_composite_maxwell_current (p : PhysicalMomentum) (left right : CompositeLeg) (mu : Fin 4) :
    noetherEMCurrent p left right mu=
      -(Stage10.ActionNormalization.phaseMomentum : ℂ)⁻¹*
        rawForm (PhysicalEMGaugeRealization.emGaugeField mu) p
          (compositeUnitLeg left) (compositeUnitLeg right) 0 :=
  actual_noether_em_reader p left right mu

