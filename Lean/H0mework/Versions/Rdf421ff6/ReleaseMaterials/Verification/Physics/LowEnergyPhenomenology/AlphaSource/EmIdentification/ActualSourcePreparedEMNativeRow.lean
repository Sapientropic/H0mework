private def staticTerms (ts : List SourceTerm) : List SourceTerm :=
  ts.filter (fun a => a.powers.temporal = 0)

private theorem static_terms_value (ts : List SourceTerm) (p : Fin 4 → ℂ)
    (static : p 0 = 0) : sourceMatrix (staticTerms ts) p = sourceMatrix ts p := by
  induction ts with
  | nil => rfl
  | cons a rest ih =>
    simp only [staticTerms] at ih
    by_cases same : a.powers.temporal = 0
    · simp [staticTerms,same,sourceMatrix_cons,ih]
    · have zero : a.matrix p = 0 := by
        ext i j
        simp [SourceTerm.matrix,Powers.value,static,zero_pow same]
      simp [staticTerms,same,sourceMatrix_cons,ih,zero]

private theorem actual_jacobi_terms (p : Fin 4 → ℂ) :
    sourceMatrix originalJacobiTerms p = emOriginalJacobi p :=
  (em_jacobi_source p).symm

private theorem column_filter_entry (ts : List SourceTerm) (f : Fin 289 → Bool)
    (p : Fin 4 → ℂ) (i j : Fin 289) :
    sourceMatrix (ts.filter (fun a => f a.column)) p i j =
      if f j then sourceMatrix ts p i j else 0 := by
  induction ts with
  | nil => simp [sourceMatrix]
  | cons a rest ih =>
    by_cases same : a.column = j
    · by_cases keep : f j = true <;>
        simp [same,keep,sourceMatrix_cons,ih]
    · have zero : a.matrix p i j = 0 := by
        simp [SourceTerm.matrix,Matrix.single,same]
      cases keep : f a.column <;> simp [keep,sourceMatrix_cons,ih,zero]

private def wholeIndex : Fin 217 ⊕ (Fin 6 × Fin 12) ≃ Fin 289 :=
  (Equiv.sumCongr (Equiv.refl (Fin 217)) finProdFinEquiv).trans finSumFinEquiv

private theorem whole_sum (f : Fin 289 → ℂ) :
    (∑ i,f i) = (∑ i : Fin 217,f (nativeRestIndex i)) +
      ∑ i : Fin 6 × Fin 12,f (gaugeAuxiliaryIndex i) := by
  rw [← wholeIndex.sum_comp f,Fintype.sum_sum_type]
  have left (i : Fin 217) : wholeIndex (Sum.inl i) = nativeRestIndex i := rfl
  have right (i : Fin 6 × Fin 12) : wholeIndex (Sum.inr i) = gaugeAuxiliaryIndex i := by
    apply Fin.ext
    change 217+(i.2.val+12*i.1.val)=217+12*i.1.val+i.2.val
    omega
  simp only [left,right]

private theorem inverse_row_rest_zero (p : Fin 4 → ℂ) (i : Fin 217) :
    sourceMatrix sourceEMNativeInverseRowTerms p 0 (nativeRestIndex i) = 0 := by
  have support : sourceEMNativeInverseRowTerms.filter (fun a => decide (217 ≤ a.column.val)) =
      sourceEMNativeInverseRowTerms := by decide +kernel
  have filtered := column_filter_entry sourceEMNativeInverseRowTerms
    (fun j => decide (217 ≤ j.val)) p 0 (nativeRestIndex i)
  rw [support] at filtered
  simpa [nativeRestIndex,not_le.mpr i.isLt] using filtered

/-- Exact source coefficients solve the actual auxiliary row equation. -/
theorem source_em_native_inverse_terms_certificate :
    fastNormalizeTerms
      ((productTerms sourceEMNativeInverseRowTerms (staticTerms originalJacobiTerms)).filter
        (fun a => decide (217 ≤ a.column.val)) ++
        negativeTerms ((sourceEMJacobiConstantTerms ++ sourceEMJacobiSpatialTerms).filter
          (fun a => decide (217 ≤ a.column.val)))) = [] := by
  decide +kernel

private def inverseRow (p : Fin 4 → ℂ) : Matrix Unit (Fin 6 × Fin 12) ℂ :=
  fun _ j => sourceMatrix sourceEMNativeInverseRowTerms p 0 (gaugeAuxiliaryIndex j)

private def nativeAuxiliaryRow (p : Fin 4 → ℂ) : Matrix Unit (Fin 6 × Fin 12) ℂ :=
  fun _ j => (nativeEMRestInsertion.transpose * nativeRestAuxiliary p) 0 j

private theorem actual_auxiliary_row (p : Fin 4 → ℂ) (static : p 0 = 0)
    (j : Fin 6 × Fin 12) :
    nativeAuxiliaryRow p () j = sourceMatrix sourceEMJacobiConstantTerms p 0 (gaugeAuxiliaryIndex j) +
      sourceMatrix sourceEMJacobiSpatialTerms p 0 (gaugeAuxiliaryIndex j) := by
  have observed := congrFun (actual_complete_em_observation
    (fun i => emOriginalJacobi p i (gaugeAuxiliaryIndex j))) 0
  have literal := source_em_jacobi_row_split p static (gaugeAuxiliaryIndex j)
  change nativeAuxiliaryRow p () j = _ at observed
  change _ = ∑ i : Fin 289,sourceTemporalEMForce i *
    emOriginalJacobi p i (gaugeAuxiliaryIndex j) at observed
  exact observed.trans literal

private theorem inverse_row_equation (p : Fin 4 → ℂ) (static : p 0 = 0) :
    inverseRow p * originalGaugeAuxiliaryPencil p = nativeAuxiliaryRow p := by
  funext i j
  have value := normalization_equal _ _ source_em_native_inverse_terms_certificate p
  have high : 217 ≤ (gaugeAuxiliaryIndex j).val := by
    dsimp only [gaugeAuxiliaryIndex,gaugeBSlot];omega
  have left := column_filter_entry
    (productTerms sourceEMNativeInverseRowTerms (staticTerms originalJacobiTerms))
    (fun j => decide (217 ≤ j.val)) p 0 (gaugeAuxiliaryIndex j)
  have right := column_filter_entry (sourceEMJacobiConstantTerms ++ sourceEMJacobiSpatialTerms)
    (fun j => decide (217 ≤ j.val)) p 0 (gaugeAuxiliaryIndex j)
  simp only [high,decide_true,eq_self,if_true] at left right
  have entry := left.symm.trans ((congrFun (congrFun value 0) (gaugeAuxiliaryIndex j)).trans right)
  rw [productTerms_value,static_terms_value _ p static,actual_jacobi_terms,
    sourceMatrix_append] at entry
  have split := whole_sum (fun k => sourceMatrix sourceEMNativeInverseRowTerms p 0 k *
    emOriginalJacobi p k (gaugeAuxiliaryIndex j))
  simp only [inverse_row_rest_zero,zero_mul,Finset.sum_const_zero,zero_add] at split
  rw [Matrix.add_apply,← actual_auxiliary_row p static j] at entry
  exact split.symm.trans entry

/-- The finite source row consumes the original complete auxiliary inverse. -/
theorem source_em_native_inverse_row (p : Fin 4 → ℂ) (static : p 0 = 0) :
    inverseRow p = nativeAuxiliaryRow p * nativeAuxiliaryInverseMatrix := by
  calc
    inverseRow p = inverseRow p * (originalGaugeAuxiliaryPencil p * nativeAuxiliaryInverseMatrix) := by
      rw [actual_native_auxiliary_matrix_right,Matrix.mul_one]
    _ = _ := by rw [← Matrix.mul_assoc,inverse_row_equation p static]

