private def nativeSchurRowTerms : List SourceTerm :=
  sourceEMJacobiConstantTerms ++ sourceEMJacobiSpatialTerms ++
    negativeTerms (productTerms sourceEMNativeInverseRowTerms (staticTerms originalJacobiTerms))

/-- All 25 coefficients are checked against the same original Hessian and
inverse row. No matter or coframe term is removed by an EM-only projection. -/
theorem source_em_native_schur_terms_certificate :
    fastNormalizeTerms (nativeSchurRowTerms ++
      negativeTerms (sourceEMNativeBackgroundTerms ++ sourceEMNativeLowerTerms ++
        sourceEMNativePrincipalTerms)) = [] := by
  decide +kernel

private theorem inverse_row_full_read (p : Fin 4 → ℂ) (v : Fin 289 → ℂ) :
    (sourceMatrix sourceEMNativeInverseRowTerms p *ᵥ v) 0 =
      (inverseRow p *ᵥ emAuxiliarySlice v) () := by
  have split := whole_sum (fun j => sourceMatrix sourceEMNativeInverseRowTerms p 0 j * v j)
  simp only [inverse_row_rest_zero,zero_mul,Finset.sum_const_zero,zero_add] at split
  exact split

private theorem inverse_row_actual_read (p : Fin 4 → ℂ) (static : p 0 = 0)
    (u : (Fin 6 × Fin 12) → ℂ) :
    (inverseRow p *ᵥ u) () =
      (nativeEMRestInsertion.transpose *ᵥ
        (nativeRestAuxiliary p *ᵥ (nativeAuxiliaryInverseMatrix *ᵥ u))) 0 := by
  rw [source_em_native_inverse_row p static]
  rw [Matrix.mulVec_mulVec,Matrix.mulVec_mulVec]
  rfl

/-- The finite source polynomial is exactly the complete native temporal
Schur read on every full field at static momentum. -/
theorem source_em_native_schur_row (p : Fin 4 → ℂ) (static : p 0 = 0)
    (v : Fin 289 → ℂ) :
    (sourceMatrix (sourceEMNativeBackgroundTerms ++ sourceEMNativeLowerTerms ++
        sourceEMNativePrincipalTerms) p *ᵥ v) 0 =
      (nativeEMRestInsertion.transpose *ᵥ (nativeSchurMatrix p *ᵥ emRestSlice v)) 0 := by
  have normalized := normalization_equal _ _ source_em_native_schur_terms_certificate p
  rw [← normalized,nativeSchurRowTerms,sourceMatrix_append,sourceMatrix_append,
    negativeTerms_value,productTerms_value,static_terms_value _ p static,actual_jacobi_terms,
    Matrix.add_mulVec,Matrix.add_mulVec,Matrix.neg_mulVec,← Matrix.mulVec_mulVec]
  have jacobi := congrArg (fun T : Matrix (Fin 289) (Fin 289) ℂ => (T *ᵥ v) 0)
    (source_em_static_jacobi_split p static)
  rw [Matrix.add_mulVec,← Matrix.mulVec_mulVec,source_em_row_projector_actual] at jacobi
  simp only [Pi.add_apply,Pi.neg_apply] at jacobi ⊢
  rw [← jacobi,inverse_row_full_read,inverse_row_actual_read p static]
  rw [actual_native_complete_force_identity,nativeCompleteForceRead,Matrix.mulVec_sub,
    actual_complete_em_observation]
  rfl

