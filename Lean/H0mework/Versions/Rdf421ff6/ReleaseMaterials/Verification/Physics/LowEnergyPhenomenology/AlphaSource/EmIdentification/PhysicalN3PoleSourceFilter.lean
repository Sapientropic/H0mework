/-! Whole-family sourceFilter completion of the generated N3 pole packet. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
namespace LowEnergy.GaussComposite.PhysicalN3SourceEnergy
open GaussCoreHilbert CanonicalGradedSpatialSource ActualCompositeFieldCurrent
open PreparationVacuumMixedFieldReturn PreparationVacuumJointFieldResponse
open PreparationVacuumUncutYukawa PreparationVacuumSourcePreparedResponse
open GaussComposite.SourceGraph
open ActualDressedUniformMaterialCoefficients ActualElectronPhysicalJointInverse
open ActualElectronWholeChargeSoft CanonicalGradedCharge PreparationPhysicalPhaseGaugeRealization
open SourceFamilyHilbert SourceFamilyOperator
open SourcePropagationAlgebraicResponse SourcePropagationCommonMomentum
open LowEnergy.ActualDressedVisiblePole
open Filter
open scoped InnerProductSpace Topology

attribute [local irreducible] actualElectronPhysicalSeed actualElectronPhysicalResponse
  materialJointNumerator jointGenerator jointResolvent jointPolynomial compressionPolynomial
  physicalN3InputEnergyRead physicalN3InputEnergyNumerator
  physicalN3OutputEnergyNumerator physicalN3OutputEnergyGerm actualElectronPhysicalUnit
  physicalN3OutputPoleOrder physicalN3OutputPoleLeading physicalN3OutputPoleUnit
  actualElectronPhysicalChargeCorrection chargeReader
  physicalN3PolePhase physicalN3PoleEnergyRadius physicalN3PoleEnergyScale
  physicalN3PoleApproachEnergy

/-- A pole section picks the source-generated pole at every preparation frame `F`;
the caller supplies only the section, never an order/leading/eigenstate witness. -/
abbrev N3SourceEnergyPoleSection (p : PhysicalMomentum) (leg : CompositeLeg) : Type :=
  ∀ F : GaussUnitaryHistory.Index, N3SourceEnergyPole p F leg

/-- Every frame's accepted pole packet is inhabited, so the whole section exists. -/
noncomputable instance instNonemptyN3SourceEnergyPoleSection (p : PhysicalMomentum)
    (leg : CompositeLeg) : Nonempty (N3SourceEnergyPoleSection p leg) :=
  ⟨fun F => Classical.choice (instNonemptyN3SourceEnergyPole p F leg)⟩

/-- The original whole-source family generated by the pole unit at every frame. -/
def physicalN3PoleFamily (p : PhysicalMomentum) (leg : CompositeLeg)
    (poles : N3SourceEnergyPoleSection p leg) : ElectronFamily :=
  ⟨fun F => physicalN3OutputPoleUnit p F leg (poles F), 1, zero_le_one,
    fun F => (physical_n3_output_pole_unit_norm p F leg (poles F)).le⟩

/-- The adaptive approach family: the phased upper unit at the generated approach
energy `pole.val + i·scale m`. -/
def physicalN3PoleApproachFamily (p : PhysicalMomentum) (leg : CompositeLeg)
    (poles : N3SourceEnergyPoleSection p leg) (m : ℕ) : ElectronFamily :=
  ⟨fun F => physicalN3PoleApproachUnit p F leg (poles F) m, 1, zero_le_one,
    fun F => (physical_n3_pole_approach_unit_norm p F leg (poles F) m).le⟩

/-- The completed pole state in the original `HistorySpace`. -/
def physicalN3PoleState (p : PhysicalMomentum) (leg : CompositeLeg)
    (poles : N3SourceEnergyPoleSection p leg) : ElectronHistory :=
  (physicalN3PoleFamily p leg poles : ElectronHistory)

/-- The completed approach state at scale level `m`. -/
def physicalN3PoleApproachState (p : PhysicalMomentum) (leg : CompositeLeg)
    (poles : N3SourceEnergyPoleSection p leg) (m : ℕ) : ElectronHistory :=
  (physicalN3PoleApproachFamily p leg poles m : ElectronHistory)

theorem physical_n3_pole_state_norm (p : PhysicalMomentum) (leg : CompositeLeg)
    (poles : N3SourceEnergyPoleSection p leg) :
    ‖physicalN3PoleState p leg poles‖ = 1 := by
  have convergence := SourceFamilyHilbert.norm_tendsto GaussUnitaryHistory.sourceFilter
    (physicalN3PoleFamily p leg poles)
  simp only [physicalN3PoleFamily, SourceFamilyHilbert.value,
    physical_n3_output_pole_unit_norm] at convergence
  have norm : (1:ℝ) = ‖physicalN3PoleFamily p leg poles‖ :=
    tendsto_nhds_unique (tendsto_const_nhds (x:=(1:ℝ))) convergence
  rw [physicalN3PoleState, UniformSpace.Completion.norm_coe, ← norm]

theorem physical_n3_pole_approach_state_norm (p : PhysicalMomentum) (leg : CompositeLeg)
    (poles : N3SourceEnergyPoleSection p leg) (m : ℕ) :
    ‖physicalN3PoleApproachState p leg poles m‖ = 1 := by
  have convergence := SourceFamilyHilbert.norm_tendsto GaussUnitaryHistory.sourceFilter
    (physicalN3PoleApproachFamily p leg poles m)
  simp only [physicalN3PoleApproachFamily, SourceFamilyHilbert.value,
    physical_n3_pole_approach_unit_norm] at convergence
  have norm : (1:ℝ) = ‖physicalN3PoleApproachFamily p leg poles m‖ :=
    tendsto_nhds_unique (tendsto_const_nhds (x:=(1:ℝ))) convergence
  rw [physicalN3PoleApproachState, UniformSpace.Completion.norm_coe, ← norm]

/-- The completed approach stays within the soft budget of the pole state, frame by
frame through the genuine upper limit. -/
theorem physical_n3_pole_state_error (p : PhysicalMomentum) (leg : CompositeLeg)
    (poles : N3SourceEnergyPoleSection p leg) (m : ℕ) :
    ‖physicalN3PoleApproachState p leg poles m - physicalN3PoleState p leg poles‖
      ≤ actualSoftBudget m := by
  rw [physicalN3PoleApproachState, physicalN3PoleState,
    ← UniformSpace.Completion.coe_sub, UniformSpace.Completion.norm_coe]
  apply SourceFamilyHilbert.norm_le_of_eventually GaussUnitaryHistory.sourceFilter _
    (actualSoftBudget m)
  apply Eventually.of_forall
  intro F
  change ‖physicalN3PoleApproachUnit p F leg (poles F) m -
    physicalN3OutputPoleUnit p F leg (poles F)‖ ≤ _
  exact physical_n3_pole_approach_error p F leg (poles F) m

/-- The completed approach states return to the completed pole state along `m`. -/
theorem physical_n3_pole_state_return (p : PhysicalMomentum) (leg : CompositeLeg)
    (poles : N3SourceEnergyPoleSection p leg) :
    Tendsto (fun m => physicalN3PoleApproachState p leg poles m) atTop
      (𝓝 (physicalN3PoleState p leg poles)) := by
  apply Metric.tendsto_nhds.mpr
  intro epsilon positive
  exact (actual_soft_budget_tendsto.eventually (eventually_lt_nhds positive)).mono
    (fun m small => by
      rw [dist_eq_norm]
      exact (physical_n3_pole_state_error p leg poles m).trans_lt small)

/-- The pole charge-mixing correction family: the bounded charge reader on the pole
family minus the original sign factor; the norm-inverse `Rmix` correction is retained
through the completion. -/
def physicalN3PoleCorrectionFamily (p : PhysicalMomentum) (leg : CompositeLeg)
    (poles : N3SourceEnergyPoleSection p leg) : ElectronFamily :=
  SourceFamilyOperator.act GaussUnitaryHistory.sourceFilter
    (SourceFamilyOperator.constant (chargeReader sourcePhaseGaugeLie))
    (physicalN3PoleFamily p leg poles) -
    actualElectronSign leg • physicalN3PoleFamily p leg poles

/-- The approach correction family at scale `m`. -/
def physicalN3PoleApproachCorrectionFamily (p : PhysicalMomentum) (leg : CompositeLeg)
    (poles : N3SourceEnergyPoleSection p leg) (m : ℕ) : ElectronFamily :=
  SourceFamilyOperator.act GaussUnitaryHistory.sourceFilter
    (SourceFamilyOperator.constant (chargeReader sourcePhaseGaugeLie))
    (physicalN3PoleApproachFamily p leg poles m) -
    actualElectronSign leg • physicalN3PoleApproachFamily p leg poles m

def physicalN3PoleCorrection (p : PhysicalMomentum) (leg : CompositeLeg)
    (poles : N3SourceEnergyPoleSection p leg) : ElectronHistory :=
  (physicalN3PoleCorrectionFamily p leg poles : ElectronHistory)

def physicalN3PoleApproachCorrection (p : PhysicalMomentum) (leg : CompositeLeg)
    (poles : N3SourceEnergyPoleSection p leg) (m : ℕ) : ElectronHistory :=
  (physicalN3PoleApproachCorrectionFamily p leg poles m : ElectronHistory)

/-- The approach correction's per-frame value is the source phase times the original
`Rmix` charge correction at the generated approach energy; nothing is discarded. -/
theorem physical_n3_pole_approach_correction_value (p : PhysicalMomentum)
    (leg : CompositeLeg) (poles : N3SourceEnergyPoleSection p leg) (m : ℕ)
    (F : GaussUnitaryHistory.Index) :
    SourceFamilyHilbert.value (physicalN3PoleApproachCorrectionFamily p leg poles m) F =
      physicalN3PolePhase p F leg (poles F) •
        actualElectronPhysicalChargeCorrection p F
          (physicalN3PoleApproachEnergy p F leg (poles F) m) leg := by
  change chargeReader sourcePhaseGaugeLie
      (physicalN3PoleApproachUnit p F leg (poles F) m) -
    actualElectronSign leg • physicalN3PoleApproachUnit p F leg (poles F) m = _
  unfold physicalN3PoleApproachUnit
  rw [map_smul, smul_comm, ← smul_sub]
  congr 1
  have hc : chargeReader sourcePhaseGaugeLie
      (actualElectronPhysicalUnit p F
        (physicalN3PoleApproachEnergy p F leg (poles F) m) leg) =
      actualElectronSign leg •
        actualElectronPhysicalUnit p F
          (physicalN3PoleApproachEnergy p F leg (poles F) m) leg +
      actualElectronPhysicalChargeCorrection p F
        (physicalN3PoleApproachEnergy p F leg (poles F) m) leg := by
    simpa only [actualElectronSign] using
      actual_electron_physical_unit_charge p F _
        (physical_n3_pole_energy_nonreal p F leg (poles F) m) leg
  rw [hc, add_sub_cancel_left]

/-- The completed pole charge equation: the original bounded reader decomposes the pole
state into its sign part plus the generated correction. -/
theorem physical_n3_pole_charge_equation (p : PhysicalMomentum) (leg : CompositeLeg)
    (poles : N3SourceEnergyPoleSection p leg) :
    GaussUnitaryHistory.reader (chargeReader sourcePhaseGaugeLie)
      (physicalN3PoleState p leg poles) =
      actualElectronSign leg • physicalN3PoleState p leg poles +
        physicalN3PoleCorrection p leg poles := by
  unfold physicalN3PoleState GaussUnitaryHistory.reader physicalN3PoleCorrection
  rw [SourceFamilyOperator.lift_coe, physicalN3PoleCorrectionFamily,
    UniformSpace.Completion.coe_sub, UniformSpace.Completion.coe_smul]
  abel

/-- The completed correction is bounded by `‖Q‖ + 1`. -/
theorem physical_n3_pole_correction_bound (p : PhysicalMomentum) (leg : CompositeLeg)
    (poles : N3SourceEnergyPoleSection p leg) :
    ‖physicalN3PoleCorrection p leg poles‖ ≤
      ‖chargeReader sourcePhaseGaugeLie‖ + 1 := by
  rw [physicalN3PoleCorrection, UniformSpace.Completion.norm_coe]
  apply SourceFamilyHilbert.norm_le_of_eventually GaussUnitaryHistory.sourceFilter _ _
  apply Eventually.of_forall
  intro F
  change ‖chargeReader sourcePhaseGaugeLie (physicalN3OutputPoleUnit p F leg (poles F)) -
    actualElectronSign leg • physicalN3OutputPoleUnit p F leg (poles F)‖ ≤ _
  calc
    _ ≤ ‖chargeReader sourcePhaseGaugeLie
          (physicalN3OutputPoleUnit p F leg (poles F))‖ +
        ‖actualElectronSign leg • physicalN3OutputPoleUnit p F leg (poles F)‖ :=
      norm_sub_le _ _
    _ ≤ ‖chargeReader sourcePhaseGaugeLie‖ *
          ‖physicalN3OutputPoleUnit p F leg (poles F)‖ +
        ‖actualElectronSign leg‖ * ‖physicalN3OutputPoleUnit p F leg (poles F)‖ :=
      add_le_add ((chargeReader sourcePhaseGaugeLie).le_opNorm _)
        (norm_smul _ _).le
    _ = _ := by
      rw [physical_n3_output_pole_unit_norm, actual_electron_sign_norm,
        mul_one, one_mul]

/-- The charge correction value map `x ↦ Q x - s•x` is Lipschitz with constant
`‖Q‖+‖s‖`, generically over the carrier. -/
private theorem pole_charge_lipschitz {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℂ E] (Q : E →L[ℂ] E) (s : ℂ) (x y : E) :
    ‖(Q x - s • x) - (Q y - s • y)‖ ≤ (‖Q‖ + ‖s‖) * ‖x - y‖ := by
  have hre : (Q x - s • x) - (Q y - s • y) = Q (x - y) - s • (x - y) := by
    rw [map_sub, smul_sub]
    abel
  rw [hre]
  calc _ ≤ ‖Q (x - y)‖ + ‖s • (x - y)‖ := norm_sub_le _ _
    _ ≤ ‖Q‖ * ‖x - y‖ + ‖s‖ * ‖x - y‖ :=
        add_le_add (Q.le_opNorm _) (norm_smul _ _).le
    _ = _ := by ring

/-- The approach correction converges to the pole correction with rate
`(‖Q‖+1)·budget m`. -/
theorem physical_n3_pole_correction_error (p : PhysicalMomentum) (leg : CompositeLeg)
    (poles : N3SourceEnergyPoleSection p leg) (m : ℕ) :
    ‖physicalN3PoleApproachCorrection p leg poles m - physicalN3PoleCorrection p leg poles‖
      ≤ (‖chargeReader sourcePhaseGaugeLie‖ + 1) * actualSoftBudget m := by
  rw [physicalN3PoleApproachCorrection, physicalN3PoleCorrection,
    ← UniformSpace.Completion.coe_sub, UniformSpace.Completion.norm_coe]
  apply SourceFamilyHilbert.norm_le_of_eventually GaussUnitaryHistory.sourceFilter _ _
  apply Eventually.of_forall
  intro F
  change ‖(chargeReader sourcePhaseGaugeLie
        (physicalN3PoleApproachUnit p F leg (poles F) m) -
      actualElectronSign leg • physicalN3PoleApproachUnit p F leg (poles F) m) -
    (chargeReader sourcePhaseGaugeLie (physicalN3OutputPoleUnit p F leg (poles F)) -
      actualElectronSign leg • physicalN3OutputPoleUnit p F leg (poles F))‖ ≤ _
  calc _ ≤ (‖chargeReader sourcePhaseGaugeLie‖ + ‖actualElectronSign leg‖) *
        ‖physicalN3PoleApproachUnit p F leg (poles F) m -
          physicalN3OutputPoleUnit p F leg (poles F)‖ :=
        pole_charge_lipschitz _ _ _ _
    _ = (‖chargeReader sourcePhaseGaugeLie‖ + 1) *
        ‖physicalN3PoleApproachUnit p F leg (poles F) m -
          physicalN3OutputPoleUnit p F leg (poles F)‖ := by
        rw [actual_electron_sign_norm]
    _ ≤ _ :=
        mul_le_mul_of_nonneg_left (physical_n3_pole_approach_error p F leg (poles F) m)
          (add_nonneg (norm_nonneg _) zero_le_one)

theorem physical_n3_pole_correction_return (p : PhysicalMomentum) (leg : CompositeLeg)
    (poles : N3SourceEnergyPoleSection p leg) :
    Tendsto (fun m => physicalN3PoleApproachCorrection p leg poles m) atTop
      (𝓝 (physicalN3PoleCorrection p leg poles)) := by
  apply Metric.tendsto_nhds.mpr
  intro epsilon positive
  have hC : Tendsto (fun m =>
      (‖chargeReader sourcePhaseGaugeLie‖ + 1) * actualSoftBudget m) atTop (𝓝 0) := by
    have := actual_soft_budget_tendsto.const_mul (‖chargeReader sourcePhaseGaugeLie‖ + 1)
    simpa using this
  exact (hC.eventually (eventually_lt_nhds positive)).mono (fun m small => by
    rw [dist_eq_norm]
    exact (physical_n3_pole_correction_error p leg poles m).trans_lt small)

/-- Independent left/right pole sections pair through the original charge reader:
the left overlap and the right correction are both retained. The diagonal output is
the sign plus the correction pairing; it is not claimed to equal the input sign. -/
theorem physical_n3_pole_paired_charge (pL pR : PhysicalMomentum)
    (left right : CompositeLeg)
    (polesL : N3SourceEnergyPoleSection pL left)
    (polesR : N3SourceEnergyPoleSection pR right) :
    inner ℂ (physicalN3PoleState pL left polesL)
      (GaussUnitaryHistory.reader (chargeReader sourcePhaseGaugeLie)
        (physicalN3PoleState pR right polesR)) =
      actualElectronSign right *
        inner ℂ (physicalN3PoleState pL left polesL)
          (physicalN3PoleState pR right polesR) +
      inner ℂ (physicalN3PoleState pL left polesL)
        (physicalN3PoleCorrection pR right polesR) := by
  rw [physical_n3_pole_charge_equation, inner_add_right, inner_smul_right]

theorem physical_n3_pole_diagonal_charge (p : PhysicalMomentum) (leg : CompositeLeg)
    (poles : N3SourceEnergyPoleSection p leg) :
    inner ℂ (physicalN3PoleState p leg poles)
      (GaussUnitaryHistory.reader (chargeReader sourcePhaseGaugeLie)
        (physicalN3PoleState p leg poles)) =
      actualElectronSign leg +
        inner ℂ (physicalN3PoleState p leg poles)
          (physicalN3PoleCorrection p leg poles) := by
  rw [physical_n3_pole_paired_charge, inner_self_eq_norm_sq_to_K,
    physical_n3_pole_state_norm]
  norm_num

end LowEnergy.GaussComposite.PhysicalN3SourceEnergy
