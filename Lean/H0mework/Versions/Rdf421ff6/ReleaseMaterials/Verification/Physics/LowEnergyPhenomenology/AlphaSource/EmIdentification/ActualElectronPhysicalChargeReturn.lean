import H0mework.Versions.Rdf421ff6.ReleaseMaterials.Verification.Physics.LowEnergyPhenomenology.AlphaSource.EmIdentification.ActualElectronPhysicalJointSplice

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
namespace LowEnergy.GaussComposite.ActualElectronPhysicalJointInverse
open GaussCoreHilbert CanonicalGradedSpatialSource ActualCompositeFieldCurrent
open CanonicalGradedCharge PreparationPhysicalPhaseGaugeRealization
open PreparationVacuumJointFieldResponse ActualSourceMixed289ResponseOwn
open scoped InnerProductSpace
attribute [local irreducible] jointResolvent jointGenerator actualElectronPhysicalSeed chargeReader

/-- The mixing is generated by the actual p-dependent physical generator and the full charge reader. -/
def actualElectronPhysicalChargeMixing (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) (z : ℂ)
    (leg : CompositeLeg) : H :=
  (jointGenerator p F z 0*chargeReader sourcePhaseGaugeLie-
    chargeReader sourcePhaseGaugeLie*jointGenerator p F z 0) (actualElectronPhysicalResponse p F z leg)

theorem actual_electron_physical_response_charge (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (z : ℂ) (nonreal : z.im≠0) (leg : CompositeLeg) :
    chargeReader sourcePhaseGaugeLie (actualElectronPhysicalResponse p F z leg)=
      (if leg.dual then (-1:ℂ) else 1) • actualElectronPhysicalResponse p F z leg+
      jointResolvent p F z 0 (actualElectronPhysicalChargeMixing p F z leg) := by
  have inverse := congrArg (fun A : H→L[ℂ]H=>A
    (chargeReader sourcePhaseGaugeLie (actualElectronPhysicalResponse p F z leg)))
      (actual_electron_joint_inverse_left p F z nonreal)
  change jointResolvent p F z 0 (jointGenerator p F z 0
    (chargeReader sourcePhaseGaugeLie (actualElectronPhysicalResponse p F z leg)))=
      chargeReader sourcePhaseGaugeLie (actualElectronPhysicalResponse p F z leg) at inverse
  calc
    _=jointResolvent p F z 0 (jointGenerator p F z 0
      (chargeReader sourcePhaseGaugeLie (actualElectronPhysicalResponse p F z leg))) := inverse.symm
    _=jointResolvent p F z 0
      (chargeReader sourcePhaseGaugeLie (jointGenerator p F z 0 (actualElectronPhysicalResponse p F z leg))+
        actualElectronPhysicalChargeMixing p F z leg) := by
      congr 1
      simp only [actualElectronPhysicalChargeMixing,sub_apply,mul_apply_eq_comp]
      abel
    _=_ := by
      rw [actual_electron_physical_response_equation p F z nonreal leg,
        actual_electron_physical_seed_charge,map_add,map_smul]
      rfl

def actualElectronPhysicalChargeCorrection (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) (z : ℂ)
    (leg : CompositeLeg) : H :=
  (‖actualElectronPhysicalResponse p F z leg‖:ℂ)⁻¹ •
    jointResolvent p F z 0 (actualElectronPhysicalChargeMixing p F z leg)

theorem actual_electron_physical_unit_charge (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (z : ℂ) (nonreal : z.im≠0) (leg : CompositeLeg) :
    chargeReader sourcePhaseGaugeLie (actualElectronPhysicalUnit p F z leg)=
      (if leg.dual then (-1:ℂ) else 1) • actualElectronPhysicalUnit p F z leg+
        actualElectronPhysicalChargeCorrection p F z leg := by
  rw [actualElectronPhysicalUnit,map_smul,actual_electron_physical_response_charge p F z nonreal leg,smul_add,smul_comm]
  rfl

def actualElectronPhysicalChargeRead (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) (z : ℂ)
    (leg : CompositeLeg) : ℂ :=
  inner ℂ (actualElectronPhysicalUnit p F z leg)
    (chargeReader sourcePhaseGaugeLie (actualElectronPhysicalUnit p F z leg))

theorem actual_electron_physical_charge_read (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (z : ℂ) (nonreal : z.im≠0) (leg : CompositeLeg) :
    actualElectronPhysicalChargeRead p F z leg=(if leg.dual then (-1:ℂ) else 1)+
      inner ℂ (actualElectronPhysicalUnit p F z leg) (actualElectronPhysicalChargeCorrection p F z leg) := by
  rw [actualElectronPhysicalChargeRead,actual_electron_physical_unit_charge p F z nonreal leg,
    inner_add_right,inner_smul_right,inner_self_eq_norm_sq_to_K,
    actual_electron_physical_unit_norm p F z nonreal leg]
  norm_num

theorem actual_electron_physical_charge_price (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (z : ℂ) (nonreal : z.im≠0) (leg : CompositeLeg) :
    ‖actualElectronPhysicalChargeRead p F z leg-(if leg.dual then (-1:ℂ) else 1)‖≤
      ‖actualElectronPhysicalResponse p F z leg‖⁻¹*originalJointResolventPrice p F z*
        ‖actualElectronPhysicalChargeMixing p F z leg‖ := by
  rw [actual_electron_physical_charge_read p F z nonreal leg,add_sub_cancel_left]
  calc
    _≤‖actualElectronPhysicalUnit p F z leg‖*‖actualElectronPhysicalChargeCorrection p F z leg‖ := norm_inner_le_norm _ _
    _=‖actualElectronPhysicalChargeCorrection p F z leg‖ := by rw [actual_electron_physical_unit_norm p F z nonreal leg,one_mul]
    _=‖actualElectronPhysicalResponse p F z leg‖⁻¹*
      ‖jointResolvent p F z 0 (actualElectronPhysicalChargeMixing p F z leg)‖ := by
      rw [actualElectronPhysicalChargeCorrection,norm_smul,norm_inv,Complex.norm_real,
        Real.norm_eq_abs,abs_of_nonneg (norm_nonneg _)]
    _≤‖actualElectronPhysicalResponse p F z leg‖⁻¹*
      (‖jointResolvent p F z 0‖*‖actualElectronPhysicalChargeMixing p F z leg‖) :=
      mul_le_mul_of_nonneg_left ((jointResolvent p F z 0).le_opNorm _) (inv_nonneg.mpr (norm_nonneg _))
    _≤_ := by
      rw [←mul_assoc]
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (originalJointResolvent_price p F z nonreal)
          (inv_nonneg.mpr (norm_nonneg _))) (norm_nonneg _)

/-- The source-generated physical inverse is used at each independent physical momentum and nonreal energy. -/
def actualElectronPhysicalChargeVertex (p k : PhysicalMomentum) (F : GaussUnitaryHistory.Index) (z w : ℂ) : H→L[ℂ]H :=
  jointResolvent (p+k) F z 0*chargeReader sourcePhaseGaugeLie*jointResolvent p F w 0

theorem actual_electron_physical_charge_amputation (p k : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (z w : ℂ) (leftNonreal : z.im≠0) (rightNonreal : w.im≠0) :
    jointGenerator (p+k) F z 0*actualElectronPhysicalChargeVertex p k F z w*jointGenerator p F w 0=
      chargeReader sourcePhaseGaugeLie := by
  unfold actualElectronPhysicalChargeVertex
  calc
    _=(jointGenerator (p+k) F z 0*jointResolvent (p+k) F z 0)*chargeReader sourcePhaseGaugeLie*
      (jointResolvent p F w 0*jointGenerator p F w 0) := by simp only [mul_assoc]
    _=(1:H→L[ℂ]H)*chargeReader sourcePhaseGaugeLie*(1:H→L[ℂ]H) :=
      congrArg₂ (fun A B : H→L[ℂ]H=>A*chargeReader sourcePhaseGaugeLie*B)
        (actual_electron_joint_inverse_right (p+k) F z leftNonreal)
        (actual_electron_joint_inverse_left p F w rightNonreal)
    _=_ := by simp only [one_mul,mul_one]

end LowEnergy.GaussComposite.ActualElectronPhysicalJointInverse
