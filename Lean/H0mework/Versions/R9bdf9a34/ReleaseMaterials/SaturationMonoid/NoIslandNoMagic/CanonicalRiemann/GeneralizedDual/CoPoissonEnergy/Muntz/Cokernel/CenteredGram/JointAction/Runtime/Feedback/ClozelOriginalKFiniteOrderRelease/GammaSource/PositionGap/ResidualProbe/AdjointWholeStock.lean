private theorem adjoint_split (value : BurnolL2) :
    J value = value + δ • F (R (fourierL2.symm value)) := by
  rw [sourceCayley_actual_adjoint,sourceAdjointCayley,adjoint_source]

private theorem adjoint_dilation (h : ℝ) (value : BurnolL2) :
    J (burnolMultiplicativeDilation h value) = burnolMultiplicativeDilation h (J value) := by
  have inverse : fourierL2.symm (burnolMultiplicativeDilation h value) =
      burnolMultiplicativeDilation (-h) (fourierL2.symm value) := by
    apply fourierL2.injective
    rw [LinearIsometryEquiv.apply_symm_apply,fourierL2_burnolMultiplicativeDilation,
      neg_neg,LinearIsometryEquiv.apply_symm_apply]
  have covariant : R (burnolMultiplicativeDilation (-h) (fourierL2.symm value)) =
      burnolMultiplicativeDilation (-h) (R (fourierL2.symm value)) :=
    burnolDirectRightResolvent_dilation ((d).value/2) (-h) (fourierL2.symm value)
  rw [adjoint_split,adjoint_split,inverse,covariant,fourierL2_burnolMultiplicativeDilation,
    neg_neg,map_add,map_smul]

private theorem original_unit_gap {value : BurnolL2} (gap : value ∈ locallyConstantFace 1)
    (even : reflectL2 value = value) (head : M d value = 0) :
    J value ∈ locallyConstantFace 1 := by
  let h := Real.log 4
  let shrunk := burnolMultiplicativeDilation h value
  have radius : (1:ℝ) * Real.exp (-h) = burnolUnscaledCommonGapRadius := by
    dsimp only [h,burnolUnscaledCommonGapRadius]
    rw [Real.exp_neg,Real.exp_log (by norm_num : (0:ℝ)<4)]
    norm_num
  have inside := burnolMultiplicativeDilation_mem_locallyConstantFace_scaled h gap
  rw [radius] at inside
  obtain ⟨mean,read⟩ := mem_locallyConstantFace_iff_exists.mp inside
  have quarterRead : burnolQuarterRestriction shrunk = mean • intervalConstant burnolUnscaledCommonGapRadius :=
    read.symm
  have nonpositive : -h ≤ 0 := neg_nonpos.mpr (Real.log_nonneg (by norm_num))
  have same : burnolMultiplicativeDilation (-h) shrunk = value := by
    rw [show shrunk = burnolMultiplicativeDilation h value from rfl,
      burnolMultiplicativeDilation_neg_eq_symm,LinearIsometryEquiv.symm_apply_apply]
  have price := evaluator_dilation d shrunk mean quarterRead (-h) nonpositive
  rw [same,head] at price
  have scalar : (Real.exp ((-h)/2) : ℂ) * (Real.exp (-h) : ℂ)^(-(1-(d).value)) ≠ 0 :=
    mul_ne_zero (Complex.ofReal_ne_zero.mpr (Real.exp_ne_zero _))
      (Complex.cpow_ne_zero_iff.mpr (Or.inl (Complex.ofReal_ne_zero.mpr (Real.exp_ne_zero _))))
  have zero := (mul_eq_zero.mp price.symm).resolve_left scalar
  have parity : reflectL2 shrunk = shrunk := by
    change reflectL2 (burnolMultiplicativeDilation h value) = _
    rw [reflectL2_burnolMultiplicativeDilation,even]
  have back := (actual_gap_cayley_adjoint_iff c shrunk inside parity).2 zero
  apply (burnolMultiplicativeDilation_mem_locallyConstantFace_scaled_iff (radius := 1) h).1
  rw [radius,← adjoint_dilation]
  exact back

private theorem gamma_acted {value gamma : BurnolL2} (source : GammaPair value gamma) :
    GammaPair (J value) (J gamma) := by
  have after := adjoint_graph c source
  rw [sourceCayley_actual_adjoint,sourceCayley_actual_adjoint,sourceAdjointCayley,sourceAdjointCayley]
  intro test
  rw [inner_add_right,inner_smul_right,inner_add_right,inner_smul_right,source test,after test]

private def inverseAfter (x : Base) : BurnolL2 :=
  LogStock.inverseLog x + δ • (R (LogStock.inverseLog x) -
    directLogMoment ((d).value/2) (fourierL2.symm (v x)))

private theorem inverse_log_written (x : Base) : LogPair (fourierL2.symm (J (v x))) (inverseAfter c x) := by
  have old := (LogStock.log_pairs x).2
  have next := actual_direct_R_log ((d).value/2) (right_quarter d) _ _ old
  rw [adjoint_split,map_add,map_smul,LinearIsometryEquiv.symm_apply_apply]
  exact log_pair_add _ _ _ _ old (logPair_smul δ _ _ next)

private theorem position_log_written (x : Base) : LogPair (J (v x)) (J (g x) - F (inverseAfter c x)) :=
  position_from_frequency _ _ _ (gamma_acted c (gamma_graph x)) (inverse_log_written c x)

private def writeBase (x : Base) (inside : J (v x) ∈ PositionField) : Base :=
  LogStock.ofLogs ⟨J (v x),inside⟩ (J (g x)-F (inverseAfter c x)) (inverseAfter c x)
    (position_log_written c x) (inverse_log_written c x)

private theorem written_gamma (x : Base) (inside : J (v x) ∈ PositionField) :
    g (writeBase c x inside) = J (g x) :=
  sub_add_cancel _ _

private def outsideFirstAfter (x : Whole) : BurnolL2 :=
  firstOutside (base x) + δ • F (H.write d (fourierL2.symm (v (base x)),fourierL2.symm (firstOutside (base x))))

private def outsideSecondAfter (x : Whole) : BurnolL2 :=
  outsideSecond x + δ • F (writeSecond d (fourierL2.symm (v (base x)),fourierL2.symm (outsideSecond x)))

private theorem outside_inverse (value : BurnolL2) :
    fourierL2.symm (O value) = O (fourierL2.symm value) := by
  apply fourierL2.injective
  rw [LinearIsometryEquiv.apply_symm_apply,Fourier_outside,LinearIsometryEquiv.apply_symm_apply]

private theorem outside_first_written (zero : riemannZeta (d).value = 0) (x : Whole) :
    GammaPair (O (J (v (base x)))) (outsideFirstAfter c x) := by
  have old := first_outside_graph (base x)
  have dual := gamma_pair_inverse_fourier _ _ old
  rw [outside_inverse] at dual
  have written := gamma_pair_fourier _ _ (H.write_graph d zero _ _ dual)
  rw [adjoint_split,map_add O,map_smul O,← Fourier_outside]
  intro test
  simp only [outsideFirstAfter,inner_add_right,inner_smul_right,old test,written test]

private theorem outside_second_written (x : Whole) :
    GammaPair (outsideFirstAfter c x) (outsideSecondAfter c x) := by
  have old := (second_pairs x).2
  have written := gamma_pair_fourier _ _ (write_second_graph d (fourierL2.symm (v (base x))) _ _
    (gamma_pair_inverse_fourier _ _ old))
  intro test
  simp only [outsideFirstAfter,outsideSecondAfter,inner_add_right,inner_smul_right,old test,written test]

private def writeStock (zero : riemannZeta (d).value = 0) (x : Whole)
    (inside : J (v (base x)) ∈ PositionField) : Whole := by
  let after := writeBase c (base x) inside
  have outside : firstOutside after = outsideFirstAfter c x :=
    conductor_unique _ _ _ (first_outside_graph after) (outside_first_written c zero x)
  have outsideGraph := outside_second_written c x
  rw [← outside] at outsideGraph
  have full := gamma_acted c (full_second_graph x)
  rw [← written_gamma c (base x) inside] at full
  refine ofFields after (J (physicalSecond x+outsideSecond x)-outsideSecondAfter c x)
    (outsideSecondAfter c x) ?_ outsideGraph
  have physical : firstPhysical after = g after-firstOutside after := (sub_sub_cancel _ _).symm
  intro test
  rw [physical,inner_sub_right,inner_sub_right,full test,outsideGraph test]

variable (observation : GeneratedRiemannZeroObservation)
variable (nontrivial : ¬ ∃ j : Nat, observation.coordinate = -2*(j+1))
variable (half : OriginalKCombCalculation.Half observation) (depth : Nat)

local notation "coord" => burnolDivisionZeroCompletedMellinCoordinate observation half.down
local notation "J₀" => ContinuousLinearMap.adjoint (sourceCayley coord)
local notation "raw" => OriginalKCombFirstFullSourceDynamics.raw observation nontrivial half depth
local notation "stock" => actualWide observation nontrivial half depth
local notation "graph" => DivisionPriceStream.graph observation nontrivial half depth
local notation "capture" => DivisionPriceStream.capture observation nontrivial half depth

private def oldStock (ordinal : Nat) : Whole := toWhole (graph (capture (stock ordinal)))

private theorem old_field (ordinal : Nat) :
    v (base (oldStock observation nontrivial half depth ordinal)) = raw ordinal := by
  unfold oldStock
  rw [DivisionPriceStream.graph_capture]
  rfl

private theorem literal_position (ordinal : Nat) :
    J₀ (raw ordinal) ∈ PositionField ∧ J₀ (raw ordinal) ∈ locallyConstantFace 1 := by
  have initial : raw ordinal ∈ PositionField := by
    rw [← old_field observation nontrivial half depth ordinal]
    exact LogStock.field_mem _
  have even := mem_evenL2ClosedFace_iff.mp initial.2
  have exit := FirstPaReturn.first_exit observation nontrivial half
  have order := lt_of_lt_of_le exit.1 exit.2.1
  have head := (DivisionXiEscape.actual_division_exact_adjoint_escape observation nontrivial half depth ordinal).1 0 order
  rw [pow_zero,one_apply_eq_self] at head
  have wider := WidePositionGap.actual_division_unit_position_gap observation nontrivial half depth ordinal
  exact ⟨⟨(actual_gap_cayley_adjoint_iff coord _ initial.1 even).2 head,
    mem_evenL2ClosedFace_iff.mpr (adjoint_even coord _ even)⟩,
    original_unit_gap coord wider even head⟩

/-- The same literal stock generates both logs and both second conductors in the existing unit-gap graph. -/
def generated (ordinal : Nat) : Wide := by
  let old := oldStock observation nontrivial half depth ordinal
  have paid := literal_position observation nontrivial half depth ordinal
  have belongs : J₀ (v (base old)) ∈ PositionField := by
    rw [show v (base old) = raw ordinal from old_field observation nontrivial half depth ordinal]
    exact paid.1
  let written := writeStock coord observation.conjugate_mathlibZero old belongs
  refine ⟨(written : Ambient),written.property,?_⟩
  change J₀ (v (base old)) ∈ locallyConstantFace 1
  rw [show v (base old) = raw ordinal from old_field observation nontrivial half depth ordinal]
  exact paid.2

local notation "branch" => generated observation nontrivial half depth

theorem generated_field (ordinal : Nat) : v (base (toWhole (branch ordinal))) = J₀ (raw ordinal) :=
  congrArg (fun value : BurnolL2 => J₀ value) (old_field observation nontrivial half depth ordinal)

theorem generated_next (ordinal : Nat) :
    advanceWide coord observation.mathlibZero (branch ordinal) = branch (ordinal+1) := by
  have same : A coord observation.mathlibZero (toWhole (branch ordinal)) =
      toWhole (branch (ordinal+1)) := by
    apply base_injective
    apply LogStock.field_injective
    change v (LogStock.advance coord (base (toWhole (branch ordinal)))) =
      v (base (toWhole (branch (ordinal+1))))
    rw [LogStock.advance_field,generated_field,generated_field,← adjoint_R,
      OriginalKCombFirstFullSourceDynamics.raw_successor,OriginalKCombCofinalRAction.original_R_direct]
    rfl
  exact Subtype.ext (congrArg (fun x : Whole => (x : Ambient)) same)

/-- The actual Cayley write of two consecutive adjoint graphs restores every field of the original frame. -/
theorem generated_roundtrip (ordinal : Nat) :
    branch ordinal + (sourceDamping coord : ℂ) • branch (ordinal+1) = stock ordinal := by
  have same : toWhole (branch ordinal + (sourceDamping coord : ℂ) • branch (ordinal+1)) =
      toWhole (stock ordinal) := by
    apply base_injective
    apply LogStock.field_injective
    rw [map_add toWhole,map_smul toWhole,map_add base,map_smul base,map_add v,map_smul v,
      generated_field,generated_field]
    have next : J₀ (raw (ordinal+1)) =
        (burnolDirectRightResolventCLM coord) (J₀ (raw ordinal)) := by
      rw [OriginalKCombFirstFullSourceDynamics.raw_successor,OriginalKCombCofinalRAction.original_R_direct]
      exact adjoint_R coord (raw ordinal)
    rw [next]
    exact source_right_inverse coord (raw ordinal)
  exact Subtype.ext (congrArg (fun w : Whole => (w : Ambient)) same)

/-- The complete adjoint inventory pays the original B inverse and exterior source. -/
theorem generated_B (ordinal : Nat) :
    let x := base (toWhole (branch ordinal))
    O (v x) = OriginalKFiniteOrderRelease.OutsideQuarterAction.outsideEmbedding
      (burnolMeanZeroBlockInverse (centeredFourier coord (LogStock.coordinates coord x))) := by
  let x := base (toWhole (branch ordinal))
  let position : PositionField := ⟨v x,LogStock.field_mem x⟩
  have paid := actual_original_B_outside coord ((basis coord).repr position)
  rw [LinearIsometryEquiv.symm_apply_apply] at paid
  exact paid

/-- The original full K stream consumes the new complete branch and writes its native next with all relations. -/
theorem generated_price_write (ordinal : Nat) :
    let current := capture (branch ordinal)
    let next := graph (DivisionPriceStream.advance observation nontrivial half depth current)
    (next,DenseDivisionPrice.relationStock observation half next) =
      (branch (ordinal+1),advanceStock coord
        (DenseDivisionPrice.relationStock observation half (branch ordinal))) := by
  have paid := DivisionPriceStream.exact_write observation nontrivial half depth (capture (branch ordinal))
  rw [DivisionPriceStream.graph_capture,generated_next] at paid
  exact paid

/-- The original receipt and independently reconstructed next graph supply the same complete branch. -/
theorem receipt_generated (ordinal : Nat) :
    let data := capture (stock ordinal)
    J₀ (PacketFit.packetWhole (PriceLiteralOccurrence.readPacket observation nontrivial half depth data)) =
      v (base (toWhole (branch (ordinal+1)))) := by
  let data := capture (stock ordinal)
  let nextOf := DivisionPriceStream.advance observation nontrivial half depth
  have paid : adjointWord observation nontrivial half
        (PacketFit.packetWhole (PriceLiteralOccurrence.readPacket observation nontrivial half depth data)) =
      adjointWord observation nontrivial half (v (base (toWhole (graph (nextOf data))))) :=
    AdjointCofinalReturn.receipt_face observation nontrivial half depth ordinal
  have one := TwoReceiptReturn.exit_one observation nontrivial half
  have action : adjointWord observation nontrivial half = J₀ := by
    unfold adjointWord
    rw [one,Nat.sub_self,pow_zero]
    rfl
  have next : graph (nextOf data) = stock (ordinal+1) :=
    (DivisionPriceStream.actual_current_and_next observation nontrivial half depth ordinal).2.1
  rw [action,next] at paid
  rw [generated_field]
  exact paid

