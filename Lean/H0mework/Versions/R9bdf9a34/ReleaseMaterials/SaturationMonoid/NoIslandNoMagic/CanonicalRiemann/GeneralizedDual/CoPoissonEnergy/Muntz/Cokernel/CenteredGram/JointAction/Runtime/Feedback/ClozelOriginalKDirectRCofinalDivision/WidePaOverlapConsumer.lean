theorem paid_overlap_bound (n m : Nat) :
    ‖(out ordinal n m).1‖ ≤ Geom.inverseBudget d (HilbertInventory.SecondConductorStock.linearBudget c) *
      (miss (ordinal+1) n + ‖A‖ * miss ordinal n) := by
  let x := prefix ordinal n
  let y := prefix (ordinal+1) n
  let exactAt := fun j => PriceStream.graph observation nontrivial half depth
    (difference observation nontrivial half depth j)
  let f := Geom.finite A d m
  have written : (out ordinal n m).1 = f (y-A x) :=
    (congrArg (fun value : Wide × BurnolPaAmbientCarrier × BurnolPaAmbientCarrier => value.1)
      (paid_overlap_source observation nontrivial half depth ordinal n m)).trans
      (overlap_is_observation_defect observation nontrivial half depth ordinal n m)
  have current : ‖exactAt ordinal-x‖ = miss ordinal n :=
    (observed_error_eq observation nontrivial half depth ordinal n).symm
  have next : ‖y-exactAt (ordinal+1)‖ = miss (ordinal+1) n :=
    (norm_sub_rev _ _).trans (observed_error_eq observation nontrivial half depth (ordinal+1) n).symm
  have misses := @observation_overlap_bound Wide (inferInstanceAs (NormedAddCommGroup Wide))
    DivisionEffectPrice.wideNormed A x y (exactAt ordinal) (exactAt (ordinal+1))
    (actual_increment_next observation nontrivial half depth ordinal)
  have balance : ‖y-A x‖ ≤ miss (ordinal+1) n + ‖A‖ * miss ordinal n :=
    misses.trans_eq (congrArg₂ (fun a b : ℝ => a + ‖A‖ * b) next current)
  let gain := Geom.inverseBudget d (HilbertInventory.SecondConductorStock.linearBudget c)
  have budget : ‖f‖ ≤ gain :=
    @finite_norm_of_growth Wide (inferInstanceAs (NormedAddCommGroup Wide)) DivisionEffectPrice.wideNormed
      A d (HilbertInventory.SecondConductorStock.linearBudget c) (sourceDamping_pos c)
      (HilbertInventory.SecondConductorStock.linearBudget_nonnegative c) (growth observation half) m
  have bounded := @bounded_apply Wide (inferInstanceAs (NormedAddCommGroup Wide))
    DivisionEffectPrice.wideNormed f (y-A x) gain _ budget balance
  exact (congrArg (fun value : Wide => ‖value‖) written).trans_le bounded

private theorem literal_direct :
    (directReturnMap c).comp readField (stock ordinal) =
      pa (ordinal+1) - Pa.E (Resolvent (pa ordinal : BurnolL2)) := by
  let raw := OriginalKCombFirstFullSourceDynamics.raw observation nontrivial half depth
  have literal : raw (ordinal+1) = Resolvent (raw ordinal) :=
    (OriginalKCombFirstFullSourceDynamics.raw_successor observation nontrivial half depth ordinal).trans
      (OriginalKCombCofinalRAction.original_R_direct observation nontrivial half _)
  have direct := direct_return_eq observation half (raw ordinal)
  rw [← literal] at direct
  exact direct

theorem paid_direct_tendsto :
    Tendsto (fun n => (out ordinal n n).2.2) atTop
      (𝓝 (pa (ordinal+1) - Pa.E (Resolvent (pa ordinal : BurnolL2)))) := by
  let measure := (directReturnMap c).comp readField
  have recovered := (measure.continuous.tendsto (stock ordinal)).comp
    (actual_graph_tendsto observation nontrivial half depth ordinal)
  rw [literal_direct observation nontrivial half depth ordinal] at recovered
  exact recovered.congr' (Eventually.of_forall
    fun n => (paid_direct_return observation nontrivial half depth ordinal n n).symm)

attribute [local irreducible] output actualWide in
/-- The original clock's fixed K address sees the corrected direct return arbitrarily far along the source. -/
theorem actual_paid_native_return_visible :
    ∃ i : Nat, ∀ start : Nat, ∃ j ≥ start, ∀ᶠ n : Nat in atTop,
      PhysicalPriceCountable.price (DenseDivisionPrice.height observation nontrivial half depth i)
        (out j n n).2.2 ≠ 0 := by
  let i := testIndex observation nontrivial half depth
  let K := PhysicalPriceCountable.price (DenseDivisionPrice.height observation nontrivial half depth i)
  let V := (OriginalKDirectRCofinalReentrySourceAction.sourceReentryVector c : BurnolPaAmbientCarrier)
  refine ⟨i, fun start => ?_⟩
  obtain ⟨j, later, feeLive, literal, _⟩ :=
    CountedNativeReentry.literal_return_cofinal observation nontrivial half depth start
  let actual := pa (j+1) - Pa.E (Resolvent (pa j : BurnolL2))
  have native : K actual ≠ 0 := by
    have paid : K actual = ReentryDifferenceClock.fee observation nontrivial half depth j * K V := by
      rw [show actual = _ from literal, map_smul, smul_eq_mul]
    rw [paid]
    exact mul_ne_zero feeLive (test_ne observation nontrivial half depth)
  have paid := paid_direct_tendsto observation nontrivial half depth j
  have measured : Tendsto (fun n => K (out j n n).2.2) atTop (𝓝 (K actual)) :=
    (K.continuous.tendsto actual).comp paid
  exact ⟨j, later, measured.eventually_ne native⟩

