private theorem finite_action_commutes (m : Nat) (x : Wide) :
    Geom.finite A d m (A x) = A (Geom.finite A d m x) :=
  congrArg (fun op : Wide →L[ℂ] Wide => op x) (finite_commutes A d m).eq.symm

attribute [local irreducible] paid in
/-- The missed overlap is generated by observation and action; the common Cayley tail cancels exactly. -/
theorem overlap_is_observation_defect (n m : Nat) :
    delta n m = Geom.finite A d m (prefix (ordinal+1) n - A (prefix ordinal n)) := by
  let f := Geom.finite A d m
  let x := prefix ordinal n
  let y := prefix (ordinal+1) n
  have current : (paid observation nontrivial half depth (ordinal+1) n m).2.1 = f y :=
    (congrArg (fun value : Wide × Wide × Wide => value.2.1)
      (paid_source observation nontrivial half depth (ordinal+1) n m)).trans
      (finite_source observation nontrivial half depth (ordinal+1) n m)
  have written : (paid observation nontrivial half depth ordinal n m).2.2 = A (f x) :=
    (congrArg (fun value : Wide × Wide × Wide => value.2.2)
      (paid_source observation nontrivial half depth ordinal n m)).trans
      (congrArg A (finite_source observation nontrivial half depth ordinal n m))
  have same : f y - A (f x) = f (y - A x) := by
    rw [map_sub, finite_action_commutes observation half m]
  exact (congrArg₂ (· - ·) current written).trans same

private theorem actual_increment_next :
    PriceStream.graph observation nontrivial half depth
      (difference observation nontrivial half depth (ordinal+1)) =
    A (PriceStream.graph observation nontrivial half depth
      (difference observation nontrivial half depth ordinal)) := by
  have next := actual_wide_next observation nontrivial half depth ordinal
  have natural : (A-1) (A (stock ordinal)) = A ((A-1) (stock ordinal)) := by
    simp only [sub_apply, one_apply_eq_self, map_sub]
  exact (difference_graph observation nontrivial half depth (ordinal+1)).trans
    ((congrArg (A-1 : Wide →L[ℂ] Wide) next.symm).trans
      (natural.trans (congrArg A (difference_graph observation nontrivial half depth ordinal).symm)))

private theorem observation_overlap_bound {H : Type} [NormedAddCommGroup H] [NormedSpace ℂ H]
    (action : H →L[ℂ] H) (x y e eNext : H)
    (same : eNext = action e) :
    ‖y-action x‖ ≤ ‖y-eNext‖ + ‖action‖ * ‖e-x‖ := by
  have propagated : eNext-action x = action (e-x) :=
    (congrArg (fun v : H => v-action x) same).trans (map_sub action _ _).symm
  calc
    _ ≤ ‖y-eNext‖+‖eNext-action x‖ := norm_sub_le_norm_sub_add_norm_sub _ _ _
    _ ≤ _ := by
      rw [propagated]
      exact add_le_add_right (action.le_opNorm (e-x)) _

private theorem bounded_apply {H : Type} [NormedAddCommGroup H] [NormedSpace ℂ H]
    (operator : H →L[ℂ] H) (x : H) (gain error : ℝ)
    (operatorBound : ‖operator‖ ≤ gain) (errorBound : ‖x‖ ≤ error) :
    ‖operator x‖ ≤ gain * error :=
  (operator.le_opNorm x).trans ((mul_le_mul_of_nonneg_right operatorBound (norm_nonneg x)).trans
    (mul_le_mul_of_nonneg_left errorBound ((norm_nonneg operator).trans operatorBound)))

