    type_of% (Eval.original_material authority origin (read n m)) ∧
    type_of% (Eval.relation_boundary (R := ℤ) authority origin (read n m)) ∧
    type_of% (Relations.boundary_in_inventory authority origin (read n m)
      (Calculation.targetRuntime authority origin (read n m))) ∧
    type_of% (Calculation.target_factorizes authority origin (read n m)) ∧
    type_of% (actual_paid_native_return_visible observation nontrivial half depth) ∧
    type_of% (actual_final_relation_and_payment observation nontrivial half depth ordinal n m) ∧
    type_of% (actual_final_relation_and_payment observation nontrivial half depth (ordinal+1) n m) :=
  ⟨paid_overlap_source observation nontrivial half depth ordinal n m,
    paid_steps observation nontrivial half depth ordinal n m,
    paid_overlap_bound observation nontrivial half depth ordinal n m,
    paid_direct_return observation nontrivial half depth ordinal n m,
    Eval.original_material authority origin (read n m),
    Eval.relation_boundary (R := ℤ) authority origin (read n m),
    Relations.boundary_in_inventory authority origin (read n m)
      (Calculation.targetRuntime authority origin (read n m)),
    Calculation.target_factorizes authority origin (read n m),
    actual_paid_native_return_visible observation nontrivial half depth,
    actual_final_relation_and_payment observation nontrivial half depth ordinal n m,
    actual_final_relation_and_payment observation nontrivial half depth (ordinal+1) n m⟩

