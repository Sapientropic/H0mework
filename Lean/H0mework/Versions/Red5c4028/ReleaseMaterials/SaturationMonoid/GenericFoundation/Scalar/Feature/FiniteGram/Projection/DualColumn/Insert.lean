import H0mework.Versions.Red5c4028.ReleaseMaterials.SaturationMonoid.GenericFoundation.Scalar.Feature.FiniteGram.Projection.DualColumn
import H0mework.Versions.R7e4da746.ReleaseMaterials.SaturationMonoid.GenericFoundation.Scalar.Feature.FiniteGram.InnovationInsert
import H0mework.Versions.R7e4da746.ReleaseMaterials.SaturationMonoid.GenericFoundation.Scalar.Feature.FiniteGram.PrefixReadback

set_option autoImplicit false
set_option Elab.async false

noncomputable section
namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace SourceGeneratedFiniteGram.Projection

open Set
open scoped InnerProductSpace BigOperators

open private gram_kernel_eq_zero from H0mework.Versions.Red5c4028.ReleaseMaterials.SaturationMonoid.GenericFoundation.Scalar.Feature.FiniteGram.Projection.DualColumn
open private source_span from H0mework.Versions.R7e4da746.ReleaseMaterials.SaturationMonoid.GenericFoundation.Scalar.Feature.FiniteGram.PrefixReadback

variable {ι H : Type*} [Fintype ι] [DecidableEq ι]
  [NormedAddCommGroup H] [InnerProductSpace ℂ H]

private theorem coefficients_on_synthesis (source : ι → H) (independent : LinearIndependent ℂ source)
    (a : Coordinates ι) : coefficients source (synthesis source a) = a := by
  have read : action (gram source) a = rhs source (synthesis source a) := by
    ext i
    exact action_read source a i
  apply sub_eq_zero.mp
  apply gram_kernel_eq_zero source independent
  rw [map_sub,equation,read,sub_self]

private theorem synthesis_single (source : ι → H) (j : ι) :
    synthesis source (PiLp.single 2 j (1 : ℂ)) = source j := by
  change (∑ i, (PiLp.single 2 j (1 : ℂ) : Coordinates ι) i • source i) = _
  rw [Finset.sum_eq_single j]
  · rw [PiLp.single_apply,if_pos rfl,one_smul]
  · intro i _ other
    rw [PiLp.single_apply,if_neg other,zero_smul]
  · intro missing
    exact (missing (Finset.mem_univ j)).elim

private theorem dualColumn_source (source : ι → H) (independent : LinearIndependent ℂ source) (i j : ι) :
    inner ℂ (dualColumn source independent i) (source j) = if i = j then 1 else 0 := by
  rw [inner_dualColumn_eq_coefficients,← synthesis_single source j,
    coefficients_on_synthesis source independent,PiLp.single_apply]

private theorem dualColumn_in_span (source : ι → H) (independent : LinearIndependent ℂ source) (i : ι) :
    dualColumn source independent i ∈ sourceSpan source := by
  unfold dualColumn
  exact ⟨_,rfl⟩

omit [DecidableEq ι] in
private theorem eq_of_source_pairings (source : ι → H) {left right : H}
    (inLeft : left ∈ sourceSpan source) (inRight : right ∈ sourceSpan source)
    (agree : ∀ j, inner ℂ left (source j) = inner ℂ right (source j)) : left = right := by
  have all (value : H) (within : value ∈ sourceSpan source) : inner ℂ (left-right) value = 0 := by
    obtain ⟨a,rfl⟩ := within
    change inner ℂ (left-right) (∑ i, a i • source i) = 0
    rw [inner_sum]
    apply Finset.sum_eq_zero
    intro i _
    rw [inner_smul_right,inner_sub_left,agree i,sub_self,mul_zero]
  exact sub_eq_zero.mp (inner_self_eq_zero.mp (all _ (Submodule.sub_mem _ inLeft inRight)))

variable {n : Nat} (source : Fin n → H) (column : H)

local notation "full" => (Fin.snoc source column : Fin (n+1) → H)

private theorem old_span_le_full : sourceSpan source ≤ sourceSpan full := by
  rw [source_span,source_span]
  apply Submodule.span_mono
  rintro _ ⟨i,rfl⟩
  refine ⟨i.castSucc,?_⟩
  rw [Fin.snoc_castSucc]

private theorem column_in_full : column ∈ sourceSpan full := by
  rw [source_span]
  refine Submodule.subset_span ⟨Fin.last n,?_⟩
  rw [Fin.snoc_last]

theorem snoc_innovation_ne_zero (independent : LinearIndependent ℂ full) :
    innovationCLM source column ≠ 0 := by
  apply innovation_ne_zero_of_new_column
  rw [source_span]
  exact (linearIndependent_finSnoc.mp independent).2

theorem inserted_coefficient_norm_le (field : H) (live : innovationCLM source column ≠ 0) :
    ‖insertedCoefficient source column field‖ * ‖innovationCLM source column‖ ≤ ‖field‖ := by
  let residual := innovationCLM source column
  have positive : 0 < ‖residual‖ := norm_pos_iff.mpr live
  have square : ‖inner ℂ residual residual‖ = ‖residual‖^2 := by
    rw [inner_self_eq_norm_sq_to_K,norm_pow,RCLike.norm_ofReal,abs_norm]
  change ‖inner ℂ residual field/inner ℂ residual residual‖ * ‖residual‖ ≤ ‖field‖
  rw [norm_div,square]
  have cancel : ‖inner ℂ residual field‖/‖residual‖^2*‖residual‖ =
      ‖inner ℂ residual field‖/‖residual‖ := by
    field_simp [positive.ne']
  rw [cancel,div_le_iff₀ positive,mul_comm]
  exact norm_inner_le_norm (𝕜 := ℂ) residual field

/-- The new coordinate cotest is generated by the existing orthogonal innovation. -/
def insertedDualColumn : H :=
  let residual := innovationCLM source column
  star ((inner ℂ residual residual)⁻¹) • residual

theorem inserted_dualColumn_read (field : H) :
    inner ℂ (insertedDualColumn source column) field = insertedCoefficient source column field := by
  unfold insertedDualColumn insertedCoefficient
  rw [inner_smul_left,starRingEnd_apply,star_star,div_eq_mul_inv,mul_comm]

/-- Appending the actual independent column pays the new cotest with one old-span residual. -/
theorem dualColumn_snoc_last (independent : LinearIndependent ℂ full) :
    dualColumn full independent (Fin.last n) = insertedDualColumn source column := by
  have oldIndependent := (linearIndependent_finSnoc.mp independent).1
  have novel : column ∉ sourceSpan source := by
    rw [source_span]
    exact (linearIndependent_finSnoc.mp independent).2
  have faithful : Function.Injective (synthesis source) := by
    intro left right same
    have read := congrArg (coefficients source) same
    simpa only [coefficients_on_synthesis source oldIndependent] using read
  have newMem : insertedDualColumn source column ∈ sourceSpan full := by
    unfold insertedDualColumn
    apply Submodule.smul_mem
    rw [innovation_value]
    exact Submodule.sub_mem _ (column_in_full source column)
      (old_span_le_full source column (predictable_mem source column))
  apply eq_of_source_pairings full (dualColumn_in_span full independent _) newMem
  intro k
  refine Fin.lastCases ?_ (fun j => ?_) k
  · rw [dualColumn_source,if_pos rfl,Fin.snoc_last,inserted_dualColumn_read]
    have read := (insertion_read source column novel faithful (0 : Coordinates (Fin n)) (1 : ℂ)).1
    simpa only [map_zero,one_smul,zero_add] using read.symm
  · rw [dualColumn_source,if_neg (Fin.castSucc_ne_last j).symm,Fin.snoc_castSucc,inserted_dualColumn_read]
    have read := (insertion_read source column novel faithful (PiLp.single 2 j (1 : ℂ)) (0 : ℂ)).1
    simpa only [synthesis_single,zero_smul,add_zero] using read.symm

/-- The old cotest corrects only its evaluation on the newly appended source column. -/
theorem dualColumn_snoc_castSucc (independent : LinearIndependent ℂ full) (i : Fin n) :
    let prior := dualColumn source (linearIndependent_finSnoc.mp independent).1 i
    dualColumn full independent i.castSucc =
      prior-star (inner ℂ prior column) • insertedDualColumn source column := by
  dsimp only
  let prior := dualColumn source (linearIndependent_finSnoc.mp independent).1 i
  let fresh := dualColumn full independent (Fin.last n)
  rw [← dualColumn_snoc_last source column independent]
  change dualColumn full independent i.castSucc = prior-star (inner ℂ prior column) • fresh
  have inPrior : prior ∈ sourceSpan full :=
    old_span_le_full source column (dualColumn_in_span source _ _)
  have inFresh : fresh ∈ sourceSpan full := dualColumn_in_span full independent _
  apply eq_of_source_pairings full (dualColumn_in_span full independent _)
    (Submodule.sub_mem _ inPrior (Submodule.smul_mem _ _ inFresh))
  intro k
  rw [dualColumn_source,inner_sub_left,inner_smul_left,starRingEnd_apply,star_star]
  refine Fin.lastCases ?_ (fun j => ?_) k
  · have reads : inner ℂ fresh (full (Fin.last n)) = 1 := by
      dsimp only [fresh]
      rw [dualColumn_source,if_pos rfl]
    rw [if_neg (Fin.castSucc_ne_last i),reads,Fin.snoc_last,mul_one,sub_self]
  · have reads : inner ℂ fresh (full j.castSucc) = 0 := by
      dsimp only [fresh]
      rw [dualColumn_source,if_neg (Fin.castSucc_ne_last j).symm]
    rw [reads,mul_zero,sub_zero,Fin.snoc_castSucc]
    dsimp only [prior]
    rw [dualColumn_source]
    simp only [Fin.castSucc_inj]

/-- One new residual read and the existing old coefficient solver recover the entire appended Gram read. -/
theorem coefficients_snoc_read (independent : LinearIndependent ℂ full) (field : H) :
    let charge := insertedCoefficient source column field
    coefficients full field (Fin.last n) = charge ∧
      ∀ i : Fin n, coefficients full field i.castSucc = coefficients source (field-charge • column) i := by
  dsimp only
  constructor
  · rw [← inner_dualColumn_eq_coefficients full independent,dualColumn_snoc_last,inserted_dualColumn_read]
  · intro i
    let oldIndependent := (linearIndependent_finSnoc.mp independent).1
    rw [← inner_dualColumn_eq_coefficients full independent,
      ← inner_dualColumn_eq_coefficients source oldIndependent,dualColumn_snoc_castSucc]
    rw [inner_sub_left,inner_smul_left,starRingEnd_apply,star_star,inserted_dualColumn_read,inner_sub_right,inner_smul_right]
    ring

end SourceGeneratedFiniteGram.Projection
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
