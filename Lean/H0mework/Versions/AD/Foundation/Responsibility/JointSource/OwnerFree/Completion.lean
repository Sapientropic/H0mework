import H0mework.Versions.AD.Foundation.Responsibility.JointSource.OwnerFree.Runtime

/-! Complete values are generated by the actual source executor and its paid
past trace. Zero remaining work preserves that state; it is local settlement. -/

set_option autoImplicit false
noncomputable section
universe u
namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace RootGeneratedDebtActivationJointSource.OwnerFree.Completion
open SourceOperationEffects SourceOperationExecution DebtActivationWorld
variable {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
variable (old : SourceNativeAuthoritativeRootClosure N V) (origin : V.Current)
variable {Sorts : Type u} {Value Var : Sorts → Type u} [∀ sort, AddCommGroup (Value sort)] {sort : Sorts}
variable (reader : old.toLedgerRoot.source.source.toRootSource.actual.OccurrenceAt origin →
  Raw (Value := Value) (Var := Var) (sort := sort))

theorem next_budget (state : Current old origin reader) :
    remaining (nextState old origin reader state).1 = remaining state.1 - 1 := by
  unfold nextState targetOf
  cases selected : action old origin reader state with
  | inl settled =>
      have zero := (law old origin reader).settlement_budget_zero settled
      change remaining state.1 = 0 at zero
      simp only [zero, Nat.zero_sub]
  | inr paid =>
      rcases paid with ⟨next, advance⟩
      cases advance with
      | paid step =>
          have debit := step.remaining_eq
          dsimp only [SourceOperationExecutionDebt.advance]
          omega

def localSettlement (state : Current old origin reader) (zero : remaining state.1 = 0) :
    SourceOperationExecutionDebt.Settlement state := by
  cases shape : state.1 with
  | const value => exact ⟨value, ⟨shape⟩⟩
  | var name => simp only [shape, remaining] at zero; omega
  | add left right => simp only [shape, remaining] at zero; omega
  | linear operation value => simp only [shape, remaining] at zero; omega
  | bilinear operation left right => simp only [shape, remaining] at zero; omega

theorem next_state_of_zero (state : Current old origin reader) (zero : remaining state.1 = 0) :
    nextState old origin reader state = state := by
  unfold nextState targetOf
  cases selected : action old origin reader state with
  | inl settled => rfl
  | inr paid =>
      have strict := (law old origin reader).step_budget_lt paid.2
      change remaining paid.1.1 < remaining state.1 at strict
      rw [zero] at strict
      exact False.elim (Nat.not_lt_zero _ strict)

def runtime (count : Nat) : Runtime old origin reader :=
  (initialRuntime old origin reader).advance count

theorem runtime_depth (count : Nat) : (runtime old origin reader count).state.down = count := by
  induction count with
  | zero => rfl
  | succ count prior =>
      change (runtime old origin reader count).state.down + 1 = count + 1
      exact congrArg (fun depth => depth + 1) prior

def state (count : Nat) : Current old origin reader :=
  runtimeCurrent old origin reader (runtime old origin reader count)

theorem next_state (count : Nat) : state old origin reader (count + 1) =
    nextState old origin reader (state old origin reader count) :=
  tick_math old origin reader (runtime old origin reader count)

theorem initial_state : state old origin reader 0 = initial old origin reader := rfl

theorem budget (count : Nat) : remaining (state old origin reader count).1 =
    remaining (raw old origin reader).expression - count := by
  induction count with
  | zero => rfl
  | succ count prior =>
      rw [next_state, next_budget, prior, Nat.sub_sub]

theorem history_accounting (count : Nat) :
    (state old origin reader count).2.length + remaining (state old origin reader count).1 =
      remaining (raw old origin reader).expression :=
  (state old origin reader count).2.remaining_eq.symm

def completedRuntime := runtime old origin reader (remaining (raw old origin reader).expression)
def completedState := state old origin reader (remaining (raw old origin reader).expression)

theorem completed_budget : remaining (completedState old origin reader).1 = 0 := by
  rw [completedState, budget, Nat.sub_self]

def completed : SourceOperationExecutionDebt.Settlement (completedState old origin reader) :=
  localSettlement old origin reader (completedState old origin reader) (completed_budget old origin reader)

theorem completed_value : (completed old origin reader).1 =
    (raw old origin reader).expression.eval (raw old origin reader).environment :=
  SourceOperationExecutionDebt.completed_value _ (completed old origin reader)

theorem completed_history_length : (completedState old origin reader).2.length =
    remaining (raw old origin reader).expression := by
  have account := history_accounting old origin reader (remaining (raw old origin reader).expression)
  change (completedState old origin reader).2.length + remaining (completedState old origin reader).1 = _ at account
  simpa only [completed_budget, Nat.add_zero] using account

theorem completed_next_state : state old origin reader (remaining (raw old origin reader).expression + 1) =
    completedState old origin reader := by
  rw [next_state]
  exact next_state_of_zero old origin reader (completedState old origin reader) (completed_budget old origin reader)

end RootGeneratedDebtActivationJointSource.OwnerFree.Completion
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
