import H0mework.Versions.AD.Physics.Bell.ReadoutEffects

/-!
# Maximal identifiable Bell readout and the complete regular parameter fiber

All probabilities are generated by the original source on four legal compact local effects.
The complete law determines exactly the four biases and the two rank-one product matrices.
Legal nonzero two-scale changes generate the same law. Conversely, on the nonzero-anchor
stratum every legal effect family with that law is generated by a unique pair of scales.
The recovery and converse are inverse consumers of source-generated laws, not source producers
from an arbitrary probability table. Root, ledger and current/next activation remain unchanged.
-/

set_option autoImplicit false

namespace SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutIdentification

open ProofFreeRicherAnholonomicSource

noncomputable section

/-- Four legal local setting effects on the fixed original source. -/
@[ext] structure SettingFamily where
  alice : Bool → CompactReadoutEffect
  bob : Bool → CompactReadoutEffect

def SettingFamily.probability (family : SettingFamily) (plus a b x y : Bool) : ℝ :=
  effectProbability (family.alice a) (family.bob b) plus x y

def SettingFamily.sourceProbability (family : SettingFamily) (point : BasePoint)
    (plus a b x y : Bool) : ℝ :=
  effectSourceWeight (family.alice a) (family.bob b) plus point x y

def SettingFamily.currentProbability (family : SettingFamily) (point : BasePoint)
    (plus a b x y : Bool) : ℝ :=
  effectRuntimeProbability (family.alice a) (family.bob b) plus point x y

def SettingFamily.nextProbability (family : SettingFamily) (point : BasePoint)
    (plus a b x y : Bool) : ℝ :=
  effectNextProbability (family.alice a) (family.bob b) plus point x y

theorem SettingFamily.source_probability (family : SettingFamily) (point : BasePoint)
    (plus a b x y : Bool) :
    family.sourceProbability point plus a b x y = family.probability plus a b x y :=
  effect_source_probability (family.alice a) (family.bob b) plus point x y

theorem SettingFamily.current_probability (family : SettingFamily) (point : BasePoint)
    (plus a b x y : Bool) :
    family.currentProbability point plus a b x y = family.probability plus a b x y :=
  effect_runtime_probability (family.alice a) (family.bob b) plus point x y

theorem SettingFamily.next_probability (family : SettingFamily) (point : BasePoint)
    (plus a b x y : Bool) :
    family.nextProbability point plus a b x y = family.probability plus a b x y :=
  effect_next_probability (family.alice a) (family.bob b) plus point x y

/-- The observable signed correlation at each herald and setting pair. -/
def SettingFamily.correlation (family : SettingFamily) (plus a b : Bool) : ℝ :=
  ∑ x : Bool, ∑ y : Bool, sign x * sign y * family.probability plus a b x y

theorem SettingFamily.correlation_eq (family : SettingFamily) (plus a b : Bool) :
    family.correlation plus a b = (family.alice a).mu * (family.bob b).mu -
      sign plus * (family.alice a).u * (family.bob b).u -
        (family.alice a).z * (family.bob b).z :=
  effect_correlation (family.alice a) (family.bob b) plus

/-- Data determined by the entire source law; individual factor vectors need not be determined. -/
@[ext] structure IdentifiedCoordinates where
  aliceBias : Bool → ℝ
  bobBias : Bool → ℝ
  productX : Bool → Bool → ℝ
  productZ : Bool → Bool → ℝ

def SettingFamily.identified (family : SettingFamily) : IdentifiedCoordinates where
  aliceBias := fun a => (family.alice a).mu
  bobBias := fun b => (family.bob b).mu
  productX := fun a b => (family.alice a).u * (family.bob b).u
  productZ := fun a b => (family.alice a).z * (family.bob b).z

def SettingFamily.recoveredAliceBias (family : SettingFamily) (a : Bool) : ℝ :=
  2 * (∑ y : Bool, family.probability false a false false y) - 1

def SettingFamily.recoveredBobBias (family : SettingFamily) (b : Bool) : ℝ :=
  2 * (∑ x : Bool, family.probability false false b x false) - 1

def SettingFamily.recoveredX (family : SettingFamily) (a b : Bool) : ℝ :=
  (family.correlation true a b - family.correlation false a b) / 2

def SettingFamily.recoveredZ (family : SettingFamily) (a b : Bool) : ℝ :=
  family.recoveredAliceBias a * family.recoveredBobBias b -
    (family.correlation false a b + family.correlation true a b) / 2

theorem SettingFamily.recovered_alice_bias (family : SettingFamily) (a : Bool) :
    family.recoveredAliceBias a = (family.alice a).mu := by
  simp only [recoveredAliceBias, probability, effect_probability_left_marginal, sign]
  ring

theorem SettingFamily.recovered_bob_bias (family : SettingFamily) (b : Bool) :
    family.recoveredBobBias b = (family.bob b).mu := by
  simp only [recoveredBobBias, probability, effect_probability_right_marginal, sign]
  ring

theorem SettingFamily.recovered_x (family : SettingFamily) (a b : Bool) :
    family.recoveredX a b = (family.alice a).u * (family.bob b).u := by
  simp only [recoveredX, correlation_eq, sign]
  ring

theorem SettingFamily.recovered_z (family : SettingFamily) (a b : Bool) :
    family.recoveredZ a b = (family.alice a).z * (family.bob b).z := by
  simp only [recoveredZ, recovered_alice_bias, recovered_bob_bias, correlation_eq, sign]
  ring

def SettingFamily.recovered (family : SettingFamily) : IdentifiedCoordinates where
  aliceBias := family.recoveredAliceBias
  bobBias := family.recoveredBobBias
  productX := family.recoveredX
  productZ := family.recoveredZ

theorem SettingFamily.recovered_eq_identified (family : SettingFamily) :
    family.recovered = family.identified := by
  apply IdentifiedCoordinates.ext
  · funext a
    exact family.recovered_alice_bias a
  · funext b
    exact family.recovered_bob_bias b
  · funext a b
    exact family.recovered_x a b
  · funext a b
    exact family.recovered_z a b

theorem SettingFamily.probability_identified (family : SettingFamily) (plus a b x y : Bool) :
    family.probability plus a b x y =
      (1 + sign x * family.identified.aliceBias a + sign y * family.identified.bobBias b +
        sign x * sign y * (family.identified.aliceBias a * family.identified.bobBias b -
          sign plus * family.identified.productX a b - family.identified.productZ a b)) / 4 := by
  rw [probability, effect_probability_polynomial]
  simp only [effectJointPolynomial, identified]
  ring

/-- Equality of all source-generated herald/setting/outcome probabilities. -/
def SameLaw (first second : SettingFamily) : Prop :=
  ∀ plus a b x y, first.probability plus a b x y = second.probability plus a b x y

/-- Global maximal identification: the complete law and these coordinates determine each other. -/
theorem same_law_iff_identified (first second : SettingFamily) :
    SameLaw first second ↔ first.identified = second.identified := by
  constructor
  · intro same
    have probability_eq : first.probability = second.probability := by
      funext plus a b x y
      exact same plus a b x y
    have recovered_eq : first.recovered = second.recovered := by
      apply IdentifiedCoordinates.ext
      · funext a
        simp only [SettingFamily.recovered, SettingFamily.recoveredAliceBias, probability_eq]
      · funext b
        simp only [SettingFamily.recovered, SettingFamily.recoveredBobBias, probability_eq]
      · funext a b
        simp only [SettingFamily.recovered, SettingFamily.recoveredX,
          SettingFamily.correlation, probability_eq]
      · funext a b
        simp only [SettingFamily.recovered, SettingFamily.recoveredZ,
          SettingFamily.recoveredAliceBias, SettingFamily.recoveredBobBias,
          SettingFamily.correlation, probability_eq]
    exact first.recovered_eq_identified.symm.trans
      (recovered_eq.trans second.recovered_eq_identified)
  · intro identified_eq plus a b x y
    rw [first.probability_identified, second.probability_identified, identified_eq]

/-- Primitive source-cone conditions for a lawful two-scale change. -/
structure AdmissibleScales (family : SettingFamily) (s t : ℝ) : Prop where
  s_nonzero : s ≠ 0
  t_nonzero : t ≠ 0
  alice_plus : ∀ a, (s * (family.alice a).u) ^ 2 + (t * (family.alice a).z) ^ 2 ≤
    (1 + (family.alice a).mu) ^ 2
  alice_minus : ∀ a, (s * (family.alice a).u) ^ 2 + (t * (family.alice a).z) ^ 2 ≤
    (1 - (family.alice a).mu) ^ 2
  bob_plus : ∀ b, ((family.bob b).u / s) ^ 2 + ((family.bob b).z / t) ^ 2 ≤
    (1 + (family.bob b).mu) ^ 2
  bob_minus : ∀ b, ((family.bob b).u / s) ^ 2 + ((family.bob b).z / t) ^ 2 ≤
    (1 - (family.bob b).mu) ^ 2

/-- Construct all four legal effects from scales and their primitive cone inequalities. -/
def scaledFamily (family : SettingFamily) (s t : ℝ)
    (valid : AdmissibleScales family s t) : SettingFamily where
  alice := fun a =>
    { mu := (family.alice a).mu
      u := s * (family.alice a).u
      z := t * (family.alice a).z
      mu_lower := (family.alice a).mu_lower
      mu_upper := (family.alice a).mu_upper
      norm_plus := valid.alice_plus a
      norm_minus := valid.alice_minus a }
  bob := fun b =>
    { mu := (family.bob b).mu
      u := (family.bob b).u / s
      z := (family.bob b).z / t
      mu_lower := (family.bob b).mu_lower
      mu_upper := (family.bob b).mu_upper
      norm_plus := valid.bob_plus b
      norm_minus := valid.bob_minus b }

theorem scaled_identified (family : SettingFamily) (s t : ℝ)
    (valid : AdmissibleScales family s t) :
    (scaledFamily family s t valid).identified = family.identified := by
  apply IdentifiedCoordinates.ext
  · rfl
  · rfl
  · funext a b
    simp only [SettingFamily.identified, scaledFamily]
    field_simp [valid.s_nonzero]
  · funext a b
    simp only [SettingFamily.identified, scaledFamily]
    field_simp [valid.t_nonzero]

theorem scaled_same_law (family : SettingFamily) (s t : ℝ)
    (valid : AdmissibleScales family s t) : SameLaw (scaledFamily family s t valid) family :=
  (same_law_iff_identified _ _).mpr (scaled_identified family s t valid)

theorem scaled_source_probability (family : SettingFamily) (s t : ℝ)
    (valid : AdmissibleScales family s t) (point : BasePoint) (plus a b x y : Bool) :
    (scaledFamily family s t valid).sourceProbability point plus a b x y =
      family.sourceProbability point plus a b x y := by
  rw [SettingFamily.source_probability, SettingFamily.source_probability]
  exact scaled_same_law family s t valid plus a b x y

theorem scaled_current_probability (family : SettingFamily) (s t : ℝ)
    (valid : AdmissibleScales family s t) (point : BasePoint) (plus a b x y : Bool) :
    (scaledFamily family s t valid).currentProbability point plus a b x y =
      family.currentProbability point plus a b x y := by
  rw [SettingFamily.current_probability, SettingFamily.current_probability]
  exact scaled_same_law family s t valid plus a b x y

theorem scaled_next_probability (family : SettingFamily) (s t : ℝ)
    (valid : AdmissibleScales family s t) (point : BasePoint) (plus a b x y : Bool) :
    (scaledFamily family s t valid).nextProbability point plus a b x y =
      family.nextProbability point plus a b x y := by
  rw [SettingFamily.next_probability, SettingFamily.next_probability]
  exact scaled_same_law family s t valid plus a b x y

/-- Rank-one factorization with a nonzero anchor, uniformly over every row and column. -/
theorem rank_one_scale {I J : Type} (left : I → ℝ) (right : J → ℝ)
    (otherLeft : I → ℝ) (otherRight : J → ℝ) (i₀ : I) (j₀ : J)
    (regular : left i₀ * right j₀ ≠ 0)
    (products : ∀ i j, otherLeft i * otherRight j = left i * right j) :
    otherLeft i₀ / left i₀ ≠ 0 ∧
      (∀ i, otherLeft i = (otherLeft i₀ / left i₀) * left i) ∧
      (∀ j, otherRight j = right j / (otherLeft i₀ / left i₀)) := by
  have left_ne := (mul_ne_zero_iff.mp regular).1
  have other_regular : otherLeft i₀ * otherRight j₀ ≠ 0 := by
    rw [products i₀ j₀]
    exact regular
  have other_left_ne := (mul_ne_zero_iff.mp other_regular).1
  have other_right_ne := (mul_ne_zero_iff.mp other_regular).2
  refine ⟨div_ne_zero other_left_ne left_ne, ?_, ?_⟩
  · intro i
    have row : otherLeft i = left i * right j₀ / otherRight j₀ :=
      (eq_div_iff other_right_ne).mpr (products i j₀)
    have anchor : otherLeft i₀ = left i₀ * right j₀ / otherRight j₀ :=
      (eq_div_iff other_right_ne).mpr (products i₀ j₀)
    rw [row, anchor]
    field_simp [left_ne, other_right_ne]
  · intro j
    have column : otherRight j = left i₀ * right j / otherLeft i₀ :=
      (eq_div_iff other_left_ne).mpr (by simpa only [mul_comm] using products i₀ j)
    rw [column]
    field_simp [left_ne, other_left_ne]

def Regular (family : SettingFamily) : Prop :=
  (family.alice false).u * (family.bob false).u ≠ 0 ∧
    (family.alice false).z * (family.bob false).z ≠ 0

/-- Exact coordinates of a two-scale relation, before constructing its lawful effect family. -/
structure ScaleRelation (original other : SettingFamily) (s t : ℝ) : Prop where
  s_nonzero : s ≠ 0
  t_nonzero : t ≠ 0
  alice_mu : ∀ a, (other.alice a).mu = (original.alice a).mu
  bob_mu : ∀ b, (other.bob b).mu = (original.bob b).mu
  alice_u : ∀ a, (other.alice a).u = s * (original.alice a).u
  bob_u : ∀ b, (other.bob b).u = (original.bob b).u / s
  alice_z : ∀ a, (other.alice a).z = t * (original.alice a).z
  bob_z : ∀ b, (other.bob b).z = (original.bob b).z / t

/-- Every same-law regular family has the complete recovered two-scale coordinate relation. -/
theorem regular_scale_relation (original other : SettingFamily) (regular : Regular original)
    (same : SameLaw other original) :
    ScaleRelation original other ((other.alice false).u / (original.alice false).u)
      ((other.alice false).z / (original.alice false).z) := by
  have identified_eq := (same_law_iff_identified other original).mp same
  have alice_mu : ∀ a, (other.alice a).mu = (original.alice a).mu :=
    fun a => congrFun (congrArg IdentifiedCoordinates.aliceBias identified_eq) a
  have bob_mu : ∀ b, (other.bob b).mu = (original.bob b).mu :=
    fun b => congrFun (congrArg IdentifiedCoordinates.bobBias identified_eq) b
  have products_x : ∀ a b, (other.alice a).u * (other.bob b).u =
      (original.alice a).u * (original.bob b).u :=
    fun a b => congrFun (congrFun (congrArg IdentifiedCoordinates.productX identified_eq) a) b
  have products_z : ∀ a b, (other.alice a).z * (other.bob b).z =
      (original.alice a).z * (original.bob b).z :=
    fun a b => congrFun (congrFun (congrArg IdentifiedCoordinates.productZ identified_eq) a) b
  have x_scale := rank_one_scale (fun a => (original.alice a).u)
    (fun b => (original.bob b).u) (fun a => (other.alice a).u)
    (fun b => (other.bob b).u) false false regular.1 products_x
  have z_scale := rank_one_scale (fun a => (original.alice a).z)
    (fun b => (original.bob b).z) (fun a => (other.alice a).z)
    (fun b => (other.bob b).z) false false regular.2 products_z
  exact
    { s_nonzero := x_scale.1
      t_nonzero := z_scale.1
      alice_mu := alice_mu
      bob_mu := bob_mu
      alice_u := x_scale.2.1
      bob_u := x_scale.2.2
      alice_z := z_scale.2.1
      bob_z := z_scale.2.2 }

/-- Legal target effects generate the primitive source-cone conditions along their recovered scales. -/
theorem ScaleRelation.admissible {original other : SettingFamily} {s t : ℝ}
    (relation : ScaleRelation original other s t) : AdmissibleScales original s t := {
  s_nonzero := relation.s_nonzero
  t_nonzero := relation.t_nonzero
  alice_plus := fun a => by
    rw [← relation.alice_u a, ← relation.alice_z a, ← relation.alice_mu a]
    exact (other.alice a).norm_plus
  alice_minus := fun a => by
    rw [← relation.alice_u a, ← relation.alice_z a, ← relation.alice_mu a]
    exact (other.alice a).norm_minus
  bob_plus := fun b => by
    rw [← relation.bob_u b, ← relation.bob_z b, ← relation.bob_mu b]
    exact (other.bob b).norm_plus
  bob_minus := fun b => by
    rw [← relation.bob_u b, ← relation.bob_z b, ← relation.bob_mu b]
    exact (other.bob b).norm_minus }

theorem ScaleRelation.generated {original other : SettingFamily} {s t : ℝ}
    (relation : ScaleRelation original other s t) :
    other = scaledFamily original s t relation.admissible := by
  apply SettingFamily.ext
  · funext a
    apply CompactReadoutEffect.ext
    · exact relation.alice_mu a
    · exact relation.alice_u a
    · exact relation.alice_z a
  · funext b
    apply CompactReadoutEffect.ext
    · exact relation.bob_mu b
    · exact relation.bob_u b
    · exact relation.bob_z b

theorem ScaleRelation.unique {original other : SettingFamily} {s t : ℝ}
    (relation : ScaleRelation original other s t) (regular : Regular original)
    (s' t' : ℝ) (valid : AdmissibleScales original s' t')
    (generated : other = scaledFamily original s' t' valid) : s' = s ∧ t' = t := by
  have x_ne := (mul_ne_zero_iff.mp regular.1).1
  have z_ne := (mul_ne_zero_iff.mp regular.2).1
  have other_x : (other.alice false).u = s' * (original.alice false).u :=
    congrArg (fun family : SettingFamily => (family.alice false).u) generated
  have other_z : (other.alice false).z = t' * (original.alice false).z :=
    congrArg (fun family : SettingFamily => (family.alice false).z) generated
  have recovered_x : s' = (other.alice false).u / (original.alice false).u :=
    (eq_div_iff x_ne).mpr other_x.symm
  have original_x : s = (other.alice false).u / (original.alice false).u :=
    (eq_div_iff x_ne).mpr (relation.alice_u false).symm
  have recovered_z : t' = (other.alice false).z / (original.alice false).z :=
    (eq_div_iff z_ne).mpr other_z.symm
  have original_z : t = (other.alice false).z / (original.alice false).z :=
    (eq_div_iff z_ne).mpr (relation.alice_z false).symm
  exact ⟨recovered_x.trans original_x.symm, recovered_z.trans original_z.symm⟩

/-- Complete regular inverse fiber with its computed scales, legal constructor and uniqueness. -/
structure RegularFiber (original other : SettingFamily) where
  s : ℝ
  t : ℝ
  admissible : AdmissibleScales original s t
  generated : other = scaledFamily original s t admissible
  recovered_s : s = (other.alice false).u / (original.alice false).u
  recovered_t : t = (other.alice false).z / (original.alice false).z
  unique : ∀ s' t' (valid : AdmissibleScales original s' t'),
    other = scaledFamily original s' t' valid → s' = s ∧ t' = t

/-- The inverse consumer computes its scales from existing legal source-generated families. -/
def regularFiber (original other : SettingFamily) (regular : Regular original)
    (same : SameLaw other original) : RegularFiber original other :=
  let relation := regular_scale_relation original other regular same
  { s := (other.alice false).u / (original.alice false).u
    t := (other.alice false).z / (original.alice false).z
    admissible := relation.admissible
    generated := relation.generated
    recovered_s := rfl
    recovered_t := rfl
    unique := relation.unique regular }

/-- Complete regular converse: same law is equivalent to membership in the unique legal scale fiber. -/
theorem same_law_iff_regular_fiber (original other : SettingFamily) (regular : Regular original) :
    SameLaw other original ↔ Nonempty (RegularFiber original other) := by
  constructor
  · intro same
    exact ⟨regularFiber original other regular same⟩
  · rintro ⟨fiber⟩
    rw [fiber.generated]
    exact scaled_same_law original fiber.s fiber.t fiber.admissible

theorem scaled_alice_gain_sq (family : SettingFamily) (s t : ℝ)
    (valid : AdmissibleScales family s t) (a : Bool) :
    ((scaledFamily family s t valid).alice a).gain ^ 2 =
      s ^ 2 * (family.alice a).u ^ 2 + t ^ 2 * (family.alice a).z ^ 2 := by
  rw [CompactReadoutEffect.gain_sq]
  simp only [scaledFamily]
  ring

theorem scaled_bob_gain_sq (family : SettingFamily) (s t : ℝ)
    (valid : AdmissibleScales family s t) (b : Bool) :
    ((scaledFamily family s t valid).bob b).gain ^ 2 =
      ((family.bob b).u / s) ^ 2 + ((family.bob b).z / t) ^ 2 :=
  CompactReadoutEffect.gain_sq _

/-- Maximal quotient and complete regular fiber retain the original source activation. -/
structure SameOccurrenceIdentification : Prop extends SameOccurrenceReadoutEffectPrediction where
  recoveredCoordinates : ∀ family : SettingFamily, family.recovered = family.identified
  maximalQuotient : ∀ first second : SettingFamily,
    SameLaw first second ↔ first.identified = second.identified
  lawfulScales : ∀ (family : SettingFamily) s t (valid : AdmissibleScales family s t),
    SameLaw (scaledFamily family s t valid) family
  scaleSource : ∀ (family : SettingFamily) s t (valid : AdmissibleScales family s t) point plus a b x y,
    (scaledFamily family s t valid).sourceProbability point plus a b x y =
      family.sourceProbability point plus a b x y
  scaleCurrent : ∀ (family : SettingFamily) s t (valid : AdmissibleScales family s t) point plus a b x y,
    (scaledFamily family s t valid).currentProbability point plus a b x y =
      family.currentProbability point plus a b x y
  scaleNext : ∀ (family : SettingFamily) s t (valid : AdmissibleScales family s t) point plus a b x y,
    (scaledFamily family s t valid).nextProbability point plus a b x y =
      family.nextProbability point plus a b x y
  completeRegularFiber : ∀ (original other : SettingFamily), Regular original →
    (SameLaw other original ↔ Nonempty (RegularFiber original other))

theorem sameOccurrenceIdentification : SameOccurrenceIdentification :=
  { toSameOccurrenceReadoutEffectPrediction := sameOccurrenceReadoutEffectPrediction
    recoveredCoordinates := SettingFamily.recovered_eq_identified
    maximalQuotient := same_law_iff_identified
    lawfulScales := scaled_same_law
    scaleSource := scaled_source_probability
    scaleCurrent := scaled_current_probability
    scaleNext := scaled_next_probability
    completeRegularFiber := same_law_iff_regular_fiber }

end
end SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutIdentification
