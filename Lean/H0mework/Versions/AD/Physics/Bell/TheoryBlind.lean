import H0mework.Versions.R2.Physics.Bell.Runtime

/-!
# Source-native theory-blind Bell prediction

The original occupied source generates the complete XZ probability law and its CHSH readout.
The fixed lock uses the two orthogonal source axes and their normalized bisectors. Its interface
has no observation, apparatus, fitted coefficient or calibration input. Both herald operations
are the original color-Z operations, and current/next probabilities consume the original runtime.
This is a dependent mathematical readout of that occurrence.
-/

set_option autoImplicit false

namespace SaturationMonoid.PhysicsCore.Stage10.Bell.TheoryBlind

open StageNineHolonomicField StageNineEnrichedProofFreeSource ProofFreeRicherAnholonomicSource

noncomputable section

/-- Exact diagonal coordinate selected by the normalized theoretical bisectors. -/
def diagonal : ℝ := Real.sqrt 2 / 2

theorem diagonal_sq : diagonal ^ 2 = 1 / 2 := by
  have hsqrt : (Real.sqrt (2 : ℝ)) ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  dsimp [diagonal]
  nlinarith

/-- Alice uses source Z and source X, with their original signs. -/
def alice : Bool → Axis
  | false => ⟨0, 1, by norm_num⟩
  | true => ⟨1, 0, by norm_num⟩

/-- Bob uses the two normalized bisectors of the same theoretical axes. -/
def bob : Bool → Axis
  | false => ⟨diagonal, diagonal, by nlinarith [diagonal_sq]⟩
  | true => ⟨-diagonal, diagonal, by nlinarith [diagonal_sq]⟩

/-- The signed expectation of the full four-outcome probability law. -/
def sourceCorrelation (plus : Bool) (a b : Axis) : ℝ :=
  ∑ x : Bool, ∑ y : Bool, sign x * sign y * probability a (heraldAxis plus b) x y

/-- The original color-Z herald changes the X coordinate and keeps Z. -/
theorem source_correlation (plus : Bool) (a b : Axis) :
    sourceCorrelation plus a b = -(sign plus * a.x * b.x + a.z * b.z) := by
  rw [sourceCorrelation, correlation]
  cases plus <;> simp [heraldAxis, Axis.reflected, sign]

/-- Four source correlations with the output-sign correction generated by the herald operation. -/
def chsh (plus : Bool) (a₀ a₁ b₀ b₁ : Axis) : ℝ :=
  -sourceCorrelation plus a₀ b₀ - sourceCorrelation plus a₀ b₁ -
    sign plus * sourceCorrelation plus a₁ b₀ + sign plus * sourceCorrelation plus a₁ b₁

/-- Symbolic CHSH for every admitted pair of source XZ measurement axes. -/
theorem chsh_from_source (plus : Bool) (a₀ a₁ b₀ b₁ : Axis) :
    chsh plus a₀ a₁ b₀ b₁ =
      sign plus * a₀.x * (b₀.x + b₁.x) + a₀.z * (b₀.z + b₁.z) +
        a₁.x * (b₀.x - b₁.x) + sign plus * a₁.z * (b₀.z - b₁.z) := by
  simp only [chsh, source_correlation]
  cases plus <;> simp only [sign] <;> ring

theorem chsh_sq_le_eight (plus : Bool) (a₀ a₁ b₀ b₁ : Axis) :
    (chsh plus a₀ a₁ b₀ b₁) ^ 2 ≤ 8 := by
  let u : Fin 4 → ℝ := ![sign plus * a₀.x, a₀.z, a₁.x, sign plus * a₁.z]
  let v : Fin 4 → ℝ := ![b₀.x + b₁.x, b₀.z + b₁.z, b₀.x - b₁.x, b₀.z - b₁.z]
  have leftNorm : ∑ i : Fin 4, u i ^ 2 = 2 := by
    rw [Fin.sum_univ_four]
    change (sign plus * a₀.x) ^ 2 + a₀.z ^ 2 + a₁.x ^ 2 +
      (sign plus * a₁.z) ^ 2 = 2
    cases plus <;> simp only [sign] <;> nlinarith [a₀.unit, a₁.unit]
  have rightNorm : ∑ i : Fin 4, v i ^ 2 = 4 := by
    rw [Fin.sum_univ_four]
    change (b₀.x + b₁.x) ^ 2 + (b₀.z + b₁.z) ^ 2 +
      (b₀.x - b₁.x) ^ 2 + (b₀.z - b₁.z) ^ 2 = 4
    nlinarith [b₀.unit, b₁.unit]
  have value : (∑ i : Fin 4, u i * v i) = chsh plus a₀ a₁ b₀ b₁ := by
    rw [chsh_from_source]
    rw [Fin.sum_univ_four]
    change (sign plus * a₀.x) * (b₀.x + b₁.x) + a₀.z * (b₀.z + b₁.z) +
      a₁.x * (b₀.x - b₁.x) + (sign plus * a₁.z) * (b₀.z - b₁.z) = _
    ring
  have cauchy := Finset.sum_mul_sq_le_sq_mul_sq (Finset.univ : Finset (Fin 4)) u v
  simpa only [value, leftNorm, rightNorm, show (2 : ℝ) * 4 = 8 by norm_num] using cauchy

/-- The full theoretical source family satisfies the CHSH bound, for both original heralds. -/
theorem tsirelson_bound (plus : Bool) (a₀ a₁ b₀ b₁ : Axis) :
    |chsh plus a₀ a₁ b₀ b₁| ≤ 2 * Real.sqrt 2 := by
  have bound := chsh_sq_le_eight plus a₀ a₁ b₀ b₁
  have hsqrt : (Real.sqrt (2 : ℝ)) ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have nonnegative := Real.sqrt_nonneg (2 : ℝ)
  have habs := abs_nonneg (chsh plus a₀ a₁ b₀ b₁)
  have hsquare := sq_abs (chsh plus a₀ a₁ b₀ b₁)
  nlinarith

/-- Exact same-source dot product at the fixed setting labels. -/
def settingDot (plus first second : Bool) : ℝ :=
  if first then sign plus * (if second then -diagonal else diagonal) else diagonal

/-- All 32 herald, setting and outcome probabilities, fixed by theory alone. -/
def prediction (plus first second x y : Bool) : ℝ :=
  (1 - sign x * sign y * settingDot plus first second) / 4

/-- The source herald flips Alice's X outcome; its Z outcome keeps the original label. -/
def alignedAliceOutcome (plus first x : Bool) : Bool :=
  if plus && first then !x else x

/-- The fixed source-generated outcome alignment restores the minus-herald table. -/
theorem aligned_prediction (plus first second x y : Bool) :
    prediction plus first second (alignedAliceOutcome plus first x) y =
      prediction false first second x y := by
  cases plus <;> cases first <;> cases x <;>
    simp [alignedAliceOutcome, prediction, settingDot, sign]

theorem setting_dot (plus first second : Bool) :
    (alice first).x * (heraldAxis plus (bob second)).x +
      (alice first).z * (heraldAxis plus (bob second)).z = settingDot plus first second := by
  cases plus <;> cases first <;> cases second <;>
    simp [alice, bob, heraldAxis, Axis.reflected, settingDot, sign]

theorem prediction_from_source (plus first second x y : Bool) :
    probability (alice first) (heraldAxis plus (bob second)) x y =
      prediction plus first second x y := by
  rw [probability, setting_dot]
  rfl

theorem current_prediction (plus first second x y : Bool)
    (point : BasePoint) :
    runtimeProbability plus point (alice first) (bob second) x y =
      prediction plus first second x y :=
  (sameOccurrenceBellPrediction.currentBorn plus point (alice first) (bob second) x y).trans
    (prediction_from_source plus first second x y)

theorem next_prediction (plus first second x y : Bool)
    (point : BasePoint) :
    nextProbability plus point (alice first) (bob second) x y =
      prediction plus first second x y :=
  (sameOccurrenceBellPrediction.nextBorn plus point (alice first) (bob second) x y).trans
    (prediction_from_source plus first second x y)

theorem current_aligned_prediction (plus first second x y : Bool) (point : BasePoint) :
    runtimeProbability plus point (alice first) (bob second)
      (alignedAliceOutcome plus first x) y = prediction false first second x y :=
  (current_prediction plus first second (alignedAliceOutcome plus first x) y point).trans
    (aligned_prediction plus first second x y)

theorem next_aligned_prediction (plus first second x y : Bool) (point : BasePoint) :
    nextProbability plus point (alice first) (bob second)
      (alignedAliceOutcome plus first x) y = prediction false first second x y :=
  (next_prediction plus first second (alignedAliceOutcome plus first x) y point).trans
    (aligned_prediction plus first second x y)

theorem prediction_normalized (plus first second : Bool) :
    ∑ x : Bool, ∑ y : Bool, prediction plus first second x y = 1 := by
  simp_rw [← prediction_from_source]
  exact sameOccurrenceBellPrediction.total _ _

theorem prediction_nonnegative (plus first second x y : Bool) :
    0 ≤ prediction plus first second x y := by
  rw [← prediction_from_source]
  exact sameOccurrenceBellPrediction.positive _ _ _ _

theorem prediction_bounded (plus first second x y : Bool) :
    prediction plus first second x y ≤ 1 := by
  rw [← prediction_from_source]
  exact sameOccurrenceBellPrediction.bounded _ _ _ _

theorem prediction_left_marginal (plus first second x : Bool) :
    ∑ y : Bool, prediction plus first second x y = 1 / 2 := by
  simp_rw [← prediction_from_source]
  exact sameOccurrenceBellPrediction.leftMarginal _ _ _

theorem prediction_right_marginal (plus first second y : Bool) :
    ∑ x : Bool, prediction plus first second x y = 1 / 2 := by
  simp_rw [← prediction_from_source]
  exact sameOccurrenceBellPrediction.rightMarginal _ _ _

/-- Both fixed herald tables attain the uniform source CHSH bound. -/
theorem fixed_chsh (plus : Bool) :
    chsh plus (alice false) (alice true) (bob false) (bob true) = 2 * Real.sqrt 2 := by
  rw [chsh_from_source]
  cases plus <;> simp [alice, bob, sign, diagonal] <;> ring

theorem fixed_chsh_exceeds_two (plus : Bool) :
    2 < chsh plus (alice false) (alice true) (bob false) (bob true) := by
  rw [fixed_chsh]
  have hsqrt : (Real.sqrt (2 : ℝ)) ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have nonnegative := Real.sqrt_nonneg (2 : ℝ)
  nlinarith

/-- Closed proof contract for the theory-only lock; no empirical input is a constructor premise. -/
structure PredictionLock : Prop extends SameOccurrenceBellPrediction where
  source : Runtime.source = positiveSmoothUnifiedSource
  visit : Runtime.visit = Stage9C.Revision.SpinPair.visit 10
  uniformCorrelation : ∀ plus a b,
    sourceCorrelation plus a b = -(sign plus * a.x * b.x + a.z * b.z)
  uniformCHSH : ∀ plus a₀ a₁ b₀ b₁,
    |chsh plus a₀ a₁ b₀ b₁| ≤ 2 * Real.sqrt 2
  current : ∀ plus first second x y point,
    runtimeProbability plus point (alice first) (bob second) x y =
      prediction plus first second x y
  next : ∀ plus first second x y point,
    nextProbability plus point (alice first) (bob second) x y =
      prediction plus first second x y
  aligned : ∀ plus first second x y,
    prediction plus first second (alignedAliceOutcome plus first x) y =
      prediction false first second x y
  currentAligned : ∀ plus first second x y point,
    runtimeProbability plus point (alice first) (bob second)
      (alignedAliceOutcome plus first x) y = prediction false first second x y
  nextAligned : ∀ plus first second x y point,
    nextProbability plus point (alice first) (bob second)
      (alignedAliceOutcome plus first x) y = prediction false first second x y
  fixedTotal : ∀ plus first second, ∑ x : Bool, ∑ y : Bool,
    prediction plus first second x y = 1
  fixedPositive : ∀ plus first second x y, 0 ≤ prediction plus first second x y
  fixedBounded : ∀ plus first second x y, prediction plus first second x y ≤ 1
  fixedLeftMarginal : ∀ plus first second x, ∑ y : Bool,
    prediction plus first second x y = 1 / 2
  fixedRightMarginal : ∀ plus first second y, ∑ x : Bool,
    prediction plus first second x y = 1 / 2
  attains : ∀ plus,
    chsh plus (alice false) (alice true) (bob false) (bob true) = 2 * Real.sqrt 2
  violates : ∀ plus, 2 < chsh plus (alice false) (alice true) (bob false) (bob true)

/-- The fixed original source supplies the complete theory-blind prediction lock. -/
theorem predictionLock : PredictionLock :=
  { toSameOccurrenceBellPrediction := sameOccurrenceBellPrediction
    source := Runtime.source_eq
    visit := rfl
    uniformCorrelation := source_correlation
    uniformCHSH := tsirelson_bound
    current := current_prediction
    next := next_prediction
    aligned := aligned_prediction
    currentAligned := current_aligned_prediction
    nextAligned := next_aligned_prediction
    fixedTotal := prediction_normalized
    fixedPositive := prediction_nonnegative
    fixedBounded := prediction_bounded
    fixedLeftMarginal := prediction_left_marginal
    fixedRightMarginal := prediction_right_marginal
    attains := fixed_chsh
    violates := fixed_chsh_exceeds_two }

end
end SaturationMonoid.PhysicsCore.Stage10.Bell.TheoryBlind
