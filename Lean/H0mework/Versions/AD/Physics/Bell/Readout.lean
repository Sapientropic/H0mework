import H0mework.Versions.R2.Physics.Bell.Runtime

/-!
# Same-source binary stochastic Bell readout

Two legal binary channels act on the latent outcomes generated by the original occupied source.
Their error parameters construct the full reported joint law, its asymmetric margins and its
correlation. Current and next Born transports retain the original Bell activation. The parameters
describe a mathematical family; they do not select a hardware identity or alter the root runtime.
-/

set_option autoImplicit false

namespace SaturationMonoid.PhysicsCore.Stage10.Bell

open Stage9DEF StageNineHolonomicField ProofFreeRicherAnholonomicSource

noncomputable section

/-- The two conditional readout errors; the stochastic matrix is constructed from them. -/
structure BinaryReadoutChannel where
  error0 : ℝ
  error1 : ℝ
  error0_nonnegative : 0 ≤ error0
  error0_le_one : error0 ≤ 1
  error1_nonnegative : 0 ≤ error1
  error1_le_one : error1 ≤ 1

/-- Conditional probability of a reported bit, given the latent source bit. -/
def BinaryReadoutChannel.report (c : BinaryReadoutChannel) (reported latent : Bool) : ℝ :=
  if latent then (if reported then 1 - c.error1 else c.error1)
  else (if reported then c.error0 else 1 - c.error0)

/-- The conditional signed mean equals `bias + gain * sign latent`. -/
def BinaryReadoutChannel.bias (c : BinaryReadoutChannel) : ℝ := c.error1 - c.error0

def BinaryReadoutChannel.gain (c : BinaryReadoutChannel) : ℝ := 1 - c.error0 - c.error1

def BinaryReadoutChannel.marginal (c : BinaryReadoutChannel) (reported : Bool) : ℝ :=
  (1 + sign reported * c.bias) / 2

/-- Exact readout with zero error in both latent columns. -/
def BinaryReadoutChannel.identity : BinaryReadoutChannel :=
  ⟨0, 0, by norm_num, by norm_num, by norm_num, by norm_num⟩

theorem BinaryReadoutChannel.report_nonnegative (c : BinaryReadoutChannel)
    (reported latent : Bool) : 0 ≤ c.report reported latent := by
  cases reported <;> cases latent <;> simp only [report, Bool.false_eq_true, if_false, if_true]
  · exact sub_nonneg.mpr c.error0_le_one
  · exact c.error1_nonnegative
  · exact c.error0_nonnegative
  · exact sub_nonneg.mpr c.error1_le_one

theorem BinaryReadoutChannel.report_le_one (c : BinaryReadoutChannel)
    (reported latent : Bool) : c.report reported latent ≤ 1 := by
  cases reported <;> cases latent <;> simp only [report, Bool.false_eq_true, if_false, if_true]
  · linarith only [c.error0_nonnegative]
  · exact c.error1_le_one
  · exact c.error0_le_one
  · linarith only [c.error1_nonnegative]

theorem BinaryReadoutChannel.report_normalized (c : BinaryReadoutChannel) (latent : Bool) :
    ∑ reported : Bool, c.report reported latent = 1 := by
  cases latent <;> simp [report]

theorem BinaryReadoutChannel.report_mean (c : BinaryReadoutChannel) (latent : Bool) :
    ∑ reported : Bool, sign reported * c.report reported latent =
      c.bias + c.gain * sign latent := by
  cases latent <;> simp [report, sign, bias, gain] <;> ring

theorem BinaryReadoutChannel.marginal_nonnegative (c : BinaryReadoutChannel) (u : Bool) :
    0 ≤ c.marginal u := by
  cases u <;> simp only [marginal, sign, bias] <;>
    linarith only [c.error0_nonnegative, c.error0_le_one,
      c.error1_nonnegative, c.error1_le_one]

theorem BinaryReadoutChannel.marginal_false (c : BinaryReadoutChannel) :
    c.marginal false = (1 - c.error0 + c.error1) / 2 := by
  simp only [marginal, sign, bias]
  ring

/-- Full source-generated law after both local stochastic channels. -/
def reportedProbability (first second : BinaryReadoutChannel) (plus : Bool)
    (a b : Axis) (u v : Bool) : ℝ :=
  ∑ x : Bool, ∑ y : Bool,
    first.report u x * second.report v y * probability a (heraldAxis plus b) x y

/-- The same stochastic readout applied to the actual source Born weights. -/
def reportedSourceWeight (first second : BinaryReadoutChannel) (plus : Bool)
    (point : BasePoint) (a b : Axis) (u v : Bool) : ℝ :=
  ∑ x : Bool, ∑ y : Bool,
    first.report u x * second.report v y * preparedWeight plus point (outcomeEffect a b x y)

def reportedRuntimeProbability (first second : BinaryReadoutChannel) (plus : Bool)
    (point : BasePoint) (a b : Axis) (u v : Bool) : ℝ :=
  ∑ x : Bool, ∑ y : Bool,
    first.report u x * second.report v y * runtimeProbability plus point a b x y

def reportedNextProbability (first second : BinaryReadoutChannel) (plus : Bool)
    (point : BasePoint) (a b : Axis) (u v : Bool) : ℝ :=
  ∑ x : Bool, ∑ y : Bool,
    first.report u x * second.report v y * nextProbability plus point a b x y

theorem reported_probability_from_source (first second : BinaryReadoutChannel) (plus : Bool)
    (point : BasePoint) (a b : Axis) (u v : Bool) :
    reportedSourceWeight first second plus point a b u v =
      reportedProbability first second plus a b u v := by
  simp only [reportedSourceWeight, reportedProbability, herald_probability]

theorem reported_runtime_probability (first second : BinaryReadoutChannel) (plus : Bool)
    (point : BasePoint) (a b : Axis) (u v : Bool) :
    reportedRuntimeProbability first second plus point a b u v =
      reportedProbability first second plus a b u v := by
  simp only [reportedRuntimeProbability, reportedProbability, runtime_probability]

theorem reported_next_probability (first second : BinaryReadoutChannel) (plus : Bool)
    (point : BasePoint) (a b : Axis) (u v : Bool) :
    reportedNextProbability first second plus point a b u v =
      reportedProbability first second plus a b u v := by
  simp only [reportedNextProbability, reportedProbability, next_probability]

theorem reported_probability_nonnegative (first second : BinaryReadoutChannel) (plus : Bool)
    (a b : Axis) (u v : Bool) : 0 ≤ reportedProbability first second plus a b u v := by
  apply Finset.sum_nonneg
  intro x _
  apply Finset.sum_nonneg
  intro y _
  exact mul_nonneg
    (mul_nonneg (first.report_nonnegative u x) (second.report_nonnegative v y))
    (probability_nonnegative a (heraldAxis plus b) x y)

theorem reported_probability_left_marginal (first second : BinaryReadoutChannel) (plus : Bool)
    (a b : Axis) (u : Bool) :
    ∑ v : Bool, reportedProbability first second plus a b u v = first.marginal u := by
  cases u <;>
    simp [reportedProbability, BinaryReadoutChannel.report, BinaryReadoutChannel.marginal,
      BinaryReadoutChannel.bias, probability, sign] <;> ring

theorem reported_probability_right_marginal (first second : BinaryReadoutChannel) (plus : Bool)
    (a b : Axis) (v : Bool) :
    ∑ u : Bool, reportedProbability first second plus a b u v = second.marginal v := by
  cases v <;>
    simp [reportedProbability, BinaryReadoutChannel.report, BinaryReadoutChannel.marginal,
      BinaryReadoutChannel.bias, probability, sign] <;> ring

theorem reported_probability_left_false (first second : BinaryReadoutChannel) (plus : Bool)
    (a b : Axis) :
    ∑ v : Bool, reportedProbability first second plus a b false v =
      (1 - first.error0 + first.error1) / 2 := by
  rw [reported_probability_left_marginal, BinaryReadoutChannel.marginal_false]

theorem reported_probability_right_false (first second : BinaryReadoutChannel) (plus : Bool)
    (a b : Axis) :
    ∑ u : Bool, reportedProbability first second plus a b u false =
      (1 - second.error0 + second.error1) / 2 := by
  rw [reported_probability_right_marginal, BinaryReadoutChannel.marginal_false]

theorem reported_probability_normalized (first second : BinaryReadoutChannel) (plus : Bool)
    (a b : Axis) : ∑ u : Bool, ∑ v : Bool,
      reportedProbability first second plus a b u v = 1 := by
  simp_rw [reported_probability_left_marginal]
  simp [BinaryReadoutChannel.marginal, sign]
  ring

theorem reported_probability_le_one (first second : BinaryReadoutChannel) (plus : Bool)
    (a b : Axis) (u v : Bool) : reportedProbability first second plus a b u v ≤ 1 := by
  have inner : reportedProbability first second plus a b u v ≤
      ∑ w : Bool, reportedProbability first second plus a b u w :=
    Finset.single_le_sum
      (fun w _ => reported_probability_nonnegative first second plus a b u w)
      (Finset.mem_univ v)
  have outer : (∑ w : Bool, reportedProbability first second plus a b u w) ≤
      ∑ t : Bool, ∑ w : Bool, reportedProbability first second plus a b t w :=
    Finset.single_le_sum
      (fun t _ => Finset.sum_nonneg
        (fun w _ => reported_probability_nonnegative first second plus a b t w))
      (Finset.mem_univ u)
  exact (inner.trans outer).trans_eq (reported_probability_normalized first second plus a b)

/-- Correlation of the same latent Bell source, before readout. -/
def latentCorrelation (plus : Bool) (a b : Axis) : ℝ :=
  ∑ x : Bool, ∑ y : Bool, sign x * sign y * probability a (heraldAxis plus b) x y

theorem latent_correlation (plus : Bool) (a b : Axis) :
    latentCorrelation plus a b = - (a.x * (heraldAxis plus b).x + a.z * (heraldAxis plus b).z) :=
  correlation a (heraldAxis plus b)

/-- Exact joint normal form; every coefficient is generated by the source and the two channels. -/
theorem reported_probability_closed_form (first second : BinaryReadoutChannel) (plus : Bool)
    (a b : Axis) (u v : Bool) :
    reportedProbability first second plus a b u v =
      ((1 + sign u * first.bias) * (1 + sign v * second.bias) +
        sign u * sign v * first.gain * second.gain * latentCorrelation plus a b) / 4 := by
  rw [latent_correlation]
  cases u <;> cases v <;>
    simp [reportedProbability, BinaryReadoutChannel.report, BinaryReadoutChannel.bias,
      BinaryReadoutChannel.gain, probability, sign] <;> ring

def reportedCorrelation (first second : BinaryReadoutChannel) (plus : Bool) (a b : Axis) : ℝ :=
  ∑ u : Bool, ∑ v : Bool, sign u * sign v * reportedProbability first second plus a b u v

def reportedLeftMean (first second : BinaryReadoutChannel) (plus : Bool) (a b : Axis) : ℝ :=
  ∑ u : Bool, ∑ v : Bool, sign u * reportedProbability first second plus a b u v

def reportedRightMean (first second : BinaryReadoutChannel) (plus : Bool) (a b : Axis) : ℝ :=
  ∑ u : Bool, ∑ v : Bool, sign v * reportedProbability first second plus a b u v

theorem reported_correlation (first second : BinaryReadoutChannel) (plus : Bool) (a b : Axis) :
    reportedCorrelation first second plus a b =
      first.bias * second.bias + first.gain * second.gain * latentCorrelation plus a b := by
  simp only [reportedCorrelation, reported_probability_closed_form]
  simp [sign]
  ring

theorem reported_left_mean (first second : BinaryReadoutChannel) (plus : Bool) (a b : Axis) :
    reportedLeftMean first second plus a b = first.bias := by
  simp only [reportedLeftMean, reported_probability_closed_form]
  simp [sign]
  ring

theorem reported_right_mean (first second : BinaryReadoutChannel) (plus : Bool) (a b : Axis) :
    reportedRightMean first second plus a b = second.bias := by
  simp only [reportedRightMean, reported_probability_closed_form]
  simp [sign]
  ring

theorem reported_covariance (first second : BinaryReadoutChannel) (plus : Bool) (a b : Axis) :
    reportedCorrelation first second plus a b -
      reportedLeftMean first second plus a b * reportedRightMean first second plus a b =
        first.gain * second.gain * latentCorrelation plus a b := by
  rw [reported_correlation, reported_left_mean, reported_right_mean]
  ring

theorem reported_no_signalling_left (first second : BinaryReadoutChannel) (plus : Bool)
    (a b b' : Axis) (u : Bool) :
    (∑ v : Bool, reportedProbability first second plus a b u v) =
      ∑ v : Bool, reportedProbability first second plus a b' u v := by
  rw [reported_probability_left_marginal, reported_probability_left_marginal]

theorem reported_no_signalling_right (first second : BinaryReadoutChannel) (plus : Bool)
    (a a' b : Axis) (v : Bool) :
    (∑ u : Bool, reportedProbability first second plus a b u v) =
      ∑ u : Bool, reportedProbability first second plus a' b u v := by
  rw [reported_probability_right_marginal, reported_probability_right_marginal]

theorem reported_probability_identity (plus : Bool) (a b : Axis) (u v : Bool) :
    reportedProbability BinaryReadoutChannel.identity BinaryReadoutChannel.identity plus a b u v =
      probability a (heraldAxis plus b) u v := by
  cases u <;> cases v <;>
    simp [reportedProbability, BinaryReadoutChannel.identity, BinaryReadoutChannel.report]

/-- A convex depolarizing coefficient applied to the latent source law, before readout. -/
structure SourceVisibility where
  value : ℝ
  nonnegative : 0 ≤ value
  le_one : value ≤ 1

def SourceVisibility.pure : SourceVisibility := ⟨1, by norm_num, by norm_num⟩

def SourceVisibility.erased : SourceVisibility := ⟨0, by norm_num, by norm_num⟩

/-- The source law and its uniform four-outcome background construct the latent mixed law. -/
def visibleProbability (visibility : SourceVisibility) (plus : Bool) (a b : Axis)
    (x y : Bool) : ℝ :=
  visibility.value * probability a (heraldAxis plus b) x y + (1 - visibility.value) / 4

/-- Local channels act on the internally constructed latent mixture. -/
def visibleReportedProbability (visibility : SourceVisibility)
    (first second : BinaryReadoutChannel) (plus : Bool) (a b : Axis) (u v : Bool) : ℝ :=
  ∑ x : Bool, ∑ y : Bool,
    first.report u x * second.report v y * visibleProbability visibility plus a b x y

def visibleSourceWeight (visibility : SourceVisibility) (first second : BinaryReadoutChannel)
    (plus : Bool) (point : BasePoint) (a b : Axis) (u v : Bool) : ℝ :=
  ∑ x : Bool, ∑ y : Bool,
    first.report u x * second.report v y *
      (visibility.value * preparedWeight plus point (outcomeEffect a b x y) +
        (1 - visibility.value) / 4)

def visibleRuntimeProbability (visibility : SourceVisibility) (first second : BinaryReadoutChannel)
    (plus : Bool) (point : BasePoint) (a b : Axis) (u v : Bool) : ℝ :=
  ∑ x : Bool, ∑ y : Bool,
    first.report u x * second.report v y *
      (visibility.value * runtimeProbability plus point a b x y + (1 - visibility.value) / 4)

def visibleNextProbability (visibility : SourceVisibility) (first second : BinaryReadoutChannel)
    (plus : Bool) (point : BasePoint) (a b : Axis) (u v : Bool) : ℝ :=
  ∑ x : Bool, ∑ y : Bool,
    first.report u x * second.report v y *
      (visibility.value * nextProbability plus point a b x y + (1 - visibility.value) / 4)

theorem visible_probability_from_source (visibility : SourceVisibility)
    (first second : BinaryReadoutChannel) (plus : Bool) (point : BasePoint)
    (a b : Axis) (u v : Bool) :
    visibleSourceWeight visibility first second plus point a b u v =
      visibleReportedProbability visibility first second plus a b u v := by
  simp only [visibleSourceWeight, visibleReportedProbability, visibleProbability, herald_probability]

theorem visible_runtime_probability (visibility : SourceVisibility)
    (first second : BinaryReadoutChannel) (plus : Bool) (point : BasePoint)
    (a b : Axis) (u v : Bool) :
    visibleRuntimeProbability visibility first second plus point a b u v =
      visibleReportedProbability visibility first second plus a b u v := by
  simp only [visibleRuntimeProbability, visibleReportedProbability, visibleProbability,
    runtime_probability]

theorem visible_next_probability (visibility : SourceVisibility)
    (first second : BinaryReadoutChannel) (plus : Bool) (point : BasePoint)
    (a b : Axis) (u v : Bool) :
    visibleNextProbability visibility first second plus point a b u v =
      visibleReportedProbability visibility first second plus a b u v := by
  simp only [visibleNextProbability, visibleReportedProbability, visibleProbability, next_probability]

theorem visible_probability_nonnegative (visibility : SourceVisibility) (plus : Bool)
    (a b : Axis) (x y : Bool) : 0 ≤ visibleProbability visibility plus a b x y := by
  exact add_nonneg
    (mul_nonneg visibility.nonnegative (probability_nonnegative a (heraldAxis plus b) x y))
    (div_nonneg (sub_nonneg.mpr visibility.le_one) (by norm_num))

/-- Depolarizing noise becomes an independent product of the two channel margins after readout. -/
theorem visible_reported_probability_mixture (visibility : SourceVisibility)
    (first second : BinaryReadoutChannel) (plus : Bool) (a b : Axis) (u v : Bool) :
    visibleReportedProbability visibility first second plus a b u v =
      visibility.value * reportedProbability first second plus a b u v +
        (1 - visibility.value) * first.marginal u * second.marginal v := by
  cases u <;> cases v <;>
    simp [visibleReportedProbability, visibleProbability, reportedProbability,
      BinaryReadoutChannel.report, BinaryReadoutChannel.marginal, BinaryReadoutChannel.bias,
      probability, sign] <;> ring

theorem visible_reported_probability_nonnegative (visibility : SourceVisibility)
    (first second : BinaryReadoutChannel) (plus : Bool) (a b : Axis) (u v : Bool) :
    0 ≤ visibleReportedProbability visibility first second plus a b u v := by
  rw [visible_reported_probability_mixture]
  exact add_nonneg
    (mul_nonneg visibility.nonnegative (reported_probability_nonnegative first second plus a b u v))
    (mul_nonneg
      (mul_nonneg (sub_nonneg.mpr visibility.le_one) (first.marginal_nonnegative u))
      (second.marginal_nonnegative v))

theorem visible_reported_probability_closed_form (visibility : SourceVisibility)
    (first second : BinaryReadoutChannel) (plus : Bool) (a b : Axis) (u v : Bool) :
    visibleReportedProbability visibility first second plus a b u v =
      ((1 + sign u * first.bias) * (1 + sign v * second.bias) +
        sign u * sign v * first.gain * second.gain *
          visibility.value * latentCorrelation plus a b) / 4 := by
  rw [visible_reported_probability_mixture, reported_probability_closed_form]
  simp only [BinaryReadoutChannel.marginal]
  ring

theorem visible_reported_probability_left_marginal (visibility : SourceVisibility)
    (first second : BinaryReadoutChannel) (plus : Bool) (a b : Axis) (u : Bool) :
    ∑ v : Bool, visibleReportedProbability visibility first second plus a b u v =
      first.marginal u := by
  simp only [visible_reported_probability_closed_form]
  cases u <;> simp [sign, BinaryReadoutChannel.marginal] <;> ring

theorem visible_reported_probability_right_marginal (visibility : SourceVisibility)
    (first second : BinaryReadoutChannel) (plus : Bool) (a b : Axis) (v : Bool) :
    ∑ u : Bool, visibleReportedProbability visibility first second plus a b u v =
      second.marginal v := by
  simp only [visible_reported_probability_closed_form]
  cases v <;> simp [sign, BinaryReadoutChannel.marginal] <;> ring

theorem visible_reported_probability_normalized (visibility : SourceVisibility)
    (first second : BinaryReadoutChannel) (plus : Bool) (a b : Axis) :
    ∑ u : Bool, ∑ v : Bool, visibleReportedProbability visibility first second plus a b u v = 1 := by
  simp_rw [visible_reported_probability_left_marginal]
  simp [BinaryReadoutChannel.marginal, sign]
  ring

theorem visible_reported_probability_le_one (visibility : SourceVisibility)
    (first second : BinaryReadoutChannel) (plus : Bool) (a b : Axis) (u v : Bool) :
    visibleReportedProbability visibility first second plus a b u v ≤ 1 := by
  have inner : visibleReportedProbability visibility first second plus a b u v ≤
      ∑ w : Bool, visibleReportedProbability visibility first second plus a b u w :=
    Finset.single_le_sum
      (fun w _ => visible_reported_probability_nonnegative visibility first second plus a b u w)
      (Finset.mem_univ v)
  have outer : (∑ w : Bool, visibleReportedProbability visibility first second plus a b u w) ≤
      ∑ t : Bool, ∑ w : Bool, visibleReportedProbability visibility first second plus a b t w :=
    Finset.single_le_sum
      (fun t _ => Finset.sum_nonneg
        (fun w _ => visible_reported_probability_nonnegative visibility first second plus a b t w))
      (Finset.mem_univ u)
  exact (inner.trans outer).trans_eq
    (visible_reported_probability_normalized visibility first second plus a b)

def visibleReportedCorrelation (visibility : SourceVisibility) (first second : BinaryReadoutChannel)
    (plus : Bool) (a b : Axis) : ℝ :=
  ∑ u : Bool, ∑ v : Bool,
    sign u * sign v * visibleReportedProbability visibility first second plus a b u v

theorem visible_reported_correlation (visibility : SourceVisibility)
    (first second : BinaryReadoutChannel) (plus : Bool) (a b : Axis) :
    visibleReportedCorrelation visibility first second plus a b =
      first.bias * second.bias +
        first.gain * second.gain * visibility.value * latentCorrelation plus a b := by
  simp only [visibleReportedCorrelation, visible_reported_probability_closed_form]
  simp [sign]
  ring

theorem visible_no_signalling_left (visibility : SourceVisibility)
    (first second : BinaryReadoutChannel) (plus : Bool) (a b b' : Axis) (u : Bool) :
    (∑ v : Bool, visibleReportedProbability visibility first second plus a b u v) =
      ∑ v : Bool, visibleReportedProbability visibility first second plus a b' u v := by
  rw [visible_reported_probability_left_marginal, visible_reported_probability_left_marginal]

theorem visible_no_signalling_right (visibility : SourceVisibility)
    (first second : BinaryReadoutChannel) (plus : Bool) (a a' b : Axis) (v : Bool) :
    (∑ u : Bool, visibleReportedProbability visibility first second plus a b u v) =
      ∑ u : Bool, visibleReportedProbability visibility first second plus a' b u v := by
  rw [visible_reported_probability_right_marginal, visible_reported_probability_right_marginal]

theorem visible_reported_probability_identity (visibility : SourceVisibility)
    (plus : Bool) (a b : Axis) (u v : Bool) :
    visibleReportedProbability visibility BinaryReadoutChannel.identity
      BinaryReadoutChannel.identity plus a b u v = visibleProbability visibility plus a b u v := by
  cases u <;> cases v <;>
    simp [visibleReportedProbability, BinaryReadoutChannel.identity, BinaryReadoutChannel.report]

theorem visible_reported_probability_pure (first second : BinaryReadoutChannel)
    (plus : Bool) (a b : Axis) (u v : Bool) :
    visibleReportedProbability SourceVisibility.pure first second plus a b u v =
      reportedProbability first second plus a b u v := by
  simp [visible_reported_probability_mixture, SourceVisibility.pure]

theorem visible_reported_probability_erased (first second : BinaryReadoutChannel)
    (plus : Bool) (a b : Axis) (u v : Bool) :
    visibleReportedProbability SourceVisibility.erased first second plus a b u v =
      first.marginal u * second.marginal v := by
  simp [visible_reported_probability_mixture, SourceVisibility.erased]

/-- The new complete readout family consumes and retains the original Bell occurrence. -/
structure SameOccurrenceReadoutPrediction : Prop extends SameOccurrenceBellPrediction where
  channelsPositive : ∀ c u x, 0 ≤ BinaryReadoutChannel.report c u x
  channelsTotal : ∀ c x, ∑ u : Bool, BinaryReadoutChannel.report c u x = 1
  sourceReadout : ∀ first second plus point a b u v,
    reportedSourceWeight first second plus point a b u v =
      reportedProbability first second plus a b u v
  currentReadout : ∀ first second plus point a b u v,
    reportedRuntimeProbability first second plus point a b u v =
      reportedProbability first second plus a b u v
  nextReadout : ∀ first second plus point a b u v,
    reportedNextProbability first second plus point a b u v =
      reportedProbability first second plus a b u v
  readoutPositive : ∀ first second plus a b u v,
    0 ≤ reportedProbability first second plus a b u v
  readoutBounded : ∀ first second plus a b u v,
    reportedProbability first second plus a b u v ≤ 1
  readoutTotal : ∀ first second plus a b,
    ∑ u : Bool, ∑ v : Bool, reportedProbability first second plus a b u v = 1
  readoutLeftMarginal : ∀ first second plus a b u,
    ∑ v : Bool, reportedProbability first second plus a b u v =
      BinaryReadoutChannel.marginal first u
  readoutRightMarginal : ∀ first second plus a b v,
    ∑ u : Bool, reportedProbability first second plus a b u v =
      BinaryReadoutChannel.marginal second v
  readoutCorrelation : ∀ first second plus a b,
    reportedCorrelation first second plus a b = first.bias * second.bias +
      first.gain * second.gain * latentCorrelation plus a b
  readoutJoint : ∀ first second plus a b u v,
    reportedProbability first second plus a b u v =
      ((1 + sign u * first.bias) * (1 + sign v * second.bias) +
        sign u * sign v * first.gain * second.gain * latentCorrelation plus a b) / 4
  noSigLeft : ∀ first second plus a b b' u,
    (∑ v : Bool, reportedProbability first second plus a b u v) =
      ∑ v : Bool, reportedProbability first second plus a b' u v
  noSigRight : ∀ first second plus a a' b v,
    (∑ u : Bool, reportedProbability first second plus a b u v) =
      ∑ u : Bool, reportedProbability first second plus a' b u v
  zeroError : ∀ plus a b u v,
    reportedProbability BinaryReadoutChannel.identity BinaryReadoutChannel.identity plus a b u v =
      probability a (heraldAxis plus b) u v
  visibleSource : ∀ visibility first second plus point a b u v,
    visibleSourceWeight visibility first second plus point a b u v =
      visibleReportedProbability visibility first second plus a b u v
  visibleCurrent : ∀ visibility first second plus point a b u v,
    visibleRuntimeProbability visibility first second plus point a b u v =
      visibleReportedProbability visibility first second plus a b u v
  visibleNext : ∀ visibility first second plus point a b u v,
    visibleNextProbability visibility first second plus point a b u v =
      visibleReportedProbability visibility first second plus a b u v
  visiblePositive : ∀ visibility first second plus a b u v,
    0 ≤ visibleReportedProbability visibility first second plus a b u v
  visibleBounded : ∀ visibility first second plus a b u v,
    visibleReportedProbability visibility first second plus a b u v ≤ 1
  visibleTotal : ∀ visibility first second plus a b,
    ∑ u : Bool, ∑ v : Bool, visibleReportedProbability visibility first second plus a b u v = 1
  visibleLeftMarginal : ∀ visibility first second plus a b u,
    ∑ v : Bool, visibleReportedProbability visibility first second plus a b u v = first.marginal u
  visibleRightMarginal : ∀ visibility first second plus a b v,
    ∑ u : Bool, visibleReportedProbability visibility first second plus a b u v = second.marginal v
  visibleCorrelation : ∀ visibility first second plus a b,
    visibleReportedCorrelation visibility first second plus a b = first.bias * second.bias +
      first.gain * second.gain * visibility.value * latentCorrelation plus a b
  visibleZeroError : ∀ visibility plus a b u v,
    visibleReportedProbability visibility BinaryReadoutChannel.identity
      BinaryReadoutChannel.identity plus a b u v = visibleProbability visibility plus a b u v
  visibilityOne : ∀ first second plus a b u v,
    visibleReportedProbability SourceVisibility.pure first second plus a b u v =
      reportedProbability first second plus a b u v

/-- Nullary source-to-readout producer; only legal channel parameters remain universally quantified. -/
theorem sameOccurrenceReadoutPrediction : SameOccurrenceReadoutPrediction :=
  { toSameOccurrenceBellPrediction := sameOccurrenceBellPrediction
    channelsPositive := BinaryReadoutChannel.report_nonnegative
    channelsTotal := BinaryReadoutChannel.report_normalized
    sourceReadout := reported_probability_from_source
    currentReadout := reported_runtime_probability
    nextReadout := reported_next_probability
    readoutPositive := reported_probability_nonnegative
    readoutBounded := reported_probability_le_one
    readoutTotal := reported_probability_normalized
    readoutLeftMarginal := reported_probability_left_marginal
    readoutRightMarginal := reported_probability_right_marginal
    readoutCorrelation := reported_correlation
    readoutJoint := reported_probability_closed_form
    noSigLeft := reported_no_signalling_left
    noSigRight := reported_no_signalling_right
    zeroError := reported_probability_identity
    visibleSource := visible_probability_from_source
    visibleCurrent := visible_runtime_probability
    visibleNext := visible_next_probability
    visiblePositive := visible_reported_probability_nonnegative
    visibleBounded := visible_reported_probability_le_one
    visibleTotal := visible_reported_probability_normalized
    visibleLeftMarginal := visible_reported_probability_left_marginal
    visibleRightMarginal := visible_reported_probability_right_marginal
    visibleCorrelation := visible_reported_correlation
    visibleZeroError := visible_reported_probability_identity
    visibilityOne := visible_reported_probability_pure }

end
end SaturationMonoid.PhysicsCore.Stage10.Bell
