-- The coefficient is generated by the source divergence and its original density contraction.
def sourceMovingNumberCoefficient (z : SourceCoordinateSlice) : ℝ:=
  (1/2:ℝ)*(∑i : Fin 6,fderiv ℝ (sourceRadialCoefficient i) z (GaussCoframeCore.coframeDirection i))+
    2*(∑i : Fin 6,sourceRadialCoefficient i z*sourceNumberConnection z.1 i)

theorem sourceMovingNumberCoefficient_original (z : physicalChart) :
    sourceMovingNumberCoefficient z.val=GaussCoframeForm.numberCoefficient z.val:=by
  rw [sourceMovingNumberCoefficient,sourceRadialCoefficient_divergence,sourceRadialCoefficient_density]
  simp only [GaussCoframeForm.numberCoefficient,GaussCoframeForm.inverseVolume,
    GaussNativeEnergy.source_time_generated,Matrix.cons_val_zero]
  ring

def sourceMovingVolumeCoefficient (z : SourceCoordinateSlice) : ℝ:=3*(sourceGaussCoframe z).det

theorem sourceMovingVolumeCoefficient_original (z : SourceCoordinateSlice) :
    sourceMovingVolumeCoefficient z=GaussCoframeForm.volumePotential z:=by
  rw [sourceMovingVolumeCoefficient,sourceGaussCoframe_determinant]
  simp only [GaussCoframeForm.volumePotential,GaussNativeEnergy.source_time_generated,Matrix.cons_val_zero]
  ring

private theorem sourceMovingLinearCoefficients_original (z : physicalChart) :
    sourceLinearCoefficient 1 6 z.val=GaussCoframeForm.currentCoefficient 0 z.val ∧
    sourceLinearCoefficient 3 4 z.val=GaussCoframeForm.currentCoefficient 1 z.val ∧
    sourceLinearCoefficient 3 5 z.val=-GaussCoframeForm.currentCoefficient 0 z.val ∧
    sourceLinearCoefficient 4 4 z.val=GaussCoframeForm.currentCoefficient 2 z.val:=by
  have read (i : Fin 6) (a : Fin 8) : sourceLinearCoefficient i a z.val=sourceLegendreLinearTensor z.val i a:=by
    rw [sourceLegendreLinearTensor_read]
    rfl
  simp only [read]
  exact sourceLegendreLinearTensor_current z

def sourceMovingPair (f : Field289) (c : SourceCoordinateSlice→ℝ) (u : Parameter) (a b : FockFiber) : ℂ:=
  pairSample u.2 a ((c (fieldCoordinateCurve f u.1 u.2):ℂ) • b)

def sourceMovingMixed (f : Field289) (a b : QuantumTest) (i : Fin 6) (s : Fin 7)
    (c : SourceCoordinateSlice→ℝ) (u : Parameter) : ℂ:=
  (1/2:ℂ)*(sourceMovingPair f c u (correctedSpin a s u) (sourceMovingCoframe f b i u)+
    sourceMovingPair f c u (sourceMovingCoframe f a i u) (correctedSpin b s u))

-- Couplings come from the original Legendre/source-action producers; both prepared legs use the full Jacobian/measure return.
def sourceMovingCoframeSample (f : Field289) (a b : QuantumTest) (u : Parameter) : ℂ:=
  (∑i : Fin 6,∑j : Fin 6,sourceMovingPair f (sourceKineticCoefficient i j) u
    (sourceMovingCoframe f a i u) (sourceMovingCoframe f b j u))+
  (sourceMovingMixed f a b 1 5 (sourceLinearCoefficient 1 6) u+
    sourceMovingMixed f a b 3 3 (sourceLinearCoefficient 3 4) u+
    sourceMovingMixed f a b 3 4 (sourceLinearCoefficient 3 5) u+
    sourceMovingMixed f a b 4 3 (sourceLinearCoefficient 4 4) u)+
  (∑s : Fin 7,sourceHamiltonianSpinWeight s*sourceMovingPair f
    (fun z=>lapse/GaussNativeEnergy.volume z) u (correctedSpin a s u) (correctedSpin b s u))+
  (1/2:ℂ)*(sourceMovingPair f sourceMovingNumberCoefficient u (correctedNumber a u) (b u.2)+
    sourceMovingPair f sourceMovingNumberCoefficient u (a u.2) (correctedNumber b u))+
  sourceMovingPair f sourceMovingVolumeCoefficient u (a u.2) (b u.2)

theorem sourceMovingCoframeSample_actual (f : Field289) (a b : QuantumTest) (u : Parameter)
    (base : u.2∈physicalChart) (moved : fieldCoordinateCurve f u.1 u.2∈physicalChart) :
    sourceMovingCoframeSample f a b u=coframeFixedSample f a b u:=by
  let point : physicalChart:=⟨fieldCoordinateCurve f u.1 u.2,moved⟩
  have currents:=sourceMovingLinearCoefficients_original point
  have inverse : lapse/GaussNativeEnergy.volume point.val=GaussCoframeForm.inverseVolume point.val:=by
    simp only [GaussCoframeForm.inverseVolume,GaussNativeEnergy.source_time_generated,Matrix.cons_val_zero]
  simp only [sourceMovingCoframeSample,coframeFixedSample,sourceMovingMixed,mixedFixedSample,
    sourceMovingPair,basePair,←sourceMovingCoframe_actual f a _ u base moved,
    ←sourceMovingCoframe_actual f b _ u base moved]
  simp_rw [sourceKineticCoefficient_original,sourceHamiltonianSpinWeight_original]
  rw [currents.1,currents.2.1,currents.2.2.1,currents.2.2.2,inverse,
    sourceMovingNumberCoefficient_original point,sourceMovingVolumeCoefficient_original]

private theorem sourceMovingCoframe_zero (f : Field289) (a : QuantumTest) (i : Fin 6)
    (r : ℝ) (z : SourceCoordinateSlice) (outside : z∉tsupport a) : sourceMovingCoframe f a i (r,z)=0:=by
  simp only [sourceMovingCoframe,image_eq_zero_of_notMem_tsupport outside,
    fderiv_of_notMem_tsupport ℝ outside,zero_apply,map_zero,smul_zero,add_zero]

theorem sourceMovingCoframeSample_zero (f : Field289) (a b : QuantumTest) (r : ℝ)
    (z : SourceCoordinateSlice) (outside : z∉tsupport a) : sourceMovingCoframeSample f a b (r,z)=0:=by
  simp only [sourceMovingCoframeSample,sourceMovingMixed,sourceMovingPair,
    sourceMovingCoframe_zero f a _ r z outside,correctedSpin,correctedNumber,
    image_eq_zero_of_notMem_tsupport outside,map_zero,pairSample_zero_left,
    Finset.sum_const_zero,mul_zero,add_zero]

theorem sourceMovingCoframeSample_smooth (f : Field289) (a b : QuantumTest) (u : Parameter)
    (base : u.2∈physicalChart) (moved : fieldCoordinateCurve f u.1 u.2∈physicalChart) :
    ContDiffAt ℝ ∞ (sourceMovingCoframeSample f a b) u:=by
  apply (coframeFixedSample_smooth f a b u base moved).congr_of_eventuallyEq
  filter_upwards [sourceDomain_near f u base moved] with w hw
  exact sourceMovingCoframeSample_actual f a b w hw.1 hw.2

def sourceMovingCoframeIntegral (f : Field289) (a b : QuantumTest) (r : ℝ) : ℂ:=
  ∫z,sourceMovingCoframeSample f a b (r,z) ∂GaussHistoryHilbert.configurationMeasure

def sourceMovingCoframeIntegralJets (f : Field289) (a b : QuantumTest) :
    TwoJets (sourceMovingCoframeIntegral f a b):=
  parameterIntegralJets (sourceMovingCoframeSample f a b) f a
    (sourceMovingCoframeSample_smooth f a b) (sourceMovingCoframeSample_zero f a b)

theorem sourceMovingCoframeIntegral_actual (f : Field289) (a b : QuantumTest) (r : ℝ)
    (small : |r|<fieldRadius f a) :
    sourceMovingCoframeIntegral f a b r=coframeFixedIntegral f a b r:=by
  apply MeasureTheory.integral_congr_ae
  apply Filter.Eventually.of_forall
  intro z
  by_cases inside : z∈tsupport a
  · exact sourceMovingCoframeSample_actual f a b (r,z) (a.tsupport_subset inside)
      (fieldRadius_chart f a r z small.le inside)
  · change sourceMovingCoframeSample f a b (r,z)=coframeFixedSample f a b (r,z)
    rw [sourceMovingCoframeSample_zero f a b r z inside,coframeFixedSample_zero f a b r z inside]

theorem sourceMovingCoframeJets_first (f : Field289) (a b : QuantumTest) :
    (sourceMovingCoframeIntegralJets f a b).first 0=(coframeFixedJets f a b).first 0:=by
  have near : sourceMovingCoframeIntegral f a b=ᶠ[𝓝 0] coframeFixedIntegral f a b:=by
    have radius : ∀ᶠr in 𝓝 (0:ℝ),|r|<fieldRadius f a:=
      (continuous_abs.tendsto 0).eventually (gt_mem_nhds (by simpa using fieldRadius_positive f a))
    filter_upwards [radius] with r hr
    exact sourceMovingCoframeIntegral_actual f a b r hr
  exact (sourceMovingCoframeIntegralJets f a b).actual.1.unique
    ((coframeFixedJets f a b).actual.1.congr_of_eventuallyEq near)

theorem sourceMovingCoframeJets_second (f : Field289) (a b : QuantumTest) :
    (sourceMovingCoframeIntegralJets f a b).second=(coframeFixedJets f a b).second:=by
  have near : sourceMovingCoframeIntegral f a b=ᶠ[𝓝 0] coframeFixedIntegral f a b:=by
    have radius : ∀ᶠr in 𝓝 (0:ℝ),|r|<fieldRadius f a:=
      (continuous_abs.tendsto 0).eventually (gt_mem_nhds (by simpa using fieldRadius_positive f a))
    filter_upwards [radius] with r hr
    exact sourceMovingCoframeIntegral_actual f a b r hr
  exact (sourceMovingCoframeIntegralJets f a b).actual.2.unique
    ((coframeFixedJets f a b).actual.2.congr_of_eventuallyEq near.deriv)

def sourceMovingCompleteForm (f : Field289) (p : PhysicalMomentum) (a b : QuantumTest) (r : ℝ) : ℂ:=
  nativeFixedIntegral f a b r+sourceMovingCoframeIntegral f a b r+fixedFiber (diagonalFiber p) f a b r

def sourceMovingCompleteJets (f : Field289) (p : PhysicalMomentum) (a b : QuantumTest) :
    TwoJets (sourceMovingCompleteForm f p a b):=
  ((nativeFixedJets f a b).add (sourceMovingCoframeIntegralJets f a b)).add
    (fixedJets (diagonalFiber p) (diagonalFiber_smooth p) f a b)

theorem sourceMovingCompleteJets_first (f : Field289) (p : PhysicalMomentum) (a b : QuantumTest) :
    (sourceMovingCompleteJets f p a b).first 0=(completeJets f p a b).first 0:=by
  change (nativeFixedJets f a b).first 0+(sourceMovingCoframeIntegralJets f a b).first 0+
    (fixedJets (diagonalFiber p) (diagonalFiber_smooth p) f a b).first 0=_
  rw [sourceMovingCoframeJets_first]
  rfl

theorem sourceMovingCompleteJets_second (f : Field289) (p : PhysicalMomentum) (a b : QuantumTest) :
    (sourceMovingCompleteJets f p a b).second=(completeJets f p a b).second:=by
  change (nativeFixedJets f a b).second+(sourceMovingCoframeIntegralJets f a b).second+
    (fixedJets (diagonalFiber p) (diagonalFiber_smooth p) f a b).second=_
  rw [sourceMovingCoframeJets_second]
  rfl

def sourceMovingCompleteCurrent (f : Field289) (p : PhysicalMomentum)
    (F : PreparationVacuumSpatialDensityTransport.Index) (o : Option ℕ) : H→L[ℂ] H:=
  sourceAssembly p F (fun i j=>(sourceMovingCompleteJets f p (bareTest p F i) (bareTest p F j)).first 0)+
    sourceYJet f p F o 1 0

def sourceMovingCompleteContact (f : Field289) (p : PhysicalMomentum)
    (F : PreparationVacuumSpatialDensityTransport.Index) (o : Option ℕ) : H→L[ℂ] H:=
  sourceAssembly p F (fun i j=>(sourceMovingCompleteJets f p (bareTest p F i) (bareTest p F j)).second)+
    sourceYJet f p F o 2 0

theorem sourceMovingCompleteCurrent_actual (f : Field289) (p : PhysicalMomentum)
    (F : PreparationVacuumSpatialDensityTransport.Index) (o : Option ℕ) :
    PreparationVacuumUncutYukawa.sourceCurrent f p F o 0=sourceMovingCompleteCurrent f p F o:=by
  rw [sourceCurrent_complete]
  simp only [completeCurrent,sourceMovingCompleteCurrent,sourceMovingCompleteJets_first]

theorem sourceMovingCompleteContact_actual (f : Field289) (p : PhysicalMomentum)
    (F : PreparationVacuumSpatialDensityTransport.Index) (o : Option ℕ) :
    PreparationVacuumUncutYukawa.sourceContact f p F o=sourceMovingCompleteContact f p F o:=by
  rw [sourceContact_complete]
  simp only [completeContact,sourceMovingCompleteContact,sourceMovingCompleteJets_second]

def sourceMovingJointForm (p : PhysicalMomentum) (a b : QuantumTest) (h : Field289) : ℂ:=
  nativeFixedIntegral h a b 1+sourceMovingCoframeIntegral h a b 1+fixedFiber (diagonalFiber p) h a b 1

theorem sourceMovingJointForm_near (p : PhysicalMomentum) (a b : QuantumTest) :
    sourceMovingJointForm p a b=ᶠ[𝓝 0] jointForm p a b:=by
  have near : ∀ᶠh : Field289 in 𝓝 0,‖h‖<jointRadius a:=
    continuous_norm.continuousAt.eventually (gt_mem_nhds (by simpa using jointRadius_positive a))
  filter_upwards [near] with h small
  change nativeFixedIntegral h a b 1+sourceMovingCoframeIntegral h a b 1+fixedFiber (diagonalFiber p) h a b 1=
    nativeFixedIntegral h a b 1+coframeFixedIntegral h a b 1+fixedFiber (diagonalFiber p) h a b 1
  congr 2
  apply MeasureTheory.integral_congr_ae
  apply Filter.Eventually.of_forall
  intro z
  by_cases inside : z∈tsupport a
  · have moved:=jointRadius_valid a h z small.le inside
    rw [←jointCurve_original] at moved
    exact sourceMovingCoframeSample_actual h a b (1,z) (a.tsupport_subset inside) moved
  · change sourceMovingCoframeSample h a b (1,z)=coframeFixedSample h a b (1,z)
    rw [sourceMovingCoframeSample_zero h a b 1 z inside,coframeFixedSample_zero h a b 1 z inside]

theorem sourceMovingJointForm_C2 (p : PhysicalMomentum) (a b : QuantumTest) :
    ContDiffAt ℝ 2 (sourceMovingJointForm p a b) 0:=
  (jointForm_C2 p a b).congr_of_eventuallyEq (sourceMovingJointForm_near p a b)

theorem sourceMovingJointForm_first (p : PhysicalMomentum) (a b : QuantumTest) (f : Field289) :
    fderiv ℝ (sourceMovingJointForm p a b) 0 f=fderiv ℝ (jointForm p a b) 0 f:=by
  rw [(sourceMovingJointForm_near p a b).fderiv_eq]

theorem sourceMovingJointForm_mixed (p : PhysicalMomentum) (a b : QuantumTest) (f g : Field289) :
    fderiv ℝ (fderiv ℝ (sourceMovingJointForm p a b)) 0 f g=
      fderiv ℝ (fderiv ℝ (jointForm p a b)) 0 f g:=by
  rw [((sourceMovingJointForm_near p a b).fderiv).fderiv_eq]

def sourceMovingJointCompression (p : PhysicalMomentum)
    (F : PreparationVacuumSpatialDensityTransport.Index) (h : Field289) : H→L[ℂ] H:=
  sourceAssembly p F (fun i j=>sourceMovingJointForm p (bareTest p F i) (bareTest p F j) h)

theorem sourceMovingJointCompression_near (p : PhysicalMomentum)
    (F : PreparationVacuumSpatialDensityTransport.Index) :
    sourceMovingJointCompression p F=ᶠ[𝓝 0] jointCompression p F:=by
  have all:=Filter.eventually_all.mpr (fun i=>Filter.eventually_all.mpr
    (fun j=>sourceMovingJointForm_near p (bareTest p F i) (bareTest p F j)))
  filter_upwards [all] with h hh
  exact congrArg (sourceAssembly p F) (funext (fun i=>funext (fun j=>hh i j)))

attribute [local irreducible] sourceMovingJointCompression jointCompression

theorem sourceMovingJointCompression_first (p : PhysicalMomentum)
    (F : PreparationVacuumSpatialDensityTransport.Index) (f : Field289) :
    fderiv ℝ (sourceMovingJointCompression p F) 0 f=fderiv ℝ (jointCompression p F) 0 f:=by
  rw [(sourceMovingJointCompression_near p F).fderiv_eq]

theorem sourceMovingJointCompression_mixed (p : PhysicalMomentum)
    (F : PreparationVacuumSpatialDensityTransport.Index) (f g : Field289) :
    fderiv ℝ (fderiv ℝ (sourceMovingJointCompression p F)) 0 f g=
      fderiv ℝ (fderiv ℝ (jointCompression p F)) 0 f g:=by
  exact congrArg (fun D : Field289→L[ℝ] (Field289→L[ℝ] (H→L[ℂ] H))=>D f g)
    (((sourceMovingJointCompression_near p F).fderiv (𝕜:=ℝ)).fderiv_eq (𝕜:=ℝ))

end LowEnergy.PreparationVacuumMovingNoetherReturn
