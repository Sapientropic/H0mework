import H0mework.Versions.AD.Physics.LowEnergy.Quantum.SourceClockYukawaQ8RadiusBudget
import H0mework.Versions.AD.Physics.LowEnergy.Quantum.SourceCurrentEndpointEnergy

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1500000
set_option maxRecDepth 2048
noncomputable section
namespace LowEnergy.SourceClockRadiusResponseFinite
open GaussCoreHilbert GaussCoreDifferential GaussFockPair GaussNativeForm GaussHistoryHilbert GaussDiagonalHistory GaussUnitaryHistory
open GaussYukawaCoefficient GaussYukawaOperator GaussQuantumMultiplier SourceScalarDoubleCurrent
open GaussRadialDomain SourceMixedNativeReturn SourceScalarPositiveBulkWard
open SourceClockYukawaCubicCurrent SourceClockYukawaQ8RadiusBudget
open SourceClockYukawaRadialMixedBudget SourceRelativePowerTail
open FullYSourceResolventGraphSplice SourceResolventBandLimit MeasureTheory Filter
open scoped InnerProductSpace Topology
abbrev Op := H →L[ℂ] H

/-- The original radius on the finite input span, including its actual escape input. -/
def radiusRead (F : Index) (g : diagonal.domain) : Op := sourceRead F g radiusAction

def finiteRadiusResponse (m ell : ℕ) (F : Index) (z : ℂ) (g : diagonal.domain) : H :=
  relativeTail m ell (radiusRead F g (finiteResolvent F z (g : H))-
    finiteResolvent F z (radiusSource g : H))

private theorem core_embed (g : diagonal.domain) : embed (coreEquiv.symm g)=(g : H) :=
  congrArg Subtype.val (coreEquiv.apply_symm_apply g)

private theorem resolvent_embed (F : Index) (z : ℂ) (hz : z.im≠0) (f : QuantumTest) :
    embed (resolventCore F z hz f)=finiteResolvent F z (embed f) := by
  unfold resolventCore state
  exact core_embed _

theorem actual_radius_response_finite_read (m ell : ℕ) (F : Index) (z : ℂ)
    (hz : z.im≠0) (g : diagonal.domain) :
    embed (radiusResponseCore m ell F z hz g)=finiteRadiusResponse m ell F z g := by
  unfold radiusResponseCore finiteRadiusResponse
  rw [←theta_core]
  simp only [bracket,LinearMap.sub_apply,Module.End.mul_apply,map_sub]
  rw [resolvent_embed]
  have hr := source_read_resolvent F g radiusAction z hz
  have he : resolventCore F z hz (coreEquiv.symm g)=state F z hz g := by
    change state F z hz (coreEquiv (coreEquiv.symm g))=state F z hz g
    rw [coreEquiv.apply_symm_apply]
  rw [he]
  change radiusRead F g (finiteResolvent F z (g : H))=
    embed (radiusAction (state F z hz g)) at hr
  rw [←hr]
  rfl

/-- The current is generated by the same original graded compression and radius read. -/
def finiteRadiusCurrent (F : Index) (g : diagonal.domain) : Op :=
  GaussGradedCompression.compression F*radiusRead F g-
    radiusRead F g*GaussGradedCompression.compression F

private theorem commutator_return (C A : Op) (hC : IsSelfAdjoint C) (z : ℂ) (hz : z.im≠0) :
    FullYSourceResolventGraphSplice.resolvent C z*(C*A-A*C)*FullYSourceResolventGraphSplice.resolvent C z=A*FullYSourceResolventGraphSplice.resolvent C z-FullYSourceResolventGraphSplice.resolvent C z*A := by
  have hl := resolvent_compression C hC z hz
  have hr : C*FullYSourceResolventGraphSplice.resolvent C z=1+z • FullYSourceResolventGraphSplice.resolvent C z := by
    have h := resolvent_right C hC z hz
    simp only [sub_mul,smul_mul_assoc,one_mul] at h
    exact sub_eq_iff_eq_add.mp h
  calc
    _=(FullYSourceResolventGraphSplice.resolvent C z*C)*A*FullYSourceResolventGraphSplice.resolvent C z-
        FullYSourceResolventGraphSplice.resolvent C z*A*(C*FullYSourceResolventGraphSplice.resolvent C z) := by noncomm_ring
    _=_ := by
      rw [hl,hr]
      simp only [add_mul,mul_add,one_mul,mul_one,smul_mul_assoc,mul_smul_comm,mul_assoc]
      abel

theorem actual_radius_response_corrected_current (m ell : ℕ) (F : Index) (z : ℂ)
    (hz : z.im≠0) (g : diagonal.domain) :
    embed (radiusResponseCore m ell F z hz g)=relativeTail m ell
      (finiteResolvent F z (finiteRadiusCurrent F g (finiteResolvent F z (g : H)))) := by
  rw [actual_radius_response_finite_read]
  have h := congrArg (fun A : Op => A (g : H))
    (commutator_return (GaussGradedCompression.compression F) (radiusRead F g)
      (GaussGradedCompression.compression_selfAdjoint F) z hz)
  change finiteResolvent F z (finiteRadiusCurrent F g (finiteResolvent F z (g : H)))=
    radiusRead F g (finiteResolvent F z (g : H))-finiteResolvent F z (radiusRead F g (g : H)) at h
  have hg : radiusRead F g (g : H)=(radiusSource g : H) :=
    SourceCurrentEndpointEnergy.source_read_input F g radiusAction
  rw [hg] at h
  exact congrArg (relativeTail m ell) h.symm

private theorem resolvent_memLp (F : Index) (μ : ℝ) (hμ : 0<μ) (g : H) :
    MemLp (fun w : ℝ => finiteResolvent F (line μ w) g) 2 := by
  let : SecondCountableTopologyEither ℝ H := ⟨Or.inl inferInstance⟩
  have hc : Continuous (fun w : ℝ => finiteResolvent F (line μ w) g) :=
    (SourceRetardedBandCurrent.finite_frequency_continuous μ hμ F).clm_apply continuous_const
  apply (memLp_two_iff_integrable_sq_norm hc.aestronglyMeasurable).mpr
  simpa only [line,mul_comm (μ : ℂ) Complex.I] using!
    SourceActualResolventEnergy.actual_square_integrable F μ hμ g

theorem actual_radius_response_memLp (m ell : ℕ) (F : Index) (μ : ℝ)
    (hμ : 0<μ) (g : diagonal.domain) :
    MemLp (fun w : ℝ => embed (radiusResponseCore m ell F (line μ w)
      (by simpa only [line_im] using hμ.ne') g)) 2 := by
  simp_rw [actual_radius_response_finite_read]
  unfold finiteRadiusResponse
  have hr := (radiusRead F g).comp_memLp' (resolvent_memLp F μ hμ (g : H))
  have hs := resolvent_memLp F μ hμ (radiusSource g : H)
  simpa only [Function.comp_apply] using! (relativeTail m ell).comp_memLp' (hr.sub hs)

theorem actual_radius_response_budget_finite (m ell : ℕ) (F : Index) (μ : ℝ)
    (hμ : 0<μ) (g : diagonal.domain) : radiusResponseBudget m ell F μ hμ g≠⊤ := by
  have h := actual_radius_response_memLp m ell F μ hμ g
  have hi := ((memLp_two_iff_integrable_sq_norm h.aestronglyMeasurable).mp h).const_mul μ
  unfold radiusResponseBudget
  rw [←ofReal_integral_eq_lintegral_ofReal hi
    (Eventually.of_forall (fun _ => mul_nonneg hμ.le (sq_nonneg _)))]
  exact ENNReal.ofReal_ne_top

end LowEnergy.SourceClockRadiusResponseFinite
