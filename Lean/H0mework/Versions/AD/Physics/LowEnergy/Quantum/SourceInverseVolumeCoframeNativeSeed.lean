import H0mework.Versions.AD.Physics.LowEnergy.Quantum.SourceInverseVolumeDefectCurrentResponse

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency true
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 1800000
noncomputable section
namespace LowEnergy.SourceInverseCoframeNativeSeed
open GaussCoreHilbert GaussCoreDifferential GaussFockPair GaussDiagonalHistory GaussUnitaryHistory
open SourceJointScaleBudget SourceEscapeCurrent SourceMixedNativeReturn SourceRetardedIncrement SourceGaugeCoframeJets SourceInverseCoframeCompressionBudget
open SourceInverseCoframeSpectralReturn SourceInverseDefectCurrentResponse SourceScalarPositiveBulkWard
open SourceJointResidualEnergy FullYSourceResolventGraphSplice SourceResolventBandLimit Filter
open scoped InnerProductSpace
abbrev End := QuantumTest →ₗ[ℂ] QuantumTest
attribute [local irreducible] sourceRead coreRead state coefficient decode coframeCoefficient

private theorem read_same_support (F : Index) (seed seed' : diagonal.domain) (A : End) (x : H)
    (hx : x∈supportSpan F) : sourceRead F seed A x=sourceRead F seed' A x := by
  have hp := (inputSpan F seed).orthogonalProjectionOnto_mem_subspace_eq_self ⟨x,Submodule.mem_sup_left hx⟩
  have hp' := (inputSpan F seed').orthogonalProjectionOnto_mem_subspace_eq_self ⟨x,Submodule.mem_sup_left hx⟩
  let a := Submodule.inclusion (input_span_core F seed) ((inputSpan F seed).orthogonalProjectionOnto x)
  let b := Submodule.inclusion (input_span_core F seed') ((inputSpan F seed').orthogonalProjectionOnto x)
  have ha : (a : H)=x := congrArg Subtype.val hp
  have hb : (b : H)=x := congrArg Subtype.val hp'
  have he : a=b := Subtype.ext (ha.trans hb.symm)
  unfold sourceRead coreRead
  exact congrArg (fun q : diagonal.domain => embed (A (coreEquiv.symm q))) he

private theorem channel_support (F : Index) (i : Channel F) (x : H) (hx : x∈supportSpan F) :
    channel F i x∈supportSpan F := by
  cases i with
  | none =>
    have hp : supportProjection F x=x := congrArg Subtype.val
      ((supportSpan F).orthogonalProjectionOnto_mem_subspace_eq_self ⟨x,hx⟩)
    change (1-supportProjection F) x∈supportSpan F
    rw [sub_apply,one_apply_eq_self,hp,sub_self]
    exact (supportSpan F).zero_mem
  | some i => exact (supportSpan F).smul_mem _ ((sourceBasis F i).property)

private theorem coefficient_same_seed (F : Index) (seed : diagonal.domain) (A : End) (f k : QuantumTest)
    (hf : embed f∈supportSpan F) :
    coefficient F (sourceRead F seed A) (embed f) (embed k)=
      coefficient F (sourceRead F (coreEquiv f) A) (embed f) (embed k) := by
  funext ij
  unfold coefficient spectralLeg
  rw [read_same_support F seed (coreEquiv f) A _ (channel_support F ij.2 (embed f) hf)]

/-- Each fixed coframe leaf uses the reader generated by its own differentiated source. -/
def nativeCoefficient (F : Index) (A : End) : QuantumTest → QuantumTest → ℕ → Coeff F
  | f,k,0 => coefficient F (sourceRead F (coreEquiv f) A) (embed f) (embed k)
  | f,k,n+1 => -nativeCoefficient F A (K f) k n-nativeCoefficient F A f (K k) n

/-- One finite source-prefix event precedes every insertion, left source, and reader seed. -/
theorem actual_coframe_native_seed (n : ℕ) (f : QuantumTest) :
    ∀ᶠ F in (sourceFilter : Filter Index),∀ (seed : diagonal.domain) (A : End) (k : QuantumTest),
      coframeCoefficient F seed A f k n=nativeCoefficient F A f k n := by
  induction n generalizing f with
  | zero =>
    filter_upwards [source_eventually_mem_support (coreEquiv f)] with F hF seed A k
    simpa only [coframeCoefficient,nativeCoefficient] using coefficient_same_seed F seed A f k hF
  | succ n ih =>
    filter_upwards [ih (K f),ih f] with F hK hF seed A k
    simp only [coframeCoefficient,nativeCoefficient,hK,hF]

/-- Native current evaluation keeps the actual advanced/retarded source legs at every leaf. -/
def nativeResponse (F : Index) (z : ℂ) (hz : z.im≠0) (A : End) : QuantumTest → QuantumTest → ℕ → ℂ
  | f,k,0 => sourcePair (state F (star z) (by simpa only [Complex.star_def,Complex.conj_im,neg_ne_zero] using hz) (coreEquiv k))
      (A (state F z hz (coreEquiv f)))
  | f,k,n+1 => -nativeResponse F z hz A (K f) k n-nativeResponse F z hz A f (K k) n

theorem actual_native_decode (F : Index) (μ : ℝ) (hμ : 0<μ) (w : ℝ) (A : End) (n : ℕ) (f k : QuantumTest) :
    nativeResponse F (line μ w) (by simpa only [line_im] using hμ.ne') A f k n=
      decode F μ w (nativeCoefficient F A f k n) := by
  induction n generalizing f k with
  | zero =>
    have hp := actual_read_pair F (line μ w) (by simpa only [line_im] using hμ.ne') (coreEquiv f) (coreEquiv k) A
    exact hp.symm.trans (actual_decode F μ hμ w _ (embed f) (embed k))
  | succ n ih =>
    simp only [nativeResponse,nativeCoefficient,map_sub,map_neg,ih]

/-- The original fixed-seed coframe response is the actual differentiated-source current on that same F event. -/
theorem actual_native_current_return (n : ℕ) (f : QuantumTest) :
    ∀ᶠ F in (sourceFilter : Filter Index),∀ (seed : diagonal.domain) (A : End) (μ : ℝ) (hμ : 0<μ)
      (w : ℝ) (k : QuantumTest),
      coframeProfile F seed (line μ w) A f k n 0=
        nativeResponse F (line μ w) (by simpa only [line_im] using hμ.ne') A f k n := by
  filter_upwards [actual_coframe_native_seed n f] with F hF seed A μ hμ w k
  rw [actual_coframe_decode F seed A μ hμ w n f k,hF seed A k,actual_native_decode F μ hμ w A n f k]

end LowEnergy.SourceInverseCoframeNativeSeed
