noncomputable section

private theorem rawJointShift_generatorStage
    {current : Current}
    (occurrence :
      CanonicalUnitArithmeticRoot.source.toRootSource.actual.OccurrenceAt current)
    (stage : Nat) :
    (runtimeJointRawHistoryAt occurrence).generatorStage stage ≤
      ((runtimeJointRawHistoryAt occurrence).generatorStage (stage + 1)).comap
        rawJointShiftLinear := by
  intro value membership
  change rawJointShiftLinear value ∈
    (runtimeJointRawHistoryAt occurrence).generatorStage (stage + 1)
  change rawJointShiftLinear value ∈
    Finsupp.supported ℤ ℤ
      ((runtimeJointRawHistoryAt occurrence).generatorSupport (stage + 1) :
        Set RuntimeJointRelationGenerator)
  change (value.support : Set RuntimeJointRelationGenerator) ⊆
    (runtimeJointRawHistoryAt occurrence).generatorSupport stage at membership
  change ((rawJointShiftLinear value).support :
      Set RuntimeJointRelationGenerator) ⊆
    (runtimeJointRawHistoryAt occurrence).generatorSupport (stage + 1)
  intro generator generator_mem
  rw [rawJointShiftLinear_apply] at generator_mem
  have support_subset := Finsupp.mapDomain_support
    (f := runtimeJointShiftGenerator) (s := value)
  obtain ⟨source, source_mem, source_eq⟩ :=
    Finset.mem_image.mp (support_subset generator_mem)
  subst generator
  apply rawJointShift_generatorSupport occurrence stage source
  exact membership source_mem

-- Direct source-language mouth, before any completion factorization.
theorem rawJointShift_relationClosure
    {current : Current}
    (occurrence :
      CanonicalUnitArithmeticRoot.source.toRootSource.actual.OccurrenceAt current) :
    (runtimeJointRawHistoryAt occurrence).relationClosure ≤
      Submodule.comap rawJointShiftLinear
        (runtimeJointRawHistoryAt occurrence).relationClosure := by
  apply iSup_le
  intro stage
  apply Submodule.span_le.mpr
  intro relation relation_event
  have shifted := rawJointShiftEvent_observed occurrence stage
    (.relation relation) relation_event
  change runtimeJointShiftRelation relation ∈
    (runtimeJointRawHistoryAt occurrence).relationClosure
  apply (runtimeJointRawHistoryAt occurrence).relationStage_le_closure (stage + 1)
  exact Submodule.subset_span shifted

theorem rawJointShift_generatorClosure
    {current : Current}
    (occurrence :
      CanonicalUnitArithmeticRoot.source.toRootSource.actual.OccurrenceAt current) :
    (runtimeJointRawHistoryAt occurrence).generatorClosure ≤
      Submodule.comap rawJointShiftLinear
        (runtimeJointRawHistoryAt occurrence).generatorClosure := by
  apply iSup_le
  intro stage value membership
  exact (runtimeJointRawHistoryAt occurrence).generatorStage_le_closure
    (stage + 1) (rawJointShift_generatorStage occurrence stage membership)

/-- The source shift is an actual linear action on this occurrence's
generated free carrier. -/
def rawJointShiftOnGeneratorClosure
    {current : Current}
    (occurrence :
      CanonicalUnitArithmeticRoot.source.toRootSource.actual.OccurrenceAt current) :
    (runtimeJointRawHistoryAt occurrence).generatorClosure →ₗ[ℤ]
      (runtimeJointRawHistoryAt occurrence).generatorClosure where
  toFun value := ⟨rawJointShiftLinear value,
    rawJointShift_generatorClosure occurrence value.property⟩
  map_add' left right := by
    apply Subtype.ext
    simp only [Submodule.coe_add, map_add]
  map_smul' coefficient value := by
    apply Subtype.ext
    simp only [Submodule.coe_smul, map_smul, RingHom.id_apply]

@[simp] theorem rawJointShiftOnGeneratorClosure_apply
    {current : Current}
    (occurrence :
      CanonicalUnitArithmeticRoot.source.toRootSource.actual.OccurrenceAt current)
    (value : (runtimeJointRawHistoryAt occurrence).generatorClosure) :
    ((rawJointShiftOnGeneratorClosure occurrence value :
      (runtimeJointRawHistoryAt occurrence).generatorClosure) :
        RuntimeJointRelationGenerator →₀ ℤ) =
      runtimeJointShiftRelation value :=
  rfl

/-- The relation law is generated by the same seven-row actual trace. -/
theorem rawJointShift_relationInClosure
    {current : Current}
    (occurrence :
      CanonicalUnitArithmeticRoot.source.toRootSource.actual.OccurrenceAt current) :
    (runtimeJointRawHistoryAt occurrence).relationInGeneratorClosure ≤
      ((runtimeJointRawHistoryAt occurrence).relationInGeneratorClosure).comap
        (rawJointShiftOnGeneratorClosure occurrence) := by
  intro relation relation_mem
  exact rawJointShift_relationClosure occurrence relation_mem

def rawJointShiftOnCompletion
    {current : Current}
    (occurrence :
      CanonicalUnitArithmeticRoot.source.toRootSource.actual.OccurrenceAt current) :
    (runtimeJointRawHistoryAt occurrence).CompletionCarrier →ₗ[ℤ]
      (runtimeJointRawHistoryAt occurrence).CompletionCarrier :=
  (runtimeJointRawHistoryAt occurrence).relationInGeneratorClosure.liftQ
    ((runtimeJointRawHistoryAt occurrence).completionProjection.comp
      (rawJointShiftOnGeneratorClosure occurrence))
    (by
      intro relation relation_mem
      rw [LinearMap.mem_ker]
      apply (Submodule.Quotient.mk_eq_zero
        (runtimeJointRawHistoryAt occurrence).relationInGeneratorClosure).2
      exact rawJointShift_relationInClosure occurrence relation_mem)

theorem rawJointShiftOnCompletion_projection
    {current : Current}
    (occurrence :
      CanonicalUnitArithmeticRoot.source.toRootSource.actual.OccurrenceAt current)
    (value : (runtimeJointRawHistoryAt occurrence).generatorClosure) :
    rawJointShiftOnCompletion occurrence
        ((runtimeJointRawHistoryAt occurrence).completionProjection value) =
      (runtimeJointRawHistoryAt occurrence).completionProjection
        (rawJointShiftOnGeneratorClosure occurrence value) := by
  exact Submodule.liftQ_apply _ _ _

theorem rawJointShift_seven_relations (stage : Nat) :
    rawJointShiftLinear (runtimeJointIncidenceStageRelation stage) =
        runtimeJointIncidenceStageRelation (stage + 1) ∧
      rawJointShiftLinear (runtimeJointSourceBoundaryStageRelation stage) =
        runtimeJointSourceBoundaryStageRelation (stage + 1) ∧
      rawJointShiftLinear (runtimeJointQuarterIncidenceStageRelation stage) =
        runtimeJointQuarterIncidenceStageRelation (stage + 1) ∧
      rawJointShiftLinear (runtimeJointQuarterSourceBoundaryStageRelation stage) =
        runtimeJointQuarterSourceBoundaryStageRelation (stage + 1) ∧
      rawJointShiftLinear (runtimeJointQuarterBoundaryEnergyStageRelation stage) =
        runtimeJointQuarterBoundaryEnergyStageRelation (stage + 1) ∧
      rawJointShiftLinear (runtimeJointQuarterBalanceStageRelation stage) =
        runtimeJointQuarterBalanceStageRelation (stage + 1) ∧
      rawJointShiftLinear (runtimeJointBalanceStageRelation stage) =
        runtimeJointBalanceStageRelation (stage + 1) := by
  simp only [rawJointShiftLinear_apply, runtimeJointShiftRelation_incidence,
    runtimeJointShiftRelation_sourceBoundary,
    runtimeJointShiftRelation_quarterIncidence,
    runtimeJointShiftRelation_quarterSourceBoundary,
    runtimeJointShiftRelation_quarterBoundaryEnergy,
    runtimeJointShiftRelation_quarterBalance,
    runtimeJointShiftRelation_balance, and_self]

private theorem rawJointPhase_mem_generatorSupport
    {current : Current}
    (occurrence :
      CanonicalUnitArithmeticRoot.source.toRootSource.actual.OccurrenceAt current)
    (stage : Nat) :
    (currentEffectStage current + stage, RuntimeJointRelationRole.phase) ∈
      (runtimeJointRawHistoryAt occurrence).generatorSupport stage := by
  classical
  simp only [RootGeneratedCofinalHistoryAt.generatorSupport,
    List.mem_toFinset, List.mem_flatMap, Finset.mem_toList]
  refine ⟨runtimeJointBalancePresentedEvent (currentEffectStage current + stage),
    ?_, ?_⟩
  · unfold RootGeneratedCofinalHistoryAt.observedEvents
    apply List.mem_flatMap.mpr
    refine ⟨stage, by simp, ?_⟩
    apply rawJointObservation_currentSeed_trace_subset occurrence stage
    rw [runtimeJointRelationSeedAt_trace]
    simp
  · change (currentEffectStage current + stage, RuntimeJointRelationRole.phase) ∈
      (runtimeJointBalanceStageRelation (currentEffectStage current + stage)).support
    simp [runtimeJointBalanceStageRelation, runtimeJointRelationAtom,
      Finsupp.mem_support_iff]

def rawJointPhaseGenerator
    {current : Current}
    (occurrence :
      CanonicalUnitArithmeticRoot.source.toRootSource.actual.OccurrenceAt current)
    (stage : Nat) :
    (runtimeJointRawHistoryAt occurrence).generatorClosure :=
  ⟨runtimeJointRelationAtom (currentEffectStage current + stage) .phase,
    (runtimeJointRawHistoryAt occurrence).generatorStage_le_closure stage <|
      by
        change runtimeJointRelationAtom
          (currentEffectStage current + stage) .phase ∈
          Finsupp.supported ℤ ℤ
            ((runtimeJointRawHistoryAt occurrence).generatorSupport stage :
              Set RuntimeJointRelationGenerator)
        rw [Finsupp.mem_supported]
        intro generator generator_mem
        have eq : generator =
            (currentEffectStage current + stage, RuntimeJointRelationRole.phase) := by
          simpa [runtimeJointRelationAtom] using generator_mem
        subst generator
        exact rawJointPhase_mem_generatorSupport occurrence stage⟩

theorem rawJointShift_phase_generator
    {current : Current}
    (occurrence :
      CanonicalUnitArithmeticRoot.source.toRootSource.actual.OccurrenceAt current)
    (stage : Nat) :
    rawJointShiftOnGeneratorClosure occurrence
        (rawJointPhaseGenerator occurrence stage) =
      rawJointPhaseGenerator occurrence (stage + 1) := by
  apply Subtype.ext
  change runtimeJointShiftRelation
      (runtimeJointRelationAtom (currentEffectStage current + stage) .phase) =
    runtimeJointRelationAtom (currentEffectStage current + (stage + 1)) .phase
  simpa only [Nat.add_succ] using
    runtimeJointShiftRelation_atom
      (currentEffectStage current + stage) .phase

theorem rawJointShift_phase_completion
    {current : Current}
    (occurrence :
      CanonicalUnitArithmeticRoot.source.toRootSource.actual.OccurrenceAt current)
    (stage : Nat) :
    rawJointShiftOnCompletion occurrence
        ((runtimeJointRawHistoryAt occurrence).completionProjection
          (rawJointPhaseGenerator occurrence stage)) =
      (runtimeJointRawHistoryAt occurrence).completionProjection
        (rawJointPhaseGenerator occurrence (stage + 1)) := by
  rw [rawJointShiftOnCompletion_projection,
    rawJointShift_phase_generator]

end
