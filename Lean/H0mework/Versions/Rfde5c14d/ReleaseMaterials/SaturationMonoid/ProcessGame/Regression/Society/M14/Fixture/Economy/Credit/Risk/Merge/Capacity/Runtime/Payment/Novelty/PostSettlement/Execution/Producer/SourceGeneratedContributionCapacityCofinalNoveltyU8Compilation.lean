import H0mework.Versions.Rfde5c14d.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Fixture.Economy.Credit.Risk.Merge.Capacity.Runtime.Payment.Novelty.PostSettlement.Revision.Producer.SourceGeneratedContributionCapacityCofinalNoveltyU8Revision
import H0mework.Versions.Rfde5c14d.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M9.JointRoot.ProofCarryingRenewalInquiryRuntime

/-!
# Exact-visit U8 compilation generated by cofinal novelty

The right paid replay fixes an external M9 temporal visit.  At that exact
occurrence the already installed inquiry projection compiles the existing
visit-indexed U8 core.  The execution token below stores no compiler output;
its source program recomputes `.requiresU8` from the exact root event, and the
root compilation face certifies that this output was installed before the
engine reads it.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceGeneratedContributionCapacityCofinalNoveltyU8Compilation

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open ConstructiveRoot.RootInquiryCompletion
open M9ProofCarryingRenewalInquiryRoot
open M9ProofCarryingRenewalU8Failure
open M9ProofCarryingRenewalU8Revision
open M14SourceGeneratedContributionMergeActionSource
open M14SourceGeneratedContributionCapacityCofinalProductiveNovelty
open M14SourceGeneratedContributionCapacityCofinalNoveltyRootedFailure
open M14SourceGeneratedContributionCapacityCofinalNoveltyU8Revision

inductive SourceGeneratedContributionCapacityCofinalNoveltyU8CompilationAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    {novelty : SourceProductiveNoveltyAt oldVisit sourceIndex boundary}
    {rootedBridge :
      SourceGeneratedContributionCapacityCofinalNoveltyRootedFailureAt novelty}
    (revisionBridge :
      SourceGeneratedContributionCapacityCofinalNoveltyU8RevisionAt
        rootedBridge) : Type 31
  | private generated

def sourceGeneratedContributionCapacityCofinalNoveltyU8CompilationAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    {novelty : SourceProductiveNoveltyAt oldVisit sourceIndex boundary}
    {rootedBridge :
      SourceGeneratedContributionCapacityCofinalNoveltyRootedFailureAt novelty}
    (revisionBridge :
      SourceGeneratedContributionCapacityCofinalNoveltyU8RevisionAt
        rootedBridge) :
    SourceGeneratedContributionCapacityCofinalNoveltyU8CompilationAt
      revisionBridge :=
  .generated

namespace SourceGeneratedContributionCapacityCofinalNoveltyU8CompilationAt

variable {oldVisit : OldVisit} {sourceIndex boundary : Nat}
  {novelty : SourceProductiveNoveltyAt oldVisit sourceIndex boundary}
  {rootedBridge :
    SourceGeneratedContributionCapacityCofinalNoveltyRootedFailureAt novelty}
  {revisionBridge :
    SourceGeneratedContributionCapacityCofinalNoveltyU8RevisionAt rootedBridge}
  (execution :
    SourceGeneratedContributionCapacityCofinalNoveltyU8CompilationAt
      revisionBridge)

def rootVisit := by
  cases execution
  exact revisionBridge.rightRootVisit

def core :=
  by
    cases execution
    exact revisionBridge.rightCore

def compilation :
    SourceNativeInquiryCompilationAt jointRoot
      (.finite (rootVisit execution)) M9ProofCarryingRenewalU8Failure.U7
      RootInquiryU8CompletionRegression.theoryAuditCalculus
      RootInquiryU8CompletionRegression.oldTheory ()
      (inquiryEventAt (rootVisit execution)) entry
      (M9ProofCarryingRenewalU8Failure.authorityAt
        (rootVisit execution)) :=
  .requiresU8 RootInquiryU8CompletionRegression.obstruction
    RootInquiryU8CompletionRegression.u7Gate
    RootInquiryU8CompletionRegression.failure (core execution)

def compilationProgram :
    SourceNativeInquiryCompilationProgramAt jointRoot
      (.finite (rootVisit execution)) M9ProofCarryingRenewalU8Failure.U7
      RootInquiryU8CompletionRegression.theoryAuditCalculus
      RootInquiryU8CompletionRegression.oldTheory ()
      (inquiryEventAt (rootVisit execution)) entry
      (M9ProofCarryingRenewalU8Failure.authorityAt
        (rootVisit execution)) where
  compile := fun _ => compilation execution

def generatedCompilation := (compilationProgram execution).generate

def compilationFace :
    SourceNativeRootInquiryCompilationFaceCoreAt jointRoot
      (.finite (rootVisit execution)) ()
      (inquiryEventAt (rootVisit execution)) entry
      (M9ProofCarryingRenewalU8Failure.authorityAt
        (rootVisit execution))
      (generatedCompilation execution).output where
  projection := jointInquiryProjection
  active := PUnit.unit
  classifier_eq := rfl
  project_heq := by
    have outcome :=
      M9ProofCarryingRenewalInquiryRuntime.inheritedInquiryInstallation.outcome_heq
        (jointRoot.emitted (rootVisit execution).current) .inquiry
    cases outcome
    exact HEq.rfl

def inquiryState : RootInquiryStateAt
    M9ProofCarryingRenewalInquiryRoot.N
    M9ProofCarryingRenewalInquiryRoot.V where
  root := jointRoot
  visit := .finite (rootVisit execution)
  U7 := M9ProofCarryingRenewalU8Failure.U7
  calculus := RootInquiryU8CompletionRegression.theoryAuditCalculus
  Query := Unit
  entryAt := fun _ => entry
  authorityAt := fun _ =>
    M9ProofCarryingRenewalU8Failure.authorityAt (rootVisit execution)
  compilationProgramAt := fun _ => compilationProgram execution
  compilationFaceAt := fun _ => compilationFace execution
  u7RootDisposition_commutes := by
    intro _query _obstruction _audit audit_eq
    cases audit_eq
    exact theoryAuditRootDispositionCommutesAt (rootVisit execution)

def engineState := RootInquiryEngineStateAt.create (inquiryState execution)

def presentation : RootInquiryStatePresentation where
  N := M9ProofCarryingRenewalInquiryRoot.N
  V := M9ProofCarryingRenewalInquiryRoot.V
  state := engineState execution

@[simp] theorem generatedOutput_exact :
    (generatedCompilation execution).output = compilation execution :=
  rfl

theorem installedCompilation_factorizes :
    let generated := jointRoot.toAuthoritativeRoot.toLedgerRoot
      |>.generatedAtTemporalVisit (.finite (rootVisit execution))
    HEq
      (jointRoot.toAuthoritativeRoot.source.projectionLaw.project
        (compilationFace execution).projection generated.occurrence
        (compilationFace execution).active)
      (SourceNativeInquiryCompilationTokenAt.canonical
        (entry := entry) (query := ())
        (event := inquiryEventAt (rootVisit execution))
        (audit := (compilation execution).audit)
        (compilation execution).answerReadout) :=
  by
    dsimp only
    exact (compilationFace execution).project_heq

theorem exactProblemOccurrence_isRightPaymentOccurrence :
    jointRoot.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
        (.finite (rootVisit execution)) =
      (rootedBridge.rightReplay.2.futureBirth.actualExit.paymentOccurrence
        ).rootOccurrence :=
  rootedBridge.rightPaymentRootOccurrence_exact.symm

theorem compilationCore_isVisitIndexedRevision :
    core execution = revisionBridge.rightCore :=
  rfl

theorem outputContainsNoSiblingCore :
    ∀ other : SourceGeneratedInquiryCompilationAt
        (compilationProgram execution),
      other.output = (generatedCompilation execution).output :=
  fun other => other.output_eq (generatedCompilation execution)

end SourceGeneratedContributionCapacityCofinalNoveltyU8CompilationAt

theorem contributionCapacityCofinalNovelty_generatesExactU8Compilation
    (oldVisit : OldVisit) (sourceIndex : Nat) :
    ∀ boundary : Nat,
      let novelty :=
        sourceGeneratedContributionCapacitySourceProductiveNoveltyAt oldVisit
          sourceIndex boundary
      let rootedBridge :=
        sourceGeneratedContributionCapacityCofinalNoveltyRootedFailureAt
          novelty
      let revisionBridge :=
        sourceGeneratedContributionCapacityCofinalNoveltyU8RevisionAt
          rootedBridge
      Nonempty
        (SourceGeneratedContributionCapacityCofinalNoveltyU8CompilationAt
          revisionBridge) :=
  fun boundary =>
    ⟨sourceGeneratedContributionCapacityCofinalNoveltyU8CompilationAt
      (sourceGeneratedContributionCapacityCofinalNoveltyU8RevisionAt
        (sourceGeneratedContributionCapacityCofinalNoveltyRootedFailureAt
          (sourceGeneratedContributionCapacitySourceProductiveNoveltyAt
            oldVisit sourceIndex boundary)))⟩

theorem cofinalNoveltyU8Compilation_hasNoCallerCoreOrOutput
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) : True := by
  let novelty :=
    sourceGeneratedContributionCapacitySourceProductiveNoveltyAt oldVisit
      sourceIndex boundary
  let rootedBridge :=
    sourceGeneratedContributionCapacityCofinalNoveltyRootedFailureAt novelty
  let revisionBridge :=
    sourceGeneratedContributionCapacityCofinalNoveltyU8RevisionAt rootedBridge
  let execution :=
    sourceGeneratedContributionCapacityCofinalNoveltyU8CompilationAt
      revisionBridge
  fail_if_success exact execution.visit
  fail_if_success exact execution.core
  fail_if_success exact execution.output
  fail_if_success exact execution.failure
  fail_if_success exact execution.target
  fail_if_success exact execution.runtime
  fail_if_success exact execution.future
  fail_if_success exact execution.registry
  trivial

end
end M14SourceGeneratedContributionCapacityCofinalNoveltyU8Compilation
end Society
end ProcessGame
end SaturationMonoid

