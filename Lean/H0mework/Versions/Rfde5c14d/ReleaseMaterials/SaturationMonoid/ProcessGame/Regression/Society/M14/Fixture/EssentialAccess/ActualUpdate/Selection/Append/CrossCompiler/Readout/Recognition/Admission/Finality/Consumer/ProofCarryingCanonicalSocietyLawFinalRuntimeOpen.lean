import H0mework.Versions.Rfde5c14d.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Fixture.EssentialAccess.ActualUpdate.Selection.Append.CrossCompiler.Readout.Recognition.Admission.Diagonal.Consumer.ProofCarryingPlatformGateCofinalFiniteLawDiagonal

/-!
# Canonical Society: law-final and runtime-open

`LawFinalAt` means that every requested canonical step consumes the existing
actual/search grammar exhaustion, same-root whole-ledger/next seams, typed
negative controls and the exact self-U8 tick.  It does not assert that no
future breaking occurrence can happen.

`RuntimeOpenAt` means that every requested finite prefix has a strictly later
fully audited point and a literal next cycle generated by the previous step.
The two propositions are proved together: a complete rule contract does not
turn Society into a terminal state, and continuing renewal does not make the
rule contract unfinished.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14ProofCarryingCanonicalSocietyLawFinalRuntimeOpen

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Observer Renewal UniversalRootGrammar
open M14SourceGeneratedContributionMergeActionSource
open M14SourceGeneratedPostSettlementObserverFinitePaidSelfU8Iteration
open M14SourceGeneratedCycleCanonicalRootLawStep
open M14ProofCarryingFiniteCycleCanonicalRootLaw
open M14SourceGeneratedCanonicalSocietyCofinalReadout
open M14ProofCarryingCanonicalSocietyCofinalReadout
open M14ProofCarryingPlatformGateFullAdmission
open M14ProofCarryingPlatformGateCofinalFiniteLawDiagonal

/-- Exact finality contract of the root law at every finite current.  The
step and self-U8 tick are generated functions of `initial/depth`; callers do
not provide a branch, law, failure, next or verdict. -/
def CanonicalSocietyLawFinalAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) : Prop :=
  ∀ depth observerFuel,
    let step := sourceGeneratedCycleCanonicalRootLawStep initial depth
    ProofCarryingCycleCanonicalRootLawTransitionAt initial observerFuel depth
        step ∧
      ExactCanonicalSelfU8TickAt initial depth

/-- Runtime openness is pointwise and request-driven.  It stores neither an
infinite history nor a table of later points. -/
def CanonicalSocietyRuntimeOpenAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) : Prop :=
  ∀ fuel observerFuel,
    ∃ m, PlatformGateFiniteLawDiagonalPointAt initial fuel observerFuel m

def CanonicalSocietyNoFiniteTerminalAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) : Prop :=
  ∀ (fuel _observerFuel : Nat), ∃ m, fuel < m ∧
    generatedFinalNextCycleAt initial m = cycleAt initial (m + 1)

theorem canonicalSocietyLawFinalAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) :
    CanonicalSocietyLawFinalAt initial := by
  intro depth observerFuel
  let step := sourceGeneratedCycleCanonicalRootLawStep initial depth
  exact ⟨proofCarryingCycleCanonicalRootLawTransition observerFuel step,
    everyExactCanonicalSelfU8Tick initial depth⟩

theorem canonicalSocietyRuntimeOpenAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    {initial : CycleAt oldVisit sourceIndex boundary}
    (diagonal : ProofCarryingPlatformGateCofinalFiniteLawDiagonalAt initial) :
    CanonicalSocietyRuntimeOpenAt initial :=
  diagonal.everyFiniteLawPrefix

theorem canonicalSocietyRuntimeNoFiniteTerminalAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    {initial : CycleAt oldVisit sourceIndex boundary}
    (runtimeOpen : CanonicalSocietyRuntimeOpenAt initial) :
    CanonicalSocietyNoFiniteTerminalAt initial := by
  intro fuel observerFuel
  rcases runtimeOpen fuel observerFuel with ⟨m, point⟩
  exact ⟨m, point.later, point.generatedFinalNextExact⟩

structure ProofCarryingCanonicalSocietyLawFinalRuntimeOpenAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) : Prop where
  private mk ::
  platformFullAdmission : Nonempty
    (ProofCarryingPlatformGateFullAdmissionAt oldVisit sourceIndex boundary)
  cofinalFiniteLawDiagonal :
    ProofCarryingPlatformGateCofinalFiniteLawDiagonalAt initial
  lawFinal : CanonicalSocietyLawFinalAt initial
  runtimeOpen : CanonicalSocietyRuntimeOpenAt initial
  noFiniteTerminal : CanonicalSocietyNoFiniteTerminalAt initial
  lawFinalAndRuntimeOpen :
    CanonicalSocietyLawFinalAt initial ∧
      CanonicalSocietyRuntimeOpenAt initial
  sameRightReplaySeam :
    type_of% cofinalFiniteLawDiagonal.initialCycleRightReplayExact
  everyRuntimeFinalityReportEmpty :
    type_of%
      cofinalFiniteLawDiagonal.everyRuntimeFinalityReportEmpty

theorem proofCarryingCanonicalSocietyLawFinalRuntimeOpen
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) :
    ProofCarryingCanonicalSocietyLawFinalRuntimeOpenAt initial := by
  let diagonal :=
    proofCarryingPlatformGateCofinalFiniteLawDiagonal initial
  let lawFinal := canonicalSocietyLawFinalAt initial
  let runtimeOpen := canonicalSocietyRuntimeOpenAt diagonal
  let noFiniteTerminal :=
    canonicalSocietyRuntimeNoFiniteTerminalAt runtimeOpen
  exact
    { platformFullAdmission := diagonal.fullAdmission
      cofinalFiniteLawDiagonal := diagonal
      lawFinal := lawFinal
      runtimeOpen := runtimeOpen
      noFiniteTerminal := noFiniteTerminal
      lawFinalAndRuntimeOpen := ⟨lawFinal, runtimeOpen⟩
      sameRightReplaySeam := diagonal.initialCycleRightReplayExact
      everyRuntimeFinalityReportEmpty :=
        diagonal.everyRuntimeFinalityReportEmpty }

theorem canonicalSocietyLawFinal_while_runtimeOpen
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) :
    CanonicalSocietyLawFinalAt initial ∧
      CanonicalSocietyRuntimeOpenAt initial :=
  (proofCarryingCanonicalSocietyLawFinalRuntimeOpen initial
    ).lawFinalAndRuntimeOpen

theorem canonicalSocietyLawFinalRuntimeOpen_directConsumer
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) :
    ProofCarryingCanonicalSocietyLawFinalRuntimeOpenAt initial ∧
      Nonempty (ProofCarryingPlatformGateFullAdmissionAt oldVisit sourceIndex
        boundary) ∧
      CanonicalSocietyLawFinalAt initial ∧
      CanonicalSocietyRuntimeOpenAt initial ∧
      CanonicalSocietyNoFiniteTerminalAt initial ∧
      (∀ depth,
        let step := sourceGeneratedCycleCanonicalRootLawStep initial depth
        IsEmpty
          (M14SourceGeneratedCycleCanonicalRootLawStepNoGo.FinalUnrevisableRuntimeConstitutionAt
            step)) := by
  let maximum := proofCarryingCanonicalSocietyLawFinalRuntimeOpen initial
  exact ⟨maximum,
    maximum.platformFullAdmission,
    maximum.lawFinal,
    maximum.runtimeOpen,
    maximum.noFiniteTerminal,
    maximum.everyRuntimeFinalityReportEmpty⟩

end
end M14ProofCarryingCanonicalSocietyLawFinalRuntimeOpen
end Society
end ProcessGame
end SaturationMonoid

