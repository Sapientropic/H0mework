import H0mework.Versions.Rfde5c14d.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Fixture.Economy.Credit.SourceClearingBackstopCreditStanding

/-!
# M14 source-generated loss-allocation material

This zero-choice carrier fixes the exact local material from which the richer
U8 realization must be compiled: the C4 clearing-consumer death, the C5 exact
activation seed, the purchasing-power standing generated from that seed, and
the two bearers already generated by the reciprocal exchange legs.

The private constructor prevents a revised source from accepting a sibling
default, activation, standing, participant table, bearer selector, loss
weight, pool, ledger, or completed future.  A later actual event law uses this
carrier as an index; merely importing the underlying declarations is not
source provenance.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceGeneratedLossAllocationMaterial

noncomputable section

open ResponsibilityLifecycle
open Lifecycle Universal Relations Exchange Settlement Money
open Lifecycle.Universal.FixedAdapter
open Settlement.SourceOwnedSettlementCompiler
open M3FiniteExchangeFixture
open M3ExchangeSettlementPriceRegression
open M14ClearingConsumerDeath
open M14SourceGeneratedClearingBackstopActivation
open M14SourceClearingBackstopCreditStanding

/-- Exact existing bearer attached to one reciprocal exchange leg. -/
def existingLossBearerAt (leg : Leg) : Lifecycle.ActorBearer :=
  exchangeLaw.bearerOfActor
    (exactExchangeSeed.actor exchangeCompiler leg)

structure SourceGeneratedLossAllocationMaterial : Type 18 where
  private mk ::
  defaultOccurrence : SourceGeneratedClearingConsumerDeathAt partialOpenB
  defaultExact : defaultOccurrence = sourceGeneratedClearingConsumerDeath
  activationSeed : partialBResidualConsumerCompiler.ExactActivationSeed
  activationSeedExact : activationSeed =
    sourceGeneratedClearingBackstopExactSeed
  standing : PurchasingPowerStandingAt activationSeed partialZeroObserver
  standingExact : HEq standing sourceGeneratedClearingBackstopCreditStanding
  parentBearer : Lifecycle.ActorBearer
  parentBearerExact : parentBearer = partialOpenB.obligation.bearer
  childBearerAt : Leg → Lifecycle.ActorBearer
  childBearerExact : childBearerAt = existingLossBearerAt
  childBearersDistinct : childBearerAt .a ≠ childBearerAt .b

/-- Sole material producer.  It has no input mouth. -/
def sourceGeneratedLossAllocationMaterial :
    SourceGeneratedLossAllocationMaterial :=
  { defaultOccurrence := sourceGeneratedClearingConsumerDeath
    defaultExact := rfl
    activationSeed := sourceGeneratedClearingBackstopExactSeed
    activationSeedExact := rfl
    standing := sourceGeneratedClearingBackstopCreditStanding
    standingExact := HEq.rfl
    parentBearer := partialOpenB.obligation.bearer
    parentBearerExact := rfl
    childBearerAt := existingLossBearerAt
    childBearerExact := rfl
    childBearersDistinct := by
      intro equality
      change Lifecycle.ActorBearer.target Lifecycle.TargetToken.t0 =
        Lifecycle.ActorBearer.target Lifecycle.TargetToken.t1 at equality
      cases equality }

/-- Low-universe exact witness for installing the whole canonical material in
an occurrence-indexed source law.  Every field is an equality/provenance
proof about the high-universe material; no second default, standing, bearer
table, or target value is stored. -/
structure ExactSourceGeneratedLossAllocationMaterialWitness : Type where
  private mk ::
  defaultExact : sourceGeneratedLossAllocationMaterial.defaultOccurrence =
    sourceGeneratedClearingConsumerDeath
  activationSeedExact : sourceGeneratedLossAllocationMaterial.activationSeed =
    sourceGeneratedClearingBackstopExactSeed
  standingExact : HEq sourceGeneratedLossAllocationMaterial.standing
    sourceGeneratedClearingBackstopCreditStanding
  parentBearerExact : sourceGeneratedLossAllocationMaterial.parentBearer =
    partialOpenB.obligation.bearer
  childBearerExact : sourceGeneratedLossAllocationMaterial.childBearerAt =
    existingLossBearerAt
  childBearersDistinct :
    sourceGeneratedLossAllocationMaterial.childBearerAt .a ≠
      sourceGeneratedLossAllocationMaterial.childBearerAt .b

/-- Sole low-universe witness producer. -/
def exactSourceGeneratedLossAllocationMaterialWitness :
    ExactSourceGeneratedLossAllocationMaterialWitness :=
  { defaultExact := sourceGeneratedLossAllocationMaterial.defaultExact
    activationSeedExact :=
      sourceGeneratedLossAllocationMaterial.activationSeedExact
    standingExact := sourceGeneratedLossAllocationMaterial.standingExact
    parentBearerExact :=
      sourceGeneratedLossAllocationMaterial.parentBearerExact
    childBearerExact := sourceGeneratedLossAllocationMaterial.childBearerExact
    childBearersDistinct :=
      sourceGeneratedLossAllocationMaterial.childBearersDistinct }

theorem sourceGeneratedLossAllocationMaterial_exact :
    sourceGeneratedLossAllocationMaterial.defaultOccurrence =
        sourceGeneratedClearingConsumerDeath ∧
      sourceGeneratedLossAllocationMaterial.activationSeed =
        sourceGeneratedClearingBackstopExactSeed ∧
      HEq sourceGeneratedLossAllocationMaterial.standing
        sourceGeneratedClearingBackstopCreditStanding ∧
      sourceGeneratedLossAllocationMaterial.parentBearer =
        partialOpenB.obligation.bearer ∧
      sourceGeneratedLossAllocationMaterial.childBearerAt =
        existingLossBearerAt ∧
      sourceGeneratedLossAllocationMaterial.childBearerAt .a ≠
        sourceGeneratedLossAllocationMaterial.childBearerAt .b :=
  ⟨sourceGeneratedLossAllocationMaterial.defaultExact,
    sourceGeneratedLossAllocationMaterial.activationSeedExact,
    sourceGeneratedLossAllocationMaterial.standingExact,
    sourceGeneratedLossAllocationMaterial.parentBearerExact,
    sourceGeneratedLossAllocationMaterial.childBearerExact,
    sourceGeneratedLossAllocationMaterial.childBearersDistinct⟩

theorem sourceGeneratedLossAllocationMaterial_has_no_submitted_target : True := by
  let material := sourceGeneratedLossAllocationMaterial
  fail_if_success exact material.submittedDefault
  fail_if_success exact material.submittedStanding
  fail_if_success exact material.participantRegistry
  fail_if_success exact material.lossWeights
  fail_if_success exact material.riskPool
  fail_if_success exact material.ledger
  fail_if_success exact material.completedFuture
  trivial

end
end M14SourceGeneratedLossAllocationMaterial
end Society
end ProcessGame
end SaturationMonoid

#print axioms SaturationMonoid.ProcessGame.Society.M14SourceGeneratedLossAllocationMaterial.sourceGeneratedLossAllocationMaterial
#print axioms SaturationMonoid.ProcessGame.Society.M14SourceGeneratedLossAllocationMaterial.sourceGeneratedLossAllocationMaterial_exact
