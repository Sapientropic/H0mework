import H0mework.Versions.Rfde5c14d.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Fixture.Economy.Credit.Risk.Merge.Capacity.Renewal.Settlement.Joint.Renewal.Submission.Action.Transport.Renewal.Recurrence.Iteration.Lifecycle.Constitution.Characterization.SourceGeneratedFiniteExitCapacityLowerConstitutionCharacterization
import H0mework.Versions.Rfde5c14d.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Fixture.Economy.Credit.Risk.Merge.Capacity.Runtime.Payment.Preservation.PostSettlement.Step.Consumer.ProofCarryingContributionCapacityPostSettlementCanonicalPaidStep

/-!
# Source-generated maximal canonical paid step at one cycle

The exact Payment carried by a recursively generated cycle is fed directly
to the existing canonical paid-step producer.  Its unique target occurrence
regenerates the complete canonical current, macro future birth, every
essential-access channel, external residual consumer and the successor
cycle's full exit-capacity constitution.

The canonical specialization accepts only `initial` and a requested finite
`depth`; the general producer additionally consumes one exact source Payment
at that indexed occurrence.  The named values below are restrictions of the
existing lifecycle Payment and paid step; they store no occurrence, target,
registry, schedule or future table.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceGeneratedCycleMaximalCanonicalPaidStep

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Lifecycle Universal Relations Power Exchange Settlement Price Money UBI
open Renewal Capacity Space CrossingCost
open M14SourceGeneratedContributionMergeActionSource
open M14SourceGeneratedContributionCapacityPostSettlementExternalLiability
open M14SourceGeneratedContributionCapacityPostSettlementOccurrencePayment
open M14SourceGeneratedContributionCapacityEssentialAccessChannel
open M14ProofCarryingContributionCapacityPostSettlementChannelFamily
open M14SourceGeneratedContributionCapacityPostSettlementFutureBirth
open M14SourceGeneratedContributionCapacityPostSettlementCanonicalCurrent
open M14SourceGeneratedContributionCapacityPostSettlementCanonicalPaidStep
open M14ProofCarryingContributionCapacityPostSettlementCanonicalPaidStep
open M14SourceGeneratedPaidSuccessorBearerExerciseStandingRenewal
open M14SourceGeneratedPostSettlementObserverFinitePaidSelfU8Iteration
open M14SourceGeneratedPostSettlementObserverFinitePaidExitLifecycleStitch
open M14SourceGeneratedPostSettlementObserverFiniteExitCapacityConstitution
open M14SourceGeneratedFiniteExitCapacityLowerConstitutionCharacterization

/-- The source Payment is the Payment already carried by lifecycle stage
zero.  This definition names a restriction; it does not construct a second
Payment occurrence. -/
def cycleMaximalSourcePaymentAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    CanonicalPostSettlementOccurrencePaymentAt oldVisit sourceIndex
      (cycleLifecycleIndex initial depth) :=
  (cycleLifecycle initial depth).sourcePayment

/-- The existing canonical paid step fed by that literal Payment. -/
def cycleMaximalCanonicalPaidStepAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    SourceGeneratedContributionCapacityPostSettlementCanonicalPaidStepAt
      oldVisit sourceIndex (cycleLifecycleIndex initial depth)
        (cycleMaximalSourcePaymentAt initial depth) :=
  (cycleLifecycle initial depth).paidStep

/-- Exact target current generated by the cycle's existing paid step. -/
def cycleMaximalTargetCanonicalCurrentAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    SourceGeneratedContributionCapacityPostSettlementCanonicalCurrentAt
      oldVisit sourceIndex (cycleLifecycleIndex initial depth + 1) :=
  (cycleMaximalCanonicalPaidStepAt initial depth).targetCurrent

/-- Macro future birth regenerated from the target current on demand. -/
def cycleMaximalTargetFutureBirthAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    SourceGeneratedContributionCapacityPostSettlementFutureBirthAt oldVisit
      sourceIndex (cycleLifecycleIndex initial depth + 1) :=
  (cycleMaximalCanonicalPaidStepAt initial depth).targetFutureBirth

@[simp] theorem cycleMaximalSourcePayment_eq_cycleLifecycle
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    cycleMaximalSourcePaymentAt initial depth =
      (cycleLifecycle initial depth).sourcePayment :=
  rfl

@[simp] theorem cycleMaximalCanonicalPaidStep_eq_cycleLifecyclePaidStep
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    cycleMaximalCanonicalPaidStepAt initial depth =
      (cycleLifecycle initial depth).paidStep :=
  rfl

@[simp] theorem cycleMaximalPaidStep_sourcePayment_exact
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    (cycleMaximalCanonicalPaidStepAt initial depth).sourcePayment =
      cycleMaximalSourcePaymentAt initial depth :=
  rfl

@[simp] theorem cycleMaximalTargetCurrent_exact
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    cycleMaximalTargetCanonicalCurrentAt initial depth =
      sourceGeneratedContributionCapacityPostSettlementCanonicalCurrentAt
        oldVisit sourceIndex (cycleLifecycleIndex initial depth + 1) :=
  rfl

@[simp] theorem cycleMaximalTargetFutureBirth_exact
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    cycleMaximalTargetFutureBirthAt initial depth =
      SourceGeneratedContributionCapacityPostSettlementCanonicalCurrentAt.macroFutureBirth
        (cycleMaximalTargetCanonicalCurrentAt initial depth) :=
  rfl

@[simp] theorem cycleMaximalSourceIndex_exact
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    cycleLifecycleIndex initial depth = boundary + depth + 2 :=
  cycleLifecycleIndex_exact initial depth

@[simp] theorem cycleMaximalTargetIndex_exact
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    cycleLifecycleIndex initial depth + 1 = boundary + depth + 3 := by
  rw [cycleLifecycleIndex_exact]

@[simp] theorem cycleMaximalTargetIndex_eq_nextLifecycleIndex
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    cycleLifecycleIndex initial depth + 1 =
      cycleLifecycleIndex initial (depth + 1) := by
  rw [cycleLifecycleIndex_exact, cycleLifecycleIndex_exact]
  omega

/-- The exact source Payment lands on the target root occurrence of the very
same paid step. -/
theorem cycleMaximalNextPaidBy_isTargetCanonicalOccurrence
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    HEq (cycleMaximalSourcePaymentAt initial depth).nextPaidBy
      (cycleMaximalCanonicalPaidStepAt initial depth
        ).targetRootEvent.occurrence :=
  (cycleMaximalCanonicalPaidStepAt initial depth
    ).nextPaidBy_isTargetCanonicalOccurrence

/-- The same target occurrence is the root event of the regenerated target
canonical current. -/
theorem cycleMaximalTargetRootEvent_exact
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    (cycleMaximalCanonicalPaidStepAt initial depth).targetRootEvent =
      SourceGeneratedContributionCapacityPostSettlementCanonicalCurrentAt.rootEvent
        (cycleMaximalTargetCanonicalCurrentAt initial depth) :=
  rfl

/-- The paid-step target current is literally the source current of the next
cycle lifecycle's paid step. -/
theorem cycleMaximalTargetCurrent_isNextLifecycleSourceCurrent
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    HEq (cycleMaximalCanonicalPaidStepAt initial depth).targetCurrent
      (cycleLifecycle initial (depth + 1)).paidStep.sourceCurrent :=
  HEq.rfl

/-- The rich target Payment is the source Payment of the next lifecycle; no
Payment registry or proof-selection equality is introduced. -/
theorem cycleMaximalTargetPayment_isNextLifecycleSourcePayment
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    HEq (cycleMaximalCanonicalPaidStepAt initial depth).targetPayment
      (cycleLifecycle initial (depth + 1)).sourcePayment :=
  HEq.rfl

/-- Occurrence-level bridge from the paid-step target root event to the next
cycle lifecycle's source event. -/
theorem cycleMaximalTargetRootEvent_isNextLifecycleSourceRootEvent
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    HEq (cycleMaximalCanonicalPaidStepAt initial depth).targetRootEvent
      (cycleLifecycle initial
        (depth + 1)).sourceConsequence.outerRootEvent :=
  HEq.rfl

/-- Full occurrence chain: the source Payment's `nextPaidBy` lands on the
actual source outer occurrence of the successor constitution's lifecycle. -/
theorem cycleMaximalNextPaidBy_isNextLifecycleSourceOccurrence
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    HEq (cycleMaximalSourcePaymentAt initial depth).nextPaidBy
      (cycleLifecycle initial
        (depth + 1)).sourceConsequence.outerRootEvent.occurrence :=
  cycleMaximalNextPaidBy_isTargetCanonicalOccurrence initial depth

/-- Every installed essential-access channel is consumed again at the exact
target occurrence. -/
theorem cycleMaximalTargetEveryChannel_consumed
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    ∀ channel : EssentialAccessChannel,
      Nonempty
        (ConsumedContributionCapacityPostSettlementChannelAt oldVisit
          sourceIndex (cycleLifecycleIndex initial depth + 1) channel) :=
  fun channel =>
    ⟨(cycleMaximalCanonicalPaidStepAt initial depth).targetChannel channel⟩

/-- Target residual ownership and its root consumer are regenerated from the
target current, rather than transported as source assumptions. -/
theorem cycleMaximalTargetExternalPaymentAndConsumer_nonempty
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    Nonempty ContributionCapacityPostSettlementPaymentSourceOwnership ∧
      Nonempty
        (ContributionCapacityPostSettlementPaymentRootConsumerForExitAt
          (SourceGeneratedContributionCapacityPostSettlementCanonicalCurrentAt.actualExit
            (cycleMaximalTargetCanonicalCurrentAt initial depth))) :=
  (cycleMaximalCanonicalPaidStepAt initial depth
    ).targetExternalPaymentAndConsumer_nonempty

/-- Payment-parameterized preservation carrier.  Its first field is the
existing proof-carrying paid-step consumer for the literal caller Payment.
The carrier never equates that Payment proof with the lifecycle's canonical
proof; it only identifies their generated target authority through the
existing coherence theorem. -/
structure CycleMaximalCanonicalPaidStepForPaymentAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat)
    (payment : CanonicalPostSettlementOccurrencePaymentAt oldVisit sourceIndex
      (cycleLifecycleIndex initial depth)) : Type 28 where
  private mk ::
  consumedStep :
    ConsumedContributionCapacityPostSettlementCanonicalPaidStepAt oldVisit
      sourceIndex (cycleLifecycleIndex initial depth) payment
  sourcePaymentExact : consumedStep.2.sourcePayment = payment
  sourceIndexExact :
    cycleLifecycleIndex initial depth = boundary + depth + 2
  targetIndexExact :
    cycleLifecycleIndex initial depth + 1 = boundary + depth + 3
  targetIsNextLifecycleIndex :
    cycleLifecycleIndex initial depth + 1 =
      cycleLifecycleIndex initial (depth + 1)
  sourceConstitution : FiniteExitCapacityConstitutionAt initial depth
  paidNextExact :
    HEq consumedStep.2.sourcePayment.nextPaidBy
      (SourceGeneratedContributionCapacityPostSettlementCanonicalCurrentAt.rootEvent
        consumedStep.2.targetCurrent).occurrence
  paidNextIsNextLifecycleSource :
    HEq consumedStep.2.sourcePayment.nextPaidBy
      (cycleLifecycle initial
        (depth + 1)).sourceConsequence.outerRootEvent.occurrence
  targetCurrentCanonical :
    consumedStep.2.targetCurrent =
      sourceGeneratedContributionCapacityPostSettlementCanonicalCurrentAt
        oldVisit sourceIndex (cycleLifecycleIndex initial depth + 1)
  targetFutureBirthCanonical :
    consumedStep.2.targetFutureBirth =
      SourceGeneratedContributionCapacityPostSettlementCanonicalCurrentAt.macroFutureBirth
        consumedStep.2.targetCurrent
  targetFutureBirthRootEventExact :
    HEq consumedStep.2.targetFutureBirth.postRootEvent
      (SourceGeneratedContributionCapacityPostSettlementCanonicalCurrentAt.rootEvent
        consumedStep.2.targetCurrent)
  targetFutureBirthPaymentExact :
    HEq consumedStep.2.targetFutureBirth.postPayment
      consumedStep.2.targetPayment
  targetCurrentIsNextLifecycleSource :
    HEq consumedStep.2.targetCurrent
      (cycleLifecycle initial (depth + 1)).paidStep.sourceCurrent
  targetPaymentIsNextLifecycleSource :
    HEq consumedStep.2.targetPayment
      (cycleLifecycle initial (depth + 1)).sourcePayment
  targetRootEventIsNextLifecycleSource :
    HEq
      (SourceGeneratedContributionCapacityPostSettlementCanonicalCurrentAt.rootEvent
        consumedStep.2.targetCurrent)
      (cycleLifecycle initial
        (depth + 1)).sourceConsequence.outerRootEvent
  targetEveryChannel : ∀ channel : EssentialAccessChannel,
    Nonempty
      (ConsumedContributionCapacityPostSettlementChannelAt oldVisit
        sourceIndex (cycleLifecycleIndex initial depth + 1) channel)
  targetExternalPaymentAndConsumer :
    Nonempty ContributionCapacityPostSettlementPaymentSourceOwnership ∧
      Nonempty
        (ContributionCapacityPostSettlementPaymentRootConsumerForExitAt
          (SourceGeneratedContributionCapacityPostSettlementCanonicalCurrentAt.actualExit
            consumedStep.2.targetCurrent))
  targetConstitution :
    FiniteExitCapacityConstitutionAt initial (depth + 1)
  nextCycleExact :
    cycleAt initial (depth + 1) = (stepAt initial depth).nextCycle

/-- Every caller Payment at the exact cycle index is consumed by its own
canonical paid step and lands on the same generated successor constitution. -/
def sourceGeneratedCycleMaximalCanonicalPaidStepForPayment
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat)
    (payment : CanonicalPostSettlementOccurrencePaymentAt oldVisit sourceIndex
      (cycleLifecycleIndex initial depth)) :
    CycleMaximalCanonicalPaidStepForPaymentAt initial depth payment := by
  let consumed :=
    proofCarryingContributionCapacityPostSettlementCanonicalPaidStepAt
      oldVisit sourceIndex (cycleLifecycleIndex initial depth) payment
  exact
    { consumedStep := consumed
      sourcePaymentExact := rfl
      sourceIndexExact := cycleMaximalSourceIndex_exact initial depth
      targetIndexExact := cycleMaximalTargetIndex_exact initial depth
      targetIsNextLifecycleIndex :=
        cycleMaximalTargetIndex_eq_nextLifecycleIndex initial depth
      sourceConstitution :=
        sourceGeneratedFiniteExitCapacityConstitutionAt initial depth
      paidNextExact := consumed.2.paidNext_isTargetCanonicalOccurrence
      paidNextIsNextLifecycleSource :=
        consumed.2.paidNext_isTargetCanonicalOccurrence
      targetCurrentCanonical := rfl
      targetFutureBirthCanonical := rfl
      targetFutureBirthRootEventExact := HEq.rfl
      targetFutureBirthPaymentExact := HEq.rfl
      targetCurrentIsNextLifecycleSource := HEq.rfl
      targetPaymentIsNextLifecycleSource := HEq.rfl
      targetRootEventIsNextLifecycleSource := HEq.rfl
      targetEveryChannel := fun channel =>
        ⟨consumed.2.targetChannel channel⟩
      targetExternalPaymentAndConsumer :=
        consumed.1.targetExternalPaymentAndConsumer_nonempty
      targetConstitution :=
        sourceGeneratedFiniteExitCapacityConstitutionAt initial (depth + 1)
      nextCycleExact := cycleAt_succ initial depth }

/-- Fixed lifecycle-Payment specialization of the arbitrary-Payment carrier. -/
abbrev CycleMaximalCanonicalPaidStepPreservationAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :=
  CycleMaximalCanonicalPaidStepForPaymentAt initial depth
    (cycleMaximalSourcePaymentAt initial depth)

/-- Premise-free maximal preservation producer at the cycle's exact Payment. -/
def sourceGeneratedCycleMaximalCanonicalPaidStep
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    CycleMaximalCanonicalPaidStepPreservationAt initial depth :=
  sourceGeneratedCycleMaximalCanonicalPaidStepForPayment initial depth
    (cycleMaximalSourcePaymentAt initial depth)

/-- In the fixed specialization, the consumed input-indexed step is exactly
the paid step already carried by lifecycle stage zero. -/
theorem sourceGeneratedCycleMaximalCanonicalPaidStep_sourcePaidStepExact
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat) :
    (sourceGeneratedCycleMaximalCanonicalPaidStep initial depth
      ).consumedStep.1 = cycleMaximalCanonicalPaidStepAt initial depth :=
  rfl

/-- Public arbitrary-Payment seal.  It exposes the consumed input step and
the rich target seams, but makes no equality claim between distinct Payment
proof values. -/
theorem callerPayment_nextPaidBy_alignsCycleTarget_and_generatesConstitution
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat)
    (payment : CanonicalPostSettlementOccurrencePaymentAt oldVisit
      sourceIndex (cycleLifecycleIndex initial depth)) :
    let preserved :=
      sourceGeneratedCycleMaximalCanonicalPaidStepForPayment initial depth
        payment
    preserved.consumedStep.2.sourcePayment = payment ∧
      HEq preserved.consumedStep.2.sourcePayment.nextPaidBy
        (cycleLifecycle initial
          (depth + 1)).sourceConsequence.outerRootEvent.occurrence ∧
      HEq preserved.consumedStep.2.targetCurrent
        (cycleLifecycle initial (depth + 1)).paidStep.sourceCurrent ∧
      HEq preserved.consumedStep.2.targetPayment
        (cycleLifecycle initial (depth + 1)).sourcePayment ∧
      HEq
        (SourceGeneratedContributionCapacityPostSettlementCanonicalCurrentAt.rootEvent
          preserved.consumedStep.2.targetCurrent)
        (cycleLifecycle initial
          (depth + 1)).sourceConsequence.outerRootEvent ∧
      FiniteExitCapacityConstitutionAt initial (depth + 1) := by
  let preserved :=
    sourceGeneratedCycleMaximalCanonicalPaidStepForPayment initial depth
      payment
  exact
    ⟨preserved.sourcePaymentExact,
      preserved.paidNextIsNextLifecycleSource,
      preserved.targetCurrentIsNextLifecycleSource,
      preserved.targetPaymentIsNextLifecycleSource,
      preserved.targetRootEventIsNextLifecycleSource,
      preserved.targetConstitution⟩

end
