/-!
# No-go boundaries for registered observer-submission authority

The first two results are explicit conditional deletion diagnostics, not
countermodels to the installed instance.  The substantive boundaries are
runtime-core uniqueness, deterministic same-program material, distinct lower
executions for distinct program outputs, and the actual full-capture search's
typed rejection rather than actual-write authority.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceGeneratedPostSettlementObserverSubmissionU8

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open ConstructiveRoot.RootInquiryCompletion
open Renewal UniversalRootGrammar
open M14SourceGeneratedContributionMergeActionSource
open M14ProofCarryingUniversalObserverConsumerExhaustionRegression

universe u v w x

/-- No source projection installation means no strong source-installed face,
even if a local seed, canonical row and successor are separately visible. -/
theorem conditionalNoProjectionInstallation_deletesSourceInstalledRenewal
    (oldVisit : OldVisit) (sourceIndex boundary : Nat)
    (noInstallation : ∀ law : SourceNativeRenewalProjectionLaw
      (revisedLivingRootAt oldVisit sourceIndex boundary
        ).toAuthoritativeRoot.toLedgerRoot.source
      (localGame oldVisit sourceIndex boundary) LocalSeed
      (LocalSeedAt oldVisit sourceIndex boundary)
      (LocalConsumerAt oldVisit sourceIndex boundary)
      (LocalDispositionAt oldVisit sourceIndex boundary),
      SourceNativeProjectionLaw.InstallationAt law.toProjectionLaw
        (revisedLivingRootAt oldVisit sourceIndex boundary
          ).toAuthoritativeRoot.source.projectionLaw → False) :
    (Sigma fun recognition : SourceNativeRenewalRecognitionAt
        (revisedLivingRootAt oldVisit sourceIndex boundary)
        (localGame oldVisit sourceIndex boundary) LocalSeed
        (LocalSeedAt oldVisit sourceIndex boundary)
        (LocalConsumerAt oldVisit sourceIndex boundary)
        (LocalDispositionAt oldVisit sourceIndex boundary) =>
      Sigma fun visit : SourceNativeTemporalVisitAt
        (revisedLivingRootAt oldVisit sourceIndex boundary
          ).toAuthoritativeRoot.toLedgerRoot =>
        SourceInstalledRenewalAt recognition visit) → False :=
  noInstalledComponent_noSourceInstalledRenewal noInstallation

/-- A realization receipt cannot survive deletion of every runtime
resumption fibre at this exact depth. -/
theorem conditionalNoRuntimeResumption_deletesCofaceRealization
    (oldVisit : OldVisit) (sourceIndex boundary : Nat)
    (noResumption : ∀ {Core : Type 11} (candidate : Core),
      IsEmpty (SourceNativeInquiryRuntime.CofaceRealizationResumptionAt
        candidate (runtimeAt oldVisit sourceIndex boundary) 0)) :
    IsEmpty (SourceNativeInquiryRuntime.CofaceRealizationInstalledAt
      (failureFrontierAt oldVisit sourceIndex boundary)
      (realizationCandidateAt oldVisit sourceIndex boundary)
      (runtimeAt oldVisit sourceIndex boundary) 0) := by
  constructor
  rintro ⟨core, _certification, resumed⟩
  exact (noResumption core).false resumed

/-- The exact named tick cannot consume a sibling U8 core. -/
theorem sameRuntime_noSecondCore
    (oldVisit : OldVisit) (sourceIndex boundary : Nat)
    {Core : Type 11} {candidate : Core}
    (resumed : SourceNativeInquiryRuntime.CofaceRealizationResumptionAt
      candidate (runtimeAt oldVisit sourceIndex boundary) 0) :
    HEq candidate (generatedU8CoreAt oldVisit sourceIndex boundary) :=
  runtimeCore_unique oldVisit sourceIndex boundary resumed

/-- Later work cannot rewrite the material generated by the already fixed
canonical program at its old exact occurrence. -/
theorem canonicalProgram_noRetroactiveMaterialRewrite
    (oldVisit : OldVisit) (sourceIndex boundary : Nat)
    {candidate : SourceNativeObserverConsumerSubmissionMaterialAt
      (canonicalAttemptAt oldVisit sourceIndex boundary)}
    (candidateGenerated : SourceGeneratedObserverConsumerSubmissionAt
      (canonicalProgramAt oldVisit sourceIndex boundary) candidate) :
    candidate = .authorityCertified
      (canonicalCertificateAt oldVisit sourceIndex boundary) :=
  (SourceGeneratedObserverConsumerSubmissionAt.sameProgram_material_unique
    (canonicalSubmissionAt oldVisit sourceIndex boundary)
    candidateGenerated).symm

/-- Distinct program outputs remain distinct deterministic lower executions;
this theorem does not misreport those executions as extra ledger rows. -/
theorem differentMaterial_generatesDifferentLowerExecution
    {N : WorldRelationNetwork.{u}}
    {V : ConstructiveRoot.Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeDependentFaceFamilyRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {scenario : recognition.law.vocabulary.Scenario}
    {Visible : Type v} {Output : Type w} {ClaimedEffect : Type x}
    {attempt : SourceNativeObserverConsumerAttemptAt recognition visit scenario
      Visible Output ClaimedEffect}
    (left right : SourceNativeObserverConsumerSubmissionProgramAt attempt)
    (material_ne :
      left.compile (recognition.exactEventAt visit) ≠
        right.compile (recognition.exactEventAt visit)) :
    left.packGenerated ≠ right.packGenerated :=
  generatedSubmission_ne_of_material_ne left right material_ne

/-- The same boundary's full-capture search is explicitly rejected; it
cannot reuse the installed actual submission face. -/
theorem fullCaptureSearch_cannotActivateCanonicalAuthority
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    let index := submissionIndexAt oldVisit sourceIndex boundary
    let program := universalSocietyCertifiedRootAuthorityProgramAt
      oldVisit sourceIndex index .fullCaptureSearch
    ∃ rejection : SourceNativeObserverConsumerRejectionAt program.generate,
      (universalSocietyCompiledRootAuthorityAttemptAt oldVisit sourceIndex
        index .fullCaptureSearch).useDisposition = .rejected rejection :=
  universalSocietySearchRawAttempt_isRejected oldVisit sourceIndex
    (submissionIndexAt oldVisit sourceIndex boundary)

end
