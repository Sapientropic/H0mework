import H0mework.Versions.Rfde5c14d.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M9.JointRoot.EssentialAccess.SourceHealthCessationSuffix

/-!
# Source-generated health-cessation target root

This target representation retains the fold-generated successor mandate and
all existing economic suffix coordinates while replacing the essential-
service slot with the exact health lost-power/terminal update.  Its UBI
Payment, first whole-ledger write and macro successor are generated by the
same target root.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceGeneratedHealthCessationTargetRoot

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Lifecycle Universal Relations Power Renewal Election UBI
open M8ActualElectionMandateRenewalRegression
open M9ProofCarryingRenewalInquiryRoot
open M9SourceHealthCessationSuffix
open M14UBIExitCapacityFixture
open M14UBIProofCarryingRootRestriction
open M14EssentialAccessRelationFixture
open M14SourceMandateRenewal
open M14SourceMandateSuccession
open M14SourceGeneratedEssentialAccessCriticalAction
open M14SourceGeneratedEssentialAccessCriticalTerminal
open M14SourceHealthCessationRenewal

abbrev N := M9ProofCarryingRenewalInquiryRoot.N
abbrev V := M9ProofCarryingRenewalInquiryRoot.V

def healthCessationTargetRoot : SourceNativeLivingRootClosure N V :=
  M9SourceHealthCessationSuffix.jointRoot

def healthCessationTargetInitialVisit : SourceNativeTemporalVisitAt
    healthCessationTargetRoot.toAuthoritativeRoot.toLedgerRoot :=
  M9SourceHealthCessationSuffix.jointInitialVisit

def installedHealthCessation : SourceInstalledRenewalAt
    M9SourceHealthCessationSuffix.healthCessationRecognition
      healthCessationTargetInitialVisit :=
  SourceInstalledRenewalAt.generate PUnit.unit rfl

def installedHealthCessationConsumer :
    SourceHealthCessationConsumerAt sourceHealthCessationSeed :=
  installedHealthCessation.payload.consumer

def installedHealthCessationDisposition :
    SourceHealthCessationDispositionAt sourceHealthCessationSeed :=
  installedHealthCessation.payload.disposition

def installedSuccessorMandate : SourceInstalledRenewalAt
    M9SourceHealthCessationSuffix.mandateRecognition
      healthCessationTargetInitialVisit :=
  SourceInstalledRenewalAt.generate PUnit.unit rfl

def installedSuccessorMandateLocalFace :
    SourceMandateSuccessorRenewalFace :=
  installedSuccessorMandate.localFace
    (fun _ exactSeed =>
      lineageCompiler.controllerOf exactSeed.1.controllerSeed)
    (mandateStandingOf sourceMandateSuccessorHistory lineageCompiler)

theorem installedSuccessorMandate_factorizes :
    installedSuccessorMandate.RootAnswerAndNextFactorizes :=
  installedSuccessorMandate.rootAnswerAndNext_factorizes

def installedHealthCessationTargetUBI : SourceInstalledRenewalAt
    M9SourceHealthCessationSuffix.ubiRecognition
      healthCessationTargetInitialVisit :=
  SourceInstalledRenewalAt.generate PUnit.unit rfl

structure HealthCessationTargetSourceBackedPaymentAt : Type 3 where
  private mk ::
  installed : SourceInstalledRenewalAt
    M9SourceHealthCessationSuffix.ubiRecognition
      healthCessationTargetInitialVisit
  exactRestriction : installed.payload.consumer =
    sourceGeneratedUBIRootRestriction
  rootOccurrence : ExactTemporalCausalRootEventAt
    healthCessationTargetRoot.toAuthoritativeRoot.toLedgerRoot
      healthCessationTargetInitialVisit
  rootOccurrenceExact : rootOccurrence =
    (healthCessationTargetRoot.toAuthoritativeRoot.toLedgerRoot
      ).exactTemporalCausalEventAt healthCessationTargetInitialVisit
  paymentReceipt : SourceBackedUBIPaymentReceiptAt
    exitCapacityProgram.purchasingPowerStanding ExitFutureCode.leave
  rootFactorization : installed.RootAnswerAndNextFactorizes

def healthCessationTargetSourceBackedPaymentAt :
    HealthCessationTargetSourceBackedPaymentAt where
  installed := installedHealthCessationTargetUBI
  exactRestriction := rfl
  rootOccurrence :=
    healthCessationTargetRoot.toAuthoritativeRoot.toLedgerRoot
      |>.exactTemporalCausalEventAt healthCessationTargetInitialVisit
  rootOccurrenceExact := rfl
  paymentReceipt := SourceBackedUBIPaymentReceiptAt.generate
  rootFactorization :=
    installedHealthCessationTargetUBI.rootAnswerAndNext_factorizes

def healthCessationTargetOccurrence : ExactTemporalCausalRootEventAt
    healthCessationTargetRoot.toAuthoritativeRoot.toLedgerRoot
      healthCessationTargetInitialVisit :=
  healthCessationTargetRoot.toAuthoritativeRoot.toLedgerRoot
    |>.exactTemporalCausalEventAt healthCessationTargetInitialVisit

def healthCessationTargetInitialGenerated :
    SourceNativeTemporalVisitGeneratedEvolutionAt
      healthCessationTargetRoot.toAuthoritativeRoot.toLedgerRoot
        healthCessationTargetInitialVisit :=
  healthCessationTargetRoot.toAuthoritativeRoot.toLedgerRoot
    |>.generatedAtTemporalVisit healthCessationTargetInitialVisit

def healthCessationTargetEntry : OpenResponsibilityAt N true :=
  RootInquiryU8CompletionRegression.entry

def healthCessationTargetEntryRow :
    healthCessationTargetInitialGenerated.GeneratedEntryRowAt
      healthCessationTargetEntry :=
  (healthCessationTargetInitialGenerated.canonicalGeneratedEntryRow?
    healthCessationTargetEntry).get (by rfl)

def healthCessationTargetFirstSuccessor :
    SourceNativeLedgerGeneratedSuccessorAt
      healthCessationTargetInitialGenerated.occurrence
      healthCessationTargetInitialGenerated.wholeLedgerWriteBack :=
  (SourceNativeLedgerGeneratedSuccessorAt.ofGenerated?
    healthCessationTargetInitialGenerated.wholeLedgerWriteBack).get (by rfl)

@[simp] theorem installedHealthCessation_consumer_exact :
    installedHealthCessationConsumer = sourceHealthCessationConsumer :=
  rfl

@[simp] theorem installedHealthCessation_disposition_exact :
    installedHealthCessationDisposition = sourceHealthCessationDisposition :=
  rfl

theorem installedHealthCessation_factorizes :
    installedHealthCessation.RootAnswerAndNextFactorizes :=
  installedHealthCessation.rootAnswerAndNext_factorizes

@[simp] theorem installedHealthCessation_power_lost :
    installedHealthCessationConsumer.action.loss.power.freedomChange =
      .lost .health healthCriticalAction_sourceActionable
        healthCriticalAction_targetAbsent :=
  rfl

@[simp] theorem installedHealthCessation_phase_health :
    essentialAccessRelationCompiler.phaseStep healthRelation = .health :=
  health_phase_is_generated

@[simp] theorem installedHealthCessation_role_healthProvider :
    essentialAccessRelationCompiler.roleAt healthRelation .target =
      .healthProvider :=
  health_target_role_is_generated

@[simp] theorem installedHealthCessation_bearer_t2 :
    (criticalRelationObligation essentialAccessCriticalBearerOf .health
      ).bearer = Lifecycle.ActorBearer.target .t2 :=
  rfl

@[simp] theorem installedHealthCessation_update_exact :
    installedHealthCessationDisposition.update =
      sourceGeneratedHealthCriticalActualUpdate :=
  rfl

theorem installedHealthCessation_terminal :
    ∃ archive,
      (essentialAccessCriticalTerminalAt .health).terminal.target.slots[
          (criticalRelationSlot essentialAccessCriticalBearerOf
            .health).val]? = some (ObligationSlot.terminal archive) :=
  healthCriticalTerminal_disposition

theorem installedHealthCessation_no_reopen
    (archive : TerminalArchive Lifecycle.LifecycleVocabulary) :
    IsEmpty ((criticalRelationTerminalProcess
      essentialAccessCriticalBearerOf).ReopenEvent archive) :=
  healthCriticalTerminal_no_reopen archive

@[simp] theorem installedSuccessorMandate_face_exact :
    installedSuccessorMandateLocalFace = sourceMandateSuccessorFace :=
  rfl

@[simp] theorem installedSuccessorMandate_power_restored :
    (installedSuccessorMandateLocalFace.responsibilityConsumer.1.1
      ).freedomChange.kind = FreedomChangeKind.restored :=
  sourceMandateSuccessor_power_is_restored

theorem installedSuccessorMandate_obligation_live :
    installedSuccessorMandateLocalFace.exactDisposition.1.target.slots[
        (mandateSlot lineageCompiler
          sourceMandateSuccessorHistory.current).val]? =
      some (.live (mandateObligation lineageCompiler
        sourceMandateSuccessorHistory.current)) :=
  sourceMandateSuccessor_obligation_is_live

theorem target_has_one_healthCessation_coordinate :
    IsEmpty SecondInstalledHealthCessationCoordinate ∧
      M9SourceHealthCessationSuffix.healthCessationProjection ≠
        M9SourceHealthCessationSuffix.mandateProjection ∧
      M9SourceHealthCessationSuffix.healthCessationProjection ≠
        M9SourceHealthCessationSuffix.ubiProjection :=
  ⟨secondInstalledHealthCessationCoordinate_isEmpty,
    healthCessationProjection_distinct.1,
    healthCessationProjection_distinct.2.1⟩

end
end M14SourceGeneratedHealthCessationTargetRoot
end Society
end ProcessGame
end SaturationMonoid

