import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M10.Fixture.OccurrenceCapacityProcess
import H0mework.Versions.Rfde5c14d.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M10.Fixture.OccurrenceCapacityRootSource

/-!
# M10 occurrence-capacity renewal-root fixture

This regression fixture installs one M8 renewal projection before the root
emitter is supplied.  The projection carries the exact focal seed generated by
the three-position occurrence-capacity process.  Its root side is the existing
living-law machinery instantiated by `OccurrenceCapacityRootSource`: one
canonical row, a native self-loop whole-ledger successor, and progress budget
`2`.

Nothing here is a production root, ledger abstraction, standing registry, or
capacity compiler.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M10OccurrenceCapacityRenewalRootFixture

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Renewal Capacity
open M10OccurrenceCapacityProcessFixture
open M10OccurrenceCapacityRootSourceFixture

abbrev LocalGame := game
abbrev LocalSeed := Seed
abbrev LocalSeedAt := seedAt

abbrev LocalConsumerAt
    (_seed : SourceSeed occurrenceOf LocalSeed
      LocalSeedAt LocalGame.source) :=
  PUnit

abbrev LocalDispositionAt
    (_seed : SourceSeed occurrenceOf LocalSeed
      LocalSeedAt LocalGame.source) :=
  PUnit

/-- The sole renewal law is total on the singleton root occurrence.  Its
payload is compiled before any root visit and fixes the process focal seed,
the unique root row, and the whole-ledger successor together. -/
def renewalLaw : SourceNativeRenewalProjectionLaw
    baseAuthoritySource.restructuringSource.toLedgerSource
    LocalGame LocalSeed LocalSeedAt LocalConsumerAt LocalDispositionAt where
  ActiveAt := fun {_current} _occurrence => PUnit
  InactiveAt := fun {_current} _occurrence => PEmpty
  classify := fun {_current} _occurrence => .inl PUnit.unit
  compile := by
    intro current occurrence _active
    cases current
    rcases occurrence with ⟨support, event⟩
    cases support
    cases event
    exact RootRestrictedRenewalPayloadAt.generate
      focalSeed PUnit.unit PUnit.unit entry sourceRow successor
  sourceSeed_reflects_rootOccurrence := by
    intro leftCurrent rightCurrent leftOccurrence rightOccurrence
      _leftActive _rightActive _seedEq
    cases leftCurrent
    cases rightCurrent
    rcases leftOccurrence with ⟨leftSupport, leftEvent⟩
    rcases rightOccurrence with ⟨rightSupport, rightEvent⟩
    cases leftSupport
    cases rightSupport
    cases leftEvent
    cases rightEvent
    rfl

/-- Complete pre-emitter source identity with the renewal coordinate already
installed. -/
def authoritySource : SourceNativeAuthoritySource N V :=
  withRenewalProjection baseAuthoritySource renewalLaw

/-- Regression-only living root over the same singleton event/ledger source. -/
def root : SourceNativeLivingRootClosure N V where
  source :=
    { base := authoritySource
      terminalHandoff := authoritySource.emptyFaithfulTerminalHandoff
        (fun _ => ⟨fun terminal => nomatch terminal⟩) }
  emitted := emitted
  compiler_commutes := fun _ => rfl

def visit : SourceNativeTemporalVisitAt
    root.toAuthoritativeRoot.toLedgerRoot :=
  .finite root.toAuthoritativeRoot.toRoot.initialVisit

def installation : SourceNativeProjectionLaw.InstallationAt
    renewalLaw.toProjectionLaw
  root.toAuthoritativeRoot.source.projectionLaw :=
  renewalComponent baseAuthoritySource renewalLaw

def recognition : SourceNativeRenewalRecognitionAt root LocalGame LocalSeed
    LocalSeedAt LocalConsumerAt LocalDispositionAt where
  law := renewalLaw
  installation := installation

/-- Zero-choice installed renewal read from the source classifier at the exact
initial visit. -/
def installedRenewal : SourceInstalledRenewalAt recognition visit :=
  SourceInstalledRenewalAt.generate PUnit.unit rfl

@[simp] theorem installed_focalSeed_eq :
    installedRenewal.payload.sourceSeed = focalSeed :=
  rfl

@[simp] theorem installed_sourceEntry_eq :
    installedRenewal.payload.sourceEntry = entry :=
  rfl

@[simp] theorem installed_selectedRow_eq :
    installedRenewal.payload.selectedRow = sourceRow :=
  rfl

@[simp] theorem installed_successor_eq :
    installedRenewal.payload.successor = successor :=
  rfl

/-- The operational row is the canonical temporal selector read from this
same complete patch, not a caller-supplied row. -/
theorem operational_row_is_temporal_selected_row :
    installedRenewal.operationalAuthority.exactEventMembership =
      installedRenewal.temporalSelectedRow :=
  rfl

/-- The generated standing is the target of the one-row self-loop. -/
@[simp] theorem operationalStanding_eq_entry :
    installedRenewal.operationalAuthority.operationalStanding =
      entry :=
  rfl

/-- Required M10 budget fact: the exact installed operational standing carries
the source row's budget `2`. -/
@[simp] theorem operationalStanding_progressBudget_eq_two :
    installedRenewal.operationalAuthority.operationalStanding.progressBudget =
      2 :=
  rfl

def operationalStanding_debtLineage :
    RootDebtLineageAt N installedRenewal.payload.sourceEntry
      installedRenewal.operationalAuthority.operationalStanding :=
  installedRenewal.operationalAuthority.debtLineage

def responsibilityConsumer : RenewalResponsibilityConsumerAt
    installedRenewal.operationalAuthority :=
  installedRenewal.rootResponsibilityConsumer

abbrev LocalStanding := Unit

def standingOf
    (_seed : SourceSeed occurrenceOf LocalSeed
      LocalSeedAt LocalGame.source) : LocalStanding :=
  ()

def installedLocalFace :=
  installedRenewal.localFace lineageOf standingOf

@[simp] theorem installedLocalFace_sourceSeed_eq_focal :
    installedLocalFace.sourceSeed = focalSeed :=
  rfl

/-- The source-installed renewal, exact root occurrence, whole-ledger answer,
and generated next are one compiler image. -/
theorem installedRenewal_factorizes_root_answer_and_next :
    installedRenewal.RootAnswerAndNextFactorizes :=
  installedRenewal.rootAnswerAndNext_factorizes

end
end M10OccurrenceCapacityRenewalRootFixture
end Society
end ProcessGame
end SaturationMonoid
