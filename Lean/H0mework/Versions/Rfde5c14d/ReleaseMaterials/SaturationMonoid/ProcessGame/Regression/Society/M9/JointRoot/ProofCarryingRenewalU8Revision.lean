import H0mework.Versions.Rfde5c14d.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M9.JointRoot.ProofCarryingRenewalU8RevisedWorld

/-!
# Joint-root coface frontier and U8 core

The concrete revised source realizes the minimal coface generated by the
literal expanded joint root.  No original-root core, field-grounded sibling,
or post-hoc attachment enters this module.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M9ProofCarryingRenewalU8Revision

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open ConstructiveRoot.RootInquiryCompletion
open M9ProofCarryingRenewalInquiryRoot
open M9ProofCarryingRenewalU8Failure
open M9ProofCarryingRenewalU8RevisedWorld

abbrev N := M9ProofCarryingRenewalU8Failure.N
abbrev V := M9ProofCarryingRenewalU8Failure.V
abbrev U7 := M9ProofCarryingRenewalU8Failure.U7

def inquiryEventAt
    (visit : RootVisit jointRoot.toAuthoritativeRoot.toRoot) :=
  ULift.up.{1, 0} (jointRoot.emitted visit.current)

def frontierAt
    (visit : RootVisit jointRoot.toAuthoritativeRoot.toRoot) :
    SourceNativeInquiryCofaceFrontierAt
    jointRoot (.finite visit) U7
      RootInquiryU8CompletionRegression.theoryAuditCalculus
      RootInquiryU8CompletionRegression.oldTheory () (inquiryEventAt visit)
      entry (authorityAt visit)
      RootInquiryU8CompletionRegression.obstruction
      RootInquiryU8CompletionRegression.u7Gate
      RootInquiryU8CompletionRegression.failure :=
  SourceNativeInquiryCofaceFrontierAt.ofRootFailureFace
    (failureFaceAt visit) rfl (successorAt visit)

@[simp] theorem frontier_rooted_eq_at
    (visit : RootVisit jointRoot.toAuthoritativeRoot.toRoot) :
    (frontierAt visit).rooted = rootedAt visit :=
  rfl

@[simp] theorem frontier_coface_eq_at
    (visit : RootVisit jointRoot.toAuthoritativeRoot.toRoot) :
    (frontierAt visit).coface = cofaceAt visit :=
  rfl

def realizationCandidateAt
    (visit : RootVisit jointRoot.toAuthoritativeRoot.toRoot) :
    SourceNativeInquiryCofaceRealizationAt (frontierAt visit) where
  NewV := M9ProofCarryingRenewalU8RevisedLedger.NewVAt visit
  source := M9ProofCarryingRenewalU8RevisedLedger.revisedLedgerSourceAt visit

/-- Complete source-generated U8 core at the literal expanded joint root. -/
def jointCoreAt
    (visit : RootVisit jointRoot.toAuthoritativeRoot.toRoot) :
    SourceGeneratedInquiryU8RevisionCoreAt
    jointRoot (.finite visit) U7
      RootInquiryU8CompletionRegression.theoryAuditCalculus
      RootInquiryU8CompletionRegression.oldTheory () (inquiryEventAt visit)
      entry (authorityAt visit)
      RootInquiryU8CompletionRegression.obstruction
      RootInquiryU8CompletionRegression.u7Gate
      RootInquiryU8CompletionRegression.failure where
  frontier := frontierAt visit
  revision := typedRevisionSourceAt visit

theorem realizationCertificationAt
    (visit : RootVisit jointRoot.toAuthoritativeRoot.toRoot) :
    SourceNativeInquiryCofaceRealizationCertificationAt
      (realizationCandidateAt visit) (jointCoreAt visit) where
  frontier_eq := rfl
  source_heq := HEq.rfl

@[simp] theorem jointCore_rootEntry_eq_installedRenewal_at
    (visit : RootVisit jointRoot.toAuthoritativeRoot.toRoot) :
    (jointCoreAt visit).face.rootEntry =
      installedRenewal.payload.sourceEntry :=
  rfl

def jointCore_factorizationAndFirstWriteAt
    (visit : RootVisit jointRoot.toAuthoritativeRoot.toRoot) :=
  (jointCoreAt visit).cofaceFactorization

/-! ## Initial-visit facade -/

abbrev initialOldVisit := jointRoot.toAuthoritativeRoot.toRoot.initialVisit
def inquiryEvent := inquiryEventAt initialOldVisit
def frontier := frontierAt initialOldVisit
@[simp] theorem frontier_rooted_eq : frontier.rooted = rooted := rfl
@[simp] theorem frontier_coface_eq : frontier.coface = coface := rfl
def realizationCandidate := realizationCandidateAt initialOldVisit
def jointCore := jointCoreAt initialOldVisit
theorem realizationCertification :
    SourceNativeInquiryCofaceRealizationCertificationAt
      realizationCandidate jointCore :=
  realizationCertificationAt initialOldVisit
@[simp] theorem jointCore_rootEntry_eq_installedRenewal :
    jointCore.face.rootEntry = installedRenewal.payload.sourceEntry := rfl
def jointCore_factorizationAndFirstWrite :=
  jointCore_factorizationAndFirstWriteAt initialOldVisit

end
end M9ProofCarryingRenewalU8Revision
end Society
end ProcessGame
end SaturationMonoid
