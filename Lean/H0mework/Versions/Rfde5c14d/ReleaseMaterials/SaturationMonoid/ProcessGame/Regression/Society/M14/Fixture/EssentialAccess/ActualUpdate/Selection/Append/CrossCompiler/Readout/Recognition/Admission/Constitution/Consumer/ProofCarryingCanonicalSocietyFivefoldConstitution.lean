/-! ## UBI / material service / Job-Guarantee typed separation -/

structure CanonicalSocietyUBIUBSJobGuaranteeSeparationAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary)
    (fuel observerFuel m : Nat) : Type 15 where
  private mk ::
  constitutionalPoint :
    SourceGeneratedCanonicalSocietyConstitutionalPointAt initial fuel
      observerFuel m
  platformAdmission :
    ProofCarryingPlatformGateFullAdmissionAt oldVisit sourceIndex boundary
  positiveUBIExit :
    Nonempty (ExitCapacityRenewalAt birthBearerExitCapacityProgram)
  captureKeepsNominalReadout :
    NominalTransferReadoutAt birthBearerCapturedProgram
  captureKeepsVisibleAxes :
    type_of%
      constitutionalPoint.exitCaptureJob.fullCapture.capturedProgramAxesExact
  captureKeepsPayment :
    type_of% constitutionalPoint.exitCaptureJob.fullCapture.capturedPaymentExact
  capturedUBIExitEmpty :
    IsEmpty (ExitCapacityRenewalAt birthBearerCapturedProgram)
  actualMaterialService :
    Nonempty (RenewedPlatformMaterialServiceAt oldVisit sourceIndex boundary)
  materialOccurrenceDistinct :
    type_of%
      platformAdmission.materialFulfillment.renewedOccurrenceDistinct
  materialBudgetSpent :
    type_of% platformAdmission.materialFulfillment.serviceBudgetSpent
  materialFulfilled : type_of% platformAdmission.materialFulfilled
  materialNoReopen : type_of% platformAdmission.materialNoReopen
  materialCannotDisplaceOldPaidSlots :
    type_of% platformAdmission.materialCannotDisplaceOldSlots
  endedEmploymentJobGuaranteeEmpty :
    IsEmpty BirthBearerEmploymentJobGuaranteeStanding
  newRoleJobGuaranteeExists :
    Nonempty BirthBearerNewJobGuaranteeStanding
  ubiAndNewRoleJobCoexist :
    Nonempty (ExitCapacityRenewalAt birthBearerExitCapacityProgram) ∧
      Nonempty BirthBearerNewJobGuaranteeStanding
  capturedExitEmptyAndNewRoleJobExists :
    IsEmpty (ExitCapacityRenewalAt birthBearerCapturedProgram) ∧
      Nonempty BirthBearerNewJobGuaranteeStanding
  jobGuaranteeIsNotUBIComplement :
    ¬ (Nonempty BirthBearerNewJobGuaranteeStanding ↔
      IsEmpty (ExitCapacityRenewalAt birthBearerExitCapacityProgram))
  ubiCannotFillOldPaidMaterialFibre : IsEmpty
    (ExitCapacityRenewalAt birthBearerExitCapacityProgram →
      ExistingTwoSlotPlatformMaterialAdmissionAt oldVisit sourceIndex boundary)
  jobGuaranteeCannotFillOldPaidMaterialFibre : IsEmpty
    (BirthBearerNewJobGuaranteeStanding →
      ExistingTwoSlotPlatformMaterialAdmissionAt oldVisit sourceIndex boundary)
  materialServiceCannotRestoreCapturedExit : IsEmpty
    (RenewedPlatformMaterialServiceAt oldVisit sourceIndex boundary →
      ExitCapacityRenewalAt birthBearerCapturedProgram)
  jobGuaranteeCannotRestoreCapturedExit : IsEmpty
    (BirthBearerNewJobGuaranteeStanding →
      ExitCapacityRenewalAt birthBearerCapturedProgram)

def canonicalSocietyUBIUBSJobGuaranteeSeparationAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    {initial : CycleAt oldVisit sourceIndex boundary}
    {fuel observerFuel m : Nat}
    (point : SourceGeneratedCanonicalSocietyConstitutionalPointAt initial fuel
      observerFuel m)
    (admission :
      ProofCarryingPlatformGateFullAdmissionAt oldVisit sourceIndex boundary) :
    CanonicalSocietyUBIUBSJobGuaranteeSeparationAt initial fuel observerFuel
      m := by
  let capture := point.exitCaptureJob
  let positiveUBI :=
    capture.fullCapture.positiveConstitution.semanticRenewalNonempty
  let capturedEmpty := capture.fullCapture.capturedSemanticNoExit
  let oldMaterialEmpty :=
    admission.materialFulfillment.oldTwoSlotFibreRemainsEmpty
  let materialService := admission.materialFulfillment.materialService
  let newJob := birthBearerNewJobGuaranteeStanding
  exact
    { constitutionalPoint := point
      platformAdmission := admission
      positiveUBIExit := positiveUBI
      captureKeepsNominalReadout := capture.fullCapture.capturedNominal
      captureKeepsVisibleAxes :=
        capture.fullCapture.capturedProgramAxesExact
      captureKeepsPayment := capture.fullCapture.capturedPaymentExact
      capturedUBIExitEmpty := capturedEmpty
      actualMaterialService := ⟨materialService⟩
      materialOccurrenceDistinct :=
        admission.materialFulfillment.renewedOccurrenceDistinct
      materialBudgetSpent :=
        admission.materialFulfillment.serviceBudgetSpent
      materialFulfilled := admission.materialFulfilled
      materialNoReopen := admission.materialNoReopen
      materialCannotDisplaceOldPaidSlots :=
        admission.materialCannotDisplaceOldSlots
      endedEmploymentJobGuaranteeEmpty :=
        capture.endedEmploymentJobGuaranteeEmpty
      newRoleJobGuaranteeExists := capture.newJobGuaranteeExists
      ubiAndNewRoleJobCoexist := capture.positiveCoexistence
      capturedExitEmptyAndNewRoleJobExists := capture.capturedCoexistence
      jobGuaranteeIsNotUBIComplement := capture.notComplements
      ubiCannotFillOldPaidMaterialFibre :=
        ⟨fun substitute =>
          oldMaterialEmpty.false
            (substitute (Classical.choice positiveUBI))⟩
      jobGuaranteeCannotFillOldPaidMaterialFibre :=
        ⟨fun substitute => oldMaterialEmpty.false (substitute newJob)⟩
      materialServiceCannotRestoreCapturedExit :=
        ⟨fun substitute =>
          capturedEmpty.false (substitute materialService)⟩
      jobGuaranteeCannotRestoreCapturedExit :=
        ⟨fun substitute => capturedEmpty.false (substitute newJob)⟩ }

/-! ## Whole fivefold carrier -/

structure ProofCarryingCanonicalSocietyFivefoldConstitutionAt
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) : Type 15 where
  private mk ::
  lawFinalRuntimeOpen :
    ProofCarryingCanonicalSocietyLawFinalRuntimeOpenAt initial
  platformFullAdmission :
    ProofCarryingPlatformGateFullAdmissionAt oldVisit sourceIndex boundary
  mandatePowerRenewal : PeriodicMandatePowerRenewalCertificate
  sameRightReplaySeam :
    type_of%
      lawFinalRuntimeOpen.cofinalFiniteLawDiagonal.initialCycleRightReplayExact
  fullAdmissionRightPaymentExact :
    type_of%
      lawFinalRuntimeOpen.cofinalFiniteLawDiagonal.fullAdmissionRightPaymentExact
  everySeedGeneratedByLineageFold : ∀ depth,
    type_of% (crossCompilerCurrentStageAt_directConsumer depth)
  everyLineageFoldUnique : ∀ depth,
    type_of% (crossCompilerCurrentStageAt_seed_fold_unique depth)
  oldOnlyIdentityReconstructionEmpty : ∀ depth
      (old : RootedAccountedUnfolding (CrossCompilerAtomAt depth)),
    IsEmpty
      ((crossCompilerCurrentStageAt depth).targetCurrent = old.map Sum.inl)
  callerIdentityReplacementEmpty : ∀ depth replacement,
    replacement ≠ (crossCompilerCurrentStageAt depth).targetSeed →
      IsEmpty
        ((crossCompilerCurrentStageAt depth).targetCurrent.root =
          .inr replacement)
  gateBearerGenerated :
    type_of% platformFullAdmission.gateBearerGenerated
  gateTargetRoleGenerated :
    type_of% platformFullAdmission.targetRoleGenerated
  gateHasNoOldIdentityRepresentation :
    type_of% platformFullAdmission.gateHasNoOldRepresentation
  serviceObligationMatchesGeneratedBearer :
    type_of% platformFullAdmission.serviceObligationMatchesGateSource
  sourceObligationMatchesAffectedBearer :
    type_of%
      platformFullAdmission.materialFulfillment.materialService.gateIncidence.obligationBearerExact
  serviceResponsibilitySourceOwned :
    type_of%
      platformFullAdmission.materialFulfillment.serviceSourceOwned
  independentResidualConsumer :
    type_of% platformFullAdmission.independentPaidConsumer
  oldPaidChannelsPreserved :
    type_of% platformFullAdmission.oldPaidTransportsSameNext
  noSingleMandateOccurrenceForAllDepths :
    type_of% mandatePowerRenewal.noSingleOccurrenceForAllDepths
  mandateExitEndsPower :
    type_of% mandatePowerRenewal.exitRetainsPriorTraceAndEndsPower
  everyConstitutionalPoint : ∀ fuel observerFuel,
    ∃ m, SourceGeneratedCanonicalSocietyConstitutionalPointAt initial fuel
      observerFuel m
  everyInstitutionalSeparation : ∀ fuel observerFuel,
    ∃ m, Nonempty
      (CanonicalSocietyUBIUBSJobGuaranteeSeparationAt initial fuel
        observerFuel m)
  everySelfU8Tick : ∀ (depth _observerFuel : Nat),
    ExactCanonicalSelfU8TickAt initial depth
  everyUnrevisableRuntimeEmpty :
    type_of% lawFinalRuntimeOpen.everyRuntimeFinalityReportEmpty
  noFiniteTerminal : CanonicalSocietyNoFiniteTerminalAt initial

def proofCarryingCanonicalSocietyFivefoldConstitution
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) :
    ProofCarryingCanonicalSocietyFivefoldConstitutionAt initial := by
  let maximum :=
    proofCarryingCanonicalSocietyLawFinalRuntimeOpen initial
  let admission :=
    proofCarryingPlatformGateFullAdmission oldVisit sourceIndex boundary
  let mandatePower := periodicMandatePowerRenewalDirectConsumer
  exact
    { lawFinalRuntimeOpen := maximum
      platformFullAdmission := admission
      mandatePowerRenewal := mandatePower
      sameRightReplaySeam :=
        maximum.cofinalFiniteLawDiagonal.initialCycleRightReplayExact
      fullAdmissionRightPaymentExact :=
        maximum.cofinalFiniteLawDiagonal.fullAdmissionRightPaymentExact
      everySeedGeneratedByLineageFold :=
        crossCompilerCurrentStageAt_directConsumer
      everyLineageFoldUnique :=
        crossCompilerCurrentStageAt_seed_fold_unique
      oldOnlyIdentityReconstructionEmpty :=
        crossCompilerCurrentStageAt_oldOnlyReconstruction_isEmpty
      callerIdentityReplacementEmpty :=
        crossCompilerCurrentStageAt_callerTargetSeedReplacement_isEmpty
      gateBearerGenerated := admission.gateBearerGenerated
      gateTargetRoleGenerated := admission.targetRoleGenerated
      gateHasNoOldIdentityRepresentation :=
        admission.gateHasNoOldRepresentation
      serviceObligationMatchesGeneratedBearer :=
        admission.serviceObligationMatchesGateSource
      sourceObligationMatchesAffectedBearer :=
        admission.materialFulfillment.materialService.gateIncidence
          |>.obligationBearerExact
      serviceResponsibilitySourceOwned :=
        admission.materialFulfillment.serviceSourceOwned
      independentResidualConsumer := admission.independentPaidConsumer
      oldPaidChannelsPreserved := admission.oldPaidTransportsSameNext
      noSingleMandateOccurrenceForAllDepths :=
        mandatePower.noSingleOccurrenceForAllDepths
      mandateExitEndsPower :=
        mandatePower.exitRetainsPriorTraceAndEndsPower
      everyConstitutionalPoint :=
        everyRequestedCanonicalSocietyConstitutionalPoint maximum
      everyInstitutionalSeparation := by
        intro fuel observerFuel
        rcases everyRequestedCanonicalSocietyConstitutionalPoint maximum
            fuel observerFuel with
          ⟨m, point⟩
        exact ⟨m, ⟨
          canonicalSocietyUBIUBSJobGuaranteeSeparationAt point admission⟩⟩
      everySelfU8Tick := fun depth observerFuel =>
        (maximum.lawFinal depth observerFuel).2
      everyUnrevisableRuntimeEmpty :=
        maximum.everyRuntimeFinalityReportEmpty
      noFiniteTerminal := maximum.noFiniteTerminal }

/-! ## Independent constitutional consumers -/

theorem canonicalSociety_noSourceFreeIdentity
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) :
    let constitution :=
      proofCarryingCanonicalSocietyFivefoldConstitution initial
    (∀ depth, type_of%
      (crossCompilerCurrentStageAt_directConsumer depth)) ∧
      (∀ depth, type_of%
        (crossCompilerCurrentStageAt_seed_fold_unique depth)) ∧
      (∀ depth
        (old : RootedAccountedUnfolding (CrossCompilerAtomAt depth)),
        IsEmpty
        ((crossCompilerCurrentStageAt depth).targetCurrent =
          old.map Sum.inl)) ∧
      (∀ depth replacement,
        replacement ≠ (crossCompilerCurrentStageAt depth).targetSeed →
          IsEmpty
            ((crossCompilerCurrentStageAt depth).targetCurrent.root =
              .inr replacement)) ∧
      type_of% constitution.gateBearerGenerated ∧
      type_of% constitution.gateTargetRoleGenerated ∧
      type_of% constitution.gateHasNoOldIdentityRepresentation := by
  dsimp
  let constitution :=
    proofCarryingCanonicalSocietyFivefoldConstitution initial
  exact ⟨constitution.everySeedGeneratedByLineageFold,
    constitution.everyLineageFoldUnique,
    constitution.oldOnlyIdentityReconstructionEmpty,
    constitution.callerIdentityReplacementEmpty,
    constitution.gateBearerGenerated,
    constitution.gateTargetRoleGenerated,
    constitution.gateHasNoOldIdentityRepresentation⟩

theorem canonicalSociety_noFreeEternalPowerOrService
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) :
    let constitution :=
      proofCarryingCanonicalSocietyFivefoldConstitution initial
    type_of% constitution.mandatePowerRenewal.everyDepthRestoredPower ∧
      type_of% constitution.noSingleMandateOccurrenceForAllDepths ∧
      type_of% constitution.mandateExitEndsPower ∧
      type_of%
        constitution.platformFullAdmission.materialFulfillment.serviceBudgetSpent ∧
      type_of% constitution.platformFullAdmission.materialFulfilled ∧
      type_of% constitution.platformFullAdmission.materialNoReopen := by
  dsimp
  let constitution :=
    proofCarryingCanonicalSocietyFivefoldConstitution initial
  exact ⟨constitution.mandatePowerRenewal.everyDepthRestoredPower,
    constitution.noSingleMandateOccurrenceForAllDepths,
    constitution.mandateExitEndsPower,
    constitution.platformFullAdmission.materialFulfillment.serviceBudgetSpent,
    constitution.platformFullAdmission.materialFulfilled,
    constitution.platformFullAdmission.materialNoReopen⟩

theorem canonicalSociety_noInvisibleResidualBearer
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary)
    (fuel observerFuel : Nat) :
    ∃ m, ∃ point :
        SourceGeneratedCanonicalSocietyConstitutionalPointAt initial fuel
          observerFuel m,
        type_of%
          (proofCarryingCanonicalSocietyFivefoldConstitution initial
            ).serviceObligationMatchesGeneratedBearer ∧
        type_of%
          (proofCarryingCanonicalSocietyFivefoldConstitution initial
            ).sourceObligationMatchesAffectedBearer ∧
        type_of%
          (proofCarryingCanonicalSocietyFivefoldConstitution initial
            ).gateBearerGenerated ∧
        type_of%
          (proofCarryingCanonicalSocietyFivefoldConstitution initial
            ).serviceResponsibilitySourceOwned ∧
        type_of%
          (proofCarryingCanonicalSocietyFivefoldConstitution initial
            ).independentResidualConsumer ∧
        type_of% point.positiveExternalLiability ∧
        type_of% point.targetResidualDeletionNoGo := by
  let constitution :=
    proofCarryingCanonicalSocietyFivefoldConstitution initial
  rcases constitution.everyConstitutionalPoint fuel observerFuel with
    ⟨m, point⟩
  exact ⟨m, point,
    constitution.serviceObligationMatchesGeneratedBearer,
    constitution.sourceObligationMatchesAffectedBearer,
    constitution.gateBearerGenerated,
    constitution.serviceResponsibilitySourceOwned,
    constitution.independentResidualConsumer,
    point.positiveExternalLiability,
    point.targetResidualDeletionNoGo⟩

theorem canonicalSociety_observerIsNotTruth
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary)
    (fuel observerFuel : Nat) :
    ∃ m, ∃ point :
        SourceGeneratedCanonicalSocietyConstitutionalPointAt initial fuel
          observerFuel m,
        fuel < m ∧
          type_of% point.actualPathsDistinct ∧
          type_of% point.sameNormalFormDifferentK ∧
          type_of% point.noOccurrenceReconstruction ∧
          type_of% point.noAuthorityFactorization ∧
          type_of% point.noFaithfulReconstruction ∧
          type_of% point.rootLawCompleteAndU8Available.priorPoint ∧
          type_of% point.actualSearchSameRoot ∧
          type_of% point.searchHasNoActualWrite := by
  let constitution :=
    proofCarryingCanonicalSocietyFivefoldConstitution initial
  rcases constitution.everyConstitutionalPoint fuel observerFuel with
    ⟨m, point⟩
  exact ⟨m, point,
    point.diagonalPoint.later,
    point.actualPathsDistinct,
    point.sameNormalFormDifferentK,
    point.noOccurrenceReconstruction,
    point.noAuthorityFactorization,
    point.noFaithfulReconstruction,
    point.rootLawCompleteAndU8Available.priorPoint,
    point.actualSearchSameRoot,
    point.searchHasNoActualWrite⟩

theorem canonicalSociety_noLawForbidsSelfRevision
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) :
    CanonicalSocietyLawFinalAt initial ∧
      CanonicalSocietyRuntimeOpenAt initial ∧
      CanonicalSocietyNoFiniteTerminalAt initial ∧
      (∀ (depth _observerFuel : Nat),
        ExactCanonicalSelfU8TickAt initial depth) ∧
      (∀ depth,
        let step := sourceGeneratedCycleCanonicalRootLawStep initial depth
        IsEmpty
          (M14SourceGeneratedCycleCanonicalRootLawStepNoGo.FinalUnrevisableRuntimeConstitutionAt
            step)) := by
  let constitution :=
    proofCarryingCanonicalSocietyFivefoldConstitution initial
  exact ⟨constitution.lawFinalRuntimeOpen.lawFinal,
    constitution.lawFinalRuntimeOpen.runtimeOpen,
    constitution.noFiniteTerminal,
    constitution.everySelfU8Tick,
    constitution.everyUnrevisableRuntimeEmpty⟩

/-- Final universal mouth.  It is inhabited without a caller-supplied raw body
or legislation program.  The returned pair universally classifies both raw
submissions and every already installed complete program, while retaining the
concrete rooted/external Payment leaf that makes the maximum non-vacuous. -/
theorem canonicalSociety_rootLawComplete_and_u8Available
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary)
    (fuel observerFuel : Nat) :
    ∃ m, ∃ point :
        SourceGeneratedCanonicalSocietyConstitutionalPointAt initial fuel
          observerFuel m,
      type_of% point.rootLawCompleteAndU8Available ∧
        CanonicalSocietyMInfinityRootLawCompleteAt.{uRootLawVisible,
          uRootLawOutput, uRootLawEffect}
          point.rootLawCompleteAndU8Available ∧
          CanonicalSocietyMInfinityU8AvailableAt.{uRootLawVisible,
            uRootLawOutput, uRootLawEffect}
            point.rootLawCompleteAndU8Available := by
  let constitution :=
    proofCarryingCanonicalSocietyFivefoldConstitution initial
  rcases constitution.everyConstitutionalPoint fuel observerFuel with
    ⟨m, point⟩
  let final :=
    point.rootLawCompleteAndU8Available.rootLawComplete_and_u8Available
  exact ⟨m, point, point.rootLawCompleteAndU8Available, final.1, final.2⟩

theorem canonicalSocietyFivefoldConstitution_directConsumer
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) :
    Nonempty (ProofCarryingCanonicalSocietyFivefoldConstitutionAt initial) ∧
      (∀ (fuel observerFuel : Nat),
        ∃ m, Nonempty
          (CanonicalSocietyUBIUBSJobGuaranteeSeparationAt initial fuel
            observerFuel m)) ∧
      CanonicalSocietyLawFinalAt initial ∧
      CanonicalSocietyRuntimeOpenAt initial ∧
      CanonicalSocietyNoFiniteTerminalAt initial := by
  let constitution :=
    proofCarryingCanonicalSocietyFivefoldConstitution initial
  exact ⟨⟨constitution⟩,
    constitution.everyInstitutionalSeparation,
    constitution.lawFinalRuntimeOpen.lawFinal,
    constitution.lawFinalRuntimeOpen.runtimeOpen,
    constitution.noFiniteTerminal⟩

end
