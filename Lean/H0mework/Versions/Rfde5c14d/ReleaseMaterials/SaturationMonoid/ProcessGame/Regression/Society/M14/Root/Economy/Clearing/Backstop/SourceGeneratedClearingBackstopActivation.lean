import H0mework.Versions.Rfde5c14d.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Root.Economy.Clearing.Death.ClearingConsumerDeath

/-!
# M14 source-generated clearing backstop activation

The existing partial settlement has fulfilled leg `a` and left its generated
counterparty leg `b` open.  C1 already supplies the exact fulfillment boundary
event for that `b` obligation; C4 identified that the old singleton residual
compiler cannot source the event at `partialOccurrence`.

This file installs precisely that missing source incidence in the existing
`SourceOwnedResidualConsumerCompiler`.  Its sole seed selects
`exactPartialSeed`, `partialOpenB`, and C1's existing `b` event.  The generic
compiler then generates the activated consumer occurrence and its whole-run
next.  No event, settlement occurrence, run, ledger, registry, coverage,
schedule, or completed future is introduced.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceGeneratedClearingBackstopActivation

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Lifecycle Universal Relations Exchange Settlement Clearing
open Lifecycle.Universal.FixedAdapter
open Settlement.SourceOwnedSettlementCompiler
open M3FiniteExchangeFixture
open M3ExchangeSettlementPriceRegression
open M4AutomaticFullFulfillmentRegression
open M14SourceCommonClearingRenewal
open M14ClearingConsumerDeath

/-! ## Exact source-owned compiler -/

/-- The zero-choice source compiler for the missing `b` consumer.  Its event
is the already existing C1 counterparty fulfillment event, not a new event
constructor or a caller-provided activation. -/
def partialBResidualConsumerCompiler :
    SourceOwnedResidualConsumerCompiler settlementCompiler where
  ActivationSeed := Unit
  activationAdmittedAt := fun _ => True
  settlementSeed := fun _ => exactPartialSeed
  openSettlement := fun _ => partialOpenB
  boundaryEvent := fun _ =>
    canonicalAClearingFace.counterpartyConsumer.event

private def exactPartialBActivationSeed :
    partialBResidualConsumerCompiler.ExactActivationSeed :=
  ⟨(), .after,
    by simp [Lifecycle.actualEventOccurrenceOf], rfl, trivial⟩

/-- Unique public producer.  The mouth has no activation, occurrence, next,
coverage, run, or target argument. -/
def sourceGeneratedClearingBackstopActivation :
    partialBResidualConsumerCompiler.GeneratedResidualConsumerOccurrence :=
  partialBResidualConsumerCompiler.consumerOfSeed
    exactPartialBActivationSeed

/-- The exact activation is a readout of the generated occurrence. -/
def sourceGeneratedClearingBackstopExactSeed :
    partialBResidualConsumerCompiler.ExactActivationSeed :=
  sourceGeneratedClearingBackstopActivation.exactSeed
    partialBResidualConsumerCompiler

/-- The exact activated adapter is generated by the source compiler. -/
def sourceGeneratedClearingBackstopConsumer :
    OpenSettlementAt.ActivatedResidualConsumerAt partialOpenB :=
  sourceGeneratedClearingBackstopExactSeed.activatedConsumer
    partialBResidualConsumerCompiler

/-! ## Exact source, occurrence, action, and next -/

@[simp] theorem backstop_occurrence_exact :
    sourceGeneratedClearingBackstopExactSeed.occurrence
        partialBResidualConsumerCompiler = partialOccurrence :=
  rfl

@[simp] theorem backstop_openSettlement_exact :
    sourceGeneratedClearingBackstopExactSeed.openSettlement
        partialBResidualConsumerCompiler = partialOpenB :=
  rfl

@[simp] theorem backstop_leg_exact :
    (sourceGeneratedClearingBackstopExactSeed.openSettlement
      partialBResidualConsumerCompiler).leg = .b :=
  rfl

@[simp] theorem backstop_boundaryEvent_exact :
    sourceGeneratedClearingBackstopExactSeed.activation
        partialBResidualConsumerCompiler =
      canonicalAClearingFace.counterpartyConsumer.event :=
  rfl

@[simp] theorem backstop_consumer_is_C4_adapter :
    sourceGeneratedClearingBackstopConsumer = rawBackstopAdapter :=
  rfl

@[simp] theorem backstop_edge_exact :
    sourceGeneratedClearingBackstopActivation.edge = fulfillB :=
  rfl

@[simp] theorem backstop_next_current_exact :
    sourceGeneratedClearingBackstopActivation.nextGeneratedState.current =
      fulfillB.target :=
  rfl

@[simp] theorem backstop_nextGeneratedState_exact :
    sourceGeneratedClearingBackstopActivation.nextGeneratedState =
      (partialOccurrence.generatedState settlementCompiler).step P fulfillB :=
  rfl

@[simp] theorem backstop_whole_generated_next_exact :
    sourceGeneratedClearingBackstopActivation.nextGeneratedState.generated =
      .step (partialOccurrence.generatedState settlementCompiler).generated
        fulfillB :=
  rfl

theorem backstop_history_exact :
    fulfillB.target.history =
      (partialOccurrence.current settlementCompiler).history ++
        [fulfillB.lifecycleEvent] :=
  sourceGeneratedClearingBackstopActivation.history_append

/-- The generated activation carries the source incidence of C1's exact `b`
boundary event at the existing admitted residual. -/
def backstopSourceOwnership :
    SourceOwnsResponsibilityIncidence V
      (P.boundarySource
        canonicalAClearingFace.counterpartyConsumer.event)
      partialOpenB.obligation :=
  sourceGeneratedClearingBackstopExactSeed.sourceOwnership
    partialBResidualConsumerCompiler

/-- The actual generated next has terminally fulfilled the exact `b` slot.
This is a state-indexed result, not a second settlement occurrence. -/
def backstopFulfilledB :
    AutomaticFullFulfillment.FulfilledSlotAt (exchangeLaw := exchangeLaw)
      exactExchangeSeed
      sourceGeneratedClearingBackstopActivation.nextGeneratedState.current
      (.b : Leg) where
  sourceEvent :=
    P.boundarySource canonicalAClearingFace.counterpartyConsumer.event
  receipt := canonicalAClearingFace.counterpartyConsumer.receipt
  present := rfl

theorem backstop_exact_source_provenance :
    ∃ state ∈ Lifecycle.actualEventGame.occurrence.trace,
      state = core.targetFace.state Lifecycle.actualEventGame.source ∧
        partialBResidualConsumerCompiler.activationAdmittedAt
          sourceGeneratedClearingBackstopExactSeed.1 :=
  sourceGeneratedClearingBackstopExactSeed.exact_state_provenance
    partialBResidualConsumerCompiler

@[simp] theorem backstop_settlementSeed_exact :
    partialBResidualConsumerCompiler.settlementSeed
        sourceGeneratedClearingBackstopExactSeed.1 = exactPartialSeed :=
  rfl

/-- The public occurrence is in the exact image of the same source seed whose
trace provenance fixes the partial occurrence, open B slot, and existing C1
event.  Raw adapter inhabitation alone cannot prove this conjunction. -/
theorem backstop_generated_from_exact_source :
    ∃ seed : partialBResidualConsumerCompiler.ExactActivationSeed,
      partialBResidualConsumerCompiler.consumerOfSeed seed =
          sourceGeneratedClearingBackstopActivation ∧
      (∃ state ∈ Lifecycle.actualEventGame.occurrence.trace,
        state = core.targetFace.state Lifecycle.actualEventGame.source ∧
          partialBResidualConsumerCompiler.activationAdmittedAt seed.1) ∧
      seed.occurrence partialBResidualConsumerCompiler = partialOccurrence ∧
      seed.openSettlement partialBResidualConsumerCompiler = partialOpenB ∧
      seed.activation partialBResidualConsumerCompiler =
        canonicalAClearingFace.counterpartyConsumer.event :=
  ⟨sourceGeneratedClearingBackstopExactSeed,
    rfl,
    backstop_exact_source_provenance,
    backstop_occurrence_exact,
    backstop_openSettlement_exact,
    backstop_boundaryEvent_exact⟩

/-- The immutable pre-activation settlement occurrence still records B as
open; fulfillment belongs to the generated next state, never to a rewritten
old occurrence. -/
theorem backstop_oldOccurrence_B_fulfillment_isEmpty :
    IsEmpty (FulfilledExchangeLegAt settlementCompiler partialOccurrence
      (.b : Leg)) :=
  partialOpenB.fulfilledLeg_isEmpty

/-- Compact direct-consumer contract. -/
theorem sourceGeneratedClearingBackstop_exact :
    sourceGeneratedClearingBackstopExactSeed.occurrence
          partialBResidualConsumerCompiler = partialOccurrence ∧
      sourceGeneratedClearingBackstopExactSeed.openSettlement
          partialBResidualConsumerCompiler = partialOpenB ∧
      sourceGeneratedClearingBackstopExactSeed.activation
          partialBResidualConsumerCompiler =
        canonicalAClearingFace.counterpartyConsumer.event ∧
      sourceGeneratedClearingBackstopConsumer = rawBackstopAdapter ∧
      sourceGeneratedClearingBackstopActivation.edge = fulfillB ∧
      sourceGeneratedClearingBackstopActivation.nextGeneratedState.current =
        fulfillB.target ∧
      sourceGeneratedClearingBackstopActivation.nextGeneratedState =
        (partialOccurrence.generatedState settlementCompiler).step P
          fulfillB ∧
      sourceGeneratedClearingBackstopActivation.nextGeneratedState.generated =
        .step (partialOccurrence.generatedState settlementCompiler).generated
          fulfillB ∧
      Nonempty (SourceOwnsResponsibilityIncidence V
        (P.boundarySource
          canonicalAClearingFace.counterpartyConsumer.event)
        partialOpenB.obligation) ∧
      Nonempty (AutomaticFullFulfillment.FulfilledSlotAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed
        sourceGeneratedClearingBackstopActivation.nextGeneratedState.current
        (.b : Leg)) :=
  ⟨backstop_occurrence_exact,
    backstop_openSettlement_exact,
    backstop_boundaryEvent_exact,
    backstop_consumer_is_C4_adapter,
    backstop_edge_exact,
    backstop_next_current_exact,
    backstop_nextGeneratedState_exact,
    backstop_whole_generated_next_exact,
    ⟨backstopSourceOwnership⟩,
    ⟨backstopFulfilledB⟩⟩

/-! ## Wrong-source controls -/

/-- C4's old singleton compiler remains incapable of sourcing this `b`
activation.  C5 adds a new source compiler; it does not reinterpret the old
one. -/
theorem oldResidualCompiler_still_cannot_source_backstop :
    (¬ ∃ activation : residualConsumerCompiler.ExactActivationSeed,
        (activation.openSettlement residualConsumerCompiler).leg = .b) ∧
      (¬ ∃ activation : residualConsumerCompiler.ExactActivationSeed,
        activation.occurrence residualConsumerCompiler = partialOccurrence) :=
  ⟨residualCompiler_cannot_select_B,
    residualCompiler_cannot_point_to_partialOccurrence⟩

theorem backstopCompiler_cannot_select_A :
    ¬ ∃ activation : partialBResidualConsumerCompiler.ExactActivationSeed,
      (activation.openSettlement partialBResidualConsumerCompiler).leg = .a := by
  rintro ⟨activation, equality⟩
  cases equality

theorem backstopCompiler_cannot_point_to_openOccurrence :
    ¬ ∃ activation : partialBResidualConsumerCompiler.ExactActivationSeed,
      activation.occurrence partialBResidualConsumerCompiler =
        openOccurrence := by
  rintro ⟨activation, equality⟩
  have seedEquality := congrArg
    (fun occurrence : settlementCompiler.GeneratedSettlementOccurrence =>
      occurrence.1.1) equality
  cases seedEquality

theorem backstopCompiler_has_unique_exact_seed
    (activation : partialBResidualConsumerCompiler.ExactActivationSeed) :
    activation = sourceGeneratedClearingBackstopExactSeed := by
  apply Subtype.ext
  cases activation.1
  rfl

theorem backstop_mouth_has_no_activation_coverage_next_or_future : True := by
  fail_if_success exact sourceGeneratedClearingBackstopActivation.activation
  fail_if_success exact sourceGeneratedClearingBackstopActivation.coverage
  fail_if_success exact sourceGeneratedClearingBackstopActivation.target
  fail_if_success exact sourceGeneratedClearingBackstopActivation.run
  fail_if_success exact sourceGeneratedClearingBackstopActivation.ledger
  fail_if_success exact sourceGeneratedClearingBackstopActivation.registry
  fail_if_success exact sourceGeneratedClearingBackstopActivation.secondOccurrence
  fail_if_success exact sourceGeneratedClearingBackstopActivation.completedFuture
  trivial

end
end M14SourceGeneratedClearingBackstopActivation
end Society
end ProcessGame
end SaturationMonoid

