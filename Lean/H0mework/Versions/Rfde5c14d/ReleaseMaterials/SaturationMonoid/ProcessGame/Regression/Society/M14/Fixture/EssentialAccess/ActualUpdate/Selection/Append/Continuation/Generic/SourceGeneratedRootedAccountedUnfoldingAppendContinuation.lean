import H0mework.Versions.Rfde5c14d.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Fixture.EssentialAccess.ActualUpdate.Selection.Append.Root.Generic.SourceGeneratedRootedAccountedUnfoldingAppendRoot
import H0mework.Foundation.Cofinal.ProductiveHistory

/-!
# Polymorphic rooted-accounted-unfolding append continuation

The first temporal visit is the current generated by the append root's first
whole-ledger write.  Later visits retain that exact occurrence.  Only `Fin 1`
owns an answered compiler; visit one is reserved for the next source-generated
actual action.  `Nat` is a visit spine, never an event or target schedule.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceGeneratedRootedAccountedUnfoldingAppendContinuation

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open ConstructiveRoot.RootInquiryCompletion
open M14SourceGeneratedCriticalEventSelectionRevisedLedger
open M14SourceGeneratedCriticalEventSelectionRevisedInquiry
open M14SourceGeneratedRootedAccountedUnfoldingAppendLedger
open M14SourceGeneratedRootedAccountedUnfoldingAppendRoot

section

variable {Atom : Type}
variable {SourceV : ConstructiveRoot.Vocabulary}
variable (sourceRoot : SourceNativeLivingRootClosure NewN SourceV)
variable {sourceCurrent : SourceV.Current}
variable (sourceOccurrence :
  sourceRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.actual.OccurrenceAt
    sourceCurrent)
variable (prior : RootedAccountedUnfolding Atom)
variable (nextAtom : Atom)

abbrev rootedAppendTargetRoot :=
  rootedAppendLivingRoot sourceRoot sourceOccurrence prior nextAtom

def rootedAppendRootVisitAt : Nat →
    RootVisit (rootedAppendTargetRoot sourceRoot sourceOccurrence prior
      nextAtom).toAuthoritativeRoot.toRoot
  | 0 => (rootedAppendTargetRoot sourceRoot sourceOccurrence prior nextAtom
      ).toAuthoritativeRoot.toRoot.initialVisit.next rfl
  | depth + 1 => (rootedAppendRootVisitAt depth).next rfl

def rootedAppendTemporalVisitAt (depth : Nat) :
    SourceNativeTemporalVisitAt
      (rootedAppendTargetRoot sourceRoot sourceOccurrence prior nextAtom
        ).toAuthoritativeRoot.toLedgerRoot :=
  .finite (rootedAppendRootVisitAt (sourceRoot := sourceRoot)
    (sourceOccurrence := sourceOccurrence) (prior := prior)
    (nextAtom := nextAtom) depth)

theorem rootedAppendNextEqAt (depth : Nat) :
    ((rootedAppendTargetRoot sourceRoot sourceOccurrence prior nextAtom
      ).toAuthoritativeRoot.toRoot.evolutionAt
        (rootedAppendRootVisitAt (sourceRoot := sourceRoot)
          (sourceOccurrence := sourceOccurrence) (prior := prior)
          (nextAtom := nextAtom) depth).current).nextCurrent? =
      some (rootedAppendRootVisitAt (sourceRoot := sourceRoot)
        (sourceOccurrence := sourceOccurrence) (prior := prior)
        (nextAtom := nextAtom) (depth + 1)).current :=
  rfl

@[simp] theorem rootedAppendTemporalVisit_next_eq (depth : Nat) :
    (rootedAppendTemporalVisitAt (sourceRoot := sourceRoot)
      (sourceOccurrence := sourceOccurrence) (prior := prior)
      (nextAtom := nextAtom) depth).next
        (rootedAppendNextEqAt (sourceRoot := sourceRoot)
          (sourceOccurrence := sourceOccurrence) (prior := prior)
          (nextAtom := nextAtom) depth) =
      rootedAppendTemporalVisitAt (sourceRoot := sourceRoot)
        (sourceOccurrence := sourceOccurrence) (prior := prior)
        (nextAtom := nextAtom) (depth + 1) :=
  rfl

@[simp] theorem rootedAppendRootVisitAt_zero_current :
    (rootedAppendRootVisitAt (sourceRoot := sourceRoot)
      (sourceOccurrence := sourceOccurrence) (prior := prior)
      (nextAtom := nextAtom) 0).current =
        rootedAppendedCurrent prior nextAtom :=
  rootedAppendNativeTarget_initial prior nextAtom

@[simp] theorem rootedAppendRootVisitAt_one_current :
    (rootedAppendRootVisitAt (sourceRoot := sourceRoot)
      (sourceOccurrence := sourceOccurrence) (prior := prior)
      (nextAtom := nextAtom) 1).current =
        rootedRetainedCurrent (rootedAppendedCurrent prior nextAtom) := by
  change rootedAppendNativeTarget prior nextAtom
    (rootedAppendRootVisitAt (sourceRoot := sourceRoot)
      (sourceOccurrence := sourceOccurrence) (prior := prior)
      (nextAtom := nextAtom) 0).current = _
  rw [rootedAppendRootVisitAt_zero_current]
  exact rootedAppendNativeTarget_after_append prior nextAtom

def rootedAppendEntryAt (_depth : Nat) :
    OpenResponsibilityAt NewN minimalCoface.cofaceSupport :=
  newRevisedEntry

def rootedAppendInitialGenerated :=
  (rootedAppendTargetRoot sourceRoot sourceOccurrence prior nextAtom
    ).toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit
      (.finite (rootedAppendTargetRoot sourceRoot sourceOccurrence prior
        nextAtom).toAuthoritativeRoot.toRoot.initialVisit)

def rootedAppendInitialEntryRow :
    (rootedAppendInitialGenerated (sourceRoot := sourceRoot)
      (sourceOccurrence := sourceOccurrence) (prior := prior)
      (nextAtom := nextAtom)).GeneratedEntryRowAt newRevisedEntry :=
  ((rootedAppendInitialGenerated (sourceRoot := sourceRoot)
    (sourceOccurrence := sourceOccurrence) (prior := prior)
    (nextAtom := nextAtom)).canonicalGeneratedEntryRow? newRevisedEntry).get
      (by rfl)

def rootedAppendInitialAuthority :
    SourceNativeLivingTemporalCausalEntryAuthorityAt
      (rootedAppendTargetRoot sourceRoot sourceOccurrence prior nextAtom)
      (rootedAppendTemporalVisitAt (sourceRoot := sourceRoot)
        (sourceOccurrence := sourceOccurrence) (prior := prior)
        (nextAtom := nextAtom) 0)
      (rootedAppendEntryAt 0) :=
  (SourceNativeLivingTemporalCausalEntryAuthorityAt.generatedFromInitialRow
    (rootedAppendTargetRoot sourceRoot sourceOccurrence prior nextAtom)
    newRevisedEntry
    (rootedAppendInitialEntryRow (sourceRoot := sourceRoot)
      (sourceOccurrence := sourceOccurrence) (prior := prior)
      (nextAtom := nextAtom))).next rfl

def rootedAppendAuthorityAt : (depth : Nat) →
    SourceNativeLivingTemporalCausalEntryAuthorityAt
      (rootedAppendTargetRoot sourceRoot sourceOccurrence prior nextAtom)
      (rootedAppendTemporalVisitAt (sourceRoot := sourceRoot)
        (sourceOccurrence := sourceOccurrence) (prior := prior)
        (nextAtom := nextAtom) depth)
      (rootedAppendEntryAt depth)
  | 0 => rootedAppendInitialAuthority (sourceRoot := sourceRoot)
      (sourceOccurrence := sourceOccurrence) (prior := prior)
      (nextAtom := nextAtom)
  | depth + 1 =>
      (rootedAppendAuthorityAt depth).next
        (rootedAppendNextEqAt (sourceRoot := sourceRoot)
          (sourceOccurrence := sourceOccurrence) (prior := prior)
          (nextAtom := nextAtom) depth)

def rootedAppendAnswerFaceAt (selection : Fin 1) :
    SourceNativeRootSemanticFaceAt
      (rootedAppendTargetRoot sourceRoot sourceOccurrence prior nextAtom)
      (rootedAppendTemporalVisitAt (sourceRoot := sourceRoot)
        (sourceOccurrence := sourceOccurrence) (prior := prior)
        (nextAtom := nextAtom) selection.val) where
  projection := RootedAppendProjection.answer
  active := PUnit.unit
  classifier_eq := rfl

def rootedAppendAnswerConsumerAt (selection : Fin 1) :
    SourceNativeInquiryAnswerConsumerAt ()
      (ULift.up.{1, 0}
        ((rootedAppendTargetRoot sourceRoot sourceOccurrence prior nextAtom
          ).emitted
            (rootedAppendTemporalVisitAt (sourceRoot := sourceRoot)
              (sourceOccurrence := sourceOccurrence) (prior := prior)
              (nextAtom := nextAtom) selection.val).current))
      (rootedAppendEntryAt selection.val)
      (rootedAppendAnswerFaceAt (sourceRoot := sourceRoot)
        (sourceOccurrence := sourceOccurrence) (prior := prior)
        (nextAtom := nextAtom) selection) where
  projection := RootedAppendProjection.consumer
  active := PUnit.unit
  classifier_eq := rfl
  project_heq := HEq.rfl

def rootedAppendAnsweredCompilationAt (selection : Fin 1) :
    SourceNativeInquiryCompilationAt
      (rootedAppendTargetRoot sourceRoot sourceOccurrence prior nextAtom)
      (rootedAppendTemporalVisitAt (sourceRoot := sourceRoot)
        (sourceOccurrence := sourceOccurrence) (prior := prior)
        (nextAtom := nextAtom) selection.val)
      revisedInquiryU7 revisedInquiryCalculus revisedInquiryTheory ()
      (ULift.up.{1, 0}
        ((rootedAppendTargetRoot sourceRoot sourceOccurrence prior nextAtom
          ).emitted
            (rootedAppendTemporalVisitAt (sourceRoot := sourceRoot)
              (sourceOccurrence := sourceOccurrence) (prior := prior)
              (nextAtom := nextAtom) selection.val).current))
      (rootedAppendEntryAt selection.val)
      (rootedAppendAuthorityAt (sourceRoot := sourceRoot)
        (sourceOccurrence := sourceOccurrence) (prior := prior)
        (nextAtom := nextAtom) selection.val) :=
  .answered (rootedAppendAnswerFaceAt (sourceRoot := sourceRoot)
    (sourceOccurrence := sourceOccurrence) (prior := prior)
    (nextAtom := nextAtom) selection)
    (rootedAppendAnswerConsumerAt (sourceRoot := sourceRoot)
      (sourceOccurrence := sourceOccurrence) (prior := prior)
      (nextAtom := nextAtom) selection)

def rootedAppendInquiryStateAt (selection : Fin 1) :
    RootInquiryStateAt NewN (RootedAppendVAt prior nextAtom) where
  root := rootedAppendTargetRoot sourceRoot sourceOccurrence prior nextAtom
  visit := rootedAppendTemporalVisitAt (sourceRoot := sourceRoot)
    (sourceOccurrence := sourceOccurrence) (prior := prior)
    (nextAtom := nextAtom) selection.val
  U7 := revisedInquiryU7
  calculus := revisedInquiryCalculus
  Query := Unit
  entryAt := fun _ => rootedAppendEntryAt selection.val
  authorityAt := fun _ => rootedAppendAuthorityAt
    (sourceRoot := sourceRoot) (sourceOccurrence := sourceOccurrence)
    (prior := prior) (nextAtom := nextAtom) selection.val
  compilationProgramAt := fun _ =>
    { compile := fun _ => rootedAppendAnsweredCompilationAt
        (sourceRoot := sourceRoot) (sourceOccurrence := sourceOccurrence)
        (prior := prior) (nextAtom := nextAtom) selection }
  compilationFaceAt := fun _ =>
    { projection := RootedAppendProjection.inquiry
      active := PUnit.unit
      classifier_eq := rfl
      project_heq := HEq.rfl }
  u7RootDisposition_commutes := by
    intro _query _obstruction _audit audit_eq
    cases audit_eq

def rootedAppendPresentationAt (selection : Fin 1) :
    RootInquiryStatePresentation where
  N := NewN
  V := RootedAppendVAt prior nextAtom
  state := RootInquiryEngineStateAt.create
    (rootedAppendInquiryStateAt (sourceRoot := sourceRoot)
      (sourceOccurrence := sourceOccurrence) (prior := prior)
      (nextAtom := nextAtom) selection)

theorem rootedAppendContinuation_directConsumer (selection : Fin 1) :
    (rootedAppendInquiryStateAt (sourceRoot := sourceRoot)
      (sourceOccurrence := sourceOccurrence) (prior := prior)
      (nextAtom := nextAtom) selection).compileInquiry () =
      SourceNativeInquiryCompilationAt.answered
        (rootedAppendAnswerFaceAt (sourceRoot := sourceRoot)
          (sourceOccurrence := sourceOccurrence) (prior := prior)
          (nextAtom := nextAtom) selection)
        (rootedAppendAnswerConsumerAt (sourceRoot := sourceRoot)
          (sourceOccurrence := sourceOccurrence) (prior := prior)
          (nextAtom := nextAtom) selection) :=
  rfl

end
end
end M14SourceGeneratedRootedAccountedUnfoldingAppendContinuation
end Society
end ProcessGame
end SaturationMonoid

