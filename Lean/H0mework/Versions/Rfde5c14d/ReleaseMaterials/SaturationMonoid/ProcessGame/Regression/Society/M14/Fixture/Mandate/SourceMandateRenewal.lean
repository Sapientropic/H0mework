import H0mework.Versions.AB.Society.Renewal.InstalledRenewalProjection
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M8.Election.ActualElectionMandateRenewalRegression

/-!
# M14 root-independent source mandate renewal

This fixture isolates the exact local election authority which a later
living-law source may install as a renewal projection.  The local face and
law are parameterized by an arbitrary existing `ActualHistory`; the standing
and exit fixtures below are specializations of that one family and reuse the
same unrestricted election producer and `lineageCompiler`.

The local fixture contains no living root, ledger row, root successor,
preference profile, aggregation rule, periodic schedule, or completed future.
`SourceMandateRenewalLawForAt` is only the root-polymorphic law type, while
`sourceMandateRenewalLawFor` fills its local payload from the requested exact
history after a later root supplies its own occurrence-indexed ledger shell.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceMandateRenewal

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Election Relations Power Renewal
open M8ActualElectionMandateRenewalRegression

/-! ## Exact local source face -/

/-- The fixed regression source is an actual continuing election history,
not a voter, preference, aggregation, or truth-value input. -/
abbrev sourceMandateHistory : ActualHistory := continuingHistory 0

/-! ### History-polymorphic local family -/

abbrev SourceMandateGameFor (history : ActualHistory) :=
  electionGame history

abbrev SourceMandateSeedFor (history : ActualHistory) :=
  (electionActionController history lineageCompiler).ActionSeed

abbrev SourceMandateSeedAtFor (history : ActualHistory) :=
  (electionActionController history lineageCompiler).actionSeedAt

abbrev SourceMandateConsumerAtFor (history : ActualHistory) :=
  ElectionRenewalConsumerAt history lineageCompiler

abbrev SourceMandateDispositionAtFor (history : ActualHistory) :=
  ElectionRenewalDispositionAt history lineageCompiler

abbrev SourceMandateRenewalFaceFor (history : ActualHistory) :=
  ActualElectionRenewalFace history lineageCompiler

/-- Exact local face for any already existing election history.  The history
is an index, not a new occurrence or scheduler entry. -/
def sourceMandateRenewalFaceFor (history : ActualHistory) :
    SourceMandateRenewalFaceFor history :=
  sourceGeneratedElectionRenewal history lineageCompiler

abbrev sourceMandateSeedFor (history : ActualHistory) :=
  (sourceMandateRenewalFaceFor history).sourceSeed

def sourceMandateConsumerFor (history : ActualHistory) :
    SourceMandateConsumerAtFor history (sourceMandateSeedFor history) :=
  (sourceMandateRenewalFaceFor history).responsibilityConsumer

def sourceMandateDispositionFor (history : ActualHistory) :
    SourceMandateDispositionAtFor history (sourceMandateSeedFor history) :=
  (sourceMandateRenewalFaceFor history).exactDisposition

/-! ### Standing specialization -/

abbrev SourceMandateGame := SourceMandateGameFor sourceMandateHistory

abbrev SourceMandateSeed := SourceMandateSeedFor sourceMandateHistory

abbrev SourceMandateSeedAt := SourceMandateSeedAtFor sourceMandateHistory

abbrev SourceMandateConsumerAt :=
  SourceMandateConsumerAtFor sourceMandateHistory

abbrev SourceMandateDispositionAt :=
  SourceMandateDispositionAtFor sourceMandateHistory

abbrev SourceMandateRenewalFace :=
  SourceMandateRenewalFaceFor sourceMandateHistory

/-- Exact local face generated by the existing unrestricted election
producer.  No root installation data enters this mouth. -/
def sourceMandateRenewalFace : SourceMandateRenewalFace :=
  sourceMandateRenewalFaceFor sourceMandateHistory

abbrev sourceMandateSeed := sourceMandateSeedFor sourceMandateHistory

def sourceMandateConsumer : SourceMandateConsumerAt sourceMandateSeed :=
  sourceMandateConsumerFor sourceMandateHistory

def sourceMandateDisposition :
    SourceMandateDispositionAt sourceMandateSeed :=
  sourceMandateDispositionFor sourceMandateHistory

/-! ## Source provenance and positive authority -/

theorem sourceMandate_event_has_exact_trace :
    ∃ state ∈ SourceMandateGame.occurrence.trace,
      SourceMandateSeedAt SourceMandateGame.source state
        sourceMandateRenewalFace.event :=
  electionRenewal_event_mem_actual_trace
    sourceMandateHistory lineageCompiler

@[simp] theorem sourceMandate_event_is_current :
    sourceMandateRenewalFace.event = sourceMandateHistory.current :=
  rfl

@[simp] theorem sourceMandate_controller_lineage_exact :
    sourceMandateRenewalFace.actor.1 = 11 :=
  rfl

theorem sourceMandate_office_relation_has_exact_trace :
    OfficeRelationTraceAt sourceMandateHistory :=
  continuing_office_relation_has_exact_trace_provenance 0

theorem sourceMandate_office_and_relation_exact :
    (mandateOffice sourceMandateHistory lineageCompiler).1 =
        lineageCompiler.officeOf sourceMandateHistory.current.officeSeed ∧
      (generatedOfficeControllerRelation sourceMandateHistory
          lineageCompiler).1.office = 7 ∧
      (generatedOfficeControllerRelation sourceMandateHistory
          lineageCompiler).1.controller = 11 :=
  ⟨(continuing_lineages_and_relation_exact 0).2.1,
    (continuing_lineages_and_relation_exact 0).2.2.1,
    (continuing_lineages_and_relation_exact 0).2.2.2⟩

@[simp] theorem sourceMandate_relation_phase_is_renew :
    (officeControllerRelationCompiler sourceMandateHistory lineageCompiler
      ).phaseStep
        (generatedOfficeControllerRelation sourceMandateHistory
          lineageCompiler) = MandatePhase.renew :=
  rfl

@[simp] theorem sourceMandate_target_role_is_held :
    (officeControllerRelationCompiler sourceMandateHistory lineageCompiler
      ).roleAt
        (generatedOfficeControllerRelation sourceMandateHistory
          lineageCompiler) .target = MandateRole.held :=
  continuing_target_role_is_held 0

@[simp] theorem sourceMandate_power_consumer_exact :
    sourceMandateConsumer.1.1 =
      mandateActionPower sourceMandateHistory lineageCompiler :=
  rfl

theorem sourceMandate_has_exact_M2_power :
    Nonempty (ExactMandatePower sourceMandateHistory lineageCompiler) :=
  ⟨sourceMandateConsumer.1.1⟩

@[simp] theorem sourceMandate_power_is_restored :
    sourceMandateConsumer.1.1.freedomChange.kind =
      FreedomChangeKind.restored := by
  rw [sourceMandate_power_consumer_exact]
  exact continuing_power_is_restored 0

def sourceMandate_M1_consumer :
    SourceOwnsResponsibilityIncidence
      (mandateVocabulary lineageCompiler)
      sourceMandateHistory.current
      (mandateObligation lineageCompiler sourceMandateHistory.current) :=
  sourceMandateConsumer.2

theorem sourceMandate_has_M1_consumer :
    Nonempty (SourceOwnsResponsibilityIncidence
      (mandateVocabulary lineageCompiler)
      sourceMandateHistory.current
      (mandateObligation lineageCompiler sourceMandateHistory.current)) :=
  ⟨sourceMandate_M1_consumer⟩

theorem sourceMandate_disposition_stays_live :
    sourceMandateDisposition.1.target.slots[
        (mandateSlot lineageCompiler sourceMandateHistory.current).val]? =
      some (.live
        (mandateObligation lineageCompiler sourceMandateHistory.current)) :=
  continuing_disposition_stays_live 0

/-! ## Actual non-eternity controls -/

/-- The later exit event is not admitted by the earlier continuing source. -/
theorem sourceMandate_wrong_current_event_rejected :
    ¬ ((electionActionController sourceMandateHistory lineageCompiler)
      |>.actionAdmittedAt (exitingEvent 1)) :=
  wrong_current_event_is_rejected 0

abbrev sourceMandateExitHistory : ActualHistory := exitingHistory 0

abbrev SourceMandateExitGame :=
  SourceMandateGameFor sourceMandateExitHistory

abbrev SourceMandateExitSeed :=
  SourceMandateSeedFor sourceMandateExitHistory

abbrev SourceMandateExitSeedAt :=
  SourceMandateSeedAtFor sourceMandateExitHistory

abbrev SourceMandateExitConsumerAt :=
  SourceMandateConsumerAtFor sourceMandateExitHistory

abbrev SourceMandateExitDispositionAt :=
  SourceMandateDispositionAtFor sourceMandateExitHistory

abbrev SourceMandateExitRenewalFace :=
  SourceMandateRenewalFaceFor sourceMandateExitHistory

def sourceMandateExitFace : SourceMandateExitRenewalFace :=
  sourceMandateRenewalFaceFor sourceMandateExitHistory

abbrev sourceMandateExitSeed :=
  sourceMandateSeedFor sourceMandateExitHistory

def sourceMandateExitConsumer :
    SourceMandateExitConsumerAt sourceMandateExitSeed :=
  sourceMandateConsumerFor sourceMandateExitHistory

def sourceMandateExitDisposition :
    SourceMandateExitDispositionAt sourceMandateExitSeed :=
  sourceMandateDispositionFor sourceMandateExitHistory

theorem sourceMandate_exit_retains_prior_trace :
    sourceMandateHistory.current ∈ sourceMandateExitHistory.occurrence.trace :=
  exit_event_retains_prior_actual_history 0

@[simp] theorem sourceMandate_exit_role_is_exited :
    (officeControllerRelationCompiler sourceMandateExitHistory lineageCompiler
      ).roleAt
        (generatedOfficeControllerRelation sourceMandateExitHistory
          lineageCompiler) .target = MandateRole.exited :=
  exit_target_role_is_exited 0

@[simp] theorem sourceMandate_exit_power_is_lost :
    (mandateActionPower sourceMandateExitHistory
      lineageCompiler).freedomChange.kind = FreedomChangeKind.lost :=
  exit_power_is_lost 0

theorem sourceMandate_exit_disposition_is_terminal :
    ∃ archive,
      sourceMandateExitFace.exactDisposition.1.target.slots[
          (mandateSlot lineageCompiler
            sourceMandateExitHistory.current).val]? =
        some (.terminal archive) :=
  exit_disposition_is_terminal 0

/-! ## Root-independent law mouth -/

/-- Exact law family expected by `withRenewalProjection`.  It fixes only the
chosen existing election history, its seed family, consumer and disposition;
a later root must still generate its own occurrence-indexed entry, row and
successor. -/
abbrev SourceMandateRenewalLawForAt
    (history : ActualHistory)
    {N : WorldRelationNetwork}
    {RootV : ConstructiveRoot.Vocabulary}
    (source : SourceNativeLedgerSource N RootV) :=
  SourceNativeRenewalProjectionLaw source (SourceMandateGameFor history)
    (SourceMandateSeedFor history) (SourceMandateSeedAtFor history)
    (SourceMandateConsumerAtFor history)
    (SourceMandateDispositionAtFor history)

/-- Backward-compatible standing specialization. -/
abbrev SourceMandateRenewalLawAt
    {N : WorldRelationNetwork}
    {RootV : ConstructiveRoot.Vocabulary}
    (source : SourceNativeLedgerSource N RootV) :=
  SourceMandateRenewalLawForAt sourceMandateHistory source

/-- Domain name for the generic root-owned renewal shell.  The shell remains
the existing root compiler's entry/row/successor interface; it contains no
election authority of its own. -/
abbrev SourceMandateRenewalRootShellAt
    {N : WorldRelationNetwork}
    {RootV : ConstructiveRoot.Vocabulary}
    (source : SourceNativeLedgerSource N RootV) :=
  SourceNativeRenewalRootShellAt source

/-- Assemble the exact history-indexed mandate law from a later root's own
ledger shell.  The local payload is definitionally the corresponding
source-generated face. -/
def sourceMandateRenewalLawFor
    (history : ActualHistory)
    {N : WorldRelationNetwork}
    {RootV : ConstructiveRoot.Vocabulary}
    {source : SourceNativeLedgerSource N RootV}
    (shell : SourceMandateRenewalRootShellAt source) :
    SourceMandateRenewalLawForAt history source :=
  SourceNativeRenewalProjectionLaw.ofRootShell shell
    (sourceMandateSeedFor history) (sourceMandateConsumerFor history)
      (sourceMandateDispositionFor history)

/-- Backward-compatible standing law. -/
def sourceMandateRenewalLaw
    {N : WorldRelationNetwork}
    {RootV : ConstructiveRoot.Vocabulary}
    {source : SourceNativeLedgerSource N RootV}
    (shell : SourceMandateRenewalRootShellAt source) :
    SourceMandateRenewalLawAt source :=
  sourceMandateRenewalLawFor sourceMandateHistory shell

/-- Direct pre-emitter splice.  This changes only an arbitrary supplied
authority source's projection inventory; it installs no emitter or living
root and preserves the source's existing ledger compiler definitionally. -/
def withSourceMandateRenewalFor
    (history : ActualHistory)
    {N : WorldRelationNetwork}
    {RootV : ConstructiveRoot.Vocabulary}
    (base : SourceNativeAuthoritySource N RootV)
    (shell : SourceMandateRenewalRootShellAt
      base.restructuringSource.toLedgerSource) :
    SourceNativeAuthoritySource N RootV :=
  withRenewalProjection base (sourceMandateRenewalLawFor history shell)

/-- Backward-compatible standing uplift. -/
def withSourceMandateRenewal
    {N : WorldRelationNetwork}
    {RootV : ConstructiveRoot.Vocabulary}
    (base : SourceNativeAuthoritySource N RootV)
    (shell : SourceMandateRenewalRootShellAt
      base.restructuringSource.toLedgerSource) :
    SourceNativeAuthoritySource N RootV :=
  withSourceMandateRenewalFor sourceMandateHistory base shell

/-- The exact mandate law is a faithful coordinate of the generic uplift.
This is an installation witness for a later root constructor, not a root or
post-emitter recognition. -/
def sourceMandateRenewalComponentFor
    (history : ActualHistory)
    {N : WorldRelationNetwork}
    {RootV : ConstructiveRoot.Vocabulary}
    (base : SourceNativeAuthoritySource N RootV)
    (shell : SourceMandateRenewalRootShellAt
      base.restructuringSource.toLedgerSource) :
    SourceNativeProjectionLaw.InstallationAt
      (sourceMandateRenewalLawFor history shell).toProjectionLaw
      (withSourceMandateRenewalFor history base shell).projectionLaw :=
  renewalComponent base (sourceMandateRenewalLawFor history shell)

/-- Backward-compatible standing installation witness. -/
def sourceMandateRenewalComponent
    {N : WorldRelationNetwork}
    {RootV : ConstructiveRoot.Vocabulary}
    (base : SourceNativeAuthoritySource N RootV)
    (shell : SourceMandateRenewalRootShellAt
      base.restructuringSource.toLedgerSource) :
    SourceNativeProjectionLaw.InstallationAt
      (sourceMandateRenewalLaw shell).toProjectionLaw
      (withSourceMandateRenewal base shell).projectionLaw :=
  sourceMandateRenewalComponentFor sourceMandateHistory base shell

/-! ### Exit-law specialization -/

abbrev SourceMandateExitRenewalLawAt
    {N : WorldRelationNetwork}
    {RootV : ConstructiveRoot.Vocabulary}
    (source : SourceNativeLedgerSource N RootV) :=
  SourceMandateRenewalLawForAt sourceMandateExitHistory source

def sourceMandateExitRenewalLaw
    {N : WorldRelationNetwork}
    {RootV : ConstructiveRoot.Vocabulary}
    {source : SourceNativeLedgerSource N RootV}
    (shell : SourceMandateRenewalRootShellAt source) :
    SourceMandateExitRenewalLawAt source :=
  sourceMandateRenewalLawFor sourceMandateExitHistory shell

def withSourceMandateExitRenewal
    {N : WorldRelationNetwork}
    {RootV : ConstructiveRoot.Vocabulary}
    (base : SourceNativeAuthoritySource N RootV)
    (shell : SourceMandateRenewalRootShellAt
      base.restructuringSource.toLedgerSource) :
    SourceNativeAuthoritySource N RootV :=
  withSourceMandateRenewalFor sourceMandateExitHistory base shell

def sourceMandateExitRenewalComponent
    {N : WorldRelationNetwork}
    {RootV : ConstructiveRoot.Vocabulary}
    (base : SourceNativeAuthoritySource N RootV)
    (shell : SourceMandateRenewalRootShellAt
      base.restructuringSource.toLedgerSource) :
    SourceNativeProjectionLaw.InstallationAt
      (sourceMandateExitRenewalLaw shell).toProjectionLaw
      (withSourceMandateExitRenewal base shell).projectionLaw :=
  sourceMandateRenewalComponentFor sourceMandateExitHistory base shell

/-! ## Mouth-level no-forgery controls -/

/-- If one exact history-indexed local face were unavailable, its disposition
alone could not forge it: the same source seed and consumer would immediately
regenerate the missing face. -/
theorem noExactLocalFaceFor_noDisposition
    (history : ActualHistory)
    (noFace : IsEmpty (SourceMandateRenewalFaceFor history)) :
    IsEmpty (SourceMandateDispositionAtFor history
      (sourceMandateSeedFor history)) :=
  ⟨fun disposition => noFace.false
    (SourceGeneratedRenewalFace.generate (sourceMandateSeedFor history)
      (sourceMandateConsumerFor history) disposition)⟩

/-- Backward-compatible standing specialization. -/
theorem noExactLocalFace_noDisposition
    (noFace : IsEmpty SourceMandateRenewalFace) :
    IsEmpty (SourceMandateDispositionAt sourceMandateSeed) :=
  noExactLocalFaceFor_noDisposition sourceMandateHistory noFace

/-- The same boundary holds at the law mouth.  Every active law payload
regenerates a local face, so root rows or successors cannot manufacture
mandate authority after the local producer has disappeared. -/
theorem noExactLocalFaceFor_noActiveLawPayload
    (history : ActualHistory)
    {N : WorldRelationNetwork}
    {RootV : ConstructiveRoot.Vocabulary}
    {source : SourceNativeLedgerSource N RootV}
    (noFace : IsEmpty (SourceMandateRenewalFaceFor history))
    (law : SourceMandateRenewalLawForAt history source)
    {current : RootV.Current}
    (occurrence : source.source.toRootSource.actual.OccurrenceAt current)
    (active : law.ActiveAt occurrence) : False :=
  noFace.false (SourceGeneratedRenewalFace.generate
    (law.compile occurrence active).sourceSeed
    (law.compile occurrence active).consumer
    (law.compile occurrence active).disposition)

/-- Backward-compatible standing specialization. -/
theorem noExactLocalFace_noActiveLawPayload
    {N : WorldRelationNetwork}
    {RootV : ConstructiveRoot.Vocabulary}
    {source : SourceNativeLedgerSource N RootV}
    (noFace : IsEmpty SourceMandateRenewalFace)
    (law : SourceMandateRenewalLawAt source)
    {current : RootV.Current}
    (occurrence : source.source.toRootSource.actual.OccurrenceAt current)
    (active : law.ActiveAt occurrence) : False :=
  noExactLocalFaceFor_noActiveLawPayload sourceMandateHistory noFace law
    occurrence active

/-- Regression guard: the local face and law mouth contain no social-choice
or completed-period authority fields. -/
theorem sourceMandateFor_mouth_has_no_preference_or_future_fields
    (history : ActualHistory) : True := by
  let face := sourceMandateRenewalFaceFor history
  fail_if_success exact face.preference
  fail_if_success exact face.aggregation
  fail_if_success exact face.truth
  fail_if_success exact face.periodicTable
  trivial

theorem sourceMandate_mouth_has_no_preference_or_future_fields : True :=
  sourceMandateFor_mouth_has_no_preference_or_future_fields
    sourceMandateHistory

end
