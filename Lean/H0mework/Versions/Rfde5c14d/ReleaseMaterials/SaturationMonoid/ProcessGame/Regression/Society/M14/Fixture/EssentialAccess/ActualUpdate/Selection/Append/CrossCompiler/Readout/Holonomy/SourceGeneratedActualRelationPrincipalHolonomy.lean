/-!
# Principal holonomy of the actual relation-renewal cycle

The same three-edge residual already generated by the unique cross runtime is
reduced to `C4` and sent through the existing faithful `C4 → U(1)` character.
The resulting P259/P260 transition family is a post-produced readout of that
cycle.  It does not install a phase table, relation compiler, occurrence,
runtime, root, ledger, or completed future.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceGeneratedActualRelationPrincipalHolonomy

noncomputable section

open AffineRelaxation
open M14SourceGeneratedActualRelationThreeCycle
open M14ProofCarryingActualRelationThreeCycleResidual
open M14SourceGeneratedCrossCompilerRelationAppendPresentation

/-! ## Generated C4 and U(1) phase -/

/-- The integer residual of the actual cycle, reduced through the existing
`C4` carrier. -/
def actualRelationCycleC4Phase (base : Nat) : Go.TacticalPhase :=
  Int.cast (threeAgentRingResidual (actualRelationCycleCochain base))

@[simp] theorem actualRelationCycleC4Phase_eq_three (base : Nat) :
    actualRelationCycleC4Phase base = 3 := by
  rw [actualRelationCycleC4Phase,
    actualRelationCycle_residual_eq_three base]
  rfl

/-- The faithful unit-circle character of the generated cycle residual. -/
noncomputable def actualRelationCycleRotation (base : Nat) : Circle :=
  Go.TacticalPhase.rotation (actualRelationCycleC4Phase base)

theorem actualRelationCycleRotation_complex_eq_neg_I (base : Nat) :
    ((actualRelationCycleRotation base : Circle) : ℂ) = -Complex.I := by
  rw [actualRelationCycleRotation, actualRelationCycleC4Phase_eq_three]
  exact Go.TacticalPhase.rotation_three_complex

theorem actualRelationCycleRotation_ne_one (base : Nat) :
    actualRelationCycleRotation base ≠ 1 := by
  apply (Go.TacticalPhase.rotation_ne_one_iff _).2
  rw [actualRelationCycleC4Phase_eq_three]
  decide

/-! ## P259 discrete principal holonomy -/

/-- Readout indices for the lineage-closed lifted path.  These are not process
occurrences: the actual four forward occurrences remain in the cycle producer.
-/
inductive ActualRelationHolonomyIndex where
  | source
  | lifted
  | returned
  deriving DecidableEq, Repr

/-- The lifted detour carries the rotation of the complete generated cycle;
the direct transition between seed-equal endpoints is the identity. -/
noncomputable def actualRelationPrincipalTransition (base : Nat) :
    ActualRelationHolonomyIndex → ActualRelationHolonomyIndex → Circle
  | .source, .lifted => actualRelationCycleRotation base
  | _, _ => 1

theorem actualRelation_principalTriangleHolonomy_eq_rotation (base : Nat) :
    principalTriangleHolonomy (actualRelationPrincipalTransition base)
        .source .lifted .returned =
      actualRelationCycleRotation base := by
  simp [principalTriangleHolonomy, actualRelationPrincipalTransition]

theorem actualRelation_principalTriangleHolonomy_ne_one (base : Nat) :
    principalTriangleHolonomy (actualRelationPrincipalTransition base)
        .source .lifted .returned ≠ 1 := by
  rw [actualRelation_principalTriangleHolonomy_eq_rotation]
  exact actualRelationCycleRotation_ne_one base

theorem actualRelation_principalHolonomyObstruction (base : Nat) :
    PrincipalHolonomyObstruction
      (actualRelationPrincipalTransition base) :=
  ⟨.source, .lifted, .returned,
    actualRelation_principalTriangleHolonomy_ne_one base⟩

theorem actualRelation_principalConnection_not_flat (base : Nat) :
    ¬ FlatPrincipalConnection (actualRelationPrincipalTransition base) :=
  (principalHolonomyObstruction_iff_not_flat
    (actualRelationPrincipalTransition base)).mp
      (actualRelation_principalHolonomyObstruction base)

theorem actualRelation_principalTransition_not_oneCoboundary (base : Nat) :
    ¬ PrincipalOneCoboundary (actualRelationPrincipalTransition base) := by
  intro exactTransition
  exact actualRelation_principalConnection_not_flat base
    (principalOneCoboundary_flat
      (actualRelationPrincipalTransition base) exactTransition)

theorem actualRelation_principalTransport_comp_eq_holonomy (base : Nat) :
    principalTransport (actualRelationPrincipalTransition base)
        .lifted .returned
        (principalTransport (actualRelationPrincipalTransition base)
          .source .lifted (1 : Circle)) =
      principalTriangleHolonomy (actualRelationPrincipalTransition base)
          .source .lifted .returned •
        principalTransport (actualRelationPrincipalTransition base)
          .source .returned (1 : Circle) :=
  principalTransport_comp_eq_holonomy
    (actualRelationPrincipalTransition base)
    .source .lifted .returned (1 : Circle)

theorem actualRelation_principalTransport_comp_mismatch (base : Nat) :
    principalTransport (actualRelationPrincipalTransition base)
        .lifted .returned
        (principalTransport (actualRelationPrincipalTransition base)
          .source .lifted (1 : Circle)) ≠
      principalTransport (actualRelationPrincipalTransition base)
        .source .returned (1 : Circle) := by
  simpa [principalTransport, actualRelationPrincipalTransition] using
    actualRelationCycleRotation_ne_one base

/-! ## P260 topological principal holonomy -/

/-- Every readout chart covers the unique base point. -/
def actualRelationPrincipalCover :
    TopologicalPrincipalCover Unit ActualRelationHolonomyIndex where
  U := fun _ => Set.univ
  isOpen_U := fun _ => isOpen_univ
  covers := fun point => ⟨.source, Set.mem_univ point⟩

/-- The same generated discrete transition, viewed as a constant topological
transition over the one-point base. -/
noncomputable def topologicalActualRelationPrincipalTransition
    (base : Nat) :
    ActualRelationHolonomyIndex → ActualRelationHolonomyIndex → Unit → Circle :=
  fun first last _ => actualRelationPrincipalTransition base first last

theorem topologicalActualRelationPrincipalTransition_continuous
    (base : Nat) :
    ContinuousOnPrincipalTransitions actualRelationPrincipalCover
      (topologicalActualRelationPrincipalTransition base) := by
  intro first last
  exact continuousOn_const

theorem unit_mem_actualRelationPrincipal_tripleOverlap :
    () ∈ actualRelationPrincipalCover.tripleOverlap
      ActualRelationHolonomyIndex.source
      ActualRelationHolonomyIndex.lifted
      ActualRelationHolonomyIndex.returned := by
  simp [actualRelationPrincipalCover,
    TopologicalPrincipalCover.tripleOverlap]

theorem topologicalActualRelation_holonomy_eq_rotation (base : Nat) :
    topologicalPrincipalTriangleHolonomy
        (topologicalActualRelationPrincipalTransition base)
        .source .lifted .returned () =
      actualRelationCycleRotation base := by
  simp [topologicalPrincipalTriangleHolonomy,
    topologicalActualRelationPrincipalTransition,
    actualRelationPrincipalTransition]

theorem topologicalActualRelationPrincipalHolonomyObstruction (base : Nat) :
    TopologicalPrincipalHolonomyObstruction actualRelationPrincipalCover
      (topologicalActualRelationPrincipalTransition base) := by
  refine ⟨.source, .lifted, .returned, (),
    unit_mem_actualRelationPrincipal_tripleOverlap, ?_⟩
  rw [topologicalActualRelation_holonomy_eq_rotation]
  exact actualRelationCycleRotation_ne_one base

theorem topologicalActualRelationPrincipal_not_flat (base : Nat) :
    ¬ TopologicalPrincipalFlatOn actualRelationPrincipalCover
      (topologicalActualRelationPrincipalTransition base) :=
  (topologicalPrincipalHolonomyObstruction_iff_not_flat
    actualRelationPrincipalCover
    (topologicalActualRelationPrincipalTransition base)).mp
      (topologicalActualRelationPrincipalHolonomyObstruction base)

theorem topologicalActualRelationPrincipal_not_exactTransition (base : Nat) :
    ¬ ∃ potential : ActualRelationHolonomyIndex → Unit → Circle,
      topologicalActualRelationPrincipalTransition base =
        topologicalPrincipalExactTransition potential := by
  rintro ⟨potential, exactTransition⟩
  apply topologicalActualRelationPrincipal_not_flat base
  simpa [exactTransition] using
    (topologicalPrincipalExactTransition_flatOn
      actualRelationPrincipalCover potential)

theorem topologicalActualRelationPrincipal_transport_comp_eq_holonomy
    (base : Nat) :
    topologicalPrincipalTransport
        (topologicalActualRelationPrincipalTransition base)
        .lifted .returned ()
        (topologicalPrincipalTransport
          (topologicalActualRelationPrincipalTransition base)
          .source .lifted () (1 : Circle)) =
      topologicalPrincipalTriangleHolonomy
          (topologicalActualRelationPrincipalTransition base)
          .source .lifted .returned () •
        topologicalPrincipalTransport
          (topologicalActualRelationPrincipalTransition base)
          .source .returned () (1 : Circle) :=
  topologicalPrincipalTransport_comp_eq_holonomy
    (topologicalActualRelationPrincipalTransition base)
    .source .lifted .returned () (1 : Circle)

theorem topologicalActualRelationPrincipal_transport_comp_mismatch
    (base : Nat) :
    topologicalPrincipalTransport
        (topologicalActualRelationPrincipalTransition base)
        .lifted .returned ()
        (topologicalPrincipalTransport
          (topologicalActualRelationPrincipalTransition base)
          .source .lifted () (1 : Circle)) ≠
      topologicalPrincipalTransport
        (topologicalActualRelationPrincipalTransition base)
        .source .returned () (1 : Circle) := by
  simpa [topologicalPrincipalTransport,
    topologicalActualRelationPrincipalTransition,
    actualRelationPrincipalTransition] using
      actualRelationCycleRotation_ne_one base

/-! ## Same-cycle provenance and direct consumer -/

theorem actualRelationPrincipalHolonomy_provenance (base : Nat) :
    type_of% (actualRelationThreeCycleResidual_directConsumer base) ∧
      actualRelationSeedAt (base + 3) = actualRelationSeedAt base ∧
      (crossCompilerActionPresentationAt (base + 3)).erase ≠
        (crossCompilerActionPresentationAt base).erase ∧
      actualRelationCycleC4Phase base = 3 ∧
      principalTriangleHolonomy (actualRelationPrincipalTransition base)
          .source .lifted .returned =
        actualRelationCycleRotation base :=
  ⟨actualRelationThreeCycleResidual_directConsumer base,
    (sourceGeneratedActualRelationThreeCycleAt base).seedClosure,
    (sourceGeneratedActualRelationThreeCycleAt base).renewedOccurrenceDistinct,
    actualRelationCycleC4Phase_eq_three base,
    actualRelation_principalTriangleHolonomy_eq_rotation base⟩

theorem actualRelationPrincipalHolonomy_directConsumer (base : Nat) :
    type_of% (actualRelationPrincipalHolonomy_provenance base) ∧
      ((actualRelationCycleRotation base : Circle) : ℂ) = -Complex.I ∧
      PrincipalHolonomyObstruction
        (actualRelationPrincipalTransition base) ∧
      ¬ FlatPrincipalConnection (actualRelationPrincipalTransition base) ∧
      ¬ PrincipalOneCoboundary (actualRelationPrincipalTransition base) ∧
      type_of% (actualRelation_principalTransport_comp_eq_holonomy base) ∧
      type_of% (actualRelation_principalTransport_comp_mismatch base) ∧
      ContinuousOnPrincipalTransitions actualRelationPrincipalCover
        (topologicalActualRelationPrincipalTransition base) ∧
      TopologicalPrincipalHolonomyObstruction actualRelationPrincipalCover
        (topologicalActualRelationPrincipalTransition base) ∧
      ¬ TopologicalPrincipalFlatOn actualRelationPrincipalCover
        (topologicalActualRelationPrincipalTransition base) ∧
      (¬ ∃ potential : ActualRelationHolonomyIndex → Unit → Circle,
        topologicalActualRelationPrincipalTransition base =
          topologicalPrincipalExactTransition potential) ∧
      type_of%
        (topologicalActualRelationPrincipal_transport_comp_eq_holonomy base) ∧
      type_of%
        (topologicalActualRelationPrincipal_transport_comp_mismatch base) := by
  refine ⟨actualRelationPrincipalHolonomy_provenance base,
    actualRelationCycleRotation_complex_eq_neg_I base,
    actualRelation_principalHolonomyObstruction base,
    actualRelation_principalConnection_not_flat base,
    actualRelation_principalTransition_not_oneCoboundary base,
    actualRelation_principalTransport_comp_eq_holonomy base,
    actualRelation_principalTransport_comp_mismatch base,
    topologicalActualRelationPrincipalTransition_continuous base,
    topologicalActualRelationPrincipalHolonomyObstruction base,
    topologicalActualRelationPrincipal_not_flat base,
    ?_,
    topologicalActualRelationPrincipal_transport_comp_eq_holonomy base,
    topologicalActualRelationPrincipal_transport_comp_mismatch base⟩
  exact topologicalActualRelationPrincipal_not_exactTransition base

end
