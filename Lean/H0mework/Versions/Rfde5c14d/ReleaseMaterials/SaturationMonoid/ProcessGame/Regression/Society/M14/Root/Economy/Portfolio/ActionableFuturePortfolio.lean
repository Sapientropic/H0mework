open M14GeneratedEconomicDisposition
open M14SourceEssentialServiceRestoration

/-! ## Existing source-domain readouts -/

abbrev EssentialDomainSeed :=
  essentialAccessRelationCompiler.ExactRelationSeed

def authoritySeed : EssentialAccessRelationAuthority → EssentialDomainSeed
  | .tenure _ => exactEssentialAccessSeed .tenure
  | .health _ => exactEssentialAccessSeed .health

def domainActor (domain : EssentialAccessRelationAuthority) :
    essentialAccessRelationCompiler.Actor :=
  (authoritySeed domain).actor essentialAccessRelationCompiler

def domainRelation (domain : EssentialAccessRelationAuthority) :
    essentialAccessRelationCompiler.GeneratedRelation :=
  essentialAccessRelationCompiler.relationOf (authoritySeed domain)

def domainPhase (domain : EssentialAccessRelationAuthority) :
    EssentialAccessSector :=
  essentialAccessRelationCompiler.phaseStep (domainRelation domain)

def domainTargetRole : EssentialAccessRelationAuthority → EssentialAccessRole
  | .tenure _ => .tenureProvider
  | .health _ => .healthProvider

theorem domainInterest (domain : EssentialAccessRelationAuthority) :
    essentialAccessRelationCompiler.GeneratedInterestAt
      (domainActor domain) (domainRelation domain) := by
  cases domain with
  | tenure interest => exact interest
  | health interest => exact interest

theorem domainPhase_is_relation_generated
    (domain : EssentialAccessRelationAuthority) :
    essentialAccessRelationCompiler.phaseStep (domainRelation domain) =
      domainPhase domain := by
  cases domain <;> rfl

theorem domainTargetRole_is_relation_generated
    (domain : EssentialAccessRelationAuthority) :
    essentialAccessRelationCompiler.RelationRoleAt
      (domainActor domain) (domainRelation domain) .target
        (domainTargetRole domain) := by
  cases domain with
  | tenure interest => exact ⟨interest, rfl⟩
  | health interest => exact ⟨interest, rfl⟩

/-! ## Source-generated domain/service incidences -/

def tenureSlotAt (depth : Nat) : Fin (anomiePhaseAt depth).served.length :=
  firstSlotAt depth

def healthSlotAt (depth : Nat) : Fin (anomiePhaseAt depth).served.length :=
  ⟨1, by rw [anomiePhaseAt_served_length]; decide⟩

/-- A fixed source compiler sends the exact relation event to the exact queue
occurrence carrying that service domain.  It returns a queue occurrence, not
a served slot or a success verdict. -/
def essentialDomainServiceUnitAt (seed : EssentialDomainSeed) :
    (installedCompilerAt 0).QueueUnit :=
  essentialServiceUnitOfEvent seed.1

/-- A domain is serviced only when its compiler-generated queue occurrence
actually lies in the served prefix.  The slot is an output witness. -/
structure SourceGeneratedEssentialDomainServiceIncidenceAt
    (depth : Nat) (seed : EssentialDomainSeed) : Type 18 where
  private mk ::
  slot : Fin (anomiePhaseAt depth).served.length
  servicedUnit_eq :
    (anomiePhaseAt depth).served.get slot = essentialDomainServiceUnitAt seed
  actualService : (serviceCompilerAt depth).ServesAt
    ((anomiePhaseAt depth).served.get slot)
    (run.events.get
      (Fin.cast (actualSettlementAt depth).eventsLength_eq_allocated.symm slot))
  rootOccurrenceExact :
    (periodicSourceBackedPaymentAt depth).rootOccurrence =
      M9ProofCarryingRenewalInquiryRoot.jointRoot.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
        (temporalVisitAt depth)

def tenureDomainServiceIncidenceAt (depth : Nat) :
    SourceGeneratedEssentialDomainServiceIncidenceAt depth
      (exactEssentialAccessSeed .tenure) where
  slot := tenureSlotAt depth
  servicedUnit_eq := rfl
  actualService := (actualSettlementAt depth).serviceReceiptAt _
  rootOccurrenceExact := (periodicSourceBackedPaymentAt depth).rootOccurrence_eq

def healthDomainServiceIncidenceAt (depth : Nat) :
    SourceGeneratedEssentialDomainServiceIncidenceAt depth
      (exactEssentialAccessSeed .health) where
  slot := healthSlotAt depth
  servicedUnit_eq := rfl
  actualService := (actualSettlementAt depth).serviceReceiptAt _
  rootOccurrenceExact := (periodicSourceBackedPaymentAt depth).rootOccurrence_eq

theorem tenureDomainService_slot_eq (depth : Nat)
    (incidence : SourceGeneratedEssentialDomainServiceIncidenceAt depth
      (exactEssentialAccessSeed .tenure)) :
    incidence.slot = tenureSlotAt depth := by
  rcases incidence with ⟨⟨index, index_lt⟩, serviced, _actual, _root⟩
  apply Fin.ext
  cases index with
  | zero => rfl
  | succ index =>
      cases index with
      | zero =>
          change middleUnit = firstUnit at serviced
          exact False.elim <| first_middle_positions_are_distinct
            (congrArg Sigma.fst serviced.symm)
      | succ index =>
          change Nat.succ (Nat.succ index) < 2 at index_lt
          omega

theorem healthDomainService_slot_eq (depth : Nat)
    (incidence : SourceGeneratedEssentialDomainServiceIncidenceAt depth
      (exactEssentialAccessSeed .health)) :
    incidence.slot = healthSlotAt depth := by
  rcases incidence with ⟨⟨index, index_lt⟩, serviced, _actual, _root⟩
  apply Fin.ext
  cases index with
  | zero =>
      change firstUnit = middleUnit at serviced
      exact False.elim <| first_middle_positions_are_distinct
        (congrArg Sigma.fst serviced)
  | succ index =>
      cases index with
      | zero => rfl
      | succ index =>
          change Nat.succ (Nat.succ index) < 2 at index_lt
          omega

def fullDomainServiceIncidenceAt (depth : Nat)
    (domain : EssentialAccessRelationAuthority) :
    SourceGeneratedEssentialDomainServiceIncidenceAt depth
      (authoritySeed domain) := by
  cases domain with
  | tenure _ => exact tenureDomainServiceIncidenceAt depth
  | health _ => exact healthDomainServiceIncidenceAt depth

def domainSlotAt (depth : Nat) (domain : EssentialAccessRelationAuthority) :
    Fin (anomiePhaseAt depth).served.length :=
  (fullDomainServiceIncidenceAt depth domain).slot

def domainCrossingAt (depth : Nat)
    (domain : EssentialAccessRelationAuthority) :
    (crossingCompilerAt depth).ExactCrossing :=
  ExactServedCrossingDebitedRunAt.servicedCrossingAt
    (phase := anomiePhaseAt depth)
    (crossingCompiler := crossingCompilerAt depth)
    (domainSlotAt depth domain)

def domainServiceReceiptAt (depth : Nat)
    (domain : EssentialAccessRelationAuthority) :
    (serviceCompilerAt depth).ServesAt
      ((anomiePhaseAt depth).served.get (domainSlotAt depth domain))
      (run.events.get
        (Fin.cast (actualSettlementAt depth).eventsLength_eq_allocated.symm
          (domainSlotAt depth domain))) :=
  (fullDomainServiceIncidenceAt depth domain).actualService

def domainFeasibleExitAt (depth : Nat)
    (domain : EssentialAccessRelationAuthority) :
    ExactFeasibleExitEdgeAt (geometryCompilerAt depth)
      ExitFutureCode.leave (domainSlotAt depth domain) :=
  FeasibleExitEdgeAt.generate
    (actualSettlement := actualSettlementAt depth)
    actionableExit.2 SourceBackedUBIPaymentReceiptAt.generate
      (SourceGeneratedUBIRouteReceiptAt.generate (domainCrossingAt depth domain))

/-! ## Domain component and dependent portfolio -/

structure SourceGeneratedEssentialDomainActionableAt
    (depth : Nat) (domain : EssentialAccessRelationAuthority) : Type 18 where
  private mk ::
  relationInterest : essentialAccessRelationCompiler.GeneratedInterestAt
    (domainActor domain) (domainRelation domain)
  phaseGenerated :
    essentialAccessRelationCompiler.phaseStep (domainRelation domain) =
      domainPhase domain
  targetRoleGenerated : essentialAccessRelationCompiler.RelationRoleAt
    (domainActor domain) (domainRelation domain) .target
      (domainTargetRole domain)
  serviceIncidence : SourceGeneratedEssentialDomainServiceIncidenceAt
    depth (authoritySeed domain)
  feasible : ExactFeasibleExitEdgeAt (geometryCompilerAt depth)
    ExitFutureCode.leave serviceIncidence.slot
  uncaptured : ¬ noCapture.Captures ExitFutureCode.leave

def sourceGeneratedEssentialDomainActionableAt
    (depth : Nat) (domain : EssentialAccessRelationAuthority) :
    SourceGeneratedEssentialDomainActionableAt depth domain where
  relationInterest := domainInterest domain
  phaseGenerated := domainPhase_is_relation_generated domain
  targetRoleGenerated := domainTargetRole_is_relation_generated domain
  serviceIncidence := fullDomainServiceIncidenceAt depth domain
  feasible := domainFeasibleExitAt depth domain
  uncaptured := by simp [noCapture]

structure SourceGeneratedActionableFuturePortfolioAt (depth : Nat) : Type 18 where
  private mk ::
  paymentOccurrence : PeriodicSourceBackedPaymentAt depth
  paymentOccurrence_eq : paymentOccurrence = periodicSourceBackedPaymentAt depth
  rootOccurrenceExact : paymentOccurrence.rootOccurrence =
    M9ProofCarryingRenewalInquiryRoot.jointRoot.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
      (temporalVisitAt depth)
  actionable : (domain : EssentialAccessRelationAuthority) →
    SourceGeneratedEssentialDomainActionableAt depth domain

def sourceGeneratedActionableFuturePortfolioAt (depth : Nat) :
    SourceGeneratedActionableFuturePortfolioAt depth where
  paymentOccurrence := periodicSourceBackedPaymentAt depth
  paymentOccurrence_eq := rfl
  rootOccurrenceExact :=
    (periodicSourceBackedPaymentAt depth).rootOccurrence_eq
  actionable := sourceGeneratedEssentialDomainActionableAt depth

theorem every_generated_period_has_actionable_future_portfolio
    (depth : Nat) :
    Nonempty (SourceGeneratedActionableFuturePortfolioAt depth) :=
  ⟨sourceGeneratedActionableFuturePortfolioAt depth⟩

/-! ## Same domains under a second exact source prefix -/

def stablePrefixAt (depth : Nat) :
    SourceGeneratedExactQueuePrefixAt (installedCompilerAt depth) :=
  SourceGeneratedExactQueuePrefixAt.generate (installedCompilerAt depth)
    ⟨1, by rw [installedCompilerAt_queue_length]; decide⟩

def stablePhaseAt (depth : Nat) :
    SourceGeneratedOccurrenceCapacityPhaseAt
      (installedUBIAt depth) (installedCompilerAt depth) (stablePrefixAt depth) :=
  SourceGeneratedOccurrenceCapacityPhaseAt.generate
    (installedUBIAt depth) (installedCompilerAt depth) (stablePrefixAt depth)

@[simp] theorem stablePrefixAt_cut (depth : Nat) :
    (stablePrefixAt depth).cut = 1 :=
  rfl

@[simp] theorem stablePhaseAt_served_length (depth : Nat) :
    (stablePhaseAt depth).served.length = 1 :=
  rfl

theorem stable_anomie_prefixes_distinct (depth : Nat) :
    stablePrefixAt depth ≠ anomiePrefixAt depth := by
  intro equality
  have cuts := congrArg SourceGeneratedExactQueuePrefixAt.cut equality
  change (1 : Nat) = 3 at cuts
  omega

def singleServiceRun : P.Run sourceState firstMaintenance.target :=
  .step .nil firstMaintenance

def singleServiceDebited :
    NativeDebitedRun P debitProcess () singleServiceRun :=
  .step (.nil sourceState) firstMaintenance DebitEvent.first

def stableActualSettlementAt (depth : Nat) :
    ExactServedCrossingDebitedRunAt (stablePhaseAt depth)
      singleServiceDebited (serviceCompilerAt depth) where
  sourceBudget_eq_capacity := rfl
  eventsLength_eq_allocated := rfl
  serviceAt := by
    rintro ⟨index, index_lt⟩
    cases index with
    | zero => exact firstServiceReceiptAt depth
    | succ index =>
        change Nat.succ index < 1 at index_lt
        omega

def stableSlotAt (depth : Nat) : Fin (stablePhaseAt depth).served.length :=
  ⟨0, by rw [stablePhaseAt_served_length]; decide⟩

def stableGeometryCompilerAt (depth : Nat) : SourceOwnedExitGeometryCompilerAt
    exitCapacityProgram (stablePhaseAt depth) (crossingCompilerAt depth)
      singleServiceRun (serviceCompilerAt depth)
        (stableActualSettlementAt depth) where
  PaysForAt := SourceBackedUBIPaymentReceiptAt
  RoutesAt := SourceGeneratedUBIRouteReceiptAt

def stableFirstFeasibleExitAt (depth : Nat) :
    ExactFeasibleExitEdgeAt (stableGeometryCompilerAt depth)
      ExitFutureCode.leave (stableSlotAt depth) :=
  FeasibleExitEdgeAt.generate
    (actualSettlement := stableActualSettlementAt depth)
    actionableExit.2 SourceBackedUBIPaymentReceiptAt.generate
      (SourceGeneratedUBIRouteReceiptAt.generate _)

theorem stablePortfolioCapacity_eq_one (depth : Nat) :
    (stableGeometryCompilerAt depth).actionableExitCapacity = 1 := by
  have positive : 0 < (stableGeometryCompilerAt depth).actionableExitCapacity :=
    (stableGeometryCompilerAt depth).capacity_positive_iff_feasible_edge.mpr
      ⟨ExitFutureCode.leave, stableSlotAt depth,
        ⟨stableFirstFeasibleExitAt depth⟩⟩
  have upper :=
    (stableGeometryCompilerAt depth).capacity_le_surviving_actionable_codes
  rw [survivingCodes_card_eq_one] at upper
  exact Nat.le_antisymm upper (Nat.succ_le_iff.mpr positive)

/-- The same domain-to-queue compiler is now evaluated against the exact
one-unit prefix.  Health maps to the actual middle queue occurrence, which is
not in this served prefix. -/
structure SourceGeneratedStableDomainServiceIncidenceAt
    (depth : Nat) (seed : EssentialDomainSeed) : Type 18 where
  private mk ::
  slot : Fin (stablePhaseAt depth).served.length
  servicedUnit_eq :
    (stablePhaseAt depth).served.get slot = essentialDomainServiceUnitAt seed
  actualService : (serviceCompilerAt depth).ServesAt
    ((stablePhaseAt depth).served.get slot)
    (singleServiceRun.events.get
      (Fin.cast (stableActualSettlementAt depth).eventsLength_eq_allocated.symm
        slot))
  rootOccurrenceExact :
    (periodicSourceBackedPaymentAt depth).rootOccurrence =
      M9ProofCarryingRenewalInquiryRoot.jointRoot.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
        (temporalVisitAt depth)

def stableTenureDomainServiceIncidenceAt (depth : Nat) :
    SourceGeneratedStableDomainServiceIncidenceAt depth
      (exactEssentialAccessSeed .tenure) where
  slot := stableSlotAt depth
  servicedUnit_eq := rfl
  actualService := (stableActualSettlementAt depth).serviceReceiptAt _
  rootOccurrenceExact := (periodicSourceBackedPaymentAt depth).rootOccurrence_eq

instance stableHealthDomainServiceIncidence_isEmpty (depth : Nat) :
    IsEmpty (SourceGeneratedStableDomainServiceIncidenceAt depth
      (exactEssentialAccessSeed .health)) :=
  ⟨fun incidence => by
    rcases incidence with ⟨⟨index, index_lt⟩, serviced, _actual, _root⟩
    cases index with
    | zero =>
        change firstUnit = middleUnit at serviced
        have first_ne_middle : firstUnit ≠ middleUnit :=
          SourceOwnedOccurrenceRateCompiler.QueueUnit.ne_of_position_ne
            (installedCompilerAt depth) first_middle_positions_are_distinct
        exact first_ne_middle serviced
    | succ index =>
        change Nat.succ index < 1 at index_lt
        omega⟩

structure SourceGeneratedStableEssentialDomainActionableAt
    (depth : Nat) (domain : EssentialAccessRelationAuthority) : Type 18 where
  private mk ::
  serviceIncidence : SourceGeneratedStableDomainServiceIncidenceAt depth
    (authoritySeed domain)
  feasible : ExactFeasibleExitEdgeAt (stableGeometryCompilerAt depth)
    ExitFutureCode.leave serviceIncidence.slot
  relationInterest : essentialAccessRelationCompiler.GeneratedInterestAt
    (domainActor domain) (domainRelation domain)

def sourceGeneratedStableTenureActionableAt (depth : Nat) :
    SourceGeneratedStableEssentialDomainActionableAt
      depth tenureAuthority where
  serviceIncidence := stableTenureDomainServiceIncidenceAt depth
  feasible := stableFirstFeasibleExitAt depth
  relationInterest := tenureInterest

abbrev StableActionableFuturePortfolioAt (depth : Nat) :=
  (domain : EssentialAccessRelationAuthority) →
    SourceGeneratedStableEssentialDomainActionableAt depth domain

instance stablePortfolio_isEmpty (depth : Nat) :
    IsEmpty (StableActionableFuturePortfolioAt depth) :=
  ⟨fun portfolio =>
    (stableHealthDomainServiceIncidence_isEmpty depth).false
      (portfolio healthAuthority).serviceIncidence⟩

structure SourceGeneratedStableServiceStateAt (depth : Nat) : Type 18 where
  private mk ::
  paymentOccurrence : PeriodicSourceBackedPaymentAt depth
  paymentOccurrence_eq : paymentOccurrence = periodicSourceBackedPaymentAt depth
  sourcePrefix : SourceGeneratedExactQueuePrefixAt (installedCompilerAt depth)
  sourcePrefix_eq : sourcePrefix = stablePrefixAt depth
  actualSettlement : ExactServedCrossingDebitedRunAt (stablePhaseAt depth)
    singleServiceDebited (serviceCompilerAt depth)
  tenureActionable : SourceGeneratedStableEssentialDomainActionableAt
    depth tenureAuthority
  healthServiceUnavailable :
    IsEmpty (SourceGeneratedStableDomainServiceIncidenceAt depth
      (exactEssentialAccessSeed .health))
  exactCapacity : (stableGeometryCompilerAt depth).actionableExitCapacity = 1

def sourceGeneratedStableServiceStateAt (depth : Nat) :
    SourceGeneratedStableServiceStateAt depth where
  paymentOccurrence := periodicSourceBackedPaymentAt depth
  paymentOccurrence_eq := rfl
  sourcePrefix := stablePrefixAt depth
  sourcePrefix_eq := rfl
  actualSettlement := stableActualSettlementAt depth
  tenureActionable := sourceGeneratedStableTenureActionableAt depth
  healthServiceUnavailable := stableHealthDomainServiceIncidence_isEmpty depth
  exactCapacity := stablePortfolioCapacity_eq_one depth

abbrev EssentialPortfolioSourceAt (depth : Nat) :=
  SourceGeneratedActionableFuturePortfolioAt depth ⊕
    SourceGeneratedStableServiceStateAt depth

def fullPortfolioSourceAt (depth : Nat) : EssentialPortfolioSourceAt depth :=
  .inl (sourceGeneratedActionableFuturePortfolioAt depth)

def stablePortfolioSourceAt (depth : Nat) : EssentialPortfolioSourceAt depth :=
  .inr (sourceGeneratedStableServiceStateAt depth)

theorem full_stable_sources_distinct (depth : Nat) :
    fullPortfolioSourceAt depth ≠ stablePortfolioSourceAt depth := by
  intro equality
  cases equality

def portfolioCapacityReadoutAt (depth : Nat) :
    EssentialPortfolioSourceAt depth → Nat
  | .inl _ => (geometryCompilerAt depth).actionableExitCapacity
  | .inr _ => (stableGeometryCompilerAt depth).actionableExitCapacity

def CompletePortfolioAt (depth : Nat) :
    EssentialPortfolioSourceAt depth → Type 18
  | .inl _ => SourceGeneratedActionableFuturePortfolioAt depth
  | .inr _ => StableActionableFuturePortfolioAt depth

instance stableSource_completePortfolio_isEmpty (depth : Nat) :
    IsEmpty (CompletePortfolioAt depth (stablePortfolioSourceAt depth)) :=
  stablePortfolio_isEmpty depth

/-! ## Existing viable branch strengthened by the portfolio -/

structure SourceGeneratedPortfolioViableEconomicDispositionAt
    (occurrence : RootedAccountedUnfolding M14EconomicSingleFold.ExactEconomicAtom)
    (image : M14EconomicSingleFold.EconomicFoldImage)
    (landing : EconomicLanding) : Type 18 where
  private mk ::
  depth : Nat
  viable : SourceGeneratedPostRepairViableEconomicDispositionAt
    occurrence image landing
  viableDepthExact : viable.depth = depth
  portfolio : SourceGeneratedActionableFuturePortfolioAt (depth + 1)
  samePaymentOccurrence : HEq
    portfolio.paymentOccurrence viable.actualExit.paymentOccurrence
  sameEconomicRootEvent : occurrence.root.erasedRootEvent =
    ⟨temporalVisitAt (depth + 1),
      portfolio.paymentOccurrence.rootOccurrence⟩
  sameImage : image = M14EconomicSingleFold.economicImage occurrence
  sameLanding : landing = ordinaryEconomicLandingAt depth

def portfolioViableEconomicDispositionAt (depth : Nat) :
    SourceGeneratedPortfolioViableEconomicDispositionAt
      (postRepairViableExposureAt depth) (postRepairViableImageAt depth)
        (ordinaryEconomicLandingAt depth) :=
  let viable := postRepairViableEconomicDispositionAt depth
  let portfolio := sourceGeneratedActionableFuturePortfolioAt (depth + 1)
  { depth := depth
    viable := viable
    viableDepthExact := rfl
    portfolio := portfolio
    samePaymentOccurrence := HEq.rfl
    sameEconomicRootEvent := by
      rw [portfolio.paymentOccurrence_eq]
      exact postRepairViableExposureAt_rootEvent depth
    sameImage := rfl
    sameLanding := rfl }

def fixedPortfolioViableEconomicDisposition :
    SourceGeneratedPortfolioViableEconomicDispositionAt
      postRepairViableExposure postRepairViableImage
        (ordinaryEconomicLandingAt 0) :=
  portfolioViableEconomicDispositionAt 0

theorem fixedPortfolioViable_paymentOccurrence_eq :
    fixedPortfolioViableEconomicDisposition.portfolio.paymentOccurrence =
      fixedPortfolioViableEconomicDisposition.viable.actualExit.paymentOccurrence :=
  rfl

theorem fixedPortfolioViable_rootEvent :
    postRepairViableExposure.root.erasedRootEvent =
      ⟨temporalVisitAt 1,
        fixedPortfolioViableEconomicDisposition.portfolio
          |>.paymentOccurrence |>.rootOccurrence⟩ := by
  change postRepairViableExposure.root.erasedRootEvent =
    ⟨temporalVisitAt 1,
      (periodicSourceBackedPaymentAt 1).rootOccurrence⟩
  exact postRepairViableExposure_rootEvent

end
