import H0mework.Versions.Rfde5c14d.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Root.PeriodicMandatePowerRenewal
import H0mework.Versions.Rfde5c14d.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Consumer.Legislation.UBIProofCarryingLegislationRegression

/-!
# M14 proof-carrying periodic mandate-power renewal

This direct consumer joins the visit-indexed mandate coordinate to the
existing proof-carrying renewal coordinate at the same literal root visit.
It adds no election ontology or schedule: the local mandate face is produced
before the emitter, while temporal identity, the operational consumer,
whole-ledger authority, and the immediate next are generated by `jointRoot`.

Ordinary UBI repair and automatic self-U8 remain different branches.  Public
recognition of authority therefore neither eternalizes it nor acquires the
right to select an institutional revision.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14ProofCarryingPeriodicMandatePowerRenewalRegression

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Renewal Legislation Revision
open ConstructiveRoot.RootInquiryCompletion
open M9ProofCarryingRenewalInquiryRoot
open M14SourceMandateRenewal
open M14UBIPeriodicRootHistory
open M14PeriodicMandatePowerRenewal
open M14UBIProofCarryingLegislationRegression

def installedProofCarryingRenewalAt (depth : Nat) :
    SourceInstalledRenewalAt jointRecognition (temporalVisitAt depth) :=
  SourceInstalledRenewalAt.generate PUnit.unit rfl

/-- Mandate and PCL are different coordinates of one compiler image at every
generated visit. -/
theorem mandate_and_pcl_root_authority_commutes (depth : Nat) :
    let mandate := periodicMandatePowerRenewalAt depth
    let pcl := installedProofCarryingRenewalAt depth
    mandate.installed.payload.sourceEntry = pcl.payload.sourceEntry ∧
      HEq mandate.installed.payload.selectedRow pcl.payload.selectedRow ∧
      HEq mandate.installed.payload.successor pcl.payload.successor ∧
      HEq mandate.installed.operationalAuthority pcl.operationalAuthority ∧
      mandate.installed.RootAnswerAndNextFactorizes ∧
      pcl.RootAnswerAndNextFactorizes := by
  exact ⟨rfl, HEq.rfl, HEq.rfl, HEq.rfl,
    (periodicMandatePowerRenewalAt depth).rootFactorization,
    (installedProofCarryingRenewalAt depth).rootAnswerAndNext_factorizes⟩

/-- The root responsibility consumer is generated from the exact mandate
installation; it is not stored in the local election face. -/
theorem every_depth_has_root_responsibility_consumer (depth : Nat) :
    Nonempty (RenewalResponsibilityConsumerAt
      (periodicMandatePowerRenewalAt depth
        ).installed.operationalAuthority) :=
  ⟨(periodicMandatePowerRenewalAt depth
    ).installed.rootResponsibilityConsumer⟩

/-- A root row cannot manufacture mandate authority after removing the exact
local source face. -/
theorem no_local_face_no_current_root_mandate
    (noFace : IsEmpty SourceMandateRenewalFace) :
    IsEmpty (mandateLaw.ActiveAt
      (RootInquiryU8CompletionRegression.root.emitted ())) :=
  ⟨fun active => noExactLocalFace_noActiveLawPayload noFace mandateLaw
    (RootInquiryU8CompletionRegression.root.emitted ()) active⟩

/-- Installing periodic power does not merge or select the two already
generated institutional branches. -/
theorem mandate_does_not_choose_revision_branch (depth : Nat) :
    Nonempty
        (SourceGeneratedProofCarryingPeriodicMandatePowerRenewalAt depth) ∧
      sourceGeneratedUBIProofCarryingLegislation.policyLegislation.branchKind =
        SourceGeneratedInstitutionalRevisionKind.revolution ∧
      (⟨M9ProofCarryingRenewalInquiryRoot.N,
        sourceGeneratedUBIProofCarryingLegislation.ordinaryRepair.generatedNext⟩ :
          AnyAuthoritativeRootCurrent) ≠
        sourceGeneratedUBIProofCarryingLegislation.policyLegislation.generatedNext :=
  ⟨⟨periodicMandatePowerRenewalAt depth⟩,
    ubiProofCarryingLegislationDirectConsumer.automaticSelfU8.1,
    ubiProofCarryingLegislationDirectConsumer
      |>.distinctOrdinaryAndRevolutionaryNexts⟩

structure ProofCarryingPeriodicMandatePowerRenewalCertificate : Prop where
  periodic : PeriodicMandatePowerRenewalCertificate
  sameRootPCL : ∀ depth : Nat,
    let mandate := periodicMandatePowerRenewalAt depth
    let pcl := installedProofCarryingRenewalAt depth
    mandate.installed.payload.sourceEntry = pcl.payload.sourceEntry ∧
      HEq mandate.installed.payload.selectedRow pcl.payload.selectedRow ∧
      HEq mandate.installed.payload.successor pcl.payload.successor ∧
      HEq mandate.installed.operationalAuthority pcl.operationalAuthority ∧
      mandate.installed.RootAnswerAndNextFactorizes ∧
      pcl.RootAnswerAndNextFactorizes
  everyDepthRootConsumer : ∀ depth : Nat,
    Nonempty (RenewalResponsibilityConsumerAt
      (periodicMandatePowerRenewalAt depth
        ).installed.operationalAuthority)
  exactLocalFaceRequired : IsEmpty SourceMandateRenewalFace →
    IsEmpty (mandateLaw.ActiveAt
      (RootInquiryU8CompletionRegression.root.emitted ()))
  ordinaryAndSelfU8RemainDistinct : ∀ depth : Nat,
    Nonempty
        (SourceGeneratedProofCarryingPeriodicMandatePowerRenewalAt depth) ∧
      sourceGeneratedUBIProofCarryingLegislation.policyLegislation.branchKind =
        SourceGeneratedInstitutionalRevisionKind.revolution ∧
      (⟨M9ProofCarryingRenewalInquiryRoot.N,
        sourceGeneratedUBIProofCarryingLegislation.ordinaryRepair.generatedNext⟩ :
          AnyAuthoritativeRootCurrent) ≠
        sourceGeneratedUBIProofCarryingLegislation.policyLegislation.generatedNext

theorem proofCarryingPeriodicMandatePowerRenewalDirectConsumer :
    ProofCarryingPeriodicMandatePowerRenewalCertificate where
  periodic := periodicMandatePowerRenewalDirectConsumer
  sameRootPCL := mandate_and_pcl_root_authority_commutes
  everyDepthRootConsumer := every_depth_has_root_responsibility_consumer
  exactLocalFaceRequired := no_local_face_no_current_root_mandate
  ordinaryAndSelfU8RemainDistinct :=
    mandate_does_not_choose_revision_branch

end
end M14ProofCarryingPeriodicMandatePowerRenewalRegression
end Society
end ProcessGame
end SaturationMonoid

