abbrev ActualCaptureRepairAt (depth : Nat) :=
  SourceGeneratedOrdinaryEconomicDispositionAt
    (tenureRepairExposureAt depth) (tenureEconomicImageAt depth)
      (ordinaryEconomicLandingAt depth)

/-! ## Receipt-indexed ordinary normal form -/

/-- The common ordinary landing generated by two different installed actions.

`service` and `capture` are dependent indices.  They cannot be supplied by a
target portfolio or reconstructed from the target's scalar appearance. -/
structure SourceGeneratedOrdinaryEconomicNormalFormAt
    (depth : Nat)
    (service : SourceGeneratedProofCarryingEssentialServiceRestorationAt depth)
    (capture : ActualCaptureRepairAt depth)
    (next : SourceNativeAuthoritativeRootCurrentAt
      M9ProofCarryingRenewalInquiryRoot.N) : Type 18 where
  private mk ::
  serviceActionExact : service.installed.payload.disposition =
    sourceGeneratedHealthServiceRestoration
  captureActionExact : capture.renewal.source.installed.payload.disposition =
    sourceGeneratedUBIDisposition
  captureRepairExact :
    canonicalRepairAt (tenureCaptureOriginAt depth) = .removeCapture
  captureDepthExact : capture.depth = depth
  coordinatesDistinct :
    jointEssentialServiceRestorationProjection ≠ jointUBIProjection
  serviceRootOccurrenceExact : service.rootOccurrence =
    jointRoot.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
      (temporalVisitAt depth)
  captureExposureRootEventExact :
    (tenureRepairExposureAt depth).root.erasedRootEvent =
      ⟨temporalVisitAt depth,
        (periodicSourceBackedPaymentAt depth).rootOccurrence⟩
  captureRootOccurrenceExact : HEq capture.renewal.rootOccurrence
    (jointRoot.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
      (temporalVisitAt depth))
  serviceEntryExact : service.installed.payload.sourceEntry =
    RootInquiryU8CompletionRegression.entry
  captureEntryExact : capture.renewal.source.installed.payload.sourceEntry =
    RootInquiryU8CompletionRegression.entry
  serviceRowSharedWithUBI :
    HEq service.installed.payload.selectedRow
      (installedUBIAt depth).payload.selectedRow
  captureRowSharedWithUBI :
    HEq capture.renewal.source.installed.payload.selectedRow
      (installedUBIAt depth).payload.selectedRow
  serviceSelectedWriteExact : service.applied.selectedWrite =
    service.installed.temporalSelectedRow
  captureSelectedWriteExact : capture.renewal.ordinarySelectedWrite =
    capture.renewal.source.installed.temporalSelectedRow
  serviceSelectedWriteCommutes :
    service.applied.selectedWrite.sourceRow.CommutesWithWorld
  captureSelectedWriteCommutes :
    capture.renewal.ordinarySelectedWrite.sourceRow.CommutesWithWorld
  wholeLedgerShared : service.applied.wholeLedgerWriteBack =
    capture.renewal.wholeLedgerWriteBack
  serviceRootFactorization : service.installed.RootAnswerAndNextFactorizes
  captureRootFactorization :
    capture.renewal.source.installed.RootAnswerAndNextFactorizes
  nextIsService : next = service.applied.generatedNext
  nextIsCapture : next = capture.renewal.generatedNext
  nextIsRoot : next =
    jointRoot.generatedNextCurrentAt (temporalVisitAt depth)
  nextVisitExact : HEq next.visit (temporalVisitAt (depth + 1))
  ordinaryLandingExact : ordinaryEconomicLandingAt depth = some
    (⟨M9ProofCarryingRenewalInquiryRoot.N, next⟩ :
      AnyAuthoritativeRootCurrent)
  targetPortfolio : SourceGeneratedActionableFuturePortfolioAt (depth + 1)
  targetPortfolioExact : targetPortfolio = service.targetPortfolio
  targetPortfolioRootExact : targetPortfolio.paymentOccurrence.rootOccurrence =
    jointRoot.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
      (temporalVisitAt (depth + 1))
  targetTenure : SourceGeneratedEssentialDomainActionableAt
    (depth + 1) tenureAuthority
  targetHealth : SourceGeneratedEssentialDomainActionableAt
    (depth + 1) healthAuthority
  targetHealthServesAction :
    (anomiePhaseAt (depth + 1)).served.get
        targetHealth.serviceIncidence.slot =
      SourceAppliedEssentialServiceRestorationAt.unitAt
        service.installed.payload.disposition
  targetProgramFromCaptureAction :
    (installedUBIAt (depth + 1)).payload.consumer.programAt =
      capture.renewal.source.installed.payload.disposition.targetProgramAt
  targetProgramExact :
    capture.renewal.source.installed.payload.disposition.targetProgramAt =
      exitCapacityProgram
  targetUncaptured : ¬ noCapture.Captures ExitFutureCode.leave
  targetCapacity :
    (geometryCompilerAt (depth + 1)).actionableExitCapacity = 1
  lawSurfacePreserved : next.root.source.lawSurface =
    jointRoot.source.base.lawSurface

namespace SourceGeneratedOrdinaryEconomicNormalFormAt

/-- Typed next readout from the normal form's index. -/
def generatedNext
    {depth : Nat}
    {service : SourceGeneratedProofCarryingEssentialServiceRestorationAt depth}
    {capture : ActualCaptureRepairAt depth}
    {next : SourceNativeAuthoritativeRootCurrentAt
      M9ProofCarryingRenewalInquiryRoot.N}
    (_normal : SourceGeneratedOrdinaryEconomicNormalFormAt
      depth service capture next) := next

end SourceGeneratedOrdinaryEconomicNormalFormAt

/-- Canonical normal form.  Both actual action receipts occur in its type;
the computed target is only a downstream field. -/
def sourceGeneratedOrdinaryEconomicNormalFormAt (depth : Nat) :
    SourceGeneratedOrdinaryEconomicNormalFormAt depth
      (sourceGeneratedEssentialServiceRestorationAt depth)
      (ordinaryEconomicDispositionAt depth)
      (sourceGeneratedEssentialServiceRestorationAt depth).applied.generatedNext := by
  let service := sourceGeneratedEssentialServiceRestorationAt depth
  let capture := ordinaryEconomicDispositionAt depth
  exact
    { serviceActionExact := service.actionExact
      captureActionExact := capture.renewal.source.exactDisposition
      captureRepairExact := capture.renewal.repair_eq_removeCapture
      captureDepthExact := rfl
      coordinatesDistinct := service.serviceProjectionDistinctFromUBI
      serviceRootOccurrenceExact := service.rootOccurrenceExact
      captureExposureRootEventExact := tenureRepairExposure_rootEvent depth
      captureRootOccurrenceExact := HEq.rfl
      serviceEntryExact := service.sourceEntryExact
      captureEntryExact := rfl
      serviceRowSharedWithUBI := service.selectedRowSharedWithUBI
      captureRowSharedWithUBI := HEq.rfl
      serviceSelectedWriteExact := service.applied.selectedWrite_eq_installedSelectedRow
      captureSelectedWriteExact :=
        capture.renewal.ordinarySelectedWrite_eq_installedSelectedRow
      serviceSelectedWriteCommutes := service.selectedWriteCommutes
      captureSelectedWriteCommutes := capture.selectedWriteCommutes
      wholeLedgerShared :=
        service.wholeLedgerExact.trans capture.wholeLedgerExact.symm
      serviceRootFactorization := service.rootFactorization
      captureRootFactorization := capture.rootFactorization
      nextIsService := rfl
      nextIsCapture :=
        service.generatedNextExact.trans capture.generatedNextExact.symm
      nextIsRoot := service.generatedNextExact
      nextVisitExact := by
        rw [service.generatedNextExact]
        exact HEq.rfl
      ordinaryLandingExact := by
        change
          some
              (⟨M9ProofCarryingRenewalInquiryRoot.N,
                (actualOrdinaryRenewalAt depth).generatedNext⟩ :
                AnyAuthoritativeRootCurrent) =
            some
              (⟨M9ProofCarryingRenewalInquiryRoot.N,
                service.applied.generatedNext⟩ :
                AnyAuthoritativeRootCurrent)
        rw [(actualOrdinaryRenewalAt depth).generatedNext_eq_rootCompiler,
          service.generatedNextExact]
      targetPortfolio := service.targetPortfolio
      targetPortfolioExact := rfl
      targetPortfolioRootExact := service.targetPortfolio.rootOccurrenceExact
      targetTenure := service.targetPortfolio.actionable tenureAuthority
      targetHealth := service.targetHealth
      targetHealthServesAction := service.targetHealthServesActionUnit
      targetProgramFromCaptureAction :=
        capture.renewal.generatedNext_repairedFace_capacity_eq_one.2.1
      targetProgramExact := by
        rw [capture.renewal.source.exactDisposition]
        rfl
      targetUncaptured := service.targetHealth.uncaptured
      targetCapacity := service.targetCapacityExact
      lawSurfacePreserved := service.lawSurfacePreserved }

theorem normalForm_next_is_canonical
    {depth : Nat}
    {service : SourceGeneratedProofCarryingEssentialServiceRestorationAt depth}
    {capture : ActualCaptureRepairAt depth}
    {next : SourceNativeAuthoritativeRootCurrentAt
      M9ProofCarryingRenewalInquiryRoot.N}
    (normal : SourceGeneratedOrdinaryEconomicNormalFormAt
      depth service capture next) :
    next = jointRoot.generatedNextCurrentAt (temporalVisitAt depth) :=
  normal.nextIsRoot

/-! ## Periodic death-repair diamond -/

/-- Both local deaths, both necessary ordinary actions, and their common
normal form at one generated temporal occurrence. -/
structure SourceGeneratedPeriodicDeathRepairNormalizationAt
    (depth : Nat) : Type 18 where
  private mk ::
  service : SourceGeneratedProofCarryingEssentialServiceRestorationAt depth
  captureDeath : SourceGeneratedPortfolioCaptureDeathAt depth
    (fullPortfolioSourceAt depth) fullCapture
  serviceExact : service = sourceGeneratedEssentialServiceRestorationAt depth
  captureDeathExact : captureDeath = portfolioCaptureDeathAt depth
  maintenanceRootExact :
    service.sourceDeath.stable.paymentOccurrence.rootOccurrence =
      service.rootOccurrence
  captureRootExact :
    captureDeath.fullServices.paymentOccurrence.rootOccurrence =
      service.rootOccurrence
  sourcesDistinct :
    stablePortfolioSourceAt depth ≠ fullPortfolioSourceAt depth
  maintenanceHealthEmpty : IsEmpty
    (SourceGeneratedStableDomainServiceIncidenceAt depth
      (exactEssentialAccessSeed .health))
  captureHealthLive : SourceGeneratedEssentialDomainActionableAt
    depth healthAuthority
  maintenanceUncaptured : ¬ noCapture.Captures ExitFutureCode.leave
  captureCaptured : fullCapture.Captures ExitFutureCode.leave
  normalForm : SourceGeneratedOrdinaryEconomicNormalFormAt depth
    service captureDeath.ordinaryRepair service.applied.generatedNext
  serviceCannotBeReplacedByCaptureRepair : IsEmpty
    (CompletePortfolioAt depth (stablePortfolioSourceAt depth))
  captureCannotBeReplacedByServiceRepair : IsEmpty
    (CapturedActionableFuturePortfolioAt depth)
  groundedTerminalEmpty : IsEmpty
    (SourceGeneratedGroundedEconomicTerminalAt
      (tenureRepairExposureAt depth) (tenureEconomicImageAt depth) none)
  adjacentOccurrencesDistinct : periodicPaymentOccurrenceAt depth ≠
    periodicPaymentOccurrenceAt (depth + 1)

/-- Sole periodic producer. -/
def sourceGeneratedPeriodicDeathRepairNormalizationAt (depth : Nat) :
    SourceGeneratedPeriodicDeathRepairNormalizationAt depth := by
  let service := sourceGeneratedEssentialServiceRestorationAt depth
  let captureDeath := portfolioCaptureDeathAt depth
  let normalForm := sourceGeneratedOrdinaryEconomicNormalFormAt depth
  exact
    { service := service
      captureDeath := captureDeath
      serviceExact := rfl
      captureDeathExact := rfl
      maintenanceRootExact := service.sourceDeathRootExact
      captureRootExact :=
        captureDeath.paymentRootExact.trans service.rootOccurrenceExact.symm
      sourcesDistinct := (full_stable_sources_distinct depth).symm
      maintenanceHealthEmpty := service.sourceDeathHealthEmpty
      captureHealthLive := captureDeath.healthServiceLive
      maintenanceUncaptured := service.sourceDeath.uncaptured
      captureCaptured := captureDeath.captured
      normalForm := normalForm
      serviceCannotBeReplacedByCaptureRepair :=
        service.sourceDeathPortfolioEmpty
      captureCannotBeReplacedByServiceRepair :=
        captureDeath.capturedPortfolioEmpty
      groundedTerminalEmpty := service.sourceDeath.groundedTerminalEmpty
      adjacentOccurrencesDistinct :=
        adjacent_payment_occurrences_are_distinct depth }

theorem every_generated_period_has_normalization (depth : Nat) :
    Nonempty (SourceGeneratedPeriodicDeathRepairNormalizationAt depth) :=
  ⟨sourceGeneratedPeriodicDeathRepairNormalizationAt depth⟩

theorem ordinary_actions_converge_but_do_not_substitute (depth : Nat) :
    let step := sourceGeneratedPeriodicDeathRepairNormalizationAt depth
    step.service.applied.generatedNext =
        step.captureDeath.ordinaryRepair.renewal.generatedNext ∧
      jointEssentialServiceRestorationProjection ≠ jointUBIProjection ∧
      IsEmpty (CompletePortfolioAt depth (stablePortfolioSourceAt depth)) ∧
      IsEmpty (CapturedActionableFuturePortfolioAt depth) := by
  let step := sourceGeneratedPeriodicDeathRepairNormalizationAt depth
  exact ⟨step.normalForm.nextIsService.symm.trans
      step.normalForm.nextIsCapture,
    step.normalForm.coordinatesDistinct,
    step.serviceCannotBeReplacedByCaptureRepair,
    step.captureCannotBeReplacedByServiceRepair⟩

theorem periodic_normalization_mouth_has_no_forecast_or_u8_fields
    (depth : Nat) : True := by
  let normalization := sourceGeneratedPeriodicDeathRepairNormalizationAt depth
  fail_if_success exact normalization.completedHistory
  fail_if_success exact normalization.rank
  fail_if_success exact normalization.audit
  fail_if_success exact normalization.u8Gate
  fail_if_success exact normalization.firstWrite
  trivial

end
end M14PeriodicDeathRepairNormalization
