/-!
# Health-target critical-event selection U8 frontier

The old health target already inherits the RootInquiry failure coordinate.
At target depth one, the same exact visit supplies its living entry authority
and causal successor.  The old-selector no-go is consumed beside that installed
failure face; it is not used as a substitute obstruction or a revised target.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceGeneratedHealthTargetCriticalEventSelectionU8Frontier

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open ConstructiveRoot.RootInquiryCompletion
open ConstructiveRoot.ObstructionGeneratedMinimalCoface
open M9SourceHealthCessationSuffix
open M14SourceGeneratedHealthCessationTargetRoot
open M14SourceGeneratedHealthCessationTargetHistory
open M14HealthTargetCriticalEventSelectionNoGo

abbrev U7 := RootInquiryU8CompletionRegression.U7

theorem healthTargetTheoryAuditRootDispositionCommutesAt (depth : Nat) :
    U7DemandEntryRootDispositionCommutesAt
      RootInquiryU8CompletionRegression.theoryAuditCalculus
      (RootInquiryU8CompletionRegression.theoryAuditCalculus.source.emit
        RootInquiryU8CompletionRegression.obstruction)
      RootInquiryU8CompletionRegression.entry
      ((healthCessationTargetRoot.toAuthoritativeRoot.toLedgerRoot.source.ledgerCompiler.compile
        (healthCessationTargetRoot.emitted
          (healthCessationTargetTemporalVisitAt depth).current)
        ).entryDisposition RootInquiryU8CompletionRegression.entry) :=
  RootInquiryU8CompletionRegression.theoryAuditRootDispositionCommutes

def healthTargetFailureFaceAt (depth : Nat) :
    SourceNativeRootExpressibilityFailureFaceAt
      healthCessationTargetRoot.toAuthoritativeRoot
      (healthCessationTargetTemporalVisitAt depth) (U7 := U7)
      RootInquiryU8CompletionRegression.failure where
  lawSurface_eq := rfl
  projection := M9SourceHealthCessationSuffix.failureProjection
  active := ()
  classifier_eq := rfl
  calculus := RootInquiryU8CompletionRegression.theoryAuditCalculus
  u7Event := RootInquiryU8CompletionRegression.theoryAuditCalculus.source.emit
    RootInquiryU8CompletionRegression.obstruction
  u7Event_eq_emit := rfl
  theoryAudit := RootInquiryU8CompletionRegression.u7Gate
  support_eq := rfl
  rootEntry := RootInquiryU8CompletionRegression.entry
  rootEntryAtFailure_eq := rfl
  rootDispositionCommutes :=
    healthTargetTheoryAuditRootDispositionCommutesAt depth
  project_heq := HEq.rfl

def healthTargetFailureLivingAuthorityAt (depth : Nat) :
    SourceNativeLivingTemporalCausalEntryAuthorityAt
      healthCessationTargetRoot
      (healthCessationTargetTemporalVisitAt depth)
      RootInquiryU8CompletionRegression.entry := by
  rw [← healthCessationTargetVisitEntryAt_eq_entry depth]
  exact healthCessationTargetAuthorityAt depth

def healthTargetFailureAuthorityAt (depth : Nat) :
    SourceNativeAuthoritativeTemporalCausalEntryAuthorityAt
      healthCessationTargetRoot.toAuthoritativeRoot
      (healthCessationTargetTemporalVisitAt depth)
      RootInquiryU8CompletionRegression.entry :=
  (healthTargetFailureLivingAuthorityAt depth).toAuthoritativeAuthority

def healthTargetFailureSuccessorAt (depth : Nat) :
    CausalEntrySuccessorAt
      healthCessationTargetRoot.toAuthoritativeRoot.toLedgerRoot
      (healthCessationTargetTemporalVisitAt depth)
      RootInquiryU8CompletionRegression.entry :=
  CausalEntrySuccessorAt.ofNonterminal rfl

def healthTargetRootedSelectionFailureAt (depth : Nat) :
    RootedActualExpressibilityFailureAt
      healthCessationTargetRoot.toAuthoritativeRoot
      (healthCessationTargetTemporalVisitAt depth) U7
      RootInquiryU8CompletionRegression.failure :=
  RootedActualExpressibilityFailureAt.ofRootFailureFace
    (healthTargetFailureFaceAt depth) (healthTargetFailureAuthorityAt depth)
      (healthTargetFailureSuccessorAt depth)

def healthTargetSelectionCofaceAt (depth : Nat) :
    GeneratedMinimalCofaceAt (healthTargetRootedSelectionFailureAt depth) :=
  root_obstruction_generates_minimal_coface
    (healthTargetRootedSelectionFailureAt depth)

/-- Exact frontier at the macro-next visit.  The coface contains only the
rooted U8 direction; the selected relation seed is generated by the revised
current in the next construction. -/
structure HealthTargetCriticalEventSelectionU8Frontier : Type 12 where
  private mk ::
  oldSelectionObstruction : HealthTargetCriticalEventSelectionObstructionAt
  failureFace : SourceNativeRootExpressibilityFailureFaceAt
    healthCessationTargetRoot.toAuthoritativeRoot
    (healthCessationTargetTemporalVisitAt 1) (U7 := U7)
      RootInquiryU8CompletionRegression.failure
  failureFaceExact : failureFace = healthTargetFailureFaceAt 1
  rooted : RootedActualExpressibilityFailureAt
    healthCessationTargetRoot.toAuthoritativeRoot
    (healthCessationTargetTemporalVisitAt 1) U7
      RootInquiryU8CompletionRegression.failure
  rootedExact : rooted = healthTargetRootedSelectionFailureAt 1
  coface : GeneratedMinimalCofaceAt rooted
  cofaceExact : HEq coface (healthTargetSelectionCofaceAt 1)
  failureFactorizes :
    let generated :=
      healthCessationTargetRoot.toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit
        (healthCessationTargetTemporalVisitAt 1)
    generated =
        healthCessationTargetRoot.toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit
          (healthCessationTargetTemporalVisitAt 1) ∧
      HEq
        (healthCessationTargetRoot.toAuthoritativeRoot.source.projectionLaw.project
          failureFace.projection generated.occurrence failureFace.active)
        (SourceNativeRootExpressibilityFailureTokenAt.canonical
          (failure := RootInquiryU8CompletionRegression.failure)
          (calculus := failureFace.calculus) (event := failureFace.u7Event))

def sourceGeneratedHealthTargetCriticalEventSelectionU8Frontier :
    HealthTargetCriticalEventSelectionU8Frontier :=
  let face := healthTargetFailureFaceAt 1
  let rooted := healthTargetRootedSelectionFailureAt 1
  { oldSelectionObstruction := healthTargetCriticalEventSelectionObstruction
    failureFace := face
    failureFaceExact := rfl
    rooted := rooted
    rootedExact := rfl
    coface := healthTargetSelectionCofaceAt 1
    cofaceExact := HEq.rfl
    failureFactorizes := face.installedAuthority_factorizes }

end
end M14SourceGeneratedHealthTargetCriticalEventSelectionU8Frontier
