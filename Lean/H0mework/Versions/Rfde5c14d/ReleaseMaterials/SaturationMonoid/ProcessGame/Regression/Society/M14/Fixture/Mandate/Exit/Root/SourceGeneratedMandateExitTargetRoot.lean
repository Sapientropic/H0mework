import H0mework.Versions.Rfde5c14d.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M9.JointRoot.Mandate.SourceSuppliedMandateSuffix

/-!
# Source-generated mandate-exit target representation root

This is the concrete exit specialization of the one-slot M9 assembler.  The
target root contains the existing inventory with its sole mandate coordinate
compiled from the actual exiting history.  It is a representation target for
a later sequential actual action, not a sibling runtime or a second mandate
projection in the standing root.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceGeneratedMandateExitTargetRoot

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Renewal Election Relations Power UBI
open M8ActualElectionMandateRenewalRegression
open M9ProofCarryingRenewalInquiryRoot
open M9SourceSuppliedMandateSuffix
open M14SourceMandateRenewal
open M14UBIExitCapacityFixture
open M14UBIProofCarryingRootRestriction

abbrev N := M9ProofCarryingRenewalInquiryRoot.N
abbrev V := M9ProofCarryingRenewalInquiryRoot.V

/-- Concrete target representation with exactly one exit-mandate slot. -/
def mandateExitTargetRoot : SourceNativeLivingRootClosure N V :=
  jointRootFor sourceMandateExitHistory

def mandateExitTargetVisit : SourceNativeTemporalVisitAt
    mandateExitTargetRoot.toAuthoritativeRoot.toLedgerRoot :=
  jointVisitFor sourceMandateExitHistory

def mandateExitTargetRecognition : SourceNativeRenewalRecognitionAt
    mandateExitTargetRoot SourceMandateExitGame SourceMandateExitSeed
      SourceMandateExitSeedAt SourceMandateExitConsumerAt
        SourceMandateExitDispositionAt :=
  mandateRecognitionFor sourceMandateExitHistory

def installedMandateExit : SourceInstalledRenewalAt
    mandateExitTargetRecognition mandateExitTargetVisit :=
  SourceInstalledRenewalAt.generate PUnit.unit rfl

def installedMandateExitLocalFace : SourceMandateExitRenewalFace :=
  installedMandateExit.localFace
    (fun _ exactSeed =>
      lineageCompiler.controllerOf exactSeed.1.controllerSeed)
    (mandateStandingOf sourceMandateExitHistory lineageCompiler)

def mandateExitTargetUBIRecognition : SourceNativeRenewalRecognitionAt
    mandateExitTargetRoot M14UBIProofCarryingRootRestriction.LocalGame
      M14UBIProofCarryingRootRestriction.LocalSeed
      M14UBIProofCarryingRootRestriction.LocalSeedAt
      M14UBIProofCarryingRootRestriction.UBIConsumerAt
      M14UBIProofCarryingRootRestriction.UBIDispositionAt :=
  ubiRecognitionFor sourceMandateExitHistory

def installedMandateExitTargetUBI : SourceInstalledRenewalAt
    mandateExitTargetUBIRecognition mandateExitTargetVisit :=
  SourceInstalledRenewalAt.generate PUnit.unit rfl

/-- Target-root restriction of the existing UBI payment producer.  This is
the Payment in the action-generated representation, not a parallel source
occurrence. -/
structure MandateExitTargetSourceBackedPaymentAt : Type 3 where
  private mk ::
  installed : SourceInstalledRenewalAt
    mandateExitTargetUBIRecognition mandateExitTargetVisit
  exactRestriction : installed.payload.consumer =
    sourceGeneratedUBIRootRestriction
  rootOccurrence : ExactTemporalCausalRootEventAt
    mandateExitTargetRoot.toAuthoritativeRoot.toLedgerRoot
      mandateExitTargetVisit
  rootOccurrenceExact : rootOccurrence =
    (mandateExitTargetRoot.toAuthoritativeRoot.toLedgerRoot
      |>.exactTemporalCausalEventAt mandateExitTargetVisit)
  paymentReceipt : SourceBackedUBIPaymentReceiptAt
    exitCapacityProgram.purchasingPowerStanding ExitFutureCode.leave
  rootFactorization : installed.RootAnswerAndNextFactorizes

def mandateExitTargetSourceBackedPaymentAt :
    MandateExitTargetSourceBackedPaymentAt where
  installed := installedMandateExitTargetUBI
  exactRestriction := rfl
  rootOccurrence := mandateExitTargetRoot.toAuthoritativeRoot.toLedgerRoot
    |>.exactTemporalCausalEventAt mandateExitTargetVisit
  rootOccurrenceExact := rfl
  paymentReceipt := SourceBackedUBIPaymentReceiptAt.generate
  rootFactorization := installedMandateExitTargetUBI.rootAnswerAndNext_factorizes

/-- Exact target occurrence generated by the target representation itself. -/
def mandateExitTargetOccurrence : ExactTemporalCausalRootEventAt
    mandateExitTargetRoot.toAuthoritativeRoot.toLedgerRoot
      mandateExitTargetVisit :=
  mandateExitTargetRoot.toAuthoritativeRoot.toLedgerRoot
    |>.exactTemporalCausalEventAt mandateExitTargetVisit

def mandateExitTargetInitialGenerated :
    SourceNativeTemporalVisitGeneratedEvolutionAt
      mandateExitTargetRoot.toAuthoritativeRoot.toLedgerRoot
        mandateExitTargetVisit :=
  mandateExitTargetRoot.toAuthoritativeRoot.toLedgerRoot
    |>.generatedAtTemporalVisit mandateExitTargetVisit

def mandateExitTargetEntry : OpenResponsibilityAt N true :=
  RootInquiryU8CompletionRegression.entry

def mandateExitTargetEntryRow :
    mandateExitTargetInitialGenerated.GeneratedEntryRowAt
      mandateExitTargetEntry :=
  (mandateExitTargetInitialGenerated.canonicalGeneratedEntryRow?
    mandateExitTargetEntry).get (by rfl)

def mandateExitTargetFirstSuccessor :
    SourceNativeLedgerGeneratedSuccessorAt
      mandateExitTargetInitialGenerated.occurrence
      mandateExitTargetInitialGenerated.wholeLedgerWriteBack :=
  (SourceNativeLedgerGeneratedSuccessorAt.ofGenerated?
    mandateExitTargetInitialGenerated.wholeLedgerWriteBack).get (by rfl)

@[simp] theorem installedMandateExit_seed_exact :
    installedMandateExit.payload.sourceSeed = sourceMandateExitSeed :=
  rfl

@[simp] theorem installedMandateExit_consumer_exact :
    installedMandateExit.payload.consumer = sourceMandateExitConsumer :=
  rfl

@[simp] theorem installedMandateExit_disposition_exact :
    installedMandateExit.payload.disposition = sourceMandateExitDisposition :=
  rfl

@[simp] theorem installedMandateExit_face_exact :
    installedMandateExitLocalFace = sourceMandateExitFace :=
  rfl

@[simp] theorem installedMandateExit_power_lost :
    installedMandateExitLocalFace.responsibilityConsumer.1.1.freedomChange.kind =
      FreedomChangeKind.lost := by
  rw [installedMandateExit_face_exact]
  exact sourceMandate_exit_power_is_lost

@[simp] theorem installedMandateExit_phase_exit :
    (officeControllerRelationCompiler sourceMandateExitHistory lineageCompiler
      ).phaseStep
        (generatedOfficeControllerRelation sourceMandateExitHistory
          lineageCompiler) = MandatePhase.exit :=
  rfl

@[simp] theorem installedMandateExit_role_exited :
    (officeControllerRelationCompiler sourceMandateExitHistory lineageCompiler
      ).roleAt
        (generatedOfficeControllerRelation sourceMandateExitHistory
          lineageCompiler) .target = MandateRole.exited :=
  sourceMandate_exit_role_is_exited

theorem installedMandateExit_disposition_terminal :
    ∃ archive,
      installedMandateExitLocalFace.exactDisposition.1.target.slots[
          (mandateSlot lineageCompiler
            sourceMandateExitHistory.current).val]? =
        some (.terminal archive) := by
  rw [installedMandateExit_face_exact]
  exact sourceMandate_exit_disposition_is_terminal

theorem installedMandateExit_retains_prior_standing_trace :
    sourceMandateHistory.current ∈
      sourceMandateExitHistory.occurrence.trace :=
  sourceMandate_exit_retains_prior_trace

@[simp] theorem installedMandateExitTargetUBI_consumer_exact :
    installedMandateExitTargetUBI.payload.consumer =
      sourceGeneratedUBIRootRestriction :=
  rfl

theorem target_inventory_has_one_named_mandate_coordinate :
    mandateProjectionFor sourceMandateExitHistory ≠
        recognitionWitnessProjectionFor sourceMandateExitHistory ∧
      mandateProjectionFor sourceMandateExitHistory ≠
        ubiProjectionFor sourceMandateExitHistory ∧
      mandateProjectionFor sourceMandateExitHistory ≠
        proofCarryingProjectionFor sourceMandateExitHistory ∧
      mandateProjectionFor sourceMandateExitHistory ≠
        inquiryProjectionFor sourceMandateExitHistory ∧
      mandateProjectionFor sourceMandateExitHistory ≠
        essentialServiceProjectionFor sourceMandateExitHistory ∧
      mandateProjectionFor sourceMandateExitHistory ≠
        routeProjectionFor sourceMandateExitHistory ∧
      mandateProjectionFor sourceMandateExitHistory ≠
        commonClearingProjectionFor sourceMandateExitHistory ∧
      mandateProjectionFor sourceMandateExitHistory ≠
        clearingBackstopProjectionFor sourceMandateExitHistory :=
  mandateProjection_distinct_from_other_named_coordinates
    sourceMandateExitHistory

end
end M14SourceGeneratedMandateExitTargetRoot
end Society
end ProcessGame
end SaturationMonoid

