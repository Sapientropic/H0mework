import H0mework.Versions.Rfde5c14d.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M14.Fixture.Economy.Credit.Risk.Merge.Capacity.Runtime.Payment.Novelty.PostSettlement.Representation.Failure.SourceGeneratedContributionCapacityFinitePrefixRepresentationBreaking

/-!
# Source-generated finite-prefix operational code

This module contains only the reusable positive representation mechanism.
The exact source-installed actual-ledger point compiles a future-free Nat
program on the finite visible carrier.  For every replay inside the boundary,
the program returns its actual current; that current generates actual K
through the existing injective periodic-exit map.

The later source-generated pair has one visible coordinate and strictly
different currents, so no such program can cover the whole open replay tail.
This is a representation no-go, not a `TheoryState`, obstruction claim,
realization inventory, `ActualExpressibilityFailure`, U7 branch or root face.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceGeneratedContributionCapacityFinitePrefixOperationalCode

noncomputable section

open M14SourceGeneratedContributionMergeActionSource
open M14UBIPeriodicActualServiceCapacity
open M14SourceGeneratedContributionCapacityPostSettlementRenewalCompiler
open M14SourceGeneratedContributionCapacityPostSettlementPaidReplay
open M14SourceGeneratedContributionCapacityFinitePrefixAuthorityObserver
open M14SourceGeneratedContributionCapacityFinitePrefixResponsibilityDifference
open M14SourceInstalledContributionCapacityFinitePrefixRepresentation
open M14SourceGeneratedContributionCapacityFinitePrefixRepresentationBreaking
open M14SourceGeneratedContributionCapacityFinitePrefixRepresentationBreaking.SourceGeneratedFinitePrefixRepresentationBreakingAt

abbrev OperationalVisibleAt (boundary : Nat) :=
  FinitePrefixInstalledVisibleAt boundary

abbrev FinitePrefixOperationalProgramAt (boundary : Nat) :=
  OperationalVisibleAt boundary → Nat

/-- Future-free low-universe code of one replay authority. -/
def replayAuthorityCurrentCodeAt
    {oldVisit : OldVisit} {sourceIndex : Nat}
    (replay : AnyContributionCapacityPostSettlementPaidReplay oldVisit
      sourceIndex) : Nat :=
  replay.2.current

/-- Actual K is generated by the current code; no later comparison authority
enters this definition. -/
theorem replayAuthorityK_isGeneratedByCurrentCode
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (replay : AnyContributionCapacityPostSettlementPaidReplay oldVisit
      sourceIndex) :
    (finitePrefixInstalledAuthorityObserverAt oldVisit sourceIndex boundary
      ).authorityK replay =
      periodicActualServiceExitOccurrenceAt
        (replayAuthorityCurrentCodeAt replay) := by
  rcases replay with ⟨index, replay⟩
  have replay_eq :=
    SourceGeneratedContributionCapacityPostSettlementPaidReplayAt.eq_generated
      replay
  subst replay
  rfl

/-- Equality of generated actual K reflects equality of current codes. -/
theorem replayAuthorityCurrentCode_eq_of_authorityK_eq
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    {left right : AnyContributionCapacityPostSettlementPaidReplay oldVisit
      sourceIndex}
    (authority_eq :
      (finitePrefixInstalledAuthorityObserverAt oldVisit sourceIndex boundary
        ).authorityK left =
      (finitePrefixInstalledAuthorityObserverAt oldVisit sourceIndex boundary
        ).authorityK right) :
    replayAuthorityCurrentCodeAt left =
      replayAuthorityCurrentCodeAt right := by
  rw [replayAuthorityK_isGeneratedByCurrentCode,
    replayAuthorityK_isGeneratedByCurrentCode] at authority_eq
  exact periodicActualServiceExitOccurrenceAt_injective authority_eq

/-- The code compiler consumes one exact installed Society trace point.
Search is diagnostic; only the actual point reads the prefix current slot. -/
def finitePrefixOperationalProgramOfPointAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    (point :
      (M14SourceGeneratedUniversalSocietyRootGrammar.universalSocietyRecognitionAt
        oldVisit sourceIndex).PointAt
          (prefixVisitAt oldVisit sourceIndex boundary)) →
      FinitePrefixOperationalProgramAt boundary := by
  intro point visible
  exact
    match point.scenario with
    | .actual =>
        contributionCapacityPostSettlementRenewalInitialCurrentAt sourceIndex +
          visible.1.1.val
    | .fullCaptureSearch => 0

/-- Canonical code is definitionally compiled from the installed
actual-ledger point. -/
def finitePrefixOperationalProgramAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    FinitePrefixOperationalProgramAt boundary :=
  finitePrefixOperationalProgramOfPointAt oldVisit sourceIndex boundary
    (canonicalPrefixAt oldVisit sourceIndex boundary).actualLedgerPoint

@[simp] theorem finitePrefixOperationalProgram_compilerCommutes
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    finitePrefixOperationalProgramAt oldVisit sourceIndex boundary =
      finitePrefixOperationalProgramOfPointAt oldVisit sourceIndex boundary
        (canonicalPrefixAt oldVisit sourceIndex boundary).actualLedgerPoint :=
  rfl

structure FinitePrefixHistoricalProgramAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat)
    (program : FinitePrefixOperationalProgramAt boundary) : Prop where
  preservesPrefix : ∀ replay :
      AnyContributionCapacityPostSettlementPaidReplay oldVisit sourceIndex,
    replay.1 ≤ boundary →
      program
          ((finitePrefixInstalledAuthorityObserverAt oldVisit sourceIndex
            boundary).forget replay) =
        replayAuthorityCurrentCodeAt replay

structure FinitePrefixCompleteProgramAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat)
    (program : FinitePrefixOperationalProgramAt boundary) : Prop where
  preservesEveryReplay : ∀ replay :
      AnyContributionCapacityPostSettlementPaidReplay oldVisit sourceIndex,
    program
        ((finitePrefixInstalledAuthorityObserverAt oldVisit sourceIndex
          boundary).forget replay) =
      replayAuthorityCurrentCodeAt replay

/-- The exact installed point compiler represents every already generated
prefix replay. -/
theorem finitePrefixOperationalProgram_preservesPrefix
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    FinitePrefixHistoricalProgramAt oldVisit sourceIndex boundary
      (finitePrefixOperationalProgramAt oldVisit sourceIndex boundary) := by
  constructor
  rintro ⟨index, replay⟩ index_le
  have replay_eq :=
    SourceGeneratedContributionCapacityPostSettlementPaidReplayAt.eq_generated
      replay
  subst replay
  unfold finitePrefixOperationalProgramAt
    finitePrefixOperationalProgramOfPointAt
  rw [(canonicalPrefixAt oldVisit sourceIndex boundary
    ).actualLedgerScenarioExact]
  simp only [finitePrefixInstalledAuthorityObserverAt,
    finitePrefixReplayAuthorityObserverAt, replayAuthorityCurrentCodeAt,
    SourceGeneratedContributionCapacityPostSettlementPaidReplayAt.current_exact]
  rw [finitePrefixHistorySlot_exact_of_le index_le]

/-- The later pair breaks every complete-tail program without entering the
prefix compiler itself. -/
theorem finitePrefixCompleteProgram_isEmpty
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (breaking : CanonicalFinitePrefixRepresentationBreakingAt oldVisit
      sourceIndex boundary) :
    IsEmpty
      (Sigma fun program : FinitePrefixOperationalProgramAt boundary =>
        PLift
          (FinitePrefixCompleteProgramAt oldVisit sourceIndex boundary
            program)) := by
  constructor
  rintro ⟨program, complete⟩
  let incidence := canonicalIncidenceAt oldVisit sourceIndex boundary
  have left_exact := complete.down.preservesEveryReplay incidence.leftReplay
  have right_exact := complete.down.preservesEveryReplay incidence.rightReplay
  have current_eq :
      replayAuthorityCurrentCodeAt incidence.leftReplay =
        replayAuthorityCurrentCodeAt incidence.rightReplay :=
    left_exact.symm.trans <|
      (congrArg program breaking.sameInstalledVisibleDifferentK.1).trans
        right_exact
  exact (Nat.ne_of_lt incidence.leftCurrent_lt_rightCurrent) current_eq

theorem finitePrefixOperationalCode_directConsumer
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    let breaking :=
      sourceGeneratedFinitePrefixRepresentationBreakingAt oldVisit sourceIndex
        boundary
    type_of% breaking.positivePrefixRepresentation ∧
      type_of%
        (canonicalPrefixAt oldVisit sourceIndex boundary
          ).actualLedgerPointMem ∧
      type_of%
        (finitePrefixOperationalProgram_compilerCommutes oldVisit sourceIndex
          boundary) ∧
      Nonempty (FinitePrefixOperationalProgramAt boundary) ∧
      type_of%
        (finitePrefixOperationalProgram_preservesPrefix oldVisit sourceIndex
          boundary) ∧
      (∀ replay :
          AnyContributionCapacityPostSettlementPaidReplay oldVisit sourceIndex,
        type_of%
          (replayAuthorityK_isGeneratedByCurrentCode
            (boundary := boundary) replay)) ∧
      type_of% breaking.sameInstalledVisibleDifferentK ∧
      type_of%
        (canonicalIncidenceAt oldVisit sourceIndex boundary
          ).leftCurrent_lt_rightCurrent ∧
      type_of% (finitePrefixCompleteProgram_isEmpty breaking) := by
  dsimp
  let breaking :=
    sourceGeneratedFinitePrefixRepresentationBreakingAt oldVisit sourceIndex
      boundary
  exact
    ⟨breaking.positivePrefixRepresentation,
      (canonicalPrefixAt oldVisit sourceIndex boundary).actualLedgerPointMem,
      finitePrefixOperationalProgram_compilerCommutes oldVisit sourceIndex
        boundary,
      ⟨finitePrefixOperationalProgramAt oldVisit sourceIndex boundary⟩,
      finitePrefixOperationalProgram_preservesPrefix oldVisit sourceIndex
        boundary,
      replayAuthorityK_isGeneratedByCurrentCode (boundary := boundary),
      breaking.sameInstalledVisibleDifferentK,
      (canonicalIncidenceAt oldVisit sourceIndex boundary
        ).leftCurrent_lt_rightCurrent,
      finitePrefixCompleteProgram_isEmpty breaking⟩

end
end M14SourceGeneratedContributionCapacityFinitePrefixOperationalCode
