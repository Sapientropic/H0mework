        actualRepairSupportAt depth ∧
      (fullDomainRepairKernelPairAt depth).right ∈
        actualRepairSupportAt depth ∧
      Nonempty
        (ActualRepairFailureAt depth
            (fullDomainRepairKernelPairAt depth).left ×
          ActualRepairFailureAt depth
            (fullDomainRepairKernelPairAt depth).right) :=
  ⟨(canonicalSociety foundationHorizon).actualRepairFailureTrace
      |>.kernelInActualSupport depth |>.1,
    (canonicalSociety foundationHorizon).actualRepairFailureTrace
      |>.kernelInActualSupport depth |>.2,
    (canonicalSociety foundationHorizon).actualRepairFailureTrace
      |>.kernelJointlyActual depth⟩

/-- Whole-program export of the actual probability geometry.  Coarse
exact-root/full-domain visibility yields the same probability one half on
different repair authorities and cannot decode authority.  Refinement by the
existing failure kind separates the pair, yields probabilities one and zero,
and restores visible repair factorization. -/
theorem canonicalSociety_actualRepairFailureProbabilityGeometry
    (foundationHorizon depth : Nat) :
    let coarse := sourceGeneratedActualRepairFailureKernelFoldAt depth
    let refined := sourceGeneratedActualRepairFailureRefinedFoldAt depth
    coarse.readVisible (visibleAt depth) = some (1 / 2 : ℚ≥0) ∧
      coarse.probabilityReadout.read
          (tenureRepairFailureOccurrenceAt depth) =
        coarse.probabilityReadout.read
          (routeRepairFailureOccurrenceAt depth) ∧
      ¬ Nonempty
        (AuthorityCompleteReadoutAt actualRepairFailureObserver
          coarse.probabilityReadout) ∧
      refined.readVisible
          (refinedVisibleAt (tenureRepairFailureOccurrenceAt depth)) =
        some 1 ∧
      refined.readVisible
          (refinedVisibleAt (routeRepairFailureOccurrenceAt depth)) =
        some 0 ∧
      refined.probabilityReadout.read
          (tenureRepairFailureOccurrenceAt depth) ≠
        refined.probabilityReadout.read
          (routeRepairFailureOccurrenceAt depth) ∧
      Nonempty (AuthorityFactorization
        actualRepairFailureRefinedObserver) := by
  let certificate :=
    (canonicalSociety foundationHorizon).actualRepairFailureProbability
  rcases certificate.everyCoarseProbability depth with
    ⟨_coarseFibre, _coarseEventFibre, _coarseFibreMass,
      _coarseEventMass, coarseHalf, coarseEqual, coarseNoAuthority⟩
  rcases certificate.everyRefinedProbability depth with
    ⟨_refinedVisibleNe, refinedFactorization,
      _tenureFibre, _routeFibre, _tenureEventFibre, _routeEventFibre,
      tenureOne, routeZero, refinedSeparate⟩
  exact
    ⟨coarseHalf, coarseEqual, coarseNoAuthority,
      tenureOne, routeZero, refinedSeparate, refinedFactorization⟩

/-- Canonical-society UBI characterization, exported from the whole sink. -/
theorem canonicalSociety_exitCapacityRenewal_iff
    (horizon depth : Nat) :
    Nonempty
        (geometryCompilerAt depth).SourceGeneratedActionableExitRenewalAt ↔
      ∃ (code : exitRelationCompiler.FutureCode)
        (slot : Fin (anomiePhaseAt depth).served.length),
        code ∈ exitRelationCompiler.futureCodeCarrier ∧
        Nonempty (exitRelationCompiler.FutureContinuationAt
          independentExitRelation.1 .target code) ∧
        ¬ exitRelationCompiler.futureIdle code ∧
        ¬ noCapture.Captures code ∧
        Nonempty (SourceBackedUBIPaymentReceiptAt
          exitCapacityProgram.purchasingPowerStanding code) ∧
        Nonempty (SourceGeneratedUBIRouteReceiptAt code
          (ExactServedCrossingDebitedRunAt.servicedCrossingAt
            (phase := anomiePhaseAt depth)
            (crossingCompiler := crossingCompilerAt depth) slot)) :=
  (canonicalSociety horizon).strongestExitIff depth

/-- Whole-program export of the exact outside-option power geometry. -/
theorem canonicalSociety_employmentOutsideOptionPowerGeometry
    (horizon depth : Nat) :
    employmentLoss.power.freedomChange.kind = .lost ∧
      exitRelationCompiler.futureCodesAt employmentRelation .target = ∅ ∧
      Lifecycle.Universal.FixedAdapter.law.SurviveAt
        (Lifecycle.Universal.FixedAdapter.sourceActor .s0) worker ∧
      employmentRelation ≠ independentExitRelation ∧
      (geometryCompilerAt depth).actionableExitCapacity = 1 ∧
      (capturedGeometryCompilerAt depth).actionableExitCapacity = 0 ∧
      Nonempty
        (geometryCompilerAt depth).SourceGeneratedActionableExitRenewalAt ∧
      IsEmpty
        (capturedGeometryCompilerAt depth).SourceGeneratedActionableExitRenewalAt :=
  (canonicalSociety horizon).employmentOutsideOptionPowerGeometry depth

/-- Whole-program export: captured purchasing power retains an exact,
temporally indexed and source-accounted responsibility destination. -/
theorem canonicalSociety_captureResponsibilityDisposition
    (horizon depth : Nat) :
    PeriodicCaptureResponsibilityAt depth
        (periodicSourceBackedPaymentAt depth) ∧
      fullCapture.captureSettlement ExitFutureCode.leave leave_is_captured =
        exactOpenSettlement exactResidualActivation ∧
      Nonempty (SourceOwnsResponsibilityIncidence
        M3FiniteExchangeFixture.V
        (M3FiniteExchangeFixture.P.boundarySource
          capturedProgram.purchasingPowerStanding.activatedConsumer.activation)
        (exactOpenSettlement exactResidualActivation).obligation) :=
  ⟨(canonicalSociety horizon).periodicCaptureResponsibility depth,
    (canonicalSociety horizon).captureHasVisibleResidualDestination.1,
    (canonicalSociety horizon).captureHasVisibleResidualDestination.2.2.2.2.2⟩

/-- Whole-program export of the three-cause zero-capacity fibre and its
no-reconstruction consequence. -/
theorem canonicalSociety_zeroCapacityCausalNonidentifiability
    (horizon depth : Nat) :
    (capacityReadoutAt depth (priceCaptureOriginAt depth) = 0 ∧
      capacityReadoutAt depth (paymentIncidenceMissingOriginAt depth) = 0 ∧
      capacityReadoutAt depth (routeIncidenceMissingOriginAt depth) = 0 ∧
      priceCaptureOriginAt depth ≠ paymentIncidenceMissingOriginAt depth ∧
      priceCaptureOriginAt depth ≠ routeIncidenceMissingOriginAt depth ∧
      paymentIncidenceMissingOriginAt depth ≠
        routeIncidenceMissingOriginAt depth) ∧
    (¬ ∃ reconstruct : Nat → ZeroCapacityCausalOriginAt depth,
      Function.LeftInverse reconstruct (capacityReadoutAt depth)) :=
  ⟨(canonicalSociety horizon).zeroCapacityDoesNotIdentifyCause depth |>.1,
    (canonicalSociety horizon).zeroCapacityDoesNotIdentifyCause depth |>.2.2⟩

