        2 * traceHorizon ∧
      (tenureRepairFailureOccurrenceAt depth ∈
          sourceGeneratedFiniteActualRepairFailureTrace traceHorizon ↔
        depth < traceHorizon) ∧
      (routeRepairFailureOccurrenceAt depth ∈
          sourceGeneratedFiniteActualRepairFailureTrace traceHorizon ↔
        depth < traceHorizon) ∧
      (sourceGeneratedFiniteActualRepairFailureTrace traceHorizon).Nodup ∧
      (finiteActualTenureRepairFailureRootTrace traceHorizon).Nodup ∧
      (finiteActualRouteRepairFailureRootTrace traceHorizon).Nodup ∧
      (finiteActualRepairFailureStampedRootTrace traceHorizon).Nodup ∧
