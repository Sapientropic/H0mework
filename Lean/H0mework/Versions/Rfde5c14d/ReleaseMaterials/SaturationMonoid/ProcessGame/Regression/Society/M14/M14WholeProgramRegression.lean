/-- Whole-program export of root-installed structural rent capture. -/
theorem canonicalSociety_structuralRentCapture
    (horizon depth : Nat) :
    PeriodicStructuralRentCaptureAt depth
        (periodicSourceBackedPaymentAt depth) ∧
      SourceGeneratedStructuralRentCaptureAt depth ∧
      (geometryCompilerAt depth).actionableExitCapacity = 1 ∧
      (capturedGeometryCompilerAt depth).actionableExitCapacity = 0 ∧
      (¬ ∃ compiler : AnyEssentialAccessPaymentPurposeCompiler,
        compiler.purposeRelation exactResidualActivation = healthRelation) ∧
      (¬ ∃ compiler : AnyEssentialAccessPaymentPurposeCompiler,
        compiler.purposeRelation exactResidualActivation = platformRelation) := by
  let society := canonicalSociety horizon
  let periodic := society.structuralRentCapture.everyDepth depth
  exact ⟨periodic, periodic.structuralRent,
    (structural_rent_transfers_exit_capacity_at depth).2.1,
    (structural_rent_transfers_exit_capacity_at depth).2.2,
    society.structuralRentCapture.noHealthPurposeCompiler,
    society.structuralRentCapture.noPlatformPurposeCompiler⟩

/-- Whole-program export of UBI proof-carrying legislative standing. -/
theorem canonicalSociety_ubiProofCarryingLegislation (horizon : Nat) :
    Nonempty SourceGeneratedUBIProofCarryingLegislationAt ∧
      proofCarryingUBIPolicyLegislation.policyDisposition =
        sourceGeneratedUBIDisposition ∧
      (⟨M9ProofCarryingRenewalInquiryRoot.N,
        sourceGeneratedUBIProofCarryingLegislation.ordinaryRepair.generatedNext⟩ :
          AnyAuthoritativeRootCurrent) ≠
        sourceGeneratedUBIProofCarryingLegislation.policyLegislation.generatedNext ∧
      (¬ ∃ reconstruct : Nat → ExactExitRepair,
        ∀ origin : RepairFailureOriginAt 0,
          reconstruct (failureCapacityReadoutAt 0 origin) =
            canonicalRepairAt origin) := by
  let society := canonicalSociety horizon
  exact ⟨society.ubiProofCarryingLegislation.standing,
    society.ubiProofCarryingLegislation.policyDispositionExact,
    society.ubiProofCarryingLegislation
      |>.distinctOrdinaryAndRevolutionaryNexts,
    society.ubiProofCarryingLegislation.noCapacityOnlyRepairLegislation⟩

