      repairOutcomeCapacityAt depth (tenureCaptureOriginAt depth)
        (canonicalRepairAt (tenureCaptureOriginAt depth)) = 1 ∧
      IsEmpty (SourceInstalledProofCarryingExitRepairRenewalAt
        depth .restoreRoute) :=
  ⟨(canonicalSociety horizon).actualTenureCaptureRepairRenewal depth |>.1,
    (canonicalSociety horizon).actualTenureCaptureRepairRenewal depth |>.2.1,
    (canonicalSociety horizon).actualTenureCaptureRepairRenewal depth |>.2.2.2⟩

theorem canonicalSociety_appliedRepairGeneratesNextExitFace
    (horizon depth : Nat) :
    let renewal :=
      (proofCarryingExitRepairRenewalConsumerAt depth).renewal
    canonicalRepairAt (tenureCaptureOriginAt depth) =
        renewal.source.installed.payload.disposition.repairAt ∧
      renewal.generatedNext.visit = temporalVisitAt (depth + 1) ∧
      (installedUBIAt (depth + 1)).payload.consumer.programAt =
        renewal.source.installed.payload.disposition.targetProgramAt ∧
      (geometryCompilerAt (depth + 1)).actionableExitCapacity = 1 :=
  (canonicalSociety horizon).appliedRepairGeneratesNextExitFace depth

/-- Whole-program export of same-occurrence world-safe regeneration: every
generated depth is a regeneration step paying all six factors at its own
payment occurrence, each step's next is the following step's occurrence, and
the depth-zero policy-breaking occurrence also carries the self-U8 branch. -/
theorem canonicalSociety_sameOccurrenceRegeneration (horizon : Nat) :
    SameOccurrenceRegenerationCertificate :=
  (canonicalSociety horizon).sameOccurrenceRegeneration

/-- Whole-program export of one regeneration step at an arbitrary depth. -/
theorem canonicalSociety_periodicSameOccurrenceRegeneration
    (horizon depth : Nat) :
    ∃ step : PeriodicSameOccurrenceRegenerationAt depth,
      PeriodicSameOccurrenceRegenerationCertificate step :=
  let certificate := (canonicalSociety horizon).sameOccurrenceRegeneration
  (certificate.everyDepthStep depth).elim fun step =>
    ⟨step, certificate.everyStepPays depth step⟩

