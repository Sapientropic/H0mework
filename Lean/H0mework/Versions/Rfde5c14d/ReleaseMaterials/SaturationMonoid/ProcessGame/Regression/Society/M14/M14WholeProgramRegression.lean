      traceLength,
      tenureMembership depth,
      routeMembership depth,
      dependentNodup,
      tenureRootNodup,
      routeRootNodup,
      stampedRootNodup,
      bareRootCollision,
      sameDepthRoot depth,
      pairExact⟩

