import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Clearing.SourceGeneratedSymmetricClearing
import H0mework.Versions.AB.Society.Renewal.InstalledRenewalProjection
import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Regression.Society.M4.AutomaticFullFulfillmentRegression

/-!
# M14 root-independent common-clearing renewal

The existing four-leg exchange and its automatic fulfillment authority are
fixed before any living root is mentioned.  For every generated leg, the
generic symmetric-clearing producer forces the counterparty side, both
process consumers, both source-ownership incidences, and the sole exhaustive
fulfillment fold.

The local consumer records that source restriction.  Its action is indexed by
the existing `AutomaticFullFulfillment.fullResult`; callers cannot submit a
run, target current, participant family, balance table, clearing unit, root
row, ledger, mandate, or completed future.  A later root may install this law
only through its already generated renewal shell.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace M14SourceCommonClearingRenewal

noncomputable section

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Lifecycle Universal Relations Exchange Settlement Renewal Clearing
open Lifecycle.Universal.FixedAdapter
open Settlement.SourceOwnedSettlementCompiler
open M3FiniteExchangeFixture M4AutomaticFullFulfillmentRegression

abbrev LocalGame := Lifecycle.actualEventGame
abbrev LocalSeed := automaticCompiler.SettlementSeed
abbrev LocalSeedAt := automaticCompiler.settlementSeedAt

/-- The sole local settlement seed already generated by the automatic fold. -/
def commonClearingSeed : automaticCompiler.ExactSettlementSeed :=
  AutomaticFullFulfillment.exactSettlementSeed fulfillmentAuthority
    exactExchangeSeed

/-- The local seed is a restriction of the existing M4 occurrence, not a
second settlement occurrence with the same current. -/
@[simp] theorem commonClearing_occurrence_is_existing :
    automaticCompiler.occurrenceOfSeed commonClearingSeed =
      automaticOccurrence :=
  rfl

/-- Source restriction: the exact settlement seed owns a symmetric clearing
face at every leg in its compiler-generated carrier.  The universal field is
produced internally; it is not a caller-supplied coverage certificate. -/
structure SourceCommonClearingRestrictionAt
    (seed : automaticCompiler.ExactSettlementSeed) : Type where
  private mk ::
  seed_eq : seed = commonClearingSeed
  clearingAt : ∀ leg : exactExchangeSeed.Leg,
    Nonempty (SourceGeneratedSymmetricClearingAt fulfillmentAuthority
      exactExchangeSeed leg)

/-- Sole source producer; it accepts no carrier or completion evidence. -/
def sourceCommonClearingRestriction :
    SourceCommonClearingRestrictionAt commonClearingSeed where
  seed_eq := rfl
  clearingAt := fun leg =>
    ⟨SourceGeneratedSymmetricClearingAt.generate fulfillmentAuthority
      exactExchangeSeed leg⟩

/-- The applied action is indexed by the one existing exhaustive fold.  The
private constructor prevents a caller from replacing that fold after the
source restriction has been generated. -/
structure SourceAppliedCommonClearingAt
    (seed : automaticCompiler.ExactSettlementSeed) : Type where
  private mk ::
  seed_eq : seed = commonClearingSeed
  sourceCause : SourceCommonClearingRestrictionAt seed

/-- Sole action producer.  Its full result is definitionally the M4 fold. -/
def sourceGeneratedCommonClearingDisposition :
    SourceAppliedCommonClearingAt commonClearingSeed where
  seed_eq := rfl
  sourceCause := sourceCommonClearingRestriction

namespace SourceAppliedCommonClearingAt

variable {seed : automaticCompiler.ExactSettlementSeed}
variable (clearing : SourceAppliedCommonClearingAt seed)

include clearing

/-- The action can expose only the pre-existing exhaustive result. -/
def fullResult
    (_clearing : SourceAppliedCommonClearingAt seed) :=
  AutomaticFullFulfillment.fullResult fulfillmentAuthority exactExchangeSeed

/-- The action carries the existing dependent run, never a parallel run. -/
def fullRun : P.Run
    (exactExchangeSeed.generatedState exchangeCompiler).current
    clearing.fullResult.current :=
  clearing.fullResult.run

theorem fullResult_is_existing : clearing.fullResult =
    AutomaticFullFulfillment.fullResult fulfillmentAuthority
      exactExchangeSeed :=
  rfl

/-- Every source-generated leg receives its own consumer and its generated
counterparty's independent consumer. -/
theorem every_leg_has_two_sided_clearing
    (leg : exactExchangeSeed.Leg) :
    ∃ face : SourceGeneratedSymmetricClearingAt fulfillmentAuthority
        exactExchangeSeed leg,
      Nonempty (ExactLegFulfillmentAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed leg) ∧
      Nonempty (ExactLegFulfillmentAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed
        face.counterpartyLeg) ∧
      Nonempty (SourceOwnsResponsibilityIncidence V
        (P.boundarySource face.legConsumer.event)
        (exactExchangeSeed.obligation exchangeCompiler leg)) ∧
      Nonempty (SourceOwnsResponsibilityIncidence V
        (P.boundarySource face.counterpartyConsumer.event)
        (exactExchangeSeed.obligation exchangeCompiler
          face.counterpartyLeg)) ∧
      face.legActor ≠ face.counterpartyActor ∧
      face.legSlotIndex ≠ face.counterpartySlotIndex ∧
      Nonempty (AutomaticFullFulfillment.FulfilledSlotAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed
        face.fullResult.current leg) ∧
      Nonempty (AutomaticFullFulfillment.FulfilledSlotAt
        (exchangeLaw := exchangeLaw) exactExchangeSeed
        face.fullResult.current face.counterpartyLeg) := by
  rcases (SourceAppliedCommonClearingAt.sourceCause clearing).clearingAt leg
    with ⟨face⟩
  exact ⟨face, face.two_sides_exact⟩

theorem full_run_is_existing : HEq clearing.fullRun
    (AutomaticFullFulfillment.fullResult fulfillmentAuthority
      exactExchangeSeed).run := by
  rfl

omit clearing in
/-- Target closure is the existing automatic full-fulfillment theorem. -/
theorem target_openSettlement_isEmpty :
    IsEmpty (OpenSettlementAt automaticCompiler automaticOccurrence) :=
  automaticFullyFulfilled.openSettlement_isEmpty

end SourceAppliedCommonClearingAt

abbrev CommonClearingConsumerAt
    (seed : automaticCompiler.ExactSettlementSeed) :=
  SourceCommonClearingRestrictionAt seed

abbrev CommonClearingDispositionAt
    (seed : automaticCompiler.ExactSettlementSeed) :=
  SourceAppliedCommonClearingAt seed

abbrev SourceCommonClearingRenewalLawAt
    {N : WorldRelationNetwork}
    {RootV : ConstructiveRoot.Vocabulary}
    (source : SourceNativeLedgerSource N RootV) :=
  SourceNativeRenewalProjectionLaw source LocalGame LocalSeed LocalSeedAt
    CommonClearingConsumerAt CommonClearingDispositionAt

/-- Root-polymorphic law mouth.  The later root supplies only its own entry,
selected row, and successor shell. -/
def sourceCommonClearingRenewalLaw
    {N : WorldRelationNetwork}
    {RootV : ConstructiveRoot.Vocabulary}
    {source : SourceNativeLedgerSource N RootV}
    (shell : SourceNativeRenewalRootShellAt source) :
    SourceCommonClearingRenewalLawAt source :=
  SourceNativeRenewalProjectionLaw.ofRootShell shell commonClearingSeed
    sourceCommonClearingRestriction sourceGeneratedCommonClearingDisposition

/-! ## Exact controls -/

theorem nilOpenOccurrence_cannot_be_commonClearing :
    ¬ Nonempty
      (FullyFulfilledExchangeAt nilOpenCompiler nilOpenOccurrence) :=
  nil_open_occurrence_has_no_fully_fulfilled_witness

theorem oneSidedAction_cannot_be_commonClearing
    (leg : exactExchangeSeed.Leg) :
    let face := SourceGeneratedSymmetricClearingAt.generate
      fulfillmentAuthority exactExchangeSeed leg
    IsEmpty (AutomaticFullFulfillment.FulfilledSlotAt
      (exchangeLaw := exchangeLaw) exactExchangeSeed
      face.oneSidedEdge.target face.counterpartyLeg) :=
  (SourceGeneratedSymmetricClearingAt.generate fulfillmentAuthority
    exactExchangeSeed leg).oneSided_counterpartyFulfilled_isEmpty

theorem commonClearing_mouth_has_no_root_mandate_registry_or_future : True := by
  fail_if_success exact sourceGeneratedCommonClearingDisposition.root
  fail_if_success exact sourceGeneratedCommonClearingDisposition.selectedRow
  fail_if_success exact sourceGeneratedCommonClearingDisposition.ledger
  fail_if_success exact sourceGeneratedCommonClearingDisposition.mandate
  fail_if_success exact sourceGeneratedCommonClearingDisposition.participants
  fail_if_success exact sourceGeneratedCommonClearingDisposition.balanceTable
  fail_if_success exact sourceGeneratedCommonClearingDisposition.clearingUnit
  fail_if_success exact sourceGeneratedCommonClearingDisposition.secondRun
  fail_if_success exact sourceGeneratedCommonClearingDisposition.completedFuture
  trivial

end
end M14SourceCommonClearingRenewal
end Society
end ProcessGame
end SaturationMonoid

