  exactRuntimeLabel := rfl

/-- Exact runtime labels identify generated depths, so the witness fibre is
supported only at its source anchor. -/
theorem SourceGeneratedPairIntentRuntimeLabelWitnessAt.depth_eq
    {oldVisit : OldVisit} {sourceIndex boundary anchor depth : Nat}
    (witness : SourceGeneratedPairIntentRuntimeLabelWitnessAt oldVisit
      sourceIndex boundary anchor depth) :
    depth = anchor := by
  have labelEquality := witness.exactRuntimeLabel
  rw [pairIntentRuntimeAuthorityLabelAt_exact oldVisit sourceIndex boundary
      depth,
    pairIntentRuntimeAuthorityLabelAt_exact oldVisit sourceIndex boundary
      anchor] at labelEquality
  have temporalEquality : depth + 2 = anchor + 2 :=
    congrArg Prod.snd labelEquality
  omega

/-- Honest public tag reads equality of the two exact runtime labels. -/
def pairIntentRuntimeLabelPublicationTag
    (oldVisit : OldVisit) (sourceIndex boundary anchor depth : Nat) : Bool :=
  decide
    (representationIntentErasedRuntimeLabel
          (pairIntentRuntimeAuthorityAt oldVisit sourceIndex boundary depth) =
        representationIntentErasedRuntimeLabel
          (pairIntentRuntimeAuthorityAt oldVisit sourceIndex boundary anchor))

theorem pairIntentRuntimeLabelPublicationTag_true_iff
    (oldVisit : OldVisit) (sourceIndex boundary anchor depth : Nat) :
    pairIntentRuntimeLabelPublicationTag oldVisit sourceIndex boundary anchor
          depth = true ↔
      Nonempty
        (SourceGeneratedPairIntentRuntimeLabelWitnessAt oldVisit sourceIndex
          boundary anchor depth) := by
  constructor
  · intro published
    have exactRuntimeLabel :
        representationIntentErasedRuntimeLabel
              (pairIntentRuntimeAuthorityAt oldVisit sourceIndex boundary
                depth) =
            representationIntentErasedRuntimeLabel
              (pairIntentRuntimeAuthorityAt oldVisit sourceIndex boundary
                anchor) := by
      simpa [pairIntentRuntimeLabelPublicationTag] using published
    exact
      ⟨{ anchorGeneratedNext :=
           representationIntentU8EveryRevisedTick_generatesNext oldVisit
             sourceIndex boundary anchor
         exactRuntimeLabel := exactRuntimeLabel }⟩
  · rintro ⟨witness⟩
    simpa [pairIntentRuntimeLabelPublicationTag] using
      witness.exactRuntimeLabel

