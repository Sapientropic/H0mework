/-- The exact generated runtime label at downstream depth `depth`. -/
theorem pairIntentRuntimeAuthorityLabelAt_exact
    (oldVisit : OldVisit) (sourceIndex boundary depth : Nat) :
    representationIntentErasedRuntimeLabel
        (pairIntentRuntimeAuthorityAt oldVisit sourceIndex boundary depth) =
      (7, depth + 2) := by
  unfold pairIntentRuntimeAuthorityAt
  rw [representationIntentU8Runtime_stateAt_succ_exact oldVisit sourceIndex
    boundary depth]
  simpa [representationIntentU8ProcessPresentation,
    representationIntentU8ExpectedRuntimeLabel] using
    representationIntentU8ProcessPresentation_label_exact oldVisit sourceIndex
      boundary (.revised (depth + 2))

/-- The downstream observer and its authority coordinate share one exact named
runtime depth. -/
def pairIntentAuthorityObserverAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat)
    {Visible : Type} (observe : Nat → Visible) :
    AuthorityObserver Nat Visible AnyAuthoritativeRootCurrent where
  forget := observe
  authorityK := pairIntentRuntimeAuthorityAt oldVisit sourceIndex boundary

/-- Noninjectivity itself generates a concrete collision; endpoints and their
visible equality are theorem outputs, not premises. -/
theorem pairIntentObserver_hasCollision_of_notInjective
    {Visible : Type}
    (observe : Nat → Visible)
    (notInjective : ¬ Function.Injective observe) :
    ∃ left right : Nat, left ≠ right ∧ observe left = observe right := by
  classical
  by_contra noCollision
  apply notInjective
  intro left right visibleEquality
  by_contra occurrenceNe
  exact noCollision ⟨left, right, occurrenceNe, visibleEquality⟩

/-- Every noninjective observer has an exact kernel pair whose authority
inequality is generated by the named runtime's depth injectivity. -/
theorem pairIntentNoninjectiveObserverKernelPair_nonempty
    {Visible : Type}
    (oldVisit : OldVisit) (sourceIndex boundary : Nat)
    (observe : Nat → Visible)
    (notInjective : ¬ Function.Injective observe) :
    Nonempty
      (AuthorityKernelPair
        (pairIntentAuthorityObserverAt oldVisit sourceIndex boundary
          observe)) := by
  rcases pairIntentObserver_hasCollision_of_notInjective observe notInjective
      with
    ⟨left, right, occurrenceNe, visibleEquality⟩
  exact
    ⟨{ left := left
       right := right
       occurrence_ne := occurrenceNe
       visible_eq := visibleEquality
       authority_ne := fun authorityEquality =>
         occurrenceNe
           (representationIntentU8RevisedStates_injective oldVisit sourceIndex
             boundary authorityEquality) }⟩

/-- Canonical downstream choice of the pair generated by noninjectivity. -/
noncomputable def pairIntentNoninjectiveObserverKernelPairAt
    {Visible : Type}
    (oldVisit : OldVisit) (sourceIndex boundary : Nat)
    (observe : Nat → Visible)
    (notInjective : ¬ Function.Injective observe) :
    AuthorityKernelPair
      (pairIntentAuthorityObserverAt oldVisit sourceIndex boundary observe) :=
  Classical.choice
    (pairIntentNoninjectiveObserverKernelPair_nonempty oldVisit sourceIndex
      boundary observe notInjective)

