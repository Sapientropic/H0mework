/-! ## Periodic regeneration step -/

/-- The ordinary tenure repair renewal at one generated depth. -/
abbrev RepairRenewalAt (depth : Nat) :=
  SourceInstalledProofCarryingExitRepairRenewalAt depth
    (canonicalRepairAt (tenureCaptureOriginAt depth))

/-- One regeneration step at the payment occurrence of `depth`.  The capture
death and the repaired successor are distinct producers; the ordinary repairs
they carry are the stored renewal. -/
structure PeriodicSameOccurrenceRegenerationAt (depth : Nat) : Type 18 where
  private mk ::
  renewal : RepairRenewalAt depth
  death : SourceGeneratedPortfolioCaptureDeathAt depth
    (fullPortfolioSourceAt depth) fullCapture
  deathRepairIsRenewal : HEq death.ordinaryRepair.renewal renewal
  successor : SourceGeneratedPostRepairViableEconomicDispositionAt
    (postRepairViableExposureAt depth) (postRepairViableImageAt depth)
    (ordinaryEconomicLandingAt depth)
  successorRepairIsRenewal : HEq successor.ordinary.renewal renewal

/-- Sole periodic producer.  It accepts only the depth. -/
def periodicSameOccurrenceRegenerationAt (depth : Nat) :
    PeriodicSameOccurrenceRegenerationAt depth where
  renewal := SourceInstalledProofCarryingExitRepairRenewalAt.generate depth
  death := portfolioCaptureDeathAt depth
  deathRepairIsRenewal := HEq.rfl
  successor := postRepairViableEconomicDispositionAt depth
  successorRepairIsRenewal := HEq.rfl

/-- The six world-safe regeneration factors at one depth, with the bounded
old-law branch paying the same-lineage factor. -/
structure PeriodicSameOccurrenceRegenerationCertificate {depth : Nat}
    (step : PeriodicSameOccurrenceRegenerationAt depth) : Prop where
  /-- `p`: capture death, repaired successor and ordinary repair share one
  renewal on the payment occurrence of this depth. -/
  deathRepairIsRenewal : HEq step.death.ordinaryRepair.renewal step.renewal
  successorRepairIsRenewal :
    HEq step.successor.ordinary.renewal step.renewal
  deathAtPayment :
    step.death.fullServices.paymentOccurrence.rootOccurrence =
      jointRoot.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
        (temporalVisitAt depth)
  renewalAtPayment :
    step.renewal.rootOccurrence =
      jointRoot.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
        (temporalVisitAt depth)
  /-- Same-lineage update, bounded branch: old law surface, root-compiled
  next on the next temporal visit. -/
  boundedNext :
    step.renewal.generatedNext =
      jointRoot.generatedNextCurrentAt (temporalVisitAt depth)
  boundedLawSurface :
    step.renewal.generatedNext.root.source.lawSurface =
      jointRoot.source.base.lawSurface
  nextVisit :
    step.renewal.generatedNext.visit = temporalVisitAt (depth + 1)
  /-- Ordinary exit does not contract across the repair. -/
  exitNoncontracting :
    (geometryCompilerAt depth).actionableExitCapacity ≤
      (geometryCompilerAt (depth + 1)).actionableExitCapacity
  exitLiveAtP :
    Nonempty (geometryCompilerAt depth).SourceGeneratedActionableExitRenewalAt
  exitLiveAtNext : Nonempty
    (geometryCompilerAt (depth + 1)).SourceGeneratedActionableExitRenewalAt
  /-- Kernel escape: the captured exit fibre is empty at `p`, and the next
  installs the repaired target program carried by `p`'s disposition. -/
  capturedEmptyAtP : IsEmpty
    (capturedGeometryCompilerAt depth).SourceGeneratedActionableExitRenewalAt
  repairedProgramAtNext :
    (installedUBIAt (depth + 1)).payload.consumer.programAt =
      step.renewal.source.installed.payload.disposition.targetProgramAt
  /-- No invisible residual bearer: the captured residual keeps its bearer and
  activated consumer, whose next is the payment next; the successor has its
  own root responsibility consumer. -/
  residualBearerRetained :
    OpenSettlementAt.residualBearer
        (fullCapture.captureSettlement ExitFutureCode.leave leave_is_captured) =
      OpenSettlementAt.residualBearer
        (exactOpenSettlement exactResidualActivation)
  residualConsumer : Nonempty
    (OpenSettlementAt.ActivatedResidualConsumerAt
      (exactOpenSettlement exactResidualActivation))
  residualConsumerNextIsPaymentNext :
    capturedProgram.purchasingPowerStanding.activatedConsumer.nextGeneratedState =
      capturedProgram.payment.nextGenerated
  successorRootConsumer : Nonempty (RenewalResponsibilityConsumerAt
    step.successor.actualExit.paymentOccurrence.installed.operationalAuthority)
  /-- The repaired successor keeps the U8 route into the joint core; `p`'s
  economic fold has no grounded-terminal landing. -/
  successorRevisionRoute : Nonempty (FaithfulCofaceMorphism
    u8Gate.minimalCoface jointCore.revision.generate.toAdmissibleMinimalCoface)
  successorRevisionRuntime :
    SourceNativeInquiryRuntime.CofaceRealizationResumptionAt
      jointCore jointRuntime 0
  noGroundedTerminal : IsEmpty
    (SourceGeneratedGroundedEconomicTerminalAt
      (tenureRepairExposureAt depth) (tenureEconomicImageAt depth) none)
  /-- The captured value crosses to a distinct counterparty, which receives
  the protected interest, while the residual keeps its source-owned
  responsibility incidence and exact settlement. -/
  beneficiaryIsCounterparty :
    OpenSettlementAt.protectedInterest
        (fullCapture.captureSettlement ExitFutureCode.leave leave_is_captured) =
      exchangeLaw.protectedInterestOfActor
        (exactCounterpartyActor exactResidualActivation)
  counterpartyIsNotWorker :
    exactCounterpartyActor exactResidualActivation ≠ worker
  crossingSettlementExact :
    fullCapture.captureSettlement ExitFutureCode.leave leave_is_captured =
      exactOpenSettlement exactResidualActivation
  crossingResidualSourceOwned : Nonempty (SourceOwnsResponsibilityIncidence V
    (P.boundarySource
      capturedProgram.purchasingPowerStanding.activatedConsumer.activation)
    (exactOpenSettlement exactResidualActivation).obligation)

/-- Every periodic carrier pays the six factors from its own fields. -/
theorem periodicSameOccurrenceRegeneration_certificate {depth : Nat}
    (step : PeriodicSameOccurrenceRegenerationAt depth) :
    PeriodicSameOccurrenceRegenerationCertificate step := by
  have repairedFace :=
    step.renewal.generatedNext_repairedFace_capacity_eq_one
  have uncaptured : (geometryCompilerAt depth).actionableExitCapacity = 1 :=
    step.death.capacityCollapse.1
  have captured :
      (capturedGeometryCompilerAt depth).actionableExitCapacity = 0 :=
    step.death.capacityCollapse.2
  have next :
      (geometryCompilerAt (depth + 1)).actionableExitCapacity = 1 :=
    repairedFace.2.2
  exact
    { deathRepairIsRenewal := step.deathRepairIsRenewal
      successorRepairIsRenewal := step.successorRepairIsRenewal
      deathAtPayment := step.death.paymentRootExact
      renewalAtPayment := step.renewal.rootOccurrence_eq
      boundedNext := step.renewal.generatedNext_eq_rootCompiler
      boundedLawSurface := step.renewal.lawSurface_preserved
      nextVisit := repairedFace.1
      exitNoncontracting := by rw [uncaptured, next]
      exitLiveAtP :=
        (geometryCompilerAt depth
          ).capacity_positive_iff_actionableExitRenewal.mp
          (by rw [uncaptured]; exact Nat.one_pos)
      exitLiveAtNext :=
        (geometryCompilerAt (depth + 1)
          ).capacity_positive_iff_actionableExitRenewal.mp
          (by rw [next]; exact Nat.one_pos)
      capturedEmptyAtP := ⟨fun renewal => by
        have positive :=
          (capturedGeometryCompilerAt depth
            ).capacity_positive_iff_actionableExitRenewal.mpr ⟨renewal⟩
        rw [captured] at positive
        exact Nat.lt_irrefl 0 positive⟩
      repairedProgramAtNext := repairedFace.2.1
      residualBearerRetained := step.death.residualBearerRetained
      residualConsumer := step.death.activatedResidualConsumer
      residualConsumerNextIsPaymentNext :=
        step.death.residualConsumerNextExact
      successorRootConsumer := ⟨step.successor.successorRootConsumer⟩
      successorRevisionRoute := step.successor.revisionRoute
      successorRevisionRuntime := step.successor.revisionRuntime
      noGroundedTerminal := step.death.groundedTerminalEmpty
      beneficiaryIsCounterparty := step.death.generatedBeneficiary
      counterpartyIsNotWorker := counterparty_actor_is_not_worker
      crossingSettlementExact := step.death.exactSettlement
      crossingResidualSourceOwned := step.death.sourceOwnedResidual }

/-- The next generated by step `depth` is the occurrence on which every step
at `depth + 1` sits, and the two payment occurrences are distinct. -/
theorem periodicSameOccurrenceRegeneration_nextIsNextStep {depth : Nat}
    (step : PeriodicSameOccurrenceRegenerationAt depth)
    (following : PeriodicSameOccurrenceRegenerationAt (depth + 1)) :
    step.renewal.generatedNext.visit = temporalVisitAt (depth + 1) ∧
      following.renewal.rootOccurrence =
        jointRoot.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
          (temporalVisitAt (depth + 1)) ∧
      periodicPaymentOccurrenceAt depth ≠
        periodicPaymentOccurrenceAt (depth + 1) :=
  ⟨step.renewal.generatedNext_repairedFace_capacity_eq_one.1,
    following.renewal.rootOccurrence_eq,
    adjacent_payment_occurrences_are_distinct depth⟩

/-! ## Depth zero: both same-lineage branches -/

/-- At the policy-breaking occurrence the periodic step also carries the
existing self-U8 refinement of its capture death. -/
structure SameOccurrenceCanonicalRegenerationAt : Type 18 where
  private mk ::
  step : PeriodicSameOccurrenceRegenerationAt 0
  breaking : UBIPolicyBreakingOccurrenceAt
    (M14UBIPolicyBreakingOccurrence.Root.emitted jointVisit.current)
  renewalAtBreaking :
    (⟨jointVisit.current,
      M14UBIPolicyBreakingOccurrence.Root.emitted jointVisit.current⟩ :
      Sigma M14UBIPolicyBreakingOccurrence.Root.toLedgerRoot.source.source.toRootSource.actual.OccurrenceAt) =
    ⟨(temporalVisitAt 0).current, step.renewal.rootOccurrence.occurrence⟩
  policyU8 : SourceGeneratedCaptureDeathPolicyU8At step.death

/-- Sole depth-zero producer. -/
def sameOccurrenceCanonicalRegeneration :
    SameOccurrenceCanonicalRegenerationAt where
  step := periodicSameOccurrenceRegenerationAt 0
  breaking := active
  renewalAtBreaking := rfl
  policyU8 := captureDeathPolicyU8At (portfolioCaptureDeathAt 0)

/-- The depth-zero step pays the periodic certificate, and its same-lineage
factor is inhabited by both branches at the breaking occurrence. -/
structure SameOccurrenceCanonicalRegenerationCertificate
    (regeneration : SameOccurrenceCanonicalRegenerationAt) : Prop where
  periodic : PeriodicSameOccurrenceRegenerationCertificate regeneration.step
  renewalAtBreaking :
    (⟨jointVisit.current,
      M14UBIPolicyBreakingOccurrence.Root.emitted jointVisit.current⟩ :
      Sigma M14UBIPolicyBreakingOccurrence.Root.toLedgerRoot.source.source.toRootSource.actual.OccurrenceAt) =
    ⟨(temporalVisitAt 0).current,
      regeneration.step.renewal.rootOccurrence.occurrence⟩
  policyOrdinaryIsDeathRepair :
    regeneration.policyU8.ordinary = regeneration.step.death.ordinaryRepair
  /-- Same-lineage update, self-U8 branch at the same occurrence, landing
  apart from the ordinary next. -/
  selfU8Route : Nonempty (FaithfulCofaceMorphism u8Gate.minimalCoface
    jointCore.revision.generate.toAdmissibleMinimalCoface)
  selfU8Disposition : Nonempty
    (SourceGeneratedRequiresU8EconomicDispositionAt
      (tenureRepairExposureAt 0) (tenureEconomicImageAt 0)
      revolutionaryEconomicLanding)
  selfU8Runtime :
    SourceNativeInquiryRuntime.CofaceRealizationResumptionAt
      jointCore jointRuntime 0
  landingsDistinct :
    ordinaryEconomicLandingAt 0 ≠ revolutionaryEconomicLanding

theorem sameOccurrenceCanonicalRegeneration_certificate
    (regeneration : SameOccurrenceCanonicalRegenerationAt) :
    SameOccurrenceCanonicalRegenerationCertificate regeneration where
  periodic := periodicSameOccurrenceRegeneration_certificate regeneration.step
  renewalAtBreaking := regeneration.renewalAtBreaking
  policyOrdinaryIsDeathRepair := regeneration.policyU8.ordinary_eq
  selfU8Route := regeneration.policyU8.gateToCore
  selfU8Disposition := ⟨regeneration.policyU8.requiresU8⟩
  selfU8Runtime := regeneration.policyU8.runtimeConsumesCore
  landingsDistinct := regeneration.policyU8.landingsDistinct

/-- Consumer certificate.  Every depth generates a regeneration step and every
step pays the six factors; each step's next is the following step's
occurrence; depth zero additionally carries the self-U8 branch.  No completed
table of steps is stored. -/
structure SameOccurrenceRegenerationCertificate : Prop where
  everyDepthStep : ∀ depth : Nat,
    Nonempty (PeriodicSameOccurrenceRegenerationAt depth)
  everyStepPays : ∀ (depth : Nat)
      (step : PeriodicSameOccurrenceRegenerationAt depth),
    PeriodicSameOccurrenceRegenerationCertificate step
  nextIsNextStep : ∀ (depth : Nat)
      (step : PeriodicSameOccurrenceRegenerationAt depth)
      (following : PeriodicSameOccurrenceRegenerationAt (depth + 1)),
    step.renewal.generatedNext.visit = temporalVisitAt (depth + 1) ∧
      following.renewal.rootOccurrence =
        jointRoot.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt
          (temporalVisitAt (depth + 1)) ∧
      periodicPaymentOccurrenceAt depth ≠
        periodicPaymentOccurrenceAt (depth + 1)
  depthZeroBothBranches : Nonempty SameOccurrenceCanonicalRegenerationAt
  depthZeroPays : ∀ regeneration : SameOccurrenceCanonicalRegenerationAt,
    SameOccurrenceCanonicalRegenerationCertificate regeneration

theorem sameOccurrenceCanonicalRegeneration_directConsumer :
    SameOccurrenceRegenerationCertificate where
  everyDepthStep := fun depth =>
    ⟨periodicSameOccurrenceRegenerationAt depth⟩
  everyStepPays := fun _ step =>
    periodicSameOccurrenceRegeneration_certificate step
  nextIsNextStep := fun _ step following =>
    periodicSameOccurrenceRegeneration_nextIsNextStep step following
  depthZeroBothBranches := ⟨sameOccurrenceCanonicalRegeneration⟩
  depthZeroPays := sameOccurrenceCanonicalRegeneration_certificate

end
