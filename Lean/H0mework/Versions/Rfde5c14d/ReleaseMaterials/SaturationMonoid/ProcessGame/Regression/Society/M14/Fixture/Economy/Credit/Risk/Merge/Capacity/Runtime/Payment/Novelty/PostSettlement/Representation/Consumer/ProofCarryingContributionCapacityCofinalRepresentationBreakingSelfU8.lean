abbrev CanonicalTransportAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :=
  SourceGeneratedFinitePrefixRepresentationBreakingU8TransportAt
    (sourceGeneratedFinitePrefixRepresentationBreakingAt oldVisit sourceIndex
      boundary)

def canonicalTransportAt
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    CanonicalTransportAt oldVisit sourceIndex boundary :=
  sourceGeneratedFinitePrefixRepresentationBreakingU8TransportAt
    (sourceGeneratedFinitePrefixRepresentationBreakingAt oldVisit sourceIndex
      boundary)

abbrev ConsumedCofinalRepresentationBreakingSelfU8At
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :=
  { transport : CanonicalTransportAt oldVisit sourceIndex boundary //
    ProofCarryingCofinalRepresentationBreakingSelfU8At transport }

def consumedCofinalRepresentationBreakingSelfU8At
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    ConsumedCofinalRepresentationBreakingSelfU8At oldVisit sourceIndex
      boundary :=
  let transport := canonicalTransportAt oldVisit sourceIndex boundary
  ⟨transport, proofCarryingCofinalRepresentationBreakingSelfU8At transport⟩

theorem cofinalRepresentationBreakingAndSelfU8
    (oldVisit : OldVisit) (sourceIndex : Nat) :
    ∀ boundary : Nat,
      Nonempty
        (ConsumedCofinalRepresentationBreakingSelfU8At oldVisit sourceIndex
          boundary) :=
  fun boundary =>
    ⟨consumedCofinalRepresentationBreakingSelfU8At oldVisit sourceIndex
      boundary⟩

theorem cofinalRepresentationBreakingAndSelfU8_directConsumer
    (oldVisit : OldVisit) (sourceIndex boundary : Nat) :
    let consumed :=
      consumedCofinalRepresentationBreakingSelfU8At oldVisit sourceIndex
        boundary
    type_of% consumed.2.prefixTraceRootInstalled ∧
      type_of% consumed.2.positivePrefixRepresentation ∧
      type_of% consumed.2.sourceExpressionCompilerCommutes ∧
      type_of% consumed.2.sourceActualLedgerPointInInstalledTrace ∧
      type_of% consumed.2.rawExpressionLanguageNonempty ∧
      type_of% consumed.2.completeRepresentationIsEmpty ∧
      type_of% consumed.2.prefixOccurredBeforeLeft ∧
      type_of% consumed.2.actualPathsDifferent ∧
      type_of% consumed.2.sameRealNormalDifferentK ∧
      (∀ channel : EssentialAccessChannel,
        type_of% (consumed.2.everyChannelReturns channel)) ∧
      type_of% consumed.2.sourceOwnershipAndRootConsumer ∧
      type_of% consumed.2.pOrdinaryNext ∧
      type_of% consumed.2.rightPTraceOccurrenceExact ∧
      type_of% consumed.2.rightPWholeLedgerExact ∧
      type_of% consumed.2.rightPPaymentSuccessorExact ∧
      type_of% consumed.2.exactPaymentsConsumed ∧
      type_of% consumed.2.pAndQOccurrencesDistinct ∧
      type_of% consumed.2.qPaymentAndEntryExact ∧
      type_of% consumed.2.existingU7Demand ∧
      type_of% consumed.2.existingFailureFace ∧
      type_of% consumed.2.existingRootedFailure ∧
      type_of% consumed.2.existingMinimalCoface ∧
      type_of% consumed.2.exactSelfU8 ∧
      type_of% consumed.2.revisedRowsShareOneNext ∧
      type_of% consumed.2.externalQFirstWriteGeneratesPairIntentOpenRuntime ∧
      type_of% consumed.2.pairIntentObserverKernelEscape ∧
      type_of% consumed.2.pairIntentProofCarryingRenewalInstalled ∧
      type_of% consumed.2.pairIntentRuntimeSplice ∧
      type_of% consumed.2.pairIntentReflexiveSelfU8 ∧
      type_of% consumed.2.pairIntentSelfU8UsesGeneratedFailure ∧
      type_of% consumed.2.pairIntentSelfU8UsesRootedFailure ∧
      type_of% consumed.2.pairIntentSelfU8UsesCanonicalCoface ∧
      type_of% consumed.2.pairIntentRuntimeConsumesGeneratedCore ∧
      type_of% consumed.2.pairIntentRowsShareGeneratedNext ∧
      type_of% consumed.2.pairIntentSelfU8SameOccurrence ∧
      type_of% consumed.2.pairIntentAllFiniteGeneratedContinuation := by
  dsimp
  let consumed :=
    consumedCofinalRepresentationBreakingSelfU8At oldVisit sourceIndex
      boundary
  exact
    ⟨consumed.2.prefixTraceRootInstalled,
      consumed.2.positivePrefixRepresentation,
      consumed.2.sourceExpressionCompilerCommutes,
      consumed.2.sourceActualLedgerPointInInstalledTrace,
      consumed.2.rawExpressionLanguageNonempty,
      consumed.2.completeRepresentationIsEmpty,
      consumed.2.prefixOccurredBeforeLeft,
      consumed.2.actualPathsDifferent,
      consumed.2.sameRealNormalDifferentK,
      consumed.2.everyChannelReturns,
      consumed.2.sourceOwnershipAndRootConsumer,
      consumed.2.pOrdinaryNext,
      consumed.2.rightPTraceOccurrenceExact,
      consumed.2.rightPWholeLedgerExact,
      consumed.2.rightPPaymentSuccessorExact,
      consumed.2.exactPaymentsConsumed,
      consumed.2.pAndQOccurrencesDistinct,
      consumed.2.qPaymentAndEntryExact,
      consumed.2.existingU7Demand,
      consumed.2.existingFailureFace,
      consumed.2.existingRootedFailure,
      consumed.2.existingMinimalCoface,
      consumed.2.exactSelfU8,
      consumed.2.revisedRowsShareOneNext,
      consumed.2.externalQFirstWriteGeneratesPairIntentOpenRuntime,
      consumed.2.pairIntentObserverKernelEscape,
      consumed.2.pairIntentProofCarryingRenewalInstalled,
      consumed.2.pairIntentRuntimeSplice,
      consumed.2.pairIntentReflexiveSelfU8,
      consumed.2.pairIntentSelfU8UsesGeneratedFailure,
      consumed.2.pairIntentSelfU8UsesRootedFailure,
      consumed.2.pairIntentSelfU8UsesCanonicalCoface,
      consumed.2.pairIntentRuntimeConsumesGeneratedCore,
      consumed.2.pairIntentRowsShareGeneratedNext,
      consumed.2.pairIntentSelfU8SameOccurrence,
      consumed.2.pairIntentAllFiniteGeneratedContinuation⟩

