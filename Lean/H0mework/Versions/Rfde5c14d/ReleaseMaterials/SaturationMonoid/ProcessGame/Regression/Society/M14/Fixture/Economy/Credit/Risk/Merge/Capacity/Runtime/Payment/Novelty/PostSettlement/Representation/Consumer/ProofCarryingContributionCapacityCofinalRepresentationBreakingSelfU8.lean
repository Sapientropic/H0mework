      SourceGeneratedFinitePrefixRepresentationBreakingU8TransportAt
        breaking) :
    ProofCarryingCofinalRepresentationBreakingSelfU8At transport where
  prefixTraceRootInstalled := breaking.prefixTraceRootInstalled
  positivePrefixRepresentation := breaking.positivePrefixRepresentation
  sourceExpressionCompilerCommutes :=
    breaking.sourceExpressionCompilerCommutes
  sourceActualLedgerPointInInstalledTrace :=
    breaking.sourceActualLedgerPointIsInInstalledTrace
  rawExpressionLanguageNonempty := breaking.rawExpressionLanguageNonempty
  completeRepresentationIsEmpty := breaking.completeRepresentationIsEmpty
  prefixOccurredBeforeLeft := breaking.prefixOccurredBeforeLeft
  bothPathsStrictlyLater := breaking.bothPathsStrictlyLater
  actualPathsDifferent := breaking.actualPathsDifferent
  sameRealNormalDifferentK := breaking.sameRealNormalDifferentK
  sameInstalledVisibleDifferentK := breaking.sameInstalledVisibleDifferentK
  everyChannelReturns := transport.everyChannelStillReturns
  sourceOwnershipAndRootConsumer :=
    transport.sourceOwnershipAndRootConsumerPreserved
  pOrdinaryNext := transport.ordinaryPNextPreserved
  rightPTraceOccurrenceExact :=
    breaking.rightTraceOccurrenceIsRightReplayEvent
  rightPWholeLedgerExact :=
    breaking.rightPaidWholeLedgerIsRightReplayWholeLedger
  rightPPaymentSuccessorExact :=
    breaking.rightPaidSuccessorIsExactPaymentSuccessor
  exactPaymentsConsumed := breaking.exactPaymentsConsumed
  localExpressionFailurePresentsQFailure :=
