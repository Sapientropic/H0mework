  localRealizationFailurePresentsQFailure :=
    ⟨transport.realizationFailurePresentation⟩
  pAndQOccurrencesDistinct := transport.pAndQOccurrencesDistinct
  qPaymentAndEntryExact := transport.qPaymentAndEntryExact
  existingU7Demand := ⟨transport.existingRevisionDemand⟩
  existingFailureFace := ⟨transport.existingFailureFace⟩
  existingRootedFailure := ⟨transport.existingRootedFailure⟩
  existingMinimalCoface := ⟨transport.existingMinimalCoface⟩
  exactSelfU8 := ⟨transport.selfU8⟩
  selfU8UsesExistingFailure :=
    transport.selfU8_failure_isExistingFailure
  selfU8UsesExistingPaidRooted :=
    transport.selfU8_rooted_isExistingPaidRooted
  selfU8UsesExistingPaidCoface :=
    transport.selfU8_coface_isExistingPaidCoface
  runtimeConsumesExistingCore :=
    transport.selfU8_runtimeConsumesExistingCore
  firstWriteIsExistingCompilerWrite :=
    transport.selfU8_firstWrite_isExistingCompilerWrite
  revisedRowsShareOneNext := transport.selfU8_revisedRowsShareOneNext
  externalQFirstWriteGeneratesPairIntentOpenRuntime :=
