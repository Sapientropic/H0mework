/-! ## Price fibre and actual occurrence authority -/

/-- `false` reads the uncaptured program and `true` the existing full-capture
counterlife.  Both values are recomputed by the already installed zero price
observer. -/
def birthBearerProgramPriceReadout : Bool → Int
  | false =>
      birthBearerExitCapacityProgram.purchasingPowerStanding.priceObservation.value
  | true =>
      birthBearerCapturedProgram.purchasingPowerStanding.priceObservation.value

@[simp] theorem birthBearerProgramPriceReadout_eq_zero (side : Bool) :
    birthBearerProgramPriceReadout side = 0 := by
  cases side <;> rfl

/-- The actual price readout on every absolute lifecycle occurrence.  The
price value comes from the installed purchasing-power standing; the domain
and `K` remain the existing absolute occurrence and actual-service authority. -/
def absoluteLifecyclePriceAt
    {oldVisit : OldVisit} {sourceIndex boundary fuel : Nat}
    (_initial : CycleAt oldVisit sourceIndex boundary)
    (_absolute : AbsoluteFinitePaidExitLifecycleStageAt fuel) : Int :=
  birthBearerExitCapacityProgram.purchasingPowerStanding.priceObservation.value

@[simp] theorem absoluteLifecyclePrice_eq_zero
    {oldVisit : OldVisit} {sourceIndex boundary fuel : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary)
    (absolute : AbsoluteFinitePaidExitLifecycleStageAt fuel) :
    absoluteLifecyclePriceAt initial absolute = 0 :=
  rfl

def absoluteLifecyclePriceObserverAt
    {oldVisit : OldVisit} {sourceIndex boundary fuel : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) :
    AuthorityObserver
      (AbsoluteFinitePaidExitLifecycleStageAt fuel) Int
      AnyPeriodicActualServiceExit where
  forget := absoluteLifecyclePriceAt initial
  authorityK := absoluteLifecycleKAt initial

def absoluteLifecyclePriceKernelPairAt
    {oldVisit : OldVisit} {sourceIndex boundary fuel : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) :
    AuthorityKernelPair
      (absoluteLifecyclePriceObserverAt (fuel := fuel) initial) where
  left := absoluteLifecycleStageZeroAt fuel
  right := absoluteLifecycleStageOneAt fuel
  occurrence_ne := absoluteLifecycleStageZero_ne_one fuel
  visible_eq := rfl
  authority_ne := fun equality =>
    absoluteLifecycleStageZero_ne_one fuel
      (absoluteLifecycleK_injective initial equality)

theorem lifecyclePrice_noOccurrenceReconstruction
    {oldVisit : OldVisit} {sourceIndex boundary fuel : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) :
    ¬ ∃ reconstruct : Int → AbsoluteFinitePaidExitLifecycleStageAt fuel,
      Function.LeftInverse reconstruct
        (absoluteLifecyclePriceObserverAt (fuel := fuel) initial).forget :=
  (absoluteLifecyclePriceKernelPairAt (fuel := fuel) initial
    ).noOccurrenceLeftInverse

theorem lifecyclePrice_noAuthorityFactorization
    {oldVisit : OldVisit} {sourceIndex boundary fuel : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) :
    ¬ Nonempty
      (AuthorityFactorization
        (absoluteLifecyclePriceObserverAt (fuel := fuel) initial)) :=
  (absoluteLifecyclePriceKernelPairAt (fuel := fuel) initial
    ).noAuthorityFactorization

theorem lifecyclePrice_noFaithfulReconstruction
    {oldVisit : OldVisit} {sourceIndex boundary fuel : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) :
    ¬ Nonempty
      (FaithfulAuthorityReconstruction
        (absoluteLifecyclePriceObserverAt (fuel := fuel) initial)) :=
  (absoluteLifecyclePriceKernelPairAt (fuel := fuel) initial
    ).noFaithfulAuthorityReconstruction

/-- At any generated cycle, the positive constitution and captured nominal
counterlife occupy one price fibre but have opposite exit dispositions. -/
theorem cycleSamePrice_differentExitDisposition
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    {initial : CycleAt oldVisit sourceIndex boundary} {depth : Nat}
    (constitution : FiniteExitCapacityConstitutionAt initial depth) :
    birthBearerCapturedProgram.purchasingPowerStanding =
        birthBearerExitCapacityProgram.purchasingPowerStanding ∧
      birthBearerProgramPriceReadout false =
        birthBearerProgramPriceReadout true ∧
      Nonempty (ExitCapacityRenewalAt birthBearerExitCapacityProgram) ∧
      NominalTransferReadoutAt birthBearerCapturedProgram ∧
      IsEmpty (ExitCapacityRenewalAt birthBearerCapturedProgram) :=
  ⟨rfl, rfl, constitution.semanticRenewalNonempty,
    birthBearerNominalTransfer,
    birthBearerNominalTransfer.excludes_exitCapacityRenewal⟩

/-! ## Exact action and administrative occurrence kernels -/

theorem lifecycleAction_noOccurrenceReconstruction
    {oldVisit : OldVisit} {sourceIndex boundary fuel : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) :
    ¬ ∃ reconstruct :
        birthBearerExitExerciseController.ExactActionSeed →
          AbsoluteFinitePaidExitLifecycleStageAt fuel,
      Function.LeftInverse reconstruct
        (absoluteLifecycleActionObserverAt (fuel := fuel) initial).forget :=
  absoluteLifecycleAction_noOccurrenceReconstruction initial

theorem lifecycleAction_noAuthorityFactorization
    {oldVisit : OldVisit} {sourceIndex boundary fuel : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) :
    ¬ Nonempty
      (AuthorityFactorization
        (absoluteLifecycleActionObserverAt (fuel := fuel) initial)) :=
  absoluteLifecycleAction_noAuthorityFactorization initial

theorem lifecycleAction_noFaithfulReconstruction
    {oldVisit : OldVisit} {sourceIndex boundary fuel : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) :
    ¬ Nonempty
      (FaithfulAuthorityReconstruction
        (absoluteLifecycleActionObserverAt (fuel := fuel) initial)) :=
  absoluteLifecycleAction_noFaithfulReconstruction initial

theorem cycleAdministrative_noOccurrenceReconstruction
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat)
    (label : AdministrativeRetaliationOccurrenceAt oldVisit sourceIndex →
      Bool) :
    ¬ ∃ reconstruct : AdministrativeRetaliationVisible →
        AdministrativeRetaliationOccurrenceAt oldVisit sourceIndex,
      Function.LeftInverse reconstruct
        (administrativeRetaliationObserver oldVisit sourceIndex label
          ).forget :=
  stepAdministrativeLabel_noOccurrenceLeftInverse initial depth label

theorem cycleAdministrative_noAuthorityFactorization
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat)
    (label : AdministrativeRetaliationOccurrenceAt oldVisit sourceIndex →
      Bool) :
    ¬ Nonempty
      (AuthorityFactorization
        (administrativeRetaliationObserver oldVisit sourceIndex label)) :=
  stepAdministrativeLabel_noAuthorityFactorization initial depth label

theorem cycleAdministrative_noFaithfulReconstruction
    {oldVisit : OldVisit} {sourceIndex boundary : Nat}
    (initial : CycleAt oldVisit sourceIndex boundary) (depth : Nat)
    (label : AdministrativeRetaliationOccurrenceAt oldVisit sourceIndex →
      Bool) :
    ¬ Nonempty
      (FaithfulAuthorityReconstruction
        (administrativeRetaliationObserver oldVisit sourceIndex label)) :=
  stepAdministrativeLabel_noFaithfulReconstruction initial depth label

theorem administrativeLabels_doNotChangeConstitutionRestriction :
    administrativeEligibilityReadout false =
      administrativeEligibilityReadout true :=
  administrative_labels_do_not_control_renewal

end
