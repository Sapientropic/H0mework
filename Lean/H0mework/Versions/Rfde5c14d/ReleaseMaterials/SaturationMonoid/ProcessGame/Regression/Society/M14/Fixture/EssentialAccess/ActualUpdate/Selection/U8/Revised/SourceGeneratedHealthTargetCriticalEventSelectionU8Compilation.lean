def generatedHealthTargetSelectionU8Compilation :=
  healthTargetSelectionRequiresU8Program.generate

@[simp] theorem generatedHealthTargetSelectionU8Compilation_output_exact :
    generatedHealthTargetSelectionU8Compilation.output =
      healthTargetSelectionRequiresU8Compilation :=
