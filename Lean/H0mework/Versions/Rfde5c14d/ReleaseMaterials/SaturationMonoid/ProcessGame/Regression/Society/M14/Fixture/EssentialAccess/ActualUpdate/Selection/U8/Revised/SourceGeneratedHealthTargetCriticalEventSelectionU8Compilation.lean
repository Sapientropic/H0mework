/-- Build-time frontier of the exact depth-one old-root failure. -/
def healthTargetSelectionInquiryFrontier :
    SourceNativeInquiryCofaceFrontierAt
      healthCessationTargetRoot
      (healthCessationTargetTemporalVisitAt 1) U7
      RootInquiryU8CompletionRegression.theoryAuditCalculus
      RootInquiryU8CompletionRegression.oldTheory ()
      healthTargetSelectionInquiryEvent
      RootInquiryU8CompletionRegression.entry
      (healthTargetFailureLivingAuthorityAt 1)
      RootInquiryU8CompletionRegression.obstruction
      RootInquiryU8CompletionRegression.u7Gate
      RootInquiryU8CompletionRegression.failure :=
  SourceNativeInquiryCofaceFrontierAt.ofRootFailureFace
    (healthTargetFailureFaceAt 1) rfl (healthTargetFailureSuccessorAt 1)

@[simp] theorem healthTargetSelectionInquiryFrontier_face_exact :
    healthTargetSelectionInquiryFrontier.face =
      healthTargetFailureFaceAt 1 :=
  rfl

@[simp] theorem healthTargetSelectionInquiryFrontier_successor_exact :
    healthTargetSelectionInquiryFrontier.successor =
      healthTargetFailureSuccessorAt 1 :=
  rfl

@[simp] theorem healthTargetSelectionInquiryFrontier_rooted_exact :
