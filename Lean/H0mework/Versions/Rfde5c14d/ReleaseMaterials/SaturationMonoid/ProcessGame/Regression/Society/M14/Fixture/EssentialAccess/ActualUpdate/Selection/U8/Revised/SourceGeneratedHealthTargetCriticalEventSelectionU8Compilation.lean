/-- Candidate readout of the source generated by the same typed revision. -/
def healthTargetSelectionRealizationCandidate :
    SourceNativeInquiryCofaceRealizationAt
      healthTargetSelectionInquiryFrontier :=
  SourceNativeInquiryCofaceRealizationAt.ofGeneratedRevision
    typedRevisionSource.generate

/-- Complete U8 core at the old health-target occurrence. -/
def healthTargetSelectionU8Core :
    SourceGeneratedInquiryU8RevisionCoreAt
      healthCessationTargetRoot
      (healthCessationTargetTemporalVisitAt 1) U7
      RootInquiryU8CompletionRegression.theoryAuditCalculus
      RootInquiryU8CompletionRegression.oldTheory ()
      healthTargetSelectionInquiryEvent
      RootInquiryU8CompletionRegression.entry
      (healthTargetFailureLivingAuthorityAt 1)
      RootInquiryU8CompletionRegression.obstruction
      RootInquiryU8CompletionRegression.u7Gate
      RootInquiryU8CompletionRegression.failure where
  frontier := healthTargetSelectionInquiryFrontier
  revision := typedRevisionSource

theorem healthTargetSelectionRealizationCertification :
    SourceNativeInquiryCofaceRealizationCertificationAt
      healthTargetSelectionRealizationCandidate
      healthTargetSelectionU8Core where
  frontier_eq := rfl
  source_heq := HEq.rfl

/-- Literal U8 branch; all four fields are the old root's exact failure data
and the core above. -/
def healthTargetSelectionRequiresU8Compilation :
    SourceNativeInquiryCompilationAt
      healthCessationTargetRoot
      (healthCessationTargetTemporalVisitAt 1) U7
      RootInquiryU8CompletionRegression.theoryAuditCalculus
      RootInquiryU8CompletionRegression.oldTheory ()
      healthTargetSelectionInquiryEvent
      RootInquiryU8CompletionRegression.entry
      (healthTargetFailureLivingAuthorityAt 1) :=
  .requiresU8 RootInquiryU8CompletionRegression.obstruction
    RootInquiryU8CompletionRegression.u7Gate
    RootInquiryU8CompletionRegression.failure healthTargetSelectionU8Core

def healthTargetSelectionRequiresU8Program :
    SourceNativeInquiryCompilationProgramAt
      healthCessationTargetRoot
      (healthCessationTargetTemporalVisitAt 1) U7
      RootInquiryU8CompletionRegression.theoryAuditCalculus
      RootInquiryU8CompletionRegression.oldTheory ()
      healthTargetSelectionInquiryEvent
      RootInquiryU8CompletionRegression.entry
      (healthTargetFailureLivingAuthorityAt 1) where
