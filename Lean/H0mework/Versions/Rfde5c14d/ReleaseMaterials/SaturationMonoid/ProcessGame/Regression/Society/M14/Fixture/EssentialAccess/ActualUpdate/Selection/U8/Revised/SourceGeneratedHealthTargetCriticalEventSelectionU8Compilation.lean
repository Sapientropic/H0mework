/-- Direct consumer of the one frontier/core/candidate/compiler chain. -/
theorem healthTargetSelectionU8Compilation_directConsumer :
    healthTargetSelectionInquiryFrontier.face =
        healthTargetFailureFaceAt 1 ∧
      healthTargetSelectionInquiryFrontier.successor =
        healthTargetFailureSuccessorAt 1 ∧
      healthTargetSelectionInquiryFrontier.rooted = RootedFailure ∧
      healthTargetSelectionInquiryFrontier.coface = minimalCoface ∧
      healthTargetSelectionU8Core.revision = typedRevisionSource ∧
      HEq healthTargetSelectionRealizationCandidate.source
        revisedLivingRoot.toAuthoritativeRoot.toLedgerRoot.source ∧
      SourceNativeInquiryCofaceRealizationCertificationAt
        healthTargetSelectionRealizationCandidate
        healthTargetSelectionU8Core ∧
      generatedHealthTargetSelectionU8Compilation.output =
        (.requiresU8 RootInquiryU8CompletionRegression.obstruction
          RootInquiryU8CompletionRegression.u7Gate
          RootInquiryU8CompletionRegression.failure
          healthTargetSelectionU8Core) :=
  ⟨rfl, rfl, rfl, rfl, rfl, HEq.rfl,
    healthTargetSelectionRealizationCertification, rfl⟩

