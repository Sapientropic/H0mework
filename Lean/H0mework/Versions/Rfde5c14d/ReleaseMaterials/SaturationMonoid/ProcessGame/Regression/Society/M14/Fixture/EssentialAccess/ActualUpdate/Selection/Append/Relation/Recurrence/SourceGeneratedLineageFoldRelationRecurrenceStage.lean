def next (stage : RelationLineageRecurrenceStage) :
    RelationLineageRecurrenceStage where
  PredecessorV := AppendVAt stage.sourcePrior stage.sourceCarrier
  predecessorRoot := stage.sourceRoot
  predecessorCurrent := stage.actionCurrent
  predecessorOccurrence := stage.exactSource.occurrence
  sourcePrior := stage.actionCurrent
  sourceCarrier := stage.nextCarrier

theorem next_sourceRoot_exact (stage : RelationLineageRecurrenceStage) :
    stage.next.sourceRoot = stage.targetRoot :=
  rfl

theorem generatedAction_targetRoot_exact
    (stage : RelationLineageRecurrenceStage) :
    stage.generatedAction.target.targetRoot = stage.next.sourceRoot :=
  rfl

theorem generatedAction_targetCurrent_exact
    (stage : RelationLineageRecurrenceStage) :
    stage.generatedAction.target.firstSuccessor.targetCurrent =
      stage.next.selectionVisit.current := by
  have targetExact :
      stage.generatedAction.target.firstSuccessor.targetCurrent =
        appendedCriticalSelectionCurrent stage.actionCurrent
          stage.nextCarrier :=
    stage.generatedAction.receipt.down.down.2.targetAppendCurrent
  have nextSelection := stage.next.selectionCurrent_exact
  change stage.next.selectionVisit.current =
    appendedCriticalSelectionCurrent stage.actionCurrent
      stage.nextCarrier at nextSelection
  exact targetExact.trans nextSelection.symm

theorem next_actionCurrent_exact (stage : RelationLineageRecurrenceStage) :
    stage.next.actionCurrent = retainedSelectionNext
      (appendedCriticalSelectionCurrent stage.actionCurrent
        stage.nextCarrier) :=
  stage.next.actionCurrent_exact

def installedRenewal (stage : RelationLineageRecurrenceStage) :=
  installedAppendedCriticalRenewal stage.sourceRoot
