theorem selectionReplay_isEmpty (stage : RelationLineageRecurrenceStage) :
    IsEmpty (AppendedSelectionReplayAt stage.sourceRoot
      stage.exactSource.occurrence stage.actionCurrent stage.nextCarrier) :=
  stage.generatedAction.receipt.down.down.2.selectionReplay

end RelationLineageRecurrenceStage

def initialStage : RelationLineageRecurrenceStage where
  PredecessorV := AppendVAt healthAppendPrior
    (criticalActionCarrierOfQueueAction healthQueueAction)
  predecessorRoot := healthAppendTargetRoot
  predecessorCurrent := platformAppendPrior
  predecessorOccurrence := platformAppendExactEvent.occurrence
  sourcePrior := platformAppendPrior
  sourceCarrier := criticalActionCarrierOfQueueAction platformQueueAction

def stageAt : Nat → RelationLineageRecurrenceStage
  | 0 => initialStage
  | depth + 1 => (stageAt depth).next

@[simp] theorem stageAt_zero : stageAt 0 = initialStage := rfl

@[simp] theorem stageAt_succ (depth : Nat) :
    stageAt (depth + 1) = (stageAt depth).next :=
  rfl

theorem initialStage_source_exact : initialStage.sourceRoot =
    platformAppendTargetRoot :=
  rfl

theorem initialStage_actionVisit_exact : initialStage.actionVisit =
    platformAppendTemporalVisitAt 1 :=
  rfl

theorem initialStage_actionCurrent_exact : initialStage.actionCurrent =
    platformRetainedRelationPrior :=
  rfl

theorem initialStage_nextCarrier_exact : initialStage.nextCarrier =
    platformRetainedActionCarrier :=
  rfl

theorem stage_directConsumer (depth : Nat) :
    let stage := stageAt depth
    stage.actualActionCompilation = .actualAction stage.generatedAction ∧
      stage.nextCarrier.action.criticalBearer.bearerLineage.seed =
        stage.actionCurrent.root ∧
      stage.generatedAction.target.targetRoot = stage.next.sourceRoot ∧
      stage.generatedAction.target.firstSuccessor.targetCurrent =
        stage.next.selectionVisit.current ∧
      stage.next.actionCurrent = retainedSelectionNext
        (appendedCriticalSelectionCurrent stage.actionCurrent
          stage.nextCarrier) ∧
      stage.installedRenewal.selected.selectedEvent = stage.nextCarrier.event ∧
      stage.installedRenewal.payload.consumer.action = stage.nextCarrier.action ∧
      stage.installedRenewal.payload.disposition.update =
        sourceGeneratedEssentialAccessCriticalActualUpdateAt
          stage.nextCarrier.event ∧
      IsEmpty (AppendedSelectionReplayAt stage.sourceRoot
        stage.exactSource.occurrence stage.actionCurrent stage.nextCarrier) :=
  let stage := stageAt depth
  let core := stage.generatedAction.receipt.down.down.2
  ⟨rfl, stage.actionSeed_eq_currentRoot,
    stage.generatedAction_targetRoot_exact,
    stage.generatedAction_targetCurrent_exact,
    stage.next_actionCurrent_exact,
    core.selectedRenewal.1, core.selectedRenewal.2.1,
    core.selectedRenewal.2.2, core.selectionReplay⟩

end
