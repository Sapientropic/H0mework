/-- The source root is deliberately absent as a field. It can only be the
append root definitionally generated by these six predecessor fields. -/
structure RelationLineageRecurrenceStage : Type 15 where
  private mk ::
  PredecessorV : ConstructiveRoot.Vocabulary
  predecessorRoot : SourceNativeLivingRootClosure NewN PredecessorV
  predecessorCurrent : PredecessorV.Current
  predecessorOccurrence :
    predecessorRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.actual.OccurrenceAt
      predecessorCurrent
  sourcePrior : EssentialAccessCriticalSelectionCurrent
  sourceCarrier : SourceGeneratedEssentialAccessCriticalActionCarrier

namespace RelationLineageRecurrenceStage

def sourceRoot (stage : RelationLineageRecurrenceStage) :=
  appendLivingRoot stage.predecessorRoot stage.predecessorOccurrence
    stage.sourcePrior stage.sourceCarrier

def selectionVisit (stage : RelationLineageRecurrenceStage) :=
  criticalActionAppendTemporalVisitAt stage.predecessorRoot
    stage.predecessorOccurrence stage.sourcePrior stage.sourceCarrier 0

def actionVisit (stage : RelationLineageRecurrenceStage) :=
  criticalActionAppendTemporalVisitAt stage.predecessorRoot
    stage.predecessorOccurrence stage.sourcePrior stage.sourceCarrier 1

def actionCurrent (stage : RelationLineageRecurrenceStage) :
    EssentialAccessCriticalSelectionCurrent :=
  stage.actionVisit.current

def exactSource (stage : RelationLineageRecurrenceStage) :
    ExactTemporalCausalRootEventAt
      stage.sourceRoot.toAuthoritativeRoot.toLedgerRoot stage.actionVisit :=
  stage.sourceRoot.toAuthoritativeRoot.toLedgerRoot
    |>.exactTemporalCausalEventAt stage.actionVisit

def selected (stage : RelationLineageRecurrenceStage) :=
  sourceGeneratedSelectedEssentialAccessCriticalEventAt stage.actionCurrent

def nextCarrier (stage : RelationLineageRecurrenceStage) :=
  criticalActionCarrierOfSelected stage.selected

def relationPhase (stage : RelationLineageRecurrenceStage) :=
  essentialAccessRelationCompiler.phaseStep
    (essentialAccessCriticalRelation stage.nextCarrier.event)

def transportedSeed (stage : RelationLineageRecurrenceStage) :=
  transportedRelationSeed stage.relationPhase stage.selected.selectedSeed

@[simp] theorem transportedSeed_exact
    (stage : RelationLineageRecurrenceStage) :
    stage.transportedSeed = stage.selected.selectedSeed :=
  transportedRelationSeed_exact _ _

theorem actionSeed_eq_currentRoot
    (stage : RelationLineageRecurrenceStage) :
    stage.nextCarrier.action.criticalBearer.bearerLineage.seed =
      stage.actionCurrent.root :=
  (criticalActionCarrierOfSelected_foldProvenance stage.selected).2.1.trans
    (selectedCriticalSeed_eq_root stage.actionCurrent)

theorem actionSeed_eq_transportedSeed
    (stage : RelationLineageRecurrenceStage) :
    stage.nextCarrier.action.criticalBearer.bearerLineage.seed =
      stage.transportedSeed := by
  rw [stage.transportedSeed_exact]
  exact (criticalActionCarrierOfSelected_foldProvenance stage.selected).2.1

theorem selectionCurrent_exact (stage : RelationLineageRecurrenceStage) :
    stage.selectionVisit.current =
      appendedCriticalSelectionCurrent stage.sourcePrior
        stage.sourceCarrier :=
  criticalActionAppendRootVisitAt_zero_current stage.predecessorRoot
    stage.predecessorOccurrence stage.sourcePrior stage.sourceCarrier

theorem actionCurrent_exact (stage : RelationLineageRecurrenceStage) :
    stage.actionCurrent = retainedSelectionNext
      (appendedCriticalSelectionCurrent stage.sourcePrior
        stage.sourceCarrier) := by
  unfold actionCurrent actionVisit
  change appendNativeTarget stage.sourcePrior stage.sourceCarrier
    (criticalActionAppendRootVisitAt stage.predecessorRoot
      stage.predecessorOccurrence stage.sourcePrior stage.sourceCarrier 0
      ).current = _
  rw [criticalActionAppendRootVisitAt_zero_current stage.predecessorRoot
    stage.predecessorOccurrence stage.sourcePrior stage.sourceCarrier]
  exact appendNativeTarget_after_append stage.sourcePrior stage.sourceCarrier

structure SourceSealAt
    (stage : RelationLineageRecurrenceStage)
    (exactSource : ExactTemporalCausalRootEventAt
      stage.sourceRoot.toAuthoritativeRoot.toLedgerRoot
        stage.actionVisit) : Prop where
  sourceCanonical : exactSource = stage.exactSource
  carrierFromFold : stage.nextCarrier =
    criticalActionCarrierOfSelected stage.selected
  selectedSeedRoot : stage.selected.selectedSeed = stage.actionCurrent.root
  actionSeedTransported :
    stage.nextCarrier.action.criticalBearer.bearerLineage.seed =
      stage.transportedSeed
  phaseNonzero : essentialAccessRelationCompiler.phaseStep
    (essentialAccessCriticalRelation stage.nextCarrier.event) ≠ 0
  targetRoleGenerated : essentialAccessRelationCompiler.roleAt
      (essentialAccessCriticalRelation stage.nextCarrier.event) .target =
    essentialAccessRelationCompiler.advanceRole
      Lifecycle.actualEventGame.source
      (essentialAccessRelationCompiler.phaseStep
        (essentialAccessCriticalRelation stage.nextCarrier.event))
      (essentialAccessRelationCompiler.roleAt
        (essentialAccessCriticalRelation stage.nextCarrier.event) .source)
  transportFlat : FlatPrincipalConnection
    (canonicalRelationSeedTransition EssentialAccessSector
      essentialAccessRelationCompiler.ExactRelationSeed)
  transportHolonomyOne : ∀ left middle right,
    principalTriangleHolonomy
      (canonicalRelationSeedTransition EssentialAccessSector
        essentialAccessRelationCompiler.ExactRelationSeed)
      left middle right = 1

theorem sourceSealAt
    (stage : RelationLineageRecurrenceStage)
    (exactSource : ExactTemporalCausalRootEventAt
      stage.sourceRoot.toAuthoritativeRoot.toLedgerRoot stage.actionVisit) :
    SourceSealAt stage exactSource := by
  rw [exactSource.eq_generated]
  exact
    { sourceCanonical := rfl
      carrierFromFold := rfl
      selectedSeedRoot := stage.selected.selectedSeed_eq_currentRoot
      actionSeedTransported := stage.actionSeed_eq_transportedSeed
      phaseNonzero :=
        (criticalActionCarrier_directConsumer stage.nextCarrier).2.2.1
      targetRoleGenerated :=
        (criticalActionCarrier_directConsumer stage.nextCarrier).2.2.2
      transportFlat := canonicalRelationSeedTransition_flat _ _
      transportHolonomyOne := canonicalRelationSeedTransition_holonomy_one _ _ }

def program (stage : RelationLineageRecurrenceStage) :=
  sequentialCriticalActionAppendProgram stage.predecessorRoot
    stage.predecessorOccurrence stage.sourcePrior stage.sourceCarrier
    stage.actionVisit (criticalActionAppendEntryAt 1)
    (criticalActionAppendAuthorityAt stage.predecessorRoot
      stage.predecessorOccurrence stage.sourcePrior stage.sourceCarrier 1)
    stage.actionCurrent stage.nextCarrier rfl rfl
