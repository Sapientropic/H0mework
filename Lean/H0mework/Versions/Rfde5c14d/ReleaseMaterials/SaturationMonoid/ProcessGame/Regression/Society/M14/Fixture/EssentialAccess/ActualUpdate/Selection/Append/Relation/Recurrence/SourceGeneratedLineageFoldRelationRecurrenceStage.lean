    stage.predecessorOccurrence stage.sourcePrior stage.sourceCarrier
    stage.actionVisit (criticalActionAppendEntryAt 1)
    (criticalActionAppendAuthorityAt stage.predecessorRoot
      stage.predecessorOccurrence stage.sourcePrior stage.sourceCarrier 1)
    stage.actionCurrent stage.nextCarrier rfl rfl
    (SourceSealAt stage) (sourceSealAt stage) stage.exactSource

def actualActionCompilation (stage : RelationLineageRecurrenceStage) :=
  sequentialCriticalActionAppendActualActionCompilation stage.predecessorRoot
    stage.predecessorOccurrence stage.sourcePrior stage.sourceCarrier
    stage.actionVisit (criticalActionAppendEntryAt 1)
    (criticalActionAppendAuthorityAt stage.predecessorRoot
      stage.predecessorOccurrence stage.sourcePrior stage.sourceCarrier 1)
    stage.actionCurrent stage.nextCarrier rfl rfl
