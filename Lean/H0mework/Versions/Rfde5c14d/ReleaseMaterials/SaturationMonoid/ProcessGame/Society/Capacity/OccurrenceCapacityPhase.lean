import H0mework.Versions.Re60a8605.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Capacity.SourceGeneratedOccurrenceRate
import H0mework.Versions.AB.Society.Renewal.InstalledRenewalProjection

/-!
# Source-generated occurrence-capacity phase

An occurrence-capacity phase is a dependent readout of one exact installed
renewal, one source-owned occurrence-rate compiler whose focal seed is the
installed renewal seed, and one exact prefix seal of that compiler's queue.

The prefix cut lives in `Fin (compiler.queue.length + 1)`.  Its bound is
generated by the queue itself, so this module admits neither a bare horizon
nor a fixed finite range.  The prefix value is always `compiler.queue.take
cut`; callers cannot submit queue content or a reordered list.

Capacity is the renewed operational standing's existing progress budget.
No producer accepts a rate, capacity, served count, backlog, spare capacity,
or phase label.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace Capacity

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Renewal

universe u uLineage uUnit

variable {LocalSource LocalState Seed : Type u}
variable {occurrenceOf : LocalSource → RootedAccountedUnfolding LocalState}
variable {game : SaturationMonoid.ProcessGame occurrenceOf}
variable {SeedAt : LocalSource → LocalState → Seed → Prop}
variable {Lineage : LocalSource → Type uLineage}
variable {lineageOf : ∀ source,
  SourceSeed occurrenceOf Seed SeedAt source → Lineage source}

variable {N : WorldRelationNetwork.{u}}
variable {RootV : ConstructiveRoot.Vocabulary.{u}}
variable {root : SourceNativeLivingRootClosure N RootV}
variable {ConsumerAt DispositionAt :
  SourceSeed occurrenceOf Seed SeedAt game.source → Type u}
variable {recognition : SourceNativeRenewalRecognitionAt root game Seed SeedAt
  ConsumerAt DispositionAt}
variable {visit : SourceNativeTemporalVisitAt
  root.toAuthoritativeRoot.toLedgerRoot}
variable {installed : SourceInstalledRenewalAt recognition visit}

variable {compiler : SourceOwnedOccurrenceRateCompiler.{u, u, u,
  uLineage, uUnit} game Seed SeedAt Lineage lineageOf
    installed.payload.sourceSeed}

/-! ## Source-bounded exact queue prefix -/

/-- Private seal for one source-bounded prefix of the compiler-owned queue.
The only stored coordinate is bounded by that exact queue's generated length. -/
structure SourceGeneratedExactQueuePrefixAt
    (compiler : SourceOwnedOccurrenceRateCompiler.{u, u, u,
      uLineage, uUnit} game Seed SeedAt Lineage lineageOf
        installed.payload.sourceSeed) :
    Type (max u uLineage (uUnit + 1)) where
  private mk ::
  private cutIndex : Fin (compiler.queue.length + 1)

namespace SourceGeneratedExactQueuePrefixAt

/-- Sole prefix producer.  The cut is not a bare natural horizon: its upper
bound is definitionally the exact compiler-owned queue length. -/
def generate
    (compiler : SourceOwnedOccurrenceRateCompiler.{u, u, u,
      uLineage, uUnit} game Seed SeedAt Lineage lineageOf
        installed.payload.sourceSeed)
    (cut : Fin (compiler.queue.length + 1)) :
    SourceGeneratedExactQueuePrefixAt compiler :=
  ⟨cut⟩

variable (exactPrefix : SourceGeneratedExactQueuePrefixAt compiler)

/-- Exact source-bounded cut coordinate. -/
def boundedCut : Fin (compiler.queue.length + 1) :=
  exactPrefix.cutIndex

/-- Source-bounded cut as a readout. -/
def cut : Nat :=
  exactPrefix.boundedCut

/-- The cut never exceeds the exact compiler queue. -/
theorem cut_le_queueLength : exactPrefix.cut ≤ compiler.queue.length :=
  Nat.lt_succ_iff.mp exactPrefix.boundedCut.isLt

/-- Exact prefix content; no list is accepted by the producer. -/
def units : List compiler.QueueUnit :=
  compiler.queue.take exactPrefix.cut

@[simp] theorem units_eq_take :
    exactPrefix.units = compiler.queue.take exactPrefix.cut :=
  rfl

/-- The exact prefix length is its source-bounded cut. -/
@[simp] theorem units_length :
    exactPrefix.units.length = exactPrefix.cut := by
  simp [units, exactPrefix.cut_le_queueLength]

/-- Prefix and compiler-owned suffix reconstruct the sole source queue. -/
theorem units_append_suffix :
    exactPrefix.units ++ compiler.queue.drop exactPrefix.cut = compiler.queue := by
  exact List.take_append_drop exactPrefix.cut compiler.queue

/-- Duplicate-freedom is inherited from the exact source queue. -/
theorem units_nodup : exactPrefix.units.Nodup :=
  compiler.queue_nodup.take

/-- Every prefix seal is exactly the seal generated at its retained cut. -/
theorem eq_generate : exactPrefix = generate compiler exactPrefix.boundedCut := by
  cases exactPrefix
  rfl

end SourceGeneratedExactQueuePrefixAt

variable {exactPrefix : SourceGeneratedExactQueuePrefixAt compiler}

/-! ## Zero-choice phase authority -/

/-- Public presentation tag only.  It has no constructor into phase
authority. -/
inductive OccurrenceCapacityPhaseTag
  | stable
  | critical
  | anomie
  deriving DecidableEq

/-- Existing capacity of the exact installed operational standing. -/
def operationalCapacity
    (installed : SourceInstalledRenewalAt recognition visit) : Nat :=
  installed.operationalAuthority.operationalStanding.progressBudget

/-- Internal exhaustive comparison.  Bare natural numbers cannot reach the
authority carrier below; this helper is only its computed tag readout. -/
private def classifyOccurrenceCapacity
    (rate capacity : Nat) : OccurrenceCapacityPhaseTag :=
  if rate < capacity then .stable
  else if rate = capacity then .critical
  else .anomie

private theorem classifyOccurrenceCapacity_eq_stable_iff
    (rate capacity : Nat) :
    classifyOccurrenceCapacity rate capacity = .stable ↔ rate < capacity := by
  unfold classifyOccurrenceCapacity
  split <;> rename_i rate_lt_capacity
  · simp_all
  · split <;> rename_i rate_eq_capacity <;> simp_all

private theorem classifyOccurrenceCapacity_eq_critical_iff
    (rate capacity : Nat) :
    classifyOccurrenceCapacity rate capacity = .critical ↔ rate = capacity := by
  unfold classifyOccurrenceCapacity
  split <;> rename_i rate_lt_capacity
  · simp_all
    omega
  · split <;> rename_i rate_eq_capacity <;> simp_all

private theorem classifyOccurrenceCapacity_eq_anomie_iff
    (rate capacity : Nat) :
    classifyOccurrenceCapacity rate capacity = .anomie ↔ capacity < rate := by
  unfold classifyOccurrenceCapacity
  split <;> rename_i rate_lt_capacity
  · simp_all
    omega
  · split
    · rename_i rate_eq_capacity
      simp_all
    · rename_i rate_ne_capacity
      simp_all
      omega

/-- Zero-choice authority at one installed renewal and one exact source queue
prefix.  The private empty constructor stores no queue, scalar, tag, or
horizon. -/
structure SourceGeneratedOccurrenceCapacityPhaseAt
    (installed : SourceInstalledRenewalAt recognition visit)
    (compiler : SourceOwnedOccurrenceRateCompiler.{u, u, u,
      uLineage, uUnit} game Seed SeedAt Lineage lineageOf
        installed.payload.sourceSeed)
    (_prefix : SourceGeneratedExactQueuePrefixAt compiler) :
    Type (max (u + 2) (max uLineage (uUnit + 1))) where
  private mk ::

namespace SourceGeneratedOccurrenceCapacityPhaseAt

/-- Sole phase producer.  Phase authority is indexed by an already-generated
exact prefix seal; it accepts no scalar or classification input. -/
def generate
    (installed : SourceInstalledRenewalAt recognition visit)
    (compiler : SourceOwnedOccurrenceRateCompiler.{u, u, u,
      uLineage, uUnit} game Seed SeedAt Lineage lineageOf
        installed.payload.sourceSeed)
    (exactPrefix : SourceGeneratedExactQueuePrefixAt compiler) :
    SourceGeneratedOccurrenceCapacityPhaseAt installed compiler exactPrefix :=
  ⟨⟩

variable (phase :
  SourceGeneratedOccurrenceCapacityPhaseAt installed compiler exactPrefix)

/-- Every token at these exact indices is the unique generated phase. -/
theorem eq_generate : phase = generate installed compiler exactPrefix := by
  cases phase
  rfl

/-- Exact focal seed locked into the rate compiler's dependent type. -/
def focalSeed : SourceSeed occurrenceOf Seed SeedAt game.source := by
  cases phase
  exact installed.payload.sourceSeed

@[simp] theorem focalSeed_eq_installedSeed :
    phase.focalSeed = installed.payload.sourceSeed :=
  rfl

/-- Exact compiler-owned queue prefix selected by the indexed private seal. -/
def queuePrefix : List compiler.QueueUnit := by
  cases phase
  exact exactPrefix.units

@[simp] theorem queuePrefix_eq_prefixUnits :
    phase.queuePrefix = exactPrefix.units :=
  rfl

/-- Queue-prefix integrity inherited from the source compiler. -/
theorem queuePrefix_nodup : phase.queuePrefix.Nodup :=
  exactPrefix.units_nodup

/-- Settlement capacity is the existing renewed operational budget. -/
def capacity : Nat := by
  cases phase
  exact operationalCapacity installed

@[simp] theorem capacity_eq_operationalProgressBudget :
    phase.capacity =
      installed.operationalAuthority.operationalStanding.progressBudget :=
  rfl

/-- Occurrence rate is the exact prefix length. -/
def rate : Nat :=
  phase.queuePrefix.length

@[simp] theorem rate_eq_prefixLength :
    phase.rate = exactPrefix.units.length :=
  rfl

@[simp] theorem rate_eq_prefixCut :
    phase.rate = exactPrefix.cut :=
  exactPrefix.units_length

/-- Queue portion served by the exact operational capacity. -/
def served : List compiler.QueueUnit :=
  phase.queuePrefix.take phase.capacity

/-- Queue suffix exceeding the exact operational capacity. -/
def backlog : List compiler.QueueUnit :=
  phase.queuePrefix.drop phase.capacity

/-- Unused exact operational capacity. -/
def spare : Nat :=
  phase.capacity - phase.rate

/-- Phase tag generated by the unique internal comparison. -/
def phaseTag : OccurrenceCapacityPhaseTag :=
  classifyOccurrenceCapacity phase.rate phase.capacity

@[simp] theorem phaseTag_eq_stable_iff :
    phase.phaseTag = .stable ↔ phase.rate < phase.capacity := by
  change classifyOccurrenceCapacity phase.rate phase.capacity = .stable ↔
    phase.rate < phase.capacity
  exact classifyOccurrenceCapacity_eq_stable_iff _ _

@[simp] theorem phaseTag_eq_critical_iff :
    phase.phaseTag = .critical ↔ phase.rate = phase.capacity := by
  change classifyOccurrenceCapacity phase.rate phase.capacity = .critical ↔
    phase.rate = phase.capacity
  exact classifyOccurrenceCapacity_eq_critical_iff _ _

@[simp] theorem phaseTag_eq_anomie_iff :
    phase.phaseTag = .anomie ↔ phase.capacity < phase.rate := by
  change classifyOccurrenceCapacity phase.rate phase.capacity = .anomie ↔
    phase.capacity < phase.rate
  exact classifyOccurrenceCapacity_eq_anomie_iff _ _

/-- The internal comparison closes the three phase cases. -/
theorem phaseTag_exhaustive :
    phase.phaseTag = .stable ∨
      phase.phaseTag = .critical ∨
        phase.phaseTag = .anomie := by
  rcases Nat.lt_trichotomy phase.rate phase.capacity with
    rate_lt_capacity | rate_eq_capacity | capacity_lt_rate
  · exact Or.inl (phase.phaseTag_eq_stable_iff.mpr rate_lt_capacity)
  · exact Or.inr (Or.inl
      (phase.phaseTag_eq_critical_iff.mpr rate_eq_capacity))
  · exact Or.inr (Or.inr
      (phase.phaseTag_eq_anomie_iff.mpr capacity_lt_rate))

/-- Served prefix and backlog suffix reconstruct the exact queue prefix. -/
theorem served_append_backlog :
    phase.served ++ phase.backlog = phase.queuePrefix := by
  exact List.take_append_drop phase.capacity phase.queuePrefix

@[simp] theorem served_length :
    phase.served.length = min phase.capacity phase.rate := by
  simp [served, rate]

@[simp] theorem backlog_length :
    phase.backlog.length = phase.rate - phase.capacity := by
  simp [backlog, rate]

@[simp] theorem spare_eq_capacity_sub_rate :
    phase.spare = phase.capacity - phase.rate :=
  rfl

/-- Stable phase has no backlog. -/
theorem stable_backlog_eq_nil
    (stable : phase.phaseTag = .stable) :
    phase.backlog = [] := by
  have rate_lt_capacity := phase.phaseTag_eq_stable_iff.mp stable
  apply List.drop_eq_nil_iff.mpr
  simpa [rate] using rate_lt_capacity.le

/-- Stable phase retains strictly positive spare capacity. -/
theorem stable_spare_pos
    (stable : phase.phaseTag = .stable) :
    0 < phase.spare := by
  have rate_lt_capacity := phase.phaseTag_eq_stable_iff.mp stable
  exact Nat.sub_pos_of_lt rate_lt_capacity

/-- Critical phase has no backlog. -/
theorem critical_backlog_eq_nil
    (critical : phase.phaseTag = .critical) :
    phase.backlog = [] := by
  have rate_eq_capacity := phase.phaseTag_eq_critical_iff.mp critical
  apply List.drop_eq_nil_iff.mpr
  simpa [rate] using rate_eq_capacity.le

/-- Critical phase exhausts spare capacity exactly. -/
theorem critical_spare_eq_zero
    (critical : phase.phaseTag = .critical) :
    phase.spare = 0 := by
  have rate_eq_capacity := phase.phaseTag_eq_critical_iff.mp critical
  unfold spare
  omega

/-- Anomie is witnessed by an inhabited backlog, not merely a scalar tag. -/
theorem anomie_backlog_ne_nil
    (anomie : phase.phaseTag = .anomie) :
    phase.backlog ≠ [] := by
  have capacity_lt_rate := phase.phaseTag_eq_anomie_iff.mp anomie
  intro backlog_eq
  have backlog_length_zero : phase.backlog.length = 0 := by
    simp [backlog_eq]
  rw [phase.backlog_length] at backlog_length_zero
  have backlog_length_pos : 0 < phase.rate - phase.capacity :=
    Nat.sub_pos_of_lt capacity_lt_rate
  omega

/-- In anomie the exact backlog length is the excess occurrence rate. -/
theorem anomie_backlog_length
    (_anomie : phase.phaseTag = .anomie) :
    phase.backlog.length = phase.rate - phase.capacity :=
  phase.backlog_length

end SourceGeneratedOccurrenceCapacityPhaseAt

/-! ## Same-source generation of all available phases -/

/-- Empty exact prefix, generated at the queue-owned lower boundary. -/
def emptyExactQueuePrefix
    (compiler : SourceOwnedOccurrenceRateCompiler.{u, u, u,
      uLineage, uUnit} game Seed SeedAt Lineage lineageOf
        installed.payload.sourceSeed) :
    SourceGeneratedExactQueuePrefixAt compiler :=
  SourceGeneratedExactQueuePrefixAt.generate compiler
    ⟨0, Nat.zero_lt_succ _⟩

/-- Same-source empty-prefix phase. -/
def emptyPrefixPhase
    (installed : SourceInstalledRenewalAt recognition visit)
    (compiler : SourceOwnedOccurrenceRateCompiler.{u, u, u,
      uLineage, uUnit} game Seed SeedAt Lineage lineageOf
        installed.payload.sourceSeed) :
    SourceGeneratedOccurrenceCapacityPhaseAt installed compiler
      (emptyExactQueuePrefix compiler) :=
  SourceGeneratedOccurrenceCapacityPhaseAt.generate installed compiler
    (emptyExactQueuePrefix compiler)

/-- Positive operational capacity makes the exact empty prefix stable. -/
theorem emptyPrefixPhase_is_stable
    (capacity_pos : 0 < operationalCapacity installed) :
    (emptyPrefixPhase installed compiler).phaseTag = .stable := by
  apply (SourceGeneratedOccurrenceCapacityPhaseAt.phaseTag_eq_stable_iff
    (emptyPrefixPhase installed compiler)).mpr
  rw [SourceGeneratedOccurrenceCapacityPhaseAt.rate_eq_prefixCut]
  simpa [SourceGeneratedExactQueuePrefixAt.cut, emptyExactQueuePrefix,
    SourceGeneratedOccurrenceCapacityPhaseAt.capacity,
    operationalCapacity]

/-- Exact prefix cut at the source capacity, available precisely when that
capacity lies within the compiler queue. -/
def capacityExactQueuePrefix
    (fits : operationalCapacity installed ≤ compiler.queue.length) :
    SourceGeneratedExactQueuePrefixAt compiler :=
  SourceGeneratedExactQueuePrefixAt.generate compiler
    ⟨operationalCapacity installed, Nat.lt_succ_iff.mpr fits⟩

/-- Same-source critical phase at the exact capacity cut. -/
def capacityPrefixPhase
    (fits : operationalCapacity installed ≤ compiler.queue.length) :
    SourceGeneratedOccurrenceCapacityPhaseAt installed compiler
      (capacityExactQueuePrefix fits) :=
  SourceGeneratedOccurrenceCapacityPhaseAt.generate installed compiler
    (capacityExactQueuePrefix fits)

@[simp] theorem capacityPrefixPhase_is_critical
    (fits : operationalCapacity installed ≤ compiler.queue.length) :
    (capacityPrefixPhase fits).phaseTag = .critical := by
  apply (SourceGeneratedOccurrenceCapacityPhaseAt.phaseTag_eq_critical_iff
    (capacityPrefixPhase fits)).mpr
  rw [SourceGeneratedOccurrenceCapacityPhaseAt.rate_eq_prefixCut]
  rfl

/-- Exact one-over-capacity cut, available precisely when the queue exceeds
the installed operational capacity. -/
def excessExactQueuePrefix
    (overloaded : operationalCapacity installed < compiler.queue.length) :
    SourceGeneratedExactQueuePrefixAt compiler :=
  SourceGeneratedExactQueuePrefixAt.generate compiler
    ⟨operationalCapacity installed + 1, Nat.succ_lt_succ overloaded⟩

/-- Same-source anomie phase at the first exact overloaded cut. -/
def excessPrefixPhase
    (overloaded : operationalCapacity installed < compiler.queue.length) :
    SourceGeneratedOccurrenceCapacityPhaseAt installed compiler
      (excessExactQueuePrefix overloaded) :=
  SourceGeneratedOccurrenceCapacityPhaseAt.generate installed compiler
    (excessExactQueuePrefix overloaded)

@[simp] theorem excessPrefixPhase_is_anomie
    (overloaded : operationalCapacity installed < compiler.queue.length) :
    (excessPrefixPhase overloaded).phaseTag = .anomie := by
  apply (SourceGeneratedOccurrenceCapacityPhaseAt.phaseTag_eq_anomie_iff
    (excessPrefixPhase overloaded)).mpr
  rw [SourceGeneratedOccurrenceCapacityPhaseAt.rate_eq_prefixCut]
  exact Nat.lt_succ_self _

/-- Whenever the exact source queue strictly exceeds a positive operational
capacity, three source-bounded cuts of that same installed/compiler pair
generate stable, critical, and anomie without changing queue content or
supplying a phase tag. -/
theorem sameSource_generates_threePhases
    (capacity_pos : 0 < operationalCapacity installed)
    (overloaded : operationalCapacity installed < compiler.queue.length) :
    (emptyPrefixPhase installed compiler).phaseTag = .stable ∧
      (capacityPrefixPhase overloaded.le).phaseTag = .critical ∧
        (excessPrefixPhase overloaded).phaseTag = .anomie :=
  ⟨emptyPrefixPhase_is_stable capacity_pos,
    capacityPrefixPhase_is_critical overloaded.le,
    excessPrefixPhase_is_anomie overloaded⟩

end Capacity
end Society
end ProcessGame
end SaturationMonoid
