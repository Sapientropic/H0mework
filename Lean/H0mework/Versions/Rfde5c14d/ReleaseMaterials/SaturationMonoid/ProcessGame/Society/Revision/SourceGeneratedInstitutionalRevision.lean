import H0mework.Versions.AB.Society.Renewal.InstalledRenewalProjection
import H0mework.Versions.R2.Foundation.Inquiry.MinimalCoface
import H0mework.Versions.R2.Foundation.Inquiry.RevisionRecovery

/-!
# Source-generated institutional revision

Institutional reform and revolutionary revision are two restrictions of the
existing living-law root machinery.  This module creates neither a society
root nor a legislation ledger.

A bounded reform is indexed by one already generated temporal row and its
whole-ledger successor.  Its factorization is the root compiler's finite
current patch; its lineage and next current are read from the same compiler
image.  No factor family, target row, law surface, or next current is supplied
at the reform mouth.

A revolutionary revision is indexed by one `RootedActualExpressibilityFailureAt`.
Its minimal coface, attaching direction, initial factorization, and first-write
data are therefore generated by that exact rooted failure.  A concrete revised
living source remains a downstream realization responsibility; it is not a
field of this generic core.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace Revision

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Renewal
open ConstructiveRoot.ObstructionGeneratedMinimalCoface
open ConstructiveRoot.TypedSemanticWorldNetworkU8
open ConstructiveRoot.TypedSemanticWorldNetworkU8Recovery

universe u

/-! ## Bounded same-law reform -/

variable {N : WorldRelationNetwork.{u}}
variable {V : ConstructiveRoot.Vocabulary.{u}}
variable {root : SourceNativeLivingRootClosure N V}
variable {visit : SourceNativeTemporalVisitAt
  root.toAuthoritativeRoot.toLedgerRoot}

private abbrev generatedAt
    (root : SourceNativeLivingRootClosure N V)
    (visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot) :=
  root.toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit visit

/-- A reform is generated only after the fixed temporal occurrence has
selected the residual row and generated its whole-ledger successor.

The empty private constructor is intentional: the exact finite
factorization, target row, lineage, law surface, and next current are all
recoverable from the indices. -/
structure SourceNativeBoundedInstitutionalReformAt
    {sourceEntry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    (residual : RootInstalledRenewalAt (generatedAt root visit) sourceEntry) :
    Type (u + 1) where
  private mk ::

namespace SourceNativeBoundedInstitutionalReformAt

variable
    {sourceEntry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {residual : RootInstalledRenewalAt (generatedAt root visit) sourceEntry}

/-- The exact generated residual row is already a finite-patch row of the
same temporal occurrence.  This is the source-native bounded factorization
witness; callers do not submit factors or their bound. -/
def generate
    (residual : RootInstalledRenewalAt (generatedAt root visit) sourceEntry) :
    SourceNativeBoundedInstitutionalReformAt residual :=
  ⟨⟩

variable
    (reform : SourceNativeBoundedInstitutionalReformAt residual)

/-- The complete finite factorization is the root compiler's current patch. -/
def finiteFactorization
    (_reform : SourceNativeBoundedInstitutionalReformAt residual) :=
  (generatedAt root visit).currentPatch

/-- Exact source-generated row selected inside the finite factorization. -/
def residualRow
    (_reform : SourceNativeBoundedInstitutionalReformAt residual) :
    (generatedAt root visit).GeneratedEntryRowAt sourceEntry :=
  residual.exactEventMembership

/-- The selected row agrees with the same occurrence's whole-ledger fold. -/
theorem residualRow_commutes_with_wholeLedger :
    reform.residualRow.sourceRow.CommutesWithWorld :=
  RootInstalledRenewalAt.selected_commutes_with_world residual

/-- Operational target row generated by the whole-ledger successor. -/
def targetEntry
    (_reform : SourceNativeBoundedInstitutionalReformAt residual) :
    OpenResponsibilityAt N
    (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
      residual.successor.targetOccurrence) :=
  residual.operationalStanding

/-- Exact same-row evolution generated by the current occurrence. -/
def rowEvolution : LedgerEntryEvolutionAt N sourceEntry reform.targetEntry :=
  residual.worldEvolution

/-- Reform preserves the debt lineage and claim of the institutional row. -/
def debtLineage : RootDebtLineageAt N sourceEntry reform.targetEntry :=
  residual.debtLineage

/-- Reform never refills the source-owned progress budget. -/
theorem progressBudget_not_refilled :
    reform.targetEntry.progressBudget <= sourceEntry.progressBudget :=
  RootInstalledRenewalAt.progressBudget_not_refilled residual

/-- Exact whole-ledger write-back consumed by the finite factorization. -/
def wholeLedgerWriteBack
    (_reform : SourceNativeBoundedInstitutionalReformAt residual) :
    SourceNativeLedgerEvolutionAt
      root.toAuthoritativeRoot.toLedgerRoot.source.source
      (root.emitted visit.current) :=
  (generatedAt root visit).wholeLedgerWriteBack

/-- The reform's answer-and-next token is generated by the fixed living root. -/
def answerAndNext
    (_reform : SourceNativeBoundedInstitutionalReformAt residual) :
    SourceNativeLivingRootCausalEvolutionAt root
    (ULift.up visit) :=
  root.canonicalCausalAnswerAndNext (ULift.up visit)

/-- The reform cannot substitute a sibling patch for the answer-and-next
compiler image. -/
theorem answerAndNext_generated_eq :
    reform.answerAndNext.generated = generatedAt root visit :=
  rfl

/-- Generated next current of this exact reform occurrence. -/
def generatedNext : SourceNativeAuthoritativeRootCurrentAt N :=
  reform.answerAndNext.nextCurrent

/-- No factorization payload can alter the root-generated next current. -/
theorem generatedNext_eq_rootCompiler :
    reform.generatedNext = root.generatedNextCurrentAt visit :=
  rfl

/-- A bounded reform stays on the fixed law surface. -/
theorem lawSurface_preserved :
    reform.generatedNext.root.source.lawSurface =
      root.source.base.lawSurface := by
  rw [reform.generatedNext_eq_rootCompiler]
  exact root.generatedNextCurrentAt_lawSurface_eq visit

end SourceNativeBoundedInstitutionalReformAt

/-! ## Rooted U8 revolutionary revision -/

variable {OldV : ConstructiveRoot.Vocabulary.{u}}
variable {oldWorld : SourceNativeAuthoritativeRootClosure N OldV}
variable {oldVisit : SourceNativeTemporalVisitAt oldWorld.toLedgerRoot}
variable {U7 : U7ProducerCalculus N}
variable {oldTheory : TheoryState N}
variable {support : N.Support}
variable {obstruction : N.ObstructionAt support}
variable {failure : ActualExpressibilityFailure oldTheory obstruction}

/-- Canonical revolutionary core generated by one exact rooted U7/U8 failure.

The private zero-field constructor prevents a caller from supplying a target
revision, new direction, factorization, first write, or answer. -/
structure RootedRevolutionaryInstitutionalRevisionAt
    (rooted : RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7 failure) : Type (u + 10) where
  private mk ::

namespace RootedRevolutionaryInstitutionalRevisionAt

variable {rooted : RootedActualExpressibilityFailureAt
  oldWorld oldVisit U7 failure}

/-- Generate the revolutionary core from the already rooted failure. -/
def generate
    (rooted : RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7 failure) :
    RootedRevolutionaryInstitutionalRevisionAt rooted :=
  ⟨⟩

/-- Direct source-face producer.  The failure face, causal-entry authority,
and successor must all belong to the same fixed root occurrence; the rooted
failure constructor enforces that dependency before the revolutionary core
is generated. -/
def ofRootFailureFace
    (face : SourceNativeRootExpressibilityFailureFaceAt
      oldWorld oldVisit (U7 := U7) failure)
    (authority : SourceNativeAuthoritativeTemporalCausalEntryAuthorityAt
      oldWorld oldVisit face.rootEntry)
    (successor : CausalEntrySuccessorAt oldWorld.toLedgerRoot oldVisit
      face.rootEntry) :
    RootedRevolutionaryInstitutionalRevisionAt
      (RootedActualExpressibilityFailureAt.ofRootFailureFace
        face authority successor) :=
  generate _

variable
    (revision : RootedRevolutionaryInstitutionalRevisionAt rooted)

/-- The old expression fibre is empty at the exact failed claim. -/
theorem oldExpression_empty
    (_revision : RootedRevolutionaryInstitutionalRevisionAt rooted) :
    IsEmpty (oldTheory.ExpressesAt support
      (N.obstructionClaim obstruction)) :=
  failure.notExpressible

/-- The complete old law inventory has no lawful realization of the exact
obstruction. -/
theorem oldRealization_empty
    (_revision : RootedRevolutionaryInstitutionalRevisionAt rooted) :
    IsEmpty (oldTheory.inventory.RealizationAt obstruction) :=
  failure.noLawfulRealization

/-- Unique attaching direction generated by the rooted failure. -/
def minimalCoface
    (_revision : RootedRevolutionaryInstitutionalRevisionAt rooted) :
    GeneratedMinimalCofaceAt rooted :=
  root_obstruction_generates_minimal_coface rooted

/-- Exact source-generated attachment, indexed by the same rooted failure. -/
def attachingDirection : SourceGeneratedAttachingDirectionAt rooted :=
  revision.minimalCoface.attachingDirection

/-- The canonical minimal coface is itself an admissible revolutionary
revision; no candidate carrier is supplied by a caller. -/
def canonicalAdmissibleRevision : AdmissibleCofaceRevisionAt rooted :=
  revision.minimalCoface.toAdmissibleWorldCoface

/-- Initial factorization of the obstruction-generated coface into its
canonical whole-network realization. -/
def initialFactorization : FaithfulCofaceMorphism revision.minimalCoface
    revision.canonicalAdmissibleRevision :=
  minimal_coface_initial revision.minimalCoface
    revision.canonicalAdmissibleRevision

/-- The initial factorization is the only lawful factorization into the
canonical revolutionary carrier. -/
theorem initialFactorization_unique
    (morphism : FaithfulCofaceMorphism revision.minimalCoface
      revision.canonicalAdmissibleRevision) :
    morphism = revision.initialFactorization := by
  exact minimal_coface_factorization_unique morphism

/-- Exact target occurrence of the old-root causal successor which becomes
the first actual write of the generated coface. -/
def firstWriteOccurrence :=
  revision.minimalCoface.firstWriteOccurrence

/-- Exact whole-ledger row evolution used by that first write. -/
def firstWriteEntryEvolution :=
  revision.minimalCoface.firstWriteEntryEvolution

/-- The first write lands on the old target as the restriction of the newly
generated coface support; it does not introduce a sibling target. -/
theorem firstWrite_target_is_cofaceRestriction :
    revision.minimalCoface.translation.support.backward
        revision.minimalCoface.cofaceSupport =
      oldWorld.toRoot.supportAt rooted.successor.next :=
  revision.minimalCoface.firstWrite_targetSupport_is_cofaceRestriction

/-- The generated obstruction row has no old-ledger preimage. -/
theorem generatedRow_hasNoOldPreimage :
    IsEmpty (Sigma fun oldEntry : OpenResponsibilityAt N
        (oldWorld.toRoot.supportAt rooted.successor.next) =>
      PLift (revision.minimalCoface.cofaceLedgerRetract.forward oldEntry =
        revision.minimalCoface.obstructionEntry)) :=
  revision.minimalCoface.obstructionEntry_hasNoOldPreimage

/-- The new direction is attached to the exact old obstruction. -/
theorem attachingBoundary_exact :
    revision.attachingDirection.direction.boundary = obstruction := by
  cases revision.attachingDirection.boundary
  rfl

end RootedRevolutionaryInstitutionalRevisionAt

/-! ## Build-time revolutionary realization candidate -/

/-- A concrete revised source candidate realizes the already generated
minimal coface.  Both the revolutionary core and the field-grounded candidate
are indices; no revised root, first write, factorization, or next is stored in
this zero-field carrier.

This carrier is deliberately not actual-event authority.  It becomes an
institutional revolution only after the canonical inquiry runtime consumes
the same U8 core; that stronger mouth lives in
`SourceGeneratedInstitutionalDichotomy`. -/
structure SourceRealizedRevolutionaryInstitutionalRevisionAt
    {rooted : RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7 failure}
    (revision : RootedRevolutionaryInstitutionalRevisionAt rooted)
    (source : FieldGroundedTypedSemanticWorldNetworkRevisionAt rooted) :
    Type (u + 10) where
  private mk ::

namespace SourceRealizedRevolutionaryInstitutionalRevisionAt

variable {rooted : RootedActualExpressibilityFailureAt
  oldWorld oldVisit U7 failure}
variable {revision : RootedRevolutionaryInstitutionalRevisionAt rooted}
variable {source : FieldGroundedTypedSemanticWorldNetworkRevisionAt rooted}

/-- Seal a build-time concrete realization candidate of the generated minimal
coface.  This producer does not assert runtime installation. -/
def generate
    (revision : RootedRevolutionaryInstitutionalRevisionAt rooted)
    (source : FieldGroundedTypedSemanticWorldNetworkRevisionAt rooted) :
    SourceRealizedRevolutionaryInstitutionalRevisionAt revision source :=
  ⟨⟩

variable
    (realized : SourceRealizedRevolutionaryInstitutionalRevisionAt
      revision source)

/-- Initial factorization, attached first write, and both revised live-row
answers share one generated receipt. -/
def factorizationAndAnswerAndNext
    (_realized : SourceRealizedRevolutionaryInstitutionalRevisionAt
      revision source) :=
  factorizesThroughInitialCofaceAnswerAndNext source

/-- Candidate revised living root; runtime authority is intentionally absent. -/
def revisedLivingRoot := source.generate.newLivingRoot

/-- The inherited row's revised answer-and-next. -/
def inheritedAnswerAndNext
    (_realized : SourceRealizedRevolutionaryInstitutionalRevisionAt
      revision source) :=
  generatedOldTargetAnswerAndNext source

/-- The new-only obstruction row's revised answer-and-next. -/
def generatedAnswerAndNext
    (_realized : SourceRealizedRevolutionaryInstitutionalRevisionAt
      revision source) :=
  generatedNewTargetAnswerAndNext source

/-- Both revised rows are adjudicated by the same generated living next. -/
theorem rows_share_generated_next :
    realized.inheritedAnswerAndNext.nextCurrent =
      realized.generatedAnswerAndNext.nextCurrent :=
  rfl

/-- The concrete realization factors through the same minimal coface as the
revolutionary core; it cannot substitute a sibling rooted failure. -/
def faithfulInitialFactorization :
    FaithfulCofaceMorphism revision.minimalCoface
      source.generate.toAdmissibleMinimalCoface :=
  source.generate.factorizesThroughInitialCoface.1

end SourceRealizedRevolutionaryInstitutionalRevisionAt

/-! ## Source-owned rupture -/

variable {RuptureV : ConstructiveRoot.Vocabulary.{u}}

/-- Exact institutional rupture at a faithful-terminal authoritative root
occurrence.

This mouth deliberately stops before a living terminal handoff is installed.
The exact residual row is discharged, no same-ledger renewal/reform successor
exists, and an absent installed failure face cannot be replaced by a bare
failure proposition. -/
structure SourceOwnedInstitutionalRuptureAt
    {world : SourceNativeAuthoritativeRootClosure N RuptureV}
    {ruptureVisit : SourceNativeTemporalVisitAt world.toLedgerRoot}
    {sourceEntry : OpenResponsibilityAt N
      (world.toLedgerRoot.source.source.toRootSource.account.supportOf
        (world.emitted ruptureVisit.current))}
    (terminal : SourceFaithfulTerminalOccurrenceAt world.source
      (world.emitted ruptureVisit.current)) : Type (u + 2) where
  private mk ::

namespace SourceOwnedInstitutionalRuptureAt

variable
    {world : SourceNativeAuthoritativeRootClosure N RuptureV}
    {ruptureVisit : SourceNativeTemporalVisitAt world.toLedgerRoot}
    {sourceEntry : OpenResponsibilityAt N
      (world.toLedgerRoot.source.source.toRootSource.account.supportOf
        (world.emitted ruptureVisit.current))}
    {terminal : SourceFaithfulTerminalOccurrenceAt world.source
      (world.emitted ruptureVisit.current)}

def generate
    (terminal : SourceFaithfulTerminalOccurrenceAt world.source
      (world.emitted ruptureVisit.current)) :
    SourceOwnedInstitutionalRuptureAt (sourceEntry := sourceEntry) terminal :=
  ⟨⟩

variable (rupture : SourceOwnedInstitutionalRuptureAt
  (sourceEntry := sourceEntry) terminal)

/-- Exact terminal disposition of the institutional residual row. -/
def terminalReceipt
    (_rupture : SourceOwnedInstitutionalRuptureAt
      (sourceEntry := sourceEntry) terminal) :
    LedgerEntryTerminalAt N sourceEntry :=
  terminal.ledgerEvolution.discharge sourceEntry

/-- A faithful-terminal occurrence has no same-ledger generated successor. -/
theorem noSameLedgerSuccessor
    (_rupture : SourceOwnedInstitutionalRuptureAt
      (sourceEntry := sourceEntry) terminal) :
    SourceNativeLedgerGeneratedSuccessorAt
      (world.emitted ruptureVisit.current)
      (world.source.restructuringSource.compiler.ledgerCompiler.compile
        (world.emitted ruptureVisit.current)) → False := by
  intro successor
  unfold SourceNativeLedgerGeneratedSuccessorAt at successor
  rw [terminal.generated_eq] at successor
  exact successor.elim

/-- Therefore no M8 root-installed renewal—and hence no M9 bounded reform—can
be generated from this exact terminal row. -/
theorem noRootInstalledRenewal
    (_rupture : SourceOwnedInstitutionalRuptureAt
      (sourceEntry := sourceEntry) terminal) :
    RootInstalledRenewalAt
      (world.toLedgerRoot.generatedAtTemporalVisit ruptureVisit)
      sourceEntry → False := by
  intro residual
  have successor := residual.successor
  change SourceNativeLedgerGeneratedSuccessorAt
    (world.emitted ruptureVisit.current)
    (world.source.restructuringSource.compiler.ledgerCompiler.compile
      (world.emitted ruptureVisit.current)) at successor
  exact noSameLedgerSuccessor (terminal := terminal) _rupture successor

end SourceOwnedInstitutionalRuptureAt

/-- Without an installed failure face, the direct same-row revolutionary
producer is empty.  A bare `ActualExpressibilityFailure` cannot open U8. -/
theorem noInstalledFailureFace_noRevolutionaryProducer
    (noFace : SourceNativeRootExpressibilityFailureFaceAt
      oldWorld oldVisit (U7 := U7) failure → False) :
    (Sigma fun face : SourceNativeRootExpressibilityFailureFaceAt
        oldWorld oldVisit (U7 := U7) failure =>
      Sigma fun authority :
        SourceNativeAuthoritativeTemporalCausalEntryAuthorityAt
          oldWorld oldVisit face.rootEntry =>
      Sigma fun successor : CausalEntrySuccessorAt oldWorld.toLedgerRoot
        oldVisit face.rootEntry =>
      RootedRevolutionaryInstitutionalRevisionAt
        (RootedActualExpressibilityFailureAt.ofRootFailureFace
          face authority successor)) → False := by
  rintro ⟨face, _authority, _successor, _revision⟩
  exact noFace face

end Revision
end Society
end ProcessGame
end SaturationMonoid
