    LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitRead q sL eL sR eR A=sourceActualUnitLegRead q sL eL sR eR A  := LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitRead_original q sL eL sR eR A

def checked_sourceUnitMixedVertex (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (f g : Field289) (p k : PhysicalMomentum) (z w : ℂ) : ℂ  := LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitMixedVertex q sL eL sR eR f g p k z w

theorem checked_sourceUnitMixedVertex_generated (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (f g : Field289) (p k : PhysicalMomentum) (z w : ℂ) (left : z.im≠0) (right : w.im≠0) :
    HasDerivAt (fun r : ℝ=>LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitRead q sL eL sR eR (jointVertex g p k q.F z w (r • f)))
      (LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitMixedVertex q sL eL sR eR f g p k z w) 0  := LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitMixedVertex_generated q sL eL sR eR f g p k z w left right

def checked_sourceUnitComplexMixed (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (f g : Fin 289→ℂ) (p k : PhysicalMomentum) (z w : ℂ) : ℂ  := LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitComplexMixed q sL eL sR eR f g p k z w

theorem checked_sourceUnitComplexMixed_generated (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (f g : Fin 289→ℂ) (p k : PhysicalMomentum) (z w : ℂ) (left : z.im≠0) (right : w.im≠0) :
    HasDerivAt (fun r : ℝ=>
      LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitRead q sL eL sR eR (jointVertex (fun i=>(g i).re) p k q.F z w (r • (fun i=>(f i).re)))+
      Complex.I*LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitRead q sL eL sR eR (jointVertex (fun i=>(g i).re) p k q.F z w (r • (fun i=>(f i).im)))+
      Complex.I*LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitRead q sL eL sR eR (jointVertex (fun i=>(g i).im) p k q.F z w (r • (fun i=>(f i).re)))-
      LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitRead q sL eL sR eR (jointVertex (fun i=>(g i).im) p k q.F z w (r • (fun i=>(f i).im))))
      (LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitComplexMixed q sL eL sR eR f g p k z w) 0  := LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitComplexMixed_generated q sL eL sR eR f g p k z w left right

theorem checked_sourceUnitMixedVertex_return (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (f g : Field289) (p k : PhysicalMomentum) (z w : ℂ) :
    LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitMixedVertex q sL eL sR eR f g p k z w=
      sourceActualLegNormalization q sL eL sR eR*
        (sourceQuantumChargedRead q sL eL sR eR (mixedVertex f g p k q.F z w)+
          sourceActualLegCorrection q sL eL sR eR (mixedVertex f g p k q.F z w))  := LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitMixedVertex_return q sL eL sR eR f g p k z w

