    (f g : Field289) : ℂ × ℂ  := LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitFourPointPair q sL eL sR eR f g

theorem checked_sourceUnitFourPoint_amputated (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (f g : Field289) (left : q.z.im≠0) (right : q.w.im≠0) :
    sourceActualLegNormalization q sL eL sR eR*
      ((sourceActualChargedRestEnergy sL:ℂ)-q.z)*((sourceActualChargedRestEnergy sR:ℂ)-q.w)*
      sourceQuantumChargedRead q sL eL sR eR (mixedVertex f g 0 0 q.F q.z q.w)=
    (LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitFourPointPair q sL eL sR eR f g).1+(LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitFourPointPair q sL eL sR eR f g).2  := LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitFourPoint_amputated q sL eL sR eR f g left right

theorem checked_sourceUnitFourPoint_generated (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (f g : Field289) (left : q.z.im≠0) (right : q.w.im≠0) :
    HasDerivAt (fun r : ℝ=>
      (sourceActualLegNormalization q sL eL sR eR*
        ((sourceActualChargedRestEnergy sL:ℂ)-q.z)*((sourceActualChargedRestEnergy sR:ℂ)-q.w))*
      sourceQuantumChargedRead q sL eL sR eR (jointVertex g 0 0 q.F q.z q.w (r • f)))
      ((LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitFourPointPair q sL eL sR eR f g).1+(LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitFourPointPair q sL eL sR eR f g).2) 0  := LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitFourPoint_generated q sL eL sR eR f g left right

theorem checked_sourceUnitFourPoint_return (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) (f g : Field289) :
    LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitFourPointPair q sL eL sR eR f g=
      (sourceActualLegNormalization q sL eL sR eR*
        (sourceQuantumChargedRead q sL eL sR eR (LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceFourPointForward q f g)+
          sourceActualLegCorrection q sL eL sR eR (LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceFourPointForward q f g)+
          sourceQuantumChargedRead q sL eL sR eR (LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceFourPointReverse q f g)+
          sourceActualLegCorrection q sL eL sR eR (LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceFourPointReverse q f g)),
      -sourceActualLegNormalization q sL eL sR eR*
        (sourceQuantumChargedRead q sL eL sR eR (LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceFourPointContact q f g)+
          sourceActualLegCorrection q sL eL sR eR (LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceFourPointContact q f g)))  := LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitFourPoint_return q sL eL sR eR f g

theorem checked_sourceUnitFourPoint_bound (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (f g : Field289) (left : q.z.im≠0) (right : q.w.im≠0) :
    ‖(LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitFourPointPair q sL eL sR eR f g).1‖ ≤
      ‖jointCurrent 0 q.F q.z 0 f‖*‖jointResolvent 0 q.F q.z 0‖*‖jointCurrent 0 q.F q.w 0 g‖+
      ‖jointCurrent 0 q.F q.w 0 g‖*‖jointResolvent 0 q.F q.w 0‖*‖jointCurrent 0 q.F q.w 0 f‖ ∧
    ‖(LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitFourPointPair q sL eL sR eR f g).2‖ ≤ ‖jointHessian 0 q.F q.w f g‖  := LowEnergy.PreparationPhysicalActualUnitFourPointReturn.sourceUnitFourPoint_bound q sL eL sR eR f g left right

