set_option autoImplicit false
set_option maxHeartbeats 1200000
set_option maxRecDepth 8192
set_option backward.isDefEq.respectTransparency false
noncomputable section
namespace LowEnergy.PreparationPhysicalNativePolarizationEmitter
open SaturationMonoid SaturationMonoid.PhysicsCore SaturationMonoid.PhysicsCore.LowEnergy
open CanonicalGradedSpatialSource PreparationVacuumPhysicalCharacteristic PreparationVacuumPhysicalPoleSheet
open PreparationVacuumNativePoleTensor PreparationVacuumOriginalGreenFeedback PreparationVacuumFullOriginResponse
open PreparationVacuumPhysicalQuantumLockedCharge PreparationPhysicalNativePhotonScatteringSheetReturn
open SourcePropagationNativeActionHessian Filter Set
open scoped Matrix BigOperators Topology
attribute [local irreducible] originalChange originalInverse activeKernel fullKernelFrame slowFastFrame
  sourceResidue extendedTensor sourcePhotonResidue sourcePhotonFrequencyResidue

/-- The actual source pole column is lifted through the original full289 native insertion. -/
def sourceNativePolarization (branch : Fin 2) (epsilon s : ℝ) (n : PhysicalMomentum) : Fin 289→ℂ :=
  nativeInsertion epsilon s n (sourceNativePoleColumn branch epsilon s n)

/-- This coefficient is read from the original charged current and its full five-channel forcing. -/
def sourcePhotonEmitter (leg : SourcePhotonLeg) (branch : Fin 2) (epsilon s : ℝ) (n : PhysicalMomentum) : ℂ :=
  sourceNativePoleCoefficient branch epsilon s n
    (nativeModeForcing epsilon s n (sheetCurrent leg.q epsilon s n leg.momentum
      (sourceChargedRestIndex leg.sideL leg.edgeL) (sourceChargedRestIndex leg.sideR leg.edgeR) leg.window))

private theorem insertion_native (e : scaleDomain) (s : slopeDomain) (n : PhysicalMomentum)
    (direction : ∀i,|n i|≤1) (v : Fin 5→ℂ) :
    nativeInsertion e.val s.val n v=nativeMode e s n direction v := by
  unfold nativeInsertion nativeMode rawEffectiveFrame effectiveFrame modeCoordinates unrestrictedGreen complementGreen
    rayPoint PreparationVacuumFullOriginResponse.controlledPoint
  rfl

/-- The source cofactor selects a nonzero complete homogeneous polarization, on both original branches. -/
theorem sourceNativePolarization_generated (branch : Fin 2) (n : PhysicalMomentum) (unit : spatialSquare n=1) :
    ∀ᶠ e in scaleApproach,
      sourceNativePolarization branch e.val (sourceSheet branch n unit e.val) n≠0 ∧
      nativeFourierHessian nativeHessian (frequencyRay e.val (sourceSheet branch n unit e.val) n)*ᵥ
        sourceNativePolarization branch e.val (sourceSheet branch n unit e.val) n=0 := by
  filter_upwards [sourceNativePoleColumn_generated branch n unit,
    scaleVal_tendsto.eventually (sourceSheet_bounds branch n unit)] with e column bounds
  have inside : |sourceSheet branch n unit e.val|≤1 := by
    apply abs_le.mpr
    split_ifs at bounds <;> constructor <;> linarith
  let s : slopeDomain:=⟨sourceSheet branch n unit e.val,inside⟩
  have kernel : normalizedEffective e s n (unit_direction_bound n unit)*ᵥ
      sourceNativePoleColumn branch e.val s.val n=0 := by
    rw [←extendedTensor_actual e s n (unit_direction_bound n unit)]
    exact column.2.1
  have nonzero:=nativeMode_nonzero e s n (unit_direction_bound n unit)
    (sourceNativePoleColumn branch e.val s.val n) column.1
  have equation:=nativeMode_whole_equation e s n (unit_direction_bound n unit)
    (sourceNativePoleColumn branch e.val s.val n) kernel
  rw [sourceNativePolarization,insertion_native e s n (unit_direction_bound n unit)]
  exact ⟨nonzero,by simpa only [nativeActionFourierHessian_original] using equation⟩

/-- No emitter amplitude is supplied: every actual charged residue is generated by its current read on the source pole. -/
theorem sourcePhotonResidue_factor (branch : Fin 2) (n : PhysicalMomentum) (unit : spatialSquare n=1) :
    ∀ᶠ e in scaleApproach,∀leg : SourcePhotonLeg,
      sourcePhotonResidue leg e.val (sourceSheet branch n unit e.val) n=
        sourcePhotonEmitter leg branch e.val (sourceSheet branch n unit e.val) n •
          sourceNativePolarization branch e.val (sourceSheet branch n unit e.val) n := by
  filter_upwards [sourceNativePoleColumn_generated branch n unit] with e column
  intro leg
  rw [sourcePhotonResidue,actualSheetResidue,column.2.2,nativeInsertion_smul]
  rfl

/-- Actual visibility is determined by the generated current coefficient, not by the nonzero inverse residue alone. -/
theorem sourcePhotonResidue_visible (branch : Fin 2) (n : PhysicalMomentum) (unit : spatialSquare n=1) :
    ∀ᶠ e in scaleApproach,∀leg : SourcePhotonLeg,
      sourcePhotonResidue leg e.val (sourceSheet branch n unit e.val) n≠0 ↔
        sourcePhotonEmitter leg branch e.val (sourceSheet branch n unit e.val) n≠0 := by
  filter_upwards [sourcePhotonResidue_factor branch n unit,sourceNativePolarization_generated branch n unit]
    with e factor polarization
  intro leg
  rw [factor leg,smul_ne_zero_iff]
  exact and_iff_left polarization.1

/-- The frequency residue uses exactly the same polarization and source emitter, with its original squared scale. -/
theorem sourcePhotonFrequencyResidue_factor (branch : Fin 2) (n : PhysicalMomentum) (unit : spatialSquare n=1) :
    ∀ᶠ e in scaleApproach,∀leg : SourcePhotonLeg,
      sourcePhotonFrequencyResidue leg e.val (sourceSheet branch n unit e.val) n=
        (((e.val^2:ℝ):ℂ)*sourcePhotonEmitter leg branch e.val (sourceSheet branch n unit e.val) n) •
          sourceNativePolarization branch e.val (sourceSheet branch n unit e.val) n := by
  filter_upwards [sourcePhotonResidue_factor branch n unit] with e factor
  intro leg
  rw [sourcePhotonFrequencyResidue,actualFrequencyResidue]
  have returned:=factor leg
  unfold sourcePhotonResidue at returned
  rw [returned,smul_smul]

end LowEnergy.PreparationPhysicalNativePolarizationEmitter
