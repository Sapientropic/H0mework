/-- The principal packet is generated by the already paid full Hamiltonian, retaining its true lower source matrix. -/
def sourceChargedPrincipalVector (side edge : Fin 2) : FullMatterL2 :=
  sourceChargedHamiltonianVector side edge-sourceConstant.compLpL 2 volume (sourceChargedFilteredPacket side edge)

theorem sourceChargedPrincipalVector_fourier (side edge : Fin 2) :
    fourier (sourceChargedPrincipalVector side edge)=ᵐ[volume]
      fun k=>principalOperator (physicalMomentum k) (fourier (sourceChargedFilteredPacket side edge) k) := by
  rw [sourceChargedPrincipalVector,map_sub,GaugeGreen.constant_fourier]
  filter_upwards [Lp.coeFn_sub (fourier (sourceChargedHamiltonianVector side edge))
      (sourceConstant.compLpL 2 volume (fourier (sourceChargedFilteredPacket side edge))),
    sourceChargedHamiltonian_fourier side edge,
    sourceConstant.coeFn_compLpL (fourier (sourceChargedFilteredPacket side edge))] with k subAt ham constant
  rw [subAt,Pi.sub_apply,ham,constant,fullHamiltonian_split]
  simp only [add_apply,add_sub_cancel_right]

theorem sourceChargedPrincipalVector_bound (side edge : Fin 2) :
    ‖sourceChargedPrincipalVector side edge‖ ≤ sourceChargedHamiltonianPrice side edge+‖sourceConstant‖ := by
  apply (norm_sub_le _ _).trans
  apply add_le_add (sourceChargedHamiltonian_bound side edge)
  exact ((sourceConstant.compLpL 2 volume).le_opNorm _).trans
    (by rw [sourceChargedFilteredPacket_unit,mul_one]; exact sourceConstant.norm_compLpL_le)

/-- This price comes from the actual packet's Hamiltonian graph; all three momentum legs share it. -/
def sourceChargedMomentumPrice (side edge : Fin 2) : ℝ :=
  (sourceChargedHamiltonianPrice side edge+‖sourceConstant‖)/lapse

theorem sourceChargedMomentumLeg_bound (side edge : Fin 2) (j : Fin 3) :
    ‖coordinateLeg j.succ (sourceActualScatteringInput side edge)‖ ≤ sourceChargedMomentumPrice side edge := by
  have bound : ‖(lapse:ℂ) • fourier (coordinateLeg j.succ (sourceActualScatteringInput side edge))‖ ≤ 
      ‖fourier (sourceChargedPrincipalVector side edge)‖ := by
    apply Lp.norm_le_norm_of_ae_le
    filter_upwards [Lp.coeFn_smul (lapse:ℂ)
        (fourier (coordinateLeg j.succ (sourceActualScatteringInput side edge))),
      sourceActualScatteringCoordinateLeg_fourier side edge j.succ,
      sourceChargedPrincipalVector_fourier side edge] with k scaled leg principal
    rw [scaled,Pi.smul_apply,leg,principal]
    simp only [sourceActualCoordinateMomentum,Fin.cases_succ,norm_smul,Complex.norm_real,
      Real.norm_eq_abs,abs_of_pos lapse_pos]
    simpa only [mul_assoc] using momentum_component_bound (physicalMomentum k)
      (fourier (sourceChargedFilteredPacket side edge) k) j
  rw [norm_smul,Complex.norm_real,Real.norm_eq_abs,abs_of_pos lapse_pos,
    fourier.norm_map,fourier.norm_map] at bound
  apply (le_div_iff₀ lapse_pos).mpr
  simpa only [mul_comm] using bound.trans (sourceChargedPrincipalVector_bound side edge)

theorem sourceChargedCoordinateLeg_bound (side edge : Fin 2) (i : Fin 4) :
    ‖coordinateLeg i (sourceActualScatteringInput side edge)‖ ≤ 
      Fin.cases 1 (fun _=>sourceChargedMomentumPrice side edge) i := by
  cases i using Fin.cases
  · simp only [Fin.cases_zero,sourceActualScatteringInput_return,sourceChargedFilteredPacket_unit,le_refl]
  · exact sourceChargedMomentumLeg_bound side edge _

