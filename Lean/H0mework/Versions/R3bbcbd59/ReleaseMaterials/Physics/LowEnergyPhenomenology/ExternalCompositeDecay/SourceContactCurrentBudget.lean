/-- The original scalar cutoff passes through each actual zero-order coframe/CAR column. -/
theorem original_contact_cutoff (k : Fin 3) (a : LieIndex) (m ell : ℕ) (f : QuantumTest) :
    coframeColumn k a (theta m ell f)=theta m ell (coframeColumn k a f) := by
  apply DFunLike.ext
  intro z
  rw [original_contact_column_value]
  change contactMap k z (lieBasis a) ((SourceNativeCutoffContact.theta m ell z : ℂ) • f z)=
    (SourceNativeCutoffContact.theta m ell z : ℂ) • coframeColumn k a f z
  rw [map_smul,original_contact_column_value]

/-- A single cutoff controls all original contact columns on the fixed input core. -/
theorem actual_contact_endpoint_tail (f : QuantumTest) :
    ∀ ε : ℝ,0<ε → ∃ N : ℕ,∀ m,N ≤ m → ∀ ell,m ≤ ell →
      (sourcePair (theta m ell f) (gramAction (theta m ell f))).re ≤ ε := by
  intro ε hε
  let d : ℝ := Fintype.card (LieIndex × Fin 3)
  have hd : 0<d+1 := by dsimp [d];positivity
  let δ : ℝ := Real.sqrt (ε/(d+1))
  have hδ : 0<δ := Real.sqrt_pos.mpr (div_pos hε hd)
  have hs : δ^2=ε/(d+1) := Real.sq_sqrt (div_pos hε hd).le
  have ht (i : LieIndex × Fin 3) := SourceHardyRetardedTail.original_relative_tail
    (embed (coframeColumn i.2 i.1 f)) δ hδ
  choose Ns hNs using ht
  refine ⟨Finset.univ.sup Ns,fun m hm ell hell => ?_⟩
  rw [original_contact_gram_energy]
  have hb (i : LieIndex × Fin 3) : ‖embed (coframeColumn i.2 i.1 (theta m ell f))‖^2 ≤ δ^2 := by
    have hni : Ns i ≤ m := (Finset.le_sup (f := Ns) (Finset.mem_univ i)).trans hm
    have hi := hNs i m hni ell hell
    rw [original_contact_cutoff,SourceNativeCutoffContact.theta_core]
    nlinarith [norm_nonneg (SourceRelativePowerTail.relativeTail m ell (embed (coframeColumn i.2 i.1 f)))]
  have hsum := Finset.sum_le_sum (s := (Finset.univ : Finset (LieIndex × Fin 3))) (fun i _ => hb i)
  have hbound : (∑ a : LieIndex,∑ k : Fin 3,‖embed (coframeColumn k a (theta m ell f))‖^2) ≤ d*δ^2 := by
    simpa only [Fintype.sum_prod_type,Finset.sum_const,Finset.card_univ,nsmul_eq_mul,d] using hsum
  have he : (d+1)*δ^2=ε := by rw [hs];field_simp
  exact hbound.trans (by nlinarith [sq_nonneg δ])

def contactCurrentTime (F : Index) (μ : ℝ) (T : End) (g : diagonal.domain) : ℝ :=
  ∫ t : ℝ in Set.Ioi 0,Real.exp (-2*μ*t)*contactCurrent F T (coreTime F g t)

/-- The original coframe moment is generated by its fixed endpoint and signed full-defect current. -/
theorem actual_contact_time_current (F : Index) (μ : ℝ) (hμ : 0<μ) (T : End) (g : diagonal.domain) :
    9*coframeTime F μ T g=(9/(2*μ))*(sourcePair (T (coreEquiv.symm g))
      (gramAction (T (coreEquiv.symm g)))).re+(9/μ)*contactCurrentTime F μ T g := by
  have h := (actual_contact_time_balance F μ hμ T g).2
  unfold contactCurrentTime
  simp only [neg_mul] at h
  field_simp
  nlinarith only [h]

attribute [local irreducible] closedJointCost coframeTime otherTime contactCurrentTime sourcePair gramAction

/-- Original joint cost after paying the fixed contact endpoint; the two signed time currents retain one common F. -/
theorem actual_original_contact_current_budget (sharp : Bool) (μ : ℝ) (hμ : 0<μ)
    (hgap : 3*sourceTime 0<μ) (g k : diagonal.domain) :
    ∀ ε : ℝ,0<ε → ∃ N : ℕ,∀ m,N ≤ m → ∀ ell,m ≤ ell →
      ∀ᶠ F in (sourceFilter : Filter Index),
        closedJointCost sharp m ell F μ (g : H) (k : H) ≤ ε+
          (4*Real.pi*formPrice sharp*μ⁻¹^2*‖(k : H)‖^2/(μ-3*sourceTime 0))*
            (otherTime F μ (theta m ell) g+(9/μ)*contactCurrentTime F μ (theta m ell) g) := by
  intro ε hε
  let P := 4*Real.pi*formPrice sharp*μ⁻¹^2*‖(k : H)‖^2/(μ-3*sourceTime 0)
  have hP : 0 ≤ P := by
    have hn : 0<sourceTime 0 := by
      rw [source_time_generated]
      exact SaturationMonoid.PhysicsCore.Stage9C.Material.SpinPair.lapse_pos
    have hc : 0 ≤ SourceScalarInverseNativeEnergy.coefficientCost sharp := Finset.sum_nonneg (fun _ _ => sq_nonneg _)
    have hv : 0<μ-3*sourceTime 0 := sub_pos.mpr hgap
    dsimp only [P,formPrice]
    positivity
  let A := P*(9/(2*μ))
  have hA : 0 ≤ A := mul_nonneg hP (by positivity)
  obtain ⟨N,hN⟩ := actual_original_coframe_contact_budget sharp μ hμ hgap g k (ε/2) (by linarith)
  obtain ⟨M,hM⟩ := actual_contact_endpoint_tail (coreEquiv.symm g) (ε/(2*(A+1))) (by positivity)
  refine ⟨max N M,fun m hm ell hell => ?_⟩
  filter_upwards [hN m (le_trans (le_max_left _ _) hm) ell hell] with F hF
  have he := hM m (le_trans (le_max_right _ _) hm) ell hell
  have hs := actual_contact_time_current F μ hμ (theta m ell) g
  have hp : A*(sourcePair (theta m ell (coreEquiv.symm g))
      (gramAction (theta m ell (coreEquiv.symm g)))).re ≤ ε/2 := by
    have h := mul_le_mul_of_nonneg_left he hA
    have hx : A*(ε/(2*(A+1))) ≤ ε/2 := by
      have hn : 0<A+1 := by linarith
      field_simp
      nlinarith
    exact h.trans hx
  change closedJointCost sharp m ell F μ (g : H) (k : H) ≤ ε+P*_
  change closedJointCost sharp m ell F μ (g : H) (k : H) ≤ ε/2+P*_ at hF
  rw [hs] at hF
  dsimp [A] at hp
  nlinarith only [hF,hp]

