/-- The same inverse volume has a positive source expectation through its actual square root. -/
theorem original_inverse_mass (f : QuantumTest) :
    sourcePair f (inverseVolumeAction f)=((‖embed (inverseRootAction f)‖^2 : ℝ) : ℂ) := by
  rw [←inverse_root_square]
  have h : sourcePair f (inverseRootAction (inverseRootAction f))=
      sourcePair (inverseRootAction f) (inverseRootAction f) := multiply_pair _ _ _ _
  exact h.trans (by simpa only [Complex.ofReal_pow] using! inner_self_eq_norm_sq_to_K (𝕜 := ℂ) (embed (inverseRootAction f)))

private theorem gamma_bounds : 0≤vacuumJetCoefficient ∧ vacuumJetCoefficient≤1/48 := by
  unfold vacuumJetCoefficient
  constructor
  · positivity
  · apply (div_le_iff₀ (by positivity)).mpr
    nlinarith [sq_nonneg ‖vacuum‖]

/-- This band is generated by the source oscillator floor and the original vacuum coefficient bound. -/
def absorptionRadius : ℝ := 976*Real.sqrt 2*sourceTime 0

theorem absorptionRadius_pos : 0<absorptionRadius := by
  have hn : 0<sourceTime 0 := by
    rw [source_time_generated]
    exact SaturationMonoid.PhysicsCore.Stage9C.Material.SpinPair.lapse_pos
  unfold absorptionRadius
  positivity

private theorem frequency_value (f : QuantumTest) (z : ℂ) :
    (3*(vacuumJetCoefficient : ℂ)*(star z+z))*sourcePair f (inverseVolumeAction f)=
      ((6*vacuumJetCoefficient*z.re*‖embed (inverseRootAction f)‖^2 : ℝ) : ℂ) := by
  have hz : star z+z=((2*z.re : ℝ) : ℂ) := by
    apply Complex.ext <;> simp
    ring
  rw [hz,original_inverse_mass]
  push_cast
  ring

private theorem frequency_norm (f : QuantumTest) (z : ℂ) :
    ‖(3*(vacuumJetCoefficient : ℂ)*(star z+z))*sourcePair f (inverseVolumeAction f)‖=
      6*vacuumJetCoefficient*|z.re| *‖embed (inverseRootAction f)‖^2 := by
  rw [frequency_value,Complex.norm_real,Real.norm_eq_abs]
  simp only [abs_mul,abs_of_nonneg gamma_bounds.1,abs_of_nonneg (sq_nonneg ‖embed (inverseRootAction f)‖)]
  norm_num

/-- The full same-frequency vacuum current is absorbed into half the original positive form in the source band. -/
theorem original_frequency_absorption (f : QuantumTest) (z : ℂ) (hz : |z.re|≤absorptionRadius) :
    ‖(3*(vacuumJetCoefficient : ℂ)*(star z+z))*sourcePair f (inverseVolumeAction f)‖ ≤
      (1/2 : ℝ)*inverseForm f := by
  have hfloor := original_inverse_volume_floor f
  rw [original_inverse_mass,Complex.ofReal_re] at hfloor
  have hn : 0<sourceTime 0 := by
    rw [source_time_generated]
    exact SaturationMonoid.PhysicsCore.Stage9C.Material.SpinPair.lapse_pos
  have hcoef := mul_le_mul gamma_bounds.2 hz (abs_nonneg z.re) (by norm_num : (0 : ℝ)≤1/48)
  change vacuumJetCoefficient*|z.re|≤(1/48 : ℝ)*(976*Real.sqrt 2*sourceTime 0) at hcoef
  have h := mul_le_mul_of_nonneg_right hcoef (sq_nonneg ‖embed (inverseRootAction f)‖)
  rw [frequency_norm]
  nlinarith only [h,hfloor]

/-- The original same-z Ward equation generates a source half-line upper from the fixed source and the complete two-sided defect. -/
theorem actual_halfline_defect_upper (m ell : ℕ) (F : Index) (z : ℂ) (hz : z.im≠0)
    (hband : -absorptionRadius≤z.re) (g : diagonal.domain) :
    inverseForm (theta m ell (state F z hz g)) ≤
      2*(‖fixedBulk F z z hz hz g g (inverseVolumeAction*theta m ell) (inverseVolumeAction*theta m ell)‖+
        (defectBulk F z z hz hz g g (inverseVolumeAction*theta m ell) (inverseVolumeAction*theta m ell)).re) := by
  have h := actual_inverse_bulk_normal F z z hz hz g g (theta m ell) (theta m ell)
  rw [←actual_two_leg_exchange false] at h
  have hr := congrArg Complex.re h
  rw [original_diagonal_energy_exchange] at hr
  simp only [Complex.sub_re,Complex.add_re] at hr
  have hb : -(1/2 : ℝ)*inverseForm (theta m ell (state F z hz g)) ≤
      ((3*(vacuumJetCoefficient : ℂ)*(star z+z))*sourcePair (theta m ell (state F z hz g))
        (inverseVolumeAction (theta m ell (state F z hz g)))).re := by
    by_cases hw : 0≤z.re
    · rw [frequency_value,Complex.ofReal_re]
      have hp : 0≤6*vacuumJetCoefficient*z.re*‖embed (inverseRootAction (theta m ell (state F z hz g)))‖^2 :=
        mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) gamma_bounds.1) hw) (sq_nonneg _)
      have hE := original_inverse_nonnegative (theta m ell (state F z hz g))
      linarith only [hp,hE]
    · have ha : |z.re|≤absorptionRadius := by rw [abs_of_neg (lt_of_not_ge hw)];linarith only [hband]
      have hn := original_frequency_absorption (theta m ell (state F z hz g)) z ha
      have hc := (neg_le_neg (Complex.abs_re_le_norm ((3*(vacuumJetCoefficient : ℂ)*(star z+z))*
        sourcePair (theta m ell (state F z hz g)) (inverseVolumeAction (theta m ell (state F z hz g)))))).trans (neg_abs_le _)
      linarith only [hn,hc]
  have hf := Complex.re_le_norm (fixedBulk F z z hz hz g g
    (inverseVolumeAction*theta m ell) (inverseVolumeAction*theta m ell))
  linarith only [hr,hb,hf]

