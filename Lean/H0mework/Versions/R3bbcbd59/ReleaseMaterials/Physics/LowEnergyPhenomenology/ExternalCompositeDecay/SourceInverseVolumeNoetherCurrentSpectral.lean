abbrev End := QuantumTest →ₗ[ℂ] QuantumTest
attribute [local irreducible] state inverseForm bulkAction raisedNoetherCurrent compressionCore productMoment closedMomentGram

private def plusMap (F : Index) (T : End) : End := T*compressionCore F+Complex.I • (bulkAction*T)
private def minusMap (F : Index) (T : End) : End := T*compressionCore F-Complex.I • (bulkAction*T)

def currentMoment (F : Index) (μ : ℝ) (hμ : 0<μ) (g k : diagonal.domain) (A T : End) (w : ℝ) : ℝ :=
  ‖embed (A (state F (star (line μ w))
    (by simpa only [Complex.star_def,Complex.conj_im,line_im,neg_ne_zero] using hμ.ne') k))‖^2 *
      raisedNoetherCurrent F T (state F (line μ w) (by simpa only [line_im] using hμ.ne') g)

/-- The full signed compression current has the original mixed causal four-pole Gram. -/
def closedCurrent (F : Index) (μ : ℝ) (g k : diagonal.domain) (A T : End) : ℝ :=
  (closedMomentGram F μ g k A (plusMap F T)-closedMomentGram F μ g k A (minusMap F T))/4

private theorem original_current_polarization (F : Index) (T : End) (q : QuantumTest) :
    raisedNoetherCurrent F T q=(‖embed (plusMap F T q)‖^2-‖embed (minusMap F T q)‖^2)/4 := by
  rw [original_raised_noether_compression]
  have hi := im_inner_eq_norm_sub_i_smul_mul_self_sub_norm_add_i_smul_mul_self_div_four
    (𝕜 := ℂ) (embed (T (compressionCore F q))) (embed (bulkAction (T q)))
  change (inner ℂ (embed (T (compressionCore F q))) (embed (bulkAction (T q)))).im=_ at hi
  simp only [plusMap,minusMap,LinearMap.add_apply,LinearMap.sub_apply,LinearMap.smul_apply,
    Module.End.mul_apply,map_add,map_sub,map_smul,pow_two]
  change -(inner ℂ (embed (T (compressionCore F q))) (embed (bulkAction (T q)))).im=_
  rw [hi]
  change -( (‖embed (T (compressionCore F q))-Complex.I • embed (bulkAction (T q))‖*
    ‖embed (T (compressionCore F q))-Complex.I • embed (bulkAction (T q))‖-
    ‖embed (T (compressionCore F q))+Complex.I • embed (bulkAction (T q))‖*
    ‖embed (T (compressionCore F q))+Complex.I • embed (bulkAction (T q))‖)/4)=_
  ring

private theorem actual_current_polarization (F : Index) (μ : ℝ) (hμ : 0<μ) (g k : diagonal.domain)
    (A T : End) (w : ℝ) :
    currentMoment F μ hμ g k A T w=
      (productMoment F μ hμ g k A (plusMap F T) w-
        productMoment F μ hμ g k A (minusMap F T) w)/4 := by
  unfold currentMoment productMoment
  rw [original_current_polarization]
  ring

/-- Integrability is generated by the actual finite channels; the current keeps its sign. -/
theorem actual_current_integrable (F : Index) (μ : ℝ) (hμ : 0<μ) (g k : diagonal.domain) (A T : End) :
    Integrable (currentMoment F μ hμ g k A T) := by
  have hi := ((actual_product_integrable F μ hμ g k A (plusMap F T)).sub
    (actual_product_integrable F μ hμ g k A (minusMap F T))).div_const 4
  exact hi.congr (Filter.Eventually.of_forall (fun w => (actual_current_polarization F μ hμ g k A T w).symm))

theorem actual_current_closed (F : Index) (μ : ℝ) (hμ : 0<μ) (g k : diagonal.domain) (A T : End) :
    (∫ w : ℝ,currentMoment F μ hμ g k A T w)=closedCurrent F μ g k A T := by
  simp_rw [actual_current_polarization]
  rw [integral_div,integral_sub (actual_product_integrable F μ hμ g k A (plusMap F T))
    (actual_product_integrable F μ hμ g k A (minusMap F T)),actual_product_gram,actual_product_gram]
  rfl

private theorem state_embed (F : Index) (z : ℂ) (hz : z.im≠0) (g : diagonal.domain) :
    embed (state F z hz g)=finiteResolvent F z (g : H)  := by
  unfold state
  exact congrArg Subtype.val (coreEquiv.apply_symm_apply _)

private theorem outer_integrable (F : Index) (μ : ℝ) (hμ : 0<μ) (k : diagonal.domain) :
    Integrable (fun w : ℝ => ‖embed (state F (star (line μ w))
      (by simpa only [Complex.star_def,Complex.conj_im,line_im,neg_ne_zero] using hμ.ne') k)‖^2) := by
  simp_rw [state_embed,actual_conjugate_leg_norm F (line μ _) (by simpa only [line_im] using hμ.ne')]
  simpa only [line,mul_comm (μ : ℂ) Complex.I] using! SourceActualResolventEnergy.actual_square_integrable F μ hμ (k : H)

private theorem outer_integral (F : Index) (μ : ℝ) (hμ : 0<μ) (k : diagonal.domain) :
    (∫ w : ℝ,‖embed (state F (star (line μ w))
      (by simpa only [Complex.star_def,Complex.conj_im,line_im,neg_ne_zero] using hμ.ne') k)‖^2)=
      Real.pi/μ*‖(k : H)‖^2 := by
  simp_rw [state_embed,actual_conjugate_leg_norm F (line μ _) (by simpa only [line_im] using hμ.ne')]
  simpa only [line,mul_comm (μ : ℂ) Complex.I] using! SourceActualResolventEnergy.actual_square_integral F μ hμ (k : H)

/-- The original localized energy is paid by fixed input energy and the complete signed current integral. -/
theorem actual_integrated_noether_upper (F : Index) (μ : ℝ) (hμ : 0<μ) (g k : diagonal.domain) (T : End) :
    μ^2*closedInverseMoment F μ g k 1 T ≤
      (Real.pi/μ*‖(k : H)‖^2)*inverseForm (T (coreEquiv.symm g))+
        2*μ*closedCurrent F μ g k 1 T := by
  let a := fun w : ℝ => ‖embed (state F (star (line μ w))
    (by simpa only [Complex.star_def,Complex.conj_im,line_im,neg_ne_zero] using hμ.ne') k)‖^2
  have ha : Integrable a := outer_integrable F μ hμ k
  have hi := (actual_inverse_moment_integrable F μ hμ g k 1 T).const_mul (μ^2)
  have hj := (actual_current_integrable F μ hμ g k 1 T).const_mul (2*μ)
  have hr := (ha.mul_const (inverseForm (T (coreEquiv.symm g)))).add hj
  have h := integral_mono hi hr (fun w => by
    have hb := mul_le_mul_of_nonneg_left (actual_raised_energy_upper F (line μ w)
      (by simpa only [line_im] using hμ.ne') g T) (sq_nonneg ‖embed (state F (star (line μ w))
      (by simpa only [Complex.star_def,Complex.conj_im,line_im,neg_ne_zero] using hμ.ne') k)‖)
    simp only [line_im] at hb
    dsimp only [a,normInverseMoment,currentMoment,Module.End.one_apply,Pi.add_apply]
    nlinarith only [hb])
  simp only [Pi.add_apply] at h
  rw [integral_const_mul,actual_inverse_moment_closed,
    integral_add (ha.mul_const _) hj,integral_mul_const,integral_const_mul,actual_current_closed] at h
  simpa only [a,outer_integral F μ hμ k] using h

/-- The fixed input is paid uniformly in F; only the full signed current Gram remains. -/
theorem actual_localized_signed_budget (μ : ℝ) (hμ : 0<μ) (g k : diagonal.domain) :
    ∀ ε : ℝ,0<ε → ∃ N : ℕ,∀ m,N ≤ m → ∀ ell,m ≤ ell → ∀ F : Index,
      closedInverseMoment F μ g k 1 (theta m ell) ≤
        ε+(2/μ)*closedCurrent F μ g k 1 (theta m ell) := by
  intro ε hε
  let C := (Real.pi/μ*‖(k : H)‖^2)/μ^2
  have hC : 0 ≤ C := by dsimp [C];positivity
  let δ := ε/(C+1)
  have hδ : 0<δ := by dsimp [δ];positivity
  obtain ⟨N,hN⟩ := original_fixed_energy_tail (coreEquiv.symm g) δ hδ
  refine ⟨N,fun m hm ell hell F => ?_⟩
  have ht := mul_le_mul_of_nonneg_left (hN m hm ell hell) hC
  have hd : δ*(C+1)=ε := by dsimp [δ];exact div_mul_cancel₀ _ (by positivity)
  have htail : C*inverseForm (theta m ell (coreEquiv.symm g)) ≤ ε := by nlinarith
  have hs := mul_le_mul_of_nonneg_left htail (sq_nonneg μ)
  have hfix : (Real.pi/μ*‖(k : H)‖^2)*inverseForm (theta m ell (coreEquiv.symm g)) ≤ μ^2*ε := by
    simpa only [C,←mul_assoc,mul_div_cancel₀ _ (pow_ne_zero 2 hμ.ne')] using hs
  have h := actual_integrated_noether_upper F μ hμ g k (theta m ell)
  apply le_of_mul_le_mul_left (a := μ^2) ?_ (sq_pos_of_pos hμ)
  calc
    _ ≤ μ^2*ε+2*μ*closedCurrent F μ g k 1 (theta m ell) := h.trans (add_le_add hfix le_rfl)
    _ = _ := by field_simp

end LowEnergy.SourceInverseNoetherCurrentSpectral
