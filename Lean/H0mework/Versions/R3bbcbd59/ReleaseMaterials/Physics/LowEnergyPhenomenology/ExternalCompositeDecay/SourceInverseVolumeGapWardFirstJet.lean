set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
set_option maxRecDepth 2048
noncomputable section
namespace LowEnergy.SourceInverseGapWardFirstJet
open GaussNativeForm GaussNativeEnergy GaussFockPair GaussCoreHilbert GaussCoreDifferential GaussDiagonalHistory GaussUnitaryHistory GaussAdjointHistory
open SourceScalarPositiveBulkWard SourceScalarPairedTransport SourceInverseGapWardDescent SourceInverseChannelSourceJets
open SourceInverseNoetherChannelGap SourceJointResidualEnergy SourcePhysicalKineticSquare
