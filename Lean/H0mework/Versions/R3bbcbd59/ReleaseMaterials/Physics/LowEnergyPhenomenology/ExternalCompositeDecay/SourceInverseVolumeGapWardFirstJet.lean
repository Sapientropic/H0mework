abbrev End := QuantumTest →ₗ[ℂ] QuantumTest
attribute [local irreducible] channelTest fluxPair wardResponse inversePair state inverseVolumeAction sourcePair raisedDefect

private theorem raised_smul (F : Index) (A : End) (c : ℂ) (q : QuantumTest) :
    raisedDefect F A (c • q)=c • raisedDefect F A q := by
  simp only [raisedDefect,map_smul,smul_add]

private theorem flux_first_pair (F : Index) (k g : diagonal.domain) (u v : Channel F)
    (hk : channelTest F (iterate 1 k) u=(channelValue F u : ℂ) • channelTest F k u)
    (hg : channelTest F (iterate 1 g) v=(channelValue F v : ℂ) • channelTest F g v) :
    fluxPair F (iterate 1 k) g u v-fluxPair F k (iterate 1 g) u v=
      ((channelValue F u : ℂ)-(channelValue F v : ℂ)) • fluxPair F k g u v := by
  ext A B
  have hp (a : ℝ) (f h : QuantumTest) : sourcePair ((a : ℂ) • f) h=(a : ℂ)*sourcePair f h := by
    simp only [sourcePair,map_smul,inner_smul_left,Complex.conj_ofReal]
  have hq (a : ℝ) (f h : QuantumTest) : sourcePair f ((a : ℂ) • h)=(a : ℂ)*sourcePair f h := by
    simp only [sourcePair,map_smul,inner_smul_right]
  simp only [fluxPair,Pi.sub_apply,Pi.smul_apply,smul_eq_mul,hk,hg,raised_smul,map_smul,hp,hq]
  ring

/-- The full raised-defect flux transfers its external spectral gap to fixed H0 source inputs. -/
theorem actual_flux_first_source (k g : diagonal.domain) :
    ∀ᶠ F in (sourceFilter : Filter Index),∀ u v : Channel F,
      ((channelValue F u : ℂ)-(channelValue F v : ℂ)) • wardResponse (fluxPair F k g u v)=
        wardResponse (fluxPair F (iterate 1 k) g u v-fluxPair F k (iterate 1 g) u v) := by
  filter_upwards [actual_channel_source_jet 1 k,actual_channel_source_jet 1 g] with F hk hg u v
  simp only [pow_one] at hk hg
  rw [flux_first_pair F k g u v (hk u) (hg v),map_smul]

/-- The polynomial spectral prefactors become fixed H0-source inputs; the poles and full flux remain. -/
def sourceJetPair (F : Index) (z : ℂ) (g : diagonal.domain) (T : End) : ℂ :=
  ∑ u : Channel F,∑ v : Channel F,
    star (((channelValue F u : ℂ)-z)⁻¹)*((channelValue F v : ℂ)-z)⁻¹*
      ((Complex.I/4)*(wardResponse (inversePair F (iterate 2 g) g u v-inversePair F g (iterate 2 g) u v)) T T+
        (Complex.I/2)*(wardResponse (fluxPair F (iterate 1 g) g u v-fluxPair F g (iterate 1 g) u v)) T T)

theorem actual_source_jet_pair (g : diagonal.domain) :
    ∀ᶠ F in (sourceFilter : Filter Index),∀ (z : ℂ) (T : End),
      descentPair F z g T=sourceJetPair F z g T := by
  filter_upwards [actual_flux_first_source g g] with F hF z T
  unfold descentPair sourceJetPair
  apply Finset.sum_congr rfl
  intro u _
  apply Finset.sum_congr rfl
  intro v _
  have h := congrFun (congrFun (hF u v) T) T
  simp only [Pi.smul_apply,smul_eq_mul] at h
  rw [←h]
  ring

def sourceJetCurrent (F : Index) (μ : ℝ) (g k : diagonal.domain) (T : End) : ℝ :=
  ∫ w : ℝ,‖finiteResolvent F (star (line μ w)) (k : H)‖^2*(sourceJetPair F (line μ w) g T).re

theorem actual_source_jet_current (g : diagonal.domain) :
    ∀ᶠ F in (sourceFilter : Filter Index),∀ (μ : ℝ) (k : diagonal.domain) (T : End),
      descentCurrent F μ g k T=sourceJetCurrent F μ g k T := by
  filter_upwards [actual_source_jet_pair g] with F hF μ k T
  simp only [descentCurrent,sourceJetCurrent,hF]

theorem actual_original_source_jet_budget (sharp : Bool) (μ : ℝ) (hμ : 0<μ) (g k : diagonal.domain) :
    ∀ ε : ℝ,0<ε → ∃ N : ℕ,∀ m,N ≤ m → ∀ ell,m ≤ ell →
      ∀ᶠ F in (sourceFilter : Filter Index),
        SourceFourPoleEnergyClosed.closedJointCost sharp m ell F μ (g : H) (k : H) ≤
          ε+(4*SourceScalarSignedInverseReturn.formPrice sharp/μ)*
            sourceJetCurrent F μ g k (SourceScalarInverseRetardedBudget.theta m ell) := by
  intro ε hε
  obtain ⟨N,hN⟩ := actual_original_source_descent_budget sharp μ hμ g k ε hε
  refine ⟨N,fun m hm ell hell => ?_⟩
  filter_upwards [hN m hm ell hell,actual_source_jet_current g] with F hF hJ
  simpa only [hJ μ k] using hF

/-- The actual retarded compression is generated by the fixed H0 input, uniformly in the nonreal frequency. -/
theorem actual_retarded_source_step (g : diagonal.domain) :
    ∀ᶠ F in (sourceFilter : Filter Index),∀ (z : ℂ) (hz : z.im≠0),
      compressionCore F (state F z hz g)=state F z hz (iterate 1 g) := by
  filter_upwards [actual_channel_source_jet 1 g] with F hF z hz
  simp only [pow_one] at hF
  rw [actual_state_channels,actual_state_channels,map_sum]
  simp only [map_smul,actual_channel_eigen,hF]

/-- The full Noether current now pairs two actual retarded inputs; no compression-dependent insertion remains. -/
def fixedSourceCurrent (F : Index) (μ : ℝ) (hμ : 0<μ) (g k : diagonal.domain) (T : End) : ℝ :=
  ∫ w : ℝ,‖finiteResolvent F (star (line μ w)) (k : H)‖^2*
    (-(sourcePair (T (state F (line μ w) (by simpa only [line_im] using hμ.ne') (iterate 1 g)))
      (SourceInverseNoetherEnergy.bulkAction (T (state F (line μ w) (by simpa only [line_im] using hμ.ne') g)))).im)

theorem actual_fixed_source_current (g : diagonal.domain) :
    ∀ᶠ F in (sourceFilter : Filter Index),∀ (μ : ℝ) (hμ : 0<μ) (k : diagonal.domain) (T : End),
      gapCurrent F μ g k T=fixedSourceCurrent F μ hμ g k T := by
  filter_upwards [actual_retarded_source_step g] with F hF μ hμ k T
  rw [←actual_closed_gap_current F μ hμ g k T,←SourceInverseNoetherCurrentSpectral.actual_current_closed F μ hμ g k 1 T]
  unfold fixedSourceCurrent
  apply integral_congr_ae
  exact Filter.Eventually.of_forall (fun w => by
    have hz : (line μ w).im≠0 := by simpa only [line_im] using hμ.ne'
    have hs (z : ℂ) (hz : z.im≠0) : embed (state F z hz k)=finiteResolvent F z (k : H) := by
      unfold state
      exact congrArg Subtype.val (coreEquiv.apply_symm_apply _)
    simp only [SourceInverseNoetherCurrentSpectral.currentMoment,Module.End.one_apply,hs,
      SourceInverseNoetherEnergy.original_raised_noether_compression,hF _ hz])

theorem actual_original_fixed_source_budget (sharp : Bool) (μ : ℝ) (hμ : 0<μ) (g k : diagonal.domain) :
    ∀ ε : ℝ,0<ε → ∃ N : ℕ,∀ m,N ≤ m → ∀ ell,m ≤ ell →
      ∀ᶠ F in (sourceFilter : Filter Index),
        SourceFourPoleEnergyClosed.closedJointCost sharp m ell F μ (g : H) (k : H) ≤
          ε+(4*SourceScalarSignedInverseReturn.formPrice sharp/μ)*
            fixedSourceCurrent F μ hμ g k (SourceScalarInverseRetardedBudget.theta m ell) := by
  intro ε hε
  obtain ⟨N,hN⟩ := actual_original_gap_budget sharp μ hμ g k ε hε
  refine ⟨N,fun m hm ell hell => ?_⟩
  filter_upwards [hN m hm ell hell,actual_fixed_source_current g] with F hF hJ
  simpa only [hJ μ hμ k] using hF

end LowEnergy.SourceInverseGapWardFirstJet
