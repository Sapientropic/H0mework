private theorem q_nonneg (z : SourceCoordinateSlice) : 0 ≤ 1-reciprocal z :=
  sub_nonneg.mpr (inv_le_one_of_one_le₀ (one_le_radius z))
private theorem q_lt_one (z : SourceCoordinateSlice) : 1-reciprocal z<1 := by
  have h := inv_pos.mpr (radius_pos z)
  change 1-(radius z)⁻¹<1
  linarith

private theorem source_peak (f : QuantumTest) :
    ∃ ρ : ℝ, 0 ≤ ρ ∧ ρ<1 ∧ ∀ z∈tsupport f,1-reciprocal z ≤ ρ := by
  by_cases h : (tsupport f).Nonempty
  · obtain ⟨z,hz,hm⟩ := f.hasCompactSupport.exists_isMaxOn h
      (continuous_const.sub reciprocal_smooth.continuous).continuousOn
    exact ⟨1-reciprocal z,q_nonneg z,q_lt_one z,hm⟩
  · refine ⟨0,le_refl _,by norm_num,fun z hz => ?_⟩
    exact False.elim (h ⟨z,hz⟩)

private theorem band_geometric (m ell : ℕ) (ρ : ℝ) (hρ : 0 ≤ ρ) (hρ1 : ρ<1) :
    band m ell ρ ≤ ρ^(m+1)/(1-ρ) := by
  by_cases hml : m ≤ ell
  · have he : band m ell ρ=∑ j∈Finset.Ico (m+1) (ell+1),ρ^j := by
      exact Finset.sum_Ico_add' (fun j => ρ^j) m ell 1
    apply (le_div_iff₀ (sub_pos.mpr hρ1)).mpr
    rw [he,geom_sum_Ico_mul_neg ρ (by omega)]
    exact sub_le_self _ (pow_nonneg hρ _)
  · simp only [band,Finset.Ico_eq_empty_of_le (by omega : ell ≤ m),Finset.sum_empty]
    positivity

private theorem half_square_le (m ell : ℕ) (z : SourceCoordinateSlice) :
    halfCoefficient m ell z^2 ≤ coefficient m ell z := by
  have hA : 0 ≤ coefficient m ell z := by
    unfold coefficient band
    exact Finset.sum_nonneg (fun j _ => pow_nonneg (q_nonneg z) _)
  have hs := Real.sq_sqrt (show 0 ≤ 1+coefficient m ell z by linarith)
  have hp := Real.one_le_sqrt.mpr (show 1 ≤ 1+coefficient m ell z by linarith)
  unfold halfCoefficient
  nlinarith only [hs,hp]

private theorem half_density (m ell : ℕ) (f : QuantumTest) (z : SourceCoordinateSlice) :
    (densityPair (halfAction m ell f) (halfAction m ell f) z).re=
      halfCoefficient m ell z^2*(densityPair f f z).re := by
  change (inner ℂ (GaussFockWeights.weight (fun N => GaussDensityCore.complexDensity N z)
    ((halfCoefficient m ell z : ℂ) • f z)) ((halfCoefficient m ell z : ℂ) • f z)).re=_
  rw [map_smul,inner_smul_left,inner_smul_right]
  simp only [Complex.conj_ofReal,Complex.mul_re,Complex.mul_im,Complex.ofReal_re,Complex.ofReal_im,
    zero_mul,add_zero,sub_zero]
  change _=halfCoefficient m ell z^2*(inner ℂ (GaussFockWeights.weight
    (fun N => GaussDensityCore.complexDensity N z) (f z)) (f z)).re
  ring

private theorem density_nonneg (f : QuantumTest) (z : SourceCoordinateSlice) : 0 ≤ (densityPair f f z).re := by
  by_cases hz : z∈physicalChart
  · change 0 ≤ RCLike.re (inner ℂ (GaussFockWeights.weight
      (fun N => (GaussDensityCore.density N z : ℂ)) (f z)) (f z))
    rw [GaussBoundedMultiplier.weighted_square _ (fun N => (GaussDensityCore.density_pos N ⟨z,hz⟩).le)]
    exact sq_nonneg _
  · have hf : f z=0 := image_eq_zero_of_notMem_tsupport (fun h => hz (f.tsupport_subset h))
    simp only [densityPair,hf,map_zero,inner_zero_left,Complex.zero_re,le_refl]

/-- One peak is generated by the original source support and pays every upper radius cutoff. -/
theorem original_half_seed_price (f : QuantumTest) :
    ∃ ρ : ℝ, 0 ≤ ρ ∧ ρ<1 ∧ ∀ m ell : ℕ,
      ‖embed (halfAction m ell f)‖^2 ≤ (ρ^(m+1)/(1-ρ))*‖embed f‖^2 := by
  obtain ⟨ρ,hρ,hρ1,hpeak⟩ := source_peak f
  refine ⟨ρ,hρ,hρ1,fun m ell => ?_⟩
  rw [GaussBoundedMultiplier.norm_square_integral,GaussBoundedMultiplier.norm_square_integral,←integral_const_mul]
  apply integral_mono (densityPair_integrable (halfAction m ell f) (halfAction m ell f)).re
    ((densityPair_integrable f f).re.const_mul _)
  intro z
  change (densityPair (halfAction m ell f) (halfAction m ell f) z).re ≤
    (ρ^(m+1)/(1-ρ))*(densityPair f f z).re
  rw [half_density]
  by_cases hz : z∈tsupport f
  · have hA : coefficient m ell z ≤ band m ell ρ := by
      unfold coefficient band
      exact Finset.sum_le_sum (fun j _ => pow_le_pow_left₀ (q_nonneg z) (hpeak z hz) _)
    exact mul_le_mul_of_nonneg_right ((half_square_le m ell z).trans
      (hA.trans (band_geometric m ell ρ hρ hρ1))) (density_nonneg f z)
  · have hf : f z=0 := image_eq_zero_of_notMem_tsupport hz
    simp only [densityPair,hf,map_zero,inner_zero_left,Complex.zero_re,mul_zero,le_refl]

/-- The actual fixed source term has a common cutoff tail before F, frequency, or the causal leg are chosen. -/
theorem original_half_seed_tail (f : QuantumTest) :
    ∀ ε : ℝ,0<ε → ∃ N : ℕ,∀ m,N ≤ m → ∀ ell : ℕ,‖embed (halfAction m ell f)‖^2 ≤ ε := by
  intro ε hε
  obtain ⟨ρ,hρ,hρ1,hprice⟩ := original_half_seed_price f
  have ht : Tendsto (fun m : ℕ => (ρ^(m+1)/(1-ρ))*‖embed f‖^2) atTop (𝓝 0) := by
    have h := ((tendsto_pow_atTop_nhds_zero_of_lt_one hρ hρ1).mul_const ρ).div_const (1-ρ)
      |>.mul_const (‖embed f‖^2)
    simpa only [pow_succ,zero_mul,zero_div] using h
  obtain ⟨N,hN⟩ := eventually_atTop.mp (ht.eventually_lt_const hε)
  exact ⟨N,fun m hm ell => (hprice m ell).trans (hN m hm).le⟩

end LowEnergy.SourceRadiusHalfSeedTail
