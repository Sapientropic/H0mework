import H0mework.Versions.AC.Physics.LowEnergy.AlphaSource.EmIdentification.CompositeContact
import H0mework.Versions.AC.Physics.LowEnergy.Quantum.GaussFullRetarded

/-! The original half-density charged letters preserve the actual smooth core.
The volume factors are generated by the original Number-dependent measure. -/
set_option autoImplicit false
set_option maxHeartbeats 2200000
set_option backward.isDefEq.respectTransparency false
noncomputable section
namespace LowEnergy.GaussComposite
open SaturationMonoid.PhysicsCore
open SourceQuantumConfigurationHilbert SourceQuantumFockGauge SourceQuantumGaugeSliceCoordinates
open GaussCoreHilbert GaussCoreDifferential GaussHalfDensity GaussHistoryHilbert GaussFockLift
open MeasureTheory Filter
open scoped InnerProductSpace ContDiff BigOperators
attribute [local instance] SourceRealScalarFock.branchOrder
local instance coreModeDecision : DecidableEq Mode := LinearOrder.toDecidableEq

def rootVolume (z : SourceCoordinateSlice) : ℝ := Real.sqrt (z.1 0*z.1 2*z.1 5)

theorem root_volume_pos (z : physicalChart) : 0<rootVolume z :=
  Real.sqrt_pos.mpr (spatialVolume_pos z)

theorem root_volume_smooth (z : physicalChart) : ContDiffAt ℝ ∞ rootVolume z.val := by
  apply ContDiffAt.sqrt
  · fun_prop
  · exact (spatialVolume_pos z).ne'

theorem half_density_successor (N : ℕ) (z : physicalChart) :
    halfDensity (N+1) z=rootVolume z*halfDensity N z := by
  have h : GaussHistoryHilbert.numberWeight (N+1) z=GaussHistoryHilbert.numberWeight N z*spatialVolume z := by
    simp only [GaussHistoryHilbert.numberWeight,show N+1+2=N+2+1 by omega,pow_succ,mul_assoc]
  simp only [halfDensity,h,Real.sqrt_mul (numberWeight_pos N z).le]
  exact mul_comm _ _

def halfWeightAt (z : physicalChart) : FiberOp :=
  GaussFockWeights.weight (fun N => (halfDensity N z : ℂ))

theorem weightedValue_eq (f : QuantumTest) (z : physicalChart) :
    weightedValue f z=halfWeightAt z (f z) := rfl

theorem half_weight_creation (i : Mode) (v : FockFiber) (z : physicalChart) :
    halfWeightAt z ((rootVolume z : ℂ)⁻¹ • GaussCARHistory.createFiber i v) =
      GaussCARHistory.createFiber i (halfWeightAt z v) := by
  apply PiLp.ext
  intro word
  change (halfDensity word.card z : ℂ)*((rootVolume z : ℂ)⁻¹*
    QuantizationCheck.Fermion.create i (fiberCoordinates v) word)=
    QuantizationCheck.Fermion.create i (fiberCoordinates (halfWeightAt z v)) word
  by_cases hi : i∈word
  · simp only [QuantizationCheck.Fermion.create,if_pos hi]
    change (halfDensity word.card z : ℂ)*((rootVolume z : ℂ)⁻¹*
      (QuantizationCheck.Fermion.sign i (word.erase i)*v (word.erase i)))=
      QuantizationCheck.Fermion.sign i (word.erase i)*
        ((halfDensity (word.erase i).card z : ℂ)*v (word.erase i))
    have hn : word.card=(word.erase i).card+1 := (Finset.card_erase_add_one hi).symm
    rw [hn,half_density_successor,Complex.ofReal_mul]
    have hp : (rootVolume z : ℂ)≠0 := Complex.ofReal_ne_zero.mpr (root_volume_pos z).ne'
    field_simp
  · simp [QuantizationCheck.Fermion.create,hi]

theorem half_weight_annihilation (i : Mode) (v : FockFiber) (z : physicalChart) :
    halfWeightAt z ((rootVolume z : ℂ) • GaussCARHistory.annihilateFiber i v) =
      GaussCARHistory.annihilateFiber i (halfWeightAt z v) := by
  apply PiLp.ext
  intro word
  change (halfDensity word.card z : ℂ)*((rootVolume z : ℂ)*
    QuantizationCheck.Fermion.annihilate i (fiberCoordinates v) word)=
    QuantizationCheck.Fermion.annihilate i (fiberCoordinates (halfWeightAt z v)) word
  by_cases hi : i∈word
  · simp [QuantizationCheck.Fermion.annihilate,hi]
  · simp only [QuantizationCheck.Fermion.annihilate,if_neg hi]
    change (halfDensity word.card z : ℂ)*((rootVolume z : ℂ)*
      (QuantizationCheck.Fermion.sign i word*v (insert i word)))=
      QuantizationCheck.Fermion.sign i word*
        ((halfDensity (insert i word).card z : ℂ)*v (insert i word))
    rw [Finset.card_insert_of_notMem hi,half_density_successor,Complex.ofReal_mul]
    ring

theorem annihilation_matrix_smooth (channel spin : Fin 2) :
    ContDiff ℝ ∞ (fun z => fiberAnnihilation channel spin (GaussNativePotential.scalarField z)) := by
  change ContDiff ℝ ∞ (fun z => ∑ color : Fin 3,
    coefficient channel color z • GaussCARHistory.annihilateFiber (mode spin color))
  apply ContDiff.sum
  intro color _
  exact (coefficient_smooth channel color).smul contDiff_const

theorem creation_matrix_smooth (channel spin : Fin 2) :
    ContDiff ℝ ∞ (fun z => fiberCreation channel spin (GaussNativePotential.scalarField z)) := by
  change ContDiff ℝ ∞ (fun z => ∑ color : Fin 3,
    star (coefficient channel color z) • GaussCARHistory.createFiber (mode spin color))
  apply ContDiff.sum
  intro color _
  exact (((RCLike.conjCLE : ℂ ≃L[ℝ] ℂ).toContinuousLinearMap.contDiff).comp
    (coefficient_smooth channel color)).smul contDiff_const

theorem root_volume_complex_smooth (z : physicalChart) :
    ContDiffAt ℝ ∞ (fun w : SourceCoordinateSlice => (rootVolume w : ℂ)) z.val :=
  Complex.ofRealCLM.contDiff.contDiffAt.comp z.val (root_volume_smooth z)

def annihilationTest (channel spin : Fin 2) : QuantumTest →ₗ[ℂ] QuantumTest :=
  localMultiplier (fun z => (rootVolume z : ℂ) •
    fiberAnnihilation channel spin (GaussNativePotential.scalarField z))
    (fun z => (root_volume_complex_smooth z).smul (annihilation_matrix_smooth channel spin).contDiffAt)

def creationTest (channel spin : Fin 2) : QuantumTest →ₗ[ℂ] QuantumTest :=
  localMultiplier (fun z => (rootVolume z : ℂ)⁻¹ •
    fiberCreation channel spin (GaussNativePotential.scalarField z))
    (fun z => ((root_volume_complex_smooth z).inv
      (Complex.ofReal_ne_zero.mpr (root_volume_pos z).ne')).smul
        (creation_matrix_smooth channel spin).contDiffAt)

theorem annihilation_test_value (channel spin : Fin 2) (f : QuantumTest) (z : physicalChart) :
    weightedValue (annihilationTest channel spin f) z =
      fiberAnnihilation channel spin (GaussNativePotential.scalarField z) (weightedValue f z) := by
  rw [weightedValue_eq,weightedValue_eq]
  change halfWeightAt z ((rootVolume z : ℂ) •
    fiberAnnihilation channel spin (GaussNativePotential.scalarField z) (f z)) = _
  simp only [fiberAnnihilation,sum_apply,smul_apply,Finset.smul_sum,map_sum]
  apply Finset.sum_congr rfl
  intro color _
  rw [smul_comm (rootVolume z : ℂ),map_smul,half_weight_annihilation]

theorem creation_test_value (channel spin : Fin 2) (f : QuantumTest) (z : physicalChart) :
    weightedValue (creationTest channel spin f) z =
      fiberCreation channel spin (GaussNativePotential.scalarField z) (weightedValue f z) := by
  rw [weightedValue_eq,weightedValue_eq]
  change halfWeightAt z ((rootVolume z : ℂ)⁻¹ •
    fiberCreation channel spin (GaussNativePotential.scalarField z) (f z)) = _
  simp only [fiberCreation,sum_apply,smul_apply,Finset.smul_sum,map_sum]
  apply Finset.sum_congr rfl
  intro color _
  rw [smul_comm (rootVolume z : ℂ)⁻¹,map_smul,half_weight_creation]

theorem embed_annihilation_test (channel spin : Fin 2) (f : QuantumTest) :
    embed (annihilationTest channel spin f) = annihilationSource channel spin f := by
  apply fockHalfDensityEquiv.injective
  apply PiLp.ext
  intro word
  apply Lp.ext
  filter_upwards [flat_embed_value (annihilationTest channel spin f),annihilation_source_value channel spin f]
    with z ht hs
  exact congrArg (fun v : FockFiber => v word)
    ((ht.trans (annihilation_test_value channel spin f z)).trans hs.symm)

theorem embed_creation_test (channel spin : Fin 2) (f : QuantumTest) :
    embed (creationTest channel spin f) = creationSource channel spin f := by
  apply fockHalfDensityEquiv.injective
  apply PiLp.ext
  intro word
  apply Lp.ext
  filter_upwards [flat_embed_value (creationTest channel spin f),creation_source_value channel spin f]
    with z ht hs
  exact congrArg (fun v : FockFiber => v word)
    ((ht.trans (creation_test_value channel spin f z)).trans hs.symm)

end LowEnergy.GaussComposite
