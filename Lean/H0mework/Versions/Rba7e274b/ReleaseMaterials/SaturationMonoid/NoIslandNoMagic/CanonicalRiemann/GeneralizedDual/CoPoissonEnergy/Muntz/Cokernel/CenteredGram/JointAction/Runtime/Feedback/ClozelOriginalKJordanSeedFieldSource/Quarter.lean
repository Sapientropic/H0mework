/-- The actual whole source integrand keeps its moving-radius inventory before the protected quarter is read. -/
theorem actual_jordan_seed_integrand_source (z : ℂ) (time : ℝ) :
 J.actualResonantIntegrand z J.seed time=
 (((time:ℂ)*positiveMellinQuarterRightResolventWeight z time)*
   (((2*q:ℝ):ℂ)*(Real.exp (time/4):ℂ))) •
   burnolAmbientGapRieszVector (q*Real.exp (time/2)) :=by
 unfold J.actualResonantIntegrand burnolDirectRightResolventIntegrand
 rw [actual_seed_dilation_source]
 rw [show -(-time/2)/2=time/4 by ring,show -(-time/2)=time/2 by ring]
 rw [←algebraMap_smul ℂ time,smul_smul,smul_smul]
 rfl

/-- Quarter is restored from the same generated moving-radius field, with its literal time and phase. -/
theorem actual_jordan_seed_integrand_quarter (z : ℂ) (time : ℝ) (nonnegative : 0≤time) :
 burnolRadiusRestriction q (J.actualResonantIntegrand z J.seed time)=
 ((time:ℂ)*Complex.exp (-z*(time:ℂ))) • intervalConstant q :=by
 unfold J.actualResonantIntegrand burnolDirectRightResolventIntegrand
 rw [←algebraMap_smul ℂ time,map_smul,map_smul,
   actual_seed_negative_quarter_source (-time/2) (by linarith),smul_smul,smul_smul]
 rw [show (-time/2)/2=-time/4 by ring,mul_assoc,Paid.source_weight_mean_phase]
 rfl

/-- The real quarter field is generated by applying the original restriction CLM to the actual source integral. -/
theorem actual_jordan_seed_quarter_field (z : ℂ) (right : 1/4<z.re) :
 burnolRadiusRestriction q (J.actualResonantField z J.seed)=
 (∫ time : ℝ in Ioi 0,(time:ℂ)*Complex.exp (-z*(time:ℂ))) • intervalConstant q :=by
 unfold J.actualResonantField
 rw [←(burnolRadiusRestriction q).integral_comp_comm (J.actual_resonant_integrable z right J.seed)]
 have source : (∫ time:ℝ in Ioi 0,burnolRadiusRestriction q (J.actualResonantIntegrand z J.seed time))=
   ∫ time:ℝ in Ioi 0,((time:ℂ)*Complex.exp (-z*(time:ℂ))) • intervalConstant q :=by
  apply setIntegral_congr_fun measurableSet_Ioi
  intro time positive
  exact actual_jordan_seed_integrand_quarter z time positive.le
 rw [source,integral_smul_const]

def actualJordanSeedExterior (z : ℂ) : BurnolL2 :=
 J.actualResonantField z J.seed-
 burnolRadiusZeroExtension q (burnolRadiusRestriction q (J.actualResonantField z J.seed))

/-- The retained exterior is an actual source restriction; it is not assumed to vanish after R or Fourier. -/
theorem actual_jordan_seed_exterior_quarter (z : ℂ) :
 burnolRadiusRestriction q (actualJordanSeedExterior z)=0 :=by
 unfold actualJordanSeedExterior
 rw [map_sub,burnolRadiusRestriction_zeroExtension,sub_self]

theorem actual_jordan_seed_complete_inventory (z : ℂ) (right : 1/4<z.re) :
 J.actualResonantField z J.seed=
 (∫ time : ℝ in Ioi 0,(time:ℂ)*Complex.exp (-z*(time:ℂ))) • J.seed+
 actualJordanSeedExterior z :=by
 have source:=actual_jordan_seed_quarter_field z right
 have actual:=congrArg (burnolRadiusZeroExtension q) source
 rw [map_smul] at actual
 change burnolRadiusZeroExtension q (burnolRadiusRestriction q (J.actualResonantField z J.seed))=
   (∫ time:ℝ in Ioi 0,(time:ℂ)*Complex.exp (-z*(time:ℂ))) • J.seed at actual
 unfold actualJordanSeedExterior
 rw [actual]
