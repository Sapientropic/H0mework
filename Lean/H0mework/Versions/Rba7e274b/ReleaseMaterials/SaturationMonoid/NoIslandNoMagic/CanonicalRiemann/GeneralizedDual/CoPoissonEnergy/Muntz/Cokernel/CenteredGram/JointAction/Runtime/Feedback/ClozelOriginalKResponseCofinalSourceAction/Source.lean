def actualU : Nat→M
 | 0=>0
 | n+1=>OriginalRieszSource.Response.eta+S (actualU n)

def actualV (n : Nat) : M:=T (actualU n)

/-- The finite source constructor advances by the actual same eta/T-square action, without the limit or target coefficient as input. -/
theorem actual_source_step (n : Nat) :
 actualU (n+1)=OriginalRieszSource.Response.eta+S (actualU n) :=rfl

/-- The existing inverse source equation is consumed as its true fixed source action. -/
theorem actual_original_source_fixed :
 OriginalRieszSource.Response.u=OriginalRieszSource.Response.eta+S OriginalRieszSource.Response.u :=by
 have source:=OriginalRieszSource.Response.u_equation
 change OriginalRieszSource.Response.u-S OriginalRieszSource.Response.u=OriginalRieszSource.Response.eta at source
 linear_combination (norm:=module) source

/-- Actual increments are generated by the same source action and retained in their original whole carrier. -/
theorem actual_source_increment (n : Nat) :
 actualU (n+1)-actualU n=(S^n) OriginalRieszSource.Response.eta :=by
 induction n with
 | zero=>simp [actualU]
 | succ n previous=>
  rw [actual_source_step (n+1),actual_source_step n]
  change (OriginalRieszSource.Response.eta+S (actualU (n+1)))-
   (OriginalRieszSource.Response.eta+S (actualU n))=(S^(n+1)) OriginalRieszSource.Response.eta
  have action:OriginalRieszSource.Response.eta+S (actualU (n+1))-
   (OriginalRieszSource.Response.eta+S (actualU n))=S (actualU (n+1)-actualU n):=by
   rw [map_sub]
   module
  rw [action,previous,pow_succ']
  rfl

/-- Same generated finite source and the already-generated inverse source retain their exact residual, without a zero premise. -/
theorem actual_source_residual (n : Nat) :
 OriginalRieszSource.Response.u-actualU n=(S^n) OriginalRieszSource.Response.u :=by
 induction n with
 | zero=>simp [actualU]
 | succ n previous=>
  rw [actual_source_step]
  nth_rw 1 [actual_original_source_fixed]
  have source:OriginalRieszSource.Response.eta+S OriginalRieszSource.Response.u-
   (OriginalRieszSource.Response.eta+S (actualU n))=S (OriginalRieszSource.Response.u-actualU n):=by
   rw [map_sub]
   module
  rw [source,previous,pow_succ']
  rfl

