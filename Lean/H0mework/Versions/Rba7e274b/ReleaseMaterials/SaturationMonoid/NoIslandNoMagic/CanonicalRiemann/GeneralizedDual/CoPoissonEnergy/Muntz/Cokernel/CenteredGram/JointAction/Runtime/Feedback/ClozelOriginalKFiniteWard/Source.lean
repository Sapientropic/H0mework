abbrev totalBranches := Prior.totalBranches
abbrev directions := Prior.directions

theorem directions_add (left right : (BurnolL2 × BurnolL2) × (BurnolL2 × BurnolL2)) :
    directions (left + right) = directions left + directions right := by
  apply Prod.ext
  · change (left.1.1 + right.1.1) + (left.2.1 + right.2.1) = (left.1.1 + left.2.1) + (right.1.1 + right.2.1)
    abel
  · change (left.1.2 + right.1.2) + (left.2.2 + right.2.2) = (left.1.2 + left.2.2) + (right.1.2 + right.2.2)
    abel

theorem directions_lift (action : (BurnolL2 × BurnolL2) →L[ℂ] (BurnolL2 × BurnolL2))
    (value : (BurnolL2 × BurnolL2) × (BurnolL2 × BurnolL2)) :
    directions (liftPairMap action value) = action (value.1 + value.2) := by
  change action value.1 + action value.2 = _
  exact (map_add action _ _).symm

theorem R_code_total (environment : Env (PairValue (PairValue C.Value)) C.Var) :
    totalBranches ((FR.jointCode (P.code observation nontrivial half)).eval environment) =
      P.R observation nontrivial half (totalBranches (environment () ())) := by
  have generated := Full.complete_of_branches observation nontrivial half _ _
    (Full.joint_source_value observation nontrivial half environment)
  exact generated.2.2.1.trans (congrArg (P.R observation nontrivial half) (by
    change ((environment () ()).1.1 + (environment () ()).2.1) +
      ((environment () ()).1.2 + (environment () ()).2.2) = _
    change ((environment () ()).1.1 + (environment () ()).2.1) +
      ((environment () ()).1.2 + (environment () ()).2.2) =
      ((environment () ()).1.1 + (environment () ()).1.2) +
      ((environment () ()).2.1 + (environment () ()).2.2)
    abel))

def wardSourceValue (value : BurnolL2) : BurnolL2 × BurnolL2 :=
  (inner ℂ (finiteSource observation nontrivial half) (P.R observation nontrivial half value) • (Prior.originalK observation nontrivial half),
   inner ℂ (fourierL2 (finiteSource observation nontrivial half)) (P.R observation nontrivial half value) • (Prior.originalFourierK observation nontrivial half))

theorem ward_code_directions (environment : Env (PairValue (PairValue C.Value)) C.Var) :
    directions ((wardCode observation nontrivial half).eval environment) =
      wardSourceValue observation nontrivial half (totalBranches (environment () ())) := by
  change directions (liftPairMap (directedRead observation nontrivial half)
    ((Original.actionCode observation nontrivial half).eval environment) +
    liftPairMap (-(sourceCharacter observation • baseRead observation nontrivial half))
      ((FR.jointCode (P.code observation nontrivial half)).eval environment)) = _
  rw [directions_add, directions_lift, directions_lift]
  simp only [neg_apply, smul_apply]
  rw [← sub_eq_add_neg]
  change directedRead observation nontrivial half (directions ((Original.actionCode observation nontrivial half).eval environment)) -
    sourceCharacter observation • baseRead observation nontrivial half
      (((FR.jointCode (P.code observation nontrivial half)).eval environment).1 +
       ((FR.jointCode (P.code observation nontrivial half)).eval environment).2) = _
  have directed : directions ((Original.actionCode observation nontrivial half).eval environment) =
      (burnolMultiplicativeDilation Prior.sourceShift (P.R observation nontrivial half (totalBranches (environment () ()))),
       burnolMultiplicativeDilation (-Prior.sourceShift) (P.R observation nontrivial half (totalBranches (environment () ())))) :=
    Original.action_code_directions observation nontrivial half environment
  rw [directed]
  have total : Prior.pairTotal (((FR.jointCode (P.code observation nontrivial half)).eval environment).1 +
      ((FR.jointCode (P.code observation nontrivial half)).eval environment).2) =
      P.R observation nontrivial half (totalBranches (environment () ())) := by
    let value := (FR.jointCode (P.code observation nontrivial half)).eval environment
    have reorder : Prior.pairTotal (value.1 + value.2) = totalBranches value := by
      change (value.1.1 + value.2.1) + (value.1.2 + value.2.2) =
        (value.1.1 + value.1.2) + (value.2.1 + value.2.2)
      abel
    exact reorder.trans (R_code_total observation nontrivial half environment)
  apply Prod.ext
  · change KRead observation nontrivial half (burnolMultiplicativeDilation Prior.sourceShift _) -
      sourceCharacter observation • KRead observation nontrivial half (Prior.pairTotal _) = _
    rw [total]
    exact directed_source_K observation nontrivial half _
  · change FourierKRead observation nontrivial half (burnolMultiplicativeDilation (-Prior.sourceShift) _) -
      sourceCharacter observation • FourierKRead observation nontrivial half (Prior.pairTotal _) = _
    rw [total]
    exact directed_source_FourierK observation nontrivial half _


theorem action_code_directions (environment : Env (PairValue (PairValue C.Value)) C.Var) :
    directions ((actionCode observation nontrivial half).eval environment) =
      wardSourceValue observation nontrivial half (totalBranches (environment () ())) +
        selfSourceValue observation nontrivial half := by
  change directions ((wardCode observation nontrivial half).eval environment +
    (selfSourceCode observation nontrivial half).eval environment) = _
  rw [directions_add, ward_code_directions]
  exact congrArg (fun value => wardSourceValue observation nontrivial half (totalBranches (environment () ())) + value)
    (self_source_directions observation nontrivial half environment)

private theorem directions_of_actual_input
    (packet : AS.AdmissionPacket (W := PairValue C.Value) (X := C.Var) (s := ()))
    (generated : AI.HasActualInput (actionCode observation nontrivial half) packet.1 packet.2.2.1 packet.2.2.2.down) :
    directions (CF.collapseValue packet.1 (R.actionResultAt packet.2.1.1 packet.2.2.1
      (S.actualOccurrence packet.2.1.1)).2.2.1) =
      wardSourceValue observation nontrivial half (totalBranches (CF.collapseValue packet.1
        (packet.2.1.1.activeEnvironment () (), 0))) + selfSourceValue observation nontrivial half :=
  (congrArg directions (value_of_actual_input (actionCode observation nontrivial half) packet generated)).trans
    (action_code_directions observation nontrivial half _)

theorem actual_admitted_directions (ordinal : Nat) : type_of%
    (directions_of_actual_input observation nontrivial half (actionPacket observation nontrivial half depth ordinal)
      (actual_admitted_input observation nontrivial half depth ordinal)) :=
  directions_of_actual_input observation nontrivial half _
    (actual_admitted_input observation nontrivial half depth ordinal)

