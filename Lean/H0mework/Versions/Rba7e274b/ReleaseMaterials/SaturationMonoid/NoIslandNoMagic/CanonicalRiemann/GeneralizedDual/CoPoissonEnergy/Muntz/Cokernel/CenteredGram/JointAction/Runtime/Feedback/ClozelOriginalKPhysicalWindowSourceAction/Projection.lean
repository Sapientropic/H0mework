/-- The existing complete P raw producer consumes the same generated whole actual R profiles; both inverse quarter corrections are retained. -/
theorem actual_physical_pair_sibling_source_raw (h : ℝ) (nonnegative : 0 ≤ h) (bounded : h ≤ Real.log 2) :
    ((P (OriginalKFullSourceRResponse.pairedResponse observation nontrivial half h) : BurnolL2) : ℝ → ℂ) =ᵐ[volume]
      actualPhysicalPairedRaw observation nontrivial half h ∧
    ((P (OriginalKFullSourceRResponse.siblingResponse observation nontrivial half h) : BurnolL2) : ℝ → ℂ) =ᵐ[volume]
      actualPhysicalSiblingRaw observation nontrivial half h := by
  have source := actual_original_pair_sibling_full_source_raw observation nontrivial half h nonnegative bounded
  exact ⟨burnolEvenProjection_ae_raw _ _ source.1, burnolEvenProjection_ae_raw _ _ source.2⟩

/-- Only the actual first correction's support vanishes on the outer annulus; the full second Fourier correction remains. -/
theorem actual_physical_source_outer (h x : ℝ) (outside : (1 / 4 : ℝ) < x) :
    actualPhysicalPairedRaw observation nontrivial half h x = actualPhysicalPairedOuterRaw observation nontrivial half h x ∧
    actualPhysicalSiblingRaw observation nontrivial half h x = actualPhysicalSiblingOuterRaw observation nontrivial half h x :=
  ⟨burnolEvenProjectionRaw_eq_positiveOuter _ _ outside, burnolEvenProjectionRaw_eq_positiveOuter _ _ outside⟩

/-- The positive physical source profile's continuity is generated by actual R primitives and the canonical Fourier correction. -/
theorem actual_physical_source_outer_continuous (h : ℝ) :
    ContinuousOn (actualPhysicalPairedOuterRaw observation nontrivial half h) (Ioi 0) ∧
    ContinuousOn (actualPhysicalSiblingOuterRaw observation nontrivial half h) (Ioi 0) := by
  have raw : ContinuousOn (actualOriginalPairedRWholeRaw observation nontrivial half h) (Ioi 0) ∧
      ContinuousOn (actualOriginalSiblingRWholeRaw observation nontrivial half h) (Ioi 0) := by
    constructor <;> intro x positive
    · exact (actual_original_pair_sibling_raw_continuousAt observation nontrivial half h x (show x ≠ 0 from (show 0 < x from positive).ne')).1.continuousWithinAt
    · exact (actual_original_pair_sibling_raw_continuousAt observation nontrivial half h x (show x ≠ 0 from (show 0 < x from positive).ne')).2.continuousWithinAt
  have reflected : ContinuousOn (fun x => actualOriginalPairedRWholeRaw observation nontrivial half h (-x)) (Ioi 0) ∧
      ContinuousOn (fun x => actualOriginalSiblingRWholeRaw observation nontrivial half h (-x)) (Ioi 0) := by
    constructor <;> intro x positive
    · exact ((actual_original_pair_sibling_raw_continuousAt observation nontrivial half h (-x) (neg_ne_zero.mpr (show x ≠ 0 from (show 0 < x from positive).ne'))).1.comp continuousAt_neg).continuousWithinAt
    · exact ((actual_original_pair_sibling_raw_continuousAt observation nontrivial half h (-x) (neg_ne_zero.mpr (show x ≠ 0 from (show 0 < x from positive).ne'))).2.comp continuousAt_neg).continuousWithinAt
  have pairCorrection := burnolRadiusTruncatedFourierRaw_continuous
    (burnolAmbientMeanZeroSecondCorrection (OriginalKFullSourceRResponse.pairedResponse observation nontrivial half h) : BurnolQuarterIntervalL2)
  have siblingCorrection := burnolRadiusTruncatedFourierRaw_continuous
    (burnolAmbientMeanZeroSecondCorrection (OriginalKFullSourceRResponse.siblingResponse observation nontrivial half h) : BurnolQuarterIntervalL2)
  unfold actualPhysicalPairedOuterRaw actualPhysicalSiblingOuterRaw burnolEvenProjectionPositiveOuterRaw burnolEvenRaw
  constructor
  · exact ((raw.1.add reflected.1).const_mul (1 / 2 : ℂ)).sub
      ((pairCorrection.add (pairCorrection.comp continuous_neg)).const_mul (1 / 2 : ℂ)).continuousOn
  · exact ((raw.2.add reflected.2).const_mul (1 / 2 : ℂ)).sub
      ((siblingCorrection.add (siblingCorrection.comp continuous_neg)).const_mul (1 / 2 : ℂ)).continuousOn


