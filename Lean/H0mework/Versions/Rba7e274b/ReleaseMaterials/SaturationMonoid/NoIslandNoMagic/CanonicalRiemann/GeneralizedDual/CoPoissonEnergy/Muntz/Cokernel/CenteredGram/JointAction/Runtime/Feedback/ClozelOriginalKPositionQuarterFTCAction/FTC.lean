def actualTailQuarterOrbit (coordinate : BurnolCompletedMellinCoordinate) (time : ℝ) : ℂ :=
 -(4:ℂ)*positiveMellinQuarterRightResolventCharacter (coordinate.value/2) time*
 (∫ x : ℝ in (q*Real.exp (time/2))..q,(x:ℂ)^(-coordinate.value))

/-- Actual normalized source dilation supplies the one-sided moving quarter mean. -/
theorem actual_tail_quarter_orbit (coordinate : BurnolCompletedMellinCoordinate)
 (time : ℝ) (nonpositive : time≤0) :
 Paid.actualMean (burnolMultiplicativeDilation (-time/2)
   (burnolRadiusNormalizedUnitTail coordinate q (by norm_num)))=actualTailQuarterOrbit coordinate time := by
 rw [burnolRadiusNormalizedUnitTail_dilation,map_smul]
 have positive : 0<q*Real.exp (-(-time/2)):=mul_pos (by norm_num) (Real.exp_pos _)
 have bounded : q*Real.exp (-(-time/2))≤q := by
  have scale:=Real.exp_le_one_iff.mpr (show -(-time/2)≤0 by linarith)
  nlinarith
 rw [actual_tail_quarter_mean coordinate _ positive bounded]
 have character : fullMellinTranslationCharacter coordinate.value (-time/2)=
   positiveMellinQuarterRightResolventCharacter (coordinate.value/2) time := by
  rw [positiveMellinQuarterRightResolventCharacter_exp]
  unfold fullMellinTranslationCharacter
  congr 1
  push_cast
  ring
 unfold actualTailQuarterOrbit
 rw [character,show -(-time/2)=time/2 by ring]
 ring

/-- The endpoint is generated by FTC on the explicit source tail, with both halves and q scale retained. -/
theorem actual_tail_quarter_orbit_FTC (coordinate : BurnolCompletedMellinCoordinate) :
 HasDerivAt (actualTailQuarterOrbit coordinate)
 (((2*q:ℝ):ℂ)*(q:ℂ)^(-coordinate.value)) 0 := by
 let profile:=fun x : ℝ=>(x:ℂ)^(-coordinate.value)
 have continuous : ContinuousAt profile q :=
   Complex.continuousAt_ofReal_cpow_const q (-coordinate.value) (Or.inr (by norm_num))
 have measurable : StronglyMeasurableAtFilter profile (𝓝 q) :=
   (by fun_prop : Measurable profile).stronglyMeasurable.stronglyMeasurableAtFilter
 have integralSource:=intervalIntegral.integral_hasDerivAt_left
   (show IntervalIntegrable profile volume q q by simp) measurable continuous
 have moving : HasDerivAt (fun time : ℝ=>q*Real.exp (time/2)) (q/2) 0 := by
  convert! ((hasDerivAt_id (0:ℝ)).div_const 2).exp.const_mul q using 1
  norm_num
 have integralMoving:=integralSource.scomp_of_eq 0 moving (by simp)
 have character:=positiveMellinQuarterRightResolventCharacter_hasDerivAt (coordinate.value/2)
 have generated:=(character.mul integralMoving).const_mul (-(4:ℂ))
 have zeroCharacter : positiveMellinQuarterRightResolventCharacter (coordinate.value/2) 0=1 := by
  rw [positiveMellinQuarterRightResolventCharacter_exp]
  simp
 simp only [Function.comp_def,zero_div,Real.exp_zero,mul_one,intervalIntegral.integral_same,
   zeroCharacter,mul_zero,zero_add,one_mul] at generated
 unfold actualTailQuarterOrbit
 convert! generated using 1
 · funext time
   dsimp only [Function.comp_def,Pi.mul_apply,profile]
   ring
 · dsimp only [profile]
   rw [real_smul]
   push_cast
   ring

/-- The actual one-sided source mean has the FTC-generated derivative, without a free boundary trace. -/
theorem actual_tail_quarter_mean_derivative (coordinate : BurnolCompletedMellinCoordinate) :
 HasDerivWithinAt (fun time : ℝ=>Paid.actualMean (burnolMultiplicativeDilation (-time/2)
   (burnolRadiusNormalizedUnitTail coordinate q (by norm_num))))
 (((2*q:ℝ):ℂ)*(q:ℂ)^(-coordinate.value)) (Iic 0) 0 := by
 apply (actual_tail_quarter_orbit_FTC coordinate).hasDerivWithinAt.congr_of_mem
 · intro time nonpositive
   exact actual_tail_quarter_orbit coordinate time nonpositive
 · exact self_mem_Iic

/-- The original position source controls the actual R mean by its own compact and generated tail stocks. -/
theorem actual_position_quarter_mean_action (h : ℝ) (nonnegative : 0≤h) :
 ((OriginalKCombCofinalTwoDirection.coordinate observation nontrivial half).value/2-1/2)*
 Paid.actualMean (OriginalKFullSourceRResponse.Op.R observation nontrivial half
   (OriginalKInsideDebtRSource.actualInsidePosition observation nontrivial half h))=
 OriginalKInsideDebtRSource.actualPositionTailCoefficient observation nontrivial half h*
   (((2*q:ℝ):ℂ)*(q:ℂ)^(-(OriginalKCombCofinalTwoDirection.coordinate observation nontrivial half).value))-
 Paid.actualMean (OriginalKInsideDebtRSource.actualInsidePosition observation nontrivial half h) := by
 let coordinate:=OriginalKCombCofinalTwoDirection.coordinate observation nontrivial half
 let material:=OriginalKInsideDebtRSource.actualInsidePosition observation nontrivial half h
 let acted:=OriginalKFullSourceRResponse.Op.R observation nontrivial half material
 let inside:=originalPhysicalCutoff q acted
 let coefficient:=OriginalKInsideDebtRSource.actualPositionTailCoefficient observation nontrivial half h
 have supported : originalPhysicalCutoff q inside=inside := by
  unfold inside originalPhysicalCutoff
  rw [burnolRadiusRestriction_zeroExtension]
 have decomposition : acted=inside+coefficient • burnolRadiusNormalizedUnitTail coordinate q (by norm_num) :=
  OriginalKInsideDebtRSource.actual_position_R_rank_decomposition observation nontrivial half h nonnegative
 have mean : Paid.actualMean acted=Paid.actualMean inside := by
  have source:=congrArg Paid.actualMean decomposition
  rw [map_add,map_smul,actual_tail_quarter_mean coordinate q (by norm_num) le_rfl,
    intervalIntegral.integral_same,mul_zero,smul_zero,add_zero] at source
  exact source
 have compactDerivative : HasDerivAt (fun time : ℝ=>(Real.exp (time/4):ℂ)*Paid.actualMean inside)
   ((1/4:ℂ)*Paid.actualMean inside) 0 := by
  have source:=((hasDerivAt_id (0:ℝ)).div_const 4).exp
  have complex:=Complex.ofRealCLM.hasFDerivAt.comp_hasDerivAt 0 source
  have generated:=complex.mul_const (Paid.actualMean inside)
  convert! generated using 1
  norm_num
 have sourceDerivative : HasDerivWithinAt (fun time : ℝ=>Paid.actualMean
   (burnolMultiplicativeDilation (-time/2) acted))
   ((1/4:ℂ)*Paid.actualMean inside+coefficient*(((2*q:ℝ):ℂ)*(q:ℂ)^(-coordinate.value))) (Iic 0) 0 := by
  apply (compactDerivative.hasDerivWithinAt.add
    (HasDerivWithinAt.const_mul coefficient (actual_tail_quarter_mean_derivative coordinate))).congr_of_mem
  · intro time nonpositive
    have source:=congrArg (fun material : BurnolL2=>Paid.actualMean (burnolMultiplicativeDilation (-time/2) material)) decomposition
    simp only [map_add,map_smul,smul_eq_mul] at source
    rw [actual_compact_positive_mean inside supported (-time/2) (by change time≤0 at nonpositive;linarith)] at source
    rw [show -(-time/2)/2=time/4 by ring] at source
    exact source
  · exact self_mem_Iic

 have right : 1/4<(coordinate.value/2).re := by
  rw [Complex.div_re];norm_num;linarith [coordinate.rightHalf]
 have strong:=(actual_R_mean_orbit (coordinate.value/2) right material).hasDerivWithinAt (s:=Iic 0)
 have equation:=(uniqueDiffWithinAt_Iic (0:ℝ)).eq_deriv (Iic 0) sourceDerivative strong
 rw [←mean] at equation
 change (1/4:ℂ)*Paid.actualMean acted+coefficient*(((2*q:ℝ):ℂ)*(q:ℂ)^(-coordinate.value))=
   (coordinate.value/2-1/4)*Paid.actualMean acted+Paid.actualMean material at equation
 linear_combination -equation



