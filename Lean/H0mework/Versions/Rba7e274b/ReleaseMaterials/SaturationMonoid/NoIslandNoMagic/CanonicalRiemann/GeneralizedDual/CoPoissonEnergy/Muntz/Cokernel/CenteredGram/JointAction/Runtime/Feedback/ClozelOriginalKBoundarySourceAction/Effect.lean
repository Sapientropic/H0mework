def actualCorrectedVelocityIntegral (coordinate : BurnolCompletedMellinCoordinate) (h : ℝ) : BurnolL2 :=
  (∫ t : ℝ in (0 : ℝ)..h, burnolMultiplicativeDilation t (Source.velocity coordinate)) +
  (∫ t : ℝ in (0 : ℝ)..(-h), burnolMultiplicativeDilation t (Source.velocity coordinate))

def actualSeedBoundaryIncrement (h : ℝ) : BurnolPaAmbientCarrier :=
  P (pairedBurnolMultiplicativeDilation h Source.seed - Source.seed)
def actualFourierSeedBoundaryIncrement (h : ℝ) : BurnolPaAmbientCarrier :=
  P (pairedBurnolMultiplicativeDilation h (fourierL2 Source.seed) - fourierL2 Source.seed)

def actualBoundaryProgramme (coordinate : BurnolCompletedMellinCoordinate) (h : ℝ) : BurnolPaAmbientCarrier :=
  (pairedMellinTranslationCharacter coordinate.value h - 1) • burnolCompletedMellinRieszVector coordinate -
    (1 / 2 : ℂ) • P (actualCorrectedVelocityIntegral coordinate h) -
    OriginalRieszSource.Kernel.A coordinate • actualSeedBoundaryIncrement h +
    OriginalRieszSource.Kernel.beta coordinate • actualFourierSeedBoundaryIncrement h

/-- The born two-contact source generates its actual paired orbit before the dependent physical face. -/
theorem actual_corrected_paired_source_action (coordinate : BurnolCompletedMellinCoordinate) (h : ℝ) :
    pairedBurnolMultiplicativeDilation h (Source.value coordinate) =
      Source.value coordinate + (1 / 2 : ℂ) • actualCorrectedVelocityIntegral coordinate h := by
  unfold pairedBurnolMultiplicativeDilation actualCorrectedVelocityIntegral
  simp only [smul_apply, add_apply]
  change (1 / 2 : ℂ) • (burnolMultiplicativeDilation h (Source.value coordinate) +
    burnolMultiplicativeDilation (-h) (Source.value coordinate)) = _
  rw [actual_corrected_source_finite_action coordinate h, actual_corrected_source_finite_action coordinate (-h)]
  module

private theorem actual_paired_physical_restriction (coordinate : BurnolCompletedMellinCoordinate) (h : ℝ) :
    burnolPairedAmbientCompression h (burnolCompletedMellinRieszVector coordinate) =
      P (pairedBurnolMultiplicativeDilation h (burnolCompletedMellinRieszVector coordinate : BurnolL2)) := by
  unfold burnolPairedAmbientCompression evenBurnolMultiplicativeCompression SourceGeneratedCompressedUnitaryDefectPort.compression pairedBurnolMultiplicativeDilation
  simp only [ContinuousLinearMap.comp_apply, smul_apply, add_apply, Submodule.subtypeL_apply, map_smul, map_add]
  rfl

/-- Literal original B is generated by the corrected full source and both actual moving seed contacts. -/
theorem actual_boundary_programme_realizes (coordinate : BurnolCompletedMellinCoordinate)
    (zero : riemannZeta coordinate.value = 0) (h : ℝ) :
    actualBoundaryProgramme coordinate h = burnolZeroPairedFixedAnnulusBoundary coordinate zero h := by
  have action := actual_corrected_paired_source_action coordinate h
  have raw := congrArg P action
  unfold Source.value at raw
  unfold pairedBurnolMultiplicativeDilation at raw
  simp only [smul_apply, add_apply, map_add, map_sub, map_smul] at raw
  have kernel : P (burnolCompletedMellinRieszVector coordinate : BurnolL2) =
      burnolCompletedMellinRieszVector coordinate :=
    Submodule.orthogonalProjectionOnto_mem_subspace_eq_self _
  rw [kernel] at raw
  unfold actualBoundaryProgramme actualSeedBoundaryIncrement actualFourierSeedBoundaryIncrement
    burnolZeroPairedFixedAnnulusBoundary
  change _ = pairedMellinTranslationCharacter coordinate.value h • burnolCompletedMellinRieszVector coordinate -
    burnolPairedAmbientCompression h (burnolCompletedMellinRieszVector coordinate)
  rw [actual_paired_physical_restriction]
  unfold pairedBurnolMultiplicativeDilation
  simp only [smul_apply, add_apply, map_add, map_sub, map_smul]
  linear_combination (norm := module) raw

