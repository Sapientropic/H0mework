/-- The actual Fourier correction is generated by the same seed-response source field and its paid even parity. -/
theorem actual_Fourier_gap_correction_field :
 fourierL2 actualGapSourceCorrection=burnolQuarterZeroExtension (g:BurnolQuarterIntervalL2)-
  fourierL2 (burnolQuarterZeroExtension (T g:BurnolQuarterIntervalL2)) :=by
 unfold actualGapSourceCorrection
 rw [map_sub,fourierL2_fourierL2]
 change reflectL2 (burnolRadiusZeroExtension q (g:BurnolQuarterIntervalL2))-_=_
 rw [burnolRadiusZeroExtension_reflect,OriginalKGapProjectionEulerSource.actual_gap_response_even]
 rfl

/-- The full Fourier correction Gram consumes the actual same inverse forcing, with no Fourier mean inserted. -/
theorem actual_kernel_Fourier_gap_correction_Gram (c : BurnolCompletedMellinCoordinate) :
 inner ℂ (OriginalRieszSourceGreen.sourceCorrection c) (fourierL2 actualGapSourceCorrection)=
 -inner ℂ (T (b c)) Sg :=by
 have crossed:inner ℂ (fourierL2 (burnolQuarterZeroExtension (b c:BurnolQuarterIntervalL2)))
  (burnolQuarterZeroExtension (g:BurnolQuarterIntervalL2))=inner ℂ (T (b c)) g :=by
  calc
   _=star (inner ℂ (burnolQuarterZeroExtension (g:BurnolQuarterIntervalL2))
    (fourierL2 (burnolQuarterZeroExtension (b c:BurnolQuarterIntervalL2)))) :=(inner_conj_symm _ _).symm
   _=star (inner ℂ g (T (b c))) :=by rw [OriginalRieszSourceGreen.extension_fourier_pairing]
   _=_ :=inner_conj_symm _ _
 have paired:inner ℂ (b c) (T g)=inner ℂ (T (b c)) g :=
  (OriginalRieszSourceGreen.meanZero_fourier_pairing_of_reflection (b c) g
   OriginalKGapProjectionEulerSource.actual_gap_response_even).symm
 rw [actual_Fourier_gap_correction_field]
 unfold OriginalRieszSourceGreen.sourceCorrection
 rw [inner_sub_left,inner_sub_right,inner_sub_right,crossed,fourierL2.inner_map_map,
  OriginalRieszSourceGreen.quarter_extension_inner,OriginalRieszSourceGreen.quarter_extension_inner,
  OriginalRieszSourceGreen.extension_fourier_pairing]
 have gapEq:g-T (T g)=Sg:=OriginalKGapProjectionEulerSource.actual_gap_response_equation
 rw [←gapEq,inner_sub_right]
 change (inner ℂ (T (b c)) g-inner ℂ (b c) (T g))-
  (inner ℂ (T (b c)) g-inner ℂ (T (b c)) (T (T g)))=_
 rw [paired]
 ring

/-- The original ambient gap/tail is read by the literal Fourier seed before any physical target mean. -/
theorem actual_gap_Fourier_seed_input (c : BurnolCompletedMellinCoordinate) :
 inner ℂ (OriginalRieszSourceGreen.gapState c) (fourierL2 s)=
 (1/2:ℂ)*star (OriginalRieszSource.Translator.ForcingMeanZero.mean c) :=by
 have paired:inner ℂ (fourierL2 (OriginalRieszSourceGreen.gapState c)) s=
  inner ℂ (OriginalRieszSourceGreen.gapState c) (fourierL2 s) :=by
  have fixed:fourierL2 (fourierL2 s)=s :=by
   rw [fourierL2_fourierL2,OriginalKGapProjectionEulerSource.actual_seed_even]
  have source:=fourierL2.inner_map_map (OriginalRieszSourceGreen.gapState c) (fourierL2 s)
  rw [fixed] at source
  exact source
 rw [←paired]
 have restriction:inner ℂ (fourierL2 (OriginalRieszSourceGreen.gapState c)) s=
  inner ℂ (burnolQuarterRestriction (fourierL2 (OriginalRieszSourceGreen.gapState c))) (intervalConstant q) :=
  ContinuousLinearMap.adjoint_inner_right burnolQuarterRestriction _ _
 rw [restriction]
 have rawMean:burnolQuarterMeanCoefficient (burnolQuarterRestriction (fourierL2 (OriginalRieszSourceGreen.gapState c)))=
  OriginalRieszSource.Translator.ForcingMeanZero.mean c :=by
  unfold OriginalRieszSourceGreen.gapState OriginalRieszSource.Translator.ForcingMeanZero.mean
  rw [fourierL2_burnolAmbientEvenPart]
 have normSource:((‖intervalConstant q‖:ℝ):ℂ)^2=(1/2:ℂ) :=by
  have native:=burnolIntervalConstant_norm_sq (by norm_num : (0:ℝ)<q)
  norm_num at native
  exact native
 have meanRead : inner ℂ (intervalConstant q)
  (burnolQuarterRestriction (fourierL2 (OriginalRieszSourceGreen.gapState c)))=
  (1/2:ℂ)*OriginalRieszSource.Translator.ForcingMeanZero.mean c :=by
  unfold burnolQuarterMeanCoefficient at rawMean
  rw [Complex.ofReal_pow,normSource] at rawMean
  have actual:=(div_eq_iff (by norm_num : (1/2:ℂ)≠0)).mp rawMean
  linear_combination actual
 have conjugate:=congrArg star meanRead
 have halfStar:star (1/2:ℂ)=(1/2:ℂ) :=by norm_num
 rw [star_mul,halfStar] at conjugate
 have actualConjugate : (starRingEnd ℂ) (inner ℂ (intervalConstant q)
  (burnolQuarterRestriction (fourierL2 (OriginalRieszSourceGreen.gapState c))))=
  (1/2:ℂ)*star (OriginalRieszSource.Translator.ForcingMeanZero.mean c) :=by
  simpa only [starRingEnd_apply,mul_comm] using conjugate
 exact ((inner_conj_symm (burnolQuarterRestriction (fourierL2 (OriginalRieszSourceGreen.gapState c))) (intervalConstant q)).symm).trans actualConjugate

/-- The second physical mean is generated by the actual return/forcing source equation and complete seed correction inventory. -/
theorem actual_original_Fourier_gap_kernel_Gram (c : BurnolCompletedMellinCoordinate) :
 (c.value-1)*inner ℂ (K c) (Fphysical G)=
 (1/2:ℂ)*(star (OriginalRieszSource.Kernel.beta c)*Gap.actualGapA-
  star (OriginalRieszSource.Kernel.A c)*Gap.actualGapBeta) :=by
 have sourceSplit:=congrArg fourierL2 actual_original_gap_source_split
 simp only [map_smul,map_add] at sourceSplit
 have source:=congrArg (fun right:BurnolL2=>inner ℂ (OriginalRieszSourceGreen.gapState c) right) sourceSplit
 rw [OriginalRieszSourceGreen.gapState_eq_kernel_add_correction] at source
 simp only [inner_add_left,inner_add_right,inner_smul_right] at source
 have bOrthogonal:inner ℂ (OriginalRieszSourceGreen.sourceCorrection c) (fourierL2 (G:BurnolL2))=0 :=by
  rw [OriginalRieszSourceGreen.sourceCorrection_eq_generated]
  exact burnolAmbientEvenMeanZeroCorrection_inner_physical_eq_zero _ (Fphysical G)
 have gOrthogonal:inner ℂ (K c:BurnolL2) (fourierL2 actualGapSourceCorrection)=0 :=by
  have moved:=OriginalKGapProjectionEulerSource.actual_source_fourier_input actualGapSourceCorrection (K c)
  change inner ℂ (fourierL2 actualGapSourceCorrection) (K c:BurnolL2)=
   inner ℂ actualGapSourceCorrection (Fphysical (K c):BurnolL2) at moved
  rw [actual_gap_correction_physical_orthogonal] at moved
  exact inner_eq_zero_symm.mp moved
 rw [bOrthogonal,gOrthogonal,actual_kernel_Fourier_gap_correction_Gram] at source
 rw [←inner_add_left,←OriginalRieszSourceGreen.gapState_eq_kernel_add_correction,actual_gap_Fourier_seed_input] at source
 have green:=actual_kernel_return_gap_source_Green c
 unfold Gap.actualGapA Gap.actualGapBeta
 change (c.value-1)*inner ℂ (K c:BurnolL2) (fourierL2 (G:BurnolL2))=_
 linear_combination -(c.value-1)*source-2*green

