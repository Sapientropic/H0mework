/-- The target foot is generated by the true adjoint and opposite Fourier source action. -/
theorem actual_physical_gap_R_prices (coordinate : BurnolCompletedMellinCoordinate)
 (left : BurnolPaAmbientCarrier) :
 inner ℂ (left:BurnolL2) (burnolDirectRightResolvent (coordinate.value/2)
  (OriginalRieszFiniteSynthesis.gapMeanVector:BurnolL2))=
 star (actualFourierGapRPrice (OriginalKQuarterTailPhysicalSource.actualStarSource coordinate)
  (evenFaceFourierEquiv burnolUnscaledCommonGapRadius left)) ∧
 inner ℂ (left:BurnolL2) (burnolDirectRightResolvent (coordinate.value/2)
  (fourierL2 (OriginalRieszFiniteSynthesis.gapMeanVector:BurnolL2)))=
 star (actualGapRPrice (OriginalKQuarterTailPhysicalSource.actualStarSource coordinate)
  (evenFaceFourierEquiv burnolUnscaledCommonGapRadius left)) :=by
 let dual:=OriginalKQuarterTailPhysicalSource.actualStarSource coordinate
 let Fleft:=evenFaceFourierEquiv burnolUnscaledCommonGapRadius left
 let G:=OriginalRieszFiniteSynthesis.gapMeanVector
 have twiceLeft:fourierL2 (fourierL2 (left:BurnolL2))=(left:BurnolL2):=by
  rw [fourierL2_fourierL2]
  exact mem_evenL2ClosedFace_iff.mp left.property.2
 have twiceG:fourierL2 (fourierL2 (G:BurnolL2))=(G:BurnolL2):=by
  rw [fourierL2_fourierL2]
  exact mem_evenL2ClosedFace_iff.mp G.property.2
 have first:=OriginalKCompactAdjointRSource.actual_compact_F_R_physical_action coordinate
  (fourierL2 (left:BurnolL2)) G
 have second:=OriginalKCompactAdjointRSource.actual_compact_F_R_physical_action coordinate
  (fourierL2 (left:BurnolL2)) (evenFaceFourierEquiv burnolUnscaledCommonGapRadius G)
 change inner ℂ (fourierL2 (fourierL2 (left:BurnolL2)))
  (burnolDirectRightResolvent (coordinate.value/2) (G:BurnolL2))=
  inner ℂ (burnolDirectRightResolvent (dual.value/2) (Fleft:BurnolL2)) (fourierL2 (G:BurnolL2)) at first
 change inner ℂ (fourierL2 (fourierL2 (left:BurnolL2)))
  (burnolDirectRightResolvent (coordinate.value/2) (fourierL2 (G:BurnolL2)))=
  inner ℂ (burnolDirectRightResolvent (dual.value/2) (Fleft:BurnolL2))
   (fourierL2 (fourierL2 (G:BurnolL2))) at second
 rw [twiceLeft] at first second
 rw [twiceG] at second
 conv at first => rhs;rw [←inner_conj_symm]
 conv at second => rhs;rw [←inner_conj_symm]
 rw [actual_fourier_gap_R_source_price dual Fleft] at first
 rw [actual_gap_R_source_price dual Fleft] at second
 exact ⟨first,second⟩

