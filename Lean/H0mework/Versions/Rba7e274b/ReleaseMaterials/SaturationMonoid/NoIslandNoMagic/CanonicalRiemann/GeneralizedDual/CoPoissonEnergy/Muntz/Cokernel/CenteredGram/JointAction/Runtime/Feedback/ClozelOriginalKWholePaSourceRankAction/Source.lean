  simpa only [actualWholePaR,OriginalKCombCofinalRAction.original_R_direct] using generated

/-- The original whole source R effect splits through its own actual Pa/nonPa occurrence before any Outside price. -/
theorem actual_whole_R_Pa_nonPa (h : ℝ) :
    OriginalKFullSourceRResponse.Op.R observation nontrivial half
      (OriginalKFullSourceRResponse.completeSource observation nontrivial half h) =
      actualWholePaR observation nontrivial half h + actualNonPaR observation nontrivial half h := by
  unfold actualWholePaR actualNonPaR actualNonPaSource
  rw [map_sub]
  module

