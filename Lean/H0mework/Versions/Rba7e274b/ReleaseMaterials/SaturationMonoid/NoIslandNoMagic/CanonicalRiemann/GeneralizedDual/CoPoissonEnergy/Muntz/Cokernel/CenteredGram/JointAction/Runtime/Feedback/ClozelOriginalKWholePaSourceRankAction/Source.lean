/-- This actual Pa stock is generated by the existing source projection, before its R effect or any price. -/
theorem actual_whole_Pa_source_qualified (h : ℝ) :
    actualWholePaSource observation nontrivial half h ∈ burnolCompactCoPoissonClosedRange := by
  exact Submodule.starProjection_apply_mem _ _

/-- The complete actual stock consumes the same previously generated Pa source conservation, including both B-Pa and wave. -/
theorem actual_whole_Pa_source_inventory (h : ℝ) (nonnegative : 0 ≤ h) (bounded : h ≤ Real.log 2) :
    actualWholePaSource observation nontrivial half h =
    (2*OriginalCommonInverseForcing.SourceJoint.upperSeedFactor h) •
      OriginalKPairedResponseGramAction.actualBoundaryPaStock observation nontrivial half h nonnegative bounded +
    OriginalCommonInverseForcing.SourceJoint.upperSourceWaveAmbient c h nonnegative bounded :=
