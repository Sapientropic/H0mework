def responseRaw (coordinate : BurnolCompletedMellinCoordinate) (x : ℝ) : ℂ :=
  (symmetricInterval (1/4:ℝ)).indicator
    (fun y=>OriginalRieszSourceGreen.weightedRaw coordinate y-Kernel.beta coordinate-
      (star coordinate.value-1/2)*burnolRieszSingleFourierSourceRaw coordinate y) x

def responseMobiusRaw (coordinate : BurnolCompletedMellinCoordinate) (x : ℝ) : ℂ :=
  (symmetricInterval 4).indicator
    (fun x=>∑ n ∈ burnolCenteredMobiusCutoffFinset 4,
      FiniteMobiusResolventFlux.coefficient n*responseRaw coordinate (x/(n:ℕ))) x

-- The full finite word is the existing lower producer, with its actual zero total mean generated by u/v.
theorem actual_response_mobius_source (coordinate : BurnolCompletedMellinCoordinate) :
    (FiniteMobiusResolventFlux.M (wholeContactResponse coordinate):ℝ→ℂ)=ᵐ[volume] responseMobiusRaw coordinate := by
  have read := (ae_restrict_iff' (measurableSet_symmetricInterval 4)).mp
    (FiniteMobiusResolventFlux.lower_window_read (wholeContactResponse coordinate))
  have actualSource : ∀ᵐ x : ℝ ∂volume,∀ n : ℕ+,
      wholeContactResponse coordinate (x/(n:ℕ))=responseRaw coordinate (x/(n:ℕ)) := by
    apply ae_all_iff.mpr
    intro n
    have qmp : Measure.QuasiMeasurePreserving (fun x : ℝ=>x/(n:ℕ)) volume volume := by
      simpa only [div_eq_mul_inv,mul_comm,smul_eq_mul] using
        Measure.quasiMeasurePreserving_smul (μ:=(volume:Measure ℝ)) (r:=((n:ℕ):ℝ)⁻¹)
          (inv_ne_zero (by exact_mod_cast n.ne_zero))
    exact qmp.ae_eq (whole_contact_response_read coordinate)
  filter_upwards [read,actualSource,burnolRadiusZeroExtension_coe
      (FiniteMobiusResolventFlux.lowerWindow (wholeContactResponse coordinate))] with x window source extended
  unfold FiniteMobiusResolventFlux.M
  rw [ContinuousLinearMap.comp_apply,extended]
  unfold responseMobiusRaw
  by_cases inside : x∈symmetricInterval 4
  · simp only [indicator_of_mem inside]
    rw [window inside,whole_contact_response_mean coordinate]
    simp only [sub_zero]
    apply Finset.sum_congr rfl
    intro n _
    rw [source n]
  · simp only [indicator_of_notMem inside]

def sourcePrimitiveEta (coordinate : BurnolCompletedMellinCoordinate) : BurnolL2 :=
  fourierL2 (wholeContactResponse coordinate)+
    (wholeReturnEuler coordinate+(star coordinate.value-1/2) • wholeReturn coordinate)-
      (2*(star coordinate.value-1/2)*Kernel.beta coordinate) • OriginalRieszFiniteSource.fourierPrimitive coordinate

 theorem original_eta_actual_response (coordinate : BurnolCompletedMellinCoordinate) :
    FiniteMobiusResolventFlux.S.regularSource coordinate=sourcePrimitiveEta coordinate := by
  rw [original_eta_source]
  have source := congrArg (fun v : BurnolQuarterMeanZeroCarrier=>burnolQuarterZeroExtension (v:BurnolQuarterIntervalL2))
    (Euler.sourceEuler_eq coordinate)
  change wholeSourceEuler coordinate=burnolQuarterZeroExtension
    ((star coordinate.value-1/2) • (burnolRieszSingleFourierSource coordinate:BurnolQuarterIntervalL2)+
      Kernel.A coordinate • (Response.u:BurnolQuarterIntervalL2)-Kernel.beta coordinate • (Response.v:BurnolQuarterIntervalL2)) at source
  simp only [map_sub,map_add,map_smul] at source
  have generated : wholeSourceEuler coordinate-(star coordinate.value-1/2) • originalB coordinate=wholeContactResponse coordinate := by
    rw [source]
    unfold wholeContactResponse contactResponse originalB
    simp only [map_sub,map_smul]
    module
  unfold generatedEta sourcePrimitiveEta
  rw [generated]

