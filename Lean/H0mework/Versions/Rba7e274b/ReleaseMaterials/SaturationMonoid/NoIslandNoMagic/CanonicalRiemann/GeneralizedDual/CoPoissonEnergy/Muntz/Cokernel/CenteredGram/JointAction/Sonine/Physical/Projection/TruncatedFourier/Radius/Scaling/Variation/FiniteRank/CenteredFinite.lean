def finiteReaction (q r : ℝ) (f : H) : H :=
  Q (∫ t : ℝ in q..r,rawReaction t (Q f)) -
    (1/2 : ℂ) • (InnerProductSpace.rankOne ℂ (p r) (p r) f - InnerProductSpace.rankOne ℂ (p q) (p q) f)

-- The entire finite response is generated by boundary c/s and actual constant-column endpoint reactions.
theorem centered_square_finite (q r : ℝ) (qPositive : 0<q) (rPositive : 0<r) (f : H) :
    squareDifference r q f = finiteReaction q r f := by
  rw [squareDifference,sub_apply,actual_centered_square r rPositive,actual_centered_square q qPositive]
  simp only [ContinuousLinearMap.comp_apply,sub_apply,smul_apply]
  unfold finiteReaction
  have actual := full_square_finite q r qPositive rPositive (Q f)
  have projected := congrArg Q actual
  rw [map_sub] at projected
  rw [← projected]
  module

theorem original_inverse_finite_reaction (coordinate : BurnolCompletedMellinCoordinate) (r : ℝ) (positive : 0<r) :
    originalB coordinate-centeredSquare r (originalB coordinate) =
      originalForcing coordinate-finiteReaction (1/4 : ℝ) r (originalB coordinate) := by
  rw [original_source_finite_drive,centered_square_finite (1/4 : ℝ) r (by norm_num) positive]

