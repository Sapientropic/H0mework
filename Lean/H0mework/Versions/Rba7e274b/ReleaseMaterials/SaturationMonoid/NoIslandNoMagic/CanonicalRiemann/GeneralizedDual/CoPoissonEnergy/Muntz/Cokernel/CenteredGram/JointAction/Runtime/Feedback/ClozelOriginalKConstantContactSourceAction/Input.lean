/-- Read only the actual quarter constant, with its own norm and source mean units. -/
theorem actual_constant_seed_input_price (material : BurnolL2) :
 inner ℂ ConstantSource.seed material=(1/2:ℂ)*Paid.actualMean material := by
 have read:=(burnolRadiusRestriction q).adjoint_inner_left material (intervalConstant q)
 change inner ℂ ConstantSource.seed material=inner ℂ (intervalConstant q) (burnolRadiusRestriction q material) at read
 rw [read]
 unfold Paid.actualMean
 simp only [smul_apply,ContinuousLinearMap.comp_apply,smul_eq_mul]
 rw [burnolIntervalConstant_norm_sq (by norm_num : (0:ℝ)<q)]
 norm_num
 ring

theorem actual_Fconstant_seed_input_price (material : BurnolL2) (even : reflectL2 material=material) :
 inner ℂ (fourierL2 ConstantSource.seed) material=(1/2:ℂ)*Paid.actualMean (fourierL2 material) := by
 have twice : fourierL2 (fourierL2 material)=material := by rw [fourierL2_fourierL2,even]
 conv_lhs => rw [←twice]
 rw [fourierL2.inner_map_map]
 exact actual_constant_seed_input_price (fourierL2 material)

