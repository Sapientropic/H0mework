import H0mework.Versions.V2.Arithmetic.RieszGreen.SourceDerivative
import Mathlib.Analysis.SpecialFunctions.Integrals.Basic

set_option autoImplicit false

namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.BurnolPhysicalState
namespace OriginalRieszFinitePairing.CoPoisson.Ward.ForcingPrimitive

open Complex MeasureTheory Set
open scoped Topology
open OriginalRieszSource OriginalRieszSource.Translator OriginalRieszSourceGreen
noncomputable section
local notation "q" => (1 / 4 : ℝ)

def edgePrimitive (coordinate : BurnolCompletedMellinCoordinate) (x : ℝ) : ℂ :=
  ∫ t : ℝ in (0 : ℝ)..x, (t : ℂ) ^ (-star coordinate.value) * Edge.raw q t

def leadingCoefficient (coordinate : BurnolCompletedMellinCoordinate) : ℂ :=
  (q : ℂ) ^ (1 - star coordinate.value) * ForcingWhole.raw coordinate q -
    ForcingWhole.coefficient coordinate * edgePrimitive coordinate q

private theorem edge_integrable (coordinate : BurnolCompletedMellinCoordinate) (a b : ℝ) :
    IntervalIntegrable (fun t : ℝ => (t : ℂ) ^ (-star coordinate.value) * Edge.raw q t) volume a b := by
  have exponent : -1 < (-star coordinate.value).re := by
    simpa only [neg_re, star_def, conj_re] using (neg_lt_neg coordinate.belowOne)
  exact (intervalIntegral.intervalIntegrable_cpow' exponent).mul_continuousOn
    (Edge.raw_continuous q).continuousOn

private theorem weighted_derivative (coordinate : BurnolCompletedMellinCoordinate)
    (x : ℝ) (positive : 0 < x) :
    HasDerivAt (fun t : ℝ => (t : ℂ) ^ (1 - star coordinate.value) * ForcingWhole.raw coordinate t)
      (ForcingWhole.coefficient coordinate * ((x : ℂ) ^ (-star coordinate.value) * Edge.raw q x)) x := by
  have power := burnolMellinTailPower_hasDerivAt (star coordinate.value - 1) positive
  have derivative := power.mul (forcing_raw_hasDerivAt coordinate x positive.ne')
  have firstExponent : -(star coordinate.value - 1) = 1 - star coordinate.value := by ring
  have nextExponent : -(star coordinate.value - 1 + 1) = -star coordinate.value := by ring
  simp only [firstExponent, nextExponent] at derivative
  convert! derivative using 1
  have powerRead : (x : ℂ) ^ (1 - star coordinate.value) =
      (x : ℂ) ^ (-star coordinate.value) * (x : ℂ) := by
    rw [show (1 - star coordinate.value) = -star coordinate.value + 1 by ring,
      Complex.cpow_add _ _ (Complex.ofReal_ne_zero.mpr positive.ne'), Complex.cpow_one]
  rw [powerRead]
  field_simp [Complex.ofReal_ne_zero.mpr positive.ne']
  ring

/-- The original weak forcing equation computes its Mellin primitive including the q endpoint. -/
theorem weighted_forcing (coordinate : BurnolCompletedMellinCoordinate)
    (x : ℝ) (positive : 0 < x) :
    (x : ℂ) ^ (1 - star coordinate.value) * ForcingWhole.raw coordinate x =
      leadingCoefficient coordinate + ForcingWhole.coefficient coordinate * edgePrimitive coordinate x := by
  have integrated := intervalIntegral.integral_eq_sub_of_hasDerivAt
    (fun t inside => weighted_derivative coordinate t
      ((lt_min positive (by norm_num : (0 : ℝ) < q)).trans_le inside.1))
    ((edge_integrable coordinate x q).const_mul (ForcingWhole.coefficient coordinate))
  rw [intervalIntegral.integral_const_mul] at integrated
  have adjacent := intervalIntegral.integral_add_adjacent_intervals
    (edge_integrable coordinate 0 x) (edge_integrable coordinate x q)
  unfold leadingCoefficient edgePrimitive
  linear_combination integrated - ForcingWhole.coefficient coordinate * adjacent

/-- The singular coefficient and the regular edge integral are generated by the original forcing. -/
theorem forcing_read (coordinate : BurnolCompletedMellinCoordinate)
    (x : ℝ) (positive : 0 < x) :
    ForcingWhole.raw coordinate x =
      leadingCoefficient coordinate * (x : ℂ) ^ (star coordinate.value - 1) +
      ForcingWhole.coefficient coordinate * (x : ℂ) ^ (star coordinate.value - 1) *
        edgePrimitive coordinate x := by
  have generated := congrArg ((x : ℂ) ^ (star coordinate.value - 1) * ·)
    (weighted_forcing coordinate x positive)
  have inverse : (x : ℂ) ^ (star coordinate.value - 1) *
      (x : ℂ) ^ (1 - star coordinate.value) = 1 := by
    rw [← Complex.cpow_add _ _ (Complex.ofReal_ne_zero.mpr positive.ne'),
      show (star coordinate.value - 1) + (1 - star coordinate.value) = 0 by ring,
      Complex.cpow_zero]
  rw [← mul_assoc, inverse, one_mul] at generated
  exact generated.trans (by ring)

/-- The same canonical b keeps its original mean and its complete Fourier return. -/
theorem original_source_read (coordinate : BurnolCompletedMellinCoordinate)
    (x : ℝ) (positive : 0 < x) :
    burnolRieszSingleFourierSourceRaw coordinate x =
      leadingCoefficient coordinate * (x : ℂ) ^ (star coordinate.value - 1) +
      ForcingWhole.coefficient coordinate * (x : ℂ) ^ (star coordinate.value - 1) *
        edgePrimitive coordinate x - ForcingMeanZero.mean coordinate +
      Constructor.secondReturnRaw coordinate x := by
  change burnolRieszFourierForcingRaw coordinate x + Constructor.secondReturnRaw coordinate x = _
  rw [ForcingMeanZero.forcingRaw_eq, forcing_read coordinate x positive]

end
