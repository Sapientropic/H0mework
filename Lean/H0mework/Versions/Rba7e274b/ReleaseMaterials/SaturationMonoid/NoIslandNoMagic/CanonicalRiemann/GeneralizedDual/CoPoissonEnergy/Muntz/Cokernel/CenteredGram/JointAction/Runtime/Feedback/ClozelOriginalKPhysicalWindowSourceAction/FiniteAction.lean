/-- Finite expanding action generated by the complete source profile, including the original initial mean. -/
def actualPhysicalPairedGeneratedWindow (h t : ℝ) : ℂ :=
  (Real.exp (-t/2) : ℂ) * (actualPhysicalPairedMovingWindow observation nontrivial half h 0 +
    ∫ s in (0 : ℝ)..t, (Real.exp s : ℂ) * actualPhysicalPairedOuterRaw observation nontrivial half h (Real.exp s/4))

def actualPhysicalSiblingGeneratedWindow (h t : ℝ) : ℂ :=
  (Real.exp (-t/2) : ℂ) * (actualPhysicalSiblingMovingWindow observation nontrivial half h 0 +
    ∫ s in (0 : ℝ)..t, (Real.exp s : ℂ) * actualPhysicalSiblingOuterRaw observation nontrivial half h (Real.exp s/4))

private theorem source_window_finite_action (window outer : ℝ → ℂ)
    (windowContinuous : Continuous window) (outerContinuous : ContinuousOn outer (Ioi 0))
    (sourceAction : ∀ t : ℝ, 0 < t → HasDerivAt window
      (-window t/2+(Real.exp (t/2) : ℂ)*outer (Real.exp t/4)) t)
    (t : ℝ) (nonnegative : 0 ≤ t) :
    window t = (Real.exp (-t/2) : ℂ) * (window 0 +
      ∫ s in (0 : ℝ)..t, (Real.exp s : ℂ)*outer (Real.exp s/4)) := by
  let action := fun s : ℝ => (Real.exp (s/2) : ℂ)*window s
  let velocity := fun s : ℝ => (Real.exp s : ℂ)*outer (Real.exp s/4)
  have continuousAction : Continuous action := by
    exact (Complex.continuous_ofReal.comp (Real.continuous_exp.comp (continuous_id.div_const 2))).mul windowContinuous
  have continuousVelocity : Continuous velocity := by
    have profile : Continuous (fun s : ℝ => outer (Real.exp s/4)) := by
      apply outerContinuous.comp_continuous (Real.continuous_exp.div_const 4)
      intro s
      exact div_pos (Real.exp_pos s) (by norm_num)
    exact (Complex.continuous_ofReal.comp Real.continuous_exp).mul profile
  have strong : ∀ s ∈ Ioo 0 t, HasDerivAt action (velocity s) s := by
    intro s inside
    have weight := ((hasDerivAt_id s).div_const 2).exp.ofReal_comp
    have generated := weight.mul (sourceAction s inside.1)
    have exponents : (Real.exp (s/2) : ℂ)*(Real.exp (s/2) : ℂ) = (Real.exp s : ℂ) := by
      rw [← Complex.ofReal_mul, ← Real.exp_add]
      congr 2
      ring
    have price : ((Real.exp (s/2)*(1/2) : ℝ) * window s) +
        (Real.exp (s/2) : ℂ)*(-window s/2+(Real.exp (s/2) : ℂ)*outer (Real.exp s/4)) = velocity s := by
      dsimp only [velocity]
      simp only [Complex.ofReal_mul,Complex.ofReal_div,Complex.ofReal_one,Complex.ofReal_ofNat]
      rw [← exponents]
      ring
    change HasDerivAt action (((Real.exp (s/2)*(1/2) : ℝ) * window s) +
      (Real.exp (s/2) : ℂ)*(-window s/2+(Real.exp (s/2) : ℂ)*outer (Real.exp s/4))) s at generated
    rw [price] at generated
    exact generated
  have integrated := intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le nonnegative
    continuousAction.continuousOn strong (continuousVelocity.intervalIntegrable 0 t)
  have unit : (Real.exp (-t/2) : ℂ)*(Real.exp (t/2) : ℂ) = 1 := by
    rw [← Complex.ofReal_mul, ← Real.exp_add]
    rw [show -t/2+t/2 = (0 : ℝ) by ring, Real.exp_zero, Complex.ofReal_one]
  have generated := congrArg (fun z : ℂ => (Real.exp (-t/2) : ℂ)*z) integrated
  dsimp [action,velocity] at generated
  simp only [zero_div,Real.exp_zero,Complex.ofReal_one,one_mul] at generated
  calc
    window t = (Real.exp (-t/2) : ℂ)*((Real.exp (t/2) : ℂ)*window t) := by rw [← mul_assoc,unit,one_mul]
    _ = (Real.exp (-t/2) : ℂ)*(window 0+∫ s in (0 : ℝ)..t, (Real.exp s : ℂ)*outer (Real.exp s/4)) := by
      linear_combination -generated

/-- The actual source differential action generates the complete finite positive-window effects before their price consumers. -/
theorem actual_physical_moving_window_finite_action (h : ℝ) (nonnegative : 0 ≤ h)
    (bounded : h ≤ Real.log 2) (t : ℝ) (positive : 0 ≤ t) :
    actualPhysicalPairedMovingWindow observation nontrivial half h t =
      actualPhysicalPairedGeneratedWindow observation nontrivial half h t ∧
    actualPhysicalSiblingMovingWindow observation nontrivial half h t =
      actualPhysicalSiblingGeneratedWindow observation nontrivial half h t := by
  have read := actual_physical_moving_window_read observation nontrivial half h nonnegative bounded
  have continuousPair : Continuous (actualPhysicalPairedMovingWindow observation nontrivial half h) := by
    have source := FiniteMobiusResolventFlux.actualMean.continuous.comp
      (burnolMultiplicativeDilation_stronglyContinuous
        (P (OriginalKFullSourceRResponse.pairedResponse observation nontrivial half h) : BurnolL2))
    exact source.congr (fun s => (read s).1)
  have continuousSibling : Continuous (actualPhysicalSiblingMovingWindow observation nontrivial half h) := by
    have source := FiniteMobiusResolventFlux.actualMean.continuous.comp
      (burnolMultiplicativeDilation_stronglyContinuous
        (P (OriginalKFullSourceRResponse.siblingResponse observation nontrivial half h) : BurnolL2))
    exact source.congr (fun s => (read s).2)
  have outside := actual_physical_source_outer_continuous observation nontrivial half h
  exact ⟨source_window_finite_action _ _ continuousPair outside.1
    (fun s positive => (actual_physical_moving_window_action observation nontrivial half h nonnegative bounded s positive).1) t positive,
    source_window_finite_action _ _ continuousSibling outside.2
    (fun s positive => (actual_physical_moving_window_action observation nontrivial half h nonnegative bounded s positive).2) t positive⟩

