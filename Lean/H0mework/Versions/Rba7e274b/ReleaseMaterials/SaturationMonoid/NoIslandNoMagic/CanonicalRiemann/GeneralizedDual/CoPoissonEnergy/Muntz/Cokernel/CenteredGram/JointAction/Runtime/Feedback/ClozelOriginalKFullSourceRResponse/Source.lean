local instance responseAmbientComplete : CompleteSpace BurnolPaAmbientCarrier := by
  apply IsComplete.completeSpace_coe
  exact (evenBurnolClosedFace burnolUnscaledCommonGapRadius).isClosed.isComplete
variable (observation : GeneratedRiemannZeroObservation)
variable (nontrivial : ¬∃ n:Nat,observation.coordinate=-2*(n+1))
variable (half : OriginalKCombCalculation.Half observation)

/-- This is the literal raw correction and both mean debts. Its R action does
not borrow physical/Pa membership from the source wave. -/
def completeSource (h : ℝ) : BurnolL2 :=
  Full.upperSourceCorrection (OriginalKCombCofinalTwoDirection.coordinate observation nontrivial half) h+
    Full.upperSeedFactor h •
      (Full.meanDebt (OriginalKCombCofinalTwoDirection.coordinate observation nontrivial half) h : BurnolL2)

def pairedResponse (h : ℝ) : BurnolL2 :=
  Paid.paired (Op.R observation nontrivial half (completeSource observation nontrivial half h))

def siblingResponse (h : ℝ) : BurnolL2 :=
  Paid.sibling (Op.R observation nontrivial half (completeSource observation nontrivial half h))

/-- Both response derivatives are generated by the original R action. Neither
a boundary value nor a desired forcing cancellation is a source argument. -/
theorem actual_source_paired_response (h : ℝ) :
    HasDerivAt (fun t : ℝ=>burnolMultiplicativeDilation (-t/2) (pairedResponse observation nontrivial half h))
      ((observation.coordinate/2-1/4) • siblingResponse observation nontrivial half h+
        (1/2:ℂ) • (completeSource observation nontrivial half h-fourierL2 (completeSource observation nontrivial half h))) 0 ∧
    HasDerivAt (fun t : ℝ=>burnolMultiplicativeDilation (-t/2) (siblingResponse observation nontrivial half h))
      ((observation.coordinate/2-1/4) • pairedResponse observation nontrivial half h+
        (1/2:ℂ) • (completeSource observation nontrivial half h+fourierL2 (completeSource observation nontrivial half h))) 0 := by
  unfold pairedResponse siblingResponse
  rw [RSource.original_R_direct]
  exact Paid.ambient_R_paired_equations _ (RSource.parameter_rightQuarter observation half) _

theorem actual_source_Q_forcing (h : ℝ) :
    HasDerivAt (fun t : ℝ=>Paid.Q (burnolMultiplicativeDilation (-t/2) (pairedResponse observation nontrivial half h)))
      ((observation.coordinate/2-1/4) • Paid.Q (siblingResponse observation nontrivial half h)+
        (1/2:ℂ) • (Paid.Q (completeSource observation nontrivial half h)-
          Paid.Q (fourierL2 (completeSource observation nontrivial half h)))) 0 ∧
    HasDerivAt (fun t : ℝ=>Paid.Q (burnolMultiplicativeDilation (-t/2) (siblingResponse observation nontrivial half h)))
      ((observation.coordinate/2-1/4) • Paid.Q (pairedResponse observation nontrivial half h)+
        (1/2:ℂ) • (Paid.Q (completeSource observation nontrivial half h)+
          Paid.Q (fourierL2 (completeSource observation nontrivial half h)))) 0 := by
  unfold pairedResponse siblingResponse
  rw [RSource.original_R_direct]
  exact Paid.ambient_R_Pa_forcing _ (RSource.parameter_rightQuarter observation half) _

