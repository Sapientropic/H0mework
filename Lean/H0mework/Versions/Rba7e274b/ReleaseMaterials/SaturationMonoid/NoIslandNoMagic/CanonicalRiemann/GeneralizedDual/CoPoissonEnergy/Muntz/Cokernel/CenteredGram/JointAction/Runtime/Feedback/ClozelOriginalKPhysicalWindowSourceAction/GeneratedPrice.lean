def actualPhysicalPairedGeneratedSeedPrice (h t : ℝ) : ℂ :=
  (1/4 : ℂ) * (star ((Real.exp (-t/2) : ℂ)*actualPhysicalPairedMovingWindow observation nontrivial half h 0) +
    star (actualPhysicalPairedGeneratedWindow observation nontrivial half h t) -
    2*star (actualPhysicalPairedMovingWindow observation nontrivial half h 0))

def actualPhysicalSiblingGeneratedSeedPrice (h t : ℝ) : ℂ :=
  (1/4 : ℂ) * (star ((Real.exp (-t/2) : ℂ)*actualPhysicalSiblingMovingWindow observation nontrivial half h 0) +
    star (actualPhysicalSiblingGeneratedWindow observation nontrivial half h t) -
    2*star (actualPhysicalSiblingMovingWindow observation nontrivial half h 0))

/-- The four actual source contact consumers use the finite effects generated by source differential action, not a separately named window integral. -/
theorem actual_physical_four_generated_contact_price (h : ℝ) (nonnegative : 0 ≤ h) (bounded : h ≤ Real.log 2)
    (t : ℝ) (positive : 0 ≤ t) :
    OriginalKBoundarySourceAction.actualSeedWindowPrice
      (P (OriginalKFullSourceRResponse.pairedResponse observation nontrivial half h)) t =
      actualPhysicalPairedGeneratedSeedPrice observation nontrivial half h t ∧
    OriginalKBoundarySourceAction.actualSeedWindowPrice
      (Fphysical (P (OriginalKFullSourceRResponse.pairedResponse observation nontrivial half h))) t =
      actualPhysicalPairedGeneratedSeedPrice observation nontrivial half h t ∧
    OriginalKBoundarySourceAction.actualSeedWindowPrice
      (P (OriginalKFullSourceRResponse.siblingResponse observation nontrivial half h)) t =
      actualPhysicalSiblingGeneratedSeedPrice observation nontrivial half h t ∧
    OriginalKBoundarySourceAction.actualSeedWindowPrice
      (Fphysical (P (OriginalKFullSourceRResponse.siblingResponse observation nontrivial half h))) t =
      -actualPhysicalSiblingGeneratedSeedPrice observation nontrivial half h t := by
  have action := actual_physical_moving_window_finite_action observation nontrivial half h nonnegative bounded t positive
  have source := actual_physical_four_contact_window_price observation nontrivial half h nonnegative bounded t positive
  unfold actualPhysicalPairedSeedPrice actualPhysicalSiblingSeedPrice at source
  rw [action.1, action.2] at source
  exact source

