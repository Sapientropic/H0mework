/-- Same source-generated residual has a direct controlled whole-carrier bound. -/
theorem actual_source_error_bound (n : Nat) :
 ‖OriginalRieszSource.Response.u-actualU n‖≤(1/4:ℝ)^n*‖OriginalRieszSource.Response.u‖ :=by
 rw [actual_source_residual]
 induction n with
 | zero=>simp
 | succ n previous=>
  rw [pow_succ']
  change ‖S ((S^n) OriginalRieszSource.Response.u)‖≤_
  calc
   _≤(1/4:ℝ)*‖(S^n) OriginalRieszSource.Response.u‖:=actual_square_source_norm _
   _≤(1/4:ℝ)*((1/4:ℝ)^n*‖OriginalRieszSource.Response.u‖):=
    mul_le_mul_of_nonneg_left previous (by norm_num)
   _=(1/4:ℝ)^(n+1)*‖OriginalRieszSource.Response.u‖:=by rw [pow_succ];ring

/-- The receiver V face is generated by the same actual S update and retains the same source error. -/
theorem actual_V_source_error_bound (n : Nat) :
 ‖OriginalRieszSource.Response.v-actualV n‖≤(1/2:ℝ)*((1/4:ℝ)^n*‖OriginalRieszSource.Response.u‖) :=by
