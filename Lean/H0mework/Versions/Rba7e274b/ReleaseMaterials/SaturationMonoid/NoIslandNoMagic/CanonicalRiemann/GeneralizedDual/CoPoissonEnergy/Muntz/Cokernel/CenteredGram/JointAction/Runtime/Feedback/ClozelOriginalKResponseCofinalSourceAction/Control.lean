/-- The original source operator pays its own actual contraction; no physical projection norm is transferred. -/
theorem actual_square_source_norm (value : M) : ‖S value‖≤(1/4:ℝ)*‖value‖ :=by
 have first:=burnolMeanZeroTruncatedFourier_norm_le value
 have second:=burnolMeanZeroTruncatedFourier_norm_le (T value)
 change ‖T (T value)‖≤(1/4:ℝ)*‖value‖
