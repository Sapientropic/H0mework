theorem actual_common_source_units (coordinate : BurnolCompletedMellinCoordinate) :
 coordinate.value≠0 ∧ coordinate.value-1≠0 :=by
 constructor
 · intro zero
   have real:=congrArg Complex.re zero
   simp only [Complex.zero_re] at real
   linarith [coordinate.rightHalf]
 · intro zero
   have real:=congrArg Complex.re zero
   norm_num at real
   linarith [coordinate.belowOne]

/-- Only the source coordinate units are inverted; the actual common determinant remains weighted. -/
theorem actual_common_weighted_G_FG (coordinate : BurnolCompletedMellinCoordinate) :
 actualCommonDeterminant coordinate • burnolDirectRightResolvent (coordinate.value/2) (G:BurnolL2)=
 ((coordinate.value-1)⁻¹*2) • actualCommonField coordinate+
 ((coordinate.value-1)⁻¹*((coordinate.value-star coordinate.value)*actualCommonFirst coordinate)) •
  burnolDirectRightResolvent (coordinate.value/2) (K coordinate:BurnolL2)+
 ((coordinate.value-1)⁻¹*((coordinate.value+star coordinate.value-1)*actualCommonSecond coordinate)) •
  burnolDirectRightResolvent (coordinate.value/2) (fourierL2 (K coordinate:BurnolL2)) ∧
 actualCommonDeterminant coordinate • burnolDirectRightResolvent (coordinate.value/2) (fourierL2 (G:BurnolL2))=
 (coordinate.value⁻¹*2) • actualFourierCommonField coordinate+
 (coordinate.value⁻¹*((coordinate.value-star coordinate.value)*actualCommonSecond coordinate)) •
  burnolDirectRightResolvent (coordinate.value/2) (K coordinate:BurnolL2)+
 (coordinate.value⁻¹*((coordinate.value+star coordinate.value-1)*actualCommonFirst coordinate)) •
  burnolDirectRightResolvent (coordinate.value/2) (fourierL2 (K coordinate:BurnolL2)) :=by
 have units:=actual_common_source_units coordinate
 have first:=congrArg (fun field:BurnolL2=>(coordinate.value-1)⁻¹ • field) (actual_common_R_G_field coordinate)
 have second:=congrArg (fun field:BurnolL2=>coordinate.value⁻¹ • field) (actual_common_R_FG_field coordinate)
 simp only [smul_add,smul_smul] at first second
 rw [inv_mul_cancel_left₀ units.2] at first
 rw [inv_mul_cancel_left₀ units.1] at second
 exact ⟨first,second⟩

/-- The exact complete original M material has both original source masses and G faces. -/
theorem actual_literal_M_source (coordinate : BurnolCompletedMellinCoordinate) (h : ℝ) :
 (OriginalKGapMeanRSourceAction.Full.meanDebt coordinate h:BurnolL2)=
 (∫ x:ℝ,OriginalRieszFinitePairing.CoPoisson.positionSeed coordinate h x) • (G:BurnolL2)+
 (∫ x:ℝ,OriginalRieszFinitePairing.CoPoisson.fourierSeed coordinate h x) • fourierL2 (G:BurnolL2) :=by
 unfold OriginalKGapMeanRSourceAction.Full.meanDebt OriginalRieszFiniteSynthesis.gapMeanAdjoint
 simp only [ContinuousLinearMap.toSpanSingleton_apply,map_smul]
 rfl

def actualCommonMField (coordinate : BurnolCompletedMellinCoordinate) (h : ℝ) : BurnolL2:=
 let p:=∫ x:ℝ,OriginalRieszFinitePairing.CoPoisson.positionSeed coordinate h x
 let f:=∫ x:ℝ,OriginalRieszFinitePairing.CoPoisson.fourierSeed coordinate h x
 (p*((coordinate.value-1)⁻¹*2)) • actualCommonField coordinate+
 (f*(coordinate.value⁻¹*2)) • actualFourierCommonField coordinate+
 ((coordinate.value-star coordinate.value)*(p*(coordinate.value-1)⁻¹*actualCommonFirst coordinate+
  f*coordinate.value⁻¹*actualCommonSecond coordinate)) •
  burnolDirectRightResolvent (coordinate.value/2) (K coordinate:BurnolL2)+
 ((coordinate.value+star coordinate.value-1)*(p*(coordinate.value-1)⁻¹*actualCommonSecond coordinate+
  f*coordinate.value⁻¹*actualCommonFirst coordinate)) •
  burnolDirectRightResolvent (coordinate.value/2) (fourierL2 (K coordinate:BurnolL2))

/-- The complete weighted original M response is generated by the two whole source equations; all UV responses cancel before price. -/
theorem actual_common_M_R_source (coordinate : BurnolCompletedMellinCoordinate) (h : ℝ) :
 actualCommonDeterminant coordinate • burnolDirectRightResolvent (coordinate.value/2)
  (OriginalKGapMeanRSourceAction.Full.meanDebt coordinate h:BurnolL2)=
 actualCommonMField coordinate h :=by
 have generated:=actual_common_weighted_G_FG coordinate
 rw [actual_literal_M_source]
 change actualCommonDeterminant coordinate • burnolDirectRightResolventCLM coordinate
  ((∫ x:ℝ,OriginalRieszFinitePairing.CoPoisson.positionSeed coordinate h x) • (G:BurnolL2)+
   (∫ x:ℝ,OriginalRieszFinitePairing.CoPoisson.fourierSeed coordinate h x) • fourierL2 (G:BurnolL2))=_
 rw [map_add,map_smul,map_smul,smul_add]
 change actualCommonDeterminant coordinate •
  ((∫ x:ℝ,OriginalRieszFinitePairing.CoPoisson.positionSeed coordinate h x) •
   burnolDirectRightResolvent (coordinate.value/2) (G:BurnolL2))+
 actualCommonDeterminant coordinate •
  ((∫ x:ℝ,OriginalRieszFinitePairing.CoPoisson.fourierSeed coordinate h x) •
   burnolDirectRightResolvent (coordinate.value/2) (fourierL2 (G:BurnolL2)))=_
 rw [smul_comm (actualCommonDeterminant coordinate),smul_comm (actualCommonDeterminant coordinate),
  generated.1,generated.2]
 unfold actualCommonMField
 module

