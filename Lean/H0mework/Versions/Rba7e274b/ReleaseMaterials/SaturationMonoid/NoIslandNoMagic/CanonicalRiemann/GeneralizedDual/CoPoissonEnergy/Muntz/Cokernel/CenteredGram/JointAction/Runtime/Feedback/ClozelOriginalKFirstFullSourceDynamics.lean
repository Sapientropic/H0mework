theorem first_pair : input observation nontrivial half depth 0 =
    (P.physicalProjection ((P.R observation nontrivial half) ((P.R observation nontrivial half) (P.value observation nontrivial depth half))),
     P.physicalRemainder ((P.R observation nontrivial half) ((P.R observation nontrivial half) (P.value observation nontrivial depth half)))) := by
  have written := congrArg (fun row : (BurnolL2 × BurnolL2) × (BurnolL2 × BurnolL2) => row.1 + row.2)
