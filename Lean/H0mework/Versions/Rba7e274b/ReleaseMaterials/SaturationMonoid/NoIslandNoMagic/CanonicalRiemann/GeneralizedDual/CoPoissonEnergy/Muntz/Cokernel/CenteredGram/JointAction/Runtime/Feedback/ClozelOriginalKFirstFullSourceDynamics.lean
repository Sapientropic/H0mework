  rw [raw_source_iterate, origin]
  have index : ordinal + (generatedRiemannXiZeroOrder ActualAnalyticOwner observation.coordinate + 2) =
      generatedRiemannXiZeroOrder ActualAnalyticOwner observation.coordinate + (ordinal + 2) := by omega
  rw [← Module.End.mul_apply, ← pow_add, index]

