 (type_of% (actual_nonPa_boundary_source_price observation nontrivial half h nonnegative (ordered.trans bounded))) ∧
 (type_of% (actual_nonPa_kernel_cross_original_read observation nontrivial half h)) ∧
 (type_of% (actual_original_cross_rank_nonPa_inventory observation nontrivial half h)) ∧
 (type_of% (actual_original_cross_consumes_nonPa_source_action observation nontrivial half h nonnegative (ordered.trans bounded))) ∧
 (type_of% (actual_current_consumes_nonPa_source_action observation nontrivial half h nonnegative (ordered.trans bounded) n)) ∧
 (type_of% (actual_nonPa_source_character_closure observation nontrivial half h nonnegative (ordered.trans bounded))) ∧
 (type_of% (OriginalKWholePaSourceRankAction.consume_actual_original_whole_Pa_rank_source observation nontrivial half depth ordinal offset within index n shift shiftPositive h nextShift nonnegative ordered bounded test kprice fprice forcingPrice kforcingPrice pairPrice siblingPrice wavePairPrice waveSiblingPrice)) :=
 ⟨actual_nonPa_source_physical observation nontrivial half h,
 actual_nonPa_source_boundary_forcing observation nontrivial half h nonnegative (ordered.trans bounded),
 actual_nonPa_source_fourier observation nontrivial half h,
 actual_nonPa_source_Pa_zero observation nontrivial half h,
 actual_nonPa_R_source_Ward observation nontrivial half h,
 actual_nonPa_physical_forcing_effect observation nontrivial half h,
 actual_nonPa_physical_source_Ward observation nontrivial half h nonnegative (ordered.trans bounded),
 actual_nonPa_boundary_source_price observation nontrivial half h nonnegative (ordered.trans bounded),
 actual_nonPa_kernel_cross_original_read observation nontrivial half h,
 actual_original_cross_rank_nonPa_inventory observation nontrivial half h,
 actual_original_cross_consumes_nonPa_source_action observation nontrivial half h nonnegative (ordered.trans bounded),
