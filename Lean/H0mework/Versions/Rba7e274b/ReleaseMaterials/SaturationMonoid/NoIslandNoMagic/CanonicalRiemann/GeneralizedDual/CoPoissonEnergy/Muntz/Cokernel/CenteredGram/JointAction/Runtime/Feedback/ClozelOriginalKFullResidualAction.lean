theorem split_complete (input : BurnolL2) :
    P.physicalProjection input + P.physicalRemainder input = input :=
  Submodule.starProjection_add_starProjection_orthogonal input

theorem original_branch_value (environment : Env (PairValue C.Value) C.Var) :
    ((P.code observation nontrivial half).eval (FR.physicalInput environment),
      (P.code observation nontrivial half).effect (FR.physicalInput environment) (FR.residualInput environment)) =
        branches observation nontrivial half (environment () ()) := rfl

theorem value_of_original_effect
    (result : (BurnolL2 × BurnolL2) × (BurnolL2 × BurnolL2))
    (environment : Env (PairValue C.Value) C.Var)
    (generated : result = ((P.code observation nontrivial half).eval (FR.physicalInput environment),
      (P.code observation nontrivial half).effect (FR.physicalInput environment) (FR.residualInput environment))) :
    result = branches observation nontrivial half (environment () ()) :=
  generated.trans (original_branch_value observation nontrivial half environment)

theorem residual_read_of_branch (read : BurnolL2 →L[ℂ] ℂ)
    (result : (BurnolL2 × BurnolL2) × (BurnolL2 × BurnolL2)) (expected : BurnolL2)
    (complete : result.2.1 + result.2.2 = expected) :
    read result.2.1 + read result.2.2 = read expected :=
  (map_add read _ _).symm.trans (congrArg read complete)

theorem complete_of_branches (result : (BurnolL2 × BurnolL2) × (BurnolL2 × BurnolL2))
    (input : BurnolL2 × BurnolL2) (generated : result = branches observation nontrivial half input) :
    result.1.1 + result.1.2 = (P.R observation nontrivial half) input.1 ∧
    result.2.1 + result.2.2 = (P.R observation nontrivial half) input.2 ∧
    (result.1.1 + result.1.2) + (result.2.1 + result.2.2) = (P.R observation nontrivial half) (input.1 + input.2) ∧
    ∀ read : BurnolL2 →L[ℂ] ℂ, read result.2.1 + read result.2.2 = read ((P.R observation nontrivial half) input.2) := by
  cases generated
  exact ⟨split_complete _, split_complete _,
    (congrArg₂ (fun left right : BurnolL2 => left + right) (split_complete _) (split_complete _)).trans
      (map_add (P.R observation nontrivial half) _ _).symm,
    fun read => residual_read_of_branch read _ _ (split_complete _)⟩

