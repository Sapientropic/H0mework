-- P.code itself generates both actions; its actual linear syntax pays the residual identity.
theorem original_effect (old increment : Env (PairValue C.Value) C.Var) :
    (P.code observation nontrivial half).effect old increment =
      (P.physicalProjection ((P.R observation nontrivial half) (increment () ()).1),
       P.physicalRemainder ((P.R observation nontrivial half) (increment () ()).1)) := rfl

def branches (input : BurnolL2 × BurnolL2) :=
  ((P.physicalProjection ((P.R observation nontrivial half) input.1),
    P.physicalRemainder ((P.R observation nontrivial half) input.1)),
   (P.physicalProjection ((P.R observation nontrivial half) input.2),
    P.physicalRemainder ((P.R observation nontrivial half) input.2)))

theorem joint_source_value (environment : Env (PairValue (PairValue C.Value)) C.Var) :
    (FR.jointCode (P.code observation nontrivial half)).eval environment =
      branches observation nontrivial half ((FR.completeInput environment) () ()) :=
  (FR.joint_eval (P.code observation nontrivial half) environment).trans rfl

theorem joint_source_budget : remaining (FR.jointCode (P.code observation nontrivial half)) = 4 := rfl

