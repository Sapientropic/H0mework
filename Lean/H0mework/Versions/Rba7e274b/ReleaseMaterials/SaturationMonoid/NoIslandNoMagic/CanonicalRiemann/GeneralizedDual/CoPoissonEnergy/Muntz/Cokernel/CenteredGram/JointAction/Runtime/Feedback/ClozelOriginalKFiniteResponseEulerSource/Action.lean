def actualUEuler (n : Nat) : BurnolQuarterMeanZeroCarrier:=
 EulerPaid.eulerState (actualURaw n) (actualUSlope n)
  (actual_U_raw_continuous n) (actual_U_slope_continuous n)
def actualVEuler (n : Nat) : BurnolQuarterMeanZeroCarrier:=
 EulerPaid.eulerState (actualVRaw n) (actualVSlope n)
