def actualEtaEuler : BurnolQuarterMeanZeroCarrier:=
 EulerPaid.eulerState Profile.etaRaw Profile.etaSlope
  Profile.eta_continuous Profile.eta_slope_continuous

/-- Actual finite U source generates its own endpoint action, before any price is read. -/
theorem actual_U_source_ward (n : Nat) :
 EulerPaid.returnEuler (Prior.actualU n)+T (actualUEuler n)=
 EulerPaid.endpointReaction (actualURaw n) :=
 EulerPaid.meanZero_source_ward _ _ _ (actual_U_raw_continuous n)
  (actual_U_slope_continuous n) (actual_U_derivative n) (actual_U_raw_source n)

/-- The sibling finite source generates the genuine Fourier endpoint response. -/
theorem actual_V_source_ward (n : Nat) :
 EulerPaid.returnEuler (Prior.actualV n)+T (actualVEuler n)=
 EulerPaid.endpointReaction (actualVRaw n) :=
 EulerPaid.meanZero_source_ward _ _ _ (actual_V_raw_continuous n)
  (actual_V_slope_continuous n) (actual_V_derivative n) (actual_V_raw_source n)

/-- Euler state is generated by the finite source eta/T-square update, without an imported limit derivative. -/
theorem actual_finite_U_Euler_step (n : Nat) :
 actualUEuler (n+1)=actualEtaEuler+EulerPaid.returnEuler (Prior.actualV n) :=by
 exact EulerPaid.eulerState_add _ _ _ _ Profile.eta_continuous
  (EulerPaid.meanZeroRaw_continuous _) Profile.eta_slope_continuous
  (EulerPaid.state_derivative_continuous _)

/-- The other Euler leg is the actual return of the same finite U material. -/
theorem actual_finite_V_Euler (n : Nat) :
 actualVEuler n=EulerPaid.returnEuler (Prior.actualU n) :=rfl

/-- The complete finite source Euler drive includes both actual endpoint reactions. -/
theorem actual_finite_Euler_drive (n : Nat) :
 actualUEuler (n+1)-T (T (actualUEuler n))=
 actualEtaEuler+EulerPaid.endpointReaction (actualVRaw n)-
  T (EulerPaid.endpointReaction (actualURaw n)) :=by
 have first:=actual_U_source_ward n
 have second:=actual_V_source_ward n
 rw [actual_finite_U_Euler_step]
 rw [actual_finite_V_Euler] at second
 have returnU:=eq_sub_of_add_eq first
 have returnV:=eq_sub_of_add_eq second
 rw [returnV,returnU,map_sub]
 module

