local notation "q" => (1 / 4 : ℝ)

private theorem actual_source_band_phase (s : ℂ) (h : ℝ) :
    (2 : ℂ) * OriginalCommonInverseForcing.SourceJoint.upperSeedFactor h *
      (-Complex.exp (s * (h : ℂ))) = Complex.exp ((s + 1 / 4) * (h : ℂ)) := by
  unfold OriginalCommonInverseForcing.SourceJoint.upperSeedFactor
  rw [Complex.ofReal_exp]
  push_cast
  calc
    _ = Complex.exp ((h : ℂ) / 4) * Complex.exp (s * (h : ℂ)) := by ring
    _ = _ := by rw [← Complex.exp_add]; congr 1; ring

/-- The literal same-source coefficient is generated by its two actual band actions, including both original contact profiles. -/
theorem actual_original_upper_wave_band_action (coordinate : BurnolCompletedMellinCoordinate)
    (h : ℝ) (nonnegative : 0 ≤ h) (bounded : h ≤ Real.log 2) :
    burnolPaResolventSourceCoefficient coordinate
      (OriginalCommonInverseForcing.SourceJoint.upperSourceWaveAmbient coordinate h nonnegative bounded) =
      actualBandCoefficientAction coordinate h := by
  rw [actual_original_coefficient_band_effect]
  have generated := actual_original_two_band_source_scalings coordinate h nonnegative
  rw [generated.1, generated.2, mul_add, ← mul_assoc, ← mul_assoc,
    actual_source_band_phase, actual_source_band_phase]
  rw [show coordinate.value - 1 / 2 + 1 / 4 = coordinate.value - 1 / 4 by ring,
    show 1 / 2 - coordinate.value + 1 / 4 = 3 / 4 - coordinate.value by ring]
  rfl

/-- The scalar source action at the actual initial band is generated by the two original endpoint contacts. -/
theorem actual_original_wave_band_action_first (coordinate : BurnolCompletedMellinCoordinate) :
    HasDerivAt (actualBandCoefficientAction coordinate)
      ((q : ℂ) * actualPositionBandDensity coordinate q +
        (q : ℂ) * actualFourierBandDensity coordinate q) 0 := by
  have primitive := actual_original_band_primitive_action coordinate
  have initial := actual_original_band_action_initial coordinate
  have positionPhase : DifferentiableAt ℝ
      (fun h : ℝ => Complex.exp ((coordinate.value - 1 / 4) * (h : ℂ))) 0 := by fun_prop
  have fourierPhase : DifferentiableAt ℝ
      (fun h : ℝ => Complex.exp ((3 / 4 - coordinate.value) * (h : ℂ))) 0 := by fun_prop
  have source := (positionPhase.hasDerivAt.mul primitive.1).add
    (fourierPhase.hasDerivAt.mul primitive.2)
  convert! source using 1
  simp only [initial.1, initial.2.1, Complex.ofReal_zero, mul_zero, Complex.exp_zero,
    one_mul, zero_add]

