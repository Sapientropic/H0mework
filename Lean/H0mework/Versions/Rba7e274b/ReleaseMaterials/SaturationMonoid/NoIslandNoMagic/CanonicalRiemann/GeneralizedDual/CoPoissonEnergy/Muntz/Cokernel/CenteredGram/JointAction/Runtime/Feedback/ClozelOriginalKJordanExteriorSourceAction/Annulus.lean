 ∫ time : ℝ in Ioi 0,((time:ℂ)*Complex.exp (-z*(time:ℂ))) • actualExteriorAnnulus time :=by
 let cut:BurnolL2→L[ℂ]BurnolL2:=(burnolRadiusZeroExtension q).comp (burnolRadiusRestriction q)
 have integrable:=Source.actual_resonant_integrable z right Source.seed
 unfold Source.actualJordanSeedExterior Source.actualResonantField
