  (burnolRadiusRestriction q (∫ time:ℝ in Ioi 0,Source.actualResonantIntegrand z Source.seed time))=
  ∫ time:ℝ in Ioi 0,burnolRadiusZeroExtension q
   (burnolRadiusRestriction q (Source.actualResonantIntegrand z Source.seed time)) :=by
  exact (cut.integral_comp_comm integrable).symm
 have projectedIntegrable : IntegrableOn (fun time:ℝ=>burnolRadiusZeroExtension q
