theorem actual_expanding_seed_quarter (time : ℝ) (nonnegative : 0≤time) :
 burnolRadiusRestriction q (actualRadiusSeed (q*Real.exp (time/2)))=intervalConstant q :=by
 have source:=OriginalKJordanSeedFieldSource.actual_seed_negative_quarter_source
   (-time/2) (by linarith)
 rw [actual_seed_expanding_radius_source,map_smul,show (-time/2)/2=-time/4 by ring] at source
 have qualified : (Real.exp (-time/4):ℂ)≠0:=Complex.ofReal_ne_zero.mpr (Real.exp_ne_zero _)
 exact (smul_right_injective _ qualified) source

theorem actual_annulus_quarter (time : ℝ) (nonnegative : 0≤time) :
