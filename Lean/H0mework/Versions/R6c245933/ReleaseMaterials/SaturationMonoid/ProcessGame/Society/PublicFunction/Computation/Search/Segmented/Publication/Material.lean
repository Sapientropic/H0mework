set_option autoImplicit false
set_option maxRecDepth 65536
namespace SaturationMonoid.ProcessGame.Society.PublicFunction.Computation.Search.Segmented.Publication.Material
open Distributed Distributed.Reaction Distributed.Reaction.Feedback
open Distributed.Recall.Information.Agency.Protocol
open Distributed.Recall.Information.Agency.Protocol.Continuation
open Institutions.Capitalism.Universal.Source.Program Institutions.Capitalism.Universal.Root
open Budget.Programme.Debt Budget.Programme.Debt.Information Budget.Programme.Debt.Information.Inquiry
open Budget.Programme.Debt.Information.Inquiry.Replay.Suffix.Window.Whole
open PublicFunction.Protocol.SymbolicAuthentication

variable {Party Good Port Technology Instrument : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Port]
  [DecidableEq Technology] [DecidableEq Instrument]
  (model : Native.Authority.Bound (Party := Party) (Good := Good) (Port := Port)
    (Technology := Technology) (Instrument := Instrument))
  (domain : List (Cursor model.source.code)) (original : Prefix.Rule model.source.code)
  (reference : Program model.source.code (horizon domain))
  (worker receiver : Fin model.source.code.sites)
  (quote : Charge.Quote (Party := Party) (Good := Good) (Port := Port)
    (Technology := Technology) (Instrument := Instrument)) (quotas : List Nat) (slots : Nat)
  (point : View (code := model.source.code)) (rival : Opponent model.source.code) (ordinal : Nat)
  (vocabulary : OwnedAttestation.Vocabulary (Party := Party) (Good := Good) (Port := Port)
    (Technology := Technology) (Instrument := Instrument))
  (encoding : StageTransport.Encoding (code := model.source.code))
  (law : StageReception.Law model.source.code)


abbrev Plan := Selected.Plan model domain original reference worker receiver quote quotas slots point rival ordinal

/-- Physical receipt fields are independent of which source-owned selector
chose the plan. The actual plan remains a dependent index. -/
structure Payload (plan : Plan model domain original reference worker receiver quote quotas slots point rival ordinal) where
  closing : PaidSlot model worker quote rival
  sealed : (Segmented.trace model domain original reference worker quote quotas point rival).closingReceipt = some closing
  receipt : RequestReadback.Receipt (code := model.source.code)
  received : receipt ∈ (Publication.Receipt.observed model domain original reference worker receiver quote quotas slots point rival ordinal vocabulary encoding law plan).receipts
  addressed : Publication.Receipt.Addresses model worker quote rival closing receipt

structure Carrier where
  plan : Plan model domain original reference worker receiver quote quotas slots point rival ordinal
  payload : Payload model domain original reference worker receiver quote quotas slots point rival ordinal vocabulary encoding law plan

structure Pending (plan : Plan model domain original reference worker receiver quote quotas slots point rival ordinal) where
  closing : PaidSlot model worker quote rival
  sealed : (Segmented.trace model domain original reference worker quote quotas point rival).closingReceipt = some closing
  absent : ∀ receipt ∈ (Publication.Receipt.observed model domain original reference worker receiver quote quotas slots point rival ordinal vocabulary encoding law plan).receipts,
    ¬ Publication.Receipt.Addresses model worker quote rival closing receipt

inductive Reception (plan : Plan model domain original reference worker receiver quote quotas slots point rival ordinal) where
  | pending (residual : Pending model domain original reference worker receiver quote quotas slots point rival ordinal vocabulary encoding law plan)
  | delivered (payload : Payload model domain original reference worker receiver quote quotas slots point rival ordinal vocabulary encoding law plan)

/-- Every output is generated by the original paid scan and actual source
send/delivery/local-readback trace; no incoming receipt is trusted as an input. -/
def receive (plan : Plan model domain original reference worker receiver quote quotas slots point rival ordinal) :
    Reception model domain original reference worker receiver quote quotas slots point rival ordinal vocabulary encoding law plan :=
  match found : (Publication.Receipt.observed model domain original reference worker receiver quote quotas slots point rival ordinal vocabulary encoding law plan).receipts.find?
      (fun receipt => decide (Publication.Receipt.Addresses model worker quote rival plan.closing receipt)) with
  | none => .pending ⟨plan.closing,plan.sealed,by
      intro receipt inside
      simpa only [decide_eq_true_eq] using (List.find?_eq_none.mp found) receipt inside⟩
  | some receipt => .delivered ⟨plan.closing,plan.sealed,receipt,List.mem_of_find?_eq_some found,
      of_decide_eq_true (List.find?_some
        (p := fun candidate : RequestReadback.Receipt (code := model.source.code) =>
          decide (Publication.Receipt.Addresses model worker quote rival plan.closing candidate)) found)⟩

variable (record : Carrier model domain original reference worker receiver quote quotas slots point rival ordinal vocabulary encoding law)

theorem every_received_plan_has_real_paid_communication_and_local_readback :
    record.payload.receipt.confirmation ∈ (Publication.Receipt.observed model domain original reference worker receiver quote quotas slots point rival ordinal vocabulary encoding law record.plan).reception.receipts ∧
    record.payload.receipt.statement ∈ RequestAttestation.ledger vocabulary point.point
      (Publication.Receipt.stages model domain original reference worker receiver quote quotas slots point rival ordinal record.plan) ∧
    record.payload.receipt.statement.ballot = record.payload.receipt.confirmation.wire.ballot ∧
    RequestReadback.decode (code := model.source.code) record.payload.receipt.confirmation.wire.signal = some record.payload.receipt.statement.request ∧
    ∃ row, (StageTrace.records point.point (Publication.Receipt.stages model domain original reference worker receiver quote quotas slots point rival ordinal record.plan))[record.payload.receipt.confirmation.index]? = some row ∧
      record.payload.receipt.reading = row.after.frame.inbox receiver ∧ model.source.code.memoryReady record.payload.receipt.reading = true ∧
      RequestReadback.localRead (code := model.source.code) record.payload.receipt.reading = some record.payload.receipt.statement.request :=
  RequestReadback.recovered_requests_have_paid_communication_complete_source_and_local_readback vocabulary encoding law point.point
    (Publication.Receipt.stages model domain original reference worker receiver quote quotas slots point rival ordinal record.plan) receiver _ record.payload.receipt record.payload.received

end SaturationMonoid.ProcessGame.Society.PublicFunction.Computation.Search.Segmented.Publication.Material
