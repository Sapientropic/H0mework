variable {Party Good Port Technology Instrument : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Port]
  [DecidableEq Technology] [DecidableEq Instrument]
  (task : Owned.Task (Party := Party) (Good := Good) (Port := Port)
    (Technology := Technology) (Instrument := Instrument))

abbrev Accepts := Preservation.Accepts task
abbrev Better := Distributed.Improves (Selection.axes (fuel := horizon task.domain) task.model task.domain)
  (Selection.benefit task.model task.domain task.original)

theorem acceptedPath (cache : Inquiry.Frame task) (tail : Complete.FiniteProgram task.model.source.code)
    (accepted : Accepts task cache.programme (Committed.proposal task cache tail)) :
    Preservation.Settles task (Committed.acceptedPath task cache tail accepted) :=
  Preservation.trans task accepted (Preservation.frame_advance task (Committed.commit task cache tail accepted))

theorem drain (count : Nat) (cache : Inquiry.Frame task) :
    Preservation.Settles task (Committed.drain task count cache) := by
  induction count generalizing cache with
  | zero => exact Preservation.stay task cache
  | succ count ih => exact Preservation.append task _ _ (Preservation.frame_advance task cache) (ih _)

/-- This relation is generated by the actual producer. An arbitrary Walk may
carry paths not made by round or stage, so its constructors alone do not suffice. -/
theorem run (compiler : Execution.Compiler task) (count : Nat)
    (sender : Fin task.model.source.code.sites) (cache : Inquiry.Frame task) :
    Preservation.Settles task (Execution.run task compiler count sender cache).path := by
  induction count generalizing cache with
  | zero => exact Preservation.stay task cache
  | succ count ih =>
      unfold Execution.run
      dsimp only
      split
      · exact Preservation.append task _ _ (Preservation.round task sender cache)
          (Preservation.append task _ _ (Preservation.stage task _) (ih _))
      · split
        · exact Preservation.append task _ _ (Preservation.round task sender cache)
            (Preservation.append task _ _ (Preservation.stage task _)
              (Preservation.append task _ _ (Preservation.frame_advance task _) (ih _)))
        · exact Preservation.append task _ _ (Preservation.round task sender cache)
            (Preservation.append task _ _ (Preservation.stage task _)
              (Preservation.append task _ _ (acceptedPath task _ _ _) (ih _)))

/-- Alternatives retain the earlier paid prefix and both original and posterior
admissibility. The final plan need not itself belong to each earlier local pool. -/
def At (cache : Inquiry.Frame task) (final : Program task.model.source.code (horizon task.domain)) : Prop :=
  (∀ tail : Complete.FiniteProgram task.model.source.code,admissible task cache tail →
    ¬ Better task final (wholePlan task cache tail)) ∧
  ((∃ tail : Complete.FiniteProgram task.model.source.code,admissible task cache tail ∧
      Better task cache.programme (wholePlan task cache tail)) → Better task cache.programme final)

theorem choice (cache : Inquiry.Frame task) (selected : Choice task cache)
    (final : Program task.model.source.code (horizon task.domain))
    (later : Accepts task selected.policy.protocol final) : At task cache final := by
  have above := Selection.acceptance_bounds_every_benefit task.model task.domain task.original _ _ later
  constructor
  · intro tail valid strict
    apply selected_has_no_admissible_finite_dominator task cache selected tail valid
    exact ⟨Distributed.noWorse_trans strict.1 above,
      fun reverse => strict.2 (Distributed.noWorse_trans above reverse)⟩
  · intro available
    have improved := every_available_admissible_strict_improvement_is_selected task cache selected available
    exact ⟨Distributed.noWorse_trans above improved.1,
      fun reverse => improved.2 (Distributed.noWorse_trans reverse above)⟩

/-- Re-evaluate the final word against every earlier admissible finite tail.
No maximality proof, selected vector, or successful output is supplied. -/
def verifyAt (cache : Inquiry.Frame task) (final : Program task.model.source.code (horizon task.domain)) : Bool :=
  decide (∀ other ∈ programs task.model.source.code (width task cache),
    admissible task cache ⟨_,other⟩ →
      ¬ Review.improves task.model task.domain task.original final (wholePlan task cache ⟨_,other⟩))

theorem verifyAt_iff (cache : Inquiry.Frame task) (final : Program task.model.source.code (horizon task.domain)) :
    verifyAt task cache final = true ↔
    ∀ other : Complete.FiniteProgram task.model.source.code,admissible task cache other →
      ¬ Better task final (wholePlan task cache other) := by
  simp only [verifyAt,decide_eq_true_eq,Review.improves_iff]
  constructor
  · intro all other accepted
    have checked := all (normalise task cache other) (every_bounded_program_is_source_generated _ _ _)
      ((normalise_preserves_admissibility task cache other).mpr accepted)
    rw [normalise_preserves_the_whole_proposal] at checked
    exact checked
  · intro all other _ accepted
    exact all ⟨_,other⟩ accepted

def Chain (final : Program task.model.source.code (horizon task.domain)) :
    {cache : Inquiry.Frame task} → Execution.Walk task cache → Prop
  | _,.done => True
  | _,.carried _ _ _ later => Chain final later
  | _,.blocked _ _ _ _ _ later => Chain final later
  | _,.selected _ step _ _ _ later => At task step.path.finish final ∧ Chain final later

def review (final : Program task.model.source.code (horizon task.domain)) :
    {cache : Inquiry.Frame task} → Execution.Walk task cache → Bool
  | _,.done => true
  | _,.carried _ _ _ later => review final later
  | _,.blocked _ step _ _ rejected later =>
      CompleteSelection.review task step.path.finish (.blocked rejected) && review final later
  | _,.selected _ step _ _ _ later => verifyAt task step.path.finish final && review final later

theorem reviewed (final : Program task.model.source.code (horizon task.domain))
    {cache : Inquiry.Frame task} (walk : Execution.Walk task cache) (valid : Chain task final walk) :
    review task final walk = true := by
  induction walk with
  | done => rfl
  | carried _ _ _ _ ih => exact ih valid
  | blocked _ step _ _ rejected _ ih =>
      rw [review,Bool.and_eq_true]
      exact ⟨every_complete_output_passes_independent_replay task step.path.finish (.blocked rejected),ih valid⟩
  | selected _ step _ _ _ _ ih =>
      rw [review,Bool.and_eq_true]
      exact ⟨(verifyAt_iff task step.path.finish final).mpr valid.1.1,ih valid.2⟩

/-- The helper's final relation is discharged by the real drain below. -/
theorem run_chain (compiler : Execution.Compiler task) (count : Nat)
    (sender : Fin task.model.source.code.sites) (cache : Inquiry.Frame task)
    (final : Program task.model.source.code (horizon task.domain))
    (after : Accepts task (Execution.run task compiler count sender cache).path.finish.programme final) :
    Chain task final (Execution.run task compiler count sender cache) := by
  induction count generalizing cache with
  | zero => trivial
  | succ count ih =>
      unfold Execution.run at after ⊢
      dsimp only at after ⊢
      split at *
      · exact ih _ after
      · split at *
        · exact ih _ after
        · rename_i selected outcome
          constructor
          · apply choice task _ selected final
            apply Preservation.trans task _ (Preservation.trans task (run task compiler count sender _) after)
            exact Preservation.frame_advance task (Committed.commit task _ _ selected.policy.accepted.2)
          · exact ih _ after

namespace Occurrence
variable {task} {compiler : Execution.Compiler task} {cache : Inquiry.Frame task}
  {sender : Fin task.model.source.code.sites} {rounds : Nat}

theorem monotone (made : Execution.Occurrence task compiler cache sender rounds) :
    Accepts task cache.programme made.final.programme := by
  have generated := run task compiler rounds sender cache
  rw [←made.exact_generation] at generated
  exact Preservation.trans task generated (drain task _ _)

theorem all_earlier_paid_choices_remain_nondominated_at_the_final_actual_plan
    (made : Execution.Occurrence task compiler cache sender rounds) :
    Chain task made.final.programme made.generated := by
  have actual := run_chain task compiler rounds sender cache made.final.programme
  rw [←made.exact_generation] at actual
  exact actual (drain task _ _)

theorem independent_replay (made : Execution.Occurrence task compiler cache sender rounds) :
    review task made.final.programme made.generated = true :=
  reviewed task _ _ ((Occurrence.all_earlier_paid_choices_remain_nondominated_at_the_final_actual_plan made))

abbrev executed (made : Execution.Occurrence task compiler cache sender rounds) :
    Program task.model.source.code (horizon task.domain) := ⟨made.controls,made.final.within⟩

theorem executed_is_the_final_plan (made : Execution.Occurrence task compiler cache sender rounds)
    (covered : Knowledge.Contains (Owned.Source.initialBeliefs task) task.point)
    (uniform : horizon task.domain = (Computation.Cut.seed task.point.point).remaining) :
    (Occurrence.executed made) = made.final.programme := by
  apply (Continuation.Whole.Program.mk.injEq ..).mpr
  have complete : made.controls.length = horizon task.domain :=
    (made.the_generated_chain_completes_its_original_actual_window covered).trans uniform.symm
  have bounded := made.final.programme.bounded
  have retained := made.final.retained
  rw [complete,List.take_of_length_le bounded] at retained
  exact retained.symm

end Occurrence

theorem the_same_actual_root_retains_every_earlier_paid_choice
    (compiler : Execution.Compiler task) (cache : Inquiry.Frame task)
    (sender : Fin task.model.source.code.sites) (rounds : Nat)
    (made : Execution.Occurrence task compiler cache sender rounds) :
    Execution.Runtime.read task compiler cache sender rounds made made.controls.length = some made ∧
    Chain task made.final.programme made.generated ∧
    review task made.final.programme made.generated = true ∧
    let active := (Execution.Runtime.facade task compiler cache sender rounds made).seed.advance
      (arrival (Execution.Runtime.full task compiler cache sender rounds made))
    HEq ((Execution.Runtime.facade task compiler cache sender rounds made).readoutAt active .inquiry)
      (active.tick.generated.projectionOutcome
        (((Execution.Runtime.facade task compiler cache sender rounds made).installationAt active .inquiry).embed
          ((Execution.Runtime.facade task compiler cache sender rounds made).projectionAt active .inquiry))) ∧
    HEq active.tick.generated.wholeLedgerWriteBack
      (active.current.root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt active.current.visit.current) ∧
    active.tick.nextCurrent = ((Execution.Runtime.facade task compiler cache sender rounds made).seed.advance
      (arrival (Execution.Runtime.full task compiler cache sender rounds made)+1)).current := by
  refine ⟨Execution.Runtime.the_final_named_read_releases_its_source_generated_outcome task compiler cache sender rounds made,
    (Occurrence.all_earlier_paid_choices_remain_nondominated_at_the_final_actual_plan made),(Occurrence.independent_replay made),?_⟩
  exact Execution.Runtime.all_closed_faces_consume_the_same_full_ledger_and_generated_next
    task compiler cache sender rounds made _ .inquiry

namespace Public
variable (request : PublicTask.Request (Party := Party) (Good := Good) (Port := Port)
    (Technology := Technology) (Instrument := Instrument)) (quotas : List Nat)
  (point : Cursor request.model.source.code) (future : Opponent request.model.source.code)
  (localRounds : Nat) (sender : Fin request.model.source.code.sites) (rounds : Nat)

def Contract (prior : Execution.Public.Prior request quotas point future localRounds)
    (next : Execution.Public.Follow request quotas point future localRounds sender rounds prior) : Prop :=
  match prior,next with
  | .inherited _,_ => True
  | .installed fits _ _ choice _ _actual _,next =>
      let task := PublicTask.Feedback.task request _ fits quotas point future choice
      (Occurrence.executed next) = next.final.programme ∧
      Chain task (Occurrence.executed next) next.generated ∧ review task (Occurrence.executed next) next.generated = true

theorem all_legal_public_histories_generate_executed_whole_chain_nondomination
    (origin : Distributed.Recall.Information.Origin request.model)
    (stages : List (EventHistory.Stage (code := request.model.source.code)))
    (installed : stages.map Prod.fst = request.installed) :
    let actual := EventHistory.execute (EventHistory.ofOrigin request.model request.budget origin) stages
    let made := Execution.Public.produce request quotas actual future localRounds sender rounds
    Contract request quotas actual future localRounds sender rounds made.1 made.2 := by
  dsimp only [Execution.Public.produce]
  generalize Local.produce request quotas
    (EventHistory.execute (EventHistory.ofOrigin request.model request.budget origin) stages) future localRounds = prior
  cases prior with
  | inherited => trivial
  | installed fits work released choice selected actual generated =>
      let point := EventHistory.execute (EventHistory.ofOrigin request.model request.budget origin) stages
      let task := PublicTask.Feedback.task request _ fits quotas point future choice
      let made := Execution.occurrence task (CompleteSelection.compile task) (Inquiry.Frame.pack actual.1) sender rounds
      have covered := PublicTask.every_actual_receipt_has_a_complete_local_source request origin stages installed
      have initial : Knowledge.Contains (Owned.Source.initialBeliefs task) task.point := by
        have reset := PublicTask.reset_preserves_complete_coverage _ _ covered
        simpa only [task,Owned.Source.initialBeliefs,PublicTask.Feedback.task,PublicTask.domain,List.map_map,
          Function.comp_def,PublicTask.currentView] using reset
      have uniform : horizon task.domain = (Computation.Cut.seed task.point.point).remaining :=
        PublicTask.Window.actual request origin stages installed
      have exactWord := Occurrence.executed_is_the_final_plan made initial uniform
      change (Occurrence.executed made) = made.final.programme ∧
        Chain task (Occurrence.executed made) made.generated ∧ review task (Occurrence.executed made) made.generated = true
      refine ⟨exactWord,?_,?_⟩
      · rw [exactWord]
        exact (Occurrence.all_earlier_paid_choices_remain_nondominated_at_the_final_actual_plan made)
      · rw [exactWord]
        exact (Occurrence.independent_replay made)
end Public

