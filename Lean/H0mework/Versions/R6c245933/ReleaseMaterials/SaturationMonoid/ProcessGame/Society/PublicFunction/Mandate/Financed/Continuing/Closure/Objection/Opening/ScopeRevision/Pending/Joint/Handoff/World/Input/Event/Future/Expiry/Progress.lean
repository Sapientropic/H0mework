import H0mework.Versions.R6c245933.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.PublicFunction.Mandate.Financed.Continuing.Closure.Objection.Opening.ScopeRevision.Pending.Joint.Handoff.World.Input.Event.Future.Expiry
import H0mework.Versions.R6c245933.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.PublicFunction.Mandate.Financed.Continuing.Closure.Objection.Opening.ScopeRevision.Pending.Joint.Handoff.World.Input.Event.Future.ChallengeLine.Finality

/-! Actual root responses recurse only while the original scope remains
blocked and unexpired. The bound is generated by that source, not supplied fuel. -/

set_option autoImplicit false
set_option maxRecDepth 65536
set_option maxHeartbeats 12000000
namespace SaturationMonoid.ProcessGame.Society.PublicFunction.Mandate.Financed.Continuing.Closure.Objection.Opening.ScopeRevision.Pending.Joint.Handoff.World.Input.Event.Future.Expiry.Progress
open Institutions.Capitalism.Universal.Source.Program Institutions.Capitalism.Universal.Root ResponsibilityLifecycle Followup
noncomputable section
variable {epoch : Epoch} (inventory : Inventory epoch)

def remaining : Nat := horizon epoch.bound - (inventory.inputs.length + 2)
def actual := (Future.Runtime.fromRoot inventory (ownWord inventory) 0).result

inductive StepOutcome (answer : Future.Result inventory (ownWord inventory)) where
  | crossed (kind : answer.event.original.original.decision.kind ≠ .reviewBlocked)
      (deadline : epoch.scope.task.deadline < answer.packet.1.scope.task.deadline)
  | stayed (next : Inventory epoch) (same : answer.packet = ⟨epoch,next⟩)
      (kind : answer.event.original.original.decision.kind = .reviewBlocked)
      (growth : inventory.inputs.length + 1 ≤ next.inputs.length)
      (included : inventory.inputs ++ [ownWord inventory] <+: next.inputs)

private theorem fresh_deadline {inputs : List (List Action)} (fresh : Handoff.Ready epoch.bound inputs) :
    epoch.scope.task.deadline < fresh.scope.task.deadline :=
  fresh.new_window_is_after_the_actual_expired_scope.trans_le (by
    change (Handoff.after epoch.bound inputs).clock + 2 ≤ (Handoff.after epoch.bound inputs).clock + 3
    linarith)

def classify (answer : Future.Result inventory (ownWord inventory)) : StepOutcome inventory answer := by
  cases answer.openness
  next next kind packet facts =>
    refine .crossed (by rw [kind]; decide) ?_
    change epoch.scope.task.deadline < answer.event.original.original.decision.packet.1.scope.task.deadline
    rw [packet]
    exact fresh_deadline next.fresh
  next kind absent reason packet =>
    have extension := (Programme.produce (Event.observed inventory (ownWord inventory))).inputs_extend_the_saved_history
    have length := List.IsPrefix.length_le extension
    exact .stayed (Programme.produce (Event.observed inventory (ownWord inventory))).finalInventory packet kind
      (by simpa only [Event.observed,World.submit,List.length_append,List.length_singleton] using length) extension
  next kind fresh chosen absent actual methods packet =>
    refine .crossed (by rw [kind]; decide) ?_
    change epoch.scope.task.deadline < answer.event.original.original.decision.packet.1.scope.task.deadline
    rw [packet]
    exact fresh_deadline fresh

inductive Verdict (answer : Future.Result inventory (ownWord inventory)) where
  | crossed (kind : answer.event.original.original.decision.kind ≠ .reviewBlocked)
      (deadline : epoch.scope.task.deadline < answer.packet.1.scope.task.deadline)
  | expired (next : Inventory epoch) (same : answer.packet = ⟨epoch,next⟩)
      (kind : answer.event.original.original.decision.kind = .reviewBlocked)
      (late : horizon epoch.bound ≤ next.inputs.length + 2)

inductive Trace : Inventory epoch → Type where
  | finish (inventory : Inventory epoch) (answer : Future.Result inventory (ownWord inventory))
      (exact : answer = actual inventory) (verdict : Verdict inventory answer) : Trace inventory
  | advance (inventory : Inventory epoch) (answer : Future.Result inventory (ownWord inventory))
      (exact : answer = actual inventory) (next : Inventory epoch) (same : answer.packet = ⟨epoch,next⟩)
      (included : inventory.inputs ++ [ownWord inventory] <+: next.inputs) (tail : Trace next) : Trace inventory

def Trace.steps {inventory : Inventory epoch} : Trace inventory → Nat
  | .finish .. => 1
  | .advance _ _ _ _ _ _ tail => tail.steps + 1

private def search : (inventory : Inventory epoch) → (fuel : Nat) → remaining inventory ≤ fuel →
    {trace : Trace inventory // trace.steps ≤ fuel + 1}
  | inventory,0,covered => by
    let answer := actual inventory
    cases classify inventory answer with
    | crossed kind deadline => exact ⟨.finish inventory answer rfl (.crossed kind deadline),Nat.le_refl _⟩
    | stayed next same kind growth included =>
      have late : horizon epoch.bound ≤ next.inputs.length + 2 := by
        unfold remaining at covered
        omega
      exact ⟨.finish inventory answer rfl (.expired next same kind late),Nat.le_refl _⟩
  | inventory,fuel+1,covered => by
    let answer := actual inventory
    cases classify inventory answer with
    | crossed kind deadline => exact ⟨.finish inventory answer rfl (.crossed kind deadline),Nat.le_add_left _ _⟩
    | stayed next same kind growth included =>
      if late : horizon epoch.bound ≤ next.inputs.length + 2 then
        exact ⟨.finish inventory answer rfl (.expired next same kind late),Nat.le_add_left _ _⟩
      else
        have fits : remaining next ≤ fuel := by unfold remaining at covered ⊢; omega
        let tail := search next fuel fits
        exact ⟨.advance inventory answer rfl next same included tail.1,Nat.add_le_add_right tail.2 1⟩

def produce := search inventory (remaining inventory) (Nat.le_refl _)


abbrev Ending := Sigma fun inventory : Inventory epoch => Sigma fun answer : Future.Result inventory (ownWord inventory) => Verdict inventory answer

def Trace.ending {inventory : Inventory epoch} : Trace inventory → Ending (epoch := epoch)
  | .finish inventory answer _ verdict => ⟨inventory,answer,verdict⟩
  | .advance _ _ _ _ _ _ tail => tail.ending

def Trace.packet {inventory : Inventory epoch} (trace : Trace inventory) : Packet := trace.ending.2.1.packet

def Trace.native {inventory : Inventory epoch} (trace : Trace inventory) : Evolution ⟨epoch,inventory⟩ trace.packet := by
  induction trace with
  | finish inventory answer exact verdict => exact answer.event.native
  | advance inventory answer exact next same included tail ih =>
    have first := answer.event.native
    change Evolution ⟨epoch,inventory⟩ answer.packet at first
    rw [same] at first
    exact .append first ih

def Trace.finance {inventory : Inventory epoch} (trace : Trace inventory) :
    (Financial.Family.process sources).Run inventory.finance.current trace.packet.2.finance.current := by
  induction trace with
  | finish inventory answer exact verdict => exact answer.event.finance
  | advance inventory answer exact next same included tail ih =>
    have first := answer.event.finance
    change (Financial.Family.process sources).Run inventory.finance.current answer.packet.2.finance.current at first
    rw [same] at first
    exact first.concatRuns _ ih

abbrev Visit := Sigma fun inventory : Inventory epoch => Future.Result inventory (ownWord inventory)
def Trace.visits {inventory : Inventory epoch} : Trace inventory → List (Visit (epoch := epoch))
  | .finish inventory answer .. => [⟨inventory,answer⟩]
  | .advance inventory answer _ _ _ _ tail => ⟨inventory,answer⟩ :: tail.visits

theorem Trace.every_visit_is_its_own_actual_root {inventory : Inventory epoch}
    (trace : Trace inventory) (visit : Visit (epoch := epoch)) (member : visit ∈ trace.visits) : visit.2 = actual visit.1 := by
  induction trace with
  | finish inventory answer exact verdict => cases List.mem_singleton.mp member; exact exact
  | advance inventory answer exact next same included tail ih =>
    rcases List.mem_cons.mp member with first | later
    · cases first; exact exact
    · exact ih later

def responseInputs (inventory : Inventory epoch) :=
  (Programme.produce (Event.observed inventory (ownWord inventory))).finalInventory.inputs

def Trace.finalInputs {inventory : Inventory epoch} (trace : Trace inventory) := responseInputs trace.ending.1

private theorem own_incoming_is_in_response (inventory : Inventory epoch) :
    inventory.inputs ++ [ownWord inventory] <+: responseInputs inventory :=
  (Programme.produce (Event.observed inventory (ownWord inventory))).inputs_extend_the_saved_history

theorem Trace.saved_inputs_are_in_the_final_source {inventory : Inventory epoch} (trace : Trace inventory) :
    inventory.inputs <+: trace.finalInputs := by
  induction trace with
  | finish inventory answer exact verdict =>
    exact List.prefix_append _ _ |>.trans (own_incoming_is_in_response inventory)
  | advance inventory answer exact next same included tail ih =>
    exact (List.prefix_append _ _ |>.trans included).trans ih

theorem Trace.every_incoming_is_in_the_final_source {inventory : Inventory epoch} (trace : Trace inventory)
    (visit : Visit (epoch := epoch)) (member : visit ∈ trace.visits) :
    visit.1.inputs ++ [ownWord visit.1] <+: trace.finalInputs := by
  induction trace with
  | finish inventory answer exact verdict =>
    cases List.mem_singleton.mp member
    exact own_incoming_is_in_response inventory
  | advance inventory answer exact next same included tail ih =>
    rcases List.mem_cons.mp member with first | later
    · cases first
      exact included.trans tail.saved_inputs_are_in_the_final_source
    · exact ih later

private theorem evolution_clock_nondecreasing {first last : Packet} (path : Evolution first last) :
    (current first.1 first.2.inputs).clock ≤ (current last.1 last.2.inputs).clock := by
  induction path with
  | same packet => exact le_refl _
  | submit inventory word =>
    have update := Event.observed_current_is_raw_next inventory word
    change _ ≤ (current _ (Event.observed inventory word).inputs).clock
    rw [update]
    exact (Mandate.law base _).next_clock_nondecreasing _ _
  | @handoff epoch inventory fresh =>
    change _ ≤ (OutstandingSource.History.currentAt (Epoch.ofFresh fresh).bound.source
      (World.handoff inventory fresh).inputs ((World.handoff inventory fresh).inputs.length+2)).clock
    rw [source_clock]
    change (current epoch inventory.inputs).clock ≤ (current epoch inventory.inputs).clock + _
    exact le_add_of_nonneg_right (Nat.cast_nonneg _)
  | @handoffAt epoch inventory fresh actualInputs =>
    change _ ≤ (OutstandingSource.History.currentAt (Epoch.ofFresh fresh).bound.source
      (World.handoffAt inventory fresh actualInputs).inputs ((World.handoffAt inventory fresh actualInputs).inputs.length+2)).clock
    rw [source_clock]
    change (current epoch inventory.inputs).clock ≤ (current epoch inventory.inputs).clock + _
    exact le_add_of_nonneg_right (Nat.cast_nonneg _)
  | append earlier later before after => exact before.trans after

private theorem answer_clock_strict (answer : Future.Result inventory (ownWord inventory)) :
    (current epoch inventory.inputs).clock < (current answer.packet.1 answer.packet.2.inputs).clock := by
  have later := evolution_clock_nondecreasing (completionEvolution answer.event.original.original.decision)
  have first : (current epoch inventory.inputs).clock < (current epoch (Event.observed inventory (ownWord inventory)).inputs).clock := by
    rw [Event.observed_current_is_raw_next]
    change _ < (current epoch inventory.inputs).clock + max 0 (1 : ℚ)
    simp
  exact first.trans_le later

theorem Trace.the_actual_boundary_is_not_a_clock_self_loop {inventory : Inventory epoch} (trace : Trace inventory) :
    (current epoch inventory.inputs).clock < (current trace.packet.1 trace.packet.2.inputs).clock := by
  induction trace with
  | finish inventory answer exact verdict => exact answer_clock_strict inventory answer
  | advance inventory answer exact next same included tail ih =>
    have first := answer_clock_strict inventory answer
    rw [same] at first
    exact first.trans ih

theorem Trace.fresh_scope_or_actual_expired_blocker {inventory : Inventory epoch} (trace : Trace inventory) :
    epoch.scope.task.deadline < trace.packet.1.scope.task.deadline ∨
    (trace.packet.1 = epoch ∧ epoch.scope.task.deadline < (current trace.packet.1 trace.packet.2.inputs).clock ∧
      trace.ending.2.1.event.original.original.decision.kind = .reviewBlocked) := by
  simp only [Trace.packet]
  generalize trace.ending = final
  cases final with
  | mk last ending =>
    cases ending with
    | mk answer verdict =>
      cases verdict with
      | crossed kind deadline => exact Or.inl deadline
      | expired next same kind late =>
        apply Or.inr
        change answer.packet.1 = epoch ∧ _
        rw [same]
        exact ⟨rfl,horizon_expires epoch.bound next.inputs _ late,kind⟩

def Trace.locate {origin : ChallengeLine.Origin} {inventory : Inventory epoch} (trace : Trace inventory)
    (position : ChallengeLine.Located origin ⟨epoch,inventory⟩) := ChallengeLine.follow trace.native position

def Trace.completeOriginalChallenge {origin : ChallengeLine.Origin} {inventory : Inventory epoch} (trace : Trace inventory)
    (position : ChallengeLine.Located origin ⟨epoch,inventory⟩) := (trace.locate position).2.complete

def Trace.challengeDisposition {origin : ChallengeLine.Origin} {inventory : Inventory epoch} (trace : Trace inventory)
    (position : ChallengeLine.Located origin ⟨epoch,inventory⟩) := ChallengeLine.Finality.readRow origin (trace.locate position).1

theorem produced_response_count_is_source_bounded : (produce inventory).1.steps ≤ remaining inventory + 1 := (produce inventory).2


def Trace.actualIncoming {inventory : Inventory epoch} (trace : Trace inventory) (visit : Visit (epoch := epoch)) :=
  OutstandingSource.History.actualExecution epoch.source trace.finalInputs (visit.1.inputs.length+1)

theorem Trace.every_incoming_is_actually_interpreted_by_the_final_source {inventory : Inventory epoch}
    (trace : Trace inventory) (visit : Visit (epoch := epoch)) (member : visit ∈ trace.visits) :
    (trace.actualIncoming visit).submitted = ownWord visit.1 ∧
    (trace.actualIncoming visit).before = current epoch visit.1.inputs := by
  obtain ⟨suffix,same⟩ := trace.every_incoming_is_in_the_final_source visit member
  unfold Trace.actualIncoming
  rw [← same]
  constructor
  · rw [OutstandingSource.History.scheduled_input_is_actual epoch.source _ visit.1.inputs.length (by simp)]
    simp
  · change OutstandingSource.History.currentAt epoch.source ((visit.1.inputs ++ [ownWord visit.1]) ++ suffix) (visit.1.inputs.length+2) = _
    rw [(OutstandingSource.History.actual_frame _ _ _).1,List.append_assoc,
      OutstandingSource.History.extending_inputs_preserves_its_executed_prefix epoch.source visit.1.inputs
        ([ownWord visit.1] ++ suffix) _ (Nat.le_refl _)]
    exact (OutstandingSource.History.actual_frame epoch.source visit.1.inputs _).1.symm

def I := Programme.Completion.I (Event.observed (produce inventory).1.ending.1 (ownWord (produce inventory).1.ending.1))

theorem the_selected_root_input_is_the_whole_executed_history :
    I inventory = OutstandingSource.History.input epoch.source (produce inventory).1.finalInputs := by
  unfold I Programme.Completion.I
  change OutstandingSource.History.input epoch.source
    (Input.advance (Programme.Completion.lastAttempt (Programme.produce _)).1
      (Programme.Completion.lastAttempt (Programme.produce _)).2).inputs = _
  rw [Programme.Completion.last_attempt_has_the_complete_final_inventory]
  rfl

def Trace.originalGrant {inventory : Inventory epoch} (trace : Trace inventory) (entry : GrantCohort)
    (member : entry ∈ inventory.pastGrants) := (trace.native.grant entry member).extension.complete

def Trace.originalService {inventory : Inventory epoch} (trace : Trace inventory)
    (entry : ServiceCohort epoch.source.seed.initial.clock) (member : entry ∈ inventory.pastServices) :=
  (trace.native.service entry member).extension.complete

theorem Trace.paid_ending_has_its_actual_four_port_path {inventory : Inventory epoch} (trace : Trace inventory)
    (paid : trace.ending.2.1.event.original.original.decision.kind = .paid) :
    ∃ next : Programme.Completion.PaidNext (Programme.produce (Event.observed trace.ending.1 (ownWord trace.ending.1))),
      trace.packet = next.packet ∧
      Nonempty (Handoff.PaidOpening next.fresh (Handoff.actual next.fresh 1).before (Handoff.actual next.fresh 1).submitted) :=
  trace.ending.2.1.event.paid_response_has_one_actual_four_port_path paid

def Trace.nextSourceEvent {inventory : Inventory epoch} (trace : Trace inventory) := ownActual trace.packet.2

theorem Trace.blocking_keeps_its_own_consumable_actual_event {inventory : Inventory epoch} (trace : Trace inventory)
    (blocked : trace.ending.2.1.event.original.original.decision.kind ≠ .paid) :
    trace.nextSourceEvent.before = current trace.packet.1 trace.packet.2.inputs ∧
    (World.actual trace.packet.2 (ownWord trace.packet.2)).after = trace.nextSourceEvent.after :=
  trace.ending.2.1.blocking_keeps_a_consumable_source_event blocked


theorem Trace.steps_positive {inventory : Inventory epoch} (trace : Trace inventory) : 0 < trace.steps := by
  cases trace <;> exact Nat.zero_lt_succ _

theorem Trace.ending_is_its_own_actual_root {inventory : Inventory epoch} (trace : Trace inventory) :
    trace.ending.2.1 = actual trace.ending.1 := by
  induction trace with
  | finish inventory answer exact verdict => exact exact
  | advance inventory answer exact next same included tail ih => exact ih

theorem Trace.first_visit_is_the_original_cut {inventory : Inventory epoch} (trace : Trace inventory) :
    trace.visits.head? = some ⟨inventory,actual inventory⟩ := by
  cases trace with
  | finish inventory answer exact verdict => cases exact; rfl
  | advance inventory answer exact next same included tail => cases exact; rfl

end
