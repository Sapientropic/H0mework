namespace SaturationMonoid.ProcessGame.Society.PublicFunction.Mandate.Financed.Continuing.Closure.Objection.Opening.ScopeRevision.Pending.Joint.Handoff.World.Input.Event.Future.Expiry.Progress.Native
universe u
variable {epoch : Epoch}

def actual (inventory : Inventory epoch) : Future.Result inventory (Future.ownWord inventory) :=
  Future.produce inventory (Future.ownWord inventory)

theorem actual_exact (inventory : Inventory epoch) : actual inventory = Progress.actual inventory := rfl
@[csimp] theorem actual_codegen : @Progress.actual = @actual := rfl

def classify (inventory : Inventory epoch) (answer : Future.Result inventory (Future.ownWord inventory)) :
    StepOutcome inventory answer :=
  answer.openness.fold (fun _ => StepOutcome inventory answer)
    (fun next kind packet _ => .crossed (by rw [kind]; decide) (by
      change epoch.scope.task.deadline < answer.event.original.original.decision.packet.1.scope.task.deadline
      rw [packet]
      exact fresh_deadline next.fresh))
    (fun kind _ _ packet =>
      let extension := (Programme.produce (Event.observed inventory (Future.ownWord inventory))).inputs_extend_the_saved_history
      .stayed (Programme.produce (Event.observed inventory (Future.ownWord inventory))).finalInventory packet kind
        (by simpa only [Event.observed,World.submit,List.length_append,List.length_singleton]
          using List.IsPrefix.length_le extension) extension)
    (fun kind fresh _ _ _ _ packet => .crossed (by rw [kind]; decide) (by
      change epoch.scope.task.deadline < answer.event.original.original.decision.packet.1.scope.task.deadline
      rw [packet]
      exact fresh_deadline fresh))

theorem classify_exact (inventory : Inventory epoch) (answer : Future.Result inventory (Future.ownWord inventory)) :
    classify inventory answer = Progress.classify inventory answer := by
  cases answer
  next event same outlook => cases outlook <;> rfl

@[csimp] theorem classify_codegen : @Progress.classify = @classify := by
  funext epoch inventory answer
  exact (classify_exact inventory answer).symm

private def search : (inventory : Inventory epoch) → (fuel : Nat) → remaining inventory ≤ fuel →
    {trace : Trace inventory // trace.steps ≤ fuel + 1}
  | inventory,0,covered =>
    let answer := actual inventory
    match classify inventory answer with
    | .crossed kind deadline => ⟨.finish inventory answer rfl (.crossed kind deadline),Nat.le_refl _⟩
    | .stayed next same kind growth _ =>
      have late : horizon epoch.bound ≤ next.inputs.length + 2 := by
        unfold remaining at covered
        omega
      ⟨.finish inventory answer rfl (.expired next same kind late),Nat.le_refl _⟩
  | inventory,fuel+1,covered =>
    let answer := actual inventory
    match classify inventory answer with
    | .crossed kind deadline => ⟨.finish inventory answer rfl (.crossed kind deadline),Nat.le_add_left _ _⟩
    | .stayed next same kind growth included =>
      if late : horizon epoch.bound ≤ next.inputs.length + 2 then
        ⟨.finish inventory answer rfl (.expired next same kind late),Nat.le_add_left _ _⟩
      else
        have fits : remaining next ≤ fuel := by unfold remaining at covered ⊢; omega
        let tail := search next fuel fits
        ⟨.advance inventory answer rfl next same included tail.1,Nat.add_le_add_right tail.2 1⟩

private theorem rec_self {inventory : Inventory epoch}
    {answer : Future.Result inventory (Future.ownWord inventory)} {Result : Sort u}
    (chosen : StepOutcome inventory answer)
    (crossed : (kind : answer.event.original.original.decision.kind ≠ .reviewBlocked) →
      (deadline : epoch.scope.task.deadline < answer.packet.1.scope.task.deadline) → Result)
    (stayed : (next : Inventory epoch) → (same : answer.packet = ⟨epoch,next⟩) →
      (kind : answer.event.original.original.decision.kind = .reviewBlocked) →
      (growth : inventory.inputs.length + 1 ≤ next.inputs.length) →
      (included : inventory.inputs ++ [Future.ownWord inventory] <+: next.inputs) → Result) :
    StepOutcome.rec (motive := fun result => chosen = result → Result)
      (fun kind deadline _ => crossed kind deadline)
      (fun next same kind growth included _ => stayed next same kind growth included) chosen rfl =
      match chosen with
      | .crossed kind deadline => crossed kind deadline
      | .stayed next same kind growth included => stayed next same kind growth included := by
  cases chosen <;> rfl

private theorem search_exact (inventory : Inventory epoch) (fuel : Nat) (covered : remaining inventory ≤ fuel) :
    search inventory fuel covered = Progress.search inventory fuel covered := by
  induction fuel generalizing inventory with
  | zero =>
    simp only [search,Progress.search,classify_exact,actual_exact,rec_self]
  | succ fuel ih =>
    simp only [search,Progress.search,classify_exact,actual_exact,rec_self]
    cases verdict : Progress.classify inventory (Progress.actual inventory) with
    | crossed => rfl
    | stayed next same kind growth included =>
      by_cases late : horizon epoch.bound ≤ next.inputs.length + 2
      · simp only [dif_pos late]
      · simp only [dif_neg late,ih]

/-- Code generation follows the very same source-bounded search and full trace. -/
def produce (inventory : Inventory epoch) := search inventory (remaining inventory) (Nat.le_refl _)

theorem produce_exact (inventory : Inventory epoch) : produce inventory = Progress.produce inventory :=
  search_exact inventory (remaining inventory) (Nat.le_refl _)

@[csimp] theorem produce_codegen : @Progress.produce = @produce := by
  funext epoch inventory
  exact (produce_exact inventory).symm

end SaturationMonoid.ProcessGame.Society.PublicFunction.Mandate.Financed.Continuing.Closure.Objection.Opening.ScopeRevision.Pending.Joint.Handoff.World.Input.Event.Future.Expiry.Progress.Native
