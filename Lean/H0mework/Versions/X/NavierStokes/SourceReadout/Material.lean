import H0mework.Physics.Fluid.InitialMaterial
import H0mework.Versions.X.NavierStokes.SourceReadout.TimeAction

/-!
# Canonical material coordinates of the original source action

Both material derivatives are generated by the same velocity tangent. Their
bilinear current response recovers that tangent by the actual product rule.
The original receipt below supplies the derivative; no Cauchy configuration
is overwritten and no Dirac-dual Euler equation is asserted.
-/

set_option autoImplicit false
open scoped Matrix

namespace SaturationMonoid.PhysicsCore.Stage9CU.Fluid.NativeMaterialAction

open StageNineCanonicalCauchyState StageNineHolonomicField
open DiracCliffordRepresentation DiracExteriorMatterAction
open Stage9C.Material.SpinPair StageNineFullDiracAdjointMaterial

noncomputable section

abbrev ColorCoefficients := DiracSpinorIndex → Fin 2 → ℂ

def primalCoefficients (tangent : StageNineSpatialPoint) : ColorCoefficients :=
  !![0, 0; 0, 0;
    (tangent 2 : ℂ) / 4, ((tangent 0 : ℂ) - Complex.I * (tangent 1 : ℂ)) / 4;
    ((tangent 0 : ℂ) + Complex.I * (tangent 1 : ℂ)) / 4, -((tangent 2 : ℂ) / 4)]

def dualCoefficients (tangent : StageNineSpatialPoint) : ColorCoefficients :=
  !![(tangent 2 : ℂ) / 4, ((tangent 0 : ℂ) + Complex.I * (tangent 1 : ℂ)) / 4;
    ((tangent 0 : ℂ) - Complex.I * (tangent 1 : ℂ)) / 4, -((tangent 2 : ℂ) / 4);
    0, 0; 0, 0]

def primalResponse (tangent : StageNineSpatialPoint) : DiracExteriorMatterCarrier :=
  sourceColorDiracMatter (primalCoefficients tangent)

def dualResponse (tangent : StageNineSpatialPoint) : Module.Dual ℂ DiracExteriorMatterCarrier :=
  sourceColorDiracDual (dualCoefficients tangent)

private theorem component_hasDerivAt
    {u : ℝ → StageNineSpatialPoint} {tangent : StageNineSpatialPoint} {time : ℝ}
    (derivative : HasDerivAt u tangent time) (direction : Fin 3) :
    HasDerivAt (fun candidate => (u candidate direction : ℂ)) (tangent direction : ℂ) time := by
  exact Complex.ofRealCLM.hasFDerivAt.comp_hasDerivAt time
    ((EuclideanSpace.proj direction : StageNineSpatialPoint →L[ℝ] ℝ).hasFDerivAt.comp_hasDerivAt
      time derivative)

theorem primalCoefficients_hasDerivAt
    {u : ℝ → StageNineSpatialPoint} {tangent : StageNineSpatialPoint} {time : ℝ}
    (derivative : HasDerivAt u tangent time) :
    HasDerivAt (fun candidate => InitialLift.coefficients (fun direction => u candidate direction))
      (primalCoefficients tangent) time := by
  apply hasDerivAt_pi.2
  intro spin
  apply hasDerivAt_pi.2
  intro color
  have each := component_hasDerivAt derivative
  fin_cases spin <;> fin_cases color
  · exact hasDerivAt_const time (0 : ℂ)
  · exact hasDerivAt_const time (0 : ℂ)
  · exact hasDerivAt_const time (0 : ℂ)
  · exact hasDerivAt_const time (0 : ℂ)
  · exact ((each 2).div_const 4).const_add 1
  · exact ((each 0).sub ((each 1).const_mul Complex.I)).div_const 4
  · exact ((each 0).add ((each 1).const_mul Complex.I)).div_const 4
  · exact ((each 2).div_const 4).const_sub 1

theorem dualCoefficients_hasDerivAt
    {u : ℝ → StageNineSpatialPoint} {tangent : StageNineSpatialPoint} {time : ℝ}
    (derivative : HasDerivAt u tangent time) :
    HasDerivAt (fun candidate => InitialLift.dualCoefficients (fun direction => u candidate direction))
      (dualCoefficients tangent) time := by
  apply hasDerivAt_pi.2
  intro spin
  apply hasDerivAt_pi.2
  intro color
  have each := component_hasDerivAt derivative
  fin_cases spin <;> fin_cases color
  · exact ((each 2).div_const 4).const_add 1
  · exact ((each 0).add ((each 1).const_mul Complex.I)).div_const 4
  · exact ((each 0).sub ((each 1).const_mul Complex.I)).div_const 4
  · exact ((each 2).div_const 4).const_sub 1
  · exact hasDerivAt_const time (0 : ℂ)
  · exact hasDerivAt_const time (0 : ℂ)
  · exact hasDerivAt_const time (0 : ℂ)
  · exact hasDerivAt_const time (0 : ℂ)

theorem primal_hasDerivAt
    {u : ℝ → StageNineSpatialPoint} {tangent : StageNineSpatialPoint} {time : ℝ}
    (derivative : HasDerivAt u tangent time) :
    HasDerivAt (fun candidate => matterCoordinateEquiv
      (InitialLift.matter (fun direction => u candidate direction)))
      (matterCoordinateEquiv (primalResponse tangent)) time := by
  let linear := (sourceColorMatterCoordinateLinear.restrictScalars ℝ).toContinuousLinearMap
  exact linear.hasFDerivAt.comp_hasDerivAt time (primalCoefficients_hasDerivAt derivative)

theorem dual_hasDerivAt
    {u : ℝ → StageNineSpatialPoint} {tangent : StageNineSpatialPoint} {time : ℝ}
    (derivative : HasDerivAt u tangent time) (candidate : DiracExteriorMatterCarrier) :
    HasDerivAt (fun time => InitialLift.dual (fun direction => u time direction) candidate)
      (dualResponse tangent candidate) time := by
  have coefficients := dualCoefficients_hasDerivAt derivative
  change HasDerivAt (fun time => ∑ spin, ∑ color,
    InitialLift.dualCoefficients (fun direction => u time direction) spin color *
      sourceColorDoubletDual color (candidate spin))
    (∑ spin, ∑ color, dualCoefficients tangent spin color *
      sourceColorDoubletDual color (candidate spin)) time
  apply HasDerivAt.fun_sum
  intro spin _
  apply HasDerivAt.fun_sum
  intro color _
  exact ((hasDerivAt_pi.mp (hasDerivAt_pi.mp coefficients spin)) color).mul_const _

def colorPair (matrix : DiracMatrix) (dual primal : ColorCoefficients) : ℂ :=
  sourceColorDiracDual dual (diracMatrixMatterAction matrix (sourceColorDiracMatter primal))

theorem colorPair_eq (matrix : DiracMatrix) (dual primal : ColorCoefficients) :
    colorPair matrix dual primal =
      ∑ spin, ∑ color, dual spin color * ∑ other, matrix spin other * primal other color := by
  change (∑ spin, ∑ color, dual spin color * sourceColorDoubletDual color
    (diracMatrixMatterAction matrix (sourceColorDiracMatter primal) spin)) = _
  simp only [sourceColorDoubletDual_diracMatrix]

/-- Both actual material derivatives enter the bilinear evaluation. -/
theorem colorPair_hasDerivAt (matrix : DiracMatrix)
    {dual primal : ℝ → ColorCoefficients} {dualTangent primalTangent : ColorCoefficients}
    {time : ℝ} (dualDerivative : HasDerivAt dual dualTangent time)
    (primalDerivative : HasDerivAt primal primalTangent time) :
    HasDerivAt (fun candidate => colorPair matrix (dual candidate) (primal candidate))
      (colorPair matrix dualTangent (primal time) +
        colorPair matrix (dual time) primalTangent) time := by
  have expression : HasDerivAt
      (fun candidate => ∑ spin, ∑ color, dual candidate spin color *
        ∑ other, matrix spin other * primal candidate other color)
      (∑ spin, ∑ color,
        (dualTangent spin color * (∑ other, matrix spin other * primal time other color) +
        dual time spin color * (∑ other, matrix spin other * primalTangent other color))) time := by
    apply HasDerivAt.fun_sum
    intro spin _
    apply HasDerivAt.fun_sum
    intro color _
    apply ((hasDerivAt_pi.mp (hasDerivAt_pi.mp dualDerivative spin)) color).mul
    apply HasDerivAt.fun_sum
    intro other _
    exact ((hasDerivAt_pi.mp (hasDerivAt_pi.mp primalDerivative other)) color).const_mul _
  simpa only [colorPair_eq, Finset.sum_add_distrib] using expression

def currentResponse (value tangent : StageNineSpatialPoint) (direction : Fin 3) : ℝ :=
  (dualResponse tangent
      (diracMatrixMatterAction (diracGamma direction.succ)
        (InitialLift.matter (fun coordinate => value coordinate))) +
    InitialLift.dual (fun coordinate => value coordinate)
      (diracMatrixMatterAction (diracGamma direction.succ) (primalResponse tangent))).re

theorem current_hasDerivAt_productRule
    {u : ℝ → StageNineSpatialPoint} {tangent : StageNineSpatialPoint} {time : ℝ}
    (derivative : HasDerivAt u tangent time) (direction : Fin 3) :
    HasDerivAt (fun candidate =>
      (InitialLift.dual (fun coordinate => u candidate coordinate)
        (diracMatrixMatterAction (diracGamma direction.succ)
          (InitialLift.matter (fun coordinate => u candidate coordinate)))).re)
      (currentResponse (u time) tangent direction) time := by
  exact Complex.reCLM.hasFDerivAt.comp_hasDerivAt time
    (colorPair_hasDerivAt (diracGamma direction.succ)
      (dualCoefficients_hasDerivAt derivative) (primalCoefficients_hasDerivAt derivative))

theorem currentResponse_eq (value tangent : StageNineSpatialPoint) (direction : Fin 3) :
    currentResponse value tangent direction = tangent direction := by
  change (colorPair (diracGamma direction.succ)
      (dualCoefficients tangent) (InitialLift.coefficients (fun coordinate => value coordinate)) +
    colorPair (diracGamma direction.succ)
      (InitialLift.dualCoefficients (fun coordinate => value coordinate))
      (primalCoefficients tangent)).re = _
  simp only [colorPair_eq]
  fin_cases direction <;>
    simp [InitialLift.coefficients, InitialLift.dualCoefficients, primalCoefficients,
      dualCoefficients, diracGamma, diracGammaOne, diracGammaTwo, diracGammaThree,
      Fin.sum_univ_four, Fin.sum_univ_two, Complex.mul_re, Complex.mul_im] <;> ring

theorem current_hasDerivAt
    {u : ℝ → StageNineSpatialPoint} {tangent : StageNineSpatialPoint} {time : ℝ}
    (derivative : HasDerivAt u tangent time) (direction : Fin 3) :
    HasDerivAt (fun candidate =>
      (InitialLift.dual (fun coordinate => u candidate coordinate)
        (diracMatrixMatterAction (diracGamma direction.succ)
          (InitialLift.matter (fun coordinate => u candidate coordinate)))).re)
      (tangent direction) time := by
  simpa only [currentResponse_eq] using current_hasDerivAt_productRule derivative direction

theorem paired (u : ℝ → StageNineSpatialPoint) (time : ℝ) :
    FullDiracAdjointPaired
      (InitialLift.matter (fun direction => u time direction))
      (InitialLift.dual (fun direction => u time direction)) :=
  InitialLift.fullAdjointPaired _

end
end SaturationMonoid.PhysicsCore.Stage9CU.Fluid.NativeMaterialAction

namespace SaturationMonoid.NavierStokes.NativeStressSource

open Set
open ThreeDimensionalPeriodicCoarseFilterCore
open ThreeDimensionalPeriodicIntegerCharacterCoarseFilter
open ThreeDimensionalPeriodicFilteredNavierStokesGenerator
open ThreeDimensionalVorticityCoefficientRawSourceCore
open ThreeDimensionalVorticityCoefficientPhysicalCompiler
open ThreeDimensionalVorticityCoefficientCanonicalExhaustiveGalerkinTarget
open ThreeDimensionalVorticityCoefficientGeneratedWholeRestartNativeRecursion
open ThreeDimensionalVorticityCoefficientGeneratedWholeRestartNativeRecursion.GeneratedWholeRestartCurrent
open ThreeDimensionalVorticityCoefficientGeneratedWholeRestartNativeActualRoot
open PhysicsCore.StageNineHolonomicField PhysicsCore.StageNineFullDiracAdjointMaterial
open PhysicsCore.DiracCliffordRepresentation PhysicsCore.DiracExteriorMatterAction
open PhysicsCore.Stage9CU.Fluid

noncomputable section

/-- The original occurrence supplies every material derivative, current readout and pairing.
The finite inventory selects a physical observation; its action retains the whole source input. -/
theorem occurrence_material_action {nu : Viscosity} (initial : GeneratedWholeRestartCurrent nu)
    (index : ℕ) (modes : Finset IntegerWavevector) (nonzero : 0 ∉ modes)
    (space : PhysicalSpace) (time : Icc (0 : ℝ) (run initial index).nextContact.time.1) :
    let receipt := occurrenceReceipt (generatedWholeRestartNativeActualOccurrence initial index)
    let u := receiptPhysicalVelocity receipt modes space
    let tangent := finiteRealComplexFourierField modes (fun wave => biotSavartVelocityCoefficient wave
      (wholeLatticeVorticityFourierTangentAt nu.coeff (receipt.wholePath time) wave)) space
    HasDerivAt (fun actual => matterCoordinateEquiv
      (InitialLift.matter (fun direction => u actual direction)))
      (matterCoordinateEquiv (NativeMaterialAction.primalResponse tangent)) time.1 ∧
    (∀ candidate : DiracExteriorMatterCarrier,
      HasDerivAt (fun actual => InitialLift.dual (fun direction => u actual direction) candidate)
        (NativeMaterialAction.dualResponse tangent candidate) time.1) ∧
    (∀ direction : Fin 3, HasDerivAt (fun actual =>
      (InitialLift.dual (fun coordinate => u actual coordinate)
        (diracMatrixMatterAction (diracGamma direction.succ)
          (InitialLift.matter (fun coordinate => u actual coordinate)))).re)
        (tangent direction) time.1) ∧
    (∀ direction : Fin 3,
      (InitialLift.dual (fun coordinate => u time.1 coordinate)
        (diracMatrixMatterAction (diracGamma direction.succ)
          (InitialLift.matter (fun coordinate => u time.1 coordinate)))).re = u time.1 direction) ∧
    FullDiracAdjointPaired (InitialLift.matter (fun direction => u time.1 direction))
      (InitialLift.dual (fun direction => u time.1 direction)) := by
  dsimp only
  have derivative := receiptPhysicalVelocity_hasDerivAt
    (occurrenceReceipt (generatedWholeRestartNativeActualOccurrence initial index))
    modes nonzero space time
  exact ⟨NativeMaterialAction.primal_hasDerivAt derivative,
    NativeMaterialAction.dual_hasDerivAt derivative,
    NativeMaterialAction.current_hasDerivAt derivative,
    InitialLift.spatialCurrent_eq _, NativeMaterialAction.paired _ _⟩

end
end SaturationMonoid.NavierStokes.NativeStressSource
