noncomputable section

variable {nu : Viscosity} {initial : GeneratedWholeRestartCurrent nu}

def fluctuation (receipt : CofinalStressAt initial) (index : ℕ) : WholeRestartVelocityEndpointState :=
  wholeRestartContactVelocityState initial (receipt.stage index) -
    (sourceGeneratedWholeRestartCanonicalWeakCofinalReceipt initial).velocityEndpoint

/-- The uncollapsed part of the original cofinal stress at the original weak velocity endpoint. -/
def stressDefect (receipt : CofinalStressAt initial) : NativeFluidStressFourierState :=
  receipt.stress - quadraticFlux
    (wholeVelocity (sourceGeneratedWholeRestartCanonicalWeakCofinalReceipt initial).velocityEndpoint)

theorem contactStress_eq_pair (stage : ℕ) (wave : IntegerWavevector) (output input : Coordinate) :
    contactStress initial stage wave output input =
      bilinearFlux (wholeRestartContactVelocityState initial stage)
        (wholeRestartContactVelocityState initial stage) wave output input := by
  rw [bilinearFlux_diagonal, wholeRestartContactVelocityState, wholeVelocity_punctured]
  rfl

/-- The complete defect is generated by quadratic fluctuations; mixed terms are paid by weak limits. -/
theorem fluctuation_stress_tendsto (receipt : CofinalStressAt initial)
    (wave : IntegerWavevector) (output input : Coordinate) :
    Tendsto (fun index => quadraticFlux (wholeVelocity (fluctuation receipt index)) wave output input)
      atTop (nhds (stressDefect receipt wave output input)) := by
  let endpoint := (sourceGeneratedWholeRestartCanonicalWeakCofinalReceipt initial).velocityEndpoint
  let sequence := fun index => wholeRestartContactVelocityState initial (receipt.stage index)
  have base := tendsto_pi_nhds.mp (tendsto_pi_nhds.mp (tendsto_pi_nhds.mp receipt.stress_tendsto wave) output) input
  have mixedLeft := weak_bilinearFlux_left sequence endpoint endpoint receipt.velocityWeak_tendsto wave output input
  have mixedRight := weak_bilinearFlux_right sequence endpoint endpoint receipt.velocityWeak_tendsto wave output input
  have assembled := ((base.sub mixedLeft).sub mixedRight).add
    (tendsto_const_nhds (x := bilinearFlux endpoint endpoint wave output input))
  have limitEq : receipt.stress wave output input - bilinearFlux endpoint endpoint wave output input -
      bilinearFlux endpoint endpoint wave output input + bilinearFlux endpoint endpoint wave output input =
      stressDefect receipt wave output input := by
    change _ = receipt.stress wave output input - bilinearFlux endpoint endpoint wave output input
    ring
  rw [limitEq] at assembled
  convert assembled using 1
  funext index
  change bilinearFlux (sequence index - endpoint) (sequence index - endpoint) wave output input = _
  rw [bilinearFlux_sub_left, bilinearFlux_sub_right, bilinearFlux_sub_right,
    contactStress_eq_pair]
  dsimp only [sequence, CofinalStressAt.stage]
  ring

/-- Every frequency and tensor coordinate of the same-source stress defect is paid by the original δ. -/
theorem stressDefect_norm_le (receipt : CofinalStressAt initial)
    (wave : IntegerWavevector) (output input : Coordinate) :
    ‖stressDefect receipt wave output input‖ ≤
      wholeRestartKineticWeakEndpointDefect initial
        (sourceGeneratedWholeRestartCanonicalWeakCofinalReceipt initial).kineticEndpoint := by
  apply le_of_tendsto_of_tendsto' (fluctuation_stress_tendsto receipt wave output input).norm
    (cofinal_fluctuation_mass_tendsto receipt)
  intro index
  exact (quadraticFlux_norm_le_mass (wholeVelocity (fluctuation receipt index)) wave output input).trans_eq
    (wholeVelocity_mass (fluctuation receipt index))

/-- The zero-defect branch identifies the whole cofinal stress without imposing that branch. -/
theorem stressDefect_eq_zero_of_kineticDefect_zero (receipt : CofinalStressAt initial)
    (zero : wholeRestartKineticWeakEndpointDefect initial
      (sourceGeneratedWholeRestartCanonicalWeakCofinalReceipt initial).kineticEndpoint = 0) :
    stressDefect receipt = 0 := by
  funext wave output input
  apply norm_eq_zero.mp
  apply le_antisymm _ (norm_nonneg _)
  simpa only [zero] using stressDefect_norm_le receipt wave output input

/-- The defect's complete zero-frequency trace is precisely the original scalar δ. -/
theorem stressDefect_zero_trace (receipt : CofinalStressAt initial) :
    -(∑ coordinate : Coordinate, (stressDefect receipt 0 coordinate coordinate).re) =
      wholeRestartKineticWeakEndpointDefect initial
        (sourceGeneratedWholeRestartCanonicalWeakCofinalReceipt initial).kineticEndpoint := by
  have endpointTrace := bilinearFlux_zero_trace
    (sourceGeneratedWholeRestartCanonicalWeakCofinalReceipt initial).velocityEndpoint
    (sourceGeneratedWholeRestartCanonicalWeakCofinalReceipt initial).velocityEndpoint_reality
  simp only [bilinearFlux_diagonal] at endpointTrace
  simp only [stressDefect, Pi.sub_apply, Complex.sub_re, Finset.sum_sub_distrib]
  rw [cofinal_zero_trace_eq_neg_massLimit, endpointTrace, canonical_endpoint_norm_sq]
  unfold wholeRestartKineticWeakEndpointDefect
  ring

/-- The same cofinal action retains both resolved velocity stress and the generated defect. -/
theorem stress_action_decomposition (receipt : CofinalStressAt initial) :
    nativeFluidConstitutiveVorticityAction receipt.stress =
      nativeFluidConstitutiveVorticityAction (quadraticFlux
        (wholeVelocity (sourceGeneratedWholeRestartCanonicalWeakCofinalReceipt initial).velocityEndpoint)) +
      nativeFluidConstitutiveVorticityAction (stressDefect receipt) := by
  have reassemble : receipt.stress = quadraticFlux
      (wholeVelocity (sourceGeneratedWholeRestartCanonicalWeakCofinalReceipt initial).velocityEndpoint) +
        stressDefect receipt := by
    unfold stressDefect
    abel
  change wholeStressActionCLM receipt.stress = _
  rw [reassemble, map_add]
  rfl

theorem original_vorticity_action_tendsto (receipt : CofinalStressAt initial) :
    Tendsto (fun index wave =>
      ThreeDimensionalVorticityCoefficientInfiniteFixedOutputNonlinearRow.wholeStateVorticityNonlinearCoefficientAt
        (run initial (receipt.stage index)).contact.physicalState wave) atTop
      (nhds (nativeFluidConstitutiveVorticityAction (quadraticFlux
          (wholeVelocity (sourceGeneratedWholeRestartCanonicalWeakCofinalReceipt initial).velocityEndpoint)) +
        nativeFluidConstitutiveVorticityAction (stressDefect receipt))) := by
  rw [← stress_action_decomposition]
  exact receipt.vorticityNonlinear_tendsto

end
