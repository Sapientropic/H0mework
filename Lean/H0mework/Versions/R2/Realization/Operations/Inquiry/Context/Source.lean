import H0mework.Versions.R2.Realization.Operations.Inquiry.Consumer
import H0mework.Versions.R2.Foundation.Responsibility.JointSource.Native.Request.Registration.Source

/-! An installed raw restriction is read at the complete sealed inquiry
state. The context retains that state, its activation and its actual tick;
the environment increment is generated by the tick's own successor. -/

set_option autoImplicit false
noncomputable section
universe u
namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace SourceOperationInquiry.Context
open RootInquiryCompletion SourceOperationEffects

variable {process : SourceNativeInquiryEngineProcess.{u}}
variable (runtime : SourceNativeInquiryRuntime process)
variable {Sorts : Type u} {PhysicalValue PhysicalVar : Sorts → Type u}
  [∀ sort, AddCommGroup (PhysicalValue sort)] {sort : Sorts}

abbrev Raw := RootGeneratedDebtActivationJointSource.Native.Request.Registration.UniformRaw
  (Value := PhysicalValue) (Var := PhysicalVar) (sort := sort)

abbrev current (state : runtime.State) := state.engine.node.erase

/-- The payload and its restriction are source data. No environment or
successor equality is supplied independently of the installed projection. -/
structure RawRestrictionAt (actual : AnyAuthoritativeRootCurrent.{u}) : Type (u + 1) where
  projection : actual.current.root.source.projectionLaw.Projection
  active : actual.current.root.source.projectionLaw.ActiveAt projection
    (actual.current.root.emitted actual.current.visit.current)
  classifier_eq : actual.current.root.source.projectionLaw.classify projection
    (actual.current.root.emitted actual.current.visit.current) = .inl active
  payload_eq : actual.current.root.source.projectionLaw.PayloadAt projection
    (actual.current.root.emitted actual.current.visit.current) active =
      Raw (PhysicalValue := PhysicalValue) (PhysicalVar := PhysicalVar) (sort := sort)

abbrev RawAt (state : runtime.State) := RawRestrictionAt (PhysicalValue := PhysicalValue)
  (PhysicalVar := PhysicalVar) (sort := sort) (current runtime state)

abbrev RawSource := (state : runtime.State) → RawAt (PhysicalValue := PhysicalValue)
  (PhysicalVar := PhysicalVar) (sort := sort) runtime state

variable (source : RawSource (PhysicalValue := PhysicalValue) (PhysicalVar := PhysicalVar) (sort := sort) runtime)

def raw (state : runtime.State) : Raw (PhysicalValue := PhysicalValue) (PhysicalVar := PhysicalVar) (sort := sort) :=
  Eq.mp (source state).payload_eq ((current runtime state).current.root.source.projectionLaw.project
    (source state).projection ((current runtime state).current.root.emitted (current runtime state).current.visit.current)
    (source state).active)

def readEnv (state : runtime.State) : Env PhysicalValue PhysicalVar := (raw runtime source state).environment
def increment (state : runtime.State) : Env PhysicalValue PhysicalVar :=
  readEnv runtime source state.tick.nextState - readEnv runtime source state

theorem updated_environment (state : runtime.State) :
    readEnv runtime source state + increment runtime source state = readEnv runtime source state.tick.nextState :=
  add_sub_cancel _ _

def environment : Carrier runtime →+ Env PhysicalValue PhysicalVar :=
  (Finsupp.linearCombination ℤ (readEnv runtime source)).toAddMonoidHom

@[simp] theorem environment_point (state : runtime.State) :
    environment runtime source (point runtime state) = readEnv runtime source state := by
  simp only [environment, point, SourceOwnedObservationHistory.sourcePoint,
    LinearMap.toAddMonoidHom_coe, Finsupp.linearCombination_single, one_smul]

theorem environment_action (state : runtime.State) :
    environment runtime source (sourceAction runtime (point runtime state)) =
      readEnv runtime source state.tick.nextState := by
  rw [point_action, environment_point]

theorem environment_increment (state : runtime.State) :
    environment runtime source (sourceAction runtime (point runtime state) - point runtime state) =
      increment runtime source state := by
  rw [map_sub, environment_action, environment_point]
  rfl

end SourceOperationInquiry.Context
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
