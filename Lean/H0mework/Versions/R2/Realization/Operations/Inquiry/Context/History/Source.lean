import H0mework.Versions.R2.Realization.Operations.Inquiry.Context.Consumer
import H0mework.Realization.ScalarCofinal.KernelCompletion

/-! Complete operation prefixes are generated by the original heterogeneous
runtime. Restriction drops observations; it does not supply a future table. -/

set_option autoImplicit false
noncomputable section
universe u
namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace SourceOperationInquiry.Context.History
open RootInquiryCompletion SourceOperationEffects SourceOperationScalarRelations
open SourceOperationScalarInventoryLift SourceOperationScalarPresentation
open SourceGeneratedScalarCofinalKernelCompletion CategoryTheory CategoryTheory.Limits

variable {process : SourceNativeInquiryEngineProcess.{u}}
variable (runtime : SourceNativeInquiryRuntime process)
variable {Sorts : Type u} {PhysicalValue PhysicalVar : Sorts → Type u}
  [∀ target, AddCommGroup (PhysicalValue target)] {sort : Sorts}
variable (source : RawSource (PhysicalValue := PhysicalValue) (PhysicalVar := PhysicalVar) (sort := sort) runtime)

abbrev Words := Formal ℤ PhysicalValue PhysicalVar sort
abbrev Prefix (bound : Nat) := Fin (bound + 1) → PhysicalValue sort × PhysicalValue sort

def stageInventory (count : Nat) : Words (PhysicalValue := PhysicalValue) (PhysicalVar := PhysicalVar) (sort := sort) →ₗ[ℤ]
    PhysicalValue sort × PhysicalValue sort :=
  updateInventory (R := ℤ) (s := sort)
    (readEnv runtime source (runtime.stateAt count))
    (increment runtime source (runtime.stateAt count))

def prefixEvaluator (offset bound : Nat) : Words (PhysicalValue := PhysicalValue) (PhysicalVar := PhysicalVar) (sort := sort) →ₗ[ℤ]
    Prefix (PhysicalValue := PhysicalValue) (sort := sort) bound :=
  LinearMap.pi fun index => stageInventory runtime source (offset + index.val)

def restriction (bound : Nat) : Prefix (PhysicalValue := PhysicalValue) (sort := sort) (bound + 1) →ₗ[ℤ]
    Prefix (PhysicalValue := PhysicalValue) (sort := sort) bound :=
  LinearMap.pi fun index => LinearMap.proj index.castSucc

def data (offset : Nat) : Data (R := ℤ)
    (Generator := Words (PhysicalValue := PhysicalValue) (PhysicalVar := PhysicalVar) (sort := sort))
    (Carrier := Prefix (PhysicalValue := PhysicalValue) (sort := sort)) where
  evaluator := prefixEvaluator runtime source offset
  transition := restriction

theorem compatible (offset : Nat) : (data runtime source offset).Compatible := by
  intro bound
  apply LinearMap.ext
  intro word
  funext index
  rfl

def completion (offset : Nat) :=
  (data runtime source offset).Completion (compatible runtime source offset)

def sourceMap (offset : Nat) :=
  (data runtime source offset).completionMap (compatible runtime source offset)

def readPrefix (offset bound : Nat) : completion runtime source offset →ₗ[ℤ]
    Prefix (PhysicalValue := PhysicalValue) (sort := sort) bound :=
  ((data runtime source offset).stageRealization bound).comp
    ((data runtime source offset).restriction (compatible runtime source offset) bound).hom

theorem source_prefix (offset bound : Nat) :
    sourceMap runtime source offset ≫ ModuleCat.ofHom (readPrefix runtime source offset bound) =
      ModuleCat.ofHom (prefixEvaluator runtime source offset bound) :=
  (data runtime source offset).source_to_evaluator (compatible runtime source offset) bound

theorem source_stage (offset bound : Nat)
    (word : Words (PhysicalValue := PhysicalValue) (PhysicalVar := PhysicalVar) (sort := sort))
    (index : Fin (bound + 1)) :
    readPrefix runtime source offset bound ((sourceMap runtime source offset).hom word) index =
      stageInventory runtime source (offset + index.val) word :=
  congrFun (ConcreteCategory.congr_hom (source_prefix runtime source offset bound) word) index

theorem fibre (offset : Nat)
    (left right : Words (PhysicalValue := PhysicalValue) (PhysicalVar := PhysicalVar) (sort := sort)) :
    (sourceMap runtime source offset).hom left = (sourceMap runtime source offset).hom right ↔
      ∀ bound (index : Fin (bound + 1)),
        stageInventory runtime source (offset + index.val) left =
          stageInventory runtime source (offset + index.val) right := by
  constructor
  · intro same bound index
    have observed := congrArg (fun value => readPrefix runtime source offset bound value index) same
    rw [source_stage, source_stage] at observed
    exact observed
  · intro same
    apply Limits.Concrete.limit_ext ((data runtime source offset).quotientTower (compatible runtime source offset))
    intro bound
    apply (data runtime source offset).stageRealization_injective bound.unop
    change readPrefix runtime source offset bound.unop ((sourceMap runtime source offset).hom left) =
      readPrefix runtime source offset bound.unop ((sourceMap runtime source offset).hom right)
    funext index
    rw [source_stage, source_stage]
    exact same bound.unop index

theorem fibre_generated (offset : Nat)
    (left right : Words (PhysicalValue := PhysicalValue) (PhysicalVar := PhysicalVar) (sort := sort)) :
    (sourceMap runtime source offset).hom left = (sourceMap runtime source offset).hom right ↔
      ∀ bound (index : Fin (bound + 1)),
        liftMap (R := ℤ) (left - right) ∈ LinearMap.range
          (relationMap (R := ℤ) (pairEnvironmentAt runtime source (runtime.stateAt (offset + index.val)))) := by
  rw [fibre]
  constructor
  · intro observations bound index
    exact (inventory_fibre runtime source (runtime.stateAt (offset + index.val)) left right).mp
      (observations bound index)
  · intro relations bound index
    exact (inventory_fibre runtime source (runtime.stateAt (offset + index.val)) left right).mpr
      (relations bound index)

theorem stage_receipt (count : Nat) :
    HEq (runtime.tickAt count).receipt
      ((runtime.stateAt count).engine.ask (runtime.stateAt count).activation).receipt ∧
    (runtime.stateAt (count + 1)).engine.node.erase =
      ((runtime.stateAt count).engine.ask (runtime.stateAt count).activation).next.node.erase ∧
    (runtime.stateAt count).engine.node.PreservesGeneratedLivingLawAt
      (runtime.stateAt count).activation.query (runtime.stateAt (count + 1)).engine.node :=
  actual_next_receipt runtime count

end SourceOperationInquiry.Context.History
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
