import H0mework.Versions.R2.Realization.Operations.Inquiry.Context.Native.Orbit.Source

/-! The actual native shift substitutes complete relation constructors.
Its boundary and exact complex morphism are generated by the existing
source substitution, then consumed with the same sealed macro tick. -/

set_option autoImplicit false
noncomputable section
universe u
namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace SourceOperationInquiry.Context.Native.Orbit
open RootInquiryCompletion SourceOperationEffects SourceOperationScalarRelations
open SourceOperationScalarPresentation SourceOperationDerivations
variable {process : SourceNativeInquiryEngineProcess.{u}}
variable (runtime : SourceNativeInquiryRuntime process)
variable {Sorts : Type u} {PhysicalValue PhysicalVar : Sorts → Type u}
  [∀ target, AddCommGroup (PhysicalValue target)] {sort : Sorts}
variable (source : RawSource (PhysicalValue := PhysicalValue) (PhysicalVar := PhysicalVar) (sort := sort) runtime)

private def retarget {first second : Env PhysicalValue (Var PhysicalVar)} {target : Sorts}
    (same : first = second) (generator : RelationIndex ℤ second target) : RelationIndex ℤ first target :=
  same.symm ▸ generator

private theorem retarget_boundary {first second : Env PhysicalValue (Var PhysicalVar)} {target : Sorts}
    (same : first = second) (generator : RelationIndex ℤ second target) :
    relation (R := ℤ) first (retarget same generator) = relation (R := ℤ) second generator := by
  cases same
  rfl

def actionIndex (state : runtime.State) {target : Sorts} :
    RelationIndex ℤ (environment runtime source (point runtime state.tick.nextState)) target →
      RelationIndex ℤ (environment runtime source (point runtime state)) target :=
  fun generator => SourceSubstitution.index binding (environment runtime source (point runtime state))
    (retarget (binding_point runtime source state) generator)

def actionRelations (state : runtime.State) {target : Sorts} :
    (RelationIndex ℤ (environment runtime source (point runtime state.tick.nextState)) target →₀ ℤ) →ₗ[ℤ]
      (RelationIndex ℤ (environment runtime source (point runtime state)) target →₀ ℤ) :=
  Finsupp.lmapDomain ℤ ℤ (actionIndex runtime source state)

theorem action_index_boundary (state : runtime.State) {target : Sorts}
    (generator : RelationIndex ℤ (environment runtime source (point runtime state.tick.nextState)) target) :
    relation (R := ℤ) (environment runtime source (point runtime state)) (actionIndex runtime source state generator) =
      substitution (R := ℤ) binding
        (relation (R := ℤ) (environment runtime source (point runtime state.tick.nextState)) generator) := by
  unfold actionIndex
  rw [SourceSubstitution.index_boundary]
  exact congrArg (substitution (R := ℤ) binding)
    (retarget_boundary (PhysicalValue := PhysicalValue) (PhysicalVar := PhysicalVar)
      (show SourceSubstitution.sourceEnvironment binding (environment runtime source (point runtime state)) =
        environment runtime source (point runtime state.tick.nextState) from binding_point runtime source state) generator)

theorem action_boundary (state : runtime.State) {target : Sorts} :
    (relationMap (R := ℤ) (s := target) (environment runtime source (point runtime state))).comp
      (actionRelations runtime source state) = (substitution (R := ℤ) binding).comp
        (relationMap (R := ℤ) (s := target) (environment runtime source (point runtime state.tick.nextState))) := by
  apply Finsupp.lhom_ext
  intro generator coefficient
  simp only [LinearMap.comp_apply, actionRelations, Finsupp.lmapDomain_apply,
    Finsupp.mapDomain_single, relationMap, Finsupp.linearCombination_single, map_smul]
  exact congrArg (fun value => coefficient • value) (action_index_boundary runtime source state generator)

def complexMorphism (state : runtime.State) {target : Sorts} :=
  SourceSubstitution.complexMorphism (R := ℤ) (s := target) binding
    (environment runtime source (point runtime state))

theorem complex_source (state : runtime.State) :
    SourceSubstitution.sourceEnvironment binding (environment runtime source (point runtime state)) =
      environment runtime source (point runtime state.tick.nextState) := binding_point runtime source state

def nextDerivation (state : runtime.State) {target : Sorts} {left right : Expr PhysicalValue (Var PhysicalVar) target}
    (proof : Derivation (environment runtime source (point runtime state.tick.nextState)) left right) :
    Derivation (environment runtime source (point runtime state)) (left.subst binding) (right.subst binding) :=
  Derivation.subst binding (environment runtime source (point runtime state)) (by
    rw [binding_point runtime source state]
    exact proof)

theorem actual_relation_update (state : runtime.State) {target : Sorts}
    (relations : RelationIndex ℤ (environment runtime source (point runtime state.tick.nextState)) target →₀ ℤ) :
    relationMap (R := ℤ) (environment runtime source (point runtime state)) (actionRelations runtime source state relations) =
      substitution (R := ℤ) binding
        (relationMap (R := ℤ) (environment runtime source (point runtime state.tick.nextState)) relations) ∧
    HEq state.tick.receipt (state.engine.ask state.activation).receipt ∧
    state.tick.nextState.engine.node.erase = (state.engine.ask state.activation).next.node.erase ∧
    state.engine.node.PreservesGeneratedLivingLawAt state.activation.query state.tick.nextState.engine.node :=
  ⟨LinearMap.congr_fun (action_boundary runtime source state) relations, HEq.rfl, rfl,
    state.tick.next_preservesGeneratedLivingLaw⟩

end SourceOperationInquiry.Context.Native.Orbit
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
