import H0mework.Foundation.Source.AccountedUnfolding
import H0mework.Versions.R2.Foundation.Arithmetic.RootIncidence

/-!
# Root arithmetic as a same-occurrence unfolding face

The existing root arithmetic step already fixes one exact temporal occurrence,
its installed material, whole-ledger write-back and generated next.  This
kernel does not add a second arithmetic token.  It derives finite unfolding
trees directly from that step:

* parallel incidence is sibling branching;
* joint incidence is dependent branching;
* the familiar expected histories are folds of those trees;
* every face point restricts the same exact root occurrence.

Thus a world occurrence can enter arithmetic composition without becoming a
`UnitHistory` atom, while the old `UnitHistory` material remains a compatible
readout during migration.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace RootArithmeticUnfoldingFace

open ArithmeticGeneration
open RootArithmeticIncidence
open RootedAccountedUnfolding

universe u v w

/-- Coordinates of the arithmetic restriction of one exact root step.  The
type is indexed by the step, so these labels cannot be replayed at another
occurrence. -/
inductive RootArithmeticFacePointAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (step : RootArithmeticIncidenceStepAt recognition visit) : Type
  | occurrence
  | left
  | right
  deriving DecidableEq

namespace RootArithmeticFacePointAt

/-- Every arithmetic coordinate is a restriction of the exact occurrence
already generated by the root compiler. -/
def rootOccurrence
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    (_point : RootArithmeticFacePointAt step) :
    root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.actual.OccurrenceAt
      visit.current :=
  step.generated.occurrence

@[simp] theorem rootOccurrence_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    (point : RootArithmeticFacePointAt step) :
    point.rootOccurrence = step.generated.occurrence :=
  rfl

/-- Compatibility material readout.  The root point reads the actual whole;
left and right are its installed incidence restrictions. -/
def materialHistory
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit} :
    RootArithmeticFacePointAt step → UnitHistory
  | .occurrence => step.material.whole
  | .left => step.material.left
  | .right => step.material.right

end RootArithmeticFacePointAt


/-- Fold a finite sibling list with actual parallel history composition. -/
def parallelChildren : List UnitHistory → UnitHistory
  | [] => .empty
  | head :: tail => head.parallel (parallelChildren tail)

@[simp] theorem parallelChildren_two (left right : UnitHistory) :
    parallelChildren [left, right] = left.parallel right := by
  simp [parallelChildren, UnitHistory.parallel]

/-- Canonical same-occurrence sibling exposure. -/
def parallelUnfolding
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (step : RootArithmeticIncidenceStepAt recognition visit) :
    RootedAccountedUnfolding (RootArithmeticFacePointAt step) :=
  .occur .occurrence <|
    .cons (RootedAccountedUnfolding.zero .left) <|
      .singleton (RootedAccountedUnfolding.zero .right)

/-- Canonical same-occurrence dependent exposure.  The right restriction is
generated beneath the left restriction rather than installed as an
independent product endpoint. -/
def jointUnfolding
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (step : RootArithmeticIncidenceStepAt recognition visit) :
    RootedAccountedUnfolding (RootArithmeticFacePointAt step) :=
  .occur .occurrence <|
    .singleton <| .occur .left <|
      .singleton (RootedAccountedUnfolding.zero .right)

/-- Local algebra for the parallel restriction. -/
def parallelAlgebra
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    (point : RootArithmeticFacePointAt step)
    (children : List UnitHistory) : UnitHistory :=
  match children with
  | [] => point.materialHistory
  | _ => parallelChildren children

/-- Local algebra for dependent branching. -/
def jointAlgebra
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    (point : RootArithmeticFacePointAt step)
    (children : List UnitHistory) : UnitHistory :=
  match point, children with
  | .occurrence, [] => step.material.whole
  | .occurrence, _ => parallelChildren children
  | .left, [] => step.material.left
  | .left, _ => step.material.left.joint (parallelChildren children)
  | .right, _ => step.material.right

/-- Parallel expected material is an image of the one-constructor fold. -/
def parallelFold
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (step : RootArithmeticIncidenceStepAt recognition visit) : UnitHistory :=
  (parallelUnfolding step).fold parallelAlgebra

/-- Joint expected material is the fold of the dependent tree. -/
def jointFold
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (step : RootArithmeticIncidenceStepAt recognition visit) : UnitHistory :=
  (jointUnfolding step).fold jointAlgebra

@[simp] theorem parallelFold_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (step : RootArithmeticIncidenceStepAt recognition visit) :
    parallelFold step = step.material.left.parallel step.material.right := by
  simp [parallelFold, parallelUnfolding,
    RootedAccountedUnfolding.fold, RootedAccountedUnfolding.foldBranches,
    RootedAccountedUnfolding.zero,
    parallelAlgebra, RootArithmeticFacePointAt.materialHistory,
    AccountedBranches.singleton]

@[simp] theorem jointFold_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (step : RootArithmeticIncidenceStepAt recognition visit) :
    jointFold step = step.material.left.joint step.material.right := by
  simp [jointFold, jointUnfolding,
    RootedAccountedUnfolding.fold, RootedAccountedUnfolding.foldBranches,
    RootedAccountedUnfolding.zero,
    jointAlgebra,
    parallelChildren, UnitHistory.parallel, AccountedBranches.singleton]

/-- Existing exact parallel incidence is exactly equality between the root's
actual whole readout and the accountable fold image. -/
theorem exact_whole_eq_parallelFold
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    (commutes : step.material.whole =
      step.material.left.parallel step.material.right) :
    step.material.whole = parallelFold step := by
  simpa using commutes

/-- Existing exact joint incidence is equality with the dependent fold. -/
theorem exact_whole_eq_jointFold
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    (commutes : step.material.whole =
      step.material.left.joint step.material.right) :
    step.material.whole = jointFold step := by
  simpa using commutes

/-- A parallel residual is precisely failure of the sibling fold, with the
same step provenance. -/
theorem mismatch_parallelFold
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    (residual : GeneratedParallelResidualAt step step.material) :
    step.material.whole ≠ parallelFold step := by
  simpa using residual.mismatch

/-- A joint residual is precisely failure of the dependent fold. -/
theorem mismatch_jointFold
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    (residual : GeneratedJointResidualAt step step.material) :
    step.material.whole ≠ jointFold step := by
  simpa using residual.mismatch

/-- The unfolding face reuses the exact step's whole ledger. -/
def unfoldingWholeLedgerWriteBack
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (step : RootArithmeticIncidenceStepAt recognition visit) :=
  step.wholeLedgerWriteBack

/-- The fold cannot select a successor; it reuses the same compiler next. -/
def unfoldingNextCurrent
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (step : RootArithmeticIncidenceStepAt recognition visit) :
    SourceNativeAuthoritativeRootCurrentAt N :=
  step.nextCurrent

@[simp] theorem unfoldingNextCurrent_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (step : RootArithmeticIncidenceStepAt recognition visit) :
    unfoldingNextCurrent step = root.generatedNextCurrentAt visit :=
  rfl

/-! ## Exact structurally anchored domain admission -/

/-- A domain node attached to one exact arithmetic row.  Its private
constructor forces the parent occurrence to be the compiler occurrence owned
by that row. -/
structure RootArithmeticDomainPointAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (step : RootArithmeticIncidenceStepAt recognition visit)
    (Payload : Type v) : Type (max u v) where
  private mk ::
  rootOccurrence :
    root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.actual.OccurrenceAt
      visit.current
  rootOccurrence_eq : rootOccurrence = step.generated.occurrence
  payload : Payload

namespace RootArithmeticDomainPointAt

variable {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
variable {root : SourceNativeLivingRootClosure N V}
variable {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
variable {visit : SourceNativeTemporalVisitAt
  root.toAuthoritativeRoot.toLedgerRoot}
variable {step : RootArithmeticIncidenceStepAt recognition visit}
variable {Payload : Type v}

def generate (step : RootArithmeticIncidenceStepAt recognition visit)
    (payload : Payload) : RootArithmeticDomainPointAt step Payload :=
  ⟨step.generated.occurrence, rfl, payload⟩

def installedMaterial (point : RootArithmeticDomainPointAt step Payload) :
    RootArithmeticMaterialAt :=
  recognition.materialLaw.materialAt point.rootOccurrence

@[simp] theorem installedMaterial_eq
    (point : RootArithmeticDomainPointAt step Payload) :
    point.installedMaterial = step.material := by
  rw [installedMaterial, point.rootOccurrence_eq]
  rfl

end RootArithmeticDomainPointAt

/-- Admission checks the universal provenance trace of a tree whose nodes are
already structurally anchored to the row.  No caller-supplied fold algebra is
accepted, so a constant evaluator cannot mint admission. -/
structure RootArithmeticUnfoldingAdmissionAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (step : RootArithmeticIncidenceStepAt recognition visit)
    {Payload : Type v}
    (domainOccurrence :
      RootedAccountedUnfolding (RootArithmeticDomainPointAt step Payload))
    (expectedPayloadTrace : List Payload)
    (traceReceipt : domainOccurrence.trace.map
      RootArithmeticDomainPointAt.payload = expectedPayloadTrace) :
    Type (max u v) where
  private mk ::

namespace RootArithmeticUnfoldingAdmissionAt

variable {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
variable {root : SourceNativeLivingRootClosure N V}
variable {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
variable {visit : SourceNativeTemporalVisitAt
  root.toAuthoritativeRoot.toLedgerRoot}
variable {step : RootArithmeticIncidenceStepAt recognition visit}
variable {Payload : Type v}
variable {domainOccurrence :
  RootedAccountedUnfolding (RootArithmeticDomainPointAt step Payload)}
variable {expectedPayloadTrace : List Payload}
variable {traceReceipt : domainOccurrence.trace.map
  RootArithmeticDomainPointAt.payload = expectedPayloadTrace}

def generate : RootArithmeticUnfoldingAdmissionAt step domainOccurrence
    expectedPayloadTrace traceReceipt :=
  ⟨⟩

def occurrence
    (_admission : RootArithmeticUnfoldingAdmissionAt step domainOccurrence
      expectedPayloadTrace traceReceipt) :=
  domainOccurrence

def payloadTrace
    (admission : RootArithmeticUnfoldingAdmissionAt step domainOccurrence
      expectedPayloadTrace traceReceipt) : List Payload :=
  admission.occurrence.trace.map RootArithmeticDomainPointAt.payload

theorem payloadTrace_eq
    (admission : RootArithmeticUnfoldingAdmissionAt step domainOccurrence
      expectedPayloadTrace traceReceipt) :
    admission.payloadTrace = expectedPayloadTrace := by
  cases admission
  exact traceReceipt

def arithmeticStep
    (_admission : RootArithmeticUnfoldingAdmissionAt step domainOccurrence
      expectedPayloadTrace traceReceipt) :=
  step

def rootPoint
    (admission : RootArithmeticUnfoldingAdmissionAt step domainOccurrence
      expectedPayloadTrace traceReceipt) :=
  admission.occurrence.root

def installedMaterial
    (admission : RootArithmeticUnfoldingAdmissionAt step domainOccurrence
      expectedPayloadTrace traceReceipt) :=
  admission.rootPoint.installedMaterial

@[simp] theorem installedMaterial_eq
    (admission : RootArithmeticUnfoldingAdmissionAt step domainOccurrence
      expectedPayloadTrace traceReceipt) :
    admission.installedMaterial = admission.arithmeticStep.material :=
  RootArithmeticDomainPointAt.installedMaterial_eq admission.rootPoint

theorem rootOccurrence_eq
    (admission : RootArithmeticUnfoldingAdmissionAt step domainOccurrence
      expectedPayloadTrace traceReceipt) :
    admission.rootPoint.rootOccurrence =
      admission.arithmeticStep.generated.occurrence :=
  admission.rootPoint.rootOccurrence_eq

def wholeLedgerWriteBack
    (admission : RootArithmeticUnfoldingAdmissionAt step domainOccurrence
      expectedPayloadTrace traceReceipt) :=
  admission.arithmeticStep.wholeLedgerWriteBack

def nextCurrent
    (admission : RootArithmeticUnfoldingAdmissionAt step domainOccurrence
      expectedPayloadTrace traceReceipt) :=
  admission.arithmeticStep.nextCurrent

end RootArithmeticUnfoldingAdmissionAt

/-- One node simultaneously anchored to two adjacent arithmetic rows. -/
structure RootArithmeticDomainPairPointAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {highVisit lowVisit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (highStep : RootArithmeticIncidenceStepAt recognition highVisit)
    (lowStep : RootArithmeticIncidenceStepAt recognition lowVisit)
    (Payload : Type v) : Type (max u v) where
  private mk ::
  highRootOccurrence :
    root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.actual.OccurrenceAt
      highVisit.current
  highRootOccurrence_eq : highRootOccurrence = highStep.generated.occurrence
  lowRootOccurrence :
    root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.actual.OccurrenceAt
      lowVisit.current
  lowRootOccurrence_eq : lowRootOccurrence = lowStep.generated.occurrence
  payload : Payload

namespace RootArithmeticDomainPairPointAt

variable {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
variable {root : SourceNativeLivingRootClosure N V}
variable {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
variable {highVisit lowVisit : SourceNativeTemporalVisitAt
  root.toAuthoritativeRoot.toLedgerRoot}
variable {highStep : RootArithmeticIncidenceStepAt recognition highVisit}
variable {lowStep : RootArithmeticIncidenceStepAt recognition lowVisit}
variable {Payload : Type v}

def generate
    (highStep : RootArithmeticIncidenceStepAt recognition highVisit)
    (lowStep : RootArithmeticIncidenceStepAt recognition lowVisit)
    (payload : Payload) :
    RootArithmeticDomainPairPointAt highStep lowStep Payload :=
  ⟨highStep.generated.occurrence, rfl,
    lowStep.generated.occurrence, rfl, payload⟩

def highInstalledMaterial
    (point : RootArithmeticDomainPairPointAt highStep lowStep Payload) :=
  recognition.materialLaw.materialAt point.highRootOccurrence

def lowInstalledMaterial
    (point : RootArithmeticDomainPairPointAt highStep lowStep Payload) :=
  recognition.materialLaw.materialAt point.lowRootOccurrence

@[simp] theorem highInstalledMaterial_eq
    (point : RootArithmeticDomainPairPointAt highStep lowStep Payload) :
    point.highInstalledMaterial = highStep.material := by
  rw [highInstalledMaterial, point.highRootOccurrence_eq]
  rfl

@[simp] theorem lowInstalledMaterial_eq
    (point : RootArithmeticDomainPairPointAt highStep lowStep Payload) :
    point.lowInstalledMaterial = lowStep.material := by
  rw [lowInstalledMaterial, point.lowRootOccurrence_eq]
  rfl

end RootArithmeticDomainPairPointAt

structure RootArithmeticUnfoldingPairAdmissionAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {highVisit lowVisit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (highStep : RootArithmeticIncidenceStepAt recognition highVisit)
    (lowStep : RootArithmeticIncidenceStepAt recognition lowVisit)
    {Payload : Type v}
    (domainOccurrence : RootedAccountedUnfolding
      (RootArithmeticDomainPairPointAt highStep lowStep Payload))
    (expectedPayloadTrace : List Payload)
    (traceReceipt : domainOccurrence.trace.map
      RootArithmeticDomainPairPointAt.payload = expectedPayloadTrace) :
    Type (max u v) where
  private mk ::

namespace RootArithmeticUnfoldingPairAdmissionAt

variable {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
variable {root : SourceNativeLivingRootClosure N V}
variable {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
variable {highVisit lowVisit : SourceNativeTemporalVisitAt
