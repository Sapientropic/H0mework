import H0mework.Versions.R2.Foundation.Inquiry.MinimalCoface
import H0mework.Versions.R2.Foundation.Cofinal.TemporalAnswer

/-!
# Typed semantic-change world-network U8

The conservative heterogeneous-network seam permits a change of carrier only
when every old and revised value are bidirectionally presented.  A genuine U8
revision may instead add expressive freedom.  This kernel records that
non-conservative branch without turning the added freedom into a caller
parameter.

Every old registered identity and open responsibility survives by a
constructive retract.  The same literal rooted failure occurrence then
compiles the revised network/root, a typed semantic-change receipt, the first
revised write, the old causal entry's generated revised row, and one genuinely new
generated row, incidence, and claim with no old-coordinate preimage.  The new
row is part of the revised root's initial finite patch; these coordinates are
not an all-support inventory or a completed future table.

The revised claim is also required to hold at the translated extension
support.  A fresh carrier coordinate or semantic-change receipt alone is not
visibility authority.  This is still revision authority rather than
settlement authority: a downstream independent consumer must close the old
obstruction.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace TypedSemanticWorldNetworkU8

open ObstructionGeneratedMinimalCoface

universe u

/-- Reindex the exact causal old entry to the support identified by the
rooted failure occurrence. -/
def oldEntryAtFailureSupport
    {N : WorldRelationNetwork.{u}}
    {OldV : Vocabulary.{u}}
    {oldWorld : SourceNativeAuthoritativeRootClosure N OldV}
    {oldVisit : SourceNativeTemporalVisitAt oldWorld.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {oldTheory : TheoryState N}
    {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    (rooted : RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7 failure) :
    OpenResponsibilityAt N support :=
  (ConstructivePresentation.cast
    (F := fun indexedSupport : N.Support =>
      OpenResponsibilityAt N indexedSupport)
    rooted.support_eq).forward rooted.rootEntry

/-- One source-generated non-conservative revision.  Both the old causal
entry and the new-only entry occur in the revised root's initial finite patch. -/
structure GeneratedTypedSemanticWorldNetworkRevisionAt
    {N : WorldRelationNetwork.{u}}
    {OldV : Vocabulary.{u}}
    {oldWorld : SourceNativeAuthoritativeRootClosure N OldV}
    {oldVisit : SourceNativeTemporalVisitAt oldWorld.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {oldTheory : TheoryState N}
    {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    (rooted : RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7 failure) :
    Type (u + 8) where
  NewN : WorldRelationNetwork.{u}
  translation : TypedSemanticWorldNetworkTranslationAt N NewN
  NewV : Vocabulary.{u}
  /-- The revised root is born with its terminal-handoff law.  Keeping the
  living source as one field prevents the same revised occurrence and first
  write from being reissued under a sibling future law. -/
  newLivingRoot : SourceNativeLivingRootClosure NewN NewV
  /-- The revised initial support restricts to the exact target of the old
  root's causal successor.  It may be the genuinely new support generated by the
  minimal coface; requiring it to equal an embedded old support would force
  its incidence to have an old preimage by `incidence_commutes`. -/
  new_support_restricts :
    translation.support.backward
        (newLivingRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
          (newLivingRoot.toAuthoritativeRoot.toLedgerRoot.emitted
            newLivingRoot.toAuthoritativeRoot.toRoot.source.initial)) =
      oldWorld.toRoot.supportAt rooted.oldSuccessor.next
  /-- The complete old target ledger survives at that revised support. -/
  oldTargetOpenLedger : ConstructiveRetract
    (OpenResponsibilityAt N
      (oldWorld.toRoot.supportAt rooted.oldSuccessor.next))
    (OpenResponsibilityAt NewN
      (newLivingRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (newLivingRoot.toAuthoritativeRoot.toLedgerRoot.emitted
          newLivingRoot.toAuthoritativeRoot.toRoot.source.initial)))
  oldTargetOpenClaim_commutes :
    (oldEntry : OpenResponsibilityAt N
      (oldWorld.toRoot.supportAt rooted.oldSuccessor.next)) ->
      translation.claim.forward oldEntry.claim =
        (oldTargetOpenLedger.forward oldEntry).claim
  /-- Revision may preserve or spend an inherited live incidence budget, but it
  cannot mint fresh continuation credit merely by changing the carrier. -/
  oldTargetOpenProgressBudget_not_refilled :
    (oldEntry : OpenResponsibilityAt N
      (oldWorld.toRoot.supportAt rooted.oldSuccessor.next)) ->
      (oldTargetOpenLedger.forward oldEntry).progressBudget <=
        oldEntry.progressBudget
  occurrencePresentation : ConstructivePresentation
    (oldWorld.toRoot.actual.OccurrenceAt
      rooted.oldSuccessor.next)
    (newLivingRoot.toAuthoritativeRoot.toRoot.actual.OccurrenceAt
      newLivingRoot.toAuthoritativeRoot.toRoot.source.initial)
  occurrence_commutes : occurrencePresentation.forward
      (oldWorld.emitted rooted.oldSuccessor.next) =
    newLivingRoot.emitted
      newLivingRoot.toAuthoritativeRoot.toRoot.source.initial
  firstWrite : CanonicalFirstRootWriteAt
    newLivingRoot.toAuthoritativeRoot.toLedgerRoot
  /-- The generated live incidence is the carrier of the revised claim.  No
  sibling claim value is accepted by the typed compiler. -/
  newOnlyEntry : OpenResponsibilityAt NewN
      (newLivingRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (newLivingRoot.toAuthoritativeRoot.toLedgerRoot.emitted
          newLivingRoot.toAuthoritativeRoot.toRoot.source.initial))
  /-- The obstruction-generated row starts with no maintenance credit.  Any
  later credit must itself be generated by a rooted actual occurrence. -/
  newOnlyProgressBudget_eq_zero : newOnlyEntry.progressBudget = 0
  /-- The revised claim is an actual fact of the revised world at the exact
  translated extension support.  A fresh coordinate plus a semantic-change
  receipt cannot by themselves mint visibility authority. -/
  revisedClaimHolds : NewN.HoldsAt
    (newLivingRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
      (newLivingRoot.toAuthoritativeRoot.toLedgerRoot.emitted
        newLivingRoot.toAuthoritativeRoot.toRoot.source.initial))
    newOnlyEntry.claim
  semanticChange : NewN.SemanticChangeAt
    (newLivingRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
      (newLivingRoot.toAuthoritativeRoot.toLedgerRoot.emitted
        newLivingRoot.toAuthoritativeRoot.toRoot.source.initial))
    (translation.claim.forward (N.obstructionClaim obstruction))
    newOnlyEntry.claim
  revisedClaim_hasNoOldPreimage : IsEmpty
    (Sigma fun oldClaim : N.Claim =>
      PLift (translation.claim.forward oldClaim = newOnlyEntry.claim))
  /-- The revised support's incidence must be genuinely new.  The incidence
  value itself is not a compiler choice: it is definitionally
  `NewN.incidenceAt` on the exact translated support. -/
  newOnlyIncidence_hasNoOldPreimage : IsEmpty
    (Sigma fun oldIncidence : N.Incidence =>
      PLift (translation.incidence.forward oldIncidence =
        NewN.incidenceAt
          (newLivingRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
            (newLivingRoot.toAuthoritativeRoot.toLedgerRoot.emitted
              newLivingRoot.toAuthoritativeRoot.toRoot.source.initial))))
  /-- Every inherited open responsibility is an actual row of the revised
  root's initial patch.  A retract alone is not ledger authority. -/
  oldEntryRows : (oldEntry : OpenResponsibilityAt N
      (oldWorld.toRoot.supportAt rooted.oldSuccessor.next)) →
    SourceNativeTemporalVisitGeneratedEvolutionAt.GeneratedEntryRowAt
      (newLivingRoot.toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit
        (.finite newLivingRoot.toAuthoritativeRoot.toRoot.initialVisit))
      (oldTargetOpenLedger.forward oldEntry)
  newOnlyEntry_hasNoOldPreimage : IsEmpty
    (Sigma fun oldEntry :
        OpenResponsibilityAt N
          (oldWorld.toRoot.supportAt rooted.oldSuccessor.next) =>
      PLift (oldTargetOpenLedger.forward oldEntry = newOnlyEntry))
  newOnlyEntryRow : SourceNativeTemporalVisitGeneratedEvolutionAt.GeneratedEntryRowAt
    (newLivingRoot.toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit
      (.finite newLivingRoot.toAuthoritativeRoot.toRoot.initialVisit))
      newOnlyEntry

/-- Every inherited row is the row used by the revised occurrence's literal
whole-ledger fold, not an adjacent membership certificate. -/
theorem GeneratedTypedSemanticWorldNetworkRevisionAt.oldEntryRow_commutes_with_world
    {N : WorldRelationNetwork.{u}} {OldV : Vocabulary.{u}}
    {oldWorld : SourceNativeAuthoritativeRootClosure N OldV}
    {oldVisit : SourceNativeTemporalVisitAt oldWorld.toLedgerRoot}
    {U7 : U7ProducerCalculus N} {oldTheory : TheoryState N}
    {support : N.Support} {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    {rooted : RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7 failure}
    (revision : GeneratedTypedSemanticWorldNetworkRevisionAt rooted)
    (oldEntry : OpenResponsibilityAt N
      (oldWorld.toRoot.supportAt rooted.oldSuccessor.next)) :
    (revision.oldEntryRows oldEntry).sourceRow.CommutesWithWorld :=
  (revision.oldEntryRows oldEntry).sourceRow.commutes_with_world

/-- The obstruction-generated row likewise belongs to, and commutes with,
the exact first whole-ledger evolution of the revised root. -/
theorem GeneratedTypedSemanticWorldNetworkRevisionAt.newOnlyEntryRow_commutes_with_world
    {N : WorldRelationNetwork.{u}} {OldV : Vocabulary.{u}}
    {oldWorld : SourceNativeAuthoritativeRootClosure N OldV}
    {oldVisit : SourceNativeTemporalVisitAt oldWorld.toLedgerRoot}
    {U7 : U7ProducerCalculus N} {oldTheory : TheoryState N}
    {support : N.Support} {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    {rooted : RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7 failure}
    (revision : GeneratedTypedSemanticWorldNetworkRevisionAt rooted) :
    revision.newOnlyEntryRow.sourceRow.CommutesWithWorld :=
  revision.newOnlyEntryRow.sourceRow.commutes_with_world

/-- Authoritative readout of the revised living root.  The handoff law is no
longer a detachable field beside this root. -/
def GeneratedTypedSemanticWorldNetworkRevisionAt.newRoot
    {N : WorldRelationNetwork.{u}}
    {OldV : Vocabulary.{u}}
    {oldWorld : SourceNativeAuthoritativeRootClosure N OldV}
    {oldVisit : SourceNativeTemporalVisitAt oldWorld.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {oldTheory : TheoryState N}
    {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    {rooted : RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7 failure}
    (generated : GeneratedTypedSemanticWorldNetworkRevisionAt rooted) :
    SourceNativeAuthoritativeRootClosure generated.NewN generated.NewV :=
  generated.newLivingRoot.toAuthoritativeRoot

namespace GeneratedTypedSemanticWorldNetworkRevisionAt

variable
    {N : WorldRelationNetwork.{u}}
    {OldV : Vocabulary.{u}}
    {oldWorld : SourceNativeAuthoritativeRootClosure N OldV}
    {oldVisit : SourceNativeTemporalVisitAt oldWorld.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {oldTheory : TheoryState N}
    {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    {rooted : RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7 failure}

/-- Actual revised support emitted at the new root's first occurrence. -/
def initialSupport
    (generated : GeneratedTypedSemanticWorldNetworkRevisionAt rooted) :
    generated.NewN.Support :=
  generated.newRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
    (generated.newRoot.toLedgerRoot.emitted
      generated.newRoot.toRoot.source.initial)

/-- Compatibility readout for the failure row.  Its authority is the
whole-old-ledger producer `oldEntryRows`. -/
def oldEntryRow
    (generated : GeneratedTypedSemanticWorldNetworkRevisionAt rooted) :
    SourceNativeTemporalVisitGeneratedEvolutionAt.GeneratedEntryRowAt
      (generated.newRoot.toLedgerRoot.generatedAtTemporalVisit
        (.finite generated.newRoot.toRoot.initialVisit))
      (generated.oldTargetOpenLedger.forward rooted.oldTargetEntry) :=
  generated.oldEntryRows rooted.oldTargetEntry

/-- Compatibility readout: the revised claim is definitionally the claim of
the source-generated new-only live row. -/
def revisedClaim
    (generated : GeneratedTypedSemanticWorldNetworkRevisionAt rooted) :
    generated.NewN.Claim :=
  generated.newOnlyEntry.claim

@[simp] theorem newOnlyEntry_claim_eq_revisedClaim
    (generated : GeneratedTypedSemanticWorldNetworkRevisionAt rooted) :
    generated.newOnlyEntry.claim = generated.revisedClaim :=
  rfl

/-- Canonical world-incidence readout of the generated support.  This was
formerly a free structure field; keeping it as a readout removes the last
possibility of pairing a valid revised support with a sibling incidence. -/
def newOnlyIncidence
    (generated : GeneratedTypedSemanticWorldNetworkRevisionAt rooted) :
    generated.NewN.Incidence :=
  generated.NewN.incidenceAt
    generated.initialSupport

theorem newOnlyIncidence_eq_support
    (generated : GeneratedTypedSemanticWorldNetworkRevisionAt rooted) :
    generated.newOnlyIncidence = generated.NewN.incidenceAt
      generated.initialSupport :=
  rfl

/-- Cross-epoch occurrence commuting begins at the original root's exact
causal successor.  No sibling compiler branch contributes this anchor. -/
theorem oldRootEmitter_commutes
    (generated : GeneratedTypedSemanticWorldNetworkRevisionAt rooted) :
    generated.occurrencePresentation.forward
        (oldWorld.emitted rooted.oldSuccessor.next) =
      generated.newRoot.emitted generated.newRoot.toRoot.source.initial := by
  exact generated.occurrence_commutes

/-- Exact grounding of every semantic field carried beside the revised root.

The revised root supplies actual dynamics.  It does not confer authority on
an independently chosen network, translation, live row, fact, or semantic
change.  Those fields enter a source-native U8 occurrence only when they are
the exact dependent image of the rooted obstruction's canonical minimal
coface. -/
structure ExactFieldGrounding
    (generated : GeneratedTypedSemanticWorldNetworkRevisionAt rooted) : Prop where
  network_eq : generated.NewN =
    (root_obstruction_generates_minimal_coface rooted).worldNetwork
  lawSurface_heq : HEq
    generated.newLivingRoot.source.base.lawSurface
    (TheoryState.rootSemantic
      (root_obstruction_generates_minimal_coface rooted).worldNetwork)
  translation_heq : HEq generated.translation
    (root_obstruction_generates_minimal_coface rooted).translation
  initialSupport_heq : HEq generated.initialSupport
    (root_obstruction_generates_minimal_coface rooted).cofaceSupport
  oldTargetOpenLedger_heq : HEq generated.oldTargetOpenLedger
    (root_obstruction_generates_minimal_coface rooted).cofaceLedgerRetract
  newOnlyEntry_heq : HEq generated.newOnlyEntry
    (root_obstruction_generates_minimal_coface rooted).obstructionEntry
  revisedClaimHolds_heq : HEq generated.revisedClaimHolds
    (root_obstruction_generates_minimal_coface rooted).obstructionClaimHolds
  semanticChange_heq : HEq generated.semanticChange
    (root_obstruction_generates_minimal_coface rooted).obstructionSemanticChange

/-! ## Source-generated faithful richer-coface grounding -/

/-- Canonical first visit of one generated revised root. -/
def initialRestructuringVisit
    (generated : GeneratedTypedSemanticWorldNetworkRevisionAt rooted) :
    SourceNativeTemporalVisitAt generated.newRoot.toLedgerRoot :=
  .finite generated.newRoot.toRoot.initialVisit

/-- Canonical compiler image at the revised root's first occurrence. -/
def initialRestructuringGenerated
    (generated : GeneratedTypedSemanticWorldNetworkRevisionAt rooted) :
    SourceNativeTemporalVisitGeneratedEvolutionAt
      generated.newRoot.toLedgerRoot
      generated.initialRestructuringVisit :=
  generated.newRoot.toLedgerRoot.generatedAtTemporalVisit
    generated.initialRestructuringVisit

/-- Source-fixed restructuring law of the revised root. -/
def sourceFixedRestructuringLaw
    (generated : GeneratedTypedSemanticWorldNetworkRevisionAt rooted) :
    SourceNativeLedgerRestructuringLaw
      generated.newRoot.source.restructuringSource.source :=
  generated.newRoot.source.restructuringSource.compiler.restructuringLaw

/-- Recover the exact restructuring certification selected by the revised
source compiler.  The successor token eliminates the terminal branch; no
classification or coverage receipt is chosen here. -/
def exactInitialRestructuringCertification
    (generated : GeneratedTypedSemanticWorldNetworkRevisionAt rooted)
    (successor : SourceNativeLedgerGeneratedSuccessorAt
      generated.initialRestructuringGenerated.occurrence
      generated.initialRestructuringGenerated.wholeLedgerWriteBack) :
    ExactLedgerRestructuringCertificationAt
      generated.sourceFixedRestructuringLaw
      generated.initialRestructuringGenerated.occurrence
      successor.ledgerEvolution := by
  generalize generated_eq :
    generated.initialRestructuringGenerated.wholeLedgerWriteBack =
      writeBack at successor ⊢
  have certified :=
    generated.newRoot.source.restructuringSource.compiler
      |>.certifyRestructuring
        generated.initialRestructuringGenerated.occurrence
  change
    generated.newRoot.source.restructuringSource.compiler.ledgerCompiler.compile
        generated.initialRestructuringGenerated.occurrence = writeBack
      at generated_eq
  rw [generated_eq] at certified
  cases writeBack with
  | nativeWrite => exact certified
  | relationWrite => exact certified
  | continuedTransport => exact certified
  | borromeanRedirect => exact certified
  | faithfulTerminal => exact nomatch successor

/-- Exact nontrivial split performed by the revised root's own first
whole-ledger compiler image.

The initial source ledger contains no dormant row outside the translated old
ledger and the canonical obstruction row.  Every target origin likewise
comes from one of those two source families.  The distinguished pair is a
genuine split of the migrated old causal entry, and the source-fixed compiler
must select the exact stored coverage rather than a sibling receipt. -/
structure SourceGeneratedFirstWriteGenuineSplitAt
    (generated : GeneratedTypedSemanticWorldNetworkRevisionAt rooted) :
    Type (u + 9) where
  private mk ::
  successor : SourceNativeLedgerGeneratedSuccessorAt
    generated.initialRestructuringGenerated.occurrence
    generated.initialRestructuringGenerated.wholeLedgerWriteBack
  left : OpenResponsibilityAt generated.NewN
    (generated.newRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
      successor.targetOccurrence)
  right : OpenResponsibilityAt generated.NewN
    (generated.newRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
      successor.targetOccurrence)
  children_distinct : left ≠ right
  origin_eq : (successor.ledgerEvolution.origin left).1 =
    (successor.ledgerEvolution.origin right).1
  parent_origin_eq : (successor.ledgerEvolution.origin left).1 =
    generated.oldTargetOpenLedger.forward rooted.oldTargetEntry
  split : SourceNativeSplitCoverageAt
    generated.sourceFixedRestructuringLaw
    generated.initialRestructuringGenerated.occurrence
    successor.ledgerEvolution left right origin_eq
  compilerSelectsSplit :
    (generated.exactInitialRestructuringCertification successor).split
        left right origin_eq =
      SourceNativeSplitClassificationAt.split split
  initialLedgerNoDormant :
    (entry : OpenResponsibilityAt generated.NewN generated.initialSupport) ->
      Nonempty (Sigma fun oldEntry : OpenResponsibilityAt N
        (oldWorld.toRoot.supportAt rooted.oldSuccessor.next) =>
        PLift (generated.oldTargetOpenLedger.forward oldEntry = entry)) ∨
      entry = generated.newOnlyEntry
  targetOriginsCovered :
    (targetEntry : OpenResponsibilityAt generated.NewN
      (generated.newRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        successor.targetOccurrence)) ->
      Nonempty (Sigma fun oldEntry : OpenResponsibilityAt N
        (oldWorld.toRoot.supportAt rooted.oldSuccessor.next) =>
        PLift ((successor.ledgerEvolution.origin targetEntry).1 =
          generated.oldTargetOpenLedger.forward oldEntry)) ∨
      (successor.ledgerEvolution.origin targetEntry).1 =
        generated.newOnlyEntry

/-- Public candidate assembler.  Every argument is already indexed by the
one generated revision; root, occurrence, ledgers, first write, and next are
not accepted separately. -/
def SourceGeneratedFirstWriteGenuineSplitAt.ofCompilerSelectedSplit
    (generated : GeneratedTypedSemanticWorldNetworkRevisionAt rooted)
    (successor : SourceNativeLedgerGeneratedSuccessorAt
      generated.initialRestructuringGenerated.occurrence
      generated.initialRestructuringGenerated.wholeLedgerWriteBack)
    (left right : OpenResponsibilityAt generated.NewN
      (generated.newRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        successor.targetOccurrence))
    (children_distinct : left ≠ right)
    (origin_eq : (successor.ledgerEvolution.origin left).1 =
      (successor.ledgerEvolution.origin right).1)
    (parent_origin_eq : (successor.ledgerEvolution.origin left).1 =
      generated.oldTargetOpenLedger.forward rooted.oldTargetEntry)
    (split : SourceNativeSplitCoverageAt
      generated.sourceFixedRestructuringLaw
      generated.initialRestructuringGenerated.occurrence
      successor.ledgerEvolution left right origin_eq)
    (compilerSelectsSplit :
      (generated.exactInitialRestructuringCertification successor).split
          left right origin_eq =
        SourceNativeSplitClassificationAt.split split)
    (initialLedgerNoDormant :
      (entry : OpenResponsibilityAt generated.NewN generated.initialSupport) ->
        Nonempty (Sigma fun oldEntry : OpenResponsibilityAt N
          (oldWorld.toRoot.supportAt rooted.oldSuccessor.next) =>
          PLift (generated.oldTargetOpenLedger.forward oldEntry = entry)) ∨
        entry = generated.newOnlyEntry)
    (targetOriginsCovered :
      (targetEntry : OpenResponsibilityAt generated.NewN
        (generated.newRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
          successor.targetOccurrence)) ->
        Nonempty (Sigma fun oldEntry : OpenResponsibilityAt N
          (oldWorld.toRoot.supportAt rooted.oldSuccessor.next) =>
          PLift ((successor.ledgerEvolution.origin targetEntry).1 =
            generated.oldTargetOpenLedger.forward oldEntry)) ∨
        (successor.ledgerEvolution.origin targetEntry).1 =
          generated.newOnlyEntry) :
    SourceGeneratedFirstWriteGenuineSplitAt generated :=
  ⟨successor, left, right, children_distinct, origin_eq,
    parent_origin_eq, split, compilerSelectsSplit,
    initialLedgerNoDormant, targetOriginsCovered⟩

namespace SourceGeneratedFirstWriteGenuineSplitAt

/-- Left child spends the exact migrated parent's source-owned budget. -/
theorem left_budget_strictly_debited
    {generated : GeneratedTypedSemanticWorldNetworkRevisionAt rooted}
    (split : SourceGeneratedFirstWriteGenuineSplitAt generated) :
    split.left.progressBudget <
      (generated.oldTargetOpenLedger.forward
        rooted.oldTargetEntry).progressBudget := by
  have strict := split.split.childProgressBudget_strictlyDebited
    split.left rfl
  rwa [split.parent_origin_eq] at strict

/-- Right child is debited by the same compiler-selected coverage. -/
theorem right_budget_strictly_debited
    {generated : GeneratedTypedSemanticWorldNetworkRevisionAt rooted}
    (split : SourceGeneratedFirstWriteGenuineSplitAt generated) :
    split.right.progressBudget <
      (generated.oldTargetOpenLedger.forward
        rooted.oldTargetEntry).progressBudget := by
  have strict := split.split.childProgressBudget_strictlyDebited
    split.right split.origin_eq.symm
  rwa [split.parent_origin_eq] at strict

/-- The exact source-fixed compiler, not a sibling receipt, selected this
split classification. -/
theorem compiler_selects_exact_split
    {generated : GeneratedTypedSemanticWorldNetworkRevisionAt rooted}
    (split : SourceGeneratedFirstWriteGenuineSplitAt generated) :
    (generated.exactInitialRestructuringCertification split.successor).split
        split.left split.right split.origin_eq =
      SourceNativeSplitClassificationAt.split split.split :=
  split.compilerSelectsSplit

end SourceGeneratedFirstWriteGenuineSplitAt

/-- A faithful richer coface keeps the revised law surface rooted in its own
world representation and generates a genuine first-write split from the same
source compiler.  The minimal coface still factors into the revision through
`minimal_coface_initial`; equality with the minimal network is no longer
required. -/
structure SourceGeneratedFaithfulRicherCofaceRestructuringAt
    (generated : GeneratedTypedSemanticWorldNetworkRevisionAt rooted) : Prop where
  lawSurface_heq : HEq generated.newLivingRoot.source.base.lawSurface
    (TheoryState.rootSemantic generated.NewN)
  genuineFirstWriteSplit :
    Nonempty (SourceGeneratedFirstWriteGenuineSplitAt generated)

/-- Grounding accepted by the unique U8 realization carrier.  Both branches
erase to proof data around the same single generated occurrence. -/
inductive RevisionGroundingAt
    (generated : GeneratedTypedSemanticWorldNetworkRevisionAt rooted) : Prop
  | exact (grounding : generated.ExactFieldGrounding)
  | richer
      (grounding : generated.SourceGeneratedFaithfulRicherCofaceRestructuringAt)

end GeneratedTypedSemanticWorldNetworkRevisionAt

/-- Every typed-semantic revision realizes the obstruction-generated minimal
coface.  The translated old ledger is its inherited face, while the generated
new-only row is the distinguished obstruction coordinate. -/
def GeneratedTypedSemanticWorldNetworkRevisionAt.toAdmissibleMinimalCoface
    {N : WorldRelationNetwork.{u}}
    {OldV : Vocabulary.{u}}
    {oldWorld : SourceNativeAuthoritativeRootClosure N OldV}
    {oldVisit : SourceNativeTemporalVisitAt oldWorld.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {oldTheory : TheoryState N}
    {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    {rooted : RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7 failure}
    (revision : GeneratedTypedSemanticWorldNetworkRevisionAt rooted) :
    AdmissibleCofaceRevisionAt rooted where
  Carrier := OpenResponsibilityAt revision.NewN
    revision.initialSupport
  oldLedger := revision.oldTargetOpenLedger
  obstructionCoordinate := revision.newOnlyEntry
  obstructionCoordinate_hasNoOldPreimage :=
    revision.newOnlyEntry_hasNoOldPreimage
  progressBudgetAt := fun entry => entry.progressBudget
  inheritedProgressBudget_not_refilled :=
    revision.oldTargetOpenProgressBudget_not_refilled
  obstructionProgressBudget_eq_zero :=
    revision.newOnlyProgressBudget_eq_zero
  IncidenceCarrier := revision.NewN.Incidence
  oldIncidenceEmbedding := revision.translation.incidence
  obstructionIncidence := revision.newOnlyIncidence
  obstructionIncidence_hasNoOldPreimage :=
    revision.newOnlyIncidence_hasNoOldPreimage
  ClaimCarrier := revision.NewN.Claim
  oldClaimEmbedding := revision.translation.claim
  obstructionClaim := revision.revisedClaim
  obstructionClaim_hasNoOldPreimage :=
    revision.revisedClaim_hasNoOldPreimage

/-- Canonical faithful factorization of the generated minimal coface into one
typed-semantic realization. -/
def GeneratedTypedSemanticWorldNetworkRevisionAt.minimalCofaceMorphism
    {N : WorldRelationNetwork.{u}}
    {OldV : Vocabulary.{u}}
    {oldWorld : SourceNativeAuthoritativeRootClosure N OldV}
    {oldVisit : SourceNativeTemporalVisitAt oldWorld.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {oldTheory : TheoryState N}
    {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    {rooted : RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7 failure}
    (revision : GeneratedTypedSemanticWorldNetworkRevisionAt rooted) :
    FaithfulCofaceMorphism
      (root_obstruction_generates_minimal_coface rooted)
      revision.toAdmissibleMinimalCoface :=
  minimal_coface_initial _ _

/-- One typed revision is an actual realization of the obstruction-attached
coface, not merely a carrier with one extra point.

The direction and its exact old-obstruction boundary come from the minimal
coface producer.  `directionEntry_eq` identifies that direction with the
revised root's new-only live row; `firstWriteConsumes` then places the row in
the exact initial whole-ledger evolution owned by `firstWrite`. -/
structure SourceGeneratedAttachedCofaceRealizationAt
    {N : WorldRelationNetwork.{u}} {OldV : Vocabulary.{u}}
    {oldWorld : SourceNativeAuthoritativeRootClosure N OldV}
    {oldVisit : SourceNativeTemporalVisitAt oldWorld.toLedgerRoot}
    {U7 : U7ProducerCalculus N} {oldTheory : TheoryState N}
    {support : N.Support} {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    {rooted : RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7 failure}
    (revision : GeneratedTypedSemanticWorldNetworkRevisionAt rooted) :
    Type (u + 1) where
  private mk ::
  attachment : SourceGeneratedAttachingDirectionAt rooted
  directionEntry_eq :
    revision.minimalCofaceMorphism.map
      (.obstruction attachment.direction) = revision.newOnlyEntry
  firstWrite : CanonicalFirstRootWriteAt revision.newRoot.toLedgerRoot
  firstWriteConsumes :
    SourceNativeTemporalVisitGeneratedEvolutionAt.GeneratedEntryRowAt
      (revision.newRoot.toLedgerRoot.generatedAtTemporalVisit
        (.finite revision.newRoot.toRoot.initialVisit))
      revision.newOnlyEntry

/-- Canonical attached-coface realization read from the typed revision.  No
direction, row, occurrence, or first-write receipt is an input. -/
def GeneratedTypedSemanticWorldNetworkRevisionAt.attachedCofaceRealization
    {N : WorldRelationNetwork.{u}} {OldV : Vocabulary.{u}}
    {oldWorld : SourceNativeAuthoritativeRootClosure N OldV}
    {oldVisit : SourceNativeTemporalVisitAt oldWorld.toLedgerRoot}
    {U7 : U7ProducerCalculus N} {oldTheory : TheoryState N}
    {support : N.Support} {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    {rooted : RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7 failure}
    (revision : GeneratedTypedSemanticWorldNetworkRevisionAt rooted) :
    SourceGeneratedAttachedCofaceRealizationAt revision := by
  let generated := root_obstruction_generates_minimal_coface rooted
  let attachment := generated.attachingDirection
  refine ⟨attachment, ?_, revision.firstWrite, revision.newOnlyEntryRow⟩
  rw [attachment.direction.eq_completion]
  exact revision.minimalCofaceMorphism.obstruction_commutes

/-- Full initiality readout for an actual typed realization.

Every lawful revised root factors through the obstruction-generated minimal
coface, and the very same factorization identifies its generated direction
with the new-only row consumed by the first whole-ledger write.  This theorem
adds no candidate field: extra domain structure can only remain a dependent
face of `revision`. -/
def GeneratedTypedSemanticWorldNetworkRevisionAt.factorizesThroughInitialCoface
    {N : WorldRelationNetwork.{u}} {OldV : Vocabulary.{u}}
    {oldWorld : SourceNativeAuthoritativeRootClosure N OldV}
    {oldVisit : SourceNativeTemporalVisitAt oldWorld.toLedgerRoot}
    {U7 : U7ProducerCalculus N} {oldTheory : TheoryState N}
    {support : N.Support} {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    {rooted : RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7 failure}
    (revision : GeneratedTypedSemanticWorldNetworkRevisionAt rooted) :
    FaithfulCofaceMorphism
        (root_obstruction_generates_minimal_coface rooted)
        revision.toAdmissibleMinimalCoface ×
      SourceGeneratedAttachedCofaceRealizationAt revision :=
  ⟨revision.minimalCofaceMorphism, revision.attachedCofaceRealization⟩

/-- Two successive typed revisions on one generated root history accumulate
their whole-network incidence and claim directions.  The second visit is a
visit of the first revision's generated `newRoot`, so this is not a pairing
of sibling worlds.  Live-row capacity is intentionally absent: the second
extension changes support and its ledger evolution is not generally a
constructive retract. -/
def GeneratedTypedSemanticWorldNetworkRevisionAt.successiveWholeNetworkCapacities
    {N : WorldRelationNetwork.{u}} {OldV : Vocabulary.{u}}
    {oldWorld : SourceNativeAuthoritativeRootClosure N OldV}
    {oldVisit : SourceNativeTemporalVisitAt oldWorld.toLedgerRoot}
    {U7₁ : U7ProducerCalculus N} {oldTheory : TheoryState N}
    {support₁ : N.Support} {obstruction₁ : N.ObstructionAt support₁}
    {failure₁ : ActualExpressibilityFailure oldTheory obstruction₁}
    {rooted₁ : RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7₁ failure₁}
    (first : GeneratedTypedSemanticWorldNetworkRevisionAt rooted₁)
    {secondVisit : SourceNativeTemporalVisitAt first.newRoot.toLedgerRoot}
    {U7₂ : U7ProducerCalculus first.NewN}
    {middleTheory : TheoryState first.NewN}
    {support₂ : first.NewN.Support}
    {obstruction₂ : first.NewN.ObstructionAt support₂}
    {failure₂ : ActualExpressibilityFailure middleTheory obstruction₂}
    {rooted₂ : RootedActualExpressibilityFailureAt
      first.newRoot secondVisit U7₂ failure₂}
    (second : GeneratedTypedSemanticWorldNetworkRevisionAt rooted₂) :
    RelativeExpressiveCapacity N.Incidence second.NewN.Incidence
        (GeneratedDirectionAt rooted₁ ⊕ GeneratedDirectionAt rooted₂) ×
      RelativeExpressiveCapacity N.Claim second.NewN.Claim
        (GeneratedDirectionAt rooted₁ ⊕ GeneratedDirectionAt rooted₂) :=
  ⟨first.toAdmissibleMinimalCoface.incidenceRelativeCapacity.compose
      second.toAdmissibleMinimalCoface.incidenceRelativeCapacity,
    first.toAdmissibleMinimalCoface.claimRelativeCapacity.compose
      second.toAdmissibleMinimalCoface.claimRelativeCapacity⟩

/-- Source-grounded realization candidate for the obstruction-generated
minimal coface.

This is deliberately not an actual-event authority.  It packages one complete
typed realization.  The compatibility branch fixes every semantic field to
the exact rooted minimal coface.  The richer branch retains that coface by
initial factorization while requiring a compiler-selected, coverage-complete
first-write split and no dormant initial ledger entries.  A fixed source
process must still emit either candidate before it can become the revised
branch of an actual inquiry occurrence. -/
structure FieldGroundedTypedSemanticWorldNetworkRevisionAt
    {N : WorldRelationNetwork.{u}}
    {OldV : Vocabulary.{u}}
    {oldWorld : SourceNativeAuthoritativeRootClosure N OldV}
    {oldVisit : SourceNativeTemporalVisitAt oldWorld.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {oldTheory : TheoryState N}
    {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    (rooted : RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7 failure) :
    Type (u + 9) where
  private mk ::
  occurrence : GeneratedTypedSemanticWorldNetworkRevisionAt rooted
  fieldGrounding : occurrence.RevisionGroundingAt

/-- Compatibility assembler for one exact-minimal realization candidate.
It does not assert that the running source process emitted the candidate. -/
def FieldGroundedTypedSemanticWorldNetworkRevisionAt.ofGeneratedOccurrence
    {N : WorldRelationNetwork.{u}}
    {OldV : Vocabulary.{u}}
    {oldWorld : SourceNativeAuthoritativeRootClosure N OldV}
    {oldVisit : SourceNativeTemporalVisitAt oldWorld.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {oldTheory : TheoryState N}
    {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    {rooted : RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7 failure}
    (occurrence : GeneratedTypedSemanticWorldNetworkRevisionAt rooted)
    (fieldGrounding : occurrence.ExactFieldGrounding) :
    FieldGroundedTypedSemanticWorldNetworkRevisionAt rooted :=
  ⟨occurrence, .exact fieldGrounding⟩

/-- Package a source-generated faithful richer realization.  This is still a
candidate until the fixed inquiry compilation program emits it. -/
def FieldGroundedTypedSemanticWorldNetworkRevisionAt.ofSourceGeneratedRestructuring
    {N : WorldRelationNetwork.{u}}
    {OldV : Vocabulary.{u}}
    {oldWorld : SourceNativeAuthoritativeRootClosure N OldV}
    {oldVisit : SourceNativeTemporalVisitAt oldWorld.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {oldTheory : TheoryState N}
    {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    {rooted : RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7 failure}
    (occurrence : GeneratedTypedSemanticWorldNetworkRevisionAt rooted)
    (grounding :
      occurrence.SourceGeneratedFaithfulRicherCofaceRestructuringAt) :
    FieldGroundedTypedSemanticWorldNetworkRevisionAt rooted :=
  ⟨occurrence, .richer grounding⟩

namespace FieldGroundedTypedSemanticWorldNetworkRevisionAt

variable
    {N : WorldRelationNetwork.{u}}
    {OldV : Vocabulary.{u}}
    {oldWorld : SourceNativeAuthoritativeRootClosure N OldV}
    {oldVisit : SourceNativeTemporalVisitAt oldWorld.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {oldTheory : TheoryState N}
    {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    {rooted : RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7 failure}

/-- Exact typed-semantic realization carried by this grounded candidate. -/
def generate
    (source : FieldGroundedTypedSemanticWorldNetworkRevisionAt rooted) :
    GeneratedTypedSemanticWorldNetworkRevisionAt rooted :=
  source.occurrence

/-- Grounding proof carried by the single generated occurrence. -/
theorem revisionGrounding
    (source : FieldGroundedTypedSemanticWorldNetworkRevisionAt rooted) :
    source.generate.RevisionGroundingAt :=
  source.fieldGrounding

/-- Exact adapter retains its original grounding theorem without making that
claim about richer realizations. -/
theorem exactFieldGrounding_ofGeneratedOccurrence
    (occurrence : GeneratedTypedSemanticWorldNetworkRevisionAt rooted)
    (grounding : occurrence.ExactFieldGrounding) :
    (FieldGroundedTypedSemanticWorldNetworkRevisionAt.ofGeneratedOccurrence
      occurrence grounding).generate.ExactFieldGrounding :=
  grounding

@[simp] theorem revisionGrounding_ofGeneratedOccurrence
    (occurrence : GeneratedTypedSemanticWorldNetworkRevisionAt rooted)
    (grounding : occurrence.ExactFieldGrounding) :
    (FieldGroundedTypedSemanticWorldNetworkRevisionAt.ofGeneratedOccurrence
      occurrence grounding).revisionGrounding = .exact grounding :=
  rfl

@[simp] theorem revisionGrounding_ofSourceGeneratedRestructuring
    (occurrence : GeneratedTypedSemanticWorldNetworkRevisionAt rooted)
    (grounding :
      occurrence.SourceGeneratedFaithfulRicherCofaceRestructuringAt) :
    (ofSourceGeneratedRestructuring occurrence grounding).revisionGrounding =
        GeneratedTypedSemanticWorldNetworkRevisionAt.RevisionGroundingAt.richer
          grounding :=
  rfl

/-- The complete typed realization determines its grounded candidate. -/
theorem eq_of_generate_eq
    {left right : FieldGroundedTypedSemanticWorldNetworkRevisionAt rooted}
    (generated_eq : left.generate = right.generate) : left = right := by
  cases left
  cases right
  cases generated_eq
  rfl

/-- Every generated typed realization receives the canonical faithful
factorization from the same rooted obstruction-generated coface. -/
def generate_minimalCofaceMorphism
    (source : FieldGroundedTypedSemanticWorldNetworkRevisionAt rooted) :
    FaithfulCofaceMorphism
      (root_obstruction_generates_minimal_coface rooted)
      source.generate.toAdmissibleMinimalCoface :=
  source.generate.minimalCofaceMorphism

end FieldGroundedTypedSemanticWorldNetworkRevisionAt

