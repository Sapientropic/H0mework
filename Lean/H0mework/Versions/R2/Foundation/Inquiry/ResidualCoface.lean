import H0mework.Foundation.Source.Root
import H0mework.Foundation.Semantics.TheoryState

/-!
# Free world coface for a root-generated residual

An exact residual may be real even when the old world's obstruction vocabulary
is empty.  This kernel freely adjoins its responsibility, claim, obstruction
and law-surface-extension coordinates at one exact support.  Old coordinates
embed literally; the new coordinate has no old constructor and is never
selected by cardinality or choice.

The construction is representational.  It does not settle the residual or
manufacture a domain equation.  Its initial claim eliminator records the
universal property needed by later root/U7/U8 installation.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace RootGeneratedResidualAdmission

universe u

def ResidualObstructionAt
    (N : WorldRelationNetwork.{u}) (focus : N.Support)
    (Residual : Type u) (support : N.Support) : Type u :=
  N.ObstructionAt support ⊕
    (Residual × ULift.{u, 0} (PLift (support = focus)))

def ResidualOpenAt
    (N : WorldRelationNetwork.{u}) (focus : N.Support)
    (Residual : Type u) (support : N.Support) :
    (N.Responsibility ⊕ Residual) → Type u
  | .inl responsibility => N.OpenAt support responsibility
  | .inr _ => ULift.{u, 0} (PLift (support = focus))

def ResidualHoldsAt
    (N : WorldRelationNetwork.{u}) (focus : N.Support)
    (Residual : Type u) (support : N.Support) :
    (N.Claim ⊕ Residual) → Type u
  | .inl claim => N.HoldsAt support claim
  | .inr _ => ULift.{u, 0} (PLift (support = focus))

def ResidualSemanticChangeAt
    (N : WorldRelationNetwork.{u}) (_focus : N.Support)
    (Residual : Type u) (support : N.Support) :
    (N.Claim ⊕ Residual) → (N.Claim ⊕ Residual) → Type u
  | .inl oldClaim, .inl newClaim =>
      N.SemanticChangeAt support oldClaim newClaim
  | _, _ => PEmpty

def ResidualDispositionAt
    (N : WorldRelationNetwork.{u}) (focus : N.Support)
    (Residual : Type u) (support : N.Support) :
    WorldDispositionKind → Type u
  | .supportSettlement => N.DispositionAt support .supportSettlement
  | .transfer => N.DispositionAt support .transfer
  | .lawSurfaceExtension =>
      N.DispositionAt support .lawSurfaceExtension ⊕
        (Residual × ULift.{u, 0} (PLift (support = focus)))

/-- Canonical obstruction-vocabulary coface generated by one residual family.
Support, anchor, incidence and lineage remain unchanged. -/
def extendedNetwork
    (N : WorldRelationNetwork.{u}) (focus : N.Support)
    (Residual : Type u) : WorldRelationNetwork.{u} where
  Support := N.Support
  Anchor := N.Anchor
  Incidence := N.Incidence
  Lineage := N.Lineage
  Responsibility := N.Responsibility ⊕ Residual
  Claim := N.Claim ⊕ Residual
  anchorAt := N.anchorAt
  incidenceAt := N.incidenceAt
  lineageAt := N.lineageAt
  OpenAt := ResidualOpenAt N focus Residual
  openClaimAt := by
    intro support responsibility opened
    cases responsibility with
    | inl responsibility => exact .inl (N.openClaimAt opened)
    | inr residual => exact .inr residual
  openProgressBudgetAt := by
    intro support responsibility opened
    cases responsibility with
    | inl responsibility => exact N.openProgressBudgetAt opened
    | inr _ => exact 0
  HoldsAt := ResidualHoldsAt N focus Residual
  ObstructionAt := ResidualObstructionAt N focus Residual
  obstructionClaim := by
    intro support obstruction
    cases obstruction with
    | inl obstruction => exact .inl (N.obstructionClaim obstruction)
    | inr residual => exact .inr residual.1
  SemanticChangeAt := ResidualSemanticChangeAt N focus Residual
  DispositionAt := ResidualDispositionAt N focus Residual

abbrev ExtendedNetwork
    (N : WorldRelationNetwork.{u}) (focus : N.Support)
    (Residual : Type u) :=
  extendedNetwork N focus Residual

def oldEntry
    {N : WorldRelationNetwork.{u}} {focus : N.Support} {Residual : Type u}
    {support : N.Support} :
    OpenResponsibilityAt N support →
      OpenResponsibilityAt (ExtendedNetwork N focus Residual) support
  | ⟨responsibility, opened⟩ => ⟨.inl responsibility, opened⟩

def residualEntry
    {N : WorldRelationNetwork.{u}} (focus : N.Support) {Residual : Type u}
    (residual : Residual) :
    OpenResponsibilityAt (ExtendedNetwork N focus Residual) focus :=
  ⟨.inr residual, ULift.up (PLift.up rfl)⟩

/-- The free residual coface creates a new semantic claim. It cannot be
used as payment of any inherited debt, even at the same support. -/
theorem oldEntry_residualEntry_not_sameDebt
    {N : WorldRelationNetwork.{u}} (focus : N.Support) {Residual : Type u}
    (old : OpenResponsibilityAt N focus) (residual : Residual) :
    IsEmpty (RootDebtLineageAt (ExtendedNetwork N focus Residual)
      (oldEntry old) (residualEntry focus residual)) :=
  ⟨fun alleged => Sum.inl_ne_inr alleged.claim_eq⟩

def oldObstruction
    {N : WorldRelationNetwork.{u}} {focus : N.Support} {Residual : Type u}
    {support : N.Support} (obstruction : N.ObstructionAt support) :
    (ExtendedNetwork N focus Residual).ObstructionAt support :=
  .inl obstruction

def residualObstruction
    {N : WorldRelationNetwork.{u}} (focus : N.Support) {Residual : Type u}
    (residual : Residual) :
    (ExtendedNetwork N focus Residual).ObstructionAt focus :=
  .inr ⟨residual, ULift.up (PLift.up rfl)⟩

def residualExtensionReceipt
    {N : WorldRelationNetwork.{u}} (focus : N.Support) {Residual : Type u}
    (residual : Residual) :
    (ExtendedNetwork N focus Residual).DispositionAt
      focus .lawSurfaceExtension :=
  .inr ⟨residual, ULift.up (PLift.up rfl)⟩

@[simp] theorem residualEntry_claim
    {N : WorldRelationNetwork.{u}} (focus : N.Support) {Residual : Type u}
    (residual : Residual) :
    (residualEntry focus residual).claim = .inr residual :=
  rfl

@[simp] theorem residualObstruction_claim
    {N : WorldRelationNetwork.{u}} (focus : N.Support) {Residual : Type u}
    (residual : Residual) :
    (ExtendedNetwork N focus Residual).obstructionClaim
      (residualObstruction focus residual) = .inr residual :=
  rfl

theorem residualObstruction_injective
    {N : WorldRelationNetwork.{u}} (focus : N.Support) (Residual : Type u) :
    Function.Injective
      (residualObstruction (N := N) focus (Residual := Residual)) := by
  intro left right equality
  cases Sum.inr.inj equality
  rfl

theorem oldObstruction_injective
    {N : WorldRelationNetwork.{u}} {focus : N.Support} {Residual : Type u}
    {support : N.Support} :
    Function.Injective
      (oldObstruction (N := N) (focus := focus) (Residual := Residual)
        (support := support)) := by
  intro left right equality
  exact Sum.inl.inj equality

theorem oldObstruction_ne_residual
    {N : WorldRelationNetwork.{u}} (focus : N.Support) {Residual : Type u}
    (old : N.ObstructionAt focus) (residual : Residual) :
    oldObstruction (focus := focus) (Residual := Residual) old ≠
      residualObstruction focus residual :=
  Sum.inl_ne_inr

/-- Initial eliminator of the freely adjoined claim coordinate. -/
def claimLift
    {N : WorldRelationNetwork.{u}} {focus : N.Support} {Residual : Type u}
    {Target : Type u}
    (old : N.Claim → Target) (residual : Residual → Target) :
    (ExtendedNetwork N focus Residual).Claim → Target :=
  Sum.elim old residual

@[simp] theorem claimLift_old
    {N : WorldRelationNetwork.{u}} {focus : N.Support} {Residual : Type u}
    {Target : Type u} (old : N.Claim → Target)
    (residual : Residual → Target) (claim : N.Claim) :
    claimLift (focus := focus) old residual (.inl claim) = old claim :=
  rfl

@[simp] theorem claimLift_residual
    {N : WorldRelationNetwork.{u}} {focus : N.Support} {Residual : Type u}
    {Target : Type u} (old : N.Claim → Target)
    (residual : Residual → Target) (coordinate : Residual) :
    claimLift (focus := focus) old residual (.inr coordinate) =
      residual coordinate :=
  rfl

theorem claimLift_unique
    {N : WorldRelationNetwork.{u}} {focus : N.Support} {Residual : Type u}
    {Target : Type u} (old : N.Claim → Target)
    (residual : Residual → Target)
    (candidate : (ExtendedNetwork N focus Residual).Claim → Target)
    (candidate_old : (claim : N.Claim) → candidate (.inl claim) = old claim)
    (candidate_residual : (coordinate : Residual) →
      candidate (.inr coordinate) = residual coordinate)
    (claim : (ExtendedNetwork N focus Residual).Claim) :
    candidate claim = claimLift (focus := focus) old residual claim := by
  cases claim with
  | inl claim => exact candidate_old claim
  | inr coordinate => exact candidate_residual coordinate

/-- The old theory is transported faithfully on old claims and has no syntax
or lawful-realization constructor for the newly adjoined residual claim. -/
def liftTheory
    {N : WorldRelationNetwork.{u}} (focus : N.Support) {Residual : Type u}
    (old : TheoryState N) : TheoryState (ExtendedNetwork N focus Residual) where
  inventory :=
    { Version := old.inventory.Version
      version := old.inventory.version
      Law := old.inventory.Law
      RealizationAt := by
        intro support obstruction
        cases obstruction with
        | inl obstruction => exact old.inventory.RealizationAt obstruction
        | inr _ => exact PEmpty
      RealizationWithoutAt := by
        intro law support obstruction
        cases obstruction with
        | inl obstruction =>
            exact old.inventory.RealizationWithoutAt law obstruction
        | inr _ => exact PEmpty }
  ExpressionAt := old.ExpressionAt
  denotes := fun expression => .inl (old.denotes expression)
  TheoremAt := old.TheoremAt
  theoremPresentation := by
    intro support expression
    exact old.theoremPresentation expression

/-- The free residual coordinate is an exact representation failure of the
transported old theory, even when that old theory was root-semantic on `N`. -/
def residualFailure
    {N : WorldRelationNetwork.{u}} (focus : N.Support) {Residual : Type u}
    (old : TheoryState N) (residual : Residual) :
    ActualExpressibilityFailure (liftTheory focus old)
      (residualObstruction focus residual) where
  notExpressible := ⟨by
    rintro ⟨expression, equality⟩
    change Sum.inl (old.denotes expression) = Sum.inr residual at equality
    exact Sum.inl_ne_inr equality⟩
  noLawfulRealization := ⟨fun impossible => nomatch impossible⟩

end RootGeneratedResidualAdmission
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
