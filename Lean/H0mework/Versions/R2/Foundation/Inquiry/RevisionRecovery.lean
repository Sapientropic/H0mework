import H0mework.Versions.R2.Foundation.Inquiry.RevisionLifecycle
import H0mework.Versions.R2.Foundation.Authority.EntryDisposition

/-!
# Root-native recovery of a typed semantic world revision

A typed semantic U8 revision has already generated a revised root, one strict
first write, the migrated old causal entry, and a genuinely new semantic
incidence.  First-write lifecycle continuity carries both rows to the same
target root occurrence.  This kernel makes that occurrence the independent
consumer court.

The pre-emitter U8 source law already identifies the migrated old entry with
the exact U7 demand event generated by the rooted expressibility obstruction.
Recovery cannot attach another calculus or event presentation after observing
the old root.  The rooted failure generates the revision occurrence, target
ledger effect, and both target-row answer-and-next tokens.  The new-only
incidence and migrated failure therefore enter the same living root without a
parallel recovery vocabulary.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace TypedSemanticWorldNetworkU8Recovery

open TypedSemanticWorldNetworkU8
open TypedSemanticWorldNetworkU8Lifecycle

universe u

variable
    {N : WorldRelationNetwork.{u}}
    {OldV : Vocabulary.{u}}
    {oldWorld : SourceNativeAuthoritativeRootClosure N OldV}
    {oldVisit : SourceNativeTemporalVisitAt oldWorld.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {oldTheory : TheoryState N}
    {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure oldTheory obstruction}

/-- Every exact row emitted in the revised initial patch enters the living
root's causal answer-and-next compiler with its initial causal authority.
Successor authority or terminal discharge is recovered from that fixed root
token rather than supplied by the U8 recovery layer. -/
def generatedInitialEntryAnswerAndNext
    {rooted : ObstructionGeneratedMinimalCoface.RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7 failure}
    (source : FieldGroundedTypedSemanticWorldNetworkRevisionAt rooted)
    (entry : OpenResponsibilityAt source.generate.NewN
      (source.generate.newRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (source.generate.newRoot.emitted
          source.generate.newRoot.toRoot.source.initial)))
    (row : (source.generate.newRoot.toLedgerRoot.generatedAtTemporalVisit
      (.finite source.generate.newRoot.toRoot.initialVisit)).GeneratedEntryRowAt
        entry) :
    let successor : CausalEntrySuccessorAt source.generate.newRoot.toLedgerRoot
        (.finite source.generate.newRoot.toRoot.initialVisit) entry :=
      CausalEntrySuccessorAt.ofNonterminal source.generate.firstWrite.next_eq
    let initialAuthority : SourceNativeLivingTemporalCausalEntryAuthorityAt
        source.generate.newLivingRoot
        (.finite source.generate.newRoot.toRoot.initialVisit) entry :=
      SourceNativeLivingTemporalCausalEntryAuthorityAt.generatedFromInitialRow
        source.generate.newLivingRoot entry row
    SourceNativeLivingCausalEntryAnswerAndNextAt
      source.generate.newLivingRoot successor.targetVisit successor.targetEntry
      (SourceNativeLivingTemporalCausalEntryAuthorityAt.next
        initialAuthority successor.next_eq) := by
  let successor : CausalEntrySuccessorAt source.generate.newRoot.toLedgerRoot
      (.finite source.generate.newRoot.toRoot.initialVisit) entry :=
    CausalEntrySuccessorAt.ofNonterminal source.generate.firstWrite.next_eq
  let initialAuthority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      source.generate.newLivingRoot
      (.finite source.generate.newRoot.toRoot.initialVisit) entry :=
    SourceNativeLivingTemporalCausalEntryAuthorityAt.generatedFromInitialRow
      source.generate.newLivingRoot entry row
  dsimp only
  exact source.generate.newLivingRoot.generatedCausalEntryAnswerAndNextAt
    successor.targetVisit successor.targetEntry
    (SourceNativeLivingTemporalCausalEntryAuthorityAt.next
      initialAuthority successor.next_eq)

/-- The migrated old failure row reaches the target court only through its
generated first-write causal authority. -/
def generatedOldTargetAnswerAndNext
    {rooted : ObstructionGeneratedMinimalCoface.RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7 failure}
    (source : FieldGroundedTypedSemanticWorldNetworkRevisionAt rooted) :
    SourceNativeLivingCausalEntryAnswerAndNextAt source.generate.newLivingRoot
      (oldFirstWriteSuccessor source).targetVisit
      (oldFirstWriteSuccessor source).targetEntry
      (oldFirstWriteTargetAuthority source) :=
  generatedInitialEntryAnswerAndNext source
    (revisedOldEntryAtRoot source.generate) source.generate.oldEntryRow

/-- The new-only semantic row is adjudicated by the same target root and
retains its independent causal authority. -/
def generatedNewTargetAnswerAndNext
    {rooted : ObstructionGeneratedMinimalCoface.RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7 failure}
    (source : FieldGroundedTypedSemanticWorldNetworkRevisionAt rooted) :
    SourceNativeLivingCausalEntryAnswerAndNextAt source.generate.newLivingRoot
      (newFirstWriteSuccessor source).targetVisit
      (newFirstWriteSuccessor source).targetEntry
      (newFirstWriteTargetAuthority source) :=
  generatedInitialEntryAnswerAndNext source
    (revisedNewOnlyEntryAtRoot source.generate) source.generate.newOnlyEntryRow

/-- Full initial-coface completion of one field-grounded revision.

The same generated value carries the initial universal factorization, the
first-write attaching realization, and both live-row answer-and-next tokens.
No equation or domain presentation participates in this completion. -/
def factorizesThroughInitialCofaceAnswerAndNext
    {rooted : ObstructionGeneratedMinimalCoface.RootedActualExpressibilityFailureAt
      oldWorld oldVisit U7 failure}
    (source : FieldGroundedTypedSemanticWorldNetworkRevisionAt rooted) :
    (ObstructionGeneratedMinimalCoface.FaithfulCofaceMorphism
          (ObstructionGeneratedMinimalCoface.root_obstruction_generates_minimal_coface rooted)
          source.generate.toAdmissibleMinimalCoface ×
        TypedSemanticWorldNetworkU8.SourceGeneratedAttachedCofaceRealizationAt
          source.generate) ×
      (SourceNativeLivingCausalEntryAnswerAndNextAt source.generate.newLivingRoot
          (oldFirstWriteSuccessor source).targetVisit
          (oldFirstWriteSuccessor source).targetEntry
          (oldFirstWriteTargetAuthority source) ×
        SourceNativeLivingCausalEntryAnswerAndNextAt source.generate.newLivingRoot
          (newFirstWriteSuccessor source).targetVisit
          (newFirstWriteSuccessor source).targetEntry
          (newFirstWriteTargetAuthority source)) :=
  ⟨source.generate.factorizesThroughInitialCoface,
    generatedOldTargetAnswerAndNext source,
    generatedNewTargetAnswerAndNext source⟩

end TypedSemanticWorldNetworkU8Recovery
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
