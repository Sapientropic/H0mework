/-!
# Source-native root inquiry foundation

This kernel defines the query event, U7-first audit, exact failure face,
minimal-coface realization and source-generated answer-and-next used by the
inquiry engine.

The internal order is fixed:

```text
exact root inquiry occurrence
→ source-generated U7 disposition
→ U7 settlement/paid-redirect answer
  | theory audit
    → old-language expression and realization
    | exact joint failure → fixed-root U8 → revised answer
→ source-generated next engine state
```

The inquiry audit is an installed face of the fixed root projection inventory.
Question and answer are restrictions of generated occurrences.  U8 returns
the obstruction-generated attaching direction; domain equations remain
separate dependent faces of the revised source occurrence.
This file is fully constructive.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace RootInquiryCompletion

open ObstructionGeneratedMinimalCoface
open TypedSemanticWorldNetworkU8
open TypedSemanticWorldNetworkU8Lifecycle
open TypedSemanticWorldNetworkU8Recovery

universe u

/-- A source-owned old-language answer.  Expression and lawful realization
must coexist at the exact obstruction support; neither an inhabited syntax
fibre nor a theorem-shaped proposition is sufficient on its own. -/
structure OldLanguageAnswerAt
    {N : WorldRelationNetwork.{u}}
    (oldTheory : TheoryState N)
    {support : N.Support}
    (obstruction : N.ObstructionAt support) : Type (u + 1) where
  expression : oldTheory.ExpressesAt support
    (N.obstructionClaim obstruction)
  realization : oldTheory.inventory.RealizationAt obstruction

/-- U7 settlement answers the inquiry immediately.  A redirect has answer
authority only when its exact successor demand entry strictly spends the
source-owned responsibility budget.  A neutral redirect remains a raw U7
evolution; it cannot certify that the inquiry has been answered. -/
def SourceNativeU7AnswersAt
    {N : WorldRelationNetwork.{u}}
    {U7 : U7ProducerCalculus N}
    (calculus : U7ObstructionEvolutionCalculus N U7)
    {support : N.Support}
    (obstruction : N.ObstructionAt support) : Type u :=
  let generated := calculus.generated obstruction
  match generated.2.disposition with
  | .settled _ => PUnit
  | @U7ObstructionDispositionAt.redirected _ _ _ _ _ successor _ =>
      ULift.{u, 0} <| PLift
        (OpenResponsibilityAt.progressBudget
              (U7ActualSuccessorSource.demandEntry
                (calculus.source.emit successor)) <
          OpenResponsibilityAt.progressBudget
            (U7ActualSuccessorSource.demandEntry generated.1))
  | .requiresTheoryAudit _ => PEmpty

/-- One actual restriction of an exact living-root occurrence.  Its payload
type and value are both generated by the root projection compiler; there is
no independent semantic result carrier. -/
structure SourceNativeRootSemanticFaceAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V)
    (visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot) :
    Type (u + 1) where
  projection : root.toAuthoritativeRoot.source.projectionLaw.Projection
  active : root.toAuthoritativeRoot.source.projectionLaw.ActiveAt
    projection (root.emitted visit.current)
  classifier_eq :
    root.toAuthoritativeRoot.source.projectionLaw.classify projection
        (root.emitted visit.current) =
      .inl active

namespace SourceNativeRootSemanticFaceAt

/-- The presentation type of this restriction, derived from reality rather
than installed as a query result contract. -/
def Restriction
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot}
    (face : SourceNativeRootSemanticFaceAt root visit) : Type u :=
  root.toAuthoritativeRoot.source.projectionLaw.PayloadAt
    face.projection (root.emitted visit.current) face.active

/-- Root read is the occurrence's own payload. -/
def rootRead
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot}
    (face : SourceNativeRootSemanticFaceAt root visit) : face.Restriction :=
  root.toAuthoritativeRoot.source.projectionLaw.project
    face.projection (root.emitted visit.current) face.active

end SourceNativeRootSemanticFaceAt

/-- Source-native inquiry audit after U7 has already generated its exact
disposition.  Settlement or an exact budget-decreasing redirect answers
immediately.  A theory-audit demand is checked against both old expression
and complete lawful realization fibres; only their exact joint failure
requests U8. -/
inductive SourceNativeInquiryAuditAt
    {N : WorldRelationNetwork.{u}}
    (U7 : U7ProducerCalculus N)
    (calculus : U7ObstructionEvolutionCalculus N U7)
    (oldTheory : TheoryState N)
    {support : N.Support}
    (obstruction : N.ObstructionAt support) : Type (u + 2)
  | u7Answered
      (disposition : SourceNativeU7AnswersAt calculus obstruction) :
      SourceNativeInquiryAuditAt U7 calculus oldTheory obstruction
  | oldLanguageAnswered
      (u7Gate : SourceNativeU7TheoryAuditAt calculus
        (calculus.generated obstruction).1)
      (answer : OldLanguageAnswerAt oldTheory obstruction) :
      SourceNativeInquiryAuditAt U7 calculus oldTheory obstruction
  | requiresU8
      (u7Gate : SourceNativeU7TheoryAuditAt calculus
        (calculus.generated obstruction).1)
      (failure : ActualExpressibilityFailure oldTheory obstruction) :
      SourceNativeInquiryAuditAt U7 calculus oldTheory obstruction

/-- Source-level inquiry result before an obstruction has been assumed.
The source either answers directly or emits the exact obstruction whose U7
audit governs the remainder of the transition. -/
inductive SourceNativeInquiryFrontAuditAt
    {N : WorldRelationNetwork.{u}}
    (U7 : U7ProducerCalculus N)
    (calculus : U7ObstructionEvolutionCalculus N U7)
    (oldTheory : TheoryState N)
    (support : N.Support) : Type (u + 2)
  | answered
  | obstructed
      (obstruction : N.ObstructionAt support)
      (audit : SourceNativeInquiryAuditAt
        U7 calculus oldTheory obstruction)

/-- Root-generated consumer receipt for one exact inquiry event, answer value,
and live-ledger incidence.  The entry index prevents a grounded answer field
from borrowing the causal authority of a sibling responsibility row. -/
inductive SourceNativeInquiryAnswerConsumerTokenAt
    {N : WorldRelationNetwork.{u}} {support : N.Support}
    {Query : Type u}
    (query : Query)
    {InquiryEvent : Type (u + 1)}
    (event : InquiryEvent)
    (entry : OpenResponsibilityAt N support)
    {Answer : Type u}
    (answer : Answer) : Type u
  | canonical

/-- Independent root consumer of an answer face.  The project equation ties
the consumer coordinate to both the emitted inquiry event and the literal
root read. -/
structure SourceNativeInquiryAnswerConsumerAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot}
    {Query : Type u}
    (query : Query)
    {InquiryEvent : Type (u + 1)}
    (event : InquiryEvent)
    (entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current)))
    (answerFace : SourceNativeRootSemanticFaceAt root visit) : Type (u + 1) where
  projection : root.toAuthoritativeRoot.source.projectionLaw.Projection
  active : root.toAuthoritativeRoot.source.projectionLaw.ActiveAt
    projection (root.emitted visit.current)
  classifier_eq :
    root.toAuthoritativeRoot.source.projectionLaw.classify projection
        (root.emitted visit.current) =
      .inl active
  project_heq : HEq
    (root.toAuthoritativeRoot.source.projectionLaw.project
      projection (root.emitted visit.current) active)
    (SourceNativeInquiryAnswerConsumerTokenAt.canonical :
      SourceNativeInquiryAnswerConsumerTokenAt
        query event entry answerFace.rootRead)

namespace SourceNativeInquiryAnswerConsumerAt

/-- The answer consumer is an installed face of the exact temporal root
occurrence.  Its token retains the inquiry event, live-ledger row and literal
root read; a sibling face or row therefore cannot pay this consumer. -/
theorem installedAuthority_factorizes
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot}
    {Query : Type u} {query : Query}
    {InquiryEvent : Type (u + 1)} {event : InquiryEvent}
    {entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {answerFace : SourceNativeRootSemanticFaceAt root visit}
    (consumer : SourceNativeInquiryAnswerConsumerAt
      query event entry answerFace) :
    let generated := root.toAuthoritativeRoot.toLedgerRoot
      |>.generatedAtTemporalVisit visit
    HEq
      (root.toAuthoritativeRoot.source.projectionLaw.project
        consumer.projection generated.occurrence consumer.active)
      (SourceNativeInquiryAnswerConsumerTokenAt.canonical :
        SourceNativeInquiryAnswerConsumerTokenAt
          query event entry answerFace.rootRead) := by
  dsimp only
  exact consumer.project_heq

end SourceNativeInquiryAnswerConsumerAt

/-- Pre-authority coface frontier generated by one exact old-root inquiry
failure after U7 has required a theory audit.

This frontier is a build-time obligation, not a world disposition.  It has
no revised source, answer, consumer, branch, settlement or next current.
Only after a concrete source faithfully realizes its generated minimal coface
may the finished compiler construct the `requiresU8` branch below. -/
structure SourceNativeInquiryCofaceFrontierAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V)
    (visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot)
    (U7 : U7ProducerCalculus N)
    (calculus : U7ObstructionEvolutionCalculus N U7)
    (oldTheory : TheoryState N)
    {Query : Type u} (query : Query)
    {InquiryEvent : Type (u + 1)} (event : InquiryEvent)
    (entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current)))
    (authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry)
    (obstruction : N.ObstructionAt
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current)))
    (u7Gate : SourceNativeU7TheoryAuditAt calculus
      (calculus.generated obstruction).1)
    (failure : ActualExpressibilityFailure oldTheory obstruction) :
    Type (u + 7) where
  private mk ::
  face : SourceNativeRootExpressibilityFailureFaceAt
    root.toAuthoritativeRoot visit (U7 := U7) failure
  rootEntry_eq : face.rootEntry = entry
  successor : CausalEntrySuccessorAt
    root.toAuthoritativeRoot.toLedgerRoot visit face.rootEntry

/-- Historical material spelling retained only for source compatibility. -/
abbrev SourceNativeInquiryMaterialFrontierAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V)
    (visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot)
    (U7 : U7ProducerCalculus N)
    (calculus : U7ObstructionEvolutionCalculus N U7)
    (oldTheory : TheoryState N)
    {Query : Type u} (query : Query)
    {InquiryEvent : Type (u + 1)} (event : InquiryEvent)
    (entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current)))
    (authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry)
    (obstruction : N.ObstructionAt
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current)))
    (u7Gate : SourceNativeU7TheoryAuditAt calculus
      (calculus.generated obstruction).1)
    (failure : ActualExpressibilityFailure oldTheory obstruction) :=
  SourceNativeInquiryCofaceFrontierAt
    root visit U7 calculus oldTheory query event entry authority
      obstruction u7Gate failure

namespace SourceNativeInquiryCofaceFrontierAt

variable
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {calculus : U7ObstructionEvolutionCalculus N U7}
    {oldTheory : TheoryState N}
    {Query : Type u} {query : Query}
    {InquiryEvent : Type (u + 1)} {event : InquiryEvent}
    {entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry}
    {obstruction : N.ObstructionAt
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {u7Gate : SourceNativeU7TheoryAuditAt calculus
      (calculus.generated obstruction).1}
    {failure : ActualExpressibilityFailure oldTheory obstruction}

/-- The fixed failure face, row equality and causal successor generate the
only coface frontier for this named source construction. -/
def ofRootFailureFace
    (face : SourceNativeRootExpressibilityFailureFaceAt
      root.toAuthoritativeRoot visit (U7 := U7) failure)
    (rootEntry_eq : face.rootEntry = entry)
    (successor : CausalEntrySuccessorAt
      root.toAuthoritativeRoot.toLedgerRoot visit face.rootEntry) :
    SourceNativeInquiryCofaceFrontierAt
      root visit U7 calculus oldTheory query event entry authority
        obstruction u7Gate failure :=
  ⟨face, rootEntry_eq, successor⟩

/-- Exact rooted failure retained by the build frontier. -/
def rooted
    (frontier : SourceNativeInquiryCofaceFrontierAt
      root visit U7 calculus oldTheory query event entry authority
        obstruction u7Gate failure) :
    RootedActualExpressibilityFailureAt
      root.toAuthoritativeRoot visit U7 failure :=
  RootedActualExpressibilityFailureAt.ofRootFailureFace frontier.face
    (frontier.rootEntry_eq.symm ▸ authority.toAuthoritativeAuthority)
    frontier.successor

/-- The exact obstruction generates its canonical initial coface before any
concrete revised source exists. -/
def coface
    (frontier : SourceNativeInquiryCofaceFrontierAt
      root visit U7 calculus oldTheory query event entry authority
        obstruction u7Gate failure) :
    GeneratedMinimalCofaceAt frontier.rooted :=
  root_obstruction_generates_minimal_coface frontier.rooted

end SourceNativeInquiryCofaceFrontierAt

/-- The exact strike output for one rooted coface frontier.

The candidate constructs one concrete revised source realization.  No
attachment program, equation, answer or compiler is a field; dependency
certification audits the whole source choice. -/
structure SourceNativeInquiryCofaceRealizationAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {calculus : U7ObstructionEvolutionCalculus N U7}
    {oldTheory : TheoryState N}
    {Query : Type u} {query : Query}
    {InquiryEvent : Type (u + 1)} {event : InquiryEvent}
    {entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry}
    {obstruction : N.ObstructionAt
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {u7Gate : SourceNativeU7TheoryAuditAt calculus
      (calculus.generated obstruction).1}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    (frontier : SourceNativeInquiryCofaceFrontierAt
      root visit U7 calculus oldTheory query event entry authority
        obstruction u7Gate failure) : Type (u + 8) where
  /-- Exact-minimal candidates use the default.  A faithful richer candidate
  may name only the network already generated by its typed revision; the
  installation certificate below still locks the complete ledger source to
  the core's single revised root. -/
  NewN : WorldRelationNetwork.{u} := frontier.coface.worldNetwork
  NewV : Vocabulary.{u}
  source : SourceNativeLedgerSource NewN NewV

namespace SourceNativeInquiryCofaceRealizationAt

/-- Compatibility constructor for the exact canonical minimal coface. -/
def ofExactCofaceSource
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {calculus : U7ObstructionEvolutionCalculus N U7}
    {oldTheory : TheoryState N}
    {Query : Type u} {query : Query}
    {InquiryEvent : Type (u + 1)} {event : InquiryEvent}
    {entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry}
    {obstruction : N.ObstructionAt
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {u7Gate : SourceNativeU7TheoryAuditAt calculus
      (calculus.generated obstruction).1}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    {frontier : SourceNativeInquiryCofaceFrontierAt
      root visit U7 calculus oldTheory query event entry authority
        obstruction u7Gate failure}
    {NewV : Vocabulary.{u}}
    (source : SourceNativeLedgerSource frontier.coface.worldNetwork NewV) :
    SourceNativeInquiryCofaceRealizationAt frontier where
  NewV := NewV
  source := source

/-- Candidate readout of the exact source carried by one generated typed
revision.  Installation still requires the inquiry core's `source_heq`; this
constructor does not create a runtime or second U8. -/
def ofGeneratedRevision
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {calculus : U7ObstructionEvolutionCalculus N U7}
    {oldTheory : TheoryState N}
    {Query : Type u} {query : Query}
    {InquiryEvent : Type (u + 1)} {event : InquiryEvent}
    {entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry}
    {obstruction : N.ObstructionAt
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {u7Gate : SourceNativeU7TheoryAuditAt calculus
      (calculus.generated obstruction).1}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    {frontier : SourceNativeInquiryCofaceFrontierAt
      root visit U7 calculus oldTheory query event entry authority
        obstruction u7Gate failure}
    (generated : GeneratedTypedSemanticWorldNetworkRevisionAt
      frontier.rooted) :
    SourceNativeInquiryCofaceRealizationAt frontier where
  NewN := generated.NewN
  NewV := generated.NewV
  source := generated.newRoot.toLedgerRoot.source

end SourceNativeInquiryCofaceRealizationAt

/-- Complete U8 realization generated inside one literal inquiry compiler
branch.  The core stores only the exact failure frontier and its concrete
typed realization.  Coface factorization, attaching direction, first write
and generated next are all read back from those two fields; domain equations
remain independent faces of the revised occurrence. -/
structure SourceGeneratedInquiryU8RevisionCoreAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V)
    (visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot)
    (U7 : U7ProducerCalculus N)
    (calculus : U7ObstructionEvolutionCalculus N U7)
    (oldTheory : TheoryState N)
    {Query : Type u} (query : Query)
    {InquiryEvent : Type (u + 1)} (event : InquiryEvent)
    (entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current)))
    (authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry)
    (obstruction : N.ObstructionAt
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current)))
    (u7Gate : SourceNativeU7TheoryAuditAt calculus
      (calculus.generated obstruction).1)
    (failure : ActualExpressibilityFailure oldTheory obstruction) :
    Type (u + 11) where
  /-- The one U8 opportunity of this exact problem is the source-generated
  old-root coface frontier.  A concrete revised world realizes this fixed
  frontier; it cannot submit a sibling failure face or correction. -/
  frontier : SourceNativeInquiryCofaceFrontierAt
    root visit U7 calculus oldTheory query event entry authority
      obstruction u7Gate failure
  /-- Concrete realization emitted by this exact source compiler. -/
  revision : FieldGroundedTypedSemanticWorldNetworkRevisionAt
    frontier.rooted

namespace SourceGeneratedInquiryU8RevisionCoreAt

/-- Readout of the unique failure face retained by the fixed coface frontier. -/
def face
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {calculus : U7ObstructionEvolutionCalculus N U7}
    {oldTheory : TheoryState N}
    {Query : Type u} {query : Query}
    {InquiryEvent : Type (u + 1)} {event : InquiryEvent}
    {entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry}
    {obstruction : N.ObstructionAt
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {u7Gate : SourceNativeU7TheoryAuditAt calculus
      (calculus.generated obstruction).1}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    (core : SourceGeneratedInquiryU8RevisionCoreAt
      root visit U7 calculus oldTheory query event entry authority
        obstruction u7Gate failure) :=
  core.frontier.face

/-- Compatibility readout of the same-row entry equality. -/
theorem rootEntry_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {calculus : U7ObstructionEvolutionCalculus N U7}
    {oldTheory : TheoryState N}
    {Query : Type u} {query : Query}
    {InquiryEvent : Type (u + 1)} {event : InquiryEvent}
    {entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry}
    {obstruction : N.ObstructionAt
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {u7Gate : SourceNativeU7TheoryAuditAt calculus
      (calculus.generated obstruction).1}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    (core : SourceGeneratedInquiryU8RevisionCoreAt
      root visit U7 calculus oldTheory query event entry authority
        obstruction u7Gate failure) : core.face.rootEntry = entry :=
  core.frontier.rootEntry_eq

/-- Compatibility readout of the exact causal successor retained by the
frontier. -/
def successor
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {calculus : U7ObstructionEvolutionCalculus N U7}
    {oldTheory : TheoryState N}
    {Query : Type u} {query : Query}
    {InquiryEvent : Type (u + 1)} {event : InquiryEvent}
    {entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry}
    {obstruction : N.ObstructionAt
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {u7Gate : SourceNativeU7TheoryAuditAt calculus
      (calculus.generated obstruction).1}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    (core : SourceGeneratedInquiryU8RevisionCoreAt
      root visit U7 calculus oldTheory query event entry authority
        obstruction u7Gate failure) :
    CausalEntrySuccessorAt root.toAuthoritativeRoot.toLedgerRoot visit
      core.face.rootEntry :=
  core.frontier.successor

/-- Exact rooted failure shared by every concrete realization of this one
problem occurrence. -/
def rooted
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {calculus : U7ObstructionEvolutionCalculus N U7}
    {oldTheory : TheoryState N}
    {Query : Type u} {query : Query}
    {InquiryEvent : Type (u + 1)} {event : InquiryEvent}
    {entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry}
    {obstruction : N.ObstructionAt
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {u7Gate : SourceNativeU7TheoryAuditAt calculus
      (calculus.generated obstruction).1}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    (core : SourceGeneratedInquiryU8RevisionCoreAt
      root visit U7 calculus oldTheory query event entry authority
        obstruction u7Gate failure) :=
  core.frontier.rooted

/-- The exact failure-generated attaching direction returned by U8.  It is a
low-universe dependent answer seal, not a domain equation or caller token. -/
def cofaceAnswer
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {calculus : U7ObstructionEvolutionCalculus N U7}
    {oldTheory : TheoryState N}
    {Query : Type u} {query : Query}
    {InquiryEvent : Type (u + 1)} {event : InquiryEvent}
    {entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry}
    {obstruction : N.ObstructionAt
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {u7Gate : SourceNativeU7TheoryAuditAt calculus
      (calculus.generated obstruction).1}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    (core : SourceGeneratedInquiryU8RevisionCoreAt
      root visit U7 calculus oldTheory query event entry authority
        obstruction u7Gate failure) :
    SourceGeneratedAttachingDirectionAt core.rooted :=
  sourceGeneratedAttachingDirection core.rooted

/-- Every concrete core is the faithful realization of the initial coface;
the same realization consumes the new-only row in its first whole-ledger
write. -/
def cofaceFactorization
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {calculus : U7ObstructionEvolutionCalculus N U7}
    {oldTheory : TheoryState N}
    {Query : Type u} {query : Query}
    {InquiryEvent : Type (u + 1)} {event : InquiryEvent}
    {entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry}
    {obstruction : N.ObstructionAt
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {u7Gate : SourceNativeU7TheoryAuditAt calculus
      (calculus.generated obstruction).1}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    (core : SourceGeneratedInquiryU8RevisionCoreAt
      root visit U7 calculus oldTheory query event entry authority
        obstruction u7Gate failure) :=
  core.revision.generate.factorizesThroughInitialCoface

end SourceGeneratedInquiryU8RevisionCoreAt

/-- One complete source compiler image.  Every answering constructor jointly
generates its audit, semantic face and independent consumer.  Only the U8
constructor lacks an old-root answer; the same constructor already contains
the concrete revised-root realization generated by this source occurrence. -/
inductive SourceNativeInquiryCompilationAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V)
    (visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot)
    (U7 : U7ProducerCalculus N)
    (calculus : U7ObstructionEvolutionCalculus N U7)
    (oldTheory : TheoryState N)
    {Query : Type u}
    (query : Query)
    {InquiryEvent : Type (u + 1)}
    (event : InquiryEvent)
    (entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current)))
    (authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry) : Type (u + 11)
  | answered
      (answerFace : SourceNativeRootSemanticFaceAt root visit)
      (consumer : SourceNativeInquiryAnswerConsumerAt
        query event entry answerFace)
  | u7Answered
      (obstruction : N.ObstructionAt
        (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
          (root.emitted visit.current)))
      (disposition : SourceNativeU7AnswersAt calculus obstruction)
      (answerFace : SourceNativeRootSemanticFaceAt root visit)
      (consumer : SourceNativeInquiryAnswerConsumerAt
        query event entry answerFace)
  | oldLanguageAnswered
      (obstruction : N.ObstructionAt
        (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
          (root.emitted visit.current)))
      (gate : SourceNativeU7TheoryAuditAt calculus
        (calculus.generated obstruction).1)
      (oldAnswer : OldLanguageAnswerAt oldTheory obstruction)
      (answerFace : SourceNativeRootSemanticFaceAt root visit)
      (consumer : SourceNativeInquiryAnswerConsumerAt
        query event entry answerFace)
  | actualAction
      {program : SourceNativeSequentialActualActionProgramAt
        root visit entry authority}
      {sourceEvent : ExactTemporalCausalRootEventAt
        root.toAuthoritativeRoot.toLedgerRoot visit}
      (generated : SourceGeneratedSequentialActualActionAt
        program sourceEvent)
  | debtAdmission
      {program : SourceNativeDebtAdmissionActualActionProgramAt
        root visit entry authority}
      {sourceEvent : ExactTemporalCausalRootEventAt
        root.toAuthoritativeRoot.toLedgerRoot visit}
      (generated : SourceGeneratedDebtAdmissionActualActionAt
        program sourceEvent)
  | requiresU8
      (obstruction : N.ObstructionAt
        (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
          (root.emitted visit.current)))
      (gate : SourceNativeU7TheoryAuditAt calculus
        (calculus.generated obstruction).1)
      (failure : ActualExpressibilityFailure oldTheory obstruction)
      (generated : SourceGeneratedInquiryU8RevisionCoreAt
        root visit U7 calculus oldTheory query event entry authority
        obstruction gate failure)

/-- The former front audit is now a readout of the complete compiler image. -/
def SourceNativeInquiryCompilationAt.audit
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {calculus : U7ObstructionEvolutionCalculus N U7}
    {oldTheory : TheoryState N}
    {Query : Type u} {query : Query}
    {InquiryEvent : Type (u + 1)} {event : InquiryEvent}
    {entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry}
    (compiled : SourceNativeInquiryCompilationAt
      root visit U7 calculus oldTheory query event entry authority) :
    SourceNativeInquiryFrontAuditAt U7 calculus oldTheory
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current)) := by
  cases compiled with
  | answered => exact .answered
  | u7Answered obstruction disposition =>
      exact .obstructed obstruction (.u7Answered disposition)
  | oldLanguageAnswered obstruction gate oldAnswer =>
      exact .obstructed obstruction (.oldLanguageAnswered gate oldAnswer)
  | actualAction _ => exact .answered
  | debtAdmission _ => exact .answered
  | requiresU8 obstruction gate failure _ =>
      exact .obstructed obstruction (.requiresU8 gate failure)

/-- Old-root compilation readout selected by one source compiler image.  The
U8 branch uses a zero-information seal here because its actual answer and
consumer are emitted at the revised occurrence below. -/
def SourceNativeInquiryCompilationAt.AnswerCarrier
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {calculus : U7ObstructionEvolutionCalculus N U7}
    {oldTheory : TheoryState N}
    {Query : Type u} {query : Query}
    {InquiryEvent : Type (u + 1)} {event : InquiryEvent}
    {entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry}
    (compiled : SourceNativeInquiryCompilationAt
      root visit U7 calculus oldTheory query event entry authority) :
    Type u :=
  match compiled with
  | .answered answerFace _ => answerFace.Restriction
  | .u7Answered _ _ answerFace _ => answerFace.Restriction
  | .oldLanguageAnswered _ _ _ answerFace _ => answerFace.Restriction
  | .actualAction generated => generated.target.Answer
  | .debtAdmission generated => generated.target.Answer
  | .requiresU8 _ _ _ _ => PUnit

/-- Literal root read selected by one complete source compiler image. -/
def SourceNativeInquiryCompilationAt.answerReadout
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {calculus : U7ObstructionEvolutionCalculus N U7}
    {oldTheory : TheoryState N}
    {Query : Type u} {query : Query}
    {InquiryEvent : Type (u + 1)} {event : InquiryEvent}
    {entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry}
    (compiled : SourceNativeInquiryCompilationAt
      root visit U7 calculus oldTheory query event entry authority) :
    compiled.AnswerCarrier := by
  cases compiled with
  | answered answerFace _ =>
      exact answerFace.rootRead
  | u7Answered _ _ answerFace _ =>
      exact answerFace.rootRead
  | oldLanguageAnswered _ _ _ answerFace _ =>
      exact answerFace.rootRead
  | actualAction generated => exact generated.answer
  | debtAdmission generated => exact generated.answer
  | requiresU8 _ _ _ _ =>
      exact PUnit.unit

/-! ## Exact-occurrence inquiry compilation

`SourceNativeInquiryCompilationAt` remains the structural grammar of an
answer.  Reality authority does not accept a grammar value directly: one
fixed source program must compile it from the exact temporal root occurrence.
Consequently a caller cannot reuse the same problem occurrence and later hand
the engine a second completed U8 core.  A different compiler is an explicit
source-program difference and is subject to the calculation/dependency
firewall rather than being erased by the old-root `PUnit` readout. -/

/-- Source program for one fixed inquiry.  Its only operational input is the
exact temporal occurrence generated by the already registered root visit. -/
structure SourceNativeInquiryCompilationProgramAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V)
    (visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot)
    (U7 : U7ProducerCalculus N)
    (calculus : U7ObstructionEvolutionCalculus N U7)
    (oldTheory : TheoryState N)
    {Query : Type u} (query : Query)
    {InquiryEvent : Type (u + 1)} (event : InquiryEvent)
    (entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current)))
    (authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry) : Type (u + 11) where
  compile : ExactTemporalCausalRootEventAt
      root.toAuthoritativeRoot.toLedgerRoot visit →
    SourceNativeInquiryCompilationAt root visit U7 calculus oldTheory
      query event entry authority

/-- Private execution token of one inquiry compiler at one exact problem
occurrence.  It stores no answer or revised core. -/
structure SourceGeneratedInquiryCompilationAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {calculus : U7ObstructionEvolutionCalculus N U7}
    {oldTheory : TheoryState N}
    {Query : Type u} {query : Query}
    {InquiryEvent : Type (u + 1)} {event : InquiryEvent}
    {entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry}
    (program : SourceNativeInquiryCompilationProgramAt
      root visit U7 calculus oldTheory query event entry authority) :
    Type (u + 11) where
  private mk ::

/-- Execute the fixed compiler on the root's exact generated occurrence. -/
def SourceNativeInquiryCompilationProgramAt.generate
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {calculus : U7ObstructionEvolutionCalculus N U7}
    {oldTheory : TheoryState N}
    {Query : Type u} {query : Query}
    {InquiryEvent : Type (u + 1)} {event : InquiryEvent}
    {entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry}
    (program : SourceNativeInquiryCompilationProgramAt
      root visit U7 calculus oldTheory query event entry authority) :
    SourceGeneratedInquiryCompilationAt program :=
  .mk

/-- The compiler output is recomputed from the exact occurrence; it is not a
field of the execution receipt. -/
def SourceGeneratedInquiryCompilationAt.output
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {calculus : U7ObstructionEvolutionCalculus N U7}
    {oldTheory : TheoryState N}
    {Query : Type u} {query : Query}
    {InquiryEvent : Type (u + 1)} {event : InquiryEvent}
    {entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry}
    {program : SourceNativeInquiryCompilationProgramAt
      root visit U7 calculus oldTheory query event entry authority}
    (_generated : SourceGeneratedInquiryCompilationAt program) :
    SourceNativeInquiryCompilationAt root visit U7 calculus oldTheory
      query event entry authority :=
  program.compile
    (root.toAuthoritativeRoot.toLedgerRoot.exactTemporalCausalEventAt visit)

/-- Repeating one fixed program at one fixed problem occurrence cannot select
a second U8 completion. -/
theorem SourceGeneratedInquiryCompilationAt.output_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {calculus : U7ObstructionEvolutionCalculus N U7}
    {oldTheory : TheoryState N}
    {Query : Type u} {query : Query}
    {InquiryEvent : Type (u + 1)} {event : InquiryEvent}
    {entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry}
    {program : SourceNativeInquiryCompilationProgramAt
      root visit U7 calculus oldTheory query event entry authority}
    (left right : SourceGeneratedInquiryCompilationAt program) :
    left.output = right.output :=
  rfl

/-! ## Coface-realization certification

The build-time repair loop may construct a concrete revised source, but it
cannot install that source by name alone.  The proposition below binds it to
the exact failure-generated frontier and concrete revised core.  Actual
installation is witnessed only when the named runtime consumes that core;
there is no sibling compiler certificate. -/

/-- One concrete source realization is exactly the source consumed by a
complete revised core of the same frontier.  Coface attachment is already a
derived field of the typed revision, so no program witness remains. -/
structure SourceNativeInquiryCofaceRealizationCertificationAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {calculus : U7ObstructionEvolutionCalculus N U7}
    {oldTheory : TheoryState N}
    {Query : Type u} {query : Query}
    {InquiryEvent : Type (u + 1)} {event : InquiryEvent}
    {entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry}
    {obstruction : N.ObstructionAt
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    {u7Gate : SourceNativeU7TheoryAuditAt calculus
      (calculus.generated obstruction).1}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    {frontier : SourceNativeInquiryCofaceFrontierAt
      root visit U7 calculus oldTheory query event entry authority
        obstruction u7Gate failure}
    (candidate : SourceNativeInquiryCofaceRealizationAt frontier)
    (core : SourceGeneratedInquiryU8RevisionCoreAt
      root visit U7 calculus oldTheory query event entry authority
        obstruction u7Gate failure) : Prop where
  frontier_eq : core.frontier = frontier
  source_heq : HEq
    core.revision.generate.newRoot.toLedgerRoot.source candidate.source

/-- Low-universe identity token indexed by one inquiry event, responsibility
incidence and root-generated answer value.  The complete U8 realization now
belongs to the same source compiler image; this token remains its old-root
projection readout rather than a second completion carrier. -/
inductive SourceNativeInquiryCompilationTokenAt
    {N : WorldRelationNetwork.{u}}
    {U7 : U7ProducerCalculus N}
    {calculus : U7ObstructionEvolutionCalculus N U7}
    {oldTheory : TheoryState N}
    {support : N.Support}
    (entry : OpenResponsibilityAt N support)
    {Query : Type u}
    (query : Query)
    {InquiryEvent : Type (u + 1)}
    (event : InquiryEvent)
    (audit : SourceNativeInquiryFrontAuditAt
      U7 calculus oldTheory support)
    (Answer : Type u) : Type u
  | canonical (answer : Answer)

/-- Root-installed image of one complete inquiry compilation.  The face is
indexed by the literal compiler output, so it can be stored by the inquiry
source itself rather than supplied later by a gearbox wrapper. -/
structure SourceNativeRootInquiryCompilationFaceCoreAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V)
    (visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot)
    {U7 : U7ProducerCalculus N}
    {calculus : U7ObstructionEvolutionCalculus N U7}
    {oldTheory : TheoryState N}
    {Query : Type u} (query : Query)
    {InquiryEvent : Type (u + 1)} (event : InquiryEvent)
    (entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current)))
    (authority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      root visit entry)
    (compiled : SourceNativeInquiryCompilationAt
      root visit U7 calculus oldTheory query event entry authority) : Type (u + 2) where
  projection : root.toAuthoritativeRoot.source.projectionLaw.Projection
  active : root.toAuthoritativeRoot.source.projectionLaw.ActiveAt
    projection (root.emitted visit.current)
  classifier_eq :
    root.toAuthoritativeRoot.source.projectionLaw.classify projection
      (root.emitted visit.current) = .inl active
  project_heq : HEq
    (root.toAuthoritativeRoot.source.projectionLaw.project projection
      (root.emitted visit.current) active)
    (SourceNativeInquiryCompilationTokenAt.canonical
      (entry := entry) (query := query) (event := event)
      (audit := compiled.audit) compiled.answerReadout)

/-- Complete fixed-root state hidden inside one running inquiry engine. -/
structure RootInquiryStateAt
    (N : WorldRelationNetwork.{u}) (V : Vocabulary.{u}) : Type (u + 12) where
  root : SourceNativeLivingRootClosure N V
  visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot
  U7 : U7ProducerCalculus N
  calculus : U7ObstructionEvolutionCalculus N U7
  Query : Type u
  entryAt : (query : Query) -> OpenResponsibilityAt N
    (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
      (root.emitted visit.current))
  authorityAt : (query : Query) ->
    SourceNativeLivingTemporalCausalEntryAuthorityAt root visit (entryAt query)
  compilationProgramAt : (query : Query) ->
    SourceNativeInquiryCompilationProgramAt root visit U7 calculus
      root.toAuthoritativeRoot.source.lawSurface query
      (ULift.up.{u + 1, u} (root.emitted visit.current))
      (entryAt query) (authorityAt query)
  /-- The compiler image is already an installed face of this fixed source.
  Its literal U8 branch already contains the concrete realization; no later
  gearbox can choose a sibling old-root face or attach a second completion. -/
  compilationFaceAt : (query : Query) ->
    SourceNativeRootInquiryCompilationFaceCoreAt root visit query
      (ULift.up.{u + 1, u} (root.emitted visit.current))
      (entryAt query) (authorityAt query)
      (compilationProgramAt query).generate.output
  /-- Every obstructed inquiry uses the U7 disposition already generated for
  the same exact root row.  A local settlement or redirect may differ from
  the rest of the world, but it cannot live in a parallel ledger. -/
  u7RootDisposition_commutes : (query : Query) ->
    (obstruction : N.ObstructionAt
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))) ->
    (audit : SourceNativeInquiryAuditAt
      U7 calculus root.toAuthoritativeRoot.source.lawSurface obstruction) ->
    (compilationProgramAt query).generate.output.audit =
      .obstructed obstruction audit ->
    U7DemandEntryRootDispositionCommutesAt calculus
      (calculus.source.emit obstruction) (entryAt query)
      ((root.toAuthoritativeRoot.toLedgerRoot.source.ledgerCompiler.compile
        (root.emitted visit.current)).entryDisposition (entryAt query))

namespace RootInquiryStateAt

/-- The unique execution token of the source-owned inquiry compiler. -/
def generatedCompilation
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (state : RootInquiryStateAt N V) (query : state.Query) :
    SourceGeneratedInquiryCompilationAt (state.compilationProgramAt query) :=
  (state.compilationProgramAt query).generate

/-- Complete compiler image derived from the exact root occurrence.  This is
a readout, not a field which a caller can replace after state admission. -/
def compileInquiry
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (state : RootInquiryStateAt N V) (query : state.Query) :
    SourceNativeInquiryCompilationAt state.root state.visit state.U7
      state.calculus state.root.toAuthoritativeRoot.source.lawSurface query
      (ULift.up.{u + 1, u} (state.root.emitted state.visit.current))
      (state.entryAt query) (state.authorityAt query) :=
  (state.generatedCompilation query).output

/-- The inquiry event is the raw occurrence already emitted by the fixed root
at this visit.  It precedes the projection compiler and cannot be replaced by
a caller-owned token family. -/
abbrev InquiryEventAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (state : RootInquiryStateAt N V) (_query : state.Query) : Type (u + 1) :=
  ULift.{u + 1, u}
    (state.root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.actual.OccurrenceAt
      state.visit.current)

def emitInquiry
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (state : RootInquiryStateAt N V) (_query : state.Query) :
    state.InquiryEventAt _query :=
  ULift.up.{u + 1, u} (state.root.emitted state.visit.current)

@[simp] theorem emitInquiry_eq_rootOccurrence
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (state : RootInquiryStateAt N V) (query : state.Query) :
    state.emitInquiry query =
      ULift.up.{u + 1, u} (state.root.emitted state.visit.current) :=
  rfl

/-- The inquiry theory is the current law surface of the fixed source.  It is
not an independently selectable field of the inquiry engine. -/
abbrev oldTheory
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (state : RootInquiryStateAt N V) : TheoryState N :=
  state.root.toAuthoritativeRoot.source.lawSurface

def support
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (state : RootInquiryStateAt N V) : N.Support :=
  state.root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
    (state.root.emitted state.visit.current)

/-- Entry identity is a readout of the stronger root/U7 disposition
commuting law; inquiry code does not maintain a second identity premise. -/
theorem entry_eq_demand
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (state : RootInquiryStateAt N V)
    (query : state.Query)
    (obstruction : N.ObstructionAt state.support)
    (audit : SourceNativeInquiryAuditAt state.U7 state.calculus
      state.oldTheory obstruction)
    (compiled_eq : (state.compileInquiry query).audit =
      .obstructed obstruction audit) :
    state.entryAt query = U7ActualSuccessorSource.demandEntry
      (state.calculus.source.emit obstruction) :=
  eq_of_heq
    (state.u7RootDisposition_commutes query obstruction audit
      compiled_eq).1

/-- The local U7 answer and the world ledger expose one exact disposition.
This is the typed seam which permits relative settlement without promoting it
to an unrelated whole-world terminal. -/
theorem u7Disposition_heq_root
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (state : RootInquiryStateAt N V)
    (query : state.Query)
    (obstruction : N.ObstructionAt state.support)
    (audit : SourceNativeInquiryAuditAt state.U7 state.calculus
      state.oldTheory obstruction)
    (compiled_eq : (state.compileInquiry query).audit =
      .obstructed obstruction audit) :
    HEq
      ((state.root.toAuthoritativeRoot.toLedgerRoot.source.ledgerCompiler.compile
        (state.root.emitted state.visit.current)).entryDisposition
          (state.entryAt query))
      (state.calculus.generated obstruction).2.entryDisposition :=
  (state.u7RootDisposition_commutes query obstruction audit
    compiled_eq).2

def u7Event
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (state : RootInquiryStateAt N V)
    {support : N.Support} (obstruction : N.ObstructionAt support) :
    state.calculus.source.EventAt obstruction
      (state.U7.generateDemand obstruction) :=
  state.calculus.source.emit obstruction

/-- U7 has answered without requesting an expressive coface. -/
def U7AnswersAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (state : RootInquiryStateAt N V)
    {support : N.Support} (obstruction : N.ObstructionAt support) : Type u :=
  SourceNativeU7AnswersAt state.calculus obstruction

/-- The exact U7 theory-audit gate. -/
abbrev U7RequestsTheoryAuditAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (state : RootInquiryStateAt N V)
    {support : N.Support} (obstruction : N.ObstructionAt support) : Type u :=
  SourceNativeU7TheoryAuditAt state.calculus (state.u7Event obstruction)

def oldAnswerAndNext
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (state : RootInquiryStateAt N V) (query : state.Query) :
    SourceNativeLivingCausalEntryAnswerAndNextAt
      state.root state.visit (state.entryAt query) (state.authorityAt query) :=
  state.root.generatedCausalEntryAnswerAndNextAt state.visit
    (state.entryAt query) (state.authorityAt query)

end RootInquiryStateAt

/-- Public spelling of the source-owned compilation face. -/
abbrev SourceNativeRootInquiryCompilationFaceAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (state : RootInquiryStateAt N V) (query : state.Query) : Type (u + 2) :=
  SourceNativeRootInquiryCompilationFaceCoreAt state.root state.visit query
    (state.emitInquiry query) (state.entryAt query) (state.authorityAt query)
    (state.compileInquiry query)

namespace SourceNativeRootInquiryCompilationFaceCoreAt

/-- The canonical compilation token factors through the exact temporal root
occurrence. -/
theorem installedAuthority_factorizes
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {state : RootInquiryStateAt N V} {query : state.Query}
    (face : SourceNativeRootInquiryCompilationFaceAt state query) :
    let generated := state.root.toAuthoritativeRoot.toLedgerRoot
      |>.generatedAtTemporalVisit state.visit
    HEq
      (state.root.toAuthoritativeRoot.source.projectionLaw.project
        face.projection generated.occurrence face.active)
      (SourceNativeInquiryCompilationTokenAt.canonical
        (entry := state.entryAt query)
        (query := query)
        (event := state.emitInquiry query)
        (audit := (state.compileInquiry query).audit)
        (state.compileInquiry query).answerReadout) := by
  dsimp only
  exact face.project_heq

end SourceNativeRootInquiryCompilationFaceCoreAt

/-- State-indexed spelling of the U8 realization stored inside the literal
`requiresU8` compiler branch. -/
abbrev SourceGeneratedInquiryU8RevisionAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (state : RootInquiryStateAt N V) (query : state.Query)
    (obstruction : N.ObstructionAt
      (state.root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (state.root.emitted state.visit.current)))
    (u7Gate : state.U7RequestsTheoryAuditAt obstruction)
    (failure : ActualExpressibilityFailure state.oldTheory obstruction) :
    Type (u + 11) :=
  SourceGeneratedInquiryU8RevisionCoreAt
    state.root state.visit state.U7 state.calculus state.oldTheory
    query (state.emitInquiry query) (state.entryAt query)
    (state.authorityAt query) obstruction u7Gate failure

namespace SourceGeneratedInquiryU8RevisionAt

/-- Exact initial-coface direction exposed as the revised answer. -/
def CofaceAnswerAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {state : RootInquiryStateAt N V} {query : state.Query}
    {obstruction : N.ObstructionAt state.support}
    {u7Gate : state.U7RequestsTheoryAuditAt obstruction}
    {failure : ActualExpressibilityFailure state.oldTheory obstruction}
    (revision : SourceGeneratedInquiryU8RevisionAt
      state query obstruction u7Gate failure) : Type u :=
  SourceGeneratedAttachingDirectionAt revision.frontier.rooted

end SourceGeneratedInquiryU8RevisionAt

/-- Compatibility spelling for the now indivisible U8 completion.  There is
no outer wrapper which can attach a previously constructed revision receipt
to a later inquiry branch. -/
abbrev SourceGeneratedInquiryU8CompletionAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (base : RootInquiryStateAt N V) (query : base.Query)
    (obstruction : N.ObstructionAt base.support)
    (u7Gate : base.U7RequestsTheoryAuditAt obstruction)
    (failure : ActualExpressibilityFailure base.oldTheory obstruction) :
    Type (u + 11) :=
  SourceGeneratedInquiryU8RevisionAt
    base query obstruction u7Gate failure

namespace SourceGeneratedInquiryU8CompletionAt

/-- Compatibility readout.  It is definitionally the compiler-indexed
completion itself, not a detachable nested authority record. -/
def revisionReceipt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {base : RootInquiryStateAt N V} {query : base.Query}
    {obstruction : N.ObstructionAt base.support}
    {u7Gate : base.U7RequestsTheoryAuditAt obstruction}
    {failure : ActualExpressibilityFailure base.oldTheory obstruction}
    (generated : SourceGeneratedInquiryU8CompletionAt
      base query obstruction u7Gate failure) :
    SourceGeneratedInquiryU8RevisionAt
      base query obstruction u7Gate failure :=
  generated

@[simp] theorem revisionReceipt_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {base : RootInquiryStateAt N V} {query : base.Query}
    {obstruction : N.ObstructionAt base.support}
    {u7Gate : base.U7RequestsTheoryAuditAt obstruction}
    {failure : ActualExpressibilityFailure base.oldTheory obstruction}
    (generated : SourceGeneratedInquiryU8CompletionAt
      base query obstruction u7Gate failure) :
    generated.revisionReceipt = generated :=
  rfl

/-- The U8 answer is the exact attaching direction generated by the rooted
failure.  Domain equations are separate occurrence-dependent faces; they are
not converted into this answer by a reifier. -/
abbrev AnswerAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {base : RootInquiryStateAt N V} {query : base.Query}
    {obstruction : N.ObstructionAt base.support}
    {u7Gate : base.U7RequestsTheoryAuditAt obstruction}
    {failure : ActualExpressibilityFailure base.oldTheory obstruction}
    (generated : SourceGeneratedInquiryU8CompletionAt
      base query obstruction u7Gate failure) : Type u :=
  generated.revisionReceipt.CofaceAnswerAt

namespace AnswerAt

/-- Root read is identity: an authenticated U8 answer exposes the exact
revised-root occurrence, not an equation-to-result conversion. -/
def occurrence
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {base : RootInquiryStateAt N V} {query : base.Query}
    {obstruction : N.ObstructionAt base.support}
    {u7Gate : base.U7RequestsTheoryAuditAt obstruction}
    {failure : ActualExpressibilityFailure base.oldTheory obstruction}
    {generated : SourceGeneratedInquiryU8CompletionAt
      base query obstruction u7Gate failure}
    (_answer : AnswerAt generated) :=
  (generated.revisionReceipt.revision.generate.newRoot.toLedgerRoot
    ).exactTemporalCausalEventAt
      (.finite generated.revisionReceipt.revision.generate.newRoot.toRoot.initialVisit)

end AnswerAt

/-- The revised answer factors through the initial coface and its first actual
whole-ledger write.  No equation presentation participates in this theorem. -/
def revisedAnswerAuthority_factorizes
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {base : RootInquiryStateAt N V} {query : base.Query}
    {obstruction : N.ObstructionAt base.support}
    {u7Gate : base.U7RequestsTheoryAuditAt obstruction}
    {failure : ActualExpressibilityFailure base.oldTheory obstruction}
    (generated : SourceGeneratedInquiryU8CompletionAt
      base query obstruction u7Gate failure) :
    FaithfulCofaceMorphism
        (root_obstruction_generates_minimal_coface
          generated.revisionReceipt.frontier.rooted)
        generated.revisionReceipt.revision.generate.toAdmissibleMinimalCoface ×
      SourceGeneratedAttachedCofaceRealizationAt
        generated.revisionReceipt.revision.generate :=
  generated.revisionReceipt.cofaceFactorization

end SourceGeneratedInquiryU8CompletionAt

end RootInquiryCompletion
