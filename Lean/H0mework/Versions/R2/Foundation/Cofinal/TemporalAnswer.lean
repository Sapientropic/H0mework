import H0mework.Foundation.Cofinal.ProductiveHistory
import H0mework.Versions.R2.Foundation.Runtime.AnswerNext

/-!
# Finite and cofinal root occurrences share one answer-and-next mouth

A finite `RootVisit` and a source-recognized cofinal boundary are two causal
shapes of the same source-native root.  `SourceNativeTemporalReachableAt`
keeps finite history in one `RootClosure.ReachableAt` and cofinal history in a
separate post-boundary lineage.  Their public `next` compiler selects the sole
lawful successor representation.

The temporal causal trace is generated recursively: finite prefixes retain
their exact list, a cofinal landing retains the exact root-generated patch
stream, and later steps append their exact root visit, from which the current
patch is uniquely read.  The unified
answer-and-next compiler then runs the existing whole-ledger source compiler
at that exact temporal visit.  It stores no completed future table and adds
no seventh structural disposition.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot

universe u v

inductive SourceNativeTemporalPriorPatchTrace
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLedgerRootClosure N V) : Type (u + 1)
  | finite (patches : List (SourceNativeCausalLedgerPatch root))
  | cofinal (patches : Nat → SourceNativeCausalLedgerPatch root)
  | snoc (prior : SourceNativeTemporalPriorPatchTrace root)
      (visit : SourceNativeTemporalVisitAt root)

/-- Exact prior-patch trace after a cofinal landing. -/
def SourceNativeLedgerRootClosure.generatedPostCofinalPriorPatchesAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLedgerRootClosure N V) :
    {current : V.Current} → SourceNativePostCofinalReachableAt root current →
      SourceNativeTemporalPriorPatchTrace root
  | _, .cofinal visit =>
      .cofinal (root.generatedCofinalPriorPatchesAt visit)
  | _, @SourceNativePostCofinalReachableAt.step _ _ _ current _next prior _next_eq =>
      .snoc (root.generatedPostCofinalPriorPatchesAt prior)
        ⟨current, .postCofinal prior⟩

def SourceNativeLedgerRootClosure.generatedTemporalPriorPatchesAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLedgerRootClosure N V) :
    {current : V.Current} → SourceNativeTemporalReachableAt root current →
      SourceNativeTemporalPriorPatchTrace root
  | _, .finite history => .finite (root.generatedPriorPatchesAt history)
  | _, .postCofinal history =>
      root.generatedPostCofinalPriorPatchesAt history

/-- Canonical token for one temporal root occurrence.  The visit index already
contains the exact causal history; no occurrence, trace, patch, write-back, or
equality field is stored in this token. -/
inductive SourceNativeTemporalVisitGeneratedEvolutionAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLedgerRootClosure N V)
    (visit : SourceNativeTemporalVisitAt root) : Type (u + 1)
  | canonical

def SourceNativeLedgerRootClosure.generatedAtTemporalVisit
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLedgerRootClosure N V)
    (visit : SourceNativeTemporalVisitAt root) :
    SourceNativeTemporalVisitGeneratedEvolutionAt root visit :=
  .canonical

namespace SourceNativeTemporalVisitGeneratedEvolutionAt

/-- Exact source event at this temporal visit. -/
def occurrence
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root}
    (_generated : SourceNativeTemporalVisitGeneratedEvolutionAt root visit) :
    root.source.source.toRootSource.actual.OccurrenceAt visit.current :=
  root.emitted visit.current

@[simp] theorem occurrence_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root}
    (generated : SourceNativeTemporalVisitGeneratedEvolutionAt root visit) :
    generated.occurrence = root.emitted visit.current :=
  rfl

/-- Full predecessor patch stream generated by the visit history. -/
def priorPatches
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root}
    (_generated : SourceNativeTemporalVisitGeneratedEvolutionAt root visit) :
    SourceNativeTemporalPriorPatchTrace root :=
  root.generatedTemporalPriorPatchesAt visit.history

@[simp] theorem priorPatches_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root}
    (generated : SourceNativeTemporalVisitGeneratedEvolutionAt root visit) :
    generated.priorPatches =
      root.generatedTemporalPriorPatchesAt visit.history :=
  rfl

/-- Exact finite patch generated at the current occurrence. -/
def currentPatch
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root}
    (_generated : SourceNativeTemporalVisitGeneratedEvolutionAt root visit) :
    SourceNativeFiniteLedgerPatchAt root.source.source
      root.source.ledgerCompiler.ExactTransitionAt
      root.source.ledgerCompiler.writeRowSource
      root.source.ledgerCompiler.terminalRowSource
      (root.generatedLedgerAt visit.current) :=
  root.generatedPatchAt visit.current

@[simp] theorem currentPatch_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root}
    (generated : SourceNativeTemporalVisitGeneratedEvolutionAt root visit) :
    generated.currentPatch = root.generatedPatchAt visit.current :=
  rfl

/-- Whole-ledger write-back generated by the same exact occurrence. -/
def wholeLedgerWriteBack
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root}
    (generated : SourceNativeTemporalVisitGeneratedEvolutionAt root visit) :
    SourceNativeLedgerEvolutionAt root.source.source generated.occurrence :=
  root.generatedLedgerAt visit.current

@[simp] theorem wholeLedgerWriteBack_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root}
    (generated : SourceNativeTemporalVisitGeneratedEvolutionAt root visit) :
    HEq generated.wholeLedgerWriteBack
      (root.generatedLedgerAt visit.current) :=
  HEq.rfl

end SourceNativeTemporalVisitGeneratedEvolutionAt

/-- Exact temporal root occurrence at one finite, cofinal, or post-cofinal
visit.  The occurrence is the complete generated causal texture itself; no
second causal-world wrapper or realization certificate is interposed. -/
abbrev ExactTemporalCausalRootEventAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLedgerRootClosure N V)
    (visit : SourceNativeTemporalVisitAt root) : Type (u + 1) :=
  SourceNativeTemporalVisitGeneratedEvolutionAt root visit

/-- Dependent package of an exact temporal visit and its root-generated
occurrence. -/
abbrev ExactTemporalCausalRootEvent
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLedgerRootClosure N V) : Type (u + 1) :=
  Sigma (ExactTemporalCausalRootEventAt root)

def SourceNativeLedgerRootClosure.exactTemporalCausalEventAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLedgerRootClosure N V)
    (visit : SourceNativeTemporalVisitAt root) :
    ExactTemporalCausalRootEventAt root visit :=
  root.generatedAtTemporalVisit visit

/-- Every inhabitant is the literal compiler image.  The token has no outcome,
trace, patch, or write-back field for a presentation to select. -/
theorem SourceNativeTemporalVisitGeneratedEvolutionAt.eq_generated
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root}
    (generated : SourceNativeTemporalVisitGeneratedEvolutionAt root visit) :
    generated = root.generatedAtTemporalVisit visit := by
  cases generated
  rfl

namespace SourceNativeTemporalVisitGeneratedEvolutionAt

/-- Exact generated-row membership at a finite, cofinal, or post-cofinal
temporal occurrence.  The row is selected by the current patch emitted by the
same temporal root compiler; whole-ledger visibility alone does not inhabit
this type.

The temporal compiler image remains a parameter of the authority token even
when two visits have definitionally equal currents, occurrences, and row
payloads.  Thus equal row data at a self-loop does not permit replaying the
same authority at a later causal visit. -/
structure GeneratedEntryRowAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root}
    (generated : SourceNativeTemporalVisitGeneratedEvolutionAt root visit)
    (entry : OpenResponsibilityAt N
      (root.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))) : Type where
  private mk ::
  sourceRow : SourceNativeFiniteLedgerPatchGeneratedEntryAt root.source.source
    root.source.ledgerCompiler.ExactTransitionAt
    root.source.ledgerCompiler.writeRowSource
    root.source.ledgerCompiler.terminalRowSource
    (root.generatedLedgerAt visit.current)
    generated.currentPatch entry

/-- Lift an exact row already selected by this temporal occurrence's own
source compiler.  The constructor remains sealed from arbitrary membership:
callers must provide the full dependent row indexed by the same generated
evolution, current patch and entry. -/
def GeneratedEntryRowAt.ofSourceRow
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root}
    {generated : SourceNativeTemporalVisitGeneratedEvolutionAt root visit}
    {entry : OpenResponsibilityAt N
      (root.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    (row : SourceNativeFiniteLedgerPatchGeneratedEntryAt root.source.source
      root.source.ledgerCompiler.ExactTransitionAt
      root.source.ledgerCompiler.writeRowSource
      root.source.ledgerCompiler.terminalRowSource
      (root.generatedLedgerAt visit.current)
      generated.currentPatch entry) :
    generated.GeneratedEntryRowAt entry :=
  ⟨row⟩

/-- Query the exact row selected by this temporal occurrence's current patch.
The causal-history shape does not alter row selection; it only prevents a row
from being replayed at a sibling temporal visit. -/
def canonicalGeneratedEntryRow?
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root}
    (generated : SourceNativeTemporalVisitGeneratedEvolutionAt root visit)
    (entry : OpenResponsibilityAt N
      (root.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))) :
    Option (generated.GeneratedEntryRowAt entry) :=
  match sourceNativeFiniteLedgerPatchGeneratedEntry? root.source.source
      root.source.ledgerCompiler.ExactTransitionAt
      root.source.ledgerCompiler.writeRowSource
      root.source.ledgerCompiler.terminalRowSource
      (root.generatedLedgerAt visit.current)
      generated.currentPatch entry with
  | none => none
  | some row => some ⟨row⟩

/-- A generated finite-patch row survives the temporal wrapper at the exact
same occurrence.  This theorem only lifts the existing canonical row query;
it neither admits a new entry nor changes sparse-patch semantics. -/
theorem canonicalGeneratedEntryRow?_isSome
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root}
    (generated : SourceNativeTemporalVisitGeneratedEvolutionAt root visit)
    (entry : OpenResponsibilityAt N
      (root.source.source.toRootSource.account.supportOf
        (root.emitted visit.current)))
    (row : SourceNativeFiniteLedgerPatchGeneratedEntryAt root.source.source
      root.source.ledgerCompiler.ExactTransitionAt
      root.source.ledgerCompiler.writeRowSource
      root.source.ledgerCompiler.terminalRowSource
      (root.generatedLedgerAt visit.current)
      generated.currentPatch entry) :
    (generated.canonicalGeneratedEntryRow? entry).isSome = true := by
  have selected := sourceNativeFiniteLedgerPatchGeneratedEntry?_isSome
    (root.generatedLedgerAt visit.current) generated.currentPatch entry row
  unfold canonicalGeneratedEntryRow?
  split
  · rename_i query_eq
    rw [query_eq] at selected
    contradiction
  · rfl

end SourceNativeTemporalVisitGeneratedEvolutionAt

/-- Causal ledger history for one entry on the unified temporal carrier.

There are exactly two admissions: the root's source-generated finite initial
row, or an exact row generated at a cofinal landing.  Every later history is
the canonical whole-ledger successor of one of those origins.  Sparse finite
patches decide which entries receive local processing at one occurrence; they
do not decide whether an already admitted world responsibility continues to
exist.  In particular, a finite successor cannot also be introduced by
wrapping a parallel finite authority. -/
inductive SourceNativeTemporalCausalEntryLedgerHistoryAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLedgerRootClosure N V) :
    {current : V.Current} ->
      (history : SourceNativeTemporalReachableAt root current) ->
      OpenResponsibilityAt N
        (root.source.source.toRootSource.account.supportOf
          (root.emitted current)) -> Type (u + 1)
  | initialAdmission
      (entry : OpenResponsibilityAt N
        (root.source.source.toRootSource.account.supportOf
          (root.emitted root.toRoot.source.initial)))
      (row : (root.generatedAtTemporalVisit
        (.finite root.toRoot.initialVisit)).GeneratedEntryRowAt entry) :
      SourceNativeTemporalCausalEntryLedgerHistoryAt root
        (.finite .initial) entry
  | cofinalAdmission
      {visit : SourceNativeCofinalVisitAt root}
      {entry : OpenResponsibilityAt N
        (root.source.source.toRootSource.account.supportOf
          (root.emitted visit.current))}
      (row : (root.generatedAtTemporalVisit (.cofinal visit)).GeneratedEntryRowAt
        entry) :
      SourceNativeTemporalCausalEntryLedgerHistoryAt root
        (.postCofinal (.cofinal visit)) entry
  | finiteSuccessor
      {current next : V.Current}
      {prior : root.toRoot.ReachableAt current}
      (next_eq : (root.toRoot.evolutionAt current).nextCurrent? = some next)
      {sourceEntry : OpenResponsibilityAt N
        (root.source.source.toRootSource.account.supportOf
          (root.emitted current))}
      (priorHistory : SourceNativeTemporalCausalEntryLedgerHistoryAt
        root (.finite prior) sourceEntry) :
      SourceNativeTemporalCausalEntryLedgerHistoryAt root
        (.finite (.step prior next_eq))
        (root.canonicalTargetEntryAtNext next_eq sourceEntry)
  | postCofinalSuccessor
      {current next : V.Current}
      {prior : SourceNativePostCofinalReachableAt root current}
      (next_eq : (root.toRoot.evolutionAt current).nextCurrent? = some next)
      {sourceEntry : OpenResponsibilityAt N
        (root.source.source.toRootSource.account.supportOf
          (root.emitted current))}
      (priorHistory : SourceNativeTemporalCausalEntryLedgerHistoryAt
        root (.postCofinal prior) sourceEntry) :
      SourceNativeTemporalCausalEntryLedgerHistoryAt root
        (.postCofinal (.step prior next_eq))
        (root.canonicalTargetEntryAtNext next_eq sourceEntry)

/-- Visit-facing spelling of the unified finite/cofinal ledger readout. -/
abbrev SourceNativeTemporalCausalEntryLedgerReadoutAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLedgerRootClosure N V)
    (visit : SourceNativeTemporalVisitAt root)
    (entry : OpenResponsibilityAt N
      (root.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))) : Type (u + 1) :=
  SourceNativeTemporalCausalEntryLedgerHistoryAt root visit.history entry

/-- Canonical successor of one temporal causal entry.  Admission has already
fixed the exact live incidence; the root's complete ledger evolution, rather
than another sparse-patch membership proof, supplies every later target. -/
def SourceNativeTemporalCausalEntryLedgerHistoryAt.next
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    {current : V.Current}
    {history : SourceNativeTemporalReachableAt root current}
    {sourceEntry : OpenResponsibilityAt N
      (root.source.source.toRootSource.account.supportOf
        (root.emitted current))}
    (historyReadout : SourceNativeTemporalCausalEntryLedgerHistoryAt
      root history sourceEntry)
    {next : V.Current}
    (next_eq : (root.toRoot.evolutionAt current).nextCurrent? = some next) :
    SourceNativeTemporalCausalEntryLedgerHistoryAt root
      (history.next next_eq)
      (root.canonicalTargetEntryAtNext next_eq sourceEntry) :=
  match history with
  | .finite _ => .finiteSuccessor next_eq historyReadout
  | .postCofinal _ =>
      .postCofinalSuccessor next_eq historyReadout

/-- One exact live entry together with its unified temporal causal history. -/
abbrev GeneratedTemporalCausalEntryAtHistory
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLedgerRootClosure N V)
    {current : V.Current}
    (history : SourceNativeTemporalReachableAt root current) : Type (u + 1) :=
  Sigma fun entry : OpenResponsibilityAt N
      (root.source.source.toRootSource.account.supportOf
        (root.emitted current)) =>
    SourceNativeTemporalCausalEntryLedgerHistoryAt root history entry

/-- Follow one source-generated initial entry through a finite root history,
but return its ledger history in the sole temporal grammar.  The initial patch admits
the entry once; every later step follows the complete source-generated ledger
evolution, even when a sparse local patch does not select that entry. -/
def SourceNativeLedgerRootClosure.generatedTemporalCausalEntryFromInitial?
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLedgerRootClosure N V)
    (initialEntry : OpenResponsibilityAt N
      (root.source.source.toRootSource.account.supportOf
        (root.emitted root.toRoot.source.initial))) :
    {current : V.Current} ->
    (history : root.toRoot.ReachableAt current) ->
      Option (GeneratedTemporalCausalEntryAtHistory root (.finite history))
  | _, .initial =>
      let visit : SourceNativeTemporalVisitAt root := .finite root.toRoot.initialVisit
      match (root.generatedAtTemporalVisit visit).canonicalGeneratedEntryRow?
          initialEntry with
      | none => none
      | some row => some ⟨initialEntry,
          SourceNativeTemporalCausalEntryLedgerHistoryAt.initialAdmission
            (root := root) initialEntry row⟩
  | _, @RootClosure.ReachableAt.step _ _ _ _current next prior next_eq =>
      match root.generatedTemporalCausalEntryFromInitial? initialEntry prior with
      | none => none
      | some ⟨sourceEntry, priorHistory⟩ =>
          some ⟨root.canonicalTargetEntryAtNext next_eq sourceEntry,
            priorHistory.next next_eq⟩

/-- Authority-bearing temporal occurrence indexed by the complete admitted
root, including its source inventory, law surface and projection family. -/
structure SourceNativeAuthoritativeTemporalEvolutionAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeAuthoritativeRootClosure N V)
    (visit : SourceNativeTemporalVisitAt root.toLedgerRoot) : Type (u + 1) where
  private mk ::

/-- Generate the sealed temporal authority from the fixed admitted root. -/
def SourceNativeAuthoritativeRootClosure.authoritativeEvolutionAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeAuthoritativeRootClosure N V)
    (visit : SourceNativeTemporalVisitAt root.toLedgerRoot) :
    SourceNativeAuthoritativeTemporalEvolutionAt root visit :=
  ⟨⟩

/-- Canonical temporal authority compiler of the complete admitted root. -/
def SourceNativeAuthoritativeRootClosure.temporalVisitAuthorityCompiler
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeAuthoritativeRootClosure N V) :
    CanonicalReceiptAuthority.Compiler
      (SourceNativeTemporalVisitAt root.toLedgerRoot)
      (Sigma fun visit : SourceNativeTemporalVisitAt root.toLedgerRoot =>
        SourceNativeAuthoritativeTemporalEvolutionAt root visit) where
  compile := fun visit => ⟨visit, root.authoritativeEvolutionAt visit⟩

/-- Temporal authority is the fixed admitted-root compiler image. -/
def SourceNativeAuthoritativeRootClosure.generatedAtTemporalVisit_isCanonical
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeAuthoritativeRootClosure N V)
    (visit : SourceNativeTemporalVisitAt root.toLedgerRoot) :
    CanonicalReceiptAuthority.CanonicalReceipt
      root.temporalVisitAuthorityCompiler
      ⟨visit, root.authoritativeEvolutionAt visit⟩ :=
  root.temporalVisitAuthorityCompiler.compileCanonical visit

namespace SourceNativeAuthoritativeTemporalEvolutionAt

/-- Canonical ledger/history restriction of the complete temporal authority. -/
def toLedgerReadout
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toLedgerRoot}
    (_authority : SourceNativeAuthoritativeTemporalEvolutionAt root visit) :
    SourceNativeTemporalVisitGeneratedEvolutionAt root.toLedgerRoot visit :=
  root.toLedgerRoot.generatedAtTemporalVisit visit

/-- At fixed root and visit there is exactly one temporal authority token. -/
theorem eq_authoritativeEvolutionAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toLedgerRoot}
    (authority : SourceNativeAuthoritativeTemporalEvolutionAt root visit) :
    authority = root.authoritativeEvolutionAt visit := by
  cases authority
  rfl

@[simp] theorem toLedgerReadout_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toLedgerRoot}
    (authority : SourceNativeAuthoritativeTemporalEvolutionAt root visit) :
    authority.toLedgerReadout =
      root.toLedgerRoot.generatedAtTemporalVisit visit :=
  rfl

end SourceNativeAuthoritativeTemporalEvolutionAt

/-- A cofinal temporal visit exposes the exact predecessor stream generated
by the same productive root history. -/
theorem SourceNativeTemporalVisitGeneratedEvolutionAt.cofinal_priorPatches_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    (visit : SourceNativeCofinalVisitAt root) :
    (root.generatedAtTemporalVisit (.cofinal visit)).priorPatches =
      .cofinal (root.generatedCofinalPriorPatchesAt visit) :=
  rfl

/-- Internal proof-relevant branch selected by the exact ledger compiler. -/
structure SourceNativeLivingRootClosure.GeneratedNextBranchAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V)
    (visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot) where
  generated : SourceNativeLedgerEvolutionAt
      root.toAuthoritativeRoot.toLedgerRoot.source.source
      (root.emitted visit.current)
  generated_eq :
    root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt visit.current =
      generated

theorem SourceNativeLivingRootClosure.GeneratedNextBranchAt.ext
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {left right : root.GeneratedNextBranchAt visit}
    (generated_eq : left.generated = right.generated) : left = right := by
  rcases left with ⟨leftGenerated, leftProof⟩
  rcases right with ⟨rightGenerated, rightProof⟩
  dsimp at generated_eq
  cases generated_eq
  rfl

/-- Evaluate one already selected exact compiler branch. -/
def SourceNativeLivingRootClosure.generatedNextCurrentWithLawOfBranch
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V)
    (visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot)
    (branch : root.GeneratedNextBranchAt visit) :
    { next : SourceNativeAuthoritativeRootCurrentAt N //
      next.root.source.lawSurface = root.source.base.lawSurface } := by
  rcases branch with ⟨generated, generated_eq⟩
  cases generated with
  | nativeWrite write structural_eq _targetOccurrence _ledgerEvolution =>
      have next_eq := congrArg EvolutionAt.nextCurrent? structural_eq
      simp only [EvolutionAt.nextCurrent?] at next_eq
      exact ⟨⟨V, root.toAuthoritativeRoot, visit.next next_eq⟩, rfl⟩
  | relationWrite write structural_eq _targetOccurrence _ledgerEvolution =>
      have next_eq := congrArg EvolutionAt.nextCurrent? structural_eq
      simp only [EvolutionAt.nextCurrent?] at next_eq
      exact ⟨⟨V, root.toAuthoritativeRoot, visit.next next_eq⟩, rfl⟩
  | continuedTransport write structural_eq _targetOccurrence _ledgerEvolution =>
      have next_eq := congrArg EvolutionAt.nextCurrent? structural_eq
      simp only [EvolutionAt.nextCurrent?] at next_eq
      exact ⟨⟨V, root.toAuthoritativeRoot, visit.next next_eq⟩, rfl⟩
  | borromeanRedirect write structural_eq _targetOccurrence _ledgerEvolution =>
      have next_eq := congrArg EvolutionAt.nextCurrent? structural_eq
      simp only [EvolutionAt.nextCurrent?] at next_eq
      exact ⟨⟨V, root.toAuthoritativeRoot, visit.next next_eq⟩, rfl⟩
  | faithfulTerminal terminal structural_eq ledgerEvolution =>
      let exactTerminal : SourceFaithfulTerminalOccurrenceAt root.source.base
          (root.emitted visit.current) :=
        ⟨terminal, structural_eq, ledgerEvolution, generated_eq⟩
      exact ⟨root.generatedTerminalHandoffAt visit exactTerminal,
        root.generatedTerminalHandoff_lawSurface_eq visit exactTerminal⟩

/-- Internal source compiler for the next authoritative current together with
the law-surface equation that every fixed-law branch must preserve. -/
private def SourceNativeLivingRootClosure.generatedNextCurrentWithLawAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V)
    (visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot) :
    { next : SourceNativeAuthoritativeRootCurrentAt N //
      next.root.source.lawSurface = root.source.base.lawSurface } :=
  root.generatedNextCurrentWithLawOfBranch visit
    ⟨root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt visit.current, rfl⟩

theorem SourceNativeLivingRootClosure.generatedNextBranch_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V)
    (visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot)
    (generated : SourceNativeLedgerEvolutionAt
      root.toAuthoritativeRoot.toLedgerRoot.source.source
      (root.emitted visit.current))
    (generated_eq :
      root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt visit.current =
        generated) :
    (⟨root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt visit.current,
      rfl⟩ : root.GeneratedNextBranchAt visit) =
      ⟨generated, generated_eq⟩ := by
  exact SourceNativeLivingRootClosure.GeneratedNextBranchAt.ext generated_eq

/-- The sole next-root package selected by one living source occurrence.

Ordinary writes retain the present source law and extend its exact temporal
history.  A faithful terminal uses the terminal-handoff law installed before
the emitter.  No caller supplies a next vocabulary, root, or visit. -/
def SourceNativeLivingRootClosure.generatedNextCurrentAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V)
    (visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot) :
    SourceNativeAuthoritativeRootCurrentAt N :=
  (root.generatedNextCurrentWithLawAt visit).1

/-- Exact native-write readback of the private answer/next compiler.  The
target visit is forced by the branch's structural equation. -/
theorem SourceNativeLivingRootClosure.generatedNextCurrentAt_eq_nativeWriteBranch
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V)
    (visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot)
    (write : V.NativeWriteAt visit.current)
    (structural_eq :
      root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.actual.compile
          (root.emitted visit.current) = .nativeWrite write)
    (targetOccurrence :
      root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.actual.OccurrenceAt
        (V.nativeTarget write))
    (ledgerEvolution : LedgerWriteEvolutionAt N
      ⟨root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current)⟩
      ⟨root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        targetOccurrence⟩)
    (generated_eq :
      root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt visit.current =
        .nativeWrite write structural_eq targetOccurrence ledgerEvolution)
    (next_eq :
      (root.toAuthoritativeRoot.toRoot.evolutionAt visit.current).nextCurrent? =
        some (V.nativeTarget write)) :
    root.generatedNextCurrentAt visit =
      ⟨V, root.toAuthoritativeRoot, visit.next next_eq⟩ := by
  change
    (root.generatedNextCurrentWithLawOfBranch visit
      ⟨root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt visit.current,
        rfl⟩).1 = _
  rw [root.generatedNextBranch_eq visit
    (.nativeWrite write structural_eq targetOccurrence ledgerEvolution)
      generated_eq]
  rfl

