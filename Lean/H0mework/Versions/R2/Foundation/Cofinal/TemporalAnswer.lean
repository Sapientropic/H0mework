/-- Exact terminal-branch readback of the private answer/next compiler.  The
caller supplies the compiler equality, not a target root; the target remains
the terminal handoff installed in the living source. -/
theorem SourceNativeLivingRootClosure.generatedNextCurrentAt_eq_terminalBranch
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V)
    (visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot)
    (terminal : V.FaithfulTerminalAt visit.current)
    (structural_eq :
      root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.actual.compile
          (root.emitted visit.current) = .faithfulTerminal terminal)
    (ledgerEvolution : LedgerTerminalEvolutionAt N
      ⟨root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current)⟩)
    (generated_eq :
      root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt visit.current =
        .faithfulTerminal terminal structural_eq ledgerEvolution) :
    root.generatedNextCurrentAt visit =
      root.generatedTerminalHandoffAt visit
        { terminal := terminal
          structural_eq := structural_eq
          ledgerEvolution := ledgerEvolution
          generated_eq := generated_eq } := by
  change
    (root.generatedNextCurrentWithLawOfBranch visit
      ⟨root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt visit.current,
        rfl⟩).1 = _
  rw [root.generatedNextBranch_eq visit
    (.faithfulTerminal terminal structural_eq ledgerEvolution) generated_eq]
  rfl

/-- Every fixed-law answer-and-next step preserves the root law surface.
Ordinary writes remain in the same root; a local terminal may change the
vocabulary/current but its source-generated handoff cannot perform a hidden
theory revision. -/
theorem SourceNativeLivingRootClosure.generatedNextCurrentAt_lawSurface_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V)
    (visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot) :
    (root.generatedNextCurrentAt visit).root.source.lawSurface =
      root.source.base.lawSurface :=
  (root.generatedNextCurrentWithLawAt visit).2

