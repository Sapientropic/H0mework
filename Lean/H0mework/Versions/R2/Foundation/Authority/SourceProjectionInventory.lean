import H0mework.Foundation.Authority.CausalVisit
import H0mework.Foundation.Ledger.Restructuring
import H0mework.Foundation.Semantics.TheoryState

/-!
# Source-first authority inventory for constructive roots

An authority inventory must not be installed after a complete root emitter has
already revealed the actual branch.  Otherwise a caller can keep the lower
root fixed, inspect its result, and then wrap it in a freshly selected domain
classifier or projection.

This kernel first admits a complete concrete actual-event inventory, then puts
the whole projection vocabulary in the source identity *before* an emitter is
supplied.  A projection law is total over arbitrary
source-native occurrences and consumes the occurrence-local canonical ledger
compiler output.  The authoritative root subsequently supplies only the
emitter and the already required successor-commuting proof.

At every emitted current every projection has exactly one source-generated
readout:

* an active source token together with its root/ledger projection; or
* a source-native inapplicability receipt.

There is no unclassified branch and no post-event projection parameter.  A
different classifier or projection is a different complete source law; it
cannot reuse a readout indexed by the old source.  The kernel remains fully
constructive.  A generic projection payload is never, by itself, operational
authority: it is a field/readout of the source inventory.  Atom, action, and
U8 authority must be generated by their dedicated source-native producer
types, which add the relevant causal jurisdiction.  Time-indexed standing is
the root answer-and-next transition itself and has no parallel projection.

The admission may rechart heterogeneous vocabularies, but it must preserve the
whole current/event/evolution fibres, target, support, ledger write-back and
finite generated patch.  Terminal authority additionally exhausts every
concrete source-native successor at that current.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot

universe u

/-- Complete authority-bearing projection vocabulary owned by one ledger
source before any actual emitter is installed.

`ActiveAt` is indexed by the exact source-native occurrence.  `project`
has no ledger argument: any ledger-dependent payload must read
`source.ledgerCompiler.compile occurrence` from the fixed source itself. -/
structure SourceNativeProjectionLaw
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (source : SourceNativeLedgerSource N V) : Type (u + 1) where
  Projection : Type u
  ActiveAt : (projection : Projection) ->
    {current : V.Current} ->
    source.source.toRootSource.actual.OccurrenceAt current -> Type u
  InactiveAt : (projection : Projection) ->
    {current : V.Current} ->
    source.source.toRootSource.actual.OccurrenceAt current -> Type u
  classify : (projection : Projection) ->
    {current : V.Current} ->
    (occurrence : source.source.toRootSource.actual.OccurrenceAt current) ->
      ActiveAt projection occurrence ⊕ InactiveAt projection occurrence
  PayloadAt : (projection : Projection) ->
    {current : V.Current} ->
    (occurrence : source.source.toRootSource.actual.OccurrenceAt current) ->
    ActiveAt projection occurrence -> Type u
  project : (projection : Projection) ->
    {current : V.Current} ->
    (occurrence : source.source.toRootSource.actual.OccurrenceAt current) ->
    (active : ActiveAt projection occurrence) ->
    PayloadAt projection occurrence active

/-- The complete result fibre of one source-owned projection at one exact
occurrence.

This occurrence-indexed form is the representation-neutral authority shell
used by heterogeneous U8 comparison.  A faithful rechart must transport the
whole active payload or inactive receipt and make the canonical classifier
output commute; preserving only the active/inactive tag is insufficient. -/
abbrev SourceNativeProjectionFiberAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    (law : SourceNativeProjectionLaw source)
    (projection : law.Projection)
    {current : V.Current}
    (occurrence : source.source.toRootSource.actual.OccurrenceAt current) :
    Type u :=
  (Sigma fun active : law.ActiveAt projection occurrence =>
      law.PayloadAt projection occurrence active) ⊕
    law.InactiveAt projection occurrence

namespace SourceNativeProjectionLaw

/-- Canonical whole-fibre output of one projection at one exact occurrence.
The active payload consumes the same occurrence's canonical whole-ledger
compiler image; the inactive receipt remains a classifier readout. -/
def outcomeAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    (law : SourceNativeProjectionLaw source)
    (projection : law.Projection)
    {current : V.Current}
    (occurrence : source.source.toRootSource.actual.OccurrenceAt current) :
    SourceNativeProjectionFiberAt law projection occurrence :=
  match law.classify projection occurrence with
  | .inl active =>
      .inl ⟨active, law.project projection occurrence active⟩
  | .inr inactive => .inr inactive

/-- A fixed source classifier cannot certify two different active witnesses
at one projection occurrence.  This is the generic proof-relevant freedom
detector used by installed domain faces. -/
theorem active_eq_of_classify_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    (law : SourceNativeProjectionLaw source)
    {projection : law.Projection}
    {current : V.Current}
    {occurrence : source.source.toRootSource.actual.OccurrenceAt current}
    {left right : law.ActiveAt projection occurrence}
    (left_eq : law.classify projection occurrence = .inl left)
    (right_eq : law.classify projection occurrence = .inl right) :
    left = right :=
  Sum.inl.inj (left_eq.symm.trans right_eq)

/-- Once the classifier has fixed the active witness, the complete dependent
payload is the same source-compiler readout. -/
theorem project_heq_of_classify_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    (law : SourceNativeProjectionLaw source)
    {projection : law.Projection}
    {current : V.Current}
    {occurrence : source.source.toRootSource.actual.OccurrenceAt current}
    {left right : law.ActiveAt projection occurrence}
    (left_eq : law.classify projection occurrence = .inl left)
    (right_eq : law.classify projection occurrence = .inl right) :
    HEq (law.project projection occurrence left)
      (law.project projection occurrence right) := by
  cases law.active_eq_of_classify_eq left_eq right_eq
  rfl

/-- The inactive side cannot hide a second proof-relevant freedom bit either.
At a fixed source occurrence, two purported inapplicability receipts emitted
by the same classifier are the same receipt. -/
theorem inactive_eq_of_classify_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    (law : SourceNativeProjectionLaw source)
    {projection : law.Projection}
    {current : V.Current}
    {occurrence : source.source.toRootSource.actual.OccurrenceAt current}
    {left right : law.InactiveAt projection occurrence}
    (left_eq : law.classify projection occurrence = .inr left)
    (right_eq : law.classify projection occurrence = .inr right) :
    left = right :=
  Sum.inr.inj (left_eq.symm.trans right_eq)

/-- One source-owned projection inventory is installed as a directly
addressable coface of a larger inventory.

This is a transporter/readout contract, not a new authority source.  Both
laws are already fixed over the same source-native ledger compiler, and the
whole dependent outcome must commute for every actual occurrence.  It lets a
later visibility uplift retain earlier coordinates without requiring the
earlier installation to remain the outermost record constructor.  The
embedding is injective: an uplift may expose more coordinates, but cannot
quotient two existing faces into one. -/
structure InstallationAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    (component whole : SourceNativeProjectionLaw source) : Type (u + 1) where
  embed : component.Projection -> whole.Projection
  embed_injective : Function.Injective embed
  outcome_heq :
    {current : V.Current} ->
    (occurrence : source.source.toRootSource.actual.OccurrenceAt current) ->
    (projection : component.Projection) ->
    HEq (whole.outcomeAt (embed projection) occurrence)
      (component.outcomeAt projection occurrence)

namespace InstallationAt

/-- A projection inventory is installed in itself. -/
def refl
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    (law : SourceNativeProjectionLaw source) : InstallationAt law law where
  embed := id
  embed_injective := Function.injective_id
  outcome_heq := by intros; rfl

/-- Exact whole-law equality gives the corresponding installation. -/
def ofEq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    {component whole : SourceNativeProjectionLaw source}
    (whole_eq : whole = component) : InstallationAt component whole := by
  cases whole_eq
  exact refl component

/-- Visibility uplifts compose without changing the underlying occurrence. -/
def trans
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    {first middle last : SourceNativeProjectionLaw source}
    (left : InstallationAt first middle)
    (right : InstallationAt middle last) : InstallationAt first last where
  embed := fun projection => right.embed (left.embed projection)
  embed_injective := right.embed_injective.comp left.embed_injective
  outcome_heq := by
    intro current occurrence projection
    exact (right.outcome_heq occurrence (left.embed projection)).trans
      (left.outcome_heq occurrence projection)

/-- Two installation paths for the same semantic component cannot use
different coordinates of the fixed whole inventory to change that
component's outcome.  The embeddings may be different presentations, but
both complete dependent fibres commute with the same source-generated
component readout. -/
theorem outcome_heq_of_same_component
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    {component whole : SourceNativeProjectionLaw source}
    (left right : InstallationAt component whole)
    {current : V.Current}
    (occurrence : source.source.toRootSource.actual.OccurrenceAt current)
    (projection : component.Projection) :
    HEq (whole.outcomeAt (left.embed projection) occurrence)
      (whole.outcomeAt (right.embed projection) occurrence) :=
  (left.outcome_heq occurrence projection).trans
    (right.outcome_heq occurrence projection).symm

end InstallationAt

end SourceNativeProjectionLaw

/-- A source-native event in the complete lower inventory whose canonical
ledger compiler generates an actual successor.

This is deliberately indexed by the whole lower `SourceNativeLedgerSource`,
not by a root vocabulary payload.  Merely declaring a write constructor does
not make a write actual; conversely, a terminal receipt cannot erase a lower
event whose own compiler generates a successor. -/
abbrev SourceNativeActualOutgoingEventAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (source : SourceNativeLedgerSource N V)
    (current : V.Current) : Type u :=
  Sigma fun occurrence :
      source.source.toRootSource.actual.OccurrenceAt current =>
    SourceNativeLedgerGeneratedSuccessorAt occurrence
      (source.ledgerCompiler.compile occurrence)

/-- Exact admission of a complete lower actual-event inventory into one
authority source presentation.

`actualSource` is fixed before the authority projection law and before a root
emitter.  `occurrencePresentation` is a two-sided presentation of the whole
ordinary event fibre at every current; `structural_commutes` prevents
branch/target rewrites, while the two `HEq` laws retain the complete ledger
write-back and its finite generated patch.  The cofinal event fibre, emitter,
predecessor path, and landing target commute separately: a rechart cannot
erase or invent a boundary occurrence after preserving only finite steps.  A
faithful terminal additionally proves that the lower actual fibre has no
continuing event.  Hence "not registered in the presentation" can no longer
be used as evidence that an actual continuation does not exist.

The lower source may be small or domain-specific.  What this law forbids is
using a smaller sibling source to settle obligations owned by the fixed lower
source. -/
structure SourceNativeCompleteEventInventoryAdmission
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (represented : SourceNativeRestructuringLedgerSource N V) :
    Type (u + 1) where
  /-- The concrete source vocabulary whose complete actual-event fibre is being
  represented.  It is deliberately allowed to differ from the authority
  vocabulary: changing coordinates must not make a real continuation vanish. -/
  ActualV : Vocabulary.{u}
  actualSource : SourceNativeLedgerSource N ActualV
  /-- Exact current rechart.  The authority source may rename a current, but it
  may neither drop nor add a current while claiming to represent this source. -/
  currentPresentation : ConstructivePresentation ActualV.Current V.Current
  initial_eq :
    currentPresentation.forward actualSource.source.initial =
      represented.source.initial
  /-- Complete concrete/authority occurrence fibres at corresponding currents. -/
  occurrencePresentation : (current : V.Current) ->
    ConstructivePresentation
      (actualSource.source.toRootSource.actual.OccurrenceAt
        (currentPresentation.backward current))
      (represented.source.toRootSource.actual.OccurrenceAt current)
  /-- Complete evolution fibres at corresponding currents.  This retains the
  full source-native payload rather than only its branch tag. -/
  evolutionPresentation : (current : V.Current) ->
    ConstructivePresentation
      (EvolutionAt ActualV (currentPresentation.backward current))
      (EvolutionAt V current)
  structural_commutes : (current : V.Current) ->
    (occurrence :
      actualSource.source.toRootSource.actual.OccurrenceAt
        (currentPresentation.backward current)) ->
    (evolutionPresentation current).forward
        (actualSource.source.toRootSource.actual.compile occurrence) =
      represented.source.toRootSource.actual.compile
        ((occurrencePresentation current).forward occurrence)
  /-- A rechart may rename payload carriers, but cannot turn one structural
  disposition into another while retaining the old source account. -/
  kind_commutes : (current : V.Current) ->
    (evolution : EvolutionAt ActualV
      (currentPresentation.backward current)) ->
    ((evolutionPresentation current).forward evolution).kind = evolution.kind
  /-- Exact targets commute.  In particular, an actual successor cannot be
  mapped to `none` and relabelled as a faithful terminal. -/
  nextCurrent_commutes : (current : V.Current) ->
    (evolution : EvolutionAt ActualV
      (currentPresentation.backward current)) ->
    Option.map currentPresentation.forward evolution.nextCurrent? =
      ((evolutionPresentation current).forward evolution).nextCurrent?
  support_commutes : (current : V.Current) ->
    (occurrence :
      actualSource.source.toRootSource.actual.OccurrenceAt
        (currentPresentation.backward current)) ->
    represented.source.toRootSource.account.supportOf
        ((occurrencePresentation current).forward occurrence) =
      actualSource.source.toRootSource.account.supportOf occurrence
  wholeLedgerWriteBack_commutes : (current : V.Current) ->
    (occurrence :
      actualSource.source.toRootSource.actual.OccurrenceAt
        (currentPresentation.backward current)) ->
    HEq
      (represented.compiler.ledgerCompiler.compile
        ((occurrencePresentation current).forward occurrence))
      (actualSource.ledgerCompiler.compile occurrence)
  finitePatch_commutes : (current : V.Current) ->
    (occurrence :
      actualSource.source.toRootSource.actual.OccurrenceAt
        (currentPresentation.backward current)) ->
    HEq
      (represented.compiler.ledgerCompiler.compilePatch
        ((occurrencePresentation current).forward occurrence))
      (actualSource.ledgerCompiler.compilePatch occurrence)
  /-- Complete presentation of source-owned cofinal boundary events.  The
  event identity is independent of an ordinary current and therefore cannot
  be reconstructed from the per-current occurrence presentation. -/
  cofinalEventPresentation :
    ConstructivePresentation ActualV.cofinal.Event V.cofinal.Event
  /-- The source decision whether a cofinal boundary occurrence was emitted,
  and which exact event it was, survives the rechart. -/
  cofinalEmit_commutes :
    Option.map cofinalEventPresentation.forward ActualV.cofinal.emit? =
      V.cofinal.emit?
  /-- Every finite predecessor patch of the cofinal occurrence is the same
  current after recharting. -/
  cofinalPath_commutes : (event : ActualV.cofinal.Event) -> (index : Nat) ->
    currentPresentation.forward (ActualV.cofinal.pathAt event index) =
      V.cofinal.pathAt (cofinalEventPresentation.forward event) index
  /-- The boundary landing itself is not a freely chosen current. -/
  cofinalTarget_commutes : (event : ActualV.cofinal.Event) ->
    currentPresentation.forward (ActualV.cofinal.target event) =
      V.cofinal.target (cofinalEventPresentation.forward event)
  terminal_exhausts_actual_inventory :
    {current : V.Current} ->
    (occurrence :
      actualSource.source.toRootSource.actual.OccurrenceAt
        (currentPresentation.backward current)) ->
    (terminal : V.FaithfulTerminalAt current) ->
    (evolutionPresentation current).forward
        (actualSource.source.toRootSource.actual.compile occurrence) =
      .faithfulTerminal terminal ->
    IsEmpty (SourceNativeActualOutgoingEventAt actualSource
      (currentPresentation.backward current))

namespace SourceNativeCompleteEventInventoryAdmission

/-- The exact lower event represented by one authority-source occurrence. -/
def actualOccurrenceAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {represented : SourceNativeRestructuringLedgerSource N V}
    (admission : SourceNativeCompleteEventInventoryAdmission represented)
    {current : V.Current}
    (occurrence : represented.source.toRootSource.actual.OccurrenceAt current) :
    admission.actualSource.source.toRootSource.actual.OccurrenceAt
      (admission.currentPresentation.backward current) :=
  (admission.occurrencePresentation current).backward occurrence

@[simp] theorem forward_actualOccurrenceAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {represented : SourceNativeRestructuringLedgerSource N V}
    (admission : SourceNativeCompleteEventInventoryAdmission represented)
    {current : V.Current}
    (occurrence : represented.source.toRootSource.actual.OccurrenceAt current) :
    (admission.occurrencePresentation current).forward
        (admission.actualOccurrenceAt occurrence) = occurrence :=
  (admission.occurrencePresentation current).forward_backward occurrence

/-- Structural branch and exact target of the admitted lower event agree
with the authority-source occurrence. -/
theorem actual_compile_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {represented : SourceNativeRestructuringLedgerSource N V}
    (admission : SourceNativeCompleteEventInventoryAdmission represented)
    {current : V.Current}
    (occurrence : represented.source.toRootSource.actual.OccurrenceAt current) :
    (admission.evolutionPresentation current).forward
        (admission.actualSource.source.toRootSource.actual.compile
          (admission.actualOccurrenceAt occurrence)) =
      represented.source.toRootSource.actual.compile occurrence := by
  rw [admission.structural_commutes current
    (admission.actualOccurrenceAt occurrence)]
  rw [admission.forward_actualOccurrenceAt occurrence]

/-- Structural branch identity survives the complete heterogeneous admission.
This is the direct detector for a caller attempting to relabel a native,
relation, continued, redirect, or terminal occurrence. -/
theorem actual_kind_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {represented : SourceNativeRestructuringLedgerSource N V}
    (admission : SourceNativeCompleteEventInventoryAdmission represented)
    {current : V.Current}
    (occurrence : represented.source.toRootSource.actual.OccurrenceAt current) :
    (represented.source.toRootSource.actual.compile occurrence).kind =
      (admission.actualSource.source.toRootSource.actual.compile
        (admission.actualOccurrenceAt occurrence)).kind := by
  let actualEvolution :=
    admission.actualSource.source.toRootSource.actual.compile
      (admission.actualOccurrenceAt occurrence)
  calc
    (represented.source.toRootSource.actual.compile occurrence).kind =
        ((admission.evolutionPresentation current).forward actualEvolution).kind :=
      congrArg EvolutionAt.kind (admission.actual_compile_eq occurrence).symm
    _ = actualEvolution.kind := admission.kind_commutes current actualEvolution

/-- A represented terminal is already a literal terminal in the admitted
concrete source.  This is derived from target commuting; a continuing concrete
branch would map `some target` to `none`. -/
def actualFaithfulTerminalAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {represented : SourceNativeRestructuringLedgerSource N V}
    (admission : SourceNativeCompleteEventInventoryAdmission represented)
    {current : V.Current}
    (occurrence : represented.source.toRootSource.actual.OccurrenceAt current)
    (terminal : V.FaithfulTerminalAt current)
    (terminal_eq : represented.source.toRootSource.actual.compile occurrence =
      .faithfulTerminal terminal) :
    { actualTerminal : admission.ActualV.FaithfulTerminalAt
        (admission.currentPresentation.backward current) //
      admission.actualSource.source.toRootSource.actual.compile
          (admission.actualOccurrenceAt occurrence) =
        .faithfulTerminal actualTerminal } := by
  let actualEvolution :=
    admission.actualSource.source.toRootSource.actual.compile
      (admission.actualOccurrenceAt occurrence)
  have mapped_next_eq :
      Option.map admission.currentPresentation.forward
          actualEvolution.nextCurrent? = none := by
    rw [admission.nextCurrent_commutes current actualEvolution]
    rw [show
      (admission.evolutionPresentation current).forward actualEvolution =
          represented.source.toRootSource.actual.compile occurrence from
        admission.actual_compile_eq occurrence]
    rw [terminal_eq]
    rfl
  generalize actualEvolution_eq : actualEvolution = generated at mapped_next_eq ⊢
  cases generated with
  | nativeWrite write => cases mapped_next_eq
  | relationWrite write => cases mapped_next_eq
  | continuedTransport write => cases mapped_next_eq
  | borromeanRedirect write => cases mapped_next_eq
  | faithfulTerminal actualTerminal =>
      exact ⟨actualTerminal, actualEvolution_eq⟩

/-- Whole-ledger write-back of the represented event is exactly the concrete
source compiler image, up to the admitted dependent presentation. -/
theorem wholeLedgerWriteBack_heq_actual
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {represented : SourceNativeRestructuringLedgerSource N V}
    (admission : SourceNativeCompleteEventInventoryAdmission represented)
    {current : V.Current}
    (occurrence : represented.source.toRootSource.actual.OccurrenceAt current) :
    HEq
      (represented.compiler.ledgerCompiler.compile occurrence)
      (admission.actualSource.ledgerCompiler.compile
        (admission.actualOccurrenceAt occurrence)) := by
  have commuting := admission.wholeLedgerWriteBack_commutes current
    (admission.actualOccurrenceAt occurrence)
  rw [admission.forward_actualOccurrenceAt occurrence] at commuting
  exact commuting

/-- The finite generated incidence patch is retained by the same admission;
the whole-ledger equality is therefore not a completed-table readout. -/
theorem finitePatch_heq_actual
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {represented : SourceNativeRestructuringLedgerSource N V}
    (admission : SourceNativeCompleteEventInventoryAdmission represented)
    {current : V.Current}
    (occurrence : represented.source.toRootSource.actual.OccurrenceAt current) :
    HEq
      (represented.compiler.ledgerCompiler.compilePatch occurrence)
      (admission.actualSource.ledgerCompiler.compilePatch
        (admission.actualOccurrenceAt occurrence)) := by
  have commuting := admission.finitePatch_commutes current
    (admission.actualOccurrenceAt occurrence)
  rw [admission.forward_actualOccurrenceAt occurrence] at commuting
  exact commuting

/-- A concrete emitted cofinal occurrence remains emitted under the complete
inventory admission.  This is the direct no-erasure detector at a finite
boundary. -/
theorem cofinal_emit_forward
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {represented : SourceNativeRestructuringLedgerSource N V}
    (admission : SourceNativeCompleteEventInventoryAdmission represented)
    {event : admission.ActualV.cofinal.Event}
    (emitted : admission.ActualV.cofinal.emit? = some event) :
    V.cofinal.emit? =
      some (admission.cofinalEventPresentation.forward event) := by
  rw [← admission.cofinalEmit_commutes, emitted]
  rfl

/-- A complete admission cannot erase a concrete emitted cofinal occurrence.
Unlike terminal exhaustiveness, this compares the source-owned boundary
emitter itself and therefore does not conflate a local terminal with absence
of all cofinal landings. -/
theorem no_cofinal_erasure
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {represented : SourceNativeRestructuringLedgerSource N V}
    (admission : SourceNativeCompleteEventInventoryAdmission represented)
    {event : admission.ActualV.cofinal.Event}
    (actualEmitted : admission.ActualV.cofinal.emit? = some event)
    (representedEmpty : V.cofinal.emit? = none) : False := by
  have emitted := admission.cofinal_emit_forward actualEmitted
  rw [representedEmpty] at emitted
  cases emitted

/-- An authority presentation cannot invent a cofinal occurrence when the
admitted concrete source emitted none. -/
theorem no_cofinal_insertion
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {represented : SourceNativeRestructuringLedgerSource N V}
    (admission : SourceNativeCompleteEventInventoryAdmission represented)
    (actualEmpty : admission.ActualV.cofinal.emit? = none)
    {event : V.cofinal.Event}
    (representedEmitted : V.cofinal.emit? = some event) : False := by
  have commuting := admission.cofinalEmit_commutes
  rw [actualEmpty, representedEmitted] at commuting
  cases commuting

/-- The admitted cofinal predecessor path commutes pointwise. -/
theorem cofinal_path_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {represented : SourceNativeRestructuringLedgerSource N V}
    (admission : SourceNativeCompleteEventInventoryAdmission represented)
    (event : admission.ActualV.cofinal.Event) (index : Nat) :
    admission.currentPresentation.forward
        (admission.ActualV.cofinal.pathAt event index) =
      V.cofinal.pathAt
        (admission.cofinalEventPresentation.forward event) index :=
  admission.cofinalPath_commutes event index

/-- The admitted cofinal landing target commutes exactly. -/
theorem cofinal_target_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {represented : SourceNativeRestructuringLedgerSource N V}
    (admission : SourceNativeCompleteEventInventoryAdmission represented)
    (event : admission.ActualV.cofinal.Event) :
    admission.currentPresentation.forward
        (admission.ActualV.cofinal.target event) =
      V.cofinal.target (admission.cofinalEventPresentation.forward event) :=
  admission.cofinalTarget_commutes event

/-- A represented faithful-terminal branch inherits the lower source's
constructive proof that no actual continuing event exists. -/
theorem noOutgoingActual_of_representedTerminal
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {represented : SourceNativeRestructuringLedgerSource N V}
    (admission : SourceNativeCompleteEventInventoryAdmission represented)
    {current : V.Current}
    (occurrence : represented.source.toRootSource.actual.OccurrenceAt current)
    (terminal : V.FaithfulTerminalAt current)
    (terminal_eq : represented.source.toRootSource.actual.compile occurrence =
      .faithfulTerminal terminal) :
    IsEmpty
      (SourceNativeActualOutgoingEventAt admission.actualSource
        (admission.currentPresentation.backward current)) :=
  admission.terminal_exhausts_actual_inventory
    (admission.actualOccurrenceAt occurrence) terminal <|
      (admission.actual_compile_eq occurrence).trans terminal_eq

/-- Identity admission for a source whose terminal semantics have already
been proved against its complete event inventory.  The exhaustiveness proof
is intentionally an argument: identity presentation alone must not turn a
selected terminal event into evidence that sibling continuations are absent. -/
def refl
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (represented : SourceNativeRestructuringLedgerSource N V)
    (terminalExhausts :
      {current : V.Current} ->
      (occurrence : represented.source.toRootSource.actual.OccurrenceAt current) ->
      (terminal : V.FaithfulTerminalAt current) ->
      represented.source.toRootSource.actual.compile occurrence =
          .faithfulTerminal terminal ->
    IsEmpty
        (SourceNativeActualOutgoingEventAt represented.toLedgerSource current)) :
    SourceNativeCompleteEventInventoryAdmission represented where
  ActualV := V
  actualSource := represented.toLedgerSource
  currentPresentation := ConstructivePresentation.refl _
  initial_eq := rfl
  occurrencePresentation := fun _ => ConstructivePresentation.refl _
  evolutionPresentation := fun _ => ConstructivePresentation.refl _
  structural_commutes := fun _ _ => rfl
  kind_commutes := fun _ evolution => by cases evolution <;> rfl
  nextCurrent_commutes := by
    intro current evolution
    cases evolution <;> rfl
  support_commutes := fun _ _ => rfl
  wholeLedgerWriteBack_commutes := fun _ _ => HEq.rfl
  finitePatch_commutes := fun _ _ => HEq.rfl
  cofinalEventPresentation := ConstructivePresentation.refl _
  cofinalEmit_commutes := by cases V.cofinal.emit? <;> rfl
  cofinalPath_commutes := fun _ _ => rfl
  cofinalTarget_commutes := fun _ => rfl
  terminal_exhausts_actual_inventory := terminalExhausts

/-- If the vocabulary has no faithful-terminal payload, the identity
admission is automatically exhaustive.  This is the common living-process
case and introduces no dummy terminal event. -/
def reflOfNoFaithfulTerminal
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (represented : SourceNativeRestructuringLedgerSource N V)
    (terminalEmpty : (current : V.Current) ->
      IsEmpty (V.FaithfulTerminalAt current)) :
    SourceNativeCompleteEventInventoryAdmission represented :=
  refl represented fun {current} _ terminal _ =>
    False.elim ((terminalEmpty current).false terminal)

/-- Identity admission for a genuinely terminal source whose complete lower
event inventory has no actual successor. -/
def reflOfNoActualSuccessor
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (represented : SourceNativeRestructuringLedgerSource N V)
    (noOutgoing : (current : V.Current) ->
      IsEmpty
        (SourceNativeActualOutgoingEventAt represented.toLedgerSource current)) :
    SourceNativeCompleteEventInventoryAdmission represented :=
  refl represented fun {current} _ _ _ => noOutgoing current

end SourceNativeCompleteEventInventoryAdmission

/-- A typed source datum keeps its carrier and value together. -/
abbrev SourceNativeMaterialBox : Type (u + 1) := Σ Material : Type u, Material

/-- The default source observation retains the actual occurrence and every
proof-relevant projection output, including inactive receipts. -/
def SourceNativeProjectionLaw.materialAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    (law : SourceNativeProjectionLaw source)
    {current : V.Current}
    (occurrence : source.source.toRootSource.actual.OccurrenceAt current) :
    SourceNativeMaterialBox.{u} :=
  ⟨Σ actual : source.source.toRootSource.actual.OccurrenceAt current,
      (projection : law.Projection) → SourceNativeProjectionFiberAt law projection actual,
    ⟨occurrence, fun projection => law.outcomeAt projection occurrence⟩⟩

/-- Complete source identity: native event/support law, canonical whole-ledger
compiler, exact lower event-inventory admission, the current law surface, and
the source-fixed projection family.  The projection family is not a global
completeness witness: `Projection := PUnit` names one coordinate only.  The law
surface is source state; changing it changes the source/law epoch and cannot be
hidden inside a later inquiry record.  No field may depend on a later chosen
root emitter. -/
structure SourceNativeAuthoritySource
    (N : WorldRelationNetwork.{u}) (V : Vocabulary.{u}) : Type (u + 1) where
  restructuringSource : SourceNativeRestructuringLedgerSource N V
  eventInventoryAdmission :
    SourceNativeCompleteEventInventoryAdmission restructuringSource
  lawSurface : TheoryState N
  projectionLaw : SourceNativeProjectionLaw restructuringSource.toLedgerSource
  observationAt : {current : V.Current} →
    restructuringSource.source.toRootSource.actual.OccurrenceAt current → SourceNativeMaterialBox.{u} :=
    projectionLaw.materialAt

/-- Both reads are generated from this source at the indexed actual occurrence. -/
structure SourceNativeGeneratedMaterialAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (source : SourceNativeAuthoritySource N V)
    {current : V.Current}
    (occurrence : source.restructuringSource.source.toRootSource.actual.OccurrenceAt current) :
    Type (u + 1) where
  private mk ::
  outcomes : (projection : source.projectionLaw.Projection) →
    SourceNativeProjectionFiberAt source.projectionLaw projection occurrence
  observation : SourceNativeMaterialBox.{u}

def SourceNativeAuthoritySource.generatedMaterialAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (source : SourceNativeAuthoritySource N V)
    {current : V.Current}
    (occurrence : source.restructuringSource.source.toRootSource.actual.OccurrenceAt current) :
    SourceNativeGeneratedMaterialAt source occurrence :=
  ⟨fun projection => source.projectionLaw.outcomeAt projection occurrence,
    source.observationAt occurrence⟩


@[simp] theorem SourceNativeAuthoritySource.generatedMaterialAt_outcomes
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (source : SourceNativeAuthoritySource N V)
    {current : V.Current}
    (occurrence : source.restructuringSource.source.toRootSource.actual.OccurrenceAt current)
    (projection : source.projectionLaw.Projection) :
    (source.generatedMaterialAt occurrence).outcomes projection =
      source.projectionLaw.outcomeAt projection occurrence := rfl

@[simp] theorem SourceNativeAuthoritySource.generatedMaterialAt_observation
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (source : SourceNativeAuthoritySource N V)
    {current : V.Current}
    (occurrence : source.restructuringSource.source.toRootSource.actual.OccurrenceAt current) :
    (source.generatedMaterialAt occurrence).observation = source.observationAt occurrence := rfl

/-- A strong root installs an emitter for one already complete authority
source.  It adds no classifier, projection, or domain compiler field. -/
structure SourceNativeAuthoritativeRootClosure
    (N : WorldRelationNetwork.{u}) (V : Vocabulary.{u}) : Type (u + 1) where
  source : SourceNativeAuthoritySource N V
  emitted : (current : V.Current) ->
    source.restructuringSource.source.toRootSource.actual.OccurrenceAt current
  compiler_commutes : (current : V.Current) ->
    (source.restructuringSource.compiler.ledgerCompiler.compile
      (emitted current)).CommutesWith emitted

/-- Forget only the authority inventory while retaining its exact
source-native root/ledger compiler. -/
def SourceNativeAuthoritativeRootClosure.toLedgerRoot
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (world : SourceNativeAuthoritativeRootClosure N V) :
    SourceNativeLedgerRootClosure N V where
  source := world.source.restructuringSource.toLedgerSource
  emitted := world.emitted
  compiler_commutes := world.compiler_commutes

/-- A root reads the source-fixed observation at its own emitted occurrence. -/
def SourceNativeAuthoritativeRootClosure.observationAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (world : SourceNativeAuthoritativeRootClosure N V)
    (current : V.Current) : SourceNativeMaterialBox.{u} :=
  world.source.observationAt (world.emitted current)

def SourceNativeAuthoritativeRootClosure.generatedMaterialAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (world : SourceNativeAuthoritativeRootClosure N V)
    (current : V.Current) : SourceNativeGeneratedMaterialAt world.source (world.emitted current) :=
  world.source.generatedMaterialAt (world.emitted current)

/-- Canonical whole-ledger output of the admitted authority source. -/
def SourceNativeAuthoritativeRootClosure.generatedLedgerAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (world : SourceNativeAuthoritativeRootClosure N V)
    (current : V.Current) :=
  world.toLedgerRoot.generatedLedgerAt current

/-- Canonical finite incidence patch of the admitted authority source. -/
def SourceNativeAuthoritativeRootClosure.generatedPatchAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (world : SourceNativeAuthoritativeRootClosure N V)
    (current : V.Current) :=
  world.toLedgerRoot.generatedPatchAt current

/-- Compatibility root view.  Authority APIs below retain `world` itself in
their type indices and never accept this erased view as a source argument. -/
def SourceNativeAuthoritativeRootClosure.toRoot
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (world : SourceNativeAuthoritativeRootClosure N V) : RootClosure N V :=
  world.toLedgerRoot.toRoot

/-- Compatibility name for the source law's ordinary dependent projection
fibre at one emitted current.  This is not a second active/inactive grammar:
static inventory and temporal coface use the same source-native fibre. -/
abbrev SourceNativeProjectionOutcomeAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (world : SourceNativeAuthoritativeRootClosure N V)
    (projection : world.source.projectionLaw.Projection)
    (current : V.Current) : Type u :=
  SourceNativeProjectionFiberAt world.source.projectionLaw projection
    (world.emitted current)

namespace SourceNativeAuthoritativeRootClosure

/-- Canonical raw outcome.  The only payload producer is the source law
applied to the same occurrence's canonical ledger compiler image. -/
def projectionOutcomeAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (world : SourceNativeAuthoritativeRootClosure N V)
    (projection : world.source.projectionLaw.Projection)
    (current : V.Current) :
    SourceNativeProjectionOutcomeAt world projection current :=
  world.source.projectionLaw.outcomeAt projection (world.emitted current)

/-!
The inactive branch is intentionally only a source-classifier readout.  It
does not consume the ledger compiler image and therefore cannot, without a
domain-specific exact recognition, be used as terminal, transfer, discharge,
or law-revision authority.
-/

end SourceNativeAuthoritativeRootClosure

end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
