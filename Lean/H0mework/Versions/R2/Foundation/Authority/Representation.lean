import H0mework.Versions.R2.Foundation.Authority.CausalEntry
import H0mework.Foundation.Semantics.CausalRealization
import H0mework.Foundation.Responsibility.Observer

/-!
# Root-coordinate restrictions of a source-native temporal visit

The source-native ledger compiler already generates one exact temporal root
evolution.  Every installed projection coordinate is a direct restriction of
its pre-emitter source law at that same finite/cofinal/post-cofinal occurrence.

The temporal occurrence itself is the common higher-dimensional coface; there
is no additional pair carrier and no global domain-name dictionary.  A
projection payload still needs its dedicated causal jurisdiction before it may
act on the world.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot

universe u

/-- Root-sealed causal occurrence of one complete admitted source. -/
abbrev SourceNativeRootCausalOccurrenceAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeAuthoritativeRootClosure N V)
    (visit : SourceNativeTemporalVisitAt root.toLedgerRoot) : Type (u + 1) :=
  SourceNativeAuthoritativeTemporalEvolutionAt root visit

/-- Root-sealed causal evolution with ledger texture available through its
canonical restriction. -/
abbrev SourceNativeRootCausalEvolutionAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeAuthoritativeRootClosure N V)
    (visit : SourceNativeTemporalVisitAt root.toLedgerRoot) : Type (u + 1) :=
  SourceNativeAuthoritativeTemporalEvolutionAt root visit

/-- Every root causal evolution token is the canonical compiler image. -/
theorem SourceNativeRootCausalEvolutionAt.eq_canonical
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    {visit : SourceNativeTemporalVisitAt root.toLedgerRoot}
    (evolution : SourceNativeRootCausalEvolutionAt root visit) :
    evolution = root.authoritativeEvolutionAt visit :=
  evolution.eq_authoritativeEvolutionAt

/-- Zero-information lawful token for the exact temporal root graph. -/
abbrev SourceNativeRootLawfulEvolutionAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeAuthoritativeRootClosure N V)
    {visit : SourceNativeTemporalVisitAt root.toLedgerRoot}
    (_occurrence : SourceNativeRootCausalOccurrenceAt root visit)
    (_evolution : SourceNativeRootCausalEvolutionAt root visit) : Type (u + 1) :=
  PUnit

/-- Field-free causal world derived from one fixed root.  The public current
is the registered finite/cofinal/post-cofinal visit; neither the occurrence
family nor the lawful graph is supplied by a presentation. -/
def SourceNativeAuthoritativeRootClosure.toCausalWorld
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeAuthoritativeRootClosure N V) :
    CausalCore.World.{u + 1} where
  Current := SourceNativeTemporalVisitAt root.toLedgerRoot
  OccurrenceAt := SourceNativeRootCausalOccurrenceAt root
  EvolutionAt := SourceNativeRootCausalEvolutionAt root
  emitted := root.authoritativeEvolutionAt
  LawfulEvolutionAt := fun occurrence evolution =>
    SourceNativeRootLawfulEvolutionAt root occurrence evolution

/-- Canonical root realization at one exact temporal occurrence. -/
def SourceNativeAuthoritativeRootClosure.causalRealize
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeAuthoritativeRootClosure N V)
    {visit : SourceNativeTemporalVisitAt root.toLedgerRoot}
    (_occurrence : SourceNativeRootCausalOccurrenceAt root visit) :
    SourceNativeRootCausalEvolutionAt root visit :=
  root.authoritativeEvolutionAt visit

def SourceNativeAuthoritativeRootClosure.causalLawful
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeAuthoritativeRootClosure N V)
    {visit : SourceNativeTemporalVisitAt root.toLedgerRoot}
    (occurrence : SourceNativeRootCausalOccurrenceAt root visit) :
    SourceNativeRootLawfulEvolutionAt root occurrence
      (root.causalRealize occurrence) :=
  PUnit.unit

theorem SourceNativeAuthoritativeRootClosure.causalLawful_unique
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeAuthoritativeRootClosure N V)
    {visit : SourceNativeTemporalVisitAt root.toLedgerRoot}
    (occurrence : SourceNativeRootCausalOccurrenceAt root visit)
    (evolution : SourceNativeRootCausalEvolutionAt root visit)
    (_lawful : SourceNativeRootLawfulEvolutionAt root occurrence evolution) :
    evolution = root.causalRealize occurrence :=
  evolution.eq_canonical

/-- No-suspended-causal-magic is generated by the root compiler; it is not a
premise accepted from a consumer. -/
def SourceNativeAuthoritativeRootClosure.noSuspendedCausalMagic
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeAuthoritativeRootClosure N V) :
    CausalCore.NoSuspendedCausalMagic root.toCausalWorld where
  realize := root.causalRealize
  lawful := root.causalLawful
  lawful_unique := root.causalLawful_unique

/-- Canonical process presentation generated by the fixed root. -/
def SourceNativeAuthoritativeRootClosure.canonicalCausalProcess
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeAuthoritativeRootClosure N V) :
    CausalCore.Process root.toCausalWorld :=
  root.noSuspendedCausalMagic.toProcess

/-- Identity presentation of the exact root occurrence carrier. -/
def SourceNativeAuthoritativeRootClosure.canonicalCausalFaithfulRealization
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeAuthoritativeRootClosure N V) :
    CausalCore.FaithfulRealization root.toCausalWorld
      root.canonicalCausalProcess where
  occurrencePresentation := fun _current =>
    { toFun := id
      invFun := id
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  emitted_commutes := fun _current => rfl
  compile_lawful := fun occurrence =>
    root.noSuspendedCausalMagic.lawful occurrence

/-- Every process returning this root's causal evolution carrier generates the
canonical temporal token at each registered visit. -/
theorem SourceNativeAuthoritativeRootClosure.process_generate_eq_canonical
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeAuthoritativeRootClosure N V)
    (process : CausalCore.Process root.toCausalWorld)
    (visit : SourceNativeTemporalVisitAt root.toLedgerRoot) :
    process.generate (show root.toCausalWorld.Current from visit) =
      root.authoritativeEvolutionAt visit :=
  (process.generate (show root.toCausalWorld.Current from visit)).eq_canonical

/-- Whole-ledger write-back is the dependent readout of the same canonical
temporal token. -/
theorem SourceNativeAuthoritativeRootClosure.process_generate_wholeLedger_eq_canonical
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeAuthoritativeRootClosure N V)
    (process : CausalCore.Process root.toCausalWorld)
    (visit : SourceNativeTemporalVisitAt root.toLedgerRoot) :
    HEq (process.generate
      (show root.toCausalWorld.Current from visit)).toLedgerReadout.wholeLedgerWriteBack
      (root.generatedLedgerAt visit.current) :=
  (process.generate
    (show root.toCausalWorld.Current from visit)).toLedgerReadout.wholeLedgerWriteBack_eq

/-- A faithful process event cannot hide a sibling root occurrence.  Inverting
its presentation at the emitted event recovers the fixed temporal occurrence
itself; all occurrence-indexed trace, patch, face, and write-back readouts
therefore retain the same causal identity. -/
theorem SourceNativeAuthoritativeRootClosure.faithful_emitted_recovers_root_occurrence
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeAuthoritativeRootClosure N V)
    {process : CausalCore.Process root.toCausalWorld}
    (faithful : CausalCore.FaithfulRealization root.toCausalWorld process)
    (visit : SourceNativeTemporalVisitAt root.toLedgerRoot) :
    (faithful.occurrencePresentation
      (show root.toCausalWorld.Current from visit)).invFun
        (process.emitted (show root.toCausalWorld.Current from visit)) =
      root.toCausalWorld.emitted
        (show root.toCausalWorld.Current from visit) := by
  let presentation := faithful.occurrencePresentation
    (show root.toCausalWorld.Current from visit)
  calc
    presentation.invFun
        (process.emitted (show root.toCausalWorld.Current from visit)) =
      presentation.invFun
        (presentation.toFun (root.toCausalWorld.emitted
          (show root.toCausalWorld.Current from visit))) := by
          exact congrArg presentation.invFun
            (faithful.emitted_commutes
              (show root.toCausalWorld.Current from visit)).symm
    _ = root.toCausalWorld.emitted
        (show root.toCausalWorld.Current from visit) :=
      presentation.left_inv (root.toCausalWorld.emitted
        (show root.toCausalWorld.Current from visit))

/-- Complete predecessor trace is consequently representation-invariant. -/
theorem SourceNativeAuthoritativeRootClosure.faithful_emitted_priorPatches_eq_root
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeAuthoritativeRootClosure N V)
    {process : CausalCore.Process root.toCausalWorld}
    (faithful : CausalCore.FaithfulRealization root.toCausalWorld process)
    (visit : SourceNativeTemporalVisitAt root.toLedgerRoot) :
      ((faithful.occurrencePresentation
      (show root.toCausalWorld.Current from visit)).invFun
        (process.emitted
          (show root.toCausalWorld.Current from visit))).toLedgerReadout.priorPatches =
      root.toLedgerRoot.generatedTemporalPriorPatchesAt visit.history := by
  rw [root.faithful_emitted_recovers_root_occurrence faithful visit]
  rfl

/-! ## Living answer-and-next representation -/

/-- Universe-aligned current carrier for the complete living-root result.
The lift carries no source, branch, answer, or successor field. -/
abbrev SourceNativeLivingRootCausalCurrentAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V) : Type (u + 3) :=
  ULift.{u + 3, u + 1}
    (SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot)

/-- Exact temporal occurrence presented at one living causal current. -/
abbrev SourceNativeLivingRootCausalOccurrenceAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V)
    (current : SourceNativeLivingRootCausalCurrentAt root) : Type (u + 3) :=
  ULift.{u + 3, u + 1}
    (ExactTemporalCausalRootEventAt
      root.toAuthoritativeRoot.toLedgerRoot current.down)

/-- Zero-field source-generated answer-and-next token.

The indexed root and temporal current already determine the exact occurrence,
every installed face, trace, patch, whole write-back and next living current.
No copy of any of those values is accepted from a process implementation. -/
structure SourceNativeLivingRootCausalEvolutionAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V)
    (current : SourceNativeLivingRootCausalCurrentAt root) : Type (u + 3) where
  private mk ::

/-- Exact temporal compiler image read from the token indices. -/
def SourceNativeLivingRootCausalEvolutionAt.generated
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {current : SourceNativeLivingRootCausalCurrentAt root}
    (_evolution : SourceNativeLivingRootCausalEvolutionAt root current) :
    SourceNativeTemporalVisitGeneratedEvolutionAt
      root.toAuthoritativeRoot.toLedgerRoot current.down :=
  root.toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit current.down

/-- Full next living current read from the same fixed root compiler. -/
def SourceNativeLivingRootCausalEvolutionAt.nextCurrent
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {current : SourceNativeLivingRootCausalCurrentAt root}
    (_evolution : SourceNativeLivingRootCausalEvolutionAt root current) :
    SourceNativeAuthoritativeRootCurrentAt N :=
  root.generatedNextCurrentAt current.down

@[simp] theorem SourceNativeLivingRootCausalEvolutionAt.next_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {current : SourceNativeLivingRootCausalCurrentAt root}
    (evolution : SourceNativeLivingRootCausalEvolutionAt root current) :
    evolution.nextCurrent = root.generatedNextCurrentAt current.down :=
  rfl

/-- Canonical answer-and-next result of the fixed living root. -/
def SourceNativeLivingRootClosure.canonicalCausalAnswerAndNext
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V)
    (current : SourceNativeLivingRootCausalCurrentAt root) :
    SourceNativeLivingRootCausalEvolutionAt root current :=
  .mk

/-- Every inhabitant of the living-root evolution carrier is the literal
compiler image. -/
theorem SourceNativeLivingRootCausalEvolutionAt.eq_canonical
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {current : SourceNativeLivingRootCausalCurrentAt root}
    (evolution : SourceNativeLivingRootCausalEvolutionAt root current) :
    evolution = root.canonicalCausalAnswerAndNext current := by
  cases evolution
  rfl

/-- Zero-information lawful token for source-generated singleton occurrence
and evolution graphs at the indexed living current. -/
abbrev SourceNativeLivingRootCausalLawfulEvolutionAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V)
    {current : SourceNativeLivingRootCausalCurrentAt root}
    (_occurrence : SourceNativeLivingRootCausalOccurrenceAt root current)
    (_evolution : SourceNativeLivingRootCausalEvolutionAt root current) :
    Type (u + 3) := PUnit

/-- Field-free causal world whose evolution is the complete living
answer-and-next result, not a pre-handoff ledger fragment. -/
def SourceNativeLivingRootClosure.toAnswerNextCausalWorld
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V) :
    CausalCore.World.{u + 3} where
  Current := SourceNativeLivingRootCausalCurrentAt root
  OccurrenceAt := SourceNativeLivingRootCausalOccurrenceAt root
  EvolutionAt := SourceNativeLivingRootCausalEvolutionAt root
  emitted := fun current =>
    ULift.up
      (root.toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit current.down)
  LawfulEvolutionAt := fun occurrence evolution =>
    SourceNativeLivingRootCausalLawfulEvolutionAt root occurrence evolution

/-- No-suspended-causal-magic is derived from the living root compiler,
including its terminal handoff law. -/
def SourceNativeLivingRootClosure.answerNextNoSuspendedCausalMagic
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V) :
    CausalCore.NoSuspendedCausalMagic root.toAnswerNextCausalWorld where
  realize := fun {current} _occurrence =>
    root.canonicalCausalAnswerAndNext current
  lawful := fun _occurrence => PUnit.unit
  lawful_unique := fun _occurrence evolution _lawful => evolution.eq_canonical

def SourceNativeLivingRootClosure.canonicalAnswerNextCausalProcess
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V) :
    CausalCore.Process root.toAnswerNextCausalWorld :=
  root.answerNextNoSuspendedCausalMagic.toProcess

def SourceNativeLivingRootClosure.canonicalAnswerNextFaithfulRealization
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V) :
    CausalCore.FaithfulRealization root.toAnswerNextCausalWorld
      root.canonicalAnswerNextCausalProcess where
  occurrencePresentation := fun _current =>
    { toFun := id
      invFun := id
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  emitted_commutes := fun _current => rfl
  compile_lawful := fun occurrence =>
    root.answerNextNoSuspendedCausalMagic.lawful occurrence

/-- Every process returning the living-root evolution carrier generates the
complete canonical answer-and-next result. -/
theorem SourceNativeLivingRootClosure.process_generate_eq_answerAndNext
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V)
    (process : CausalCore.Process root.toAnswerNextCausalWorld)
    (visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot) :
    process.generate (ULift.up visit) =
      root.canonicalCausalAnswerAndNext (ULift.up visit) :=
  (process.generate (ULift.up visit)).eq_canonical

/-- The faithful event presentation also recovers the exact living-root
occurrence; answer-and-next equality cannot be purchased by relabelling a
sibling event. -/
theorem SourceNativeLivingRootClosure.faithful_emitted_recovers_answerNext_occurrence
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V)
    {process : CausalCore.Process root.toAnswerNextCausalWorld}
    (faithful : CausalCore.FaithfulRealization
      root.toAnswerNextCausalWorld process)
    (visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot) :
    (faithful.occurrencePresentation (ULift.up visit)).invFun
        (process.emitted (ULift.up visit)) =
      root.toAnswerNextCausalWorld.emitted (ULift.up visit) := by
  let presentation := faithful.occurrencePresentation (ULift.up visit)
  calc
    presentation.invFun (process.emitted (ULift.up visit)) =
      presentation.invFun
        (presentation.toFun
          (root.toAnswerNextCausalWorld.emitted (ULift.up visit))) := by
            exact congrArg presentation.invFun
              (faithful.emitted_commutes (ULift.up visit)).symm
    _ = root.toAnswerNextCausalWorld.emitted (ULift.up visit) :=
      presentation.left_inv
        (root.toAnswerNextCausalWorld.emitted (ULift.up visit))

/-! ## Source-process answer-and-next representation -/

/-- A global living current is a state of one already fixed source process.
The lift changes only the universe; it does not add a state bit or a future
choice. -/
abbrev SourceNativeLivingProcessCausalCurrentAt
    {N : WorldRelationNetwork.{u}}
    (sourceProcess : SourceNativeLivingRootProcess N) : Type (u + 4) :=
  ULift.{u + 4, u} sourceProcess.State

/-- The exact root occurrence emitted at a state of the fixed source process.
The dependent root and temporal visit are read from `stateAt`; a presentation
cannot choose either one. -/
abbrev SourceNativeLivingProcessCausalOccurrenceAt
    {N : WorldRelationNetwork.{u}}
    (sourceProcess : SourceNativeLivingRootProcess N)
    (current : SourceNativeLivingProcessCausalCurrentAt sourceProcess) :
    Type (u + 4) :=
  ULift.{u + 4, u + 1}
    (ExactTemporalCausalRootEventAt
      (sourceProcess.stateAt current.down).root.toAuthoritativeRoot.toLedgerRoot
      (sourceProcess.stateAt current.down).visit)

/-- Zero-field source-process evolution token at one state.

The indexed process and state determine both the exact root answer and the
next state.  A process implementation cannot submit either value. -/
structure SourceNativeLivingProcessCausalEvolutionAt
    {N : WorldRelationNetwork.{u}}
    (sourceProcess : SourceNativeLivingRootProcess N)
    (current : SourceNativeLivingProcessCausalCurrentAt sourceProcess) :
    Type (u + 4) where
  private mk ::

/-- Exact root answer read from the fixed source-process state. -/
def SourceNativeLivingProcessCausalEvolutionAt.generated
    {N : WorldRelationNetwork.{u}}
    {sourceProcess : SourceNativeLivingRootProcess N}
    {current : SourceNativeLivingProcessCausalCurrentAt sourceProcess}
    (_evolution : SourceNativeLivingProcessCausalEvolutionAt
      sourceProcess current) :
    SourceNativeTemporalVisitGeneratedEvolutionAt
      (sourceProcess.stateAt current.down).root.toAuthoritativeRoot.toLedgerRoot
      (sourceProcess.stateAt current.down).visit :=
  (sourceProcess.stateAt current.down).root.toAuthoritativeRoot.toLedgerRoot
    |>.generatedAtTemporalVisit (sourceProcess.stateAt current.down).visit

/-- Next process state read from the source-owned successor law. -/
def SourceNativeLivingProcessCausalEvolutionAt.nextState
    {N : WorldRelationNetwork.{u}}
    {sourceProcess : SourceNativeLivingRootProcess N}
    {current : SourceNativeLivingProcessCausalCurrentAt sourceProcess}
    (_evolution : SourceNativeLivingProcessCausalEvolutionAt
      sourceProcess current) : sourceProcess.State :=
  sourceProcess.successor current.down

@[simp] theorem SourceNativeLivingProcessCausalEvolutionAt.nextState_eq
    {N : WorldRelationNetwork.{u}}
    {sourceProcess : SourceNativeLivingRootProcess N}
    {current : SourceNativeLivingProcessCausalCurrentAt sourceProcess}
    (evolution : SourceNativeLivingProcessCausalEvolutionAt
      sourceProcess current) :
    evolution.nextState = sourceProcess.successor current.down :=
  rfl

/-- Full next living current.  It is a derived readout of the fixed process
state and cannot be supplied independently. -/
def SourceNativeLivingProcessCausalEvolutionAt.nextCurrent
    {N : WorldRelationNetwork.{u}}
    {sourceProcess : SourceNativeLivingRootProcess N}
    {current : SourceNativeLivingProcessCausalCurrentAt sourceProcess}
    (evolution : SourceNativeLivingProcessCausalEvolutionAt
      sourceProcess current) :
    SourceNativeLivingRootCurrentAt N :=
  sourceProcess.stateAt evolution.nextState

/-- Canonical full answer-and-next result of the fixed source process. -/
def SourceNativeLivingRootProcess.canonicalCausalAnswerAndNext
    {N : WorldRelationNetwork.{u}}
    (sourceProcess : SourceNativeLivingRootProcess N)
    (current : SourceNativeLivingProcessCausalCurrentAt sourceProcess) :
    SourceNativeLivingProcessCausalEvolutionAt sourceProcess current :=
  .mk

/-- Equal complete registered currents generate the same exact root
answer-and-next occurrence.  Any external premise which changes this output
must therefore change the registered current or the source process itself. -/
theorem SourceNativeLivingRootProcess.canonicalAnswerAndNext_heq_of_current_eq
    {N : WorldRelationNetwork.{u}}
    (sourceProcess : SourceNativeLivingRootProcess N)
    {left right : sourceProcess.State}
    (current_eq : sourceProcess.stateAt left = sourceProcess.stateAt right) :
    HEq
      (sourceProcess.canonicalCausalAnswerAndNext (ULift.up left))
      (sourceProcess.canonicalCausalAnswerAndNext (ULift.up right)) := by
  have state_eq : left = right :=
    sourceProcess.stateAt_injective current_eq
  cases state_eq
  rfl

@[simp] theorem SourceNativeLivingRootProcess.canonical_nextCurrent_eq
    {N : WorldRelationNetwork.{u}}
    (sourceProcess : SourceNativeLivingRootProcess N)
    (current : SourceNativeLivingProcessCausalCurrentAt sourceProcess) :
    (sourceProcess.canonicalCausalAnswerAndNext current).nextCurrent =
      sourceProcess.stateAt (sourceProcess.successor current.down) :=
  rfl

/-- Every inhabitant of the source-process evolution carrier is its canonical
answer-and-next image. -/
theorem SourceNativeLivingProcessCausalEvolutionAt.eq_canonical
    {N : WorldRelationNetwork.{u}}
    {sourceProcess : SourceNativeLivingRootProcess N}
    {current : SourceNativeLivingProcessCausalCurrentAt sourceProcess}
    (evolution : SourceNativeLivingProcessCausalEvolutionAt
      sourceProcess current) :
    evolution = sourceProcess.canonicalCausalAnswerAndNext current := by
  cases evolution
  rfl

/-- Zero-information lawful token for one fixed source process.  Candidate
uniqueness follows from the evolution carrier. -/
abbrev SourceNativeLivingProcessCausalLawfulEvolutionAt
    {N : WorldRelationNetwork.{u}}
    (sourceProcess : SourceNativeLivingRootProcess N)
    {current : SourceNativeLivingProcessCausalCurrentAt sourceProcess}
    (_occurrence : SourceNativeLivingProcessCausalOccurrenceAt
      sourceProcess current)
    (_evolution : SourceNativeLivingProcessCausalEvolutionAt
      sourceProcess current) : Type (u + 4) := PUnit

/-- Field-free causal world of one complete source process.  Its world
identity includes the process law that installs every successor living root;
two processes which reuse one local root but choose different later laws are
different source worlds, not two presentations of this world. -/
def SourceNativeLivingRootProcess.toAnswerNextCausalWorld
    {N : WorldRelationNetwork.{u}}
    (sourceProcess : SourceNativeLivingRootProcess N) :
    CausalCore.World.{u + 4} where
  Current := SourceNativeLivingProcessCausalCurrentAt sourceProcess
  OccurrenceAt := SourceNativeLivingProcessCausalOccurrenceAt sourceProcess
  EvolutionAt := SourceNativeLivingProcessCausalEvolutionAt sourceProcess
  emitted := fun current =>
    ULift.up
      ((sourceProcess.stateAt current.down).root.toAuthoritativeRoot.toLedgerRoot
        |>.generatedAtTemporalVisit (sourceProcess.stateAt current.down).visit)
  LawfulEvolutionAt := fun occurrence evolution =>
    SourceNativeLivingProcessCausalLawfulEvolutionAt
      sourceProcess occurrence evolution

/-- No-suspended-causal-magic is generated by the fixed source process. -/
def SourceNativeLivingRootProcess.answerNextNoSuspendedCausalMagic
    {N : WorldRelationNetwork.{u}}
    (sourceProcess : SourceNativeLivingRootProcess N) :
    CausalCore.NoSuspendedCausalMagic
      sourceProcess.toAnswerNextCausalWorld where
  realize := fun {current} _occurrence =>
    sourceProcess.canonicalCausalAnswerAndNext current
  lawful := fun _occurrence => PUnit.unit
  lawful_unique := fun _occurrence evolution _lawful => evolution.eq_canonical

def SourceNativeLivingRootProcess.canonicalAnswerNextCausalProcess
    {N : WorldRelationNetwork.{u}}
    (sourceProcess : SourceNativeLivingRootProcess N) :
    CausalCore.Process sourceProcess.toAnswerNextCausalWorld :=
  sourceProcess.answerNextNoSuspendedCausalMagic.toProcess

def SourceNativeLivingRootProcess.canonicalAnswerNextFaithfulRealization
    {N : WorldRelationNetwork.{u}}
    (sourceProcess : SourceNativeLivingRootProcess N) :
    CausalCore.FaithfulRealization sourceProcess.toAnswerNextCausalWorld
      sourceProcess.canonicalAnswerNextCausalProcess where
  occurrencePresentation := fun _current =>
    { toFun := id
      invFun := id
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  emitted_commutes := fun _current => rfl
  compile_lawful := fun occurrence =>
    sourceProcess.answerNextNoSuspendedCausalMagic.lawful occurrence

/-- Every process returning this source-process evolution carrier generates
the canonical answer and full next living current. -/
theorem SourceNativeLivingRootProcess.process_generate_eq_answerAndNext
    {N : WorldRelationNetwork.{u}}
    (sourceProcess : SourceNativeLivingRootProcess N)
    (process : CausalCore.Process sourceProcess.toAnswerNextCausalWorld)
    (state : sourceProcess.State) :
    process.generate (ULift.up state) =
      sourceProcess.canonicalCausalAnswerAndNext (ULift.up state) :=
  (process.generate (ULift.up state)).eq_canonical

/-- Any two processes returning the fixed source-process carrier generate the
same evolution. -/
theorem SourceNativeLivingRootProcess.processes_generate_eq
    {N : WorldRelationNetwork.{u}}
    (sourceProcess : SourceNativeLivingRootProcess N)
    (left right : CausalCore.Process sourceProcess.toAnswerNextCausalWorld)
    (state : sourceProcess.State) :
    left.generate (ULift.up state) = right.generate (ULift.up state) :=
  (sourceProcess.process_generate_eq_answerAndNext left state).trans
    (sourceProcess.process_generate_eq_answerAndNext right state).symm

/-- The generated next-current readout retains the complete living source
law selected by the source process. -/
theorem SourceNativeLivingRootProcess.process_nextCurrent_eq_source
    {N : WorldRelationNetwork.{u}}
    (sourceProcess : SourceNativeLivingRootProcess N)
    (process : CausalCore.Process sourceProcess.toAnswerNextCausalWorld)
    (state : sourceProcess.State) :
    (process.generate (ULift.up state)).nextCurrent =
      sourceProcess.stateAt (sourceProcess.successor state) := by
  rw [sourceProcess.process_generate_eq_answerAndNext process state]
  rfl

/-! ## Raw-world representation -/

/-- Neutral living world data: a fixed source/law epoch and its emitted
occurrences, before a root-closure proof or causal process is selected. -/
structure SourceNativeLivingRawWorld
    (N : WorldRelationNetwork.{u}) (V : Vocabulary.{u}) : Type (u + 2) where
  source : SourceNativeLivingAuthoritySource N V
  emitted : (current : V.Current) →
    source.base.restructuringSource.source.toRootSource.actual.OccurrenceAt current

/-- Positive causal closure condition for a neutral raw world.

It says exactly that the source compiler's generated target occurrence is the
occurrence emitted by this raw world.  It is a commuting-square witness, not a
caller-supplied outcome, classifier, process, or `NoMagic` proposition. -/
structure SourceNativeLivingRootCommutingAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (raw : SourceNativeLivingRawWorld N V) : Prop where
  compiler_commutes : (current : V.Current) →
    (raw.source.base.restructuringSource.compiler.ledgerCompiler.compile
      (raw.emitted current)).CommutesWith raw.emitted

/-- The raw occurrence emitter and positive commuting square generate the
canonical living root. -/
def SourceNativeLivingRawWorld.toLivingRoot
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (raw : SourceNativeLivingRawWorld N V)
    (commuting : SourceNativeLivingRootCommutingAt raw) :
    SourceNativeLivingRootClosure N V where
  source := raw.source
  emitted := raw.emitted
  compiler_commutes := commuting.compiler_commutes

/-- Closure proof presentation cannot fork one fixed raw world. -/
theorem SourceNativeLivingRawWorld.toLivingRoot_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (raw : SourceNativeLivingRawWorld N V)
    (left right : SourceNativeLivingRootCommutingAt raw) :
    raw.toLivingRoot left = raw.toLivingRoot right := by
  cases left
  cases right
  rfl

/-- Constructive representation existence.  The process and faithful
realization are derived values of the fixed raw world; neither is accepted
from the consumer. -/
def SourceNativeLivingRawWorld.canonicalRepresentation
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (raw : SourceNativeLivingRawWorld N V)
    (commuting : SourceNativeLivingRootCommutingAt raw) :
    Sigma fun process : CausalCore.Process
        (raw.toLivingRoot commuting).toAnswerNextCausalWorld =>
      CausalCore.FaithfulRealization
        (raw.toLivingRoot commuting).toAnswerNextCausalWorld process :=
  ⟨(raw.toLivingRoot commuting).canonicalAnswerNextCausalProcess,
    (raw.toLivingRoot commuting).canonicalAnswerNextFaithfulRealization⟩

/-- Every process returning the represented world's evolution carrier
generates its canonical answer-and-next result. -/
theorem SourceNativeLivingRawWorld.process_generate_eq_canonical
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (raw : SourceNativeLivingRawWorld N V)
    (commuting : SourceNativeLivingRootCommutingAt raw)
    (process : CausalCore.Process
      (raw.toLivingRoot commuting).toAnswerNextCausalWorld)
    (visit : SourceNativeTemporalVisitAt
      (raw.toLivingRoot commuting).toAuthoritativeRoot.toLedgerRoot) :
    process.generate (ULift.up visit) =
      (raw.toLivingRoot commuting).canonicalCausalAnswerAndNext
        (ULift.up visit) :=
  (raw.toLivingRoot commuting).process_generate_eq_answerAndNext process visit

/-- Any two processes returning one represented world's carrier generate the
same complete evolution. -/
theorem SourceNativeLivingRawWorld.processes_generate_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (raw : SourceNativeLivingRawWorld N V)
    (commuting : SourceNativeLivingRootCommutingAt raw)
    (left right : CausalCore.Process
      (raw.toLivingRoot commuting).toAnswerNextCausalWorld)
    (visit : SourceNativeTemporalVisitAt
      (raw.toLivingRoot commuting).toAuthoritativeRoot.toLedgerRoot) :
    left.generate (ULift.up visit) = right.generate (ULift.up visit) :=
  (raw.process_generate_eq_canonical commuting left visit).trans
    (raw.process_generate_eq_canonical commuting right visit).symm

/-- Strong representation uniqueness for one fixed raw living world.

Two faithful processes are not merely extensionally equal on generated
answers.  Their event carriers are constructively presented through the same
exact root occurrence, and both emitter and compiler commute.  Thus no field
inside a composite process acquires root authority merely because a sibling
field is grounded. -/
def SourceNativeLivingRawWorld.processes_commutingPresentation
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (raw : SourceNativeLivingRawWorld N V)
    (commuting : SourceNativeLivingRootCommutingAt raw)
    {left right : CausalCore.Process
      (raw.toLivingRoot commuting).toAnswerNextCausalWorld}
    (leftFaithful : CausalCore.FaithfulRealization
      (raw.toLivingRoot commuting).toAnswerNextCausalWorld left)
    (rightFaithful : CausalCore.FaithfulRealization
      (raw.toLivingRoot commuting).toAnswerNextCausalWorld right) :
    CausalCore.ProcessCommutingPresentation left right :=
  leftFaithful.commutingPresentation
    (raw.toLivingRoot commuting).answerNextNoSuspendedCausalMagic
    rightFaithful

/-- Converse authority boundary: the candidate carrier itself forces the
fixed raw world's canonical evolution, hence it equals every process output
in that carrier. -/
theorem SourceNativeLivingRawWorld.evolution_eq_process_generate
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (raw : SourceNativeLivingRawWorld N V)
    (commuting : SourceNativeLivingRootCommutingAt raw)
    (process : CausalCore.Process
      (raw.toLivingRoot commuting).toAnswerNextCausalWorld)
    (visit : SourceNativeTemporalVisitAt
      (raw.toLivingRoot commuting).toAuthoritativeRoot.toLedgerRoot)
    (candidate : SourceNativeLivingRootCausalEvolutionAt
      (raw.toLivingRoot commuting) (ULift.up visit)) :
    candidate = process.generate (ULift.up visit) :=
  candidate.eq_canonical.trans
    (raw.process_generate_eq_canonical commuting process visit).symm

/-- One installed coordinate is a restriction of the canonical temporal root
occurrence.  The source-law coordinate selects the dependent fibre; a domain
name cannot create a second coface carrier. -/
def SourceNativeTemporalVisitGeneratedEvolutionAt.projectionOutcome
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {world : SourceNativeAuthoritativeRootClosure N V}
    {visit : SourceNativeTemporalVisitAt world.toLedgerRoot}
    (rootOccurrence :
      SourceNativeTemporalVisitGeneratedEvolutionAt world.toLedgerRoot visit)
    (projection : world.source.projectionLaw.Projection) :
    SourceNativeProjectionFiberAt world.source.projectionLaw
      projection rootOccurrence.occurrence :=
  world.source.projectionLaw.outcomeAt
    projection rootOccurrence.occurrence

/-- Every installed coordinate is the fixed source-law restriction at the exact
temporal occurrence.  `HEq` preserves the dependent occurrence index; no
observer inversion or face-to-face transport is involved. -/
theorem SourceNativeTemporalVisitGeneratedEvolutionAt.projectionOutcome_heq_sourceOutcome
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {world : SourceNativeAuthoritativeRootClosure N V}
    {visit : SourceNativeTemporalVisitAt world.toLedgerRoot}
    (rootOccurrence :
      SourceNativeTemporalVisitGeneratedEvolutionAt world.toLedgerRoot visit)
    (projection : world.source.projectionLaw.Projection) :
    HEq (rootOccurrence.projectionOutcome projection)
      (world.projectionOutcomeAt projection visit.current) := by
  change HEq
    (world.source.projectionLaw.outcomeAt
      projection rootOccurrence.occurrence)
    (world.source.projectionLaw.outcomeAt
      projection (world.emitted visit.current))
  rw [rootOccurrence.occurrence_eq]
  rfl

/-- Every installed subsystem coordinate is a readout of the canonical
temporal ledger occurrence and its whole-ledger compiler image.  This theorem
does not grant authority: its receiver has forgotten the admitted source. -/
theorem SourceNativeTemporalVisitGeneratedEvolutionAt.installedSubsystemReadout_factorizes
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {world : SourceNativeAuthoritativeRootClosure N V}
    {visit : SourceNativeTemporalVisitAt world.toLedgerRoot}
    (rootOccurrence :
      SourceNativeTemporalVisitGeneratedEvolutionAt world.toLedgerRoot visit)
    {component : SourceNativeProjectionLaw world.toLedgerRoot.source}
    (installation : SourceNativeProjectionLaw.InstallationAt component
      world.source.projectionLaw)
    (projection : component.Projection) :
    rootOccurrence = world.toLedgerRoot.generatedAtTemporalVisit visit ∧
      HEq (rootOccurrence.projectionOutcome
          (installation.embed projection))
        (component.outcomeAt projection
          (world.emitted visit.current)) :=
  ⟨rootOccurrence.eq_generated,
    (rootOccurrence.projectionOutcome_heq_sourceOutcome
      (installation.embed projection)).trans
        (installation.outcome_heq
          (world.emitted visit.current) projection)⟩

/-- Every authority-bearing installed subsystem coordinate factors through
the exact admitted-root temporal occurrence.  The erased ledger readout is
derived internally; callers cannot substitute a sibling root's readout. -/
theorem SourceNativeAuthoritativeTemporalEvolutionAt.installedSubsystemAuthority_factorizes
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {world : SourceNativeAuthoritativeRootClosure N V}
    {visit : SourceNativeTemporalVisitAt world.toLedgerRoot}
    (authority : SourceNativeAuthoritativeTemporalEvolutionAt world visit)
    {component : SourceNativeProjectionLaw world.toLedgerRoot.source}
    (installation : SourceNativeProjectionLaw.InstallationAt component
      world.source.projectionLaw)
    (projection : component.Projection) :
    authority.toLedgerReadout = world.toLedgerRoot.generatedAtTemporalVisit visit ∧
      HEq (authority.toLedgerReadout.projectionOutcome
          (installation.embed projection))
        (component.outcomeAt projection
          (world.emitted visit.current)) :=
  authority.toLedgerReadout.installedSubsystemReadout_factorizes
    installation projection

/-- Every installed subsystem coordinate of a lawful living evolution factors
through the same exact temporal occurrence and answer-and-next compiler.

This is the constructive positive form of root-authority factorization.  It
does not quantify over arbitrary Lean declarations: a domain value first has
to be installed in the fixed source projection inventory before it can enter
this theorem. -/
theorem SourceNativeLivingRootCausalEvolutionAt.installedSubsystemAuthority_factorizes
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {current : SourceNativeLivingRootCausalCurrentAt root}
    (evolution : SourceNativeLivingRootCausalEvolutionAt root current)
    {component : SourceNativeProjectionLaw
      root.toAuthoritativeRoot.toLedgerRoot.source}
    (installation : SourceNativeProjectionLaw.InstallationAt component
      root.toAuthoritativeRoot.source.projectionLaw)
    (projection : component.Projection) :
    evolution.generated =
        root.toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit
          current.down ∧
      HEq (evolution.generated.projectionOutcome
          (installation.embed projection))
        (component.outcomeAt projection
          (root.emitted current.down.current)) ∧
      evolution.nextCurrent = root.generatedNextCurrentAt current.down :=
  let factorized :=
    evolution.generated.installedSubsystemReadout_factorizes
      installation projection
  ⟨factorized.1, factorized.2, evolution.next_eq⟩

/-- An installed subsystem coordinate also factors through a complete
source-process step.

The process state fixes the living root and temporal visit before the face is
read.  Consequently a carrier or weight rechart at the next process state
cannot retrospectively replace the current face, occurrence, ledger image, or
successor law.  This is the cross-step form of single-root authority
factorization; it introduces no second registry or domain bridge. -/
theorem SourceNativeLivingProcessCausalEvolutionAt.installedSubsystemAuthority_factorizes
    {N : WorldRelationNetwork.{u}}
    {sourceProcess : SourceNativeLivingRootProcess N}
    {current : SourceNativeLivingProcessCausalCurrentAt sourceProcess}
    (evolution : SourceNativeLivingProcessCausalEvolutionAt
      sourceProcess current)
    {component : SourceNativeProjectionLaw
      (sourceProcess.stateAt current.down).root.toAuthoritativeRoot.toLedgerRoot.source}
    (installation : SourceNativeProjectionLaw.InstallationAt component
      (sourceProcess.stateAt current.down).root.toAuthoritativeRoot.source.projectionLaw)
    (projection : component.Projection) :
    evolution.generated =
        SourceNativeLedgerRootClosure.generatedAtTemporalVisit
          (sourceProcess.stateAt current.down).root.toAuthoritativeRoot.toLedgerRoot
          (sourceProcess.stateAt current.down).visit ∧
      HEq (evolution.generated.projectionOutcome
          (installation.embed projection))
        (component.outcomeAt projection
          ((sourceProcess.stateAt current.down).root.emitted
            (sourceProcess.stateAt current.down).visit.current)) ∧
      evolution.nextCurrent =
        sourceProcess.stateAt (sourceProcess.successor current.down) :=
  let factorized :=
    evolution.generated.installedSubsystemReadout_factorizes
      installation projection
  ⟨factorized.1, factorized.2, rfl⟩

/-- Two domain faces are read simultaneously from one higher-dimensional root
occurrence.  This is a dependent readout, not a pairwise bridge: neither face
is used to reconstruct the other, and no comparator or second carrier is
introduced. -/
def SourceNativeTemporalVisitGeneratedEvolutionAt.jointFaceReadout
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {world : SourceNativeAuthoritativeRootClosure N V}
    {visit : SourceNativeTemporalVisitAt world.toLedgerRoot}
    (rootOccurrence :
      SourceNativeTemporalVisitGeneratedEvolutionAt world.toLedgerRoot visit)
    (left right : world.source.projectionLaw.Projection) :
    SourceNativeProjectionFiberAt world.source.projectionLaw
        left rootOccurrence.occurrence ×
      SourceNativeProjectionFiberAt world.source.projectionLaw
        right rootOccurrence.occurrence :=
  ⟨rootOccurrence.projectionOutcome left,
    rootOccurrence.projectionOutcome right⟩

/-- Both coordinates of `jointFaceReadout` are restrictions of the same exact
source occurrence.  A low-dimensional observer may quotient a direction, but
the root coface never has to infer that direction from either shadow. -/
theorem SourceNativeTemporalVisitGeneratedEvolutionAt.jointFaceReadout_heq_sourceOutcomes
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {world : SourceNativeAuthoritativeRootClosure N V}
    {visit : SourceNativeTemporalVisitAt world.toLedgerRoot}
    (rootOccurrence :
      SourceNativeTemporalVisitGeneratedEvolutionAt world.toLedgerRoot visit)
    (left right : world.source.projectionLaw.Projection) :
    HEq (rootOccurrence.jointFaceReadout left right).1
        (world.projectionOutcomeAt left visit.current) ∧
      HEq (rootOccurrence.jointFaceReadout left right).2
        (world.projectionOutcomeAt right visit.current) :=
  ⟨rootOccurrence.projectionOutcome_heq_sourceOutcome left,
    rootOccurrence.projectionOutcome_heq_sourceOutcome right⟩

/-- Two installed component laws are read simultaneously on the canonical
temporal coface.  Each coordinate remains in the complete root inventory. -/
def SourceNativeTemporalVisitGeneratedEvolutionAt.installedJointFaceReadout
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {world : SourceNativeAuthoritativeRootClosure N V}
    {visit : SourceNativeTemporalVisitAt world.toLedgerRoot}
    (rootOccurrence :
      SourceNativeTemporalVisitGeneratedEvolutionAt world.toLedgerRoot visit)
    {leftComponent rightComponent :
      SourceNativeProjectionLaw world.toLedgerRoot.source}
    (leftInstallation : SourceNativeProjectionLaw.InstallationAt
      leftComponent world.source.projectionLaw)
    (rightInstallation : SourceNativeProjectionLaw.InstallationAt
      rightComponent world.source.projectionLaw)
    (left : leftComponent.Projection)
    (right : rightComponent.Projection) :
    SourceNativeProjectionFiberAt world.source.projectionLaw
        (leftInstallation.embed left) rootOccurrence.occurrence ×
      SourceNativeProjectionFiberAt world.source.projectionLaw
        (rightInstallation.embed right) rootOccurrence.occurrence :=
  rootOccurrence.jointFaceReadout
    (leftInstallation.embed left) (rightInstallation.embed right)

/-- The installed joint readout commutes with both source component laws at
the exact emitted occurrence. -/
theorem SourceNativeTemporalVisitGeneratedEvolutionAt.installedJointFaceReadout_heq_componentOutcomes
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {world : SourceNativeAuthoritativeRootClosure N V}
    {visit : SourceNativeTemporalVisitAt world.toLedgerRoot}
    (rootOccurrence :
      SourceNativeTemporalVisitGeneratedEvolutionAt world.toLedgerRoot visit)
    {leftComponent rightComponent :
      SourceNativeProjectionLaw world.toLedgerRoot.source}
    (leftInstallation : SourceNativeProjectionLaw.InstallationAt
      leftComponent world.source.projectionLaw)
    (rightInstallation : SourceNativeProjectionLaw.InstallationAt
      rightComponent world.source.projectionLaw)
    (left : leftComponent.Projection)
    (right : rightComponent.Projection) :
    HEq
        (rootOccurrence.installedJointFaceReadout
          leftInstallation rightInstallation left right).1
        (leftComponent.outcomeAt left (world.emitted visit.current)) ∧
      HEq
        (rootOccurrence.installedJointFaceReadout
          leftInstallation rightInstallation left right).2
        (rightComponent.outcomeAt right (world.emitted visit.current)) := by
  constructor
  · exact
      (rootOccurrence.projectionOutcome_heq_sourceOutcome
        (leftInstallation.embed left)).trans
        (leftInstallation.outcome_heq (world.emitted visit.current) left)
  · exact
      (rootOccurrence.projectionOutcome_heq_sourceOutcome
        (rightInstallation.embed right)).trans
        (rightInstallation.outcome_heq (world.emitted visit.current) right)

/-- Two installed subsystem outcomes, their temporal root occurrence, and
the source-generated living successor factor through one compiler image. -/
theorem SourceNativeLivingRootCausalEvolutionAt.installedJointSubsystemAuthority_factorizes
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {current : SourceNativeLivingRootCausalCurrentAt root}
    (evolution : SourceNativeLivingRootCausalEvolutionAt root current)
    {leftComponent rightComponent : SourceNativeProjectionLaw
      root.toAuthoritativeRoot.toLedgerRoot.source}
    (leftInstallation : SourceNativeProjectionLaw.InstallationAt
      leftComponent root.toAuthoritativeRoot.source.projectionLaw)
    (rightInstallation : SourceNativeProjectionLaw.InstallationAt
      rightComponent root.toAuthoritativeRoot.source.projectionLaw)
    (left : leftComponent.Projection)
    (right : rightComponent.Projection) :
    evolution.generated =
        root.toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit
          current.down ∧
      HEq
        (evolution.generated.installedJointFaceReadout
          leftInstallation rightInstallation left right).1
        (leftComponent.outcomeAt left
          (root.emitted current.down.current)) ∧
      HEq
        (evolution.generated.installedJointFaceReadout
          leftInstallation rightInstallation left right).2
        (rightComponent.outcomeAt right
          (root.emitted current.down.current)) ∧
      evolution.nextCurrent = root.generatedNextCurrentAt current.down := by
  have joint :=
    evolution.generated.installedJointFaceReadout_heq_componentOutcomes
      leftInstallation rightInstallation left right
  exact ⟨evolution.generated.eq_generated, joint.1, joint.2, evolution.next_eq⟩

/-- Two installed subsystem outcomes remain one coface readout across a
complete source-process step.

The process state fixes the common temporal occurrence before either face is
read.  Hence changing the next carrier or presenting either component through
a different domain cannot let one grounded coordinate lend authority to its
sibling. -/
theorem SourceNativeLivingProcessCausalEvolutionAt.installedJointSubsystemAuthority_factorizes
    {N : WorldRelationNetwork.{u}}
    {sourceProcess : SourceNativeLivingRootProcess N}
    {current : SourceNativeLivingProcessCausalCurrentAt sourceProcess}
    (evolution : SourceNativeLivingProcessCausalEvolutionAt
      sourceProcess current)
    {leftComponent rightComponent : SourceNativeProjectionLaw
      (sourceProcess.stateAt current.down).root.toAuthoritativeRoot.toLedgerRoot.source}
    (leftInstallation : SourceNativeProjectionLaw.InstallationAt
      leftComponent
      (sourceProcess.stateAt current.down).root.toAuthoritativeRoot.source.projectionLaw)
    (rightInstallation : SourceNativeProjectionLaw.InstallationAt
      rightComponent
      (sourceProcess.stateAt current.down).root.toAuthoritativeRoot.source.projectionLaw)
    (left : leftComponent.Projection)
    (right : rightComponent.Projection) :
    evolution.generated =
        SourceNativeLedgerRootClosure.generatedAtTemporalVisit
          (sourceProcess.stateAt current.down).root.toAuthoritativeRoot.toLedgerRoot
          (sourceProcess.stateAt current.down).visit ∧
      HEq
        (evolution.generated.installedJointFaceReadout
          leftInstallation rightInstallation left right).1
        (leftComponent.outcomeAt left
          ((sourceProcess.stateAt current.down).root.emitted
            (sourceProcess.stateAt current.down).visit.current)) ∧
      HEq
        (evolution.generated.installedJointFaceReadout
          leftInstallation rightInstallation left right).2
        (rightComponent.outcomeAt right
          ((sourceProcess.stateAt current.down).root.emitted
            (sourceProcess.stateAt current.down).visit.current)) ∧
      evolution.nextCurrent =
        sourceProcess.stateAt (sourceProcess.successor current.down) := by
  have joint :=
    evolution.generated.installedJointFaceReadout_heq_componentOutcomes
      leftInstallation rightInstallation left right
  exact ⟨evolution.generated.eq_generated, joint.1, joint.2, rfl⟩

/-- Question face, answer face, complete prior/current ledger texture, and the
next current are simultaneous readouts of one exact living-root occurrence.
The receiver retains the terminal-handoff law: an erased ledger occurrence
cannot be replayed through a sibling living source to select another next
root.  No answer space, search result, trace certificate, or successor is
accepted by this interface. -/
def SourceNativeLivingRootCausalEvolutionAt.inquiryAnswerAndNext
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {current : SourceNativeLivingRootCausalCurrentAt root}
    (evolution : SourceNativeLivingRootCausalEvolutionAt root current)
    (question answer : root.toAuthoritativeRoot.source.projectionLaw.Projection) :
    ((SourceNativeProjectionFiberAt
          root.toAuthoritativeRoot.source.projectionLaw
          question evolution.generated.occurrence ×
        SourceNativeProjectionFiberAt
          root.toAuthoritativeRoot.source.projectionLaw
          answer evolution.generated.occurrence) ×
      SourceNativeTemporalPriorPatchTrace
        root.toAuthoritativeRoot.toLedgerRoot ×
      SourceNativeLedgerEvolutionAt
        root.toAuthoritativeRoot.toLedgerRoot.source.source
        evolution.generated.occurrence) ×
      SourceNativeAuthoritativeRootCurrentAt N :=
  ⟨⟨evolution.generated.jointFaceReadout question answer,
      evolution.generated.priorPatches,
      evolution.generated.wholeLedgerWriteBack⟩,
    evolution.nextCurrent⟩

/-- Root read is identity on the complete temporal occurrence.  It reads only
what has actually been generated; it contains no future oracle. -/
def rootCofaceRead
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    (occurrence : ExactTemporalCausalRootEvent root) :
    ExactTemporalCausalRootEvent root :=
  occurrence

/-- The unquotiented root coface is consumer-safe for every consumer.  Any
consumer distinction hidden by a lower-dimensional observation therefore
remains an ordinary addressable distinction at the root. -/
theorem rootCofaceRead_consumerSafe
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    {Disposition : Type u}
    (consumer : ExactTemporalCausalRootEvent root -> Disposition) :
    ConsumerSafe (@rootCofaceRead _ _ root) consumer := by
  intro left right sameRoot
  exact congrArg consumer sameRoot

/-- A hidden-NULL witness cannot live at the full root coface.  Hiddenness is
necessarily relative to a proper observer restriction. -/
theorem no_hiddenNull_at_rootCofaceRead
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    {Disposition : Type u}
    (consumer : ExactTemporalCausalRootEvent root -> Disposition) :
    IsEmpty (HiddenNullWitness (@rootCofaceRead _ _ root) consumer) :=
  ⟨fun hidden =>
    hidden.not_consumerSafe (rootCofaceRead_consumerSafe consumer)⟩

