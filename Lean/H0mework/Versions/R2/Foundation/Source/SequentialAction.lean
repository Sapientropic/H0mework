import H0mework.Versions.R2.Foundation.Inquiry.MinimalCoface
import H0mework.Versions.R2.Foundation.Authority.EntryDisposition
import H0mework.Foundation.Semantics.TheoryEvolution

/-!
# Source-generated sequential actual actions

This kernel is the cross-root seam used after an already generated living
occurrence needs a new representation without claiming a U7/U8 failure.
The target is recomputed from the exact source event by one fixed program.
Its initial ledger is a conservative, injective, no-fresh ingress of the
source ledger; any genuinely new row must therefore be generated by the
target root's first whole-ledger write.

The generated action token has no target, root, current, ledger, or next
field.  Those values remain dependent readouts of `program.targetAt`.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace RootInquiryCompletion

noncomputable section

universe u

/-- Cross-root target generated from one exact source occurrence.

`initialOpenLedger` is both a retract and surjective, so the target initial
ledger contains exactly the conservatively translated source rows.  The
first generated successor is the only place where the target root may create
an action-specific row. -/
structure SourceNativeSequentialActualActionTargetAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (sourceRoot : SourceNativeLivingRootClosure N V)
    (sourceVisit : SourceNativeTemporalVisitAt
      sourceRoot.toAuthoritativeRoot.toLedgerRoot)
    (sourceEvent : ExactTemporalCausalRootEventAt
      sourceRoot.toAuthoritativeRoot.toLedgerRoot sourceVisit)
    (sourceEntry : OpenResponsibilityAt N
      (sourceRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (sourceRoot.emitted sourceVisit.current)))
    (_sourceAuthority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      sourceRoot sourceVisit sourceEntry) : Type (u + 9) where
  TargetN : WorldRelationNetwork.{u}
  translation : TypedSemanticWorldNetworkTranslationAt N TargetN
  TargetV : Vocabulary.{u}
  targetRoot : SourceNativeLivingRootClosure TargetN TargetV
  targetTheory : TheoryState TargetN
  lawSurface_heq : HEq targetRoot.source.base.lawSurface
    targetTheory
  targetTheory_rootSemantic : ConservativeTheoryTranslation targetTheory
    (TheoryState.rootSemantic TargetN)
  occurrencePresentation : ConstructivePresentation
    (sourceRoot.toAuthoritativeRoot.toRoot.actual.OccurrenceAt
      sourceVisit.current)
    (targetRoot.toAuthoritativeRoot.toRoot.actual.OccurrenceAt
      targetRoot.toAuthoritativeRoot.toRoot.source.initial)
  occurrence_commutes :
    occurrencePresentation.forward sourceEvent.occurrence =
      targetRoot.emitted targetRoot.toAuthoritativeRoot.toRoot.source.initial
  initialSupport_heq : HEq
    (targetRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
      (targetRoot.emitted targetRoot.toAuthoritativeRoot.toRoot.source.initial))
    (translation.support.forward
      (sourceRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (sourceRoot.emitted sourceVisit.current)))
  initialOpenLedger : ConstructiveRetract
    (OpenResponsibilityAt N
      (sourceRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (sourceRoot.emitted sourceVisit.current)))
    (OpenResponsibilityAt TargetN
      (targetRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (targetRoot.emitted targetRoot.toAuthoritativeRoot.toRoot.source.initial)))
  initialOpenLedger_heq : HEq initialOpenLedger
    (translation.oldOpenLedger
      (sourceRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (sourceRoot.emitted sourceVisit.current)))
  initialLedger_responsibility_commutes :
    (entry : OpenResponsibilityAt N
      (sourceRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (sourceRoot.emitted sourceVisit.current))) →
      translation.responsibility.forward entry.1 =
        (initialOpenLedger.forward entry).1
  initialLedger_claim_commutes :
    (entry : OpenResponsibilityAt N
      (sourceRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (sourceRoot.emitted sourceVisit.current))) →
      translation.claim.forward entry.claim =
        (initialOpenLedger.forward entry).claim
  initialLedger_budget_conservative :
    (entry : OpenResponsibilityAt N
      (sourceRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (sourceRoot.emitted sourceVisit.current))) →
      (initialOpenLedger.forward entry).progressBudget ≤ entry.progressBudget
  initialLedgerNoFresh :
    (targetEntry : OpenResponsibilityAt TargetN
      (targetRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (targetRoot.emitted targetRoot.toAuthoritativeRoot.toRoot.source.initial))) →
      Nonempty (Sigma fun oldEntry : OpenResponsibilityAt N
        (sourceRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
          (sourceRoot.emitted sourceVisit.current)) =>
        PLift (initialOpenLedger.forward oldEntry = targetEntry))
  translatedSourceEntryRow :
    (targetRoot.toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit
      (.finite targetRoot.toAuthoritativeRoot.toRoot.initialVisit))
      |>.GeneratedEntryRowAt (initialOpenLedger.forward sourceEntry)
  firstSuccessor : SourceNativeLedgerGeneratedSuccessorAt
    (targetRoot.toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit
      (.finite targetRoot.toAuthoritativeRoot.toRoot.initialVisit)).occurrence
    (targetRoot.toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit
      (.finite targetRoot.toAuthoritativeRoot.toRoot.initialVisit)).wholeLedgerWriteBack
  canonical_targetNextVisit_eq :
    let targetEntry := initialOpenLedger.forward sourceEntry
    let targetAuthority :=
      SourceNativeLivingTemporalCausalEntryAuthorityAt.generatedFromInitialRow
        targetRoot targetEntry translatedSourceEntryRow
    let targetAnswerAndNext :=
      targetRoot.generatedCausalEntryAnswerAndNextAt
        (.finite targetRoot.toAuthoritativeRoot.toRoot.initialVisit)
        targetEntry targetAuthority
    targetAnswerAndNext.nextCurrent =
      ⟨TargetV, targetRoot.toAuthoritativeRoot,
        (SourceNativeTemporalVisitAt.finite
          targetRoot.toAuthoritativeRoot.toRoot.initialVisit).next
          firstSuccessor.next_eq⟩
  Answer : Type u
  answer : Answer
  Receipt : Answer → Type (u + 3)
  receipt : Receipt answer

namespace SourceNativeSequentialActualActionTargetAt

variable
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {sourceRoot : SourceNativeLivingRootClosure N V}
    {sourceVisit : SourceNativeTemporalVisitAt
      sourceRoot.toAuthoritativeRoot.toLedgerRoot}
    {sourceEvent : ExactTemporalCausalRootEventAt
      sourceRoot.toAuthoritativeRoot.toLedgerRoot sourceVisit}
    {sourceEntry : OpenResponsibilityAt N
      (sourceRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (sourceRoot.emitted sourceVisit.current))}
    {sourceAuthority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      sourceRoot sourceVisit sourceEntry}

def targetInitialVisit
    (target : SourceNativeSequentialActualActionTargetAt
      sourceRoot sourceVisit sourceEvent sourceEntry sourceAuthority) :
    SourceNativeTemporalVisitAt target.targetRoot.toAuthoritativeRoot.toLedgerRoot :=
  .finite target.targetRoot.toAuthoritativeRoot.toRoot.initialVisit

def translatedSourceEntry
    (target : SourceNativeSequentialActualActionTargetAt
      sourceRoot sourceVisit sourceEvent sourceEntry sourceAuthority) :
    OpenResponsibilityAt target.TargetN
      (target.targetRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (target.targetRoot.emitted
          target.targetRoot.toAuthoritativeRoot.toRoot.source.initial)) :=
  target.initialOpenLedger.forward sourceEntry

theorem initialOpenLedger_injective
    (target : SourceNativeSequentialActualActionTargetAt
      sourceRoot sourceVisit sourceEvent sourceEntry sourceAuthority) :
    Function.Injective target.initialOpenLedger.forward := by
  intro left right equality
  have backwardEquality := congrArg target.initialOpenLedger.backward equality
  simpa only [target.initialOpenLedger.backward_forward] using backwardEquality

def initialAuthority
    (target : SourceNativeSequentialActualActionTargetAt
      sourceRoot sourceVisit sourceEvent sourceEntry sourceAuthority) :
    SourceNativeLivingTemporalCausalEntryAuthorityAt target.targetRoot
      target.targetInitialVisit target.translatedSourceEntry :=
  SourceNativeLivingTemporalCausalEntryAuthorityAt.generatedFromInitialRow
    target.targetRoot target.translatedSourceEntry
      target.translatedSourceEntryRow

def targetAnswerAndNext
    (target : SourceNativeSequentialActualActionTargetAt
      sourceRoot sourceVisit sourceEvent sourceEntry sourceAuthority) :
    SourceNativeLivingCausalEntryAnswerAndNextAt target.targetRoot
      target.targetInitialVisit target.translatedSourceEntry
        target.initialAuthority :=
  target.targetRoot.generatedCausalEntryAnswerAndNextAt
    target.targetInitialVisit target.translatedSourceEntry
      target.initialAuthority

def targetVisit
    (target : SourceNativeSequentialActualActionTargetAt
      sourceRoot sourceVisit sourceEvent sourceEntry sourceAuthority) :
    SourceNativeTemporalVisitAt target.targetRoot.toAuthoritativeRoot.toLedgerRoot :=
  target.targetInitialVisit.next target.firstSuccessor.next_eq

def targetEntry
    (target : SourceNativeSequentialActualActionTargetAt
      sourceRoot sourceVisit sourceEvent sourceEntry sourceAuthority) :
    OpenResponsibilityAt target.TargetN
      (target.targetRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (target.targetRoot.emitted target.firstSuccessor.targetCurrent)) :=
  target.targetRoot.toAuthoritativeRoot.toLedgerRoot.canonicalTargetEntryAtNext
    target.firstSuccessor.next_eq target.translatedSourceEntry

def targetAuthority
    (target : SourceNativeSequentialActualActionTargetAt
      sourceRoot sourceVisit sourceEvent sourceEntry sourceAuthority) :
    SourceNativeLivingTemporalCausalEntryAuthorityAt target.targetRoot
      target.targetVisit target.targetEntry :=
  target.initialAuthority.next target.firstSuccessor.next_eq

theorem targetAnswerAndNext_next_eq
    (target : SourceNativeSequentialActualActionTargetAt
      sourceRoot sourceVisit sourceEvent sourceEntry sourceAuthority) :
    target.targetAnswerAndNext.nextCurrent =
      ⟨target.TargetV, target.targetRoot.toAuthoritativeRoot,
        target.targetVisit⟩ :=
  target.canonical_targetNextVisit_eq

end SourceNativeSequentialActualActionTargetAt

/-- Fixed target compiler for one sequential action.  The only input is the
already registered exact source occurrence. -/
structure SourceNativeSequentialActualActionProgramAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (sourceRoot : SourceNativeLivingRootClosure N V)
    (sourceVisit : SourceNativeTemporalVisitAt
      sourceRoot.toAuthoritativeRoot.toLedgerRoot)
    (sourceEntry : OpenResponsibilityAt N
      (sourceRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (sourceRoot.emitted sourceVisit.current)))
    (_sourceAuthority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      sourceRoot sourceVisit sourceEntry) : Type (u + 10) where
  targetAt : (sourceEvent : ExactTemporalCausalRootEventAt
      sourceRoot.toAuthoritativeRoot.toLedgerRoot sourceVisit) →
    SourceNativeSequentialActualActionTargetAt
      sourceRoot sourceVisit sourceEvent sourceEntry _sourceAuthority

/-- Zero-field execution seal.  It contains no target or next. -/
structure SourceGeneratedSequentialActualActionAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {sourceRoot : SourceNativeLivingRootClosure N V}
    {sourceVisit : SourceNativeTemporalVisitAt
      sourceRoot.toAuthoritativeRoot.toLedgerRoot}
    {sourceEntry : OpenResponsibilityAt N
      (sourceRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (sourceRoot.emitted sourceVisit.current))}
    {sourceAuthority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      sourceRoot sourceVisit sourceEntry}
    (program : SourceNativeSequentialActualActionProgramAt
      sourceRoot sourceVisit sourceEntry sourceAuthority)
    (sourceEvent : ExactTemporalCausalRootEventAt
      sourceRoot.toAuthoritativeRoot.toLedgerRoot sourceVisit) : Type (u + 10) where
  private mk ::

namespace SourceNativeSequentialActualActionProgramAt

def generate
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {sourceRoot : SourceNativeLivingRootClosure N V}
    {sourceVisit : SourceNativeTemporalVisitAt
      sourceRoot.toAuthoritativeRoot.toLedgerRoot}
    {sourceEntry : OpenResponsibilityAt N
      (sourceRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (sourceRoot.emitted sourceVisit.current))}
    {sourceAuthority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      sourceRoot sourceVisit sourceEntry}
    (program : SourceNativeSequentialActualActionProgramAt
      sourceRoot sourceVisit sourceEntry sourceAuthority)
    (sourceEvent : ExactTemporalCausalRootEventAt
      sourceRoot.toAuthoritativeRoot.toLedgerRoot sourceVisit) :
    SourceGeneratedSequentialActualActionAt program sourceEvent :=
  .mk

end SourceNativeSequentialActualActionProgramAt

namespace SourceGeneratedSequentialActualActionAt

def target
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {sourceRoot : SourceNativeLivingRootClosure N V}
    {sourceVisit : SourceNativeTemporalVisitAt
      sourceRoot.toAuthoritativeRoot.toLedgerRoot}
    {sourceEntry : OpenResponsibilityAt N
      (sourceRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (sourceRoot.emitted sourceVisit.current))}
    {sourceAuthority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      sourceRoot sourceVisit sourceEntry}
    {program : SourceNativeSequentialActualActionProgramAt
      sourceRoot sourceVisit sourceEntry sourceAuthority}
    {sourceEvent : ExactTemporalCausalRootEventAt
      sourceRoot.toAuthoritativeRoot.toLedgerRoot sourceVisit}
    (_generated : SourceGeneratedSequentialActualActionAt program sourceEvent) :
    SourceNativeSequentialActualActionTargetAt
      sourceRoot sourceVisit sourceEvent sourceEntry sourceAuthority :=
  program.targetAt sourceEvent

def answer
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {sourceRoot : SourceNativeLivingRootClosure N V}
    {sourceVisit : SourceNativeTemporalVisitAt
      sourceRoot.toAuthoritativeRoot.toLedgerRoot}
    {sourceEntry : OpenResponsibilityAt N
      (sourceRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (sourceRoot.emitted sourceVisit.current))}
    {sourceAuthority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      sourceRoot sourceVisit sourceEntry}
    {program : SourceNativeSequentialActualActionProgramAt
      sourceRoot sourceVisit sourceEntry sourceAuthority}
    {sourceEvent : ExactTemporalCausalRootEventAt
      sourceRoot.toAuthoritativeRoot.toLedgerRoot sourceVisit}
    (generated : SourceGeneratedSequentialActualActionAt
      program sourceEvent) :
    generated.target.Answer :=
  generated.target.answer

def receipt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {sourceRoot : SourceNativeLivingRootClosure N V}
    {sourceVisit : SourceNativeTemporalVisitAt
      sourceRoot.toAuthoritativeRoot.toLedgerRoot}
    {sourceEntry : OpenResponsibilityAt N
      (sourceRoot.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (sourceRoot.emitted sourceVisit.current))}
    {sourceAuthority : SourceNativeLivingTemporalCausalEntryAuthorityAt
      sourceRoot sourceVisit sourceEntry}
    {program : SourceNativeSequentialActualActionProgramAt
      sourceRoot sourceVisit sourceEntry sourceAuthority}
    {sourceEvent : ExactTemporalCausalRootEventAt
      sourceRoot.toAuthoritativeRoot.toLedgerRoot sourceVisit}
    (generated : SourceGeneratedSequentialActualActionAt
      program sourceEvent) :
    generated.target.Receipt generated.answer :=
  generated.target.receipt

end SourceGeneratedSequentialActualActionAt

end
end RootInquiryCompletion
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid

#print axioms SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot.RootInquiryCompletion.SourceNativeSequentialActualActionTargetAt.initialOpenLedger_injective
#print axioms SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot.RootInquiryCompletion.SourceNativeSequentialActualActionTargetAt.targetAnswerAndNext_next_eq
