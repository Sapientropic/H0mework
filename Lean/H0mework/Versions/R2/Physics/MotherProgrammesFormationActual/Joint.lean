import H0mework.Versions.R2.Physics.MotherProgrammesFormationActual.History
import H0mework.Realization.JointState.ActionOccurrence

set_option autoImplicit false
set_option synthInstance.maxSize 4096

namespace SaturationMonoid.PhysicsCore.Stage10.SourceUniqueness.ActualFormation

open ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
open SourceGeneratedIntegralCoherentJointAction
open Stage9C.Revision StageNineHolonomicField
open ProofFreeRicherAnholonomicSource DiracExteriorMatterAction

noncomputable section

abbrev IntegralCarrier := Generator →₀ ℤ
abbrev MatterField := BasePoint → DiracExteriorMatterCarrier

def event (generator : Generator) : IntegralCarrier := Finsupp.single generator 1

def nativeAction : IntegralCarrier →ₗ[ℤ] IntegralCarrier :=
  Finsupp.lmapDomain ℤ ℤ nextGenerator

def fieldRead : IntegralCarrier →ₗ[ℤ] ActualCoordinates :=
  Finsupp.linearCombination ℤ (fun generator => actualCoordinates generator.2)

def matterRead : IntegralCarrier →ₗ[ℤ] MatterField :=
  Finsupp.linearCombination ℤ (fun generator => (Recognition.wholeField generator.2).matter)

/-- The integral action is the actual writer. Matter is a retained native
field; full-field measurement uses the same passive coordinate frame. Its
change is generated as incidence, rather than assumed to vanish. -/
def jointInput : Input IntegralCarrier MatterField ActualCoordinates where
  integralAction := nativeAction
  coherentAction := LinearMap.id
  measurementAction := LinearMap.id
  coherentRead := matterRead
  measurementRead := fieldRead

theorem nativeAction_event (generator : Generator) :
    nativeAction (event generator) = event (nextGenerator generator) := by
  simp [nativeAction, event]

theorem fieldRead_event (generator : Generator) :
    fieldRead (event generator) = actualCoordinates generator.2 := by
  simp [fieldRead, event]

theorem matterRead_event (generator : Generator) :
    matterRead (event generator) = (Recognition.wholeField generator.2).matter := by
  simp [matterRead, event]

def jointEvent (generator : Generator) : jointInput.Carrier :=
  jointInput.seedLift (event generator)

theorem complete_field_read (generator : Generator) :
    wholeCoordinates.symm (jointInput.measurementFace (jointEvent generator)).1 =
      Recognition.wholeField generator.2 := by
  change wholeCoordinates.symm (fieldRead (event generator)).1 = _
  rw [fieldRead_event]
  exact wholeCoordinates.symm_apply_apply _

/-- Actual next is generated by the same common action and its retained
incidence. No zero verdict or target state is supplied. -/
theorem actual_joint_next (generator : Generator) :
    jointEvent (nextGenerator generator) = jointInput.omega (jointEvent generator) -
      jointInput.incidenceResidual (event generator) := by
  exact ((sub_sub_cancel (jointInput.omega (jointEvent generator))
    (jointInput.seedLift (nativeAction (event generator)))).trans
      (congrArg jointInput.seedLift (nativeAction_event generator))).symm

theorem incidence_full_read (generator : Generator) :
    jointInput.measurementFace (jointInput.incidenceResidual (event generator)) =
      actualCoordinates generator.2 - actualCoordinates (SpinPair.next generator.2) := by
  rw [Input.incidenceResidual_measurementFace]
  change fieldRead (event generator) - fieldRead (nativeAction (event generator)) = _
  rw [nativeAction_event, fieldRead_event, fieldRead_event]
  rfl

theorem retained_matter (step : ℕ) (state : MaterialState) :
    jointInput.coherentFace (jointInput.incidenceResidual (event (step, .running state))) = 0 := by
  rw [Input.incidenceResidual_coherentFace]
  change matterRead (event (step, .running state)) -
    matterRead (nativeAction (event (step, .running state))) = 0
  rw [nativeAction_event, matterRead_event, matterRead_event]
  change (Recognition.wholeField (.running state)).matter -
    (Recognition.wholeField (SpinPair.next (.running state))).matter = 0
  exact sub_self _

/-- The fixed mother material generates a real direction of the common
carrier. The full gravity change is not killed by event linearization. -/
theorem source_incidence_gravity :
    (jointInput.measurementFace (jointInput.incidenceResidual
      (event (0, .running ClockBFFeedback.sourcePrepared)))).1.2.2.1 0 3 0 =
      Stage9C.Material.SpinPair.lapse / 2 := by
  rw [incidence_full_read]
  change Stage10.Runtime.configuration.gravityAuxiliary 0 3 0 -
    (ClockBFFeedback.nextField ClockBFFeedback.sourceClockSeed
      ClockBFFeedback.sourceClockSeed_domain).gravityAuxiliary 0 3 0 = _
  rw [ClockBFFeedback.original_gravity_component, ClockBFFeedback.next_gravity_component,
    ClockBFFeedback.sourceClockSeed_value]
  ring

end
end SaturationMonoid.PhysicsCore.Stage10.SourceUniqueness.ActualFormation
