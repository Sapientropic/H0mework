import H0mework.Versions.R2.Physics.MotherProgrammesFormation.Declarations.Cumulative.LivingInquiryAlignment.AnswerClause
import H0mework.Versions.R2.Physics.MotherProgrammesFormation.Declarations.Cumulative.ArenaFormation.Coverage

set_option autoImplicit false
namespace SaturationMonoid.PhysicsCore.Stage10.SourceUniqueness.MotherInquiryAnswerClause
open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot RootInquiryCompletion
open scoped Classical
noncomputable section

variable {rank : Ordinal.{0}} {N : WorldRelationNetwork.{0}} {V : ConstructiveRoot.Vocabulary.{0}}
    (root : SourceNativeLivingRootClosure N V)
    (visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot)
    {U7 : U7ProducerCalculus N} (calculus : U7ObstructionEvolutionCalculus N U7)
    (Query : Type) (index : Query ↪ MotherArenaHigher.Base rank)
    (operand : Operand root visit ↪ MotherArenaHigher.Base rank)

/-- A mother-material graph reads only the small source-constructor operands.
Every complete clause is then generated by the original authority, face and
compilation mouths. No completed clause section enters this factory. -/
def formClauses (material : MotherArenaHigher.Material rank) :
    Option ((query : Query) → MotherNativeClause.Clause root visit U7 calculus query) :=
  (MotherArenaReceipts.NativeSection.form index (fun _ => operand) material).bind (fun inputs =>
    if complete : ∀ query, (form calculus query (inputs query)).isSome then
      some (fun query => (form calculus query (inputs query)).get (complete query))
    else none)

def formInquiry (material : MotherArenaHigher.Material rank) : Option (RootInquiryStateAt N V) :=
  (formClauses root visit calculus Query index operand material).map MotherNativeClause.assemble

theorem answering_section_at_rank (clauses : (query : Query) → MotherNativeClause.Clause root visit U7 calculus query)
    (answering : ∀ query, Answering calculus query (clauses query).program.generate.output) :
    ∃ material : MotherArenaHigher.Material rank,
      formClauses root visit calculus Query index operand material = some clauses ∧
      formInquiry root visit calculus Query index operand material = some (MotherNativeClause.assemble clauses) := by
  have allInputs := fun query => every_answering_clause calculus query (clauses query) (answering query)
  choose inputs inputFormed using allInputs
  obtain ⟨material, selected⟩ := MotherArenaReceipts.NativeSection.every_section index (fun _ => operand) inputs
  have complete : ∀ query, (form calculus query (inputs query)).isSome := by
    intro query
    rw [inputFormed]
    rfl
  have formed : formClauses root visit calculus Query index operand material = some clauses := by
    simp only [formClauses, selected, Option.bind_some, dif_pos complete]
    apply congrArg some
    funext query
    exact Option.some.inj ((Option.some_get (complete query)).trans (inputFormed query))
  exact ⟨material, formed, by simp only [formInquiry, formed, Option.map_some]⟩

/-- A sufficient rank is chosen internally from the actual small operands.
This is coverage of all three answering branches, with complete original
programs/faces/U7 dispositions, not a restriction on the final reality law. -/
theorem every_answering_section
    (clauses : (query : Query) → MotherNativeClause.Clause root visit U7 calculus query)
    (answering : ∀ query, Answering calculus query (clauses query).program.generate.output) :
    ∃ rank : Ordinal.{0}, ∃ material : MotherArenaHigher.Material rank,
      ∃ queryAddress : Query ↪ MotherArenaHigher.Base rank,
      ∃ operandAddress : Operand root visit ↪ MotherArenaHigher.Base rank,
        formClauses root visit calculus Query queryAddress operandAddress material = some clauses ∧
        formInquiry root visit calculus Query queryAddress operandAddress material = some (MotherNativeClause.assemble clauses) := by
  let total := Query ⊕ Operand root visit
  let rank := MotherArenaHigher.carrierRank total
  let shared := MotherArenaHigher.carrierAddress total
  let queryAddress : Query ↪ MotherArenaHigher.Base rank :=
    ⟨fun value => shared (.inl value), fun _ _ same => Sum.inl.inj (shared.injective same)⟩
  let operandAddress : Operand root visit ↪ MotherArenaHigher.Base rank :=
    ⟨fun value => shared (.inr value), fun _ _ same => Sum.inr.inj (shared.injective same)⟩
  obtain ⟨material, clausesFormed, stateFormed⟩ :=
    answering_section_at_rank root visit calculus Query queryAddress operandAddress clauses answering
  exact ⟨rank, material, queryAddress, operandAddress, clausesFormed, stateFormed⟩

theorem every_answering_inquiry (state : RootInquiryStateAt N V)
    (answering : ∀ query, Answering state.calculus query (state.compileInquiry query)) :
    ∃ rank : Ordinal.{0}, ∃ material : MotherArenaHigher.Material rank,
      ∃ queryAddress : state.Query ↪ MotherArenaHigher.Base rank,
      ∃ operandAddress : Operand state.root state.visit ↪ MotherArenaHigher.Base rank,
        formInquiry state.root state.visit state.calculus state.Query queryAddress operandAddress material = some state := by
  obtain ⟨rank, material, queryAddress, operandAddress, _, formed⟩ :=
    every_answering_section state.root state.visit state.calculus state.Query (MotherNativeClause.ofState state) answering
  exact ⟨rank, material, queryAddress, operandAddress,
    formed.trans (congrArg some (MotherNativeClause.assemble_ofState state))⟩

end
end SaturationMonoid.PhysicsCore.Stage10.SourceUniqueness.MotherInquiryAnswerClause
