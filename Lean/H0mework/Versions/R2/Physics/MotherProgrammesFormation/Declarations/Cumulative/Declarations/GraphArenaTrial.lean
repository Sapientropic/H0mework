import H0mework.Versions.R2.Physics.MotherProgrammesFormation.Declarations.HigherLaw.Family
import H0mework.Physics.MotherProgrammesFormation.Declarations.SmallSupport.Collection
import Mathlib.Topology.UniformSpace.Equiv

/-!
A source-only parent arena. Its scope is the graph family generated by the
existing materials, not universal coverage of original processes. B and M below are the actual existing physical/higher-law carriers.
The only public graph input is M x B. W occurs as a semantic output/observation
domain, never as a raw atom argument. Good is produced by the internal check.

The successful-address carrier is formed BEFORE collapse is evaluated.
Shrink is used ONLY AFTER an explicit source programme surjects onto Raw.
-/

set_option autoImplicit false
set_option maxHeartbeats 2000000

namespace SaturationMonoid.PhysicsCore.Stage10.SourceUniqueness.MotherGraphArenaTrial

open UniformSpace
open scoped Classical Topology
noncomputable section

abbrev B := MotherHigherLawFormation.Base
abbrev M := MotherHigherLawFormation.Formed
abbrev W := ZFSet.{0}

-- a is a construction-parent of b, not a physical predecessor/event.
def edge (m : M) (a b : B) : Prop :=
  MotherHigherLawFormation.read m (MotherHigherLawFamily.pair (b, a)) 0 = 0

-- R appears only in this coverage theorem, not in the graph factory.
theorem every_edge (R : B → B → Prop) :
    ∃ m : M, edge m = R := by
  obtain ⟨m, hm⟩ := MotherHigherLawFormation.read_surjective
    (fun z _ => if R (MotherHigherLawFamily.unpair z).2
      (MotherHigherLawFamily.unpair z).1 then 0 else 1)
  refine ⟨m, ?_⟩
  funext a b
  apply propext
  by_cases h : R a b <;>
    simp [edge, hm, MotherHigherLawFamily.unpair_pair, h]

abbrev Good := {m : M // WellFounded (edge m)}

def prepare (m : M) : Option Good :=
  if h : WellFounded (edge m) then some ⟨m, h⟩ else none

theorem prepare_recovers (g : Good) : prepare g.val = some g := by
  simp only [prepare, dif_pos g.property]

def Pred (g : Good) (b : B) : Type := {a : B // edge g.val a b}

-- Ordinary well-founded recursion, with no nested recursive Small operand.
-- Both its arity and its relation were determined by the already formed m.
def collapse (g : Good) : B → W :=
  g.property.fix (fun b rec =>
    ZFSet.range (fun a : Pred g b => rec a.val a.property))

theorem collapse_eq (g : Good) (b : B) :
    collapse g b = ZFSet.range (fun a : Pred g b => collapse g a.val) := by
  exact WellFounded.fix_eq g.property
    (fun b rec => ZFSet.range (fun a : Pred g b => rec a.val a.property)) b

theorem mem_collapse (g : Good) (b : B) (x : W) :
    x ∈ collapse g b ↔ ∃ a : Pred g b, collapse g a.val = x := by
  rw [collapse_eq]
  exact ZFSet.mem_range

-- The entire parent-address carrier, not the image of a target's members.
abbrev Key := Good × B
abbrev SourceKey := M × B

def formKey (input : SourceKey) : Option Key :=
  (prepare input.1).map (fun g => (g, input.2))

def sourceKey (key : Key) : SourceKey := (key.1.val, key.2)

theorem formKey_recovers (key : Key) : formKey (sourceKey key) = some key := by
  simp only [formKey, sourceKey, prepare_recovers, Option.map_some]

-- Retain this Key; do not identify different source graphs by their collapse.
def value (key : Key) : W := collapse key.1 key.2

def childAt (g : Good) (b : B) (a : Pred g b) : Key := (g, a.val)

theorem children_exact (g : Good) (b : B) (x : W) :
    x ∈ value (g, b) ↔ ∃ a : Pred g b, value (childAt g b a) = x :=
  mem_collapse g b x

abbrev Packet := List Key

def formPacket : List SourceKey → Option Packet
  | [] => some []
  | x :: xs => (formKey x).bind fun k =>
      (formPacket xs).map fun ks => k :: ks

theorem formPacket_recovers (packet : Packet) :
    formPacket (packet.map sourceKey) = some packet := by
  induction packet with
  | nil => rfl
  | cons key packet ih =>
      simp only [List.map_cons, formPacket, formKey_recovers,
        Option.bind_some, ih, Option.map_some]

def parents : Set W := Set.range value

def packetSupport (packet : Packet) : Finset W :=
  (packet.map value).toFinset

def packetRead (packet : Packet) : W → ℝ :=
  MotherSmallSupport.finiteProfile (packetSupport packet)

theorem packetSupport_parents (packet : Packet) :
    (↑(packetSupport packet) : Set W) ⊆ parents := by
  intro x hx
  obtain ⟨key, _, same⟩ := List.mem_map.mp (List.mem_toFinset.mp hx)
  exact ⟨key, same⟩

abbrev Raw := Set.range packetRead

def fromPacket (packet : Packet) : Raw := ⟨packetRead packet, packet, rfl⟩

theorem fromPacket_surjective : Function.Surjective fromPacket := by
  rintro ⟨f, packet, same⟩
  exact ⟨packet, Subtype.ext same⟩

-- Carrier smallness comes from the actual programme carrier just constructed.
instance raw_small : Small.{0} Raw := small_of_surjective fromPacket_surjective

-- This theorem is only the bridge to the existing relative support mechanism.
-- The new provenance work is prepare/Pred/collapse/Key/formPacket above.
def toRelativeRaw (raw : Raw) : MotherSmallSupport.Raw parents :=
  ⟨raw.val, by
    obtain ⟨packet, same⟩ := raw.property
    exact ⟨packetSupport packet, packetSupport_parents packet, same⟩⟩

theorem every_relative_raw (raw : MotherSmallSupport.Raw parents) :
    ∃ packet : Packet, packetRead packet = raw.val := by
  obtain ⟨support, supported, same⟩ := raw.property
  let address (x : support) : Key := Classical.choose (supported x.property)
  have address_value (x : support) : value (address x) = x.val :=
    Classical.choose_spec (supported x.property)
  let packet := support.attach.toList.map address
  have exactSupport : packetSupport packet = support := by
    ext x
    simp only [packetSupport, packet, List.map_map, List.mem_toFinset, List.mem_map,
      Finset.mem_toList, Function.comp_apply, Finset.mem_attach, true_and]
    constructor
    · rintro ⟨v, hv⟩
      rw [address_value] at hv
      exact hv ▸ v.property
    · intro hx
      exact ⟨⟨x, hx⟩, address_value ⟨x, hx⟩⟩
  exact ⟨packet, (congrArg MotherSmallSupport.finiteProfile exactSupport).trans same⟩

def rawEquiv : Raw ≃ᵤ MotherSmallSupport.Raw parents where
  toFun := toRelativeRaw
  invFun := fun raw => ⟨raw.val, every_relative_raw raw⟩
  left_inv := fun _ => Subtype.ext rfl
  right_inv := fun _ => Subtype.ext rfl
  uniformContinuous_toFun := uniformContinuous_subtype_val.subtype_mk _
  uniformContinuous_invFun := uniformContinuous_subtype_val.subtype_mk _

-- Lower the representation universe AFTER its source has been paid.
abbrev NativeRaw : Type := Shrink Raw

instance : UniformSpace NativeRaw :=
  UniformSpace.comap (equivShrink Raw).symm inferInstance

def nativeRawEquiv : NativeRaw ≃ᵤ Raw :=
  (equivShrink Raw).symm.toUniformEquivOfIsUniformInducing ⟨rfl⟩

abbrev NativeMaterial : Type := Completion NativeRaw

def completedEquiv : NativeMaterial ≃ᵤ MotherSmallSupport.Formed parents :=
  (Completion.mapEquiv nativeRawEquiv).trans (Completion.mapEquiv rawEquiv)

def restore (n : NativeMaterial) :
    MotherSmallSupport.Formed (Set.univ : Set W) :=
  MotherSmallSupport.includeCompleted (Set.subset_univ parents) (completedEquiv n)

-- The complete original material, not just its selected coordinates.
theorem source_completion_lift
    (m : MotherSmallSupport.Formed (Set.univ : Set W))
    (supported : ∀ x, MotherSmallSupport.read Set.univ m x = 1 → x ∈ parents) :
    ∃! n : NativeMaterial, restore n = m := by
  obtain ⟨localMaterial, restored, unique⟩ :=
    MotherSmallSupport.localize (Set.subset_univ parents) m supported
  refine ⟨completedEquiv.symm localMaterial, ?_, fun other same => ?_⟩
  · simpa only [restore, UniformEquiv.apply_symm_apply] using restored
  · apply completedEquiv.injective
    rw [UniformEquiv.apply_symm_apply]
    exact unique (completedEquiv other) same

-- This is the original collector with a source-derived parent domain.
def formNative (n : NativeMaterial) : Option W :=
  MotherSmallSupport.formSmall parents (completedEquiv n)

theorem every_supported_target (target : W)
    (supported : (target : Set W) ⊆ parents) :
    ∃ n : NativeMaterial, formNative n = some target := by
  obtain ⟨m, _, formed⟩ := MotherSmallSupport.every_supported_set parents target supported
  refine ⟨completedEquiv.symm m, ?_⟩
  simpa only [formNative, UniformEquiv.apply_symm_apply] using formed

-- All source graph outputs, collected before any target process is supplied.
def library : W := ZFSet.range value

theorem library_members (x : W) : x ∈ library ↔ x ∈ parents :=
  ZFSet.mem_range

theorem library_transitive {x y : W} (hx : x ∈ library) (hy : y ∈ x) :
    y ∈ library := by
  obtain ⟨key, same⟩ := (library_members x).mp hx
  rw [← same] at hy
  obtain ⟨a, ha⟩ := (mem_collapse key.1 key.2 y).mp hy
  exact (library_members y).mpr ⟨(key.1, a.val), ha⟩

theorem library_formed : ∃ n : NativeMaterial, formNative n = some library :=
  every_supported_target library (fun x hx => (library_members x).mp hx)

-- Precise stage boundary, not a global no-go: completion forms library,
-- but library itself is not a parent of the FIRST stage.
theorem library_not_parent : library ∉ parents := by
  intro h
  exact ZFSet.mem_irrefl library ((library_members library).mpr h)

theorem singleton_library_not_formed (n : NativeMaterial) :
    formNative n ≠ some ({library} : W) := by
  intro h
  have hs := MotherSmallSupport.successful_formation_uses_only_parents
    parents (completedEquiv n) ({library} : W) h
  exact library_not_parent (hs (by simp))

-- Feedback does NOT take an arbitrary W, a future Build, or a decoder.
-- The success proof is stored below only as an INTERNAL result of formNative.
-- Using a subtype of successful completed materials keeps failure semantics
-- explicit and avoids needing another global-smallness lemma in this scratch.
abbrev FormedKey := {n : NativeMaterial // ∃ x : W, formNative n = some x}

def formCompletedKey (n : NativeMaterial) : Option FormedKey :=
  if success : ∃ x : W, formNative n = some x then some ⟨n, success⟩ else none

def completedValue (key : FormedKey) : W := key.property.choose

theorem completedValue_exact (key : FormedKey) :
    formNative key.val = some (completedValue key) := key.property.choose_spec

-- Keep every old origin verbatim; completed values have a different tag.
abbrev NextKey := Key ⊕ FormedKey

def nextValue : NextKey → W
  | .inl key => value key
  | .inr key => completedValue key

theorem feedback_same_witness (n : NativeMaterial) (x : W)
    (formed : formNative n = some x) :
    ∃ key : FormedKey,
      formCompletedKey n = some key ∧ nextValue (.inr key) = x := by
  let success : ∃ y : W, formNative n = some y := ⟨x, formed⟩
  let key : FormedKey := ⟨n, success⟩
  refine ⟨key, ?_, ?_⟩
  · exact dif_pos success
  · exact Option.some.inj ((completedValue_exact key).symm.trans formed)

theorem old_origin_retained (key : Key) : nextValue (.inl key) = value key := rfl


end
end SaturationMonoid.PhysicsCore.Stage10.SourceUniqueness.MotherGraphArenaTrial
