import H0mework.Versions.R2.Physics.MotherProgrammesFormation.Declarations.Cumulative.LivingInquiryAlignment.AnswerOperands
import H0mework.Versions.R2.Physics.MotherProgrammesFormation.Declarations.NativeAuthority.Section

set_option autoImplicit false
set_option maxHeartbeats 3000000
namespace SaturationMonoid.PhysicsCore.Stage10.SourceUniqueness.MotherInquiryAnswerClause
open MotherInquiryAnswerOperands
open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot RootInquiryCompletion
open scoped Classical
noncomputable section

variable {N : WorldRelationNetwork.{0}} {V : ConstructiveRoot.Vocabulary.{0}}
    (root : SourceNativeLivingRootClosure N V)
    (visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot)

/-- A complete answering clause has only these source inventory operands.
The authority, full program and both faces are generated by original mouths. -/
structure Operand : Type where
  authoritySeed : MotherNativeAuthority.InventorySeed root
  authoritySteps : Nat
  answer : MotherInquiryAnswerOperands.Operand root visit
  compilationProjection : Projection root

variable {root visit} {U7 : U7ProducerCalculus N}
    (calculus : U7ObstructionEvolutionCalculus N U7) {Query : Type} (query : Query)
    {entry : MotherNativeAuthority.EntryAt root visit.current}
    {authority : SourceNativeLivingTemporalCausalEntryAuthorityAt root visit entry}

abbrev Compatible (compiled : Compilation query entry authority calculus) : Prop :=
  (obstruction : N.ObstructionAt (Support root visit)) →
  (audit : SourceNativeInquiryAuditAt U7 calculus (Theory root) obstruction) →
  compiled.audit = .obstructed obstruction audit →
  U7DemandEntryRootDispositionCommutesAt calculus (calculus.source.emit obstruction) entry
    ((root.toAuthoritativeRoot.toLedgerRoot.source.ledgerCompiler.compile
      (root.emitted visit.current)).entryDisposition entry)

def assemble (compiled : Compilation query entry authority calculus)
    (face : SourceNativeRootInquiryCompilationFaceCoreAt root visit query
      (InquiryEvent (root := root) (visit := visit)) entry authority compiled)
    (compatible : Compatible calculus query compiled) : MotherNativeClause.Clause root visit U7 calculus query where
  entry := entry
  authority := authority
  program := MotherNativeProgram.restore compiled
  face := face
  dispositionCompatible := compatible

private theorem clause_ext (first last : MotherNativeClause.Clause root visit U7 calculus query)
    (entrySame : first.entry = last.entry) (authoritySame : HEq first.authority last.authority)
    (programSame : HEq first.program last.program) (faceSame : HEq first.face last.face) : first = last := by
  cases first
  cases last
  cases entrySame
  cases eq_of_heq authoritySame
  cases eq_of_heq programSame
  cases eq_of_heq faceSame
  rfl

theorem assemble_recovers (clause : MotherNativeClause.Clause root visit U7 calculus query) :
    assemble calculus query clause.program.generate.output clause.face clause.dispositionCompatible = clause :=
  clause_ext calculus query _ _ rfl HEq.rfl (heq_of_eq (MotherNativeProgram.restore_generate clause.program)) HEq.rfl

def formAtAuthority (compiled : Compilation query entry authority calculus)
    (projection : Projection root) : Option (MotherNativeClause.Clause root visit U7 calculus query) :=
  (MotherNativeFaces.compilationFace compiled projection).bind (fun face =>
    if compatible : Compatible calculus query compiled then some (assemble calculus query compiled face compatible) else none)

theorem formAtAuthority_recovers (clause : MotherNativeClause.Clause root visit U7 calculus query) :
    formAtAuthority calculus query clause.program.generate.output clause.face.projection = some clause := by
  simp only [formAtAuthority, MotherNativeFaces.compilationFace_recovers, Option.bind_some,
    dif_pos clause.dispositionCompatible]
  exact congrArg some (assemble_recovers calculus query clause)

/-- No original clause is an input: entry and authority are generated from
the original inventory programme; the actual root compiler supplies faces. -/
def form (operand : Operand root visit) : Option (MotherNativeClause.Clause root visit U7 calculus query) :=
  (MotherNativeAuthority.formAtVisit root visit operand.authoritySeed operand.authoritySteps).bind (fun authority =>
    (MotherInquiryAnswerOperands.form query authority.1 authority.2 calculus operand.answer).bind (fun compiled =>
      formAtAuthority calculus query compiled operand.compilationProjection))

def Answering : Compilation query entry authority calculus → Prop
  | .answered .. => True
  | .u7Answered .. => True
  | .oldLanguageAnswered .. => True
  | .actualAction .. => False
  | .requiresU8 .. => False

theorem answering_operands (compiled : Compilation query entry authority calculus)
    (answering : Answering calculus query compiled) :
    ∃ operand : MotherInquiryAnswerOperands.Operand root visit,
      MotherInquiryAnswerOperands.form query entry authority calculus operand = some compiled := by
  cases compiled with
  | answered face consumer =>
      exact ⟨.answered face.projection consumer.projection,
        MotherInquiryAnswerOperands.answered_recovers query entry authority calculus ⟨face, consumer⟩⟩
  | u7Answered obstruction disposition face consumer =>
      exact ⟨.u7Answered obstruction face.projection consumer.projection,
        MotherInquiryAnswerOperands.u7Answered_recovers query entry authority calculus obstruction disposition ⟨face, consumer⟩⟩
  | oldLanguageAnswered obstruction gate oldAnswer face consumer =>
      exact ⟨.oldLanguageAnswered obstruction oldAnswer.expression.val oldAnswer.realization face.projection consumer.projection,
        MotherInquiryAnswerOperands.oldLanguageAnswered_recovers query entry authority calculus obstruction gate oldAnswer ⟨face, consumer⟩⟩
  | actualAction generated => cases answering
  | requiresU8 obstruction gate failure generated => cases answering

theorem every_answering_clause (clause : MotherNativeClause.Clause root visit U7 calculus query)
    (answering : Answering calculus query clause.program.generate.output) :
    ∃ operand : Operand root visit, form calculus query operand = some clause := by
  obtain ⟨seed, steps, authorityFormed⟩ := MotherNativeAuthority.every_authority_at_visit root visit
    ⟨clause.entry, clause.authority⟩
  obtain ⟨answer, answerFormed⟩ := answering_operands calculus query clause.program.generate.output answering
  refine ⟨⟨seed, steps, answer, clause.face.projection⟩, ?_⟩
  simp only [form, authorityFormed, Option.bind_some, answerFormed]
  exact formAtAuthority_recovers calculus query clause

end
end SaturationMonoid.PhysicsCore.Stage10.SourceUniqueness.MotherInquiryAnswerClause
