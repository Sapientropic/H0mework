import H0mework.Versions.R2.Physics.GaugeSpectrum.Correlation
import H0mework.Versions.R2.Physics.GaugeSpectrum.Naturality
import Mathlib.MeasureTheory.Integral.Bochner.Basic

/-! A positive two-atom spectral measure is generated by the calculated
connected kernel. Its frequencies are physical source phase frequencies;
they are not a vacuum glueball mass or a scattering resonance. -/

set_option autoImplicit false

namespace SaturationMonoid.PhysicsCore.Stage10.GaugeSpectrum

open Matrix DiracCliffordRepresentation MeasureTheory
open StageNineHolonomicField ProofFreeRicherAnholonomicSource
open Stage9C.Material.SpinPair Stage9DEF
open SU7ExteriorMatterRepresentation

noncomputable section

def spectralFrequency : ℝ := 2 * frequency
def spectralWeight : ℝ := curvatureScale ^ 2 / 2

theorem spectralFrequency_pos : 0 < spectralFrequency :=
  mul_pos (by norm_num) Dynamics.frequency_positive

theorem spectralWeight_pos : 0 < spectralWeight :=
  div_pos (sq_pos_of_pos curvatureScale_pos) (by norm_num)

def spectralMeasure : Measure ℝ := ENNReal.ofReal spectralWeight •
  (Measure.dirac spectralFrequency + Measure.dirac (-spectralFrequency))

theorem spectralMeasure_outside :
    spectralMeasure ({spectralFrequency, -spectralFrequency}ᶜ) = 0 := by
  simp [spectralMeasure]

theorem spectralMeasure_positive_atom :
    spectralMeasure {spectralFrequency} = ENNReal.ofReal spectralWeight := by
  have distinct : spectralFrequency ≠ -spectralFrequency := by linarith [spectralFrequency_pos]
  simp [spectralMeasure, Ne.symm distinct]

theorem spectralMeasure_negative_atom :
    spectralMeasure {-spectralFrequency} = ENNReal.ofReal spectralWeight := by
  have distinct : spectralFrequency ≠ -spectralFrequency := by linarith [spectralFrequency_pos]
  simp [spectralMeasure, distinct]

theorem spectralMeasure_positive_atom_nonzero : spectralMeasure {spectralFrequency} ≠ 0 := by
  rw [spectralMeasure_positive_atom]
  exact ne_of_gt (ENNReal.ofReal_pos.mpr spectralWeight_pos)

theorem spectralMeasure_negative_atom_nonzero : spectralMeasure {-spectralFrequency} ≠ 0 := by
  rw [spectralMeasure_negative_atom]
  exact ne_of_gt (ENNReal.ofReal_pos.mpr spectralWeight_pos)

theorem spectralMeasure_transform (point : BasePoint) :
    (∫ rate : ℝ, phase rate point ∂spectralMeasure) =
      (curvatureScale : ℂ) ^ 2 *
        (phase (2 * frequency) point + phase (-(2 * frequency)) point) / 2 := by
  rw [spectralMeasure, integral_smul_measure,
    integral_add_measure (integrable_dirac (by finiteness)) (integrable_dirac (by finiteness))]
  simp only [integral_dirac, ENNReal.toReal_ofReal (le_of_lt spectralWeight_pos)]
  simp only [spectralWeight, spectralFrequency, Complex.real_smul,
    Complex.ofReal_div, Complex.ofReal_pow, Complex.ofReal_ofNat]
  ring

theorem connected_eq_spectralIntegral (point first second : BasePoint) (axis : Fin 3) :
    connected point (evolvedDualCurvature point first axis)
      (evolvedDualCurvature point second axis) =
      ∫ rate : ℝ, phase rate (second - first) ∂spectralMeasure := by
  rw [temporal_connected_phase, spectralMeasure_transform]

def movedEvolvedCurvature (element : SU7MotherGroup) (point displacement : BasePoint)
    (axis : Fin 3) : State.Observable :=
  star (Dynamics.unitary displacement : State.Observable) * movedDualCurvature element point axis *
    (Dynamics.unitary displacement : State.Observable)

theorem movedEvolvedCurvature_eq (element : SU7MotherGroup) (point displacement : BasePoint)
    (axis : Fin 3) :
    movedEvolvedCurvature element point displacement axis = evolvedDualCurvature point displacement axis := by
  simp only [movedEvolvedCurvature, movedDualCurvature_eq, evolvedDualCurvature]

theorem fullGauge_connected_spectrum (element : SU7MotherGroup)
    (point first second : BasePoint) (axis : Fin 3) :
    State.vectorEvaluation
        (Source.Frame.prepare (Source.Frame.gaugeFrame element)
          (DiracExteriorMatterAction.diracExteriorMatterGaugeRepresentation element (actual.matter point)))
        (star (movedEvolvedCurvature element point first axis) *
          movedEvolvedCurvature element point second axis) =
      ∫ rate : ℝ, phase rate (second - first) ∂spectralMeasure := by
  rw [show DiracExteriorMatterAction.diracExteriorMatterGaugeRepresentation element (actual.matter point) =
      Source.Frame.gaugeFrame element (actual.matter point) by rfl,
    Source.Frame.transformed_actual_prepare, movedEvolvedCurvature_eq, movedEvolvedCurvature_eq]
  change State.evaluation point _ = _
  rw [← connected_eq_spectralIntegral point first second axis]
  simp only [connected, evolvedDualCurvature_mean, star_zero, mul_zero, sub_zero]

end
end SaturationMonoid.PhysicsCore.Stage10.GaugeSpectrum
