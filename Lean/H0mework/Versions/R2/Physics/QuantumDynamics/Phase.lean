import H0mework.Versions.R2.Physics.QuantumState.SourceCoefficients
import Mathlib.LinearAlgebra.UnitaryGroup

/-! Closed evolution of every occupied Dirac/color coordinate, generated by
the physical phases of the accepted actual. The displacement is physical
spacetime, independent of the controller's observation count. -/

set_option autoImplicit false

namespace SaturationMonoid.PhysicsCore.Stage9DEF.Dynamics

open DiracCliffordRepresentation ProofFreeRicherAnholonomicSource
open StageNineHolonomicField Stage9C.Material.SpinPair Source
open Matrix

noncomputable section

def rate (index : Index) : ℝ :=
  if index.1.val < 2 then frequency else -frequency

def phaseCoefficient (displacement : BasePoint) (index : Index) : ℂ :=
  phase (rate index) displacement

theorem phase_add (r : ℝ) (point displacement : BasePoint) :
    phase r (point + displacement) = phase r point * phase r displacement := by
  simp [phase, add_mul, Complex.exp_add]

theorem phaseCoefficient_add (first second : BasePoint) (index : Index) :
    phaseCoefficient (first + second) index =
      phaseCoefficient first index * phaseCoefficient second index :=
  phase_add (rate index) first second

def unitary (displacement : BasePoint) : Matrix.unitaryGroup Index ℂ :=
  ⟨Matrix.diagonal (phaseCoefficient displacement), by
    rw [Matrix.mem_unitaryGroup_iff', Matrix.star_eq_conjTranspose,
      Matrix.diagonal_conjTranspose, Matrix.diagonal_mul_diagonal]
    rw [← Matrix.diagonal_one]
    congr 1
    funext index
    exact phase_star_mul (rate index) displacement⟩

theorem unitary_matrix (displacement : BasePoint) :
    (unitary displacement : Matrix Index Index ℂ) =
      Matrix.diagonal (phaseCoefficient displacement) := rfl

theorem unitary_zero : unitary 0 = 1 := by
  apply Subtype.ext
  change Matrix.diagonal (phaseCoefficient 0) = 1
  rw [← Matrix.diagonal_one]
  congr 1
  funext index
  exact phase_zero (rate index)

theorem unitary_add (first second : BasePoint) :
    unitary (first + second) = unitary first * unitary second := by
  apply Subtype.ext
  change Matrix.diagonal _ = Matrix.diagonal _ * Matrix.diagonal _
  rw [Matrix.diagonal_mul_diagonal]
  congr 1
  funext index
  exact phaseCoefficient_add first second index

theorem phaseCoefficient_mul_amplitude (point displacement : BasePoint) (index : Index) :
    phaseCoefficient displacement index * amplitude point index =
      amplitude (point + displacement) index := by
  rcases index with ⟨spin, color⟩
  fin_cases spin <;> fin_cases color <;>
    simp [phaseCoefficient, rate, amplitude, spinPairCoefficients,
      upperPhase, lowerPhase, phase_add, mul_comm]

theorem phaseCoefficient_mul_vector (point displacement : BasePoint) (index : Index) :
    phaseCoefficient displacement index * vector point index =
      vector (point + displacement) index := by
  unfold vector
  rw [← mul_div_assoc, phaseCoefficient_mul_amplitude]

theorem unitary_mul_vector (point displacement : BasePoint) :
    (unitary displacement : Matrix Index Index ℂ) *ᵥ vector point =
      vector (point + displacement) := by
  funext index
  rw [unitary_matrix, Matrix.mulVec_diagonal]
  exact phaseCoefficient_mul_vector point displacement index

theorem unitary_two_step (point first second : BasePoint) :
    (unitary second : Matrix Index Index ℂ) *ᵥ
        ((unitary first : Matrix Index Index ℂ) *ᵥ vector point) =
      vector (point + (first + second)) := by
  rw [unitary_mul_vector, unitary_mul_vector, add_assoc]

end
end SaturationMonoid.PhysicsCore.Stage9DEF.Dynamics
