import H0mework.Versions.R2.Foundation.Source.SequentialAction
import H0mework.Versions.R2.Physics.Material.CartanAssembly
import H0mework.Physics.GaugeSource.CenteredReducedEntropyIteration
import H0mework.Versions.R2.Physics.RootHistory.PhysicalRootRuntime

/-! The sequential Cartan action retains every old support and ledger row.
New supports carry material generated by the whole-field operation. The
initial ingress has exactly the old first-assembly ledger; this file neither
selects a runtime branch nor claims a residual settlement. -/

set_option autoImplicit false

namespace SaturationMonoid.PhysicsCore.Stage9C.Revision

open ResponsibilityLifecycle.LivingLawEvolution
open ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
open ProofFreeRicherAnholonomicSource
open StageNineDiracDualFormNativeCartanReactionCurrentRestart
open StageNineDiracDualFormNativeFixedP506CartanECConstraintCauchyGravityTailRootNativeWrite
open StageNineDiracDualFormNativeFixedP506CartanECConstraintCauchyWholeSpacetimeAssembly
open StageNineDiracDualFormNativeJointResidualCarrier
open StageNineEnrichedProofFreeSource
open StageNineHolonomicField
open StageNineFormNativeGaugeAuxiliaryVariation
open StageNineP286SourceNativeCenteredReducedEntropyIteration

noncomputable section

abbrev OldN :=
  StageNineDiracDualFormNativeFixedP506CartanECConstraintCauchyGravityTailRootNativeWrite.N

abbrev MaterialState :=
  P286CenteredReducedEntropyStateAt positiveSmoothUnifiedSource

def materialInitialState : MaterialState where
  current := Material.firstAssemblyCartanActual
  smooth := Material.firstAssemblyCartanActual_smooth
  nondegenerate := Material.firstAssemblyCartanActual_nondegenerate
  auxiliaryEquation := fun point =>
    (formNativeP286GaugeAuxiliaryEulerResidual_eq_zero_iff _ _).1
      (Material.firstAssemblyCartanActual_p286Auxiliary_zero point)

abbrev MaterialSupport := RootCurrent ⊕ MaterialState

inductive MaterialCurrent
  | ingress
  | running (state : MaterialState)

def materialCurrentSupport : MaterialCurrent → MaterialSupport
  | .ingress => .inl firstAssemblyCurrent
  | .running state => .inr state

def materialConfiguration : MaterialSupport → StageNineHolonomicConfiguration
  | .inl current => current.configuration
  | .inr state => state.current

def materialResidual : MaterialSupport → RootResidualPayload
  | .inl current => rootResidualAt current
  | .inr state =>
      { coframeBoundary := .settled
        classicalJoint := diracDualFormNativeJointResidualSection
          positiveSmoothUnifiedSource state.current
        gravity := 0
        gravityCoframeFirstJet := 0
        assembly := candidateAssemblySeam positiveSmoothUnifiedSource state.current }

structure MaterialOpenAt (support : MaterialSupport)
    (responsibility : RootResidualPayload) : Type where
  exact : responsibility = materialResidual support

abbrev MaterialObstructionAt (support : MaterialSupport) :=
  Sigma fun coordinate : RootResidualCoordinate =>
    Sigma fun point : BasePoint =>
      (materialResidual support).coordinateAt coordinate point

abbrev MaterialClaim := RootResidualClaim ⊕ Sigma MaterialObstructionAt

def materialClaimHolds : MaterialSupport → MaterialClaim → Type
  | .inl current, .inl claim => RootResidualClaim.HoldsAt current claim
  | .inr _, .inl .liveAccount => PUnit
  | .inr _, .inl (.obstruction _) => PEmpty
  | support, .inr obstruction => PLift (obstruction.1 = support)

structure MaterialActionAt (_current : MaterialCurrent) : Type where
  private mk ::

def materialActionAt (current : MaterialCurrent) : MaterialActionAt current :=
  ⟨⟩

inductive MaterialDispositionAt : MaterialSupport → WorldDispositionKind → Type
  | inherited {support : RootCurrent} {kind : WorldDispositionKind}
      (receipt : OldN.DispositionAt support kind) :
      MaterialDispositionAt (.inl support) kind
  | transfer {current : MaterialCurrent} (action : MaterialActionAt current) :
      MaterialDispositionAt (materialCurrentSupport current) .transfer

def materialNetwork : WorldRelationNetwork where
  Support := MaterialSupport
  Anchor := OldN.Anchor
  Incidence := MaterialSupport
  Lineage := OldN.Lineage
  Responsibility := RootResidualPayload
  Claim := MaterialClaim
  anchorAt := fun _ => positiveSmoothUnifiedSource
  incidenceAt := id
  lineageAt := fun _ => positiveSmoothUnifiedSource
  OpenAt := MaterialOpenAt
  openClaimAt := fun _ => .inl .liveAccount
  HoldsAt := materialClaimHolds
  ObstructionAt := MaterialObstructionAt
  obstructionClaim := fun {support} obstruction => .inr ⟨support, obstruction⟩
  SemanticChangeAt := fun _ _ _ => PEmpty
  DispositionAt := MaterialDispositionAt

abbrev MaterialN := materialNetwork

def materialEntry (support : MaterialSupport) :
    OpenResponsibilityAt MaterialN support :=
  ⟨materialResidual support, ⟨rfl⟩⟩

theorem materialEntry_unique (support : MaterialSupport)
    (entry : OpenResponsibilityAt MaterialN support) :
    entry = materialEntry support := by
  rcases entry with ⟨responsibility, ⟨exact⟩⟩
  cases exact
  rfl

def materialInventoryPresentation (support : MaterialSupport) :
    ConstructivePresentation PUnit (OpenResponsibilityAt MaterialN support) where
  forward := fun _ => materialEntry support
  backward := fun _ => PUnit.unit
  backward_forward := fun _ => rfl
  forward_backward := fun entry => (materialEntry_unique support entry).symm

def materialTranslation : TypedSemanticWorldNetworkTranslationAt OldN MaterialN where
  support :=
    { forward := Sum.inl
      backward := fun | .inl support => support | .inr _ => firstAssemblyCurrent
      backward_forward := fun _ => rfl }
  anchor := { forward := id, backward := id, backward_forward := fun _ => rfl }
  incidence :=
    { forward := Sum.inl
      backward := fun | .inl support => support | .inr _ => firstAssemblyCurrent
      backward_forward := fun _ => rfl }
  lineage := { forward := id, backward := id, backward_forward := fun _ => rfl }
  responsibility :=
    { forward := id, backward := id, backward_forward := fun _ => rfl }
  claim :=
    { forward := Sum.inl
      backward := fun | .inl claim => claim | .inr _ => .liveAccount
      backward_forward := fun _ => rfl }
  anchor_commutes := fun _ => rfl
  incidence_commutes := fun _ => rfl
  lineage_commutes := fun _ => rfl
  oldOpenLedger := fun support =>
    { forward := fun entry => ⟨entry.1, ⟨entry.2.responsibility_eq⟩⟩
      backward := fun entry => ⟨entry.1, ⟨entry.2.exact⟩⟩
      backward_forward := fun entry => by cases entry; rfl }
  oldOpenClaim_commutes := fun _ _ => rfl
  oldOpenProgressBudget_commutes := fun _ _ => rfl
  oldHoldsSurvives := fun _ _ evidence => evidence
  oldDispositionSurvives := fun _ _ receipt => .inherited receipt

theorem materialIngress_has_no_fresh_rows (support : RootCurrent)
    (entry : OpenResponsibilityAt MaterialN (.inl support)) :
    Nonempty (Sigma fun oldEntry : OpenResponsibilityAt OldN support =>
      PLift ((materialTranslation.oldOpenLedger support).forward oldEntry = entry)) :=
  ⟨⟨⟨entry.1, ⟨entry.2.exact⟩⟩, PLift.up rfl⟩⟩

@[simp] theorem materialInitialState_configuration :
    materialConfiguration (materialCurrentSupport (.running materialInitialState)) =
      Material.firstAssemblyCartanActual :=
  rfl

end
end SaturationMonoid.PhysicsCore.Stage9C.Revision
