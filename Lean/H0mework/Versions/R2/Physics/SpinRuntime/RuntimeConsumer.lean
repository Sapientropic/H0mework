import H0mework.Versions.R2.Physics.Revision.RuntimeConsumer
import H0mework.Versions.R2.Physics.SpinPair.Acceptance

/-! Original-seed activation, source-owned first write, and an independent
configuration consumer carrying the original full classical-world key. -/

set_option autoImplicit false

namespace SaturationMonoid.PhysicsCore.Stage9C.Revision.SpinPair

open ResponsibilityLifecycle.LivingLawEvolution
open ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
open ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot.RootInquiryCompletion
open StageNineEnrichedProofFreeSource StageNineCClassicalWorldAcceptance

noncomputable section

def actionTick := physicalInquiryRuntime.tickAt 6

theorem actionTick_action : actionTick.resolution = .actualAction generatedAction := rfl

theorem actionTick_resumption :
    SourceNativeInquiryRuntime.SequentialActualActionResumptionAt
      generatedAction physicalInquiryRuntime 6 where
  contains_action := by
    rw [actionTick_action]
    exact HEq.rfl

def activatedReceipt : FirstWriteReceiptAt sourceEvent Material.SpinPair.actual :=
  actionTick.receipt.2

theorem actionTick_answer : actionTick.answer = Material.SpinPair.actual := rfl

theorem actionTick_next : actionTick.next.node.erase =
    ⟨MaterialN, generatedAction.target.targetAnswerAndNext.nextCurrent⟩ :=
  actionTick.next_erases_to_generated

def firstReadTick := physicalInquiryRuntime.tickAt 7

theorem firstReadTick_native_answer : firstReadTick.resolution =
    .directlyAnswered (configurationFace 1) (configurationConsumer 1) := rfl

theorem firstReadTick_answer : firstReadTick.answer = Material.SpinPair.actual := rfl

/-- Acceptance is generated by the physical source and then consumed at
the exact activated target configuration. It is never an inquiry input. -/
theorem firstReadTick_classicalWorldAcceptance :
    ClassicalWorldAcceptance positiveSmoothUnifiedSource firstReadTick.answer := by
  have identifies : firstReadTick.answer = Material.SpinPair.actual := activatedReceipt.actual_eq
  rw [identifies]
  exact Material.SpinPair.actual_classicalWorldAcceptance

theorem firstReadTick_next : firstReadTick.next.node.erase = (readPresentation 1).erase := rfl

theorem firstReadTick_next_configuration :
    materialConfiguration (support (visit 2).current) =
      (materialStateNext initialState).current := rfl

set_option linter.defProp false in
/-- Both compilers, the original ingress whole-ledger write, the generated
first successor and the full accepted readout belong to this one activation. -/
def activatedAcceptance_factorizes :=
  let sourceCompilation := inquiryPresentation.state.generatedCompilation_factorizes PUnit.unit
  let targetCompilation := (readPresentation 0).state.generatedCompilation_factorizes PUnit.unit
  let sourceLedger := sourceEvent.wholeLedgerWriteBack_eq
  And.intro sourceCompilation
    (And.intro sourceLedger
      (And.intro actionTick_next
        (And.intro targetCompilation
          (And.intro firstReadTick_classicalWorldAcceptance firstReadTick_next))))

/-- Finite observation of the same runtime includes both source actions and
the independent accepted read. Its target remains a live native successor. -/
def eightActivations : SourceNativeInquiryRuntime.HistoryAt physicalInquiryRuntime 8
    physicalInquiryRuntime.initialState := physicalInquiryRuntime.run 8

theorem eightActivations_target : (physicalInquiryRuntime.stateAt 8).engine.node.erase =
    (readPresentation 1).erase := rfl

end
end SaturationMonoid.PhysicsCore.Stage9C.Revision.SpinPair
