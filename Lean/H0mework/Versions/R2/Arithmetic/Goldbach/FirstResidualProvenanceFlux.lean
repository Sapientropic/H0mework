import H0mework.Versions.R2.Arithmetic.Goldbach.FirstResidualConsumer
import H0mework.Foundation.Finite.ProvenanceFlux

/-!
# Occurrence-aware flux generated by the first-residual dark SCC

The minimal dark SCC is closed only on the bare effective-split projection.
Choose its source classifier's actual outgoing channel, return along the SCC's
generated dependent path, and retain the complete event history.  The split
returns, but provenance depth strictly grows, producing an explicit lawful
outflow from every finite one-occurrence presentation of that projected loop.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace CanonicalUnitArithmeticOperationalFirstResidualProvenanceFluxProducer

open CanonicalUnitArithmeticEffectiveFactorRepairOrbitProducer
open CanonicalUnitArithmeticFullFactorEmissionProducer
open CanonicalUnitArithmeticGlobalGoldbachDisposition
open CanonicalUnitArithmeticOperationalFactorDecayProducer
open CanonicalUnitArithmeticOperationalFirstResidualConsumer
open CanonicalUnitArithmeticOperationalFirstResidualProducer
open CanonicalUnitArithmeticOperationalGoldbachRuntime
open SourceGeneratedFiniteEffectiveBranchingReachability
open SourceGeneratedFiniteEventIndexedProvenanceFlux
open SourceGeneratedFiniteEventIndexedResidualProcess

noncomputable section

noncomputable def operationalConsumer (failure : FirstResidualOccurrence) :=
  CanonicalUnitArithmeticOperationalFirstResidualConsumer.consume failure

noncomputable def fluxBase (failure : FirstResidualOccurrence) :
    EffectiveSplitAt failure.index :=
  Classical.choose (operationalConsumer failure).primeTrace.scc.sectorNonempty

theorem fluxBase_mem (failure : FirstResidualOccurrence) :
    fluxBase failure ∈
      (operationalConsumer failure).primeTrace.scc.scc.sector.states :=
  Classical.choose_spec
    (operationalConsumer failure).primeTrace.scc.sectorNonempty

/-! The exact negative reachable state is consumed by the canonical unordered
physical selector shared with the Fock runtime. -/
noncomputable def fluxGeneratedStep (failure : FirstResidualOccurrence) :
    { selected : PhysicalProgressChannelAt (fluxBase failure) //
      fullPhysicalFactorDecayClassify (fluxBase failure) =
        .inr selected } := by
  generalize classifier_eq :
    fullPhysicalFactorDecayClassify (fluxBase failure) = outcome
  cases outcome with
  | inl terminalSelection =>
      exact False.elim
        ((operationalConsumer failure).primeTrace.scc.decay.residual.terminalEmpty
          (fluxBase failure)
          ((operationalConsumer failure).primeTrace.scc.sectorSubsetResidual
            (fluxBase_mem failure)) ⟨terminalSelection.terminal⟩)
  | inr selected => exact ⟨selected, rfl⟩

/-- Canonical executable channel supplied by the packaged classifier step. -/
noncomputable def fluxChannel (failure : FirstResidualOccurrence) :
    FactorDecayChannelAt (fluxBase failure) :=
  (fluxGeneratedStep failure).1.channel

theorem fluxPhysicalClassifier_eq (failure : FirstResidualOccurrence) :
    fullPhysicalFactorDecayClassify (fluxBase failure) =
      .inr (fluxGeneratedStep failure).1 :=
  (fluxGeneratedStep failure).2

theorem fluxRepairClassifier_eq (failure : FirstResidualOccurrence) :
    (fullFactorDecayLaw failure.index).classify (fluxBase failure) =
      .inr (.repair
        (fluxGeneratedStep failure).1.classifierAlternative) :=
  (fluxGeneratedStep failure).1.classifier_eq

theorem fluxChannel_isPhysicalProgress (failure : FirstResidualOccurrence) :
    (fluxChannel failure).IsPhysicalProgress :=
  (fluxGeneratedStep failure).1.physicalProgress

theorem fluxTarget_mem (failure : FirstResidualOccurrence) :
    (fluxChannel failure).target ∈
      (operationalConsumer failure).primeTrace.scc.scc.sector.states :=
  (operationalConsumer failure).primeTrace.scc.everyDecayChannelClosed
    (fluxBase failure) (fluxBase_mem failure) (fluxChannel failure)

noncomputable def fluxChannelReceipt (failure : FirstResidualOccurrence) :
    OperationalFactorDecayChannelReceiptAt (fluxChannel failure) :=
  (operationalConsumer failure).everySCCChannelReceipt
    (fluxBase failure) (fluxBase_mem failure) (fluxChannel failure)

def fluxFirstLeg (failure : FirstResidualOccurrence) :
    SourceGeneratedFiniteEventIndexedResidualProcess.GeneratedPathAt
      (factorDecayProcess failure.index) (fluxBase failure)
        (fluxChannel failure).target :=
  SourceGeneratedFiniteEventIndexedResidualProcess.GeneratedPathAt.oneStep
    (P := factorDecayProcess failure.index)
    (fluxBase failure) (fluxChannel failure)

theorem fluxFirstLeg_eq_receipt (failure : FirstResidualOccurrence) :
    HEq (fluxFirstLeg failure) (fluxChannelReceipt failure).step.path := by
  rw [(fluxChannelReceipt failure).step_eq]
  rfl

noncomputable def fluxReturnLeg (failure : FirstResidualOccurrence) :
    SourceGeneratedFiniteEventIndexedResidualProcess.GeneratedPathAt
      (factorDecayProcess failure.index) (fluxChannel failure).target
        (fluxBase failure) :=
  (operationalConsumer failure).pathBetweenOperational
    (fluxChannel failure).target (fluxTarget_mem failure)
    (fluxBase failure) (fluxBase_mem failure)

noncomputable def projectedLoop (failure : FirstResidualOccurrence) :
    SourceGeneratedFiniteEventIndexedResidualProcess.GeneratedPathAt
      (factorDecayProcess failure.index) (fluxBase failure)
        (fluxBase failure) :=
  append (fluxFirstLeg failure) (fluxReturnLeg failure)

theorem projectedLoop_length_positive (failure : FirstResidualOccurrence) :
    0 < (projectedLoop failure).length := by
  rw [projectedLoop, append_length]
  change 0 < 1 + (fluxReturnLeg failure).length
  omega

noncomputable def provenanceFlux (failure : FirstResidualOccurrence) :
    ProjectedReturnFluxAt (factorDecayProcess failure.index)
      (fluxBase failure) :=
  generateProjectedReturnFlux (projectedLoop failure)
    (projectedLoop_length_positive failure)

theorem nextRuntime_scanIndex (failure : FirstResidualOccurrence) :
    scanIndex
        (runtimeAt (failureDepth failure + 1)).current.visit.current =
      failure.index + 1 := by
  rw [runtimeAt_scanIndex, failureDepth_succ_eq_index]

/-- The ordinary canonical root successor scans to the next even target; it
cannot be reinterpreted as an intra-target factor event.  The factor path is
an occurrence-local dependent calculation/effect trace, not a competing root
successor.  This separation is not an expressibility failure or a U8 trigger.
-/
theorem nextRuntime_scanIndex_ne_factorIndex
    (failure : FirstResidualOccurrence) :
    scanIndex
        (runtimeAt (failureDepth failure + 1)).current.visit.current ≠
      failure.index := by
  rw [nextRuntime_scanIndex]
  omega

/-- Rooted provenance-flux face.  The same operational runtime readout owns
the channel receipt, return path, exact projected loop, whole ledger and next.
-/
structure RootGeneratedOperationalFirstResidualProvenanceFluxAt
    (failure : FirstResidualOccurrence) : Type 7 where
  private mk ::
  operational :
    CanonicalUnitArithmeticOperationalFirstResidualConsumer.ConsumesAt failure
  operational_eq : operational = operationalConsumer failure
  base : EffectiveSplitAt failure.index
  base_eq : base = fluxBase failure
  baseMem : base ∈ operational.primeTrace.scc.scc.sector.states
  channel : FactorDecayChannelAt base
  channel_eq : HEq channel (fluxChannel failure)
  channelReceipt : OperationalFactorDecayChannelReceiptAt channel
  channelReceipt_eq : HEq channelReceipt (fluxChannelReceipt failure)
  targetMem : channel.target ∈ operational.primeTrace.scc.scc.sector.states
  loop : SourceGeneratedFiniteEventIndexedResidualProcess.GeneratedPathAt
    (factorDecayProcess failure.index) base base
  loop_eq : HEq loop (projectedLoop failure)
  flux : ProjectedReturnFluxAt (factorDecayProcess failure.index) base
  flux_eq : HEq flux (provenanceFlux failure)
  projectionReturns : flux.returned.state = flux.initial.state
  provenanceStrict : flux.initial.depth < flux.returned.depth
  effectInventoryChanged :
    flux.returned.effectInventory ≠ flux.initial.effectInventory
  occurrenceChanged : flux.returned ≠ flux.initial
  rootNextScanIndex :
    scanIndex
        (runtimeAt (failureDepth failure + 1)).current.visit.current =
      failure.index + 1
  rootNextLeavesFactorIndex :
    scanIndex
        (runtimeAt (failureDepth failure + 1)).current.visit.current ≠
      failure.index
  sourceOccurrence :
    (runtimePayload (failureDepth failure)).sourceOccurrence =
      (runtimeAt (failureDepth failure)).emittedOccurrence
  namedReadout :
    runtimeFacade.readoutAt (runtimeAt (failureDepth failure))
        .operationalGoldbach =
      .inl ⟨runtimeActive (failureDepth failure),
        runtimePayload (failureDepth failure)⟩
  wholeLedger :
    HEq (runtimeAt (failureDepth failure)).tick.generated.wholeLedgerWriteBack
      ((runtimeAt (failureDepth failure)).current.root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt
        (runtimeAt (failureDepth failure)).current.visit.current)
  projectionFactorizes :
    HEq
      (runtimeFacade.readoutAt (runtimeAt (failureDepth failure))
        .operationalGoldbach)
      ((runtimeAt (failureDepth failure)).tick.generated.projectionOutcome
        ((runtimeFacade.installationAt
          (runtimeAt (failureDepth failure)) .operationalGoldbach).embed
          (runtimeFacade.projectionAt
            (runtimeAt (failureDepth failure)) .operationalGoldbach)))
  generatedNext :
    (runtimeAt (failureDepth failure)).tick.nextCurrent =
      runtimeFacade.process.stateAt
        (runtimeFacade.process.successor
          (runtimeAt (failureDepth failure)).state)

noncomputable def generate (failure : FirstResidualOccurrence) :
    RootGeneratedOperationalFirstResidualProvenanceFluxAt failure :=
  { operational := operationalConsumer failure
    operational_eq := rfl
    base := fluxBase failure
    base_eq := rfl
    baseMem := fluxBase_mem failure
    channel := fluxChannel failure
    channel_eq := HEq.rfl
    channelReceipt := fluxChannelReceipt failure
    channelReceipt_eq := HEq.rfl
    targetMem := fluxTarget_mem failure
    loop := projectedLoop failure
    loop_eq := HEq.rfl
    flux := provenanceFlux failure
    flux_eq := HEq.rfl
    projectionReturns := (provenanceFlux failure).projectionReturns
    provenanceStrict := (provenanceFlux failure).depthStrict
    effectInventoryChanged := (provenanceFlux failure).effectInventoryChanged
    occurrenceChanged := (provenanceFlux failure).occurrenceChanged
    rootNextScanIndex := nextRuntime_scanIndex failure
    rootNextLeavesFactorIndex := nextRuntime_scanIndex_ne_factorIndex failure
    sourceOccurrence := (operationalConsumer failure).sourceOccurrence
    namedReadout := (operationalConsumer failure).namedReadout
    wholeLedger := (operationalConsumer failure).wholeLedger
    projectionFactorizes :=
      (operationalConsumer failure).projectionFactorizes
    generatedNext := (operationalConsumer failure).generatedNext }

/-- Coverage-complete physical disposition of the Goldbach branch.  The
positive branch is the ordinary all-target prime-pair statement.  The negative
branch is no longer a dark token: it returns the exact projected trapped SCC
together with its observable occurrence outflow. -/
inductive GoldbachOperationalPhysicalDisposition : Type 7 where
  | positive
      (classical :
        CanonicalUnitArithmeticClassicalGoldbachBridge.CanonicalClassicalGoldbach)
  | projectedTrappedWithOutflow
      (notClassical : ¬
        CanonicalUnitArithmeticClassicalGoldbachBridge.CanonicalClassicalGoldbach)
      (failure : FirstResidualOccurrence)
      (flux : RootGeneratedOperationalFirstResidualProvenanceFluxAt failure)

noncomputable def settleOperationalPhysical :
    GoldbachOperationalPhysicalDisposition := by
  cases CanonicalUnitArithmeticGlobalGoldbachDisposition.settle with
  | positive classical _named _joint => exact .positive classical
  | firstResidual notClassical failure =>
      exact .projectedTrappedWithOutflow notClassical failure
        (generate failure)

theorem operationalPhysical_total :
    Nonempty GoldbachOperationalPhysicalDisposition :=
  ⟨settleOperationalPhysical⟩

end
end CanonicalUnitArithmeticOperationalFirstResidualProvenanceFluxProducer
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
