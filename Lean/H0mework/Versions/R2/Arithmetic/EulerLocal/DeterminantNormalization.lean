import Mathlib.NumberTheory.ArithmeticFunction.LFunction
import H0mework.Versions.R2.Arithmetic.UnitArithmetic.CommonCarrier
import H0mework.Versions.R2.Arithmetic.EulerGlobal.DerivedDeterminant
import H0mework.Versions.R2.Arithmetic.EulerLocal.RuntimePrimeLanding

/-!
# Local normalization of an actual factorization determinant

The actual factorization action has local determinant factor `1 - pX`.
The same actual prime supplies its coordinate frame `X ↦ X / p`; in that
frame the factor is `1 - X`, whose reciprocal is the same local power series
used by the existing unit-history Euler fold.

This is a subordinate local normalization.  Its prime-dependent frame does
not define one global determinant coordinate, a point of `Z(D)`, or a
specialization to Mathlib `riemannZeta`.
-/

set_option autoImplicit false
set_option maxHeartbeats 3000000
set_option backward.isDefEq.respectTransparency false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace CanonicalUnitArithmeticFactorizationDeterminantLocalNormalization

open CanonicalUnitArithmeticCommonCarrier
open CanonicalUnitArithmeticFactorizationEulerDependentDiagram
open CanonicalUnitArithmeticFactorizationFullEulerDerivedDeterminantSection
open CanonicalUnitArithmeticFactorizationFullEulerRuntimePrimePowerLanding
open CanonicalUnitArithmeticFactorizationFullEulerSolutionAction
open CanonicalUnitArithmeticFactorizationOccurrence
open Polynomial

noncomputable section

def requestedBaseIndex
    {requestedPrime : Nat.Primes} {requestedExponent : Nat}
    (factor : RuntimePrimePowerFactorAt requestedPrime requestedExponent)
    (dualIndex : Fin 2) :
    BaseIndex seedOccurrence.root factor.stage :=
  (stagePrimeIndex factor, dualIndex)

/-- Coordinate normalization generated by the same actual prime that acts
on the local recurrence carrier. -/
noncomputable def normalizedActualLocalDeterminantFactor
    {requestedPrime : Nat.Primes} {requestedExponent : Nat}
    (factor : RuntimePrimePowerFactorAt requestedPrime requestedExponent)
    (dualIndex : Fin 2) : Polynomial ℚ :=
  (localEulerDeterminantFactor seedOccurrence.root factor.stage
      (requestedBaseIndex factor dualIndex)).eval₂
    (Polynomial.C.comp (Int.castRingHom ℚ))
    (X * C (((requestedPrime : Nat) : ℚ)⁻¹))

theorem normalizedActualLocalDeterminantFactor_eq_sourcePolynomial
    {requestedPrime : Nat.Primes} {requestedExponent : Nat}
    (factor : RuntimePrimePowerFactorAt requestedPrime requestedExponent)
    (dualIndex : Fin 2) :
    normalizedActualLocalDeterminantFactor factor dualIndex = 1 - X := by
  unfold normalizedActualLocalDeterminantFactor
    localEulerDeterminantFactor requestedBaseIndex
  rw [actualPrimeScalar, stagePrimeIndex_actualPrime]
  simp only [eval₂_sub, eval₂_one, eval₂_mul, eval₂_X, eval₂_C,
    RingHom.comp_apply]
  rw [show (Int.castRingHom ℚ) (((requestedPrime : Nat) : ℤ)) =
      (((requestedPrime : Nat) : ℚ)) by norm_num]
  let primeScalar : ℚ := ((requestedPrime : Nat) : ℚ)
  change 1 - X * C primeScalar⁻¹ * C primeScalar = 1 - X
  have primeNonzero : primeScalar ≠ 0 := by
    unfold primeScalar
    exact_mod_cast requestedPrime.property.ne_zero
  have cancel :
      C primeScalar⁻¹ * C primeScalar =
        (1 : Polynomial ℚ) := by
    rw [← C_mul, inv_mul_cancel₀ primeNonzero, C_1]
  rw [mul_assoc, cancel, mul_one]

noncomputable def normalizedActualLocalZetaSeries
    {requestedPrime : Nat.Primes} {requestedExponent : Nat}
    (factor : RuntimePrimePowerFactorAt requestedPrime requestedExponent)
    (dualIndex : Fin 2) : PowerSeries ℚ :=
  PowerSeries.invOfUnit
    (↑(normalizedActualLocalDeterminantFactor factor dualIndex) :
      PowerSeries ℚ) 1

theorem normalizedActualLocalZetaSeries_eq_geometric
    {requestedPrime : Nat.Primes} {requestedExponent : Nat}
    (factor : RuntimePrimePowerFactorAt requestedPrime requestedExponent)
    (dualIndex : Fin 2) :
    normalizedActualLocalZetaSeries factor dualIndex =
      PowerSeries.mk 1 := by
  rw [normalizedActualLocalZetaSeries,
    normalizedActualLocalDeterminantFactor_eq_sourcePolynomial]
  have constantTerm :
      PowerSeries.constantCoeff
          (↑((1 - X : Polynomial ℚ)) : PowerSeries ℚ) = 1 := by
    simp
  have inverseLaw :
      PowerSeries.invOfUnit
          (↑((1 - X : Polynomial ℚ)) : PowerSeries ℚ) 1 *
        (↑((1 - X : Polynomial ℚ)) : PowerSeries ℚ) = 1 :=
    PowerSeries.invOfUnit_mul _ 1 constantTerm
  have geometricLaw :
      (↑((1 - X : Polynomial ℚ)) : PowerSeries ℚ) *
          PowerSeries.mk 1 = 1 := by
    simpa [mul_comm] using PowerSeries.mk_one_mul_one_sub_eq_one ℚ
  calc
    PowerSeries.invOfUnit
          (↑((1 - X : Polynomial ℚ)) : PowerSeries ℚ) 1 =
        PowerSeries.invOfUnit
          (↑((1 - X : Polynomial ℚ)) : PowerSeries ℚ) 1 * 1 :=
      (mul_one _).symm
    _ = PowerSeries.invOfUnit
          (↑((1 - X : Polynomial ℚ)) : PowerSeries ℚ) 1 *
        ((↑((1 - X : Polynomial ℚ)) : PowerSeries ℚ) *
          PowerSeries.mk 1) := by rw [geometricLaw]
    _ = (PowerSeries.invOfUnit
          (↑((1 - X : Polynomial ℚ)) : PowerSeries ℚ) 1 *
        (↑((1 - X : Polynomial ℚ)) : PowerSeries ℚ)) *
          PowerSeries.mk 1 := by rw [mul_assoc]
    _ = PowerSeries.mk 1 := by rw [inverseLaw, one_mul]

@[simp] theorem normalizedActualLocalZetaSeries_coeff
    {requestedPrime : Nat.Primes} {requestedExponent : Nat}
    (factor : RuntimePrimePowerFactorAt requestedPrime requestedExponent)
    (dualIndex : Fin 2) (exponent : Nat) :
    (normalizedActualLocalZetaSeries factor dualIndex).coeff exponent = 1 := by
  rw [normalizedActualLocalZetaSeries_eq_geometric]
  simp

/-- The normalized determinant factor is not merely isomorphic to an
unrelated geometric series: coefficientwise it is exactly the scalar
extension of the local series used by the unit-history Euler fold. -/
theorem normalizedActualLocalZetaSeries_eq_sourceLocal_map
    {requestedPrime : Nat.Primes} {requestedExponent : Nat}
    (factor : RuntimePrimePowerFactorAt requestedPrime requestedExponent)
    (dualIndex : Fin 2) :
    normalizedActualLocalZetaSeries factor dualIndex =
      PowerSeries.map (Int.castRingHom ℚ)
        (sourceLocalZetaPowerSeries requestedPrime) := by
  rw [normalizedActualLocalZetaSeries_eq_geometric,
    sourceLocalZetaPowerSeries_eq_mk_one]
  ext exponent
  simp

/-- Arithmetic-function restriction of the normalized actual determinant
factor.  The prime support is supplied by the same actual factorization row;
the coefficients are supplied by its normalized determinant reciprocal. -/
noncomputable def actualNormalizedLocalFormalEulerFactor
    {requestedPrime : Nat.Primes} {requestedExponent : Nat}
    (factor : RuntimePrimePowerFactorAt requestedPrime requestedExponent)
    (dualIndex : Fin 2) : ArithmeticFunction ℚ :=
  ArithmeticFunction.ofPowerSeries (requestedPrime : Nat)
    (normalizedActualLocalZetaSeries factor dualIndex)

noncomputable def sourceLocalFormalEulerFactorQ
    (prime : Nat.Primes) : ArithmeticFunction ℚ :=
  ArithmeticFunction.ofPowerSeries (prime : Nat)
    (PowerSeries.map (Int.castRingHom ℚ)
      (sourceLocalZetaPowerSeries prime))

theorem actualNormalizedLocalFormalEulerFactor_eq_source
    {requestedPrime : Nat.Primes} {requestedExponent : Nat}
    (factor : RuntimePrimePowerFactorAt requestedPrime requestedExponent)
    (dualIndex : Fin 2) :
    actualNormalizedLocalFormalEulerFactor factor dualIndex =
      sourceLocalFormalEulerFactorQ requestedPrime := by
  unfold actualNormalizedLocalFormalEulerFactor
    sourceLocalFormalEulerFactorQ
  rw [normalizedActualLocalZetaSeries_eq_sourceLocal_map]

/-- Every local normalization is read from an actual runtime factorization
row of the current determinant action.  This theorem does not assemble the
prime-dependent frames into one global coordinate. -/
theorem everyPrime_has_actual_normalized_determinant_readout
    (prime : Nat.Primes) (dualIndex : Fin 2) :
    let factor := RuntimePrimePowerFactorAt.generate prime 1 (by omega)
    factorialHistory
        (CanonicalUnitArithmeticFactorizationOccurrence.runtimeWholeHistory
          factor.stage) =
        (primePowerHistory factor.primeIndex factor.exponentIndex).joint
          (quotientHistory factor.primeIndex factor.exponentIndex) ∧
      normalizedActualLocalDeterminantFactor factor dualIndex = 1 - X ∧
      normalizedActualLocalZetaSeries factor dualIndex = PowerSeries.mk 1 ∧
      actualNormalizedLocalFormalEulerFactor factor dualIndex =
        sourceLocalFormalEulerFactorQ prime := by
  let factor := RuntimePrimePowerFactorAt.generate prime 1 (by omega)
  exact ⟨factor.actual_joint_landing,
    normalizedActualLocalDeterminantFactor_eq_sourcePolynomial factor dualIndex,
    normalizedActualLocalZetaSeries_eq_geometric factor dualIndex,
    actualNormalizedLocalFormalEulerFactor_eq_source factor dualIndex⟩

end
end CanonicalUnitArithmeticFactorizationDeterminantLocalNormalization
end ConstructiveRoot
end LivingLawEvolution
