import H0mework.Realization.Integral.IndistinguishablePair
import H0mework.Versions.R2.Arithmetic.FockState.JointMeasurement

/-!
# Physical indistinguishable-particle Fock carrier

The wave sector is retained verbatim.  Only the ordered two-particle sector
is projected to the exchange coinvariants.  The existing charge and joint
detectors are symmetric, hence descend to the physical carrier rather than
treating swapped labels as different outcomes.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalArithmeticState
namespace ParticleWaveFock

open CanonicalRiemann.ClozelGeneralizedDual.ThetaJRoleRelationQuotient
open SourceGeneratedIntegralCharacterGroupRing
open SourceGeneratedIntegralIndistinguishableParticlePair

noncomputable section

abbrev ParticleExchangeRelation : Submodule ℤ OrderedParticleTwo :=
  ExchangeRelation IntegralOneParticle

abbrev PhysicalParticleTwo := PhysicalPair IntegralOneParticle

/-- The physical parent keeps the full colored wave sector and quotients only
the redundant order labels in the degree-two sector. -/
abbrev PhysicalParentCarrier := ColoredWaveOne × PhysicalParticleTwo

def physicalPairProjection : OrderedParticleTwo →ₗ[ℤ] PhysicalParticleTwo :=
  projection IntegralOneParticle

/-- Canonical projection from the raw parent into the physical state space. -/
def physicalParentProjection : ParentCarrier →ₗ[ℤ] PhysicalParentCarrier :=
  coloredWaveProjection.prod (physicalPairProjection.comp pairProjection)

@[simp] theorem physicalParentProjection_wave (state : ParentCarrier) :
    (physicalParentProjection state).1 = coloredWaveProjection state :=
  rfl

@[simp] theorem physicalParentProjection_particles (state : ParentCarrier) :
    (physicalParentProjection state).2 =
      physicalPairProjection (pairProjection state) :=
  rfl

theorem physicalPairProjection_kernel :
    LinearMap.ker physicalPairProjection = ParticleExchangeRelation :=
  projection_kernel IntegralOneParticle

theorem physicalParentProjection_surjective :
    Function.Surjective physicalParentProjection := by
  rintro ⟨wave, particles⟩
  obtain ⟨ordered, rfl⟩ := projection_surjective IntegralOneParticle particles
  exact ⟨(wave, ordered), rfl⟩

/-- The physical pair ket generated by two one-particle states. -/
def physicalPairState (left right : IntegralOneParticle) :
    PhysicalParentCarrier :=
  physicalParentProjection (pairInclusion (left ⊗ₜ[ℤ] right))

/-- Direct physical law: exchanging two pure tensor factors does not generate
a second state. -/
@[simp] theorem physicalPairState_swap
    (left right : IntegralOneParticle) :
    physicalPairState left right = physicalPairState right left := by
  change
    (0, projection IntegralOneParticle (left ⊗ₜ[ℤ] right)) =
      (0, projection IntegralOneParticle (right ⊗ₜ[ℤ] left))
  rw [projection_tmul_swap]

@[simp] theorem pairChargeBilinear_delta_delta
    (left right : Units NNReal) :
    pairChargeBilinear (delta left) (delta right) =
      pairChargeBasis left right := by
  unfold pairChargeBilinear
  change (canonicalBasis.constr ℤ fun left =>
      canonicalBasis.constr ℤ (pairChargeBasis left))
    (canonicalBasis left) (canonicalBasis right) = _
  rw [canonicalBasis.constr_basis, canonicalBasis.constr_basis]

/-- The raw charge bilinear form is symmetric before quotienting. -/
theorem pairChargeBilinear_flip :
    pairChargeBilinear.flip = pairChargeBilinear := by
  apply canonicalBasis.ext
  intro left
  apply canonicalBasis.ext
  intro right
  simp [canonicalBasis_apply, pairChargeBilinear_delta_delta,
    pairChargeBasis, add_comm]

theorem pairCharge_swap (particles : OrderedParticleTwo) :
    pairCharge (swap IntegralOneParticle particles) = pairCharge particles := by
  have mapEquality :
      pairCharge.comp (swap IntegralOneParticle) = pairCharge := by
    apply TensorProduct.ext'
    intro left right
    change pairChargeBilinear right left = pairChargeBilinear left right
    have outer := LinearMap.congr_fun pairChargeBilinear_flip right
    have inner := LinearMap.congr_fun outer left
    exact inner.symm
  exact LinearMap.congr_fun mapEquality particles

/-- The additive pair-charge detector on physical two-particle states. -/
def physicalPairCharge : PhysicalParticleTwo →ₗ[ℤ] AdditiveChargeCarrier :=
  descend pairCharge pairCharge_swap

@[simp] theorem physicalPairCharge_projection (particles : OrderedParticleTwo) :
    physicalPairCharge (physicalPairProjection particles) =
      pairCharge particles :=
  rfl

def physicalWaveRead : PhysicalParentCarrier →ₗ[ℤ] JRoleFaithfulCoimage :=
  coimageProjection.comp
    (LinearMap.fst ℤ ColoredWaveOne PhysicalParticleTwo)

/-- Charge measurement descended to the physical parent. -/
def physicalParticleMeasurement :
    PhysicalParentCarrier →ₗ[ℤ] AdditiveChargeCarrier :=
  physicalPairCharge.comp
    (LinearMap.snd ℤ ColoredWaveOne PhysicalParticleTwo)

/-- The old joint wave/charge detector, now defined on physical states. -/
def physicalJointMeasurement :
    PhysicalParentCarrier →ₗ[ℤ] JointMeasurementTarget :=
  physicalWaveRead.prod physicalParticleMeasurement

@[simp] theorem physicalParticleMeasurement_projection
    (state : ParentCarrier) :
    physicalParticleMeasurement (physicalParentProjection state) =
      particleMeasurement state := by
  rfl

/-- The physical joint detector genuinely factors the original detector. -/
@[simp] theorem physicalJointMeasurement_projection
    (state : ParentCarrier) :
    physicalJointMeasurement (physicalParentProjection state) =
      jointMeasurement state := by
  rfl

theorem physicalJointMeasurement_comp_projection :
    physicalJointMeasurement.comp physicalParentProjection =
      jointMeasurement := by
  apply LinearMap.ext
  intro state
  exact physicalJointMeasurement_projection state

/-- The descended joint detector is uniquely fixed by its raw-parent
commuting law. -/
theorem physicalJointMeasurement_unique
    (candidate : PhysicalParentCarrier →ₗ[ℤ] JointMeasurementTarget)
    (commutes : candidate.comp physicalParentProjection = jointMeasurement) :
    candidate = physicalJointMeasurement := by
  apply LinearMap.ext
  intro state
  obtain ⟨raw, rfl⟩ := physicalParentProjection_surjective state
  have candidateAt := LinearMap.congr_fun commutes raw
  change candidate (physicalParentProjection raw) = jointMeasurement raw at candidateAt
  rw [candidateAt, physicalJointMeasurement_projection]

end

end ParticleWaveFock
end CanonicalArithmeticState
