import H0mework.Versions.R2.Arithmetic.EulerGlobal.HistoryRelationEmbedding

/-!
# Integral-first full-Euler determinant zero state

The determinant zero-fibre scalar is allowed to constrain only states already
generated by the integral cofinal whole-history solution.  Concretely, the
source carrier is

`Z(D) ⊗ IntegralGlobalSolution`,

and its inclusion into the scalar full-Euler relation vertex is induced by
the source-generated integral chain map.  Only after this inclusion is formed
do we take the kernel of `1-rF`.

This order prevents a characteristic-zero scalar extension from manufacturing
independent `q⁻ᵏ` quotient slots.  The frozen integral cofinal rigidity theorem
therefore kills the whole anti-invariant component before any classical
coordinate specialization.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false
set_option maxHeartbeats 3000000
set_option backward.isDefEq.respectTransparency false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace CanonicalUnitArithmeticFactorizationWholeHistoryIntegralZeroFiberState

open CanonicalUnitArithmeticFactorizationEulerDependentDiagram
open CanonicalUnitArithmeticFactorizationFullEulerWholeRelationComplexAction
open CanonicalUnitArithmeticFactorizationFullEulerWholeRelationGlobalAction
open CanonicalUnitArithmeticFactorizationFullEulerWholeRelationUniversalSolution
open CanonicalUnitArithmeticFactorizationFullEulerWholeRelationUniversalSolutionLocalLanding
open CanonicalUnitArithmeticFactorizationWholeHistoryIntegralRelationEmbedding
open CanonicalUnitArithmeticFactorizationWholeHistorySolutionCarrier
open CanonicalUnitArithmeticFactorizationWholeHistorySolutionCofinalRigidity
open CategoryTheory
open CategoryTheory.Limits
open scoped TensorProduct

noncomputable section

abbrev IntegralGlobalCarrier :=
  ((limit (solutionDiagram seedOccurrence.root)).X 0 : Type)

abbrev IntegralScalarCarrier :=
  TensorProduct ℤ CoefficientRing IntegralGlobalCarrier

/-- Scalar extension of the already generated integral global solution. -/
def integralScalarInclusion : IntegralScalarCarrier →ₗ[ℤ] ScalarVertex :=
  TensorProduct.map LinearMap.id integralGlobalInclusion

def integralScalarReversal : IntegralScalarCarrier →ₗ[ℤ]
    IntegralScalarCarrier :=
  TensorProduct.map LinearMap.id integralGlobalReversalLinear

theorem integralScalarInclusion_reversal_square :
    integralScalarInclusion.comp integralScalarReversal =
      extendedReversalZero.comp integralScalarInclusion := by
  rw [integralScalarInclusion, integralScalarReversal,
    extendedReversalZero, ← TensorProduct.map_comp,
    ← TensorProduct.map_comp]
  apply congrArg₂ TensorProduct.map
  · apply LinearMap.ext
    intro coefficient
    rfl
  · exact integralGlobalInclusion_reversal_square

theorem integralScalarReversal_involutive :
    Function.Involutive integralScalarReversal := by
  intro value
  induction value using TensorProduct.induction_on with
  | zero => simp [integralScalarReversal]
  | tmul coefficient integral =>
      simp [integralScalarReversal,
        globalIntegralReversal_involutive integral]
  | add left right left_ih right_ih =>
      simp only [map_add, left_ih, right_ih]

/-- The determinant zero equation is imposed only after integral generation. -/
def integralFirstEulerOperator : IntegralScalarCarrier →ₗ[ℤ] ScalarVertex :=
  universalEulerOperator.comp integralScalarInclusion

theorem integralFirstEulerOperator_reversal_square :
    integralFirstEulerOperator.comp integralScalarReversal =
      extendedReversalZero.comp integralFirstEulerOperator := by
  unfold integralFirstEulerOperator
  rw [LinearMap.comp_assoc, integralScalarInclusion_reversal_square,
    ← LinearMap.comp_assoc, universalEulerOperator_reversal_commutes,
    LinearMap.comp_assoc]

/-- Universal arithmetic zero states are integral global solutions whose
generated scalar extension satisfies the relative determinant action. -/
abbrev IntegralFirstUniversalKernel :=
  LinearMap.ker integralFirstEulerOperator

def universalInclusion : IntegralFirstUniversalKernel →ₗ[ℤ] ScalarVertex :=
  integralScalarInclusion.comp IntegralFirstUniversalKernel.subtype

def kernelReversal : IntegralFirstUniversalKernel →ₗ[ℤ]
    IntegralFirstUniversalKernel :=
  LinearMap.codRestrict IntegralFirstUniversalKernel
    (integralScalarReversal.comp IntegralFirstUniversalKernel.subtype)
    (fun value => by
      rw [LinearMap.mem_ker]
      have square := LinearMap.congr_fun
        integralFirstEulerOperator_reversal_square value.1
      change integralFirstEulerOperator
          (integralScalarReversal value.1) = 0
      change integralFirstEulerOperator
          (integralScalarReversal value.1) =
        extendedReversalZero (integralFirstEulerOperator value.1) at square
      rw [LinearMap.mem_ker.mp value.2, map_zero] at square
      exact square)

theorem kernelReversal_involutive : Function.Involutive kernelReversal := by
  intro value
  apply Subtype.ext
  exact integralScalarReversal_involutive value.1

def antiInvariantDifference (value : IntegralFirstUniversalKernel) :
    IntegralFirstUniversalKernel :=
  value - kernelReversal value

theorem kernelReversal_antiInvariantDifference
    (value : IntegralFirstUniversalKernel) :
    kernelReversal (antiInvariantDifference value) =
      -antiInvariantDifference value := by
  unfold antiInvariantDifference
  rw [map_sub, kernelReversal_involutive]
  module

def integralLocalValue (stage : Nat) :
    IntegralGlobalCarrier →ₗ[ℤ]
      CanonicalUnitArithmeticFactorizationWholeHistorySolutionCarrier.Carrier
        seedOccurrence.root stage :=
  ((limit.π (solutionDiagram seedOccurrence.root) (Opposite.op stage)).f 0).hom

theorem integralLocalValue_eq_frameworkLocalValue (stage : Nat) :
    integralLocalValue stage =
      CanonicalUnitArithmeticFactorizationWholeHistorySolutionCofinalRigidity.localValue
        stage := by
  rfl

theorem integralLocalValue_reversal (stage : Nat)
    (value : IntegralGlobalCarrier) :
    integralLocalValue stage (integralGlobalReversalLinear value) =
      CanonicalUnitArithmeticFactorizationWholeHistorySolutionCarrier.carrierReversal
        seedOccurrence.root stage (integralLocalValue stage value) := by
  have restriction := congrArg
    (fun arrow : limit (solutionDiagram seedOccurrence.root) ⟶
        (solutionDiagram seedOccurrence.root).obj (Opposite.op stage) =>
      (arrow.f 0).hom value)
    (limMap_π (integralReversalNatTrans seedOccurrence.root)
      (Opposite.op stage))
  exact restriction

theorem globalIntegralInclusion_local (stage : Nat)
    (value : IntegralGlobalCarrier) :
    vertexRestriction stage (integralGlobalInclusion value) =
      localVertexEmbedding seedOccurrence.root stage
        (integralLocalValue stage value) := by
  have restriction := congrArg
    (fun arrow : limit (solutionDiagram seedOccurrence.root) ⟶
        (localRelationDiagram seedOccurrence.root).obj (Opposite.op stage) =>
      (arrow.f 0).hom value)
    (limMap_π (embeddingNatTrans seedOccurrence.root)
      (Opposite.op stage))
  exact restriction

/-- Frozen cofinal rigidity makes the whole dual pair of every integral
global solution fixed. -/
theorem integralLocalAntiInvariant_wholeRole_eq_zero
    (stage : Nat) (value : IntegralGlobalCarrier) :
    roleRead seedOccurrence.root stage none
        (integralLocalValue stage
          (value - integralGlobalReversalLinear value)) = 0 := by
  funext dualIndex
  rw [map_sub, integralLocalValue_reversal]
  have fixed :=
    CanonicalUnitArithmeticFactorizationWholeHistorySolutionCofinalRigidity.everyLocalWholeDifference_eq_zero
      stage value
  have localEquality :
      integralLocalValue stage value =
        CanonicalUnitArithmeticFactorizationWholeHistorySolutionCofinalRigidity.localValue
          stage value :=
    LinearMap.congr_fun (integralLocalValue_eq_frameworkLocalValue stage) value
  have fixedUnfolded := fixed
  unfold localWholeDifference at fixedUnfolded
  fin_cases dualIndex
  · change
      wholeCoordinate seedOccurrence.root stage 0 (integralLocalValue stage value) -
        wholeCoordinate seedOccurrence.root stage 1
          (integralLocalValue stage value) = 0
    rw [localEquality]
    exact fixedUnfolded
  · change
      wholeCoordinate seedOccurrence.root stage 1 (integralLocalValue stage value) -
        wholeCoordinate seedOccurrence.root stage 0
          (integralLocalValue stage value) = 0
    have fixed' :
        wholeCoordinate seedOccurrence.root stage 0
              (integralLocalValue stage value) =
          wholeCoordinate seedOccurrence.root stage 1
              (integralLocalValue stage value) := by
      rw [localEquality]
      exact sub_eq_zero.mp fixedUnfolded
    exact sub_eq_zero.mpr fixed'.symm

def scalarAntiInvariantOperator : IntegralScalarCarrier →ₗ[ℤ]
    IntegralScalarCarrier :=
  LinearMap.id - integralScalarReversal

def localIntegralWholeMap (stage : Nat) :
    IntegralScalarCarrier →ₗ[ℤ] LocalScalarInner stage :=
  (localWholeComponent stage).comp
    ((localTensorRestriction stage).comp integralScalarInclusion)

def localIntegralAntiInvariantWholeMap (stage : Nat) :
    IntegralScalarCarrier →ₗ[ℤ] LocalScalarInner stage :=
  (localIntegralWholeMap stage).comp scalarAntiInvariantOperator

/-- Base change preserves the framework-generated integral fixedness; it
cannot create a new nonzero whole anti-invariant component. -/
theorem localIntegralAntiInvariantWholeMap_eq_zero
    (stage : Nat) (value : IntegralScalarCarrier) :
    localIntegralAntiInvariantWholeMap stage value = 0 := by
  induction value using TensorProduct.induction_on with
  | zero => simp
  | tmul coefficient integral =>
      simp only [localIntegralAntiInvariantWholeMap, LinearMap.comp_apply,
        scalarAntiInvariantOperator, LinearMap.sub_apply, LinearMap.id_apply,
        integralScalarReversal, TensorProduct.map_tmul,
        ← TensorProduct.tmul_sub, localIntegralWholeMap,
        integralScalarInclusion, localTensorRestriction,
        localWholeComponent, TensorProduct.map_tmul]
      change
        (coefficientRestriction stage coefficient) ⊗ₜ[ℤ]
          wholeProjection stage
            (vertexRestriction stage
              (integralGlobalInclusion
                (integral - integralGlobalReversalLinear integral))) = 0
      rw [globalIntegralInclusion_local]
      change
        (coefficientRestriction stage coefficient) ⊗ₜ[ℤ]
          localInnerEmbedding seedOccurrence.root stage
            (roleRead seedOccurrence.root stage none
              (integralLocalValue stage
                (integral - integralGlobalReversalLinear integral))) = 0
      rw [integralLocalAntiInvariant_wholeRole_eq_zero, map_zero,
        TensorProduct.tmul_zero]
  | add left right left_ih right_ih =>
      rw [map_add, left_ih, right_ih, add_zero]

/-- The final fixed component is generated by the existing integral
cofinal/prime-power rigidity consumer, not by the determinant kernel field. -/
theorem universalWholeAntiInvariant_eq_zero
    (stage : Nat) (value : IntegralFirstUniversalKernel) :
    localWholeComponent stage
        (localTensorRestriction stage
          (universalInclusion (antiInvariantDifference value))) = 0 := by
  exact localIntegralAntiInvariantWholeMap_eq_zero stage value.1

def universalOccurrence : RootedAccountedUnfolding
    (FactorizationPayload ×
      (IntegralFirstUniversalKernel →ₗ[ℤ] ScalarVertex)) :=
  seedOccurrence.map fun owner => (owner, universalInclusion)

theorem universalOccurrence_projects :
    universalOccurrence.map Prod.fst = seedOccurrence := by
  unfold universalOccurrence
  rw [RootedAccountedUnfolding.map_map]
  change seedOccurrence.map id = seedOccurrence
  exact RootedAccountedUnfolding.map_id _

theorem preserves_D_integral_generation_reversal_and_fixed_whole :
    universalOccurrence.map Prod.fst = seedOccurrence ∧
      (∀ value : IntegralFirstUniversalKernel,
        integralFirstEulerOperator value.1 = 0) ∧
      Function.Involutive kernelReversal ∧
      (∀ stage value,
        localWholeComponent stage
            (localTensorRestriction stage
              (universalInclusion (antiInvariantDifference value))) = 0) := by
  exact ⟨universalOccurrence_projects,
    fun value => LinearMap.mem_ker.mp value.2,
    kernelReversal_involutive,
    universalWholeAntiInvariant_eq_zero⟩

end
