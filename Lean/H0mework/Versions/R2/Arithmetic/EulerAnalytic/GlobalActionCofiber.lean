import Mathlib.Algebra.Category.ModuleCat.ChangeOfRings
import H0mework.Realization.MappingCone.Functoriality
import H0mework.Versions.R2.Arithmetic.EulerDualBlock.LinearGlobalEndpointSection
import H0mework.Versions.R2.Arithmetic.EulerDualBlock.DeterminantLineCoordinate
import H0mework.Realization.Arithmetic.DerivedAdicCofiber
import H0mework.Realization.MappingCone.HomotopyDescent

/-!
# Pair-analytic base change of the global block action cofiber

The source-generated block-linear global carrier is extended once along the
installed common-frame coefficient map into the pair analytic principal
quotient.
The frozen derived-cofiber engine then consumes `1-M` on that same global
state.  The source-owned endpoints and their actual boundary are carried
through this base change; no point, cycle, or fixedness is submitted.  This
action base change does not assert that the analytic quotient is the formal
block determinant zero fibre.
-/

set_option autoImplicit false
set_option maxHeartbeats 3000000
set_option backward.isDefEq.respectTransparency false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace CanonicalUnitArithmeticFactorizationFullEulerWholePrimeDualBlockAnalyticGlobalActionCofiber

open CanonicalUnitArithmeticFactorizationEulerDependentDiagram
open CanonicalUnitArithmeticFactorizationFullEulerWholePrimeDualBlockFrame
open CanonicalUnitArithmeticFactorizationFullEulerWholePrimeDualBlockDeterminantSection
open CanonicalUnitArithmeticFactorizationFullEulerWholePrimeDualBlockLinearGlobalAction
open CanonicalUnitArithmeticFactorizationFullEulerWholePrimeDualBlockLinearGlobalEndpointSection
open CanonicalUnitArithmeticFactorizationWholePrimeDualBlockDeterminantLineCoordinate
open CochainMappingCoconeFunctoriality
open MappingCoconeHomotopyDescent
open CategoryTheory
open DerivedAdicCofiber
open scoped ChangeOfRings

noncomputable section

abbrev PairCoefficientRing := AnalyticZeroFiberRing installedOwner

def pairFunctionToZeroFiber : PairFunctionRing →+* PairCoefficientRing :=
  Ideal.Quotient.mk (analyticZeroIdeal installedOwner)

/-- The installed action base-change map, generated by the common block
evaluation and the analytic principal quotient.  It is not a formal
determinant-zero specialization. -/
def blockCoordinateToPairZeroFiber :
    BlockCoordinateRing →+* PairCoefficientRing :=
  pairFunctionToZeroFiber.comp installedBlockEvaluation

@[simp] theorem blockCoordinateToPairZeroFiber_A (prime : Nat.Primes) :
    blockCoordinateToPairZeroFiber (blockA prime) =
      pairFunctionToZeroFiber
        (fun pair => installedPairAverage prime pair) := by
  change pairFunctionToZeroFiber
      (installedBlockEvaluation (blockA prime)) = _
  apply congrArg pairFunctionToZeroFiber
  funext pair
  exact installedBlockEvaluation_A prime pair

@[simp] theorem blockCoordinateToPairZeroFiber_B (prime : Nat.Primes) :
    blockCoordinateToPairZeroFiber (blockB prime) =
      pairFunctionToZeroFiber
        (fun pair => installedPairDifference prime pair) := by
  change pairFunctionToZeroFiber
      (installedBlockEvaluation (blockB prime)) = _
  apply congrArg pairFunctionToZeroFiber
  funext pair
  exact installedBlockEvaluation_B prime pair

theorem blockCoordinateToPairZeroFiber_A_add_B (prime : Nat.Primes) :
    blockCoordinateToPairZeroFiber (blockA prime + blockB prime) =
      pairFunctionToZeroFiber
        (fun pair => installedPrimeEigenvalue prime pair.1) := by
  rw [map_add, blockCoordinateToPairZeroFiber_A,
    blockCoordinateToPairZeroFiber_B, ← map_add]
  apply congrArg pairFunctionToZeroFiber
  funext pair
  simp only [Pi.add_apply]
  unfold installedPairAverage installedPairDifference
  ring

theorem blockCoordinateToPairZeroFiber_A_sub_B (prime : Nat.Primes) :
    blockCoordinateToPairZeroFiber (blockA prime - blockB prime) =
      pairFunctionToZeroFiber
        (fun pair => installedPrimeEigenvalue prime pair.2) := by
  rw [map_sub, blockCoordinateToPairZeroFiber_A,
    blockCoordinateToPairZeroFiber_B, ← map_sub]
  apply congrArg pairFunctionToZeroFiber
  funext pair
  simp only [Pi.sub_apply]
  unfold installedPairAverage installedPairDifference
  ring

abbrev PairBlockExtensionFunctor :=
  (ModuleCat.extendScalars
      blockCoordinateToPairZeroFiber).mapHomologicalComplex
    (ComplexShape.up ℤ)

noncomputable abbrev PairBlockGlobalState :
    IntegralCochainComplex PairCoefficientRing :=
  PairBlockExtensionFunctor.obj BlockLinearGlobalState

noncomputable def blockLinearGlobalEulerOperator :
    BlockLinearGlobalState ⟶ BlockLinearGlobalState :=
  𝟙 _ - blockLinearGlobalEulerAction

theorem blockLinearGlobalReversal_operator_square :
    blockLinearGlobalReversal ≫ blockLinearGlobalEulerOperator =
      blockLinearGlobalEulerOperator ≫ blockLinearGlobalReversal := by
  unfold blockLinearGlobalEulerOperator
  rw [Preadditive.comp_sub, Preadditive.sub_comp,
    Category.comp_id, Category.id_comp,
    blockLinearGlobalEuler_reversal_commutes]

noncomputable def pairBlockGlobalEulerOperator :
    PairBlockGlobalState ⟶ PairBlockGlobalState :=
  PairBlockExtensionFunctor.map blockLinearGlobalEulerOperator

noncomputable def pairBlockGlobalReversal :
    PairBlockGlobalState ⟶ PairBlockGlobalState :=
  PairBlockExtensionFunctor.map blockLinearGlobalReversal

theorem pairBlockGlobalReversal_operator_square :
    pairBlockGlobalReversal ≫ pairBlockGlobalEulerOperator =
      pairBlockGlobalEulerOperator ≫ pairBlockGlobalReversal := by
  unfold pairBlockGlobalReversal pairBlockGlobalEulerOperator
  rw [← Functor.map_comp, ← Functor.map_comp,
    blockLinearGlobalReversal_operator_square]

def pairBlockGlobalStateOccurrence : RootedAccountedUnfolding
    (IntegralCochainComplex PairCoefficientRing) :=
  seedOccurrence.map fun _owner => PairBlockGlobalState

def pairBlockGlobalEulerOperatorOccurrence : RootedAccountedUnfolding
    (pairBlockGlobalStateOccurrence.root ⟶
      pairBlockGlobalStateOccurrence.root) :=
  seedOccurrence.map fun _owner => pairBlockGlobalEulerOperator

def pairBlockGlobalActionCofiberFace : RootGeneratedDerivedAdicCofiberAt
    seedOccurrence pairBlockGlobalStateOccurrence
      pairBlockGlobalStateOccurrence
      pairBlockGlobalEulerOperatorOccurrence :=
  RootGeneratedDerivedAdicCofiberAt.generate

noncomputable abbrev PairBlockActionCofiber :
    IntegralCochainComplex PairCoefficientRing :=
  pairBlockGlobalActionCofiberFace.cofiberComplex

noncomputable def pairBlockTautologicalInclusion :
    CochainComplex.HomComplex.Cocycle
      PairBlockGlobalState PairBlockActionCofiber 1 :=
  CochainComplex.mappingCocone.inr pairBlockGlobalEulerOperator

noncomputable def pairBlockCofiberReversal :
    PairBlockActionCofiber ⟶ PairBlockActionCofiber :=
  mappingCoconeMap pairBlockGlobalEulerOperator pairBlockGlobalEulerOperator
    pairBlockGlobalReversal pairBlockGlobalReversal
      pairBlockGlobalReversal_operator_square

def pairBlockGlobalEndpointSection : PairBlockGlobalState.X 0 :=
  universalLeftCoordinate installedOwner
      ⊗ₜ[BlockCoordinateRing, blockCoordinateToPairZeroFiber]
        globalBlockLeftEndpoint +
    universalRightCoordinate installedOwner
      ⊗ₜ[BlockCoordinateRing, blockCoordinateToPairZeroFiber]
        globalBlockRightEndpoint

theorem pairBlockGlobalReversal_endpointSection :
    (pairBlockGlobalReversal.f 0).hom pairBlockGlobalEndpointSection =
      universalLeftCoordinate installedOwner
          ⊗ₜ[BlockCoordinateRing, blockCoordinateToPairZeroFiber]
            globalBlockRightEndpoint +
        universalRightCoordinate installedOwner
          ⊗ₜ[BlockCoordinateRing, blockCoordinateToPairZeroFiber]
            globalBlockLeftEndpoint := by
  simp only [pairBlockGlobalEndpointSection, map_add,
    pairBlockGlobalReversal, PairBlockExtensionFunctor,
    Functor.mapHomologicalComplex_map_f]
  change
    (ModuleCat.extendScalars blockCoordinateToPairZeroFiber).map
          (blockLinearGlobalReversal.f 0)
          (universalLeftCoordinate installedOwner
            ⊗ₜ[BlockCoordinateRing, blockCoordinateToPairZeroFiber]
              globalBlockLeftEndpoint) +
        (ModuleCat.extendScalars blockCoordinateToPairZeroFiber).map
          (blockLinearGlobalReversal.f 0)
          (universalRightCoordinate installedOwner
            ⊗ₜ[BlockCoordinateRing, blockCoordinateToPairZeroFiber]
              globalBlockRightEndpoint) = _
  rw [ModuleCat.ExtendScalars.map_tmul,
    ModuleCat.ExtendScalars.map_tmul,
    globalBlockReversal_leftEndpoint,
    globalBlockReversal_rightEndpoint]

def pairBlockGlobalEndpointBoundary : PairBlockGlobalState.X 1 :=
  (PairBlockGlobalState.d 0 1).hom pairBlockGlobalEndpointSection

theorem pairBlockGlobalEndpointBoundary_is_actual :
    (PairBlockGlobalState.d 0 1).hom pairBlockGlobalEndpointSection =
      pairBlockGlobalEndpointBoundary :=
  rfl

def pairBlockEndpointCofiberOccurrence : RootedAccountedUnfolding
    (FactorizationPayload ×
      (PairBlockGlobalState.X 0 × PairBlockGlobalState.X 1)) :=
  seedOccurrence.map fun owner =>
    (owner, (pairBlockGlobalEndpointSection,
      pairBlockGlobalEndpointBoundary))

theorem pairBlockEndpointCofiberOccurrence_projects :
    pairBlockEndpointCofiberOccurrence.map Prod.fst = seedOccurrence := by
  unfold pairBlockEndpointCofiberOccurrence
  rw [RootedAccountedUnfolding.map_map]
  change seedOccurrence.map id = seedOccurrence
  exact RootedAccountedUnfolding.map_id _

theorem preserves_same_block_global_component_base_change_cofiber_and_boundary :
    pairBlockGlobalActionCofiberFace.root = seedOccurrence ∧
      pairBlockGlobalActionCofiberFace.actualTransition =
        pairBlockGlobalEulerOperator ∧
      pairBlockEndpointCofiberOccurrence.map Prod.fst = seedOccurrence ∧
      (PairBlockGlobalState.d 0 1).hom pairBlockGlobalEndpointSection =
        pairBlockGlobalEndpointBoundary := by
  exact ⟨pairBlockGlobalActionCofiberFace.preserves_actual_transition.1,
    rfl, pairBlockEndpointCofiberOccurrence_projects, rfl⟩

end
end CanonicalUnitArithmeticFactorizationFullEulerWholePrimeDualBlockAnalyticGlobalActionCofiber
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
