import H0mework.Realization.Graph.CokernelSemilinearNaturality
import H0mework.Versions.R2.Arithmetic.SonineCoupling.ConjugateTateMuntzRelationNaturality

/-!
# Actual conjugate--Tate graph-source morphism

The existing conjugate--Tate map on quarter Mellin tests, its actual
Schwartz relation square, pointwise conjugation on the energy carrier, and
Tate reflection generate one semilinear graph-source morphism.  The target is
the generated high chart at `1/2 - conj z`; it is not identified here with an
independently chosen reversal-low value.
-/

set_option autoImplicit false
set_option maxHeartbeats 3000000

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalRiemann
namespace ClozelGeneralizedDual

open Complex MeasureTheory
open SourceGeneratedFunctionalGraphPerfectification
open SourceGeneratedFunctionalGraphCokernel
open scoped ENNReal SchwartzMap

noncomputable section

/-- The parameter of the high chart generated by conjugate--Tate transport. -/
abbrev conjugateTateMellinParameter (z : ℂ) : ℂ :=
  (1 / 2 : ℂ) - star z

theorem conjugateTateMellinParameter_re_pos
    (z : ℂ) (belowHalf : z.re < (1 / 2 : ℝ)) :
    0 < (conjugateTateMellinParameter z).re := by
  simp [conjugateTateMellinParameter]
  linarith

theorem conjugateTateMellinParameter_re_lt_half
    (z : ℂ) (positive : 0 < z.re) :
    (conjugateTateMellinParameter z).re < (1 / 2 : ℝ) := by
  simp [conjugateTateMellinParameter]
  linarith

/-- Complex conjugation on the scalar graph coordinate. -/
def complexScalarConjugation : ℂ →L⋆[ℂ] ℂ :=
  (starL ℂ : ℂ ≃L⋆[ℂ] ℂ).toContinuousLinearMap

theorem complexScalarConjugation_isometry :
    Isometry complexScalarConjugation := by
  apply Isometry.of_dist_eq
  intro left right
  change dist (star left) (star right) = dist left right
  exact dist_star_star left right

/-- Pointwise complex conjugation on the actual quarter-energy carrier. -/
def positiveMellinQuarterEnergyConjugation :
    PositiveMellinQuarterEnergy →L⋆[ℂ] PositiveMellinQuarterEnergy :=
  complexScalarConjugation.compLpL
    (2 : ℝ≥0∞) (volume : Measure ℝ)

theorem positiveMellinQuarterEnergyConjugation_norm
    (value : PositiveMellinQuarterEnergy) :
    ‖positiveMellinQuarterEnergyConjugation value‖ = ‖value‖ := by
  rw [Lp.norm_def, Lp.norm_def]
  congr 1
  apply eLpNorm_congr_norm_ae
  filter_upwards [complexScalarConjugation.coeFn_compLpL value] with x hx
  change ‖((complexScalarConjugation.compLpL
      (2 : ℝ≥0∞) (volume : Measure ℝ)) value) x‖ = ‖value x‖
  rw [hx]
  exact norm_star (value x)

theorem positiveMellinQuarterEnergyConjugation_isometry :
    Isometry positiveMellinQuarterEnergyConjugation := by
  apply Isometry.of_dist_eq
  intro left right
  rw [dist_eq_norm, dist_eq_norm, ← map_sub,
    positiveMellinQuarterEnergyConjugation_norm]

/-- Conjugation followed by the actual quarter-energy Tate reflection. -/
def positiveMellinQuarterEnergyConjugateTate :
    PositiveMellinQuarterEnergy →L⋆[ℂ] PositiveMellinQuarterEnergy :=
  positiveMellinQuarterEnergyReflectionIsometry.toLinearIsometry.toContinuousLinearMap.comp
    positiveMellinQuarterEnergyConjugation

theorem positiveMellinQuarterEnergyConjugateTate_isometry :
    Isometry positiveMellinQuarterEnergyConjugateTate :=
  positiveMellinQuarterEnergyReflectionIsometry.isometry.comp
    positiveMellinQuarterEnergyConjugation_isometry

/-- The quarter-energy feature of a conjugated test is pointwise conjugate
to the original feature. -/
theorem quarterMellinL2Feature_conjugate
    (z : ℂ) (value : QuarterMellinL2Test z) :
    quarterMellinL2Feature (star z)
        (conjugateQuarterMellinTest z value) =
      positiveMellinQuarterEnergyConjugation
        (quarterMellinL2Feature z value) := by
  apply Lp.ext
  filter_upwards [
    MemLp.coeFn_toLp (conjugateQuarterMellinTest z value).2.1,
    complexScalarConjugation.coeFn_compLpL
      (quarterMellinL2Feature z value),
    MemLp.coeFn_toLp value.2.1] with x hleft hstar hsource
  change ((conjugateQuarterMellinTest z value).2.1.toLp
      (positiveMellinLogQuarterTransform
        (conjugateQuarterMellinTest z value).1)) x =
    ((complexScalarConjugation.compLpL
      (2 : ℝ≥0∞) (volume : Measure ℝ))
      (quarterMellinL2Feature z value)) x
  rw [hleft, hstar]
  change positiveMellinLogQuarterTransform
      (conjugateQuarterMellinTest z value).1 x =
    complexScalarConjugation
      ((value.2.1.toLp
        (positiveMellinLogQuarterTransform value.1)) x)
  rw [hsource]
  change (Real.exp (x / 4) : ℂ) * star (value.1
      ⟨Real.exp x, Real.exp_pos x⟩) =
    star ((Real.exp (x / 4) : ℂ) * value.1
      ⟨Real.exp x, Real.exp_pos x⟩)
  rw [star_mul, Complex.star_def, Complex.conj_ofReal]
  ring

private def conjugateQuarterMellinL2
    (z : ℂ) (value : QuarterMellinL2Test z) :
    PositiveMellinQuarterL2 :=
  ⟨positiveMellinPointwiseConjugation value.1,
    (conjugateQuarterMellinTest z value).2.1⟩

/-- The source semilinear map and the Hilbert conjugate--Tate map form the
actual feature square. -/
theorem quarterMellinL2Feature_conjugateTate
    (z : ℂ) (value : QuarterMellinL2Test z) :
    positiveMellinQuarterEnergyConjugateTate
        (quarterMellinL2Feature z value) =
      quarterMellinL2Feature (conjugateTateMellinParameter z)
        (conjugateTateQuarterMellinTest z value) := by
  calc
    positiveMellinQuarterEnergyConjugateTate
        (quarterMellinL2Feature z value) =
        positiveMellinQuarterEnergyReflection
          (positiveMellinQuarterEnergyConjugation
            (quarterMellinL2Feature z value)) := rfl
    _ = positiveMellinQuarterEnergyReflection
          (positiveMellinQuarterLpValue
            (conjugateQuarterMellinL2 z value)) := by
      congr 1
      symm
      change quarterMellinL2Feature (star z)
          (conjugateQuarterMellinTest z value) =
        positiveMellinQuarterEnergyConjugation
          (quarterMellinL2Feature z value)
      exact quarterMellinL2Feature_conjugate z value
    _ = positiveMellinQuarterLpValue
          (positiveMellinQuarterL2Tate
            (conjugateQuarterMellinL2 z value)) := by
      exact (positiveMellinQuarterLpValue_tate
        (conjugateQuarterMellinL2 z value)).symm
    _ = quarterMellinL2Feature (conjugateTateMellinParameter z)
          (conjugateTateQuarterMellinTest z value) := rfl

/-- The actual selected-low to generated-high semilinear graph-relation
morphism.  Its relation map is Fourier after Schwartz conjugation. -/
def conjugateTateRelationGraphSourceMorphism
    (z : ℂ) (positive : 0 < z.re)
    (belowHalf : z.re < (1 / 2 : ℝ)) :
    SemilinearRelationGraphSourceMorphism (starRingEnd ℂ)
      (quarterMellinL2Feature z)
      (quarterMellinL2Functional z)
      (coPoissonQuarterMellinConvergentMap z positive belowHalf)
      (quarterMellinL2Feature (conjugateTateMellinParameter z))
      (quarterMellinL2Functional (conjugateTateMellinParameter z))
      (coPoissonQuarterMellinConvergentMap
        (conjugateTateMellinParameter z)
        (conjugateTateMellinParameter_re_pos z belowHalf)
        (conjugateTateMellinParameter_re_lt_half z positive)) where
  graphMorphism := {
    sourceMap := conjugateTateQuarterMellinTest z
    hilbertMap := positiveMellinQuarterEnergyConjugateTate
    scalarMap := complexScalarConjugation
    feature_commutes := quarterMellinL2Feature_conjugateTate z
    functional_commutes := by
      intro value
      exact (conjugateTateQuarterMellinTest_functional z value).symm }
  relationMap := schwartzTateConjugation
  relation_commutes := by
    intro test
    exact conjugateTateQuarterMellinTest_relation
      z positive belowHalf test

theorem conjugateTateRelationGraphSourceMorphism_graph_isometry
    (z : ℂ) (positive : 0 < z.re)
    (belowHalf : z.re < (1 / 2 : ℝ)) :
    Isometry (semilinearGraphCompletionMap
      (conjugateTateRelationGraphSourceMorphism
        z positive belowHalf).graphMorphism) :=
  semilinearGraphCompletionMap_isometry _
    positiveMellinQuarterEnergyConjugateTate_isometry
    complexScalarConjugation_isometry

end

