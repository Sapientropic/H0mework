import H0mework.Versions.R2.Arithmetic.RiemannLineage.LineagePoint
import H0mework.Versions.R2.Arithmetic.EulerDerived.PointActualDatum

/-!
# The q-rich source lineage on the corrected derived solution

The factorial transition already carried by the q-rich source line is shifted
to degree one and mapped into the existing corrected endpoint fibre.  Its
endpoint cochain is the literal total-fibre image of the strict q-rich cycle,
so the resulting derived point has zero strict-source coordinate and remains
strictly natural under the actual source successor.

No analytic point, fixedness law, endpoint equality, or completed lineage is
used here.
-/

set_option autoImplicit false
set_option maxHeartbeats 3000000
set_option backward.isDefEq.respectTransparency false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalRiemann
namespace QRich

open CategoryTheory
open CategoryTheory.Limits
open CochainComplex.HomComplex
open CochainMappingCoconeMappedBoundaryAtomOver
open CanonicalUnitArithmeticFactorizationOccurrence
open CanonicalUnitArithmeticFactorizationEulerDependentDiagram
open CanonicalUnitArithmeticFactorizationFullEulerWholePrimeDualBlockFrame
open CanonicalUnitArithmeticFactorizationFullEulerWholePrimeDualBlockLinearGlobalEndpointSection
open CanonicalUnitArithmeticFactorizationFullEulerWholePrimeDualBlockWholeRelationDeterminant
open CanonicalUnitArithmeticFactorizationFullEulerWholePrimeDualBlockDerivedSolutionCofinal
open CanonicalUnitArithmeticFactorizationFullEulerWholePrimeDualBlockDerivedPointActualDatum
open CanonicalUnitArithmeticFactorizationFullEulerWholePrimeDualBlockWholeComplexAdjugateTotalFiber
open CanonicalUnitArithmeticFactorizationFullEulerWholePrimeDualBlockWholeComplexAdjugateTotalFiberEndpointAtom
open CanonicalUnitArithmeticFactorizationFullEulerWholePrimeDualBlockWholeComplexAdjugateTotalFiberSuccessor

noncomputable section

/-- The q-rich source lineage shifted to the degree carried by a corrected
derived point. -/
abbrev QRichLineageSingleOne :
    CochainComplex (ModuleCat BlockCoordinateRing) ℤ :=
  (CochainComplex.singleFunctor (ModuleCat BlockCoordinateRing) 1).obj
    BlockDualBaseObject

/-- The same source-generated factorial transition, now in degree one. -/
noncomputable def qRichLineageSingleOneRestriction (stage : Nat) :
    QRichLineageSingleOne ⟶ QRichLineageSingleOne :=
  (CochainComplex.singleFunctor (ModuleCat BlockCoordinateRing) 1).map
      (ModuleCat.ofHom
        ((blockQRichSuccessorScale stage : BlockCoordinateRing) •
          LinearMap.id))

/-- The literal total-fibre endpoint generated by the finite q-rich cycle. -/
def qRichLineageTotalEndpointMap (stage : Nat) :
    BlockDualBaseObject ⟶ (LocalTotalFiber stage).X 0 :=
  ModuleCat.ofHom (blockQRichEndpointVertexMap stage) ≫
    (localTotalInclusion stage).f 0

theorem qRichLineageTotalEndpointMap_d_zero (stage : Nat) :
    qRichLineageTotalEndpointMap stage ≫
        (LocalTotalFiber stage).d 0 1 = 0 := by
  calc
    qRichLineageTotalEndpointMap stage ≫
        (LocalTotalFiber stage).d 0 1 =
      ModuleCat.ofHom (blockQRichEndpointVertexMap stage) ≫
        ((localTotalInclusion stage).f 0 ≫
          (LocalTotalFiber stage).d 0 1) := by
      simp only [qRichLineageTotalEndpointMap, Category.assoc]
    _ = ModuleCat.ofHom (blockQRichEndpointVertexMap stage) ≫
        ((LocalWholeComplex stage).d 0 1 ≫
          (localTotalInclusion stage).f 1) := by
      rw [(localTotalInclusion stage).comm 0 1]
    _ = (ModuleCat.ofHom (blockQRichEndpointVertexMap stage) ≫
          (LocalWholeComplex stage).d 0 1) ≫
        (localTotalInclusion stage).f 1 :=
      (Category.assoc _ _ _).symm
    _ = 0 := by
      have sourceZero :
          ModuleCat.ofHom (blockQRichEndpointVertexMap stage) ≫
              (LocalWholeComplex stage).d 0 1 = 0 := by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro base
        exact blockQRichEndpointVertexMap_differential_zero stage base
      rw [sourceZero, Limits.zero_comp]

/-- The negative total endpoint is the complete shifted coordinate of the
q-rich derived-lineage point. -/
noncomputable def qRichLineageEndpointCochain (stage : Nat) :
    Cochain QRichLineageSingleOne (LocalTotalFiber stage) (-1) :=
  Cochain.fromSingleMk (-qRichLineageTotalEndpointMap stage) (by omega)

theorem qRichLineageEndpointCochain_delta (stage : Nat) :
    δ (-1) 0 (qRichLineageEndpointCochain stage) = 0 := by
  unfold qRichLineageEndpointCochain
  rw [Cochain.δ_fromSingleMk _ _ 0 1 (by omega)]
  rw [Preadditive.neg_comp,
    qRichLineageTotalEndpointMap_d_zero, neg_zero]
  exact Cochain.fromSingleMk_zero BlockDualBaseObject
    (LocalTotalFiber stage) 1 1 0 (by omega)

theorem qRichDerivedLineagePoint_compatibility (stage : Nat) :
    δ (-1) 0 (qRichLineageEndpointCochain stage) +
        Cochain.ofHom
          ((0 : QRichLineageSingleOne ⟶ LocalWholeComplex stage) ≫
            localTotalInclusion stage) = 0 := by
  rw [qRichLineageEndpointCochain_delta, Limits.zero_comp,
    Cochain.ofHom_zero, add_zero]

/-- The source-lineage point in the existing corrected derived solution. -/
noncomputable def qRichDerivedLineagePoint (stage : Nat) :
    QRichLineageSingleOne ⟶ LocalDerivedSolution stage :=
  CochainComplex.mappingCocone.lift
    (localTotalInclusion stage)
    0 (qRichLineageEndpointCochain stage)
    (qRichDerivedLineagePoint_compatibility stage)

@[reassoc (attr := simp)] theorem qRichDerivedLineagePoint_fst
    (stage : Nat) :
    qRichDerivedLineagePoint stage ≫
        CochainComplex.mappingCocone.fst (localTotalInclusion stage) = 0 := by
  exact CochainComplex.mappingCocone.lift_fst _ _ _ _

theorem qRichDerivedLineagePoint_snd (stage : Nat)
    (degree previous : ℤ) (degreePrevious : degree + (-1) = previous) :
    (qRichDerivedLineagePoint stage).f degree ≫
        (CochainComplex.mappingCocone.snd
          (localTotalInclusion stage)).v
            degree previous degreePrevious =
      (qRichLineageEndpointCochain stage).v
        degree previous degreePrevious := by
  exact CochainComplex.mappingCocone.lift_f_snd_v
    (localTotalInclusion stage)
    (0 : QRichLineageSingleOne ⟶ LocalWholeComplex stage)
    (qRichLineageEndpointCochain stage)
    (qRichDerivedLineagePoint_compatibility stage)
    degree previous degreePrevious

theorem qRichLineageTotalEndpointMap_successor (stage : Nat) :
    qRichLineageTotalEndpointMap (stage + 1) ≫
        (localTotalFiberRestriction stage).f 0 =
      ModuleCat.ofHom
          ((blockQRichSuccessorScale stage : BlockCoordinateRing) •
            LinearMap.id) ≫
        qRichLineageTotalEndpointMap stage := by
  have inclusionDegree := congrArg (fun arrow => arrow.f 0)
    (localTotalInclusion_successor stage)
  simp only [HomologicalComplex.comp_f] at inclusionDegree
  have endpointDegree :
      ModuleCat.ofHom (blockQRichEndpointVertexMap (stage + 1)) ≫
          (blockDirectRestriction seedOccurrence.root stage).f 0 =
        ModuleCat.ofHom
            ((blockQRichSuccessorScale stage : BlockCoordinateRing) •
              LinearMap.id) ≫
          ModuleCat.ofHom (blockQRichEndpointVertexMap stage) := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro base
    have generated := LinearMap.congr_fun
      (blockQRichEndpointVertexMap_restriction_scale stage) base
    simpa [blockDirectRestriction, BlockDirectObject] using generated
  unfold qRichLineageTotalEndpointMap
  calc
    (ModuleCat.ofHom (blockQRichEndpointVertexMap (stage + 1)) ≫
        (localTotalInclusion (stage + 1)).f 0) ≫
          (localTotalFiberRestriction stage).f 0 =
      ModuleCat.ofHom (blockQRichEndpointVertexMap (stage + 1)) ≫
        ((localTotalInclusion (stage + 1)).f 0 ≫
          (localTotalFiberRestriction stage).f 0) := Category.assoc _ _ _
    _ = ModuleCat.ofHom (blockQRichEndpointVertexMap (stage + 1)) ≫
        ((blockDirectRestriction seedOccurrence.root stage).f 0 ≫
          (localTotalInclusion stage).f 0) := by rw [inclusionDegree]
    _ = (ModuleCat.ofHom (blockQRichEndpointVertexMap (stage + 1)) ≫
          (blockDirectRestriction seedOccurrence.root stage).f 0) ≫
        (localTotalInclusion stage).f 0 := (Category.assoc _ _ _).symm
    _ = (ModuleCat.ofHom
          ((blockQRichSuccessorScale stage : BlockCoordinateRing) •
            LinearMap.id) ≫
          ModuleCat.ofHom (blockQRichEndpointVertexMap stage)) ≫
        (localTotalInclusion stage).f 0 := by rw [endpointDegree]
    _ = ModuleCat.ofHom
          ((blockQRichSuccessorScale stage : BlockCoordinateRing) •
            LinearMap.id) ≫
        (ModuleCat.ofHom (blockQRichEndpointVertexMap stage) ≫
          (localTotalInclusion stage).f 0) := Category.assoc _ _ _

theorem qRichLineageEndpointCochain_successor (stage : Nat) :
    (qRichLineageEndpointCochain (stage + 1)).comp
        (Cochain.ofHom (localTotalFiberRestriction stage))
          (add_zero (-1)) =
      (Cochain.ofHom (qRichLineageSingleOneRestriction stage)).comp
        (qRichLineageEndpointCochain stage) (zero_add (-1)) := by
  unfold qRichLineageEndpointCochain
  unfold QRichLineageSingleOne
  rw [← Cochain.fromSingleMk_postcomp]
  unfold qRichLineageSingleOneRestriction
  rw [← Cochain.fromSingleMk_precomp]
  rw [Preadditive.neg_comp, Preadditive.comp_neg,
    qRichLineageTotalEndpointMap_successor]

/-- The derived-lineage point is strictly natural under the actual corrected
endpoint successor. -/
theorem qRichDerivedLineagePoint_successor (stage : Nat) :
    qRichDerivedLineagePoint (stage + 1) ≫
        localCorrectedEndpointRestriction stage =
      qRichLineageSingleOneRestriction stage ≫
        qRichDerivedLineagePoint stage := by
  apply HomologicalComplex.Hom.ext
  funext degree
  apply CochainMappingCoconeDegreewiseKernel.degree_hom_ext
    (localTotalInclusion stage) degree
  · have leftFst := congrArg (fun arrow => arrow.f degree)
      (qRichDerivedLineagePoint_fst (stage + 1))
    have rightFst := congrArg (fun arrow => arrow.f degree)
      (qRichDerivedLineagePoint_fst stage)
    have transitionFst := congrArg (fun arrow => arrow.f degree)
      (localCorrectedEndpointRestriction_fst stage)
    simp only [HomologicalComplex.comp_f, HomologicalComplex.zero_f]
      at leftFst rightFst
    simp only [HomologicalComplex.comp_f] at transitionFst ⊢
    calc
      ((qRichDerivedLineagePoint (stage + 1)).f degree ≫
          (localCorrectedEndpointRestriction stage).f degree) ≫
          (CochainComplex.mappingCocone.fst
            (localTotalInclusion stage)).f degree =
        (qRichDerivedLineagePoint (stage + 1)).f degree ≫
          ((localCorrectedEndpointRestriction stage).f degree ≫
            (CochainComplex.mappingCocone.fst
              (localTotalInclusion stage)).f degree) :=
        Category.assoc _ _ _
      _ = (qRichDerivedLineagePoint (stage + 1)).f degree ≫
          ((CochainComplex.mappingCocone.fst
              (localTotalInclusion (stage + 1))).f degree ≫
            (blockDirectRestriction seedOccurrence.root stage).f degree) := by
        rw [transitionFst]
      _ = ((qRichDerivedLineagePoint (stage + 1)).f degree ≫
          (CochainComplex.mappingCocone.fst
            (localTotalInclusion (stage + 1))).f degree) ≫
            (blockDirectRestriction seedOccurrence.root stage).f degree :=
        (Category.assoc _ _ _).symm
      _ = 0 := by rw [leftFst, Limits.zero_comp]
      _ = (qRichLineageSingleOneRestriction stage).f degree ≫ 0 := by
        simp
      _ = (qRichLineageSingleOneRestriction stage).f degree ≫
          ((qRichDerivedLineagePoint stage).f degree ≫
            (CochainComplex.mappingCocone.fst
              (localTotalInclusion stage)).f degree) := by
        rw [rightFst]
      _ = ((qRichLineageSingleOneRestriction stage).f degree ≫
          (qRichDerivedLineagePoint stage).f degree) ≫
            (CochainComplex.mappingCocone.fst
              (localTotalInclusion stage)).f degree :=
        (Category.assoc _ _ _).symm
  · let previous := degree + (-1)
    have transitionSnd := Cochain.congr_v
      (localCorrectedEndpointRestriction_snd stage)
      degree previous rfl
    have endpointSuccessor := Cochain.congr_v
      (qRichLineageEndpointCochain_successor stage)
      degree previous rfl
    have highSnd := qRichDerivedLineagePoint_snd
      (stage + 1) degree previous rfl
    have lowSnd := qRichDerivedLineagePoint_snd
      stage degree previous rfl
    have transitionSndComponent :
        (localCorrectedEndpointRestriction stage).f degree ≫
            (CochainComplex.mappingCocone.snd
              (localTotalInclusion stage)).v degree previous rfl =
          (CochainComplex.mappingCocone.snd
              (localTotalInclusion (stage + 1))).v degree previous rfl ≫
            (localTotalFiberRestriction stage).f previous := by
      simpa [Cochain.comp_v] using transitionSnd
    have endpointSuccessorComponent :
        (qRichLineageEndpointCochain (stage + 1)).v
              degree previous rfl ≫
            (localTotalFiberRestriction stage).f previous =
          (qRichLineageSingleOneRestriction stage).f degree ≫
            (qRichLineageEndpointCochain stage).v
              degree previous rfl := by
      simpa [Cochain.comp_v] using endpointSuccessor
    simp only [HomologicalComplex.comp_f]
    calc
      ((qRichDerivedLineagePoint (stage + 1)).f degree ≫
          (localCorrectedEndpointRestriction stage).f degree) ≫
          (CochainComplex.mappingCocone.snd
            (localTotalInclusion stage)).v degree previous rfl =
        (qRichDerivedLineagePoint (stage + 1)).f degree ≫
          ((localCorrectedEndpointRestriction stage).f degree ≫
            (CochainComplex.mappingCocone.snd
              (localTotalInclusion stage)).v degree previous rfl) :=
        Category.assoc _ _ _
      _ = (qRichDerivedLineagePoint (stage + 1)).f degree ≫
          ((CochainComplex.mappingCocone.snd
              (localTotalInclusion (stage + 1))).v degree previous rfl ≫
            (localTotalFiberRestriction stage).f previous) := by
        rw [transitionSndComponent]
      _ = ((qRichDerivedLineagePoint (stage + 1)).f degree ≫
          (CochainComplex.mappingCocone.snd
            (localTotalInclusion (stage + 1))).v degree previous rfl) ≫
            (localTotalFiberRestriction stage).f previous :=
        (Category.assoc _ _ _).symm
      _ = (qRichLineageEndpointCochain (stage + 1)).v
            degree previous rfl ≫
          (localTotalFiberRestriction stage).f previous := by
        rw [highSnd]
      _ = (qRichLineageSingleOneRestriction stage).f degree ≫
          (qRichLineageEndpointCochain stage).v degree previous rfl :=
        endpointSuccessorComponent
      _ = (qRichLineageSingleOneRestriction stage).f degree ≫
          ((qRichDerivedLineagePoint stage).f degree ≫
            (CochainComplex.mappingCocone.snd
              (localTotalInclusion stage)).v degree previous rfl) := by
        rw [lowSnd]
      _ = ((qRichLineageSingleOneRestriction stage).f degree ≫
          (qRichDerivedLineagePoint stage).f degree) ≫
            (CochainComplex.mappingCocone.snd
              (localTotalInclusion stage)).v degree previous rfl :=
        (Category.assoc _ _ _).symm

/-- A source-owned base enters the shifted lineage through the canonical
span-singleton map. -/
noncomputable def qRichLineageBasePoint (base : BlockDualBase) :
    ScalarSingleOne (R := BlockCoordinateRing) ⟶ QRichLineageSingleOne :=
  (CochainComplex.singleFunctor (ModuleCat BlockCoordinateRing) 1).map
    (elementHom base)

theorem qRichLineageBasePoint_endpointCochain (stage : Nat)
    (base : BlockDualBase) :
    (Cochain.ofHom (qRichLineageBasePoint base)).comp
        (qRichLineageEndpointCochain stage) (zero_add (-1)) =
      negativeBoundaryCochain
        (localTotalEndpointElement stage
          (blockQRichEndpointVertexMap stage base)) := by
  unfold qRichLineageBasePoint qRichLineageEndpointCochain
  unfold QRichLineageSingleOne
  rw [← Cochain.fromSingleMk_precomp]
  unfold qRichLineageTotalEndpointMap negativeBoundaryCochain
  unfold boundaryGenerator localTotalEndpointElement
  rw [Preadditive.comp_neg, elementHom_comp]
  rfl

/-- Evaluating the source-owned lineage at one base is the already existing
literal q-rich derived point. -/
theorem qRichLineageBasePoint_comp_derivedPoint (stage : Nat)
    (base : BlockDualBase) :
    qRichLineageBasePoint base ≫ qRichDerivedLineagePoint stage =
      localQRichDerivedPoint stage base := by
  apply HomologicalComplex.Hom.ext
  funext degree
  apply CochainMappingCoconeDegreewiseKernel.degree_hom_ext
    (localTotalInclusion stage) degree
  · have lineageFst := congrArg (fun arrow => arrow.f degree)
      (qRichDerivedLineagePoint_fst stage)
    have localFst := congrArg (fun arrow => arrow.f degree)
      (localQRichDerivedPoint_strictSource_zero stage base)
    unfold localDerivedStrictSource at localFst
    simp only [HomologicalComplex.comp_f, HomologicalComplex.zero_f]
      at lineageFst localFst ⊢
    rw [Category.assoc, lineageFst, Limits.comp_zero, localFst]
  · let previous := degree + (-1)
    have lineageSnd := qRichDerivedLineagePoint_snd
      stage degree previous rfl
    have endpointBase := Cochain.congr_v
      (qRichLineageBasePoint_endpointCochain stage base)
      degree previous rfl
    have endpointBaseComponent :
        (qRichLineageBasePoint base).f degree ≫
            (qRichLineageEndpointCochain stage).v
              degree previous rfl =
          (negativeBoundaryCochain
            (localTotalEndpointElement stage
              (blockQRichEndpointVertexMap stage base))).v
                degree previous rfl := by
      simpa [Cochain.comp_v] using endpointBase
    have localSnd :
        (localQRichDerivedPoint stage base).f degree ≫
            (CochainComplex.mappingCocone.snd
              (localTotalInclusion stage)).v degree previous rfl =
          (negativeBoundaryCochain
            (localTotalEndpointElement stage
              (blockQRichEndpointVertexMap stage base))).v
                degree previous rfl := by
      simp [localQRichDerivedPoint, localCorrectedEndpointPoint,
        MappedBoundaryPointAt.ofPoint, mappedBoundaryAtom,
        localCorrectedEndpointPointAt]
    simp only [HomologicalComplex.comp_f]
    calc
      ((qRichLineageBasePoint base).f degree ≫
          (qRichDerivedLineagePoint stage).f degree) ≫
          (CochainComplex.mappingCocone.snd
            (localTotalInclusion stage)).v degree previous rfl =
        (qRichLineageBasePoint base).f degree ≫
          ((qRichDerivedLineagePoint stage).f degree ≫
            (CochainComplex.mappingCocone.snd
              (localTotalInclusion stage)).v degree previous rfl) :=
        Category.assoc _ _ _
      _ = (qRichLineageBasePoint base).f degree ≫
          (qRichLineageEndpointCochain stage).v
            degree previous rfl := by rw [lineageSnd]
      _ = (negativeBoundaryCochain
          (localTotalEndpointElement stage
            (blockQRichEndpointVertexMap stage base))).v
              degree previous rfl := endpointBaseComponent
      _ = (localQRichDerivedPoint stage base).f degree ≫
          (CochainComplex.mappingCocone.snd
            (localTotalInclusion stage)).v degree previous rfl := localSnd.symm

end
end QRich
end CanonicalRiemann
