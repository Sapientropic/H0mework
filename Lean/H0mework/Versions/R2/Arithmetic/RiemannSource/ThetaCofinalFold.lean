import Mathlib.NumberTheory.LSeries.HurwitzZetaEven
import H0mework.Versions.R2.Arithmetic.RiemannSource.ThetaZeroMode

/-!
# Cofinal fold of the canonical Riemann theta material

The exact runtime sequence supplies magnitudes `1, 2, ...`; each magnitude
has already generated both Gaussian orientations by a finite rooted fold.
Prepending the separately generated zero mode gives the full integer theta
kernel.  Mathlib's Hurwitz/Jacobi kernel is consumed only as the frozen
infinite-sum target.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalRiemann

open CanonicalUnitArithmeticFactorizationGlobalDeterminantCoordinateRealization
open scoped Topology

noncomputable section

def generatedRiemannThetaPatch (owner : GlobalGermOwner) (stage : Nat) :
    GeneratedFiniteThetaPatchAt owner :=
  GeneratedFiniteThetaPatchAt.generate owner stage

/-- At the actual owner, the cofinal consumer reads the literal payload of
the same finite-theta occurrence. -/
theorem generatedRiemannThetaPatch_eq_occurrence_root (stage : Nat) :
    generatedRiemannThetaPatch globalGermOccurrence.root stage =
      (finiteThetaOccurrence stage).root.2 := by
  rfl

def generatedRiemannThetaShell (owner : GlobalGermOwner) (stage : Nat) :
    GeneratedIntegerShellAt owner :=
  (generatedRiemannThetaPatch owner stage).shell

noncomputable def generatedRiemannThetaShellFold
    (owner : GlobalGermOwner) (t : ℝ) (stage : Nat) : ℝ :=
  (generatedRiemannThetaPatch owner stage).gaussianFold t

@[simp] theorem generatedRiemannThetaShellFold_eq
    (owner : GlobalGermOwner) (t : ℝ) (stage : Nat) :
    generatedRiemannThetaShellFold owner t stage =
      2 * Real.exp (-Real.pi * (stage + 1 : ℕ) ^ 2 * t) := by
  rw [generatedRiemannThetaShellFold, generatedRiemannThetaPatch,
    GeneratedFiniteThetaPatchAt.generate_gaussianFold]

/-- The shell folds sum to the nonzero-mode part of the even theta kernel. -/
theorem hasSum_generatedRiemannThetaShellFold
    (owner : GlobalGermOwner) {t : ℝ} (positive : 0 < t) :
    HasSum (generatedRiemannThetaShellFold owner t)
      (HurwitzZeta.evenKernel 0 t - 1) := by
  rw [HurwitzZeta.evenKernel_eq_cosKernel_of_zero]
  refine (HurwitzZeta.hasSum_nat_cosKernel₀ 0 positive).congr_fun ?_
  intro stage
  rw [generatedRiemannThetaShellFold_eq]
  simp only [mul_zero, zero_mul, Real.cos_zero, mul_one,
    Nat.cast_add, Nat.cast_one]

/-- The complete source-generated theta sequence: the once-generated zero
mode followed by the exact runtime shells. -/
noncomputable def generatedRiemannThetaTerm
    (owner : GlobalGermOwner) (t : ℝ) : Nat → ℝ
  | 0 => thetaZeroFold owner t
  | stage + 1 => generatedRiemannThetaShellFold owner t stage

@[simp] theorem generatedRiemannThetaTerm_zero
    (owner : GlobalGermOwner) (t : ℝ) :
    generatedRiemannThetaTerm owner t 0 = 1 := by
  simp [generatedRiemannThetaTerm]

@[simp] theorem generatedRiemannThetaTerm_succ
    (owner : GlobalGermOwner) (t : ℝ) (stage : Nat) :
    generatedRiemannThetaTerm owner t (stage + 1) =
      generatedRiemannThetaShellFold owner t stage :=
  rfl

/-- The accountable finite folds generate the full Riemann theta kernel. -/
theorem hasSum_generatedRiemannThetaTerm
    (owner : GlobalGermOwner) {t : ℝ} (positive : 0 < t) :
    HasSum (generatedRiemannThetaTerm owner t)
      (HurwitzZeta.evenKernel 0 t) := by
  apply (hasSum_nat_add_iff' 1).mp
  rw [show (∑ i ∈ Finset.range 1,
      generatedRiemannThetaTerm owner t i) = 1 by
    simp]
  exact (hasSum_generatedRiemannThetaShellFold owner positive).congr_fun
    (fun _ => rfl)

theorem tsum_generatedRiemannThetaTerm
    (owner : GlobalGermOwner) {t : ℝ} (positive : 0 < t) :
    ∑' stage, generatedRiemannThetaTerm owner t stage =
      HurwitzZeta.evenKernel 0 t :=
  (hasSum_generatedRiemannThetaTerm owner positive).tsum_eq

/-- Poisson/Jacobi duality is now a law of the generated cofinal fold, not a
detached analytic input. -/
theorem tsum_generatedRiemannThetaTerm_functional_equation
    (owner : GlobalGermOwner) {t : ℝ} (positive : 0 < t) :
    (∑' stage, generatedRiemannThetaTerm owner t stage) =
      1 / t ^ (1 / 2 : ℝ) *
        ∑' stage, generatedRiemannThetaTerm owner (1 / t) stage := by
  rw [tsum_generatedRiemannThetaTerm owner positive,
    tsum_generatedRiemannThetaTerm owner (one_div_pos.mpr positive)]
  simpa [HurwitzZeta.evenKernel_eq_cosKernel_of_zero] using
    HurwitzZeta.evenKernel_functional_equation
      (0 : UnitAddCircle) t

/-- Every nonzero magnitude is generated by one and only one runtime stage;
there is no free integer-window input. -/
theorem generatedRiemannThetaShell_magnitude_bijection
    (owner : GlobalGermOwner) (magnitude : Nat) :
    0 < magnitude →
      ∃! stage,
        (generatedRiemannThetaShell owner stage).magnitude = magnitude := by
  intro positive
  refine ⟨magnitude - 1, ?_, ?_⟩
  · simp [generatedRiemannThetaShell, generatedRiemannThetaPatch,
      GeneratedFiniteThetaPatchAt.generate]
    omega
  · intro stage equality
    simp [generatedRiemannThetaShell, generatedRiemannThetaPatch,
      GeneratedFiniteThetaPatchAt.generate] at equality
    omega

end
end CanonicalRiemann
end NoIslandNoMagic
end ConstructiveRoot
