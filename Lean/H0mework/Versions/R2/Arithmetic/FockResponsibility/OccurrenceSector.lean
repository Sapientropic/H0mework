import H0mework.Versions.R2.Arithmetic.FockDynamics.PhysicalCurrent

/-!
# Occurrence-sensitive physical sector responsibility

The remaining finite inventory stores structural channel keys only.  The live
physical state retains the complete source occurrence.  Reusing a structural
key after a new actual event therefore does not mean that reality repeated an
old occurrence: it produces an explicit projection-recurrence residual with
strictly newer provenance and the full generated effect.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalArithmeticState
namespace ParticleWaveFockOccurrenceResponsibility

open CanonicalUnitArithmeticEffectiveFactorRepairOrbitProducer
open CanonicalUnitArithmeticOperationalFactorDecayProducer
open ParticleWaveFockAtomicProcess
open ParticleWaveFockOccurrencePhysicalProcess

noncomputable section

noncomputable instance structuralKeyFinite (index : Nat) :
    Finite (FactorDecayStructuralChannelKeyAt index) := by
  infer_instance

noncomputable instance structuralKeyFintype (index : Nat) :
    Fintype (FactorDecayStructuralChannelKeyAt index) :=
  Fintype.ofFinite _

noncomputable local instance structuralKeyDecidableEq (index : Nat) :
    DecidableEq (FactorDecayStructuralChannelKeyAt index) :=
  Classical.decEq _

/-- Complete occurrence current and the remaining finite observer keys. -/
abbrev State (index : Nat) :=
  OccurrencePhysicalCurrentAt index ×
    Finset (FactorDecayStructuralChannelKeyAt index)

def initialState {index : Nat} (origin : EffectiveSplitAt index) : State index :=
  (seed origin, Finset.univ)

@[simp] theorem initialState_occurrence {index : Nat}
    (origin : EffectiveSplitAt index) :
    (initialState origin).1.occurrence =
      SourceGeneratedFiniteEventIndexedProvenanceFlux.seed
        (factorDecayProcess index) origin :=
  rfl

@[simp] theorem initialState_contains_every_key {index : Nat}
    (origin : EffectiveSplitAt index)
    (key : FactorDecayStructuralChannelKeyAt index) :
    key ∈ (initialState origin).2 :=
  Finset.mem_univ key

def budget {index : Nat} (state : State index) : Nat :=
  state.2.card

/-- Classifier-generated local terminal.  It does not erase the remaining
structural inventory or manufacture a root support-settlement receipt. -/
structure TerminalAt {index : Nat} (state : State index) : Type where
  private mk ::
  generated : GeneratedTerminalAt state.1.physicalCurrent
    (generateEvent state.1.physicalCurrent)
  species : GeneratedTerminalSpeciesAt state.1.physicalCurrent
    generated.terminal
  dynamics_eq : generateDynamics state.1.physicalCurrent =
    .terminal generated species

/-- A present structural key pays exactly one finite observation slot while
the complete occurrence current advances by the actual source event. -/
structure StrictPaymentAt {index : Nat}
    (source target : State index) : Type where
  private mk ::
  actual : ActualOccurrenceFactorDecayAt source.1
  structuralKey : FactorDecayStructuralChannelKeyAt index
  structuralKey_eq : structuralKey = actual.structuralKey
  present : structuralKey ∈ source.2
  target_eq : target = (actual.target, source.2.erase structuralKey)

theorem StrictPaymentAt.budget_lt {index : Nat}
    {source target : State index} (payment : StrictPaymentAt source target) :
    budget target < budget source := by
  rw [payment.target_eq]
  exact Finset.card_erase_lt_of_mem payment.present

theorem StrictPaymentAt.occurrence_depth_strict {index : Nat}
    {source target : State index} (payment : StrictPaymentAt source target) :
    source.1.occurrence.depth < target.1.occurrence.depth := by
  rw [payment.target_eq]
  exact payment.actual.target_depth_strict

/-- A key-absent event is a new actual occurrence hidden by a finite
projection.  Its effect remains fully available for downstream settlement;
no budget is refreshed and no new occurrence is collapsed into a prior event. -/
structure ProjectionRecurrenceResidualAt {index : Nat}
    (state : State index) : Type where
  private mk ::
  actual : ActualOccurrenceFactorDecayAt state.1
  structuralKey : FactorDecayStructuralChannelKeyAt index
  structuralKey_eq : structuralKey = actual.structuralKey
  keyAbsent : structuralKey ∉ state.2
  effect : GeneratedStepEffectAt state.1.physicalCurrent
    (generateEvent state.1.physicalCurrent) actual.step
  effect_eq : effect = actual.effect
  target : OccurrencePhysicalCurrentAt index
  target_eq : target = actual.target
  depthStrict : state.1.occurrence.depth < target.occurrence.depth
  depthNe : target.occurrence.depth ≠ state.1.occurrence.depth
  advancedOccurrenceChanged :
    actual.advancedOccurrence ≠ state.1.occurrence

/-- Canonical recurrence residual generated by one actual incidence whose
finite observer key is absent.  All provenance/effect fields are read from
that incidence. -/
def ProjectionRecurrenceResidualAt.ofActual {index : Nat}
    {state : State index}
    (actual : ActualOccurrenceFactorDecayAt state.1)
    (keyAbsent : actual.structuralKey ∉ state.2) :
    ProjectionRecurrenceResidualAt state :=
  { actual := actual
    structuralKey := actual.structuralKey
    structuralKey_eq := rfl
    keyAbsent := keyAbsent
    effect := actual.effect
    effect_eq := rfl
    target := actual.target
    target_eq := rfl
    depthStrict := actual.target_depth_strict
    depthNe := actual.target_depth_ne
    advancedOccurrenceChanged := actual.advancedOccurrence_ne }

/-- Exact source dynamics: local terminal, one strict finite-key payment, or
an explicit occurrence-sensitive projection residual. -/
inductive GeneratedDispositionAt {index : Nat} (state : State index) : Type
  | terminal (settled : TerminalAt state)
  | payment {target : State index} (paid : StrictPaymentAt state target)
  | projectionRecurrence (residual : ProjectionRecurrenceResidualAt state)

def generateDisposition {index : Nat}
    (state : State index) : GeneratedDispositionAt state := by
  generalize dynamics_eq :
    generateDynamics state.1.physicalCurrent = dynamics
  cases dynamics with
  | terminal generated species =>
      exact .terminal
        { generated := generated
          species := species
          dynamics_eq := dynamics_eq }
  | step generated effect =>
      let actual := generateActualIncidence
        state.1 generated effect dynamics_eq
      let key := actual.structuralKey
      by_cases present : key ∈ state.2
      · exact .payment
          { actual := actual
            structuralKey := key
            structuralKey_eq := rfl
            present := present
            target_eq := rfl }
      · exact .projectionRecurrence
          (ProjectionRecurrenceResidualAt.ofActual actual present)

/-- At the complete initial inventory, every classifier-generated step yields
the first strict payment.  No key, target, or positive-budget premise enters. -/
def initialStrictPaymentOfGeneratedStep {index : Nat}
    (origin : EffectiveSplitAt index)
    (generated : GeneratedStepAt (seed origin).physicalCurrent
      (generateEvent (seed origin).physicalCurrent))
    (effect : GeneratedStepEffectAt (seed origin).physicalCurrent
      (generateEvent (seed origin).physicalCurrent) generated)
    (dynamics_eq : generateDynamics (seed origin).physicalCurrent =
      .step generated effect) :
    Sigma fun target : State index =>
      StrictPaymentAt (initialState origin) target := by
  let actual := generateActualIncidence
    (seed origin) generated effect dynamics_eq
  let key := actual.structuralKey
  exact ⟨(actual.target, (initialState origin).2.erase key),
    { actual := actual
      structuralKey := key
      structuralKey_eq := rfl
      present := Finset.mem_univ key
      target_eq := rfl }⟩

theorem initialStrictPayment_budget_lt {index : Nat}
    (origin : EffectiveSplitAt index)
    (generated : GeneratedStepAt (seed origin).physicalCurrent
      (generateEvent (seed origin).physicalCurrent))
    (effect : GeneratedStepEffectAt (seed origin).physicalCurrent
      (generateEvent (seed origin).physicalCurrent) generated)
    (dynamics_eq : generateDynamics (seed origin).physicalCurrent =
      .step generated effect) :
    budget (initialStrictPaymentOfGeneratedStep
        origin generated effect dynamics_eq).1 <
      budget (initialState origin) :=
  (initialStrictPaymentOfGeneratedStep
    origin generated effect dynamics_eq).2.budget_lt

end

