import H0mework.Versions.R2.Foundation.Inquiry.Engine
import H0mework.Versions.R2.Checks.Runtime.U7Ledger

/-!
# Regression: automatic U7-first U8 inquiry completion

One exact fixed-root inquiry first emits a U7 theory-audit demand.
The same occurrence then proves the old expression and realization fibres
empty, generates the minimal coface, emits its two-row revised ledger and
first write, and returns a revised answer-and-next through `Engine.ask`.

The caller supplies only `Unit` query data.  Failure, coface and concrete
revision remain source-generated dependent data inside the literal compiler
image.
-/

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace RootInquiryU8CompletionRegression

open RootInquiryCompletion
open ObstructionGeneratedMinimalCoface
open TypedSemanticWorldNetworkU8

open OperationalU7RootLedgerRegression

abbrev N := OperationalU7RootLedgerRegression.N
abbrev V := OperationalU7RootLedgerRegression.V
abbrev U7 := OperationalU7RootLedgerRegression.U7

def oldInventory : LawInventory N where
  Version := Unit
  version := ()
  Law := Unit
  RealizationAt := fun _ => PEmpty
  RealizationWithoutAt := fun _ _ _ => PUnit

def oldTheory : TheoryState N where
  inventory := oldInventory
  ExpressionAt := fun _ => PEmpty
  denotes := PEmpty.elim
  TheoremAt := fun _ => Unit
  theoremPresentation := fun _ => ConstructivePresentation.refl Unit

def obstruction : N.ObstructionAt true := ()

def failure : ActualExpressibilityFailure oldTheory obstruction where
  notExpressible := ⟨fun expression => nomatch expression⟩
  noLawfulRealization := ⟨fun realization => nomatch realization⟩

/-- The exact U8 trigger cannot carry a completed per-law audit compiler.
Deletion diagnostics, when needed, are separately generated readouts in the
non-authoritative theory-evolution layer. -/
theorem failure_has_no_preinstalled_deletion_audit : True := by
  fail_if_success exact failure.deletionAuditSource
  trivial

#print axioms failure_has_no_preinstalled_deletion_audit

def theoryAuditCalculus : U7ObstructionEvolutionCalculus N U7 where
  source := OperationalSeparationRegression.u7Source
  compile := by
    intro support indexedObstruction demand event
    exact
      { disposition := .requiresTheoryAudit ()
        demandEntryDisposition := PUnit.unit }

def u7Gate : SourceNativeU7TheoryAuditAt theoryAuditCalculus
    (theoryAuditCalculus.source.emit obstruction) :=
  PUnit.unit

def transferredRootEntryDisposition :=
  (OperationalU7RootLedgerRegression.ledgerCompiler.compile
    (OperationalU7RootLedgerRegression.emitted ())).entryDisposition
      OperationalU7RootLedgerRegression.rootEntry

/-- A transferred root row cannot lend its authority to a U7 theory-audit
face that carries the exact responsibility unchanged. -/
theorem transferred_root_row_cannot_open_theory_audit :
    IsEmpty
      (U7DemandEntryRootDispositionCommutesAt theoryAuditCalculus
        (theoryAuditCalculus.source.emit obstruction)
        OperationalU7RootLedgerRegression.rootEntry
        transferredRootEntryDisposition) := by
  constructor
  intro commutes
  rcases commutes with ⟨entry_heq, disposition_heq⟩
  cases entry_heq
  have disposition_eq := eq_of_heq disposition_heq
  have transfer_eq := congrArg
    (fun disposition => match disposition with
      | LedgerEntryDispositionAt.evolved evolution =>
          FiniteGeneratedLedgerWritePatchAt.ledgerEntryIsTransferred evolution
      | LedgerEntryDispositionAt.terminal _ => false)
    disposition_eq
  change true = false at transfer_eq
  exact Bool.noConfusion transfer_eq

def inquiryAudit : SourceNativeInquiryFrontAuditAt U7 theoryAuditCalculus
    oldTheory true :=
  .obstructed obstruction (.requiresU8 u7Gate failure)

/-- The U8 fixture carries its exact failure entry through the theory-audit
occurrence.  Its whole-ledger row is therefore the same row generated by the
U7 compiler. -/
def auditRow : LedgerEntryEvolutionAt N rootEntry rootEntry :=
  .carried rfl HEq.rfl

abbrev auditGeneratedPatch := generatedPatchWith auditRow

abbrev auditRestructuringSource := restructuringSourceWith auditRow

inductive Projection
  | inquiry
  | failure

def entry : OpenResponsibilityAt N true := ⟨(), ()⟩

def projectionLaw : SourceNativeProjectionLaw
    auditRestructuringSource.toLedgerSource where
  Projection := Projection
  ActiveAt := fun _ {_} _ => Unit
  InactiveAt := fun _ {_} _ => PEmpty
  classify := fun _ {_} _ => .inl ()
  PayloadAt := fun projection {_} occurrence _ =>
    match projection with
    | .inquiry => SourceNativeInquiryCompilationTokenAt
        entry () (ULift.up.{1, 0} occurrence) inquiryAudit PUnit
    | .failure => SourceNativeRootExpressibilityFailureTokenAt
        failure theoryAuditCalculus (theoryAuditCalculus.source.emit obstruction)
  project := fun projection {_} _ _ => by
    cases projection with
    | inquiry => exact .canonical PUnit.unit
    | failure => exact .canonical

def authoritySource : SourceNativeAuthoritySource N V where
  restructuringSource := auditRestructuringSource
  eventInventoryAdmission :=
    .reflOfNoFaithfulTerminal
      auditRestructuringSource
      (fun _ => ⟨fun terminal => nomatch terminal⟩)
  lawSurface := oldTheory
  projectionLaw := projectionLaw

def root : SourceNativeLivingRootClosure N V where
  source :=
    { base := authoritySource
      terminalHandoff := authoritySource.emptyFaithfulTerminalHandoff
        (fun _ => ⟨fun terminal => nomatch terminal⟩) }
  emitted := OperationalU7RootLedgerRegression.emitted
  compiler_commutes := fun _ => rfl

def visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot :=
  .finite root.toAuthoritativeRoot.toRoot.initialVisit

def inquiryEvent :=
  ULift.up.{1, 0} (root.emitted visit.current)

def entryRow :
    (root.toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit visit
      ).GeneratedEntryRowAt entry :=
  ((root.toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit visit
    ).canonicalGeneratedEntryRow? entry).get (by rfl)

def authority : SourceNativeLivingTemporalCausalEntryAuthorityAt root visit entry :=
  ((SourceNativeLivingTemporalCausalEntryAuthorityAt.generatedFromInitial?
    root entry .initial).get (by rfl)).2

theorem theoryAuditRootDispositionCommutes :
    U7DemandEntryRootDispositionCommutesAt theoryAuditCalculus
      (theoryAuditCalculus.source.emit obstruction) entry
      ((root.toAuthoritativeRoot.toLedgerRoot.source.ledgerCompiler.compile
        (root.emitted visit.current)).entryDisposition entry) := by
  simp [U7DemandEntryRootDispositionCommutesAt,
    SourceNativeLedgerEvolutionAt.entryDisposition,
    GeneratedU7ObstructionEvolutionAt.entryDisposition,
    theoryAuditCalculus, U7ActualSuccessorSource.demandEntry]
  have evolution_heq :=
    ((auditGeneratedPatch (emitted ())).canonicalGeneratedSourceRow?
      entry).get (by rfl) |>.evolution_heq_fold
  cases evolution_heq
  rfl

def failureFace : SourceNativeRootExpressibilityFailureFaceAt
    root.toAuthoritativeRoot visit (U7 := U7) failure where
  lawSurface_eq := rfl
  projection := .failure
  active := ()
  classifier_eq := rfl
  calculus := theoryAuditCalculus
  u7Event := theoryAuditCalculus.source.emit obstruction
  u7Event_eq_emit := rfl
  theoryAudit := u7Gate
  support_eq := rfl
  rootEntry := entry
  rootEntryAtFailure_eq := rfl
  rootDispositionCommutes := theoryAuditRootDispositionCommutes
  project_heq := HEq.rfl

/-! ## Fieldwise authority does not spread through a product source -/

/-- A sibling law surface in which the same root claim is already
addressable and lawfully realizable. -/
def wideInventory : LawInventory N where
  Version := PUnit
  version := PUnit.unit
  Law := PUnit
  RealizationAt := fun _ => PUnit
  RealizationWithoutAt := fun _ _ _ => PUnit

def wideTheory : TheoryState N where
  inventory := wideInventory
  ExpressionAt := fun _ => PUnit
  denotes := fun _ => ()
  TheoremAt := fun _ => PUnit
  theoremPresentation := fun _ => ConstructivePresentation.refl _

theorem oldTheory_ne_wideTheory : oldTheory ≠ wideTheory := by
  intro theory_eq
  have expression : oldTheory.ExpressionAt true := by
    rw [theory_eq]
    exact PUnit.unit
  exact nomatch expression

/-- Keep the actual source, occurrence compiler, event admission, and even the
narrow failure token unchanged; replace only the source-owned law surface by
the wider one.  This is a distinct source epoch. -/
def wideLawAuthoritySource : SourceNativeAuthoritySource N V where
  restructuringSource := authoritySource.restructuringSource
  eventInventoryAdmission := authoritySource.eventInventoryAdmission
  lawSurface := wideTheory
  projectionLaw := projectionLaw

def wideLawRoot : SourceNativeAuthoritativeRootClosure N V where
  source := wideLawAuthoritySource
  emitted := OperationalU7RootLedgerRegression.emitted
  compiler_commutes := fun _ => rfl

def wideLawVisit : SourceNativeTemporalVisitAt wideLawRoot.toLedgerRoot :=
  .finite wideLawRoot.toRoot.initialVisit

/-- A grounded event/projection coordinate cannot lend authority to a sibling
theory field.  The exact failure token is still present in the projection
inventory, but it cannot become a rooted failure of the wider source epoch. -/
theorem narrow_failure_face_is_empty_in_wide_law_source :
    IsEmpty (SourceNativeRootExpressibilityFailureFaceAt
      wideLawRoot wideLawVisit (U7 := U7) failure) :=
  ⟨fun face => oldTheory_ne_wideTheory face.lawSurface_eq⟩

def successor : CausalEntrySuccessorAt
    root.toAuthoritativeRoot.toLedgerRoot visit entry :=
  CausalEntrySuccessorAt.ofNonterminal rfl

def rooted : RootedActualExpressibilityFailureAt
    root.toAuthoritativeRoot visit U7 failure :=
  RootedActualExpressibilityFailureAt.ofRootFailureFace
    failureFace authority.toAuthoritativeAuthority successor

def coface : GeneratedMinimalCofaceAt rooted :=
  root_obstruction_generates_minimal_coface rooted

abbrev NewN := coface.worldNetwork

/-- An old target-support receipt is not definitionally a receipt of the new
coface support.  The only accepted positive path is the failure-indexed
presentation generated by this exact coface. -/
def old_target_receipt_cannot_cross_coface_unregistered : PUnit := by
  fail_if_success
    exact (() : NewN.DispositionAt coface.cofaceSupport .transfer)
  exact PUnit.unit

def registeredCofaceTransferReceipt :
    NewN.DispositionAt coface.cofaceSupport .transfer :=
  (coface.cofaceTargetDispositionPresentation .transfer).forward ()

#print axioms old_target_receipt_cannot_cross_coface_unregistered
#print axioms GeneratedMinimalCofaceAt.cofaceTargetDispositionPresentation

def revisedVocabulary : Vocabulary where
  Current := Nat
  Anchor := NewN.Anchor
  Incidence := NewN.Incidence
  Lineage := NewN.Lineage
  anchorAt := fun _ => NewN.anchorAt coface.cofaceSupport
  incidenceAt := fun _ => NewN.incidenceAt coface.cofaceSupport
  lineageAt := fun _ => NewN.lineageAt coface.cofaceSupport
  NativeWriteAt := fun _ => Unit
  RelationWriteAt := fun _ => PEmpty
  ContinuedTransportAt := fun _ => PEmpty
  BorromeanRedirectAt := fun _ => PEmpty
  FaithfulTerminalAt := fun _ => PEmpty
  nativeTarget := fun {current} _ => current + 1
  relationTarget := PEmpty.elim
  continuedTarget := PEmpty.elim
  redirectTarget := PEmpty.elim

abbrev NewV := revisedVocabulary

def revisedEventLaw : SourceNativeEventAlgebra NewN NewV where
  EventAt := fun _ support =>
    match support with
    | .inl _ => PEmpty
    | .inr _ => Unit
  compile := by
    intro current support event
    cases support with
    | inl _ => exact nomatch event
    | inr _ => exact .nativeWrite ()
  AffectedInventoryAt := fun {_} {support} event =>
    OpenResponsibilityAt NewN support
  affectedInventoryPresentation := by
    intro current support event
    exact ConstructivePresentation.refl _
  anchorKey := id
  incidenceKey := id
  lineageKey := id
  anchor_commutes := by
    intro current support event
    cases support with
    | inl _ => exact nomatch event
    | inr generated => cases generated; rfl
  incidence_commutes := by
    intro current support event
    cases support with
    | inl _ => exact nomatch event
    | inr generated => cases generated; rfl
  lineage_commutes := by
    intro current support event
    cases support with
    | inl _ => exact nomatch event
    | inr generated => cases generated; rfl

def revisedSource : SourceNativeSource NewN NewV where
  initial := (0 : Nat)
  law := revisedEventLaw

def revisedEmitted (current : NewV.Current) :
    revisedSource.toRootSource.actual.OccurrenceAt current :=
  ⟨coface.cofaceSupport, ()⟩

def oldRevisedEntry : OpenResponsibilityAt NewN coface.cofaceSupport :=
  coface.cofaceLedgerRetract.forward rooted.oldTargetEntry

def newRevisedEntry : OpenResponsibilityAt NewN coface.cofaceSupport :=
  coface.obstructionEntry

def revisedEntryAtNat : Nat ->
    OpenResponsibilityAt NewN coface.cofaceSupport :=
  Nat.rec oldRevisedEntry (fun _ _ => newRevisedEntry)

def revisedEntryAt (index : Fin 2) :
    OpenResponsibilityAt NewN coface.cofaceSupport :=
  revisedEntryAtNat index.val

def oldEntryIndex : Fin 2 := ⟨0, Nat.zero_lt_succ 1⟩

def newEntryIndex : Fin 2 :=
  ⟨1, Nat.succ_lt_succ (Nat.zero_lt_succ 0)⟩

def RevisedExactTransitionAt :
    {current : NewV.Current} ->
    (occurrence : revisedSource.toRootSource.actual.OccurrenceAt current) ->
    {targetSupport : NewN.Support} ->
    OpenResponsibilityAt NewN
      (revisedSource.toRootSource.account.supportOf occurrence) ->
    OpenResponsibilityAt NewN targetSupport -> Type :=
  fun {_current} occurrence {targetSupport} sourceEntry targetEntry =>
    PLift (targetSupport =
      revisedSource.toRootSource.account.supportOf occurrence) ×
    PLift (sourceEntry.claim = targetEntry.claim) ×
    PLift (targetEntry.progressBudget <= sourceEntry.progressBudget)

def revisedWriteRowSource : LedgerWriteRowSourceAt revisedSource
    RevisedExactTransitionAt where
  IncidenceOccurrenceAt := fun {_current} occurrence {_targetSupport}
      sourceEntry targetEntry =>
    RevisedExactTransitionAt occurrence sourceEntry targetEntry
  compileEvolution := by
    intro current occurrence targetSupport sourceEntry targetEntry rowEvent
    rcases occurrence with ⟨support, sourceEvent⟩
    cases support with
    | inl oldSupport => exact nomatch sourceEvent
    | inr generatedSupport =>
        cases generatedSupport
        cases rowEvent.1.down
        exact .transferred
          (GeneratedMinimalCofaceAt.CofaceTargetDispositionAt.ofTarget ()) rfl
          rowEvent.2.1.down rowEvent.2.2.down
  compileExact := fun event => event

def revisedRows
    {current : NewV.Current}
    (occurrence : revisedSource.toRootSource.actual.OccurrenceAt current) :
    FiniteGeneratedLedgerWriteRowsAt revisedWriteRowSource occurrence
      ⟨coface.cofaceSupport⟩ := by
  rcases occurrence with ⟨support, event⟩
  cases support with
  | inl oldSupport => exact nomatch event
  | inr generatedSupport =>
      cases generatedSupport
      exact
        { size := 2
          sourceEntryAt := revisedEntryAt
          targetEntryAt := revisedEntryAt
          rowAt := fun _ => revisedWriteRowSource.generate
            ⟨PLift.up rfl, PLift.up rfl, PLift.up (Nat.le_refl _)⟩ }

def revisedResponsibilityIndex : NewN.Responsibility -> Fin 2
  | .inl _ => oldEntryIndex
  | .inr _ => newEntryIndex

def revisedEntryIndex
    (entry : OpenResponsibilityAt NewN coface.cofaceSupport) : Fin 2 :=
  revisedResponsibilityIndex entry.1

theorem revisedEntryAt_index
    (entry : OpenResponsibilityAt NewN coface.cofaceSupport) :
    revisedEntryAt (revisedEntryIndex entry) = entry := by
  rcases entry with ⟨responsibility, isOpen⟩
  cases responsibility with
  | inl oldResponsibility =>
      cases oldResponsibility
      cases isOpen
      rfl
  | inr generatedResponsibility =>
      cases generatedResponsibility
      cases isOpen
      rfl

def revisedPatch
    {current : NewV.Current}
    (occurrence : revisedSource.toRootSource.actual.OccurrenceAt current) :
    FiniteGeneratedLedgerWritePatchAt revisedWriteRowSource occurrence
      ⟨coface.cofaceSupport⟩ := by
  rcases occurrence with ⟨support, event⟩
  cases support with
  | inl oldSupport => exact nomatch event
  | inr generatedSupport =>
      cases generatedSupport
      exact .identityRemainder (revisedRows ⟨coface.cofaceSupport, event⟩)
        { destinationIndex := fun entry =>
            some ⟨revisedEntryIndex entry, revisedEntryAt_index entry⟩
          originIndex := fun entry =>
            some ⟨revisedEntryIndex entry, revisedEntryAt_index entry⟩ }

def revisedLedgerCompiler : SourceNativeLedgerCompiler revisedSource where
  IncidenceTransitionAt := fun _ _ _ => Unit
  ExactTransitionAt := RevisedExactTransitionAt
  exact_incidence := by
    intro current occurrence targetSupport sourceEntry targetEntry exact
    cases exact.1.down
    exact ()
  exact_lineage := by
    intro current occurrence targetSupport sourceEntry targetEntry exact
    cases exact.1.down
    rfl
  writeRowSource := revisedWriteRowSource
  terminalRowSource := LedgerTerminalRowSourceAt.empty revisedSource
  compile := by
    intro current occurrence
    rcases occurrence with ⟨support, event⟩
    cases support with
    | inl oldSupport => exact nomatch event
    | inr generatedSupport =>
        cases generatedSupport
        exact .nativeWrite () rfl
          (revisedEmitted (Nat.succ (show Nat from current)))
          (revisedPatch ⟨coface.cofaceSupport, event⟩).toLedgerWriteEvolution
  compilePatch := by
    intro current occurrence
    rcases occurrence with ⟨support, event⟩
    cases support with
    | inl oldSupport => exact nomatch event
    | inr generatedSupport =>
        cases generatedSupport
        exact ⟨revisedPatch ⟨coface.cofaceSupport, event⟩, rfl⟩

def revisedLedgerSource : SourceNativeLedgerSource NewN NewV where
  source := revisedSource
  ledgerCompiler := revisedLedgerCompiler

theorem revisedOpenAt_subsingleton
    (support : NewN.Support) (responsibility : NewN.Responsibility) :
    Subsingleton (NewN.OpenAt support responsibility) := by
  constructor
  intro left right
  cases support with
  | inl oldSupport =>
      cases responsibility with
      | inl oldResponsibility => cases left; cases right; rfl
      | inr generatedResponsibility => exact PEmpty.elim left
  | inr generatedSupport =>
      cases responsibility with
      | inl oldResponsibility => cases left; cases right; rfl
      | inr generatedResponsibility => cases left; cases right; rfl

def revisedRestructuringLaw :
    SourceNativeLedgerRestructuringLaw revisedSource :=
  identityOnlyWorldLedgerRestructuringLaw revisedSource
    (NewN.anchorAt coface.cofaceSupport) revisedOpenAt_subsingleton

theorem revisedPatch_origin_eq
    (current : NewV.Current)
    (event : Unit)
    (entry : OpenResponsibilityAt NewN coface.cofaceSupport) :
    ((revisedPatch (current := current) ⟨coface.cofaceSupport, event⟩
      ).toLedgerWriteEvolution.origin
      entry).1 = entry := by
  rcases entry with ⟨responsibility, isOpen⟩
  cases responsibility with
  | inl oldResponsibility =>
      cases oldResponsibility
      cases isOpen
      rfl
  | inr generatedResponsibility =>
      cases generatedResponsibility
      cases isOpen
      rfl

theorem revisedPatch_destination_eq
    (current : NewV.Current)
    (event : Unit)
    (entry : OpenResponsibilityAt NewN coface.cofaceSupport) :
    ((revisedPatch (current := current) ⟨coface.cofaceSupport, event⟩
      ).toLedgerWriteEvolution.destination entry).1 = entry := by
  rcases entry with ⟨responsibility, isOpen⟩
  cases responsibility with
  | inl oldResponsibility =>
      cases oldResponsibility
      cases isOpen
      rfl
  | inr generatedResponsibility =>
      cases generatedResponsibility
      cases isOpen
      rfl

def revisedRestructuringCertification
    {current : NewV.Current}
    (occurrence : revisedSource.toRootSource.actual.OccurrenceAt current) :
    SourceNativeLedgerRestructuringCertificationAt revisedRestructuringLaw
      (revisedLedgerCompiler.compile occurrence) := by
  rcases occurrence with ⟨support, event⟩
  cases support with
  | inl oldSupport => exact nomatch event
  | inr generatedSupport =>
      cases generatedSupport
      exact ExactLedgerRestructuringCertificationAt.ofInjective
        (fun left right equality =>
          (revisedPatch_origin_eq current event left).symm.trans
            (equality.trans (revisedPatch_origin_eq current event right)))
        (fun left right equality =>
          (revisedPatch_destination_eq current event left).symm.trans
            (equality.trans (revisedPatch_destination_eq current event right)))

def revisedRestructuringCompiler :
    SourceNativeRestructuringLedgerCompiler revisedSource where
  ledgerCompiler := revisedLedgerCompiler
  restructuringLaw := revisedRestructuringLaw
  certifyRestructuring := revisedRestructuringCertification

def revisedRestructuringSource :
    SourceNativeRestructuringLedgerSource NewN NewV where
  source := revisedSource
  compiler := revisedRestructuringCompiler

def revisedDefaultEntry (support : NewN.Support) :
    OpenResponsibilityAt NewN support :=
  match support with
  | .inl _ => ⟨.inl (), ()⟩
  | .inr _ => newRevisedEntry

def revisedU7 : U7ProducerCalculus NewN where
  DemandAt := fun _ => Unit
  generateDemand := fun _ => ()

def revisedU7Source : U7ActualSuccessorSource NewN revisedU7 where
  EventAt := SourceGeneratedU7DemandAt revisedU7
  emit := fun obstruction => .canonical obstruction
  demandGeneratedAt := fun event => event
  demandEntryAt := fun {support} {_obstruction} {_demand} _ =>
    revisedDefaultEntry support

def revisedCalculus : U7ObstructionEvolutionCalculus NewN revisedU7 where
  source := revisedU7Source
  compile := by
    intro support indexedObstruction demand event
    cases support with
    | inl oldSupport =>
        exact
          { disposition := .redirected ⟨(), rfl⟩
            demandEntryDisposition :=
              ⟨LedgerEntryEvolutionAt.transferred () rfl rfl
                (Nat.le_refl _), rfl⟩ }
    | inr generatedSupport =>
        cases generatedSupport
        exact
          { disposition := .redirected
              ⟨GeneratedMinimalCofaceAt.CofaceTargetDispositionAt.ofTarget (), rfl⟩
            demandEntryDisposition :=
              ⟨LedgerEntryEvolutionAt.transferred
                (GeneratedMinimalCofaceAt.CofaceTargetDispositionAt.ofTarget ()) rfl rfl
                (Nat.le_refl _), rfl⟩ }

def revisedTheory : TheoryState NewN :=
  TheoryState.rootSemantic coface.worldNetwork

def revisedInquiryAudit : SourceNativeInquiryFrontAuditAt
    revisedU7 revisedCalculus revisedTheory coface.cofaceSupport :=
  .answered

inductive RevisedProjection
  | ledger
  | inquiry
  | answer
  | consumer

def revisedProjectionLaw : SourceNativeProjectionLaw
    revisedRestructuringSource.toLedgerSource where
  Projection := RevisedProjection
  ActiveAt := fun projection {_} occurrence =>
    match projection with
    | .ledger => PUnit
    | .inquiry => PUnit
    | .answer => PUnit
    | .consumer => PUnit
  InactiveAt := fun projection {_} occurrence =>
    match projection with
    | .ledger => PEmpty
    | .inquiry => PEmpty
    | .answer => PEmpty
    | .consumer => PEmpty
  classify := fun projection {_} occurrence =>
    match projection with
    | .ledger => .inl PUnit.unit
    | .inquiry => .inl PUnit.unit
    | .answer => .inl PUnit.unit
    | .consumer => .inl PUnit.unit
  PayloadAt := fun projection {_} occurrence _ =>
    match projection with
    | .ledger => SourceNativeLedgerEvolutionAt revisedSource occurrence
    | .inquiry => SourceNativeInquiryCompilationTokenAt
        newRevisedEntry () (ULift.up.{1, 0} occurrence)
          revisedInquiryAudit PUnit
    | .answer => PUnit
    | .consumer => SourceNativeInquiryAnswerConsumerTokenAt
        () (ULift.up.{1, 0} occurrence) newRevisedEntry PUnit.unit
  project := fun projection {_} occurrence _ => by
    cases projection with
    | ledger => exact revisedLedgerCompiler.compile occurrence
    | inquiry => exact .canonical PUnit.unit
    | answer => exact PUnit.unit
    | consumer => exact .canonical

def revisedAuthoritySource : SourceNativeAuthoritySource NewN NewV where
  restructuringSource := revisedRestructuringSource
  eventInventoryAdmission :=
    .reflOfNoFaithfulTerminal revisedRestructuringSource
      (fun _ => ⟨fun terminal => nomatch terminal⟩)
  lawSurface := revisedTheory
  projectionLaw := revisedProjectionLaw

def revisedAuthoritativeRoot :
    SourceNativeAuthoritativeRootClosure NewN NewV where
  source := revisedAuthoritySource
  emitted := revisedEmitted
  compiler_commutes := fun _ => rfl

def revisedLivingRoot : SourceNativeLivingRootClosure NewN NewV where
  source :=
    { base := revisedAuthoritySource
      terminalHandoff := revisedAuthoritySource.emptyFaithfulTerminalHandoff
        (fun _ => ⟨fun terminal => nomatch terminal⟩) }
  emitted := revisedEmitted
  compiler_commutes := fun _ => rfl

def revisedOccurrencePresentation : ConstructivePresentation
    (root.toAuthoritativeRoot.toRoot.actual.OccurrenceAt rooted.oldSuccessor.next)
    (revisedAuthoritativeRoot.toRoot.actual.OccurrenceAt (0 : Nat)) where
  forward := by
    rintro ⟨support, event⟩
    cases support with
    | false => exact nomatch event
    | true => exact ⟨coface.cofaceSupport, ()⟩
  backward := by
    rintro ⟨support, event⟩
    cases support with
    | inl oldSupport => exact nomatch event
    | inr generatedSupport => exact ⟨true, ()⟩
  backward_forward := by
    rintro ⟨support, event⟩
    cases support with
    | false => exact nomatch event
    | true => cases event; rfl
  forward_backward := by
    rintro ⟨support, event⟩
    cases support with
    | inl oldSupport => exact nomatch event
    | inr generatedSupport =>
        cases generatedSupport
        cases event
        rfl

def revisedFirstWrite : CanonicalFirstRootWriteAt
    revisedAuthoritativeRoot.toLedgerRoot :=
  PUnit.unit

def revisedInitialGeneratedEvolution :
    SourceNativeTemporalVisitGeneratedEvolutionAt
      revisedAuthoritativeRoot.toLedgerRoot
      (.finite revisedAuthoritativeRoot.toRoot.initialVisit) :=
