theorem three_bools_collide (left middle right : Bool) :
    left = middle ∨ left = right ∨ middle = right := by
  cases left with
  | false =>
      cases middle with
      | false => exact .inl rfl
      | true =>
          cases right with
          | false => exact .inr (.inl rfl)
          | true => exact .inr (.inr rfl)
  | true =>
      cases middle with
      | false =>
          cases right with
          | false => exact .inr (.inr rfl)
          | true => exact .inr (.inl rfl)
      | true => exact .inl rfl

theorem eqMp_injective {alpha beta : Sort u} (equality : alpha = beta) :
    Function.Injective (Eq.mp equality) := by
  cases equality
  exact fun _ _ valueEquality => valueEquality

theorem bool_ne_newSupport : Bool ≠ NewN.Support := by
  intro equality
  let restrict : NewN.Support -> Bool := Eq.mp equality.symm
  have restrict_injective : Function.Injective restrict :=
    eqMp_injective equality.symm
  rcases three_bools_collide
      (restrict (.inl false)) (restrict (.inl true))
        (restrict (.inr .completion)) with collision | collision | collision
  · have impossible := restrict_injective collision
    cases impossible
  · have impossible := restrict_injective collision
    cases impossible
  · have impossible := restrict_injective collision
    cases impossible

def erasedCurrentLabel (erased : AnyAuthoritativeRootCurrent) :
    Sigma fun Carrier : Type => Carrier :=
  ⟨erased.current.V.Current, erased.current.visit.current⟩

theorem revisedVisitAt_current (index : Nat) :
    (revisedVisitAt index).current = index := by
  induction index with
  | zero => rfl
  | succ index inductionHypothesis =>
      change Nat.succ (revisedVisitAt index).current = Nat.succ index
      exact congrArg Nat.succ inductionHypothesis

theorem processPresentation_erase_injective :
    Function.Injective (fun processState =>
      (processPresentation processState).erase) := by
  intro left right equality
  cases left with
  | original =>
      cases right with
      | original => rfl
      | revised rightIndex =>
          have network_eq := congrArg AnyAuthoritativeRootCurrent.N equality
          have support_eq := congrArg WorldRelationNetwork.Support network_eq
          exact False.elim (bool_ne_newSupport support_eq)
  | revised leftIndex =>
      cases right with
      | original =>
          have network_eq := congrArg AnyAuthoritativeRootCurrent.N equality
          have support_eq := congrArg WorldRelationNetwork.Support network_eq
          exact False.elim (bool_ne_newSupport support_eq.symm)
      | revised rightIndex =>
          have label_eq := congrArg erasedCurrentLabel equality
          change
            (⟨NewV.Current, (revisedVisitAt leftIndex).current⟩ :
              Sigma fun Carrier : Type => Carrier) =
            ⟨NewV.Current, (revisedVisitAt rightIndex).current⟩ at label_eq
          rw [revisedVisitAt_current, revisedVisitAt_current] at label_eq
          have index_eq : leftIndex = rightIndex := by
            cases label_eq
            rfl
          cases index_eq
          rfl

