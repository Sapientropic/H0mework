    (C.frames (initial sourceRuntime) count).currentState.root.toAuthoritativeRoot
    (C.frames (initial sourceRuntime) count).request
    (RootGeneratedDebtActivationJointSource.Successor.Inquiry.Source.programme
      (C.frames (initial sourceRuntime) count).old (C.frames (initial sourceRuntime) count).registered
      (C.frames (initial sourceRuntime) count).packetAt (C.frames (initial sourceRuntime) count).depth)
