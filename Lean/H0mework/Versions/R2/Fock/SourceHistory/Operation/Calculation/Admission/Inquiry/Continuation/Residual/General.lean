    (C.frames (initial sourceRuntime) count).packetAt (C.frames (initial sourceRuntime) count).environment
    (C.frames (initial sourceRuntime) count).depth
  exact completed.trans (congrArg (fun environment => (C.frames (initial sourceRuntime) count).request.input.expression.eval environment)
    (environment.trans (environment_actual sourceRuntime count)))

theorem completed_residual_effect (count : Nat) : (completedResidual sourceRuntime count).1 =
    (effectEvaluator (R := ℤ) (s := Sum.inl OperationSort.parent)
      (RootGeneratedDebtActivationJointSource.Successor.Inquiry.Source.rawRead
        (C.frames (initial sourceRuntime) count).old (C.frames (initial sourceRuntime) count).registered
        (C.frames (initial sourceRuntime) count).packetAt (C.frames (initial sourceRuntime) count).depth).environment
      (SourcePhysicalCalculation.rawEnvironment (sourceRuntime.advance (11 + count)) -
        (RootGeneratedDebtActivationJointSource.Successor.Inquiry.Source.rawRead
          (C.frames (initial sourceRuntime) count).old (C.frames (initial sourceRuntime) count).registered
          (C.frames (initial sourceRuntime) count).packetAt (C.frames (initial sourceRuntime) count).depth).environment))
      (relationMap (R := ℤ)
        (RootGeneratedDebtActivationJointSource.Successor.Inquiry.Source.rawRead
          (C.frames (initial sourceRuntime) count).old (C.frames (initial sourceRuntime) count).registered
          (C.frames (initial sourceRuntime) count).packetAt (C.frames (initial sourceRuntime) count).depth).environment
        (RootGeneratedDebtActivationJointSource.Successor.Inquiry.Effect.relations (R := ℤ)
          (C.frames (initial sourceRuntime) count).old (C.frames (initial sourceRuntime) count).registered
          (C.frames (initial sourceRuntime) count).packetAt (C.frames (initial sourceRuntime) count).environment
          (C.frames (initial sourceRuntime) count).depth)) := by
  have paid := RootGeneratedDebtActivationJointSource.Successor.Inquiry.Effect.completed_request_effect (R := ℤ)
    (C.frames (initial sourceRuntime) count).old (C.frames (initial sourceRuntime) count).registered
    (C.frames (initial sourceRuntime) count).packetAt (C.frames (initial sourceRuntime) count).environment
    (C.frames (initial sourceRuntime) count).depth
  have environment : RootGeneratedDebtActivationJointSource.Successor.Inquiry.Source.environmentAt
      (C.frames (initial sourceRuntime) count).old (C.frames (initial sourceRuntime) count).registered
      (C.frames (initial sourceRuntime) count).packetAt (C.frames (initial sourceRuntime) count).environment
      (C.frames (initial sourceRuntime) count).depth
      (RootGeneratedDebtActivationJointSource.Successor.Inquiry.Source.actualOccurrence
        (C.frames (initial sourceRuntime) count).old (C.frames (initial sourceRuntime) count).registered
        (C.frames (initial sourceRuntime) count).packetAt (C.frames (initial sourceRuntime) count).depth) =
      SourcePhysicalCalculation.rawEnvironment (sourceRuntime.advance (11 + count)) := environment_actual sourceRuntime count
  rw [environment] at paid
  exact paid

theorem completed_residual_inverse_fibre (count : Nat) :
    (residualEquivRange (evaluation (R := ℤ)
      (SourcePhysicalCalculation.rawEnvironment (sourceRuntime.advance (11 + count))))
      (canonicalResidual (evaluation (R := ℤ)
        (SourcePhysicalCalculation.rawEnvironment (sourceRuntime.advance (11 + count))))
        (relationMap (R := ℤ)
          (RootGeneratedDebtActivationJointSource.Successor.Inquiry.Source.rawRead
            (C.frames (initial sourceRuntime) count).old (C.frames (initial sourceRuntime) count).registered
            (C.frames (initial sourceRuntime) count).packetAt (C.frames (initial sourceRuntime) count).depth).environment
          (RootGeneratedDebtActivationJointSource.Successor.Inquiry.Effect.relations (R := ℤ)
