            (C.frames (initial sourceRuntime) count).packetAt (C.frames (initial sourceRuntime) count).environment
            (C.frames (initial sourceRuntime) count).depth)))).val =
        (completedResidual sourceRuntime count).1 := by
  have paid := RootGeneratedDebtActivationJointSource.Successor.Inquiry.Effect.completed_request_inverse_fibre (R := ℤ)
    (C.frames (initial sourceRuntime) count).old (C.frames (initial sourceRuntime) count).registered
    (C.frames (initial sourceRuntime) count).packetAt (C.frames (initial sourceRuntime) count).environment
    (C.frames (initial sourceRuntime) count).depth
  have environment := RootGeneratedDebtActivationJointSource.Successor.Inquiry.Source.request_environment
