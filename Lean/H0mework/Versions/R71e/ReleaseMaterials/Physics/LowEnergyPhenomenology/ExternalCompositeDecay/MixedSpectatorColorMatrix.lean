import H0mework.Versions.R71e.ReleaseMaterials.Physics.LowEnergyPhenomenology.ExternalCompositeDecay.MixedSpectatorColorColumns
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 2048
noncomputable section
namespace LowEnergy.MixedSpectatorCandidate
open SaturationMonoid SaturationMonoid.PhysicsCore
open LowEnergy.Electromagnetic.Identification
open SU7MotherLieAlgebra SU7ExteriorMatterRepresentation SU7ExteriorMatterRestriction
open StageNineHolonomicField StageNineP286GaugeConnectionVariationDensity DiracExteriorMatterAction
open SourceQuantumScalarChart SourceQuantumFockGauge SourceQuantumConfigurationHilbert
open scoped BigOperators Matrix
local instance : DecidableEq LowEnergy.Quantum.Index:=Classical.decEq _

def colorNative(A:SU3BlockLieMatrix):NativeLie:=p286CoordinateEquiv (colorData A)
def namedColumn(i:NamedMode):DiracExteriorMatterCarrier:=LowEnergy.Quantum.wholeBasis (rootIndex i)

theorem actual_named_column_coordinates(i:NamedMode):
    LowEnergy.Quantum.coordinates (namedColumn i)=Pi.single (rootIndex i) 1:=by
  funext j
  simp [LowEnergy.Quantum.coordinates,namedColumn,Pi.single_apply,eq_comm]

private theorem named_column_value(i:NamedMode):
    namedColumn i=Pi.single i.1 (0,su7ExteriorBasis 2 (internalBasis i.2.1 i.2.2),0):=by
  rw [namedColumn,LowEnergy.Quantum.wholeBasis,Pi.basis_apply]
  congr 1
  apply Prod.ext
  · simp [LowEnergy.Quantum.internalBasis,rootIndex]
  · apply Prod.ext <;> simp [LowEnergy.Quantum.internalBasis,rootIndex]

private theorem internal_single(T:Module.End ℂ SU7ExteriorSpinorMatterCarrier)(s:Fin 4)
    (x:SU7ExteriorSpinorMatterCarrier):
    internalMatterLinearAction T (Pi.single s x)=Pi.single s (T x):=by
  funext t
  by_cases h:t=s <;> simp [internalMatterLinearAction,h,map_zero]

/-- The original whole Dirac mother action preserves the named twelve columns, before any endpoint compression. -/
theorem actual_color_dirac_column(A:SU3BlockLieMatrix)(i:NamedMode):
    diracExteriorMotherLieAction (colorMother A) (namedColumn i)=
      ∑r:Fin 3,A.val r i.2.1 • namedColumn (i.1,r,i.2.2):=by
  rw [named_column_value,diracExteriorMotherLieAction,internal_single]
  have hi:exteriorSpinorMotherLieAction (colorMother A) (0,su7ExteriorBasis 2 (internalBasis i.2.1 i.2.2),0)=
      ∑r:Fin 3,A.val r i.2.1 • (0,su7ExteriorBasis 2 (internalBasis r i.2.2),0):=by
    apply Prod.ext
    · simp [exteriorSpinorMotherLieAction,Prod.fst_sum]
    · apply Prod.ext
      · simpa only [exteriorSpinorMotherLieAction,LinearMap.prodMap_apply,Prod.fst_sum,Prod.snd_sum,
          Prod.smul_mk,Prod.fst] using actual_color_exterior_column A i.2.1 i.2.2
      · simp [exteriorSpinorMotherLieAction,Prod.snd_sum]
  rw [hi]
  simp_rw [named_column_value]
  funext j
  by_cases h:j=i.1 <;> simp [h,Finset.sum_apply,Pi.smul_apply]

private theorem native_matrix_identity(A:SU3BlockLieMatrix):
    GaussNativeMatter.nativePrimal (colorNative A)=
      LowEnergy.Quantum.operatorMatrix (diracExteriorMotherLieAction (colorMother A)):=by
  change LowEnergy.Quantum.operatorMatrix (diracExteriorMotherLieAction
    (p286LieBlockEmbed (p286CoordinateEquiv.symm (p286CoordinateEquiv (colorData A)))))=_
  rw [p286CoordinateEquiv.symm_apply_apply]
  rfl

/-- Full 252-dimensional color columns are generated by the actual P286 block action; no leakage witness is supplied. -/
theorem actual_color_matrix_column(A:SU3BlockLieMatrix)(i:NamedMode):
    GaussNativeMatter.nativePrimal (colorNative A)*ᵥ Pi.single (rootIndex i) 1=
      ∑r:Fin 3,A.val r i.2.1 • Pi.single (rootIndex (i.1,r,i.2.2)) 1:=by
  rw [native_matrix_identity,←actual_named_column_coordinates,LowEnergy.Quantum.matrix_action,
    actual_color_dirac_column,map_sum]
  simp_rw [map_smul,actual_named_column_coordinates]

private theorem matrix_entry(A:SU3BlockLieMatrix)(i:NamedMode)(j:LowEnergy.Quantum.Index):
    GaussNativeMatter.nativePrimal (colorNative A) j (rootIndex i)=
      ∑r:Fin 3,A.val r i.2.1*(if j=rootIndex (i.1,r,i.2.2) then 1 else 0):=by
  have h:=congrFun (actual_color_matrix_column A i) j
  simpa only [Matrix.mulVec, dotProduct, Pi.single_apply,mul_ite,mul_one,mul_zero,
    Finset.sum_ite_eq',Finset.mem_univ,ite_true,Finset.sum_apply,Pi.smul_apply,smul_eq_mul] using h

def colorEntry(dual:Bool)(A:SU3BlockLieMatrix)(r c:Fin 3):ℂ:=if dual then star (A.val r c) else A.val r c

/-- The independent dual branch is the original full504 conjugate action, not a second selected color matrix. -/
theorem actual_full_color_matrix_column(A:SU3BlockLieMatrix)(dual:Bool)(i:NamedMode)(j:Mode):
    GaussNativeMatter.nativeFull (colorNative A) j (rootMode dual i)=
      ∑r:Fin 3,colorEntry dual A r i.2.1*(if j=rootMode dual (i.1,r,i.2.2) then 1 else 0):=by
  cases dual with
  | false =>
    cases j with
    | inl j => simpa [GaussNativeMatter.nativeFull,rootMode,colorEntry] using matrix_entry A i j
    | inr j => simp [GaussNativeMatter.nativeFull,rootMode,colorEntry]
  | true =>
    cases j with
    | inl j => simp [GaussNativeMatter.nativeFull,rootMode,colorEntry]
    | inr j =>
      have h:=congrArg star (matrix_entry A i j)
      simpa [GaussNativeMatter.nativeFull,rootMode,colorEntry,star_sum,star_mul,apply_ite] using h

end LowEnergy.MixedSpectatorCandidate
