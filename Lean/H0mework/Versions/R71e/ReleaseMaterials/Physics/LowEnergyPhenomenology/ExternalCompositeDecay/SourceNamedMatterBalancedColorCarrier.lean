set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 2048
noncomputable section
namespace LowEnergy.NamedColorQtNext
open SaturationMonoid SaturationMonoid.PhysicsCore
open NamedMatterWedgeQt SU7MotherLieAlgebra QuantizationCheck.Fermion
open SourceQuantumConfigurationHilbert SourceQuantumFockGauge
open scoped BigOperators InnerProductSpace
attribute [local instance] SourceRealScalarFock.branchOrder
local instance : DecidableEq Mode:=SourceRealScalarFock.branchOrder.toDecidableEq

abbrev ColorSpinAssignment:=Fin 3→Fin 4
def balancedModes(t:ColorSpinAssignment):Fin 3↪NamedMode:=⟨fun c=>(t c,c),by
  intro i j h
  exact congrArg Prod.snd h⟩
def balancedIndex(t:ColorSpinAssignment):WedgeIndex:=
  ⟨Finset.univ.map (balancedModes t),by simp⟩

theorem balanced_index_mem(t:ColorSpinAssignment)(i:NamedMode):
    i∈(balancedIndex t).val ↔ i.1=t i.2:=by
  rcases i with ⟨s,c⟩
  simp [balancedIndex,balancedModes,Prod.mk.injEq,eq_comm]

private theorem triple_mem(w:WedgeIndex)(p:Fin 3):tripleIndex w p∈w.val:=by
  rw [←tripleIndex_set w]
  fin_cases p <;> simp

private theorem triple_surjective(w:WedgeIndex)(i:NamedMode)(hi:i∈w.val):
    ∃p:Fin 3,tripleIndex w p=i:=by
  rw [←tripleIndex_set w] at hi
  simp only [Finset.mem_insert,Finset.mem_singleton] at hi
  rcases hi with h | h | h
  · exact ⟨0,h.symm⟩
  · exact ⟨1,h.symm⟩
  · exact ⟨2,h.symm⟩

private theorem injective_three(c:Fin 3→Fin 3):
    Function.Injective c ↔ c 0≠c 1 ∧ c 0≠c 2 ∧ c 1≠c 2:=by
  constructor
  · intro h
    exact ⟨h.ne (by decide),h.ne (by decide),h.ne (by decide)⟩
  · rintro ⟨h01,h02,h12⟩ i j hij
    fin_cases i <;> fin_cases j <;> simp_all

theorem actual_balanced_index(t:ColorSpinAssignment):colorBalanced (balancedIndex t):=by
  unfold colorBalanced
  apply (injective_three (fun p => (tripleIndex (balancedIndex t) p).2)).mp
  intro p q hpq
  dsimp only at hpq
  apply (tripleIndex (balancedIndex t)).injective
  apply Prod.ext
  · rw [(balanced_index_mem t _).mp (triple_mem _ p),
      (balanced_index_mem t _).mp (triple_mem _ q),hpq]
  · exact hpq

theorem balanced_index_injective:Function.Injective balancedIndex:=by
  intro t u h
  funext c
  have hm:(t c,c)∈(balancedIndex u).val:=by
    rw [←h]
    exact (balanced_index_mem t _).mpr rfl
  exact (balanced_index_mem u _).mp hm

/-- Every zero-weight occupation is generated by the actual one-mode-per-color assignment. -/
theorem actual_balanced_index_surjective(w:WedgeIndex)(hw:colorBalanced w):
    ∃t:ColorSpinAssignment,balancedIndex t=w:=by
  have hc:Function.Injective (fun p:Fin 3=>(tripleIndex w p).2):=(injective_three _).mpr hw
  have hs:Function.Surjective (fun p:Fin 3=>(tripleIndex w p).2):=Finite.surjective_of_injective hc
  choose pick hp using hs
  let t:ColorSpinAssignment:=fun c=>(tripleIndex w (pick c)).1
  have hm(i:NamedMode)(hi:i∈w.val):i.1=t i.2:=by
    obtain ⟨p,rfl⟩:=triple_surjective w i hi
    have h:pick (tripleIndex w p).2=p:=hc (hp _)
    simp only [t,h]
  refine ⟨t,Subtype.ext ?_⟩
  symm
  apply Finset.eq_of_subset_of_card_le
  · intro i hi
    exact (balanced_index_mem t i).mpr (hm i hi)
  · rw [w.property,(balancedIndex t).property]

def balancedFiber(dual:Bool)(t:ColorSpinAssignment):FockFiber:=
  orderedTriple dual (t 0,0) (t 1,1) (t 2,2)
private def balancedPhase(dual:Bool)(t:ColorSpinAssignment):ℂ:=
  sign (rootMode dual (t 1,1)) {rootMode dual (t 2,2)}*
    sign (rootMode dual (t 0,0)) {rootMode dual (t 1,1),rootMode dual (t 2,2)}

private theorem balanced_index_set(t:ColorSpinAssignment):
    (balancedIndex t).val={(t 0,0),(t 1,1),(t 2,2)}:=by
  have hu:(Finset.univ:Finset (Fin 3))={0,1,2}:=by decide
  simp [balancedIndex,balancedModes,hu]

private theorem balanced_fiber_return(dual:Bool)(t:ColorSpinAssignment):
    balancedFiber dual t=balancedPhase dual t • fiberBasis dual (balancedIndex t):=by
  rw [balancedFiber,actual_ordered_triple]
  · congr 1
    apply PiLp.ext
    intro w
    simp [fiberBasis,occupationFiber,balanced_index_set,EuclideanSpace.single]
  all_goals simp [Prod.mk.injEq]

private theorem balanced_phase_square(dual:Bool)(t:ColorSpinAssignment):
    balancedPhase dual t*balancedPhase dual t=1:=by
  unfold balancedPhase
  calc
    _=(sign (rootMode dual (t 1,1)) {rootMode dual (t 2,2)}*
       sign (rootMode dual (t 1,1)) {rootMode dual (t 2,2)})*
      (sign (rootMode dual (t 0,0)) {rootMode dual (t 1,1),rootMode dual (t 2,2)}*
       sign (rootMode dual (t 0,0)) {rootMode dual (t 1,1),rootMode dual (t 2,2)}):=by ring
    _=1:=by rw [QuantizationCheck.Fermion.sign_mul_self,QuantizationCheck.Fermion.sign_mul_self,mul_one]

private theorem basis_from_balanced(dual:Bool)(t:ColorSpinAssignment):
    fiberBasis dual (balancedIndex t)=balancedPhase dual t • balancedFiber dual t:=by
  rw [balanced_fiber_return,smul_smul,balanced_phase_square,one_smul]

theorem actual_balanced_pair(dual:Bool)(t u:ColorSpinAssignment):
    inner ℂ (balancedFiber dual t) (balancedFiber dual u)=if t=u then 1 else 0:=by
  rw [balanced_fiber_return,balanced_fiber_return,inner_smul_left,inner_smul_right,actual_fiber_pair]
  by_cases h:t=u
  · subst u
    simp only [ite_true,mul_one,starRingEnd_apply]
    have hs:star (balancedPhase dual t)=balancedPhase dual t:=by
      simp only [balancedPhase,star_mul,LowEnergy.Fermion.star_sign]
      ring
    rw [hs,balanced_phase_square]
  · have hw:balancedIndex t≠balancedIndex u:=fun he=>h (balanced_index_injective he)
    simp [h,hw]

abbrev BalancedFiber:=EuclideanSpace ℂ ColorSpinAssignment
def balancedLift(dual:Bool):BalancedFiber→ₗ[ℂ]FockFiber where
  toFun b:=∑t:ColorSpinAssignment,b t • balancedFiber dual t
  map_add' a b:=by simp only [PiLp.add_apply,add_smul,Finset.sum_add_distrib]
  map_smul' c a:=by simp only [PiLp.smul_apply,smul_eq_mul,smul_smul,Finset.smul_sum,RingHom.id_apply]

private theorem balanced_single(dual:Bool)(t:ColorSpinAssignment):
    balancedLift dual (EuclideanSpace.single t 1)=balancedFiber dual t:=by
  classical
  change (∑u:ColorSpinAssignment,(EuclideanSpace.single t (1:ℂ)) u • balancedFiber dual u)=_
  simp only [PiLp.single_apply,ite_smul,one_smul,zero_smul,Finset.sum_ite_eq',Finset.mem_univ,ite_true]

theorem actual_balanced_lift_pair(dual:Bool)(a b:BalancedFiber):
    inner ℂ (balancedLift dual a) (balancedLift dual b)=inner ℂ a b:=by
  classical
  change inner ℂ (∑t,a t • balancedFiber dual t) (∑u,b u • balancedFiber dual u)=_
  simp only [sum_inner,inner_sum,inner_smul_left,inner_smul_right,actual_balanced_pair,starRingEnd_apply]
  simp [mul_ite,PiLp.inner_apply,RCLike.inner_apply,mul_comm]

/-- Actual source color invariance generates a 64-column balanced carrier; no range certificate is supplied. -/
theorem actual_color_kernel_balanced_carrier(dual:Bool)(a:WedgeFiber)
    (h:∀A:SU3BlockLieMatrix,GaussNativeMatter.nativeFock (colorNative A) (wedgeFiber dual a)=0):
    ∃b:BalancedFiber,balancedLift dual b=wedgeFiber dual a:=by
  change wedgeFiber dual a∈LinearMap.range (balancedLift dual)
  unfold wedgeFiber
  apply Submodule.sum_mem
  intro w _
  by_cases hw:colorBalanced w
  · obtain ⟨t,ht⟩:=actual_balanced_index_surjective w hw
    rw [←ht,basis_from_balanced]
    apply Submodule.smul_mem
    apply Submodule.smul_mem
    exact ⟨EuclideanSpace.single t 1,balanced_single dual t⟩
  · rw [actual_color_kernel_balanced_support dual a h w hw,zero_smul]
    exact Submodule.zero_mem _

