private abbrev End := QuantumTest →ₗ[ℂ] QuantumTest
attribute [local irreducible] embed sourcePair literalCoreResolvent literalSharpResolvent
  sourceOrbit sourceSpace literalResponse diagonalAction detector coherentSource
  ActualFourBlockRetarded.density ActualFourBlockRetarded.output

def current (p : Kinematics) : End := diagonalAction * detector p - detector p * diagonalAction

private theorem current_pair (p : Kinematics) (u : QuantumTest) :
    sourcePair u (current p u) = sourcePair (diagonalAction u) (detector p u) -
      star (sourcePair (diagonalAction u) (detector p u)) := by
  have hs : sourcePair u (current p u) =
      sourcePair u (diagonalAction (detector p u)) -
        sourcePair u (detector p (diagonalAction u)) := by
    simp only [current, LinearMap.sub_apply, Module.End.mul_apply, sourcePair, map_sub,
      inner_sub_right]
  have hh := diagonalAction_pair u (detector p u)
  have hc := actual_detector_hermitian p u (diagonalAction u)
  have hp := GaussNativeForm.pair_conjugate (diagonalAction u) (detector p u)
  exact hs.trans ((congrArg₂ (fun a b : ℂ => a-b) hh hc).trans
    (congrArg (fun b : ℂ => sourcePair (diagonalAction u) (detector p u)-b) hp.symm))

private theorem residual (F : Index) (sharp : Bool) (q : QuantumTest) (advanced : Bool)
    (μ : ℝ) (hμ : 0 < μ) (ω : ℝ) :
    diagonalAction (literalResponse F sharp q advanced μ hμ ω) +
      sourceY sharp (literalResponse F sharp q advanced μ hμ ω) =
      q + line (direction advanced*μ) ω • literalResponse F sharp q advanced μ hμ ω +
        defectAction F (literalResponse F sharp q advanced μ hμ ω) := by
  cases sharp
  · have h := literal_full_source_residual F _ (causal_line_nonreal advanced μ ω hμ) q
    simp only [literalResponse, Bool.false_eq_true, ite_false, sourceY,
      GaussFullHamiltonian.fullAction, LinearMap.sub_apply, LinearMap.add_apply,
      LinearMap.smul_apply, Module.End.one_apply] at h ⊢
    linear_combination (norm := module) h
  · have h := literal_sharp_full_source_residual F _ (causal_line_nonreal advanced μ ω hμ) q
    simp only [literalResponse, ite_true, sourceY, GaussFullHamiltonian.sharpAction,
      LinearMap.sub_apply, LinearMap.add_apply, LinearMap.smul_apply, Module.End.one_apply] at h ⊢
    linear_combination (norm := module) h

/-- The detector is generated by the actual coherent four-block operator.
External transfer is fixed independently of the response frequency. -/
theorem actual_optical_balance (F : Index) (sharp : Bool) (q : QuantumTest) (p : Kinematics)
    (advanced : Bool) (μ : ℝ) (hμ : 0 < μ) (ω : ℝ) :
    let u := literalResponse F sharp q advanced μ hμ ω
    (direction advanced*μ) * ActualFourBlockRetarded.density F sharp q p advanced μ hμ ω =
      (sourcePair q (detector p u)).im - (sourcePair u (current p u)).im/2 -
        (sourcePair (sourceY sharp u) (detector p u)).im +
          (sourcePair (defectAction F u) (detector p u)).im := by
  dsimp only
  let u := literalResponse F sharp q advanced μ hμ ω
  have h := congrArg (fun v : QuantumTest => (sourcePair v (detector p u)).im)
    (residual F sharp q advanced μ hμ ω)
  have hc := congrArg Complex.im (current_pair p u)
  have hz : (sourcePair u (detector p u)).im = 0 := by
    rw [actual_detector_pair, sourcePair]
    exact inner_self_im (𝕜 := ℂ) _
  have hi : (sourcePair u (detector p u)).re =
      ActualFourBlockRetarded.density F sharp q p advanced μ hμ ω := by
    rw [actual_detector_intensity]
    unfold ActualFourBlockRetarded.density ActualFourBlockRetarded.output
    change ((‖embed (coherentSource p u)‖ : ℂ)^2).re = ‖embed (coherentSource p u)‖^2
    norm_cast
  simp only [sourcePair, map_add, map_smul, inner_add_left, inner_smul_left,
    Complex.add_im, Complex.mul_im, Complex.conj_re, Complex.conj_im] at h
  dsimp only [u] at h hc hz hi ⊢
  simp only [sourcePair] at hc hz hi ⊢
  rw [hz, line_im] at h
  simp only [Complex.sub_im, Complex.star_def, Complex.conj_im] at hc
  linear_combination h + hc/2 - (FullYPairedParseval.direction advanced*μ)*hi

/-- All four optical terms have paid full-frequency L1 cost. The incident
imaginary amplitude is paid by the actual balance, without a new tail premise. -/
theorem actual_optical_terms_integrable (F : Index) (sharp : Bool) (q : QuantumTest)
    (p : Kinematics) (advanced : Bool) (μ : ℝ) (hμ : 0 < μ) :
    let u := literalResponse F sharp q advanced μ hμ
    Integrable (fun ω : ℝ => (sourcePair q (detector p (u ω))).im) ∧
    Integrable (fun ω : ℝ => (sourcePair (u ω) (current p (u ω))).im) ∧
    Integrable (fun ω : ℝ => (sourcePair (sourceY sharp (u ω)) (detector p (u ω))).im) ∧
    Integrable (fun ω : ℝ => (sourcePair (defectAction F (u ω)) (detector p (u ω))).im) := by
  dsimp only
  let u := literalResponse F sharp q advanced μ hμ
  have hc : Integrable (fun ω : ℝ => (sourcePair (u ω) (current p (u ω))).im) := by
    simpa only [Module.End.one_apply, RCLike.im_to_complex, u] using
      (CompositeChannelOptical.actual_word_pair_integrable F sharp q advanced μ hμ
        (1 : End) (current p)).im
  have hy : Integrable (fun ω : ℝ =>
      (sourcePair (sourceY sharp (u ω)) (detector p (u ω))).im) :=
    (CompositeChannelOptical.actual_word_pair_integrable F sharp q advanced μ hμ
      (sourceY sharp) (detector p)).im
  have hd : Integrable (fun ω : ℝ =>
      (sourcePair (defectAction F (u ω)) (detector p (u ω))).im) :=
    (CompositeChannelOptical.actual_word_pair_integrable F sharp q advanced μ hμ
      (defectAction F) (detector p)).im
  refine ⟨?_,hc,hy,hd⟩
  have hp := ActualFourBlockRetarded.actual_density_integrable F sharp q p advanced μ hμ
  apply ((((hp.const_mul (direction advanced*μ)).add (hc.div_const 2)).add hy).sub hd).congr
  apply Eventually.of_forall
  intro ω
  have h := actual_optical_balance F sharp q p advanced μ hμ ω
  dsimp only at h ⊢
  dsimp only [u] at hc hy hd ⊢
  simp only [Pi.add_apply, Pi.sub_apply]
  linarith only [h]

private theorem integral_four (i c y d : ℝ → ℝ) (hi : Integrable i) (hc : Integrable c)
    (hy : Integrable y) (hd : Integrable d) (S : Set ℝ) :
    (∫ω in S,i ω-c ω/2-y ω+d ω) =
      (∫ω in S,i ω)-(∫ω in S,c ω)/2-(∫ω in S,y ω)+(∫ω in S,d ω) := by
  have h1 := integral_add ((hi.sub (hc.div_const 2)).sub hy).restrict hd.restrict
    (μ := volume.restrict S)
  have h2 := integral_sub (hi.sub (hc.div_const 2)).restrict hy.restrict (μ := volume.restrict S)
  have h3 := integral_sub hi.restrict (hc.div_const 2).restrict (μ := volume.restrict S)
  have h4 := integral_div (μ := volume.restrict S) 2 c
  simp only [Pi.sub_apply] at h1 h2 h3
  linarith only [h1,h2,h3,h4]

theorem actual_optical_integral (F : Index) (sharp : Bool) (q : QuantumTest) (p : Kinematics)
    (advanced : Bool) (μ : ℝ) (hμ : 0 < μ) (S : Set ℝ) :
    let u := literalResponse F sharp q advanced μ hμ
    (direction advanced*μ) *
      (∫ω in S,ActualFourBlockRetarded.density F sharp q p advanced μ hμ ω) =
      (∫ω in S,(sourcePair q (detector p (u ω))).im) -
        (∫ω in S,(sourcePair (u ω) (current p (u ω))).im)/2 -
          (∫ω in S,(sourcePair (sourceY sharp (u ω)) (detector p (u ω))).im) +
            (∫ω in S,(sourcePair (defectAction F (u ω)) (detector p (u ω))).im) := by
  dsimp only
  obtain ⟨hi,hc,hy,hd⟩ := actual_optical_terms_integrable F sharp q p advanced μ hμ
  have he := integral_congr_ae (μ := volume.restrict S)
    (Eventually.of_forall (actual_optical_balance F sharp q p advanced μ hμ))
  rw [integral_const_mul] at he
  exact he.trans (integral_four _ _ _ _ hi hc hy hd S)

/-- The same coherent positive band measure is paid by its actual detector
absorptive amplitude, complete H0 current, full Y and own compression defect. -/
theorem actual_optical_measure (F : Index) (sharp : Bool) (q : QuantumTest) (p : Kinematics)
    (advanced : Bool) (μ : ℝ) (hμ : 0 < μ) (S : Set ℝ) (hS : MeasurableSet S) :
    let u := literalResponse F sharp q advanced μ hμ
    ENNReal.ofReal μ * ActualFourBlockRetarded.spectrum F sharp q p advanced μ hμ S =
      ENNReal.ofReal (direction advanced *
        ((∫ω in S,(sourcePair q (detector p (u ω))).im) -
          (∫ω in S,(sourcePair (u ω) (current p (u ω))).im)/2 -
            (∫ω in S,(sourcePair (sourceY sharp (u ω)) (detector p (u ω))).im) +
              (∫ω in S,(sourcePair (defectAction F (u ω)) (detector p (u ω))).im))) := by
  dsimp only
  rw [(ActualFourBlockRetarded.actual_spectrum_bands F sharp q p advanced μ hμ).1 S hS,
    ←ENNReal.ofReal_mul hμ.le]
  congr 1
  have h := actual_optical_integral F sharp q p advanced μ hμ S
  dsimp only at h
  cases advanced <;> simp only [FullYPairedParseval.direction, Bool.false_eq_true, ite_false, ite_true,
    one_mul, neg_one_mul] at h ⊢
  · exact h
  · linarith only [h]

