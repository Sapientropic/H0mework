private abbrev End := QuantumTest →ₗ[ℂ] QuantumTest
private abbrev HF(F:Index)(sharp:Bool):End := compressionCore F+sourceY sharp
private abbrev shiftedGenerator (F:Index)(sharp advanced:Bool)(μ:ℝ):End :=
  (-μ:ℂ) • (1:End)+((-Complex.I)*(direction advanced:ℂ)) • HF F sharp
attribute [local irreducible] embed literalCoreTime sourceReader sourceOrbit sourceSpace sourceY

private theorem shifted_power_return {V:Type*} [AddCommGroup V] [Module ℂ V]
    (X Y:V→ₗ[ℂ]V)(q:V)(c d:ℂ)(n:ℕ)
    (h:∀k:ℕ,k≤n → (X^k) q=(Y^k) q):
    ((c • (1:V→ₗ[ℂ]V)+d • X)^n) q=((c • (1:V→ₗ[ℂ]V)+d • Y)^n) q := by
  have hx:Commute (c • (1:V→ₗ[ℂ]V)) (d • X) := ((Commute.one_left X).smul_left c).smul_right d
  have hy:Commute (c • (1:V→ₗ[ℂ]V)) (d • Y) := ((Commute.one_left Y).smul_left c).smul_right d
  rw [hx.add_pow,hy.add_pow]
  simp only [LinearMap.sum_apply]
  apply Finset.sum_congr rfl
  intro k hk
  have hn:n-k≤n := Nat.sub_le _ _
  simp only [smul_pow,one_pow,mul_smul_comm,smul_mul_assoc,smul_smul,
    Module.End.mul_apply,Module.End.one_apply,LinearMap.smul_apply]
  simp only [Module.End.natCast_apply,map_nsmul,h (n-k) hn]

def dampedTimeJet(F:Index)(sharp:Bool)(q:QuantumTest)(A:End)(advanced:Bool)(μ:ℝ)(n:ℕ)(t:ℝ):H :=
  (Real.exp (-μ*t):ℂ) • embed (A ((shiftedGenerator F sharp advanced μ^n)
    (literalCoreTime F sharp q (direction advanced*t))))

/-- The damped jet is generated by the same actual compressed source time;
its exponential factor is independent of the physical width. -/
theorem actual_damped_time_jet_derivative(F:Index)(sharp:Bool)(q:QuantumTest)(A:End)
    (advanced:Bool)(μ:ℝ)(n:ℕ)(t:ℝ):
    HasDerivAt (dampedTimeJet F sharp q A advanced μ n)
      (dampedTimeJet F sharp q A advanced μ (n+1) t) t := by
  let B := A*(shiftedGenerator F sharp advanced μ)^n
  have hdir:HasDerivAt (fun s:ℝ=>direction advanced*s) (direction advanced) t := by
    simpa only [mul_one,id_eq] using! (hasDerivAt_id t).const_mul (direction advanced)
  have ht := (actual_time_word_derivative F sharp q B (direction advanced*t)).scomp t
    hdir
  have he := ((hasDerivAt_id t).const_mul (-μ)).exp
  have hc := Complex.ofRealCLM.hasFDerivAt.comp_hasDerivAt t he
  have hd := hc.smul ht
  simp only [Complex.ofRealCLM_apply,Function.comp_def,id_eq,mul_one] at hd
  apply hd.congr_of_eventuallyEq (Eventually.of_forall (fun s=>by rfl)) |>.congr_deriv
  dsimp only [dampedTimeJet,B,Function.comp_def]
  simp only [shiftedGenerator,pow_succ,Module.End.mul_apply,LinearMap.add_apply,LinearMap.smul_apply,
    Module.End.one_apply,map_add,map_smul,smul_smul,smul_add]
  simp only [Complex.ofReal_mul,Complex.ofReal_neg]
  module

private theorem positive_continuous(u:ℝ→H)(hu:Continuous u)(h0:u 0=0):
    Continuous ((Ioi (0:ℝ)).indicator u) := by
  apply continuous_indicator _ hu.continuousOn
  intro t ht
  have h:t=0 := by simpa only [frontier_Ioi,mem_singleton_iff] using ht
  simpa only [h] using h0

private theorem positive_derivative(u v:ℝ→H)(hu:∀t:ℝ,HasDerivAt u (v t) t)
    (hv:Continuous v)(h0:u 0=0)(h1:v 0=0):
    ∀t:ℝ,HasDerivAt ((Ioi (0:ℝ)).indicator u) ((Ioi (0:ℝ)).indicator v t) t := by
  have hne:∀t:ℝ,t≠0 → HasDerivAt ((Ioi (0:ℝ)).indicator u) ((Ioi (0:ℝ)).indicator v t) t := by
    intro t htz
    by_cases ht:0<t
    · rw [indicator_of_mem (show t∈Ioi (0:ℝ) from ht)]
      apply (hu t).congr_of_eventuallyEq
      filter_upwards [Ioi_mem_nhds ht] with s hs
      exact indicator_of_mem hs u
    · have hn:t<0 := lt_of_le_of_ne (le_of_not_gt ht) htz
      rw [indicator_of_notMem (show t∉Ioi (0:ℝ) from ht)]
      apply (hasDerivAt_const t (0:H)).congr_of_eventuallyEq
      filter_upwards [Iio_mem_nhds hn] with s hs
      exact indicator_of_notMem (show s∉Ioi (0:ℝ) by exact not_lt_of_ge (le_of_lt (show s<0 from hs))) u
  intro t
  by_cases ht:t=0
  · subst t
    exact hasDerivAt_of_hasDerivAt_of_ne hne
      (positive_continuous u (continuous_iff_continuousAt.mpr (fun s=>(hu s).continuousAt)) h0).continuousAt
      (positive_continuous v hv h1).continuousAt
  · exact hne t ht

/-- The source-generated event captures every prescribed initial time jet
before either causal direction, damping or core word is selected. -/
theorem actual_cofinal_damped_initial_jets(B:Index)(q:QuantumTest)(N:ℕ):
    ∃K₀:Index,B⊆K₀ ∧ ∀F:Index,K₀⊆F → ∀G:Index,K₀⊆G →
      ∀sharp advanced:Bool,∀μ:ℝ,∀A:End,∀m:ℕ,m≤N →
      dampedTimeJet F sharp q A advanced μ m 0=dampedTimeJet G sharp q A advanced μ m 0 := by
  obtain ⟨K₀,hB,hK₀⟩ := actual_cofinal_initial_time_jets B q q N
  refine ⟨K₀,hB,fun F hF G hG sharp advanced μ A m hm=>?_⟩
  have hp(K:Index)(hK:K₀⊆K)(k:ℕ)(hk:k≤N):
      (HF K sharp^k) q=((diagonalAction+sourceY sharp)^k) q := by
    have h := hK₀ K hK K hK k hk (1:End)
    have he:(-Complex.I)^k • embed ((HF K sharp^k) q)=
        (-Complex.I)^k • embed (((diagonalAction+sourceY sharp)^k) q) := by
      cases sharp
      · simpa only [actualTimeJet,literal_core_time_zero,Module.End.one_apply] using h.1
      · simpa only [actualTimeJet,literal_core_time_zero,Module.End.one_apply] using h.2
    apply embed_injective
    have hc:(-Complex.I)^k≠0 := pow_ne_zero k (neg_ne_zero.mpr Complex.I_ne_zero)
    have h := congrArg (fun v:H=>((-Complex.I)^k)⁻¹ • v) he
    simpa only [smul_smul,inv_mul_cancel₀ hc,one_smul] using h
  have hpow(k:ℕ)(hk:k ≤ m):(HF F sharp^k) q=(HF G sharp^k) q :=
    (hp F hF k (le_trans hk hm)).trans (hp G hG k (le_trans hk hm)).symm
  have hshift := shifted_power_return (HF F sharp) (HF G sharp) q (-μ:ℂ)
    ((-Complex.I)*(direction advanced:ℂ)) m hpow
  simpa only [dampedTimeJet,mul_zero,Real.exp_zero,Complex.ofReal_one,one_smul,literal_core_time_zero,shiftedGenerator]
    using congrArg (fun r:QuantumTest=>embed (A r)) hshift

def causalRelativeJet(F G:Index)(sharp:Bool)(q:QuantumTest)(A:End)(advanced:Bool)(μ:ℝ)(n:ℕ):ℝ→H :=
  (Ioi (0:ℝ)).indicator (fun t:ℝ=>dampedTimeJet F sharp q A advanced μ n t-
    dampedTimeJet G sharp q A advanced μ n t)

/-- Prescribed source jets cancel at the actual causal endpoint. Their
zero extensions therefore generate a global C^N retarded correction on
one ordinary cofinal event, before direction, damping or core word. -/
theorem actual_cofinal_causal_history_smooth(B:Index)(q:QuantumTest)(N:ℕ):
    ∃K₀:Index,B⊆K₀ ∧ ∀F:Index,K₀⊆F → ∀G:Index,K₀⊆G →
      ∀sharp advanced:Bool,∀μ:ℝ,∀A:End,
      ContDiff ℝ (N:ℕ) (causalRelativeJet F G sharp q A advanced μ 0) ∧
      ∀m:ℕ,m ≤ N → iteratedDeriv m (causalRelativeJet F G sharp q A advanced μ 0) 0=0 := by
  obtain ⟨K₀,hB,hK₀⟩ := actual_cofinal_damped_initial_jets B q N
  refine ⟨K₀,hB,fun F hF G hG sharp advanced μ A=>?_⟩
  let u := fun j:ℕ=>fun t:ℝ=>dampedTimeJet F sharp q A advanced μ j t-
    dampedTimeJet G sharp q A advanced μ j t
  have hu(j:ℕ)(t:ℝ):HasDerivAt (u j) (u (j+1) t) t :=
    (actual_damped_time_jet_derivative F sharp q A advanced μ j t).sub
      (actual_damped_time_jet_derivative G sharp q A advanced μ j t)
  have hc(j:ℕ):Continuous (u j) :=
    continuous_iff_continuousAt.mpr (fun t=>(hu j t).continuousAt)
  have hz(j:ℕ)(hj:j ≤ N):u j 0=0 := by
    dsimp only [u]
    rw [hK₀ F hF G hG sharp advanced μ A j hj,sub_self]
  have hcont(j:ℕ)(hj:j ≤ N):Continuous (causalRelativeJet F G sharp q A advanced μ j) :=
    positive_continuous (u j) (hc j) (hz j hj)
  have hd(j:ℕ)(hj:j+1 ≤ N)(t:ℝ):
      HasDerivAt (causalRelativeJet F G sharp q A advanced μ j)
        (causalRelativeJet F G sharp q A advanced μ (j+1) t) t :=
    positive_derivative (u j) (u (j+1)) (hu j) (hc (j+1))
      (hz j (le_trans (Nat.le_succ j) hj)) (hz (j+1) hj) t
  have hi(j:ℕ)(hj:j ≤ N):iteratedDeriv j (causalRelativeJet F G sharp q A advanced μ 0)=
      causalRelativeJet F G sharp q A advanced μ j := by
    induction j with
    | zero => exact iteratedDeriv_zero
    | succ j ih =>
      rw [iteratedDeriv_succ,ih (le_trans (Nat.le_succ j) hj)]
      funext t
      exact (hd j hj t).deriv
  constructor
  · apply contDiff_nat_iff_iteratedDeriv.mpr
    refine ⟨fun j hj=>?_,fun j hj=>?_⟩
    · rw [hi j hj]
      exact hcont j hj
    · rw [hi j (le_of_lt hj)]
      exact fun t=>(hd j (Nat.succ_le_of_lt hj) t).differentiableAt
  · intro j hj
    rw [hi j hj]
    exact indicator_of_notMem (show (0:ℝ)∉Ioi (0:ℝ) by simp) _

/-- The zero jet is the actual original causal source-wave difference,
without a newly selected time evolution or output state. -/
theorem actual_causal_relative_wave(F G:Index)(sharp:Bool)(q:QuantumTest)(advanced:Bool)(μ:ℝ):
    causalRelativeJet F G sharp q (1:End) advanced μ 0=
      (fun t:ℝ=>sourceWave F sharp q advanced μ t-sourceWave G sharp q advanced μ t) := by
  funext t
  by_cases ht:t∈Ioi (0:ℝ)
  · simp only [causalRelativeJet,dampedTimeJet,pow_zero,Module.End.one_apply,
      sourceWave,causalWave,indicator_of_mem ht]
  · simp only [causalRelativeJet,sourceWave,causalWave,indicator_of_notMem ht,sub_self]

