import H0mework.Versions.R71e.ReleaseMaterials.Physics.LowEnergyPhenomenology.ExternalCompositeDecay.SourceFullYCausalDerivativeFourier
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 2048
noncomputable section
namespace LowEnergy.FullYDynamicCausalJets
open GaussCoreHilbert GaussCoreDifferential GaussHistoryHilbert GaussUnitaryHistory
open FullYDynamicSource FullYPairedParseval MeasureTheory
open scoped FourierTransform
private abbrev End := QuantumTest →ₗ[ℂ] QuantumTest
attribute [local irreducible] sourceWave embed literalCoreTime

private theorem frequency_norm(c:ℝ)(n:ℕ):
    ‖(2*Real.pi*Complex.I*(c:ℂ))^n‖=(2*Real.pi*|c|)^n := by
  simp only [norm_pow,norm_mul,Complex.norm_ofNat,Complex.norm_real,Real.norm_eq_abs,
    Complex.norm_I,mul_one,abs_of_pos Real.pi_pos]

/-- The derivative price is generated by the actual causal source carrier.
Every prescribed frequency power is bounded by that same source L1 norm. -/
theorem actual_cofinal_causal_frequency_price(B:Index)(q:QuantumTest)(N:ℕ):
    ∃K₀:Index,B⊆K₀ ∧ ∀F:Index,K₀⊆F → ∀G:Index,K₀⊆G →
      ∀sharp advanced:Bool,∀μ:ℝ,∀_hμ:0<μ,∀A:End,∀m:ℕ,m ≤ N →
      let u:=causalRelativeJet F G sharp q A advanced μ 0
      Integrable (iteratedDeriv m u) ∧ ∀ξ:ℝ,
        (2*Real.pi*|ξ|)^m*‖𝓕 u ξ‖ ≤ ∫t:ℝ,‖iteratedDeriv m u t‖ := by
  obtain ⟨K₁,hB,hK₁⟩ := actual_cofinal_causal_derivatives_integrable B q N
  obtain ⟨K₂,h₁₂,hK₂⟩ := actual_cofinal_causal_fourier_derivatives K₁ q N
  refine ⟨K₂,Finset.Subset.trans hB h₁₂,fun F hF G hG sharp advanced μ hμ A m hm=>?_⟩
  have hi := (hK₁ F (Finset.Subset.trans h₁₂ hF) G (Finset.Subset.trans h₁₂ hG) sharp advanced μ hμ A).2 m hm
  refine ⟨hi,fun ξ=>?_⟩
  have he := hK₂ F hF G hG sharp advanced μ hμ A m hm ξ
  have h := fourier_bound (iteratedDeriv m (causalRelativeJet F G sharp q A advanced μ 0)) ξ
  rw [he,norm_smul,frequency_norm] at h
  exact h

/-- The frequency price applies to the original full/sharp retarded
history, with no separately supplied Fourier envelope. -/
theorem actual_cofinal_original_wave_frequency_price(B:Index)(q:QuantumTest)(N:ℕ):
    ∃K₀:Index,B⊆K₀ ∧ ∀F:Index,K₀⊆F → ∀G:Index,K₀⊆G →
      ∀sharp advanced:Bool,∀μ:ℝ,∀_hμ:0<μ,∀m:ℕ,m ≤ N →
      let u:=fun t:ℝ=>sourceWave F sharp q advanced μ t-sourceWave G sharp q advanced μ t
      Integrable (iteratedDeriv m u) ∧ ∀ξ:ℝ,
        (2*Real.pi*|ξ|)^m*‖𝓕 u ξ‖ ≤ ∫t:ℝ,‖iteratedDeriv m u t‖ := by
  obtain ⟨K₀,hB,hK₀⟩ := actual_cofinal_causal_frequency_price B q N
  refine ⟨K₀,hB,fun F hF G hG sharp advanced μ hμ m hm=>?_⟩
  have h := hK₀ F hF G hG sharp advanced μ hμ (1:End) m hm
  rw [actual_causal_relative_wave] at h
  exact h

end LowEnergy.FullYDynamicCausalJets
