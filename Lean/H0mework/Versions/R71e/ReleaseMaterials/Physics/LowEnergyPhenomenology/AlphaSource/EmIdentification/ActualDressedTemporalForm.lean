/-- Original action normalization is performed inside the configuration integral, before the full-Fock pair contraction. -/
def temporalActionForm (a : Fin 12) (p : PhysicalMomentum) (l r : QuantumTest) : ℂ :=
  ∫ z, pairSample z (l z)
    (quantized (canonicalPhaseNormalizer (sourceState z))
      (quantized ((Stage10.ActionNormalization.actionScale:ℂ) •
        rawActionSymbol (temporalField a) p (sourceState z)) (r z))-
      pairFiber (canonicalPhaseNormalizer (sourceState z))
        ((Stage10.ActionNormalization.actionScale:ℂ) •
          rawActionSymbol (temporalField a) p (sourceState z)) (r z))
    ∂GaussHistoryHilbert.configurationMeasure

theorem temporal_action_fiber (a : Fin 12) (p : PhysicalMomentum) (r : QuantumTest)
    (z : SourceCoordinateSlice) :
    familyCore (temporalField a) p r z=
      quantized (canonicalPhaseNormalizer (sourceState z))
        (quantized ((Stage10.ActionNormalization.actionScale:ℂ) •
          rawActionSymbol (temporalField a) p (sourceState z)) (r z))-
      pairFiber (canonicalPhaseNormalizer (sourceState z))
        ((Stage10.ActionNormalization.actionScale:ℂ) •
          rawActionSymbol (temporalField a) p (sourceState z)) (r z) := by
  rw [temporal_core]
  by_cases inside : z∈physicalChart
  · change quantized (chargeMatrix (originalUnit a)) (r z)=_
    exact congrArg (fun A : FockFiber→L[ℂ]FockFiber=>A (r z))
      (canonical_temporal_quantized a p (sourceState z) (sourceState_valid ⟨z,inside⟩))
  · have zero : r z=0 := image_eq_zero_of_notMem_tsupport (fun h=>inside (r.tsupport_subset h))
    change quantized (chargeMatrix (originalUnit a)) (r z)=_
    rw [zero,map_zero,map_zero,map_zero,map_zero,sub_self]

/-- The original weighted configuration pairing reads the actual action, with its non-scalar inverse and N2 pair term intact. -/
theorem temporal_action_form (a : Fin 12) (p : PhysicalMomentum) (l r : QuantumTest) :
    temporalActionForm a p l r=sourcePair l (familyCore (temporalField a) p r) := by
  rw [temporalActionForm,sourcePair_integral]
  apply integral_congr_ae
  apply Filter.Eventually.of_forall
  intro z
  dsimp only
  rw [←temporal_action_fiber a p r z,pairSample_source]

/-- The same integral returns the original completed global temporal reader on the same source tests. -/
theorem temporal_action_global_reader (a : Fin 12) (p : PhysicalMomentum) (l r : QuantumTest) :
    temporalActionForm a p l r=inner ℂ (embed l) (globalReader a (embed r)) := by
  rw [temporal_action_form,globalReader_source]
  rfl

/-- This integrability is generated by the original compact source tests; the integral is not a default value for a nonintegrable expression. -/
theorem temporal_action_integrable (a : Fin 12) (p : PhysicalMomentum) (l r : QuantumTest) :
    Integrable (fun z=>pairSample z (l z)
      (quantized (canonicalPhaseNormalizer (sourceState z))
        (quantized ((Stage10.ActionNormalization.actionScale:ℂ) •
          rawActionSymbol (temporalField a) p (sourceState z)) (r z))-
        pairFiber (canonicalPhaseNormalizer (sourceState z))
          ((Stage10.ActionNormalization.actionScale:ℂ) • rawActionSymbol (temporalField a) p (sourceState z)) (r z)))
      GaussHistoryHilbert.configurationMeasure := by
  apply (densityPair_integrable l (familyCore (temporalField a) p r)).congr
  apply Filter.Eventually.of_forall
  intro z
  dsimp only
  rw [←temporal_action_fiber a p r z,pairSample_source]

/-- Literal E retains its own original action field and Lie generator in the same configuration integral. -/
def emActionForm (p : PhysicalMomentum) (l r : QuantumTest) : ℂ :=
  ∫ z, pairSample z (l z)
    (quantized (canonicalPhaseNormalizer (sourceState z))
      (quantized ((Stage10.ActionNormalization.actionScale:ℂ) •
        rawActionSymbol (emGaugeField 0) p (sourceState z)) (r z))-
      pairFiber (canonicalPhaseNormalizer (sourceState z))
        ((Stage10.ActionNormalization.actionScale:ℂ) • rawActionSymbol (emGaugeField 0) p (sourceState z)) (r z))
    ∂GaussHistoryHilbert.configurationMeasure

theorem em_action_fiber (p : PhysicalMomentum) (r : QuantumTest) (z : SourceCoordinateSlice) :
    chargeAction sourcePhaseGaugeLie r z=
      quantized (canonicalPhaseNormalizer (sourceState z))
        (quantized ((Stage10.ActionNormalization.actionScale:ℂ) •
          rawActionSymbol (emGaugeField 0) p (sourceState z)) (r z))-
      pairFiber (canonicalPhaseNormalizer (sourceState z))
        ((Stage10.ActionNormalization.actionScale:ℂ) • rawActionSymbol (emGaugeField 0) p (sourceState z)) (r z) := by
  by_cases inside : z∈physicalChart
  · change quantized (chargeMatrix sourcePhaseGaugeLie) (r z)=_
    rw [←em_noether_matrix_same]
    exact congrArg (fun A : FockFiber→L[ℂ]FockFiber=>A (r z))
      (canonical_em_quantized_return p (sourceState z) (sourceState_valid ⟨z,inside⟩))
  · have zero : r z=0 := image_eq_zero_of_notMem_tsupport (fun h=>inside (r.tsupport_subset h))
    change quantized (chargeMatrix sourcePhaseGaugeLie) (r z)=_
    rw [zero,map_zero,map_zero,map_zero,map_zero,sub_self]

theorem em_action_form (p : PhysicalMomentum) (l r : QuantumTest) :
    emActionForm p l r=sourcePair l (chargeAction sourcePhaseGaugeLie r) := by
  rw [emActionForm,sourcePair_integral]
  apply integral_congr_ae
  apply Filter.Eventually.of_forall
  intro z
  dsimp only
  rw [←em_action_fiber p r z,pairSample_source]

theorem em_action_integrable (p : PhysicalMomentum) (l r : QuantumTest) :
    Integrable (fun z=>pairSample z (l z)
      (quantized (canonicalPhaseNormalizer (sourceState z))
        (quantized ((Stage10.ActionNormalization.actionScale:ℂ) •
          rawActionSymbol (emGaugeField 0) p (sourceState z)) (r z))-
        pairFiber (canonicalPhaseNormalizer (sourceState z))
          ((Stage10.ActionNormalization.actionScale:ℂ) • rawActionSymbol (emGaugeField 0) p (sourceState z)) (r z)))
      GaussHistoryHilbert.configurationMeasure := by
  apply (densityPair_integrable l (chargeAction sourcePhaseGaugeLie r)).congr
  apply Filter.Eventually.of_forall
  intro z
  dsimp only
  rw [←em_action_fiber p r z,pairSample_source]

