/-- The absolute electromagnetic charge on the full source Hilbert space,
    scaled by the generated source action unit. -/
def emAbsoluteCharge : H →L[ℂ] H :=
  (Stage10.ActionNormalization.phaseMomentum:ℂ) • emGaussCharge

/-- The absolute defect charge on the full source Hilbert space. -/
def emAbsoluteDefectCharge : H →L[ℂ] H :=
  (Stage10.ActionNormalization.phaseMomentum:ℂ) • emGaussDefectCharge

/-- The electromagnetic Noether vertex between the two actual
    resolvents. -/
def emNoetherVertex (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum) :
    H →L[ℂ] H :=
  jointResolvent pL q.F q.z 0*emAbsoluteCharge*jointResolvent pR q.F q.w 0

/-- The full electromagnetic Noether response generated by the whole
    original joint generators on both legs. -/
def emNoetherResponse (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum) :
    H →L[ℂ] H :=
  jointResolvent pL q.F q.z 0*
    (jointGenerator pL q.F 0 0*emAbsoluteCharge-
      emAbsoluteCharge*jointGenerator pR q.F 0 0)*jointResolvent pR q.F q.w 0

/-- The defect Noether vertex between the two actual resolvents. -/
def emDefectVertex (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum) :
    H →L[ℂ] H :=
  jointResolvent pL q.F q.z 0*emAbsoluteDefectCharge*jointResolvent pR q.F q.w 0

/-- The full defect Noether response on the same actual resolvent legs. -/
def emDefectResponse (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum) :
    H →L[ℂ] H :=
  jointResolvent pL q.F q.z 0*
    (jointGenerator pL q.F 0 0*emAbsoluteDefectCharge-
      emAbsoluteDefectCharge*jointGenerator pR q.F 0 0)*
        jointResolvent pR q.F q.w 0

/-- The inverse-Ward algebra with both actual material inverses retained. -/
private theorem em_inverse_ward {R : Type*} [Ring R] [Algebra ℂ R]
    (CLeft CRight invLeft invRight Q : R) (z w : ℂ)
    (left : invLeft*(CLeft-z • 1)=1) (right : (CRight-w • 1)*invRight=1) :
    (z-w) • (invLeft*Q*invRight)=
      invLeft*Q-Q*invRight+invLeft*(CLeft*Q-Q*CRight)*invRight := by
  have l : invLeft*CLeft=1+z • invLeft := by
    have h:=left
    rw [mul_sub,mul_smul_comm,mul_one] at h
    exact sub_eq_iff_eq_add.mp h
  have r : CRight*invRight=1+w • invRight := by
    have h:=right
    rw [sub_mul,smul_mul_assoc,one_mul] at h
    exact sub_eq_iff_eq_add.mp h
  have generated : invLeft*(CLeft*Q-Q*CRight)*invRight=
      Q*invRight-invLeft*Q+(z-w) • (invLeft*Q*invRight) := by
    calc
      _=(invLeft*CLeft)*Q*invRight-invLeft*Q*(CRight*invRight) := by noncomm_ring
      _=(1+z • invLeft)*Q*invRight-invLeft*Q*(1+w • invRight) := by rw [l,r]
      _=_ := by
        simp only [add_mul,mul_add,one_mul,mul_one,smul_mul_assoc,mul_smul_comm,sub_smul]
        abel
  rw [generated]
  abel

/-- The electromagnetic full-resolvent Ward identity: spectral subtraction,
    both endpoints, and the whole original generator response — with the
    defect retained inside the same actual resolvents, not truncated. -/
theorem em_full_ward (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum)
    (left : q.z.im≠0) (right : q.w.im≠0) :
    (q.z-q.w) • emNoetherVertex q pL pR=
      jointResolvent pL q.F q.z 0*emAbsoluteCharge-
        emAbsoluteCharge*jointResolvent pR q.F q.w 0+
          emNoetherResponse q pL pR := by
  exact em_inverse_ward _ _ _ _ _ _ _ (sourceMaterialInverse_left pL q.F q.z left)
    (sourceMaterialInverse_right pR q.F q.w right)

/-- The original absolute charge is the electromagnetic plus defect
    charges, with the defect retained throughout the actual resolvents. -/
theorem em_original_charge_decomposition :
    sourceAbsoluteCharge=emAbsoluteCharge+emAbsoluteDefectCharge := by
  rw [sourceAbsoluteCharge,emAbsoluteCharge,emAbsoluteDefectCharge,
    em_gauss_charge_decomposition,smul_add]

/-- The original Noether vertex decomposes into the electromagnetic and
    defect vertices on the same two actual resolvents. -/
theorem em_original_vertex_decomposition (q : PhysicalResponsePoint)
    (pL pR : PhysicalMomentum) :
    sourceAbsoluteNoetherVertex q pL pR=
      emNoetherVertex q pL pR+emDefectVertex q pL pR := by
  rw [sourceAbsoluteNoetherVertex,emNoetherVertex,emDefectVertex,
    em_original_charge_decomposition]
  noncomm_ring

/-- The original Noether response decomposes into the electromagnetic and
    defect responses generated by the same whole joint generators. -/
theorem em_original_response_decomposition (q : PhysicalResponsePoint)
    (pL pR : PhysicalMomentum) :
    sourceAbsoluteNoetherResponse q pL pR=
      emNoetherResponse q pL pR+emDefectResponse q pL pR := by
  rw [sourceAbsoluteNoetherResponse,emNoetherResponse,emDefectResponse,
    em_original_charge_decomposition]
  simp only [sub_eq_add_neg,neg_add,mul_add,add_mul]
  noncomm_ring

/-- The electromagnetic charge on the two prepared ends, inside the actual
    source quantum readout. -/
private theorem emPreparedCharge_ends (q : PhysicalResponsePoint)
    (sL eL sR eR : Fin 2) (A : H →L[ℂ] H) :
    sourceQuantumChargedRead q sL eL sR eR (emAbsoluteCharge*A)=
      (Stage10.ActionNormalization.phaseMomentum:ℂ)*(sourceActualPhaseCharge eL:ℂ)*
        sourceQuantumChargedRead q sL eL sR eR A ∧
    sourceQuantumChargedRead q sL eL sR eR (A*emAbsoluteCharge)=
      (Stage10.ActionNormalization.phaseMomentum:ℂ)*(sourceActualPhaseCharge eR:ℂ)*
        sourceQuantumChargedRead q sL eL sR eR A := by
  simp only [sourceQuantumChargedRead,ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.apply_apply,innerSL_apply_apply,mul_apply_eq_comp,
    emAbsoluteCharge]
  constructor
  · rw [smul_apply,inner_smul_right]
    rw [←em_gauss_pair,em_gauss_prepared,inner_smul_left]
    rw [starRingEnd_apply]
    have realq : star (↑(sourceActualPhaseCharge eL):ℂ)=
        ↑(sourceActualPhaseCharge eL):=by simp
    rw [realq]
    ring
  · rw [smul_apply,map_smul,em_gauss_prepared,map_smul,smul_smul,inner_smul_right]

/-- The scalar actual-source charged readout of the electromagnetic full
    Ward identity on all four bilateral charged/neutral combinations. -/
theorem em_prepared_ward (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum)
    (sL eL sR eR : Fin 2) (left : q.z.im≠0) (right : q.w.im≠0) :
    (q.z-q.w)*sourceQuantumChargedRead q sL eL sR eR (emNoetherVertex q pL pR)=
      (Stage10.ActionNormalization.phaseMomentum:ℂ)*(sourceActualPhaseCharge eR:ℂ)*
        sourceQuantumChargedRead q sL eL sR eR (jointResolvent pL q.F q.z 0)-
      (Stage10.ActionNormalization.phaseMomentum:ℂ)*(sourceActualPhaseCharge eL:ℂ)*
        sourceQuantumChargedRead q sL eL sR eR (jointResolvent pR q.F q.w 0)+
      sourceQuantumChargedRead q sL eL sR eR (emNoetherResponse q pL pR) := by
  have generated:=congrArg (sourceQuantumChargedRead q sL eL sR eR)
    (em_full_ward q pL pR left right)
  simp only [map_smul,smul_eq_mul,map_add,map_sub,
    (emPreparedCharge_ends q sL eL sR eR _).1,
    (emPreparedCharge_ends q sL eL sR eR _).2] at generated
  convert generated using 1

