attribute [local irreducible] originalJacobi sourceTemporalFirst sourceTemporalSecond

private theorem lapse_coefficient : (6/25:ℂ)*rootTwo*rootFifteen=2*(lapse:ℂ) := by
  have two : (Real.sqrt 2)^2=2:=Real.sq_sqrt (by norm_num)
  have fifteen : (Real.sqrt 15)^2=15:=Real.sq_sqrt (by norm_num)
  have positive : 0≤(3/25:ℝ)*Real.sqrt 2*Real.sqrt 15:=by positivity
  have equal : (3/25:ℝ)*Real.sqrt 2*Real.sqrt 15=lapse:=by
    nlinarith [lapse_sq,lapse_pos,mul_self_nonneg ((3/25:ℝ)*Real.sqrt 2*Real.sqrt 15-lapse)]
  unfold rootTwo rootFifteen
  have h:=congrArg (fun x : ℝ=>(x:ℂ)) equal
  push_cast at h
  linear_combination 2*h

@[local simp] private theorem momentum_one (spatial : Fin 3→ℂ) (z : ℂ) : Fin.cases z spatial 1=spatial 0:=rfl
@[local simp] private theorem momentum_two (spatial : Fin 3→ℂ) (z : ℂ) : Fin.cases z spatial 2=spatial 1:=rfl
@[local simp] private theorem momentum_three (spatial : Fin 3→ℂ) (z : ℂ) : Fin.cases z spatial 3=spatial 2:=rfl

private def timeSliceTerms (time : ℤ) (terms : List SourceTerm) : List SourceTerm :=
  terms.map (fun a=>⟨a.row,a.column,⟨0,a.powers.first,a.powers.second,a.powers.third⟩,
    a.coefficient*(time:SourceCoefficient)^a.powers.temporal⟩)

private theorem timeSlice_value (time : ℤ) (terms : List SourceTerm) (spatial : Fin 3→ℂ) :
    sourceMatrix (timeSliceTerms time terms) (fullMomentum spatial 0)=
      sourceMatrix terms (fullMomentum spatial (time:ℂ)) := by
  induction terms with
  | nil=>rfl
  | cons a rest ih=>
    simp only [timeSliceTerms,List.map_cons,sourceMatrix_cons] at ih ⊢
    rw [ih]
    congr 1
    have coefficient : coefficientValue (a.coefficient*(time:SourceCoefficient)^a.powers.temporal)=
        coefficientValue a.coefficient*(time:ℂ)^a.powers.temporal := by
      change coefficientMap (a.coefficient*(time:SourceCoefficient)^a.powers.temporal)=_
      rw [map_mul,map_pow,map_intCast]
      rfl
    simp only [SourceTerm.matrix,coefficient]
    congr 1
    simp only [Powers.value,pow_zero,one_mul]
    change coefficientValue a.coefficient*(time:ℂ)^a.powers.temporal*
      ((spatial 0)^a.powers.first*(spatial 1)^a.powers.second*(spatial 2)^a.powers.third)=
      coefficientValue a.coefficient*((time:ℂ)^a.powers.temporal*(spatial 0)^a.powers.first*(spatial 1)^a.powers.second*(spatial 2)^a.powers.third)
    ring

/-- Native spatial Y gauge co-source generated by the original Cauchy initial data. -/
def voltageInitialNativeSource (spatial : Fin 3→ℂ) : Fin 289→ℂ :=
  Pi.single 32 (2*(lapse:ℂ)*spatial 0)+Pi.single 44 (2*(lapse:ℂ)*spatial 1)+
    Pi.single 56 (2*(lapse:ℂ)*spatial 2)

private def evenTerms : List SourceTerm :=
  timeSliceTerms 1 sourceVoltageRampTerms++timeSliceTerms (-1) sourceVoltageRampTerms++
    negativeTerms (timeSliceTerms 0 sourceVoltageRampTerms++timeSliceTerms 0 sourceVoltageRampTerms)
private def initialTwiceTerms : List SourceTerm :=
  [⟨32,0,⟨0,1,0,0⟩,⟨⟨0,0⟩,⟨0,12/25⟩⟩⟩,
   ⟨44,0,⟨0,0,1,0⟩,⟨⟨0,0⟩,⟨0,12/25⟩⟩⟩,
   ⟨56,0,⟨0,0,0,1⟩,⟨⟨0,0⟩,⟨0,12/25⟩⟩⟩]
private def thirdTerms : List SourceTerm :=
  timeSliceTerms 2 sourceVoltageRampTerms++
    negativeTerms (timeSliceTerms 1 sourceVoltageRampTerms++timeSliceTerms 1 sourceVoltageRampTerms++timeSliceTerms 1 sourceVoltageRampTerms)++
    timeSliceTerms 0 sourceVoltageRampTerms++timeSliceTerms 0 sourceVoltageRampTerms++timeSliceTerms 0 sourceVoltageRampTerms++
    negativeTerms (timeSliceTerms (-1) sourceVoltageRampTerms)
private theorem even_certificate : fastNormalizeTerms (evenTerms++negativeTerms initialTwiceTerms)=[] := by decide +kernel
private theorem third_certificate : fastNormalizeTerms thirdTerms=[] := by decide +kernel

private theorem twice_value (spatial : Fin 3→ℂ) :
    sourceMatrix initialTwiceTerms (fullMomentum spatial 0)*ᵥPi.single 0 1=
      (2:ℂ) • voltageInitialNativeSource spatial := by
  ext i
  norm_num [initialTwiceTerms,sourceMatrix,SourceTerm.matrix,Powers.value,fullMomentum,
    Matrix.add_mulVec,Matrix.single_mulVec,Matrix.mulVec_single,Matrix.col,Matrix.add_apply,
    Matrix.single_apply,Pi.single_apply,Matrix.single,eq_comm,coefficientValue,
    QuadraticAlgebra.re_one,QuadraticAlgebra.im_one,voltageInitialNativeSource,
    Pi.smul_apply,Pi.add_apply,smul_eq_mul]
  rw [←lapse_coefficient]
  split_ifs <;> try omega
  all_goals ring

private theorem ramp_even (spatial : Fin 3→ℂ) :
    sourceMatrix sourceVoltageRampTerms (fullMomentum spatial 1)*ᵥPi.single 0 1+
      sourceMatrix sourceVoltageRampTerms (fullMomentum spatial (-1))*ᵥPi.single 0 1-
      (2:ℂ) • (sourceMatrix sourceVoltageRampTerms (fullMomentum spatial 0)*ᵥPi.single 0 1)=
    (2:ℂ) • voltageInitialNativeSource spatial := by
  have paid:=congrArg (fun M : Matrix (Fin 289) (Fin 289) ℂ=>M*ᵥPi.single 0 1)
    (normalization_equal evenTerms initialTwiceTerms even_certificate (fullMomentum spatial 0))
  simp only [evenTerms,sourceMatrix_append,negativeTerms_value,timeSlice_value,
    Int.cast_zero,Int.cast_one,Int.cast_neg,Matrix.add_mulVec,Matrix.neg_mulVec,twice_value] at paid
  convert paid using 1
  module

private theorem ramp_third (spatial : Fin 3→ℂ) :
    sourceMatrix sourceVoltageRampTerms (fullMomentum spatial 2)*ᵥPi.single 0 1-
      (3:ℂ) • (sourceMatrix sourceVoltageRampTerms (fullMomentum spatial 1)*ᵥPi.single 0 1)+
      (3:ℂ) • (sourceMatrix sourceVoltageRampTerms (fullMomentum spatial 0)*ᵥPi.single 0 1)-
      sourceMatrix sourceVoltageRampTerms (fullMomentum spatial (-1))*ᵥPi.single 0 1=0 := by
  have zero : sourceMatrix thirdTerms (fullMomentum spatial 0)=0 := by
    rw [←fastNormalizeTerms_value,third_certificate]
    rfl
  have paid:=congrArg (fun M : Matrix (Fin 289) (Fin 289) ℂ=>M*ᵥPi.single 0 1) zero
  simp only [thirdTerms,sourceMatrix_append,negativeTerms_value,timeSlice_value,
    Int.cast_zero,Int.cast_one,Int.cast_neg,Int.cast_ofNat,Matrix.add_mulVec,Matrix.neg_mulVec,Matrix.zero_mulVec] at paid
  convert paid using 1
  module

/-- The original Hessian has no second-time kinetic action on this actual initial value. -/
theorem voltage_initial_second_zero (spatial : Fin 3→ℂ) :
    sourceTemporalSecond *ᵥ sourceVoltageSpatialVector spatial=0 := by
  have third:=ramp_third spatial
  rw [←sourceVoltageRamp_equation,←sourceVoltageRamp_equation,
    ←sourceVoltageRamp_equation,←sourceVoltageRamp_equation,
    sourceTemporalPencil_original spatial 2,sourceTemporalPencil_original spatial 1,
    sourceTemporalPencil_original spatial (-1)] at third
  simp only [Matrix.add_mulVec,Matrix.smul_mulVec,
    Matrix.mulVec_add,Matrix.mulVec_smul,smul_add,smul_smul] at third
  ext i
  have h:=congrFun third i
  simp only [Pi.add_apply,Pi.sub_apply,Pi.smul_apply,smul_eq_mul,Pi.zero_apply] at h ⊢
  linear_combination h/6

/-- All 289 initial co-source rows are generated; the three longitudinal Y entries are not an ansatz. -/
theorem voltage_initial_boundary_native (spatial : Fin 3→ℂ) (z : ℂ) :
    voltageInitialBoundary spatial z=voltageInitialNativeSource spatial := by
  have even:=ramp_even spatial
  rw [←sourceVoltageRamp_equation,←sourceVoltageRamp_equation,←sourceVoltageRamp_equation,
    sourceTemporalPencil_original spatial 1,sourceTemporalPencil_original spatial (-1)] at even
  simp only [Matrix.add_mulVec,Matrix.smul_mulVec,Matrix.mulVec_add,Matrix.mulVec_smul,
    smul_add,smul_smul] at even
  rw [voltageInitialBoundary,voltage_initial_second_zero,smul_zero,add_zero]
  ext i
  have h:=congrFun even i
  simp only [Pi.add_apply,Pi.sub_apply,Pi.smul_apply,smul_eq_mul] at h ⊢
  linear_combination h/2

end LowEnergy.GaussComposite.ActualEMCauchyDynamic
