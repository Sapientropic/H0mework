/-- For t' = scale*t the conjugate physical frequency is omega' = omega/scale. -/
def emClockGreen (scale epsilon omega : ℝ) (n : PhysicalMomentum) :
    Matrix (Fin 289) (Fin 289) ℂ :=
  sourceWholePhotonGreen epsilon (scale * omega / epsilon ^ 2) n

def emClockResidue (scale epsilon s : ℝ) (n : PhysicalMomentum) :
    Matrix (Fin 289) (Fin 289) ℂ :=
  (scale⁻¹ : ℝ) • sourceWholePhotonFrequencyResidue epsilon s n

def emClockJacobi (scale epsilon omega : ℝ) (n : PhysicalMomentum) :
    Matrix (Fin 289) (Fin 289) ℂ :=
  emActionFrequencyJacobi epsilon (scale * omega) n

def emClockJet (scale epsilon omega : ℝ) (n : PhysicalMomentum) :
    Matrix (Fin 289) (Fin 289) ℂ :=
  deriv (fun w : ℝ => emClockJacobi scale epsilon w n) omega

/-- The residue scale is generated by the pole of the re-expressed original full Green. -/
theorem em_clock_pole_generated (scale : ℝ) (positive : 0 < scale)
    (branch : Fin 2) (n : PhysicalMomentum) (unit : spatialSquare n = 1) :
    ∀ᶠ e in scaleApproach, Tendsto
      (fun w : ℝ => ((w - sourceFrequency e.val (sourceSheet branch n unit e.val) / scale : ℝ) : ℂ) •
        emClockGreen scale e.val w n)
      (𝓝[≠] (sourceFrequency e.val (sourceSheet branch n unit e.val) / scale))
      (𝓝 (emClockResidue scale e.val (sourceSheet branch n unit e.val) n)) := by
  filter_upwards [sourceWholePhotonGreen_residue branch n unit] with e pole
  have sc : scale ≠ 0 := positive.ne'
  have ep : e.val ^ 2 ≠ 0 := pow_ne_zero _ e.property.1.ne'
  let sheet := sourceSheet branch n unit e.val
  let w0 := sourceFrequency e.val sheet / scale
  have point : scale * w0 / e.val ^ 2 = sheet := by
    dsimp [w0, sourceFrequency]
    field_simp [sc, e.property.1.ne']
  have moved : Tendsto (fun w : ℝ => scale * w / e.val ^ 2)
      (𝓝[≠] w0) (𝓝[≠] sheet) := by
    apply tendsto_nhdsWithin_iff.mpr
    constructor
    · have cont : Continuous (fun w : ℝ => scale * w / e.val ^ 2) := by fun_prop
      simpa only [point] using (cont.tendsto w0).mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with w different
      change w ≠ w0 at different
      change scale * w / e.val ^ 2 ≠ sheet
      intro same
      apply different
      apply (mul_left_cancel₀ sc)
      rw [← point] at same
      exact (div_left_inj' ep).mp same
  have result := (pole.comp moved).const_smul (((e.val ^ 2 / scale : ℝ) : ℂ))
  have scalar (w : ℝ) :
      (((e.val ^ 2 / scale : ℝ) : ℂ)) * ((scale * w / e.val ^ 2 - sheet : ℝ) : ℂ) =
      ((w - w0 : ℝ) : ℂ) := by
    push_cast
    dsimp [w0, sourceFrequency]
    push_cast
    field_simp [Complex.ofReal_ne_zero.mpr sc, Complex.ofReal_ne_zero.mpr e.property.1.ne']
  have endpoint : (((e.val ^ 2 / scale : ℝ) : ℂ)) •
      sourceWholePhotonResidue e.val sheet n = emClockResidue scale e.val sheet n := by
    ext i j
    simp only [emClockResidue, sourceWholePhotonFrequencyResidue, Matrix.smul_apply, smul_eq_mul,
      Complex.real_smul, Complex.ofReal_inv, Complex.ofReal_div, Complex.ofReal_pow]
    ring
  change Tendsto
    (fun w : ℝ => (((e.val ^ 2 / scale : ℝ) : ℂ)) •
      (((scale * w / e.val ^ 2 - sheet : ℝ) : ℂ) •
        sourceWholePhotonGreen e.val (scale * w / e.val ^ 2) n))
    (𝓝[≠] w0)
    (𝓝 ((((e.val ^ 2 / scale : ℝ) : ℂ)) • sourceWholePhotonResidue e.val sheet n)) at result
  rw [endpoint] at result
  apply result.congr'
  filter_upwards [] with w
  rw [smul_smul, scalar]
  rfl

theorem em_clock_jet_generated (scale : ℝ) (positive : 0 < scale) (e : scaleDomain)
    (s : ℝ) (n : PhysicalMomentum) :
    emClockJet scale e.val (sourceFrequency e.val s / scale) n =
      scale • emActionFrequencyJet e.val (sourceFrequency e.val s) n := by
  have sc : scale ≠ 0 := positive.ne'
  have point : sourceFrequency e.val s = scale * (sourceFrequency e.val s / scale) := by
    field_simp [sc]
  have clock := (sourcePhotonFrequencyJacobi_hasDerivAt e s n).scomp_of_eq
    (sourceFrequency e.val s / scale)
    ((hasDerivAt_id (sourceFrequency e.val s / scale)).const_mul scale) point
  have same : (fun w : ℝ => emClockJacobi scale e.val w n) =
      (fun w : ℝ => sourcePhotonFrequencyJacobi e.val (scale * w) n) := by
    funext w
    exact em_jacobi_source _
  rw [emClockJet, same, em_action_frequency_jet, sourcePhotonFrequencyJacobiJet,
    (sourcePhotonFrequencyJacobi_hasDerivAt e s n).deriv]
  simpa only [Function.comp_def, mul_one, id_eq] using clock.deriv

/-- The original EM flux is unchanged after its physical clock, derivative and residue all transform. -/
theorem em_clock_frequency_flux (scale : ℝ) (positive : 0 < scale)
    (branch : Fin 2) (n : PhysicalMomentum) (unit : spatialSquare n = 1) :
    ∀ᶠ e in scaleApproach,
      emInsertion.transpose * emClockResidue scale e.val (sourceSheet branch n unit e.val) n *
        emClockJet scale e.val (sourceFrequency e.val (sourceSheet branch n unit e.val) / scale) n *
        (emClockResidue scale e.val (sourceSheet branch n unit e.val) n * emInsertion) =
      emInsertion.transpose * emClockResidue scale e.val (sourceSheet branch n unit e.val) n * emInsertion := by
  filter_upwards [em_action_frequency_flux branch n unit] with e flux
  rw [em_clock_jet_generated scale positive]
  have sc : scale ≠ 0 := positive.ne'
  have scalar : scale⁻¹ * (scale * scale⁻¹) = scale⁻¹ := by
    rw [mul_inv_cancel₀ sc, mul_one]
  simpa only [emClockResidue, Matrix.mul_smul, Matrix.smul_mul, smul_smul, scalar] using
    congrArg (fun R : Matrix (Fin 4) (Fin 4) ℂ => (scale⁻¹ : ℝ) • R) flux

