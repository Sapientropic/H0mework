attribute [local irreducible] compositeResponse compositeBase compositeUnitLeg GaussCoreHilbert.embed

/-- Each overlap is generated by the actual bottom and whole response of this same leg. -/
def compositeBottomOverlap (leg : CompositeLeg) : ℝ :=
  ‖GaussCoreHilbert.embed (compositeBase leg)‖ / ‖GaussCoreHilbert.embed (compositeResponse leg)‖

def compositeBottomBornWeight (leg : CompositeLeg) : ℝ := compositeBottomOverlap leg ^ 2

private theorem response_norm_positive (leg : CompositeLeg) :
    0 < ‖GaussCoreHilbert.embed (compositeResponse leg)‖ :=
  norm_pos_iff.mpr (fun zero => composite_response_nonzero leg (embed_injective (zero.trans (map_zero GaussCoreHilbert.embed).symm)))

private theorem base_norm_positive (leg : CompositeLeg) :
    0 < ‖GaussCoreHilbert.embed (compositeBase leg)‖ := by
  let sharp : CompositeLeg := {leg with sharp := true}
  have actual := composite_response_nonzero sharp
  rw [composite_sharp_bottom sharp rfl] at actual
  have nonzero : compositeBase leg ≠ 0 := by
    simpa only [compositeBase, compositeInput, sharp] using actual
  exact norm_pos_iff.mpr (fun zero => nonzero (embed_injective (zero.trans (map_zero GaussCoreHilbert.embed).symm)))

private theorem base_norm_le_response (leg : CompositeLeg) :
    ‖GaussCoreHilbert.embed (compositeBase leg)‖ ≤ ‖GaussCoreHilbert.embed (compositeResponse leg)‖ := by
  rw [←composite_response_bottom leg, embed_project]
  exact NativeHistoryGrade.piece_bound (3,0) _

/-- The full source fixes a strictly positive overlap no larger than one. -/
theorem composite_bottom_overlap_bounds (leg : CompositeLeg) :
    0 < compositeBottomOverlap leg ∧ compositeBottomOverlap leg ≤ 1 := by
  refine ⟨div_pos (base_norm_positive leg) (response_norm_positive leg), ?_⟩
  exact (div_le_one (response_norm_positive leg)).mpr (base_norm_le_response leg)

/-- This is the actual grade-zero Born weight of the normalized full response. -/
theorem composite_bottom_born_read (leg : CompositeLeg) :
    compositeBottomBornWeight leg =
      ‖GaussCoreHilbert.embed (GaussCoreLabel.project (3,0) (compositeUnitLeg leg))‖^2 := by
  rw [compositeUnitLeg, map_smul, composite_response_bottom, map_smul, norm_smul,
    norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
  unfold compositeBottomBornWeight compositeBottomOverlap
  congr 1
  rw [div_eq_mul_inv, mul_comm]

theorem composite_bottom_born_bounds (leg : CompositeLeg) :
    0 < compositeBottomBornWeight leg ∧ compositeBottomBornWeight leg ≤ 1 := by
  have paid := composite_bottom_overlap_bounds leg
  unfold compositeBottomBornWeight
  constructor
  · exact sq_pos_of_pos paid.1
  · nlinarith

/-- The independent sharp endpoint has its full source mass in the actual bottom sector. -/
theorem composite_sharp_bottom_overlap (leg : CompositeLeg) (sharp : leg.sharp=true) :
    compositeBottomOverlap leg = 1 ∧ compositeBottomBornWeight leg = 1 := by
  have overlap : compositeBottomOverlap leg = 1 := by
    unfold compositeBottomOverlap
    rw [composite_sharp_bottom leg sharp]
    simpa only [compositeBase] using div_self (base_norm_positive leg).ne'
  exact ⟨overlap, by rw [compositeBottomBornWeight, overlap, one_pow]⟩

/-- The base numerator is normalized by its own original response, before any fullY overlap. -/
def compositeBaseUnitWeight (p : PhysicalMomentum) (left right : CompositeLeg) : ℂ :=
  compositeBaseWeight p left right /
    (((‖GaussCoreHilbert.embed (compositeBase left)‖ *
      ‖GaussCoreHilbert.embed (compositeBase right)‖ : ℝ) : ℂ))

private theorem inverse_norm_base_overlap (p : PhysicalMomentum) (left right : CompositeLeg) :
    compositeInverseNorm left * compositeInverseNorm right * compositeBaseWeight p left right =
      (compositeBottomOverlap left : ℂ) * (compositeBottomOverlap right : ℂ) *
        compositeBaseUnitWeight p left right := by
  unfold compositeInverseNorm compositeBottomOverlap compositeBaseUnitWeight
  push_cast
  field_simp [Complex.ofReal_ne_zero.mpr (base_norm_positive left).ne',
    Complex.ofReal_ne_zero.mpr (base_norm_positive right).ne',
    Complex.ofReal_ne_zero.mpr (response_norm_positive left).ne',
    Complex.ofReal_ne_zero.mpr (response_norm_positive right).ne']

/-- The complete fullY coupling contains only source-generated overlaps and the original base action current. -/
theorem composite_weight_born_dressing (p : PhysicalMomentum) (left right : CompositeLeg)
    (sharp : left.sharp=true ∨ right.sharp=true) :
    compositeMasslessWeight p left right =
      (compositeBottomOverlap left : ℂ) * (compositeBottomOverlap right : ℂ) *
        compositeBaseUnitWeight p left right := by
  rcases sharp with h | h
  · rw [composite_weight_sharp_left p left right h, inverse_norm_base_overlap]
  · rw [composite_weight_sharp_right p left right h, inverse_norm_base_overlap]

/-- All four external overlaps come from the same independently prepared complete source legs. -/
def compositeCoulombOverlap (dL dR sL sR : CompositeLeg) : ℝ :=
  compositeBottomOverlap dL * compositeBottomOverlap dR *
    compositeBottomOverlap sL * compositeBottomOverlap sR

theorem composite_coulomb_overlap_bounds (dL dR sL sR : CompositeLeg) :
    0 < compositeCoulombOverlap dL dR sL sR ∧ compositeCoulombOverlap dL dR sL sR ≤ 1 := by
  have dl := composite_bottom_overlap_bounds dL
  have dr := composite_bottom_overlap_bounds dR
  have sl := composite_bottom_overlap_bounds sL
  have sr := composite_bottom_overlap_bounds sR
  refine ⟨mul_pos (mul_pos (mul_pos dl.1 dr.1) sl.1) sr.1, ?_⟩
  have first := mul_le_one₀ dl.2 dr.1.le dr.2
  have second := mul_le_one₀ first sl.1.le sl.2
  exact mul_le_one₀ second sr.1.le sr.2

/-- The actual source-generated dressing multiplies its complete original Coulomb coefficient. -/
theorem composite_coulomb_coefficient_dressing (branch : Fin 2) (pd ps : PhysicalMomentum)
    (dL dR sL sR : CompositeLeg)
    (dSharp : dL.sharp=true ∨ dR.sharp=true) (sSharp : sL.sharp=true ∨ sR.sharp=true) :
    actualStaticPairSeed * compositeMasslessWeight pd dL dR * compositeMasslessWeight ps sL sR /
      ((ActionNormalization.phaseMomentum * sourceSpeed branch : ℝ) : ℂ) =
      (compositeCoulombOverlap dL dR sL sR : ℂ) *
        (actualStaticPairSeed * compositeBaseUnitWeight pd dL dR * compositeBaseUnitWeight ps sL sR /
          ((ActionNormalization.phaseMomentum * sourceSpeed branch : ℝ) : ℂ)) := by
  rw [composite_weight_born_dressing pd dL dR dSharp, composite_weight_born_dressing ps sL sR sSharp]
  simp only [compositeCoulombOverlap, Complex.ofReal_mul]
  ring

/-- The actual Born dressing gives an exact controlled difference from its own normalized base response. -/
theorem composite_coulomb_dressing_error (branch : Fin 2) (pd ps : PhysicalMomentum)
    (dL dR sL sR : CompositeLeg)
    (dSharp : dL.sharp=true ∨ dR.sharp=true) (sSharp : sL.sharp=true ∨ sR.sharp=true) :
    ‖actualStaticPairSeed * compositeMasslessWeight pd dL dR * compositeMasslessWeight ps sL sR /
        ((ActionNormalization.phaseMomentum * sourceSpeed branch : ℝ) : ℂ) -
      actualStaticPairSeed * compositeBaseUnitWeight pd dL dR * compositeBaseUnitWeight ps sL sR /
        ((ActionNormalization.phaseMomentum * sourceSpeed branch : ℝ) : ℂ)‖ =
      (1-compositeCoulombOverlap dL dR sL sR) *
        ‖actualStaticPairSeed * compositeBaseUnitWeight pd dL dR * compositeBaseUnitWeight ps sL sR /
          ((ActionNormalization.phaseMomentum * sourceSpeed branch : ℝ) : ℂ)‖ := by
  rw [composite_coulomb_coefficient_dressing branch pd ps dL dR sL sR dSharp sSharp,
    ←sub_one_mul, norm_mul]
  have scalar : ‖(compositeCoulombOverlap dL dR sL sR : ℂ)-1‖ =
      1-compositeCoulombOverlap dL dR sL sR := by
    rw [←Complex.ofReal_one, ←Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonpos (sub_nonpos.mpr (composite_coulomb_overlap_bounds dL dR sL sR).2)]
    ring
  rw [scalar]

/-- FullY dressing stays in the actual spatial Newton observation, with one original hc and4pi. -/
theorem composite_coulomb_spatial_dressing (branch : Fin 2) (pd ps : PhysicalMomentum)
    (dL dR sL sR : CompositeLeg)
    (dSharp : dL.sharp=true ∨ dR.sharp=true) (sSharp : sL.sharp=true ∨ sR.sharp=true)
    (test : 𝓢(PhysicalMomentum, ℂ)) (x : PhysicalMomentum) :
    Tendsto (fun scale : ℝ => compositeCoulombPacket branch pd ps dL dR sL sR scale test x)
      (𝓝[>] 0) (𝓝 ((∫y, (4*(Real.pi:ℂ)*(Real.sqrt (spatialSquare y):ℂ))⁻¹ * emPacket test (x-y)) *
        (compositeCoulombOverlap dL dR sL sR : ℂ) *
        (actualStaticPairSeed * compositeBaseUnitWeight pd dL dR * compositeBaseUnitWeight ps sL sR /
          ((ActionNormalization.phaseMomentum * sourceSpeed branch : ℝ) : ℂ)))) := by
  have actual := composite_coulomb_spatial_limit branch pd ps dL dR sL sR test x
  rw [composite_coulomb_coefficient_dressing branch pd ps dL dR sL sR dSharp sSharp, ←mul_assoc] at actual
  exact actual

end LowEnergy.GaussComposite.ActualCompositeCoulombDressing
