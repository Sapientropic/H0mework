/-- Charge action is generated by the original source Noether operator on the full matrix carrier. -/
def sourceResponsePrimalAd : SourceMatrix→ₗ[ℂ]SourceMatrix where
  toFun A:=Quantum.operatorMatrix (phaseInverse.comp sourcePhaseNoether)*A-
    A*Quantum.operatorMatrix (phaseInverse.comp sourcePhaseNoether)
  map_add' A B:=by simp only [mul_add,add_mul];abel
  map_smul' c A:=by simp only [mul_smul_comm,smul_mul_assoc,smul_sub,RingHom.id_apply]

private theorem native_ad (a : NativeLie) :
    sourceResponsePrimalAd (nativePrimal a)=
      (-Complex.I) • nativePrimal (jointP286CoordinateLieBracket (colorGenerator 2) a) := by
  have original:=originalGauge_commutator (colorGenerator 2) a
  change nativePrimal (jointP286CoordinateLieBracket (colorGenerator 2) a)=_ at original
  change Quantum.operatorMatrix (phaseInverse.comp sourcePhaseNoether)*nativePrimal a-
    nativePrimal a*Quantum.operatorMatrix (phaseInverse.comp sourcePhaseNoether)=_
  rw [sourceCoframeCharge_primal,original]
  simp only [add_mul,mul_add,smul_mul_assoc,mul_smul_comm,one_mul,mul_one,smul_sub]
  module

private theorem cartan_table : ∀ (r : Fin 2) (c : Fin 4) (i : Fin 12),
    originalAd (![6,7] r) i (![6,7,10,11] c)=0 := by
  decide +kernel

private theorem cartan_bracket (r : Fin 2) (c : Fin 4) :
    jointP286CoordinateLieBracket (originalUnit (![6,7] r)) (originalUnit (![6,7,10,11] c))=0 := by
  apply rawCoordinates.injective
  ext i
  rw [←originalAd_source,map_zero,Pi.zero_apply,cartan_table]
  norm_num

private theorem color_cartan (c : Fin 4) :
    jointP286CoordinateLieBracket (colorGenerator 2) (originalUnit (![6,7,10,11] c))=0 := by
  have six:=cartan_bracket 0 c
  have seven:=cartan_bracket 1 c
  change jointP286CoordinateLieBracket (originalUnit 6) (originalUnit (![6,7,10,11] c))=0 at six
  change jointP286CoordinateLieBracket (originalUnit 7) (originalUnit (![6,7,10,11] c))=0 at seven
  rw [←sourceConstraintDirection_color]
  change coordinateBracketBilinear ((1/2:ℝ) • (originalUnit 6-originalUnit 7))
    (originalUnit (![6,7,10,11] c))=0
  change coordinateBracketBilinear (originalUnit 6) (originalUnit (![6,7,10,11] c))=0 at six
  change coordinateBracketBilinear (originalUnit 7) (originalUnit (![6,7,10,11] c))=0 at seven
  simp only [map_smul,map_sub,LinearMap.smul_apply,LinearMap.sub_apply,six,seven,sub_self,smul_zero]

private theorem cartan_ad (c : Fin 4) :
    sourceResponsePrimalAd (nativePrimal (originalUnit (![6,7,10,11] c)))=0 := by
  rw [native_ad,color_cartan,map_zero,smul_zero]

private theorem color_zero_ad :
    sourceResponsePrimalAd (nativePrimal (colorGenerator 0))=Complex.I • nativePrimal (colorGenerator 1) := by
  rw [native_ad,colorGenerator_bracket]
  change (-Complex.I) • nativePrimal (-colorGenerator 1)=_
  rw [map_neg,smul_neg,neg_smul,neg_neg]

private theorem color_one_ad :
    sourceResponsePrimalAd (nativePrimal (colorGenerator 1))=(-Complex.I) • nativePrimal (colorGenerator 0) := by
  rw [native_ad,colorGenerator_bracket]
  rfl

private theorem color_square (c : Fin 2) :
    sourceResponsePrimalAd (sourceResponsePrimalAd (nativePrimal (colorGenerator c.castSucc)))=
      nativePrimal (colorGenerator c.castSucc) := by
  fin_cases c
  · change sourceResponsePrimalAd (sourceResponsePrimalAd (nativePrimal (colorGenerator 0)))=_
    rw [color_zero_ad,map_smul,color_one_ad,smul_smul]
    norm_num [mul_neg,Complex.I_mul_I]
  · change sourceResponsePrimalAd (sourceResponsePrimalAd (nativePrimal (colorGenerator 1)))=_
    rw [color_one_ad,map_smul,color_zero_ad,smul_smul]
    norm_num [neg_mul,Complex.I_mul_I]

private theorem raw_transverse_square (r : Fin 2) :
    sourceResponsePrimalAd (sourceResponsePrimalAd (nativePrimal (originalUnit (r.castLE (by decide):Fin 12))))=
      nativePrimal (originalUnit (r.castLE (by decide):Fin 12)) := by
  fin_cases r
  · change sourceResponsePrimalAd (sourceResponsePrimalAd (nativePrimal (originalUnit 0)))=
      nativePrimal (originalUnit 0)
    have h:=color_square 1
    change sourceResponsePrimalAd (sourceResponsePrimalAd (nativePrimal (colorGenerator 1)))=
      nativePrimal (colorGenerator 1) at h
    simp only [sourceRawZero_color,map_smul,RCLike.real_smul_eq_coe_smul (K:=ℂ),h]
  · change sourceResponsePrimalAd (sourceResponsePrimalAd (nativePrimal (originalUnit 1)))=
      nativePrimal (originalUnit 1)
    have h:=color_square 0
    change sourceResponsePrimalAd (sourceResponsePrimalAd (nativePrimal (colorGenerator 0)))=
      nativePrimal (colorGenerator 0) at h
    simp only [sourceRawOne_color,map_smul,RCLike.real_smul_eq_coe_smul (K:=ℂ),h]

private theorem unit_cube (a : Fin 12) (allowed : a=0 ∨ a=1 ∨ a=6 ∨ a=7 ∨ a=10 ∨ a=11) :
    sourceResponsePrimalAd (sourceResponsePrimalAd (sourceResponsePrimalAd (nativePrimal (originalUnit a))))=
      sourceResponsePrimalAd (nativePrimal (originalUnit a)) := by
  rcases allowed with h|h|h|h|h|h <;> subst a
  · exact congrArg sourceResponsePrimalAd (raw_transverse_square 0)
  · exact congrArg sourceResponsePrimalAd (raw_transverse_square 1)
  · have h:=cartan_ad 0
    change sourceResponsePrimalAd (nativePrimal (originalUnit 6))=0 at h
    rw [h,map_zero,map_zero]
  · have h:=cartan_ad 1
    change sourceResponsePrimalAd (nativePrimal (originalUnit 7))=0 at h
    rw [h,map_zero,map_zero]
  · have h:=cartan_ad 2
    change sourceResponsePrimalAd (nativePrimal (originalUnit 10))=0 at h
    rw [h,map_zero,map_zero]
  · have h:=cartan_ad 3
    change sourceResponsePrimalAd (nativePrimal (originalUnit 11))=0 at h
    rw [h,map_zero,map_zero]

/-- Every actual gauge axis, including both transverse entries, has only source-generated charge degrees zero and plus/minus one on the full252 carrier. -/
theorem sourceFirstConnection_chargeCube (k mu : Fin 4) :
    sourceResponsePrimalAd (sourceResponsePrimalAd (sourceResponsePrimalAd (nativePrimal (sourceFirstGaugeConnection k mu))))=
      sourceResponsePrimalAd (nativePrimal (sourceFirstGaugeConnection k mu)) := by
  simp only [sourceFirstGaugeConnection,map_sum,map_smul,RCLike.real_smul_eq_coe_smul (K:=ℂ)]
  apply Finset.sum_congr rfl
  intro a _
  by_cases allowed : a=0 ∨ a=1 ∨ a=6 ∨ a=7 ∨ a=10 ∨ a=11
  · rw [unit_cube a allowed]
  · have zero : sourceFirstGaugeCoefficients k mu a=0 := by
      push Not at allowed
      rcases allowed with ⟨h0,h1,h6,h7,h10,h11⟩
      simp [sourceFirstGaugeCoefficients,sourceFirstTemporalCoefficients,sourceFirstSpatialCoefficients,
        sourceFirstLongitudinalCoefficients,ite_apply,Pi.add_apply,h0,h1,h6,h7,h10,h11]
    rw [zero]
    simp

private theorem ad_factor (B A : SourceMatrix)
    (commute : Quantum.operatorMatrix (phaseInverse.comp sourcePhaseNoether)*B=
      B*Quantum.operatorMatrix (phaseInverse.comp sourcePhaseNoether)) :
    sourceResponsePrimalAd (B*A)=B*sourceResponsePrimalAd A := by
  change _*(B*A)-(B*A)*_=B*(_*A-A*_)
  rw [←mul_assoc _ B,commute]
  noncomm_ring

private theorem coefficient_charge (mu : Fin 4) :
    Quantum.operatorMatrix (phaseInverse.comp sourcePhaseNoether)*coefficientMatrix mu (actual.coframe 0)=
      coefficientMatrix mu (actual.coframe 0)*Quantum.operatorMatrix (phaseInverse.comp sourcePhaseNoether) := by
  simp only [coefficientMatrix,mul_smul_comm,smul_mul_assoc,sourcePoleSpin_charge]

private theorem principal_inverse_charge :
    Quantum.operatorMatrix (phaseInverse.comp sourcePhaseNoether)*Ring.inverse (principalMatrix (actual.coframe 0))=
      Ring.inverse (principalMatrix (actual.coframe 0))*Quantum.operatorMatrix (phaseInverse.comp sourcePhaseNoether) := by
  rw [principal_inverse_original _ (FullQuantum.actual_noncharacteristic 0),actual_coframe,
    InducedQuantum.lapse_temporal_inverse lapse lapse_pos.ne',map_smul]
  change _*((Complex.I*(lapse:ℂ)) • spinCoordinates diracGammaZero)=
    ((Complex.I*(lapse:ℂ)) • spinCoordinates diracGammaZero)*_
  rw [mul_smul_comm,smul_mul_assoc,sourcePoleSpin_charge]

/-- The original principal inverse and all gamma/coframe factors preserve the generated full252 grading of each actual first-pole energy axis. -/
theorem sourceFirstEnergyPrimal_chargeCube (k : Fin 4) :
    sourceResponsePrimalAd (sourceResponsePrimalAd (sourceResponsePrimalAd
      (Quantum.operatorMatrix (sourceFirstEnergyAction k))))=
      sourceResponsePrimalAd (Quantum.operatorMatrix (sourceFirstEnergyAction k)) := by
  rw [sourceFirstEnergyAction_matrix]
  simp only [map_smul,ad_factor _ _ principal_inverse_charge,map_sum,
    ad_factor _ _ (coefficient_charge _),sourceFirstConnection_chargeCube]

