/-- Original full scalar+electric orbit on both actual propagated test pairs; readFrame is independent of the held response frame. -/
def dressedJointOrbitRead (event : DressedEvent) (transfer : PhysicalMomentum)
    (a : Fin 12) (readFrame : GaussUnitaryHistory.Index) : ℂ :=
  sourcePair
    (sourceTestApprox readFrame ((finiteFull (event.momentum-transfer) event.frame event.cut event.energy).adjoint
      (sourceDressedUnit event.epsilon event.precision)))
    (orbitAction (originalUnit a) (sourceTestApprox readFrame
      (sourceDressedResponse event.epsilon event.precision event.momentum event.frame event.cut event.energy)))-
  sourcePair
    (sourceTestApprox readFrame ((finiteFull (event.momentum-transfer) event.frame event.cut event.energy).adjoint
      (prepared (sourceProfile event.epsilon event.precision))))
    (orbitAction (originalUnit a) (sourceTestApprox readFrame
      (finiteFull event.momentum event.frame event.cut event.energy (prepared (sourceProfile event.epsilon event.precision)))))

/-- This joint-source response is generated by the closure of the original weighted configuration orbit. -/
def dressedJointOrbitResponse (event : DressedEvent) (transfer : PhysicalMomentum) (a : Fin 12) : ℂ :=
  inner ℂ ((finiteFull (event.momentum-transfer) event.frame event.cut event.energy).adjoint
      (sourceDressedUnit event.epsilon event.precision))
    (jointReader a (sourceDressedResponse event.epsilon event.precision event.momentum event.frame event.cut event.energy))-
  inner ℂ ((finiteFull (event.momentum-transfer) event.frame event.cut event.energy).adjoint
      (prepared (sourceProfile event.epsilon event.precision)))
    (jointReader a (finiteFull event.momentum event.frame event.cut event.energy (prepared (sourceProfile event.epsilon event.precision))))

private theorem original_orbit_pair_limit (a : Fin 12) (x y : H) :
    Tendsto (fun F : GaussUnitaryHistory.Index=>sourcePair (sourceTestApprox F x)
      (orbitAction (originalUnit a) (sourceTestApprox F y))) GaussUnitaryHistory.sourceFilter
      (𝓝 (inner ℂ x (jointReader a y))) := by
  have left:=same_source_approximation x
  have right:=(continuous_snd.tendsto (y,jointReader a y)).comp (sourceApprox_joint_graph a y)
  exact left.inner right

/-- Every original Lie direction consumes this actual unit-minus-background event, without a new regularity premise. -/
theorem dressed_joint_orbit_response_limit (event : DressedEvent) (transfer : PhysicalMomentum) (a : Fin 12) :
    Tendsto (dressedJointOrbitRead event transfer a) GaussUnitaryHistory.sourceFilter
      (𝓝 (dressedJointOrbitResponse event transfer a)) := by
  exact (original_orbit_pair_limit a
    ((finiteFull (event.momentum-transfer) event.frame event.cut event.energy).adjoint (sourceDressedUnit event.epsilon event.precision))
    (sourceDressedResponse event.epsilon event.precision event.momentum event.frame event.cut event.energy)).sub
    (original_orbit_pair_limit a
      ((finiteFull (event.momentum-transfer) event.frame event.cut event.energy).adjoint (prepared (sourceProfile event.epsilon event.precision)))
      (finiteFull event.momentum event.frame event.cut event.energy (prepared (sourceProfile event.epsilon event.precision))))

/-- The complete original coefficient/divergence/Number half-density ordering is retained on each response. -/
theorem dressed_joint_orbit_weighted_read (event : DressedEvent) (transfer : PhysicalMomentum)
    (a : Fin 12) (readFrame : GaussUnitaryHistory.Index) :
    dressedJointOrbitRead event transfer a readFrame=
      sourcePair
        (sourceTestApprox readFrame ((finiteFull (event.momentum-transfer) event.frame event.cut event.energy).adjoint
          (sourceDressedUnit event.epsilon event.precision)))
        (orbitAdjoint (originalUnit a) (sourceTestApprox readFrame
          (sourceDressedResponse event.epsilon event.precision event.momentum event.frame event.cut event.energy)))-
      sourcePair
        (sourceTestApprox readFrame ((finiteFull (event.momentum-transfer) event.frame event.cut event.energy).adjoint
          (prepared (sourceProfile event.epsilon event.precision))))
        (orbitAdjoint (originalUnit a) (sourceTestApprox readFrame
          (finiteFull event.momentum event.frame event.cut event.energy (prepared (sourceProfile event.epsilon event.precision))))) := by
  rw [original_weighted_ordering]
  rfl

/-- The Y basis occurrence is the same source gauge direction in the original graph and charge read. -/
theorem joint_Y_original : jointReader 11= -chargeReader nativeY := by
  change -chargeReader (originalUnit 11)= -chargeReader nativeY
  rw [sourceVoltageY_native]
  rfl

/-- The original completed configuration-orbit observation has a source-generated relative Y value. -/
theorem actual_joint_Y_connected :
    ∀ event : DressedEvent,
      inner ℂ (sourceDressedUnit event.epsilon event.precision)
          (jointReader 11 (sourceDressedUnit event.epsilon event.precision))-
        inner ℂ (prepared (sourceProfile event.epsilon event.precision))
          (jointReader 11 (prepared (sourceProfile event.epsilon event.precision)))=1 := by
  intro event
  rw [joint_Y_original]
  simp only [neg_apply,inner_neg_right]
  have original:=source_dressed_connected_native_charge event.epsilon event.precision
  linear_combination -original

/-- The actual unit and unchanged background realize that joint Y value through the original dense graph tests. -/
theorem actual_joint_Y_source_limit (event : DressedEvent) :
    Tendsto (fun readFrame : GaussUnitaryHistory.Index=>
      sourcePair (sourceTestApprox readFrame (sourceDressedUnit event.epsilon event.precision))
        (orbitAction (originalUnit 11) (sourceTestApprox readFrame (sourceDressedUnit event.epsilon event.precision)))-
      sourcePair (sourceTestApprox readFrame (prepared (sourceProfile event.epsilon event.precision)))
        (orbitAction (originalUnit 11) (sourceTestApprox readFrame (prepared (sourceProfile event.epsilon event.precision)))))
      GaussUnitaryHistory.sourceFilter (𝓝 (1:ℂ)) := by
  have paid:=(original_orbit_pair_limit 11 (sourceDressedUnit event.epsilon event.precision)
    (sourceDressedUnit event.epsilon event.precision)).sub
      (original_orbit_pair_limit 11 (prepared (sourceProfile event.epsilon event.precision))
        (prepared (sourceProfile event.epsilon event.precision)))
  rw [actual_joint_Y_connected event] at paid
  exact paid

