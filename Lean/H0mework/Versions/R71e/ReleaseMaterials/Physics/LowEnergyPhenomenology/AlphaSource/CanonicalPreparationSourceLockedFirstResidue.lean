def sourceLockedHalf (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum)
    (mu : Fin 4) (i : Fin 3) (lambda : ℂ) : H→L[ℂ] H :=
  sourceProjection*rawHalf (sourcePhysicalMaterialPoint q pL pR) (sourceLockedField mu i) lambda

