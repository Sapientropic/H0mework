private theorem source_real_smul (r : ℝ) (X : SourceOp) : r • X=(r:ℂ) • X :=
  RCLike.real_smul_eq_coe_smul (K:=ℂ) r X

private theorem productSum {R : Type*} [Ring R] [Algebra ℂ R]
    (a b : R) (c : Fin 289→ℂ) (J : Fin 289→R) :
    a*(∑j : Fin 289,c j • J j)*b=∑j : Fin 289,c j • (a*J j*b) := by
  simp only [Finset.mul_sum,Finset.sum_mul,mul_smul_comm,smul_mul_assoc]

private theorem projected_weight {R : Type*} [Ring R] [Algebra ℂ R]
    (P K Z : R) (e : ℂ) (square : P*P=P) (paid : P*K=Z*P) :
    (P*(e • K))*P=P*(e • K) := by
  rw [mul_smul_comm,smul_mul_assoc,paid,mul_assoc,square]

/-- Original fulljoint half-axis support is generated by the source reader's grade law. -/
theorem sourceLockedHalf_rightProjection (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum)
    (mu : Fin 4) (i : Fin 3) (lambda : ℂ) (positive : 0<lambda.re)
    (nonrealL : q.z.im≠0) (nonrealR : q.w.im≠0) :
    sourceLockedHalf q pL pR mu i lambda*sourceProjection=sourceLockedHalf q pL pR mu i lambda := by
  let L : (H→L[ℂ] H)→L[ℂ] (H→L[ℂ] H):=ContinuousLinearMap.mul ℂ (H→L[ℂ] H) sourceProjection
  let R : (H→L[ℂ] H)→L[ℂ] (H→L[ℂ] H):=(ContinuousLinearMap.mul ℂ (H→L[ℂ] H)).flip sourceProjection
  have integrable:=rawFlow_integrable (sourcePhysicalMaterialPoint q pL pR) (sourceLockedField mu i) lambda positive
  have left:=L.integral_comp_comm integrable
  have both:=(R.comp L).integral_comp_comm integrable
  have same (t : ℝ) : (R.comp L) (laplaceWeight lambda t • rawFlow
      (sourcePhysicalMaterialPoint q pL pR) (sourceLockedField mu i) t)=
      L (laplaceWeight lambda t • rawFlow (sourcePhysicalMaterialPoint q pL pR) (sourceLockedField mu i) t) := by
    change (sourceProjection*(laplaceWeight lambda t • rawFlow
      (sourcePhysicalMaterialPoint q pL pR) (sourceLockedField mu i) t))*sourceProjection=
      sourceProjection*(laplaceWeight lambda t • rawFlow
        (sourcePhysicalMaterialPoint q pL pR) (sourceLockedField mu i) t)
    have generated : rawFlow (sourcePhysicalMaterialPoint q pL pR) (sourceLockedField mu i) t=
      sourceLockedKernel q pL pR mu i t := by
      change fiveKernel (sourceLockedField mu i) pR (pL-pR) q.F q.z q.w t 0=_
      exact sourceLockedKernel_generated q pL pR mu i t
    have projected : sourceProjection*rawFlow (sourcePhysicalMaterialPoint q pL pR) (sourceLockedField mu i) t=
        sourceLockedZeroHistoryKernel q pL pR mu i t*sourceProjection :=
      (congrArg (fun X : SourceOp=>sourceProjection*X) generated).trans
        (sourceLockedKernel_projected q pL pR mu i t nonrealL nonrealR)
    exact projected_weight (R:=SourceOp) sourceProjection
      (rawFlow (sourcePhysicalMaterialPoint q pL pR) (sourceLockedField mu i) t)
      (sourceLockedZeroHistoryKernel q pL pR mu i t) (laplaceWeight lambda t)
      sourceProjection_square projected
  simp_rw [same] at both
  unfold sourceLockedHalf rawHalf
  exact both.symm.trans left

/-- This is the actual N1 upper response; it is zero by generated source support. -/
theorem sourceLockedHalfUpper_zero (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum)
    (mu : Fin 4) (i : Fin 3) (lambda : ℂ) (positive : 0<lambda.re)
    (nonrealL : q.z.im≠0) (nonrealR : q.w.im≠0) :
    sourceLockedHalf q pL pR mu i lambda*sourceExcitedProjection=0 := by
  have orthogonal : sourceProjection*sourceExcitedProjection=0 := by
    unfold sourceProjection sourceExcitedProjection
    rw [NativeHistoryGrade.projection_product]
    norm_num [sourceLabel,sourceExcitedLabel]
  rw [←sourceLockedHalf_rightProjection q pL pR mu i lambda positive nonrealL nonrealR,
    mul_assoc,orthogonal,mul_zero]

private theorem lockedFlow_coordinates (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum)
    (mu : Fin 4) (i : Fin 3) (t : ℝ) :
    rawFlow (sourcePhysicalMaterialPoint q pL pR) (sourceLockedField mu i) t=
      ∑j : Fin 289,(sourceLockedField mu i j:ℂ) •
        rawFlow (sourcePhysicalMaterialPoint q pL pR) (fieldUnit j) t := by
  have read : rawReader (sourceLockedField mu i) pR q.F 0=
      ∑j : Fin 289,(sourceLockedField mu i j:ℂ) • rawReader (fieldUnit j) pR q.F 0 := by
    rw [sourceLockedReader_generated]
    simpa only [source_real_smul] using sourceLockedReader_coordinates mu i pR q.F
  simp only [rawFlow,fiveKernel,sourcePhysicalMaterialPoint,sourceMaterialTransfer]
  rw [read]
  simpa only [mul_assoc] using productSum
    (physicalTime (pR+(pL-pR)) q.F (-t) 0*jointResolvent (pR+(pL-pR)) q.F q.z 0)
    (jointResolvent pR q.F q.w 0*physicalTime pR q.F t 0)
    (fun j : Fin 289=>(sourceLockedField mu i j:ℂ))
    (fun j : Fin 289=>rawReader (fieldUnit j) pR q.F 0)

private theorem lockedHalf_coordinates (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum)
    (mu : Fin 4) (i : Fin 3) (lambda : ℂ) (positive : 0<lambda.re) :
    rawHalf (sourcePhysicalMaterialPoint q pL pR) (sourceLockedField mu i) lambda=
      ∑j : Fin 289,(sourceLockedField mu i j:ℂ) •
        rawHalf (sourcePhysicalMaterialPoint q pL pR) (fieldUnit j) lambda := by
  unfold rawHalf
  simp only [lockedFlow_coordinates,Finset.smul_sum]
  have commute (t : ℝ) (j : Fin 289) : laplaceWeight lambda t •
      ((sourceLockedField mu i j:ℂ) • rawFlow (sourcePhysicalMaterialPoint q pL pR) (fieldUnit j) t)=
      (sourceLockedField mu i j:ℂ) • (laplaceWeight lambda t •
        rawFlow (sourcePhysicalMaterialPoint q pL pR) (fieldUnit j) t) := smul_comm _ _ _
  simp_rw [commute]
  rw [integral_finsetSum (f:=fun j t=>(sourceLockedField mu i j:ℂ) •
    (laplaceWeight lambda t • rawFlow (sourcePhysicalMaterialPoint q pL pR) (fieldUnit j) t))
    Finset.univ (fun j _=>(rawFlow_integrable
      (sourcePhysicalMaterialPoint q pL pR) (fieldUnit j) lambda positive).smul (sourceLockedField mu i j:ℂ))]
  simp only [integral_smul]

theorem sourceLockedHalf_coordinates (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum)
    (mu : Fin 4) (i : Fin 3) (lambda : ℂ) (positive : 0<lambda.re)
    (nonrealL : q.z.im≠0) (nonrealR : q.w.im≠0) :
    sourceLockedHalf q pL pR mu i lambda=
      ∑j : Fin 289,(sourceLockedField mu i j:ℂ) • sourceFullHalfBase q pL pR j lambda := by
  rw [←sourceLockedHalf_rightProjection q pL pR mu i lambda positive nonrealL nonrealR]
  unfold sourceLockedHalf sourceFullHalfBase sourceFullRawHalf
  rw [lockedHalf_coordinates q pL pR mu i lambda positive]
  simp only [Finset.mul_sum,Finset.sum_mul,mul_smul_comm,smul_mul_assoc]

theorem sourceLockedUpper_coordinates (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum)
    (mu : Fin 4) (i : Fin 3) (lambda : ℂ) (positive : 0<lambda.re)
    (nonrealL : q.z.im≠0) (nonrealR : q.w.im≠0) :
    (∑j : Fin 289,(sourceLockedField mu i j:ℂ) • sourceFullHalfUpper q pL pR j lambda)=0 := by
  have zero:=sourceLockedHalfUpper_zero q pL pR mu i lambda positive nonrealL nonrealR
  unfold sourceLockedHalf at zero
  rw [lockedHalf_coordinates q pL pR mu i lambda positive] at zero
  simp only [Finset.mul_sum,Finset.sum_mul,mul_smul_comm,smul_mul_assoc] at zero
  simpa only [sourceFullHalfUpper,sourceFullRawHalf] using zero

def sourceLockedInitial (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum)
    (mu : Fin 4) (i : Fin 3) : SourceOp :=
  ∑j : Fin 289,(sourceLockedField mu i j:ℂ) • sourceFullInitialBase q pL pR j



private theorem apply_limit {l : Filter ℝ} {A : ℝ→SourceSuperOp} {x : ℝ→SourceOp}
    {a : SourceSuperOp} {y : SourceOp} (operator : Tendsto A l (𝓝 a)) (vector : Tendsto x l (𝓝 y)) :
    Tendsto (fun d=>A d (x d)) l (𝓝 (a y)) := by
  have continuous : Continuous (fun p : SourceSuperOp×SourceOp=>p.1 p.2) := continuous_fst.clm_apply continuous_snd
  exact (continuous.tendsto (a,y)).comp (operator.prodMk_nhds vector)

private theorem locked_effective (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ)
    (positive : 0<zeta.re) (delta : ℝ) (positiveDelta : 0<delta) (mu : Fin 4) (i : Fin 3)
    (small : abs delta ≤ sourceSlowRadius q.F n zeta) (nonrealL : q.z.im≠0) (nonrealR : q.w.im≠0) :
    sourceSlowEffective q.F n zeta delta ((delta:ℂ) • sourceEqualProjection q.F
      (sourceLockedHalf q (-(delta • n)) 0 mu i ((delta:ℂ)*zeta)))=
      sourceSlowForcing q.F n zeta delta (sourceLockedInitial q (-(delta • n)) 0 mu i) := by
  have positiveLambda : 0<((delta:ℂ)*zeta).re := by
    simpa only [Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,zero_mul,sub_zero] using mul_pos positiveDelta positive
  have each:=Finset.sum_congr (s₁:=Finset.univ) (s₂:=Finset.univ) rfl (fun j _=>congrArg
    (fun X : SourceOp=>(sourceLockedField mu i j:ℂ) • X)
      (sourceActualSlow_effective q n delta positiveDelta zeta positive j small).2)
  have upper:=sourceLockedUpper_coordinates q (-(delta • n)) 0 mu i ((delta:ℂ)*zeta)
    positiveLambda nonrealL nonrealR
  rw [sourceLockedHalf_coordinates q _ _ mu i _ positiveLambda nonrealL nonrealR]
  simp only [sourceLockedInitial,map_sum,map_smul,Finset.smul_sum,smul_comm (delta:ℂ)]
  simpa only [map_sum,map_smul,smul_sub,Finset.sum_sub_distrib,←map_smul,←map_sum,upper,map_zero,sub_zero]
    using each

private theorem solve_projected (F : GaussUnitaryHistory.Index) (n : PhysicalMomentum) (zeta : ℂ)
    (positive : 0<zeta.re) (delta : ℝ) (small : abs delta ≤ sourceResidueRadius F n zeta)
    (d : ℂ) (X B : SourceOp)
    (equation : sourceSlowEffective F n zeta delta (d • sourceEqualProjection F X)=B) :
    d • sourceEqualProjection F X=sourceEffectiveInverse F n zeta delta B := by
  have fixed:=congrArg (fun T : SourceSuperOp=>T X) (sourceEqualProjection_idempotent F)
  change sourceEqualProjection F (sourceEqualProjection F X)=sourceEqualProjection F X at fixed
  have off : sourceOffProjection F (d • sourceEqualProjection F X)=0 := by
    simp only [sourceOffProjection,sub_apply,one_apply_eq_self,map_smul,fixed,sub_self]
    apply ContinuousLinearMap.ext
    intro x
    exact smul_zero d
  have complete : sourceCompletePencil F n zeta delta (d • sourceEqualProjection F X)=B := by
    rw [sourceCompletePencil,add_apply,off,add_zero]
    exact equation
  have returned:=congrArg (sourceEffectiveInverse F n zeta delta) complete
  have cancel:=congrArg (fun T : SourceSuperOp=>T (d • sourceEqualProjection F X))
    (sourceEffectiveInverse_left F n zeta positive delta small)
  change sourceEffectiveInverse F n zeta delta
    (sourceCompletePencil F n zeta delta (d • sourceEqualProjection F X))=d • sourceEqualProjection F X at cancel
  rw [cancel] at returned
  exact returned

def sourceLockedFirstResidue (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ)
    (mu : Fin 4) (i : Fin 3) : SourceOp :=
  sourceOriginInverse q.F n zeta (sourceEqualProjection q.F (sourceLockedInitial q 0 0 mu i))

private theorem lockedInitial_limit (q : PhysicalResponsePoint) (n : PhysicalMomentum)
    (mu : Fin 4) (i : Fin 3) (nonrealL : q.z.im≠0) (nonrealR : q.w.im≠0) :
    Tendsto (fun d : ℝ=>sourceLockedInitial q (-(d • n)) 0 mu i) (𝓝 0)
      (𝓝 (sourceLockedInitial q 0 0 mu i)) := by
  unfold sourceLockedInitial
  apply tendsto_finsetSum
  intro j _
  exact tendsto_const_nhds.smul (sourceActualInitial_slow_limit q n j nonrealL nonrealR).1

/-- The projected causal response is now first order, with every same-energy coherence and escape channel retained. -/
theorem sourceLockedScaled_limit (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ)
    (positive : 0<zeta.re) (mu : Fin 4) (i : Fin 3) (nonrealL : q.z.im≠0) (nonrealR : q.w.im≠0) :
    Tendsto (fun d : ℝ=>(d:ℂ) • sourceEqualProjection q.F
      (sourceLockedHalf q (-(d • n)) 0 mu i ((d:ℂ)*zeta)))
      (𝓝[>] 0) (𝓝 (sourceLockedFirstResidue q n zeta mu i)) := by
  have limit:=apply_limit (sourceEffectiveInverse_limit q.F n zeta positive)
    (apply_limit (sourceSlowForcing_limit q.F n zeta) (lockedInitial_limit q n mu i nonrealL nonrealR))
  apply (limit.mono_left (nhdsWithin_le_nhds : 𝓝[>] (0:ℝ)≤𝓝 0)).congr'
  filter_upwards [sourceResidue_eventually q.F n zeta] with d legal
  exact (solve_projected q.F n zeta positive d legal.2 _ _ _
    (locked_effective q n zeta positive d legal.1 mu i
      (legal.2.trans (sourceResidueRadius_slow q.F n zeta)) nonrealL nonrealR)).symm



private theorem locked_return (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ)
    (positive : 0<zeta.re) (delta : ℝ) (positiveDelta : 0<delta) (mu : Fin 4) (i : Fin 3)
    (small : abs delta ≤ sourceSlowRadius q.F n zeta) (nonrealL : q.z.im≠0) (nonrealR : q.w.im≠0) :
    sourceLockedHalf q (-(delta • n)) 0 mu i ((delta:ℂ)*zeta)=
      sourceSlowReturn q.F n zeta delta
        (sourceEqualProjection q.F (sourceLockedHalf q (-(delta • n)) 0 mu i ((delta:ℂ)*zeta))+
          sourceOffgapInverse q.F (sourceLockedInitial q (-(delta • n)) 0 mu i)) := by
  have positiveLambda : 0<((delta:ℂ)*zeta).re := by
    simpa only [Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,zero_mul,sub_zero] using mul_pos positiveDelta positive
  have each:=Finset.sum_congr (s₁:=Finset.univ) (s₂:=Finset.univ) rfl (fun j _=>congrArg
    (fun X : SourceOp=>(sourceLockedField mu i j:ℂ) • X)
      (sourceActualBase_return q n delta positiveDelta zeta positive j small))
  have upper:=sourceLockedUpper_coordinates q (-(delta • n)) 0 mu i ((delta:ℂ)*zeta)
    positiveLambda nonrealL nonrealR
  simp only [sourceLockedHalf_coordinates q _ _ mu i _ positiveLambda nonrealL nonrealR,sourceLockedInitial]
  simpa only [map_add,map_sum,map_smul,map_sub,smul_sub,smul_add,Finset.sum_add_distrib,
    Finset.sum_sub_distrib,←map_smul,←map_sum,upper,map_zero,sub_zero] using each

private theorem op_zero_smul (X : SourceOp) : (0 : ℂ) • X=0 := by
  apply ContinuousLinearMap.ext
  intro x
  exact zero_smul ℂ (X x)

/-- The actual whole joint-direction response, not only its projection, has a first-order source residue. -/
theorem sourceLockedHalf_first_residue (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ)
    (positive : 0<zeta.re) (mu : Fin 4) (i : Fin 3) (nonrealL : q.z.im≠0) (nonrealR : q.w.im≠0) :
    Tendsto (fun d : ℝ=>(d:ℂ) • sourceLockedHalf q (-(d • n)) 0 mu i ((d:ℂ)*zeta))
      (𝓝[>] 0) (𝓝 (sourceLockedFirstResidue q n zeta mu i)) := by
  have scalar : Tendsto (fun d : ℝ=>(d:ℂ)) (𝓝[>] 0) (𝓝 0) :=
    (Complex.continuous_ofReal.tendsto 0).mono_left nhdsWithin_le_nhds
  have returned:=(sourceSlowReturn_limit q.F n zeta).mono_left
    (nhdsWithin_le_nhds : 𝓝[>] (0:ℝ)≤𝓝 0)
  have initial:=(lockedInitial_limit q n mu i nonrealL nonrealR).mono_left
    (nhdsWithin_le_nhds : 𝓝[>] (0:ℝ)≤𝓝 0)
  have gap : Tendsto (fun _ : ℝ=>sourceOffgapInverse q.F) (𝓝[>] 0)
      (𝓝 (sourceOffgapInverse q.F)) := tendsto_const_nhds
  have limit:=apply_limit returned ((sourceLockedScaled_limit q n zeta positive mu i nonrealL nonrealR).add
    (scalar.smul (apply_limit gap initial)))
  have normalized : Tendsto (fun d : ℝ=>sourceSlowReturn q.F n zeta d
      ((d:ℂ) • sourceEqualProjection q.F (sourceLockedHalf q (-(d • n)) 0 mu i ((d:ℂ)*zeta))+
        (d:ℂ) • sourceOffgapInverse q.F (sourceLockedInitial q (-(d • n)) 0 mu i)))
      (𝓝[>] 0) (𝓝 (sourceLockedFirstResidue q n zeta mu i)) := by
    simpa only [op_zero_smul,add_zero,one_apply_eq_self] using limit
  apply normalized.congr'
  filter_upwards [sourceResidue_eventually q.F n zeta] with d legal
  have generated:=congrArg (fun X : SourceOp=>(d:ℂ) • X)
    (locked_return q n zeta positive d legal.1 mu i
      (legal.2.trans (sourceResidueRadius_slow q.F n zeta)) nonrealL nonrealR)
  have scalarRead:=(sourceSlowReturn q.F n zeta d).map_smul (d:ℂ)
    (sourceEqualProjection q.F (sourceLockedHalf q (-(d • n)) 0 mu i ((d:ℂ)*zeta))+
      sourceOffgapInverse q.F (sourceLockedInitial q (-(d • n)) 0 mu i))
  simp only [smul_add] at scalarRead
  exact scalarRead.trans generated.symm

private theorem returnedHalf_read (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum) (l r : RestStateIndex)
    (lambda : ℂ) (positive : 0<lambda.re) (j : Fin 289) :
    returnedHalfCurrent q pL pR l r lambda j=
      -sourcePoleRead q.epsilon q.precision 0 0 l r (sourceFullHalfBase q pL pR j lambda) := by
  have source:=congrArg (fun M : Matrix RestStateIndex RestStateIndex ℂ=>M l r)
    (sourceFullHalf_common_carrier q pL pR j lambda positive)
  simpa only [returnedHalfCurrent,Matrix.neg_apply,sourceTensor] using source

/-- The original eight-state current pairs with the actual source half, including its Lorentz insertion. -/
theorem sourceLockedHalf_actualCurrent (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum)
    (l r : RestStateIndex) (mu : Fin 4) (i : Fin 3) (lambda : ℂ) (positive : 0<lambda.re)
    (nonrealL : q.z.im≠0) (nonrealR : q.w.im≠0) :
    sourceLockedCovector mu i (returnedHalfCurrent q pL pR l r lambda)=
      -sourcePoleRead q.epsilon q.precision 0 0 l r (sourceLockedHalf q pL pR mu i lambda) := by
  rw [sourceLockedCovector_apply,sourceLockedHalf_coordinates q _ _ mu i _ positive nonrealL nonrealR]
  simp only [returnedHalf_read q _ _ l r _ positive,map_sum,map_smul,smul_eq_mul,mul_neg,Finset.sum_neg_distrib]

/-- Same-Φ whole-eight current coupling now has the first-order causal residue generated by its true grade law. -/
theorem sourceLockedCurrent_first_residue (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ)
    (positive : 0<zeta.re) (l r : RestStateIndex) (mu : Fin 4) (i : Fin 3)
    (nonrealL : q.z.im≠0) (nonrealR : q.w.im≠0) :
    Tendsto (fun d : ℝ=>(d:ℂ)*sourceLockedCovector mu i
      (returnedHalfCurrent q (-(d • n)) 0 l r ((d:ℂ)*zeta)))
      (𝓝[>] 0) (𝓝 (-sourcePoleRead q.epsilon q.precision 0 0 l r
        (sourceLockedFirstResidue q n zeta mu i))) := by
  have limit:=((sourcePoleRead q.epsilon q.precision 0 0 l r).continuous.tendsto _ |>.comp
    (sourceLockedHalf_first_residue q n zeta positive mu i nonrealL nonrealR)).neg
  apply limit.congr'
  filter_upwards [self_mem_nhdsWithin] with d positiveDelta
  have positiveLambda : 0<((d:ℂ)*zeta).re := by
    simpa only [Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,zero_mul,sub_zero] using mul_pos positiveDelta positive
  simp only [Function.comp_def,map_smul,smul_eq_mul]
  rw [sourceLockedHalf_actualCurrent q _ _ l r mu i _ positiveLambda nonrealL nonrealR,mul_neg]

