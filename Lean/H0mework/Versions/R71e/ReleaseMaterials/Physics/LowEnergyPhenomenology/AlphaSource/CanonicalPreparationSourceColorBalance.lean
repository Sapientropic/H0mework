def sourceColorCurrent (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum)
    (left right : RestStateIndex) (mu : Fin 4) (t : ℝ) : ℂ :=
  (sourcePoleActionEuler q pL pR left right 0 t (gaugeSlot mu 6)-
    sourcePoleActionEuler q pL pR left right 0 t (gaugeSlot mu 7))/2

private theorem negative_half_read {B : Type*} [AddCommGroup B] [Module ℝ B]
    (L : B→ₗ[ℝ] ℂ) (X Y Z : B) (source : (1/2 : ℝ) • (X-Y)=Z) :
    (-L X-(-L Y))/2= -L Z := by
  rw [←source,map_smul,map_sub,Complex.real_smul]
  norm_num
  ring

theorem sourceColorCurrent_generated (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum)
    (left right : RestStateIndex) (mu : Fin 4) (t : ℝ)
    (nonrealL : q.z.im≠0) (nonrealR : q.w.im≠0) :
    sourceColorCurrent q pL pR left right mu t=
      -sourcePoleRead q.epsilon q.precision pL pR left right (sourceColorKernel q pL pR mu t) := by
  unfold sourceColorCurrent
  rw [sourceGaugeCurrent_zeroHistory q pL pR left right mu 6 t nonrealL nonrealR,
    sourceGaugeCurrent_zeroHistory q pL pR left right mu 7 t nonrealL nonrealR]
  exact negative_half_read ((sourcePoleRead q.epsilon q.precision pL pR left right).toLinearMap.restrictScalars ℝ)
    _ _ _ (sourceColorKernel_generated q pL pR mu t)

theorem sourceConstraintCharge_color (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum)
    (left right : RestStateIndex) (t : ℝ) :
    sourceConstraintCharge q pL pR left right t=sourceColorCurrent q pL pR left right 0 t := rfl

theorem sourceConstraintCharge_initial (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum)
    (left right : RestStateIndex) (nonrealL : q.z.im≠0) (nonrealR : q.w.im≠0) :
    sourceConstraintCharge q pL pR left right 0=
      -sourcePoleRead q.epsilon q.precision pL pR left right
        (CanonicalPhysicalResolvent.finiteResolvent pL q.F q.z*sourceColorReader 0 q.F*
          CanonicalPhysicalResolvent.finiteResolvent pR q.F q.w) := by
  rw [sourceConstraintCharge_color,sourceColorCurrent_generated q pL pR left right 0 0 nonrealL nonrealR]
  unfold sourceColorKernel
  simp only [neg_zero,SourceFiniteUnitary.time_zero,one_mul,mul_one]

open SourceJointResidualEnergy

/-- This matrix is generated by the same configuration reader and prepared states, not a rest-pole replacement. -/
def sourceColorStaticCoefficient (q : PhysicalResponsePoint) (left right : RestStateIndex)
    (mu : Fin 4) (i j : Channel q.F) : ℂ :=
  -(((channelValue q.F i : ℂ)-q.z)⁻¹*((channelValue q.F j : ℂ)-q.w)⁻¹*
    inner ℂ (channel q.F i (sourcePolePrepared q.epsilon q.precision 0 left))
      (sourceColorReader mu q.F (channel q.F j (sourcePolePrepared q.epsilon q.precision 0 right))))

private theorem weighted_half_read {B : Type*} [AddCommGroup B] [Module ℝ B]
    (L : B→ₗ[ℝ] ℂ) (s : ℂ) (X Y Z : B) (source : (1/2 : ℝ) • (X-Y)=Z) :
    (-(s*L X)-(-(s*L Y)))/2= -(s*L Z) := by
  rw [←source,map_smul,map_sub,Complex.real_smul]
  norm_num
  ring

attribute [local irreducible] sourcePolePrepared sourceColorReader sourceStaticCoefficient sourceColorStaticCoefficient

theorem sourceColorStaticCoefficient_generated (q : PhysicalResponsePoint) (left right : RestStateIndex)
    (mu : Fin 4) (i j : Channel q.F) :
    (sourceStaticCoefficient q left right mu 6 i j-sourceStaticCoefficient q left right mu 7 i j)/2=
      sourceColorStaticCoefficient q left right mu i j := by
  unfold sourceStaticCoefficient sourceColorStaticCoefficient
  exact weighted_half_read
    (((innerSL ℂ (channel q.F i (sourcePolePrepared q.epsilon q.precision 0 left))).comp
      (ContinuousLinearMap.apply ℂ H (channel q.F j (sourcePolePrepared q.epsilon q.precision 0 right)))).toLinearMap.restrictScalars ℝ)
    _ _ _ _ (sourceColorReader_generated mu 0 q.F)

theorem sourceColorCurrent_channels (q : PhysicalResponsePoint) (left right : RestStateIndex)
    (mu : Fin 4) (t : ℝ) (nonrealL : q.z.im≠0) (nonrealR : q.w.im≠0) :
    sourceColorCurrent q 0 0 left right mu t=
      ∑ i : Channel q.F,∑ j : Channel q.F,sourceStaticPhase q.F i j t*sourceColorStaticCoefficient q left right mu i j := by
  unfold sourceColorCurrent
  rw [sourceStaticCurrent_channels q left right mu 6 t nonrealL nonrealR,
    sourceStaticCurrent_channels q left right mu 7 t nonrealL nonrealR]
  rw [←Finset.sum_sub_distrib,Finset.sum_div]
  apply Finset.sum_congr rfl
  intro i _
  rw [←Finset.sum_sub_distrib,Finset.sum_div]
  apply Finset.sum_congr rfl
  intro j _
  rw [←sourceColorStaticCoefficient_generated]
  ring

def sourceColorStaticResidue (q : PhysicalResponsePoint) (left right : RestStateIndex)
    (mu : Fin 4) : ℂ :=
  ∑ i : Channel q.F,∑ j : Channel q.F,
    if channelValue q.F i=channelValue q.F j then sourceColorStaticCoefficient q left right mu i j else 0

theorem sourceConstraintChargeResidue_color (q : PhysicalResponsePoint) (left right : RestStateIndex) :
    sourceConstraintChargeResidue q left right=sourceColorStaticResidue q left right 0 := by
  unfold sourceConstraintChargeResidue sourceStaticResidue sourceColorStaticResidue
  rw [←Finset.sum_sub_distrib,Finset.sum_div]
  apply Finset.sum_congr rfl
  intro i _
  rw [←Finset.sum_sub_distrib,Finset.sum_div]
  apply Finset.sum_congr rfl
  intro j _
  split_ifs with equalEnergy
  · exact sourceColorStaticCoefficient_generated q left right 0 i j
  · ring

theorem sourceActualColorCharge_Abel_zero (q : PhysicalResponsePoint) (left right : RestStateIndex)
    (nonrealL : q.z.im≠0) (nonrealR : q.w.im≠0) :
    Tendsto (fun eta : ℝ=>(eta : ℂ)*constraintChargeRead (sourcePoleCurrentHalf q 0 0 left right (eta : ℂ)))
      (nhdsWithin 0 (Ioi 0)) (𝓝 (sourceColorStaticResidue q left right 0)) := by
  rw [←sourceConstraintChargeResidue_color]
  exact sourceConstraintCharge_Abel_zero q left right nonrealL nonrealR

