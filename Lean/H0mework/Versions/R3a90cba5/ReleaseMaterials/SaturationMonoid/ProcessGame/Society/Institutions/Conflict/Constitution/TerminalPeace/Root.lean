theorem the_original_six_is_a_lower_bound_under_every_original_continuation (suffix : Original.Word) :
    6 ≤ outstandingForGood false
      (Reparation.Actual.run Original.seed Original.community (Original.history ++ suffix)).stack.balances := by
  have retained := Material.every_original_history_keeps_or_increases_outstanding_reparation
    (seed := Original.seed) (community := Original.community) Original.history suffix false
  have initial : outstandingForGood false Original.state.stack.balances = 6 := by
    rw [Original.balances_exact]
    change (if Original.occurrence.key.2.2 = false then Original.balance.remaining else 0) + 0 = 6
    rw [show Original.occurrence.key.2.2 = false from rfl, if_pos rfl, add_zero, Original.balance_six]
  exact initial.ge.trans retained

/-- Every schedule of the installed dispatch starts with the same original
whole-ledger recourse. The original scheduler emits the suffix under the
exact damage gate. Every old balance is retained. -/
theorem source_generated_protected_cut :
    ∃ reached : WarVisit,
      reached.history = Original.history ++ [stop] ∧
      (endAt Original.seed reached.history).raw.clock = 4 ∧
      Quantities.Recorded Original.seed reached.history ∧
      reached.state.stack.balances = [(Original.occurrence, Original.balance)] ∧
      ∀ (answers : OwnerAnswers Original.seed) (raw : WarScheduler) (person : Bool) (tick : Nat),
        run answers raw person (tick + 1) =
          raw.run answers person (damageGate Original.community) (fun _ _ => openProbe) reached tick ∧
        ∃! suffix : Original.Word, (run answers raw person (tick + 1)).history = reached.history ++ suffix := by
  refine ⟨protectedCut, the_original_installation_writes_its_literal_first_input _, the_original_installation_consumes_no_physical_time,
    Quantities.record _ _, ?_, fun answers raw person tick =>
      ⟨every_arbitration_factors_through_the_same_protected_whole_state answers raw person tick,
        every_subsequent_history_has_its_unique_actual_suffix answers raw person tick⟩⟩
  exact (the_revised_visit_keeps_the_exact_original_reparation_portfolio opening _ openProbe stop).trans Original.balances_exact

/-- Every proposed completion retaining this original material and
receipt compiler hits both obstructions. The food failure is generated
from the policy at the first or second actual stage. -/
theorem the_original_source_has_independent_material_and_receipt_obstructions
    (suffix : Original.Word) :
    (∀ (policy : Cadence) (Issue : Nat → C → Original.Word → Type)
      (inspect : (n : Nat) → (cut : C) → (word : Original.Word) → Option (Issue n cut word)),
      ¬ Quantities.Bounds.Cofinal.Paid (endAt Original.cut suffix) policy Issue inspect) ∧
    6 ≤ outstandingForGood false
      (Reparation.Actual.run Original.seed Original.community (Original.history ++ suffix)).stack.balances :=
  ⟨fun policy _ inspect => no_paid_cofinal_cadence_can_start_at_an_original_later_cut suffix policy inspect,
    the_original_six_is_a_lower_bound_under_every_original_continuation suffix⟩

theorem the_first_paid_protected_successor_disposes_of_both_living_claims
    (suffix : Original.Word) :
    let current := endAt Original.seed paidLivingVisit.history
    Quantities.Recorded Original.seed paidLivingVisit.history ∧
      current.raw.clock = 5 ∧
      paidLivingVisit.state.stack.balances = [(Original.occurrence, Original.balance)] ∧
      (∀ person : Bool, ∃ gap : Quantities.Demand.Deficit current suffix,
        gap.cell = (person, .necessity, true, 1) ∧
          Quantities.Demand.delivered current suffix person .necessity true = 0) ∧
      ∀ control : Original.Raw → List Bool,
        ¬ Exit.Available Original.seed Original.community Original.history paidLivingVisit.history control := by
  have paid := the_protected_runtime_writes_one_original_living_period
  refine ⟨paid.2.1, ?_, paid.2.2.2.2.2, fun person => ⟨the_protected_successor_has_a_named_food_shortage suffix person,
    rfl, the_protected_successor_cannot_deliver_food suffix person⟩,
    the_paid_protected_successor_has_no_original_independent_exit⟩
  rw [paid.2.2.2.2.1, Original.cut_raw]
  decide +kernel

end

