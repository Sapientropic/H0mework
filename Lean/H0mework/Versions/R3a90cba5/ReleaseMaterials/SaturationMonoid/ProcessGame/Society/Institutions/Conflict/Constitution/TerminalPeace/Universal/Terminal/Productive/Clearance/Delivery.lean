import H0mework.Versions.R3a90cba5.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Terminal.Productive.Clearance.Delivery.Native

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Terminal.Clearance

open Capitalism.Universal.Source.Program
open Capitalism.Universal.Abolition.Root.Registered
open Capitalism.Universal.Abolition.Accounting.Quantifiers.Assembly.Strengthening
open Capitalism.Universal.Abolition.Innovation.Contribution.Pricing.Root.Runtime (Ready ReviewAvailable Trace)
open Quantities.Execution
open Reparation (Key)
open Reparation.Actual (JointReceipt ReceiptAnswers payerCredit)
open Reparation.Actual.Allocation (Position itemPositions originalItem)
open private keysAt original_key from
  H0mework.Versions.R3a90cba5.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Boundary.Actual.Incidence

noncomputable section

variable {Party Good Port Technology Instrument Community : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Port]
  [DecidableEq Instrument] [DecidableEq Community]

local notation "Cut" => Conflict.Root.Cut Party Good Port Technology Instrument
local notation "Word" => Reparation.Actual.Script Party Good Port Technology Instrument
local notation "Item" => ExecutionItem Party Good Port Technology Instrument
local notation "Address" => Key Party Good

variable (seed : Conflict.Root.Cut Party Good Port Technology Instrument)
  (community : Party → Community) (answers : ReceiptAnswers seed)
  (past : Reparation.Actual.Script Party Good Port Technology Instrument)
  (purpose : Port) (key : Key Party Good) (quantity : ℚ)

local notation "Here" => (endAt seed past)
local notation "RequestAt" => (paymentRequest purpose key quantity : Request Party Good Port Technology Instrument)
local notation "PaidInput" => (payment purpose key quantity : Reparation.Actual.Input Party Good Port Technology Instrument)
local notation "PaidWord" => (installment purpose key quantity : Word)
local notation "NextCut" => (endAt seed (past ++ PaidWord))
local notation "ExactItem" => (ExecutionItem.mk 0 (Evolving.Epoch.Current.raw Here) RequestAt : Item)

/-- The receipt is generated by the sole actual delivery position. The
second native input consumes the pending head without a second delivery. -/
structure DeliveryAt where
  items : Boundary.Actual.items (Here) PaidInput = [ExactItem]
  accounting_empty : Boundary.Actual.items (endAt seed (past ++ [PaidInput])) none = []
  noDamage : Boundary.Actual.damages (Here) PaidInput community = []
  position : Position seed past PaidInput
  position_zero : position.val = 0
  positions : itemPositions (seed := seed) past PaidInput = [position]
  receipt : JointReceipt seed key
  issued : Settlement.jointOffer answers past PaidInput position key = some receipt
  exactQuantity : receipt.quantity = quantity
  limitAtExact : ∀ good, Settlement.limitAt past PaidInput position good =
    if good = key.2.2 then quantity else 0
  onlyReceipt : ∀ other, other ≠ key → Settlement.jointOffer answers past PaidInput position other = none
  eligible : ∀ anchor, Occurrence.EligibleFrom community answers anchor past PaidWord
  trace : Trace (Here) [RequestAt] (NextCut)
  ready : Ready (NextCut)
  review : ReviewAvailable (NextCut)
  raw : (NextCut).raw = deliveredRaw (Here).raw key quantity

variable {seed community answers past purpose key quantity}

theorem DeliveryAt.limit (delivery : DeliveryAt seed community answers past purpose key quantity) :
    Settlement.limitAt past PaidInput delivery.position key.2.2 = quantity := by
  rw [delivery.limitAtExact, if_pos rfl]

theorem DeliveryAt.item (delivery : DeliveryAt seed community answers past purpose key quantity) :
    originalItem seed past PaidInput delivery.position = ExactItem := by
  have listed : originalItem seed past PaidInput delivery.position ∈ Boundary.Actual.items (Here) PaidInput :=
    List.getElem_mem _
  rw [delivery.items] at listed
  exact List.mem_singleton.mp listed

private theorem the_debit_is_the_signers_own (legal : (Here).native.input.law.Valid (Here).raw RequestAt) :
    (Boundary.Actual.materialLaw (Here)).actualDebit (Here).raw RequestAt =
      [((key.2.1, key.2.2), quantity)] := by
  have physical : (Boundary.Actual.materialLaw (Here)).Valid (Here).raw RequestAt :=
    PublicFunction.valid_physical _ _ _ legal
  rw [RawLaw.actualDebit, if_pos physical]
  rfl

private theorem the_transfer_cannot_open_damage
    (items : Boundary.Actual.items (Here) PaidInput = [ExactItem])
    (legal : (Here).native.input.law.Valid (Here).raw RequestAt) :
    Boundary.Actual.damages (Here) PaidInput community = [] := by
  apply List.eq_nil_iff_forall_not_mem.mpr
  intro damage _
  have listed := damage.source_item
  rw [items] at listed
  have literal := List.mem_singleton.mp listed
  have keys := original_key damage
  unfold keysAt at keys
  rw [literal] at keys
  change damage.key ∈ ((Boundary.Actual.materialLaw (Here)).actualDebit (Here).raw RequestAt).map
    (fun entry => (entry.1.1, key.2.1, entry.1.2)) at keys
  rw [the_debit_is_the_signers_own legal] at keys
  have original : damage.key = (key.2.1, key.2.1, key.2.2) := List.mem_singleton.mp keys
  have foreign := damage.actual_foreign_debit.1.1
  rw [original] at foreign
  exact foreign rfl

private theorem every_transfer_question_addresses_its_payer
    (legal : (Here).native.input.law.Valid (Here).raw RequestAt)
    (question : ExposureGuard.Question Party Good Instrument)
    (asked : question ∈ ExposureGuard.questions (Here) ExactItem) : question.1 = key.2.1 := by
  change question ∈ (key.2.1, .signature) :: (ExposureGuard.materialQuestions (Here) ExactItem ++ []) at asked
  rw [List.append_nil] at asked
  rcases List.mem_cons.mp asked with signed | material
  · exact congrArg Prod.fst signed
  · obtain ⟨entry, listed, same⟩ := List.mem_filterMap.mp material
    change entry ∈ (Boundary.Actual.materialLaw (Here)).actualDebit (Here).raw RequestAt at listed
    rw [the_debit_is_the_signers_own legal] at listed
    rcases List.mem_singleton.mp listed with rfl
    dsimp only at same
    split at same
    · exact congrArg Prod.fst (Option.some.inj same).symm
    · cases same

private theorem original_credit (legal : seed.native.input.law.Valid (Here).raw RequestAt) (good : Good) :
    flowAt (seed.native.input.law.actualCredit (Here).raw RequestAt) key.1 good =
      if good = key.2.2 then quantity else 0 := by
  rw [RawLaw.actualCredit, if_pos legal]
  change flowAt (locate key.1 [(key.2.2, quantity)]) key.1 good = _
  rw [singleton_delivery_flow]
  simp

private theorem signed_credit_is_exact (legal : seed.native.input.law.Valid (Here).raw RequestAt)
    (distinct : key.1 ≠ key.2.1) (positive : 0 < quantity) :
    payerCredit seed.native.input.law ExactItem key = quantity := by
  have signed : key.1 ≠ key.2.1 ∧ (ExactItem).request.signer = key.2.1 ∧
      seed.native.input.law.Valid (ExactItem).before (ExactItem).request :=
    ⟨distinct, rfl, legal⟩
  unfold payerCredit
  rw [if_pos signed]
  change (if key.2.1 = key.2.1 ∧ key.1 = key.1 then
    max 0 (flowAt (seed.native.input.law.actualCredit (Here).raw RequestAt) key.1 key.2.2) else 0) = _
  rw [if_pos ⟨rfl, rfl⟩, original_credit legal, if_pos rfl, max_eq_right positive.le]

private theorem credit_has_no_other_address (legal : seed.native.input.law.Valid (Here).raw RequestAt)
    (other : Address) (distinct : other ≠ key) :
    payerCredit seed.native.input.law ExactItem other = 0 := by
  unfold payerCredit
  split
  · change (if key.2.1 = other.2.1 ∧ key.1 = other.1 then
      max 0 (flowAt (seed.native.input.law.actualCredit (Here).raw RequestAt) other.1 other.2.2) else 0) = _
    split
    · rename_i parties
      have good : other.2.2 ≠ key.2.2 := fun equal =>
        distinct (Prod.ext parties.2.symm (Prod.ext parties.1.symm equal))
      rw [← parties.2, original_credit legal, if_neg good, max_self]
    · rfl
  · rfl

/-- Consume a funded singleton transfer at the exact native cut, keeping
authorization, paid material and both replies at the one original item. -/
def executeDelivery (ready : Ready (Here)) (review : ReviewAvailable (Here))
    (positive : 0 < quantity) (funded : quantity ≤ (Here).raw.stock key.2.1 key.2.2)
    (channel : IndependentReceiptChannel seed answers past purpose key quantity) :
    DeliveryAt seed community answers past purpose key quantity := by
  let legal := delivery_has_original_authority channel positive funded
  have inOriginalLaw : seed.native.input.law.Valid (Here).raw RequestAt := by
    rw [← endAt_input seed past]
    exact legal
  let items := the_delivery_writes_one_original_item ready review legal
  let drain := the_delivery_accounting_writes_no_material ready review legal
  let noDamage := the_transfer_cannot_open_damage (community := community) items legal
  let position : Position seed past PaidInput := ⟨0, by
    rw [items]
    exact Nat.zero_lt_one⟩
  have positions : itemPositions (seed := seed) past PaidInput = [position] := by
    have count : (itemPositions (seed := seed) past PaidInput).length = 1 := by
      change (List.finRange (Boundary.Actual.items (Here) PaidInput).length).length = 1
      rw [List.length_finRange, items]
      rfl
    obtain ⟨only, exactPositions⟩ := List.length_eq_one_iff.mp count
    have width : (Boundary.Actual.items (Here) PaidInput).length = 1 := congrArg List.length items
    have onlyAtZero : only.val = 0 := Nat.eq_zero_of_le_zero (Nat.le_of_lt_succ (only.isLt.trans_eq width))
    have exactPosition : only = position := Fin.ext onlyAtZero
    rw [exactPositions, exactPosition]
  have literal (site : Position seed past PaidInput) : originalItem seed past PaidInput site = ExactItem := by
    have listed : originalItem seed past PaidInput site ∈ Boundary.Actual.items (Here) PaidInput := List.getElem_mem _
    rw [items] at listed
    exact List.mem_singleton.mp listed
  have paid : payerCredit seed.native.input.law (originalItem seed past PaidInput position) key = quantity := by
    rw [literal]
    exact signed_credit_is_exact inOriginalLaw channel.distinct positive
  let delivered : JointReceipt seed key :=
    .mk past PaidInput position answers (channel.payer position) (channel.victim position) (paid.symm ▸ positive)
  have issued : Settlement.jointOffer answers past PaidInput position key = some delivered := by
    unfold Settlement.jointOffer
    rw [dif_pos ⟨delivered.payer, delivered.victim, delivered.positive⟩]
  have limits (good : Good) : Settlement.limitAt past PaidInput position good =
      if good = key.2.2 then quantity else 0 := by
    unfold Settlement.limitAt
    rw [literal]
    change max 0 (flowAt (seed.native.input.law.actualCredit (Here).raw RequestAt) key.1 good) = _
    rw [original_credit inOriginalLaw]
    split <;> simp [max_eq_right positive.le]
  have onlyReceipt (other : Address) (otherAddress : other ≠ key) :
      Settlement.jointOffer answers past PaidInput position other = none := by
    have zero : payerCredit seed.native.input.law (originalItem seed past PaidInput position) other = 0 := by
      rw [literal]
      exact credit_has_no_other_address inOriginalLaw other otherAddress
    unfold Settlement.jointOffer
    exact dif_neg fun signed => (lt_irrefl 0) (zero ▸ signed.2.2)
  have eligible (anchor : Word) : Occurrence.EligibleFrom community answers anchor past PaidWord := by
    refine ⟨⟨⟨?_, ?_⟩, noDamage⟩, ⟨ExposureGuard.no_material_is_admitted _ _ _ _ drain,
      Boundary.Actual.no_material_write_has_no_damage _ _ _ drain⟩, trivial⟩
    · intro item listed
      change item ∈ Boundary.Actual.items (Here) PaidInput at listed
      rw [items] at listed
      rw [List.mem_singleton.mp listed]
      exact legal
    · intro site question asked _
      change question ∈ ExposureGuard.questions (Here) (originalItem seed past PaidInput site) at asked
      rw [literal] at asked
      rw [every_transfer_question_addresses_its_payer legal question asked]
      exact channel.payer site
  have ran := the_delivery_consumes_its_original_native_head ready review legal
  exact ⟨items, drain, noDamage, position, rfl, positions, delivered, issued, paid, limits, onlyReceipt, eligible,
    ran.1, ran.2.1, ran.2.2, the_delivery_reads_its_exact_original_successor ready review legal⟩

#print axioms executeDelivery
#print axioms DeliveryAt.item
#print axioms DeliveryAt.limit

end

end SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Terminal.Clearance
