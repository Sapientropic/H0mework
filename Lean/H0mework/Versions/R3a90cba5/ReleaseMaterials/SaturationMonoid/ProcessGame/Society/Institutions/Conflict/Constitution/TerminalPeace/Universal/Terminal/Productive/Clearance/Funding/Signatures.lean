noncomputable section

variable {Party Good Port Technology Instrument Community : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Port] [DecidableEq Instrument] [DecidableEq Community]

local notation "C" => Conflict.Root.Cut Party Good Port Technology Instrument
local notation "Word" => Script Party Good Port Technology Instrument
local notation "Item" => ExecutionItem Party Good Port Technology Instrument

variable {seed : Conflict.Root.Cut Party Good Port Technology Instrument} {community : Party → Community}

private theorem own_item_asks_its_signer (source : C) {roster : List Party} {item : Item}
    (owned : Supply.OwnItem (Boundary.Actual.materialLaw source) roster item)
    (question : ExposureGuard.Question Party Good Instrument)
    (asked : question ∈ ExposureGuard.questions source item) :
    question.1 = item.request.signer := by
  unfold ExposureGuard.questions at asked
  rcases List.mem_cons.mp asked with signature | others
  · exact congrArg Prod.fst signature
  · rcases List.mem_append.mp others with material | financial
    · unfold ExposureGuard.materialQuestions at material
      obtain ⟨lot, present, matched⟩ := List.mem_filterMap.mp material
      dsimp only at matched
      split at matched
      · have same := congrArg Prod.fst (Option.some.inj matched)
        exact same.symm.trans (owned.actual_debit_is_own lot present)
      · cases matched
    · have safe := owned.operation.stable_request.1
      cases kind : item.request.operation <;>
        simp_all [ExposureGuard.financialQuestions, Capitalism.Universal.Abolition.Root.Settlement.NonFinancialRequest]

/-- The exact native body needs only the actual signers' personal answers.
The native accounting visits generated by it have empty material inventory. -/
theorem signed_period_and_accounting_is_eligible (answers : ReceiptAnswers seed) (anchor past : Word)
    (origin : RawCurrent Party Good Technology Instrument) (roster : List Party)
    (word : RawEvent Party Good Port Technology Instrument)
    (ready : Ready (endAt seed past)) (review : ReviewAvailable (endAt seed past))
    (paid : Supply.Period (endAt seed past).native.input origin (endAt seed past).raw roster word)
    (guards : FundingChecks (endAt seed past) origin roster word)
    (signed : SignersChose answers past [some (.execute word)]) :
    Occurrence.EligibleFrom community answers anchor past (periodAndAccounting (endAt seed past) word) := by
  let source := endAt seed past
  let request : Reparation.Actual.Input Party Good Port Technology Instrument := some (.execute word)
  have effect := paid_body_reads_the_original_execution source origin roster word ready review paid guards
  have owned (item : Item) (listed : item ∈ Boundary.Actual.items source request) :
      Supply.OwnItem source.native.input.law roster item := by
    rw [effect.2] at listed
    exact paid.own item listed
  have publicOwned (item : Item) (listed : item ∈ Boundary.Actual.items source request) :
      Supply.OwnItem (Boundary.Actual.materialLaw source) roster item :=
    let original := owned item listed
    ⟨original.operation, original.member, original.noConsent, PublicFunction.valid_physical _ _ _ original.valid⟩
  change Occurrence.EligibleAt community answers anchor past request ∧
    Occurrence.EligibleFrom community answers anchor (past ++ [request]) (drain (next source request))
  refine ⟨⟨⟨fun item listed => (owned item listed).valid, ?_⟩, ?_⟩, ?_⟩
  · intro position question asked _
    have legal := publicOwned _ (List.getElem_mem position.isLt)
    have signer := own_item_asks_its_signer source legal question asked
    rw [signer]
    exact signed.1 position
  · apply List.eq_nil_iff_forall_not_mem.mpr
    intro damage _
    have safe := (publicOwned damage.item damage.source_item).opens_no_coercive_loss community damage.key
    exact (not_lt_of_ge safe.le) damage.positive
  · apply empty_inventory_is_eligible
    rw [endAt_append]
    exact (the_first_exhausted_native_cut_is_the_original_paid_drain (next source request)).2.2.1

end

end SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Terminal.Clearance.Funding
