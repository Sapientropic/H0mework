import H0mework.Versions.R3a90cba5.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Reparation.Actual.Portfolio.Allocation.Input
import H0mework.Versions.R3a90cba5.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Reparation.Actual.Portfolio.Consume

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Reparation.Actual

open Capitalism.Universal.Abolition.Accounting.Quantifiers.Assembly.Strengthening
open Quantities.Execution (endAt next)
open Allocation

noncomputable section

variable {Party Good Port Technology Instrument Community : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Port]
  [DecidableEq Instrument] [DecidableEq Community]
  {seed : Root.Cut Party Good Port Technology Instrument} {community : Party → Community}

local notation "Row" => Occurrence seed community × Balance

variable (past : Script Party Good Port Technology Instrument) (input : Input Party Good Port Technology Instrument)

local notation "AtTick" => StateAt seed community (next (endAt seed past) input)

private theorem result_after_cast {old new : List Row} (same : old = new) (changes : Changes new) :
    (same.symm ▸ changes : Changes old).result = changes.result := by cases same; rfl

/-- Use the actual allocator at each material position once. Every tail
starts at the canonical visit generated by the preceding ledger write. -/
private def consumeItems :
    {positions : List (Position seed past input)} → {rows : List Row} →
      (trace : ItemWrites (community := community) past input positions rows) →
      (state : AtTick) → state.stack.balances = rows →
      { written : AtTick // written.stack.balances = trace.result }
  | _, _, .nil, state, same => ⟨state, same⟩
  | _, _, .next (position := position) (rows := rows) tail, state, same =>
    let changes := (atItem seed past input position rows).changes
    let exactChanges : Changes state.stack.balances := same.symm ▸ changes
    let successor := state.consume exactChanges
    let literal := (StateAt.consume_balances state exactChanges).trans (result_after_cast same changes)
    consumeItems tail successor literal

variable (state : StateAt seed community (next (endAt seed past) input))

def writtenReceipts :
    { written : AtTick // written.stack.balances = (atInput past input state.stack.balances).result } :=
  consumeItems (seed := seed) (community := community) past input
    (atInput (seed := seed) past input state.stack.balances) state rfl

theorem the_generated_receipts_do_not_overdraw_any_original_good (good : Good) :
    let trace := atInput past input state.stack.balances
    (writtenReceipts past input state).val.stack.balances = trace.result ∧
      trace.assignedForGood good ≤ inputQuantity (seed := seed) past input good ∧
      (itemPositions (seed := seed) past input).Nodup :=
  ⟨(writtenReceipts past input state).property,
    an_input_cannot_overdraw_any_good past input state.stack.balances good,
    (each_input_visits_every_original_position_once (seed := seed) past input).1⟩

end

end SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Reparation.Actual
