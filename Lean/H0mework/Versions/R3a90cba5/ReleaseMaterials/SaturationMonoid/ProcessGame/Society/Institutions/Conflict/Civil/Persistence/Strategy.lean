import H0mework.Versions.R3a90cba5.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Civil.Persistence.Play

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Civil.Persistence

open Capitalism.Universal.Abolition.Accounting.Quantifiers.Assembly.Strengthening

noncomputable section

universe u

variable {Party Good Port Technology Instrument : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Port] [DecidableEq Instrument]
  {Observation : Type u}

local notation "C" => Root.Cut Party Good Port Technology Instrument
local notation "Word" => Script Party Good Port Technology Instrument
local notation "P" => Position Party Good Port Technology Instrument Observation
local notation "Strategy" => History Observation → Word

def Follows (origin : C) (read : C → Observation) (strategy : Strategy)
    (required : P → Word → Word → Prop) : Prop :=
  ∀ (rival : Nat → Word) (round : Nat),
    let position := (play origin read strategy rival round).position
    required position (strategy position.seen) (rival round)

/-- At a single visible history one intervention has to work in the whole
reachable observation fibre. The rival's next script is unrestricted. -/
def ClosedFor (read : C → Observation) (required : P → Word → Word → Prop) (family : P → Prop) : Prop :=
  ∀ seen : History Observation, (∃ position, family position ∧ position.seen = seen) →
    ∃ move : Word, ∀ position, family position → position.seen = seen → ∀ reply : Word,
      required position move reply ∧ family (position.extend read move reply)

/-- This chooses a single response at the observation, before any further
rival input. Each resulting path is generated by the installed epoch fold. -/
theorem follows_iff_one_response_closes_each_reachable_observation_fibre
    (origin : C) (read : C → Observation) (required : P → Word → Word → Prop) :
    (∃ strategy : Strategy, Follows origin read strategy required) ↔
      ∃ family : P → Prop, family (Position.start origin read) ∧ ClosedFor read required family := by
  classical
  constructor
  · rintro ⟨strategy, wins⟩
    let family (position : P) := ∃ (rival : Nat → Word) (round : Nat),
      (play origin read strategy rival round).position = position
    refine ⟨family, ⟨fun _ => [], 0, rfl⟩, ?_⟩
    intro seen _alive
    refine ⟨strategy seen, ?_⟩
    rintro position ⟨rival, round, rfl⟩ visible reply
    let trial (tick : Nat) := if tick = round then reply else rival tick
    have same := play_ignores_future_submissions origin read strategy rival trial round
      (fun tick earlier => by simp [trial, Nat.ne_of_lt earlier])
    have replied : trial round = reply := if_pos rfl
    have paid := wins trial round
    dsimp only at paid
    rw [← same, replied, visible] at paid
    refine ⟨paid, trial, round + 1, ?_⟩
    change ((play origin read strategy trial round).position.extend read
      (strategy (play origin read strategy trial round).position.seen) (trial round)) = _
    rw [← same, replied, visible]
  · rintro ⟨family, initial, closed⟩
    let strategy : Strategy := fun seen =>
      if reachable : ∃ position, family position ∧ position.seen = seen then
        Classical.choose (closed seen reachable)
      else []
    have one (position : P) (inside : family position) (reply : Word) :
        required position (strategy position.seen) reply ∧
          family (position.extend read (strategy position.seen) reply) := by
      have reachable : ∃ here : P, family here ∧ here.seen = position.seen := ⟨position, inside, rfl⟩
      simp only [strategy, dif_pos reachable]
      exact Classical.choose_spec (closed _ reachable) position inside rfl reply
    refine ⟨strategy, ?_⟩
    intro rival round
    have reached : ∀ n, family (play origin read strategy rival n).position := by
      intro n
      induction n with
      | zero => exact initial
      | succ n previous => exact (one _ previous (rival n)).2
    exact (one _ (reached round) (rival round)).1

end

end SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Civil.Persistence
