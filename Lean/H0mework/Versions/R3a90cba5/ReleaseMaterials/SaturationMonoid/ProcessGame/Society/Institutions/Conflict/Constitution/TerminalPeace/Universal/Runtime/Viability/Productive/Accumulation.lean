variable {Party Good Port Technology Instrument : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Instrument]
  {input : ProgrammeSource.Input Party Good Port Technology Instrument}
  {origin raw : RawCurrent Party Good Technology Instrument} {roster : List Party}

namespace Supply

open private own_after_paid_reserve_and_clock current_needs_after_paid_reserve_and_clock from
  H0mework.Versions.R3a90cba5.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Supply.Replay

/-- A person's already paid word remains executable after an added
reserve, whether or not that personal word itself accumulates stock. -/
theorem Period.after_reserve_and_clock {word : RawEvent Party Good Port Technology Instrument}
    (paid : Period input origin raw roster word)
    (timing : input.law.TimeIndependent) (reserveLaw : input.law.ReserveInsensitive)
    (reserve : Party → Good → ℚ) (nonnegative : ∀ person good, 0 ≤ reserve person good)
    (clock : ℚ) (round : Nat)
    (advances : 0 < input.law.duration ((raw.addReserve reserve).retime clock round)) :
    Period input origin ((raw.addReserve reserve).retime clock round) roster word := by
  refine ⟨own_after_paid_reserve_and_clock paid timing reserveLaw reserve nonnegative clock round,
    ?_, current_needs_after_paid_reserve_and_clock paid timing reserveLaw reserve nonnegative clock round, advances⟩
  apply (originalNeedFloor_retime input timing origin (raw.addReserve reserve) clock round roster word).mpr
  exact originalNeedFloor_addReserve input reserveLaw origin raw reserve nonnegative roster word
    (fun item present => (paid.own item present).valid) paid.originalFloor

end Supply

namespace Runtime.Viability.Move

def earnedReserve (move : Move input origin roster raw) (n : Nat) : Party → Good → ℚ :=
  accumulatedReserve (Balance.gain input.law raw move.word) n

/-- Registration is retained on the ray generated by the actual net
material effect. The time bound is a law on nonnegative reserves. -/
structure AccumulationLaw (move : Move input origin roster raw) (quantum : ℚ) : Prop where
  timing : input.law.TimeIndependent
  reserve : input.law.ReserveInsensitive
  accumulating : Balance.FiniteChecks .accumulating input.law raw move.word
  positive : 0 < quantum
  duration : ∀ (extra : Party → Good → ℚ), (∀ person good, 0 ≤ extra person good) →
    ∀ clock round, quantum ≤ input.law.duration ((raw.addReserve extra).retime clock round)
  registered : ∀ n clock round word, Supply.Registered input raw word →
    Supply.Registered input ((raw.addReserve (move.earnedReserve n)).retime clock round) word

variable {quantum : ℚ}

private theorem registered_and_personal_after_accumulation
    (move : Move input origin roster raw) (law : move.AccumulationLaw quantum) (n : Nat) :
    let reached := (repeatPeriod input raw move.word).currentAt n
    (∀ word, Supply.Registered input raw word → Supply.Registered input reached word) ∧
      ∀ person ∈ roster, ∃ word, Supply.Registered input reached word ∧ Supply.Period input origin reached [person] word := by
  dsimp only
  have actual := Balance.checked_productive_period input.law raw move.word law.accumulating
  obtain ⟨clock, round, same⟩ := generated_current_has_only_paid_accumulation input law.timing law.reserve
    raw move.word (Balance.gain input.law raw move.word) actual.2 actual.1
    (fun item listed => (move.paid.own item listed).valid) n
  have funded : ∀ person good, 0 ≤ move.earnedReserve n person good :=
    accumulatedReserve_nonnegative _ actual.2 n
  rw [same]
  refine ⟨law.registered n clock round, ?_⟩
  intro person listed
  obtain ⟨word, registered, paid⟩ := move.personal person listed
  exact ⟨word, law.registered n clock round word registered,
    paid.after_reserve_and_clock law.timing law.reserve (move.earnedReserve n) funded clock round
      (law.positive.trans_le (law.duration _ funded clock round))⟩

/-- Repeat the finite original word through its actual native successor,
retaining the separate registered exit of every original bearer. -/
def accumulatingTrajectory (move : Move input origin roster raw) (law : move.AccumulationLaw quantum) :
    Trajectory input origin roster raw where
  state := (repeatPeriod input raw move.word).currentAt
  initial := rfl
  move n :=
    let carried := move.registered_and_personal_after_accumulation law n
    ⟨move.word, carried.1 move.word move.registered,
      (move.paid.replay law.timing law.reserve law.accumulating quantum law.positive law.duration n).1, carried.2⟩
  next_eq _ := rfl
  cofinal cut bound := by
    obtain ⟨n, beyond⟩ := move.paid.replay_passes_every_real_horizon
      law.timing law.reserve law.accumulating quantum law.positive law.duration bound
    have monotone : Monotone (fun n => ((repeatPeriod input raw move.word).currentAt n).clock) :=
      monotone_nat_of_le_succ (fun _ => input.law.next_clock_nondecreasing _ _)
    exact ⟨max cut n, le_max_left _ _, beyond.trans_le (monotone (le_max_right _ _))⟩

theorem accumulation_is_live (move : Move input origin roster raw) (law : move.AccumulationLaw quantum) :
    Live input origin roster raw :=
  (move.accumulatingTrajectory law).initial_is_live

theorem accumulation_restarts (move : Move input origin roster raw) (law : move.AccumulationLaw quantum) :
    Live input origin roster move.next :=
  (move.accumulatingTrajectory law).every_actual_state_is_live 1

end Runtime.Viability.Move

