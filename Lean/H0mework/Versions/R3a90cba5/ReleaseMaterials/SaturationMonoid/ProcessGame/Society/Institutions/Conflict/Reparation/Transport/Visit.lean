import H0mework.Versions.Rf1d58550.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Reparation.History.Opening

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Reparation.Transport

open Capitalism.Universal.Abolition.Accounting.Quantifiers.Assembly.Strengthening
open Capitalism.Universal.Abolition.Accounting.Root
open Capitalism.Universal.Abolition.Root.Registered.Macro
open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot RootInquiryCompletion DebtActivationWorld

noncomputable section

variable {Party Good Port Technology Instrument : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Port] [DecidableEq Instrument]

local notation "Native" => Evolving.NativeCurrent (Party := Party) (Good := Good) (Port := Port)
  (Technology := Technology) (Instrument := Instrument)

variable {law : DebtActivationLaw} {joint : WorldRelationNetwork}
  {native : Evolving.NativeCurrent (Party := Party) (Good := Good) (Port := Port)
    (Technology := Technology) (Instrument := Instrument)}
  {shape : Shape law native.frame.N joint} {phase : law.DebtState}

structure Resident (shape : Shape law native.frame.N joint) (phase : law.DebtState)
    (wait : law.TransportAt phase phase) where
  V : ConstructiveRoot.Vocabulary
  root : SourceNativeLivingRootClosure joint V
  visit : SourceNativeTemporalVisitAt root.toAuthoritativeRoot.toLedgerRoot
  unique : ∀ occurrence : root.toAuthoritativeRoot.toRoot.actual.OccurrenceAt visit.current,
    occurrence = root.emitted visit.current
  support_eq : (root.emitted visit.current).1 = shape.support (sourceSupport native) phase
  entry : OpenResponsibilityAt joint (root.emitted visit.current).1
  repair_eq : HEq entry (shape.repair (sourceSupport native) phase)
  authority : SourceNativeLivingTemporalCausalEntryAuthorityAt root visit entry
  structural :
    Public.Inquiry.HasWork native.frame native.actual.actual →
      { next : SourceNativeLedgerGeneratedSuccessorAt (root.emitted visit.current)
          (root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt visit.current) //
        next.targetOccurrence.1 = shape.support (structuralTarget native) phase ∧
        HEq next.ledgerEvolution.destination
          (heldWrite native shape phase wait native.visit.current).val.destination }

namespace Resident

variable {wait : law.TransportAt phase phase} (resident : Resident shape phase wait)

abbrev support := (resident.root.emitted resident.visit.current).1

def erase : AnyAuthoritativeRootCurrent :=
  ⟨joint, ⟨resident.V, resident.root.toAuthoritativeRoot, resident.visit⟩⟩

theorem finite : Finite (OpenResponsibilityAt joint resident.support) :=
  cast (congrArg (fun support => Finite (OpenResponsibilityAt joint support)) resident.support_eq.symm)
    (shape.finiteRows _ _ (native.frame.entries_finite native.visit.current))

end Resident

namespace Frame

variable (frame : Frame native shape phase) (wait : law.TransportAt phase phase)
  (component : SourceNativeProjectionLaw (Compiler.ledgerSource (frame.flow wait)))

abbrev rooted := (Compiler.livingRoot (frame.flow wait)).withProjectionCoface component
abbrev initial := Compiler.initialVisit (frame.flow wait)
abbrev first := Compiler.successor (frame.flow wait) none
abbrev landing := (frame.initial wait).next (frame.first wait).next_eq

theorem landing_at_native : (frame.landing wait).current = some native.visit.current :=
  Compiler.successor_current (frame.flow wait) none

abbrev carriedEntry (entry : OpenResponsibilityAt joint frame.initialSupport) :=
  (frame.rooted wait component).toAuthoritativeRoot.toLedgerRoot.canonicalTargetEntryAtNext
    (frame.first wait).next_eq entry

theorem carriedEntry_is_first_destination (entry : OpenResponsibilityAt joint frame.initialSupport) :
    HEq (frame.carriedEntry wait component entry) (frame.initialWrite.val.destination entry).1 := by
  have canonical := Compiler.canonical_destination_heq
    (frame.rooted wait component).toAuthoritativeRoot.toLedgerRoot _ _ (frame.first wait).next_eq
    (frame.first wait) entry
  exact canonical.trans (destination_congr rfl (Compiler.successor_support (frame.flow wait) none)
    _ _ (Compiler.successor_destination (frame.flow wait) none) entry entry HEq.rfl)

private theorem read_heq {A : Type} {F : A → Type} (read : (a : A) → F a) {left right : A}
    (same : left = right) : HEq (read left) (read right) := by cases same; rfl

/-- The live entry is generated by the first compiler write and the
authority is that very entry's canonical successor authority. -/
def resident (entry : OpenResponsibilityAt joint frame.initialSupport)
    (repair : (frame.initialWrite.val.destination entry).1 = shape.repair (sourceSupport native) phase) :
    Resident shape phase wait where
  V := Compiler.V (frame.flow wait)
  root := frame.rooted wait component
  visit := frame.landing wait
  unique := Compiler.occurrence_eq_emitted (frame.flow wait)
  support_eq := congrArg frame.support (frame.landing_at_native wait)
  entry := frame.carriedEntry wait component entry
  repair_eq := (frame.carriedEntry_is_first_destination wait component entry).trans (heq_of_eq repair)
  authority := (SourceNativeLivingTemporalCausalEntryAuthorityAt.generatedFromInitialRow
    (frame.rooted wait component) entry (Compiler.generatedRow (frame.flow wait) (frame.initial wait) entry))
      |>.next (frame.first wait).next_eq
  structural := fun _ =>
    let current := (frame.landing wait).current
    let exactCurrent := frame.landing_at_native wait
    ⟨Compiler.successor (frame.flow wait) current,
      (Compiler.successor_support (frame.flow wait) current).trans
        (congrArg (fun c => frame.support (frame.next c)) exactCurrent),
      (Compiler.successor_destination (frame.flow wait) current).trans
        (read_heq (fun c => ((frame.flow wait).evolution c).destination) exactCurrent)⟩

end Frame

end

end SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Reparation.Transport
