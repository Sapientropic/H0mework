import H0mework.Versions.R3a90cba5.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Terminal.FixedPoint.OpenPeace.Network.Runtime.Decision.Pending
import H0mework.Versions.R3a90cba5.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Terminal.FixedPoint.OpenPeace.Network.Runtime.ReadHistory

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Terminal.FixedPoint.OpenPeace.Network.Runtime.Decision

open Capitalism.Universal.Source.Program
open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot RootInquiryCompletion
open NoFreeProbe
open private ordinaryOn from H0mework.Versions.R3a90cba5.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Terminal.FixedPoint.OpenPeace.Network.Runtime.Advance
open private publishOn publishedRead from H0mework.Versions.R3a90cba5.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Terminal.FixedPoint.OpenPeace.Network.Runtime.ReadHistory
open private Reader.mk from H0mework.Versions.R3a90cba5.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Terminal.FixedPoint.OpenPeace.Network.Runtime.Decision.Run

noncomputable section

variable {Party Good Port Technology Instrument Community : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Port] [DecidableEq Instrument] [DecidableEq Community]
  {seed cut : Conflict.Root.Cut Party Good Port Technology Instrument} {community : Party → Community}
  {origin reserveBase : RawCurrent Party Good Technology Instrument} {people : List Party} {quantum : ℚ}

local notation "St" => Runtime.State (seed := seed) (cut := cut) (community := community)
  origin people quantum (reserveBase := reserveBase)
local notation "Effects" => Set (Effect Party Good Port Technology Instrument)

private def materialLanding (before : St) (input : OpenPeace.Input Party Good Port Technology Instrument)
    (home : AnyAuthoritativeRootCurrent.{0}) (replies : Replies Party Good Port Technology Instrument) :=
  ordinaryOn home replies before input (Runtime.source home replies before input)

/-- The unresolved paid comparison has a dependent read on the material
successor. Its scope was generated by that receipt and remains addressable. -/
structure Deferred (home : AnyAuthoritativeRootCurrent.{0}) (replies : Replies Party Good Port Technology Instrument)
    (before : St) (input : OpenPeace.Input Party Good Port Technology Instrument) where
  private mk ::
  wire : Wire Party Good Port Technology Instrument
  paid : (Runtime.source home replies before input).source.paidWire = some wire
  live : St
  pending : ReadOn live.current.ledger.resident Effects
  exactScope : pending.read = Runtime.scope home replies before input
  physical : live.current.physical = (Runtime.source home replies before input).next.native.physical
  stack : HEq live.current.ledger.stack (Runtime.source home replies before input).next.native.ledger.stack
  language : live.base.language = before.base.language
  canonical : (⟨(materialLanding before input home replies).current.ledger.world,
    (Installation.Live.action (materialLanding before input home replies).current.ledger (Runtime.scope home replies before input) true).target.targetAnswerAndNext.nextCurrent⟩ :
      AnyAuthoritativeRootCurrent) = live.current.ledger.resident.erase

variable {home : AnyAuthoritativeRootCurrent.{0}} {replies : Replies Party Good Port Technology Instrument}
  {before : Runtime.State (seed := seed) (cut := cut) (community := community)
    origin people quantum (reserveBase := reserveBase)}
  {input : OpenPeace.Input Party Good Port Technology Instrument}

local notation "Posted" => Runtime.source home replies before input
local notation "Landing" => materialLanding before input home replies
local notation "Scope" => Runtime.scope home replies before input

private def defer (wire : Wire Party Good Port Technology Instrument)
    (paid : (Posted).source.paidWire = some wire) : Deferred home replies before input :=
  ⟨wire, paid, publishOn Landing Scope, publishedRead Landing Scope, rfl, rfl, HEq.rfl, rfl,
    Installation.Live.the_canonical_write_is_the_published_whole_state _ _ _⟩

/-- Only a selected paid request may acquire this pending read. -/
def Result.beginDeferred : Result home replies before input → Option (Deferred home replies before input)
  | .committed .. => none
  | .needsEvidence wire paid => some (defer wire paid)

variable (job : Deferred home replies before input)

def Deferred.reader (read : Reader before) : Reader job.live :=
  Reader.mk (fun point => Checked.map (by rw [job.language]) (read.probe point))
    (fun claim => Checked.map_complete _ (read.words claim))

variable (policy : Policy Party Good Port Technology Instrument)

def Deferred.run := Runtime.history home replies job.live policy

def Deferred.readAt (n : Nat) :
    ReadOn (job.run policy n).1.current.ledger.resident Effects :=
  (Runtime.historyReads home replies job.live policy n).carry job.pending

theorem Deferred.readAt_is_the_original_paid_scope (n : Nat) :
    (job.readAt policy n).read = Scope :=
  ((Runtime.historyReads home replies job.live policy n).keeps job.pending).trans job.exactScope

theorem Deferred.every_waiting_round_pays (n : Nat) :
    Runtime.LivingVisitAt home replies job.live policy n :=
  Runtime.history_is_living_and_peaceful home replies job.live policy n

theorem Deferred.waiting_clock_is_cofinal (start : Nat) (bound : ℚ) :
    ∃ n ≥ start, bound < (job.run policy n).1.current.physical.raw.clock :=
  Runtime.history_clock_is_cofinal home replies job.live policy start bound

end

end SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Terminal.FixedPoint.OpenPeace.Network.Runtime.Decision
