import H0mework.Versions.R3a90cba5.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Terminal.FixedPoint.AdaptivePeace.History
import H0mework.Versions.R3a90cba5.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Terminal.FixedPoint.AdaptivePeace.Privacy
import H0mework.Versions.R3a90cba5.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Terminal.FixedPoint.NoFreeProbe.Prepayment.Compiler

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Terminal.FixedPoint.AdaptivePeace

open Capitalism.Universal.Source.Program
open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot RootInquiryCompletion
open NoFreeProbe
open NoFreeProbe.Prepayment (PaymentOrders)
open Reparation.Actual (ReceiptAnswers Script)
open Clearance
open private State.start from H0mework.Versions.R3a90cba5.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Terminal.FixedPoint.AdaptivePeace.Dispatch

noncomputable section

variable {Party Good Port Technology Instrument Community : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Port]
  [DecidableEq Instrument] [DecidableEq Community]
  {seed : Conflict.Root.Cut Party Good Port Technology Instrument} {community : Party → Community}
  (loss : Reparation.Actual.Occurrence seed community) (answers : ReceiptAnswers seed)
  (reserve : Party → Good → ℚ) (body : RawEvent Party Good Port Technology Instrument)
  (offers : ProductionMenu Party Good Port Technology Instrument)
  (replies : Replies Party Good Port Technology Instrument)
  (tariff : Tariff Party Good Port Technology Instrument)
  (orders : PaymentOrders Party Good Port Technology Instrument)

structure AdaptiveOpening where
  private mk ::
  source : Prepayment.PrepaidOpening loss answers reserve body offers replies tariff orders

namespace AdaptiveOpening

variable {loss answers reserve body offers replies tariff orders}
  (opening : AdaptiveOpening loss answers reserve body offers replies tariff orders)

def initial :=
  State.start opening.source.current

def run (policy : Policy Party Good Port Technology Instrument) :=
  history opening.source.source.installation.read opening.source.home opening.source.installation.read
    replies opening.initial policy

theorem initial_has_no_preset_amendments : opening.initial.covered = ∅ :=
  rfl

theorem every_guard_in_the_installed_run_has_its_original_witness
    (policy : Policy Party Good Port Technology Instrument) (key : Party × Good) (n : Nat) :
    key ∈ (opening.run policy n).1.covered ↔
      ∃ i < n, key ∈ paidExposure opening.source.source.installation.read opening.source.home
        opening.source.installation.read replies (opening.run policy i).1
        (stepAt opening.source.source.installation.read opening.source.home opening.source.installation.read
          replies opening.initial policy i).source := by
  have actual := coverage_has_exactly_its_original_paid_witnesses opening.source.source.installation.read
    opening.source.home opening.source.installation.read replies opening.initial policy key n
  simpa only [run, opening.initial_has_no_preset_amendments, Finset.notMem_empty, false_or] using actual

theorem run_keeps_the_original_stack (policy : Policy Party Good Port Technology Instrument) (n : Nat) :
    HEq (opening.run policy n).1.native.ledger.stack opening.source.source.source.entry.current.ledger.stack :=
  (every_visit_preserves_the_original_stack opening.source.source.installation.read opening.source.home
    opening.source.installation.read replies opening.initial policy n).trans
    (heq_of_eq opening.source.installation_keeps_the_original_stack)

end AdaptiveOpening

inductive AdaptiveOutcome
  | jointFailure (diagnostic : Joint.JointOutcome loss answers reserve body offers)
  | noProductiveOpening (joint : Joint.PaidFrontier loss answers reserve (Joint.firstProduction loss body) offers)
      (excluded : ∀ word : Script Party Good Port Technology Instrument,
        ¬ Nonempty (OpeningAt loss answers reserve body offers word))
  | installed (original : Joint.ProductionWrite answers loss (Joint.openingDrain loss) body)
      (actualProduction : Joint.ProducesAtFirstWrite loss body)
      (opening : AdaptiveOpening loss answers reserve body offers replies tariff orders)

/-- At the original prepaid entrance, the first real amendment is
generated by the run itself when a paid exposure extends its guard. -/
def compileAdaptivePeace : AdaptiveOutcome loss answers reserve body offers replies tariff orders :=
  match Prepayment.compilePrepaidPeace loss answers reserve body offers replies tariff orders with
  | .jointFailure failure => .jointFailure failure
  | .noProductiveOpening frontier excluded => .noProductiveOpening frontier excluded
  | .installed original production prior => .installed original production ⟨prior⟩

theorem installs_at_the_same_prepaid_entrance
    {original : Joint.ProductionWrite answers loss (Joint.openingDrain loss) body}
    {production : Joint.ProducesAtFirstWrite loss body}
    {prior : Prepayment.PrepaidOpening loss answers reserve body offers replies tariff orders}
    (actual : Prepayment.compilePrepaidPeace loss answers reserve body offers replies tariff orders =
      .installed original production prior) :
    ∃ opening, compileAdaptivePeace loss answers reserve body offers replies tariff orders =
      .installed original production opening ∧ opening.source = prior := by
  exact ⟨⟨prior⟩, by simp only [compileAdaptivePeace, actual], rfl⟩

end

end SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Terminal.FixedPoint.AdaptivePeace
