import H0mework.Versions.R3a90cba5.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Terminal.FixedPoint.OpenPeace.Network.Revision

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Terminal.FixedPoint.OpenPeace.Network

open Capitalism.Universal.Source.Program
open Capitalism.Universal.Abolition.Accounting.Root
open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot RootInquiryCompletion
open ObstructionGeneratedMinimalCoface TypedSemanticWorldNetworkU8
open Installation.Live (Ledger Landed RowRestriction)

noncomputable section

private def retractEmbedding {A B : Type} (retract : ConstructiveRetract A B) : A ↪ B :=
  ⟨retract.forward, Function.LeftInverse.injective retract.backward_forward⟩

private def cofaceRestriction
    {N : WorldRelationNetwork} {V : ConstructiveRoot.Vocabulary}
    {oldWorld : SourceNativeAuthoritativeRootClosure N V}
    {oldVisit : SourceNativeTemporalVisitAt oldWorld.toLedgerRoot}
    {U7 : U7ProducerCalculus N} {oldTheory : TheoryState N}
    {support : N.Support} {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    (rooted : RootedActualExpressibilityFailureAt oldWorld oldVisit U7 failure)
    (coface : GeneratedMinimalCofaceAt rooted) :
    RowRestriction N coface.worldNetwork (oldWorld.toRoot.supportAt rooted.oldSuccessor.next)
      coface.cofaceSupport where
  rows := retractEmbedding coface.cofaceLedgerRetract
  responsibility := retractEmbedding coface.translation.responsibility
  claim := retractEmbedding coface.translation.claim
  responsibility_eq := fun _ => rfl
  claim_eq := fun _ => rfl
  budget_eq := fun _ => rfl

variable {Party Good Port Technology Instrument Community : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Port]
  [DecidableEq Instrument] [DecidableEq Community]
  {seed cut : Conflict.Root.Cut Party Good Port Technology Instrument} {community : Party → Community}

local notation "Grammar" => Language (RawEvent Party Good Port Technology Instrument)
  (Effect Party Good Port Technology Instrument)

variable (prior : Ledger seed community cut)
  (grammar : Language (RawEvent Party Good Port Technology Instrument)
    (Effect Party Good Port Technology Instrument))
  (observed : Set (Effect Party Good Port Technology Instrument)) (lane : LocalU7 prior.world)
  (novel : ¬ observed ⊆ grammar.covered)

local notation "N₀" => LocalU7.asWorld lane
local notation "Focus" => prior.resident.support
local notation "Bearer" => prior.resident.entry
local notation "Audit" => world N₀ Focus Bearer grammar observed
local notation "Translation" => translation N₀ Focus Bearer grammar observed
local notation "Rooted" => rootedFailure prior grammar observed lane novel
local notation "Coface" => root_obstruction_generates_minimal_coface Rooted
local notation "First" => auditFirst prior grammar observed lane
local notation "FiniteTarget" => targetFinite prior grammar observed lane novel
local notation "Arrived" => generatedNext prior grammar observed lane novel

private def auditRestriction :
    RowRestriction prior.world Audit prior.resident.support prior.resident.support where
  rows := retractEmbedding ((Translation).oldOpenLedger prior.resident.support)
  responsibility := retractEmbedding (Translation).responsibility
  claim := retractEmbedding (Translation).claim
  responsibility_eq := fun _ => rfl
  claim_eq := fun row => ((Translation).oldOpenClaim_commutes _ row).symm
  budget_eq := (Translation).oldOpenProgressBudget_commutes _

private def revisedRestriction :
    RowRestriction prior.world (Coface).worldNetwork prior.resident.support (Arrived).support :=
  (auditRestriction prior grammar observed lane).trans
    ((RowRestriction.atSameSupport (A := Audit)
      (audit_successor_support prior grammar observed lane novel).symm).trans
      ((cofaceRestriction Rooted Coface).trans
        (RowRestriction.atSameSupport (A := (Coface).worldNetwork)
          (landing_support Rooted FiniteTarget (First).openFibres
          (grammar.repair observed)).symm)))

/-- Carry the complete original ledger into the resident generated by the
literal U8 first write. The next physical write uses this resident. -/
def revisedLedger : Ledger seed community cut :=
  let first := revisedFirst Rooted FiniteTarget (First).openFibres
  let support := landing_support Rooted FiniteTarget (First).openFibres (grammar.repair observed)
  prior.move Arrived (revisedRestriction prior grammar observed lane novel)
    ⟨support.symm ▸ first.afterFinite, first.openFibres⟩

theorem revisedLedger_is_the_generated_first_write :
    let written := (revised prior grammar observed lane novel).generate
    (⟨written.NewN, written.newLivingRoot.generatedNextCurrentAt (.finite written.newRoot.toRoot.initialVisit)⟩ :
      AnyAuthoritativeRootCurrent) = (revisedLedger prior grammar observed lane novel).resident.erase :=
  the_first_write_is_the_generated_next prior grammar observed lane novel

/-- The revised grammar is read at the same landing used for the next
material schedule. -/
def revisedLanguageWrite : Landed seed community cut Grammar where
  state := revisedLedger prior grammar observed lane novel
  material := generatedLanguageFace prior grammar observed lane novel
  materialType := rfl

theorem revisedLanguageWrite_read :
    (revisedLanguageWrite prior grammar observed lane novel).read = grammar.repair observed :=
  eq_of_heq (the_generated_next_reads_the_exact_repair prior grammar observed lane novel)

end

end SaturationMonoid.ProcessGame.Society.Institutions.Conflict.Constitution.TerminalPeace.Universal.Terminal.FixedPoint.OpenPeace.Network
