import H0mework.Versions.R59df7e39.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.PublicFunction.Distributed.Reaction.Native.PrefixCoupling

/-! Complete financial prefix transport from the two actual programme histories.
The caller supplies primitive prior-event agreement; native births, issue origins
and full ordered account images are generated by replay. -/

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Society.PublicFunction.Distributed.Reaction.Native.Coupling.History

open Institutions.Capitalism.Universal.Root Institutions.Capitalism.Universal.Source
open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open Causality

variable {Party Good Port Technology Instrument : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Port]
  [DecidableEq Instrument]
  (code : Code Party Good Port Technology Instrument)
  (input other : ProgrammeSource.Input Party Good Port Technology Instrument)
  (law : other.law = input.law) (initial : other.initial = input.initial) (limit : Nat)
  (events : ∀ ordinal, ordinal < limit →
    ProgrammeSource.rawEvent other (ProgrammeHistory.visitAt input ordinal).current =
      ProgrammeSource.rawEvent input (ProgrammeHistory.visitAt input ordinal).current)

include law initial events

omit [DecidableEq Port] in
theorem occurrences (ordinal : Nat) (bounded : ordinal < limit) :
    (ProgrammeHistory.visitAt other ordinal).current = (ProgrammeHistory.visitAt input ordinal).current ∧
      ProgrammeSource.rawEvent other (ProgrammeHistory.visitAt other ordinal).current =
        ProgrammeSource.rawEvent input (ProgrammeHistory.visitAt input ordinal).current := by
  have prior := Machine.actual_prefix_from_events input other law initial limit events ordinal (by omega)
  exact ⟨prior, (congrArg (ProgrammeSource.rawEvent other) prior).trans (events ordinal bounded)⟩

omit [DecidableEq Port] in
theorem raw_current (ordinal : Nat) (bounded : ordinal < limit) :
    ProgrammeSource.rawCurrent other (ProgrammeHistory.visitAt other ordinal).current =
      ProgrammeSource.rawCurrent input (ProgrammeHistory.visitAt input ordinal).current := by
  rw [(occurrences input other law initial limit events ordinal bounded).1]
  cases (ProgrammeHistory.visitAt input ordinal).current <;> simp only [ProgrammeSource.rawCurrent, initial]

omit [DecidableEq Port] in
theorem occurrence_image (ordinal : Nat) (bounded : ordinal < limit) :
    Identity.occurrenceImage code other (ProgrammeHistory.visitAt other ordinal).current =
      Identity.occurrenceImage code input (ProgrammeHistory.visitAt input ordinal).current := by
  have same := occurrences input other law initial limit events ordinal bounded
  exact congrArg₂ Identity.OccurrenceImage.mk (congrArg (Identity.visitImage code) same.1) same.2

omit [DecidableEq Port] in
theorem trace_items (ordinal : Nat) (bounded : ordinal < limit) :
    ProgrammeFace.Registered.traceItems other (ProgrammeHistory.visitAt other ordinal).current =
      ProgrammeFace.Registered.traceItems input (ProgrammeHistory.visitAt input ordinal).current := by
  change other.law.rawItems _ _ = input.law.rawItems _ _
  rw [law]
  exact congrArg₂ input.law.rawItems (raw_current input other law initial limit events ordinal bounded)
    (occurrences input other law initial limit events ordinal bounded).2

omit [DecidableEq Port] in
theorem participation (ordinal : Nat) (bounded : ordinal < limit) (party : Party) :
    ProgrammeFace.ActualBirth.presentAt other (ProgrammeHistory.visitAt other ordinal) party =
      ProgrammeFace.ActualBirth.presentAt input (ProgrammeHistory.visitAt input ordinal) party := by
  change (party ∈ ProgrammeFace.parties other.law
      (ProgrammeSource.rawCurrent other (ProgrammeHistory.visitAt other ordinal).current,
        ProgrammeSource.rawEvent other (ProgrammeHistory.visitAt other ordinal).current)) =
    (party ∈ ProgrammeFace.parties input.law
      (ProgrammeSource.rawCurrent input (ProgrammeHistory.visitAt input ordinal).current,
        ProgrammeSource.rawEvent input (ProgrammeHistory.visitAt input ordinal).current))
  rw [law]
  exact congrArg (fun event => party ∈ ProgrammeFace.parties input.law event)
    (congrArg₂ Prod.mk (raw_current input other law initial limit events ordinal bounded)
      (occurrences input other law initial limit events ordinal bounded).2)

omit [DecidableEq Port] in
theorem birth_here (ordinal : Nat) (bounded : ordinal < limit) (party : Party) :
    birthHereImage code other ordinal party = birthHereImage code input ordinal party := by
  unfold birthHereImage
  simp only [participation input other law initial limit events ordinal bounded party,
    occurrence_image code input other law initial limit events ordinal bounded]

omit [DecidableEq Port] in
theorem first_birth (ordinal : Nat) (bounded : ordinal < limit) (party : Party) :
    birthHistoryImage code other ordinal party = birthHistoryImage code input ordinal party := by
  induction ordinal with
  | zero =>
    rw [birthHistoryImage_zero, birthHistoryImage_zero]
    exact birth_here code input other law initial limit events 0 bounded party
  | succ ordinal ih =>
    rw [birthHistoryImage_succ, birthHistoryImage_succ, ih (by omega),
      birth_here code input other law initial limit events (ordinal + 1) bounded party]

omit [DecidableEq Port] law initial events in
private theorem list_get_congr {α : Type} (first second : List α) (same : second = first)
    (old : Fin first.length) (new : Fin second.length) (index : new.val = old.val) : second.get new = first.get old := by
  subst second
  have sameIndex : new = old := Fin.ext index
  cases sameIndex
  rfl

def partner (ordinal : Nat) (bounded : ordinal < limit)
    (index : Fin (ProgrammeFace.Registered.traceItems input (ProgrammeHistory.visitAt input ordinal).current).length) :
    Fin (ProgrammeFace.Registered.traceItems other (ProgrammeHistory.visitAt other ordinal).current).length :=
  ⟨index.val, by rw [trace_items input other law initial limit events ordinal bounded]; exact index.isLt⟩

omit [DecidableEq Port] in
theorem origin_image (ordinal : Nat) (bounded : ordinal < limit)
    (index : Fin (ProgrammeFace.Registered.traceItems input (ProgrammeHistory.visitAt input ordinal).current).length) :
    Identity.originImage code other (Financial.traceOriginAt other (ProgrammeHistory.visitAt other ordinal)
      (partner input other law initial limit events ordinal bounded index)) =
      Identity.originImage code input (Financial.traceOriginAt input (ProgrammeHistory.visitAt input ordinal) index) := by
  simp only [Identity.originImage, Financial.traceOriginAt, ProgrammeFace.Registered.traceRow_is_original_interpreter]
  change Identity.OriginImage.mk _ 0 (some index.val) = Identity.OriginImage.mk _ 0 (some index.val)
  rw [occurrence_image code input other law initial limit events ordinal bounded]

omit [DecidableEq Port] in
theorem decoded (ordinal : Nat) (bounded : ordinal < limit)
    (index : Fin (ProgrammeFace.Registered.traceItems input (ProgrammeHistory.visitAt input ordinal).current).length) :
    (Financial.traceOriginAt other (ProgrammeHistory.visitAt other ordinal)
      (partner input other law initial limit events ordinal bounded index)).instruction? other =
      (Financial.traceOriginAt input (ProgrammeHistory.visitAt input ordinal) index).instruction? input := by
  exact (Financial.traceOriginAt_instruction other _ (partner input other law initial limit events ordinal bounded index)).trans
    ((congrArg some (list_get_congr _ _ (trace_items input other law initial limit events ordinal bounded)
      index (partner input other law initial limit events ordinal bounded index) rfl)).trans
      (Financial.traceOriginAt_instruction input _ index).symm)

omit [DecidableEq Port] in
theorem issued (ordinal : Nat) (bounded : ordinal < limit)
    (index : Fin (ProgrammeFace.Registered.traceItems input (ProgrammeHistory.visitAt input ordinal).current).length) :
    issuedImage code other (Financial.traceOriginAt other (ProgrammeHistory.visitAt other ordinal)
      (partner input other law initial limit events ordinal bounded index)) =
      issuedImage code input (Financial.traceOriginAt input (ProgrammeHistory.visitAt input ordinal) index) := by
  exact (issued_image_is_canonical code other ordinal _ rfl).trans
    ((canonical_issue_image_congr code input other law _ _ _ _ _ _
      (origin_image code input other law initial limit events ordinal bounded index)
      (decoded input other law initial limit events ordinal bounded index)
      (funext (first_birth code input other law initial limit events ordinal bounded))).trans
      (issued_image_is_canonical code input ordinal _ rfl).symm)

omit [DecidableEq Port] in
theorem trace_pairs (ordinal : Nat) (bounded : ordinal < limit) :
    List.Forall₂ (State.OriginPair code input other)
      (Financial.traceInventoryAt input (ProgrammeHistory.visitAt input ordinal))
      (Financial.traceInventoryAt other (ProgrammeHistory.visitAt other ordinal)) := by
  apply List.forall₂_of_length_eq_of_get
  · simp only [Financial.traceInventoryAt, List.length_ofFn]
    exact (congrArg List.length (trace_items input other law initial limit events ordinal bounded)).symm
  · intro index oldBound newBound
    simp only [Financial.traceInventoryAt, List.get_eq_getElem, List.getElem_ofFn]
    let oldIndex : Fin (ProgrammeFace.Registered.traceItems input (ProgrammeHistory.visitAt input ordinal).current).length :=
      ⟨index, by simpa only [Financial.traceInventoryAt, List.length_ofFn] using oldBound⟩
    exact ⟨origin_image code input other law initial limit events ordinal bounded oldIndex,
      decoded input other law initial limit events ordinal bounded oldIndex,
      issued code input other law initial limit events ordinal bounded oldIndex⟩

/-- Native account transport is generated from primitive prior-event agreement. -/
theorem complete_accounts (oldEmit newEmit : Program.RawCurrent Party Good Technology Instrument →
    Program.RawEvent Party Good Port Technology Instrument)
    (oldGenerated : input.emission? = some oldEmit) (newGenerated : other.emission? = some newEmit)
    (ordinal : Nat) (bounded : ordinal ≤ limit) :
    Match code input other (Financial.accountAt input ordinal) (Financial.accountAt other ordinal) := by
  exact State.account_at_natural code input other law initial oldEmit newEmit oldGenerated newGenerated limit
    (trace_pairs code input other law initial limit events) ordinal bounded

end SaturationMonoid.ProcessGame.Society.PublicFunction.Distributed.Reaction.Native.Coupling.History
