import Mathlib.Analysis.ODE.ExistUnique
import Mathlib.Analysis.Matrix.Normed
import Mathlib.Analysis.Complex.Order
import Mathlib.LinearAlgebra.Matrix.PosDef

/-! SOURCE candidate for the actual284 coefficient cells.

The input is a coefficient source and its directly generated norm bound.  A
survival curve is generated by Picard--Lindelof, never supplied as an input.
The Python primitive source subdivides its actual cell to satisfy `short`.
This file does not assert the Dyson sum, Fock limit or physical-law identity.
-/

set_option autoImplicit false

noncomputable section

open Set Metric
open scoped NNReal Matrix ComplexOrder Matrix.Norms.Operator

namespace RetardedSourceSurvival284

universe u

variable (A : Type u) [NormedRing A] [NormedAlgebra ℝ A]
  [CompleteSpace A] [NormOneClass A]

structure LocalSurvivalSource where
  left : ℝ
  right : ℝ
  ordered : left ≤ right
  generator : ℝ → A
  continuous : ContinuousOn generator (Icc left right)
  bound : ℝ≥0
  norm_bound : ∀ t ∈ Icc left right, ‖generator t‖ ≤ bound
  short : (2 * (bound : ℝ)) * (right - left) ≤ 1

namespace LocalSurvivalSource

variable {A} (source : LocalSurvivalSource A)

def start : Icc source.left source.right := ⟨source.left,le_rfl,source.ordered⟩

omit [NormedAlgebra ℝ A] [CompleteSpace A] in
theorem generated_picard :
    IsPicardLindelof (fun t U => source.generator t * U) source.start (1 : A)
      1 0 (2 * source.bound) source.bound where
  lipschitzOnWith t ht := by
    apply LipschitzWith.lipschitzOnWith
    apply LipschitzWith.of_dist_le_mul
    intro U V
    calc
      dist (source.generator t * U) (source.generator t * V)
          = ‖source.generator t * (U - V)‖ := by rw [dist_eq_norm, mul_sub]
      _ ≤ ‖source.generator t‖ * ‖U - V‖ := norm_mul_le _ _
      _ ≤ (source.bound : ℝ) * dist U V := by
        rw [dist_eq_norm]
        exact mul_le_mul_of_nonneg_right (source.norm_bound t ht) (norm_nonneg _)
  continuousOn U _ := source.continuous.mul continuousOn_const
  norm_le t ht U hU := by
    have bounded_U : ‖U‖ ≤ 2 := by
      have h := norm_le_of_mem_closedBall hU
      simpa only [norm_one, NNReal.coe_one, one_add_one_eq_two] using h
    calc
      ‖source.generator t * U‖ ≤ ‖source.generator t‖ * ‖U‖ := norm_mul_le _ _
      _ ≤ (source.bound : ℝ) * 2 :=
        mul_le_mul (source.norm_bound t ht) bounded_U (norm_nonneg _) source.bound.coe_nonneg
      _ = ((2 * source.bound : ℝ≥0) : ℝ) := by simp; ring
  mul_max_le := by
    simpa [start, max_eq_left (sub_nonneg.mpr source.ordered)] using source.short

theorem generate_survival :
    ∃ U : ℝ → A, U source.left = 1 ∧
      ∀ t ∈ Icc source.left source.right,
        HasDerivWithinAt U (source.generator t * U t) (Icc source.left source.right) t := by
  simpa [start] using source.generated_picard.exists_eq_forall_mem_Icc_hasDerivWithinAt₀

end LocalSurvivalSource

section CoherentBorn

variable {n : Type*} [Fintype n]

/-- `branches` are added before the Born square; individual branches need not
be positive, and destructive interference remains present. -/
def coherentAmplitude {ι : Type*} [Fintype ι] (branches : ι → Matrix n n ℂ) :=
  ∑ i, branches i

def coherentOutput {ι : Type*} [Fintype ι]
    (branches : ι → Matrix n n ℂ) (input : Matrix n n ℂ) : Matrix n n ℂ :=
  coherentAmplitude branches * input * (coherentAmplitude branches)ᴴ

theorem coherentOutput_positive {ι : Type*} [Fintype ι]
    (branches : ι → Matrix n n ℂ) {input : Matrix n n ℂ}
    (positive : input.PosSemidef) : (coherentOutput branches input).PosSemidef :=
  positive.mul_mul_conjTranspose_same (coherentAmplitude branches)

theorem coherentOutput_trace_nonnegative {ι : Type*} [Fintype ι]
    (branches : ι → Matrix n n ℂ) {input : Matrix n n ℂ}
    (positive : input.PosSemidef) : 0 ≤ (coherentOutput branches input).trace.re :=
  (Complex.nonneg_iff.mp (coherentOutput_positive branches positive).trace_nonneg).1

/-- A local source emits a survival trajectory and a positive Born action on
every positive input; no completed density or normalizer is a premise. -/
theorem generated_survival_positive [DecidableEq n] [Nonempty n]
    (source : LocalSurvivalSource (Matrix n n ℂ)) :
    ∃ U : ℝ → Matrix n n ℂ,
      U source.left = 1 ∧
      (∀ t ∈ Icc source.left source.right,
        HasDerivWithinAt U (source.generator t * U t) (Icc source.left source.right) t) ∧
      ∀ (input : Matrix n n ℂ), input.PosSemidef →
        ∀ t : ℝ, (U t * input * (U t)ᴴ).PosSemidef := by
  obtain ⟨U,initial,equation⟩ := source.generate_survival
  exact ⟨U,initial,equation,fun input positive t => positive.mul_mul_conjTranspose_same (U t)⟩

end CoherentBorn

end RetardedSourceSurvival284
