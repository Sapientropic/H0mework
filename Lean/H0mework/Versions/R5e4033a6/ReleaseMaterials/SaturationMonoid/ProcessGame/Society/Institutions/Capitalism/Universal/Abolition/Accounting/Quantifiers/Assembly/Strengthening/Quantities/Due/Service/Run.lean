import H0mework.Versions.R3b3d24a4.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Accounting.Quantifiers.Assembly.Strengthening.Quantities.Due.Service.Enumerate
import H0mework.Versions.R3b3d24a4.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Accounting.Quantifiers.Assembly.Strengthening.Quantities.Due.Service.Settlement
import H0mework.Versions.R3b3d24a4.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Capacity.QuantityFlow.Solver

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Accounting.Quantifiers.Assembly.Strengthening.Quantities.Due.Service

open Source.Program Abolition.Root Abolition.Root.Registered PublicFunction
open _root_.SaturationMonoid.ProcessGame.Society.Capacity.QuantityFlow

noncomputable section

variable {Party Good Port Technology Instrument : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Port] [DecidableEq Instrument]
  {TaskId : Type*} [DecidableEq TaskId]

local notation "C" => Evolving.Epoch.Current (Party := Party) (Good := Good) (Port := Port)
  (Technology := Technology) (Instrument := Instrument)
local notation "Script" => List (Option (Compile.RawInput Party Good Port Technology Instrument))
local notation "Task" => PublicTaskSpec Party Good

/-- All solver coordinates are generated by the original tasks and this
one native execution, including any amount reserved for whole uses. -/
def allocate (source : C) (script : Script) (ids : Finset TaskId) (task : TaskId → Task)
    (reserved : Finset (Ordinal source script)) (ordered : List TaskId)
    (same : ordered.toFinset = ids) : (network source script ids task reserved).Certificate :=
  (network source script ids task reserved).solveListed
    (needList ids task ordered same) (supplyList source script ids task ordered same)
    (needList_covers ids task ordered same) (supplyList_covers source script ids task ordered same)

def originalServiceDecision (source : C) (script : Script) (ids : Finset TaskId) (task : TaskId → Task)
    (reserved : Finset (Ordinal source script)) (ordered : List TaskId)
    (same : ordered.toFinset = ids) : Outcome (allocate source script ids task reserved ordered same) :=
  finalize (allocate source script ids task reserved ordered same)

end

end SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Accounting.Quantifiers.Assembly.Strengthening.Quantities.Due.Service
