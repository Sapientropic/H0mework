local instance : NormedAlgebra ℚ PreparationVacuumFieldPerturbation.Op := NormedAlgebra.restrictScalars ℚ ℂ _
local instance : NormedAlgebra ℝ PreparationVacuumFieldPerturbation.Op := NormedAlgebra.restrictScalars ℝ ℂ _

-- These bounds are generated by the actual matter coefficient jet.
def incrementSlope (g : Field289) (psi : Localizer) (p : PhysicalMomentum) : ℝ :=
  ‖forceGauss g p psi‖+secondBound g psi p

theorem incrementSlope_nonneg (g : Field289) (psi : Localizer) (p : PhysicalMomentum) :
    0 ≤ incrementSlope g psi p := add_nonneg (norm_nonneg _) (secondBound_nonneg g psi p)

theorem matterIncrement_size (g : Field289) (psi : Localizer) (p : PhysicalMomentum) (r : ℝ)
    (small : |r| ≤ fieldRadius g psi) (unit : |r| ≤ 1) :
    ‖matterIncrement g psi p r‖ ≤ |r| *incrementSlope g psi p := by
  have identity : matterIncrement g psi p r=
      (matterIncrement g psi p r-r • forceGauss g p psi)+r • forceGauss g p psi := by abel
  have quadratic : |r|^2 ≤ |r| := by nlinarith [abs_nonneg r]
  rw [identity]
  apply (norm_add_le _ _).trans
  rw [norm_smul,Real.norm_eq_abs]
  have h:=matterIncrement_remainder g psi p r small
  rw [Real.norm_eq_abs] at h
  calc
    _ ≤ secondBound g psi p*|r|^2+|r| *‖forceGauss g p psi‖ := add_le_add h le_rfl
    _ ≤ secondBound g psi p*|r|+|r| *‖forceGauss g p psi‖ :=
      add_le_add (mul_le_mul_of_nonneg_left quadratic (secondBound_nonneg g psi p)) le_rfl
    _ = _ := by unfold incrementSlope;ring

-- One source-generated neighborhood pays both real nonlinear and affine propagators.
def nonlinearRadius (g : Field289) (psi : Localizer) (p : PhysicalMomentum) (cut : ℕ) (damping : ℝ) : ℝ :=
  min (fieldRadius g psi) (min 1 ((damping/16)/(sourceEnvelope cut (damping/16)*(1+incrementSlope g psi p))))

theorem nonlinearRadius_pos (g : Field289) (psi : Localizer) (p : PhysicalMomentum) (cut : ℕ) (damping : ℝ)
    (positive : 0 < damping) : 0 < nonlinearRadius g psi p cut damping := by
  unfold nonlinearRadius
  exact lt_min (fieldRadius_pos g psi) (lt_min zero_lt_one
    (div_pos (by positivity) (mul_pos
      (lt_of_lt_of_le zero_lt_one (sourceEnvelope_one_le cut (damping/16) (by positivity)))
      (by linarith [incrementSlope_nonneg g psi p]))))

theorem nonlinearRadius_field (g : Field289) (psi : Localizer) (p : PhysicalMomentum) (cut : ℕ) (damping r : ℝ)
    (small : |r| ≤ nonlinearRadius g psi p cut damping) : |r| ≤ fieldRadius g psi :=
  small.trans (min_le_left _ _)

theorem nonlinearRadius_unit (g : Field289) (psi : Localizer) (p : PhysicalMomentum) (cut : ℕ) (damping r : ℝ)
    (small : |r| ≤ nonlinearRadius g psi p cut damping) : |r| ≤ 1 :=
  small.trans ((min_le_right _ _).trans (min_le_left _ _))

theorem nonlinearRadius_controls (g : Field289) (psi : Localizer) (p : PhysicalMomentum) (cut : ℕ) (damping r : ℝ)
    (positive : 0 < damping) (small : |r| ≤ nonlinearRadius g psi p cut damping) :
    sourceEnvelope cut (damping/16)*‖matterIncrement g psi p r‖ ≤ damping/16 := by
  have Mpos : 0 < sourceEnvelope cut (damping/16) :=
    lt_of_lt_of_le zero_lt_one (sourceEnvelope_one_le cut _ (by positivity))
  have denominator : 0 < sourceEnvelope cut (damping/16)*(1+incrementSlope g psi p) :=
    mul_pos Mpos (by linarith [incrementSlope_nonneg g psi p])
  have radius : |r| ≤ (damping/16)/(sourceEnvelope cut (damping/16)*(1+incrementSlope g psi p)) :=
    small.trans ((min_le_right _ _).trans (min_le_right _ _))
  have hr:=(le_div_iff₀ denominator).mp radius
  calc
    _ ≤ sourceEnvelope cut (damping/16)*(|r| *incrementSlope g psi p) :=
      mul_le_mul_of_nonneg_left (matterIncrement_size g psi p r
        (nonlinearRadius_field g psi p cut damping r small) (nonlinearRadius_unit g psi p cut damping r small)) Mpos.le
    _ ≤ |r| *(sourceEnvelope cut (damping/16)*(1+incrementSlope g psi p)) := by
      nlinarith [mul_nonneg (abs_nonneg r) Mpos.le]
    _ ≤ damping/16 := hr

theorem nonlinearRadius_affine (g : Field289) (psi : Localizer) (p : PhysicalMomentum) (cut : ℕ) (damping r : ℝ)
    (positive : 0 < damping) (small : |r| ≤ nonlinearRadius g psi p cut damping) :
    |r| ≤ observableRadius p cut g psi damping := by
  unfold observableRadius
  apply le_min (nonlinearRadius_unit g psi p cut damping r small)
  have Mpos : 0 < sourceEnvelope cut (damping/16) :=
    lt_of_lt_of_le zero_lt_one (sourceEnvelope_one_le cut _ (by positivity))
  have db : 0 < sourceEnvelope cut (damping/16)*(1+‖forceGauss g p psi‖) := mul_pos Mpos (by positivity)
  have ds : 0 < sourceEnvelope cut (damping/16)*(1+incrementSlope g psi p) :=
    mul_pos Mpos (by linarith [incrementSlope_nonneg g psi p])
  have radius : |r| ≤ (damping/16)/(sourceEnvelope cut (damping/16)*(1+incrementSlope g psi p)) :=
    small.trans ((min_le_right _ _).trans (min_le_right _ _))
  unfold actualParameterRadius parameterRadius
  rw [show damping/2/8=damping/16 by ring]
  apply (le_div_iff₀ db).mpr
  have h:=(le_div_iff₀ ds).mp radius
  have slope : ‖forceGauss g p psi‖ ≤ incrementSlope g psi p := by
    unfold incrementSlope;linarith [secondBound_nonneg g psi p]
  exact (mul_le_mul_of_nonneg_left
    (mul_le_mul_of_nonneg_left (show 1+‖forceGauss g p psi‖≤1+incrementSlope g psi p from by linarith) Mpos.le) (abs_nonneg r)).trans h

theorem nonlinear_time_envelope (g : Field289) (psi : Localizer) (p : PhysicalMomentum) (cut : ℕ)
    (F : Index) (damping r t : ℝ) (positive : 0 < damping)
    (small : |r| ≤ nonlinearRadius g psi p cut damping) :
    ‖time (compression p F+cutoff cut+matterIncrement g psi p r) t‖ ≤
      sourceEnvelope cut (damping/16)*Real.exp ((damping/8)*|t|) := by
  have Mnonneg : 0 ≤ sourceEnvelope cut (damping/16) :=
    zero_le_one.trans (sourceEnvelope_one_le cut _ (by positivity))
  have bound:=perturbed_time_envelope (compression p F+cutoff cut) (matterIncrement g psi p r) 1
    (damping/16) (sourceEnvelope cut (damping/16)) t Mnonneg
    (original_exponential_envelope p F cut (damping/16) (by positivity))
  simp only [one_smul,abs_one,one_mul] at bound
  apply bound.trans
  apply mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr _) Mnonneg
  apply mul_le_mul_of_nonneg_right _ (abs_nonneg t)
  linarith [nonlinearRadius_controls g psi p cut damping r positive small]

section Difference
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
local instance : NormedAlgebra ℚ (E →L[ℂ] E) := NormedAlgebra.restrictScalars ℚ ℂ _
local instance : NormedAlgebra ℝ (E →L[ℂ] E) := NormedAlgebra.restrictScalars ℝ ℂ _

theorem two_generator_window (C D : E →L[ℂ] E) (t P : ℝ) (hP : 0 ≤ P)
    (left : ∀ s,|s| ≤ |t| → ‖time C s‖ ≤ P)
    (right : ∀ s,|s| ≤ |t| → ‖time D s‖ ≤ P) :
    ‖time D t-time C t‖ ≤ |t| *P^2*‖D-C‖ := by
  have h:=parameter_difference_window C (D-C) 1 |t| P P t hP hP le_rfl left
    (by simpa only [one_smul,add_sub_cancel] using right)
  simpa only [one_smul,add_sub_cancel,abs_one,one_mul] using h.trans_eq (by ring)
end Difference

theorem nonlinear_affine_time_window (g : Field289) (psi : Localizer) (p : PhysicalMomentum) (cut : ℕ)
    (F : Index) (damping r t : ℝ) (positive : 0 < damping)
    (small : |r| ≤ nonlinearRadius g psi p cut damping) :
    ‖time (compression p F+cutoff cut+matterIncrement g psi p r) t-
      time (compression p F+cutoff cut+r • forceGauss g p psi) t‖ ≤
      (secondBound g psi p)*‖r‖^2*|t| *
        (sourceEnvelope cut (damping/16)*Real.exp ((damping/8)*|t|))^2 := by
  let P:=sourceEnvelope cut (damping/16)*Real.exp ((damping/8)*|t|)
  have Mnonneg : 0 ≤ sourceEnvelope cut (damping/16) :=
    zero_le_one.trans (sourceEnvelope_one_le cut _ (by positivity))
  have Pnonneg : 0 ≤ P := mul_nonneg Mnonneg (Real.exp_pos _).le
  have mono (s : ℝ) (within : |s|≤|t|) :
      sourceEnvelope cut (damping/16)*Real.exp ((damping/8)*|s|) ≤ P :=
    mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left within (by positivity))) Mnonneg
  have left (s : ℝ) (within : |s|≤|t|) :
      ‖time (compression p F+cutoff cut+r • forceGauss g p psi) s‖≤P := by
    have hr:=nonlinearRadius_affine g psi p cut damping r positive small
    have hs : |r|≤parameterRadius cut (damping/16) (forceGauss g p psi) := by
      simpa only [actualParameterRadius,show damping/2/8=damping/16 by ring] using (le_min_iff.mp hr).2
    have h:=original_perturbed_envelope p F cut (forceGauss g p psi) (damping/16) r s (by positivity) hs
    have rate : 2*(damping/16)=damping/8 := by ring
    rw [rate] at h
    exact h.trans (mono s within)
  have right (s : ℝ) (within : |s|≤|t|) :
      ‖time (compression p F+cutoff cut+matterIncrement g psi p r) s‖≤P :=
    (nonlinear_time_envelope g psi p cut F damping r s positive small).trans (mono s within)
  have h:=two_generator_window (compression p F+cutoff cut+r • forceGauss g p psi)
    (compression p F+cutoff cut+matterIncrement g psi p r) t P Pnonneg left right
  have difference : compression p F+cutoff cut+matterIncrement g psi p r-
      (compression p F+cutoff cut+r • forceGauss g p psi)=matterIncrement g psi p r-r • forceGauss g p psi := by abel
  rw [difference] at h
  exact h.trans ((mul_le_mul_of_nonneg_left
    (matterIncrement_remainder g psi p r (nonlinearRadius_field g psi p cut damping r small))
    (mul_nonneg (abs_nonneg t) (sq_nonneg P))).trans_eq (by dsimp [P];ring))

end LowEnergy.PreparationVacuumNonlinearLaplace
