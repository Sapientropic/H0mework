-- Same original N0 closure, original half-density raise and source CAR creation.
def sourcePrepared : sourceLocalSpace →L[ℂ] H :=
  prepared.comp (zeroLocalizedProfile actualNativeLocalizer)

def preparedCore : ScalarTest →ₗ[ℂ] QuantumTest :=
  seedSection.comp (CanonicalPreparationCore.numberRaiseCore.comp sourceVacuumInputCore)

theorem sourcePrepared_norm (x : sourceLocalSpace) : ‖sourcePrepared x‖=‖x‖ :=
  zeroLocalized_physical_norm actualNativeLocalizer x

theorem sourcePrepared_core (f : ScalarTest) : sourcePrepared (localCore f)=embed (preparedCore f) := by
  change prepared (zeroLocalizedProfile actualNativeLocalizer (localCore f))=_
  rw [zeroLocalized_sourceCreated]
  change sourceCreated (GaussHalfDensity.halfDensityEquiv 0
    (scalarLp 0 (sourceVacuumInputCore f)))=_
  exact CanonicalPreparationCore.sourceCreated_core (sourceVacuumInputCore f)

theorem preparedCore_norm (f : ScalarTest) : ‖embed (preparedCore f)‖=‖localCore f‖ := by
  rw [←sourcePrepared_core,sourcePrepared_norm]

theorem preparedCore_support (f : ScalarTest) :
    tsupport (preparedCore f)⊆fullCoordinates ⁻¹' sourceClosedBox := by
  have localized : tsupport (preparedCore f)⊆tsupport actualNativeLocalizer := by
    apply closure_minimal _ isClosed_closure
    intro z hz
    by_contra outside
    apply hz
    change (CanonicalPreparationCore.numberRaise z*((actualNativeLocalizer z:ℂ)*f z)) •
      CanonicalCompletedSector.seed=0
    rw [image_eq_zero_of_notMem_tsupport outside]
    simp
  exact localized.trans (show tsupport actualNativeLocalizer⊆fullCoordinates ⁻¹' sourceClosedBox from nativePsi_tsupport)

def preparedYCore : ScalarTest →ₗ[ℂ] H :=
  embed.comp (originalAction.comp preparedCore)

theorem preparedYCore_bound (f : ScalarTest) :
    ‖preparedYCore f‖ ≤ sourceRadiusBound*bound*‖localCore f‖ := by
  have generated:=original_yukawa_source_core_bound (preparedCore f) (preparedCore_support f)
  simpa only [preparedYCore,LinearMap.comp_apply,preparedCore_norm,sourceRadiusBound] using generated

def preparedY : sourceLocalSpace →L[ℂ] H := preparedYCore.extendOfNorm localCore

theorem preparedY_core (f : ScalarTest) : preparedY (localCore f)=embed (originalAction (preparedCore f)) :=
  LinearMap.extendOfNorm_eq localCore_dense ⟨sourceRadiusBound*bound,preparedYCore_bound⟩ f

theorem preparedY_bound (x : sourceLocalSpace) : ‖preparedY x‖ ≤ sourceRadiusBound*bound*‖x‖ :=
  LinearMap.norm_extendOfNorm_apply_le localCore_dense _ preparedYCore_bound x

-- Graph membership is generated by the actual original core and closed graph.
theorem preparedY_graph (x : sourceLocalSpace) : (sourcePrepared x,preparedY x)∈GaussRadialDomain.graph := by
  change GaussYukawaOperator.bounded (sourcePrepared x)=inverseRadius (preparedY x)
  refine localCore_dense.induction_on x (isClosed_eq (by fun_prop) (by fun_prop)) ?_
  intro f
  rw [sourcePrepared_core,preparedY_core]
  exact original_graph (preparedCore f)

theorem prepared_closedY (x : sourceLocalSpace) :
    ∃ h : sourcePrepared x∈closedY.domain,closedY ⟨sourcePrepared x,h⟩=preparedY x := by
  have generated : (sourcePrepared x,preparedY x)∈closedY.graph := by
    rw [closedY_graph]
    exact preparedY_graph x
  obtain ⟨u,hu,hvalue⟩:=closedY.mem_graph_iff.mp generated
  change (u:H)=sourcePrepared x at hu
  change closedY u=preparedY x at hvalue
  refine ⟨hu ▸ u.property,?_⟩
  exact (congrArg (fun v:closedY.domain=>closedY v) (Subtype.ext hu.symm)).trans hvalue

theorem prepared_cutoff_bound (n : ℕ) (x : sourceLocalSpace) :
    ‖preparedY x-cutoff n (sourcePrepared x)‖ ≤
      sourceCutRate^(n+1)*sourceRadiusBound*bound*‖x‖ := by
  refine localCore_dense.induction_on x (isClosed_le (by fun_prop) (by fun_prop)) ?_
  intro f
  rw [preparedY_core,sourcePrepared_core,←preparedCore_norm]
  exact original_cutoff_source_core_bound n (preparedCore f) (preparedCore_support f)


theorem prepared_cutoff_tendsto (x : sourceLocalSpace) :
    Tendsto (fun n : ℕ=>cutoff n (sourcePrepared x)) atTop (𝓝 (preparedY x)) := by
  apply tendsto_iff_norm_sub_tendsto_zero.mpr
  have limiting : Tendsto (fun n : ℕ=>sourceCutRate^(n+1)*sourceRadiusBound*bound*‖x‖) atTop (𝓝 0) := by
    have geometric:=tendsto_pow_atTop_nhds_zero_of_lt_one sourceCutRate_nonnegative sourceCutRate_lt_one
    simpa only [pow_succ,zero_mul] using
      (((geometric.mul_const sourceCutRate).mul_const sourceRadiusBound).mul_const bound).mul_const ‖x‖
  have nonnegative (n : ℕ) : 0 ≤ ‖cutoff n (sourcePrepared x)-preparedY x‖ := norm_nonneg _
  have upper (n : ℕ) : ‖cutoff n (sourcePrepared x)-preparedY x‖ ≤
      sourceCutRate^(n+1)*sourceRadiusBound*bound*‖x‖ := by
    rw [norm_sub_rev]
    exact prepared_cutoff_bound n x
  exact squeeze_zero nonnegative upper limiting

theorem original_prepared_Y_domain (x : zeroLocalizedSpace actualNativeLocalizer) :
    ∃ h : prepared (zeroLocalizedProfile actualNativeLocalizer x)∈closedY.domain,
      closedY ⟨prepared (zeroLocalizedProfile actualNativeLocalizer x),h⟩=preparedY x ∧
      ∀ n : ℕ, ‖closedY ⟨prepared (zeroLocalizedProfile actualNativeLocalizer x),h⟩-
        cutoff n (prepared (zeroLocalizedProfile actualNativeLocalizer x))‖ ≤
          (915/916:ℝ)^(n+1)*916*bound*‖x‖ := by
  obtain ⟨h,actual⟩:=prepared_closedY x
  refine ⟨h,actual,?_⟩
  intro n
  change ‖closedY ⟨sourcePrepared x,h⟩-cutoff n (sourcePrepared x)‖ ≤ _
  rw [actual]
  have estimate:=prepared_cutoff_bound n x
  norm_num only [sourceCutRate,sourceRadiusBound,show (1-(916:ℝ)⁻¹)=(915/916:ℝ) by norm_num] at estimate
  exact estimate

open PreparationVacuumPreparedTail PreparationVacuumTailOperator PreparationVacuumTailSupport
open SaturationMonoid.Quantum.Forms

theorem actual_full_tail_preparation_Y (B : ℕ→Fin 5→ℕ→ℝ)
    (positive : ∀ k i n,0 ≤ B k i n) (input : UnitEnergyInputs B 102)
    (epsilon : ℝ) (precision : 0<epsilon) :
    ∃ x : (BoundedRemainder.operator sourceClosedFactor sourceClosedFactor_closed sourceClosedFactor_dense
      (completeNativeRemainder B positive input)).domain,
      ‖prepared (zeroLocalizedProfile actualNativeLocalizer x.val)‖=1 ∧
      ‖BoundedRemainder.operator sourceClosedFactor sourceClosedFactor_closed sourceClosedFactor_dense
        (completeNativeRemainder B positive input) x-
        (BoundedRemainder.energy sourceClosedFactor sourceClosedFactor_closed (completeNativeRemainder B positive input):ℂ) • x.val‖<epsilon ∧
      prepared (zeroLocalizedProfile actualNativeLocalizer x.val)=
        sourceCreated (GaussHalfDensity.halfDensityEquiv 0 x.val.val) ∧
      ∃ h : prepared (zeroLocalizedProfile actualNativeLocalizer x.val)∈closedY.domain,
        ∀ n : ℕ,‖closedY ⟨prepared (zeroLocalizedProfile actualNativeLocalizer x.val),h⟩-
          cutoff n (prepared (zeroLocalizedProfile actualNativeLocalizer x.val))‖ ≤
            (915/916:ℝ)^(n+1)*916*bound := by
  obtain ⟨x,unit,near,created,_⟩:=actual_full_tail_preparation B positive input epsilon precision
  obtain ⟨h,_value,estimate⟩:=original_prepared_Y_domain x.val
  refine ⟨x,unit,near,created,h,?_⟩
  have norm : ‖x.val‖=1 := (zeroLocalized_physical_norm actualNativeLocalizer x.val).symm.trans unit
  intro n
  simpa only [norm,mul_one] using estimate n

