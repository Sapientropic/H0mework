import H0mework.Versions.CAP.Physics.LowEnergy.Quantum.SourceQuantumRadialCore
import H0mework.Physics.GaugeAction.P286SourceRelativeWardAlgebra
import Mathlib.Tactic

/-! Actual source Cartan cubic; its orbit derivative is generated by Jacobi. -/
set_option autoImplicit false
set_option maxHeartbeats 1500000
noncomputable section
namespace LowEnergy.SourceCartanCubic
open SaturationMonoid.PhysicsCore
open StageNineHolonomicField StageNineP286BracketCalculus
open StageNineP286GaugeAuxiliaryVariation StageNineP286SourceRelativeWardAlgebra
open SourceQuantumScalarChart SourceQuantumConfigurationHilbert SourceRadialCore
open scoped ContDiff


theorem invariant_pair (a b c : P286CoordinateCarrier) :
    p286CoordinateLiePairing (coordinateBracket a b) c = p286CoordinateLiePairing a (coordinateBracket b c) :=
  p286CoordinateLiePairing_bracket_left a b c

def cubic (a b c : P286CoordinateCarrier) : ℝ := 2 * p286CoordinateLiePairing a (coordinateBracket b c)

theorem cubic_cyclic (a b c : P286CoordinateCarrier) : cubic a b c = cubic b c a := by
  unfold cubic
  rw [p286CoordinateLiePairing_symmetric a (coordinateBracket b c), invariant_pair]

theorem bracket_derivation (a b c : P286CoordinateCarrier) :
    coordinateBracket a (coordinateBracket b c) = coordinateBracket (coordinateBracket a b) c + coordinateBracket b (coordinateBracket a c) := by
  have h := coordinateBracket_jacobi a b c
  rw [coordinateBracket_skew c a, coordinateBracket_neg_right,
    coordinateBracket_skew c (coordinateBracket a b)] at h
  apply sub_eq_zero.mp
  simpa only [sub_eq_add_neg, neg_add, add_assoc, add_left_comm, add_comm] using h

theorem pair_skew (a b c : P286CoordinateCarrier) :
    p286CoordinateLiePairing (coordinateBracket a b) c = -p286CoordinateLiePairing b (coordinateBracket a c) := by
  rw [coordinateBracket_skew a b]
  rw [show -coordinateBracket b a = (-1 : ℝ) • coordinateBracket b a by simp]
  rw [p286CoordinateLiePairing_smul_left, invariant_pair]
  ring

theorem original_orbit_derivative (a b c u : P286CoordinateCarrier) :
    cubic (coordinateBracket u a) b c + cubic a (coordinateBracket u b) c + cubic a b (coordinateBracket u c) = 0 := by
  unfold cubic
  rw [pair_skew, bracket_derivation, p286CoordinateLiePairing_add_right]
  ring

theorem first_variation (a b c da db dc : P286CoordinateCarrier) :
    cubic da b c + cubic a db c + cubic a b dc =
      2 * (p286CoordinateLiePairing da (coordinateBracket b c) + p286CoordinateLiePairing db (coordinateBracket c a) + p286CoordinateLiePairing dc (coordinateBracket a b)) := by
  rw [cubic_cyclic a db c, cubic_cyclic a b dc, cubic_cyclic b dc a]
  unfold cubic
  ring

theorem cubic_curve_polynomial (a b c da db dc : P286CoordinateCarrier) (t : ℝ) :
    cubic (a+t • da) (b+t • db) (c+t • dc) = cubic a b c +
      t * (cubic da b c+cubic a db c+cubic a b dc) +
      t^2 * (cubic da db c+cubic da b dc+cubic a db dc) + t^3*cubic da db dc := by
  simp only [cubic, coordinateBracket_add_left, coordinateBracket_add_right,
    coordinateBracket_smul_left, coordinateBracket_smul_right,
    p286CoordinateLiePairing_add_left, p286CoordinateLiePairing_add_right,
    p286CoordinateLiePairing_smul_left, p286CoordinateLiePairing_smul_right]
  ring

set_option backward.isDefEq.respectTransparency false in
theorem cubic_curve_derivative (a b c da db dc : P286CoordinateCarrier) :
    HasDerivAt (fun t : ℝ => cubic (a+t • da) (b+t • db) (c+t • dc))
      (2 * (p286CoordinateLiePairing da (coordinateBracket b c) +
        p286CoordinateLiePairing db (coordinateBracket c a) +
        p286CoordinateLiePairing dc (coordinateBracket a b))) 0 := by
  have h := (((hasDerivAt_const (0 : ℝ) (cubic a b c)).add
      ((hasDerivAt_id (0 : ℝ)).mul_const (cubic da b c+cubic a db c+cubic a b dc))).add
      (((hasDerivAt_id (0 : ℝ)).pow 2).mul_const
        (cubic da db c+cubic da b dc+cubic a db dc))).add
      (((hasDerivAt_id (0 : ℝ)).pow 3).mul_const (cubic da db dc))
  norm_num only [id_eq, Pi.pow_apply, zero_add, add_zero, one_mul, zero_pow,
    mul_zero, zero_mul, Nat.cast_ofNat] at h
  rw [first_variation] at h
  convert h using 1 <;> try rfl
  funext t
  simpa only [Pi.add_apply, first_variation] using cubic_curve_polynomial a b c da db dc t


def nativeBracket : NativeLie →ₗ[ℝ] NativeLie →ₗ[ℝ] NativeLie := coordinateBracketBilinear

def gaugeCoordinate (i : Fin 3) : Gauge →ₗ[ℝ] NativeLie :=
  (LinearMap.proj i).comp (WithLp.linearEquiv 2 ℝ (Fin 3 → NativeLie)).toLinearMap

def sourcePhase (z : Configuration) : ℝ :=
  2 * (z.1 0 * z.1 2 * z.1 5) +
    2 * inner ℝ (gaugeCoordinate 0 z.2.2)
      (nativeBracket (gaugeCoordinate 1 z.2.2) (gaugeCoordinate 2 z.2.2))

theorem sourcePhase_smooth : ContDiff ℝ ∞ sourcePhase := by
  have hA (i : Fin 3) : ContDiff ℝ ∞ (fun z : Configuration => gaugeCoordinate i z.2.2) :=
    (gaugeCoordinate i).toContinuousLinearMap.contDiff.comp (contDiff_snd.comp contDiff_snd)
  have hb : ContDiff ℝ ∞ (fun z : Configuration =>
      nativeBracket (gaugeCoordinate 1 z.2.2) (gaugeCoordinate 2 z.2.2)) :=
    by
      let B : NativeLie →L[ℝ] NativeLie →L[ℝ] NativeLie := nativeBracket.toContinuousBilinearMap
      exact (B.contDiff.comp (hA 1)).clm_apply (hA 2)
  unfold sourcePhase
  exact (by fun_prop : ContDiff ℝ ∞ (fun z : Configuration => 2 * (z.1 0 * z.1 2 * z.1 5))).add
    (contDiff_const.mul ((hA 0).inner ℝ hb))

def sourceWeight (inverse : Bool) (z : Configuration) : ℂ :=
  (Real.exp ((if inverse then -1 else 1) * sourcePhase z) : ℂ)

theorem sourceWeight_smooth (inverse : Bool) : ContDiff ℝ ∞ (sourceWeight inverse) := by
  unfold sourceWeight
  exact Complex.ofRealCLM.contDiff.comp
    (Real.contDiff_exp.comp (contDiff_const.mul sourcePhase_smooth))

theorem sourceWeight_preserves_test (inverse : Bool) (N : ℕ) (f : SectorHilbert N)
    (hf : f ∈ testDomain N) :
    ∃ h : SectorHilbert N, h ∈ testDomain N ∧
      h =ᵐ[numberMeasure N] (fun z : chart => sourceWeight inverse z * f z) :=
  smooth_multiplier_preserves_test _ (sourceWeight_smooth inverse) N f hf

theorem sourceWeight_preserves_full_core (inverse : Bool) (f : FockHilbert)
    (hf : f ∈ fockTestDomain) :
    ∃ h : FockHilbert, h ∈ fockTestDomain ∧ ∀ word,
      h word =ᵐ[numberMeasure word.card]
        (fun z : chart => sourceWeight inverse z * f word z) := by
  have all (word : Occupation) := sourceWeight_preserves_test inverse word.card (f word) (hf word)
  choose h hc ha using all
  exact ⟨WithLp.toLp 2 h, hc, ha⟩

theorem pairing_return (z : Configuration) (psi phi : ℂ) :
    star (sourceWeight false z * psi) * (sourceWeight true z * phi) = star psi * phi := by
  simp only [sourceWeight, Bool.false_eq_true, ↓reduceIte, one_mul, neg_one_mul,
    star_mul, Complex.star_def, Complex.conj_ofReal, Real.exp_neg, Complex.ofReal_inv]
  have h : (Real.exp (sourcePhase z) : ℂ) ≠ 0 := by exact_mod_cast (Real.exp_ne_zero _)
  field_simp

#print axioms original_orbit_derivative
#print axioms first_variation
#print axioms cubic_curve_derivative
#print axioms sourceWeight_preserves_test
#print axioms sourceWeight_preserves_full_core
#print axioms pairing_return
end LowEnergy.SourceCartanCubic
