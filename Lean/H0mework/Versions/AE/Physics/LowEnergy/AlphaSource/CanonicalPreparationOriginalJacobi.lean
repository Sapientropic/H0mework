open scoped BigOperators
abbrev QuadraticTwo := QuadraticAlgebra ℚ 2 0
abbrev SourceCoefficient := QuadraticAlgebra QuadraticTwo 15 0

def rootTwo : ℂ := (Real.sqrt 2 : ℝ)
def rootFifteen : ℂ := (Real.sqrt 15 : ℝ)
def coefficientValue (c : SourceCoefficient) : ℂ :=
  (c.re.re : ℂ)+(c.re.im : ℂ)*rootTwo+
    ((c.im.re : ℂ)+(c.im.im : ℂ)*rootTwo)*rootFifteen

private theorem rootTwo_sq : rootTwo^2=2 := by
  norm_cast
  norm_num [rootTwo,←Complex.ofReal_pow,Real.sq_sqrt]
private theorem rootFifteen_sq : rootFifteen^2=15 := by
  norm_cast
  norm_num [rootFifteen,←Complex.ofReal_pow,Real.sq_sqrt]

theorem coefficient_zero : coefficientValue 0=0 := by simp [coefficientValue]
theorem coefficient_add (a b : SourceCoefficient) :
    coefficientValue (a+b)=coefficientValue a+coefficientValue b := by
  simp [coefficientValue]
  ring

theorem coefficient_mul (a b : SourceCoefficient) :
    coefficientValue (a*b)=coefficientValue a*coefficientValue b := by
  simp only [coefficientValue,QuadraticAlgebra.re_mul,QuadraticAlgebra.im_mul,
    QuadraticAlgebra.re_add,QuadraticAlgebra.im_add,QuadraticAlgebra.re_ofNat,
    QuadraticAlgebra.im_ofNat,QuadraticAlgebra.re_zero,QuadraticAlgebra.im_zero,
    Rat.cast_add,Rat.cast_mul,Rat.cast_ofNat,Rat.cast_zero]
  linear_combination (norm := ring_nf)
    -((a.re.im : ℂ)*(b.re.im : ℂ)+(a.im.im : ℂ)*(b.im.im : ℂ)*15+
      ((a.re.im : ℂ)*(b.im.im : ℂ)+(a.im.im : ℂ)*(b.re.im : ℂ))*rootFifteen)*rootTwo_sq
    -(((a.im.re : ℂ)+(a.im.im : ℂ)*rootTwo)*
      ((b.im.re : ℂ)+(b.im.im : ℂ)*rootTwo))*rootFifteen_sq

structure Powers where
  temporal : ℕ
  first : ℕ
  second : ℕ
  third : ℕ
  deriving DecidableEq

def Powers.join (a b : Powers) : Powers :=
  ⟨a.temporal+b.temporal,a.first+b.first,a.second+b.second,a.third+b.third⟩
def Powers.value (a : Powers) (p : Fin 4→ℂ) : ℂ :=
  p 0^a.temporal*p 1^a.first*p 2^a.second*p 3^a.third

theorem Powers.value_join (a b : Powers) (p : Fin 4→ℂ) :
    (a.join b).value p=a.value p*b.value p := by simp [join,value,pow_add];ring

structure SourceTerm where
  row : Fin 289
  column : Fin 289
  powers : Powers
  coefficient : SourceCoefficient
  deriving DecidableEq

def SourceTerm.sameKey (a b : SourceTerm) : Bool :=
  decide (a.row=b.row ∧ a.column=b.column ∧ a.powers=b.powers)
def SourceTerm.matrix (a : SourceTerm) (p : Fin 4→ℂ) : Matrix (Fin 289) (Fin 289) ℂ :=
  Matrix.single a.row a.column (coefficientValue a.coefficient*a.powers.value p)
def sourceMatrix (terms : List SourceTerm) (p : Fin 4→ℂ) : Matrix (Fin 289) (Fin 289) ℂ :=
  (terms.map (fun a=>a.matrix p)).sum

-- Explicit List.rec avoids equation-compiler partial helper declarations.
def insertTerm (a : SourceTerm) (terms : List SourceTerm) : List SourceTerm :=
  List.rec [a] (fun b rest next=>
    if a.sameKey b then
      let c:=a.coefficient+b.coefficient
      if c=0 then rest else {b with coefficient:=c}::rest
    else b::next) terms

def normalizeTerms (terms : List SourceTerm) : List SourceTerm :=
  terms.foldr (fun a result=>if a.coefficient=0 then result else insertTerm a result) []

def rowProduct (a : SourceTerm) (right : List SourceTerm) : List SourceTerm :=
  right.foldr (fun b rest=>if a.column=b.row then
    ⟨a.row,b.column,a.powers.join b.powers,a.coefficient*b.coefficient⟩::rest else rest) []
def productTerms (left right : List SourceTerm) : List SourceTerm :=
  left.foldr (fun a rest=>rowProduct a right++rest) []

theorem sourceMatrix_nil (p : Fin 4→ℂ) : sourceMatrix [] p=0 := rfl

theorem sourceMatrix_cons (a : SourceTerm) (ts : List SourceTerm) (p : Fin 4→ℂ) :
    sourceMatrix (a::ts) p=a.matrix p+sourceMatrix ts p := rfl

theorem sourceMatrix_append (a b : List SourceTerm) (p : Fin 4→ℂ) :
    sourceMatrix (a++b) p=sourceMatrix a p+sourceMatrix b p := by
  simp [sourceMatrix]

private theorem term_zero (a : SourceTerm) (zero : a.coefficient=0) (p : Fin 4→ℂ) :
    a.matrix p=0 := by simp [SourceTerm.matrix,zero,coefficient_zero]

private theorem same_key_add (a b : SourceTerm) (same : a.sameKey b=true) (p : Fin 4→ℂ) :
    ({b with coefficient:=a.coefficient+b.coefficient} : SourceTerm).matrix p=
      a.matrix p+b.matrix p := by
  have h : a.row=b.row ∧ a.column=b.column ∧ a.powers=b.powers := of_decide_eq_true same
  simp only [SourceTerm.matrix,h.1,h.2.1,h.2.2,coefficient_add,add_mul,Matrix.single_add]

theorem insertTerm_value (a : SourceTerm) (ts : List SourceTerm) (p : Fin 4→ℂ) :
    sourceMatrix (insertTerm a ts) p=a.matrix p+sourceMatrix ts p := by
  induction ts with
  | nil=>simp [insertTerm,sourceMatrix]
  | cons b rest ih=>
    by_cases same : a.sameKey b=true
    · change sourceMatrix (if a.sameKey b then
        (if a.coefficient+b.coefficient=0 then rest else {b with coefficient:=a.coefficient+b.coefficient}::rest)
        else b::insertTerm a rest) p=_
      rw [if_pos same]
      split_ifs with zero
      · have h:=same_key_add a b same p
        rw [term_zero _ zero p] at h
        simp only [sourceMatrix_cons,←add_assoc,←h,zero_add]
      · rw [sourceMatrix_cons,same_key_add a b same p,sourceMatrix_cons,add_assoc]
    · change sourceMatrix (if a.sameKey b then
        (if a.coefficient+b.coefficient=0 then rest else {b with coefficient:=a.coefficient+b.coefficient}::rest)
        else b::insertTerm a rest) p=_
      rw [if_neg same,sourceMatrix_cons,sourceMatrix_cons]
      rw [ih]
      abel

theorem normalizeTerms_value (ts : List SourceTerm) (p : Fin 4→ℂ) :
    sourceMatrix (normalizeTerms ts) p=sourceMatrix ts p := by
  induction ts with
  | nil=>rfl
  | cons a rest ih=>
    simp only [normalizeTerms] at ih
    simp only [normalizeTerms,List.foldr_cons]
    split_ifs with zero
    · rw [ih,sourceMatrix_cons,term_zero a zero p,zero_add]
    · rw [insertTerm_value,ih,sourceMatrix_cons]

private theorem term_product (a b : SourceTerm) (same : a.column=b.row) (p : Fin 4→ℂ) :
    (⟨a.row,b.column,a.powers.join b.powers,a.coefficient*b.coefficient⟩ : SourceTerm).matrix p=
      a.matrix p*b.matrix p := by
  simp only [SourceTerm.matrix,same,Matrix.single_mul_single_same,coefficient_mul,Powers.value_join]
  congr 1
  ring

private theorem term_product_zero (a b : SourceTerm) (different : a.column≠b.row) (p : Fin 4→ℂ) :
    a.matrix p*b.matrix p=0 := Matrix.single_mul_single_of_ne _ _ _ _ different _

theorem rowProduct_value (a : SourceTerm) (ts : List SourceTerm) (p : Fin 4→ℂ) :
    sourceMatrix (rowProduct a ts) p=a.matrix p*sourceMatrix ts p := by
  induction ts with
  | nil=>simp [rowProduct,sourceMatrix]
  | cons b rest ih=>
    change sourceMatrix (if a.column=b.row then
      ⟨a.row,b.column,a.powers.join b.powers,a.coefficient*b.coefficient⟩::rowProduct a rest
      else rowProduct a rest) p=_
    by_cases same : a.column=b.row
    · rw [if_pos same,sourceMatrix_cons,term_product a b same p,ih,sourceMatrix_cons,mul_add]
    · rw [if_neg same,ih,sourceMatrix_cons,mul_add,term_product_zero a b same p,zero_add]

theorem productTerms_value (left right : List SourceTerm) (p : Fin 4→ℂ) :
    sourceMatrix (productTerms left right) p=sourceMatrix left p*sourceMatrix right p := by
  induction left with
  | nil=>simp [productTerms,sourceMatrix]
  | cons a rest ih=>
    change sourceMatrix (rowProduct a right++productTerms rest right) p=_
    rw [sourceMatrix_append,rowProduct_value,ih,sourceMatrix_cons,add_mul]

abbrev SourceAtom := Powers×SourceCoefficient

def decodeTerms (atoms : List SourceAtom) (codes : List ℕ) : List SourceTerm :=
  codes.map (fun code=>
    let atom:=atoms[code%atoms.length]?.getD (⟨0,0,0,0⟩,0)
    let place:=code/atoms.length
    ⟨⟨(place/289)%289,Nat.mod_lt _ (by decide)⟩,
      ⟨place%289,Nat.mod_lt _ (by decide)⟩,atom.1,atom.2⟩)

