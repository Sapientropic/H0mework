import H0mework.Versions.AE.Physics.LowEnergy.AlphaSource.CanonicalPhysicalYResolvent
import Mathlib.Analysis.SpecialFunctions.Pow.Asymptotics

/-! The complete source inverse is generated by the actual causal time
integral. The finite original grade supplies a polynomial tail before the
same-filter completion; no small Yukawa norm or stationary state is used. -/
set_option autoImplicit false
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
set_option synthInstance.maxHeartbeats 200000
set_option backward.isDefEq.respectTransparency false
noncomputable section
namespace LowEnergy.CanonicalPhysicalLaplace
open GaussCoreHilbert CanonicalPhysicalSpatial CanonicalGradedSpatialSource
open CanonicalPhysicalYResolvent
open FullYSourceCutoffVolterra
open SourceFamilyOperator Filter MeasureTheory
open GaussUnitaryHistory (Index sourceFilter HistorySpace)
open scoped Topology InnerProductSpace Interval

section Finite
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
local instance : NormedAlgebra ℝ (E →L[ℂ] E) := NormedAlgebra.restrictScalars ℝ ℂ _

def phase (z : ℂ) (t : ℝ) : ℂ := Complex.exp (t • (Complex.I*z))

theorem phase_derivative (z : ℂ) (t : ℝ) :
    HasDerivAt (phase z) (phase z t*(Complex.I*z)) t := by
  change HasDerivAt (fun s : ℝ => Complex.exp (s • (Complex.I*z)))
    (Complex.exp (t • (Complex.I*z))*(Complex.I*z)) t
  simpa only [Complex.exp_eq_exp_ℂ] using! hasDerivAt_exp_smul_const (Complex.I*z) t

theorem phase_norm (z : ℂ) (t : ℝ) : ‖phase z t‖=Real.exp (-z.im*t) := by
  simp [phase, Complex.norm_exp, Complex.real_smul, mul_comm]

def dampedTime (C : E →L[ℂ] E) (z : ℂ) (t : ℝ) : E →L[ℂ] E :=
  phase z t • SourceFiniteUnitary.time C t

theorem dampedTime_derivative (C : E →L[ℂ] E) (z : ℂ) (t : ℝ) :
    HasDerivAt (dampedTime C z) (dampedTime C z t*((-Complex.I) • (C-z • 1))) t := by
  have ht := hasDerivAt_exp_smul_const ((-Complex.I) • C) t
  change HasDerivAt (SourceFiniteUnitary.time C)
    (SourceFiniteUnitary.time C t*((-Complex.I) • C)) t at ht
  have h := (phase_derivative z t).smul ht
  have algebra : (phase z t*(Complex.I*z)) • SourceFiniteUnitary.time C t+
      phase z t • (SourceFiniteUnitary.time C t*((-Complex.I) • C)) =
      dampedTime C z t*((-Complex.I) • (C-z • 1)) := by
    simp only [dampedTime, smul_mul_assoc, mul_smul_comm, mul_sub, mul_one, smul_sub, smul_smul]
    module
  exact h.congr_deriv ((add_comm _ _).trans algebra)

theorem dampedTime_continuous (C : E →L[ℂ] E) (z : ℂ) : Continuous (dampedTime C z) :=
  continuous_iff_continuousAt.mpr (fun t => (dampedTime_derivative C z t).continuousAt)

def causalIntegral (C : E →L[ℂ] E) (z : ℂ) (T : ℝ) : E →L[ℂ] E :=
  Complex.I • ∫ t in (0 : ℝ)..T, dampedTime C z t

theorem finite_causal_identity (C R : E →L[ℂ] E) (z : ℂ)
    (inverse : (C-z • 1)*R=1) (T : ℝ) :
    causalIntegral C z T=R-dampedTime C z T*R := by
  have derivative (t : ℝ) :
      HasDerivAt (fun s => Complex.I • (dampedTime C z s*R)) (dampedTime C z t) t := by
    have h := ((dampedTime_derivative C z t).mul_const R).const_smul Complex.I
    simpa only [mul_smul_comm, smul_mul_assoc, mul_assoc, inverse, mul_one, smul_smul,
      mul_neg, Complex.I_mul_I, neg_neg, one_smul] using! h
  have continuous := dampedTime_continuous C z
  have integrated := intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => derivative t)
    (continuous.intervalIntegrable (μ := volume) 0 T)
  have initial : dampedTime C z 0=1 := by
    simp only [dampedTime, phase, zero_smul, Complex.exp_zero, one_smul, SourceFiniteUnitary.time_zero]
  have h := congrArg (fun A : E →L[ℂ] E => Complex.I • A) integrated
  rw [initial, one_mul] at h
  calc
    causalIntegral C z T = Complex.I • (Complex.I • (dampedTime C z T*R)-Complex.I • R) := h
    _ = R-dampedTime C z T*R := by
      rw [smul_sub, smul_smul, smul_smul, Complex.I_mul_I, neg_one_smul, neg_one_smul]
      abel


end Finite

private theorem homogeneous_product {R : Type*} [Ring R] [Module ℂ R]
    [IsScalarTower ℂ R R] [SMulCommClass ℂ R R] (G A B : R) (n : ℕ)
    (hA : G*A=A*G+(n : ℂ) • A) (hB : G*B=B*G+B) :
    G*(A*B)=(A*B)*G+((n+1 : ℕ) : ℂ) • (A*B) := by
  calc
    _ = (A*G+(n : ℂ) • A)*B := by rw [← mul_assoc, hA]
    _ = A*(B*G+B)+(n : ℂ) • (A*B) := by rw [add_mul, smul_mul_assoc, mul_assoc, hB]
    _ = _ := by simp only [mul_add, Nat.cast_add, Nat.cast_one, add_smul, one_smul, mul_assoc]; abel

theorem terminal_zero (p : PhysicalMomentum) (F : Index) (cut : ℕ) (t : ℝ) :
    finitePrefix (compression p F) (cutoff cut) 56 t*cutoff cut=0 :=
  source_homogeneous_zero _ 57
    (homogeneous_product _ _ _ 56
      (finitePrefix_homogeneous _ _ _ (compression_grade p F) (cutoff_raises cut) 56 t)
      (cutoff_raises cut)) (by norm_num)

theorem full_time_finite_sum (p : PhysicalMomentum) (F : Index) (cut : ℕ) (t : ℝ) :
    partialEvolution (compression p F) (cutoff cut) 56 t=
      SourceFiniteUnitary.time (compression p F+cutoff cut) t := by
  have derivative (s : ℝ) : HasDerivAt (partialEvolution (compression p F) (cutoff cut) 56)
      (partialEvolution (compression p F) (cutoff cut) 56 s*((-Complex.I) • (compression p F+cutoff cut))) s := by
    simpa only [mul_smul_comm, terminal_zero p F cut s, smul_zero, sub_zero] using
      partialEvolution_derivative (compression p F) (cutoff cut) 56 s
  exact autonomous_evolution_unique _ _ derivative (partialEvolution_initial _ _ 56) t

def timeBound (cut : ℕ) (t : ℝ) : ℝ := ∑ n ∈ Finset.range 57, (|t| * ‖cutoff cut‖)^n

theorem timeBound_nonneg (cut : ℕ) (t : ℝ) : 0≤timeBound cut t := by unfold timeBound; positivity

theorem full_time_bound (p : PhysicalMomentum) (F : Index) (cut : ℕ) (t : ℝ) :
    ‖SourceFiniteUnitary.time (compression p F+cutoff cut) t‖ ≤ timeBound cut t := by
  rw [← full_time_finite_sum]
  exact partialEvolution_bound _ _ (compression_selfAdjoint p F) 56 t

def finiteCausal (p : PhysicalMomentum) (cut : ℕ) (z : ℂ) (T : ℝ) (F : Index) : H →L[ℂ] H :=
  causalIntegral (compression p F+cutoff cut) z T

theorem finiteCausal_return (p : PhysicalMomentum) (cut : ℕ) (z : ℂ) (hz : z.im≠0) (T : ℝ) (F : Index) :
    finiteCausal p cut z T F=finiteFull p F cut z-
      dampedTime (compression p F+cutoff cut) z T*finiteFull p F cut z :=
  finite_causal_identity _ _ z (finiteFull_right p F cut z hz) T

def tailBound (cut : ℕ) (z : ℂ) (T : ℝ) : ℝ :=
  Real.exp (-z.im*T)*timeBound cut T*normBound cut z

theorem tailBound_nonneg (cut : ℕ) (z : ℂ) (T : ℝ) : 0≤tailBound cut z T :=
  mul_nonneg (mul_nonneg (Real.exp_pos _).le (timeBound_nonneg cut T)) (normBound_nonneg cut z)

theorem finiteCausal_error (p : PhysicalMomentum) (cut : ℕ) (z : ℂ) (hz : z.im≠0) (T : ℝ) (F : Index) :
    ‖finiteCausal p cut z T F-finiteFull p F cut z‖ ≤ tailBound cut z T := by
  have identity : finiteCausal p cut z T F-finiteFull p F cut z =
      -(dampedTime (compression p F+cutoff cut) z T*finiteFull p F cut z) := by
    rw [finiteCausal_return p cut z hz T F]; abel
  rw [identity, norm_neg]
  have decay : ‖dampedTime (compression p F+cutoff cut) z T‖ ≤ Real.exp (-z.im*T)*timeBound cut T := by
    rw [dampedTime, norm_smul, phase_norm]
    exact mul_le_mul_of_nonneg_left (full_time_bound p F cut T) (Real.exp_pos _).le
  exact (norm_mul_le _ _).trans
    (mul_le_mul decay (finiteFull_bound p F cut z hz) (norm_nonneg _)
      (mul_nonneg (Real.exp_pos _).le (timeBound_nonneg cut T)))


def errorFamily (p : PhysicalMomentum) (cut : ℕ) (z : ℂ) (hz : z.im≠0) (T : ℝ) : Operator Index H where
  component F := finiteCausal p cut z T F-finiteFull p F cut z
  bounded := ⟨tailBound cut z T, tailBound_nonneg cut z T, fun F x =>
    ((finiteCausal p cut z T F-finiteFull p F cut z).le_opNorm x).trans
      (mul_le_mul_of_nonneg_right (finiteCausal_error p cut z hz T F) (norm_nonneg x))⟩

def causalFamily (p : PhysicalMomentum) (cut : ℕ) (z : ℂ) (hz : z.im≠0) (T : ℝ) : Operator Index H where
  component := finiteCausal p cut z T
  bounded := ⟨normBound cut z+tailBound cut z T,
    add_nonneg (normBound_nonneg cut z) (tailBound_nonneg cut z T), fun F x => by
    have identity : finiteCausal p cut z T F x=finiteFull p F cut z x+
        (finiteCausal p cut z T F-finiteFull p F cut z) x := by simp only [sub_apply]; abel
    rw [identity]
    have main := ((finiteFull p F cut z).le_opNorm x).trans
      (mul_le_mul_of_nonneg_right (finiteFull_bound p F cut z hz) (norm_nonneg x))
    have error := ((finiteCausal p cut z T F-finiteFull p F cut z).le_opNorm x).trans
      (mul_le_mul_of_nonneg_right (finiteCausal_error p cut z hz T F) (norm_nonneg x))
    exact (norm_add_le _ _).trans ((add_le_add main error).trans_eq (add_mul _ _ _).symm)⟩

def causal (p : PhysicalMomentum) (cut : ℕ) (z : ℂ) (hz : z.im≠0) (T : ℝ) :
    HistorySpace →L[ℂ] HistorySpace := lift sourceFilter (causalFamily p cut z hz T)

theorem completed_error_identity (p : PhysicalMomentum) (cut : ℕ) (z : ℂ) (hz : z.im≠0) (T : ℝ) :
    lift sourceFilter (errorFamily p cut z hz T)=causal p cut z hz T-fullResolvent p cut z hz := by
  apply SourceFamilyOperator.ext sourceFilter
  intro f
  change lift sourceFilter (errorFamily p cut z hz T) (f : HistorySpace)=
    lift sourceFilter (causalFamily p cut z hz T) (f : HistorySpace)-
      lift sourceFilter (fullFamily p cut z hz) (f : HistorySpace)
  rw [lift_coe, lift_coe, lift_coe, ← UniformSpace.Completion.coe_sub]
  congr 1

theorem completed_error (p : PhysicalMomentum) (cut : ℕ) (z : ℂ) (hz : z.im≠0) (T : ℝ) (x : HistorySpace) :
    ‖causal p cut z hz T x-fullResolvent p cut z hz x‖ ≤ tailBound cut z T*‖x‖ := by
  have identity := congrArg (fun A : HistorySpace →L[ℂ] HistorySpace => A x)
    (completed_error_identity p cut z hz T)
  change lift sourceFilter (errorFamily p cut z hz T) x=causal p cut z hz T x-fullResolvent p cut z hz x at identity
  rw [← identity]
  apply SourceBoundaryGram.lift_bound_explicit sourceFilter (errorFamily p cut z hz T) _ (tailBound_nonneg cut z T)
  intro F g
  exact ((finiteCausal p cut z T F-finiteFull p F cut z).le_opNorm g).trans
    (mul_le_mul_of_nonneg_right (finiteCausal_error p cut z hz T F) (norm_nonneg g))

theorem completed_norm_error (p : PhysicalMomentum) (cut : ℕ) (z : ℂ) (hz : z.im≠0) (T : ℝ) :
    ‖causal p cut z hz T-fullResolvent p cut z hz‖ ≤ tailBound cut z T :=
  ContinuousLinearMap.opNorm_le_bound _ (tailBound_nonneg cut z T) (completed_error p cut z hz T)

theorem tailBound_zero (cut : ℕ) (z : ℂ) (positive : 0<z.im) :
    Tendsto (tailBound cut z) atTop (𝓝 0) := by
  have terms (n : ℕ) : Tendsto (fun T : ℝ => ‖cutoff cut‖^n*(T^n*Real.exp (-z.im*T))) atTop (𝓝 0) := by
    simpa only [Real.rpow_natCast, mul_zero] using
      (tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero (n : ℝ) z.im positive).const_mul (‖cutoff cut‖^n)
  have summed : Tendsto (fun T : ℝ => (∑ n ∈ Finset.range 57,
      ‖cutoff cut‖^n*(T^n*Real.exp (-z.im*T)))*normBound cut z) atTop (𝓝 0) := by
    simpa only [Finset.sum_const_zero, zero_mul] using
      (tendsto_finsetSum (Finset.range 57) (fun n _ => terms n)).mul_const (normBound cut z)
  apply summed.congr'
  filter_upwards [eventually_ge_atTop (0 : ℝ)] with T nonneg
  simp only [tailBound, timeBound, abs_of_nonneg nonneg, Finset.mul_sum, Finset.sum_mul, mul_pow]
  apply Finset.sum_congr rfl
  intro n _
  ring

theorem causal_to_fullResolvent (p : PhysicalMomentum) (cut : ℕ) (z : ℂ) (positive : 0<z.im) :
    Tendsto (causal p cut z (ne_of_gt positive)) atTop (𝓝 (fullResolvent p cut z (ne_of_gt positive))) := by
  rw [tendsto_iff_norm_sub_tendsto_zero]
  exact squeeze_zero (fun T => norm_nonneg _) (fun T => completed_norm_error p cut z (ne_of_gt positive) T)
    (tailBound_zero cut z positive)

end LowEnergy.CanonicalPhysicalLaplace
