import H0mework.Versions.AD.Physics.Bell.ReadoutEffects

/-!
# Atomic response and fragment detector fibres of the original source effect

The original lawful local effect generates the entire decomposition into an atomic binary
effect, a background click probability and a fragment-detection factor.  The inverse is an
explicit effect constructor.  Its exact fibre generates a joint lower bound on detector
efficiency times maximal atomic response, then polarity-free transport from whole-domain
bias and gain enclosures.  No actual pulse values or raw outcome dictionary enter this mouth.
-/

set_option autoImplicit false

namespace SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber

noncomputable section

/-- Smallest and largest eigenvalues of the complementary click effect. -/
def minClick (effect : CompactReadoutEffect) : ℝ := (1 - effect.mu - effect.gain) / 2

def maxClick (effect : CompactReadoutEffect) : ℝ := (1 - effect.mu + effect.gain) / 2

/-- A compact effect used as the atomic ionization effect has trace `1 + mu`. -/
def maxAtomic (atom : CompactReadoutEffect) : ℝ := (1 + atom.mu + atom.gain) / 2

/-- The common fragment detector scales ionization by `k = (1 - d) eta`. -/
structure Rates (d k : ℝ) : Prop where
  background_nonnegative : 0 ≤ d
  factor_nonnegative : 0 ≤ k
  total_le_one : d + k ≤ 1

/-- Coordinate equality of `E_dark = I - d I - k J`; `J` is independently lawful. -/
def Realizes (effect : CompactReadoutEffect) (d k : ℝ) (atom : CompactReadoutEffect) : Prop :=
  effect.mu = 1 - 2 * d - k * (1 + atom.mu) ∧
    effect.u = -k * atom.u ∧ effect.z = -k * atom.z

/-- The complete nonzero-response parameter fibre generated by the observed source effect. -/
structure Fiber (effect : CompactReadoutEffect) (d k : ℝ) : Prop where
  background_nonnegative : 0 ≤ d
  background_le_min : d ≤ minClick effect
  factor_lower : maxClick effect - d ≤ k
  factor_upper : k ≤ 1 - d

theorem click_bounds (effect : CompactReadoutEffect) :
    0 ≤ minClick effect ∧ minClick effect ≤ maxClick effect ∧ maxClick effect ≤ 1 := by
  simp only [minClick, maxClick]
  constructor
  · linarith only [effect.gain_le_minus]
  · constructor
    · linarith only [effect.gain_nonnegative]
    · linarith only [effect.gain_le_plus]

theorem click_gap (effect : CompactReadoutEffect) :
    maxClick effect - minClick effect = effect.gain := by
  simp only [maxClick, minClick]
  ring

theorem max_atomic_bounds (atom : CompactReadoutEffect) :
    0 ≤ maxAtomic atom ∧ maxAtomic atom ≤ 1 := by
  simp only [maxAtomic]
  constructor
  · linarith only [atom.mu_lower, atom.gain_nonnegative]
  · linarith only [atom.gain_le_minus]

private def effectOfRadius (mu u z radius : ℝ) (nonnegative : 0 ≤ radius)
    (norm : u ^ 2 + z ^ 2 = radius ^ 2)
    (plus : radius ≤ 1 + mu) (minus : radius ≤ 1 - mu) : CompactReadoutEffect where
  mu := mu
  u := u
  z := z
  mu_lower := by linarith only [nonnegative, plus]
  mu_upper := by linarith only [nonnegative, minus]
  norm_plus := by rw [norm]; nlinarith only [nonnegative, plus]
  norm_minus := by rw [norm]; nlinarith only [nonnegative, minus]

/-- Raw detector rates and a lawful atomic effect construct the complete observed effect. -/
def detectorEffect (atom : CompactReadoutEffect) (d k : ℝ) (rates : Rates d k) :
    CompactReadoutEffect :=
  effectOfRadius (1 - 2 * d - k * (1 + atom.mu)) (-k * atom.u) (-k * atom.z)
    (k * atom.gain) (mul_nonneg rates.factor_nonnegative atom.gain_nonnegative)
    (by rw [mul_pow, mul_pow, mul_pow]; nlinarith only [atom.gain_sq])
    (by have bound := mul_le_mul_of_nonneg_left atom.gain_le_minus rates.factor_nonnegative
        nlinarith only [bound, rates.total_le_one])
    (by have bound := mul_le_mul_of_nonneg_left atom.gain_le_plus rates.factor_nonnegative
        nlinarith only [bound, rates.background_nonnegative])

theorem detector_effect_realizes (atom : CompactReadoutEffect) (d k : ℝ) (rates : Rates d k) :
    Realizes (detectorEffect atom d k rates) d k atom := ⟨rfl, rfl, rfl⟩

theorem realizes_gain (effect atom : CompactReadoutEffect) (d k : ℝ)
    (nonnegative : 0 ≤ k) (realizes : Realizes effect d k atom) :
    effect.gain = k * atom.gain := by
  have norm : effect.gain ^ 2 = (k * atom.gain) ^ 2 := by
    rw [effect.gain_sq, realizes.2.1, realizes.2.2, mul_pow, mul_pow, mul_pow]
    nlinarith only [atom.gain_sq]
  nlinarith only [norm, effect.gain_nonnegative,
    mul_nonneg nonnegative atom.gain_nonnegative]

theorem realizes_fiber (effect atom : CompactReadoutEffect) (d k : ℝ)
    (rates : Rates d k) (realizes : Realizes effect d k atom) : Fiber effect d k := by
  have gain := realizes_gain effect atom d k rates.factor_nonnegative realizes
  have plus := mul_le_mul_of_nonneg_left atom.gain_le_plus rates.factor_nonnegative
  have minus := mul_le_mul_of_nonneg_left atom.gain_le_minus rates.factor_nonnegative
  refine ⟨rates.background_nonnegative, ?_, ?_, by linarith only [rates.total_le_one]⟩
  · simp only [minClick]
    nlinarith only [realizes.1, gain, plus]
  · simp only [maxClick]
    nlinarith only [realizes.1, gain, minus]

theorem Fiber.factor_positive {effect : CompactReadoutEffect} {d k : ℝ}
    (fiber : Fiber effect d k) (positive : 0 < effect.gain) : 0 < k := by
  have gap := click_gap effect
  linarith only [fiber.background_le_min, fiber.factor_lower, positive, gap]

theorem Fiber.background_lt_one {effect : CompactReadoutEffect} {d k : ℝ}
    (fiber : Fiber effect d k) (positive : 0 < k) : d < 1 := by
  linarith only [fiber.factor_upper, positive]

/-- Every positive-factor member of the source fibre generates its lawful atomic effect. -/
def inverseAtom (effect : CompactReadoutEffect) (d k : ℝ) (fiber : Fiber effect d k)
    (positive : 0 < k) : CompactReadoutEffect :=
  effectOfRadius ((1 - effect.mu - 2 * d) / k - 1) (-effect.u / k) (-effect.z / k)
    (effect.gain / k) (div_nonneg effect.gain_nonnegative positive.le)
    (by field_simp; nlinarith only [effect.gain_sq])
    (by apply (div_le_iff₀ positive).mpr
        have upper := fiber.background_le_min
        simp only [minClick] at upper
        field_simp
        linarith only [upper])
    (by apply (div_le_iff₀ positive).mpr
        have lower := fiber.factor_lower
        simp only [maxClick] at lower
        field_simp
        linarith only [lower])

theorem inverse_atom_realizes (effect : CompactReadoutEffect) (d k : ℝ)
    (fiber : Fiber effect d k) (positive : 0 < k) :
    Realizes effect d k (inverseAtom effect d k fiber positive) := by
  simp only [Realizes, inverseAtom, effectOfRadius]
  constructor
  · field_simp
    ring
  · constructor <;> field_simp

/-- The explicit inverse recovers the same independently supplied lawful atomic effect. -/
theorem inverse_atom_unique (effect atom : CompactReadoutEffect) (d k : ℝ)
    (fiber : Fiber effect d k) (positive : 0 < k) (realizes : Realizes effect d k atom) :
    inverseAtom effect d k fiber positive = atom := by
  apply CompactReadoutEffect.ext
  · change (1 - effect.mu - 2 * d) / k - 1 = atom.mu
    rw [realizes.1]
    field_simp [ne_of_gt positive]
    ring
  · change -effect.u / k = atom.u
    rw [realizes.2.1]
    field_simp [ne_of_gt positive]
  · change -effect.z / k = atom.z
    rw [realizes.2.2]
    field_simp [ne_of_gt positive]

/-- Nonzero source response identifies the full detector/atomic decomposition set. -/
theorem fiber_iff_decomposition (effect : CompactReadoutEffect) (d k : ℝ)
    (positive : 0 < effect.gain) :
    Fiber effect d k ↔ Rates d k ∧ ∃ atom : CompactReadoutEffect, Realizes effect d k atom := by
  constructor
  · intro fiber
    have factor := fiber.factor_positive positive
    exact ⟨⟨fiber.background_nonnegative, factor.le, by linarith only [fiber.factor_upper]⟩,
      inverseAtom effect d k fiber factor, inverse_atom_realizes effect d k fiber factor⟩
  · rintro ⟨rates, atom, realizes⟩
    exact realizes_fiber effect atom d k rates realizes

def efficiency (d k : ℝ) : ℝ := k / (1 - d)

theorem efficiency_eq_physical (d k eta : ℝ) (background : d < 1)
    (factor : k = (1 - d) * eta) : efficiency d k = eta := by
  have denominator : 1 - d ≠ 0 := ne_of_gt (show 0 < 1 - d by linarith only [background])
  simp only [efficiency]
  rw [factor]
  field_simp

def intrinsicLower (effect : CompactReadoutEffect) : ℝ :=
  2 * effect.gain / (1 + effect.mu + effect.gain)

theorem intrinsic_denominator_positive (effect : CompactReadoutEffect)
    (positive : 0 < effect.gain) : 0 < 1 + effect.mu + effect.gain := by
  linarith only [positive, effect.gain_le_plus]

theorem intrinsic_lower_eq (effect : CompactReadoutEffect) (positive : 0 < effect.gain) :
    intrinsicLower effect = effect.gain / (1 - minClick effect) := by
  have denominator := intrinsic_denominator_positive effect positive
  have gap : 1 - minClick effect = (1 + effect.mu + effect.gain) / 2 := by
    simp only [minClick]
    ring
  rw [gap]
  simp only [intrinsicLower]
  field_simp [ne_of_gt denominator]

theorem efficiency_bounds (d k : ℝ) (rates : Rates d k) (background : d < 1) :
    0 ≤ efficiency d k ∧ efficiency d k ≤ 1 := by
  have denominator : 0 < 1 - d := by linarith only [background]
  constructor
  · exact div_nonneg rates.factor_nonnegative denominator.le
  · apply (div_le_iff₀ denominator).mpr
    simp only [one_mul]
    linarith only [rates.total_le_one]

theorem efficiency_atomic_product (effect atom : CompactReadoutEffect) (d k : ℝ)
    (rates : Rates d k) (realizes : Realizes effect d k atom) :
    efficiency d k * maxAtomic atom = (maxClick effect - d) / (1 - d) := by
  have gain := realizes_gain effect atom d k rates.factor_nonnegative realizes
  simp only [efficiency, maxAtomic, maxClick]
  rw [gain, realizes.1]
  ring

/-- The entire source fibre generates a joint lower bound, without fixing either factor. -/
theorem efficiency_atomic_lower (effect atom : CompactReadoutEffect) (d k : ℝ)
    (rates : Rates d k) (realizes : Realizes effect d k atom) (positive : 0 < effect.gain) :
    intrinsicLower effect ≤ efficiency d k * maxAtomic atom := by
  have fiber := realizes_fiber effect atom d k rates realizes
  have factor := fiber.factor_positive positive
  have background := fiber.background_lt_one factor
  have min_lt : minClick effect < 1 := by
    linarith only [(click_bounds effect).2.2, click_gap effect, positive]
  have first_denominator : 0 < 1 - minClick effect := by linarith only [min_lt]
  have second_denominator : 0 < 1 - d := by linarith only [background]
  rw [intrinsic_lower_eq effect positive, efficiency_atomic_product effect atom d k rates realizes]
  apply (div_le_div_iff₀ first_denominator second_denominator).mpr
  have product := mul_nonneg (sub_nonneg.mpr (click_bounds effect).2.2)
    (sub_nonneg.mpr fiber.background_le_min)
  rw [← click_gap effect]
  nlinarith only [product]

theorem individual_lower (effect atom : CompactReadoutEffect) (d k : ℝ)
    (rates : Rates d k) (realizes : Realizes effect d k atom) (positive : 0 < effect.gain) :
    intrinsicLower effect ≤ efficiency d k ∧ intrinsicLower effect ≤ maxAtomic atom := by
  have fiber := realizes_fiber effect atom d k rates realizes
  have detector := efficiency_bounds d k rates (fiber.background_lt_one (fiber.factor_positive positive))
  have atomic := max_atomic_bounds atom
  have product := efficiency_atomic_lower effect atom d k rates realizes positive
  exact ⟨product.trans (by nlinarith only [detector.1, atomic.2]),
    product.trans (by nlinarith only [detector.2, atomic.1])⟩

/-- Polarity-free bounds preserve both possible raw-to-click dictionaries. -/
def domainLower (B G : ℝ) : ℝ := 2 * G / (1 + B + G)

theorem domain_lower_le_intrinsic (effect : CompactReadoutEffect) (B G : ℝ)
    (positive : 0 < G) (gain : G ≤ effect.gain) (bias : |effect.mu| ≤ B) :
    domainLower B G ≤ intrinsicLower effect := by
  have bound := (le_abs_self effect.mu).trans bias
  have nonnegative := (abs_nonneg effect.mu).trans bias
  have denominator : 0 < 1 + B + G := by linarith only [positive, nonnegative]
  have response : 0 < effect.gain := positive.trans_le gain
  apply (div_le_div_iff₀ denominator (intrinsic_denominator_positive effect response)).mpr
  have comparison := mul_le_mul_of_nonneg_left bound positive.le
  have increase := mul_le_mul_of_nonneg_right gain (show 0 ≤ 1 + B by linarith only [nonnegative])
  nlinarith only [comparison, increase]

theorem domain_microhardware_bounds (effect atom : CompactReadoutEffect) (d k B G : ℝ)
    (rates : Rates d k) (realizes : Realizes effect d k atom)
    (positive : 0 < G) (gain : G ≤ effect.gain) (bias : |effect.mu| ≤ B) :
    domainLower B G ≤ efficiency d k * maxAtomic atom ∧ d ≤ (1 + B - G) / 2 := by
  have response : 0 < effect.gain := positive.trans_le gain
  have floor := domain_lower_le_intrinsic effect B G positive gain bias
  have product := efficiency_atomic_lower effect atom d k rates realizes response
  have fiber := realizes_fiber effect atom d k rates realizes
  have lower_bias : -B ≤ effect.mu := by linarith only [neg_le_abs effect.mu, bias]
  constructor
  · exact floor.trans product
  · have background := fiber.background_le_min
    simp only [minClick] at background
    linarith only [background, lower_bias, gain]

/-- An independent forward-response envelope becomes a necessary raw pulse-area bound. -/
theorem domain_area_bound (effect atom : CompactReadoutEffect) (d k B G areaSquared : ℝ)
    (rates : Rates d k) (realizes : Realizes effect d k atom)
    (positive : 0 < G) (gain : G ≤ effect.gain) (bias : |effect.mu| ≤ B)
    (forward : maxAtomic atom ≤ 7 * areaSquared / 4) :
    4 * domainLower B G / 7 ≤ efficiency d k * areaSquared := by
  have hardware := (domain_microhardware_bounds effect atom d k B G rates realizes positive gain bias).1
  have fiber := realizes_fiber effect atom d k rates realizes
  have detector := efficiency_bounds d k rates
    (fiber.background_lt_one (fiber.factor_positive (positive.trans_le gain)))
  have mapped := mul_le_mul_of_nonneg_left forward detector.1
  nlinarith only [hardware, mapped]

/-- Raw atomic/detector caps constrain source response and retain the legal gain ceiling. -/
theorem raw_product_cap_gain (effect atom : CompactReadoutEffect) (d k B cap : ℝ)
    (rates : Rates d k) (realizes : Realizes effect d k atom) (bias : |effect.mu| ≤ B)
    (cap_nonnegative : 0 ≤ cap) (cap_le_one : cap ≤ 1)
    (product_cap : efficiency d k * maxAtomic atom ≤ cap) :
    effect.gain ≤ min 1 ((1 + B) * cap / (2 - cap)) := by
  have nonnegative := (abs_nonneg effect.mu).trans bias
  have denominator : 0 < 2 - cap := by linarith only [cap_le_one]
  refine le_min effect.gain_le_one ?_
  by_cases positive : 0 < effect.gain
  · have source := efficiency_atomic_lower effect atom d k rates realizes positive
    have upper := (div_le_iff₀ (intrinsic_denominator_positive effect positive)).mp
      (source.trans product_cap)
    have bias_cap := mul_le_mul_of_nonneg_left ((le_abs_self effect.mu).trans bias)
      cap_nonnegative
    apply (le_div_iff₀ denominator).mpr
    nlinarith only [upper, bias_cap]
  · have zero : effect.gain = 0 := le_antisymm (le_of_not_gt positive) effect.gain_nonnegative
    rw [zero]
    exact div_nonneg (mul_nonneg (by linarith only [nonnegative]) cap_nonnegative) denominator.le

/-- A forward pulse-area envelope and fragment-efficiency cap generate the gain cap. -/
theorem raw_detector_area_cap (effect atom : CompactReadoutEffect)
    (d k B etaUpper areaSquared areaUpper : ℝ)
    (rates : Rates d k) (realizes : Realizes effect d k atom)
    (background : d < 1) (bias : |effect.mu| ≤ B)
    (eta_nonnegative : 0 ≤ etaUpper) (eta_le_one : etaUpper ≤ 1)
    (eta_cap : efficiency d k ≤ etaUpper) (area_nonnegative : 0 ≤ areaUpper)
    (area_cap : areaSquared ≤ areaUpper) (forward : maxAtomic atom ≤ 7 * areaSquared / 4) :
    effect.gain ≤ min 1 ((1 + B) * (etaUpper * min 1 (7 * areaUpper / 4)) /
      (2 - etaUpper * min 1 (7 * areaUpper / 4))) := by
  have detector := efficiency_bounds d k rates background
  have atomic := max_atomic_bounds atom
  have atom_cap : maxAtomic atom ≤ min 1 (7 * areaUpper / 4) := by
    apply le_min atomic.2
    linarith only [forward, area_cap]
  have clipped_nonnegative : 0 ≤ min 1 (7 * areaUpper / 4) := by
    apply le_min (by norm_num)
    linarith only [area_nonnegative]
  have product_nonnegative := mul_nonneg eta_nonnegative clipped_nonnegative
  have product_le_one : etaUpper * min 1 (7 * areaUpper / 4) ≤ 1 := by
    have bound := mul_le_mul_of_nonneg_left (min_le_left 1 (7 * areaUpper / 4)) eta_nonnegative
    linarith only [bound, eta_le_one]
  have product_cap : efficiency d k * maxAtomic atom ≤
      etaUpper * min 1 (7 * areaUpper / 4) := by
    exact mul_le_mul eta_cap atom_cap atomic.1 eta_nonnegative
  exact raw_product_cap_gain effect atom d k B _ rates realizes bias
    product_nonnegative product_le_one product_cap

/-- With zero detector factor the atom is invisible and the original effect is scalar. -/
theorem zero_factor_iff (effect atom : CompactReadoutEffect) (d : ℝ) :
    Realizes effect d 0 atom ↔ effect.mu = 1 - 2 * d ∧ effect.u = 0 ∧ effect.z = 0 := by
  simp only [Realizes, zero_mul, neg_zero, sub_zero]

theorem zero_gain_scalar (effect : CompactReadoutEffect) (zero : effect.gain = 0) :
    effect.u = 0 ∧ effect.z = 0 := effect.zero_coordinates zero

/-- Zero atomic gain leaves precisely a scalar effect whenever the detector factor is nonzero. -/
theorem zero_gain_atomic_scalar (effect atom : CompactReadoutEffect) (d k : ℝ)
    (factor : 0 < k) (realizes : Realizes effect d k atom) (zero : effect.gain = 0) :
    atom.u = 0 ∧ atom.z = 0 := by
  have gain := realizes_gain effect atom d k factor.le realizes
  have atomic_zero : atom.gain = 0 := by nlinarith only [gain, zero, factor]
  exact atom.zero_coordinates atomic_zero

theorem zero_factor_fiber (effect : CompactReadoutEffect) (d : ℝ) :
    Fiber effect d 0 ↔ effect.gain = 0 ∧ d = (1 - effect.mu) / 2 := by
  constructor
  · intro fiber
    have gap := click_gap effect
    have zero : effect.gain = 0 := by
      linarith only [fiber.factor_lower, fiber.background_le_min, gap, effect.gain_nonnegative]
    refine ⟨zero, ?_⟩
    have upper := fiber.background_le_min
    have lower := fiber.factor_lower
    simp only [minClick, maxClick, zero] at upper lower
    linarith only [upper, lower]
  · rintro ⟨zero, background⟩
    subst d
    constructor
    · linarith only [effect.mu_upper]
    · simp only [minClick, zero, sub_zero, le_refl]
    · simp only [maxClick, zero]
      linarith
    · linarith only [effect.mu_lower]

end
end SaturationMonoid.PhysicsCore.Stage10.Bell.ReadoutDetectorFiber
