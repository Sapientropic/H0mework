theorem reentryRuntime_physical_installed (runtime : LivingRuntimeState reentryRuntimeProcess) :
    type_of% (reentryRuntimeFace_factorizes runtime.tick.next .physical) ∧
    reentryRuntimeFacade.readoutAt runtime.tick.next .physical =
      (.inl ⟨PUnit.unit, (reentrySourceResult.nuclear, reentrySourceResult.nuclear.target, reentrySourceResult.nuclear.targetLedger)⟩ :
        SourceNativeProjectionFiberAt reentryProjectionLaw .physical (reentryEmitted runtime.tick.next.state.current)) := by
  refine ⟨reentryRuntimeFace_factorizes runtime.tick.next .physical, ?_⟩
  rw [← reentryRuntime_response runtime]
  rfl

