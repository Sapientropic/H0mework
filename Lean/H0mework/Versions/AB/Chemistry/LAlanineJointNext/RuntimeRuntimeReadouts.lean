theorem jointRuntime_physical_installed (runtime : LivingRuntimeState jointRuntimeProcess) :
    type_of% (jointRuntimeFace_factorizes runtime.tick.next .physical) ∧
    jointRuntimeFacade.readoutAt runtime.tick.next .physical =
      (.inl ⟨PUnit.unit, (jointSourceResult.nuclear, jointSourceResult.nuclear.target, jointSourceResult.nuclear.targetLedger)⟩ :
        SourceNativeProjectionFiberAt jointProjectionLaw .physical (jointEmitted runtime.tick.next.state.current)) := by
  refine ⟨jointRuntimeFace_factorizes runtime.tick.next .physical, ?_⟩
  rw [← jointRuntime_response runtime]
  rfl

