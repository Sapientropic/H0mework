import H0mework.Versions.R2.Foundation.Cofinal.TemporalAnswer

/-!
# Temporal-root-installed renewal

Operational standing renewal is indexed by one exact finite, cofinal, or
post-cofinal temporal root visit.  The current patch must emit the private
`GeneratedEntryRowAt` selector token for the source responsibility, and the
same temporal whole-ledger write-back must generate an actual successor.

A bare `GeneratedLedgerWriteRowAt`, or even a branch-local patch row, is only
inventory: it can be omitted by the world selector or replayed at a sibling
visit.  Neither can construct the carrier below.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace Renewal

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot

universe u

variable {N : WorldRelationNetwork.{u}}
variable {V : ConstructiveRoot.Vocabulary.{u}}
variable {root : SourceNativeLedgerRootClosure N V}
variable {visit : SourceNativeTemporalVisitAt root}
variable {generated : SourceNativeTemporalVisitGeneratedEvolutionAt root visit}
variable {sourceEntry : OpenResponsibilityAt N
  (root.source.source.toRootSource.account.supportOf
    (root.emitted visit.current))}

/-- Every continuing whole-ledger row preserves exact debt lineage and
semantic claim. -/
def debtLineageOfEvolution
    {sourceSupport targetSupport : N.Support}
    {sourceEntry : OpenResponsibilityAt N sourceSupport}
    {targetEntry : OpenResponsibilityAt N targetSupport}
    (evolution : LedgerEntryEvolutionAt N sourceEntry targetEntry) :
    RootDebtLineageAt N sourceEntry targetEntry := by
  cases evolution with
  | carried support_eq entry_eq =>
      cases support_eq
      cases entry_eq
      exact ⟨rfl, rfl⟩
  | maintained _ _ lineage_eq _ claim_eq _ =>
      exact ⟨lineage_eq, claim_eq⟩
  | transferred _ lineage_eq claim_eq _ =>
      exact ⟨lineage_eq, claim_eq⟩

/-- Operational renewal installed at one exact temporal root visit.

`GeneratedEntryRowAt` is selected by this visit's private current patch.  The
successor token is indexed by the same visit's whole-ledger write-back, so a
faithful terminal cannot masquerade as renewed standing. -/
structure RootInstalledRenewalAt
    (generated : SourceNativeTemporalVisitGeneratedEvolutionAt root visit)
    (sourceEntry : OpenResponsibilityAt N
      (root.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))) : Type (u + 1) where
  private mk ::
  selected : generated.GeneratedEntryRowAt sourceEntry
  successor : SourceNativeLedgerGeneratedSuccessorAt generated.occurrence
    generated.wholeLedgerWriteBack

namespace RootInstalledRenewalAt

/-- Install only the canonical row selected at this exact temporal visit. -/
def install
    (selected : generated.GeneratedEntryRowAt sourceEntry)
    (successor : SourceNativeLedgerGeneratedSuccessorAt generated.occurrence
      generated.wholeLedgerWriteBack) :
    RootInstalledRenewalAt generated sourceEntry :=
  ⟨selected, successor⟩

variable (installed : RootInstalledRenewalAt generated sourceEntry)

/-- Operational standing is the exact target open responsibility generated
by the same temporal whole-ledger transition. -/
def operationalStanding : OpenResponsibilityAt N
    (root.source.source.toRootSource.account.supportOf
      installed.successor.targetOccurrence) :=
  (installed.successor.ledgerEvolution.destination sourceEntry).1

/-- Exact whole-ledger evolution from the source responsibility to the
renewed operational standing. -/
def worldEvolution : LedgerEntryEvolutionAt N sourceEntry
    installed.operationalStanding :=
  (installed.successor.ledgerEvolution.destination sourceEntry).2

/-- Exact lineage and claim carried by this renewal. -/
def debtLineage : RootDebtLineageAt N sourceEntry
    installed.operationalStanding :=
  debtLineageOfEvolution installed.worldEvolution

/-- Renewal cannot refill the exact source-owned progress budget. -/
theorem progressBudget_not_refilled :
    installed.operationalStanding.progressBudget ≤
      sourceEntry.progressBudget :=
  installed.worldEvolution.progressBudget_not_refilled

/-- Exact evolved disposition; it is derived from the temporal whole-ledger
write-back rather than supplied by a domain face. -/
def disposition : LedgerEntryDispositionAt N sourceEntry :=
  LedgerEntryDispositionAt.evolved installed.worldEvolution

/-- Exact temporal row membership generated by this visit's canonical patch
selector.  The source-row constructor remains private in the root kernel. -/
def exactEventMembership : generated.GeneratedEntryRowAt sourceEntry :=
  installed.selected

/-- The selected finite-patch row commutes with the whole world evolution. -/
theorem selected_commutes_with_world :
    installed.selected.sourceRow.CommutesWithWorld :=
  installed.selected.sourceRow.commutes_with_world

end RootInstalledRenewalAt

/-- Independent responsibility consumer for one operational renewal.  It
retains temporal event membership, lineage, disposition and world commuting
in one exact-root package. -/
structure RenewalResponsibilityConsumerAt
    (installed : RootInstalledRenewalAt generated sourceEntry) : Type (u + 1) where
  private mk ::
  temporalMembership : generated.GeneratedEntryRowAt sourceEntry
  lineage : RootDebtLineageAt N sourceEntry installed.operationalStanding
  exactDisposition : LedgerEntryDispositionAt N sourceEntry
  disposition_eq : exactDisposition = installed.disposition
  progressBudget_not_refilled :
    installed.operationalStanding.progressBudget ≤
      sourceEntry.progressBudget
  selectedWorldCommutes : temporalMembership.sourceRow.CommutesWithWorld

namespace RootInstalledRenewalAt

/-- Generate the exact responsibility consumer from the installed temporal
renewal. -/
def responsibilityConsumer
    (installed : RootInstalledRenewalAt generated sourceEntry) :
    RenewalResponsibilityConsumerAt installed where
  temporalMembership := installed.exactEventMembership
  lineage := installed.debtLineage
  exactDisposition := installed.disposition
  disposition_eq := rfl
  progressBudget_not_refilled := installed.progressBudget_not_refilled
  selectedWorldCommutes := installed.selected_commutes_with_world

end RootInstalledRenewalAt

/-- Existential operational-standing carrier at one exact temporal visit and
source responsibility.  No domain standing payload is stored. -/
def RootInstalledStandingAt
    (root : SourceNativeLedgerRootClosure N V)
    (visit : SourceNativeTemporalVisitAt root)
    (sourceEntry : OpenResponsibilityAt N
      (root.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))) : Type (u + 1) :=
  Sigma fun generated : SourceNativeTemporalVisitGeneratedEvolutionAt root visit =>
    RootInstalledRenewalAt generated sourceEntry

/-- If this exact temporal visit emits no canonical selected row for the
responsibility, it cannot renew operational standing. -/
theorem noTemporalSelectedRow_noOperationalStanding
    (noSelected : ∀ generated :
      SourceNativeTemporalVisitGeneratedEvolutionAt root visit,
      generated.GeneratedEntryRowAt sourceEntry → False) :
    RootInstalledStandingAt root visit sourceEntry → False :=
  fun standing => noSelected standing.1 standing.2.selected

/-- If the temporal whole-ledger write-back has no actual successor, no
standing can be renewed, even when a terminal row exists. -/
theorem noTemporalSuccessor_noOperationalStanding
    (noSuccessor : ∀ generated :
      SourceNativeTemporalVisitGeneratedEvolutionAt root visit,
      SourceNativeLedgerGeneratedSuccessorAt generated.occurrence
        generated.wholeLedgerWriteBack → False) :
    RootInstalledStandingAt root visit sourceEntry → False :=
  fun standing => noSuccessor standing.1 standing.2.successor

end Renewal
end Society
end ProcessGame
end SaturationMonoid
