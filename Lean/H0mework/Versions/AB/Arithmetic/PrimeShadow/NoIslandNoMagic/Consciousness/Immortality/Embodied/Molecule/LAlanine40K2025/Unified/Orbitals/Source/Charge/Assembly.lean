def densityAbsoluteSum : ℚ := ∑ b : Basis, rowAbsolute b

theorem recorded_charge_computed :
    (∑ b : Basis, ∑ c : Basis, densityMatrix b c*recordedOverlap b c) = recordedCharge := by
  simp only [recordedCharge,rowCharge_computed,sourceRow]

theorem absolute_sum_computed :
    (∑ b : Basis, ∑ c : Basis, |densityMatrix b c|) = densityAbsoluteSum := by
  simp only [densityAbsoluteSum,rowAbsolute_computed,absoluteRow]

