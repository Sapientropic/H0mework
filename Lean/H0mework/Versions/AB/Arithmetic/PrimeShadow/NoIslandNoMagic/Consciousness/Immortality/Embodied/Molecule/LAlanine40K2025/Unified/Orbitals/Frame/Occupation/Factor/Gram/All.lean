set_option autoImplicit false
set_option maxRecDepth 8192
namespace SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Molecule
namespace LAlanine40K2025.UnifiedOrbitals.Frame.Occupation.Factor.Gram
open Propagation.Interface

theorem upper_entry_bound (i j : OccupiedSlot) (h : i ≤ j) :
    |gramRealError i j| + |gramImagError i j| ≤ gramEntryBound := by
  fin_cases i
  · exact Rows.row0_bound j h
  · exact Rows.row1_bound j h
  · exact Rows.row2_bound j h
  · exact Rows.row3_bound j h
  · exact Rows.row4_bound j h
  · exact Rows.row5_bound j h
  · exact Rows.row6_bound j h
  · exact Rows.row7_bound j h
  · exact Rows.row8_bound j h
  · exact Rows.row9_bound j h
  · exact Rows.row10_bound j h
  · exact Rows.row11_bound j h
  · exact Rows.row12_bound j h
  · exact Rows.row13_bound j h
  · exact Rows.row14_bound j h
  · exact Rows.row15_bound j h
  · exact Rows.row16_bound j h
  · exact Rows.row17_bound j h
  · exact Rows.row18_bound j h
  · exact Rows.row19_bound j h
  · exact Rows.row20_bound j h
  · exact Rows.row21_bound j h
  · exact Rows.row22_bound j h
  · exact Rows.row23_bound j h

theorem all_entry_bound (i j : OccupiedSlot) :
    |gramRealError i j| + |gramImagError i j| ≤ gramEntryBound := by
  rcases le_total i j with h | h
  · exact upper_entry_bound i j h
  · have reverse := upper_entry_bound j i h
    simpa only [real_swap i j,imag_swap i j,abs_neg] using reverse

end LAlanine40K2025.UnifiedOrbitals.Frame.Occupation.Factor.Gram
