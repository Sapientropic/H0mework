import H0mework.Versions.AB.Physics.LowEnergy.AlphaSource.CanonicalPreparationCore
import H0mework.Versions.AB.Physics.LowEnergy.AlphaSource.CanonicalPreparationLocal

/-! Original Number0/Number1 half-density and CAR completion.  Both local
ranges are generated by the same configuration multiplier on their native
cores; the transport does not choose a vector in either range. -/
set_option autoImplicit false
set_option maxHeartbeats 1800000
set_option maxRecDepth 8192
noncomputable section
namespace LowEnergy.CanonicalPreparationCore.Completed
open SourceQuantumGaugeSliceCoordinates SourceQuantumFockGauge
open GaussCoreHilbert GaussDensityCore GaussHalfDensity GaussFockLift
open CanonicalPreparationCreation CanonicalScalarPreparation
open GaussComposite.SourceGraph
open CanonicalGradedSpatial (Localizer)
open MeasureTheory Set Filter
open scoped Topology ContDiff Distributions

abbrev ScalarZero : Type := GaussHistoryHilbert.SectorHilbert 0

def numberRaise : ScalarZero ≃ₗᵢ[ℂ] ScalarSpace :=
  (halfDensityEquiv 0).trans (halfDensityEquiv 1).symm

theorem numberRaise_halfDensity (f : ScalarZero) :
    halfDensityEquiv 1 (numberRaise f)=halfDensityEquiv 0 f :=
  (halfDensityEquiv 1).apply_symm_apply _

def zeroCore : ScalarTest →ₗ[ℂ] ScalarZero where
  toFun := scalarLp 0
  map_add' f g := by
    apply Lp.ext
    filter_upwards [scalarLp_ae 0 (f+g),scalarLp_ae 0 f,scalarLp_ae 0 g,
      Lp.coeFn_add (scalarLp 0 f) (scalarLp 0 g)] with z h hf hg ha
    rw [h,ha,Pi.add_apply,hf,hg]
    rfl
  map_smul' c f := scalarLp_smul 0 c f

theorem zeroCore_dense : DenseRange zeroCore := by
  have dense := OpenChartTestDomain.dense_compact_contDiff_inside
    GaussHistoryHilbert.physicalChart (GaussHistoryHilbert.numberMeasure 0)
      (F := ℂ) (p := 2) (by norm_num)
  apply dense.mono
  rintro f ⟨g,hfg,hgk,hgc,hgs⟩
  let test : ScalarTest := ⟨g,hgc,hgk,hgs⟩
  exact ⟨test,Lp.ext ((scalarLp_ae 0 test).trans hfg.symm)⟩

theorem numberRaise_core (f : ScalarTest) :
    numberRaise (zeroCore f)=scalarCore (numberRaiseCore f) := by
  apply (halfDensityEquiv 1).injective
  rw [numberRaise_halfDensity]
  exact (halfDensity_numberRaiseCore f).symm

theorem raised_core_norm (f : ScalarTest) :
    ‖scalarCore (numberRaiseCore f)‖=‖zeroCore f‖ := by
  rw [←numberRaise_core,numberRaise.norm_map]

private theorem sourceCreated_continuous : Continuous sourceCreated := by
  unfold sourceCreated
  exact (lift sourceCreation).continuous.comp
    (fockHalfDensityEquiv.symm.continuous.comp (slot ∅).continuous)

theorem sourceCreated_N1 (f : ScalarSpace) :
    sourceCreated (halfDensityEquiv 1 f)=seedBase f := by
  refine scalarCore_dense.induction_on f
    (isClosed_eq (sourceCreated_continuous.comp (halfDensityEquiv 1).continuous)
      seedBase.continuous) ?_
  intro g
  rw [seedBase_core]
  exact sourceCreated_N1_core g

theorem sourceCreated_numberRaise (f : ScalarZero) :
    sourceCreated (halfDensityEquiv 0 f)=seedBase (numberRaise f) := by
  rw [←numberRaise_halfDensity,sourceCreated_N1]

theorem zeroCutCore_bound (phi : Localizer) (f : ScalarTest) :
    ‖zeroCore (cutCore phi f)‖≤‖scalarCutoff phi‖*‖zeroCore f‖ := by
  rw [←raised_core_norm,←raised_core_norm]
  have commutes : numberRaiseCore (cutCore phi f)=cutCore phi (numberRaiseCore f) :=
    numberRaiseCore_multiply _ _ f
  rw [commutes,←scalarCutoff_core]
  exact (scalarCutoff phi).le_opNorm _

def zeroCutoff (phi : Localizer) : ScalarZero →L[ℂ] ScalarZero :=
  (zeroCore.comp (cutCore phi)).extendOfNorm zeroCore

theorem zeroCutoff_core (phi : Localizer) (f : ScalarTest) :
    zeroCutoff phi (zeroCore f)=zeroCore (cutCore phi f) :=
  LinearMap.extendOfNorm_eq zeroCore_dense ⟨‖scalarCutoff phi‖,zeroCutCore_bound phi⟩ f

theorem numberRaise_cutoff (phi : Localizer) (f : ScalarZero) :
    numberRaise (zeroCutoff phi f)=scalarCutoff phi (numberRaise f) := by
  refine zeroCore_dense.induction_on f (isClosed_eq (by fun_prop) (by fun_prop)) ?_
  intro g
  rw [zeroCutoff_core,numberRaise_core,numberRaise_core,scalarCutoff_core]
  exact congrArg scalarCore (numberRaiseCore_multiply _ _ g)

theorem numberRaise_symm_cutoff (phi : Localizer) (f : ScalarSpace) :
    numberRaise.symm (scalarCutoff phi f)=zeroCutoff phi (numberRaise.symm f) := by
  apply numberRaise.injective
  rw [numberRaise.apply_symm_apply,numberRaise_cutoff,numberRaise.apply_symm_apply]

def zeroLocalizedSpace (phi : Localizer) : Submodule ℂ ScalarZero :=
  (LinearMap.range (zeroCutoff phi).toLinearMap).topologicalClosure

theorem numberRaise_mem_localized (phi : Localizer) (f : zeroLocalizedSpace phi) :
    numberRaise f.val∈localizedSpace phi := by
  have closed : IsClosed {u : ScalarZero | numberRaise u∈localizedSpace phi} :=
    (LinearMap.range (scalarCutoff phi).toLinearMap).isClosed_topologicalClosure.preimage
      numberRaise.continuous
  apply closure_minimal ?_ closed f.property
  rintro u ⟨v,rfl⟩
  change numberRaise (zeroCutoff phi v)∈localizedSpace phi
  rw [numberRaise_cutoff]
  exact (LinearMap.range (scalarCutoff phi).toLinearMap).le_topologicalClosure
    ⟨numberRaise v,rfl⟩

theorem numberRaise_symm_mem_localized (phi : Localizer) (f : localizedSpace phi) :
    numberRaise.symm f.val∈zeroLocalizedSpace phi := by
  have closed : IsClosed {u : ScalarSpace | numberRaise.symm u∈zeroLocalizedSpace phi} :=
    (LinearMap.range (zeroCutoff phi).toLinearMap).isClosed_topologicalClosure.preimage
      numberRaise.symm.continuous
  apply closure_minimal ?_ closed f.property
  rintro u ⟨v,rfl⟩
  change numberRaise.symm (scalarCutoff phi v)∈zeroLocalizedSpace phi
  rw [numberRaise_symm_cutoff]
  exact (LinearMap.range (zeroCutoff phi).toLinearMap).le_topologicalClosure
    ⟨numberRaise.symm v,rfl⟩

def localizedNumberRaise (phi : Localizer) :
    zeroLocalizedSpace phi ≃ₗᵢ[ℂ] localizedSpace phi where
  toFun f := ⟨numberRaise f.val,numberRaise_mem_localized phi f⟩
  invFun f := ⟨numberRaise.symm f.val,numberRaise_symm_mem_localized phi f⟩
  left_inv f := Subtype.ext (numberRaise.symm_apply_apply f.val)
  right_inv f := Subtype.ext (numberRaise.apply_symm_apply f.val)
  map_add' f g := Subtype.ext (map_add numberRaise f.val g.val)
  map_smul' c f := Subtype.ext (map_smul numberRaise c f.val)
  norm_map' f := numberRaise.norm_map f.val

def zeroLocalizedProfile (phi : Localizer) : zeroLocalizedSpace phi →L[ℂ] Profile :=
  (localizedProfile phi).comp
    (localizedNumberRaise phi).toContinuousLinearEquiv.toContinuousLinearMap

theorem zeroLocalized_sourceCreated (phi : Localizer) (f : zeroLocalizedSpace phi) :
    prepared (zeroLocalizedProfile phi f)=sourceCreated (halfDensityEquiv 0 f.val) := by
  change prepared (localizedProfile phi (localizedNumberRaise phi f))=_
  rw [localized_prepared,sourceCreated_numberRaise]
  rfl

theorem zeroLocalized_physical_norm (phi : Localizer) (f : zeroLocalizedSpace phi) :
    ‖prepared (zeroLocalizedProfile phi f)‖=‖f‖ := by
  change ‖prepared (localizedProfile phi (localizedNumberRaise phi f))‖=_
  rw [localized_physical_norm,(localizedNumberRaise phi).norm_map]

theorem zeroLocalized_unit (phi : Localizer) (f : zeroLocalizedSpace phi) (unit : ‖f‖=1) :
    ‖prepared (zeroLocalizedProfile phi f)‖=1 := by
  rw [zeroLocalized_physical_norm,unit]

theorem zeroLocalized_eight_legs (phi : Localizer) (f : zeroLocalizedSpace phi)
    (addition : Bool) (a s : Fin 2) :
    ‖completedLeg addition a s (zeroLocalizedProfile phi f)‖≤
      legBound*localBound (outerCutoff phi)*‖f‖ := by
  exact (localized_eight_legs phi (localizedNumberRaise phi f) addition a s).trans_eq
    (by rw [(localizedNumberRaise phi).norm_map])

end LowEnergy.CanonicalPreparationCore.Completed
