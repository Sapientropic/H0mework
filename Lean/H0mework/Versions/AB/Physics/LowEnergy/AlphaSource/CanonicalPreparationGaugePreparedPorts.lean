section ActionWeight
open scoped Matrix Matrix.Norms.L2Operator Distributions
local instance : DecidableEq Quantum.Index := Classical.decEq _
local instance : DecidableEq Mode := Classical.decEq _
attribute [local instance] SourceRealScalarFock.branchOrder
local instance : NormedAlgebra ℝ SourceMatrix := NormedAlgebra.restrictScalars ℝ ℂ _
local instance : NormedAddCommGroup LorentzianCoframe := Matrix.normedAddCommGroup
local instance : SeminormedAddCommGroup LorentzianCoframe := Matrix.seminormedAddCommGroup
local instance : NormedSpace ℝ LorentzianCoframe := Matrix.normedSpace
local instance : FiniteDimensional ℂ SourceMatrix := Matrix.finiteDimensional
local instance : FiniteDimensional ℂ FullMatrix := Matrix.finiteDimensional

def densityActionMatrix : SourceMatrix :=
  (4*(Stage9C.Material.SpinPair.spinScale:ℂ)) • Quantum.operatorMatrix YangMills.FullPairing.flipMatter

def oppositeDual : FullMatrix := Matrix.fromBlocks 1 0 0 (-1)

def rawFourier (p : PhysicalMomentum) : (Fin 4→SourceMatrix) →ₗ[ℝ] FullMatrix where
  toFun A:=oppositeDual*fourierLinear p A
  map_add' A B:=by rw [map_add,mul_add]
  map_smul' r A:=by rw [map_smul,mul_smul_comm,RingHom.id_apply]

def rawStateFiber (f : Field289) (p : PhysicalMomentum) (s : ActionState) : FiberMap :=
  quantizer (rawFourier p (fun i=>densityActionMatrix*densityVariation f s i))

def inversePhase (s : ActionState) : SourceMatrix :=
  (-Complex.I*stateVolume s) • CoframeResponse.principalMatrix s.1

def sourceActionWeight (s : ActionState) : FullMatrix :=
  SourceRealScalarFock.branches ((Stage9C.Material.SpinPair.spinScale:ℂ) •
    (Quantum.operatorMatrix YangMills.FullPairing.flipMatter*inversePhase s))

theorem inversePhase_source (s : ActionState) (nondegenerate : s.1.det≠0)
    (regular : StageNineCurrentCoframeMatterTemporalPrincipal.coframeTemporalPrincipalScalar s.1≠0) :
    inversePhase s*statePhase s=1 := by
  have volume : stateVolume s≠0 := Complex.ofReal_ne_zero.mpr (abs_ne_zero.mpr nondegenerate)
  have factor : (-Complex.I*stateVolume s)*(Complex.I*(stateVolume s)⁻¹)=1 := by
    calc
      _= -(Complex.I*Complex.I)*(stateVolume s*(stateVolume s)⁻¹) := by ring
      _=1 := by rw [Complex.I_mul_I,mul_inv_cancel₀ volume]; norm_num
  rw [inversePhase,statePhase,smul_mul_smul,
    Ring.mul_inverse_cancel _ (principalMatrix_regular s.1 regular),factor,one_smul]

theorem raw_source_weight (f : Field289) (p : PhysicalMomentum) (s : ActionState)
    (nondegenerate : s.1.det≠0)
    (regular : StageNineCurrentCoframeMatterTemporalPrincipal.coframeTemporalPrincipalScalar s.1≠0) :
    rawFourier p (fun i=>densityActionMatrix*densityVariation f s i)=
      (4:ℂ) • (sourceActionWeight s*fourierLinear p (fun i=>statePhase s*densityVariation f s i)) := by
  have entry (q : PhysicalMomentum) :
      affineMatrix (fun i=>densityActionMatrix*densityVariation f s i) q=
        (4:ℂ) • (((Stage9C.Material.SpinPair.spinScale:ℂ) •
          (Quantum.operatorMatrix YangMills.FullPairing.flipMatter*inversePhase s))*
            affineMatrix (fun i=>statePhase s*densityVariation f s i) q) := by
    simp only [affineMatrix,densityActionMatrix,mul_add,Finset.mul_sum,mul_smul_comm,
      smul_mul_assoc,Finset.smul_sum,smul_add,smul_smul]
    have term (M : SourceMatrix) :
        (Quantum.operatorMatrix YangMills.FullPairing.flipMatter*inversePhase s)*(statePhase s*M)=
          Quantum.operatorMatrix YangMills.FullPairing.flipMatter*M := by
      rw [mul_assoc,←mul_assoc (inversePhase s),inversePhase_source s nondegenerate regular,one_mul]
    simp only [term]
    congr 1
    apply Finset.sum_congr rfl
    intro j _
    congr 1
    ring
  change oppositeDual*realFourierMatrix _ p=(4:ℂ) • (sourceActionWeight s*realFourierMatrix _ p)
  rw [realFourierMatrix,realFourierMatrix,entry p,entry (-p)]
  simp only [oppositeDual,sourceActionWeight,SourceRealScalarFock.branches]
  rw [Matrix.fromBlocks_multiply,Matrix.fromBlocks_multiply]
  ext u v
  cases u <;> cases v <;>
    simp [Matrix.map_apply,Matrix.smul_apply,Matrix.mul_apply,Finset.mul_sum,Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro x _
  apply Finset.sum_congr rfl
  intro y _
  simp only [map_ofNat]
  ring

theorem rawStateFiber_smooth (f : Field289) (p : PhysicalMomentum) (s : ActionState)
    (nondegenerate : s.1.det≠0)
    (regular : StageNineCurrentCoframeMatterTemporalPrincipal.coframeTemporalPrincipalScalar s.1≠0) :
    ContDiffAt ℝ ∞ (rawStateFiber f p) s := by
  have coefficients : ContDiffAt ℝ ∞ (fun w=>fun i=>densityActionMatrix*densityVariation f w i) s :=
    contDiffAt_pi.mpr (fun i=>contDiffAt_const.mul (densityVariation_smooth f s nondegenerate regular i))
  exact (quantizer.toContinuousLinearMap.restrictScalars ℝ).contDiff.contDiffAt.comp s
    ((rawFourier p).toContinuousLinearMap.contDiff.contDiffAt.comp s coefficients)

def rawContactFiber (f g : Field289) (p : PhysicalMomentum) (z : SourceCoordinateSlice) : FiberMap :=
  fderiv ℝ (rawStateFiber f p) (sourceState z) (fieldDirection g)

theorem raw_contact_source (f g : Field289) (p : PhysicalMomentum) (z : physicalChart) :
    rawContactFiber f g p z.val=quantizer (rawFourier p (fun i=>densityActionMatrix*
      (densitySecond f g (sourceState z.val) i+shellSecond f g (sourceState z.val) i))) := by
  have path : HasDerivAt (fun t : ℝ=>sourceState z.val+t • fieldDirection g) (fieldDirection g) 0 := by
    convert! ((hasDerivAt_id (0:ℝ)).smul_const (fieldDirection g)).const_add (sourceState z.val) using 1
    simp
  have direct:=((rawStateFiber_smooth f p (sourceState z.val) (coframe_nondegenerate z)
    (CanonicalGradedSpatialSource.temporal_noncharacteristic z)).differentiableAt (by simp)).hasFDerivAt
  have first:=direct.comp_hasDerivAt_of_eq 0 path (by simp)
  have coefficients : HasDerivAt (fun t : ℝ=>fun i=>densityActionMatrix*
      densityVariation f (sourceState z.val+t • fieldDirection g) i)
      (fun i=>densityActionMatrix*(densitySecond f g (sourceState z.val) i+shellSecond f g (sourceState z.val) i)) 0 :=
    hasDerivAt_pi.mpr (fun i=>(actual_mixed_family_generated f g z i).const_mul densityActionMatrix)
  let Q : (Fin 4→SourceMatrix) →L[ℝ] FiberMap :=
    (quantizer.toContinuousLinearMap.restrictScalars ℝ).comp (rawFourier p).toContinuousLinearMap
  exact first.unique (Q.hasFDerivAt.comp_hasDerivAt 0 coefficients)

def rawMode (contact : Bool) (f g : Field289) (p : PhysicalMomentum) (z : SourceCoordinateSlice) : FiberMap :=
  if contact then rawContactFiber f g p z else rawStateFiber f p (sourceState z)

theorem rawMode_smooth (contact : Bool) (f g : Field289) (p : PhysicalMomentum) (z : physicalChart) :
    ContDiffAt ℝ ∞ (rawMode contact f g p) z.val := by
  have native:=rawStateFiber_smooth f p (sourceState z.val) (coframe_nondegenerate z)
    (CanonicalGradedSpatialSource.temporal_noncharacteristic z)
  cases contact
  · exact native.comp z.val sourceState_smooth.contDiffAt
  · exact ((native.fderiv_right (m:=∞) (by simp)).clm_apply contDiffAt_const).comp
      z.val sourceState_smooth.contDiffAt

theorem rawMode_weights (contact : Bool) (f g : Field289) (p : PhysicalMomentum) (z : physicalChart)
    (w : ℕ→ℂ) : Commute (GaussFockWeights.weight w) (rawMode contact f g p z.val) := by
  cases contact
  · exact weight_commute w _
  · change Commute _ (rawContactFiber f g p z.val)
    rw [raw_contact_source f g p z]
    exact weight_commute w _

def rawLocalized (contact : Bool) (f g : Field289) (p : PhysicalMomentum) (phi : Localizer)
    (z : SourceCoordinateSlice) : FiberMap := (phi z:ℂ) • rawMode contact f g p z

theorem rawLocalized_zero (contact : Bool) (f g : Field289) (p : PhysicalMomentum) (phi : Localizer)
    (z : SourceCoordinateSlice) (outside : z∉tsupport phi) : rawLocalized contact f g p phi z=0 := by
  rw [rawLocalized,image_eq_zero_of_notMem_tsupport outside,Complex.ofReal_zero]
  apply ContinuousLinearMap.ext
  intro v
  exact zero_smul ℂ (rawMode contact f g p z v)

theorem rawLocalized_support (contact : Bool) (f g : Field289) (p : PhysicalMomentum) (phi : Localizer) :
    tsupport (rawLocalized contact f g p phi)⊆tsupport phi := by
  apply closure_minimal _ isClosed_closure
  intro z hz
  by_contra outside
  exact hz (rawLocalized_zero contact f g p phi z outside)

theorem rawLocalized_smooth (contact : Bool) (f g : Field289) (p : PhysicalMomentum) (phi : Localizer) :
    ContDiff ℝ ∞ (rawLocalized contact f g p phi) := by
  rw [contDiff_iff_contDiffAt]
  intro z
  by_cases inside : z∈tsupport phi
  · exact (Complex.ofRealCLM.contDiff.contDiffAt.comp z phi.contDiff.contDiffAt).smul
      (rawMode_smooth contact f g p ⟨z,phi.tsupport_subset inside⟩)
  · apply (contDiffAt_const (c:=(0:FiberMap))).congr_of_eventuallyEq
    filter_upwards [(isClosed_tsupport phi).isOpen_compl.mem_nhds inside] with w hw
    exact rawLocalized_zero contact f g p phi w hw

def rawTest (contact : Bool) (f g : Field289) (p : PhysicalMomentum) (phi : Localizer) :
    𝓓(physicalChart,FiberMap) where
  toFun:=rawLocalized contact f g p phi
  contDiff':=rawLocalized_smooth contact f g p phi
  hasCompactSupport':=phi.hasCompactSupport.of_isClosed_subset isClosed_closure (rawLocalized_support contact f g p phi)
  tsupport_subset':=(rawLocalized_support contact f g p phi).trans phi.tsupport_subset

def rawPrice (contact : Bool) (f g : Field289) (p : PhysicalMomentum) (phi : Localizer) : ℝ :=
  ‖(rawTest contact f g p phi:BoundedContinuousFunction SourceCoordinateSlice FiberMap)‖

theorem rawPointBound (contact : Bool) (f g : Field289) (p : PhysicalMomentum) (phi : Localizer)
    (z : SourceCoordinateSlice) (v : FockFiber) :
    ‖rawLocalized contact f g p phi z v‖≤rawPrice contact f g p phi*‖v‖ :=
  ((rawLocalized contact f g p phi z).le_opNorm v).trans (mul_le_mul_of_nonneg_right
    ((rawTest contact f g p phi:BoundedContinuousFunction SourceCoordinateSlice FiberMap).norm_coe_le_norm z) (norm_nonneg v))

def rawGauss (contact : Bool) (f g : Field289) (p : PhysicalMomentum) (phi : Localizer) : H →L[ℂ] H :=
  GaussBoundedMultiplier.extension (rawLocalized contact f g p phi)
    (fun _=>(rawLocalized_smooth contact f g p phi).contDiffAt)
    (fun z w=>(rawMode_weights contact f g p z w).smul_right (phi z:ℂ))
    (rawPrice contact f g p phi) (by exact norm_nonneg (rawTest contact f g p phi :
      BoundedContinuousFunction SourceCoordinateSlice FiberMap)) (fun z=>rawPointBound contact f g p phi z.val)

theorem rawGauss_core (contact : Bool) (f g : Field289) (p : PhysicalMomentum) (phi : Localizer) (u : QuantumTest) :
    rawGauss contact f g p phi (embed u)=embed (localMultiplier (rawLocalized contact f g p phi)
      (fun _=>(rawLocalized_smooth contact f g p phi).contDiffAt) u) :=
  by unfold rawGauss; exact GaussBoundedMultiplier.extension_core _ _ _ _ _ _ u

end ActionWeight

abbrev FieldOp := H →L[ℂ] H
local instance : NormedAlgebra ℝ FieldOp := NormedAlgebra.restrictScalars ℝ ℂ _
structure SourceJet (E : Type*) where
  value : E
  first : E
  second : E

def jetMul (a b : SourceJet FieldOp) : SourceJet FieldOp :=
  ⟨a.value*b.value,a.first*b.value+a.value*b.first,
    a.second*b.value+a.first*b.first+(a.first*b.first+a.value*b.second)⟩
def jetConst (A : FieldOp) : SourceJet FieldOp := ⟨A,0,0⟩
def jetSub (a b : SourceJet FieldOp) : SourceJet FieldOp :=
  ⟨a.value-b.value,a.first-b.first,a.second-b.second⟩
def jetScale (c : ℂ) (a : SourceJet FieldOp) : SourceJet FieldOp :=
  ⟨c • a.value,c • a.first,c • a.second⟩
def HasSourceJets {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (j : ℝ→SourceJet E) (r : ℝ) : Prop :=
  HasDerivAt (fun t=>(j t).value) (j r).first r ∧
    HasDerivAt (fun t=>(j t).first) (j r).second r

private theorem jetMul_generated (a b : ℝ→SourceJet FieldOp) (r : ℝ)
    (ha : HasSourceJets a r) (hb : HasSourceJets b r) :
    HasSourceJets (fun t=>jetMul (a t) (b t)) r :=
  ⟨ha.1.mul hb.1,(ha.2.mul hb.1).add (ha.1.mul hb.2)⟩
private theorem jetConst_generated (A : FieldOp) (r : ℝ) : HasSourceJets (fun _=>jetConst A) r :=
  ⟨hasDerivAt_const r A,hasDerivAt_const r 0⟩

def timeJet (C : FieldOp) (rate shift r : ℝ) : SourceJet FieldOp :=
  let U:=SourceFiniteUnitary.time C (rate*r+shift)
  let G:=(-Complex.I) • C
  ⟨U,rate • (U*G),rate • ((rate • (U*G))*G)⟩

private theorem affine_time_derivative {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] (C : E →L[ℂ] E) (rate shift r : ℝ) :
    HasDerivAt (fun t : ℝ=>SourceFiniteUnitary.time C (rate*t+shift))
      (rate • (SourceFiniteUnitary.time C (rate*r+shift)*((-Complex.I) • C))) r := by
  let : NormedAlgebra ℝ (E →L[ℂ] E) := NormedAlgebra.restrictScalars ℝ ℂ _
  have path : HasDerivAt (fun t : ℝ=>rate*t+shift) rate r := by
    convert! ((hasDerivAt_id r).const_mul rate).add_const shift using 1
    simp
  have original : HasDerivAt (SourceFiniteUnitary.time C)
      (SourceFiniteUnitary.time C (rate*r+shift)*((-Complex.I) • C)) (rate*r+shift) :=
    hasDerivAt_exp_smul_const ((-Complex.I) • C) (rate*r+shift)
  exact original.scomp r path

private theorem timeJet_generated (C : FieldOp) (rate shift r : ℝ) :
    HasSourceJets (timeJet C rate shift) r := by
  have ht:=affine_time_derivative C rate shift r
  exact ⟨ht,(ht.mul_const ((-Complex.I) • C)).const_smul rate⟩

def wordJet (Co Cm Ci A B : FieldOp) (ao bo am bm ai bi r : ℝ) : SourceJet FieldOp :=
  jetMul (jetMul (jetMul (jetMul (timeJet Co ao bo r) (jetConst A)) (timeJet Cm am bm r))
    (jetConst B)) (timeJet Ci ai bi r)

private theorem wordJet_generated (Co Cm Ci A B : FieldOp) (ao bo am bm ai bi r : ℝ) :
    HasSourceJets (wordJet Co Cm Ci A B ao bo am bm ai bi) r :=
  jetMul_generated _ _ r (jetMul_generated _ _ r (jetMul_generated _ _ r
    (jetMul_generated _ _ r (timeJet_generated Co ao bo r) (jetConst_generated A r))
      (timeJet_generated Cm am bm r)) (jetConst_generated B r)) (timeJet_generated Ci ai bi r)

structure SourceResponsePoint where
  epsilon : ℝ
  precision : 0<epsilon
  cut : ℕ
  phi : Localizer
  psi : Localizer
  p : PhysicalMomentum
  k : PhysicalMomentum
  ell : PhysicalMomentum
  age : ℝ
  left : Bool
  right : Bool
  lc : Fin 2
  ls : Fin 2
  rc : Fin 2
  rs : Fin 2

def generator (q : SourceResponsePoint) (F : Index) (p : PhysicalMomentum) : FieldOp :=
  CanonicalPhysicalSpatial.compression p F+FullYSourceCutoffVolterra.cutoff q.cut

def kernelJet (q : SourceResponsePoint) (F : Index) (a b : Fin 97) (r : ℝ) : SourceJet FieldOp :=
  let f:=sourceFieldUnit a
  let g:=sourceFieldUnit b
  let forward:=wordJet (generator q F (q.p+q.k+q.ell)) (generator q F (q.p+q.ell)) (generator q F q.p)
    (localizedGauss f (q.p+q.ell) q.phi) (localizedGauss g q.p q.psi) (-1) (-q.age) 1 0 0 q.age r
  let reverse:=wordJet (generator q F (q.p+q.k+q.ell)) (generator q F (q.p+q.k)) (generator q F q.p)
    (localizedGauss g (q.p+q.k) q.psi) (localizedGauss f q.p q.phi) 0 (-q.age) (-1) 0 1 q.age r
  jetScale (-Complex.I) (jetSub reverse forward)

def directContactJet (q : SourceResponsePoint) (F : Index) (a b : Fin 97) (r : ℝ) : SourceJet FieldOp :=
  jetMul (jetMul (timeJet (generator q F (q.p+q.k+q.ell)) (-1) (-q.age) r)
    (jetConst (contactGauss (sourceFieldUnit a) (sourceFieldUnit b) q.p (contactLocalizer q.phi q.psi))))
      (timeJet (generator q F q.p) 1 q.age r)

theorem kernelJet_generated (q : SourceResponsePoint) (F : Index) (a b : Fin 97) (r : ℝ) :
    HasSourceJets (kernelJet q F a b) r := by
  have hL:=wordJet_generated (generator q F (q.p+q.k+q.ell)) (generator q F (q.p+q.ell)) (generator q F q.p)
    (localizedGauss (sourceFieldUnit a) (q.p+q.ell) q.phi) (localizedGauss (sourceFieldUnit b) q.p q.psi)
      (-1) (-q.age) 1 0 0 q.age r
  have hR:=wordJet_generated (generator q F (q.p+q.k+q.ell)) (generator q F (q.p+q.k)) (generator q F q.p)
    (localizedGauss (sourceFieldUnit b) (q.p+q.k) q.psi) (localizedGauss (sourceFieldUnit a) q.p q.phi)
      0 (-q.age) (-1) 0 1 q.age r
  constructor
  · convert! (hR.1.sub hL.1).const_smul (-Complex.I) using 1
  · convert! (hR.2.sub hL.2).const_smul (-Complex.I) using 1

theorem directContactJet_generated (q : SourceResponsePoint) (F : Index) (a b : Fin 97) (r : ℝ) :
    HasSourceJets (directContactJet q F a b) r :=
  jetMul_generated _ _ r (jetMul_generated _ _ r
    (timeJet_generated _ _ _ _) (jetConst_generated _ _)) (timeJet_generated _ _ _ _)

theorem kernelJet_original (q : SourceResponsePoint) (F : Index) (a b : Fin 97) (r : ℝ) :
    (kernelJet q F a b r).value=actualKernel q.cut F (sourceFieldUnit a) (sourceFieldUnit b)
      q.phi q.psi q.p q.k q.ell (q.age+r) q.age := by
  rw [actualKernel_generated]
  have exchange : q.p+q.ell+q.k=q.p+q.k+q.ell := by abel
  have out : -r+-q.age= -(q.age+r) := by ring
  have middle : q.age+r-q.age=r := by ring
  have reverse : q.age-(q.age+r)= -r := by ring
  have incoming : r+q.age=q.age+r := by ring
  simp only [kernelJet,jetScale,jetSub,wordJet,jetMul,jetConst,timeJet,
    finiteKernel,orderedField,generator,neg_one_mul,zero_mul,zero_add,one_mul,add_zero,exchange,
    out,middle,reverse,incoming]

theorem directContactJet_original (q : SourceResponsePoint) (F : Index) (a b : Fin 97) (r : ℝ) :
    (directContactJet q F a b r).value=finiteContact q.cut F (sourceFieldUnit a) (sourceFieldUnit b)
      (contactLocalizer q.phi q.psi) q.p q.k q.ell (q.age+r) := by
  have out : -r+-q.age= -(q.age+r) := by ring
  have incoming : r+q.age=q.age+r := by ring
  simp only [directContactJet,jetMul,jetConst,timeJet,finiteContact,generator,neg_one_mul,one_mul,out,incoming]

def rawKernelJet (q : SourceResponsePoint) (F : Index) (a b : Fin 97) (r : ℝ) : SourceJet FieldOp :=
  let f:=sourceFieldUnit a
  let g:=sourceFieldUnit b
  let forward:=wordJet (generator q F (q.p+q.k+q.ell)) (generator q F (q.p+q.ell)) (generator q F q.p)
    (rawGauss false f g (q.p+q.ell) q.phi) (localizedGauss g q.p q.psi) (-1) (-q.age) 1 0 0 q.age r
  let reverse:=wordJet (generator q F (q.p+q.k+q.ell)) (generator q F (q.p+q.k)) (generator q F q.p)
    (localizedGauss g (q.p+q.k) q.psi) (rawGauss false f g q.p q.phi) 0 (-q.age) (-1) 0 1 q.age r
  jetScale (-Complex.I) (jetSub reverse forward)

def rawContactJet (q : SourceResponsePoint) (F : Index) (a b : Fin 97) (r : ℝ) : SourceJet FieldOp :=
  jetMul (jetMul (timeJet (generator q F (q.p+q.k+q.ell)) (-1) (-q.age) r)
    (jetConst (rawGauss true (sourceFieldUnit a) (sourceFieldUnit b) q.p (contactLocalizer q.phi q.psi))))
      (timeJet (generator q F q.p) 1 q.age r)

theorem rawKernelJet_generated (q : SourceResponsePoint) (F : Index) (a b : Fin 97) (r : ℝ) :
    HasSourceJets (rawKernelJet q F a b) r := by
  have hL:=wordJet_generated (generator q F (q.p+q.k+q.ell)) (generator q F (q.p+q.ell)) (generator q F q.p)
    (rawGauss false (sourceFieldUnit a) (sourceFieldUnit b) (q.p+q.ell) q.phi) (localizedGauss (sourceFieldUnit b) q.p q.psi)
      (-1) (-q.age) 1 0 0 q.age r
  have hR:=wordJet_generated (generator q F (q.p+q.k+q.ell)) (generator q F (q.p+q.k)) (generator q F q.p)
    (localizedGauss (sourceFieldUnit b) (q.p+q.k) q.psi) (rawGauss false (sourceFieldUnit a) (sourceFieldUnit b) q.p q.phi)
      0 (-q.age) (-1) 0 1 q.age r
  constructor
  · convert! (hR.1.sub hL.1).const_smul (-Complex.I) using 1
  · convert! (hR.2.sub hL.2).const_smul (-Complex.I) using 1

theorem rawContactJet_generated (q : SourceResponsePoint) (F : Index) (a b : Fin 97) (r : ℝ) :
    HasSourceJets (rawContactJet q F a b) r :=
  jetMul_generated _ _ r (jetMul_generated _ _ r
    (timeJet_generated _ _ _ _) (jetConst_generated _ _)) (timeJet_generated _ _ _ _)

def sourcePairRead (q : SourceResponsePoint) : FieldOp →L[ℂ] ℂ :=
  ((innerSL ℂ (completedLeg q.left q.lc q.ls (sourceProfile q.epsilon q.precision))).comp
      (ContinuousLinearMap.apply ℂ H (completedLeg q.right q.rc q.rs (sourceProfile q.epsilon q.precision))))

def readJet (q : SourceResponsePoint) (j : SourceJet FieldOp) : SourceJet ℂ :=
  ⟨sourcePairRead q j.value,sourcePairRead q j.first,sourcePairRead q j.second⟩
def actionJet (q : SourceResponsePoint) (F : Index) (contact : Bool) (a b : Fin 97) (r : ℝ) : SourceJet ℂ :=
  readJet q (if contact then rawContactJet q F a b r else rawKernelJet q F a b r)

theorem actual_action_jets (q : SourceResponsePoint) (F : Index) (contact : Bool) (a b : Fin 97) (r : ℝ) :
    HasSourceJets (actionJet q F contact a b) r := by
  have native : HasSourceJets (fun t=>if contact then rawContactJet q F a b t else rawKernelJet q F a b t) r := by
    cases contact
    · exact rawKernelJet_generated q F a b r
    · exact rawContactJet_generated q F a b r
  constructor
  · convert! (sourcePairRead q).restrictScalars ℝ |>.hasFDerivAt.comp_hasDerivAt r native.1 using 1
  · convert! (sourcePairRead q).restrictScalars ℝ |>.hasFDerivAt.comp_hasDerivAt r native.2 using 1

def jetEntry (j : SourceJet ℂ) : Fin 3→ℂ := ![j.value,j.first,j.second]

def portValue {n : ℕ} (entries : List (SourcePortEntry n)) (jets : Fin 97→Fin 3→ℂ) (row : Fin n) : ℂ :=
  entries.foldr (fun e total=>if row=e.1 then e.2.2.2*jets e.2.1 e.2.2.1+total else total) 0

def physicalSpatial (q : SourceResponsePoint) : Fin 3→ℂ := fun i=>Complex.I*(q.k i:ℂ)

def originalPortJets (q : SourceResponsePoint) (F : Index) (contact : Bool) (b : Fin 97) (r : ℝ) :
    (Fin 79→ℂ) × (Fin 24→ℂ) × (Fin 9→ℂ) × (Fin 289→ℂ) :=
  let j:=fun a=>jetEntry (actionJet q F contact a b r)
  (portValue (canonicalPorts (physicalSpatial q)) j,
   portValue (dualPorts (physicalSpatial q)) j,
   portValue (compatibilityPorts (physicalSpatial q)) j,
   portValue (auxiliaryContactPorts (physicalSpatial q)) j)

-- Original one-sided p0 and p0² co-sources: values are generated by the actual kernel above.
def initialCoSource (lambda : ℂ) (j : SourceJet ℂ) : Fin 3→ℂ := ![0,j.value,lambda*j.value+j.first]
def initialPortCoSource (q : SourceResponsePoint) (F : Index) (contact : Bool) (b : Fin 97) (lambda : ℂ) :
    (Fin 79→ℂ) × (Fin 24→ℂ) × (Fin 9→ℂ) × (Fin 289→ℂ) :=
  let j:=fun a=>initialCoSource lambda (actionJet q F contact a b 0)
  (portValue (canonicalPorts (physicalSpatial q)) j,
   portValue (dualPorts (physicalSpatial q)) j,
   portValue (compatibilityPorts (physicalSpatial q)) j,
   portValue (auxiliaryContactPorts (physicalSpatial q)) j)

def laplaceWeight (lambda : ℂ) (t : ℝ) : ℂ := Complex.exp (-lambda*t)

private theorem weight_derivative (lambda : ℂ) (t : ℝ) :
    HasDerivAt (laplaceWeight lambda) (-lambda*laplaceWeight lambda t) t := by
  unfold laplaceWeight
  convert! (((Complex.ofRealCLM.hasFDerivAt).hasDerivAt.const_mul (-lambda)).cexp) using 1
  simp [Complex.ofRealCLM]
  ring

private theorem weighted_boundary_derivative (j : ℝ→SourceJet ℂ) (lambda : ℂ) (t : ℝ)
    (h : HasSourceJets j t) (n : Fin 3) :
    HasDerivAt (fun r=>laplaceWeight lambda r*initialCoSource lambda (j r) n)
      (laplaceWeight lambda t*(jetEntry (j t) n-lambda^n.val*(j t).value)) t := by
  fin_cases n
  · simpa [initialCoSource,jetEntry] using hasDerivAt_const t (0:ℂ)
  · have H:=(weight_derivative lambda t).mul h.1
    change HasDerivAt (fun r=>laplaceWeight lambda r*(j r).value)
      (laplaceWeight lambda t*((j t).first-lambda^1*(j t).value)) t
    convert! H using 1
    ring
  · have H:=(weight_derivative lambda t).mul ((h.1.const_mul lambda).add h.2)
    change HasDerivAt (fun r=>laplaceWeight lambda r*(lambda*(j r).value+(j r).first))
      (laplaceWeight lambda t*((j t).second-lambda^2*(j t).value)) t
    convert! H using 1
    change _=(-lambda*laplaceWeight lambda t*(lambda*(j t).value+(j t).first)+
      laplaceWeight lambda t*(lambda*(j t).first+(j t).second))
    ring

theorem actual_green_boundary (q : SourceResponsePoint) (F : Index) (contact : Bool)
    (a b : Fin 97) (lambda : ℂ) (t : ℝ) (n : Fin 3) :
    HasDerivAt (fun r=>laplaceWeight lambda r*initialCoSource lambda (actionJet q F contact a b r) n)
      (laplaceWeight lambda t*(jetEntry (actionJet q F contact a b t) n-
        lambda^n.val*(actionJet q F contact a b t).value)) t :=
  weighted_boundary_derivative _ lambda t (actual_action_jets q F contact a b t) n

inductive EquationPort where
  | canonical | independentDual | compatibility | auxiliaryContact

def EquationPort.rows : EquationPort→ℕ
  | .canonical=>79 | .independentDual=>24 | .compatibility=>9 | .auxiliaryContact=>289

def EquationPort.entries (port : EquationPort) (p : Fin 3→ℂ) : List (SourcePortEntry port.rows) :=
  match port with
  | .canonical=>canonicalPorts p
  | .independentDual=>dualPorts p
  | .compatibility=>compatibilityPorts p
  | .auxiliaryContact=>auxiliaryContactPorts p

private theorem port_derivative {n : ℕ} (entries : List (SourcePortEntry n))
    (f df : Fin 97→Fin 3→ℝ→ℂ) (t : ℝ)
    (h : ∀ a d,HasDerivAt (f a d) (df a d t) t) (row : Fin n) :
    HasDerivAt (fun r=>portValue entries (fun a d=>f a d r) row)
      (portValue entries (fun a d=>df a d t) row) t := by
  induction entries with
  | nil=>exact hasDerivAt_const t 0
  | cons e es ih=>
    by_cases hr : row=e.1
    · simp only [portValue,List.foldr_cons,if_pos hr]
      convert! ((h e.2.1 e.2.2.1).const_mul e.2.2.2).add ih using 1
    · simpa only [portValue,List.foldr_cons,if_neg hr] using ih

/-- The actual four source-port tables consume both generated time jets and their
one-sided Green co-sources; the nine compatibility rows remain present. -/
theorem original_ports_green_boundary (port : EquationPort) (q : SourceResponsePoint)
    (F : Index) (contact : Bool) (b : Fin 97) (lambda : ℂ) (t : ℝ) (row : Fin port.rows) :
    HasDerivAt (fun r=>portValue (port.entries (physicalSpatial q))
      (fun a d=>laplaceWeight lambda r*initialCoSource lambda (actionJet q F contact a b r) d) row)
      (portValue (port.entries (physicalSpatial q))
        (fun a d=>laplaceWeight lambda t*(jetEntry (actionJet q F contact a b t) d-
          lambda^d.val*(actionJet q F contact a b t).value)) row) t :=
  @port_derivative port.rows (port.entries (physicalSpatial q))
    (fun a d r=>laplaceWeight lambda r*initialCoSource lambda (actionJet q F contact a b r) d)
    (fun a d r=>laplaceWeight lambda r*(jetEntry (actionJet q F contact a b r) d-
      lambda^d.val*(actionJet q F contact a b r).value)) t
    (fun a d=>actual_green_boundary q F contact a b lambda t d) row

theorem initial_regular_source (q : SourceResponsePoint) (F : Index) (a b : Fin 97) :
    (actionJet q F false a b 0).value=sourcePairRead q
      ((-Complex.I) • (SourceFiniteUnitary.time (generator q F (q.p+q.k+q.ell)) (-q.age)*
        (localizedGauss (sourceFieldUnit b) (q.p+q.k) q.psi*rawGauss false (sourceFieldUnit a) (sourceFieldUnit b) q.p q.phi-
         rawGauss false (sourceFieldUnit a) (sourceFieldUnit b) (q.p+q.ell) q.phi*localizedGauss (sourceFieldUnit b) q.p q.psi)*
        SourceFiniteUnitary.time (generator q F q.p) q.age)) := by
  change sourcePairRead q (rawKernelJet q F a b 0).value=_
  simp only [rawKernelJet,jetScale,jetSub,wordJet,jetMul,jetConst,timeJet,mul_zero,zero_add,
    SourceFiniteUnitary.time_zero,mul_one,one_mul]
  congr 2
  noncomm_ring

end LowEnergy.PreparationVacuumGaugeSourceInjection
