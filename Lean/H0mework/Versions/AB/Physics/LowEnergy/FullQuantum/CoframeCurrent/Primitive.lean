import H0mework.Versions.AB.Physics.LowEnergy.FullQuantum.CoframeCurrent.Reader

/-! The current insertion is generated by differentiating the original
volume-weighted Dirac symbol at a fixed, actual on-shell time jet. -/
set_option autoImplicit false
open scoped Matrix Matrix.Norms.L2Operator ContDiff
namespace SaturationMonoid.PhysicsCore.LowEnergy.FullQuantum.CoframeCurrent
open ProofFreeRicherAnholonomicSource StageNineHolonomicField StateGreen CoframeResponse
open StageNineCoframeVariation StageNineCurrentCoframeMatterTemporalPrincipal
noncomputable section
local instance primitiveIndex : DecidableEq Quantum.Index := Classical.decEq _
local instance primitiveCoframeNormed : NormedAddCommGroup LorentzianCoframe := Matrix.normedAddCommGroup
local instance primitiveCoframeSeminormed : SeminormedAddCommGroup LorentzianCoframe := Matrix.seminormedAddCommGroup
local instance primitiveCoframeReal : NormedSpace ℝ LorentzianCoframe := Matrix.normedSpace
local instance primitiveSourceReal : NormedAlgebra ℝ SourceMatrix := NormedAlgebra.restrictScalars ℝ ℂ _

private theorem affine_derivative (e reader : LorentzianCoframe) :
    HasDerivAt (fun epsilon : ℝ => e+epsilon • reader) reader 0 := by
  convert! ((hasDerivAt_id (0 : ℝ)).smul_const reader).const_add e using 1
  simp

def heldTimeSymbol (point : BasePoint) (k : Fin 3 → ℝ) (base candidate : LorentzianCoframe) : SourceMatrix :=
  (-Complex.I) • (principalMatrix candidate*coframeHamiltonian point k base)+lowerMatrix point k candidate

def heldDensity (point : BasePoint) (k : Fin 3 → ℝ) (base candidate : LorentzianCoframe) : SourceMatrix :=
  ((|candidate.det| : ℝ) : ℂ) • heldTimeSymbol point k base candidate

theorem heldTimeSymbol_zero (point : BasePoint) (k : Fin 3 → ℝ) (e : LorentzianCoframe)
    (regular : coframeTemporalPrincipalScalar e≠0) : heldTimeSymbol point k e e=0 := by
  have inverse := Ring.mul_inverse_cancel (principalMatrix e) (principalMatrix_regular e regular)
  simp only [heldTimeSymbol,coframeHamiltonian,timeSymbol,Matrix.mul_smul,smul_smul]
  rw [← Matrix.mul_assoc,inverse,Matrix.one_mul]
  simp

theorem heldTimeSymbol_parameter (point : BasePoint) (k : Fin 3 → ℝ)
    (reader e : LorentzianCoframe) (nondegenerate : e.det≠0) :
    HasDerivAt (fun epsilon : ℝ => heldTimeSymbol point k e (e+epsilon • reader))
      (onShellCurrent point k reader e) 0 := by
  have dp := (principalMatrix_smooth e nondegenerate).differentiableAt (by simp)
  have dl := (lowerMatrix_smooth point k e nondegenerate).differentiableAt (by simp)
  have hp := dp.hasFDerivAt.comp_hasDerivAt_of_eq 0 (affine_derivative e reader) (by simp)
  have hl := dl.hasFDerivAt.comp_hasDerivAt_of_eq 0 (affine_derivative e reader) (by simp)
  have generated := ((hp.mul_const (coframeHamiltonian point k e)).const_smul (-Complex.I)).add hl
  unfold heldTimeSymbol onShellCurrent principalJet lowerJet
  convert! generated using 1
  simp only [neg_smul,sub_eq_add_neg]
  exact add_comm _ _

theorem heldDensity_parameter (point : BasePoint) (k : Fin 3 → ℝ)
    (reader e : LorentzianCoframe) (nondegenerate : e.det≠0)
    (regular : coframeTemporalPrincipalScalar e≠0) :
    HasDerivAt (fun epsilon : ℝ => heldDensity point k e (e+epsilon • reader))
      (((|e.det| : ℝ) : ℂ) • onShellCurrent point k reader e) 0 := by
  have dv := (coframe_volume_contDiffAt e nondegenerate).differentiableAt (by simp)
  have hv := dv.hasFDerivAt.comp_hasDerivAt_of_eq 0 (affine_derivative e reader) (by simp)
  have volume := Complex.ofRealCLM.hasFDerivAt.comp_hasDerivAt 0 hv
  have generated := volume.smul (heldTimeSymbol_parameter point k reader e nondegenerate)
  unfold heldDensity
  convert! generated using 1
  simp only [Function.comp_apply,Complex.ofRealCLM_apply,zero_smul,add_zero,
    heldTimeSymbol_zero point k e regular,smul_zero]

end
end SaturationMonoid.PhysicsCore.LowEnergy.FullQuantum.CoframeCurrent
