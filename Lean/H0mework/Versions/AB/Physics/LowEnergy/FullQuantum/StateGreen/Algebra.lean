import H0mework.Versions.AB.Physics.LowEnergy.FullQuantum.PreparedWeight.Source
import H0mework.Physics.LowEnergyMatterSpace.SpatialCARAlgebra

/-! Both ordered two-point functions are generated by the complete CAR action
on the existing one-particle prepared state. -/
set_option autoImplicit false
open scoped Matrix BigOperators
namespace SaturationMonoid.PhysicsCore.LowEnergy.FullQuantum.StateGreen
open QuantizationCheck.Fermion Fermion
noncomputable section
variable {ι : Type*} [Fintype ι] [LinearOrder ι]

def read (prepared : ι → ℂ) : Module.End ℂ (Fock ι) →ₗ[ℂ] ℂ where
  toFun word := pairing (oneParticle prepared) (word (oneParticle prepared))
  map_add' := by intros; simp [pairing,mul_add,Finset.sum_add_distrib]
  map_smul' := by intros; exact pairing_smul_right _ _ _

theorem read_one (prepared : ι → ℂ) : read prepared 1=modePair prepared prepared := by
  exact pairing_oneParticle prepared prepared

def less (prepared : ι → ℂ) (W V : Matrix ι ι ℂ) : Matrix ι ι ℂ :=
  fun i j => read prepared (creationField V j*annihilationField W i)

def greater (prepared : ι → ℂ) (W V : Matrix ι ι ℂ) : Matrix ι ι ℂ :=
  fun i j => read prepared (annihilationField W i*creationField V j)

theorem less_generated (prepared : ι → ℂ) (W V : Matrix ι ι ℂ) :
    less prepared W V=W*PreparedWeight.occupation prepared*V.conjTranspose := by
  ext i j
  have annihilator : annihilationField W i=
      MatterSpace.SpatialCAR.annihilator (fun a => star (W i a)) := by
    simp only [annihilationField,MatterSpace.SpatialCAR.annihilator,star_star]
  have creator : creationField V j=waveCreation (fun b => star (V j b)) := rfl
  change read prepared (creationField V j*annihilationField W i)=_
  rw [annihilator,creator]
  change pairing (oneParticle prepared)
    ((waveCreation (fun b => star (V j b))*MatterSpace.SpatialCAR.annihilator
      (fun a => star (W i a))) (oneParticle prepared))=_
  rw [MatterSpace.SpatialCAR.occupation_twoPoint]
  rw [PreparedWeight.occupation,Matrix.mul_vecMulVec,Matrix.vecMulVec_mul]
  simp only [modePair,star_star,Matrix.vecMulVec_apply,Matrix.mulVec,Matrix.vecMul,
    Matrix.conjTranspose_apply,Pi.star_apply,dotProduct]

theorem greater_generated (prepared : ι → ℂ) (unit : modePair prepared prepared=1)
    (W V : Matrix ι ι ℂ) :
    greater prepared W V=W*(1-PreparedWeight.occupation prepared)*V.conjTranspose := by
  ext i j
  have car := congrArg (read prepared) (field_car W V i j)
  rw [map_add,map_smul,read_one,unit,smul_eq_mul,mul_one] at car
  change greater prepared W V i j+less prepared W V i j=(W*V.conjTranspose) i j at car
  rw [less_generated] at car
  rw [Matrix.mul_sub,Matrix.mul_one,Matrix.sub_mul,Matrix.sub_apply]
  exact eq_sub_of_add_eq car

theorem two_orders_sum (prepared : ι → ℂ) (unit : modePair prepared prepared=1)
    (W V : Matrix ι ι ℂ) :
    greater prepared W V+less prepared W V=W*V.conjTranspose := by
  rw [greater_generated prepared unit,less_generated]
  noncomm_ring

theorem whole_word_boundary (prepared : ι → ℂ) (unit : modePair prepared prepared=1)
    (word : Module.End ℂ (Fock ι)) :
    read prepared word=PreparedWeight.boundaryDeterminant prepared (PreparedWeight.wholeCompression word) :=
  (PreparedWeight.boundaryDeterminant_whole_word word prepared unit).symm

end
end SaturationMonoid.PhysicsCore.LowEnergy.FullQuantum.StateGreen
