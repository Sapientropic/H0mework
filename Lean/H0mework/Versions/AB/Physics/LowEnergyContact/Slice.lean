import H0mework.Versions.AB.Physics.LowEnergyContact.Constraints
import H0mework.Versions.AB.Physics.LowEnergyContact.Stress

/-! A spatially homogeneous Cauchy candidate generated by the scalar impulse.
The three balance identities below concern explicit normal forms. Their
identification with all five differential residuals is an analytic calculation,
not an assumed certificate or a theorem of this module. -/
set_option autoImplicit false
namespace SaturationMonoid.PhysicsCore.LowEnergy.Contact.Slice
open ProofFreeRicherAnholonomicSource StageNineHolonomicField
open StageNineEnrichedProofFreeSource StageNineGlobalIntegratedAction
open Stage9C.Material.SpinPair Stage9C.Dynamics.Homogeneous Stage9C.Reduction
open StageNineDiracDualFormNativeJointResidualCarrier Response.Radial
open SU7MotherLieAlgebra DiracExteriorMatterAction
open scoped ContDiff
noncomputable section

local instance : Module.Finite ℝ P286LieBlockData :=
  FiniteDimensional.of_injective p286AmbientLinear p286AmbientLinear_injective
local instance : Fintype P286CoordinateIndex := Fintype.ofFinite _
local instance : IsTopologicalAddGroup P286CoordinateCarrier where
  toContinuousAdd := inferInstance
  toContinuousNeg := inferInstance

def impulse (parameter : ℝ) : ℝ := parameter * growthRate
def clock (parameter : ℝ) : ℝ :=
  Real.sqrt (lapse^2 + 5 * Stress.weight * (impulse parameter)^2 / 18)
def scaleAcceleration (parameter : ℝ) : ℝ :=
  -Stress.weight * (impulse parameter)^2 / 6
def gaugeAcceleration (parameter : ℝ) : ℝ :=
  4 * sourceCoupling * spinScale - 2 * gaugeScale^3 / (clock parameter)^2
def rate (parameter : ℝ) : ℝ := 3 * clock parameter / 2 * (spinScale - gaugeScale)
def scale (parameter : ℝ) (point : BasePoint) : ℝ :=
  Real.exp (scaleAcceleration parameter * (point 0)^2 / 2)
def gaugeProfile (parameter : ℝ) (point : BasePoint) : ℝ :=
  gaugeScale + gaugeAcceleration parameter * (point 0)^2 / 2

theorem clock_positive (parameter : ℝ) : 0 < clock parameter := by
  apply Real.sqrt_pos.2
  have h := Stress.weight_positive
  have base := sq_pos_of_pos lapse_pos
  have increment : 0 ≤ 5 * Stress.weight * (impulse parameter)^2 / 18 := by positivity
  linarith

theorem clock_squared (parameter : ℝ) :
    (clock parameter)^2 = lapse^2 + 5 * Stress.weight * (impulse parameter)^2 / 18 := by
  apply Real.sq_sqrt
  have h := Stress.weight_positive
  positivity

theorem clock_zero : clock 0 = lapse := by
  simp [clock, impulse, Real.sqrt_sq (le_of_lt lapse_pos)]

theorem gaugeAcceleration_zero : gaugeAcceleration 0 = 0 := by
  rw [gaugeAcceleration, clock_zero, gauge_cubic_balance]
  field_simp [ne_of_gt lapse_pos]
  ring

/-- The positive clock is obtained by solving the temporal balance. -/
theorem temporal_balance (parameter : ℝ) :
    3 * gaugeScale^4 / (4 * sourceCoupling * (clock parameter)^2) -
      6 * (spinScale - gaugeScale) * spinScale +
      Stress.weight * (impulse parameter)^2 / (2 * (clock parameter)^2) -
      (3 - 3 * spinScale^2) = 0 := by
  have nonzero := ne_of_gt (clock_positive parameter)
  rw [sourceCoupling_eq]
  field_simp [nonzero]
  rw [clock_squared, lapse_sq]
  unfold gaugeScale
  have fourth : spinScale^4 = 4 := by
    rw [show spinScale^4 = (spinScale^2)^2 by ring, spinScale_sq]
    norm_num
  ring_nf
  norm_num [fourth, spinScale_sq]
  ring

/-- The remaining isotropic coframe load fixes a primitive scale acceleration. -/
theorem spatial_balance (parameter : ℝ) :
    -gaugeScale^4 / (4 * sourceCoupling * clock parameter) +
      2 * clock parameter * (spinScale - gaugeScale) * spinScale -
      clock parameter * (3 - spinScale^2) -
      Stress.weight * (impulse parameter)^2 / (2 * clock parameter) +
      2 * (-scaleAcceleration parameter / clock parameter) = 0 := by
  have nonzero := ne_of_gt (clock_positive parameter)
  rw [sourceCoupling_eq]
  unfold scaleAcceleration
  field_simp [nonzero]
  rw [clock_squared, lapse_sq]
  unfold gaugeScale
  have fourth : spinScale^4 = 4 := by
    rw [show spinScale^4 = (spinScale^2)^2 by ring, spinScale_sq]
    norm_num
  ring_nf
  norm_num [fourth, spinScale_sq]
  ring

theorem gauge_balance (parameter : ℝ) :
    clock parameter * gaugeAcceleration parameter / sourceCoupling +
      2 * gaugeScale^3 / (sourceCoupling * clock parameter) -
      4 * clock parameter * spinScale = 0 := by
  unfold gaugeAcceleration
  rw [sourceCoupling_eq]
  field_simp [ne_of_gt (clock_positive parameter)]
  ring

/-- Only primitive coframe, connection and matter fields are supplied.
All auxiliary fields and the Cartan connection are subsequently generated. -/
def raw (parameter : ℝ) : StageNineHolonomicConfiguration :=
  { actual with
    coframe := fun point => Matrix.diagonal
      ![clock parameter, scale parameter point, scale parameter point, scale parameter point]
    gaugeConnection := fun point => gaugePotential (gaugeProfile parameter point)
    scalar := (Profile.testField parameter).scalar
    matter := fun point => spinPairMatter (phase (rate parameter) point) (phase (-rate parameter) point)
    conjugateMatter := fun point => spinPairDual
      ((spinScale : ℂ) * phase (rate parameter) point)
      ((spinScale : ℂ) * phase (-rate parameter) point) }

def field (parameter : ℝ) : StageNineHolonomicConfiguration :=
  algebraicCartanReduction positiveSmoothUnifiedSource (raw parameter)

theorem raw_smooth (parameter : ℝ) : (raw parameter).Smooth := by
  obtain ⟨_, oldConnection, oldGravityAuxiliary, oldMultiplier, _, oldGaugeAuxiliary, _, _, _⟩ :=
    actual_smooth
  have scaleSmooth : ContDiff ℝ ∞ (scale parameter) := by
    unfold scale
    exact ((contDiff_const.mul ((EuclideanSpace.proj (0 : Fin 4)).contDiff.pow 2)).div_const 2).exp
  have gaugeSmooth : ContDiff ℝ ∞ (gaugeProfile parameter) := by
    unfold gaugeProfile
    have time : ContDiff ℝ ∞ (fun point : BasePoint => point 0) :=
      (EuclideanSpace.proj (0 : Fin 4) : BasePoint →L[ℝ] ℝ).contDiff
    exact contDiff_const.add ((contDiff_const.mul (time.pow 2)).div_const (2 : ℝ))
  have gauge (mu : LorentzianIndex) : ContDiff ℝ ∞
      (fun point => p286CoordinateEquiv (gaugePotential (gaugeProfile parameter point) mu)) := by
    fin_cases mu
    · change ContDiff ℝ ∞ (fun _ : BasePoint => p286CoordinateEquiv 0)
      exact contDiff_const
    all_goals
      change ContDiff ℝ ∞ (fun point => p286CoordinateEquiv
        (gaugeProfile parameter point • _))
      simp only [map_smul]
      exact gaugeSmooth.smul contDiff_const
  have phases : ContDiff ℝ ∞ (fun point =>
      spinPairCoefficients (phase (rate parameter) point) (phase (-rate parameter) point)) := by
    apply contDiff_pi.mpr
    intro row
    apply contDiff_pi.mpr
    intro column
    fin_cases row <;> fin_cases column <;> simp only [spinPairCoefficients]
    all_goals first | exact phase_smooth _ | exact (phase_smooth _).neg | exact contDiff_const
  have matter : ContDiff ℝ ∞ (fun point => matterCoordinateEquiv ((raw parameter).matter point)) := by
    let linear := (sourceColorMatterCoordinateLinear.restrictScalars ℝ).toContinuousLinearMap
    exact linear.contDiff.comp phases
  have dual (index : MatterCoordinateIndex) : ContDiff ℝ ∞ (fun point =>
      (raw parameter).conjugateMatter point
        (matterCoordinateEquiv.symm (EuclideanSpace.single index 1))) := by
    have upper : ContDiff ℝ ∞ (fun point => (spinScale : ℂ) * phase (rate parameter) point) :=
      contDiff_const.mul (phase_smooth _)
    have lower : ContDiff ℝ ∞ (fun point => (spinScale : ℂ) * phase (-rate parameter) point) :=
      contDiff_const.mul (phase_smooth _)
    change ContDiff ℝ ∞ (fun point => ∑ spin, ∑ state,
      spinPairCoefficients ((spinScale : ℂ) * phase (rate parameter) point)
        ((spinScale : ℂ) * phase (-rate parameter) point) spin state *
      sourceColorDoubletDual state
        (matterCoordinateEquiv.symm (EuclideanSpace.single index 1) spin))
    simp only [Fin.sum_univ_four, Fin.sum_univ_two, spinPairCoefficients,
      Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons, zero_mul, zero_add, add_zero]
    fun_prop
  refine ⟨?_, oldConnection, oldGravityAuxiliary, oldMultiplier,
    gauge, oldGaugeAuxiliary, (Constraints.smooth parameter).2.2.2.2.2.2.1, matter, dual⟩
  intro i j
  change ContDiff ℝ ∞ (fun point => Matrix.diagonal _ i j)
  fin_cases i <;> fin_cases j <;> simp only [Matrix.diagonal_apply]
  all_goals first | exact contDiff_const | exact scaleSmooth

theorem raw_nondegenerate (parameter : ℝ) : (raw parameter).Nondegenerate := by
  intro point
  change Matrix.det (Matrix.diagonal _) ≠ 0
  simp only [Matrix.det_diagonal, Fin.prod_univ_four, Matrix.cons_val_zero,
    Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three]
  exact mul_ne_zero (mul_ne_zero (mul_ne_zero (ne_of_gt (clock_positive parameter))
    (ne_of_gt (Real.exp_pos _))) (ne_of_gt (Real.exp_pos _))) (ne_of_gt (Real.exp_pos _))

theorem four_constraints (parameter : ℝ) (point : BasePoint) :
    let residual := diracDualFormNativePointwiseJointResidual positiveSmoothUnifiedSource
      (field parameter) point
    residual.gravityMultiplier = 0 ∧ residual.gravityAuxiliary = 0 ∧
      residual.p286GaugeAuxiliary = 0 ∧ residual.lorentzConnection = 0 :=
  ⟨algebraicCartanReduction_gravityMultiplier_zero _ _ _,
    algebraicCartanReduction_gravityAuxiliary_zero _ _ _,
    algebraicCartanReduction_p286Auxiliary_zero _ _ (raw_nondegenerate parameter) _,
    algebraicCartanReduction_lorentz_zero _ _ (raw_smooth parameter) (raw_nondegenerate parameter) _⟩

theorem field_zero : field 0 = actual := by
  have rawZero : raw 0 = actual := by
    apply StageNineHolonomicConfiguration.ext <;> try rfl
    · funext point
      rw [actual_coframe]
      simp [raw, scale, scaleAcceleration, impulse, clock_zero, homogeneousCoframe]
    · funext point
      rw [actual_gaugeConnection]
      simp [raw, gaugeProfile, gaugeAcceleration_zero]
    · change (Profile.testField 0).scalar = actual.scalar
      exact congrArg StageNineHolonomicConfiguration.scalar Profile.family_zero
    · rw [actual_matter]
      simp only [raw, rate, clock_zero, frequency, upperPhase, lowerPhase]
    · rw [actual_conjugateMatter]
      simp only [raw, rate, clock_zero, frequency, upperDualPhase, lowerDualPhase, upperPhase, lowerPhase]
  rw [field, rawZero]
  exact algebraicCartanReduction_idempotent positiveSmoothUnifiedSource seed

theorem coframe_slice (parameter : ℝ) (point : BasePoint) (time : point 0 = 0) :
    (field parameter).coframe point = homogeneousCoframe (clock parameter) := by
  change Matrix.diagonal _ = _
  simp [scale, time, homogeneousCoframe]

theorem scalar_slice (parameter : ℝ) (point : BasePoint) (time : point 0 = 0) :
    (field parameter).scalar point = direction := by
  change (Profile.testField parameter).scalar point = _
  rw [Profile.testField, actual_scalar]
  simp [Profile.wave, time, direction]

end
end SaturationMonoid.PhysicsCore.LowEnergy.Contact.Slice
