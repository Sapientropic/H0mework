import H0mework.Versions.AB.Physics.MotherSource.HyperchargeResponse.Scalar

/-! Charged spectral preparations of the original temporal current, whose source expectation is zero. -/
set_option autoImplicit false
set_option maxRecDepth 16384
set_option maxHeartbeats 600000
namespace SaturationMonoid.PhysicsCore.Stage10.ChargedPreparation
open ProofFreeRicherAnholonomicSource StageNineHolonomicField
open SU7MotherLieAlgebra SU7MotherGaugeTheory DiracExteriorMatterAction DiracCliffordRepresentation
open Stage9C.Material.SpinPair Stage9DEF.Compatibility
open scoped Matrix ComplexOrder
noncomputable section

def charge : Matrix8 := currentObservable 0 HyperchargeResponse.chargeDirection

def sign (spin : DiracSpinorIndex) : ℂ := if spin.val < 2 then 1 else -1

theorem charge_mulVec (values : Stage9DEF.Source.Index → ℂ) (index : Stage9DEF.Source.Index) :
    (charge *ᵥ values) index = sign index.1 * values index := by
  unfold charge currentObservable
  rw [responseMatrix_mulVec]
  rcases index with ⟨spin, color⟩
  change sourceColorDoubletDual color
    ((Complex.I • diracMatrixMatterAction (diracGamma 0)
      (diracExteriorMotherLieAction (p286LieBlockEmbed HyperchargeResponse.chargeDirection)
        (sourceColorDiracMatter (fun s c => values (s,c))))) (spinFlip spin)) = _
  simp only [Pi.smul_apply, map_smul, smul_eq_mul, sourceColorDoubletDual_matrixMotherAction]
  fin_cases spin <;> fin_cases color <;>
    simp [HyperchargeResponse.chargeDirection, hyperchargeGenerator, spinFlip, sign,
      diracGamma, diracGammaZero, Fin.sum_univ_four, Fin.castLE]
  all_goals ring_nf; simp

theorem charge_matrix : charge = Matrix.diagonal (fun i : Stage9DEF.Source.Index => sign i.1) := by
  ext row column
  have value := charge_mulVec (Pi.single column 1) row
  simpa [Matrix.mulVec_single, Matrix.diagonal_apply, Pi.single_apply, eq_comm] using value

/-- The negative spectral projector is generated by the actual current operator. -/
def negativeProjector : Matrix8 := (1/2 : ℂ) • (1-charge)

theorem negative_mulVec (values : Stage9DEF.Source.Index → ℂ) (index : Stage9DEF.Source.Index) :
    (negativeProjector *ᵥ values) index = if index.1.val < 2 then 0 else values index := by
  simp only [negativeProjector, Matrix.smul_mulVec, Matrix.sub_mulVec,
    Matrix.one_mulVec, Pi.smul_apply, Pi.sub_apply, charge_mulVec, smul_eq_mul, sign]
  split_ifs <;> ring

theorem negative_matrix : negativeProjector = Matrix.diagonal
    (fun i : Stage9DEF.Source.Index => if i.1.val < 2 then 0 else 1) := by
  ext row column
  simp only [negativeProjector, charge_matrix, Matrix.smul_apply, Matrix.sub_apply,
    Matrix.one_apply, Matrix.diagonal_apply, smul_eq_mul, sign]
  split_ifs <;> ring

def negativeEffect : Stage9DEF.State.Effect where
  matrix := negativeProjector
  positive := by
    rw [negative_matrix, Matrix.posSemidef_diagonal_iff]
    intro index
    split_ifs <;> norm_num
  complement_positive := by
    have complement : 1-negativeProjector = Matrix.diagonal
        (fun i : Stage9DEF.Source.Index => if i.1.val < 2 then 1 else 0) := by
      rw [negative_matrix]
      ext row column
      simp only [Matrix.sub_apply, Matrix.one_apply, Matrix.diagonal_apply]
      split_ifs <;> norm_num
    rw [complement, Matrix.posSemidef_diagonal_iff]
    intro index
    split_ifs <;> norm_num

theorem negative_weight (point : BasePoint) :
    Stage9DEF.State.effectWeight point negativeEffect = 1/2 := by
  have weight : (∑ index : Stage9DEF.Source.Index,
      star (Stage9DEF.Source.vector point index) *
        (negativeProjector *ᵥ Stage9DEF.Source.vector point) index) = (1/2 : ℂ) := by
    simp only [Fintype.sum_prod_type]
    simp [negative_mulVec, Stage9DEF.Source.vector, Stage9DEF.Source.amplitude,
      spinPairCoefficients, Fin.sum_univ_four, Fin.sum_univ_two]
    have phase := Stage9DEF.Source.phase_star_mul (-frequency) point
    dsimp only [lowerPhase] at *
    change (starRingEnd ℂ) (Stage9C.Material.SpinPair.phase (-frequency) point) *
      Stage9C.Material.SpinPair.phase (-frequency) point = 1 at phase
    norm_num only [map_ofNat]
    linear_combination phase / 2
  change (∑ index : Stage9DEF.Source.Index,
      star (Stage9DEF.Source.vector point index) *
        (negativeProjector *ᵥ Stage9DEF.Source.vector point) index).re = _
  rw [weight]
  norm_num

def prepared (point : BasePoint) : Stage9DEF.Source.Index → ℂ :=
  (spinScale : ℂ) • (negativeProjector *ᵥ Stage9DEF.Source.vector point)

theorem prepared_value (point : BasePoint) (index : Stage9DEF.Source.Index) :
    prepared point index =
      if index.1.val < 2 then 0 else (spinScale : ℂ) * Stage9DEF.Source.vector point index := by
  simp only [prepared, Pi.smul_apply, negative_mulVec, smul_eq_mul]
  split_ifs <;> simp

theorem prepared_charge (point : BasePoint) : charge *ᵥ prepared point = -prepared point := by
  funext index
  rw [charge_mulVec, prepared_value]
  simp only [Pi.neg_apply, prepared_value, sign]
  split_ifs <;> ring

theorem prepared_norm (point : BasePoint) :
    (∑ index : Stage9DEF.Source.Index, star (prepared point index) * prepared point index) = 1 := by
  simp only [Fintype.sum_prod_type]
  simp [prepared_value, Stage9DEF.Source.vector, Stage9DEF.Source.amplitude,
    spinPairCoefficients, Fin.sum_univ_four, Fin.sum_univ_two]
  have phase := Stage9DEF.Source.phase_star_mul (-frequency) point
  have scale : (spinScale : ℂ)^2 = 2 := by exact_mod_cast spinScale_sq
  dsimp only [lowerPhase] at *
  change (starRingEnd ℂ) (Stage9C.Material.SpinPair.phase (-frequency) point) *
    Stage9C.Material.SpinPair.phase (-frequency) point = 1 at phase
  norm_num only [map_ofNat]
  linear_combination ((spinScale : ℂ)^2 / 2) * phase + scale / 2

end
end SaturationMonoid.PhysicsCore.Stage10.ChargedPreparation
