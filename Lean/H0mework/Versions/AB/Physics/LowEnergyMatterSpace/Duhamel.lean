import H0mework.Versions.AB.Physics.LowEnergyMatterSpace.Spatial
import Mathlib.MeasureTheory.Integral.IntervalIntegral.FundThmCalculus

/-! Zero-past L² perturbations are generated by the actual spatial group; the background is not
inserted into L². The evolution equation is stated in its strong interaction form. -/
set_option autoImplicit false
open MeasureTheory Filter Topology
namespace SaturationMonoid.PhysicsCore.LowEnergy.MatterSpace
noncomputable section

theorem spatialUnitary_joint : Continuous (fun tv : ℝ × MatterL2 => spatialUnitary tv.1 tv.2) :=
  continuous_prod_of_continuous_lipschitzWith' _ 1
    (fun t => (spatialUnitary t).isometry.lipschitz)
    spatialUnitary_stronglyContinuous

def interactionForcing (forcing : ℝ → MatterL2) (t : ℝ) : MatterL2 :=
  spatialUnitary (-t) (forcing t)

theorem interactionForcing_continuous (forcing : ℝ → MatterL2) (continuousForcing : Continuous forcing) :
    Continuous (interactionForcing forcing) := by
  unfold interactionForcing
  have composed := spatialUnitary_joint.comp (continuous_id.neg.prodMk continuousForcing)
  simpa only [Function.comp_def,Pi.neg_apply,id_eq] using composed

def interactionIntegral (forcing : ℝ → MatterL2) (t : ℝ) : MatterL2 :=
  ∫ s in (0 : ℝ)..t, interactionForcing forcing s

def duhamel (forcing : ℝ → MatterL2) (t : ℝ) : MatterL2 :=
  spatialUnitary t (interactionIntegral forcing t)

theorem interactionIntegral_derivative (forcing : ℝ → MatterL2)
    (continuousForcing : Continuous forcing) (t : ℝ) :
    HasDerivAt (interactionIntegral forcing) (interactionForcing forcing t) t := by
  have continuous := interactionForcing_continuous forcing continuousForcing
  exact intervalIntegral.integral_hasDerivAt_right (continuous.intervalIntegrable 0 t)
    continuous.aestronglyMeasurable.stronglyMeasurableAtFilter continuous.continuousAt

theorem duhamel_continuous (forcing : ℝ → MatterL2) (continuousForcing : Continuous forcing) :
    Continuous (duhamel forcing) := by
  unfold duhamel
  have continuousIntegral : Continuous (interactionIntegral forcing) :=
    continuous_iff_continuousAt.mpr fun t =>
      (interactionIntegral_derivative forcing continuousForcing t).continuousAt
  have composed := spatialUnitary_joint.comp (continuous_id.prodMk continuousIntegral)
  simpa only [Function.comp_def,id_eq] using composed

theorem duhamel_interaction (forcing : ℝ → MatterL2) (t : ℝ) :
    spatialUnitary (-t) (duhamel forcing t)=interactionIntegral forcing t := by
  rw [duhamel,← spatialUnitary_add,neg_add_cancel,spatialUnitary_zero]

theorem duhamel_interaction_derivative (forcing : ℝ → MatterL2)
    (continuousForcing : Continuous forcing) (t : ℝ) :
    HasDerivAt (fun s => spatialUnitary (-s) (duhamel forcing s))
      (spatialUnitary (-t) (forcing t)) t := by
  simp_rw [duhamel_interaction]
  exact interactionIntegral_derivative forcing continuousForcing t

theorem duhamel_zero (forcing : ℝ → MatterL2) : duhamel forcing 0=0 := by
  simp [duhamel,interactionIntegral]

theorem duhamel_zero_past (forcing : ℝ → MatterL2)
    (zeroPast : ∀ t, t≤0 → forcing t=0) (t : ℝ) (past : t≤0) : duhamel forcing t=0 := by
  have integralZero : interactionIntegral forcing t=0 := by
    unfold interactionIntegral
    calc
      _ = ∫ _ in (0 : ℝ)..t, (0 : MatterL2) := by
        apply intervalIntegral.integral_congr
        intro s hs
        have hs0 : s≤0 := by
          have upper := hs.2
          simpa only [max_eq_left past] using upper
        simp [interactionForcing,zeroPast s hs0]
      _ = 0 := by simp
  rw [duhamel,integralZero,map_zero]

theorem duhamel_retarded_integral (forcing : ℝ → MatterL2)
    (continuousForcing : Continuous forcing) (t : ℝ) :
    duhamel forcing t=∫ s in (0 : ℝ)..t, spatialUnitary (t-s) (forcing s) := by
  have continuous := interactionForcing_continuous forcing continuousForcing
  have same := (spatialUnitary t).toContinuousLinearEquiv.toContinuousLinearMap.intervalIntegral_comp_comm
    (continuous.intervalIntegrable (μ := volume) 0 t)
  change (∫ s in (0 : ℝ)..t, spatialUnitary t (interactionForcing forcing s))=
    spatialUnitary t (∫ s in (0 : ℝ)..t, interactionForcing forcing s) at same
  rw [duhamel,interactionIntegral,← same]
  apply intervalIntegral.integral_congr
  intro s _
  change spatialUnitary t (spatialUnitary (-s) (forcing s))=spatialUnitary (t-s) (forcing s)
  rw [← spatialUnitary_add,sub_eq_add_neg]

theorem duhamel_norm_le (forcing : ℝ → MatterL2) (t : ℝ) (future : 0≤t) :
    ‖duhamel forcing t‖≤∫ s in (0 : ℝ)..t, ‖forcing s‖ := by
  rw [duhamel,spatialUnitary_norm,interactionIntegral]
  have bound := intervalIntegral.norm_integral_le_integral_norm (μ := volume)
    (f := interactionForcing forcing) future
  simpa only [interactionForcing,spatialUnitary_norm] using bound

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

def sourceInjection (coefficient : E →L[ℂ] MatterFiber) :
    Lp (α := Position) E 2 volume →L[ℂ] MatterL2 := coefficient.compLpL 2 volume

theorem sourceInjection_ae (coefficient : E →L[ℂ] MatterFiber)
    (profile : Lp (α := Position) E 2 volume) :
    sourceInjection coefficient profile=ᵐ[volume] fun x => coefficient (profile x) :=
  coefficient.coeFn_compLpL profile

theorem sourceInjection_norm_le (coefficient : E →L[ℂ] MatterFiber)
    (profile : Lp (α := Position) E 2 volume) :
    ‖sourceInjection coefficient profile‖≤‖coefficient‖*‖profile‖ :=
  coefficient.norm_compLp_le profile

theorem injected_duhamel_derivative (coefficient : E →L[ℂ] MatterFiber)
    (profile : ℝ → Lp (α := Position) E 2 volume) (continuousProfile : Continuous profile) (t : ℝ) :
    HasDerivAt (fun s => spatialUnitary (-s) (duhamel (fun r => sourceInjection coefficient (profile r)) s))
      (spatialUnitary (-t) (sourceInjection coefficient (profile t))) t :=
  duhamel_interaction_derivative _ ((sourceInjection coefficient).continuous.comp continuousProfile) t

end
end SaturationMonoid.PhysicsCore.LowEnergy.MatterSpace
