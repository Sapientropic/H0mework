import H0mework.Versions.AB.Physics.LowEnergyMatterSpace.Weak
import H0mework.Versions.AB.Physics.LowEnergyMatterSpace.PreparationNative

/-! The first variation is generated by the original spatial Duhamel group on all of L². -/
set_option autoImplicit false
open MeasureTheory
open scoped InnerProductSpace
namespace SaturationMonoid.PhysicsCore.LowEnergy.MatterSpace.Response
noncomputable section

def freeOperator (t : ℝ) : MatterL2 →L[ℂ] MatterL2 :=
  (spatialUnitary t).toContinuousLinearEquiv.toContinuousLinearMap

def perturbationForce (perturbation : ℝ → MatterL2 →L[ℂ] MatterL2) (u : MatterL2) (s : ℝ) : MatterL2 :=
  (-Complex.I) • perturbation s (spatialUnitary s u)

theorem perturbationForce_continuous (perturbation : ℝ → MatterL2 →L[ℂ] MatterL2)
    (continuousPerturbation : Continuous perturbation) (u : MatterL2) :
    Continuous (perturbationForce perturbation u) :=
  (continuousPerturbation.clm_apply (spatialUnitary_stronglyContinuous u)).const_smul (-Complex.I)

def firstOrder (perturbation : ℝ → MatterL2 →L[ℂ] MatterL2) (t : ℝ) (u : MatterL2) : MatterL2 :=
  duhamel (perturbationForce perturbation u) t

theorem firstOrder_zero (perturbation : ℝ → MatterL2 →L[ℂ] MatterL2) (u : MatterL2) :
    firstOrder perturbation 0 u=0 := duhamel_zero _

theorem firstOrder_zero_past (perturbation : ℝ → MatterL2 →L[ℂ] MatterL2)
    (zeroPast : ∀ s, s≤0 → perturbation s=0) (u : MatterL2) (t : ℝ) (past : t≤0) :
    firstOrder perturbation t u=0 := by
  apply duhamel_zero_past _ _ t past
  intro s hs
  simp [perturbationForce,zeroPast s hs]

theorem firstOrder_interaction_derivative (perturbation : ℝ → MatterL2 →L[ℂ] MatterL2)
    (continuousPerturbation : Continuous perturbation) (u : MatterL2) (t : ℝ) :
    HasDerivAt (fun s => spatialUnitary (-s) (firstOrder perturbation s u))
      ((-Complex.I) • spatialUnitary (-t) (perturbation t (spatialUnitary t u))) t := by
  simpa only [firstOrder,perturbationForce,map_smul] using duhamel_interaction_derivative
    (perturbationForce perturbation u) (perturbationForce_continuous perturbation continuousPerturbation u) t

theorem firstOrder_weak (perturbation : ℝ → MatterL2 →L[ℂ] MatterL2)
    (continuousPerturbation : Continuous perturbation) (u : MatterL2)
    (test : Quantum.Generator.domain spatialAction) (t : ℝ) :
    HasDerivAt (fun s => inner ℂ (test : MatterL2) (firstOrder perturbation s u))
      (-Complex.I*inner ℂ (Quantum.Generator.hamiltonian spatialAction test) (firstOrder perturbation t u)-
        Complex.I*inner ℂ (test : MatterL2) (perturbation t (spatialUnitary t u))) t := by
  have generated := duhamel_weak_schrodinger (perturbationForce perturbation u)
    (perturbationForce_continuous perturbation continuousPerturbation u) test t
  simpa only [firstOrder,perturbationForce,inner_smul_right,neg_mul,sub_eq_add_neg] using generated

theorem firstOrder_retarded (perturbation : ℝ → MatterL2 →L[ℂ] MatterL2)
    (continuousPerturbation : Continuous perturbation) (u : MatterL2) (t : ℝ) :
    firstOrder perturbation t u=
      ∫ s in (0 : ℝ)..t, (-Complex.I) • spatialUnitary (t-s) (perturbation s (spatialUnitary s u)) := by
  simpa only [firstOrder,perturbationForce,map_smul] using duhamel_retarded_integral
    (perturbationForce perturbation u) (perturbationForce_continuous perturbation continuousPerturbation u) t

def responseBound (perturbation : ℝ → MatterL2 →L[ℂ] MatterL2) (t : ℝ) : ℝ :=
  |∫ s in (0 : ℝ)..t, ‖perturbation s‖|

theorem firstOrder_bound (perturbation : ℝ → MatterL2 →L[ℂ] MatterL2)
    (continuousPerturbation : Continuous perturbation) (u : MatterL2) (t : ℝ) :
    ‖firstOrder perturbation t u‖≤responseBound perturbation t*‖u‖ := by
  rw [firstOrder,duhamel,spatialUnitary_norm,interactionIntegral]
  have bound : ∀ᵐ s ∂volume.restrict (Set.uIoc 0 t),
      ‖interactionForcing (perturbationForce perturbation u) s‖≤‖perturbation s‖*‖u‖ := ae_of_all _ fun s => by
    rw [interactionForcing,spatialUnitary_norm,perturbationForce,norm_smul,norm_neg,Complex.norm_I,one_mul]
    simpa only [spatialUnitary_norm] using (perturbation s).le_opNorm (spatialUnitary s u)
  have generated := intervalIntegral.norm_integral_le_abs_of_norm_le bound
    ((continuousPerturbation.norm.mul_const ‖u‖).intervalIntegrable (μ := volume) 0 t)
  simpa only [intervalIntegral.integral_mul_const,abs_mul,abs_of_nonneg (norm_nonneg u),responseBound] using generated

theorem firstOrder_add (perturbation : ℝ → MatterL2 →L[ℂ] MatterL2)
    (continuousPerturbation : Continuous perturbation) (t : ℝ) (u v : MatterL2) :
    firstOrder perturbation t (u+v)=firstOrder perturbation t u+firstOrder perturbation t v := by
  have integrable (w : MatterL2) : IntervalIntegrable
      (fun s => spatialUnitary (-s) ((-Complex.I) • perturbation s (spatialUnitary s w))) volume 0 t :=
    (interactionForcing_continuous _ (perturbationForce_continuous perturbation continuousPerturbation w)).intervalIntegrable 0 t
  simp only [firstOrder,duhamel,interactionIntegral,interactionForcing,perturbationForce,map_add,smul_add]
  rw [intervalIntegral.integral_add (integrable u) (integrable v),map_add]

theorem firstOrder_smul (perturbation : ℝ → MatterL2 →L[ℂ] MatterL2)
    (t : ℝ) (c : ℂ) (u : MatterL2) : firstOrder perturbation t (c • u)=c • firstOrder perturbation t u := by
  simp only [firstOrder,duhamel,interactionIntegral,interactionForcing,perturbationForce,map_smul,
    smul_comm (-Complex.I) c]
  rw [intervalIntegral.integral_smul,map_smul]

def firstOrderLinear (perturbation : ℝ → MatterL2 →L[ℂ] MatterL2)
    (continuousPerturbation : Continuous perturbation) (t : ℝ) : MatterL2 →ₗ[ℂ] MatterL2 where
  toFun := firstOrder perturbation t
  map_add' := firstOrder_add perturbation continuousPerturbation t
  map_smul' := firstOrder_smul perturbation t

def firstOrderOperator (perturbation : ℝ → MatterL2 →L[ℂ] MatterL2)
    (continuousPerturbation : Continuous perturbation) (t : ℝ) : MatterL2 →L[ℂ] MatterL2 :=
  (firstOrderLinear perturbation continuousPerturbation t).mkContinuous (responseBound perturbation t)
    (fun u => firstOrder_bound perturbation continuousPerturbation u t)

theorem firstOrderOperator_norm (perturbation : ℝ → MatterL2 →L[ℂ] MatterL2)
    (continuousPerturbation : Continuous perturbation) (t : ℝ) :
    ‖firstOrderOperator perturbation continuousPerturbation t‖≤responseBound perturbation t :=
  (firstOrderLinear perturbation continuousPerturbation t).mkContinuous_norm_le (abs_nonneg _)
    (fun u => firstOrder_bound perturbation continuousPerturbation u t)

def epsilonPath (perturbation : ℝ → MatterL2 →L[ℂ] MatterL2) (u : MatterL2) (t epsilon : ℝ) : MatterL2 :=
  spatialUnitary t u+epsilon • firstOrder perturbation t u

theorem epsilonPath_derivative (perturbation : ℝ → MatterL2 →L[ℂ] MatterL2) (u : MatterL2) (t : ℝ) :
    HasDerivAt (epsilonPath perturbation u t) (firstOrder perturbation t u) 0 := by
  change HasDerivAt (fun epsilon : ℝ => spatialUnitary t u+epsilon • firstOrder perturbation t u) _ _
  convert! ((hasDerivAt_id (0 : ℝ)).smul_const (firstOrder perturbation t u)).const_add (spatialUnitary t u) using 1
  simp only [one_smul]

def currentVariation (perturbation : ℝ → MatterL2 →L[ℂ] MatterL2)
    (current : MatterL2 →L[ℂ] MatterL2) (u : MatterL2) (t : ℝ) : ℂ :=
  inner ℂ (firstOrder perturbation t u) (current (spatialUnitary t u))+
    inner ℂ (spatialUnitary t u) (current (firstOrder perturbation t u))

theorem currentVariation_zero_past (perturbation : ℝ → MatterL2 →L[ℂ] MatterL2)
    (zeroPast : ∀ s, s≤0 → perturbation s=0) (current : MatterL2 →L[ℂ] MatterL2)
    (u : MatterL2) (t : ℝ) (past : t≤0) : currentVariation perturbation current u t=0 := by
  rw [currentVariation,firstOrder_zero_past perturbation zeroPast u t past,
    inner_zero_left,map_zero,inner_zero_right,add_zero]

private theorem affineCurrent_derivative {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (v variation : E) (current : E →L[ℂ] E) :
    HasDerivAt (fun epsilon : ℝ => inner ℂ (v+epsilon • variation) (current (v+epsilon • variation)))
      (inner ℂ variation (current v)+inner ℂ v (current variation)) 0 := by
  have path : HasDerivAt (fun epsilon : ℝ => v+epsilon • variation) variation 0 := by
    convert! ((hasDerivAt_id (0 : ℝ)).smul_const variation).const_add v using 1
    simp only [one_smul]
  have generated := path.inner ℂ ((current.restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt 0 path)
  have applyCurrent (x : E) : (current.restrictScalars ℝ) x=current x := rfl
  simp only [Function.comp_apply,applyCurrent,zero_smul,add_zero] at generated
  convert! generated using 1
  exact add_comm _ _

theorem epsilonCurrent_derivative (perturbation : ℝ → MatterL2 →L[ℂ] MatterL2)
    (current : MatterL2 →L[ℂ] MatterL2) (u : MatterL2) (t : ℝ) :
    HasDerivAt (fun epsilon => inner ℂ (epsilonPath perturbation u t epsilon)
      (current (epsilonPath perturbation u t epsilon))) (currentVariation perturbation current u t) 0 := by
  exact affineCurrent_derivative (spatialUnitary t u) (firstOrder perturbation t u) current

end
end SaturationMonoid.PhysicsCore.LowEnergy.MatterSpace.Response
