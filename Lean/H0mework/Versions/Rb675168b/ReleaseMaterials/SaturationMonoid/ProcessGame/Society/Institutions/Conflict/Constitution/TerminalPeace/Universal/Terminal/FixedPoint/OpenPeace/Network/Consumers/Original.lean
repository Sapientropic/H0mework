/-- The same paid hidden-exit attempt supplies the network obstruction,
the U7 row, and the realized U8 successor. The revision cannot take the
place of the original debit. -/
theorem the_original_paid_exit_gap_writes_the_whole_network :
    actual.source.paidWire = some inertWire ∧
    (∀ code : initial.language.Code, exitEffect ∉ initial.language.denotes code) ∧
    exitEffect ∈ proposedScope ∧
    HEq rooted.rootEntry chargedLedger.resident.entry ∧
    (∀ claim, certificate.generate.translation.claim.forward claim ≠ certificate.generate.revisedClaim) ∧
    certificate.generate.newOnlyEntry.progressBudget = 0 ∧
    nextCurrent tariff home billOrders opens replies initial lockedInput inherited.2 = originalNext.erase ∧
    (⟨certificate.generate.NewN, certificate.generate.newLivingRoot.generatedNextCurrentAt
      (.finite certificate.generate.newRoot.toRoot.initialVisit)⟩ : AnyAuthoritativeRootCurrent) =
      originalNext.erase ∧
    ∃ item, actual.source.round.visit.read.effect.execution.items[6]? = some item ∧
      item.request.signer = true ∧
      actual.source.round.visit.read.programme.law.actualDebit item.before item.request =
        locate true [(true, 1/6), (true, 1/6), (true, 1/6)] ∧
      actual.source.round.visit.read.programme.law.actualCredit item.before item.request = [] := by
  refine ⟨congrArg NoFreeProbe.Prepayment.Step.paidWire original_receipt,
    fun _ absent => absent, original_effect, ?_, ?_, certificate.generate.newOnlyProgressBudget_eq_zero,
    paid_novel_branch tariff home billOrders opens replies initial lockedInput inherited.2 original_novel, ?_, ?_⟩
  · exact rooted_failure_retains_the_bearer chargedLedger initial.language proposedScope
      (LocalU7.native inherited) original_novel
  · intro claim same
    exact certificate.generate.revisedClaim_hasNoOldPreimage.false ⟨claim, ⟨same⟩⟩
  · exact the_first_write_is_the_generated_next chargedLedger initial.language proposedScope
      (LocalU7.native inherited) original_novel
  · have debit := charged.original_expense
    rw [renewal_word] at debit
    rw [original_receipt]
    exact debit

theorem the_revised_source_reads_the_paid_exit_repair :
    HEq (generatedLanguageFace chargedLedger initial.language proposedScope (LocalU7.native inherited) original_novel).rootRead
      (initial.language.repair proposedScope) :=
  the_generated_next_reads_the_exact_repair chargedLedger initial.language proposedScope
    (LocalU7.native inherited) original_novel

private def laterInherited :
    InheritedCalculus (reviewedLedger tariff home billOrders opens replies arrived shiftedInput).world :=
  ((adaptiveKeepsWorld later).trans (OpenPeace.next_world_eq home initial lockedInput)).symm ▸ OriginalBase.inherited

theorem the_next_paid_covered_request_keeps_the_original_dispatch :
    later.source.paidWire = some nextWire ∧
    nextCurrent tariff home billOrders opens replies arrived shiftedInput laterInherited.2 =
      (OpenPeace.next tariff home billOrders opens replies arrived shiftedInput).adaptive.native.ledger.resident.erase := by
  have old := OpenPeace.Original.a_fresh_paid_proposal_in_the_old_scope_has_no_new_epoch
  exact ⟨old.2.1, covered_branch tariff home billOrders opens replies arrived shiftedInput laterInherited.2
    ((no_repair_iff tariff home billOrders opens replies arrived shiftedInput).mp old.2.2.2.1)⟩

