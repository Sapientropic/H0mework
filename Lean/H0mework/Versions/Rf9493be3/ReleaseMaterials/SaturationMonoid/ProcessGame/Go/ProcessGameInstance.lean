import H0mework.Versions.Rf9493be3.Foundation.Agency.Lineage
import H0mework.Versions.Rf9493be3.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.GeneratedPlayerLineage

/-!
# Go instance of the source-only process-game core

The source is the exact dependent `GeneratedReplay`.  Its generic occurrence
is the existing `toOccurrence`; generated actors are the image of the two
polarity seeds under the existing player-lineage compiler.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Go

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot

/-- Exact Go occurrence compiler for one fixed replay index. -/
def goOccurrenceOf {n : Nat} {law : Law} {moves : List (Move n)} :
    GeneratedReplay law (Frame.initial n) moves →
      RootedAccountedUnfolding (Frame n) :=
  GeneratedReplay.toOccurrence

/-- The source-only process game generated by one authoritative replay. -/
def goProcessGame {n : Nat} {law : Law} {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) :
    SaturationMonoid.ProcessGame (@goOccurrenceOf n law moves) :=
  ⟨replay⟩

@[simp] theorem goProcessGame_source {n : Nat} {law : Law}
    {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) :
    (goProcessGame replay).source = replay :=
  rfl

@[simp] theorem goProcessGame_occurrence {n : Nat} {law : Law}
    {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) :
    (goProcessGame replay).occurrence = replay.toOccurrence :=
  rfl

/-- A control seed is admitted at a trace state exactly when it is that
state's control channel or its opposite.  No player carrier appears here. -/
def goSeedAt {n : Nat} {law : Law} {moves : List (Move n)}
    (_source : GeneratedReplay law (Frame.initial n) moves)
    (state : Frame n) (control : Polarity) : Prop :=
  control = state.visible.toMove ∨ control = state.visible.toMove.other

/-- Both polarity channels are generated from the same occurrence root. -/
def goSourceSeed {n : Nat} {law : Law} {moves : List (Move n)}
    (source : GeneratedReplay law (Frame.initial n) moves)
    (control : Polarity) :
    SourceSeed goOccurrenceOf Polarity goSeedAt source :=
  ⟨control, ⟨source.toOccurrence.root,
    RootedAccountedUnfolding.root_mem_trace source.toOccurrence, by
      cases toMoveEq : source.toOccurrence.root.visible.toMove <;>
        cases control <;> simp [goSeedAt, toMoveEq]⟩⟩

theorem goSourceSeed_has_occurrence_witness
    {n : Nat} {law : Law} {moves : List (Move n)}
    (source : GeneratedReplay law (Frame.initial n) moves)
    (control : Polarity) :
    ∃ state ∈ source.toOccurrence.trace, goSeedAt source state control :=
  (goSourceSeed source control).2

/-- Source-dependent lineage carrier already generated by G2. -/
def goLineage {n : Nat} {law : Law} {moves : List (Move n)}
    (source : GeneratedReplay law (Frame.initial n) moves) : Type :=
  GeneratedReplay.GeneratedPlayerLineage source

/-- Existing G2 lineage compiler, now consumed by the generic downstream
lineage face. -/
def goLineageOf {n : Nat} {law : Law} {moves : List (Move n)}
    (source : GeneratedReplay law (Frame.initial n) moves)
    (seed : SourceSeed goOccurrenceOf Polarity goSeedAt source) :
    goLineage source :=
  source.lineage seed.1

/-- Generic actors generated at one exact Go replay. -/
abbrev GoGeneratedActor {n : Nat} {law : Law} {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) :=
  GeneratedActor (goProcessGame replay) Polarity goSeedAt goLineage goLineageOf

/-- Generic actor image and the existing G2 `GeneratedPlayer` are the same
dependent carrier. -/
def goGeneratedActorEquiv {n : Nat} {law : Law}
    {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) :
    GoGeneratedActor replay ≃ GeneratedReplay.GeneratedPlayer replay :=
  {
    toFun := fun actor => ⟨actor.1, by
      rcases actor.2 with ⟨seed, generated⟩
      exact ⟨seed.1, by
        simpa [goLineage, goLineageOf] using generated⟩⟩
    invFun := fun player => ⟨player.1, by
      rcases player.2 with ⟨control, generated⟩
      exact ⟨goSourceSeed replay control, by
        simpa [goLineage, goLineageOf, goSourceSeed] using generated⟩⟩
    left_inv := by intro actor; apply Subtype.ext; rfl
    right_inv := by intro player; apply Subtype.ext; rfl
  }

@[simp] theorem goGeneratedActorEquiv_generatedActorOf
    {n : Nat} {law : Law} {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves)
    (control : Polarity) :
    goGeneratedActorEquiv replay
        (generatedActorOf (goProcessGame replay) Polarity goSeedAt goLineage
          goLineageOf (goSourceSeed replay control)) = replay.player control :=
  rfl

theorem goProcessGame_occurrence_trace {n : Nat} {law : Law}
    {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) :
    (goProcessGame replay).occurrence.trace = replay.stateTrace :=
  replay.occurrence_trace_eq_stateTrace

theorem goProcessGame_occurrence_positionHistory {n : Nat} {law : Law}
    {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) :
    (goProcessGame replay).occurrence.trace.map
        (fun frame => frame.visible.situation) = replay.final.positionHistory :=
  generated_occurrence_situations_eq_positionHistory replay

/-- Closed generic fold readout instantiated with the existing Go final-state
algebra. -/
def goFinalFoldReadout {n : Nat} {law : Law}
    {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) :
    FoldReadout (goProcessGame replay) GeneratedReplay.finalAlgebra :=
  foldReadout (goProcessGame replay) GeneratedReplay.finalAlgebra

@[simp] theorem goFinalFoldReadout_value {n : Nat} {law : Law}
    {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) :
    (goFinalFoldReadout replay).value = replay.final :=
  replay.occurrence_fold_eq_final

/-- Generic fold uniqueness commutes all the way to the existing generated Go
final current. -/
theorem goCandidateEvaluator_eq_final {n : Nat} {law : Law}
    {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves)
    (candidate : RootedAccountedUnfolding (Frame n) → Frame n)
    (commutes : ∀ (origin : Frame n)
        (branches : AccountedBranches (Frame n)),
      candidate (.occur origin branches) =
        GeneratedReplay.finalAlgebra origin
          (RootedAccountedUnfolding.candidateValues candidate branches)) :
    candidate (goProcessGame replay).occurrence = replay.final := by
  calc
    candidate (goProcessGame replay).occurrence =
        (goFinalFoldReadout replay).value :=
      (goFinalFoldReadout replay).candidate_eq_value candidate commutes
    _ = replay.final := goFinalFoldReadout_value replay

end Go
end ProcessGame
end SaturationMonoid
