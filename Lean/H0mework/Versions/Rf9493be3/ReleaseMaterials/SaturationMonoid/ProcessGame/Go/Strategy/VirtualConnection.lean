import H0mework.Versions.Rf9493be3.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.FutureFreedom

/-!
# Source-generated virtual connection

Two strict chains are virtually connected at an actual replay current when a
bounded compiler-generated continuation carries surviving stones from both
chains into one common strict-chain successor.  The public relation is the
output of a finite move-word search; callers cannot submit an edge label,
target board or completed future.

Strategic clusters are the deterministic finite graph components of this
relation on the current board's canonical strict-chain carriers.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Go

/-- Canonical row-major list of all occupied strict-chain carriers. -/
def strictChainCarrierList {n : Nat} (board : Board n) :
    List (Finset (Point n)) :=
  (((allPoints n).filter fun point => (board point).isSome).map
    (groupAt board)).dedup

/-- Canonical finite enumeration of all occupied strict-chain carriers. -/
def strictChainCarriers {n : Nat} (board : Board n) :
    Finset (Finset (Point n)) :=
  (strictChainCarrierList board).toFinset

theorem group_carrier_mem_strictChainCarriers {n : Nat}
    {board : Board n} (group : SnapshotGroup board) :
    group.carrier ∈ strictChainCarriers board := by
  rcases snapshotGroup_has_occupied_member group with
    ⟨stone, belongs, member⟩
  unfold strictChainCarriers strictChainCarrierList
  apply List.mem_toFinset.mpr
  apply List.mem_dedup.mpr
  apply List.mem_map.mpr
  refine ⟨stone.point, ?_, ?_⟩
  · apply List.mem_filter.mpr
    exact ⟨point_mem_allPoints stone.point, by simp [stone.occupied]⟩
  · have carrierEq := congrArg SnapshotGroup.carrier belongs
    simpa using carrierEq

/-- Executable common-successor test for one exact move word.  It requires
two source stones of the same polarity to survive into one target component. -/
def commonStrictSuccessorWord? {n : Nat} (law : Law)
    (current : Frame n) (left right : Finset (Point n))
    (word : List (Move n)) : Bool :=
  match replayFrom? law current word with
  | none => false
  | some target => decide (∃ leftPoint ∈ left, ∃ rightPoint ∈ right,
      ∃ polarity,
        current.visible.board leftPoint = some polarity ∧
        current.visible.board rightPoint = some polarity ∧
        target.visible.board leftPoint = some polarity ∧
        target.visible.board rightPoint = some polarity ∧
        groupAt target.visible.board leftPoint =
          groupAt target.visible.board rightPoint)

/-- All bounded words generated by the fixed compiler which realize a common
strict-chain successor. -/
def commonSuccessorWords {n : Nat} (law : Law) (current : Frame n)
    (horizon : Nat) (left right : Finset (Point n)) :
    Finset (List (Move n)) :=
  ((moveWordsUpTo n horizon).filter fun word =>
    commonStrictSuccessorWord? law current left right word).toFinset

/-- Symmetric finite witness carrier.  The union makes symmetry structural
without inventing a reverse temporal edge. -/
def virtualConnectionWords {n : Nat} (law : Law) (current : Frame n)
    (horizon : Nat) (left right : Finset (Point n)) :
    Finset (List (Move n)) :=
  commonSuccessorWords law current horizon left right ∪
    commonSuccessorWords law current horizon right left

/-- Virtual connection is generated from the current board's strict chains
and a nonempty exact bounded-continuation witness carrier. -/
def VirtualConnectionCarrierAt {n : Nat} (law : Law) (current : Frame n)
    (horizon : Nat) (left right : Finset (Point n)) : Prop :=
  left ∈ strictChainCarriers current.visible.board ∧
    right ∈ strictChainCarriers current.visible.board ∧
    left ≠ right ∧
    (virtualConnectionWords law current horizon left right).Nonempty

instance {n : Nat} (law : Law) (current : Frame n) (horizon : Nat)
    (left right : Finset (Point n)) :
    Decidable (VirtualConnectionCarrierAt law current horizon left right) := by
  unfold VirtualConnectionCarrierAt
  infer_instance

def VirtualConnectionAt {n : Nat} {law : Law} {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves)
    (horizon : Nat)
    (left right : SnapshotGroup replay.final.visible.board) : Prop :=
  VirtualConnectionCarrierAt law replay.final horizon left.carrier right.carrier

instance {n : Nat} {law : Law} {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves)
    (horizon : Nat)
    (left right : SnapshotGroup replay.final.visible.board) :
    Decidable (VirtualConnectionAt replay horizon left right) := by
  unfold VirtualConnectionAt
  infer_instance

/-- Exact dependent witness reconstructed from the executable word test. -/
structure ExactCommonSuccessorAt {n : Nat} (law : Law) (current : Frame n)
    (horizon : Nat) (left right : Finset (Point n)) : Type where
  word : List (Move n)
  bounded : word.length ≤ horizon
  continuation : GeneratedReplay law current word
  leftPoint : Point n
  rightPoint : Point n
  polarity : Polarity
  left_source : current.visible.board leftPoint = some polarity
  right_source : current.visible.board rightPoint = some polarity
  left_mem : leftPoint ∈ left
  right_mem : rightPoint ∈ right
  left_survives : continuation.final.visible.board leftPoint = some polarity
  right_survives : continuation.final.visible.board rightPoint = some polarity
  common_target :
    groupAt continuation.final.visible.board leftPoint =
      groupAt continuation.final.visible.board rightPoint

private theorem commonStrictSuccessorWord_sound {n : Nat} {law : Law}
    {current : Frame n} {left right : Finset (Point n)}
    {word : List (Move n)}
    (generated : commonStrictSuccessorWord? law current left right word = true) :
    ∃ continuation : GeneratedReplay law current word,
      ∃ leftPoint ∈ left, ∃ rightPoint ∈ right, ∃ polarity,
        current.visible.board leftPoint = some polarity ∧
        current.visible.board rightPoint = some polarity ∧
        continuation.final.visible.board leftPoint = some polarity ∧
        continuation.final.visible.board rightPoint = some polarity ∧
        groupAt continuation.final.visible.board leftPoint =
          groupAt continuation.final.visible.board rightPoint := by
  unfold commonStrictSuccessorWord? at generated
  cases execution : replayFrom? law current word with
  | none => simp [execution] at generated
  | some target =>
      have targetFacts : ∃ leftPoint ∈ left, ∃ rightPoint ∈ right,
          ∃ polarity,
            current.visible.board leftPoint = some polarity ∧
            current.visible.board rightPoint = some polarity ∧
            target.visible.board leftPoint = some polarity ∧
            target.visible.board rightPoint = some polarity ∧
            groupAt target.visible.board leftPoint =
              groupAt target.visible.board rightPoint := by
        exact of_decide_eq_true (by simpa [execution] using generated)
      rcases exists_generatedReplay_of_replayFrom_eq_some execution with
        ⟨continuation, finalEq⟩
      subst target
      exact ⟨continuation, targetFacts⟩

/-- Every virtual edge reconstructs an exact bounded continuation and common
successor; the relation has no free edge constructor. -/
theorem VirtualConnectionCarrierAt.exactCommonSuccessor {n : Nat} {law : Law}
    {current : Frame n} {horizon : Nat}
    {left right : Finset (Point n)}
    (connected : VirtualConnectionCarrierAt law current horizon left right) :
    Nonempty (ExactCommonSuccessorAt law current horizon left right) := by
  rcases connected.2.2.2 with ⟨word, wordMem⟩
  have bounded : word.length ≤ horizon := by
    have inUnion := wordMem
    rcases Finset.mem_union.mp inUnion with inForward | inReverse
    · have inList : word ∈ moveWordsUpTo n horizon := by
        exact (List.mem_filter.mp (List.mem_toFinset.mp inForward)).1
      exact (mem_moveWordsUpTo_iff_length_le word horizon).mp inList
    · have inList : word ∈ moveWordsUpTo n horizon := by
        exact (List.mem_filter.mp (List.mem_toFinset.mp inReverse)).1
      exact (mem_moveWordsUpTo_iff_length_le word horizon).mp inList
  rcases Finset.mem_union.mp wordMem with forward | reverse
  · have generated : commonStrictSuccessorWord? law current left right word = true :=
      (List.mem_filter.mp (List.mem_toFinset.mp forward)).2
    rcases commonStrictSuccessorWord_sound generated with
      ⟨continuation, leftPoint, leftMem, rightPoint, rightMem, polarity,
        leftSource, rightSource, leftSurvives, rightSurvives, common⟩
    exact ⟨{
      word := word
      bounded := bounded
      continuation := continuation
      leftPoint := leftPoint
      rightPoint := rightPoint
      polarity := polarity
      left_source := leftSource
      right_source := rightSource
      left_mem := leftMem
      right_mem := rightMem
      left_survives := leftSurvives
      right_survives := rightSurvives
      common_target := common
    }⟩
  · have generated : commonStrictSuccessorWord? law current right left word = true :=
      (List.mem_filter.mp (List.mem_toFinset.mp reverse)).2
    rcases commonStrictSuccessorWord_sound generated with
      ⟨continuation, rightPoint, rightMem, leftPoint, leftMem, polarity,
        rightSource, leftSource, rightSurvives, leftSurvives, common⟩
    exact ⟨{
      word := word
      bounded := bounded
      continuation := continuation
      leftPoint := leftPoint
      rightPoint := rightPoint
      polarity := polarity
      left_source := leftSource
      right_source := rightSource
      left_mem := leftMem
      right_mem := rightMem
      left_survives := leftSurvives
      right_survives := rightSurvives
      common_target := common.symm
    }⟩

/-- Replay-indexed virtual connection factors through an exact rooted path in
the existing finite future cone. -/
theorem VirtualConnectionAt.factors_through_futureCone {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    {horizon : Nat}
    {left right : SnapshotGroup replay.final.visible.board}
    (connected : VirtualConnectionAt replay horizon left right) :
    ∃ witness : ExactCommonSuccessorAt law replay.final horizon
        left.carrier right.carrier,
      witness.continuation.stateTrace ∈
        rootedPaths (futureConeAt replay horizon) := by
  rcases (show VirtualConnectionCarrierAt law replay.final horizon
      left.carrier right.carrier from connected).exactCommonSuccessor with
    ⟨witness⟩
  exact ⟨witness,
    generatedReplay_stateTrace_mem_rootedPaths_finiteExposureFrom
      witness.continuation witness.bounded⟩

/-- Executable undirected strategic adjacency on strict-chain carriers. -/
def strategicAdjacent? {n : Nat} (law : Law) (current : Frame n)
    (horizon : Nat) (left right : Finset (Point n)) : Bool :=
  left == right ||
    decide (virtualConnectionWords law current horizon left right).Nonempty

private def strategicNeighbours {n : Nat} (law : Law) (current : Frame n)
  (horizon : Nat) (chain : Finset (Point n)) :
    List (Finset (Point n)) :=
  (strictChainCarrierList current.visible.board).filter fun candidate =>
    strategicAdjacent? law current horizon chain candidate

private def strategicComponentWorklist {n : Nat} (law : Law)
    (current : Frame n) (horizon : Nat) :
    Nat → List (Finset (Point n)) → List (Finset (Point n)) →
      Finset (Finset (Point n))
  | 0, _, seen => seen.toFinset
  | _ + 1, [], seen => seen.toFinset
  | fuel + 1, currentChain :: pending, seen =>
      let fresh := (strategicNeighbours law current horizon currentChain).filter
        (fun candidate => candidate ∉ seen)
      strategicComponentWorklist law current horizon fuel
        (pending ++ fresh) (seen ++ fresh)

/-- Canonical finite strategic component generated at one calculation
current.  Actual authority is supplied by the replay-indexed wrapper below. -/
def strategicClusterFrom {n : Nat} (law : Law) (current : Frame n)
    (horizon : Nat) (seed : SnapshotGroup current.visible.board) :
    Finset (Finset (Point n)) :=
  strategicComponentWorklist law current horizon
    (strictChainCarrierList current.visible.board).length
    [seed.carrier] [seed.carrier]

/-- Replay-indexed canonical finite strategic component. -/
def strategicCluster {n : Nat} {law : Law} {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves)
    (horizon : Nat) (seed : SnapshotGroup replay.final.visible.board) :
    Finset (Finset (Point n)) :=
  strategicClusterFrom law replay.final horizon seed

abbrev StrategicGroupAt {n : Nat} {law : Law} {moves : List (Move n)}
    (_replay : GeneratedReplay law (Frame.initial n) moves) :=
  Finset (Finset (Point n))

def strategicGroupOf {n : Nat} {law : Law} {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves)
    (horizon : Nat) (seed : SnapshotGroup replay.final.visible.board) :
    StrategicGroupAt replay :=
  strategicCluster replay horizon seed

private theorem mem_strategicComponentWorklist_of_mem_seen {n : Nat}
    (law : Law) (current : Frame n) (horizon : Nat)
    (chain : Finset (Point n)) :
    ∀ (fuel : Nat) (pending seen : List (Finset (Point n))),
      chain ∈ seen →
      chain ∈ strategicComponentWorklist law current horizon fuel pending seen := by
  intro fuel
  induction fuel with
  | zero =>
      intro pending seen member
      exact List.mem_toFinset.mpr member
  | succ fuel ih =>
      intro pending seen member
      cases pending with
      | nil => exact List.mem_toFinset.mpr member
      | cons currentChain pending =>
          apply ih
          exact List.mem_append_left _ member

theorem seed_mem_strategicCluster {n : Nat} {law : Law}
    {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves)
    (horizon : Nat) (seed : SnapshotGroup replay.final.visible.board) :
    seed.carrier ∈ strategicCluster replay horizon seed :=
  mem_strategicComponentWorklist_of_mem_seen law replay.final horizon
    seed.carrier _ _ _ (by simp)

end Go
end ProcessGame
end SaturationMonoid
