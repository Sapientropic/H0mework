import H0mework.Versions.Rf9493be3.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.RootedOccurrence

/-!
# Finite same-root Go search exposure

`finiteExposureFrom` unfolds the compiler-generated legal targets to a requested
finite fuel.  It is a possibility readout of the existing rooted occurrence:
it neither appends an actual replay nor stores a completed future table.

Unlike a bare iteration of `RootedAccountedUnfolding.observe`, an empty legal
expansion stays one rooted leaf at every fuel.  This matters at terminal Go
currents: structural `advance` preserves an old leaf before adding a patch, so
blindly advancing `zero terminal` would manufacture a repeated staging root in
the trace.  The legal future cone below replaces generated leaves by their next
legal exposures and therefore has only `LegalStep` edges.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Go

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot

universe u

/-- Structural branch conversion used by finite exposure.  It introduces no
domain event or second occurrence constructor. -/
def exposureBranches {Root : Type u} :
    List (RootedAccountedUnfolding Root) → AccountedBranches Root
  | [] => .nil
  | occurrence :: occurrences =>
      .cons occurrence (exposureBranches occurrences)

@[simp] theorem frontierBranches_exposureBranches {Root : Type u}
    (occurrences : List (RootedAccountedUnfolding Root)) :
    RootedAccountedUnfolding.frontierBranches
        (exposureBranches occurrences) =
      occurrences.flatMap RootedAccountedUnfolding.frontier := by
  induction occurrences with
  | nil => rfl
  | cons occurrence occurrences ih =>
      change occurrence.frontier ++
          RootedAccountedUnfolding.frontierBranches
            (exposureBranches occurrences) =
        occurrence.frontier ++
          occurrences.flatMap RootedAccountedUnfolding.frontier
      rw [ih]

@[simp] theorem traceBranches_exposureBranches {Root : Type u}
    (occurrences : List (RootedAccountedUnfolding Root)) :
    RootedAccountedUnfolding.traceBranches
        (exposureBranches occurrences) =
      occurrences.flatMap RootedAccountedUnfolding.trace := by
  induction occurrences with
  | nil => rfl
  | cons occurrence occurrences ih =>
      change occurrence.trace ++
          RootedAccountedUnfolding.traceBranches
            (exposureBranches occurrences) =
        occurrence.trace ++
          occurrences.flatMap RootedAccountedUnfolding.trace
      rw [ih]

private theorem exposureBranches_zero_eq_possibilityBranches {n : Nat}
    (targets : List (Frame n)) :
    exposureBranches
        (targets.map RootedAccountedUnfolding.zero) =
      possibilityBranches targets := by
  induction targets with
  | nil => rfl
  | cons target targets ih =>
      change AccountedBranches.cons (RootedAccountedUnfolding.zero target)
          (exposureBranches
            (targets.map RootedAccountedUnfolding.zero)) =
        AccountedBranches.cons (RootedAccountedUnfolding.zero target)
          (possibilityBranches targets)
      rw [ih]

/-- Exact finite legal future rooted at `current`.  Fuel zero is the existing
framework's zero observation.  Positive fuel exposes all and only compiler
generated targets, recursively; an empty expansion remains a rooted leaf. -/
def finiteExposureFrom {n : Nat} (law : Law) :
    Nat → Frame n → RootedAccountedUnfolding (Frame n)
  | 0, current =>
      RootedAccountedUnfolding.observe (possibilityStep law) current 0
  | fuel + 1, current =>
      .occur current
        (exposureBranches
          ((legalTargets law current).map
            (finiteExposureFrom law fuel)))

/-- One more fuel unit is generated by recursively replacing each exact legal
target leaf with that target's previous-fuel exposure. -/
theorem finiteExposureFrom_succ_generated {n : Nat} (law : Law)
    (fuel : Nat) (current : Frame n) :
    finiteExposureFrom law (fuel + 1) current =
      .occur current
        (exposureBranches
          ((legalTargets law current).map
            (finiteExposureFrom law fuel))) :=
  rfl

@[simp] theorem finiteExposureFrom_zero {n : Nat} (law : Law)
    (current : Frame n) :
    finiteExposureFrom law 0 current =
      RootedAccountedUnfolding.zero current :=
  rfl

private theorem map_finiteExposureFrom_zero_eq_zero {n : Nat}
    (law : Law) (targets : List (Frame n)) :
    targets.map (finiteExposureFrom law 0) =
      targets.map RootedAccountedUnfolding.zero := by
  induction targets with
  | nil => rfl
  | cons target targets ih =>
      change RootedAccountedUnfolding.zero target ::
          targets.map (finiteExposureFrom law 0) =
        RootedAccountedUnfolding.zero target ::
          targets.map RootedAccountedUnfolding.zero
      rw [ih]

@[simp] theorem finiteExposureFrom_root {n : Nat} (law : Law)
    (fuel : Nat) (current : Frame n) :
    (finiteExposureFrom law fuel current).root = current := by
  cases fuel <;> rfl

@[simp] theorem finiteExposureFrom_zero_frontier {n : Nat} (law : Law)
    (current : Frame n) :
    (finiteExposureFrom law 0 current).frontier = [current] :=
  rfl

@[simp] theorem finiteExposureFrom_zero_trace {n : Nat} (law : Law)
    (current : Frame n) :
    (finiteExposureFrom law 0 current).trace = [current] :=
  rfl

/-- A zero-fuel rooted leaf is an observation-budget boundary, not a terminal
classifier: the generated initial current is a rooted leaf while still
playing. -/
theorem initial_zero_fuel_is_playing_leaf (law : Law) (n : Nat) :
    (finiteExposureFrom law 0 (Frame.initial n)).frontier =
        [Frame.initial n] ∧
      (Frame.initial n).visible.status = .playing :=
  ⟨rfl, rfl⟩

theorem finiteExposureFrom_frontier_ne_nil {n : Nat} (law : Law)
    (fuel : Nat) (current : Frame n) :
    (finiteExposureFrom law fuel current).frontier ≠ [] :=
  RootedAccountedUnfolding.frontier_ne_nil _

/-- The first positive layer is exactly the G3 same-root possibility mouth,
not a sibling legal-expansion implementation. -/
theorem finiteExposureFrom_one_eq_possibilityStep {n : Nat} (law : Law)
    (current : Frame n) :
    finiteExposureFrom law 1 current = possibilityStep law current := by
  unfold finiteExposureFrom possibilityStep
  rw [map_finiteExposureFrom_zero_eq_zero]
  rw [exposureBranches_zero_eq_possibilityBranches]

theorem finiteExposureFrom_trace_succ {n : Nat} (law : Law)
    (fuel : Nat) (current : Frame n) :
    (finiteExposureFrom law (fuel + 1) current).trace =
      current :: (legalTargets law current).flatMap
        (fun target => (finiteExposureFrom law fuel target).trace) := by
  change current ::
      RootedAccountedUnfolding.traceBranches
        (exposureBranches
          ((legalTargets law current).map
            (finiteExposureFrom law fuel))) = _
  rw [traceBranches_exposureBranches, List.flatMap_map]

theorem finiteExposureFrom_frontier_succ {n : Nat} (law : Law)
    (fuel : Nat) (current : Frame n) :
    (finiteExposureFrom law (fuel + 1) current).frontier =
      match legalTargets law current with
      | [] => [current]
      | _ :: _ =>
          (legalTargets law current).flatMap
            (fun target => (finiteExposureFrom law fuel target).frontier) := by
  unfold finiteExposureFrom
  cases targetsEq : legalTargets law current with
  | nil =>
      rfl
  | cons target targets =>
      change RootedAccountedUnfolding.frontierBranches
          (exposureBranches
            ((target :: targets).map (finiteExposureFrom law fuel))) = _
      rw [frontierBranches_exposureBranches, List.flatMap_map]
      cases fuel <;> rfl

/-- Empty legal expansion is not world terminal authority.  It remains a
nonempty rooted leaf at every finite observation fuel. -/
theorem finiteExposureFrom_eq_zero_of_terminal {n : Nat} (law : Law)
    (current : Frame n) (reason : TerminalReason)
    (terminal : current.visible.status = .terminal reason) :
    ∀ fuel, finiteExposureFrom law fuel current =
      RootedAccountedUnfolding.zero current := by
  intro fuel
  cases fuel with
  | zero => rfl
  | succ fuel =>
      have expansionEmpty :=
        legalExpansion_eq_nil_of_terminal law current reason terminal
      simp [finiteExposureFrom, legalTargets, expansionEmpty,
        exposureBranches, RootedAccountedUnfolding.zero]

theorem finiteExposureFrom_terminal_frontier {n : Nat} (law : Law)
    (current : Frame n) (reason : TerminalReason)
    (terminal : current.visible.status = .terminal reason)
    (fuel : Nat) :
    (finiteExposureFrom law fuel current).frontier = [current] := by
  rw [finiteExposureFrom_eq_zero_of_terminal law current reason terminal fuel]
  rfl

theorem finiteExposureFrom_terminal_trace {n : Nat} (law : Law)
    (current : Frame n) (reason : TerminalReason)
    (terminal : current.visible.status = .terminal reason)
    (fuel : Nat) :
    (finiteExposureFrom law fuel current).trace = [current] := by
  rw [finiteExposureFrom_eq_zero_of_terminal law current reason terminal fuel]
  rfl

/-- Trace-list fold algebra for the one existing occurrence constructor. -/
def futureConeTraceAlgebra {n : Nat} (current : Frame n)
    (childTraces : List (List (Frame n))) : List (Frame n) :=
  current :: childTraces.flatten

mutual

theorem fold_futureConeTraceAlgebra_eq_trace {n : Nat}
    (occurrence : RootedAccountedUnfolding (Frame n)) :
    occurrence.fold futureConeTraceAlgebra = occurrence.trace := by
  cases occurrence with
  | occur current branches =>
      change current ::
          (RootedAccountedUnfolding.foldBranches
            futureConeTraceAlgebra branches).flatten =
        current :: RootedAccountedUnfolding.traceBranches branches
      exact congrArg (List.cons current)
        (foldBranches_futureConeTraceAlgebra_eq_traceBranches branches)

theorem foldBranches_futureConeTraceAlgebra_eq_traceBranches {n : Nat}
    (branches : AccountedBranches (Frame n)) :
    (RootedAccountedUnfolding.foldBranches
        futureConeTraceAlgebra branches).flatten =
      RootedAccountedUnfolding.traceBranches branches := by
  cases branches with
  | nil => rfl
  | cons head tail =>
      change head.fold futureConeTraceAlgebra ++
          (RootedAccountedUnfolding.foldBranches
            futureConeTraceAlgebra tail).flatten =
        head.trace ++ RootedAccountedUnfolding.traceBranches tail
      rw [fold_futureConeTraceAlgebra_eq_trace head,
        foldBranches_futureConeTraceAlgebra_eq_traceBranches tail]

end

/-- Replay-indexed finite future cone.  The replay supplies the exact current
and same-root provenance; only `fuel` controls finite possibility exposure. -/
def futureConeAt {n : Nat} {law : Law} {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) (fuel : Nat) :
    RootedAccountedUnfolding (Frame n) :=
  finiteExposureFrom law fuel replay.final

@[simp] theorem futureConeAt_root {n : Nat} {law : Law}
    {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) (fuel : Nat) :
    (futureConeAt replay fuel).root = replay.final :=
  finiteExposureFrom_root law fuel replay.final

theorem futureConeAt_one_eq_rootedPossibilityAt {n : Nat} {law : Law}
    {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) :
    futureConeAt replay 1 = rootedPossibilityAt replay :=
  finiteExposureFrom_one_eq_possibilityStep law replay.final

theorem futureConeAt_fold_eq_trace {n : Nat} {law : Law}
    {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) (fuel : Nat) :
    (futureConeAt replay fuel).fold futureConeTraceAlgebra =
      (futureConeAt replay fuel).trace :=
  fold_futureConeTraceAlgebra_eq_trace _

/-- Trace-monotone prefix relation for finite possibility exposures.  DFS
insertion means the old trace need not be a literal `List.IsPrefix`; every
previously generated occurrence and the exact root are preserved. -/
def ExposurePrefix {Root : Type u}
    (earlier later : RootedAccountedUnfolding Root) : Prop :=
  earlier.root = later.root ∧
    ∀ root, root ∈ earlier.trace → root ∈ later.trace

theorem ExposurePrefix.refl {Root : Type u}
    (occurrence : RootedAccountedUnfolding Root) :
    ExposurePrefix occurrence occurrence :=
  ⟨rfl, fun _ member => member⟩

theorem ExposurePrefix.trans {Root : Type u}
    {first middle last : RootedAccountedUnfolding Root}
    (firstMiddle : ExposurePrefix first middle)
    (middleLast : ExposurePrefix middle last) :
    ExposurePrefix first last := by
  exact ⟨firstMiddle.1.trans middleLast.1,
    fun root member => middleLast.2 root (firstMiddle.2 root member)⟩

private theorem finiteExposureFrom_trace_mem_succ {n : Nat} (law : Law) :
    ∀ (fuel : Nat) (current root : Frame n),
      root ∈ (finiteExposureFrom law fuel current).trace →
        root ∈ (finiteExposureFrom law (fuel + 1) current).trace := by
  intro fuel
  induction fuel with
  | zero =>
      intro current root member
      rw [finiteExposureFrom_one_eq_possibilityStep,
        possibilityStep_trace]
      simp only [finiteExposureFrom_zero,
        GeneratedReplay.trace_zero, List.mem_singleton] at member
      simp [member]
  | succ fuel ih =>
      intro current root member
      rw [finiteExposureFrom_trace_succ] at member
      rw [finiteExposureFrom_trace_succ]
      rcases List.mem_cons.mp member with rootEq | childMember
      · exact List.mem_cons.mpr (Or.inl rootEq)
      · apply List.mem_cons.mpr
        apply Or.inr
        rcases List.mem_flatMap.mp childMember with
          ⟨target, targetMem, rootMem⟩
        exact List.mem_flatMap.mpr
          ⟨target, targetMem, ih target root rootMem⟩

/-- Increasing fuel by one preserves the same root and every generated trace
node, while the successor layer is still built only from legal expansion. -/
theorem finiteExposureFrom_fuel_step_prefix {n : Nat} (law : Law)
    (fuel : Nat) (current : Frame n) :
    ExposurePrefix (finiteExposureFrom law fuel current)
      (finiteExposureFrom law (fuel + 1) current) := by
  exact ⟨by simp, finiteExposureFrom_trace_mem_succ law fuel current⟩

theorem finiteExposureFrom_fuel_mono {n : Nat} (law : Law)
    {earlier later : Nat} (fuelLe : earlier ≤ later)
    (current : Frame n) :
    ExposurePrefix (finiteExposureFrom law earlier current)
      (finiteExposureFrom law later current) := by
  obtain ⟨extra, laterEq⟩ := Nat.le.dest fuelLe
  have addPrefix : ∀ extra : Nat,
      ExposurePrefix (finiteExposureFrom law earlier current)
        (finiteExposureFrom law (earlier + extra) current) := by
    intro extra
    induction extra with
    | zero =>
        simpa using ExposurePrefix.refl
          (finiteExposureFrom law earlier current)
    | succ extra ih =>
        rw [Nat.add_succ]
        exact ExposurePrefix.trans ih
          (finiteExposureFrom_fuel_step_prefix law (earlier + extra) current)
  rw [← laterEq]
  exact addPrefix extra

/- Exact legality of every parent-child edge in a finite exposure. -/
mutual

inductive LegalExposure {n : Nat} (law : Law) :
    RootedAccountedUnfolding (Frame n) → Prop where
  | occur {current : Frame n} {branches : AccountedBranches (Frame n)}
      (branchesLegal : LegalExposureBranches law current branches) :
      LegalExposure law (.occur current branches)

inductive LegalExposureBranches {n : Nat} (law : Law) :
    Frame n → AccountedBranches (Frame n) → Prop where
  | nil (parent : Frame n) : LegalExposureBranches law parent .nil
  | cons {parent : Frame n}
      {child : RootedAccountedUnfolding (Frame n)}
      {tail : AccountedBranches (Frame n)}
      (edge : ∃ move, LegalStep law parent move child.root)
      (childLegal : LegalExposure law child)
      (tailLegal : LegalExposureBranches law parent tail) :
      LegalExposureBranches law parent (.cons child tail)

end

theorem mem_legalTargets_iff {n : Nat} {law : Law}
    {current target : Frame n} :
    target ∈ legalTargets law current ↔
      ∃ move, LegalStep law current move target := by
  constructor
  · intro member
    rcases List.mem_map.mp member with ⟨pair, pairMem, targetEq⟩
    exact ⟨pair.1, by
      simpa [targetEq] using
        (legalExpansion_sound (current := current) pairMem)⟩
  · rintro ⟨move, step⟩
    exact List.mem_map.mpr
      ⟨(move, target), legalExpansion_complete step, rfl⟩

private theorem legalExposureBranches_of_targets {n : Nat} (law : Law)
    (fuel : Nat) (parent : Frame n) :
    ∀ targets : List (Frame n),
      (∀ target, target ∈ targets →
        LegalExposure law (finiteExposureFrom law fuel target)) →
      (∀ target, target ∈ targets →
        ∃ move, LegalStep law parent move target) →
      LegalExposureBranches law parent
        (exposureBranches
          (targets.map (finiteExposureFrom law fuel))) := by
  intro targets
  induction targets with
  | nil =>
      intro _childrenLegal _edges
      exact LegalExposureBranches.nil parent
  | cons target targets ih =>
      intro childrenLegal edges
      apply LegalExposureBranches.cons
      · simpa using edges target (List.mem_cons_self)
      · exact childrenLegal target (List.mem_cons_self)
      · apply ih
        · intro child childMem
          exact childrenLegal child (List.mem_cons_of_mem target childMem)
        · intro child childMem
          exact edges child (List.mem_cons_of_mem target childMem)

/-- Every edge in the generated finite cone is one exact image of the fixed
`nativeStep?`; no caller target or search-only stutter enters the path. -/
theorem finiteExposureFrom_legal {n : Nat} (law : Law) :
    ∀ (fuel : Nat) (current : Frame n),
      LegalExposure law (finiteExposureFrom law fuel current) := by
  intro fuel
  induction fuel with
  | zero =>
      intro current
      exact .occur (LegalExposureBranches.nil current)
  | succ fuel ih =>
      intro current
      apply LegalExposure.occur
      apply legalExposureBranches_of_targets law fuel current
      · intro target _targetMem
        exact ih target
      · intro target targetMem
        exact mem_legalTargets_iff.mp targetMem

theorem futureConeAt_legal {n : Nat} {law : Law}
    {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves) (fuel : Nat) :
    LegalExposure law (futureConeAt replay fuel) :=
  finiteExposureFrom_legal law fuel replay.final

/-- The chosen actual child is generated in the old cone, and its extension
starts a new finite cone at exactly that compiler-generated target. -/
theorem actualPly_target_mem_futureCone_one_frontier {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replay) :
    ply.target ∈ (futureConeAt replay 1).frontier := by
  rw [futureConeAt_one_eq_rootedPossibilityAt]
  exact actualPly_target_mem_frontier ply

theorem actualPly_extended_generates_new_futureCone {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replay) (fuel : Nat) :
    futureConeAt ply.extended fuel =
      finiteExposureFrom law fuel ply.target := by
  unfold futureConeAt
  rw [show ply.extended.final = ply.target from
    replay.snoc_final ply.emitted ply.step]

theorem actualPly_extended_futureCone_root {n : Nat} {law : Law}
    {moves : List (Move n)}
    {replay : GeneratedReplay law (Frame.initial n) moves}
    (ply : GeneratedReplay.ActualPly replay) (fuel : Nat) :
    (futureConeAt ply.extended fuel).root = ply.target := by
  rw [futureConeAt_root]
  exact replay.snoc_final ply.emitted ply.step

/-- Search fuel and unselected branches have no write mouth into the actual
replay.  The actual trace, superko ledger and generated dancers stay indexed
by the unchanged replay. -/
theorem futureCone_actual_noninterference {n : Nat} {law : Law}
    {moves : List (Move n)}
    (replay : GeneratedReplay law (Frame.initial n) moves)
    (fuel : Nat) :
    (futureConeAt replay fuel).root = replay.final ∧
      replay.toOccurrence.trace = replay.stateTrace ∧
      replay.toOccurrence.trace.map
          (fun frame => frame.visible.situation) =
        replay.final.positionHistory ∧
      Nonempty (GeneratedDancersAt replay) := by
  exact ⟨futureConeAt_root replay fuel,
    replay.occurrence_trace_eq_stateTrace,
    generated_occurrence_situations_eq_positionHistory replay,
    ⟨generatedDancersAt replay⟩⟩

/-! `advance` remains the framework's provenance-preserving structural
scheduler.  Its associativity is consumed here as the exact law for staging
two generated possibility patches.  `finiteExposureFrom` itself contracts
that staging seam, so its trace contains only legal Go edges. -/

theorem possibilityAdvance_assoc {n : Nat} (law : Law)
    (occurrence : RootedAccountedUnfolding (Frame n)) :
    (occurrence.advance (possibilityStep law)).advance
        (possibilityStep law) =
      occurrence.advance (fun current =>
        (possibilityStep law current).advance (possibilityStep law)) :=
  RootedAccountedUnfolding.advance_assoc
    (possibilityStep law) (possibilityStep law) occurrence

end Go
end ProcessGame
end SaturationMonoid
