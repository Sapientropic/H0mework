import H0mework.Versions.Rf9493be3.ReleaseMaterials.SaturationMonoid.ProcessGame.Go.ReplayContinuation

/-!
# Players generated by the actual control lineage

The Go rule kernel contains only two unnamed control polarities.  This module
does not add a primitive `Player`: it folds the actual singleton occurrence to
recover the mover channel at every emitted step, aligns that fold with the
exact `Move` index already carried by `GeneratedReplay`, and defines players as
the two resulting lineage carriers.  Black/White names are therefore gauges
on generated lineages, not source data.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Go

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot

/-- One actual move together with the unnamed control channel generated at
its source current.  The move remains the exact `GeneratedReplay` event. -/
structure ControlEvent (n : Nat) where
  mover : Polarity
  move : Move n
  deriving DecidableEq, Repr

/-- The actual-control algebra on the shared occurrence.  A leaf emits no
move.  Every generated child contributes one use of the current control
channel followed by that child's lineage.  G2 applies this to G1's singleton
actual spine; possibility siblings have no actual-ledger authority. -/
private def moverAlgebra {n : Nat} (current : Frame n)
    (childMovers : List (List Polarity)) : List Polarity :=
  childMovers.flatMap (fun child => current.visible.toMove :: child)

namespace GeneratedReplay

/-- Mover channels are a fold of the same G1 occurrence, not a stored player
table. -/
def moverFold {n : Nat} {law : Law} {start : Frame n}
    {moves : List (Move n)} (replay : GeneratedReplay law start moves) :
    List Polarity :=
  replay.toOccurrence.fold moverAlgebra

@[simp] theorem moverFold_nil {n : Nat} {law : Law} (start : Frame n) :
    (GeneratedReplay.nil (law := law) start).moverFold = [] :=
  rfl

@[simp] theorem moverFold_cons {n : Nat} {law : Law}
    {start next : Frame n} {moves : List (Move n)}
    (move : Move n) (step : LegalStep law start move next)
    (tail : GeneratedReplay law next moves) :
    (GeneratedReplay.cons move step tail).moverFold =
      start.visible.toMove :: tail.moverFold :=
  by
    simp [moverFold, toOccurrence, moverAlgebra,
      AccountedBranches.singleton, RootedAccountedUnfolding.fold,
      RootedAccountedUnfolding.foldBranches]

/-- Exact replay events, with mover polarity read from each event's source
current. -/
def actualEvents {n : Nat} {law : Law} {start : Frame n}
    {moves : List (Move n)} :
    GeneratedReplay law start moves → List (ControlEvent n)
  | .nil _ => []
  | @GeneratedReplay.cons _ _ start _ _ move _ tail =>
      { mover := start.visible.toMove, move := move } :: tail.actualEvents

@[simp] theorem actualEvents_map_move {n : Nat} {law : Law}
    {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves) :
    replay.actualEvents.map ControlEvent.move = moves := by
  induction replay with
  | nil => rfl
  | cons move step tail ih =>
      simp [actualEvents, ih]

/-- The event-side mover list is definitionally governed by the same
occurrence fold. -/
@[simp] theorem actualEvents_map_mover_eq_moverFold {n : Nat} {law : Law}
    {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves) :
    replay.actualEvents.map ControlEvent.mover = replay.moverFold := by
  induction replay with
  | nil => rfl
  | cons move step tail ih =>
      simp [actualEvents, ih]

@[simp] theorem moverFold_length {n : Nat} {law : Law}
    {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves) :
    replay.moverFold.length = moves.length := by
  calc
    replay.moverFold.length =
        (replay.actualEvents.map ControlEvent.mover).length := by
      rw [replay.actualEvents_map_mover_eq_moverFold]
    _ = replay.actualEvents.length := by simp only [List.length_map]
    _ = (replay.actualEvents.map ControlEvent.move).length := by
      simp only [List.length_map]
    _ = moves.length := by rw [replay.actualEvents_map_move]

/-- Direct use of the universal evaluator uniqueness law: every candidate
commuting with the sole occurrence constructor is this mover fold. -/
private theorem moverEvaluator_eq_moverFold {n : Nat} {law : Law}
    {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves)
    (candidate : RootedAccountedUnfolding (Frame n) → List Polarity)
    (commutes : ∀ (origin : Frame n)
        (branches : AccountedBranches (Frame n)),
      candidate (.occur origin branches) =
        moverAlgebra origin
          (RootedAccountedUnfolding.candidateValues candidate branches)) :
    candidate replay.toOccurrence = replay.moverFold := by
  simpa [moverFold] using
    (RootedAccountedUnfolding.fold_unique moverAlgebra candidate commutes
      replay.toOccurrence)

/-- The mover of an exact move occurrence.  Occurrences, rather than equal
move values, are indexed by their position in the source-emitted list. -/
def moverAt {n : Nat} {law : Law} {start : Frame n}
    {moves : List (Move n)} (replay : GeneratedReplay law start moves)
    (index : Fin moves.length) : Polarity :=
  replay.moverFold.get ⟨index.val, by
    rw [replay.moverFold_length]
    exact index.isLt⟩

/-- Exact event readout at a source occurrence index. -/
def eventAt {n : Nat} {law : Law} {start : Frame n}
    {moves : List (Move n)} (replay : GeneratedReplay law start moves)
    (index : Fin moves.length) : ControlEvent n where
  mover := replay.moverAt index
  move := moves.get index

@[simp] theorem eventAt_mover {n : Nat} {law : Law} {start : Frame n}
    {moves : List (Move n)} (replay : GeneratedReplay law start moves)
    (index : Fin moves.length) :
    (replay.eventAt index).mover = replay.moverAt index :=
  rfl

@[simp] theorem eventAt_move {n : Nat} {law : Law} {start : Frame n}
    {moves : List (Move n)} (replay : GeneratedReplay law start moves)
    (index : Fin moves.length) :
    (replay.eventAt index).move = moves.get index :=
  rfl

/-- Event subsequence generated by one unnamed control channel. -/
def lineageEvents {n : Nat} {law : Law} {start : Frame n}
    {moves : List (Move n)} (replay : GeneratedReplay law start moves)
    (control : Polarity) : List (ControlEvent n) :=
  replay.actualEvents.filter (fun event => event.mover = control)

/-- A player lineage is a generated event carrier plus its unnamed control
seed.  The seed keeps the two channels distinct even when one or both event
subsequences are empty. -/
structure GeneratedPlayerLineage {n : Nat} {law : Law} {start : Frame n}
    {moves : List (Move n)} (replay : GeneratedReplay law start moves) where
  control : Polarity
  events : List (ControlEvent n)
  events_eq : events = replay.lineageEvents control

/-- The canonical lineage generated for one control channel. -/
def lineage {n : Nat} {law : Law} {start : Frame n}
    {moves : List (Move n)} (replay : GeneratedReplay law start moves)
    (control : Polarity) : GeneratedPlayerLineage replay where
  control := control
  events := replay.lineageEvents control
  events_eq := rfl

@[simp] theorem lineage_control {n : Nat} {law : Law}
    {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves) (control : Polarity) :
    (replay.lineage control).control = control :=
  rfl

/-- `GeneratedPlayer` is the image of the two occurrence-generated lineage
carriers.  It is not an independently declared player enumeration. -/
def GeneratedPlayer {n : Nat} {law : Law} {start : Frame n}
    {moves : List (Move n)} (replay : GeneratedReplay law start moves) :=
  { candidate : GeneratedPlayerLineage replay //
    ∃ control, candidate = replay.lineage control }

/-- Generated-player readout for an unnamed control channel. -/
def player {n : Nat} {law : Law} {start : Frame n}
    {moves : List (Move n)} (replay : GeneratedReplay law start moves)
    (control : Polarity) : GeneratedPlayer replay :=
  ⟨replay.lineage control, ⟨control, rfl⟩⟩

/-- The two generated lineages receive a polarity gauge only after generation. -/
def generatedPlayerEquiv {n : Nat} {law : Law} {start : Frame n}
    {moves : List (Move n)} (replay : GeneratedReplay law start moves) :
    Polarity ≃ GeneratedPlayer replay where
  toFun := replay.player
  invFun := fun generated => generated.1.control
  left_inv := by
    intro control
    rfl
  right_inv := by
    rintro ⟨candidate, ⟨control, h⟩⟩
    subst candidate
    rfl

/-- Ownership is a relation between an exact event occurrence and a generated
lineage carrier. -/
def EventOwnedBy {n : Nat} {law : Law} {start : Frame n}
    {moves : List (Move n)} (replay : GeneratedReplay law start moves)
    (index : Fin moves.length) (generated : GeneratedPlayer replay) : Prop :=
  generated.1.control = replay.moverAt index

instance eventOwnedByDecidable {n : Nat} {law : Law} {start : Frame n}
    {moves : List (Move n)} (replay : GeneratedReplay law start moves)
    (index : Fin moves.length) (generated : GeneratedPlayer replay) :
    Decidable (replay.EventOwnedBy index generated) := by
  unfold EventOwnedBy
  infer_instance

/-- Canonical owner generated by the same mover fold. -/
def generatedOwner {n : Nat} {law : Law} {start : Frame n}
    {moves : List (Move n)} (replay : GeneratedReplay law start moves)
    (index : Fin moves.length) : GeneratedPlayer replay :=
  replay.player (replay.moverAt index)

/-- Every exact actual move occurrence belongs to exactly one generated
player lineage. -/
theorem everyMoveOwnedByExactlyOneGeneratedPlayer {n : Nat} {law : Law}
    {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves) (index : Fin moves.length) :
    ∃! generated : GeneratedPlayer replay,
      replay.EventOwnedBy index generated := by
  refine ⟨replay.generatedOwner index, rfl, ?_⟩
  intro candidate owned
  rcases replay.generatedPlayerEquiv.surjective candidate with ⟨control, rfl⟩
  change control = replay.moverAt index at owned
  subst control
  rfl

/-- The exact-owner map supplies the generated player partition. -/
theorem playerPartitionExists {n : Nat} {law : Law}
    {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves) :
    ∃ owner : Fin moves.length → GeneratedPlayer replay,
      ∀ index,
        replay.EventOwnedBy index (owner index) ∧
        ∀ candidate, replay.EventOwnedBy index candidate →
          candidate = owner index := by
  refine ⟨replay.generatedOwner, ?_⟩
  intro index
  constructor
  · rfl
  · intro candidate owned
    exact (replay.everyMoveOwnedByExactlyOneGeneratedPlayer index).unique owned rfl

/-- The occurrence-indexed carrier of moves owned by one generated player.
It can be empty without erasing that generated control lineage. -/
def PlayerMoveCarrier {n : Nat} {law : Law} {start : Frame n}
    {moves : List (Move n)} (replay : GeneratedReplay law start moves)
    (generated : GeneratedPlayer replay) :=
  { index : Fin moves.length // replay.EventOwnedBy index generated }

/-- Carrier membership is indexed by the exact emitted ply, never by equality
of `Move` values.  Repeated passes therefore remain distinct occurrences. -/
theorem eventOwnedBy_iff_exactPly_mem_playerMoveCarrier {n : Nat}
    {law : Law} {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves) (index : Fin moves.length)
    (generated : GeneratedPlayer replay) :
    replay.EventOwnedBy index generated ↔
      ∃ owned : PlayerMoveCarrier replay generated, owned.1 = index := by
  constructor
  · intro owned
    exact ⟨⟨index, owned⟩, rfl⟩
  · rintro ⟨⟨ownedIndex, owned⟩, equalIndex⟩
    cases equalIndex
    exact owned

/-- The two-element gauge action.  `false` preserves a presentation and
`true` swaps its two names. -/
def z2Swap (swap label : Bool) : Bool :=
  match swap with
  | false => label
  | true => !label

@[simp] theorem z2Swap_false (label : Bool) : z2Swap false label = label :=
  rfl

@[simp] theorem z2Swap_true (label : Bool) : z2Swap true label = !label :=
  rfl

private theorem bool_eq_not_of_ne {left right : Bool}
    (different : left ≠ right) : left = !right := by
  cases left <;> cases right <;> simp_all

private theorem z2Swap_injective_at (label : Bool) :
    Function.Injective (fun swap => z2Swap swap label) := by
  intro left right equal
  cases left <;> cases right <;> simp_all [z2Swap]

private theorem polarityPresentations_uniqueUpToSwap
    (left right : Polarity → Bool)
    (left_injective : Function.Injective left)
    (right_injective : Function.Injective right) :
    ∃! swap : Bool, ∀ control,
      right control = z2Swap swap (left control) := by
  have left_ne : left .negative ≠ left .positive := by
    intro equal
    have impossible := left_injective equal
    cases impossible
  have right_ne : right .negative ≠ right .positive := by
    intro equal
    have impossible := right_injective equal
    cases impossible
  have left_negative : left .negative = !left .positive :=
    bool_eq_not_of_ne left_ne
  have right_negative : right .negative = !right .positive :=
    bool_eq_not_of_ne right_ne
  by_cases samePositive : right .positive = left .positive
  · refine ⟨false, ?_, ?_⟩
    · intro control
      cases control with
      | positive => simpa using samePositive
      | negative =>
          calc
            right .negative = !right .positive := right_negative
            _ = !left .positive := congrArg (fun value => !value) samePositive
            _ = left .negative := left_negative.symm
            _ = z2Swap false (left .negative) := rfl
    · intro other otherWorks
      apply z2Swap_injective_at (left .positive)
      calc
        z2Swap other (left .positive) = right .positive :=
          (otherWorks .positive).symm
        _ = z2Swap false (left .positive) := by simpa using samePositive
  · have oppositePositive : right .positive = !left .positive :=
      bool_eq_not_of_ne samePositive
    refine ⟨true, ?_, ?_⟩
    · intro control
      cases control with
      | positive => exact oppositePositive
      | negative =>
          calc
            right .negative = !right .positive := right_negative
            _ = !(!left .positive) :=
              congrArg (fun value => !value) oppositePositive
            _ = !left .negative := by rw [left_negative]
            _ = z2Swap true (left .negative) := rfl
    · intro other otherWorks
      apply z2Swap_injective_at (left .positive)
      calc
        z2Swap other (left .positive) = right .positive :=
          (otherWorks .positive).symm
        _ = z2Swap true (left .positive) := oppositePositive

/-- An anonymous Black/White-style naming of the two generated lineage
carriers.  Only the post-generation bijective label is supplied. -/
structure AnonymousPlayerPresentation {n : Nat} {law : Law}
    {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves) where
  label : GeneratedPlayer replay → Bool
  label_injective : Function.Injective label

/-- Any two anonymous two-class presentations of the generated players differ
by one unique `Z2` swap. -/
theorem playerPartitionUniqueUpToSwap {n : Nat} {law : Law}
    {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves)
    (left right : AnonymousPlayerPresentation replay) :
    ∃! swap : Bool, ∀ generated,
      right.label generated = z2Swap swap (left.label generated) := by
  have leftControlInjective :
      Function.Injective (fun control => left.label (replay.player control)) := by
    intro first second equal
    exact replay.generatedPlayerEquiv.injective (left.label_injective equal)
  have rightControlInjective :
      Function.Injective (fun control => right.label (replay.player control)) := by
    intro first second equal
    exact replay.generatedPlayerEquiv.injective (right.label_injective equal)
  rcases polarityPresentations_uniqueUpToSwap
      (fun control => left.label (replay.player control))
      (fun control => right.label (replay.player control))
      leftControlInjective rightControlInjective with
    ⟨swap, works, unique⟩
  refine ⟨swap, ?_, ?_⟩
  · intro generated
    rcases replay.generatedPlayerEquiv.surjective generated with ⟨control, rfl⟩
    exact works control
  · intro other otherWorks
    apply unique other
    intro control
    exact otherWorks (replay.player control)

@[simp] theorem actualEvents_snoc {n : Nat} {law : Law}
    {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves) {next : Frame n}
    (move : Move n) (step : LegalStep law replay.final move next) :
    (replay.snoc move step).actualEvents =
      replay.actualEvents ++
        [{ mover := replay.final.visible.toMove, move := move }] := by
  induction replay with
  | nil => rfl
  | cons first firstStep tail ih =>
      simp [snoc, actualEvents, GeneratedReplay.final, ih step]

@[simp] theorem moverFold_snoc {n : Nat} {law : Law}
    {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves) {next : Frame n}
    (move : Move n) (step : LegalStep law replay.final move next) :
    (replay.snoc move step).moverFold =
      replay.moverFold ++ [replay.final.visible.toMove] := by
  induction replay with
  | nil => rfl
  | cons first firstStep tail ih =>
      simp [snoc, GeneratedReplay.final, ih step]

@[simp] theorem lineageEvents_snoc {n : Nat} {law : Law}
    {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves) {next : Frame n}
    (move : Move n) (step : LegalStep law replay.final move next)
    (control : Polarity) :
    (replay.snoc move step).lineageEvents control =
      replay.lineageEvents control ++
        if replay.final.visible.toMove = control then
          [{ mover := replay.final.visible.toMove, move := move }]
        else
          [] := by
  by_cases owned : replay.final.visible.toMove = control
  · simp [lineageEvents, actualEvents_snoc, owned]
  · simp [lineageEvents, actualEvents_snoc, owned]

/-- Advancing the actual occurrence preserves each generated player's entire
old event lineage as a prefix; the new event can only append to its unique
owner. -/
theorem playerLineageSurvivesAdvance {n : Nat} {law : Law}
    {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves) {next : Frame n}
    (move : Move n) (step : LegalStep law replay.final move next)
    (control : Polarity) :
    replay.lineageEvents control <+:
      (replay.snoc move step).lineageEvents control := by
  rw [replay.lineageEvents_snoc move step control]
  exact List.prefix_append _ _

/-- The generated-player transport along one actual advance follows the same
unnamed control lineage; it does not consult a player registry. -/
def transportGeneratedPlayerAlongAdvance {n : Nat} {law : Law}
    {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves) {next : Frame n}
    (move : Move n) (step : LegalStep law replay.final move next)
    (generated : GeneratedPlayer replay) :
    GeneratedPlayer (replay.snoc move step) :=
  (replay.snoc move step).player generated.1.control

@[simp] theorem transportGeneratedPlayerAlongAdvance_control {n : Nat}
    {law : Law} {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves) {next : Frame n}
    (move : Move n) (step : LegalStep law replay.final move next)
    (generated : GeneratedPlayer replay) :
    (replay.transportGeneratedPlayerAlongAdvance move step generated).1.control =
      generated.1.control :=
  rfl

/-- Explicit generated-player transport preserves the old carrier's event
list as a prefix of the transported carrier. -/
theorem generatedPlayerLineageSurvivesAdvance {n : Nat} {law : Law}
    {start : Frame n} {moves : List (Move n)}
    (replay : GeneratedReplay law start moves) {next : Frame n}
    (move : Move n) (step : LegalStep law replay.final move next)
    (generated : GeneratedPlayer replay) :
    generated.1.events <+:
      (replay.transportGeneratedPlayerAlongAdvance move step generated).1.events := by
  rcases generated with ⟨candidate, ⟨control, generated_eq⟩⟩
  subst candidate
  exact replay.playerLineageSurvivesAdvance move step control

end GeneratedReplay

end Go
end ProcessGame
end SaturationMonoid
