attribute [local irreducible] emInsertion originalChange originalReadback contactInverse activeKernel

/-- The window is generated by original static regularity and the already proved whole-Green domination radius. -/
def emSourceIRRadius : ℝ := min staticRadius (Classical.choose em_static_green_uniform_bound)

theorem em_source_ir_radius_positive : 0 < emSourceIRRadius :=
  lt_min staticRadius_pos (Classical.choose_spec em_static_green_uniform_bound).1

private def emSpatialDirection (k : PhysicalMomentum) : PhysicalMomentum :=
  (Real.sqrt (spatialSquare k))⁻¹ • k

private theorem em_direction_unit (k : PhysicalMomentum) (positive : 0 < spatialSquare k) :
    spatialSquare (emSpatialDirection k)=1 := by
  have rp : Real.sqrt (spatialSquare k)≠0 := (Real.sqrt_pos.mpr positive).ne'
  have square:=Real.sq_sqrt positive.le
  calc
    _=(Real.sqrt (spatialSquare k))⁻¹^2*spatialSquare k := by
      simp only [emSpatialDirection,spatialSquare,Pi.smul_apply,smul_eq_mul]
      ring
    _=1 := by field_simp [rp];exact square.symm

private theorem em_spatial_ray_same (k : PhysicalMomentum) (scale radius : ℝ) (nonzero : radius≠0) :
    sourceStaticSpatialMomentum k scale=
      sourceStaticSpatialMomentum (radius⁻¹ • k) (scale*radius) := by
  ext j
  fin_cases j <;> simp [sourceStaticSpatialMomentum,Pi.smul_apply,smul_eq_mul,
    Complex.ofReal_mul,Complex.ofReal_inv]
  all_goals field_simp [Complex.ofReal_ne_zero.mpr nonzero]

private def emSourceGreenMatrix (p : Fin 4→ℂ) : Matrix (Fin 289) (Fin 289) ℂ :=
  originalChange p*(contactInverse p+activeProjection*(extendedKernel p)⁻¹)*originalReadback p

private def emSourceEMMatrix (p : Fin 4→ℂ) : Matrix (Fin 4) (Fin 4) ℂ :=
  emInsertion.transpose*emSourceGreenMatrix p*emInsertion

private theorem em_source_matrix_actual (p : regularSource) :
    emSourceEMMatrix p.val=emInsertion.transpose*sourceGreen p*emInsertion := rfl

/-- The full original EM Green at physical momentum scale*k, localized only to its generated regular IR window. -/
def emFullIRSymbol (scale : ℝ) (k : PhysicalMomentum) : Matrix (Fin 4) (Fin 4) ℂ :=
  if 0 < scale ∧ 0 < spatialSquare k ∧ scale*Real.sqrt (spatialSquare k) < emSourceIRRadius then
    emSourceEMMatrix (sourceStaticSpatialMomentum k scale)
  else 0

/-- Every point inside the source window is literally the original full static Green on the same physical momentum. -/
theorem em_full_ir_symbol_actual (scale : ℝ) (k : PhysicalMomentum)
    (positive : 0 < scale) (spatial : 0 < spatialSquare k)
    (inside : scale*Real.sqrt (spatialSquare k) < emSourceIRRadius) :
    emFullIRSymbol scale k=emStaticGreenTensor (emSpatialDirection k) (em_direction_unit k spatial)
      ⟨scale*Real.sqrt (spatialSquare k),mul_pos positive (Real.sqrt_pos.mpr spatial),
        inside.le.trans (min_le_left _ _)⟩ := by
  rw [emFullIRSymbol,if_pos ⟨positive,spatial,inside⟩]
  rw [em_spatial_ray_same k scale _ (Real.sqrt_pos.mpr spatial).ne']
  exact (em_source_matrix_actual (sourceSpatialStaticRegularPoint (emSpatialDirection k) (em_direction_unit k spatial)
    ⟨scale*Real.sqrt (spatialSquare k),mul_pos positive (Real.sqrt_pos.mpr spatial),
      inside.le.trans (min_le_left _ _)⟩)).trans (em_static_green_original _ _ _).symm

/-- One matrix-operator-norm bound dominates all scaled momenta and every actual windowed EM entry. -/
theorem em_full_ir_symbol_bound (scale : ℝ) (k : PhysicalMomentum) :
    ‖emFullIRSymbol scale k‖ ≤ emStaticDominatingNorm := by
  by_cases active : 0 < scale ∧ 0 < spatialSquare k ∧ scale*Real.sqrt (spatialSquare k) < emSourceIRRadius
  · rw [em_full_ir_symbol_actual scale k active.1 active.2.1 active.2.2]
    exact (Classical.choose_spec em_static_green_uniform_bound).2 _
      (active.2.2.trans_le (min_le_right _ _)) _ _
  · simp only [emFullIRSymbol,if_neg active,norm_zero]
    exact em_static_dominating_nonnegative

private theorem em_ir_source_matrix_continuous (terms : List SourceTerm) : Continuous (sourceMatrix terms) := by
  induction terms with
  | nil=>exact continuous_const
  | cons a rest ih=>
    have term : Continuous a.matrix := by
      apply continuous_matrix
      intro i j
      simp only [SourceTerm.matrix,Matrix.single_apply]
      split_ifs
      · unfold Powers.value
        fun_prop
      · exact continuous_const
    exact term.add ih

private def emIRProjection :
    (Matrix (Fin 289) (Fin 289) ℂ) →L[ℝ] Matrix (Fin 4) (Fin 4) ℂ :=
  ({toFun:=fun M=>emInsertion.transpose*M*emInsertion
    map_add':=fun M N=>by simp only [Matrix.mul_add,Matrix.add_mul]
    map_smul':=fun r M=>by simp only [Matrix.mul_smul,Matrix.smul_mul,RingHom.id_apply]} :
    (Matrix (Fin 289) (Fin 289) ℂ) →ₗ[ℝ] Matrix (Fin 4) (Fin 4) ℂ).toContinuousLinearMap

private theorem em_ir_raw_measurable : Measurable emSourceEMMatrix := by
  have O : Continuous originalChange := by unfold originalChange;exact em_ir_source_matrix_continuous originalChangeTerms
  have C : Continuous contactInverse := by unfold contactInverse;exact em_ir_source_matrix_continuous contactInverseTerms
  have R : Continuous originalReadback := by unfold originalReadback;exact (O.comp continuous_neg).matrix_transpose
  have K : Continuous extendedKernel := by
    have A : Continuous activeKernel := by unfold activeKernel;exact em_ir_source_matrix_continuous activeTerms
    exact A.add continuous_const
  have inverse : Measurable (fun p : Fin 4→ℂ=>(extendedKernel p)⁻¹) := by
    simp only [Matrix.inv_def,Ring.inverse_eq_inv]
    exact K.matrix_det.measurable.inv.smul K.matrix_adjugate.measurable
  have body : Measurable emSourceGreenMatrix :=
    (O.measurable.mul (C.measurable.add (measurable_const.mul inverse))).mul R.measurable
  exact emIRProjection.continuous.measurable.comp body

private theorem em_full_ir_measurable (scale : ℝ) : Measurable (emFullIRSymbol scale) := by
  have squared : Continuous spatialSquare := by unfold spatialSquare;fun_prop
  have active : MeasurableSet {k : PhysicalMomentum | 0 < scale ∧ 0 < spatialSquare k ∧
      scale*Real.sqrt (spatialSquare k) < emSourceIRRadius} := by
    have h1 : MeasurableSet {k : PhysicalMomentum | 0 < scale} := by
      by_cases positive : 0 < scale <;> simp [positive]
    have h2 : MeasurableSet {k : PhysicalMomentum | 0 < spatialSquare k} :=
      measurableSet_lt measurable_const squared.measurable
    have hr : Measurable (fun k : PhysicalMomentum=>scale*Real.sqrt (spatialSquare k)) := by
      unfold spatialSquare
      fun_prop
    have h3 : MeasurableSet {k : PhysicalMomentum | scale*Real.sqrt (spatialSquare k) < emSourceIRRadius} :=
      measurableSet_lt hr measurable_const
    exact h1.inter (h2.inter h3)
  have momentum : Continuous (fun k : PhysicalMomentum=>sourceStaticSpatialMomentum k scale) := by
    unfold sourceStaticSpatialMomentum
    fun_prop
  exact Measurable.ite active (em_ir_raw_measurable.comp momentum.measurable) measurable_const


attribute [local irreducible] emStaticGreenTensor emStaticLimitTensor emLeadingSymbol emSourceEMMatrix

private theorem em_full_ir_limit (kappa : ℂ) (k : PhysicalMomentum) (spatial : 0 < spatialSquare k) :
    Tendsto (fun scale : ℝ=>emFullIRSymbol scale k) (𝓝[>] 0) (𝓝 (emLeadingSymbol kappa 0 k)) := by
  let radial:=Real.sqrt (spatialSquare k)
  have rp : 0 < radial := Real.sqrt_pos.mpr spatial
  have ray : radial • emSpatialDirection k=k := by
    change radial • (radial⁻¹ • k)=k
    rw [smul_smul,mul_inv_cancel₀ rp.ne',one_smul]
  have leading:=em_leading_physical_ray kappa radial rp.ne' _ (em_direction_unit k spatial)
  rw [ray] at leading
  apply Metric.tendsto_nhds.mpr
  intro epsilon ep
  obtain ⟨radius,positive,paid⟩:=em_static_green_uniform (epsilon/2) (by positivity)
  have near : ∀ᶠ scale : ℝ in 𝓝[>] 0, scale < min emSourceIRRadius radius/radial :=
    nhdsWithin_le_nhds (gt_mem_nhds (div_pos (lt_min em_source_ir_radius_positive positive) rp))
  filter_upwards [self_mem_nhdsWithin,near] with scale scalePos small
  have product : scale*radial < min emSourceIRRadius radius := (lt_div_iff₀ rp).mp small
  have inside : scale*radial < emSourceIRRadius := product.trans_le (min_le_left _ _)
  have errorRadius : scale*radial < radius := product.trans_le (min_le_right _ _)
  rw [em_full_ir_symbol_actual scale k scalePos spatial inside,leading,dist_eq_norm]
  exact (paid _ errorRadius _ (em_direction_unit k spatial)).trans_lt (by linarith)

private theorem em_spatial_positive (k : PhysicalMomentum) (nonzero : k≠0) : 0 < spatialSquare k := by
  have positive : 0 ≤ spatialSquare k := by unfold spatialSquare;positivity
  by_contra failed
  have zero : spatialSquare k=0 := le_antisymm (not_lt.mp failed) positive
  have h0 : k 0=0 := by
    unfold spatialSquare at zero
    nlinarith [sq_nonneg (k 0),sq_nonneg (k 1),sq_nonneg (k 2)]
  have h1 : k 1=0 := by
    unfold spatialSquare at zero
    nlinarith [sq_nonneg (k 0),sq_nonneg (k 1),sq_nonneg (k 2)]
  have h2 : k 2=0 := by
    unfold spatialSquare at zero
    nlinarith [sq_nonneg (k 0),sq_nonneg (k 1),sq_nonneg (k 2)]
  apply nonzero
  funext j
  fin_cases j
  · exact h0
  · exact h1
  · exact h2

private def emIREntry (mu nu : Fin 4) : (Matrix (Fin 4) (Fin 4) ℂ) →L[ℝ] ℂ :=
  ({toFun:=fun M=>M mu nu
    map_add':=fun _ _=>rfl
    map_smul':=fun _ _=>rfl} : (Matrix (Fin 4) (Fin 4) ℂ) →ₗ[ℝ] ℂ).toContinuousLinearMap

/-- The actual full original Green, at scaled physical momentum and with its source-generated IR localization. -/
def emFullIRPacket (scale : ℝ) (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) :
    Matrix (Fin 4) (Fin 4) ℂ := fun mu nu=>
  ∫frequency,sourceSpatialPhase frequency x*test frequency*emFullIRSymbol scale (sourceSpatialMomentum frequency) mu nu

private theorem em_ir_packet_measurable (scale : ℝ) (test : 𝓢(PhysicalMomentum,ℂ))
    (x : PhysicalMomentum) (mu nu : Fin 4) :
    Measurable (fun frequency=>sourceSpatialPhase frequency x*test frequency*
      emFullIRSymbol scale (sourceSpatialMomentum frequency) mu nu) := by
  have phase : Continuous (fun frequency=>sourceSpatialPhase frequency x) := by
    unfold sourceSpatialPhase sourceSpatialMomentum
    fun_prop
  have momentum : Continuous sourceSpatialMomentum := by unfold sourceSpatialMomentum;fun_prop
  have field := (emIREntry mu nu).continuous.measurable.comp ((em_full_ir_measurable scale).comp momentum.measurable)
  exact (phase.measurable.mul test.continuous.measurable).mul field

/-- The original full-Green remainder is now paid inside the true physical Fourier packet, uniformly over all directions. -/
theorem em_full_ir_packet_leading (kappa : ℂ) (test : 𝓢(PhysicalMomentum,ℂ))
    (x : PhysicalMomentum) (mu nu : Fin 4) :
    Tendsto (fun scale : ℝ=>emFullIRPacket scale test x mu nu) (𝓝[>] 0)
      (𝓝 (emLeadingPacket kappa 0 test x mu nu)) := by
  unfold emFullIRPacket emLeadingPacket
  apply tendsto_integral_filter_of_dominated_convergence (μ:=volume)
    (fun frequency=>(‖emIREntry mu nu‖*emStaticDominatingNorm)*‖test frequency‖)
  · exact Eventually.of_forall (fun scale=>(em_ir_packet_measurable scale test x mu nu).aestronglyMeasurable)
  · exact Eventually.of_forall (fun scale=>Eventually.of_forall (fun frequency=>by
      have phase : ‖sourceSpatialPhase frequency x‖=1 := by simp [sourceSpatialPhase,Complex.norm_exp]
      have field : ‖emFullIRSymbol scale (sourceSpatialMomentum frequency) mu nu‖≤
          ‖emIREntry mu nu‖*emStaticDominatingNorm :=
        ((emIREntry mu nu).le_opNorm _).trans
          (mul_le_mul_of_nonneg_left (em_full_ir_symbol_bound scale _) (norm_nonneg _))
      simp only [norm_mul,phase,one_mul]
      calc
        _≤‖test frequency‖*(‖emIREntry mu nu‖*emStaticDominatingNorm):=
          mul_le_mul_of_nonneg_left field (norm_nonneg _)
        _=_:=by ring))
  · exact test.integrable.norm.const_mul _
  · filter_upwards [volume.ae_ne (0:PhysicalMomentum)] with frequency nonzero
    have kNonzero : sourceSpatialMomentum frequency≠0 :=
      smul_ne_zero (mul_ne_zero (by norm_num) Real.pi_pos.ne') nonzero
    have field := (emIREntry mu nu).continuous.tendsto _ |>.comp
      (em_full_ir_limit kappa (sourceSpatialMomentum frequency) (em_spatial_positive _ kNonzero))
    exact (tendsto_const_nhds (x:=sourceSpatialPhase frequency x*test frequency)).mul field


private theorem em_spatial_scaled_square (scale : ℝ) (k : PhysicalMomentum) :
    spatialSquare (scale • k)=scale^2*spatialSquare k := by
  simp only [spatialSquare,Pi.smul_apply,smul_eq_mul]
  ring

private theorem em_ir_symbol_scaling (scale : ℝ) (positive : 0 < scale) (k : PhysicalMomentum) :
    emFullIRSymbol 1 (scale • k)=emFullIRSymbol scale k := by
  have radius : Real.sqrt (spatialSquare (scale • k))=scale*Real.sqrt (spatialSquare k) := by
    rw [em_spatial_scaled_square,Real.sqrt_mul (sq_nonneg _),Real.sqrt_sq_eq_abs,abs_of_pos positive]
  have spatial : 0 < spatialSquare (scale • k) ↔ 0 < spatialSquare k := by
    rw [em_spatial_scaled_square]
    exact mul_pos_iff_of_pos_left (sq_pos_of_pos positive)
  have momentum : sourceStaticSpatialMomentum (scale • k) 1=sourceStaticSpatialMomentum k scale := by
    ext j
    fin_cases j <;> simp [sourceStaticSpatialMomentum,Pi.smul_apply,smul_eq_mul,Complex.ofReal_mul]
  simp only [emFullIRSymbol,radius,spatial,show (0:ℝ)<1 by norm_num,positive,true_and,one_mul,momentum]

private theorem em_physical_momentum_dilation (scale : ℝ) (frequency : PhysicalMomentum) :
    sourceSpatialMomentum (scale • frequency)=scale • sourceSpatialMomentum frequency := by
  simp only [sourceSpatialMomentum,smul_smul]
  congr 1
  ring

private theorem em_physical_phase_dilation (scale : ℝ) (frequency x : PhysicalMomentum) :
    sourceSpatialPhase (scale • frequency) x=sourceSpatialPhase frequency (scale • x) := by
  unfold sourceSpatialPhase
  rw [em_physical_momentum_dilation]
  congr 3
  apply Finset.sum_congr rfl
  intro j _
  simp only [Pi.smul_apply,smul_eq_mul]
  ring

/-- The scaled family is exactly an original physical Fourier observation with the original dilated Schwartz profile and the three-dimensional Jacobian. -/
theorem em_full_ir_packet_original_dilation (scale : ℝ) (positive : 0 < scale)
    (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) (mu nu : Fin 4) :
    emFullIRPacket scale test x mu nu=((scale:ℂ)⁻¹)^3*
      emFullIRPacket 1 (sourceDilatedTest scale⁻¹ (inv_ne_zero positive.ne') test) (scale⁻¹ • x) mu nu := by
  let f : PhysicalMomentum→ℂ:=fun frequency=>sourceSpatialPhase frequency (scale⁻¹ • x)*
    sourceDilatedTest scale⁻¹ (inv_ne_zero positive.ne') test frequency*
    emFullIRSymbol 1 (sourceSpatialMomentum frequency) mu nu
  have point (frequency : PhysicalMomentum) : f (scale • frequency)=
      sourceSpatialPhase frequency x*test frequency*emFullIRSymbol scale (sourceSpatialMomentum frequency) mu nu := by
    simp only [f,em_physical_phase_dilation,sourceDilatedTest_apply,smul_smul,
      mul_inv_cancel₀ positive.ne',inv_mul_cancel₀ positive.ne',one_smul,
      em_physical_momentum_dilation,em_ir_symbol_scaling scale positive]
  have generated:=MeasureTheory.Measure.integral_comp_smul (μ:=volume) f scale
  simpa only [point,emFullIRPacket,f,Module.finrank_fin_fun,inv_pow,
    abs_of_pos (inv_pos.mpr (pow_pos positive 3)),Complex.real_smul,
    Complex.ofReal_pow,Complex.ofReal_inv] using generated

