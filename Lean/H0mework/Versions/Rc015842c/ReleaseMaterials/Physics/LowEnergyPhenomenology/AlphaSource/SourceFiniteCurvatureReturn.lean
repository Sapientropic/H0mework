/-- First actual photon-ray curvature coefficient, with all five current pole coordinates. -/
def sourcePoleCurvatureJet (branch : Fin 2) (epsilon s : ℝ) (n : PhysicalMomentum) : Fin 36→ℂ :=
  (originalReader36 (physicalFrequencyMomentum s n)-originalReader36 0)*ᵥsourcePoleOriginField branch epsilon s n+
  originalReader36 0*ᵥ(sourcePoleLiteralJet branch epsilon s n+sourcePoleFastJet branch epsilon s n)

/-- Exact finite remainder: the reader/frame cross and the original full residual both remain. -/
def sourcePoleCurvatureRemainder (branch : Fin 2) (epsilon s : ℝ) (n : PhysicalMomentum) : Fin 36→ℂ :=
  (epsilon:ℂ)^4 • ((originalReader36 (physicalFrequencyMomentum s n)-originalReader36 0)*ᵥ
    (sourcePoleLiteralJet branch epsilon s n+sourcePoleFastJet branch epsilon s n))+
  originalReader36 (frequencyRay epsilon s n)*ᵥsourcePoleFrameResidual branch epsilon s n

private theorem affine_frame_return (C B : Matrix (Fin 36) (Fin 289) ℂ)
    (O J R : Fin 289→ℂ) (z : ℂ) (origin : C*ᵥO=0) :
    (C+z • B)*ᵥ(O+z • J+R)=
      z • (B*ᵥO+C*ᵥJ)+(z*z) • (B*ᵥJ)+(C+z • B)*ᵥR := by
  simp only [Matrix.mulVec_add,Matrix.add_mulVec,Matrix.smul_mulVec,Matrix.mulVec_smul,origin,zero_add,smul_add,smul_smul]
  module

/-- The full actual polarization generates its first curvature response, without a frozen forcing or discarded fast coordinate. -/
theorem sourceNativeFrequencyCurvature_firstReturn (branch : Fin 2) (epsilon s : ℝ) (n : PhysicalMomentum)
    (nonzero : epsilon≠0) :
    originalReader36 (frequencyRay epsilon s n)*ᵥsourceNativeFrequencyPolarization branch epsilon s n=
      (epsilon:ℂ)^2 • sourcePoleCurvatureJet branch epsilon s n+sourcePoleCurvatureRemainder branch epsilon s n := by
  have returned:=sourceNativeFrequencyPolarization_firstReturn branch epsilon s n nonzero
  rw [sourcePoleJetField_literal] at returned
  have field : sourceNativeFrequencyPolarization branch epsilon s n=
      sourcePoleOriginField branch epsilon s n+(epsilon:ℂ)^2 •
        (sourcePoleLiteralJet branch epsilon s n+sourcePoleFastJet branch epsilon s n)+sourcePoleFrameResidual branch epsilon s n := by
    linear_combination returned
  rw [field,frequencyRay_scaled,sourceCurvatureReader_affine]
  have exactReturn:=affine_frame_return (originalReader36 0)
    (originalReader36 (physicalFrequencyMomentum s n)-originalReader36 0)
    (sourcePoleOriginField branch epsilon s n) (sourcePoleLiteralJet branch epsilon s n+sourcePoleFastJet branch epsilon s n)
    (sourcePoleFrameResidual branch epsilon s n) ((epsilon:ℂ)^2) (sourcePoleOriginCurvature_zero branch epsilon s n)
  have fourth : (epsilon:ℂ)^2*(epsilon:ℂ)^2=(epsilon:ℂ)^4 := by ring
  simpa only [sourcePoleCurvatureJet,sourcePoleCurvatureRemainder,frequencyRay_scaled,
    sourceCurvatureReader_affine,fourth,add_assoc] using exactReturn

/-- Sheet selection is made by the original source producer, retaining the exact finite remainder. -/
theorem sourceNativeSheetCurvature_firstReturn (branch : Fin 2) (n : PhysicalMomentum)
    (unit : spatialSquare n=1) (e : {e : ℝ // 0<e}) :
    originalReader36 (frequencyRay e.val (sourceSheet branch n unit e.val) n)*ᵥ
      sourceNativeFrequencyPolarization branch e.val (sourceSheet branch n unit e.val) n=
    (e.val:ℂ)^2 • sourcePoleCurvatureJet branch e.val (sourceSheet branch n unit e.val) n+
      sourcePoleCurvatureRemainder branch e.val (sourceSheet branch n unit e.val) n :=
  sourceNativeFrequencyCurvature_firstReturn branch e.val _ n e.property.ne'

