/-- The anti-Hermitian electromagnetic action on the actual 504 independent
modes: `-i` times the canonical Hermitian charge matrix generated by the
original `emGaugeAction`. -/
def emDressedFullGenerator : Matrix Mode Mode ℂ :=
  (-Complex.I) • emGaugeChargeMatrix

private def emWeight : Mode → ℂ
  | Sum.inl i => (emDressedWholeWeight i : ℂ) * Complex.I
  | Sum.inr i => -(emDressedWholeWeight i : ℂ) * Complex.I

/-- The conjugate independent branch carries the negative weight, exactly as
generated by `SourceRealScalarFock.branches`. -/
private theorem emDressedFull_diagonal :
    emDressedFullGenerator = Matrix.diagonal emWeight := by
  unfold emDressedFullGenerator emGaugeChargeMatrix SourceRealScalarFock.branches
  rw [show Quantum.operatorMatrix (Complex.I • emGaugeAction) =
        Complex.I • Quantum.operatorMatrix emGaugeAction from
        map_smul Quantum.operatorMatrix _ _, emDressed_matrix]
  ext i j
  cases i with
  | inl a =>
    cases j with
    | inl b =>
      by_cases h : b = a
      · subst b
        simp [Matrix.fromBlocks, Matrix.smul_apply, emWeight, smul_eq_mul]
        rw [←mul_assoc, Complex.I_mul_I, neg_one_mul, neg_neg]
      · simp [Matrix.fromBlocks, Matrix.smul_apply, Ne.symm h]
    | inr b => simp [Matrix.fromBlocks]
  | inr a =>
    cases j with
    | inl b => simp [Matrix.fromBlocks]
    | inr b =>
      by_cases h : b = a
      · subst b
        simp [Matrix.fromBlocks, Matrix.map_apply, Matrix.smul_apply,
          emWeight, smul_eq_mul, map_mul, map_ratCast, Complex.conj_I]
        rw [←mul_assoc, Complex.I_mul_I, neg_one_mul]
      · simp [Matrix.fromBlocks, Matrix.map_apply, Matrix.smul_apply,
          Matrix.neg_apply, Ne.symm h]

private theorem em_create (spin : Fin 2) (c : Fin 3) :
    quantized emDressedFullGenerator * GaussCARHistory.createFiber (mode spin c) -
      GaussCARHistory.createFiber (mode spin c) * quantized emDressedFullGenerator =
    ((emDressedExteriorWeight (Composite.matterBasis c) : ℂ) * Complex.I) •
      GaussCARHistory.createFiber (mode spin c) := by
  rw [quantized_creation_column, emDressedFull_diagonal]
  unfold creationColumn
  rw [Finset.sum_eq_single (mode spin c)]
  · rw [Matrix.diagonal_apply, if_pos rfl]
    rfl
  · intro j _ different
    rw [Matrix.diagonal_apply, if_neg different]
    exact _root_.zero_smul ℂ (GaussCARHistory.createFiber j)
  · intro absent
    exact (absent (Finset.mem_univ _)).elim

private theorem em_annihilate (spin : Fin 2) (c : Fin 3) :
    quantized emDressedFullGenerator * GaussCARHistory.annihilateFiber (mode spin c) -
      GaussCARHistory.annihilateFiber (mode spin c) * quantized emDressedFullGenerator =
    -(((emDressedExteriorWeight (Composite.matterBasis c) : ℂ) * Complex.I) •
      GaussCARHistory.annihilateFiber (mode spin c)) := by
  rw [quantized_annihilation_row, emDressedFull_diagonal]
  unfold annihilationRow
  rw [Finset.sum_eq_single (mode spin c)]
  · rw [Matrix.diagonal_apply, if_pos rfl]
    rfl
  · intro j _ different
    rw [Matrix.diagonal_apply, if_neg (Ne.symm different)]
    exact _root_.zero_smul ℂ (GaussCARHistory.annihilateFiber j)
  · intro absent
    exact (absent (Finset.mem_univ _)).elim

private theorem weight_complex (a : Fin 2) (c : Fin 3) :
    (emDressedExteriorWeight (Composite.scalarBasis a c) : ℂ) +
      (emDressedExteriorWeight (Composite.matterBasis c) : ℂ) = (-(1/2) : ℂ) := by
  have h := congrArg (fun q : ℚ => (q : ℂ)) (em_dressed_total_weight a c)
  norm_num only [Rat.cast_add, Rat.cast_neg, Rat.cast_div, Rat.cast_ofNat,
    Rat.cast_one] at h
  exact h

/-- The elementary EM creation variation: scalar `emDirection` action minus the
actual full-generator commutator returns `+i/2`. -/
theorem em_dressed_creation (a s : Fin 2) (phi : Scalar) :
    fiberCreation a s
      (scalarMotherLieAction (p286LieBlockEmbed emDirection) phi) -
      (quantized emDressedFullGenerator * fiberCreation a s phi -
        fiberCreation a s phi * quantized emDressedFullGenerator) =
      emDressedCharacter true • fiberCreation a s phi := by
  have unit : (emDressedChargeUnit : ℂ) = 1/2 := by
    have cast := congrArg (fun q : ℚ => (q : ℂ)) emDressedChargeUnit_value
    norm_num only [Rat.cast_div, Rat.cast_ofNat, Rat.cast_one] at cast
    exact cast
  rw [show emDressedCharacter true = Complex.I * (1/2 : ℂ) by
    simp only [emDressedCharacter, if_true, unit]]
  simp only [fiberCreation, Finset.mul_sum, Finset.sum_mul, mul_smul_comm,
    smul_mul_assoc, ← Finset.sum_sub_distrib, em_dressed_scalar, map_mul,
    Complex.star_def, Complex.conj_I, map_ratCast, Finset.smul_sum, smul_smul]
  apply Finset.sum_congr rfl
  intro c _
  rw [← _root_.smul_sub ((starRingEnd ℂ) (scalarCoefficient a c phi))
    (quantized emDressedFullGenerator * GaussCARHistory.createFiber (mode s c))
    (GaussCARHistory.createFiber (mode s c) * quantized emDressedFullGenerator),
    em_create, smul_smul]
  rw [← _root_.sub_smul _ _ (GaussCARHistory.createFiber (mode s c))]
  congr 1
  linear_combination (-Complex.I * (starRingEnd ℂ) (scalarCoefficient a c phi)) *
    weight_complex a c

/-- The elementary EM annihilation variation returns `-i/2`. -/
theorem em_dressed_annihilation (a s : Fin 2) (phi : Scalar) :
    fiberAnnihilation a s
      (scalarMotherLieAction (p286LieBlockEmbed emDirection) phi) -
      (quantized emDressedFullGenerator * fiberAnnihilation a s phi -
        fiberAnnihilation a s phi * quantized emDressedFullGenerator) =
      emDressedCharacter false • fiberAnnihilation a s phi := by
  have unit : (emDressedChargeUnit : ℂ) = 1/2 := by
    have cast := congrArg (fun q : ℚ => (q : ℂ)) emDressedChargeUnit_value
    norm_num only [Rat.cast_div, Rat.cast_ofNat, Rat.cast_one] at cast
    exact cast
  rw [show emDressedCharacter false = -(Complex.I * (1/2 : ℂ)) by
    simp only [emDressedCharacter, Bool.false_eq_true, if_false, unit]]
  simp only [fiberAnnihilation, Finset.mul_sum, Finset.sum_mul, mul_smul_comm,
    smul_mul_assoc, ← Finset.sum_sub_distrib, em_dressed_scalar,
    Finset.smul_sum, smul_smul]
  apply Finset.sum_congr rfl
  intro c _
  rw [← _root_.smul_sub (scalarCoefficient a c phi)
    (quantized emDressedFullGenerator * GaussCARHistory.annihilateFiber (mode s c))
    (GaussCARHistory.annihilateFiber (mode s c) * quantized emDressedFullGenerator),
    em_annihilate, smul_neg, smul_smul, sub_neg_eq_add]
  rw [← _root_.add_smul _ _ (GaussCARHistory.annihilateFiber (mode s c))]
  congr 1
  linear_combination (Complex.I * scalarCoefficient a c phi) *
    weight_complex a c

/-- The EM-dressed fibre: the actual source-root electromagnetic action acting
on the original creation/annihilation fibre, minus the quantized commutator. -/
def emDressedFiber (addition : Bool) (a s : Fin 2) (phi : Scalar) : FiberOp :=
  if addition then
    fiberCreation a s
      (scalarMotherLieAction (p286LieBlockEmbed emDirection) phi) -
      (quantized emDressedFullGenerator * fiberCreation a s phi -
        fiberCreation a s phi * quantized emDressedFullGenerator)
  else
    fiberAnnihilation a s
      (scalarMotherLieAction (p286LieBlockEmbed emDirection) phi) -
      (quantized emDressedFullGenerator * fiberAnnihilation a s phi -
        fiberAnnihilation a s phi * quantized emDressedFullGenerator)

private theorem em_fiber_return (addition : Bool) (a s : Fin 2) (phi : Scalar) :
    emDressedFiber addition a s phi =
      emDressedCharacter addition •
        (if addition then fiberCreation a s phi else fiberAnnihilation a s phi) := by
  cases addition
  · exact em_dressed_annihilation a s phi
  · exact em_dressed_creation a s phi

/-- The EM-dressed test: original `scalarField z`, the original root-volume
normalization and the original `localMultiplier`. -/
def emDressedTest (addition : Bool) (a s : Fin 2) : QuantumTest →ₗ[ℂ] QuantumTest :=
  localMultiplier (fun z =>
    (if addition then (rootVolume z : ℂ)⁻¹ else (rootVolume z : ℂ)) •
      emDressedFiber addition a s (GaussNativePotential.scalarField z)) (by
    intro z
    simp only [em_fiber_return]
    cases addition
    · simp only [Bool.false_eq_true, if_false]
      exact (root_volume_complex_smooth z).smul
        (((annihilation_matrix_smooth a s).contDiffAt).const_smul _)
    · simp only [if_true]
      exact ((root_volume_complex_smooth z).inv
        (Complex.ofReal_ne_zero.mpr (root_volume_pos z).ne')).smul
          (((creation_matrix_smooth a s).contDiffAt).const_smul _))

/-- The original input action remains inside the CAR commutator; the source
measure and volume factors are unchanged. -/
theorem emDressedTest_return (addition : Bool) (a s : Fin 2) (f : QuantumTest) :
    emDressedTest addition a s f = emDressedCharacter addition •
      (if addition then creationTest a s f else annihilationTest a s f) := by
  apply DFunLike.ext
  intro z
  cases addition
  · change (rootVolume z : ℂ) •
        (emDressedFiber false a s (GaussNativePotential.scalarField z) (f z)) =
      emDressedCharacter false • ((rootVolume z : ℂ) •
        (fiberAnnihilation a s (GaussNativePotential.scalarField z) (f z)))
    rw [em_fiber_return]
    exact smul_comm (rootVolume z : ℂ) (emDressedCharacter false)
      (fiberAnnihilation a s (GaussNativePotential.scalarField z) (f z))
  · change (rootVolume z : ℂ)⁻¹ •
        (emDressedFiber true a s (GaussNativePotential.scalarField z) (f z)) =
      emDressedCharacter true • ((rootVolume z : ℂ)⁻¹ •
        (fiberCreation a s (GaussNativePotential.scalarField z) (f z)))
    rw [em_fiber_return]
    exact smul_comm (rootVolume z : ℂ)⁻¹ (emDressedCharacter true)
      (fiberCreation a s (GaussNativePotential.scalarField z) (f z))

/-- The EM-dressed letter embeds the EM-dressed test. -/
def emDressedLetter (addition : Bool) (a s : Fin 2) : QuantumTest →ₗ[ℂ] H :=
  embed.comp (emDressedTest addition a s)

theorem emDressedLetter_return (addition : Bool) (a s : Fin 2) :
    emDressedLetter addition a s = emDressedCharacter addition • leg addition a s := by
  apply LinearMap.ext
  intro f
  simp only [emDressedLetter, LinearMap.comp_apply, emDressedTest_return, map_smul,
    LinearMap.smul_apply]
  cases addition <;> simp only [Bool.false_eq_true, if_false, if_true, leg,
    embed_creation_test, embed_annihilation_test]

/-- The EM-dressed core composes the letter with the original seed section. -/
def emDressedCore (addition : Bool) (a s : Fin 2) : ScalarTest →ₗ[ℂ] H :=
  (emDressedLetter addition a s).comp seedSection

theorem emDressedCore_return (addition : Bool) (a s : Fin 2) (f : ScalarTest) :
    emDressedCore addition a s f =
      emDressedCharacter addition • legCore addition a s f := by
  rw [emDressedCore, emDressedLetter_return]
  rfl

private theorem em_dressed_bound (addition : Bool) (a s : Fin 2) (f : ScalarTest) :
    ‖emDressedCore addition a s f‖ ≤
      (‖emDressedCharacter addition‖ * legBound) * ‖core f‖ := by
  rw [emDressedCore_return, norm_smul, mul_assoc]
  exact mul_le_mul_of_nonneg_left (legCore_bound addition a s f) (norm_nonneg _)

/-- The completed EM-dressed leg uses the same original core bound and
core-dense completion seam as the source-dressed leg. -/
def emDressedCompleted (addition : Bool) (a s : Fin 2) : Profile →L[ℂ] H :=
  (emDressedCore addition a s).extendOfNorm core

theorem emDressedCompleted_core (addition : Bool) (a s : Fin 2) (f : ScalarTest) :
    emDressedCompleted addition a s (core f) = emDressedCore addition a s f :=
  LinearMap.extendOfNorm_eq core_dense ⟨_, em_dressed_bound addition a s⟩ f

theorem emDressedCompleted_return (addition : Bool) (a s : Fin 2) (f : Profile) :
    emDressedCompleted addition a s f =
      emDressedCharacter addition • completedLeg addition a s f := by
  have equality : emDressedCompleted addition a s =
      emDressedCharacter addition • completedLeg addition a s := by
    apply LinearMap.extendOfNorm_unique core_dense _ (em_dressed_bound addition a s)
    apply LinearMap.ext
    intro g
    simp only [LinearMap.comp_apply, FunLike.coe_smul, Pi.smul_apply,
      ContinuousLinearMap.coe_coe, completedLeg_core, emDressedCore_return, legCore]
  exact congrArg (fun T : Profile →L[ℂ] H => T f) equality

/-- The EM-dressed prepared covector: the same `currentVertex (fieldBasis i)`
reader, source-profile epsilon precision, and original endpoint legs. -/
def emDressedPreparedCovector (epsilon : ℝ) (precision : 0 < epsilon)
    (p k : PhysicalMomentum) (F : Index) (n : ℕ) (z w : ℂ)
    (left right : Bool) (a s b t : Fin 2) : Fin 289 → ℂ :=
  fun i =>
    inner ℂ (emDressedCompleted left a s (sourceProfile epsilon precision))
      (currentVertex (fieldBasis i) p k F n z w
        (completedLeg right b t (sourceProfile epsilon precision))) +
    inner ℂ (completedLeg left a s (sourceProfile epsilon precision))
      (currentVertex (fieldBasis i) p k F n z w
        (emDressedCompleted right b t (sourceProfile epsilon precision)))

theorem em_dressed_prepared_return (epsilon : ℝ) (precision : 0 < epsilon)
    (p k : PhysicalMomentum) (F : Index) (n : ℕ) (z w : ℂ)
    (left right : Bool) (a s b t : Fin 2) :
    emDressedPreparedCovector epsilon precision p k F n z w left right a s b t =
      fun i =>
        (star (emDressedCharacter left) + emDressedCharacter right) *
          preparedCovector epsilon precision p k F n z w left right a s b t i := by
  funext i
  simp only [emDressedPreparedCovector, emDressedCompleted_return,
    inner_smul_left, map_smul, inner_smul_right, preparedCovector, preparedCurrent,
    add_mul, starRingEnd_apply]

/-- The full 289-field source, including scalar, complement and density terms,
is the actual consumer. -/
theorem em_dressed_prepared_source (epsilon : ℝ) (precision : 0 < epsilon)
    (p k : PhysicalMomentum) (F : Index) (n : ℕ) (z w : ℂ)
    (left right : Bool) (a s b t : Fin 2) :
    emDressedPreparedCovector epsilon precision p k F n z w left right a s b t =
      fun i =>
        (star (emDressedCharacter left) + emDressedCharacter right) *
          sourceCovector p
            (sourceTestApprox F ((finiteFull (p + k) F n z).adjoint
              (completedLeg left a s (sourceProfile epsilon precision))))
            (sourceTestApprox F (finiteFull p F n w
              (completedLeg right b t (sourceProfile epsilon precision)))) i := by
  rw [em_dressed_prepared_return, prepared_covector_source]

theorem em_dressed_prepared_price (epsilon : ℝ) (precision : 0 < epsilon)
    (p k : PhysicalMomentum) (F : Index) (n : ℕ) (z w : ℂ) (hz : z.im ≠ 0)
    (hw : w.im ≠ 0) (left right : Bool) (a s b t : Fin 2) (i : Fin 289) :
    ‖emDressedPreparedCovector epsilon precision p k F n z w left right a s b t i‖ ≤
      ‖star (emDressedCharacter left) + emDressedCharacter right‖ *
      (‖completedLeg left a s (sourceProfile epsilon precision)‖ *
        (normBound n z * currentPrice (fieldBasis i) p F * normBound n w) *
        ‖completedLeg right b t (sourceProfile epsilon precision)‖) := by
  rw [em_dressed_prepared_return, norm_mul]
  exact mul_le_mul_of_nonneg_left
    (prepared_covector_price epsilon precision p k F n z w hz hw left right
      a s b t i) (norm_nonneg _)

/-- The GT/source dressing character is the real multiple `-10/11` of the EM
joint character: a source-derived normalization on the actual dressed
observations, not an equality of full generators. -/
theorem em_dressed_gt_character (addition : Bool) :
    sourceDressedCharacter addition =
      (-(10/11) : ℂ) * emDressedCharacter addition := by
  have unit : (emDressedChargeUnit : ℂ) = 1/2 := by
    have cast := congrArg (fun q : ℚ => (q : ℂ)) emDressedChargeUnit_value
    norm_num only [Rat.cast_div, Rat.cast_ofNat, Rat.cast_one] at cast
    exact cast
  cases addition <;> simp only [sourceDressedCharacter, emDressedCharacter,
    Bool.false_eq_true, if_true, if_false, unit] <;> ring

/-- The original GT completed variation equals `-10/11` times this EM joint
variation on the same source legs. -/
theorem em_dressed_gt_completed (addition : Bool) (a s : Fin 2) (f : Profile) :
    sourceDressedCompleted addition a s f =
      (-(10/11) : ℂ) • emDressedCompleted addition a s f := by
  rw [sourceDressedCompleted_return, emDressedCompleted_return,
    em_dressed_gt_character, mul_smul]

/-- The original GT prepared variation equals `-10/11` times this EM joint
prepared read on the same endpoints; the real factor survives `star`. -/
theorem em_dressed_gt_prepared (epsilon : ℝ) (precision : 0 < epsilon)
    (p k : PhysicalMomentum) (F : Index) (n : ℕ) (z w : ℂ)
    (left right : Bool) (a s b t : Fin 2) :
    sourceDressedPreparedCovector epsilon precision p k F n z w left right
      a s b t =
      fun i => (-(10/11) : ℂ) *
        emDressedPreparedCovector epsilon precision p k F n z w left right
          a s b t i := by
  funext i
  rw [sourceDressedPrepared_return, em_dressed_gt_character left,
    em_dressed_gt_character right, em_dressed_prepared_return]
  have real_factor : star (-(10/11) : ℂ) = (-(10/11) : ℂ) := by
    norm_num [Complex.star_def]
  simp only [star_mul, real_factor]
  ring

