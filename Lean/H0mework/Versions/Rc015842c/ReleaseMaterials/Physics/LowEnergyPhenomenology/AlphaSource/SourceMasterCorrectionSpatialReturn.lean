private theorem side_scaled (c eta d : ℝ) : sourcePoleSide (d*c) (d*eta)=(d:ℂ)*sourcePoleSide c eta := by
  simp only [sourcePoleSide,Complex.ofReal_mul]
  ring

private theorem slow_smul (z : ℂ) (v : Fin 289→ℂ) (i : Fin 5) : sourceSlowRead (z • v) i=z*sourceSlowRead v i := by
  simp only [sourceSlowRead,Matrix.mulVec_smul,Pi.smul_apply,smul_eq_mul]
  split_ifs <;> simp only [mul_zero]

private theorem slow_continuous (i : Fin 5) : Continuous (fun v : Fin 289→ℂ=>sourceSlowRead v i) := by
  unfold sourceSlowRead
  split_ifs <;> fun_prop

/-- The complete correction has its exact source native-simple coefficient on the actual complex radial side. -/
theorem sourceMasterCorrection_pointwise (q : PhysicalResponsePoint) (n : PhysicalMomentum) (nonzero : n≠0)
    (zeta : ℂ) (causal : 0<zeta.re) (l r : RestStateIndex) (i : Fin 3) :
    Tendsto (fun d : ℝ=>(d:ℂ)*sourceMasterChannelCorrection q n ((d:ℂ)*zeta) l r i) (𝓝[>] 0)
      (𝓝 (zeta⁻¹*(sourceChargedDenominator n 0 i)⁻¹*sourceSlowRead (sourceNativeSimple q n l r) ⟨i.val,by omega⟩)) := by
  have inverse:=sourceCorrectionInverse_return n nonzero zeta i
  have numerator:=(slow_continuous ⟨i.val,by omega⟩).continuousAt.tendsto.comp
    (sourceMasterSimpleNumerator_return q n zeta causal l r)
  have generated:=(inverse.mul numerator).add (sourceDenominatorCorrection_return q n nonzero zeta causal l r i)
  have endpoint : (sourceChargedDenominator n 0 i)⁻¹*
      sourceSlowRead (zeta⁻¹ • sourceNativeSimple q n l r) ⟨i.val,by omega⟩+0=
      zeta⁻¹*(sourceChargedDenominator n 0 i)⁻¹*sourceSlowRead (sourceNativeSimple q n l r) ⟨i.val,by omega⟩ := by
    rw [slow_smul]
    ring
  rw [endpoint] at generated
  apply generated.congr
  intro d
  simp only [sourceMasterCorrection_split,sourceDenominatorCorrection,slow_smul,Function.comp_def]
  ring

def sourceMasterCorrectionPrice (q : PhysicalResponsePoint) (c eta : ℝ) (l r : RestStateIndex) (i : Fin 3) : ℝ :=
  sourceChargedQuadraticPrice c eta i*‖slowFastFrame.transpose‖*sourceMasterSimplePrice q eta l r+
    sourceDenominatorCorrectionPrice q c eta l r i

private theorem numerator_price_nonneg (q : PhysicalResponsePoint) (eta : ℝ) (causal : 0<eta) (l r : RestStateIndex) :
    0≤ sourceMasterSimplePrice q eta l r := by unfold sourceMasterSimplePrice sourceSpatialGaugePrice sourceMasterCurrentPrice;positivity

private theorem correction_price_nonneg (q : PhysicalResponsePoint) (c eta : ℝ) (causal : 0<eta)
    (l r : RestStateIndex) (i : Fin 3) : 0≤ sourceMasterCorrectionPrice q c eta l r i := by
  unfold sourceMasterCorrectionPrice sourceDenominatorCorrectionPrice sourceChargedQuadraticPrice sourceChargedDenominatorPrice
    sourceMasterSimplePrice sourceSpatialGaugePrice sourceMasterCurrentPrice
  have spatial:=(sourceChargedSpatialCoefficient_positive i).le
  positivity

/-- Both correction mechanisms retain a common source-generated spatial price. -/
theorem sourceMasterCorrection_bound (q : PhysicalResponsePoint) (n : PhysicalMomentum) (nonzero : n≠0)
    (c eta : ℝ) (frequency : c≠0) (causal : 0<eta) (d : ℝ) (radial : 0<d)
    (l r : RestStateIndex) (i : Fin 3) :
    ‖(d:ℂ)*sourceMasterChannelCorrection q n ((d:ℂ)*sourcePoleSide c eta) l r i‖≤
      sourceMasterCorrectionPrice q c eta l r i*(‖n‖^2)⁻¹ := by
  let zeta:=sourcePoleSide c eta
  have zp : 0<zeta.re:=by simpa [zeta,sourcePoleSide] using causal
  have real : zeta.re=eta:=by simp [zeta,sourcePoleSide]
  have numerator:=sourceMasterSimpleNumerator_bound q n zeta zp d radial l r
  rw [real] at numerator
  have slow:=(paidSpatial% slow_bound) ((d:ℂ) • sourceMasterSimpleNumerator q n ((d:ℂ)*zeta) l r) ⟨i.val,by omega⟩
  have inverse:=sourceJointRadialInverse_bound n c eta frequency causal d radial i
  rw [side_scaled] at inverse
  have normPositive : 0<‖n‖^2:=sq_pos_of_pos (norm_pos_iff.mpr nonzero)
  have inverseBound : ‖(sourceChargedDenominator n ((d:ℂ)*zeta) i)⁻¹‖≤ sourceChargedQuadraticPrice c eta i*(‖n‖^2)⁻¹ := by
    rw [←div_eq_mul_inv]
    exact (le_div_iff₀ normPositive).mpr (by simpa only [mul_comm] using inverse)
  have den:=sourceDenominatorCorrection_bound q n nonzero c eta frequency causal d radial l r i
  have quadNonneg : 0≤ sourceChargedQuadraticPrice c eta i := by
    unfold sourceChargedQuadraticPrice sourceChargedDenominatorPrice
    have spatial:=(sourceChargedSpatialCoefficient_positive i).le
    positivity
  have split : (d:ℂ)*sourceMasterChannelCorrection q n ((d:ℂ)*zeta) l r i=
      (sourceChargedDenominator n ((d:ℂ)*zeta) i)⁻¹*
        sourceSlowRead ((d:ℂ) • sourceMasterSimpleNumerator q n ((d:ℂ)*zeta) l r) ⟨i.val,by omega⟩+
      (d:ℂ)*sourceDenominatorCorrection q n ((d:ℂ)*zeta) l r i := by
    simp only [sourceMasterCorrection_split,sourceDenominatorCorrection,slow_smul]
    ring
  rw [split]
  have numeratorBound : ‖(sourceChargedDenominator n ((d:ℂ)*zeta) i)⁻¹*
      sourceSlowRead ((d:ℂ) • sourceMasterSimpleNumerator q n ((d:ℂ)*zeta) l r) ⟨i.val,by omega⟩‖≤
      (sourceChargedQuadraticPrice c eta i*(‖n‖^2)⁻¹)*(‖slowFastFrame.transpose‖*sourceMasterSimplePrice q eta l r) := by
    rw [norm_mul]
    exact mul_le_mul inverseBound (slow.trans (mul_le_mul_of_nonneg_left numerator (norm_nonneg _)))
      (norm_nonneg _) (mul_nonneg quadNonneg (by positivity))
  apply (norm_add_le _ _).trans ((add_le_add numeratorBound den).trans_eq _)
  unfold sourceMasterCorrectionPrice
  ring

theorem sourceMasterCorrection_fourier_bound (q : PhysicalResponsePoint) (c eta : ℝ)
    (frequency : c≠0) (causal : 0<eta) (d : ℝ) (radial : 0<d) (l r : RestStateIndex) (i : Fin 3)
    (test : 𝓢(PhysicalMomentum,ℂ)) (x n : PhysicalMomentum) (nonzero : n≠0) :
    ‖sourceSpatialPhase n x*test n*((d:ℂ)*sourceMasterChannelCorrection q (sourceSpatialMomentum n)
      ((d:ℂ)*sourcePoleSide c eta) l r i)‖≤ sourceMasterCorrectionPrice q c eta l r i*sourceRadialSchwartzPrice test n := by
  have momentumNZ : sourceSpatialMomentum n≠0:=by unfold sourceSpatialMomentum;exact smul_ne_zero (by positivity : (2*Real.pi:ℝ)≠0) nonzero
  have bound:=sourceMasterCorrection_bound q (sourceSpatialMomentum n) momentumNZ c eta frequency causal d radial l r i
  have price:=correction_price_nonneg q c eta causal l r i
  have extra : (‖sourceSpatialMomentum n‖^2)⁻¹≤(1+‖sourceSpatialMomentum n‖)*(‖sourceSpatialMomentum n‖^2)⁻¹ :=
    le_mul_of_one_le_left (by positivity) (by linarith [norm_nonneg (sourceSpatialMomentum n)])
  rw [norm_mul,norm_mul,(paidRadialGreen% phase_norm),one_mul]
  calc
    _≤‖test n‖*(sourceMasterCorrectionPrice q c eta l r i*(‖sourceSpatialMomentum n‖^2)⁻¹):=
      mul_le_mul_of_nonneg_left bound (norm_nonneg _)
    _≤‖test n‖*(sourceMasterCorrectionPrice q c eta l r i*((1+‖n‖)*(‖n‖^2)⁻¹)):=by
      gcongr
      exact extra.trans ((paidCorrectionGeometry% physical_price_shape) n nonzero)
    _=_:=by unfold sourceRadialSchwartzPrice;ring

/-- Literal original native-simple spatial coefficient on the same source complex side. -/
def sourceMasterSpatialSimpleChannel (q : PhysicalResponsePoint) (c eta : ℝ) (l r : RestStateIndex) (i : Fin 3)
    (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) : ℂ :=
  ∫n : PhysicalMomentum,sourceSpatialPhase n x*test n*
    ((sourcePoleSide c eta)⁻¹*(sourceChargedDenominator (sourceSpatialMomentum n) 0 i)⁻¹*
      sourceSlowRead (sourceNativeSimple q (sourceSpatialMomentum n) l r) ⟨i.val,by omega⟩)

/-- Complete correction simple convergence is paid under the whole original Fourier integral. -/
theorem sourceMasterSpatialCorrection_return (q : PhysicalResponsePoint) (c eta : ℝ)
    (frequency : c≠0) (causal : 0<eta) (l r : RestStateIndex) (i : Fin 3)
    (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) :
    Tendsto (fun d : ℝ=>(d:ℂ)*sourceMasterSpatialChannelCorrection q ((d:ℂ)*sourcePoleSide c eta) l r i test x)
      (𝓝[>] 0) (𝓝 (sourceMasterSpatialSimpleChannel q c eta l r i test x)) := by
  have aenonzero : ∀ᵐ n : PhysicalMomentum ∂volume,n≠0:=by rw [ae_iff];simp
  have generated : Tendsto
      (fun d : ℝ=>∫n : PhysicalMomentum,sourceSpatialPhase n x*test n*((d:ℂ)*
        sourceMasterChannelCorrection q (sourceSpatialMomentum n) ((d:ℂ)*sourcePoleSide c eta) l r i))
      (𝓝[>] 0) (𝓝 (sourceMasterSpatialSimpleChannel q c eta l r i test x)) := by
    apply tendsto_integral_filter_of_dominated_convergence
      (fun n=>sourceMasterCorrectionPrice q c eta l r i*sourceRadialSchwartzPrice test n)
    · filter_upwards [self_mem_nhdsWithin] with d dp
      have paid:=((paidCorrectionIntegrable%) q (d*c) (d*eta) (mul_ne_zero dp.ne' frequency) (mul_pos dp causal) l r i test x).const_mul (d:ℂ)
      rw [side_scaled] at paid
      apply paid.aestronglyMeasurable.congr
      filter_upwards with n
      ring
    · filter_upwards [self_mem_nhdsWithin] with d dp
      filter_upwards [aenonzero] with n nz
      exact sourceMasterCorrection_fourier_bound q c eta frequency causal d dp l r i test x n nz
    · exact (sourceRadialSchwartzPrice_integrable test).const_mul _
    · filter_upwards [aenonzero] with n nz
      have momentumNZ : sourceSpatialMomentum n≠0:=by unfold sourceSpatialMomentum;exact smul_ne_zero (by positivity : (2*Real.pi:ℝ)≠0) nz
      have zp : 0<(sourcePoleSide c eta).re:=by simpa [sourcePoleSide] using causal
      exact (sourceMasterCorrection_pointwise q (sourceSpatialMomentum n) momentumNZ (sourcePoleSide c eta) zp l r i).const_mul
        (sourceSpatialPhase n x*test n)
  apply generated.congr
  intro d
  rw [sourceMasterSpatialChannelCorrection,←integral_const_mul]
  apply integral_congr_ae
  filter_upwards with n
  ring

/-- The returned coefficient is the original inverse-square spatial tensor with its angular/material numerator unchanged. -/
theorem sourceMasterSpatialSimpleChannel_green (q : PhysicalResponsePoint) (c eta : ℝ)
    (l r : RestStateIndex) (i : Fin 3) (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) :
    sourceMasterSpatialSimpleChannel q c eta l r i test x=
      (sourcePoleSide c eta)⁻¹*∫n : PhysicalMomentum,sourceSpatialPhase n x*test n*
        ((spatialSquare (sourceSpatialMomentum n):ℂ)⁻¹*(sourceChargedSpatialCoefficient i:ℂ)⁻¹*
          sourceSlowRead (sourceNativeSimple q (sourceSpatialMomentum n) l r) ⟨i.val,by omega⟩) := by
  rw [sourceMasterSpatialSimpleChannel,←integral_const_mul]
  apply integral_congr_ae
  filter_upwards with n
  simp only [sourceChargedDenominator,zero_pow (by decide : 2≠0),mul_zero,add_zero,mul_inv_rev]
  ring

def sourceMasterSpatialSimpleField (q : PhysicalResponsePoint) (c eta : ℝ) (l r : RestStateIndex)
    (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) : Fin 289→ℂ :=
  ∑i : Fin 3,sourceMasterSpatialSimpleChannel q c eta l r i test x • sourceCommonOriginColumn i

theorem sourceMasterSpatialCorrectionField_return (q : PhysicalResponsePoint) (c eta : ℝ)
    (frequency : c≠0) (causal : 0<eta) (l r : RestStateIndex)
    (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) :
    Tendsto (fun d : ℝ=>(d:ℂ) • sourceMasterSpatialFieldCorrection q ((d:ℂ)*sourcePoleSide c eta) l r test x)
      (𝓝[>] 0) (𝓝 (sourceMasterSpatialSimpleField q c eta l r test x)) := by
  have generated:=tendsto_finsetSum Finset.univ (fun i _=>
    (sourceMasterSpatialCorrection_return q c eta frequency causal l r i test x).smul_const (sourceCommonOriginColumn i))
  simpa only [sourceMasterSpatialFieldCorrection,sourceMasterSpatialSimpleField,Finset.smul_sum,smul_smul] using generated

def sourceActualMasterSpatialSimple (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) (c eta : ℝ)
    (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) : Fin 289→ℂ :=
  ∑l : RestStateIndex,∑r : RestStateIndex,sourceActualPreparedWeight 0 0 sL eL sR eR l r •
    sourceMasterSpatialSimpleField q c eta l r test x

theorem sourceActualMasterSpatialCorrection_return (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (c eta : ℝ) (frequency : c≠0) (causal : 0<eta) (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) :
    Tendsto (fun d : ℝ=>(d:ℂ) • sourceActualMasterSpatialCorrection q sL eL sR eR ((d:ℂ)*sourcePoleSide c eta) test x)
      (𝓝[>] 0) (𝓝 (sourceActualMasterSpatialSimple q sL eL sR eR c eta test x)) := by
  have generated:=tendsto_finsetSum Finset.univ (fun l _=>tendsto_finsetSum Finset.univ (fun r _=>
    (tendsto_const_nhds (x:=sourceActualPreparedWeight 0 0 sL eL sR eR l r)).smul
      (sourceMasterSpatialCorrectionField_return q c eta frequency causal l r test x)))
  change Tendsto _ (𝓝[>] (0:ℝ)) (𝓝 (sourceActualMasterSpatialSimple q sL eL sR eR c eta test x)) at generated
  apply generated.congr
  intro d
  simp only [sourceActualMasterSpatialCorrection,Finset.smul_sum,smul_comm (d:ℂ)]

