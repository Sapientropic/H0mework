private theorem unit_read_continuous (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) (T : ℝ)
    (left : q.z.im≠0) (right : q.w.im≠0) : Continuous (sourceActualUnitFieldRead q sL eL sR eR 0 T) := by
  have same:=funext ((paidMasterUnit%) q sL eL sR eR 0 T left right)
  rw [same]
  apply continuous_finsetSum
  intro i _
  exact (continuous_apply i).mul_const _

private theorem unit_read_smul (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) (T : ℝ)
    (left : q.z.im≠0) (right : q.w.im≠0) (z : ℂ) (V : Fin 289→ℂ) :
    sourceActualUnitFieldRead q sL eL sR eR 0 T (z • V)=z*sourceActualUnitFieldRead q sL eL sR eR 0 T V := by
  simp only [(paidMasterUnit%) q sL eL sR eR 0 T left right,Pi.smul_apply,smul_eq_mul,Finset.mul_sum,mul_assoc]

/-- Independent original unit legs consume the complete correction simple return, with every norm and defect kept in the actual read. -/
theorem sourceActualUnitMasterCorrection_return (qd q : PhysicalResponsePoint)
    (dSL dEL dSR dER sL eL sR eR : Fin 2) (T c eta : ℝ) (frequency : c≠0) (causal : 0<eta)
    (left : qd.z.im≠0) (right : qd.w.im≠0) (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) :
    Tendsto (fun d : ℝ=>(d:ℂ)*sourceActualUnitFieldRead qd dSL dEL dSR dER 0 T
      (sourceActualMasterSpatialCorrection q sL eL sR eR ((d:ℂ)*sourcePoleSide c eta) test x))
      (𝓝[>] 0) (𝓝 (sourceActualUnitFieldRead qd dSL dEL dSR dER 0 T
        (sourceActualMasterSpatialSimple q sL eL sR eR c eta test x))) := by
  have generated:=(unit_read_continuous qd dSL dEL dSR dER T left right).continuousAt.tendsto.comp
    (sourceActualMasterSpatialCorrection_return q sL eL sR eR c eta frequency causal test x)
  simpa only [Function.comp_def,unit_read_smul qd dSL dEL dSR dER T left right] using generated

/-- The same actual response keeps its Euler/master contribution while only the paid correction receives this simple return. -/
theorem sourceActualUnitRadialCorrection_return (qd q : PhysicalResponsePoint)
    (dSL dEL dSR dER sL eL sR eR : Fin 2) (T : ℝ) (branch : Fin 2) (negative : Bool)
    (eta : ℝ) (causal : 0<eta) (left : qd.z.im≠0) (right : qd.w.im≠0)
    (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) :
    Tendsto (fun d : ℝ=>(d:ℂ)*
      (sourcePoleSide (sourceSignedSpeed branch negative) eta*
        sourceActualUnitFieldRead qd dSL dEL dSR dER 0 T
          (sourceActualRadialPotential q sL eL sR eR branch negative eta d test x)-
        sourceActualUnitFieldRead qd dSL dEL dSR dER 0 T
          (sourceActualDilationField q sL eL sR eR (sourceSignedSpeed branch negative) eta test x d)-
        (d:ℂ)*sourceActualUnitFieldRead qd dSL dEL dSR dER 0 T
          (sourceActualDilationGenerator q sL eL sR eR (sourceSignedSpeed branch negative) eta test x d)))
      (𝓝[>] 0) (𝓝 (sourcePoleSide (sourceSignedSpeed branch negative) eta*
        sourceActualUnitFieldRead qd dSL dEL dSR dER 0 T
          (sourceActualMasterSpatialSimple q sL eL sR eR (sourceSignedSpeed branch negative) eta test x))) := by
  have generated:=(sourceActualUnitMasterCorrection_return qd q dSL dEL dSR dER sL eL sR eR T
    (sourceSignedSpeed branch negative) eta (sourceSignedSpeed_nonzero branch negative) causal left right test x).const_mul
      (sourcePoleSide (sourceSignedSpeed branch negative) eta)
  apply generated.congr'
  filter_upwards [self_mem_nhdsWithin] with d dp
  rw [sourceActualUnitRadialPotential_euler qd q dSL dEL dSR dER sL eL sR eR T branch negative eta causal d dp left right test x]
  ring

