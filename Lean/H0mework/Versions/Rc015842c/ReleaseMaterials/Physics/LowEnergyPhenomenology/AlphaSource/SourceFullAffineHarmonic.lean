/-- The original finite coordinate word, now carrying both actual spatial characters. -/
def harmonicLeft (A : Fin 4→FiberOperators) (k : PhysicalMomentum) (time age : ℝ) (i : Fin 4) : (FullMatterL2→L[ℂ]FullMatterL2) :=
  (coordinateLeg i).adjoint*spatialFlow 0 (-time)*
    ((shiftCoefficients A (-k) i).compLpL 2 volume)*shiftFlow (-k) (time-age)

def harmonicRight (B : Fin 4→FiberOperators) (k ell : PhysicalMomentum) (age : ℝ) (j : Fin 4) : (FullMatterL2→L[ℂ]FullMatterL2) :=
  ((B j).compLpL 2 volume)*transfer (k+ell)*spatialFlow 0 age*coordinateLeg j

def harmonicWord (A B : Fin 4→FiberOperators) (k ell : PhysicalMomentum) (time age : ℝ) : (FullMatterL2→L[ℂ]FullMatterL2) :=
  ∑i : Fin 4,∑j : Fin 4,harmonicLeft A k time age i*harmonicRight B k ell age j

def harmonicContact (C : Fin 4→FiberOperators) (Q : PhysicalMomentum) (time : ℝ) : (FullMatterL2→L[ℂ]FullMatterL2) :=
  ∑j : Fin 4,(coordinateLeg 0).adjoint*spatialFlow 0 (-time)*
    ((C j).compLpL 2 volume)*transfer Q*spatialFlow 0 time*coordinateLeg j

theorem harmonicWord_opposite (A B : Fin 4→FiberOperators) (k : PhysicalMomentum) (time age : ℝ) :
    harmonicWord A B (-k) k time age=orderedWord A B k time age := by
  simp only [harmonicWord,harmonicLeft,harmonicRight,neg_neg,neg_add_cancel,transfer_zero,mul_one,
    orderedWord,orderedLeft,orderedRight]

theorem harmonicContact_zero (C : Fin 4→FiberOperators) (time : ℝ) :
    harmonicContact C 0 time=contactWord C time := by
  simp only [harmonicContact,contactWord,transfer_zero,mul_one]

/-- The complete coframe-affine row transforms with the actual physical momentum shift. -/
theorem sourceAffine_shift (A : Fin 4→FiberOperators) (k p : PhysicalMomentum) :
    affine (shiftCoefficients A k) p=affine A (p+k) := by
  simp only [affine,shiftCoefficients,Fin.cases_zero,Fin.cases_succ,Pi.add_apply,
    Complex.ofReal_add]
  have distribute : (∑j : Fin 3,((p j:ℂ)+(k j:ℂ)) • A j.succ)=
      (∑j : Fin 3,(p j:ℂ) • A j.succ)+(∑j : Fin 3,(k j:ℂ) • A j.succ) := by
    rw [←Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro j _
    exact _root_.add_smul (p j:ℂ) (k j:ℂ) (A j.succ)
  rw [distribute]
  abel

private theorem twoSpatialInsertions (M N : FiberOperators) (k ell : PhysicalMomentum) (time age : ℝ) :
    transfer k*M.compLpL 2 volume*spatialFlow 0 (time-age)*(transfer ell*N.compLpL 2 volume)=
      M.compLpL 2 volume*shiftFlow (-k) (time-age)*N.compLpL 2 volume*transfer (k+ell) := by
  calc
    _=M.compLpL 2 volume*(transfer k*spatialFlow 0 (time-age))*(transfer ell*N.compLpL 2 volume) := by
      rw [←constant_transfer M k]
      simp only [mul_assoc]
    _=M.compLpL 2 volume*(shiftFlow (-k) (time-age)*transfer k)*(N.compLpL 2 volume*transfer ell) := by
      rw [transfer_flow,←constant_transfer N ell]
    _=M.compLpL 2 volume*shiftFlow (-k) (time-age)*(transfer k*N.compLpL 2 volume)*transfer ell := by
      simp only [mul_assoc]
    _=M.compLpL 2 volume*shiftFlow (-k) (time-age)*N.compLpL 2 volume*(transfer k*transfer ell) := by
      rw [←constant_transfer N k]
      simp only [mul_assoc]
    _=_ := by rw [transfer_add]

/-- Every one of the sixteen affine coordinate terms is an actual pair of spatial harmonic insertions, enclosed by the original two external source filters. -/
theorem sourceFullAffine_word_spatial (A B : Fin 4→FiberOperators) (k ell : PhysicalMomentum) (time age : ℝ) :
    harmonicWord A B k ell time age=
      ∑i : Fin 4,∑j : Fin 4,
        (coordinateLeg i).adjoint*spatialFlow 0 (-time)*
          (transfer k*(shiftCoefficients A (-k) i).compLpL 2 volume)*spatialFlow 0 (time-age)*
          (transfer ell*(B j).compLpL 2 volume)*spatialFlow 0 age*coordinateLeg j := by
  unfold harmonicWord harmonicLeft harmonicRight
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  have generated:=congrArg (fun M : (FullMatterL2→L[ℂ]FullMatterL2)=>
    (coordinateLeg i).adjoint*spatialFlow 0 (-time)*M*spatialFlow 0 age*coordinateLeg j)
    (twoSpatialInsertions (shiftCoefficients A (-k) i) (B j) k ell time age)
  simpa only [mul_assoc] using generated.symm

/-- Direct contact carries the total spatial wave, while retaining its original time and source filters. -/
theorem sourceFullContact_spatial (C : Fin 4→FiberOperators) (k ell : PhysicalMomentum) (time : ℝ) :
    harmonicContact C (k+ell) time=
      ∑j : Fin 4,(coordinateLeg 0).adjoint*spatialFlow 0 (-time)*
        (transfer k*transfer ell*(C j).compLpL 2 volume)*spatialFlow 0 time*coordinateLeg j := by
  rw [transfer_add]
  unfold harmonicContact
  apply Finset.sum_congr rfl
  intro j _
  rw [←constant_transfer (C j) (k+ell)]
  simp only [mul_assoc]

/-- A fullfield coefficient row is multiplied by the actual source spatial character. -/
theorem sourceHarmonic_row (M : FiberOperators) (k : PhysicalMomentum) (v : FullMatterL2) :
    (transfer k*M.compLpL 2 volume : FullMatterL2→L[ℂ]FullMatterL2) v=ᵐ[volume] fun x=>phase k x • M (v x) := by
  rw [transfer_phase]
  filter_upwards [phaseOperator_ae k (M.compLpL 2 volume v),M.coeFn_compLpL v] with x phaseRead value
  change phaseOperator k (M.compLpL 2 volume v) x=_
  rw [phaseRead,value]

/-- The same fullfield row produces the actual Fourier translation, rather than a wave label. -/
theorem sourceHarmonic_row_fourier (M : FiberOperators) (k : PhysicalMomentum) (v : FullMatterL2) :
    fourier ((transfer k*M.compLpL 2 volume : FullMatterL2→L[ℂ]FullMatterL2) v)=ᵐ[volume]
      fun x=>M (fourier v (x-frequencyShift k)) := by
  rw [←constant_transfer M k]
  change fourier (M.compLpL 2 volume (transfer k v))=ᵐ[volume] _
  rw [GaugeGreen.constant_fourier]
  filter_upwards [M.coeFn_compLpL (fourier (transfer k v)),transfer_fourier k v] with x matrix shifted
  rw [matrix,shifted]

