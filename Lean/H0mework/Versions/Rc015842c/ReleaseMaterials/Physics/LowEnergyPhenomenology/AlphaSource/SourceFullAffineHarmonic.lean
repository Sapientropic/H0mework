def frequencyShift (k : Fin 3 → ℝ) : Position :=
  WithLp.toLp 2 (fun j => k j/(2*Real.pi))

theorem frequencyShift_zero : frequencyShift 0 = 0 := by
  ext j
  simp [frequencyShift]

theorem physicalMomentum_transfer (k : Fin 3 → ℝ) (x : Position) :
    physicalMomentum (x-frequencyShift k) = physicalMomentum x-k := by
  funext j
  change 2*Real.pi*(x j-k j/(2*Real.pi)) = 2*Real.pi*x j-k j
  field_simp

private theorem transfer_preserving (k : Fin 3 → ℝ) :
    MeasurePreserving (fun x : Position => x-frequencyShift k) volume volume := by
  simpa only [sub_eq_add_neg] using measurePreserving_add_right volume (-frequencyShift k)

def momentumTransfer (k : Fin 3 → ℝ) : FullMatterL2 →ₗᵢ[ℂ] FullMatterL2 :=
  Lp.compMeasurePreservingₗᵢ ℂ (fun x => x-frequencyShift k) (transfer_preserving k)

def transfer (k : Fin 3 → ℝ) : FullMatterL2 →L[ℂ] FullMatterL2 :=
  fourier.symm.toContinuousLinearEquiv.toContinuousLinearMap.comp
    ((momentumTransfer k).toContinuousLinearMap.comp fourier.toContinuousLinearEquiv.toContinuousLinearMap)

theorem transfer_fourier (k : Fin 3 → ℝ) (v : FullMatterL2) :
    fourier (transfer k v) =ᵐ[volume] fun x => fourier v (x-frequencyShift k) := by
  change fourier (fourier.symm (momentumTransfer k (fourier v))) =ᵐ[volume] _
  rw [fourier.apply_symm_apply]
  exact Lp.coeFn_compMeasurePreserving (fourier v) (transfer_preserving k)

theorem transfer_norm_map (k : Fin 3 → ℝ) (v : FullMatterL2) :
    ‖transfer k v‖ = ‖v‖ := by
  change ‖fourier.symm (momentumTransfer k (fourier v))‖ = _
  rw [fourier.symm.norm_map, (momentumTransfer k).norm_map, fourier.norm_map]

theorem transfer_norm (k : Fin 3 → ℝ) : ‖transfer k‖ ≤ 1 := by
  apply ContinuousLinearMap.opNorm_le_bound _ (by norm_num)
  intro v
  simp only [transfer_norm_map, one_mul, le_refl]

theorem transfer_zero : transfer 0 = 1 := by
  apply ContinuousLinearMap.ext
  intro v
  change transfer 0 v = v
  apply fourier.injective
  apply Lp.ext
  filter_upwards [transfer_fourier 0 v] with x generated
  simpa only [frequencyShift_zero, sub_zero] using generated

def phase (k : Fin 3 → ℝ) (x : Position) : ℂ :=
  Real.fourierChar (inner ℝ (frequencyShift k) x)

theorem phase_continuous (k : Fin 3 → ℝ) : Continuous (phase k) := by
  have character : Continuous (fun x : Position => Real.fourierChar (inner ℝ (frequencyShift k) x)) :=
    Real.continuous_fourierChar.comp
      ((continuous_const : Continuous (fun _ : Position => frequencyShift k)).inner continuous_id)
  exact continuous_subtype_val.comp character

theorem phase_norm (k : Fin 3 → ℝ) (x : Position) : ‖phase k x‖ = 1 := Circle.norm_coe _

def phaseMatrices (k : Fin 3 → ℝ) (x : Position) : FiberOperators := phase k x • 1

theorem phaseMatrices_continuous (k : Fin 3 → ℝ) : Continuous (phaseMatrices k) :=
  (phase_continuous k).smul continuous_const

theorem phaseMatrices_bound (k : Fin 3 → ℝ) (x : Position) : ‖phaseMatrices k x‖ ≤ 1 := by
  rw [phaseMatrices, norm_smul, phase_norm, one_mul]
  apply ContinuousLinearMap.opNorm_le_bound _ (by norm_num)
  intro v
  simp

def phaseOperator (k : Fin 3 → ℝ) : FullMatterL2 →L[ℂ] FullMatterL2 :=
  multiplier (phaseMatrices k) (phaseMatrices_continuous k) 1 (phaseMatrices_bound k) (by norm_num)

theorem phaseOperator_ae (k : Fin 3 → ℝ) (v : FullMatterL2) :
    phaseOperator k v =ᵐ[volume] fun x => phase k x • v x := by
  have source := multiplierValue_ae (phaseMatrices k) (phaseMatrices_continuous k)
    1 (phaseMatrices_bound k) v
  change multiplierValue (phaseMatrices k) (phaseMatrices_continuous k) 1 (phaseMatrices_bound k) v =ᵐ[volume] _
  simpa only [phaseMatrices, smul_apply, ContinuousLinearMap.one_def,
    ContinuousLinearMap.id_apply] using source

theorem phase_physical (k : Fin 3 → ℝ) (x : Position) :
    phase k x = Complex.exp (((∑ j : Fin 3, k j*x j : ℝ) : ℂ)*Complex.I) := by
  have frequency : 2*Real.pi*inner ℝ (frequencyShift k) x = ∑ j : Fin 3, k j*x j := by
    simp only [PiLp.inner_apply, frequencyShift, Real.inner_apply]
    change 2*Real.pi*(∑ j : Fin 3, (k j/(2*Real.pi))*x j) = _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    field_simp
  simp only [phase, Real.fourierChar_apply, frequency]

private theorem momentumTransfer_schwartz (k : Fin 3 → ℝ) (f : 𝓢(Position,Hilbert)) :
    momentumTransfer k (f.toLp 2) = (f.compSubConstCLM ℂ (frequencyShift k)).toLp 2 := by
  apply Lp.ext
  have shifted := (transfer_preserving k).quasiMeasurePreserving.ae (f.coeFn_toLp 2 volume)
  filter_upwards [Lp.coeFn_compMeasurePreserving (f.toLp 2) (transfer_preserving k), shifted,
    (f.compSubConstCLM ℂ (frequencyShift k)).coeFn_toLp 2 volume] with x translated old fresh
  change Lp.compMeasurePreserving (fun x => x-frequencyShift k) (transfer_preserving k) (f.toLp 2) x = _
  rw [translated, fresh]
  exact old

private theorem inverse_translate_schwartz (k : Fin 3 → ℝ) (f : 𝓢(Position,Hilbert)) (x : Position) :
    (𝓕⁻ (f.compSubConstCLM ℂ (frequencyShift k))) x = phase k x • (𝓕⁻ f) x := by
  rw [SchwartzMap.fourierInv_coe, SchwartzMap.fourierInv_coe, Real.fourierInv_eq, Real.fourierInv_eq]
  have source := congrFun (VectorFourier.fourierIntegral_comp_add_right Real.fourierChar
    (volume : Measure Position) (-innerₗ Position) (f : Position → Hilbert) (-frequencyShift k)) x
  simpa only [VectorFourier.fourierIntegral, Function.comp_def, SchwartzMap.compSubConstCLM_apply,
    sub_eq_add_neg, LinearMap.neg_apply, innerₗ_apply_apply, inner_neg_left,
    neg_neg, Circle.smul_def, phase] using source

theorem transfer_phase (k : Fin 3 → ℝ) : transfer k = phaseOperator k := by
  have inverse (v : FullMatterL2) : fourier.symm (momentumTransfer k v) = phaseOperator k (fourier.symm v) := by
    apply DenseRange.induction_on (p := fun w : FullMatterL2 =>
        fourier.symm (momentumTransfer k w) = phaseOperator k (fourier.symm w))
      (SchwartzMap.denseRange_toLpCLM (E := Position) (F := Hilbert) (p := 2) ENNReal.ofNat_ne_top) v
    · exact isClosed_eq (fourier.symm.continuous.comp (momentumTransfer k).continuous)
        ((phaseOperator k).continuous.comp fourier.symm.continuous)
    · intro test
      change fourier.symm (momentumTransfer k (test.toLp 2)) = phaseOperator k (fourier.symm (test.toLp 2))
      rw [momentumTransfer_schwartz]
      change 𝓕⁻ ((test.compSubConstCLM ℂ (frequencyShift k)).toLp 2) = phaseOperator k (𝓕⁻ (test.toLp 2))
      rw [SchwartzMap.toLp_fourierInv_eq, SchwartzMap.toLp_fourierInv_eq]
      apply Lp.ext
      filter_upwards [(𝓕⁻ (test.compSubConstCLM ℂ (frequencyShift k))).coeFn_toLp 2 volume,
        (𝓕⁻ test).coeFn_toLp 2 volume,
        phaseOperator_ae k ((𝓕⁻ test).toLp 2)] with x shifted original multiplied
      rw [shifted, multiplied, original]
      exact inverse_translate_schwartz k test x
  apply ContinuousLinearMap.ext
  intro v
  change fourier.symm (momentumTransfer k (fourier v)) = phaseOperator k v
  rw [inverse, fourier.symm_apply_apply]

theorem phase_add (k ell : Fin 3 → ℝ) (x : Position) :
    phase (k+ell) x = phase k x*phase ell x := by
  rw [phase_physical, phase_physical, phase_physical, ← Complex.exp_add]
  congr 1
  simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib, Complex.ofReal_add]

theorem transfer_add (k ell : Fin 3 → ℝ) : transfer k*transfer ell = transfer (k+ell) := by
  simp only [transfer_phase]
  apply ContinuousLinearMap.ext
  intro v
  apply Lp.ext
  filter_upwards [phaseOperator_ae k (phaseOperator ell v), phaseOperator_ae ell v,
    phaseOperator_ae (k+ell) v] with x outer inside total
  change phaseOperator k (phaseOperator ell v) x = phaseOperator (k+ell) v x
  rw [outer, inside, total, smul_smul, phase_add]

theorem constant_transfer (M : FiberOperators) (k : Fin 3 → ℝ) :
    M.compLpL 2 volume*transfer k = transfer k*M.compLpL 2 volume := by
  rw [transfer_phase]
  apply ContinuousLinearMap.ext
  intro v
  apply Lp.ext
  filter_upwards [M.coeFn_compLpL (phaseOperator k v), phaseOperator_ae k v,
    phaseOperator_ae k (M.compLpL 2 volume v), M.coeFn_compLpL v] with x outer phaseRead other inside
  change M.compLpL 2 volume (phaseOperator k v) x = phaseOperator k (M.compLpL 2 volume v) x
  rw [outer, phaseRead, other, inside, map_smul]

theorem transfer_flow (k : Fin 3 → ℝ) (time : ℝ) :
    transfer k*spatialFlow 0 time = shiftFlow (-k) time*transfer k := by
  apply ContinuousLinearMap.ext
  intro v
  apply fourier.injective
  apply Lp.ext
  have shifted := (transfer_preserving k).quasiMeasurePreserving.ae (spatialFlow_fourier_ae 0 time v)
  filter_upwards [transfer_fourier k (spatialFlow 0 time v),
    shiftFlow_fourier (-k) time (transfer k v), transfer_fourier k v, shifted]
    with x first second input moved
  change fourier (transfer k (spatialFlow 0 time v)) x = fourier (shiftFlow (-k) time (transfer k v)) x
  rw [first, second, input, moved, physicalMomentum_transfer]
  rfl

