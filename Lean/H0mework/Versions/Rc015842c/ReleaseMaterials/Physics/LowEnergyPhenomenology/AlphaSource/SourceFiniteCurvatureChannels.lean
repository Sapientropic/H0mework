/-- The original full origin and all 200 literal jet terms generate six surviving curvature entries. -/
theorem sourceSlowCurvature_generated (p : Fin 4→ℂ) :
    sourceMatrix sourceSlowCurvatureTerms p=
      sourceMatrix sourceCurvatureSlopeTerms p*fullNativeOrigin*slowFastFrame+
      sourceCurvatureOriginMatrix*sourceMatrix sourceEnergyChannelTerms p := by
  have cert : fastNormalizeTerms
      (productTerms (productTerms sourceCurvatureSlopeTerms fullNativeOriginTerms) slowFastFrameTerms++
      productTerms sourceCurvatureOriginTerms sourceEnergyChannelTerms++negativeTerms sourceSlowCurvatureTerms)=[] := by
    decide +kernel
  have generated:=normalization_equal _ _ cert p
  simp only [sourceMatrix_append,productTerms_value] at generated
  have originConstant : sourceMatrix fullNativeOriginTerms p=fullNativeOrigin := by
    rw [fullNativeOrigin_generated]
    have supported : fullNativeOriginTerms.all (fun t=>decide (t.powers=⟨0,0,0,0⟩))=true := by decide +kernel
    unfold sourceMatrix
    apply congrArg List.sum
    apply List.map_congr_left
    intro t member
    have powers:=of_decide_eq_true (List.all_eq_true.mp supported t member)
    simp only [SourceTerm.matrix,powers,Powers.value,pow_zero,mul_one]
  rw [originConstant,slowFastFrame_constant] at generated
  have c0 : sourceMatrix sourceCurvatureOriginTerms p=sourceCurvatureOriginMatrix := by
    norm_num [sourceCurvatureOriginTerms,sourceCurvatureOriginMatrix,sourceMatrix,SourceTerm.matrix,Powers.value]
  rw [c0] at generated
  exact generated.symm

/-- The real pole jet returns through those six entries plus its independently retained fast contribution. -/
theorem sourcePoleCurvatureJet_generated (branch : Fin 2) (epsilon s : ℝ) (n : PhysicalMomentum) (r : Fin 36) :
    sourcePoleCurvatureJet branch epsilon s n r=
      (sourceMatrix sourceSlowCurvatureTerms (physicalFrequencyMomentum s n)*ᵥsourcePoleCoordinates branch epsilon s n)
        (Fin.castLE (by decide) r)+
      (originalReader36 0*ᵥsourcePoleFastJet branch epsilon s n) r := by
  rw [sourceSlowCurvature_generated,Matrix.add_mulVec,←Matrix.mulVec_mulVec,←Matrix.mulVec_mulVec,
    ←Matrix.mulVec_mulVec]
  simp only [sourcePoleCurvatureJet,sourcePoleOriginField,sourcePoleLiteralJet,Matrix.mulVec_add,Pi.add_apply]
  simp only [←Matrix.mulVec_mulVec]
  simp only [Matrix.mulVec,dotProduct,sourceCurvatureSlope_generated,sourceCurvatureOrigin_generated,
    Pi.sub_apply]
  ring

open PreparationVacuumMixedPrincipal PreparationVacuumMixedEffective PreparationVacuumFullOriginResponse
open PreparationVacuumMixedControl
open PreparationVacuumPhysicalChargedFieldFactor

/-- Temporal fast curvature surviving away from the static axis. -/
def sourceFastCurvatureTerms : List SourceTerm := [
  ⟨35,3,⟨1,0,0,0⟩,⟨⟨0,0⟩,⟨(25/81:ℚ),0⟩⟩⟩]

private def fastColumns (j : Fin 289) : Bool := !decide (j.val<3)
private def fastKernelTerms : List SourceTerm :=
  fastNormalizeTerms (productTerms fullKernelTerms (columnTerms fastColumns slowFastFrameTerms))
private def fastForceTerms : List SourceTerm :=
  fastNormalizeTerms (productTerms (degreeTerms (positiveTerms activeTerms) 1) fastKernelTerms)
private def fastResponseTerms : List SourceTerm :=
  fastNormalizeTerms (productTerms
    (componentInverseTerms 0++componentInverseTerms 1++componentInverseTerms 2) fastForceTerms)
private def fastFrameTerms : List SourceTerm :=
  productTerms (degreeTerms (positiveTerms originalChangeTerms) 1) fastKernelTerms++
    negativeTerms (productTerms (originTerms originalChangeTerms) fastResponseTerms)

private theorem fastInverse_constant (v : Fin 4→ℂ) (i : Fin 3) :
    sourceMatrix (componentInverseTerms i) v=componentInverse i := by
  fin_cases i <;> rfl

private theorem fastFrame_value (v : Fin 4→ℂ) :
    sourceMatrix fastFrameTerms v=sourceChargedNativeFrameJet v*projectionMatrix fastColumns := by
  simp only [fastFrameTerms,fastKernelTerms,fastForceTerms,fastResponseTerms,
    fastNormalizeTerms_value,productTerms_value,sourceMatrix_append,negativeTerms_value,
    columnTerms_value,fastInverse_constant,fullKernel_generated,slowFastFrame_constant]
  have origin : sourceMatrix (originTerms originalChangeTerms) v=originalChange 0 := by
    calc
      _=sourceMatrix (originTerms originalChangeTerms) 0 := by
        simpa only [degreeTensor,degreeTerms,PreparationVacuumMixedPrincipal.originTerms,zero_smul,pow_zero,one_smul] using
          (degreeTensor_scaled originalChangeTerms 0 (0:ℂ) v).symm
      _=originalChange 0 := originTerms_generated originalChangeTerms
  rw [origin]
  simp only [sourceChargedNativeFrameJet,sourceLinearPart,degreeTensor,fullInverse,Fin.sum_univ_three]
  simp only [sub_eq_add_neg,add_mul,neg_mul,mul_assoc]

private theorem fastColumns_complement :
    projectionMatrix fastColumns=1-projectionMatrix (fun j : Fin 289=>decide (j.val<3)) := by
  ext i j
  simp only [projectionMatrix,Matrix.diagonal_apply,fastColumns,Matrix.sub_apply,Matrix.one_apply]
  split_ifs <;> simp_all
  omega

/-- The original full inverse and K1 pay the nonzero temporal fast term; it is not a static-axis extrapolation. -/
theorem sourceFastCurvature_generated (v : Fin 4→ℂ) :
    sourceMatrix sourceFastCurvatureTerms v=
      sourceCurvatureOriginMatrix*sourceChargedNativeFrameJet v*
        (1-projectionMatrix (fun j : Fin 289=>decide (j.val<3))) := by
  have cert : fastNormalizeTerms (productTerms sourceCurvatureOriginTerms fastFrameTerms++
      negativeTerms sourceFastCurvatureTerms)=[] := by decide +kernel
  have generated:=normalization_equal _ _ cert v
  rw [productTerms_value,fastFrame_value,fastColumns_complement] at generated
  have c0 : sourceMatrix sourceCurvatureOriginTerms v=sourceCurvatureOriginMatrix := by
    norm_num [sourceCurvatureOriginTerms,sourceCurvatureOriginMatrix,sourceMatrix,SourceTerm.matrix,Powers.value]
  rw [c0,←mul_assoc] at generated
  exact generated.symm

/-- The actual finite pole curvature jet has all seven generated entries and its current five coordinates. -/
theorem sourcePoleCurvatureJet_complete (branch : Fin 2) (epsilon sigma : ℝ) (n : PhysicalMomentum) (r : Fin 36) :
    sourcePoleCurvatureJet branch epsilon sigma n r=
      (sourceMatrix (sourceSlowCurvatureTerms++sourceFastCurvatureTerms) (physicalFrequencyMomentum sigma n)*ᵥ
        sourcePoleCoordinates branch epsilon sigma n) (Fin.castLE (by decide) r) := by
  rw [sourcePoleCurvatureJet_generated,sourceMatrix_append,Matrix.add_mulVec,Pi.add_apply,
    sourceFastCurvature_generated,←Matrix.mulVec_mulVec,←Matrix.mulVec_mulVec]
  simp only [sourcePoleFastJet,Matrix.mulVec,dotProduct,sourceCurvatureOrigin_generated]

/-- Actual source-current emission consumes the seven-term finite curvature response on its own generated sheet. -/
theorem sourceGaugePhotonCurvature_complete (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (pL pR : PhysicalMomentum) (lambda : ℂ) (T : ℝ) (branch : Fin 2) (n : PhysicalMomentum)
    (unit : spatialSquare n=1) (r : Fin 36) :
    ∀ᶠ e in scaleApproach,
      sourceGaugePhotonCurvature q sL eL sR eR pL pR lambda T e.val (sourceSheet branch n unit e.val) n r=
        sourcePhotonLeftReader branch e.val (sourceSheet branch n unit e.val) n
          (sourceActualPreparedCurrent q pL pR sL eL sR eR lambda T)*
          ((e.val:ℂ)^2 *
            (sourceMatrix (sourceSlowCurvatureTerms++sourceFastCurvatureTerms)
              (physicalFrequencyMomentum (sourceSheet branch n unit e.val) n)*ᵥ
                sourcePoleCoordinates branch e.val (sourceSheet branch n unit e.val) n) (Fin.castLE (by decide) r)+
            sourcePoleCurvatureRemainder branch e.val (sourceSheet branch n unit e.val) n r) := by
  filter_upwards [sourceGaugePhotonCurvature_generated q sL eL sR eR pL pR lambda T branch n unit] with e returned
  rw [sourceNativeSheetCurvature_firstReturn branch n unit ⟨e.val,e.property.1⟩] at returned
  have row:=congrFun returned r
  simp only [Pi.smul_apply,Pi.add_apply,smul_eq_mul] at row
  rw [sourcePoleCurvatureJet_complete] at row
  exact row

