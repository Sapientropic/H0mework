private theorem sourceMatrix_entry (ts : List SourceTerm) (p : Fin 4 → ℂ) (i j : Fin 289) :
    sourceMatrix ts p i j =
      (ts.map (fun a => if a.row = i ∧ a.column = j
        then coefficientValue a.coefficient * a.powers.value p else 0)).sum := by
  induction ts with
  | nil => simp [sourceMatrix]
  | cons a rest ih =>
    rw [sourceMatrix_cons, Matrix.add_apply, ih, List.map_cons, List.sum_cons]
    rw [SourceTerm.matrix, Matrix.single_apply]

private theorem entry_dite (P : Prop) [Decidable P] (V : ℂ)
    (A : P→ℂ) (B : (¬P)→ℂ) (hA : ∀h,V=A h) (hB : ∀h,V=B h) :
    V=dite P A B := by
  by_cases h : P
  · rw [dif_pos h];exact hA h
  · rw [dif_neg h];exact hB h

