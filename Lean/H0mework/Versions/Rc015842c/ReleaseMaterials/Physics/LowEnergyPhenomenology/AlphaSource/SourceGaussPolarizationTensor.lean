private theorem pair_add_left (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) (a b c : Field289) :
    sourceUnitFourPointPair q sL eL sR eR (a+b) c=
      sourceUnitFourPointPair q sL eL sR eR a c+sourceUnitFourPointPair q sL eL sR eR b c := by
  apply Prod.ext <;>
    simp only [sourceUnitFourPointPair,sourceFourPointForward,sourceFourPointReverse,sourceFourPointContact,
      map_add,add_apply,mul_add,add_mul,Prod.fst_add,Prod.snd_add]
  all_goals abel
private theorem pair_add_right (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) (a b c : Field289) :
    sourceUnitFourPointPair q sL eL sR eR a (b+c)=
      sourceUnitFourPointPair q sL eL sR eR a b+sourceUnitFourPointPair q sL eL sR eR a c := by
  apply Prod.ext <;>
    simp only [sourceUnitFourPointPair,sourceFourPointForward,sourceFourPointReverse,sourceFourPointContact,
      map_add,mul_add,add_mul,Prod.fst_add,Prod.snd_add]
  all_goals abel
private theorem field_smul_apply (r : ℝ) (A : Field289→L[ℝ](H→L[ℂ]H)) (f : Field289) :
    (r • A) f=r • A f := rfl
private theorem field_map_smul (A : Field289→L[ℝ](H→L[ℂ]H)) (r : ℝ) (f : Field289) :
    A (r • f)=r • A f := A.map_smul r f
private theorem hessian_map_smul (A : Field289→L[ℝ]Field289→L[ℝ](H→L[ℂ]H)) (r : ℝ) (f : Field289) :
    A (r • f)=r • A f := A.map_smul r f
private theorem op_smul_mul (r : ℝ) (A B : H→L[ℂ]H) : (r • A)*B=r • (A*B) := by
  apply ContinuousLinearMap.ext
  intro x
  rfl
private theorem op_mul_smul (r : ℝ) (A B : H→L[ℂ]H) : A*(r • B)=r • (A*B) := by
  apply ContinuousLinearMap.ext
  intro x
  exact (A.restrictScalars ℝ).map_smul r (B x)
private theorem unit_real_smul (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (r : ℝ) (A : H→L[ℂ]H) :
    sourceUnitRead q sL eL sR eR (r • A)=r • sourceUnitRead q sL eL sR eR A :=
  ((sourceUnitRead q sL eL sR eR).restrictScalars ℝ).map_smul r A
private theorem complex_real_add (r : ℝ) (a b : ℂ) : r • (a+b)=r • a+r • b := smul_add r a b
private theorem complex_real_neg (r : ℝ) (a : ℂ) : r • (-a)= -(r • a) := smul_neg r a
private theorem pair_smul_left (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) (r : ℝ) (a b : Field289) :
    sourceUnitFourPointPair q sL eL sR eR (r • a) b=r • sourceUnitFourPointPair q sL eL sR eR a b := by
  apply Prod.ext <;>
    simp only [sourceUnitFourPointPair,sourceFourPointForward,sourceFourPointReverse,sourceFourPointContact,
      field_map_smul,hessian_map_smul,field_smul_apply,op_smul_mul,op_mul_smul,unit_real_smul,
      complex_real_add,complex_real_neg,Prod.smul_fst,Prod.smul_snd]
private theorem pair_smul_right (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) (r : ℝ) (a b : Field289) :
    sourceUnitFourPointPair q sL eL sR eR a (r • b)=r • sourceUnitFourPointPair q sL eL sR eR a b := by
  apply Prod.ext <;>
    simp only [sourceUnitFourPointPair,sourceFourPointForward,sourceFourPointReverse,sourceFourPointContact,
      field_map_smul,op_smul_mul,op_mul_smul,unit_real_smul,
      complex_real_add,complex_real_neg,Prod.smul_fst,Prod.smul_snd]
private def gaussPairBilinear (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) :
    Field289→ₗ[ℝ]Field289→ₗ[ℝ](ℂ × ℂ) where
  toFun f:={toFun:=sourceUnitFourPointPair q sL eL sR eR f
            map_add':=pair_add_right q sL eL sR eR f
            map_smul':=fun r g=>by simpa using pair_smul_right q sL eL sR eR r f g}
  map_add' f g:=LinearMap.ext fun x=>pair_add_left q sL eL sR eR f g x
  map_smul' r f:=LinearMap.ext fun x=>by simpa using pair_smul_left q sL eL sR eR r f x

/-- Complexification is performed after the actual two real source insertions, keeping the Gauss Hessian in a separate output. -/
def sourceGaussPolarizationPair (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) :
    (Fin 289→ℂ)→ₗ[ℂ](Fin 289→ℂ)→ₗ[ℂ](ℂ × ℂ) :=
  coefficientBilinear (gaussPairBilinear q sL eL sR eR)

/-- The original independent complex field quadratures return the two ordered and direct Hessian components separately. -/
theorem sourceGaussPolarizationPair_quadratures (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (v w : Fin 289→ℂ) :
    sourceGaussPolarizationPair q sL eL sR eR v w=
      sourceUnitFourPointPair q sL eL sR eR (fun i=>(v i).re) (fun i=>(w i).re)-
      sourceUnitFourPointPair q sL eL sR eR (fun i=>(v i).im) (fun i=>(w i).im)+
      Complex.I • (sourceUnitFourPointPair q sL eL sR eR (fun i=>(v i).re) (fun i=>(w i).im)+
        sourceUnitFourPointPair q sL eL sR eR (fun i=>(v i).im) (fun i=>(w i).re)) := by
  change extendCoefficient _ w=_
  rw [←bilinear_right]
  rfl

private def axisCast (k : Fin 4) : Fin 289→ℂ:=fun row=>(sourceEnergyAxisField 1 k row:ℂ)

