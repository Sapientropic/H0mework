/-- The three actual configuration pieces and the retained full Yukawa jet are evaluated on the literal source field before the spectral resolvents. -/
def sourcePolarizationMaterialCurrent (f : Field289) (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) : H→L[ℂ]H :=
  sourceAssembly p F (fun i j=>
    (nativeFixedJets f (bareTest p F i) (bareTest p F j)).first 0+
    (coframeFixedJets f (bareTest p F i) (bareTest p F j)).first 0+
    (fixedJets (diagonalFiber p) (diagonalFiber_smooth p) f (bareTest p F i) (bareTest p F j)).first 0)+
    sourceYJet f p F none 1 0

def sourcePolarizationMaterialSecond (f : Field289) (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) : H→L[ℂ]H :=
  sourceAssembly p F (fun i j=>
    (nativeFixedJets f (bareTest p F i) (bareTest p F j)).second+
    (coframeFixedJets f (bareTest p F i) (bareTest p F j)).second+
    (fixedJets (diagonalFiber p) (diagonalFiber_smooth p) f (bareTest p F i) (bareTest p F j)).second)+
    sourceYJet f p F none 2 0

private theorem material_current (f : Field289) (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) (z : ℂ) :
    jointCurrent p F z 0 f=sourcePolarizationMaterialCurrent f p F := by
  rw [jointCurrent_source,sourceCurrent_complete]
  rfl
private theorem material_second (f : Field289) (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) (z : ℂ) :
    jointHessian p F z f f=sourcePolarizationMaterialSecond f p F := by
  rw [jointHessian_source_diagonal,sourceContact_complete]
  rfl

attribute [local irreducible] sourcePolarizationMaterialCurrent sourcePolarizationMaterialSecond

/-- The actual mixed Hessian is recovered from three source second variations; this retains native, coframe, matter and full-Y contact even when the raw density contact vanishes. -/
def sourcePolarizationMaterialHessian (f g : Field289) (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) : H→L[ℂ]H :=
  (1/2:ℝ) • (sourcePolarizationMaterialSecond (f+g) p F-
    sourcePolarizationMaterialSecond f p F-sourcePolarizationMaterialSecond g p F)

private theorem material_hessian (f g : Field289) (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) (z : ℂ) :
    jointHessian p F z f g=sourcePolarizationMaterialHessian f g p F := by
  unfold sourcePolarizationMaterialHessian
  have actual := congrArg (fun A : H→L[ℂ]H => (1/2:ℝ) • A)
    (congrArg₂ (fun A B : H→L[ℂ]H => A-B)
      (congrArg₂ (fun A B : H→L[ℂ]H => A-B)
        (material_second (f+g) p F z) (material_second f p F z))
      (material_second g p F z))
  refine Eq.trans ?_ actual
  simp only [map_add,add_apply]
  have symmetric := congrArg (fun A : H→L[ℂ]H =>
    (1/2:ℝ) • (jointHessian p F z f g+A)) (jointHessian_symmetric p F z g f)
  calc
    jointHessian p F z f g = (1/2:ℝ) • (jointHessian p F z f g+jointHessian p F z f g) := by module
    _ = (1/2:ℝ) • (jointHessian p F z f g+jointHessian p F z g f) := symmetric.symm
    _ = _ := by module

/-- Every matrix entry is the original two ordered Gauss currents and their independently generated complete Hessian, at the literal first-pole axis. -/
def sourceGaussFirstAxisPair (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) (k l : Fin 4) : ℂ × ℂ :=
  (sourceUnitRead q sL eL sR eR
      (sourcePolarizationMaterialCurrent (sourceEnergyAxisField 1 k) 0 q.F*jointResolvent 0 q.F q.z 0*
        sourcePolarizationMaterialCurrent (sourceEnergyAxisField 1 l) 0 q.F)+
    sourceUnitRead q sL eL sR eR
      (sourcePolarizationMaterialCurrent (sourceEnergyAxisField 1 l) 0 q.F*jointResolvent 0 q.F q.w 0*
        sourcePolarizationMaterialCurrent (sourceEnergyAxisField 1 k) 0 q.F),
    -sourceUnitRead q sL eL sR eR
      (sourcePolarizationMaterialHessian (sourceEnergyAxisField 1 k) (sourceEnergyAxisField 1 l) 0 q.F))

private theorem field_zero : (fun _ : Fin 289 => (0:ℝ))=(0:Field289) := rfl

private theorem axis_pair (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) (k l : Fin 4) :
    sourceGaussPolarizationPair q sL eL sR eR (axisCast k) (axisCast l)=
      sourceGaussFirstAxisPair q sL eL sR eR k l := by
  change extendCoefficient _ (axisCast l)=_
  rw [←bilinear_right]
  simp only [extendBilinear,axisCast,Complex.ofReal_re,Complex.ofReal_im,field_zero,
    map_zero,LinearMap.zero_apply,smul_zero,sub_zero,add_zero]
  change sourceUnitFourPointPair q sL eL sR eR (sourceEnergyAxisField 1 k) (sourceEnergyAxisField 1 l)=_
  simp only [sourceUnitFourPointPair,sourceFourPointForward,sourceFourPointReverse,sourceFourPointContact,
    sourceGaussFirstAxisPair,material_current,material_hessian]

private theorem first_column (v : Fin 4→ℂ) :
    (fun row=>sourceChargedNativeFrameJet v row 1)=∑k : Fin 4,v k • axisCast k := by
  funext row
  simpa only [Finset.sum_apply,Pi.smul_apply,smul_eq_mul,axisCast] using sourceFirstLiteralField_generated v row

/-- Actual full200 coefficients produce all sixteen Gauss ordered/Hessian entries, without a prepared-block truncation. -/
theorem sourceGaussFirstColumn_return (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (v w : Fin 4→ℂ) :
    sourceGaussPolarizationPair q sL eL sR eR (fun row=>sourceChargedNativeFrameJet v row 1)
      (fun row=>sourceChargedNativeFrameJet w row 1)=
      ∑k : Fin 4,∑l : Fin 4,(v k*w l) • sourceGaussFirstAxisPair q sL eL sR eR k l := by
  rw [first_column,first_column]
  simp only [map_sum,map_smul,LinearMap.sum_apply,LinearMap.smul_apply,Finset.smul_sum,smul_smul,axis_pair]
  rw [Finset.sum_comm]
  simp only [mul_comm]

/-- The harmonic phase and physical frequency/momentum determine the actual mode, rather than a caller supplied polarization coefficient. -/
def sourceGaussFirstMode (omega : ℝ) (k : PhysicalMomentum) (x : BasePoint) : Fin 289→ℂ :=
  fun row=>(sourceFirstModeField false omega k x row:ℂ)+Complex.I*(sourceFirstModeField true omega k x row:ℂ)

theorem sourceGaussFirstMode_return (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (omega nu : ℝ) (k l : PhysicalMomentum) (x y : BasePoint) :
    sourceGaussPolarizationPair q sL eL sR eR (sourceGaussFirstMode omega k x) (sourceGaussFirstMode nu l y)=
      ∑a : Fin 4,∑b : Fin 4,
        (sourceFirstHarmonicPhase omega k x*sourceFirstHarmonicPhase nu l y*
          physicalFrequencyMomentum omega k a*physicalFrequencyMomentum nu l b) •
            sourceGaussFirstAxisPair q sL eL sR eR a b := by
  have mode (w : ℝ) (p : PhysicalMomentum) (z : BasePoint) :
      sourceGaussFirstMode w p z=sourceFirstHarmonicPhase w p z •
        (fun row=>sourceChargedNativeFrameJet (physicalFrequencyMomentum w p) row 1) := by
    funext row
    exact sourceFirstModeField_complex w p z row
  rw [mode,mode]
  simp only [map_smul,LinearMap.smul_apply]
  rw [sourceGaussFirstColumn_return]
  simp only [Finset.smul_sum,smul_smul]
  apply Finset.sum_congr rfl
  intro a _
  apply Finset.sum_congr rfl
  intro b _
  congr 1
  ring

/-- All origin, literal/fast jet and remaining whole-field crosses enter the same Gauss tensor. -/
theorem sourceGaussWholePolarization_return (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (left right : Fin 2) (epsilon s t : ℝ) (n m : PhysicalMomentum) (nonzero : epsilon≠0) :
    sourceGaussPolarizationPair q sL eL sR eR
      (sourceNativeFrequencyPolarization left epsilon s n) (sourceNativeFrequencyPolarization right epsilon t m)=
      ∑i : Fin 3,∑j : Fin 3,sourceGaussPolarizationPair q sL eL sR eR
        (sourceFinitePoleComponents left epsilon s n i) (sourceFinitePoleComponents right epsilon t m j) := by
  rw [sourceFinitePoleComponents_sum left epsilon s n nonzero,
    sourceFinitePoleComponents_sum right epsilon t m nonzero]
  simp only [map_sum,LinearMap.sum_apply]
  rw [Finset.sum_comm]

/-- Both physical time derivatives use the same computed material insertion and zero-spectral generator. -/
def sourcePolarizationAxisTime (q : PhysicalResponsePoint) (p : PhysicalMomentum) (k : Fin 4) (t : ℝ) : H→L[ℂ]H :=
  CanonicalGradedVariation.variation (jointGenerator p q.F 0 0)
    (sourcePolarizationMaterialCurrent (sourceEnergyAxisField 1 k) p q.F) t

/-- The literal raw current and complete native/coframe/matter/Y variation enter each of the four surviving ordered time/Green terms. -/
def sourceGaussFirstAxisTime (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) (k l : Fin 4) (age : ℝ) : ℂ :=
  -sourceUnitRead q sL eL sR eR
    (sourcePolarizationAxisTime q (q.p+q.k) l (-age)*jointResolvent (q.p+q.k) q.F q.z 0*
      sourcePolarizationAxisReader q.p q.F k*jointResolvent q.p q.F q.w 0*physicalTime q.p q.F age 0)-
  sourceUnitRead q sL eL sR eR
    (physicalTime (q.p+q.k) q.F (-age) 0*
