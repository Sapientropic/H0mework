/-- The surviving amplitude is the actual coframe shear plus anisotropy, with its original action clock. -/
theorem sourceCoframePreparedCoefficient_value (z : SourceCoordinateSlice) (edge : Fin 2) :
    sourceCoframePreparedCoefficient z edge=
      ((ActionNormalization.phaseMomentum*lapse*z.1 5:ℝ):ℂ)*
        (-(z.1 1:ℂ)+(if edge=0 then -Complex.I else Complex.I)*((z.1 2-z.1 0:ℝ):ℂ)) := by
  fin_cases edge <;>
    norm_num [sourceCoframePreparedCoefficient,sourceCoframeFixedFactor,sourceCoframeModeWeight,
      Matrix.cons_val,Complex.ofReal_mul,Complex.ofReal_sub]
  all_goals ring

/-- Vanishing is generated by the two actual coframe coordinates; it is not imposed on the whole response. -/
theorem sourceCoframePreparedCoefficient_zero (z : physicalChart) (edge : Fin 2) :
    sourceCoframePreparedCoefficient z.val edge=0 ↔ z.val.1 1=0 ∧ z.val.1 2=z.val.1 0 := by
  rw [sourceCoframePreparedCoefficient_value]
  have nonzero : ((ActionNormalization.phaseMomentum*lapse*z.val.1 5:ℝ):ℂ)≠0:=
    Complex.ofReal_ne_zero.mpr (mul_ne_zero (mul_ne_zero ActionNormalization.phaseMomentum_positive.ne'
      lapse_pos.ne') z.property.2.2.1.ne')
  rw [mul_eq_zero,or_iff_right nonzero]
  fin_cases edge <;> simp [Complex.ext_iff,eq_comm]
  all_goals intro _
  all_goals constructor <;> intro h <;> linarith

/-- The four actual source fibres have the original Gauss preparation normalization. -/
theorem sourceCoframePreparedFiber_gram (side edge other opposite : Fin 2) :
    inner ℂ (sourceChargedFiber side edge) (sourceChargedFiber other opposite)=
      if side=other ∧ edge=opposite then 1 else 0 := by
  have base : inner ℂ (sourcePoleBase 1 (by norm_num)) (sourcePoleBase 1 (by norm_num))=1 := by
    rw [inner_self_eq_norm_sq_to_K,sourcePoleBase_unit]
    norm_num
  have gram:=sourceChargedGauss_gram 1 (by norm_num) side edge other opposite
  rw [←GaussHalfDensity.fockHalfDensityEquiv.inner_map_map,PiLp.inner_apply] at gram
  simp only [sourceChargedGaussPrepared_coordinates,inner_smul_left,inner_smul_right,base,mul_one] at gram
  change inner ℂ (sourceChargedFiber side edge) (sourceChargedFiber other opposite)=_ at gram
  rw [gram]
  fin_cases side <;> fin_cases edge <;> fin_cases other <;> fin_cases opposite <;>
    norm_num [sourceChargedRestIndex,Fin.ext_iff]

/-- This is the literal four-column source projector before finite compression or either Green inverse. -/
def sourceCoframePreparedProjector : FockFiber→L[ℂ] FockFiber :=
  ∑side : Fin 2,∑edge : Fin 2,InnerProductSpace.rankOne ℂ
    (sourceChargedFiber side edge) (sourceChargedFiber side edge)

theorem sourceCoframePreparedProjector_actual (side edge : Fin 2) :
    sourceCoframePreparedProjector (sourceChargedFiber side edge)=sourceChargedFiber side edge := by
  simp only [sourceCoframePreparedProjector,sum_apply,InnerProductSpace.rankOne_apply,sourceCoframePreparedFiber_gram]
  simp
  fin_cases side <;> fin_cases edge <;> norm_num [Fin.ext_iff]

/-- The computed four-input action keeps the two true coframe shear/anisotropy coefficients. -/
def sourceCoframePreparedOutput (z : SourceCoordinateSlice) (v : FockFiber) : FockFiber :=
  ∑side : Fin 2,∑edge : Fin 2,(inner ℂ (sourceChargedFiber side edge) v) •
    (sourceCoframePreparedCoefficient z edge • sourceChargedFiber side (sourceCoframeOtherEdge edge))

/-- This is the original full-CAR action on the actual unselected input, not an independent remainder. -/
def sourceCoframeComplementOutput (z : SourceCoordinateSlice) (v : FockFiber) : FockFiber :=
  sourceCoframeModeFiber z (v-sourceCoframePreparedProjector v)

theorem sourceCoframeFiber_complete (z : SourceCoordinateSlice) (v : FockFiber) :
    sourceCoframeModeFiber z v=sourceCoframePreparedOutput z v+sourceCoframeComplementOutput z v := by
  have partition : v=sourceCoframePreparedProjector v+(v-sourceCoframePreparedProjector v):=by abel
  conv_lhs=>rw [partition,map_add]
  unfold sourceCoframeComplementOutput sourceCoframePreparedOutput sourceCoframePreparedProjector
  simp only [sum_apply,InnerProductSpace.rankOne_apply,map_sum,map_smul,sourceCoframeFiber_prepared]

/-- Both computed and complementary inputs stay inside the actual whole configuration integral. -/
def sourceCoframePreparedForm (a b : QuantumTest) : ℂ :=
  ∫z,pairSample z (a z) (sourceCoframePreparedOutput z (b z)+sourceCoframeComplementOutput z (b z))
    ∂GaussHistoryHilbert.configurationMeasure

theorem sourceCoframeModeForm_prepared (a b : QuantumTest) :
    sourceCoframeModeForm a b=sourceCoframePreparedForm a b := by
  unfold sourceCoframeModeForm sourceCoframePreparedForm
  apply integral_congr_ae
  filter_upwards with z
  rw [sourceCoframeFiber_complete]

def sourceCoframePreparedReader (F : GaussUnitaryHistory.Index) : SourceOp :=
  finiteRiesz F (fun i j=>sourceCoframePreparedForm (frameTest F i) (frameTest F j))

theorem sourceCoframeModeReader_prepared (F : GaussUnitaryHistory.Index) :
    sourceCoframeModeReader F=sourceCoframePreparedReader F := by
  unfold sourceCoframeModeReader sourceCoframePreparedReader
  simp only [sourceCoframeModeForm_prepared]

/-- Finite compression, two original independent Green inverses and both original spectral projections retain the complete computed form. -/
def sourceCoframePreparedStatic (q : PhysicalResponsePoint) (n : PhysicalMomentum) : SourceOp :=
  sourceResonanceProjection q.F n 0*sourceEqualProjection q.F
    (sourceProjection*(jointResolvent 0 q.F q.z 0*
      ((-(gaugeScale/2:ℝ):ℂ) • sourceCoframePreparedReader q.F)*jointResolvent 0 q.F q.w 0)*sourceProjection)

theorem sourceCoframeOriginStatic_prepared (q : PhysicalResponsePoint) (n : PhysicalMomentum) :
    sourceCoframeOriginStatic q n=sourceCoframePreparedStatic q n := by
  unfold sourceCoframeOriginStatic sourceCoframePreparedStatic
  rw [sourceCoframeModeReader_prepared]

theorem sourceNativeSimple_prepared (q : PhysicalResponsePoint) (n : PhysicalMomentum)
    (l r : RestStateIndex) (left : q.z.im≠0) (right : q.w.im≠0) :
    sourceNativeSimple q n l r=sourceOriginPair
      (sourcePoleRead q.epsilon q.precision 0 0 l r (sourceCoframePreparedStatic q n)) := by
  rw [sourceNativeSimple_polynomial q n l r left right,sourceCoframeOriginStatic_prepared]

/-- Original three-channel Fourier read, retaining the computed preparation and its source complement together. -/
def sourceCoframePreparedSimpleChannel (q : PhysicalResponsePoint) (c eta : ℝ)
    (l r : RestStateIndex) (i : Fin 3) (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) : ℂ :=
  ∫n : PhysicalMomentum,sourceSpatialPhase n x*test n*
    ((sourcePoleSide c eta)⁻¹*(sourceChargedDenominator (sourceSpatialMomentum n) 0 i)⁻¹*
      sourceSlowRead (sourceOriginPair (sourcePoleRead q.epsilon q.precision 0 0 l r
        (sourceCoframePreparedStatic q (sourceSpatialMomentum n)))) ⟨i.val,by omega⟩)

def sourceCoframePreparedSimpleField (q : PhysicalResponsePoint) (c eta : ℝ)
    (l r : RestStateIndex) (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) : Fin 289→ℂ :=
  ∑i : Fin 3,sourceCoframePreparedSimpleChannel q c eta l r i test x • sourceCommonOriginColumn i

def sourceActualCoframePreparedSimple (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (c eta : ℝ) (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) : Fin 289→ℂ :=
  ∑l : RestStateIndex,∑r : RestStateIndex,sourceActualPreparedWeight 0 0 sL eL sR eR l r •
    sourceCoframePreparedSimpleField q c eta l r test x

theorem sourceActualCoframeOriginSimple_prepared (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (c eta : ℝ) (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) :
    sourceActualCoframeOriginSimple q sL eL sR eR c eta test x=
      sourceActualCoframePreparedSimple q sL eL sR eR c eta test x := by
  simp only [sourceActualCoframeOriginSimple,sourceActualCoframePreparedSimple,
    sourceCoframeOriginSimpleField,sourceCoframePreparedSimpleField,
    sourceCoframeOriginSimpleChannel,sourceCoframePreparedSimpleChannel,sourceCoframeOriginStatic_prepared]

theorem sourceActualRadialPotential_prepared (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (branch : Fin 2) (negative : Bool) (eta : ℝ) (causal : 0<eta)
    (left : q.z.im≠0) (right : q.w.im≠0) (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) :
    Tendsto (fun d : ℝ=>(d:ℂ) • sourceActualRadialPotential q sL eL sR eR branch negative eta d test x)
      (𝓝[>] 0) (𝓝 (sourceActualCoframePreparedSimple q sL eL sR eR (sourceSignedSpeed branch negative) eta test x)) := by
  rw [←sourceActualCoframeOriginSimple_prepared]
  exact sourceActualRadialPotential_polynomial q sL eL sR eR branch negative eta causal left right test x

theorem sourceActualUnitRadialPotential_prepared (qd q : PhysicalResponsePoint)
    (dSL dEL dSR dER sL eL sR eR : Fin 2) (T : ℝ) (branch : Fin 2) (negative : Bool)
    (eta : ℝ) (causal : 0<eta) (sourceLeft : q.z.im≠0) (sourceRight : q.w.im≠0)
    (left : qd.z.im≠0) (right : qd.w.im≠0) (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) :
    Tendsto (fun d : ℝ=>(d:ℂ)*sourceActualUnitFieldRead qd dSL dEL dSR dER 0 T
      (sourceActualRadialPotential q sL eL sR eR branch negative eta d test x))
      (𝓝[>] 0) (𝓝 (sourceActualUnitFieldRead qd dSL dEL dSR dER 0 T
        (sourceActualCoframePreparedSimple q sL eL sR eR (sourceSignedSpeed branch negative) eta test x))) := by
  rw [←sourceActualCoframeOriginSimple_prepared]
  exact sourceActualUnitRadialPotential_polynomial qd q dSL dEL dSR dER sL eL sR eR T branch negative eta
    causal sourceLeft sourceRight left right test x

theorem sourceGaugeRadialCoupling_prepared (qd q : PhysicalResponsePoint)
    (dSL dEL dSR dER sL eL sR eR : Fin 2) (T : ℝ) (branch : Fin 2) (negative : Bool)
    (eta : ℝ) (causal : 0<eta) (sourceLeft : q.z.im≠0) (sourceRight : q.w.im≠0)
    (left : qd.z.im≠0) (right : qd.w.im≠0) (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) :
    Tendsto (fun d : ℝ=>(d:ℂ)*sourceGaugeCouplingRead branch qd dSL dEL dSR dER 0 T
      (sourceActualRadialPotential q sL eL sR eR branch negative eta d test x))
      (𝓝[>] 0) (𝓝 (sourceGaugeCouplingRead branch qd dSL dEL dSR dER 0 T
        (sourceActualCoframePreparedSimple q sL eL sR eR (sourceSignedSpeed branch negative) eta test x))) := by
  rw [←sourceActualCoframeOriginSimple_prepared]
  exact sourceGaugeRadialCoupling_polynomial qd q dSL dEL dSR dER sL eL sR eR T branch negative eta
    causal sourceLeft sourceRight left right test x

