open scoped BigOperators Matrix
local instance : DecidableEq Quantum.Index := Classical.decEq _

/-- Fundamental electromagnetic Lie weights: the coefficient of `Complex.I` in
each diagonal entry of the actual embedded mother `p286LieBlockEmbed emDirection`. -/
def emDressedFundamentalWeight : SU7MotherIndex → ℚ
  | Sum.inl c => if c = 0 then -(1/2) else if c = 1 then 1/2 else 0
  | Sum.inr (Sum.inl _) => 0
  | Sum.inr (Sum.inr (Sum.inl _)) => -(1/2)
  | Sum.inr (Sum.inr (Sum.inr _)) => 1/2

/-- The joint exterior weight generated by the actual electromagnetic direction. -/
def emDressedExteriorWeight {degree : ℕ} (index : ExteriorBasisIndex degree) : ℚ :=
  ∑ position ∈ index.1, emDressedFundamentalWeight position

/-- The source colour leg carries Cartan weight `i/2`; the hypercharge leg
carries its source weight; their difference is the actual EM action. -/
private theorem em_embed_split :
    p286LieBlockEmbed emDirection =
      -(p286LieBlockEmbed (sourceColorP286Generator 2)) -
        (1/2 : ℝ) • p286LieBlockEmbed HyperchargeResponse.chargeDirection := by
  rw [emDirection, p286LieBlockEmbed_sub, p286LieBlockEmbed_neg,
    p286LieBlockEmbed_real_smul]

private theorem emDressed_fundamental (index : SU7MotherIndex) :
    fundamentalMotherLieAction (p286LieBlockEmbed emDirection)
      (su7FundamentalBasis index) =
      ((emDressedFundamentalWeight index : ℂ) * Complex.I) •
        su7FundamentalBasis index := by
  rw [em_embed_split]
  conv_lhs => rw [show (-p286LieBlockEmbed (sourceColorP286Generator 2) -
        (1/2 : ℝ) • p286LieBlockEmbed HyperchargeResponse.chargeDirection) =
      (-1 : ℝ) • p286LieBlockEmbed (sourceColorP286Generator 2) +
        (-(1/2) : ℝ) • p286LieBlockEmbed HyperchargeResponse.chargeDirection
      from by module]
  rw [fundamentalMotherLieAction_add, fundamentalMotherLieAction_real_smul,
    fundamentalMotherLieAction_real_smul]
  simp only [LinearMap.add_apply, LinearMap.smul_apply]
  rw [sourceColorWeight_action, HyperchargeResponse.fundamental_charge_basis]
  simp only [smul_smul]
  rw [← add_smul]
  congr 1
  fin_cases index <;>
    simp [emDressedFundamentalWeight, sourceColorWeight,
      fundamentalHyperchargeWeight]

/-- The actual embedded electromagnetic matrix is the diagonal `i*weight`
matrix; this is a source identity, not a premise. -/
private theorem emDressed_embed_diagonal :
    (p286LieBlockEmbed emDirection :
      Matrix SU7MotherIndex SU7MotherIndex ℂ) =
      Matrix.diagonal fun i => (emDressedFundamentalWeight i : ℂ) * Complex.I := by
  ext i j
  have eigen := congrFun (emDressed_fundamental j) i
  simp only [fundamentalMotherLieAction, Matrix.mulVecLin_apply, Matrix.mulVec,
    dotProduct, su7FundamentalBasis, Pi.basisFun_apply, Pi.single_apply, mul_ite,
    mul_one, mul_zero, Pi.smul_apply, smul_eq_mul, Finset.sum_ite_eq',
    Finset.mem_univ, if_true, Matrix.diagonal_apply] at eigen ⊢
  rw [eigen]
  split_ifs <;> simp_all

/-- The actual exterior action of the original EM direction is diagonal with
the joint exterior weight. -/
theorem emDressed_exterior (degree : ℕ) (index : ExteriorBasisIndex degree) :
    exteriorMotherLieAction degree (p286LieBlockEmbed emDirection)
      (su7ExteriorBasis degree index) =
      ((emDressedExteriorWeight index : ℂ) * Complex.I) •
        su7ExteriorBasis degree index := by
  classical
  rw [exteriorMotherLieAction_basis]
  have term (position : Fin degree) :
      (exteriorPower.ιMulti ℂ degree)
        (exteriorBasisLieActionInput degree (p286LieBlockEmbed emDirection)
          index position) =
      ((emDressedFundamentalWeight (exteriorPositionEquiv index position).1 : ℂ) *
        Complex.I) • su7ExteriorBasis degree index := by
    rw [exteriorBasisLieActionTerm_eq_update]
    have eigen := emDressed_fundamental
      (exteriorPositionEquiv index position).1
    change fundamentalMotherLieAction (p286LieBlockEmbed emDirection)
      (exteriorBasisInput degree index position) = _ at eigen
    change fundamentalMotherLieAction (p286LieBlockEmbed emDirection)
      (exteriorBasisInput degree index position) =
      ((emDressedFundamentalWeight (exteriorPositionEquiv index position).1 : ℂ) *
        Complex.I) • exteriorBasisInput degree index position at eigen
    rw [eigen, (exteriorPower.ιMulti ℂ degree).map_update_smul,
      Function.update_eq_self, exteriorBasisInput_wedge_eq_basis]
  change (∑ position : Fin degree, (exteriorPower.ιMulti ℂ degree)
      (exteriorBasisLieActionInput degree (p286LieBlockEmbed emDirection)
        index position)) = _
  simp_rw [term]
  rw [← Finset.sum_smul, ← Finset.sum_mul, ← Rat.cast_sum]
  congr 3
  exact ((exteriorPositionEquiv index).sum_comp
      (fun j => emDressedFundamentalWeight j)).trans
    (Finset.sum_subtype index.1 (by simp) emDressedFundamentalWeight).symm

def emDressedInternalWeight : Quantum.InternalIndex → ℚ
  | Sum.inl i => emDressedExteriorWeight i
  | Sum.inr (Sum.inl i) => emDressedExteriorWeight i
  | Sum.inr (Sum.inr i) => emDressedExteriorWeight i

def emDressedWholeWeight (i : Quantum.Index) : ℚ := emDressedInternalWeight i.2

/-- The actual EM action is diagonal on the whole exterior basis. -/
theorem emDressed_basis (i : Quantum.Index) :
    emGaugeAction (Quantum.wholeBasis i) =
      ((emDressedWholeWeight i : ℂ) * Complex.I) • Quantum.wholeBasis i := by
  rcases i with ⟨spin, i | i | i⟩
  all_goals
    funext s
    simp only [emGaugeAction, diracExteriorMotherLieAction,
      internalMatterLinearAction, Quantum.wholeBasis, Pi.basis_apply, Pi.smul_apply]
    by_cases h : s = spin
    · subst s
      simp [Quantum.internalBasis, Module.Basis.prod_apply,
        exteriorSpinorMotherLieAction, emDressed_exterior, emDressedWholeWeight,
        emDressedInternalWeight]
    · simp [h, exteriorSpinorMotherLieAction]

/-- The actual 252-mode matrix of the original EM generator is diagonal. -/
theorem emDressed_matrix :
    Quantum.operatorMatrix emGaugeAction =
      Matrix.diagonal (fun i => (emDressedWholeWeight i : ℂ) * Complex.I) := by
  ext i j
  rw [Quantum.operatorMatrix, LinearMap.toMatrixAlgEquiv_apply, emDressed_basis,
    map_smul, Module.Basis.repr_self]
  simp [Matrix.diagonal_apply, Finsupp.single_apply]
  split_ifs <;> simp_all

/-- The scalar contraction carries the generated exterior EM weight. -/
theorem em_dressed_scalar (channel : Fin 2) (color : Fin 3) (phi : Scalar) :
    scalarCoefficient channel color
      (scalarMotherLieAction (p286LieBlockEmbed emDirection) phi) =
      ((emDressedExteriorWeight
        (Composite.scalarBasis channel color) : ℂ) * Complex.I) *
        scalarCoefficient channel color phi := by
  have diagonal : (su7ExteriorBasis 4).coord (Composite.scalarBasis channel color)
      (exteriorMotherLieAction 4 (p286LieBlockEmbed emDirection)
        (scalarCoordinateEquiv.symm phi)) =
      ((emDressedExteriorWeight (Composite.scalarBasis channel color) : ℂ) *
        Complex.I) * (su7ExteriorBasis 4).coord (Composite.scalarBasis channel color)
          (scalarCoordinateEquiv.symm phi) := by
    rw [← (su7ExteriorBasis 4).sum_repr (scalarCoordinateEquiv.symm phi)]
    simp only [map_sum, map_smul, emDressed_exterior, Module.Basis.coord_apply,
      Module.Basis.repr_self, Finsupp.single_apply, smul_eq_mul, mul_ite, mul_one,
      mul_zero, Finset.sum_ite_eq', Finset.mem_univ, if_true]
    ring
  change (if color = 1 then (-1 : ℂ) else 1) •
    (su7ExteriorBasis 4).coord (Composite.scalarBasis channel color)
      (scalarCoordinateEquiv.symm
        (scalarMotherLieAction (p286LieBlockEmbed emDirection) phi)) = _
  rw [scalarMotherLieAction, LinearEquiv.symm_apply_apply, diagonal]
  simp only [scalarCoefficient, LinearMap.smul_apply, LinearMap.comp_apply,
    smul_eq_mul]
  change (if color = 1 then (-1 : ℂ) else 1) *
      (((emDressedExteriorWeight (Composite.scalarBasis channel color) : ℂ) *
        Complex.I) * (su7ExteriorBasis 4).coord (Composite.scalarBasis channel color)
          (scalarCoordinateEquiv.symm phi)) =
    ((emDressedExteriorWeight (Composite.scalarBasis channel color) : ℂ) *
      Complex.I) * ((if color = 1 then (-1 : ℂ) else 1) *
        (su7ExteriorBasis 4).coord (Composite.scalarBasis channel color)
          (scalarCoordinateEquiv.symm phi))
  ring

/-- Each charged matter component of the actual EM action carries the
generated two-index weight. -/
theorem em_dressed_matter (spin : Fin 2) (color : Fin 3)
    (psi : DiracExteriorMatterCarrier) :
    Quantum.coordinates (emGaugeAction psi)
      ⟨spin.castLE (by decide),
        Sum.inr (Sum.inl (Composite.matterBasis color))⟩ =
      ((emDressedExteriorWeight (Composite.matterBasis color) : ℂ) *
        Complex.I) * Quantum.coordinates psi
        ⟨spin.castLE (by decide),
          Sum.inr (Sum.inl (Composite.matterBasis color))⟩ := by
  rw [← Quantum.matrix_action, emDressed_matrix, Matrix.mulVec_diagonal]
  rfl

theorem em_dressed_scalar_weight (channel : Fin 2) (color : Fin 3) :
    emDressedExteriorWeight (Composite.scalarBasis channel color) =
      (if color = 0 then 1/2 else if color = 1 then -(1/2) else 0 : ℚ) := by
  exact (show ∀ a : Fin 2, ∀ c : Fin 3,
      emDressedExteriorWeight (Composite.scalarBasis a c) =
        (if c = 0 then 1/2 else if c = 1 then -(1/2) else 0 : ℚ)
    from by decide +kernel) channel color

theorem em_dressed_matter_weight (color : Fin 3) :
    emDressedExteriorWeight (Composite.matterBasis color) =
      (if color = 0 then -1 else if color = 1 then 0 else -(1/2) : ℚ) := by
  exact (show ∀ c : Fin 3,
      emDressedExteriorWeight (Composite.matterBasis c) =
        (if c = 0 then -1 else if c = 1 then 0 else -(1/2) : ℚ)
    from by decide +kernel) color

/-- The scalar and matter EM weights of every pair sum to `-1/2`. -/
theorem em_dressed_total_weight (channel : Fin 2) (color : Fin 3) :
    emDressedExteriorWeight (Composite.scalarBasis channel color) +
      emDressedExteriorWeight (Composite.matterBasis color) = -(1/2) := by
  exact (show ∀ channel : Fin 2, ∀ color : Fin 3,
      emDressedExteriorWeight (Composite.scalarBasis channel color) +
        emDressedExteriorWeight (Composite.matterBasis color) = -(1/2)
    from by decide +kernel) channel color

/-- The positive joint charge unit is generated by the actual exterior
weights; it is not an independent literal. -/
def emDressedChargeUnit : ℚ :=
  -(emDressedExteriorWeight (Composite.scalarBasis 0 0) +
    emDressedExteriorWeight (Composite.matterBasis 0))

theorem emDressedChargeUnit_value : emDressedChargeUnit = 1/2 := by
  decide +kernel

theorem emDressedChargeUnit_pos : 0 < emDressedChargeUnit := by
  rw [emDressedChargeUnit_value]
  norm_num

theorem emDressedChargeUnit_ne_zero : emDressedChargeUnit ≠ 0 :=
  ne_of_gt emDressedChargeUnit_pos

/-- The joint EM character: `+i/2` on the creation letter, `-i/2` on the
annihilation letter. -/
def emDressedCharacter (addition : Bool) : ℂ :=
  if addition then Complex.I * (emDressedChargeUnit : ℂ)
  else -(Complex.I * (emDressedChargeUnit : ℂ))

/-- The original dressed read transforms by `-i/2` under the actual EM action,
with the scalar leg varied by `scalarMotherLieAction` and the matter leg by
`emGaugeAction`. -/
theorem em_dressed_read (channel spin : Fin 2) (phi : Scalar)
    (psi : DiracExteriorMatterCarrier) :
    originalRead channel spin
      (scalarMotherLieAction (p286LieBlockEmbed emDirection) phi) psi +
      originalRead channel spin phi (emGaugeAction psi) =
      (-(emDressedChargeUnit : ℂ) * Complex.I) *
        originalRead channel spin phi psi := by
  have unit : (emDressedChargeUnit : ℂ) = 1/2 := by
    have cast := congrArg (fun q : ℚ => (q : ℂ)) emDressedChargeUnit_value
    norm_num only [Rat.cast_div, Rat.cast_ofNat, Rat.cast_one] at cast
    exact cast
  rw [unit]
  simp only [originalRead, ← original_mode_read, em_dressed_scalar,
    em_dressed_matter, ← Finset.sum_add_distrib, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro c _
  have weight : (emDressedExteriorWeight (Composite.scalarBasis channel c) : ℂ) +
      (emDressedExteriorWeight (Composite.matterBasis c) : ℂ) = (-(1/2) : ℂ) := by
    have cast := congrArg (fun q : ℚ => (q : ℂ))
      (em_dressed_total_weight channel c)
    norm_num only [Rat.cast_add, Rat.cast_neg, Rat.cast_div, Rat.cast_ofNat,
      Rat.cast_one] at cast
    exact cast
  linear_combination (Complex.I * scalarCoefficient channel c phi *
    Quantum.coordinates psi ⟨spin.castLE (by decide),
      Sum.inr (Sum.inl (Composite.matterBasis c))⟩) * weight

/-- The independent dual read transforms by `+i/2`; the primal adjoint is not
used as the dual. -/
theorem em_dressed_dual (channel spin : Fin 2) (phi : Scalar)
    (dual : Module.Dual ℂ DiracExteriorMatterCarrier) :
    sourceDressedDualRead channel spin
      (scalarMotherLieAction (p286LieBlockEmbed emDirection) phi) dual +
      sourceDressedDualRead channel spin phi (-dual.comp emGaugeAction) =
      ((emDressedChargeUnit : ℂ) * Complex.I) *
        sourceDressedDualRead channel spin phi dual := by
  have unit : (emDressedChargeUnit : ℂ) = 1/2 := by
    have cast := congrArg (fun q : ℚ => (q : ℂ)) emDressedChargeUnit_value
    norm_num only [Rat.cast_div, Rat.cast_ofNat, Rat.cast_one] at cast
    exact cast
  rw [unit]
  simp only [sourceDressedDualRead, em_dressed_scalar, LinearMap.neg_apply,
    LinearMap.comp_apply, emDressed_basis, emDressedWholeWeight,
    emDressedInternalWeight, map_smul, ← Finset.sum_add_distrib, Finset.mul_sum,
    map_mul, Complex.star_def, Complex.conj_I, map_ratCast, smul_eq_mul]
  apply Finset.sum_congr rfl
  intro c _
  have weight : (emDressedExteriorWeight (Composite.scalarBasis channel c) : ℂ) +
      (emDressedExteriorWeight (Composite.matterBasis c) : ℂ) = (-(1/2) : ℂ) := by
    have cast := congrArg (fun q : ℚ => (q : ℂ))
      (em_dressed_total_weight channel c)
    norm_num only [Rat.cast_add, Rat.cast_neg, Rat.cast_div, Rat.cast_ofNat,
      Rat.cast_one] at cast
    exact cast
  simp only [starRingEnd_apply]
  linear_combination (-Complex.I * star (scalarCoefficient channel c phi) *
    dual (Quantum.wholeBasis ⟨spin.castLE (by decide),
      Sum.inr (Sum.inl (Composite.matterBasis c))⟩)) * weight

end LowEnergy.GaussComposite.PhysicalEMDressedCharacter
