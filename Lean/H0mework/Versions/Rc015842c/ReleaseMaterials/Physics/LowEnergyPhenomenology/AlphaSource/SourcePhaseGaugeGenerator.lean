open Lean Elab Term in
elab "paidPhaseGaugeEmbedding%" : term => do
  let wanted := `LowEnergy.PreparationVacuumPhysicalQuantumLockedCharge.source_embedding_charge
  let names := (← getEnv).constants.toList.filterMap fun (name,_) =>
    if name.toString.startsWith "_private.H0mework.Versions.Rc015842c.ReleaseMaterials.Physics.LowEnergyPhenomenology.AlphaSource.CanonicalPreparationSourceQuantumLockedPoleCharge." && privateToUserName name == wanted then some name else none
  match names with
  | [name] =>
    logInfo m!"Original private payer: {name}"
    return mkConst name
  | _ =>
    let related := (← getEnv).constants.toList.filterMap fun (name,_) =>
      if privateToUserName name == wanted then some name else none
    throwError "Expected unique selected canonical SourceQuantumLockedPoleCharge payer; actual candidates {related}"

private abbrev sourceEmbeddingHypercharge := paidPhaseGaugeEmbedding%

def sourcePhaseGaugeLie : SourceQuantumScalarChart.NativeLie :=
  -SourceQuantumResidualGaugeSlice.colorGenerator 2-(1/2:ℝ) • nativeY

def sourceHyperchargeMother : YangMills.FullPairing.Mother :=
  diracExteriorMotherLieAction (p286LieBlockEmbed HyperchargeResponse.chargeDirection)

/-- Literal coefficients of the original X fix the candidate original gauge generator. -/
def sourcePhaseGaugeGenerator : YangMills.FullPairing.Mother :=
  -(diracExteriorMotherLieAction (p286LieBlockEmbed (sourceColorP286Generator 2)))-
    (1/2:ℂ) • sourceHyperchargeMother

/-- Full252 difference is retained before any actual preparation restriction. -/
def sourcePhaseGaugeDifference : YangMills.FullPairing.Mother :=
  (1/2:ℂ) • (sourceHyperchargeMother-Complex.I • (1:YangMills.FullPairing.Mother))

theorem sourcePhaseGaugeGenerator_full :
    sourceNativeOriginGenerator=sourcePhaseGaugeGenerator+sourcePhaseGaugeDifference := by
  unfold sourceNativeOriginGenerator sourcePhaseGaugeGenerator sourcePhaseGaugeDifference
  change -diracExteriorMotherLieAction (p286LieBlockEmbed (sourceColorP286Generator 2))-
    (Complex.I/2) • (1:YangMills.FullPairing.Mother)=_
  module

theorem sourcePhaseGaugeGenerator_embed (values : Source.Index→ℂ) :
    sourcePhaseGaugeGenerator (embed values)=sourceNativeOriginGenerator (embed values) := by
  simp only [sourcePhaseGaugeGenerator,sourceNativeOriginGenerator,LinearMap.sub_apply,
    LinearMap.neg_apply,LinearMap.smul_apply,LinearMap.id_apply,sourceHyperchargeMother,
    sourceEmbeddingHypercharge,smul_smul]
  module

theorem sourcePhaseGaugeDifference_embed (values : Source.Index→ℂ) :
    sourcePhaseGaugeDifference (embed values)=0 := by
  have h:=congrArg (fun A : YangMills.FullPairing.Mother=>A (embed values)) sourcePhaseGaugeGenerator_full
  simp only [LinearMap.add_apply,sourcePhaseGaugeGenerator_embed] at h
  exact (add_eq_left.mp h.symm)

private theorem operatorMatrix_sub (A B : YangMills.FullPairing.Mother) :
    Quantum.operatorMatrix (A-B)=Quantum.operatorMatrix A-Quantum.operatorMatrix B := by
  ext i j
  simp only [Quantum.operatorMatrix,LinearMap.toMatrixAlgEquiv_apply,LinearMap.sub_apply,
    map_sub,Finsupp.sub_apply,Matrix.sub_apply]

private theorem operatorMatrix_neg (A : YangMills.FullPairing.Mother) :
    Quantum.operatorMatrix (-A)= -Quantum.operatorMatrix A := by
  ext i j
  simp only [Quantum.operatorMatrix,LinearMap.toMatrixAlgEquiv_apply,LinearMap.neg_apply,
    map_neg,Finsupp.neg_apply,Matrix.neg_apply]

/-- This is a genuine original Lie representation, not an identity operator added to the gauge algebra. -/
theorem sourcePhaseGaugeGenerator_native :
    Quantum.operatorMatrix sourcePhaseGaugeGenerator=GaussNativeMatter.nativePrimal sourcePhaseGaugeLie := by
  have color : GaussNativeMatter.nativePrimal (SourceQuantumResidualGaugeSlice.colorGenerator 2)=
      Quantum.operatorMatrix (diracExteriorMotherLieAction (p286LieBlockEmbed (sourceColorP286Generator 2))) := by
    change Quantum.operatorMatrix (diracExteriorMotherLieAction
      (p286LieBlockEmbed (p286CoordinateEquiv.symm (p286CoordinateEquiv (sourceColorP286Generator 2)))))=_
    rw [LinearEquiv.symm_apply_apply]
  have hyper : GaussNativeMatter.nativePrimal nativeY=Quantum.operatorMatrix sourceHyperchargeMother := by
    change Quantum.operatorMatrix (diracExteriorMotherLieAction
      (p286LieBlockEmbed (p286CoordinateEquiv.symm nativeY)))=_
    rw [nativeY,p286CoordinateEquiv.symm_apply_apply]
    rfl
  simp only [sourcePhaseGaugeGenerator,sourcePhaseGaugeLie,map_sub,map_neg,map_smul,color,hyper,operatorMatrix_sub,operatorMatrix_neg]
  ext i j
  simp only [Matrix.sub_apply,Matrix.neg_apply,Matrix.smul_apply,Complex.real_smul,smul_eq_mul]
  norm_num

private theorem hyper_doublet (state : Fin 2) :
    exteriorSpinorMotherLieAction (p286LieBlockEmbed HyperchargeResponse.chargeDirection)
      (sourceColorDoubletMatter state)=Complex.I • sourceColorDoubletMatter state := by
  have weight : exteriorHyperchargeWeight (sourceColorDoubletIndex state)=1 := by
    fin_cases state <;> decide
  simp [sourceColorDoubletMatter,exteriorSpinorMotherLieAction,HyperchargeResponse.exterior_charge_basis,weight]

private theorem pair_doublet (state : Fin 2) (v : SU7ExteriorSpinorMatterCarrier) :
    fullInternalPair (sourceColorDoubletMatter state) v=sourceColorDoubletDual state v := by
  have generated:=fullInternalPair_colorLinear (Pi.single state 1) v
  fin_cases state <;> simpa [Fin.sum_univ_two,Pi.single_apply] using generated

private theorem pair_I (u v : SU7ExteriorSpinorMatterCarrier) :
    fullInternalPair (Complex.I • u) v= -Complex.I*fullInternalPair u v := by
  simp [fullInternalPair,exteriorCoordinatePair,Finset.mul_sum,mul_add,mul_assoc]

private theorem dual_hypercharge (state : Fin 2) (v : SU7ExteriorSpinorMatterCarrier) :
    sourceColorDoubletDual state
      (exteriorSpinorMotherLieAction (p286LieBlockEmbed HyperchargeResponse.chargeDirection) v)=
        Complex.I*sourceColorDoubletDual state v := by
  have skew:=fullInternalPair_motherLie_skew (p286LieBlockEmbed HyperchargeResponse.chargeDirection)
    (sourceColorDoubletMatter state) v
  rw [hyper_doublet] at skew
  rw [pair_I,pair_doublet,pair_doublet] at skew
  linear_combination skew

/-- The independent source dual agrees on arbitrary input matter, not only diagonal pairings. -/
theorem sourcePhaseGaugeGenerator_dual (u v : ℂ) (matter : DiracExteriorMatterCarrier) :
    spinPairDual u v (sourcePhaseGaugeGenerator matter)=
      spinPairDual u v (sourceNativeOriginGenerator matter) := by
  have hyper : spinPairDual u v (sourceHyperchargeMother matter)=Complex.I*spinPairDual u v matter := by
    change (∑spin,∑color,spinPairCoefficients u v spin color*
      sourceColorDoubletDual color
        (exteriorSpinorMotherLieAction (p286LieBlockEmbed HyperchargeResponse.chargeDirection) (matter spin)))=
      Complex.I*(∑spin,∑color,spinPairCoefficients u v spin color*sourceColorDoubletDual color (matter spin))
    simp only [dual_hypercharge,Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro spin _
    apply Finset.sum_congr rfl
    intro color _
    ring
  simp only [sourcePhaseGaugeGenerator,sourceNativeOriginGenerator,LinearMap.sub_apply,
    LinearMap.neg_apply,LinearMap.smul_apply,LinearMap.id_apply,map_sub,map_neg,map_smul,smul_eq_mul,hyper]
  ring

theorem sourcePhaseGauge_actualMatter (point : BasePoint) :
    sourcePhaseGaugeGenerator (actual.matter point)=sourceNativeOriginGenerator (actual.matter point) := by
  have original:=sourcePhaseGaugeGenerator_embed
    (fun index : Source.Index=>spinPairCoefficients (upperPhase point) (lowerPhase point) index.1 index.2)
  rw [actual_matter]
  convert original using 1 <;> rfl

theorem sourcePhaseGauge_actualDual (point : BasePoint) :
    (actual.conjugateMatter point).comp sourcePhaseGaugeGenerator=
      (actual.conjugateMatter point).comp sourceNativeOriginGenerator := by
  apply LinearMap.ext
  intro matter
  rw [actual_conjugateMatter]
  exact sourcePhaseGaugeGenerator_dual _ _ matter

theorem sourcePhaseGauge_actualColumn (side edge : Fin 2) :
    sourcePhaseGaugeGenerator (sourceChargedRestriction side edge)=
      (-(sourceActualPhaseCharge edge:ℂ)*Complex.I) • sourceChargedRestriction side edge := by
  have equality : sourcePhaseGaugeGenerator (sourceChargedRestriction side edge)=
      sourceNativeOriginGenerator (sourceChargedRestriction side edge) := by
    rw [sourceChargedRestriction_basis]
    simp only [map_smul]
    rw [sourcePhaseGaugeGenerator_embed]
  rw [equality,sourceActualRestriction_generator]

def sourcePhaseGaugeCharge : YangMills.FullPairing.Mother := Complex.I • sourcePhaseGaugeGenerator

theorem sourcePhaseGaugeCharge_actualColumn (side edge : Fin 2) :
    sourcePhaseGaugeCharge (sourceChargedRestriction side edge)=
      (sourceActualPhaseCharge edge:ℂ) • sourceChargedRestriction side edge := by
  simp only [sourcePhaseGaugeCharge,LinearMap.smul_apply,sourcePhaseGauge_actualColumn,smul_smul]
  have coefficient : Complex.I*(-(sourceActualPhaseCharge edge:ℂ)*Complex.I)=(sourceActualPhaseCharge edge:ℂ) := by
    calc
      _= -(sourceActualPhaseCharge edge:ℂ)*(Complex.I*Complex.I) := by ring
      _=_ := by rw [Complex.I_mul_I];ring
  rw [coefficient]

