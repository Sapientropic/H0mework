import H0mework.Versions.Rc015842c.ReleaseMaterials.Physics.LowEnergyPhenomenology.AlphaSource.CanonicalPreparationSourceVoltageRampPencil

set_option autoImplicit false
set_option maxHeartbeats 1600000
set_option maxRecDepth 8192
set_option backward.isDefEq.respectTransparency false
noncomputable section
namespace LowEnergy.PreparationPhysicalVoltageCompleteReturn
open PreparationVacuumOriginalGreenFeedback PreparationVacuumCausalPoleResponse PreparationVacuumPhysicalFeedback
open scoped Matrix BigOperators
attribute [local irreducible] originalJacobi originalChange originalInverse originalReadback
  originalRowLift sourceGreen sourceCompatibility contactInverse activeKernel

private theorem null_square : nullProjection*nullProjection=nullProjection := by
  unfold nullProjection projectionMatrix
  rw [Matrix.diagonal_mul_diagonal]
  congr 1
  funext i
  split_ifs <;> norm_num

private theorem null_active : nullProjection*activeProjection=0 := by
  unfold nullProjection activeProjection projectionMatrix
  rw [Matrix.diagonal_mul_diagonal]
  ext i j
  by_cases same : i=j
  · subst j
    simp only [Matrix.diagonal_apply_eq,Matrix.zero_apply]
    unfold nullFlag activeFlag
    simp only [decide_eq_true_eq]
    split_ifs <;> norm_num; omega
  · simp [same]

private theorem null_contact (p : Fin 4→ℂ) : nullProjection*contactInverse p=0 := by
  have certificate : fastNormalizeTerms
      (productTerms (projectionTerms nullFlag) contactInverseTerms++negativeTerms [])=[]:=by decide +kernel
  have generated:=normalization_equal (productTerms (projectionTerms nullFlag) contactInverseTerms) [] certificate p
  simpa only [productTerms_value,projectionTerms_value,sourceMatrix_nil,nullProjection,contactInverse] using generated

private theorem null_read_kernel (p : Fin 4→ℂ) : nullProjection*originalReadback p*originalJacobi p=0 := by
  have generated:=congrArg Matrix.transpose (original_null_intertwiner (-p))
  rw [Matrix.transpose_mul,Matrix.transpose_mul,Matrix.transpose_zero,original_jacobi_reciprocity] at generated
  have symmetric : nullProjection.transpose=nullProjection:=by
    exact Matrix.diagonal_transpose _
  rw [symmetric] at generated
  simpa only [originalReadback,mul_assoc] using generated

private theorem null_green (p : regularSource) : nullProjection*originalInverse p.val*sourceGreen p=0 := by
  calc
    _=nullProjection*(originalInverse p.val*originalChange p.val)*
        (contactInverse p.val+activeProjection*(extendedKernel p.val)⁻¹)*originalReadback p.val:=by
      rw [sourceGreen]
      noncomm_ring
    _=0:=by
      rw [original_inverse_change,mul_one,mul_add,←mul_assoc,null_contact,null_active,zero_mul,add_zero,zero_mul]

private theorem restore_algebra {n : Type*} [Fintype n] [DecidableEq n]
    (K G S T L N P : Matrix n n ℂ)
    (KG : K*G=1-L*P*N) (KSP : K*S*P=0) (TS : T*S=1) (NL : N*L=1)
    (PNK : P*N*K=0) (PTG : P*T*G=0) (PP : P*P=P) : G*K=1-S*P*T := by
  let A:=K+L*P*T
  let B:=G+S*P*N
  have right : A*B=1 := by
    calc
      _=K*G+(K*S*P)*N+L*(P*T*G)+L*P*(T*S)*P*N:=by dsimp only [A,B];noncomm_ring
      _=1:=by rw [KG,KSP,PTG,TS,zero_mul,mul_zero,mul_one,mul_assoc L P P,PP];noncomm_ring
  have left : B*A=1:=mul_eq_one_comm.mp right
  have AS : A*S*P=L*P := by
    calc
      _=K*S*P+L*P*(T*S)*P:=by dsimp only [A];noncomm_ring
      _=L*P:=by rw [KSP,TS,mul_one,zero_add,mul_assoc L P P,PP]
  have BLP : B*L*P=S*P := by
    calc
      _=B*(A*S*P):=by rw [AS,mul_assoc]
      _=(B*A)*S*P:=by noncomm_ring
      _=S*P:=by rw [left,one_mul]
  have GLP : G*L*P=0 := by
    have expand : B*L*P=G*L*P+S*P := by
      calc
        _=G*L*P+S*P*(N*L)*P:=by dsimp only [B];noncomm_ring
        _=G*L*P+S*P:=by rw [NL,mul_one,mul_assoc S P P,PP]
    rw [expand] at BLP
    exact add_eq_right.mp BLP
  have expanded : B*A=G*K+S*P*T := by
    calc
      _=G*K+(G*L*P)*T+S*(P*N*K)+S*P*(N*L)*P*T:=by dsimp only [A,B];noncomm_ring
      _=G*K+S*P*T:=by rw [GLP,PNK,NL,zero_mul,mul_zero,mul_one,mul_assoc S P P,PP];noncomm_ring
  rw [expanded] at left
  exact eq_sub_of_add_eq left

/-- The complete original Green restores every field modulo exactly its original nine null coordinates. -/
theorem sourceGreen_original_left (p : regularSource) :
    sourceGreen p*originalJacobi p.val=1-originalChange p.val*nullProjection*originalInverse p.val := by
  have readback : originalReadback p.val*originalRowLift p.val=1:=
    mul_eq_one_comm.mp (original_row_readback p.val)
  exact restore_algebra (originalJacobi p.val) (sourceGreen p) (originalChange p.val)
    (originalInverse p.val) (originalRowLift p.val) (originalReadback p.val) nullProjection
    (original_green_equation p) (original_null_intertwiner p.val) (original_inverse_change p.val)
    readback (null_read_kernel p.val) (null_green p) null_square

/-- The full voltage forcing is compatible because it is generated by the same original Euler operator. -/
theorem sourceVoltageLaplaceForcing_compatible (spatial : Fin 3→ℂ) (z : ℂ) (nonzero : z≠0) :
    sourceCompatibility (fullMomentum spatial z) (sourceVoltageLaplaceForcing spatial z)=0 := by
  rw [←sourceVoltageLaplaceRamp_equation spatial z nonzero,sourceCompatibility,
    Matrix.mulVec_mulVec,Matrix.mulVec_mulVec,null_read_kernel,Matrix.zero_mulVec]

/-- No static inverse is taken: recovery is at an actual regular nonzero spectral point, with null data retained. -/
theorem sourceVoltageLaplaceRamp_recovered (spatial : Fin 3→ℂ) (z : ℂ) (nonzero : z≠0)
    (regular : fullMomentum spatial z∈regularSource) :
    sourceField ⟨fullMomentum spatial z,regular⟩ (sourceVoltageLaplaceForcing spatial z)=
      sourceVoltageLaplaceRamp spatial z-
        originalChange (fullMomentum spatial z)*ᵥ(nullProjection*ᵥ
          (originalInverse (fullMomentum spatial z)*ᵥsourceVoltageLaplaceRamp spatial z)) := by
  rw [sourceField,←sourceVoltageLaplaceRamp_equation spatial z nonzero,Matrix.mulVec_mulVec,
    sourceGreen_original_left,Matrix.sub_mulVec,Matrix.one_mulVec]
  simp only [←Matrix.mulVec_mulVec]

end LowEnergy.PreparationPhysicalVoltageCompleteReturn
