noncomputable section

abbrev BaseRoot
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :=
  runtimePrimeExponentPoleReceiptRelationRoot observation nontrivial

/-- Branch-neutral source disposition.  The fixed receipt root decides
whether its exact zero occurrence is already critical or exposes the full
off-center energy-support obstruction.  The branch is data generated by the
root, never a premise accepted by its projection payload. -/
inductive EnergySupportRootDisposition
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat,
      observation.coordinate = -2 * (n + 1)) : Type where
  | critical (coordinate_re_eq : observation.coordinate.re = 1 / 2)
  | offCenter
      (coordinate_re_ne : observation.coordinate.re ≠ 1 / 2)
      (residual : OffCenterEnergySupportObstruction observation nontrivial)

/-- The total branch is generated from the already fixed observation. -/
def generateEnergySupportRootDisposition
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat,
      observation.coordinate = -2 * (n + 1)) :
    EnergySupportRootDisposition observation nontrivial := by
  by_cases critical : observation.coordinate.re = 1 / 2
  · exact .critical critical
  · exact .offCenter critical
      (offCenterEnergySupportObstruction observation nontrivial critical)

/-- Complete source-installed energy disposition.  Its payload contains no
function from an ungrounded negative hypothesis. -/
def energySupportProjectionLaw
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    SourceNativeProjectionLaw
      (runtimePrimeExponentPoleReceiptRelationAuthoritySource observation
        nontrivial).restructuringSource.toLedgerSource where
  Projection := PUnit
  ActiveAt := fun _ {_current} _occurrence => PUnit
  InactiveAt := fun _ {_current} _occurrence => PEmpty
  classify := fun _ {_current} _occurrence => .inl PUnit.unit
  PayloadAt := fun _ {_current} _occurrence _active =>
    ULift (EnergySupportRootDisposition observation nontrivial)
  project := fun _ {_current} _occurrence _active =>
    ULift.up (generateEnergySupportRootDisposition observation nontrivial)

def authoritySource
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    SourceNativeAuthoritySource N V :=
  (runtimePrimeExponentPoleReceiptRelationAuthoritySource observation
    nontrivial).withProjectionCoface
      (energySupportProjectionLaw observation nontrivial)

def livingSource
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    SourceNativeLivingAuthoritySource N V where
  base := authoritySource observation nontrivial
  terminalHandoff := (authoritySource observation nontrivial
    ).emptyFaithfulTerminalHandoff
      (fun _ => ⟨fun terminal => nomatch terminal⟩)

def root
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    SourceNativeLivingRootClosure N V where
  source := livingSource observation nontrivial
  emitted := (BaseRoot observation nontrivial).emitted
  compiler_commutes := (BaseRoot observation nontrivial).compiler_commutes

def energySupportInstallation
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    SourceNativeProjectionLaw.InstallationAt
      (energySupportProjectionLaw observation nontrivial)
      (authoritySource observation nontrivial).projectionLaw :=
  SourceNativeProjectionLaw.InstallationAt.componentCoface
    (runtimePrimeExponentPoleReceiptRelationAuthoritySource observation
      nontrivial)
    (energySupportProjectionLaw observation nontrivial)

def inheritedInstallation
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    SourceNativeProjectionLaw.InstallationAt
      (runtimePrimeExponentPoleReceiptRelationAuthoritySource observation
        nontrivial).projectionLaw
      (authoritySource observation nontrivial).projectionLaw :=
  SourceNativeProjectionLaw.InstallationAt.inheritedCoface
    (runtimePrimeExponentPoleReceiptRelationAuthoritySource observation
      nontrivial)
    (energySupportProjectionLaw observation nontrivial)

def receiptRelationInstallation
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    SourceNativeProjectionLaw.InstallationAt
      (runtimePrimeExponentPoleReceiptRelationProjectionLaw observation
        nontrivial)
      (authoritySource observation nontrivial).projectionLaw :=
  (runtimePrimeExponentPoleReceiptRelationInstallation observation nontrivial
    ).trans (inheritedInstallation observation nontrivial)

def faithfulInstallation
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    SourceNativeProjectionLaw.InstallationAt
      (runtimeJointFaithfulMaterialLaw observation nontrivial).toProjectionLaw
      (authoritySource observation nontrivial).projectionLaw :=
  (runtimeJointFaithfulInstallationAtReceiptRelationRoot observation nontrivial
    ).trans (inheritedInstallation observation nontrivial)

def visit
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    SourceNativeTemporalVisitAt
      (root observation nontrivial).toAuthoritativeRoot.toLedgerRoot :=
  runtimePrimeExponentPoleReceiptRelationVisitAt observation nontrivial
    stageThreeRuntimeStage

def sourceEvent
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    ExactTemporalCausalRootEventAt
      (root observation nontrivial).toAuthoritativeRoot.toLedgerRoot
      (visit observation nontrivial) :=
  (root observation nontrivial).toAuthoritativeRoot.toLedgerRoot
    |>.exactTemporalCausalEventAt (visit observation nontrivial)

theorem root_reuses_receipt_source
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    (root observation nontrivial).toAuthoritativeRoot.toLedgerRoot =
        (BaseRoot observation nontrivial).toAuthoritativeRoot.toLedgerRoot ∧
      (root observation nontrivial).emitted =
        (BaseRoot observation nontrivial).emitted :=
  ⟨rfl, rfl⟩

/-- Exact total outcome read from the installed root face. -/
def installedEnergySupportDisposition
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat,
      observation.coordinate = -2 * (n + 1)) :
    EnergySupportRootDisposition observation nontrivial :=
  ((energySupportProjectionLaw observation nontrivial).project PUnit.unit
    (sourceEvent observation nontrivial).occurrence PUnit.unit).down

@[simp] theorem installedEnergySupportDisposition_eq_source
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat,
      observation.coordinate = -2 * (n + 1)) :
    installedEnergySupportDisposition observation nontrivial =
      generateEnergySupportRootDisposition observation nontrivial :=
  rfl

theorem installedEnergySupportDisposition_eq_critical
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat,
      observation.coordinate = -2 * (n + 1))
    (critical : observation.coordinate.re = 1 / 2) :
    installedEnergySupportDisposition observation nontrivial =
      .critical critical := by
  rw [installedEnergySupportDisposition_eq_source]
  unfold generateEnergySupportRootDisposition
  split
  · congr
  · rename_i notCritical
    exact False.elim (notCritical critical)

theorem installedEnergySupportDisposition_eq_offCenter
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat,
      observation.coordinate = -2 * (n + 1))
    (offCenter : observation.coordinate.re ≠ 1 / 2) :
    installedEnergySupportDisposition observation nontrivial =
      .offCenter offCenter
        (offCenterEnergySupportObstruction
          observation nontrivial offCenter) := by
  rw [installedEnergySupportDisposition_eq_source]
  unfold generateEnergySupportRootDisposition
  split
  · rename_i critical
    exact False.elim (offCenter critical)
  · congr

/-- Compatibility readout for the already developed negative branch.  The
obstruction is now extracted from the root-generated total disposition; the
root payload itself does not accept `offCenter`. -/
theorem installedEnergySupport
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (offCenter : observation.coordinate.re ≠ 1 / 2) :
    OffCenterEnergySupportObstruction observation nontrivial := by
  cases outcome_eq : installedEnergySupportDisposition observation nontrivial with
  | critical critical => exact False.elim (offCenter critical)
  | offCenter _ residual => exact residual

@[simp] theorem installedEnergySupport_eq_source
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (offCenter : observation.coordinate.re ≠ 1 / 2) :
    installedEnergySupport observation nontrivial offCenter =
      offCenterEnergySupportObstruction observation nontrivial offCenter :=
  Subsingleton.elim _ _

theorem installedFaces_factorize
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial : ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    let generated := (root observation nontrivial).canonicalCausalAnswerAndNext
      (ULift.up (visit observation nontrivial))
    HEq (generated.generated.projectionOutcome
        ((energySupportInstallation observation nontrivial).embed PUnit.unit))
      ((energySupportProjectionLaw observation nontrivial).outcomeAt PUnit.unit
        generated.generated.occurrence) ∧
    HEq (generated.generated.projectionOutcome
        ((receiptRelationInstallation observation nontrivial).embed PUnit.unit))
      ((runtimePrimeExponentPoleReceiptRelationProjectionLaw observation
        nontrivial).outcomeAt PUnit.unit generated.generated.occurrence) ∧
    HEq (generated.generated.projectionOutcome
        ((faithfulInstallation observation nontrivial).embed PUnit.unit))
      ((runtimeJointFaithfulMaterialLaw observation nontrivial).toProjectionLaw
          |>.outcomeAt PUnit.unit generated.generated.occurrence) ∧
    HEq generated.generated.wholeLedgerWriteBack
      ((root observation nontrivial).toAuthoritativeRoot.toLedgerRoot
        |>.generatedLedgerAt (visit observation nontrivial).current) ∧
    generated.nextCurrent =
      (root observation nontrivial).generatedNextCurrentAt
        (visit observation nontrivial) := by
  dsimp only
  let evolution := (root observation nontrivial).canonicalCausalAnswerAndNext
    (ULift.up (visit observation nontrivial))
  have energy := evolution.installedSubsystemAuthority_factorizes
    (energySupportInstallation observation nontrivial) PUnit.unit
  have receipt := evolution.installedSubsystemAuthority_factorizes
    (receiptRelationInstallation observation nontrivial) PUnit.unit
  have faithful := evolution.installedSubsystemAuthority_factorizes
    (faithfulInstallation observation nontrivial) PUnit.unit
  exact ⟨energy.2.1, receipt.2.1, faithful.2.1, HEq.rfl, rfl⟩

end


