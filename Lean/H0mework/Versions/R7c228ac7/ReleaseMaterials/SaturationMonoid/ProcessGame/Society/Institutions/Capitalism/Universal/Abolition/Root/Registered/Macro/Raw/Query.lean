import H0mework.Versions.R7c228ac7.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Root.Registered.Macro.Raw.Source
import H0mework.Versions.R7c228ac7.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Root.Registered.Macro.Inquiry.Component

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Root.Registered.Macro.Raw

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot
open SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Root

noncomputable section

variable {Party Good Port Technology Instrument : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Port] [DecidableEq Instrument]
  {input : ProgrammeSource.Input Party Good Port Technology Instrument}
  {depth count prefixLimit renewalLimit sourceDepth sourceCount : Nat}
  {start : Physical.Cursor Party Good Port Technology Instrument}
  {proposal : Compile.RawInput Party Good Port Technology Instrument} {sourcePosition : Nat}
  {review : Option (ReviewPhase.ContextAt input)}
  (frame : NativeFrame (review := review) input depth count prefixLimit renewalLimit sourceDepth sourceCount start proposal sourcePosition)
  (data : Continuation.FinancialData frame) (reader : Reader input depth count)

inductive QueryAt (current : frame.V.Current)
  | internal (work : Inquiry.HasWork frame current)
  | raw (germ : GermAt frame data reader current)

theorem complete_has_no_internal_work (current : frame.V.Current)
    (complete : Bound.Complete (review := review) input depth count prefixLimit renewalLimit sourceDepth sourceCount
      start proposal sourcePosition (frame.cursor current)) : ¬ Inquiry.HasWork frame current := by
  rintro (unpaid | item)
  · have impossible : true = false := complete.1.symm.trans unpaid
    cases impossible
  · change (Accounting.item? (review := review) input depth count prefixLimit renewalLimit sourceDepth sourceCount
      start proposal sourcePosition (frame.cursor current)).isSome = true at item
    rw [complete.2] at item
    cases item

theorem no_work_is_source_complete (current : frame.V.Current)
    (absent : ¬ Inquiry.HasWork frame current) :
    Bound.Complete (review := review) input depth count prefixLimit renewalLimit sourceDepth sourceCount
      start proposal sourcePosition (frame.cursor current) := by
  constructor
  · exact Bool.eq_true_of_not_eq_false (fun failed => absent (.inl failed))
  · cases selected : frame.item? current with
    | none => exact selected
    | some item => exact (absent (.inr (by rw [selected]; rfl))).elim

/-- The query seal is generated by the current source. At a completed batch
it contains the actual raw snapshot rather than an empty internal token. -/
def queryAt (current : frame.V.Current) (ready : data.Ready current)
    (same : Continuation.AccountIsSourceFold (review := review) input depth count prefixLimit renewalLimit sourceDepth sourceCount
      start proposal sourcePosition (frame.cursor current)) : QueryAt frame data reader current :=
  if work : Inquiry.HasWork frame current then .internal work
  else .raw (germAt frame data reader current ⟨ready, same, no_work_is_source_complete frame current work⟩)

theorem query_unique (current : frame.V.Current) (ready : data.Ready current)
    (same : Continuation.AccountIsSourceFold (review := review) input depth count prefixLimit renewalLimit sourceDepth sourceCount
      start proposal sourcePosition (frame.cursor current))
    (candidate : QueryAt frame data reader current) : candidate = queryAt frame data reader current ready same := by
  unfold queryAt
  split_ifs with work
  · cases candidate with
    | internal actual => rfl
    | raw germ => exact (complete_has_no_internal_work frame current germ.complete work).elim
  · cases candidate with
    | internal actual => exact (work actual).elim
    | raw germ => exact congrArg QueryAt.raw (germ_unique frame data reader current _ germ)

theorem complete_still_has_a_real_raw_query (current : frame.V.Current)
    (ready : data.Ready current)
    (same : Continuation.AccountIsSourceFold (review := review) input depth count prefixLimit renewalLimit sourceDepth sourceCount
      start proposal sourcePosition (frame.cursor current))
    (complete : Bound.Complete (review := review) input depth count prefixLimit renewalLimit sourceDepth sourceCount
      start proposal sourcePosition (frame.cursor current)) :
    ∃ germ, queryAt frame data reader current ready same = .raw germ := by
  unfold queryAt
  rw [dif_neg (complete_has_no_internal_work frame current complete)]
  exact ⟨_, rfl⟩

#print axioms query_unique
#print axioms complete_still_has_a_real_raw_query

end
end SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Root.Registered.Macro.Raw
