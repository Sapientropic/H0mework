import H0mework.Versions.R7c228ac7.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Accounting.Root.Reentry.Source

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Accounting.Priority.Policy

open Source.Program Innovation
open Exit.Necessity

noncomputable section

variable {Party Good Port Technology Instrument : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Instrument]
  {source : Trials.Mechanism Party Good Port Technology Instrument}
  {past : List (RawEvent Party Good Port Technology Instrument)} {nature : source.Nature}
  {response : Control.HistoryResponse (Party := Party) (Good := Good) (Port := Port)
    (Technology := Technology) (Instrument := Instrument)}
  (claim : Responsibility.Family.Claim source past nature response)
  (state : Responsibility.Family.State claim) (law : RawLaw Party Good Port Technology Instrument)
  (members : List Party) (front : RawEvent Party Good Port Technology Instrument)
  (request : Request Party Good Port Technology Instrument)

def current : RawCurrent Party Good Technology Instrument := (law.execute state.raw 0 front).final

def beforeState : Responsibility.Family.State claim := Responsibility.Family.State.advance claim state law front

def known : Prop := request.signer ∈ members ∧
  ∀ actor ∈ request.consents ++ Source.ProgrammeFace.operationParties request.operation, actor ∈ members

instance : Decidable (known members request) := by unfold known; infer_instance

/-- The remaining amount is the current original obligation, not its old
positive support. Duplicate bundle entries use their total physical amount. -/
def amountAllowed : Prop :=
  match request.operation with
  | .transfer _ recipient goods =>
      ¬ Responsibility.Family.State.isPaid claim (beforeState claim state law front) ∧
      ∀ entry ∈ goods,
        0 < (beforeState claim state law front).remaining (recipient,entry.1) ∧
        amount Good goods entry.1 ≤ (beforeState claim state law front).remaining (recipient,entry.1)
  | .produce _ | .revise .. =>
      ¬ Responsibility.Family.State.isPaid claim (beforeState claim state law front)
  | .use actor goods .necessity => actor ∈ members ∧ goods = law.necessities state.raw actor ∧
      ¬ BundlePaid law state.raw front actor (law.necessities state.raw actor) .necessity
  | .use actor goods .maintenance => actor ∈ members ∧ goods = law.mandatoryMaintenance state.raw actor ∧
      ¬ BundlePaid law state.raw front actor (law.mandatoryMaintenance state.raw actor) .maintenance
  | .use _ _ .investment | .use _ _ .contribution | .use _ _ .external |
      .issue .. | .assign .. | .settle .. => False
  | .present => True

instance : Decidable (amountAllowed claim state law members front request) := by
  unfold amountAllowed
  cases request.operation with
  | use actor goods purpose => cases purpose <;> infer_instance
  | _ => infer_instance

/-- Only ports generated by the actual proposed transition and its members'
real techniques are inspected. Table values never confer an unoccurred authority. -/
def controlPorts : List Port :=
  request.purpose :: (request.gates ++ law.requiredPorts (current claim state law front) request ++
    law.requiredPorts (law.step (current claim state law front) request) request ++
    (members.flatMap fun actor =>
      (law.technique (current claim state law front).technology actor).requiredPorts ++
      (law.technique (law.step (current claim state law front) request).technology actor).requiredPorts))

def preservesControl : Prop :=
  ∀ port ∈ controlPorts claim state law members front request, ∀ actor ∈ members,
    law.allowed (law.step (current claim state law front) request).technology port actor = false →
      law.allowed (current claim state law front).technology port actor = false ∧
      law.controller (law.step (current claim state law front) request).technology port =
        law.controller (current claim state law front).technology port

instance : Decidable (preservesControl claim state law members front request) := by unfold preservesControl; infer_instance

inductive Denial : Type
  | declaration (pending : state.declared ≠ true)
  | standing (unknown : ¬ known members request)
  | material (foreign : ¬ Responsibility.Family.materialOperation
      (Responsibility.controllerCohort source past nature response)
      (Responsibility.Family.positiveScope source past nature response) request)
  | authority (invalid : ¬ law.Valid (current claim state law front) request)
  | quantity (unpaid : ¬ amountAllowed claim state law members front request)
  | control (newControl : ¬ preservesControl claim state law members front request)

inductive Decision : Type
  | permitted
      (declared : state.declared = true) (standing : known members request)
      (material : Responsibility.Family.materialOperation (Responsibility.controllerCohort source past nature response)
        (Responsibility.Family.positiveScope source past nature response) request)
      (valid : law.Valid (current claim state law front) request)
      (amount : amountAllowed claim state law members front request)
      (control : preservesControl claim state law members front request)
  | denied (issue : Denial claim state law members front request)

def decideRequest : Decision claim state law members front request :=
  if declared : state.declared = true then
    if standing : known members request then
      if material : Responsibility.Family.materialOperation (Responsibility.controllerCohort source past nature response)
          (Responsibility.Family.positiveScope source past nature response) request then
        if valid : law.Valid (current claim state law front) request then
          if amount : amountAllowed claim state law members front request then
            if control : preservesControl claim state law members front request then
              .permitted declared standing material valid amount control
            else .denied (.control control)
          else .denied (.quantity amount)
        else .denied (.authority valid)
      else .denied (.material material)
    else .denied (.standing standing)
  else .denied (.declaration declared)

end
end SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Accounting.Priority.Policy
