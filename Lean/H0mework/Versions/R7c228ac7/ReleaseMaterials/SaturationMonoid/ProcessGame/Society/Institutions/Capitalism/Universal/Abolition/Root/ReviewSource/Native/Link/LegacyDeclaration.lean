noncomputable section

variable {Party Good Port Technology Instrument : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Port] [DecidableEq Instrument]
  (source : OutstandingSource Party Good Port Technology Instrument) (depth count : Nat)

def ordinal := Settlement.physicalIndex source.input depth count - 1

theorem original_ordinal_is_positive : 0 < ordinal source depth count := by
  have enough := Macro.Services.Native.actual_cut_includes_original_request source depth count
  change 2 ≤ Settlement.physicalIndex source.input depth count at enough
  unfold ordinal
  omega

def payments := (source.frameAt (ordinal source depth count)).payments

theorem the_original_payload_reads_the_original_source_decision :
    taskOfPayload (originalPayload source.input (Settlement.committedVisit source.input depth count).current) =
      taskOfReport (source.reportAt (source.currentAt (ordinal source depth count))) := by
  have positive := original_ordinal_is_positive source depth count
  generalize original : ordinal source depth count = occurrence at positive ⊢
  change taskOfPayload (originalPayload source.input (ProgrammeHistory.visitAt source.input
    (Settlement.physicalIndex source.input depth count - 1)).current) = _
  change ordinal source depth count = occurrence at original
  rw [show Settlement.physicalIndex source.input depth count - 1 = occurrence from original]
  cases occurrence with
  | zero => omega
  | succ earlier =>
      change taskOfPayload (originalPayload source.input
        (ProgrammeSource.next source.input (ProgrammeHistory.visitAt source.input earlier).current)) =
          taskOfReport (source.reportAt (ProgrammeSource.rawCurrent source.input
            (ProgrammeSource.next source.input (ProgrammeHistory.visitAt source.input earlier).current)))
      cases (ProgrammeHistory.visitAt source.input earlier).current <;>
        dsimp only [ProgrammeSource.next, originalPayload] <;>
        rw [every_original_row_writes_the_same_payload] <;> rfl

/-- The native index is generated by the original pending-index list. Slot
values never participate in a lookup, deduplication or identity test. -/
structure PlanningIdentity (task : Material.OriginalTask source.input depth count) : Type where
  private mk ::
  nonempty : source.pendingSlots (payments source depth count) ≠ []
  task_eq : task.val = source.pendingTask (payments source depth count) nonempty
  occurred : source.decideAt (source.currentAt (ordinal source depth count)) (payments source depth count) =
    .planning nonempty (PublicFunction.compile source.seed.law (source.currentAt (ordinal source depth count))
      (source.pendingTask (payments source depth count) nonempty)
      (source.seed.actionsAt (source.currentAt (ordinal source depth count))) source.seed.budget)

namespace PlanningIdentity
variable {source depth count} {task : Material.OriginalTask source.input depth count}
  (identity : PlanningIdentity source depth count task)

def originalIndex (index : Material.Slot source.input depth count task) : source.Slot :=
  (source.pendingIndices (payments source depth count)).get
    ⟨index.val, by simpa [identity.task_eq, OutstandingSource.pendingTask,
      OutstandingSource.pendingSlots] using index.isLt⟩

theorem mapped_slot_is_the_original_indexed_slot (index : Material.Slot source.input depth count task) :
    Material.slot source.input depth count task index = source.seed.slot (identity.originalIndex index) := by
  unfold Material.slot originalIndex
  simp only [identity.task_eq, OutstandingSource.pendingTask, OutstandingSource.pendingSlots,
    List.get_eq_getElem, Fin.getElem_fin, List.getElem_map]

end PlanningIdentity

/-- A completion report may declare a new task. It cannot reopen or
rename the old native task, whose already generated state is retained. -/
structure CompletionDeclaration : Type where
  private mk ::
  oldScopeComplete : source.pendingSlots (payments source depth count) = []
  occurred : source.decideAt (source.currentAt (ordinal source depth count)) (payments source depth count) =
    .complete oldScopeComplete

inductive Recognition (task : Material.OriginalTask source.input depth count) : Type
  | planning (identity : PlanningIdentity source depth count task)
  | completion (residual : CompletionDeclaration source depth count)

private theorem the_declared_task_is_from_the_same_source_report
    (task : Material.OriginalTask source.input depth count) :
    taskOfReport (source.reportAt (source.currentAt (ordinal source depth count))) = some task.val :=
  (the_original_payload_reads_the_original_source_decision source depth count).symm.trans task.property

def recognize (task : Material.OriginalTask source.input depth count) : Recognition source depth count task := by
  have disclosed := the_declared_task_is_from_the_same_source_report source depth count task
  unfold OutstandingSource.reportAt at disclosed
  rw [source.ordinal_exact] at disclosed
  by_cases first : ordinal source depth count = 1
  · rw [if_pos first] at disclosed
    cases disclosed
  · rw [if_neg first] at disclosed
    change taskOfReport ((source.decideAt (source.currentAt (ordinal source depth count))
      (payments source depth count)).report) = some task.val at disclosed
    generalize generated : source.decideAt (source.currentAt (ordinal source depth count))
      (payments source depth count) = decision at disclosed
    cases decision with
    | complete empty => exact .completion ⟨empty, generated⟩
    | received incoming => cases disclosed
    | planning nonempty outcome =>
        have sameTask : task.val = source.pendingTask (payments source depth count) nonempty :=
          (Option.some.inj disclosed).symm
        have compiled : outcome = PublicFunction.compile source.seed.law
            (source.currentAt (ordinal source depth count))
            (source.pendingTask (payments source depth count) nonempty)
            (source.seed.actionsAt (source.currentAt (ordinal source depth count))) source.seed.budget := by
          unfold OutstandingSource.decideAt at generated
          split at generated
          · cases generated
          · split at generated
            · cases generated
            · cases generated
              rfl
        cases compiled
        exact .planning ⟨nonempty, sameTask, generated⟩

def CompletionDeclaration.retainedState
    (_residual : CompletionDeclaration source depth count) (prefixLimit renewalLimit : Nat)
    (snapshot : Physical.Cursor Party Good Port Technology Instrument) (index : source.Slot) :=
  (OriginAt.outstanding source).state depth count
    (atPast (.outstanding source) depth count prefixLimit renewalLimit snapshot.past index)

def CompletionDeclaration.originalRow (_residual : CompletionDeclaration source depth count) :=
  ProgrammeSource.sourceEntry source.input (Settlement.committedVisit source.input depth count).current .inherited

