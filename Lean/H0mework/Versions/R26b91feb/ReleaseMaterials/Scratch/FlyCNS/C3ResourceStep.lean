import H0mework.Versions.R26b91feb.ReleaseMaterials.Scratch.FlyCNS.C3ActuationStep

/-! C7's finite stock/energy/hydration/peptide update. The fixed source
compiler folds 1-exp(-0.0001/0.2) once; no dynamic exp or future value is an
input. Body observations are generated by the preceding physical operator. -/

set_option autoImplicit false

namespace FlyCNS.C3Resource
open FlyCNS.C3Actuation

def one : Float := Float.ofBits 0x3FF0000000000000
def peptideRelaxation : Float := Float.ofBits 0x3F4061416EEB4800

structure Material where
  energyCapacity : Float
  waterCapacity : Float
  basalEnergy : Float
  basalWater : Float
  energyPerMM : Float
  energyPerWork : Float
  feedingRate : Float
  tasteStrength : Float
  timestep : Float
  patchPositions : Array (Array Float)
  patchRadii : Array Float

structure State where
  values : Array Float
  sugar : Array Float
  water : Array Float
  peptide : Array Float
  peptideEnabled : Bool

structure BodyFrame where
  mouth : Array Float
  previousPosition : Array Float
  position : Array Float
  actuatorForce : Array Float
  actuatorVelocity : Array Float
  feeding : Float

structure Result where
  state : State
  taste : Array Float
  sugar : Float
  water : Float
  touching : Array Nat
  distance : Float
  work : Float

/-- Actual NumPy float64 pairwise sum; the original arrays have at most50 entries. -/
def sum (a : Array Float) : Float := Id.run do
  if a.size < 8 then
    let mut value := Float.ofBits 0x8000000000000000
    for x in a do value := value+x
    return if a.isEmpty then zero else value
  let mut lanes := a.extract 0 8
  for chunk in [1:a.size/8] do
    for lane in [:8] do lanes := lanes.set! lane (lanes[lane]!+a[8*chunk+lane]!)
  let mut value := ((lanes[0]!+lanes[1]!)+(lanes[2]!+lanes[3]!)) + ((lanes[4]!+lanes[5]!)+(lanes[6]!+lanes[7]!))
  for k in [8*(a.size/8):a.size] do value := value+a[k]!
  return value

def distance (a b : Array Float) : Float :=
  let d := a.mapIdx fun i value => value-b[i]!
  (((d[0]!*d[0]!)+(d[1]!*d[1]!))+(d[2]!*d[2]!)).sqrt

def advance (m : Material) (s : State) (body : BodyFrame) : Result := Id.run do
  let moved := distance body.position body.previousPosition
  let work := sum (body.actuatorForce.mapIdx fun i f => (f*body.actuatorVelocity[i]!).abs) * m.timestep
  let energyCost := min s.values[0]! ((m.basalEnergy*m.timestep + m.energyPerMM*moved) + m.energyPerWork*work)
  let waterCost := min s.values[1]! (m.basalWater*m.timestep)
  let mut values := (s.values.set! 0 (s.values[0]!-energyCost)).set! 1 (s.values[1]!-waterCost)
  values := values.set! 5 (values[5]!+energyCost)
  values := values.set! 6 (values[6]!+waterCost)
  values := values.set! 7 (values[7]!+work)
  let touching := (List.range m.patchRadii.size).toArray.filter fun i => distance body.mouth m.patchPositions[i]! <= m.patchRadii[i]!
  let sugarAvailable := sum (touching.map fun i => s.sugar[i]!)
  let waterAvailable := sum (touching.map fun i => s.water[i]!)
  let available := sugarAvailable+waterAvailable
  let mut sugar := zero
  let mut water := zero
  let mut sugarStock := s.sugar
  let mut waterStock := s.water
  if available > zero then
    let budget := (m.feedingRate*body.feeding)*m.timestep
    sugar := min sugarAvailable (min (budget*sugarAvailable/available) (m.energyCapacity-values[0]!))
    water := min waterAvailable (min (budget*waterAvailable/available) (m.waterCapacity-values[1]!))
    for i in touching do
      if sugarAvailable > zero then sugarStock := sugarStock.set! i (sugarStock[i]!*max zero (one-sugar/sugarAvailable))
      if waterAvailable > zero then waterStock := waterStock.set! i (waterStock[i]!*max zero (one-water/waterAvailable))
    values := values.set! 0 (values[0]!+sugar)
    values := values.set! 1 (values[1]!+water)
  values := values.set! 3 (values[3]!+sugar)
  values := values.set! 4 (values[4]!+water)
  values := values.set! 2 (values[2]!+m.timestep)
  let energyDeficit := one-values[0]!/m.energyCapacity
  let waterDeficit := one-values[1]!/m.waterCapacity
  let target := #[max energyDeficit waterDeficit,energyDeficit,energyDeficit]
  let peptide := if s.peptideEnabled then s.peptide.mapIdx fun i p => p+(target[i]!-p)*peptideRelaxation else Array.replicate 3 zero
  let contact := #[sum (touching.map fun i => sugarStock[i]!),sum (touching.map fun i => waterStock[i]!)]
  let total := sum contact
  let taste := if total > zero then contact.map fun value => m.tasteStrength*value/total else Array.replicate 2 zero
  return ⟨⟨values,sugarStock,waterStock,peptide,s.peptideEnabled⟩,taste,sugar,water,touching,moved,work⟩

end FlyCNS.C3Resource
