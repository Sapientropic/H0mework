structure ErrorEntry {boundary : Boundary} (context : Seal boundary) (installed : Installed boundary) where
  private mk ::
  address : C3NativeFinite.Address boundary context.anchor
  why : String
  generated : (C3NativeFinite.fromAddress installed context.anchor address).val=.error why

structure ErrorCache {boundary : Boundary} (context : Seal boundary) (installed : Installed boundary) where
  private mk ::
  entries : List (ErrorEntry context installed)

def emptyCache {boundary : Boundary} (context : Seal boundary) (installed : Installed boundary) :
    ErrorCache context installed := ⟨[]⟩

private def lookup {boundary : Boundary} {context : Seal boundary} {installed : Installed boundary}
    (why : String) : List (ErrorEntry context installed) → Option (ErrorEntry context installed)
  | [] => none
  | first::rest => if first.why=why then some first else lookup why rest

private def errorCarrier {boundary : Boundary} {context : Seal boundary} {installed : Installed boundary}
    (entry : ErrorEntry context installed) : Carrier boundary installed context.anchor :=
  ⟨.error entry.why,by
    have past:=(C3NativeFinite.fromAddress installed context.anchor entry.address).property
    rw [entry.generated] at past
    exact past⟩

/-- Successful bytes replay the same private source law from the actual
Anchor. A cached error retains only its own evaluated past address and
String; a caller cannot supply a Snapshot, after or membership proof. -/
def restoreKey {boundary : Boundary} (context : Seal boundary) (installed : Installed boundary)
    (cache : ErrorCache context installed) (key : Key context) : Except String (Carrier boundary installed context.anchor) :=
  match key with
  | .inl address =>
    let state:=fromWord boundary installed context.anchor (List.replicate (address.val-context.anchor.base.current.visit) (.inl ()))
    if _owned:C3NativePrecision.encode state=key then .ok state
    else .error "requested success key is not generated by its original source"
  | .inr why =>
    match lookup why cache.entries with
    | none => .error "requested error was not recorded by its original source"
    | some entry => if _same:entry.why=why then .ok (errorCarrier entry)
      else .error "source error cache does not match the requested String"

def restore {boundary : Boundary} (context : Seal boundary) (installed : Installed boundary)
    (cache : ErrorCache context installed) (bytes : ByteArray) : Except String (Carrier boundary installed context.anchor) := do
  let key ← parse context bytes
  restoreKey context installed cache key

theorem restoreKey_origin {boundary : Boundary} {context : Seal boundary} {installed : Installed boundary}
    {cache : ErrorCache context installed} {key : Key context} {state : Carrier boundary installed context.anchor}
    (paid : restoreKey context installed cache key=.ok state) : C3NativePrecision.encode state=key := by
  cases key with
  | inl address =>
    unfold restoreKey at paid
    dsimp only at paid
    split at paid
    · rename_i owned
      cases paid
      exact owned
    · contradiction
  | inr why =>
    unfold restoreKey at paid
    dsimp only at paid
    split at paid
    · contradiction
    · split at paid
      · rename_i same
        cases paid
        unfold C3NativePrecision.encode
        simp only [errorCarrier]
        exact congrArg Sum.inr same
      · contradiction

theorem restore_success {boundary : Boundary} (context : Seal boundary) (installed : Installed boundary)
    (cache : ErrorCache context installed) (state : Carrier boundary installed context.anchor)
    {current : Snapshot boundary} (success : state.val=.ok current) :
    restoreKey context installed cache (C3NativePrecision.encode state)=.ok state := by
  have decoded:=C3NativeMinimum.decode_encode state
  have generated:C3NativeMinimum.generate installed context.anchor
      (current.current.visit-context.anchor.base.current.visit)=.ok current := by
    simpa only [C3NativeMinimum.decode,C3NativeMinimum.encode,key,success] using decoded
  let candidate:=fromWord boundary installed context.anchor
    (List.replicate (current.current.visit-context.anchor.base.current.visit) (.inl ()))
  have complete:candidate=state := by
    apply Subtype.ext
    change execute installed (List.replicate (current.current.visit-context.anchor.base.current.visit) (.inl ()))
      (.ok context.anchor.base)=state.val
    rw [C3NativeFinite.execute_autonomous,generated]
    exact success.symm
  have encoded:C3NativePrecision.encode state=.inl
      (⟨current.current.visit,C3NativePrecision.carrier_success_bound state success⟩ : Fin _) := by
    unfold C3NativePrecision.encode
    split
    · rename_i why failed
      have impossible:=failed.symm.trans success
      contradiction
    · rename_i other accepted
      have same:other=current := Except.ok.inj (accepted.symm.trans success)
      subst other
      rfl
  rw [encoded]
  unfold restoreKey
  dsimp only
  have owned:C3NativePrecision.encode candidate=.inl
      (⟨current.current.visit,C3NativePrecision.carrier_success_bound state success⟩ : Fin _) := by
    rw [complete,encoded]
  change (if _owned:C3NativePrecision.encode candidate=Sum.inl _ then
    Except.ok candidate else Except.error "requested success key is not generated by its original source")=
      Except.ok state
  rw [dif_pos owned,complete]

theorem restore_origin {boundary : Boundary} {context : Seal boundary} {installed : Installed boundary}
    {cache : ErrorCache context installed} {bytes : ByteArray} {state : Carrier boundary installed context.anchor}
    (paid : restore context installed cache bytes=.ok state) : encode context (C3NativePrecision.encode state)=bytes := by
  unfold restore at paid
  cases parsed:parse context bytes with
  | error why => simp only [parsed,bind,Except.bind] at paid;contradiction
  | ok key =>
    simp only [parsed,bind,Except.bind] at paid
    rw [restoreKey_origin paid]
    exact encode_parse parsed

structure Saved {boundary : Boundary} (context : Seal boundary) (installed : Installed boundary) where
  private mk ::
  bytes : ByteArray
  errors : ErrorCache context installed

/-- Generate the addressed source occurrence exactly once. Store its key
and add only an actually produced error to the sealed past-error cache. -/
def saveAddress {boundary : Boundary} (context : Seal boundary) (installed : Installed boundary)
    (cache : ErrorCache context installed) (address : C3NativeFinite.Address boundary context.anchor) : Saved context installed :=
  let state:=C3NativeFinite.fromAddress installed context.anchor address
  match generated:state.val with
  | .ok _ => ⟨encode context (C3NativePrecision.encode state),cache⟩
  | .error why =>
    let entry : ErrorEntry context installed := ⟨address,why,generated⟩
    ⟨encode context (.inr why),⟨entry::cache.entries⟩⟩

theorem restore_saveAddress {boundary : Boundary} (context : Seal boundary) (installed : Installed boundary)
    (cache : ErrorCache context installed) (address : C3NativeFinite.Address boundary context.anchor) :
    let saved:=saveAddress context installed cache address
    restore context installed saved.errors saved.bytes=.ok (C3NativeFinite.fromAddress installed context.anchor address) := by
  dsimp only [saveAddress]
  split
  · rename_i current success
    simp only [restore,parse_encode,bind,Except.bind]
    exact restore_success context installed cache _ success
  · rename_i why generated
    simp [restore,parse_encode,restoreKey,lookup,bind,Except.bind]
    apply Subtype.ext
    exact generated.symm

theorem saved_all_future_readers {boundary : Boundary} (context : Seal boundary) (installed : Installed boundary)
    (cache : ErrorCache context installed) (address : C3NativeFinite.Address boundary context.anchor)
    (word : List Letter) (observer : Fin 69) :
    (do
      let saved:=saveAddress context installed cache address
      let state ← restore context installed saved.errors saved.bytes
      C3NativeMinimum.read observer (execute installed word state.val))=
    C3NativeMinimum.read observer (execute installed word
      (C3NativeFinite.fromAddress installed context.anchor address).val) := by
  dsimp only
  simp only [restore_saveAddress,bind,Except.bind]

/-- Save the emitted source event itself. The original Root has already
performed F; this consumer only serializes its own generated visit key. -/
def savePublished {boundary : Boundary} (context : Seal boundary) (installed : Installed boundary)
    (cache : ErrorCache context installed) (before : Ready boundary installed context.anchor)
    (event : ContentReentryRoot.PublishedAt boundary.source installed.material before.current.current) : Saved context installed :=
  let state:=C3NativeMinimum.consumePublished before event
  ⟨encode context (C3NativePrecision.encode state),cache⟩

theorem restore_savedPublished {boundary : Boundary} (context : Seal boundary) (installed : Installed boundary)
    (cache : ErrorCache context installed) (before : Ready boundary installed context.anchor)
    (event : ContentReentryRoot.PublishedAt boundary.source installed.material before.current.current) :
    let saved:=savePublished context installed cache before event
    restore context installed saved.errors saved.bytes=.ok (C3NativeMinimum.consumePublished before event) := by
  simp only [savePublished,restore,parse_encode,bind,Except.bind]
  exact restore_success context installed cache _ rfl

theorem savedPublished_same_image {boundary : Boundary} (context : Seal boundary) (installed : Installed boundary)
    (cache : ErrorCache context installed) (before : Ready boundary installed context.anchor)
    (event : ContentReentryRoot.PublishedAt boundary.source installed.material before.current.current)
    (observer : Fin 69) :
    (do
      let saved:=savePublished context installed cache before event
      let state ← restore context installed saved.errors saved.bytes
      C3NativeMinimum.read observer state.val)=
    Except.ok (C3CompleteInventory.read (C3ReachableModel.reader observer)
      (C3CompleteInventory.fromActual event.original)) := by
  dsimp only
  simp only [restore_savedPublished,bind,Except.bind]
  exact C3NativeMinimum.consumed_same_image before event observer

theorem savedPublished_whole_six {boundary : Boundary} (context : Seal boundary) (installed : Installed boundary)
    (before : Ready boundary installed context.anchor)
    (event : ContentReentryRoot.PublishedAt boundary.source installed.material before.current.current)
    (responsibility : ContentReentryRoot.Responsibility) :
    (event.original.patch.toLedgerWriteEvolution.destination
      (ContentReentryRoot.entry boundary.source before.current.current responsibility)).1=
    ContentReentryRoot.entry boundary.source (C3NativeMinimum.fromPublished event).current responsibility :=
  C3PublishedRoot.actual_whole_six event responsibility

def serialize {boundary : Boundary} (context : Seal boundary) {installed : Installed boundary}
    (state : Carrier boundary installed context.anchor) : ByteArray := encode context (C3NativePrecision.encode state)

theorem serialize_injective {boundary : Boundary} (context : Seal boundary) (installed : Installed boundary) :
    Function.Injective (serialize context (installed:=installed)) := by
  intro left right same
  apply C3NativePrecision.finite_key_injective
  exact encode_injective context same

theorem serialized_minimum_future_kernel {boundary : Boundary} (context : Seal boundary) (installed : Installed boundary)
    (left right : Carrier boundary installed context.anchor) : serialize context left=serialize context right ↔
    ∀ word : List Letter,∀ observer : Fin 69,
      C3NativeMinimum.read observer (run word left).val=C3NativeMinimum.read observer (run word right).val := by
  constructor
  · intro same
    have equal:=serialize_injective context installed same
    subst right
    intro word observer
    rfl
  · intro same
    have keyed:=C3NativePrecision.minimum_future_kernel left right |>.mpr same
    exact congrArg (encode context) keyed

theorem serialize_success_size {boundary : Boundary} (context : Seal boundary) {installed : Installed boundary}
    (state : Carrier boundary installed context.anchor) {current : Snapshot boundary}
    (success : state.val=.ok current) : (serialize context state).size=8 := by
  unfold serialize C3NativePrecision.encode
  split
  · rename_i why failed
    have impossible:=failed.symm.trans success
    contradiction
  · exact counter_size _

theorem savedPublished_size {boundary : Boundary} (context : Seal boundary) (installed : Installed boundary)
    (cache : ErrorCache context installed) (before : Ready boundary installed context.anchor)
    (event : ContentReentryRoot.PublishedAt boundary.source installed.material before.current.current) :
    (savePublished context installed cache before event).bytes.size=8 :=
  serialize_success_size context (C3NativeMinimum.consumePublished before event) rfl

