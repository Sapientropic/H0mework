/-- The source axis is the same spinRotation 2 used by the original locked field. -/
def sourceRotationTangent (p : Fin 3→ℝ) : Fin 3→ℝ:=![-p 1,p 0,0]

def sourceLockedSourceWeight (index : Source.Index) : ℂ :=
  -((if index.1.val%2=0 then (1:ℂ) else -1)+(if index.2=0 then (1:ℂ) else -1))/2

def sourceLockedSourceMatrix : Matrix Source.Index Source.Index ℂ:=Matrix.diagonal sourceLockedSourceWeight

/-- The original canonical current, including its momentum dual, generates the finite charge matrix. -/
theorem sourceLockedSourceMatrix_original (values : Source.Index→ℂ) :
    sourceLockedCurrentDirection 0 2 (embed values)=embed (sourceLockedSourceMatrix*ᵥvalues) := by
  rw [sourceLockedCurrentDirection_embedding]
  apply congrArg embed
  funext index
  rcases index with ⟨spin,color⟩
  fin_cases spin <;> fin_cases color <;>
    simp [sourceLockedCurrentValues,sourceLockedValues,sourceLockedSourceMatrix,sourceLockedSourceWeight,
      Matrix.mulVec_diagonal,sourceColorPauli,spinRotation,diracGamma,diracGammaZero,diracGammaOne,
      diracGammaTwo,diracGammaThree,Matrix.mul_apply,Fin.sum_univ_four,Fin.sum_univ_two]
  all_goals try ring_nf
  all_goals try simp only [Complex.I_sq]
  all_goals ring

/-- The complete original eigenbasis returns this matrix to the actual full mother Hamiltonian. -/
theorem sourceMovingHamiltonian_original (p : Fin 3→ℝ) (values : Source.Index→ℂ) :
    FullQuantum.hamiltonian actual 0 p (embed values)=embed (sourceMovingFullHamiltonian p*ᵥvalues) := by
  have eig (state : RestStateIndex) := sourceMovingPole_hamiltonian 0 p state
  simp only [Runtime.configuration_eq] at eig
  conv_lhs => rw [←sourceMovingPole_complete p values]
  conv_rhs => rw [←sourceMovingPole_complete p values]
  simp only [map_sum,map_smul,eig,Matrix.mulVec_sum,Matrix.mulVec_smul,sourceMovingFullHamiltonian_eigen]

/-- This derivative is generated by the original affine momentum dependence, with the zero-order source subtracted exactly. -/
def sourceRotationHamiltonianJet (p : Fin 3→ℝ) : Matrix Source.Index Source.Index ℂ :=
  sourceMovingFullHamiltonian (sourceRotationTangent p)-sourceMovingFullHamiltonian 0

private theorem moving_entry (p : Fin 3→ℝ) (row column : Source.Index) :
    sourceMovingFullHamiltonian p row column=
      if row.1.val/2=column.1.val/2 then
        (if row.1.val<2 then (-1:ℂ) else 1)*
          ChargedPreparation.SpatialSpectrum.sourceMatrix p
            ⟨2*(row.1.val%2)+row.2.val,by omega⟩
            ⟨2*(column.1.val%2)+column.2.val,by omega⟩ else 0 := rfl

/-- The spin-color commutator is the actual spatial rotation derivative on the same source carrier. -/
theorem sourceJointRotationHamiltonian (p : Fin 3→ℝ) :
    sourceMovingFullHamiltonian p*sourceLockedSourceMatrix-sourceLockedSourceMatrix*sourceMovingFullHamiltonian p=
      Complex.I • sourceRotationHamiltonianJet p := by
  simp only [sourceLockedSourceMatrix]
  ext row column
  simp only [Matrix.sub_apply,Matrix.smul_apply,Matrix.mul_diagonal,Matrix.diagonal_mul]
  rcases row with ⟨spin,color⟩
  rcases column with ⟨other,colour⟩
  fin_cases spin <;> fin_cases color <;> fin_cases other <;> fin_cases colour <;>
    norm_num [sourceLockedSourceWeight,sourceRotationHamiltonianJet,sourceRotationTangent,
      moving_entry,ChargedPreparation.SpatialSpectrum.sourceMatrix,Matrix.cons_val_two,Matrix.vecHead,Matrix.vecTail]
  all_goals try ring_nf
  all_goals try simp only [Complex.I_sq]
  all_goals ring

theorem sourceRotationHamiltonian_affine (p : Fin 3→ℝ) (t : ℝ) :
    sourceMovingFullHamiltonian (p+t • sourceRotationTangent p)=
      sourceMovingFullHamiltonian p+t • sourceRotationHamiltonianJet p := by
  ext row column
  rcases row with ⟨spin,color⟩
  rcases column with ⟨other,colour⟩
  fin_cases spin <;> fin_cases color <;> fin_cases other <;> fin_cases colour <;>
    norm_num [sourceRotationHamiltonianJet,sourceRotationTangent,moving_entry,
      ChargedPreparation.SpatialSpectrum.sourceMatrix,Complex.real_smul,Matrix.cons_val_two,Matrix.vecHead,Matrix.vecTail]
  all_goals ring

theorem sourceRotationHamiltonian_derivative (p : Fin 3→ℝ) :
    HasDerivAt (fun t : ℝ=>sourceMovingFullHamiltonian (p+t • sourceRotationTangent p))
      (sourceRotationHamiltonianJet p) 0 := by
  have generated:=((hasDerivAt_id (0:ℝ)).smul_const (sourceRotationHamiltonianJet p)).const_add
    (sourceMovingFullHamiltonian p)
  simpa only [sourceRotationHamiltonian_affine,one_smul,id_eq] using generated

end LowEnergy.PreparationPhysicalJointRotationCharge
