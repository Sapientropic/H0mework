/-- The actual finite weight reader uses the original two raw-frame labels. -/
def sourceTemporalWeightReader (F : GaussUnitaryHistory.Index) : H→L[ℂ]H :=
  finiteRiesz F (fun i j=>sourcePair (frameTest F i) (weightCore (frameTest F j)))

private theorem weight_action (F : GaussUnitaryHistory.Index) (y : H) :
    sourceTemporalWeightReader F y=sourceApprox F (embed (weightCore (sourceTestApprox F y))) := by
  rw [sourceTemporalWeightReader,sourceApprox_frame,sourceTestApprox_frame]
  simp only [finiteRiesz,sum_apply,smul_apply,InnerProductSpace.rankOne_apply,
    map_sum,map_smul,inner_sum,inner_smul_right,Finset.sum_smul,smul_smul]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  unfold sourcePair
  rw [frameTest_embed]
  congr 1
  ring

/-- These are the two actual input-test approximation defects, rather than a charge-invariant span assumption. -/
def sourceTemporalInputCharge (F : GaussUnitaryHistory.Index) (y : H) : QuantumTest :=
  sourceTestApprox F (sourceActualGaussCharge y)-sourceCoframeChargeCore (sourceTestApprox F y)
def sourceTemporalInputDifference (F : GaussUnitaryHistory.Index) (y : H) : QuantumTest :=
  sourceTestApprox F (sourceFirstDifference y)-sourceFirstDifferenceCore (sourceTestApprox F y)

def sourceTemporalFrameNormal (F : GaussUnitaryHistory.Index) (y : H) : H :=
  sourceApprox F (embed
    (weightCore (sourceTemporalInputCharge F y)+weightCore (sourceTemporalInputDifference F y)+
      sourceTemporalNormalCore sourceActualGaussChargeMatrix (sourceTestApprox F y)+
      sourceTemporalNormalCore sourceFirstDifferenceMatrix (sourceTestApprox F y)))

theorem sourceTemporalChargeReader_weighted (F : GaussUnitaryHistory.Index) (y : H) :
    sourceTemporalChargeReader F y=
      -(sourceTemporalWeightReader F (sourceActualGaussCharge y))-
        sourceTemporalWeightReader F (sourceFirstDifference y)+sourceTemporalFrameNormal F y := by
  rw [sourceTemporalChargeReader_actual,weight_action,weight_action]
  simp only [sourceTemporalFrameNormal,sourceTemporalInputCharge,sourceTemporalInputDifference,
    map_add,map_sub,map_neg]
  abel

/-- The same source spectral decomposition is consumed inside the actual weighted temporal density. -/
theorem sourceTemporalChargeReader_spectral (F : GaussUnitaryHistory.Index) (y : H) :
    sourceTemporalChargeReader F y=
      -(sourceTemporalWeightReader F (sourceEqualProjection F sourceActualGaussCharge y))-
        sourceTemporalWeightReader F (sourceChargeOffEnergy F y)-
        sourceTemporalWeightReader F (sourceFirstDifference y)+sourceTemporalFrameNormal F y := by
  rw [sourceTemporalChargeReader_weighted]
  have source:=congrArg (fun A : H→L[ℂ]H=>sourceTemporalWeightReader F (A y)) (sourceChargeEnergy_resolution F)
  simp only [add_apply,map_add] at source
  rw [←source]
  abel

def sourceTemporalSpectralPair (F : GaussUnitaryHistory.Index) (x y : H) : ℂ :=
  -inner ℂ x (sourceTemporalWeightReader F (sourceEqualProjection F sourceActualGaussCharge y))-
    sourceOffEnergyConfigurationRead F ((sourceTemporalWeightReader F).adjoint x) y-
    inner ℂ x (sourceTemporalWeightReader F (sourceFirstDifference y))+
    inner ℂ x (sourceTemporalFrameNormal F y)

theorem sourceTemporalSpectralPair_return (F : GaussUnitaryHistory.Index) (x y : H) :
    inner ℂ x (sourceTemporalChargeReader F y)=sourceTemporalSpectralPair F x y := by
  rw [sourceTemporalChargeReader_spectral]
  simp only [inner_add_right,inner_sub_right,inner_neg_right,sourceTemporalSpectralPair]
  rw [←sourceOffEnergyConfigurationRead_return,ContinuousLinearMap.adjoint_inner_left]

