private theorem unit_sandwich (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (L R : H→L[ℂ]H) (left : q.z.im≠0) (right : q.w.im≠0) :
    sourceUnitRead q sL eL sR eR (L*sourceTemporalChargeReader q.F*R)=
      sourceActualLegNormalization q sL eL sR eR*
        ((sourceActualChargedRestEnergy sL:ℂ)-q.z)*((sourceActualChargedRestEnergy sR:ℂ)-q.w)*
        sourceTemporalSpectralPair q.F
          ((jointResolvent 0 q.F q.z 0*L).adjoint (sourceChargedGaussPrepared q.epsilon q.precision sL eL))
          ((R*jointResolvent 0 q.F q.w 0) (sourceChargedGaussPrepared q.epsilon q.precision sR eR)) := by
  rw [sourceUnitRead_original,sourceActualUnitLegRead_vertex q sL eL sR eR left right]
  congr 1
  have pair:=sourceTemporalSpectralPair_return q.F
    ((jointResolvent 0 q.F q.z 0*L).adjoint (sourceChargedGaussPrepared q.epsilon q.precision sL eL))
    ((R*jointResolvent 0 q.F q.w 0) (sourceChargedGaussPrepared q.epsilon q.precision sR eR))
  rw [ContinuousLinearMap.adjoint_inner_left] at pair
  simpa only [sourceQuantumChargedRead,ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.apply_apply,innerSL_apply_apply,mul_apply_eq_comp] using pair

/-- Independently normalized external legs read the computed temporal source, including all raw-frame and normal-order terms. -/
theorem sourceTemporalUnitReader_return (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (left : q.z.im≠0) (right : q.w.im≠0) :
    sourceActualUnitLegRead q sL eL sR eR (sourceTemporalChargeReader q.F)=
      sourceActualLegNormalization q sL eL sR eR*
        ((sourceActualChargedRestEnergy sL:ℂ)-q.z)*((sourceActualChargedRestEnergy sR:ℂ)-q.w)*
        sourceTemporalSpectralPair q.F
          ((jointResolvent 0 q.F q.z 0).adjoint (sourceChargedGaussPrepared q.epsilon q.precision sL eL))
          (jointResolvent 0 q.F q.w 0 (sourceChargedGaussPrepared q.epsilon q.precision sR eR)) := by
  simpa only [one_mul,mul_one,sourceUnitRead_original] using
    unit_sandwich q sL eL sR eR 1 1 left right

/-- Both actual Green legs return the full native/matter/span/Y difference on the source-prepared ket. -/
theorem sourceTemporalPreparedDifference_return (q : PhysicalResponsePoint) (sR eR : Fin 2)
    (x : H) (right : q.w.im≠0) :
    inner ℂ x (sourceTemporalWeightReader q.F
      (sourceFirstDifference (jointResolvent 0 q.F q.w 0
        (sourceChargedGaussPrepared q.epsilon q.precision sR eR))))=
      sourceFirstMaterialDifferenceRead q.F
        ((jointResolvent 0 q.F q.w 0).adjoint ((sourceTemporalWeightReader q.F).adjoint x))
        (jointResolvent 0 q.F q.w 0 (sourceChargedGaussPrepared q.epsilon q.precision sR eR)) := by
  let J:=jointGenerator 0 q.F 0 0
  let G:=jointResolvent 0 q.F q.w 0
  have ward:=(paidFirstInverseWard%) J J G G sourceFirstDifference q.w q.w
    (sourceMaterialInverse_left 0 q.F q.w right) (sourceMaterialInverse_right 0 q.F q.w right)
  have zero : (q.w-q.w) • (G*sourceFirstDifference*G)=(0:H→L[ℂ]H) := by
    rw [sub_self]
    exact (ContinuousLinearMap.module : Module ℂ (H→L[ℂ]H)).zero_smul _
  rw [zero] at ward
  have vector:=congrArg (fun A : H→L[ℂ]H=>A (sourceChargedGaussPrepared q.epsilon q.precision sR eR)) ward
  simp only [zero_apply,add_apply,sub_apply,mul_apply_eq_comp,sourceFirstDifference_prepared,map_zero] at vector
  have move : sourceFirstDifference (G (sourceChargedGaussPrepared q.epsilon q.precision sR eR))=
      G ((J*sourceFirstDifference-sourceFirstDifference*J)
        (G (sourceChargedGaussPrepared q.epsilon q.precision sR eR))) := by
    have added:=congrArg (fun v : H=>v+sourceFirstDifference
      (G (sourceChargedGaussPrepared q.epsilon q.precision sR eR))) vector
    convert added using 1 <;> abel
  change inner ℂ x (sourceTemporalWeightReader q.F
    (sourceFirstDifference (G (sourceChargedGaussPrepared q.epsilon q.precision sR eR))))=_
  rw [move]
  let v:=G (sourceChargedGaussPrepared q.epsilon q.precision sR eR)
  let T:=J*sourceFirstDifference-sourceFirstDifference*J
  have weightPair:=(ContinuousLinearMap.adjoint_inner_left (sourceTemporalWeightReader q.F) (G (T v)) x).symm
  have greenPair:=(ContinuousLinearMap.adjoint_inner_left G (T v) ((sourceTemporalWeightReader q.F).adjoint x)).symm
  exact weightPair.trans (greenPair.trans (sourceFirstMaterialDifference_return q.F _ _))

/-- The temporal unit vertex consumes the computed actualQ spectral transfer and full GT material difference on the same two source Green legs. -/
theorem sourceTemporalUnitReader_material (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (left : q.z.im≠0) (right : q.w.im≠0) :
    sourceActualUnitLegRead q sL eL sR eR (sourceTemporalChargeReader q.F)=
      sourceActualLegNormalization q sL eL sR eR*
        ((sourceActualChargedRestEnergy sL:ℂ)-q.z)*((sourceActualChargedRestEnergy sR:ℂ)-q.w)*
        (-inner ℂ ((jointResolvent 0 q.F q.z 0).adjoint (sourceChargedGaussPrepared q.epsilon q.precision sL eL))
          (sourceTemporalWeightReader q.F (sourceEqualProjection q.F sourceActualGaussCharge
            (jointResolvent 0 q.F q.w 0 (sourceChargedGaussPrepared q.epsilon q.precision sR eR))))-
        sourceOffEnergyConfigurationRead q.F
          ((sourceTemporalWeightReader q.F).adjoint ((jointResolvent 0 q.F q.z 0).adjoint
            (sourceChargedGaussPrepared q.epsilon q.precision sL eL)))
          (jointResolvent 0 q.F q.w 0 (sourceChargedGaussPrepared q.epsilon q.precision sR eR))-
        sourceFirstMaterialDifferenceRead q.F
          ((jointResolvent 0 q.F q.w 0).adjoint ((sourceTemporalWeightReader q.F).adjoint
            ((jointResolvent 0 q.F q.z 0).adjoint (sourceChargedGaussPrepared q.epsilon q.precision sL eL))))
          (jointResolvent 0 q.F q.w 0 (sourceChargedGaussPrepared q.epsilon q.precision sR eR))+
        inner ℂ ((jointResolvent 0 q.F q.z 0).adjoint (sourceChargedGaussPrepared q.epsilon q.precision sL eL))
          (sourceTemporalFrameNormal q.F
            (jointResolvent 0 q.F q.w 0 (sourceChargedGaussPrepared q.epsilon q.precision sR eR)))) := by
  have base:=sourceTemporalUnitReader_return q sL eL sR eR left right
  have difference:=sourceTemporalPreparedDifference_return q sR eR
    ((jointResolvent 0 q.F q.z 0).adjoint (sourceChargedGaussPrepared q.epsilon q.precision sL eL)) right
  unfold sourceTemporalSpectralPair at base
  rw [difference] at base
  exact base

/-- Every temporal raw-reader insertion in the original physical four-term response now consumes the computed weighted source. -/
def sourceTemporalUnitSandwich (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) (L R : H→L[ℂ]H) : ℂ :=
  sourceActualLegNormalization q sL eL sR eR*
    ((sourceActualChargedRestEnergy sL:ℂ)-q.z)*((sourceActualChargedRestEnergy sR:ℂ)-q.w)*
    sourceTemporalSpectralPair q.F
      ((jointResolvent 0 q.F q.z 0*L).adjoint (sourceChargedGaussPrepared q.epsilon q.precision sL eL))
      ((R*jointResolvent 0 q.F q.w 0) (sourceChargedGaussPrepared q.epsilon q.precision sR eR))

def sourceTemporalTimeResponse (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) (l : Fin 4) (age : ℝ) : ℂ :=
  -sourceTemporalUnitSandwich q sL eL sR eR
    (sourcePolarizationAxisTime q (q.p+q.k) l (-age)*jointResolvent (q.p+q.k) q.F q.z 0)
    (jointResolvent q.p q.F q.w 0*physicalTime q.p q.F age 0)-
  sourceTemporalUnitSandwich q sL eL sR eR
    (physicalTime (q.p+q.k) q.F (-age) 0*
      (-(jointResolvent (q.p+q.k) q.F q.z 0*sourcePolarizationMaterialCurrent (sourceEnergyAxisField 1 l) (q.p+q.k) q.F*
        jointResolvent (q.p+q.k) q.F q.z 0)))
    (jointResolvent q.p q.F q.w 0*physicalTime q.p q.F age 0)-
  sourceTemporalUnitSandwich q sL eL sR eR
    (physicalTime (q.p+q.k) q.F (-age) 0*jointResolvent (q.p+q.k) q.F q.z 0)
    ((-(jointResolvent q.p q.F q.w 0*sourcePolarizationMaterialCurrent (sourceEnergyAxisField 1 l) q.p q.F*
      jointResolvent q.p q.F q.w 0))*physicalTime q.p q.F age 0)-
  sourceTemporalUnitSandwich q sL eL sR eR
    (physicalTime (q.p+q.k) q.F (-age) 0*jointResolvent (q.p+q.k) q.F q.z 0)
    (jointResolvent q.p q.F q.w 0*sourcePolarizationAxisTime q q.p l age)

theorem sourceTemporalTimeResponse_return (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (l : Fin 4) (age : ℝ) (left : q.z.im≠0) (right : q.w.im≠0) :
    sourceUnitTimeSlope q sL eL sR eR (sourceEnergyAxisField 1 0) (sourceEnergyAxisField 1 l) age=
      sourceTemporalTimeResponse q sL eL sR eR l age := by
  have reader : sourcePolarizationAxisReader q.p q.F 0=sourceTemporalChargeReader q.F :=
    (sourcePolarizationAxis_reader q.p q.F 0).symm.trans (sourceTemporalChargeReader_original q.p q.F)
  have sandwich (L R : H→L[ℂ]H) :
      sourceUnitRead q sL eL sR eR (L*sourceTemporalChargeReader q.F*R)=
        sourceTemporalUnitSandwich q sL eL sR eR L R :=
    unit_sandwich q sL eL sR eR L R left right
  rw [sourceGaussFirstAxis_timeReturn]
  simp only [sourceGaussFirstAxisTime,reader,sourceTemporalTimeResponse,←sandwich,mul_assoc]

theorem sourceTemporalTimeResponse_bound (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (l : Fin 4) (eta age : ℝ) (positive : 0<eta) (future : 0≤age) (left : q.z.im≠0) (right : q.w.im≠0) :
    ‖sourceTemporalTimeResponse q sL eL sR eR l age‖ ≤
      fiveCoefficient q (sourceEnergyAxisField 1 0) (sourceEnergyAxisField 1 l) eta*Real.exp (4*eta*age) := by
  rw [←sourceTemporalTimeResponse_return q sL eL sR eR l age left right]
  exact sourceUnitTimeSlope_bound q sL eL sR eR _ _ eta age positive future left right

