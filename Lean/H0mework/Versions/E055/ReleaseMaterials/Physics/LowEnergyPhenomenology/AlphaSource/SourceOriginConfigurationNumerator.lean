/-- The actual colour contact has no coframe component, while the original coframe still weights every density read. -/
theorem sourceOriginDeviation_coframe (z : SourceCoordinateSlice) : (sourceModeDeviation z).1=0 := by
  unfold sourceModeDeviation stateContact
  change ((1:ℝ) • nativeFrameGenerator (Fin.castAdd 6 (2:Fin 3)))*(sourceState z-sourceReferenceState).1=0
  have generator : nativeFrameGenerator (Fin.castAdd 6 (2:Fin 3))=0:=rfl
  rw [generator,smul_zero,zero_mul]

/-- Full Gauss configuration connection deviations enter the original colour commutator. -/
theorem sourceOriginDeviation_connection (z : SourceCoordinateSlice) (mu : Fin 4) :
    (sourceModeDeviation z).2.1 mu=
      nativePrimal (colorGenerator 2)*(familyConnection z mu-sourceReferenceState.2.1 mu)-
        (familyConnection z mu-sourceReferenceState.2.1 mu)*nativePrimal (colorGenerator 2) := by
  unfold sourceModeDeviation stateContact sourceState
  have generator : nativeMatterGenerator (Fin.castAdd 6 (2:Fin 3))=nativePrimal (colorGenerator 2):=rfl
  change (1:ℝ) • (nativeMatterGenerator (Fin.castAdd 6 (2:Fin 3))*
    (familyConnection z mu-sourceReferenceState.2.1 mu)-
      (familyConnection z mu-sourceReferenceState.2.1 mu)*nativeMatterGenerator (Fin.castAdd 6 (2:Fin 3)))=_
  rw [generator,one_smul]

/-- The actual scalar deviation remains the original repaired Yukawa matrix contact. -/
theorem sourceOriginDeviation_scalar (z : SourceCoordinateSlice) :
    (sourceModeDeviation z).2.2=
      nativePrimal (colorGenerator 2)*(familyScalar z-sourceReferenceState.2.2)-
        (familyScalar z-sourceReferenceState.2.2)*nativePrimal (colorGenerator 2) := by
  unfold sourceModeDeviation stateContact sourceState
  have generator : nativeMatterGenerator (Fin.castAdd 6 (2:Fin 3))=nativePrimal (colorGenerator 2):=rfl
  change (1:ℝ) • (nativeMatterGenerator (Fin.castAdd 6 (2:Fin 3))*(familyScalar z-sourceReferenceState.2.2)-
    (familyScalar z-sourceReferenceState.2.2)*nativeMatterGenerator (Fin.castAdd 6 (2:Fin 3)))=_
  rw [generator,one_smul]

/-- This is the original material commutator and original configuration deviation after the same configuration integral and finiteRiesz map. -/
def sourceOriginConfigurationReader (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) : SourceOp :=
  (4*Complex.I) • sourceQuantumCommReader p F-sourceDeviationReader p F

/-- Noether material and deviation are generated by the same original mode, with its original gauge scale. -/
theorem sourceOriginConfigurationReader_mode (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) :
    sourceOriginConfigurationReader p F=
      (-(gaugeScale/2:ℝ):ℂ) • (PreparationVacuumRawJointFeedback.rawReader (gaugeField 1 0) p F 0-
        PreparationVacuumRawJointFeedback.rawReader (gaugeField 2 1) p F 0) := by
  have original:=sourceNativeReader_mode p F
  rw [sourceNativeReader_quantum] at original
  unfold sourceOriginConfigurationReader
  rw [original]
  abel

/-- Both independent original full Green inverses and the original source projectors act on the computed configuration numerator. -/
def sourceOriginConfigurationBase (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum) : SourceOp :=
  sourceProjection*(jointResolvent pL q.F q.z 0*sourceOriginConfigurationReader pR q.F*
    jointResolvent pR q.F q.w 0)*sourceProjection

theorem sourceOriginConfigurationBase_mode (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum) :
    sourceOriginConfigurationBase q pL pR=
      (-(gaugeScale/2:ℝ):ℂ) • (sourceFullInitialBase q pL pR (gaugeSlot 1 0)-
        sourceFullInitialBase q pL pR (gaugeSlot 2 1)) := by
  unfold sourceOriginConfigurationBase
  rw [sourceOriginConfigurationReader_mode]
  unfold sourceFullInitialBase rawInitial
  rw [sourcePhysicalMaterialPoint_left]
  change sourceProjection*(jointResolvent pL q.F q.z 0*
    ((-(gaugeScale/2:ℝ):ℂ) • (PreparationVacuumRawJointFeedback.rawReader (gaugeField 1 0) pR q.F 0-
      PreparationVacuumRawJointFeedback.rawReader (gaugeField 2 1) pR q.F 0))*jointResolvent pR q.F q.w 0)*sourceProjection=
    (-(gaugeScale/2:ℝ):ℂ) •
      (sourceProjection*(jointResolvent pL q.F q.z 0*PreparationVacuumRawJointFeedback.rawReader (gaugeField 1 0) pR q.F 0*
        jointResolvent pR q.F q.w 0)*sourceProjection-
       sourceProjection*(jointResolvent pL q.F q.z 0*PreparationVacuumRawJointFeedback.rawReader (gaugeField 2 1) pR q.F 0*
        jointResolvent pR q.F q.w 0)*sourceProjection)
  simp only [mul_smul_comm,smul_mul_assoc,mul_sub,sub_mul,smul_sub]

/-- The actual C0 equal-energy and zero-velocity angular/material projectors remain in their original order. -/
def sourceOriginConfigurationStatic (q : PhysicalResponsePoint) (n : PhysicalMomentum) : SourceOp :=
  sourceResonanceProjection q.F n 0*sourceEqualProjection q.F (sourceOriginConfigurationBase q 0 0)

theorem sourceOriginConfigurationStatic_mode (q : PhysicalResponsePoint) (n : PhysicalMomentum) :
    sourceOriginConfigurationStatic q n=
      (-(gaugeScale/2:ℝ):ℂ) • (sourceStaticGauge q n 1 0-sourceStaticGauge q n 2 1) := by
  unfold sourceOriginConfigurationStatic
  rw [sourceOriginConfigurationBase_mode]
  simp only [map_smul,map_sub,mul_smul_comm,mul_sub,sourceStaticGauge]

theorem sourceOriginConfigurationStatic_read (q : PhysicalResponsePoint) (n : PhysicalMomentum)
    (l r : RestStateIndex) :
    sourcePoleRead q.epsilon q.precision 0 0 l r (sourceOriginConfigurationStatic q n)=
      ((gaugeScale/2:ℝ):ℂ)*(sourceStaticGaugeCurrent q n l r 1 0-sourceStaticGaugeCurrent q n l r 2 1) := by
  rw [sourceOriginConfigurationStatic_mode]
  simp only [map_smul,map_sub,sourceStaticGaugeCurrent,smul_eq_mul]
  ring

/-- The scale is the original action-mode coefficient; no new coupling or terminal normalization is supplied. -/
def sourceOriginConfigurationAmplitude (q : PhysicalResponsePoint) (n : PhysicalMomentum)
    (l r : RestStateIndex) : ℂ :=
  ((3/10:ℂ)*rootTwo)*(((gaugeScale/2:ℝ):ℂ)⁻¹)*
    sourcePoleRead q.epsilon q.precision 0 0 l r (sourceOriginConfigurationStatic q n)

/-- The complete remaining native-simple numerator is read from its same whole-configuration Noether material and deviation. -/
theorem sourceNativeSimple_configuration (q : PhysicalResponsePoint) (n : PhysicalMomentum)
    (l r : RestStateIndex) (left : q.z.im≠0) (right : q.w.im≠0) :
    sourceNativeSimple q n l r=sourceOriginPair (sourceOriginConfigurationAmplitude q n l r) := by
  rw [sourceNativeSimple,sourceCurrentSimple_zero,sourceStaticCurrent_all_zero q n l r left right]
  simp only [Matrix.mulVec_zero,add_zero]
  congr 1
  rw [sourceOriginConfigurationAmplitude,sourceOriginConfigurationStatic_read]
  have nonzero : ((gaugeScale/2:ℝ):ℂ)≠0:=Complex.ofReal_ne_zero.mpr
    (div_ne_zero gaugeScale_pos.ne' (by norm_num))
  field_simp [nonzero]

