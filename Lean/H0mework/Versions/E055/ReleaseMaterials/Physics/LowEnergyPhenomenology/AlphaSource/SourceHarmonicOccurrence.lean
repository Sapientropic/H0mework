def sourceModeTransfer (k : PhysicalMomentum) : Fin 4→PhysicalMomentum := ![-k,k,-k,k]

/-- Read the field wave directly from its source transfer, so causal-domain proof data never crosses a double-negation cast. -/
def sourceModeWave (k : PhysicalMomentum) (i : Fin 4) : PhysicalMomentum := -sourceModeTransfer k i

theorem sourceModeWave_actual (k : PhysicalMomentum) : sourceModeWave k=![k,-k,k,-k] := by
  funext i
  fin_cases i <;> simp [sourceModeWave,sourceModeTransfer]

/-- All fields are produced from source preparation parameters on one shared spatial mode and current window. -/
structure SourceHarmonicOccurrence where
  wave : PhysicalMomentum
  q : Fin 4→PhysicalResponsePoint
  sourceLeft : Fin 4→Fin 2 × Fin 2
  sourceRight : Fin 4→Fin 2 × Fin 2
  T : ℝ
  future : 0≤T
  frequency : (i : Fin 4)→CausalFrequency (sourceModeWave wave i)
  nonrealL : ∀i,(q i).z.im≠0
  nonrealR : ∀i,(q i).w.im≠0

/-- Momentum parameters are generated from the actual signed source mode, not related by an external equality premise. -/
def sourceHarmonicLeg (s : SourceHarmonicOccurrence) (i : Fin 4) : SourceUnitFieldLeg where
  q := {s.q i with k := sourceModeTransfer s.wave i}
  sideL := (s.sourceLeft i).1
  edgeL := (s.sourceLeft i).2
  sideR := (s.sourceRight i).1
  edgeR := (s.sourceRight i).2
  T := s.T
  future := s.future
  frequency := s.frequency i
  nonrealL := s.nonrealL i
  nonrealR := s.nonrealR i

def sourceHarmonicField (s : SourceHarmonicOccurrence) (i : Fin 4) : Fin 289→ℂ :=
  sourceUnitCompleteField (sourceHarmonicLeg s i)

def sourceHarmonicProfile (s : SourceHarmonicOccurrence) (i : Fin 4) (x : Position) : Fin 289→ℂ :=
  phase (sourceModeWave s.wave i) x • sourceHarmonicField s i

theorem sourceHarmonicField_point (s : SourceHarmonicOccurrence) (i : Fin 4) :
    (sourceUnitFieldPoint (sourceHarmonicLeg s i)).val=
      fixedMomentum (sourceModeWave s.wave i) (s.frequency i).val := rfl

/-- The actual source equation, raw forcing and null-row supplement remain on each generated signed harmonic. -/
theorem sourceHarmonicField_equation (s : SourceHarmonicOccurrence) (i : Fin 4) :
    originalJacobi (fixedMomentum (sourceModeWave s.wave i) (s.frequency i).val)*ᵥsourceHarmonicField s i=
      sourceUnitRawForcing (sourceHarmonicLeg s i)+sourceUnitConstraintSupplement (sourceHarmonicLeg s i) := by
  rw [←sourceHarmonicField_point s i]
  exact sourceUnitCompleteField_equation (sourceHarmonicLeg s i)

/- Consume the actual original fullfield complex-linear and bilinear coefficient producers. -/
open Lean Elab Term in
elab "paidHarmonicCoefficient% " id:ident : term => do
  let wanted := `LowEnergy.PreparationPhysicalFinitePoleVertices ++ id.getId
  let names := (← getEnv).constants.toList.filterMap fun (name,_) =>
    if name.toString.startsWith "_private.H0mework.Versions.E055.ReleaseMaterials.Physics.LowEnergyPhenomenology.AlphaSource.SourceFinitePoleCoefficients." && privateToUserName name == wanted then some name else none
  match names with
  | [name] =>
    logInfo m!"Original private payer: {name}"
    return mkConst name
  | _ => throwError "Expected unique SourceFinitePoleCoefficients payer for {wanted}"

private abbrev densityModeSource := paidHarmonicCoefficient% density_source
private abbrev frequencyModeSource := paidHarmonicCoefficient% frequency_source
private abbrev mixedModeSource := paidHarmonicCoefficient% mixed_source

theorem sourceHarmonic_phase_add (k ell : PhysicalMomentum) (x : Position) :
    phase (k+ell) x=phase k x*phase ell x := by
  simp only [phase_physical,Pi.add_apply,add_mul,Finset.sum_add_distrib,Complex.ofReal_add,Complex.exp_add]

/-- The full source field profile itself generates the density and frequency character rows. -/
theorem sourceHarmonicProfile_coefficients (s : SourceHarmonicOccurrence) (i j : Fin 4) (x : Position) :
    complexCoefficients (originalComplexDirection (sourceHarmonicProfile s i x)) j=
      phase (sourceModeWave s.wave i) x • complexCoefficients (originalComplexDirection (sourceHarmonicField s i)) j ∧
    complexFrequencyCoefficients (originalComplexDirection (sourceHarmonicProfile s i x)) j=
      phase (sourceModeWave s.wave i) x • complexFrequencyCoefficients (originalComplexDirection (sourceHarmonicField s i)) j := by
  constructor
  · simp only [sourceHarmonicProfile,densityModeSource,map_smul]
  · simp only [sourceHarmonicProfile,frequencyModeSource,map_smul]

/-- The complete mixed source contact carries the product character, including every fullfield cross. -/
theorem sourceHarmonicProfile_mixed (s : SourceHarmonicOccurrence) (i j row : Fin 4) (x : Position) :
    complexMixedCoefficients (originalComplexDirection (sourceHarmonicProfile s i x))
      (originalComplexDirection (sourceHarmonicProfile s j x)) row=
      phase (sourceModeWave s.wave i+sourceModeWave s.wave j) x •
        complexMixedCoefficients (originalComplexDirection (sourceHarmonicField s i))
          (originalComplexDirection (sourceHarmonicField s j)) row := by
  simp only [sourceHarmonicProfile,mixedModeSource,map_smul,LinearMap.smul_apply,smul_smul,sourceHarmonic_phase_add]
  rw [mul_comm (phase (sourceModeWave s.wave j) x) (phase (sourceModeWave s.wave i) x)]

/-- All four fullfield frequency rows act by the physical spatial character and by its precise Fourier translation. -/
theorem sourceHarmonicField_frequency (s : SourceHarmonicOccurrence) (i : Fin 4) (j : Fin 4) (v : FullMatterL2) :
    let M:=complexFrequencyCoefficients (originalComplexDirection (sourceHarmonicField s i)) j
    (transfer (sourceModeWave s.wave i)*M.compLpL 2 volume : FullMatterL2→L[ℂ]FullMatterL2) v=ᵐ[volume]
      (fun x=>phase (sourceModeWave s.wave i) x • M (v x)) ∧
    fourier ((transfer (sourceModeWave s.wave i)*M.compLpL 2 volume : FullMatterL2→L[ℂ]FullMatterL2) v)=ᵐ[volume]
      (fun x=>M (fourier v (x-frequencyShift (sourceModeWave s.wave i)))) := by
  dsimp only
  exact ⟨sourceHarmonic_row _ _ _,sourceHarmonic_row_fourier _ _ _⟩

theorem sourceHarmonicField_density (s : SourceHarmonicOccurrence) (i : Fin 4) (j : Fin 4) (v : FullMatterL2) :
    let M:=complexCoefficients (originalComplexDirection (sourceHarmonicField s i)) j
    (transfer (sourceModeWave s.wave i)*M.compLpL 2 volume : FullMatterL2→L[ℂ]FullMatterL2) v=ᵐ[volume]
      (fun x=>phase (sourceModeWave s.wave i) x • M (v x)) ∧
    fourier ((transfer (sourceModeWave s.wave i)*M.compLpL 2 volume : FullMatterL2→L[ℂ]FullMatterL2) v)=ᵐ[volume]
      (fun x=>M (fourier v (x-frequencyShift (sourceModeWave s.wave i)))) := by
  dsimp only
  exact ⟨sourceHarmonic_row _ _ _,sourceHarmonic_row_fourier _ _ _⟩

theorem sourceHarmonic_phase_star (k : PhysicalMomentum) (x : Position) :
    star (phase k x)=phase (-k) x := by
  rw [phase_physical,phase_physical]
  simp only [Complex.star_def,←Complex.exp_conj,map_mul,Complex.conj_ofReal,Complex.conj_I,
    Pi.neg_apply,neg_mul,Finset.sum_neg_distrib,Complex.ofReal_neg]
  congr 1
  ring

def sourceHarmonicTransfers (s : SourceHarmonicOccurrence) : TransferPair × TransferPair :=
  sourceUnitFieldTransfers (sourceHarmonicLeg s)

/-- The adjoint positive row and independent negative row carry the same generated reader wave. -/
theorem sourceHarmonic_reader_phase (s : SourceHarmonicOccurrence) (x : Position) (j : Fin 4) :
    (2:ℂ)⁻¹ •
      (phase (-s.wave) x • complexCoefficients (sourceHarmonicTransfers s).1.negative j+
        (phase s.wave x • shiftCoefficients (complexCoefficients (sourceHarmonicTransfers s).1.positive) (-s.wave) j).adjoint)=
      phase (-s.wave) x • realReaderCoefficients (sourceHarmonicTransfers s).1 s.wave j := by
  rw [map_smulₛₗ,starRingEnd_apply,sourceHarmonic_phase_star]
  simp only [realReaderCoefficients,adjointCoefficients,smul_add,smul_smul]
  module

/-- The negative force's adjoint has the positive actual wave required by the reverse ordering. -/
theorem sourceHarmonic_negative_phase (s : SourceHarmonicOccurrence) (x : Position) (j : Fin 4) :
    (phase (-s.wave) x • complexFrequencyCoefficients (sourceHarmonicTransfers s).2.negative j).adjoint=
      phase s.wave x • adjointCoefficients (complexFrequencyCoefficients (sourceHarmonicTransfers s).2.negative) j := by
  rw [map_smulₛₗ,starRingEnd_apply,sourceHarmonic_phase_star,neg_neg]
  rfl

