  sourceEqualProjection sourceMasterCurrent sourceFullCurrentResidue sourceStaticCurrent sourcePoleRead

/-- The original Sylvester equation and actual upper-sector gauge cancellation generate the initial gauge-column nullspace. -/
theorem sourceFullInitialUpper_gauge_zero (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum)
    (mu : Fin 4) (a : Fin 12) (left : q.z.im≠0) (right : q.w.im≠0) :
    sourceFullInitialUpper q pL pR (gaugeSlot mu a)=0 := by
  have source:=sourceFullHalfUpper_sylvester q pL pR (gaugeSlot mu a) (1:ℂ) (by norm_num)
  rw [sourceFullHalfUpper_gauge_zero q pL pR mu a 1 (by norm_num) left right,map_zero] at source
  exact source.symm

/-- Every one of the original 48 gauge columns has zero complete retainer seed. -/
theorem sourceRetainerSeed_gauge_zero (q : PhysicalResponsePoint) (mu : Fin 4) (a : Fin 12)
    (left : q.z.im≠0) (right : q.w.im≠0) : sourceRetainerSeed q (gaugeSlot mu a)=0 := by
  simp only [sourceRetainerSeed,sourceFullInitialUpper_gauge_zero q 0 0 mu a left right,map_zero,zero_mul]

theorem sourceMasterCurrent_gauge_zero (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ)
    (l r : RestStateIndex) (mu : Fin 4) (a : Fin 12) (left : q.z.im≠0) (right : q.w.im≠0) :
    sourceMasterCurrent q n zeta l r (gaugeSlot mu a)=0 := by
  simp only [sourceMasterCurrent,sourceRetainerSeed_gauge_zero q mu a left right,mul_zero,map_zero]

theorem sourceFullCurrentResidue_gauge_zero (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ)
    (causal : 0<zeta.re) (l r : RestStateIndex) (mu : Fin 4) (a : Fin 12)
    (left : q.z.im≠0) (right : q.w.im≠0) : sourceFullCurrentResidue q n zeta l r (gaugeSlot mu a)=0 := by
  rw [sourceFullCurrentResidue_square q n zeta causal]
  simp only [sourceRetainerSeed_gauge_zero q mu a left right,mul_zero,map_zero]

theorem sourceStaticCurrent_gauge_zero (q : PhysicalResponsePoint) (n : PhysicalMomentum)
    (l r : RestStateIndex) (mu : Fin 4) (a : Fin 12) (left : q.z.im≠0) (right : q.w.im≠0) :
    sourceStaticCurrent q n l r (gaugeSlot mu a)=0 := by
  rw [sourceStaticCurrent_seed]
  simp only [sourceRetainerSeed_gauge_zero q mu a left right,mul_zero,map_zero]

private theorem gauge_contract {E : Type*} [AddCommMonoid E] [Module ℂ E]
    (mu : Fin 4) (a : Fin 12) (v : Fin 289→E) :
    (∑j : Fin 289,(gaugeField mu a j:ℂ) • v j)=v (gaugeSlot mu a) := by
  have value (j : Fin 289) : (gaugeField mu a j:ℂ)=(if j=gaugeSlot mu a then 1 else 0) := by
    by_cases same : j=gaugeSlot mu a
    · simp [gaugeField,same]
    · simp [gaugeField,same]
  simp only [value,ite_smul,one_smul,zero_smul,Finset.sum_ite_eq',Finset.mem_univ,ite_true]

private theorem phase_contract {E : Type*} [AddCommMonoid E] [Module ℂ E]
    (mu : Fin 4) (v : Fin 289→E) :
    (∑j : Fin 289,(sourcePhaseGaugeField mu j:ℂ) • v j)=
      ∑a : Fin 12,(rawCoordinates sourcePhaseGaugeLie a:ℂ) • v (gaugeSlot mu a) := by
  simp only [sourcePhaseGaugeField,Finset.sum_apply,Pi.smul_apply,smul_eq_mul,Complex.ofReal_sum,Complex.ofReal_mul,
    Finset.sum_smul,←smul_smul]
  rw [Finset.sum_comm]
  simp only [←Finset.smul_sum,gauge_contract]

/-- The actual native phase-gauge field consumes the zero retainer seed, with its source Lie coefficients unchanged. -/
theorem sourcePhaseGaugeSeed_zero (q : PhysicalResponsePoint) (mu : Fin 4)
    (left : q.z.im≠0) (right : q.w.im≠0) :
    (∑j : Fin 289,(sourcePhaseGaugeField mu j:ℂ) • sourceRetainerSeed q j)=0 := by
  rw [phase_contract]
  simp only [sourceRetainerSeed_gauge_zero q _ _ left right,smul_zero,Finset.sum_const_zero]

theorem sourcePhaseGaugeMaster_zero (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ)
    (l r : RestStateIndex) (mu : Fin 4) (left : q.z.im≠0) (right : q.w.im≠0) :
    (∑j : Fin 289,(sourcePhaseGaugeField mu j:ℂ)*sourceMasterCurrent q n zeta l r j)=0 := by
  have source:=phase_contract mu (sourceMasterCurrent q n zeta l r)
  simp only [smul_eq_mul,sourceMasterCurrent_gauge_zero q n zeta l r _ _ left right,mul_zero,Finset.sum_const_zero] at source
  exact source

theorem sourcePhaseGaugeDouble_zero (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ)
    (causal : 0<zeta.re) (l r : RestStateIndex) (mu : Fin 4) (left : q.z.im≠0) (right : q.w.im≠0) :
    (∑j : Fin 289,(sourcePhaseGaugeField mu j:ℂ)*sourceFullCurrentResidue q n zeta l r j)=0 := by
  have source:=phase_contract mu (sourceFullCurrentResidue q n zeta l r)
  simp only [smul_eq_mul,sourceFullCurrentResidue_gauge_zero q n zeta causal l r _ _ left right,mul_zero,Finset.sum_const_zero] at source
  exact source

