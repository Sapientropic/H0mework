  | _=>throwError "Expected unique original SourceNumberHistory payer for {wanted}; actual owners: {(←getEnv).constants.toList.filterMap (fun (name,_)=>if privateToUserName name==wanted then some name else none)}"

private theorem uncut_range (f : Field289) (phi : CanonicalGradedLocalCurrent.Localizer) (r : ℝ) :
    sourceN1Projection*uncutOperator f phi r*sourceN1Projection=uncutOperator f phi r*sourceN1Projection := by
  let A:=uncutOperator f phi r
  have raised : sourceExcitedProjection*A*sourceProjection=A*sourceProjection:=
    (paidTemporalN1Y% uncutOperator_N1G0_range) f phi r
  have zero : A*sourceExcitedProjection=0:=(paidTemporalN1Y% uncutOperator_N1G1_zero) f phi r
  calc
    _=sourceN1Projection*(A*sourceProjection+A*sourceExcitedProjection) := by
      rw [show sourceN1Projection=sourceProjection+sourceExcitedProjection from (by delta sourceN1Projection; rfl)]
      simp only [A,mul_add,mul_assoc]
    _=sourceN1Projection*(sourceExcitedProjection*A*sourceProjection) := by rw [zero,add_zero,raised]
    _=(sourceN1Projection*sourceExcitedProjection)*A*sourceProjection := by simp only [mul_assoc]
    _=A*sourceProjection := by rw [excited_in_N1,raised]
    _=_ := by rw [sourceN1Projection,mul_add,zero,add_zero]

private theorem range_derivative {A : Type*} [NormedRing A] [NormedAlgebra ℝ A]
    (P : A) (f : ℝ→A) (B : A) (t : ℝ) (derivative : HasDerivAt f B t)
    (range : ∀r,P*f r*P=f r*P) : P*B*P=B*P := by
  have first : HasDerivAt (fun r=>P*f r*P) (P*B*P) t :=
    (derivative.const_mul P).mul_const P
  have second : HasDerivAt (fun r=>f r*P) (B*P) t:=derivative.mul_const P
  have same : (fun r=>P*f r*P)=(fun r=>f r*P):=funext range
  rw [same] at first
  exact first.unique second

/-- Full uncut scalar-Y first variation preserves the genuine number-one range by its original configuration derivative. -/
theorem sourceTemporalYCurrent_range (f : Field289) (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) (r : ℝ) :
    sourceN1Projection*sourceYJet f p F none 1 r*sourceN1Projection=sourceYJet f p F none 1 r*sourceN1Projection := by
  apply range_derivative sourceN1Projection _ _ r (sourceY_first f p F none r)
  intro s
  exact uncut_range f (finiteRetainer p F) s

private theorem assembly_projection (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (entries : PhysicalBasisIndex p F→PhysicalBasisIndex p F→ℂ) (h : Label) :
    Commute (projection h) (sourceAssembly p F entries) := by
  classical
  change projection h*sourceAssembly p F entries=sourceAssembly p F entries*projection h
  simp only [sourceAssembly,Finset.mul_sum,Finset.sum_mul,mul_smul_comm,smul_mul_assoc]
  apply Finset.sum_congr rfl
  intro g _
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  rw [frame_rankOne]
  apply congrArg (fun A : H→L[ℂ]H=>entries i j • A)
  exact (sandwich_commutes _ _ _ (if h=g then (1:ℂ) else 0)
    (by by_cases same:h=g <;> simp [NativeHistoryGrade.projection_product,same])
    (by
      by_cases same:h=g
      · subst h; simp [NativeHistoryGrade.projection_product]
      · simp [NativeHistoryGrade.projection_product,same,Ne.symm same])).eq

private theorem assembly_range (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (entries : PhysicalBasisIndex p F→PhysicalBasisIndex p F→ℂ) :
    sourceN1Projection*sourceAssembly p F entries*sourceN1Projection=sourceAssembly p F entries*sourceN1Projection := by
  have block : Commute sourceN1Projection (sourceAssembly p F entries) := by
    simpa only [sourceN1Projection,sourceProjection,sourceExcitedProjection] using
      (assembly_projection p F entries CanonicalGradedCurrent.sourceLabel).add_left
        (assembly_projection p F entries sourceExcitedLabel)
  rw [block.eq,mul_assoc,sourceN1Projection_idempotent]

/-- The complete native/coframe/matter and retained-Y current preserves number one; its charge is not assumed zero. -/
theorem sourceTemporalCurrent_range (f : Field289) (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) (z : ℂ) :
    sourceN1Projection*jointCurrent p F z 0 f*sourceN1Projection=jointCurrent p F z 0 f*sourceN1Projection := by
  rw [jointCurrent_source]
  unfold PreparationVacuumUncutYukawa.sourceCurrent transportedCurrent
  simp only [mul_add,add_mul,assembly_range,sourceTemporalYCurrent_range]

/-- The real source time variation inherits this range through its original Duhamel integrand. -/
theorem sourceTemporalTimeSlope_range (f : Field289) (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) (t : ℝ) :
    sourceN1Projection*timeSlope f p F t*sourceN1Projection=timeSlope f p F t*sourceN1Projection := by
  let K : ℝ→H→L[ℂ]H:=fun s=>physicalTime p F s 0*((-Complex.I) • jointCurrent p F 0 0 f)*physicalTime p F (t-s) 0
  have middle : sourceN1Projection*((-Complex.I) • jointCurrent p F 0 0 f)*sourceN1Projection=
      ((-Complex.I) • jointCurrent p F 0 0 f)*sourceN1Projection := by
    simpa only [mul_smul_comm,smul_mul_assoc] using
      congrArg (fun A : H→L[ℂ]H=>(-Complex.I) • A) (sourceTemporalCurrent_range f p F 0)
  have point (s : ℝ) : sourceN1Projection*K s*sourceN1Projection=K s*sourceN1Projection :=
    product_range _ _ _ (product_range _ _ _ (actualTime_sourceN1_range p F s) middle)
      (actualTime_sourceN1_range p F (t-s))
  have timeContinuous : Continuous (fun s : ℝ=>physicalTime p F s 0) := by
    unfold physicalTime SourceFiniteUnitary.time
    fun_prop
  have integrable : IntervalIntegrable K volume 0 t:=
    ((timeContinuous.mul continuous_const).mul (timeContinuous.comp (continuous_const.sub continuous_id))).intervalIntegrable 0 t
  let right : (H→L[ℂ]H)→L[ℂ](H→L[ℂ]H):=(ContinuousLinearMap.mul ℂ (H→L[ℂ]H)).flip sourceN1Projection
  let both : (H→L[ℂ]H)→L[ℂ](H→L[ℂ]H):=right.comp (ContinuousLinearMap.mul ℂ (H→L[ℂ]H) sourceN1Projection)
  have first:=both.intervalIntegral_comp_comm integrable
  have second:=right.intervalIntegral_comp_comm integrable
  have integral : sourceN1Projection*(∫s in (0:ℝ)..t,K s)*sourceN1Projection=(∫s in (0:ℝ)..t,K s)*sourceN1Projection := by
    calc
      _=∫s in (0:ℝ)..t,both (K s) := first.symm
      _=∫s in (0:ℝ)..t,right (K s) := intervalIntegral.integral_congr (fun s _=>point s)
      _=_ := second
  simpa only [timeSlope,CanonicalGradedVariation.variation,CanonicalGradedVariation.variationBetween,
    zero_smul,add_zero,physicalTime,K] using integral

