private theorem product_range {R : Type*} [Ring R] (P A B : R)
    (ha : P*A*P=A*P) (hb : P*B*P=B*P) : P*(A*B)*P=(A*B)*P := by
  calc
    _=P*A*(B*P) := by simp only [mul_assoc]
    _=P*A*(P*B*P) := congrArg (fun X=>P*A*X) hb.symm
    _=(P*A*P)*B*P := by simp only [mul_assoc]
    _=(A*P)*B*P := congrArg (fun X=>X*B*P) ha
    _=A*(P*B*P) := by simp only [mul_assoc]
    _=A*(B*P) := congrArg (fun X=>A*X) hb
    _=_ := by simp only [mul_assoc]

private theorem excited_in_N1 : sourceN1Projection*sourceExcitedProjection=sourceExcitedProjection := by
  apply ContinuousLinearMap.ext
  exact sourceN1Projection_excited

/-- The original two inverse equations close the excited input sector without a charge or gap assumption. -/
theorem sourceTemporalExcitedGreen (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (z : ℂ) (nonreal : z.im≠0) :
    jointResolvent p F z 0*sourceExcitedProjection=
      sourceExcitedProjection*CanonicalPhysicalResolvent.finiteResolvent p F z := by
  let G:=jointResolvent p F z 0
  let B:=CanonicalPhysicalResolvent.finiteResolvent p F z
  let L:=jointGenerator p F 0 0-z • (1:H→L[ℂ]H)
  let C:=actualC p F-z • (1:H→L[ℂ]H)
  have l : G*L=1:=sourceMaterialInverse_left p F z nonreal
  have r : C*B=1 := by
    simpa only [C,B,actualC,CanonicalPhysicalResolvent.finiteResolvent] using
      FullYSourceResolventGraphSplice.resolvent_right _ (compression_selfAdjoint p F) z nonreal
  have generator:=congrArg (fun A : H→L[ℂ]H=>A*sourceExcitedProjection) (actualGenerator_source p F)
  have killed:=actualA_N1G1_zero p F
  simp only [add_mul,killed,add_zero] at generator
  have block:=(actualC_excitedProjection p F).eq
  have cross : L*sourceExcitedProjection=sourceExcitedProjection*C := by
    calc
      _=jointGenerator p F 0 0*sourceExcitedProjection-z • sourceExcitedProjection := by
        simp only [L,sub_mul,smul_mul_assoc,one_mul]
      _=actualC p F*sourceExcitedProjection-z • sourceExcitedProjection :=
        congrArg (fun A : H→L[ℂ]H=>A-z • sourceExcitedProjection) generator
      _=sourceExcitedProjection*actualC p F-z • sourceExcitedProjection :=
        congrArg (fun A : H→L[ℂ]H=>A-z • sourceExcitedProjection) block.symm
      _=_ := by simp only [C,mul_sub,mul_smul_comm,mul_one]
  change G*sourceExcitedProjection=sourceExcitedProjection*B
  calc
    _=G*sourceExcitedProjection*(C*B) := by rw [r,mul_one]
    _=G*(sourceExcitedProjection*C)*B := by simp only [mul_assoc]
    _=G*(L*sourceExcitedProjection)*B := congrArg (fun X=>G*X*B) cross.symm
    _=(G*L)*sourceExcitedProjection*B := by simp only [mul_assoc]
    _=_ := by rw [l,one_mul]

/-- Both actual number-one sectors, including the full retained-Y raised sector, are preserved by the actual material Green. -/
theorem sourceTemporalGreen_range (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (z : ℂ) (nonreal : z.im≠0) :
    sourceN1Projection*jointResolvent p F z 0*sourceN1Projection=
      jointResolvent p F z 0*sourceN1Projection := by
  have excited : sourceN1Projection*jointResolvent p F z 0*sourceExcitedProjection=
      jointResolvent p F z 0*sourceExcitedProjection := by
    rw [mul_assoc,sourceTemporalExcitedGreen p F z nonreal,←mul_assoc,excited_in_N1]
  calc
    _=sourceN1Projection*jointResolvent p F z 0*sourceProjection+
        sourceN1Projection*jointResolvent p F z 0*sourceExcitedProjection := by
      rw [show sourceN1Projection=sourceProjection+sourceExcitedProjection from (by delta sourceN1Projection; rfl),mul_add]
    _=jointResolvent p F z 0*sourceProjection+jointResolvent p F z 0*sourceExcitedProjection := by
      rw [actualResolvent_sourceN1_range p F z nonreal,excited]
    _=_ := by rw [sourceN1Projection,mul_add]

