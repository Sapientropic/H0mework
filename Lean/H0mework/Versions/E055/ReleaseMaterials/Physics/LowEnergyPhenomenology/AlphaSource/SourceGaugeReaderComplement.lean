/-- The original gauge slots occupy exactly their source-generated 48 coordinates. -/
theorem sourceGaugeSlot_range (j : Fin 289) :
    (9≤j.val ∧ j.val<57) ↔ ∃mu : Fin 4,∃a : Fin 12,gaugeSlot mu a=j := by
  constructor
  · intro h
    let mu : Fin 4:=⟨(j.val-9)/12,by omega⟩
    let a : Fin 12:=⟨(j.val-9)%12,by omega⟩
    refine ⟨mu,a,?_⟩
    apply Fin.ext
    dsimp [gaugeSlot,mu,a]
    omega
  · rintro ⟨mu,a,rfl⟩
    dsimp [gaugeSlot]
    omega

/-- This is a restriction of the actual full289 seed, retaining every nongauge column unchanged. -/
def sourceNonGaugeSeed (q : PhysicalResponsePoint) (j : Fin 289) : SourceOp :=
  if 9≤j.val ∧ j.val<57 then 0 else sourceRetainerSeed q j

theorem sourceRetainerSeed_nongauge (q : PhysicalResponsePoint) (left : q.z.im≠0) (right : q.w.im≠0)
    (j : Fin 289) : sourceRetainerSeed q j=sourceNonGaugeSeed q j := by
  unfold sourceNonGaugeSeed
  split_ifs with gauge
  · obtain ⟨mu,a,rfl⟩:=(sourceGaugeSlot_range j).mp gauge
    exact sourceRetainerSeed_gauge_zero q mu a left right
  · rfl

/-- The full original effective reader contracts the computed remaining seed; no field row or cross term is discarded. -/
def sourceNonGaugeNativeSeed (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ) (row : Fin 289) : SourceOp :=
  ∑j : Fin 289,sourceNativeReaderFirst (fixedMomentum n zeta) row j • sourceNonGaugeSeed q j

def sourceNonGaugeSlowSeed (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ) (i : Fin 3) : SourceOp :=
  ∑j : Fin 289,(slowFastFrame.transpose*sourceNativeReaderFirst (fixedMomentum n zeta))
    (fiveIndex ⟨i.val,by omega⟩) j • sourceNonGaugeSeed q j

theorem sourceMasterNative_nongauge (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ)
    (l r : RestStateIndex) (left : q.z.im≠0) (right : q.w.im≠0) (row : Fin 289) :
    sourceMasterNative q n zeta l r row=-Complex.I*sourcePoleRead q.epsilon q.precision 0 0 l r
      (sourcePinnedResolvent q.F n zeta*sourceNonGaugeNativeSeed q n zeta row) := by
  simp only [sourceMasterNative,sourceMasterCurrent,sourceNonGaugeNativeSeed,Matrix.mulVec,dotProduct,
    Finset.mul_sum,mul_smul_comm,map_sum,map_smul,smul_eq_mul,sourceRetainerSeed_nongauge q left right]
  apply Finset.sum_congr rfl
  intro j _
  ring

/-- The actual slow field coefficients contain only the generated nongauge seed, while the entire original reader matrix is preserved. -/
theorem sourceMasterSlow_nongauge (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ)
    (l r : RestStateIndex) (left : q.z.im≠0) (right : q.w.im≠0) (i : Fin 3) :
    sourceSlowRead (sourceMasterNative q n zeta l r) ⟨i.val,by omega⟩=
      -Complex.I*sourcePoleRead q.epsilon q.precision 0 0 l r
        (sourcePinnedResolvent q.F n zeta*sourceNonGaugeSlowSeed q n zeta i) := by
  simp only [sourceSlowRead,show i.val<3 from i.isLt,ite_true,sourceMasterNative,Matrix.mulVec_mulVec]
  simp only [sourceMasterCurrent,sourceNonGaugeSlowSeed,Matrix.mulVec,dotProduct,
    Finset.mul_sum,mul_smul_comm,map_sum,map_smul,smul_eq_mul,sourceRetainerSeed_nongauge q left right]
  apply Finset.sum_congr rfl
  intro j _
  ring

/-- This is the literal same-source causal master after the actual gauge-seed cancellation. -/
def sourceNonGaugeMasterChannel (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ)
    (l r : RestStateIndex) (i : Fin 3) : ℂ :=
  (sourceChargedDenominator n zeta i)⁻¹*(-Complex.I)*sourcePoleRead q.epsilon q.precision 0 0 l r
    (sourcePinnedResolvent q.F n zeta*sourceNonGaugeSlowSeed q n zeta i)

theorem sourceMasterChannel_nongauge (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ)
    (l r : RestStateIndex) (left : q.z.im≠0) (right : q.w.im≠0) (i : Fin 3) :
    sourceMasterChannel q n zeta l r i=sourceNonGaugeMasterChannel q n zeta l r i := by
  rw [sourceMasterChannel,sourceMasterSlow_nongauge q n zeta l r left right i,sourceNonGaugeMasterChannel]
  ring

/-- All original spatial/time reader mixing is generated as the actual linear momentum-frequency seed. -/
theorem sourceNonGaugeSlowSeed_split (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ) (i : Fin 3) :
    sourceNonGaugeSlowSeed q n zeta i=
      sourceNonGaugeSlowSeed q n 0 i+zeta • sourceNonGaugeSlowSeed q 0 1 i := by
  unfold sourceNonGaugeSlowSeed
  rw [sourceReaderFirst_static_split n zeta]
  simp only [Matrix.mul_add,Matrix.mul_smul,Matrix.add_apply,Matrix.smul_apply,Finset.smul_sum]
  rw [←Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro j _
  apply ContinuousLinearMap.ext
  intro x
  simp only [smul_apply,add_apply,smul_smul]
  change (_+zeta*_) • (sourceNonGaugeSeed q j x)=_ • (sourceNonGaugeSeed q j x)+(zeta*_) • (sourceNonGaugeSeed q j x)
  exact add_smul _ _ _

/-- Static double forcing retains precisely the same computed nongauge seeds and original full reader. -/
theorem sourceStaticNative_nongauge (q : PhysicalResponsePoint) (n : PhysicalMomentum)
    (l r : RestStateIndex) (left : q.z.im≠0) (right : q.w.im≠0) (i : Fin 3) :
    sourceSlowRead (sourceStaticNative q n l r) ⟨i.val,by omega⟩=
      Complex.I*sourcePoleRead q.epsilon q.precision 0 0 l r
        (sourceResonanceProjection q.F n 0*sourceNonGaugeSlowSeed q n 0 i) := by
  simp only [sourceStaticNative,sourceSlowRead,show i.val<3 from i.isLt,ite_true,Matrix.mulVec_mulVec]
  simp only [Matrix.mulVec,dotProduct,sourceStaticCurrent_seed,sourceNonGaugeSlowSeed,Finset.mul_sum,mul_smul_comm,
    map_sum,map_smul,smul_eq_mul,sourceRetainerSeed_nongauge q left right]
  apply Finset.sum_congr rfl
  intro j _
  ring

