private theorem coefficient_literal (a b c d : ℚ) :
    coefficientValue (⟨⟨a, b⟩, ⟨c, d⟩⟩ : SourceCoefficient) =
      (a : ℂ) + (b : ℂ) * rootTwo +
        ((c : ℂ) + (d : ℂ) * rootTwo) * rootFifteen := rfl

private theorem coefficient_rational (q : ℚ) :
    coefficientValue (⟨⟨q, 0⟩, ⟨0, 0⟩⟩ : SourceCoefficient) = (q : ℂ) := by
  rw [coefficient_literal]
  simp only [Rat.cast_zero, zero_mul, add_zero]

private theorem coefficient_two (q : ℚ) :
    coefficientValue (⟨⟨0, q⟩, ⟨0, 0⟩⟩ : SourceCoefficient) =
      (q : ℂ) * rootTwo := by
  rw [coefficient_literal]
  simp only [Rat.cast_zero, zero_mul, add_zero, zero_add]

private theorem coefficient_integer (z : ℤ) :
    coefficientValue (z : SourceCoefficient) = (z : ℂ) := by
  change coefficientMap (z : SourceCoefficient) = (z : ℂ)
  exact map_intCast coefficientMap z

private theorem coefficient_natural (n : ℕ) :
    coefficientValue (n : SourceCoefficient) = (n : ℂ) := by
  change coefficientMap (n : SourceCoefficient) = (n : ℂ)
  exact map_natCast coefficientMap n

private theorem coefficient_numeral (n : ℕ) [Nat.AtLeastTwo n] :
    coefficientValue (ofNat(n) : SourceCoefficient) = (ofNat(n) : ℂ) := by
  simpa only [Nat.cast_ofNat] using coefficient_natural (ofNat(n))

private theorem coefficient_negative (c : SourceCoefficient) :
    coefficientValue (-c) = -coefficientValue c := by
  change coefficientMap (-c) = -coefficientMap c
  exact map_neg coefficientMap c

private theorem coefficient_one : coefficientValue (1 : SourceCoefficient) = (1 : ℂ) :=
  coefficientMap.map_one

private theorem constant_powers_value (p : Fin 4 → ℂ) :
    (⟨0, 0, 0, 0⟩ : Powers).value p = 1 := by
  simp only [Powers.value, pow_zero, mul_one]

def sourceCurvatureOriginMatrix : Matrix (Fin 289) (Fin 289) ℂ := sourceMatrix sourceCurvatureOriginTerms 0

private theorem curvature_leading_zero : sourceCurvatureOriginMatrix * fullNativeOrigin = 0 := by
  rw [sourceCurvatureOriginMatrix, fullNativeOrigin_generated, ← productTerms_value]
  rw [normalization_equal (productTerms sourceCurvatureOriginTerms fullNativeOriginTerms) []
    (by decide +kernel) 0]
  rw [sourceMatrix_nil]

private theorem sourceMatrix_entry (ts : List SourceTerm) (p : Fin 4 → ℂ) (i j : Fin 289) :
    sourceMatrix ts p i j =
      (ts.map (fun a => if a.row = i ∧ a.column = j
        then coefficientValue a.coefficient * a.powers.value p else 0)).sum := by
  induction ts with
  | nil => simp [sourceMatrix]
  | cons a rest ih =>
    rw [sourceMatrix_cons, Matrix.add_apply, ih, List.map_cons, List.sum_cons]
    rw [SourceTerm.matrix, Matrix.single_apply]

private theorem entry_dite (P : Prop) [Decidable P] (V : ℂ)
    (A : P → ℂ) (B : (¬ P) → ℂ)
    (hA : ∀ h, V = A h) (hB : ∀ h, V = B h) :
    V = dite P A B := by
  by_cases h : P
  · rw [dif_pos h]; exact hA h
  · rw [dif_neg h]; exact hB h

theorem sourceCurvatureOrigin_generated (r : Fin 36) (c : Fin 289) :
    sourceCurvatureOriginMatrix (Fin.castLE (by decide) r) c =
      originalReader36 0 r c := by
  rw [show sourceCurvatureOriginMatrix = sourceMatrix sourceCurvatureOriginTerms 0 from rfl]
  rw [sourceMatrix_entry]
  conv_lhs =>
    simp only [sourceCurvatureOriginTerms, List.map_cons, List.map_nil, List.sum_cons,
      List.sum_nil, constant_powers_value, coefficient_rational, coefficient_two,
      mul_one, Fin.ext_iff, Fin.val_castLE]
    delta rootTwo
    norm_num
  delta originalReader36
  run_tac
    let goal ← Lean.Elab.Tactic.getMainGoal
    let target ← goal.getType
    let env ← Lean.getEnv
    let expanded ← Lean.Meta.deltaExpand target (Lean.Meta.isMatcherCore env)
    let next ← goal.replaceTargetDefEq expanded
    Lean.Elab.Tactic.replaceMainGoal [next]
  conv_rhs => norm_num
  repeat' (apply entry_dite <;> intro h)
  all_goals
    simp_all only [Fin.ext_iff, eq_comm]
    norm_num <;> ring

private def SourceRayAffine (f : ℂ→ℂ) : Prop := ∀z,f z=f 0+z*(f 1-f 0)
private theorem sourceRayAffine_dite (P : Prop) [Decidable P]
    (A : P→ℂ→ℂ) (B : (¬P)→ℂ→ℂ)
    (hA : ∀h,SourceRayAffine (A h)) (hB : ∀h,SourceRayAffine (B h)) :
    SourceRayAffine (fun z=>dite P (fun h=>A h z) (fun h=>B h z)) := by
  intro z
  by_cases h : P
  · simpa only [dif_pos h] using hA h z
  · simpa only [dif_neg h] using hB h z
private theorem sourceRayAffine_ite (P : Prop) [Decidable P] (A B : ℂ→ℂ)
    (hA : SourceRayAffine A) (hB : SourceRayAffine B) :
    SourceRayAffine (fun z=>if P then A z else B z) := by
  intro z
  by_cases h : P
  · simpa only [if_pos h] using hA z
  · simpa only [if_neg h] using hB z

/-- All literal ordinary curvature rows retain their background and full physical momentum. -/
theorem sourceCurvatureReader_affine (p : Fin 4→ℂ) (z : ℂ) :
    originalReader36 (z • p)=originalReader36 0+z • (originalReader36 p-originalReader36 0) := by
  ext r c
  have affine : SourceRayAffine (fun w : ℂ=>originalReader36 (w • p) r c) := by
    delta originalReader36
    run_tac
      let goal ← Lean.Elab.Tactic.getMainGoal
      let target ← goal.getType
      let env ← Lean.getEnv
      let expanded ← Lean.Meta.deltaExpand target (Lean.Meta.isMatcherCore env)
      let next ← goal.replaceTargetDefEq expanded
      Lean.Elab.Tactic.replaceMainGoal [next]
    conv =>
      arg 1
      ext w
      simp only [Pi.smul_apply,smul_eq_mul]
      norm_num
    repeat' first
      | apply sourceRayAffine_dite <;> intro _
      | apply sourceRayAffine_ite
    all_goals
      intro w
      ring
  simpa only [zero_smul,one_smul,Matrix.add_apply,Matrix.smul_apply,Matrix.sub_apply,Pi.add_apply,Pi.smul_apply,Pi.sub_apply,smul_eq_mul] using affine z

/-- The paid full-origin cancellation is restricted to the actual ordinary 36 rows. -/
theorem sourceCurvatureOrigin_zero (v : Fin 289→ℂ) :
    originalReader36 0*ᵥ(fullNativeOrigin*ᵥv)=0 := by
  have full:=congrArg (fun M : Matrix (Fin 289) (Fin 289) ℂ=>M*ᵥv) curvature_leading_zero
  rw [←Matrix.mulVec_mulVec,Matrix.zero_mulVec] at full
  funext r
  have row:=congrFun full (Fin.castLE (by decide) r)
  simpa only [Matrix.mulVec,dotProduct,sourceCurvatureOrigin_generated,Pi.zero_apply] using row

/-- The actual current pole's entire five-coordinate origin field has zero background curvature. -/
theorem sourcePoleOriginCurvature_zero (branch : Fin 2) (epsilon s : ℝ) (n : PhysicalMomentum) :
    originalReader36 0*ᵥsourcePoleOriginField branch epsilon s n=0 := by
  rw [sourcePoleOriginField,←Matrix.mulVec_mulVec]
  exact sourceCurvatureOrigin_zero _

