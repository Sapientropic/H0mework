import H0mework.Versions.R9c73a630.ReleaseMaterials.Scratch.LowEnergyRetardedCouncil.NamedColorQtNext.Charge.MixedSpectatorContactExchange
import H0mework.Versions.R9c73a630.ReleaseMaterials.Scratch.LowEnergyRetardedCouncil.NamedColorQtNext.Charge.MixedSpectatorCanonical79Exchange
import H0mework.Versions.R9c73a630.ReleaseMaterials.Scratch.LowEnergyRetardedCouncil.NamedColorQtNext.Charge.MixedSpectatorDual24Exchange
import H0mework.Versions.R9c73a630.ReleaseMaterials.Scratch.LowEnergyRetardedCouncil.NamedColorQtNext.Charge.MixedSpectatorScalar61Exchange
import H0mework.Versions.R71e.ReleaseMaterials.Physics.LowEnergyPhenomenology.ExternalCompositeDecay.SourceGeneralThreeParticleResponse

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 4096
noncomputable section
namespace LowEnergy.ActualFourBlockSource
open SaturationMonoid.PhysicsCore
open SourceQuantumConfigurationHilbert SourceQuantumFockGauge
open SourceQuantumGaugeSliceCoordinates
open QuantizationCheck.Fermion ActiveMatterSectorCharge MixedSpectatorCandidate
open GaussCoreHilbert GaussCoreDifferential MixedSpectatorPairedSourceFrame
open scoped BigOperators
attribute [local instance] SourceRealScalarFock.branchOrder
local instance : DecidableEq Mode := SourceRealScalarFock.branchOrder.toDecidableEq

/-- The common regular domain of the original three inverse departments.
The two matter momenta remain independent of the common transfer. -/
structure Kinematics where
  x : ℂ
  k : Fin 3 → ℝ
  pLeft : Fin 4 → ℂ
  pRight : Fin 4 → ℂ
  canonicalRegular : MixedSpectatorCanonical79Exchange.RegularMomentum x k
  dualRegular : MixedSpectatorDual24Exchange.RegularMomentum x k
  scalarRegular : MixedSpectatorScalar61Exchange.denominator (worldTransfer x k) ≠ 0

/-- All four original action coefficients, on the same full504 CAR carrier.
The scalar transfer is the same physical Fourier transfer as the other blocks. -/
def block (p : Kinematics) (b : Fin 4) : Module.End ℂ (Fock Mode) :=
  ![MixedSpectatorContactExchange.actualContactTree (worldTransfer p.x p.k) p.pLeft p.pRight,
    MixedSpectatorCanonical79Exchange.actualCanonicalTree p.x p.k p.pLeft p.pRight p.canonicalRegular,
    MixedSpectatorDual24Exchange.actualDualTree p.x p.k p.pLeft p.pRight p.dualRegular,
    MixedSpectatorScalar61Exchange.actualScalar61Tree
      ⟨worldTransfer p.x p.k,p.scalarRegular⟩] b

def coherentTree (p : Kinematics) : Module.End ℂ (Fock Mode) := ∑b : Fin 4, block p b

/-- The exact CAR operator is lifted before entering the original physical
test-function carrier; no new field or propagator is introduced. -/
def blockFiber (p : Kinematics) (b : Fin 4) : FockFiber →L[ℂ] FockFiber :=
  LinearMap.toContinuousLinearMap (SourceCARBound.liftOp (block p b))

def blockSource (p : Kinematics) (b : Fin 4) : QuantumTest →ₗ[ℂ] QuantumTest :=
  localMultiplier (fun _ => blockFiber p b) (fun _ => contDiffAt_const)

def coherentSource (p : Kinematics) : QuantumTest →ₗ[ℂ] QuantumTest :=
  ∑b : Fin 4, blockSource p b

theorem actual_block_source_point (p : Kinematics) (b : Fin 4)
    (f : QuantumTest) (z : SourceCoordinateSlice) :
    fiberCoordinates (blockSource p b f z) = block p b (fiberCoordinates (f z)) := by
  change fiberCoordinates (SourceCARBound.liftOp (block p b) (f z)) = _
  exact SourceCARBound.coordinates_liftOp _ _

theorem actual_coherent_source_point (p : Kinematics)
    (f : QuantumTest) (z : SourceCoordinateSlice) :
    fiberCoordinates (coherentSource p f z) = coherentTree p (fiberCoordinates (f z)) := by
  change fiberCoordinates ((∑b : Fin 4, blockSource p b) f z) = _
  simp only [LinearMap.sum_apply, sum_apply, map_sum, actual_block_source_point,
    coherentTree]

theorem actual_block_candidate_neutral (p : Kinematics) (b : Fin 4) (dual : Bool)
    (word : Occupation) (neutral : ∑i ∈ word, modeWeight i = 0) :
    pairing (occupationBasis word) (block p b (fiberCoordinates (candidate dual))) = 0 := by
  fin_cases b
  · exact MixedSpectatorContactExchange.actual_contact_candidate_neutral _ _ _ dual word neutral
  · exact MixedSpectatorCanonical79Exchange.actual_canonical_candidate_neutral
      p.x p.k p.pLeft p.pRight p.canonicalRegular dual word neutral
  · exact MixedSpectatorDual24Exchange.actual_dual_candidate_neutral
      p.x p.k p.pLeft p.pRight p.dualRegular dual word neutral
  · exact MixedSpectatorScalar61Exchange.actual_scalar61_candidate_neutral _ dual word neutral

/-- The real coefficient-level sum retains all four blocks before the reader.
Its zero neutral output is generated by the original CAR selection law. -/
theorem actual_coherent_candidate_neutral (p : Kinematics) (dual : Bool)
    (word : Occupation) (neutral : ∑i ∈ word, modeWeight i = 0) :
    pairing (occupationBasis word) (coherentTree p (fiberCoordinates (candidate dual))) = 0 := by
  have sum_pair (v : Fock Mode) (u : Fin 4 → Fock Mode) :
      pairing v (∑b : Fin 4,u b) = ∑b : Fin 4,pairing v (u b) := by
    simp only [pairing,Finset.sum_apply,Finset.mul_sum]
    rw [Finset.sum_comm]
  rw [coherentTree,LinearMap.sum_apply,sum_pair]
  exact Finset.sum_eq_zero (fun b _ => actual_block_candidate_neutral p b dual word neutral)

end LowEnergy.ActualFourBlockSource
