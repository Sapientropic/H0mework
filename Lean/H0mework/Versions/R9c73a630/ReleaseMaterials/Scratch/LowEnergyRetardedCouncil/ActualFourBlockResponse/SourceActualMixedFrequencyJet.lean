import H0mework.Versions.R9c73a630.ReleaseMaterials.Scratch.LowEnergyRetardedCouncil.ActualFourBlockResponse.SourceActualMixedWardSource

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1200000
set_option maxRecDepth 2048
noncomputable section
namespace LowEnergy.ActualMixedFrequencyJet
open GaussCoreHilbert GaussCoreDifferential GaussFockPair GaussDiagonalHistory GaussUnitaryHistory
open SourceClockYukawaCubicCurrent SourceScalarVirialBulk SourceScalarGaugeScale SourceClockPhiSecondBulk
open SourceScalarPositiveBulkWard SourceScalarPairedTransport FullYSourceResolventGraphSplice
open Lean Meta Elab Term
abbrev End := QuantumTest →ₗ[ℂ] QuantumTest

elab "paid_mixed_frequency%" field:ident : term => do
  let ns:=Name.str (Name.str (Name.num `_private.H0mework.Versions.R9c73a630.ReleaseMaterials.Scratch.LowEnergyRetardedCouncil.ActualFourBlockResponse.SourceActualMixedResolventWard 0) "LowEnergy") "ActualMixedResolventWard"
  let name:=Name.str ns field.getId.eraseMacroScopes.toString
  unless (←getEnv).contains name do throwError "Missing actual inverse jet proof"
  mkConstWithFreshMVarLevels name

attribute [local irreducible] compressionCore resolventCore

private def comm (A B:End):End:=A*B-B*A
private theorem gauge_comm (A:End):deltaGauge A=comm Gauge A :=
  (SourceGaugeScaleTransport.generator_commutator A).symm
private theorem relative_comm (A:End):deltaPhi A-deltaGauge A=comm (Phi-Gauge) A := by
  rw [←SourceScalarAffineScaleTransport.generator_commutator,←SourceGaugeScaleTransport.generator_commutator]
  unfold comm
  noncomm_ring
private theorem second_comm (A:End):secondJet A=comm (Phi-Gauge) A-comm Gauge (comm (Phi-Gauge) A) := by
  change (deltaPhi A-deltaGauge A)-deltaGauge (deltaPhi A-deltaGauge A)=_
  rw [relative_comm,gauge_comm]

/-- The original mixed jet has two ordered first-variation cross terms. -/
theorem actual_second_product (A B:End):
    secondJet (A*B)=secondJet A*B+A*secondJet B-
      deltaGauge A*(deltaPhi B-deltaGauge B)-(deltaPhi A-deltaGauge A)*deltaGauge B := by
  simp_rw [second_comm]
  rw [relative_comm,relative_comm]
  simp only [gauge_comm,comm]
  noncomm_ring

private theorem second_add (A B:End):secondJet (A+B)=secondJet A+secondJet B := by
  simp only [second_comm,comm]
  noncomm_ring
private theorem second_one:secondJet (1:End)=0 := by
  simp only [second_comm,comm,mul_one,one_mul,sub_self,mul_zero,zero_mul]
private theorem second_smul (z:ℂ)(A:End):secondJet (z • A)=z • secondJet A := by
  simp only [second_comm,comm,mul_smul_comm,smul_mul_assoc,smul_sub,mul_sub,sub_mul]

private theorem inverse_pair (F:Index)(z:ℂ)(hz:z.im≠0):
    resolventCore F z hz*(compressionCore F-z • (1:End))=1 ∧
      (compressionCore F-z • (1:End))*resolventCore F z hz=1 :=
  (paid_mixed_frequency% actual_inverse) F z hz

private theorem actual_resolvent_return (F:Index)(z:ℂ)(hz:z.im≠0):
    resolventCore F z hz*compressionCore F=1+z • resolventCore F z hz := by
  have h:resolventCore F z hz*(compressionCore F-z • (1:End))=1 :=
    (inverse_pair F z hz).1
  apply LinearMap.ext
  intro f
  have hf:=LinearMap.congr_fun h f
  change resolventCore F z hz (compressionCore F f-z • f)=f at hf
  simp only [map_sub,map_smul] at hf
  change resolventCore F z hz (compressionCore F f)=f+z • resolventCore F z hz f
  exact sub_eq_iff_eq_add.mp hf

/-- Multiplication by the same complex frequency returns the complete mixed jet
through the right source input, with both ordered crosses intact. -/
theorem actual_right_frequency_jet (F:Index)(z:ℂ)(hz:z.im≠0):
    let R:=resolventCore F z hz
    let C:=compressionCore F
    z • secondJet R=secondJet R*C+R*secondJet C-
      deltaGauge R*(deltaPhi C-deltaGauge C)-(deltaPhi R-deltaGauge R)*deltaGauge C := by
  dsimp only
  have h:=congrArg secondJet (actual_resolvent_return F z hz)
  rw [actual_second_product,second_add,second_one,second_smul,zero_add] at h
  exact h.symm

/-- The left ordered form is generated by the other actual inverse, not by
commuting its moving source insertions across R. -/
theorem actual_left_frequency_jet (F:Index)(z:ℂ)(hz:z.im≠0):
    let R:=resolventCore F z hz
    let C:=compressionCore F
    z • secondJet R=secondJet C*R+C*secondJet R-
      deltaGauge C*(deltaPhi R-deltaGauge R)-(deltaPhi C-deltaGauge C)*deltaGauge R := by
  dsimp only
  have hi:(compressionCore F-z • (1:End))*resolventCore F z hz=1 :=
    (inverse_pair F z hz).2
  have hr:compressionCore F*resolventCore F z hz=1+z • resolventCore F z hz := by
    apply LinearMap.ext
    intro f
    have hf:=LinearMap.congr_fun hi f
    change compressionCore F (resolventCore F z hz f)-z • resolventCore F z hz f=f at hf
    change compressionCore F (resolventCore F z hz f)=f+z • resolventCore F z hz f
    exact sub_eq_iff_eq_add.mp hf
  have h:=congrArg secondJet hr
  rw [actual_second_product,second_add,second_one,second_smul,zero_add] at h
  exact h.symm

end LowEnergy.ActualMixedFrequencyJet
