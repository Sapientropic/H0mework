import H0mework.Versions.R9c73a630.ReleaseMaterials.Scratch.LowEnergyRetardedCouncil.ActualFourBlockResponse.SourceActualNativeMixedMomentPayment

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
noncomputable section
namespace LowEnergy.ActualSecondPressureMagneticPayment
open GaussCoreDifferential GaussFockPair GaussDiagonalHistory GaussNativeForm GaussUnitaryHistory
open SourceClockYukawaCubicCurrent SourceScalarPositiveBulkWard ActualMixedWindowGram
open SourceScalarPairedTransport SourceScalarVirialBulk SourceScalarInverseBulk
open SourcePhysicalKineticSquare SourceClockPhiSecondBulk ActualScalarPhaseJet ActualPhaseBulkSquare
open SourceCoframeVolumeCurrent SourceScalarGaugeScale SourceNativeCutoffContact
private abbrev End := QuantumTest →ₗ[ℂ] QuantumTest

def magneticSecondField : End :=
  (-(12:ℂ)*(phaseCoefficient:ℂ)) •
    (magneticAction*inverseVolumeAction+inverseVolumeAction*magneticAction)

def nonmagneticBulk : End :=
  (-2:ℂ) • scalarKinetic+(6:ℂ) • gaugeKinetic+(2:ℂ) • shiftedAction-
    (1/2:ℂ) • vacuumConstantAction

def nonmagneticSecondField : End :=
  (-(phaseCoefficient:ℂ)) •
    (nonmagneticBulk*inverseVolumeAction+inverseVolumeAction*nonmagneticBulk)-
    (4:ℂ) • (phaseForce*phaseForce)

private theorem gauge_product(A B:End):
    deltaGauge (A*B)=deltaGauge A*B+A*deltaGauge B := by
  change SourceGaugeRadialPair.gaugeEulerAction*(A*B)-(A*B)*SourceGaugeRadialPair.gaugeEulerAction=
    (SourceGaugeRadialPair.gaugeEulerAction*A-A*SourceGaugeRadialPair.gaugeEulerAction)*B+
    A*(SourceGaugeRadialPair.gaugeEulerAction*B-B*SourceGaugeRadialPair.gaugeEulerAction)
  noncomm_ring

/-- Both inverse-volume legs are retained at the original magnetic weight. -/
theorem actual_magnetic_gauge_weight:
    deltaGauge magneticSecondField=(4:ℂ) • magneticSecondField := by
  unfold magneticSecondField
  simp only [map_smul,map_add,gauge_product,original_magnetic_gauge,inverse_gauge,
    mul_zero,zero_mul,add_zero,zero_add,smul_mul_assoc,mul_smul_comm]
  module

theorem actual_magnetic_mixed_zero:
    (4:ℂ) • magneticSecondField-deltaGauge magneticSecondField=0 := by
  rw [actual_magnetic_gauge_weight,sub_self]

/-- The split is generated by the original second-pressure source field. -/
theorem actual_native_second_bulk_split:
    secondJet diagonalAction=nonmagneticBulk+(12:ℂ) • magneticAction := by
  have h:=original_second_bulk_source
  unfold secondBulk at h
  unfold nonmagneticBulk
  linear_combination (norm := module) h

theorem actual_native_phase_second_pressure_split:
    secondJet phaseHamiltonianSquare=magneticSecondField+nonmagneticSecondField := by
  rw [ActualNativeMixedMomentPayment.actual_native_phase_second_pressure,
    actual_native_second_bulk_split]
  unfold magneticSecondField nonmagneticSecondField
  simp only [add_mul,mul_add,smul_mul_assoc,mul_smul_comm,smul_add,smul_smul]
  module

/-- Whole source field after the exact magnetic Gauge cancellation. -/
theorem actual_native_mixed_field_nonmagnetic:
    ActualNativeOwnSquareWardPayment.mixedSquareField=
      (4:ℂ) • nonmagneticSecondField-deltaGauge nonmagneticSecondField := by
  rw [ActualNativeOwnSquareWardPayment.actual_remaining_mixed_second,
    actual_native_phase_second_pressure_split]
  simp only [map_add,smul_add,actual_magnetic_gauge_weight]
  module

def fieldFlux(S:End)(m ell:ℕ)(F:Index)(z:ℂ)(hz:z.im≠0)(f h:QuantumTest):ℂ :=
  let R:=resolventCore F z hz
  let C:=compressionCore F
  sourcePair (coreWindow m ell F z hz f) (thetaAction m ell ((R*(C*S-S*C)*R) h))

def fieldForcing(S:End)(m ell:ℕ)(F:Index)(z:ℂ)(hz:z.im≠0)(f h:QuantumTest):ℂ :=
  let R:=resolventCore F z hz
  let C:=compressionCore F
  let W:=coreWindow m ell F z hz
  let Gamma:=deltaGauge C
  let T:=R*(C*S-S*C)*R
  (0:ℂ)-sourcePair (thetaAction m ell ((R*Gamma*R) f)) (thetaAction m ell (T h))-
    sourcePair (W f) (thetaAction m ell ((R*Gamma*T) h))-
    sourcePair (W f) (thetaAction m ell ((T*Gamma*R) h))+
    sourcePair (W f) (thetaAction m ell ((R*(Gamma*S-S*Gamma)*R) h))

private theorem pair_zero_right(f:QuantumTest):sourcePair f 0=0 := by
  simp only [sourcePair,map_zero,inner_zero_right]

/-- The four ordered raw-CF forcings cancel as one responsibility. -/
theorem actual_whole_magnetic_forcing_cancel(m ell:ℕ)(F:Index)(z:ℂ)(hz:z.im≠0)
    (f h:QuantumTest):
    (4:ℂ)*fieldFlux magneticSecondField m ell F z hz f h+
      fieldFlux magneticSecondField m ell F z hz (Gauge f) h+
      fieldFlux magneticSecondField m ell F z hz f (Gauge h)+
      fieldForcing magneticSecondField m ell F z hz f h=0 := by
  have hp:=ActualNativeMixedMomentPayment.actual_gauge_current_return
    magneticSecondField m ell F z hz f h
  dsimp only at hp
  rw [actual_magnetic_mixed_zero] at hp
  simp only [mul_zero,zero_mul,sub_zero,LinearMap.zero_apply,map_zero,
    pair_zero_right] at hp
  unfold fieldFlux fieldForcing
  dsimp only
  linear_combination -hp

/-- Direct native-plus-Own consumer: no magnetic forcing budget remains. -/
theorem actual_native_own_nonmagnetic_return(m ell:ℕ)(F:Index)(z:ℂ)(hz:z.im≠0)
    (g:QuantumTest):
    ActualNativeOwnSquareWardPayment.nativeOwnFlux m ell F z hz g=
      (4:ℂ)*fieldFlux nonmagneticSecondField m ell F z hz g g+
      fieldFlux nonmagneticSecondField m ell F z hz (Gauge g) g+
      fieldFlux nonmagneticSecondField m ell F z hz g (Gauge g)+
      fieldForcing nonmagneticSecondField m ell F z hz g g := by
  rw [ActualNativeOwnSquareWardPayment.actual_native_own_mixed_flux,
    actual_native_mixed_field_nonmagnetic]
  have hp:=ActualNativeMixedMomentPayment.actual_gauge_current_return
    nonmagneticSecondField m ell F z hz g g
  dsimp only at hp
  unfold fieldFlux fieldForcing
  dsimp only
  linear_combination hp

end LowEnergy.ActualSecondPressureMagneticPayment
