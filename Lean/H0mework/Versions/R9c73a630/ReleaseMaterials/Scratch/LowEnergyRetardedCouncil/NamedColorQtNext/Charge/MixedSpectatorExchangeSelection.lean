import H0mework.Versions.R9c73a630.ReleaseMaterials.Scratch.LowEnergyRetardedCouncil.NamedColorQtNext.Charge.MixedSpectatorJointFacts

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
namespace LowEnergy.MixedSpectatorCandidate
open SaturationMonoid.PhysicsCore
open SourceQuantumConfigurationHilbert SourceQuantumFockGauge SourceQuantumScalarChart
open SourceQuantumGaugeSliceCoordinates QuantizationCheck.Fermion ActiveMatterSectorCharge
open scoped BigOperators Matrix
attribute [local instance] SourceRealScalarFock.branchOrder
local instance : DecidableEq Mode := SourceRealScalarFock.branchOrder.toDecidableEq

/-- Each constructor evaluates to an existing full source matrix. -/
inductive SourceTreeVertex
  | native (a : NativeLie)
  | scalar (phi : Scalar)
  | spin (axis : Fin 7)
  | matter (i b : Fin 3) (point : SourceCoordinateSlice)

def sourceTreeMatrix : SourceTreeVertex → Matrix Mode Mode ℂ
  | .native a => GaussNativeMatter.nativeFull a
  | .scalar phi => GaussYukawaCoefficient.fullMatrix phi
  | .spin axis => GaussCoframeSpin.full axis
  | .matter i b point => GaussMatterCore.localMatrix i b point

theorem actual_source_tree_matrix_preserves (v : SourceTreeVertex) :
    Preserves (sourceTreeMatrix v) := by
  cases v with
  | native a => exact native_preserves a
  | scalar phi => exact yukawa_preserves phi
  | spin axis => exact spin_preserves axis
  | matter i b point => exact matter_preserves i b point

/-- The independent adjoint remains an actual matrix operation before any
coherent summation or CAR contraction. -/
def sourceTreeOrientedMatrix (v : SourceTreeVertex) (adjoint : Bool) : Matrix Mode Mode ℂ :=
  if adjoint then (sourceTreeMatrix v).conjTranspose else sourceTreeMatrix v

private theorem oriented_preserves (v : SourceTreeVertex) (adjoint : Bool) :
    Preserves (sourceTreeOrientedMatrix v adjoint) := by
  cases adjoint
  · exact actual_source_tree_matrix_preserves v
  · exact preserves_adjoint (actual_source_tree_matrix_preserves v)

abbrev SourceTreeCombination := List (ℂ × SourceTreeVertex × Bool)

def sourceTreeCoherentMatrix : SourceTreeCombination → Matrix Mode Mode ℂ
  | [] => 0
  | (coefficient, vertex, adjoint) :: rest =>
      coefficient • sourceTreeOrientedMatrix vertex adjoint + sourceTreeCoherentMatrix rest

theorem actual_source_tree_coherent_preserves (terms : SourceTreeCombination) :
    Preserves (sourceTreeCoherentMatrix terms) := by
  induction terms with
  | nil => intro i j; simp [sourceTreeCoherentMatrix]
  | cons term rest ih =>
    exact preserves_add (preserves_smul (oriented_preserves term.2.1 term.2.2) term.1) ih

def sourceTreeNormalProduct (left right : SourceTreeCombination) : Module.End ℂ (Fock Mode) :=
  LowEnergy.Fermion.normalProduct (sourceTreeCoherentMatrix left) (sourceTreeCoherentMatrix right)

theorem actual_source_tree_occupation_commutes (left right : SourceTreeCombination) :
    ActiveMatterSectorCharge.occupation * sourceTreeNormalProduct left right =
      sourceTreeNormalProduct left right * ActiveMatterSectorCharge.occupation :=
  LowEnergy.Fermion.occupationCharge_normalProduct _ _ _
    (actual_source_tree_coherent_preserves left) (actual_source_tree_coherent_preserves right)

private theorem neutral_word_charge (word : Occupation)
    (neutral : ∑ i ∈ word, modeWeight i = 0) :
    ActiveMatterSectorCharge.occupation (occupationBasis word) = 0 := by
  have h := SourceFockRaising.basis_eigenstate (fun i => (modeWeight i : ℂ)) word
  have hc : (∑ i ∈ word, (modeWeight i : ℂ)) = 0 := by
    exact_mod_cast neutral
  simpa only [ActiveMatterSectorCharge.occupation, hc, zero_smul] using h

/-- The incoming charge is generated by the concrete state, and both source
vertex laws are paid internally. The output condition only selects a neutral
occupation; it does not assert a vanishing amplitude. -/
theorem actual_candidate_neutral_tree_selection (dual : Bool)
    (left right : SourceTreeCombination) (word : Occupation)
    (neutral : ∑ i ∈ word, modeWeight i = 0) :
    pairing (occupationBasis word)
      (sourceTreeNormalProduct left right (fiberCoordinates (candidate dual))) = 0 := by
  apply LowEnergy.Fermion.occupationCharge_selection modeWeight _
    (actual_source_tree_occupation_commutes left right)
    (fiberCoordinates (candidate dual)) (occupationBasis word)
    (if dual then (-3 : ℝ) else 3) 0
  · cases dual <;> norm_num
  · have h := actual_candidate_active_sector dual
    cases dual <;> simpa [ActiveMatterSectorCharge.occupation] using h
  · simpa [ActiveMatterSectorCharge.occupation] using neutral_word_charge word neutral

theorem actual_candidate_pure_four_tree_selection (dual : Bool)
    (left right : SourceTreeCombination) (word : Occupation)
    (pureFour : ∀ i ∈ word, modeWeight i = 0) :
    pairing (occupationBasis word)
      (sourceTreeNormalProduct left right (fiberCoordinates (candidate dual))) = 0 :=
  actual_candidate_neutral_tree_selection dual left right word
    (Finset.sum_eq_zero fun i hi => pureFour i hi)

/-- Arbitrary finite coherent boson-kernel coefficients multiply the complete
source normal products. No field kernel or integrated coefficient is inferred. -/
def sourceCoherentTree {ι : Type*} (channels : Finset ι) (kernel : ι → ℂ)
    (left right : ι → SourceTreeCombination) : Module.End ℂ (Fock Mode) :=
  ∑ i ∈ channels, kernel i • sourceTreeNormalProduct (left i) (right i)

theorem actual_candidate_coherent_tree_selection {ι : Type*} (channels : Finset ι)
    (kernel : ι → ℂ) (left right : ι → SourceTreeCombination) (dual : Bool)
    (word : Occupation) (neutral : ∑ i ∈ word, modeWeight i = 0) :
    pairing (occupationBasis word)
      (sourceCoherentTree channels kernel left right (fiberCoordinates (candidate dual))) = 0 := by
  have law : ActiveMatterSectorCharge.occupation * sourceCoherentTree channels kernel left right =
      sourceCoherentTree channels kernel left right * ActiveMatterSectorCharge.occupation := by
    simp only [sourceCoherentTree, Finset.mul_sum, Finset.sum_mul,
      mul_smul_comm, smul_mul_assoc, actual_source_tree_occupation_commutes]
  apply LowEnergy.Fermion.occupationCharge_selection modeWeight _ law
    (fiberCoordinates (candidate dual)) (occupationBasis word)
    (if dual then (-3 : ℝ) else 3) 0
  · cases dual <;> norm_num
  · have h := actual_candidate_active_sector dual
    cases dual <;> simpa [ActiveMatterSectorCharge.occupation] using h
  · simpa [ActiveMatterSectorCharge.occupation] using neutral_word_charge word neutral

end LowEnergy.MixedSpectatorCandidate
