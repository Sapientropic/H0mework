private abbrev End:=QuantumTest→ₗ[ℂ]QuantumTest
private abbrev G:End:=SourceGaugeScaleTransport.generator
private abbrev B:End:=scalarBulkComplete
private abbrev V:End:=volumeAction
private abbrev U:End:=inverseVolumeAction
attribute [local irreducible] sourcePair embed scalarKinetic scalarBulkComplete
private theorem real_commute(c d:SourceCoordinateSlice→ℝ)
    (hc:∀z:physicalChart,ContDiffAt ℝ ∞ c z.val)(hd:∀z:physicalChart,ContDiffAt ℝ ∞ d z.val):
    Commute (multiply c hc) (multiply d hd):=by
  apply LinearMap.ext;intro f;apply DFunLike.ext;intro z
  exact smul_comm (c z:ℂ) (d z:ℂ) (f z)
private theorem gauge_local(A:End)(L:SourceCoordinateSlice→FockFiber→L[ℂ]FockFiber)
    (hl:∀f z,A f z=L z (f z))(hi:∀r z,L (SourceGaugeRadialCurrent.gaugeScale r z)=L z):Commute G A:=by
  have h:=SourceGaugeScaleTransport.generator_commutator A
  rw [gauge_invariant_local A L hl hi] at h
  exact sub_eq_zero.mp h
private theorem commute_bulk(A:End)(hU:Commute A U)(hK:Commute A scalarKinetic)
    (hL:Commute A localAction)(hO:Commute A offsetAction):Commute A B:=by
  unfold B scalarBulkComplete scalarBulk
  change A*((-8:ℂ) • (U*scalarKinetic)+(8:ℂ) • (U*localAction)+(8:ℂ) • offsetAction)=
    ((-8:ℂ) • (U*scalarKinetic)+(8:ℂ) • (U*localAction)+(8:ℂ) • offsetAction)*A
  linear_combination (norm:=(noncomm_ring;module))
    (-8:ℂ) • (hU.eq*scalarKinetic+U*hK.eq)+(8:ℂ) • (hU.eq*localAction+U*hL.eq)+(8:ℂ) • hO.eq

/-- The original scalar bulk, including its shifted vacuum term, is invariant under the actual gauge scaling generator. -/
theorem actual_gauge_scalar_commute:Commute G B:=by
  have hU:Commute G U:=gauge_local U (fun z=>(reciprocalVolume z:ℂ) • ContinuousLinearMap.id ℂ FockFiber)
    (fun _ _=>rfl) (fun _ _=>rfl)
  have hK:Commute G scalarKinetic:=by
    have h:=SourceGaugeScaleTransport.generator_commutator scalarKinetic
    rw [original_scalar_kinetic_gauge] at h
    exact sub_eq_zero.mp h
  have hL:Commute G localAction:=gauge_local localAction (fun z=>(localPotential z:ℂ) • ContinuousLinearMap.id ℂ FockFiber)
    (fun _ _=>rfl) (fun _ _=>rfl)
  have hO:Commute G offsetAction:=gauge_local offsetAction (fun z=>(offsetCoefficient z:ℂ) • ContinuousLinearMap.id ℂ FockFiber)
    (fun _ _=>rfl) (fun _ _=>rfl)
  exact commute_bulk G hU hK hL hO

theorem actual_volume_scalar_commute:Commute V B:=
  commute_bulk V (real_commute _ _ _ _) scalar_kinetic_volume.symm (real_commute _ _ _ _) (real_commute _ _ _ _)

theorem actual_gauge_volume_commute:Commute G V:=by
  have h:=SourceGaugeScaleTransport.generator_commutator V
  rw [original_volume_gauge] at h
  exact sub_eq_zero.mp h

/-- Gauge skewness is generated by the original source flow and its actual source pairing. -/
theorem actual_gauge_pair(f g:QuantumTest):sourcePair (G f) g= -sourcePair f (G g):=by
  have hf:=SourceGaugeScaleTransport.strong_core_derivative f 0
  have hg:=SourceGaugeScaleTransport.strong_core_derivative g 0
  simp only [SourceGaugeScaleTransport.coreFlow_zero] at hf hg
  have h:=hf.inner ℂ hg
  have he:(fun t:ℝ=>inner ℂ (embed (SourceGaugeScaleTransport.coreFlow t f))
      (embed (SourceGaugeScaleTransport.coreFlow t g)))=fun _=>sourcePair f g:=
    funext (fun t=>by simpa only [sourcePair] using SourceGaugeScaleTransport.coreFlow_pair t f g)
  rw [he] at h
  have hz:=h.unique (hasDerivAt_const (0:ℝ) (sourcePair f g))
  simp only [SourceGaugeScaleTransport.coreFlow_zero] at hz
  unfold sourcePair
  linear_combination hz
