/-- The complex plane operator is generated by both genuine real histories of the actual prepared current. -/
theorem dressed_plane_history_generated (event : DressedEvent) (transfer : PhysicalMomentum)
    (p : Fin 4→ℂ) (t : ℝ) (i j : Fin 289) :
    dressedSignalMatrix event transfer p t i j=
      dressedEulerObserver event (planeNoetherOperator (dressedKinematicPoint event transfer)
        (fieldUnit i) (fieldUnit j) (p 0) t) := by
  have observer:=plane_noether_observer (dressedKinematicPoint event transfer) (fieldUnit i) (fieldUnit j)
    (dressedEulerObserver event) (p 0) t
  have read : dressedEulerObserver event (planeNoetherOperator (dressedKinematicPoint event transfer)
      (fieldUnit i) (fieldUnit j) (p 0) t)=
      dressedHistoryInitial event transfer t (fieldUnit j) i+
        Complex.exp ((t:ℂ)*p 0)*dressedHistoryContact event transfer t (fieldUnit j) i+
        ∫s in (0:ℝ)..t,Complex.exp ((s:ℂ)*p 0)*dressedHistoryMemory event transfer t s (fieldUnit j) i := by
    simpa only [dressedHistoryInitial,dressedHistoryContact,dressedHistoryMemory,
      ContinuousLinearMap.pi_apply,ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.coe_restrictScalars',Function.comp_def] using! observer
  exact (dressed_signal_history_matrix event transfer p t i j).trans read.symm

/-- The full actual Fourier half matrix directly consumes the original two inverse clocks. -/
theorem dressed_frequency_half_inverse (event : DressedEvent) (transfer : PhysicalMomentum)
    (p : Fin 4→ℂ) (lambda : ℂ) (off : sourceClockGrowth p<lambda.re) (i j : Fin 289) :
    frequencyHalfPolarization event transfer p lambda i j=
      dressedEulerObserver event (planeNoetherInverse (dressedKinematicPoint event transfer)
        (fieldUnit i) (fieldUnit j) (p 0) lambda) := by
  have positive : 0<lambda.re := (le_max_left 0 (p 0).re).trans_lt off
  have inputOff : (p 0).re<lambda.re := (le_max_right 0 (p 0).re).trans_lt off
  have shifted : 0<(lambda-p 0).re := by simpa only [Complex.sub_re] using sub_pos.mpr inputOff
  have integrable:=plane_noether_operator_integrable (dressedKinematicPoint event transfer)
    (fieldUnit i) (fieldUnit j) (p 0) lambda positive shifted
  have read:=(dressedEulerObserver event).integral_comp_comm integrable
  have inverse:=plane_noether_operator_inverse (dressedKinematicPoint event transfer)
    (fieldUnit i) (fieldUnit j) (p 0) lambda positive shifted
  rw [frequency_half_polarization_integral event transfer p lambda off i j]
  simp_rw [dressed_plane_history_generated]
  calc
    _=dressedEulerObserver event
        (∫t in Ioi (0:ℝ),laplaceWeight lambda t •
          planeNoetherOperator (dressedKinematicPoint event transfer) (fieldUnit i) (fieldUnit j) (p 0) t) := by
      simpa only [map_smul,smul_eq_mul] using! read
    _=_ := congrArg (dressedEulerObserver event) inverse

/-- The source preparation remains at sigma-i*omega; contact and driven outer legs use sigma. -/
theorem damped_fourier_polarization_inverse (event : DressedEvent) (transfer : PhysicalMomentum)
    (omega sigma : ℝ) (k : PhysicalMomentum) (positive : 0<sigma) (i j : Fin 289) :
    frequencyHalfPolarization event transfer (physicalFrequencyMomentum omega k) (dampedFourierClock omega sigma) i j=
      dressedEulerObserver event
        (sourceInverse (dressedKinematicPoint event transfer) (dampedFourierClock omega sigma)
          (sourceMaterialMap (dressedKinematicPoint event transfer) (fieldUnit i) (fieldUnit j))+
        sourceInverse (dressedKinematicPoint event transfer) (sigma:ℂ)
          (sourceContactMap (dressedKinematicPoint event transfer) (fieldUnit i) (fieldUnit j)+
            driveOperator (dressedKinematicPoint event transfer) (fieldUnit j)
              (sourceInverse (dressedKinematicPoint event transfer) (dampedFourierClock omega sigma)
                (rawInitial (dressedKinematicPoint event transfer) (fieldUnit i))))) := by
  have original:=dressed_frequency_half_inverse event transfer (physicalFrequencyMomentum omega k)
    (dampedFourierClock omega sigma) (damped_fourier_source_domain omega sigma k positive) i j
  have shifted : dampedFourierClock omega sigma-physicalFrequencyMomentum omega k 0=(sigma:ℂ) := by
    simp only [dampedFourierClock,physicalFrequencyMomentum,Fin.cases_zero]
    ring
  simpa only [planeNoetherInverse,shifted] using! original

/-- The same physical spatial transfer enters the original action and both actual material legs. -/
theorem damped_physical_response_inverse (event : DressedEvent) (omega sigma : ℝ)
    (k : PhysicalMomentum) (positive : 0<sigma) (i j : Fin 289) :
    frequencyResponsePencil event k (physicalFrequencyMomentum omega k) (dampedFourierClock omega sigma) i j=
      ActualEMAction.emOriginalJacobi (physicalFrequencyMomentum omega k) i j-(sigma:ℂ)*
        dressedEulerObserver event
          (sourceInverse (dressedKinematicPoint event k) (dampedFourierClock omega sigma)
            (sourceMaterialMap (dressedKinematicPoint event k) (fieldUnit i) (fieldUnit j))+
          sourceInverse (dressedKinematicPoint event k) (sigma:ℂ)
            (sourceContactMap (dressedKinematicPoint event k) (fieldUnit i) (fieldUnit j)+
              driveOperator (dressedKinematicPoint event k) (fieldUnit j)
                (sourceInverse (dressedKinematicPoint event k) (dampedFourierClock omega sigma)
                  (rawInitial (dressedKinematicPoint event k) (fieldUnit i))))) := by
  have response:=congrFun (congrFun (damped_fourier_response event k omega sigma k positive) i) j
  simp only [Matrix.sub_apply,Matrix.smul_apply,smul_eq_mul] at response
  exact response.trans (congrArg
    (fun z : ℂ=>ActualEMAction.emOriginalJacobi (physicalFrequencyMomentum omega k) i j-(sigma:ℂ)*z)
    (damped_fourier_polarization_inverse event k omega sigma k positive i j))

