import H0mework.Versions.R9c73a630.ReleaseMaterials.Verification.Physics.LowEnergyPhenomenology.AlphaSource.EmIdentification.ActualDressedNonlinearHalfResponse
import H0mework.Versions.R9c73a630.ReleaseMaterials.Verification.Physics.LowEnergyPhenomenology.AlphaSource.EmIdentification.ActualDressedStaticAmputation

set_option autoImplicit false
set_option maxRecDepth 16384
set_option maxHeartbeats 700000
set_option synthInstance.maxHeartbeats 200000
set_option backward.isDefEq.respectTransparency false
noncomputable section
namespace LowEnergy.GaussComposite.ActualDressedNonlinearHalf
open CanonicalGradedSpatialSource PreparationVacuumMixedFieldReturn PreparationVacuumPhysicalFeedback
open PreparationVacuumGaugeSourceInjection PreparationVacuumActionFieldLift PreparationVacuumJointFieldResponse
open ActualDressedFullCoulomb ActualDressedNoether ActualDressedSignal ActualDressedSylvester ActualDressedStaticResponse
open scoped Matrix BigOperators Topology
attribute [local irreducible] dressedNoetherHalfSource dressedStaticPolarization staticInputNormalizer staticQuantumCorrection

private theorem original_field_basis (force : Field289) :
    force=∑j : Fin 289,force j • fieldUnit j := by
  classical
  funext i
  simp [fieldUnit,Pi.single_apply,mul_ite]

/-- The full matrix is generated by the actual nonlinear integral's real field differential. -/
theorem dressed_noether_half_fderiv (event : DressedEvent) (transfer : PhysicalMomentum)
    (lambda : ℂ) (positive : 0<lambda.re) (force : Field289) :
    fderiv ℝ (dressedNoetherHalfSource event transfer lambda) 0 force=
      dressedStaticPolarization event transfer lambda*ᵥ(fun j=>(force j:ℂ)) := by
  let L:=fderiv ℝ (dressedNoetherHalfSource event transfer lambda) 0
  have differentiable:=(dressed_noether_half_C2 event transfer lambda positive).differentiableAt (by norm_num)
  have columns (j : Fin 289) : L (fieldUnit j)=(fun i=>dressedStaticPolarization event transfer lambda i j) := by
    have original:=differentiable.hasFDerivAt.comp_hasDerivAt_of_eq 0 (fieldRay_derivative (fieldUnit j) 0) (by simp)
    exact original.unique (dressed_noether_half_column_derivative event transfer lambda positive j)
  have generated:=congrArg L (original_field_basis force)
  funext i
  simpa only [map_sum,map_smul,columns,Finset.sum_apply,Pi.smul_apply,Complex.real_smul,
    Matrix.mulVec,dotProduct,mul_comm] using! congrFun generated i

theorem dressed_noether_half_full_derivative (event : DressedEvent) (transfer : PhysicalMomentum)
    (lambda : ℂ) (positive : 0<lambda.re) (force : Field289) :
    HasDerivAt (fun r : ℝ=>dressedNoetherHalfSource event transfer lambda (r • force))
      (dressedStaticPolarization event transfer lambda*ᵥ(fun j=>(force j:ℂ))) 0 := by
  have differentiable:=(dressed_noether_half_C2 event transfer lambda positive).differentiableAt (by norm_num)
  have original:=differentiable.hasFDerivAt.comp_hasDerivAt_of_eq 0 (fieldRay_derivative force 0) (by simp)
  exact original.congr_deriv (dressed_noether_half_fderiv event transfer lambda positive force)

/-- Original constant-input normalization acts on the actual nonlinear quantum current. -/
def dressedNormalizedNoetherSource (event : DressedEvent) (transfer : PhysicalMomentum)
    (lambda : ℂ) (h : Field289) : Fin 289→ℂ :=
  staticInputNormalizer lambda • dressedNoetherHalfSource event transfer lambda h

attribute [local irreducible] dressedNormalizedNoetherSource

theorem dressed_normalized_noether_derivative (event : DressedEvent) (transfer : PhysicalMomentum)
    (lambda : ℂ) (positive : 0<lambda.re) (force : Field289) :
    HasDerivAt (fun r : ℝ=>dressedNormalizedNoetherSource event transfer lambda (r • force))
      (staticQuantumCorrection event transfer lambda*ᵥ(fun j=>(force j:ℂ))) 0 := by
  have original:=(dressed_noether_half_full_derivative event transfer lambda positive force).const_smul
    (staticInputNormalizer lambda)
  simpa only [dressedNormalizedNoetherSource,staticQuantumCorrection,Matrix.smul_mulVec] using! original

end LowEnergy.GaussComposite.ActualDressedNonlinearHalf
