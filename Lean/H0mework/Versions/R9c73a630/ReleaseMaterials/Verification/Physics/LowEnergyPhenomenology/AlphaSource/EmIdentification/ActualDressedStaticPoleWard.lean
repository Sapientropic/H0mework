local instance staticPoleRealAlgebra : NormedAlgebra ℝ ResponseOp:=NormedAlgebra.restrictScalars ℝ ℂ _
attribute [local irreducible] sourceLeadingPole sourcePoleRegularOperator sourceHamiltonian
  propagationPencil propagationNumerator staticPoleLeadingOperator physicalPreparationMismatch preparationWardObserver

/-- The leading pole is generated by the same minpoly numerator and original Sylvester pencil. -/
theorem source_leading_pencil_zero (q : PhysicalResponsePoint) (zeroTransfer : q.k=0) :
    propagationPencil q 0*sourceLeadingPole q 0=0 := by
  have root : (propagationPolynomial q).eval 0=0:=zero_transfer_sourcePole q zeroTransfer
  apply ContinuousLinearMap.ext
  intro A
  have actual:=congrArg (fun T : SourcePropagationResolvent.TransferOp=>T A) (sourceNumerator_pencil q 0)
  have numerator_zero : propagationPencil q 0 (propagationNumerator q 0 A)=0 := by
    have returned : propagationPencil q 0 (propagationNumerator q 0 A)=(0:ℂ) • A := by
      simpa only [mul_apply_eq_comp,root,smul_apply,one_apply_eq_self] using! actual
    exact returned.trans (zero_smul ℂ A)
  unfold sourceLeadingPole sourcePoleRegularOperator
  simp only [mul_apply_eq_comp,smul_apply,zero_apply]
  change propagationPencil q 0 (((sourcePoleDenominator q 0).eval 0)⁻¹ • propagationNumerator q 0 A)=0
  rw [map_smul,numerator_zero]
  apply ContinuousLinearMap.ext
  intro x
  exact smul_zero (((sourcePoleDenominator q 0).eval 0)⁻¹)

private theorem zero_balance {E : Type*} [AddCommGroup E] [Module ℂ E]
    (V L R : E) (paid : (0:ℂ) • V+(-Complex.I) • L-(-Complex.I) • R=0) : L-R=0 := by
  have factored : (-Complex.I) • (L-R)=0 := by
    calc
      _=(0:ℂ) • V+(-Complex.I) • L-(-Complex.I) • R := by module
      _=0:=paid
  exact (smul_eq_zero.mp factored).resolve_left (neg_ne_zero.mpr Complex.I_ne_zero)

theorem source_leading_physical_action (q : PhysicalResponsePoint) (zeroTransfer : q.k=0) (A : ResponseOp) :
    sourceHamiltonian (q.p+q.k) q.F*sourceLeadingPole q 0 A-
      sourceLeadingPole q 0 A*sourceHamiltonian q.p q.F=0 := by
  have paid:=congrArg (fun T : SourcePropagationResolvent.TransferOp=>T A)
    (source_leading_pencil_zero q zeroTransfer)
  simp only [mul_apply_eq_comp,zero_apply,propagationPencil_actual,leftGenerator,rightGenerator,
    smul_mul_assoc,mul_smul_comm] at paid
  have generated:=zero_balance _ _ _ paid
  simpa only [sourceHamiltonian] using! generated

/-- Both original propagation poles enter the leading quantum operator; its outer source pole returns the actual physical Ward equation. -/
theorem static_pole_physical_action (q : PhysicalResponsePoint) (reader force : Field289)
    (zeroTransfer : q.k=0) :
    sourceHamiltonian (q.p+q.k) q.F*staticPoleLeadingOperator q reader force-
      staticPoleLeadingOperator q reader force*sourceHamiltonian q.p q.F=0 := by
  unfold staticPoleLeadingOperator
  exact source_leading_physical_action q zeroTransfer _

/-- At the actual leading quantum pole, the physical/preparation difference is the negative original two-endpoint residual. -/
theorem static_pole_preparation_return (event : DressedEvent) (reader force : Field289) :
    physicalPreparationMismatch event 0 (staticPoleLeadingOperator (dressedKinematicPoint event 0) reader force)=
      -preparationWardObserver event (staticPoleLeadingOperator (dressedKinematicPoint event 0) reader force) := by
  have zeroTransfer : (dressedKinematicPoint event 0).k=0:=by simp only [dressedKinematicPoint,neg_zero]
  have physical :
      sourceHamiltonian event.momentum event.frame*staticPoleLeadingOperator (dressedKinematicPoint event 0) reader force-
        staticPoleLeadingOperator (dressedKinematicPoint event 0) reader force*sourceHamiltonian event.momentum event.frame=0 := by
    simpa only [dressedKinematicPoint,neg_zero,add_zero] using!
      static_pole_physical_action (dressedKinematicPoint event 0) reader force zeroTransfer
  have returned:=physical_preparation_return event 0 (staticPoleLeadingOperator (dressedKinematicPoint event 0) reader force)
  simp only [sub_zero,physical,map_zero] at returned
  exact eq_neg_iff_add_eq_zero.mpr returned.symm

theorem static_pole_preparation_price (event : DressedEvent) (reader force : Field289) :
    ‖physicalPreparationMismatch event 0 (staticPoleLeadingOperator (dressedKinematicPoint event 0) reader force)‖≤
      (2*(2*‖sourceLeg true 1 0‖+1))*event.epsilon*
        ‖staticPoleLeadingOperator (dressedKinematicPoint event 0) reader force‖ := by
  rw [static_pole_preparation_return,norm_neg]
  exact ((preparationWardObserver event).le_opNorm _).trans
    (mul_le_mul_of_nonneg_right (preparation_ward_observer_price event) (norm_nonneg _))

theorem static_pole_preparation_limit (event : DressedEvent) (reader force : Field289) :
    Tendsto (fun n : ℕ=>physicalPreparationMismatch (preparationEventSequence event n) 0
      (staticPoleLeadingOperator (dressedKinematicPoint (preparationEventSequence event n) 0) reader force))
      atTop (𝓝 0) := by
  have fixed (n : ℕ) : staticPoleLeadingOperator (dressedKinematicPoint (preparationEventSequence event n) 0) reader force=
      staticPoleLeadingOperator (dressedKinematicPoint event 0) reader force := by
    unfold staticPoleLeadingOperator sourceLeadingPole sourcePoleRegularOperator propagationNumerator
    rfl
  have evaluated:=((ContinuousLinearMap.apply ℂ ℂ
    (staticPoleLeadingOperator (dressedKinematicPoint event 0) reader force)).continuous.tendsto
      (0 : ResponseOp→L[ℂ]ℂ)).comp (preparation_ward_observer_limit event)
  have generated : Tendsto (fun n : ℕ=>preparationWardObserver (preparationEventSequence event n)
      (staticPoleLeadingOperator (dressedKinematicPoint event 0) reader force)) atTop (𝓝 (0:ℂ)) := by
    simpa only [ContinuousLinearMap.apply_apply,zero_apply] using! evaluated
  have negated : Tendsto (fun n : ℕ=>-preparationWardObserver (preparationEventSequence event n)
      (staticPoleLeadingOperator (dressedKinematicPoint event 0) reader force)) atTop (𝓝 (0:ℂ)) := by
    simpa only [neg_zero] using! generated.neg
  apply Tendsto.congr' _ negated
  exact Filter.Eventually.of_forall (fun n=>
    ((static_pole_preparation_return (preparationEventSequence event n) reader force).trans
      (congrArg (fun A : ResponseOp=>-preparationWardObserver (preparationEventSequence event n) A) (fixed n))).symm)

