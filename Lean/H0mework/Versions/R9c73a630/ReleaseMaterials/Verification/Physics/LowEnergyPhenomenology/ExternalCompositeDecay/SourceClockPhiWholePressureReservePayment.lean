import H0mework.Versions.R9c73a630.ReleaseMaterials.Verification.Physics.LowEnergyPhenomenology.ExternalCompositeDecay.SourceClockPhiExactPressureReserve
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 2048
noncomputable section
namespace LowEnergy.FirstCurrentPressureReserve
open GaussCoreHilbert GaussCoreDifferential GaussFockPair GaussHistoryHilbert GaussNativeForm GaussNativeEnergy
open GaussDiagonalHistory GaussUnitaryHistory SourceQuantumConfigurationHilbert
open SourceClockPhiNativeMatchedSource FirstCurrentAdmissibleElectric FirstCurrentWholeCarrier FirstCurrentJointBudget
open ReverseNativeClock ReverseNativeFrequencyWard ReverseBalancedForcePayer ReverseForcePhysicalPayment
open FirstCurrentJointDifference FirstCurrentMatchedPressure FirstCurrentDifferenceFrequency FirstCurrentForcingPressure
open PrimitiveInputPayer SourceLocalizedInverseFormPayment SourceResolventBandLimit
open MeasureTheory Filter
open scoped ENNReal
private abbrev n:ℝ:=sourceTime 0
attribute [local irreducible] embed sourcePair wholeClockState wholeSourceNext clockSourcePair
  completedMatchedSource sourcePressurePayment differenceJointLoss matchedSquarePrice wholePressureReserve
  forcingPressureUpper sourcePressureUpper transportedDifferenceUpper physicalJointPrice
private theorem matched_integrable(s:ℝ)(hs:0<s)(half advanced:Bool)(m ell:ℕ)(F:Index)(g:diagonal.domain)(x:ℝ×ℝ):
    Integrable (matchedSquarePrice s hs half advanced m ell F g x):=by
  have h:=(actual_whole_completed_forcing_integrable s hs half advanced m ell F g x).2
  have hn:Integrable (fun q:ℝ=>‖embed (completedMatchedSource s hs half advanced m ell F g x q)‖^2):=by
    apply h.congr
    exact Eventually.of_forall (fun q=>by
      simp only [completedMatchedSource,map_add,map_smul,Complex.ofReal_div,Complex.ofReal_ofNat])
  unfold matchedSquarePrice
  exact hn.const_mul (n/48)

def totalPressureReserve(s:ℝ)(hs:0<s)(half advanced:Bool)(m ell:ℕ)(F:Index)(g:diagonal.domain)(x:ℝ×ℝ)(q:ℝ):ℝ:=
  sourcePressurePayment s hs half advanced m ell F g x q+wholePressureReserve s hs half advanced m ell F g x q
private theorem total_nonnegative(s:ℝ)(hs:0<s)(half advanced:Bool)(m ell:ℕ)(F:Index)(g:diagonal.domain)(x:ℝ×ℝ)(q:ℝ):
    0≤totalPressureReserve s hs half advanced m ell F g x q:=
  add_nonneg (actual_joint_matched_pressure_payment s hs half advanced m ell F g x q).1
    (actual_whole_pressure_reserve_balance s hs half advanced m ell F g x q).2

/-- The actual full-frequency J retains the whole source reserve. Ordinary integrability is generated by the exact two-square resource, without a force or graph bound. -/
theorem actual_whole_reserve_frequency_payment(s:ℝ)(hs:0<s)(half advanced:Bool)(m ell:ℕ)(F:Index)(g:diagonal.domain)(x:ℝ×ℝ):
    Integrable (totalPressureReserve s hs half advanced m ell F g x) ∧
    Integrable (forcingPressureUpper s hs half advanced m ell F g x) ∧
    0≤(∫q:ℝ,totalPressureReserve s hs half advanced m ell F g x q) ∧
    (∫q:ℝ,physicalJointPrice half advanced (actualFrequency advanced (sourceNoetherFrequency half) q)
      (clockSourcePair s hs x (wholeSourceNext s hs half advanced m ell F g q)))+
      (∫q:ℝ,scalarNativeLoss (wholeClockState s hs half advanced m ell F g x q))+
      (∫q:ℝ,totalPressureReserve s hs half advanced m ell F g x q)≤
        ∫q:ℝ,forcingPressureUpper s hs half advanced m ell F g x q:=by
  have hd:=actual_whole_joint_difference_payment s hs half advanced m ell F g x
  have hj:=actual_whole_transported_difference_payment s hs half advanced m ell F g x
  have hm:=matched_integrable s hs half advanced m ell F g x
  have hT(q:ℝ):totalPressureReserve s hs half advanced m ell F g x q=
      differenceJointLoss s hs half advanced m ell F g x q+matchedSquarePrice s hs half advanced m ell F g x q:=
    (actual_whole_pressure_reserve_balance s hs half advanced m ell F g x q).1
  have ht:Integrable (totalPressureReserve s hs half advanced m ell F g x):=
    (hd.2.2.1.add hm).congr (Eventually.of_forall (fun q=>(hT q).symm))
  have hu:=(actual_whole_forcing_pressure_payment s hs half advanced m ell F g x).1
  refine ⟨ht,hu,integral_nonneg (total_nonnegative s hs half advanced m ell F g x),?_⟩
  have he:(∫q:ℝ,totalPressureReserve s hs half advanced m ell F g x q)=
      (∫q:ℝ,differenceJointLoss s hs half advanced m ell F g x q)+
        (∫q:ℝ,matchedSquarePrice s hs half advanced m ell F g x q):=by
    simp_rw [hT]
    exact integral_add hd.2.2.1 hm
  have hv:(∫q:ℝ,forcingPressureUpper s hs half advanced m ell F g x q)=
      (∫q:ℝ,transportedDifferenceUpper s hs half advanced m ell F g x q)+
        (∫q:ℝ,matchedSquarePrice s hs half advanced m ell F g x q):=by
    simp_rw [←actual_forcing_pressure_upper_return]
    unfold sourcePressureUpper
    exact integral_add hj.1 hm
  rw [he,hv]
  linarith only [hj.2]

/-- The original pressure and the newly retained positive source reserve can be consumed separately. They spend the same complete two-square resource exactly once. -/
theorem actual_whole_separated_reserve_payment(s:ℝ)(hs:0<s)(half advanced:Bool)(m ell:ℕ)(F:Index)(g:diagonal.domain)(x:ℝ×ℝ):
    (∫⁻q:ℝ,ENNReal.ofReal (sourcePressurePayment s hs half advanced m ell F g x q))<⊤ ∧
    (∫⁻q:ℝ,ENNReal.ofReal (wholePressureReserve s hs half advanced m ell F g x q))<⊤ ∧
    (∫q:ℝ,physicalJointPrice half advanced (actualFrequency advanced (sourceNoetherFrequency half) q)
      (clockSourcePair s hs x (wholeSourceNext s hs half advanced m ell F g q)))+
      (∫q:ℝ,scalarNativeLoss (wholeClockState s hs half advanced m ell F g x q))+
      (∫⁻q:ℝ,ENNReal.ofReal (sourcePressurePayment s hs half advanced m ell F g x q)).toReal+
      (∫⁻q:ℝ,ENNReal.ofReal (wholePressureReserve s hs half advanced m ell F g x q)).toReal≤
        ∫q:ℝ,forcingPressureUpper s hs half advanced m ell F g x q:=by
  have h:=actual_whole_reserve_frequency_payment s hs half advanced m ell F g x
  let p:=fun q:ℝ=>ENNReal.ofReal (sourcePressurePayment s hs half advanced m ell F g x q)
  let r:=fun q:ℝ=>ENNReal.ofReal (wholePressureReserve s hs half advanced m ell F g x q)
  have ht:(∫⁻q:ℝ,p q+r q)=ENNReal.ofReal (∫q:ℝ,totalPressureReserve s hs half advanced m ell F g x q):=by
    have he(q:ℝ):p q+r q=ENNReal.ofReal (totalPressureReserve s hs half advanced m ell F g x q):=by
      exact (ENNReal.ofReal_add (actual_joint_matched_pressure_payment s hs half advanced m ell F g x q).1
        (actual_whole_pressure_reserve_balance s hs half advanced m ell F g x q).2).symm
    simp_rw [he]
    exact (ofReal_integral_eq_lintegral_ofReal h.1 (Eventually.of_forall (total_nonnegative s hs half advanced m ell F g x))).symm
  have hb:((∫⁻q:ℝ,p q)+(∫⁻q:ℝ,r q))≤ENNReal.ofReal (∫q:ℝ,totalPressureReserve s hs half advanced m ell F g x q):=
    (le_lintegral_add p r).trans_eq ht
  have hp:(∫⁻q:ℝ,p q)<⊤:=lt_of_le_of_lt ((le_add_right le_rfl).trans hb) ENNReal.ofReal_lt_top
  have hr:(∫⁻q:ℝ,r q)<⊤:=lt_of_le_of_lt ((le_add_left le_rfl).trans hb) ENNReal.ofReal_lt_top
  refine ⟨hp,hr,?_⟩
  have hreal:=ENNReal.toReal_mono ENNReal.ofReal_ne_top hb
  rw [ENNReal.toReal_add hp.ne hr.ne,ENNReal.toReal_ofReal h.2.2.1] at hreal
  dsimp only [p,r] at hreal
  linarith only [hreal,h.2.2.2]
end LowEnergy.FirstCurrentPressureReserve
