private def rieszLinear (F : GaussUnitaryHistory.Index) :
    (FrameIndex F→FrameIndex F→ℂ)→ₗ[ℂ] Operator where
  toFun:=finiteRiesz F
  map_add' a b:=by simp only [finiteRiesz,Pi.add_apply,add_smul,Finset.sum_add_distrib]
  map_smul' c a:=by
    simp only [finiteRiesz,Pi.smul_apply,smul_eq_mul,Finset.smul_sum,smul_smul,RingHom.id_apply]

/-- This is the original reader germ on exactly the same finite source frame. -/
theorem source_reader_germ (f : Field289) (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) :
    noetherReader f p F=ᶠ[𝓝 0] fun h=>∑k : Fin 289,(f k:ℂ) • noetherReader (fieldUnit k) p F h := by
  have entries : ∀ᶠh : Field289 in 𝓝 0,∀i j : FrameIndex F,
      noetherForm f p (frameTest F i) (frameTest F j) h=
        ∑k : Fin 289,(f k:ℂ) • noetherForm (fieldUnit k) p (frameTest F i) (frameTest F j) h := by
    apply eventually_all.mpr
    intro i
    apply eventually_all.mpr
    intro j
    have near : ∀ᶠh : Field289 in 𝓝 0,‖h‖<ambientRadius (frameTest F i) :=
      (continuous_norm.tendsto 0).eventually (gt_mem_nhds (by simpa using ambientRadius_positive (frameTest F i)))
    exact near.mono (fun h small=>source_reader_form_basis f p (frameTest F i) (frameTest F j) h small)
  filter_upwards [entries] with h paid
  have same : (fun i j=>noetherForm f p (frameTest F i) (frameTest F j) h)=
      ∑k : Fin 289,(f k:ℂ) • (fun i j=>noetherForm (fieldUnit k) p (frameTest F i) (frameTest F j) h) := by
    funext i j
    simpa only [Finset.sum_apply,Pi.smul_apply] using paid i j
  have generated:=congrArg (rieszLinear F) same
  simpa only [map_sum,map_smul,rieszLinear,LinearMap.coe_mk,AddHom.coe_mk,noetherReader] using generated

theorem source_reader_initial (f : Field289) (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) :
    noetherReader f p F 0=∑k : Fin 289,(f k:ℂ) • noetherReader (fieldUnit k) p F 0 :=
  (source_reader_germ f p F).self_of_nhds

/-- The contact is generated by differentiating the same finite-frame germ; no term is assigned zero. -/
theorem source_reader_contact_basis (f force : Field289) (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) :
    noetherReaderContact f force p F=∑k : Fin 289,(f k:ℂ) • noetherReaderContact (fieldUnit k) force p F := by
  have generated : HasDerivAt (fun r : ℝ=>∑k : Fin 289,(f k:ℂ) • noetherReader (fieldUnit k) p F (r • force))
      (∑k : Fin 289,(f k:ℂ) • noetherReaderContact (fieldUnit k) force p F) 0 :=
    HasDerivAt.fun_sum (fun k _=>(noetherReader_generated (fieldUnit k) force p F).const_smul (f k:ℂ))
  have same:=(source_reader_germ f p F).comp_tendsto
    (show Tendsto (fun r : ℝ=>r • force) (𝓝 0) (𝓝 0) from by
      simpa only [zero_smul] using (fieldRay_derivative force 0).continuousAt.tendsto)
  exact (noetherReader_generated f force p F).unique (generated.congr_of_eventuallyEq same)

private theorem history_contact_algebra {A : Type*} [Ring A]
    (dl dr l r tl tr cl cr j old next : A) :
    (dl*(l*j*r)*tr+tl*((-cl)*j*r+l*old*r+l*j*(-cr))*tr+tl*(l*j*r)*dr)+
      tl*l*(next-old)*r*tr=
    dl*(l*j*r)*tr+tl*((-cl)*j*r+l*next*r+l*j*(-cr))*tr+tl*(l*j*r)*dr := by
  simp only [mul_sub,sub_mul,mul_add,add_mul,mul_assoc]
  abel

private theorem original_history_contact (q : PhysicalResponsePoint) (reader : Field289)
    (signal : ℝ→SourceJet Field289) (t : ℝ) :
    (noetherHistoryOperatorJet q reader signal t).value=
      nativeWardHistory q (noetherReader reader q.p q.F 0)
        (fun force=>noetherReaderContact reader force q.p q.F) (fun s=>(signal s).value) t := by
  rw [noetherHistoryOperatorJet_value]
  simp only [historyOperator,historyMiddle,rawInitial,nativeWardHistory,noetherReader_source]
  exact history_contact_algebra _ _ _ _ _ _ _ _ _ _ _


private theorem ward_history_sum (q : PhysicalResponsePoint) (coefficient : Fin 289→ℂ)
    (A : Fin 289→Operator) (C : Fin 289→Field289→Operator) (history : ℝ→Field289) (t : ℝ) :
    nativeWardHistory q (∑k,coefficient k • A k) (fun force=>∑k,coefficient k • C k force) history t=
      ∑k,coefficient k • nativeWardHistory q (A k) (C k) history t := by
  simp only [nativeWardHistory,Finset.mul_sum,Finset.sum_mul,mul_smul_comm,smul_mul_assoc,
    Finset.sum_add_distrib,smul_add,mul_add,add_mul]

/-- Every original slot enters the full uncut Noether history, including both ordered endpoints and the corrected mixed contact. -/
theorem source_noether_history_basis (q : PhysicalResponsePoint) (f : Field289)
    (signal : ℝ→SourceJet Field289) (t : ℝ) :
    (noetherHistoryOperatorJet q f signal t).value=
      ∑k : Fin 289,(f k:ℂ) • (noetherHistoryOperatorJet q (fieldUnit k) signal t).value := by
  have contact : (fun force=>noetherReaderContact f force q.p q.F)=
      fun force=>∑k : Fin 289,(f k:ℂ) • noetherReaderContact (fieldUnit k) force q.p q.F :=
    funext (fun force=>source_reader_contact_basis f force q.p q.F)
  have replaced:=congrArg₂
    (fun (A : Operator) (C : Field289→Operator)=>nativeWardHistory q A C (fun s=>(signal s).value) t)
      (source_reader_initial f q.p q.F) contact
  have generated:=replaced.trans (ward_history_sum q (fun k=>(f k:ℂ))
    (fun k=>noetherReader (fieldUnit k) q.p q.F 0)
    (fun k force=>noetherReaderContact (fieldUnit k) force q.p q.F) (fun s=>(signal s).value) t)
  refine (original_history_contact q f signal t).trans (generated.trans ?_)
  apply Finset.sum_congr rfl
  intro k _
  exact congrArg (fun A=>(f k:ℂ) • A) (original_history_contact q (fieldUnit k) signal t).symm

/-- The same actual creation-minus-background observer consumes the complete original reader contraction. -/
theorem actual_noether_reader_contraction (event : DressedEvent) (transfer : PhysicalMomentum)
    (f : Field289) (signal : ℝ→SourceJet Field289) (t : ℝ) :
    dressedEulerObserver event (noetherHistoryOperatorJet (dressedKinematicPoint event transfer) f signal t).value=
      ∑k : Fin 289,(f k:ℂ)*(dressedNoetherJet event transfer signal t k).value := by
  have generated:=congrArg (dressedEulerObserver event)
    (source_noether_history_basis (dressedKinematicPoint event transfer) f signal t)
  simpa only [map_sum,map_smul,←dressed_noether_jet_original,smul_eq_mul] using generated

/-- Complex Fourier readers retain their distinct real and imaginary source fields. -/
theorem actual_complex_noether_contraction (event : DressedEvent) (transfer : PhysicalMomentum)
    (V : Fin 289→ℂ) (signal : ℝ→SourceJet Field289) (t : ℝ) :
    dressedEulerObserver event
        (noetherHistoryOperatorJet (dressedKinematicPoint event transfer) (fun k=>(V k).re) signal t).value+
      Complex.I*dressedEulerObserver event
        (noetherHistoryOperatorJet (dressedKinematicPoint event transfer) (fun k=>(V k).im) signal t).value=
      ∑k : Fin 289,V k*(dressedNoetherJet event transfer signal t k).value := by
  rw [actual_noether_reader_contraction,actual_noether_reader_contraction,Finset.mul_sum,←Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro k _
  rw [←mul_assoc,←add_mul]
  congr 1
  simpa only [mul_comm] using Complex.re_add_im (V k)

