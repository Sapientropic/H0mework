private theorem pair_add_r(f g h:QuantumTest):sourcePair f (g+h)=sourcePair f g+sourcePair f h:=by simp only [sourcePair,map_add,inner_add_right]
private theorem pair_sub_r(f g h:QuantumTest):sourcePair f (g-h)=sourcePair f g-sourcePair f h:=by simp only [sourcePair,map_sub,inner_sub_right]
private theorem pair_smul_r(c:ℂ)(f g:QuantumTest):sourcePair f (c • g)=c*sourcePair f g:=by simp only [sourcePair,map_smul,inner_smul_right]
private theorem pair_norm(f:QuantumTest):(sourcePair f f).re=‖embed f‖^2:=by
  simpa only [sourcePair,RCLike.re_eq_complex_re] using inner_self_eq_norm_sq (𝕜:=ℂ) (embed f)
private theorem U_pair(f g:QuantumTest):sourcePair f (U g)=sourcePair (U f) g:=multiply_pair _ _ _ _
private theorem inverse_volume(f:QuantumTest):U (volumeAction f)=f:=by
  apply DFunLike.ext;intro z
  by_cases hz:z∈physicalChart
  · change (reciprocalVolume z:ℂ) • ((volume z:ℂ) • f z)=f z
    rw [smul_smul,←Complex.ofReal_mul]
    unfold reciprocalVolume
    rw [inv_mul_cancel₀ (volume_pos ⟨z,hz⟩).ne',Complex.ofReal_one,one_smul]
  · have h0(q:QuantumTest):q z=0:=image_eq_zero_of_notMem_tsupport (fun h=>hz (q.tsupport_subset h))
    exact (h0 _).trans (h0 _).symm
private theorem inverse_scalar_form(w:QuantumTest):
    (sourcePair w (U (scalarKinetic w))).re= -(n/2)*inverseNativeEnergy w:=by
  have hU(q:QuantumTest):scalarKinetic (U q)=U (scalarKinetic q):=by
    have h:=LinearMap.congr_fun scalar_kinetic_volume.eq (U q)
    change scalarKinetic (volumeAction (U q))=volumeAction (scalarKinetic (U q)) at h
    rw [volume_inverse] at h
    have hi:=congrArg U h
    rw [inverse_volume] at hi
    exact hi.symm
  have h:=actual_native_scalar_form (U w)
  rw [hU,volume_inverse,original_inverse_native_return] at h
  rw [U_pair]
  exact h
private theorem vacuum_constant:U*vacuumConstantAction=((n*‖vacuum‖^2:ℝ):ℂ) • (1:End):=by
  apply LinearMap.ext;intro f;apply DFunLike.ext;intro z
  by_cases hz:z∈physicalChart
  · change (reciprocalVolume z:ℂ) • (((n*volume z*‖vacuum‖^2:ℝ):ℂ) • f z)=(((n*‖vacuum‖^2:ℝ):ℂ) • f z)
    rw [smul_smul,←Complex.ofReal_mul]
    congr 1;congr 1
    unfold reciprocalVolume
    field_simp [(volume_pos ⟨z,hz⟩).ne']
  · have h0(q:QuantumTest):q z=0:=image_eq_zero_of_notMem_tsupport (fun h=>hz (q.tsupport_subset h))
    exact (h0 _).trans (h0 _).symm
private theorem local_source:U*localAction=U*centeredAction-(2:ℂ) • (U*vacuumLinearAction)+
    ((n*(‖vacuum‖^2+3):ℝ):ℂ) • (1:End):=by
  apply LinearMap.ext;intro f;apply DFunLike.ext;intro z
  by_cases hz:z∈physicalChart
  · have hc:(z.2.1:Scalar)=scalarField z-vacuum:=by unfold scalarField;abel
    have h:reciprocalVolume z*localPotential z=
        reciprocalVolume z*(n*volume z*‖scalarField z‖^2)-
        2*(reciprocalVolume z*(n*volume z*inner ℝ vacuum (scalarField z)))+n*(‖vacuum‖^2+3):=by
      unfold localPotential GaussCoframeForm.volumePotential
      rw [hc,real_inner_self_eq_norm_sq,norm_sub_sq_real,real_inner_comm (scalarField z) vacuum]
      unfold reciprocalVolume
      field_simp [(volume_pos ⟨z,hz⟩).ne']
      ring
    change (reciprocalVolume z:ℂ) • ((localPotential z:ℂ) • f z)=
      (reciprocalVolume z:ℂ) • (((n*volume z*‖scalarField z‖^2:ℝ):ℂ) • f z)-
      (2:ℂ) • ((reciprocalVolume z:ℂ) • (((n*volume z*inner ℝ vacuum (scalarField z):ℝ):ℂ) • f z))+
      ((n*(‖vacuum‖^2+3):ℝ):ℂ) • f z
    simp only [smul_smul,←Complex.ofReal_mul,←sub_smul,←add_smul]
    simpa only [Complex.ofReal_add,Complex.ofReal_sub,Complex.ofReal_mul,Complex.ofReal_ofNat] using congrArg (fun a:ℝ=>(a:ℂ) • f z) h
  · have h0(q:QuantumTest):q z=0:=image_eq_zero_of_notMem_tsupport (fun h=>hz (q.tsupport_subset h))
    exact (h0 _).trans (h0 _).symm
private theorem bulk_atoms:B=(-8:ℂ) • (U*scalarKinetic)+(8:ℂ) • (U*centeredAction)-
