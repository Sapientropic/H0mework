/-- The entire positive scalar quadratic is returned to the same full CF force, with its own defect and every remaining native department. -/
theorem actual_scalar_native_force_source(half:Bool)(F:Index)(w:QuantumTest):
    let a:=reverseNoetherFactor half
    scalarNativeSourceBlock half w=
      -4*a*(sourcePair (U w) (balancedCompressionForce F w)).re+
      4*a*(sourcePair (U w) (balancedOwnDefect F w)).re-
      (24*a+106/7)*n*inverseNativeEnergy w+120*a*(sourcePair w (U (vacuumLinearAction w))).re-
      96*a*(sourcePair w (U (matterAction w))).re-288*a*(sourcePair w (U (magneticAction w))).re-
      168*a*(sourcePair w (U (scalarSpatialAction w))).re+
      ((scalarNoetherFactor half*n^2-102*a*n)*‖vacuum‖^2-(72+432*a)*n)*‖embed w‖^2:=by
  dsimp only
  have hs:=actual_balanced_compression_departments F
  have hcf:balancedCompressionForce F=gaugeBalancedNativeForce+balancedOwnDefect F:=by
    unfold gaugeBalancedNativeForce balancedOwnDefect
    linear_combination (norm:=module) hs
  have hl:=congrArg (fun A:End=>(sourcePair w (A w)).re) local_source
  simp only [LinearMap.add_apply,LinearMap.sub_apply,LinearMap.smul_apply,Module.End.mul_apply,Module.End.one_apply,
    pair_add_r,pair_sub_r,pair_smul_r,Complex.add_re,Complex.sub_re,Complex.mul_re,Complex.ofReal_re,
    Complex.ofReal_im,Complex.re_ofNat,Complex.im_ofNat,zero_mul,sub_zero,pair_norm] at hl
  have hf:=(congrArg (fun A:End=>(sourcePair w (U (A w))).re) actual_balanced_native_departments)
  simp only [LinearMap.add_apply,LinearMap.sub_apply,LinearMap.smul_apply,map_add,map_sub,map_smul,
    pair_add_r,pair_sub_r,pair_smul_r,Complex.add_re,Complex.sub_re,Complex.mul_re,Complex.neg_re,Complex.neg_im,
    Complex.re_ofNat,Complex.im_ofNat,zero_mul,sub_zero,inverse_scalar_form] at hf
  rw [hcf]
  simp only [LinearMap.add_apply,pair_add_r,Complex.add_re,←U_pair]
  unfold scalarNativeSourceBlock reverseScalarReserve reverseNoetherNormCost
  rw [scalar_energy_source,inverse_scalar_form]
  linear_combination (norm:=ring) (4*reverseNoetherFactor half)*hf-(144*reverseNoetherFactor half)*hl
