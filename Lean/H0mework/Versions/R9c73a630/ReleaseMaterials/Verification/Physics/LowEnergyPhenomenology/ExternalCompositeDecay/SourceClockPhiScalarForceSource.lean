/-- This bound is generated by the four original vacuum columns of the fixed source. -/
theorem actual_source_vacuum_bound:‖vacuum‖≤4:=by
  have hv:vacuum=∑output:Fin 2,∑input:Fin 2,
      EuclideanSpace.single (finiteGenerationScalarIndex output input) (1:ℂ):=by
    unfold vacuum sourceGeneratedVacuumCoordinates
    rw [positive_sourceGeneratedVacuumBase]
    simp [finiteGenerationJointBreakingScalar,finiteGenerationBreakingTensor,scalarCoordinateEquiv]
  rw [hv]
  calc
    _≤∑output:Fin 2,‖∑input:Fin 2,EuclideanSpace.single (finiteGenerationScalarIndex output input) (1:ℂ)‖:=norm_sum_le _ _
    _≤∑output:Fin 2,∑input:Fin 2,‖EuclideanSpace.single (finiteGenerationScalarIndex output input) (1:ℂ)‖:=
      Finset.sum_le_sum (fun output _=>norm_sum_le _ _)
    _=4:=by simp;norm_num

/-- The source frequency gap, rather than a small-a premise, fixes the absorption scale. -/
theorem actual_source_reverse_factor_bound(half:Bool):0<reverseNoetherFactor half ∧ reverseNoetherFactor half<3:=by
  have hgap:=actual_source_noether_gap half
  have hg:0<sourceNoetherFrequency half-2*n:=by linarith
  have hnu:0<sourceNoetherFrequency half+2*n:=by linarith [n_pos]
  constructor
  · unfold reverseNoetherFactor
    exact div_pos (mul_pos (actual_scalar_noether_fraction half).1 hnu) (by norm_num)
  · unfold reverseNoetherFactor scalarNoetherFactor
    apply (div_lt_iff₀ (by norm_num:(0:ℝ)<3)).mpr
    rw [div_mul_eq_mul_div]
    apply (div_lt_iff₀ hg).mpr
    nlinarith [n_lt_one]

