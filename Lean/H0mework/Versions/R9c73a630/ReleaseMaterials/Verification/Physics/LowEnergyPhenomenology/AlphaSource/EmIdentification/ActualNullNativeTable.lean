def nullColumnTerms (n : Fin 9) : List SourceTerm := ![nullTerms0,nullTerms1,nullTerms2,nullTerms3,nullTerms4,nullTerms5,nullTerms6,nullTerms7,nullTerms8] n

private theorem null_column_terms_source (n : Fin 9) :
    columnTerms (fun i=>decide (i=nullColumnIndex n)) originalChangeTerms=nullColumnTerms n := by
  fin_cases n <;> decide +kernel

/-- Each complete original column is read from the same original finite source coefficient occurrence. -/
theorem original_null_column_literal (p : Fin 4→ℂ) (n : Fin 9) (row : Fin 289) :
    originalNullColumn p n row=sourceMatrix (nullColumnTerms n) p row (nullColumnIndex n) := by
  have generated:=congrArg (fun terms=>sourceMatrix terms p) (null_column_terms_source n)
  rw [columnTerms_value] at generated
  have value:=congrArg (fun M : Matrix (Fin 289) (Fin 289) ℂ=>M row (nullColumnIndex n)) generated
  simpa only [originalNullColumn,originalChange,projectionMatrix,Matrix.mul_diagonal,
    decide_true,ite_true,mul_one] using value

