/-- Every original reader slot is generated by the same source action derivative. -/
theorem source_reader_gradient_basis (f : Field289) (p : PhysicalMomentum) (base candidate : ActionState) :
    sourceFixedMomentumGradient f p base candidate=
      ∑j : Fin 289,f j • sourceFixedMomentumGradient (fieldUnit j) p base candidate := by
  let source : ActionState→ₗ[ℝ] FullMatrix := -(4:ℂ) •
    ((LinearMap.mulLeft ℝ (sourceActionWeight base)).comp (fderiv ℝ (sourceSymbol p) candidate).toLinearMap)
  have generated:=congrArg source (fieldDirection_coordinates f)
  simp only [map_sum,map_smul] at generated
  exact generated

/-- The complete fixed-pi insertion retains its original two independent-dual branches. -/
theorem source_reader_transport_basis (f : Field289) (p : PhysicalMomentum) (base candidate : ActionState)
    (valid : candidate∈validStates) :
    transportedRawSymbol f base candidate p=
      ∑j : Fin 289,(f j:ℂ) • transportedRawSymbol (fieldUnit j) base candidate p := by
  calc
    _=sourceFixedMomentumGradient f p base candidate := (sourceFixedMomentumGradient_raw f p base candidate valid).symm
    _=∑j : Fin 289,f j • sourceFixedMomentumGradient (fieldUnit j) p base candidate :=
      source_reader_gradient_basis f p base candidate
    _=_ := by
      apply Finset.sum_congr rfl
      intro j _
      rw [sourceFixedMomentumGradient_raw (fieldUnit j) p base candidate valid]
      exact RCLike.real_smul_eq_coe_smul (K:=ℂ) (f j) _

