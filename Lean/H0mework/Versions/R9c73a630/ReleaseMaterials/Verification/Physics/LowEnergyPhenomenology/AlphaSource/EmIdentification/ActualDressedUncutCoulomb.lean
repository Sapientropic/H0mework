/-- The complete uncut action current keeps the same Noether normalization and every original reader compensation. -/
theorem dressed_uncut_temporal_return (event : DressedEvent) (transfer : PhysicalMomentum) (a : Fin 12) :
    (∑i : Fin 289,(temporalField a i:ℂ)*dressedUncutCurrent event transfer i)=
      dressedEulerObserver event (dressedNoetherKernel event transfer (temporalField a) 0 0)-
        dressedEulerObserver event
          (jointResolvent (event.momentum-transfer) event.frame event.energy 0*
            temporalReaderCompensation a event.momentum event.frame*
            jointResolvent event.momentum event.frame event.energy 0) := by
  have continuousRead : Continuous (fun v : Fin 289→ℂ=>∑i : Fin 289,(temporalField a i:ℂ)*v i) := by fun_prop
  exact tendsto_nhds_unique
    (continuousRead.continuousAt.tendsto.comp (dressed_uncut_current_generated event transfer))
    (dressed_temporal_common_cut_limit event transfer a)

/-- Both original whole289 external currents are generated by the retained source cutoff limit. -/
def dressedUncutMatrixRead (detector source : DressedEvent) (transfer : PhysicalMomentum) : WholeMatrix→L[ℝ]ℂ :=
  ({toFun:=fun M=>dotProduct (dressedUncutCurrent detector (-transfer)) (M*ᵥdressedUncutCurrent source transfer)
    map_add':=fun M N=>by rw [Matrix.add_mulVec,dotProduct_add]
    map_smul':=fun r M=>by simp only [Matrix.smul_mulVec,dotProduct_smul,RingHom.id_apply,Complex.real_smul]} :
    WholeMatrix→ₗ[ℝ]ℂ).toContinuousLinearMap

theorem dressed_uncut_matrix_read (detector source : DressedEvent) (transfer : PhysicalMomentum) (M : WholeMatrix) :
    dressedUncutMatrixRead detector source transfer M=
      dotProduct (dressedUncutCurrent detector (-transfer)) (M*ᵥdressedUncutCurrent source transfer) := rfl

private theorem matrix_pair_limit (M : WholeMatrix) (l r : ℕ→Fin 289→ℂ) (L R : Fin 289→ℂ)
    (left : Tendsto l atTop (𝓝 L)) (right : Tendsto r atTop (𝓝 R)) :
    Tendsto (fun cut=>dotProduct (l cut) (M*ᵥr cut)) atTop (𝓝 (dotProduct L (M*ᵥR))) := by
  have continuousRead : Continuous (fun pair : (Fin 289→ℂ)×(Fin 289→ℂ)=>dotProduct pair.1 (M*ᵥpair.2)) := by
    unfold dotProduct Matrix.mulVec
    fun_prop
  exact continuousRead.continuousAt.tendsto.comp (left.prodMk_nhds right)

private theorem scalar_limit_transport (f g : ℕ→ℂ) (v w : ℂ) (same : f=g) (value : v=w)
    (paid : Tendsto g atTop (𝓝 v)) : Tendsto f atTop (𝓝 w) := by
  rw [same,←value]
  exact paid

/-- The same original cutoff, on both actual external legs, tends to this complete uncut Green read. -/
theorem dressed_uncut_matrix_generated (detector source : DressedEvent) (transfer : PhysicalMomentum) (M : WholeMatrix) :
    Tendsto (fun cut=>dressedMatrixRead {detector with cut:=cut} {source with cut:=cut} transfer M) atTop
      (𝓝 (dressedUncutMatrixRead detector source transfer M)) := by
  have same : (fun cut=>dressedMatrixRead {detector with cut:=cut} {source with cut:=cut} transfer M)=
      fun cut=>dotProduct
        (sourceDressedConnectedCurrent detector.epsilon detector.precision detector.momentum transfer
          detector.frame cut detector.energy detector.energy)
        (M*ᵥsourceDressedConnectedCurrent source.epsilon source.precision source.momentum (-transfer)
          source.frame cut source.energy source.energy) := by
    funext cut
    rw [dressed_matrix_read]
    simp only [dressedCurrent,neg_neg]
  exact scalar_limit_transport _ _ _ _ same (dressed_uncut_matrix_read detector source transfer M).symm
    (matrix_pair_limit M
      (fun cut=>sourceDressedConnectedCurrent detector.epsilon detector.precision detector.momentum transfer
        detector.frame cut detector.energy detector.energy)
      (fun cut=>sourceDressedConnectedCurrent source.epsilon source.precision source.momentum (-transfer)
        source.frame cut source.energy source.energy)
      (dressedUncutCurrent detector (-transfer)) (dressedUncutCurrent source transfer)
      (by simpa only [neg_neg] using dressed_uncut_current_generated detector (-transfer))
      (dressed_uncut_current_generated source transfer))

/-- This is the full original five-mode compression, with no gauge-support or output-charge eigen premise. -/
def dressedUncutOriginCurrent (event : DressedEvent) : Fin 289→ℂ :=
  fullNativeOrigin.transpose*ᵥdressedUncutCurrent event 0

theorem dressed_uncut_static_full_origin (detector source : DressedEvent) :
    dressedUncutMatrixRead detector source 0 wholeStaticLimit=
      -dotProduct (dressedUncutOriginCurrent detector) (staticInverse*ᵥdressedUncutOriginCurrent source) := by
  rw [dressed_uncut_matrix_read,wholeStaticLimit,Matrix.neg_mulVec,dotProduct_neg]
  simp only [neg_zero]
  rw [←Matrix.mulVec_mulVec,←Matrix.mulVec_mulVec]
  congr 1
  exact (Matrix.dotProduct_transpose_mulVec fullNativeOrigin
    (staticInverse*ᵥ(fullNativeOrigin.transpose*ᵥdressedUncutCurrent source 0)) (dressedUncutCurrent detector 0)).symm.trans
      (dotProduct_comm _ _)

/-- The original algebraic contact and propagating action inverse remain separate terms of the same potential. -/
theorem dressed_uncut_green_contact (detector source : DressedEvent) (transfer : PhysicalMomentum) (p : regularSource) :
    dressedUncutMatrixRead detector source transfer (sourceGreen p)=
      dressedUncutMatrixRead detector source transfer (originalChange p*contactInverse p*originalReadback p)+
      dressedUncutMatrixRead detector source transfer
        (originalChange p*(activeProjection*(extendedKernel p)⁻¹)*originalReadback p) := by
  rw [sourceGreen,Matrix.mul_add,Matrix.add_mul,map_add]

private theorem uncut_read_complex_smul (detector source : DressedEvent) (transfer : PhysicalMomentum)
    (a : ℂ) (M : WholeMatrix) :
    dressedUncutMatrixRead detector source transfer (a • M)=a*dressedUncutMatrixRead detector source transfer M := by
  rw [dressed_uncut_matrix_read,dressed_uncut_matrix_read,Matrix.smul_mulVec,dotProduct_smul]
  rfl

/-- The finite-momentum potential retains its complete regular/contact term and original active inverse before taking a residue. -/
theorem dressed_uncut_static_potential (detector source : DressedEvent) (n : PhysicalMomentum)
    (unit : spatialSquare n=1) (r : staticDomain) :
    (r.val^2:ℝ) • dressedUncutMatrixRead detector source 0 (sourceGreen (sourceSpatialStaticRegularPoint n unit r))=
      (r.val^2:ℝ) • dressedUncutMatrixRead detector source 0 (wholeRegular (sourceStaticSpatialMomentum n r.val))-
      dressedUncutMatrixRead detector source 0
        (wholeFrame (sourceStaticSpatialMomentum n r.val)*(sourceStaticSpatialKernel n unit r)⁻¹*
          (wholeFrame (-(sourceStaticSpatialMomentum n r.val))).transpose) := by
  have paid:=congrArg (dressedUncutMatrixRead detector source 0) (whole_static_green_scaled n unit r)
  change dressedUncutMatrixRead detector source 0
      ((r.val^2:ℝ) • sourceGreen (sourceSpatialStaticRegularPoint n unit r))=
    dressedUncutMatrixRead detector source 0
      ((r.val^2:ℝ) • wholeRegular (sourceStaticSpatialMomentum n r.val)-
        wholeFrame (sourceStaticSpatialMomentum n r.val)*(sourceStaticSpatialKernel n unit r)⁻¹*
          (wholeFrame (-(sourceStaticSpatialMomentum n r.val))).transpose) at paid
  simpa only [map_sub,map_smul] using paid

/-- The uncut actual observer consumes the original whole action Green Fourier packet once. -/
def dressedUncutCoulombPacket (detector source : DressedEvent) (scale : ℝ)
    (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) : ℂ :=
  dressedUncutMatrixRead detector source 0 (wholeCoulombIRPacket scale test x)

theorem dressed_uncut_coulomb_packet_original (detector source : DressedEvent) (scale : ℝ)
    (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) :
    dressedUncutCoulombPacket detector source scale test x=
      ∫ frequency,sourceSpatialPhase frequency x*test frequency*
        dotProduct (dressedUncutCurrent detector 0)
          (wholeCoulombIRSymbol scale (sourceSpatialMomentum frequency)*ᵥdressedUncutCurrent source 0) := by
  unfold dressedUncutCoulombPacket wholeCoulombIRPacket
  rw [←(dressedUncutMatrixRead detector source 0).integral_comp_comm (whole_coulomb_ir_packet_integrable scale test x)]
  apply integral_congr_ae
  filter_upwards with frequency
  rw [uncut_read_complex_smul,dressed_uncut_matrix_read]
  simp only [neg_zero]

/-- Cutoff removal precedes the original physical momentum dilation; the second limit is the genuine Newton kernel. -/
theorem dressed_cut_then_coulomb_spatial_limit (detector source : DressedEvent)
    (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) :
    (∀scale : ℝ,Tendsto (fun cut=>dressedCoulombPacket {detector with cut:=cut} {source with cut:=cut} scale test x)
      atTop (𝓝 (dressedUncutCoulombPacket detector source scale test x))) ∧
    Tendsto (fun scale : ℝ=>dressedUncutCoulombPacket detector source scale test x) (𝓝[>] 0)
      (𝓝 ((∫ y,(4*(Real.pi:ℂ)*(Real.sqrt (spatialSquare y):ℂ))⁻¹*emPacket test (x-y))*
        (-dotProduct (dressedUncutOriginCurrent detector) (staticInverse*ᵥdressedUncutOriginCurrent source)))) := by
  constructor
  · intro scale
    exact dressed_uncut_matrix_generated detector source 0 (wholeCoulombIRPacket scale test x)
  · have paid:=(dressedUncutMatrixRead detector source 0).continuous.tendsto _ |>.comp (whole_coulomb_ir_packet_limit test x)
    rw [uncut_read_complex_smul,dressed_uncut_static_full_origin] at paid
    simpa only [em_newton_massless_convolution,dressedUncutCoulombPacket,Function.comp_def] using paid

