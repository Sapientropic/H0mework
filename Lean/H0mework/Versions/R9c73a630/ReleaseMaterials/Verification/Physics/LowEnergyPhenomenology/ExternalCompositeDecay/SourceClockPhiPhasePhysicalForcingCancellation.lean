private abbrev End:=QuantumTest→ₗ[ℂ]QuantumTest
private abbrev H0:End:=diagonalAction
attribute [local irreducible] diagonalAction resolventCore coreEquiv phaseRow inputSeed normalizedState normalizedForcing
  compressionCore defectAction balancedCompressionForce wholeClockState wholeClockWord wholeSourceNext wholeSourceMap correctedCompleteCore
  sourcePair embed phaseCompressionDefect
theorem actual_original_phase_state(m ell:ℕ)(F:Index)(z:ℂ)(hz:z.im≠0)(g:diagonal.domain):
    normalizedState m ell F z hz g=∑i:Fin 2,phaseRow m ell i (resolventCore F z hz (coreEquiv.symm (inputSeed g i))):=by
  simp only [Fin.sum_univ_two]
  have hr:coreEquiv.symm (phiRadiusSource g)=phiRadiusAction (coreEquiv.symm g):=by
    unfold phiRadiusSource
    exact coreEquiv.symm_apply_apply _
  unfold normalizedState phaseRow inputSeed
  change phiThetaAction m ell (resolventCore F z hz (coreEquiv.symm g))-
    phiInverseAction (phiThetaAction m ell (resolventCore F z hz (phiRadiusAction (coreEquiv.symm g))))=
    phiThetaAction m ell (resolventCore F z hz (coreEquiv.symm g))+
    (-(phiInverseAction*phiThetaAction m ell)) (resolventCore F z hz (coreEquiv.symm (phiRadiusSource g)))
  simp only [hr,LinearMap.neg_apply,Module.End.mul_apply,sub_eq_add_neg]
theorem actual_original_phase_forcing(m ell:ℕ)(F:Index)(z:ℂ)(hz:z.im≠0)(g:diagonal.domain):
    normalizedForcing m ell F z hz g=∑i:Fin 2,wordPhysicalEscape F (phaseRow m ell i)
      (resolventCore F z hz (coreEquiv.symm (inputSeed g i))):=by
  simp only [Fin.sum_univ_two]
  have hr:coreEquiv.symm (phiRadiusSource g)=phiRadiusAction (coreEquiv.symm g):=by
    unfold phiRadiusSource
    exact coreEquiv.symm_apply_apply _
  unfold normalizedForcing wordPhysicalEscape phaseRow inputSeed bracket
  simp only [Matrix.cons_val_zero,Matrix.cons_val_one,hr,LinearMap.add_apply,LinearMap.sub_apply,
    LinearMap.neg_apply,Module.End.mul_apply,map_neg]
  module

/-- The only phase source remaining after force/current cancellation is generated by the original own-cutoff derivation. -/
def phaseOwnSource(m ell:ℕ)(F:Index)(z:ℂ)(hz:z.im≠0)(g:diagonal.domain):QuantumTest:=
  ∑i:Fin 2,(bracket (phaseCompressionDefect F) (phaseRow m ell i)+
    (6:ℂ) • (defectAction F*phaseRow m ell i))
      (resolventCore F z hz (coreEquiv.symm (inputSeed g i)))
attribute [local irreducible] phaseOwnSource
private theorem phase_escape_joint(F:Index)(m ell:ℕ)(i:Fin 2):
    bracket (balancedCompressionForce F) (phaseRow m ell i)+(6:ℂ) • wordPhysicalEscape F (phaseRow m ell i)=
      bracket (phaseCompressionDefect F) (phaseRow m ell i)+(6:ℂ) • (defectAction F*phaseRow m ell i):=by
  have h:=actual_balanced_compression_phase_current F m ell i
  unfold wordPhysicalEscape
  have hd:H0=compressionCore F+defectAction F:=by unfold defectAction;module
  change bracket (balancedCompressionForce F) (phaseRow m ell i)+
    (6:ℂ) • (bracket H0 (phaseRow m ell i)+phaseRow m ell i*defectAction F)=_
  rw [hd]
  unfold bracket at h ⊢
  linear_combination (norm:=(noncomm_ring;module)) h

/-- The actual two-seed full forcing cancels the native phase part of the compressed force, without removing its own delta source. -/
theorem actual_normalized_phase_force_cancellation(m ell:ℕ)(F:Index)(z:ℂ)(hz:z.im≠0)(g:diagonal.domain):
    (∑i:Fin 2,bracket (balancedCompressionForce F) (phaseRow m ell i)
      (resolventCore F z hz (coreEquiv.symm (inputSeed g i))))+
        (6:ℂ) • normalizedForcing m ell F z hz g=phaseOwnSource m ell F z hz g:=by
  rw [actual_original_phase_forcing]
  simp only [Finset.smul_sum,←Finset.sum_add_distrib]
  unfold phaseOwnSource
  apply Finset.sum_congr rfl;intro i _
  exact LinearMap.congr_fun (phase_escape_joint F m ell i) _

/-- The outer source word is arbitrary here so the actual clock/electric commutator remains explicit at its physical consumer. -/
theorem actual_word_phase_force_cancellation(m ell:ℕ)(F:Index)(z:ℂ)(hz:z.im≠0)(g:diagonal.domain)(T:End):
    (∑i:Fin 2,bracket (balancedCompressionForce F) (T*phaseRow m ell i)
      (resolventCore F z hz (coreEquiv.symm (inputSeed g i))))+
      (6:ℂ) • (T (normalizedForcing m ell F z hz g)+bracket H0 T (normalizedState m ell F z hz g))=
        (bracket (balancedCompressionForce F) T+(6:ℂ) • bracket H0 T) (normalizedState m ell F z hz g)+
          T (phaseOwnSource m ell F z hz g):=by
  have h:=congrArg T (actual_normalized_phase_force_cancellation m ell F z hz g)
  have hp(i:Fin 2):bracket (balancedCompressionForce F) (T*phaseRow m ell i)=
      bracket (balancedCompressionForce F) T*phaseRow m ell i+T*bracket (balancedCompressionForce F) (phaseRow m ell i):=by
    unfold bracket;noncomm_ring
  simp_rw [hp]
  simp only [LinearMap.add_apply,LinearMap.smul_apply,Module.End.mul_apply,Finset.sum_add_distrib,←map_sum]
  rw [←actual_original_phase_state]
  simp only [map_add,map_smul] at h
  linear_combination (norm:=module) h
private theorem frequency_positive(half:Bool):0<sourceNoetherFrequency half:=by
  have hn:0<sourceTime 0:=by
    rw [source_time_generated]
    exact SaturationMonoid.PhysicsCore.Stage9C.Material.SpinPair.lapse_pos
  linarith [actual_source_noether_gap half]
private abbrev hz(half advanced:Bool)(q:ℝ):
    (actualFrequency advanced (sourceNoetherFrequency half) q).im≠0:=
  reverse_frequency_nonreal advanced _ (frequency_positive half) q
private abbrev actualWord(s:ℝ)(hs:0<s)(half advanced:Bool)(m ell:ℕ)(F:Index)(g:diagonal.domain)(x:ℝ×ℝ):End:=
  correctedCompleteCore s hs x.1 x.2*wholeSourceMap s hs half advanced m ell F g
private theorem actual_forcing_return(s:ℝ)(hs:0<s)(half advanced:Bool)(m ell:ℕ)(F:Index)(g:diagonal.domain)(x:ℝ×ℝ)(q:ℝ):
    (clockSourcePair s hs x (wholeSourceNext s hs half advanced m ell F g q)).2=
      actualWord s hs half advanced m ell F g x
        (normalizedForcing m ell F (actualFrequency advanced (sourceNoetherFrequency half) q) (hz half advanced q) g)+
      bracket H0 (actualWord s hs half advanced m ell F g x) (frequencyState half advanced m ell F g q):=by
  unfold actualWord
  unfold clockSourcePair wholeSourceNext wholeSourceMap electricSourceDirection bracket
  simp only [Prod.snd_add,Prod.fst_add,Prod.smul_snd,Prod.smul_fst,LinearMap.add_apply,LinearMap.sub_apply,
    LinearMap.smul_apply,Module.End.mul_apply,Module.End.one_apply,map_add,map_sub,map_smul]
  module

/-- Literal physical forcing, both original RF legs, the full clock/electric outer current and the complete own-cutoff term occur in one exact cancellation. -/
theorem actual_whole_phase_force_cancellation(s:ℝ)(hs:0<s)(half advanced:Bool)(m ell:ℕ)(F:Index)(g:diagonal.domain)(x:ℝ×ℝ)(q:ℝ):
    balancedWholeForceOuter s hs half advanced m ell F g x q+
      (6:ℂ) • (clockSourcePair s hs x (wholeSourceNext s hs half advanced m ell F g q)).2=
        (bracket (balancedCompressionForce F) (actualWord s hs half advanced m ell F g x)+
          (6:ℂ) • bracket H0 (actualWord s hs half advanced m ell F g x))
          (frequencyState half advanced m ell F g q)+
        actualWord s hs half advanced m ell F g x
          (phaseOwnSource m ell F (actualFrequency advanced (sourceNoetherFrequency half) q) (hz half advanced q) g):=by
  rw [actual_forcing_return]
  have h:=actual_word_phase_force_cancellation m ell F
    (actualFrequency advanced (sourceNoetherFrequency half) q) (hz half advanced q) g
    (actualWord s hs half advanced m ell F g x)
  simpa only [balancedWholeForceOuter,wholeClockWord,actualWord,frequencyState,mul_assoc] using h
end LowEnergy.PhaseCompressionCancellation
