attribute [local simp] Matrix.cons_val_two Matrix.cons_val_three

def sourceTimeSpinSign (i : Fin 4) : ℝ := if i.val<2 then -1 else 1

def sourceTimeSignMatrix : FullMatrix :=
  SourceRealScalarFock.branches (Quantum.operatorMatrix Stage10.CanonicalMatter.temporalMother)

def sourceTimeModeSign : Mode→ℝ := Sum.elim
  (fun i=>sourceTimeSpinSign i.1) (fun i=>-sourceTimeSpinSign i.1)

theorem sourceTimeMother_generated :
    Stage10.CanonicalMatter.temporalMother=diracMatrixMatterAction
      (Matrix.diagonal (fun i=>(sourceTimeSpinSign i:ℂ))) := by
  apply LinearMap.ext
  intro v
  funext i
  fin_cases i <;>
    simp [Stage10.CanonicalMatter.temporalMother,flipMatter,Stage9DEF.Compatibility.spinFlip,
      diracMatrixMatterAction,diracGammaZero,Fin.sum_univ_four,sourceTimeSpinSign,Matrix.diagonal_apply]

theorem sourceTimePrimal_entry (i j : Quantum.Index) :
    Quantum.operatorMatrix Stage10.CanonicalMatter.temporalMother i j=
      if i=j then (sourceTimeSpinSign i.1:ℂ) else 0 := by
  rw [sourceTimeMother_generated]
  change spinCoordinates _ i j=_
  rw [sourceSpinMatrix_entry]
  simp only [Matrix.diagonal_apply]
  rcases i with ⟨s,c⟩
  rcases j with ⟨t,d⟩
  by_cases a : s=t <;> by_cases b : c=d <;>
    simp [a,b]

theorem sourceTimeSignMatrix_diagonal :
    sourceTimeSignMatrix=Matrix.diagonal (fun i=>(sourceTimeModeSign i:ℂ)) := by
  ext i j
  cases i <;> cases j <;>
    simp [sourceTimeSignMatrix,SourceRealScalarFock.branches,Matrix.map_apply,
      sourceTimePrimal_entry,sourceTimeModeSign,Matrix.diagonal_apply]
  split_ifs <;> simp

theorem sourceTimeSignMatrix_actual (s e : Fin 2) :
    sourceTimeModeSign (Sum.inl (sourceChargedQuantumIndex s e))=if s=0 then -1 else 1 := by
  fin_cases s <;> fin_cases e <;>
    norm_num [sourceTimeModeSign,sourceTimeSpinSign,sourceChargedQuantumIndex,sourceChargedBasisIndex]

private theorem branches_real (r : ℝ) (A : SourceMatrix) :
    SourceRealScalarFock.branches ((r:ℂ) • A)=(r:ℂ) • SourceRealScalarFock.branches A := by
  ext i j
  cases i <;> cases j <;>
    simp [SourceRealScalarFock.branches,Matrix.map_apply,Matrix.smul_apply]

theorem sourceTimeMatrix_actual (z : physicalChart) :
    sourcePreparedTimeMatrix (sourceState z.val)=
      ((Stage10.ActionNormalization.phaseMomentum*GaussNativeEnergy.volume z.val:ℝ):ℂ) •
        Quantum.operatorMatrix Stage10.CanonicalMatter.temporalMother := by
  rw [sourcePreparedTimeMatrix_generated,sourceInversePhase_actual,mul_smul_comm,
    ←Quantum.matrix_composition,smul_smul,Complex.ofReal_mul]
  rfl

theorem sourceWeightSymbol_signed (z : physicalChart) :
    sourceWeightSymbol z.val=
      ((Stage10.ActionNormalization.phaseMomentum*GaussNativeEnergy.volume z.val:ℝ):ℂ) • sourceTimeSignMatrix := by
  change (4:ℂ) • sourceActionWeight (sourceState z.val)=_
  rw [←sourceTimeWeight_original,sourceTimeWeight,sourceTimeMatrix_actual,branches_real]
  rfl

theorem sourceWeightFiber_signed (z : physicalChart) :
    weightFiber z.val=
      ((Stage10.ActionNormalization.phaseMomentum*GaussNativeEnergy.volume z.val:ℝ):ℂ) • quantizer sourceTimeSignMatrix := by
  rw [weightFiber,sourceWeightSymbol_signed,map_smul]

theorem sourceTemporalRaw_signed (z : physicalChart) (p : PhysicalMomentum) :
    rawActionSymbol (sourceEnergyAxisField 1 0) p (sourceState z.val)=
      -((Stage10.ActionNormalization.phaseMomentum*GaussNativeEnergy.volume z.val:ℝ):ℂ) •
        (sourceTimeSignMatrix*sourceFirstChargeMatrix) := by
  rw [sourceFirstTemporal_raw _ (sourceState_valid z)]
  change (-(4:ℂ) • sourceActionWeight (sourceState z.val))*sourceFirstChargeMatrix=_
  rw [neg_smul]
  change -(sourceWeightSymbol z.val)*sourceFirstChargeMatrix=_
  rw [sourceWeightSymbol_signed,neg_mul,smul_mul_assoc,neg_smul]

theorem sourceTemporalFiber_signed (z : physicalChart) (p : PhysicalMomentum) :
    rawFiber (sourceEnergyAxisField 1 0) p (0,z.val)=
      -((Stage10.ActionNormalization.phaseMomentum*GaussNativeEnergy.volume z.val:ℝ):ℂ) •
        quantizer (sourceTimeSignMatrix*sourceFirstChargeMatrix) := by
  rw [rawFiber,ambientState_zero,sourceTemporalRaw_signed,map_smul]

