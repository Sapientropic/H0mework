/-- The actual first full200 column is evaluated with all twelve native generators at each of its four spacetime slots. -/
def sourcePolarizationAxisLower (s : ActionState) (k : Fin 4) : SourceMatrix :=
  ∑mu : Fin 4,coefficientMatrix mu s.1*nativePrimal (sourceFirstGaugeConnection k mu)

def sourcePolarizationAxisEnergy (s : ActionState) (k : Fin 4) : SourceMatrix :=
  (-Complex.I) • (Ring.inverse (principalMatrix s.1)*sourcePolarizationAxisLower s k)

/-- The computed 192 gauge slots are consumed at arbitrary valid coframe, before Gauss preparation. -/
theorem sourcePolarizationAxis_symbol (s : ActionState) (valid : s∈validStates)
    (p : PhysicalMomentum) (k : Fin 4) :
    symbolFirst p s (fieldDirection (sourceEnergyAxisField 1 k))=
      SourceRealScalarFock.branches (sourcePolarizationAxisEnergy s k) := by
  rw [←sourceNormalizedEnergySymbol_original p s _ valid,sourceFirstGauge_state,
    sourceNormalizedEnergySymbol_connection p s valid]
  rfl

/-- Raw density retains its actual action weight and independent dual, rather than identifying the raw reader with the Hamiltonian derivative. -/
theorem sourcePolarizationAxis_raw (s : ActionState) (valid : s∈validStates)
    (p : PhysicalMomentum) (k : Fin 4) :
    rawActionSymbol (sourceEnergyAxisField 1 k) p s=
      -(4:ℂ) • (sourceActionWeight s*SourceRealScalarFock.branches (sourcePolarizationAxisEnergy s k)) := by
  rw [rawActionSymbol_source _ p s valid,sourcePolarizationAxis_symbol s valid]

private theorem axis_coframe (s : ActionState) (r : ℝ) (k : Fin 4) :
    (s+r • fieldDirection (sourceEnergyAxisField 1 k)).1=s.1 := by
  rw [sourceFirstGauge_state]
  simp only [Prod.fst_add,Prod.smul_fst,smul_zero,add_zero]

private theorem axis_valid (s : ActionState) (valid : s∈validStates) (r : ℝ) (k : Fin 4) :
    s+r • fieldDirection (sourceEnergyAxisField 1 k)∈validStates := by
  change (s+r • fieldDirection (sourceEnergyAxisField 1 k)).1.det≠0 ∧
    StageNineCurrentCoframeMatterTemporalPrincipal.coframeTemporalPrincipalScalar
      (s+r • fieldDirection (sourceEnergyAxisField 1 k)).1≠0
  rw [axis_coframe]
  exact valid

private theorem axis_weight (s : ActionState) (r : ℝ) (k : Fin 4) :
    sourceActionWeight (s+r • fieldDirection (sourceEnergyAxisField 1 k))=sourceActionWeight s := by
  simp only [sourceActionWeight,inversePhase,stateVolume,axis_coframe]

private theorem axis_energy (s : ActionState) (r : ℝ) (k l : Fin 4) :
    sourcePolarizationAxisEnergy (s+r • fieldDirection (sourceEnergyAxisField 1 l)) k=
      sourcePolarizationAxisEnergy s k := by
  simp only [sourcePolarizationAxisEnergy,sourcePolarizationAxisLower,axis_coframe]

/-- Both first-column gauge directions have exactly zero raw density contact on the whole physical chart. The full material Hessian is not discarded. -/
theorem sourcePolarizationAxis_rawContact (s : ActionState) (valid : s∈validStates)
    (p : PhysicalMomentum) (k l : Fin 4) :
    rawActionContact (sourceEnergyAxisField 1 k) p s (fieldDirection (sourceEnergyAxisField 1 l))=0 := by
  have derivative:=((rawActionSymbol_smooth (sourceEnergyAxisField 1 k) p s valid).differentiableAt (by simp)).hasFDerivAt
  have path:=derivative.comp_hasDerivAt_of_eq 0 (state_line s (fieldDirection (sourceEnergyAxisField 1 l))) (by simp)
  have same : (fun r : ℝ=>rawActionSymbol (sourceEnergyAxisField 1 k) p
      (s+r • fieldDirection (sourceEnergyAxisField 1 l)))=
      (fun _ : ℝ=>rawActionSymbol (sourceEnergyAxisField 1 k) p s) := by
    funext r
    rw [sourcePolarizationAxis_raw _ (axis_valid s valid r l),
      sourcePolarizationAxis_raw s valid,axis_weight,axis_energy]
  dsimp only [Function.comp_def] at path
  rw [same] at path
  exact path.unique (hasDerivAt_const (0:ℝ) _)

/-- The independently generated second Hamiltonian coefficient is also evaluated, without replacing the full Gauss generator Hessian. -/
theorem sourcePolarizationAxis_symbolSecond (s : ActionState) (valid : s∈validStates)
    (p : PhysicalMomentum) (k l : Fin 4) :
    symbolSecond p s (fieldDirection (sourceEnergyAxisField 1 k))
      (fieldDirection (sourceEnergyAxisField 1 l))=0 := by
  have path:=symbol_second_generated p s (fieldDirection (sourceEnergyAxisField 1 k))
    (fieldDirection (sourceEnergyAxisField 1 l)) valid
  have same : (fun r : ℝ=>symbolFirst p (s+r • fieldDirection (sourceEnergyAxisField 1 l))
      (fieldDirection (sourceEnergyAxisField 1 k)))=
      (fun _ : ℝ=>SourceRealScalarFock.branches (sourcePolarizationAxisEnergy s k)) := by
    funext r
    rw [sourcePolarizationAxis_symbol _ (axis_valid s valid r l),axis_energy]
  rw [same] at path
  exact path.unique (hasDerivAt_const (0:ℝ) _)

theorem sourcePolarizationAxis_rawFiber (p : PhysicalMomentum) (z : physicalChart) (k : Fin 4) :
    rawFiber (sourceEnergyAxisField 1 k) p (0,z.val)=
      quantizer (-(4:ℂ) • (sourceActionWeight (sourceState z.val)*
        SourceRealScalarFock.branches (sourcePolarizationAxisEnergy (sourceState z.val) k))) := by
  rw [rawFiber,ambientState_zero,sourcePolarizationAxis_raw _
    (PreparationVacuumNonlinearFieldCurve.sourceState_valid z)]

private theorem axis_contact_form (p : PhysicalMomentum) (k l : Fin 4) (a b : QuantumTest) :
    rawContactForm (sourceEnergyAxisField 1 k) (sourceEnergyAxisField 1 l) p a b=0 := by
  unfold rawContactForm
  apply MeasureTheory.integral_eq_zero_of_ae
  filter_upwards with z
  by_cases inside : z∈tsupport a
  · have chart : z∈physicalChart:=a.tsupport_subset inside
    have valid:=PreparationVacuumNonlinearFieldCurve.sourceState_valid (⟨z,chart⟩:physicalChart)
    simp only [rawContactSample,rawContact,ambientState_zero,
      sourcePolarizationAxis_rawContact _ valid,map_zero,zero_apply,pairSample,WithLp.ofLp_zero,Pi.zero_apply,mul_zero,Finset.sum_const_zero]
  · simp only [rawContactSample,image_eq_zero_of_notMem_tsupport inside,pairSample_zero_left,Pi.zero_apply]

/-- Both physical-frame labels are retained by the original finiteRiesz reader; the computed raw contact vanishes before this compression. -/
theorem sourcePolarizationAxis_readerContact (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) (k l : Fin 4) :
    rawReaderContact (sourceEnergyAxisField 1 k) (sourceEnergyAxisField 1 l) p F=0 := by
  simp only [rawReaderContact,axis_contact_form,finiteRiesz,zero_smul,Finset.sum_const_zero]

/-- This evaluates index2 of the actual five-term response; the two time slopes and two Green insertions remain original. -/
theorem sourcePolarizationAxis_timeContact (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (k l : Fin 4) (age : ℝ) :
    sourceUnitTimeParts q sL eL sR eR (sourceEnergyAxisField 1 k) (sourceEnergyAxisField 1 l) age 2=0 := by
  simp only [sourceUnitTimeParts,Matrix.cons_val_two,sourcePolarizationAxis_readerContact,
    mul_zero,zero_mul,map_zero,neg_zero]
  rfl

/-- Literal weighted first-axis current, integrated in the actual source configuration measure and compressed by the original two independent frame labels. -/
def sourcePolarizationAxisReader (_p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) (k : Fin 4) : H→L[ℂ]H :=
  finiteRiesz F (fun i j=>∫z,pairSample z (frameTest F i z)
    (quantizer (-(4:ℂ) • (sourceActionWeight (sourceState z)*
      SourceRealScalarFock.branches (sourcePolarizationAxisEnergy (sourceState z) k))) (frameTest F j z))
      ∂GaussHistoryHilbert.configurationMeasure)

theorem sourcePolarizationAxis_reader (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) (k : Fin 4) :
    PreparationVacuumRawJointFeedback.rawReader (sourceEnergyAxisField 1 k) p F 0=
      sourcePolarizationAxisReader p F k := by
  unfold PreparationVacuumRawJointFeedback.rawReader sourcePolarizationAxisReader
  apply congrArg (finiteRiesz F)
  funext i j
  unfold rawForm
  apply MeasureTheory.integral_congr_ae
  filter_upwards with z
  by_cases inside : z∈tsupport (frameTest F i)
  · have chart : z∈physicalChart:=(frameTest F i).tsupport_subset inside
    simpa only [rawSample] using congrArg
      (fun A : CanonicalGradedLocalCurrent.FiberMap=>pairSample z (frameTest F i z) (A (frameTest F j z)))
      (sourcePolarizationAxis_rawFiber p ⟨z,chart⟩ k)
  · simp only [rawSample,image_eq_zero_of_notMem_tsupport inside,pairSample_zero_left]

