/-- The exterior hypercharge weight of the internal summand of a whole
    252-state index. -/
def emHyperchargeWeight (i : Quantum.Index) : ℤ :=
  match i.2 with
  | Sum.inl a => exteriorHyperchargeWeight a
  | Sum.inr (Sum.inl a) => exteriorHyperchargeWeight a
  | Sum.inr (Sum.inr a) => exteriorHyperchargeWeight a

/-- The electromagnetic charge weight `qEM = qX - qD` on the whole
    252-state index. -/
def emChargeWeight (i : Quantum.Index) : ℚ :=
  -sourceWholeWeight i+((emHyperchargeWeight i:ℚ)-1)/2

/-- The canonical electromagnetic charge action matrix on the source
    quantum indices. -/
def emCanonicalChargeMatrix : SourceMatrix :=
  Quantum.operatorMatrix (Complex.I • emGaugeAction)

/-- The electromagnetic charge matrix on the full independent
    particle/antiparticle modes. -/
def emGaugeChargeMatrix : FullMatrix :=
  SourceRealScalarFock.branches (Quantum.operatorMatrix (Complex.I • emGaugeAction))

/-- The defect charge matrix carried by the same independent branches. -/
def emGaugeDefectMatrix : FullMatrix :=
  SourceRealScalarFock.branches (Quantum.operatorMatrix (Complex.I • emFullDefect))

/-- The electromagnetic charge lifted to the full source Hilbert space. -/
def emGaussCharge : H →L[ℂ] H :=
  GaussFockLift.lift (quantized emGaugeChargeMatrix)

/-- The defect charge lifted to the full source Hilbert space. -/
def emGaussDefectCharge : H →L[ℂ] H :=
  GaussFockLift.lift (quantized emGaugeDefectMatrix)

/-- The all-component Hamiltonian insertion generated by the
    electromagnetic gauge direction. -/
def emHamiltonianInsertion (s : ActionState) (mu : Fin 4) : SourceMatrix :=
  Fin.cases (-emCanonicalChargeMatrix)
    (fun j => -(stateHamiltonian s j.succ*emCanonicalChargeMatrix)) mu

private theorem emla_neg (matrix : SU7MotherLieMatrix) :
    diracExteriorMotherLieAction (-matrix) =
      -diracExteriorMotherLieAction matrix := by
  rw [show (-matrix) = (-1:ℝ) • matrix from (neg_one_smul ℝ matrix).symm]
  rw [StageNineP286GaugeConnectionVariation.diracExteriorMotherLieAction_real_smul]
  push_cast
  module

private theorem emla_sub (first second : SU7MotherLieMatrix) :
    diracExteriorMotherLieAction (first - second) =
      diracExteriorMotherLieAction first - diracExteriorMotherLieAction second := by
  rw [sub_eq_add_neg,
    StageNineP286GaugeConnectionVariation.diracExteriorMotherLieAction_add, emla_neg]
  module

/-- The electromagnetic gauge action is the generated colour direction
    minus half of the actual hypercharge direction on the whole carrier. -/
private theorem emGaugeAction_decomp :
    emGaugeAction =
      -(diracExteriorMotherLieAction (p286LieBlockEmbed (sourceColorP286Generator 2))) -
        ((1/2 : ℂ) • diracExteriorMotherLieAction
          (p286LieBlockEmbed Stage10.HyperchargeResponse.chargeDirection)) := by
  rw [emGaugeAction, emDirection, p286LieBlockEmbed_sub, p286LieBlockEmbed_neg,
    StageNineP286GaugeConnectionVariation.p286LieBlockEmbed_real_smul, emla_sub, emla_neg,
    StageNineP286GaugeConnectionVariation.diracExteriorMotherLieAction_real_smul]
  push_cast
  rfl

/-- The electromagnetic charge weight is the exterior weight plus half the
    hypercharge weight on each internal summand. -/
private theorem emChargeWeight_exterior (i : Quantum.Index) :
    emChargeWeight i =
      (match i.2 with
      | Sum.inl a => sourceExteriorWeight a
      | Sum.inr (Sum.inl a) => sourceExteriorWeight a
      | Sum.inr (Sum.inr a) => sourceExteriorWeight a) +
        (emHyperchargeWeight i : ℚ)/2 := by
  rcases i with ⟨_,i|i|i⟩ <;>
    simp only [emChargeWeight,sourceWholeWeight,sourceInternalWeight,sourcePhaseWeight,
      emHyperchargeWeight] <;>
    ring

/-- The electromagnetic gauge action is diagonal on the whole source
    quantum basis, with eigenvalue `-qEM·I`. -/
private theorem emGaugeAction_basis (i : Quantum.Index) :
    emGaugeAction (Quantum.wholeBasis i) =
      ((-(emChargeWeight i:ℚ):ℂ)*Complex.I) • Quantum.wholeBasis i := by
  rw [emGaugeAction_decomp]
  rcases i with ⟨spin,i|i|i⟩
  all_goals
    funext s
    simp only [LinearMap.sub_apply,LinearMap.neg_apply,LinearMap.smul_apply,
      Pi.sub_apply,Pi.neg_apply,Pi.smul_apply,
      diracExteriorMotherLieAction,internalMatterLinearAction,
      Quantum.wholeBasis,Pi.basis_apply]
    by_cases h : s=spin
    · subst s
      simp [Quantum.internalBasis,Module.Basis.prod_apply,
        exteriorSpinorMotherLieAction,LinearMap.prodMap_apply,map_zero,
        sourceExteriorWeight_action,Stage10.HyperchargeResponse.exterior_charge_basis,
        emChargeWeight_exterior,emHyperchargeWeight]
      all_goals
        module
    · simp [h,exteriorSpinorMotherLieAction]

/-- The canonical electromagnetic charge matrix is diagonal with the
    electromagnetic charge weights on the whole source basis. -/
theorem em_charge_matrix_diagonal :
    Quantum.operatorMatrix (Complex.I • emGaugeAction) =
      Matrix.diagonal (fun i => ((emChargeWeight i:ℚ):ℂ)) := by
  ext i j
  rw [Quantum.operatorMatrix,LinearMap.toMatrixAlgEquiv_apply]
  rw [LinearMap.smul_apply,emGaugeAction_basis]
  simp only [map_smul,Finsupp.smul_apply,Module.Basis.repr_self,Finsupp.single_apply,
    Matrix.diagonal_apply,smul_eq_mul]
  by_cases h : j=i
  · subst j
    rw [if_pos rfl,if_pos rfl,mul_one]
    rw [mul_comm ((-(emChargeWeight i:ℚ):ℂ)) Complex.I,←mul_assoc,Complex.I_mul_I,
      neg_one_mul,neg_neg]
  · rw [if_neg h,if_neg (Ne.symm h),mul_zero,mul_zero]

/-- The electromagnetic charge matrix is self-adjoint on the full
    independent branches. -/
theorem em_charge_matrix_hermitian :
    emGaugeChargeMatrix.conjTranspose=emGaugeChargeMatrix := by
  rw [emGaugeChargeMatrix,em_charge_matrix_diagonal]
  ext i j
  rcases i with i|i <;> rcases j with j|j <;>
    simp [SourceRealScalarFock.branches,Matrix.conjTranspose_apply,
      Matrix.diagonal_apply,eq_comm]
  all_goals
    by_cases same : i=j
    · subst j
      simp
    · simp [same]

/-- The electromagnetic Gauss charge is self-adjoint on the full
    source Hilbert space. -/
theorem em_gauss_pair (v w : H) :
    inner ℂ (emGaussCharge v) w=inner ℂ v (emGaussCharge w) := by
  apply GaussFockLift.lift_pair
  intro f g
  have generated := SourceQuantumFockGauge.quantizedFiber_adjoint
    emGaugeChargeMatrix f g
  rw [em_charge_matrix_hermitian] at generated
  exact generated

/-- The original actual Gauss charge is exactly the electromagnetic charge
    plus the retained defect charge on the whole Hilbert space. -/
theorem em_gauss_charge_decomposition :
    sourceActualGaussCharge=emGaussCharge+emGaussDefectCharge := by
  have matrices : sourceActualGaussChargeMatrix =
      emGaugeChargeMatrix+emGaugeDefectMatrix := by
    rw [sourceActualGaussCharge_original,emGaugeChargeMatrix,emGaugeDefectMatrix]
    have hX : Complex.I • sourceNativeOriginGenerator =
        Complex.I • emGaugeAction+Complex.I • emFullDefect := by
      rw [←smul_add,original_generator_gauge]
    rw [hX,map_add]
    exact branchesLinear.map_add _ _
  rw [sourceActualGaussCharge,emGaussCharge,emGaussDefectCharge,matrices,←lift_add]
  congr 1
  exact map_add quantizer _ _

/-- The electromagnetic gauge action on a prepared charged source
    restriction, consumed from the certified `em_charge_maker` port. -/
private theorem emIAction_restriction (side edge : Fin 2) :
    (Complex.I • emGaugeAction) (sourceChargedRestriction side edge) =
      (sourceActualPhaseCharge edge:ℂ) • sourceChargedRestriction side edge := by
  have maker := em_charge_maker side edge
  unfold emChargeFiber at maker
  rw [Electromagnetic.CanonicalPacket.densityReader,em_phase_current,
    operator_coordinates] at maker
  apply naturalCoordinates.injective
  rw [map_smul]
  exact maker

/-- The electromagnetic charge matrix acts on the prepared charged
    coordinates by the actual source charge. -/
private theorem emGaugeChargeMatrix_coordinates (side edge : Fin 2) :
    emGaugeChargeMatrix*ᵥsourceChargedCoordinates side edge=
      (sourceActualPhaseCharge edge:ℂ) • sourceChargedCoordinates side edge := by
  have primal := congrArg Quantum.coordinates
    (emIAction_restriction side edge)
  rw [←Quantum.matrix_action,map_smul] at primal
  unfold emGaugeChargeMatrix SourceRealScalarFock.branches sourceChargedCoordinates
  rw [map_smul Quantum.operatorMatrix,Matrix.fromBlocks_mulVec]
  have left : (Sum.elim (Quantum.coordinates (sourceChargedRestriction side edge))
      (fun _ : Quantum.Index=>(0:ℂ))) ∘ Sum.inl=
      Quantum.coordinates (sourceChargedRestriction side edge) := rfl
  have right : (Sum.elim (Quantum.coordinates (sourceChargedRestriction side edge))
      (fun _ : Quantum.Index=>(0:ℂ))) ∘ Sum.inr=0 := rfl
  rw [left,right,Matrix.zero_mulVec,Matrix.zero_mulVec,Matrix.mulVec_zero,
    add_zero,zero_add,primal]
  funext i
  cases i with
  | inl i=>simp only [Sum.elim_inl,Pi.smul_apply,map_smul]
  | inr i=>simp

/-- The quantized electromagnetic charge acts on the one-particle
    charged fiber by the actual source charge. -/
private theorem em_gauss_fiber (side edge : Fin 2) :
    quantized emGaugeChargeMatrix (sourceChargedFiber side edge)=
      (sourceActualPhaseCharge edge:ℂ) • sourceChargedFiber side edge := by
  rw [sourceChargedFiber,quantized_oneParticle,emGaugeChargeMatrix_coordinates]
  change fiberCoordinates.symm (Fermion.oneParticleLinear
    ((sourceActualPhaseCharge edge:ℂ) • sourceChargedCoordinates side edge))=_
  rw [map_smul,map_smul]
  rfl

/-- The electromagnetic Gauss charge returns the actual source charge on
    every prepared charged/neutral state. -/
theorem em_gauss_prepared (epsilon : ℝ) (precision : 0<epsilon)
    (side edge : Fin 2) :
    emGaussCharge (sourceChargedGaussPrepared epsilon precision side edge)=
      (sourceActualPhaseCharge edge:ℂ) •
        sourceChargedGaussPrepared epsilon precision side edge := by
  apply GaussHalfDensity.fockHalfDensityEquiv.injective
  rw [map_smul]
  apply PiLp.ext
  intro word
  rw [show emGaussCharge=lift (quantized emGaugeChargeMatrix) from rfl,
    sourceChargedGauss_action_coordinates,em_gauss_fiber]
  simp only [PiLp.smul_apply,sourceChargedGaussPrepared_coordinates,smul_smul,smul_eq_mul]

private def fieldCoframeLinear : Field289 →ₗ[ℝ] LorentzianCoframe where
  toFun := fieldCoframe
  map_add' _ _:=rfl
  map_smul' _ _:=rfl

private def fieldScalarLinear : Field289 →ₗ[ℝ] Scalar where
  toFun := fieldScalar
  map_add' := fieldScalar_add
  map_smul' := fieldScalar_smul

/-- The electromagnetic gauge field direction has zero coframe and scalar
    components and the gauge action on its own connection slot. -/
private theorem emFieldDirection_pure (mu : Fin 4) :
    fieldDirection (emGaugeField mu) =
      (0,fun ν : Fin 4 => if ν=mu then Quantum.operatorMatrix emGaugeAction else 0,0) := by
  have cf : fieldCoframe (emGaugeField mu)=0 := by
    change ⇑fieldCoframeLinear (emGaugeField mu)=0
    rw [emGaugeField,map_sum]
    apply Finset.sum_eq_zero
    intro a _
    simp only [map_smul]
    change _ • fieldCoframe (gaugeField mu a)=0
    rw [gauge_coframe,smul_zero]
  have sc : scalarDirection (sourceField (emGaugeField mu))=0 := by
    have scalar : (sourceField (emGaugeField mu)).scalar=0 := by
      change ⇑fieldScalarLinear (emGaugeField mu)=0
      rw [emGaugeField,map_sum]
      apply Finset.sum_eq_zero
      intro a _
      simp only [map_smul]
      change _ • fieldScalar (gaugeField mu a)=0
      rw [gauge_scalar,smul_zero]
    unfold scalarDirection
    rw [scalar]
    simp only [map_zero]
    have zero :=
      diracDualRightChiralYukawaAction_smul (0:ℂ) (0:ExteriorBreakingScalarCarrier)
    simp only [zero_smul] at zero
    rw [zero,map_zero]
  rw [show fieldDirection (emGaugeField mu)=
      (fieldCoframe (emGaugeField mu),
        connectionDirection (sourceField (emGaugeField mu)),
        scalarDirection (sourceField (emGaugeField mu))) from rfl,cf,sc]
  exact Prod.ext rfl (Prod.ext (funext (em_field_connection mu)) rfl)

private theorem emCanonical_smul :
    emCanonicalChargeMatrix=
      Complex.I • Quantum.operatorMatrix emGaugeAction := by
  rw [emCanonicalChargeMatrix,map_smul]

private theorem emInsertion_zero (s : ActionState) :
    emHamiltonianInsertion s 0=-emCanonicalChargeMatrix := by
  simp only [emHamiltonianInsertion,Fin.cases_zero]

private theorem emInsertion_succ (s : ActionState) (j : Fin 3) :
    emHamiltonianInsertion s j.succ=
      -(stateHamiltonian s j.succ*emCanonicalChargeMatrix) := by
  simp only [emHamiltonianInsertion,Fin.cases_succ]

private theorem emStateHamiltonian_succ (s : ActionState) (j : Fin 3) :
    stateHamiltonian s j.succ=
      Ring.inverse (CoframeResponse.principalMatrix s.1)*
        coefficientMatrix j.succ s.1 := by
  simp only [stateHamiltonian,Fin.cases_succ]

/-- The normalized energy jet of the electromagnetic gauge field is the
    minimal-coupling insertion for every spatial or temporal leg and every
    structurally valid source state. -/
theorem em_minimal_coupling_jet (s : ActionState) (valid : s∈validStates)
    (mu k : Fin 4) :
    sourceNormalizedEnergyJet s (fieldDirection (emGaugeField mu)) k=
      if k=0 then emHamiltonianInsertion s mu else 0 := by
  rw [emFieldDirection_pure,sourceNormalizedEnergyJet_matrix s _ valid,
    sourceHamiltonianJet_connection,
    Finset.sum_eq_single mu (fun b _ hb => by simp [hb]) (by simp),
    show (if mu=mu then Quantum.operatorMatrix emGaugeAction else 0)=
      Quantum.operatorMatrix emGaugeAction from if_pos rfl]
  induction mu using Fin.cases with
  | zero =>
    rw [emInsertion_zero]
    split_ifs with hk
    · rw [←CoframeResponse.principalMatrix_coefficient,←mul_assoc,
        Ring.inverse_mul_cancel _ (principalMatrix_regular s.1 valid.2),one_mul,
        emCanonical_smul,neg_smul]
    · rfl
  | succ j =>
    rw [emInsertion_succ,emStateHamiltonian_succ,emCanonical_smul]
    split_ifs with hk
    · rw [mul_smul_comm,neg_smul,mul_assoc]
    · rfl

/-- The normalized energy symbol of the electromagnetic gauge field is the
    branch-doubled Hamiltonian insertion for every leg; it is the already
    paid minimal-coupling jet read off through the Fourier branch map. -/
theorem em_minimal_coupling_symbol (p : PhysicalMomentum) (s : ActionState)
    (valid : s∈validStates) (mu : Fin 4) :
    sourceNormalizedEnergySymbol p s (fieldDirection (emGaugeField mu))=
      SourceRealScalarFock.branches (emHamiltonianInsertion s mu) := by
  unfold sourceNormalizedEnergySymbol
  rw [funext (em_minimal_coupling_jet s valid mu)]
  change realFourierMatrix
    (fun k=>if k=0 then emHamiltonianInsertion s mu else 0) p=_
  simp [realFourierMatrix,affineMatrix,SourceRealScalarFock.branches]

/-- The temporal normalized energy jet of the electromagnetic gauge field
    is `-I·GA` for every structurally valid source state. -/
theorem em_voltage_jet (s : ActionState) (valid : s∈validStates) (k : Fin 4) :
    sourceNormalizedEnergyJet s (fieldDirection (emGaugeField 0)) k=
      if k=0 then (-Complex.I) • Quantum.operatorMatrix emGaugeAction else 0 := by
  rw [em_minimal_coupling_jet s valid 0 k,emInsertion_zero]
  split_ifs with hk
  · rw [emCanonical_smul,neg_smul]
  · rfl

/-- The temporal electromagnetic energy symbol is minus the
    electromagnetic charge matrix on the independent branches. -/
theorem em_voltage_symbol (p : PhysicalMomentum) (s : ActionState)
    (valid : s∈validStates) :
    sourceNormalizedEnergySymbol p s (fieldDirection (emGaugeField 0))=
      -emGaugeChargeMatrix := by
  rw [em_minimal_coupling_symbol p s valid 0,emInsertion_zero]
  simp only [emCanonicalChargeMatrix]
  exact branchesLinear.map_neg _

/-- The electromagnetic voltage energy between prepared charged/neutral
    Gauss states at an arbitrary physical momentum. -/
def emVoltageEnergy (epsilon : ℝ) (precision : 0<epsilon)
    (p : PhysicalMomentum) (s : ActionState)
    (sideL edgeL sideR edgeR : Fin 2) : ℂ :=
  inner ℂ (sourceChargedGaussPrepared epsilon precision sideL edgeL)
    (lift (quantized (sourceNormalizedEnergySymbol p s
      (fieldDirection (emGaugeField 0))))
      (sourceChargedGaussPrepared epsilon precision sideR edgeR))

private theorem flatLift_neg (A : FiberOp) : flatLift (-A)=-flatLift A := by
  have entry_neg : ∀ output input : Occupation,
      entry (-A) output input=-(entry A output input):=fun _ _=>rfl
  apply ContinuousLinearMap.ext
  intro f
  apply PiLp.ext
  intro output
  simp only [flatLift_apply,neg_apply,PiLp.neg_apply]
  rw [←Finset.sum_neg_distrib]
  apply Finset.sum_congr rfl
  intro input _
  rw [entry_neg,neg_smul]

private theorem lift_neg (A : FiberOp) : lift (-A)=-lift A := by
  apply ContinuousLinearMap.ext
  intro f
  simp only [lift_apply,neg_apply]
  rw [flatLift_neg]
  exact map_neg _ _

/-- The prepared electromagnetic voltage energy is minus the actual
    source charge on the right preparation, with the exact bilateral
    orthonormality factor and no response subtraction. -/
theorem em_voltage_energy_read (epsilon : ℝ) (precision : 0<epsilon)
    (p : PhysicalMomentum) (s : ActionState) (valid : s∈validStates)
    (sideL edgeL sideR edgeR : Fin 2) :
    emVoltageEnergy epsilon precision p s sideL edgeL sideR edgeR=
      -(sourceActualPhaseCharge edgeR:ℂ)*
        (if sourceChargedRestIndex sideL edgeL=sourceChargedRestIndex sideR edgeR
          then 1 else 0) := by
  rw [emVoltageEnergy,em_voltage_symbol p s valid]
  rw [show quantized (-emGaugeChargeMatrix)=-(quantized emGaugeChargeMatrix) from
    map_neg quantizer _]
  rw [lift_neg,neg_apply,inner_neg_right]
  change -inner ℂ (sourceChargedGaussPrepared epsilon precision sideL edgeL)
      (emGaussCharge (sourceChargedGaussPrepared epsilon precision sideR edgeR))=_
  rw [em_gauss_prepared,inner_smul_right,sourceChargedGauss_gram]
  rw [neg_mul]

