/-- Literal diagonal-grade part of the original full matrix; the remainder is its actual raising part. -/
def sourceGradeZeroPart (A : FullMatrix) : FullMatrix := fun i j=>
  if (i∈target ↔ j∈target) then A i j else 0

theorem sourceGradeZeroPart_preserves (A : FullMatrix) : Preserves (sourceGradeZeroPart A) := by
  intro i j
  by_cases hi : i∈target <;> by_cases hj : j∈target <;>
    simp [sourceGradeZeroPart,charge,hi,hj]

/-- No-lowering of the actual matrix computes the complete remaining part as raising by one. -/
theorem sourceGradeRemainder_raises (A : FullMatrix) (paid : sourceFullNonlower A) :
    SourceFockRaising.grade target*Fermion.quantize (A-sourceGradeZeroPart A)=
      Fermion.quantize (A-sourceGradeZeroPart A)*SourceFockRaising.grade target+
        Fermion.quantize (A-sourceGradeZeroPart A) := by
  apply SourceFockRaising.quantize_raises_grade
  intro i j
  by_cases hi : i∈target <;> by_cases hj : j∈target
  · simp [sourceGradeZeroPart,hi,hj]
  · simp [sourceGradeZeroPart,hi,hj]
  · simp [sourceGradeZeroPart,hi,hj,paid i j hi hj]
  · simp [sourceGradeZeroPart,hi,hj]

private theorem raising_entry_zero (A : FullMatrix) (paid : sourceFullNonlower A)
    (output input : Occupation) (label : NativeHistoryGrade.sourceLabel output=CanonicalGradedCurrent.sourceLabel) :
    GaussQuantumMultiplier.matrixEntry (A-sourceGradeZeroPart A) output input=0 := by
  by_contra nonzero
  have basis : fiberCoordinates (EuclideanSpace.single input 1)=occupationBasis input := by
    funext word
    by_cases h : word=input
    · subst word
      simp [fiberCoordinates,occupationBasis]
    · simp [fiberCoordinates,occupationBasis,EuclideanSpace.single,h]
  have entry : GaussQuantumMultiplier.matrixEntry (A-sourceGradeZeroPart A) output input=
      Fermion.quantize (A-sourceGradeZeroPart A) (occupationBasis input) output := by
    change Fermion.quantize (A-sourceGradeZeroPart A) (fiberCoordinates (EuclideanSpace.single input 1)) output=_
    rw [basis]
  rw [entry] at nonzero
  have countLaw:=coefficient_grade target (Fermion.quantize (A-sourceGradeZeroPart A)) 1
    (by simpa only [Nat.cast_one,one_smul] using sourceGradeRemainder_raises A paid) input output nonzero
  have zero : count target output=0 := by
    have h:=congrArg (fun g : NativeHistoryGrade.Label=>g.2.val) label
    exact h
  omega

private theorem raising_fiber_zero (A : FullMatrix) (paid : sourceFullNonlower A) :
    fiberPiece CanonicalGradedCurrent.sourceLabel*quantizer (A-sourceGradeZeroPart A)=0 := by
  apply ContinuousLinearMap.ext
  intro v
  have expansion : v=∑word : Occupation,v word • EuclideanSpace.single word 1 := by
    apply PiLp.ext
    intro word
    simp [WithLp.ofLp_sum,Finset.sum_apply,EuclideanSpace.single,Pi.single_apply]
  apply PiLp.ext
  intro output
  change fiberPiece CanonicalGradedCurrent.sourceLabel (quantizer (A-sourceGradeZeroPart A) v) output=0
  rw [fiberPiece_apply]
  split_ifs with label
  · rw [expansion,map_sum]
    simp only [map_smul,WithLp.ofLp_sum,Finset.sum_apply,PiLp.smul_apply]
    exact Finset.sum_eq_zero (fun input _=>by
      change v input*GaussQuantumMultiplier.matrixEntry (A-sourceGradeZeroPart A) output input=0
      rw [raising_entry_zero A paid output input label,mul_zero])
  · rfl

private theorem fiber_source_square : fiberPiece CanonicalGradedCurrent.sourceLabel*
    fiberPiece CanonicalGradedCurrent.sourceLabel=fiberPiece CanonicalGradedCurrent.sourceLabel := by
  apply ContinuousLinearMap.ext
  intro v
  apply PiLp.ext
  intro word
  change fiberPiece CanonicalGradedCurrent.sourceLabel (fiberPiece CanonicalGradedCurrent.sourceLabel v) word=_
  simp only [fiberPiece_apply]
  split_ifs <;> rfl

/-- The original full504 quantizer retains its source-grade block, including all independent dual coordinates. -/
theorem sourceQuantizer_nonlower (A : FullMatrix) (paid : sourceFullNonlower A) :
    fiberPiece CanonicalGradedCurrent.sourceLabel*quantizer A=
      fiberPiece CanonicalGradedCurrent.sourceLabel*quantizer A*fiberPiece CanonicalGradedCurrent.sourceLabel := by
  have split : A=sourceGradeZeroPart A+(A-sourceGradeZeroPart A) := by abel
  have commute:=blockWeight_quantized (fun l=>if l=CanonicalGradedCurrent.sourceLabel then 1 else 0)
    (sourceGradeZeroPart A) (sourceGradeZeroPart_preserves A)
  change Commute (fiberPiece CanonicalGradedCurrent.sourceLabel) (quantizer (sourceGradeZeroPart A)) at commute
  conv_lhs=>rw [split,map_add,mul_add,raising_fiber_zero A paid,add_zero]
  conv_rhs=>rw [split,map_add,mul_add,raising_fiber_zero A paid,add_zero]
  rw [commute.eq,mul_assoc,fiber_source_square]

/-- The same source raw fiber, rather than a replacement matrix, consumes the generated decomposition. -/
theorem sourceRawFiber_nonlower (f : Field289) (p : PhysicalMomentum) (z : physicalChart) :
    fiberPiece CanonicalGradedCurrent.sourceLabel*rawStateFiber f p (sourceState z.val)=
      fiberPiece CanonicalGradedCurrent.sourceLabel*rawStateFiber f p (sourceState z.val)*fiberPiece CanonicalGradedCurrent.sourceLabel := by
  simpa only [rawActionSymbol_actual] using sourceQuantizer_nonlower _ (sourceRawActionSymbol_nonlower f p z)


private theorem raw_source_pair (f : Field289) (p : PhysicalMomentum) (a b : GaussCoreDifferential.QuantumTest) :
    rawForm f p (project CanonicalGradedCurrent.sourceLabel a) b 0=
      rawForm f p (project CanonicalGradedCurrent.sourceLabel a) (project CanonicalGradedCurrent.sourceLabel b) 0 := by
  rw [rawForm_original,rawForm_original]
  apply integral_congr_ae
  filter_upwards with z
  simp only [project_apply]
  by_cases inside : z∈physicalChart
  · rw [(paidLorentzGrade% sample_project),(paidLorentzGrade% sample_project)]
    have law:=congrArg (fun A : FockFiber→L[ℂ]FockFiber=>A (b z)) (sourceRawFiber_nonlower f p ⟨z,inside⟩)
    simpa only [mul_apply_eq_comp] using congrArg (fun v=>pairSample z (a z) v) law
  · have off : z∉tsupport a:=fun member=>inside (a.tsupport_subset member)
    rw [image_eq_zero_of_notMem_tsupport off,map_zero,pairSample_zero_left,pairSample_zero_left]

private theorem raw_source_frame (f : Field289) (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (i j : FrameIndex F) (left : CanonicalGradedCurrent.sourceLabel=i.1)
    (right : CanonicalGradedCurrent.sourceLabel≠j.1) :
    rawForm f p (frameTest F i) (frameTest F j) 0=0 := by
  have law:=raw_source_pair f p (frameTest F i) (frameTest F j)
  rw [(paidLorentzGrade% frame_project),if_pos left,(paidLorentzGrade% frame_project),if_neg right] at law
  refine law.trans ?_
  rw [rawForm_original]
  simp [pairSample]

/-- The original configuration pairing and complete finite frame preserve the computed source block. -/
theorem sourceRawReader_nonlower (f : Field289) (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) :
    sourceProjection*PreparationVacuumRawJointFeedback.rawReader f p F 0=
      sourceProjection*PreparationVacuumRawJointFeedback.rawReader f p F 0*sourceProjection := by
  unfold sourceProjection PreparationVacuumRawJointFeedback.rawReader finiteRiesz
  simp only [Finset.mul_sum,Finset.sum_mul,mul_smul_comm,smul_mul_assoc,
    (paidLorentzGrade% frame_rank_left),ite_mul,zero_mul,(paidLorentzGrade% frame_rank_right)]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  by_cases left : CanonicalGradedCurrent.sourceLabel=i.1
  · simp only [if_pos left]
    by_cases right : CanonicalGradedCurrent.sourceLabel=j.1
    · simp only [if_pos right]
    · simp only [if_neg right]
      have scalarZero (e : ℂ) (a b : SourceOp) (zero : e=0) : e • a=e • b := by
        subst e
        apply ContinuousLinearMap.ext
        intro v
        change (0:ℂ) • (a v)=(0:ℂ) • (b v)
        rw [zero_smul,zero_smul]
      exact scalarZero _ _ _ (raw_source_frame f p F i j left right)
  · simp only [if_neg left]

private theorem source_projection_orthogonal : sourceProjection*sourceExcitedProjection=0 := by
  unfold sourceProjection sourceExcitedProjection
  rw [projection_product]
  norm_num [CanonicalGradedCurrent.sourceLabel,sourceExcitedLabel]

private theorem nonlower_initial (P E gLeft gRight fLeft fRight B : SourceOp)
    (left : P*gLeft=fLeft*P) (right : P*gRight=fRight*P)
    (reader : P*B=P*B*P) (zero : P*E=0) : P*(gLeft*B*gRight)*E=0 := by
  calc
    _=((P*gLeft)*B*gRight)*E:=by noncomm_ring
    _=((fLeft*P)*B*gRight)*E:=by rw [left]
    _=fLeft*(P*B)*gRight*E:=by noncomm_ring
    _=fLeft*(P*B*P)*gRight*E:=by rw [←reader]
    _=fLeft*(P*B)*(P*gRight)*E:=by noncomm_ring
    _=fLeft*(P*B)*(fRight*P)*E:=by rw [right]
    _=fLeft*(P*B)*fRight*(P*E):=by noncomm_ring
    _=0:=by rw [zero,mul_zero]

/-- Both actual full Green inverses consume the original raw no-lowering action, computing the original upper seed for every field column. -/
theorem sourceFullInitialUpper_all_zero (q : PhysicalResponsePoint) (pL pR : PhysicalMomentum)
    (i : Fin 289) (left : q.z.im≠0) (right : q.w.im≠0) : sourceFullInitialUpper q pL pR i=0 := by
  unfold sourceFullInitialUpper rawInitial
  rw [sourcePhysicalMaterialPoint_left]
  change sourceProjection*(jointResolvent pL q.F q.z 0*
    PreparationVacuumRawJointFeedback.rawReader (fieldUnit i) pR q.F 0*
      jointResolvent pR q.F q.w 0)*sourceExcitedProjection=0
  exact nonlower_initial _ _ _ _ _ _ _
    ((actual_resolvent_sourceProjection pL q.F q.z left).trans ((paidLorentzGrade% bareResolvent_blocks) pL q.F q.z left).eq)
    ((actual_resolvent_sourceProjection pR q.F q.w right).trans ((paidLorentzGrade% bareResolvent_blocks) pR q.F q.w right).eq)
    (sourceRawReader_nonlower (fieldUnit i) pR q.F) source_projection_orthogonal

/-- The same source equal-energy projections and right retainer consume the computed all-field upper zero. -/
theorem sourceRetainerSeed_all_zero (q : PhysicalResponsePoint) (left : q.z.im≠0) (right : q.w.im≠0)
    (i : Fin 289) : sourceRetainerSeed q i=0 := by
  simp only [sourceRetainerSeed,sourceFullInitialUpper_all_zero q 0 0 i left right,map_zero,zero_mul]

