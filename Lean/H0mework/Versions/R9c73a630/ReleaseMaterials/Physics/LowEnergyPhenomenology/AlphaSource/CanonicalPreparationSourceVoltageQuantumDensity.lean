def sourceVoltageYukawaMatrix : SourceMatrix := scalarLinear (scalarCharge HyperchargeResponse.chargeDirection)

/-- The direction is generated by the actual normal scalar and gauge potential, on the original coframe. -/
def sourceVoltageStateDirection (value slope : ℝ) : ActionState :=
  (0,(fun mu=>if mu=0 then value • GaussNativeMatter.nativePrimal nativeY else 0),
    slope • sourceVoltageYukawaMatrix)

theorem sourceVoltageField_direction (value slope : ℝ) (electric : Fin 3→ℝ) :
    fieldDirection (sourceVoltageCoordinates value slope electric)=sourceVoltageStateDirection value slope := by
  rw [←stateDirection_source]
  change (fieldCoframe (sourceVoltageCoordinates value slope electric),
    (fun mu=>spinLinear mu (fieldLorentz (sourceVoltageCoordinates value slope electric))+
      GaussNativeMatter.nativePrimal (fieldGauge (sourceVoltageCoordinates value slope electric) mu)),
      scalarLinear (fieldScalar (sourceVoltageCoordinates value slope electric)))=_
  rw [(sourceVoltageCoordinates_other value slope electric).1,
    (sourceVoltageCoordinates_other value slope electric).2.1,sourceVoltageCoordinates_scalar]
  unfold sourceVoltageStateDirection
  apply Prod.ext
  · rfl
  apply Prod.ext
  · funext mu
    change spinLinear mu 0+GaussNativeMatter.nativePrimal
      (fieldGauge (sourceVoltageCoordinates value slope electric) mu)=
        if mu=0 then value • GaussNativeMatter.nativePrimal nativeY else 0
    rw [sourceVoltageCoordinates_gauge]
    simp only [map_zero,zero_add]
    split_ifs <;> simp only [map_smul,map_zero,nativeY]
  · change scalarLinear (slope • scalarCharge HyperchargeResponse.chargeDirection)=
      slope • scalarLinear (scalarCharge HyperchargeResponse.chargeDirection)
    exact (scalarLinear.restrictScalars ℝ).map_smul slope _

/-- Gauge-B is retained by the complete Cauchy family; its matter-state restriction is zero. -/
theorem sourceVoltageGaugeB_matter_restriction (value slope : ℝ) (electric : Fin 3→ℝ) :
    fieldDirection (sourceVoltageCoordinates value slope electric)=
      fieldDirection (sourceVoltageCoordinates value slope 0) := by
  rw [sourceVoltageField_direction,sourceVoltageField_direction]

def sourceVoltageLowerInput (value slope : ℝ) (s : ActionState) : SourceMatrix :=
  value • (coefficientMatrix 0 s.1*GaussNativeMatter.nativePrimal nativeY)+slope • sourceVoltageYukawaMatrix

private theorem voltage_coframe (s : ActionState) (value slope : ℝ) (a : ℝ) :
    (s+a • sourceVoltageStateDirection value slope).1=s.1 := by
  simp [sourceVoltageStateDirection]

private theorem voltage_lower (s : ActionState) (value slope : ℝ) (a : ℝ) :
    stateLower (s+a • sourceVoltageStateDirection value slope)=s.2.2+
      (∑mu : Fin 4,coefficientMatrix mu s.1*s.2.1 mu)+a • sourceVoltageLowerInput value slope s := by
  simp only [stateLower,sourceVoltageStateDirection,Prod.fst_add,Prod.snd_add,
    Prod.smul_fst,Prod.smul_snd,Pi.add_apply,Pi.smul_apply,mul_add,mul_smul_comm,
    smul_ite,smul_zero,mul_ite,mul_zero,Finset.sum_add_distrib,Finset.sum_ite_eq',
    Finset.mem_univ,ite_true,sourceVoltageLowerInput,smul_add,smul_smul]
  abel_nf

theorem sourceVoltage_principal_zero (s : ActionState) (nondegenerate : s.1.det≠0)
    (value slope : ℝ) (electric : Fin 3→ℝ) (mu : Fin 4) :
    principalVariation (sourceVoltageCoordinates value slope electric) mu s=0 := by
  let curve (a : ℝ):=s+a • sourceVoltageStateDirection value slope
  have path : HasDerivAt curve (sourceVoltageStateDirection value slope) 0 :=state_line s _
  have derivative:=((statePrincipal_smooth mu s nondegenerate).differentiableAt (by simp)).hasFDerivAt.comp_hasDerivAt_of_eq
    0 path (by simp [curve])
  have constant (a : ℝ) : statePrincipal mu (curve a)=statePrincipal mu s := by
    unfold statePrincipal stateVolume curve
    rw [voltage_coframe]
  unfold principalVariation
  rw [sourceVoltageField_direction]
  apply derivative.unique
  change HasDerivAt (fun a=>statePrincipal mu (curve a)) 0 0
  simpa only [constant] using hasDerivAt_const (0:ℝ) (statePrincipal mu s)

/-- The original complete density generates its lower, scalar-Yukawa and all principal terms before CAR. -/
theorem sourceVoltage_density_generated (s : ActionState) (nondegenerate : s.1.det≠0)
    (value slope : ℝ) (electric : Fin 3→ℝ) (k : Fin 4) :
    densityVariation (sourceVoltageCoordinates value slope electric) s k=
      if k=0 then stateVolume s • sourceVoltageLowerInput value slope s else 0 := by
  let curve (a : ℝ):=s+a • sourceVoltageStateDirection value slope
  have path : HasDerivAt curve (sourceVoltageStateDirection value slope) 0 :=state_line s _
  have derivative:=((stateDensityLower_smooth s nondegenerate).differentiableAt (by simp)).hasFDerivAt.comp_hasDerivAt_of_eq
    0 path (by simp [curve])
  have affine (a : ℝ) : stateDensityLower (curve a)=stateDensityLower s+
      a • (stateVolume s • sourceVoltageLowerInput value slope s) := by
    unfold stateDensityLower stateVolume curve
    rw [voltage_coframe,voltage_lower]
    simp only [stateLower,smul_add]
    module
  have generated:=((hasDerivAt_id (0:ℝ)).smul_const
    (stateVolume s • sourceVoltageLowerInput value slope s)).const_add (stateDensityLower s)
  have lower : lowerVariation (sourceVoltageCoordinates value slope electric) s=
      stateVolume s • sourceVoltageLowerInput value slope s := by
    unfold lowerVariation
    rw [sourceVoltageField_direction]
    apply derivative.unique
    change HasDerivAt (fun a=>stateDensityLower (curve a)) _ 0
    simpa only [affine,id_eq,one_smul,zero_add] using generated
  unfold densityVariation
  rw [lower,sourceVoltage_principal_zero s nondegenerate]
  simp only [zero_mul,smul_zero,sub_zero]
  cases k using Fin.cases with
  | zero=>rfl
  | succ j=>simp only [Fin.cases_succ,sourceVoltage_principal_zero s nondegenerate,smul_zero,Fin.succ_ne_zero,ite_false]

def sourceVoltageRawCoefficient (value slope : ℝ) (s : ActionState) : SourceMatrix :=
  densityActionMatrix*(stateVolume s • sourceVoltageLowerInput value slope s)

theorem sourceVoltage_raw_full (s : ActionState) (nondegenerate : s.1.det≠0)
    (value slope : ℝ) (electric : Fin 3→ℝ) (p : PhysicalMomentum) :
    rawActionSymbol (sourceVoltageCoordinates value slope electric) p s=
      oppositeDual*SourceRealScalarFock.branches (sourceVoltageRawCoefficient value slope s) := by
  unfold rawActionSymbol rawFourier
  simp only [sourceVoltage_density_generated s nondegenerate value slope electric]
  change oppositeDual*realFourierMatrix
    (fun k=>densityActionMatrix*(if k=0 then stateVolume s • sourceVoltageLowerInput value slope s else 0)) p=_
  simp [realFourierMatrix,affineMatrix,sourceVoltageRawCoefficient,SourceRealScalarFock.branches]

theorem sourceVoltage_fullCAR (s : ActionState) (nondegenerate : s.1.det≠0)
    (value slope : ℝ) (electric : Fin 3→ℝ) (p : PhysicalMomentum) :
    actualDensity (sourceVoltageCoordinates value slope electric) p s=
      LowEnergy.Fermion.quantize (oppositeDual*SourceRealScalarFock.branches
        (sourceVoltageRawCoefficient value slope s)) := by
  rw [actualDensity_source,sourceVoltage_raw_full s nondegenerate]

theorem sourceVoltage_actual_density (profile : BasePoint→ℝ) (point : BasePoint)
    (s : ActionState) (nondegenerate : s.1.det≠0) (p : PhysicalMomentum) :
    actualDensity (sourceVoltageSignal profile 1 point) p s=
      LowEnergy.Fermion.quantize (oppositeDual*SourceRealScalarFock.branches
        (sourceVoltageRawCoefficient (profile point)
          (-(canonicalTimeProjection point*profile (canonicalCauchySlicePoint 0 (canonicalSpatialProjection point)))) s)) := by
  unfold sourceVoltageSignal
  simp only [one_mul]
  exact sourceVoltage_fullCAR s nondegenerate _ _ _ p

