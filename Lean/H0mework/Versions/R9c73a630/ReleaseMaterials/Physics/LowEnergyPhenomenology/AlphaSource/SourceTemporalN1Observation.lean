/-- Only the two actual raw-frame charge defects remain after the number-one CAR cancellation. -/
def sourceTemporalFrameCharge (F : GaussUnitaryHistory.Index) (y : H) : H :=
  sourceApprox F (embed (weightCore (sourceTemporalInputCharge F y)+weightCore (sourceTemporalInputDifference F y)))

theorem sourceTemporalFrameNormal_N1 (F : GaussUnitaryHistory.Index) (y : H)
    (generated : sourceN1Projection y=y) : sourceTemporalFrameNormal F y=sourceTemporalFrameCharge F y := by
  rw [sourceTemporalFrameNormal,sourceTemporalNormal_N1_zero F _ y generated,
    sourceTemporalNormal_N1_zero F _ y generated,add_zero,add_zero]
  rfl

def sourceTemporalN1Pair (F : GaussUnitaryHistory.Index) (x y : H) : ℂ :=
  -inner ℂ x (sourceTemporalWeightReader F (sourceEqualProjection F sourceActualGaussCharge y))-
    sourceOffEnergyConfigurationRead F ((sourceTemporalWeightReader F).adjoint x) y-
    inner ℂ x (sourceTemporalWeightReader F (sourceFirstDifference y))+
    inner ℂ x (sourceTemporalFrameCharge F y)

theorem sourceTemporalSpectralPair_N1 (F : GaussUnitaryHistory.Index) (x y : H)
    (generated : sourceN1Projection y=y) : sourceTemporalSpectralPair F x y=sourceTemporalN1Pair F x y := by
  rw [sourceTemporalSpectralPair,sourceTemporalFrameNormal_N1 F y generated]
  rfl

theorem sourceTemporalUnitReader_numberOne (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (left : q.z.im≠0) (right : q.w.im≠0) :
    sourceActualUnitLegRead q sL eL sR eR (sourceTemporalChargeReader q.F)=
      sourceActualLegNormalization q sL eL sR eR*
        ((sourceActualChargedRestEnergy sL:ℂ)-q.z)*((sourceActualChargedRestEnergy sR:ℂ)-q.w)*
        (-inner ℂ ((jointResolvent 0 q.F q.z 0).adjoint (sourceChargedGaussPrepared q.epsilon q.precision sL eL))
          (sourceTemporalWeightReader q.F (sourceEqualProjection q.F sourceActualGaussCharge
            (jointResolvent 0 q.F q.w 0 (sourceChargedGaussPrepared q.epsilon q.precision sR eR))))-
        sourceOffEnergyConfigurationRead q.F
          ((sourceTemporalWeightReader q.F).adjoint ((jointResolvent 0 q.F q.z 0).adjoint
            (sourceChargedGaussPrepared q.epsilon q.precision sL eL)))
          (jointResolvent 0 q.F q.w 0 (sourceChargedGaussPrepared q.epsilon q.precision sR eR))-
        sourceFirstMaterialDifferenceRead q.F
          ((jointResolvent 0 q.F q.w 0).adjoint ((sourceTemporalWeightReader q.F).adjoint
            ((jointResolvent 0 q.F q.z 0).adjoint (sourceChargedGaussPrepared q.epsilon q.precision sL eL))))
          (jointResolvent 0 q.F q.w 0 (sourceChargedGaussPrepared q.epsilon q.precision sR eR))+
        inner ℂ ((jointResolvent 0 q.F q.z 0).adjoint (sourceChargedGaussPrepared q.epsilon q.precision sL eL))
          (sourceTemporalFrameCharge q.F
            (jointResolvent 0 q.F q.w 0 (sourceChargedGaussPrepared q.epsilon q.precision sR eR)))) := by
  have paid:=sourceTemporalUnitReader_material q sL eL sR eR left right
  have normal:=sourceTemporalFrameNormal_N1 q.F
    (jointResolvent 0 q.F q.w 0 (sourceChargedGaussPrepared q.epsilon q.precision sR eR))
    (sourceTemporalGreen_N1 q 0 sR eR q.w right)
  rw [normal] at paid
  exact paid

