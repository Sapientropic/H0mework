private theorem apply_range (T : H→L[ℂ]H)
    (paid : sourceN1Projection*T*sourceN1Projection=T*sourceN1Projection) (y : H)
    (generated : sourceN1Projection y=y) : sourceN1Projection (T y)=T y := by
  have h:=congrArg (fun A : H→L[ℂ]H=>A y) paid
  simpa only [mul_apply_eq_comp,generated] using h

def sourceTemporalN1UnitSandwich (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) (L R : H→L[ℂ]H) : ℂ :=
  sourceActualLegNormalization q sL eL sR eR*
    ((sourceActualChargedRestEnergy sL:ℂ)-q.z)*((sourceActualChargedRestEnergy sR:ℂ)-q.w)*
    sourceTemporalN1Pair q.F
      ((jointResolvent 0 q.F q.z 0*L).adjoint (sourceChargedGaussPrepared q.epsilon q.precision sL eL))
      ((R*jointResolvent 0 q.F q.w 0) (sourceChargedGaussPrepared q.epsilon q.precision sR eR))

private theorem unit_sandwich_N1 (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) (L R : H→L[ℂ]H)
    (generated : sourceN1Projection ((R*jointResolvent 0 q.F q.w 0)
      (sourceChargedGaussPrepared q.epsilon q.precision sR eR))=
      (R*jointResolvent 0 q.F q.w 0) (sourceChargedGaussPrepared q.epsilon q.precision sR eR)) :
    sourceTemporalUnitSandwich q sL eL sR eR L R=sourceTemporalN1UnitSandwich q sL eL sR eR L R := by
  unfold sourceTemporalUnitSandwich sourceTemporalN1UnitSandwich
  rw [sourceTemporalSpectralPair_N1 q.F _ _ generated]

def sourceTemporalN1TimeResponse (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) (l : Fin 4) (age : ℝ) : ℂ :=
  -sourceTemporalN1UnitSandwich q sL eL sR eR
    (sourcePolarizationAxisTime q (q.p+q.k) l (-age)*jointResolvent (q.p+q.k) q.F q.z 0)
    (jointResolvent q.p q.F q.w 0*physicalTime q.p q.F age 0)-
  sourceTemporalN1UnitSandwich q sL eL sR eR
    (physicalTime (q.p+q.k) q.F (-age) 0*
      (-(jointResolvent (q.p+q.k) q.F q.z 0*sourcePolarizationMaterialCurrent (sourceEnergyAxisField 1 l) (q.p+q.k) q.F*
        jointResolvent (q.p+q.k) q.F q.z 0)))
    (jointResolvent q.p q.F q.w 0*physicalTime q.p q.F age 0)-
  sourceTemporalN1UnitSandwich q sL eL sR eR
    (physicalTime (q.p+q.k) q.F (-age) 0*jointResolvent (q.p+q.k) q.F q.z 0)
    ((-(jointResolvent q.p q.F q.w 0*sourcePolarizationMaterialCurrent (sourceEnergyAxisField 1 l) q.p q.F*
      jointResolvent q.p q.F q.w 0))*physicalTime q.p q.F age 0)-
  sourceTemporalN1UnitSandwich q sL eL sR eR
    (physicalTime (q.p+q.k) q.F (-age) 0*jointResolvent (q.p+q.k) q.F q.z 0)
    (jointResolvent q.p q.F q.w 0*sourcePolarizationAxisTime q q.p l age)

/-- All four original time/Green words are now paid number-one consumers; no normal-order term is removed by assumption. -/
theorem sourceTemporalN1TimeResponse_return (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (l : Fin 4) (age : ℝ) (left : q.z.im≠0) (right : q.w.im≠0) :
    sourceUnitTimeSlope q sL eL sR eR (sourceEnergyAxisField 1 0) (sourceEnergyAxisField 1 l) age=
      sourceTemporalN1TimeResponse q sL eL sR eR l age := by
  let y:=jointResolvent 0 q.F q.w 0 (sourceChargedGaussPrepared q.epsilon q.precision sR eR)
  let G:=jointResolvent q.p q.F q.w 0
  let T:=physicalTime q.p q.F age 0
  let J:=sourcePolarizationMaterialCurrent (sourceEnergyAxisField 1 l) q.p q.F
  let S:=sourcePolarizationAxisTime q q.p l age
  have seed : sourceN1Projection y=y:=sourceTemporalGreen_N1 q 0 sR eR q.w right
  have green (v : H) (fixed : sourceN1Projection v=v) : sourceN1Projection (G v)=G v:=
    apply_range _ (sourceTemporalGreen_range q.p q.F q.w right) v fixed
  have time : sourceN1Projection (T y)=T y:=apply_range _ (actualTime_sourceN1_range q.p q.F age) y seed
  have current : sourceN1Projection*J*sourceN1Projection=J*sourceN1Projection := by
    dsimp only [J]
    rw [←(paidTemporalMaterialCurrent%) (sourceEnergyAxisField 1 l) q.p q.F 0]
    exact sourceTemporalCurrent_range (sourceEnergyAxisField 1 l) q.p q.F 0
  have slope : sourceN1Projection*S*sourceN1Projection=S*sourceN1Projection := by
    dsimp only [S,sourcePolarizationAxisTime]
    rw [←(paidTemporalMaterialCurrent%) (sourceEnergyAxisField 1 l) q.p q.F 0]
    simpa only [timeSlope] using sourceTemporalTimeSlope_range (sourceEnergyAxisField 1 l) q.p q.F age
  have first : sourceN1Projection ((G*T) y)=(G*T) y:=green _ time
  have third : sourceN1Projection ((-(G*J*G)*T) y)=(-(G*J*G)*T) y := by
    simp only [mul_apply_eq_comp,neg_apply,map_neg]
    exact congrArg Neg.neg (green _ (apply_range _ current _ (green _ time)))
  have fourth : sourceN1Projection ((G*S) y)=(G*S) y:=green _ (apply_range _ slope y seed)
  let L0:=sourcePolarizationAxisTime q (q.p+q.k) l (-age)*jointResolvent (q.p+q.k) q.F q.z 0
  let L1:=physicalTime (q.p+q.k) q.F (-age) 0*
    (-(jointResolvent (q.p+q.k) q.F q.z 0*sourcePolarizationMaterialCurrent (sourceEnergyAxisField 1 l) (q.p+q.k) q.F*
      jointResolvent (q.p+q.k) q.F q.z 0))
  let L2:=physicalTime (q.p+q.k) q.F (-age) 0*jointResolvent (q.p+q.k) q.F q.z 0
  have h0:=unit_sandwich_N1 q sL eL sR eR L0 (G*T) first
  have h1:=unit_sandwich_N1 q sL eL sR eR L1 (G*T) first
  have h2:=unit_sandwich_N1 q sL eL sR eR L2 (-(G*J*G)*T) third
  have h3:=unit_sandwich_N1 q sL eL sR eR L2 (G*S) fourth
  rw [sourceTemporalTimeResponse_return q sL eL sR eR l age left right]
  exact congrArg₂ (fun a b : ℂ=>a-b)
    (congrArg₂ (fun a b : ℂ=>a-b)
      (congrArg₂ (fun a b : ℂ=>-a-b) h0 h1) h2) h3

theorem sourceTemporalN1TimeResponse_bound (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (l : Fin 4) (eta age : ℝ) (positive : 0<eta) (future : 0≤age) (left : q.z.im≠0) (right : q.w.im≠0) :
    ‖sourceTemporalN1TimeResponse q sL eL sR eR l age‖ ≤
      fiveCoefficient q (sourceEnergyAxisField 1 0) (sourceEnergyAxisField 1 l) eta*Real.exp (4*eta*age) := by
  rw [←sourceTemporalN1TimeResponse_return q sL eL sR eR l age left right]
  exact sourceUnitTimeSlope_bound q sL eL sR eR _ _ eta age positive future left right

