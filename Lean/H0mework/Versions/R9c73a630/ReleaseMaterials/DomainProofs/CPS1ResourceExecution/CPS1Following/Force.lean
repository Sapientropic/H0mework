import H0mework.Versions.R9c73a630.ReleaseMaterials.DomainProofs.CPS1ResourceExecution.CPS1Following.Geometry

set_option autoImplicit false
set_option maxHeartbeats 0
set_option maxRecDepth 100000

namespace CPS1Following
noncomputable section
open CPS1ElectronicSource
open scoped BigOperators InnerProductSpace
variable {frame : CPS1Recycling.Frame}

def relativeForce (state : CPS1ElectronicSource.State frame) (node : Node) : BodyPoint :=
  CPS1QuantumNuclear.nuclearForce (relativeState state) (relativeNode (centre state) node)

def forceSum (state : CPS1ElectronicSource.State frame) : BodyPoint :=
  (state.geometry.nuclei.map (relativeForce state)).sum

/-- The common-centre response is generated by the same source masses. -/
def nuclearForce (state : CPS1ElectronicSource.State frame) (node : Node) : BodyPoint :=
  relativeForce state node-massWeight state node • forceSum state

def centreRate (state : CPS1ElectronicSource.State frame)
    (direction : CPS1AtomicDynamics.Charged.Address → BodyPoint) : BodyPoint :=
  (massTotal state)⁻¹ • (state.geometry.nuclei.map (fun node =>
    node.row.inertia • direction node.particle.address)).sum


private theorem list_div_sum {A : Type} (items : List A) (value : A → ℝ) (denominator : ℝ) :
    (items.map (fun item => value item / denominator)).sum = (items.map value).sum / denominator := by
  induction items with
  | nil => simp only [List.map_nil,List.sum_nil,zero_div]
  | cons item rest ih => simp only [List.map_cons,List.sum_cons,ih,add_div]

private theorem list_scalar_vector_sum {A : Type} (items : List A) (value : A → ℝ) (vector : BodyPoint) :
    (items.map (fun item => value item • vector)).sum = (items.map value).sum • vector := by
  induction items with
  | nil => simp only [List.map_nil,List.sum_nil,zero_smul]
  | cons item rest ih => simp only [List.map_cons,List.sum_cons,ih,add_smul]

theorem source_mass_weights (state : CPS1ElectronicSource.State frame) (massPositive : 0 < massTotal state) :
    (state.geometry.nuclei.map (massWeight state)).sum = 1 := by
  unfold massWeight
  rw [list_div_sum]
  change massTotal state / massTotal state = 1
  exact div_self (ne_of_gt massPositive)

theorem total_nuclear_force_zero (state : CPS1ElectronicSource.State frame)
    (massPositive : 0 < massTotal state) :
    (state.geometry.nuclei.map (nuclearForce state)).sum = 0 := by
  unfold nuclearForce
  rw [CPS1AtomicDynamics.Field.list_sum_sub,list_scalar_vector_sum,source_mass_weights state massPositive]
  simp only [one_smul,forceSum,sub_self]

theorem pair_force_relative (offset : BodyPoint) (first second : Node) :
    CPS1AtomicDynamics.Coulomb.pairForce (first.particle.charge : ℝ) (second.particle.charge : ℝ)
      (relativeNode offset first).row.position (relativeNode offset second).row.position =
    CPS1AtomicDynamics.Coulomb.pairForce (first.particle.charge : ℝ) (second.particle.charge : ℝ)
      first.row.position second.row.position := by
  have same : (first.row.position-offset)-(second.row.position-offset) =
      first.row.position-second.row.position := by abel
  simp only [relative_position,CPS1AtomicDynamics.Coulomb.pairForce,same]

theorem coulomb_force_relative (offset : BodyPoint) (node : Node) (nodes : List Node) :
    CPS1AtomicDynamics.Body.force (relativeNode offset node) (nodes.map (relativeNode offset)) =
      CPS1AtomicDynamics.Body.force node nodes := by
  unfold CPS1AtomicDynamics.Body.force
  simp only [List.map_map,Function.comp_def,relative_particle]
  apply congrArg List.sum
  apply List.map_congr_left
  intro other _
  exact congrArg (fun field : BodyPoint => if other.particle.address = node.particle.address then 0 else field)
    (pair_force_relative offset node other)

def relativeElectronForce (state : CPS1ElectronicSource.State frame) (node : Node) : BodyPoint :=
  CPS1QuantumNuclear.electronForce (relativeState state) (relativeNode (centre state) node)

theorem relative_force_split (state : CPS1ElectronicSource.State frame) (node : Node) :
    relativeForce state node = CPS1AtomicDynamics.Body.force node state.geometry.nuclei + relativeElectronForce state node := by
  unfold relativeForce CPS1QuantumNuclear.nuclearForce relativeElectronForce
  change CPS1AtomicDynamics.Body.force (relativeNode (centre state) node) (relativeGeometry state).nuclei +
    CPS1QuantumNuclear.electronForce (relativeState state) (relativeNode (centre state) node) = _
  rw [relative_nuclei,coulomb_force_relative]

theorem force_sum_is_electronic (state : CPS1ElectronicSource.State frame) :
    forceSum state = (state.geometry.nuclei.map (relativeElectronForce state)).sum := by
  unfold forceSum
  have same : relativeForce state = fun node =>
      CPS1AtomicDynamics.Body.force node state.geometry.nuclei + relativeElectronForce state node :=
    funext (relative_force_split state)
  rw [same]
  rw [List.sum_map_add,CPS1AtomicDynamics.Field.total_force_zero,zero_add]

theorem actual_source_force (state : CPS1ElectronicSource.State frame) (node : Node) :
    nuclearForce state node = CPS1AtomicDynamics.Body.force node state.geometry.nuclei + relativeElectronForce state node -
      massWeight state node • (state.geometry.nuclei.map (relativeElectronForce state)).sum := by
  rw [nuclearForce,relative_force_split,force_sum_is_electronic]


private theorem list_scale_sum {A : Type} (items : List A) (value : A → BodyPoint) (scalar : ℝ) :
    (items.map (fun item => scalar • value item)).sum = scalar • (items.map value).sum := by
  induction items with
  | nil => simp only [List.map_nil,List.sum_nil,smul_zero]
  | cons item rest ih => simp only [List.map_cons,List.sum_cons,ih,smul_add]

private theorem list_inner_sum {A : Type} (items : List A) (value : A → BodyPoint) (vector : BodyPoint) :
    inner ℝ vector (items.map value).sum = (items.map (fun item => inner ℝ vector (value item))).sum := by
  induction items with
  | nil => simp only [List.map_nil,List.sum_nil,inner_zero_right]
  | cons item rest ih => simp only [List.map_cons,List.sum_cons,inner_add_right,ih]

theorem centre_rate_weighted (state : CPS1ElectronicSource.State frame)
    (direction : CPS1AtomicDynamics.Charged.Address → BodyPoint) :
    centreRate state direction = (state.geometry.nuclei.map (fun node =>
      massWeight state node • direction node.particle.address)).sum := by
  rw [centreRate,← list_scale_sum]
  apply congrArg List.sum
  apply List.map_congr_left
  intro node _
  simp only [massWeight,div_eq_mul_inv,smul_smul,mul_comm]

def centreAlong (state : CPS1ElectronicSource.State frame)
    (direction : CPS1AtomicDynamics.Charged.Address → BodyPoint) (time : ℝ) : BodyPoint :=
  (massTotal state)⁻¹ • (state.geometry.nuclei.map (fun node =>
    node.row.inertia • (node.row.position+time • direction node.particle.address))).sum

theorem centre_along (state : CPS1ElectronicSource.State frame)
    (direction : CPS1AtomicDynamics.Charged.Address → BodyPoint) (time : ℝ) :
    centreAlong state direction time = centre state+time • centreRate state direction := by
  have split : (state.geometry.nuclei.map (fun node =>
      node.row.inertia • (node.row.position+time • direction node.particle.address))).sum =
      (state.geometry.nuclei.map (fun node => node.row.inertia • node.row.position)).sum +
        time • (state.geometry.nuclei.map (fun node => node.row.inertia • direction node.particle.address)).sum := by
    have same : (fun node : Node => node.row.inertia • (node.row.position+time • direction node.particle.address)) =
        fun node => node.row.inertia • node.row.position+time • (node.row.inertia • direction node.particle.address) := by
      funext node
      rw [smul_add,smul_comm]
    rw [same,List.sum_map_add,list_scale_sum]
  unfold centreAlong centre centreRate
  rw [split,smul_add,smul_comm]

/-- The source nuclear line generates its own centre, keeping the same occupied mother. -/
def energyLine (state : CPS1ElectronicSource.State frame)
    (direction : CPS1AtomicDynamics.Charged.Address → BodyPoint) (time : ℝ) : ℝ :=
  CPS1QuantumNuclear.spatialEnergyAt (relativeState state) (fun node axis =>
    (node.row.position+time • direction node.particle.address+centre state-centreAlong state direction time) axis)

theorem energy_line_relative (state : CPS1ElectronicSource.State frame)
    (direction : CPS1AtomicDynamics.Charged.Address → BodyPoint) (time : ℝ) :
    energyLine state direction time = CPS1QuantumNuclear.spatialEnergyAt (relativeState state) (fun node =>
      Geometry.nucleusPosition node+time • (fun axis => (direction node.particle.address-centreRate state direction) axis)) := by
  unfold energyLine
  rw [centre_along]
  apply congrArg (CPS1QuantumNuclear.spatialEnergyAt (relativeState state))
  funext node axis
  have same : node.row.position+time • direction node.particle.address+centre state-
      (centre state+time • centreRate state direction) =
        node.row.position+time • (direction node.particle.address-centreRate state direction) := by
    rw [smul_sub]
    abel
  exact congrArg (fun point : BodyPoint => point axis) same

theorem energy_line_current (state : CPS1ElectronicSource.State frame)
    (direction : CPS1AtomicDynamics.Charged.Address → BodyPoint) : energyLine state direction 0 = energy state := by
  rw [energy_line_relative]
  simp only [zero_smul,add_zero,CPS1QuantumNuclear.original_total_energy,energy]

theorem relative_nuclear_unique (state : CPS1ElectronicSource.State frame)
    (unique : (state.geometry.nuclei.map (fun node => node.particle.address)).Nodup) :
    ((relativeState state).geometry.nuclei.map (fun node => node.particle.address)).Nodup := by
  change ((relativeGeometry state).nuclei.map (fun node => node.particle.address)).Nodup
  simpa only [relative_nuclei,List.map_map,Function.comp_def,relative_particle] using unique

theorem relative_nuclear_ready (state : CPS1ElectronicSource.State frame)
    (separated : CPS1AtomicDynamics.Body.ready state.geometry.nuclei) :
    CPS1AtomicDynamics.Body.ready (relativeState state).geometry.nuclei := by
  change CPS1AtomicDynamics.Body.ready (relativeGeometry state).nuclei
  rw [relative_nuclei]
  unfold CPS1AtomicDynamics.Body.ready at separated ⊢
  rw [List.pairwise_map]
  exact separated.imp (fun distinct same => distinct (by
    have restored := congrArg (fun point : BodyPoint => point+centre state) same
    simpa only [relative_position,sub_add_cancel] using restored))

theorem following_work (state : CPS1ElectronicSource.State frame)
    (direction : CPS1AtomicDynamics.Charged.Address → BodyPoint) :
    ((relativeState state).geometry.nuclei.map (fun node => inner ℝ
      (CPS1QuantumNuclear.nuclearForce (relativeState state) node)
      (direction node.particle.address-centreRate state direction))).sum =
      (state.geometry.nuclei.map (fun node => inner ℝ (nuclearForce state node)
        (direction node.particle.address))).sum := by
  change ((relativeGeometry state).nuclei.map _).sum = _
  rw [relative_nuclei,List.map_map]
  have same : (fun node : Node => inner ℝ (relativeForce state node)
      (direction node.particle.address-centreRate state direction)) =
      fun node => inner ℝ (relativeForce state node) (direction node.particle.address)-
        inner ℝ (relativeForce state node) (centreRate state direction) := by
    funext node
    exact inner_sub_right _ _ _
  change (state.geometry.nuclei.map (fun node => inner ℝ (relativeForce state node)
    (direction node.particle.address-centreRate state direction))).sum = _
  rw [same,CPS1AtomicDynamics.Field.list_sum_sub,← CPS1AtomicDynamics.Field.list_sum_inner]
  have response : inner ℝ (forceSum state) (centreRate state direction) =
      (state.geometry.nuclei.map (fun node => inner ℝ (massWeight state node • forceSum state)
        (direction node.particle.address))).sum := by
    rw [centre_rate_weighted,list_inner_sum]
    simp only [real_inner_smul_left,real_inner_smul_right]
  change (state.geometry.nuclei.map (fun node => inner ℝ (relativeForce state node)
    (direction node.particle.address))).sum-inner ℝ (forceSum state) (centreRate state direction) = _
  rw [response]
  unfold nuclearForce
  simp only [inner_sub_left]
  rw [CPS1AtomicDynamics.Field.list_sum_sub]

theorem following_energy_line (state : CPS1ElectronicSource.State frame)
    (unique : (state.geometry.nuclei.map (fun node => node.particle.address)).Nodup)
    (separated : CPS1AtomicDynamics.Body.ready state.geometry.nuclei)
    (direction : CPS1AtomicDynamics.Charged.Address → BodyPoint) :
    HasDerivAt (fun time : ℝ => energyLine state direction time)
      (-(state.geometry.nuclei.map (fun node => inner ℝ (nuclearForce state node)
        (direction node.particle.address))).sum) 0 := by
  have paid := CPS1QuantumNuclear.source_nuclear_energy_line (relativeState state)
    (relative_nuclear_unique state unique) (relative_nuclear_ready state separated)
    (fun address => direction address-centreRate state direction)
  rw [following_work] at paid
  convert paid using 1
  funext time
  exact energy_line_relative state direction time

theorem nuclear_row_momentum (state : CPS1ElectronicSource.State frame) (time : ℝ)
    (massPositive : 0 < massTotal state) :
    ((state.geometry.nuclei.map (fun node => CPS1QuantumNuclear.kickWith node (nuclearForce state node) time)).map
      (fun node => node.row.momentum)).sum = (state.geometry.nuclei.map (fun node => node.row.momentum)).sum := by
  simp only [List.map_map,Function.comp_def,CPS1QuantumNuclear.kickWith]
  rw [List.sum_map_add,list_scale_sum,total_nuclear_force_zero state massPositive,smul_zero,add_zero]


private theorem moved_row_sum (nodes : List Node) (field : Node → BodyPoint) (time : ℝ) :
    (nodes.map (fun node => (CPS1QuantumNuclear.moveNucleus node (field node) time).row.momentum)).sum =
      (nodes.map (fun node => node.row.momentum)).sum +
        time • ((nodes.filter isNucleus).map field).sum := by
  induction nodes with
  | nil => simp only [List.map_nil,List.filter_nil,List.sum_nil,smul_zero,add_zero]
  | cons node rest ih =>
      simp only [List.map_cons,List.sum_cons,ih]
      cases nucleus : isNucleus node <;>
        simp only [List.filter_cons,CPS1QuantumNuclear.moveNucleus,
          nucleus,Bool.false_eq_true,if_false,if_true,CPS1QuantumNuclear.kickWith,
          List.map_cons,List.sum_cons,smul_add]
      all_goals abel

/-- This is the stored row momentum, not a quantum electronic p-expectation. -/
theorem whole_row_momentum (state : CPS1ElectronicSource.State frame) (time : ℝ)
    (massPositive : 0 < massTotal state) :
    ((CPS1QuantumNuclear.nextNodes state (nuclearForce state) time).map (fun node => node.row.momentum)).sum =
      (state.geometry.nodes.map (fun node => node.row.momentum)).sum := by
  simp only [CPS1QuantumNuclear.nextNodes,List.map_map,Function.comp_def]
  rw [moved_row_sum]
  change (state.geometry.nodes.map (fun node => node.row.momentum)).sum +
    time • (state.geometry.nuclei.map (nuclearForce state)).sum = _
  rw [total_nuclear_force_zero state massPositive,smul_zero,add_zero]

set_option maxHeartbeats 20000

private def positionNode (position : Node → BodyPoint) (node : Node) : Node :=
  {node with row := {node.row with position := position node}}

private def positionedState (state : CPS1ElectronicSource.State frame) (position : Node → BodyPoint) :
    CPS1ElectronicSource.State frame :=
  CPS1QuantumNuclear.movedState state (state.geometry.nodes.map (positionNode position))

private theorem positioned_nuclei (state : CPS1ElectronicSource.State frame) (position : Node → BodyPoint) :
    (positionedState state position).geometry.nuclei = state.geometry.nuclei.map (positionNode position) := by
  have retained (node : Node) : isNucleus (positionNode position node) = isNucleus node := rfl
  simp only [positionedState,CPS1QuantumNuclear.movedState,CPS1QuantumNuclear.movedGeometry,
    Geometry.nuclei,List.filter_map,Function.comp_def,retained]

private theorem positioned_electron_inertia (position : Node → BodyPoint) (nodes : List Node) :
    (((nodes.map (positionNode position)).find? isElectron).map (fun node => node.row.inertia)) =
      ((nodes.find? isElectron).map (fun node => node.row.inertia)) := by
  induction nodes with
  | nil => rfl
  | cons node rest ih =>
      have retained : isElectron (positionNode position node) = isElectron node := rfl
      cases electron : isElectron node <;>
        simp only [List.map_cons,List.find?_cons,retained,electron,ih,Option.map_some]
      all_goals rfl

private theorem positioned_spatial_energy (state : CPS1ElectronicSource.State frame)
    (position : Node → BodyPoint) (positions : Node → CPS1ElectronicSource.Point) :
    CPS1QuantumNuclear.spatialEnergyAt (positionedState state position) positions =
      CPS1QuantumNuclear.spatialEnergyAt state (fun node => positions (positionNode position node)) := by
  have inertia : (positionedState state position).geometry.electronInertia = state.geometry.electronInertia := by
    unfold positionedState CPS1QuantumNuclear.movedState CPS1QuantumNuclear.movedGeometry Geometry.electronInertia
    rw [positioned_electron_inertia]
  have kinetic : CPS1QuantumNuclear.kineticMatrix (positionedState state position) =
      CPS1QuantumNuclear.kineticMatrix state := by
    unfold CPS1QuantumNuclear.kineticMatrix CPS1ElectronicSource.kinetic
    rw [inertia]
    rfl
  have exchange : CPS1QuantumNuclear.exchangeEnergy (positionedState state position) =
      CPS1QuantumNuclear.exchangeEnergy state := rfl
  unfold CPS1QuantumNuclear.spatialEnergyAt CPS1QuantumNuclear.nuclearPotentialAt CPS1QuantumNuclear.electronicEnergyAt
  rw [positioned_nuclei]
  simp only [List.map_map,Function.comp_def,kinetic,exchange]
  rfl

private theorem spatial_energy_positions_congr (state : CPS1ElectronicSource.State frame)
    (first second : Node → CPS1ElectronicSource.Point)
    (same : ∀ node ∈ state.geometry.nuclei, first node = second node) :
    CPS1QuantumNuclear.spatialEnergyAt state first = CPS1QuantumNuclear.spatialEnergyAt state second := by
  have potential : CPS1QuantumNuclear.nuclearPotentialAt state first =
      CPS1QuantumNuclear.nuclearPotentialAt state second := by
    unfold CPS1QuantumNuclear.nuclearPotentialAt
    apply congrArg CPS1AtomicDynamics.Body.potential
    apply List.map_congr_left
    intro node member
    rw [same node member]
  have electronic : CPS1QuantumNuclear.electronicEnergyAt state first =
      CPS1QuantumNuclear.electronicEnergyAt state second := by
    unfold CPS1QuantumNuclear.electronicEnergyAt
    have mapped : (state.geometry.nuclei.map (fun node => CPS1QuantumNuclear.nucleusEnergyAt state node (first node))) =
        state.geometry.nuclei.map (fun node => CPS1QuantumNuclear.nucleusEnergyAt state node (second node)) := by
      apply List.map_congr_left
      intro node member
      rw [same node member]
    rw [mapped]
  unfold CPS1QuantumNuclear.spatialEnergyAt
  rw [potential,electronic]

/-- A source nuclear variation, with every original momentum and occupation retained. -/
def labLine (state : CPS1ElectronicSource.State frame)
    (direction : CPS1AtomicDynamics.Charged.Address → BodyPoint) (time : ℝ) :
    CPS1ElectronicSource.State frame :=
  positionedState state (fun node => if isNucleus node then
    node.row.position+time • direction node.particle.address else node.row.position)

theorem lab_line_occupied (state : CPS1ElectronicSource.State frame)
    (direction : CPS1AtomicDynamics.Charged.Address → BodyPoint) (time : ℝ) :
    (labLine state direction time).occupied = state.occupied := rfl

theorem lab_line_nuclei (state : CPS1ElectronicSource.State frame)
    (direction : CPS1AtomicDynamics.Charged.Address → BodyPoint) (time : ℝ) :
    (labLine state direction time).geometry.nuclei =
      state.geometry.nuclei.map (CPS1AtomicDynamics.Field.perturb direction time) := by
  unfold labLine
  rw [positioned_nuclei]
  apply List.map_congr_left
  intro node member
  have nucleus := (List.mem_filter.mp member).2
  simp only [positionNode,nucleus,if_true,CPS1AtomicDynamics.Field.perturb]

theorem lab_line_mass (state : CPS1ElectronicSource.State frame)
    (direction : CPS1AtomicDynamics.Charged.Address → BodyPoint) (time : ℝ) :
    massTotal (labLine state direction time) = massTotal state := by
  unfold massTotal
  rw [lab_line_nuclei]
  simp only [List.map_map,Function.comp_def,CPS1AtomicDynamics.Field.perturb]

theorem lab_line_centre (state : CPS1ElectronicSource.State frame)
    (direction : CPS1AtomicDynamics.Charged.Address → BodyPoint) (time : ℝ) :
    centre (labLine state direction time) = centreAlong state direction time := by
  unfold centre
  rw [lab_line_mass,lab_line_nuclei]
  simp only [centreAlong,List.map_map,Function.comp_def,CPS1AtomicDynamics.Field.perturb]

theorem following_energy_at (state : CPS1ElectronicSource.State frame) :
    energy state = CPS1QuantumNuclear.spatialEnergyAt state (fun node axis =>
      (node.row.position-centre state) axis) := by
  rw [energy,← CPS1QuantumNuclear.original_total_energy]
  change CPS1QuantumNuclear.spatialEnergyAt
    (positionedState state (fun node => node.row.position-centre state)) Geometry.nucleusPosition = _
  rw [positioned_spatial_energy]
  rfl

theorem energy_lab_line (state : CPS1ElectronicSource.State frame)
    (direction : CPS1AtomicDynamics.Charged.Address → BodyPoint) (time : ℝ) :
    energy (labLine state direction time) = energyLine state direction time := by
  rw [following_energy_at,lab_line_centre]
  unfold labLine
  rw [positioned_spatial_energy]
  unfold energyLine
  change _ = CPS1QuantumNuclear.spatialEnergyAt
    (positionedState state (fun node => node.row.position-centre state)) _
  rw [positioned_spatial_energy]
  apply spatial_energy_positions_congr
  intro node member
  have nucleus := (List.mem_filter.mp member).2
  simp only [positionNode,nucleus,if_true]
  funext axis
  exact congrArg (fun point : BodyPoint => point axis) (by abel)

theorem following_lab_energy_line (state : CPS1ElectronicSource.State frame)
    (unique : (state.geometry.nuclei.map (fun node => node.particle.address)).Nodup)
    (separated : CPS1AtomicDynamics.Body.ready state.geometry.nuclei)
    (direction : CPS1AtomicDynamics.Charged.Address → BodyPoint) :
    HasDerivAt (fun time : ℝ => energy (labLine state direction time))
      (-(state.geometry.nuclei.map (fun node => inner ℝ (nuclearForce state node)
        (direction node.particle.address))).sum) 0 := by
  simpa only [energy_lab_line] using following_energy_line state unique separated direction

end
end CPS1Following
