import H0mework.Versions.R9c73a630.ReleaseMaterials.SaturationMonoid.GenericFoundation.Operations.Inquiry.Cofinal.Native.Installed.Cofinal.Tower.Source
import H0mework.Versions.R9c73a630.Realization.Operations.Tree.Fold.Dependent.Joint.ActionWords.Inventory.NodeHilbert.Future.Wave.Full.Kernel
import Lean.LibrarySuggestions.Basic
run_cmd Lean.modifyEnv fun env => Lean.LibrarySuggestions.nameDenyListExt.addEntry env "ActualCofinalNativeTower"

/-! The original completion consumes the source-generated compatible native
observations. Its full fibre is the joint actual relation fibre. The native
Env update produces a completion morphism through the original addition
readout; this is distinct from cross-grade runtime-next AST transport. -/

set_option autoImplicit false
set_option Elab.async false
set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false
noncomputable section
universe u
namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace ActualCofinalNativeTower
open RootInquiryCompletion SourceOperationEffects SourceOperationScalarRelations SourceOperationScalarPresentation
open SourceOperationScalarInventoryLift SourceGeneratedScalarCofinalKernelCompletion CategoryTheory CategoryTheory.Limits
namespace K
export SourceOperationNative.Tree.Fold.Dependent.Joint.ActionWords.Inventory.NodeHilbert.Future.Wave.PaidSourceFullOrbit.CofinalKernel
 (zero_iff)
end K
variable {Sorts : Type u} {W X : Sorts → Type u} [∀ target, AddCommGroup (W target)] {s : Sorts}
local instance consumerGroups (grade : Nat) (target : Sorts) :
 AddCommGroup (L.Value W grade target) := L.groups W grade target
variable (factory : SF.Factory W X s)
variable (initial : M.Frame (Value := W) (Var := X) (sort := s))
variable (cfg : A.Programme (PhysicalValue := W) (PhysicalVar := X) (sort := s))
variable (language : cfg.LowVar = X)

abbrev Completion := (data factory initial cfg language).Completion (compatible factory initial cfg language)
abbrev sourceMap := (data factory initial cfg language).completionMap (compatible factory initial cfg language)

def readPrefix (bound : Nat) : Completion factory initial cfg language →ₗ[ℤ]
 Prefix factory initial cfg language bound :=
 ((data factory initial cfg language).stageRealization bound).comp
  ((data factory initial cfg language).restriction (compatible factory initial cfg language) bound).hom

/-- The existing completion-to-stage map reads the actual source inventory. -/
theorem source_prefix (bound : Nat) : sourceMap factory initial cfg language ≫
 ModuleCat.ofHom (readPrefix factory initial cfg language bound) =
 ModuleCat.ofHom (prefixEvaluator factory initial cfg language bound) :=
 (data factory initial cfg language).source_to_evaluator (compatible factory initial cfg language) bound

theorem source_stage (bound : Nat) (word : CommonWords factory initial cfg language)
 (index : Fin (bound + 1)) :
 readPrefix factory initial cfg language bound ((sourceMap factory initial cfg language).hom word) index =
 stageInventory factory initial cfg language index.val word :=
 congrFun (ConcreteCategory.congr_hom (source_prefix factory initial cfg language bound) word) index

/-- The existing full kernel consumer sees every source-generated native site. -/
theorem completion_zero_iff (word : CommonWords factory initial cfg language) :
 (sourceMap factory initial cfg language).hom word = 0 ↔
 ∀ ordinal, stageInventory factory initial cfg language ordinal word = 0 := by
 have whole := K.zero_iff (data factory initial cfg language)
  (compatible factory initial cfg language) word
 constructor
 · intro zero ordinal
   exact congrFun (whole.mp zero ordinal) ⟨ordinal,Nat.lt_succ_self ordinal⟩
 · intro zero
   apply whole.mpr
   intro bound
   funext index
   exact zero index.val

theorem completion_fibre (left right : CommonWords factory initial cfg language) :
 (sourceMap factory initial cfg language).hom left = (sourceMap factory initial cfg language).hom right ↔
 ∀ ordinal, stageInventory factory initial cfg language ordinal left =
  stageInventory factory initial cfg language ordinal right := by
 have whole := completion_zero_iff factory initial cfg language (left-right)
 rw [map_sub,sub_eq_zero] at whole
 exact whole.trans (forall_congr' fun ordinal => by rw [map_sub,sub_eq_zero])

/-- Every representative in the full cofinal fibre is generated by the original native relation maps. -/
theorem completion_fibre_generated (left right : CommonWords factory initial cfg language) :
 (sourceMap factory initial cfg language).hom left = (sourceMap factory initial cfg language).hom right ↔
 ∀ ordinal, liftMap (R := ℤ) (component factory initial cfg language ordinal (left-right)) ∈
 LinearMap.range (relationMap (R := ℤ) (pairEnvironment
  (oldEnvironment factory initial cfg language ordinal) (actualIncrement factory initial cfg language ordinal))) := by
 rw [completion_fibre]
 apply forall_congr'
 intro ordinal
 simp only [stageInventory,nativeInventory,LinearMap.comp_apply,map_sub]
 simpa only [map_sub] using inventory_fibre_generated (R := ℤ)
  (oldEnvironment factory initial cfg language ordinal) (actualIncrement factory initial cfg language ordinal)
  (component factory initial cfg language ordinal left) (component factory initial cfg language ordinal right)

/-- The updated Env comes from the original source material's actual request. -/
def updatedEnvironment (ordinal : Nat) : Env (NativeValue factory initial cfg language ordinal) X :=
 (N.input (C.materialAtStop factory initial cfg language ordinal)).environment

theorem updated_environment (ordinal : Nat) : updatedEnvironment factory initial cfg language ordinal =
 oldEnvironment factory initial cfg language ordinal + actualIncrement factory initial cfg language ordinal := by
 rw [installed_environment]
 rfl

abbrev UpdatedPrefix (bound : Nat) := (index : Fin (bound + 1)) →
 NativeValue factory initial cfg language index.val s

def updatedEvaluator (bound : Nat) : CommonWords factory initial cfg language →ₗ[ℤ]
 UpdatedPrefix factory initial cfg language bound :=
 LinearMap.pi fun index => (SourceOperationScalarRelations.evaluation (R := ℤ)
  (updatedEnvironment factory initial cfg language index.val)).comp
  (component factory initial cfg language index.val)

def updatedRestriction (bound : Nat) : UpdatedPrefix factory initial cfg language (bound+1) →ₗ[ℤ]
 UpdatedPrefix factory initial cfg language bound :=
 LinearMap.pi fun index => LinearMap.proj index.castSucc

def updatedData : Data (R := ℤ) (Generator := CommonWords factory initial cfg language)
 (Carrier := UpdatedPrefix factory initial cfg language) where
 evaluator := updatedEvaluator factory initial cfg language
 transition := updatedRestriction factory initial cfg language

theorem updated_compatible : (updatedData factory initial cfg language).Compatible := by
 intro bound
 apply LinearMap.ext
 intro word
 funext index
 rfl

def updateReadout (bound : Nat) : Prefix factory initial cfg language bound →ₗ[ℤ]
 UpdatedPrefix factory initial cfg language bound :=
 LinearMap.pi fun index => (additionReadout (R := ℤ)).comp (LinearMap.proj index)

/-- The real native Env update, at every original site, supplies the naturality calculation. -/
def updateMorphism : SourceGeneratedScalarCofinalNaturality.Morphism
 (data factory initial cfg language) (updatedData factory initial cfg language) where
 generatorMap := LinearMap.id
 stageMap := updateReadout factory initial cfg language
 transition_naturality := fun bound => by
  apply LinearMap.ext
  intro value
  funext index
  rfl
 evaluator_naturality := fun bound => by
  apply LinearMap.ext
  intro word
  funext index
  change (nativeInventory factory initial cfg language index.val
   (component factory initial cfg language index.val word)).1 +
   (nativeInventory factory initial cfg language index.val
    (component factory initial cfg language index.val word)).2 =
   SourceOperationScalarRelations.evaluation (R := ℤ)
    (updatedEnvironment factory initial cfg language index.val)
    (component factory initial cfg language index.val word)
  rw [updated_environment]
  exact (LinearMap.congr_fun (evaluation_update
   (oldEnvironment factory initial cfg language index.val)
   (actualIncrement factory initial cfg language index.val))
   (component factory initial cfg language index.val word)).symm

abbrev UpdatedCompletion := (updatedData factory initial cfg language).Completion
 (updated_compatible factory initial cfg language)
abbrev updatedSourceMap := (updatedData factory initial cfg language).completionMap
 (updated_compatible factory initial cfg language)

/-- The existing completion functor transports this actual update on the whole coefficient carrier. -/
def completionUpdate : Completion factory initial cfg language ⟶ UpdatedCompletion factory initial cfg language :=
 (updateMorphism factory initial cfg language).completionMorphism
  (compatible factory initial cfg language) (updated_compatible factory initial cfg language)

theorem completion_update_source : sourceMap factory initial cfg language ≫
 completionUpdate factory initial cfg language = updatedSourceMap factory initial cfg language := by
 have source := (updateMorphism factory initial cfg language).completionMorphism_source_naturality
  (compatible factory initial cfg language) (updated_compatible factory initial cfg language)
 exact source.trans (Category.id_comp _)

end ActualCofinalNativeTower
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
