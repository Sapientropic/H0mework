/-- The total density weight stays under 200. -/
theorem kinetic_row_weight_bound : kineticRowWeight ≤ 200 := by
  unfold kineticRowWeight
  calc ∑ a : Fin 4851, weightTermFin a
      ≤ ∑ a : Fin 4851, (kineticWeightBoundInt a : ℚ) / 10^12 := by
        apply Finset.sum_le_sum
        intro a _
        exact kinetic_weight_cell_bound a
    _ = ((∑ a : Fin 4851, kineticWeightBoundInt a : ℕ) : ℚ) / 10^12 := by
        rw [← Finset.sum_div, Nat.cast_sum]
    _ = ((kineticWeightBoundTotal : ℕ) : ℚ) / 10^12 := by
        rw [← kineticWeightBoundTotal_eq]
    _ ≤ 200 := by
        rw [kinetic_weight_bound_total]
        norm_num


