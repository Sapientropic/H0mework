  weight_chunk_eq_aux b.val b.isLt

theorem recordedKineticSum_eq_lits :
    recordedKineticSum = ((List.finRange 99).map fun b => recordedChunkLitQ b.val).sum := by
  unfold recordedKineticSum
  apply congrArg List.sum
  apply List.map_congr_left
  intro b _
  exact recorded_chunk_eq b

theorem kineticWeightBoundTotal_eq_lits :
    (kineticWeightBoundTotal : ℕ) = ((List.finRange 99).map fun b => weightChunkLit b.val).sum := by
  unfold kineticWeightBoundTotal
  apply congrArg List.sum
  apply List.map_congr_left
  intro b _
  exact weight_chunk_eq b

set_option maxHeartbeats 1600000 in
/-- The recorded kinetic contraction matches the source ledger's independent
    kinetic integral to better than 4·10⁻¹⁰. -/
theorem recorded_kinetic_sum_within :
    |recordedKineticSum -
      (((Reentry.Source.stepReadout.nuclear.targetLedger.integral .kinetic).independentIntegral : ℤ) : ℚ) /
        10^9| ≤ (4/10^10 : ℚ) := by
  rw [recordedKineticSum_eq_lits]
  decide +kernel

/-- The integer density bound total across all ledger rows. -/
theorem kinetic_weight_bound_total : kineticWeightBoundTotal = 199729531405613 := by
  rw [kineticWeightBoundTotal_eq_lits]
