def numerator : Matrix Basis Basis Int := Rows.rowMatrix sourceRows
def basisChange : Matrix Basis Basis Int := Rows.columnMatrix basisColumns
def firstProduct : Matrix Basis Basis Int := Rows.columnMatrix firstColumns
def gram : Matrix Basis Basis Int := Rows.rowMatrix gramRows

theorem first_exact : numerator*basisChange = firstProduct :=
  (Rows.first_matrix sourceRows basisColumns firstColumns sourceRowsLength
    sourceRowsLengths basisColumnsLengths allFirstColumns).symm

theorem gram_exact : basisChangeᵀ*firstProduct = gram :=
  (Rows.second_matrix basisColumns firstColumns gramRows firstColumnsLength
    basisColumnsLengths firstColumnsLengths allGramRows).symm

theorem margins (i : Basis) : 0 < 2*gram i i - ∑ j, |gram i j| := by
  have positive := allMargins i
  rw [Rows.margin, Rows.absSum_eq_sum _ (gramRowsLengths i)] at positive
  exact positive

