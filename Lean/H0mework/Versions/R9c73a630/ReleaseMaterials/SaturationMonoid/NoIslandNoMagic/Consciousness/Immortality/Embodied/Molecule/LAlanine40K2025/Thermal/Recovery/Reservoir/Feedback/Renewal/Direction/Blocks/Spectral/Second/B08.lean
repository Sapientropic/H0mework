theorem sourceDeltaRow56 (j : Basis) : sourceRows56[j.val]! =
    Witness.Upper.sourceRows56[j.val]! - (if j = (56 : Basis) then 150000000000000 else 0) +
      1000*Witness.vector[56]!*Witness.vector[j.val]! := by
  fin_cases j <;> rfl

theorem sourceRow56 (j : Basis) : sourceRows56[j.val]! =
    (if j = (56 : Basis) then 3000000000000000 else 0) -
      Propagation.Interface.activeNumerator Propagation.Source.electronicSource (56 : Basis) j + 1000*Witness.vector[56]!*Witness.vector[j.val]! := by
  rw [sourceDeltaRow56, Upper.sourceRow56]
  split_ifs <;> ring

theorem firstColumn56 : firstColumns56 = sourceRows.map (fun row => Rows.dot row basisColumns56) := by rfl

theorem gramRow56 : gramRows56 = firstColumns.map (Rows.dot basisColumns56) := by rfl

theorem dominanceRow56 : 0 < Rows.margin gramRows56 (⟨56, by decide +kernel⟩ : Fin 98) := by decide +kernel

theorem sourceRowsLength56 : sourceRows56.length = 98 := by rfl
theorem basisColumnsLength56 : basisColumns56.length = 98 := by rfl
theorem firstColumnsLength56 : firstColumns56.length = 98 := by rfl
theorem gramRowsLength56 : gramRows56.length = 98 := by rfl

