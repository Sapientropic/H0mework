theorem applied_component (i : Basis) : appliedVector[i.val]! =
    ∑ j : Basis, Propagation.Interface.activeNumerator Propagation.Source.electronicSource i j * vector[j.val]! := by
  have computed := applied_all i
  rw [Rows.dot_eq_sum _ _ (Upper.sourceRowsLengths i) length] at computed
  change appliedVector[i.val]! = 3150000000000000*vector[i.val]! -
    ∑ j : Basis, Upper.numerator i j * vector[j.val]! at computed
  simp_rw [Upper.source_entries, sub_mul] at computed
  rw [Finset.sum_sub_distrib] at computed
  have diagonal : (∑ j : Basis, (if j = i then (3150000000000000 : Int) else 0)*vector[j.val]!) =
      3150000000000000*vector[i.val]! := by simp
  rw [diagonal] at computed
  omega

