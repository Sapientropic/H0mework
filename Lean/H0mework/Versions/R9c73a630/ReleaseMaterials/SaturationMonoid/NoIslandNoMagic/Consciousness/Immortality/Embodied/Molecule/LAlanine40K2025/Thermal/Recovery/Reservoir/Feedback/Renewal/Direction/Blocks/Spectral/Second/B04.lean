theorem sourceDeltaRow28 (j : Basis) : sourceRows28[j.val]! =
    Witness.Upper.sourceRows28[j.val]! - (if j = (28 : Basis) then 150000000000000 else 0) +
      1000*Witness.vector[28]!*Witness.vector[j.val]! := by
  fin_cases j <;> rfl

theorem sourceRow28 (j : Basis) : sourceRows28[j.val]! =
    (if j = (28 : Basis) then 3000000000000000 else 0) -
      Propagation.Interface.activeNumerator Propagation.Source.electronicSource (28 : Basis) j + 1000*Witness.vector[28]!*Witness.vector[j.val]! := by
  rw [sourceDeltaRow28, Upper.sourceRow28]
  split_ifs <;> ring

theorem firstColumn28 : firstColumns28 = sourceRows.map (fun row => Rows.dot row basisColumns28) := by rfl

theorem gramRow28 : gramRows28 = firstColumns.map (Rows.dot basisColumns28) := by rfl

theorem dominanceRow28 : 0 < Rows.margin gramRows28 (⟨28, by decide +kernel⟩ : Fin 98) := by decide +kernel

theorem sourceRowsLength28 : sourceRows28.length = 98 := by rfl
theorem basisColumnsLength28 : basisColumns28.length = 98 := by rfl
theorem firstColumnsLength28 : firstColumns28.length = 98 := by rfl
theorem gramRowsLength28 : gramRows28.length = 98 := by rfl

