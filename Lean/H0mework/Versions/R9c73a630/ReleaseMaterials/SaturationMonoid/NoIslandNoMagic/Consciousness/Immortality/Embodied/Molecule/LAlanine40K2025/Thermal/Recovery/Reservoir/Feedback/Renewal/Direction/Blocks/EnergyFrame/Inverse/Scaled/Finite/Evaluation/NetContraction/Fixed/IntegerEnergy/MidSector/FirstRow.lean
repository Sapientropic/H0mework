theorem mid_first_staged_gain_literal : midFirstStagedGain =
    3998910253842178850862896 / 10^30 := by
  simp only [midFirstStagedGain,staged_ordinary_gain_same,sourceOrdinaryGainIntQ,
    mid_first_integer_gain]
  norm_num [midFirstNumerator,Fin.sum_univ_succ,scale]

noncomputable def midFirstOriginalGain : ℝ :=
  ∑ b : Fin 18, (smallGainQ (s(midAnchor 0,midPartner b)) : ℝ)

private theorem mid_first_mass_upper :
    (∑ b : Fin 18, (midSectorBody 0 b).trace.re) < (1001/1000 : ℝ) := by
  have nonnegative : (0 : ℝ) ≤ ∑ b : Fin 18, (midSectorBody 1 b).trace.re :=
    Finset.sum_nonneg (fun b _ =>
      (Complex.nonneg_iff.mp (mid_sector_body_positive 1 b).trace_nonneg).1)
  have full := mid_computed_mass_upper
  rw [← mid_sector_body_mass_sum,Fin.sum_univ_two] at full
  linarith only [nonnegative,full]

theorem mid_first_original_staged_error :
    |(midFirstStagedGain : ℝ)-midFirstOriginalGain| < (501/10^10 : ℝ) := by
  have point (b : Fin 18) :
      |(stagedOrdinaryGainIntQ (midAnchor 0) (midPartner b) (mid_address_ordered 0 b) : ℝ)-
        (smallGainQ (s(midAnchor 0,midPartner b)) : ℝ)| ≤
        (5/10^8 : ℝ)*(midSectorBody 0 b).trace.re+1/10^20 := by
    rw [mid_sector_body_trace]
    exact staged_ordinary_gain_error_by_mass _ _ (mid_address_ordered 0 b)
  have bound : |(midFirstStagedGain : ℝ)-midFirstOriginalGain| ≤
      ∑ b : Fin 18, ((5/10^8 : ℝ)*(midSectorBody 0 b).trace.re+1/10^20) := by
    simp only [midFirstStagedGain,midFirstOriginalGain,Rat.cast_sum,← Finset.sum_sub_distrib]
    exact (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum (fun b _ => point b))
  simp only [Finset.sum_add_distrib,← Finset.mul_sum,Finset.sum_const,
    Finset.card_univ,Fintype.card_fin,nsmul_eq_mul] at bound
  have mass := mid_first_mass_upper
  linarith only [bound,mass]

theorem mid_first_original_gain_lower :
    (3948/10^9 : ℝ) < midFirstOriginalGain := by
  have exactStage : (midFirstStagedGain : ℝ) =
      (3998910253842178850862896 / 10^30 : ℝ) := by
    rw [mid_first_staged_gain_literal]
    norm_num
  have error := (abs_lt.mp mid_first_original_staged_error).2
  rw [exactStage] at error
  linarith only [error]

