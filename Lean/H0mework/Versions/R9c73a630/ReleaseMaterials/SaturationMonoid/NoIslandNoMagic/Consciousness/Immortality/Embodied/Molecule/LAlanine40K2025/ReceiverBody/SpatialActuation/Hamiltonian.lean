import H0mework.Versions.R9c73a630.ReleaseMaterials.SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Molecule.LAlanine40K2025.ReceiverBody.SpatialActuation.Trajectory

set_option autoImplicit false
set_option maxRecDepth 16384
set_option maxHeartbeats 0
namespace SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Molecule.LAlanine40K2025.ReceiverBody.SpatialActuation
noncomputable section

def bodyEnergy (phase : Phase) (t : ℝ) : ℝ :=
  input.body.resource.momentum+nuclearKinetic (FiniteContinuation.momentum input)+sourcePotential-receiver phase t

-- The moving center is generated by the input path, not supplied as a target witness.
def hamiltonian (phase : Phase) (t : ℝ) (r p : Configuration) : ℝ :=
  bodyEnergy phase t+∑ i, ((p i-momentum phase t i)^2/(2*mass i)+
    velocity phase t i*(p i-momentum phase t i)-force phase t i*(r i-position phase t i))

def vectorControl (phase : Phase) (t : ℝ) (i : Coordinate) : ℝ :=
  momentum phase t i-mass i*velocity phase t i

def scalarControl (phase : Phase) (t : ℝ) : ℝ :=
  bodyEnergy phase t-sourcePotential-nuclearKinetic (fun i => mass i*velocity phase t i)

theorem complete_control_energy (phase : Phase) (t : ℝ) (r p : Configuration) :
    hamiltonian phase t r p=nuclearKinetic (p-vectorControl phase t)+sourcePotential-
      (∑ i, force phase t i*(r i-position phase t i))+scalarControl phase t := by
  have kinetic : nuclearKinetic (p-vectorControl phase t)-nuclearKinetic (fun i => mass i*velocity phase t i)=
      ∑ i, ((p i-momentum phase t i)^2/(2*mass i)+velocity phase t i*(p i-momentum phase t i)) := by
    unfold nuclearKinetic
    rw [← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro i _
    dsimp only [Pi.sub_apply,vectorControl]
    field_simp [ne_of_gt (mass_positive i)]
    ring
  unfold hamiltonian scalarControl
  rw [Finset.sum_sub_distrib]
  linarith only [kinetic]

theorem on_path_energy (phase : Phase) (t : ℝ) :
    hamiltonian phase t (position phase t) (momentum phase t)=bodyEnergy phase t := by
  simp [hamiltonian]

theorem receiver_body_account (phase : Phase) (t : ℝ) :
    receiver phase t+hamiltonian phase t (position phase t) (momentum phase t)=
      input.body.resource.momentum+nuclearKinetic (FiniteContinuation.momentum input)+sourcePotential := by
  rw [on_path_energy,bodyEnergy]
  ring

theorem position_partial (phase : Phase) (t : ℝ) (i : Coordinate) :
    HasDerivAt (fun x => hamiltonian phase t
      (Function.update (position phase t) i (position phase t i+x)) (momentum phase t))
        (-force phase t i) 0 := by
  have normal (x : ℝ) : hamiltonian phase t
      (Function.update (position phase t) i (position phase t i+x)) (momentum phase t)=
      bodyEnergy phase t-force phase t i*x := by
    unfold hamiltonian
    have entry (j : Coordinate) :
        (momentum phase t j-momentum phase t j)^2/(2*mass j)+
        velocity phase t j*(momentum phase t j-momentum phase t j)-
        force phase t j*((Function.update (position phase t) i (position phase t i+x)) j-position phase t j)=
        if j=i then -force phase t i*x else 0 := by
      by_cases same : j=i
      · subst j; simp
      · simp [same]
    simp_rw [entry]
    simp
    ring
  simp_rw [normal]
  simpa using! (hasDerivAt_const (0 : ℝ) (bodyEnergy phase t)).sub
    ((hasDerivAt_id (0 : ℝ)).const_mul (force phase t i))

theorem momentum_partial (phase : Phase) (t : ℝ) (i : Coordinate) :
    HasDerivAt (fun x => hamiltonian phase t (position phase t)
      (Function.update (momentum phase t) i (momentum phase t i+x))) (velocity phase t i) 0 := by
  have normal (x : ℝ) : hamiltonian phase t (position phase t)
      (Function.update (momentum phase t) i (momentum phase t i+x))=
      bodyEnergy phase t+x^2/(2*mass i)+velocity phase t i*x := by
    unfold hamiltonian
    have entry (j : Coordinate) :
        ((Function.update (momentum phase t) i (momentum phase t i+x)) j-momentum phase t j)^2/(2*mass j)+
        velocity phase t j*((Function.update (momentum phase t) i (momentum phase t i+x)) j-momentum phase t j)-
        force phase t j*(position phase t j-position phase t j)=
        if j=i then x^2/(2*mass i)+velocity phase t i*x else 0 := by
      by_cases same : j=i
      · subst j; simp
      · simp [same]
    simp_rw [entry]
    simp
    ring
  simp_rw [normal]
  simpa using! ((((hasDerivAt_id (0 : ℝ)).pow 2).div_const (2*mass i)).const_add
    (bodyEnergy phase t)).add ((hasDerivAt_id (0 : ℝ)).const_mul (velocity phase t i))

theorem clock_partial (phase : Phase) (t : ℝ) :
    HasDerivAt (fun time => hamiltonian phase time (position phase t) (momentum phase t))
      (-receiverForce phase t) t := by
  have energy : HasDerivAt (bodyEnergy phase) (-receiverForce phase t) t := by
    simpa only [bodyEnergy,zero_sub] using!
      (hasDerivAt_const t (input.body.resource.momentum+
        nuclearKinetic (FiniteContinuation.momentum input)+sourcePotential)).sub (receiver_equation phase t)
  have each (i : Coordinate) : HasDerivAt (fun time =>
      (momentum phase t i-momentum phase time i)^2/(2*mass i)+
      velocity phase time i*(momentum phase t i-momentum phase time i)-
      force phase time i*(position phase t i-position phase time i)) 0 t := by
    have dp := (hasDerivAt_const t (momentum phase t i)).sub (momentum_equation phase t i)
    have dr := (hasDerivAt_const t (position phase t i)).sub (position_equation phase t i)
    have dv := (velocity_differentiable phase i t).hasDerivAt
    have df := (force_differentiable phase i t).hasDerivAt
    have hd := (((dp.pow 2).div_const (2*mass i)).add (dv.mul dp)).sub (df.mul dr)
    convert hd using 1 <;> try rfl
    dsimp only [Pi.sub_apply,Pi.pow_apply]
    simp only [sub_self,mul_zero,zero_sub,zero_add]
    ring
  simpa only [hamiltonian,Finset.sum_const_zero,add_zero] using!
    energy.add (HasDerivAt.fun_sum (u := Finset.univ) (fun i _ => each i))

end
end SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Molecule.LAlanine40K2025.ReceiverBody.SpatialActuation
