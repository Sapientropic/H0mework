  · simpa [midSecondFloorQ,midAnchor,midPartner] using midA120_qnet_row_floor
  · simpa [midSecondFloorQ,midAnchor,midPartner] using midA121_qnet_row_floor
  · simpa [midSecondFloorQ,midAnchor,midPartner] using midA122_qnet_row_floor
  · simpa [midSecondFloorQ,midAnchor,midPartner] using midA123_qnet_row_floor

def midFloorQ (a : Fin 2) (b : Fin 18) : ℚ :=
  if a=0 then midFirstFloorQ b else midSecondFloorQ b

theorem mid_complete_qnet_floor (a : Fin 2) (b : Fin 18) :
    (midFloorQ a b : ℝ) • (1 : Matrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) ℂ) ≤
      sourceOrdinaryQNet (midAnchor a) (midPartner b) (mid_address_ordered a b) := by
  fin_cases a
  · exact mid_first_qnet_floor b
  · exact mid_second_qnet_floor b

def midStagedGain : ℚ :=
  ∑ a : Fin 2, ∑ b : Fin 18,
    stagedOrdinaryGainIntQ (midAnchor a) (midPartner b) (mid_address_ordered a b)

theorem mid_complete_staged_gain_literal : midStagedGain =
    7922472141690388743464967 / 10^30 := by
  simp only [midStagedGain,Fin.sum_univ_two,staged_ordinary_gain_same,sourceOrdinaryGainIntQ,
    mid_first_integer_gain,mid_second_integer_gain]
  norm_num [midFirstNumerator,midSecondNumerator,Fin.sum_univ_succ,scale]

theorem mid_complete_original_staged_error :
    |(midStagedGain : ℝ)-midOriginalGain| < (501/10^10 : ℝ) := by
  have point (a : Fin 2) (b : Fin 18) :
      |(stagedOrdinaryGainIntQ (midAnchor a) (midPartner b) (mid_address_ordered a b) : ℝ)-
        (smallGainQ (s(midAnchor a,midPartner b)) : ℝ)| ≤
        (5/10^8 : ℝ)*(midSectorBody a b).trace.re+1/10^20 := by
    rw [mid_sector_body_trace]
    exact staged_ordinary_gain_error_by_mass _ _ (mid_address_ordered a b)
  have bound : |(midStagedGain : ℝ)-midOriginalGain| ≤
      ∑ a : Fin 2, ∑ b : Fin 18,
        ((5/10^8 : ℝ)*(midSectorBody a b).trace.re+1/10^20) := by
    simp only [midStagedGain,midOriginalGain,Rat.cast_sum,← Finset.sum_sub_distrib]
    apply (Finset.abs_sum_le_sum_abs _ _).trans
    apply Finset.sum_le_sum
    intro a _
    exact (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum (fun b _ => point a b))
  have sum_eq : (∑ a : Fin 2, ∑ b : Fin 18,
      ((5/10^8 : ℝ)*(midSectorBody a b).trace.re+1/10^20)) =
      (5/10^8 : ℝ)*midComputedMass+36*(1/10^20) := by
    simp only [Finset.sum_add_distrib,← Finset.mul_sum,Finset.sum_const,
      Finset.card_univ,Fintype.card_fin,nsmul_eq_mul,mid_sector_body_mass_sum]
    ring
  rw [sum_eq] at bound
  have mass := mid_computed_mass_upper
  linarith only [bound,mass]

theorem mid_complete_original_gain_lower : (7872/10^9 : ℝ) < midOriginalGain := by
  have stage : (midStagedGain : ℝ) = (7922472141690388743464967/10^30 : ℝ) := by
    rw [mid_complete_staged_gain_literal]
    norm_num
  have error := (abs_lt.mp mid_complete_original_staged_error).2
  rw [stage] at error
  linarith only [error]

