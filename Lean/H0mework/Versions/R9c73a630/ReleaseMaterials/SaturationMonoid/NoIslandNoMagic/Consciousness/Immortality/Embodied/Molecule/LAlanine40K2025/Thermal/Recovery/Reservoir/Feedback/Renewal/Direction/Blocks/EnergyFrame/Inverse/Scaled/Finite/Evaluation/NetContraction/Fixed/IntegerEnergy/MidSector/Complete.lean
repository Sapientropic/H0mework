theorem mid_second_integer_gain (b : Fin 18) :
    sourceOrdinaryGainNumeratorInt (midAnchor 1) (midPartner b) (mid_address_ordered 1 b) =
      midSecondNumerator b := by
  fin_cases b
  · exact midA106_original_integer_gain
  · exact midA107_original_integer_gain
  · exact midA108_original_integer_gain
  · exact midA109_original_integer_gain
  · exact midA110_original_integer_gain
