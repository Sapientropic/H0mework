  · exact midA120_original_integer_gain
  · exact midA121_original_integer_gain
  · exact midA122_original_integer_gain
  · exact midA123_original_integer_gain

def midSecondFloorQ (b : Fin 18) : ℚ :=
  ![9681,9606,9557,9529,9476,9464,9458,9393,9372,9338,9334,9326,9298,9278,9273,9206,9204,9191] b / 10^9

theorem mid_second_qnet_floor (b : Fin 18) :
    (midSecondFloorQ b : ℝ) • (1 : Matrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) ℂ) ≤
      sourceOrdinaryQNet (midAnchor 1) (midPartner b) (mid_address_ordered 1 b) := by
  fin_cases b
  · simpa [midSecondFloorQ,midAnchor,midPartner] using midA106_qnet_row_floor
  · simpa [midSecondFloorQ,midAnchor,midPartner] using midA107_qnet_row_floor
  · simpa [midSecondFloorQ,midAnchor,midPartner] using midA108_qnet_row_floor
  · simpa [midSecondFloorQ,midAnchor,midPartner] using midA109_qnet_row_floor
  · simpa [midSecondFloorQ,midAnchor,midPartner] using midA110_qnet_row_floor
  · simpa [midSecondFloorQ,midAnchor,midPartner] using midA111_qnet_row_floor
  · simpa [midSecondFloorQ,midAnchor,midPartner] using midA112_qnet_row_floor
  · simpa [midSecondFloorQ,midAnchor,midPartner] using midA113_qnet_row_floor
  · simpa [midSecondFloorQ,midAnchor,midPartner] using midA114_qnet_row_floor
  · simpa [midSecondFloorQ,midAnchor,midPartner] using midA115_qnet_row_floor
  · simpa [midSecondFloorQ,midAnchor,midPartner] using midA116_qnet_row_floor
  · simpa [midSecondFloorQ,midAnchor,midPartner] using midA117_qnet_row_floor
