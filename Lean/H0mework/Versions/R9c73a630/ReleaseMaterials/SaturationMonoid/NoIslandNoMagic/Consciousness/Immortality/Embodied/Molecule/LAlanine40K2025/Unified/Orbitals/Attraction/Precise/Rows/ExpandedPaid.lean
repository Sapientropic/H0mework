noncomputable def expandedPaidAddresses : Finset (Fin 4851) :=
  Finset.univ.filter fun a =>
    (targetLeft a.val).val ≤ 12 ∨
      (20 ≤ (targetLeft a.val).val ∧ (targetLeft a.val).val ≤ 26) ∨
      (41 ≤ (targetLeft a.val).val ∧ (targetLeft a.val).val ≤ 48)

theorem expanded_paid_addresses_card : expandedPaidAddresses.card = 2149 := by
  decide +kernel

theorem old_paid_subset : paidAddresses ⊆ expandedPaidAddresses := by
  intro a old
  simp only [paidAddresses,expandedPaidAddresses,Finset.mem_filter,Finset.mem_univ, true_and] at old ⊢
  rcases old with old | old
  · exact Or.inl (le_trans old (by decide))
  · exact Or.inr (Or.inl ⟨old.1,le_trans old.2 (by decide)⟩)

theorem expanded_paid_address_error (a : Fin 4851) (paid : a ∈ expandedPaidAddresses) :
    |aoIntegral (targetLeft a.val) (targetRight a.val) -
      (recordedAttraction (targetLeft a.val) (targetRight a.val) : ℝ)| ≤
        (1/10^12 : ℝ) := by
  have selected : (targetLeft a.val).val ≤ 12 ∨
      (20 ≤ (targetLeft a.val).val ∧ (targetLeft a.val).val ≤ 26) ∨
      (41 ≤ (targetLeft a.val).val ∧ (targetLeft a.val).val ≤ 48) :=
    (Finset.mem_filter.mp paid).2
  rcases all_target_rows_certified a with ⟨_,_,_,_,ordered,_,_,_⟩
  exact expanded_paid_upper_error _ _ selected ordered

