def fullRowError (b : Basis) : ℝ :=
  if b.val = 73 ∨ b.val = 75 ∨ b.val = 81 then 4/10^12
  else if b.val = 13 ∨ b.val = 51 ∨ b.val = 71 ∨ b.val = 74 then 2/10^12
  else 1/10^12

