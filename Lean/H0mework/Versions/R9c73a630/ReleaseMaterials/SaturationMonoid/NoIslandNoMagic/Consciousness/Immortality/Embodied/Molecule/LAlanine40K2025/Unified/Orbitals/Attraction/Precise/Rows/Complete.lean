theorem full_row_error_le_four (b : Basis) : fullRowError b ≤ (4/10^12 : ℝ) := by
  unfold fullRowError
  split_ifs <;> norm_num

def fullAddressError (a : Fin 4851) : ℝ := fullRowError (targetLeft a.val)

theorem full_address_error (a : Fin 4851) :
    |aoIntegral (targetLeft a.val) (targetRight a.val) -
      (recordedAttraction (targetLeft a.val) (targetRight a.val) : ℝ)| ≤
        fullAddressError a := by
  rcases all_target_rows_certified a with ⟨_,_,_,_,ordered,_,_,_⟩
  exact full_upper_error _ _ ordered

theorem full_address_error_le_four (a : Fin 4851) :
    fullAddressError a ≤ (4/10^12 : ℝ) := full_row_error_le_four _

def fullPaidAddresses : Finset (Fin 4851) := Finset.univ

theorem full_paid_addresses_card : fullPaidAddresses.card = 4851 := by
  simp [fullPaidAddresses]

theorem almost_subset_full : almostPaidAddresses ⊆ fullPaidAddresses := by
  intro a _
  simp [fullPaidAddresses]

