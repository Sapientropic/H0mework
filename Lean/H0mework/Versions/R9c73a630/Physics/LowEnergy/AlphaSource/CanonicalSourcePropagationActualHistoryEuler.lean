open scoped BigOperators Topology ContDiff NNReal
abbrev Op := PreparationVacuumPropagationPencil.Op
local instance : NormedAlgebra ℝ Op := NormedAlgebra.restrictScalars ℝ ℂ _
attribute [local irreducible] jointGenerator

abbrev HistoryPhase := ℝ × ℝ × (Op × Op)

def nativeHistoryVector (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (history : ℝ → Field289) (y : HistoryPhase) : HistoryPhase :=
  (1,0,((-Complex.I) • jointGenerator p F 0 (y.2.1 • history y.1))*y.2.2.1,
    -y.2.2.2*((-Complex.I) • jointGenerator p F 0 (y.2.1 • history y.1)))

def historyOrigin : HistoryPhase := (0,0,1,1)
attribute [local irreducible] nativeHistoryVector

theorem nativeHistoryVector_smooth (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (history : ℝ → Field289) (smooth : ContDiffAt ℝ 1 history 0) :
    ContDiffAt ℝ 1 (nativeHistoryVector p F history) historyOrigin := by
  unfold nativeHistoryVector
  have time : ContDiffAt ℝ 1 (fun y : HistoryPhase => history y.1) historyOrigin :=
    smooth.comp historyOrigin contDiffAt_fst
  have field : ContDiffAt ℝ 1 (fun y : HistoryPhase => y.2.1 • history y.1) historyOrigin :=
    (contDiffAt_fst.comp historyOrigin contDiffAt_snd).smul time
  have source : ContDiffAt ℝ 1 (fun y : HistoryPhase => jointGenerator p F 0
      (y.2.1 • history y.1)) historyOrigin := by
    have origin : (historyOrigin.2.1 • history historyOrigin.1 : Field289) = 0 := by
      simp [historyOrigin]
    have generated := (jointGenerator_C2 p F 0).of_le (show (1 : ℕ∞ω) ≤ 2 by norm_num)
    rw [←origin] at generated
    exact generated.comp historyOrigin field
  have state : ContDiffAt ℝ 1 (fun y : HistoryPhase => y.2.2) historyOrigin :=
    contDiffAt_snd.comp historyOrigin contDiffAt_snd
  exact contDiffAt_const.prodMk (contDiffAt_const.prodMk
    (((source.const_smul (-Complex.I)).mul (contDiffAt_fst.comp historyOrigin state)).prodMk
      (((contDiffAt_snd.comp historyOrigin state).neg).mul (source.const_smul (-Complex.I)))))

/-- A whole actual nonlinear history flow is generated by the source ODE. -/
theorem nativeHistoryFlow_exists (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (history : ℝ → Field289) (smooth : ContDiffAt ℝ 1 history 0) :
    ∃ radius > (0 : ℝ), ∃ duration > (0 : ℝ),
      ∀ initial ∈ closedBall historyOrigin radius, ∃ flow : ℝ → HistoryPhase,
        flow 0=initial ∧ ∀ t∈Ioo (-duration) duration,
          HasDerivAt flow (nativeHistoryVector p F history (flow t)) t := by
  simpa only [zero_sub,zero_add] using
    (nativeHistoryVector_smooth p F history smooth).exists_forall_mem_closedBall_exists_eq_forall_mem_Ioo_hasDerivAt (0 : ℝ)

private theorem c1_lipschitz_flow {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [CompleteSpace E] (f : E → E) (origin : E)
    (smooth : ContDiffAt ℝ 1 f origin) :
    ∃ radius > (0 : ℝ), ∃ duration > (0 : ℝ), ∃ price : ℝ≥0, ∃ flow : E → ℝ → E,
      (∀ initial∈closedBall origin radius, flow initial 0=initial ∧
        ∀ t∈Ioo (-duration) duration, HasDerivAt (flow initial) (f (flow initial t)) t) ∧
      ∀ t∈Ioo (-duration) duration, LipschitzOnWith price (fun initial=>flow initial t) (closedBall origin radius) := by
  obtain ⟨duration,positive,a,r,L,K,positiveRadius,model⟩:=IsPicardLindelof.of_contDiffAt_one smooth
  obtain ⟨flow,paid,price,controlled⟩:=
    (model 0).exists_forall_mem_closedBall_eq_hasDerivWithinAt_lipschitzOnWith
  refine ⟨r,by exact_mod_cast positiveRadius,duration,positive,price,flow,?_,?_⟩
  · intro initial member
    have actual:=paid initial member
    refine ⟨actual.1,?_⟩
    intro t inside
    exact (actual.2 t (by constructor <;> linarith [inside.1,inside.2])).hasDerivAt (Icc_mem_nhds (by linarith [inside.1]) (by linarith [inside.2]))
  · intro t inside
    exact controlled t (by constructor <;> linarith [inside.1,inside.2])

/-- The same source-generated family is uniformly controlled in its initial amplitude. -/
theorem nativeHistoryLipschitzFlow_exists (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (history : ℝ → Field289) (smooth : ContDiffAt ℝ 1 history 0) :
    ∃ radius > (0 : ℝ), ∃ duration > (0 : ℝ), ∃ price : ℝ≥0,
      ∃ flow : HistoryPhase → ℝ → HistoryPhase,
        (∀ initial∈closedBall historyOrigin radius, flow initial 0=initial ∧
          ∀ t∈Ioo (-duration) duration,
            HasDerivAt (flow initial) (nativeHistoryVector p F history (flow initial t)) t) ∧
        ∀ t∈Ioo (-duration) duration,
          LipschitzOnWith price (fun initial=>flow initial t) (closedBall historyOrigin radius) :=
  c1_lipschitz_flow (nativeHistoryVector p F history) historyOrigin
    (nativeHistoryVector_smooth p F history smooth)

private theorem constant_interval {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : ℝ → E) (duration : ℝ) (positive : 0 < duration)
    (paid : ∀ t∈Ioo (-duration) duration, HasDerivAt f 0 t)
    (t : ℝ) (inside : t∈Ioo (-duration) duration) : f t=f 0 := by
  exact isOpen_Ioo.is_const_of_deriv_eq_zero (convex_Ioo _ _).isPreconnected
    (fun z hz=>(paid z hz).differentiableAt.differentiableWithinAt)
    (fun z hz=>(paid z hz).deriv) inside (by constructor <;> linarith)

private theorem flow_coordinates {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (body : (ℝ × ℝ × E) → E) (duration : ℝ) (positive : 0<duration) (amplitude : ℝ)
    (flow : ℝ → (ℝ × ℝ × E)) (initialTime : (flow 0).1=0)
    (initialAmplitude : (flow 0).2.1=amplitude)
    (paid : ∀t∈Ioo (-duration) duration,
      HasDerivAt flow (1,0,body (flow t)) t)
    (t : ℝ) (inside : t∈Ioo (-duration) duration) :
    (flow t).1=t ∧ (flow t).2.1=amplitude := by
  have time (z : ℝ) (hz : z∈Ioo (-duration) duration) :
      HasDerivAt (fun r=>(flow r).1-r) 0 z := by
    have generated := (ContinuousLinearMap.fst ℝ ℝ (ℝ × E)).hasFDerivAt.comp_hasDerivAt z (paid z hz)
    have actual : HasDerivAt (fun r=>(flow r).1) 1 z := generated
    exact actual.sub (hasDerivAt_id z) |>.congr_deriv (sub_self 1)
  have amp (z : ℝ) (hz : z∈Ioo (-duration) duration) :
      HasDerivAt (fun r=>(flow r).2.1) 0 z := by
    let projection := (ContinuousLinearMap.fst ℝ ℝ E).comp (ContinuousLinearMap.snd ℝ ℝ (ℝ × E))
    exact projection.hasFDerivAt.comp_hasDerivAt z (paid z hz)
  have timeValue:=constant_interval _ duration positive time t inside
  have ampValue:=constant_interval _ duration positive amp t inside
  constructor
  · rw [initialTime,sub_self] at timeValue
    exact sub_eq_zero.mp timeValue
  · exact ampValue.trans initialAmplitude

theorem history_coordinates (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (history : ℝ → Field289) (duration : ℝ) (positive : 0<duration) (amplitude : ℝ)
    (flow : ℝ → HistoryPhase) (initial : flow 0=(0,amplitude,1,1))
    (paid : ∀t∈Ioo (-duration) duration,
      HasDerivAt flow (nativeHistoryVector p F history (flow t)) t)
    (t : ℝ) (inside : t∈Ioo (-duration) duration) :
    (flow t).1=t ∧ (flow t).2.1=amplitude := by
  have initialTime : (flow 0).1=0 := congrArg (fun y : HistoryPhase=>y.1) initial
  have initialAmplitude : (flow 0).2.1=amplitude := congrArg (fun y : HistoryPhase=>y.2.1) initial
  exact flow_coordinates (fun y : HistoryPhase =>
    (((-Complex.I) • jointGenerator p F 0 (y.2.1 • history y.1))*y.2.2.1,
      -y.2.2.2*((-Complex.I) • jointGenerator p F 0 (y.2.1 • history y.1))))
    duration positive amplitude flow initialTime initialAmplitude (by
      intro z hz
      simpa only [nativeHistoryVector] using paid z hz) t inside

structure NativeHistoryEvolution (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (history : ℝ → Field289) where
  radius : ℝ
  radius_positive : 0 < radius
  duration : ℝ
  duration_positive : 0 < duration
  price : ℝ≥0
  flow : HistoryPhase → ℝ → HistoryPhase
  generated : ∀ initial∈closedBall historyOrigin radius, flow initial 0=initial ∧
    ∀ t∈Ioo (-duration) duration,
      HasDerivAt (flow initial) (nativeHistoryVector p F history (flow initial t)) t
  controlled : ∀ t∈Ioo (-duration) duration,
    LipschitzOnWith price (fun initial=>flow initial t) (closedBall historyOrigin radius)

theorem nativeHistoryEvolution_nonempty (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (history : ℝ → Field289) (smooth : ContDiffAt ℝ 1 history 0) :
    Nonempty (NativeHistoryEvolution p F history) := by
  rcases nativeHistoryLipschitzFlow_exists p F history smooth with
    ⟨radius,positiveRadius,duration,positiveDuration,price,flow,generated,controlled⟩
  exact ⟨⟨radius,positiveRadius,duration,positiveDuration,price,flow,generated,controlled⟩⟩

noncomputable def sourceHistoryEvolution (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (history : ℝ → Field289) (smooth : ContDiffAt ℝ 1 history 0) : NativeHistoryEvolution p F history :=
  Classical.choice (nativeHistoryEvolution_nonempty p F history smooth)

attribute [local irreducible] sourceHistoryEvolution

def historyAmplitudeInput (amplitude : ℝ) : HistoryPhase := (0,amplitude,1,1)

private theorem amplitudeInput_member (radius amplitude : ℝ) (positive : 0<radius)
    (small : |amplitude|<radius) : historyAmplitudeInput amplitude∈closedBall historyOrigin radius := by
  simp only [mem_closedBall,historyAmplitudeInput,historyOrigin,Prod.dist_eq,Real.dist_eq,sub_zero,dist_self]
  exact max_le (le_of_lt positive) (max_le (le_of_lt small) (by simp [le_of_lt positive]))

def historyPrimal (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (history : ℝ → Field289) (smooth : ContDiffAt ℝ 1 history 0) (amplitude t : ℝ) : Op :=
  ((sourceHistoryEvolution p F history smooth).flow (historyAmplitudeInput amplitude) t).2.2.1

def historyDual (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (history : ℝ → Field289) (smooth : ContDiffAt ℝ 1 history 0) (amplitude t : ℝ) : Op :=
  ((sourceHistoryEvolution p F history smooth).flow (historyAmplitudeInput amplitude) t).2.2.2

theorem historyPrimal_initial (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (history : ℝ → Field289) (smooth : ContDiffAt ℝ 1 history 0) (amplitude : ℝ)
    (small : |amplitude|<(sourceHistoryEvolution p F history smooth).radius) :
    historyPrimal p F history smooth amplitude 0=1 := by
  have initial := ((sourceHistoryEvolution p F history smooth).generated _
    (amplitudeInput_member _ amplitude (sourceHistoryEvolution p F history smooth).radius_positive small)).1
  exact congrArg (fun y : HistoryPhase=>y.2.2.1) initial

theorem historyDual_initial (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (history : ℝ → Field289) (smooth : ContDiffAt ℝ 1 history 0) (amplitude : ℝ)
    (small : |amplitude|<(sourceHistoryEvolution p F history smooth).radius) :
    historyDual p F history smooth amplitude 0=1 := by
  have initial := ((sourceHistoryEvolution p F history smooth).generated _
    (amplitudeInput_member _ amplitude (sourceHistoryEvolution p F history smooth).radius_positive small)).1
  exact congrArg (fun y : HistoryPhase=>y.2.2.2) initial

private theorem operator_projections {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [Mul E]
    (A : (ℝ × ℝ × (E × E)) → E) (flow : ℝ → (ℝ × ℝ × (E × E))) (t : ℝ)
    (paid : HasDerivAt flow
      (1,0,A (flow t)*(flow t).2.2.1,-(flow t).2.2.2*A (flow t)) t) :
    HasDerivAt (fun r=>(flow r).2.2.1) (A (flow t)*(flow t).2.2.1) t ∧
      HasDerivAt (fun r=>(flow r).2.2.2) (-(flow t).2.2.2*A (flow t)) t := by
  let tail := (ContinuousLinearMap.snd ℝ ℝ (E × E)).comp
    (ContinuousLinearMap.snd ℝ ℝ (ℝ × (E × E)))
  constructor
  · exact ((ContinuousLinearMap.fst ℝ E E).comp tail).hasFDerivAt.comp_hasDerivAt t paid
  · exact ((ContinuousLinearMap.snd ℝ E E).comp tail).hasFDerivAt.comp_hasDerivAt t paid

theorem historyPrimal_derivative (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (history : ℝ → Field289) (smooth : ContDiffAt ℝ 1 history 0) (amplitude t : ℝ)
    (small : |amplitude|<(sourceHistoryEvolution p F history smooth).radius)
    (inside : t∈Ioo (-(sourceHistoryEvolution p F history smooth).duration)
      (sourceHistoryEvolution p F history smooth).duration) :
    HasDerivAt (historyPrimal p F history smooth amplitude)
      (((-Complex.I) • jointGenerator p F 0 (amplitude • history t))*
        historyPrimal p F history smooth amplitude t) t := by
  let data:=sourceHistoryEvolution p F history smooth
  let flow:=data.flow (historyAmplitudeInput amplitude)
  have source:=data.generated _ (amplitudeInput_member data.radius amplitude data.radius_positive small)
  have coordinates:=history_coordinates p F history data.duration data.duration_positive amplitude flow source.1 source.2 t inside
  have actual:=operator_projections
    (fun y : HistoryPhase => (-Complex.I) • jointGenerator p F 0 (y.2.1 • history y.1)) flow t
    (by simpa only [nativeHistoryVector] using source.2 t inside)
  convert! actual.1 using 1

  simp only [historyPrimal,flow,data,coordinates.1,coordinates.2]

theorem historyDual_derivative (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (history : ℝ → Field289) (smooth : ContDiffAt ℝ 1 history 0) (amplitude t : ℝ)
    (small : |amplitude|<(sourceHistoryEvolution p F history smooth).radius)
    (inside : t∈Ioo (-(sourceHistoryEvolution p F history smooth).duration)
      (sourceHistoryEvolution p F history smooth).duration) :
    HasDerivAt (historyDual p F history smooth amplitude)
      (-historyDual p F history smooth amplitude t*
        ((-Complex.I) • jointGenerator p F 0 (amplitude • history t))) t := by
  let data:=sourceHistoryEvolution p F history smooth
  let flow:=data.flow (historyAmplitudeInput amplitude)
  have source:=data.generated _ (amplitudeInput_member data.radius amplitude data.radius_positive small)
  have coordinates:=history_coordinates p F history data.duration data.duration_positive amplitude flow source.1 source.2 t inside
  have actual:=operator_projections
    (fun y : HistoryPhase => (-Complex.I) • jointGenerator p F 0 (y.2.1 • history y.1)) flow t
    (by simpa only [nativeHistoryVector] using source.2 t inside)
  convert! actual.2 using 1

  simp only [historyDual,flow,data,coordinates.1,coordinates.2]

private theorem scalar_input_distance {E : Type*} [PseudoMetricSpace E] (b : E) (r s : ℝ) :
    dist ((0 : ℝ),r,b) ((0 : ℝ),s,b) = |r-s| := by
  simp only [Prod.dist_eq,dist_self,Real.dist_eq]
  rw [max_eq_right (le_max_right _ _),max_eq_left (abs_nonneg _)]

private theorem phase_primal_distance {E : Type*} [PseudoMetricSpace E]
    (y z : ℝ × ℝ × (E × E)) : dist y.2.2.1 z.2.2.1 ≤ dist y z :=
  (le_max_left _ _).trans ((le_max_right _ _).trans (le_max_right _ _))

private theorem phase_dual_distance {E : Type*} [PseudoMetricSpace E]
    (y z : ℝ × ℝ × (E × E)) : dist y.2.2.2 z.2.2.2 ≤ dist y z :=
  (le_max_right _ _).trans ((le_max_right _ _).trans (le_max_right _ _))

theorem historyPrimal_difference_bound (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (history : ℝ → Field289) (smooth : ContDiffAt ℝ 1 history 0) (amplitude t : ℝ)
    (small : |amplitude|<(sourceHistoryEvolution p F history smooth).radius)
    (inside : t∈Ioo (-(sourceHistoryEvolution p F history smooth).duration)
      (sourceHistoryEvolution p F history smooth).duration) :
    ‖historyPrimal p F history smooth amplitude t-historyPrimal p F history smooth 0 t‖ ≤
      (sourceHistoryEvolution p F history smooth).price * |amplitude| := by
  let data:=sourceHistoryEvolution p F history smooth
  have source:=(data.controlled t inside).dist_le_mul _
    (amplitudeInput_member _ amplitude data.radius_positive small) _
    (amplitudeInput_member _ 0 data.radius_positive (by simpa using data.radius_positive))
  have projected := (phase_primal_distance _ _).trans source
  have inputDistance : dist (historyAmplitudeInput amplitude) (historyAmplitudeInput 0)=|amplitude| := by
    simpa only [historyAmplitudeInput,sub_zero] using scalar_input_distance ((1,1) : Op × Op) amplitude 0
  rw [inputDistance] at projected
  simpa only [historyPrimal,data,dist_eq_norm] using projected

theorem historyDual_difference_bound (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index)
    (history : ℝ → Field289) (smooth : ContDiffAt ℝ 1 history 0) (amplitude t : ℝ)
    (small : |amplitude|<(sourceHistoryEvolution p F history smooth).radius)
    (inside : t∈Ioo (-(sourceHistoryEvolution p F history smooth).duration)
      (sourceHistoryEvolution p F history smooth).duration) :
    ‖historyDual p F history smooth amplitude t-historyDual p F history smooth 0 t‖ ≤
      (sourceHistoryEvolution p F history smooth).price * |amplitude| := by
  let data:=sourceHistoryEvolution p F history smooth
  have source:=(data.controlled t inside).dist_le_mul _
    (amplitudeInput_member _ amplitude data.radius_positive small) _
    (amplitudeInput_member _ 0 data.radius_positive (by simpa using data.radius_positive))
  have projected := (phase_dual_distance _ _).trans source
  have inputDistance : dist (historyAmplitudeInput amplitude) (historyAmplitudeInput 0)=|amplitude| := by
    simpa only [historyAmplitudeInput,sub_zero] using scalar_input_distance ((1,1) : Op × Op) amplitude 0
  rw [inputDistance] at projected
  simpa only [historyDual,data,dist_eq_norm] using projected

end LowEnergy.SourcePropagationNativeEulerHistory
