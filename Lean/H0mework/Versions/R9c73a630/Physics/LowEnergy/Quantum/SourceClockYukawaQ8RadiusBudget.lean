abbrev End := QuantumTest →ₗ[ℂ] QuantumTest
abbrev Op := H →L[ℂ] H
attribute [local irreducible] normalizedJoint fullAction resolventCore

private theorem spin_bounded_core (j : Fin 4) (f : QuantumTest) :
    spinBounded j (embed f)=embed (activeSpin j f) := by
  unfold spinBounded
  exact GaussBoundedMultiplier.extension_core _ _ _ _ _ _ f

private theorem bracket_core (A B : Op) (a b : End)
    (ha : ∀ f, A (embed f)=embed (a f)) (hb : ∀ f,B (embed f)=embed (b f)) (f : QuantumTest) :
    bracket A B (embed f)=embed (bracket a b f) := by
  simp only [bracket,mul_apply_eq_comp,sub_apply,Module.End.mul_apply,LinearMap.sub_apply,ha,hb,map_sub]

private theorem inverse_spin (j : Fin 4) : Commute inverseAction (activeSpin j) := by
  unfold activeSpin
  apply LinearMap.ext
  intro f
  apply DFunLike.ext
  intro z
  change (reciprocal z:ℂ) • quantized (GaussCoframeSpin.full (activeIndex j)) (f z)=
    quantized (GaussCoframeSpin.full (activeIndex j)) ((reciprocal z:ℂ) • f z)
  exact (map_smul _ _ _).symm

private theorem inverse_coefficient (sharp : Bool) (mu : Fin 8) :
    Commute inverseAction (spinClosureCoefficient sharp mu) := by
  have hY : Commute inverseAction (fullAction sharp) := by
    unfold fullAction
    cases sharp
    · exact GaussRadialHamiltonian.original_commutes.symm
    · exact GaussRadialHamiltonian.adjoint_commutes.symm
  have hb (A B : End) (hA : Commute inverseAction A) (hB : Commute inverseAction B) :
      Commute inverseAction (bracket A B) := (hA.mul_right hB).sub_right (hB.mul_right hA)
  unfold spinClosureCoefficient SourceClockYukawaSpinRelativeForm.spinCoefficient
  split
  · exact hY
  · split
    · exact hb _ _ (inverse_spin _) hY
    · exact hb _ _ (inverse_spin _) (hb _ _ (inverse_spin 3) hY)

theorem original_normalized_closure_core (sharp : Bool) (mu : Fin 8) (f : QuantumTest) :
    normalizedJoint sharp mu (embed f)=embed (inverseAction (spinClosureCoefficient sharp mu f)) := by
  have hs (j : Fin 4) (A : End) : bracket (activeSpin j) (inverseAction*A)=
      inverseAction*bracket (activeSpin j) A := by
    have h := (inverse_spin j).eq
    unfold bracket
    linear_combination (norm := noncomm_ring) -h*A
  have hY : ∀ f,sourceB sharp (embed f)=embed ((inverseAction*fullAction sharp) f) :=
    original_normalized_core sharp
  have hJ (j : Fin 4) (f : QuantumTest) :
      bracket (spinBounded j) (sourceB sharp) (embed f)=
        embed ((inverseAction*bracket (activeSpin j) (fullAction sharp)) f) := by
    rw [bracket_core _ _ _ _ (spin_bounded_core j) hY,hs]
  have hJJ (j : Fin 4) (f : QuantumTest) :
      bracket (spinBounded j) (bracket (spinBounded 3) (sourceB sharp)) (embed f)=
        embed ((inverseAction*bracket (activeSpin j) (bracket (activeSpin 3) (fullAction sharp))) f) := by
    rw [bracket_core _ _ _ _ (spin_bounded_core j) (hJ 3),hs]
  unfold normalizedJoint spinClosureCoefficient SourceClockYukawaSpinRelativeForm.spinCoefficient
  split
  · exact hY f
  · split
    · exact hJ _ f
    · exact hJJ _ f

/-- The total price is generated by the actual sixteen bounded normalized coefficients. -/
def radiusPrice : ℝ := ∑ sharp : Bool,∑ mu : Fin 8,‖normalizedJoint sharp mu‖^2

private theorem radius_price_nonnegative : 0 ≤ radiusPrice := by
  unfold radiusPrice
  exact Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun _ _ => sq_nonneg _))

private theorem normalized_radius_core (sharp : Bool) (mu : Fin 8) (f : QuantumTest) :
    normalizedJoint sharp mu (embed (radiusAction f))=embed (spinClosureCoefficient sharp mu f) := by
  rw [original_normalized_closure_core]
  have h := LinearMap.congr_fun (inverse_coefficient sharp mu).eq (radiusAction f)
  change inverseAction (spinClosureCoefficient sharp mu (radiusAction f))=
    spinClosureCoefficient sharp mu (inverseAction (radiusAction f)) at h
  rw [inverse_radius_action] at h
  rw [h]

private theorem op_square {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (A : E →L[ℂ] E) (f : E) : ‖A f‖^2 ≤ ‖A‖^2*‖f‖^2 := by
  have h := pow_le_pow_left₀ (norm_nonneg _) (A.le_opNorm f) 2
  simpa only [mul_pow] using h

/-- The complete positive Q8 Gram is paid by one actual radius action on the same core vector. -/
theorem original_closure_radius_price (f : QuantumTest) :
    closureGram false f ≤ radiusPrice*‖embed (radiusAction f)‖^2 := by
  have he : closureGram false f=∑ sharp : Bool,∑ mu : Fin 8,‖embed (spinClosureCoefficient sharp mu f)‖^2 := by
    unfold closureGram spinVariationGram
    rw [Fintype.sum_bool]
    simp only [Bool.not_false]
    abel
  rw [he,radiusPrice]
  simp only [Finset.sum_mul]
  apply Finset.sum_le_sum
  intro sharp _
  apply Finset.sum_le_sum
  intro mu _
  rw [←normalized_radius_core sharp mu f]
  exact op_square _ _

private theorem inverse_radius_end : inverseAction*radiusAction=(1:End) := by
  apply LinearMap.ext
  exact inverse_radius_action

private theorem radius_inverse_end : radiusAction*inverseAction=(1:End) := by
  apply LinearMap.ext
  intro f
  apply DFunLike.ext
  intro z
  apply PiLp.ext
  intro word
  change radius z • ((reciprocal z:ℂ)*f z word)=f z word
  rw [Complex.real_smul]
  have hr : (radius z:ℂ)≠0 := by exact_mod_cast (radius_pos z).ne'
  simp only [reciprocal,Complex.ofReal_inv,←mul_assoc,mul_inv_cancel₀ hr,one_mul]

private theorem radius_theta (m ell : ℕ) : Commute radiusAction (thetaAction m ell) := by
  have hS : Commute radiusAction inverseAction := by
    change radiusAction*inverseAction=inverseAction*radiusAction
    rw [radius_inverse_end,inverse_radius_end]
  unfold thetaAction
  exact (((Commute.one_right radiusAction).sub_right hS).pow_right _).sub_right
    (((Commute.one_right radiusAction).sub_right hS).pow_right _)

/-- The response uses the original radius and the same compressed core resolvent. -/
def radiusResponseCore (m ell : ℕ) (F : Index) (z : ℂ) (hz : z.im≠0) (g : diagonal.domain) : QuantumTest :=
  thetaAction m ell (bracket radiusAction (resolventCore F z hz) (coreEquiv.symm g))

theorem actual_radius_window_source (m ell : ℕ) (F : Index) (z : ℂ) (hz : z.im≠0) (g : diagonal.domain) :
    radiusAction (windowState m ell F z hz g)= -radiusResponseCore m ell F z hz g := by
  have hm (R : End) : radiusAction*thetaAction m ell*bracket inverseAction R*radiusAction=
      -(thetaAction m ell*bracket radiusAction R) := by
    calc
      _=thetaAction m ell*(radiusAction*inverseAction)*R*radiusAction-
          thetaAction m ell*radiusAction*R*(inverseAction*radiusAction) := by
        rw [(radius_theta m ell).eq]
        unfold bracket
        noncomm_ring
      _=thetaAction m ell*R*radiusAction-thetaAction m ell*radiusAction*R := by
        rw [radius_inverse_end,inverse_radius_end]
        noncomm_ring
      _=_ := by unfold bracket;noncomm_ring
  have h := LinearMap.congr_fun (hm (resolventCore F z hz)) (coreEquiv.symm g)
  unfold windowState inputCore SourceClockYukawaRadialMixedBudget.radiusSource
  rw [coreEquiv.symm_apply_apply]
  exact h

def radiusResponseBudget (m ell : ℕ) (F : Index) (μ : ℝ) (hμ : 0<μ) (g : diagonal.domain) : ENNReal :=
  ∫⁻ w : ℝ,ENNReal.ofReal (μ*‖embed (radiusResponseCore m ell F (line μ w)
    (by simpa only [line_im] using hμ.ne') g)‖^2)

/-- The whole signed source Ward directly pays the single radius-response budget. -/
theorem actual_Q8_radius_response_payment (m ell : ℕ) (F : Index) (μ : ℝ) (hμ : 0<μ) (g : diagonal.domain) :
    wholeCurrentBudget m ell F μ hμ g ≤ ENNReal.ofReal radiusPrice*radiusResponseBudget m ell F μ hμ g := by
  unfold wholeCurrentBudget radiusResponseBudget
  calc
    _ ≤ ∫⁻ w : ℝ,ENNReal.ofReal radiusPrice*ENNReal.ofReal (μ*‖embed
        (radiusResponseCore m ell F (line μ w) (by simpa only [line_im] using hμ.ne') g)‖^2) := by
      apply lintegral_mono
      intro w
      dsimp only
      rw [actual_Q8_whole_ward]
      simp only [line_im]
      rw [←ENNReal.ofReal_mul radius_price_nonnegative]
      have h := mul_le_mul_of_nonneg_left (original_closure_radius_price
        (windowState m ell F (line μ w) (by simpa only [line_im] using hμ.ne') g)) hμ.le
      rw [actual_radius_window_source] at h
      simp only [map_neg,norm_neg] at h
      apply ENNReal.ofReal_le_ofReal
      exact h.trans_eq (by ring)
    _=_ := by rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]

/-- Original Gamma consumes the normalized complete square and the actual one-radius response at one common N. -/
theorem actual_original_Q8_radius_response_budget (μ : ℝ) (hμ : 0<μ) (g k : diagonal.domain) :
    ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ m, N ≤ m → ∀ ell, m ≤ ell →
      ∀ᶠ F in (sourceFilter : Filter Index),∀ sharp : Bool,
        ENNReal.ofReal (closedJointCost sharp m ell F μ (g:H) (k:H)) ≤
          ENNReal.ofReal ε+ENNReal.ofReal (6*sourceMuFactor μ k*radiusPrice)*radiusResponseBudget m ell F μ hμ g := by
  intro ε hε
  obtain ⟨N,hN⟩ := actual_original_Q8_whole_current_budget μ hμ g k ε hε
  refine ⟨N,fun m hm ell hml => ?_⟩
  filter_upwards [hN m hm ell hml] with F hF
  intro sharp
  have hc : 0≤6*sourceMuFactor μ k := by unfold sourceMuFactor;positivity
  have hp := mul_le_mul (le_refl (ENNReal.ofReal (6*sourceMuFactor μ k)))
    (actual_Q8_radius_response_payment m ell F μ hμ g) zero_le zero_le
  rw [←mul_assoc,←ENNReal.ofReal_mul hc] at hp
  exact (hF sharp).trans (add_le_add le_rfl hp)

