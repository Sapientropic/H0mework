/-! Source-only candidate. The ordinary real-time IVP is generated from raw
material terms. Its trace dual is generated by swapping the same left/right
factors, never by conjugating an off-diagonal field coefficient. Full natural
traces use300's all-word source; retained bra/ket coordinates stay open.
-/

set_option autoImplicit false
set_option maxHeartbeats 2400000

noncomputable section
open Set Filter MeasureTheory
open scoped BigOperators Topology

namespace SourceOpenProgramme301
open SourceOpenFieldKernel299 SourceHiddenWordFlow286 SourceEndpointWords300
open SourceNativeKrausWindow292

theorem Term.trace_duality (term : Term) (rho A : Op) :
    SourceEndpointDensity300.tracePairing (term.action rho) A =
      SourceEndpointDensity300.tracePairing rho (term.dual.action A) := by
  simp only [Term.action_apply, Term.dual, map_smul, _root_.smul_apply]
  apply congrArg (fun value : ℂ => term.coefficient • value)
  simpa only [SourceEndpointDensity300.tracePairing_apply, mul_assoc] using
    SourceEndpointDensity300.atomicTrace_mul_comm term.left (rho*term.right*A)

theorem terms_trace_duality (terms : List Term) (rho A : Op) :
    SourceEndpointDensity300.tracePairing (termsAction terms rho) A =
      SourceEndpointDensity300.tracePairing rho (termsAction (dualTerms terms) A) := by
  induction terms with
  | nil => simp [termsAction, dualTerms]
  | cons term rest ih =>
      simp only [termsAction, dualTerms, List.map_cons, List.sum_cons,
        _root_.add_apply, map_add] at ih ⊢
      exact congrArg₂ (·+·) (term.trace_duality rho A) ih

-- Reuse the canonical normed additive/scalar structures, without a ring search branch.
private instance actionTopologicalAddGroup : IsTopologicalAddGroup Action :=
  SeminormedAddCommGroup.toIsTopologicalAddGroup (E := Action)

private instance actionContinuousAdd : ContinuousAdd Action :=
  actionTopologicalAddGroup.toContinuousAdd

private instance actionContinuousSMulReal : ContinuousSMul ℝ Action := by
  let _ : IsBoundedSMul ℝ Action := NormedSpace.toIsBoundedSMul (𝕜 := ℝ) (E := Action)
  exact IsBoundedSMul.continuousSMul (α := ℝ) (β := Action)

structure ClockedTerm where
  coefficient : C(ℝ, ℂ)
  left : C(ℝ, Op)
  right : C(ℝ, Op)

def ClockedTerm.at (raw : ClockedTerm) (time : ℝ) : Term :=
  ⟨raw.coefficient time, raw.left time, raw.right time⟩

def ClockedTerm.dual (raw : ClockedTerm) : ClockedTerm :=
  ⟨raw.coefficient, raw.right, raw.left⟩

theorem ClockedTerm.action_continuous (raw : ClockedTerm) :
    Continuous (fun time => (raw.at time).action) := by
  change Continuous (fun time => raw.coefficient time •
    SourceEndpointRecycling300.compositionAction (raw.left time) (raw.right time))
  exact raw.coefficient.continuous.smul
    (SourceEndpointRecycling300.compositionAction_continuous
      raw.left raw.right raw.left.continuous raw.right.continuous)

def constantCurve {B : Type*} [TopologicalSpace B] (value : B) : C(ℝ, B) :=
  ⟨fun _ => value, continuous_const⟩

def adjointCurve (curve : C(ℝ, Op)) : C(ℝ, Op) :=
  ⟨fun time => (curve time).adjoint,
    (ContinuousLinearMap.adjoint (𝕜 := ℂ) (E := Atom) (F := Atom)).continuous.comp
      curve.continuous⟩

def generatorOfTerms (terms : List ClockedTerm) (time : ℝ) : Action :=
  termsAction (terms.map fun term => term.at time)

theorem generatorOfTerms_continuous (terms : List ClockedTerm) :
    Continuous (generatorOfTerms terms) := by
  induction terms with
  | nil => exact continuous_const
  | cons term rest ih =>
      change Continuous (fun time => (term.at time).action + generatorOfTerms rest time)
      exact term.action_continuous.add ih

theorem generatorOfTerms_apply (terms : List ClockedTerm) (time : ℝ) (rho : Op) :
    generatorOfTerms terms time rho =
      (terms.map fun term => (term.at time).action rho).sum := by
  induction terms with
  | nil => rfl
  | cons term rest ih =>
      change (term.at time).action rho + generatorOfTerms rest time rho =
        (term.at time).action rho + (rest.map fun next => (next.at time).action rho).sum
      exact congrArg (fun value : Op => (term.at time).action rho+value) ih

theorem generatorOfTerms_append (before after : List ClockedTerm) (time : ℝ) :
    generatorOfTerms (before++after) time =
      generatorOfTerms before time + generatorOfTerms after time := by
  induction before with
  | nil =>
      change generatorOfTerms after time = (0 : Action) + generatorOfTerms after time
      apply ContinuousLinearMap.ext
      intro rho
      apply ContinuousLinearMap.ext
      intro x
      change generatorOfTerms after time rho x = (0 : Atom) + generatorOfTerms after time rho x
      exact (zero_add _).symm
  | cons term rest ih =>
      change (term.at time).action + generatorOfTerms (rest++after) time =
        ((term.at time).action + generatorOfTerms rest time) + generatorOfTerms after time
      rw [ih]
      apply ContinuousLinearMap.ext
      intro rho
      apply ContinuousLinearMap.ext
      intro x
      change (term.at time).action rho x +
          (generatorOfTerms rest time rho x + generatorOfTerms after time rho x) =
        ((term.at time).action rho x + generatorOfTerms rest time rho x) +
          generatorOfTerms after time rho x
      exact (add_assoc _ _ _).symm

theorem generatorOfTerms_finset {I : Type*} [DecidableEq I] (indices : Finset I)
    (term : I → ClockedTerm) (time : ℝ) (rho : Op) :
    generatorOfTerms (indices.toList.map term) time rho =
      ∑ i ∈ indices, ((term i).at time).action rho := by
  simpa only [generatorOfTerms_apply, List.map_map, Function.comp_def] using
    (Finset.sum_map_toList indices (fun i => ((term i).at time).action rho))

theorem generatorOfTerms_duality (terms : List ClockedTerm) (time : ℝ) (rho A : Op) :
    SourceEndpointDensity300.tracePairing (generatorOfTerms terms time rho) A =
      SourceEndpointDensity300.tracePairing rho
        (generatorOfTerms (terms.map ClockedTerm.dual) time A) := by
  simpa only [generatorOfTerms, dualTerms, List.map_map, Function.comp_def,
    ClockedTerm.at, ClockedTerm.dual, Term.dual]
    using terms_trace_duality (terms.map fun term => term.at time) rho A

structure FlowRecipe where
  begin : ℝ
  finish : ℝ
  ordered : begin ≤ finish
  terms : List ClockedTerm

def FlowRecipe.forward (raw : FlowRecipe) : ℝ → Action :=
  BanachOperatorFlow.operatorFlow (B := Op) (generatorOfTerms raw.terms)
    (generatorOfTerms_continuous raw.terms) raw.begin raw.finish raw.ordered

theorem FlowRecipe.forward_initial (raw : FlowRecipe) : raw.forward raw.begin = 1 :=
  BanachOperatorFlow.operatorFlow_initial (B := Op) (generatorOfTerms raw.terms)
    (generatorOfTerms_continuous raw.terms) raw.begin raw.finish raw.ordered

theorem FlowRecipe.forward_applied_derivative (raw : FlowRecipe) (rho : Op) (time : ℝ)
    (inside : time ∈ Icc raw.begin raw.finish) :
    HasDerivWithinAt (fun t => raw.forward t rho)
      (generatorOfTerms raw.terms time (raw.forward time rho))
      (Icc raw.begin raw.finish) time :=
  BanachOperatorFlow.applied_flow_derivative (B := Op) (generatorOfTerms raw.terms)
    (generatorOfTerms_continuous raw.terms) raw.begin raw.finish raw.ordered rho time inside

def FlowRecipe.reflect (raw : FlowRecipe) (time : ℝ) : ℝ := raw.begin+raw.finish-time

theorem FlowRecipe.reflect_reflect (raw : FlowRecipe) (time : ℝ) :
    raw.reflect (raw.reflect time) = time := by unfold FlowRecipe.reflect; ring

theorem FlowRecipe.reflect_inside (raw : FlowRecipe) (time : ℝ)
    (inside : time ∈ Icc raw.begin raw.finish) :
    raw.reflect time ∈ Icc raw.begin raw.finish := by
  unfold FlowRecipe.reflect
  constructor <;> linarith [inside.1, inside.2]

def FlowRecipe.reflectedGenerator (raw : FlowRecipe) (time : ℝ) : Action :=
  generatorOfTerms (raw.terms.map ClockedTerm.dual) (raw.reflect time)

theorem FlowRecipe.reflectedGenerator_continuous (raw : FlowRecipe) :
    Continuous raw.reflectedGenerator :=
  (generatorOfTerms_continuous _).comp (by unfold FlowRecipe.reflect; fun_prop)

def FlowRecipe.generatedReverse (raw : FlowRecipe) : ℝ → Action :=
  BanachOperatorFlow.operatorFlow (B := Op) raw.reflectedGenerator
    raw.reflectedGenerator_continuous raw.begin raw.finish raw.ordered

def FlowRecipe.backward (raw : FlowRecipe) (time : ℝ) : Action :=
  raw.generatedReverse (raw.reflect time)

theorem FlowRecipe.backward_terminal (raw : FlowRecipe) : raw.backward raw.finish = 1 := by
  have reflected : raw.reflect raw.finish = raw.begin := by unfold FlowRecipe.reflect; ring
  rw [FlowRecipe.backward, reflected]
  exact BanachOperatorFlow.operatorFlow_initial (B := Op) raw.reflectedGenerator
    raw.reflectedGenerator_continuous raw.begin raw.finish raw.ordered

theorem FlowRecipe.backward_derivative (raw : FlowRecipe) (time : ℝ)
    (inside : time ∈ Icc raw.begin raw.finish) :
    HasDerivWithinAt raw.backward
      (-((generatorOfTerms (raw.terms.map ClockedTerm.dual) time).comp
        (raw.backward time))) (Icc raw.begin raw.finish) time :=
  SourceTerminalBanachFlow303.terminalOperatorFlow_derivative (B := Op)
    (generatorOfTerms (raw.terms.map ClockedTerm.dual)) (generatorOfTerms_continuous _)
    raw.begin raw.finish raw.ordered time inside

theorem FlowRecipe.backward_applied_derivative (raw : FlowRecipe) (A : Op) (time : ℝ)
    (inside : time ∈ Icc raw.begin raw.finish) :
    HasDerivWithinAt (fun t => raw.backward t A)
      (-(generatorOfTerms (raw.terms.map ClockedTerm.dual) time (raw.backward time A)))
      (Icc raw.begin raw.finish) time :=
  SourceTerminalBanachFlow303.applied_terminal_flow_derivative (B := Op)
    (generatorOfTerms (raw.terms.map ClockedTerm.dual)) (generatorOfTerms_continuous _)
    raw.begin raw.finish raw.ordered A time inside

/-- This duality is proved from the source terms, not supplied as a flow premise. -/
theorem FlowRecipe.weak_trace (raw : FlowRecipe) (rho A : Op) :
    SourceEndpointDensity300.tracePairing (raw.forward raw.finish rho) A =
      SourceEndpointDensity300.tracePairing rho (raw.backward raw.begin A) := by
  let r : ℝ → Op := fun time => raw.forward time rho
  let a : ℝ → Op := fun time => raw.backward time A
  let f : ℝ → ℂ := fun time => SourceEndpointDensity300.tracePairing (r time) (a time)
  have derivative (time : ℝ) (inside : time ∈ Icc raw.begin raw.finish) :
      HasDerivWithinAt f 0 (Icc raw.begin raw.finish) time := by
    have dr := raw.forward_applied_derivative rho time inside
    have da := raw.backward_applied_derivative A time inside
    have paired : HasDerivWithinAt f
        (SourceEndpointDensity300.tracePairing (r time)
            (-(generatorOfTerms (raw.terms.map ClockedTerm.dual) time (a time))) +
          SourceEndpointDensity300.tracePairing
            (generatorOfTerms raw.terms time (r time)) (a time))
        (Icc raw.begin raw.finish) time :=
      ContinuousLinearMap.hasDerivWithinAt_of_bilinear
        (B := SourceEndpointDensity300.tracePairing.bilinearRestrictScalars ℝ) dr da
    apply paired.congr_deriv
    rw [generatorOfTerms_duality, map_neg, neg_add_cancel]
  have continuous : ContinuousOn f (Icc raw.begin raw.finish) :=
    fun time inside => (derivative time inside).continuousWithinAt
  have paid := intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le raw.ordered continuous
    (fun time inside => (derivative time (Ioo_subset_Icc_self inside)).hasDerivAt
      (Icc_mem_nhds inside.1 inside.2)) (intervalIntegrable_const (c := (0 : ℂ)))
  rw [intervalIntegral.integral_zero] at paid
  have endpoints := sub_eq_zero.mp paid.symm
  simpa only [f, r, a, FlowRecipe.forward_initial, FlowRecipe.backward_terminal,
    _root_.one_apply_eq_self] using endpoints

variable {Group : Type*} [Fintype Group] [DecidableEq Group]

def Material.kCurve (raw : Material Group) : C(ℝ, Op) :=
  ⟨raw.window.clampedCoefficient, raw.window.clampedCoefficient_continuous⟩

def Material.jCurve (raw : Material Group) (j : JumpIndex raw) : C(ℝ, Op) :=
  ⟨raw.window.chartJump j, raw.window.chartJump_continuous j⟩

/-- The left factor acts first at the left of rho; the right factor is stored
already adjointed, exactly as159._recycle and161._term_action. -/
def recycledCurve (coefficient : ℂ) (left right : C(ℝ, Op)) : ClockedTerm :=
  ⟨constantCurve coefficient, left, adjointCurve right⟩

def Material.quietTerms (raw : Material Group) : List ClockedTerm := by
  classical
  let survival : List ClockedTerm :=
    [⟨constantCurve 1, raw.kCurve, constantCurve 1⟩,
     ⟨constantCurve 1, constantCurve 1, adjointCurve raw.kCurve⟩]
  let captures := (Finset.univ : Finset (CaptureIndex raw)).toList.map fun j =>
    recycledCurve 1 (raw.jCurve (.inr (.inl j))) (raw.jCurve (.inr (.inl j)))
  let lost := (Finset.univ : Finset (Group × Fin 6 × Fin 6)).toList.map fun j =>
    recycledCurve (lossGram raw.transfer j.2.2 j.2.1)
      (raw.jCurve (.inl (j.1, j.2.1))) (raw.jCurve (.inl (j.1, j.2.2)))
  let background := (Finset.univ : Finset (Fin 4)).toList.map fun port =>
    (⟨constantCurve (-(raw.detectorBeta port).value : ℂ),
      constantCurve 1, constantCurve 1⟩ : ClockedTerm)
  exact survival ++ captures ++ lost ++ background

def Material.quietRecipe (raw : Material Group) : FlowRecipe :=
  ⟨raw.begin, raw.finish, raw.ordered, raw.quietTerms⟩

omit [DecidableEq Group] in
/-- This identifies the generated quiet flow's actual coefficients with159's
survival/capture + G[nu,mu] recycling - detector Poisson BG grammar. -/
theorem Material.quiet_generator_original (raw : Material Group) (time : ℝ)
    (inside : time ∈ Icc raw.begin raw.finish) (rho : Op) :
    generatorOfTerms raw.quietTerms time rho = raw.quietAt time rho := by
  classical
  have kSame := raw.window.clampedCoefficient_original time inside
  have jSame (j : JumpIndex raw) : raw.window.chartJump j time = raw.jump j time := by
    simp only [RawKrausWindow.chartJump, RawKrausWindow.timeProjection,
      projIcc_of_mem raw.ordered inside, Material.window]
  simp [Material.quietTerms, generatorOfTerms_apply, ClockedTerm.at, recycledCurve, constantCurve,
    adjointCurve, Material.kCurve, Material.jCurve, Term.action_apply, kSame, jSame,
    Material.quietAt, Material.survivalCapture, Material.unobservedNatural,
    Material.background, crossContraction, Material.jump, Fintype.sum_prod_type,
    Complex.ofReal_sum, sub_eq_add_neg, add_assoc]
  rw [← Finset.sum_smul, Finset.sum_neg_distrib, neg_smul]

def Material.captureHidden (raw : Material Group) : Finset (JumpIndex raw) := by
  classical
  exact Finset.univ.filter fun j => match j with
    | .inr (.inl _) => True
    | _ => False

def Material.inclusiveHidden (raw : Material Group) : Finset (JumpIndex raw) := by
  classical
  exact Finset.univ.filter fun j => match j with
    | .inl _ => True
    | .inr (.inl _) => True
    | .inr (.inr _) => False

omit [DecidableEq Group] in
theorem Material.inclusive_natural (raw : Material Group) (g : Group) (mode : Fin 6) :
    Sum.inl (g, mode) ∈ raw.inclusiveHidden := by simp [Material.inclusiveHidden]

omit [DecidableEq Group] in
theorem Material.inclusive_capture (raw : Material Group) (j : CaptureIndex raw) :
    Sum.inr (Sum.inl j) ∈ raw.inclusiveHidden := by simp [Material.inclusiveHidden]

omit [DecidableEq Group] in
theorem Material.inclusive_ion_not_traced (raw : Material Group) (j : IonIndex raw) :
    Sum.inr (Sum.inr j) ∉ raw.inclusiveHidden := by simp [Material.inclusiveHidden]

omit [DecidableEq Group] in
theorem Material.atBegin (raw : Material Group) : raw.begin ∈ Icc raw.window.left raw.window.right :=
  ⟨le_rfl, raw.ordered⟩

omit [DecidableEq Group] in
/-- This is the original full-K word source, with ion births still separate. -/
theorem Material.inclusive_all_words (raw : Material Group) (rho A : Op) :
    HasSum (fun n => SourceEndpointDensity300.tracePairing rho
      (SourceEndpointWords300.endpointWord raw.window raw.inclusiveHidden A n raw.begin))
      (SourceEndpointDensity300.tracePairing
        (SourceEndpointDensity300.densityFlow raw.window raw.inclusiveHidden raw.begin raw.atBegin
          raw.finish rho) A) :=
  SourceEndpointDensity300.whole_word_trace_hasSum
    raw.window raw.inclusiveHidden raw.begin raw.atBegin rho A

inductive Node (Group : Type*) [Fintype Group] [DecidableEq Group] where
  | field : Material Group → Node Group
  | inclusive : Material Group → Node Group
  | quiet : Material Group → Node Group
  | point : List Term → Node Group

def Node.primal : Node Group → Action
  | .field raw => SourceEndpointDensity300.densityFlow raw.window raw.captureHidden
      raw.begin raw.atBegin raw.finish
  | .inclusive raw => SourceEndpointDensity300.densityFlow raw.window raw.inclusiveHidden
      raw.begin raw.atBegin raw.finish
  | .quiet raw => raw.quietRecipe.forward raw.finish
  | .point terms => termsAction terms

def Node.dual : Node Group → Action
  | .field raw => SourceEndpointRecycling300.rawCoflow raw.window raw.captureHidden raw.begin
  | .inclusive raw => SourceEndpointRecycling300.rawCoflow raw.window raw.inclusiveHidden raw.begin
  | .quiet raw => raw.quietRecipe.backward raw.begin
  | .point terms => termsAction (dualTerms terms)

theorem Node.weak_trace (node : Node Group) (rho A : Op) :
    SourceEndpointDensity300.tracePairing (node.primal rho) A =
      SourceEndpointDensity300.tracePairing rho (node.dual A) := by
  cases node with
  | field raw =>
      have actual := SourceEndpointDensity300.generated_trace_pairing
        raw.window raw.captureHidden raw.begin raw.atBegin rho A
      rw [SourceEndpointRecycling300.coflow_original
        raw.window raw.captureHidden A raw.begin raw.atBegin] at actual
      exact actual
  | inclusive raw =>
      have actual := SourceEndpointDensity300.generated_trace_pairing
        raw.window raw.inclusiveHidden raw.begin raw.atBegin rho A
      rw [SourceEndpointRecycling300.coflow_original
        raw.window raw.inclusiveHidden A raw.begin raw.atBegin] at actual
      exact actual
  | quiet raw => exact raw.quietRecipe.weak_trace rho A
  | point terms => exact terms_trace_duality terms rho A

def programmeAction : List (Node Group) → Action
  | [] => 1
  | node :: rest => (programmeAction rest).comp node.primal

/-- This recursion is exactly reverse-node order with each term's factors swapped. -/
def programmePullback : List (Node Group) → Action
  | [] => 1
  | node :: rest => node.dual.comp (programmePullback rest)

theorem programme_weak_trace (nodes : List (Node Group)) (rho A : Op) :
    SourceEndpointDensity300.tracePairing (programmeAction nodes rho) A =
      SourceEndpointDensity300.tracePairing rho (programmePullback nodes A) := by
  induction nodes generalizing rho A with
  | nil => rfl
  | cons node rest ih =>
      exact (ih (node.primal rho) A).trans
        (node.weak_trace rho (programmePullback rest A))

theorem programmeAction_append (before after : List (Node Group)) :
    programmeAction (before++after) = (programmeAction after).comp (programmeAction before) := by
  induction before with
  | nil => ext rho; rfl
  | cons node rest ih => simp [programmeAction, ih, ContinuousLinearMap.comp_assoc]

structure FieldCoordinate (Group : Type*) where
  group : Group
  mode : Fin 4 ⊕ Fin 6
  arrival : ℝ

def fieldCoefficient (transfer : Matrix (Fin 4) (Fin 6) ℂ)
    (output : Fin 4 ⊕ Fin 6) (mode : Fin 6) : ℂ :=
  match output with
  | .inl port => transfer port mode
  | .inr bath => if bath = mode then 1 else 0

/-- Bath coordinates are untransformed natural coordinates with G as their
contraction metric. There is deliberately no L[output,input] coefficient. -/
def Material.creation (raw : Material Group) (side : Fin 2)
    (coordinate : FieldCoordinate Group) : Op :=
  ∑ mode : Fin 6, if modeSide mode = side then
    fieldCoefficient raw.transfer coordinate.mode mode •
      raw.natural coordinate.group mode coordinate.arrival else 0

inductive FieldLeg where
  | bra
  | ket

def Material.creationTerm (raw : Material Group) (leg : FieldLeg) (side : Fin 2)
    (coordinate : FieldCoordinate Group) : Term :=
  match leg with
  | .bra => ⟨1, raw.creation side coordinate, 1⟩
  | .ket => ⟨1, 1, (raw.creation side coordinate).adjoint⟩

omit [Fintype Group] [DecidableEq Group] in
theorem Material.bra_creation_action (raw : Material Group) (side : Fin 2)
    (coordinate : FieldCoordinate Group) (rho : Op) :
    (raw.creationTerm .bra side coordinate).action rho = raw.creation side coordinate * rho := by
  simp [Material.creationTerm, Term.action_apply]

omit [Fintype Group] [DecidableEq Group] in
theorem Material.ket_creation_action (raw : Material Group) (side : Fin 2)
    (coordinate : FieldCoordinate Group) (rho : Op) :
    (raw.creationTerm .ket side coordinate).action rho = rho * (raw.creation side coordinate).adjoint := by
  simp [Material.creationTerm, Term.action_apply]

def emissionTime (clock : RetardedClocks) (side : Fin 2) (arrival : ℝ) : ℝ :=
  arrival-(clock.flight side).value

def retainedArm (clock : RetardedClocks) (cut : ℝ)
    (coordinate : FieldCoordinate Group) (side : Fin 2) : Prop :=
  cut-(clock.flight side).value < emissionTime clock side coordinate.arrival ∧
    emissionTime clock side coordinate.arrival < cut ∧
      (match coordinate.mode with
       | .inl _ => True
       | .inr mode => modeSide mode = side)

def tailStart (clock : RetardedClocks) (cut : ℝ) (side : Fin 2) : ℝ :=
  cut-(clock.flight side).value

theorem tail_ordered (clock : RetardedClocks) (cut : ℝ) (side : Fin 2) :
    tailStart clock cut side ≤ cut := by
  unfold tailStart
  linarith [(clock.flight side).nonnegative]

/-- The lower boundary is strict; a birth at the physical cut remains included. -/
def tailBirth (clock : RetardedClocks) (cut : ℝ) (side : Fin 2) (birth : ℝ) : Prop :=
  tailStart clock cut side < birth ∧ birth ≤ cut

theorem own_birth_arrival (clock : RetardedClocks) (side : Fin 2) (birth : ℝ) :
    emissionTime clock side (birth+(clock.flight side).value) = birth := by
  unfold emissionTime
  ring

/-- Registration weights remain in the original birth map; no Ready division. -/
def birthTerm (raw : Material Group) (index : IonIndex raw) (emission : ℝ)
    (registrationWeight : ℝ) : Term :=
  let jump := raw.localJump index.1 ((raw.ions index.1).get index.2)
    (emission+(raw.clocks.flight index.1).value)
  ⟨registrationWeight, jump, jump.adjoint⟩

structure ReadoutFrame where
  omega : Fin 2 → ℝ
  origin : Fin 2 → ℝ
  physicalTimes : Fin 2 → ℝ
  direction : ℤ
  isD2 : AtomIndex → Bool

def ReadoutFrame.operator (frame : ReadoutFrame) : Op :=
  Matrix.toEuclideanCLM (n := JointIndex) (𝕜 := ℂ)
    (Matrix.diagonal fun coordinate : JointIndex =>
      Complex.exp (Complex.I * (frame.direction : ℂ) *
        ∑ side : Fin 2, (frame.omega side : ℂ) *
          ((frame.physicalTimes side-frame.origin side : ℝ) : ℂ) *
            (if frame.isD2 (if side = 0 then coordinate.1 else coordinate.2) then 1 else 0)))

def ReadoutFrame.term (frame : ReadoutFrame) : Term :=
  ⟨1, frame.operator, frame.operator.adjoint⟩

/-- Complex coefficients on an off-diagonal field kernel are not conjugated
by trace dualization; only taking the right creation adjoint conjugates them. -/
theorem ReadoutFrame.weak_trace (frame : ReadoutFrame) (rho A : Op) :
    SourceEndpointDensity300.tracePairing (frame.term.action rho) A =
      SourceEndpointDensity300.tracePairing rho (frame.term.dual.action A) :=
  frame.term.trace_duality rho A

abbrev ArmAssignments (nBra nKet : ℕ) :=
  (Fin nBra → Fin 2) × (Fin nKet → Fin 2)

def fockKernelFactor (nBra nKet : ℕ) : ℂ :=
  ((Real.sqrt ((nBra.factorial : ℝ)*(nKet.factorial : ℝ)))⁻¹ : ℝ)

theorem fockKernelFactor_original (nBra nKet : ℕ) :
    fockKernelFactor nBra nKet =
      (Real.sqrt (1/((nBra.factorial : ℝ)*(nKet.factorial : ℝ))) : ℂ) := by
  simp only [fockKernelFactor, one_div, Real.sqrt_inv]

/-- Branches contain raw source nodes, not supplied quantum kernels or states.
The original159 compiler owns their creation/birth/cell ordering. -/
def rawFieldKernel (nBra nKet : ℕ)
    (branches : ArmAssignments nBra nKet → List (Node Group)) (rho : Op) : Op :=
  fockKernelFactor nBra nKet •
    ∑ arms : ArmAssignments nBra nKet, programmeAction (branches arms) rho

def rawFieldPullback (nBra nKet : ℕ)
    (branches : ArmAssignments nBra nKet → List (Node Group)) (A : Op) : Op :=
  fockKernelFactor nBra nKet •
    ∑ arms : ArmAssignments nBra nKet, programmePullback (branches arms) A

/-- All finite bra and ket lengths are independent, including unequal lengths. -/
theorem raw_field_programme_weak_trace (nBra nKet : ℕ)
    (branches : ArmAssignments nBra nKet → List (Node Group)) (rho A : Op) :
    SourceEndpointDensity300.tracePairing (rawFieldKernel nBra nKet branches rho) A =
      SourceEndpointDensity300.tracePairing rho (rawFieldPullback nBra nKet branches A) := by
  simp only [rawFieldKernel, rawFieldPullback, map_smul, _root_.smul_apply,
    map_sum, _root_.sum_apply]
  apply congrArg (fun value : ℂ => fockKernelFactor nBra nKet • value)
  exact Finset.sum_congr rfl fun arms _ => programme_weak_trace (branches arms) rho A

end SourceOpenProgramme301
