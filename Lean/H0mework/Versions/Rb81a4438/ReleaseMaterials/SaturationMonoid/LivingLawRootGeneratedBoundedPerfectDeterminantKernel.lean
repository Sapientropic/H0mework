import Mathlib.Algebra.Homology.HomologicalComplex
import Mathlib.Algebra.Category.ModuleCat.Basic
import H0mework.Realization.Determinant.FourTermProjection

/-!
# Root-generated arbitrary bounded perfect determinant line

The four-term determinant projection is generalized to any finite cochain
amplitude `Fin n`.  An actual finite complex occurrence and an already
generated termwise finite-free calculation determine the alternating
integral determinant line, its parity, rank-one frame carrier, and canonical
integral unit torsor.  No basis, matrix, determinant element,
trivialization, cohomology cardinality, or regulator enters the mouth.

This file constructs the carrier functor.  Quasi-isomorphism invariance and
exact-triangle coherence are downstream faces of this same carrier.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace BoundedPerfectDeterminant

open CategoryTheory
open GradedIntegralDeterminantLine
open scoped TensorProduct

noncomputable section

universe w

/-- One finite-free integral term after perfectness has been generated by an
upstream calculation.  The package stores no chosen basis. -/
structure GeneratedFiniteFreeIntegralTermAt : Type 1 where
  module : ModuleCat.{0} ℤ
  free : Module.Free ℤ module
  finite : Module.Finite ℤ module

namespace GeneratedFiniteFreeIntegralTermAt

def generate (module : ModuleCat.{0} ℤ)
    (free : Module.Free ℤ module) (finite : Module.Finite ℤ module) :
    GeneratedFiniteFreeIntegralTermAt :=
  ⟨module, free, finite⟩

def rank (term : GeneratedFiniteFreeIntegralTermAt) : Nat := by
  letI : Module.Free ℤ term.module := term.free
  letI : Module.Finite ℤ term.module := term.finite
  exact Module.finrank ℤ term.module

end GeneratedFiniteFreeIntegralTermAt

/-- Internal rank-one line package.  Its frame is generated only to prove
rank one and is not exposed by the public bounded determinant state. -/
private structure RankOneIntegralLineAt : Type 1 where
  Carrier : ModuleCat.{0} ℤ
  frame : Module.Basis Unit ℤ Carrier

private noncomputable def integerLine : RankOneIntegralLineAt where
  Carrier := ModuleCat.of ℤ ℤ
  frame := Module.Basis.singleton Unit ℤ

private noncomputable def termTopLine
    (term : GeneratedFiniteFreeIntegralTermAt) : RankOneIntegralLineAt := by
  letI : Module.Free ℤ (term.module : Type) := term.free
  letI : Module.Finite ℤ (term.module : Type) := term.finite
  let basis := Module.finBasis ℤ (term.module : Type)
  let frame := determinantFrameOfBasis basis
  exact
    { Carrier := ModuleCat.of ℤ
        (⋀[ℤ]^(Module.finrank ℤ (term.module : Type)) (term.module : Type))
      frame := frame }

private noncomputable def termDualTopLine
    (term : GeneratedFiniteFreeIntegralTermAt) : RankOneIntegralLineAt := by
  let top := termTopLine term
  exact
    { Carrier := ModuleCat.of ℤ (Module.Dual ℤ top.Carrier)
      frame := top.frame.dualBasis }

private noncomputable def rankOneLineEquivInt
    (line : RankOneIntegralLineAt) : line.Carrier ≃ₗ[ℤ] ℤ :=
  line.frame.repr.trans (Finsupp.uniqueLinearEquiv ℤ ℤ ())

private noncomputable def tensorLine
    (left right : RankOneIntegralLineAt) : RankOneIntegralLineAt := by
  letI : Module ℤ (left.Carrier ⊗[ℤ] right.Carrier) :=
    TensorProduct.instModule
  let tensorEquiv :
      (left.Carrier ⊗[ℤ] right.Carrier) ≃ₗ[ℤ] ℤ :=
    (TensorProduct.congr (rankOneLineEquivInt left)
      (rankOneLineEquivInt right)).trans (TensorProduct.lid ℤ ℤ)
  exact
    { Carrier := ModuleCat.of ℤ (left.Carrier ⊗[ℤ] right.Carrier)
      frame := (Module.Basis.singleton Unit ℤ).map tensorEquiv.symm }

/-! The mutually recursive packages alternate covariance and duality.  The
singleton cases avoid an artificial terminal tensor factor. -/

mutual

private noncomputable def evenLinePackage :
    List GeneratedFiniteFreeIntegralTermAt → RankOneIntegralLineAt
  | [] => integerLine
  | [term] => termTopLine term
  | term :: next :: tail =>
      tensorLine (termTopLine term) (oddLinePackage (next :: tail))

private noncomputable def oddLinePackage :
    List GeneratedFiniteFreeIntegralTermAt → RankOneIntegralLineAt
  | [] => integerLine
  | [term] => termDualTopLine term
  | term :: next :: tail =>
      tensorLine (termDualTopLine term) (evenLinePackage (next :: tail))

end


abbrev evenDeterminantLine
    (terms : List GeneratedFiniteFreeIntegralTermAt) : Type :=
  (evenLinePackage terms).Carrier

abbrev oddDeterminantLine
    (terms : List GeneratedFiniteFreeIntegralTermAt) : Type :=
  (oddLinePackage terms).Carrier

noncomputable def evenDeterminantFrame
    (terms : List GeneratedFiniteFreeIntegralTermAt) :
    IntegralDeterminantFrame (evenDeterminantLine terms) :=
  (evenLinePackage terms).frame

noncomputable def oddDeterminantFrame
    (terms : List GeneratedFiniteFreeIntegralTermAt) :
    IntegralDeterminantFrame (oddDeterminantLine terms) :=
  (oddLinePackage terms).frame

noncomputable instance evenDeterminantLine_free
    (terms : List GeneratedFiniteFreeIntegralTermAt) :
    Module.Free ℤ (evenDeterminantLine terms) :=
  Module.Free.of_basis (evenDeterminantFrame terms)

noncomputable instance evenDeterminantLine_finite
    (terms : List GeneratedFiniteFreeIntegralTermAt) :
    Module.Finite ℤ (evenDeterminantLine terms) :=
  Module.Finite.of_basis (evenDeterminantFrame terms)

noncomputable instance oddDeterminantLine_free
    (terms : List GeneratedFiniteFreeIntegralTermAt) :
    Module.Free ℤ (oddDeterminantLine terms) :=
  Module.Free.of_basis (oddDeterminantFrame terms)

noncomputable instance oddDeterminantLine_finite
    (terms : List GeneratedFiniteFreeIntegralTermAt) :
    Module.Finite ℤ (oddDeterminantLine terms) :=
  Module.Finite.of_basis (oddDeterminantFrame terms)

theorem evenDeterminantLine_finrank
    (terms : List GeneratedFiniteFreeIntegralTermAt) :
    Module.finrank ℤ (evenDeterminantLine terms) = 1 :=
  calc
    Module.finrank ℤ (evenDeterminantLine terms) = Fintype.card Unit :=
      Module.finrank_eq_card_basis (evenDeterminantFrame terms)
    _ = 1 := by simp

theorem oddDeterminantLine_finrank
    (terms : List GeneratedFiniteFreeIntegralTermAt) :
    Module.finrank ℤ (oddDeterminantLine terms) = 1 :=
  calc
    Module.finrank ℤ (oddDeterminantLine terms) = Fintype.card Unit :=
      Module.finrank_eq_card_basis (oddDeterminantFrame terms)
    _ = 1 := by simp

/-- Finite cochain shape with arrows `i → i+1`. -/
def finiteCochainShape (length : Nat) : ComplexShape (Fin length) where
  Rel source target := source.val + 1 = target.val
  next_eq {source first second} first_rel second_rel := by
    apply Fin.ext
    exact first_rel.symm.trans second_rel
  prev_eq {first second target} first_rel second_rel := by
    apply Fin.ext
    omega

/-- Actual arbitrary finite-amplitude integral cochain complex. -/
abbrev FiniteIntegralCochainComplex (length : Nat) :=
  HomologicalComplex (ModuleCat.{0} ℤ) (finiteCochainShape length)

/-- Perfectness is a generated calculation indexed by the actual complex.
It contains no basis and no replacement complex. -/
structure RootGeneratedBoundedPerfectCalculationAt
    {length : Nat}
    (complex : FiniteIntegralCochainComplex length) : Prop where
  free : ∀ degree, Module.Free ℤ (complex.X degree)
  finite : ∀ degree, Module.Finite ℤ (complex.X degree)

namespace RootGeneratedBoundedPerfectCalculationAt

variable {length : Nat}
variable {complex : FiniteIntegralCochainComplex length}

theorem generate
    (free : ∀ degree, Module.Free ℤ (complex.X degree))
    (finite : ∀ degree, Module.Finite ℤ (complex.X degree)) :
    RootGeneratedBoundedPerfectCalculationAt complex :=
  ⟨free, finite⟩

def term (calculation : RootGeneratedBoundedPerfectCalculationAt complex)
    (degree : Fin length) : GeneratedFiniteFreeIntegralTermAt :=
  GeneratedFiniteFreeIntegralTermAt.generate (complex.X degree)
    (calculation.free degree) (calculation.finite degree)

def terms (calculation : RootGeneratedBoundedPerfectCalculationAt complex) :
    List GeneratedFiniteFreeIntegralTermAt :=
  (List.finRange length).map calculation.term

end RootGeneratedBoundedPerfectCalculationAt

/-- Root-owned bounded perfect determinant carrier. -/
structure RootGeneratedBoundedPerfectDeterminantAt
    {Root : Type w} {length : Nat}
    (rootOccurrence : RootedAccountedUnfolding Root)
    (complexOccurrence : RootedAccountedUnfolding
      (FiniteIntegralCochainComplex length))
    (calculation : RootGeneratedBoundedPerfectCalculationAt
      complexOccurrence.root) : Type where
  private mk ::

namespace RootGeneratedBoundedPerfectDeterminantAt

variable {Root : Type w} {length : Nat}
variable {rootOccurrence : RootedAccountedUnfolding Root}
variable {complexOccurrence : RootedAccountedUnfolding
  (FiniteIntegralCochainComplex length)}
variable {calculation : RootGeneratedBoundedPerfectCalculationAt
  complexOccurrence.root}

def generate : RootGeneratedBoundedPerfectDeterminantAt rootOccurrence
    complexOccurrence calculation :=
  ⟨⟩

def root
    (_face : RootGeneratedBoundedPerfectDeterminantAt rootOccurrence
      complexOccurrence calculation) :=
  rootOccurrence

def actualComplex
    (_face : RootGeneratedBoundedPerfectDeterminantAt rootOccurrence
      complexOccurrence calculation) :=
  complexOccurrence.root

def terms
    (_face : RootGeneratedBoundedPerfectDeterminantAt rootOccurrence
      complexOccurrence calculation) :=
  calculation.terms

abbrev integralLine
    (face : RootGeneratedBoundedPerfectDeterminantAt rootOccurrence
      complexOccurrence calculation) :=
  evenDeterminantLine face.terms

def parity
    (face : RootGeneratedBoundedPerfectDeterminantAt rootOccurrence
      complexOccurrence calculation) : Fin 2 :=
  ⟨(face.terms.map GeneratedFiniteFreeIntegralTermAt.rank).sum % 2,
    Nat.mod_lt _ (by norm_num)⟩

theorem integralLine_finrank
    (face : RootGeneratedBoundedPerfectDeterminantAt rootOccurrence
      complexOccurrence calculation) :
    Module.finrank ℤ face.integralLine = 1 :=
  evenDeterminantLine_finrank face.terms

noncomputable def unitTorsor
    (face : RootGeneratedBoundedPerfectDeterminantAt rootOccurrence
      complexOccurrence calculation) :
    CanonicalIntegralUnitTorsor face.integralLine :=
  canonicalIntegralUnitTorsor face.integralLine_finrank

theorem preserves_actual_bounded_complex
    (face : RootGeneratedBoundedPerfectDeterminantAt rootOccurrence
      complexOccurrence calculation) :
    face.root = rootOccurrence ∧ face.actualComplex = complexOccurrence.root :=
  ⟨rfl, rfl⟩

end RootGeneratedBoundedPerfectDeterminantAt

end

end BoundedPerfectDeterminant
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
