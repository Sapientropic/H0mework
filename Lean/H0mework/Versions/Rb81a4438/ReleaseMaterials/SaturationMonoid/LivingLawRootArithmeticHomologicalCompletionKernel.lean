import H0mework.Versions.Rb81a4438.ReleaseMaterials.SaturationMonoid.LivingLawArithmeticHomologicalCompletionKernel
import H0mework.Versions.Rb81a4438.ReleaseMaterials.SaturationMonoid.LivingLawRootArithmeticProcessKernel

/-!
# Root arithmetic homological completion

The same root completion receipt generates the boundary complex, the cofinal
observation cone and the rooted relation profile.  All three retain the
original whole-ledger write-back and generated next current.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace RootArithmeticHomologicalCompletion

open ArithmeticFreeClosure
open ArithmeticGeneration
open ArithmeticHomologicalCompletion
open RootArithmeticCompletion
open RootArithmeticIncidence
open RootArithmeticProcess

universe u

def generatedExpectedOccurrence
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    (direction : GeneratedArithmeticClosureDirectionAt step) :
    DerivedArithmeticOccurrence :=
  match direction with
  | .parallel _ =>
      .parallel (.atom step.material.left) (.atom step.material.right)
  | .joint _ =>
      .joint (.atom step.material.left) (.atom step.material.right)

def generatedActualOccurrence
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (step : RootArithmeticIncidenceStepAt recognition visit) :
    DerivedArithmeticOccurrence :=
  .atom step.material.whole

/-- One private homological authority face generated by the exact arithmetic
process. -/
structure RootGeneratedArithmeticHomologicalCompletionAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    {completion : RootArithmeticCompletionReceiptAt step direction}
    (process : RootGeneratedArithmeticProcessAt completion) : Type where
  private mk ::

def sourceGeneratedRootArithmeticHomologicalCompletion
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    {completion : RootArithmeticCompletionReceiptAt step direction}
    (process : RootGeneratedArithmeticProcessAt completion) :
    RootGeneratedArithmeticHomologicalCompletionAt process :=
  ⟨⟩

namespace RootGeneratedArithmeticHomologicalCompletionAt

def boundaryComplex
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    {completion : RootArithmeticCompletionReceiptAt step direction}
    {process : RootGeneratedArithmeticProcessAt completion}
    (_homological : RootGeneratedArithmeticHomologicalCompletionAt process) :
    SourceGeneratedResidualBoundaryComplexAt
      (generatedExpectedOccurrence direction)
      (generatedActualOccurrence step) :=
  sourceGeneratedResidualBoundaryComplex
    (generatedExpectedOccurrence direction)
    (generatedActualOccurrence step)

def cofinalObservation
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    {completion : RootArithmeticCompletionReceiptAt step direction}
    {process : RootGeneratedArithmeticProcessAt completion}
    (homological : RootGeneratedArithmeticHomologicalCompletionAt process) :
    SourceGeneratedCofinalResidualObservationAt
      homological.boundaryComplex :=
  homological.boundaryComplex.generateCofinalObservation

def relationProfile
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    {completion : RootArithmeticCompletionReceiptAt step direction}
    {process : RootGeneratedArithmeticProcessAt completion}
    (homological : RootGeneratedArithmeticHomologicalCompletionAt process) :
    SourceGeneratedRootedRelationProfileAt homological.boundaryComplex
      homological.boundaryComplex.initialState :=
  homological.boundaryComplex.relationProfileAt
    homological.boundaryComplex.initialState

def wholeLedgerWriteBack
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    {completion : RootArithmeticCompletionReceiptAt step direction}
    {process : RootGeneratedArithmeticProcessAt completion}
    (_homological : RootGeneratedArithmeticHomologicalCompletionAt process) :=
  process.wholeLedgerWriteBack

def nextCurrent
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    {completion : RootArithmeticCompletionReceiptAt step direction}
    {process : RootGeneratedArithmeticProcessAt completion}
    (_homological : RootGeneratedArithmeticHomologicalCompletionAt process) :
    SourceNativeAuthoritativeRootCurrentAt N :=
  process.nextCurrent

@[simp] theorem residualOccurrence_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    {completion : RootArithmeticCompletionReceiptAt step direction}
    {process : RootGeneratedArithmeticProcessAt completion}
    (homological : RootGeneratedArithmeticHomologicalCompletionAt process) :
    homological.boundaryComplex.residualOccurrence =
      completion.derivedOccurrence.occurrence := by
  cases direction <;> rfl

@[simp] theorem nextCurrent_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    {completion : RootArithmeticCompletionReceiptAt step direction}
    {process : RootGeneratedArithmeticProcessAt completion}
    (homological : RootGeneratedArithmeticHomologicalCompletionAt process) :
    homological.nextCurrent = root.generatedNextCurrentAt visit :=
  rfl

theorem unique
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    {completion : RootArithmeticCompletionReceiptAt step direction}
    {process : RootGeneratedArithmeticProcessAt completion}
    (left right : RootGeneratedArithmeticHomologicalCompletionAt process) :
    left = right := by
  cases left
  cases right
  rfl

end RootGeneratedArithmeticHomologicalCompletionAt
end RootArithmeticHomologicalCompletion
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
