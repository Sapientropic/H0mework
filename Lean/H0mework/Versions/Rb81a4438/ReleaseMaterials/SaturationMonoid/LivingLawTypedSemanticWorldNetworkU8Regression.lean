import H0mework.Foundation.Inquiry.SemanticRevision

/-!
# Regression: non-conservative world revisions pay for new incidence

The same rooted U8 occurrence must generate both sides of the semantic revision:
the old causal entry survives in the revised root's initial finite patch, and
one new live entry in that patch is machine-separated from every old-ledger
image.  A typed semantic-change receipt and the first revised write remain in
the same compiler output.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace TypedSemanticWorldNetworkU8Regression

open TypedSemanticWorldNetworkU8
open ObstructionGeneratedMinimalCoface

universe u

variable
    {N : WorldRelationNetwork.{u}}
    {OldV : Vocabulary.{u}}
    {oldRoot : SourceNativeAuthoritativeRootClosure N OldV}
    {oldVisit : SourceNativeTemporalVisitAt oldRoot.toLedgerRoot}
    {U7 : U7ProducerCalculus N}
    {oldTheory : TheoryState N}
    {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure oldTheory obstruction}
    {rooted : ObstructionGeneratedMinimalCoface.RootedActualExpressibilityFailureAt
      oldRoot oldVisit U7 failure}
    {source : FieldGroundedTypedSemanticWorldNetworkRevisionAt rooted}

/-- The old causal responsibility is present in the revised root's literal
initial finite patch. -/
def old_entry_survives_initial_patch := source.generate.oldEntryRow

/-- Whole-ledger survival is actual patch membership for every inherited
entry, not only a retract presentation. -/
def every_old_entry_survives_initial_patch
    (oldEntry : OpenResponsibilityAt N
      (oldRoot.toRoot.supportAt rooted.oldSuccessor.next)) :=
  source.generate.oldEntryRows oldEntry

/-- The added responsibility is also generated by that same initial finite
patch. -/
def new_entry_is_generated_initially := source.generate.newOnlyEntryRow

/-- The inherited row token is the exact row evolution folded into the first
revised whole-ledger write. -/
theorem old_entry_row_commutes_with_first_whole_ledger
    (oldEntry : OpenResponsibilityAt N
      (oldRoot.toRoot.supportAt rooted.oldSuccessor.next)) :
    (source.generate.oldEntryRows oldEntry).sourceRow.CommutesWithWorld :=
  source.generate.oldEntryRow_commutes_with_world oldEntry

/-- The new obstruction row cannot sit beside the first write: its exact row
evolution is the one used by that occurrence's whole-ledger fold. -/
theorem new_entry_row_commutes_with_first_whole_ledger :
    source.generate.newOnlyEntryRow.sourceRow.CommutesWithWorld :=
  source.generate.newOnlyEntryRow_commutes_with_world

/-- The revised claim is the rooted obstruction's addressable coface
coordinate.  No U8-local material execution or equation normal form is
inserted between the occurrence and this dependent face. -/
def generated_coface_claim :=
  source.generate.revisedClaimHolds

theorem generated_coface_claim_heq :
    source.generate.ExactFieldGrounding →
    HEq (generated_coface_claim (source := source))
      (root_obstruction_generates_minimal_coface rooted).obstructionClaimHolds :=
  fun exact => exact.revisedClaimHolds_heq

#print axioms old_entry_row_commutes_with_first_whole_ledger
#print axioms new_entry_row_commutes_with_first_whole_ledger
#print axioms generated_coface_claim
#print axioms generated_coface_claim_heq

/-- No old live responsibility can be relabelled as the generated new-only
incidence. -/
theorem new_entry_has_no_old_preimage
    (oldEntry : OpenResponsibilityAt N
      (oldRoot.toRoot.supportAt rooted.oldSuccessor.next)) :
    source.generate.oldTargetOpenLedger.forward oldEntry ≠
      source.generate.newOnlyEntry := by
  intro collision
  exact source.generate.newOnlyEntry_hasNoOldPreimage.false
    ⟨oldEntry, ⟨collision⟩⟩

/-- The typed semantic-change receipt is indexed by the old obstruction claim
and the generated revised claim. -/
def generated_semantic_change : source.generate.NewN.SemanticChangeAt
    source.generate.initialSupport
    (source.generate.translation.claim.forward
      (N.obstructionClaim obstruction))
    source.generate.revisedClaim :=
  source.generate.semanticChange

/-- The revised claim is a world fact at the exact translated extension
support; a bare new coordinate cannot masquerade as realized visibility. -/
def generated_revised_claim_holds : source.generate.NewN.HoldsAt
    source.generate.initialSupport
    source.generate.revisedClaim :=
  source.generate.revisedClaimHolds

/-- The rooted minimal coface fixes the revised law surface carried by every
field-grounded realization. -/
theorem generated_law_surface_is_minimal_coface_root_semantic :
    source.generate.ExactFieldGrounding →
      HEq source.generate.newLivingRoot.source.base.lawSurface
      (TheoryState.rootSemantic
        (ObstructionGeneratedMinimalCoface.root_obstruction_generates_minimal_coface
          rooted).worldNetwork) :=
  fun exact => exact.lawSurface_heq

/-- The revised claim is not merely visible beside the generated row: it is
the exact claim carried by that source-generated live incidence. -/
theorem generated_entry_carries_revised_claim :
    source.generate.newOnlyEntry.claim = source.generate.revisedClaim :=
  rfl

/-- A typed realization cannot fold the generated obstruction incidence back
into an inherited incidence coordinate. -/
theorem generated_incidence_is_new :
    IsEmpty (Sigma fun oldIncidence : N.Incidence =>
      PLift (source.generate.translation.incidence.forward oldIncidence =
        source.generate.newOnlyIncidence)) :=
  source.generate.newOnlyIncidence_hasNoOldPreimage

/-- The new incidence is not a sibling compiler output; it is the revised
support's canonical world incidence. -/
theorem generated_incidence_is_exact_support_readout :
    source.generate.newOnlyIncidence = source.generate.NewN.incidenceAt
      source.generate.initialSupport :=
  source.generate.newOnlyIncidence_eq_support

/-- Nor can it rename an old claim as the newly expressive obstruction
coordinate. -/
theorem generated_claim_is_new :
    IsEmpty (Sigma fun oldClaim : N.Claim =>
      PLift (source.generate.translation.claim.forward oldClaim =
        source.generate.revisedClaim)) :=
  source.generate.revisedClaim_hasNoOldPreimage

/-- The public typed carrier is generated only after the exact rooted failure
has produced its canonical minimal coface. -/
def generated_revision_realizes_minimal_coface :=
  source.generate_minimalCofaceMorphism

/-- The minimal direction's exact obstruction boundary and the revised
root's first live-row write are one generated attachment. -/
def generated_revision_realizes_attached_coface :
    SourceGeneratedAttachedCofaceRealizationAt source.generate :=
  source.generate.attachedCofaceRealization

/-- The authoritative revised root is only the erasure of the complete living
source.  Its future terminal law is therefore part of occurrence identity,
not a detachable certificate beside the first write. -/
theorem revised_authoritative_root_is_living_erasure :
    source.generate.newRoot =
      source.generate.newLivingRoot.toAuthoritativeRoot :=
  rfl

/- The historical post-root bare compiler constructor is gone. -/
/-- error: Unknown constant -/
#guard_msgs (substring := true) in
#check FieldGroundedTypedSemanticWorldNetworkRevisionAt.ofCofaceCompiler

/- A field-grounded candidate cannot mint an actual-event receipt by using
its own structural projection as a compiler.  Actuality is supplied only by
the fixed inquiry engine occurrence which emits the candidate. -/
/-- error: Unknown constant -/
#guard_msgs (substring := true) in
#check FieldGroundedTypedSemanticWorldNetworkRevisionAt.canonicalCompiler

/-- Every admitted source occurrence carries either exact-minimal grounding
or a source-generated faithful richer restructuring around the same single
generated revision. -/
theorem generated_revision_has_source_grounding :
    source.generate.RevisionGroundingAt :=
  source.revisionGrounding

/-- Raw model syntax may replace a parallel semantic field, but root authority
can ground that replacement only when it is the original minimal-coface
semantic change. -/
def withSemanticChange
    (change : source.generate.NewN.SemanticChangeAt
      source.generate.initialSupport
      (source.generate.translation.claim.forward
        (N.obstructionClaim obstruction))
      source.generate.revisedClaim) :
    GeneratedTypedSemanticWorldNetworkRevisionAt rooted :=
  { source.generate with semanticChange := change }

theorem semantic_change_authority_is_not_contagious
    (change : source.generate.NewN.SemanticChangeAt
      source.generate.initialSupport
      (source.generate.translation.claim.forward
        (N.obstructionClaim obstruction))
      source.generate.revisedClaim)
    (grounding : (withSemanticChange change).ExactFieldGrounding) :
    source.generate.ExactFieldGrounding →
    change = source.generate.semanticChange := by
  intro sourceExact
  exact eq_of_heq <|
    grounding.semanticChange_heq.trans
      sourceExact.semanticChange_heq.symm

/-- Equal complete realizations are the same grounded candidate. -/
theorem generated_revision_determines_source_event
    {left right : FieldGroundedTypedSemanticWorldNetworkRevisionAt rooted}
    (generated_eq : left.generate = right.generate) : left = right :=
  FieldGroundedTypedSemanticWorldNetworkRevisionAt.eq_of_generate_eq generated_eq

/- The historical free event/compiler installer is gone. -/
/-- error: Unknown constant -/
#guard_msgs (substring := true) in
#check FieldGroundedTypedSemanticWorldNetworkRevisionAt.ofEventCompiler

/-- The revised root starts on a support whose old-world restriction is the
exact old successor target; the support itself may be the generated coface. -/
theorem revised_initial_support_restricts_to_old_successor_target :
    source.generate.translation.support.backward
        source.generate.initialSupport =
      oldRoot.toRoot.supportAt rooted.oldSuccessor.next :=
  source.generate.new_support_restricts

/-- The occurrence seam likewise starts from the actual original-root
successor occurrence. -/
theorem revised_initial_occurrence_is_old_successor_target :
    source.generate.occurrencePresentation.forward
        (oldRoot.emitted rooted.oldSuccessor.next) =
      source.generate.newRoot.emitted
        source.generate.newRoot.toRoot.source.initial :=
  source.generate.occurrence_commutes

/-- The same seam factors all the way through the old root emitter; the U8
realization cannot substitute a compiler-local sibling target occurrence. -/
theorem revised_initial_occurrence_is_old_root_emitter_target :
    source.generate.occurrencePresentation.forward
        (oldRoot.emitted rooted.oldSuccessor.next) =
      source.generate.newRoot.emitted
        source.generate.newRoot.toRoot.source.initial :=
  source.generate.oldRootEmitter_commutes

/-- The first revised target is still computed by the generated root rather
than supplied with the new-only incidence. -/
theorem first_write_is_revised_root_target :
    (source.generate.newRoot.toRoot.evolutionAt
      source.generate.newRoot.toRoot.source.initial).nextCurrent? =
        some source.generate.firstWrite.target :=
  source.generate.firstWrite.next_eq

/-- Minimality extends through the complete typed occurrence and its first
whole-ledger write; it is not only a carrier-cardinality readout. -/
def typed_revision_full_initial_factorization :=
  source.generate.factorizesThroughInitialCoface

#print axioms GeneratedTypedSemanticWorldNetworkRevisionAt.factorizesThroughInitialCoface
#print axioms typed_revision_full_initial_factorization

end TypedSemanticWorldNetworkU8Regression
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
