import H0mework.Versions.Rb81a4438.ReleaseMaterials.SaturationMonoid.LivingLawArithmeticProcessKernel

/-!
# Arithmetic homological completion

One generated cofiber produces its boundary complex, its cofinal finite
observations and its rooted relation profile.  No caller supplies a
differential, completed observation stream, relation table or result.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace ArithmeticHomologicalCompletion

open ArithmeticGeneration
open ArithmeticFreeClosure
open ArithmeticFreeClosure.DerivedArithmeticOccurrence

universe u

/-! ## B. Residual boundary closure -/

inductive ResidualTrianglePhase : Type
  | source
  | target
  | residual
  deriving DecidableEq

/-- A position in the generated long boundary sequence.  Its shift is an
unindexed occurrence history, not a primitive integer degree. -/
structure ResidualTriangleState : Type where
  shift : UnitHistory
  phase : ResidualTrianglePhase
  deriving DecidableEq

def ResidualTriangleState.initial : ResidualTriangleState :=
  ⟨.empty, .source⟩

def ResidualTriangleState.successor :
    ResidualTriangleState → ResidualTriangleState
  | ⟨shift, .source⟩ => ⟨shift, .target⟩
  | ⟨shift, .target⟩ => ⟨shift, .residual⟩
  | ⟨shift, .residual⟩ => ⟨.next shift, .source⟩

@[simp] theorem ResidualTriangleState.successor_three
    (state : ResidualTriangleState) :
    state.successor.successor.successor =
      ⟨.next state.shift, state.phase⟩ := by
  cases state with
  | mk shift phase => cases phase <;> rfl

def ResidualTriangleState.advance
    (state : ResidualTriangleState) : UnitHistory → ResidualTriangleState
  | .empty => state
  | .next prior => (state.advance prior).successor

@[simp] theorem ResidualTriangleState.advance_empty
    (state : ResidualTriangleState) :
    state.advance .empty = state :=
  rfl

@[simp] theorem ResidualTriangleState.advance_next
    (state : ResidualTriangleState) (depth : UnitHistory) :
    state.advance (.next depth) = (state.advance depth).successor :=
  rfl

inductive ResidualBoundaryKind : Type
  | sourceToTarget
  | targetToResidual
  | residualToShift
  deriving DecidableEq

def ResidualTriangleState.boundaryKind :
    ResidualTriangleState → ResidualBoundaryKind
  | ⟨_, .source⟩ => .sourceToTarget
  | ⟨_, .target⟩ => .targetToResidual
  | ⟨_, .residual⟩ => .residualToShift

/-- The object at one generated position of the exact triangle and all its
shifts. -/
def ResidualTriangleState.objectAt
    (source target : DerivedArithmeticOccurrence) :
    ResidualTriangleState → DerivedArithmeticOccurrence
  | ⟨shift, .source⟩ => graded shift source
  | ⟨shift, .target⟩ => graded shift target
  | ⟨shift, .residual⟩ => graded shift (.cofiber source target)

/-- Zero-field boundary complex generated by one cofiber occurrence. -/
structure SourceGeneratedResidualBoundaryComplexAt
    (source target : DerivedArithmeticOccurrence) : Type where
  private mk ::

def sourceGeneratedResidualBoundaryComplex
    (source target : DerivedArithmeticOccurrence) :
    SourceGeneratedResidualBoundaryComplexAt source target :=
  ⟨⟩

namespace SourceGeneratedResidualBoundaryComplexAt

def residualOccurrence
    {source target : DerivedArithmeticOccurrence}
    (_complex : SourceGeneratedResidualBoundaryComplexAt source target) :
    DerivedArithmeticOccurrence :=
  .cofiber source target

def initialState
    {source target : DerivedArithmeticOccurrence}
    (_complex : SourceGeneratedResidualBoundaryComplexAt source target) :
    ResidualTriangleState :=
  .initial

def stateAfter
    {source target : DerivedArithmeticOccurrence}
    (_complex : SourceGeneratedResidualBoundaryComplexAt source target)
    (depth : UnitHistory) : ResidualTriangleState :=
  ResidualTriangleState.initial.advance depth

def objectAt
    {source target : DerivedArithmeticOccurrence}
    (_complex : SourceGeneratedResidualBoundaryComplexAt source target)
    (state : ResidualTriangleState) : DerivedArithmeticOccurrence :=
  state.objectAt source target

def boundaryKindAt
    {source target : DerivedArithmeticOccurrence}
    (_complex : SourceGeneratedResidualBoundaryComplexAt source target)
    (state : ResidualTriangleState) : ResidualBoundaryKind :=
  state.boundaryKind

/-- Three exact boundaries rotate back to the same phase and shift its
occurrence once.  This is the structural long-exact-sequence law; Euler and
determinant remain external folds of it. -/
@[simp] theorem objectAt_successor_three
    {source target : DerivedArithmeticOccurrence}
    (complex : SourceGeneratedResidualBoundaryComplexAt source target)
    (state : ResidualTriangleState) :
    complex.objectAt state.successor.successor.successor =
      .shift (complex.objectAt state) := by
  cases state with
  | mk shift phase => cases phase <;> rfl

@[simp] theorem boundaryKindAt_successor_three
    {source target : DerivedArithmeticOccurrence}
    (complex : SourceGeneratedResidualBoundaryComplexAt source target)
    (state : ResidualTriangleState) :
    complex.boundaryKindAt state.successor.successor.successor =
      complex.boundaryKindAt state := by
  cases state with
  | mk shift phase => cases phase <;> rfl

theorem unique
    {source target : DerivedArithmeticOccurrence}
    (left right : SourceGeneratedResidualBoundaryComplexAt source target) :
    left = right := by
  cases left
  cases right
  rfl

end SourceGeneratedResidualBoundaryComplexAt

/-- One exact boundary generated at a fixed state of the complex. -/
structure SourceGeneratedResidualBoundaryAt
    {source target : DerivedArithmeticOccurrence}
    (complex : SourceGeneratedResidualBoundaryComplexAt source target)
    (state : ResidualTriangleState) : Type where
  private mk ::

def SourceGeneratedResidualBoundaryComplexAt.boundaryAt
    {source target : DerivedArithmeticOccurrence}
    (complex : SourceGeneratedResidualBoundaryComplexAt source target)
    (state : ResidualTriangleState) :
    SourceGeneratedResidualBoundaryAt complex state :=
  ⟨⟩

namespace SourceGeneratedResidualBoundaryAt

def sourceOccurrence
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {state : ResidualTriangleState}
    (_boundary : SourceGeneratedResidualBoundaryAt complex state) :
    DerivedArithmeticOccurrence :=
  complex.objectAt state

def targetOccurrence
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {state : ResidualTriangleState}
    (_boundary : SourceGeneratedResidualBoundaryAt complex state) :
    DerivedArithmeticOccurrence :=
  complex.objectAt state.successor

def kind
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {state : ResidualTriangleState}
    (_boundary : SourceGeneratedResidualBoundaryAt complex state) :
    ResidualBoundaryKind :=
  complex.boundaryKindAt state

theorem unique
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {state : ResidualTriangleState}
    (left right : SourceGeneratedResidualBoundaryAt complex state) :
    left = right := by
  cases left
  cases right
  rfl

end SourceGeneratedResidualBoundaryAt

/-- The free normal form of two consecutive boundaries.  The only lawful
normal form is zero; concrete homological realizations must preserve it. -/
inductive ResidualBoundaryCompositeNormalForm : Type
  | zero
  deriving DecidableEq

structure SourceGeneratedResidualBoundarySquareAt
    {source target : DerivedArithmeticOccurrence}
    (complex : SourceGeneratedResidualBoundaryComplexAt source target)
    (state : ResidualTriangleState) : Type where
  private mk ::

def SourceGeneratedResidualBoundaryComplexAt.boundarySquareAt
    {source target : DerivedArithmeticOccurrence}
    (complex : SourceGeneratedResidualBoundaryComplexAt source target)
    (state : ResidualTriangleState) :
    SourceGeneratedResidualBoundarySquareAt complex state :=
  ⟨⟩

namespace SourceGeneratedResidualBoundarySquareAt

def first
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {state : ResidualTriangleState}
    (_square : SourceGeneratedResidualBoundarySquareAt complex state) :
    SourceGeneratedResidualBoundaryAt complex state :=
  complex.boundaryAt state

def second
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {state : ResidualTriangleState}
    (_square : SourceGeneratedResidualBoundarySquareAt complex state) :
    SourceGeneratedResidualBoundaryAt complex state.successor :=
  complex.boundaryAt state.successor

def normalForm
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {state : ResidualTriangleState}
    (_square : SourceGeneratedResidualBoundarySquareAt complex state) :
    ResidualBoundaryCompositeNormalForm :=
  .zero

@[simp] theorem boundaries_compose
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {state : ResidualTriangleState}
    (square : SourceGeneratedResidualBoundarySquareAt complex state) :
    square.first.targetOccurrence = square.second.sourceOccurrence :=
  rfl

@[simp] theorem boundary_squared_zero
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {state : ResidualTriangleState}
    (square : SourceGeneratedResidualBoundarySquareAt complex state) :
    square.normalForm = .zero :=
  rfl

theorem unique
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {state : ResidualTriangleState}
    (left right : SourceGeneratedResidualBoundarySquareAt complex state) :
    left = right := by
  cases left
  cases right
  rfl

end SourceGeneratedResidualBoundarySquareAt

/-- Formal exactness at one vertex of the free stable boundary complex. -/
structure SourceGeneratedResidualExactAt
    {source target : DerivedArithmeticOccurrence}
    (complex : SourceGeneratedResidualBoundaryComplexAt source target)
    (state : ResidualTriangleState) : Type where
  private mk ::

def SourceGeneratedResidualBoundaryComplexAt.exactAt
    {source target : DerivedArithmeticOccurrence}
    (complex : SourceGeneratedResidualBoundaryComplexAt source target)
    (state : ResidualTriangleState) :
    SourceGeneratedResidualExactAt complex state :=
  ⟨⟩

theorem SourceGeneratedResidualExactAt.unique
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {state : ResidualTriangleState}
    (left right : SourceGeneratedResidualExactAt complex state) :
    left = right := by
  cases left
  cases right
  rfl

/-! ## A. Cofinal finite-observation cone -/

structure SourceGeneratedFiniteResidualObservationAt
    {source target : DerivedArithmeticOccurrence}
    (complex : SourceGeneratedResidualBoundaryComplexAt source target)
    (depth : UnitHistory) : Type where
  private mk ::

def SourceGeneratedResidualBoundaryComplexAt.observeAt
    {source target : DerivedArithmeticOccurrence}
    (complex : SourceGeneratedResidualBoundaryComplexAt source target)
    (depth : UnitHistory) :
    SourceGeneratedFiniteResidualObservationAt complex depth :=
  ⟨⟩

namespace SourceGeneratedFiniteResidualObservationAt

def state
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {depth : UnitHistory}
    (_observation : SourceGeneratedFiniteResidualObservationAt complex depth) :
    ResidualTriangleState :=
  complex.stateAfter depth

def object
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {depth : UnitHistory}
    (observation : SourceGeneratedFiniteResidualObservationAt complex depth) :
    DerivedArithmeticOccurrence :=
  complex.objectAt observation.state

def boundary
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {depth : UnitHistory}
    (observation : SourceGeneratedFiniteResidualObservationAt complex depth) :
    SourceGeneratedResidualBoundaryAt complex observation.state :=
  complex.boundaryAt observation.state

def boundarySquare
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {depth : UnitHistory}
    (observation : SourceGeneratedFiniteResidualObservationAt complex depth) :
    SourceGeneratedResidualBoundarySquareAt complex observation.state :=
  complex.boundarySquareAt observation.state

def exact
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {depth : UnitHistory}
    (observation : SourceGeneratedFiniteResidualObservationAt complex depth) :
    SourceGeneratedResidualExactAt complex observation.state :=
  complex.exactAt observation.state

def restrict
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {depth : UnitHistory}
    (_observation : SourceGeneratedFiniteResidualObservationAt
      complex (.next depth)) :
    SourceGeneratedFiniteResidualObservationAt complex depth :=
  complex.observeAt depth

theorem unique
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {depth : UnitHistory}
    (left right : SourceGeneratedFiniteResidualObservationAt complex depth) :
    left = right := by
  cases left
  cases right
  rfl

end SourceGeneratedFiniteResidualObservationAt

/-- Zero-field cofinal cone.  It stores no `UnitHistory → observation` table;
every finite view is regenerated from the complex. -/
structure SourceGeneratedCofinalResidualObservationAt
    {source target : DerivedArithmeticOccurrence}
    (complex : SourceGeneratedResidualBoundaryComplexAt source target) : Type where
  private mk ::

def SourceGeneratedResidualBoundaryComplexAt.generateCofinalObservation
    {source target : DerivedArithmeticOccurrence}
    (complex : SourceGeneratedResidualBoundaryComplexAt source target) :
    SourceGeneratedCofinalResidualObservationAt complex :=
  ⟨⟩

namespace SourceGeneratedCofinalResidualObservationAt

def observationAt
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    (_cone : SourceGeneratedCofinalResidualObservationAt complex)
    (depth : UnitHistory) :
    SourceGeneratedFiniteResidualObservationAt complex depth :=
  complex.observeAt depth

@[simp] theorem restricts
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    (cone : SourceGeneratedCofinalResidualObservationAt complex)
    (depth : UnitHistory) :
    (cone.observationAt (.next depth)).restrict =
      cone.observationAt depth :=
  rfl

theorem unique
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    (left right : SourceGeneratedCofinalResidualObservationAt complex) :
    left = right := by
  cases left
  cases right
  rfl

end SourceGeneratedCofinalResidualObservationAt

/-- A local observer is generated from one seed and one boundary action. -/
def residualObservationFold
    {Carrier : Type u}
    {source target : DerivedArithmeticOccurrence}
    (complex : SourceGeneratedResidualBoundaryComplexAt source target)
    (seed : Carrier)
    (advance : ResidualBoundaryKind → Carrier → Carrier) :
    UnitHistory → Carrier
  | .empty => seed
  | .next prior =>
      advance (complex.boundaryKindAt (complex.stateAfter prior))
        (residualObservationFold complex seed advance prior)

/-- Universal factorization of every observer that respects the generated
initial view and local boundary action. -/
theorem residualObservationFold_unique
    {Carrier : Type u}
    {source target : DerivedArithmeticOccurrence}
    (complex : SourceGeneratedResidualBoundaryComplexAt source target)
    (seed : Carrier)
    (advance : ResidualBoundaryKind → Carrier → Carrier)
    (candidate : UnitHistory → Carrier)
    (initial_commutes : candidate .empty = seed)
    (advance_commutes : (depth : UnitHistory) →
      candidate (.next depth) =
        advance (complex.boundaryKindAt (complex.stateAfter depth))
          (candidate depth)) :
    (depth : UnitHistory) →
      candidate depth = residualObservationFold complex seed advance depth
  | .empty => initial_commutes
  | .next prior =>
      (advance_commutes prior).trans
        (congrArg
          (advance (complex.boundaryKindAt (complex.stateAfter prior)))
          (residualObservationFold_unique complex seed advance candidate
            initial_commutes advance_commutes prior))

/-! ## C. Rooted relational extensionality -/

def residualBoundaryHistoryFrom
    {source target : DerivedArithmeticOccurrence}
    (complex : SourceGeneratedResidualBoundaryComplexAt source target)
    (anchor : ResidualTriangleState) : UnitHistory → List ResidualBoundaryKind
  | .empty => []
  | .next prior =>
      residualBoundaryHistoryFrom complex anchor prior ++
        [complex.boundaryKindAt (anchor.advance prior)]

structure SourceGeneratedRootedResidualPathAt
    {source target : DerivedArithmeticOccurrence}
    (complex : SourceGeneratedResidualBoundaryComplexAt source target)
    (anchor : ResidualTriangleState)
    (length : UnitHistory) : Type where
  private mk ::

def SourceGeneratedResidualBoundaryComplexAt.pathAt
    {source target : DerivedArithmeticOccurrence}
    (complex : SourceGeneratedResidualBoundaryComplexAt source target)
    (anchor : ResidualTriangleState) (length : UnitHistory) :
    SourceGeneratedRootedResidualPathAt complex anchor length :=
  ⟨⟩

namespace SourceGeneratedRootedResidualPathAt

def sourceState
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {anchor : ResidualTriangleState} {length : UnitHistory}
    (_path : SourceGeneratedRootedResidualPathAt complex anchor length) :
    ResidualTriangleState :=
  anchor

def targetState
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {anchor : ResidualTriangleState} {length : UnitHistory}
    (_path : SourceGeneratedRootedResidualPathAt complex anchor length) :
    ResidualTriangleState :=
  anchor.advance length

def boundaryHistory
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {anchor : ResidualTriangleState} {length : UnitHistory}
    (_path : SourceGeneratedRootedResidualPathAt complex anchor length) :
    List ResidualBoundaryKind :=
  residualBoundaryHistoryFrom complex anchor length

theorem unique
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {anchor : ResidualTriangleState} {length : UnitHistory}
    (left right : SourceGeneratedRootedResidualPathAt complex anchor length) :
    left = right := by
  cases left
  cases right
  rfl

end SourceGeneratedRootedResidualPathAt

/-- A rooted representable relation profile.  The identity anchor is a type
index; every outgoing path is regenerated by the boundary complex. -/
structure SourceGeneratedRootedRelationProfileAt
    {source target : DerivedArithmeticOccurrence}
    (complex : SourceGeneratedResidualBoundaryComplexAt source target)
    (anchor : ResidualTriangleState) : Type where
  private mk ::

def SourceGeneratedResidualBoundaryComplexAt.relationProfileAt
    {source target : DerivedArithmeticOccurrence}
    (complex : SourceGeneratedResidualBoundaryComplexAt source target)
    (anchor : ResidualTriangleState) :
    SourceGeneratedRootedRelationProfileAt complex anchor :=
  ⟨⟩

namespace SourceGeneratedRootedRelationProfileAt

def identityPath
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {anchor : ResidualTriangleState}
    (_profile : SourceGeneratedRootedRelationProfileAt complex anchor) :
    SourceGeneratedRootedResidualPathAt complex anchor .empty :=
  complex.pathAt anchor .empty

def pathAt
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {anchor : ResidualTriangleState}
    (_profile : SourceGeneratedRootedRelationProfileAt complex anchor)
    (length : UnitHistory) :
    SourceGeneratedRootedResidualPathAt complex anchor length :=
  complex.pathAt anchor length

def anchor
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {rootedAnchor : ResidualTriangleState}
    (_profile : SourceGeneratedRootedRelationProfileAt complex rootedAnchor) :
    ResidualTriangleState :=
  rootedAnchor

theorem unique
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {anchor : ResidualTriangleState}
    (left right : SourceGeneratedRootedRelationProfileAt complex anchor) :
    left = right := by
  cases left
  cases right
  rfl

end SourceGeneratedRootedRelationProfileAt

structure RootedRelationProfileNormalForm : Type where
  anchor : ResidualTriangleState
  deriving DecidableEq

def SourceGeneratedRootedRelationProfileAt.normalForm
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {anchor : ResidualTriangleState}
    (_profile : SourceGeneratedRootedRelationProfileAt complex anchor) :
    RootedRelationProfileNormalForm :=
  ⟨anchor⟩

/-- Rooted Yoneda faithfulness: equality of the identity-normal forms forces
the exact anchors to agree. -/
theorem relationProfileNormalForm_reflects_anchor
    {source target : DerivedArithmeticOccurrence}
    {complex : SourceGeneratedResidualBoundaryComplexAt source target}
    {leftAnchor rightAnchor : ResidualTriangleState}
    (left : SourceGeneratedRootedRelationProfileAt complex leftAnchor)
    (right : SourceGeneratedRootedRelationProfileAt complex rightAnchor)
    (normalForm_eq : left.normalForm = right.normalForm) :
    leftAnchor = rightAnchor :=
  congrArg RootedRelationProfileNormalForm.anchor normalForm_eq

/-- Relation-preserving realizations are determined by their identity value
and local action; they cannot attach an independent completed relation table. -/
def rootedRelationFold
    {Carrier : Type u}
    {source target : DerivedArithmeticOccurrence}
    (complex : SourceGeneratedResidualBoundaryComplexAt source target)
    (anchor : ResidualTriangleState)
    (identityAt : Carrier)
    (advance : ResidualBoundaryKind → Carrier → Carrier) :
    UnitHistory → Carrier
  | .empty => identityAt
  | .next prior =>
      advance (complex.boundaryKindAt (anchor.advance prior))
        (rootedRelationFold complex anchor identityAt advance prior)

theorem rootedRelationFold_unique
    {Carrier : Type u}
    {source target : DerivedArithmeticOccurrence}
    (complex : SourceGeneratedResidualBoundaryComplexAt source target)
    (anchor : ResidualTriangleState)
    (identityAt : Carrier)
    (advance : ResidualBoundaryKind → Carrier → Carrier)
    (candidate : UnitHistory → Carrier)
    (identity_commutes : candidate .empty = identityAt)
    (naturality : (length : UnitHistory) →
      candidate (.next length) =
        advance (complex.boundaryKindAt (anchor.advance length))
          (candidate length)) :
    (length : UnitHistory) →
      candidate length =
        rootedRelationFold complex anchor identityAt advance length
  | .empty => identity_commutes
  | .next prior =>
      (naturality prior).trans
        (congrArg
          (advance (complex.boundaryKindAt (anchor.advance prior)))
          (rootedRelationFold_unique complex anchor identityAt advance candidate
            identity_commutes naturality prior))

