import Mathlib.Algebra.Group.Defs
import H0mework.Foundation.Arithmetic.Generation
import H0mework.Foundation.Source.AccountedUnfolding

/-!
# Free arithmetic closure and derived incidence

An arithmetic obstruction does not select a named number system.  It generates
one ordinary extension direction in the initial grammar
`Base + Direction × X`.  Standard number systems and domain carriers are
faithful folds of that grammar, not primitive authority.

Stable arithmetic is likewise generated as an unindexed occurrence grammar.
Euler and determinant laws are folds of actual `parallel`, `joint`, `shift`
and `cofiber` constructors; cardinality is only the atom-level shadow.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace ArithmeticFreeClosure

open ArithmeticGeneration

universe u v w

theorem congrArgTwo
    {Left : Sort u} {Right : Sort v} {Target : Sort w}
    (operation : Left → Right → Target)
    {left₁ left₂ : Left} {right₁ right₂ : Right}
    (left_eq : left₁ = left₂) (right_eq : right₁ = right₂) :
    operation left₁ right₁ = operation left₂ right₂ := by
  cases left_eq
  cases right_eq
  rfl

/-- Initial ordinary closure grammar.  A direction is already generated by
an exact obstruction; the grammar accepts no completed carrier or result. -/
inductive FreeClosureAt (Base : Type u) (Direction : Type v) : Type (max u v)
  | base (value : Base)
  | extend (direction : Direction) (prior : FreeClosureAt Base Direction)

namespace FreeClosureAt

/-- Every realization is forced by its base and local extension action. -/
def fold
    {Base : Type u} {Direction : Type v} {Carrier : Type w}
    (baseAt : Base → Carrier)
    (extendAt : Direction → Carrier → Carrier) :
    FreeClosureAt Base Direction → Carrier
  | .base value => baseAt value
  | .extend direction prior => extendAt direction (fold baseAt extendAt prior)

@[simp] theorem fold_base
    {Base : Type u} {Direction : Type v} {Carrier : Type w}
    (baseAt : Base → Carrier)
    (extendAt : Direction → Carrier → Carrier)
    (value : Base) :
    fold baseAt extendAt (.base value) = baseAt value :=
  rfl

@[simp] theorem fold_extend
    {Base : Type u} {Direction : Type v} {Carrier : Type w}
    (baseAt : Base → Carrier)
    (extendAt : Direction → Carrier → Carrier)
    (direction : Direction) (prior : FreeClosureAt Base Direction) :
    fold baseAt extendAt (.extend direction prior) =
      extendAt direction (fold baseAt extendAt prior) :=
  rfl

/-- Pointwise initiality, stated without function extensionality. -/
theorem fold_unique
    {Base : Type u} {Direction : Type v} {Carrier : Type w}
    (baseAt : Base → Carrier)
    (extendAt : Direction → Carrier → Carrier)
    (candidate : FreeClosureAt Base Direction → Carrier)
    (base_commutes : (value : Base) →
      candidate (.base value) = baseAt value)
    (extend_commutes : (direction : Direction) →
      (prior : FreeClosureAt Base Direction) →
      candidate (.extend direction prior) =
        extendAt direction (candidate prior)) :
    (node : FreeClosureAt Base Direction) →
      candidate node = fold baseAt extendAt node
  | .base value => base_commutes value
  | .extend direction prior =>
      (extend_commutes direction prior).trans
        (congrArg (extendAt direction)
          (fold_unique baseAt extendAt candidate base_commutes
            extend_commutes prior))

end FreeClosureAt

/-- Arithmetic directions are face coordinates of the universal occurrence,
not constructors of a separate arithmetic world. -/
inductive DerivedArithmeticDirection : Type
  | material (history : UnitHistory)
  | sibling
  | dependent
  | phase
  | dual
  | frontier

/-- Historical public name for the arithmetic restriction of one rooted
accounted unfolding.  Its only occurrence constructor is `occur`; the old
arithmetic constructors below are compatibility builders for tree positions. -/
abbrev DerivedArithmeticOccurrence : Type :=
  RootedAccountedUnfolding DerivedArithmeticDirection

namespace DerivedArithmeticOccurrence

open RootedAccountedUnfolding

/-- Pure material leaf. -/
def atom (history : UnitHistory) : DerivedArithmeticOccurrence :=
  zero (.material history)

/-- Parallel composition is sibling branching. -/
def parallel (left right : DerivedArithmeticOccurrence) :
    DerivedArithmeticOccurrence :=
  parallelAt .sibling left right

/-- Joint composition uses the dependent branch coordinate. -/
def joint (left right : DerivedArithmeticOccurrence) :
    DerivedArithmeticOccurrence :=
  .occur .dependent (.cons left (.singleton right))

/-- Shift is a re-rooted unary phase face. -/
def shift (prior : DerivedArithmeticOccurrence) :
    DerivedArithmeticOccurrence :=
  .occur .phase (.singleton prior)

/-- Duality is a unary orientation face. -/
def dual (prior : DerivedArithmeticOccurrence) :
    DerivedArithmeticOccurrence :=
  .occur .dual (.singleton prior)

/-- Cofiber is the frontier/debit face of the same exposure. -/
def cofiber (source target : DerivedArithmeticOccurrence) :
    DerivedArithmeticOccurrence :=
  .occur .frontier (.cons source (.singleton target))

private def firstChildOr {Carrier : Type u}
    (fallback : Carrier) : List Carrier → Carrier
  | [] => fallback
  | first :: _ => first

private def secondChildOr {Carrier : Type u}
    (fallback : Carrier) : List Carrier → Carrier
  | _ :: second :: _ => second
  | _ => fallback

private def foldAlgebra
    {Carrier : Type u}
    (atomAt : UnitHistory → Carrier)
    (parallelAt jointAt : Carrier → Carrier → Carrier)
    (shiftAt dualAt : Carrier → Carrier)
    (cofiberAt : Carrier → Carrier → Carrier)
    (direction : DerivedArithmeticDirection)
    (children : List Carrier) : Carrier :=
  let fallback := atomAt .empty
  match direction with
  | .material history => atomAt history
  | .sibling =>
      parallelAt (firstChildOr fallback children)
        (secondChildOr fallback children)
  | .dependent =>
      jointAt (firstChildOr fallback children)
        (secondChildOr fallback children)
  | .phase => shiftAt (firstChildOr fallback children)
  | .dual => dualAt (firstChildOr fallback children)
  | .frontier =>
      cofiberAt (firstChildOr fallback children)
        (secondChildOr fallback children)

/-- Universal fold out of the derived-incidence grammar. -/
def fold
    {Carrier : Type u}
    (atomAt : UnitHistory → Carrier)
    (parallelAt jointAt : Carrier → Carrier → Carrier)
    (shiftAt dualAt : Carrier → Carrier)
    (cofiberAt : Carrier → Carrier → Carrier) :
    DerivedArithmeticOccurrence → Carrier :=
  RootedAccountedUnfolding.fold
    (foldAlgebra atomAt parallelAt jointAt shiftAt dualAt cofiberAt)

/-- Initiality now comes directly from the sole occurrence constructor. -/
theorem fold_unique
    {Carrier : Type u}
    (atomAt : UnitHistory → Carrier)
    (parallelAt jointAt : Carrier → Carrier → Carrier)
    (shiftAt dualAt : Carrier → Carrier)
    (cofiberAt : Carrier → Carrier → Carrier)
    (candidate : DerivedArithmeticOccurrence → Carrier)
    (commutes :
      (direction : DerivedArithmeticDirection) →
      (branches : AccountedBranches DerivedArithmeticDirection) →
      candidate (.occur direction branches) =
        foldAlgebra atomAt parallelAt jointAt shiftAt dualAt cofiberAt
          direction (RootedAccountedUnfolding.candidateValues candidate branches)) :
    (occurrence : DerivedArithmeticOccurrence) →
      candidate occurrence =
        fold atomAt parallelAt jointAt shiftAt dualAt cofiberAt occurrence :=
  RootedAccountedUnfolding.fold_unique
    (foldAlgebra atomAt parallelAt jointAt shiftAt dualAt cofiberAt)
      candidate commutes

/-- In a stable grammar, a fibre is the shifted cofiber of the same map. -/
def fiber (source target : DerivedArithmeticOccurrence) :
    DerivedArithmeticOccurrence :=
  .shift (.cofiber source target)

/-- A grade is generated by an unindexed unit history of shifts, not by a
primitive integer degree. -/
def graded : UnitHistory → DerivedArithmeticOccurrence →
    DerivedArithmeticOccurrence
  | .empty, occurrence => occurrence
  | .next prior, occurrence => .shift (graded prior occurrence)

@[simp] theorem graded_empty (occurrence : DerivedArithmeticOccurrence) :
    graded .empty occurrence = occurrence :=
  rfl

@[simp] theorem graded_next
    (degree : UnitHistory) (occurrence : DerivedArithmeticOccurrence) :
    graded (.next degree) occurrence = .shift (graded degree occurrence) :=
  rfl

/-- Additive K₀/Euler shadow. -/
def eulerShadow : DerivedArithmeticOccurrence → Int :=
  fold (fun history => history.cardinalShadow)
    (· + ·) (· * ·) Neg.neg (fun value => value)
    (fun source target => target - source)

@[simp] theorem eulerShadow_atom (history : UnitHistory) :
    eulerShadow (.atom history) = history.cardinalShadow :=
  by
    simp [eulerShadow, fold, atom, RootedAccountedUnfolding.zero,
      RootedAccountedUnfolding.fold, foldAlgebra]

@[simp] theorem eulerShadow_parallel (left right) :
    eulerShadow (.parallel left right) =
      eulerShadow left + eulerShadow right :=
  by
    simp [eulerShadow, fold, parallel, RootedAccountedUnfolding.parallelAt,
      RootedAccountedUnfolding.fold, RootedAccountedUnfolding.foldBranches,
      foldAlgebra, firstChildOr, secondChildOr, AccountedBranches.singleton]

@[simp] theorem eulerShadow_joint (left right) :
    eulerShadow (.joint left right) =
      eulerShadow left * eulerShadow right :=
  by
    simp [eulerShadow, fold, joint,
      RootedAccountedUnfolding.fold, RootedAccountedUnfolding.foldBranches,
      foldAlgebra, firstChildOr, secondChildOr, AccountedBranches.singleton]

@[simp] theorem eulerShadow_shift (prior) :
    eulerShadow (.shift prior) = -eulerShadow prior :=
  by
    simp [eulerShadow, fold, shift,
      RootedAccountedUnfolding.fold, RootedAccountedUnfolding.foldBranches,
      foldAlgebra, firstChildOr, AccountedBranches.singleton]

@[simp] theorem eulerShadow_dual (prior) :
    eulerShadow (.dual prior) = eulerShadow prior :=
  by
    simp [eulerShadow, fold, dual,
      RootedAccountedUnfolding.fold, RootedAccountedUnfolding.foldBranches,
      foldAlgebra, firstChildOr, AccountedBranches.singleton]

@[simp] theorem eulerShadow_cofiber (source target) :
    eulerShadow (.cofiber source target) =
      eulerShadow target - eulerShadow source :=
  by
    simp [eulerShadow, fold, cofiber,
      RootedAccountedUnfolding.fold, RootedAccountedUnfolding.foldBranches,
      foldAlgebra, firstChildOr, secondChildOr, AccountedBranches.singleton]

@[simp] theorem eulerShadow_fiber (source target) :
    eulerShadow (fiber source target) =
      -(eulerShadow target - eulerShadow source) :=
  by simp [fiber]

@[simp] theorem eulerShadow_graded_next
    (degree : UnitHistory) (occurrence : DerivedArithmeticOccurrence) :
    eulerShadow (graded (.next degree) occurrence) =
      -eulerShadow (graded degree occurrence) :=
  by simp [graded]

/-- Multiplicative determinant shadow of the same free incidence syntax.
An actual determinant functor must separately prove that its constructor
laws realize this fold; `atomAt` is a readout, never authority. -/
def determinantShadow
    {Carrier : Type u} [CommGroup Carrier]
    (atomAt : UnitHistory → Carrier) :
    DerivedArithmeticOccurrence → Carrier :=
  fold atomAt (· * ·) (· * ·) Inv.inv
    Inv.inv
    (fun source target => target * source⁻¹)

@[simp] theorem determinantShadow_parallel
    {Carrier : Type u} [CommGroup Carrier]
    (atomAt : UnitHistory → Carrier) (left right) :
    determinantShadow atomAt (.parallel left right) =
      determinantShadow atomAt left * determinantShadow atomAt right :=
  by
    simp [determinantShadow, fold, parallel,
      RootedAccountedUnfolding.parallelAt,
      RootedAccountedUnfolding.fold, RootedAccountedUnfolding.foldBranches,
      foldAlgebra, firstChildOr, secondChildOr, AccountedBranches.singleton]

@[simp] theorem determinantShadow_joint
    {Carrier : Type u} [CommGroup Carrier]
    (atomAt : UnitHistory → Carrier) (left right) :
    determinantShadow atomAt (.joint left right) =
      determinantShadow atomAt left * determinantShadow atomAt right :=
  by
    simp [determinantShadow, fold, joint,
      RootedAccountedUnfolding.fold, RootedAccountedUnfolding.foldBranches,
      foldAlgebra, firstChildOr, secondChildOr, AccountedBranches.singleton]

@[simp] theorem determinantShadow_shift
    {Carrier : Type u} [CommGroup Carrier]
    (atomAt : UnitHistory → Carrier) (prior) :
    determinantShadow atomAt (.shift prior) =
      (determinantShadow atomAt prior)⁻¹ :=
  by
    simp [determinantShadow, fold, shift,
      RootedAccountedUnfolding.fold, RootedAccountedUnfolding.foldBranches,
      foldAlgebra, firstChildOr, AccountedBranches.singleton]

@[simp] theorem determinantShadow_dual
    {Carrier : Type u} [CommGroup Carrier]
    (atomAt : UnitHistory → Carrier) (prior) :
    determinantShadow atomAt (.dual prior) =
      (determinantShadow atomAt prior)⁻¹ :=
  by
    simp [determinantShadow, fold, dual,
      RootedAccountedUnfolding.fold, RootedAccountedUnfolding.foldBranches,
      foldAlgebra, firstChildOr, AccountedBranches.singleton]

@[simp] theorem determinantShadow_cofiber
    {Carrier : Type u} [CommGroup Carrier]
    (atomAt : UnitHistory → Carrier) (source target) :
    determinantShadow atomAt (.cofiber source target) =
      determinantShadow atomAt target *
        (determinantShadow atomAt source)⁻¹ :=
  by
    simp [determinantShadow, fold, cofiber,
      RootedAccountedUnfolding.fold, RootedAccountedUnfolding.foldBranches,
      foldAlgebra, firstChildOr, secondChildOr, AccountedBranches.singleton]

@[simp] theorem determinantShadow_fiber
    {Carrier : Type u} [CommGroup Carrier]
    (atomAt : UnitHistory → Carrier) (source target) :
    determinantShadow atomAt (fiber source target) =
      (determinantShadow atomAt target *
        (determinantShadow atomAt source)⁻¹)⁻¹ :=
  by simp [fiber]

end DerivedArithmeticOccurrence
end ArithmeticFreeClosure
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
