import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Analysis.Normed.Module.Basic
import H0mework.Realization.Integral.PrimeResidual

/-!
# Source-generated character-orbit integral face

A nonzero complex character value and a source vector canonically generate
the additive subgroup spanned by the full two-sided character orbit.  Its
inclusion into the ambient normed carrier is faithful, and both the forward
character action and its inverse restrict uniquely to this same integral
face.  No lattice, basis, discreteness, finiteness, or determinant witness is
chosen by a caller.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace SourceGeneratedCharacterOrbitIntegralFace

open SourceGeneratedFaithfulIntegralFace

noncomputable section

universe h

variable {H : Type h} [NormedAddCommGroup H] [NormedSpace ℂ H]

def orbitPoint (scalar : ℂˣ) (vector : H) (exponent : ℤ) : H :=
  ((scalar : ℂ) ^ exponent) • vector

/-- The canonical integral carrier generated by every positive and negative
character iterate. -/
def characterOrbit (scalar : ℂˣ) (vector : H) : AddSubgroup H :=
  AddSubgroup.closure (Set.range (orbitPoint scalar vector))

theorem orbitPoint_mem
    (scalar : ℂˣ) (vector : H) (exponent : ℤ) :
    orbitPoint scalar vector exponent ∈ characterOrbit scalar vector := by
  apply AddSubgroup.subset_closure
  exact ⟨exponent, rfl⟩

theorem forward_smul_mem
    (scalar : ℂˣ) (vector : H) {value : H}
    (membership : value ∈ characterOrbit scalar vector) :
    (scalar : ℂ) • value ∈ characterOrbit scalar vector := by
  refine AddSubgroup.closure_induction
    (p := fun current _ =>
      (scalar : ℂ) • current ∈ characterOrbit scalar vector)
    ?_ ?_ ?_ ?_ membership
  · intro current current_mem
    rcases current_mem with ⟨exponent, rfl⟩
    simpa [orbitPoint, smul_smul, zpow_add_one₀ scalar.ne_zero, mul_comm]
      using orbitPoint_mem scalar vector (exponent + 1)
  · simp
  · intro left right _ _ left_mem right_mem
    simpa only [smul_add] using
      (characterOrbit scalar vector).add_mem left_mem right_mem
  · intro current _ current_mem
    simpa only [smul_neg] using
      (characterOrbit scalar vector).neg_mem current_mem

theorem inverse_smul_mem
    (scalar : ℂˣ) (vector : H) {value : H}
    (membership : value ∈ characterOrbit scalar vector) :
    (scalar : ℂ)⁻¹ • value ∈ characterOrbit scalar vector := by
  refine AddSubgroup.closure_induction
    (p := fun current _ =>
      (scalar : ℂ)⁻¹ • current ∈ characterOrbit scalar vector)
    ?_ ?_ ?_ ?_ membership
  · intro current current_mem
    rcases current_mem with ⟨exponent, rfl⟩
    simpa [orbitPoint, smul_smul, zpow_sub_one₀ scalar.ne_zero, mul_comm]
      using orbitPoint_mem scalar vector (exponent - 1)
  · simp
  · intro left right _ _ left_mem right_mem
    simpa only [smul_add] using
      (characterOrbit scalar vector).add_mem left_mem right_mem
  · intro current _ current_mem
    simpa only [smul_neg] using
      (characterOrbit scalar vector).neg_mem current_mem

/-- The subgroup inclusion is the canonical faithful integral realization. -/
def orbitRealization (scalar : ℂˣ) (vector : H) :
    characterOrbit scalar vector →ₗ[ℤ] H where
  toFun := Subtype.val
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem orbitRealization_injective (scalar : ℂˣ) (vector : H) :
    Function.Injective (orbitRealization scalar vector) :=
  Subtype.val_injective

def orbitFace (scalar : ℂˣ) (vector : H) :
    FaithfulIntegralFace
      (L := characterOrbit scalar vector) (Ambient := H) where
  realization := orbitRealization scalar vector
  injective := orbitRealization_injective scalar vector

theorem forward_preservesFace (scalar : ℂˣ) (vector : H) :
    PreservesFace (orbitFace scalar vector)
      (complexScalarAction (scalar : ℂ)) := by
  intro value
  refine ⟨⟨(scalar : ℂ) • value.1,
    forward_smul_mem scalar vector value.2⟩, ?_⟩
  rfl

theorem inverse_preservesFace (scalar : ℂˣ) (vector : H) :
    PreservesFace (orbitFace scalar vector)
      (complexScalarAction (scalar : ℂ)⁻¹) := by
  intro value
  refine ⟨⟨(scalar : ℂ)⁻¹ • value.1,
    inverse_smul_mem scalar vector value.2⟩, ?_⟩
  rfl

def forwardActionLift (scalar : ℂˣ) (vector : H) :
    ActionLift (orbitFace scalar vector)
      (complexScalarAction (scalar : ℂ)) :=
  actionLiftOfPreserves _ _ (forward_preservesFace scalar vector)

def inverseActionLift (scalar : ℂˣ) (vector : H) :
    ActionLift (orbitFace scalar vector)
      (complexScalarAction (scalar : ℂ)⁻¹) :=
  actionLiftOfPreserves _ _ (inverse_preservesFace scalar vector)

theorem inverse_comp_forward
    (scalar : ℂˣ) (vector : H) :
    (inverseActionLift scalar vector).integralAction.comp
        (forwardActionLift scalar vector).integralAction = LinearMap.id := by
  apply LinearMap.ext
  intro value
  apply (orbitFace scalar vector).injective
  have forwardAt := LinearMap.congr_fun
    (forwardActionLift scalar vector).commutes value
  have inverseAt := LinearMap.congr_fun
    (inverseActionLift scalar vector).commutes
      ((forwardActionLift scalar vector).integralAction value)
  simp only [LinearMap.comp_apply, LinearMap.id_apply] at forwardAt inverseAt ⊢
  calc
    (orbitFace scalar vector).realization
        ((inverseActionLift scalar vector).integralAction
          ((forwardActionLift scalar vector).integralAction value)) =
        complexScalarAction (scalar : ℂ)⁻¹
          ((orbitFace scalar vector).realization
            ((forwardActionLift scalar vector).integralAction value)) := inverseAt
    _ = complexScalarAction (scalar : ℂ)⁻¹
        (complexScalarAction (scalar : ℂ)
          ((orbitFace scalar vector).realization value)) :=
      congrArg (complexScalarAction (Ambient := H) (scalar : ℂ)⁻¹) forwardAt
    _ = (orbitFace scalar vector).realization value := by
      simp [complexScalarAction_apply, smul_smul]

end
end SourceGeneratedCharacterOrbitIntegralFace
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
