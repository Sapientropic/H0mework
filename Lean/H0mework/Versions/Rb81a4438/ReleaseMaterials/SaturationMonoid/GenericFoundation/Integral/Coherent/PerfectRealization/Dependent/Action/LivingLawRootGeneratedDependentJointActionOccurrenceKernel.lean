import H0mework.Realization.JointState.ActionOccurrence
import H0mework.Versions.Rb81a4438.ReleaseMaterials.SaturationMonoid.GenericFoundation.Integral.Coherent.PerfectRealization.Dependent.LivingLawRootGeneratedDependentJointStateKernel

/-!
# Recovering one joint action occurrence from the existing dependent profile

The existing `JointActionData` stores an integral source action and a Hilbert
evolution while the dependent carrier stores the actual Hilbert measurement.
This adapter adds only a third measurement/q-rich action and readout, then
feeds all five actual maps to the canonical orbit constructor.  Each source
node therefore owns one minimal carrier and one `Ω`; the old integral,
coherent and measurement tables are literal dependent faces.

No commuting square, covariance, residual-zero or endpoint is an input.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace SourceGeneratedDependentJointActionOccurrence

open DependentCarrier
open SourceGeneratedDependentJointState
open SourceGeneratedIntegralEquivariantPerfectRealization
open SourceGeneratedIntegralCoherentJointAction

noncomputable section

universe s a c t l r h v d f q

variable {Source : Type s}
variable {Algebra : Source → Type a} {Combinatorial : Source → Type c}
variable {Topological : Source → Type t} {Logical : Source → Type l}
variable {Relation : Source → Type r} {Cochain : Source → Type h}
variable {Carrier : Source → Type v} {DualTarget : Source → Type d}
variable {ActualTarget : Source → Type f} {MeasurementTarget : Source → Type q}
variable [∀ source, AddCommGroup (Carrier source)]
variable [∀ source, AddCommGroup (DualTarget source)]
variable [∀ source, NormedAddCommGroup (ActualTarget source)]
variable [∀ source, InnerProductSpace ℂ (ActualTarget source)]
variable [∀ source, AddCommGroup (MeasurementTarget source)]

local notation "InputT" =>
  DependentCarrier.Input Source Algebra Combinatorial Topological Logical
    Relation Cochain Carrier DualTarget ActualTarget

/-- Raw third-face maps.  Their naturality is generated by the common orbit
carrier rather than stored here. -/
structure MeasurementProfile (input : InputT) where
  actionAt : ∀ source, MeasurementTarget source →ₗ[ℤ] MeasurementTarget source
  readAt : ∀ source, Carrier source →ₗ[ℤ] MeasurementTarget source

def coherentLinearAction (input : InputT) (profile : ActionProfile input)
    (source : Source) : ActualTarget source →ₗ[ℤ] ActualTarget source :=
  (profile.coherentEvolutionAt source).toLinearMap.restrictScalars ℤ

/-- The five old maps at one source node, now interpreted as the input of one
canonical joint action orbit. -/
def jointInputAt (input : InputT) (profile : ActionProfile input)
    (measurement : MeasurementProfile (MeasurementTarget := MeasurementTarget) input)
    (source : Source) :
    SourceGeneratedIntegralCoherentJointAction.Input
      (Carrier source) (ActualTarget source) (MeasurementTarget source) where
  integralAction := (profile.sourceActionAt source).carrierAction
  coherentAction := coherentLinearAction input profile source
  measurementAction := measurement.actionAt source
  coherentRead := input.faithfulAt source
  measurementRead := measurement.readAt source

abbrev JointActionPayload (input : InputT) (_profile : ActionProfile input)
    (_measurement : MeasurementProfile (MeasurementTarget := MeasurementTarget) input) :=
  Σ source : Source,
    SourceGeneratedIntegralCoherentJointAction.Input
      (Carrier source) (ActualTarget source) (MeasurementTarget source)

/-- The old source occurrence is mapped once into actual joint-action inputs.
Every node canonically generates its orbit carrier and `Ω`. -/
def jointActionOccurrence (input : InputT) (profile : ActionProfile input)
    (measurement : MeasurementProfile (MeasurementTarget := MeasurementTarget) input) :
    RootedAccountedUnfolding (JointActionPayload input profile measurement) :=
  input.occurrence.map fun source =>
    ⟨source, jointInputAt input profile measurement source⟩

theorem jointActionOccurrence_rooted (input : InputT)
    (profile : ActionProfile input)
    (measurement : MeasurementProfile (MeasurementTarget := MeasurementTarget) input) :
    (jointActionOccurrence input profile measurement).map Sigma.fst =
      input.occurrence := by
  rw [jointActionOccurrence, RootedAccountedUnfolding.map_map]
  exact RootedAccountedUnfolding.map_id input.occurrence

@[simp] theorem jointInputAt_integralAction (input : InputT)
    (profile : ActionProfile input)
    (measurement : MeasurementProfile (MeasurementTarget := MeasurementTarget) input)
    (source : Source) :
    (jointInputAt input profile measurement source).integralAction =
      (profile.sourceActionAt source).carrierAction :=
  rfl

@[simp] theorem jointInputAt_coherentAction (input : InputT)
    (profile : ActionProfile input)
    (measurement : MeasurementProfile (MeasurementTarget := MeasurementTarget) input)
    (source : Source) :
    (jointInputAt input profile measurement source).coherentAction =
      coherentLinearAction input profile source :=
  rfl

@[simp] theorem jointInputAt_coherentRead (input : InputT)
    (profile : ActionProfile input)
    (measurement : MeasurementProfile (MeasurementTarget := MeasurementTarget) input)
    (source : Source) :
    (jointInputAt input profile measurement source).coherentRead =
      input.faithfulAt source :=
  rfl

@[simp] theorem jointInputAt_measurementAction (input : InputT)
    (profile : ActionProfile input)
    (measurement : MeasurementProfile (MeasurementTarget := MeasurementTarget) input)
    (source : Source) :
    (jointInputAt input profile measurement source).measurementAction =
      measurement.actionAt source :=
  rfl

@[simp] theorem jointInputAt_measurementRead (input : InputT)
    (profile : ActionProfile input)
    (measurement : MeasurementProfile (MeasurementTarget := MeasurementTarget) input)
    (source : Source) :
    (jointInputAt input profile measurement source).measurementRead =
      measurement.readAt source :=
  rfl

/-- The old `JointActionData` is the integral/coherent restriction of the new
joint input, not an independently reconstructed pair. -/
theorem jointInputAt_reads_existingJointAction (input : InputT)
    (profile : ActionProfile input)
    (measurement : MeasurementProfile (MeasurementTarget := MeasurementTarget) input)
    (source : Source) :
    (jointInputAt input profile measurement source).integralAction =
        (jointActionAt input profile source).sourceAction.carrierAction ∧
      (jointInputAt input profile measurement source).coherentAction =
        (jointActionAt input profile source).coherentEvolution.toLinearMap.restrictScalars ℤ :=
  ⟨rfl, rfl⟩

/-- Existing Hilbert coupling residual is exactly the coherent face of the
new joint incidence residual. -/
theorem incidenceResidual_coherent_eq_existing (input : InputT)
    (profile : ActionProfile input)
    (measurement : MeasurementProfile (MeasurementTarget := MeasurementTarget) input)
    (source : Source) (event : Carrier source) :
    let joint := jointInputAt input profile measurement source
    joint.coherentFace (joint.incidenceResidual event) =
      SourceGeneratedIntegralCoherentCovariance.couplingResidual
        (feature := input.faithfulAt source)
        { integralTransition := (profile.sourceActionAt source).carrierAction
          hilbertEvolution := profile.coherentEvolutionAt source }
        event :=
  rfl

end

end SourceGeneratedDependentJointActionOccurrence
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
