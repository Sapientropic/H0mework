import H0mework.Versions.Rb81a4438.ReleaseMaterials.SaturationMonoid.GenericFoundation.LivingLawRootGeneratedDependentCarrierAxiomFreeCore
import H0mework.Foundation.Cofinal.KernelCompletion

/-!
# Axiom-free interface for source-dependent cofinal faces

The interface records only the source-owned dependent carrier and the one
cofinal occurrence selected at its root.  Completion, perfectification,
determinant eligibility, and residual settlement are deliberately absent from
this layer; they are generated by the constructive producer.  Thus the
axiom-free core can name the universal contract without importing any domain
consumer or assuming a finite presentation.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace DependentCofinalAxiomFree

open CofinalKernelCompletion

noncomputable section

universe s a c t l r h v d f u

structure Input
    (Source : Type s)
    (Algebra : Source → Type a) (Combinatorial : Source → Type c)
    (Topological : Source → Type t) (Logical : Source → Type l)
    (Relation : Source → Type r) (Cochain : Source → Type h)
    (Carrier : Source → Type v) (DualTarget : Source → Type d)
    (ActualTarget : Source → Type f)
    [carrierAdd : ∀ source, AddCommGroup (Carrier source)]
    [dualAdd : ∀ source, AddCommGroup (DualTarget source)]
    [actualAdd : ∀ source, AddCommGroup (ActualTarget source)]
    (Generator : Source → Type u)
    (StageCarrier : Source → Nat → Type u)
    [generatorAdd : ∀ source, AddCommGroup (Generator source)]
    [stageAdd : ∀ source stage, AddCommGroup (StageCarrier source stage)]
    where
  base : DependentCarrier.Input Source Algebra Combinatorial Topological Logical
    Relation Cochain Carrier DualTarget ActualTarget
  cofinalOccurrence :
    RootedAccountedUnfolding
      (Source × AdditiveCofinalEvaluatorData
        (Generator base.occurrence.root)
        (StageCarrier base.occurrence.root))
  cofinal_root_alignment :
    cofinalOccurrence.map Prod.fst = base.occurrence

abbrev rootSource
    {Source : Type s}
    {Algebra : Source → Type a} {Combinatorial : Source → Type c}
    {Topological : Source → Type t} {Logical : Source → Type l}
    {Relation : Source → Type r} {Cochain : Source → Type h}
    {Carrier : Source → Type v} {DualTarget : Source → Type d}
    {ActualTarget : Source → Type f}
    [∀ source, AddCommGroup (Carrier source)]
    [∀ source, AddCommGroup (DualTarget source)]
    [∀ source, AddCommGroup (ActualTarget source)]
    {Generator : Source → Type u} {StageCarrier : Source → Nat → Type u}
    [∀ source, AddCommGroup (Generator source)]
    [∀ source stage, AddCommGroup (StageCarrier source stage)]
    (input : Input Source Algebra Combinatorial Topological Logical Relation
      Cochain Carrier DualTarget ActualTarget Generator StageCarrier) : Source :=
  input.base.occurrence.root

theorem root_alignment
    {Source : Type s}
    {Algebra : Source → Type a} {Combinatorial : Source → Type c}
    {Topological : Source → Type t} {Logical : Source → Type l}
    {Relation : Source → Type r} {Cochain : Source → Type h}
    {Carrier : Source → Type v} {DualTarget : Source → Type d}
    {ActualTarget : Source → Type f}
    [∀ source, AddCommGroup (Carrier source)]
    [∀ source, AddCommGroup (DualTarget source)]
    [∀ source, AddCommGroup (ActualTarget source)]
    {Generator : Source → Type u} {StageCarrier : Source → Nat → Type u}
    [∀ source, AddCommGroup (Generator source)]
    [∀ source stage, AddCommGroup (StageCarrier source stage)]
    (input : Input Source Algebra Combinatorial Topological Logical Relation
      Cochain Carrier DualTarget ActualTarget Generator StageCarrier) :
    input.cofinalOccurrence.map Prod.fst = input.base.occurrence :=
  input.cofinal_root_alignment

end
end DependentCofinalAxiomFree
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
