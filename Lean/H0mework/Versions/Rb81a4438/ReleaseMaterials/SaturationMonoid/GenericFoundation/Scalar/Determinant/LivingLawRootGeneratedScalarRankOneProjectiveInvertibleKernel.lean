import Mathlib.Algebra.Module.FinitePresentation
import Mathlib.LinearAlgebra.Contraction
import Mathlib.RingTheory.Flat.LocallyFree
import Mathlib.RingTheory.Localization.BaseChange
import Mathlib.RingTheory.LocalProperties.Exactness
import Mathlib.RingTheory.PicardGroup

/-!
# Scalar rank-one projective modules are invertible

Finite projectivity and stalkwise rank one generate the canonical perfect
evaluation.  The proof localizes the source dual, tensor product and
contraction together, proves the localized contraction is the ordinary
rank-one evaluation, and reflects bijectivity from maximal stalks.

No free basis, global frame, Picard trivialization or invertibility witness is
an input.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace SourceGeneratedScalarRankOneProjectiveInvertible

open Module TensorProduct

noncomputable section

universe r m

variable {R : Type r} [CommRing R]
variable {M : Type m} [AddCommGroup M] [Module R M]
variable [Module.Finite R M] [Module.Projective R M]

attribute [local instance] Module.finitePresentation_of_projective

section Localization

variable (S : Submonoid R)

/-- Localization of the dual generated by finite presentation. -/
noncomputable def dualLocalization :
    Module.Dual R M →ₗ[R]
      Module.Dual (Localization S) (LocalizedModule S M) :=
  IsLocalizedModule.mapExtendScalars S
    (LocalizedModule.mkLinearMap S M)
    (LocalizedModule.mkLinearMap S R)
    (Localization S)

local instance dualLocalization_isLocalizedModule :
    IsLocalizedModule S (dualLocalization (M := M) S) := by
  unfold dualLocalization
  infer_instance

/-- The dual and the carrier are localized inside the same tensor occurrence. -/
noncomputable def tensorLocalization :
    (Module.Dual R M ⊗[R] M) →ₗ[R]
      (Module.Dual (Localization S) (LocalizedModule S M) ⊗[R]
        LocalizedModule S M) :=
  TensorProduct.map (dualLocalization (M := M) S)
    (LocalizedModule.mkLinearMap S M)

local instance tensorLocalization_isLocalizedModule :
    IsLocalizedModule S (tensorLocalization (M := M) S) := by
  unfold tensorLocalization
  infer_instance

/-- Evaluation on the localized tensor, with the tensor base ring restored
before applying the canonical contraction. -/
noncomputable def localizedEvaluation :
    (Module.Dual (Localization S) (LocalizedModule S M) ⊗[R]
      LocalizedModule S M) →ₗ[Localization S] Localization S :=
  contractLeft (Localization S) (LocalizedModule S M) ∘ₗ
    (IsLocalization.moduleTensorEquiv S (Localization S)
      (Module.Dual (Localization S) (LocalizedModule S M))
      (LocalizedModule S M)).symm.toLinearMap

omit [Module.Finite R M] [Module.Projective R M] in
/-- Localized evaluation literally reads the localization of global
evaluation on pure tensors. -/
theorem localizedEvaluation_comp_tensorLocalization :
    (localizedEvaluation (M := M) S).restrictScalars R ∘ₗ
        tensorLocalization (M := M) S =
      LocalizedModule.mkLinearMap S R ∘ₗ contractLeft R M := by
  ext f m
  change (dualLocalization (M := M) S f)
      (LocalizedModule.mk m 1) = LocalizedModule.mk (f m) 1
  rw [dualLocalization, IsLocalizedModule.mapExtendScalars_apply_apply]
  simpa only [LocalizedModule.mkLinearMap_apply] using
    IsLocalizedModule.map_apply S
      (LocalizedModule.mkLinearMap S M)
      (LocalizedModule.mkLinearMap S R) f m

/-- The source-generated localized evaluation is exactly the canonical
localized map of the global contraction. -/
theorem localizedEvaluation_eq_map :
    (localizedEvaluation (M := M) S).restrictScalars R =
      IsLocalizedModule.map S (tensorLocalization (M := M) S)
        (LocalizedModule.mkLinearMap S R) (contractLeft R M) := by
  apply IsLocalizedModule.linearMap_ext S (tensorLocalization (M := M) S)
    (LocalizedModule.mkLinearMap S R)
  rw [localizedEvaluation_comp_tensorLocalization]
  exact (IsLocalizedModule.map_comp S (tensorLocalization (M := M) S)
    (LocalizedModule.mkLinearMap S R) (contractLeft R M)).symm

omit [Module.Finite R M] [Module.Projective R M] in
/-- A free rank-one localized carrier has bijective canonical evaluation. -/
theorem localizedEvaluation_bijective_of_finrank_eq_one
    [Nontrivial (Localization S)]
    [Module.Free (Localization S) (LocalizedModule S M)]
    (rankOne : Module.finrank (Localization S) (LocalizedModule S M) = 1) :
    Function.Bijective (localizedEvaluation (M := M) S) := by
  let equivalence : Localization S ≃ₗ[Localization S] LocalizedModule S M :=
    (Module.nonempty_linearEquiv_of_finrank_eq_one rankOne).some
  haveI : Module.Invertible (Localization S) (LocalizedModule S M) :=
    Module.Invertible.congr equivalence
  exact Module.Invertible.bijective.comp
    (IsLocalization.moduleTensorEquiv S (Localization S)
      (Module.Dual (Localization S) (LocalizedModule S M))
      (LocalizedModule S M)).symm.bijective

/-- The ordinary localized global contraction is bijective whenever the
localized carrier has rank one. -/
theorem localizedContract_bijective_of_finrank_eq_one
    [Nontrivial (Localization S)]
    [Module.Free (Localization S) (LocalizedModule S M)]
    (rankOne : Module.finrank (Localization S) (LocalizedModule S M) = 1) :
    Function.Bijective (LocalizedModule.map S (contractLeft R M)) := by
  rw [LocalizedModule.coe_map_eq
    (tensorLocalization (M := M) S)
    (LocalizedModule.mkLinearMap S R)
    (contractLeft R M)]
  rw [← localizedEvaluation_eq_map (M := M) S]
  exact (IsLocalizedModule.iso S (LocalizedModule.mkLinearMap S R)).symm.bijective.comp
    ((localizedEvaluation_bijective_of_finrank_eq_one (M := M) S rankOne).comp
      (IsLocalizedModule.iso S (tensorLocalization (M := M) S)).bijective)

end Localization

/-- A finite projective module whose actual stalk rank is constantly one is
canonically invertible. -/
theorem finiteProjectiveRankOne_invertible
    (rankOne : Module.rankAtStalk M = fun _ : PrimeSpectrum R => 1) :
    Module.Invertible R M where
  bijective := by
    apply bijective_of_localized_maximal (contractLeft R M)
    intro maximal maximalIsMaximal
    letI : Module.Free (Localization.AtPrime maximal)
        (LocalizedModule maximal.primeCompl M) :=
      Module.free_of_flat_of_isLocalRing
    apply localizedContract_bijective_of_finrank_eq_one (M := M) maximal.primeCompl
    exact congrFun rankOne ⟨maximal, maximalIsMaximal.isPrime⟩

end
end SourceGeneratedScalarRankOneProjectiveInvertible
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
