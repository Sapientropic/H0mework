import H0mework.Realization.Topology.GramDisposition

/-!
# Multiplicative centered Gram rigidity

If a multiplicative complex character is the normalized same-state matrix
coefficient of an isometric group action, inverse covariance and Hermitian
symmetry force unit modulus.  Nonzero state is generated by the identity
readback rather than supplied as a premise.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace SourceGeneratedCenteredGram

open scoped InnerProductSpace

noncomputable section

universe g h

variable {G : Type g} [Group G]
variable {H : Type h} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

def normalizedMatrixCoefficient
    (action : G →* (H ≃ₗᵢ[ℂ] H)) (state : H) (element : G) : ℂ :=
  inner ℂ state (action element state) / (((‖state‖ ^ 2 : ℝ) : ℂ))

theorem normalizedMatrixCoefficient_inv_eq_star
    (action : G →* (H ≃ₗᵢ[ℂ] H)) (state : H)
    (element : G) :
    normalizedMatrixCoefficient action state element⁻¹ =
      star (normalizedMatrixCoefficient action state element) := by
  have inverseAction : action element⁻¹ = (action element).symm := by
    have generated := action.map_inv element
    change action element⁻¹ = (action element).symm at generated
    exact generated
  have numerator :
      inner ℂ state (action element⁻¹ state) =
        star (inner ℂ state (action element state)) := by
    rw [inverseAction]
    calc
      inner ℂ state ((action element).symm state) =
          inner ℂ (action element state) state :=
        (LinearIsometryEquiv.inner_map_eq_flip
          (action element) state state).symm
      _ = star (inner ℂ state (action element state)) :=
        (inner_conj_symm (action element state) state).symm
  unfold normalizedMatrixCoefficient
  rw [numerator]
  simp

theorem state_ne_zero_of_multiplicative_normalizedMatrixCoefficient
    (action : G →* (H ≃ₗᵢ[ℂ] H)) (state : H)
    (character : G →* ℂ)
    (readback : ∀ element,
      character element = normalizedMatrixCoefficient action state element) :
    state ≠ 0 := by
  intro stateZero
  subst state
  have atOne := readback (1 : G)
  have characterOne : character (1 : G) = 1 := map_one character
  have coefficientZero :
      normalizedMatrixCoefficient action (0 : H) (1 : G) = 0 := by
    simp [normalizedMatrixCoefficient]
  rw [characterOne, coefficientZero] at atOne
  exact one_ne_zero atOne

theorem multiplicative_normalizedMatrixCoefficient_norm_eq_one
    (action : G →* (H ≃ₗᵢ[ℂ] H))
    (state : H) (character : G →* ℂ)
    (readback : ∀ element,
      character element = normalizedMatrixCoefficient action state element)
    (element : G) :
    ‖character element‖ = 1 := by
  have inverseReadback :
      character element⁻¹ = star (character element) := by
    rw [readback, readback]
    exact normalizedMatrixCoefficient_inv_eq_star action state element
  have characterInverse :
      character element⁻¹ = (character element)⁻¹ :=
    map_inv character element
  have inverseEqStar :
      (character element)⁻¹ = star (character element) := by
    rw [← characterInverse]
    exact inverseReadback
  have characterNonzero : character element ≠ 0 := by
    intro zero
    have inverseProduct :
        character element⁻¹ * character element = 1 := by
      calc
        _ = character (element⁻¹ * element) :=
          (character.map_mul element⁻¹ element).symm
        _ = 1 := by simp
    rw [zero, mul_zero] at inverseProduct
    exact zero_ne_one inverseProduct
  have productOne :
      character element * star (character element) = 1 := by
    rw [← inverseEqStar, mul_inv_cancel₀ characterNonzero]
  have normSqOneComplex :
      ((Complex.normSq (character element) : ℝ) : ℂ) = 1 := by
    rw [← Complex.mul_conj]
    exact productOne
  have normSqOne : Complex.normSq (character element) = 1 := by
    exact_mod_cast normSqOneComplex
  have normSquare : ‖character element‖ ^ 2 = 1 := by
    rw [Complex.sq_norm]
    exact normSqOne
  nlinarith [norm_nonneg (character element)]

end

end SourceGeneratedCenteredGram
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
