import H0mework.Versions.Rb81a4438.ReleaseMaterials.SaturationMonoid.LivingLawArithmeticFreeClosureKernel
import H0mework.Foundation.Arithmetic.RootIncidence

/-!
# Obstruction-generated ordinary arithmetic completion

An exact rooted incidence residual is itself the sole new direction of a free
ordinary closure.  The completion does not choose a named number system and
does not invoke U8: its syntax stays in the existing arithmetic grammar, while
the same root occurrence supplies the whole-ledger write-back and next current.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace RootArithmeticCompletion

open ArithmeticGeneration
open ArithmeticFreeClosure
open ArithmeticFreeClosure.DerivedArithmeticOccurrence
open RootArithmeticIncidence

universe u v

/-- The only legal ordinary-completion directions are exact residuals emitted
by this fixed incidence step. -/
inductive GeneratedArithmeticClosureDirectionAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (step : RootArithmeticIncidenceStepAt recognition visit) : Type
  | parallel
      (residual : GeneratedParallelResidualAt step step.material)
  | joint
      (residual : GeneratedJointResidualAt step step.material)

abbrev FreeArithmeticCompletionAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (step : RootArithmeticIncidenceStepAt recognition visit) :=
  FreeClosureAt UnitHistory (GeneratedArithmeticClosureDirectionAt step)

/-- Zero-field receipt of the unique free completion generated by one exact
residual direction. -/
structure RootArithmeticCompletionReceiptAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (step : RootArithmeticIncidenceStepAt recognition visit)
    (direction : GeneratedArithmeticClosureDirectionAt step) : Type where
  private mk ::

/-- The obstruction generates its minimal ordinary completion.  The caller
cannot provide a carrier, result, interpretation, branch, ledger, or next. -/
def sourceGeneratedMinimalClosure
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    (direction : GeneratedArithmeticClosureDirectionAt step) :
    RootArithmeticCompletionReceiptAt step direction :=
  ⟨⟩

namespace RootArithmeticCompletionReceiptAt

def expectedHistory
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    (direction : GeneratedArithmeticClosureDirectionAt step) : UnitHistory :=
  match direction with
  | .parallel _ => step.material.left.parallel step.material.right
  | .joint _ => step.material.left.joint step.material.right

/-- The generated node is an actual extension, never a stalled bare carrier. -/
def completionNode
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    (_receipt : RootArithmeticCompletionReceiptAt step direction) :
    FreeArithmeticCompletionAt step :=
  .extend direction (.base (expectedHistory direction))

@[simp] theorem completionNode_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    (receipt : RootArithmeticCompletionReceiptAt step direction) :
    receipt.completionNode =
      FreeClosureAt.extend direction (.base (expectedHistory direction)) :=
  rfl

theorem completionNode_ne_base
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    (receipt : RootArithmeticCompletionReceiptAt step direction)
    (history : UnitHistory) :
    receipt.completionNode ≠ FreeClosureAt.base history := by
  intro equality
  cases equality

/-- Internal stable cofiber syntax generated by the same residual.  Public
consumers receive it only through the receipt-indexed dependent face below. -/
private def derivedCorrectionSyntax
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    (_receipt : RootArithmeticCompletionReceiptAt step direction) :
    DerivedArithmeticOccurrence :=
  match direction with
  | .parallel _ =>
      .cofiber
        (.parallel (.atom step.material.left) (.atom step.material.right))
        (.atom step.material.whole)
  | .joint _ =>
      .cofiber
        (.joint (.atom step.material.left) (.atom step.material.right))
        (.atom step.material.whole)

/-- Complete ledger write-back remains the one already generated by the
obstructed occurrence. -/
def wholeLedgerWriteBack
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    (_receipt : RootArithmeticCompletionReceiptAt step direction) :=
  step.wholeLedgerWriteBack

/-- Ordinary closure cannot select or refill the next current. -/
def nextCurrent
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    (_receipt : RootArithmeticCompletionReceiptAt step direction) :
    SourceNativeAuthoritativeRootCurrentAt N :=
  step.nextCurrent

@[simp] theorem nextCurrent_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    (receipt : RootArithmeticCompletionReceiptAt step direction) :
    receipt.nextCurrent = root.generatedNextCurrentAt visit :=
  rfl

/-- A domain realization is only the forced fold of the free carrier. -/
def realize
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    (_receipt : RootArithmeticCompletionReceiptAt step direction)
    {Carrier : Type v}
    (baseAt : UnitHistory → Carrier)
    (extendAt : GeneratedArithmeticClosureDirectionAt step →
      Carrier → Carrier) : Carrier :=
  FreeClosureAt.fold baseAt extendAt
    _receipt.completionNode

/-- Universal factorization of every faithful realization. -/
theorem realize_unique
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    (receipt : RootArithmeticCompletionReceiptAt step direction)
    {Carrier : Type v}
    (baseAt : UnitHistory → Carrier)
    (extendAt : GeneratedArithmeticClosureDirectionAt step →
      Carrier → Carrier)
    (candidate : FreeArithmeticCompletionAt step → Carrier)
    (base_commutes : (history : UnitHistory) →
      candidate (.base history) = baseAt history)
    (extend_commutes :
      (generatedDirection : GeneratedArithmeticClosureDirectionAt step) →
      (prior : FreeArithmeticCompletionAt step) →
      candidate (.extend generatedDirection prior) =
        extendAt generatedDirection (candidate prior)) :
    candidate receipt.completionNode =
      receipt.realize baseAt extendAt :=
  FreeClosureAt.fold_unique baseAt extendAt candidate base_commutes
    extend_commutes receipt.completionNode

theorem unique
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    (left right : RootArithmeticCompletionReceiptAt step direction) :
    left = right := by
  cases left
  cases right
  rfl

end RootArithmeticCompletionReceiptAt

/-- Dependent stable-incidence face of one exact completion receipt. -/
structure RootDerivedArithmeticOccurrenceAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    (receipt : RootArithmeticCompletionReceiptAt step direction) : Type where
  private mk ::

def RootArithmeticCompletionReceiptAt.derivedOccurrence
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    (receipt : RootArithmeticCompletionReceiptAt step direction) :
    RootDerivedArithmeticOccurrenceAt receipt :=
  ⟨⟩

namespace RootDerivedArithmeticOccurrenceAt

def occurrence
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    {receipt : RootArithmeticCompletionReceiptAt step direction}
    (_face : RootDerivedArithmeticOccurrenceAt receipt) :
    DerivedArithmeticOccurrence :=
  receipt.derivedCorrectionSyntax

def wholeLedgerWriteBack
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    {receipt : RootArithmeticCompletionReceiptAt step direction}
    (_face : RootDerivedArithmeticOccurrenceAt receipt) :=
  receipt.wholeLedgerWriteBack

def nextCurrent
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    {receipt : RootArithmeticCompletionReceiptAt step direction}
    (_face : RootDerivedArithmeticOccurrenceAt receipt) :
    SourceNativeAuthoritativeRootCurrentAt N :=
  receipt.nextCurrent

theorem unique
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeRootArithmeticIncidenceRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {step : RootArithmeticIncidenceStepAt recognition visit}
    {direction : GeneratedArithmeticClosureDirectionAt step}
    {receipt : RootArithmeticCompletionReceiptAt step direction}
    (left right : RootDerivedArithmeticOccurrenceAt receipt) :
    left = right := by
  cases left
  cases right
  rfl

end RootDerivedArithmeticOccurrenceAt
end RootArithmeticCompletion
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
