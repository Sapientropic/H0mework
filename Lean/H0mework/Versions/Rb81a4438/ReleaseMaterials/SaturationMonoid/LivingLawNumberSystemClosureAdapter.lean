/-!
# Source-generated number-system closure

The familiar number systems are read here through their universal maps and
their exact generating constructions.  No declaration stores a completed
answer: integers are formal balances, rationals are nonzero-denominator
ratios, real points are generated from a recursive rational Cauchy lineage,
and a complex rotation is the unique algebra extension of a root of
`J * J = -1`.

This is an explicit Mathlib adapter.  It provides mathematical provenance;
it does not by itself install a world-authority face.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NumberSystemClosure

open ArithmeticFreeClosure
open ArithmeticProcess

/-! ## Canonical embeddings and their universal uniqueness -/

def naturalEmbedding (R : Type*) [NonAssocSemiring R] : Nat →+* R :=
  Nat.castRingHom R

theorem naturalEmbedding_unique
    {R : Type*} [NonAssocSemiring R] (candidate : Nat →+* R) :
    candidate = naturalEmbedding R :=
  RingHom.eq_natCast' candidate

def integerEmbedding (R : Type*) [NonAssocRing R] : Int →+* R :=
  Int.castRingHom R

theorem integerEmbedding_unique
    {R : Type*} [NonAssocRing R] (candidate : Int →+* R) :
    candidate = integerEmbedding R :=
  RingHom.eq_intCast' candidate

def rationalEmbedding (K : Type*) [DivisionRing K] [CharZero K] : Rat →+* K :=
  Rat.castHom K

theorem rationalEmbedding_unique
    {K : Type*} [DivisionRing K] [CharZero K]
    (candidate : Rat →+* K) : candidate = rationalEmbedding K := by
  ext value
  exact eq_ratCast candidate value

/-- The actual prefix maps.  They are canonical morphisms, not choices of a
number or of a future extension. -/
def naturalToInteger : Nat →+* Int := naturalEmbedding Int
def integerToRational : Int →+* Rat := integerEmbedding Rat
noncomputable def rationalToReal : Rat →+* Real := rationalEmbedding Real
def realToComplex : Real →+* Complex := Complex.ofRealHom

/-! ## Formal difference and ratio generation -/

/-- An integer is generated as an oriented balance.  Negative values are
the readout of an outstanding right-hand amount, not a new primitive kind of
object. -/
def integerBalance (credit debt : Nat) : Int :=
  (credit : Int) - (debt : Int)

/-- Standard integer presentation as one faithful fold of the generic free
closure grammar.  The core grammar itself does not name integers. -/
def integerClosureNode (credit debt : Nat) : FreeClosureAt Nat Nat :=
  .extend debt (.base credit)

/-- The integer presentation is generated by the same free process used by
every arithmetic closure; `Int` is only its standard readout. -/
def integerClosureProcess (credit debt : Nat) :
    SourceGeneratedFreeClosureProcessAt (integerClosureNode credit debt) :=
  compileFreeClosure (integerClosureNode credit debt)

def integerClosureReadout : FreeClosureAt Nat Nat → Int :=
  FreeClosureAt.fold (fun credit => (credit : Int))
    (fun debt prior => prior - debt)

@[simp] theorem integerClosureReadout_node (credit debt : Nat) :
    integerClosureReadout (integerClosureNode credit debt) =
      integerBalance credit debt :=
  rfl

/-- Adding the same settled amount to both sides cannot change the balance. -/
theorem integerBalance_add_common (credit debt settled : Nat) :
    integerBalance (credit + settled) (debt + settled) =
      integerBalance credit debt := by
  simp only [integerBalance, Nat.cast_add]
  omega

/-- Every integer is generated by a finite positive/negative balance. -/
theorem integerBalance_surjective :
    Function.Surjective (fun pair : Nat × Nat =>
      integerBalance pair.1 pair.2) := by
  intro value
  cases value with
  | ofNat natural =>
      exact ⟨(natural, 0), by simp [integerBalance]⟩
  | negSucc natural =>
      exact ⟨(0, natural + 1), by simp [integerBalance]; omega⟩

/-- Equality of formal balances is exactly the Grothendieck cross-balance
relation; no representative carries extra authority. -/
theorem integerBalance_eq_iff
    (leftCredit leftDebt rightCredit rightDebt : Nat) :
    integerBalance leftCredit leftDebt =
        integerBalance rightCredit rightDebt ↔
      leftCredit + rightDebt = rightCredit + leftDebt := by
  simp only [integerBalance]
  omega

/-- A rational is generated from an integer numerator and a certified
nonzero natural denominator.  The result is computed from those inputs and
is not accepted as a field. -/
def rationalRatio
    (numerator : Int) (denominator : Nat)
    (_denominator_ne_zero : denominator ≠ 0) : Rat :=
  (numerator : Rat) / (denominator : Rat)

structure NonzeroDenominator : Type where
  value : Nat
  ne_zero : value ≠ 0

def rationalClosureNode
    (numerator : Int) (denominator : Nat)
    (denominator_ne_zero : denominator ≠ 0) :
    FreeClosureAt Int NonzeroDenominator :=
  .extend ⟨denominator, denominator_ne_zero⟩ (.base numerator)

def rationalClosureProcess
    (numerator : Int) (denominator : Nat)
    (denominator_ne_zero : denominator ≠ 0) :
    SourceGeneratedFreeClosureProcessAt
      (rationalClosureNode numerator denominator denominator_ne_zero) :=
  compileFreeClosure
    (rationalClosureNode numerator denominator denominator_ne_zero)

def rationalClosureReadout :
    FreeClosureAt Int NonzeroDenominator → Rat :=
  FreeClosureAt.fold (fun numerator => (numerator : Rat))
    (fun denominator prior => prior / (denominator.value : Rat))

@[simp] theorem rationalClosureReadout_node
    (numerator : Int) (denominator : Nat)
    (denominator_ne_zero : denominator ≠ 0) :
    rationalClosureReadout
        (rationalClosureNode numerator denominator denominator_ne_zero) =
      rationalRatio numerator denominator denominator_ne_zero :=
  rfl

/-- Every rational is generated by its canonical integer numerator and
positive natural denominator. -/
theorem rationalRatio_surjective :
    ∀ value : Rat, ∃ numerator denominator denominator_ne_zero,
      rationalRatio numerator denominator denominator_ne_zero = value := by
  intro value
  exact ⟨value.num, value.den, value.den_nz, value.num_div_den⟩

/-- Ratio equality is precisely cross multiplication.  Equivalent
representatives cannot hide another rational value. -/
theorem rationalRatio_eq_iff_cross
    (leftNumerator rightNumerator : Int)
    (leftDenominator rightDenominator : Nat)
    (left_ne_zero : leftDenominator ≠ 0)
    (right_ne_zero : rightDenominator ≠ 0) :
    rationalRatio leftNumerator leftDenominator left_ne_zero =
        rationalRatio rightNumerator rightDenominator right_ne_zero ↔
      leftNumerator * (rightDenominator : Int) =
        rightNumerator * (leftDenominator : Int) := by
  unfold rationalRatio
  rw [div_eq_div_iff]
  · norm_cast
  · exact_mod_cast left_ne_zero
  · exact_mod_cast right_ne_zero

/-! ## Recursive rational lineage and real completion -/

/-- Values generated by one seed and one local recurrence.  There is no
field `Nat → Rat` which could contain a completed decimal tape. -/
def rationalLineageAt
    (initial : Rat) (advance : Nat → Rat → Rat) : Nat → Rat
  | 0 => initial
  | index + 1 => advance index (rationalLineageAt initial advance index)

/-- A source-generated Cauchy law consists only of its seed, local recurrence
and the mathematical proof that the recursively generated lineage is Cauchy. -/
structure SourceGeneratedRationalCauchyLaw : Type where
  private mk ::
  initial : Rat
  advance : Nat → Rat → Rat
  cauchy : IsCauSeq (abs : Rat → Rat)
    (rationalLineageAt initial advance)

def SourceGeneratedRationalCauchyLaw.create
    (initial : Rat) (advance : Nat → Rat → Rat)
    (cauchy : IsCauSeq (abs : Rat → Rat)
      (rationalLineageAt initial advance)) :
    SourceGeneratedRationalCauchyLaw :=
  ⟨initial, advance, cauchy⟩

namespace SourceGeneratedRationalCauchyLaw

def generatedAt (law : SourceGeneratedRationalCauchyLaw) (index : Nat) : Rat :=
  rationalLineageAt law.initial law.advance index

@[simp] theorem generatedAt_zero (law : SourceGeneratedRationalCauchyLaw) :
    law.generatedAt 0 = law.initial :=
  rfl

@[simp] theorem generatedAt_succ
    (law : SourceGeneratedRationalCauchyLaw) (index : Nat) :
    law.generatedAt (index + 1) = law.advance index (law.generatedAt index) :=
  rfl

def toCauSeq (law : SourceGeneratedRationalCauchyLaw) :
    CauSeq Rat (abs : Rat → Rat) :=
  ⟨law.generatedAt, law.cauchy⟩

/-- The real point is the quotient image of the generated lineage.  It is a
readout of the seed and recurrence, not a caller-supplied real result. -/
def realValue (law : SourceGeneratedRationalCauchyLaw) : Real :=
  Real.ofCauchy (CauSeq.Completion.mk law.toCauSeq)

theorem realValue_has_exact_completion
    (law : SourceGeneratedRationalCauchyLaw) :
    law.realValue.cauchy = CauSeq.Completion.mk law.toCauSeq :=
  rfl

end SourceGeneratedRationalCauchyLaw

def realClosureNode (law : SourceGeneratedRationalCauchyLaw) :
    FreeClosureAt Rat SourceGeneratedRationalCauchyLaw :=
  .extend law (.base law.initial)

def realClosureProcess (law : SourceGeneratedRationalCauchyLaw) :
    SourceGeneratedFreeClosureProcessAt (realClosureNode law) :=
  compileFreeClosure (realClosureNode law)

def realClosureReadout :
    FreeClosureAt Rat SourceGeneratedRationalCauchyLaw → Real :=
  FreeClosureAt.fold (fun value => (value : Real))
    (fun law _prior => law.realValue)

@[simp] theorem realClosureReadout_node
    (law : SourceGeneratedRationalCauchyLaw) :
    realClosureReadout (realClosureNode law) = law.realValue :=
  rfl

theorem rationalLineageAt_constant (value : Rat) (index : Nat) :
    rationalLineageAt value (fun _index _prior => value) index = value := by
  cases index <;> rfl

/-- Constant rational values enter the real completion through an actual
recursive lineage rather than through a bare real parameter. -/
def constantRationalCauchyLaw (value : Rat) :
    SourceGeneratedRationalCauchyLaw :=
  SourceGeneratedRationalCauchyLaw.create value
    (fun _index _prior => value) <| by
      intro epsilon epsilon_positive
      refine ⟨0, ?_⟩
      intro index _index_nonnegative
      rw [rationalLineageAt_constant, rationalLineageAt_constant,
        sub_self, abs_zero]
      exact epsilon_positive

theorem constantRationalCauchyLaw_realValue (value : Rat) :
    (constantRationalCauchyLaw value).realValue = (value : Real) := by
  apply Real.ext_cauchy
  change CauSeq.Completion.mk
      (constantRationalCauchyLaw value).toCauSeq = value
  apply CauSeq.Completion.mk_eq.mpr
  change CauSeq.LimZero
    ((constantRationalCauchyLaw value).toCauSeq -
      CauSeq.const (abs : Rat → Rat) value)
  have sequence_eq :
      (constantRationalCauchyLaw value).toCauSeq =
        CauSeq.const (abs : Rat → Rat) value := by
    apply CauSeq.ext
    intro index
    exact rationalLineageAt_constant value index
  rw [sequence_eq, sub_self]
  exact CauSeq.zero_limZero

/-- The real carrier has no hidden coordinate beyond rational Cauchy
completion: the two carriers are ring-equivalent. -/
def realCompletionPresentation :
    Real ≃+* CauSeq.Completion.Cauchy (abs : Rat → Rat) :=
  Real.ringEquivCauchy

/-! ## Rotation-generated complex extension -/

/-- Adjoin one direction whose square is `-1`.  The complete algebra map is
generated by that relation. -/
def rotationExtension
    {A : Type*} [Ring A] [Algebra Real A]
    (J : A) (rotation : J * J = -1) : Complex →ₐ[Real] A :=
  Complex.liftAux J rotation

theorem rotationExtension_maps_I
    {A : Type*} [Ring A] [Algebra Real A]
    (J : A) (rotation : J * J = -1) :
    rotationExtension J rotation Complex.I = J :=
  Complex.liftAux_apply_I J rotation

/-- No second algebra map can attach a different hidden outcome while
claiming the same generated rotation direction. -/
theorem rotationExtension_unique
    {A : Type*} [Ring A] [Algebra Real A]
    (J : A) (rotation : J * J = -1)
    (candidate : Complex →ₐ[Real] A)
    (maps_I : candidate Complex.I = J) :
    candidate = rotationExtension J rotation := by
  apply Complex.algHom_ext
  exact maps_I.trans (rotationExtension_maps_I J rotation).symm

/-- The familiar `i` is the canonical rotation generator, not an arbitrary
vertical bit. -/
theorem complex_I_is_rotation :
    Complex.I * Complex.I = -(1 : Complex) :=
  Complex.I_mul_I

/-- A complex point is the standard realization of one real base together
with one generated transverse coefficient. -/
def complexClosureNode (real imaginary : Real) :
    FreeClosureAt Real Real :=
  .extend imaginary (.base real)

def complexClosureProcess (real imaginary : Real) :
    SourceGeneratedFreeClosureProcessAt (complexClosureNode real imaginary) :=
  compileFreeClosure (complexClosureNode real imaginary)

def complexClosureReadout : FreeClosureAt Real Real → Complex :=
  FreeClosureAt.fold Complex.ofReal
    (fun imaginary prior =>
      prior + Complex.ofReal imaginary * Complex.I)

@[simp] theorem complexClosureReadout_node (real imaginary : Real) :
    complexClosureReadout (complexClosureNode real imaginary) =
      Complex.ofReal real + Complex.ofReal imaginary * Complex.I :=
  rfl

theorem complexClosureReadout_surjective :
    Function.Surjective complexClosureReadout := by
  intro value
  refine ⟨complexClosureNode value.re value.im, ?_⟩
  apply Complex.ext
  · simp [complexClosureReadout, complexClosureNode]
  · simp [complexClosureReadout, complexClosureNode]

end NumberSystemClosure
