import H0mework.Foundation.Arithmetic.ProductiveContinuation

/-!
# Productive fixed-root bounded arithmetic prefix

Pointwise productiveness is compiled into one finite dependent prefix.  Each
row is indexed by its generated position and contains the exact source emitter
occurrence, its canonical causal visit and complete ledger patch, the actual
root successor equation, the visit-generated unit history and its cardinal
shadow theorem, and the empty terminal fibre.

Each row is a zero-field position token.  A bounded prefix adds no authority
layer: it is just the dependent function `Fin fuel -> canonical row`.  The public
producer receives only the productive history and finite fuel; it cannot
accept a registration court, starting index, row, occurrence, branch outcome,
or completed `Nat -> State` future.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot

open RootArithmeticTerminalAuthority

universe u

/-- Canonical position token of a bounded productive fixed-root prefix. -/
inductive ProductiveFixedRootArithmeticPrefixRowAt
    {N : WorldRelationNetwork.{u}}
    {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    (history : ProductiveFiniteRootHistoryAt root.toLedgerRoot)
    (index : Nat) : Type (u + 12)
  | canonical

namespace ProductiveFixedRootArithmeticPrefixRowAt

/-- Generate one exact row from its position in the fixed-root history. -/
def generate
    {N : WorldRelationNetwork.{u}}
    {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    (history : ProductiveFiniteRootHistoryAt root.toLedgerRoot)
    (index : Nat) :
    ProductiveFixedRootArithmeticPrefixRowAt history index :=
  .canonical

/-- Exact temporal occurrence at this prefix position. -/
def causalVisit
    {N : WorldRelationNetwork.{u}}
    {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    {history : ProductiveFiniteRootHistoryAt root.toLedgerRoot}
    {index : Nat}
    (_row : ProductiveFixedRootArithmeticPrefixRowAt history index) :
    SourceNativeTemporalVisitGeneratedEvolutionAt
      root.toLedgerRoot (.finite (history.visitAt index)) :=
  root.toLedgerRoot.generatedAtTemporalVisit (.finite (history.visitAt index))

@[simp] theorem causalVisit_eq
    {N : WorldRelationNetwork.{u}}
    {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    {history : ProductiveFiniteRootHistoryAt root.toLedgerRoot}
    {index : Nat}
    (row : ProductiveFixedRootArithmeticPrefixRowAt history index) :
    row.causalVisit =
      root.toLedgerRoot.generatedAtTemporalVisit (.finite (history.visitAt index)) :=
  rfl

@[simp] theorem nextCurrent_eq
    {N : WorldRelationNetwork.{u}}
    {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    {history : ProductiveFiniteRootHistoryAt root.toLedgerRoot}
    {index : Nat}
    (_row : ProductiveFixedRootArithmeticPrefixRowAt history index) :
    (root.toRoot.evolutionAt (history.visitAt index).current).nextCurrent? =
      some (history.visitAt (index + 1)).current := by
  rw [history.visitAt_current, history.visitAt_current]
  exact history.next_eq index

/-- Actual arithmetic material generated by the visit's reachability proof.
The row does not store or accept a numeric index. -/
def arithmeticHistory
    {N : WorldRelationNetwork.{u}}
    {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    {history : ProductiveFiniteRootHistoryAt root.toLedgerRoot}
    {index : Nat}
    (_row : ProductiveFixedRootArithmeticPrefixRowAt history index) :
    ArithmeticGeneration.UnitHistory :=
  rootVisitArithmeticHistory (history.visitAt index)

/-- The old arithmetic index is a theorem about the actual history shadow,
not source data. -/
theorem arithmeticShadow_eq
    {N : WorldRelationNetwork.{u}}
    {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    {history : ProductiveFiniteRootHistoryAt root.toLedgerRoot}
    {index : Nat}
    (row : ProductiveFixedRootArithmeticPrefixRowAt history index) :
    row.arithmeticHistory.cardinalShadow = index :=
  history.visitAt_arithmeticIndex index

theorem arithmeticIndex_eq
    {N : WorldRelationNetwork.{u}}
    {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    {history : ProductiveFiniteRootHistoryAt root.toLedgerRoot}
    {index : Nat}
    (_row : ProductiveFixedRootArithmeticPrefixRowAt history index) :
    rootVisitArithmeticIndex (history.visitAt index) = index :=
  history.visitAt_arithmeticIndex index

/-- A productive row cannot be a generated arithmetic terminal. -/
theorem terminalEmpty
    {N : WorldRelationNetwork.{u}}
    {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    {history : ProductiveFiniteRootHistoryAt root.toLedgerRoot}
    {index : Nat}
    (_row : ProductiveFixedRootArithmeticPrefixRowAt history index) :
    IsEmpty (GeneratedRootArithmeticTerminalAt root (history.visitAt index)) :=
  history.noArithmeticTerminalAt index

/-- Every bounded arithmetic row is the exact fixed-history compiler image.
A hypothetical row cannot replace its occurrence, successor, or terminal
disposition while retaining the same history/index. -/
theorem eq_generated
    {N : WorldRelationNetwork.{u}}
    {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    {history : ProductiveFiniteRootHistoryAt root.toLedgerRoot}
    {index : Nat}
    (row : ProductiveFixedRootArithmeticPrefixRowAt history index) :
    row = generate history index := by
  cases row
  rfl

end ProductiveFixedRootArithmeticPrefixRowAt

/-- Bounded readout of canonical rows below one finite fuel bound.

The authority lives in each exact root-indexed row, not in another prefix
wrapper.  A finite observation window is therefore just a dependent function
over `Fin fuel`. -/
abbrev ProductiveFixedRootArithmeticPrefixAt
    {N : WorldRelationNetwork.{u}}
    {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    (history : ProductiveFiniteRootHistoryAt root.toLedgerRoot)
    (fuel : Nat) : Type (u + 12) :=
  (index : Fin fuel) ->
    ProductiveFixedRootArithmeticPrefixRowAt history index.val

/-- Generate exactly the bounded prefix at positions `0, ..., fuel - 1`. -/
def generateProductiveFixedRootArithmeticPrefixAt
    {N : WorldRelationNetwork.{u}}
    {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    (history : ProductiveFiniteRootHistoryAt root.toLedgerRoot)
    (fuel : Nat) :
    ProductiveFixedRootArithmeticPrefixAt history fuel :=
  fun index => ProductiveFixedRootArithmeticPrefixRowAt.generate
    history index.val

@[simp] theorem generated_rowAt
    {N : WorldRelationNetwork.{u}}
    {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    (history : ProductiveFiniteRootHistoryAt root.toLedgerRoot)
    (fuel : Nat) (index : Fin fuel) :
    generateProductiveFixedRootArithmeticPrefixAt history fuel index =
      ProductiveFixedRootArithmeticPrefixRowAt.generate
        history index.val :=
  rfl

/-- Asking the same source for a longer finite prefix cannot rewrite any row
already present in a shorter request.  Both sides reduce to the row generated
from the same history position; no completed infinite field is used. -/
theorem generated_rowAt_coherent_across_fuel
    {N : WorldRelationNetwork.{u}}
    {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    (history : ProductiveFiniteRootHistoryAt root.toLedgerRoot)
    (leftFuel rightFuel index : Nat)
    (leftBound : index < leftFuel)
    (rightBound : index < rightFuel) :
    generateProductiveFixedRootArithmeticPrefixAt history leftFuel
        ⟨index, leftBound⟩ =
      generateProductiveFixedRootArithmeticPrefixAt history rightFuel
        ⟨index, rightBound⟩ :=
  rfl

end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
