attribute [local irreducible] sourceRetainerSeed sourcePoleRead

theorem sourceMasterCurrent_all_zero (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ)
    (l r : RestStateIndex) (left : q.z.im≠0) (right : q.w.im≠0) : sourceMasterCurrent q n zeta l r=0 := by
  funext i
  simp only [sourceMasterCurrent,sourceRetainerSeed_all_zero q left right,mul_zero,map_zero,Pi.zero_apply]

theorem sourceFullCurrentResidue_all_zero (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ)
    (causal : 0<zeta.re) (l r : RestStateIndex) (left : q.z.im≠0) (right : q.w.im≠0) :
    sourceFullCurrentResidue q n zeta l r=0 := by
  funext i
  rw [sourceFullCurrentResidue_square q n zeta causal]
  simp only [sourceRetainerSeed_all_zero q left right,mul_zero,map_zero,Pi.zero_apply]

theorem sourceStaticCurrent_all_zero (q : PhysicalResponsePoint) (n : PhysicalMomentum)
    (l r : RestStateIndex) (left : q.z.im≠0) (right : q.w.im≠0) : sourceStaticCurrent q n l r=0 := by
  funext i
  rw [sourceStaticCurrent_seed]
  simp only [sourceRetainerSeed_all_zero q left right,mul_zero,map_zero,Pi.zero_apply]

/-- Full effective reader mixing consumes the computed source seed; this statement does not erase any output curvature column. -/
theorem sourceMasterNative_all_zero (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ)
    (l r : RestStateIndex) (left : q.z.im≠0) (right : q.w.im≠0) : sourceMasterNative q n zeta l r=0 := by
  simp only [sourceMasterNative,sourceMasterCurrent_all_zero q n zeta l r left right,Matrix.mulVec_zero]

theorem sourceMasterChannel_all_zero (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ)
    (l r : RestStateIndex) (left : q.z.im≠0) (right : q.w.im≠0) (i : Fin 3) :
    sourceMasterChannel q n zeta l r i=0 := by
  simp only [sourceMasterChannel,sourceMasterNative_all_zero q n zeta l r left right,sourceSlowRead,
    Matrix.mulVec_zero,Pi.zero_apply,ite_self,mul_zero]

/-- The entire original Schwartz Fourier master is computed zero before any radial limit. -/
theorem sourceMasterSpatialChannel_all_zero (q : PhysicalResponsePoint) (zeta : ℂ) (l r : RestStateIndex)
    (left : q.z.im≠0) (right : q.w.im≠0) (i : Fin 3) (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) :
    sourceMasterSpatialChannel q zeta l r i test x=0 := by
  unfold sourceMasterSpatialChannel
  have zero : (fun n : PhysicalMomentum=>sourceSpatialPhase n x*test n*
      sourceMasterChannel q (sourceSpatialMomentum n) zeta l r i)=fun _=>0 := by
    funext n
    rw [sourceMasterChannel_all_zero q _ zeta l r left right i,mul_zero]
  change (∫n : PhysicalMomentum,sourceSpatialPhase n x*test n*sourceMasterChannel q (sourceSpatialMomentum n) zeta l r i)=0
  rw [zero,integral_zero]

theorem sourceMasterSpatialField_all_zero (q : PhysicalResponsePoint) (zeta : ℂ) (l r : RestStateIndex)
    (left : q.z.im≠0) (right : q.w.im≠0) (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) :
    sourceMasterSpatialField q zeta l r test x=0 := by
  simp only [sourceMasterSpatialField,sourceMasterSpatialChannel_all_zero q zeta l r left right,
    zero_smul,Finset.sum_const_zero]

theorem sourceActualMasterSpatialField_all_zero (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) (zeta : ℂ)
    (left : q.z.im≠0) (right : q.w.im≠0) (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) :
    sourceActualMasterSpatialField q sL eL sR eR zeta test x=0 := by
  simp only [sourceActualMasterSpatialField,sourceMasterSpatialField_all_zero q zeta _ _ left right,
    smul_zero,Finset.sum_const_zero]

/-- The actual source64 whole field identifies its original master correction by the already paid whole derivative, with no exchange of spatial and causal limits. -/
theorem sourceActualSpatialField_correction (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (c eta : ℝ) (frequency : c≠0) (causal : 0<eta) (left : q.z.im≠0) (right : q.w.im≠0)
    (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) :
    sourceActualSpatialField q sL eL sR eR c eta test x=
      sourceActualMasterSpatialCorrection q sL eL sR eR (sourcePoleSide c eta) test x := by
  have derivative:=sourceActualMasterSpatial_derivative q sL eL sR eR c eta frequency causal test x
  have zero : (fun z : ℂ=>sourceActualMasterSpatialField q sL eL sR eR z test x)=fun _=>0 := by
    funext z
    exact sourceActualMasterSpatialField_all_zero q sL eL sR eR z left right test x
  rw [zero] at derivative
  have value:=derivative.unique (hasDerivAt_const (sourcePoleSide c eta) (0:Fin 289→ℂ))
  rw [sourceActualSpatialField_master q sL eL sR eR c eta frequency causal test x,value,zero_add]

private theorem side_scaled (d c eta : ℝ) : sourcePoleSide (d*c) (d*eta)=(d:ℂ)*sourcePoleSide c eta := by
  unfold sourcePoleSide
  push_cast
  ring

/-- The finite radial kernel/forcing convolution is the original whole correction, retaining its same scaled forcing and every field row. -/
theorem sourceActualRadialPotential_correction (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (branch : Fin 2) (negative : Bool) (eta : ℝ) (causal : 0<eta) (d : ℝ) (radial : 0<d)
    (left : q.z.im≠0) (right : q.w.im≠0) (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) :
    sourceActualRadialPotential q sL eL sR eR branch negative eta d test x=
      sourceActualMasterSpatialCorrection q sL eL sR eR ((d:ℂ)*sourcePoleSide (sourceSignedSpeed branch negative) eta) test x := by
  rw [sourceActualRadialPotential_return q sL eL sR eR branch negative eta causal d radial test x,
    sourceActualSpatialField_correction q sL eL sR eR _ _
      (mul_ne_zero radial.ne' (sourceSignedSpeed_nonzero branch negative)) (mul_pos radial causal) left right test x,
    side_scaled]

/-- The full original potential, without a caller-subtracted double term, now has its same-source complex radial simple return. -/
theorem sourceActualRadialPotential_simple (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (branch : Fin 2) (negative : Bool) (eta : ℝ) (causal : 0<eta)
    (left : q.z.im≠0) (right : q.w.im≠0) (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) :
    Tendsto (fun d : ℝ=>(d:ℂ) • sourceActualRadialPotential q sL eL sR eR branch negative eta d test x)
      (𝓝[>] 0) (𝓝 (sourceActualMasterSpatialSimple q sL eL sR eR (sourceSignedSpeed branch negative) eta test x)) := by
  apply (sourceActualMasterSpatialCorrection_return q sL eL sR eR (sourceSignedSpeed branch negative) eta
    (sourceSignedSpeed_nonzero branch negative) causal test x).congr'
  filter_upwards [self_mem_nhdsWithin] with d positive
  rw [sourceActualRadialPotential_correction q sL eL sR eR branch negative eta causal d positive left right test x]

open PreparationPhysicalActualLegNormalization

/-- The same independent unit legs, including all raw norms and three corrections, consume the whole physical spatial potential simple return. -/
theorem sourceActualUnitRadialPotential_simple (qd q : PhysicalResponsePoint)
    (dSL dEL dSR dER sL eL sR eR : Fin 2) (T : ℝ) (branch : Fin 2) (negative : Bool)
    (eta : ℝ) (causal : 0<eta) (sourceLeft : q.z.im≠0) (sourceRight : q.w.im≠0)
    (left : qd.z.im≠0) (right : qd.w.im≠0) (test : 𝓢(PhysicalMomentum,ℂ)) (x : PhysicalMomentum) :
    Tendsto (fun d : ℝ=>(d:ℂ)*sourceActualUnitFieldRead qd dSL dEL dSR dER 0 T
      (sourceActualRadialPotential q sL eL sR eR branch negative eta d test x))
      (𝓝[>] 0) (𝓝 (sourceActualUnitFieldRead qd dSL dEL dSR dER 0 T
        (sourceActualMasterSpatialSimple q sL eL sR eR (sourceSignedSpeed branch negative) eta test x))) := by
  apply (sourceActualUnitMasterCorrection_return qd q dSL dEL dSR dER sL eL sR eR T
    (sourceSignedSpeed branch negative) eta (sourceSignedSpeed_nonzero branch negative) causal left right test x).congr'
  filter_upwards [self_mem_nhdsWithin] with d positive
  rw [sourceActualRadialPotential_correction q sL eL sR eR branch negative eta causal d positive sourceLeft sourceRight test x]

