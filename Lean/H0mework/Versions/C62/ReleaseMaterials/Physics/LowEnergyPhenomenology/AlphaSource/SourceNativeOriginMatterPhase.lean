open scoped Matrix BigOperators
attribute [local simp] Matrix.cons_val_two Matrix.cons_val_three

/-- The two summands are the original color-gauge generator and a full-matter phase action. -/
def sourceNativeOriginGenerator : YangMills.FullPairing.Mother :=
  -(diracExteriorMotherLieAction (p286LieBlockEmbed (sourceColorP286Generator 2)))-
    (Complex.I/2) • (LinearMap.id : YangMills.FullPairing.Mother)

private theorem triplet_doublet (state : Fin 2) :
    sourceTripletMatter (state.castLE (by decide))=sourceColorDoubletMatter state := rfl

private theorem generator_value (v : DiracExteriorMatterCarrier) (spin : Fin 4) :
    sourceNativeOriginGenerator v spin=
      -exteriorSpinorMotherLieAction (p286LieBlockEmbed (sourceColorP286Generator 2)) (v spin)-
        (Complex.I/2) • v spin := rfl

private theorem generator_doublet (state : Fin 2) :
    -exteriorSpinorMotherLieAction (p286LieBlockEmbed (sourceColorP286Generator 2)) (sourceColorDoubletMatter state)-
      (Complex.I/2) • sourceColorDoubletMatter state=
        if state=0 then (-Complex.I) • sourceColorDoubletMatter 0 else 0 := by
  rw [sourceColorDoublet_generatorAction]
  fin_cases state <;> simp [sourceColorPauli,Fin.sum_univ_two]
  all_goals module

/-- The actual source singlet has a nonzero phase-plus-color variation in exactly its first-color lower spin entries. -/
theorem sourceNativeOriginGenerator_source (u v : ℂ) :
    sourceNativeOriginGenerator (spinPairMatter u v)=
      Complex.I • (u • sourceTripletLeg 1 0+v • sourceTripletLeg 3 0) := by
  funext spin
  rw [generator_value]
  fin_cases spin <;>
    simp [spinPairMatter,sourceColorDiracMatter,spinPairCoefficients,sourceColorDoublet_generatorAction,
      sourceColorPauli,sourceTripletLeg,Fin.sum_univ_two,Fin.ext_iff,
      show sourceTripletMatter 0=sourceColorDoubletMatter 0 from triplet_doublet 0]
  all_goals module

private theorem endpoint_primal (spin : Fin 4) (color : Fin 3) :
    fieldPrimalComplex (sourceNativeOriginReal 0) spin color=
      if (spin=1 ∨ spin=3) ∧ color=0 then Complex.I else 0 := by
  fin_cases spin <;> fin_cases color <;>
    simp only [fieldPrimalComplex,fieldPrimal,sourceNativeOriginReal,sourceNativeOriginAction_generated]
  all_goals norm_num [sourceNativeOriginActionTerms,sourceMatrix,SourceTerm.matrix,Powers.value,
    coefficientValue,primalSlot,Matrix.single_apply,Fin.ext_iff,rootTwo,rootFifteen,
    QuadraticAlgebra.re_one,QuadraticAlgebra.im_one,QuadraticAlgebra.re_zero,QuadraticAlgebra.im_zero]

/-- The same literal endpoint matter is generated by the combined action, not inferred from its gauge subblock. -/
theorem sourceNativeOrigin_primalPhase :
    primalInsertion (sourceNativeOriginReal 0)=sourceNativeOriginGenerator (spinPairMatter 1 1) := by
  rw [sourceNativeOriginGenerator_source]
  simp only [primalInsertion,endpoint_primal,Fin.sum_univ_four,Fin.sum_univ_three,
    Fin.reduceEq,if_true,if_false,or_true,or_false,and_true,and_false,one_smul,zero_smul,add_zero,zero_add,smul_add]

private theorem generator_dual_read (v : DiracExteriorMatterCarrier) (spin : Fin 4) (state : Fin 2) :
    sourceColorDoubletDual state (sourceNativeOriginGenerator v spin)=
      if state=0 then -Complex.I*sourceColorDoubletDual 0 (v spin) else 0 := by
  rw [generator_value,map_sub,map_neg,map_smul,sourceColorDoubletDual_generator]
  fin_cases state <;> simp [sourceColorPauli,Fin.sum_univ_two,smul_eq_mul]
  all_goals ring

private theorem endpoint_dual (spin : Fin 4) (color : Fin 3) :
    fieldDualComplex (sourceNativeOriginReal 0) spin color=
      if (spin=1 ∨ spin=3) ∧ color=0 then -Complex.I*(spinScale:ℂ) else 0 := by
  fin_cases spin <;> fin_cases color <;>
    simp only [fieldDualComplex,fieldDual,sourceNativeOriginReal,sourceNativeOriginAction_generated]
  all_goals norm_num [sourceNativeOriginActionTerms,sourceMatrix,SourceTerm.matrix,Powers.value,
    coefficientValue,dualSlot,Matrix.single_apply,Fin.ext_iff,rootTwo,rootFifteen,spinScale,
    QuadraticAlgebra.re_one,QuadraticAlgebra.im_one,QuadraticAlgebra.re_zero,QuadraticAlgebra.im_zero]

/-- The repaired independent dual transforms contragrediently on the entire original matter carrier. -/
theorem sourceNativeOrigin_dualPhase :
    dualInsertion (sourceNativeOriginReal 0)=
      -(spinPairDual (spinScale:ℂ) (spinScale:ℂ)).comp sourceNativeOriginGenerator := by
  apply LinearMap.ext
  intro v
  change (∑spin : Fin 4,∑color : Fin 3,fieldDualComplex (sourceNativeOriginReal 0) spin color*sourceTripletRead (v spin) color)=_
  simp only [endpoint_dual,Fin.sum_univ_four,Fin.sum_univ_three,
    Fin.reduceEq,if_true,if_false,or_true,or_false,and_true,and_false,zero_mul,add_zero,zero_add]
  change _= -spinPairDual (spinScale:ℂ) (spinScale:ℂ) (sourceNativeOriginGenerator v)
  simp only [spinPairDual,sourceColorDiracDual,LinearMap.coe_mk,AddHom.coe_mk,spinPairCoefficients,
    Fin.sum_univ_four,Fin.sum_univ_two]
  simp only [generator_dual_read,Fin.reduceEq,if_true,if_false]
  have read (spin : Fin 4) : sourceTripletRead (v spin) 0=sourceColorDoubletDual 0 (v spin) := rfl
  simp only [read,Matrix.of_apply,Matrix.cons_val_zero,Matrix.cons_val_one,Matrix.cons_val_two,Matrix.cons_val_three,Matrix.vecHead,Matrix.vecTail,Function.comp_apply,
    Fin.succ_zero_eq_one,Fin.succ_one_eq_two]
  ring

private theorem generator_rotation (point : BasePoint) (v : DiracExteriorMatterCarrier) :
    sourceNativeOriginGenerator (diracMatrixMatterAction (ActiveGauge.rotation point) v)=
      diracMatrixMatterAction (ActiveGauge.rotation point) (sourceNativeOriginGenerator v) := by
  have color : diracExteriorMotherLieAction (p286LieBlockEmbed (sourceColorP286Generator 2))
      (diracMatrixMatterAction (ActiveGauge.rotation point) v)=
    diracMatrixMatterAction (ActiveGauge.rotation point)
      (diracExteriorMotherLieAction (p286LieBlockEmbed (sourceColorP286Generator 2)) v) := by
    simpa only [diracExteriorMotherLieAction,LinearMap.comp_apply] using
      (LinearMap.congr_fun (diracMatrixMatterAction_commutes_internal (ActiveGauge.rotation point)
        (exteriorSpinorMotherLieAction (p286LieBlockEmbed (sourceColorP286Generator 2)))) v).symm
  simp only [sourceNativeOriginGenerator,LinearMap.sub_apply,LinearMap.neg_apply,LinearMap.smul_apply,
    LinearMap.id_apply,map_sub,map_neg,map_smul,color]

/-- The original rotating source, including its actual upper/lower phases, pays the matter identification at every point. -/
theorem sourceNativeOrigin_actualMatter (point : BasePoint) :
    diracMatrixMatterAction (ActiveGauge.rotation point) (primalInsertion (sourceNativeOriginReal 0))=
      sourceNativeOriginGenerator (actual.matter point) := by
  rw [sourceNativeOrigin_primalPhase,ActiveGauge.original_matter_rotation,generator_rotation]

/-- The same original rotation returns the repaired independent dual without taking an adjoint or supplying a normalization. -/
theorem sourceNativeOrigin_actualDual (point : BasePoint) :
    (dualInsertion (sourceNativeOriginReal 0)).comp (diracMatrixMatterAction (ActiveGauge.rotation point))=
      -(actual.conjugateMatter point).comp sourceNativeOriginGenerator := by
  rw [sourceNativeOrigin_dualPhase,ActiveGauge.original_dual_rotation]
  apply LinearMap.ext
  intro v
  simp only [LinearMap.comp_apply,LinearMap.neg_apply,generator_rotation]

end LowEnergy.PreparationPhysicalNativeOriginPhaseWard
