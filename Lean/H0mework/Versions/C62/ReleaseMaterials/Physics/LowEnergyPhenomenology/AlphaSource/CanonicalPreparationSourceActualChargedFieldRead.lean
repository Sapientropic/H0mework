private theorem origin_rows : fullNativeOriginTerms.all
    (fun t=>decide (t.row.val<121 ∨ 145≤t.row.val))=true := by
  decide +kernel

private theorem source_row_zero (terms : List SourceTerm) (p : Fin 4→ℂ) (i j : Fin 289)
    (rows : ∀t∈terms,t.row≠i) : sourceMatrix terms p i j=0 := by
  induction terms with
  | nil=>rfl
  | cons t rest ih=>
    rw [sourceMatrix_cons,Matrix.add_apply]
    have first : t.matrix p i j=0 := by
      simp only [SourceTerm.matrix,Matrix.single_apply]
      exact if_neg (fun h=>rows t List.mem_cons_self h.1)
    rw [first,ih (fun a ha=>rows a (List.mem_cons_of_mem _ ha)),zero_add]

/-- The leading complete native frame has no rotational Lorentz slot, as generated by its original source terms. -/
theorem sourceChargedNativeOrigin_slot (v : Fin 289→ℂ) (mu : Fin 4) :
    sourceChargedCoefficient (fullNativeOrigin*ᵥv) mu=0 := by
  unfold sourceChargedCoefficient
  rw [Matrix.mulVec_apply]
  apply Finset.sum_eq_zero
  intro j _
  have entry : fullNativeOrigin (lorentzSlot mu (sourceSpinSlot 2)) j=0 := by
    rw [fullNativeOrigin_generated]
    apply source_row_zero
    intro t ht same
    have ranges:=of_decide_eq_true (List.all_eq_true.mp origin_rows t ht)
    have value:=congrArg Fin.val same
    simp only [lorentzSlot,sourceSpinSlot] at value
    omega
  change fullNativeOrigin (lorentzSlot mu (sourceSpinSlot 2)) j*v j=0
  rw [entry,zero_mul]

def sourceChargedFrameInput (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ)
    (l r : RestStateIndex) : Fin 289→ℂ :=
  fiveVector ((sourceCausalPrincipal n zeta)⁻¹*ᵥsourceSlowRead (sourceActualNativeResidue q n zeta l r))

theorem sourceChargedJointField_coefficient (q : PhysicalResponsePoint) (n : PhysicalMomentum)
    (zeta : ℂ) (l r : RestStateIndex) (mu : Fin 4) :
    sourceChargedCoefficient (sourceJointFieldResidue q n zeta l r) mu=0 := by
  unfold sourceJointFieldResidue
  rw [←Matrix.mulVec_mulVec]
  change sourceChargedCoefficient (fullNativeOrigin*ᵥ_) mu=0
  exact sourceChargedNativeOrigin_slot _ mu

theorem sourceChargedJointField_remainder (q : PhysicalResponsePoint) (n : PhysicalMomentum)
    (zeta : ℂ) (l r : RestStateIndex) :
    sourceChargedFieldRemainder (sourceJointFieldResidue q n zeta l r)=sourceJointFieldResidue q n zeta l r := by
  simp only [sourceChargedFieldRemainder,sourceChargedFieldPart,sourceChargedJointField_coefficient,
    zero_smul,Finset.sum_const_zero,sub_zero]

/-- The next frame jet is calculated from the original field change and the entire complementary inverse. -/
def sourceChargedNativeFrameJet (v : Fin 4→ℂ) : Matrix (Fin 289) (Fin 289) ℂ :=
  (sourceLinearPart originalChangeTerms v*fullKernelFrame-
    originalChange 0*fullInverse*sourceLinearPart activeTerms v*fullKernelFrame)*slowFastFrame

def sourceChargedNativeFrameResidual (z : ℂ) (v : Fin 4→ℂ) : Matrix (Fin 289) (Fin 289) ℂ :=
  (sourceMatrix (sourceHigherTerms originalChangeTerms) (z • v)*fullKernelFrame-
    originalChange (z • v)*unrestrictedGreen (z • v)*
      sourceMatrix (sourceHigherTerms activeTerms) (z • v)*fullKernelFrame-
    z • ((originalChange (z • v)-originalChange 0)*unrestrictedGreen (z • v)*
      sourceLinearPart activeTerms v*fullKernelFrame)-
    z • (originalChange 0*(unrestrictedGreen (z • v)-fullInverse)*
      sourceLinearPart activeTerms v*fullKernelFrame))*slowFastFrame

private theorem frame_taylor {R : Type*} [Ring R] [Algebra ℂ R]
    (O O0 O1 N G B K K0 K1 : R) (z : ℂ) (kernel : K0*N=0) :
    (O*(N-G*K*N)-O0*N)-z • (O1*N-O0*B*K1*N)=
      (O-O0-z • O1)*N-O*G*(K-K0-z • K1)*N-
        z • ((O-O0)*G*K1*N)-z • (O0*(G-B)*K1*N) := by
  simp only [mul_sub,sub_mul,mul_smul_comm,smul_mul_assoc,smul_sub,mul_assoc,kernel,mul_zero]
  module

/-- Exact same-source frame return; the residual is generated from the genuine higher source terms and inverse variation. -/
theorem sourceChargedNativeFrame_first_return (z : ℂ) (v : Fin 4→ℂ) :
    sourceNativeFrame (z • v)-fullNativeOrigin*slowFastFrame-z • sourceChargedNativeFrameJet v=
      sourceChargedNativeFrameResidual z v := by
  have algebra:=frame_taylor (originalChange (z • v)) (originalChange 0)
    (sourceLinearPart originalChangeTerms v) fullKernelFrame (unrestrictedGreen (z • v))
    fullInverse (activeKernel (z • v)) (activeKernel 0) (sourceLinearPart activeTerms v) z fullKernel_origin
  have changeR:=sourceMatrix_first_return originalChangeTerms z v
  change originalChange (z • v)-originalChange 0-z • sourceLinearPart originalChangeTerms v=_ at changeR
  have kernelR:=sourceMatrix_first_return activeTerms z v
  change activeKernel (z • v)-activeKernel 0-z • sourceLinearPart activeTerms v=_ at kernelR
  rw [changeR,kernelR] at algebra
  have product:=congrArg (fun A : Matrix (Fin 289) (Fin 289) ℂ=>A*slowFastFrame) algebra
  simpa only [sub_mul,smul_mul_assoc,sourceNativeFrame,rawEffectiveFrame,fullNativeOrigin,
    sourceChargedNativeFrameJet,sourceChargedNativeFrameResidual,mul_assoc] using product

private theorem linear_cons (t : SourceTerm) (ts : List SourceTerm) (v : Fin 4→ℂ) :
    sourceLinearPart (t::ts) v=(if t.powers.total=1 then t.matrix v else 0)+sourceLinearPart ts v := by
  by_cases h0 : t.powers.total=0
  · simp [sourceLinearPart,degreeTensor,degreeTerms,positiveTerms,h0]
  · by_cases h1 : t.powers.total=1
    · simp [sourceLinearPart,degreeTensor,degreeTerms,positiveTerms,h1,sourceMatrix_cons]
    · simp [sourceLinearPart,degreeTensor,degreeTerms,positiveTerms,h0,h1]

private theorem sourceTerm_ray_derivative (t : SourceTerm) (v : Fin 4→ℂ) :
    HasDerivAt (fun d : ℝ=>t.matrix ((d:ℂ) • v))
      (if t.powers.total=1 then t.matrix v else 0) 0 := by
  have scaled (d : ℝ) : t.matrix ((d:ℂ) • v)=(d:ℂ)^t.powers.total • t.matrix v := by
    have h:=sourceMatrix_homogeneous [t] t.powers.total (by intro a ha; exact congrArg (fun a : SourceTerm=>a.powers.total) (List.mem_singleton.mp ha))
      (d:ℂ) v
    simpa only [sourceMatrix,List.map_cons,List.map_nil,List.sum_cons,List.sum_nil,add_zero] using h
  have equality : (fun d : ℝ=>t.matrix ((d:ℂ) • v))=
      (fun d : ℝ=>(d:ℂ)^t.powers.total • t.matrix v) := funext scaled
  rw [equality]
  have cast : HasDerivAt (fun d : ℝ=>(d:ℂ)) (1:ℂ) 0 := by
    simpa using (hasDerivAt_id (0:ℝ)).ofReal_comp
  have h:=(cast.pow t.powers.total).smul_const (t.matrix v)
  by_cases h0 : t.powers.total=0
  · simpa [h0] using h
  · by_cases h1 : t.powers.total=1
    · simpa [h1] using h
    · have exponent : t.powers.total-1≠0 := by omega
      simpa [h0,h1,exponent] using h

private theorem sourceMatrix_ray_derivative (ts : List SourceTerm) (v : Fin 4→ℂ) :
    HasDerivAt (fun d : ℝ=>sourceMatrix ts ((d:ℂ) • v)) (sourceLinearPart ts v) 0 := by
  induction ts with
  | nil=>simpa [sourceLinearPart,degreeTensor,degreeTerms,positiveTerms,sourceMatrix] using
      (hasDerivAt_const (0:ℝ) (0:Matrix (Fin 289) (Fin 289) ℂ))
  | cons t ts ih=>
      have h:=(sourceTerm_ray_derivative t v).add ih
      simp only [sourceMatrix_cons,linear_cons]
      convert! h using 1

/-- The full frame derivative is generated on every physical momentum-frequency ray; no derivative is a premise. -/
theorem sourceChargedNativeFrame_derivative (v : Fin 4→ℂ) :
    HasDerivAt (fun d : ℝ=>sourceNativeFrame ((d:ℂ) • v)) (sourceChargedNativeFrameJet v) 0 := by
  have O:=sourceMatrix_ray_derivative originalChangeTerms v
  change HasDerivAt (fun d : ℝ=>originalChange ((d:ℂ) • v)) (sourceLinearPart originalChangeTerms v) 0 at O
  have K:=sourceMatrix_ray_derivative activeTerms v
  change HasDerivAt (fun d : ℝ=>activeKernel ((d:ℂ) • v)) (sourceLinearPart activeTerms v) 0 at K
  have ray : HasDerivAt (fun d : ℝ=>(d:ℂ) • v) v 0 := by
    simpa using ((hasDerivAt_id (0:ℝ)).ofReal_comp.smul_const v)
  have G : HasDerivAt (fun d : ℝ=>unrestrictedGreen ((d:ℂ) • v))
      ((fderiv ℝ unrestrictedGreen 0) v) 0 := by
    have h:= (unrestrictedGreen_smooth_origin.differentiableAt (by simp)).hasFDerivAt.comp_hasDerivAt_of_eq
      (0:ℝ) ray (show (0 : Fin 4→ℂ)=(0:ℂ) • v by simp)
    convert! h using 1
  have frame:= (O.mul ((hasDerivAt_const (0:ℝ) fullKernelFrame).sub ((G.mul K).mul_const fullKernelFrame))).mul_const slowFastFrame
  have green0 : unrestrictedGreen 0=fullInverse := by
    simpa only [unrestrictedGreen,PreparationVacuumFullOriginResponse.complementGreen,
      PreparationVacuumFullOriginResponse.complementOrigin] using PreparationVacuumFullOriginResponse.complementGreen_origin
  simp [Pi.mul_apply,Pi.sub_apply,green0,fullKernel_origin,mul_assoc,sub_mul,add_mul] at frame
  simp only [sourceNativeFrame,rawEffectiveFrame,sourceChargedNativeFrameJet,
    mul_assoc,sub_eq_add_neg,add_mul,neg_mul,
    (RCLike.real_smul_eq_coe_smul (K:=ℂ))] at frame ⊢
  convert! frame using 1

theorem sourceChargedNativeFrame_origin : sourceNativeFrame 0=fullNativeOrigin*slowFastFrame := by
  simp only [sourceNativeFrame,rawEffectiveFrame,mul_assoc,fullKernel_origin,mul_zero,sub_zero]
  unfold fullNativeOrigin
  exact (mul_assoc _ _ _).symm

/-- Positive real scale derivative, on the same general n/zeta ray used by the actual Γ field. -/
theorem sourceChargedNativeFrame_slope (v : Fin 4→ℂ) :
    Tendsto (fun d : ℝ=>(d:ℂ)⁻¹ • (sourceNativeFrame ((d:ℂ) • v)-fullNativeOrigin*slowFastFrame))
      (𝓝[>] 0) (𝓝 (sourceChargedNativeFrameJet v)) := by
  have h:=(sourceChargedNativeFrame_derivative v).tendsto_slope_zero_right
  simp only [zero_add,Complex.ofReal_zero,zero_smul,sourceChargedNativeFrame_origin] at h
  apply h.congr'
  filter_upwards [] with d
  rw [←Complex.ofReal_inv]
  exact RCLike.real_smul_eq_coe_smul (K:=ℂ) d⁻¹ _

def sourceChargedActualFrameField (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ)
    (l r : RestStateIndex) (z : ℂ) : Fin 289→ℂ :=
  sourceNativeFrame (z • fixedMomentum n zeta)*ᵥsourceChargedFrameInput q n zeta l r

def sourceChargedActualFieldJet (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ)
    (l r : RestStateIndex) : Fin 289→ℂ :=
  sourceChargedNativeFrameJet (fixedMomentum n zeta)*ᵥsourceChargedFrameInput q n zeta l r

def sourceChargedActualFieldResidual (q : PhysicalResponsePoint) (n : PhysicalMomentum) (zeta : ℂ)
    (l r : RestStateIndex) (z : ℂ) : Fin 289→ℂ :=
  sourceChargedNativeFrameResidual z (fixedMomentum n zeta)*ᵥsourceChargedFrameInput q n zeta l r

/-- The original q, two denominators, all source current legs and complete Γ frame generate the next field coordinate. -/
theorem sourceChargedActualField_first_return (q : PhysicalResponsePoint) (n : PhysicalMomentum)
    (zeta : ℂ) (l r : RestStateIndex) (z : ℂ) :
    sourceChargedActualFrameField q n zeta l r z-sourceJointFieldResidue q n zeta l r-
      z • sourceChargedActualFieldJet q n zeta l r=sourceChargedActualFieldResidual q n zeta l r z := by
  have h:=congrArg (fun A : Matrix (Fin 289) (Fin 289) ℂ=>A*ᵥsourceChargedFrameInput q n zeta l r)
    (sourceChargedNativeFrame_first_return z (fixedMomentum n zeta))
  simpa only [Matrix.sub_mulVec,Matrix.smul_mulVec,sourceChargedActualFrameField,
    sourceChargedActualFieldJet,sourceChargedActualFieldResidual,sourceJointFieldResidue,
    sourceChargedFrameInput,fullNativeOrigin] using h

/-- Actual spin/gauge-lock coefficients are produced by the same full field frame jet, with the original residual retained. -/
theorem sourceChargedActualCoefficient_first_return (q : PhysicalResponsePoint) (n : PhysicalMomentum)
    (zeta : ℂ) (l r : RestStateIndex) (z : ℂ) (mu : Fin 4) :
    sourceChargedCoefficient (sourceChargedActualFrameField q n zeta l r z) mu-
      z*sourceChargedCoefficient (sourceChargedActualFieldJet q n zeta l r) mu=
        sourceChargedCoefficient (sourceChargedActualFieldResidual q n zeta l r z) mu := by
  have h:=congrFun (sourceChargedActualField_first_return q n zeta l r z)
    (lorentzSlot mu (sourceSpinSlot 2))
  change sourceChargedCoefficient (sourceChargedActualFrameField q n zeta l r z) mu-
    sourceChargedCoefficient (sourceJointFieldResidue q n zeta l r) mu-
      z*sourceChargedCoefficient (sourceChargedActualFieldJet q n zeta l r) mu=_ at h
  rw [sourceChargedJointField_coefficient,sub_zero] at h
  simpa only [sourceChargedCoefficient] using h

def sourceChargedCoefficientResidualPrice (q : PhysicalResponsePoint) (n : PhysicalMomentum)
    (zeta : ℂ) (l r : RestStateIndex) (z : ℂ) (mu : Fin 4) : ℝ :=
  ∑j : Fin 289,‖sourceChargedNativeFrameResidual z (fixedMomentum n zeta)
    (lorentzSlot mu (sourceSpinSlot 2)) j‖*‖sourceChargedFrameInput q n zeta l r j‖

/-- Higher original source terms and the actual full-inverse variation price the generated charge-coordinate error. -/
theorem sourceChargedActualCoefficient_residual_price (q : PhysicalResponsePoint) (n : PhysicalMomentum)
    (zeta : ℂ) (l r : RestStateIndex) (z : ℂ) (mu : Fin 4) :
    ‖sourceChargedCoefficient (sourceChargedActualFrameField q n zeta l r z) mu-
      z*sourceChargedCoefficient (sourceChargedActualFieldJet q n zeta l r) mu‖≤
        sourceChargedCoefficientResidualPrice q n zeta l r z mu := by
  rw [sourceChargedActualCoefficient_first_return]
  unfold sourceChargedCoefficient sourceChargedActualFieldResidual
  rw [Matrix.mulVec_apply]
  exact (norm_sum_le _ _).trans (by simp only [norm_mul,sourceChargedCoefficientResidualPrice];rfl)

/-- The actual source frame jet feeds the already paid charged four-current through its generated coefficient, with every transition retained. -/
theorem sourceChargedActualJet_current_minus (q : PhysicalResponsePoint) (n : PhysicalMomentum)
    (zeta : ℂ) (l r : RestStateIndex) (point : BasePoint) (side : Fin 2) (mu : Fin 4) :
    PreparationVacuumPhysicalModeChargeRead.sourceModeCurrent (sourceChargedActualFieldJet q n zeta l r) mu
      (actualRestStatePreparation (side,1) (actual.matter point))=
      sourceChargedCoefficient (sourceChargedActualFieldJet q n zeta l r) mu •
        currentAction mu HyperchargeResponse.chargeDirection
          (actualRestStatePreparation (side,1) (actual.matter point))+
      PreparationVacuumPhysicalModeChargeRead.sourceModeCurrent
        (sourceChargedFieldRemainder (sourceChargedActualFieldJet q n zeta l r)) mu
          (actualRestStatePreparation (side,1) (actual.matter point)) :=
  sourceChargedCurrent_minus _ mu point side

theorem sourceChargedActualJet_current_plus (q : PhysicalResponsePoint) (n : PhysicalMomentum)
    (zeta : ℂ) (l r : RestStateIndex) (point : BasePoint) (side : Fin 2) (mu : Fin 4) :
    PreparationVacuumPhysicalModeChargeRead.sourceModeCurrent (sourceChargedActualFieldJet q n zeta l r) mu
      (actualRestStatePreparation (side,3) (actual.matter point))=
      -(sourceChargedCoefficient (sourceChargedActualFieldJet q n zeta l r) mu •
        currentAction mu HyperchargeResponse.chargeDirection
          (actualRestStatePreparation (side,3) (actual.matter point)))+
      PreparationVacuumPhysicalModeChargeRead.sourceModeCurrent
        (sourceChargedFieldRemainder (sourceChargedActualFieldJet q n zeta l r)) mu
          (actualRestStatePreparation (side,3) (actual.matter point)) :=
  sourceChargedCurrent_plus _ mu point side

theorem sourceChargedActualFrame_observed (q : PhysicalResponsePoint) (n : PhysicalMomentum)
    (zeta : ℂ) (l r a b : RestStateIndex) (z : ℂ) (pL pR : PhysicalMomentum) :
    sourceAmputatedFieldVertex q pL pR a b (sourceChargedActualFrameField q n zeta l r z)=
      (∑mu : Fin 4,sourceChargedCoefficient (sourceChargedActualFrameField q n zeta l r z) mu*
        sourceAmputatedFieldVertex q pL pR a b (sourceChargedLockedField mu))+
      sourceBareFieldVertex q pL pR a b (sourceChargedFieldRemainder (sourceChargedActualFrameField q n zeta l r z))+
      sourceFieldLegCorrection q pL pR a b (sourceChargedFieldRemainder (sourceChargedActualFrameField q n zeta l r z)) :=
  sourceChargedAmputatedField_generated q pL pR a b _

/-- The actual complete leading field is read, rather than inferred from a scalar static coefficient. -/
theorem sourceChargedActualJointField_observed_price (q : PhysicalResponsePoint) (n : PhysicalMomentum)
    (zeta : ℂ) (l r a b : RestStateIndex) (pL pR : PhysicalMomentum)
    (nonrealL : q.z.im≠0) (nonrealR : q.w.im≠0) :
    ‖sourceAmputatedFieldVertex q pL pR a b (sourceJointFieldResidue q n zeta l r)‖≤
      sourceChargedRemainderAmplitudePrice q pL pR a b (sourceJointFieldResidue q n zeta l r) := by
  have h:=sourceChargedRemainder_amplitude_price q pL pR a b
    (sourceJointFieldResidue q n zeta l r) nonrealL nonrealR
  rwa [sourceChargedJointField_remainder] at h

