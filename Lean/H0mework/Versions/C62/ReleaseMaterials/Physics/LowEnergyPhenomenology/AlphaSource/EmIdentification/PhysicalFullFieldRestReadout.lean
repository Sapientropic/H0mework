open scoped Matrix BigOperators Topology InnerProductSpace

/-- The actual rest preparation at `(0,0)` is the canonical normalized
    preparation at zero momentum: the side condition selects the direct branch
    and the `0`-th rest action is the identity, so no new physical premise is
    paid. The locked `(side,1)`/`(side,3)` polarizations are not replaced. -/
theorem canonical_rest_preparation :
    actualRestStatePreparation (0, 0) =
      CanonicalParticle.normalizedPreparation 0 := by
  have hrest : actualRestStatePreparation (0, 0) =
      (sourceRestStateAction (0 : Fin 4)).comp (actualPolePreparation 0) := rfl
  rw [hrest]
  simp only [sourceRestStateAction, Fin.isValue, Matrix.cons_val_zero]
  rw [show (1 : YangMills.FullPairing.Mother).comp (actualPolePreparation 0) =
      actualPolePreparation 0 from LinearMap.id_comp _]
  rfl

/-- The rest state is the canonical prepared vector generated by the actual
    `(0,0)` rest preparation on the original prepared point. -/
def restState : Hilbert :=
  YangMills.FullPairing.operator (actualRestStatePreparation (0, 0))
    (YangMills.FullPairing.prepared 0)

/-- The rest state is the canonical particle state at the origin point and
    zero momentum; the coordinates come from `normalized_source`. -/
theorem canonical_rest_state :
    restState = CanonicalParticle.state 0 0 := by
  rw [restState, canonical_rest_preparation,
    CanonicalParticle.full_prepared, CanonicalParticle.state,
    CanonicalParticle.normalized_source]

/-- The rest packet is the history-prepared lift of the rest state. -/
def restPacket : FullMatterL2 :=
  FullQuantum.HistoryPrepared.preparation restState

/-- The rest packet is the original canonical packet at zero momentum. -/
theorem canonical_rest_packet :
    restPacket = Electromagnetic.CanonicalPacket.packet 0 := by
  rw [restPacket, canonical_rest_state,
    ← Electromagnetic.CanonicalPacket.packet_original]

/-- The rest packet retains the canonical unit norm. -/
theorem rest_packet_unit : ‖restPacket‖ = 1 := by
  rw [canonical_rest_packet]
  exact Electromagnetic.CanonicalPacket.packet_unit 0

/-- The rest state carries the canonical hypercharge read `-1` on the original
    density reader; this is the canonical Y charge of the `(0,0)` rest state,
    not a photon or electron label. -/
theorem rest_charge_unit :
    inner ℂ restState
      (Electromagnetic.CanonicalPacket.densityReader
        (Stage9DEF.Compatibility.currentAction 0
          Stage10.HyperchargeResponse.chargeDirection)
        restState) = -1 := by
  rw [canonical_rest_state]
  exact Electromagnetic.CanonicalPacket.original_charge_unit 0

/-- The rest state is a pole vector of the original full Hamiltonian at zero
    momentum with eigenvalue `energy 0`; the spectrum is not recomputed. -/
theorem rest_state_pole :
    YangMills.FullPairing.operator
        (FullQuantum.hamiltonian Stage10.Runtime.configuration 0 0) restState =
      ((CanonicalParticle.energy 0 : ℝ) : ℂ) • restState := by
  conv_lhs => rw [canonical_rest_state]
  conv_rhs => rw [canonical_rest_state]
  simp only [CanonicalParticle.state, YangMills.FullPairing.operator_coordinates,
    CanonicalParticle.normalized_full_hamiltonian, map_smul]

/-- The rest phase is retained: the original evolution of the rest state is
    the `exp (-I t·energy 0)` scalar orbit, not a rescaled or discarded
    phase. -/
theorem rest_state_evolution (time : ℝ) :
    FullQuantum.evolution Stage10.Runtime.configuration 0 0 time restState =
      Complex.exp (-Complex.I*(time : ℂ)*(CanonicalParticle.energy 0 : ℂ)) •
        restState := by
  rw [canonical_rest_state]
  exact CanonicalParticle.original_evolution 0 0 time

/-- The rest scattering pair: the original packet slot is replaced by the
    canonical rest packet. Both the two-time kernel component and the direct
    mixed contact component are retained. -/
def restScatteringPair (A B : TransferPair) (shift : Fin 3 → ℝ)
    (time age : ℝ) : ℂ × ℂ :=
  (packetNormalization 0 *
      inner ℂ restPacket
        (fieldTwoTimeKernel A B shift time age restPacket),
    packetNormalization 0 *
      inner ℂ restPacket (fieldMixedContact A B time restPacket))

/-- The original scattering pair at zero momentum is exactly the rest
    scattering pair: the packet read is the canonical rest packet. -/
theorem original_rest_scattering_pair (A B : TransferPair)
    (shift : Fin 3 → ℝ) (time age : ℝ) :
    originalScatteringPair 0 A B shift time age =
      restScatteringPair A B shift time age := by
  simp only [originalScatteringPair, restScatteringPair]
  rw [fieldMother_read, fieldContactMother_read, ← canonical_rest_packet]

/-- The rest pair of the four causal legs at causal scale `d`. -/
def restCausalPair (Apos Aneg Bpos Bneg : CausalFieldLeg)
    (time age : ℝ) (d : ℝ) : ℂ × ℂ :=
  restScatteringPair (causalTransfer Apos Aneg d)
    (causalTransfer Bpos Bneg d) 0 time age

/-- The rest pair of the four leg residues. -/
def restResiduePair (Apos Aneg Bpos Bneg : CausalFieldLeg)
    (time age : ℝ) : ℂ × ℂ :=
  restScatteringPair (residueTransfer Apos Aneg)
    (residueTransfer Bpos Bneg) 0 time age

/-- The rest `δ⁶` residue: the actual causal `d⁶` limit read on the canonical
    rest packet. It consumes the certified `actual_scattering_pair_residue`
    directly; no new limit is assumed. -/
theorem actual_rest_scattering_residue
    (Apos Aneg Bpos Bneg : CausalFieldLeg) (time age : ℝ) :
    Tendsto
      (fun d : ℝ =>
        (d : ℂ)^6 • restCausalPair Apos Aneg Bpos Bneg time age d)
      (𝓝[>] 0)
      (𝓝 (restResiduePair Apos Aneg Bpos Bneg time age)) := by
  have hlegs :
      Tendsto (fun d : ℝ => (d : ℂ)^6 •
          actualScatteringPair 0 Apos Aneg Bpos Bneg
            (0 : Fin 3 → ℝ) time age d)
        (𝓝[>] 0)
        (𝓝 (actualScatteringResidue 0 Apos Aneg Bpos Bneg
          (0 : Fin 3 → ℝ) time age)) :=
    actual_scattering_pair_residue 0 Apos Aneg Bpos Bneg
      (0 : Fin 3 → ℝ) time age
  have heq : (fun d : ℝ =>
        (d : ℂ)^6 • restCausalPair Apos Aneg Bpos Bneg time age d) =
      fun d : ℝ => (d : ℂ)^6 •
        actualScatteringPair 0 Apos Aneg Bpos Bneg
          (0 : Fin 3 → ℝ) time age d := by
    funext d
    simp only [restCausalPair, actualScatteringPair]
    rw [← original_rest_scattering_pair]
  have htarget : restResiduePair Apos Aneg Bpos Bneg time age =
      actualScatteringResidue 0 Apos Aneg Bpos Bneg
        (0 : Fin 3 → ℝ) time age := by
    simp only [restResiduePair, actualScatteringResidue]
    rw [← original_rest_scattering_pair]
  rw [htarget, heq]
  exact hlegs

end LowEnergy.GaussComposite.PhysicalFullFieldRestReadout
