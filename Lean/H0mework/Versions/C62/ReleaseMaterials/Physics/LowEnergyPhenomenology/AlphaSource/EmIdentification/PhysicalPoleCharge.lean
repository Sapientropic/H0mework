/-- Almost-everywhere equality of the flat representatives gives equality in
the flat Fock Hilbert space. -/
private theorem flat_ext {v w : Flat}
    (h : ∀ᵐ z ∂GaussHistoryHilbert.chartMeasure,flatValue v z=flatValue w z) : v=w := by
  apply PiLp.ext
  intro word
  apply MeasureTheory.Lp.ext_iff.mpr
  filter_upwards [h] with z hz
  exact PiLp.ext_iff.mp hz word

/-- The half-density weighted value of a test section is the Number-weight
operator applied to the fiber value. -/
private theorem weighted_halfDensity (f : QuantumTest) (z : physicalChart) :
    weightedValue f z=weight (fun N => (halfDensity N z : ℂ)) (f ↑z) := rfl

/-- Quantization commutes with the half-density Number weight, so a constant
bounded matrix action on the weighted value is the quantized weighted value. -/
private theorem weighted_action_value (A : Matrix Mode Mode ℂ) (f : QuantumTest)
    (z : physicalChart) :
    weightedValue (action (fun _ => A) (fun _ => contDiffAt_const) f) z=
      quantized A (weightedValue f z) := by
  have h := congrArg (fun T : FiberOp => T (f ↑z))
    (weight_commute (fun N => (halfDensity N z : ℂ)) A).eq
  simp only [mul_apply_eq_comp] at h
  rw [weighted_halfDensity,weighted_halfDensity]
  show weight (fun N => (halfDensity N z : ℂ)) (quantized A (f ↑z))=
    quantized A (weight (fun N => (halfDensity N z : ℂ)) (f ↑z))
  exact h

/-- On the common configuration core the bounded quantized-matrix reader is the
half-density lift of the same fiber operator: both are restrictions of the one
Gauss half-density carrier. -/
private theorem bounded_matrix_lift (A : Matrix Mode Mode ℂ) :
    CanonicalGradedCurrent.boundedMatrix A=lift (quantized A) := by
  apply GaussYukawaGrade.core_ext
  intro f
  rw [CanonicalGradedCurrent.boundedMatrix_core]
  apply fockHalfDensityEquiv.injective
  rw [lift_apply,LinearIsometryEquiv.apply_symm_apply]
  apply flat_ext
  filter_upwards [flat_embed_value (action (fun _ => A) (fun _ => contDiffAt_const) f),
    flat_lift_value (quantized A) (fockHalfDensityEquiv (embed f)),
    flat_embed_value f] with z hl hlift hf
  rw [hl,hlift,hf]
  exact weighted_action_value A f z

/-- The physical source transported by the moving-pole preparation is a nativeY
charge eigenvector: on the primal coordinates `I` on `I` contributes `-1` and
the dual branch stays zero. This is generated by the source, no charge
hypothesis is supplied. -/
theorem pole_coordinates_charge (p : PhysicalMomentum) (state : RestStateIndex) :
    chargeMatrix nativeY*ᵥsourcePoleCoordinates p state=-sourcePoleCoordinates p state := by
  have eigen : diracExteriorMotherLieAction
      (p286LieBlockEmbed Stage10.HyperchargeResponse.chargeDirection)
      (actualMovingPolePreparation p state
        (Stage9DEF.Compatibility.embed (Stage9DEF.Source.vector 0)))=
      Complex.I • actualMovingPolePreparation p state
        (Stage9DEF.Compatibility.embed (Stage9DEF.Source.vector 0)) := by
    rw [actualMovingPole_source]
    exact source_embedding_charge _
  have primal : GaussNativeMatter.nativePrimal nativeY*ᵥsourcePolePrimalCoordinates p state=
      Complex.I • sourcePolePrimalCoordinates p state := by
    have h := congrArg LowEnergy.Quantum.coordinates eigen
    rw [←LowEnergy.Quantum.matrix_action,map_smul] at h
    change LowEnergy.Quantum.operatorMatrix (diracExteriorMotherLieAction
      (p286LieBlockEmbed (p286CoordinateEquiv.symm nativeY)))*ᵥ
      sourcePolePrimalCoordinates p state=_
    simpa only [nativeY,p286CoordinateEquiv.symm_apply_apply,sourcePolePrimalCoordinates] using h
  change (Complex.I • Matrix.fromBlocks (GaussNativeMatter.nativePrimal nativeY) 0 0
    ((GaussNativeMatter.nativePrimal nativeY).map (starRingEnd ℂ)))*ᵥ
    Sum.elim (sourcePolePrimalCoordinates p state)
      (fun _ : LowEnergy.Quantum.Index => (0 : ℂ))=_
  rw [Matrix.smul_mulVec,Matrix.fromBlocks_mulVec]
  have left : (Sum.elim (sourcePolePrimalCoordinates p state)
      (fun _ : LowEnergy.Quantum.Index => (0 : ℂ))) ∘ Sum.inl=
    sourcePolePrimalCoordinates p state := rfl
  have right : (Sum.elim (sourcePolePrimalCoordinates p state)
      (fun _ : LowEnergy.Quantum.Index => (0 : ℂ))) ∘ Sum.inr=0 := rfl
  rw [left,right,Matrix.zero_mulVec,Matrix.zero_mulVec,Matrix.mulVec_zero,add_zero,zero_add,primal]
  funext i
  cases i with
  | inl i =>
    change Complex.I*(Complex.I*(sourcePolePrimalCoordinates p state) i)=
      -(sourcePolePrimalCoordinates p state) i
    rw [←mul_assoc,Complex.I_mul_I,neg_one_mul]
  | inr i => simp [sourcePoleCoordinates]

/-- The generated one-particle fiber of the moving source-pole preparation is
a `-1` eigenvector of the quantized nativeY charge matrix. -/
theorem pole_fiber_charge (p : PhysicalMomentum) (state : RestStateIndex) :
    quantized (chargeMatrix nativeY) (sourcePoleFiber p state)=-sourcePoleFiber p state := by
  change quantized (chargeMatrix nativeY) (oneParticleFiber (sourcePoleCoordinates p state))=
    -oneParticleFiber (sourcePoleCoordinates p state)
  rw [quantized_oneParticle,pole_coordinates_charge]
  change fiberCoordinates.symm (LowEnergy.Fermion.oneParticleLinear (-sourcePoleCoordinates p state))=_
  rw [map_neg,map_neg]
  rfl

/-- The actual moving source-pole prepared field is a nativeY charge `-1`
state on the whole half-density carrier: coordinatewise it is the fiber
eigenvector scaled by the same shared base. -/
theorem pole_prepared_charge (epsilon : ℝ) (precision : 0<epsilon) (p : PhysicalMomentum)
    (state : RestStateIndex) :
    chargeReader nativeY (sourcePolePrepared epsilon precision p state)=
      -sourcePolePrepared epsilon precision p state := by
  rw [show chargeReader nativeY=lift (quantized (chargeMatrix nativeY)) from bounded_matrix_lift _]
  apply fockHalfDensityEquiv.injective
  apply PiLp.ext
  intro word
  rw [map_neg,PiLp.neg_apply,sourcePolePrepared_coordinates]
  rw [sourcePolePrepared_action_coordinates]
  rw [pole_fiber_charge p state,PiLp.neg_apply,neg_smul]

/-- The generated prepared-state history is a nativeY charge `-1` eigenstate. -/
theorem pole_history_charge (epsilon : ℝ) (precision : 0<epsilon) (p : PhysicalMomentum)
    (state : RestStateIndex) :
    reader (chargeReader nativeY) (inclusion (sourcePolePrepared epsilon precision p state))=
      -inclusion (sourcePolePrepared epsilon precision p state) := by
  rw [GaussUnitaryHistory.reader_inclusion,pole_prepared_charge,map_neg]

/-- The generated prepared-state history is exactly the source/grade-zero
fixed point on history space. -/
theorem pole_history_grade_zero (epsilon : ℝ) (precision : 0<epsilon) (p : PhysicalMomentum)
    (state : RestStateIndex) :
    reader gradeZeroProjection (inclusion (sourcePolePrepared epsilon precision p state))=
      inclusion (sourcePolePrepared epsilon precision p state) := by
  rw [GaussUnitaryHistory.reader_inclusion,sourcePolePrepared_gradeZero_fixed]

/-- The whole eight-state prepared charge matrix is minus the generated Gram:
orthonormal source pole preparations each of charge `-1`. -/
theorem pole_charge_matrix (epsilon : ℝ) (precision : 0<epsilon) (p : PhysicalMomentum)
    (left right : RestStateIndex) :
    inner ℂ (sourcePolePrepared epsilon precision p left)
      (chargeReader nativeY (sourcePolePrepared epsilon precision p right))=
      -(if left=right then (1 : ℂ) else 0) := by
  rw [pole_prepared_charge,inner_neg_right,sourcePolePrepared_orthonormal]

/-- Each generated pole state has unit diagonal charge read. -/
theorem pole_charge_unit (epsilon : ℝ) (precision : 0<epsilon) (p : PhysicalMomentum)
    (state : RestStateIndex) :
    ‖inner ℂ (sourcePolePrepared epsilon precision p state)
      (chargeReader nativeY (sourcePolePrepared epsilon precision p state))‖=1 := by
  rw [pole_charge_matrix]
  simp

/-- The generated prepared field is nonzero; no nonempty-domain or eigenstate
premise is supplied. -/
theorem pole_prepared_nonzero (epsilon : ℝ) (precision : 0<epsilon) (p : PhysicalMomentum)
    (state : RestStateIndex) : sourcePolePrepared epsilon precision p state≠0 := by
  have u := sourcePolePrepared_unit epsilon precision p state
  intro h
  rw [h,norm_zero] at u
  norm_num at u

/-- Unprojected two-point of the complete resolvent between generated
moving-pole prepared states. -/
def poleFullTwoPoint (epsilon : ℝ) (precision : 0<epsilon)
    (leftMomentum rightMomentum : PhysicalMomentum) (left right : RestStateIndex)
    (readerMomentum : PhysicalMomentum) (cut : ℕ) (z : ℂ) (hz : z.im≠0) : ℂ :=
  inner ℂ (inclusion (sourcePolePrepared epsilon precision leftMomentum left))
    (CanonicalPhysicalYResolvent.fullResolvent readerMomentum cut z hz
      (inclusion (sourcePolePrepared epsilon precision rightMomentum right)))

/-- Literal full Ward vertex pairing of the source states at `p+k` and `p`. -/
def poleFullVertex (epsilon : ℝ) (precision : 0<epsilon) (p k : PhysicalMomentum)
    (left right : RestStateIndex) (cut : ℕ) (z w : ℂ) (hz : z.im≠0) (hw : w.im≠0) : ℂ :=
  inner ℂ (inclusion (sourcePolePrepared epsilon precision (p+k) left))
    (CanonicalPhysicalWard.vertex p k nativeY cut z w hz hw
      (inclusion (sourcePolePrepared epsilon precision p right)))

/-- Literal full Ward response pairing of the source states at `p+k` and `p`. -/
def poleFullResponse (epsilon : ℝ) (precision : 0<epsilon) (p k : PhysicalMomentum)
    (left right : RestStateIndex) (cut : ℕ) (z w : ℂ) (hz : z.im≠0) (hw : w.im≠0) : ℂ :=
  inner ℂ (inclusion (sourcePolePrepared epsilon precision (p+k) left))
    (CanonicalPhysicalWard.response p k nativeY cut z w hz hw
      (inclusion (sourcePolePrepared epsilon precision p right)))

/-- Unprojected pairings agree whenever the operators agree under the left
grade-zero projection and the left state is grade-zero fixed. -/
private theorem unprojected_pair (L R : HistorySpace)
    (fixed : reader gradeZeroProjection L=L) {X Y : HistorySpace →L[ℂ] HistorySpace}
    (h : reader gradeZeroProjection*X=reader gradeZeroProjection*Y) :
    inner ℂ L (X R)=inner ℂ L (Y R) := by
  have step := congrArg (fun T : HistorySpace →L[ℂ] HistorySpace => inner ℂ L (T R)) h
  simp only [mul_apply_eq_comp] at step
  calc inner ℂ L (X R)=inner ℂ L (reader gradeZeroProjection (X R)) := by
        rw [← grade_zero_history_pair,fixed]
    _ = inner ℂ L (reader gradeZeroProjection (Y R)) := step
    _ = inner ℂ L (Y R) := by rw [← grade_zero_history_pair,fixed]

/-- The full-resolvent Ward identity on the generated pole states: `(z-w)`
times the literal vertex equals the minus-signed endpoint difference plus the
complete retained response. The right charge `-1` produces `-G_out`; the left
charge moved through the charge pair produces `+G_in`. -/
theorem pole_full_ward (epsilon : ℝ) (precision : 0<epsilon) (p k : PhysicalMomentum)
    (left right : RestStateIndex) (cut : ℕ) (z w : ℂ) (hz : z.im≠0) (hw : w.im≠0) :
    (z-w)*poleFullVertex epsilon precision p k left right cut z w hz hw=
      -poleFullTwoPoint epsilon precision (p+k) p left right (p+k) cut z hz+
      poleFullTwoPoint epsilon precision (p+k) p left right p cut w hw+
      poleFullResponse epsilon precision p k left right cut z w hz hw := by
  have leftCharge := pole_history_charge epsilon precision (p+k) left
  have rightCharge := pole_history_charge epsilon precision p right
  have applied := congrArg (fun T : HistorySpace →L[ℂ] HistorySpace =>
    inner ℂ (inclusion (sourcePolePrepared epsilon precision (p+k) left))
      (T (inclusion (sourcePolePrepared epsilon precision p right))))
    (CanonicalPhysicalWard.full_charge_ward p k nativeY cut z w hz hw)
  simp only [smul_apply,sub_apply,add_apply,mul_apply_eq_comp,inner_smul_right,
    inner_sub_right,inner_add_right] at applied
  have charge_out : inner ℂ (inclusion (sourcePolePrepared epsilon precision (p+k) left))
      (CanonicalPhysicalYResolvent.fullResolvent (p+k) cut z hz
        (reader (chargeReader nativeY)
          (inclusion (sourcePolePrepared epsilon precision p right))))=
      -inner ℂ (inclusion (sourcePolePrepared epsilon precision (p+k) left))
        (CanonicalPhysicalYResolvent.fullResolvent (p+k) cut z hz
          (inclusion (sourcePolePrepared epsilon precision p right))) := by
    calc inner ℂ (inclusion (sourcePolePrepared epsilon precision (p+k) left))
          (CanonicalPhysicalYResolvent.fullResolvent (p+k) cut z hz
            (reader (chargeReader nativeY)
              (inclusion (sourcePolePrepared epsilon precision p right))))
        = inner ℂ (inclusion (sourcePolePrepared epsilon precision (p+k) left))
            (CanonicalPhysicalYResolvent.fullResolvent (p+k) cut z hz
              (-inclusion (sourcePolePrepared epsilon precision p right))) :=
          congrArg (fun T =>
            inner ℂ (inclusion (sourcePolePrepared epsilon precision (p+k) left))
              (CanonicalPhysicalYResolvent.fullResolvent (p+k) cut z hz T)) rightCharge
      _ = inner ℂ (inclusion (sourcePolePrepared epsilon precision (p+k) left))
            (-(CanonicalPhysicalYResolvent.fullResolvent (p+k) cut z hz
              (inclusion (sourcePolePrepared epsilon precision p right)))) :=
          congrArg (fun T =>
            inner ℂ (inclusion (sourcePolePrepared epsilon precision (p+k) left)) T)
            (map_neg (CanonicalPhysicalYResolvent.fullResolvent (p+k) cut z hz)
              (inclusion (sourcePolePrepared epsilon precision p right)))
      _ = _ := inner_neg_right _ _
  have charge_in : inner ℂ (inclusion (sourcePolePrepared epsilon precision (p+k) left))
      (reader (chargeReader nativeY)
        (CanonicalPhysicalYResolvent.fullResolvent p cut w hw
          (inclusion (sourcePolePrepared epsilon precision p right))))=
      -inner ℂ (inclusion (sourcePolePrepared epsilon precision (p+k) left))
        (CanonicalPhysicalYResolvent.fullResolvent p cut w hw
          (inclusion (sourcePolePrepared epsilon precision p right))) := by
    calc inner ℂ (inclusion (sourcePolePrepared epsilon precision (p+k) left))
          (reader (chargeReader nativeY)
            (CanonicalPhysicalYResolvent.fullResolvent p cut w hw
              (inclusion (sourcePolePrepared epsilon precision p right))))
        = inner ℂ (reader (chargeReader nativeY)
            (inclusion (sourcePolePrepared epsilon precision (p+k) left)))
            (CanonicalPhysicalYResolvent.fullResolvent p cut w hw
              (inclusion (sourcePolePrepared epsilon precision p right))) :=
          (ChargeResolvent.history_charge_pair nativeY
            (inclusion (sourcePolePrepared epsilon precision (p+k) left)) _).symm
      _ = inner ℂ (-inclusion (sourcePolePrepared epsilon precision (p+k) left))
            (CanonicalPhysicalYResolvent.fullResolvent p cut w hw
              (inclusion (sourcePolePrepared epsilon precision p right))) :=
          congrArg (fun T => inner ℂ T
            (CanonicalPhysicalYResolvent.fullResolvent p cut w hw
              (inclusion (sourcePolePrepared epsilon precision p right)))) leftCharge
      _ = _ := inner_neg_left _ _
  unfold poleFullVertex poleFullTwoPoint poleFullResponse
  linear_combination applied + charge_out - charge_in

/-- The literal full two-point on generated pole states is the literal physical
resolvent pairing: the Yukawa tail cannot touch these grade-zero histories. -/
theorem pole_full_twoPoint_return (epsilon : ℝ) (precision : 0<epsilon)
    (leftMomentum rightMomentum : PhysicalMomentum) (left right : RestStateIndex)
    (readerMomentum : PhysicalMomentum) (cut : ℕ) (z : ℂ) (hz : z.im≠0) :
    poleFullTwoPoint epsilon precision leftMomentum rightMomentum left right
      readerMomentum cut z hz=
      inner ℂ (inclusion (sourcePolePrepared epsilon precision leftMomentum left))
        (CanonicalPhysicalResolvent.sourceResolvent readerMomentum z hz
          (inclusion (sourcePolePrepared epsilon precision rightMomentum right))) :=
  unprojected_pair _ _ (pole_history_grade_zero epsilon precision leftMomentum left)
    (grade_zero_completed_left_return readerMomentum cut z hz)

/-- The literal full vertex on generated pole states is the literal physical
resolvent-chain pairing. -/
theorem pole_full_vertex_return (epsilon : ℝ) (precision : 0<epsilon)
    (p k : PhysicalMomentum) (left right : RestStateIndex) (cut : ℕ)
    (z w : ℂ) (hz : z.im≠0) (hw : w.im≠0) :
    poleFullVertex epsilon precision p k left right cut z w hz hw=
      inner ℂ (inclusion (sourcePolePrepared epsilon precision (p+k) left))
        (CanonicalPhysicalResolvent.sourceResolvent (p+k) z hz
          (reader (chargeReader nativeY)
            (CanonicalPhysicalResolvent.sourceResolvent p w hw
              (inclusion (sourcePolePrepared epsilon precision p right))))) :=
  unprojected_pair _ _ (pole_history_grade_zero epsilon precision (p+k) left)
    (grade_zero_vertex_return p k nativeY cut z w hz hw)

/-- The literal full two-point on pole states is cutoff-independent. -/
theorem pole_full_twoPoint_cutoff_independent (epsilon : ℝ) (precision : 0<epsilon)
    (leftMomentum rightMomentum : PhysicalMomentum) (left right : RestStateIndex)
    (readerMomentum : PhysicalMomentum) (cut other : ℕ) (z : ℂ) (hz : z.im≠0) :
    poleFullTwoPoint epsilon precision leftMomentum rightMomentum left right
      readerMomentum cut z hz=
      poleFullTwoPoint epsilon precision leftMomentum rightMomentum left right
        readerMomentum other z hz :=
  (pole_full_twoPoint_return epsilon precision leftMomentum rightMomentum left right
    readerMomentum cut z hz).trans
    (pole_full_twoPoint_return epsilon precision leftMomentum rightMomentum left right
      readerMomentum other z hz).symm

/-- The literal full vertex on pole states is cutoff-independent. -/
theorem pole_full_vertex_cutoff_independent (epsilon : ℝ) (precision : 0<epsilon)
    (p k : PhysicalMomentum) (left right : RestStateIndex) (cut other : ℕ)
    (z w : ℂ) (hz : z.im≠0) (hw : w.im≠0) :
    poleFullVertex epsilon precision p k left right cut z w hz hw=
      poleFullVertex epsilon precision p k left right other z w hz hw :=
  (pole_full_vertex_return epsilon precision p k left right cut z w hz hw).trans
    (pole_full_vertex_return epsilon precision p k left right other z w hz hw).symm

/-- The literal full response pairing on pole states is cutoff-independent. -/
theorem pole_full_response_cutoff_independent (epsilon : ℝ) (precision : 0<epsilon)
    (p k : PhysicalMomentum) (left right : RestStateIndex) (cut other : ℕ)
    (z w : ℂ) (hz : z.im≠0) (hw : w.im≠0) :
    poleFullResponse epsilon precision p k left right cut z w hz hw=
      poleFullResponse epsilon precision p k left right other z w hz hw :=
  unprojected_pair _ _ (pole_history_grade_zero epsilon precision (p+k) left)
    (grade_zero_response_cutoff_independent p k nativeY cut other z w hz hw)

/-- The literal pole two-point carries the standard physical resolvent bound
`1/|Im z|`; both generated states are unit. -/
theorem pole_full_twoPoint_bound (epsilon : ℝ) (precision : 0<epsilon)
    (leftMomentum rightMomentum : PhysicalMomentum) (left right : RestStateIndex)
    (readerMomentum : PhysicalMomentum) (cut : ℕ) (z : ℂ) (hz : z.im≠0) :
    ‖poleFullTwoPoint epsilon precision leftMomentum rightMomentum left right
      readerMomentum cut z hz‖≤1/|z.im| := by
  rw [pole_full_twoPoint_return]
  calc ‖inner ℂ (inclusion (sourcePolePrepared epsilon precision leftMomentum left))
        (CanonicalPhysicalResolvent.sourceResolvent readerMomentum z hz
          (inclusion (sourcePolePrepared epsilon precision rightMomentum right)))‖
      ≤ ‖inclusion (sourcePolePrepared epsilon precision leftMomentum left)‖*
        ‖CanonicalPhysicalResolvent.sourceResolvent readerMomentum z hz
          (inclusion (sourcePolePrepared epsilon precision rightMomentum right))‖ :=
        norm_inner_le_norm _ _
    _ = ‖CanonicalPhysicalResolvent.sourceResolvent readerMomentum z hz
          (inclusion (sourcePolePrepared epsilon precision rightMomentum right))‖ := by
        rw [inclusion.norm_map,sourcePolePrepared_unit epsilon precision leftMomentum left,one_mul]
    _ ≤ (1/|z.im|)*‖inclusion (sourcePolePrepared epsilon precision rightMomentum right)‖ :=
        resolvent_bound _ _ _ _
    _ = 1/|z.im| := by rw [inclusion.norm_map,sourcePolePrepared_unit epsilon precision rightMomentum right,mul_one]

/-- The literal pole vertex carries the standard resolvent bound
`(1/|Im z|)*‖chargeReader nativeY‖*(1/|Im w|)` with no leg-bound or profile
prices. -/
theorem pole_full_vertex_bound (epsilon : ℝ) (precision : 0<epsilon)
    (p k : PhysicalMomentum) (left right : RestStateIndex) (cut : ℕ)
    (z w : ℂ) (hz : z.im≠0) (hw : w.im≠0) :
    ‖poleFullVertex epsilon precision p k left right cut z w hz hw‖≤
      (1/|z.im|)*‖chargeReader nativeY‖*(1/|w.im|) := by
  have hL : ‖inclusion (sourcePolePrepared epsilon precision (p+k) left)‖=1 := by
    rw [inclusion.norm_map]
    exact sourcePolePrepared_unit epsilon precision (p+k) left
  have hR : ‖inclusion (sourcePolePrepared epsilon precision p right)‖=1 := by
    rw [inclusion.norm_map]
    exact sourcePolePrepared_unit epsilon precision p right
  have fixed := pole_history_grade_zero epsilon precision (p+k) left
  unfold poleFullVertex
  calc ‖inner ℂ (inclusion (sourcePolePrepared epsilon precision (p+k) left))
        (CanonicalPhysicalWard.vertex p k nativeY cut z w hz hw
          (inclusion (sourcePolePrepared epsilon precision p right)))‖
      = ‖inner ℂ (inclusion (sourcePolePrepared epsilon precision (p+k) left))
          (reader gradeZeroProjection
            (CanonicalPhysicalWard.vertex p k nativeY cut z w hz hw
              (inclusion (sourcePolePrepared epsilon precision p right))))‖ := by
        congr 1
        rw [← grade_zero_history_pair,fixed]
    _ ≤ ‖inclusion (sourcePolePrepared epsilon precision (p+k) left)‖*
        ‖reader gradeZeroProjection
          (CanonicalPhysicalWard.vertex p k nativeY cut z w hz hw
            (inclusion (sourcePolePrepared epsilon precision p right)))‖ :=
        norm_inner_le_norm _ _
    _ = ‖reader gradeZeroProjection
          (CanonicalPhysicalWard.vertex p k nativeY cut z w hz hw
            (inclusion (sourcePolePrepared epsilon precision p right)))‖ := by
        rw [hL,one_mul]
    _ ≤ ((1/|z.im|)*‖chargeReader nativeY‖*(1/|w.im|))*
        ‖inclusion (sourcePolePrepared epsilon precision p right)‖ :=
        grade_zero_vertex_bound p k nativeY cut z w hz hw
          (inclusion (sourcePolePrepared epsilon precision p right))
    _ = (1/|z.im|)*‖chargeReader nativeY‖*(1/|w.im|) := by rw [hR,mul_one]

end LowEnergy.GaussComposite.PhysicalPoleCharge
