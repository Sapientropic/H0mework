/-- The source momentum transfer fixes the field wave; only the original causal-domain parameter is supplied. -/
structure SourceUnitFieldLeg where
  q : PhysicalResponsePoint
  sideL : Fin 2
  edgeL : Fin 2
  sideR : Fin 2
  edgeR : Fin 2
  T : ℝ
  future : 0≤T
  frequency : CausalFrequency (-q.k)
  nonrealL : q.z.im≠0
  nonrealR : q.w.im≠0

def sourceUnitFieldPoint (leg : SourceUnitFieldLeg) : regularSource :=
  causalPoint (-leg.q.k) leg.frequency

def sourceUnitRawForcing (leg : SourceUnitFieldLeg) : Fin 289→ℂ :=
  sourceUnitCurrentWindow leg.q leg.sideL leg.edgeL leg.sideR leg.edgeR leg.frequency.val leg.T

def sourceUnitFieldCosource (leg : SourceUnitFieldLeg) : Fin 289→ℂ :=
  sourceUnitCurrentCosource leg.q leg.sideL leg.edgeL leg.sideR leg.edgeR
    (PreparationVacuumPhysicalFeedback.physicalSpatial (-leg.q.k)) leg.frequency.val leg.T

theorem sourceUnitFieldCosource_generated (leg : SourceUnitFieldLeg) :
    originalReadback (sourceUnitFieldPoint leg).val*ᵥsourceUnitRawForcing leg=sourceUnitFieldCosource leg := by
  simpa only [sourceUnitFieldPoint,causalPoint,fixedMomentum,sourceUnitRawForcing,sourceUnitFieldCosource] using
    sourceUnitCurrentWindow_ward leg.q leg.sideL leg.edgeL leg.sideR leg.edgeR
      (PreparationVacuumPhysicalFeedback.physicalSpatial (-leg.q.k)) leg.frequency.val leg.T

/-- The original nine-row constraint residual, including time-source and both endpoint terms, is preserved. -/
def sourceUnitConstraintSupplement (leg : SourceUnitFieldLeg) : Fin 289→ℂ :=
  -(originalRowLift (sourceUnitFieldPoint leg).val*ᵥ(nullProjection*ᵥsourceUnitFieldCosource leg))

def sourceUnitCompatibleForcing (leg : SourceUnitFieldLeg) : Fin 289→ℂ :=
  sourceUnitRawForcing leg+sourceUnitConstraintSupplement leg

def sourceUnitCompleteField (leg : SourceUnitFieldLeg) : Fin 289→ℂ :=
  PreparationVacuumOriginalGreenFeedback.sourceField (sourceUnitFieldPoint leg) (sourceUnitRawForcing leg)

private theorem readback_row (p : Fin 4→ℂ) : originalReadback p*originalRowLift p=1 := by
  unfold originalReadback originalRowLift
  rw [←Matrix.transpose_mul,original_inverse_change,Matrix.transpose_one]

private theorem null_square : nullProjection*nullProjection=nullProjection := by
  rw [nullProjection,projectionMatrix,Matrix.diagonal_mul_diagonal]
  congr 1
  funext i
  split_ifs <;> norm_num

/-- Compatibility is generated by the original row inverse and null projection; no Ward-zero premise is supplied. -/
theorem sourceUnitCompatibleForcing_compatible (leg : SourceUnitFieldLeg) :
    sourceCompatibility (sourceUnitFieldPoint leg).val (sourceUnitCompatibleForcing leg)=0 := by
  rw [sourceCompatibility,sourceUnitCompatibleForcing,sourceUnitConstraintSupplement,
    Matrix.mulVec_add,Matrix.mulVec_neg,Matrix.mulVec_mulVec,readback_row,Matrix.one_mulVec,
    sourceUnitFieldCosource_generated,Matrix.mulVec_add,Matrix.mulVec_neg,Matrix.mulVec_mulVec,null_square]
  simp

/-- The same complete original field solves exactly the generated forcing with its explicit constraint supplement. -/
theorem sourceUnitCompleteField_equation (leg : SourceUnitFieldLeg) :
    originalJacobi (sourceUnitFieldPoint leg).val*ᵥsourceUnitCompleteField leg=sourceUnitCompatibleForcing leg := by
  rw [sourceUnitCompleteField,original_forced_field,sourceCompatibility,sourceUnitFieldCosource_generated]
  rfl

/-- The unresolved source rows remain a separate output beside the complete field equation. -/
theorem sourceUnitCompleteField_raw (leg : SourceUnitFieldLeg) :
    originalJacobi (sourceUnitFieldPoint leg).val*ᵥsourceUnitCompleteField leg-
      sourceUnitConstraintSupplement leg=sourceUnitRawForcing leg := by
  rw [sourceUnitCompleteField_equation,sourceUnitCompatibleForcing,add_sub_cancel_right]

/-- The returned fullfield keeps the original direct Green contact and complete active propagation. -/
theorem sourceUnitCompleteField_parts (leg : SourceUnitFieldLeg) :
    sourceUnitCompleteField leg=
      originalChange (sourceUnitFieldPoint leg).val*ᵥ
        (contactInverse (sourceUnitFieldPoint leg).val*ᵥsourceUnitFieldCosource leg)+
      originalChange (sourceUnitFieldPoint leg).val*ᵥ
        (activeProjection*ᵥ((extendedKernel (sourceUnitFieldPoint leg).val)⁻¹*ᵥsourceUnitFieldCosource leg)) := by
  simp only [sourceUnitCompleteField,PreparationVacuumOriginalGreenFeedback.sourceField,sourceGreen,
    ←Matrix.mulVec_mulVec,sourceUnitFieldCosource_generated,Matrix.add_mulVec,Matrix.mulVec_add]

