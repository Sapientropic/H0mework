/-- The density is generated by the original unit-ball preparation, before the Green solution. -/
def sourcePacketDensityE (x : FullSpace.Position) : ℝ :=
  (Metric.ball (0 : FullSpace.Position) 1).indicator (fun _=>HistoryPrepared.packetScale⁻¹^2) x

def sourcePacketDensity (x : Point) : ℝ :=sourcePacketDensityE (WithLp.toLp 2 x)

theorem sourcePacketDensityE_shape : (fun x=>‖sourcePacketShape x‖^2)=ᵐ[volume] sourcePacketDensityE := by
  filter_upwards [sourcePacketShape_ae] with x shape
  rw [shape]
  by_cases inside : x∈Metric.ball (0 : FullSpace.Position) 1 <;>
    simp [sourcePacketDensityE,inside,Complex.norm_real]

theorem sourcePacketDensity_nonnegative (x : Point) : 0 ≤ sourcePacketDensity x := by
  unfold sourcePacketDensity sourcePacketDensityE
  by_cases inside : WithLp.toLp 2 x∈Metric.ball (0 : FullSpace.Position) 1 <;> simp [inside, sq_nonneg]

theorem sourcePacketDensity_bounded (x : Point) : ‖sourcePacketDensity x‖≤HistoryPrepared.packetScale⁻¹^2 := by
  unfold sourcePacketDensity sourcePacketDensityE
  by_cases inside : WithLp.toLp 2 x∈Metric.ball (0 : FullSpace.Position) 1 <;> simp [inside, sq_nonneg]

private theorem packetScale_square : HistoryPrepared.packetScale^2=volume.real (Metric.ball (0 : FullSpace.Position) 1) := by
  unfold HistoryPrepared.packetScale
  rw [←Real.rpow_mul_natCast (measureReal_nonneg) (1/(2:ℝ)) 2]
  norm_num

private theorem densityE_integrable : Integrable sourcePacketDensityE :=
  (integrable_indicator_iff measurableSet_ball).mpr (integrableOn_const measure_ball_ne_top)

theorem sourcePacketDensity_integrable : Integrable sourcePacketDensity :=
  (PiLp.volume_preserving_toLp (Fin 3)).integrable_comp_of_integrable densityE_integrable

theorem sourcePacketDensity_mass : (∫x : Point,sourcePacketDensity x)=1 := by
  have transported:=(PiLp.volume_preserving_toLp (Fin 3)).integral_comp
    ((PiLp.continuousLinearEquiv 2 ℝ (fun _ : Fin 3=>ℝ)).symm.toHomeomorph.measurableEmbedding) sourcePacketDensityE
  change (∫x : Point,sourcePacketDensityE (WithLp.toLp 2 x))=1
  rw [transported]
  unfold sourcePacketDensityE
  rw [integral_indicator measurableSet_ball,setIntegral_const]
  simp only [smul_eq_mul,inv_pow,←packetScale_square]
  exact mul_inv_cancel₀ (pow_ne_zero 2 HistoryPrepared.packetScale_positive.ne')

theorem sourcePacketDensity_support (x : Point) (outside : 1≤‖WithLp.toLp 2 x‖) : sourcePacketDensity x=0 := by
  unfold sourcePacketDensity sourcePacketDensityE
  apply indicator_of_notMem
  simpa only [Metric.mem_ball,dist_zero_right,not_lt] using outside

/-- The original canonical left density leg acts on the actual prepared packet. -/
def sourceCanonicalPacketCharge (momentum : Fin 3→ℝ) (x : FullSpace.Position) : ℂ :=
  (4*(spinScale:ℂ))*inner ℂ (CanonicalPacket.packet momentum x)
    (CanonicalPacket.densityReader (Compatibility.currentAction 0 Stage10.HyperchargeResponse.chargeDirection)
      (CanonicalPacket.packet momentum x))

theorem sourceCanonicalPacketCharge_generated (momentum : Fin 3→ℝ) :
    sourceCanonicalPacketCharge momentum=ᵐ[volume] fun x=>-(4*(spinScale:ℂ))*(sourcePacketDensityE x:ℂ) := by
  filter_upwards [sourceCanonicalPacket_shape momentum,sourcePacketDensityE_shape] with x packet density
  unfold sourceCanonicalPacketCharge
  rw [packet,map_smul,inner_smul_left,inner_smul_right,CanonicalPacket.original_charge_unit]
  rw [←density]
  have scalar := RCLike.conj_mul (sourcePacketShape x)
  rw [←RCLike.ofReal_pow] at scalar
  calc
    _= -(4*(spinScale:ℂ))*((starRingEnd ℂ) (sourcePacketShape x)*sourcePacketShape x) := by ring
    _=_ := by rw [scalar]; congr 1

/-- Same actual packet current, now in the original Cartesian Green coordinates. -/
theorem sourceCanonicalPacketCharge_spatial (momentum : Fin 3→ℝ) :
    (fun x : Point=>sourceCanonicalPacketCharge momentum (WithLp.toLp 2 x))=ᵐ[volume]
      fun x=>-(4*(spinScale:ℂ))*(sourcePacketDensity x:ℂ) :=
  (PiLp.volume_preserving_toLp (Fin 3)).quasiMeasurePreserving.ae_eq_comp (sourceCanonicalPacketCharge_generated momentum)

def sourcePacketGaussPotential (x : Point) : ℝ :=
  Stage10.StaticGreen.potential (fun y=>-(4*spinScale)*sourcePacketDensity y) x

theorem sourcePacketGaussPotential_original (test : 𝓢(Point,ℝ)) :
    (∫x : Point,sourcePacketGaussPotential x*(-(2*lapse)*Stage10.StaticGreen.testLaplacian test x))=
      (4*spinScale)*(∫x : Point,sourcePacketDensity x*test x) := by
  unfold sourcePacketGaussPotential
  rw [Stage10.StaticGreen.potential_weak_gauss _
    (sourcePacketDensity_integrable.const_mul _) test]
  simp_rw [mul_assoc]
  rw [integral_const_mul]
  ring

