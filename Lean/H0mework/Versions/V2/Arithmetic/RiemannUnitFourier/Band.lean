import H0mework.Arithmetic.RiemannUnitFourier.ForcingKernel
import H0mework.Versions.V2.Arithmetic.RiemannUnitRegularity.GeneratorCounting

/-! An actual counted Fourier step reads the oriented integral of the original
comb remainder. Its unit-radius derivative is generated by that same source. -/

set_option autoImplicit false

namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.BurnolPhysicalState
open Complex MeasureTheory Set Filter FourierTransform
open scoped InnerProductSpace Topology
noncomputable section

private theorem absoluteBand_integral (test : SchwartzMap ℝ ℂ)
    (a b : ℝ) (positive : 0 < a) (ordered : a ≤ b) :
    (∫ x : ℝ, (if a ≤ |x| ∧ |x| < b then (1 : ℂ) else 0) *
      coPoissonMuntzScaleRemainder test |x|) =
      (2 : ℂ) * ∫ x : ℝ in a..b, coPoissonMuntzScaleRemainder test x := by
  let K := coPoissonMuntzScaleRemainder test
  let f := (Ico a b).indicator K
  have continuous : ContinuousOn K (Icc a b) := by
    intro x hx
    exact (burnolRemainderKernel_continuousAt test x (positive.trans_le hx.1)).continuousWithinAt
  have integrable : Integrable f := by
    apply (integrable_indicator_iff measurableSet_Ico).mpr
    exact continuous.integrableOn_Icc.mono_set Ico_subset_Icc_self
  have pointwise (x : ℝ) :
      (if a ≤ |x| ∧ |x| < b then (1 : ℂ) else 0) * K |x| = f x + f (-x) := by
    by_cases pos : 0 ≤ x
    · have outside : -x ∉ Ico a b := by intro hx; linarith [hx.1]
      simp only [f, indicator_of_notMem outside, add_zero, abs_of_nonneg pos,
        indicator_apply, mem_Ico]
      split_ifs <;> simp
    · have neg : x < 0 := lt_of_not_ge pos
      have outside : x ∉ Ico a b := by intro hx; linarith [hx.1]
      simp only [f, indicator_of_notMem outside, zero_add, abs_of_neg neg,
        indicator_apply, mem_Ico]
      split_ifs <;> simp
  change (∫ x : ℝ, (if a ≤ |x| ∧ |x| < b then (1 : ℂ) else 0) * K |x|) =
    (2 : ℂ) * ∫ x : ℝ in a..b, K x
  simp_rw [pointwise]
  rw [integral_add integrable integrable.comp_neg,
    integral_neg_eq_self, integral_indicator measurableSet_Ico,
    integral_Ico_eq_integral_Ioc, ← intervalIntegral.integral_of_le ordered]
  ring

theorem burnolReciprocalStepFourier_read_remainderIntegral (test : SchwartzMap ℝ ℂ)
    (a b : ℝ) (positive : 0 < a) (ordered : a ≤ b) (bounded : b ≤ 4) :
    (Lp.toTemperedDistributionCLM ℂ volume 2
      (fourierL2 (burnolReciprocalStepNativeWave a b))) test =
      ∫ u : ℝ in a..b, coPoissonMuntzScaleRemainder test u := by
  rw [burnolReciprocalStepNativeWave_eq a b positive ordered]
  have realization := burnolRemainderRealization_fourier
    (burnolReciprocalStepSourceL2 a b positive ordered)
    (burnolReciprocalStepWaveL2 a b positive ordered)
    (burnolReciprocalStepSource_realizes a b positive ordered bounded) test
  rw [← realization, burnolRemainderSourceRead_integral]
  have same : (∫ x : ℝ, burnolTateReciprocalL2
      (burnolReciprocalStepSourceL2 a b positive ordered) x * coPoissonMuntzScaleRemainder test |x|) =
      ∫ x : ℝ, (if a ≤ |x| ∧ |x| < b then (1 : ℂ) else 0) *
        coPoissonMuntzScaleRemainder test |x| :=
    integral_congr_ae ((burnolReciprocalStepSource_tate_raw a b positive ordered).mono
      (fun x hx => congrArg (fun c => c * coPoissonMuntzScaleRemainder test |x|) hx))
  rw [same, absoluteBand_integral test a b positive ordered]
  ring

theorem burnolCountingFourierScale_difference (test : SchwartzMap ℝ ℂ)
    (u : ℝ) (positive : 0 < u) (bounded : u ≤ 4) :
    (Lp.toTemperedDistributionCLM ℂ volume 2
      (fourierL2 (burnolSourceScalePrimitive burnolUnitCountingPrimitiveL2 u))) test -
      (Lp.toTemperedDistributionCLM ℂ volume 2 (fourierL2 burnolUnitCountingPrimitiveL2)) test =
      ∫ r : ℝ in (1 : ℝ)..u, coPoissonMuntzScaleRemainder test r := by
  have atOne : burnolSourceScalePrimitive burnolUnitCountingPrimitiveL2 1 =
      burnolUnitCountingPrimitiveL2 := by
    simp only [burnolSourceScalePrimitive, Real.sqrt_one, Real.log_one,
      burnolMultiplicativeDilation_zero, one_smul]
  by_cases forward : 1 ≤ u
  · have source := burnolReciprocalStepFourier_read_remainderIntegral test 1 u (by norm_num) forward bounded
    simpa only [burnolReciprocalStepNativeWave, atOne, map_sub, sub_apply] using source
  · have source := burnolReciprocalStepFourier_read_remainderIntegral test u 1 positive (le_of_not_ge forward) (by norm_num)
    rw [intervalIntegral.integral_symm] at source
    simp only [burnolReciprocalStepNativeWave, atOne, map_sub, sub_apply] at source
    linear_combination -source

theorem burnolCountingFourierScale_hasDerivAt (test : SchwartzMap ℝ ℂ) :
    HasDerivAt (fun u : ℝ => (Lp.toTemperedDistributionCLM ℂ volume 2
      (fourierL2 (burnolSourceScalePrimitive burnolUnitCountingPrimitiveL2 u))) test)
      (coPoissonMuntzScaleRemainder test 1) 1 := by
  have regular := burnolRemainderKernel_continuousAt test 1 (by norm_num)
  have measured : StronglyMeasurableAtFilter (coPoissonMuntzScaleRemainder test) (𝓝 1) volume :=
    ContinuousAt.stronglyMeasurableAtFilter isOpen_Ioi
      (fun u hu => burnolRemainderKernel_continuousAt test u hu) 1 (by norm_num : (1 : ℝ) ∈ Ioi 0)
  have integralLaw := intervalIntegral.integral_hasDerivAt_right
    (show IntervalIntegrable (coPoissonMuntzScaleRemainder test) volume 1 1 by simp) measured regular
  have generated := integralLaw.const_add
    ((Lp.toTemperedDistributionCLM ℂ volume 2 (fourierL2 burnolUnitCountingPrimitiveL2)) test)
  apply generated.congr_of_eventuallyEq
  filter_upwards [Ioo_mem_nhds (by norm_num : (0 : ℝ) < 1) (by norm_num : (1 : ℝ) < 4)] with u hu
  have actual := burnolCountingFourierScale_difference test u hu.1 hu.2.le
  exact (eq_add_of_sub_eq actual).trans (add_comm _ _)

end
