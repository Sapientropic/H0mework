import H0mework.Arithmetic.Muntz.CoPoissonSchwartzEnergyAction
import H0mework.Versions.V2.Arithmetic.SonineGap.ZeroBalancedSonineAnnihilation

/-!
# Common balanced co-Poisson energy face

A parameter-independent quarter-energy map sends the fixed two-gap source
into one complete Hilbert carrier.  Source Fourier and energy reflection form
an invertible strict square, so the generated closed range and its orthogonal
face are canonical and balanced.
-/

set_option autoImplicit false
set_option maxHeartbeats 500000

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalRiemann
namespace ClozelGeneralizedDual

open Complex FourierTransform MeasureTheory
open SourceGeneratedHilbertCokernel
open scoped SchwartzMap RealInnerProductSpace

noncomputable section

/-! ## Common, parameter-independent quarter-energy closure -/

/-- A fixed interior parameter is used only to reuse the already generated
lawful quarter-`L²` landing.  The resulting value is the parameter-independent
co-Poisson quarter chart in `PositiveMellinQuarterEnergy`. -/
def coPoissonQuarterEnergyMap :
    SonineSchwartz →ₗ[ℂ] PositiveMellinQuarterEnergy :=
  (quarterMellinL2Feature (1 / 4 : ℂ)).comp
    (coPoissonQuarterMellinConvergentMap
      (1 / 4 : ℂ) (by norm_num) (by norm_num))

theorem coPoissonQuarterEnergyMap_eq_lpValue
    (test : SonineSchwartz) :
    coPoissonQuarterEnergyMap test =
      positiveMellinQuarterLpValue (coPoissonQuarterMellinL2Map test) := by
  rfl

theorem coPoissonQuarterEnergyMap_eq_feature
    (z : ℂ) (positive : 0 < z.re) (belowHalf : z.re < (1 / 2 : ℝ))
    (test : SonineSchwartz) :
    coPoissonQuarterEnergyMap test =
      quarterMellinL2Feature z
        (coPoissonQuarterMellinConvergentMap
          z positive belowHalf test) := by
  let fixed := coPoissonQuarterMellinConvergentMap
    (1 / 4 : ℂ) (by norm_num) (by norm_num) test
  let varying := coPoissonQuarterMellinConvergentMap
    z positive belowHalf test
  change fixed.2.1.toLp
      (positiveMellinLogQuarterTransform fixed.1) =
    varying.2.1.toLp
      (positiveMellinLogQuarterTransform varying.1)
  exact MemLp.toLp_congr fixed.2.1 varying.2.1
    (ae_of_all (volume : Measure ℝ) fun _ => rfl)

/-- Source Fourier is exactly energy reflection in the common Hilbert
carrier. -/
theorem coPoissonQuarterEnergyMap_fourier_reflection
    (test : SonineSchwartz) :
    positiveMellinQuarterEnergyReflection (coPoissonQuarterEnergyMap test) =
      coPoissonQuarterEnergyMap (𝓕 test) := by
  rw [coPoissonQuarterEnergyMap_eq_lpValue,
    coPoissonQuarterEnergyMap_eq_lpValue]
  have tate : coPoissonQuarterMellinL2Map (𝓕 test) =
      positiveMellinQuarterL2Tate (coPoissonQuarterMellinL2Map test) := by
    apply Subtype.ext
    exact coPoissonQuarterMellinMap_fourier_tate test
  rw [tate, positiveMellinQuarterLpValue_tate]
  rfl

/-- Restriction of the common co-Poisson energy map to the actual balanced
Sonine source. -/
def stageZeroBalancedQuarterEnergyMap :
    StageZeroBalancedSonineSource →ₗ[ℂ] PositiveMellinQuarterEnergy :=
  coPoissonQuarterEnergyMap.comp
    (sonineTwoGapFace 1 1).toSubmodule.subtype

/-- The fixed Fourier/reflection square on the same source-generated energy
map. -/
def stageZeroBalancedQuarterFourierSquare :
    SourceGeneratedHilbertCokernel.ActionSquare
      stageZeroBalancedQuarterEnergyMap where
  sourceAction := stageZeroBalancedSonineFourierEquiv
  targetAction := positiveMellinQuarterEnergyReflectionIsometry
  commutes := by
    intro source
    exact coPoissonQuarterEnergyMap_fourier_reflection source

/-- The actual common Hilbert closure generated by balanced co-Poisson
sources.  It is independent of selected/reversal Mellin parameters. -/
def stageZeroBalancedQuarterEnergyClosure :
    ClosedSubmodule ℂ PositiveMellinQuarterEnergy :=
  SourceGeneratedHilbertCokernel.closedRange
    stageZeroBalancedQuarterEnergyMap

theorem stageZeroBalancedQuarterEnergyMap_mem_closure
    (source : StageZeroBalancedSonineSource) :
    stageZeroBalancedQuarterEnergyMap source ∈
      stageZeroBalancedQuarterEnergyClosure := by
  exact (LinearMap.range stageZeroBalancedQuarterEnergyMap).le_topologicalClosure
    ⟨source, rfl⟩

theorem stageZeroBalancedQuarterEnergyClosure_reflection
    {value : PositiveMellinQuarterEnergy}
    (membership : value ∈ stageZeroBalancedQuarterEnergyClosure) :
    positiveMellinQuarterEnergyReflection value ∈
      stageZeroBalancedQuarterEnergyClosure := by
  exact stageZeroBalancedQuarterFourierSquare.toIsometricSquare.target_mem_closedRange
    membership

theorem stageZeroBalancedQuarterEnergyClosure_fourier_invariant :
    stageZeroBalancedQuarterEnergyClosure.mapEquiv
        positiveMellinQuarterEnergyReflectionIsometry.toContinuousLinearEquiv =
      stageZeroBalancedQuarterEnergyClosure :=
  stageZeroBalancedQuarterFourierSquare.closedRange_invariant

/-- Closed orthogonal compression face of the same common Hilbert carrier. -/
def stageZeroBalancedQuarterEnergyOrthogonalFace :
    ClosedSubmodule ℂ PositiveMellinQuarterEnergy where
  toSubmodule := Submodule.orthogonal
    stageZeroBalancedQuarterEnergyClosure.toSubmodule
  isClosed' := by
    exact stageZeroBalancedQuarterEnergyClosure.toSubmodule.isClosed_orthogonal

abbrev StageZeroBalancedQuarterEnergyOrthogonalCarrier :=
  stageZeroBalancedQuarterEnergyOrthogonalFace.toSubmodule

/-- Canonical centered projection onto the common balanced orthogonal face. -/
def stageZeroBalancedQuarterEnergyProjection :
    PositiveMellinQuarterEnergy →L[ℂ]
      StageZeroBalancedQuarterEnergyOrthogonalCarrier :=
  stageZeroBalancedQuarterEnergyOrthogonalFace.toSubmodule.orthogonalProjectionOnto

@[simp] theorem stageZeroBalancedQuarterEnergyProjection_mem
    (value : PositiveMellinQuarterEnergy) :
    (stageZeroBalancedQuarterEnergyProjection value :
      PositiveMellinQuarterEnergy) ∈
        stageZeroBalancedQuarterEnergyOrthogonalFace :=
  (stageZeroBalancedQuarterEnergyProjection value).property

end

end ClozelGeneralizedDual
end CanonicalRiemann
