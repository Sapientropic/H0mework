import H0mework.Versions.V2.Arithmetic.RiemannResolvent.CoordinateMatchedResolventProjectionLanding

/-!
# Exact-order resolvent of the coordinate-matched source

The zero order and the starting vector are generated by the same analytic
owner and normalized compact source.  Faithfulness of the right resolvent
therefore produces a nonzero exact-order feature-completion state.
-/

set_option autoImplicit false

namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace NoIslandNoMagic.CanonicalRiemann

open Complex
open SourceGeneratedComplexFeaturePerfectification
open ClozelGeneralizedDual
open ClozelGeneralizedDual.BurnolPhysicalState

noncomputable section

def zeroOwnedCoordinateMatchedCompletionSource
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    HilbertAmbient (quarterMellinL2Feature (observation.coordinate / 2)) :=
  burnolSourceQuarterCompletionValue
    (burnolCoordinateNormalizedAnnulusSource observation.coordinate)
    (observation.coordinate / 2)
    (selectedCoPoissonMuntzParameter_re_pos observation nontrivial)
    (selectedCoPoissonMuntzParameter_re_lt_half observation nontrivial)

theorem zeroOwnedCoordinateMatchedCompletionSource_ne_zero
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    zeroOwnedCoordinateMatchedCompletionSource observation nontrivial ≠ 0 := by
  intro completionZero
  have realizationZero := congrArg
    (hilbertAmbientRealization
      (quarterMellinL2Feature (observation.coordinate / 2))) completionZero
  unfold zeroOwnedCoordinateMatchedCompletionSource
    burnolSourceQuarterCompletionValue at realizationZero
  rw [hilbertAmbientRealization_source_readback, map_zero] at realizationZero
  exact burnolCoordinateNormalizedRelation_sourceEnergy_ne_zero
    observation.coordinate (observation.coordinate / 2)
    (selectedCoPoissonMuntzParameter_re_pos observation nontrivial)
    (selectedCoPoissonMuntzParameter_re_lt_half observation nontrivial)
    realizationZero

/-- Divide the source occurrence by the right generator exactly its analytic
Xi zero order. -/
def zeroOwnedCoordinateMatchedExactOrderCompletionResolvent
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    HilbertAmbient (quarterMellinL2Feature (observation.coordinate / 2)) :=
  quarterFeatureCompletionRightResolventIterate
    (observation.coordinate / 2)
    (generatedRiemannXiZeroOrder owner observation.coordinate)
    (zeroOwnedCoordinateMatchedCompletionSource observation nontrivial)

theorem zeroOwnedCoordinateMatchedExactOrderCompletionResolvent_ne_zero
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (rightHalf : 1 / 2 < observation.coordinate.re) :
    zeroOwnedCoordinateMatchedExactOrderCompletionResolvent
      observation nontrivial ≠ 0 := by
  apply quarterFeatureCompletionRightResolventIterate_ne_zero
  · rw [Complex.div_re]
    norm_num
    linarith
  · exact zeroOwnedCoordinateMatchedCompletionSource_ne_zero
      observation nontrivial

def zeroOwnedCoordinateMatchedExactOrderPhysicalState
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    BurnolPaAmbientCarrier :=
  burnolSourceFeatureCompletionPhysicalMap (observation.coordinate / 2)
    (zeroOwnedCoordinateMatchedExactOrderCompletionResolvent
      observation nontrivial)

/-- The exact-order state obeys the installed projection square directly;
the remaining frontier is nonvanishing of its `P_a⊥` residual. -/
theorem zeroOwnedCoordinateMatchedExactOrderPhysical_projectionPreservation
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (shift : ℝ) :
    burnolSourceFeatureCompletionPhysicalMap (observation.coordinate / 2)
        (quarterFeatureCompletionTranslation (observation.coordinate / 2) shift
          (zeroOwnedCoordinateMatchedExactOrderCompletionResolvent
            observation nontrivial)) =
      burnolEvenAmbientProjection
        (burnolMultiplicativeDilation (-shift / 2)
          (quarterMellinFeatureCompletionEvenAdditive
            (observation.coordinate / 2)
            (zeroOwnedCoordinateMatchedExactOrderCompletionResolvent
              observation nontrivial))) :=
  burnolSourceFeatureCompletionPhysicalMap_translation
    (observation.coordinate / 2) shift _

end
end NoIslandNoMagic.CanonicalRiemann
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
