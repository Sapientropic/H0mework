import H0mework.Versions.V2.Arithmetic.RiemannCharacter.ZeroRieszFullCharacter
import H0mework.Versions.R2.Arithmetic.MuntzAction.CoPoissonMuntzDilationActionLaws

/-!
# Integral charge orbit in the actual quarter-Mellin graph target

Every basis event of `ℤ[(ℝ₊)×]` is sent to the existing functional graph
of the actually dilated normalized Müntz shell.  Its first coordinate is the
owner-free coherent energy orbit; its second coordinate is the source-owned
Mellin measurement.  Selected and reversal are sibling features of the same
graph target rather than independently glued scalar shadows.
-/

set_option autoImplicit false
set_option maxHeartbeats 3000000

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalRiemann
namespace ClozelGeneralizedDual
namespace CenteredGram

open Character
open Character.GlobalCoPoissonCurrent
open Character.IntegralCharacterGroupRing
open ThetaJRoleRepresentation
open SourceGeneratedFunctionalGraphPerfectification
open SourceGeneratedIntegralCharacterGroupRing

noncomputable section

abbrev JointGraphTarget := GraphTarget PositiveMellinQuarterEnergy

@[simp] theorem scaleSquare_mul (left right : Units NNReal) :
    scaleSquare (left * right) = scaleSquare left * scaleSquare right := by
  unfold scaleSquare
  rw [scaleValue_mul]
  ring

theorem log_scaleSquare_mul (left right : Units NNReal) :
    Real.log (scaleSquare (left * right)) =
      Real.log (scaleSquare left) + Real.log (scaleSquare right) := by
  rw [scaleSquare_mul, Real.log_mul
    (ne_of_gt (scaleSquare_pos left)) (ne_of_gt (scaleSquare_pos right))]

/-- Selected actual graph point generated by one integral basis charge. -/
def selectedGraphOrbitBasis
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (scale : Units NNReal) : JointGraphTarget :=
  graphFeature
      (quarterMellinL2Feature
        (selectedCoPoissonMuntzParameter observation))
      (quarterMellinL2Functional
        (selectedCoPoissonMuntzParameter observation))
    (quarterDilationTestAction
      (selectedCoPoissonMuntzParameter observation)
      (scaleSquare scale) (scaleSquare_pos scale)
      (normalizedCoPoissonMuntzQuarterShellTest
        (selectedCoPoissonMuntzParameter observation)
        (selectedCoPoissonMuntzParameter_re_pos observation nontrivial)))

def reversalGraphOrbitBasis
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (scale : Units NNReal) : JointGraphTarget :=
  graphFeature
      (quarterMellinL2Feature
        (reversalCoPoissonMuntzParameter observation))
      (quarterMellinL2Functional
        (reversalCoPoissonMuntzParameter observation))
    (quarterDilationTestAction
      (reversalCoPoissonMuntzParameter observation)
      (scaleSquare scale) (scaleSquare_pos scale)
      (normalizedCoPoissonMuntzQuarterShellTest
        (reversalCoPoissonMuntzParameter observation)
        (reversalCoPoissonMuntzParameter_re_pos observation nontrivial)))

/-- Integral charge extends the selected actual graph orbit linearly. -/
def selectedIntegralGraphOrbit
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    IntegralScaleCarrier →ₗ[ℤ] JointGraphTarget :=
  canonicalBasis.constr ℤ (selectedGraphOrbitBasis observation nontrivial)

def reversalIntegralGraphOrbit
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    IntegralScaleCarrier →ₗ[ℤ] JointGraphTarget :=
  canonicalBasis.constr ℤ (reversalGraphOrbitBasis observation nontrivial)

/-- Both involutive zero faces land in sibling copies of one carrier. -/
def zeroOwnedJointIntegralGraphOrbit
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    IntegralScaleCarrier →ₗ[ℤ] JointGraphTarget × JointGraphTarget :=
  (selectedIntegralGraphOrbit observation nontrivial).prod
    (reversalIntegralGraphOrbit observation nontrivial)

@[simp] theorem selectedIntegralGraphOrbit_delta
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (scale : Units NNReal) :
    selectedIntegralGraphOrbit observation nontrivial (delta scale) =
      selectedGraphOrbitBasis observation nontrivial scale := by
  rw [← canonicalBasis_apply scale]
  exact canonicalBasis.constr_basis ℤ _ scale

@[simp] theorem reversalIntegralGraphOrbit_delta
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (scale : Units NNReal) :
    reversalIntegralGraphOrbit observation nontrivial (delta scale) =
      reversalGraphOrbitBasis observation nontrivial scale := by
  rw [← canonicalBasis_apply scale]
  exact canonicalBasis.constr_basis ℤ _ scale

theorem selectedGraphOrbitBasis_fst
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (scale : Units NNReal) :
    (selectedGraphOrbitBasis observation nontrivial scale).fst =
      positiveMellinQuarterEnergyTranslation
        (Real.log (scaleSquare scale))
        (quarterMellinL2Feature
          (selectedCoPoissonMuntzParameter observation)
          (normalizedCoPoissonMuntzQuarterShellTest
            (selectedCoPoissonMuntzParameter observation)
            (selectedCoPoissonMuntzParameter_re_pos
              observation nontrivial))) := by
  exact (LinearMap.congr_fun
    (quarterDilationFeature_covariance
      (selectedCoPoissonMuntzParameter observation)
      (scaleSquare scale) (scaleSquare_pos scale))
    (normalizedCoPoissonMuntzQuarterShellTest
      (selectedCoPoissonMuntzParameter observation)
      (selectedCoPoissonMuntzParameter_re_pos
        observation nontrivial))).symm

theorem reversalGraphOrbitBasis_fst
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (scale : Units NNReal) :
    (reversalGraphOrbitBasis observation nontrivial scale).fst =
      positiveMellinQuarterEnergyTranslation
        (Real.log (scaleSquare scale))
        (quarterMellinL2Feature
          (reversalCoPoissonMuntzParameter observation)
          (normalizedCoPoissonMuntzQuarterShellTest
            (reversalCoPoissonMuntzParameter observation)
            (reversalCoPoissonMuntzParameter_re_pos
              observation nontrivial))) := by
  exact (LinearMap.congr_fun
    (quarterDilationFeature_covariance
      (reversalCoPoissonMuntzParameter observation)
      (scaleSquare scale) (scaleSquare_pos scale))
    (normalizedCoPoissonMuntzQuarterShellTest
      (reversalCoPoissonMuntzParameter observation)
      (reversalCoPoissonMuntzParameter_re_pos
        observation nontrivial))).symm

theorem selectedGraphOrbitBasis_snd
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (scale : Units NNReal) :
    (selectedGraphOrbitBasis observation nontrivial scale).snd =
      quarterDilationCharacter
        (selectedCoPoissonMuntzParameter observation)
        (scaleSquare scale) := by
  have eigen := LinearMap.congr_fun
    (quarterDilationFunctional_eigenlaw
      (selectedCoPoissonMuntzParameter observation)
      (scaleSquare scale) (scaleSquare_pos scale))
    (normalizedCoPoissonMuntzQuarterShellTest
      (selectedCoPoissonMuntzParameter observation)
      (selectedCoPoissonMuntzParameter_re_pos observation nontrivial))
  simpa [selectedGraphOrbitBasis, quarterDilationCharacter] using eigen

theorem reversalGraphOrbitBasis_snd
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (scale : Units NNReal) :
    (reversalGraphOrbitBasis observation nontrivial scale).snd =
      quarterDilationCharacter
        (reversalCoPoissonMuntzParameter observation)
        (scaleSquare scale) := by
  have eigen := LinearMap.congr_fun
    (quarterDilationFunctional_eigenlaw
      (reversalCoPoissonMuntzParameter observation)
      (scaleSquare scale) (scaleSquare_pos scale))
    (normalizedCoPoissonMuntzQuarterShellTest
      (reversalCoPoissonMuntzParameter observation)
      (reversalCoPoissonMuntzParameter_re_pos observation nontrivial))
  simpa [reversalGraphOrbitBasis, quarterDilationCharacter] using eigen

theorem quarterDilationCharacter_scaleSquare_mul
    (z : ℂ) (left right : Units NNReal) :
    quarterDilationCharacter z (scaleSquare (left * right)) =
      quarterDilationCharacter z (scaleSquare left) *
        quarterDilationCharacter z (scaleSquare right) := by
  rw [scaleSquare_mul]
  exact quarterDilationCharacter_mul z
    (scaleSquare left) (scaleSquare right)
    (scaleSquare_pos left) (scaleSquare_pos right)

end


end CenteredGram
end ClozelGeneralizedDual
end CanonicalRiemann
end NoIslandNoMagic
end ConstructiveRoot
end LivingLawEvolution
