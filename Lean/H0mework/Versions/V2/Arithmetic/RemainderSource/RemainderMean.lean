import H0mework.Versions.V2.Arithmetic.MobiusSource.Tate

/-! The two gap means are generated by the same recovered source. -/

set_option autoImplicit false

namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.BurnolPhysicalState
open Complex MeasureTheory Set
open scoped InnerProductSpace
noncomputable section
local notation "Ambient" => EvenBurnolPhysicalCarrier burnolUnscaledCommonGapRadius

def burnolSourceWindowIntegral : BurnolL2 →L[ℂ] ℂ :=
  (innerSL ℂ (intervalConstant 4)).comp (burnolRadiusRestriction 4)

private theorem sourceWindowIntegral_compact (source : burnolCompactAnnulusSource) :
    burnolSourceWindowIntegral (burnolMobiusSourceL2 (burnolCompactAdditivePhysicalState source)) =
      ∫ x : ℝ, (burnolCompactTateReciprocalSource source).1 x := by
  let reciprocal := burnolCompactTateReciprocalSource source
  let value := burnolMobiusSourceL2 (burnolCompactAdditivePhysicalState source)
  change inner ℂ (intervalConstant 4) (burnolRadiusRestriction 4 value) = _
  rw [L2.inner_def]
  calc
    _ = ∫ x : ℝ in symmetricInterval 4, reciprocal.1 x := by
      apply integral_congr_ae
      filter_upwards [intervalConstant_coeFn (4 : ℝ),
        LpToLpRestrictCLM_coeFn ℂ (symmetricInterval (4 : ℝ)) value,
        ae_restrict_of_ae (s := symmetricInterval (4 : ℝ))
          (burnolMobiusSourceExtension_compact_coeFn source)]
            with x hconstant hrestriction hsource
      have sourceEq : value x = reciprocal.1 x :=
        hsource.trans (burnolCompactTateReciprocalSchwartz_apply source x).symm
      change inner ℂ (intervalConstant 4 x) (burnolRadiusRestriction 4 value x) = _
      rw [hconstant]
      have restrictionEq : burnolRadiusRestriction 4 value x = reciprocal.1 x :=
        hrestriction.trans sourceEq
      rw [restrictionEq]
      simp
    _ = ∫ x : ℝ, reciprocal.1 x := by
      apply setIntegral_eq_integral_of_forall_compl_eq_zero
      intro x outside
      apply reciprocal.2.2.2 x
      have large : ¬ |x| ≤ 4 := fun bound => outside (abs_le.mp bound)
      exact le_of_not_ge large

private theorem fourierMean_compact (source : burnolCompactAnnulusSource) :
    burnolConstantGapCoefficient burnolUnscaledCommonGapRadius
      (evenFaceFourierEquiv burnolUnscaledCommonGapRadius
        (burnolCompactAdditivePhysicalState source)) =
      (-1 / 2 : ℂ) * burnolSourceWindowIntegral
        (burnolMobiusSourceL2 (burnolCompactAdditivePhysicalState source)) := by
  have sameSource : evenFaceFourierEquiv burnolUnscaledCommonGapRadius
      (burnolCompactAdditivePhysicalState source) =
      burnolCompactAdditivePhysicalState (burnolCompactTateReciprocalSource source) := by
    apply Subtype.ext
    exact burnolCompactFourierL2_eq_reciprocalL2 source
  rw [sameSource, burnolCompactGapCoefficient,
    burnolCompactAdditiveCoSum_eq_neg_normalization_of_abs_le_quarter
      (burnolCompactTateReciprocalSource source) (t := 0) (by norm_num)]
  rw [sourceWindowIntegral_compact]
  unfold burnolCompactAdditiveNormalization
  ring

/-- The Fourier mean is produced from the source, rather than carried as a
separate scalar beside the source reconstruction. -/
theorem burnolPaFourierMean_from_source (value : Ambient)
    (inPa : value ∈ burnolCompactCoPoissonClosedRange) :
    burnolConstantGapCoefficient burnolUnscaledCommonGapRadius
      (evenFaceFourierEquiv burnolUnscaledCommonGapRadius value) =
      (-1 / 2 : ℂ) * burnolSourceWindowIntegral (burnolMobiusSourceL2 value) := by
  let left := (burnolConstantGapCoefficient burnolUnscaledCommonGapRadius).comp
    (evenFaceFourierEquiv burnolUnscaledCommonGapRadius).toContinuousLinearEquiv.toContinuousLinearMap
  let right := (-1 / 2 : ℂ) • burnolSourceWindowIntegral.comp burnolMobiusSourceL2
  let equation := (left - right).ker
  have generatorEq (index : BurnolCompactCoPoissonGeneratorIndex) :
      left (burnolCompactCoPoissonGenerator index) =
        right (burnolCompactCoPoissonGenerator index) := by
    rcases index with ⟨source, parity⟩
    fin_cases parity
    · exact fourierMean_compact source
    · have sameSource : burnolCompactCoPoissonGenerator (source, (1 : Fin 2)) =
          burnolCompactAdditivePhysicalState (burnolCompactTateReciprocalSource source) := by
        apply Subtype.ext
        exact burnolCompactFourierL2_eq_reciprocalL2 source
      change left (burnolCompactCoPoissonGenerator (source, (1 : Fin 2))) =
        right (burnolCompactCoPoissonGenerator (source, (1 : Fin 2)))
      rw [sameSource]
      exact fourierMean_compact (burnolCompactTateReciprocalSource source)
  have sourceEq (input : BurnolCompactCoPoissonLinearSource) :
      left (burnolCompactCoPoissonLanding input) =
        right (burnolCompactCoPoissonLanding input) := by
    induction input using Finsupp.induction_linear with
    | zero => simp
    | add a b ha hb => simp only [map_add, ha, hb]
    | single index coefficient =>
        rw [burnolCompactCoPoissonLanding_single, map_smul, map_smul, generatorEq]
  have rangeLe : LinearMap.range burnolCompactCoPoissonLanding ≤ equation := by
    rintro _ ⟨input, rfl⟩
    change left (burnolCompactCoPoissonLanding input) -
      right (burnolCompactCoPoissonLanding input) = 0
    rw [sourceEq, sub_self]
  have closed : IsClosed (equation : Set Ambient) := by
    change IsClosed {input : Ambient | left input - right input = 0}
    exact isClosed_eq (left.continuous.sub right.continuous) continuous_const
  have included := (LinearMap.range burnolCompactCoPoissonLanding).topologicalClosure_minimal
    rangeLe closed
  have actual := included inPa
  change left value - right value = 0 at actual
  exact sub_eq_zero.mp actual

theorem burnolPaPositionMean_from_source (value : Ambient)
    (inPa : value ∈ burnolCompactCoPoissonClosedRange) :
    burnolConstantGapCoefficient burnolUnscaledCommonGapRadius value =
      (-1 / 2 : ℂ) * burnolSourceWindowIntegral
        (burnolTateReciprocalL2 (burnolMobiusSourceL2 value)) := by
  have generated := burnolPaFourierMean_from_source
    (evenFaceFourierEquiv burnolUnscaledCommonGapRadius value)
    (burnolCompactCoPoissonActionSquare.toIsometricSquare.target_mem_closedRange inPa)
  rw [show evenFaceFourierEquiv burnolUnscaledCommonGapRadius
      (evenFaceFourierEquiv burnolUnscaledCommonGapRadius value) = value from
        evenFaceFourier_involutive burnolUnscaledCommonGapRadius value,
    burnolMobiusSource_fourier value inPa] at generated
  exact generated

/-- A finite observation is now generated from ν alone, including the
source-owned pole/constant mode. -/
def burnolSourceOnlyCoPoissonWindow (radius : ℝ) :
    BurnolL2 →L[ℂ] BurnolRadiusIntervalL2 radius :=
  (∑ m ∈ burnolCenteredMobiusCutoffFinset radius,
    (((m : ℕ) : ℂ)⁻¹) • burnolWindowScalePullback radius m) +
    (ContinuousLinearMap.toSpanSingleton ℂ (intervalConstant radius)).comp
      ((-1 / 2 : ℂ) • burnolSourceWindowIntegral.comp burnolTateReciprocalL2)

/-- The original complete Pa value, not only its projected action, is
recovered in every window from this single source. -/
theorem burnolSourceOnlyCoPoissonWindow_replay (radius : ℝ) (value : Ambient)
    (inPa : value ∈ burnolCompactCoPoissonClosedRange) :
    burnolSourceOnlyCoPoissonWindow radius (burnolMobiusSourceL2 value) =
      burnolRadiusRestriction radius (value : BurnolL2) := by
  rw [← burnolCoPoissonWindowReplay_Pa radius value inPa]
  simp only [burnolSourceOnlyCoPoissonWindow, burnolCoPoissonWindowReplay,
    sum_apply, add_apply, smul_apply, ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.toSpanSingleton_apply]
  rw [burnolPaPositionMean_from_source value inPa]
  rfl

end
end NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.BurnolPhysicalState
