import H0mework.Versions.V2.Arithmetic.BurnolMellin.CompletedMellinPrimaryGenerator

/-! # Complementary Mellin zero generated by a right-half zeta zero -/

set_option autoImplicit false
set_option maxHeartbeats 1000000

namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.BurnolPhysicalState

open Complex

noncomputable section

theorem riemannZeta_one_sub_eq_zero_of_rightHalfZero
    (coordinate : BurnolCompletedMellinCoordinate)
    (zero : riemannZeta coordinate.value = 0) :
    riemannZeta (1 - coordinate.value) = 0 := by
  have coordinateNe : coordinate.value ≠ 0 := by
    intro equality
    have realZero := congrArg Complex.re equality
    norm_num at realZero
    linarith [coordinate.rightHalf]
  have completedZero : completedRiemannZeta coordinate.value = 0 := by
    rw [riemannZeta_def_of_ne_zero coordinateNe] at zero
    exact (div_eq_zero_iff.mp zero).resolve_right
      (Gammaℝ_ne_zero_of_re_pos (by linarith [coordinate.rightHalf]))
  have complementPositive : 0 < (1 - coordinate.value).re := by
    simp only [sub_re, one_re]
    linarith [coordinate.belowOne]
  have complementNe : 1 - coordinate.value ≠ 0 := by
    intro equality
    rw [equality] at complementPositive
    norm_num at complementPositive
  rw [riemannZeta_def_of_ne_zero complementNe,
    completedRiemannZeta_one_sub, completedZero, zero_div]

theorem burnolCompactAdditiveMellinRead_one_sub_eq_zero
    (source : burnolCompactAnnulusSource)
    (coordinate : BurnolCompletedMellinCoordinate)
    (zero : riemannZeta coordinate.value = 0) :
    burnolCompactAdditiveMellinRead source (1 - coordinate.value) = 0 := by
  have complementPositive : 0 < (1 - coordinate.value).re := by
    simp only [sub_re, one_re]
    linarith [coordinate.belowOne]
  have complementBelowOne : (1 - coordinate.value).re < 1 := by
    simp only [sub_re, one_re]
    linarith [coordinate.rightHalf]
  have factorization := coPoissonMuntzScaleRemainder_mellin_factorization
    source.1 complementPositive complementBelowOne
  rw [riemannZeta_one_sub_eq_zero_of_rightHalfZero coordinate zero,
    zero_mul] at factorization
  have relation := two_mul_burnolCompactAdditiveMellinRead_eq_mellin
    source (1 - coordinate.value)
  rw [factorization] at relation
  exact (mul_eq_zero.mp relation).resolve_left (by norm_num)

end
end NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.BurnolPhysicalState
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
