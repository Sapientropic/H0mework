import H0mework.Versions.V2.Arithmetic.SonineProjection.ProjectionFormula

/-!
# Single Fourier forcing generated by the completed-Mellin kernel

The actual tail vanishes on the protected interval and the gap term restricts
to a constant.  Thus the position forcing is zero before the Sonine solve.
The existing mean-zero Fourier block generates one source, satisfying
`(1 - T²) b = Fourier forcing`, and reconstructs the same physical Riesz state.
-/

set_option autoImplicit false

namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.BurnolPhysicalState
open Complex MeasureTheory Set
open scoped ENNReal InnerProductSpace
noncomputable section

theorem burnolRadiusMellinTailKernel_restrict_zero
    (radius : ℝ) (positive : 0 < radius)
    (coordinate : ℂ) (rightHalf : 1 / 2 < coordinate.re) :
    restrictToInterval radius
      (burnolRadiusMellinTailKernelL2 radius positive coordinate rightHalf) = 0 := by
  apply Lp.ext
  have restrictionRead := LpToLpRestrictCLM_coeFn ℂ
    (symmetricInterval radius)
    (burnolRadiusMellinTailKernelL2 radius positive coordinate rightHalf)
  have rawRead := ae_restrict_of_ae (s := symmetricInterval radius)
    (MemLp.coeFn_toLp (burnolRadiusMellinTailKernelRaw_memLp positive coordinate rightHalf))
  have inside := ae_restrict_mem (μ := (volume : Measure ℝ))
    (measurableSet_symmetricInterval radius)
  filter_upwards [restrictionRead, rawRead, inside,
      Lp.coeFn_zero ℂ 2 (volume.restrict (symmetricInterval radius))]
    with x restricted raw hx hz
  change restrictToInterval radius
    (burnolRadiusMellinTailKernelL2 radius positive coordinate rightHalf) x = _ at restricted
  rw [restricted]
  change burnolRadiusMellinTailKernelL2 radius positive coordinate rightHalf x =
    burnolRadiusMellinTailKernelRaw radius coordinate x at raw
  rw [raw]
  rw [hz]
  simp only [symmetricInterval, mem_Icc] at hx
  simp [burnolRadiusMellinTailKernelRaw, not_lt.mpr hx.2]

theorem burnolAmbientGapRieszVector_restrict (radius : ℝ) :
    restrictToInterval radius (burnolAmbientGapRieszVector radius) =
      star ((‖intervalConstant radius‖ ^ 2 : ℂ)⁻¹) • intervalConstant radius := by
  unfold burnolAmbientGapRieszVector
  rw [map_smul]
  congr 1
  exact burnolRadiusRestriction_zeroExtension (intervalConstant radius)

theorem burnolAmbientMellinKernel_restrict_mem_constant (coordinate : BurnolCompletedMellinCoordinate) :
    burnolQuarterRestriction (burnolAmbientCompletedMellinKernelFormula coordinate) ∈
      intervalConstantLine (1 / 4 : ℝ) := by
  unfold burnolAmbientCompletedMellinKernelFormula
    burnolRadiusAmbientCompletedMellinKernelFormula
  change restrictToInterval (1 / 4 : ℝ)
      (star (burnolRadiusMellinGapMoment (1 / 4 : ℝ) coordinate.value) •
        burnolAmbientGapRieszVector (1 / 4 : ℝ) +
        burnolRadiusMellinTailKernelL2 (1 / 4 : ℝ) (by norm_num)
          coordinate.value coordinate.rightHalf) ∈ _
  rw [map_add, map_smul, burnolRadiusMellinTailKernel_restrict_zero,
    burnolAmbientGapRieszVector_restrict, add_zero, smul_smul]
  exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)

theorem burnolAmbientMellinKernel_even_restrict_mem_constant (coordinate : BurnolCompletedMellinCoordinate) :
    burnolQuarterRestriction
        (burnolAmbientEvenPart (burnolAmbientCompletedMellinKernelFormula coordinate)) ∈
      intervalConstantLine (1 / 4 : ℝ) := by
  unfold burnolAmbientEvenPart
  rw [map_smul, map_add]
  apply Submodule.smul_mem
  apply Submodule.add_mem
  · exact burnolAmbientMellinKernel_restrict_mem_constant coordinate
  · change restrictToInterval (1 / 4 : ℝ)
      (reflectL2 (burnolAmbientCompletedMellinKernelFormula coordinate)) ∈ _
    rw [restrictToInterval_reflectL2]
    exact reflectRestricted_quarter_preserves_constantLine
      (burnolAmbientMellinKernel_restrict_mem_constant coordinate)

theorem burnolAmbientMellinKernel_meanZeroPosition_zero (coordinate : BurnolCompletedMellinCoordinate) :
    burnolAmbientMeanZeroPosition (burnolAmbientCompletedMellinKernelFormula coordinate) = 0 := by
  apply Subtype.ext
  change burnolQuarterMeanZeroProjection
      (burnolQuarterRestriction
        (burnolAmbientEvenPart (burnolAmbientCompletedMellinKernelFormula coordinate))) = 0
  exact (burnolQuarterMeanZeroProjection_eq_zero_iff _).mpr
    (burnolAmbientMellinKernel_even_restrict_mem_constant coordinate)

theorem burnolAmbientMellinKernel_firstCorrection_eq_neg_fourier_second
    (coordinate : BurnolCompletedMellinCoordinate) :
    burnolAmbientMeanZeroFirstCorrection (burnolAmbientCompletedMellinKernelFormula coordinate) =
      -burnolMeanZeroTruncatedFourier
        (burnolAmbientMeanZeroSecondCorrection
          (burnolAmbientCompletedMellinKernelFormula coordinate)) := by
  have equation := burnolMeanZeroBlock_first_equation
    (burnolAmbientMeanZeroBlockRhs (burnolAmbientCompletedMellinKernelFormula coordinate))
  change burnolAmbientMeanZeroFirstCorrection _ +
    burnolMeanZeroTruncatedFourier (burnolAmbientMeanZeroSecondCorrection _) =
    burnolAmbientMeanZeroPosition _ at equation
  rw [burnolAmbientMellinKernel_meanZeroPosition_zero] at equation
  exact eq_neg_of_add_eq_zero_left equation

def burnolRieszSingleFourierSource (coordinate : BurnolCompletedMellinCoordinate) :
    BurnolQuarterMeanZeroCarrier :=
  burnolMeanZeroBlockInverse
    (burnolAmbientMeanZeroFourier (burnolAmbientCompletedMellinKernelFormula coordinate))

theorem burnolRieszSingleFourierSource_equation (coordinate : BurnolCompletedMellinCoordinate) :
    burnolMeanZeroOneMinusSquare (burnolRieszSingleFourierSource coordinate) =
      burnolAmbientMeanZeroFourier (burnolAmbientCompletedMellinKernelFormula coordinate) := by
  unfold burnolRieszSingleFourierSource
  rw [← mul_apply_eq_comp, burnolMeanZeroBlockInverse_right]
  rfl

theorem burnolAmbientMellinKernel_secondCorrection_eq_singleSource
    (coordinate : BurnolCompletedMellinCoordinate) :
    burnolAmbientMeanZeroSecondCorrection (burnolAmbientCompletedMellinKernelFormula coordinate) =
      burnolRieszSingleFourierSource coordinate := by
  let actualSecond :=
    burnolAmbientMeanZeroSecondCorrection (burnolAmbientCompletedMellinKernelFormula coordinate)
  have equation := burnolMeanZeroBlock_second_equation
    (burnolAmbientMeanZeroBlockRhs (burnolAmbientCompletedMellinKernelFormula coordinate))
  change burnolMeanZeroTruncatedFourier (burnolAmbientMeanZeroFirstCorrection _) +
    burnolAmbientMeanZeroSecondCorrection _ = burnolAmbientMeanZeroFourier _ at equation
  rw [burnolAmbientMellinKernel_firstCorrection_eq_neg_fourier_second, map_neg] at equation
  have solved : burnolMeanZeroOneMinusSquare actualSecond =
      burnolAmbientMeanZeroFourier (burnolAmbientCompletedMellinKernelFormula coordinate) := by
    change actualSecond -
      burnolMeanZeroTruncatedFourier (burnolMeanZeroTruncatedFourier actualSecond) = _
    exact (sub_eq_add_neg _ _).trans ((add_comm _ _).trans equation)
  have inverseLeft : burnolMeanZeroBlockInverse * burnolMeanZeroOneMinusSquare = 1 :=
    Ring.inverse_mul_cancel _ burnolMeanZeroOneMinusSquare_isUnit
  change actualSecond = _
  calc
    actualSecond = (burnolMeanZeroBlockInverse * burnolMeanZeroOneMinusSquare) actualSecond := by
      rw [inverseLeft]
      rfl
    _ = burnolMeanZeroBlockInverse
        (burnolAmbientMeanZeroFourier (burnolAmbientCompletedMellinKernelFormula coordinate)) := by
      rw [mul_apply_eq_comp, solved]
    _ = burnolRieszSingleFourierSource coordinate := rfl

/-- The physical Riesz state is generated by one actual Fourier forcing,
not by an independently chosen pair of projection corrections. -/
theorem burnolCompletedMellinRieszVector_eq_singleFourierSource (coordinate : BurnolCompletedMellinCoordinate) :
    (burnolCompletedMellinRieszVector coordinate : BurnolL2) =
      burnolAmbientEvenPart (burnolAmbientCompletedMellinKernelFormula coordinate) +
        burnolAmbientEvenPart
          (burnolQuarterZeroExtension
              (burnolMeanZeroTruncatedFourier (burnolRieszSingleFourierSource coordinate) :
                BurnolQuarterIntervalL2) -
            fourierL2 (burnolQuarterZeroExtension
              (burnolRieszSingleFourierSource coordinate : BurnolQuarterIntervalL2))) := by
  rw [burnolCompletedMellinRieszVector_eq_resolventFormula]
  unfold burnolAmbientExtendedSonineProjectionFormula
    burnolAmbientEvenMeanZeroCorrection burnolAmbientRawMeanZeroCorrection
  rw [burnolAmbientMellinKernel_firstCorrection_eq_neg_fourier_second,
    burnolAmbientMellinKernel_secondCorrection_eq_singleSource]
  change burnolAmbientEvenPart _ -
      burnolAmbientEvenPart
        (burnolQuarterZeroExtension
            (-burnolMeanZeroTruncatedFourier (burnolRieszSingleFourierSource coordinate) :
              BurnolQuarterIntervalL2) +
          fourierL2 (burnolQuarterZeroExtension
            (burnolRieszSingleFourierSource coordinate : BurnolQuarterIntervalL2))) = _
  unfold burnolAmbientEvenPart
  simp only [map_add, map_sub, map_neg]
  module


end
end NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.BurnolPhysicalState
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
