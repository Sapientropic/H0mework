local notation "L¹" => Lp ℂ 1 (volume : Measure ℝ)
local notation "S'" => TemperedDistribution ℝ ℂ
local notation "q" => (1/4 : ℝ)
local notation "r₀" => (q/2)
local notation "box" => symmetricInterval r₀
local notation "barC" => OriginalPrimitiveRankBalance.conjugateCoordinate
local notation "s₀" => fun c => star (BurnolCompletedMellinCoordinate.value c)
local notation "phase" => fun c (n : Nat) => ((n+2 : Nat) : ℂ)^(-s₀ c)
local notation "clock" => fun n : Nat => Real.log ((n+2 : Nat) : ℝ)
local notation "A" => fun c (n : Nat) => Prod.fst (clockCoefficients c (actualClockPair c n))
local notation "B" => fun c (n : Nat) => Prod.snd (clockCoefficients c (actualClockPair c n))
local notation "m" => fun c => moment c
  (burnolQuarterZeroExtension (burnolMeanZeroTruncatedFourier (nativeSmooth c) : BurnolQuarterIntervalL2))
local notation "R" => fun c => burnolDirectRightResolventCLM (barC c)
local notation "delta" => fun c (n : Nat) => floorFromResponses c+riemannZeta (s₀ c) • elementarySource c-compensated c (n+2)
local notation "aφ" => fun c n => (phase c n)⁻¹*A c n
local notation "bφ" => fun c n => (phase c n)⁻¹*B c n
local notation "H" => countedHomogeneousSplit
local notation "Hraw" => fun c (x : ℝ) => ((|x| : ℝ) : ℂ)^(-s₀ c)*(1/2 : ℂ)

/-- Remove the actual entire homogeneous coefficient of the literal phase
R field, using the original source outer moment before either read. -/
def countedCompactPhaseField (c : BurnolCompletedMellinCoordinate) (n : Nat) : L¹ × BurnolL2 :=
  splitAtPhysicalCutoff r₀ (R c (countedPhaseSource c n))+(2*aφ c n) • H c

def countedCompactPhaseLimit (c : BurnolCompletedMellinCoordinate) : L¹ × BurnolL2 :=
  countedPhaseSubleadingLimit c+(m c) • H c

theorem actual_counted_compact_phase_limit (c : BurnolCompletedMellinCoordinate) :
    Tendsto (countedCompactPhaseField c) atTop (𝓝 (countedCompactPhaseLimit c)) := by
  have phaseLimit := actual_counted_phase_subleading_field c
  have source := (actual_phase_outer_constant c).smul_const (H c)
  apply (phaseLimit.add source).congr'
  filter_upwards with n
  dsimp only [countedCompactPhaseField]
  rw [add_smul]
  abel

theorem actual_counted_compact_phase_projection (c : BurnolCompletedMellinCoordinate) (n : Nat) :
    physicalProjectionFromCentre (countedCompactPhaseField c n) = 0 := by
  unfold countedCompactPhaseField
  rw [map_add, map_smul, actual_homogeneous_physical_projection,
    original_physical_projection_from_split r₀ (by norm_num)]
  unfold countedPhaseSource
  simp only [map_smul, actual_clock_physical, smul_smul]
  module

theorem actual_counted_compact_phase_observations (c : BurnolCompletedMellinCoordinate) :
    eulerOfPhysicalSplit c (countedCompactPhaseLimit c) = distributionOfSplit (countedSeedSplit c) ∧
    physicalProjectionFromCentre (countedCompactPhaseLimit c) = 0 := by
  have existing := actual_counted_phase_subleading_observations c
  have homogeneous : eulerOfPhysicalSplit c (H c) = 0 := counted_homogeneous_euler c
  have erase : (m c) • (0 : S') = 0 := by
    ext test
    simp [smul_apply]
  unfold countedCompactPhaseLimit
  constructor
  · rw [map_add, map_smul, existing.1, homogeneous, erase, add_zero]
  · rw [map_add, map_smul, existing.2, actual_homogeneous_physical_projection, neg_smul, neg_add_cancel]

private def compactPhaseRaw (c : BurnolCompletedMellinCoordinate) (n : Nat) (x : ℝ) : ℂ :=
  R c (countedPhaseSource c n) x+(2*aφ c n)*Hraw c x

private theorem compact_phase_split_read (c : BurnolCompletedMellinCoordinate) (n : Nat) :
    ∀ᵐ x : ℝ ∂volume, (countedCompactPhaseField c n).1 x = Set.indicator box (compactPhaseRaw c n) x ∧
      (countedCompactPhaseField c n).2 x = if r₀ < |x| then compactPhaseRaw c n x else 0 := by
  let u := splitAtPhysicalCutoff r₀ (R c (countedPhaseSource c n))
  let a := 2*aφ c n
  let h := H c
  have centre := (centre_integrable c).coeFn_toL1
  have outside := homogeneous_tail_read c
  filter_upwards [cutoff_split_read r₀ (R c (countedPhaseSource c n)), centre, outside,
    Lp.coeFn_smul a h.1, Lp.coeFn_smul a h.2, Lp.coeFn_add u.1 (a • h.1), Lp.coeFn_add u.2 (a • h.2)]
    with x cut near far centreScalar exteriorScalar centreSum exteriorSum
  change h.1 x = _ at near
  change h.2 x = _ at far
  constructor
  · change (u.1+a • h.1 : L¹) x = _
    rw [centreSum, Pi.add_apply, centreScalar, Pi.smul_apply, smul_eq_mul, near]
    have source : u.1 x = _ := cut.1
    rw [source]
    by_cases inside : x ∈ box
    · rw [indicator_of_mem inside, indicator_of_mem inside, indicator_of_mem inside]
      rfl
    · rw [indicator_of_notMem inside, indicator_of_notMem inside, indicator_of_notMem inside,
        mul_zero, add_zero]
  · change (u.2+a • h.2 : BurnolL2) x = _
    rw [exteriorSum, Pi.add_apply, exteriorScalar, Pi.smul_apply, smul_eq_mul, far]
    have source : u.2 x = _ := cut.2
    rw [source]
    by_cases inside : x ∈ box
    · have small := not_lt_of_ge (abs_le.mpr inside)
      rw [indicator_of_mem inside, if_neg small, if_neg small, sub_self, mul_zero, add_zero]
    · have large : r₀ < |x| := lt_of_not_ge (fun h => inside (abs_le.mp h))
      rw [indicator_of_notMem inside, if_pos large, if_pos large, sub_zero]
      rfl

private theorem compact_phase_raw_even (c : BurnolCompletedMellinCoordinate) (n : Nat) :
    ∀ᵐ x : ℝ ∂volume, compactPhaseRaw c n (-x) = compactPhaseRaw c n x := by
  have raw := actual_R_raw (barC c) (countedPhaseSource c n) _ Filter.EventuallyEq.rfl (phase_source_even c n)
  filter_upwards [raw, negMeasurePreserving.quasiMeasurePreserving.ae raw] with x direct reflected
  change R c (countedPhaseSource c n) x = _ at direct
  change R c (countedPhaseSource c n) (-x) = _ at reflected
  unfold compactPhaseRaw
  rw [direct, reflected]
  simp only [prefixRaw, abs_neg]

private theorem compact_phase_positive (c : BurnolCompletedMellinCoordinate) (n : Nat) :
    ∀ᵐ x : ℝ ∂volume, 0 < x →
      (x ≤ q → q/x < ((n+2 : Nat) : ℝ) → compactPhaseRaw c n x = bφ c n*(x : ℂ)^(-s₀ c)*collarPrimitive c x) ∧
      (q < x → compactPhaseRaw c n x = 0) := by
  let y := R c (delta c n)
  have phaseActed : R c (countedPhaseSource c n) = (phase c n)⁻¹ • y := by
    unfold countedPhaseSource
    rw [map_smul]
  have outside := outside_read q y
  have original := actual_quarter_exterior c n
  change ∀ᵐ x : ℝ ∂volume,
    (y-originalPhysicalCutoff q y : BurnolL2) x = (if q < |x| then y x else 0) at outside
  change y-originalPhysicalCutoff q y = A c n • quarterTail c at original
  rw [original] at outside
  have tail := radiusTail_positiveRead (barC c) q (by norm_num)
  filter_upwards [actual_settled_R_profile c n, Lp.coeFn_smul (phase c n)⁻¹ y, outside,
    Lp.coeFn_smul (A c n) (quarterTail c), tail] with x profile scale outsideRead scaledTail tailRead positive
  unfold compactPhaseRaw
  rw [phaseActed, scale, Pi.smul_apply, smul_eq_mul]
  have homogeneous : Hraw c x = (x : ℂ)^(-s₀ c)*(1/2 : ℂ) := by
    change ((|x| : ℝ) : ℂ)^(-s₀ c)*(1/2 : ℂ) = _
    rw [abs_of_pos positive]
  rw [homogeneous]
  constructor
  · intro inner settled
    have current : y x = (x : ℂ)^(-s₀ c)*(-A c n+B c n*collarPrimitive c x) :=
      profile positive inner settled
    rw [current]
    ring
  · intro beyond
    rw [abs_of_pos positive, if_pos beyond, scaledTail, Pi.smul_apply, smul_eq_mul] at outsideRead
    have tailValue : quarterTail c x = -(x : ℂ)^(-s₀ c) := by
      simpa only [quarterTail, if_pos beyond, show (barC c).value = star c.value from rfl] using tailRead positive
    rw [← outsideRead, tailValue]
    ring

/-- Every actual field is compact at the original quarter, in both slots. -/
theorem actual_counted_compact_phase_support (c : BurnolCompletedMellinCoordinate) (n : Nat) :
    ∀ᵐ x : ℝ ∂volume, |x| > q →
      (countedCompactPhaseField c n).1 x = 0 ∧ (countedCompactPhaseField c n).2 x = 0 := by
  have source := compact_phase_positive c n
  filter_upwards [compact_phase_split_read c n, source, negMeasurePreserving.quasiMeasurePreserving.ae source,
    compact_phase_raw_even c n] with x read direct opposite even beyond
  have rsmall : r₀ < |x| := (by norm_num : r₀ < q).trans beyond
  have zero : compactPhaseRaw c n x = 0 := by
    have live : x ≠ 0 := abs_pos.mp ((by norm_num : 0 < q).trans beyond)
    rcases lt_or_gt_of_ne live with negative | positive
    · rw [← even]
      rw [abs_of_neg negative] at beyond
      exact (opposite (neg_pos.mpr negative)).2 beyond
    · rw [abs_of_pos positive] at beyond
      exact (direct positive).2 beyond
  have missing : x ∉ box := fun inside => rsmall.not_ge (abs_le.mpr inside)
  exact ⟨read.1.trans (indicator_of_notMem missing _), read.2.trans (by rw [if_pos rsmall, zero])⟩

