theorem actual_native_unit_gap_price (c:BurnolCompletedMellinCoordinate):
    fixedFee c (originalUnit:BurnolL2)=star (nativeCotestGap c)/2:=by
  have source:=actual_projection_fee c ConstantDual.seed
  change fixedFee c (originalUnit:BurnolL2)=_ at source
  rw [quarter_pair,physical_quarter] at source
  have mean:burnolQuarterMeanCoefficient (nativeCotestGap c • Cq)=nativeCotestGap c:=by
    have cast:(((‖Cq‖^2:ℝ):ℂ))=(1/2:ℂ):=by
      rw [Complex.ofReal_pow,burnolIntervalConstant_norm_sq (by norm_num:(0:ℝ)<q)]
      norm_num
    have same:inner ℂ Cq Cq=(1/2:ℂ):=by
      rw [inner_self_eq_norm_sq_to_K]
      convert! burnolIntervalConstant_norm_sq (by norm_num:(0:ℝ)<q) using 1; norm_num
    unfold burnolQuarterMeanCoefficient
    rw [inner_smul_right,same,cast]
    ring
  rw [mean] at source
  exact source

private theorem compact_moment_read (raw:ℝ→ℂ) (j:ℕ):
    mellin (logSource (OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.Inverse.ReturnMellin.compactRaw raw) j) 1=
      ∫x:ℝ in (0:ℝ)..q,(Real.log x:ℂ)^j*raw x:=by
  have source:=compact_mellin_read raw 0 j
  simpa only [sub_zero,OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.Inverse.ComplementMoment.quarterMoment,
    OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.Inverse.ComplementMoment.logWeight,neg_zero,Complex.cpow_zero,one_mul] using source

private theorem compact_mellin_derivative (raw:ℝ→ℂ) (regular:Continuous raw):
    HasDerivAt (mellin (OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.Inverse.ReturnMellin.compactRaw raw)) (∫x:ℝ in (0:ℝ)..q,(Real.log x:ℂ)*raw x) 1:=by
  have outside:∀x:ℝ,q < |x| → OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.Inverse.ReturnMellin.compactRaw raw x=0:=by
    intro x beyond
    exact indicator_of_notMem (s:=symmetricInterval q) (fun inside=>not_le_of_gt beyond (abs_le.mpr inside)) _
  have tail:OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.Inverse.ReturnMellin.compactRaw raw=O[atTop](fun x:ℝ=>x^(-(2:ℝ))):=by
    simpa only [logSource_zero] using log_top_bound _ q outside 0 2
  have native:=(mellin_hasDerivAt_of_isBigO_rpow
    (((compact_memLp raw regular).locallyIntegrable (by norm_num)).locallyIntegrableOn _)
    tail (by norm_num:(1:ℂ).re<2) (compact_origin raw regular) (by norm_num:(0:ℝ)<(1:ℂ).re)).2
  have read:mellin (fun x:ℝ=>Real.log x • OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.Inverse.ReturnMellin.compactRaw raw x) 1=
      ∫x:ℝ in (0:ℝ)..q,(Real.log x:ℂ)*raw x:=by
    have source:=compact_moment_read raw 1
    change mellin (fun x:ℝ=>(Real.log x)^1 • OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.Inverse.ReturnMellin.compactRaw raw x) 1=_ at source
    simpa only [pow_one] using source
  rwa [read] at native

private theorem actual_polefree_derivative (c:BurnolCompletedMellinCoordinate):
    deriv (poleFreeSource c) 1=
      (1/2:ℂ)*(q:ℂ)^(1-star c.value)*(Real.log q:ℂ)+
      (∫x:ℝ in (0:ℝ)..q,smoothRaw c.value c.belowOne x)+
      (1-star c.value)*(∫x:ℝ in (0:ℝ)..q,(Real.log x:ℂ)*smoothRaw c.value c.belowOne x):=by
  have idD:HasDerivAt (fun z:ℂ=>z) 1 1:=hasDerivAt_id 1
  have power:=(idD.sub_const (star c.value)).const_cpow (Or.inl (by norm_num:(q:ℂ)≠0))
  have smooth:=compact_mellin_derivative (smoothRaw c.value c.belowOne)
    (actual_smooth_contDiff c.value c.belowOne).continuous
  have paid:=(power.const_mul (1/2:ℂ)).add ((idD.sub_const (star c.value)).mul smooth)
  change HasDerivAt (poleFreeSource c) _ 1 at paid
  rw [paid.deriv]
  have ordinary:=compact_moment_read (smoothRaw c.value c.belowOne) 0
  simp only [logSource_zero,pow_zero,one_mul] at ordinary
  rw [ordinary,←Complex.ofReal_log (by norm_num:(0:ℝ)≤q)]
  ring

private theorem correction_log_price (c:BurnolCompletedMellinCoordinate):
    inner ℂ ell (correction c.value c.belowOne)=
      2*((∫x:ℝ in (0:ℝ)..q,(Real.log x:ℂ)*smoothRaw c.value c.belowOne x)-
        ((Real.log q:ℂ)-1)*(∫x:ℝ in (0:ℝ)..q,smoothRaw c.value c.belowOne x)):=by
  let raw:=smoothRaw c.value c.belowOne
  have regular:Continuous raw:=(actual_smooth_contDiff c.value c.belowOne).continuous
  let state:Hq:=Constructor.compact raw regular
  let d:ℂ:=(1/2:ℂ)*rawMean (powerRaw c.value)
  have stateSource:state=(correction c.value c.belowOne:Hq)-d • Cq:=by
    apply Lp.ext
    filter_upwards [Constructor.compact_read raw regular,actual_correction_raw c.value c.belowOne,
      Lp.coeFn_sub (correction c.value c.belowOne:Hq) (d • Cq),Lp.coeFn_smul d Cq,intervalConstant_coeFn q]
      with x smooth actual subtracted scalar constant
    rw [smooth,subtracted,Pi.sub_apply,scalar,Pi.smul_apply,smul_eq_mul,constant,mul_one,actual]
    rfl
  have zero:inner ℂ (ell:Hq) Cq=0:=by
    apply inner_eq_zero_symm.mp
    exact (Submodule.mem_orthogonal _ _).mp (CenteredCountingDual.logarithm).property _ (Submodule.mem_span_singleton_self _)
  have pair:inner ℂ ell (correction c.value c.belowOne)=inner ℂ (ell:Hq) state:=by
    rw [stateSource,inner_sub_right,inner_smul_right,zero,mul_zero,sub_zero]
    rfl
  let f:ℝ→ℂ:=fun x=>((Real.log x:ℂ)-(Real.log q:ℂ)+1)*OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.Inverse.ReturnMellin.compactRaw raw x
  have weighted:Integrable f μq:=by
    have domain:Integrable (fun x:ℝ=>star ((ell:Hq) x)*state x) μq:=
      (Lp.memLp (ell:Hq)).star.integrable_mul (Lp.memLp state)
    apply domain.congr
    filter_upwards [ArithmeticLogGram.logarithm_coeFn,Constructor.compact_read raw regular,
      ae_restrict_mem (measurableSet_symmetricInterval q)] with x logarithm smooth inside
    dsimp only [f]
    rw [logarithm,smooth,OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.Inverse.ReturnMellin.compactRaw,indicator_of_mem inside]
    rw [star_def,Complex.conj_ofReal]
    push_cast
    rfl
  have compactEven (x:ℝ):OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.Inverse.ReturnMellin.compactRaw raw (-x)=OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.Inverse.ReturnMellin.compactRaw raw x:=by
    by_cases inside:x∈symmetricInterval q
    · have opposite:-x∈symmetricInterval q:=⟨by linarith [inside.2],by linarith [inside.1]⟩
      rw [OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.Inverse.ReturnMellin.compactRaw,indicator_of_mem inside,indicator_of_mem opposite]
      exact congrArg (fun z:ℂ=>z-(1/2:ℂ)*rawMean (powerRaw c.value))
        (actual_correction_raw_even c.value c.belowOne x inside)
    · have opposite:-x∉symmetricInterval q:=by
        intro h
        apply inside
        exact ⟨by linarith [h.2],by linarith [h.1]⟩
      rw [OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.Inverse.ReturnMellin.compactRaw,indicator_of_notMem inside,indicator_of_notMem opposite]
  have even:∀x:ℝ,f (-x)=f x:=by
    intro x
    dsimp only [f]
    rw [Real.log_neg_eq_log,compactEven]
  have full:inner ℂ (ell:Hq) state=∫x:ℝ in symmetricInterval q,f x:=by
    rw [L2.inner_def]
    apply integral_congr_ae
    filter_upwards [ArithmeticLogGram.logarithm_coeFn,Constructor.compact_read raw regular,
      ae_restrict_mem (measurableSet_symmetricInterval q)] with x logarithm smooth inside
    change state x*star ((ell:Hq) x)=f x
    dsimp only [f]
    rw [logarithm,smooth,OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.Inverse.ReturnMellin.compactRaw,indicator_of_mem inside,
      star_def,Complex.conj_ofReal]
    push_cast
    ring
  have first:IntervalIntegrable (fun x:ℝ=>(Real.log x:ℂ)*raw x) volume 0 q:=by
    rw [intervalIntegrable_iff_integrableOn_Ioc_of_le (by norm_num:(0:ℝ)≤q)]
    have domain:=weighted_integrable raw regular (0:ℂ) 1 (by norm_num:(0:ℝ)<1)
    change IntegrableOn (fun x:ℝ=>(x:ℂ)^(-(0:ℂ))*(Real.log x:ℂ)^1*raw x) (Ioc 0 q) at domain
    simpa only [neg_zero,Complex.cpow_zero,pow_one,one_mul] using domain
  have base:IntervalIntegrable raw volume 0 q:=regular.intervalIntegrable 0 q
  have half:(∫x:ℝ in Ioc (0:ℝ) q,f x)=
      (∫x:ℝ in (0:ℝ)..q,(Real.log x:ℂ)*raw x)-
        ((Real.log q:ℂ)-1)*(∫x:ℝ in (0:ℝ)..q,raw x):=by
    rw [←intervalIntegral.integral_of_le (by norm_num:(0:ℝ)≤q),
      ←intervalIntegral.integral_const_mul,←intervalIntegral.integral_sub first (base.const_mul _)]
    apply intervalIntegral.integral_congr_Ioo_of_le (by norm_num:(0:ℝ)≤q)
    intro x inside
    dsimp only [f]
    rw [OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.Inverse.ReturnMellin.compactRaw,indicator_of_mem (show x∈symmetricInterval q from ⟨by linarith [inside.1],inside.2.le⟩)]
    ring
  rw [pair,full,even_half_integral f weighted even,half]

/-- The original pole-one mass equals the complete native log price, with its exact seed contact. -/
theorem actual_native_count_mass_log (c:BurnolCompletedMellinCoordinate) (zero:riemannZeta c.value=0):
    burnolQuarterMeanCoefficient (burnolQuarterRestriction (fullFloorValue c zero))/2=
      inner ℂ ell (correction c.value c.belowOne)-
        star c.value*(q:ℂ)^(1-star c.value)/(1-star c.value)^2:=by
  have nonzero:1-star c.value≠0:=by
    intro h
    have real:=congrArg Complex.re h
    simp only [sub_re,one_re,star_def,conj_re,zero_re] at real
    linarith [c.belowOne]
  have ordinary:=compact_moment_read (smoothRaw c.value c.belowOne) 0
  simp only [logSource_zero,pow_zero,one_mul] at ordinary
  have source:=actual_polefree_at_one_zero c zero
  change (1/2:ℂ)*(q:ℂ)^(1-star c.value)+(1-star c.value)*
    mellin (OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.Inverse.ReturnMellin.compactRaw (smoothRaw c.value c.belowOne)) 1=0 at source
  rw [ordinary] at source
  have mass:(∫x:ℝ in (0:ℝ)..q,smoothRaw c.value c.belowOne x)=
      -((q:ℂ)^(1-star c.value))/(2*(1-star c.value)):=by
    apply (eq_div_iff (mul_ne_zero (by norm_num) nonzero)).mpr
    linear_combination 2*source
  rw [actual_quarter_mean_finite_part c zero,actual_polefree_derivative,correction_log_price,mass]
  field_simp [nonzero]
  ring

