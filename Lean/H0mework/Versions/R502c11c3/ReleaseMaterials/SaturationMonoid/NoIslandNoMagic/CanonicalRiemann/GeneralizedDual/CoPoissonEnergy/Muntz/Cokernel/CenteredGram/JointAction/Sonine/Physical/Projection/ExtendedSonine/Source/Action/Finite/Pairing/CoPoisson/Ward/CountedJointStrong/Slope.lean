local notation "D" => burnolMultiplicativeDilation
local notation "Resolvent" => burnolDirectRightResolventCLM
local notation "C" => ContinuousChannels.channel

/-- The actual infinitesimal dilation action on an original R output. -/
def resolventVelocity (c : BurnolCompletedMellinCoordinate) (input : BurnolL2) : BurnolL2 :=
  -((c.value - 1/2) • Resolvent c input + (2 : ℂ) • input)

/-- Its action on the actual velocity, generated by the preceding literal R output. -/
def resolventAcceleration (c : BurnolCompletedMellinCoordinate) (input : BurnolL2) : BurnolL2 :=
  -((c.value - 1/2) • resolventVelocity c (Resolvent c input) + (2 : ℂ) • resolventVelocity c input)

theorem actual_resolvent_acceleration (c : BurnolCompletedMellinCoordinate) (input : BurnolL2) :
    HasDerivAt (fun h : ℝ => D h (resolventVelocity c (Resolvent c input))) (resolventAcceleration c input) 0 := by
  let A := c.value-1/2
  have acted (z : ℂ) (x : BurnolL2) (h : ℝ) : D h (z • x) = z • D h x := map_smul (D h) z x
  have deriv := (((actual_resolvent_dilation_derivative c (Resolvent c input)).const_smul A).add
    ((actual_resolvent_dilation_derivative c input).const_smul (2 : ℂ))).neg
  have path : (fun h : ℝ => -(A • D h (Resolvent c (Resolvent c input)) + (2 : ℂ) • D h (Resolvent c input))) =
      (fun h : ℝ => D h (resolventVelocity c (Resolvent c input))) := by
    funext h
    rw [resolventVelocity, map_neg, map_add, acted, acted]
  exact path ▸ deriv

private def slopeSeed (d : ℝ) (state velocity : BurnolL2) : BurnolL2 :=
  d • velocity - (1/2 : ℝ) • state

private def curveSeed (d : ℝ) (state velocity acceleration : BurnolL2) : BurnolL2 :=
  d • (d • acceleration - (1/2 : ℝ) • velocity) - (3/2 : ℝ) • slopeSeed d state velocity

private def curve (d : ℝ) (state velocity acceleration : BurnolL2) (a : ℝ) : BurnolL2 :=
  a^(-(5/2 : ℝ)) • D (d*Real.log a) (curveSeed d state velocity acceleration)

private theorem seed_derivative (d : ℝ) (state velocity acceleration : BurnolL2)
    (first : HasDerivAt (fun h : ℝ => D h state) velocity 0)
    (second : HasDerivAt (fun h : ℝ => D h velocity) acceleration 0) :
    HasDerivAt (fun h : ℝ => D h (slopeSeed d state velocity))
      (d • acceleration - (1/2 : ℝ) • velocity) 0 := by
  have derivative := (second.const_smul d).sub (first.const_smul (1/2 : ℝ))
  have path :
      (fun h : ℝ => d • D h velocity - (1/2 : ℝ) • D h state) =
        (fun h : ℝ => D h (slopeSeed d state velocity)) := by
    funext h
    let action := (D h).toContinuousLinearEquiv.toContinuousLinearMap.restrictScalars ℝ
    change d • action velocity - (1/2 : ℝ) • action state =
      action (d • velocity - (1/2 : ℝ) • state)
    rw [map_sub, map_smul, map_smul]
  exact path ▸ derivative

private theorem slope_derivative (d : ℝ) (state velocity acceleration : BurnolL2)
    (first : HasDerivAt (fun h : ℝ => D h state) velocity 0)
    (second : HasDerivAt (fun h : ℝ => D h velocity) acceleration 0)
    {a : ℝ} (positive : 0 < a) :
    HasDerivAt (channelSlope d · state velocity) (curve d state velocity acceleration a) a := by
  let V := slopeSeed d state velocity
  let W := d • acceleration - (1/2 : ℝ) • velocity
  let action := (D (d*Real.log a)).toContinuousLinearEquiv.toContinuousLinearMap.restrictScalars ℝ
  have scale := Real.hasDerivAt_rpow_const (p := -(3/2 : ℝ)) (Or.inl positive.ne')
  have orbit := (dilation_derivative V W (seed_derivative d state velocity acceleration first second)
    (d*Real.log a)).scomp a ((Real.hasDerivAt_log positive.ne').const_mul d)
  have actual := scale.smul orbit
  have power : a ^ (-(3/2 : ℝ)) * a⁻¹ = a ^ (-(5/2 : ℝ)) := by
    rw [← Real.rpow_neg_one, ← Real.rpow_add positive]
    norm_num
  have coefficient : a ^ (-(3/2 : ℝ)) * (d*a⁻¹) = d*a^(-(5/2 : ℝ)) := by
    rw [← mul_assoc, mul_comm (a ^ (-(3/2 : ℝ))) d, mul_assoc, power]
  have target :
      a^(-(3/2 : ℝ)) • ((d*a⁻¹) • action W) +
        (-(3/2 : ℝ) * a ^ (-(3/2 : ℝ) - 1)) • action V =
      a^(-(5/2 : ℝ)) • action (d • W - (3/2 : ℝ) • V) := by
    let w := action W
    let v := action V
    have split : action (d • W - (3/2 : ℝ) • V) = d • w - (3/2 : ℝ) • v := by
      rw [map_sub, map_smul, map_smul]
    change a^(-(3/2 : ℝ)) • ((d*a⁻¹) • w) +
      (-(3/2 : ℝ) * a^(-(3/2 : ℝ) - 1)) • v =
      a^(-(5/2 : ℝ)) • action (d • W - (3/2 : ℝ) • V)
    rw [split, smul_sub, smul_smul, smul_smul, smul_smul, coefficient,
      show -(3/2 : ℝ)-1 = -(5/2 : ℝ) by norm_num, sub_eq_add_neg,
      mul_comm d, ← neg_smul, mul_comm (-(3/2 : ℝ)), mul_neg]
  change HasDerivAt (channelSlope d · state velocity)
    (a^(-(3/2 : ℝ)) • ((d*a⁻¹) • action W) +
      (-(3/2 : ℝ) * a ^ (-(3/2 : ℝ) - 1)) • action V) a at actual
  rw [target] at actual
  exact actual

private theorem slope_limit_at_infty (d : ℝ) (state velocity : BurnolL2) (M : Nat) :
    Tendsto (fun j : Nat => channelSlope d (((M+j : Nat) : ℝ)+1) state velocity) atTop (𝓝 0) := by
  have indices : Tendsto (fun j : Nat => ((M+j : Nat) : ℝ)+1) atTop atTop := by
    simpa only [Function.comp_def, Nat.cast_add, Nat.cast_one, add_left_comm, add_assoc, add_comm] using
      (tendsto_natCast_atTop_atTop (R := ℝ)).comp (tendsto_add_atTop_nat (M+1))
  have norms := ((tendsto_rpow_neg_atTop (by norm_num : 0 < (3/2 : ℝ))).comp indices).mul_const
    ‖slopeSeed d state velocity‖
  rw [zero_mul] at norms
  apply tendsto_zero_iff_norm_tendsto_zero.mpr
  apply norms.congr'
  filter_upwards with j
  rw [channelSlope, norm_smul, LinearIsometryEquiv.norm_map,
    Real.norm_of_nonneg (Real.rpow_nonneg (by positivity) _)]
  rfl

