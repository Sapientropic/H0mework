private theorem clock_bounds : 0 < h₀ ∧ h₀ < Real.log 2 := by
  have rootLower : (1 : ℝ) < stageZeroSonineQ := by
    change (1 : ℝ) < Real.sqrt 3
    exact (Real.lt_sqrt (by norm_num)).2 (by norm_num)
  have rootUpper : stageZeroSonineQ < 2 := by
    change Real.sqrt 3 < (2 : ℝ)
    exact (Real.sqrt_lt (by norm_num : (0 : ℝ) ≤ 3) (by norm_num : (0 : ℝ) ≤ 2)).2 (by norm_num)
  exact ⟨Real.log_pos rootLower, Real.log_lt_log stageZeroSonineQ_pos rootUpper⟩

private theorem inner_endpoint_mem : p₀ ∈ closedBand := by
  have small := clock_bounds.2
  have low : (1/2 : ℝ) < Real.exp (-h₀) := by
    have growth := Real.exp_lt_exp.mpr (neg_lt_neg small)
    rwa [Real.exp_neg (Real.log 2), Real.exp_log (by norm_num : (0:ℝ) < 2),
      show (2 : ℝ)⁻¹ = 1/2 by norm_num] at growth
  have high := Real.exp_le_one_iff.mpr (neg_nonpos.mpr clock_bounds.1.le)
  exact ⟨by linarith, by linarith⟩

private theorem exp_first_order_error (s : ℂ) (right : 0 < s.re) (step : ℝ)
    (nonnegative : 0 ≤ step) :
    ‖(1-Complex.exp (-s*(step : ℂ)))/s-(step : ℂ)‖ ≤ ‖s‖*step^2/2 := by
  let wave := fun t : ℝ => Complex.exp (-s*(t : ℂ))
  have derivative (t : ℝ) : HasDerivAt wave (wave t * (-s)) t := by
    simpa only [wave, id_eq, mul_one] using
      (((hasDerivAt_id (t : ℂ)).const_mul (-s)).comp_ofReal).cexp
  have waveBound (t : ℝ) (ht : 0 ≤ t) : ‖wave t * (-s)‖ ≤ ‖s‖ := by
    rw [norm_mul, norm_neg]
    apply mul_le_of_le_one_left (norm_nonneg _)
    dsimp only [wave]
    rw [Complex.norm_exp, Real.exp_le_one_iff]
    simp only [Complex.mul_re, Complex.neg_re, Complex.ofReal_re, Complex.ofReal_im,
      mul_zero, sub_zero]
    exact mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr right.le) ht
  have pointwise := norm_image_sub_le_of_norm_deriv_le_segment'
    (a := 0) (b := step) (fun t _ => (derivative t).hasDerivWithinAt)
    (fun t ht => waveBound t ht.1)
  have regular : Continuous wave := continuous_iff_continuousAt.mpr
    (fun t => (derivative t).continuousAt)
  have bound := intervalIntegral.norm_integral_le_of_norm_le
    (f := fun t => wave t-1) (g := fun t => ‖s‖*t) nonnegative
    (ae_of_all volume (fun t ht => by
      have one : wave 0 = 1 := by simp [wave]
      simpa only [one, sub_zero] using pointwise t (Ioc_subset_Icc_self ht)))
    ((continuous_const.mul continuous_id).intervalIntegrable 0 step)
  have live : s ≠ 0 := fun empty => by rw [empty, Complex.zero_re] at right; exact lt_irrefl _ right
  have integral : (∫ t : ℝ in 0..step, wave t) = (1-wave step)/s := by
    dsimp only [wave]
    rw [integral_exp_mul_complex (neg_ne_zero.mpr live), Complex.ofReal_zero, mul_zero, Complex.exp_zero]
    ring
  rw [intervalIntegral.integral_sub (regular.intervalIntegrable _ _) intervalIntegrable_const,
    integral, intervalIntegral.integral_const, intervalIntegral.integral_const_mul, integral_id] at bound
  simpa only [sub_zero, zero_pow (by decide : (2 : ℕ) ≠ 0), Complex.real_smul, mul_one,
    ← mul_div_assoc] using bound

private theorem clock_primitive_scaled (c : BurnolCompletedMellinCoordinate) :
    let s := star c.value
    (1-s) * collarPrimitive c p₀ = (h₀ : ℂ)*(1-s) - (1-Complex.exp (-s*(h₀ : ℂ)))/s := by
  let s := star c.value
  change (1-s) * collarPrimitive c p₀ = _
  have logRatio : Real.log (q/p₀) = h₀ := by
    have scale : q/p₀ = Real.exp h₀ := by
      rw [Real.exp_neg]
      field_simp
    rw [scale, Real.log_exp]
  have power : (p₀ : ℂ)^s = (q : ℂ)^s * Complex.exp (-s*(h₀ : ℂ)) := by
    have scale : (↑(Real.exp (-h₀)) : ℂ)^s = Complex.exp (-s*(h₀ : ℂ)) := by
      rw [Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr (Real.exp_ne_zero _)),
        ← Complex.ofReal_log (Real.exp_pos _).le, Real.log_exp, Complex.ofReal_neg]
      congr 1
      ring
    change (↑(q * Real.exp (-h₀)) : ℂ)^s = _
    rw [Complex.ofReal_mul, Complex.mul_cpow_ofReal_nonneg (by norm_num : (0 : ℝ) ≤ q)
      (Real.exp_pos _).le, scale]
  have gap := GapEuler.gapMean_primitive q (by norm_num) c
  change (1-s)*GapEuler.gapMean q c = (1/2 : ℂ)*(q : ℂ)^(-s) at gap
  have unit : ((1-s)*(2*GapEuler.gapMean q c))*(q : ℂ)^s = 1 := by
    calc
      _ = 2*((1-s)*GapEuler.gapMean q c)*(q : ℂ)^s := by ring
      _ = (q : ℂ)^(-s)*(q : ℂ)^s := by rw [gap]; ring
      _ = 1 := by rw [← Complex.cpow_add _ _ (by norm_num : (q : ℂ) ≠ 0), neg_add_cancel, Complex.cpow_zero]
  rw [collarPrimitive, logRatio]
  change (1-s) * ((h₀ : ℂ) - 2*GapEuler.gapMean q c * (((q : ℂ)^s-(p₀ : ℂ)^s)/s)) = _
  rw [power]
  calc
    _ = (h₀ : ℂ)*(1-s) -
        (((1-s)*(2*GapEuler.gapMean q c))*(q : ℂ)^s)*(1-Complex.exp (-s*(h₀ : ℂ)))/s := by ring
    _ = _ := by rw [unit, one_mul]

/-- The determinant of the original two endpoint readings has a strict strip-wide margin. -/
theorem fixed_endpoint_margin (c : BurnolCompletedMellinCoordinate) :
    h₀ * ‖star c.value‖ * (1-h₀/2) ≤ ‖(1-star c.value)*collarPrimitive c p₀‖ := by
  let s := star c.value
  let error := (1-Complex.exp (-s*(h₀ : ℂ)))/s-(h₀ : ℂ)
  have right : 0 < s.re := by
    simpa only [s, star_def, conj_re] using (by linarith [c.rightHalf] : 0 < c.value.re)
  have budget := exp_first_order_error s right h₀ clock_bounds.1.le
  change ‖error‖ ≤ _ at budget
  have read : (1-s)*collarPrimitive c p₀ = -((h₀ : ℂ)*s+error) := by
    rw [clock_primitive_scaled]
    dsimp only [error]
    ring
  have triangle := norm_sub_le ((h₀ : ℂ)*s+error) error
  rw [add_sub_cancel_right, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg clock_bounds.1.le] at triangle
  change _ ≤ ‖(1-s)*collarPrimitive c p₀‖
  rw [read, norm_neg]
  nlinarith

theorem fixed_endpoint_primitive_ne (c : BurnolCompletedMellinCoordinate) :
    collarPrimitive c p₀ ≠ 0 := by
  have right : 0 < (star c.value).re := by simpa only [star_def, conj_re] using
    (by linarith [c.rightHalf] : 0 < c.value.re)
  have live : 0 < ‖star c.value‖ := norm_pos_iff.mpr (fun gone => by rw [gone, zero_re] at right; exact lt_irrefl _ right)
  have logTwo : Real.log 2 < 1 := by
    simpa only [show (2 : ℝ)-1 = 1 by norm_num] using
      Real.log_lt_sub_one_of_pos (by norm_num : (0 : ℝ) < 2) (by norm_num : (2 : ℝ) ≠ 1)
  have small : h₀ < 1 := clock_bounds.2.trans logTwo
  have positive : 0 < h₀*‖star c.value‖*(1-h₀/2) :=
    mul_pos (mul_pos clock_bounds.1 live) (by linarith)
  intro erased
  have bound := fixed_endpoint_margin c
  rw [erased, mul_zero, norm_zero] at bound
  exact (not_le_of_gt positive) bound

local notation "delta" => fun c (n : Nat) => whole c-compensated c (n+2)
local notation "A" => fun c (n : Nat) =>
  moment c (burnolQuarterZeroExtension (burnolMeanZeroTruncatedFourier (nativeSmooth c) : BurnolQuarterIntervalL2)) *
    ζ c + CoefficientJet.zetaJet 1 (star (BurnolCompletedMellinCoordinate.value c))-countedJetPrice c (n+1)
local notation "B" => fun c (n : Nat) => Z c (n+2)-ζ c

private def normalizedEndpoint (c : BurnolCompletedMellinCoordinate) (x : ℝ) (v : BurnolL2) : ℂ :=
  -moment c v + 2*(∫ y : ℝ in x..q, (y : ℂ)^(star c.value-1)*v y)

private theorem normalized_continuous (c : BurnolCompletedMellinCoordinate) (v : BurnolL2) :
    ContinuousOn (fun x => normalizedEndpoint c x v) closedBand := by
  have domain : IntegrableOn (fun y : ℝ => (y : ℂ)^(star c.value-1)*v y) (uIcc 0 q) := by
    rw [uIcc_of_le (by norm_num : (0 : ℝ) ≤ q), integrableOn_Icc_iff_integrableOn_Ioc]
    exact (quarter_positive_domain c v).1
  have integral := (intervalIntegral.continuousOn_primitive_interval_left domain).mono
    (show closedBand ⊆ uIcc 0 q by
      rw [uIcc_of_le (by norm_num : (0 : ℝ) ≤ q)]
      exact Icc_subset_Icc_left (by norm_num))
  exact continuousOn_const.add (continuousOn_const.mul integral)

private theorem actual_endpoint_profile (c : BurnolCompletedMellinCoordinate) (n : Nat) :
    EqOn (fun x => normalizedEndpoint c x (delta c n)) (fun x => -A c n+B c n*collarPrimitive c x)
      closedBand := by
  have even : reflectL2 (delta c n) = delta c n := by
    change reflectL2 (whole c-compensated c (n+2)) = _
    rw [map_sub, complete_even, compensated_even]
  have canonical := actual_quarter_endpoint_action c (delta c n) even
  have ae : (fun x => normalizedEndpoint c x (delta c n)) =ᵐ[volume.restrict band]
      fun x => -A c n+B c n*collarPrimitive c x := by
    filter_upwards [ae_restrict_of_ae canonical, actual_counted_R_collar c n,
      ae_restrict_mem measurableSet_Ioc] with x original counted member
    have positive := (by norm_num : 0 < q/2).trans member.1
    exact mul_left_cancel₀ (Complex.cpow_ne_zero_iff.mpr (Or.inl (Complex.ofReal_ne_zero.mpr positive.ne')))
      ((original positive member.2).symm.trans counted)
  rw [Measure.restrict_congr_set Ioc_ae_eq_Icc] at ae
  have primitive : ContinuousOn (collarPrimitive c) closedBand :=
    fun x hx => (collar_primitive_derivative c x hx).continuousWithinAt
  exact Measure.eqOn_Icc_of_ae_eq volume (by norm_num) ae (normalized_continuous c _)
    (continuousOn_const.add (continuousOn_const.mul primitive))

/-- The old R prefix and its remaining integral generate canonical endpoint values at both clocks. -/
def actualClockPair (c : BurnolCompletedMellinCoordinate) (n : Nat) : ℂ × ℂ :=
  (normalizedEndpoint c q (delta c n), normalizedEndpoint c p₀ (delta c n))

def clockCoefficients (c : BurnolCompletedMellinCoordinate) (read : ℂ × ℂ) : ℂ × ℂ :=
  (-read.1, (read.2-read.1)/collarPrimitive c p₀)

theorem actual_clock_coefficients (c : BurnolCompletedMellinCoordinate) (n : Nat) :
    clockCoefficients c (actualClockPair c n) = (A c n, B c n) := by
  have edge : collarPrimitive c q = 0 := by simp [collarPrimitive]
  have outer := (actual_endpoint_profile c n) (show q ∈ closedBand from ⟨by norm_num, le_rfl⟩)
  have inner := (actual_endpoint_profile c n) inner_endpoint_mem
  dsimp only at outer inner
  rw [edge, mul_zero, add_zero] at outer
  change (-normalizedEndpoint c q (delta c n),
    (normalizedEndpoint c p₀ (delta c n)-normalizedEndpoint c q (delta c n))/collarPrimitive c p₀) = _
  rw [outer, inner, neg_neg, show -A c n+B c n*collarPrimitive c p₀-(-A c n) =
    B c n*collarPrimitive c p₀ by ring, mul_div_cancel_right₀ _ (fixed_endpoint_primitive_ne c)]

theorem clock_count_stable (c : BurnolCompletedMellinCoordinate) (old new : ℂ × ℂ) :
    ‖(clockCoefficients c new).2-(clockCoefficients c old).2‖ ≤
      (‖new.2-old.2‖+‖new.1-old.1‖)/‖collarPrimitive c p₀‖ := by
  change ‖(new.2-new.1)/collarPrimitive c p₀-(old.2-old.1)/collarPrimitive c p₀‖ ≤ _
  rw [← sub_div, norm_div, show new.2-new.1-(old.2-old.1) = (new.2-old.2)-(new.1-old.1) by ring]
  exact div_le_div_of_nonneg_right (norm_sub_le _ _) (norm_nonneg _)

/-- The same acted count supplies the original physical K column through the outer endpoint. -/
theorem actual_clock_physical (c : BurnolCompletedMellinCoordinate) (n : Nat) :
    P (R₀ c (delta c n)) = -(2*(clockCoefficients c (actualClockPair c n)).1) • K c := by
  have full := (actual_counted_R_fields c).2
  have finite := (actual_compensated_R_fields c (n+1)).2
  change P (R₀ c (whole c)) = _ at full
  change P (R₀ c (compensated c (n+2))) = _ at finite
  change P (R₀ c (whole c-compensated c (n+2))) = _
  rw [map_sub, map_sub, full, finite, actual_clock_coefficients]
  module

theorem actual_clock_K (c : BurnolCompletedMellinCoordinate) (n : Nat) :
    inner ℂ (K c) (P (R₀ c (delta c n))) =
      -(2*(clockCoefficients c (actualClockPair c n)).1) * inner ℂ (K c) (K c) := by
  rw [actual_clock_physical]
  exact inner_smul_right (K c) (K c) _

/-- The recovered count coefficient enters the original installed fixed receipt. -/
theorem actual_fixed_net_from_clock_pair (c : BurnolCompletedMellinCoordinate)
    (zero : riemannZeta c.value = 0) (n : Nat) :
    let test := fourierTest c h₀
    let acted := sourceResolvent (barC c) test
    let b := (clockCoefficients c (actualClockPair c n)).2;
    -(installedOriginalKReceiptAt (burnolPaZeroObservation c zero)
      (burnolPaZeroObservation_nontrivial c zero) c.rightHalf).fixedResidual =
      (pairedMellinTranslationCharacter c.value h₀ -
        pairedMellinTranslationCharacter (star c.value) h₀)*kernelSelfSource c +
      (1/2 : ℂ)*(inner ℂ (movedTest c h₀) (compensated c (n+2)) +
        (2*b)*inner ℂ (CollarRead (movedTest c h₀)) (collarPower c) +
        ForcingPrimitive.leadingCoefficient c*inner ℂ (twoClockCorrection c h₀) (centeredLogColumn c 0) -
        (1/2 : ℂ)*((nativeGamma c-originCoefficient c)*inner ℂ acted Response.wholeU -
          nativeBeta c*inner ℂ acted Response.wholeV +
          2*nativeBeta c*inner ℂ test ConstantDual.seed +
          star c.value*nativeBeta c*inner ℂ acted ConstantDual.seed)) := by
  let a := (clockCoefficients c (actualClockPair c n)).1
  let b := (clockCoefficients c (actualClockPair c n)).2
  have profile : (R₀ c (floorFromResponses c-compensated c (n+2)) : ℝ → ℂ) =ᵐ[volume.restrict band]
      fun x => (x : ℂ)^(-star c.value)*(-a+b*collarPrimitive c x) := by
    dsimp only [a, b]
    rw [actual_clock_coefficients]
    simpa only [conjugate_zero_count c zero, zero_smul, add_zero, sub_zero] using actual_counted_R_collar c n
  exact actual_fixed_net_from_R_collar c zero n a b profile

