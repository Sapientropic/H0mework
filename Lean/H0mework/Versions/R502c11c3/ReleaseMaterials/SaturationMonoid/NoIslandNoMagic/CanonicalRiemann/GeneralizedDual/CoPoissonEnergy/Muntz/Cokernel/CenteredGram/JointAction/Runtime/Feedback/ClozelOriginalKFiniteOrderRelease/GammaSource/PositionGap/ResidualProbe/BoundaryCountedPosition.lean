/-- The actual counted field at each original ordinal restores its whole centered release. -/
theorem actual_expanded_release (ordinal N : Nat) (positive : 0 < N) :
    recoverQuarter N positive (expandedResidual N (counted (slot ordinal) N)) =
      BoundaryQuarterRelease.release a (slot ordinal) := by
  have source := recover_expanded N positive ((T a).adjoint (slot ordinal : BurnolL2))
  rw [BoundaryCountedInverse.cellEquiv_apply, BoundaryCountedInverse.cell_apply] at source
  exact source

/-- The literal original successor applies the induced expanded field action. -/
theorem actual_expanded_next (ordinal N : Nat) (positive : 0 < N) :
    expandedResidual N (counted (slot (ordinal+1)) N) =
      expandedResidual N (R c (expandedResidual N (counted (slot ordinal) N))) := by
  rw [BoundaryCountedTransport.actual_whole_counted_next observation nontrivial half depth ordinal N,
    expanded_residual_step c N positive]

