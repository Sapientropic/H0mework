/-- The original position condition at the radius generated by the discrete cell head. -/
def expandedPosition (N : Nat) : ClosedSubmodule ℂ BurnolL2 :=
  ⟨locallyConstantFace (q * N) ⊓ evenL2ClosedFace.toSubmodule,
    (locallyConstantFace_isClosed (q * N)).inter evenL2ClosedFace.isClosed⟩

private theorem head_position (N : Nat) (positive : 0 < N) (w : BurnolL2) :
    head N w ∈ expandedPosition N ↔ w ∈ position := by
  have indexPositive : (0 : ℝ) < N := by exact_mod_cast positive
  have scaleLive : ((Real.sqrt (N : ℝ) : ℂ)⁻¹) ≠ 0 :=
    inv_ne_zero (Complex.ofReal_ne_zero.mpr (Real.sqrt_pos.mpr indexPositive).ne')
  change ((Real.sqrt (N : ℝ) : ℂ)⁻¹) • U (-Real.log (N : ℝ)) w ∈ (expandedPosition N).toSubmodule ↔ _
  rw [(expandedPosition N).toSubmodule.smul_mem_iff scaleLive]
  have radius : q * Real.exp (-(-Real.log (N : ℝ))) = q * (N : ℝ) := by
    rw [neg_neg, Real.exp_log indexPositive]
  have moved := burnolMultiplicativeDilation_mem_locallyConstantFace_scaled_iff
    (radius := q) (-Real.log (N : ℝ)) (value := w)
  rw [radius] at moved
  exact and_congr moved (burnolMultiplicativeDilation_mem_evenL2ClosedFace_iff (-Real.log (N : ℝ)))

private theorem normalized_position (N : Nat) (positive : 0 < N) {w : BurnolL2}
    (member : w ∈ position) : BoundaryCountedInverse.normalized N positive w ∈ position := by
  let undo : BurnolL2 →L[ℂ] BurnolL2 :=
    (↑(headUnit N positive)⁻¹ : BurnolL2 →L[ℂ] BurnolL2)
  have indexPositive : (0 : ℝ) < N := by exact_mod_cast positive
  have integrable := (ContinuousChannels.channel_integrable (-1) ((N : ℝ)+1) w).mono_set
    (Ioc_subset_Ioc indexPositive.le le_rfl)
  have action : BoundaryCountedInverse.normalized N positive w =
      ∫ r : ℝ in Ioc (N : ℝ) ((N : ℝ)+1), undo (ContinuousChannels.channel (-1) r w) := by
    change undo (remainder N w) = _
    rw [remainder_apply N positive, ← undo.integral_comp_comm integrable]
  rw [action]
  apply integral_mem_closedSubmodule position _ _ (undo.integrable_comp integrable)
  filter_upwards [ae_restrict_mem measurableSet_Ioc] with r inside
  have insideLarge : (N : ℝ) < r := inside.1
  have signed : Real.log (N : ℝ) + -Real.log r ≤ 0 := by
    linarith [Real.log_le_log indexPositive insideLarge.le]
  have dilation : (U (-Real.log (N : ℝ))).symm = U (Real.log (N : ℝ)) := by
    simpa only [neg_neg] using (burnolMultiplicativeDilation_neg_eq_symm (-Real.log (N : ℝ))).symm
  change (Real.sqrt (N : ℝ) : ℂ) • (U (-Real.log (N : ℝ))).symm
    (ContinuousChannels.channel (-1) r w) ∈ position
  rw [ContinuousChannels.channel, neg_one_mul, dilation, map_smul, burnolMultiplicativeDilation_add]
  apply (position).toSubmodule.smul_mem
  apply (position).toSubmodule.smul_mem
  exact ⟨burnolMultiplicativeDilation_mem_locallyConstantFace_of_nonpositive q
    (by norm_num [burnolUnscaledCommonGapRadius]) _ signed w member.1,
    burnolMultiplicativeDilation_mem_evenL2ClosedFace _ w member.2⟩

/-- The original whole cell transports the entire even position face onto the expanded one. -/
theorem cell_position_iff (N : Nat) (positive : 0 < N) (w : BurnolL2) :
    E N positive w ∈ expandedPosition N ↔ w ∈ position := by
  have factorization : E N positive w = head N (w - BoundaryCountedInverse.normalized N positive w) := rfl
  rw [factorization, head_position N positive]
  exact SourceGeneratedContractiveInverse.sub_mem_iff (BoundaryCountedInverse.normalized N positive) (normalized_strict N positive)
    position (fun _ member => normalized_position N positive member) w

/-- The actual invisible component at the expanded position radius is retained as a whole field. -/
def expandedResidual (N : Nat) : BurnolL2 →L[ℂ] BurnolL2 :=
  (expandedPosition N).toSubmoduleᗮ.starProjection

private theorem residual_zero_iff (N : Nat) (w : BurnolL2) :
    expandedResidual N w = 0 ↔ w ∈ expandedPosition N := by
  unfold expandedResidual
  rw [Submodule.starProjection_apply_eq_zero_iff, Submodule.orthogonal_orthogonal]
  rfl

theorem expanded_fibre (N : Nat) (positive : 0 < N) (left right : BurnolL2) :
    expandedResidual N (E N positive left) = expandedResidual N (E N positive right) ↔
      left - right ∈ position := by
  rw [← sub_eq_zero, ← map_sub, ← map_sub, residual_zero_iff, cell_position_iff N positive]

/-- The old centered quarter is decoded from the complete expanded residual. -/
def recoverQuarter (N : Nat) (positive : 0 < N) : BurnolL2 →L[ℂ] Gq :=
  observe.comp (E N positive).symm.toContinuousLinearMap

theorem recover_expanded (N : Nat) (positive : 0 < N) (w : BurnolL2) :
    recoverQuarter N positive (expandedResidual N (E N positive w)) = observe w := by
  let projection := (expandedPosition N).toSubmodule.starProjection
  let retained := (E N positive).symm (projection (E N positive w))
  have membership : retained ∈ position := by
    apply (cell_position_iff N positive retained).mp
    change E N positive ((E N positive).symm (projection (E N positive w))) ∈ expandedPosition N
    rw [ContinuousLinearEquiv.apply_symm_apply]
    exact Submodule.starProjection_apply_mem _ _
  have noQuarter : observe retained = 0 :=
    (center_zero_iff retained).mpr membership.1
  change observe ((E N positive).symm (expandedResidual N (E N positive w))) = _
  unfold expandedResidual
  rw [Submodule.starProjection_orthogonal]
  change observe ((E N positive).symm (E N positive w - projection (E N positive w))) = _
  rw [map_sub, ContinuousLinearEquiv.symm_apply_apply, map_sub]
  change observe w - observe retained = _
  rw [noQuarter, sub_zero]

private theorem expanded_R (coordinate : BurnolCompletedMellinCoordinate) (N : Nat) (positive : 0 < N)
    {w : BurnolL2} (member : w ∈ expandedPosition N) :
    R coordinate w ∈ expandedPosition N := by
  let old := (E N positive).symm w
  have positionMember : old ∈ position := by
    apply (cell_position_iff N positive old).mp
    change E N positive ((E N positive).symm w) ∈ expandedPosition N
    rwa [ContinuousLinearEquiv.apply_symm_apply]
  have oldAction : R coordinate old ∈ position :=
    ⟨CombSource.Pricing.ambient_R_positionGap _ (right_quarter coordinate) old positionMember.1,
      mem_evenL2ClosedFace_iff.mpr
        (inward_even coordinate old (mem_evenL2ClosedFace_iff.mp positionMember.2))⟩
  have square : E N positive (R coordinate old) = R coordinate (E N positive old) := by
    simp only [BoundaryCountedInverse.cellEquiv_apply, BoundaryCountedInverse.cell_apply, counting_R, map_sub]
  have acted := (cell_position_iff N positive (R coordinate old)).mpr oldAction
  rw [square] at acted
  change R coordinate (E N positive ((E N positive).symm w)) ∈ expandedPosition N at acted
  rwa [ContinuousLinearEquiv.apply_symm_apply] at acted

/-- The whole expanded inverse fibre admits the action generated by the original resolvent. -/
theorem expanded_residual_step (coordinate : BurnolCompletedMellinCoordinate) (N : Nat) (positive : 0 < N)
    (w : BurnolL2) :
    expandedResidual N (R coordinate w) = expandedResidual N (R coordinate (expandedResidual N w)) := by
  let projection := (expandedPosition N).toSubmodule.starProjection
  have split : w = expandedResidual N w + projection w := by
    exact ((expandedPosition N).toSubmodule.starProjection_add_starProjection_orthogonal w).symm.trans (add_comm _ _)
  have hidden := expanded_R coordinate N positive (Submodule.starProjection_apply_mem _ w :
    projection w ∈ expandedPosition N)
  have invisible := (residual_zero_iff N _).mpr hidden
  conv_lhs => rw [split]
  rw [map_add, map_add, invisible, add_zero]

