variable (observation : GeneratedRiemannZeroObservation)
variable (nontrivial : ¬ ∃ j : Nat, observation.coordinate = -2*(j+1))
variable (half : OriginalKCombCalculation.Half observation) (depth : Nat)

local notation "c" => burnolDivisionZeroCompletedMellinCoordinate observation half.down
local notation "R" => burnolDirectRightResolventCLM c
local notation "E" => OriginalKCombCofinalPaAction.E
local notation "Pa" => burnolCompactCoPoissonClosedRange
local notation "β" => betaRead observation half
local notation "seed" => (burnolPaCombApproximation 0 : BurnolL2)
local notation "fee" => ReentryDifferenceClock.fee observation nontrivial half depth

private def erasePa : BurnolL2 →ₗ[ℂ] BurnolL2 :=
  LinearMap.id - (evenBurnolClosedFace burnolUnscaledCommonGapRadius).toSubmodule.subtype.comp (E).toLinearMap
local notation "S" => erasePa

private theorem erase_inside {value : BurnolL2} (inside : value ∈ burnolOriginalPaInL2) :
    S value = 0 := sub_eq_zero.mpr (projection_fixed inside).symm

private theorem beta_residual (value : BurnolL2) : β (S value) = β value := by
  change β (value - (E value : BurnolL2)) = β value
  rw [map_sub,beta_zero_of_pa observation half (projected_source value),sub_zero]

/-- The full invisible residual is acted on by the actual original R before the next Pa projection. -/
def invisibleAction : BurnolL2 →ₗ[ℂ] BurnolL2 := (S).comp (R).toLinearMap
local notation "A" => invisibleAction observation half

/-- The original rank-one unit is the injected residual source. -/
def unit : BurnolL2 := S (burnolUnitTailResponse c 4)
local notation "U" => unit observation half

private def counted (n : Nat) : BurnolL2 := (R^n) seed
local notation "field" => counted observation half

private def amount (n : Nat) : ℂ := burnolPaResolventSourceCoefficient c (E (field n))
local notation "α" => amount observation half

private def residual (n : Nat) : BurnolL2 := S (field n)
local notation "q" => residual observation half

private theorem counted_next (n : Nat) : field (n+1) = R (field n) := by
  unfold counted
  rw [pow_succ',mul_apply_eq_comp]

private theorem residual_zero : q 0 = 0 := by
  have initial : field 0 = seed := by simp only [counted,pow_zero,one_apply_eq_self]
  rw [residual,initial]
  exact erase_inside seed_in_pa

/-- Both the homogeneous residual and the injected unit are generated by the same actual write. -/
theorem residual_step (n : Nat) : q (n+1) = A (q n) + α n • U := by
  let input := field n
  let p := E input
  let pa : ↥(Pa).toSubmodule := ⟨p,Submodule.starProjection_apply_mem _ _⟩
  let corrected := burnolPaSourceCorrection c pa
  have retains := burnolPaSourceCorrection_mem c pa
  have gone : S (corrected : BurnolL2) = 0 :=
    erase_inside (Submodule.mem_map.mpr ⟨corrected,retains,rfl⟩)
  have source : R (p : BurnolL2) = (corrected : BurnolL2) + α n • burnolUnitTailResponse c 4 := by
    change _ = (R (p : BurnolL2) - α n • burnolUnitTailResponse c 4) + α n • burnolUnitTailResponse c 4
    exact (sub_add_cancel _ _).symm
  have split : input = (p : BurnolL2) + q n := by
    change input = (p : BurnolL2) + (input-(p : BurnolL2))
    abel
  have first : R input = R (p : BurnolL2) + R (q n) :=
    (congrArg (fun x : BurnolL2 => R x) split).trans (map_add (R) _ _)
  change S (field (n+1)) = A (q n) + α n • U
  rw [counted_next,first,map_add S,source,map_add S,map_smul S,gone,zero_add]
  exact add_comm _ _

include nontrivial in
private theorem opening_ne : α 0 ≠ 0 := by
  intro erased
  have quiet := residual_step observation half 0
  rw [erased,zero_smul,residual_zero,map_zero,zero_add] at quiet
  let response := burnolPaCombPhysicalResponse observation nontrivial half.down 0
  have actual : field 1 = (response : BurnolL2) := by
    unfold counted
    rw [pow_one]
    rfl
  have silent : S (field 1) = 0 := by simpa only [residual,zero_add] using quiet
  have zero : (response : BurnolL2) - (E (response : BurnolL2) : BurnolL2) = 0 := by
    change S (response : BurnolL2) = 0
    exact (congrArg (fun x : BurnolL2 => S x) actual).symm.trans silent
  have same : response = E (response : BurnolL2) := Subtype.ext (sub_eq_zero.mp zero)
  have inside : response ∈ Pa := by
    rw [same]
    exact Submodule.starProjection_apply_mem _ _
  have dual := burnolCompactCoPoissonActionSquare.toIsometricSquare.target_mem_closedRange inside
  have pair : burnolPaCombPairedPhysicalResponse observation nontrivial half.down 0 ∈ Pa :=
    (Pa).toSubmodule.smul_mem _ ((Pa).toSubmodule.add_mem inside dual)
  exact burnolPaCombPairedPhysicalResponse_Q_ne_zero observation nontrivial half.down 0
    (Submodule.starProjection_orthogonal_apply_eq_zero pair)

/-- The actual born unit's return history retains the whole invisible action at every lag. -/
def impulse : Nat → ℂ := response (A) (β).toLinearMap U
local notation "h" => impulse observation half

theorem counted_return (n : Nat) :
    β (field (n+1)) = ∑ i ∈ Finset.range (n+1), α i * h (n-i) := by
  have actual := read_convolution (A) (β).toLinearMap U
    (residual_zero observation half) (residual_step observation half) n
  exact (beta_residual observation half _).symm.trans actual

include nontrivial in
theorem counted_silence_iff : (∀ n, β (field n) = 0) ↔ ∀ lag, h lag = 0 := by
  have read : (∀ n, β (field n) = 0) ↔ ∀ n, (β).toLinearMap (q n) = 0 := by
    constructor
    · intro silent n
      exact (beta_residual observation half _).trans (silent n)
    · intro silent n
      exact (beta_residual observation half _).symm.trans (silent n)
  exact read.trans (silence_iff (A) (β).toLinearMap U
    (residual_zero observation half) (residual_step observation half) (opening_ne observation nontrivial half))

private theorem unit_invisible : E U = 0 := OriginalKCombCofinalPaAction.invisible_mem _

private theorem erase_fixed {value : BurnolL2} (silent : E value = 0) : S value = value := by
  change value - (E value : BurnolL2) = value
  rw [silent,Submodule.coe_zero,sub_zero]

private theorem next_power (lag : Nat) : (R^(lag+1)) U = R ((R^lag) U) := by
  rw [pow_succ',mul_apply_eq_comp]

private theorem same_action (lag : Nat) (before : (A^lag) U = (R^lag) U)
    (next : E ((R^(lag+1)) U) = 0) :
    (A^(lag+1)) U = (R^(lag+1)) U := by
  rw [pow_succ',Module.End.mul_apply,before]
  change S (R ((R^lag) U)) = _
  rw [← next_power observation half lag]
  exact erase_fixed next

include nontrivial in
private theorem invisible_step (value : BurnolL2) (silent : E value = 0) :
    E (R value) = β value • (OriginalKDirectRCofinalReentrySourceAction.sourceReentryVector c : BurnolPaAmbientCarrier) := by
  have paid := fibre_return observation nontrivial half value
  have same : OriginalKCombCofinalPaAction.invisible value = value := erase_fixed silent
  rwa [same] at paid

include nontrivial in
/-- Silence of the returned unit makes its entire original unprojected orbit invisible. -/
theorem impulse_silence_iff_native :
    (∀ lag, h lag = 0) ↔ ∀ lag, E ((R^lag) U) = 0 := by
  constructor
  · intro silent
    have paid (lag : Nat) : (A^lag) U = (R^lag) U ∧ E ((R^lag) U) = 0 := by
      induction lag with
      | zero =>
        constructor
        · simp only [pow_zero,Module.End.one_apply,one_apply_eq_self]
        · simpa only [pow_zero,one_apply_eq_self] using unit_invisible observation half
      | succ lag previous =>
        have read : β ((A^lag) U) = 0 := silent lag
        rw [previous.1] at read
        have next := invisible_step observation nontrivial half ((R^lag) U) previous.2
        rw [read,zero_smul,← next_power observation half lag] at next
        exact ⟨same_action observation half lag previous.1 next,next⟩
    exact fun lag => (paid lag).2
  · intro silent lag
    have paid (n : Nat) : (A^n) U = (R^n) U := by
      induction n with
      | zero => simp only [pow_zero,Module.End.one_apply,one_apply_eq_self]
      | succ n previous => exact same_action observation half n previous (silent (n+1))
    have actual := invisible_step observation nontrivial half ((R^lag) U) (silent lag)
    rw [← next_power observation half lag,silent] at actual
    change β ((A^lag) U) = 0
    rw [paid]
    exact (smul_eq_zero.mp actual.symm).resolve_right (vector_ne observation nontrivial half)

/-- Literal tail silence is determined by the complete return of the original injected unit. -/
theorem literal_tail_silence_iff (cutoff : Nat) :
    (∀ ordinal ≥ cutoff, fee ordinal = 0) ↔ ∀ lag, h lag = 0 := by
  constructor
  · intro silent
    apply (counted_silence_iff observation nontrivial half).1
    have quiet (n : Nat) (after : sourceIndex observation cutoff ≤ n) : β (field n) = 0 := by
      let ordinal := n-sourceIndex observation 0
      have index : sourceIndex observation ordinal = n := by
        dsimp [ordinal,sourceIndex] at *
        omega
      have later : cutoff ≤ ordinal := by
        dsimp [ordinal,sourceIndex] at *
        omega
      have price := silent ordinal later
      rw [ReentryDifferenceClock.literal_fee,raw_power,index] at price
      exact price
    exact original_power_read_zero_of_tail (β) c seed (sourceIndex observation cutoff) quiet
  · intro silent ordinal _
    rw [ReentryDifferenceClock.literal_fee,raw_power]
    exact (counted_silence_iff observation nontrivial half).2 silent (sourceIndex observation ordinal)

