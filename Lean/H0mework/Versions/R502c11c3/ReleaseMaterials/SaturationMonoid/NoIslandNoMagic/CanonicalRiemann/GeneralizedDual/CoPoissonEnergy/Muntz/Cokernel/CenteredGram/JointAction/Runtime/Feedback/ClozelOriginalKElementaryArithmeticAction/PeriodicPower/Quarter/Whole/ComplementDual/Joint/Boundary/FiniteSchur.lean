def plainCoefficient (c:BurnolCompletedMellinCoordinate) (j:ℕ):ℂ:=
  (2/(1-c.value))^j*nativeCotestGap c

def plainContact (c:BurnolCompletedMellinCoordinate):ℂ:=
  2*c.value*(q:ℂ)^(1-c.value)/(1-c.value)^2

def nativeCoefficient (c:BurnolCompletedMellinCoordinate):ℕ→ℕ→ℂ
  | 0,_=>0
  | j+1,0=>plainContact c*plainCoefficient c j+nativeActedAmplitude c j+
      ∑k∈Finset.range j,(2*meanContact (barC c) k)*nativeCoefficient c j k
  | j+1,k+1=> -2*nativeCoefficient c j k

def finiteNativeSchur (c:BurnolCompletedMellinCoordinate) (j:ℕ):M:=
  plainCoefficient c j • ell+
    ∑k∈Finset.range j,nativeCoefficient c j k • centeredLogColumn (barC c) k

private theorem finite_step (c:BurnolCompletedMellinCoordinate) (j:ℕ):
    centeredQuarterStep (barC c) (finiteNativeSchur c j)+
      nativeActedAmplitude c j • SingularCounting.centeredPower (barC c)=finiteNativeSchur c (j+1):=by
  have scalar:plainCoefficient c (j+1)=(2/(1-c.value))*plainCoefficient c j:=by
    unfold plainCoefficient
    rw [pow_succ]
    ring
  have expanded:(∑k∈Finset.range (j+1),nativeCoefficient c (j+1) k • centeredLogColumn (barC c) k)=
      (plainContact c*plainCoefficient c j+nativeActedAmplitude c j+
        ∑k∈Finset.range j,(2*meanContact (barC c) k)*nativeCoefficient c j k) • centeredLogColumn (barC c) 0+
      ∑k∈Finset.range j,(-2*nativeCoefficient c j k) • centeredLogColumn (barC c) (k+1):=by
    rw [Finset.sum_range_succ']
    simp only [nativeCoefficient]
    rw [add_comm]
  unfold finiteNativeSchur
  rw [map_add,map_smul,map_sum,actual_plain_log_step]
  simp only [map_smul,centered_log_step,smul_add,smul_smul]
  rw [Finset.sum_add_distrib,←Finset.sum_smul,expanded,scalar]
  change _=(2/(1-c.value)*plainCoefficient c j) • ell+
    ((plainContact c*plainCoefficient c j+nativeActedAmplitude c j+
      ∑k∈Finset.range j,(2*meanContact (barC c) k)*nativeCoefficient c j k) •
        SingularCounting.centeredPower (barC c)+
      ∑k∈Finset.range j,(-2*nativeCoefficient c j k) • centeredLogColumn (barC c) (k+1))
  have reorder (k:ℕ):nativeCoefficient c j k*(2*meanContact (barC c) k)=
      (2*meanContact (barC c) k)*nativeCoefficient c j k:=mul_comm _ _
  simp_rw [reorder]
  have zeroth:centeredLogColumn (barC c) 0=SingularCounting.centeredPower (barC c):=rfl
  have shiftReorder (k:ℕ):nativeCoefficient c j k*(-2)=(-2)*nativeCoefficient c j k:=mul_comm _ _
  rw [zeroth]
  simp_rw [shiftReorder]
  unfold plainContact
  module

/-- The complete acted native Schur input is generated by one plain-log column and its finite actual source history. -/
theorem actual_native_finite_schur (c:BurnolCompletedMellinCoordinate) (zero:riemannZeta c.value=0) (j:ℕ):
    nativeActedSchur c j=finiteNativeSchur c j:=by
  induction j with
  | zero=>
    rw [actual_native_initial_log c zero]
    simp only [finiteNativeSchur,plainCoefficient,pow_zero,one_mul,Finset.range_zero,Finset.sum_empty,add_zero]
    rfl
  | succ j previous=>
    rw [actual_native_acted_schur_step c zero j,previous,finite_step]

/-- The original acted correction leg consumes the generated finite columns without replacing its native test. -/
theorem actual_native_finite_correction_price (c:BurnolCompletedMellinCoordinate)
    (zero:riemannZeta c.value=0) (j:ℕ):
    inner ℂ (((R c)^j) (nativeCotest c)) (fourierL2 (burnolQuarterZeroExtension
      (OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.ComplementDual.Source.correction c.value c.belowOne:Hq)))=
      star (plainCoefficient c j)*inner ℂ ell (OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.ComplementDual.Source.correction c.value c.belowOne)+
      ∑k∈Finset.range j,star (nativeCoefficient c j k)*
        inner ℂ (centeredLogColumn (barC c) k) (OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.ComplementDual.Source.correction c.value c.belowOne):=by
  let b:=OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.ComplementDual.Source.correction c.value c.belowOne
  let v:=((R c)^j) (nativeCotest c)
  have fourier:=fourierL2.inner_map_map (fourierL2.symm v) (burnolQuarterZeroExtension (b:Hq))
  rw [fourierL2.apply_symm_apply] at fourier
  have quarter:=ContinuousLinearMap.adjoint_inner_right burnolQuarterRestriction (fourierL2.symm v) (b:Hq)
  change inner ℂ (fourierL2.symm v) (burnolQuarterZeroExtension (b:Hq))=
    inner ℂ (burnolQuarterRestriction (fourierL2.symm v)) (b:Hq) at quarter
  have centered:inner ℂ (burnolQuarterRestriction (fourierL2.symm v)) (b:Hq)=
      inner ℂ (Constructor.zeroMean (burnolQuarterRestriction (fourierL2.symm v))) b:=
    (Submodule.inner_orthogonalProjectionOnto_eq_of_mem_right b _).symm
  rw [fourier,quarter,centered]
  change inner ℂ (Constructor.zeroMean (burnolQuarterRestriction
    (fourierL2.symm (((R c)^j) (nativeCotest c))))) b=_
  rw [actual_native_acted_schur c zero j,actual_native_finite_schur c zero j,finiteNativeSchur,
    inner_add_left,inner_smul_left,sum_inner]
  simp only [starRingEnd_apply]
  congr 1
  apply Finset.sum_congr rfl
  intro k member
  rw [inner_smul_left]
  rfl

end OriginalKElementaryArithmeticAction.PeriodicPower.Quarter.Whole.ComplementDual.Joint.Boundary.FiniteSchur
