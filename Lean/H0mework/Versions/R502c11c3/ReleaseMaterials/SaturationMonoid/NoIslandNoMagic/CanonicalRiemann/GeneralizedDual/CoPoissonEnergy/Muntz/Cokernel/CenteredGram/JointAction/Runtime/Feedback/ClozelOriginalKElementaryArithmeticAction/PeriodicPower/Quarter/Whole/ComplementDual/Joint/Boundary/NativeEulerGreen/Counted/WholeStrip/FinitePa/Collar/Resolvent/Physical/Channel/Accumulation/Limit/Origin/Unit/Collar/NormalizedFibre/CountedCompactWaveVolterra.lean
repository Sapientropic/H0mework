local notation "L¹" => Lp ℂ 1 (volume : Measure ℝ)
local notation "S'" => TemperedDistribution ℝ ℂ
local notation "q" => (1/4 : ℝ)
local notation "r₀" => (q/2)
local notation "s₀" => fun c => star (BurnolCompletedMellinCoordinate.value c)

/-- The bounded wave response is generated by the actual source wave
along the dilations of each frequency. -/
theorem compact_wave_volterra (c : BurnolCompletedMellinCoordinate)
    (output input : L¹ × BurnolL2) (scale : ℂ)
    (outputSupport : ∀ᵐ x : ℝ ∂volume, q < |x| → output.1 x = 0 ∧ output.2 x = 0)
    (inputSupport : ∀ᵐ x : ℝ ∂volume, q < |x| → input.1 x = 0 ∧ input.2 x = 0)
    (equation : eulerOfPhysicalSplit c output = scale • distributionOfSplit input)
    (ξ : ℝ) :
    compactPhaseWave output ξ = -scale*(∫ t : ℝ in 0..1, (t : ℂ)^(-s₀ c)*compactPhaseWave input (t*ξ)) := by
  let p := 1-s₀ c
  let W := compactPhaseWave output
  let V := compactPhaseWave input
  let F := fun t : ℝ => (t : ℂ)^p*W (t*ξ)
  have positive : 0 < p.re := by
    dsimp only [p]
    simp only [sub_re, one_re, star_def, conj_re]
    linarith [c.belowOne]
  have live : p ≠ 0 := fun zero => by rw [zero, zero_re] at positive; exact lt_irrefl 0 positive
  have outputContinuous : Continuous F :=
    (Complex.continuous_ofReal_cpow_const positive).mul (W.continuous.comp (continuous_id.mul continuous_const))
  have inputContinuous : Continuous (fun t : ℝ => V (t*ξ)) :=
    V.continuous.comp (continuous_id.mul continuous_const)
  have derivative (t : ℝ) (inside : t ∈ Ioo (0 : ℝ) 1) :
      HasDerivAt F (-scale*((t : ℂ)^(-s₀ c)*V (t*ξ))) t := by
    let d := deriv (fun x => W x) (t*ξ)
    have original : HasDerivAt (fun x => W x) d (t*ξ) :=
      (compact_wave_hasDerivAt output outputSupport (t*ξ)).differentiableAt.hasDerivAt
    have scaled : HasDerivAt (fun x => W (x*ξ)) ((ξ : ℂ)*d) t := by
      have clock : HasDerivAt (fun x : ℝ => x*ξ) ξ t := by
        simpa only [id_eq, one_mul] using (hasDerivAt_id t).mul_const ξ
      simpa only [Function.comp_def, Complex.real_smul] using original.scomp t clock
    have power := hasDerivAt_ofReal_cpow_const inside.1.ne' live
    rw [show p-1 = -s₀ c by dsimp only [p]; ring] at power
    have product := power.mul scaled
    have raised : (t : ℂ)^p = (t : ℂ)^(-s₀ c)*(t : ℂ) := by
      rw [show p = -s₀ c+1 by dsimp only [p]; ring,
        Complex.cpow_add _ _ (Complex.ofReal_ne_zero.mpr inside.1.ne'), Complex.cpow_one]
    have actual := compact_wave_euler c output input scale outputSupport inputSupport equation (t*ξ)
    change ((t*ξ : ℝ) : ℂ)*d+p*W (t*ξ) = -scale*V (t*ξ) at actual
    rw [Complex.ofReal_mul] at actual
    have price : (p*(t : ℂ)^(-s₀ c))*W (t*ξ)+(t : ℂ)^p*((ξ : ℂ)*d) =
        -scale*((t : ℂ)^(-s₀ c)*V (t*ξ)) := by
      rw [raised]
      linear_combination ((t : ℂ)^(-s₀ c))*actual
    change HasDerivAt F ((p*(t : ℂ)^(-s₀ c))*W (t*ξ)+(t : ℂ)^p*((ξ : ℂ)*d)) t at product
    rw [price] at product
    exact product
  have powerDomain : IntervalIntegrable (fun t : ℝ => (t : ℂ)^(-s₀ c)) volume 0 1 := by
    apply intervalIntegral.intervalIntegrable_cpow'
    simp only [neg_re, star_def, conj_re]
    linarith [c.belowOne]
  have domain := (powerDomain.mul_continuousOn inputContinuous.continuousOn).const_mul (-scale)
  have actual := intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le
    (by norm_num : (0 : ℝ) ≤ 1) outputContinuous.continuousOn derivative domain
  have start : F 0 = 0 := by simp only [F, Complex.ofReal_zero, Complex.zero_cpow live, zero_mul]
  have finish : F 1 = W ξ := by simp only [F, Complex.ofReal_one, Complex.one_cpow, one_mul]
  rw [start, finish, sub_zero, intervalIntegral.integral_const_mul] at actual
  exact actual.symm

/-- The complete ordinary wave at each actual count is computed from
the literal same phase input. -/
theorem actual_counted_compact_phase_volterra (c : BurnolCompletedMellinCoordinate) (n : Nat) (ξ : ℝ) :
    compactPhaseWave (countedCompactPhaseField c n) ξ =
      2*(∫ t : ℝ in 0..1, (t : ℂ)^(-s₀ c)*
        compactPhaseWave (splitAtPhysicalCutoff r₀ (countedPhaseSource c n)) (t*ξ)) := by
  simpa only [neg_neg] using compact_wave_volterra c _ _ (-(2 : ℂ))
    (actual_counted_compact_phase_support c n) (counted_phase_input_support c n)
    (actual_counted_compact_phase_euler c n) ξ

/-- The same law computes the complete limiting wave from the original seed. -/
theorem actual_counted_compact_phase_limit_volterra (c : BurnolCompletedMellinCoordinate) (ξ : ℝ) :
    compactPhaseWave (countedCompactPhaseLimit c) ξ =
      -(∫ t : ℝ in 0..1, (t : ℂ)^(-s₀ c)*compactPhaseWave (countedSeedSplit c) (t*ξ)) := by
  have equation : eulerOfPhysicalSplit c (countedCompactPhaseLimit c) =
      (1 : ℂ) • distributionOfSplit (countedSeedSplit c) := by
    rw [(actual_counted_compact_phase_observations c).1]
    ext test
    simp
  simpa only [neg_mul, one_mul] using compact_wave_volterra c _ _ (1 : ℂ)
    (actual_compact_phase_limit_support c) (counted_seed_support c) equation ξ

