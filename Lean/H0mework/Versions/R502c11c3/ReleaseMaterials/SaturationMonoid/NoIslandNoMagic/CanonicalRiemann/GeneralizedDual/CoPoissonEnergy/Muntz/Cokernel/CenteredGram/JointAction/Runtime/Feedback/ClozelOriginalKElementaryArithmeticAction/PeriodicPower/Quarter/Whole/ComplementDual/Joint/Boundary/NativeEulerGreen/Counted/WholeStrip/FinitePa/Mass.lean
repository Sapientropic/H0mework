private theorem log_count_mean (c : BurnolCompletedMellinCoordinate) (N : ℕ) (positive : 0 < N) :
    burnolQuarterMeanCoefficient (Q (logCount c N)) =
      2*inner ℂ SmallScaleLog.logL2 (S (logBFirst c 0) : Hq) := by
  let state := S (logBFirst c 0)
  let constant := intervalConstant q
  have pairing : inner ℂ constant (Q (logCount c N)) =
      inner ℂ (WindowCounting.windowSource N constant) (state : Hq) := by
    calc
      _ = inner ℂ (E constant) (logCount c N) :=
        (ContinuousLinearMap.adjoint_inner_left burnolQuarterRestriction _ _).symm
      _ = inner ℂ (FiniteForcing.source N (E constant)) (E (state : Hq)) :=
        (CountingDual.source_pairing N _ _).symm
      _ = _ := ContinuousLinearMap.adjoint_inner_right burnolQuarterRestriction _ _
  have centered : inner ℂ constant (state : Hq) = 0 :=
    (Submodule.mem_orthogonal _ _).mp state.property _ (Submodule.mem_span_singleton_self _)
  unfold burnolQuarterMeanCoefficient
  rw [pairing, WindowCounting.constant_source N positive, inner_add_left, inner_smul_left,
    centered, mul_zero, zero_add, Complex.ofReal_pow,
    burnolIntervalConstant_norm_sq (by norm_num : (0 : ℝ) < q)]
  norm_num
  ring

/-- The complete Unit bill is generated by the original position and log return. -/
def unitMean (c : BurnolCompletedMellinCoordinate) : ℂ :=
  2*lead c*inner ℂ SmallScaleLog.logL2 (S (logBFirst c 0) : Hq) -
    4*(∫ y : ℝ in Ioc 0 q, positionSource c y * (Real.log (q/y) : ℂ))

private theorem position_full_mass (c : BurnolCompletedMellinCoordinate) (N : ℕ) :
    (∫ x : ℝ, PositionCounting.raw c N x ∂μq) =
      ∫ x : ℝ, PositionCounting.raw c N x := by
  rw [← integral_indicator (measurableSet_symmetricInterval q)]
  apply integral_congr_ae
  filter_upwards with x
  by_cases inside : x ∈ symmetricInterval q
  · rw [indicator_of_mem inside]
  · rw [indicator_of_notMem inside, PositionCountedEuler.raw_outside c N x
      (lt_of_not_ge (fun bounded => inside (abs_le.mp bounded)))]

theorem actual_compensated_mean (c : BurnolCompletedMellinCoordinate) (N : ℕ) (positive : 0 < N) :
    burnolQuarterMeanCoefficient (Q (compensated c N)) = unitMean c := by
  have raw : (Q (compensated c N) : ℝ → ℂ) =ᵐ[μq]
      fun x => lead c*logCount c N x + PositionCounting.raw c N x -
        Z c N * (symmetricInterval q).indicator (seedRaw c.value) x :=
    (LpToLpRestrictCLM_coeFn ℂ (symmetricInterval q) (compensated c N)).trans
      (ae_restrict_of_ae (actual_compensated_raw c N))
  have localRaw : (Q (compensated c N) : ℝ → ℂ) =ᵐ[μq]
      fun x => lead c*logCount c N x + PositionCounting.raw c N x - Z c N*seedRaw c.value x := by
    filter_upwards [raw, ae_restrict_mem (measurableSet_symmetricInterval q)] with x read inside
    rw [read, indicator_of_mem inside]
  have logRead : (Q (logCount c N) : ℝ → ℂ) =ᵐ[μq] (logCount c N : ℝ → ℂ) :=
    LpToLpRestrictCLM_coeFn ℂ (symmetricInterval q) (logCount c N)
  have logDomain : Integrable (fun x : ℝ => logCount c N x) μq :=
    ((Lp.memLp (Q (logCount c N))).integrable (by norm_num)).congr logRead
  have positionDomain : Integrable (PositionCounting.raw c N) μq :=
    (PositionCountingMass.raw_integrable c N).restrict
  have seedDomain := actual_seed_integrable c.value c.belowOne
  have logMean := log_count_mean c N positive
  rw [Constructor.mean_integral, integral_congr_ae logRead] at logMean
  have split := integral_sub ((logDomain.const_mul (lead c)).add positionDomain) (seedDomain.const_mul (Z c N))
  have sum := integral_add (logDomain.const_mul (lead c)) positionDomain
  simp only [Pi.add_apply] at split sum
  rw [Constructor.mean_integral, integral_congr_ae localRaw, split, sum, integral_const_mul, integral_const_mul,
    actual_seed_mean c.value c.belowOne, mul_zero, sub_zero, position_full_mass,
    PositionCountingMass.mass_of_one_le c N positive]
  unfold unitMean
  linear_combination lead c*logMean

/-- The original physical projection receives the complete fixed Unit and the actual moving K coefficient. -/
theorem actual_finite_Pa (c : BurnolCompletedMellinCoordinate) (N : ℕ) (positive : 0 < N) :
    P (D N (input c)) = unitMean c • P ConstantDual.seed - Z c N • K c := by
  have projected := congrArg P (actual_compact c N positive)
  rw [actual_compact_projection, actual_compensated_mean c N positive] at projected
  change unitMean c • P ConstantDual.seed = P (compensated c N) at projected
  rw [compensated, map_add, map_smul, elementary_projection] at projected
  exact eq_sub_of_add_eq projected.symm

theorem actual_physical_difference (c : BurnolCompletedMellinCoordinate)
    (N M : ℕ) (positiveN : 0 < N) (positiveM : 0 < M) :
    P (D N (input c) - D M (input c)) = (Z c M-Z c N) • K c := by
  rw [map_sub, actual_finite_Pa c N positiveN, actual_finite_Pa c M positiveM]
  module

theorem actual_Pa_limit (c : BurnolCompletedMellinCoordinate) :
    P (floorFromResponses c) = unitMean c • P ConstantDual.seed -
      riemannZeta (star c.value) • K c := by
  have actual := ((burnolEvenAmbientProjection).continuous.tendsto (floorFromResponses c)).comp
    (actual_floor_tendsto c)
  have coefficient := (coefficient_limit c).smul (tendsto_const_nhds (x := K c))
  have paid := (tendsto_const_nhds (x := unitMean c • P ConstantDual.seed)).sub coefficient
  apply tendsto_nhds_unique actual
  apply paid.congr'
  filter_upwards [eventually_ge_atTop (1 : ℕ)] with N positive
  exact (actual_finite_Pa c N positive).symm

/-- The independent original K price reads both actual physical components at the same cutoff. -/
theorem actual_original_K_price (c d : BurnolCompletedMellinCoordinate) (N : ℕ) (positive : 0 < N) :
    inner ℂ (K d : BurnolL2) (D N (input c)) =
      unitMean c * inner ℂ (K d) (P ConstantDual.seed) - Z c N * inner ℂ (K d) (K c) := by
  rw [physical_inner (K d), actual_finite_Pa c N positive, inner_sub_right]
  exact congrArg₂ (fun left right : ℂ => left-right)
    (inner_smul_right (K d) (P ConstantDual.seed) (unitMean c))
    (inner_smul_right (K d) (K c) (Z c N))

