import H0mework.Versions.R1f4eaffd.ReleaseMaterials.SaturationMonoid.GenericFoundation.Cofinal.Topology.CokernelTorsion.CoherentKernel
import H0mework.Versions.R1f4eaffd.ReleaseMaterials.SaturationMonoid.GenericFoundation.Cofinal.Topology.CokernelTorsion.CoherentEquivalence

set_option autoImplicit false
set_option Elab.async false

noncomputable section
universe u
namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace SourceGeneratedPrimePowerCompletion

open CategoryTheory CategoryTheory.Limits

variable {L M L' M' : Type u} [AddCommGroup L] [AddCommGroup M] [AddCommGroup L'] [AddCommGroup M']
variable (evaluate : L →ₗ[ℤ] M) (evaluateNext : L' →ₗ[ℤ] M')
variable (source : L →ₗ[ℤ] L') (target : M →ₗ[ℤ] M')
variable (actual : ∀ word, target (evaluate word) = evaluateNext (source word))

/-- The source action sends the old evaluation range into the actual next range. -/
def evaluationCokernelAction :
    (M ⧸ LinearMap.range evaluate) →ₗ[ℤ] (M' ⧸ LinearMap.range evaluateNext) :=
  (LinearMap.range evaluate).mapQ (LinearMap.range evaluateNext) target (by
    rintro _ ⟨word, rfl⟩
    exact ⟨source word, (actual word).symm⟩)

variable (injective : Function.Injective evaluate) (injectiveNext : Function.Injective evaluateNext)

private theorem cokernel_connecting_stage_naturality (p : Nat.Primes) (j : Nat)
    (value : CokernelTorsion evaluate p j) :
    stageCokernelConnecting evaluateNext injectiveNext p j
        (primePowerTorsionMap (evaluationCokernelAction evaluate evaluateNext source target actual) p j value) =
      stageMap p j source (stageCokernelConnecting evaluate injective p j value) := by
  obtain ⟨word, divided, paid, rfl⟩ := cokernel_torsion_has_division evaluate p j value
  have arrived : powerMultiplication p j (target divided) = evaluateNext (source word) :=
    ((map_smul target ((p.1 : ℤ)^(j+1)) divided).symm.trans (congrArg target paid)).trans (actual word)
  have writes : primePowerTorsionMap (evaluationCokernelAction evaluate evaluateNext source target actual) p j
      (cokernelTorsionClassOfDivision evaluate p j word divided paid) =
      cokernelTorsionClassOfDivision evaluateNext p j (source word) (target divided) arrived :=
    Subtype.ext rfl
  rw [writes, stage_cokernel_connecting_of_paid, stage_cokernel_connecting_of_paid]
  exact (LinearMap.congr_fun (stageMap_projection p j source) word).symm

/-- Coherent write-back is generated by the same action on actual divided representatives. -/
theorem cokernel_connecting_limit_naturality (p : Nat.Primes)
    (value : PrimePowerTorsionCompletion (M ⧸ LinearMap.range evaluate) p) :
    cokernelConnectingAtLimit evaluateNext injectiveNext p
        (primePowerTorsionLimitMap (evaluationCokernelAction evaluate evaluateNext source target actual) p value) =
      inducedCompletionLinearMap p source (cokernelConnectingAtLimit evaluate injective p value) := by
  apply Concrete.limit_ext (tower (L := L') p)
  rintro ⟨j⟩
  let action := evaluationCokernelAction evaluate evaluateNext source target actual
  change (restriction (L := L') p j).hom
      (cokernelConnectingAtLimit evaluateNext injectiveNext p (primePowerTorsionLimitMap action p value)) =
    (restriction (L := L') p j).hom (inducedCompletionLinearMap p source
      (cokernelConnectingAtLimit evaluate injective p value))
  have nextRead := ConcreteCategory.congr_hom (inducedCompletionMap_restriction p source j)
    (cokernelConnectingAtLimit evaluate injective p value)
  change (restriction (L := L') p j).hom
      (inducedCompletionLinearMap p source (cokernelConnectingAtLimit evaluate injective p value)) =
    stageMap p j source ((restriction (L := L) p j).hom
      (cokernelConnectingAtLimit evaluate injective p value)) at nextRead
  rw [nextRead, cokernel_connecting_limit_restriction evaluateNext,
    torsion_limit_map_restriction, cokernel_connecting_limit_restriction evaluate]
  exact cokernel_connecting_stage_naturality evaluate evaluateNext source target actual injective injectiveNext
    p j ((torsionCompletionRestriction (M ⧸ LinearMap.range evaluate) p j).hom value)

theorem cokernel_completion_equiv_naturality (p : Nat.Primes)
    (divides : ∀ j, Function.Bijective (powerMultiplication (L := M) p j))
    (dividesNext : ∀ j, Function.Bijective (powerMultiplication (L := M') p j))
    (value : Completion (L := L) p) :
    primePowerTorsionLimitMap (evaluationCokernelAction evaluate evaluateNext source target actual) p
        (cokernelCompletionEquiv evaluate injective p divides value) =
      cokernelCompletionEquiv evaluateNext injectiveNext p dividesNext (inducedCompletionLinearMap p source value) := by
  let old := cokernelCompletionEquiv evaluate injective p divides
  let next := cokernelCompletionEquiv evaluateNext injectiveNext p dividesNext
  apply next.symm.injective
  change cokernelConnectingAtLimit evaluateNext injectiveNext p
      (primePowerTorsionLimitMap (evaluationCokernelAction evaluate evaluateNext source target actual) p (old value)) =
    cokernelConnectingAtLimit evaluateNext injectiveNext p (next (inducedCompletionLinearMap p source value))
  have paid : cokernelConnectingAtLimit evaluate injective p (old value) = value := old.symm_apply_apply value
  have arrived : cokernelConnectingAtLimit evaluateNext injectiveNext p (next (inducedCompletionLinearMap p source value)) =
      inducedCompletionLinearMap p source value := next.symm_apply_apply _
  rw [cokernel_connecting_limit_naturality evaluate evaluateNext source target actual
    injective injectiveNext p (old value), paid, arrived]

end SourceGeneratedPrimePowerCompletion
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
