import H0mework.Versions.R3b3d24a4.ReleaseMaterials.SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Accounting.Quantifiers.Assembly.Strengthening.Transition.Handoff.Select

set_option autoImplicit false

namespace SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Accounting.Quantifiers.Assembly.Strengthening.Transition.Handoff

open Abolition.Root Abolition.Root.Registered Abolition.Root.Registered.Macro PublicFunction Quantities

noncomputable section

variable {Party Good Port Technology Instrument TaskId : Type}
  [DecidableEq Party] [DecidableEq Good] [DecidableEq Port] [DecidableEq Instrument]
  [DecidableEq TaskId]

local notation "C" => Evolving.Epoch.Current (Party := Party) (Good := Good) (Port := Port)
  (Technology := Technology) (Instrument := Instrument)
local notation "Plan" => Proposal Party Good Port Technology Instrument
local notation "Script" => List (Option (Compile.RawInput Party Good Port Technology Instrument))

def availablePreparations (source : C) : List (Option (Compile.RawInput Party Good Port Technology Instrument)) :=
  let input := Public.Scope.checkInput source.native.input
  [none, some .advance] ++
    (Material.Migration.sourceAlphabet input source.raw).map (fun request => some (.primitive request))

/-- Each next alphabet is read from the cut generated by the preceding
proposals, including any native work those proposals created. -/
def preparationWords : Nat → C → List Script
  | 0, _ => [[]]
  | fuel + 1, source => [] :: (availablePreparations source).flatMap fun first =>
      (preparationWords fuel (Execution.next source first)).map (first :: ·)

def sourcePairsAfter (source : C) (prefixLimit renewalLimit : Nat) (preparation : Script) :=
  let after := Execution.endAt source preparation
  let ready := Execution.endAt after (Execution.drain after)
  Material.Migration.sourcePairs (Public.Scope.checkInput ready.native.input) ready.raw prefixLimit renewalLimit

def sourceCandidates (source : C) (preparationLimit prefixLimit renewalLimit : Nat) : List Plan :=
  (preparationWords preparationLimit source).flatMap fun preparation =>
    (sourcePairsAfter source prefixLimit renewalLimit preparation).map (Proposal.mk preparation)

theorem sourceCandidates_exact (source : C) (preparationLimit prefixLimit renewalLimit : Nat) (proposal : Plan) :
    proposal ∈ sourceCandidates source preparationLimit prefixLimit renewalLimit ↔
      proposal.preparation ∈ preparationWords preparationLimit source ∧
      proposal.pair ∈ sourcePairsAfter source prefixLimit renewalLimit proposal.preparation := by
  unfold sourceCandidates
  constructor
  · intro member
    obtain ⟨preparation, listed, item⟩ := List.mem_flatMap.mp member
    obtain ⟨pair, supplied, rfl⟩ := List.mem_map.mp item
    exact ⟨listed, supplied⟩
  · rintro ⟨preparation, pair⟩
    exact List.mem_flatMap.mpr ⟨proposal.preparation, preparation,
      List.mem_map.mpr ⟨proposal.pair, pair, by cases proposal; rfl⟩⟩

def selectFromSource (source : C) (preparationLimit prefixLimit renewalLimit : Nat)
    (ordered : List TaskId) (task : TaskId → PublicTaskSpec Party Good)
    (reserved : ∀ word : Script, Finset (Due.Service.Ordinal source word))
    (held : Finset (Due.Service.Need ordered.toFinset task)) (budget : Party × Good → ℚ) (deadline : WithTop ℚ) :=
  select source ordered task reserved held budget deadline
    (sourceCandidates source preparationLimit prefixLimit renewalLimit) (handoffTime source)

end

end SaturationMonoid.ProcessGame.Society.Institutions.Capitalism.Universal.Abolition.Accounting.Quantifiers.Assembly.Strengthening.Transition.Handoff
