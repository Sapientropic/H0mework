import H0mework.Versions.Y.Arithmetic.BlockSpecialization.CokernelGlobalTower
import H0mework.Versions.X.Arithmetic.EulerLocal.CrossPrimeResidual
import H0mework.Versions.Y.Arithmetic.EulerGlobal.HistoryCofinalRigidity

/-!
# Existing global endpoint occurrence with its arithmetic cokernel image

The global arithmetic image is installed by mapping the already generated
`globalEndpointBoundaryCokernelOccurrence`.  No new seed occurrence or cone is
created.  The actual stage-three prime row generated by `threeFactor` proves
that the global arithmetic image is nonzero through its stage-three
projection.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalArithmeticState
namespace BlockCokernelGlobalOccurrence

open CanonicalUnitArithmeticFactorizationEulerDependentDiagram
open CanonicalUnitArithmeticFactorizationWholeHistorySolutionCarrier
open CanonicalUnitArithmeticFactorizationWholeHistorySolutionCofinalRigidity
open CanonicalUnitArithmeticFactorizationEulerCrossPrimeRestrictionObstruction
open CanonicalUnitArithmeticFactorizationFullEulerWholePrimeDualBlockEndpointBoundaryCokernelGlobalState
open BlockActionCokernelRead
open BlockCokernelGlobalTower
open CategoryTheory
open CategoryTheory.Limits

noncomputable section

/-- The new read is attached by mapping the existing global symbolic endpoint
occurrence itself. -/
def globalSpecializedIntegralEndpointBoundaryOccurrence :
    RootedAccountedUnfolding
      ((FactorizationPayload × GlobalRelationActionCokernel) ×
        RestrictedArithmeticGlobalCokernel) :=
  globalEndpointBoundaryCokernelOccurrence.map fun source =>
    (source, globalBlockCokernelArithmeticRead.hom source.2)

theorem globalSpecializedIntegralEndpointBoundaryOccurrence_projects :
    globalSpecializedIntegralEndpointBoundaryOccurrence.map Prod.fst =
      globalEndpointBoundaryCokernelOccurrence := by
  unfold globalSpecializedIntegralEndpointBoundaryOccurrence
  rw [RootedAccountedUnfolding.map_map]
  change globalEndpointBoundaryCokernelOccurrence.map id = _
  exact RootedAccountedUnfolding.map_id _

@[simp] theorem globalSpecializedIntegralEndpointBoundaryOccurrence_read :
    globalSpecializedIntegralEndpointBoundaryOccurrence.root.2 =
      globalSpecializedIntegralEndpointBoundaryClass :=
  rfl

/-- `threeFactor` is generated at the actual stage `3¹ = 3`; its
factorization row is therefore a literal stage-three row. -/
def actualStageThreePrimeRow : FactorRow seedOccurrence.root 3 := by
  change FactorRow seedOccurrence.root threeFactor.stage
  exact stageFactorRow threeFactor

theorem actualStageThreePrimeRow_prime :
    (rowPrime actualStageThreePrimeRow : Nat) = 3 := by
  change (rowPrime (stageFactorRow threeFactor) : Nat) = 3
  simpa [PrimeThree] using
    congrArg Subtype.val (stageFactorRow_prime threeFactor)

/-- The stage-three projection sees a nonzero arithmetic endpoint class, so
the global arithmetic image itself is nonzero. -/
theorem globalSpecializedIntegralEndpointBoundaryClass_ne_zero :
    globalSpecializedIntegralEndpointBoundaryClass ≠ 0 := by
  intro vanished
  have projected := congrArg
    (limit.π restrictedArithmeticCokernelDiagram
      (Opposite.op 3)).hom vanished
  rw [globalSpecializedIntegralEndpointBoundaryClass_restriction,
    map_zero] at projected
  exact specializedIntegralEndpointBoundaryClass_ne_zero_at_three
    3 actualStageThreePrimeRow actualStageThreePrimeRow_prime projected

/-- The existing symbolic global endpoint class is itself nonzero, because
its canonical arithmetic image is nonzero. -/
theorem existingGlobalEndpointBoundaryCokernelClass_ne_zero :
    globalEndpointBoundaryCokernelClass ≠ 0 := by
  intro vanished
  have mapped := congrArg globalBlockCokernelArithmeticRead.hom vanished
  rw [map_zero] at mapped
  exact globalSpecializedIntegralEndpointBoundaryClass_ne_zero mapped

theorem globalSpecializedIntegralEndpointBoundaryOccurrence_read_ne_zero :
    globalSpecializedIntegralEndpointBoundaryOccurrence.root.2 ≠ 0 := by
  rw [globalSpecializedIntegralEndpointBoundaryOccurrence_read]
  exact globalSpecializedIntegralEndpointBoundaryClass_ne_zero

end
end BlockCokernelGlobalOccurrence
end CanonicalArithmeticState
end NoIslandNoMagic
