namespace ClozelGeneralizedDual

open Complex MeasureTheory
open SourceGeneratedFunctionalGraphCokernel
open scoped InnerProductSpace

noncomputable section

/-- The actual normalized dilation on the lawful quarter-Mellin test carrier,
at an arbitrary positive scale. -/
def quarterDilationTestAction
    (z : ℂ) (scale : ℝ) (positive : 0 < scale) :
    QuarterMellinL2Test z →ₗ[ℂ] QuarterMellinL2Test z where
  toFun value := ⟨
    positiveMellinQuarterNormalizedDilation scale positive value.1,
    ⟨positiveQuarterNormalizedDilation_mem_quarterL2
        scale positive value.1 value.2.1,
      by
        have raw := (positiveMellinDilation z scale positive
          ⟨value.1, value.2.2⟩).2
        change MellinConvergent
          (positiveMellinExtension
            (positiveMellinQuarterNormalizedDilation
              scale positive value.1)) z
        rw [positiveMellinQuarterNormalizedDilation,
          LinearMap.smul_apply, map_smul]
        exact raw.const_smul
          (positiveMellinQuarterDilationWeight scale)⟩⟩
  map_add' left right := by
    apply Subtype.ext
    exact map_add
      (positiveMellinQuarterNormalizedDilation scale positive)
      left.1 right.1
  map_smul' coefficient value := by
    apply Subtype.ext
    exact map_smul
      (positiveMellinQuarterNormalizedDilation scale positive)
      coefficient value.1

/-- The Hilbert feature of the source dilation is the actual logarithmic
translation. -/
theorem quarterDilationFeature_covariance
    (z : ℂ) (scale : ℝ) (positive : 0 < scale) :
    (positiveMellinQuarterEnergyTranslationIsometry
        (Real.log scale)).toLinearEquiv.toLinearMap.comp
        (quarterMellinL2Feature z) =
      (quarterMellinL2Feature z).comp
        (quarterDilationTestAction z scale positive) := by
  apply LinearMap.ext
  intro value
  let raw : PositiveMellinQuarterL2 := ⟨value.1, value.2.1⟩
  have source := positiveMellinQuarterLpValue_normalizedDilation
    scale positive raw
  change positiveMellinQuarterEnergyTranslation
      (Real.log scale) (positiveMellinQuarterLpValue raw) =
    quarterMellinL2Feature z
      (quarterDilationTestAction z scale positive value)
  calc
    _ = positiveMellinQuarterLpValue
        (positiveMellinQuarterL2NormalizedDilation
          scale positive raw) := source.symm
    _ = _ := by
      exact MemLp.toLp_congr
        (positiveMellinQuarterL2_memLp
          (positiveMellinQuarterL2NormalizedDilation
            scale positive raw))
        ((quarterDilationTestAction z scale positive value).2.1)
        (ae_of_all (volume : Measure ℝ) fun _ => rfl)

theorem quarterDilationWeight_eq_cpow_quarter
    (scale : ℝ) (positive : 0 < scale) :
    positiveMellinQuarterDilationWeight scale =
      (scale : ℂ) ^ (1 / 4 : ℂ) := by
  calc
    positiveMellinQuarterDilationWeight scale =
        ((scale ^ (1 / 4 : ℝ) : ℝ) : ℂ) := by
      unfold positiveMellinQuarterDilationWeight
      rw [Real.rpow_def_of_pos positive]
      congr 3
      ring
    _ = (scale : ℂ) ^ (1 / 4 : ℂ) := by
      convert Complex.ofReal_cpow positive.le (1 / 4 : ℝ) using 1
      norm_num

theorem quarterDilationCharacter_factor
    (z : ℂ) (scale : ℝ) (positive : 0 < scale) :
    positiveMellinQuarterDilationWeight scale *
        (scale : ℂ) ^ (-z) =
      (scale : ℂ) ^ ((1 / 4 : ℂ) - z) := by
  rw [quarterDilationWeight_eq_cpow_quarter scale positive,
    ← Complex.cpow_add _ _ (Complex.ofReal_ne_zero.mpr positive.ne')]
  congr 2

/-- Exact Mellin character law of the arbitrary positive-scale source
dilation. -/
theorem quarterDilationFunctional_eigenlaw
    (z : ℂ) (scale : ℝ) (positive : 0 < scale) :
    (quarterMellinL2Functional z).comp
        (quarterDilationTestAction z scale positive) =
      ((scale : ℂ) ^ ((1 / 4 : ℂ) - z)) •
        quarterMellinL2Functional z := by
  apply LinearMap.ext
  intro value
  let convergent : positiveMellinConvergentSubmodule z :=
    ⟨value.1, value.2.2⟩
  let dilated := positiveMellinDilation z scale positive convergent
  have raw := positiveMellinFunctional_dilation z scale positive convergent
  change positiveMellinFunctional z
      ⟨(quarterDilationTestAction z scale positive value).1,
        (quarterDilationTestAction z scale positive value).2.2⟩ = _
  calc
    _ = positiveMellinFunctional z
        ((positiveMellinQuarterDilationWeight scale) • dilated) := by rfl
    _ = positiveMellinQuarterDilationWeight scale •
        positiveMellinFunctional z dilated := by rw [map_smul]
    _ = positiveMellinQuarterDilationWeight scale •
        ((scale : ℂ) ^ (-z) •
          positiveMellinFunctional z convergent) := by rw [raw]
    _ = (scale : ℂ) ^ ((1 / 4 : ℂ) - z) •
        positiveMellinFunctional z convergent := by
      simp only [smul_eq_mul]
      rw [← mul_assoc, quarterDilationCharacter_factor z scale positive]

/-- A canonical test whose Mellin coordinate is exactly one. -/
def normalizedCoPoissonMuntzQuarterShellTest
    (z : ℂ) (positive : 0 < z.re) : QuarterMellinL2Test z :=
  (quarterMellinL2Functional z
      (coPoissonMuntzQuarterShellTest z positive))⁻¹ •
    coPoissonMuntzQuarterShellTest z positive

theorem quarterMellinL2Functional_shell_ne_zero
    (z : ℂ) (positive : 0 < z.re) :
    quarterMellinL2Functional z
        (coPoissonMuntzQuarterShellTest z positive) ≠ 0 := by
  change positiveMellinFunctional z
      (positiveMellinQuarterNoGoShellElement z positive) ≠ 0
  exact positiveMellinQuarterNoGoShellElement_value_ne_zero z positive

@[simp] theorem quarterMellinL2Functional_normalizedShell
    (z : ℂ) (positive : 0 < z.re) :
    quarterMellinL2Functional z
        (normalizedCoPoissonMuntzQuarterShellTest z positive) = 1 := by
  rw [normalizedCoPoissonMuntzQuarterShellTest, map_smul]
  simp only [smul_eq_mul]
  exact inv_mul_cancel₀
    (quarterMellinL2Functional_shell_ne_zero z positive)

/-- Pair the source-generated Riesz vector with the actual dilation of its
canonical unit-coordinate shell. -/
def coPoissonMuntzRieszDilationAmplitude
    (z : ℂ) (positive : 0 < z.re) (belowHalf : z.re < (1 / 2 : ℝ))
    (zero : riemannZeta (2 * z) = 0)
    (scale : ℝ) (scalePositive : 0 < scale) : ℂ :=
  ⟪coPoissonMuntzRieszVector z positive belowHalf zero,
    coPoissonMuntzGraphSourceMap z positive belowHalf
      (quarterDilationTestAction z scale scalePositive
        (normalizedCoPoissonMuntzQuarterShellTest z positive))⟫_ℂ

/-- The Riesz pairing is exactly the half-density dilation character. -/
theorem coPoissonMuntzRieszDilationAmplitude_eq_character
    (z : ℂ) (positive : 0 < z.re) (belowHalf : z.re < (1 / 2 : ℝ))
    (zero : riemannZeta (2 * z) = 0)
    (scale : ℝ) (scalePositive : 0 < scale) :
    coPoissonMuntzRieszDilationAmplitude z positive belowHalf zero
        scale scalePositive =
      (scale : ℂ) ^ ((1 / 4 : ℂ) - z) := by
  rw [coPoissonMuntzRieszDilationAmplitude,
    coPoissonMuntzRieszVector_source_readback]
  have eigen := LinearMap.congr_fun
    (quarterDilationFunctional_eigenlaw z scale scalePositive)
    (normalizedCoPoissonMuntzQuarterShellTest z positive)
  simpa using eigen

end

