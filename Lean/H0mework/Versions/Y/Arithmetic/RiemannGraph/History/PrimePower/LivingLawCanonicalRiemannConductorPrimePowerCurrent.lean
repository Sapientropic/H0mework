open SourceGeneratedIntegralCharacterGroupRing

noncomputable section

/-- One actual positive prime-power receipt.  Positivity is data, so exponent
zero cannot enter later maps as a fake conductor row. -/
abbrev ConductorPrimePowerIndex :=
  Σ _prime : Nat.Primes, {exponent : Nat // 0 < exponent}

/-- Finite accountable inventories of actual prime-power receipts. -/
abbrev ConductorPrimePowerCurrent := ConductorPrimePowerIndex →₀ ℤ

/-- The independent conductor clock at which this receipt is read. -/
def conductorIndex (index : ConductorPrimePowerIndex) : Nat :=
  primePowerConductorObservationIndex index.1 index.2.1

/-- The q-rich runtime occurrence generated by this receipt. -/
def occurrenceAt
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (index : ConductorPrimePowerIndex) :=
  Consumer.primePowerRuntimeOccurrence observation nontrivial
    index.1 index.2.1

/-- The complete installed face at the receipt's actual occurrence. -/
def faceAt
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (index : ConductorPrimePowerIndex) :=
  Consumer.primePowerRuntimeFace observation nontrivial
    index.1 index.2.1

/-- The existing source-boundary state at `p^k`. -/
def boundaryValue
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (index : ConductorPrimePowerIndex) :
    PairedOmegaJointRelationCarrier :=
  primePowerBoundaryState observation nontrivial index.1 index.2.1

/-- The literal integral boundary `δ₁ - δ_(p^k)`. -/
def integralBoundaryValue
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (index : ConductorPrimePowerIndex) : IntegralScaleCarrier :=
  primePowerBoundaryIntegralRead observation nontrivial
    index.1 index.2.1

/-- Function-valued conductor increment at the independently generated
conductor clock. -/
def conductorTraceValue
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (index : ConductorPrimePowerIndex) : ConductorHistoryCarrier :=
  conductorHistoryGeneratorValue
    (faceAt observation nontrivial index)
    (conductorIndex index, .increment)

/-- Every index carries the existing arithmetic factorization receipt and
the exact conductor-clock readback; no table is submitted by a caller. -/
theorem conductorTraceValue_readback
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (index : ConductorPrimePowerIndex)
    (test : SchwartzMap ℝ ℂ) (scale : ℝ) :
    type_of% (primePowerRuntime_actualReceipt
        index.1 index.2.1 index.2.2) ∧
      conductorTraceValue observation nontrivial index test scale =
        (Real.log ((index.1 : Nat) : ℝ) : ℂ) *
          ClozelGeneralizedDual.coPoissonMuntzEvenSource test
            ((primePowerRuntimeScale index.1 index.2.1 : ℝ) * scale) := by
  refine ⟨primePowerRuntime_actualReceipt
    index.1 index.2.1 index.2.2, ?_⟩
  exact primePowerConductorHistoryIncrement_readback
    observation nontrivial test scale index.1 index.2.1 index.2.2

/-- Linearized full joint boundary family. -/
def boundaryMap
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    ConductorPrimePowerCurrent →ₗ[ℤ] PairedOmegaJointRelationCarrier :=
  (Finsupp.liftAddHom fun index =>
    AddMonoidHom.flip (smulAddHom ℤ PairedOmegaJointRelationCarrier)
      (boundaryValue observation nontrivial index)).toIntLinearMap

/-- Linearized integral sibling of the same receipt family. -/
def integralBoundaryMap
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    ConductorPrimePowerCurrent →ₗ[ℤ] IntegralScaleCarrier :=
  (Finsupp.liftAddHom fun index =>
    AddMonoidHom.flip (smulAddHom ℤ IntegralScaleCarrier)
      (integralBoundaryValue observation nontrivial index)).toIntLinearMap

/-- Provenance-sensitive trace carrier: the receipt index is retained beside
its complete function-valued increment. -/
abbrev ConductorPrimePowerTrace :=
  ConductorPrimePowerIndex →₀ ConductorHistoryCarrier

def traceMap
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    ConductorPrimePowerCurrent →ₗ[ℤ] ConductorPrimePowerTrace :=
  (Finsupp.liftAddHom fun index =>
    AddMonoidHom.flip (smulAddHom ℤ ConductorPrimePowerTrace)
      (Finsupp.single index
        (conductorTraceValue observation nontrivial index))).toIntLinearMap

@[simp] theorem boundaryMap_single
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (index : ConductorPrimePowerIndex) (coefficient : ℤ) :
    boundaryMap observation nontrivial
        (Finsupp.single index coefficient) =
      coefficient • boundaryValue observation nontrivial index := by
  simp [boundaryMap]

@[simp] theorem integralBoundaryMap_single
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (index : ConductorPrimePowerIndex) (coefficient : ℤ) :
    integralBoundaryMap observation nontrivial
        (Finsupp.single index coefficient) =
      coefficient • integralBoundaryValue observation nontrivial index := by
  simp [integralBoundaryMap]

@[simp] theorem traceMap_single
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (index : ConductorPrimePowerIndex) (coefficient : ℤ) :
    traceMap observation nontrivial
        (Finsupp.single index coefficient) =
      coefficient • Finsupp.single index
        (conductorTraceValue observation nontrivial index) := by
  simp [traceMap]

/-- Joint and integral reads remain a literal dependent-face square for the
whole receipt inventory. -/
theorem boundary_integral_square
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    runtimeJointIntegralFace.comp (boundaryMap observation nontrivial) =
      integralBoundaryMap observation nontrivial := by
  apply LinearMap.ext
  intro current
  induction current using Finsupp.induction_linear with
  | zero => simp
  | add left right leftHypothesis rightHypothesis =>
      simp only [map_add, leftHypothesis, rightHypothesis]
  | single index coefficient =>
      change runtimeJointIntegralFace
          (boundaryMap observation nontrivial
            (Finsupp.single index coefficient)) =
        integralBoundaryMap observation nontrivial
          (Finsupp.single index coefficient)
      rw [boundaryMap_single, integralBoundaryMap_single, map_smul]
      apply congrArg (fun value : IntegralScaleCarrier => coefficient • value)
      unfold boundaryValue integralBoundaryValue
      rfl

/-- Forgetting the exponent is a subordinate all-prime compression face. -/
def forgetExponent : ConductorPrimePowerCurrent →ₗ[ℤ] AllPrimeCurrent :=
  (Finsupp.liftAddHom fun index =>
    AddMonoidHom.flip (smulAddHom ℤ AllPrimeCurrent)
      (Finsupp.single index.1 1)).toIntLinearMap

@[simp] theorem forgetExponent_single
    (index : ConductorPrimePowerIndex) (coefficient : ℤ) :
    forgetExponent (Finsupp.single index coefficient) =
      coefficient • Finsupp.single index.1 1 := by
  simp [forgetExponent]

def exponentOne (prime : Nat.Primes) : ConductorPrimePowerIndex :=
  ⟨prime, ⟨1, Nat.zero_lt_one⟩⟩

def exponentTwo (prime : Nat.Primes) : ConductorPrimePowerIndex :=
  ⟨prime, ⟨2, by omega⟩⟩

/-- The first explicit coordinate lost by the exponent-forgetting face. -/
def exponentCompressionResidual (prime : Nat.Primes) :
    ConductorPrimePowerCurrent :=
  Finsupp.single (exponentOne prime) 1 -
    Finsupp.single (exponentTwo prime) 1

theorem exponentOne_ne_exponentTwo (prime : Nat.Primes) :
    exponentOne prime ≠ exponentTwo prime := by
  intro equality
  have exponentEquality := congrArg (fun index => index.2.1) equality
  change (1 : Nat) = 2 at exponentEquality
  omega

theorem exponentCompressionResidual_ne_zero (prime : Nat.Primes) :
    exponentCompressionResidual prime ≠ 0 := by
  intro residualZero
  have coordinate := congrArg
    (fun current : ConductorPrimePowerCurrent =>
      current (exponentOne prime)) residualZero
  simp [exponentCompressionResidual, exponentOne_ne_exponentTwo] at coordinate

theorem forgetExponent_exponentCompressionResidual (prime : Nat.Primes) :
    forgetExponent (exponentCompressionResidual prime) = 0 := by
  rw [exponentCompressionResidual, map_sub,
    forgetExponent_single, forgetExponent_single]
  simp [exponentOne, exponentTwo]

theorem primePowerUnit_one_ne_two (prime : Nat.Primes) :
    primePowerUnit prime 1 ≠ primePowerUnit prime 2 := by
  intro equality
  have valueEquality := congrArg scaleValue equality
  rw [primePowerUnit_value, primePowerUnit_value] at valueEquality
  simp only [ClozelGeneralizedDual.thetaDistributionPrimePower,
    Nat.cast_pow] at valueEquality
  have primeTwo : (2 : ℝ) ≤ (prime : Nat) := by
    exact_mod_cast prime.property.two_le
  norm_num at valueEquality
  nlinarith

theorem primePowerUnit_one_ne_identity (prime : Nat.Primes) :
    primePowerUnit prime 1 ≠ 1 := by
  intro equality
  have valueEquality := congrArg scaleValue equality
  rw [primePowerUnit_value] at valueEquality
  simp only [ClozelGeneralizedDual.thetaDistributionPrimePower,
    pow_one] at valueEquality
  change ((prime : Nat) : ℝ) = 1 at valueEquality
  have natEquality : (prime : Nat) = 1 := by
    exact_mod_cast valueEquality
  have primeTwo := prime.property.two_le
  omega

/-- The exponent coordinate lost by `forgetExponent` is still visible in
the actual integral source boundary. -/
theorem integralBoundaryMap_exponentCompressionResidual_ne_zero
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (prime : Nat.Primes) :
    integralBoundaryMap observation nontrivial
        (exponentCompressionResidual prime) ≠ 0 := by
  rw [exponentCompressionResidual, map_sub,
    integralBoundaryMap_single, integralBoundaryMap_single]
  simp only [one_smul]
  rw [show integralBoundaryValue observation nontrivial
        (exponentOne prime) =
      delta 1 - delta (primePowerUnit prime 1) by
        exact primePowerBoundaryIntegralRead_eq
          observation nontrivial prime 1 Nat.zero_lt_one,
    show integralBoundaryValue observation nontrivial
        (exponentTwo prime) =
      delta 1 - delta (primePowerUnit prime 2) by
        exact primePowerBoundaryIntegralRead_eq
          observation nontrivial prime 2 (by omega)]
  intro boundaryZero
  have coordinate := congrArg
    (fun value : IntegralScaleCarrier =>
      value.coeff (primePowerUnit prime 1)) boundaryZero
  have powerNe : primePowerUnit prime 2 ≠ primePowerUnit prime 1 :=
    Ne.symm (primePowerUnit_one_ne_two prime)
  simp [delta, powerNe] at coordinate

/-- Source-generated face.  The private constructor prevents replacement of
the actual receipt family by caller maps. -/
structure GeneratedConductorPrimePowerFaceAt
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) where
  private mk ::
  boundary : ConductorPrimePowerCurrent →ₗ[ℤ]
    PairedOmegaJointRelationCarrier
  integral : ConductorPrimePowerCurrent →ₗ[ℤ] IntegralScaleCarrier
  trace : ConductorPrimePowerCurrent →ₗ[ℤ]
    ConductorPrimePowerTrace
  allPrimeCompression : ConductorPrimePowerCurrent →ₗ[ℤ]
    AllPrimeCurrent
  integralSquare : runtimeJointIntegralFace.comp boundary = integral
  receipt : ∀ index test scale,
    type_of% (primePowerRuntime_actualReceipt
        index.1 index.2.1 index.2.2) ∧
      conductorTraceValue observation nontrivial index test scale =
        (Real.log ((index.1 : Nat) : ℝ) : ℂ) *
          ClozelGeneralizedDual.coPoissonMuntzEvenSource test
            ((primePowerRuntimeScale index.1 index.2.1 : ℝ) * scale)
  compressionResidual : ∀ prime,
    exponentCompressionResidual prime ≠ 0 ∧
      allPrimeCompression (exponentCompressionResidual prime) = 0 ∧
      integral (exponentCompressionResidual prime) ≠ 0

def generatedConductorPrimePowerFace
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    GeneratedConductorPrimePowerFaceAt observation nontrivial where
  boundary := boundaryMap observation nontrivial
  integral := integralBoundaryMap observation nontrivial
  trace := traceMap observation nontrivial
  allPrimeCompression := forgetExponent
  integralSquare := boundary_integral_square observation nontrivial
  receipt := conductorTraceValue_readback observation nontrivial
  compressionResidual := fun prime =>
    ⟨exponentCompressionResidual_ne_zero prime,
      forgetExponent_exponentCompressionResidual prime,
      integralBoundaryMap_exponentCompressionResidual_ne_zero
        observation nontrivial prime⟩

end
