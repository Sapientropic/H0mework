open ActionCofiber.RawEffect.AllPrimeCofinal
open Character.GlobalCoPoissonCurrent
open ClozelGeneralizedDual.CenteredGram.IntegralGraphJointAction
open ClozelGeneralizedDual.ThetaJRoleRepresentation
