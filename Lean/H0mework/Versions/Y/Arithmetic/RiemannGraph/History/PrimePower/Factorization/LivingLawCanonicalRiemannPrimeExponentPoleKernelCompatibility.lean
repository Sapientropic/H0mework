  rw [reversalAllPlacePoleOrbit_fst,
    reversalModifiedWeakFEPoleTraceTest_functional_one,
    reversalSourceModifiedUnitQuarterTest_functional_one]

theorem selectedPrimeExponentPolePositiveEnergy_eq_zero_imp_mellin_eq_zero
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (event : PrimeExponentFactorizationCarrier)
    (energyZero : selectedPrimeExponentPolePositiveEnergyMap
      observation nontrivial event = 0) :
    selectedPrimeExponentPoleMellinMap observation nontrivial event = 0 :=
  primeExponentPolePositiveEnergy_eq_zero_imp_mellin_eq_zero
    (selectedCoPoissonMuntzParameter observation)
    (selectedCoPoissonMuntzParameter_re_pos observation nontrivial)
    (selectedCoPoissonMuntzParameter_re_lt_half observation nontrivial)
    (selectedAllPlacePoleOrbitJointValue observation nontrivial)
    (selectedSourceModifiedUnitQuarterTest observation nontrivial)
    (selectedAllPlacePole_positiveEnergy_readback observation nontrivial)
    (selectedPole_baseMellin_eq_source observation nontrivial) event energyZero

theorem reversalPrimeExponentPolePositiveEnergy_eq_zero_imp_mellin_eq_zero
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (event : PrimeExponentFactorizationCarrier)
    (energyZero : reversalPrimeExponentPolePositiveEnergyMap
      observation nontrivial event = 0) :
    reversalPrimeExponentPoleMellinMap observation nontrivial event = 0 :=
  primeExponentPolePositiveEnergy_eq_zero_imp_mellin_eq_zero
    (reversalCoPoissonMuntzParameter observation)
    (reversalCoPoissonMuntzParameter_re_pos observation nontrivial)
    (reversalCoPoissonMuntzParameter_re_lt_half observation nontrivial)
    (reversalAllPlacePoleOrbitJointValue observation nontrivial)
    (reversalSourceModifiedUnitQuarterTest observation nontrivial)
    (reversalAllPlacePole_positiveEnergy_readback observation nontrivial)
    (reversalPole_baseMellin_eq_source observation nontrivial) event energyZero

/-- Selected complexified `kills_radical` input for `canonicalFactor`. -/
theorem selectedPrimeExponentPoleComplexEnergy_ker_le_mellin_ker
    (observation : GeneratedRiemannZeroObservation)
