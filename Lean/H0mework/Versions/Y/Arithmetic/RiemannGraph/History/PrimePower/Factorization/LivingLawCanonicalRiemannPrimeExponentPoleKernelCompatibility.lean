noncomputable section

/-- Coefficient form of the actual quarter-test orbit generated by one
factorization source test. -/
def primeExponentPoleQuarterTestCoefficientMap
    (z : ℂ) (seed : QuarterMellinL2Test z) :
    (PrimeExponentLattice →₀ ℤ) →ₗ[ℤ] QuarterMellinL2Test z :=
  (Finsupp.liftAddHom fun exponent : PrimeExponentLattice =>
    AddMonoidHom.flip
      (smulAddHom ℤ (QuarterMellinL2Test z))
      (quarterDilationTestAction z
        (scaleSquare (primeExponentScale exponent))
        (scaleSquare_pos (primeExponentScale exponent)) seed)
    ).toIntLinearMap

/-- Actual quarter-test factorization on the same multiplicative carrier as
the complete pole orbit. -/
def primeExponentPoleQuarterTestMap
    (z : ℂ) (seed : QuarterMellinL2Test z) :
    PrimeExponentFactorizationCarrier →ₗ[ℤ] QuarterMellinL2Test z :=
  (primeExponentPoleQuarterTestCoefficientMap z seed).comp
    (AddMonoidAlgebra.coeffLinearEquiv ℤ).toLinearMap

@[simp] theorem primeExponentPoleQuarterTestMap_single
    (z : ℂ) (seed : QuarterMellinL2Test z)
    (exponent : PrimeExponentLattice) (coefficient : ℤ) :
    primeExponentPoleQuarterTestMap z seed
        (AddMonoidAlgebra.single exponent coefficient) =
      coefficient • quarterDilationTestAction z
        (scaleSquare (primeExponentScale exponent))
        (scaleSquare_pos (primeExponentScale exponent)) seed := by
  simp [primeExponentPoleQuarterTestMap,
    primeExponentPoleQuarterTestCoefficientMap]

/-- Complete-orbit energy factors through the actual quarter-test orbit when
their base energies agree. -/
theorem primeExponentPolePositiveEnergy_quarterTest_square
    (z : ℂ) (positiveZ : 0 < z.re) (belowHalf : z.re < (1 / 2 : ℝ))
    (pole : AllPlaceOriginOrbitJointCarrier z)
    (seed : QuarterMellinL2Test z)
    (baseEnergy : allPlaceOrbitPositiveEnergyMap z pole =
      quarterMellinL2Feature z seed) :
    primeExponentPolePositiveEnergyMap z pole =
      ((quarterMellinL2Feature z).restrictScalars ℤ).comp
        (primeExponentPoleQuarterTestMap z seed) := by
  apply LinearMap.ext
  intro event
  induction event using AddMonoidAlgebra.induction_on with
  | of exponent =>
      rw [AddMonoidAlgebra.of_apply]
      change allPlaceOrbitPositiveEnergyMap z
          (primeExponentPoleOrbitMap z pole
            (AddMonoidAlgebra.single exponent 1)) =
        quarterMellinL2Feature z
          (primeExponentPoleQuarterTestMap z seed
            (AddMonoidAlgebra.single exponent 1))
      rw [primeExponentPoleOrbitMap_single,
        primeExponentPoleQuarterTestMap_single, one_smul]
      simp only [one_smul]
      rw [allPlaceOrbitPositiveEnergyMap_dilation
        z positiveZ belowHalf
        (scaleSquare (primeExponentScale exponent))
        (scaleSquare_pos (primeExponentScale exponent)), baseEnergy]
      have covariance := LinearMap.congr_fun
        (quarterDilationFeature_covariance z
          (scaleSquare (primeExponentScale exponent))
          (scaleSquare_pos (primeExponentScale exponent))) seed
      change positiveMellinQuarterEnergyTranslationIsometry
          (Real.log (scaleSquare (primeExponentScale exponent)))
          (quarterMellinL2Feature z seed) =
        quarterMellinL2Feature z
          (quarterDilationTestAction z
            (scaleSquare (primeExponentScale exponent))
            (scaleSquare_pos (primeExponentScale exponent)) seed)
        at covariance
      exact covariance
  | add left right leftHypothesis rightHypothesis =>
      simpa only [map_add] using
        congrArg₂ (fun a b : PositiveMellinQuarterEnergy => a + b)
          leftHypothesis rightHypothesis
  | smul coefficient value inductionHypothesis =>
      simpa only [map_smul] using congrArg
        (fun target : PositiveMellinQuarterEnergy => coefficient • target)
        inductionHypothesis

/-- The Mellin sibling factors through that same quarter-test orbit when the
base reads agree. -/
theorem primeExponentPoleMellin_quarterTest_square
    (z : ℂ) (pole : AllPlaceOriginOrbitJointCarrier z)
    (seed : QuarterMellinL2Test z)
    (baseMellin : allPlaceOrbitMellinFunctional z pole =
      quarterMellinL2Functional z seed) :
    primeExponentPoleMellinMap z pole =
      ((quarterMellinL2Functional z).restrictScalars ℤ).comp
        (primeExponentPoleQuarterTestMap z seed) := by
  apply LinearMap.ext
  intro event
  induction event using AddMonoidAlgebra.induction_on with
  | of exponent =>
      rw [AddMonoidAlgebra.of_apply]
      change allPlaceOrbitMellinFunctional z
          (primeExponentPoleOrbitMap z pole
            (AddMonoidAlgebra.single exponent 1)) =
        quarterMellinL2Functional z
          (primeExponentPoleQuarterTestMap z seed
            (AddMonoidAlgebra.single exponent 1))
      rw [primeExponentPoleOrbitMap_single,
        primeExponentPoleQuarterTestMap_single, one_smul]
      simp only [one_smul]
      have poleEigen := LinearMap.congr_fun
        (quarterDilationFunctional_eigenlaw z
          (scaleSquare (primeExponentScale exponent))
          (scaleSquare_pos (primeExponentScale exponent))) pole.1
      have seedEigen := LinearMap.congr_fun
        (quarterDilationFunctional_eigenlaw z
          (scaleSquare (primeExponentScale exponent))
          (scaleSquare_pos (primeExponentScale exponent))) seed
      change quarterMellinL2Functional z
          (quarterDilationTestAction z
            (scaleSquare (primeExponentScale exponent))
            (scaleSquare_pos (primeExponentScale exponent)) pole.1) =
        quarterDilationCharacter z
          (scaleSquare (primeExponentScale exponent)) •
            quarterMellinL2Functional z pole.1 at poleEigen
      change quarterMellinL2Functional z
          (quarterDilationTestAction z
            (scaleSquare (primeExponentScale exponent))
            (scaleSquare_pos (primeExponentScale exponent)) seed) =
        quarterDilationCharacter z
          (scaleSquare (primeExponentScale exponent)) •
            quarterMellinL2Functional z seed at seedEigen
      change quarterMellinL2Functional z pole.1 =
        quarterMellinL2Functional z seed at baseMellin
      change quarterMellinL2Functional z
          (quarterDilationTestAction z
            (scaleSquare (primeExponentScale exponent))
            (scaleSquare_pos (primeExponentScale exponent)) pole.1) =
        quarterMellinL2Functional z
          (quarterDilationTestAction z
            (scaleSquare (primeExponentScale exponent))
            (scaleSquare_pos (primeExponentScale exponent)) seed)
      rw [poleEigen, seedEigen, baseMellin]
  | add left right leftHypothesis rightHypothesis =>
      simpa only [map_add] using
        congrArg₂ (fun a b : ℂ => a + b)
          leftHypothesis rightHypothesis
  | smul coefficient value inductionHypothesis =>
      simpa only [map_smul] using congrArg
        (fun target : ℂ => coefficient • target) inductionHypothesis

theorem primeExponentPolePositiveEnergy_eq_zero_imp_mellin_eq_zero
    (z : ℂ) (positiveZ : 0 < z.re) (belowHalf : z.re < (1 / 2 : ℝ))
    (pole : AllPlaceOriginOrbitJointCarrier z)
    (seed : QuarterMellinL2Test z)
    (baseEnergy : allPlaceOrbitPositiveEnergyMap z pole =
      quarterMellinL2Feature z seed)
    (baseMellin : allPlaceOrbitMellinFunctional z pole =
      quarterMellinL2Functional z seed)
    (event : PrimeExponentFactorizationCarrier)
    (energyZero : primeExponentPolePositiveEnergyMap z pole event = 0) :
    primeExponentPoleMellinMap z pole event = 0 := by
  have energySquare := LinearMap.congr_fun
    (primeExponentPolePositiveEnergy_quarterTest_square
      z positiveZ belowHalf pole seed baseEnergy) event
  have mellinSquare := LinearMap.congr_fun
    (primeExponentPoleMellin_quarterTest_square
      z pole seed baseMellin) event
  change primeExponentPolePositiveEnergyMap z pole event =
    quarterMellinL2Feature z
      (primeExponentPoleQuarterTestMap z seed event) at energySquare
  change primeExponentPoleMellinMap z pole event =
    quarterMellinL2Functional z
      (primeExponentPoleQuarterTestMap z seed event) at mellinSquare
  rw [energySquare] at energyZero
  rw [mellinSquare]
  exact quarterMellinL2Feature_eq_zero_imp_functional_eq_zero z
    (primeExponentPoleQuarterTestMap z seed event) energyZero

section Complexification

variable {IntegralSource : Type*} [AddCommGroup IntegralSource]
variable {Middle : Type*} [AddCommGroup Middle] [Module ℂ Middle]
variable {Target : Type*} [AddCommGroup Target] [Module ℂ Target]

/-- Complex scalar extension preserves any actual integral factorization
through a complex-linear middle map. -/
theorem primeExponentComplexifiedFactorization
    (source : IntegralSource →ₗ[ℤ] Middle)
    (target : Middle →ₗ[ℂ] Target)
    (composite : IntegralSource →ₗ[ℤ] Target)
    (square : composite = (target.restrictScalars ℤ).comp source) :
    complexifiedLinearMap composite =
      target.comp (complexifiedLinearMap source) := by
  apply LinearMap.ext
  intro value
  induction value using TensorProduct.induction_on with
  | zero => simp
  | add left right leftHypothesis rightHypothesis =>
      simpa only [map_add] using congrArg₂ (fun a b : Target => a + b)
        leftHypothesis rightHypothesis
  | tmul coefficient event =>
      rw [complexifiedLinearMap_tmul, LinearMap.comp_apply,
        complexifiedLinearMap_tmul, map_smul]
      have point := LinearMap.congr_fun square event
      rw [LinearMap.comp_apply] at point
      exact congrArg (fun result : Target => coefficient • result) point

end Complexification

/-- Complexified kernel inclusion generated from the same test
factorization. -/
theorem primeExponentPoleComplexEnergy_ker_le_mellin_ker
    (z : ℂ) (positiveZ : 0 < z.re) (belowHalf : z.re < (1 / 2 : ℝ))
    (pole : AllPlaceOriginOrbitJointCarrier z)
    (seed : QuarterMellinL2Test z)
    (baseEnergy : allPlaceOrbitPositiveEnergyMap z pole =
      quarterMellinL2Feature z seed)
    (baseMellin : allPlaceOrbitMellinFunctional z pole =
      quarterMellinL2Functional z seed) :
    LinearMap.ker (complexifiedFeature
      (primeExponentPolePositiveEnergyMap z pole)) ≤
    LinearMap.ker (complexifiedLinearMap
      (primeExponentPoleMellinMap z pole)) := by
  have energySquare := primeExponentComplexifiedFactorization
    (primeExponentPoleQuarterTestMap z seed) (quarterMellinL2Feature z)
    (primeExponentPolePositiveEnergyMap z pole)
    (primeExponentPolePositiveEnergy_quarterTest_square
      z positiveZ belowHalf pole seed baseEnergy)
  have mellinSquare := primeExponentComplexifiedFactorization
    (primeExponentPoleQuarterTestMap z seed) (quarterMellinL2Functional z)
    (primeExponentPoleMellinMap z pole)
    (primeExponentPoleMellin_quarterTest_square z pole seed baseMellin)
  intro source source_mem
  rw [LinearMap.mem_ker] at source_mem ⊢
  change complexifiedLinearMap
      (primeExponentPolePositiveEnergyMap z pole) source = 0 at source_mem
  rw [energySquare, LinearMap.comp_apply] at source_mem
  rw [mellinSquare, LinearMap.comp_apply]
  exact quarterMellinL2Feature_eq_zero_imp_functional_eq_zero z
    (complexifiedLinearMap
      (primeExponentPoleQuarterTestMap z seed) source) source_mem

private theorem selectedPole_baseMellin_eq_source
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    allPlaceOrbitMellinFunctional
        (selectedCoPoissonMuntzParameter observation)
        (selectedAllPlacePoleOrbitJointValue observation nontrivial) =
      quarterMellinL2Functional
        (selectedCoPoissonMuntzParameter observation)
        (selectedSourceModifiedUnitQuarterTest observation nontrivial) := by
  change quarterMellinL2Functional
      (selectedCoPoissonMuntzParameter observation)
      (selectedAllPlacePoleOrbitJointValue observation nontrivial).1 = _
  rw [selectedAllPlacePoleOrbit_fst,
    selectedModifiedWeakFEPoleTraceTest_functional_one,
    selectedSourceModifiedUnitQuarterTest_functional_one]

private theorem reversalPole_baseMellin_eq_source
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    allPlaceOrbitMellinFunctional
        (reversalCoPoissonMuntzParameter observation)
