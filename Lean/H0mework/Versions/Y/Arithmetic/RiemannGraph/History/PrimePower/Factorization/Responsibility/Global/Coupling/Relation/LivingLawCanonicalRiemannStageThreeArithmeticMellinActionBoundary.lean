noncomputable section

def stageThreeConductorIndex : ConductorPrimePowerIndex :=
  ⟨rowPrime actualStageThreePrimeRow, ⟨1, by omega⟩⟩

theorem stageThreePrimeExponent_toAdd :
    Multiplicative.toAdd stageThreePrimeExponent =
      primePowerExponentVector stageThreeConductorIndex := by
  rfl

def stageThreeFactorizationBase : PrimeExponentFactorizationCarrier :=
  AddMonoidAlgebra.single 0 1

theorem factorizationLeftTranslation_stageThree_base :
    factorizationLeftTranslation stageThreePrimeExponent
        stageThreeFactorizationBase =
      AddMonoidAlgebra.single
        (primePowerExponentVector stageThreeConductorIndex) 1 := by
  apply factorizationGroupEquiv.injective
  rw [factorizationGroupEquiv_leftTranslation]
  rw [show factorizationGroupEquiv stageThreeFactorizationBase =
      delta (1 : PrimeExponentGroup) by
    simp [stageThreeFactorizationBase, factorizationGroupEquiv, delta]]
  rw [leftTranslation_delta, mul_one]
  rw [show factorizationGroupEquiv
      (AddMonoidAlgebra.single
        (primePowerExponentVector stageThreeConductorIndex) 1) =
      delta (Multiplicative.ofAdd
        (primePowerExponentVector stageThreeConductorIndex)) by
    simp [factorizationGroupEquiv, delta]]
  rfl

def stageThreeFactorizationActionBoundary :
    PrimeExponentFactorizationCarrier :=
  stageThreeFactorizationBase -
    factorizationLeftTranslation stageThreePrimeExponent
      stageThreeFactorizationBase

theorem stageThreeFactorizationActionBoundary_eq_receipt :
    stageThreeFactorizationActionBoundary =
      factorizationBoundaryValue stageThreeConductorIndex := by
  change stageThreeFactorizationBase -
      factorizationLeftTranslation stageThreePrimeExponent
        stageThreeFactorizationBase =
    AddMonoidAlgebra.single 0 1 -
      AddMonoidAlgebra.single
        (primePowerExponentVector stageThreeConductorIndex) 1
  rw [factorizationLeftTranslation_stageThree_base]
  rfl

theorem stageThreeJointMeasurement_actionBoundary
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    arithmeticMellinJointMeasurement observation nontrivial
        stageThreeFactorizationActionBoundary =
      (0, pairedPrimeExponentPoleBoundaryMellin
        observation nontrivial stageThreeConductorIndex) := by
  apply Prod.ext
  · change stageThreeArithmeticMeasurement
        stageThreeFactorizationActionBoundary = 0
    rw [stageThreeFactorizationActionBoundary, map_sub,
      stageThreeArithmeticMeasurement_left_covariance, sub_self]
  · change pairedPrimeExponentMellinMeasurement observation nontrivial
        stageThreeFactorizationActionBoundary =
      pairedPrimeExponentPoleBoundaryMellin
        observation nontrivial stageThreeConductorIndex
    rw [stageThreeFactorizationActionBoundary_eq_receipt]
    rfl

theorem stageThreeJointMeasurement_actionBoundary_eq_incidence
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    arithmeticMellinJointMeasurement observation nontrivial
        stageThreeFactorizationActionBoundary =
      (0, pairedOmegaMeasurementResidual observation nontrivial
        (primePowerUnit stageThreeConductorIndex.1
          stageThreeConductorIndex.2.1)) := by
  rw [stageThreeJointMeasurement_actionBoundary,
    pairedPrimeExponentPoleBoundaryMellin_eq_incidence]

def stageThreeRuntimeStage : Nat :=
  AllPlace.WeilQuadratic.PrimePower.Runtime.primePowerRuntimeStage
    stageThreeConductorIndex.1 stageThreeConductorIndex.2.1

/-- The factorization boundary is not merely numerically aligned with the
installed effect.  Its faithful integral realization is the integral face of
the existing runtime source-boundary state at the same generated stage. -/
theorem stageThreeActionBoundary_integralRootRead
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    primeExponentIntegralRealization stageThreeFactorizationActionBoundary =
      runtimeJointIntegralFace
        (runtimeJointRelationGeneratorValue observation nontrivial
          (stageThreeRuntimeStage, .sourceBoundary)) := by
  rw [stageThreeFactorizationActionBoundary_eq_receipt,
    primeExponentIntegralRealization_boundaryValue]
  change primePowerBoundaryIntegralRead observation nontrivial
      stageThreeConductorIndex.1 stageThreeConductorIndex.2.1 = _
  rw [primePowerBoundaryIntegralRead_eq observation nontrivial
    stageThreeConductorIndex.1 stageThreeConductorIndex.2.1
      stageThreeConductorIndex.2.2]
  rw [← AllPlace.WeilQuadratic.PrimePower.Runtime.primePowerRuntimeStage_scaleUnit
    stageThreeConductorIndex.1 stageThreeConductorIndex.2.1
      stageThreeConductorIndex.2.2]
  change delta 1 - delta (stageSqrtScaleUnit stageThreeRuntimeStage) =
    (runtimeJointInputAt observation nontrivial stageThreeRuntimeStage).integralFace
      ((runtimeJointInputAt observation nontrivial stageThreeRuntimeStage).sourceBoundary
        (delta 1))
  rw [Input.sourceBoundary_integralFace]
  change delta 1 - delta (stageSqrtScaleUnit stageThreeRuntimeStage) =
    delta 1 - leftTranslation (stageSqrtScaleUnit stageThreeRuntimeStage) (delta 1)
  rw [leftTranslation_delta, mul_one]

/-- The second coordinate of the common action boundary is literally the
measurement face of that same runtime source-boundary state. -/
theorem stageThreeActionBoundary_measurementRootRead
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    arithmeticMellinJointMeasurement observation nontrivial
        stageThreeFactorizationActionBoundary =
      (0, runtimeJointMeasurementFace
        (runtimeJointRelationGeneratorValue observation nontrivial
          (stageThreeRuntimeStage, .sourceBoundary))) := by
  rw [stageThreeJointMeasurement_actionBoundary]
  apply Prod.ext
  · rfl
  · change pairedPrimeExponentPoleBoundaryMellin
        observation nontrivial stageThreeConductorIndex = _
    rw [pairedPrimeExponentPoleBoundaryMellin_eq_installedRetained]
    exact (runtimeJointSourceBoundary_measurement_eq_installedRetained
      observation nontrivial stageThreeRuntimeStage).symm

theorem stageThreeJointMeasurement_rootEffect_write
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    (arithmeticMellinJointMeasurement observation nontrivial
        stageThreeFactorizationActionBoundary).1 = 0 ∧
      (arithmeticMellinJointMeasurement observation nontrivial
          stageThreeFactorizationActionBoundary).2 +
        (installedRuntimeEffectValueAt observation nontrivial
          stageThreeRuntimeStage).centeredTrace =
        (installedRuntimeEffectValueAt observation nontrivial
          stageThreeRuntimeStage).phase := by
  constructor
  · rw [stageThreeJointMeasurement_actionBoundary]
  · rw [stageThreeJointMeasurement_actionBoundary]
    change pairedPrimeExponentPoleBoundaryMellin
        observation nontrivial stageThreeConductorIndex +
        (installedRuntimeEffectValueAt observation nontrivial
          stageThreeRuntimeStage).centeredTrace =
      (installedRuntimeEffectValueAt observation nontrivial
        stageThreeRuntimeStage).phase
    rw [pairedPrimeExponentPoleBoundaryMellin_verticalSplit]
    exact (installedRuntimePrimeExponentPole_phase_threeTerm
      observation nontrivial stageThreeConductorIndex).symm

structure ZeroOwnedStageThreeArithmeticMellinActionBoundaryCertificate
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) : Type where
  boundary_is_receipt : type_of%
    stageThreeFactorizationActionBoundary_eq_receipt
  joint_measurement_write : type_of%
    (stageThreeJointMeasurement_actionBoundary observation nontrivial)
  incidence_readback : type_of%
    (stageThreeJointMeasurement_actionBoundary_eq_incidence
      observation nontrivial)
  root_effect_write : type_of%
    (stageThreeJointMeasurement_rootEffect_write observation nontrivial)

def generateZeroOwnedStageThreeArithmeticMellinActionBoundaryCertificate
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    ZeroOwnedStageThreeArithmeticMellinActionBoundaryCertificate
      observation nontrivial where
  boundary_is_receipt := stageThreeFactorizationActionBoundary_eq_receipt
  joint_measurement_write :=
    stageThreeJointMeasurement_actionBoundary observation nontrivial
  incidence_readback :=
    stageThreeJointMeasurement_actionBoundary_eq_incidence
      observation nontrivial
  root_effect_write :=
    stageThreeJointMeasurement_rootEffect_write observation nontrivial

end
