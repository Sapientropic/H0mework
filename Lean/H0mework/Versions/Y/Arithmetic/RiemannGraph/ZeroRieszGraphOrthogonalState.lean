import H0mework.Versions.Y.Arithmetic.MuntzAction.CoPoissonMuntzZeroGraphCokernel

/-!
# Same-zero Riesz state in the graph orthogonal residual

The selected and reversal quotient Riesz vectors have canonical orthogonal
representatives inside their exact relation-graph Hilbert ambients.  These
states are nonzero and remain visibly generated by `source.2` of the single
zero/character/Müntz occurrence.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalRiemann
namespace ClozelGeneralizedDual
namespace CenteredGram

open SourceGeneratedFunctionalGraphPerfectification
open SourceGeneratedFunctionalGraphCokernel
open SourceGeneratedHilbertCokernel
open scoped InnerProductSpace

noncomputable section

abbrev selectedRelationGraphMap
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :=
  relationGraphMap
    (quarterMellinL2Feature (selectedCoPoissonMuntzParameter observation))
    (quarterMellinL2Functional (selectedCoPoissonMuntzParameter observation))
    (coPoissonQuarterMellinConvergentMap
      (selectedCoPoissonMuntzParameter observation)
      (selectedCoPoissonMuntzParameter_re_pos observation nontrivial)
      (selectedCoPoissonMuntzParameter_re_lt_half observation nontrivial))

abbrev reversalRelationGraphMap
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :=
  relationGraphMap
    (quarterMellinL2Feature (reversalCoPoissonMuntzParameter observation))
    (quarterMellinL2Functional (reversalCoPoissonMuntzParameter observation))
    (coPoissonQuarterMellinConvergentMap
      (reversalCoPoissonMuntzParameter observation)
      (reversalCoPoissonMuntzParameter_re_pos observation nontrivial)
      (reversalCoPoissonMuntzParameter_re_lt_half observation nontrivial))

def selectedRieszOrthogonalRepresentative
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    OrthogonalResidual (selectedRelationGraphMap observation nontrivial) :=
  quotientOrthogonalEquiv (selectedRelationGraphMap observation nontrivial)
    (selectedCoPoissonMuntzRieszVector observation nontrivial)

def reversalRieszOrthogonalRepresentative
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    OrthogonalResidual (reversalRelationGraphMap observation nontrivial) :=
  quotientOrthogonalEquiv (reversalRelationGraphMap observation nontrivial)
    (reversalCoPoissonMuntzRieszVector observation nontrivial)

theorem selectedRieszOrthogonalRepresentative_ne_zero
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    selectedRieszOrthogonalRepresentative observation nontrivial ≠ 0 := by
  intro representativeZero
  apply selectedCoPoissonMuntzRieszVector_ne_zero observation nontrivial
  apply (quotientOrthogonalEquiv
    (selectedRelationGraphMap observation nontrivial)).injective
  rw [map_zero]
  exact representativeZero

theorem reversalRieszOrthogonalRepresentative_ne_zero
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    reversalRieszOrthogonalRepresentative observation nontrivial ≠ 0 := by
  intro representativeZero
  apply reversalCoPoissonMuntzRieszVector_ne_zero observation nontrivial
  apply (quotientOrthogonalEquiv
    (reversalRelationGraphMap observation nontrivial)).injective
  rw [map_zero]
  exact representativeZero

def selectedRieszGraphHilbertState
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    GraphHilbertAmbient
      (quarterMellinL2Feature (selectedCoPoissonMuntzParameter observation))
      (quarterMellinL2Functional
        (selectedCoPoissonMuntzParameter observation)) :=
  selectedRieszOrthogonalRepresentative observation nontrivial

def reversalRieszGraphHilbertState
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    GraphHilbertAmbient
      (quarterMellinL2Feature (reversalCoPoissonMuntzParameter observation))
      (quarterMellinL2Functional
        (reversalCoPoissonMuntzParameter observation)) :=
  reversalRieszOrthogonalRepresentative observation nontrivial

theorem selectedRieszGraphHilbertState_ne_zero
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    selectedRieszGraphHilbertState observation nontrivial ≠ 0 := by
  intro stateZero
  apply selectedRieszOrthogonalRepresentative_ne_zero observation nontrivial
  apply Subtype.ext
  exact stateZero

theorem reversalRieszGraphHilbertState_ne_zero
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    reversalRieszGraphHilbertState observation nontrivial ≠ 0 := by
  intro stateZero
  apply reversalRieszOrthogonalRepresentative_ne_zero observation nontrivial
  apply Subtype.ext
  exact stateZero

theorem selectedRieszOrthogonalRepresentative_occurrence_root
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    selectedRieszOrthogonalRepresentative observation nontrivial =
      quotientOrthogonalEquiv
        (selectedRelationGraphMap observation nontrivial)
        (zeroOwnedCharacterMuntzCokernelOccurrence
          observation nontrivial).root.2.1 :=
  rfl

theorem reversalRieszOrthogonalRepresentative_occurrence_root
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    reversalRieszOrthogonalRepresentative observation nontrivial =
      quotientOrthogonalEquiv
        (reversalRelationGraphMap observation nontrivial)
        (zeroOwnedCharacterMuntzCokernelOccurrence
          observation nontrivial).root.2.2 :=
  rfl

theorem selectedRieszOrthogonalRepresentative_source_readback
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (value : QuarterMellinL2Test
      (selectedCoPoissonMuntzParameter observation)) :
    inner ℂ (selectedRieszOrthogonalRepresentative observation nontrivial)
        (quotientOrthogonalEquiv
          (selectedRelationGraphMap observation nontrivial)
          (coPoissonMuntzGraphSourceMap
            (selectedCoPoissonMuntzParameter observation)
            (selectedCoPoissonMuntzParameter_re_pos observation nontrivial)
            (selectedCoPoissonMuntzParameter_re_lt_half observation nontrivial)
            value)) =
      quarterMellinL2Functional
        (selectedCoPoissonMuntzParameter observation) value := by
  exact selectedCoPoissonMuntzRieszVector_source_readback
    observation nontrivial value

theorem reversalRieszOrthogonalRepresentative_source_readback
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (value : QuarterMellinL2Test
      (reversalCoPoissonMuntzParameter observation)) :
    inner ℂ (reversalRieszOrthogonalRepresentative observation nontrivial)
        (quotientOrthogonalEquiv
          (reversalRelationGraphMap observation nontrivial)
          (coPoissonMuntzGraphSourceMap
            (reversalCoPoissonMuntzParameter observation)
            (reversalCoPoissonMuntzParameter_re_pos observation nontrivial)
            (reversalCoPoissonMuntzParameter_re_lt_half observation nontrivial)
            value)) =
      quarterMellinL2Functional
        (reversalCoPoissonMuntzParameter observation) value := by
  exact reversalCoPoissonMuntzRieszVector_source_readback
    observation nontrivial value

end


end CenteredGram
end ClozelGeneralizedDual
end CanonicalRiemann
end NoIslandNoMagic
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
