import H0mework.Versions.Y.Arithmetic.Muntz.CoPoissonLogContact
import H0mework.Versions.Y.Arithmetic.MuntzAction.CoPoissonMuntzGraphCokernel
import H0mework.Versions.Y.Arithmetic.PoleGreen.Coefficient

/-!
# Origin-read obstruction for the pole Green boundary

Evaluation of the quarter log chart at the origin is a lawful linear source
read.  It is nonzero on an actual Müntz relation generated by the compact
Schwartz witness.  Consequently this read cannot descend through the
existing graph cokernel.  The delta trace in the Green equation is therefore
an explicit source boundary, not a quotient identity that can be used for
free.
-/

set_option autoImplicit false

namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual

open ClozelEndpointSourceEffect

noncomputable section

def quarterLogOriginRead (z : ℂ) :
    QuarterMellinL2Test z →ₗ[ℂ] ℂ where
  toFun value := positiveMellinLogQuarterTransform value.1 0
  map_add' left right := by
    change positiveMellinLogQuarterTransform (left.1 + right.1) 0 = _
    exact congrFun
      (map_add positiveMellinLogQuarterTransform left.1 right.1) 0
  map_smul' coefficient value := by
    change positiveMellinLogQuarterTransform (coefficient • value.1) 0 = _
    exact congrFun
      (map_smul positiveMellinLogQuarterTransform coefficient value.1) 0

theorem quarterLogOriginRead_coPoissonRelation
    (z : ℂ) (positive : 0 < z.re)
    (belowHalf : z.re < (1 / 2 : ℝ)) :
    quarterLogOriginRead z
        (coPoissonQuarterMellinConvergentMap z positive belowHalf
          remainderWitnessSchwartz) =
      coPoissonLogOrbitMap remainderWitnessSchwartz 0 := by
  change positiveMellinLogQuarterTransform
      (coPoissonQuarterMellinConvergentMap z positive belowHalf
        remainderWitnessSchwartz).1 0 = _
  rw [coPoissonQuarterMellinConvergentMap_value,
    positiveMellinLogQuarterTransform_coPoissonQuarterMellinMap]
  norm_num

theorem quarterLogOriginRead_coPoissonRelation_ne_zero
    (z : ℂ) (positive : 0 < z.re)
    (belowHalf : z.re < (1 / 2 : ℝ)) :
    quarterLogOriginRead z
        (coPoissonQuarterMellinConvergentMap z positive belowHalf
          remainderWitnessSchwartz) ≠ 0 := by
  rw [quarterLogOriginRead_coPoissonRelation]
  exact coPoissonLogOrbitMap_witness_ne_zero

theorem no_quarterLogOriginRead_descends_to_muntzGraphCokernel
    (z : ℂ) (positive : 0 < z.re)
    (belowHalf : z.re < (1 / 2 : ℝ)) :
    ¬ ∃ descended :
        CoPoissonMuntzGraphCokernel z positive belowHalf →ₗ[ℂ] ℂ,
      descended.comp
          (coPoissonMuntzGraphSourceMap z positive belowHalf) =
        quarterLogOriginRead z := by
  rintro ⟨descended, factorization⟩
  have atWitness := LinearMap.congr_fun factorization
    (coPoissonQuarterMellinConvergentMap z positive belowHalf
      remainderWitnessSchwartz)
  have relationZero := coPoissonMuntzGraphSourceMap_relation
    z positive belowHalf remainderWitnessSchwartz
  change descended
      (coPoissonMuntzGraphSourceMap z positive belowHalf
        (coPoissonQuarterMellinConvergentMap z positive belowHalf
          remainderWitnessSchwartz)) =
      quarterLogOriginRead z
        (coPoissonQuarterMellinConvergentMap z positive belowHalf
          remainderWitnessSchwartz) at atWitness
  rw [relationZero, map_zero] at atWitness
  exact quarterLogOriginRead_coPoissonRelation_ne_zero
    z positive belowHalf atWitness.symm

end
end NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
