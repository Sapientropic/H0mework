import Mathlib.NumberTheory.Harmonic.ZetaAsymp
import Mathlib.NumberTheory.LSeries.Nonvanishing
import H0mework.Versions.Y.Arithmetic.UnitArithmetic.CoordinateProjectionObstruction
import H0mework.Versions.Y.Arithmetic.RiemannInverseFibre.GeneratedZeroRead

/-!
# Completed defects generated by a nontrivial Riemann zero

A zero of the generated uncompleted function gives a zero of the completed
function only after the Gamma zero locus has been excluded.  This module
records that owner-indexed conversion simultaneously at a coordinate and its
reversal.  It also keeps the decisive deletion example visible: `-2` is a
generated zeta zero, but its completed value is nonzero.
-/

set_option autoImplicit false
set_option maxHeartbeats 3000000

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalRiemann

open CanonicalUnitArithmeticCoordinateProjectionObstruction

noncomputable section

namespace GeneratedRiemannZeroObservationAt

theorem coordinate_ne_zero {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner) :
    observation.coordinate ≠ 0 := by
  intro coordinateZero
  have zero := observation.mathlibZero
  rw [coordinateZero, riemannZeta_zero] at zero
  norm_num at zero

theorem gammaReal_ne_zero_of_nontrivial {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    Complex.Gammaℝ observation.coordinate ≠ 0 := by
  have coordinateNeZero := observation.coordinate_ne_zero
  rw [ne_eq, Complex.Gammaℝ_eq_zero_iff, not_exists]
  intro n equality
  cases n with
  | zero =>
      apply coordinateNeZero
      simpa using equality
  | succ n =>
      apply nontrivial
      refine ⟨n, ?_⟩
      simpa [Nat.cast_add, Nat.cast_one] using equality

/-- A nontrivial zero of the generated zeta function is a zero of the
completed function belonging to the same analytic owner. -/
theorem completed_eq_zero_of_nontrivial {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    generatedCompletedRiemannZeta owner observation.coordinate = 0 := by
  have zetaZero := observation.mathlibZero
  have gammaNeZero := observation.gammaReal_ne_zero_of_nontrivial nontrivial
  rw [riemannZeta_def_of_ne_zero observation.coordinate_ne_zero] at zetaZero
  have completedZero : completedRiemannZeta observation.coordinate = 0 :=
    (div_eq_zero_iff.mp zetaZero).resolve_right gammaNeZero
  rw [generatedCompletedRiemannZeta_eq_mathlib]
  exact completedZero

theorem conjugate_mathlibZero {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner) :
    riemannZeta (starRingEnd ℂ observation.coordinate) = 0 := by
  rw [riemannZeta_conj, observation.mathlibZero, map_zero]

theorem conjugate_nontrivial {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    ¬ ∃ n : Nat,
      starRingEnd ℂ observation.coordinate = -2 * (n + 1) := by
  rintro ⟨n, equality⟩
  apply nontrivial
  refine ⟨n, ?_⟩
  have conjugated := congrArg (starRingEnd ℂ) equality
  simpa [map_ofNat] using conjugated

/-- The same nontrivial observation generates the completed defect zero on
its reversal branch. -/
theorem completed_reversal_eq_zero_of_nontrivial
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    generatedCompletedRiemannZeta owner
        (coordinateReversal observation.coordinate) = 0 := by
  let conjugateObservation :=
    GeneratedRiemannZeroObservationAt.ofMathlibZero owner
      (starRingEnd ℂ observation.coordinate) observation.conjugate_mathlibZero
  have completedConjugate :=
    conjugateObservation.completed_eq_zero_of_nontrivial
      (observation.conjugate_nontrivial nontrivial)
  rw [coordinateReversal,
    generatedCompletedRiemannZeta_one_sub]
  exact completedConjugate

/-- The two completed defects are separately tagged; neither branch may be
cancelled against the other. -/
structure GeneratedCompletedBothZeroAt {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) : Prop where
  selected :
    generatedCompletedRiemannZeta owner observation.coordinate = 0
  reversal :
    generatedCompletedRiemannZeta owner
      (coordinateReversal observation.coordinate) = 0

theorem completedBothZero {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    GeneratedCompletedBothZeroAt observation nontrivial where
  selected := observation.completed_eq_zero_of_nontrivial nontrivial
  reversal :=
    observation.completed_reversal_eq_zero_of_nontrivial nontrivial

/-! ## Open critical strip -/

theorem coordinate_re_lt_one {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner) :
    observation.coordinate.re < 1 := by
  by_contra notBelow
  exact (riemannZeta_ne_zero_of_one_le_re (le_of_not_gt notBelow))
    observation.mathlibZero

theorem coordinate_re_pos_of_nontrivial {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    0 < observation.coordinate.re := by
  by_contra notPositive
  have selectedNonpositive : observation.coordinate.re ≤ 0 :=
    le_of_not_gt notPositive
  let reflected := coordinateReversal observation.coordinate
  have reflectedReal : 1 ≤ reflected.re := by
    dsimp [reflected]
    simp [coordinateReversal]
    linarith
  have reflectedNeZero : reflected ≠ 0 := by
    intro reflectedZero
    have realZero : reflected.re = 0 := by
      rw [reflectedZero]
      rfl
    linarith
  have completedZero :
      generatedCompletedRiemannZeta owner reflected = 0 := by
    dsimp [reflected]
    exact observation.completed_reversal_eq_zero_of_nontrivial nontrivial
  have zetaZero : riemannZeta reflected = 0 := by
    rw [riemannZeta_def_of_ne_zero reflectedNeZero,
      ← generatedCompletedRiemannZeta_eq_mathlib owner,
      completedZero, zero_div]
  exact (riemannZeta_ne_zero_of_one_le_re reflectedReal) zetaZero

/-- A nontrivial generated zero lies in the open critical strip. -/
theorem coordinate_mem_openCriticalStrip_of_nontrivial
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    0 < observation.coordinate.re ∧ observation.coordinate.re < 1 :=
  ⟨observation.coordinate_re_pos_of_nontrivial nontrivial,
    observation.coordinate_re_lt_one⟩

end GeneratedRiemannZeroObservationAt

/-! ## Trivial-zero deletion -/

theorem completedRiemannZeta_three_ne_zero :
    completedRiemannZeta 3 ≠ 0 := by
  intro completedZero
  have relation := riemannZeta_def_of_ne_zero
    (show (3 : ℂ) ≠ 0 by norm_num)
  rw [completedZero, zero_div] at relation
  exact riemannZeta_ne_zero_of_one_le_re (by norm_num) relation

theorem completedRiemannZeta_negTwo_ne_zero :
    completedRiemannZeta (-2) ≠ 0 := by
  intro completedZero
  have functional := completedRiemannZeta_one_sub (-2)
  norm_num at functional
  rw [completedZero] at functional
  exact completedRiemannZeta_three_ne_zero functional

theorem generatedRiemannZeta_negTwo_eq_zero
    (owner : GlobalGermOwner) :
    generatedRiemannZeta owner (-2) = 0 := by
  rw [generatedRiemannZeta_eq_mathlib]
  simpa using riemannZeta_neg_two_mul_nat_add_one 0

theorem generatedCompletedRiemannZeta_negTwo_ne_zero
    (owner : GlobalGermOwner) :
    generatedCompletedRiemannZeta owner (-2) ≠ 0 := by
  rw [generatedCompletedRiemannZeta_eq_mathlib]
  exact completedRiemannZeta_negTwo_ne_zero

end
