import H0mework.Versions.Y.Arithmetic.RiemannSourceGreen.Linearity
import H0mework.Arithmetic.MellinTateSource.FourierRead
import H0mework.Versions.Y.Arithmetic.RiemannSpectral.PaOrthogonalCompression

/-! Continuous linear equality on the original Fourier-fixed Pa face is generated by actual
compact sources and their source-native Tate average. -/

set_option autoImplicit false

namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.BurnolPhysicalState
namespace OriginalPaPhysicalGreen

open Complex MeasureTheory Set Filter
open scoped InnerProductSpace Topology
noncomputable section

local instance : CompleteSpace BurnolPaAmbientCarrier := by
  apply IsComplete.completeSpace_coe
  exact (evenBurnolClosedFace burnolUnscaledCommonGapRadius).isClosed.isComplete

private def sourcePairedAverage : BurnolPaAmbientCarrier →L[ℂ] BurnolPaAmbientCarrier :=
  (1 / 2 : ℂ) • (ContinuousLinearMap.id ℂ BurnolPaAmbientCarrier +
    (evenFaceFourierEquiv burnolUnscaledCommonGapRadius).toContinuousLinearEquiv.toContinuousLinearMap)

private theorem sourcePairedAverage_compact (source : burnolCompactAnnulusSource) :
    sourcePairedAverage (burnolCompactAdditivePhysicalState source) =
      burnolCompactAdditivePhysicalState
        ((1 / 2 : ℂ) • (source + burnolCompactTateReciprocalSource source)) := by
  change (1 / 2 : ℂ) • (burnolCompactAdditivePhysicalLinear source +
    evenFaceFourierEquiv burnolUnscaledCommonGapRadius (burnolCompactAdditivePhysicalLinear source)) =
      burnolCompactAdditivePhysicalLinear
        ((1 / 2 : ℂ) • (source + burnolCompactTateReciprocalSource source))
  rw [map_smul, map_add]
  congr 2
  apply Subtype.ext
  exact burnolCompactFourierL2_eq_reciprocalL2 source

private theorem sourcePairedAverage_fixed (p : BurnolPaAmbientCarrier) :
    evenFaceFourierEquiv burnolUnscaledCommonGapRadius (sourcePairedAverage p) =
      sourcePairedAverage p := by
  change evenFaceFourierEquiv burnolUnscaledCommonGapRadius
    ((1 / 2 : ℂ) • (p + evenFaceFourierEquiv burnolUnscaledCommonGapRadius p)) =
      (1 / 2 : ℂ) • (p + evenFaceFourierEquiv burnolUnscaledCommonGapRadius p)
  have twice : evenFaceFourierEquiv burnolUnscaledCommonGapRadius
      (evenFaceFourierEquiv burnolUnscaledCommonGapRadius p) = p :=
    evenFaceFourier_involutive burnolUnscaledCommonGapRadius p
  rw [map_smul, map_add, twice, add_comm]

theorem originalPa_fixed_clm_ext
    (left right : burnolCompactCoPoissonClosedRange.toSubmodule →L[ℂ] ℂ)
    (onCompact : ∀ source : burnolCompactAnnulusSource,
      evenFaceFourierEquiv burnolUnscaledCommonGapRadius
        (burnolCompactAdditivePhysicalState source) = burnolCompactAdditivePhysicalState source →
      left ⟨burnolCompactAdditivePhysicalState source, by
        change burnolCompactAdditivePhysicalState source ∈ burnolCompactCoPoissonClosedRange
        simpa only [burnolCompactCoPoissonGenerator, Fin.isValue, ↓reduceIte] using
          burnolCompactCoPoissonGenerator_mem_closedRange (source, (0 : Fin 2))⟩ =
      right ⟨burnolCompactAdditivePhysicalState source, by
        change burnolCompactAdditivePhysicalState source ∈ burnolCompactCoPoissonClosedRange
        simpa only [burnolCompactCoPoissonGenerator, Fin.isValue, ↓reduceIte] using
          burnolCompactCoPoissonGenerator_mem_closedRange (source, (0 : Fin 2))⟩)
    (p : BurnolPaAmbientCarrier) (member : p ∈ burnolCompactCoPoissonClosedRange)
    (fixed : evenFaceFourierEquiv burnolUnscaledCommonGapRadius p = p) :
    left ⟨p, member⟩ = right ⟨p, member⟩ := by
  let projection := burnolCompactCoPoissonClosedRange.toSubmodule.orthogonalProjectionOnto
  let equation := ((left - right).comp (projection.comp sourcePairedAverage)).ker
  have compact (source : burnolCompactAnnulusSource) :
      burnolCompactAdditivePhysicalState source ∈ equation := by
    let paired : burnolCompactAnnulusSource :=
      (1 / 2 : ℂ) • (source + burnolCompactTateReciprocalSource source)
    have inPa : burnolCompactAdditivePhysicalState paired ∈ burnolCompactCoPoissonClosedRange := by
      simpa only [burnolCompactCoPoissonGenerator, Fin.isValue, ↓reduceIte] using
        burnolCompactCoPoissonGenerator_mem_closedRange (paired, (0 : Fin 2))
    have same : sourcePairedAverage (burnolCompactAdditivePhysicalState source) =
        burnolCompactAdditivePhysicalState paired := sourcePairedAverage_compact source
    have pairedFixed : evenFaceFourierEquiv burnolUnscaledCommonGapRadius
        (burnolCompactAdditivePhysicalState paired) = burnolCompactAdditivePhysicalState paired := by
      rw [← same]
      exact sourcePairedAverage_fixed _
    have projected : projection (burnolCompactAdditivePhysicalState paired) =
        ⟨burnolCompactAdditivePhysicalState paired, inPa⟩ :=
      burnolCompactCoPoissonClosedRange.toSubmodule.orthogonalProjectionOnto_mem_subspace_eq_self
        ⟨burnolCompactAdditivePhysicalState paired, inPa⟩
    change left (projection (sourcePairedAverage (burnolCompactAdditivePhysicalState source))) -
      right (projection (sourcePairedAverage (burnolCompactAdditivePhysicalState source))) = 0
    rw [same, projected]
    exact sub_eq_zero.mpr (onCompact paired pairedFixed)
  have generator (i : BurnolCompactCoPoissonGeneratorIndex) :
      burnolCompactCoPoissonGenerator i ∈ equation := by
    rcases i with ⟨source, parity⟩
    fin_cases parity
    · exact compact source
    · have same : burnolCompactCoPoissonGenerator (source, (1 : Fin 2)) =
          burnolCompactAdditivePhysicalState (burnolCompactTateReciprocalSource source) := by
        apply Subtype.ext
        exact burnolCompactFourierL2_eq_reciprocalL2 source
      change burnolCompactCoPoissonGenerator (source, (1 : Fin 2)) ∈ equation
      rw [same]
      exact compact _
  have sourceRead (input : BurnolCompactCoPoissonLinearSource) :
      burnolCompactCoPoissonLanding input ∈ equation := by
    induction input using Finsupp.induction_linear with
    | zero => simpa only [map_zero] using equation.zero_mem
    | add a b ha hb => rw [map_add]; exact equation.add_mem ha hb
    | single i c => rw [burnolCompactCoPoissonLanding_single]; exact equation.smul_mem c (generator i)
  have included : LinearMap.range burnolCompactCoPoissonLanding ≤ equation := by
    rintro _ ⟨input, rfl⟩
    exact sourceRead input
  have closed : IsClosed (equation : Set BurnolPaAmbientCarrier) :=
    isClosed_eq (((left - right).comp (projection.comp sourcePairedAverage)).continuous) continuous_const
  have generated := (LinearMap.range burnolCompactCoPoissonLanding).topologicalClosure_minimal
    included closed member
  have averaged : sourcePairedAverage p = p := by
    change (1 / 2 : ℂ) • (p + evenFaceFourierEquiv burnolUnscaledCommonGapRadius p) = p
    rw [fixed]
    module
  have projected : projection p = ⟨p, member⟩ :=
    burnolCompactCoPoissonClosedRange.toSubmodule.orthogonalProjectionOnto_mem_subspace_eq_self
      ⟨p, member⟩
  change left (projection (sourcePairedAverage p)) - right (projection (sourcePairedAverage p)) = 0
    at generated
  rw [averaged, projected] at generated
  exact sub_eq_zero.mp generated

end
end OriginalPaPhysicalGreen
end NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.BurnolPhysicalState
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
