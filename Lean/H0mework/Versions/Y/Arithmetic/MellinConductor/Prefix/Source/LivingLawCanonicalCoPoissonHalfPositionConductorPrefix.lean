import H0mework.Versions.Y.Arithmetic.RiemannGraph.Graph.Domain.LivingLawCanonicalRiemannRuntimeMuntzHalfPositionDomain

/-!
# Half-position conductor source prefixes

Finite Euler-conductor dilation prefixes are generated inside the maximal
half-position source domain.  The source, closed-graph and raw logarithmic
reads retain the same whole/retained/convolution-residual decomposition.
No second position domain or completed future is supplied.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalRiemann
namespace ClozelGeneralizedDual
namespace MuntzConductor
namespace HalfPositionSource
namespace SourcePrefix

open CanonicalArithmeticState.AllPlaceEulerLog
open CanonicalArithmeticState.AllPlaceEulerLog.Conductor
open GraphLogPositionCone
open HalfPositionDomain
open scoped ArithmeticFunction

noncomputable section

/-- Actual normalized source dilation restricted to the maximal
half-position domain. -/
def halfPositionSourceDilation
    (z : ℂ) (scale : ℝ) (positive : 0 < scale) :
    quarterMellinHalfPositionSourceDomain z →ₗ[ℂ]
      quarterMellinHalfPositionSourceDomain z :=
  LinearMap.codRestrict (quarterMellinHalfPositionSourceDomain z)
    ((quarterDilationTestAction z scale positive).comp
      (quarterMellinHalfPositionSourceDomain z).subtype)
    (fun value => quarterDilationFeature_mem_halfPositionDomain
      z scale positive value.1 value.2)

/-- One finite graph-dilation term in the actual source domain. -/
def graphNormalizedSourceDilationTerm
    (z : ℂ) (coefficients : ArithmeticFunction ℝ) (index : Nat) :
    quarterMellinHalfPositionSourceDomain z →ₗ[ℂ]
      quarterMellinHalfPositionSourceDomain z :=
  ((coefficients (index + 1) : ℂ) *
      (graphHalfDensityWeight index : ℂ)) •
    halfPositionSourceDilation z (graphIntegerDilationScale index)
      (graphIntegerDilationScale_pos index)

/-- The finite prefix is generated by summing its actual source terms. -/
def graphNormalizedSourceDilationPrefix
    (z : ℂ) (coefficients : ArithmeticFunction ℝ) (cutoff : Nat) :
    quarterMellinHalfPositionSourceDomain z →ₗ[ℂ]
      quarterMellinHalfPositionSourceDomain z :=
  ∑ index ∈ Finset.range cutoff,
    graphNormalizedSourceDilationTerm z coefficients index

def halfPositionRawLogFeature (z : ℂ) :
    quarterMellinHalfPositionSourceDomain z →ₗ[ℂ]
      GenericFoundation.Analysis.LogPositionTranslationCone.RawLogState :=
  positiveMellinLogQuarterTransform.comp
    ((quarterMellinL2TestSubmodule z).subtype.comp
      (quarterMellinHalfPositionSourceDomain z).subtype)

@[simp] theorem halfPositionRawLogFeature_apply
    (z : ℂ) (value : quarterMellinHalfPositionSourceDomain z) :
    halfPositionRawLogFeature z value =
      quarterMellinGraphLogState value.1 :=
  rfl

theorem graphNormalizedSourceDilationTerm_mem_domain
    (z : ℂ) (coefficients : ArithmeticFunction ℝ) (index : Nat)
    (value : quarterMellinHalfPositionSourceDomain z) :
    quarterMellinL2Feature z
        (graphNormalizedSourceDilationTerm z coefficients index value).1 ∈
      HalfPositionOperator.domain :=
  (graphNormalizedSourceDilationTerm z coefficients index value).2

theorem graphNormalizedSourceDilationPrefix_mem_domain
    (z : ℂ) (coefficients : ArithmeticFunction ℝ) (cutoff : Nat)
    (value : quarterMellinHalfPositionSourceDomain z) :
    quarterMellinL2Feature z
        (graphNormalizedSourceDilationPrefix
          z coefficients cutoff value).1 ∈
      HalfPositionOperator.domain :=
  (graphNormalizedSourceDilationPrefix z coefficients cutoff value).2

/-- Forgetting to the raw logarithmic chart recovers the existing graph
dilation term pointwise, with no comparison scalar. -/
theorem graphNormalizedSourceDilationTerm_log_readback
    (z : ℂ) (coefficients : ArithmeticFunction ℝ) (index : Nat)
    (value : quarterMellinHalfPositionSourceDomain z) :
    quarterMellinGraphLogState
        (graphNormalizedSourceDilationTerm z coefficients index value).1 =
      graphNormalizedLogDilationTerm coefficients index
        (quarterMellinGraphLogState value.1) := by
  funext x
  have source := graphNormalizedLogDilationTerm_eq_sourceAction
    coefficients index value.1 x
  have underlying :
      (graphNormalizedSourceDilationTerm
        z coefficients index value).1 =
        ((coefficients (index + 1) : ℂ) *
            (graphHalfDensityWeight index : ℂ)) •
          quarterDilationTestAction z
            (graphIntegerDilationScale index)
            (graphIntegerDilationScale_pos index) value.1 := by
    rfl
  rw [underlying]
  change
    positiveMellinLogQuarterTransform
        (((coefficients (index + 1) : ℂ) *
            (graphHalfDensityWeight index : ℂ)) •
          (quarterDilationTestAction z
            (graphIntegerDilationScale index)
            (graphIntegerDilationScale_pos index) value.1).1) x = _
  rw [map_smul]
  change
    ((coefficients (index + 1) : ℂ) *
        (graphHalfDensityWeight index : ℂ)) *
      quarterMellinGraphLogState
        (quarterDilationTestAction z
          (graphIntegerDilationScale index)
          (graphIntegerDilationScale_pos index) value.1) x = _
  exact source.symm

theorem graphNormalizedSourceDilationPrefix_log_readback
    (z : ℂ) (coefficients : ArithmeticFunction ℝ) (cutoff : Nat)
    (value : quarterMellinHalfPositionSourceDomain z) :
    quarterMellinGraphLogState
        (graphNormalizedSourceDilationPrefix
          z coefficients cutoff value).1 =
      graphNormalizedLogDilationPrefix coefficients cutoff
        (quarterMellinGraphLogState value.1) := by
  funext x
  change halfPositionRawLogFeature z
      (graphNormalizedSourceDilationPrefix
        z coefficients cutoff value) x = _
  rw [graphNormalizedSourceDilationPrefix, LinearMap.sum_apply, map_sum]
  simp only [Finset.sum_apply, graphNormalizedLogDilationPrefix]
  apply Finset.sum_congr rfl
  intro index indexMem
  exact congrFun
    (graphNormalizedSourceDilationTerm_log_readback
      z coefficients index value) x

theorem graphNormalizedSourceDilationPrefix_add
    (z : ℂ) (left right : ArithmeticFunction ℝ) (cutoff : Nat) :
    graphNormalizedSourceDilationPrefix z (left + right) cutoff =
      graphNormalizedSourceDilationPrefix z left cutoff +
        graphNormalizedSourceDilationPrefix z right cutoff := by
  apply LinearMap.ext
  intro value
  simp only [graphNormalizedSourceDilationPrefix,
    graphNormalizedSourceDilationTerm, ArithmeticFunction.add_apply,
    LinearMap.sum_apply, LinearMap.add_apply, LinearMap.smul_apply]
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro index indexMem
  push_cast
  rw [add_mul, add_smul]

def ownerEulerGraphWholeSourcePrefix
    (z : ℂ) (owner : GlobalGermOwner) (cutoff : Nat) :
    quarterMellinHalfPositionSourceDomain z →ₗ[ℂ]
      quarterMellinHalfPositionSourceDomain z :=
  graphNormalizedSourceDilationPrefix z
    ((GeneratedEulerLogFaceAt.generate owner).coefficients *
      ownerRealCoefficients owner) cutoff

def ownerEulerGraphRetainedSourcePrefix
    (z : ℂ) (owner : GlobalGermOwner) (cutoff : Nat) :
    quarterMellinHalfPositionSourceDomain z →ₗ[ℂ]
      quarterMellinHalfPositionSourceDomain z :=
  graphNormalizedSourceDilationPrefix z
    (GeneratedEulerLogFaceAt.generate owner).coefficients cutoff

def ownerEulerGraphResidualSourcePrefix
    (z : ℂ) (owner : GlobalGermOwner) (cutoff : Nat) :
    quarterMellinHalfPositionSourceDomain z →ₗ[ℂ]
      quarterMellinHalfPositionSourceDomain z :=
  graphNormalizedSourceDilationPrefix z
    (LogPositionCone.ownerEulerConvolutionResidualCoefficients owner) cutoff

/-- The owner-generated whole/retained/convolution-residual split already
holds before either Hilbert or quotient readout. -/
theorem ownerEulerGraphSourcePrefix_decomposition
    (z : ℂ) (owner : GlobalGermOwner) (cutoff : Nat) :
    ownerEulerGraphWholeSourcePrefix z owner cutoff =
      ownerEulerGraphRetainedSourcePrefix z owner cutoff +
        ownerEulerGraphResidualSourcePrefix z owner cutoff := by
  unfold ownerEulerGraphWholeSourcePrefix
    ownerEulerGraphRetainedSourcePrefix ownerEulerGraphResidualSourcePrefix
  rw [LogPositionCone.ownerEulerConvolutionCoefficients_decomposition,
    graphNormalizedSourceDilationPrefix_add]

/-- The closed half-position graph feature preserves the same decomposition
as a strict linear-map identity. -/
theorem ownerEulerGraphFeaturePrefix_decomposition
    (z : ℂ) (owner : GlobalGermOwner) (cutoff : Nat) :
    (halfPositionGraphFeature z).comp
        (ownerEulerGraphWholeSourcePrefix z owner cutoff) =
      (halfPositionGraphFeature z).comp
          (ownerEulerGraphRetainedSourcePrefix z owner cutoff) +
        (halfPositionGraphFeature z).comp
          (ownerEulerGraphResidualSourcePrefix z owner cutoff) := by
  apply LinearMap.ext
  intro value
  rw [LinearMap.comp_apply, LinearMap.add_apply,
    LinearMap.comp_apply, LinearMap.comp_apply,
    ownerEulerGraphSourcePrefix_decomposition]
  rw [LinearMap.add_apply, map_add]

theorem ownerEulerGraphWholeSourcePrefix_log_readback
    (z : ℂ) (owner : GlobalGermOwner) (cutoff : Nat)
    (value : quarterMellinHalfPositionSourceDomain z) :
    quarterMellinGraphLogState
        (ownerEulerGraphWholeSourcePrefix z owner cutoff value).1 =
      ownerEulerGraphWholePrefix owner cutoff
        (quarterMellinGraphLogState value.1) := by
  exact graphNormalizedSourceDilationPrefix_log_readback z
    ((GeneratedEulerLogFaceAt.generate owner).coefficients *
      ownerRealCoefficients owner) cutoff value

theorem ownerEulerGraphRetainedSourcePrefix_log_readback
    (z : ℂ) (owner : GlobalGermOwner) (cutoff : Nat)
    (value : quarterMellinHalfPositionSourceDomain z) :
    quarterMellinGraphLogState
        (ownerEulerGraphRetainedSourcePrefix z owner cutoff value).1 =
      ownerEulerGraphRetainedPrefix owner cutoff
        (quarterMellinGraphLogState value.1) := by
  exact graphNormalizedSourceDilationPrefix_log_readback z
    (GeneratedEulerLogFaceAt.generate owner).coefficients cutoff value

theorem ownerEulerGraphResidualSourcePrefix_log_readback
    (z : ℂ) (owner : GlobalGermOwner) (cutoff : Nat)
    (value : quarterMellinHalfPositionSourceDomain z) :
    quarterMellinGraphLogState
        (ownerEulerGraphResidualSourcePrefix z owner cutoff value).1 =
      ownerEulerGraphResidualPrefix owner cutoff
        (quarterMellinGraphLogState value.1) := by
  exact graphNormalizedSourceDilationPrefix_log_readback z
    (LogPositionCone.ownerEulerConvolutionResidualCoefficients owner)
    cutoff value

theorem ownerEulerGraphSourcePrefix_decomposition_apply
    (z : ℂ) (owner : GlobalGermOwner) (cutoff : Nat)
    (value : quarterMellinHalfPositionSourceDomain z) :
    ownerEulerGraphWholeSourcePrefix z owner cutoff value =
      ownerEulerGraphRetainedSourcePrefix z owner cutoff value +
        ownerEulerGraphResidualSourcePrefix z owner cutoff value := by
  have equality := LinearMap.congr_fun
    (ownerEulerGraphSourcePrefix_decomposition z owner cutoff) value
  simpa only [LinearMap.add_apply] using equality

end
