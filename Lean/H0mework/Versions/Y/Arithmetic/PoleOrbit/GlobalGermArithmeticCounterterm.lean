import H0mework.Versions.Y.Arithmetic.EulerLog.GlobalGerm
import H0mework.Arithmetic.Tempered.Remainder

/-!
# Arithmetic counterterm generated by the global determinant germ

The global germ owns the zeta coefficient function.  Weighting the integral
lattice by those literal coefficients and removing volume produces the
arithmetic half of the all-place origin defect.  The definition below does
not mention the quarter-log origin read; their equality on an actual
co-Poisson--Müntz relation is proved downstream.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalRiemann
namespace AllPlaceOriginDefect

open CanonicalUnitArithmeticFactorizationGlobalDeterminantCoordinateRealization
open NoIslandNoMagic.CanonicalArithmeticState.AllPlaceEulerLog
open MeasureTheory
open scoped SchwartzMap

noncomputable section

/-- The owner-generated nonzero lattice read before the Archimedean volume
counterterm is removed.  The coefficient at `|n|` is read from the actual
global determinant germ. -/
def ownerArithmeticCombValue
    (owner : GlobalGermOwner) (test : SchwartzMap ℝ ℂ) : ℂ :=
  ∑' n : ℤ, (owner.2.coefficients n.natAbs : ℂ) * test n

theorem ownerArithmeticCombValue_eq_nonzeroComb
    (owner : GlobalGermOwner) (test : SchwartzMap ℝ ℂ) :
    ownerArithmeticCombValue owner test =
      (∑' n : ℤ, if n = 0 then 0 else test n) := by
  unfold ownerArithmeticCombValue
  apply tsum_congr
  intro n
  rw [generatedGermCoefficients_eq_zeta owner.2]
  by_cases zero : n = 0
  · subst n
    simp
  · rw [if_neg zero]
    have natAbsNe : n.natAbs ≠ 0 := Int.natAbs_ne_zero.mpr zero
    norm_num [ArithmeticFunction.zeta_apply_ne natAbsNe]

theorem ownerArithmeticCombValue_eq_integerComb_sub_origin
    (owner : GlobalGermOwner) (test : SchwartzMap ℝ ℂ) :
    ownerArithmeticCombValue owner test =
      (∑' n : ℤ, test n) - test 0 := by
  rw [ownerArithmeticCombValue_eq_nonzeroComb]
  have split := (summable_integer_evaluation test).tsum_eq_add_tsum_ite 0
  calc
    (∑' n : ℤ, if n = 0 then 0 else test n) =
        ((test 0 + ∑' n : ℤ, if n = 0 then 0 else test n) - test 0) := by
          ring
    _ = (∑' n : ℤ, test n) - test 0 := by
      simpa using congrArg (fun value : ℂ => value - test 0) split.symm

/-- The all-place arithmetic counterterm.  Its lattice coefficients come
from the owner; the continuous term is the canonical volume face. -/
def ownerArithmeticCountertermValue
    (owner : GlobalGermOwner) (test : SchwartzMap ℝ ℂ) : ℂ :=
  ownerArithmeticCombValue owner test - ∫ x : ℝ, test x

theorem ownerArithmeticCountertermValue_eq_remainder
    (owner : GlobalGermOwner) (test : SchwartzMap ℝ ℂ) :
    ownerArithmeticCountertermValue owner test =
      clozelTemperedRemainder test := by
  rw [ownerArithmeticCountertermValue, ownerArithmeticCombValue_eq_integerComb_sub_origin,
    clozelTemperedRemainder_apply]

/-- Linear packaging of the owner-generated arithmetic counterterm. -/
def ownerArithmeticCounterterm (owner : GlobalGermOwner) :
    SchwartzMap ℝ ℂ →ₗ[ℂ] ℂ where
  toFun := ownerArithmeticCountertermValue owner
  map_add' left right := by
    simp only [ownerArithmeticCountertermValue_eq_remainder]
    exact map_add clozelTemperedRemainder left right
  map_smul' coefficient value := by
    simp only [ownerArithmeticCountertermValue_eq_remainder]
    exact map_smul clozelTemperedRemainder coefficient value

@[simp] theorem ownerArithmeticCounterterm_apply
    (owner : GlobalGermOwner) (test : SchwartzMap ℝ ℂ) :
    ownerArithmeticCounterterm owner test =
      ownerArithmeticCountertermValue owner test :=
  rfl

theorem ownerArithmeticCounterterm_eq_remainder
    (owner : GlobalGermOwner) (test : SchwartzMap ℝ ℂ) :
    ownerArithmeticCounterterm owner test =
      clozelTemperedRemainder test :=
  ownerArithmeticCountertermValue_eq_remainder owner test

/-- The Euler-log occurrence and the arithmetic counterterm use the literal
same global-germ owner.  This is a provenance lock, not an analytic
comparison premise. -/
theorem root_counterterm_uses_eulerLog_owner :
    ownerArithmeticCounterterm globalEulerLogOccurrence.root.1 =
      ownerArithmeticCounterterm globalGermOccurrence.root := by
  rw [globalEulerLogOccurrence_root_owner]

end
