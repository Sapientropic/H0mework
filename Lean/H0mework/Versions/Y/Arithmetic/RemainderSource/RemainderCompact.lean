import H0mework.Versions.Y.Arithmetic.RemainderSource.RemainderKernel
import H0mework.Versions.Y.Arithmetic.MobiusSource.Tate

/-! Actual compact co-Poisson values arise from the comb-remainder source action. -/

set_option autoImplicit false

namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.BurnolPhysicalState
open Complex MeasureTheory Set
open scoped InnerProductSpace
noncomputable section
local notation "Ambient" => EvenBurnolPhysicalCarrier burnolUnscaledCommonGapRadius

private theorem even_half_integral (f : ℝ → ℂ) (integrable : Integrable f)
    (even : ∀ x, f (-x) = f x) :
    (1 / 2 : ℂ) * (∫ x : ℝ, f x) = ∫ x : ℝ in Ioi 0, f x := by
  have negative : (∫ x : ℝ in Iic 0, f x) = ∫ x : ℝ in Ioi 0, f x := by
    calc
      _ = ∫ x : ℝ in Iic 0, f (-x) :=
        setIntegral_congr_fun measurableSet_Iic (fun x _ => (even x).symm)
      _ = _ := by simpa only [neg_zero] using integral_comp_neg_Iic 0 f
  rw [← setIntegral_univ, ← Iic_union_Ioi (a := (0 : ℝ)),
    setIntegral_union (Iic_disjoint_Ioi le_rfl) measurableSet_Ioi
      integrable.integrableOn integrable.integrableOn, negative]
  ring

/-- A compact generator is the actual comb-remainder source action, with
the reciprocal mean generated by the source itself. -/
theorem burnolRemainderSourceRead_compact (source : burnolCompactAnnulusSource)
    (test : SchwartzMap ℝ ℂ) :
    burnolRemainderSourceRead
      (burnolMobiusSourceL2 (burnolCompactAdditivePhysicalState source)) test =
      ∫ x : ℝ, test x * burnolCompactAdditiveCoSum source x := by
  let reciprocal := burnolCompactTateReciprocalSource source
  let g : ℝ → ℂ := burnolCompactAdditiveSource source
  let forward : ℝ → ℂ := fun x =>
    ∑' n : ℕ, ((n + 1 : ℕ) : ℂ)⁻¹ * g (x / (n + 1 : ℕ))
  let normal := burnolCompactAdditiveNormalization source
  have gEven : ∀ x, g (-x) = g x := burnolCompactAdditiveSource_even source
  have gZero : g 0 = 0 := burnolCompactAdditiveSource_zero_of_abs_le_quarter
    source (by norm_num)
  have gMeasurable : Measurable g := burnolCompactAdditiveSource_measurable source
  have gWeighted : Integrable (fun x : ℝ => ‖g x‖ / |x| ^ 3) := by
    simpa only [reciprocal, g, burnolCompactTateReciprocalSource,
      burnolCompactTateReciprocalSchwartz_apply] using
        burnolCompactAnnulusSource_norm_div_abs_cube_integrable reciprocal
  have gMemLp : MemLp g 2 volume := by
    refine (reciprocal.1.memLp 2 volume).ae_eq (ae_of_all volume fun x => ?_)
    exact burnolCompactTateReciprocalSchwartz_apply source x
  have kernelMemLp : MemLp (fun x : ℝ => coPoissonMuntzScaleRemainder test |x|)
      2 volume := (Lp.memLp (burnolRemainderL2Kernel test)).ae_eq
        (burnolRemainderL2Kernel_coeFn test)
  have halfRead :
      burnolRemainderSourceRead
        (burnolMobiusSourceL2 (burnolCompactAdditivePhysicalState source)) test =
        ∫ u : ℝ in Ioi 0, g u * coPoissonMuntzScaleRemainder test u := by
    rw [burnolRemainderSourceRead_integral]
    calc
      _ = (1 / 2 : ℂ) * ∫ x : ℝ, g x * coPoissonMuntzScaleRemainder test |x| := by
        congr 1
        apply integral_congr_ae
        filter_upwards [burnolMobiusSourceExtension_compact_coeFn source] with x hx
        change burnolMobiusSourceL2 (burnolCompactAdditivePhysicalState source) x = g x at hx
        rw [hx]
      _ = ∫ x : ℝ in Ioi 0, g x * coPoissonMuntzScaleRemainder test |x| :=
        even_half_integral _ (gMemLp.integrable_mul kernelMemLp)
          (fun x => by rw [gEven, abs_neg])
      _ = _ := setIntegral_congr_fun measurableSet_Ioi
        (fun x hx => by rw [abs_of_pos hx])
  have thetaRead : (∫ x : ℝ, test x * forward x) =
      ∫ u : ℝ in Ioi 0, g u * coPoissonMuntzThetaNonzero test u := by
    simpa only [forward, FourierTransform.fourier_fourierInv_eq] using
      MobiusSourceFourierPairing.integral_forward_eq_positiveTheta
        g gMeasurable gZero gEven gWeighted (FourierTransform.fourierInv test)
  have thetaIntegrable : IntegrableOn
      (fun u : ℝ => g u * coPoissonMuntzThetaNonzero test u) (Ioi 0) := by
    simpa only [FourierTransform.fourier_fourierInv_eq] using
      MobiusSourceFourierPairing.positiveTheta_integrable
        g gMeasurable gZero gEven gWeighted (FourierTransform.fourierInv test)
  have invIntegrable : IntegrableOn (fun u : ℝ => (u : ℂ)⁻¹ * g u) (Ioi 0) := by
    simpa only [reciprocal, g, burnolCompactTateReciprocalSource,
      burnolCompactTateReciprocalSchwartz_apply] using
        (burnolCompactAnnulusSource_inv_mul_integrable reciprocal).integrableOn
  have invMoment : (∫ u : ℝ in Ioi 0, (u : ℂ)⁻¹ * g u) = normal := by
    have moment := burnolCompactCenteredMobiusInverse_reciprocalMoment source
    simp_rw [burnolCompactCenteredMobiusInverse_roundtrip] at moment
    rw [burnolCompactAdditiveCoSum_eq_neg_normalization_of_abs_le_quarter
      source (t := 0) (by norm_num)] at moment
    simpa only [neg_neg] using moment
  have productIntegrable : Integrable
      (fun x : ℝ => test x * burnolCompactAdditiveCoSum source x) :=
    (test.memLp 2 volume).integrable_mul (burnolCompactAdditiveCoSum_memLp_full source)
  have constantIntegrable : Integrable (fun x : ℝ => normal * test x) :=
    test.integrable.const_mul normal
  have forwardIntegrable : Integrable (fun x : ℝ => test x * forward x) := by
    refine (productIntegrable.add constantIntegrable).congr (ae_of_all volume fun x => ?_)
    change test x * (forward x - normal) + normal * test x = test x * forward x
    ring
  rw [halfRead]
  calc
    _ = ∫ u : ℝ in Ioi 0, g u * coPoissonMuntzThetaNonzero test u -
        (∫ x : ℝ, test x) * ((u : ℂ)⁻¹ * g u) := by
      apply setIntegral_congr_fun measurableSet_Ioi
      intro u hu
      dsimp only
      rw [coPoissonMuntzScaleRemainder_eq test hu]
      simp only [real_smul, Complex.ofReal_inv]
      ring
    _ = (∫ u : ℝ in Ioi 0, g u * coPoissonMuntzThetaNonzero test u) -
        (∫ x : ℝ, test x) * normal := by
      rw [integral_sub thetaIntegrable (invIntegrable.const_mul _),
        integral_const_mul, invMoment]
    _ = (∫ x : ℝ, test x * forward x) - normal * (∫ x : ℝ, test x) := by
      rw [← thetaRead, mul_comm (∫ x : ℝ, test x) normal]
    _ = ∫ x : ℝ, test x * forward x - normal * test x := by
      rw [integral_sub forwardIntegrable constantIntegrable, integral_const_mul]
    _ = _ := by
      apply integral_congr_ae
      filter_upwards with x
      change test x * forward x - normal * test x = test x * (forward x - normal)
      ring

end
end NoIslandNoMagic.CanonicalRiemann.ClozelGeneralizedDual.BurnolPhysicalState
