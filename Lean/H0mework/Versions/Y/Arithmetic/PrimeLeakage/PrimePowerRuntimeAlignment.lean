open RootGeneratedCanonicalUnitArithmeticPrimePowerCofinalClosure
open Character.GlobalCoPoissonCurrent
open ClozelGeneralizedDual.CenteredGram.IntegralGraphJointAction
open ClozelGeneralizedDual.ThetaJRoleRepresentation
open SourceGeneratedIntegralCharacterGroupRing
open SourceGeneratedIntegralCoherentJointAction
open SourceGeneratedPositiveRealCharacter

noncomputable section

/-- Numerical scale generated by one positive prime-power receipt. -/
def primePowerRuntimeScale
    (prime : Nat.Primes) (exponent : Nat) : Nat :=
  (prime : Nat) ^ exponent

/-- Q-rich runtime stage whose square-root scale is `p^k`. -/
def primePowerRuntimeStage
    (prime : Nat.Primes) (exponent : Nat) : Nat :=
  (primePowerRuntimeScale prime exponent) ^ 2 - 3

theorem primePowerRuntimeScale_two_le
    (prime : Nat.Primes) (exponent : Nat) (positive : 0 < exponent) :
    2 ≤ primePowerRuntimeScale prime exponent := by
  unfold primePowerRuntimeScale
  exact prime.property.two_le.trans (Nat.le_pow positive)

theorem primePowerRuntimeStage_add_three
    (prime : Nat.Primes) (exponent : Nat) (positive : 0 < exponent) :
    primePowerRuntimeStage prime exponent + 3 =
      (primePowerRuntimeScale prime exponent) ^ 2 := by
  unfold primePowerRuntimeStage
  apply Nat.sub_add_cancel
  have scaleTwo := primePowerRuntimeScale_two_le prime exponent positive
  nlinarith

theorem primePowerRuntimeStage_qRichScale
    (prime : Nat.Primes) (exponent : Nat) (positive : 0 < exponent) :
    QRich.blockQRichSuccessorScale
        (primePowerRuntimeStage prime exponent) =
      (primePowerRuntimeScale prime exponent) ^ 2 := by
  rw [QRich.blockQRichSuccessorScale_eq_stage_add_three,
    primePowerRuntimeStage_add_three prime exponent positive]

theorem primePowerRuntimeStage_scaleUnit
    (prime : Nat.Primes) (exponent : Nat) (positive : 0 < exponent) :
    stageSqrtScaleUnit (primePowerRuntimeStage prime exponent) =
      primePowerUnit prime exponent := by
  apply Units.ext
  apply NNReal.eq
  rw [stageSqrtScaleUnit, primePowerUnit,
    positiveRealUnit_val, positiveRealUnit_val]
  rw [primePowerRuntimeStage_qRichScale prime exponent positive]
  change Real.sqrt (((primePowerRuntimeScale prime exponent) ^ 2 : Nat) : ℝ) =
    (primePowerRuntimeScale prime exponent : ℝ)
  push_cast
  rw [Real.sqrt_sq_eq_abs]
  exact abs_of_pos (by
    exact_mod_cast lt_of_lt_of_le Nat.zero_lt_two
      (primePowerRuntimeScale_two_le prime exponent positive))

/-- The paired joint source boundary at the generated prime-power scale has
the literal integral before/after read `delta 1 - delta_(p^k)`. -/
theorem primePowerSourceBoundary_integralFace
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (prime : Nat.Primes) (exponent : Nat) (positive : 0 < exponent) :
    let input := pairedJointInput observation nontrivial
      (stageSqrtScaleUnit (primePowerRuntimeStage prime exponent))
    input.integralFace (input.sourceBoundary (delta 1)) =
      delta 1 - delta (primePowerUnit prime exponent) := by
  dsimp only
  rw [Input.sourceBoundary_integralFace]
  change delta (1 : Units NNReal) -
      leftTranslation
        (stageSqrtScaleUnit (primePowerRuntimeStage prime exponent))
        (delta (1 : Units NNReal)) = _
  rw [primePowerRuntimeStage_scaleUnit prime exponent positive,
    leftTranslation_delta, mul_one]

/-- The same `(p,k)` parameters come from an actual arithmetic cofinal
receipt; no prime-power table is supplied by the runtime alignment. -/
theorem primePowerRuntime_actualReceipt
    (prime : Nat.Primes) (exponent : Nat) (positive : 0 < exponent) :
    type_of% (requested_row_generated prime exponent positive) :=
  requested_row_generated prime exponent positive

end
