import H0mework.Versions.Y.Arithmetic.FockState.ParityMeasurement
import H0mework.Versions.Y.Arithmetic.FockState.AtomicSpecies

/-!
# Atomic species as the prime face of the Z/2 detector

The `two | odd` atom classification and the ordered parity detector are not
parallel labels.  On every classifier-generated prime atom, its species is
exactly the corresponding Z/2 coordinate.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalArithmeticState

open CanonicalUnitArithmeticEffectiveFactorRepairOrbitProducer
open ParticleWaveFock
open ParticleWaveFockAtomicSpecies

namespace ParticleWaveFockAtomicSpecies

noncomputable section

def AtomicSpecies.grade : AtomicSpecies → ParticleWaveFock.SpeciesGrade
  | .two => 0
  | .odd => 1

/-- The atom species generated by the endpoint classifier is the same
coordinate read by the arithmetic Z/2 detector. -/
theorem PrimeAtomAt.endpointSpeciesGrade_eq
    {value : Nat} (atom : PrimeAtomAt value) :
    ParticleWaveFock.endpointSpeciesGrade value = atom.species.grade := by
  cases species_eq : atom.species with
  | two =>
      have value_eq := atom.value_eq_two species_eq
      subst value
      exact ZMod.natCast_self 2
  | odd =>
      have value_odd := atom.value_odd species_eq
      apply (ParticleWaveFock.endpointSpeciesGrade_eq_iff_mod value 1).mpr
      rcases value_odd with ⟨half, value_eq⟩
      omega

/-- A prime terminal forces both generated endpoint classifications into the
atom branch; no decay witness is inserted by this bridge. -/
theorem generatedOrderedClassification_terminal_atoms
    {index : Nat} (state : EffectiveSplitAt index)
    (terminal : PrimePairTerminalAt state) :
    (∃ leftAtom : PrimeAtomAt (splitLeft state),
      (generatedOrderedClassification state).left = .atom leftAtom) ∧
    (∃ rightAtom : PrimeAtomAt (splitRight state),
      (generatedOrderedClassification state).right = .atom rightAtom) := by
  constructor
  · let endpoint : PrimeEndpointAt (splitLeft state) :=
      ⟨terminal.leftPrime⟩
    let atom := generatedPrimeAtom endpoint
    refine ⟨atom, ?_⟩
    change generatedAtomOrDecay (splitLeft state)
        (splitLeft_atLeastTwo state) = .atom atom
    exact generatedAtomOrDecay_eq_atom_of_classifier _ endpoint
      (generatedPrimeOrFactor_eq_prime _ _ terminal.leftPrime)
  · let endpoint : PrimeEndpointAt (splitRight state) :=
      ⟨terminal.rightPrime⟩
    let atom := generatedPrimeAtom endpoint
    refine ⟨atom, ?_⟩
    change generatedAtomOrDecay (splitRight state)
        (splitRight_atLeastTwo state) = .atom atom
    exact generatedAtomOrDecay_eq_atom_of_classifier _ endpoint
      (generatedPrimeOrFactor_eq_prime _ _ terminal.rightPrime)

/-- At a terminal, the ordered atom species and the ordered detector grade
are literally the same dependent readout. -/
theorem terminal_orderedSpeciesGrade_eq_atomGrades
    {index : Nat} (state : EffectiveSplitAt index)
    (terminal : PrimePairTerminalAt state) :
    ∃ leftAtom : PrimeAtomAt (splitLeft state),
      ∃ rightAtom : PrimeAtomAt (splitRight state),
        (generatedOrderedClassification state).left = .atom leftAtom ∧
        (generatedOrderedClassification state).right = .atom rightAtom ∧
        ParticleWaveFock.orderedSpeciesGrade state =
          (leftAtom.species.grade, rightAtom.species.grade) := by
  rcases generatedOrderedClassification_terminal_atoms state terminal with
    ⟨⟨leftAtom, leftEq⟩, ⟨rightAtom, rightEq⟩⟩
  refine ⟨leftAtom, rightAtom, leftEq, rightEq, ?_⟩
  apply Prod.ext
  · exact leftAtom.endpointSpeciesGrade_eq
  · exact rightAtom.endpointSpeciesGrade_eq

end

end ParticleWaveFockAtomicSpecies
end CanonicalArithmeticState
end NoIslandNoMagic
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
