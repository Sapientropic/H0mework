import H0mework.Versions.Y.Arithmetic.RiemannDivision.BareRiemannZeroLocalizedAction

/-!
# Xi localization at the analytic complement

The functional equation transports the full zero order and its first
nonvanishing localized coefficient from `s` to `1-s`.  The parity sign and
Gamma ratio are generated by the same analytic occurrence; no simplicity
premise is used.
-/

set_option autoImplicit false
set_option maxHeartbeats 1000000

namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace NoIslandNoMagic.CanonicalRiemann

open Complex Filter Topology
open CanonicalUnitArithmeticCoordinateProjectionObstruction

noncomputable section

private theorem generatedRiemannXi_analyticOrderAt_eq_zeroOrder
    (owner : GlobalGermOwner) (coordinate : ℂ) :
    analyticOrderAt (generatedRiemannXi owner) coordinate =
      (generatedRiemannXiZeroOrder owner coordinate : ℕ∞) := by
  apply ((differentiable_generatedRiemannXi owner).analyticAt coordinate
    ).analyticOrderAt_eq_natCast.mpr
  refine ⟨generatedRiemannXiZeroLocalization owner coordinate, ?_,
    generatedRiemannXiZeroLocalization_at_ne_zero owner coordinate, ?_⟩
  · exact ((generatedRiemannXi_hasFPowerSeriesAt owner coordinate
      ).has_fpower_series_iterate_dslope_fslope
        (generatedRiemannXiZeroOrder owner coordinate)).analyticAt
  · filter_upwards with value
    simpa only [smul_eq_mul] using
      generatedRiemannXi_factorization owner coordinate value

/-- The analytic complement has exactly the selected Xi zero order. -/
theorem generatedRiemannXiZeroOrder_one_sub
    (owner : GlobalGermOwner) (coordinate : ℂ) :
    generatedRiemannXiZeroOrder owner (1 - coordinate) =
      generatedRiemannXiZeroOrder owner coordinate := by
  let complementMap : ℂ → ℂ := fun value => 1 - value
  have complementAnalytic : AnalyticAt ℂ complementMap (1 - coordinate) := by
    dsimp [complementMap]
    fun_prop
  have complementDeriv : deriv complementMap (1 - coordinate) ≠ 0 := by
    have derivRead : HasDerivAt complementMap (-1) (1 - coordinate) := by
      simpa [complementMap] using
        (hasDerivAt_id (𝕜 := ℂ) (1 - coordinate)).const_sub (1 : ℂ)
    rw [derivRead.deriv]
    norm_num
  have compositionOrder := analyticOrderAt_comp_of_deriv_ne_zero
    (f := generatedRiemannXi owner) complementAnalytic complementDeriv
  have functionEq : generatedRiemannXi owner ∘ complementMap =
      generatedRiemannXi owner := by
    funext value
    exact generatedRiemannXi_one_sub owner value
  rw [functionEq] at compositionOrder
  have complementMapAt : complementMap (1 - coordinate) = coordinate := by
    simp [complementMap]
  rw [complementMapAt,
    generatedRiemannXi_analyticOrderAt_eq_zeroOrder,
    generatedRiemannXi_analyticOrderAt_eq_zeroOrder] at compositionOrder
  exact ENat.natCast_inj.mp compositionOrder

/-- The first nonzero Xi coefficient at `1-s` is the coefficient at `s`
with the exact parity sign forced by the affine involution. -/
theorem generatedRiemannXiZeroLocalization_one_sub_at
    (owner : GlobalGermOwner) (coordinate : ℂ) :
    generatedRiemannXiZeroLocalization owner (1 - coordinate)
        (1 - coordinate) =
      (-1 : ℂ) ^ generatedRiemannXiZeroOrder owner coordinate *
        generatedRiemannXiZeroLocalization owner coordinate coordinate := by
  let complement := 1 - coordinate
  let order := generatedRiemannXiZeroOrder owner coordinate
  let nearby : ℕ → ℂ := fun n => complement + 1 / ((n : ℂ) + 1)
  have nearbyTendsto : Tendsto nearby atTop (nhds complement) := by
    have constantTendsto : Tendsto (fun _ : ℕ => complement) atTop
        (nhds complement) := tendsto_const_nhds
    have inverseTendsto :
        Tendsto (fun n : ℕ => 1 / ((n : ℂ) + 1)) atTop (nhds 0) :=
      tendsto_one_div_add_atTop_nhds_zero_nat
    simpa only [nearby, add_zero] using constantTendsto.add inverseTendsto
  have nearbyNe (n : ℕ) : nearby n ≠ complement := by
    dsimp only [nearby]
    intro equality
    have inverseZero : (1 / ((n : ℂ) + 1)) = 0 := by
      linear_combination equality
    exact one_div_ne_zero
      (by exact_mod_cast Nat.succ_ne_zero n) inverseZero
  have valueEq (n : ℕ) :
      generatedRiemannXiZeroLocalization owner complement (nearby n) =
        (-1 : ℂ) ^ order *
          generatedRiemannXiZeroLocalization owner coordinate
            (1 - nearby n) := by
    have complementOrder :
        generatedRiemannXiZeroOrder owner complement = order :=
      generatedRiemannXiZeroOrder_one_sub owner coordinate
    have factorComplement :=
      generatedRiemannXi_factorization owner complement (nearby n)
    have factorOriginal :=
      generatedRiemannXi_factorization owner coordinate (1 - nearby n)
    have combined :
        (nearby n - complement) ^ order *
            generatedRiemannXiZeroLocalization owner complement (nearby n) =
          (nearby n - complement) ^ order *
            ((-1 : ℂ) ^ order *
              generatedRiemannXiZeroLocalization owner coordinate
                (1 - nearby n)) := by
      calc
        _ = generatedRiemannXi owner (nearby n) := by
          rw [← complementOrder]
          exact factorComplement.symm
        _ = generatedRiemannXi owner (1 - nearby n) :=
          (generatedRiemannXi_one_sub owner (nearby n)).symm
        _ = ((1 - nearby n) - coordinate) ^ order *
              generatedRiemannXiZeroLocalization owner coordinate
                (1 - nearby n) := factorOriginal
        _ = (nearby n - complement) ^ order *
            ((-1 : ℂ) ^ order *
              generatedRiemannXiZeroLocalization owner coordinate
                (1 - nearby n)) := by
          have baseEq : (1 - nearby n) - coordinate =
              -(nearby n - complement) := by
            dsimp only [complement]
            ring
          rw [baseEq, neg_pow]
          ring
    exact mul_left_cancel₀
      (pow_ne_zero order (sub_ne_zero.mpr (nearbyNe n))) combined
  have leftTendsto : Tendsto
      (fun n => generatedRiemannXiZeroLocalization owner complement (nearby n))
      atTop
      (nhds (generatedRiemannXiZeroLocalization owner complement complement)) :=
    (((generatedRiemannXi_hasFPowerSeriesAt owner complement
      ).has_fpower_series_iterate_dslope_fslope
        (generatedRiemannXiZeroOrder owner complement)).continuousAt.tendsto
      ).comp nearbyTendsto
  have reflectedTendsto : Tendsto (fun n => 1 - nearby n) atTop
      (nhds coordinate) := by
    have oneTendsto : Tendsto (fun _ : ℕ => (1 : ℂ)) atTop (nhds 1) :=
      tendsto_const_nhds
    have target := oneTendsto.sub nearbyTendsto
    simpa only [complement, sub_sub_cancel] using target
  have localizationTendsto : Tendsto
      (fun n => generatedRiemannXiZeroLocalization owner coordinate
        (1 - nearby n)) atTop
      (nhds (generatedRiemannXiZeroLocalization owner coordinate coordinate)) :=
    (((generatedRiemannXi_hasFPowerSeriesAt owner coordinate
      ).has_fpower_series_iterate_dslope_fslope order).continuousAt.tendsto
      ).comp reflectedTendsto
  have rightTendsto : Tendsto
      (fun n => (-1 : ℂ) ^ order *
        generatedRiemannXiZeroLocalization owner coordinate (1 - nearby n))
      atTop
      (nhds ((-1 : ℂ) ^ order *
        generatedRiemannXiZeroLocalization owner coordinate coordinate)) :=
    tendsto_const_nhds.mul localizationTendsto
  have functionsEq :
      (fun n => generatedRiemannXiZeroLocalization owner complement (nearby n)) =
        fun n => (-1 : ℂ) ^ order *
          generatedRiemannXiZeroLocalization owner coordinate
            (1 - nearby n) := by
    funext n
    exact valueEq n
  rw [functionsEq] at leftTendsto
  exact tendsto_nhds_unique leftTendsto rightTendsto

/-- Exact bare-zeta leading coordinate at the analytic complement. -/
theorem generatedRiemannBareZeroLocalizedSpectrum_one_sub_at
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    generatedRiemannBareZeroLocalizedSpectrum owner
        (1 - observation.coordinate) (1 - observation.coordinate) =
      (-1 : ℂ) ^ generatedRiemannXiZeroOrder owner observation.coordinate *
        (Gammaℝ observation.coordinate / Gammaℝ (1 - observation.coordinate)) *
          generatedRiemannBareZeroLocalizedSpectrum owner
            observation.coordinate observation.coordinate := by
  have coordinateNe : observation.coordinate ≠ 0 :=
    observation.coordinate_ne_zero
  have coordinateNeOne : observation.coordinate ≠ 1 := by
    intro equality
    have below := observation.coordinate_re_lt_one
    rw [equality] at below
    norm_num at below
  have complementNe : 1 - observation.coordinate ≠ 0 :=
    sub_ne_zero.mpr coordinateNeOne.symm
  have gammaSelectedNe : Gammaℝ observation.coordinate ≠ 0 :=
    observation.gammaReal_ne_zero_of_nontrivial nontrivial
  have gammaComplementNe : Gammaℝ (1 - observation.coordinate) ≠ 0 := by
    apply Gammaℝ_ne_zero_of_re_pos
    simp only [Complex.sub_re, Complex.one_re]
    linarith [observation.coordinate_re_lt_one]
  unfold generatedRiemannBareZeroLocalizedSpectrum
  rw [generatedRiemannXiZeroLocalization_one_sub_at]
  have oneSubComplement : 1 - (1 - observation.coordinate) =
      observation.coordinate := by ring
  rw [oneSubComplement]
  field_simp [coordinateNe, coordinateNeOne, complementNe,
    gammaSelectedNe, gammaComplementNe]

theorem generatedRiemannBareZeroLocalizedSpectrum_one_sub_at_ne_zero
    {owner : GlobalGermOwner}
    (observation : GeneratedRiemannZeroObservationAt owner)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    generatedRiemannBareZeroLocalizedSpectrum owner
        (1 - observation.coordinate) (1 - observation.coordinate) ≠ 0 := by
  rw [generatedRiemannBareZeroLocalizedSpectrum_one_sub_at
    observation nontrivial]
  apply mul_ne_zero
  · exact mul_ne_zero (pow_ne_zero _ (by norm_num))
      (div_ne_zero
        (observation.gammaReal_ne_zero_of_nontrivial nontrivial)
        (Gammaℝ_ne_zero_of_re_pos (by
          simp only [Complex.sub_re, Complex.one_re]
          linarith [observation.coordinate_re_lt_one])))
  · exact generatedRiemannBareZeroLocalizedSpectrum_at_ne_zero
      observation nontrivial

end
end NoIslandNoMagic.CanonicalRiemann
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
