            (relation (source : SonineSchwartz))) = 0 := by
    simpa [z, positive, belowHalf, feature, functional, relation,
      relationPoint, CenteredGram.reversalRieszGraphTargetState,
      CenteredGram.reversalRieszGraphHilbertState,
      CenteredGram.reversalRelationGraphMap,
      relationGraphMap, graphSourceMap] using realizedOrth
  rw [WithLp.prod_inner_apply] at targetOrth
  have scalarZero :=
    stageZeroBalancedSonineSource_reversal_annihilation
      observation nontrivial source
  change
    inner ℂ
        (CenteredGram.reversalRieszGraphTargetState observation nontrivial).fst
        (feature (relation (source : SonineSchwartz))) +
      inner ℂ
        (CenteredGram.reversalRieszGraphTargetState observation nontrivial).snd
        (functional (relation (source : SonineSchwartz))) = 0 at targetOrth
  have scalarZero' :
      functional (relation (source : SonineSchwartz)) = 0 := by
    change mellin (positiveMellinExtension
      (coPoissonQuarterMellinMap (source : SonineSchwartz))) z = 0
    change mellin (positiveMellinExtension
      (coPoissonQuarterMellinMap (source : SonineSchwartz)))
        (coordinateReversal observation.coordinate / 2) = 0 at scalarZero
    simpa [z, reversalCoPoissonMuntzParameter] using scalarZero
  rw [scalarZero', inner_zero_right, add_zero] at targetOrth
  rw [show feature (relation (source : SonineSchwartz)) =
      coPoissonQuarterEnergyMap (source : SonineSchwartz) by
    exact (coPoissonQuarterEnergyMap_eq_feature
      z positive belowHalf (source : SonineSchwartz)).symm] at targetOrth
  exact targetOrth

theorem reversalStageZeroJointEnergy_mem_balancedOrthogonalFace
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    (CenteredGram.reversalStageZeroJointState observation nontrivial).fst ∈
      stageZeroBalancedQuarterEnergyOrthogonalFace := by
  change (CenteredGram.reversalStageZeroJointState observation nontrivial).fst ∈
    Submodule.orthogonal
      (LinearMap.range stageZeroBalancedQuarterEnergyMap).topologicalClosure
  rw [Submodule.orthogonal_closure]
  rintro _ ⟨source, rfl⟩
  have zero := reversalRieszEnergy_inner_balancedSource_zero
    observation nontrivial source
  have conjugated := congrArg (starRingEnd ℂ) zero
  simpa [CenteredGram.reversalStageZeroJointState,
    inner_conj_symm] using conjugated

end

