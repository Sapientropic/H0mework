import H0mework.Versions.Y.Arithmetic.RiemannGraph.StageZeroCenteredGramDisposition
import H0mework.Versions.Y.Arithmetic.SonineSource.BalancedSonineEnergyFace

/-!
# Zero-owned states in the common balanced energy face

The selected and reversal graph Riesz states already generated by the same
zero occurrence have energy coordinates orthogonal to the same
parameter-independent balanced co-Poisson closure.  No realization map,
nonzero coordinate, or bounded evaluator is supplied as a premise.
-/

set_option autoImplicit false
set_option maxHeartbeats 3000000

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalRiemann
namespace ClozelGeneralizedDual

open Complex FourierTransform MeasureTheory
open CanonicalUnitArithmeticCoordinateProjectionObstruction
open SourceGeneratedFunctionalGraphCokernel
open SourceGeneratedFunctionalGraphPerfectification
open SourceGeneratedHilbertCokernel
open scoped SchwartzMap RealInnerProductSpace

noncomputable section

theorem selectedRieszEnergy_inner_balancedSource_zero
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (source : StageZeroBalancedSonineSource) :
    inner ℂ
        (CenteredGram.selectedRieszGraphTargetState
          observation nontrivial).fst
        (stageZeroBalancedQuarterEnergyMap source) = 0 := by
  let z := selectedCoPoissonMuntzParameter observation
  let positive := selectedCoPoissonMuntzParameter_re_pos observation nontrivial
  let belowHalf := selectedCoPoissonMuntzParameter_re_lt_half observation nontrivial
  let feature := quarterMellinL2Feature z
  let functional := quarterMellinL2Functional z
  let relation := coPoissonQuarterMellinConvergentMap z positive belowHalf
  let relationPoint := CenteredGram.selectedRelationGraphMap
    observation nontrivial (source : SonineSchwartz)
  have relationMem : relationPoint ∈
      SourceGeneratedHilbertCokernel.closedRange
        (CenteredGram.selectedRelationGraphMap observation nontrivial) := by
    exact (LinearMap.range
      (CenteredGram.selectedRelationGraphMap observation nontrivial)).le_topologicalClosure
        ⟨(source : SonineSchwartz), rfl⟩
  have graphOrth :
      inner ℂ
          (CenteredGram.selectedRieszOrthogonalRepresentative
            observation nontrivial :
              GraphHilbertAmbient feature functional)
          relationPoint = 0 :=
    Submodule.inner_left_of_mem_orthogonal relationMem
      (CenteredGram.selectedRieszOrthogonalRepresentative
        observation nontrivial).property
  have realizedOrth :
      inner ℂ
          (graphHilbertAmbientRealization feature functional
            (CenteredGram.selectedRieszOrthogonalRepresentative
              observation nontrivial))
          (graphHilbertAmbientRealization feature functional relationPoint) = 0 := by
    rw [LinearIsometry.inner_map_map]
    exact graphOrth
  have targetOrth :
      inner ℂ
          (CenteredGram.selectedRieszGraphTargetState observation nontrivial)
          (graphFeature feature functional
            (relation (source : SonineSchwartz))) = 0 := by
    simpa [z, positive, belowHalf, feature, functional, relation,
      relationPoint, CenteredGram.selectedRieszGraphTargetState,
      CenteredGram.selectedRieszGraphHilbertState,
      CenteredGram.selectedRelationGraphMap,
      relationGraphMap, graphSourceMap] using realizedOrth
  rw [WithLp.prod_inner_apply] at targetOrth
  have scalarZero :=
    stageZeroBalancedSonineSource_selected_annihilation
      observation nontrivial source
  change
    inner ℂ
        (CenteredGram.selectedRieszGraphTargetState observation nontrivial).fst
        (feature (relation (source : SonineSchwartz))) +
      inner ℂ
        (CenteredGram.selectedRieszGraphTargetState observation nontrivial).snd
        (functional (relation (source : SonineSchwartz))) = 0 at targetOrth
  have scalarZero' :
      functional (relation (source : SonineSchwartz)) = 0 := by
    change mellin (positiveMellinExtension
      (coPoissonQuarterMellinMap (source : SonineSchwartz))) z = 0
    change mellin (positiveMellinExtension
      (coPoissonQuarterMellinMap (source : SonineSchwartz)))
        (observation.coordinate / 2) = 0 at scalarZero
    simpa [z, selectedCoPoissonMuntzParameter] using scalarZero
  rw [scalarZero', inner_zero_right, add_zero] at targetOrth
  rw [show feature (relation (source : SonineSchwartz)) =
      coPoissonQuarterEnergyMap (source : SonineSchwartz) by
    exact (coPoissonQuarterEnergyMap_eq_feature
      z positive belowHalf (source : SonineSchwartz)).symm] at targetOrth
  exact targetOrth

theorem selectedStageZeroJointEnergy_mem_balancedOrthogonalFace
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    (CenteredGram.selectedStageZeroJointState observation nontrivial).fst ∈
      stageZeroBalancedQuarterEnergyOrthogonalFace := by
  change (CenteredGram.selectedStageZeroJointState observation nontrivial).fst ∈
    Submodule.orthogonal
      (LinearMap.range stageZeroBalancedQuarterEnergyMap).topologicalClosure
  rw [Submodule.orthogonal_closure]
  rintro _ ⟨source, rfl⟩
  have zero := selectedRieszEnergy_inner_balancedSource_zero
    observation nontrivial source
  have conjugated := congrArg (starRingEnd ℂ) zero
  simpa [CenteredGram.selectedStageZeroJointState,
    inner_conj_symm] using conjugated

theorem reversalRieszEnergy_inner_balancedSource_zero
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (source : StageZeroBalancedSonineSource) :
    inner ℂ
        (CenteredGram.reversalRieszGraphTargetState
          observation nontrivial).fst
