noncomputable section

local instance stageZeroBalancedEnergyFaceComplete :
    CompleteSpace StageZeroBalancedQuarterEnergyOrthogonalCarrier := by
  apply IsComplete.completeSpace_coe
  exact stageZeroBalancedQuarterEnergyOrthogonalFace.isClosed.isComplete

/-- Reflection preserves the common orthogonal face because it comes from
the same invertible source-Fourier square. -/
theorem stageZeroBalancedQuarterEnergyOrthogonal_isBalanced :
    IsBalancedFace stageZeroBalancedQuarterEnergyOrthogonalFace
      positiveMellinQuarterEnergyReflectionIsometry where
  map_eq := by
    exact stageZeroBalancedQuarterFourierSquare.map_orthogonalResidual_eq

/-- Reflection reverses every logarithmic half-density translation. -/
theorem positiveMellinQuarterEnergyReflection_translation
    (shift : ℝ) (value : PositiveMellinQuarterEnergy) :
    positiveMellinQuarterEnergyReflectionIsometry
        (positiveMellinQuarterEnergyTranslationIsometry shift value) =
      positiveMellinQuarterEnergyTranslationIsometry (-shift)
        (positiveMellinQuarterEnergyReflectionIsometry value) := by
  change Lp.compMeasurePreserving (fun x : ℝ => -x)
      (Measure.measurePreserving_neg (volume : Measure ℝ))
      (Lp.compMeasurePreserving (fun x : ℝ => shift + x)
        (measurePreserving_add_left (volume : Measure ℝ) shift) value) =
    Lp.compMeasurePreserving (fun x : ℝ => -shift + x)
      (measurePreserving_add_left (volume : Measure ℝ) (-shift))
      (Lp.compMeasurePreserving (fun x : ℝ => -x)
        (Measure.measurePreserving_neg (volume : Measure ℝ)) value)
  rw [← Lp.compMeasurePreserving_comp_apply value
      (measurePreserving_add_left (volume : Measure ℝ) shift)
      (Measure.measurePreserving_neg (volume : Measure ℝ)),
    ← Lp.compMeasurePreserving_comp_apply value
      (Measure.measurePreserving_neg (volume : Measure ℝ))
      (measurePreserving_add_left (volume : Measure ℝ) (-shift))]
  apply Lp.ext
  filter_upwards [
    Lp.coeFn_compMeasurePreserving value
      ((measurePreserving_add_left (volume : Measure ℝ) shift).comp
        (Measure.measurePreserving_neg (volume : Measure ℝ))),
    Lp.coeFn_compMeasurePreserving value
      ((Measure.measurePreserving_neg (volume : Measure ℝ)).comp
        (measurePreserving_add_left (volume : Measure ℝ) (-shift)))] with x left right
  rw [left, right]
  simp only [Function.comp_apply]
  congr 1
  ring

theorem stageZeroSonineQ_eq_stageZeroSqrtScale :
    stageZeroSonineQ = CenteredGram.stageZeroSqrtScale := by
  unfold stageZeroSonineQ CenteredGram.stageZeroSqrtScale
  rw [QRich.blockQRichSuccessorScale_eq_stage_add_three]
  norm_num

/-- Actual ambient unitary at the first q-rich scale. -/
def stageZeroSonineEnergyDilation :
    PositiveMellinQuarterEnergy ≃ₗᵢ[ℂ] PositiveMellinQuarterEnergy :=
  positiveMellinQuarterEnergyTranslationIsometry (Real.log stageZeroSonineQ)

/-- Orthogonal compression of the actual unitary to the common balanced
zero-spectral face. -/
def stageZeroSonineEnergyCompression :
    StageZeroBalancedQuarterEnergyOrthogonalCarrier →L[ℂ]
      StageZeroBalancedQuarterEnergyOrthogonalCarrier :=
  compression stageZeroBalancedQuarterEnergyOrthogonalFace
    stageZeroSonineEnergyDilation.toLinearIsometry

theorem stageZeroSonineEnergyCompression_contractive
    (value : StageZeroBalancedQuarterEnergyOrthogonalCarrier) :
    ‖stageZeroSonineEnergyCompression value‖ ≤ ‖value‖ :=
  norm_compression_le stageZeroBalancedQuarterEnergyOrthogonalFace
    stageZeroSonineEnergyDilation.toLinearIsometry value

/-- Fourier/J on the common face intertwines the compression with its actual
Hilbert adjoint. -/
theorem stageZeroSonineEnergyCompression_J_adjoint
    (value : StageZeroBalancedQuarterEnergyOrthogonalCarrier) :
    balancedFaceEquiv stageZeroBalancedQuarterEnergyOrthogonalFace
        positiveMellinQuarterEnergyReflectionIsometry
        stageZeroBalancedQuarterEnergyOrthogonal_isBalanced
        (stageZeroSonineEnergyCompression value) =
      ContinuousLinearMap.adjoint stageZeroSonineEnergyCompression
        (balancedFaceEquiv stageZeroBalancedQuarterEnergyOrthogonalFace
          positiveMellinQuarterEnergyReflectionIsometry
          stageZeroBalancedQuarterEnergyOrthogonal_isBalanced value) := by
  exact compression_J_adjoint_sibling
    stageZeroBalancedQuarterEnergyOrthogonalFace
    stageZeroSonineEnergyDilation
    positiveMellinQuarterEnergyReflectionIsometry
    stageZeroBalancedQuarterEnergyOrthogonal_isBalanced
    (positiveMellinQuarterEnergyReflection_translation
      (Real.log stageZeroSonineQ)) value

/-- Selected zero-owned energy coordinate in the common compressed face. -/
def selectedStageZeroBalancedEnergyState
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    StageZeroBalancedQuarterEnergyOrthogonalCarrier :=
  ⟨(CenteredGram.selectedStageZeroJointState observation nontrivial).fst,
    selectedStageZeroJointEnergy_mem_balancedOrthogonalFace
      observation nontrivial⟩

/-- Reversal zero-owned energy coordinate in the identical face. -/
def reversalStageZeroBalancedEnergyState
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    StageZeroBalancedQuarterEnergyOrthogonalCarrier :=
  ⟨(CenteredGram.reversalStageZeroJointState observation nontrivial).fst,
    reversalStageZeroJointEnergy_mem_balancedOrthogonalFace
      observation nontrivial⟩

@[simp] theorem selectedStageZeroBalancedEnergyState_coe
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    (selectedStageZeroBalancedEnergyState observation nontrivial :
      PositiveMellinQuarterEnergy) =
        (CenteredGram.selectedStageZeroJointState observation nontrivial).fst :=
  rfl

@[simp] theorem reversalStageZeroBalancedEnergyState_coe
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    (reversalStageZeroBalancedEnergyState observation nontrivial :
      PositiveMellinQuarterEnergy) =
        (CenteredGram.reversalStageZeroJointState observation nontrivial).fst :=
  rfl

/-- Existing zero-owned stationarity becomes the exact diagonal readback of
the actual common-face compression.  This is deliberately weaker than a
full adjoint eigenlaw. -/
theorem selectedStageZeroSonineCompression_expectation
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    inner ℂ (selectedStageZeroBalancedEnergyState observation nontrivial)
        (stageZeroSonineEnergyCompression
          (selectedStageZeroBalancedEnergyState observation nontrivial)) =
      CenteredGram.selectedStageZeroRawRieszTarget observation nontrivial *
        inner ℂ
          (selectedStageZeroBalancedEnergyState observation nontrivial)
          (selectedStageZeroBalancedEnergyState observation nontrivial) := by
  unfold stageZeroSonineEnergyCompression
  rw [compression_inner_right_readback]
  change inner ℂ
      (CenteredGram.selectedStageZeroJointState observation nontrivial).fst
      (positiveMellinQuarterEnergyTranslationIsometry
        (Real.log stageZeroSonineQ)
        (CenteredGram.selectedStageZeroJointState observation nontrivial).fst) = _
  rw [stageZeroSonineQ_eq_stageZeroSqrtScale]
  exact CenteredGram.IntegralGraphJointAction.selectedRieszEnergy_expectation
    observation nontrivial

theorem reversalStageZeroSonineCompression_expectation
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1)) :
    inner ℂ (reversalStageZeroBalancedEnergyState observation nontrivial)
        (stageZeroSonineEnergyCompression
          (reversalStageZeroBalancedEnergyState observation nontrivial)) =
      CenteredGram.reversalStageZeroRawRieszTarget observation nontrivial *
        inner ℂ
          (reversalStageZeroBalancedEnergyState observation nontrivial)
          (reversalStageZeroBalancedEnergyState observation nontrivial) := by
  unfold stageZeroSonineEnergyCompression
  rw [compression_inner_right_readback]
  change inner ℂ
      (CenteredGram.reversalStageZeroJointState observation nontrivial).fst
      (positiveMellinQuarterEnergyTranslationIsometry
        (Real.log stageZeroSonineQ)
        (CenteredGram.reversalStageZeroJointState observation nontrivial).fst) = _
  rw [stageZeroSonineQ_eq_stageZeroSqrtScale]
  exact CenteredGram.IntegralGraphJointAction.reversalRieszEnergy_expectation
    observation nontrivial

/-- Contractivity plus a nonzero diagonal character readback already bounds
the character.  A full eigenvector equation is unnecessary for this step. -/
theorem character_norm_le_one_of_compression_expectation
    (value : StageZeroBalancedQuarterEnergyOrthogonalCarrier)
    (character : ℂ) (nonzero : value ≠ 0)
    (expectation :
      inner ℂ value (stageZeroSonineEnergyCompression value) =
        character * inner ℂ value value) :
    ‖character‖ ≤ 1 := by
  have valueNormPos : 0 < ‖value‖ := norm_pos_iff.mpr nonzero
  have bound : ‖character‖ * ‖value‖ ^ 2 ≤ ‖value‖ ^ 2 := by
    calc
      ‖character‖ * ‖value‖ ^ 2 =
          ‖character * inner ℂ value value‖ := by
        rw [norm_mul, inner_self_eq_norm_sq_to_K]
        simp
      _ = ‖inner ℂ value (stageZeroSonineEnergyCompression value)‖ :=
        congrArg norm expectation.symm
      _ ≤ ‖value‖ * ‖stageZeroSonineEnergyCompression value‖ :=
        norm_inner_le_norm value (stageZeroSonineEnergyCompression value)
      _ ≤ ‖value‖ * ‖value‖ := by
        exact mul_le_mul_of_nonneg_left
          (stageZeroSonineEnergyCompression_contractive value)
          (norm_nonneg value)
      _ = ‖value‖ ^ 2 := by ring
  have squarePos : 0 < ‖value‖ ^ 2 := sq_pos_of_pos valueNormPos
  nlinarith

theorem selectedStageZeroRawRieszTarget_norm_le_one_of_energy_ne_zero
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (energyNonzero :
      selectedStageZeroBalancedEnergyState observation nontrivial ≠ 0) :
    ‖CenteredGram.selectedStageZeroRawRieszTarget observation nontrivial‖ ≤ 1 :=
  character_norm_le_one_of_compression_expectation
    (selectedStageZeroBalancedEnergyState observation nontrivial)
    (CenteredGram.selectedStageZeroRawRieszTarget observation nontrivial)
    energyNonzero
    (selectedStageZeroSonineCompression_expectation observation nontrivial)

theorem reversalStageZeroRawRieszTarget_norm_le_one_of_energy_ne_zero
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (energyNonzero :
      reversalStageZeroBalancedEnergyState observation nontrivial ≠ 0) :
    ‖CenteredGram.reversalStageZeroRawRieszTarget observation nontrivial‖ ≤ 1 :=
  character_norm_le_one_of_compression_expectation
    (reversalStageZeroBalancedEnergyState observation nontrivial)
    (CenteredGram.reversalStageZeroRawRieszTarget observation nontrivial)
    energyNonzero
    (reversalStageZeroSonineCompression_expectation observation nontrivial)

/-- Exact remaining mouth: nonzero support of the two already installed
energy coordinates is sufficient to kill the radial current. -/
theorem stageZeroRawRadialCurrent_eq_zero_of_balancedEnergy_nonzero
    (observation : GeneratedRiemannZeroObservation)
    (nontrivial :
      ¬ ∃ n : Nat, observation.coordinate = -2 * (n + 1))
    (selectedNonzero :
      selectedStageZeroBalancedEnergyState observation nontrivial ≠ 0)
    (reversalNonzero :
      reversalStageZeroBalancedEnergyState observation nontrivial ≠ 0) :
    CenteredGram.stageZeroRawRadialCurrent observation nontrivial = 0 := by
  have selectedLe :=
    selectedStageZeroRawRieszTarget_norm_le_one_of_energy_ne_zero
      observation nontrivial selectedNonzero
  have reversalLe :=
    reversalStageZeroRawRieszTarget_norm_le_one_of_energy_ne_zero
      observation nontrivial reversalNonzero
  have paired := congrArg norm
    (CenteredGram.stageZeroRawRieszTargets_paired_stationarity
      observation nontrivial)
  rw [norm_mul, norm_star, norm_one] at paired
  have selectedEq :
      ‖CenteredGram.selectedStageZeroRawRieszTarget observation nontrivial‖ = 1 := by
    nlinarith [norm_nonneg
      (CenteredGram.selectedStageZeroRawRieszTarget observation nontrivial),
      norm_nonneg
        (CenteredGram.reversalStageZeroRawRieszTarget observation nontrivial)]
  have reversalEq :
      ‖CenteredGram.reversalStageZeroRawRieszTarget observation nontrivial‖ = 1 := by
    nlinarith [norm_nonneg
      (CenteredGram.selectedStageZeroRawRieszTarget observation nontrivial),
      norm_nonneg
        (CenteredGram.reversalStageZeroRawRieszTarget observation nontrivial)]
  unfold CenteredGram.stageZeroRawRadialCurrent
  rw [selectedEq, reversalEq]
  ring

end

