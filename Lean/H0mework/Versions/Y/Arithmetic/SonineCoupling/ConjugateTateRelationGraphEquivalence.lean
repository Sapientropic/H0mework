import H0mework.Realization.Graph.CokernelSemilinearIsometry
import H0mework.Versions.Y.Arithmetic.SonineCoupling.ConjugateTateGraphCokernelNaturality
import H0mework.Versions.Y.Arithmetic.SonineCoupling.ConjugateTateEnergyScalarEquivalence
import H0mework.Versions.Y.Arithmetic.SonineCoupling.ConjugateTateSchwartzRelationEquivalence

/-!
# Actual conjugate--Tate graph-relation equivalence

The already proved source, Hilbert, scalar, and Schwartz-relation
equivalences assemble into the generic strong graph-relation input.  The
closed-relation quotient antiunitary is then generated by the generic
completion/quotient construction; it is not premise data and it does not
identify a generated-high test with an independent reversal-low test.
-/

set_option autoImplicit false
set_option maxHeartbeats 3000000

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalRiemann
namespace ClozelGeneralizedDual

open SourceGeneratedFunctionalGraphCokernel

noncomputable section

def conjugateTateRelationGraphEquivalence
    (z : ℂ) (positive : 0 < z.re)
    (belowHalf : z.re < (1 / 2 : ℝ)) :
    SemilinearRelationGraphIsometricEquivalence
      (starRingEnd ℂ) (starRingEnd ℂ)
      (quarterMellinL2Feature z)
      (quarterMellinL2Functional z)
      (coPoissonQuarterMellinConvergentMap z positive belowHalf)
      (quarterMellinL2Feature (conjugateTateMellinParameter z))
      (quarterMellinL2Functional (conjugateTateMellinParameter z))
      (coPoissonQuarterMellinConvergentMap
        (conjugateTateMellinParameter z)
        (conjugateTateMellinParameter_re_pos z belowHalf)
        (conjugateTateMellinParameter_re_lt_half z positive)) where
  sourceEquiv := conjugateTateQuarterMellinTestEquiv z
  hilbertEquiv := positiveMellinQuarterEnergyConjugateTateIsometricEquiv
  scalarEquiv := complexScalarConjugationIsometricEquiv
  relationEquiv := schwartzTateConjugationEquiv
  feature_commutes := quarterMellinL2Feature_conjugateTate z
  functional_commutes := by
    intro value
    exact (conjugateTateQuarterMellinTest_functional z value).symm
  relation_commutes := conjugateTateQuarterMellinRelation_forward
    z positive belowHalf

theorem conjugateTateRelationGraphEquivalence_forward_source
    (z : ℂ) (positive : 0 < z.re)
    (belowHalf : z.re < (1 / 2 : ℝ))
    (value : QuarterMellinL2Test z) :
    (conjugateTateRelationGraphEquivalence
      z positive belowHalf).forward.graphMorphism.sourceMap value =
      conjugateTateQuarterMellinTest z value :=
  rfl

theorem conjugateTateRelationGraphEquivalence_backward_relation
    (z : ℂ) (positive : 0 < z.re)
    (belowHalf : z.re < (1 / 2 : ℝ))
    (test : SchwartzMap ℝ ℂ) :
    (conjugateTateRelationGraphEquivalence
      z positive belowHalf).backward.graphMorphism.sourceMap
        (coPoissonQuarterMellinConvergentMap
          (conjugateTateMellinParameter z)
          (conjugateTateMellinParameter_re_pos z belowHalf)
          (conjugateTateMellinParameter_re_lt_half z positive) test) =
      coPoissonQuarterMellinConvergentMap z positive belowHalf
        ((conjugateTateRelationGraphEquivalence
          z positive belowHalf).backward.relationMap test) := by
  exact (conjugateTateRelationGraphEquivalence
    z positive belowHalf).backward.relation_commutes test

/-- Generated antiunitary equivalence of the actual closed-relation
quotients. -/
def conjugateTateCoPoissonMuntzQuotientIsometricEquiv
    (z : ℂ) (positive : 0 < z.re)
    (belowHalf : z.re < (1 / 2 : ℝ)) :
    CoPoissonMuntzGraphCokernel z positive belowHalf
      ≃ₛₗᵢ[starRingEnd ℂ]
        ConjugateTateGeneratedHighGraphCokernel z positive belowHalf :=
  (conjugateTateRelationGraphEquivalence
    z positive belowHalf).quotientIsometricEquiv

@[simp]
theorem conjugateTateCoPoissonMuntzQuotientIsometricEquiv_source
    (z : ℂ) (positive : 0 < z.re)
    (belowHalf : z.re < (1 / 2 : ℝ))
    (value : QuarterMellinL2Test z) :
    conjugateTateCoPoissonMuntzQuotientIsometricEquiv
        z positive belowHalf
        (coPoissonMuntzGraphSourceMap z positive belowHalf value) =
      coPoissonMuntzGraphSourceMap
        (conjugateTateMellinParameter z)
        (conjugateTateMellinParameter_re_pos z belowHalf)
        (conjugateTateMellinParameter_re_lt_half z positive)
        (conjugateTateQuarterMellinTest z value) := by
  exact (conjugateTateRelationGraphEquivalence
    z positive belowHalf).quotientIsometricEquiv_source_readback value

end

end ClozelGeneralizedDual
end CanonicalRiemann
end NoIslandNoMagic
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
