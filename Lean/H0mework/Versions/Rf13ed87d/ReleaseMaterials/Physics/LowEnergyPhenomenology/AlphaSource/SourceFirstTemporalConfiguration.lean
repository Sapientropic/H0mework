/-- The same original weightCore is paired with the full source matrix before finite compression. -/
def sourceTemporalMatrixCore (A : FullMatrix) : QuantumTest→ₗ[ℂ]QuantumTest :=
  GaussQuantumMultiplier.action (fun z=>sourceWeightSymbol z*A)
    (fun z=>(quantizer.toContinuousLinearMap.restrictScalars ℝ).contDiff.contDiffAt.comp z.val
      ((sourceWeightSymbol_smooth z).mul contDiffAt_const))

/-- The exact CAR normal product is generated from the original weighted matrix action. -/
def sourceTemporalNormalCore (A : FullMatrix) : QuantumTest→ₗ[ℂ]QuantumTest :=
  weightCore.comp (GaussQuantumMultiplier.action (fun _=>A) (fun _=>contDiffAt_const))-
    sourceTemporalMatrixCore A

theorem sourceTemporalNormalCore_fullCAR (A : FullMatrix) (f : QuantumTest) (z : SourceCoordinateSlice) :
    sourceTemporalNormalCore A f z=pairFiber (sourceWeightSymbol z) A (f z) := by
  have paid:=congrArg (fun T : FockFiber→L[ℂ]FockFiber=>T (f z))
    (quantized_normal_order (sourceWeightSymbol z) A)
  change quantized (sourceWeightSymbol z) (quantized A (f z))=
    quantized (sourceWeightSymbol z*A) (f z)+pairFiber (sourceWeightSymbol z) A (f z) at paid
  change quantized (sourceWeightSymbol z) (quantized A (f z))-
    quantized (sourceWeightSymbol z*A) (f z)=_
  exact sub_eq_iff_eq_add.mpr (paid.trans (add_comm _ _))

/-- This is the actual temporal density core, with the original weight and first-pole charge. -/
def sourceTemporalChargeCore : QuantumTest→ₗ[ℂ]QuantumTest :=
  -sourceTemporalMatrixCore sourceFirstChargeMatrix

theorem sourceTemporalChargeCore_actual (f : QuantumTest) :
    sourceTemporalChargeCore f=
      -(weightCore (sourceCoframeChargeCore f))-(weightCore (sourceFirstDifferenceCore f))+
        sourceTemporalNormalCore sourceActualGaussChargeMatrix f+
        sourceTemporalNormalCore sourceFirstDifferenceMatrix f := by
  apply DFunLike.ext
  intro z
  have actual:=quantized_normal_order (sourceWeightSymbol z) sourceActualGaussChargeMatrix
  have difference:=quantized_normal_order (sourceWeightSymbol z) sourceFirstDifferenceMatrix
  have a:=congrArg (fun T : FockFiber→L[ℂ]FockFiber=>T (f z)) actual
  have d:=congrArg (fun T : FockFiber→L[ℂ]FockFiber=>T (f z)) difference
  simp only [add_apply,mul_apply_eq_comp] at a d
  change -(quantized (sourceWeightSymbol z*sourceFirstChargeMatrix) (f z))=
    -(quantized (sourceWeightSymbol z) (quantized sourceActualGaussChargeMatrix (f z)))-
      quantized (sourceWeightSymbol z) (sourceFirstDifferenceCore f z)+
      sourceTemporalNormalCore sourceActualGaussChargeMatrix f z+
      sourceTemporalNormalCore sourceFirstDifferenceMatrix f z
  have addition : quantized (sourceWeightSymbol z*sourceActualGaussChargeMatrix+
      sourceWeightSymbol z*sourceFirstDifferenceMatrix)=
      quantized (sourceWeightSymbol z*sourceActualGaussChargeMatrix)+
        quantized (sourceWeightSymbol z*sourceFirstDifferenceMatrix) := quantizer.map_add _ _
  rw [sourceFirstDifferenceCore_apply,sourceTemporalNormalCore_fullCAR,sourceTemporalNormalCore_fullCAR,
    sourceFirstTemporal_chargeSplit,mul_add,addition,add_apply,a,d]
  abel

theorem sourceTemporalChargeCore_fiber (p : PhysicalMomentum) (z : physicalChart) (f : QuantumTest) :
    rawFiber (sourceEnergyAxisField 1 0) p (0,z.val) (f z.val)=sourceTemporalChargeCore f z.val := by
  rw [rawFiber,ambientState_zero,sourceFirstTemporal_raw _ (sourceState_valid z)]
  change quantizer ((-(4:ℂ) • sourceActionWeight (sourceState z.val))*sourceFirstChargeMatrix) (f z.val)=
    -(quantizer (((4:ℂ) • sourceActionWeight (sourceState z.val))*sourceFirstChargeMatrix) (f z.val))
  rw [neg_smul,neg_mul,map_neg,neg_apply]

def sourceTemporalChargeForm (a b : QuantumTest) : ℂ :=sourcePair a (sourceTemporalChargeCore b)

theorem sourceTemporalChargeForm_original (p : PhysicalMomentum) (a b : QuantumTest) :
    rawForm (sourceEnergyAxisField 1 0) p a b 0=sourceTemporalChargeForm a b := by
  rw [sourceTemporalChargeForm,sourcePair_integral]
  unfold rawForm
  apply integral_congr_ae
  filter_upwards with z
  by_cases inside : z∈tsupport a
  · have chart : z∈physicalChart:=a.tsupport_subset inside
    rw [rawSample,sourceTemporalChargeCore_fiber p ⟨z,chart⟩ b]
    exact pairSample_source a (sourceTemporalChargeCore b) z
  · simp only [rawSample,image_eq_zero_of_notMem_tsupport inside,pairSample_zero_left,
      densityPair,map_zero,inner_zero_left]

def sourceTemporalChargeReader (F : GaussUnitaryHistory.Index) : H→L[ℂ]H :=
  finiteRiesz F (fun i j=>sourceTemporalChargeForm (frameTest F i) (frameTest F j))

theorem sourceTemporalChargeReader_original (p : PhysicalMomentum) (F : GaussUnitaryHistory.Index) :
    PreparationVacuumRawJointFeedback.rawReader (sourceEnergyAxisField 1 0) p F 0=sourceTemporalChargeReader F := by
  unfold PreparationVacuumRawJointFeedback.rawReader sourceTemporalChargeReader
  exact congrArg (finiteRiesz F) (funext fun i=>funext fun j=>sourceTemporalChargeForm_original p _ _)

/-- Both independent original frame labels remain, before the actual exterior state is read. -/
theorem sourceTemporalChargeReader_action (F : GaussUnitaryHistory.Index) (y : H) :
    sourceTemporalChargeReader F y=sourceApprox F (embed (sourceTemporalChargeCore (sourceTestApprox F y))) := by
  rw [sourceTemporalChargeReader,sourceApprox_frame,sourceTestApprox_frame]
  simp only [finiteRiesz,sum_apply,smul_apply,InnerProductSpace.rankOne_apply,
    map_sum,map_smul,inner_sum,inner_smul_right,Finset.sum_smul,smul_smul,sourceTemporalChargeForm]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  unfold sourcePair
  rw [frameTest_embed]
  congr 1
  ring

theorem sourceTemporalChargeReader_actual (F : GaussUnitaryHistory.Index) (y : H) :
    sourceTemporalChargeReader F y=sourceApprox F (embed
      (-(weightCore (sourceCoframeChargeCore (sourceTestApprox F y)))-
        weightCore (sourceFirstDifferenceCore (sourceTestApprox F y))+
        sourceTemporalNormalCore sourceActualGaussChargeMatrix (sourceTestApprox F y)+
        sourceTemporalNormalCore sourceFirstDifferenceMatrix (sourceTestApprox F y))) := by
  rw [sourceTemporalChargeReader_action,sourceTemporalChargeCore_actual]

