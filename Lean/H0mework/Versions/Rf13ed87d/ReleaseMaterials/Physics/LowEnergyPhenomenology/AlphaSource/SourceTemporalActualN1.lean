/-- The actual four preparations are in the source grade by their original complete moving-state expansion. -/
theorem sourceTemporalPrepared_source (epsilon : ℝ) (precision : 0<epsilon) (s e : Fin 2) :
    sourceProjection (sourceChargedGaussPrepared epsilon precision s e)=sourceChargedGaussPrepared epsilon precision s e := by
  rw [sourceChargedGaussPrepared_moving epsilon precision 0 s e]
  simp only [map_sum,map_smul,sourcePolePrepared_sourceProjection]

/-- The real four-source Green leg, at arbitrary original momentum, is generated in the same number-one range. -/
theorem sourceTemporalGreen_N1 (q : PhysicalResponsePoint) (p : PhysicalMomentum) (s e : Fin 2)
    (z : ℂ) (nonreal : z.im≠0) :
    sourceN1Projection (jointResolvent p q.F z 0 (sourceChargedGaussPrepared q.epsilon q.precision s e))=
      jointResolvent p q.F z 0 (sourceChargedGaussPrepared q.epsilon q.precision s e) := by
  have paid:=congrArg (fun A : H→L[ℂ]H=>A (sourceChargedGaussPrepared q.epsilon q.precision s e))
    (actualResolvent_sourceN1_range p q.F z nonreal)
  simpa only [mul_apply_eq_comp,sourceTemporalPrepared_source] using paid

/-- The original complete eight-pole coefficients, not a rest-index identification, transport the actual time/Green preparation. -/
theorem sourceTemporalTimeGreen_N1 (q : PhysicalResponsePoint) (p : PhysicalMomentum) (s e : Fin 2)
    (z : ℂ) (t : ℝ) (nonreal : z.im≠0) :
    sourceN1Projection (jointResolvent p q.F z 0 (physicalTime p q.F t 0
      (sourceChargedGaussPrepared q.epsilon q.precision s e)))=
      jointResolvent p q.F z 0 (physicalTime p q.F t 0 (sourceChargedGaussPrepared q.epsilon q.precision s e)) := by
  have original (state : RestStateIndex) :=sourceActualN1Primal_generated q p state z t nonreal
  simp only [sourceActualN1Primal] at original
  rw [sourceChargedGaussPrepared_moving q.epsilon q.precision p s e]
  simp only [map_sum,map_smul,original]

/-- The independent original external-leg normalization preserves the generated source number-one state. -/
theorem sourceTemporalUnitPrimal_N1 (q : PhysicalResponsePoint) (s e : Fin 2) (z : ℂ) (nonreal : z.im≠0) :
    sourceN1Projection (sourceActualUnitPrimal q s e z)=sourceActualUnitPrimal q s e z := by
  rw [sourceActualUnitPrimal,sourceActualPrimal_amputated q s e z nonreal]
  simp only [map_smul,sourceTemporalGreen_N1 q 0 s e z nonreal]

/-- The original CAR normal product vanishes for either full matrix on each genuine number-one label. -/
theorem sourceTemporalNormal_label_zero (g : NativeHistoryGrade.Label) (one : g.1.val=1)
    (A : FullMatrix) (f : QuantumTest) :
    sourceTemporalNormalCore A (GaussCoreLabel.project g f)=0 := by
  apply DFunLike.ext
  intro z
  rw [sourceTemporalNormalCore_fullCAR]
  exact congrArg (fun T : FockFiber→L[ℂ]FockFiber=>T (f z))
    (sourceNumberOne_pairFiber_zero g one (PreparationVacuumWeightedChargeActionWard.sourceWeightSymbol z) A)

/-- The actual raw test approximation preserves the source number-one projection without any charge-invariant span premise. -/
theorem sourceTemporalNormal_N1_zero (F : GaussUnitaryHistory.Index) (A : FullMatrix) (y : H)
    (generated : sourceN1Projection y=y) : sourceTemporalNormalCore A (sourceTestApprox F y)=0 := by
  have core:=congrArg (sourceTestApprox F) generated
  simp only [sourceN1Projection,add_apply,sourceTestApprox_add,sourceProjection,
    sourceExcitedProjection,sourceTestApprox_projection] at core
  rw [←core,map_add,sourceTemporalNormal_label_zero CanonicalGradedCurrent.sourceLabel rfl,
    sourceTemporalNormal_label_zero sourceExcitedLabel rfl,zero_add]

/-- Both actual temporal normal products disappear on the true independently normalized primal. -/
theorem sourceTemporalUnitNormal_zero (q : PhysicalResponsePoint) (s e : Fin 2) (z : ℂ) (nonreal : z.im≠0) :
    sourceTemporalNormalCore sourceActualGaussChargeMatrix (sourceTestApprox q.F (sourceActualUnitPrimal q s e z))=0 ∧
    sourceTemporalNormalCore sourceFirstDifferenceMatrix (sourceTestApprox q.F (sourceActualUnitPrimal q s e z))=0 := by
  have generated:=sourceTemporalUnitPrimal_N1 q s e z nonreal
  exact ⟨sourceTemporalNormal_N1_zero q.F _ _ generated,sourceTemporalNormal_N1_zero q.F _ _ generated⟩

/-- The same disappearance is paid on the unnormalized source Green ket used in the actual spectral/material unit return. -/
theorem sourceTemporalPreparedGreenNormal_zero (q : PhysicalResponsePoint) (p : PhysicalMomentum) (s e : Fin 2)
    (z : ℂ) (nonreal : z.im≠0) :
    sourceTemporalNormalCore sourceActualGaussChargeMatrix
      (sourceTestApprox q.F (jointResolvent p q.F z 0 (sourceChargedGaussPrepared q.epsilon q.precision s e)))=0 ∧
    sourceTemporalNormalCore sourceFirstDifferenceMatrix
      (sourceTestApprox q.F (jointResolvent p q.F z 0 (sourceChargedGaussPrepared q.epsilon q.precision s e)))=0 := by
  have generated:=sourceTemporalGreen_N1 q p s e z nonreal
  exact ⟨sourceTemporalNormal_N1_zero q.F _ _ generated,sourceTemporalNormal_N1_zero q.F _ _ generated⟩

