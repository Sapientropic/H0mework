/-- The two values are generated by the nonzero-frequency factors of the full-five source tensor. -/
def sourceSpeed (branch : Fin 2) : ℝ:=if branch=0 then Real.sqrt (594/1675) else Real.sqrt (18/25)

theorem sourceSpeed_square (branch : Fin 2) :
    (sourceSpeed branch)^2=if branch=0 then (594/1675:ℝ) else (18/25:ℝ):=by
  unfold sourceSpeed
  split_ifs <;> rw [Real.sq_sqrt] <;> norm_num

theorem sourceSpeed_positive (branch : Fin 2) : 0<sourceSpeed branch:=by
  unfold sourceSpeed
  split_ifs <;> positivity

theorem sourceSpeed_bounds (branch : Fin 2) :
    (if branch=0 then (1/2:ℝ) else (4/5:ℝ))<sourceSpeed branch ∧
      sourceSpeed branch<(if branch=0 then (2/3:ℝ) else (9/10:ℝ)):=by
  have square:=sourceSpeed_square branch
  have positive:=sourceSpeed_positive branch
  split_ifs at square ⊢ <;> constructor <;> nlinarith

private def sourceA (s : ℝ) (n : PhysicalMomentum) :=sourceRoot*((25/18:ℝ)*s^2+(25/54:ℝ)*spatialSquare n)
private def sourceB (s : ℝ) (n : PhysicalMomentum) :=sourceRoot*(-(10/99:ℝ)*s^2+(12/335:ℝ)*spatialSquare n)
private def sourceC (s : ℝ) (n : PhysicalMomentum) :=sourceRoot*(-(20/27:ℝ)*s^2+(8/15:ℝ)*spatialSquare n)

private def sourceDerivative (s : ℝ) (n : PhysicalMomentum) : ℝ:=
  (((-256*s)*sourceA s n+(-128*s^2)*(sourceRoot*((25/9:ℝ)*s)))*sourceB s n+
    (-128*s^2)*sourceA s n*(sourceRoot*(-(20/99:ℝ)*s)))*sourceC s n+
      (-128*s^2)*sourceA s n*sourceB s n*(sourceRoot*(-(40/27:ℝ)*s))

private theorem quadratic_derivative (a b s : ℝ) :
    HasDerivAt (fun x : ℝ=>sourceRoot*(a*x^2+b)) (sourceRoot*(2*a*s)) s:=by
  have h:=(hasDerivAt_const s sourceRoot).mul
    (((hasDerivAt_const s a).mul ((hasDerivAt_id s).pow 2)).add (hasDerivAt_const s b))
  exact h.congr_deriv (by dsimp;ring)

private theorem sourceDet_derivative (s : ℝ) (n : PhysicalMomentum) :
    HasDerivAt (fun x=>characteristicDeterminant x n) (sourceDerivative s n) s:=by
  have a : HasDerivAt (fun x=>sourceA x n) (sourceRoot*((25/9:ℝ)*s)) s:=by
    simpa only [sourceA,show (2:ℝ)*(25/18)=25/9 by norm_num] using quadratic_derivative (25/18) ((25/54)*spatialSquare n) s
  have b : HasDerivAt (fun x=>sourceB x n) (sourceRoot*(-(20/99:ℝ)*s)) s:=by
    simpa only [sourceB,show (2:ℝ)*(-(10/99))=-(20/99) by norm_num] using quadratic_derivative (-(10/99)) ((12/335)*spatialSquare n) s
  have c : HasDerivAt (fun x=>sourceC x n) (sourceRoot*(-(40/27:ℝ)*s)) s:=by
    simpa only [sourceC,show (2:ℝ)*(-(20/27))=-(40/27) by norm_num] using quadratic_derivative (-(20/27)) ((8/15)*spatialSquare n) s
  have h:=(((hasDerivAt_const s (-128:ℝ)).mul ((hasDerivAt_id s).pow 2)).mul a).mul b |>.mul c
  exact h.congr_deriv (by dsimp;unfold sourceDerivative;ring)

theorem sourceSpeed_root (branch : Fin 2) (n : PhysicalMomentum) (unit : spatialSquare n=1) :
    physicalDeterminant 0 (sourceSpeed branch) n=0:=by
  rw [physicalDeterminant_origin]
  unfold characteristicDeterminant
  rw [sourceSpeed_square,unit]
  split_ifs <;> ring

theorem sourceSpeed_simple (branch : Fin 2) (n : PhysicalMomentum) (unit : spatialSquare n=1) :
    physicalSlope 0 (sourceSpeed branch) n≠0:=by
  rw [physicalSlope_origin,(sourceDet_derivative (sourceSpeed branch) n).deriv]
  have positive:=sourceSpeed_positive branch
  have root : 0<sourceRoot:=by unfold sourceRoot;positivity
  unfold sourceDerivative sourceA sourceB sourceC
  rw [sourceSpeed_square,unit]
  split_ifs
  all_goals
    ring_nf
    positivity

private theorem realMap_invertible (f : ℝ→L[ℝ] ℝ) (nonzero : f 1≠0) : f.IsInvertible:=by
  refine ⟨(LinearEquiv.smulOfNeZero ℝ ℝ (f 1) nonzero).toContinuousLinearEquiv,?_⟩
  apply ContinuousLinearMap.ext
  intro x
  have linear:=f.map_smul x (1:ℝ)
  change f 1*x=f x
  simpa only [smul_eq_mul,mul_one,mul_comm] using linear.symm

private theorem slope_invertible (branch : Fin 2) (n : PhysicalMomentum) (unit : spatialSquare n=1) :
    (fderiv ℝ (fun x : ℝ×ℝ=>physicalDeterminant x.1 x.2 n) (0,sourceSpeed branch) ∘L
      ContinuousLinearMap.inr ℝ ℝ ℝ).IsInvertible:=by
  apply realMap_invertible
  exact sourceSpeed_simple branch n unit

/-- The actual complete-field sheet is generated by the source implicit function, with no supplied pole shell. -/
def sourceSheet (branch : Fin 2) (n : PhysicalMomentum) (unit : spatialSquare n=1) : ℝ→ℝ:=
  ((physicalDeterminant_smooth (sourceSpeed branch) n).hasStrictFDerivAt (by simp)).implicitFunctionOfProdDomain
    (slope_invertible branch n unit)

theorem sourceSheet_tendsto (branch : Fin 2) (n : PhysicalMomentum) (unit : spatialSquare n=1) :
    Tendsto (sourceSheet branch n unit) (𝓝 0) (𝓝 (sourceSpeed branch)):=
  ((physicalDeterminant_smooth (sourceSpeed branch) n).hasStrictFDerivAt (by simp)).tendsto_implicitFunctionOfProdDomain
    (slope_invertible branch n unit)

theorem sourceSheet_equation (branch : Fin 2) (n : PhysicalMomentum) (unit : spatialSquare n=1) :
    ∀ᶠ epsilon in 𝓝 (0:ℝ),physicalDeterminant epsilon (sourceSheet branch n unit epsilon) n=0:=by
  have equation:=((physicalDeterminant_smooth (sourceSpeed branch) n).hasStrictFDerivAt (by simp)).eventually_apply_implicitFunctionOfProdDomain
    (slope_invertible branch n unit)
  simpa only [sourceSheet,sourceSpeed_root branch n unit] using equation

theorem sourceSheet_simple (branch : Fin 2) (n : PhysicalMomentum) (unit : spatialSquare n=1) :
    ∀ᶠ epsilon in 𝓝 (0:ℝ),physicalSlope epsilon (sourceSheet branch n unit epsilon) n≠0 ∧
      HasDerivAt (fun t=>physicalDeterminant epsilon t n)
        (physicalSlope epsilon (sourceSheet branch n unit epsilon) n) (sourceSheet branch n unit epsilon):=by
  have trajectory : Tendsto (fun e=>(e,sourceSheet branch n unit e)) (𝓝 (0:ℝ)) (𝓝 (0,sourceSpeed branch)):=
    tendsto_id.prodMk_nhds (sourceSheet_tendsto branch n unit)
  have nonzero:=((physicalSlope_continuous_origin (sourceSpeed branch) n).tendsto.comp trajectory).eventually_ne
    (sourceSpeed_simple branch n unit)
  exact nonzero.and (trajectory.eventually (physicalDeterminant_derivative_near (sourceSpeed branch) n))

theorem sourceSheet_tensor_continuous (branch : Fin 2) (n : PhysicalMomentum) (unit : spatialSquare n=1) :
    ∀ᶠ epsilon in 𝓝 (0:ℝ),ContinuousAt (fun t=>extendedTensor epsilon t n) (sourceSheet branch n unit epsilon):=by
  have trajectory : Tendsto (fun e=>(e,sourceSheet branch n unit e)) (𝓝 (0:ℝ)) (𝓝 (0,sourceSpeed branch)):=
    tendsto_id.prodMk_nhds (sourceSheet_tendsto branch n unit)
  have smooth : ContDiffAt ℝ 0 (fun x : ℝ×ℝ=>extendedTensor x.1 x.2 n) (0,sourceSpeed branch):=
    (extendedTensor_smooth (sourceSpeed branch) n).of_le (by simp)
  filter_upwards [trajectory.eventually (smooth.eventually (by simp))] with e he
  exact he.continuousAt.comp ((continuousAt_const.prodMk continuousAt_id) :
    ContinuousAt (fun t : ℝ=>(e,t)) (sourceSheet branch n unit e))

theorem sourceSheet_bounds (branch : Fin 2) (n : PhysicalMomentum) (unit : spatialSquare n=1) :
    ∀ᶠ epsilon in 𝓝 (0:ℝ),
      (if branch=0 then (1/2:ℝ) else (4/5:ℝ))<sourceSheet branch n unit epsilon ∧
      sourceSheet branch n unit epsilon<(if branch=0 then (2/3:ℝ) else (9/10:ℝ)):=
  ((sourceSheet_tendsto branch n unit).eventually_const_lt (sourceSpeed_bounds branch).1).and
    ((sourceSheet_tendsto branch n unit).eventually_lt_const (sourceSpeed_bounds branch).2)

private theorem inverse_residue (M : ℝ→Matrix (Fin 5) (Fin 5) ℂ) (s : ℝ) (d : ℂ)
    (continuous : ContinuousAt M s) (derivative : HasDerivAt (fun t=>(M t).det) d s)
    (zero : (M s).det=0) (nonzero : d≠0) :
    Tendsto (fun t=>((t-s:ℝ):ℂ) • (M t)⁻¹) (𝓝[≠] s) (𝓝 (d⁻¹ • (M s).adjugate)):=by
  have scalar:=derivative.tendsto_slope.inv₀ nonzero
  have result:=scalar.smul ((continuous_id.matrix_adjugate.continuousAt.comp continuous).tendsto.mono_left nhdsWithin_le_nhds)
  simp only [Function.comp_apply,id_eq] at result
  convert result using 1
  funext t
  simp only [slope_def_module,zero,sub_zero,Complex.real_smul,Complex.ofReal_inv,
    mul_inv_rev,inv_inv,Matrix.inv_def,Ring.inverse_eq_inv,smul_smul]
  rw [mul_comm]

private theorem extendedTensor_det_real (e : scaleDomain) (s : ℝ) (bound : |s|≤1)
    (n : PhysicalMomentum) (direction : ∀i,|n i|≤1) :
    (extendedTensor e.val s n).det=((physicalDeterminant e.val s n:ℝ):ℂ):=by
  change (extendedTensor e.val s n).det=(((extendedTensor e.val s n).det.re:ℝ):ℂ)
  rw [extendedTensor_actual e ⟨s,bound⟩ n direction]
  exact normalizedEffective_det_real e ⟨s,bound⟩ n direction

def sourceResidue (epsilon s : ℝ) (n : PhysicalMomentum) : Matrix (Fin 5) (Fin 5) ℂ:=
  (physicalSlope epsilon s n:ℂ)⁻¹ • (extendedTensor epsilon s n).adjugate

/-- The actual sheet has a complete five-channel inverse residue in the source slope coordinate; native frequency is epsilon squared times that slope. -/
theorem sourceSheet_inverse_residue (branch : Fin 2) (n : PhysicalMomentum) (unit : spatialSquare n=1) :
    ∀ᶠ e in scaleApproach,
      Tendsto (fun t=>((t-sourceSheet branch n unit e.val:ℝ):ℂ) • (extendedTensor e.val t n)⁻¹)
        (𝓝[≠] (sourceSheet branch n unit e.val))
        (𝓝 (sourceResidue e.val (sourceSheet branch n unit e.val) n)):=by
  filter_upwards [scaleVal_tendsto.eventually (sourceSheet_simple branch n unit),
    scaleVal_tendsto.eventually (sourceSheet_equation branch n unit),
    scaleVal_tendsto.eventually (sourceSheet_tensor_continuous branch n unit),
    scaleVal_tendsto.eventually (sourceSheet_bounds branch n unit)] with e simple equation continuous bounds
  let s:=sourceSheet branch n unit e.val
  have inside : |s|<1:=by
    have bounds:=bounds
    change (if branch=0 then (1/2:ℝ) else (4/5:ℝ))<s ∧ s<(if branch=0 then (2/3:ℝ) else (9/10:ℝ)) at bounds
    apply abs_lt.mpr
    split_ifs at bounds <;> constructor <;> linarith
  have realNear : (fun t=>(extendedTensor e.val t n).det)=ᶠ[𝓝 s]
      (fun t=>(physicalDeterminant e.val t n:ℂ)):=by
    filter_upwards [(continuous_abs.continuousAt : ContinuousAt (fun t : ℝ=>|t|) s).eventually_lt_const inside] with t ht
    exact extendedTensor_det_real e t ht.le n (unit_direction_bound n unit)
  have derivative : HasDerivAt (fun t=>(extendedTensor e.val t n).det) (physicalSlope e.val s n:ℂ) s:=by
    have lifted:=Complex.ofRealCLM.hasFDerivAt.comp_hasDerivAt s simple.2
    exact lifted.congr_of_eventuallyEq realNear
  have zero : (extendedTensor e.val s n).det=0:=by
    rw [extendedTensor_det_real e s inside.le n (unit_direction_bound n unit),equation,Complex.ofReal_zero]
  exact inverse_residue _ s _ continuous derivative zero (Complex.ofReal_ne_zero.mpr simple.1)

private theorem sparse_five_det (a b c d : ℂ) :
    (Matrix.diagonal (![a,b,c,0,0] : Fin 5→ℂ)+Matrix.single 3 4 d+Matrix.single 4 3 (-d)).det=a*b*c*d^2:=by
  let M : Matrix (Fin 5) (Fin 5) ℂ:=Matrix.diagonal ![a,b,c,0,0]+Matrix.single 3 4 d+Matrix.single 4 3 (-d)
  have diagonal : M.submatrix id (Equiv.swap (3:Fin 5) 4)=Matrix.diagonal ![a,b,c,d,-d]:=by
    ext i j
    fin_cases i <;> fin_cases j <;>
      norm_num [M,Matrix.submatrix_apply,Matrix.diagonal_apply,Matrix.single_apply,Matrix.add_apply,Equiv.swap_apply_def,Fin.ext_iff]
  have h:=Matrix.det_permute' (Equiv.swap (3:Fin 5) 4) M
  rw [diagonal,Matrix.det_diagonal] at h
  norm_num [Fin.prod_univ_succ,Fin.ext_iff] at h
  change M.det=a*b*c*d^2
  calc
    M.det=a*(b*(c*(d*d))):=h.symm
    _=a*b*c*d^2:=by ring

def residueIndex (branch : Fin 2) : Fin 5:=if branch=0 then 1 else 2

private theorem adjugate_source_entry (branch : Fin 2) (s : ℝ) (n : PhysicalMomentum) :
    (characteristicTensor s n).adjugate (residueIndex branch) (residueIndex branch)=
      ((-128*s^2*sourceA s n*(if branch=0 then sourceC s n else sourceB s n):ℝ):ℂ):=by
  have updated : (characteristicTensor s n).updateRow (residueIndex branch) (Pi.single (residueIndex branch) 1)=
      Matrix.diagonal ![(sourceA s n:ℂ),(if branch=0 then 1 else (sourceB s n:ℂ)),
        (if branch=0 then (sourceC s n:ℂ) else 1),0,0]+
        Matrix.single 3 4 (8*Complex.I*rootTwo*(s:ℂ))+Matrix.single 4 3 (-(8*Complex.I*rootTwo*(s:ℂ))):=by
    fin_cases branch <;> ext i j <;> fin_cases i <;> fin_cases j <;>
      norm_num [characteristicTensor,residueIndex,sourceA,sourceB,sourceC,sourceRoot,rootTwo,rootFifteen,
        Matrix.updateRow_apply,Pi.single_apply,Fin.ext_iff,Complex.ofReal_add,Complex.ofReal_mul,Complex.ofReal_pow]
  rw [Matrix.adjugate_apply,updated,sparse_five_det]
  have root : rootTwo^2=(2:ℂ):=by norm_num [rootTwo,←Complex.ofReal_pow,Real.sq_sqrt]
  split_ifs <;> push_cast <;> simp only [mul_pow,Complex.I_sq,root] <;> ring

theorem source_adjugate_nonzero (branch : Fin 2) (n : PhysicalMomentum) (unit : spatialSquare n=1) :
    (characteristicTensor (sourceSpeed branch) n).adjugate (residueIndex branch) (residueIndex branch)≠0:=by
  rw [adjugate_source_entry,Complex.ofReal_ne_zero]
  have speed:=sourceSpeed_positive branch
  have root : 0<sourceRoot:=by unfold sourceRoot;positivity
  unfold sourceA sourceB sourceC
  rw [sourceSpeed_square,unit]
  split_ifs <;> ring_nf <;> positivity

theorem sourceSheet_residue_nonzero (branch : Fin 2) (n : PhysicalMomentum) (unit : spatialSquare n=1) :
    ∀ᶠ e in 𝓝 (0:ℝ),sourceResidue e (sourceSheet branch n unit e) n≠0:=by
  have trajectory : Tendsto (fun e=>(e,sourceSheet branch n unit e)) (𝓝 (0:ℝ)) (𝓝 (0,sourceSpeed branch)):=
    tendsto_id.prodMk_nhds (sourceSheet_tendsto branch n unit)
  have matrix := (extendedTensor_smooth (sourceSpeed branch) n).continuousAt.tendsto.comp trajectory
  have adjugate := continuous_id.matrix_adjugate.continuousAt.tendsto.comp matrix
  have entry:=((continuous_apply (residueIndex branch)).comp (continuous_apply (residueIndex branch))).tendsto _ |>.comp adjugate
  simp only [Function.comp_apply,id_eq,extendedTensor_origin] at entry
  filter_upwards [entry.eventually_ne (source_adjugate_nonzero branch n unit),sourceSheet_simple branch n unit] with e he hs
  intro zero
  have value:=congrArg (fun M : Matrix (Fin 5) (Fin 5) ℂ=>M (residueIndex branch) (residueIndex branch)) zero
  simp only [sourceResidue,Matrix.smul_apply,smul_eq_mul,Matrix.zero_apply,mul_eq_zero,inv_eq_zero] at value
  exact value.elim (fun h=>hs.1 (Complex.ofReal_eq_zero.mp h)) he

open SourcePropagationNativeActionHessian

/-- Each source-generated simple sheet simultaneously returns its nonzero whole-field mode and full-five inverse residue. -/
theorem sourceSheet_whole_pole (branch : Fin 2) (n : PhysicalMomentum) (unit : spatialSquare n=1) :
    ∀ᶠ e in scaleApproach,∃s : slopeDomain,∃v : Fin 5→ℂ,
      s.val=sourceSheet branch n unit e.val ∧ nativeMode e s n (unit_direction_bound n unit) v≠0 ∧
      nativeFourierHessian nativeHessian (frequencyRay e.val s.val n)*ᵥnativeMode e s n (unit_direction_bound n unit) v=0 ∧
      sourceResidue e.val s.val n≠0 ∧
      Tendsto (fun t=>((t-s.val:ℝ):ℂ) • (extendedTensor e.val t n)⁻¹) (𝓝[≠] s.val)
        (𝓝 (sourceResidue e.val s.val n)):=by
  filter_upwards [scaleVal_tendsto.eventually (sourceSheet_bounds branch n unit),
    scaleVal_tendsto.eventually (sourceSheet_equation branch n unit),
    scaleVal_tendsto.eventually (sourceSheet_residue_nonzero branch n unit),
    sourceSheet_inverse_residue branch n unit] with e bounds equation residue limit
  have inside : |sourceSheet branch n unit e.val|≤1:=by
    apply abs_le.mpr
    split_ifs at bounds <;> constructor <;> linarith
  let s : slopeDomain:=⟨sourceSheet branch n unit e.val,inside⟩
  have zero : (normalizedEffective e s n (unit_direction_bound n unit)).det=0:=by
    rw [normalizedEffective_det_real,←extendedTensor_actual]
    change (physicalDeterminant e.val s.val n:ℂ)=0
    rw [equation,Complex.ofReal_zero]
  obtain ⟨v,_,nonzero,whole⟩:=source_mode_of_characteristic e s n (unit_direction_bound n unit) zero
  refine ⟨s,v,rfl,nonzero,?_,residue,limit⟩
  simpa only [nativeActionFourierHessian_original] using whole

/-- Native Fourier frequency is omega=epsilon squared times the source slope. -/
def sourceFrequency (epsilon s : ℝ) : ℝ:=epsilon^2*s

def frequencyResidue (epsilon s : ℝ) (n : PhysicalMomentum) : Matrix (Fin 5) (Fin 5) ℂ:=
  ((epsilon^2:ℝ):ℂ) • sourceResidue epsilon s n

theorem sourceSheet_frequency_residue (branch : Fin 2) (n : PhysicalMomentum) (unit : spatialSquare n=1) :
    ∀ᶠ e in scaleApproach,
      Tendsto (fun omega=>((omega-sourceFrequency e.val (sourceSheet branch n unit e.val):ℝ):ℂ) •
        (extendedTensor e.val (omega/e.val^2) n)⁻¹)
        (𝓝[≠] (sourceFrequency e.val (sourceSheet branch n unit e.val)))
        (𝓝 (frequencyResidue e.val (sourceSheet branch n unit e.val) n)):=by
  filter_upwards [sourceSheet_inverse_residue branch n unit] with e limit
  let s:=sourceSheet branch n unit e.val
  let a:=e.val^2
  have nonzero : a≠0:=pow_ne_zero 2 e.property.1.ne'
  have divided : a*s/a=s:=by field_simp
  have reparam : Tendsto (fun omega : ℝ=>omega/a) (𝓝[≠] (a*s)) (𝓝[≠] s):=by
    apply tendsto_nhdsWithin_iff.mpr
    constructor
    · have h : Tendsto (fun omega : ℝ=>omega/a) (𝓝[≠] (a*s)) (𝓝 ((a*s)/a)):=
        ((continuous_id.div_const a).tendsto (a*s)).mono_left nhdsWithin_le_nhds
      simpa only [divided] using h
    · filter_upwards [self_mem_nhdsWithin] with omega outside
      change omega/a≠s
      intro equal
      apply outside
      change omega=a*s
      exact ((div_eq_iff nonzero).mp equal).trans (mul_comm s a)
  have result : Tendsto (fun omega : ℝ=>(a:ℂ) •
      (((omega/a-s:ℝ):ℂ) • (extendedTensor e.val (omega/a) n)⁻¹)) (𝓝[≠] (a*s))
      (𝓝 ((a:ℂ) • sourceResidue e.val s n)):=tendsto_const_nhds.smul (limit.comp reparam)
  apply result.congr'
  filter_upwards [] with omega
  have scalar : a*(omega/a-s)=omega-a*s:=by field_simp
  rw [smul_smul,←Complex.ofReal_mul,scalar]
  rfl

