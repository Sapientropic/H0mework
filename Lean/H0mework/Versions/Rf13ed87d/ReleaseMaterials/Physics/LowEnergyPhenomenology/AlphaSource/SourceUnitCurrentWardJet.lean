/-- The actual independent external read acts on the original complete physical-time operator jet. -/
def sourceUnitCurrentJet (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) (t : ℝ) (i : Fin 289) : SourceJet ℂ :=
  ⟨-sourceUnitRead q sL eL sR eR (rawKernelJet (fieldUnit i) q.p q.k q.F q.z q.w 0 t).value,
    -sourceUnitRead q sL eL sR eR (rawKernelJet (fieldUnit i) q.p q.k q.F q.z q.w 0 t).first,
    -sourceUnitRead q sL eL sR eR (rawKernelJet (fieldUnit i) q.p q.k q.F q.z q.w 0 t).second⟩

theorem sourceUnitCurrentJet_generated (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) (t : ℝ) (i : Fin 289) :
    HasSourceJets (fun t=>sourceUnitCurrentJet q sL eL sR eR t i) t := by
  have generated:=rawKernelJet_generated (fieldUnit i) q.p q.k q.F q.z q.w 0 t
  exact ⟨((sourceUnitRead q sL eL sR eR).restrictScalars ℝ |>.hasFDerivAt.comp_hasDerivAt t generated.1).neg,
    ((sourceUnitRead q sL eL sR eR).restrictScalars ℝ |>.hasFDerivAt.comp_hasDerivAt t generated.2).neg⟩

theorem sourceUnitCurrentJet_continuous (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) (i : Fin 289) :
    ContinuousJets (fun t=>sourceUnitCurrentJet q sL eL sR eR t i) := by
  have base:=rawKernelJets_continuous (fieldUnit i) q.p q.k q.F q.z q.w 0
  exact ⟨((sourceUnitRead q sL eL sR eR).continuous.comp base.1).neg,
    ((sourceUnitRead q sL eL sR eR).continuous.comp base.2.1).neg,
    ((sourceUnitRead q sL eL sR eR).continuous.comp base.2.2).neg⟩

theorem sourceUnitCurrentJet_value (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) (t : ℝ) (i : Fin 289) :
    (sourceUnitCurrentJet q sL eL sR eR t i).value=sourceUnitEulerCurrent q sL eL sR eR t 0 i := by
  simp only [sourceUnitCurrentJet,rawKernelJet_value,sourceUnitEulerCurrent,sourceUnitTimeCurrent]

/- Resolve the unique already-paid original owner; emit only its imported constant. -/
open Lean Elab Term in
elab "originalCurrentWard% " id:ident : term => do
  let wanted := `LowEnergy.PreparationVacuumPhysicalZeroRead ++ id.getId
  let names := (← getEnv).constants.toList.filterMap fun (name, _) =>
    if name.toString.startsWith "_private.H0mework.Versions.Rf13ed87d.ReleaseMaterials.Physics.LowEnergyPhenomenology.AlphaSource.CanonicalPreparationActualCurrentWard." && privateToUserName name == wanted then some name else none
  match names with
  | [name] =>
    logInfo m!"Original private payer: {name}"
    return mkConst name
  | _ =>
    let alternatives := (← getEnv).constants.toList.filterMap fun (name, _) =>
      if privateToUserName name == wanted then some name else none
    throwError "Expected one original ActualCurrentWard payer for {wanted}; actual candidates {alternatives}"

private abbrev originalWindow := originalCurrentWard% zero_forcing
private abbrev originalTimeSource := originalCurrentWard% zero_timeSource
private abbrev originalBoundary := originalCurrentWard% zero_boundary

def sourceUnitCurrentWindow (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2) (lambda : ℂ) (T : ℝ) : Fin 289→ℂ :=
  originalWindow (sourceUnitCurrentJet q sL eL sR eR) lambda T

def sourceUnitCurrentTimeSource (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (spatial : Fin 3→ℂ) (t : ℝ) (row : Fin 289) : ℂ :=
  originalTimeSource (sourceUnitCurrentJet q sL eL sR eR) spatial t row

def sourceUnitCurrentBoundary (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (spatial : Fin 3→ℂ) (lambda : ℂ) (t : ℝ) (row : Fin 289) : ℂ :=
  originalBoundary (sourceUnitCurrentJet q sL eL sR eR) spatial lambda t row

def sourceUnitCurrentCosource (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (spatial : Fin 3→ℂ) (lambda : ℂ) (T : ℝ) : Fin 289→ℂ :=
  fun row=>(∫t in (0:ℝ)..T,laplaceWeight lambda t*sourceUnitCurrentTimeSource q sL eL sR eR spatial t row)-
    (sourceUnitCurrentBoundary q sL eL sR eR spatial lambda T row-
      sourceUnitCurrentBoundary q sL eL sR eR spatial lambda 0 row)

theorem sourceUnitCurrentWindow_actual (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (lambda : ℂ) (T : ℝ) (i : Fin 289) :
    sourceUnitCurrentWindow q sL eL sR eR lambda T i=
      ∫t in (0:ℝ)..T,laplaceWeight lambda t*sourceUnitEulerCurrent q sL eL sR eR t 0 i := by
  change (∫t in (0:ℝ)..T,laplaceWeight lambda t*(sourceUnitCurrentJet q sL eL sR eR t i).value)=_
  simp only [sourceUnitCurrentJet_value]

/-- The original finite-window integration by parts generates both endpoint terms on these actual source jets. -/
theorem sourceUnitCurrentWindow_ward (q : PhysicalResponsePoint) (sL eL sR eR : Fin 2)
    (spatial : Fin 3→ℂ) (lambda : ℂ) (T : ℝ) :
    originalReadback (fullMomentum spatial lambda)*ᵥsourceUnitCurrentWindow q sL eL sR eR lambda T=
      sourceUnitCurrentCosource q sL eL sR eR spatial lambda T := by
  funext row
  exact (originalCurrentWard% zero_forcing_readback)
    (sourceUnitCurrentJet q sL eL sR eR) (sourceUnitCurrentJet_continuous q sL eL sR eR)
    (fun i t=>sourceUnitCurrentJet_generated q sL eL sR eR t i) spatial lambda T row

