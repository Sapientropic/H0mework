/-- The same physical Fourier clock generates the four-dimensional mode. -/
def sourceFirstPhaseLinear (omega : ℝ) (k : PhysicalMomentum) : BasePoint→ₗ[ℝ]ℂ where
  toFun x:=∑mu : Fin 4,physicalFrequencyMomentum omega k mu*(x mu:ℂ)
  map_add' x y:=by simp only [PiLp.add_apply,Complex.ofReal_add,mul_add,Finset.sum_add_distrib]
  map_smul' r x:=by
    simp only [PiLp.smul_apply,smul_eq_mul,Complex.ofReal_mul,RingHom.id_apply,Complex.real_smul]
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro mu _
    ring

def sourceFirstHarmonicPhase (omega : ℝ) (k : PhysicalMomentum) (x : BasePoint) : ℂ :=
  Complex.exp (sourceFirstPhaseLinear omega k x)

def sourceFirstPhasePoint (t : ℝ) (x : Position) : BasePoint :=
  WithLp.toLp 2 (Fin.cases t (fun j=>x j))

/-- The same source physical spatial phase and real clock are restrictions of one occurrence. -/
theorem sourceFirstHarmonicPhase_restriction (omega t : ℝ) (k : PhysicalMomentum) (x : Position) :
    sourceFirstHarmonicPhase omega k (sourceFirstPhasePoint t x)=
      Complex.exp (-Complex.I*(omega:ℂ)*(t:ℂ))*phase k x := by
  rw [sourceFirstHarmonicPhase,phase_physical,←Complex.exp_add]
  apply congrArg Complex.exp
  change (∑mu : Fin 4,physicalFrequencyMomentum omega k mu*((sourceFirstPhasePoint t x) mu:ℂ))=_
  rw [Fin.sum_univ_succ]
  simp only [sourceFirstPhasePoint,physicalFrequencyMomentum,
    Fin.cases_zero,Fin.cases_succ]
  rw [Complex.ofReal_sum,Finset.sum_mul]
  congr 1
  apply Finset.sum_congr rfl
  intro j _
  simp only [Complex.ofReal_mul]
  ring

private theorem phase_linear_coordinate (omega : ℝ) (k : PhysicalMomentum) (mu : Fin 4) :
    sourceFirstPhaseLinear omega k (coordinateDirection mu)=physicalFrequencyMomentum omega k mu := by
  simp [sourceFirstPhaseLinear,coordinateDirection,PiLp.single_apply,apply_ite]

/-- The derivative is generated by the physical momentum, including its temporal minus sign. -/
theorem sourceFirstHarmonicPhase_derivative (omega : ℝ) (k : PhysicalMomentum) (x : BasePoint) (mu : Fin 4) :
    (fderiv ℝ (sourceFirstHarmonicPhase omega k) x) (coordinateDirection mu)=
      sourceFirstHarmonicPhase omega k x*physicalFrequencyMomentum omega k mu := by
  have generated:=(sourceFirstPhaseLinear omega k).toContinuousLinearMap.hasFDerivAt (x:=x) |>.cexp
  rw [show sourceFirstHarmonicPhase omega k=(fun y=>Complex.exp ((sourceFirstPhaseLinear omega k).toContinuousLinearMap y)) from rfl,
    generated.fderiv]
  simp only [smul_apply,LinearMap.coe_toContinuousLinearMap',phase_linear_coordinate,smul_eq_mul]

/-- The two real gauge parameters are restrictions of minus the same complex mode. -/
def sourceFirstGaugeQuadrature (imaginary : Bool) (omega : ℝ) (k : PhysicalMomentum) (x : BasePoint) : ℝ :=
  if imaginary then -(sourceFirstHarmonicPhase omega k x).im else -(sourceFirstHarmonicPhase omega k x).re

def sourceFirstGaugeQuadratureDerivative (imaginary : Bool) (omega : ℝ) (k : PhysicalMomentum)
    (x : BasePoint) (mu : Fin 4) : ℝ :=
  if imaginary then -(sourceFirstHarmonicPhase omega k x*physicalFrequencyMomentum omega k mu).im
    else -(sourceFirstHarmonicPhase omega k x*physicalFrequencyMomentum omega k mu).re

theorem sourceFirstGaugeQuadrature_generated (imaginary : Bool) (omega : ℝ) (k : PhysicalMomentum)
    (x : BasePoint) (mu : Fin 4) :
    (fderiv ℝ (sourceFirstGaugeQuadrature imaginary omega k) x) (coordinateDirection mu)=
      sourceFirstGaugeQuadratureDerivative imaginary omega k x mu := by
  have H:=(sourceFirstPhaseLinear omega k).toContinuousLinearMap.hasFDerivAt (x:=x) |>.cexp
  cases imaginary
  · have R:=(Complex.reCLM.hasFDerivAt.comp x H).neg
    change (fderiv ℝ (-(fun y=>(Complex.exp (sourceFirstPhaseLinear omega k y)).re)) x) (coordinateDirection mu)=_
    simp only [Function.comp_def,Complex.reCLM_apply,
      LinearMap.coe_toContinuousLinearMap'] at R
    rw [R.fderiv]
    simp only [neg_apply,ContinuousLinearMap.comp_apply,Complex.reCLM_apply,smul_apply,
      LinearMap.coe_toContinuousLinearMap',phase_linear_coordinate,smul_eq_mul]
    rfl
  · have R:=(Complex.imCLM.hasFDerivAt.comp x H).neg
    change (fderiv ℝ (-(fun y=>(Complex.exp (sourceFirstPhaseLinear omega k y)).im)) x) (coordinateDirection mu)=_
    simp only [Function.comp_def,Complex.imCLM_apply,
      LinearMap.coe_toContinuousLinearMap'] at R
    rw [R.fderiv]
    simp only [neg_apply,ContinuousLinearMap.comp_apply,Complex.imCLM_apply,smul_apply,
      LinearMap.coe_toContinuousLinearMap',phase_linear_coordinate,smul_eq_mul]
    rfl

/-- These are literal source coefficients, retaining both anisotropic differences and transverse terms. -/
def sourceFirstGaugeRemainderCoefficients (k mu : Fin 4) : Fin 12→ℝ :=
  sourceFirstGaugeCoefficients k mu-(if k=mu then sourceFirstTemporalCoefficients else 0)

theorem sourceFirstGaugeRemainderCoefficients_generated (k mu : Fin 4) :
    sourceFirstGaugeRemainderCoefficients k mu=
      (if k=1 ∧ mu=1 then sourceFirstSpatialCoefficients-sourceFirstTemporalCoefficients else 0)+
      (if k=2 ∧ mu=2 then sourceFirstSpatialCoefficients-sourceFirstTemporalCoefficients else 0)+
      (if k=3 ∧ mu=3 then sourceFirstLongitudinalCoefficients-sourceFirstTemporalCoefficients else 0)+
      (if k=1 ∧ mu=3 then Pi.single 1 (-3/67) else 0)+
      (if k=2 ∧ mu=3 then Pi.single 0 (-3/67) else 0) := by
  fin_cases k <;> fin_cases mu <;>
    simp [sourceFirstGaugeRemainderCoefficients,sourceFirstGaugeCoefficients]

def sourceFirstGaugeRemainderConnection (k mu : Fin 4) : NativeLie :=
  ∑a : Fin 12,sourceFirstGaugeRemainderCoefficients k mu a • originalUnit a

/-- All original gauge slots return the same temporal derivative direction plus the computed residual. -/
theorem sourceFirstGaugeConnection_split (k mu : Fin 4) :
    fieldGauge (sourceEnergyAxisField 1 k) mu=
      (if k=mu then sourceFirstTemporalLie else 0)+sourceFirstGaugeRemainderConnection k mu := by
  have temporal : sourceFirstTemporalLie=∑a : Fin 12,sourceFirstTemporalCoefficients a • originalUnit a := by
    simp [sourceFirstTemporalLie,sourceFirstGaugeConnection,sourceFirstGaugeCoefficients]
  rw [sourceFirstGauge_generated,sourceFirstGaugeRemainderConnection]
  simp only [sourceFirstGaugeRemainderCoefficients,Pi.sub_apply,sub_smul,Finset.sum_sub_distrib]
  change sourceFirstGaugeConnection k mu=(if k=mu then sourceFirstTemporalLie else 0)+
    (sourceFirstGaugeConnection k mu-∑a : Fin 12,(if k=mu then sourceFirstTemporalCoefficients else 0) a • originalUnit a)
  split_ifs with h
  · rw [←temporal]
    abel
  · simp

