private theorem shift_smul (c : ℂ) (A : Fin 4→FiberOperators) (k : PhysicalMomentum) :
    shiftCoefficients (c • A) k=c • shiftCoefficients A k := by
  funext i
  induction i using Fin.cases with
  | zero =>
    change c • A 0+(∑j : Fin 3,(k j:ℂ) • (c • A j.succ))=c • (A 0+∑j : Fin 3,(k j:ℂ) • A j.succ)
    rw [_root_.smul_add,Finset.smul_sum]
    congr 1
    apply Finset.sum_congr rfl
    intro j _
    exact smul_comm (k j:ℂ) c (A j.succ)
  | succ j => rfl

private theorem phase_zero (x : Position) : phase 0 x=1 := by
  simp [phase_physical]

def sourceHarmonicProfileTransfers (s : SourceHarmonicOccurrence) (x : Position) : TransferPair × TransferPair :=
  (originalTransferPair (sourceHarmonicProfile s 0 x) (sourceHarmonicProfile s 1 x),
    originalTransferPair (sourceHarmonicProfile s 2 x) (sourceHarmonicProfile s 3 x))

/-- The actual fullfield profiles, including the shifted positive adjoint, produce the reader character used by the physical ordering. -/
theorem sourceHarmonicProfile_reader (s : SourceHarmonicOccurrence) (x : Position) (j : Fin 4) :
    realReaderCoefficients (sourceHarmonicProfileTransfers s x).1 s.wave j=
      phase (-s.wave) x • realReaderCoefficients (sourceHarmonicTransfers s).1 s.wave j := by
  have positive : complexCoefficients (originalComplexDirection (sourceHarmonicProfile s 0 x))=
      phase s.wave x • complexCoefficients (originalComplexDirection (sourceHarmonicField s 0)) := by
    funext row
    simpa only [sourceModeWave_actual,Matrix.cons_val_zero,Pi.smul_apply] using
      (sourceHarmonicProfile_coefficients s 0 row x).1
  have negative : complexCoefficients (originalComplexDirection (sourceHarmonicProfile s 1 x))=
      phase (-s.wave) x • complexCoefficients (originalComplexDirection (sourceHarmonicField s 1)) := by
    funext row
    simpa only [sourceModeWave_actual,Matrix.cons_val_one,Matrix.cons_val_zero,Pi.smul_apply] using
      (sourceHarmonicProfile_coefficients s 1 row x).1
  change (2:ℂ)⁻¹ • (complexCoefficients (originalComplexDirection (sourceHarmonicProfile s 1 x)) j+
    (shiftCoefficients (complexCoefficients (originalComplexDirection (sourceHarmonicProfile s 0 x))) (-s.wave) j).adjoint)=_
  rw [positive,negative,shift_smul]
  exact sourceHarmonic_reader_phase s x j

/-- The actual positive field profile and independent negative profile's adjoint generate the same positive force character. -/
theorem sourceHarmonicProfile_force (s : SourceHarmonicOccurrence) (x : Position) (j : Fin 4) :
    complexFrequencyCoefficients (originalComplexDirection (sourceHarmonicProfile s 2 x)) j=
      phase s.wave x • complexFrequencyCoefficients (sourceHarmonicTransfers s).2.positive j ∧
    (complexFrequencyCoefficients (originalComplexDirection (sourceHarmonicProfile s 3 x)) j).adjoint=
      phase s.wave x • adjointCoefficients (complexFrequencyCoefficients (sourceHarmonicTransfers s).2.negative) j := by
  have positive:= (sourceHarmonicProfile_coefficients s 2 j x).2
  have negative:= (sourceHarmonicProfile_coefficients s 3 j x).2
  simp [sourceModeWave,sourceModeTransfer] at positive negative
  constructor
  · exact positive
  · rw [negative]
    exact sourceHarmonic_negative_phase s x j

/-- The two actual mixed field profiles have zero total character; the complete direct contact coefficients are preserved. -/
theorem sourceHarmonicProfile_contact (s : SourceHarmonicOccurrence) (x : Position) (j : Fin 4) :
    realMixedCoefficients (sourceHarmonicProfileTransfers s x).1 (sourceHarmonicProfileTransfers s x).2 j=
      realMixedCoefficients (sourceHarmonicTransfers s).1 (sourceHarmonicTransfers s).2 j := by
  have forward:=sourceHarmonicProfile_mixed s 1 2 j x
  have reverse:=sourceHarmonicProfile_mixed s 0 3 j x
  simp [sourceModeWave,sourceModeTransfer,phase_zero] at forward reverse
  change (2:ℂ)⁻¹ •
    (complexMixedCoefficients (originalComplexDirection (sourceHarmonicProfile s 1 x))
      (originalComplexDirection (sourceHarmonicProfile s 2 x)) j+
      (complexMixedCoefficients (originalComplexDirection (sourceHarmonicProfile s 0 x))
        (originalComplexDirection (sourceHarmonicProfile s 3 x)) j).adjoint)=_
  rw [forward,reverse]
  rfl

def sourceHarmonicKernel (s : SourceHarmonicOccurrence) (time age : ℝ) : FullMatterL2→L[ℂ]FullMatterL2 :=
  let A:=(sourceHarmonicTransfers s).1
  let B:=(sourceHarmonicTransfers s).2
  let J:=realReaderCoefficients A s.wave
  let backward:=shiftCoefficients (adjointCoefficients (complexFrequencyCoefficients B.negative)) s.wave
  Complex.I • (harmonicWord backward J s.wave (-s.wave) age time-
    harmonicWord J (complexFrequencyCoefficients B.positive) (-s.wave) s.wave time age)

def sourceHarmonicContact (s : SourceHarmonicOccurrence) (time : ℝ) : FullMatterL2→L[ℂ]FullMatterL2 :=
  harmonicContact (realMixedCoefficients (sourceHarmonicTransfers s).1 (sourceHarmonicTransfers s).2)
    (s.wave+(-s.wave)) time

/-- The signed source characters generate the original positive and negative momentum orders. -/
theorem sourceHarmonicKernel_return (s : SourceHarmonicOccurrence) (time age : ℝ) :
    sourceHarmonicKernel s time age=
      fieldTwoTimeKernel (sourceHarmonicTransfers s).1 (sourceHarmonicTransfers s).2 s.wave time age := by
  have reverse:=harmonicWord_opposite
    (shiftCoefficients (adjointCoefficients (complexFrequencyCoefficients (sourceHarmonicTransfers s).2.negative)) s.wave)
    (realReaderCoefficients (sourceHarmonicTransfers s).1 s.wave) (-s.wave) age time
  simp only [neg_neg] at reverse
  simp only [sourceHarmonicKernel,fieldTwoTimeKernel,reverse,harmonicWord_opposite]

/-- Opposite characters cancel their total wave, but the direct mixed contact itself remains. -/
theorem sourceHarmonicContact_return (s : SourceHarmonicOccurrence) (time : ℝ) :
    sourceHarmonicContact s time=
      fieldMixedContact (sourceHarmonicTransfers s).1 (sourceHarmonicTransfers s).2 time := by
  rw [sourceHarmonicContact,add_neg_cancel,harmonicContact_zero]
  rfl

def sourceHarmonicPair (s : SourceHarmonicOccurrence) (sideL edgeL sideR edgeR : Fin 2)
    (time age : ℝ) : ℂ × ℂ :=
  (sourceActualScatteringRead sideL edgeL sideR edgeR (sourceHarmonicKernel s time age),
    sourceActualScatteringRead sideL edgeL sideR edgeR (sourceHarmonicContact s time))

/-- This is the original actual packet and complete CAR pair with the transfer generated from the common source mode. -/
theorem sourceHarmonicPair_return (s : SourceHarmonicOccurrence) (sideL edgeL sideR edgeR : Fin 2)
    (time age : ℝ) :
    sourceHarmonicPair s sideL edgeL sideR edgeR time age=
      sourceUnitFieldScattering sideL edgeL sideR edgeR (sourceHarmonicLeg s) s.wave time age := by
  rw [sourceHarmonicPair,sourceHarmonicKernel_return,sourceHarmonicContact_return]
  rfl

def sourceHarmonicParameters (s : SourceHarmonicOccurrence) : SourceFieldParameters :=
  (((sourceHarmonicField s 0,sourceHarmonicField s 1),(sourceHarmonicField s 2,sourceHarmonicField s 3)),s.wave)

private theorem parameterPair (s : SourceHarmonicOccurrence) (sideL edgeL sideR edgeR : Fin 2) (time age : ℝ) :
    sourceHarmonicPair s sideL edgeL sideR edgeR time age=
      sourceParameterPair sideL edgeL sideR edgeR (sourceHarmonicParameters s) time age := by
  rw [sourceHarmonicPair_return]
  rfl

def sourceHarmonicEnergy (s : SourceHarmonicOccurrence) (i : Fin 4) : ℝ := -(s.frequency i).val.im

def sourceHarmonicDamping (s : SourceHarmonicOccurrence) (i : Fin 4) : ℝ := (s.frequency i).val.re

theorem sourceHarmonicDamping_positive (s : SourceHarmonicOccurrence) (i : Fin 4) :
    0<sourceHarmonicDamping s i := by
  have domain:=(s.frequency i).property
  simp only [CausalFrequency,Set.mem_ofPred_eq] at domain
  exact domain.1

/-- Lambda keeps its original Laplace-test meaning; its generated eta/E read uses the same physical time. -/
theorem sourceHarmonic_time_weight (s : SourceHarmonicOccurrence) (i : Fin 4) (time : ℝ) :
    temporalWeight (sourceHarmonicEnergy s i) (sourceHarmonicDamping s i) time=
      laplaceWeight (s.frequency i).val time := by
  have scalar : -(sourceHarmonicDamping s i:ℂ)+Complex.I*(sourceHarmonicEnergy s i:ℂ)= -(s.frequency i).val := by
    apply Complex.ext <;> simp [sourceHarmonicEnergy,sourceHarmonicDamping]
  simp only [temporalWeight,Fermion.retardedMode,sub_zero,scalar,laplaceWeight]

