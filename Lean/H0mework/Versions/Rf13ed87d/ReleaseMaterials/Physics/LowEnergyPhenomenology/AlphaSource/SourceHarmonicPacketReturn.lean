elab "paidHarmonicAge" : term => do
  let wanted := `LowEnergy.PreparationPhysicalFiniteObservationSoftReturn.pair_age_continuous
  let names := (← getEnv).constants.toList.filterMap fun (name,_) =>
    if name.toString.startsWith "_private.H0mework.Versions.Rf13ed87d.ReleaseMaterials.Physics.LowEnergyPhenomenology.AlphaSource.SourceFiniteObservationSoftLimit." && privateToUserName name == wanted then some name else none
  match names with
  | [name] =>
    logInfo m!"Original private payer: {name}"
    return mkConst name
  | _ => throwError "Expected unique SourceFiniteObservationSoftLimit actual packet continuity payer"

theorem sourceHarmonicPair_age_continuous (s : SourceHarmonicOccurrence) (sideL edgeL sideR edgeR : Fin 2) :
    Continuous (fun age=>(sourceHarmonicPair s sideL edgeL sideR edgeR s.T age).1) := by
  simp_rw [sourceHarmonicPair_return]
  exact (paidHarmonicAge) sideL edgeL sideR edgeR
    (sourceHarmonicTransfers s).1 (sourceHarmonicTransfers s).2 s.wave s.T

/-- One original finite current window and its own source lambda define the observation; contact stays outside age integration. -/
def sourceHarmonicWindow (s : SourceHarmonicOccurrence) (i : Fin 4) (sideL edgeL sideR edgeR : Fin 2) : ℂ × ℂ :=
  (∫age in (0:ℝ)..s.T,laplaceWeight (s.frequency i).val (s.T-age)*
      (sourceHarmonicPair s sideL edgeL sideR edgeR s.T age).1,
    (sourceHarmonicPair s sideL edgeL sideR edgeR s.T s.T).2)

theorem sourceHarmonicWindow_integrable (s : SourceHarmonicOccurrence) (i : Fin 4)
    (sideL edgeL sideR edgeR : Fin 2) :
    IntervalIntegrable (fun age=>laplaceWeight (s.frequency i).val (s.T-age)*
      (sourceHarmonicPair s sideL edgeL sideR edgeR s.T age).1) volume 0 s.T := by
  simp_rw [←sourceHarmonic_time_weight s i]
  exact (((temporalWeight_continuous _ _).comp (continuous_const.sub continuous_id)).mul
    (sourceHarmonicPair_age_continuous s sideL edgeL sideR edgeR)).intervalIntegrable 0 s.T

/-- The generated physical energy/damping and generated transfer reach the original actual packet pair, without any limit interchange. -/
theorem sourceHarmonicWindow_return (s : SourceHarmonicOccurrence) (i : Fin 4)
    (sideL edgeL sideR edgeR : Fin 2) :
    sourceHarmonicWindow s i sideL edgeL sideR edgeR=
      (∫age in (0:ℝ)..s.T,temporalWeight (sourceHarmonicEnergy s i) (sourceHarmonicDamping s i) (s.T-age)*
        (sourceUnitFieldScattering sideL edgeL sideR edgeR (sourceHarmonicLeg s) s.wave s.T age).1,
      (sourceUnitFieldScattering sideL edgeL sideR edgeR (sourceHarmonicLeg s) s.wave s.T s.T).2) := by
  simp only [sourceHarmonicWindow,sourceHarmonic_time_weight,sourceHarmonicPair_return]

/-- Original fullfield coefficient prices and actual packet norms pay the compact observation bound. -/
theorem sourceHarmonicWindow_bound (s : SourceHarmonicOccurrence) (i : Fin 4)
    (sideL edgeL sideR edgeR : Fin 2) :
    ‖(sourceHarmonicWindow s i sideL edgeL sideR edgeR).1‖≤
      s.T*((sourceScatteringGrowth s.T)^3*(sourceParameterPrice sideL edgeL sideR edgeR (sourceHarmonicParameters s)).1) ∧
    ‖(sourceHarmonicWindow s i sideL edgeL sideR edgeR).2‖≤
      (sourceScatteringGrowth s.T)^2*(sourceParameterPrice sideL edgeL sideR edgeR (sourceHarmonicParameters s)).2 := by
  constructor
  · simp only [sourceHarmonicWindow]
    have estimate : ∀ᵐ age ∂volume.restrict (Ioc 0 s.T),
        ‖laplaceWeight (s.frequency i).val (s.T-age)*(sourceHarmonicPair s sideL edgeL sideR edgeR s.T age).1‖≤
          (sourceScatteringGrowth s.T)^3*(sourceParameterPrice sideL edgeL sideR edgeR (sourceHarmonicParameters s)).1 := by
      filter_upwards [ae_restrict_mem measurableSet_Ioc] with age hage
      have weight : ‖laplaceWeight (s.frequency i).val (s.T-age)‖≤1 := by
        rw [←sourceHarmonic_time_weight s i,temporalWeight_norm]
        exact Real.exp_le_one_iff.mpr (mul_nonpos_of_nonpos_of_nonneg
          (neg_nonpos.mpr (sourceHarmonicDamping_positive s i).le) (sub_nonneg.mpr hage.2))
      rw [norm_mul,parameterPair]
      exact (mul_le_mul weight
        (sourceParameterPair_window_bound sideL edgeL sideR edgeR (sourceHarmonicParameters s) s.T age s.future
          ⟨hage.1.le,hage.2⟩).1 (norm_nonneg _) (by norm_num)).trans_eq (one_mul _)
    have generated:=intervalIntegral.norm_integral_le_of_norm_le s.future
      ((ae_restrict_iff' measurableSet_Ioc).mp estimate)
      (intervalIntegrable_const (c:=(sourceScatteringGrowth s.T)^3*
        (sourceParameterPrice sideL edgeL sideR edgeR (sourceHarmonicParameters s)).1))
    simpa only [intervalIntegral.integral_const,sub_zero,smul_eq_mul] using generated
  · simp only [sourceHarmonicWindow,parameterPair]
    exact (sourceParameterPair_window_bound sideL edgeL sideR edgeR (sourceHarmonicParameters s) s.T s.T s.future
      ⟨s.future,le_rfl⟩).2

