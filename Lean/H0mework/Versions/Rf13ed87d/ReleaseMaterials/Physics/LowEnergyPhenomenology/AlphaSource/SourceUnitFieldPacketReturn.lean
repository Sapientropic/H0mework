/-- The Gauss source returns actual fields; the physical packet consumer receives those fields without a carrier identification. -/
def sourceUnitFieldTransfers (legs : Fin 4→SourceUnitFieldLeg) : TransferPair × TransferPair :=
  (originalTransferPair (sourceUnitCompleteField (legs 0)) (sourceUnitCompleteField (legs 1)),
    originalTransferPair (sourceUnitCompleteField (legs 2)) (sourceUnitCompleteField (legs 3)))

attribute [local irreducible] sourceUnitCompleteField sourceUnitFieldTransfers sourceUnitRawForcing

def sourceUnitFieldScattering (sideL edgeL sideR edgeR : Fin 2) (legs : Fin 4→SourceUnitFieldLeg)
    (shift : PhysicalMomentum) (time age : ℝ) : ℂ × ℂ :=
  sourcePreparedScatteringPair sideL edgeL sideR edgeR
    (sourceUnitFieldTransfers legs).1 (sourceUnitFieldTransfers legs).2 shift time age

/-- Every field supplied to the physical consumer satisfies the full original source equation with its actual nine-row supplement. -/
theorem sourceUnitFieldScattering_inputs (legs : Fin 4→SourceUnitFieldLeg) :
    ∀i : Fin 4,
      originalJacobi (sourceUnitFieldPoint (legs i)).val*ᵥsourceUnitCompleteField (legs i)=
        sourceUnitRawForcing (legs i)+sourceUnitConstraintSupplement (legs i) ∧
      sourceCompatibility (sourceUnitFieldPoint (legs i)).val (sourceUnitCompatibleForcing (legs i))=0 := by
  intro i
  exact ⟨sourceUnitCompleteField_equation (legs i),sourceUnitCompatibleForcing_compatible (legs i)⟩

/-- Both full16 CAR orders and the independently timed direct mixed contact are read on the original actual charged packet. -/
theorem sourceUnitFieldScattering_fullCAR (sideL edgeL sideR edgeR : Fin 2) (legs : Fin 4→SourceUnitFieldLeg)
    (shift : PhysicalMomentum) (time age : ℝ) :
    sourceUnitFieldScattering sideL edgeL sideR edgeR legs shift time age=
      (Complex.I*((∑i : Fin 4,∑j : Fin 4,sourcePreparedOrderedCAR sideL edgeL sideR edgeR
        (shiftCoefficients (adjointCoefficients (complexFrequencyCoefficients (sourceUnitFieldTransfers legs).2.negative)) shift)
        (realReaderCoefficients (sourceUnitFieldTransfers legs).1 shift) (-shift) age time i j)-
        ∑i : Fin 4,∑j : Fin 4,sourcePreparedOrderedCAR sideL edgeL sideR edgeR
          (realReaderCoefficients (sourceUnitFieldTransfers legs).1 shift)
          (complexFrequencyCoefficients (sourceUnitFieldTransfers legs).2.positive) shift time age i j),
        inner ℂ (sourceActualScatteringInput sideL edgeL)
          (fieldMixedContact (sourceUnitFieldTransfers legs).1 (sourceUnitFieldTransfers legs).2 time
            (sourceActualScatteringInput sideR edgeR))) :=
  sourcePreparedScatteringPair_fullCAR sideL edgeL sideR edgeR
    (sourceUnitFieldTransfers legs).1 (sourceUnitFieldTransfers legs).2 shift time age

/-- The same complete source fields are consumed by the original independent physical Fourier pole amplitudes and all cross terms. -/
theorem sourceUnitFieldScattering_poles (sideL edgeL sideR edgeR : Fin 2) (legs : Fin 4→SourceUnitFieldLeg)
    (shift : PhysicalMomentum) (time age : ℝ) :
    sourceUnitFieldScattering sideL edgeL sideR edgeR legs shift time age=
      (Complex.I*((∑i : Fin 4,∑j : Fin 4,∫k,sourceActualOrderedPoleIntegrand sideL edgeL sideR edgeR
        (shiftCoefficients (adjointCoefficients (complexFrequencyCoefficients (sourceUnitFieldTransfers legs).2.negative)) shift)
        (realReaderCoefficients (sourceUnitFieldTransfers legs).1 shift) (-shift) age time i j k)-
        ∑i : Fin 4,∑j : Fin 4,∫k,sourceActualOrderedPoleIntegrand sideL edgeL sideR edgeR
          (realReaderCoefficients (sourceUnitFieldTransfers legs).1 shift)
          (complexFrequencyCoefficients (sourceUnitFieldTransfers legs).2.positive) shift time age i j k),
        ∑j : Fin 4,∫k,sourceActualContactPoleIntegrand sideL edgeL sideR edgeR
          (realMixedCoefficients (sourceUnitFieldTransfers legs).1 (sourceUnitFieldTransfers legs).2) time j k) :=
  sourcePreparedScatteringPair_poles sideL edgeL sideR edgeR
    (sourceUnitFieldTransfers legs).1 (sourceUnitFieldTransfers legs).2 shift time age

/-- The actual physical domain prices are retained for these generated fields, with contact outside the age kernel. -/
theorem sourceUnitFieldScattering_bound (sideL edgeL sideR edgeR : Fin 2) (legs : Fin 4→SourceUnitFieldLeg)
    (shift : PhysicalMomentum) (time age : ℝ) :
    ‖(sourceUnitFieldScattering sideL edgeL sideR edgeR legs shift time age).1‖≤
      (sourceScatteringPairDomainPrice sideL edgeL sideR edgeR
        (sourceUnitFieldTransfers legs).1 (sourceUnitFieldTransfers legs).2 shift time age).1 ∧
    ‖(sourceUnitFieldScattering sideL edgeL sideR edgeR legs shift time age).2‖≤
      (sourceScatteringPairDomainPrice sideL edgeL sideR edgeR
        (sourceUnitFieldTransfers legs).1 (sourceUnitFieldTransfers legs).2 shift time age).2 :=
  sourcePreparedScatteringPair_domain_bound sideL edgeL sideR edgeR
    (sourceUnitFieldTransfers legs).1 (sourceUnitFieldTransfers legs).2 shift time age

