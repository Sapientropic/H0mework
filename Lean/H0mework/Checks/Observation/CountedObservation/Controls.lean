-- The original consumer exposes the complete counted-source contract at normal and next.
example (runtime : LivingRuntimeState process) :
    SourceCountedObservation.StageLaw (runtime.advance (frontier runtime).stageCount) ((frontier runtime).history.stageAt (Fin.last (frontier runtime).stageCount)) := by
  have paid := SourceCopyObservation.current_consumed runtime
  dsimp only [SourceCopyObservation.CurrentAt] at paid
  have generated : type_of% (SourceCopyNativeModelStep.calculation_consumed runtime) := by
    with_reducible exact paid.2.2.2.2.2.2.2.2.2
  have source : type_of% (SourceCopyNativeModelStep.normal_native_keys runtime) := by
    with_reducible exact generated.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1
  dsimp only [SourceConditionalNativeKeys.StageLaw] at source
  have counted := (source.1 0).2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2
  exact counted

