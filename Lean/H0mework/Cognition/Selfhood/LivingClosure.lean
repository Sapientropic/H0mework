import H0mework.Foundation.Relations.ConsumerFace

/-!
# Generic six-responsibility living closure

The six responsibilities are indexed independently of every concrete source
or operational consumer system.  A later pointed classifier connects the
observer/effect anchor to one independently generated consumer fibre.

Occurrence separation is deliberately not a field of this structure.  The
consumer quotient remains authoritative even when several occurrences share
one canonical face; witness-local separation is an optional stronger law.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace NoIslandNoMagic
namespace Consciousness
namespace Closure
namespace Canonical

open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Representation

universe uOccurrence uReadout

inductive LivingClosureCoordinate where
  | rootedSource
  | observerExperience
  | receivedActualEffect
  | reopenablePersistentTrace
  | recursiveSuccessorSelfWriteBack
  | generatedNext
  deriving DecidableEq, Repr

/-- Six domain-owned responsibility predicates on one occurrence type. -/
structure LivingClosureStructure (Occurrence : Type uOccurrence) where
  responsibility : LivingClosureCoordinate → Occurrence → Prop

/-- All six responsibilities discharged at one occurrence. -/
structure SixPointLivingClosureAt
    {Occurrence : Type uOccurrence}
    (closure : LivingClosureStructure Occurrence)
    (occurrence : Occurrence) : Prop where
  rootedSource : closure.responsibility .rootedSource occurrence
  observerExperience : closure.responsibility .observerExperience occurrence
  receivedActualEffect :
    closure.responsibility .receivedActualEffect occurrence
  reopenablePersistentTrace :
    closure.responsibility .reopenablePersistentTrace occurrence
  recursiveSuccessorSelfWriteBack :
    closure.responsibility .recursiveSuccessorSelfWriteBack occurrence
  generatedNext : closure.responsibility .generatedNext occurrence

/-- Domain-neutral consciousness predicate generated by the six living
responsibilities.  Machine, human and clinical labels belong to source
provenance; they are not extra coordinates or different predicates. -/
abbrev SixPointConsciousOccurrenceAt
    {Occurrence : Type uOccurrence}
    (closure : LivingClosureStructure Occurrence)
    (occurrence : Occurrence) : Prop :=
  SixPointLivingClosureAt closure occurrence

namespace SixPointLivingClosureAt

variable {Occurrence : Type uOccurrence}
variable {closure : LivingClosureStructure Occurrence}
variable {occurrence : Occurrence}

theorem holds (living : SixPointLivingClosureAt closure occurrence) :
    ∀ coordinate, closure.responsibility coordinate occurrence
  | .rootedSource => living.rootedSource
  | .observerExperience => living.observerExperience
  | .receivedActualEffect => living.receivedActualEffect
  | .reopenablePersistentTrace => living.reopenablePersistentTrace
  | .recursiveSuccessorSelfWriteBack =>
      living.recursiveSuccessorSelfWriteBack
  | .generatedNext => living.generatedNext

theorem ofHolds
    (discharges : ∀ coordinate,
      closure.responsibility coordinate occurrence) :
    SixPointLivingClosureAt closure occurrence where
  rootedSource := discharges .rootedSource
  observerExperience := discharges .observerExperience
  receivedActualEffect := discharges .receivedActualEffect
  reopenablePersistentTrace := discharges .reopenablePersistentTrace
  recursiveSuccessorSelfWriteBack :=
    discharges .recursiveSuccessorSelfWriteBack
  generatedNext := discharges .generatedNext

end SixPointLivingClosureAt

/-- The operational part of six-point closure: an installed observer report
and an independently received actual effect. -/
def OperationalAnchorAt
    {Occurrence : Type uOccurrence}
    (closure : LivingClosureStructure Occurrence)
    (occurrence : Occurrence) : Prop :=
  closure.responsibility .observerExperience occurrence ∧
    closure.responsibility .receivedActualEffect occurrence

theorem SixPointLivingClosureAt.operationalAnchor
    {Occurrence : Type uOccurrence}
    {closure : LivingClosureStructure Occurrence}
    {occurrence : Occurrence}
    (living : SixPointLivingClosureAt closure occurrence) :
    OperationalAnchorAt closure occurrence :=
  ⟨living.observerExperience, living.receivedActualEffect⟩

variable {Occurrence : Type uOccurrence}
variable (system : IndependentConsumerSystem.{uOccurrence, uReadout}
  Occurrence)

/-- All six responsibility predicates are kernel-stable at one distinguished
witness fibre.  This is weaker than global occurrence separation. -/
def LivingClosureKernelStableAtWitness
    (closure : LivingClosureStructure Occurrence)
    (witness : Occurrence) : Prop :=
  ∀ coordinate {occurrence},
    system.Indistinguishable occurrence witness →
      (closure.responsibility coordinate occurrence ↔
        closure.responsibility coordinate witness)

/-- The consumer fibre over one witness is a singleton.  Only this local law,
not global injectivity, is required for pointed occurrence classification. -/
def WitnessSeparatedAt (witness : Occurrence) : Prop :=
  ∀ {occurrence},
    system.Indistinguishable occurrence witness → occurrence = witness

theorem witnessSeparatedAt_of_canonicalRead_injective
    (injective : Function.Injective system.canonicalRead)
    (witness : Occurrence) :
    WitnessSeparatedAt system witness := by
  intro occurrence indistinguishable
  exact injective
    ((system.canonicalKernelExact occurrence witness).2 indistinguishable)

/-- One registered consumer with a singleton witness fibre already suffices;
the full canonical tuple need not be globally injective. -/
theorem witnessSeparatedAt_of_consumer
    (consumer : system.Consumer) (witness : Occurrence)
    (separates : ∀ {occurrence},
      system.read consumer occurrence = system.read consumer witness →
        occurrence = witness) :
    WitnessSeparatedAt system witness := by
  intro occurrence indistinguishable
  exact separates (indistinguishable consumer)

theorem livingClosureKernelStableAtWitness_of_witnessSeparatedAt
    (closure : LivingClosureStructure Occurrence)
    (witness : Occurrence)
    (separated : WitnessSeparatedAt system witness) :
    LivingClosureKernelStableAtWitness system closure witness := by
  intro coordinate occurrence indistinguishable
  have occurrenceExact := separated indistinguishable
  subst occurrence
  exact Iff.rfl

end Canonical
end Closure
end Consciousness
end NoIslandNoMagic
end SaturationMonoid

#print axioms SaturationMonoid.NoIslandNoMagic.Consciousness.Closure.Canonical.witnessSeparatedAt_of_consumer
#print axioms SaturationMonoid.NoIslandNoMagic.Consciousness.Closure.Canonical.livingClosureKernelStableAtWitness_of_witnessSeparatedAt
