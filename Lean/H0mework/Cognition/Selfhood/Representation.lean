/-!
# Canonical generated selfhood and personality crown

Selfhood is a pointed living occurrence together with its generated-actor
readout.  Personality is the canonical range of an independently fixed
consumer family on the same occurrence domain.  Neither a narrative, a role,
a parameter vector nor the personality code is allowed to manufacture actor
identity.

The file separates three exact questions:

* whether an occurrence is a six-responsibility living self;
* whether two occurrences carry the same generated actor;
* whether independent personality consumers distinguish them.

The consumer quotient supplies the minimal complete personality carrier.
Actor identity factors through that carrier exactly when it respects the
personality kernel; the converse stability direction is stated separately.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace NoIslandNoMagic
namespace Consciousness
namespace Selfhood
namespace Canonical

open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Closure.Canonical
open _root_.SaturationMonoid.NoIslandNoMagic.Consciousness.Representation

universe uOccurrence uActor uReadout uOutput uNarrative uAtom

/-- Domain-neutral selfhood interface.  The actor readout is supplied by the
domain source; this interface itself does not generate an actor or a living
occurrence. -/
structure LivingSelfhoodStructure
    (Occurrence : Type uOccurrence) (Actor : Type uActor) where
  closure : LivingClosureStructure Occurrence
  actorRead : Occurrence → Actor

variable {Occurrence : Type uOccurrence} {Actor : Type uActor}

namespace LivingSelfhoodStructure

variable (selfhood : LivingSelfhoodStructure Occurrence Actor)

/-- One actual occurrence discharges the full living-self responsibility
contract. -/
abbrev SelfAt (occurrence : Occurrence) : Prop :=
  SixPointLivingClosureAt selfhood.closure occurrence

/-- Descriptive identity at one fixed occurrence domain is equality of the
domain-generated actor readout, never equality of personality or narrative
projections by definition. -/
def SameSelfAt (left right : Occurrence) : Prop :=
  selfhood.actorRead left = selfhood.actorRead right

def DifferentSelfAt (left right : Occurrence) : Prop :=
  selfhood.actorRead left ≠ selfhood.actorRead right

theorem SelfAt.recursiveSelfWriteBack
    {occurrence : Occurrence} (self : selfhood.SelfAt occurrence) :
    selfhood.closure.responsibility .recursiveSuccessorSelfWriteBack
      occurrence :=
  self.recursiveSuccessorSelfWriteBack

theorem SelfAt.generatedNextResponsibility
    {occurrence : Occurrence} (self : selfhood.SelfAt occurrence) :
    selfhood.closure.responsibility .generatedNext occurrence :=
  self.generatedNext

end LivingSelfhoodStructure

/-! ## Canonical personality representation -/

variable (system : IndependentConsumerSystem.{uOccurrence, uReadout}
  Occurrence)

/-- The abstract personality code is exactly the independent-consumer
quotient. -/
abbrev PersonalityCode := system.Quotient

/-- The authoritative concrete personality carrier contains only tuples
actually generated by occurrences. -/
abbrev PersonalityCarrier := Set.range system.canonicalRead

/-- Equality at the registered personality resolution. -/
def SamePersonalityAt (left right : Occurrence) : Prop :=
  system.Indistinguishable left right

def DifferentPersonalityAt (left right : Occurrence) : Prop :=
  ¬ SamePersonalityAt system left right

@[simp] theorem samePersonality_iff_canonicalRead_eq
    (left right : Occurrence) :
    SamePersonalityAt system left right ↔
      system.canonicalRead left = system.canonicalRead right :=
  (system.canonicalRead_eq_iff_indistinguishable left right).symm

/-- Same generated actor, but a personality consumer detects change. -/
def PersonalityChangeWithinSelfAt
  (selfhood : LivingSelfhoodStructure Occurrence Actor)
    (left right : Occurrence) : Prop :=
  selfhood.SameSelfAt left right ∧
    DifferentPersonalityAt system left right

/-- Same personality code, but the domain-generated actors differ. -/
def SamePersonalityDifferentSelfAt
  (selfhood : LivingSelfhoodStructure Occurrence Actor)
    (left right : Occurrence) : Prop :=
  SamePersonalityAt system left right ∧ selfhood.DifferentSelfAt left right

/-- Personality determines actor identity exactly when the actor readout is
constant on every personality-consumer fibre. -/
def PersonalityDeterminesSelf
    (selfhood : LivingSelfhoodStructure Occurrence Actor) : Prop :=
  system.ReadoutCompatible selfhood.actorRead

/-- One actor has stable personality exactly when actor equality forces
equality under every registered personality consumer. -/
def PersonalityStableWithinSelf
  (selfhood : LivingSelfhoodStructure Occurrence Actor) : Prop :=
  ∀ {left right}, selfhood.SameSelfAt left right →
    SamePersonalityAt system left right

/-- Exact coincidence of the self-identity and personality kernels. -/
def SelfPersonalityKernelExact
  (selfhood : LivingSelfhoodStructure Occurrence Actor) : Prop :=
  ∀ left right,
    selfhood.SameSelfAt left right ↔ SamePersonalityAt system left right

/-- Self identity and personality stability vary independently.  These four
cases exhaust one fixed pair of actual occurrences without declaring any case
to be a world update. -/
def SelfPersonalityChangeDispositionAt
    (selfhood : LivingSelfhoodStructure Occurrence Actor)
    (left right : Occurrence) : Prop :=
  (selfhood.SameSelfAt left right ∧
      SamePersonalityAt system left right) ∨
    (selfhood.SameSelfAt left right ∧
      DifferentPersonalityAt system left right) ∨
    (selfhood.DifferentSelfAt left right ∧
      SamePersonalityAt system left right) ∨
    (selfhood.DifferentSelfAt left right ∧
      DifferentPersonalityAt system left right)

theorem selfPersonalityChange_exhaustive
    (selfhood : LivingSelfhoodStructure Occurrence Actor)
    (left right : Occurrence) :
    SelfPersonalityChangeDispositionAt system selfhood left right := by
  classical
  by_cases sameSelf : selfhood.SameSelfAt left right
  · by_cases samePersonality : SamePersonalityAt system left right
    · exact Or.inl ⟨sameSelf, samePersonality⟩
    · exact Or.inr (Or.inl ⟨sameSelf, samePersonality⟩)
  · by_cases samePersonality : SamePersonalityAt system left right
    · exact Or.inr (Or.inr (Or.inl ⟨sameSelf, samePersonality⟩))
    · exact Or.inr (Or.inr (Or.inr ⟨sameSelf, samePersonality⟩))

theorem livingSelfPersonalityTransition_closed
    (selfhood : LivingSelfhoodStructure Occurrence Actor)
    {left right : Occurrence}
    (_sourceSelf : selfhood.SelfAt left)
    (targetSelf : selfhood.SelfAt right) :
    SelfPersonalityChangeDispositionAt system selfhood left right ∧
      selfhood.closure.responsibility .generatedNext right :=
  ⟨selfPersonalityChange_exhaustive system selfhood left right,
    targetSelf.generatedNextResponsibility⟩

theorem personalityDeterminesSelf_iff
    (selfhood : LivingSelfhoodStructure Occurrence Actor) :
    PersonalityDeterminesSelf system selfhood ↔
      ∀ {left right}, SamePersonalityAt system left right →
        selfhood.SameSelfAt left right :=
  Iff.rfl

theorem selfPersonalityKernelExact_iff
    (selfhood : LivingSelfhoodStructure Occurrence Actor) :
    SelfPersonalityKernelExact system selfhood ↔
      PersonalityDeterminesSelf system selfhood ∧
        PersonalityStableWithinSelf system selfhood := by
  constructor
  · intro exact
    constructor
    · intro left right samePersonality
      exact (exact left right).2 samePersonality
    · intro left right sameSelf
      exact (exact left right).1 sameSelf
  · rintro ⟨determines, stable⟩ left right
    exact ⟨stable, determines⟩

/-- Actor identity has a unique readout on personality space iff personality
consumers determine it. -/
theorem personalityDeterminesSelf_iff_uniqueFactorization
    (selfhood : LivingSelfhoodStructure Occurrence Actor) :
    PersonalityDeterminesSelf system selfhood ↔
      ∃! factor : PersonalityCarrier system → Actor,
        ∀ occurrence,
          factor ⟨system.canonicalRead occurrence, occurrence, rfl⟩ =
            selfhood.actorRead occurrence :=
  system.readoutCompatible_iff_uniqueFactorization selfhood.actorRead

/-- A trace-constrained narrative determines self only under this additional
kernel condition; trace support alone does not imply it. -/
def NarrativeDeterminesSelf
    (selfhood : LivingSelfhoodStructure Occurrence Actor)
    {Narrative : Type uNarrative} {Atom : Type uAtom}
    (narrative :
      _root_.SaturationMonoid.ProcessGame.Society.History.TraceConstrainedNarrativeReadout
        Occurrence Narrative Atom) : Prop :=
  ∀ {left right}, narrative.narrative left = narrative.narrative right →
    selfhood.SameSelfAt left right

def NarrativeCompatibleWithPersonality
    {Narrative : Type uNarrative} {Atom : Type uAtom}
    (narrative :
      _root_.SaturationMonoid.ProcessGame.Society.History.TraceConstrainedNarrativeReadout
        Occurrence Narrative Atom) : Prop :=
  system.ReadoutCompatible narrative.narrative

theorem narrativeCompatible_iff_uniqueFactorization
    {Narrative : Type uNarrative} {Atom : Type uAtom}
    (narrative :
      _root_.SaturationMonoid.ProcessGame.Society.History.TraceConstrainedNarrativeReadout
        Occurrence Narrative Atom) :
    NarrativeCompatibleWithPersonality system narrative ↔
      ∃! factor : PersonalityCarrier system → Narrative,
        ∀ occurrence,
          factor ⟨system.canonicalRead occurrence, occurrence, rfl⟩ =
            narrative.narrative occurrence :=
  system.readoutCompatible_iff_uniqueFactorization narrative.narrative

/-- A persona or social role is another dependent readout.  It belongs to
personality only when it respects the personality kernel; even then it does
not define actor identity. -/
def PersonaCompatibleWithPersonality
    {Persona : Type uOutput} (personaRead : Occurrence → Persona) : Prop :=
  system.ReadoutCompatible personaRead

theorem personaCompatible_iff_uniqueFactorization
    {Persona : Type uOutput} (personaRead : Occurrence → Persona) :
    PersonaCompatibleWithPersonality system personaRead ↔
      ∃! factor : PersonalityCarrier system → Persona,
        ∀ occurrence,
          factor ⟨system.canonicalRead occurrence, occurrence, rfl⟩ =
            personaRead occurrence :=
  system.readoutCompatible_iff_uniqueFactorization personaRead

/-- Legal or moral standing is not a personality coordinate by decree.  A
standing readout factors through personality exactly under the same explicit
kernel-compatibility obligation as every other downstream readout. -/
def StandingCompatibleWithPersonality
    {Standing : Type uOutput} (standingRead : Occurrence → Standing) : Prop :=
  system.ReadoutCompatible standingRead

theorem standingCompatible_iff_uniqueFactorization
    {Standing : Type uOutput} (standingRead : Occurrence → Standing) :
    StandingCompatibleWithPersonality system standingRead ↔
      ∃! factor : PersonalityCarrier system → Standing,
        ∀ occurrence,
          factor ⟨system.canonicalRead occurrence, occurrence, rfl⟩ =
            standingRead occurrence :=
  system.readoutCompatible_iff_uniqueFactorization standingRead

/-- A newly grounded readout that splits a personality fibre is the exact
representation diagnostic.  It is not by itself an actual U8 receipt. -/
abbrev PersonalityKernelEscapeAt
    (newReadout : IndependentReadout.{uOccurrence, uReadout} Occurrence) :=
  FaceKernelEscapeAt system.canonicalRead newReadout

theorem personalityKernelEscape_not_factorsThrough
    {newReadout : IndependentReadout.{uOccurrence, uReadout} Occurrence}
    (escape : PersonalityKernelEscapeAt system newReadout) :
    ¬ Function.FactorsThrough newReadout.read system.canonicalRead :=
  escape.not_factorsThrough

theorem personalityRefinedKernelExact
    (newReadout : IndependentReadout.{uOccurrence, uReadout} Occurrence) :
    FaceKernelExactAt (system.adjoin newReadout)
      (refinedFace system.canonicalRead newReadout) :=
  system.canonicalKernelExact.adjoin_refinedFace

/-- Complete generic personality crown.  It is derived only from the fixed
independent consumer family. -/
structure CanonicalSelfPersonalityCrown
    (selfhood : LivingSelfhoodStructure Occurrence Actor) where
  quotientEquivRange : PersonalityCode system ≃ PersonalityCarrier system
  everyConsumerFactorizes : ∀ consumer,
    ∃! factor : PersonalityCarrier system → system.Output consumer,
      ∀ occurrence,
        factor ⟨system.canonicalRead occurrence, occurrence, rfl⟩ =
          system.read consumer occurrence
  actorFactorizationExact :
    PersonalityDeterminesSelf system selfhood ↔
      ∃! factor : PersonalityCarrier system → Actor,
        ∀ occurrence,
          factor ⟨system.canonicalRead occurrence, occurrence, rfl⟩ =
            selfhood.actorRead occurrence

noncomputable def canonicalSelfPersonalityCrown
    (selfhood : LivingSelfhoodStructure Occurrence Actor) :
    CanonicalSelfPersonalityCrown system selfhood where
  quotientEquivRange := system.canonicalQuotientEquivRange
  everyConsumerFactorizes := system.everyConsumer_uniqueFactorization
  actorFactorizationExact :=
    personalityDeterminesSelf_iff_uniqueFactorization system selfhood

/-! ## Generated actor lifecycle as self-identity law -/

namespace Lifecycle

open _root_.SaturationMonoid.ProcessGame
open _root_.SaturationMonoid.ProcessGame.Society.Lifecycle.Universal
open _root_.SaturationMonoid.ResponsibilityLifecycle
open _root_.SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution
open _root_.SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot

universe uSource uState uSeed uVocabulary

variable {Source : Type uSource} {State : Type uState}
variable {occurrenceOf : Source → RootedAccountedUnfolding State}
variable {game : _root_.SaturationMonoid.ProcessGame occurrenceOf}
variable {core : SourceOwnedLifecycleCore.{uSource, uState, uSeed}
  occurrenceOf game}

/-- Identity transport, not state equality, is same-self survival. -/
abbrev SameSelfAcrossAt
    (law : SourceOwnedActorLifecycleLaw core)
    (source : core.SourceActor) (target : core.TargetActor) : Prop :=
  law.SurviveAt source target

/-- Responsibility-bearing succession is kept distinct from survival. -/
abbrev SelfSuccessionAt
    (law : SourceOwnedActorLifecycleLaw core)
    (source : core.SourceActor) (target : core.TargetActor) : Prop :=
  law.SuccessionAt source target

theorem generatedSelfLifecycle_closed
    (law : SourceOwnedActorLifecycleLaw core) :
    SourceOwnedActorLifecycleLaw.ClosedLifecycleClassification law :=
  law.closedLifecycleClassification

theorem generatedSelfLifecycle_link_exhaustive
    (law : SourceOwnedActorLifecycleLaw core)
    {source : core.SourceActor} {target : core.TargetActor}
    (link : core.ActorRelated source target) :
    core.SplitAt source ∨ core.MergeAt target ∨
      SameSelfAcrossAt law source target ∨
        SelfSuccessionAt law source target :=
  law.related_links_exhaustive link

theorem generatedSelfLifecycle_source_exhaustive
    (law : SourceOwnedActorLifecycleLaw core) (source : core.SourceActor) :
    law.SourceSideClassified source :=
  law.source_side_exhaustive source

theorem generatedSelfLifecycle_target_exhaustive
    (law : SourceOwnedActorLifecycleLaw core) (target : core.TargetActor) :
    law.TargetSideClassified target :=
  law.target_side_exhaustive target

def generatedSelfLifecycleWholeCompilation
    (law : SourceOwnedActorLifecycleLaw core) :
    SourceOwnedActorLifecycleLaw.ActualLifecycleCompilation law :=
  law.wholeCompilation

theorem generatedSelfLifecycle_next_eq_target
    (law : SourceOwnedActorLifecycleLaw core) :
    (generatedSelfLifecycleWholeCompilation law).next? =
      some (core.targetFace.state game.source) :=
  law.wholeCompilation_next_eq_target

theorem generatedSelfLifecycleCompilation_unique
    (law : SourceOwnedActorLifecycleLaw core)
    (candidate :
      SourceOwnedActorLifecycleLaw.ActualLifecycleCompilation law) :
    candidate = generatedSelfLifecycleWholeCompilation law :=
  law.compilation_unique candidate

end Lifecycle

