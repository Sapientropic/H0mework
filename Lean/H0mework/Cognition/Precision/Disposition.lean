import Mathlib.Data.Fintype.Card
import Mathlib.SetTheory.Cardinal.Finite
import H0mework.Foundation.Finite.FibreDisposition
import H0mework.Foundation.Relations.ConsumerFace

/-!
# Finite-precision robust consumer realization

The semantic carrier is the existing canonical all-consumer range.  A
source-owned finite codec maps that range into a genuine finite quantized
tensor.  Quantization error and decoder margin generate exact decoding,
injectivity, the cardinality bound and registered-consumer no-false-merge.

The total grammar returns either one verified robust realization or the
complete finite candidate residual with a typed failure for every candidate.
Capacity insufficiency, encode collision, semantic coverage loss, encoded-point
margin failure and unsafe decoding elsewhere inside the margin ball remain
distinct residuals.  No residual is promoted to U8 here.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace LivingCortex
namespace FinitePrecision

open NoIslandNoMagic.Consciousness.Representation
open SourceGeneratedEffectiveFibreDisposition

universe u

/-- Canonical semantic code: the range of all independently registered
consumer coordinates, not the unrestricted dependent function space. -/
abbrev SemanticCode
    {Occurrence : Type u}
    (system : IndependentConsumerSystem.{u, u} Occurrence) :=
  Set.range system.canonicalRead

/-- Canonical semantic code generated by one exact occurrence. -/
def semanticCodeAt
    {Occurrence : Type u}
    (system : IndependentConsumerSystem.{u, u} Occurrence)
    (occurrence : Occurrence) : SemanticCode system :=
  ⟨system.canonicalRead occurrence, occurrence, rfl⟩

/-- One `bits`-wide quantized word. -/
abbrev QuantizedWord (bits : Nat) := Fin (2 ^ bits)

/-- A width-indexed finite tensor of quantized words. -/
abbrev QuantizedTensor (width bits : Nat) :=
  Fin width → QuantizedWord bits

theorem quantizedTensor_card_eq (width bits : Nat) :
    Fintype.card (QuantizedTensor width bits) = 2 ^ (bits * width) := by
  change Fintype.card (Fin width → Fin (2 ^ bits)) = 2 ^ (bits * width)
  rw [Fintype.card_fun]
  simp only [Fintype.card_fin]
  exact (pow_mul 2 bits width).symm

theorem quantizedTensor_natCard_eq (width bits : Nat) :
    Nat.card (QuantizedTensor width bits) = 2 ^ (bits * width) := by
  rw [Nat.card_eq_fintype_card]
  exact quantizedTensor_card_eq width bits

/-- Raw source-owned codec candidate.  It contains maps and an error model,
but no correctness, injectivity, capacity or realization certificate. -/
structure QuantizedConsumerCandidateAt
    {Occurrence : Type u}
    (system : IndependentConsumerSystem.{u, u} Occurrence)
    (width bits : Nat) : Type (u + 1) where
  Ambient : Type u
  semanticPoint : SemanticCode system → Ambient
  encode : SemanticCode system → QuantizedTensor width bits
  dequantize : QuantizedTensor width bits → Ambient
  decode : Ambient → Option (SemanticCode system)
  error : Ambient → Ambient → Nat
  decoderMargin : SemanticCode system → Nat

/-- Robustness certificate for one raw codec.  Exact decode, injection and
capacity are deliberately derived below rather than accepted as fields. -/
structure VerifiedQuantizedConsumerRealizationAt
    {Occurrence : Type u}
    {system : IndependentConsumerSystem.{u, u} Occurrence}
    {width bits : Nat}
    (candidate : QuantizedConsumerCandidateAt system width bits) : Prop where
  quantizationError_lt_margin : (code : SemanticCode system) →
    candidate.error
        (candidate.dequantize (candidate.encode code))
        (candidate.semanticPoint code) <
      candidate.decoderMargin code
  decoderSafeAt : (code : SemanticCode system) →
    (observed : candidate.Ambient) →
    candidate.error observed (candidate.semanticPoint code) <
        candidate.decoderMargin code →
      candidate.decode observed = some code

namespace VerifiedQuantizedConsumerRealizationAt

variable {Occurrence : Type u}
variable {system : IndependentConsumerSystem.{u, u} Occurrence}
variable {width bits : Nat}
variable {candidate : QuantizedConsumerCandidateAt system width bits}

theorem decode_dequantize_encode
    (verified : VerifiedQuantizedConsumerRealizationAt candidate)
    (code : SemanticCode system) :
    candidate.decode (candidate.dequantize (candidate.encode code)) =
      some code :=
  verified.decoderSafeAt code _
    (verified.quantizationError_lt_margin code)

theorem encode_injective
    (verified : VerifiedQuantizedConsumerRealizationAt candidate) :
    Function.Injective candidate.encode := by
  intro left right encoded_eq
  have decoded_eq := congrArg (candidate.decode ∘ candidate.dequantize) encoded_eq
  rw [Function.comp_apply, Function.comp_apply,
    verified.decode_dequantize_encode left,
    verified.decode_dequantize_encode right] at decoded_eq
  exact Option.some.inj decoded_eq

/-- The exact decoder makes the canonical semantic range genuinely finite;
this is a derived instance, not a codec premise. -/
theorem semanticCode_finite
    (verified : VerifiedQuantizedConsumerRealizationAt candidate) :
    Finite (SemanticCode system) :=
  Finite.of_injective candidate.encode verified.encode_injective

/-- Any robust finite realization pays the necessary semantic capacity bound.
The finite tensor makes the semantic range finite through the derived
injection; no `Fintype SemanticCode` premise is accepted. -/
theorem semanticCode_card_le_tensor
    (verified : VerifiedQuantizedConsumerRealizationAt candidate) :
    Nat.card (SemanticCode system) ≤ 2 ^ (bits * width) := by
  calc
    Nat.card (SemanticCode system) ≤ Nat.card (QuantizedTensor width bits) :=
      Nat.card_le_card_of_injective candidate.encode verified.encode_injective
    _ = 2 ^ (bits * width) := quantizedTensor_natCard_eq width bits

/-- Equal finite codes cannot merge two occurrences distinguished by any
registered consumer. -/
theorem encode_eq_implies_registeredConsumers_eq
    (verified : VerifiedQuantizedConsumerRealizationAt candidate)
    {left right : Occurrence}
    (encoded_eq :
      candidate.encode (semanticCodeAt system left) =
        candidate.encode (semanticCodeAt system right))
    (consumer : system.Consumer) :
    system.read consumer left = system.read consumer right := by
  have code_eq := verified.encode_injective encoded_eq
  have face_eq := congrArg Subtype.val code_eq
  exact congrFun face_eq consumer

end VerifiedQuantizedConsumerRealizationAt

/-- Exact typed reasons why one candidate is not a robust realization. -/
inductive QuantizedConsumerRealizationFailureAt
    {Occurrence : Type u}
    {system : IndependentConsumerSystem.{u, u} Occurrence}
    {width bits : Nat}
    (candidate : QuantizedConsumerCandidateAt system width bits) : Type u where
  | capacityInsufficient
      (capacity_lt : 2 ^ (bits * width) < Nat.card (SemanticCode system))
  | encodeCollision
      (left right : SemanticCode system)
      (different : left ≠ right)
      (encoded_eq : candidate.encode left = candidate.encode right)
  | semanticCoverageHole
      (code : SemanticCode system)
      (decode_ne :
        candidate.decode (candidate.dequantize (candidate.encode code)) ≠
          some code)
  | decoderMarginViolation
      (code : SemanticCode system)
      (not_safe :
        ¬ candidate.error
            (candidate.dequantize (candidate.encode code))
            (candidate.semanticPoint code) <
          candidate.decoderMargin code)
  | decoderUnsafeWithinMargin
      (code : SemanticCode system)
      (observed : candidate.Ambient)
      (withinMargin :
        candidate.error observed (candidate.semanticPoint code) <
          candidate.decoderMargin code)
      (decode_ne : candidate.decode observed ≠ some code)

/-- Finite source grammar of codec implementations.  The source evaluator is
responsible for both verified positive candidates and exact typed diagnosis
of every rejected implementation. -/
structure QuantizedConsumerRealizationGrammarAt
    {Occurrence : Type u}
    (system : IndependentConsumerSystem.{u, u} Occurrence)
    (width bits : Nat) : Type (u + 1) where
  Candidate : Type u
  [finiteCandidate : Fintype Candidate]
  candidateAt : Candidate →
    QuantizedConsumerCandidateAt system width bits
  verdict : Candidate → Bool
  verified : (candidate : Candidate) → verdict candidate = true →
    VerifiedQuantizedConsumerRealizationAt (candidateAt candidate)
  diagnose : (candidate : Candidate) → verdict candidate = false →
    QuantizedConsumerRealizationFailureAt (candidateAt candidate)

/-- Complete finite evaluator residual with the grammar-owned `Fintype`
instance made explicit. -/
abbrev QuantizedConsumerCandidateResidualAt
    {Occurrence : Type u}
    {system : IndependentConsumerSystem.{u, u} Occurrence}
    {width bits : Nat}
    (grammar : QuantizedConsumerRealizationGrammarAt system width bits) :=
  @SourceGeneratedEffectiveFibreDisposition.FaithfulResidual
    grammar.Candidate grammar.finiteCandidate Bool inferInstance
      grammar.verdict true

/-- Total finite-precision disposition.  The negative branch retains the
complete finite verdict image and a typed failure for every source candidate.
-/
inductive QuantizedConsumerRealizationDispositionAt
    {Occurrence : Type u}
    {system : IndependentConsumerSystem.{u, u} Occurrence}
    {width bits : Nat}
    (grammar : QuantizedConsumerRealizationGrammarAt system width bits) :
    Type u where
  | realized (candidate : grammar.Candidate)
      (verified : VerifiedQuantizedConsumerRealizationAt
        (grammar.candidateAt candidate))
  | residual
      (complete : QuantizedConsumerCandidateResidualAt grammar)
      (failureAt : (candidate : grammar.Candidate) →
        QuantizedConsumerRealizationFailureAt (grammar.candidateAt candidate))

namespace QuantizedConsumerRealizationGrammarAt

variable {Occurrence : Type u}
variable {system : IndependentConsumerSystem.{u, u} Occurrence}
variable {width bits : Nat}
variable (grammar : QuantizedConsumerRealizationGrammarAt system width bits)

instance candidateFintype : Fintype grammar.Candidate :=
  grammar.finiteCandidate

def failureOfResidual
    (complete : QuantizedConsumerCandidateResidualAt grammar)
    (candidate : grammar.Candidate) :
    QuantizedConsumerRealizationFailureAt (grammar.candidateAt candidate) := by
  have verdict_false : grammar.verdict candidate = false := by
    cases verdict_eq : grammar.verdict candidate with
    | false => rfl
    | true => exact (complete.misses candidate verdict_eq).elim
  exact grammar.diagnose candidate verdict_false

/-- Total finite candidate classifier, reusing the existing faithful fibre
disposition without rebuilding finite search. -/
noncomputable def compile :
    QuantizedConsumerRealizationDispositionAt grammar := by
  letI := grammar.finiteCandidate
  exact match SourceGeneratedEffectiveFibreDisposition.settle
      grammar.verdict true with
    | .inhabited witness =>
        .realized witness.1 (grammar.verified witness.1 witness.2)
    | .residual complete =>
        .residual complete (grammar.failureOfResidual complete)

theorem compile_eq_realized_of_candidate
    (candidate : grammar.Candidate)
    (accepted : grammar.verdict candidate = true) :
    ∃ selected : grammar.Candidate,
      ∃ verified : VerifiedQuantizedConsumerRealizationAt
          (grammar.candidateAt selected),
        grammar.compile = .realized selected verified := by
  let _ := grammar.finiteCandidate
  have fibreNonempty : Nonempty
      (SourceGeneratedEffectiveFibreDisposition.Fibre
        grammar.verdict true) :=
    ⟨⟨candidate, accepted⟩⟩
  rw [compile,
    SourceGeneratedEffectiveFibreDisposition.settle_eq_inhabited_of_nonempty
      grammar.verdict true fibreNonempty]
  exact ⟨_, _, rfl⟩

end QuantizedConsumerRealizationGrammarAt

