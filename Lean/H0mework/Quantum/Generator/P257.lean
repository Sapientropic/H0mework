import H0mework.Quantum.Generator.P251
import H0mework.Quantum.Generator.P256
import Mathlib.Analysis.SpecialFunctions.Exponential

/-!
# Proposition 257: bounded Hamiltonian exponential flow solves the generator equation

P255/P256 prove that a bounded self-adjoint Hamiltonian exponentiates to a
continuous one-parameter unitary flow.  This file adds the analytic generator
equation for the same bounded exponential flow:

`d/dt exp(t • (-(i • H))) = (-(i • H)) * exp(t • (-(i • H)))`

and hence, on every point orbit,

`dψ/dt = (-(i • H)) ψ(t)`, equivalently `i • dψ/dt = H ψ(t)`.

Boundary: this is still the bounded-operator exponential direction.  It does
not prove Stone's theorem, does not derive a generator from an arbitrary
strongly continuous unitary flow, and does not handle unbounded Hamiltonians.
-/

noncomputable section

open NormedSpace

namespace SaturationMonoid
namespace AffineRelaxation

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

/-! ## Operator-valued derivative -/

/-- The bounded Hamiltonian exponential slice has right-generator derivative
in the operator algebra. -/
theorem boundedHamiltonian_exponentialSlice_hasDerivAt_operator_right
    (H : E →L[ℂ] E) (t : ℝ) :
    HasDerivAt
      (fun τ : ℝ => NormedSpace.exp (τ • (-(Complex.I • H))))
      (NormedSpace.exp (t • (-(Complex.I • H))) * (-(Complex.I • H))) t := by
  exact hasDerivAt_exp_smul_const (-(Complex.I • H)) t

/-- The same derivative can be written with the generator on the left.  This
is the form that immediately gives point-orbit dynamics. -/
theorem boundedHamiltonian_exponentialSlice_hasDerivAt_operator_left
    (H : E →L[ℂ] E) (t : ℝ) :
    HasDerivAt
      (fun τ : ℝ => NormedSpace.exp (τ • (-(Complex.I • H))))
      ((-(Complex.I • H)) * NormedSpace.exp (t • (-(Complex.I • H)))) t := by
  exact hasDerivAt_exp_smul_const' (-(Complex.I • H)) t

/-! ## Point-orbit derivative and Schrödinger normal form -/

/-- Applying the bounded exponential flow to a vector gives an orbit whose
derivative is generated by `-(i • H)`. -/
theorem boundedHamiltonian_exponentialSlice_hasDerivAt_orbit
    (H : E →L[ℂ] E) (t : ℝ) (x : E) :
    HasDerivAt
      (fun τ : ℝ => NormedSpace.exp (τ • (-(Complex.I • H))) x)
      ((-(Complex.I • H))
        (NormedSpace.exp (t • (-(Complex.I • H))) x)) t := by
  have hop :=
    boundedHamiltonian_exponentialSlice_hasDerivAt_operator_left
      (E := E) H t
  have happly :
      HasFDerivAt
        (fun T : E →L[ℂ] E => T x)
        ((ContinuousLinearMap.apply ℂ E x).restrictScalars ℝ)
        (NormedSpace.exp (t • (-(Complex.I • H)))) :=
    ((ContinuousLinearMap.apply ℂ E x).restrictScalars ℝ).hasFDerivAt
  have horbit := happly.comp_hasDerivAt t hop
  simpa [Function.comp_def, ContinuousLinearMap.apply_apply, mul_apply_eq_comp] using horbit

/-- The bounded exponential orbit satisfies the Hamiltonian normal-form algebra
`i • dψ/dt = H ψ(t)`. -/
theorem boundedHamiltonian_exponentialSlice_schrodinger_normal_form
    (H : E →L[ℂ] E) (t : ℝ) (x : E) :
    Complex.I •
        ((-(Complex.I • H))
          (NormedSpace.exp (t • (-(Complex.I • H))) x)) =
      H (NormedSpace.exp (t • (-(Complex.I • H))) x) := by
  simpa using
    complex_I_smul_hamiltonianGenerator_apply H
      (NormedSpace.exp (t • (-(Complex.I • H))) x)

/-! ## Certificates -/

/-- A bounded Hamiltonian exponential flow supplies the operator derivative,
point-orbit generator equation, and Schrödinger normal-form algebra. -/
structure BoundedHamiltonianExponentialSchrodingerCertificate
    (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    (H : E →L[ℂ] E) : Prop where
  operator_derivative :
    ∀ t : ℝ,
      HasDerivAt
        (fun τ : ℝ => NormedSpace.exp (τ • (-(Complex.I • H))))
        ((-(Complex.I • H)) *
          NormedSpace.exp (t • (-(Complex.I • H)))) t
  orbit_derivative :
    ∀ t : ℝ, ∀ x : E,
      HasDerivAt
        (fun τ : ℝ => NormedSpace.exp (τ • (-(Complex.I • H))) x)
        ((-(Complex.I • H))
          (NormedSpace.exp (t • (-(Complex.I • H))) x)) t
  normal_form :
    ∀ t : ℝ, ∀ x : E,
      Complex.I •
          ((-(Complex.I • H))
            (NormedSpace.exp (t • (-(Complex.I • H))) x)) =
        H (NormedSpace.exp (t • (-(Complex.I • H))) x)

/-- Every bounded Hamiltonian supplies the bounded exponential Schrödinger
certificate.  Self-adjointness is not needed for the differential equation;
it is needed for the unitary interpretation supplied by P255/P256. -/
theorem boundedHamiltonianExponentialSchrodingerCertificate
    (H : E →L[ℂ] E) :
    BoundedHamiltonianExponentialSchrodingerCertificate E H where
  operator_derivative :=
    boundedHamiltonian_exponentialSlice_hasDerivAt_operator_left H
  orbit_derivative :=
    boundedHamiltonian_exponentialSlice_hasDerivAt_orbit H
  normal_form :=
    boundedHamiltonian_exponentialSlice_schrodinger_normal_form H

/-- A bounded self-adjoint Hamiltonian supplies both the P256 continuous unitary
one-parameter flow and the P257 bounded Schrödinger generator equation. -/
structure BoundedSelfAdjointHamiltonianSchrodingerFlowCertificate
    (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
    (H : E →L[ℂ] E) : Prop where
  exponential_group :
    BoundedSelfAdjointHamiltonianExponentialGroupCertificate E H
  schrodinger_equation :
    BoundedHamiltonianExponentialSchrodingerCertificate E H

/-- Build the bounded self-adjoint Hamiltonian Schrödinger-flow certificate. -/
theorem boundedSelfAdjointHamiltonianSchrodingerFlowCertificate
    (H : E →L[ℂ] E) (hH : IsSelfAdjoint H) :
    BoundedSelfAdjointHamiltonianSchrodingerFlowCertificate E H where
  exponential_group :=
    boundedSelfAdjointHamiltonianExponentialGroupCertificate H hH
  schrodinger_equation :=
    boundedHamiltonianExponentialSchrodingerCertificate H

/-- Expose the orbit derivative from the bundled bounded self-adjoint
Schrödinger-flow certificate. -/
theorem BoundedSelfAdjointHamiltonianSchrodingerFlowCertificate.orbitDerivative
    {H : E →L[ℂ] E}
    (C : BoundedSelfAdjointHamiltonianSchrodingerFlowCertificate E H)
    (t : ℝ) (x : E) :
    HasDerivAt
      (fun τ : ℝ => NormedSpace.exp (τ • (-(Complex.I • H))) x)
      ((-(Complex.I • H))
        (NormedSpace.exp (t • (-(Complex.I • H))) x)) t :=
  C.schrodinger_equation.orbit_derivative t x

/-- Expose the Hamiltonian normal form from the bundled bounded self-adjoint
Schrödinger-flow certificate. -/
theorem BoundedSelfAdjointHamiltonianSchrodingerFlowCertificate.normalForm
    {H : E →L[ℂ] E}
    (C : BoundedSelfAdjointHamiltonianSchrodingerFlowCertificate E H)
    (t : ℝ) (x : E) :
    Complex.I •
        ((-(Complex.I • H))
          (NormedSpace.exp (t • (-(Complex.I • H))) x)) =
      H (NormedSpace.exp (t • (-(Complex.I • H))) x) :=
  C.schrodinger_equation.normal_form t x


end AffineRelaxation
end SaturationMonoid
