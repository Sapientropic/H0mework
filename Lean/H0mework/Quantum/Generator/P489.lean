import H0mework.Quantum.Generator.P488
import H0mework.Quantum.Generator.P283
import H0mework.Realization.RelaxationFlow.P249

/-!
# Proposition 489: carrier-produced Stone-side unbounded Hamiltonian scales

P486-P488 connect the sampled inverse saturation carrier to scalar and bounded
Hamiltonian scales.  P279/P283 separately expose the honest unbounded/Stone
interface: a strongly continuous unitary flow, a dense invariant domain, and an
orbit derivative law on that domain.

This file connects those two pieces at the producer level.  Given a supplied
Stone-side unbounded Hamiltonian certificate, every sampled inverse-carrier
scale `ω_N` canonically produces the time-rescaled Stone certificate

`U_N(t) = U(ω_N t)`, `H_N = ω_N H`.

The theorem still does not prove Stone's theorem and does not construct the
base unbounded Hamiltonian.  It proves the reusable scaling bridge once the
base Stone certificate is supplied.
-/

noncomputable section

open Filter

namespace SaturationMonoid
namespace AffineRelaxation

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-! ## Scaling dense unbounded Hamiltonian cores -/

/-- Scale a dense symmetric unbounded Hamiltonian core by a real scalar. -/
def DenseSymmetricUnboundedHamiltonianCore.realScale
    (C : DenseSymmetricUnboundedHamiltonianCore E) (omega : ℝ) :
    DenseSymmetricUnboundedHamiltonianCore E where
  domain := C.domain
  H := fun x => (omega : ℂ) • C.H x
  dense_domain := C.dense_domain
  symmetric_on_domain := by
    intro x y
    have h := C.symmetric_on_domain x y
    rw [inner_smul_left, inner_smul_right, Complex.conj_ofReal, h]

@[simp]
theorem DenseSymmetricUnboundedHamiltonianCore.realScale_domain
    (C : DenseSymmetricUnboundedHamiltonianCore E) (omega : ℝ) :
    (C.realScale omega).domain = C.domain := rfl

@[simp]
theorem DenseSymmetricUnboundedHamiltonianCore.realScale_H
    (C : DenseSymmetricUnboundedHamiltonianCore E) (omega : ℝ)
    (x : {x : E // x ∈ C.domain}) :
    (C.realScale omega).H x = (omega : ℂ) • C.H x := rfl

/-! ## Time-rescaling Stone certificates -/

theorem real_smul_neg_I_smul_eq_neg_I_smul_real_smul (omega : ℝ) (v : E) :
    omega • (-(Complex.I • v)) =
      -(Complex.I • ((omega : ℂ) • v)) := by
  change (omega : ℂ) • (-(Complex.I • v)) =
      -(Complex.I • ((omega : ℂ) • v))
  rw [smul_neg, smul_smul, smul_smul]
  congr 1
  ring_nf

/-- Rescale a supplied Stone-side unbounded Hamiltonian certificate by a real
time/Hamiltonian scalar. -/
def StoneUnboundedHamiltonianGeneratorCertificate.timeRescale
    (C : StoneUnboundedHamiltonianGeneratorCertificate E) (omega : ℝ) :
    StoneUnboundedHamiltonianGeneratorCertificate E where
  U := timeRescaledFlowHom C.U omega
  core := C.core.realScale omega
  strong_flow := by
    refine ⟨?_⟩
    intro x
    have hcont := C.strongContinuous x
    have hmul : Continuous (fun t : ℝ => omega * t) :=
      continuous_const.mul continuous_id
    change Continuous (fun t : ℝ => C.U (Multiplicative.ofAdd (omega * t)) x)
    simpa [Function.comp_def] using hcont.comp hmul
  domain_invariant := by
    intro t x hx
    exact C.domain_invariant (omega * t) x hx
  orbit_derivative := by
    intro t x hx
    have harg : HasDerivAt (fun τ : ℝ => omega * τ) omega t := by
      simpa using (hasDerivAt_id' t).const_mul omega
    have hbase :
        HasDerivAt
          (fun τ : ℝ => C.U (Multiplicative.ofAdd τ) x)
          (-(Complex.I • C.core.H (C.evolved (omega * t) x hx))) (omega * t) :=
      C.orbitDerivative (omega * t) x hx
    have hcomp :=
      HasDerivAt.scomp t hbase harg
    change HasDerivAt
      (fun τ : ℝ => C.U (Multiplicative.ofAdd (omega * τ)) x)
      (-(Complex.I •
        (omega : ℂ) •
          C.core.H
            ⟨C.U (Multiplicative.ofAdd (omega * t)) x,
              C.domain_invariant (omega * t) x hx⟩)) t
    convert hcomp using 1
    · ext τ
      rfl
    · rw [real_smul_neg_I_smul_eq_neg_I_smul_real_smul]
      rfl

/-! ## Sampled inverse carrier producers for Stone-side certificates -/

/-- A Stone-side unbounded Hamiltonian producer whose rescaling coefficient is
faithfully generated by the sampled inverse saturation carrier. -/
structure SampledInverseStoneUnboundedHamiltonianProducer
    (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (lambda step : ℝ) where
  baseStone : StoneUnboundedHamiltonianGeneratorCertificate E
  scale : ℕ -> ℝ
  carrier_scale :
    ∀ N : ℕ, scale N = sampledInverseCarrierScale lambda step N
  stone : ℕ -> StoneUnboundedHamiltonianGeneratorCertificate E
  stone_time_rescale :
    ∀ N : ℕ, stone N = baseStone.timeRescale (scale N)

/-- The canonical sampled inverse carrier producer from a supplied Stone-side
unbounded Hamiltonian certificate. -/
def canonicalSampledInverseStoneUnboundedHamiltonianProducer
    (baseStone : StoneUnboundedHamiltonianGeneratorCertificate E)
    (lambda step : ℝ) :
    SampledInverseStoneUnboundedHamiltonianProducer E lambda step where
  baseStone := baseStone
  scale := sampledInverseCarrierScale lambda step
  carrier_scale := by
    intro N
    rfl
  stone := fun N => baseStone.timeRescale (sampledInverseCarrierScale lambda step N)
  stone_time_rescale := by
    intro N
    rfl

/-- THEOREM 1: every faithful Stone-side producer inherits the closed carrier
form for its rescaling coefficient. -/
theorem SampledInverseStoneUnboundedHamiltonianProducer.scale_eq_exp_growth
    {lambda step : ℝ}
    (C : SampledInverseStoneUnboundedHamiltonianProducer E lambda step)
    (N : ℕ) :
    C.scale N =
      (realDecayResidual lambda ((N : ℝ) * step))⁻¹ := by
  rw [C.carrier_scale N]
  exact sampledInverseCarrierScale_eq_exp_growth lambda step N

/-- THEOREM 2: every produced Stone certificate is the base certificate with
carrier-produced time/Hamiltonian scale. -/
theorem SampledInverseStoneUnboundedHamiltonianProducer.stone_eq_timeRescale
    {lambda step : ℝ}
    (C : SampledInverseStoneUnboundedHamiltonianProducer E lambda step)
    (N : ℕ) :
    C.stone N = C.baseStone.timeRescale (C.scale N) :=
  C.stone_time_rescale N

/-- THEOREM 3: every produced Stone certificate supplies the P279
Schrödinger bridge. -/
def SampledInverseStoneUnboundedHamiltonianProducer.schrodingerBridge
    {lambda step : ℝ}
    (C : SampledInverseStoneUnboundedHamiltonianProducer E lambda step)
    (N : ℕ) :
    StoneUnboundedHamiltonianSchrodingerBridge E :=
  stoneUnboundedHamiltonianSchrodingerBridge (C.stone N)

/-- THEOREM 4: positive sampled scale makes the Stone rescaling coefficient
diverge. -/
theorem SampledInverseStoneUnboundedHamiltonianProducer.scale_tendsto_atTop
    {lambda step : ℝ}
    (C : SampledInverseStoneUnboundedHamiltonianProducer E lambda step)
    (hpos : 0 < lambda * step) :
    Tendsto C.scale atTop atTop := by
  have hfun :
      C.scale = sampledInverseCarrierScale lambda step := by
    funext N
    exact C.carrier_scale N
  rw [hfun]
  exact tendsto_sampledInverseCarrierScale_atTop hpos

/-! ## Bundled receipt -/

/-- A compact receipt for the Stone-side unbounded bridge: the sampled inverse
carrier produces the time/Hamiltonian rescaling coefficient, and each produced
Stone certificate inherits the Schrödinger bridge. -/
structure CarrierProducedStoneUnboundedHamiltonianReceipt
    (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (lambda step : ℝ)
    (C : SampledInverseStoneUnboundedHamiltonianProducer E lambda step) : Prop where
  scale_closed_form :
    ∀ N : ℕ,
      C.scale N = (realDecayResidual lambda ((N : ℝ) * step))⁻¹
  stone_time_rescale :
    ∀ N : ℕ, C.stone N = C.baseStone.timeRescale (C.scale N)
  schrodinger_bridge :
    ∀ _ : ℕ, Nonempty (StoneUnboundedHamiltonianSchrodingerBridge E)
  coefficient_diverges :
    0 < lambda * step -> Tendsto C.scale atTop atTop

/-- THEOREM 5: every faithful sampled inverse Stone-side producer supplies the
carrier-produced unbounded-Hamiltonian receipt. -/
theorem carrierProducedStoneUnboundedHamiltonianReceipt
    {lambda step : ℝ}
    (C : SampledInverseStoneUnboundedHamiltonianProducer E lambda step) :
    CarrierProducedStoneUnboundedHamiltonianReceipt E lambda step C where
  scale_closed_form := C.scale_eq_exp_growth
  stone_time_rescale := C.stone_eq_timeRescale
  schrodinger_bridge := fun N => ⟨C.schrodingerBridge N⟩
  coefficient_diverges := fun hpos => C.scale_tendsto_atTop hpos

end AffineRelaxation
end SaturationMonoid
