import H0mework.Realization.RelaxationAlgebra.P485
import H0mework.Quantum.Generator.P251

/-!
# Proposition 486: carrier-produced Hamiltonian scale certificate

P481 proves the scalar carrier fact:

`inverse sampled saturation` makes the headroom coordinate grow like
`exp(lambda * N * step)`.

P251 proves the Hamiltonian normal-form fact:

the scalar Schrödinger phase flow with real scale `omega` has Hamiltonian
normal form with Hamiltonian `omega • Id`.

This file is the honest bridge between those layers.  It does not assert that
an arbitrary physical Hamiltonian is produced by the saturation carrier.  It
defines the missing producer certificate:

* a scale sequence `scale : ℕ -> ℝ`;
* a faithful carrier law saying `scale N` is exactly the inverse sampled
  carrier headroom at step `N`;
* the scalar Hamiltonian normal form at each produced scale.

Once that producer certificate is supplied, divergence of the carrier headroom
transfers to divergence of the Hamiltonian scale.
-/

namespace SaturationMonoid
namespace AffineRelaxation

noncomputable section

open Filter

/-! ## The inverse-carrier scale -/

/-- The scalar scale produced by the sampled inverse carrier: the zero-origin
orbit's headroom after `N` inverse sampled steps. -/
def sampledInverseCarrierScale (lambda step : ℝ) (N : ℕ) : ℝ :=
  (1 : ℝ) -
    (fun z : ℝ =>
      bumpSatField z
        (SatOrFieldAlgebra.satOrFieldInv
          (realDecayRate lambda step)))^[N] 0

/-- THEOREM 1: the sampled inverse carrier scale has the closed reciprocal
continuous-residual form. -/
theorem sampledInverseCarrierScale_eq_exp_growth
    (lambda step : ℝ) (N : ℕ) :
    sampledInverseCarrierScale lambda step N =
      (realDecayResidual lambda ((N : ℝ) * step))⁻¹ := by
  unfold sampledInverseCarrierScale
  exact
    headroom_bumpSatField_iterate_zero_inv_realDecayRate_eq_exp_growth
      lambda step N

/-- THEOREM 2: under positive sampled scale, the inverse carrier scale tends
to infinity. -/
theorem tendsto_sampledInverseCarrierScale_atTop
    {lambda step : ℝ} (hpos : 0 < lambda * step) :
    Tendsto (sampledInverseCarrierScale lambda step) atTop atTop := by
  unfold sampledInverseCarrierScale
  exact tendsto_inv_realDecayRate_headroom_atTop hpos

/-! ## Hamiltonian producer certificate -/

/-- A scalar Hamiltonian-scale producer whose scale is faithfully generated by
the sampled inverse saturation carrier.

The data field `scale` is intentionally explicit: an external or physical
model must identify its Hamiltonian scalar with this carrier scale before it
may inherit the carrier theorems. -/
structure SampledInverseHamiltonianScaleProducer
    (E : Type*) [NormedAddCommGroup E] [NormedSpace ℂ E]
    (lambda step : ℝ) where
  scale : ℕ -> ℝ
  carrier_scale :
    ∀ N : ℕ, scale N = sampledInverseCarrierScale lambda step N
  scalar_hamiltonian_normal_form :
    ∀ N : ℕ,
      HamiltonianNormalFormFlowCertificate E
        (schrodingerScalarPhaseFlowHom (E := E) (scale N))
        ((scale N : ℂ) • (1 : E →L[ℂ] E))

/-- THEOREM 3: the canonical sampled inverse carrier supplies a scalar
Hamiltonian-scale producer. -/
def canonicalSampledInverseHamiltonianScaleProducer
    (E : Type*) [NormedAddCommGroup E] [NormedSpace ℂ E]
    (lambda step : ℝ) :
    SampledInverseHamiltonianScaleProducer E lambda step where
  scale := sampledInverseCarrierScale lambda step
  carrier_scale := by
    intro N
    rfl
  scalar_hamiltonian_normal_form := by
    intro N
    exact
      schrodingerScalarPhaseFlow_hamiltonianNormalFormCertificate
        (E := E) (sampledInverseCarrierScale lambda step N)

/-- THEOREM 4: any faithful sampled inverse carrier producer inherits the same
closed form for its Hamiltonian scale. -/
theorem SampledInverseHamiltonianScaleProducer.scale_eq_exp_growth
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    {lambda step : ℝ}
    (C : SampledInverseHamiltonianScaleProducer E lambda step)
    (N : ℕ) :
    C.scale N =
      (realDecayResidual lambda ((N : ℝ) * step))⁻¹ := by
  rw [C.carrier_scale N]
  exact sampledInverseCarrierScale_eq_exp_growth lambda step N

/-- THEOREM 5: any faithful sampled inverse carrier producer has Hamiltonian
scale tending to infinity under positive sampled scale. -/
theorem SampledInverseHamiltonianScaleProducer.scale_tendsto_atTop
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    {lambda step : ℝ}
    (C : SampledInverseHamiltonianScaleProducer E lambda step)
    (hpos : 0 < lambda * step) :
    Tendsto C.scale atTop atTop := by
  have hfun :
      C.scale = sampledInverseCarrierScale lambda step := by
    funext N
    exact C.carrier_scale N
  rw [hfun]
  exact tendsto_sampledInverseCarrierScale_atTop hpos

/-- A compact receipt: if a scalar Hamiltonian scale is faithfully produced by
the sampled inverse carrier, its closed form and divergence are inherited from
the carrier, while the scalar Hamiltonian normal form is inherited from P251.
-/
structure CarrierProducedHamiltonianScaleReceipt
    (E : Type*) [NormedAddCommGroup E] [NormedSpace ℂ E]
    (lambda step : ℝ)
    (C : SampledInverseHamiltonianScaleProducer E lambda step) : Prop where
  closed_form :
    ∀ N : ℕ,
      C.scale N = (realDecayResidual lambda ((N : ℝ) * step))⁻¹
  normal_form :
    ∀ N : ℕ,
      HamiltonianNormalFormFlowCertificate E
        (schrodingerScalarPhaseFlowHom (E := E) (C.scale N))
        ((C.scale N : ℂ) • (1 : E →L[ℂ] E))
  diverges :
    0 < lambda * step -> Tendsto C.scale atTop atTop

/-- THEOREM 6: every sampled inverse Hamiltonian-scale producer supplies the
carrier-produced Hamiltonian-scale receipt. -/
theorem carrierProducedHamiltonianScaleReceipt
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    {lambda step : ℝ}
    (C : SampledInverseHamiltonianScaleProducer E lambda step) :
    CarrierProducedHamiltonianScaleReceipt E lambda step C where
  closed_form := C.scale_eq_exp_growth
  normal_form := C.scalar_hamiltonian_normal_form
  diverges := fun hpos => C.scale_tendsto_atTop hpos

end

end AffineRelaxation
end SaturationMonoid
