import H0mework.Quantum.Kernel.Exponential
import Mathlib.Analysis.InnerProductSpace.GramMatrix

/-!
# Complex positive kernels from real Gram data

Finite-support source combinations prove Gram positivity without a finite
index restriction. Taking the real part preserves complex positivity, so
the exponential series generates the complete real-inner-product kernel.
-/

set_option autoImplicit false

open scoped Matrix Topology ComplexOrder InnerProductSpace
open Matrix

namespace SaturationMonoid.Quantum.Kernel

noncomputable section

variable {ι E : Type*} [SeminormedAddCommGroup E] [InnerProductSpace ℂ E]

/-- Every finitely supported combination has the source Gram norm. -/
theorem gram_posSemidef (v : ι → E) : (Matrix.gram ℂ v).PosSemidef := by
  refine ⟨Matrix.isHermitian_gram ℂ v, ?_⟩
  intro x
  have positive : 0 ≤ inner ℂ (x.sum fun i a => a • v i) (x.sum fun i a => a • v i) := by
    refine Complex.nonneg_iff.mpr ⟨?_, ?_⟩
    · exact inner_self_nonneg (𝕜 := ℂ)
    · exact (inner_self_im (𝕜 := ℂ) _).symm
  have same : (x.sum fun i xi => x.sum fun j xj =>
      star xi * Matrix.gram ℂ v i j * xj) =
      inner ℂ (x.sum fun i a => a • v i) (x.sum fun i a => a • v i) := by
    simp only [Finsupp.sum, sum_inner, inner_sum, inner_smul_left, inner_smul_right,
      Matrix.gram_apply, Finset.mul_sum]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i hi
    apply Finset.sum_congr rfl
    intro j hj
    simp
    ring
  exact same.symm ▸ positive

theorem realPart_posSemidef (K : Matrix ι ι ℂ) (positive : K.PosSemidef) :
    Matrix.PosSemidef (fun i j => ((K i j).re : ℂ)) := by
  have average := (positive.add positive.transpose).smul (by norm_num : 0 ≤ (1 / 2 : ℝ))
  have same : (1 / 2 : ℝ) • (K + Kᵀ) = (fun i j => ((K i j).re : ℂ)) := by
    ext i j
    have hermitian : K j i = star (K i j) := by
      have h := congrFun (congrFun positive.isHermitian j) i
      simpa using h.symm
    change (1 / 2 : ℝ) • (K i j + K j i) = ((K i j).re : ℂ)
    rw [hermitian]
    apply Complex.ext
    · simp [Complex.real_smul]
      ring
    · simp [Complex.real_smul]
  exact same ▸ average

/-- The kernel itself is generated by the source inner products. -/
def expInner (β : ℝ) (v : ι → E) : Matrix ι ι ℂ :=
  fun i j => Complex.exp ((β * (inner ℂ (v i) (v j)).re : ℝ) : ℂ)

/-- Nonnegative coupling generates complex positivity on the entire index carrier. -/
theorem expInner_posSemidef (β : ℝ) (nonnegative : 0 ≤ β) (v : ι → E) :
    (expInner β v).PosSemidef := by
  have realGram := realPart_posSemidef (Matrix.gram ℂ v) (gram_posSemidef v)
  have scaled := realGram.smul nonnegative
  have same : β • (fun i j => ((inner ℂ (v i) (v j)).re : ℂ) : Matrix ι ι ℂ) =
      (fun i j => ((β * (inner ℂ (v i) (v j)).re : ℝ) : ℂ)) := by
    ext i j
    simp [Complex.real_smul]
  have positive : Matrix.PosSemidef
      (fun i j => ((β * (inner ℂ (v i) (v j)).re : ℝ) : ℂ)) := same ▸ scaled
  have generated := posSemidef_exp _ positive
  change Matrix.PosSemidef (fun i j => Complex.exp (↑(β * (inner ℂ (v i) (v j)).re)))
  exact Complex.exp_eq_exp_ℂ.symm ▸ generated

end
end SaturationMonoid.Quantum.Kernel
