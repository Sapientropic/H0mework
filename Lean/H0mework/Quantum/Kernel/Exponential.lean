import Mathlib.Analysis.Matrix.Order
import Mathlib.Analysis.SpecialFunctions.Exponential

/-!
# Exponential kernels generated by positive Gram matrices

Entrywise powers are positive by the Schur product theorem. The convergent
exponential series preserves positivity on every finitely supported test,
including when the kernel's index type is infinite.
-/

set_option autoImplicit false

open scoped Matrix Topology ComplexOrder
open Matrix Filter

namespace SaturationMonoid.Quantum.Kernel

noncomputable section

variable {ι 𝕜 : Type*} [RCLike 𝕜]

/-- Pointwise convergence preserves every finite-support positive quadratic form. -/
theorem posSemidef_limit (K : ℕ → Matrix ι ι 𝕜) (L : Matrix ι ι 𝕜)
    (positive : ∀ n, (K n).PosSemidef)
    (converges : ∀ i j, Tendsto (fun n => K n i j) atTop (𝓝 (L i j))) : L.PosSemidef := by
  constructor
  · ext i j
    change star (L j i) = L i j
    have same : (fun n => star (K n j i)) = fun n => K n i j := by
      funext n
      have h := congrFun (congrFun (positive n).isHermitian i) j
      simpa using h
    have first := (converges j i).star
    rw [same] at first
    exact tendsto_nhds_unique first (converges i j)
  · intro x
    have limit : Tendsto (fun n => x.sum fun i xi => x.sum fun j xj =>
        star xi * K n i j * xj) atTop
        (𝓝 (x.sum fun i xi => x.sum fun j xj => star xi * L i j * xj)) := by
      simp only [Finsupp.sum]
      apply tendsto_finsetSum
      intro i hi
      apply tendsto_finsetSum
      intro j hj
      exact ((converges i j).const_mul _).mul_const _
    exact ge_of_tendsto limit (Eventually.of_forall fun n => (positive n).2 x)

theorem posSemidef_entryPow (K : Matrix ι ι 𝕜) (positive : K.PosSemidef) (n : ℕ) :
    Matrix.PosSemidef (fun i j => K i j ^ n) := by
  induction n with
  | zero =>
    have one := (Matrix.PosSemidef.one (R := 𝕜) (n := Unit)).submatrix (fun _ : ι => ())
    have same : (fun i j => K i j ^ 0) =
        (1 : Matrix Unit Unit 𝕜).submatrix (fun _ : ι => ()) (fun _ : ι => ()) := by
      funext i j
      simp [Matrix.submatrix]
    exact same.symm ▸ one
  | succ n ih =>
    have same : (fun i j => K i j ^ (n + 1)) = (fun i j => K i j ^ n) ⊙ K := by
      funext i j
      simp [pow_succ, Matrix.hadamard]
    exact same.symm ▸ ih.hadamard positive

/-- The actual entrywise exponential is generated as a limit of positive Schur powers. -/
theorem posSemidef_exp (K : Matrix ι ι 𝕜) (positive : K.PosSemidef) :
    Matrix.PosSemidef (fun i j => NormedSpace.exp (K i j)) := by
  let truncations : ℕ → Matrix ι ι 𝕜 := fun n =>
    ∑ m ∈ Finset.range n, ((m.factorial : ℝ)⁻¹) • (fun i j => K i j ^ m)
  apply posSemidef_limit truncations
  · intro n
    exact Matrix.posSemidef_sum _ fun m _ =>
      (posSemidef_entryPow K positive m).smul (by positivity : 0 ≤ (m.factorial : ℝ)⁻¹)
  · intro i j
    have series := (NormedSpace.exp_series_hasSum_exp' (𝕂 := ℝ) (K i j)).tendsto_sum_nat
    convert! series using 1
    · funext n
      exact Matrix.sum_apply i j _ _

end
end SaturationMonoid.Quantum.Kernel
