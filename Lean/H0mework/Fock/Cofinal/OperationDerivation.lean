import H0mework.Realization.Operations.DerivationExact
import H0mework.Realization.Operations.RuntimeRelations
import H0mework.Fock.Cofinal.OperationCochain

/-! Source-generated derivations and complete relation fibres along the original runtime material history. -/

set_option autoImplicit false

namespace SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
namespace NoIslandNoMagic.CanonicalArithmeticState.ParticleWaveFockOperationDerivation

open ParticleWaveFock ParticleWaveFockRuntime ParticleWaveFockOperationPrefix
open ParticleWaveFockOperationEnvelope ParticleWaveFockOperationCochain
open SourceOperationEffects SourceOperationRelations SourceOperationDerivations
open SourceOperationPresentation SourceOperationInventoryLift

noncomputable section

def stageEnvironment {runtime : LivingRuntimeState runtimeFacade.process}
    (stage : SourceGeneratedRuntimeMaterialStageAt runtime) :=
  pairEnvironment (oldEnvironment stage) (incrementEnvironment stage)

theorem stage_lift_read {runtime : LivingRuntimeState runtimeFacade.process}
    (stage : SourceGeneratedRuntimeMaterialStageAt runtime) :
    (liftExpr fockOperation).eval (stageEnvironment stage) =
      ((payloadAt runtime).sourceState, (payloadAt runtime).forcedTrace) := by
  rw [stageEnvironment, eval_liftExpr]
  have source := stage_reads_installed_payload stage
  change (evaluation (s := OperationSort.parent) (oldEnvironment stage) OperationRelations.operationWord,
    effectEvaluator (s := OperationSort.parent) (oldEnvironment stage)
      (incrementEnvironment stage) OperationRelations.operationWord) = _ at source
  simpa only [evaluation, effectEvaluator, OperationRelations.operationWord,
    Finsupp.linearCombination_single, one_smul] using source

/-- Eliminate the proof already generated by this same installed source occurrence. -/
def stageDerivation {runtime : LivingRuntimeState runtimeFacade.process}
    (stage : SourceGeneratedRuntimeMaterialStageAt runtime) :
    Derivation (stageEnvironment stage) (liftExpr fockOperation)
      (.const ((payloadAt runtime).sourceState, (payloadAt runtime).forcedTrace)) := by
  have generated := (payloadAt runtime).operationDerivation
  rw [(payloadAt runtime).nativeWrite_eq] at generated
  change Derivation (stageEnvironment stage) (liftExpr fockOperation)
    (.const (sourceStateAt runtime.current.visit.current,
      forcedTraceAt runtime.current.visit.current)) at generated
  rw [← (payloadAt runtime).sourceState_eq, ← (payloadAt runtime).forcedTrace_eq] at generated
  exact generated

def stageRelationMap {runtime : LivingRuntimeState runtimeFacade.process}
    (stage : SourceGeneratedRuntimeMaterialStageAt runtime) :=
  SourceOperationRuntime.stageRelationMap (R := ℤ) (s := OperationSort.parent)
    sourceMaterial environmentProjection stage

theorem stage_fibre_generated {runtime : LivingRuntimeState runtimeFacade.process}
    (stage : SourceGeneratedRuntimeMaterialStageAt runtime) (left right : FormalCarrier) :
    stageInventory stage left = stageInventory stage right ↔
      liftMap (left - right) ∈ LinearMap.range (stageRelationMap stage) :=
  SourceOperationRuntime.stage_fibre_generated sourceMaterial environmentProjection stage left right

theorem envelope_fibre_generated (depth : Nat) (left right : FormalCarrier) :
    sourceMap depth left = sourceMap depth right ↔
      ∀ bound (index : Fin (bound + 1)),
        liftMap (left - right) ∈
          LinearMap.range (stageRelationMap ((materialHistory depth bound).stageAt index)) := by
  rw [envelope_source_fibre_iff]
  constructor
  · intro readings bound index
    exact (stage_fibre_generated _ left right).mp (readings bound index)
  · intro relations bound index
    exact (stage_fibre_generated _ left right).mpr (relations bound index)

theorem stage_derivation_factorizes {runtime : LivingRuntimeState runtimeFacade.process}
    (stage : SourceGeneratedRuntimeMaterialStageAt runtime) :
    (liftExpr fockOperation).eval (stageEnvironment stage) =
      ((payloadAt runtime).sourceState, (payloadAt runtime).forcedTrace) ∧
    (runtimeFacade.readoutAt runtime .particleWave =
        .inl ⟨activeAt runtime, payloadAt runtime⟩ ∧
      stage.activated.generated.occurrence =
        runtime.current.root.toAuthoritativeRoot.toLedgerRoot.emitted
          runtime.current.visit.current ∧
      HEq (runtimeFacade.readoutAt runtime .particleWave)
        (stage.activated.generated.projectionOutcome
          ((runtimeFacade.installationAt runtime .particleWave).embed
            (runtimeFacade.projectionAt runtime .particleWave))) ∧
      HEq stage.wholeLedgerWriteBack
        (runtime.current.root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt
          runtime.current.visit.current) ∧
      stage.next.current = stage.activated.nextCurrent) := by
  have source := stage_source_factorizes stage
  exact ⟨(stageDerivation stage).sound, source.2⟩

theorem stage_state_from_derivation {runtime : LivingRuntimeState runtimeFacade.process}
    (stage : SourceGeneratedRuntimeMaterialStageAt runtime) :
    let seen := (liftExpr fockOperation).eval (stageEnvironment stage)
    seen.1 + seen.2 = (payloadAt runtime).targetState := by
  dsimp only
  rw [(stageDerivation stage).sound]
  exact (stage_state_from_boundary stage).symm

end
end NoIslandNoMagic.CanonicalArithmeticState.ParticleWaveFockOperationDerivation
end SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.ConstructiveRoot
