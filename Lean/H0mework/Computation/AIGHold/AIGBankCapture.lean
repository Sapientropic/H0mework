import H0mework.Computation.AIGHold.AIGOutputBank
import H0mework.Computation.DualRailAIG.GateCapture

/-! # Every output capacitor is generated by the same enlarged physical word graph -/

set_option autoImplicit false

namespace SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical
namespace Cells.Storage

open Std.Sat Units.Interface Set Conductance
open Netlist.Dissipative.Dimensioned.Driven.Producer

noncomputable section

variable {α : Type} [DecidableEq α] [Hashable α] {width : Nat}

def aigBankCell (technology : AIGCellTechnology) (entry : AIG.RefVecEntry α width) (index : Fin width) :
    LoadedConductanceCellSource :=
  compileDualRailCell technology (aigOutputBank entry).aig
    ⟨((aigOutputBank entry).vec.get index.val index.isLt).gate,
      ((aigOutputBank entry).vec.get index.val index.isLt).hgate⟩ false

def aigBankVoltage (technology : AIGCellTechnology) (entry : AIG.RefVecEntry α width)
    (input : α → ℝ → SIVolt)
    (initial : Fin (aigOutputBank entry).aig.decls.size → Bool → SIVolt) (index : Fin width) : ℝ → SIVolt :=
  (compileAIGDualRailTrajectoryFromInputs technology (aigOutputBank entry).aig input initial
    ⟨((aigOutputBank entry).vec.get index.val index.isLt).gate,
      ((aigOutputBank entry).vec.get index.val index.isLt).hgate⟩).wave false

theorem aigBankVoltage_capture
    (technology : AIGCellTechnology) (entry : AIG.RefVecEntry α width) (input : α → ℝ → SIVolt)
    (initial : Fin (aigOutputBank entry).aig.decls.size → Bool → SIVolt)
    (initialRail : ∀ node polarity,
      InRail (compileDualRailCell technology (aigOutputBank entry).aig node polarity) (initial node polarity))
    (inputContinuous : ∀ (node : Fin (aigOutputBank entry).aig.decls.size) atom,
      (aigOutputBank entry).aig.decls[node.val] = .atom atom → Continuous (fun t => (input atom t).value))
    (assign : α → Bool) (first last : ℝ) (firstNonnegative : 0 ≤ first)
    (inputBands : ∀ (node : Fin (aigOutputBank entry).aig.decls.size) atom,
      (aigOutputBank entry).aig.decls[node.val] = .atom atom → ∀ t ∈ Icc first last,
        BitBand (compileDualRailCell technology (aigOutputBank entry).aig node false) (assign atom) (input atom t))
    (clock : ResonantDrivenCoreSource) (code : FiniteSamplingClockCode)
    (leaseCoversCapture : (aigInputSampledTime technology (aigOutputBank entry).aig first clock code).value ≤ last)
    (index : Fin width) :
    CaptureBand (aigBankCell technology entry index)
      (AIG.denote assign ⟨entry.aig, entry.vec.get index.val index.isLt⟩)
      (aigBankVoltage technology entry input initial index
        (aigInputSampledTime technology (aigOutputBank entry).aig first clock code).value) := by
  have delay := compileAIGDualRailTrajectoryFromInputs_ready_le_graphDeadline technology
    (aigOutputBank entry).aig input initial
    ⟨((aigOutputBank entry).vec.get index.val index.isLt).gate,
      ((aigOutputBank entry).vec.get index.val index.isLt).hgate⟩ false
  have late := aigInputSampledTime_late technology (aigOutputBank entry).aig first clock code
  have captured := compileAIGDualRailTrajectoryFromInputs_gate_capture technology
    (aigOutputBank entry).aig input initial initialRail inputContinuous assign first last firstNonnegative inputBands
    ⟨((aigOutputBank entry).vec.get index.val index.isLt).gate,
      ((aigOutputBank entry).vec.get index.val index.isLt).hgate⟩
    (.mk (entry.vec.get index.val index.isLt).gate (entry.vec.get index.val index.isLt).invert)
    (.mk 0 true) (aigOutputBank_decl entry index) _ leaseCoversCapture (by linarith)
  have logical := aigOutputBank_denote entry index assign
  simp only [AIG.denote, aigOutputBank_ref_invert, Bool.xor_false] at logical
  rw [logical] at captured
  exact captured

end
end Cells.Storage
end SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical
