import H0mework.Computation.AIGExecution.AIGExecutionViewSource

/-!
# Source-generated topological AIG execution

A state stores one fixed source-sized buffer and its written frontier. Each step
writes the next source declaration, reading gate fanins from the existing buffer. The DAG
certificate supplies bounds, not Boolean answers. `Nat.repeat` uses the library's
tail-recursive runtime implementation; all output references share one final table.
-/

set_option autoImplicit false

namespace SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical
namespace Netlist.Dissipative.Dimensioned.Driven.Producer

open Std.Sat

variable {α : Type} [DecidableEq α] [Hashable α]

/-- All storage is initialized to zero; the zero frontier marks every slot unwritten. -/
def aigExecutionEmpty (graph : AIG α) : AIGExecutionPrefix graph :=
  ⟨Vector.replicate graph.decls.size false, ⟨0, Nat.zero_lt_succ _⟩⟩

/-- Evaluate exactly the declaration at the current state frontier. -/
def aigExecutionNextValue (graph : AIG α) (assign : α → Bool)
    (state : AIGExecutionPrefix graph) (ready : state.values.size < graph.decls.size) :
    Bool :=
  have bounded : state.cursor.val < graph.decls.size := by
    simpa only [AIGExecutionPrefix.values_size] using ready
  match selected : graph.decls[state.cursor.val] with
  | .false => false
  | .atom input => assign input
  | .gate left right =>
    have fanins := graph.hdag bounded selected
    (state.buffer[left.gate]'(Nat.lt_of_lt_of_le fanins.1 state.cursor_le) ^^ left.invert) &&
      (state.buffer[right.gate]'(Nat.lt_of_lt_of_le fanins.2 state.cursor_le) ^^ right.invert)

/-- One clock step generates one declaration value, or leaves a completed table fixed. -/
def aigExecutionStep (graph : AIG α) (assign : α → Bool)
    (state : AIGExecutionPrefix graph) : AIGExecutionPrefix graph :=
  if ready : state.cursor.val < graph.decls.size then
    ⟨state.buffer.set state.cursor.val
      (aigExecutionNextValue graph assign state
        (by simpa only [AIGExecutionPrefix.values_size] using ready)) ready,
      ⟨state.cursor.val + 1, by omega⟩⟩
  else state

theorem aigExecutionStep_buffer (graph : AIG α) (assign : α → Bool)
    (state : AIGExecutionPrefix graph) (ready : state.cursor.val < graph.decls.size) :
    (aigExecutionStep graph assign state).buffer = state.buffer.set state.cursor.val
      (aigExecutionNextValue graph assign state
        (by simpa only [AIGExecutionPrefix.values_size] using ready)) ready := by
  simp only [aigExecutionStep, dif_pos ready]

theorem aigExecutionStep_cursor (graph : AIG α) (assign : α → Bool)
    (state : AIGExecutionPrefix graph) :
    (aigExecutionStep graph assign state).cursor.val =
      min (state.cursor.val + 1) graph.decls.size := by
  unfold aigExecutionStep
  split
  · dsimp only
    omega
  · have := state.cursor_le
    omega

theorem aigExecutionStep_values (graph : AIG α) (assign : α → Bool)
    (state : AIGExecutionPrefix graph) (ready : state.values.size < graph.decls.size) :
    (aigExecutionStep graph assign state).values =
      state.values.push (aigExecutionNextValue graph assign state ready) := by
  have readyCursor : state.cursor.val < graph.decls.size := by
    simpa only [AIGExecutionPrefix.values_size] using ready
  simp only [aigExecutionStep, dif_pos readyCursor, AIGExecutionPrefix.values]
  exact aigExecution_set_take_frontier _ _ readyCursor _

theorem aigExecutionStep_size (graph : AIG α) (assign : α → Bool)
    (state : AIGExecutionPrefix graph) :
    (aigExecutionStep graph assign state).values.size =
      min (state.values.size + 1) graph.decls.size := by
  simp only [AIGExecutionPrefix.values_size, aigExecutionStep_cursor]

theorem aigExecutionStep_complete (graph : AIG α) (assign : α → Bool)
    (state : AIGExecutionPrefix graph) (complete : state.values.size = graph.decls.size) :
    aigExecutionStep graph assign state = state := by
  have cursor : state.cursor.val = graph.decls.size := by
    simpa only [AIGExecutionPrefix.values_size] using complete
  simp only [aigExecutionStep, cursor, Nat.lt_irrefl, ↓reduceDIte]

/-- Finite history is generated by repeatedly consuming the actual previous state. -/
def aigExecutionAfter (graph : AIG α) (assign : α → Bool) (ticks : Nat) :
    AIGExecutionPrefix graph :=
  Nat.repeat (aigExecutionStep graph assign) ticks (aigExecutionEmpty graph)

theorem aigExecutionAfter_zero (graph : AIG α) (assign : α → Bool) :
    aigExecutionAfter graph assign 0 = aigExecutionEmpty graph := rfl

theorem aigExecutionAfter_succ (graph : AIG α) (assign : α → Bool) (ticks : Nat) :
    aigExecutionAfter graph assign (ticks + 1) =
      aigExecutionStep graph assign (aigExecutionAfter graph assign ticks) := rfl

theorem aigExecutionAfter_size (graph : AIG α) (assign : α → Bool) (ticks : Nat) :
    (aigExecutionAfter graph assign ticks).values.size = min ticks graph.decls.size := by
  induction ticks with
  | zero => simp only [AIGExecutionPrefix.values_size, aigExecutionAfter_zero,
      aigExecutionEmpty, Nat.zero_min]
  | succ ticks ih =>
    rw [aigExecutionAfter_succ, aigExecutionStep_size, ih]
    omega

theorem aigExecutionAfter_cursor (graph : AIG α) (assign : α → Bool) (ticks : Nat) :
    (aigExecutionAfter graph assign ticks).cursor.val = min ticks graph.decls.size := by
  simpa only [AIGExecutionPrefix.values_size] using aigExecutionAfter_size graph assign ticks

/-- External observation time beyond completion cannot change the source-generated table. -/
theorem aigExecutionAfter_min (graph : AIG α) (assign : α → Bool) (ticks : Nat) :
    aigExecutionAfter graph assign (min ticks graph.decls.size) =
      aigExecutionAfter graph assign ticks := by
  induction ticks with
  | zero => rfl
  | succ ticks ih =>
      by_cases ready : ticks < graph.decls.size
      · have bounded : ticks + 1 ≤ graph.decls.size := by omega
        rw [Nat.min_eq_left bounded]
      · have finished : graph.decls.size ≤ ticks := by omega
        have finishedNext : graph.decls.size ≤ ticks + 1 := by omega
        rw [Nat.min_eq_right finishedNext, aigExecutionAfter_succ, ← ih,
          Nat.min_eq_right finished]
        symm
        apply aigExecutionStep_complete
        rw [aigExecutionAfter_size, Nat.min_self]

/-- The source graph's declaration count, not a supplied success table, fixes completion. -/
def aigExecutionRun (graph : AIG α) (assign : α → Bool) : AIGExecutionPrefix graph :=
  aigExecutionAfter graph assign graph.decls.size

theorem aigExecutionRun_size (graph : AIG α) (assign : α → Bool) :
    (aigExecutionRun graph assign).values.size = graph.decls.size := by
  simp only [aigExecutionRun, aigExecutionAfter_size, Nat.min_self]

/-- Read a requested node only after the entire shared table has been generated. -/
def aigExecutionRead? {graph : AIG α} (state : AIGExecutionPrefix graph)
    (ref : AIG.Ref graph) : Option Bool :=
  if state.cursor.val = graph.decls.size then
    some (state.buffer[ref.gate]'ref.hgate ^^ ref.invert)
  else none

theorem aigExecutionRead?_incomplete {graph : AIG α} (state : AIGExecutionPrefix graph)
    (ref : AIG.Ref graph) (incomplete : state.values.size < graph.decls.size) :
    aigExecutionRead? state ref = none := by
  have cursor : state.cursor.val < graph.decls.size := by
    simpa only [AIGExecutionPrefix.values_size] using incomplete
  simp only [aigExecutionRead?, Nat.ne_of_lt cursor, ↓reduceIte]

/-- Multiple output references read the same completed table without rerunning gates. -/
def aigExecutionReadAt {graph : AIG α} (state : AIGExecutionPrefix graph)
    (_complete : state.values.size = graph.decls.size) (ref : AIG.Ref graph) : Bool :=
  state.buffer[ref.gate]'ref.hgate ^^ ref.invert

/-- Single-output convenience; vector consumers share `aigExecutionRun` and use `ReadAt`. -/
def aigExecutionRead {graph : AIG α} (assign : α → Bool) (ref : AIG.Ref graph) : Bool :=
  aigExecutionReadAt (aigExecutionRun graph assign) (aigExecutionRun_size graph assign) ref

theorem aigExecutionRead?_before_completion (graph : AIG α) (assign : α → Bool)
    (ticks : Nat) (early : ticks < graph.decls.size) (ref : AIG.Ref graph) :
    aigExecutionRead? (aigExecutionAfter graph assign ticks) ref = none := by
  apply aigExecutionRead?_incomplete
  rw [aigExecutionAfter_size]
  omega

/-- The compatibility prefix view exposes no unwritten slot, even though storage is initialized. -/
theorem aigExecutionPrefix_future_unwritten {graph : AIG α}
    (state : AIGExecutionPrefix graph) (index : Nat) (future : state.values.size ≤ index) :
    state.values[index]? = none := Array.getElem?_eq_none future

/-- An actual gate at the frontier necessarily reads strictly earlier cached nodes. -/
theorem aigExecutionNextValue_fanins_cached {graph : AIG α}
    (state : AIGExecutionPrefix graph) (ready : state.values.size < graph.decls.size)
    (left right : AIG.Fanin)
    (selected : graph.decls[state.values.size] = .gate left right) :
    left.gate < state.values.size ∧ right.gate < state.values.size :=
  graph.hdag ready selected

end Netlist.Dissipative.Dimensioned.Driven.Producer
end SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical
