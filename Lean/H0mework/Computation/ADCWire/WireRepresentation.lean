import H0mework.Computation.ADCWire.WirePacket

/-!
# The addressed representation crown on a finite wire carrier

The finite packet is generated by the same physical execution. Kernel
exactness is obtained only after its arithmetic parser and physical
readback commute, then the existing complete-carrier theorem supplies
the unique isomorphism to the earlier digital face over each source drive.
-/

set_option autoImplicit false

namespace SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical
namespace Netlist.Dissipative.Dimensioned.Driven.Producer

open NoIslandNoMagic.Consciousness.Representation

noncomputable section

theorem addressedADCWireKernel
    (source : FiniteADCClockedNoisyMeteredSynchronousFixtureSource) :
    FaceKernelExactAt binaryDriveConsumers (packADCExecution source) := by
  intro left right
  rw [binaryDriveConsumers_indistinguishable_iff_eq]
  exact (packADCExecution_injective source).eq_iff

theorem addressedADCWire_sameRoot_uniqueIso
    (source : FiniteADCClockedNoisyMeteredSynchronousFixtureSource) :
    ∃! equivalence : Set.range (compiledADCDigitalSample source) ≃
        Set.range (packADCExecution source),
      ∀ drive, equivalence ⟨compiledADCDigitalSample source drive, drive, rfl⟩ =
        ⟨packADCExecution source drive, drive, rfl⟩ :=
  addressedADC_sameRoot_uniqueIso source (packADCExecution source)
    (addressedADCWireKernel source)

theorem addressedADCWire_image_card
    (source : FiniteADCClockedNoisyMeteredSynchronousFixtureSource) :
    Nat.card (Set.range (packADCExecution source)) = 1024 := by
  rw [← Nat.card_congr
    (Equiv.ofInjective _ (packADCExecution_injective source))]
  rw [Nat.card_eq_fintype_card, finiteBinaryDrive_card]

structure SourceGeneratedADCWireCrownAt
    (source : FiniteADCClockedNoisyMeteredSynchronousFixtureSource) : Prop where
  everyExecution : ∀ drive,
    SourceGeneratedFiniteADCClockedNoisyMeteredSynchronousSampleAt source drive
  counterCapacity : ∀ drive,
    finiteADCClockedSampleTick source drive < 2 ^ adcClockBits source
  packetBudget : Fintype.card (FiniteADCWirePacket source) = 2 ^ adcWirePacketBits source
  exactParse : ∀ drive,
    parseADCWirePacket source (maxADCSampleTick source) (packADCExecution source drive) =
      some (compiledADCDigitalSample source drive)
  exactReadback : ∀ drive,
    decodeDigitalSample source (unpackADCWirePacket source (packADCExecution source drive)) =
      drive
  kernelExact : FaceKernelExactAt binaryDriveConsumers (packADCExecution source)
  quotientRange : Nonempty (binaryDriveConsumers.Quotient ≃ Set.range (packADCExecution source))
  imageCapacity : Nat.card (Set.range (packADCExecution source)) = 1024

theorem sourceGeneratedADCWireCrown
    (source : FiniteADCClockedNoisyMeteredSynchronousFixtureSource) :
    SourceGeneratedADCWireCrownAt source where
  everyExecution := sourceGeneratedFiniteADCClockedNoisyMeteredSynchronousSample source
  counterCapacity := adcSampleTick_no_counter_overflow source
  packetBudget := finiteADCWirePacket_card source
  exactParse := parse_packADCExecution source
  exactReadback := decode_packADCExecution source
  kernelExact := addressedADCWireKernel source
  quotientRange := ⟨(addressedADCWireKernel source).quotientEquivRange⟩
  imageCapacity := addressedADCWire_image_card source

end

end Netlist.Dissipative.Dimensioned.Driven.Producer
end SaturationMonoid.NoIslandNoMagic.Consciousness.Immortality.Embodied.Canonical.Coupling.Physical

