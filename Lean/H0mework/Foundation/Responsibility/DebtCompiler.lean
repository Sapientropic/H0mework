import H0mework.Foundation.Responsibility.DebtLedger
import H0mework.Foundation.Responsibility.DebtU7
import H0mework.Foundation.Ledger.SourceCompiler

/-!
# Direct occurrence-indexed debt activation compiler

One domain source is indexed by an already emitted lower root occurrence.  Its
single generated event fixes the debt law, current debt state, and disposition.
The compiler consumes that generated disposition directly:

* a strict debt step evolves the complete extended ledger;
* a source terminal discharges the complete extended ledger;
* an obstruction emits the existing same-row debt U7 theory audit.

This is a pre-emitter compiler.  It creates neither a root emitter nor a
successor for the obstruction branch.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace RootGeneratedDebtActivationDirect

open DebtActivationLedger
open DebtActivationWorld
open RootGeneratedDebtActivationU7

universe u

/-- The three domain-generated dispositions already present in
`DebtActivationLaw`.  This is source data, not a proposition classifier. -/
inductive GeneratedDispositionAt
    (law : DebtActivationLaw.{u}) (state : law.DebtState) : Type u
  | step {target : law.DebtState} (receipt : law.StepAt state target)
  | supportTerminal (event : law.SupportTerminalAt state)
  | obstruction (event : law.ObstructionAt state)

/-- A domain source attached to one fixed emitted lower occurrence.

The event is generated before its law, state, and disposition are read.  In
particular, callers do not submit a branch, a target state, or a settlement. -/
structure OccurrenceIndexedSourceAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (lower : SourceNativeLedgerRootClosure N V)
    (current : V.Current) : Type (u + 2) where
  Event : Type u
  generate : Event
  lawAt : Event → DebtActivationLaw.{u}
  stateAt : (event : Event) → (lawAt event).DebtState
  dispositionAt : (event : Event) →
    GeneratedDispositionAt (lawAt event) (stateAt event)

namespace OccurrenceIndexedSourceAt

variable {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
variable {lower : SourceNativeLedgerRootClosure N V}
variable {current : V.Current}

/-- The exact lower occurrence to which this domain source is attached. -/
def lowerOccurrence
    (_source : OccurrenceIndexedSourceAt lower current) :
    lower.source.source.toRootSource.actual.OccurrenceAt current :=
  lower.emitted current

/-- Debt law generated by the source event. -/
abbrev law (source : OccurrenceIndexedSourceAt lower current) :
    DebtActivationLaw.{u} :=
  source.lawAt source.generate

/-- Live debt state generated by the same source event. -/
def state (source : OccurrenceIndexedSourceAt lower current) :
    source.law.DebtState :=
  source.stateAt source.generate

/-- Disposition generated by the same source event. -/
def generatedDisposition (source : OccurrenceIndexedSourceAt lower current) :
    GeneratedDispositionAt source.law source.state :=
  source.dispositionAt source.generate

/-- The fixed base support read from the emitted lower occurrence. -/
def lowerSupport (source : OccurrenceIndexedSourceAt lower current) : N.Support :=
  lower.source.source.toRootSource.account.supportOf source.lowerOccurrence

/-- The source-generated debt law extends the lower world exactly once. -/
abbrev World (source : OccurrenceIndexedSourceAt lower current) :=
  ExtendedNetwork N source.law

/-- Before any disposition is compiled, the live debt row is already inside
the complete extended ledger at the fixed lower support. -/
def liveLedger (source : OccurrenceIndexedSourceAt lower current) :
    CompleteLiveLedgerAt source.World :=
  activeLedger source.lowerSupport source.state

/-- Exact live debt row carried by `liveLedger`. -/
def liveDebtEntry (source : OccurrenceIndexedSourceAt lower current) :
    source.liveLedger.Entry :=
  debtEntry (N := N) source.lowerSupport source.state

end OccurrenceIndexedSourceAt

/-- The canonical U7 event emitted for one generated debt obstruction. -/
def obstructionEvent
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {lower : SourceNativeLedgerRootClosure N V} {current : V.Current}
    (source : OccurrenceIndexedSourceAt lower current)
    (oldU7 : U7ProducerCalculus N)
    (oldCalculus : U7ObstructionEvolutionCalculus N oldU7)
    (obstruction : source.law.ObstructionAt source.state) :=
  (extendU7Calculus (law := source.law) oldU7 oldCalculus).source.emit
    (debtObstruction (N := N) source.lowerSupport obstruction)

/-- Exact same-row theory-audit output of an obstruction branch.

The equalities retain both the live debt row and the existing U7 compiler
disposition.  No root occurrence or ordinary successor is stored here. -/
structure SameRowTheoryAuditAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {lower : SourceNativeLedgerRootClosure N V} {current : V.Current}
    (source : OccurrenceIndexedSourceAt lower current)
    (oldU7 : U7ProducerCalculus N)
    (oldCalculus : U7ObstructionEvolutionCalculus N oldU7)
    (obstruction : source.law.ObstructionAt source.state) : Type u where
  demandEntry_eq :
    U7ActualSuccessorSource.demandEntry
        (obstructionEvent source oldU7 oldCalculus obstruction) =
      source.liveDebtEntry
  disposition_eq :
    ((extendU7Calculus (law := source.law) oldU7 oldCalculus).compile
      (obstructionEvent source oldU7 oldCalculus obstruction)).disposition =
      .requiresTheoryAudit
        (debtObstructionReceipt (N := N) source.lowerSupport obstruction)
  theoryAudit :
    SourceNativeU7TheoryAuditAt
      (extendU7Calculus (law := source.law) oldU7 oldCalculus)
      (obstructionEvent source oldU7 oldCalculus obstruction)

/-- Compile the existing canonical debt-U7 event without creating another
obstruction calculus. -/
def sameRowTheoryAudit
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {lower : SourceNativeLedgerRootClosure N V} {current : V.Current}
    (source : OccurrenceIndexedSourceAt lower current)
    (oldU7 : U7ProducerCalculus N)
    (oldCalculus : U7ObstructionEvolutionCalculus N oldU7)
    (obstruction : source.law.ObstructionAt source.state) :
    SameRowTheoryAuditAt source oldU7 oldCalculus obstruction where
  demandEntry_eq :=
    debt_demand_entry oldU7 oldCalculus source.lowerSupport obstruction
  disposition_eq :=
    debt_compiled_disposition oldU7 oldCalculus source.lowerSupport obstruction
  theoryAudit :=
    debt_theoryAudit oldU7 oldCalculus source.lowerSupport obstruction

/-- Existing objects produced by each already generated domain disposition. -/
def CompiledResultAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {lower : SourceNativeLedgerRootClosure N V} {current : V.Current}
    (source : OccurrenceIndexedSourceAt lower current)
    (oldU7 : U7ProducerCalculus N)
    (oldCalculus : U7ObstructionEvolutionCalculus N oldU7) :
    GeneratedDispositionAt source.law source.state → Type u
  | .step (target := target) _step =>
      LedgerWriteEvolutionAt source.World source.liveLedger
        (activeLedger source.lowerSupport target)
  | .supportTerminal _terminal =>
      LedgerTerminalEvolutionAt source.World source.liveLedger
  | .obstruction obstruction =>
      SameRowTheoryAuditAt source oldU7 oldCalculus obstruction

/-- Sealed canonical image of the generated domain event. -/
structure CompilerImageAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {lower : SourceNativeLedgerRootClosure N V} {current : V.Current}
    (source : OccurrenceIndexedSourceAt lower current)
    (oldU7 : U7ProducerCalculus N)
    (oldCalculus : U7ObstructionEvolutionCalculus N oldU7) : Type (u + 2) where
  private mk ::
  disposition : GeneratedDispositionAt source.law source.state
  generated_eq : disposition = source.generatedDisposition
  result : CompiledResultAt source oldU7 oldCalculus disposition

/-- Direct domain-to-root compiler.  It only eliminates the source event's
already generated disposition. -/
def compile
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {lower : SourceNativeLedgerRootClosure N V} {current : V.Current}
    (source : OccurrenceIndexedSourceAt lower current)
    (oldU7 : U7ProducerCalculus N)
    (oldCalculus : U7ObstructionEvolutionCalculus N oldU7) :
    CompilerImageAt source oldU7 oldCalculus := by
  let disposition := source.generatedDisposition
  refine ⟨disposition, rfl, ?_⟩
  cases disposition with
  | step step =>
      exact stepLedgerEvolution source.lowerSupport step
  | supportTerminal terminal =>
      exact supportTerminalLedgerEvolution source.lowerSupport terminal
  | obstruction obstruction =>
      exact sameRowTheoryAudit source oldU7 oldCalculus obstruction

end RootGeneratedDebtActivationDirect
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
