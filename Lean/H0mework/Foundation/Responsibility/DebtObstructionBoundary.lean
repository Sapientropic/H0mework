import H0mework.Foundation.Responsibility.DebtInstallation

/-!
# Direct generated debt-obstruction boundary

The direct debt compiler already distinguishes its obstruction branch by the
source-generated disposition.  This file exposes that exact dependent branch:
the existing U7 calculus audits the already-live debt row, while the ordinary
source-ledger installation fibre is empty.

An obstruction is not thereby an expressibility failure.  Whether the current
theory already expresses and realizes its claim is decided by that theory's
actual fibres, not by absence of an ordinary successor.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace RootGeneratedDebtActivationDirectObstruction

open DebtActivationWorld
open RootGeneratedDebtActivationDirect
open RootGeneratedDebtActivationU7

universe u

/-- Exact evidence that the one disposition generated by a direct activation
source is its debt obstruction.  The private constructor prevents an
unrelated obstruction from being paired with the source after the branch has
been observed. -/
structure GeneratedObstructionAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {lower : SourceNativeLedgerRootClosure N V} {current : V.Current}
    (source : OccurrenceIndexedSourceAt lower current) : Type u where
  private mk ::
  obstruction : source.law.ObstructionAt source.state
  generated_eq : source.generatedDisposition = .obstruction obstruction

namespace GeneratedObstructionAt

/-- The generated disposition fixes the obstruction value as well as its
branch. -/
theorem eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {lower : SourceNativeLedgerRootClosure N V} {current : V.Current}
    {source : OccurrenceIndexedSourceAt lower current}
    (left right : GeneratedObstructionAt source) : left = right := by
  rcases left with ⟨leftObstruction, left_eq⟩
  rcases right with ⟨rightObstruction, right_eq⟩
  have obstruction_eq : leftObstruction = rightObstruction := by
    injection left_eq.symm.trans right_eq
  subst rightObstruction
  rfl

instance instSubsingleton
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {lower : SourceNativeLedgerRootClosure N V} {current : V.Current}
    (source : OccurrenceIndexedSourceAt lower current) :
    Subsingleton (GeneratedObstructionAt source) :=
  ⟨eq⟩

/-- Introduce the boundary only from equality to the source's actual
generated disposition. -/
def ofGenerated
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {lower : SourceNativeLedgerRootClosure N V} {current : V.Current}
    {source : OccurrenceIndexedSourceAt lower current}
    (obstruction : source.law.ObstructionAt source.state)
    (generated_eq : source.generatedDisposition = .obstruction obstruction) :
    GeneratedObstructionAt source :=
  ⟨obstruction, generated_eq⟩

/-- The source-generated obstruction is compiled by the existing debt-U7
calculus and audits the exact pre-existing live row. -/
def sameRowTheoryAudit
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {lower : SourceNativeLedgerRootClosure N V} {current : V.Current}
    {source : OccurrenceIndexedSourceAt lower current}
    (generated : GeneratedObstructionAt source)
    (oldU7 : U7ProducerCalculus N)
    (oldCalculus : U7ObstructionEvolutionCalculus N oldU7) :
    SameRowTheoryAuditAt source oldU7 oldCalculus generated.obstruction :=
  RootGeneratedDebtActivationDirect.sameRowTheoryAudit source oldU7
    oldCalculus generated.obstruction

/-- The U7 demand entry is literally the already-live debt entry. -/
theorem demandEntry_eq_liveDebtEntry
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {lower : SourceNativeLedgerRootClosure N V} {current : V.Current}
    {source : OccurrenceIndexedSourceAt lower current}
    (generated : GeneratedObstructionAt source)
    (oldU7 : U7ProducerCalculus N)
    (oldCalculus : U7ObstructionEvolutionCalculus N oldU7) :
    U7ActualSuccessorSource.demandEntry
        (obstructionEvent source oldU7 oldCalculus generated.obstruction) =
      source.liveDebtEntry :=
  (generated.sameRowTheoryAudit oldU7 oldCalculus).demandEntry_eq

@[simp] theorem demandEntry_claim_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {lower : SourceNativeLedgerRootClosure N V} {current : V.Current}
    {source : OccurrenceIndexedSourceAt lower current}
    (generated : GeneratedObstructionAt source)
    (oldU7 : U7ProducerCalculus N)
    (oldCalculus : U7ObstructionEvolutionCalculus N oldU7) :
    OpenResponsibilityAt.claim
        (U7ActualSuccessorSource.demandEntry
          (obstructionEvent source oldU7 oldCalculus
            generated.obstruction)) =
      Sum.inr source.law.debtClaim := by
  rw [generated.demandEntry_eq_liveDebtEntry oldU7 oldCalculus]
  rfl

@[simp] theorem demandEntry_budget_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {lower : SourceNativeLedgerRootClosure N V} {current : V.Current}
    {source : OccurrenceIndexedSourceAt lower current}
    (generated : GeneratedObstructionAt source)
    (oldU7 : U7ProducerCalculus N)
    (oldCalculus : U7ObstructionEvolutionCalculus N oldU7) :
    OpenResponsibilityAt.progressBudget
        (U7ActualSuccessorSource.demandEntry
          (obstructionEvent source oldU7 oldCalculus
            generated.obstruction)) =
      source.law.budget source.state := by
  rw [generated.demandEntry_eq_liveDebtEntry oldU7 oldCalculus]
  rfl

@[simp] theorem liveLedger_lineage_eq_lower
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {lower : SourceNativeLedgerRootClosure N V} {current : V.Current}
    {source : OccurrenceIndexedSourceAt lower current}
    (_generated : GeneratedObstructionAt source) :
    source.World.lineageAt source.liveLedger.support =
      N.lineageAt source.lowerSupport :=
  rfl

/-- There is no ordinary source-ledger installation for this exact generated
branch.  This says nothing about old-language expressibility. -/
theorem noSourceLedgerInstallation
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {lower : SourceNativeLedgerRootClosure N V} {current : V.Current}
    {source : OccurrenceIndexedSourceAt lower current}
    (generated : GeneratedObstructionAt source)
    {RootV : Vocabulary.{u}}
    (rootSource : SourceNativeSource source.World RootV)
    (rootCurrent : RootV.Current)
    (event : rootSource.law.EventAt rootCurrent
      ⟨source.lowerSupport, some source.state⟩) :
    IsEmpty (GeneratedSourceNativeLedgerInstallationAt source rootSource
      rootCurrent event) :=
  generatedObstructionInstallation_isEmpty generated.generated_eq

/-- A source which generated a strict step cannot inhabit the obstruction
boundary. -/
theorem isEmpty_of_generatedStep
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {lower : SourceNativeLedgerRootClosure N V} {current : V.Current}
    {source : OccurrenceIndexedSourceAt lower current}
    {target : source.law.DebtState}
    {step : source.law.StepAt source.state target}
    (generated_eq : source.generatedDisposition = .step step) :
    IsEmpty (GeneratedObstructionAt source) := by
  constructor
  intro obstruction
  have branch_eq := obstruction.generated_eq
  rw [generated_eq] at branch_eq
  exact nomatch branch_eq

/-- A source which generated a support terminal cannot inhabit the
obstruction boundary. -/
theorem isEmpty_of_generatedTerminal
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {lower : SourceNativeLedgerRootClosure N V} {current : V.Current}
    {source : OccurrenceIndexedSourceAt lower current}
    {terminal : source.law.SupportTerminalAt source.state}
    (generated_eq : source.generatedDisposition = .supportTerminal terminal) :
    IsEmpty (GeneratedObstructionAt source) := by
  constructor
  intro obstruction
  have branch_eq := obstruction.generated_eq
  rw [generated_eq] at branch_eq
  exact nomatch branch_eq

end GeneratedObstructionAt

end RootGeneratedDebtActivationDirectObstruction
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
