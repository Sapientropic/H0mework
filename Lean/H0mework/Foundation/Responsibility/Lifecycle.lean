import Mathlib.Data.List.Basic
import H0mework.Foundation.Source.Anchor

/-!
# Source-native responsibility lifecycle

This module is the framework-level kernel for responsibility conservation.
It keeps four boundaries explicit:

* an obstruction generates a producer demand, not an admitted obligation;
* admission, review, exit, and reopen are classified by actual source events;
* the current view is generated by a dependent ordered fold of append-only
  lifecycle events;
* obligation terminal disposition is distinct from bearer release.

There are deliberately no primitive `isAdmitted`, `isAccepted`,
`isFulfilled`, or `isDischarged` fields.  A caller supplies an actual event,
never a target state or a selected continuation branch.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle

open ComplementObservation

universe u

/-- Raw domain vocabulary for one responsibility jurisdiction.  Every
evidence family is proof relevant and indexed by its source event.

In particular, `ProgressAt` names a domain receipt family; it does not by
itself assert strict semantic progress in the shared world.  A public world
effect exists only when the receipt is recognized as a dependent restriction
of the same exact root answer-and-next occurrence. -/
structure Vocabulary where
  SourceEvent : Type u
  Content : Type u
  Residual : Type u
  Bearer : Type u
  ProtectedInterest : Type u
  Scope : Type u
  Lineage : Type u
  Incidence : Type u
  SourceObservation : ComplementObservationCarrier.{u}
  sourceAnchor : SourceEvent →
    MinimalRegistrableSourceAnchor SourceObservation Scope Lineage
  sourceIncidence : SourceEvent → Incidence
  ObstructionAt : SourceEvent → Type u
  demandContent : {source : SourceEvent} → ObstructionAt source → Content
  demandResidual : {source : SourceEvent} → ObstructionAt source → Residual
  CommitmentAt : SourceEvent → Content → Type u
  MandateOriginAt : SourceEvent → Content → Type u
  AcceptedTaskAt : SourceEvent → Content → Type u
  ActiveDependencyAt : SourceEvent → Content → Type u
  ProtectedRiskAt : SourceEvent → Content → Type u
  AdmissionAuthorityAt : SourceEvent → Scope → Type u
  AcceptedAt : Bearer → SourceEvent → Scope → Type u
  StandingMandateAt : Bearer → SourceEvent → Scope → Type u
  DischargeJurisdiction : Content → Scope → Type u
  ProgressAt : SourceEvent → Content → Residual → Residual → Type u
  MaintenanceAt : SourceEvent → Content → Scope → Type u
  TypedDeferAt : SourceEvent → Content → Scope → Type u
  ScopeNarrowingAt : SourceEvent → Scope → Scope → Type u
  TransferAcceptedAt : SourceEvent → Bearer → Bearer → Scope → Type u
  FulfilledAt : SourceEvent → Content → Scope → Type u
  WaivedAt : SourceEvent → Content → Scope → Type u
  InvalidatedAt : SourceEvent → Content → Scope → Type u
  AbandonedAt : SourceEvent → Content → Scope → Type u
  ImpossibleResidueAcceptedAt : SourceEvent → Content → Scope → Type u
  SupersessionAt : SourceEvent →
    Incidence → Content → Incidence → Content → Scope → Scope → Type u
  ReopenAt : SourceEvent →
    Incidence → Content → Incidence → Content → Scope → Scope → Type u
  JurisdictionEndedAt : SourceEvent → Content → Scope → Type u
  ConsentRevokedAt : SourceEvent → Content → Scope → Type u
  CapacityReleasedAt : SourceEvent → Content → Scope → Type u
  UpperRouteAt : SourceEvent → Content → Scope → Type u
  NextActorSignal : Type u
  AgeSignal : Type u
  TransferOfferSignal : Type u

/-- An obstruction produces a structural demand.  No bearer or admission
authority occurs in this type. -/
structure ProducerDemand (V : Vocabulary) where
  sourceEvent : V.SourceEvent
  obstruction : V.ObstructionAt sourceEvent

namespace ProducerDemand

def content {V : Vocabulary} (demand : ProducerDemand V) : V.Content :=
  V.demandContent demand.obstruction

def residual {V : Vocabulary} (demand : ProducerDemand V) : V.Residual :=
  V.demandResidual demand.obstruction

end ProducerDemand

/-- Native obstruction-to-demand producer. -/
def producerDemandOfObstruction
    {V : Vocabulary} {source : V.SourceEvent}
    (obstruction : V.ObstructionAt source) : ProducerDemand V :=
  ⟨source, obstruction⟩

/-- Legal admission origins are indexed by the exact source and content. -/
inductive ObligationOrigin (V : Vocabulary)
    (source : V.SourceEvent) (content : V.Content) : Type u
  | producerDemand
      (demand : ProducerDemand V)
      (source_eq : demand.sourceEvent = source)
      (content_eq : demand.content = content)
  | explicitCommitment (receipt : V.CommitmentAt source content)
  | standingMandate (receipt : V.MandateOriginAt source content)
  | acceptedTask (receipt : V.AcceptedTaskAt source content)
  | activeDependency (receipt : V.ActiveDependencyAt source content)
  | protectedRisk (receipt : V.ProtectedRiskAt source content)

/-- Bearer assumption is positive evidence, not an assignment or attention
readout. -/
inductive BearerAssumption (V : Vocabulary)
    (source : V.SourceEvent) (bearer : V.Bearer) (scope : V.Scope) : Type u
  | accepted (receipt : V.AcceptedAt bearer source scope)
  | mandated (receipt : V.StandingMandateAt bearer source scope)

/-- Source-native admission payload produced from an actual admission event. -/
structure NativeAdmissionPayload (V : Vocabulary) : Type u where
  sourceEvent : V.SourceEvent
  content : V.Content
  residual : V.Residual
  bearer : V.Bearer
  beneficiary : V.ProtectedInterest
  scope : V.Scope
  lineage : V.Lineage
  anchor_scope_eq : scope = (V.sourceAnchor sourceEvent).scope
  anchor_lineage_eq : lineage = (V.sourceAnchor sourceEvent).lineage
  origin : ObligationOrigin V sourceEvent content
  authority : V.AdmissionAuthorityAt sourceEvent scope
  assumption : BearerAssumption V sourceEvent bearer scope
  dischargeJurisdiction : V.DischargeJurisdiction content scope

/-- Admission receipt stores the original jurisdiction.  Later transfer or
scope narrowing does not rewrite this source receipt. -/
structure AdmissionReceipt (V : Vocabulary) (content : V.Content) : Type u where
  sourceEvent : V.SourceEvent
  admittedBearer : V.Bearer
  admittedScope : V.Scope
  lineage : V.Lineage
  anchor_scope_eq : admittedScope = (V.sourceAnchor sourceEvent).scope
  anchor_lineage_eq : lineage = (V.sourceAnchor sourceEvent).lineage
  origin : ObligationOrigin V sourceEvent content
  authority : V.AdmissionAuthorityAt sourceEvent admittedScope
  assumption : BearerAssumption V sourceEvent admittedBearer admittedScope

/-- Current obligation state.  Every mutable field is generated by lifecycle
events; admission provenance remains fixed. -/
structure AdmittedObligation (V : Vocabulary) : Type u where
  content : V.Content
  residual : V.Residual
  bearer : V.Bearer
  beneficiary : V.ProtectedInterest
  scope : V.Scope
  admission : AdmissionReceipt V content
  dischargeJurisdiction : V.DischargeJurisdiction content scope

def NativeAdmissionPayload.toObligation
    {V : Vocabulary} (payload : NativeAdmissionPayload V) :
    AdmittedObligation V where
  content := payload.content
  residual := payload.residual
  bearer := payload.bearer
  beneficiary := payload.beneficiary
  scope := payload.scope
  admission :=
    { sourceEvent := payload.sourceEvent
      admittedBearer := payload.bearer
      admittedScope := payload.scope
      lineage := payload.lineage
      anchor_scope_eq := payload.anchor_scope_eq
      anchor_lineage_eq := payload.anchor_lineage_eq
      origin := payload.origin
      authority := payload.authority
      assumption := payload.assumption }
  dischargeJurisdiction := payload.dischargeJurisdiction

def AdmittedObligation.lineage
    {V : Vocabulary} (obligation : AdmittedObligation V) : V.Lineage :=
  obligation.admission.lineage

def AdmittedObligation.sourceAnchor
    {V : Vocabulary.{u}} (obligation : AdmittedObligation V) :
    MinimalRegistrableSourceAnchor V.SourceObservation V.Scope V.Lineage :=
  V.sourceAnchor obligation.admission.sourceEvent

def AdmittedObligation.sourceIncidence
    {V : Vocabulary.{u}} (obligation : AdmittedObligation V) : V.Incidence :=
  V.sourceIncidence obligation.admission.sourceEvent

theorem AdmittedObligation.admittedScope_eq_sourceAnchorScope
    {V : Vocabulary.{u}} (obligation : AdmittedObligation V) :
    obligation.admission.admittedScope = obligation.sourceAnchor.scope :=
  obligation.admission.anchor_scope_eq

theorem AdmittedObligation.lineage_eq_sourceAnchorLineage
    {V : Vocabulary.{u}} (obligation : AdmittedObligation V) :
    obligation.lineage = obligation.sourceAnchor.lineage :=
  obligation.admission.anchor_lineage_eq

/-- Exact source-local jurisdiction over one responsibility occurrence.  The
event must retain both the obligation's registered source anchor and its
exact incidence; matching content or residual data is deliberately
insufficient. -/
structure SourceOwnsResponsibilityIncidence
    (V : Vocabulary.{u}) (source : V.SourceEvent)
    (obligation : AdmittedObligation V) : Type u where
  anchor_eq : V.sourceAnchor source = obligation.sourceAnchor
  incidence_eq : V.sourceIncidence source = obligation.sourceIncidence

/-- Raw carrying grammar generated by a review event.  The two `progressed`
constructors classify a domain receipt syntactically; neither constructor is
a world-authority mouth.  Consumers claiming semantic progress must read the
same receipt from an exact root answer-and-next occurrence.
-/
inductive ActiveCarryDisposition (V : Vocabulary)
    (obligation : AdmittedObligation V) (source : V.SourceEvent) : Type u
  | progressed
      (nextResidual : V.Residual)
      (receipt : V.ProgressAt source obligation.content
        obligation.residual nextResidual)
  | progressedAndTransferred
      (nextResidual : V.Residual)
      (nextBearer : V.Bearer)
      (progressReceipt : V.ProgressAt source obligation.content
        obligation.residual nextResidual)
      (transferReceipt : V.TransferAcceptedAt source obligation.bearer
        nextBearer obligation.scope)
  | maintained
      (receipt : V.MaintenanceAt source obligation.content obligation.scope)
  | deferred
      (receipt : V.TypedDeferAt source obligation.content obligation.scope)
  | narrowed
      (nextScope : V.Scope)
      (receipt : V.ScopeNarrowingAt source obligation.scope nextScope)
      (jurisdiction : V.DischargeJurisdiction obligation.content nextScope)
  | transferred
      (nextBearer : V.Bearer)
      (receipt : V.TransferAcceptedAt source obligation.bearer nextBearer
        obligation.scope)

def ActiveCarryDisposition.target
    {V : Vocabulary} {obligation : AdmittedObligation V}
    {source : V.SourceEvent}
    (disposition : ActiveCarryDisposition V obligation source) :
    AdmittedObligation V :=
  match disposition with
  | .progressed nextResidual _ => { obligation with residual := nextResidual }
  | .progressedAndTransferred nextResidual nextBearer _ _ =>
      { obligation with residual := nextResidual, bearer := nextBearer }
  | .maintained _ => obligation
  | .deferred _ => obligation
  | .narrowed nextScope _ jurisdiction =>
      { obligation with scope := nextScope
                        dischargeJurisdiction := jurisdiction }
  | .transferred nextBearer _ => { obligation with bearer := nextBearer }

theorem ActiveCarryDisposition.target_lineage
    {V : Vocabulary} {obligation : AdmittedObligation V}
    {source : V.SourceEvent}
    (disposition : ActiveCarryDisposition V obligation source) :
    disposition.target.lineage = obligation.lineage := by
  cases disposition <;> rfl

theorem ActiveCarryDisposition.target_content
    {V : Vocabulary} {obligation : AdmittedObligation V}
    {source : V.SourceEvent}
    (disposition : ActiveCarryDisposition V obligation source) :
    disposition.target.content = obligation.content := by
  cases disposition <;> rfl

theorem ActiveCarryDisposition.target_beneficiary
    {V : Vocabulary} {obligation : AdmittedObligation V}
    {source : V.SourceEvent}
    (disposition : ActiveCarryDisposition V obligation source) :
    disposition.target.beneficiary = obligation.beneficiary := by
  cases disposition <;> rfl

/-- Final receipts remove the obligation and leave a source-backed archive. -/
inductive FinalReceipt (V : Vocabulary)
    (obligation : AdmittedObligation V) (source : V.SourceEvent) : Type u
  | fulfilled (receipt : V.FulfilledAt source obligation.content obligation.scope)
  | waived (receipt : V.WaivedAt source obligation.content obligation.scope)
  | invalidated (receipt : V.InvalidatedAt source obligation.content obligation.scope)
  | abandonedWithConsequence
      (receipt : V.AbandonedAt source obligation.content obligation.scope)
  | impossibleResidueAccepted
      (receipt : V.ImpossibleResidueAcceptedAt source obligation.content
        obligation.scope)

/-- Supersession terminates the old obligation but must name the generated
successor and a coverage/provenance incidence. -/
structure SupersessionReceipt (V : Vocabulary)
    (obligation : AdmittedObligation V) (source : V.SourceEvent) : Type u where
  successor : AdmittedObligation V
  incidence : V.SupersessionAt source
    obligation.sourceIncidence obligation.content
    successor.sourceIncidence successor.content obligation.scope successor.scope
  lineage_eq : successor.lineage = obligation.lineage
  anchorTransport : SourceAnchorTransport
    (V.sourceAnchor obligation.admission.sourceEvent)
    (V.sourceAnchor successor.admission.sourceEvent)

theorem SupersessionReceipt.successor_lineage
    {V : Vocabulary} {obligation : AdmittedObligation V}
    {source : V.SourceEvent}
    (receipt : SupersessionReceipt V obligation source) :
    receipt.successor.lineage = obligation.lineage :=
  receipt.lineage_eq

inductive ObligationTerminalReceipt (V : Vocabulary)
    (obligation : AdmittedObligation V) (source : V.SourceEvent) : Type u
  | final (receipt : FinalReceipt V obligation source)
  | superseded (receipt : SupersessionReceipt V obligation source)

/-- Bearer release keeps a visible obligation or visible residue. -/
inductive BearerReleaseReceipt (V : Vocabulary)
    (obligation : AdmittedObligation V) (source : V.SourceEvent) : Type u
  | transferredAndAccepted
      (nextBearer : V.Bearer)
      (receipt : V.TransferAcceptedAt source obligation.bearer nextBearer
        obligation.scope)
  | jurisdictionEndedWithResidue
      (receipt : V.JurisdictionEndedAt source obligation.content obligation.scope)
      (route : V.UpperRouteAt source obligation.content obligation.scope)
  | consentRevoked
      (receipt : V.ConsentRevokedAt source obligation.content obligation.scope)
      (route : V.UpperRouteAt source obligation.content obligation.scope)
  | capacityReleasedWithResidue
      (receipt : V.CapacityReleasedAt source obligation.content obligation.scope)
      (route : V.UpperRouteAt source obligation.content obligation.scope)

def BearerReleaseReceipt.target
    {V : Vocabulary} {obligation : AdmittedObligation V}
    {source : V.SourceEvent}
    (receipt : BearerReleaseReceipt V obligation source) :
    AdmittedObligation V :=
  match receipt with
  | .transferredAndAccepted nextBearer _ =>
      { obligation with bearer := nextBearer }
  | .jurisdictionEndedWithResidue .. => obligation
  | .consentRevoked .. => obligation
  | .capacityReleasedWithResidue .. => obligation

theorem BearerReleaseReceipt.target_lineage
    {V : Vocabulary} {obligation : AdmittedObligation V}
    {source : V.SourceEvent}
    (receipt : BearerReleaseReceipt V obligation source) :
    receipt.target.lineage = obligation.lineage := by
  cases receipt <;> rfl

/-- One actual review boundary generates exactly one of these branches. -/
inductive BoundaryDisposition (V : Vocabulary)
    (obligation : AdmittedObligation V) (source : V.SourceEvent) : Type u
  | carry (disposition : ActiveCarryDisposition V obligation source)
  | terminal (receipt : ObligationTerminalReceipt V obligation source)
  | bearerRelease (receipt : BearerReleaseReceipt V obligation source)

/-- Terminal archive retains the obligation and its exact final receipt. -/
structure TerminalArchive (V : Vocabulary) : Type u where
  obligation : AdmittedObligation V
  sourceEvent : V.SourceEvent
  receipt : FinalReceipt V obligation sourceEvent

inductive ObligationSlot (V : Vocabulary) : Type u
  | live (obligation : AdmittedObligation V)
  | terminal (archive : TerminalArchive V)

def BoundaryDisposition.targetSlot
    {V : Vocabulary} {obligation : AdmittedObligation V}
    {source : V.SourceEvent}
    (disposition : BoundaryDisposition V obligation source) : ObligationSlot V :=
  match disposition with
  | .carry disposition => .live disposition.target
  | .terminal (.final receipt) =>
      .terminal ⟨obligation, source, receipt⟩
  | .terminal (.superseded receipt) => .live receipt.successor
  | .bearerRelease receipt => .live receipt.target

/-- Reopen is not fresh admission: it consumes a terminal archive, performs a
new authorized admission event, and proves that the old debt lineage remains
recoverable. -/
structure NativeReopenPayload (V : Vocabulary) (archive : TerminalArchive V) :
    Type u where
  sourceEvent : V.SourceEvent
  admission : NativeAdmissionPayload V
  source_eq : admission.sourceEvent = sourceEvent
  incidence : V.ReopenAt sourceEvent
    archive.obligation.sourceIncidence archive.obligation.content
    (V.sourceIncidence admission.sourceEvent) admission.content
    archive.obligation.scope admission.scope
  lineage_eq : admission.lineage = archive.obligation.lineage
  anchorTransport : SourceAnchorTransport
    (V.sourceAnchor archive.obligation.admission.sourceEvent)
    (V.sourceAnchor admission.sourceEvent)

/-- The source process owns every raw classifier.  Events carry no
caller-selected target state or branch.  A process obtains shared-world
semantic progress only when its boundary is recognized as a dependent
projection of the exact root answer-and-next occurrence; the raw `ProgressAt`
vocabulary and this domain process are intentionally insufficient. -/
structure NativeResponsibilityProcess (V : Vocabulary.{u}) : Type (u + 1) where
  AdmissionEvent : Type u
  admissionPayload : AdmissionEvent → NativeAdmissionPayload V
  BoundaryEvent : AdmittedObligation V → Type u
  boundarySource : {obligation : AdmittedObligation V} →
    BoundaryEvent obligation → V.SourceEvent
  boundary_anchor_eq : {obligation : AdmittedObligation V} →
    (event : BoundaryEvent obligation) →
      V.sourceAnchor (boundarySource event) =
        V.sourceAnchor obligation.admission.sourceEvent
  boundary_incidence_eq : {obligation : AdmittedObligation V} →
    (event : BoundaryEvent obligation) →
      V.sourceIncidence (boundarySource event) =
        V.sourceIncidence obligation.admission.sourceEvent
  boundaryDisposition : {obligation : AdmittedObligation V} →
    (event : BoundaryEvent obligation) →
      BoundaryDisposition V obligation (boundarySource event)
  ReopenEvent : TerminalArchive V → Type u
  reopenPayload : {archive : TerminalArchive V} →
    ReopenEvent archive → NativeReopenPayload V archive

inductive LifecycleKind
  | admitted
  | progressed
  | progressedAndTransferred
  | maintained
  | deferred
  | narrowed
  | transferred
  | obligationTerminal
  | superseded
  | bearerRelease
  | reopened
  deriving DecidableEq

/-- Both lifecycle constructors which record a genuine actual update.  A
bearer route does not split progress into a second synthetic lifecycle step. -/
def LifecycleKind.IsProgress (kind : LifecycleKind) : Prop :=
  kind = .progressed ∨ kind = .progressedAndTransferred

/-- Append-only event records retain the full dependent receipt, not a mutable
status Boolean or an order-insensitive summary. -/
inductive LifecycleEvent (V : Vocabulary) : Type u
  | admitted (slot : Nat) (payload : NativeAdmissionPayload V)
  | carried
      (slot : Nat) (obligation : AdmittedObligation V)
      (source : V.SourceEvent)
      (disposition : ActiveCarryDisposition V obligation source)
  | terminal
      (slot : Nat) (obligation : AdmittedObligation V)
      (source : V.SourceEvent) (receipt : FinalReceipt V obligation source)
  | superseded
      (slot : Nat) (obligation : AdmittedObligation V)
      (source : V.SourceEvent)
      (receipt : SupersessionReceipt V obligation source)
  | bearerReleased
      (slot : Nat) (obligation : AdmittedObligation V)
      (source : V.SourceEvent)
      (receipt : BearerReleaseReceipt V obligation source)
  | reopened
      (slot : Nat) (archive : TerminalArchive V)
      (payload : NativeReopenPayload V archive)

def LifecycleEvent.kind {V : Vocabulary} (event : LifecycleEvent V) :
    LifecycleKind :=
  match event with
  | .admitted .. => .admitted
  | .carried _ _ _ (.progressed ..) => .progressed
  | .carried _ _ _ (.progressedAndTransferred ..) =>
      .progressedAndTransferred
  | .carried _ _ _ (.maintained ..) => .maintained
  | .carried _ _ _ (.deferred ..) => .deferred
  | .carried _ _ _ (.narrowed ..) => .narrowed
  | .carried _ _ _ (.transferred ..) => .transferred
  | .terminal .. => .obligationTerminal
  | .superseded .. => .superseded
  | .bearerReleased .. => .bearerRelease
  | .reopened .. => .reopened

def LifecycleEvent.slot {V : Vocabulary} (event : LifecycleEvent V) : Nat :=
  match event with
  | .admitted slot .. | .carried slot .. | .terminal slot ..
  | .superseded slot .. | .bearerReleased slot .. | .reopened slot .. => slot

/-- Current state is generated from append-only stable slots and dependent
lifecycle history.  Slot indices never change. -/
structure ResponsibilityState (V : Vocabulary) : Type u where
  slots : List (ObligationSlot V)
  history : List (LifecycleEvent V)

def ResponsibilityState.empty (V : Vocabulary) : ResponsibilityState V :=
  ⟨[], []⟩

def ResponsibilityState.LiveAt
    {V : Vocabulary} (state : ResponsibilityState V) (slot : Nat) : Prop :=
  ∃ obligation, state.slots[slot]? = some (.live obligation)

def ResponsibilityState.TerminalAt
    {V : Vocabulary} (state : ResponsibilityState V) (slot : Nat) : Prop :=
  ∃ archive, state.slots[slot]? = some (.terminal archive)

def ResponsibilityState.FreshlyAllocatedAt
    {V : Vocabulary} (source target : ResponsibilityState V) (slot : Nat) : Prop :=
  source.slots[slot]? = none ∧ target.LiveAt slot

def ResponsibilityState.NewlyLiveAt
    {V : Vocabulary} (source target : ResponsibilityState V) (slot : Nat) : Prop :=
  ¬ source.LiveAt slot ∧ target.LiveAt slot

def ResponsibilityState.DisappearsAt
    {V : Vocabulary} (source target : ResponsibilityState V) (slot : Nat) : Prop :=
  source.LiveAt slot ∧ ¬ target.LiveAt slot

namespace NativeResponsibilityProcess

variable {V : Vocabulary.{u}} (P : NativeResponsibilityProcess V)

/-- Every process-generated admission is registered under the exact source
event carried by its payload. -/
def admissionSourceOwnership (event : P.AdmissionEvent) :
    SourceOwnsResponsibilityIncidence V
      (P.admissionPayload event).sourceEvent
      (P.admissionPayload event).toObligation :=
  ⟨rfl, rfl⟩

theorem admissionPayload_preserves_anchor_scope_lineage
    (event : P.AdmissionEvent) :
    (P.admissionPayload event).scope =
        (P.admissionPayload event).toObligation.sourceAnchor.scope ∧
      (P.admissionPayload event).lineage =
        (P.admissionPayload event).toObligation.sourceAnchor.lineage :=
  ⟨(P.admissionPayload event).anchor_scope_eq,
    (P.admissionPayload event).anchor_lineage_eq⟩

/-- Every legal boundary event remains owned by the exact admission anchor
and responsibility incidence it acts on. -/
def boundarySourceOwnership
    {obligation : AdmittedObligation V}
    (event : P.BoundaryEvent obligation) :
    SourceOwnsResponsibilityIncidence V (P.boundarySource event) obligation :=
  ⟨P.boundary_anchor_eq event, P.boundary_incidence_eq event⟩

theorem boundarySource_preserves_admissionScope
    {obligation : AdmittedObligation V}
    (event : P.BoundaryEvent obligation) :
    obligation.admission.admittedScope =
      (V.sourceAnchor (P.boundarySource event)).scope := by
  calc
    obligation.admission.admittedScope = obligation.sourceAnchor.scope :=
      obligation.admittedScope_eq_sourceAnchorScope
    _ = (V.sourceAnchor (P.boundarySource event)).scope :=
      congrArg MinimalRegistrableSourceAnchor.scope
        (P.boundary_anchor_eq event).symm

theorem boundarySource_preserves_lineage
    {obligation : AdmittedObligation V}
    (event : P.BoundaryEvent obligation) :
    obligation.lineage =
      (V.sourceAnchor (P.boundarySource event)).lineage := by
  calc
    obligation.lineage = obligation.sourceAnchor.lineage :=
      obligation.lineage_eq_sourceAnchorLineage
    _ = (V.sourceAnchor (P.boundarySource event)).lineage :=
      congrArg MinimalRegistrableSourceAnchor.lineage
        (P.boundary_anchor_eq event).symm

/-- A dependent source edge.  The exact target will be computed by `target`. -/
inductive Edge (source : ResponsibilityState V) : Type u
  | admit (event : P.AdmissionEvent)
  | cross
      (slot : Fin source.slots.length)
      (obligation : AdmittedObligation V)
      (present : source.slots.get slot = .live obligation)
      (event : P.BoundaryEvent obligation)
  | reopen
      (slot : Fin source.slots.length)
      (archive : TerminalArchive V)
      (present : source.slots.get slot = .terminal archive)
      (event : P.ReopenEvent archive)

private def lifecycleEventOfBoundary
    (slot : Nat) (obligation : AdmittedObligation V)
    {source : V.SourceEvent}
    (disposition : BoundaryDisposition V obligation source) : LifecycleEvent V :=
  match disposition with
  | .carry carry => .carried slot obligation source carry
  | .terminal (.final receipt) => .terminal slot obligation source receipt
  | .terminal (.superseded receipt) =>
      .superseded slot obligation source receipt
  | .bearerRelease receipt => .bearerReleased slot obligation source receipt

def Edge.lifecycleEvent
    {source : ResponsibilityState V} (edge : P.Edge source) : LifecycleEvent V :=
  match edge with
  | .admit event => .admitted source.slots.length (P.admissionPayload event)
  | .cross slot obligation _ event =>
      lifecycleEventOfBoundary slot obligation (P.boundaryDisposition event)
  | .reopen slot archive _ event =>
      .reopened slot archive (P.reopenPayload event)

def Edge.target
    {source : ResponsibilityState V} (edge : P.Edge source) :
    ResponsibilityState V :=
  match edge with
  | .admit event =>
      { slots := source.slots ++ [.live (P.admissionPayload event).toObligation]
        history := source.history ++ [edge.lifecycleEvent] }
  | .cross slot _ _ event =>
      { slots := source.slots.set slot
          (P.boundaryDisposition event).targetSlot
        history := source.history ++ [edge.lifecycleEvent] }
  | .reopen slot _ _ event =>
      { slots := source.slots.set slot
          (.live (P.reopenPayload event).admission.toObligation)
        history := source.history ++ [edge.lifecycleEvent] }

theorem Edge.history_append
    {source : ResponsibilityState V} (edge : P.Edge source) :
    edge.target.history = source.history ++ [edge.lifecycleEvent] := by
  cases edge <;> rfl

theorem Edge.history_prefix
    {source : ResponsibilityState V} (edge : P.Edge source) :
    source.history <+: edge.target.history := by
  rw [edge.history_append]
  exact List.prefix_append _ _

theorem Edge.history_length_succ
    {source : ResponsibilityState V} (edge : P.Edge source) :
    edge.target.history.length = source.history.length + 1 := by
  rw [edge.history_append, List.length_append]
  simp

theorem admit_target_slot
    {source : ResponsibilityState V} (event : P.AdmissionEvent) :
    (Edge.admit (P := P) event : P.Edge source).target.slots[source.slots.length]? =
      some (.live (P.admissionPayload event).toObligation) := by
  exact List.getElem?_concat_length

theorem cross_target_slot
    {source : ResponsibilityState V}
    (slot : Fin source.slots.length)
    (obligation : AdmittedObligation V)
    (present : source.slots.get slot = .live obligation)
    (event : P.BoundaryEvent obligation) :
    (Edge.cross (P := P) slot obligation present event).target.slots[slot.val]? =
      some (P.boundaryDisposition event).targetSlot := by
  rw [Edge.target, List.getElem?_set]
  simp [slot.isLt]

theorem reopen_target_slot
    {source : ResponsibilityState V}
    (slot : Fin source.slots.length)
    (archive : TerminalArchive V)
    (present : source.slots.get slot = .terminal archive)
    (event : P.ReopenEvent archive) :
    (Edge.reopen (P := P) slot archive present event).target.slots[slot.val]? =
      some (.live (P.reopenPayload event).admission.toObligation) := by
  rw [Edge.target, List.getElem?_set]
  simp [slot.isLt]

/-- A dependent ordered fold.  Exact targets are generated by each preceding
edge, so the next source and branch cannot be supplied independently. -/
inductive Run (source : ResponsibilityState V) :
    ResponsibilityState V → Type u
  | nil : Run source source
  | step {middle : ResponsibilityState V}
      (prior : Run source middle) (edge : P.Edge middle) :
      Run source edge.target

def Run.events
    {source target : ResponsibilityState V} (run : P.Run source target) :
    List (LifecycleEvent V) :=
  match run with
  | .nil => []
  | .step prior edge => prior.events ++ [edge.lifecycleEvent]

theorem Run.history_eq
    {source target : ResponsibilityState V} (run : P.Run source target) :
    target.history = source.history ++ run.events := by
  induction run with
  | nil => simp [Run.events]
  | step prior edge ih =>
      rw [edge.history_append, ih]
      simp [Run.events, List.append_assoc]

def Run.snoc
    {source middle : ResponsibilityState V}
    (run : P.Run source middle) (edge : P.Edge middle) :
    P.Run source edge.target :=
  .step run edge

def Run.concatRuns
    {source middle : ResponsibilityState V}
    (left : P.Run source middle) :
    {target : ResponsibilityState V} → P.Run middle target →
      P.Run source target
  | _, .nil => left
  | _, .step prior edge =>
      .step (left.concatRuns prior) edge

theorem Run.events_concatRuns
    {source middle target : ResponsibilityState V}
    (left : P.Run source middle) (right : P.Run middle target) :
    (NativeResponsibilityProcess.Run.concatRuns P left right).events =
      left.events ++ right.events := by
  induction right with
  | nil => simp [Run.concatRuns, Run.events]
  | step prior edge ih =>
      simp only [Run.concatRuns, Run.events]
      rw [ih, List.append_assoc]

/-- Public fold-derived state.  Its current view cannot be supplied without a
dependent run from the empty lifecycle. -/
structure GeneratedState (P : NativeResponsibilityProcess V) : Type u where
  current : ResponsibilityState V
  generated : P.Run (ResponsibilityState.empty V) current

def GeneratedState.initial : GeneratedState P :=
  ⟨ResponsibilityState.empty V, .nil⟩

def GeneratedState.step
    (state : GeneratedState P) (edge : P.Edge state.current) :
    GeneratedState P :=
  ⟨edge.target, .step state.generated edge⟩

theorem GeneratedState.history_eq
    (state : GeneratedState P) :
    state.current.history = state.generated.events := by
  simpa [ResponsibilityState.empty] using state.generated.history_eq

private theorem liveAt_of_present
    {source : ResponsibilityState V}
    (slot : Fin source.slots.length)
    (obligation : AdmittedObligation V)
    (present : source.slots.get slot = .live obligation) :
    source.LiveAt slot.val := by
  refine ⟨obligation, ?_⟩
  calc
    source.slots[slot.val]? = some source.slots[slot] :=
      List.getElem?_eq_getElem slot.isLt
    _ = some (.live obligation) := congrArg some present

private theorem liveAt_set_live
    {source : ResponsibilityState V}
    (changedSlot : Fin source.slots.length)
    (targetObligation : AdmittedObligation V)
    {slot : Nat} (sourceLive : source.LiveAt slot) :
    ∃ obligation,
      (source.slots.set changedSlot (.live targetObligation))[slot]? =
        some (.live obligation) := by
  rcases sourceLive with ⟨sourceObligation, sourceAt⟩
  by_cases slot_eq : changedSlot.val = slot
  · refine ⟨targetObligation, ?_⟩
    have slot_lt : slot < source.slots.length := by
      rw [← slot_eq]
      exact changedSlot.isLt
    simp [slot_eq, slot_lt]
  · refine ⟨sourceObligation, ?_⟩
    rw [List.getElem?_set]
    simp [slot_eq, sourceAt]

private theorem sourceLive_of_crossTargetLive
    {source : ResponsibilityState V}
    (changedSlot : Fin source.slots.length)
    (obligation : AdmittedObligation V)
    (present : source.slots.get changedSlot = .live obligation)
    (replacement : ObligationSlot V)
    {slot : Nat}
    (targetLive : ∃ targetObligation,
      (source.slots.set changedSlot replacement)[slot]? =
        some (.live targetObligation)) :
    source.LiveAt slot := by
  by_cases slot_eq : changedSlot.val = slot
  · rw [← slot_eq]
    exact liveAt_of_present changedSlot obligation present
  · rcases targetLive with ⟨targetObligation, targetAt⟩
    refine ⟨targetObligation, ?_⟩
    rw [List.getElem?_set] at targetAt
    simpa [slot_eq] using targetAt

/-- No-free generation, exact form: a genuinely fresh stable slot can only
be allocated by an actual admission event. -/
theorem Edge.freshlyAllocated_implies_admitted
    {source : ResponsibilityState V} (edge : P.Edge source) (slot : Nat)
    (fresh : ResponsibilityState.FreshlyAllocatedAt source edge.target slot) :
    edge.lifecycleEvent.kind = .admitted := by
  rcases fresh with ⟨sourceNone, targetLive⟩
  cases edge with
  | admit event => rfl
  | cross changedSlot obligation present event =>
      rcases targetLive with ⟨targetObligation, targetAt⟩
      have target_lt :
          slot < (source.slots.set changedSlot
            (P.boundaryDisposition event).targetSlot).length :=
        (List.getElem?_eq_some_iff.mp targetAt).choose
      have source_lt : slot < source.slots.length := by
        simpa using target_lt
      exact ((Nat.not_lt_of_ge
        (List.getElem?_eq_none_iff.mp sourceNone)) source_lt).elim
  | reopen changedSlot archive present event =>
      rcases targetLive with ⟨targetObligation, targetAt⟩
      have target_lt :
          slot < (source.slots.set changedSlot
            (.live (P.reopenPayload event).admission.toObligation)).length :=
        (List.getElem?_eq_some_iff.mp targetAt).choose
      have source_lt : slot < source.slots.length := by
        simpa using target_lt
      exact ((Nat.not_lt_of_ge
        (List.getElem?_eq_none_iff.mp sourceNone)) source_lt).elim

/-- Receipt-level no-free generation witness. -/
structure FreshAdmissionWitness
    {source : ResponsibilityState V} (edge : P.Edge source) (slot : Nat) :
    Type u where
  event : P.AdmissionEvent
  event_eq : edge.lifecycleEvent =
    .admitted slot (P.admissionPayload event)

def Edge.freshlyAllocated_generates_admission
    {source : ResponsibilityState V} (edge : P.Edge source) (slot : Nat)
    (fresh : ResponsibilityState.FreshlyAllocatedAt source edge.target slot) :
    P.FreshAdmissionWitness edge slot := by
  have admitted :=
    NativeResponsibilityProcess.Edge.freshlyAllocated_implies_admitted
      P edge slot fresh
  cases edge with
  | admit event =>
      rcases fresh with ⟨sourceNone, targetLive⟩
      have slot_eq : slot = source.slots.length := by
        rcases targetLive with ⟨targetObligation, targetAt⟩
        have target_lt :
            slot < (source.slots ++
              [ObligationSlot.live
                (P.admissionPayload event).toObligation]).length :=
          (List.getElem?_eq_some_iff.mp targetAt).choose
        have source_le : source.slots.length ≤ slot :=
          List.getElem?_eq_none_iff.mp sourceNone
        simp only [List.length_append, List.length_cons, List.length_nil,
          Nat.add_one] at target_lt
        omega
      subst slot
      exact ⟨event, rfl⟩
  | cross changedSlot obligation present event =>
      cases disposition_eq : P.boundaryDisposition event with
      | carry carry =>
          cases carry <;>
            simp [Edge.lifecycleEvent, lifecycleEventOfBoundary,
              disposition_eq, LifecycleEvent.kind] at admitted
      | terminal receipt =>
          cases receipt <;>
            simp [Edge.lifecycleEvent, lifecycleEventOfBoundary,
              disposition_eq, LifecycleEvent.kind] at admitted
      | bearerRelease receipt =>
          simp [Edge.lifecycleEvent, lifecycleEventOfBoundary,
            disposition_eq, LifecycleEvent.kind] at admitted
  | reopen changedSlot archive present event =>
      simp [Edge.lifecycleEvent, LifecycleEvent.kind] at admitted

/-- Reopening is the only non-admission way for an existing stable slot to
become live.  It carries a terminal archive and an exact lineage equation. -/
theorem Edge.newlyLive_implies_admitted_or_reopened
    {source : ResponsibilityState V} (edge : P.Edge source) (slot : Nat)
    (fresh : ResponsibilityState.NewlyLiveAt source edge.target slot) :
    edge.lifecycleEvent.kind = .admitted ∨
      edge.lifecycleEvent.kind = .reopened := by
  rcases fresh with ⟨notSourceLive, targetLive⟩
  cases edge with
  | admit event => exact Or.inl rfl
  | cross changedSlot obligation present event =>
      apply False.elim
      apply notSourceLive
      apply sourceLive_of_crossTargetLive changedSlot obligation present
        (P.boundaryDisposition event).targetSlot
      exact targetLive
  | reopen changedSlot archive present event => exact Or.inr rfl

/-- A boundary event generates its typed disposition and exact target slot.
The disposition is computed by the process classifier; it is not an input to
this theorem or to `Edge.cross`. -/
theorem cross_generates_native_disposition
    {source : ResponsibilityState V}
    (slot : Fin source.slots.length)
    (obligation : AdmittedObligation V)
    (present : source.slots.get slot = .live obligation)
    (event : P.BoundaryEvent obligation) :
    ∃ disposition : BoundaryDisposition V obligation (P.boundarySource event),
      disposition = P.boundaryDisposition event ∧
      (Edge.cross (P := P) slot obligation present event).target.slots[slot.val]? =
        some disposition.targetSlot := by
  exact ⟨P.boundaryDisposition event, rfl,
    cross_target_slot (P := P) slot obligation present event⟩

/-- No-free disappearance: only a final obligation-level receipt can make a
live stable slot non-live.  Supersession, carrying, and bearer release all
leave a live successor in the same lineage slot. -/
theorem Edge.disappears_implies_obligationTerminal
    {source : ResponsibilityState V} (edge : P.Edge source) (slot : Nat)
    (gone : ResponsibilityState.DisappearsAt source edge.target slot) :
    edge.lifecycleEvent.kind = .obligationTerminal := by
  rcases gone with ⟨sourceLive, notTargetLive⟩
  cases edge with
  | admit event =>
      rcases sourceLive with ⟨obligation, sourceAt⟩
      have slot_lt : slot < source.slots.length :=
        (List.getElem?_eq_some_iff.mp sourceAt).choose
      have targetAt :
          (source.slots ++ [.live (P.admissionPayload event).toObligation])[slot]? =
            some (.live obligation) := by
        rw [List.getElem?_append_left slot_lt]
        exact sourceAt
      exact (notTargetLive ⟨obligation, targetAt⟩).elim
  | reopen changedSlot archive present event =>
      apply False.elim
      apply notTargetLive
      exact liveAt_set_live changedSlot
        (P.reopenPayload event).admission.toObligation sourceLive
  | cross changedSlot obligation present event =>
      cases disposition_eq : P.boundaryDisposition event with
      | carry carry =>
          apply False.elim
          apply notTargetLive
          simpa [ResponsibilityState.LiveAt, Edge.target,
            BoundaryDisposition.targetSlot,
            disposition_eq] using
            (liveAt_set_live changedSlot carry.target sourceLive)
      | bearerRelease release =>
          apply False.elim
          apply notTargetLive
          simpa [ResponsibilityState.LiveAt, Edge.target,
            BoundaryDisposition.targetSlot,
            disposition_eq] using
            (liveAt_set_live changedSlot release.target sourceLive)
      | terminal terminalReceipt =>
          cases terminalReceipt with
          | final receipt =>
              simp [Edge.lifecycleEvent, lifecycleEventOfBoundary,
                disposition_eq, LifecycleEvent.kind]
          | superseded receipt =>
              apply False.elim
              apply notTargetLive
              simpa [ResponsibilityState.LiveAt, Edge.target,
                BoundaryDisposition.targetSlot,
                disposition_eq] using
                (liveAt_set_live changedSlot receipt.successor sourceLive)

/-- Receipt-level no-free disappearance witness. -/
structure FinalDisappearanceWitness
    {source : ResponsibilityState V} (edge : P.Edge source) (slot : Nat) :
    Type u where
  obligation : AdmittedObligation V
  sourceEvent : V.SourceEvent
  receipt : FinalReceipt V obligation sourceEvent
  event_eq : edge.lifecycleEvent =
    .terminal slot obligation sourceEvent receipt

def Edge.disappears_generates_finalReceipt
    {source : ResponsibilityState V} (edge : P.Edge source) (slot : Nat)
    (gone : ResponsibilityState.DisappearsAt source edge.target slot) :
    P.FinalDisappearanceWitness edge slot := by
  have terminalKind :=
    NativeResponsibilityProcess.Edge.disappears_implies_obligationTerminal
      P edge slot gone
  cases edge with
  | admit event =>
      simp [Edge.lifecycleEvent, LifecycleEvent.kind] at terminalKind
  | reopen changedSlot archive present event =>
      simp [Edge.lifecycleEvent, LifecycleEvent.kind] at terminalKind
  | cross changedSlot obligation present event =>
      cases disposition_eq : P.boundaryDisposition event with
      | carry carry =>
          cases carry <;>
            simp [Edge.lifecycleEvent, lifecycleEventOfBoundary,
              disposition_eq, LifecycleEvent.kind] at terminalKind
      | bearerRelease receipt =>
          simp [Edge.lifecycleEvent, lifecycleEventOfBoundary,
            disposition_eq, LifecycleEvent.kind] at terminalKind
      | terminal terminalReceipt =>
          cases terminalReceipt with
          | superseded receipt =>
              simp [Edge.lifecycleEvent, lifecycleEventOfBoundary,
                disposition_eq, LifecycleEvent.kind] at terminalKind
          | final receipt =>
              have changedSlot_eq : changedSlot.val = slot := by
                by_contra slot_ne
                rcases gone.1 with ⟨sourceObligation, sourceAt⟩
                apply gone.2
                refine ⟨sourceObligation, ?_⟩
                simp [Edge.target, disposition_eq, slot_ne, sourceAt]
              refine ⟨obligation, P.boundarySource event, receipt, ?_⟩
              simp [Edge.lifecycleEvent, lifecycleEventOfBoundary,
                disposition_eq, changedSlot_eq]

/-- Signals used for routing, aging, or transfer offers are deliberately
outside the lifecycle edge grammar.  Observing one cannot mutate the fold. -/
inductive NonAdmissionSignal (V : Vocabulary) : Type u
  | nextActor (signal : V.NextActorSignal)
  | age (signal : V.AgeSignal)
  | transferOffer (signal : V.TransferOfferSignal)

def ResponsibilityState.observeNonAdmission
    {V : Vocabulary} (state : ResponsibilityState V)
    (_ : NonAdmissionSignal V) : ResponsibilityState V :=
  state

theorem ResponsibilityState.observeNonAdmission_eq
    {V : Vocabulary} (state : ResponsibilityState V)
    (signal : NonAdmissionSignal V) :
    NativeResponsibilityProcess.ResponsibilityState.observeNonAdmission
      state signal = state := rfl

end NativeResponsibilityProcess

end ResponsibilityLifecycle
end SaturationMonoid
