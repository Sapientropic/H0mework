import H0mework.Foundation.Responsibility.DebtWorldReadback

/-!
# Law-indexed complete ledger evolution for debt activation

The activation world has an arbitrary old responsibility fibre and one
law-owned debt row.  This kernel evolves the complete fibre directly: old
rows are faithfully transferred by the same source step receipt, while the
debt row is maintained with the strict budget decrease generated by that
step.  Same-debt transport instead covers every row with one actual receipt
and a non-refill inequality.  A debt settlement proves only that the tracked
row has zero budget; complete terminal discharge additionally requires either
an actual base-support settlement receipt or an independent source-generated
phase-terminal event.

No finite inventory, finite patch, row table, or selected representative is
used.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace DebtActivationLedger

open DebtActivationWorld

universe u

variable {N : WorldRelationNetwork.{u}} {law : DebtActivationLaw.{u}}

/-- Complete ledger at one active debt state. -/
def activeLedger (support : N.Support) (state : law.DebtState) :
    CompleteLiveLedgerAt (ExtendedNetwork N law) :=
  ⟨⟨support, some state⟩⟩

/-- Complete ledger at the debt-inactive sibling support. -/
def inactiveLedger (support : N.Support) :
    CompleteLiveLedgerAt (ExtendedNetwork N law) :=
  ⟨⟨support, none⟩⟩

/-- Total whole-ledger evolution indexed by one debt-law step.
Every old row is transported by the step's transfer receipt.  The unique
debt row alone consumes the strict maintenance budget decrease. -/
def stepLedgerEvolution
    (support : N.Support) {source target : law.DebtState}
    (step : law.StepAt source target) :
    LedgerWriteEvolutionAt (ExtendedNetwork N law)
      (activeLedger support source) (activeLedger support target) where
  destination := by
    rintro ⟨responsibility, opened⟩
    cases responsibility with
    | inl oldResponsibility =>
        exact ⟨⟨.inl oldResponsibility, opened⟩,
          .transferred (debtStepReceipt support step) rfl rfl (Nat.le_refl _)⟩
    | inr debtId =>
        rcases opened with ⟨⟨debtId_eq⟩⟩
        subst debtId
        exact ⟨debtEntry (N := N) support target,
          .maintained rfl rfl rfl rfl rfl (law.step_budget_lt step)⟩
  origin := by
    rintro ⟨responsibility, opened⟩
    cases responsibility with
    | inl oldResponsibility =>
        exact ⟨⟨.inl oldResponsibility, opened⟩,
          .transferred (debtStepReceipt support step) rfl rfl (Nat.le_refl _)⟩
    | inr debtId =>
        rcases opened with ⟨⟨debtId_eq⟩⟩
        subst debtId
        exact ⟨debtEntry (N := N) support source,
          .maintained rfl rfl rfl rfl rfl (law.step_budget_lt step)⟩

/-- Total whole-ledger evolution for an actual same-debt transport.  Every
row uses the one transport receipt; the debt row preserves identity and may
keep, but never increase, its source-owned budget. -/
def transportLedgerEvolution
    (support : N.Support) {source target : law.DebtState}
    (transport : law.TransportAt source target) :
    LedgerWriteEvolutionAt (ExtendedNetwork N law)
      (activeLedger support source) (activeLedger support target) where
  destination := by
    rintro ⟨responsibility, opened⟩
    cases responsibility with
    | inl oldResponsibility =>
        exact ⟨⟨.inl oldResponsibility, opened⟩,
          .transferred (debtTransportReceipt support transport)
            rfl rfl (Nat.le_refl _)⟩
    | inr debtId =>
        rcases opened with ⟨⟨debtId_eq⟩⟩
        subst debtId
        exact ⟨debtEntry (N := N) support target,
          .transferred (debtTransportReceipt support transport)
            rfl rfl (law.transport_budget_le transport)⟩
  origin := by
    rintro ⟨responsibility, opened⟩
    cases responsibility with
    | inl oldResponsibility =>
        exact ⟨⟨.inl oldResponsibility, opened⟩,
          .transferred (debtTransportReceipt support transport)
            rfl rfl (Nat.le_refl _)⟩
    | inr debtId =>
        rcases opened with ⟨⟨debtId_eq⟩⟩
        subst debtId
        exact ⟨debtEntry (N := N) support source,
          .transferred (debtTransportReceipt support transport)
            rfl rfl (law.transport_budget_le transport)⟩

/-- Total terminal discharge from a debt-zero certificate together with an
actual base-support settlement receipt.  Debt zero alone cannot close old
rows or mint a faithful terminal. -/
def settlementLedgerEvolution
    (support : N.Support) {state : law.DebtState}
    (_settlement : law.SettlementAt state)
    (baseReceipt : N.DispositionAt support .supportSettlement) :
    LedgerTerminalEvolutionAt (ExtendedNetwork N law)
      (activeLedger support state) where
  discharge := fun _entry =>
    ⟨baseSettlementReceipt (law := law) (state? := some state)
      support baseReceipt⟩

/-- Complete terminal discharge generated by one independent phase-terminal
event.  Unlike `settlementLedgerEvolution`, this path consumes no base receipt;
unlike local `SettlementAt`, the event itself is an explicit source family. -/
def supportTerminalLedgerEvolution
    (support : N.Support) {state : law.DebtState}
    (terminal : law.SupportTerminalAt state) :
    LedgerTerminalEvolutionAt (ExtendedNetwork N law)
      (activeLedger support state) where
  discharge := fun _entry =>
    ⟨debtSupportTerminalReceipt support terminal⟩

/-- The debt row discharged by a settlement has zero remaining budget. -/
theorem settlement_debt_budget_zero
    (support : N.Support) {state : law.DebtState}
    (settlement : law.SettlementAt state) :
    (debtEntry (N := N) support state).progressBudget = 0 :=
  debtSettlement_budget_zero support settlement

/-- The phase event's contained settlement discharges the debt clock. -/
theorem supportTerminal_debt_budget_zero
    (support : N.Support) {state : law.DebtState}
    (terminal : law.SupportTerminalAt state) :
    (debtEntry (N := N) support state).progressBudget = 0 :=
  debtSupportTerminal_budget_zero support terminal

end DebtActivationLedger
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
