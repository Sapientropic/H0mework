import Mathlib.Topology.MetricSpace.Basic
import H0mework.Foundation.Authority.Factorization
import H0mework.Foundation.Authority.EntryDisposition
import H0mework.Foundation.Semantics.RootReality

/-!
# Source-rooted analytic uniqueness lock

The root compiler already fixes an exact occurrence, every installed face,
its answer-and-next transition, and the next current. Analytic uniqueness
must therefore not accept a caller-selected canonical actual, target current,
standing, or `NoMagic` certificate.

This kernel fixes an active payload of one exact source occurrence and an
injective metric density readout of that payload. Its only quantitative key
is pairwise vanishing of the squared density distance for two admissible
actuals. Once that key is supplied, the root engine identifies every
admissible actual with the source-generated projection payload; the canonical
answer, next current, and causal-entry standing remain direct readouts of the
same root compiler.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot

open TotalReality

universe u

/-- An analytic actual carrier rooted at one active projection of one exact
living-root occurrence. -/
structure SourceRootedActualEnergyFaceAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V)
    (visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot)
    (EnergyDensity : Type u) [MetricSpace EnergyDensity] : Type (u + 1) where
  entry : OpenResponsibilityAt N
    (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
      (root.emitted visit.current))
  standing : SourceNativeLivingTemporalCausalEntryAuthorityAt root visit entry
  projection : root.toAuthoritativeRoot.source.projectionLaw.Projection
  active : root.toAuthoritativeRoot.source.projectionLaw.ActiveAt projection
    (root.emitted visit.current)
  classified :
    root.toAuthoritativeRoot.source.projectionLaw.classify projection
        (root.emitted visit.current) =
      .inl active
  density :
    root.toAuthoritativeRoot.source.projectionLaw.PayloadAt projection
        (root.emitted visit.current) active →
      EnergyDensity
  density_injective : Function.Injective density

namespace SourceRootedActualEnergyFaceAt

/-- The exact payload type selected before any analytic uniqueness argument. -/
abbrev Actual
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {EnergyDensity : Type u} [MetricSpace EnergyDensity]
    (face : SourceRootedActualEnergyFaceAt root visit EnergyDensity) : Type u :=
  root.toAuthoritativeRoot.source.projectionLaw.PayloadAt face.projection
    (root.emitted visit.current) face.active

/-- `U*`: the actual payload generated by the fixed source classifier at this
exact occurrence. It is a definition, not a theorem argument. -/
def canonicalActual
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {EnergyDensity : Type u} [MetricSpace EnergyDensity]
    (face : SourceRootedActualEnergyFaceAt root visit EnergyDensity) :
    face.Actual :=
  root.toAuthoritativeRoot.source.projectionLaw.project face.projection
    (root.emitted visit.current) face.active

/-- Squared metric distance between the complete density readouts of two
actuals. The root owns definiteness; a domain supplies only its vanishing. -/
def differenceEnergy
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {EnergyDensity : Type u} [MetricSpace EnergyDensity]
    (face : SourceRootedActualEnergyFaceAt root visit EnergyDensity)
    (left right : face.Actual) : ℝ :=
  dist (face.density left) (face.density right) ^ 2

/-- The one analytic key accepted by the lock: every pair in this source
law's admissible-actual payload fibre has zero difference energy. -/
def PairwiseDifferenceEnergyZeroAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {EnergyDensity : Type u} [MetricSpace EnergyDensity]
    (face : SourceRootedActualEnergyFaceAt root visit EnergyDensity) : Prop :=
  ∀ left right : face.Actual,
    face.differenceEnergy left right = 0

/-- The source classifier really emits `canonicalActual`; an active proof or
post-hoc payload cannot replace it. -/
theorem outcomeAt_eq_canonicalActual
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {EnergyDensity : Type u} [MetricSpace EnergyDensity]
    (face : SourceRootedActualEnergyFaceAt root visit EnergyDensity) :
    root.toAuthoritativeRoot.source.projectionLaw.outcomeAt face.projection
        (root.emitted visit.current) =
      .inl ⟨face.active, face.canonicalActual⟩ := by
  unfold SourceNativeProjectionLaw.outcomeAt canonicalActual
  rw [face.classified]

/-! ## Positive total reality on the source-rooted actual fibre -/

/-- A claimed difference between two admissible actuals of the same source
face. -/
abbrev Difference
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {EnergyDensity : Type u} [MetricSpace EnergyDensity]
    (face : SourceRootedActualEnergyFaceAt root visit EnergyDensity) : Type u :=
  face.Actual × face.Actual

/-- Total-reality semantics for one exact source face. Structural identity is
positive density separation, not a supplied no-magic proposition. -/
def semantics
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {EnergyDensity : Type u} [MetricSpace EnergyDensity]
    (face : SourceRootedActualEnergyFaceAt root visit EnergyDensity) :
    RealityDifferenceSemantics where
  Difference := face.Difference
  ActualAt := fun _difference => True
  StableReferenceAt := fun _difference =>
    root.toAuthoritativeRoot.source.projectionLaw.classify face.projection
        (root.emitted visit.current) =
      .inl face.active
  RealDifferenceAt := fun difference => difference.1 ≠ difference.2
  RedundantAt := fun difference => difference.1 = difference.2
  StructuralIdentityAt := fun difference =>
    face.density difference.1 ≠ face.density difference.2

/-- A genuine pair of admissible actuals is an actual difference in the fixed
source-rooted semantics. -/
theorem actualDifference
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {EnergyDensity : Type u} [MetricSpace EnergyDensity]
    (face : SourceRootedActualEnergyFaceAt root visit EnergyDensity)
    {left right : face.Actual}
    (different : left ≠ right) :
    ActualDifferenceAt face.semantics (left, right) where
  actual := trivial
  stableReference := face.classified
  realDifference := different

/-- Positive total reality: every real difference inside the fixed source
face has a density-level structural identity. -/
theorem isTotal
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {EnergyDensity : Type u} [MetricSpace EnergyDensity]
    (face : SourceRootedActualEnergyFaceAt root visit EnergyDensity) :
    TotalRealityAt face.semantics where
  locate := by
    intro difference actual
    exact Or.inr (fun sameDensity =>
      actual.realDifference (face.density_injective sameDensity))

/-- No same-source admissible actual difference can remain an unaccounted
magic bit. -/
theorem noMagicBit
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {EnergyDensity : Type u} [MetricSpace EnergyDensity]
    (face : SourceRootedActualEnergyFaceAt root visit EnergyDensity)
    {difference : face.Difference} :
    MagicBitAt face.semantics difference → False :=
  face.isTotal.noMagicBit

/-! ## The analytic key unlocks the root-generated actual and standing -/

private theorem density_eq_of_differenceEnergy_eq_zero
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {EnergyDensity : Type u} [MetricSpace EnergyDensity]
    (face : SourceRootedActualEnergyFaceAt root visit EnergyDensity)
    {left right : face.Actual}
    (energyZero : face.differenceEnergy left right = 0) :
    face.density left = face.density right := by
  have distanceMul :
      dist (face.density left) (face.density right) *
          dist (face.density left) (face.density right) = 0 := by
    simpa only [differenceEnergy, pow_two] using energyZero
  have distanceZero :
      dist (face.density left) (face.density right) = 0 :=
    mul_self_eq_zero.mp distanceMul
  exact dist_eq_zero.mp distanceZero

/-- Pairwise zero energy identifies any two actuals in the fixed source
payload fibre. -/
theorem actual_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {EnergyDensity : Type u} [MetricSpace EnergyDensity]
    (face : SourceRootedActualEnergyFaceAt root visit EnergyDensity)
    (energyZero : face.PairwiseDifferenceEnergyZeroAt)
    {left right : face.Actual} :
    left = right :=
  face.density_injective
    (density_eq_of_differenceEnergy_eq_zero face
      (energyZero left right))

/-- The source-generated payload is the unique actual in the source law's
admissible payload fibre. -/
theorem existsUnique_actual
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {EnergyDensity : Type u} [MetricSpace EnergyDensity]
    (face : SourceRootedActualEnergyFaceAt root visit EnergyDensity)
    (energyZero : face.PairwiseDifferenceEnergyZeroAt) :
    ∃! _actual : face.Actual, True := by
  refine ⟨face.canonicalActual, trivial, ?_⟩
  intro actual _actualAt
  exact face.actual_eq energyZero

/-- Final source-rooted uniqueness lock.

The only analytic input is `energyZero`. The unique actual is the fixed
projection payload; the projection readout, canonical answer-and-next, next
current, and causal-entry standing fixed in `face` are all generated by the
same root and visit. -/
theorem unlock
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {EnergyDensity : Type u} [MetricSpace EnergyDensity]
    (face : SourceRootedActualEnergyFaceAt root visit EnergyDensity)
    (energyZero : face.PairwiseDifferenceEnergyZeroAt) :
    let evolution :=
      root.canonicalCausalAnswerAndNext
        (show SourceNativeLivingRootCausalCurrentAt root from ULift.up visit)
    let answerAndNext :=
      root.generatedCausalEntryAnswerAndNextAt visit face.entry face.standing
    (∃! _actual : face.Actual, True) ∧
      HEq (evolution.generated.projectionOutcome face.projection)
        (Sum.inl ⟨face.active, face.canonicalActual⟩ :
          SourceNativeProjectionFiberAt
            root.toAuthoritativeRoot.source.projectionLaw face.projection
            (root.emitted visit.current)) ∧
      evolution.nextCurrent = root.generatedNextCurrentAt visit ∧
      answerAndNext.nextCurrent = root.generatedNextCurrentAt visit := by
  dsimp only
  refine ⟨face.existsUnique_actual energyZero, ?_, rfl, rfl⟩
  exact
    ((root.canonicalCausalAnswerAndNext
        (show SourceNativeLivingRootCausalCurrentAt root from ULift.up visit))
      |>.generated.projectionOutcome_heq_sourceOutcome face.projection).trans
      (heq_of_eq face.outcomeAt_eq_canonicalActual)

end SourceRootedActualEnergyFaceAt
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
