import H0mework.Foundation.Semantics.TheoryState
import Mathlib.Data.Set.Basic

/-!
# Revision families and comparison histories

The minimal theory epoch, exact failure and U7-to-U8 demand live in
`LivingLawTheoryStateKernel`.  This module starts with translations and keeps
revision comparison and selection as explicit generated histories.

Every candidate audits each old law as preserved, weakened, or replaced.
Every queried candidate pair is faithfully equivalent, separated by an exact
pair-process occurrence whose outcome excludes faithful equivalence, or
generates a multiplicity meta-residual.  Actual selection is a later source
event carrying its exact
anchor/incidence/lineage and a finite generated comparison history.  Concrete
consumer demand, law profile, and semantic cost may be restrictions of that
event; the generic core does not accept separate inhabited receipts for them.
Generic `Equiv`, quotient transport, classical selection, and initial-object
assumptions are not part of this constructive core.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution

universe u

/-! ## Optional, occurrence-indexed law-deletion diagnostics -/

/-- Deleting one law produces either a concrete near miss or an unresolved
diagnostic obligation.  This readout is deliberately outside
`ActualExpressibilityFailure`: U8 authority needs the complete realization
fibre to be empty, not a caller-supplied table of per-law answers. -/
inductive LawDeletionAuditAt
    {N : WorldRelationNetwork.{u}} (inventory : LawInventory N)
    {support : N.Support} (obstruction : N.ObstructionAt support)
    (law : inventory.Law) : Type u
  | nearMiss (realization : inventory.RealizationWithoutAt law obstruction)
  | unresolved

/-- Source process for querying one exact law-deletion diagnostic.  A source
may define the static law vocabulary globally, but public audit evidence is
generated only at the requested law occurrence. -/
structure LawDeletionAuditSourceAt
    {N : WorldRelationNetwork.{u}} (inventory : LawInventory N)
    {support : N.Support} (obstruction : N.ObstructionAt support) :
    Type (u + 1) where
  OccurrenceAt : inventory.Law → Type u
  emit : (law : inventory.Law) → OccurrenceAt law
  event_eq_emit : (law : inventory.Law) →
    (occurrence : OccurrenceAt law) → occurrence = emit law
  compileAudit : (law : inventory.Law) → OccurrenceAt law →
    LawDeletionAuditAt inventory obstruction law

/-- Canonical generated deletion-audit occurrence. -/
inductive GeneratedLawDeletionAuditAt
    {N : WorldRelationNetwork.{u}} {inventory : LawInventory N}
    {support : N.Support} {obstruction : N.ObstructionAt support}
    (source : LawDeletionAuditSourceAt inventory obstruction)
    (law : inventory.Law) : Type u
  | canonical

namespace LawDeletionAuditSourceAt

def generated
    {N : WorldRelationNetwork.{u}} {inventory : LawInventory N}
    {support : N.Support} {obstruction : N.ObstructionAt support}
    (source : LawDeletionAuditSourceAt inventory obstruction)
    (law : inventory.Law) : GeneratedLawDeletionAuditAt source law :=
  .canonical

end LawDeletionAuditSourceAt

namespace GeneratedLawDeletionAuditAt

def audit
    {N : WorldRelationNetwork.{u}} {inventory : LawInventory N}
    {support : N.Support} {obstruction : N.ObstructionAt support}
    {source : LawDeletionAuditSourceAt inventory obstruction}
    {law : inventory.Law}
    (_generated : GeneratedLawDeletionAuditAt source law) :
    LawDeletionAuditAt inventory obstruction law :=
  source.compileAudit law (source.emit law)

theorem eq_generated
    {N : WorldRelationNetwork.{u}} {inventory : LawInventory N}
    {support : N.Support} {obstruction : N.ObstructionAt support}
    {source : LawDeletionAuditSourceAt inventory obstruction}
    {law : inventory.Law}
    (generated : GeneratedLawDeletionAuditAt source law) :
    generated = source.generated law := by
  cases generated
  rfl

end GeneratedLawDeletionAuditAt

/-- Conservative translation commutes with the shared-world semantics. -/
structure ConservativeTheoryTranslation
    {N : WorldRelationNetwork.{u}} (old revised : TheoryState N) : Type (u + 1) where
  compile : {support : N.Support} →
    old.ExpressionAt support → revised.ExpressionAt support
  commuting : {support : N.Support} →
    (expression : old.ExpressionAt support) →
    revised.denotes (compile expression) = old.denotes expression

/-- Old theorem survival is generated by the commuting square and the two
faithful world realizations; it is not an additional certificate field. -/
def ConservativeTheoryTranslation.theoremSurvival
    {N : WorldRelationNetwork.{u}} {old revised : TheoryState N}
    (translation : ConservativeTheoryTranslation old revised)
    {support : N.Support} (expression : old.ExpressionAt support) :
    old.TheoremAt expression →
      revised.TheoremAt (translation.compile expression) :=
  fun proof =>
    (revised.theoremPresentation
      (translation.compile expression)).backward
        (translation.commuting expression ▸
          (old.theoremPresentation expression).forward proof)

/-- Source law for transporting one exact old theorem occurrence.  A
translation may be defined over the whole theorem vocabulary, but a public
survival receipt is generated only for the queried expression/proof pair. -/
structure TheoryTheoremSurvivalSourceAt
    {N : WorldRelationNetwork.{u}} (old revised : TheoryState N)
    (compile : {support : N.Support} →
      old.ExpressionAt support → revised.ExpressionAt support) :
    Type (u + 1) where
  OccurrenceAt : {support : N.Support} →
    (expression : old.ExpressionAt support) →
    old.TheoremAt expression → Type u
  emit : {support : N.Support} →
    (expression : old.ExpressionAt support) →
    (proof : old.TheoremAt expression) → OccurrenceAt expression proof
  event_eq_emit : {support : N.Support} →
    (expression : old.ExpressionAt support) →
    (proof : old.TheoremAt expression) →
    (occurrence : OccurrenceAt expression proof) →
      occurrence = emit expression proof
  compileSurvival : {support : N.Support} →
    (expression : old.ExpressionAt support) →
    (proof : old.TheoremAt expression) →
    OccurrenceAt expression proof → revised.TheoremAt (compile expression)

/-- Canonical generated theorem-survival receipt.  Its exact occurrence is
the source emitter image for the indexed expression/proof. -/
inductive GeneratedTheoryTheoremSurvivalAt
    {N : WorldRelationNetwork.{u}} {old revised : TheoryState N}
    {compile : {support : N.Support} →
      old.ExpressionAt support → revised.ExpressionAt support}
    (source : TheoryTheoremSurvivalSourceAt old revised compile)
    {support : N.Support} (expression : old.ExpressionAt support)
    (proof : old.TheoremAt expression) : Type u
  | canonical

namespace TheoryTheoremSurvivalSourceAt

def generated
    {N : WorldRelationNetwork.{u}} {old revised : TheoryState N}
    {compile : {support : N.Support} →
      old.ExpressionAt support → revised.ExpressionAt support}
    (source : TheoryTheoremSurvivalSourceAt old revised compile)
    {support : N.Support} (expression : old.ExpressionAt support)
    (proof : old.TheoremAt expression) :
    GeneratedTheoryTheoremSurvivalAt source expression proof :=
  .canonical

end TheoryTheoremSurvivalSourceAt

namespace GeneratedTheoryTheoremSurvivalAt

def revisedProof
    {N : WorldRelationNetwork.{u}} {old revised : TheoryState N}
    {compile : {support : N.Support} →
      old.ExpressionAt support → revised.ExpressionAt support}
    {source : TheoryTheoremSurvivalSourceAt old revised compile}
    {support : N.Support} {expression : old.ExpressionAt support}
    {proof : old.TheoremAt expression}
    (_generated : GeneratedTheoryTheoremSurvivalAt source expression proof) :
    revised.TheoremAt (compile expression) :=
  source.compileSurvival expression proof (source.emit expression proof)

/-- Every theorem-survival occurrence is the exact source-emitted image for
the indexed old theorem. -/
theorem eq_generated
    {N : WorldRelationNetwork.{u}} {old revised : TheoryState N}
    {compile : {support : N.Support} →
      old.ExpressionAt support → revised.ExpressionAt support}
    {source : TheoryTheoremSurvivalSourceAt old revised compile}
    {support : N.Support} {expression : old.ExpressionAt support}
    {proof : old.TheoremAt expression}
    (generated : GeneratedTheoryTheoremSurvivalAt source expression proof) :
    generated = source.generated expression proof := by
  cases generated
  rfl

end GeneratedTheoryTheoremSurvivalAt

def ConservativeTheoryTranslation.theoremSurvivalSource
    {N : WorldRelationNetwork.{u}} {old revised : TheoryState N}
    (translation : ConservativeTheoryTranslation old revised) :
    TheoryTheoremSurvivalSourceAt old revised translation.compile where
  OccurrenceAt := fun _ _ => ULift.{u} Unit
  emit := fun _ _ => ULift.up ()
  event_eq_emit := by intro _ _ _ occurrence; cases occurrence; rfl
  compileSurvival := fun expression proof _ =>
    translation.theoremSurvival expression proof

/-- A non-conservative revision records the semantic change in the shared
world network and still transports every old theorem through it. -/
structure TypedSemanticChangeTranslation
    {N : WorldRelationNetwork.{u}} (old revised : TheoryState N) : Type (u + 1) where
  compile : {support : N.Support} →
    old.ExpressionAt support → revised.ExpressionAt support
  semanticChange : {support : N.Support} →
    (expression : old.ExpressionAt support) →
    N.SemanticChangeAt support (old.denotes expression)
      (revised.denotes (compile expression))
  theoremSurvivalSource :
    TheoryTheoremSurvivalSourceAt old revised compile

/-- Machine-visible boundary between conservative extension and explicit
typed semantic change. -/
inductive TheorySemanticBoundary
    {N : WorldRelationNetwork.{u}} (old revised : TheoryState N)
    (compile : {support : N.Support} →
      old.ExpressionAt support → revised.ExpressionAt support) : Type (u + 1)
  | conservative
      (commuting : {support : N.Support} →
        (expression : old.ExpressionAt support) →
        revised.denotes (compile expression) = old.denotes expression)
  | typedChange
      (semanticChange : {support : N.Support} →
        (expression : old.ExpressionAt support) →
        N.SemanticChangeAt support (old.denotes expression)
          (revised.denotes (compile expression)))

/-- Faithful theory translation.  Either its realization square commutes or
it exposes a typed semantic change; every old theorem survives both cases. -/
structure TheoryTranslation
    {N : WorldRelationNetwork.{u}} (old revised : TheoryState N) : Type (u + 1) where
  compile : {support : N.Support} →
    old.ExpressionAt support → revised.ExpressionAt support
  theoremSurvivalSource :
    TheoryTheoremSurvivalSourceAt old revised compile
  semanticBoundary : TheorySemanticBoundary old revised compile

def ConservativeTheoryTranslation.toTheoryTranslation
    {N : WorldRelationNetwork.{u}} {old revised : TheoryState N}
  (translation : ConservativeTheoryTranslation old revised) :
    TheoryTranslation old revised where
  compile := translation.compile
  theoremSurvivalSource := translation.theoremSurvivalSource
  semanticBoundary := .conservative translation.commuting

def TypedSemanticChangeTranslation.toTheoryTranslation
    {N : WorldRelationNetwork.{u}} {old revised : TheoryState N}
  (translation : TypedSemanticChangeTranslation old revised) :
    TheoryTranslation old revised where
  compile := translation.compile
  theoremSurvivalSource := translation.theoremSurvivalSource
  semanticBoundary := .typedChange translation.semanticChange

def TheoryTranslation.generatedTheoremSurvival
    {N : WorldRelationNetwork.{u}} {old revised : TheoryState N}
    (translation : TheoryTranslation old revised)
    {support : N.Support} (expression : old.ExpressionAt support)
    (proof : old.TheoremAt expression) :
    GeneratedTheoryTheoremSurvivalAt translation.theoremSurvivalSource
      expression proof :=
  translation.theoremSurvivalSource.generated expression proof

/-- Pointwise comparison vocabulary between two versioned law inventories. -/
structure LawRevisionRelation
    {N : WorldRelationNetwork.{u}}
    (old revised : LawInventory N) : Type (u + 1) where
  PreservedAt : old.Law → revised.Law → Type u
  WeakenedAt : old.Law → revised.Law → Type u
  ReplacedAt : old.Law → revised.Law → Type u

/-- Every old law receives one explicit revision disposition.  A revision may
preserve, weaken, or replace a law, but it cannot silently drop it. -/
inductive LawRevisionDispositionAt
    {N : WorldRelationNetwork.{u}}
    {old revised : LawInventory N}
    (relation : LawRevisionRelation old revised)
    (oldLaw : old.Law) : Type u
  | preserved (revisedLaw : revised.Law)
      (receipt : relation.PreservedAt oldLaw revisedLaw)
  | weakened (revisedLaw : revised.Law)
      (receipt : relation.WeakenedAt oldLaw revisedLaw)
  | replaced (revisedLaw : revised.Law)
      (receipt : relation.ReplacedAt oldLaw revisedLaw)

/-- Occurrence-local source for the revision disposition of one exact old law.
The source may be defined over the complete law vocabulary, but authority is
minted only one emitted law occurrence at a time. -/
structure LawRevisionDispositionSourceAt
    {N : WorldRelationNetwork.{u}}
    {old revised : LawInventory N}
    (relation : LawRevisionRelation old revised) : Type (u + 1) where
  OccurrenceAt : old.Law → Type u
  emit : (law : old.Law) → OccurrenceAt law
  event_eq_emit : (law : old.Law) →
    (occurrence : OccurrenceAt law) → occurrence = emit law
  compileDisposition : (law : old.Law) → OccurrenceAt law →
    LawRevisionDispositionAt relation law

/-- Canonical generated disposition for one old-law occurrence.  The event is
the indexed source emitter image and is not duplicated in this token. -/
inductive GeneratedLawRevisionDispositionAt
    {N : WorldRelationNetwork.{u}}
    {old revised : LawInventory N}
    {relation : LawRevisionRelation old revised}
    (source : LawRevisionDispositionSourceAt relation)
    (law : old.Law) : Type u
  | canonical

namespace LawRevisionDispositionSourceAt

def generated
    {N : WorldRelationNetwork.{u}}
    {old revised : LawInventory N}
    {relation : LawRevisionRelation old revised}
    (source : LawRevisionDispositionSourceAt relation)
    (law : old.Law) : GeneratedLawRevisionDispositionAt source law :=
  .canonical

end LawRevisionDispositionSourceAt

namespace GeneratedLawRevisionDispositionAt

def disposition
    {N : WorldRelationNetwork.{u}}
    {old revised : LawInventory N}
    {relation : LawRevisionRelation old revised}
    {source : LawRevisionDispositionSourceAt relation}
    {law : old.Law}
    (_generated : GeneratedLawRevisionDispositionAt source law) :
    LawRevisionDispositionAt relation law :=
  source.compileDisposition law (source.emit law)

/-- Every law-revision disposition occurrence is the exact source-emitted
image for its indexed old law. -/
theorem eq_generated
    {N : WorldRelationNetwork.{u}}
    {old revised : LawInventory N}
    {relation : LawRevisionRelation old revised}
    {source : LawRevisionDispositionSourceAt relation}
    {law : old.Law}
    (generated : GeneratedLawRevisionDispositionAt source law) :
    generated = source.generated law := by
  cases generated
  rfl

end GeneratedLawRevisionDispositionAt

/-- Versioned law account carried by one revision candidate. -/
structure LawRevisionAccount
    {N : WorldRelationNetwork.{u}}
    (old revised : LawInventory N) : Type (u + 1) where
  relation : LawRevisionRelation old revised
  dispositionSource : LawRevisionDispositionSourceAt relation

def LawRevisionAccount.generatedDisposition
    {N : WorldRelationNetwork.{u}}
    {old revised : LawInventory N}
    (account : LawRevisionAccount old revised)
    (law : old.Law) :
    GeneratedLawRevisionDispositionAt account.dispositionSource law :=
  account.dispositionSource.generated law

/-- Constructive equivalence of two law inventories.  It preserves both the
simultaneous realization problem and every single-law-deletion near miss. -/
structure LawInventoryEquivalence
    {N : WorldRelationNetwork.{u}}
    (left right : LawInventory N) : Type (u + 1) where
  forwardLaw : left.Law → right.Law
  backwardLaw : right.Law → left.Law
  backward_forward : (law : left.Law) →
    backwardLaw (forwardLaw law) = law
  forward_backward : (law : right.Law) →
    forwardLaw (backwardLaw law) = law
  realizationForward : {support : N.Support} →
    (obstruction : N.ObstructionAt support) →
    left.RealizationAt obstruction → right.RealizationAt obstruction
  realizationBackward : {support : N.Support} →
    (obstruction : N.ObstructionAt support) →
    right.RealizationAt obstruction → left.RealizationAt obstruction
  deletionForward : (law : left.Law) → {support : N.Support} →
    (obstruction : N.ObstructionAt support) →
    left.RealizationWithoutAt law obstruction →
      right.RealizationWithoutAt (forwardLaw law) obstruction
  deletionBackward : (law : right.Law) → {support : N.Support} →
    (obstruction : N.ObstructionAt support) →
    right.RealizationWithoutAt law obstruction →
      left.RealizationWithoutAt (backwardLaw law) obstruction

def LawInventoryEquivalence.identity
    {N : WorldRelationNetwork.{u}} (inventory : LawInventory N) :
    LawInventoryEquivalence inventory inventory where
  forwardLaw := id
  backwardLaw := id
  backward_forward := fun _ => rfl
  forward_backward := fun _ => rfl
  realizationForward := fun _ realization => realization
  realizationBackward := fun _ realization => realization
  deletionForward := fun _ _ _ realization => realization
  deletionBackward := fun _ _ _ realization => realization

def LawInventoryEquivalence.symm
    {N : WorldRelationNetwork.{u}} {left right : LawInventory N}
    (equivalence : LawInventoryEquivalence left right) :
    LawInventoryEquivalence right left where
  forwardLaw := equivalence.backwardLaw
  backwardLaw := equivalence.forwardLaw
  backward_forward := equivalence.forward_backward
  forward_backward := equivalence.backward_forward
  realizationForward := equivalence.realizationBackward
  realizationBackward := equivalence.realizationForward
  deletionForward := equivalence.deletionBackward
  deletionBackward := equivalence.deletionForward

/-- One admissible revision candidate pays the five U8 obligations and audits
every old law.  It is not yet an actual selection from the revision family. -/
structure AdmissibleU8RevisionAt
    {N : WorldRelationNetwork.{u}} (U7 : U7ProducerCalculus N)
    (old : TheoryState N) {support : N.Support}
    (obstruction : N.ObstructionAt support)
    (failure : ActualExpressibilityFailure old obstruction) : Type (u + 1) where
  revised : TheoryState N
  translation : TheoryTranslation old revised
  lawAccount : LawRevisionAccount old.inventory revised.inventory
  closureExpression : revised.ExpressionAt support
  closure_denotes :
    revised.denotes closureExpression = N.obstructionClaim obstruction
  representationProof : revised.TheoremAt closureExpression

/-- Canonical demand readout of an admissible revision. -/
def AdmissibleU8RevisionAt.demand
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    (_revision : AdmissibleU8RevisionAt U7 old obstruction failure) :
    TheoryRevisionDemandAt U7 failure :=
  theoryRevisionDemandOfFailure U7 failure

theorem AdmissibleU8RevisionAt.old_notExpressible
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    (_revision : AdmissibleU8RevisionAt U7 old obstruction failure) :
    old.ExpressesAt support (N.obstructionClaim obstruction) → False :=
  fun oldExpression => failure.notExpressible.false oldExpression

/-- The revised theory has an actual expression for the old obstruction. -/
def AdmissibleU8RevisionAt.revisedExpression
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    (revision : AdmissibleU8RevisionAt U7 old obstruction failure) :
    revision.revised.ExpressesAt support (N.obstructionClaim obstruction) :=
  ⟨revision.closureExpression, revision.closure_denotes⟩

/-- One admissible revision closes the exact expression failure that generated
it.  The revised language already contains the obstruction expression, so the
same support, claim, and theory epoch cannot emit a second expressibility
failure.  A later U8 step therefore requires a new actual obstruction or an
explicitly revised semantic index; it cannot replay this trigger. -/
theorem AdmissibleU8RevisionAt.no_repeatedExpressibilityFailure
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    (revision : AdmissibleU8RevisionAt U7 old obstruction failure) :
    IsEmpty (ActualExpressibilityFailure revision.revised obstruction) :=
  ⟨fun repeated =>
    repeated.notExpressible.false revision.revisedExpression⟩

/-- Presentation/gauge equivalence of two admissible revisions.  Both the law
inventory and the revised expression language commute bidirectionally. -/
structure FaithfulRevisionEquivalenceAt
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    (left right : AdmissibleU8RevisionAt U7 old obstruction failure) :
    Type (u + 1) where
  inventory :
    LawInventoryEquivalence left.revised.inventory right.revised.inventory
  forward : ConservativeTheoryTranslation left.revised right.revised
  backward : ConservativeTheoryTranslation right.revised left.revised
  backward_forward : {sharedSupport : N.Support} →
    (expression : left.revised.ExpressionAt sharedSupport) →
    backward.compile (forward.compile expression) = expression
  forward_backward : {sharedSupport : N.Support} →
    (expression : right.revised.ExpressionAt sharedSupport) →
    forward.compile (backward.compile expression) = expression
  closure_forward :
    forward.compile left.closureExpression = right.closureExpression
  closure_backward :
    backward.compile right.closureExpression = left.closureExpression

def FaithfulRevisionEquivalenceAt.identity
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    (revision : AdmissibleU8RevisionAt U7 old obstruction failure) :
    FaithfulRevisionEquivalenceAt revision revision where
  inventory := LawInventoryEquivalence.identity revision.revised.inventory
  forward :=
    { compile := id
      commuting := fun _ => rfl }
  backward :=
    { compile := id
      commuting := fun _ => rfl }
  backward_forward := fun _ => rfl
  forward_backward := fun _ => rfl
  closure_forward := rfl
  closure_backward := rfl

def FaithfulRevisionEquivalenceAt.symm
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    {left right : AdmissibleU8RevisionAt U7 old obstruction failure}
    (equivalence : FaithfulRevisionEquivalenceAt left right) :
    FaithfulRevisionEquivalenceAt right left where
  inventory := equivalence.inventory.symm
  forward := equivalence.backward
  backward := equivalence.forward
  backward_forward := equivalence.forward_backward
  forward_backward := equivalence.backward_forward
  closure_forward := equivalence.closure_backward
  closure_backward := equivalence.closure_forward

/-- Structural content of a substantive revision fork.  This value has no
independent authority: it becomes source-backed only as the compiled outcome
of an exact `ActualPairQueryProcess` occurrence installed in a selection
source.  Keeping a second difference-event source inside that outcome would
duplicate the pair court's already fixed occurrence. -/
structure RevisionDifferenceAt
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    (left right : AdmissibleU8RevisionAt U7 old obstruction failure) :
    Type (u + 1) where
  no_equivalence : FaithfulRevisionEquivalenceAt left right → False

/-- A substantive difference occurrence can never distinguish one revision
from itself.  Record inequality is derived from the semantic boundary, not
used as its definition. -/
theorem RevisionDifferenceAt.revisions_ne_of_receipt
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    {left right : AdmissibleU8RevisionAt U7 old obstruction failure}
    (difference : RevisionDifferenceAt left right) :
    left ≠ right := by
  intro revisions_eq
  subst right
  exact difference.no_equivalence
    (FaithfulRevisionEquivalenceAt.identity left)

/-- A paid substantive fork excludes faithful presentation/gauge
equivalence.  Record inequality is only a corollary of this semantic boundary,
not the definition of a real revision difference. -/
theorem RevisionDifferenceAt.no_faithful_equivalence
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    {left right : AdmissibleU8RevisionAt U7 old obstruction failure}
    (difference : RevisionDifferenceAt left right) :
    FaithfulRevisionEquivalenceAt left right → False :=
  difference.no_equivalence

theorem no_self_revision_difference
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    (revision : AdmissibleU8RevisionAt U7 old obstruction failure) :
    RevisionDifferenceAt revision revision → False := by
  intro difference
  exact difference.no_equivalence
    (FaithfulRevisionEquivalenceAt.identity revision)

/-- No-Free Multiplicity trichotomy emitted by one exact pair process step.
A pair is the same revision up to a faithful chart, is structurally
distinguished by that occurrence, or the occurrence emits the next unresolved
meta-residual.  None of the three branches owns a second event source. -/
inductive RevisionComparisonAt
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    (left right : AdmissibleU8RevisionAt U7 old obstruction failure) :
    Type (u + 1)
  | equivalent (receipt : FaithfulRevisionEquivalenceAt left right)
  | distinguished (receipt : RevisionDifferenceAt left right)
  | unresolved

/-- Zero-information witness that one exact generated comparison outcome is
resolved.  The receipt remains inside the source-generated outcome; this token
only excludes the unresolved branch. -/
def RevisionComparisonResolvedBranchAt
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    {left right : AdmissibleU8RevisionAt U7 old obstruction failure} :
    RevisionComparisonAt left right → Type u
  | .equivalent _ => PUnit
  | .distinguished _ => PUnit
  | .unresolved => PEmpty

/-- Candidate-generation source emitted by one meta-event.  A candidate key is
not itself a generated revision: the revision is produced only from an exact
candidate occurrence through `compileCandidate`.  The family contains no
completed candidate table and no completed pairwise comparison table. -/
structure GeneratedRevisionFamilyAt
    {N : WorldRelationNetwork.{u}} (U7 : U7ProducerCalculus N)
    (old : TheoryState N) {support : N.Support}
    (obstruction : N.ObstructionAt support)
    (failure : ActualExpressibilityFailure old obstruction) : Type (u + 1) where
  Candidate : Type u
  CandidateOccurrenceAt : Candidate → Type u
  emitCandidate : (candidate : Candidate) → CandidateOccurrenceAt candidate
  event_eq_emit : (candidate : Candidate) →
    (event : CandidateOccurrenceAt candidate) → event = emitCandidate candidate
  compileCandidate : (candidate : Candidate) →
    CandidateOccurrenceAt candidate →
      AdmissibleU8RevisionAt U7 old obstruction failure

/-- Static candidate key inside one generated revision family.

The exact occurrence is definitionally `family.emitCandidate key`; storing it
again in a private wrapper adds no provenance.  A key remains a static readout,
not world authority.  Actual selection data must pass through a source-owned
finite schedule; world effects additionally require the rooted U8 seam. -/
abbrev GeneratedRevisionCandidateAt
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    (family : GeneratedRevisionFamilyAt U7 old obstruction failure) :=
  family.Candidate

namespace GeneratedRevisionCandidateAt

/-- Source-generated static revision readout of the exact candidate occurrence.
It acquires world authority only after the rooted U8 seam consumes the same
failure, selection occurrence, law ledger, and old root visit. -/
def revision
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    {family : GeneratedRevisionFamilyAt U7 old obstruction failure}
    (candidate : GeneratedRevisionCandidateAt family) :
    AdmissibleU8RevisionAt U7 old obstruction failure :=
  family.compileCandidate candidate (family.emitCandidate candidate)

/-- Static computation rule for the candidate readout. -/
theorem revision_eq_compileCandidate
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    {family : GeneratedRevisionFamilyAt U7 old obstruction failure}
    (candidate : GeneratedRevisionCandidateAt family) :
    candidate.revision =
      family.compileCandidate candidate (family.emitCandidate candidate) :=
  rfl

end GeneratedRevisionCandidateAt

/-! ### Source-native exact pair comparison -/

structure ExactPairQuery (Candidate : Type u) : Type u where
  left : Candidate
  right : Candidate

/-- Search state is an actual finite debit, not an arbitrary continuation
receipt. -/
structure PairSearchCurrentAt
    {Candidate : Type u} (_query : ExactPairQuery Candidate) : Type where
  budget : Nat

/-- A nonterminal comparison step must consume a strict debit. -/
structure PaidPairSearchContinuationAt
    {Candidate : Type u} {query : ExactPairQuery Candidate}
    (current : PairSearchCurrentAt query) : Type where
  next : PairSearchCurrentAt query
  strictDebit : next.budget < current.budget

abbrev PairSearchEvolutionAt
    {Candidate : Type u} (OutcomeAt : ExactPairQuery Candidate → Type (u + 1))
    (query : ExactPairQuery Candidate) (current : PairSearchCurrentAt query) :
    Type (u + 1) :=
  OutcomeAt query ⊕ PaidPairSearchContinuationAt current

/-- Compatibility presentation of a pair-comparison rule.

This global function family has no public canonical-receipt authority.  It is
retained for existing finite-selection presentations; source-generated
comparison data uses an event-first finite schedule whose emitted event fixes
every pair and initial debit before any comparison step is generated. -/
structure ActualPairQueryProcess
    (Candidate : Type u) (OutcomeAt : ExactPairQuery Candidate → Type (u + 1)) :
    Type (u + 1) where
  StepOccurrenceAt :
    (query : ExactPairQuery Candidate) → PairSearchCurrentAt query → Type u
  emit : (query : ExactPairQuery Candidate) →
    (current : PairSearchCurrentAt query) → StepOccurrenceAt query current
  event_eq_emit : (query : ExactPairQuery Candidate) →
    (current : PairSearchCurrentAt query) →
    (event : StepOccurrenceAt query current) → event = emit query current
  compileStep : (query : ExactPairQuery Candidate) →
    (current : PairSearchCurrentAt query) →
    StepOccurrenceAt query current → PairSearchEvolutionAt OutcomeAt query current

/-- Canonical comparison evolution at one exact emitted process occurrence. -/
def ActualPairQueryProcess.evolutionAt
    {Candidate : Type u} {OutcomeAt : ExactPairQuery Candidate → Type (u + 1)}
    (process : ActualPairQueryProcess Candidate OutcomeAt)
    (query : ExactPairQuery Candidate) (current : PairSearchCurrentAt query) :
    PairSearchEvolutionAt OutcomeAt query current :=
  process.compileStep query current (process.emit query current)

/-- A comparison history is finite by construction.  It terminates in a
typed outcome or recursively consumes a strict debit and emits the next exact
occurrence. -/
inductive GeneratedPairQueryHistoryAt
    {Candidate : Type u} {OutcomeAt : ExactPairQuery Candidate → Type (u + 1)}
    (process : ActualPairQueryProcess Candidate OutcomeAt)
    (query : ExactPairQuery Candidate) :
    PairSearchCurrentAt query → Type (u + 1)
  | terminal {current : PairSearchCurrentAt query}
      (outcome : OutcomeAt query)
      (evolution_eq : process.evolutionAt query current = .inl outcome) :
      GeneratedPairQueryHistoryAt process query current
  | continued {current : PairSearchCurrentAt query}
      (continuation : PaidPairSearchContinuationAt current)
      (evolution_eq : process.evolutionAt query current = .inr continuation)
      (tail : GeneratedPairQueryHistoryAt process query continuation.next) :
      GeneratedPairQueryHistoryAt process query current

def ActualPairQueryProcess.generatedHistory
    {Candidate : Type u} {OutcomeAt : ExactPairQuery Candidate → Type (u + 1)}
    (process : ActualPairQueryProcess Candidate OutcomeAt)
    (query : ExactPairQuery Candidate) (current : PairSearchCurrentAt query) :
    GeneratedPairQueryHistoryAt process query current := by
  match h : process.evolutionAt query current with
  | .inl outcome => exact .terminal outcome h
  | .inr continuation =>
      exact .continued continuation h
        (process.generatedHistory query continuation.next)
termination_by current.budget
decreasing_by exact continuation.strictDebit

def GeneratedPairQueryHistoryAt.terminalOutcome
    {Candidate : Type u} {OutcomeAt : ExactPairQuery Candidate → Type (u + 1)}
    {process : ActualPairQueryProcess Candidate OutcomeAt}
    {query : ExactPairQuery Candidate} {current : PairSearchCurrentAt query} :
    GeneratedPairQueryHistoryAt process query current → OutcomeAt query
  | .terminal outcome _ => outcome
  | .continued _ _ tail => tail.terminalOutcome

def GeneratedRevisionFamilyAt.PairOutcomeAt
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    (family : GeneratedRevisionFamilyAt U7 old obstruction failure)
    (query : ExactPairQuery (GeneratedRevisionCandidateAt family)) : Type (u + 1) :=
  RevisionComparisonAt query.left.revision query.right.revision

/-- One required comparison carries the finite generated search history and
proof that its terminal result is resolved.  An unresolved multiplicity
obstruction therefore cannot be smuggled into selection. -/
structure GeneratedRequiredRevisionComparisonAt
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    {family : GeneratedRevisionFamilyAt U7 old obstruction failure}
    (process : ActualPairQueryProcess
      (GeneratedRevisionCandidateAt family) family.PairOutcomeAt)
    (selected : GeneratedRevisionCandidateAt family)
    (requirement : GeneratedRevisionCandidateAt family × Nat) :
    Type (u + 1) where
  private mk ::
  history : GeneratedPairQueryHistoryAt process
    ⟨selected, requirement.1⟩ ⟨requirement.2⟩
  resolvedBranch :
    RevisionComparisonResolvedBranchAt history.terminalOutcome

namespace GeneratedRequiredRevisionComparisonAt

/-- Admit a required comparison only by exhibiting that its exact generated
terminal outcome is in a resolved branch.  No duplicate receipt enters this
constructor. -/
def ofHistory
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    {family : GeneratedRevisionFamilyAt U7 old obstruction failure}
    {process : ActualPairQueryProcess
      (GeneratedRevisionCandidateAt family) family.PairOutcomeAt}
    {selected : GeneratedRevisionCandidateAt family}
    {requirement : GeneratedRevisionCandidateAt family × Nat}
    (history : GeneratedPairQueryHistoryAt process
      ⟨selected, requirement.1⟩ ⟨requirement.2⟩)
    (resolvedBranch :
      RevisionComparisonResolvedBranchAt history.terminalOutcome) :
    GeneratedRequiredRevisionComparisonAt process selected requirement :=
  ⟨history, resolvedBranch⟩

end GeneratedRequiredRevisionComparisonAt

inductive GeneratedFiniteRevisionComparisonHistoryAt
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    {family : GeneratedRevisionFamilyAt U7 old obstruction failure}
    (process : ActualPairQueryProcess
      (GeneratedRevisionCandidateAt family) family.PairOutcomeAt)
    (selected : GeneratedRevisionCandidateAt family) :
    List (GeneratedRevisionCandidateAt family × Nat) → Type (u + 1)
  | nil : GeneratedFiniteRevisionComparisonHistoryAt process selected []
  | cons {requirement rest}
      (head : GeneratedRequiredRevisionComparisonAt
        process selected requirement)
      (tail : GeneratedFiniteRevisionComparisonHistoryAt
        process selected rest) :
      GeneratedFiniteRevisionComparisonHistoryAt
        process selected (requirement :: rest)

/-- Source-owned meta producer.  Its compiler emits the whole revision family;
it does not silently choose one admissible successor. -/
structure U8RevisionCalculus
    {N : WorldRelationNetwork.{u}} (U7 : U7ProducerCalculus N)
    (old : TheoryState N) : Type (u + 1) where
  RevisionEventAt : {support : N.Support} →
    {obstruction : N.ObstructionAt support} →
    ActualExpressibilityFailure old obstruction → Type u
  emit : {support : N.Support} →
    {obstruction : N.ObstructionAt support} →
    (failure : ActualExpressibilityFailure old obstruction) →
    RevisionEventAt failure
  compile : {support : N.Support} →
    {obstruction : N.ObstructionAt support} →
    {failure : ActualExpressibilityFailure old obstruction} →
    RevisionEventAt failure →
      GeneratedRevisionFamilyAt U7 old obstruction failure

def U8RevisionCalculus.generated
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} (calculus : U8RevisionCalculus U7 old)
    {support : N.Support} {obstruction : N.ObstructionAt support}
    (failure : ActualExpressibilityFailure old obstruction) :
    GeneratedRevisionFamilyAt U7 old obstruction failure :=
  calculus.compile (calculus.emit failure)

/-- Actual context which may resolve a revision family.  The emitted event,
source coordinates, generated pair process, and finite requirement schedule
are the complete selection account.  Domain-specific consumer demand, law
profile, or semantic cost may be faces of that event, but arbitrary inhabited
receipt families do not acquire generic selection authority here. -/
structure RevisionSelectionSourceAt
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    (family : GeneratedRevisionFamilyAt U7 old obstruction failure) :
    Type (u + 1) where
  SelectionEvent : Type u
  anchorAt : SelectionEvent → N.Anchor
  incidenceAt : SelectionEvent → N.Incidence
  lineageAt : SelectionEvent → N.Lineage
  comparisonProcess :
    ActualPairQueryProcess
      (GeneratedRevisionCandidateAt family) family.PairOutcomeAt
  requiredCandidatesAt :
    SelectionEvent → GeneratedRevisionCandidateAt family →
      List (GeneratedRevisionCandidateAt family × Nat)

/-- Compiler output of an actual selection event.  The event compiler chooses
the candidate and the source-fixed finite comparison demand.  Every required
comparison is an exact generated pair-query history whose terminal outcome is
resolved; an unresolved multiplicity obstruction cannot be skipped. -/
structure GeneratedRevisionSelectionAt
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    {family : GeneratedRevisionFamilyAt U7 old obstruction failure}
    (source : RevisionSelectionSourceAt family)
    (event : source.SelectionEvent) : Type (u + 1) where
  anchor_eq : source.anchorAt event = N.anchorAt support
  incidence_eq : source.incidenceAt event = N.incidenceAt support
  lineage_eq : source.lineageAt event = N.lineageAt support
  selected : GeneratedRevisionCandidateAt family
  comparisons : GeneratedFiniteRevisionComparisonHistoryAt
    source.comparisonProcess selected
    (source.requiredCandidatesAt event selected)

/-- Actual selection compiler.  The chosen candidate is output of the event
compiler, not an argument to `generated`. -/
structure RevisionSelectionCalculus
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    (family : GeneratedRevisionFamilyAt U7 old obstruction failure) :
    Type (u + 1) where
  source : RevisionSelectionSourceAt family
  emit : source.SelectionEvent
  compile : (event : source.SelectionEvent) →
    GeneratedRevisionSelectionAt source event

def RevisionSelectionCalculus.generated
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    {family : GeneratedRevisionFamilyAt U7 old obstruction failure}
    (calculus : RevisionSelectionCalculus family) :
    GeneratedRevisionSelectionAt calculus.source calculus.emit :=
  calculus.compile calculus.emit

/-- One failure-indexed revision family together with its actual selection
compiler.  This is theory-presentation data, not typed-world authority: the
selected candidate may supply inherited syntax to a root-installed equation
backend, but cannot index or relabel a downstream world transition. -/
structure SourceSelectedU8RevisionAt
    {N : WorldRelationNetwork.{u}} (U7 : U7ProducerCalculus N)
    (old : TheoryState N) {support : N.Support}
    (obstruction : N.ObstructionAt support)
    (failure : ActualExpressibilityFailure old obstruction) : Type (u + 1) where
  revisionCalculus : U8RevisionCalculus U7 old
  selectionCalculus :
    RevisionSelectionCalculus (revisionCalculus.generated failure)

/-- Exact admissible theory presentation generated by the selection event. -/
def SourceSelectedU8RevisionAt.selectedRevision
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    {failure : ActualExpressibilityFailure old obstruction}
    (selected : SourceSelectedU8RevisionAt U7 old obstruction failure) :
    AdmissibleU8RevisionAt U7 old obstruction failure :=
  selected.selectionCalculus.generated.selected.revision

end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
