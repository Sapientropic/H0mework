import H0mework.Foundation.Source.RelationNetwork
import Mathlib.Logic.IsEmpty.Defs

/-!
# Minimal living-law theory state

This kernel contains the theory-epoch data required by root authority and the
exact U7-to-U8 trigger.  Revision families, comparison histories and selection
remain in `LivingLawTheoryEvolutionKernel`; they are not dependencies of the
root compiler.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution

universe u

/-- Versioned laws whose simultaneous realization defines one theory epoch. -/
structure LawInventory (N : WorldRelationNetwork.{u}) : Type (u + 1) where
  Version : Type u
  version : Version
  Law : Type u
  RealizationAt : {support : N.Support} →
    N.ObstructionAt support → Type u
  /-- Realizations remaining after deleting one law.  This is static inventory
  semantics, not a completed audit table and not part of the U8 trigger. -/
  RealizationWithoutAt : (law : Law) → {support : N.Support} →
    N.ObstructionAt support → Type u

/-- Faithful local language for claims in one shared world network. -/
structure TheoryState (N : WorldRelationNetwork.{u}) : Type (u + 1) where
  inventory : LawInventory N
  ExpressionAt : N.Support → Type u
  denotes : {support : N.Support} → ExpressionAt support → N.Claim
  TheoremAt : {support : N.Support} →
    (expression : ExpressionAt support) → Type u
  theoremPresentation : {support : N.Support} →
    (expression : ExpressionAt support) →
    ConstructivePresentation (TheoremAt expression)
      (N.HoldsAt support (denotes expression))

/-- Root-semantic law surface: actual claims are directly addressable. -/
def TheoryState.rootSemantic (N : WorldRelationNetwork.{u}) : TheoryState N where
  inventory :=
    { Version := PUnit
      version := PUnit.unit
      Law := PEmpty
      RealizationAt := fun {support} obstruction =>
        N.HoldsAt support (N.obstructionClaim obstruction)
      RealizationWithoutAt := fun law => nomatch law }
  ExpressionAt := fun _ => N.Claim
  denotes := id
  TheoremAt := fun {support} expression => N.HoldsAt support expression
  theoremPresentation := fun _ => ConstructivePresentation.refl _

def TheoryState.ExpressesAt
    {N : WorldRelationNetwork.{u}} (theory : TheoryState N)
    (support : N.Support) (claim : N.Claim) : Type u :=
  { expression : theory.ExpressionAt support //
    theory.denotes expression = claim }

/-- Exact U8 trigger: the old language and its complete law inventory cannot
realize the rooted obstruction.  It stores only those two empty fibres.  A
law-deletion audit is a later, occurrence-indexed diagnostic process; carrying
one here would let an otherwise exact failure preinstall an unrelated total
answer table. -/
structure ActualExpressibilityFailure
    {N : WorldRelationNetwork.{u}} (old : TheoryState N)
    {support : N.Support} (obstruction : N.ObstructionAt support) :
    Type (u + 1) where
  notExpressible :
    IsEmpty (old.ExpressesAt support (N.obstructionClaim obstruction))
  noLawfulRealization :
    IsEmpty (old.inventory.RealizationAt obstruction)

/-- The maximally addressable root-semantic theory cannot itself generate an
expressibility failure.  Every obstruction claim is already an expression,
independently of whether its law inventory realizes that claim.

Consequently a later overflow U8 cannot be attached directly to a
`rootSemantic` epoch.  An actual source event must first generate a narrower
operational theory epoch; the failure and U8 remain downstream products of
that epoch rather than caller-supplied premises. -/
theorem TheoryState.rootSemantic_actualExpressibilityFailure_isEmpty
    (N : WorldRelationNetwork.{u})
    {support : N.Support}
    (obstruction : N.ObstructionAt support) :
    IsEmpty (ActualExpressibilityFailure (TheoryState.rootSemantic N)
      obstruction) := by
  refine ⟨fun failure => ?_⟩
  exact failure.notExpressible.false
    ⟨N.obstructionClaim obstruction, rfl⟩

/-- Meta-residual generated by one exact expressibility failure. -/
structure MetaResidualAt
    {N : WorldRelationNetwork.{u}} (old : TheoryState N)
    {support : N.Support} (obstruction : N.ObstructionAt support) :
    Type (u + 1) where
  failure : ActualExpressibilityFailure old obstruction

def metaResidualOfFailure
    {N : WorldRelationNetwork.{u}} {old : TheoryState N}
    {support : N.Support} {obstruction : N.ObstructionAt support}
    (failure : ActualExpressibilityFailure old obstruction) :
    MetaResidualAt old obstruction :=
  ⟨failure⟩

/-- U8 demand generated from the same failure and the same U7 obstruction. -/
structure TheoryRevisionDemandAt
    {N : WorldRelationNetwork.{u}} (U7 : U7ProducerCalculus N)
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    (failure : ActualExpressibilityFailure old obstruction) : Type (u + 1) where
  metaResidual : MetaResidualAt old obstruction
  metaResidual_eq : metaResidual = metaResidualOfFailure failure
  networkDemand : U7.DemandAt obstruction
  networkDemand_eq : networkDemand = U7.generateDemand obstruction

def theoryRevisionDemandOfFailure
    {N : WorldRelationNetwork.{u}} (U7 : U7ProducerCalculus N)
    {old : TheoryState N} {support : N.Support}
    {obstruction : N.ObstructionAt support}
    (failure : ActualExpressibilityFailure old obstruction) :
    TheoryRevisionDemandAt U7 failure where
  metaResidual := metaResidualOfFailure failure
  metaResidual_eq := rfl
  networkDemand := U7.generateDemand obstruction
  networkDemand_eq := rfl

end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid

#print axioms SaturationMonoid.ResponsibilityLifecycle.LivingLawEvolution.TheoryState.rootSemantic_actualExpressibilityFailure_isEmpty
