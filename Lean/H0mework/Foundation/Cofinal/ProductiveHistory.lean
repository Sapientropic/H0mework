import H0mework.Foundation.Authority.CausalVisit

/-!
# Productive finite history of one source-native root

One fixed root compiler generates every finite visit.  A pointwise productive
law supplies the unique next current already exposed by that compiler, so the
finite history is obtained by recursion from the root's initial visit.  A
cofinal visit is likewise admitted only when the source-owned cofinal compiler
emits its exact event; inhabiting the ambient event family is not authority.

The same construction proves a sharp boundary fact: no finite `RootVisit` can
be strictly later than every generated finite prefix.  This is a negative
readout about the old carrier, not authority to mint a sibling boundary event,
endpoint, obstruction, court, or successor.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot

universe u

/-- A source-owned productive finite path inside one fixed root.

Only currents on this generated path must continue.  This is weaker than a
total successor on every root current, which would incorrectly exclude
source-owned terminal or cofinal currents.  Every path edge remains fixed by
the root compiler. -/
structure ProductiveFiniteRootHistoryAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLedgerRootClosure N V) : Type (u + 1) where
  currentAt : Nat → V.Current
  initial_eq : currentAt 0 = root.toRoot.source.initial
  next_eq : (index : Nat) →
    (root.toRoot.evolutionAt (currentAt index)).nextCurrent? =
      some (currentAt (index + 1))

namespace ProductiveFiniteRootHistoryAt

variable
  {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
  {root : SourceNativeLedgerRootClosure N V}

/-- Exact causal visit together with its generated path current. -/
private def generatedVisitAt
    (history : ProductiveFiniteRootHistoryAt root) :
    (index : Nat) →
      { visit : RootVisit root.toRoot // visit.current = history.currentAt index }
  | 0 => ⟨root.toRoot.initialVisit, history.initial_eq.symm⟩
  | index + 1 =>
      let prior := history.generatedVisitAt index
      let nextEq :
          (root.toRoot.evolutionAt prior.1.current).nextCurrent? =
            some (history.currentAt (index + 1)) := by
        rw [prior.2]
        exact history.next_eq index
      ⟨prior.1.next nextEq, rfl⟩

/-- Exact causal visit after `index` writes of the fixed root path. -/
def visitAt
    (history : ProductiveFiniteRootHistoryAt root)
    (index : Nat) : RootVisit root.toRoot :=
  (history.generatedVisitAt index).1

@[simp] theorem visitAt_current
    (history : ProductiveFiniteRootHistoryAt root)
    (index : Nat) :
    (history.visitAt index).current = history.currentAt index :=
  (history.generatedVisitAt index).2

/-- The next edge at a generated visit is the literal source successor. -/
theorem next_eq_at_visit
    (history : ProductiveFiniteRootHistoryAt root)
    (index : Nat) :
    (root.toRoot.evolutionAt (history.visitAt index).current).nextCurrent? =
      some (history.currentAt (index + 1)) := by
  rw [history.visitAt_current]
  exact history.next_eq index

@[simp] theorem visitAt_succ
    (history : ProductiveFiniteRootHistoryAt root)
    (index : Nat) :
    history.visitAt (index + 1) =
      (history.visitAt index).next (history.next_eq_at_visit index) := by
  rfl

/-- Constructive length of one finite root reachability proof. -/
def causalDepth
    {current : V.Current} : root.toRoot.ReachableAt current -> Nat
  | .initial => 0
  | .step prior _ => causalDepth prior + 1

theorem visitAt_depth
    (history : ProductiveFiniteRootHistoryAt root)
    (n : Nat) :
    causalDepth (history.visitAt n).history = n := by
  induction n with
  | zero => rfl
  | succ n inductionHypothesis =>
      change
        causalDepth (history.generatedVisitAt n).1.history + 1 = n + 1
      have priorDepth :
          causalDepth (history.generatedVisitAt n).1.history = n := by
        simpa only [visitAt] using inductionHypothesis
      rw [priorDepth]

/-- The deterministic root compiler fixes every finite current pointwise.
Two productive-history records cannot introduce a new path bit through their
function presentation or proof fields. -/
theorem currentAt_eq
    (left right : ProductiveFiniteRootHistoryAt root) :
    (index : Nat) -> left.currentAt index = right.currentAt index
  | 0 => left.initial_eq.trans right.initial_eq.symm
  | index + 1 => by
      have prior := currentAt_eq left right index
      have leftNext := left.next_eq index
      have rightNext := right.next_eq index
      rw [prior] at leftNext
      exact Option.some.inj (leftNext.symm.trans rightNext)

end ProductiveFiniteRootHistoryAt

/-- A finite root visit cannot be strictly later than every finite prefix
generated by the same productive root history. -/
structure StrictCofinalRootVisitAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    (history : ProductiveFiniteRootHistoryAt root) : Type u where
  visit : RootVisit root.toRoot
  after_every_finite_prefix : (n : Nat) ->
    ProductiveFiniteRootHistoryAt.causalDepth (history.visitAt n).history <
      ProductiveFiniteRootHistoryAt.causalDepth visit.history

theorem strictCofinalRootVisitAt_isEmpty
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    (history : ProductiveFiniteRootHistoryAt root) :
    IsEmpty (StrictCofinalRootVisitAt history) :=
  ⟨by
    rintro ⟨visit, afterEveryFinitePrefix⟩
    let depth := ProductiveFiniteRootHistoryAt.causalDepth visit.history
    have impossible := afterEveryFinitePrefix depth
    rw [history.visitAt_depth depth] at impossible
    have visitDepthEq :
        ProductiveFiniteRootHistoryAt.causalDepth visit.history = depth := rfl
    rw [visitDepthEq] at impossible
    exact (Nat.lt_irrefl depth) impossible⟩

/-! ## Source-owned cofinal visits of the same root -/

/-- A genuine cofinal visit is generated by one source-owned limit event.

The event fixes its canonical path before authority is created.  Productivity
is proof data derived from that path, not a caller-selected history index.
Consequently a second function presentation of the same finite evolution
cannot mint a sibling cofinal occurrence. -/
structure SourceNativeCofinalVisitAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLedgerRootClosure N V) : Type u where
  private mk ::
  event : V.cofinal.Event
  private emitted_eq : V.cofinal.emit? = some event
  private initial_eq :
    V.cofinal.pathAt event 0 = root.toRoot.source.initial
  private next_eq : (index : Nat) →
    (root.toRoot.evolutionAt (V.cofinal.pathAt event index)).nextCurrent? =
      some (V.cofinal.pathAt event (index + 1))

namespace SourceNativeCofinalVisitAt

/-- The cofinal event is the one emitted by the fixed source law.  This
readout lets later temporal consumers retain the boundary occurrence without
reopening the private constructor. -/
theorem emitted_eq_event
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    (visit : SourceNativeCofinalVisitAt root) :
    V.cofinal.emit? = some visit.event :=
  visit.emitted_eq

/-- Canonical productive history read from the source event.  This is a
readout of the visit, never an authority parameter. -/
def history
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    (visit : SourceNativeCofinalVisitAt root) :
    ProductiveFiniteRootHistoryAt root where
  currentAt := V.cofinal.pathAt visit.event
  initial_eq := visit.initial_eq
  next_eq := visit.next_eq

end SourceNativeCofinalVisitAt

namespace ProductiveFiniteRootHistoryAt

/-- Query the fixed cofinal compiler and recognize its canonical path as this
exact generated finite history.  `path_eq` carries no event or target choice:
the source has already selected both through `emit?`. -/
def generatedCofinalVisit?
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    (history : ProductiveFiniteRootHistoryAt root)
    (path_eq : {event : V.cofinal.Event} → V.cofinal.emit? = some event →
      (index : Nat) → V.cofinal.pathAt event index = history.currentAt index) :
    Option (SourceNativeCofinalVisitAt root) :=
  match emitted_eq : V.cofinal.emit? with
  | none => none
  | some event => by
      have canonical_path_eq := path_eq emitted_eq
      have initial_eq :
          V.cofinal.pathAt event 0 = root.toRoot.source.initial :=
        (canonical_path_eq 0).trans history.initial_eq
      have next_eq : (index : Nat) →
          (root.toRoot.evolutionAt (V.cofinal.pathAt event index)).nextCurrent? =
            some (V.cofinal.pathAt event (index + 1)) := by
        intro index
        rw [canonical_path_eq index, canonical_path_eq (index + 1)]
        exact history.next_eq index
      exact some ⟨event, emitted_eq, initial_eq, next_eq⟩

end ProductiveFiniteRootHistoryAt

/-- The cofinal current is generated by the source-owned limit event. -/
def SourceNativeCofinalVisitAt.current
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    (visit : SourceNativeCofinalVisitAt root) : V.Current :=
  V.cofinal.target visit.event

/-- No presentation may retarget a fixed cofinal event. -/
@[simp] theorem SourceNativeCofinalVisitAt.current_eq_eventTarget
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    (visit : SourceNativeCofinalVisitAt root) :
    visit.current = V.cofinal.target visit.event :=
  rfl

/-- A fixed root has at most one generated cofinal visit.  The source compiler
selects the event, its canonical path is productive, and all remaining fields
are proofs; no external history presentation survives in the identity. -/
theorem SourceNativeCofinalVisitAt.eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLedgerRootClosure N V}
    (left right : SourceNativeCofinalVisitAt root) :
    left = right := by
  have event_eq : left.event = right.event :=
    Option.some.inj (left.emitted_eq.symm.trans right.emitted_eq)
  cases left
  cases right
  cases event_eq
  rfl

/-- Stream of exact finite source patches preceding the cofinal visit. -/
def SourceNativeLedgerRootClosure.generatedCofinalPriorPatchesAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLedgerRootClosure N V)
    (visit : SourceNativeCofinalVisitAt root) :
    Nat → SourceNativeCausalLedgerPatch root :=
  fun index => visit.history.visitAt index

end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
