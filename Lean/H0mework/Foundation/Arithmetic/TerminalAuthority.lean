import H0mework.Foundation.Arithmetic.Generation
import H0mework.Foundation.Cofinal.TemporalAnswer

/-!
# Source-native arithmetic terminal authority

An arithmetic index is the finite depth of one exact root visit.  Terminal
authority is generated by the literal `.faithfulTerminal` branch of an admitted
authority source and carries exhaustion of its complete concrete actual-event
inventory.  A raw ledger-root branch remains a compiler readout; it cannot by
itself assert that omitted sibling continuations do not exist.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace RootArithmeticTerminalAuthority

universe u

open ArithmeticGeneration

/-- Exact unit-occurrence history generated by one root reachability proof.
No numeric depth occurs in the source carrier. -/
def reachabilityArithmeticHistory
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : RootClosure N V} {current : V.Current} :
    root.ReachableAt current → UnitHistory
  | .initial => .empty
  | .step prior _ => .next (reachabilityArithmeticHistory prior)

/-- Arithmetic material history of one exact root visit. -/
def rootVisitArithmeticHistory
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : RootClosure N V} (visit : RootVisit root) : UnitHistory :=
  reachabilityArithmeticHistory visit.history

/-- The finite arithmetic index is only the cardinal shadow of the actual
reachability history. -/
def reachabilityArithmeticIndex
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : RootClosure N V} {current : V.Current} :
    root.ReachableAt current → Nat :=
  fun history => (reachabilityArithmeticHistory history).cardinalShadow

/-- The arithmetic index of an exact root visit. -/
def rootVisitArithmeticIndex
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : RootClosure N V} (visit : RootVisit root) : Nat :=
  (rootVisitArithmeticHistory visit).cardinalShadow

@[simp] theorem rootVisitArithmeticHistory_shadow
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : RootClosure N V} (visit : RootVisit root) :
    (rootVisitArithmeticHistory visit).cardinalShadow =
      rootVisitArithmeticIndex visit :=
  rfl

@[simp] theorem RootClosure.initialVisit_arithmeticIndex
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : RootClosure N V) : rootVisitArithmeticIndex root.initialVisit = 0 :=
  rfl

@[simp] theorem RootVisit.next_arithmeticIndex
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : RootClosure N V} (visit : RootVisit root)
    {next : V.Current}
    (next_eq : (root.evolutionAt visit.current).nextCurrent? = some next) :
    rootVisitArithmeticIndex (visit.next next_eq) =
      rootVisitArithmeticIndex visit + 1 :=
  rfl

/-- Exact arithmetic terminal authority generated by one root occurrence.

The constructor is private.  Callers cannot provide a terminal event, finite
patch, ledger discharge, or a hand-pruned event inventory.  The exact emitted
root occurrence decides the branch, while the source admission proves that the
complete lower actual fibre contains no continuing event. -/
structure GeneratedRootArithmeticTerminalAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeAuthoritativeRootClosure N V)
    (visit : RootVisit root.toRoot) : Type u where
  private mk ::
  terminalEvent : V.FaithfulTerminalAt visit.current
  structural_eq :
    root.source.restructuringSource.source.toRootSource.actual.compile
        (root.emitted visit.current) =
      .faithfulTerminal terminalEvent
  terminal : LedgerTerminalEvolutionAt N
    ⟨root.source.restructuringSource.source.toRootSource.account.supportOf
      (root.emitted visit.current)⟩
  generated_eq :
    root.generatedLedgerAt visit.current =
      .faithfulTerminal terminalEvent structural_eq terminal
  noOutgoingActual :
    IsEmpty
      (SourceNativeActualOutgoingEventAt
        root.source.eventInventoryAdmission.actualSource
        (root.source.eventInventoryAdmission.currentPresentation.backward
          visit.current))

/-- Total root-native terminal classifier. -/
def generateRootArithmeticTerminalAt?
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeAuthoritativeRootClosure N V)
    (visit : RootVisit root.toRoot) :
    Option (GeneratedRootArithmeticTerminalAt root visit) := by
  generalize generatedLedger_eq :
    root.generatedLedgerAt visit.current = generated
  cases generated with
  | nativeWrite _ _ _ _ => exact none
  | relationWrite _ _ _ _ => exact none
  | continuedTransport _ _ _ _ => exact none
  | borromeanRedirect _ _ _ _ => exact none
  | faithfulTerminal terminal structural_eq ledgerEvolution =>
      let sourceTerminal : SourceFaithfulTerminalOccurrenceAt root.source
          (root.emitted visit.current) :=
        ⟨terminal, structural_eq, ledgerEvolution, generatedLedger_eq⟩
      exact some
        ⟨terminal, structural_eq, ledgerEvolution, generatedLedger_eq,
          sourceTerminal.noOutgoingActual⟩

private def GeneratedRootArithmeticTerminalAt.terminalPatchBundle
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    {visit : RootVisit root.toRoot}
    (terminal : GeneratedRootArithmeticTerminalAt root visit) :
    { patch : SourceGeneratedLedgerTerminalPatchAt
        root.source.restructuringSource.compiler.ledgerCompiler.terminalRowSource
        (root.emitted visit.current) //
      patch.toLedgerTerminalEvolution = terminal.terminal } :=
  Eq.mp
    (congrArg
      (SourceNativeFiniteLedgerPatchAt root.source.restructuringSource.source
        root.source.restructuringSource.compiler.ledgerCompiler.ExactTransitionAt
        root.source.restructuringSource.compiler.ledgerCompiler.writeRowSource
        root.source.restructuringSource.compiler.ledgerCompiler.terminalRowSource)
      terminal.generated_eq)
    (root.generatedPatchAt visit.current)

/-- The terminal patch is not stored in terminal authority.  It is the exact
finite or uniform support-settlement patch compiled by the same root
occurrence, reindexed along the source-generated terminal branch. -/
def GeneratedRootArithmeticTerminalAt.terminalPatch
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    {visit : RootVisit root.toRoot}
    (terminal : GeneratedRootArithmeticTerminalAt root visit) :
    SourceGeneratedLedgerTerminalPatchAt
      root.source.restructuringSource.compiler.ledgerCompiler.terminalRowSource
      (root.emitted visit.current) :=
  terminal.terminalPatchBundle.1

/-- Folding the derived patch recovers the terminal ledger emitted by the
same root compiler. -/
theorem GeneratedRootArithmeticTerminalAt.terminalPatch_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    {visit : RootVisit root.toRoot}
    (terminal : GeneratedRootArithmeticTerminalAt root visit) :
    terminal.terminalPatch.toLedgerTerminalEvolution = terminal.terminal := by
  exact terminal.terminalPatchBundle.2

/-- A fixed root occurrence has at most one arithmetic terminal authority.
The literal source branch determines the event and ledger; all remaining
fields are propositions. -/
theorem GeneratedRootArithmeticTerminalAt.eq_of_same_indices
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    {visit : RootVisit root.toRoot}
    (left right : GeneratedRootArithmeticTerminalAt root visit) :
    left = right := by
  rcases left with
    ⟨leftEvent, leftStructural, leftTerminal, leftGenerated, leftExhausted⟩
  rcases right with
    ⟨rightEvent, rightStructural, rightTerminal, rightGenerated, rightExhausted⟩
  have event_eq : leftEvent = rightEvent :=
    EvolutionAt.faithfulTerminal.inj
      (leftStructural.symm.trans rightStructural)
  cases event_eq
  have structural_eq : leftStructural = rightStructural :=
    Subsingleton.elim _ _
  cases structural_eq
  have terminal_eq : leftTerminal = rightTerminal := by
    have branch_eq := leftGenerated.symm.trans rightGenerated
    injection branch_eq
  cases terminal_eq
  rfl

/-- The exact source-generated arithmetic index of this terminal. -/
def GeneratedRootArithmeticTerminalAt.index
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    {visit : RootVisit root.toRoot}
    (_terminal : GeneratedRootArithmeticTerminalAt root visit) : Nat :=
  rootVisitArithmeticIndex visit

/-- The exact registered root occurrence which generated the terminal. -/
def GeneratedRootArithmeticTerminalAt.occurrence
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeAuthoritativeRootClosure N V}
    {visit : RootVisit root.toRoot}
    (_terminal : GeneratedRootArithmeticTerminalAt root visit) :
    ExactTemporalCausalRootEventAt root.toLedgerRoot (.finite visit) :=
  root.toLedgerRoot.exactTemporalCausalEventAt (.finite visit)

end RootArithmeticTerminalAuthority
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
