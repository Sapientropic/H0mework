/-!
# Field-free arithmetic generation

Natural number arithmetic is a shadow of unit-occurrence history.  The
source carrier has no numeric index: parallel and joint composition act on
actual histories first, and `cardinalShadow` subsequently proves the familiar
addition and multiplication laws.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace ArithmeticGeneration

/-- Unindexed history of unit occurrences.  No `Nat`, sum, product or result
appears in its type. -/
inductive UnitHistory : Type
  | empty
  | next (prior : UnitHistory)
  deriving DecidableEq

/-- Arithmetic is a readout of generated history. -/
def UnitHistory.cardinalShadow : UnitHistory → Nat
  | .empty => 0
  | .next prior => Nat.succ prior.cardinalShadow

/-- Generate a concrete finite history when a finite observation depth is
requested.  This is a readout constructor, not the source definition. -/
def UnitHistory.generate : Nat → UnitHistory
  | 0 => .empty
  | count + 1 => .next (generate count)

/-- Tagged parallel composition acts before cardinality is read. -/
def UnitHistory.parallel (left : UnitHistory) : UnitHistory → UnitHistory
  | .empty => left
  | .next right => .next (parallel left right)

/-- Complete joint composition: every right occurrence generates one whole
copy of the left history. -/
def UnitHistory.joint (left : UnitHistory) : UnitHistory → UnitHistory
  | .empty => .empty
  | .next right => (joint left right).parallel left

@[simp] theorem UnitHistory.cardinalShadow_generate (count : Nat) :
    (UnitHistory.generate count).cardinalShadow = count := by
  induction count with
  | zero => rfl
  | succ count inductionHypothesis =>
      change Nat.succ (UnitHistory.generate count).cardinalShadow = Nat.succ count
      exact congrArg Nat.succ inductionHypothesis

/-- Addition is generated by parallel occurrence composition. -/
@[simp] theorem UnitHistory.cardinalShadow_parallel
    (left right : UnitHistory) :
    (left.parallel right).cardinalShadow =
      left.cardinalShadow + right.cardinalShadow := by
  induction right with
  | empty => exact (Nat.add_zero left.cardinalShadow).symm
  | next right inductionHypothesis =>
      change Nat.succ (left.parallel right).cardinalShadow =
        left.cardinalShadow + Nat.succ right.cardinalShadow
      exact (congrArg Nat.succ inductionHypothesis).trans
        (Nat.add_succ left.cardinalShadow right.cardinalShadow).symm

/-- Multiplication is generated by complete joint occurrence composition. -/
@[simp] theorem UnitHistory.cardinalShadow_joint
    (left right : UnitHistory) :
    (left.joint right).cardinalShadow =
      left.cardinalShadow * right.cardinalShadow := by
  induction right with
  | empty => exact (Nat.mul_zero left.cardinalShadow).symm
  | next right inductionHypothesis =>
      change ((left.joint right).parallel left).cardinalShadow =
        left.cardinalShadow * (right.cardinalShadow + 1)
      exact (UnitHistory.cardinalShadow_parallel (left.joint right) left).trans <|
        (congrArg (fun value => value + left.cardinalShadow)
          inductionHypothesis).trans
        (Nat.mul_succ left.cardinalShadow right.cardinalShadow).symm

/-- Unary unit history has no arrangement bit beyond its generated shadow. -/
theorem UnitHistory.eq_of_cardinalShadow_eq
    {left right : UnitHistory}
    (same : left.cardinalShadow = right.cardinalShadow) : left = right := by
  induction left generalizing right with
  | empty =>
      cases right with
      | empty => rfl
      | next right => exact False.elim (Nat.noConfusion same)
  | next left inductionHypothesis =>
      cases right with
      | empty => exact False.elim (Nat.noConfusion same)
      | next right =>
          exact congrArg UnitHistory.next
            (inductionHypothesis (Nat.succ.inj same))

/-- Indexed normalization retained only as a dependent cardinal readout. -/
structure UnitInventoryAt (count : Nat) : Type where
  private mk ::
  history : UnitHistory
  shadow_eq : history.cardinalShadow = count

theorem UnitInventoryAt.ext
    {count : Nat} {left right : UnitInventoryAt count}
    (history_eq : left.history = right.history) : left = right := by
  cases left
  cases right
  cases history_eq
  rfl

def UnitHistory.toInventory (history : UnitHistory) :
    UnitInventoryAt history.cardinalShadow :=
  ⟨history, rfl⟩

def UnitInventoryAt.generate (count : Nat) : UnitInventoryAt count :=
  ⟨UnitHistory.generate count, UnitHistory.cardinalShadow_generate count⟩

def UnitInventoryAt.parallel
    {left right : Nat} (leftInventory : UnitInventoryAt left)
    (rightInventory : UnitInventoryAt right) : UnitInventoryAt (left + right) :=
  ⟨leftInventory.history.parallel rightInventory.history, by
    rw [UnitHistory.cardinalShadow_parallel,
      leftInventory.shadow_eq, rightInventory.shadow_eq]⟩

def UnitInventoryAt.joint
    {left right : Nat} (leftInventory : UnitInventoryAt left)
    (rightInventory : UnitInventoryAt right) : UnitInventoryAt (left * right) :=
  ⟨leftInventory.history.joint rightInventory.history, by
    rw [UnitHistory.cardinalShadow_joint,
      leftInventory.shadow_eq, rightInventory.shadow_eq]⟩

@[simp] theorem UnitInventoryAt.parallel_generate
    (left right : Nat) :
    (UnitInventoryAt.generate left).parallel
        (UnitInventoryAt.generate right) =
      UnitInventoryAt.generate (left + right) := by
  apply UnitInventoryAt.ext
  exact UnitHistory.eq_of_cardinalShadow_eq <|
    ((UnitInventoryAt.generate left).parallel
      (UnitInventoryAt.generate right)).shadow_eq.trans
        (UnitInventoryAt.generate (left + right)).shadow_eq.symm

@[simp] theorem UnitInventoryAt.joint_generate
    (left right : Nat) :
    (UnitInventoryAt.generate left).joint
        (UnitInventoryAt.generate right) =
      UnitInventoryAt.generate (left * right) := by
  apply UnitInventoryAt.ext
  exact UnitHistory.eq_of_cardinalShadow_eq <|
    ((UnitInventoryAt.generate left).joint
      (UnitInventoryAt.generate right)).shadow_eq.trans
        (UnitInventoryAt.generate (left * right)).shadow_eq.symm

theorem UnitInventoryAt.eq_generated
    {count : Nat} (inventory : UnitInventoryAt count) :
    inventory = UnitInventoryAt.generate count := by
  apply UnitInventoryAt.ext
  exact UnitHistory.eq_of_cardinalShadow_eq <|
    inventory.shadow_eq.trans
      (UnitHistory.cardinalShadow_generate count).symm

theorem UnitInventoryAt.unique
    {count : Nat} (left right : UnitInventoryAt count) : left = right :=
  (left.eq_generated).trans right.eq_generated.symm

end ArithmeticGeneration
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
