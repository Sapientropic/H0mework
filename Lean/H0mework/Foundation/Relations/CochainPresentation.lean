import Mathlib.Algebra.Homology.HomologicalComplex
import Mathlib.Algebra.Category.ModuleCat.Basic
import H0mework.Foundation.Relations.AdditivePresentation

/-!
# Root-generated cochain relation presentations

An actual integral homological complex generates, degree by degree, the
canonical addition-relation presentation of its carrier.  Every actual
differential transports generators and relations by generic functoriality;
under the canonical cokernel equivalences the induced map is exactly the
original differential.  No finite model, basis, matrix, determinant or
perfectness premise is accepted.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace CochainRelationPresentation

open CategoryTheory
open FiniteAdditiveRelationPresentation

noncomputable section

universe u

variable {Index : Type*} {shape : ComplexShape Index}

/-- One actual complex occurrence attached to one exact root occurrence. -/
structure RootGeneratedCochainRelationPresentationAt
    {Root : Type u}
    (rootOccurrence : RootedAccountedUnfolding Root)
    (complexOccurrence : RootedAccountedUnfolding
      (HomologicalComplex (ModuleCat.{0} ℤ) shape)) where
  private mk ::

namespace RootGeneratedCochainRelationPresentationAt

variable {Root : Type u}
variable {rootOccurrence : RootedAccountedUnfolding Root}
variable {complexOccurrence : RootedAccountedUnfolding
  (HomologicalComplex (ModuleCat.{0} ℤ) shape)}

def generate : RootGeneratedCochainRelationPresentationAt
    rootOccurrence complexOccurrence :=
  ⟨⟩

def root
    (_face : RootGeneratedCochainRelationPresentationAt
      rootOccurrence complexOccurrence) :=
  rootOccurrence

def complex
    (_face : RootGeneratedCochainRelationPresentationAt
      rootOccurrence complexOccurrence) :=
  complexOccurrence.root

/-- Canonical relation presentation of one actual cochain degree. -/
def termPresentation
    (face : RootGeneratedCochainRelationPresentationAt
      rootOccurrence complexOccurrence)
    (degree : Index) :=
  sourceGeneratedFiniteAdditiveRelationPresentation
    (face.complex.X degree) face.root

/-- Actual differential as an additive map between the same degree
carriers. -/
def differentialAddHom
    (face : RootGeneratedCochainRelationPresentationAt
      rootOccurrence complexOccurrence)
    (source target : Index) :
    face.complex.X source →+ face.complex.X target :=
  (face.complex.d source target).hom.toAddMonoidHom

/-- Induced generator transport. -/
def differentialGeneratorMap
    (face : RootGeneratedCochainRelationPresentationAt
      rootOccurrence complexOccurrence)
    (source target : Index) :=
  generatorMap (face.differentialAddHom source target)

/-- Induced relation transport. -/
def differentialRelationMap
    (face : RootGeneratedCochainRelationPresentationAt
      rootOccurrence complexOccurrence)
    (source target : Index) :=
  relationGeneratorMap (face.differentialAddHom source target)

/-- Induced map between the canonical presented carriers. -/
def differentialPresentedMap
    (face : RootGeneratedCochainRelationPresentationAt
      rootOccurrence complexOccurrence)
    (source target : Index) :=
  presentedMap (face.differentialAddHom source target)

/-- Higher relation lift generated by the zero composite of two adjacent
differentials. -/
def differentialSquareRelationLift
    (face : RootGeneratedCochainRelationPresentationAt
      rootOccurrence complexOccurrence)
    (first last : Index) :=
  zeroRelationLift (face.complex.X first) (face.complex.X last)

/-- Every actual differential strictly preserves the generated relations. -/
theorem differential_relation_naturality
    (face : RootGeneratedCochainRelationPresentationAt
      rootOccurrence complexOccurrence)
    (source target : Index) :
    (face.differentialGeneratorMap source target).comp
        (additionRelationMap (face.complex.X source)) =
      (additionRelationMap (face.complex.X target)).comp
        (face.differentialRelationMap source target) :=
  additionRelationMap_naturality
    (face.differentialAddHom source target)

/-- The presented differential reads back as the original actual
differential. -/
theorem differential_presentedMap_commutes
    (face : RootGeneratedCochainRelationPresentationAt
      rootOccurrence complexOccurrence)
    (source target : Index)
    (value : (face.termPresentation source).cokernel) :
    finiteAdditiveRelationPresentation_cokernelEquiv _
        (face.termPresentation target)
        (face.differentialPresentedMap source target value) =
      face.differentialAddHom source target
        (finiteAdditiveRelationPresentation_cokernelEquiv _
          (face.termPresentation source) value) :=
  presentedMap_commutes (face.differentialAddHom source target) value

/-- The generic presented maps inherit `d² = 0` from the same actual complex;
no zero differential is stored in the presentation. -/
theorem differential_presentedMap_comp_zero
    (face : RootGeneratedCochainRelationPresentationAt
      rootOccurrence complexOccurrence)
    (first middle last : Index)
    (value : (face.termPresentation first).cokernel) :
    finiteAdditiveRelationPresentation_cokernelEquiv _
        (face.termPresentation last)
        (face.differentialPresentedMap middle last
          (face.differentialPresentedMap first middle value)) = 0 := by
  change PresentedAdditiveCarrier (face.complex.X first) at value
  change presentedAdditiveEquiv (face.complex.X last)
      (presentedMap (face.differentialAddHom middle last)
        (presentedMap (face.differentialAddHom first middle) value)) = 0
  rw [presentedMap_commutes, presentedMap_commutes]
  exact ConcreteCategory.congr_hom
    (face.complex.d_comp_d first middle last)
    (finiteAdditiveRelationPresentation_cokernelEquiv _
      (face.termPresentation first) value)

/-- Before passing to cokernels, the square of the generated differential
is the boundary of the canonical zero relation. -/
theorem differentialGeneratorMap_comp_factorizes_through_relation
    (face : RootGeneratedCochainRelationPresentationAt
      rootOccurrence complexOccurrence)
    (first middle last : Index) :
    (face.differentialGeneratorMap middle last).comp
        (face.differentialGeneratorMap first middle) =
      (additionRelationMap (face.complex.X last)).comp
        (face.differentialSquareRelationLift first last) := by
  apply generatorMap_comp_factorizes_through_zeroRelation
  ext value
  exact ConcreteCategory.congr_hom
    (face.complex.d_comp_d first middle last) value

end RootGeneratedCochainRelationPresentationAt

end


end CochainRelationPresentation
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
