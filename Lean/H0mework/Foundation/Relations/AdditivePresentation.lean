import H0mework.Foundation.Relations.FiniteDefectDeterminant

/-!
# Root-generated finite additive relation presentations

An actual additive carrier canonically presents itself over `ℤ`: every actual
point is a generator and every actual addition is a relation
`[x] + [y] - [x+y]`.  The quotient is canonically the original carrier.  No
basis, matrix, determinant, cardinality or chosen section enters the source
mouth.

The root wrapper reuses `RootGeneratedFiniteDefectPresentationAt`; kernel,
range, cokernel and later determinant shadows therefore remain generic
readouts of the actual relation map.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace FiniteAdditiveRelationPresentation

open FiniteDefectDeterminant

noncomputable section

universe u w

variable (G : Type u) [AddCommGroup G]

/-- Evaluate the free integral module on the actual additive carrier. -/
def freeEvaluation : (G →₀ ℤ) →ₗ[ℤ] G :=
  (Finsupp.liftAddHom fun point =>
    AddMonoidHom.flip (smulAddHom ℤ G) point).toIntLinearMap

@[simp] theorem freeEvaluation_single (point : G) (coefficient : ℤ) :
    freeEvaluation G (Finsupp.single point coefficient) =
      coefficient • point := by
  simp [freeEvaluation]

/-- Relation generated by one actual addition. -/
def additionRelation (pair : G × G) : G →₀ ℤ :=
  Finsupp.single pair.1 1 + Finsupp.single pair.2 1 -
    Finsupp.single (pair.1 + pair.2) 1

/-- Source-generated relation map. -/
def additionRelationMap : ((G × G) →₀ ℤ) →ₗ[ℤ] (G →₀ ℤ) :=
  (Finsupp.liftAddHom fun pair =>
    AddMonoidHom.flip (smulAddHom ℤ (G →₀ ℤ))
      (additionRelation G pair)).toIntLinearMap

@[simp] theorem additionRelationMap_single
    (pair : G × G) (coefficient : ℤ) :
    additionRelationMap G (Finsupp.single pair coefficient) =
      coefficient • additionRelation G pair := by
  simp [additionRelationMap]

@[simp] theorem freeEvaluation_additionRelation (pair : G × G) :
    freeEvaluation G (additionRelation G pair) = 0 := by
  simp [additionRelation]

theorem additionRelationRange_le_kernel :
    LinearMap.range (additionRelationMap G) ≤
      LinearMap.ker (freeEvaluation G) := by
  rw [LinearMap.range_le_ker_iff]
  ext pair
  simp

abbrev PresentedAdditiveCarrier :=
  (G →₀ ℤ) ⧸ LinearMap.range (additionRelationMap G)

/-- Evaluation descends through exactly the generated addition relations. -/
def presentedEvaluation : PresentedAdditiveCarrier G →ₗ[ℤ] G :=
  Submodule.liftQ (LinearMap.range (additionRelationMap G))
    (freeEvaluation G) (additionRelationRange_le_kernel G)

@[simp] theorem presentedEvaluation_mk (value : G →₀ ℤ) :
    presentedEvaluation G (Submodule.Quotient.mk value) =
      freeEvaluation G value :=
  rfl

/-- The canonical generator attached to one actual point. -/
def presentedGenerator (point : G) : PresentedAdditiveCarrier G :=
  Submodule.Quotient.mk (Finsupp.single point 1)

@[simp] theorem presentedGenerator_add (left right : G) :
    presentedGenerator G (left + right) =
      presentedGenerator G left + presentedGenerator G right := by
  apply (Submodule.Quotient.eq _).2
  change Finsupp.single (left + right) 1 -
      (Finsupp.single left 1 + Finsupp.single right 1) ∈
        LinearMap.range (additionRelationMap G)
  refine ⟨-Finsupp.single (left, right) 1, ?_⟩
  simp [additionRelation]

@[simp] theorem presentedGenerator_zero : presentedGenerator G 0 = 0 := by
  have additive := presentedGenerator_add G 0 0
  apply add_left_cancel (a := presentedGenerator G 0)
  simpa using additive.symm

def presentedGeneratorHom : G →+ PresentedAdditiveCarrier G where
  toFun := presentedGenerator G
  map_zero' := presentedGenerator_zero G
  map_add' := presentedGenerator_add G

@[simp] theorem presentedEvaluation_generator (point : G) :
    presentedEvaluation G (presentedGenerator G point) = point := by
  simp [presentedGenerator]

private theorem presentedGenerator_evaluation_mk
    (representative : G →₀ ℤ) :
    presentedGeneratorHom G
        (presentedEvaluation G (Submodule.Quotient.mk representative)) =
      Submodule.Quotient.mk representative := by
  induction representative using Finsupp.induction_linear with
  | zero => simp
  | add left right left_ih right_ih =>
      have left_ih' : presentedGeneratorHom G (freeEvaluation G left) =
          Submodule.Quotient.mk left := by
        simpa using left_ih
      have right_ih' : presentedGeneratorHom G (freeEvaluation G right) =
          Submodule.Quotient.mk right := by
        simpa using right_ih
      rw [presentedEvaluation_mk, map_add, map_add,
        Submodule.Quotient.mk_add, left_ih', right_ih']
  | single point coefficient =>
      rw [presentedEvaluation_mk, freeEvaluation_single]
      change presentedGeneratorHom G (coefficient • point) =
        Submodule.Quotient.mk (Finsupp.single point coefficient)
      rw [map_zsmul]
      change coefficient • Submodule.Quotient.mk
          (Finsupp.single point 1) = _
      rw [← Submodule.Quotient.mk_smul]
      congr 1
      simp

theorem presentedGenerator_evaluation (value : PresentedAdditiveCarrier G) :
    presentedGeneratorHom G (presentedEvaluation G value) = value := by
  exact Submodule.Quotient.induction_on _ value
    (presentedGenerator_evaluation_mk G)

/-- Canonical cokernel identification generated by the actual group law. -/
def presentedAdditiveEquiv : PresentedAdditiveCarrier G ≃+ G where
  toFun := presentedEvaluation G
  invFun := presentedGeneratorHom G
  left_inv := presentedGenerator_evaluation G
  right_inv := presentedEvaluation_generator G
  map_add' := map_add _

/-! ## Functoriality from actual additive maps -/

variable {G : Type u} {H : Type*} [AddCommGroup G] [AddCommGroup H]

/-- Free generator transport induced by an actual additive map. -/
def generatorMap (hom : G →+ H) : (G →₀ ℤ) →ₗ[ℤ] (H →₀ ℤ) :=
  Finsupp.lmapDomain ℤ ℤ hom

/-- Relation-index transport induced by the same actual additive map. -/
def relationGeneratorMap (hom : G →+ H) :
    ((G × G) →₀ ℤ) →ₗ[ℤ] ((H × H) →₀ ℤ) :=
  Finsupp.lmapDomain ℤ ℤ (Prod.map hom hom)

@[simp] theorem generatorMap_single
    (hom : G →+ H) (point : G) (coefficient : ℤ) :
    generatorMap hom (Finsupp.single point coefficient) =
      Finsupp.single (hom point) coefficient := by
  simp [generatorMap, Finsupp.lmapDomain_apply]

@[simp] theorem relationGeneratorMap_single
    (hom : G →+ H) (pair : G × G) (coefficient : ℤ) :
    relationGeneratorMap hom (Finsupp.single pair coefficient) =
      Finsupp.single (hom pair.1, hom pair.2) coefficient := by
  rw [relationGeneratorMap, Finsupp.lmapDomain_apply,
    Finsupp.mapDomain_single]
  rfl

/-- Actual addition makes the relation presentation natural. -/
theorem additionRelationMap_naturality (hom : G →+ H) :
    (generatorMap hom).comp (additionRelationMap G) =
      (additionRelationMap H).comp (relationGeneratorMap hom) := by
  ext pair coefficient
  simp only [LinearMap.comp_apply]
  congr 1
  simp [additionRelation, generatorMap, Finsupp.lmapDomain_apply,
    Finsupp.mapDomain_add, Finsupp.mapDomain_sub]

/-- Evaluation of the free generators is natural for the same map. -/
theorem freeEvaluation_naturality (hom : G →+ H) :
    (freeEvaluation H).comp (generatorMap hom) =
      hom.toIntLinearMap.comp (freeEvaluation G) := by
  ext point
  simp [generatorMap, Finsupp.lmapDomain_apply]

theorem additionRelationRange_maps
    (hom : G →+ H) :
    LinearMap.range (additionRelationMap G) ≤
      (LinearMap.range (additionRelationMap H)).comap
        (generatorMap hom) := by
  intro relation relation_mem
  rcases relation_mem with ⟨source, rfl⟩
  change generatorMap hom (additionRelationMap G source) ∈
    LinearMap.range (additionRelationMap H)
  rw [← LinearMap.comp_apply, additionRelationMap_naturality,
    LinearMap.comp_apply]
  exact ⟨relationGeneratorMap hom source, rfl⟩

/-- Induced map on canonical addition presentations. -/
def presentedMap (hom : G →+ H) :
    PresentedAdditiveCarrier G →ₗ[ℤ] PresentedAdditiveCarrier H :=
  Submodule.mapQ (LinearMap.range (additionRelationMap G))
    (LinearMap.range (additionRelationMap H))
    (generatorMap hom) (additionRelationRange_maps hom)

/-- Under the canonical cokernel equivalences, the induced presentation map
is exactly the original actual additive map. -/
theorem presentedMap_commutes (hom : G →+ H)
    (value : PresentedAdditiveCarrier G) :
    presentedAdditiveEquiv H (presentedMap hom value) =
      hom (presentedAdditiveEquiv G value) := by
  refine Submodule.Quotient.induction_on _ value ?_
  intro representative
  change freeEvaluation H (generatorMap hom representative) =
    hom (freeEvaluation G representative)
  exact LinearMap.congr_fun (freeEvaluation_naturality hom) representative

/-! ## The first higher relation -/

variable {K : Type*} [AddCommGroup K]

/-- A zero composite of actual maps sends every free generator to the
generator `[0]`.  Its canonical higher cell is the relation indexed by
`(0,0)`, since `[0] + [0] - [0] = [0]`. -/
def zeroRelationLift (Source Target : Type*) [AddCommGroup Target] :
    (Source →₀ ℤ) →ₗ[ℤ] ((Target × Target) →₀ ℤ) :=
  Finsupp.lmapDomain ℤ ℤ (fun _ : Source => (0, 0))

@[simp] theorem zeroRelationLift_single
    (Source Target : Type*) [AddCommGroup Target]
    (source : Source) (coefficient : ℤ) :
    zeroRelationLift Source Target (Finsupp.single source coefficient) =
      Finsupp.single (0, 0) coefficient := by
  simp [zeroRelationLift, Finsupp.lmapDomain_apply]

/-- Before quotienting, a zero composite is exactly the boundary of the
source-generated zero relation.  This is the first syzygy of the canonical
presentation, not an externally supplied homotopy. -/
theorem generatorMap_comp_factorizes_through_zeroRelation
    (first : G →+ H) (second : H →+ K)
    (comp_zero : second.comp first = 0) :
    (generatorMap second).comp (generatorMap first) =
      (additionRelationMap K).comp (zeroRelationLift G K) := by
  ext point coefficient
  have point_zero : second (first point) = 0 := by
    exact DFunLike.congr_fun comp_zero point
  simp [LinearMap.comp_apply, point_zero, additionRelation]

variable (G : Type u) [AddCommGroup G]

def relationOccurrences : ((G × G) →₀ ℤ) →
    RootedAccountedUnfolding ((G × G) →₀ ℤ) :=
  RootedAccountedUnfolding.zero

def generatorOccurrences : (G →₀ ℤ) →
    RootedAccountedUnfolding (G →₀ ℤ) :=
  RootedAccountedUnfolding.zero

def relationMapOccurrence :
    RootedAccountedUnfolding (((G × G) →₀ ℤ) →ₗ[ℤ] (G →₀ ℤ)) :=
  RootedAccountedUnfolding.zero (additionRelationMap G)

abbrev RootGeneratedFiniteAdditiveRelationPresentationAt
    {Root : Type w} (rootOccurrence : RootedAccountedUnfolding Root) :=
  RootGeneratedFiniteDefectPresentationAt rootOccurrence
    (relationOccurrences G) (generatorOccurrences G)
      (relationMapOccurrence G)

/-- Install the canonical relation map at one exact root occurrence. -/
def sourceGeneratedFiniteAdditiveRelationPresentation
    {Root : Type w} (rootOccurrence : RootedAccountedUnfolding Root) :
    RootGeneratedFiniteAdditiveRelationPresentationAt G rootOccurrence :=
  RootGeneratedFiniteDefectPresentationAt.generate

@[simp] theorem finiteAdditiveRelationPresentation_actualMap
    {Root : Type w} {rootOccurrence : RootedAccountedUnfolding Root}
    (presentation : RootGeneratedFiniteAdditiveRelationPresentationAt
      G rootOccurrence) :
    presentation.actualMap = additionRelationMap G :=
  rfl

/-- The generic presentation's cokernel is the same canonical carrier proved
above; the root token cannot change it. -/
def finiteAdditiveRelationPresentation_cokernelEquiv
    {Root : Type w} {rootOccurrence : RootedAccountedUnfolding Root}
    (presentation : RootGeneratedFiniteAdditiveRelationPresentationAt
      G rootOccurrence) :
    presentation.cokernel ≃+ G :=
  presentedAdditiveEquiv G

end


end FiniteAdditiveRelationPresentation
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
