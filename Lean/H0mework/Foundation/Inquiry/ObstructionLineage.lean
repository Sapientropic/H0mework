import H0mework.Foundation.Source.Root

/-!
# U7 obstruction-lineage evolution

`U7ProducerCalculus` generates the exact demand of one actual world
obstruction.  The demand indexes an actual successor event; its compiler
selects one open ledger row and gives the old obstruction a typed settlement,
redirect, or theory-audit handoff.

`GeneratedU7Prefix` recursively follows compiler-emitted redirects.  Theory
audit hands the exact demand to the minimal-coface U8 producer, which generates
the typed semantic change.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution

universe u

/-- One source-owned actual producer family.  Its event fibre is indexed by
the exact obstruction and exact U7 demand it consumes.  The same event also
identifies one exact open world-ledger row carrying that demand.  Anchor,
incidence, and lineage are inherited from the dependent obstruction support. -/
structure U7ActualSuccessorSource
    (N : WorldRelationNetwork.{u}) (U7 : U7ProducerCalculus N) :
    Type (u + 1) where
  EventAt : {support : N.Support} →
    (obstruction : N.ObstructionAt support) →
    U7.DemandAt obstruction → Type u
  emit : {support : N.Support} →
    (obstruction : N.ObstructionAt support) →
    EventAt obstruction (U7.generateDemand obstruction)
  demandGeneratedAt : {support : N.Support} →
    {obstruction : N.ObstructionAt support} →
    {demand : U7.DemandAt obstruction} →
    (event : EventAt obstruction demand) →
      SourceGeneratedU7DemandAt U7 obstruction demand
  demandEntryAt : {support : N.Support} →
    {obstruction : N.ObstructionAt support} →
    {demand : U7.DemandAt obstruction} →
    EventAt obstruction demand →
      (Sigma fun responsibility : N.Responsibility =>
        N.OpenAt support responsibility)

namespace U7ActualSuccessorSource

/-- The exact world-ledger entry carried by one actual U7 successor event.
Its demand is already fixed in the event fibre. -/
def demandEntry
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {source : U7ActualSuccessorSource N U7}
    {support : N.Support} {obstruction : N.ObstructionAt support}
    {demand : U7.DemandAt obstruction}
    (event : source.EventAt obstruction demand) :
    Sigma fun responsibility : N.Responsibility =>
      N.OpenAt support responsibility :=
  source.demandEntryAt event

/-- Exact obstruction-indexed generation seal carried by one actual event. -/
def demandAuthority
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {source : U7ActualSuccessorSource N U7}
    {support : N.Support} {obstruction : N.ObstructionAt support}
    {demand : U7.DemandAt obstruction}
    (event : source.EventAt obstruction demand) :
    SourceGeneratedU7DemandAt U7 obstruction demand :=
  source.demandGeneratedAt event

end U7ActualSuccessorSource

/-- The only transition which remains inside one U7 history.  Theory audit is
deliberately absent: it is the exact handoff gate to U8, not a renewable U7
step. -/
structure U7RedirectContinuationAt
    (N : WorldRelationNetwork.{u}) {support : N.Support}
    (obstruction successor : N.ObstructionAt support) : Type u where
  worldReceipt : N.DispositionAt support .transfer
  claim_eq : N.obstructionClaim successor = N.obstructionClaim obstruction

/-- Typed disposition of the exact old obstruction and the exact demand
generated from it.  There is deliberately no constructor for an unaccounted
fresh successor.  Theory audit carries only the exact extension-demand
receipt.  The semantic change itself is generated by U8. -/
inductive U7ObstructionDispositionAt
    (N : WorldRelationNetwork.{u}) (U7 : U7ProducerCalculus N)
    {support : N.Support} (obstruction : N.ObstructionAt support)
    (_demand : U7.DemandAt obstruction) : Type u
  | settled (worldReceipt : N.DispositionAt support .supportSettlement)
  | redirected {successor : N.ObstructionAt support}
      (transition : U7RedirectContinuationAt N obstruction successor)
  | requiresTheoryAudit
      (extensionDemand : N.DispositionAt support .lawSurfaceExtension)

/-- The exact source/target ledger meaning of one generated U7 disposition.

Settlement discharges the event's own entry with the identical receipt.
Theory audit preserves the exact entry while U8 is being generated.  Redirect
may change bearer, but only through the identical source-owned transfer
receipt and the next canonical event emitted for the successor obstruction. -/
def U7DemandEntryDispositionAt
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {source : U7ActualSuccessorSource N U7}
    {support : N.Support} {obstruction : N.ObstructionAt support}
    {demand : U7.DemandAt obstruction}
    (event : source.EventAt obstruction demand)
    (disposition : U7ObstructionDispositionAt N U7 obstruction demand) :
    Type u :=
  match disposition with
  | .settled receipt =>
      { terminal : ConstructiveRoot.LedgerEntryTerminalAt N
          (U7ActualSuccessorSource.demandEntry event) //
        terminal.receipt = receipt }
  | @U7ObstructionDispositionAt.redirected _ _ _ _ _ successor transition =>
      { evolution : ConstructiveRoot.LedgerEntryEvolutionAt N
          (U7ActualSuccessorSource.demandEntry event)
          (U7ActualSuccessorSource.demandEntry (source.emit successor)) //
        match evolution with
        | ConstructiveRoot.LedgerEntryEvolutionAt.transferred
            rowReceipt _ _ _ => rowReceipt = transition.worldReceipt
        | ConstructiveRoot.LedgerEntryEvolutionAt.maintained .. => False
        | ConstructiveRoot.LedgerEntryEvolutionAt.carried .. => False }
  | .requiresTheoryAudit _ => PUnit

/-- Compiler output of one exact actual successor event.

Cross-domain charts are deliberately absent.  A U6 overlap is authoritative
only when it is read from the fixed root occurrence; an unrelated
`SharedOccurrenceSpan` cannot be attached beside this event and borrow its U7
authority. -/
structure GeneratedU7ObstructionEvolutionAt
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    (source : U7ActualSuccessorSource N U7)
    {support : N.Support} {obstruction : N.ObstructionAt support}
    {demand : U7.DemandAt obstruction}
    (event : source.EventAt obstruction demand) : Type (u + 1) where
  disposition : U7ObstructionDispositionAt N U7 obstruction demand
  demandEntryDisposition : U7DemandEntryDispositionAt event disposition

/-- Exact whole-ledger disposition generated by one U7 compiler image.

Settlement exposes its terminal row, theory audit carries the identical
demand incidence, and redirect exposes its source-owned transfer row. -/
def GeneratedU7ObstructionEvolutionAt.entryDisposition
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {source : U7ActualSuccessorSource N U7}
    {support : N.Support} {obstruction : N.ObstructionAt support}
    {demand : U7.DemandAt obstruction}
    {event : source.EventAt obstruction demand}
    (generated : GeneratedU7ObstructionEvolutionAt source event) :
    ConstructiveRoot.LedgerEntryDispositionAt N
      (U7ActualSuccessorSource.demandEntry event) := by
  rcases generated with ⟨disposition, demandEntryDisposition⟩
  cases disposition with
  | settled _ =>
      exact .terminal demandEntryDisposition.1
  | redirected _ =>
      exact .evolved demandEntryDisposition.1
  | requiresTheoryAudit _ =>
      exact .evolved (.carried rfl HEq.rfl)

/-- Source-owned compiler from demand-indexed actual events to typed U7
successor evolutions. -/
structure U7ObstructionEvolutionCalculus
    (N : WorldRelationNetwork.{u}) (U7 : U7ProducerCalculus N) :
    Type (u + 1) where
  source : U7ActualSuccessorSource N U7
  compile : {support : N.Support} →
    {obstruction : N.ObstructionAt support} →
    {demand : U7.DemandAt obstruction} →
    (event : source.EventAt obstruction demand) →
      GeneratedU7ObstructionEvolutionAt source event

/-- Exact gate for theory audit: the canonical compiler output of this U7
event must request an extension audit.  Settlement and redirect remain
legitimate U7 answers, but neither may open a U8 coface. -/
def SourceNativeU7TheoryAuditAt
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    (calculus : U7ObstructionEvolutionCalculus N U7)
    {support : N.Support} {obstruction : N.ObstructionAt support}
    {demand : U7.DemandAt obstruction}
    (event : calculus.source.EventAt obstruction demand) : Type u :=
  match (calculus.compile event).disposition with
  | .settled _ => PEmpty
  | .redirected _ => PEmpty
  | .requiresTheoryAudit _ => PUnit

/-- A U7 face and the whole root compiler expose one exact demand entry and
one exact ledger disposition. -/
def U7DemandEntryRootDispositionCommutesAt
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    (calculus : U7ObstructionEvolutionCalculus N U7)
    {support : N.Support} {obstruction : N.ObstructionAt support}
    (event : calculus.source.EventAt obstruction
      (U7.generateDemand obstruction))
    {rootSupport : N.Support}
    (rootEntry : ConstructiveRoot.OpenResponsibilityAt N rootSupport)
    (rootDisposition : ConstructiveRoot.LedgerEntryDispositionAt N
      rootEntry) : Prop :=
  HEq rootEntry (U7ActualSuccessorSource.demandEntry event) ∧
    HEq rootDisposition (calculus.compile event).entryDisposition

namespace SourceNativeU7TheoryAuditAt

/-- The gate token is proof-irrelevant.  Its only information is already in
the exact calculus/event indices and the compiler-selected branch. -/
instance instSubsingleton
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    (calculus : U7ObstructionEvolutionCalculus N U7)
    {support : N.Support} {obstruction : N.ObstructionAt support}
    {demand : U7.DemandAt obstruction}
    (event : calculus.source.EventAt obstruction demand) :
    Subsingleton (SourceNativeU7TheoryAuditAt calculus event) := by
  unfold SourceNativeU7TheoryAuditAt
  split <;> infer_instance

/-- An inhabited gate can only read the exact extension-demand receipt already
emitted by the source compiler.  `PUnit` is therefore a seal here, not a
semantic-change payload. -/
theorem readsCompiler
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    (calculus : U7ObstructionEvolutionCalculus N U7)
    {support : N.Support} {obstruction : N.ObstructionAt support}
    {demand : U7.DemandAt obstruction}
    (event : calculus.source.EventAt obstruction demand)
    (gate : SourceNativeU7TheoryAuditAt calculus event) :
    ∃ (receipt : N.DispositionAt support .lawSurfaceExtension),
      (calculus.compile event).disposition =
        .requiresTheoryAudit receipt := by
  cases disposition_eq : (calculus.compile event).disposition with
  | settled receipt =>
      unfold SourceNativeU7TheoryAuditAt at gate
      rw [disposition_eq] at gate
      exact PEmpty.elim gate
  | redirected transition =>
      unfold SourceNativeU7TheoryAuditAt at gate
      rw [disposition_eq] at gate
      exact PEmpty.elim gate
  | requiresTheoryAudit receipt =>
      exact ⟨receipt, rfl⟩

end SourceNativeU7TheoryAuditAt

namespace U7ObstructionEvolutionCalculus

def generated
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    (calculus : U7ObstructionEvolutionCalculus N U7)
    {support : N.Support} (obstruction : N.ObstructionAt support) :
    Sigma fun event : calculus.source.EventAt obstruction
        (U7.generateDemand obstruction) =>
      GeneratedU7ObstructionEvolutionAt calculus.source event :=
  let event := calculus.source.emit obstruction
  ⟨event, calculus.compile event⟩

end U7ObstructionEvolutionCalculus

/-- A compiler-generated finite U7 prefix.  Every step is the exact redirect
emitted for the predecessor obstruction.  Theory audit exits through the
fixed-root U8 gate. -/
private inductive GeneratedU7PrefixSeal where
  | token

inductive GeneratedU7Prefix
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    (calculus : U7ObstructionEvolutionCalculus N U7)
    {support : N.Support} :
    N.ObstructionAt support → Nat → Type (u + 1)
  | nil (_seal : GeneratedU7PrefixSeal)
      (obstruction : N.ObstructionAt support) :
      GeneratedU7Prefix calculus obstruction 0
  | step
      {obstruction successor : N.ObstructionAt support} {length : Nat}
      (_seal : GeneratedU7PrefixSeal)
      (transition : U7RedirectContinuationAt N obstruction successor)
      (generated_eq :
        (calculus.generated obstruction).2.disposition =
          .redirected transition)
      (tail : GeneratedU7Prefix calculus successor length) :
      GeneratedU7Prefix calculus obstruction (length + 1)

namespace GeneratedU7Prefix

/-- Generate a finite U7 prefix by recursively consulting the exact source
compiler at every predecessor obstruction.

The module-private seal makes every prefix a recursive image of the source
compiler.  Settlement and theory audit return `none` for each requested
positive length; theory audit continues through the U8 handoff. -/
def generate?
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    (calculus : U7ObstructionEvolutionCalculus N U7)
    {support : N.Support} :
    (obstruction : N.ObstructionAt support) ->
      (length : Nat) -> Option (GeneratedU7Prefix calculus obstruction length)
  | obstruction, 0 => some (.nil .token obstruction)
  | obstruction, length + 1 =>
      match generated_eq : (calculus.generated obstruction).2.disposition with
      | .settled _ => none
      | .requiresTheoryAudit _ => none
      | @U7ObstructionDispositionAt.redirected _ _ _ _ _ successor transition =>
          match generate? calculus successor length with
          | none => none
          | some tail => some (.step .token transition generated_eq tail)

/-- Generate a finite prefix when the exact compiler emits a redirect at every
predecessor obstruction.  Theory-audit transitions cannot inhabit this mouth.
The private prefix seal and recursive history remain owned by this kernel. -/
def generateContinued
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    (calculus : U7ObstructionEvolutionCalculus N U7)
    {support : N.Support}
    (successor : N.ObstructionAt support → N.ObstructionAt support)
    (transition : (obstruction : N.ObstructionAt support) →
      U7RedirectContinuationAt N obstruction (successor obstruction))
    (generated_eq : (obstruction : N.ObstructionAt support) →
      (calculus.generated obstruction).2.disposition =
        .redirected (transition obstruction)) :
    (obstruction : N.ObstructionAt support) →
      (length : Nat) → GeneratedU7Prefix calculus obstruction length
  | obstruction, 0 => .nil .token obstruction
  | obstruction, length + 1 =>
      .step .token (transition obstruction) (generated_eq obstruction)
        (generateContinued calculus successor transition generated_eq
          (successor obstruction) length)

def claimTrace
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {calculus : U7ObstructionEvolutionCalculus N U7}
    {support : N.Support} {obstruction : N.ObstructionAt support}
    {length : Nat}
    (history : GeneratedU7Prefix calculus obstruction length) : List N.Claim :=
  match history with
  | .nil _ initial => [N.obstructionClaim initial]
  | .step _ _ _ tail => N.obstructionClaim obstruction :: tail.claimTrace

theorem claimTrace_length
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    {calculus : U7ObstructionEvolutionCalculus N U7}
    {support : N.Support} {obstruction : N.ObstructionAt support}
    {length : Nat}
    (history : GeneratedU7Prefix calculus obstruction length) :
    history.claimTrace.length = length + 1 := by
  induction history with
  | nil => rfl
  | step _ _ _ tail inductionHypothesis =>
      exact congrArg Nat.succ inductionHypothesis

end GeneratedU7Prefix

/-- Public source-owned compiler for a finite U7 history.  Downstream code can
request a length, but it cannot construct or splice prefix nodes itself. -/
def U7ObstructionEvolutionCalculus.generatedPrefix?
    {N : WorldRelationNetwork.{u}} {U7 : U7ProducerCalculus N}
    (calculus : U7ObstructionEvolutionCalculus N U7)
    {support : N.Support}
    (obstruction : N.ObstructionAt support) (length : Nat) :
    Option (GeneratedU7Prefix calculus obstruction length) :=
  GeneratedU7Prefix.generate? calculus obstruction length

end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
