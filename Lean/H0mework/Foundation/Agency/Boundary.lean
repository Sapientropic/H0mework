import H0mework.Foundation.Agency.MaximalActor

/-!
# Universal source-owned lifecycle boundary core

The source and target are two independent full M0 faces.  Each face owns its
seed family, exact boundary-state restriction, dependent lineage compiler,
and generated actor carrier.  Event links are generated only by exact link
seeds in the same source occurrence and compile one seed into each face.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace Lifecycle
namespace Universal

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot

universe u v w

/-- One complete M0 generated-actor face restricted to an exact boundary
state.  The lineage compiler receives the full occurrence-witnessed seed. -/
structure M0BoundaryFace
    {Source : Type u} {State : Type v}
    (occurrenceOf : Source → RootedAccountedUnfolding State) where
  Seed : Type w
  Lineage : Source → Type w
  SeedAt : Source → State → Seed → Prop
  lineageOf : ∀ source,
    SourceSeed occurrenceOf Seed SeedAt source → Lineage source
  state : Source → State
  seedAt_state : ∀ source current seed,
    SeedAt source current seed → current = state source

/-- Two boundary faces and one prefix-history face generated by a single
source-owned actual event window. -/
structure SourceOwnedLifecycleCore
    {Source : Type u} {State : Type v}
    (occurrenceOf : Source → RootedAccountedUnfolding State)
    (game : SaturationMonoid.ProcessGame occurrenceOf) where
  sourceFace : M0BoundaryFace.{u, v, w} occurrenceOf
  targetFace : M0BoundaryFace.{u, v, w} occurrenceOf
  HistorySeed : Type w
  HistoryLineage : Source → Type w
  historySeedAt : Source → State → HistorySeed → Prop
  historyLineageOf : ∀ source,
    SourceSeed occurrenceOf HistorySeed historySeedAt source →
      HistoryLineage source
  LinkSeed : Type w
  linkAdmittedAt : LinkSeed → Prop
  linkSource : LinkSeed → sourceFace.Seed
  linkTarget : LinkSeed → targetFace.Seed
  linkSource_active : ∀ link,
    linkAdmittedAt link →
      sourceFace.SeedAt game.source (sourceFace.state game.source)
        (linkSource link)
  linkTarget_active : ∀ link,
    linkAdmittedAt link →
      targetFace.SeedAt game.source (targetFace.state game.source)
        (linkTarget link)
  IdentitySeed : Type w
  identityAdmittedAt : IdentitySeed → Prop
  identitySource : IdentitySeed → sourceFace.Seed
  identityTarget : IdentitySeed → targetFace.Seed
  identitySource_active : ∀ identity,
    identityAdmittedAt identity →
      sourceFace.SeedAt game.source (sourceFace.state game.source)
        (identitySource identity)
  identityTarget_active : ∀ identity,
    identityAdmittedAt identity →
      targetFace.SeedAt game.source (targetFace.state game.source)
        (identityTarget identity)
  ExitSeed : Type w
  exitAdmittedAt : ExitSeed → Prop
  exitSource : ExitSeed → sourceFace.Seed
  exitSource_active : ∀ exit,
    exitAdmittedAt exit →
      sourceFace.SeedAt game.source (sourceFace.state game.source)
        (exitSource exit)
  FreshSeed : Type w
  freshAdmittedAt : FreshSeed → Prop
  freshTarget : FreshSeed → targetFace.Seed
  freshTarget_active : ∀ fresh,
    freshAdmittedAt fresh →
      targetFace.SeedAt game.source (targetFace.state game.source)
        (freshTarget fresh)
  ReappearanceSeed : Type w
  reappearanceAdmittedAt : ReappearanceSeed → Prop
  reappearanceHistory : ReappearanceSeed → HistorySeed
  reappearanceHistoryState : ReappearanceSeed → State
  reappearanceHistory_active : ∀ reappearance,
    reappearanceAdmittedAt reappearance →
      historySeedAt game.source (reappearanceHistoryState reappearance)
        (reappearanceHistory reappearance)
  reappearanceTarget : ReappearanceSeed → targetFace.Seed
  reappearanceTarget_active : ∀ reappearance,
    reappearanceAdmittedAt reappearance →
      targetFace.SeedAt game.source (targetFace.state game.source)
        (reappearanceTarget reappearance)
  sourceIndex : Nat
  source_state_mem :
    sourceFace.state game.source ∈ game.occurrence.trace
  target_state_mem :
    targetFace.state game.source ∈ game.occurrence.trace
  source_at_index :
    game.occurrence.trace[sourceIndex]? =
      some (sourceFace.state game.source)
  target_follows_source :
    game.occurrence.trace[sourceIndex + 1]? =
      some (targetFace.state game.source)
  history_before_event : ∀ state seed,
    historySeedAt game.source state seed →
      state ∈ game.occurrence.trace.take (sourceIndex + 1)

variable {Source : Type u} {State : Type v}
variable {occurrenceOf : Source → RootedAccountedUnfolding State}
variable {game : SaturationMonoid.ProcessGame occurrenceOf}

namespace SourceOwnedLifecycleCore

abbrev SourceActor
    (core : SourceOwnedLifecycleCore occurrenceOf game) :=
  GeneratedActor game core.sourceFace.Seed core.sourceFace.SeedAt
    core.sourceFace.Lineage core.sourceFace.lineageOf

abbrev TargetActor
    (core : SourceOwnedLifecycleCore occurrenceOf game) :=
  GeneratedActor game core.targetFace.Seed core.targetFace.SeedAt
    core.targetFace.Lineage core.targetFace.lineageOf

abbrev HistoricalActorBefore
    (core : SourceOwnedLifecycleCore occurrenceOf game) :=
  GeneratedActor game core.HistorySeed core.historySeedAt core.HistoryLineage
    core.historyLineageOf

def sourceActorOf
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (seed : SourceSeed occurrenceOf core.sourceFace.Seed
      core.sourceFace.SeedAt game.source) : core.SourceActor :=
  generatedActorOf game core.sourceFace.Seed core.sourceFace.SeedAt
    core.sourceFace.Lineage core.sourceFace.lineageOf seed

def targetActorOf
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (seed : SourceSeed occurrenceOf core.targetFace.Seed
      core.targetFace.SeedAt game.source) : core.TargetActor :=
  generatedActorOf game core.targetFace.Seed core.targetFace.SeedAt
    core.targetFace.Lineage core.targetFace.lineageOf seed

/-- Every source actor is generated by a seed at the exact source boundary
state. -/
theorem sourceActor_has_exact_state_seed
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (actor : core.SourceActor) :
    ∃ seed : SourceSeed occurrenceOf core.sourceFace.Seed
        core.sourceFace.SeedAt game.source,
      (∃ state ∈ game.occurrence.trace,
        state = core.sourceFace.state game.source ∧
          core.sourceFace.SeedAt game.source state seed.1) ∧
      core.sourceActorOf seed = actor := by
  rcases generatedActor_has_exact_sourceSeed game core.sourceFace.Seed
      core.sourceFace.SeedAt core.sourceFace.Lineage
      core.sourceFace.lineageOf actor with
    ⟨seed, ⟨state, inTrace, active⟩, generated⟩
  exact ⟨seed,
    ⟨state, inTrace,
      core.sourceFace.seedAt_state game.source state seed.1 active,
      active⟩,
    generated⟩

/-- Every target actor is generated by a seed at the exact target boundary
state. -/
theorem targetActor_has_exact_state_seed
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (actor : core.TargetActor) :
    ∃ seed : SourceSeed occurrenceOf core.targetFace.Seed
        core.targetFace.SeedAt game.source,
      (∃ state ∈ game.occurrence.trace,
        state = core.targetFace.state game.source ∧
          core.targetFace.SeedAt game.source state seed.1) ∧
      core.targetActorOf seed = actor := by
  rcases generatedActor_has_exact_sourceSeed game core.targetFace.Seed
      core.targetFace.SeedAt core.targetFace.Lineage
      core.targetFace.lineageOf actor with
    ⟨seed, ⟨state, inTrace, active⟩, generated⟩
  exact ⟨seed,
    ⟨state, inTrace,
      core.targetFace.seedAt_state game.source state seed.1 active,
      active⟩,
    generated⟩

def linkSeedAt
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (_source : Source) (state : State) (link : core.LinkSeed) : Prop :=
  state = core.targetFace.state game.source ∧ core.linkAdmittedAt link

abbrev ExactLinkSeed
    (core : SourceOwnedLifecycleCore occurrenceOf game) :=
  SourceSeed occurrenceOf core.LinkSeed core.linkSeedAt game.source

theorem ExactLinkSeed.admitted
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (link : core.ExactLinkSeed) :
    core.linkAdmittedAt link.1 := by
  rcases link.2 with ⟨state, _inTrace, _atEvent, admitted⟩
  exact admitted

def ExactLinkSeed.sourceSeed
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (link : core.ExactLinkSeed) :
    SourceSeed occurrenceOf core.sourceFace.Seed core.sourceFace.SeedAt
      game.source :=
  ⟨core.linkSource link.1,
    core.sourceFace.state game.source,
    core.source_state_mem,
    core.linkSource_active link.1 (link.admitted core)⟩

def ExactLinkSeed.targetSeed
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (link : core.ExactLinkSeed) :
    SourceSeed occurrenceOf core.targetFace.Seed core.targetFace.SeedAt
      game.source :=
  ⟨core.linkTarget link.1,
    core.targetFace.state game.source,
    core.target_state_mem,
    core.linkTarget_active link.1 (link.admitted core)⟩

def ExactLinkSeed.sourceActor
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (link : core.ExactLinkSeed) : core.SourceActor :=
  core.sourceActorOf (link.sourceSeed core)

def ExactLinkSeed.targetActor
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (link : core.ExactLinkSeed) : core.TargetActor :=
  core.targetActorOf (link.targetSeed core)

/-- The actor link relation is exactly the image of source-owned event-link
seeds from this occurrence. -/
def ActorRelated
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (source : core.SourceActor) (target : core.TargetActor) : Prop :=
  ∃ link : core.ExactLinkSeed,
    link.sourceActor core = source ∧ link.targetActor core = target

def DescendantFiber
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (source : core.SourceActor) :=
  { target : core.TargetActor // core.ActorRelated source target }

def PredecessorFiber
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (target : core.TargetActor) :=
  { source : core.SourceActor // core.ActorRelated source target }

/-- Every historical actor carries an exact prefix seed before the event. -/
theorem historicalActor_has_exact_prefix_seed
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (historical : core.HistoricalActorBefore) :
    ∃ seed : SourceSeed occurrenceOf core.HistorySeed core.historySeedAt
        game.source,
      (∃ state ∈ game.occurrence.trace.take
          (core.sourceIndex + 1),
        core.historySeedAt game.source state seed.1) ∧
      generatedActorOf game core.HistorySeed core.historySeedAt
        core.HistoryLineage core.historyLineageOf seed = historical := by
  rcases generatedActor_has_exact_sourceSeed game core.HistorySeed
      core.historySeedAt core.HistoryLineage core.historyLineageOf historical with
    ⟨seed, ⟨state, _inWholeTrace, active⟩, generated⟩
  exact ⟨seed,
    ⟨state, core.history_before_event state seed.1 active, active⟩,
    generated⟩

end SourceOwnedLifecycleCore
end Universal
end Lifecycle
end Society
end ProcessGame
end SaturationMonoid
