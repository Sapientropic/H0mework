import H0mework.Foundation.Agency.Boundary

/-!
# Exact domain lifecycle seeds

Identity transport, exit, fresh origin and reappearance are generated by
proof-relevant seeds at the target state of the same actual occurrence edge.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace Lifecycle
namespace Universal

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot

universe u v w

variable {Source : Type u} {State : Type v}
variable {occurrenceOf : Source → RootedAccountedUnfolding State}
variable {game : SaturationMonoid.ProcessGame occurrenceOf}

namespace SourceOwnedLifecycleCore

/-! ## Exact identity-transport seeds -/

def identitySeedAt
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (_source : Source) (state : State) (identity : core.IdentitySeed) : Prop :=
  state = core.targetFace.state game.source ∧
    core.identityAdmittedAt identity

abbrev ExactIdentitySeed
    (core : SourceOwnedLifecycleCore occurrenceOf game) :=
  SourceSeed occurrenceOf core.IdentitySeed core.identitySeedAt game.source

theorem ExactIdentitySeed.admitted
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (identity : core.ExactIdentitySeed) :
    core.identityAdmittedAt identity.1 := by
  rcases identity.2 with ⟨state, _inTrace, _atEvent, admitted⟩
  exact admitted

def ExactIdentitySeed.sourceSeed
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (identity : core.ExactIdentitySeed) :
    SourceSeed occurrenceOf core.sourceFace.Seed core.sourceFace.SeedAt
      game.source :=
  ⟨core.identitySource identity.1,
    core.sourceFace.state game.source,
    core.source_state_mem,
    core.identitySource_active identity.1
      (identity.admitted core)⟩

def ExactIdentitySeed.targetSeed
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (identity : core.ExactIdentitySeed) :
    SourceSeed occurrenceOf core.targetFace.Seed core.targetFace.SeedAt
      game.source :=
  ⟨core.identityTarget identity.1,
    core.targetFace.state game.source,
    core.target_state_mem,
    core.identityTarget_active identity.1
      (identity.admitted core)⟩

def ExactIdentitySeed.sourceActor
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (identity : core.ExactIdentitySeed) : core.SourceActor :=
  core.sourceActorOf (identity.sourceSeed core)

def ExactIdentitySeed.targetActor
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (identity : core.ExactIdentitySeed) : core.TargetActor :=
  core.targetActorOf (identity.targetSeed core)

structure DomainIdentityTransportAt
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (source : core.SourceActor) (target : core.TargetActor) where
  identity : core.ExactIdentitySeed
  source_eq : identity.sourceActor core = source
  target_eq : identity.targetActor core = target

/-! ## Exact domain exit seeds -/

def exitSeedAt
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (_source : Source) (state : State) (exit : core.ExitSeed) : Prop :=
  state = core.targetFace.state game.source ∧ core.exitAdmittedAt exit

abbrev ExactExitSeed
    (core : SourceOwnedLifecycleCore occurrenceOf game) :=
  SourceSeed occurrenceOf core.ExitSeed core.exitSeedAt game.source

theorem ExactExitSeed.admitted
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (exit : core.ExactExitSeed) :
    core.exitAdmittedAt exit.1 := by
  rcases exit.2 with ⟨state, _inTrace, _atEvent, admitted⟩
  exact admitted

def ExactExitSeed.sourceSeed
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (exit : core.ExactExitSeed) :
    SourceSeed occurrenceOf core.sourceFace.Seed core.sourceFace.SeedAt
      game.source :=
  ⟨core.exitSource exit.1,
    core.sourceFace.state game.source,
    core.source_state_mem,
    core.exitSource_active exit.1 (exit.admitted core)⟩

def ExactExitSeed.sourceActor
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (exit : core.ExactExitSeed) : core.SourceActor :=
  core.sourceActorOf (exit.sourceSeed core)

/-- Domain terminal/capture authority generated at the same event occurrence.
This is the non-framework exit branch; sparse absence alone cannot construct
it. -/
structure DomainExitAuthorityAt
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (source : core.SourceActor) where
  exit : core.ExactExitSeed
  source_eq : exit.sourceActor core = source

/-! ## Exact domain fresh and reappearance seeds -/

def freshSeedAt
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (_source : Source) (state : State) (fresh : core.FreshSeed) : Prop :=
  state = core.targetFace.state game.source ∧ core.freshAdmittedAt fresh

abbrev ExactFreshSeed
    (core : SourceOwnedLifecycleCore occurrenceOf game) :=
  SourceSeed occurrenceOf core.FreshSeed core.freshSeedAt game.source

theorem ExactFreshSeed.admitted
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (fresh : core.ExactFreshSeed) :
    core.freshAdmittedAt fresh.1 := by
  rcases fresh.2 with ⟨state, _inTrace, _atEvent, admitted⟩
  exact admitted

def ExactFreshSeed.targetSeed
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (fresh : core.ExactFreshSeed) :
    SourceSeed occurrenceOf core.targetFace.Seed core.targetFace.SeedAt
      game.source :=
  ⟨core.freshTarget fresh.1,
    core.targetFace.state game.source,
    core.target_state_mem,
    core.freshTarget_active fresh.1 (fresh.admitted core)⟩

def ExactFreshSeed.targetActor
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (fresh : core.ExactFreshSeed) : core.TargetActor :=
  core.targetActorOf (fresh.targetSeed core)

structure DomainFreshOriginAt
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (target : core.TargetActor) where
  fresh : core.ExactFreshSeed
  target_eq : fresh.targetActor core = target

def reappearanceSeedAt
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (_source : Source) (state : State)
    (reappearance : core.ReappearanceSeed) : Prop :=
  state = core.targetFace.state game.source ∧
    core.reappearanceAdmittedAt reappearance

abbrev ExactReappearanceSeed
    (core : SourceOwnedLifecycleCore occurrenceOf game) :=
  SourceSeed occurrenceOf core.ReappearanceSeed core.reappearanceSeedAt
    game.source

theorem ExactReappearanceSeed.admitted
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (reappearance : core.ExactReappearanceSeed) :
    core.reappearanceAdmittedAt reappearance.1 := by
  rcases reappearance.2 with ⟨state, _inTrace, _atEvent, admitted⟩
  exact admitted

def ExactReappearanceSeed.historySeed
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (reappearance : core.ExactReappearanceSeed) :
    SourceSeed occurrenceOf core.HistorySeed core.historySeedAt game.source := by
  let state := core.reappearanceHistoryState reappearance.1
  have active := core.reappearanceHistory_active reappearance.1
    (reappearance.admitted core)
  exact ⟨core.reappearanceHistory reappearance.1,
    state,
    List.mem_of_mem_take
      (core.history_before_event state
        (core.reappearanceHistory reappearance.1) active),
    active⟩

def ExactReappearanceSeed.historicalActor
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (reappearance : core.ExactReappearanceSeed) :
    core.HistoricalActorBefore :=
  generatedActorOf game core.HistorySeed core.historySeedAt
    core.HistoryLineage core.historyLineageOf
    (reappearance.historySeed core)

def ExactReappearanceSeed.targetSeed
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (reappearance : core.ExactReappearanceSeed) :
    SourceSeed occurrenceOf core.targetFace.Seed core.targetFace.SeedAt
      game.source :=
  ⟨core.reappearanceTarget reappearance.1,
    core.targetFace.state game.source,
    core.target_state_mem,
    core.reappearanceTarget_active reappearance.1
      (reappearance.admitted core)⟩

def ExactReappearanceSeed.targetActor
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (reappearance : core.ExactReappearanceSeed) : core.TargetActor :=
  core.targetActorOf (reappearance.targetSeed core)

structure DomainReappearanceAt
    (core : SourceOwnedLifecycleCore occurrenceOf game)
    (historical : core.HistoricalActorBefore)
    (target : core.TargetActor) where
  reappearance : core.ExactReappearanceSeed
  historical_eq : reappearance.historicalActor core = historical
  target_eq : reappearance.targetActor core = target

end SourceOwnedLifecycleCore
end Universal
end Lifecycle
end Society
end ProcessGame
end SaturationMonoid
