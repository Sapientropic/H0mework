import H0mework.Foundation.Source.AccountedUnfolding

/-!
# Source-only process-game core

The core stores exactly one source.  Its occurrence is definitionally the
fixed `occurrenceOf` image of that source.  Players, strategies, payoffs,
phases, future fields and ledgers are deliberately absent; all such objects
must be generated by downstream faces.
-/

set_option autoImplicit false

namespace SaturationMonoid

open ResponsibilityLifecycle LivingLawEvolution ConstructiveRoot

universe u v w

/-- Minimal process-game authority: one source under one fixed occurrence
compiler. -/
structure ProcessGame {Source : Type u} {State : Type v}
    (occurrenceOf : Source → RootedAccountedUnfolding State) where
  source : Source

namespace ProcessGame

/-- The unique occurrence generated by the stored source. -/
def occurrence {Source : Type u} {State : Type v}
    {occurrenceOf : Source → RootedAccountedUnfolding State}
    (game : ProcessGame occurrenceOf) : RootedAccountedUnfolding State :=
  occurrenceOf game.source

@[simp] theorem occurrence_eq_occurrenceOf_source
    {Source : Type u} {State : Type v}
    {occurrenceOf : Source → RootedAccountedUnfolding State}
    (game : ProcessGame occurrenceOf) :
    game.occurrence = occurrenceOf game.source :=
  rfl

/-- Closed fold readout at one exact process-game occurrence.  The token has
no result field; `value` is always recomputed by the shared occurrence fold. -/
inductive FoldReadout {Source : Type u} {State : Type v}
    {occurrenceOf : Source → RootedAccountedUnfolding State}
    (game : ProcessGame occurrenceOf) {Carrier : Type w}
    (atOccurrence : State → List Carrier → Carrier) : Type where
  | generated

/-- Sole fold-readout producer. -/
def foldReadout {Source : Type u} {State : Type v}
    {occurrenceOf : Source → RootedAccountedUnfolding State}
    (game : ProcessGame occurrenceOf) {Carrier : Type w}
    (atOccurrence : State → List Carrier → Carrier) :
    FoldReadout game atOccurrence :=
  .generated

namespace FoldReadout

/-- Fold value generated from the exact source occurrence. -/
def value {Source : Type u} {State : Type v}
    {occurrenceOf : Source → RootedAccountedUnfolding State}
    {game : ProcessGame occurrenceOf} {Carrier : Type w}
    {atOccurrence : State → List Carrier → Carrier}
    (_readout : FoldReadout game atOccurrence) : Carrier :=
  game.occurrence.fold atOccurrence

/-- Direct consumption of `RootedAccountedUnfolding.fold_unique`: every
candidate respecting the sole occurrence constructor equals the closed
readout value at this source-generated occurrence. -/
theorem candidate_eq_value {Source : Type u} {State : Type v}
    {occurrenceOf : Source → RootedAccountedUnfolding State}
    {game : ProcessGame occurrenceOf} {Carrier : Type w}
    {atOccurrence : State → List Carrier → Carrier}
    (readout : FoldReadout game atOccurrence)
    (candidate : RootedAccountedUnfolding State → Carrier)
    (commutes : ∀ (origin : State) (branches : AccountedBranches State),
      candidate (.occur origin branches) =
        atOccurrence origin
          (RootedAccountedUnfolding.candidateValues candidate branches)) :
    candidate game.occurrence = readout.value :=
  RootedAccountedUnfolding.fold_unique
    atOccurrence candidate commutes game.occurrence

end FoldReadout

end ProcessGame
end SaturationMonoid
