import H0mework.Foundation.Agency.Boundary
import H0mework.Foundation.Responsibility.Lineage

/-!
# Exact framework origin and exit authorities

Admission, reopening and final exit are exposed only through exact edges of an
already installed `NativeResponsibilityProcess`.  The sealed tokens below do
not store a caller-selected target obligation, target slot or lifecycle
verdict: every target readout is recomputed from the indexed edge and the
process compiler.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace Lifecycle
namespace Universal

open ResponsibilityLifecycle

universe u

variable {V : Vocabulary.{u}}
variable (P : NativeResponsibilityProcess V)

/-! ## Fresh admission -/

/-- Sealed authority for one exact admission edge. -/
structure FreshAdmissionEdge
    {source : ResponsibilityState V} (edge : P.Edge source) : Type u where
  private mk ::
  event : P.AdmissionEvent
  edge_eq : edge = .admit event

namespace FreshAdmissionEdge

/-- Exact-edge classifier.  Non-admission edges produce no authority. -/
def compile {source : ResponsibilityState V} :
    (edge : P.Edge source) → Option (FreshAdmissionEdge P edge)
  | .admit event => some ⟨event, rfl⟩
  | .cross .. => none
  | .reopen .. => none

/-- Sole producer: the exact process admission event at the exact source. -/
def ofEvent {source : ResponsibilityState V} (event : P.AdmissionEvent) :
    FreshAdmissionEdge P (.admit event : P.Edge source) :=
  ⟨event, rfl⟩

/-- The obligation generated by the process admission payload. -/
def targetObligation {source : ResponsibilityState V}
    {edge : P.Edge source} (admission : FreshAdmissionEdge P edge) :
    AdmittedObligation V :=
  (P.admissionPayload admission.event).toObligation

/-- Exact framework source event carried by the process-generated admission
payload. -/
def sourceEvent {source : ResponsibilityState V}
    {edge : P.Edge source} (admission : FreshAdmissionEdge P edge) :
    V.SourceEvent :=
  (P.admissionPayload admission.event).sourceEvent

/-- Admissions allocate exactly the next stable source slot. -/
def slot {source : ResponsibilityState V} {edge : P.Edge source}
    (_admission : FreshAdmissionEdge P edge) : Nat :=
  source.slots.length

/-- The exact generated target contains the admitted obligation at the newly
allocated slot. -/
theorem target_slot {source : ResponsibilityState V}
    {edge : P.Edge source} (admission : FreshAdmissionEdge P edge) :
    edge.target.slots[admission.slot P]? =
      some (.live (admission.targetObligation P)) := by
  rcases admission with ⟨event, edge_eq⟩
  subst edge
  exact NativeResponsibilityProcess.admit_target_slot (P := P) event

/-- Exact no-free origin: this slot was absent at the source and live at the
compiler-generated target. -/
theorem freshlyAllocated {source : ResponsibilityState V}
    {edge : P.Edge source} (admission : FreshAdmissionEdge P edge) :
    ResponsibilityState.FreshlyAllocatedAt source edge.target
      (admission.slot P) := by
  constructor
  · simp [slot]
  · exact ⟨admission.targetObligation P, admission.target_slot P⟩

/-- Receipt-level origin witness generated from the same exact edge. -/
def admissionWitness {source : ResponsibilityState V}
    {edge : P.Edge source} (admission : FreshAdmissionEdge P edge) :
    P.FreshAdmissionWitness edge (admission.slot P) :=
  NativeResponsibilityProcess.Edge.freshlyAllocated_generates_admission
    P edge (admission.slot P) (admission.freshlyAllocated P)

end FreshAdmissionEdge

/-! ## Reopening -/

/-- Sealed authority for one exact reopening edge. -/
structure ReopenEdge
    {source : ResponsibilityState V} (edge : P.Edge source) : Type u where
  private mk ::
  slotIndex : Fin source.slots.length
  archive : TerminalArchive V
  present : source.slots.get slotIndex = .terminal archive
  event : P.ReopenEvent archive
  edge_eq : edge = .reopen slotIndex archive present event

namespace ReopenEdge

/-- Exact-edge classifier.  Admission and boundary edges cannot mint reopen
authority. -/
def compile {source : ResponsibilityState V} :
    (edge : P.Edge source) → Option (ReopenEdge P edge)
  | .admit _ => none
  | .cross .. => none
  | .reopen slotIndex archive present event =>
      some ⟨slotIndex, archive, present, event, rfl⟩

/-- Sole producer from an exact terminal slot and the process-owned reopen
event.  No target obligation is accepted. -/
def ofEvent {source : ResponsibilityState V}
    (slotIndex : Fin source.slots.length) (archive : TerminalArchive V)
    (present : source.slots.get slotIndex = .terminal archive)
    (event : P.ReopenEvent archive) :
    ReopenEdge P (.reopen slotIndex archive present event) :=
  ⟨slotIndex, archive, present, event, rfl⟩

/-- The reopened obligation generated by the exact process payload. -/
def targetObligation {source : ResponsibilityState V}
    {edge : P.Edge source} (reopen : ReopenEdge P edge) :
    AdmittedObligation V :=
  (P.reopenPayload reopen.event).admission.toObligation

/-- Exact framework source event carried by the process-generated reopen
payload. -/
def sourceEvent {source : ResponsibilityState V}
    {edge : P.Edge source} (reopen : ReopenEdge P edge) : V.SourceEvent :=
  (P.reopenPayload reopen.event).sourceEvent

def slot {source : ResponsibilityState V} {edge : P.Edge source}
    (reopen : ReopenEdge P edge) : Nat :=
  reopen.slotIndex.val

/-- The exact generated target reopens the stable terminal slot. -/
theorem target_slot {source : ResponsibilityState V}
    {edge : P.Edge source} (reopen : ReopenEdge P edge) :
    edge.target.slots[reopen.slot P]? =
      some (.live (reopen.targetObligation P)) := by
  rcases reopen with ⟨slotIndex, archive, present, event, edge_eq⟩
  subst edge
  exact NativeResponsibilityProcess.reopen_target_slot
    (P := P) slotIndex archive present event

/-- Reopening preserves the archived debt lineage by the existing framework
receipt, rather than minting a fresh lineage. -/
theorem sameDebtLineage {source : ResponsibilityState V}
    {edge : P.Edge source} (reopen : ReopenEdge P edge) :
    SameDebtLineage reopen.archive.obligation (reopen.targetObligation P) :=
  (P.reopenPayload reopen.event).sameDebtLineage

/-- Exact source-anchor transport carried by the process-generated reopen
payload. -/
def anchorTransport {source : ResponsibilityState V}
    {edge : P.Edge source} (reopen : ReopenEdge P edge) :
    SourceAnchorTransport reopen.archive.obligation.sourceAnchor
      (reopen.targetObligation P).sourceAnchor := by
  exact (P.reopenPayload reopen.event).anchorTransport

/-- A reopen makes an existing terminal slot newly live without allocating a
fresh slot. -/
theorem newlyLive {source : ResponsibilityState V}
    {edge : P.Edge source} (reopen : ReopenEdge P edge) :
    ResponsibilityState.NewlyLiveAt source edge.target (reopen.slot P) := by
  constructor
  · rintro ⟨obligation, liveAt⟩
    have terminalAt : source.slots[reopen.slot P]? =
        some (.terminal reopen.archive) := by
      calc
        source.slots[reopen.slot P]? =
            some source.slots[reopen.slotIndex] :=
          List.getElem?_eq_getElem reopen.slotIndex.isLt
        _ = some (.terminal reopen.archive) := congrArg some reopen.present
    rw [terminalAt] at liveAt
    cases liveAt
  · exact ⟨reopen.targetObligation P, reopen.target_slot P⟩

end ReopenEdge

/-! ## Final exit -/

/-- Sealed authority for one exact boundary edge whose process-generated
disposition is a final terminal receipt. -/
structure FinalExitEdge
    {source : ResponsibilityState V} (edge : P.Edge source) : Type u where
  private mk ::
  slotIndex : Fin source.slots.length
  obligation : AdmittedObligation V
  present : source.slots.get slotIndex = .live obligation
  event : P.BoundaryEvent obligation
  receipt : FinalReceipt V obligation (P.boundarySource event)
  disposition_eq : P.boundaryDisposition event = .terminal (.final receipt)
  edge_eq : edge = .cross slotIndex obligation present event

namespace FinalExitEdge

/-- Sole public producer.  It inspects one exact process edge and returns
authority only when the process-owned boundary classifier itself generated a
final receipt.  No receipt or target is accepted from the caller. -/
def compile {source : ResponsibilityState V} :
    (edge : P.Edge source) → Option (FinalExitEdge P edge)
  | .admit _ => none
  | .reopen .. => none
  | .cross slotIndex obligation present event =>
      match disposition_eq : P.boundaryDisposition event with
      | .terminal (.final receipt) =>
          some ⟨slotIndex, obligation, present, event, receipt,
            disposition_eq, rfl⟩
      | .terminal (.superseded _) => none
      | .carry _ => none
      | .bearerRelease _ => none

def slot {source : ResponsibilityState V} {edge : P.Edge source}
    (exit : FinalExitEdge P edge) : Nat :=
  exit.slotIndex.val

/-- Exact framework source event selected by the process boundary compiler. -/
def sourceEvent {source : ResponsibilityState V}
    {edge : P.Edge source} (exit : FinalExitEdge P edge) : V.SourceEvent :=
  P.boundarySource exit.event

/-- Terminal archive generated by the exact final disposition. -/
def targetArchive {source : ResponsibilityState V}
    {edge : P.Edge source} (exit : FinalExitEdge P edge) : TerminalArchive V :=
  ⟨exit.obligation, exit.sourceEvent P, exit.receipt⟩

/-- The exact target slot is terminal and carries the generated archive. -/
theorem target_slot {source : ResponsibilityState V}
    {edge : P.Edge source} (exit : FinalExitEdge P edge) :
    edge.target.slots[exit.slot P]? =
      some (.terminal (exit.targetArchive P)) := by
  rcases exit with
    ⟨slotIndex, obligation, present, event, receipt, disposition_eq, edge_eq⟩
  subst edge
  have targetAt := NativeResponsibilityProcess.cross_target_slot
    (P := P) slotIndex obligation present event
  rw [disposition_eq] at targetAt
  exact targetAt

/-- The source slot is live by the exact edge index. -/
theorem source_live {source : ResponsibilityState V}
    {edge : P.Edge source} (exit : FinalExitEdge P edge) :
    source.LiveAt (exit.slot P) := by
  refine ⟨exit.obligation, ?_⟩
  calc
    source.slots[exit.slot P]? = some source.slots[exit.slotIndex] :=
      List.getElem?_eq_getElem exit.slotIndex.isLt
    _ = some (.live exit.obligation) := congrArg some exit.present

/-- A final disposition is an actual disappearance, not sparse absence or
supersession. -/
theorem disappears {source : ResponsibilityState V}
    {edge : P.Edge source} (exit : FinalExitEdge P edge) :
    ResponsibilityState.DisappearsAt source edge.target (exit.slot P) := by
  refine ⟨exit.source_live P, ?_⟩
  rintro ⟨targetObligation, liveAt⟩
  have terminalAt := exit.target_slot P
  rw [terminalAt] at liveAt
  cases liveAt

/-- Receipt-level provenance reconstructed from the same exact edge. -/
def disappearanceWitness {source : ResponsibilityState V}
    {edge : P.Edge source} (exit : FinalExitEdge P edge) :
    P.FinalDisappearanceWitness edge (exit.slot P) :=
  NativeResponsibilityProcess.Edge.disappears_generates_finalReceipt
    P edge (exit.slot P) (exit.disappears P)

end FinalExitEdge

end Universal
end Lifecycle
end Society
end ProcessGame
end SaturationMonoid
