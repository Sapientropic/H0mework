import H0mework.Foundation.Responsibility.Lineage

/-!
# Framework-backed actor succession edges

Succession authority is classified from one exact edge of an already
installed `NativeResponsibilityProcess`.  The public compiler inspects the
process-owned `boundaryDisposition`; callers cannot submit a receipt, target
obligation, target slot, or lifecycle verdict.

The raw classifier recognizes the two transfer-shaped carry branches and the
supersession branch.  A transfer-shaped branch becomes final succession
authority only after the generated old/new bearers are proved different.
`ExactSuccessionAt.compile` performs that check from the same exact edge when
the bearer carrier has decidable equality.

This module installs no vocabulary, process, responsibility state, registry,
or ledger.  It is a dependent adapter over an already existing `V` and `P`.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ProcessGame
namespace Society
namespace Lifecycle
namespace Universal

open ResponsibilityLifecycle

universe u

/-- The three process dispositions which can generate singleton actor
succession. -/
inductive FrameworkSuccessionKind
  | transferred
  | progressedAndTransferred
  | superseded
  deriving DecidableEq

namespace FrameworkSuccessionKind

/-- Syntactic readout of a process-owned boundary disposition.  This readout
does not itself mint succession authority; `FrameworkSuccessionEdge.compile`
is the sealed exact-edge producer. -/
def ofDisposition?
    {V : Vocabulary.{u}} {old : AdmittedObligation V}
    {source : V.SourceEvent} :
    BoundaryDisposition V old source → Option FrameworkSuccessionKind
  | .carry (.transferred ..) => some .transferred
  | .carry (.progressedAndTransferred ..) =>
      some .progressedAndTransferred
  | .terminal (.superseded ..) => some .superseded
  | .carry (.progressed ..) => none
  | .carry (.maintained ..) => none
  | .carry (.deferred ..) => none
  | .carry (.narrowed ..) => none
  | .terminal (.final ..) => none
  | .bearerRelease .. => none

end FrameworkSuccessionKind

/-- Sealed classification of one exact process edge as a succession-shaped
boundary disposition.

The constructor is private.  In particular, the public API cannot combine a
raw transfer or supersession receipt with a caller-selected target.  The
target, kind, lineage proof, and target-slot equation are installed only by
`compile` after inspecting `P.boundaryDisposition`. -/
structure FrameworkSuccessionEdge
    {V : Vocabulary.{u}} (P : NativeResponsibilityProcess V)
    {source : ResponsibilityState V} (edge : P.Edge source) : Type u where
  private mk ::
  slotIndex : Fin source.slots.length
  obligation : AdmittedObligation V
  present : source.slots.get slotIndex = .live obligation
  event : P.BoundaryEvent obligation
  kind : FrameworkSuccessionKind
  generatedTarget : AdmittedObligation V
  targetSlot_eq :
    (P.boundaryDisposition event).targetSlot = .live generatedTarget
  sameDebt : SameDebtLineage obligation generatedTarget
  kind_generated :
    FrameworkSuccessionKind.ofDisposition?
      (P.boundaryDisposition event) = some kind
  edge_eq : edge = .cross slotIndex obligation present event

namespace FrameworkSuccessionEdge

variable {V : Vocabulary.{u}} {P : NativeResponsibilityProcess V}

/-- Sole producer.  It classifies the exact process edge and accepts only
transfer, progress-and-transfer, or supersession generated by that edge's
fixed boundary disposition. -/
def compile {source : ResponsibilityState V} :
    (edge : P.Edge source) → Option (FrameworkSuccessionEdge P edge)
  | .admit _ => none
  | .reopen .. => none
  | .cross slot old present event =>
      match disposition_eq : P.boundaryDisposition event with
      | .carry (.transferred nextBearer receipt) =>
          some {
            slotIndex := slot
            obligation := old
            present := present
            event := event
            kind := .transferred
            generatedTarget :=
              (ActiveCarryDisposition.transferred nextBearer receipt).target
            targetSlot_eq := by rw [disposition_eq]; rfl
            sameDebt := acceptedTransfer_preserves_lineage receipt
            kind_generated := by rw [disposition_eq]; rfl
            edge_eq := rfl }
      | .carry (.progressedAndTransferred nextResidual nextBearer
          progressReceipt transferReceipt) =>
          some {
            slotIndex := slot
            obligation := old
            present := present
            event := event
            kind := .progressedAndTransferred
            generatedTarget :=
              (ActiveCarryDisposition.progressedAndTransferred nextResidual
                nextBearer progressReceipt transferReceipt).target
            targetSlot_eq := by rw [disposition_eq]; rfl
            sameDebt := by
              have preserved :=
                acceptedTransfer_preserves_lineage transferReceipt
              change old.lineage = old.lineage
              change old.lineage = old.lineage at preserved
              exact preserved
            kind_generated := by rw [disposition_eq]; rfl
            edge_eq := rfl }
      | .terminal (.superseded receipt) =>
          some {
            slotIndex := slot
            obligation := old
            present := present
            event := event
            kind := .superseded
            generatedTarget := receipt.successor
            targetSlot_eq := by rw [disposition_eq]; rfl
            sameDebt := receipt.sameDebtLineage_successor
            kind_generated := by rw [disposition_eq]; rfl
            edge_eq := rfl }
      | .carry (.progressed ..) => none
      | .carry (.maintained ..) => none
      | .carry (.deferred ..) => none
      | .carry (.narrowed ..) => none
      | .terminal (.final ..) => none
      | .bearerRelease .. => none

/-- The already existing responsibility state indexed by the exact edge. -/
def sourceState {source : ResponsibilityState V} {edge : P.Edge source}
    (_succession : FrameworkSuccessionEdge P edge) : ResponsibilityState V :=
  source

/-- The exact live source slot selected by the process edge. -/
def sourceSlot {source : ResponsibilityState V} {edge : P.Edge source}
    (succession : FrameworkSuccessionEdge P edge) :
    Fin succession.sourceState.slots.length :=
  succession.slotIndex

/-- The old obligation read from the exact live source slot. -/
def oldObligation {source : ResponsibilityState V} {edge : P.Edge source}
    (succession : FrameworkSuccessionEdge P edge) : AdmittedObligation V :=
  succession.obligation

/-- The exact source event read from the stored process boundary event. -/
def sourceEvent {source : ResponsibilityState V} {edge : P.Edge source}
    (succession : FrameworkSuccessionEdge P edge) : V.SourceEvent :=
  P.boundarySource succession.event

/-- The exact process edge.  It is an index, not a reconstructed or
caller-selected transition. -/
def exactEdge {source : ResponsibilityState V} {edge : P.Edge source}
    (_succession : FrameworkSuccessionEdge P edge) : P.Edge source :=
  edge

/-- The live successor obligation generated by the fixed process branch. -/
def nextObligation {source : ResponsibilityState V} {edge : P.Edge source}
    (succession : FrameworkSuccessionEdge P edge) : AdmittedObligation V :=
  succession.generatedTarget

/-- The source slot really contains the old obligation used by the exact
process edge. -/
theorem sourceSlot_contains_old
    {source : ResponsibilityState V} {edge : P.Edge source}
    (succession : FrameworkSuccessionEdge P edge) :
    succession.sourceState.slots.get succession.sourceSlot =
      .live succession.oldObligation :=
  succession.present

/-- The target slot is generated by `P.Edge.target` and contains precisely
the compiler-generated successor obligation. -/
theorem targetSlot_contains_next
    {source : ResponsibilityState V} {edge : P.Edge source}
    (succession : FrameworkSuccessionEdge P edge) :
    succession.exactEdge.target.slots[succession.sourceSlot.val]? =
      some (.live succession.nextObligation) := by
  rcases succession with
    ⟨slotIndex, obligation, present, event, kind, generatedTarget,
      targetSlot_eq, sameDebt, kind_generated, edge_eq⟩
  subst edge
  change
    (NativeResponsibilityProcess.Edge.cross (P := P) slotIndex obligation
      present event).target.slots[slotIndex.val]? =
        some (.live generatedTarget)
  rw [P.cross_target_slot slotIndex obligation present event]
  exact congrArg some targetSlot_eq

/-- The branch kind itself is a readout of the same fixed boundary
disposition. -/
theorem kind_factors_through_boundaryDisposition
    {source : ResponsibilityState V} {edge : P.Edge source}
    (succession : FrameworkSuccessionEdge P edge) :
    FrameworkSuccessionKind.ofDisposition?
      (P.boundaryDisposition succession.event) = some succession.kind :=
  succession.kind_generated

/-- Every compiled succession-shaped branch preserves the exact admitted
debt lineage.  The compiler established this from the accepted-transfer or
supersession theorem in the branch it observed. -/
theorem sameDebtLineage
    {source : ResponsibilityState V} {edge : P.Edge source}
    (succession : FrameworkSuccessionEdge P edge) :
    SameDebtLineage succession.oldObligation succession.nextObligation :=
  succession.sameDebt

/-- Generated old/new bearer pair for transfer-shaped branches.  Supersession
is obligation succession, not silently reclassified as a bearer transfer. -/
def bearerPair? {source : ResponsibilityState V} {edge : P.Edge source}
    (succession : FrameworkSuccessionEdge P edge) :
    Option (V.Bearer × V.Bearer) :=
  match succession.kind with
  | .transferred | .progressedAndTransferred =>
      some (succession.oldObligation.bearer,
        succession.nextObligation.bearer)
  | .superseded => none

/-- The only extra fact required to turn the raw exact-edge classification
into final singleton succession authority. -/
def BearerChanged {source : ResponsibilityState V} {edge : P.Edge source}
    (succession : FrameworkSuccessionEdge P edge) : Prop :=
  match succession.kind with
  | .transferred | .progressedAndTransferred =>
      succession.oldObligation.bearer ≠ succession.nextObligation.bearer
  | .superseded => True

@[simp] theorem bearerPair?_transferred
    {source : ResponsibilityState V} {edge : P.Edge source}
    (succession : FrameworkSuccessionEdge P edge)
    (kind_eq : succession.kind = .transferred) :
    succession.bearerPair? =
      some (succession.oldObligation.bearer,
        succession.nextObligation.bearer) := by
  simp [bearerPair?, kind_eq]

@[simp] theorem bearerPair?_progressedAndTransferred
    {source : ResponsibilityState V} {edge : P.Edge source}
    (succession : FrameworkSuccessionEdge P edge)
    (kind_eq : succession.kind = .progressedAndTransferred) :
    succession.bearerPair? =
      some (succession.oldObligation.bearer,
        succession.nextObligation.bearer) := by
  simp [bearerPair?, kind_eq]

@[simp] theorem bearerPair?_superseded
    {source : ResponsibilityState V} {edge : P.Edge source}
    (succession : FrameworkSuccessionEdge P edge)
    (kind_eq : succession.kind = .superseded) :
    succession.bearerPair? = none := by
  simp [bearerPair?, kind_eq]

end FrameworkSuccessionEdge

/-- Final sealed singleton succession authority.  Transfer-shaped branches
carry the proof that the compiler-generated bearer genuinely changed;
supersession needs no bearer inequality. -/
structure ExactSuccessionAt
    {V : Vocabulary.{u}} (P : NativeResponsibilityProcess V)
    {source : ResponsibilityState V} (edge : P.Edge source) : Type u where
  private mk ::
  authority : FrameworkSuccessionEdge P edge
  bearerChanged : authority.BearerChanged

namespace ExactSuccessionAt

variable {V : Vocabulary.{u}} {P : NativeResponsibilityProcess V}

/-- Premise-free exact succession compiler whenever bearer equality is
decidable.  It first consumes the sealed framework classifier, then filters
only the two transfer branches by their generated old/new bearers. -/
def compile [DecidableEq V.Bearer] {source : ResponsibilityState V}
    (edge : P.Edge source) : Option (ExactSuccessionAt P edge) :=
  match FrameworkSuccessionEdge.compile edge with
  | none => none
  | some succession =>
      match kind_eq : succession.kind with
      | .superseded =>
          some ⟨succession, by
            simp [FrameworkSuccessionEdge.BearerChanged, kind_eq]⟩
      | .transferred =>
          if bearer_eq : succession.oldObligation.bearer =
              succession.nextObligation.bearer then
            none
          else
            some ⟨succession, by
              simpa [FrameworkSuccessionEdge.BearerChanged, kind_eq]
                using bearer_eq⟩
      | .progressedAndTransferred =>
          if bearer_eq : succession.oldObligation.bearer =
              succession.nextObligation.bearer then
            none
          else
            some ⟨succession, by
              simpa [FrameworkSuccessionEdge.BearerChanged, kind_eq]
                using bearer_eq⟩

/-- Exact framework source event selected by the process compiler. -/
def sourceEvent {source : ResponsibilityState V} {edge : P.Edge source}
    (succession : ExactSuccessionAt P edge) : V.SourceEvent :=
  succession.authority.sourceEvent

/-- Exact old obligation readout. -/
def oldObligation {source : ResponsibilityState V} {edge : P.Edge source}
    (succession : ExactSuccessionAt P edge) : AdmittedObligation V :=
  succession.authority.oldObligation

/-- Exact compiler-generated successor obligation readout. -/
def nextObligation {source : ResponsibilityState V} {edge : P.Edge source}
    (succession : ExactSuccessionAt P edge) : AdmittedObligation V :=
  succession.authority.nextObligation

/-- The exact process edge retained by the dependent index. -/
def exactEdge {source : ResponsibilityState V} {edge : P.Edge source}
    (_succession : ExactSuccessionAt P edge) : P.Edge source :=
  edge

/-- Direct lineage consumer for final succession authority. -/
theorem sameDebtLineage
    {source : ResponsibilityState V} {edge : P.Edge source}
    (succession : ExactSuccessionAt P edge) :
    SameDebtLineage succession.oldObligation succession.nextObligation :=
  succession.authority.sameDebtLineage

/-- A generated plain-transfer succession carries a genuine bearer change. -/
theorem transferred_bearerChanged
    {source : ResponsibilityState V} {edge : P.Edge source}
    (succession : ExactSuccessionAt P edge)
    (kind_eq : succession.authority.kind = .transferred) :
    succession.oldObligation.bearer ≠ succession.nextObligation.bearer := by
  have changed := succession.bearerChanged
  unfold FrameworkSuccessionEdge.BearerChanged at changed
  rw [kind_eq] at changed
  exact changed

/-- A generated progress-and-transfer succession also carries a genuine
bearer change. -/
theorem progressedAndTransferred_bearerChanged
    {source : ResponsibilityState V} {edge : P.Edge source}
    (succession : ExactSuccessionAt P edge)
    (kind_eq : succession.authority.kind =
      .progressedAndTransferred) :
    succession.oldObligation.bearer ≠ succession.nextObligation.bearer := by
  have changed := succession.bearerChanged
  unfold FrameworkSuccessionEdge.BearerChanged at changed
  rw [kind_eq] at changed
  exact changed

end ExactSuccessionAt
end Universal
end Lifecycle
end Society
end ProcessGame
end SaturationMonoid
