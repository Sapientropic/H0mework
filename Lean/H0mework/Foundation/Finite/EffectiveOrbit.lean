import Mathlib.Data.Fintype.Pigeonhole

/-!
# Source-generated finite effective orbit disposition

A finite deterministic calculation does not imply that it reaches a desired
terminal.  This kernel follows the source classifier from one actual start and
returns exactly one of two data-bearing outcomes:

* a first terminal together with every generated edge before it; or
* a repeated state together with the complete ordered generated edge segment
  and explicit absence of a terminal along that segment.

The negative branch is a faithful cycle residual.  It is not collapsed to
`False`, and callers do not submit termination, a completed path, or a
residual-zero certificate.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace SourceGeneratedFiniteEffectiveOrbitDisposition

universe u

/-- One source-owned deterministic finite calculation law.  The classifier
chooses either terminal data or one actual outgoing step. -/
structure Law (State : Type u) where
  TerminalAt : State → Type u
  StepAt : State → Type u
  target : {state : State} → StepAt state → State
  classify : (state : State) → TerminalAt state ⊕ StepAt state

namespace Law

variable {State : Type u} (law : Law State)

/-- Terminal states are stationary in the observation orbit; nonterminal
states move to the target generated by the classifier. -/
def next (state : State) : State :=
  match law.classify state with
  | .inl _terminal => state
  | .inr step => law.target step

def stateAt (start : State) (index : Nat) : State :=
  (law.next^[index]) start

@[simp] theorem stateAt_zero (start : State) :
    law.stateAt start 0 = start := by
  rfl

theorem stateAt_succ (start : State) (index : Nat) :
    law.stateAt start (index + 1) = law.next (law.stateAt start index) := by
  simp only [stateAt, Function.iterate_succ_apply']

/-- One edge exactly as returned by the source classifier. -/
structure GeneratedStepAt (state : State) where
  step : law.StepAt state
  classify_eq : law.classify state = .inr step

namespace GeneratedStepAt

variable {law} {state : State}

theorem target_eq_next (generated : law.GeneratedStepAt state) :
    law.target generated.step = law.next state := by
  simp only [Law.next, generated.classify_eq]

end GeneratedStepAt

/-- If the terminal fibre is empty, the source classifier itself supplies the
outgoing edge. -/
def generatedStepOfTerminalEmpty (state : State)
    (terminalEmpty : ¬ Nonempty (law.TerminalAt state)) :
    law.GeneratedStepAt state := by
  cases classify_eq : law.classify state with
  | inl terminal => exact (terminalEmpty ⟨terminal⟩).elim
  | inr step => exact ⟨step, classify_eq⟩

end Law

variable {State : Type u} [Fintype State]

/-- A first terminal reached from the actual start, retaining every generated
edge before the terminal index. -/
structure TerminalTraceAt (law : Law State) (start : State) : Type u where
  index : Nat
  index_le_card : index ≤ Fintype.card State
  terminal : law.TerminalAt (law.stateAt start index)
  beforeTerminalEmpty : ∀ prior, prior < index →
    ¬ Nonempty (law.TerminalAt (law.stateAt start prior))
  edgeAt : ∀ prior, prior < index →
    law.GeneratedStepAt (law.stateAt start prior)

/-- Faithful finite-orbit residual.  `entry < exit` are two visits to the same
state; every visit through `exit` is nonterminal, and every preceding edge is
the edge returned by the source classifier. -/
structure CycleResidualAt (law : Law State) (start : State) : Type u where
  entry : Nat
  exit : Nat
  entry_lt_exit : entry < exit
  exit_le_card : exit ≤ Fintype.card State
  state_eq : law.stateAt start entry = law.stateAt start exit
  terminalEmptyThroughExit : ∀ index, index ≤ exit →
    ¬ Nonempty (law.TerminalAt (law.stateAt start index))
  edgeAt : ∀ index, index < exit →
    law.GeneratedStepAt (law.stateAt start index)

abbrev DispositionAt (law : Law State) (start : State) : Type u :=
  TerminalTraceAt law start ⊕ CycleResidualAt law start

/-- Data wrapper used to extract a pigeonhole collision without eliminating a
`Prop`-valued existential directly into the disposition type. -/
structure OrbitCollisionAt (law : Law State) (start : State) where
  first : Fin (Fintype.card State + 1)
  second : Fin (Fintype.card State + 1)
  first_ne_second : first ≠ second
  state_eq : law.stateAt start first.1 = law.stateAt start second.1

/-- Every source-generated deterministic calculation on a finite effective
carrier reaches a first terminal or returns an explicit ordered cycle
residual.  Finiteness pays only the total disposition, never termination. -/
noncomputable def settle (law : Law State) (start : State) :
    DispositionAt law start := by
  classical
  let terminalWithinCard : Prop :=
    ∃ index, index ≤ Fintype.card State ∧
      Nonempty (law.TerminalAt (law.stateAt start index))
  by_cases hasTerminal : terminalWithinCard
  · let index := Nat.find hasTerminal
    have indexSpec :
        index ≤ Fintype.card State ∧
          Nonempty (law.TerminalAt (law.stateAt start index)) :=
      Nat.find_spec hasTerminal
    have beforeTerminalEmpty : ∀ prior, prior < index →
        ¬ Nonempty (law.TerminalAt (law.stateAt start prior)) := by
      intro prior prior_lt terminal
      exact Nat.find_min hasTerminal prior_lt
        ⟨prior_lt.le.trans indexSpec.1, terminal⟩
    exact .inl
      { index := index
        index_le_card := indexSpec.1
        terminal := Classical.choice indexSpec.2
        beforeTerminalEmpty := beforeTerminalEmpty
        edgeAt := fun prior prior_lt =>
          law.generatedStepOfTerminalEmpty _
            (beforeTerminalEmpty prior prior_lt) }
  · let orbit : Fin (Fintype.card State + 1) → State :=
      fun index => law.stateAt start index.1
    have card_lt :
        Fintype.card State <
          Fintype.card (Fin (Fintype.card State + 1)) := by
      simp
    have collisionNonempty : Nonempty (OrbitCollisionAt law start) := by
      rcases Fintype.exists_ne_map_eq_of_card_lt orbit card_lt with
        ⟨first, second, first_ne_second, state_eq⟩
      exact ⟨⟨first, second, first_ne_second, state_eq⟩⟩
    let collision := Classical.choice collisionNonempty
    let first := collision.first
    let second := collision.second
    have first_ne_second : first ≠ second := collision.first_ne_second
    have state_eq : orbit first = orbit second := collision.state_eq
    have terminalEmptyWithinCard : ∀ index,
        index ≤ Fintype.card State →
          ¬ Nonempty (law.TerminalAt (law.stateAt start index)) := by
      intro index index_le terminal
      exact hasTerminal ⟨index, index_le, terminal⟩
    by_cases first_lt_second : first.1 < second.1
    · exact .inr
        { entry := first.1
          exit := second.1
          entry_lt_exit := first_lt_second
          exit_le_card := by omega
          state_eq := state_eq
          terminalEmptyThroughExit := fun index index_le =>
            terminalEmptyWithinCard index (index_le.trans (by omega))
          edgeAt := fun index index_lt =>
            law.generatedStepOfTerminalEmpty _
              (terminalEmptyWithinCard index (index_lt.le.trans (by omega))) }
    · have second_lt_first : second.1 < first.1 := by
        have values_ne : first.1 ≠ second.1 := by
          intro values_eq
          apply first_ne_second
          exact Fin.ext values_eq
        omega
      exact .inr
        { entry := second.1
          exit := first.1
          entry_lt_exit := second_lt_first
          exit_le_card := by omega
          state_eq := state_eq.symm
          terminalEmptyThroughExit := fun index index_le =>
            terminalEmptyWithinCard index (index_le.trans (by omega))
          edgeAt := fun index index_lt =>
            law.generatedStepOfTerminalEmpty _
              (terminalEmptyWithinCard index (index_lt.le.trans (by omega))) }

end SourceGeneratedFiniteEffectiveOrbitDisposition
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
