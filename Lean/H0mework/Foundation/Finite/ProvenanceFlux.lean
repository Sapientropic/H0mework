import H0mework.Foundation.Finite.EventProcess

/-!
# Occurrence-aware provenance flux for finite event processes

A projected state may return while the actual source occurrence does not.
This kernel lifts every dependent event path to an occurrence whose provenance
is the complete path from one fixed origin.  Event extension strictly raises
provenance depth, so every nonempty projected loop generates an explicit
same-projection, different-occurrence flux.

This is not a termination theorem.  It is the generic deletion test separating
a genuinely closed full-state sector from a finite sector closed only after
forgetting source history.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace SourceGeneratedFiniteEventIndexedProvenanceFlux

open SourceGeneratedFiniteEventIndexedResidualProcess

universe u

/-- Concatenation retains the exact chronological dependent events. -/
def append {P : Process.{u}} {source middle target : P.State}
    (front : GeneratedPathAt P source middle)
    (back : GeneratedPathAt P middle target) :
    GeneratedPathAt P source target :=
  match back with
  | .nil => front
  | .snoc prior event => .snoc (append front prior) event

theorem append_length {P : Process.{u}} {source middle target : P.State}
    (front : GeneratedPathAt P source middle)
    (back : GeneratedPathAt P middle target) :
    (append front back).length = front.length + back.length := by
  induction back with
  | nil => rfl
  | snoc prior event inductionHypothesis =>
      change (append front prior).length + 1 =
        front.length + (prior.length + 1)
      rw [inductionHypothesis]
      omega

theorem path_events_length {P : Process.{u}} {source target : P.State}
    (path : GeneratedPathAt P source target) :
    path.events.length = path.length := by
  induction path with
  | nil => rfl
  | snoc prior event inductionHypothesis =>
      simp only [GeneratedPathAt.events, List.length_append,
        List.length_singleton, GeneratedPathAt.length, inductionHypothesis]

/-- Full occurrence generated by one exact path from a fixed origin. -/
structure OccurrenceAt (P : Process.{u}) (origin : P.State) : Type u where
  private mk ::
  state : P.State
  history : GeneratedPathAt P origin state

def seed (P : Process.{u}) (origin : P.State) : OccurrenceAt P origin :=
  ⟨origin, .nil⟩

def ofPath {P : Process.{u}} {origin target : P.State}
    (path : GeneratedPathAt P origin target) : OccurrenceAt P origin :=
  ⟨target, path⟩

def OccurrenceAt.depth {P : Process.{u}} {origin : P.State}
    (occurrence : OccurrenceAt P origin) : Nat :=
  occurrence.history.length

/-- Order-sensitive effect inventory actually traversed from the origin. -/
def OccurrenceAt.effectInventory {P : Process.{u}} {origin : P.State}
    (occurrence : OccurrenceAt P origin) : List (Sigma P.EventAt) :=
  occurrence.history.events

theorem OccurrenceAt.effectInventory_length
    {P : Process.{u}} {origin : P.State}
    (occurrence : OccurrenceAt P origin) :
    occurrence.effectInventory.length = occurrence.depth :=
  path_events_length occurrence.history

def OccurrenceAt.advance {P : Process.{u}} {origin : P.State}
    (occurrence : OccurrenceAt P origin)
    (event : P.EventAt occurrence.state) : OccurrenceAt P origin :=
  ⟨P.update event, occurrence.history.snoc event⟩

@[simp] theorem seed_depth (P : Process.{u}) (origin : P.State) :
    (seed P origin).depth = 0 :=
  rfl

@[simp] theorem ofPath_depth {P : Process.{u}} {origin target : P.State}
    (path : GeneratedPathAt P origin target) :
    (ofPath path).depth = path.length :=
  rfl

@[simp] theorem advance_depth {P : Process.{u}} {origin : P.State}
    (occurrence : OccurrenceAt P origin)
    (event : P.EventAt occurrence.state) :
    (occurrence.advance event).depth = occurrence.depth + 1 :=
  rfl

theorem advance_depth_strict {P : Process.{u}} {origin : P.State}
    (occurrence : OccurrenceAt P origin)
    (event : P.EventAt occurrence.state) :
    occurrence.depth < (occurrence.advance event).depth := by
  rw [advance_depth]
  omega

theorem advance_ne {P : Process.{u}} {origin : P.State}
    (occurrence : OccurrenceAt P origin)
    (event : P.EventAt occurrence.state) :
    occurrence.advance event ≠ occurrence := by
  intro equality
  have depthEq := congrArg OccurrenceAt.depth equality
  rw [advance_depth] at depthEq
  omega

/-- A nonempty actual path which returns only after forgetting provenance. -/
structure ProjectedReturnFluxAt (P : Process.{u})
    (origin : P.State) : Type u where
  private mk ::
  path : GeneratedPathAt P origin origin
  pathPositive : 0 < path.length
  initial : OccurrenceAt P origin
  initial_eq : initial = seed P origin
  returned : OccurrenceAt P origin
  returned_eq : returned = ofPath path
  projectionReturns : returned.state = initial.state
  depthStrict : initial.depth < returned.depth
  effectInventoryChanged :
    returned.effectInventory ≠ initial.effectInventory
  occurrenceChanged : returned ≠ initial

def generateProjectedReturnFlux {P : Process.{u}} {origin : P.State}
    (path : GeneratedPathAt P origin origin)
    (pathPositive : 0 < path.length) :
    ProjectedReturnFluxAt P origin := by
  let initial := seed P origin
  let returned := ofPath path
  have depthStrict : initial.depth < returned.depth := by
    change 0 < path.length
    exact pathPositive
  exact
    { path := path
      pathPositive := pathPositive
      initial := initial
      initial_eq := rfl
      returned := returned
      returned_eq := rfl
      projectionReturns := rfl
      depthStrict := depthStrict
      effectInventoryChanged := fun inventoryEq => by
        have lengthEq := congrArg List.length inventoryEq
        rw [OccurrenceAt.effectInventory_length,
          OccurrenceAt.effectInventory_length] at lengthEq
        exact (Nat.ne_of_lt depthStrict) lengthEq.symm
      occurrenceChanged := fun equality => by
        have depthEq := congrArg OccurrenceAt.depth equality
        exact (Nat.ne_of_lt depthStrict) depthEq.symm }

/-- Hypothesis that a projected return carries no observable ordered-effect
outflow.  It is separated from projection closure: the projection already
returns by construction. -/
structure NoObservableOutflowAt {P : Process.{u}} {origin : P.State}
    (flux : ProjectedReturnFluxAt P origin) : Prop where
  effectInventory_fixed :
    flux.returned.effectInventory = flux.initial.effectInventory

/-- Every source-generated nonempty projected return rules out the dark
`no-outflow` branch exactly; no terminal or asymptotic premise is used. -/
theorem noObservableOutflow_isEmpty {P : Process.{u}} {origin : P.State}
    (flux : ProjectedReturnFluxAt P origin) :
    IsEmpty (NoObservableOutflowAt flux) :=
  ⟨fun dark => flux.effectInventoryChanged dark.effectInventory_fixed⟩

end SourceGeneratedFiniteEventIndexedProvenanceFlux
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
