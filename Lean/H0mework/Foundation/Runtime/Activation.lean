import H0mework.Foundation.Authority.Representation

/-!
# Canonical activation runtime

The living root process already owns the unique occurrence and successor of
every registered state.  This kernel adds no event family, scheduler, branch
grammar, registry, or fallback.  Runtime activation is the causal occurrence
already emitted at a source-reachable process state.

Repeated Lean evaluation therefore does not create another world event: for
one process/state pair `tick` has one canonical value.  A new activation is
available only at the generated next state.  Finite fuel bounds observation;
it never means terminal.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot

universe u

/-- Reachability inside one fixed living process.  An arbitrary value of the
process state carrier cannot activate itself. -/
inductive SourceNativeRuntimeReachableAt
    {N : WorldRelationNetwork.{u}}
    (process : SourceNativeLivingRootProcess N) :
    process.State → Prop
  | initial : SourceNativeRuntimeReachableAt process process.initial
  | step {state : process.State}
      (prior : SourceNativeRuntimeReachableAt process state) :
      SourceNativeRuntimeReachableAt process (process.successor state)

/-- One source-reachable state of one already complete living process.
The process is a type index, so a coverage proof cannot switch processes after
seeing an authority value.  Construction is sealed to `initial` and `next`. -/
structure LivingRuntimeState
    {N : WorldRelationNetwork.{u}}
    (process : SourceNativeLivingRootProcess N) : Type u where
  private mk ::
  state : process.State
  reachable : SourceNativeRuntimeReachableAt process state

/-- Runtime identity is process state identity.  Reachability is a proposition,
so two derivations of the same reachable state cannot create two activations. -/
@[ext] theorem LivingRuntimeState.ext
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    {left right : LivingRuntimeState process}
    (state_eq : left.state = right.state) : left = right := by
  cases left
  cases right
  cases state_eq
  rfl

/-- Canonical runtime seed of a fixed source process. -/
def LivingRuntimeState.initial
    {N : WorldRelationNetwork.{u}}
    (process : SourceNativeLivingRootProcess N) : LivingRuntimeState process :=
  ⟨process.initial, .initial⟩

/-- The complete living current indexed by this runtime state. -/
def LivingRuntimeState.current
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    (runtime : LivingRuntimeState process) : SourceNativeLivingRootCurrentAt N :=
  process.stateAt runtime.state

/-- The exact source occurrence already emitted at this registered current. -/
def LivingRuntimeState.emittedOccurrence
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    (runtime : LivingRuntimeState process) :=
  runtime.current.root.emitted runtime.current.visit.current

/-- An activated occurrence is the existing canonical process evolution.
There is no wrapper field in which a caller could store another event,
outcome, ledger image, or successor. -/
abbrev ExactActivatedRootOccurrenceAt
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    (runtime : LivingRuntimeState process) : Type (u + 4) :=
  SourceNativeLivingProcessCausalEvolutionAt process
    (ULift.up runtime.state)

/-- Activate the occurrence already emitted by this process/state. -/
def LivingRuntimeState.tick
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    (runtime : LivingRuntimeState process) :
    ExactActivatedRootOccurrenceAt runtime :=
  process.canonicalCausalAnswerAndNext (ULift.up runtime.state)

/-- The next runtime state is available only from the exact activated
occurrence.  Its value is the fixed source successor and inherits the current
reachability proof. -/
def ExactActivatedRootOccurrenceAt.next
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    {runtime : LivingRuntimeState process}
    (_activated : ExactActivatedRootOccurrenceAt runtime) :
    LivingRuntimeState process :=
  ⟨process.successor runtime.state, .step runtime.reachable⟩

/-- Iterate only the successor generated by the exact activated occurrence.
The natural number is observation depth, not a selectable world clock. -/
def LivingRuntimeState.advance
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    (runtime : LivingRuntimeState process) : Nat → LivingRuntimeState process
  | 0 => runtime
  | depth + 1 => (runtime.advance depth).tick.next

/-- `tick` definitionally delegates to the existing canonical successor. -/
@[simp] theorem LivingRuntimeState.tick_nextState_eq
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    (runtime : LivingRuntimeState process) :
    runtime.tick.nextState = (process.successorAt runtime.state).1 :=
  rfl

/-- The exact activated occurrence is the process emitter's existing root
occurrence, not a runtime-local event. -/
@[simp] theorem LivingRuntimeState.tick_occurrence_eq
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    (runtime : LivingRuntimeState process) :
    process.toAnswerNextCausalWorld.emitted (ULift.up runtime.state) =
      ULift.up runtime.tick.generated :=
  rfl

/-- The next current is exactly the one generated by the fixed process. -/
@[simp] theorem LivingRuntimeState.tick_nextCurrent_eq
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    (runtime : LivingRuntimeState process) :
    runtime.tick.nextCurrent =
      process.stateAt (process.successor runtime.state) :=
  rfl

/-- Any lawful token at this process/state is the runtime tick. -/
theorem ExactActivatedRootOccurrenceAt.eq_tick
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    {runtime : LivingRuntimeState process}
    (activated : ExactActivatedRootOccurrenceAt runtime) :
    activated = runtime.tick :=
  activated.eq_canonical

/-- Finite runtime observation directly reuses the existing canonical root
history. -/
def LivingRuntimeState.run
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    (runtime : LivingRuntimeState process)
    (fuel : Nat) :
    SourceNativeLivingRootHistoryAt process fuel runtime.state :=
  process.generateHistory fuel runtime.state

/-- Pure presentation of the branch already generated by the exact whole
ledger.  It has no constructor back into world evolution. -/
inductive LivingRuntimeStructuralKind
  | faithfulTerminal
  | nativeWrite
  | relationWrite
  | continuedTransport
  | borromeanRedirect
  deriving Repr, DecidableEq

/-- Read the structural branch from the activated compiler image. -/
def ExactActivatedRootOccurrenceAt.structuralKind
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    {runtime : LivingRuntimeState process}
    (activated : ExactActivatedRootOccurrenceAt runtime) :
    LivingRuntimeStructuralKind :=
  match activated.generated.wholeLedgerWriteBack with
  | .faithfulTerminal .. => .faithfulTerminal
  | .nativeWrite .. => .nativeWrite
  | .relationWrite .. => .relationWrite
  | .continuedTransport .. => .continuedTransport
  | .borromeanRedirect .. => .borromeanRedirect

/-- Stable machine label for the external finite-run reporter. -/
def LivingRuntimeStructuralKind.label : LivingRuntimeStructuralKind → String
  | .faithfulTerminal => "faithfulTerminal"
  | .nativeWrite => "nativeWrite"
  | .relationWrite => "relationWrite"
  | .continuedTransport => "continuedTransport"
  | .borromeanRedirect => "borromeanRedirect"

/-- Zero observation fuel returns the current state.  It is not a terminal
world disposition. -/
@[simp] theorem LivingRuntimeState.run_zero
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    (runtime : LivingRuntimeState process) :
    runtime.run 0 = .exhausted runtime.state :=
  rfl

/-- One more unit of observation fuel executes exactly one canonical tick and
continues at its generated target. -/
@[simp] theorem LivingRuntimeState.run_succ
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    (runtime : LivingRuntimeState process)
    (fuel : Nat) :
    runtime.run (fuel + 1) =
      .step (process.generateHistory fuel
        (process.successor runtime.state)) :=
  rfl

/-! ## Calculation firewall

An installed projection is a lawful readout, but it is not automatically an
active calculation authority.  A public calculated value must be evaluated
from a private history of exact runtime stages.  Each stage definitionally
exposes the same activated occurrence, whole-ledger write-back and generated
next current.  No completed theorem, equivalence, trace or future current is
stored in the history token.

Lean functions can still close over an unrelated target constant.  That is a
declaration-dependency property rather than a type-theoretic one, and is
checked by `LivingLawMaterialDependencyAuditTool`; the type below closes the
independent admission mouth which previously accepted any installed
projection without a calculation at all. -/

/-- One exact material stage of a running root calculation.  The constructor
is private and carries no payload: all data are dependent readouts of the
indexed runtime tick. -/
structure SourceGeneratedRuntimeMaterialStageAt
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    (runtime : LivingRuntimeState process) : Type (u + 4) where
  private mk ::

/-- The only material stage at a fixed runtime state. -/
def SourceGeneratedRuntimeMaterialStageAt.generate
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    (runtime : LivingRuntimeState process) :
    SourceGeneratedRuntimeMaterialStageAt runtime :=
  .mk

/-- Exact occurrence read from a generated material stage. -/
def SourceGeneratedRuntimeMaterialStageAt.activated
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    {runtime : LivingRuntimeState process}
    (_stage : SourceGeneratedRuntimeMaterialStageAt runtime) :
    ExactActivatedRootOccurrenceAt runtime :=
  runtime.tick

/-- Whole-ledger write-back of the same material stage. -/
def SourceGeneratedRuntimeMaterialStageAt.wholeLedgerWriteBack
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    {runtime : LivingRuntimeState process}
    (stage : SourceGeneratedRuntimeMaterialStageAt runtime) :=
  stage.activated.generated.wholeLedgerWriteBack

/-- Generated next state of the same material stage. -/
def SourceGeneratedRuntimeMaterialStageAt.next
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    {runtime : LivingRuntimeState process}
    (stage : SourceGeneratedRuntimeMaterialStageAt runtime) :
    LivingRuntimeState process :=
  stage.activated.next

/-- A generated material stage is exactly one fixed compiler activation. -/
theorem SourceGeneratedRuntimeMaterialStageAt.factorizes
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    {runtime : LivingRuntimeState process}
    (stage : SourceGeneratedRuntimeMaterialStageAt runtime) :
    process.toAnswerNextCausalWorld.emitted (ULift.up runtime.state) =
        ULift.up stage.activated.generated ∧
      stage.activated.generated.occurrence =
        runtime.current.root.toAuthoritativeRoot.toLedgerRoot.emitted
          runtime.current.visit.current ∧
      HEq stage.wholeLedgerWriteBack
        (runtime.current.root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt
          runtime.current.visit.current) ∧
      stage.next.current = stage.activated.nextCurrent :=
  ⟨rfl, rfl, stage.activated.generated.wholeLedgerWriteBack_eq, rfl⟩

/-- Finite generated material history.  It stores neither stage payloads nor
an output; every visit is reconstructed from the fixed successor chain. -/
structure SourceGeneratedRuntimeMaterialHistoryAt
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    (runtime : LivingRuntimeState process)
    (length : Nat) : Type (u + 4) where
  private mk ::

/-- Generate the unique finite material history at this root current. -/
def SourceGeneratedRuntimeMaterialHistoryAt.generate
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    (runtime : LivingRuntimeState process)
    (length : Nat) : SourceGeneratedRuntimeMaterialHistoryAt runtime length :=
  .mk

/-- Read one exact stage of a generated history. -/
def SourceGeneratedRuntimeMaterialHistoryAt.stageAt
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    {runtime : LivingRuntimeState process}
    {length : Nat}
    (_history : SourceGeneratedRuntimeMaterialHistoryAt runtime length)
    (stage : Fin length) :
    SourceGeneratedRuntimeMaterialStageAt (runtime.advance stage.1) :=
  .generate _

/-- The history target is generated by iterating exact activated next states. -/
def SourceGeneratedRuntimeMaterialHistoryAt.target
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    {runtime : LivingRuntimeState process}
    {length : Nat}
    (_history : SourceGeneratedRuntimeMaterialHistoryAt runtime length) :
    LivingRuntimeState process :=
  runtime.advance length

/-- Re-reading a fixed runtime history cannot select another calculation. -/
theorem SourceGeneratedRuntimeMaterialHistoryAt.eq
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    {runtime : LivingRuntimeState process}
    {length : Nat}
    (left right : SourceGeneratedRuntimeMaterialHistoryAt runtime length) :
    left = right := by
  cases left
  cases right
  rfl

/-- The history target is itself the next exact compiler activation, with its
whole-ledger row and successor already fixed by the same process. -/
theorem SourceGeneratedRuntimeMaterialHistoryAt.target_factorizes
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    {runtime : LivingRuntimeState process}
    {length : Nat}
    (history : SourceGeneratedRuntimeMaterialHistoryAt runtime length) :
    process.toAnswerNextCausalWorld.emitted
        (ULift.up history.target.state) =
        ULift.up history.target.tick.generated ∧
      history.target.tick.generated.occurrence =
        history.target.current.root.toAuthoritativeRoot.toLedgerRoot.emitted
          history.target.current.visit.current ∧
      HEq history.target.tick.generated.wholeLedgerWriteBack
        (history.target.current.root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt
          history.target.current.visit.current) ∧
      history.target.tick.nextCurrent =
        process.stateAt (process.successor history.target.state) :=
  ⟨rfl, rfl, history.target.tick.generated.wholeLedgerWriteBack_eq, rfl⟩

/-- Pure readout of an installed projection at one exact generated stage.

Installation proves provenance of an already existing face, not that its
payload was generated by a material calculation.  There is deliberately no
promotion from this readout into a calculation evaluator or authority token. -/
structure SourceNativeInstalledProjectionReadAt
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    (runtime : LivingRuntimeState process)
    (component : SourceNativeProjectionLaw
      runtime.current.root.toAuthoritativeRoot.toLedgerRoot.source)
    (installation : SourceNativeProjectionLaw.InstallationAt component
      runtime.current.root.toAuthoritativeRoot.source.projectionLaw)
    (projection : component.Projection) : Type (u + 4) where
  private mk ::

/-- Canonical installed-face read.  It has no calculation or authority
constructor. -/
def SourceNativeInstalledProjectionReadAt.generate
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    (runtime : LivingRuntimeState process)
    (component : SourceNativeProjectionLaw
      runtime.current.root.toAuthoritativeRoot.toLedgerRoot.source)
    (installation : SourceNativeProjectionLaw.InstallationAt component
      runtime.current.root.toAuthoritativeRoot.source.projectionLaw)
    (projection : component.Projection) :
    SourceNativeInstalledProjectionReadAt runtime component installation
      projection :=
  .mk

/-- Read the installed payload at the exact current occurrence. -/
def SourceNativeInstalledProjectionReadAt.output
    {N : WorldRelationNetwork.{u}}
    {process : SourceNativeLivingRootProcess N}
    {runtime : LivingRuntimeState process}
    {component : SourceNativeProjectionLaw
      runtime.current.root.toAuthoritativeRoot.toLedgerRoot.source}
    {installation : SourceNativeProjectionLaw.InstallationAt component
      runtime.current.root.toAuthoritativeRoot.source.projectionLaw}
    {projection : component.Projection}
    (_read : SourceNativeInstalledProjectionReadAt runtime component
      installation projection) :
    SourceNativeProjectionFiberAt component projection
      runtime.emittedOccurrence :=
  component.outcomeAt projection runtime.emittedOccurrence


/-! ## Named runtime facade inventory -/

/-- A named runtime facade fixes one process and its complete installed
readout inventory at every reachable runtime state.

This is not another world registry.  `FaceAt` only enumerates coordinates
already installed in each current root; every outcome is read from the exact
runtime occurrence.  Installation alone never promotes the outcome to
calculation authority. -/
structure SourceNativeLivingRuntimeFacade
    (N : WorldRelationNetwork.{u}) : Type (u + 4) where
  process : SourceNativeLivingRootProcess N
  FaceAt : LivingRuntimeState process → Type u
  componentAt : (runtime : LivingRuntimeState process) →
    FaceAt runtime → SourceNativeProjectionLaw
      runtime.current.root.toAuthoritativeRoot.toLedgerRoot.source
  installationAt : (runtime : LivingRuntimeState process) →
    (face : FaceAt runtime) →
      SourceNativeProjectionLaw.InstallationAt
        (componentAt runtime face)
        runtime.current.root.toAuthoritativeRoot.source.projectionLaw
  projectionAt : (runtime : LivingRuntimeState process) →
    (face : FaceAt runtime) → (componentAt runtime face).Projection

/-- The facade's unique source-generated runtime seed. -/
def SourceNativeLivingRuntimeFacade.seed
    {N : WorldRelationNetwork.{u}}
    (facade : SourceNativeLivingRuntimeFacade N) :
    LivingRuntimeState facade.process :=
  .initial facade.process

/-- Named facade readout at one installed coordinate.  This is intentionally
not calculation authority. -/
def SourceNativeLivingRuntimeFacade.readoutAt
    {N : WorldRelationNetwork.{u}}
    (facade : SourceNativeLivingRuntimeFacade N)
    (runtime : LivingRuntimeState facade.process)
    (face : facade.FaceAt runtime) :
    SourceNativeProjectionFiberAt (facade.componentAt runtime face)
      (facade.projectionAt runtime face) runtime.emittedOccurrence :=
  (facade.componentAt runtime face).outcomeAt
    (facade.projectionAt runtime face) runtime.emittedOccurrence

/-- Every face explicitly exported by a named facade is a dependent readout
of the same activated occurrence, whole ledger and generated next.  The
theorem deliberately does not mint calculation authority. -/
theorem SourceNativeLivingRuntimeFacade.readoutAt_factorizes
    {N : WorldRelationNetwork.{u}}
    (facade : SourceNativeLivingRuntimeFacade N)
    (runtime : LivingRuntimeState facade.process)
    (face : facade.FaceAt runtime) :
    facade.process.toAnswerNextCausalWorld.emitted
        (ULift.up runtime.state) = ULift.up runtime.tick.generated ∧
      runtime.tick.generated.occurrence =
        runtime.current.root.toAuthoritativeRoot.toLedgerRoot.emitted
          runtime.current.visit.current ∧
      HEq runtime.tick.generated.wholeLedgerWriteBack
        (runtime.current.root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt
          runtime.current.visit.current) ∧
      HEq (facade.readoutAt runtime face)
        (runtime.tick.generated.projectionOutcome
          ((facade.installationAt runtime face).embed
            (facade.projectionAt runtime face))) ∧
      runtime.tick.nextCurrent =
        facade.process.stateAt (facade.process.successor runtime.state) :=
  ⟨rfl, rfl, runtime.tick.generated.wholeLedgerWriteBack_eq,
    (facade.installationAt runtime face).outcome_heq
      runtime.emittedOccurrence (facade.projectionAt runtime face) |>.symm,
    rfl⟩

/-! ## Free calculation completion

A domain does not submit a material carrier, seed, evaluator, result or target
coordinate.  The named source fixes an exact active material face, the local
laws which every generated stage must satisfy and the stage count.  Strike
can only prove those source-fixed laws.  The unique normal form is the
generated target occurrence itself; domain results remain ordinary dependent
faces of that occurrence. -/

/-- Source-fixed calculation frontier at one exact active face.

`LocalOperationAt` is `Prop`-valued and indexed by the actual source payload and
stage.  It may state the exact local law, but its proof does not select a
Type-valued `Iso`, trace, result coordinate or future state. -/
structure SourceNativeRuntimeCalculationFrontierAt
    {N : WorldRelationNetwork.{u}}
    (facade : SourceNativeLivingRuntimeFacade N)
    (runtime : LivingRuntimeState facade.process)
    (sourceFace : facade.FaceAt runtime) : Type (u + 4) where
  private mk ::
  active : (facade.componentAt runtime sourceFace).ActiveAt
    (facade.projectionAt runtime sourceFace) runtime.emittedOccurrence
  classifier_eq :
    (facade.componentAt runtime sourceFace).classify
        (facade.projectionAt runtime sourceFace)
        runtime.emittedOccurrence = .inl active
  stageCount : Nat
  LocalOperationAt :
    (stage : Fin (stageCount + 1)) →
    (facade.componentAt runtime sourceFace).PayloadAt
      (facade.projectionAt runtime sourceFace)
      runtime.emittedOccurrence active →
    SourceGeneratedRuntimeMaterialStageAt
      (runtime.advance stage.1) → Prop

namespace SourceNativeRuntimeCalculationFrontierAt

variable
    {N : WorldRelationNetwork.{u}}
    {facade : SourceNativeLivingRuntimeFacade N}
    {runtime : LivingRuntimeState facade.process}
    {sourceFace : facade.FaceAt runtime}

/-- A named source installs the complete frontier at once.  This is a raw
build-time specification, not a result or authority constructor. -/
def ofActive
    (active : (facade.componentAt runtime sourceFace).ActiveAt
      (facade.projectionAt runtime sourceFace) runtime.emittedOccurrence)
    (classifier_eq :
      (facade.componentAt runtime sourceFace).classify
          (facade.projectionAt runtime sourceFace)
          runtime.emittedOccurrence = .inl active)
    (stageCount : Nat)
    (LocalOperationAt :
      (stage : Fin (stageCount + 1)) →
      (facade.componentAt runtime sourceFace).PayloadAt
        (facade.projectionAt runtime sourceFace)
        runtime.emittedOccurrence active →
      SourceGeneratedRuntimeMaterialStageAt
        (runtime.advance stage.1) → Prop) :
    SourceNativeRuntimeCalculationFrontierAt
      facade runtime sourceFace :=
  ⟨active, classifier_eq, stageCount, LocalOperationAt⟩

def SourcePayload
    (frontier : SourceNativeRuntimeCalculationFrontierAt
      facade runtime sourceFace) : Type u :=
  (facade.componentAt runtime sourceFace).PayloadAt
    (facade.projectionAt runtime sourceFace)
    runtime.emittedOccurrence frontier.active

def sourcePayload
    (frontier : SourceNativeRuntimeCalculationFrontierAt
      facade runtime sourceFace) : frontier.SourcePayload :=
  (facade.componentAt runtime sourceFace).project
    (facade.projectionAt runtime sourceFace)
    runtime.emittedOccurrence frontier.active

def history
    (frontier : SourceNativeRuntimeCalculationFrontierAt
      facade runtime sourceFace) :
    SourceGeneratedRuntimeMaterialHistoryAt runtime
      (frontier.stageCount + 1) :=
  .generate runtime (frontier.stageCount + 1)

def targetRuntime
    (frontier : SourceNativeRuntimeCalculationFrontierAt
      facade runtime sourceFace) : LivingRuntimeState facade.process :=
  frontier.history.target

theorem readout_eq_active
    (frontier : SourceNativeRuntimeCalculationFrontierAt
      facade runtime sourceFace) :
    facade.readoutAt runtime sourceFace =
      .inl ⟨frontier.active, frontier.sourcePayload⟩ := by
  unfold SourceNativeLivingRuntimeFacade.readoutAt
  unfold SourceNativeProjectionLaw.outcomeAt
  rw [frontier.classifier_eq]
  rfl

end SourceNativeRuntimeCalculationFrontierAt

/-- Proof-only realization of the source-fixed local dynamics.

There is no `Material`, seed, operation carrier, evaluator or output field.
Any data needed by a local operation must already be a dependent coordinate
of its exact generated stage. -/
structure SourceNativeRuntimeCalculationRealizationAt
    {N : WorldRelationNetwork.{u}}
    {facade : SourceNativeLivingRuntimeFacade N}
    {runtime : LivingRuntimeState facade.process}
    {sourceFace : facade.FaceAt runtime}
    (frontier : SourceNativeRuntimeCalculationFrontierAt
      facade runtime sourceFace) : Prop where
  operationAt :
    (stage : Fin (frontier.stageCount + 1)) →
    frontier.LocalOperationAt stage frontier.sourcePayload
      (frontier.history.stageAt stage)

/-- Unique free completion of one realized source calculation.  Its semantic
content lives entirely in the indices: source payload, exact stage history,
local-law proofs and generated target runtime. -/
structure SourceGeneratedRuntimeCalculationNormalFormAt
    {N : WorldRelationNetwork.{u}}
    {facade : SourceNativeLivingRuntimeFacade N}
    {runtime : LivingRuntimeState facade.process}
    {sourceFace : facade.FaceAt runtime}
    {frontier : SourceNativeRuntimeCalculationFrontierAt
      facade runtime sourceFace}
    (realization : SourceNativeRuntimeCalculationRealizationAt frontier) :
    Type (u + 4) where
  private mk ::

namespace SourceGeneratedRuntimeCalculationNormalFormAt

variable
    {N : WorldRelationNetwork.{u}}
    {facade : SourceNativeLivingRuntimeFacade N}
    {runtime : LivingRuntimeState facade.process}
    {sourceFace : facade.FaceAt runtime}
    {frontier : SourceNativeRuntimeCalculationFrontierAt
      facade runtime sourceFace}
    {realization : SourceNativeRuntimeCalculationRealizationAt frontier}

def generate
    (realization : SourceNativeRuntimeCalculationRealizationAt frontier) :
    SourceGeneratedRuntimeCalculationNormalFormAt realization :=
  .mk

theorem unique
    (left right : SourceGeneratedRuntimeCalculationNormalFormAt realization) :
    left = right := by
  cases left
  cases right
  rfl

/-- Different proofs of the same source-fixed local laws cannot create
sibling normal forms.  Proof relevance is erased before any Type-valued
readout is available. -/
theorem unique_over_frontier
    (leftRealization rightRealization :
      SourceNativeRuntimeCalculationRealizationAt frontier)
    (left : SourceGeneratedRuntimeCalculationNormalFormAt leftRealization)
    (right : SourceGeneratedRuntimeCalculationNormalFormAt rightRealization) :
    HEq left right := by
  have realization_eq : leftRealization = rightRealization :=
    Subsingleton.elim _ _
  cases realization_eq
  cases left
  cases right
  rfl

def targetRuntime
    (_normal : SourceGeneratedRuntimeCalculationNormalFormAt realization) :
    LivingRuntimeState facade.process :=
  frontier.targetRuntime

/-- The exact target occurrence, whole-ledger write-back and next factor
through one compiler invocation.  Domain results may only be added later as
ordinary installed faces of this generated occurrence. -/
theorem target_factorizes
    (normal : SourceGeneratedRuntimeCalculationNormalFormAt realization) :
    facade.process.toAnswerNextCausalWorld.emitted
        (ULift.up normal.targetRuntime.state) =
        ULift.up normal.targetRuntime.tick.generated ∧
      normal.targetRuntime.tick.generated.occurrence =
        normal.targetRuntime.current.root.toAuthoritativeRoot.toLedgerRoot.emitted
          normal.targetRuntime.current.visit.current ∧
      HEq normal.targetRuntime.tick.generated.wholeLedgerWriteBack
        (normal.targetRuntime.current.root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt
          normal.targetRuntime.current.visit.current) ∧
      normal.targetRuntime.tick.nextCurrent =
        facade.process.stateAt
          (facade.process.successor normal.targetRuntime.state) :=
  frontier.history.target_factorizes

end SourceGeneratedRuntimeCalculationNormalFormAt

end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
