import H0mework.Foundation.Authority.Representation
import H0mework.Foundation.Authority.EntryDisposition
import H0mework.Foundation.Inquiry.ObstructionLineage

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot

universe u

/-- Effect and operational state emitted by the lower actual event itself.

The callbacks belong to the source law before any root emitter is installed.
The canonical enriched occurrence below stores their values, so two different
effect inventories are two different actual effect occurrences even when they
forget to the same structural event. -/
structure SourceNativeEffectEventVocabulary
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (source : SourceNativeLedgerSource N V) : Type (u + 1) where
  Effect : Type u
  Operational : Type u
  effectAt : {current : V.Current} →
    source.source.toRootSource.actual.OccurrenceAt current → Effect
  operationalAt : {current : V.Current} →
    source.source.toRootSource.actual.OccurrenceAt current → Operational

/-- Exact effect occurrence.

The only stored datum is the lower actual occurrence.  Complete effect and
operational state are definitions of that source event, not values a domain
may submit and later justify by equality fields. -/
structure SourceNativeEffectOccurrenceAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    (eventVocabulary : SourceNativeEffectEventVocabulary source)
    (current : V.Current) : Type u where
  lower : source.source.toRootSource.actual.OccurrenceAt current

namespace SourceNativeEffectOccurrenceAt

/-- Complete effect generated by this exact lower occurrence. -/
def effect
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    {eventVocabulary : SourceNativeEffectEventVocabulary source}
    {current : V.Current}
    (occurrence : SourceNativeEffectOccurrenceAt eventVocabulary current) :
    eventVocabulary.Effect :=
  eventVocabulary.effectAt occurrence.lower

/-- Complete operational scale/time state generated by the same occurrence. -/
def operational
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    {eventVocabulary : SourceNativeEffectEventVocabulary source}
    {current : V.Current}
    (occurrence : SourceNativeEffectOccurrenceAt eventVocabulary current) :
    eventVocabulary.Operational :=
  eventVocabulary.operationalAt occurrence.lower

@[simp] theorem effect_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    {eventVocabulary : SourceNativeEffectEventVocabulary source}
    {current : V.Current}
    (occurrence : SourceNativeEffectOccurrenceAt eventVocabulary current) :
    occurrence.effect = eventVocabulary.effectAt occurrence.lower :=
  rfl

@[simp] theorem operational_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    {eventVocabulary : SourceNativeEffectEventVocabulary source}
    {current : V.Current}
    (occurrence : SourceNativeEffectOccurrenceAt eventVocabulary current) :
    occurrence.operational = eventVocabulary.operationalAt occurrence.lower :=
  rfl

end SourceNativeEffectOccurrenceAt

/-- Canonical source emission of the effect-bearing occurrence. -/
def SourceNativeEffectEventVocabulary.emit
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    (eventVocabulary : SourceNativeEffectEventVocabulary source)
    {current : V.Current}
    (lower : source.source.toRootSource.actual.OccurrenceAt current) :
    SourceNativeEffectOccurrenceAt eventVocabulary current :=
  ⟨lower⟩

/-- Every effect occurrence is literally the canonical enrichment of its
lower source event; there is no submitted effect, scale/time value, or proof
field left for a presentation to vary. -/
theorem SourceNativeEffectOccurrenceAt.eq_emit
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    {eventVocabulary : SourceNativeEffectEventVocabulary source}
    {current : V.Current}
    (occurrence : SourceNativeEffectOccurrenceAt eventVocabulary current) :
    occurrence = eventVocabulary.emit occurrence.lower := by
  cases occurrence
  rfl

/-- Source-owned meaning of one effect face.  Classification, the live row,
and recursive updates consume the exact effect-bearing occurrence; a consumer
cannot attach effect or scale/time values after the structural next exists. -/
structure SourceNativeEffectDynamicalVocabulary
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    (eventVocabulary : SourceNativeEffectEventVocabulary source) : Type (u + 1) where
  ActiveAt : {current : V.Current} →
    SourceNativeEffectOccurrenceAt eventVocabulary current → Type u
  InactiveAt : {current : V.Current} →
    SourceNativeEffectOccurrenceAt eventVocabulary current → Type u
  classify : {current : V.Current} →
    (occurrence : SourceNativeEffectOccurrenceAt eventVocabulary current) →
      ActiveAt occurrence ⊕ InactiveAt occurrence
  effectEntryAt : {current : V.Current} →
    (occurrence : SourceNativeEffectOccurrenceAt eventVocabulary current) →
    ActiveAt occurrence → OpenResponsibilityAt N
      (source.source.toRootSource.account.supportOf occurrence.lower)
  /-- Source-native update of the complete effect.  A domain may later change
  coordinates only through a faithful presentation of this value. -/
  updateEffectAt :
    {current : V.Current} →
    (occurrence : SourceNativeEffectOccurrenceAt eventVocabulary current) →
    (active : ActiveAt occurrence) → eventVocabulary.Effect →
    eventVocabulary.Effect
  /-- Source-native update of the complete operational scale/time state. -/
  updateOperationalAt :
    {current : V.Current} →
    (occurrence : SourceNativeEffectOccurrenceAt eventVocabulary current) →
    (active : ActiveAt occurrence) →
    eventVocabulary.Effect → eventVocabulary.Operational →
    eventVocabulary.Operational

namespace SourceNativeEffectDynamicalVocabulary

/-- Exact finite debit is the budget of the source-generated live incidence.
An effect vocabulary cannot install a second budget or refill it after a
revision. -/
def progressBudgetAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    {eventVocabulary : SourceNativeEffectEventVocabulary source}
    (vocabulary : SourceNativeEffectDynamicalVocabulary eventVocabulary)
    {current : V.Current}
    (occurrence : SourceNativeEffectOccurrenceAt eventVocabulary current)
    (active : vocabulary.ActiveAt occurrence) : Nat :=
  (vocabulary.effectEntryAt occurrence active).progressBudget

end SourceNativeEffectDynamicalVocabulary

/-- Exact generated row of the live incidence carrying an effect. -/
abbrev SourceNativeEffectGeneratedEntryAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    {current : V.Current}
    {occurrence : source.source.toRootSource.actual.OccurrenceAt current}
    (entry : OpenResponsibilityAt N
      (source.source.toRootSource.account.supportOf occurrence)) : Type u :=
  ULift.{u, 0} <|
    SourceNativeFiniteLedgerPatchGeneratedEntryAt source.source
      source.ledgerCompiler.ExactTransitionAt
      source.ledgerCompiler.writeRowSource
      source.ledgerCompiler.terminalRowSource
      (source.ledgerCompiler.compile occurrence)
      (source.ledgerCompiler.compilePatch occurrence) entry

/-- Exact terminal branch selected by the same source compiler. -/
def SourceNativeEffectTerminalAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    {current : V.Current}
    {occurrence : source.source.toRootSource.actual.OccurrenceAt current}
    (generated : SourceNativeLedgerEvolutionAt source.source occurrence)
    (entry : OpenResponsibilityAt N
      (source.source.toRootSource.account.supportOf occurrence)) : Type u :=
  match generated with
  | .faithfulTerminal _terminal _structural_eq ledgerEvolution =>
      { receipt : LedgerEntryTerminalAt N entry //
        receipt = ledgerEvolution.discharge entry }
  | .nativeWrite ..
  | .relationWrite ..
  | .continuedTransport ..
  | .borromeanRedirect .. => PEmpty

/-- Proof that the canonical source-ledger compiler image is continuing.

This carrier deliberately stores no successor data.  A nonterminal compiler
image contributes only `PUnit`; terminal contributes `PEmpty`.  Target current,
target occurrence, and whole-ledger evolution are read directly from the
indexed canonical image below, so an effect law has nowhere to store a sibling
successor. -/
abbrev SourceNativeEffectGeneratedSuccessorAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    {current : V.Current}
    (occurrence : source.source.toRootSource.actual.OccurrenceAt current)
    (generated : SourceNativeLedgerEvolutionAt source.source occurrence) : Type u :=
  SourceNativeLedgerGeneratedSuccessorAt occurrence generated

namespace SourceNativeEffectGeneratedSuccessorAt

/-- Canonical continuing-successor readout of one source ledger compiler
image.  Terminal returns `none`; every other branch returns the unique
zero-information witness that its generated image is continuing. -/
def ofGenerated?
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    {current : V.Current}
    {occurrence : source.source.toRootSource.actual.OccurrenceAt current}
    (generated : SourceNativeLedgerEvolutionAt source.source occurrence) :
    Option (SourceNativeEffectGeneratedSuccessorAt occurrence generated) :=
  match generated with
  | .faithfulTerminal .. => none
  | .nativeWrite ..
  | .relationWrite ..
  | .continuedTransport ..
  | .borromeanRedirect .. => some PUnit.unit

def targetCurrent
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    {current : V.Current}
    {occurrence : source.source.toRootSource.actual.OccurrenceAt current}
    {generated : SourceNativeLedgerEvolutionAt source.source occurrence}
    (_successor : SourceNativeEffectGeneratedSuccessorAt occurrence generated) :
    V.Current :=
  match generated with
  | .nativeWrite write .. => V.nativeTarget write
  | .relationWrite write .. => V.relationTarget write
  | .continuedTransport write .. => V.continuedTarget write
  | .borromeanRedirect write .. => V.redirectTarget write
  | .faithfulTerminal .. => nomatch _successor

def targetOccurrence
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    {current : V.Current}
    {occurrence : source.source.toRootSource.actual.OccurrenceAt current}
    {generated : SourceNativeLedgerEvolutionAt source.source occurrence}
    (successor : SourceNativeEffectGeneratedSuccessorAt occurrence generated) :
    source.source.toRootSource.actual.OccurrenceAt successor.targetCurrent :=
  match generated with
  | .nativeWrite _ _ targetOccurrence _ => targetOccurrence
  | .relationWrite _ _ targetOccurrence _ => targetOccurrence
  | .continuedTransport _ _ targetOccurrence _ => targetOccurrence
  | .borromeanRedirect _ _ targetOccurrence _ => targetOccurrence
  | .faithfulTerminal .. => nomatch successor

def ledgerEvolution
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    {current : V.Current}
    {occurrence : source.source.toRootSource.actual.OccurrenceAt current}
    {generated : SourceNativeLedgerEvolutionAt source.source occurrence}
    (successor : SourceNativeEffectGeneratedSuccessorAt occurrence generated) :
    LedgerWriteEvolutionAt N
      ⟨source.source.toRootSource.account.supportOf occurrence⟩
      ⟨source.source.toRootSource.account.supportOf
        successor.targetOccurrence⟩ :=
  match generated with
  | .nativeWrite _ _ _ ledgerEvolution => ledgerEvolution
  | .relationWrite _ _ _ ledgerEvolution => ledgerEvolution
  | .continuedTransport _ _ _ ledgerEvolution => ledgerEvolution
  | .borromeanRedirect _ _ _ ledgerEvolution => ledgerEvolution
  | .faithfulTerminal .. => nomatch successor

theorem next_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    {current : V.Current}
    {occurrence : source.source.toRootSource.actual.OccurrenceAt current}
    {generated : SourceNativeLedgerEvolutionAt source.source occurrence}
    (successor : SourceNativeEffectGeneratedSuccessorAt occurrence generated) :
    (source.source.toRootSource.actual.compile occurrence).nextCurrent? =
      some successor.targetCurrent := by
  cases generated with
  | nativeWrite _ structural_eq _ _ => rw [structural_eq]; rfl
  | relationWrite _ structural_eq _ _ => rw [structural_eq]; rfl
  | continuedTransport _ structural_eq _ _ => rw [structural_eq]; rfl
  | borromeanRedirect _ structural_eq _ _ => rw [structural_eq]; rfl
  | faithfulTerminal => exact nomatch successor

end SourceNativeEffectGeneratedSuccessorAt

/-- The source effect entry is transported to the exact target effect entry
by the same whole-ledger evolution.  This is kernel-enforced commuting, not a
domain-supplied incidence predicate. -/
structure SourceNativeWholeEffectLedgerTransportAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    {eventVocabulary : SourceNativeEffectEventVocabulary source}
    (D : SourceNativeEffectDynamicalVocabulary eventVocabulary)
    {current : V.Current}
    {occurrence : SourceNativeEffectOccurrenceAt eventVocabulary current}
    {active : D.ActiveAt occurrence}
    {generated : SourceNativeLedgerEvolutionAt source.source occurrence.lower}
    (successor : SourceNativeEffectGeneratedSuccessorAt occurrence.lower generated)
    (targetActive : D.ActiveAt
      (eventVocabulary.emit successor.targetOccurrence)) : Type u where
  targetEntry_eq :
    (successor.ledgerEvolution.destination
      (D.effectEntryAt occurrence active)).1 =
      D.effectEntryAt (eventVocabulary.emit successor.targetOccurrence)
        targetActive

namespace SourceNativeWholeEffectLedgerTransportAt

/-- Re-indexing an effect at the next source-owned carrier cannot refill its
finite progress budget.  This is the exact ledger debit law transported
through the target effect-row identity, not an extra dynamical premise. -/
theorem progressBudget_not_refilled
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    {eventVocabulary : SourceNativeEffectEventVocabulary source}
    {D : SourceNativeEffectDynamicalVocabulary eventVocabulary}
    {current : V.Current}
    {occurrence : SourceNativeEffectOccurrenceAt eventVocabulary current}
    {active : D.ActiveAt occurrence}
    {generated : SourceNativeLedgerEvolutionAt source.source occurrence.lower}
    {successor : SourceNativeEffectGeneratedSuccessorAt
      occurrence.lower generated}
    {targetActive : D.ActiveAt
      (eventVocabulary.emit successor.targetOccurrence)}
    (transport : SourceNativeWholeEffectLedgerTransportAt
      (active := active) D successor targetActive) :
    D.progressBudgetAt
        (eventVocabulary.emit successor.targetOccurrence) targetActive <=
      D.progressBudgetAt occurrence active := by
  have budget :=
    (successor.ledgerEvolution.destination
      (D.effectEntryAt occurrence active)).2.progressBudget_not_refilled
  rw [transport.targetEntry_eq] at budget
  exact budget

end SourceNativeWholeEffectLedgerTransportAt

/-- Kernel-owned progress classification for one recursively generated
effect step.  Either the complete effect changes, the complete operational
scale/time state changes, or the exact source-owned budget strictly drops.
There is no domain-defined `ProgressAt` label in this mouth. -/
inductive SourceNativeRecursiveEffectProgressAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    {eventVocabulary : SourceNativeEffectEventVocabulary source}
    (D : SourceNativeEffectDynamicalVocabulary eventVocabulary)
    {current targetCurrent : V.Current}
    (occurrence : SourceNativeEffectOccurrenceAt eventVocabulary current)
    (active : D.ActiveAt occurrence)
    (targetOccurrence : SourceNativeEffectOccurrenceAt
      eventVocabulary targetCurrent)
    (targetActive : D.ActiveAt targetOccurrence) : Type u
  | effectChanged
      (changed : occurrence.effect = targetOccurrence.effect → False)
  | operationalChanged
      (changed : occurrence.operational = targetOccurrence.operational → False)
  | debited
      (strictDebit : D.progressBudgetAt targetOccurrence targetActive <
        D.progressBudgetAt occurrence active)

/-- The effect cut and the U7 compiler expose one exact whole-ledger row
disposition.  Source-entry identity is carried separately by the cut
constructor's `demandEntry_eq`. -/
def SourceNativeEffectU7CutCommutesAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    {eventVocabulary : SourceNativeEffectEventVocabulary source}
    (D : SourceNativeEffectDynamicalVocabulary eventVocabulary)
    {U7 : U7ProducerCalculus N}
    (calculus : U7ObstructionEvolutionCalculus N U7)
    {current : V.Current}
    {occurrence : SourceNativeEffectOccurrenceAt eventVocabulary current}
    {active : D.ActiveAt occurrence}
    {generated : SourceNativeLedgerEvolutionAt source.source occurrence.lower}
    (successor : SourceNativeEffectGeneratedSuccessorAt occurrence.lower generated)
    (obstruction : N.ObstructionAt
      (source.source.toRootSource.account.supportOf occurrence.lower)) : Prop :=
  HEq
    (LedgerEntryDispositionAt.evolved
      (successor.ledgerEvolution.destination
        (D.effectEntryAt occurrence active)).2)
    (calculus.generated obstruction).2.entryDisposition

/-- Exhaustive source-generated disposition of one actual effect. -/
inductive SourceNativeEffectDynamicalDispositionAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    {eventVocabulary : SourceNativeEffectEventVocabulary source}
    (D : SourceNativeEffectDynamicalVocabulary eventVocabulary)
    {U7 : U7ProducerCalculus N}
    (calculus : U7ObstructionEvolutionCalculus N U7)
    {current : V.Current}
    (occurrence : SourceNativeEffectOccurrenceAt eventVocabulary current)
    (active : D.ActiveAt occurrence)
    (generated : SourceNativeLedgerEvolutionAt source.source occurrence.lower) : Type u
  | settled
      (terminal : SourceNativeEffectTerminalAt generated
        (D.effectEntryAt occurrence active))
  | next
      (row : SourceNativeEffectGeneratedEntryAt
        (occurrence := occurrence.lower)
        (D.effectEntryAt occurrence active))
      (successor : SourceNativeEffectGeneratedSuccessorAt occurrence.lower generated)
      (targetActive : D.ActiveAt
        (eventVocabulary.emit successor.targetOccurrence))
      (target_classify_eq :
        D.classify (eventVocabulary.emit successor.targetOccurrence) =
        .inl targetActive)
      (ledgerTransport : SourceNativeWholeEffectLedgerTransportAt
        (active := active) D successor targetActive)
      (effect_commutes : D.updateEffectAt occurrence active occurrence.effect =
        (eventVocabulary.emit successor.targetOccurrence).effect)
      (operational_commutes : D.updateOperationalAt occurrence active
        occurrence.effect occurrence.operational =
        (eventVocabulary.emit successor.targetOccurrence).operational)
      (progress : SourceNativeRecursiveEffectProgressAt D occurrence active
        (eventVocabulary.emit successor.targetOccurrence) targetActive)
  | cut
      (row : SourceNativeEffectGeneratedEntryAt
        (occurrence := occurrence.lower)
        (D.effectEntryAt occurrence active))
      (successor : SourceNativeEffectGeneratedSuccessorAt occurrence.lower generated)
      (obstruction : N.ObstructionAt
        (source.source.toRootSource.account.supportOf occurrence.lower))
      (demandEntry_eq :
        U7ActualSuccessorSource.demandEntry
            (calculus.generated obstruction).1 =
          D.effectEntryAt occurrence active)
      (disposition_commutes : SourceNativeEffectU7CutCommutesAt
        (active := active) D calculus successor obstruction)

/-- The complete effect law is fixed in the source before any root emitter.
Its generator is indexed directly by the canonical whole-ledger compiler image
of the same occurrence; it cannot classify an already chosen successor. -/
structure SourceNativeEffectDynamicalClosureLaw
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (source : SourceNativeLedgerSource N V) : Type (u + 1) where
  private mk ::
  U7 : U7ProducerCalculus N
  calculus : U7ObstructionEvolutionCalculus N U7
  eventVocabulary : SourceNativeEffectEventVocabulary source
  vocabulary : SourceNativeEffectDynamicalVocabulary eventVocabulary
  private generate : {current : V.Current} →
    (occurrence : SourceNativeEffectOccurrenceAt eventVocabulary current) →
    (active : vocabulary.ActiveAt occurrence) →
      SourceNativeEffectDynamicalDispositionAt vocabulary calculus occurrence
        active (source.ledgerCompiler.compile occurrence.lower)

/-- Seal the recursive effect generator into the source law before a root
emitter is installed.  The generator receives no caller-selected successor or
incidence predicate: its result is indexed by `source.ledgerCompiler.compile`. -/
def SourceNativeEffectDynamicalClosureLaw.create
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    (U7 : U7ProducerCalculus N)
    (calculus : U7ObstructionEvolutionCalculus N U7)
    (eventVocabulary : SourceNativeEffectEventVocabulary source)
    (vocabulary : SourceNativeEffectDynamicalVocabulary eventVocabulary)
    (generate : {current : V.Current} →
      (occurrence : SourceNativeEffectOccurrenceAt eventVocabulary current) →
      (active : vocabulary.ActiveAt occurrence) →
        SourceNativeEffectDynamicalDispositionAt vocabulary calculus occurrence
          active (source.ledgerCompiler.compile occurrence.lower)) :
    SourceNativeEffectDynamicalClosureLaw source :=
  ⟨U7, calculus, eventVocabulary, vocabulary, generate⟩

/-- One occurrence-local effect and its generated disposition. -/
abbrev SourceNativeGeneratedEffectDynamicalClosureAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    (law : SourceNativeEffectDynamicalClosureLaw source)
    {current : V.Current}
    (occurrence : source.source.toRootSource.actual.OccurrenceAt current)
    (active : law.vocabulary.ActiveAt
      (law.eventVocabulary.emit occurrence)) : Type u :=
  SourceNativeEffectDynamicalDispositionAt law.vocabulary law.calculus
    (law.eventVocabulary.emit occurrence) active
      (source.ledgerCompiler.compile occurrence)

/-- Canonical projection readout for consumers that only need the installed
effect coordinate.  It adds no outcome compiler: the payload is still indexed
by the source generator's canonical ledger image. -/
def SourceNativeEffectDynamicalClosureLaw.toProjectionLaw
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeLedgerSource N V}
    (law : SourceNativeEffectDynamicalClosureLaw source) :
    SourceNativeProjectionLaw source where
  Projection := PUnit
  ActiveAt := fun _ {_current} occurrence =>
    law.vocabulary.ActiveAt (law.eventVocabulary.emit occurrence)
  InactiveAt := fun _ {_current} occurrence =>
    law.vocabulary.InactiveAt (law.eventVocabulary.emit occurrence)
  classify := fun _ {_current} occurrence =>
    law.vocabulary.classify (law.eventVocabulary.emit occurrence)
  PayloadAt := fun _ {_current} occurrence active =>
    SourceNativeGeneratedEffectDynamicalClosureAt law occurrence active
  project := by
    intro _ current occurrence active
    change SourceNativeEffectDynamicalDispositionAt law.vocabulary law.calculus
      (law.eventVocabulary.emit occurrence) active
        (source.ledgerCompiler.compile occurrence)
    simpa only [SourceNativeEffectEventVocabulary.emit] using
      law.generate (law.eventVocabulary.emit occurrence) active

/-- Canonical visibility uplift which installs one effect-dynamical coordinate
without erasing the existing source inventory.  This constructs the complete
authority-source identity before emission; it is not a post-hoc annotation on
an already authoritative root. -/
inductive SourceNativeEffectDynamicalProjection (Base : Type u) : Type u
  | dynamical
  | inherited (projection : Base)

def SourceNativeEffectDynamicalClosureLaw.toAuthoritySource
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (base : SourceNativeAuthoritySource N V)
    (law : SourceNativeEffectDynamicalClosureLaw
      base.restructuringSource.toLedgerSource) :
    SourceNativeAuthoritySource N V where
  restructuringSource := base.restructuringSource
  eventInventoryAdmission := base.eventInventoryAdmission
  lawSurface := base.lawSurface
  projectionLaw :=
    { Projection := SourceNativeEffectDynamicalProjection
        base.projectionLaw.Projection
      ActiveAt := fun projection {_current} occurrence =>
        match projection with
        | .dynamical =>
            law.vocabulary.ActiveAt (law.eventVocabulary.emit occurrence)
        | .inherited inherited =>
            base.projectionLaw.ActiveAt inherited occurrence
      InactiveAt := fun projection {_current} occurrence =>
        match projection with
        | .dynamical =>
            law.vocabulary.InactiveAt (law.eventVocabulary.emit occurrence)
        | .inherited inherited =>
            base.projectionLaw.InactiveAt inherited occurrence
      classify := by
        intro projection current occurrence
        cases projection with
        | dynamical =>
            exact law.vocabulary.classify (law.eventVocabulary.emit occurrence)
        | inherited inherited =>
            exact base.projectionLaw.classify inherited occurrence
      PayloadAt := fun projection {_current} occurrence active =>
        match projection with
        | .dynamical =>
            SourceNativeGeneratedEffectDynamicalClosureAt law occurrence active
        | .inherited inherited =>
            base.projectionLaw.PayloadAt inherited occurrence active
      project := by
        intro projection current occurrence active
        cases projection with
        | dynamical =>
            change SourceNativeEffectDynamicalDispositionAt law.vocabulary law.calculus
              (law.eventVocabulary.emit occurrence) active
                (base.restructuringSource.toLedgerSource.ledgerCompiler.compile occurrence)
            simpa only [SourceNativeEffectEventVocabulary.emit] using
              law.generate (law.eventVocabulary.emit occurrence) active
        | inherited inherited =>
            exact base.projectionLaw.project inherited occurrence active }

/-- Installing a recursive-effect coordinate preserves every coordinate of
the existing source inventory.  This is a derived coface inclusion, not a
second authority source or a post-emission bridge. -/
def SourceNativeProjectionLaw.InstallationAt.inheritedByEffectDynamical
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (base : SourceNativeAuthoritySource N V)
    (law : SourceNativeEffectDynamicalClosureLaw
      base.restructuringSource.toLedgerSource) :
    SourceNativeProjectionLaw.InstallationAt base.projectionLaw
      (law.toAuthoritySource base).projectionLaw where
  embed := SourceNativeEffectDynamicalProjection.inherited
  embed_injective := by
    intro left right equality
    injection equality
  outcome_heq := by
    intro current occurrence projection
    dsimp only [SourceNativeProjectionLaw.outcomeAt,
      SourceNativeEffectDynamicalClosureLaw.toAuthoritySource]
    cases base.projectionLaw.classify projection occurrence <;> rfl

/-- The recursive-effect coordinate itself is a faithful component of the
canonical visibility uplift.  Legacy roots produced by `toAuthoritySource`
use this adapter; a root may also install the same component directly in its
complete source inventory. -/
def SourceNativeProjectionLaw.InstallationAt.effectDynamicalComponent
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (base : SourceNativeAuthoritySource N V)
    (law : SourceNativeEffectDynamicalClosureLaw
      base.restructuringSource.toLedgerSource) :
    SourceNativeProjectionLaw.InstallationAt law.toProjectionLaw
      (law.toAuthoritySource base).projectionLaw where
  embed := fun _ => SourceNativeEffectDynamicalProjection.dynamical
  embed_injective := by
    intro left right _
    cases left
    cases right
    rfl
  outcome_heq := by
    intro current occurrence projection
    cases projection
    dsimp only [SourceNativeProjectionLaw.outcomeAt,
      SourceNativeEffectDynamicalClosureLaw.toAuthoritySource,
      SourceNativeEffectDynamicalClosureLaw.toProjectionLaw]
    cases law.vocabulary.classify (law.eventVocabulary.emit occurrence) <;> rfl

/-! ## Registered effect authority

The source projection above remains an occurrence-local readout.  Operational
authority begins only after the whole effect inventory is recognized as an
installed coface of one fixed living root and evaluated at an exact temporal
visit. -/

/-- Recognition that one fixed living root was born with this recursive
effect law in its complete pre-emitter source inventory. -/
structure SourceNativeEffectDynamicalRecognitionAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (root : SourceNativeLivingRootClosure N V) : Type (u + 2) where
  effectLaw : SourceNativeEffectDynamicalClosureLaw
    root.toAuthoritativeRoot.toLedgerRoot.source
  installation : SourceNativeProjectionLaw.InstallationAt
    effectLaw.toProjectionLaw
    root.toAuthoritativeRoot.source.projectionLaw

namespace SourceNativeEffectDynamicalRecognitionAt

/-- Exact root coordinate occupied by the installed recursive-effect face. -/
def rootEffectProjection
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
  (recognition : SourceNativeEffectDynamicalRecognitionAt root) :
    root.toAuthoritativeRoot.source.projectionLaw.Projection :=
  recognition.installation.embed PUnit.unit

/-- Exact source component installed at the recursive-effect root coordinate. -/
def effectComponent
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
  (recognition : SourceNativeEffectDynamicalRecognitionAt root) :
    SourceNativeProjectionLaw root.toAuthoritativeRoot.toLedgerRoot.source :=
  recognition.effectLaw.toProjectionLaw

/-- Effect-facing spelling of the shared full-living-source causal authority.
The recognition selects a face, but authority identity is the complete root;
all installed faces at that root consume the same live ledger. -/
abbrev CausalEntryAuthorityAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    (_recognition : SourceNativeEffectDynamicalRecognitionAt root)
    (visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot)
    (entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))) : Type (u + 1) :=
  SourceNativeLivingTemporalCausalEntryAuthorityAt root visit entry

namespace CausalEntryAuthorityAt

/-- Generate source-sealed effect authority from the fixed root's initial
admission and its canonical finite history.  No already-wrapped ledger
authority is accepted at this mouth. -/
def generatedFromInitial?
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    (recognition : SourceNativeEffectDynamicalRecognitionAt root)
    (initialEntry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted root.toAuthoritativeRoot.toRoot.source.initial))) :
    {current : V.Current} →
    (history : root.toAuthoritativeRoot.toRoot.ReachableAt current) →
      Option (Sigma fun entry : OpenResponsibilityAt N
          (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
            (root.emitted current)) =>
        recognition.CausalEntryAuthorityAt (.finite ⟨current, history⟩) entry) := by
  exact SourceNativeLivingTemporalCausalEntryAuthorityAt.generatedFromInitial?
    root initialEntry

/-- Generate source-sealed effect authority at an exact cofinal admission.
The row must be selected by the cofinal occurrence's own finite patch; whole
ledger membership alone cannot create the admission. -/
def generatedFromCofinal?
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    (recognition : SourceNativeEffectDynamicalRecognitionAt root)
    (visit : SourceNativeCofinalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot)
    (entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))) :
    Option (recognition.CausalEntryAuthorityAt (.cofinal visit) entry) :=
  SourceNativeLivingTemporalCausalEntryAuthorityAt.generatedFromCofinal?
    root visit entry

/-- Preserve the complete effect-source identity through the same canonical
whole-ledger successor that carries the responsibility entry. -/
def next
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeEffectDynamicalRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {entry : OpenResponsibilityAt N
      (root.toAuthoritativeRoot.toLedgerRoot.source.source.toRootSource.account.supportOf
        (root.emitted visit.current))}
    (authority : recognition.CausalEntryAuthorityAt visit entry)
    {next : V.Current}
    (next_eq :
      (root.toAuthoritativeRoot.toRoot.evolutionAt visit.current).nextCurrent? =
        some next) :
    recognition.CausalEntryAuthorityAt (visit.next next_eq)
      (root.toAuthoritativeRoot.toLedgerRoot.canonicalTargetEntryAtNext
        next_eq entry) :=
  SourceNativeLivingTemporalCausalEntryAuthorityAt.next authority next_eq

end CausalEntryAuthorityAt

/-- Active recursive-effect authority at one exact temporal visit.

The source classifier fixes the active token, while `sourceAuthority` proves
that its effect entry already belongs to the unified causal ledger.  Thus an
occurrence-local payload cannot become authority by temporal relabelling. -/
structure RootedActiveOutcomeAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    (recognition : SourceNativeEffectDynamicalRecognitionAt root)
    (visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot) : Type (u + 1) where
  private mk ::
  active : recognition.effectLaw.vocabulary.ActiveAt
    (recognition.effectLaw.eventVocabulary.emit
      (root.emitted visit.current))
  private classify_eq :
    recognition.effectLaw.vocabulary.classify
        (recognition.effectLaw.eventVocabulary.emit
          (root.emitted visit.current)) = .inl active
  sourceAuthority : recognition.CausalEntryAuthorityAt visit
    (recognition.effectLaw.vocabulary.effectEntryAt
      (recognition.effectLaw.eventVocabulary.emit
        (root.emitted visit.current)) active)

namespace RootedActiveOutcomeAt

/-- Canonical source payload at the registered active coordinate. -/
def payload
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeEffectDynamicalRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (registered : recognition.RootedActiveOutcomeAt visit) :
    SourceNativeGeneratedEffectDynamicalClosureAt recognition.effectLaw
      (root.emitted visit.current) registered.active :=
  recognition.effectComponent.project
    PUnit.unit
    (root.emitted visit.current) registered.active

/-- Active source fibre installed at the exact root occurrence. -/
def installedFiber
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeEffectDynamicalRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (registered : recognition.RootedActiveOutcomeAt visit) :
    SourceNativeProjectionFiberAt recognition.effectComponent
      PUnit.unit
      (root.emitted visit.current) :=
  .inl ⟨registered.active, registered.payload⟩

theorem componentOutcome_eq_installedFiber
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeEffectDynamicalRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (registered : recognition.RootedActiveOutcomeAt visit) :
    recognition.effectComponent.outcomeAt
        PUnit.unit
        (root.emitted visit.current) = registered.installedFiber := by
  unfold SourceNativeProjectionLaw.outcomeAt installedFiber
  have classify_eq : recognition.effectComponent.classify
      PUnit.unit
      (root.emitted visit.current) = .inl registered.active :=
    registered.classify_eq
  rw [classify_eq]
  rfl

/-- The source classifier fixes the active witness at one exact temporal
visit.  Proof-relevant inhabitants of `ActiveAt` cannot select different
recursive-effect outcomes after the root occurrence has been fixed. -/
theorem active_eq_of_same_visit
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeEffectDynamicalRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (left right : recognition.RootedActiveOutcomeAt visit) :
    left.active = right.active := by
  exact SourceNativeProjectionLaw.active_eq_of_classify_eq
    recognition.effectComponent
    (projection := PUnit.unit)
    (occurrence := root.emitted visit.current)
    left.classify_eq right.classify_eq

/-- Two lawful registrations of one installed effect face expose the same
complete source-generated projection fibre. -/
theorem installedFiber_eq_of_same_visit
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeEffectDynamicalRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (left right : recognition.RootedActiveOutcomeAt visit) :
    left.installedFiber = right.installedFiber :=
  left.componentOutcome_eq_installedFiber.symm.trans
    right.componentOutcome_eq_installedFiber

/-- Immediate outcome detector for the recursive-effect mouth.  At fixed
source, recognition, and temporal visit, a caller cannot vary settlement,
successor, effect update, operational update, or U7 cut by submitting another
active witness. -/
theorem payload_heq_of_same_visit
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeEffectDynamicalRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (left right : recognition.RootedActiveOutcomeAt visit) :
    HEq left.payload right.payload := by
  exact SourceNativeProjectionLaw.project_heq_of_classify_eq
    recognition.effectComponent
    (projection := PUnit.unit)
    (occurrence := root.emitted visit.current)
    left.classify_eq right.classify_eq

end RootedActiveOutcomeAt

end SourceNativeEffectDynamicalRecognitionAt

/-- Register the active fibre of an installed recursive-effect coordinate
after the same temporal visit already carries its causal entry authority. -/
def SourceNativeEffectDynamicalRecognitionAt.generatedRootedActiveAtVisit
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    (recognition : SourceNativeEffectDynamicalRecognitionAt root)
    (visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot)
    (active : recognition.effectLaw.vocabulary.ActiveAt
      (recognition.effectLaw.eventVocabulary.emit
        (root.emitted visit.current)))
    (classify_eq : recognition.effectLaw.vocabulary.classify
        (recognition.effectLaw.eventVocabulary.emit
          (root.emitted visit.current)) = .inl active)
    (sourceAuthority : recognition.CausalEntryAuthorityAt visit
      (recognition.effectLaw.vocabulary.effectEntryAt
        (recognition.effectLaw.eventVocabulary.emit
          (root.emitted visit.current)) active)) :
    recognition.RootedActiveOutcomeAt visit :=
  ⟨active, classify_eq, sourceAuthority⟩

namespace SourceNativeEffectDynamicalRecognitionAt
namespace RootedActiveOutcomeAt

/-- The rooted recursive-effect payload, exact temporal occurrence, whole
ledger, and living successor are one compiler image. -/
theorem installedAuthority_factorizes
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeEffectDynamicalRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (registered : recognition.RootedActiveOutcomeAt visit) :
    let evolution := root.canonicalCausalAnswerAndNext (ULift.up visit)
    evolution.generated =
        root.toAuthoritativeRoot.toLedgerRoot.generatedAtTemporalVisit visit ∧
      HEq (evolution.generated.projectionOutcome
          recognition.rootEffectProjection)
        registered.installedFiber ∧
      evolution.nextCurrent = root.generatedNextCurrentAt visit := by
  dsimp only
  have factorization :=
    (root.canonicalCausalAnswerAndNext
      (ULift.up visit)).installedSubsystemAuthority_factorizes
        recognition.installation
        PUnit.unit
  exact ⟨factorization.1,
    factorization.2.1.trans (heq_of_eq registered.componentOutcome_eq_installedFiber),
    factorization.2.2⟩

/-- Type-valued causal continuation generated for an active effect next or
cut branch. -/
structure CausalSuccessorAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeEffectDynamicalRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (registered : recognition.RootedActiveOutcomeAt visit) : Type (u + 1) where
  private mk ::
  successor : CausalEntrySuccessorAt
    root.toAuthoritativeRoot.toLedgerRoot visit
    (recognition.effectLaw.vocabulary.effectEntryAt
      (recognition.effectLaw.eventVocabulary.emit
        (root.emitted visit.current)) registered.active)

namespace CausalSuccessorAt

/-- The effect successor consumes the existing source authority and produces
the exact target authority in the same temporal grammar. -/
def targetAuthority
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeEffectDynamicalRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    {registered : recognition.RootedActiveOutcomeAt visit}
    (causal : registered.CausalSuccessorAt) :
    recognition.CausalEntryAuthorityAt causal.successor.targetVisit
      causal.successor.targetEntry :=
  SourceNativeLivingTemporalCausalEntryAuthorityAt.next
    registered.sourceAuthority causal.successor.next_eq

end CausalSuccessorAt

/-- A cut is not a parallel obstruction receipt.  It jointly carries the
root causal successor and causal authority for the exact U7 demand generated
from the same effect row. -/
def CausalCutClosureAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeEffectDynamicalRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (registered : recognition.RootedActiveOutcomeAt visit) : Type (u + 1) :=
  match registered.payload with
  | .cut _row _successor obstruction _demandEntry_eq
      _disposition_commutes =>
      Sigma fun _causal : registered.CausalSuccessorAt =>
        recognition.CausalEntryAuthorityAt visit
          (U7ActualSuccessorSource.demandEntry
            (recognition.effectLaw.calculus.generated obstruction).1)
  | .settled .. | .next .. => PEmpty

/-- Lifecycle closure of one rooted active effect payload.  Settlement closes
the current row; next generates the root causal successor; cut additionally
registers the exact U7 demand in that same causal ledger. -/
def CausalClosureAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeEffectDynamicalRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (registered : recognition.RootedActiveOutcomeAt visit) : Type (u + 1) :=
  match registered.payload with
  | .settled .. => PUnit
  | .next .. => registered.CausalSuccessorAt
  | .cut .. => registered.CausalCutClosureAt

private def causalSuccessorAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeEffectDynamicalRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (registered : recognition.RootedActiveOutcomeAt visit)
    (successor : SourceNativeEffectGeneratedSuccessorAt
      (root.toAuthoritativeRoot.toLedgerRoot.emitted visit.current)
      (root.toAuthoritativeRoot.toLedgerRoot.generatedLedgerAt visit.current)) :
    registered.CausalSuccessorAt := by
  let causal :=
    CausalEntrySuccessorAt.ofNonterminal (entry :=
      recognition.effectLaw.vocabulary.effectEntryAt
        (recognition.effectLaw.eventVocabulary.emit
          (root.emitted visit.current)) registered.active) successor.next_eq
  exact ⟨causal⟩

/-- Generate lifecycle closure directly from the registered source payload. -/
def generatedCausalClosure
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {root : SourceNativeLivingRootClosure N V}
    {recognition : SourceNativeEffectDynamicalRecognitionAt root}
    {visit : SourceNativeTemporalVisitAt
      root.toAuthoritativeRoot.toLedgerRoot}
    (registered : recognition.RootedActiveOutcomeAt visit) :
    registered.CausalClosureAt := by
  unfold CausalClosureAt
  cases payload_eq : registered.payload with
  | settled => exact PUnit.unit
  | next row successor targetActive target_classify_eq ledgerTransport
      effect_commutes operational_commutes progress =>
      apply registered.causalSuccessorAt successor
  | cut row successor obstruction demandEntry_eq disposition_commutes =>
      let causal := registered.causalSuccessorAt successor
      have u7Authority : recognition.CausalEntryAuthorityAt visit
          (U7ActualSuccessorSource.demandEntry
            (recognition.effectLaw.calculus.generated obstruction).1) :=
        demandEntry_eq.symm ▸ registered.sourceAuthority
      have closure :
          Sigma fun _causal : registered.CausalSuccessorAt =>
            recognition.CausalEntryAuthorityAt visit
              (U7ActualSuccessorSource.demandEntry
                (recognition.effectLaw.calculus.generated obstruction).1) :=
        ⟨causal, u7Authority⟩
      simpa only [CausalCutClosureAt, payload_eq] using closure

end RootedActiveOutcomeAt

end SourceNativeEffectDynamicalRecognitionAt

end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
