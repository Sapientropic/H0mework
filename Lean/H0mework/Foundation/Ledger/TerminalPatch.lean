import H0mework.Foundation.Ledger.TransportedRemainder

/-!
# Generated terminal patches

Combines legacy finite terminal rows with one source-generated support settlement.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot

universe u

/-- Source-fixed support-settlement compiler.  One occurrence produces the
single support receipt which can discharge every row in that support. -/
structure LedgerSupportSettlementSourceAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (source : SourceNativeSource N V) : Type (u + 1) where
  OccurrenceAt :
    {current : V.Current} →
      (occurrence : source.toRootSource.actual.OccurrenceAt current) → Type u
  emit? :
    {current : V.Current} →
      (occurrence : source.toRootSource.actual.OccurrenceAt current) →
        Option (OccurrenceAt occurrence)
  compile :
    {current : V.Current} →
      {occurrence : source.toRootSource.actual.OccurrenceAt current} →
      OccurrenceAt occurrence →
        N.DispositionAt (source.toRootSource.account.supportOf occurrence)
          .supportSettlement

namespace LedgerSupportSettlementSourceAt

def empty
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (source : SourceNativeSource N V) :
    LedgerSupportSettlementSourceAt source where
  OccurrenceAt := fun _ => PEmpty
  emit? := fun _ => none
  compile := fun {_} {_} event => nomatch event

end LedgerSupportSettlementSourceAt

/-- Source-fixed compiler law for terminal incidence receipts. -/
structure LedgerTerminalRowSourceAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (source : SourceNativeSource N V) : Type (u + 1) where
  IncidenceOccurrenceAt :
    {current : V.Current} →
      (occurrence : source.toRootSource.actual.OccurrenceAt current) →
      OpenResponsibilityAt N
        (source.toRootSource.account.supportOf occurrence) → Type u
  compile :
    {current : V.Current} →
      {occurrence : source.toRootSource.actual.OccurrenceAt current} →
      {entry : OpenResponsibilityAt N
        (source.toRootSource.account.supportOf occurrence)} →
      IncidenceOccurrenceAt occurrence entry → LedgerEntryTerminalAt N entry
  /-- Optional one-event whole-support settlement authority. -/
  supportSettlementSource : LedgerSupportSettlementSourceAt source :=
    LedgerSupportSettlementSourceAt.empty source

/-- One terminal row already generated by the fixed terminal source law. -/
structure GeneratedLedgerTerminalRowAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    (rowSource : LedgerTerminalRowSourceAt source)
    {current : V.Current}
    (occurrence : source.toRootSource.actual.OccurrenceAt current)
    (entry : OpenResponsibilityAt N
      (source.toRootSource.account.supportOf occurrence)) : Type u where
  private mk ::
  event : rowSource.IncidenceOccurrenceAt occurrence entry
  terminal : LedgerEntryTerminalAt N entry
  terminal_eq : rowSource.compile event = terminal

/-- One whole-support settlement generated by the fixed terminal source. -/
structure GeneratedLedgerSupportSettlementAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    (rowSource : LedgerTerminalRowSourceAt source)
    {current : V.Current}
    (occurrence : source.toRootSource.actual.OccurrenceAt current) : Type u where
  private mk ::
  event : rowSource.supportSettlementSource.OccurrenceAt occurrence
  selected : rowSource.supportSettlementSource.emit? occurrence = some event

namespace LedgerTerminalRowSourceAt

/-- Source law with no terminal incidence events. -/
def empty
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    (source : SourceNativeSource N V) : LedgerTerminalRowSourceAt source where
  IncidenceOccurrenceAt := fun _ _ => PEmpty
  compile := fun {_} {_} {_} event => nomatch event

/-- Compile one terminal incidence event with the fixed source law. -/
def generate
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    (rowSource : LedgerTerminalRowSourceAt source)
    {current : V.Current}
    {occurrence : source.toRootSource.actual.OccurrenceAt current}
    {entry : OpenResponsibilityAt N
      (source.toRootSource.account.supportOf occurrence)}
    (event : rowSource.IncidenceOccurrenceAt occurrence entry) :
    GeneratedLedgerTerminalRowAt rowSource occurrence entry where
  event := event
  terminal := rowSource.compile event
  terminal_eq := rfl

/-- Canonical compiler for one fixed terminal incidence. -/
def authorityCompiler
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    (rowSource : LedgerTerminalRowSourceAt source)
    {current : V.Current}
    {occurrence : source.toRootSource.actual.OccurrenceAt current}
    (entry : OpenResponsibilityAt N
      (source.toRootSource.account.supportOf occurrence)) :
    CanonicalReceiptAuthority.Compiler
      (rowSource.IncidenceOccurrenceAt occurrence entry)
      (LedgerEntryTerminalAt N entry) where
  compile := rowSource.compile

def generateSupportSettlement?
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    (rowSource : LedgerTerminalRowSourceAt source)
    {current : V.Current}
    (occurrence : source.toRootSource.actual.OccurrenceAt current) :
    Option (GeneratedLedgerSupportSettlementAt rowSource occurrence) :=
  match selected : rowSource.supportSettlementSource.emit? occurrence with
  | none => none
  | some event => some ⟨event, selected⟩

def supportSettlementAuthorityCompiler
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    (rowSource : LedgerTerminalRowSourceAt source)
    {current : V.Current}
    (occurrence : source.toRootSource.actual.OccurrenceAt current) :
    CanonicalReceiptAuthority.Compiler
      (rowSource.supportSettlementSource.OccurrenceAt occurrence)
      (N.DispositionAt (source.toRootSource.account.supportOf occurrence)
        .supportSettlement) where
  compile := rowSource.supportSettlementSource.compile

end LedgerTerminalRowSourceAt

namespace GeneratedLedgerTerminalRowAt

/-- Casting a generated terminal row along its source entry casts the
terminal receipt by the same equality. -/
theorem cast_terminal_eq
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    {rowSource : LedgerTerminalRowSourceAt source}
    {current : V.Current}
    {occurrence : source.toRootSource.actual.OccurrenceAt current}
    {left right : OpenResponsibilityAt N
      (source.toRootSource.account.supportOf occurrence)}
    (entry_eq : left = right)
    (row : GeneratedLedgerTerminalRowAt rowSource occurrence left) :
    (Eq.mp
        (congrArg
          (GeneratedLedgerTerminalRowAt rowSource occurrence)
          entry_eq)
        row).terminal = entry_eq ▸ row.terminal := by
  cases entry_eq
  rfl

/-- The generated terminal receipt is canonical for its exact incidence
occurrence. -/
def isCanonical
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    {rowSource : LedgerTerminalRowSourceAt source}
    {current : V.Current}
    {occurrence : source.toRootSource.actual.OccurrenceAt current}
    {entry : OpenResponsibilityAt N
      (source.toRootSource.account.supportOf occurrence)}
    (row : GeneratedLedgerTerminalRowAt rowSource occurrence entry) :
    CanonicalReceiptAuthority.CanonicalReceipt
      (rowSource.authorityCompiler entry) row.terminal where
  actualEvent := row.event
  compile_eq := row.terminal_eq

end GeneratedLedgerTerminalRowAt

namespace GeneratedLedgerSupportSettlementAt

def receipt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    {rowSource : LedgerTerminalRowSourceAt source}
    {current : V.Current}
    {occurrence : source.toRootSource.actual.OccurrenceAt current}
    (generated : GeneratedLedgerSupportSettlementAt rowSource occurrence) :
    N.DispositionAt (source.toRootSource.account.supportOf occurrence)
      .supportSettlement :=
  rowSource.supportSettlementSource.compile generated.event

def toLedgerTerminalEvolution
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    {rowSource : LedgerTerminalRowSourceAt source}
    {current : V.Current}
    {occurrence : source.toRootSource.actual.OccurrenceAt current}
    (generated : GeneratedLedgerSupportSettlementAt rowSource occurrence) :
    LedgerTerminalEvolutionAt N
      ⟨source.toRootSource.account.supportOf occurrence⟩ where
  discharge := fun _ => ⟨generated.receipt⟩

def isCanonical
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    {rowSource : LedgerTerminalRowSourceAt source}
    {current : V.Current}
    {occurrence : source.toRootSource.actual.OccurrenceAt current}
    (generated : GeneratedLedgerSupportSettlementAt rowSource occurrence) :
    CanonicalReceiptAuthority.CanonicalReceipt
      (rowSource.supportSettlementAuthorityCompiler occurrence)
      generated.receipt where
  actualEvent := generated.event
  compile_eq := rfl

end GeneratedLedgerSupportSettlementAt

/-- Finite generated terminal patch.  Complete discharge is a derived fold;
the authority stores only the finite incidence occurrences and their exact
canonical receipts. -/
structure FiniteGeneratedLedgerTerminalPatchAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    (rowSource : LedgerTerminalRowSourceAt source)
    {current : V.Current}
    (occurrence : source.toRootSource.actual.OccurrenceAt current) : Type u where
  size : Nat
  entryAt : Fin size → OpenResponsibilityAt N
    (source.toRootSource.account.supportOf occurrence)
  rowAt : (index : Fin size) →
    GeneratedLedgerTerminalRowAt rowSource occurrence (entryAt index)
  entryIndex : OpenResponsibilityAt N
    (source.toRootSource.account.supportOf occurrence) → Fin size
  entry_sound : (entry : OpenResponsibilityAt N
    (source.toRootSource.account.supportOf occurrence)) →
    entryAt (entryIndex entry) = entry

namespace FiniteGeneratedLedgerTerminalPatchAt

/-- Fold exact terminal rows into the total compatibility discharge readout. -/
def toLedgerTerminalEvolution
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    {rowSource : LedgerTerminalRowSourceAt source}
    {current : V.Current}
    {occurrence : source.toRootSource.actual.OccurrenceAt current}
    (patch : FiniteGeneratedLedgerTerminalPatchAt rowSource occurrence) :
    LedgerTerminalEvolutionAt N
      ⟨source.toRootSource.account.supportOf occurrence⟩ where
  discharge := fun entry =>
    patch.entry_sound entry ▸ (patch.rowAt (patch.entryIndex entry)).terminal

end FiniteGeneratedLedgerTerminalPatchAt

/-- Stored source-entry membership in a generated terminal patch.

Like continuing stored membership, this is inventory only.  A patch may
retain duplicate rows for one entry while its total discharge fold uses the
single row fixed by `entryIndex`. -/
abbrev FiniteGeneratedLedgerTerminalPatchAt.GeneratedEntryAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    {rowSource : LedgerTerminalRowSourceAt source}
    {current : V.Current}
    {occurrence : source.toRootSource.actual.OccurrenceAt current}
    (patch : FiniteGeneratedLedgerTerminalPatchAt rowSource occurrence)
    (entry : OpenResponsibilityAt N
      (source.toRootSource.account.supportOf occurrence)) : Type :=
  { index : Fin patch.size // patch.entryAt index = entry }

/-- Opaque terminal-row authority selected by the same `entryIndex` used by
the total terminal fold. -/
structure FiniteGeneratedLedgerTerminalPatchAt.CanonicalGeneratedEntryAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    {rowSource : LedgerTerminalRowSourceAt source}
    {current : V.Current}
    {occurrence : source.toRootSource.actual.OccurrenceAt current}
    (_patch : FiniteGeneratedLedgerTerminalPatchAt rowSource occurrence)
    (_entry : OpenResponsibilityAt N
      (source.toRootSource.account.supportOf occurrence)) : Type where
  private mk ::

/-- Canonical terminal-row producer.  No stored index is accepted. -/
def FiniteGeneratedLedgerTerminalPatchAt.canonicalGeneratedEntryAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    {rowSource : LedgerTerminalRowSourceAt source}
    {current : V.Current}
    {occurrence : source.toRootSource.actual.OccurrenceAt current}
    (patch : FiniteGeneratedLedgerTerminalPatchAt rowSource occurrence)
    (entry : OpenResponsibilityAt N
      (source.toRootSource.account.supportOf occurrence)) :
    patch.CanonicalGeneratedEntryAt entry :=
  ⟨⟩

/-- The exact terminal row selected by the total fold. -/
def FiniteGeneratedLedgerTerminalPatchAt.CanonicalGeneratedEntryAt.row
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    {rowSource : LedgerTerminalRowSourceAt source}
    {current : V.Current}
    {occurrence : source.toRootSource.actual.OccurrenceAt current}
    {patch : FiniteGeneratedLedgerTerminalPatchAt rowSource occurrence}
    {entry : OpenResponsibilityAt N
      (source.toRootSource.account.supportOf occurrence)}
    (_selected : patch.CanonicalGeneratedEntryAt entry) :
    GeneratedLedgerTerminalRowAt rowSource occurrence entry :=
  Eq.mp
    (congrArg
      (GeneratedLedgerTerminalRowAt rowSource occurrence)
      (patch.entry_sound entry))
    (patch.rowAt (patch.entryIndex entry))

/-- The canonical terminal receipt is the exact discharge used by the world
fold for this entry. -/
theorem FiniteGeneratedLedgerTerminalPatchAt.CanonicalGeneratedEntryAt.terminal_eq_fold
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    {rowSource : LedgerTerminalRowSourceAt source}
    {current : V.Current}
    {occurrence : source.toRootSource.actual.OccurrenceAt current}
    {patch : FiniteGeneratedLedgerTerminalPatchAt rowSource occurrence}
    {entry : OpenResponsibilityAt N
      (source.toRootSource.account.supportOf occurrence)}
    (selected : patch.CanonicalGeneratedEntryAt entry) :
    selected.row.terminal = patch.toLedgerTerminalEvolution.discharge entry := by
  simpa [FiniteGeneratedLedgerTerminalPatchAt.CanonicalGeneratedEntryAt.row,
    FiniteGeneratedLedgerTerminalPatchAt.toLedgerTerminalEvolution] using
      (GeneratedLedgerTerminalRowAt.cast_terminal_eq
        (patch.entry_sound entry)
        (patch.rowAt (patch.entryIndex entry)))

/-- Total terminal authority: retain the legacy finite row inventory or use
one source-generated support-settlement occurrence for an arbitrary fibre. -/
inductive SourceGeneratedLedgerTerminalPatchAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    (rowSource : LedgerTerminalRowSourceAt source)
    {current : V.Current}
    (occurrence : source.toRootSource.actual.OccurrenceAt current) : Type u
  | finite
      (patch : FiniteGeneratedLedgerTerminalPatchAt rowSource occurrence)
  | supportSettlement
      (generated : GeneratedLedgerSupportSettlementAt rowSource occurrence)

instance instCoeFiniteGeneratedLedgerTerminalPatch
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    {rowSource : LedgerTerminalRowSourceAt source}
    {current : V.Current}
    {occurrence : source.toRootSource.actual.OccurrenceAt current} :
    Coe (FiniteGeneratedLedgerTerminalPatchAt rowSource occurrence)
      (SourceGeneratedLedgerTerminalPatchAt rowSource occurrence) :=
  ⟨.finite⟩

namespace SourceGeneratedLedgerTerminalPatchAt

def toLedgerTerminalEvolution
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    {rowSource : LedgerTerminalRowSourceAt source}
    {current : V.Current}
    {occurrence : source.toRootSource.actual.OccurrenceAt current}
    (patch : SourceGeneratedLedgerTerminalPatchAt rowSource occurrence) :
    LedgerTerminalEvolutionAt N
      ⟨source.toRootSource.account.supportOf occurrence⟩ := by
  cases patch with
  | finite finite => exact finite.toLedgerTerminalEvolution
  | supportSettlement generated => exact generated.toLedgerTerminalEvolution

structure SupportSettlementSelectedEntryAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    {rowSource : LedgerTerminalRowSourceAt source}
    {current : V.Current}
    {occurrence : source.toRootSource.actual.OccurrenceAt current}
    (_generated : GeneratedLedgerSupportSettlementAt rowSource occurrence)
    (_entry : OpenResponsibilityAt N
      (source.toRootSource.account.supportOf occurrence)) : Type where
  private mk ::

def CanonicalGeneratedEntryAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    {rowSource : LedgerTerminalRowSourceAt source}
    {current : V.Current}
    {occurrence : source.toRootSource.actual.OccurrenceAt current}
    (patch : SourceGeneratedLedgerTerminalPatchAt rowSource occurrence)
    (entry : OpenResponsibilityAt N
      (source.toRootSource.account.supportOf occurrence)) : Type := by
  cases patch with
  | finite finite => exact finite.CanonicalGeneratedEntryAt entry
  | supportSettlement generated =>
      exact SupportSettlementSelectedEntryAt generated entry

def canonicalGeneratedEntryAt
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    {rowSource : LedgerTerminalRowSourceAt source}
    {current : V.Current}
    {occurrence : source.toRootSource.actual.OccurrenceAt current}
    (patch : SourceGeneratedLedgerTerminalPatchAt rowSource occurrence)
    (entry : OpenResponsibilityAt N
      (source.toRootSource.account.supportOf occurrence)) :
    patch.CanonicalGeneratedEntryAt entry := by
  cases patch with
  | finite finite => exact finite.canonicalGeneratedEntryAt entry
  | supportSettlement _ => exact SupportSettlementSelectedEntryAt.mk

def CanonicalGeneratedEntryAt.terminal
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    {rowSource : LedgerTerminalRowSourceAt source}
    {current : V.Current}
    {occurrence : source.toRootSource.actual.OccurrenceAt current}
    {patch : SourceGeneratedLedgerTerminalPatchAt rowSource occurrence}
    {entry : OpenResponsibilityAt N
      (source.toRootSource.account.supportOf occurrence)}
    (selected : patch.CanonicalGeneratedEntryAt entry) :
    LedgerEntryTerminalAt N entry := by
  cases patch with
  | finite finite => exact selected.row.terminal
  | supportSettlement generated => exact ⟨generated.receipt⟩

theorem CanonicalGeneratedEntryAt.terminal_eq_fold
    {N : WorldRelationNetwork.{u}} {V : Vocabulary.{u}}
    {source : SourceNativeSource N V}
    {rowSource : LedgerTerminalRowSourceAt source}
    {current : V.Current}
    {occurrence : source.toRootSource.actual.OccurrenceAt current}
    {patch : SourceGeneratedLedgerTerminalPatchAt rowSource occurrence}
    {entry : OpenResponsibilityAt N
      (source.toRootSource.account.supportOf occurrence)}
    (selected : patch.CanonicalGeneratedEntryAt entry) :
    selected.terminal = patch.toLedgerTerminalEvolution.discharge entry := by
  cases patch with
  | finite finite =>
      change finite.CanonicalGeneratedEntryAt entry at selected
      exact
        FiniteGeneratedLedgerTerminalPatchAt.CanonicalGeneratedEntryAt.terminal_eq_fold
          selected
  | supportSettlement generated =>
      change SupportSettlementSelectedEntryAt generated entry at selected
      cases selected
      rfl

end SourceGeneratedLedgerTerminalPatchAt

end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
