import H0mework.Arithmetic.SourceAtoms.SourceCore
import H0mework.Arithmetic.CodePairs.Residual
import H0mework.Arithmetic.SourceAtoms.EndpointCoordinates

/-!
# A6-crystal observed source trace before filtering

This module supplies the first object-level Task-A producer on the live
Borromean route.  Unlike the fixed-left `PUnit` calibration, its source state
is a depth in a caller-specified A6 lowering-root stream.  Once `rootAt` has
been supplied the label stream is deterministic, but this facade does not
generate a signed `e/f` scheduler, a Fin7 state stream, or dynamic incidence
marks.  The current raw cell is computed from the endpoint coordinates of the
current A6 label.

The trace also owns its branch/incidence coordinates and a state-dependent
phase potential.  The two-ring cochain is the exact edge difference of that
potential, so component phase closure is proved rather than stored.  The
source key is generated from the current raw energy as `energy - 2`; the sole
current-shell admissibility hypothesis is the lower bound `2 <= energy`.

There is no Boolean endpoint check, generated-list membership, P950/canonical
rich witness, endpoint projection, Factor object, repair cell, or atom pair in
this file.
-/

namespace RepresentationArithmeticAtomProjectionDefect
namespace BorromeanPreRealization

open ConcreteBorromeanPreRealizationSourceCoreGeometry
open SaturationMonoid.StandardModelConstraint

universe v

/-! ## A6 lowering trace determined by a supplied root stream -/

/-- Apply the first `depth` simple-root moves of one observed A6 trace. -/
noncomputable def a6CrystalLabelAlongTrace
    (rootLabel : SU7A6WeightLabel)
    (rootAt : Nat -> Fin 6) : Nat -> SU7A6WeightLabel
  | 0 => rootLabel
  | depth + 1 =>
      su7A6LowerBySimpleRoot (rootAt depth)
        (a6CrystalLabelAlongTrace rootLabel rootAt depth)

@[simp] theorem a6CrystalLabelAlongTrace_zero
    (rootLabel : SU7A6WeightLabel)
    (rootAt : Nat -> Fin 6) :
    a6CrystalLabelAlongTrace rootLabel rootAt 0 = rootLabel := by
  rfl

@[simp] theorem a6CrystalLabelAlongTrace_succ
    (rootLabel : SU7A6WeightLabel)
    (rootAt : Nat -> Fin 6) (depth : Nat) :
    a6CrystalLabelAlongTrace rootLabel rootAt (depth + 1) =
      su7A6LowerBySimpleRoot (rootAt depth)
        (a6CrystalLabelAlongTrace rootLabel rootAt depth) := by
  rfl

/-- Object-level observed source data below every filter and realization
layer.

`currentDepth` is the source-state handle and producer trace index.
`phasePotentialOf` may vary with depth; it is not fixed to the zero cochain.
The scalar `sigma` is constrained to the active interval, but this structure
does not yet identify `currentDepth` with a historical sigma-iteration tag. -/
structure A6CrystalObservedSourceTrace
    (K : Type v) [Field K] [LinearOrder K] [IsStrictOrderedRing K]
    (sigma : K) (n : Nat) where
  sigma_pos : 0 < sigma
  sigma_lt_one : sigma < 1
  rootLabel : SU7A6WeightLabel
  rootAt : Nat -> Fin 6
  currentDepth : Nat
  branch : PreRealizationSU3Branch
  incidence : PreRealizationSU7Incidence
  phasePotentialOf :
    Nat ->
      Sum PreRealizationThreeCycleTime PreRealizationThreeCycleTime -> Int

namespace A6CrystalObservedSourceTrace

variable {K : Type v} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
variable {sigma : K} {n : Nat}

/-- Current A6 label at one trace depth. -/
noncomputable def labelAt
    (trace : A6CrystalObservedSourceTrace K sigma n)
    (depth : Nat) : SU7A6WeightLabel :=
  a6CrystalLabelAlongTrace trace.rootLabel trace.rootAt depth

/-- Pre-filter raw SU7 cell read from the current A6 endpoint coordinates. -/
noncomputable def rawCellAt
    (trace : A6CrystalObservedSourceTrace K sigma n)
    (depth : Nat) : PreRealizationSU7BranchingCell n where
  branch := trace.branch
  incidence := trace.incidence
  leftWeightCode :=
    su7A6EndpointSourceLeftCodeOf (trace.labelAt depth)
  rightWeightCode :=
    su7A6EndpointSourceRightCodeOf (trace.labelAt depth)

@[simp] theorem rawCellAt_branch
    (trace : A6CrystalObservedSourceTrace K sigma n)
    (depth : Nat) :
    (trace.rawCellAt depth).branch = trace.branch := by
  rfl

@[simp] theorem rawCellAt_incidence
    (trace : A6CrystalObservedSourceTrace K sigma n)
    (depth : Nat) :
    (trace.rawCellAt depth).incidence = trace.incidence := by
  rfl

/-- Exact phase cochain generated by the potential at one observed state. -/
def phaseCochainAt
    (trace : A6CrystalObservedSourceTrace K sigma n)
    (depth : Nat)
    (source target :
      Sum PreRealizationThreeCycleTime PreRealizationThreeCycleTime) : Int :=
  trace.phasePotentialOf depth target -
    trace.phasePotentialOf depth source

/-- Exact cochains close on the left three-cycle. -/
theorem left_phase_residual_zero
    (trace : A6CrystalObservedSourceTrace K sigma n)
    (depth : Nat) :
    preRealizationThreeCycleResidual
        (preRealizationLeftSelectedCochain
          (trace.phaseCochainAt depth)) = 0 := by
  simp [preRealizationThreeCycleResidual,
    preRealizationLeftSelectedCochain, phaseCochainAt]

/-- Exact cochains close on the right three-cycle. -/
theorem right_phase_residual_zero
    (trace : A6CrystalObservedSourceTrace K sigma n)
    (depth : Nat) :
    preRealizationThreeCycleResidual
        (preRealizationRightSelectedCochain
          (trace.phaseCochainAt depth)) = 0 := by
  simp [preRealizationThreeCycleResidual,
    preRealizationRightSelectedCochain, phaseCochainAt]

/-- Raw energy of the actual current trace cell. -/
noncomputable def currentEnergy
    (trace : A6CrystalObservedSourceTrace K sigma n) : Nat :=
  preRealizationRawEnergy (trace.rawCellAt trace.currentDepth)

/-- The current L0 energy is definitionally the repository's raw endpoint
pair energy on the two codes generated at the same trace depth. -/
@[simp] theorem currentEnergy_eq_rawCodePairResidualEnergy
    (trace : A6CrystalObservedSourceTrace K sigma n) :
    trace.currentEnergy =
      rawCodePairResidualEnergy n
        (trace.rawCellAt trace.currentDepth).leftWeightCode
        (trace.rawCellAt trace.currentDepth).rightWeightCode := by
  rfl

/-- The shell key generated by a positive current source energy. -/
noncomputable def currentKey
    (trace : A6CrystalObservedSourceTrace K sigma n) : Nat :=
  trace.currentEnergy - 2

/-- Minimal room containing both endpoint codes of the current raw cell. -/
noncomputable def currentSourceBound
    (trace : A6CrystalObservedSourceTrace K sigma n) : Nat :=
  max (trace.rawCellAt trace.currentDepth).leftWeightCode
    (trace.rawCellAt trace.currentDepth).rightWeightCode

/-! ## Primitive current active cell before endpoint observation -/

/-- A current SU(7) active source cell before endpoint filtering.

This is the lower crystal/incidence object that the historical
`SU7ProducedActiveCell` interface was missing.  It carries the actual A6
source label, raw branching cell, and endpoint-room bounds, but deliberately
does not carry Boolean atomicity, generated-list membership, P950 holonomy,
or a canonical-rich witness.  Those are observations or realization
responsibilities downstream of the primitive source, not fields of the
source itself. -/
structure PrimitiveCurrentActiveCell (n sourceBound : Nat) where
  sourceLabel : SU7A6WeightLabel
  cell : PreRealizationSU7BranchingCell n
  left_code_reads_source :
    cell.leftWeightCode = su7A6EndpointSourceLeftCodeOf sourceLabel
  right_code_reads_source :
    cell.rightWeightCode = su7A6EndpointSourceRightCodeOf sourceLabel
  left_code_bounded : cell.leftWeightCode <= sourceBound
  right_code_bounded : cell.rightWeightCode <= sourceBound

namespace PrimitiveCurrentActiveCell

/-- Raw residual energy of the primitive active source cell. -/
noncomputable def energy
    {n sourceBound : Nat}
    (A : PrimitiveCurrentActiveCell n sourceBound) : Nat :=
  preRealizationRawEnergy A.cell

end PrimitiveCurrentActiveCell

/-- The canonical primitive active cell at the observed trace depth.

Unlike `SU7ProducedActiveCell`, this construction is available for every
actual A6 trace: composite endpoint codes remain legitimate lower source
coordinates and are left for the faithful observation domain to resolve. -/
noncomputable def currentPrimitiveActiveCell
    (trace : A6CrystalObservedSourceTrace K sigma n) :
    PrimitiveCurrentActiveCell n trace.currentSourceBound where
  sourceLabel := trace.labelAt trace.currentDepth
  cell := trace.rawCellAt trace.currentDepth
  left_code_reads_source := rfl
  right_code_reads_source := rfl
  left_code_bounded := le_max_left _ _
  right_code_bounded := le_max_right _ _

@[simp] theorem currentPrimitiveActiveCell_cell
    (trace : A6CrystalObservedSourceTrace K sigma n) :
    trace.currentPrimitiveActiveCell.cell =
      trace.rawCellAt trace.currentDepth := by
  rfl

@[simp] theorem currentPrimitiveActiveCell_sourceLabel
    (trace : A6CrystalObservedSourceTrace K sigma n) :
    trace.currentPrimitiveActiveCell.sourceLabel =
      trace.labelAt trace.currentDepth := by
  rfl

@[simp] theorem currentPrimitiveActiveCell_energy
    (trace : A6CrystalObservedSourceTrace K sigma n) :
    trace.currentPrimitiveActiveCell.energy = trace.currentEnergy := by
  rfl

/-- A positive current source whose computed endpoint room lies in the even
half is necessarily on the below side of the raw residual hyperplane.

This is pure L0 arithmetic: it uses no Boolean endpoint check or generated
list membership. -/
theorem currentPair_sourceBelow_of_currentSourceBound_le_evenHalf
    (trace : A6CrystalObservedSourceTrace K sigma n)
    (hsourceRoom : trace.currentSourceBound <= n)
    (henergyFloor : 2 <= trace.currentEnergy) :
    (trace.rawCellAt trace.currentDepth).leftWeightCode +
        (trace.rawCellAt trace.currentDepth).rightWeightCode <
      2 * n := by
  have hleft :
      (trace.rawCellAt trace.currentDepth).leftWeightCode <= n :=
    le_trans (le_max_left _ _) hsourceRoom
  have hright :
      (trace.rawCellAt trace.currentDepth).rightWeightCode <= n :=
    le_trans (le_max_right _ _) hsourceRoom
  have hsum_le :
      (trace.rawCellAt trace.currentDepth).leftWeightCode +
          (trace.rawCellAt trace.currentDepth).rightWeightCode <=
        2 * n := by
    omega
  by_contra hnotBelow
  have hsum :
      (trace.rawCellAt trace.currentDepth).leftWeightCode +
          (trace.rawCellAt trace.currentDepth).rightWeightCode =
        2 * n := by
    omega
  have henergyZero : trace.currentEnergy = 0 := by
    rw [trace.currentEnergy_eq_rawCodePairResidualEnergy]
    unfold rawCodePairResidualEnergy rawCodePairResidual
    simp [hsum]
  omega

/-! ## Generated pre-realization geometry and certificate -/

/-- The observed A6 trace generates the frozen L0 source geometry.

The state transition is genuine and injective (`Nat.succ`), rather than a
constant `PUnit` loop. -/
noncomputable def toPreRealizationGeometry
    (trace : A6CrystalObservedSourceTrace K sigma n) :
    ConcreteBorromeanPreRealizationSourceCoreGeometry
      K sigma n trace.currentSourceBound where
  sigma_pos := trace.sigma_pos
  sigma_lt_one := trace.sigma_lt_one
  SourceState := Nat
  initialState := 0
  nextState := Nat.succ
  source_path_faithful := by
    intro left right hequal
    exact Nat.succ.inj hequal
  branchingCellOf := trace.rawCellAt
  branch_preserved := by
    intro state
    rfl
  incidence_preserved := by
    intro state
    rfl
  componentCochainOf := trace.phaseCochainAt

/-- Every finite depth of the deterministic trace is reachable from its root.
-/
theorem depth_reachable
    (trace : A6CrystalObservedSourceTrace K sigma n)
    (depth : Nat) :
    Relation.ReflTransGen trace.toPreRealizationGeometry.sourceStep
      trace.toPreRealizationGeometry.initialState depth := by
  induction depth with
  | zero => exact Relation.ReflTransGen.refl
  | succ depth ih =>
      exact ih.trans
        (Relation.ReflTransGen.single (by
          rfl))

/-- Every finite continuation from an already selected trace depth is an
actual path of the same `Nat.succ` source dynamics.  This relative form is the
path evidence used by source-indexed endpoint monodromy moves. -/
theorem depth_to_depth_add_reachable
    (trace : A6CrystalObservedSourceTrace K sigma n)
    (depth steps : Nat) :
    Relation.ReflTransGen trace.toPreRealizationGeometry.sourceStep
      depth (depth + steps) := by
  induction steps with
  | zero =>
      simpa using
        (Relation.ReflTransGen.refl :
          Relation.ReflTransGen
            trace.toPreRealizationGeometry.sourceStep depth depth)
  | succ steps ih =>
      exact ih.trans
        (Relation.ReflTransGen.single (by
          change depth + (steps + 1) = Nat.succ (depth + steps)
          omega))

/-! ## Source reachability is not endpoint monodromy -/

/-- Every genuine step of the observed source dynamics strictly increases the
trace depth.  The source path is therefore directed reachability data, not a
loop action on an endpoint fiber. -/
theorem sourceStep_depth_strict
    (trace : A6CrystalObservedSourceTrace K sigma n)
    {sourceDepth targetDepth : Nat}
    (step : trace.toPreRealizationGeometry.sourceStep
      sourceDepth targetDepth) :
    sourceDepth < targetDepth := by
  change targetDepth = Nat.succ sourceDepth at step
  omega

/-- A nonempty chain of source steps also strictly increases depth. -/
theorem sourceStep_transGen_depth_strict
    (trace : A6CrystalObservedSourceTrace K sigma n)
    {sourceDepth targetDepth : Nat}
    (path : Relation.TransGen trace.toPreRealizationGeometry.sourceStep
      sourceDepth targetDepth) :
    sourceDepth < targetDepth := by
  induction path using Relation.TransGen.trans_induction_on with
  | single step =>
      exact trace.sourceStep_depth_strict step
  | trans _ _ leftStrict rightStrict =>
      exact lt_trans leftStrict rightStrict

/-- Hence the actual `Nat.succ` source dynamics has no nontrivial loop at any
state.  Ordered L0 endpoint monodromy must come from a separately generated
non-exact phase/incidence connection; it cannot be read from source
reachability alone. -/
theorem no_nontrivial_sourceStep_loop
    (trace : A6CrystalObservedSourceTrace K sigma n)
    (depth : Nat) :
    ¬ Relation.TransGen trace.toPreRealizationGeometry.sourceStep depth depth := by
  intro loop
  exact (Nat.lt_irrefl depth) (trace.sourceStep_transGen_depth_strict loop)

/-- The observed current state produces a genuine L0 current-shell
certificate.  The key equation is derived from `currentKey = energy - 2`, not
stored in the trace. -/
noncomputable def currentShellSourceCertificate
    (trace : A6CrystalObservedSourceTrace K sigma n)
    (henergyFloor : 2 <= trace.currentEnergy) :
    SU7CurrentShellSourceCertificate
      trace.toPreRealizationGeometry trace.currentKey where
  state := trace.currentDepth
  reachable := trace.depth_reachable trace.currentDepth
  left_code_bounded := by
    exact le_max_left _ _
  right_code_bounded := by
    exact le_max_right _ _
  left_component_residual_zero :=
    trace.left_phase_residual_zero trace.currentDepth
  right_component_residual_zero :=
    trace.right_phase_residual_zero trace.currentDepth
  source_energy_successor := by
    change trace.currentEnergy = trace.currentKey + 2
    simp only [currentKey]
    omega

/-- Task A in source-backed existential form.

The same observed trace produces its reachable raw cell, sigma interval,
branch/incidence coordinates, state-dependent phase closure, computed room,
and exact current-shell energy. -/
theorem generates_currentShellSource
    (trace : A6CrystalObservedSourceTrace K sigma n)
    (henergyFloor : 2 <= trace.currentEnergy) :
    let geometry := trace.toPreRealizationGeometry
    let certificate := trace.currentShellSourceCertificate henergyFloor
    ∃ cell : PreRealizationSU7BranchingCell n,
      SourceGeneratedCurrentCell geometry trace.currentDepth cell ∧
        cell = trace.rawCellAt trace.currentDepth ∧
        0 < sigma ∧
        sigma < 1 ∧
        cell.branch = trace.branch ∧
        cell.incidence = trace.incidence ∧
        cell.leftWeightCode <= trace.currentSourceBound ∧
        cell.rightWeightCode <= trace.currentSourceBound ∧
        preRealizationThreeCycleResidual
            (preRealizationLeftSelectedCochain
              (geometry.componentCochainOf certificate.state)) = 0 ∧
        preRealizationThreeCycleResidual
            (preRealizationRightSelectedCochain
              (geometry.componentCochainOf certificate.state)) = 0 ∧
        preRealizationRawEnergy cell = trace.currentKey + 2 := by
  dsimp only
  let certificate := trace.currentShellSourceCertificate henergyFloor
  refine ⟨trace.rawCellAt trace.currentDepth, ?_⟩
  exact
    ⟨⟨certificate.reachable, rfl⟩,
      rfl,
      trace.sigma_pos,
      trace.sigma_lt_one,
      rfl,
      rfl,
      certificate.left_code_bounded,
      certificate.right_code_bounded,
      certificate.left_component_residual_zero,
      certificate.right_component_residual_zero,
      certificate.source_energy_successor⟩

/-- Generic lower SU(7)/crystal/incidence current-active-cell producer.

The conclusion is generated from the actual trace and preserves its current
state, A6 label, raw endpoint coordinates, branch, incidence, and affine
`currentKey + 2` energy.  No endpoint atom predicate or realization
certificate is needed.  Promotion to the historical filtered
`SU7ProducedActiveCell` is intentionally not claimed here. -/
theorem generates_currentPrimitiveActiveCell
    (trace : A6CrystalObservedSourceTrace K sigma n)
    (henergyFloor : 2 <= trace.currentEnergy) :
    ∃ A : PrimitiveCurrentActiveCell n trace.currentSourceBound,
      SourceGeneratedCurrentCell
          trace.toPreRealizationGeometry trace.currentDepth A.cell ∧
        A.energy = trace.currentKey + 2 ∧
        A.sourceLabel = trace.labelAt trace.currentDepth ∧
        A.cell = trace.rawCellAt trace.currentDepth ∧
        A.cell.branch = trace.branch ∧
        A.cell.incidence = trace.incidence := by
  refine ⟨trace.currentPrimitiveActiveCell, ?_⟩
  refine
    ⟨⟨trace.depth_reachable trace.currentDepth, rfl⟩,
      ?_, rfl, rfl, rfl, rfl⟩
  change trace.currentEnergy = trace.currentKey + 2
  simp only [currentKey]
  omega

end A6CrystalObservedSourceTrace

end BorromeanPreRealization
end RepresentationArithmeticAtomProjectionDefect
