import H0mework.Arithmetic.SourceAtoms.A6CrystalSource

/-!
# Dependency-light `(5,7)` observed A6/L0 trace

This file owns only the concrete nonzero phase potential, the full observed
trace, and elementary current-state readouts.  It is split from the later
repair/Factor calibration so physical lineage code can name the exact math
source without importing endpoint atomhood or a Factor consumer.
-/

namespace RepresentationArithmeticAtomProjectionDefect
namespace BorromeanPreRealization

open ConcreteBorromeanPreRealizationSourceCoreGeometry
open SaturationMonoid.StandardModelConstraint

/-! ## Concrete observed source -/

/-- A state-dependent potential on the two source-phase rings. -/
def n10FiveSevenPhasePotential
    (depth : Nat) :
    Sum PreRealizationThreeCycleTime PreRealizationThreeCycleTime -> Int
  | Sum.inl .t0 => depth
  | Sum.inl .t1 => (depth : Int) + 1
  | Sum.inl .t2 => (depth : Int) + 3
  | Sum.inr .t0 => (depth : Int) + 2
  | Sum.inr .t1 => (depth : Int) + 5
  | Sum.inr .t2 => (depth : Int) + 9

/-- Positive calibration trace.  Its current state is the actual depth-zero
readout of the `(5,7,E=8)` source label; future trace states are generated by
successive A6 simple-root lowering at root zero. -/
noncomputable def n10FiveSevenObservedTrace :
    A6CrystalObservedSourceTrace Real (1 / 2) 10 where
  sigma_pos := by norm_num
  sigma_lt_one := by norm_num
  rootLabel := su7A6FiveSevenSourceLabel
  rootAt := fun _ => 0
  currentDepth := 0
  branch := .e
  incidence := .colorWeak
  phasePotentialOf := n10FiveSevenPhasePotential

namespace A6CrystalObservedSourceTrace

@[simp] theorem n10FiveSevenObservedTrace_current_left :
    (n10FiveSevenObservedTrace.rawCellAt
      n10FiveSevenObservedTrace.currentDepth).leftWeightCode = 5 := by
  rfl

@[simp] theorem n10FiveSevenObservedTrace_current_right :
    (n10FiveSevenObservedTrace.rawCellAt
      n10FiveSevenObservedTrace.currentDepth).rightWeightCode = 7 := by
  rfl

@[simp] theorem n10FiveSevenObservedTrace_currentEnergy :
    n10FiveSevenObservedTrace.currentEnergy = 8 := by
  rw [n10FiveSevenObservedTrace.currentEnergy_eq_rawCodePairResidualEnergy]
  norm_num [rawCodePairResidualEnergy, rawCodePairResidual]

@[simp] theorem n10FiveSevenObservedTrace_currentKey :
    n10FiveSevenObservedTrace.currentKey = 6 := by
  norm_num [currentKey, rawCodePairResidualEnergy, rawCodePairResidual]

@[simp] theorem n10FiveSevenObservedTrace_currentSourceBound :
    n10FiveSevenObservedTrace.currentSourceBound = 7 := by
  simp [currentSourceBound]

/-- The calibration is not silently using the zero phase cochain. -/
theorem n10FiveSevenObservedTrace_phaseCochain_nonzero :
    n10FiveSevenObservedTrace.phaseCochainAt 0
      (Sum.inl .t0) (Sum.inl .t1) = 1 := by
  norm_num [phaseCochainAt, n10FiveSevenObservedTrace,
    n10FiveSevenPhasePotential]

end A6CrystalObservedSourceTrace

end BorromeanPreRealization
end RepresentationArithmeticAtomProjectionDefect
