import H0mework.Arithmetic.SourceAtoms.SourceStrictPotentialPathAntisymmetry
import H0mework.Arithmetic.SourceAtoms.SourceAnchoredReturnPathLaw

/-!
# Source generated lowering strict potential

This file lowers the strict-potential source obligation to unit lowering
dynamics.

Instead of proving a closed-or-strictly-lowers law for every source path
directly, a native source instance may provide:

```text
unit lowering edge
edge preserves feasibility
edge strictly lowers a source potential
path is generated by those edges
```

The generated path relation then satisfies `SourceStrictPotentialPath`, so it
feeds the existing trace-carried source-cover hard door.
-/

namespace RepresentationArithmeticAtomProjectionDefect

universe u

/-- Reflexive transitive paths generated by a directed lowering edge. -/
inductive GeneratedLoweringPath
    {SourceEvidence : Type u}
    (edge : SourceEvidence -> SourceEvidence -> Prop) :
    SourceEvidence -> SourceEvidence -> Prop where
  | refl (source : SourceEvidence) :
      GeneratedLoweringPath edge source source
  | tail {source middle target : SourceEvidence} :
      GeneratedLoweringPath edge source middle ->
        edge middle target ->
          GeneratedLoweringPath edge source target

namespace GeneratedLoweringPath

variable {SourceEvidence : Type u}
variable {edge : SourceEvidence -> SourceEvidence -> Prop}

/-- A single lowering edge is a generated path. -/
theorem single
    {source target : SourceEvidence}
    (hEdge : edge source target) :
    GeneratedLoweringPath edge source target :=
  GeneratedLoweringPath.tail
    (GeneratedLoweringPath.refl source)
    hEdge

/-- Generated lowering paths compose. -/
theorem trans
    {source middle target : SourceEvidence}
    (source_to_middle : GeneratedLoweringPath edge source middle)
    (middle_to_target : GeneratedLoweringPath edge middle target) :
    GeneratedLoweringPath edge source target := by
  induction middle_to_target with
  | refl =>
      exact source_to_middle
  | tail hPrefix hEdge ih =>
      exact GeneratedLoweringPath.tail ih hEdge

/-- Generated paths preserve feasibility when unit edges do. -/
theorem preserves_feasible
    {feasible : SourceEvidence -> Prop}
    (edge_preserves_feasible :
      ∀ {source target : SourceEvidence},
        edge source target -> feasible source -> feasible target)
    {source target : SourceEvidence}
    (hPath : GeneratedLoweringPath edge source target)
    (hFeasible : feasible source) :
    feasible target := by
  induction hPath with
  | refl =>
      exact hFeasible
  | tail hPrefix hEdge ih =>
      exact edge_preserves_feasible hEdge ih

/-- If every unit edge strictly lowers a potential, then every generated path is
either closed or strictly lowers that potential. -/
theorem strict_or_closed
    {potential : SourceEvidence -> Nat}
    (edge_strictly_lowers :
      ∀ {source target : SourceEvidence},
        edge source target -> potential target < potential source)
    {source target : SourceEvidence}
    (hPath : GeneratedLoweringPath edge source target) :
    target = source ∨ potential target < potential source := by
  induction hPath with
  | refl =>
      exact Or.inl rfl
  | tail hPrefix hEdge ih =>
      have hEdgeStrict := edge_strictly_lowers hEdge
      rcases ih with hClosed | hStrict
      · exact Or.inr (by
          rw [hClosed] at hEdgeStrict
          exact hEdgeStrict)
      · exact Or.inr (Nat.lt_trans hEdgeStrict hStrict)

end GeneratedLoweringPath

/-- Unit lowering dynamics whose paths are generated by lowering edges. -/
structure SourceUnitLoweringDynamics
    (SourceEvidence : Type u) where
  feasible : SourceEvidence -> Prop
  edge : SourceEvidence -> SourceEvidence -> Prop
  potential : SourceEvidence -> Nat
  edge_preserves_feasible :
    ∀ {source target : SourceEvidence},
      edge source target -> feasible source -> feasible target
  edge_strictly_lowers :
    ∀ {source target : SourceEvidence},
      edge source target -> potential target < potential source

namespace SourceUnitLoweringDynamics

variable {SourceEvidence : Type u}

/-- The source category generated by unit lowering dynamics. -/
def sourceCategory
    (D : SourceUnitLoweringDynamics SourceEvidence) :
    RepresentationFeasibleCategory SourceEvidence where
  feasible := D.feasible
  path := GeneratedLoweringPath D.edge
  path_preserves_feasible := by
    intro source target hPath hFeasible
    exact
      GeneratedLoweringPath.preserves_feasible
        (edge := D.edge)
        (feasible := D.feasible)
        D.edge_preserves_feasible hPath hFeasible

/-- Generated source paths are transitive. -/
theorem sourcePathTransitivity
    (D : SourceUnitLoweringDynamics SourceEvidence) :
    SourcePathTransitivity SourceEvidence D.sourceCategory where
  trans := by
    intro a b c hAB hBC
    exact GeneratedLoweringPath.trans hAB hBC

/-- Generated lowering paths are closed or strictly lower the native potential.
-/
theorem path_strict_or_closed
    (D : SourceUnitLoweringDynamics SourceEvidence)
    {source target : SourceEvidence}
    (hPath : D.sourceCategory.path source target) :
    target = source ∨ D.potential target < D.potential source :=
  GeneratedLoweringPath.strict_or_closed
    (edge := D.edge)
    (potential := D.potential)
    D.edge_strictly_lowers hPath

/-- Unit lowering dynamics provide the strict-potential source law consumed by
the holonomy hard door. -/
def toSourceStrictPotentialPath
    (D : SourceUnitLoweringDynamics SourceEvidence) :
    SourceStrictPotentialPath SourceEvidence D.sourceCategory where
  potential := D.potential
  path_strict_or_closed := by
    intro source target hPath
    exact D.path_strict_or_closed hPath

end SourceUnitLoweringDynamics

namespace CrystalBranchingSource

/-- Rank-one generated lowering dynamics: unit edges are `target + 1 = source`.
-/
def rankOneGeneratedLoweringDynamics :
    SourceUnitLoweringDynamics Nat where
  feasible := fun _ => True
  edge := fun source target => target + 1 = source
  potential := id
  edge_preserves_feasible := by
    intro _source _target _hEdge _hFeasible
    trivial
  edge_strictly_lowers := by
    intro source target hEdge
    rw [← hEdge]
    exact Nat.lt_succ_self target

/-- The generated rank-one source category satisfies the strict-potential hard
door input. -/
def rankOneGeneratedSourceStrictPotentialPath :
    SourceStrictPotentialPath
      Nat rankOneGeneratedLoweringDynamics.sourceCategory :=
  rankOneGeneratedLoweringDynamics.toSourceStrictPotentialPath

end CrystalBranchingSource


end RepresentationArithmeticAtomProjectionDefect
