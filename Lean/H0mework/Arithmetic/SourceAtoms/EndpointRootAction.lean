import H0mework.Arithmetic.SourceAtoms.EndpointCoordinates

/-!
# Lower A6 endpoint-stable root action core

This module extracts the common arithmetic content of the source-time receipt
and the physical stable-root graph.  The three-letter alphabet is embedded as
the actual A6 roots `3,4,5`.  An ordered word acts by successive native A6
lowering, while its commutative readout subtracts the corresponding Cartan
rows.

The equality between those two calculations is structural: simple-root
lowering is translation by a fixed Cartan row.  It authorizes forgetting order
only after an actual word has been generated.  No source path, physical fiber,
field, admission credential, endpoint filter, shell, or atomhood is defined
here.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

abbrev SU7A6StableRootIndex := Fin 3
abbrev SU7A6StableDerivationState := Multiset SU7A6StableRootIndex

/-- Embed the endpoint-invisible alphabet as A6 roots `3,4,5`. -/
def su7A6StableRootToA6Root
    (root : SU7A6StableRootIndex) : Fin 6 :=
  ⟨root.val + 3, by omega⟩

@[simp] theorem su7A6StableRootToA6Root_val
    (root : SU7A6StableRootIndex) :
    (su7A6StableRootToA6Root root).val = root.val + 3 :=
  rfl

@[simp] theorem su7A6StableRootToA6Root_zero :
    su7A6StableRootToA6Root (0 : SU7A6StableRootIndex) =
      (3 : Fin 6) := by
  apply Fin.ext
  rfl

@[simp] theorem su7A6StableRootToA6Root_one :
    su7A6StableRootToA6Root (1 : SU7A6StableRootIndex) =
      (4 : Fin 6) := by
  apply Fin.ext
  rfl

@[simp] theorem su7A6StableRootToA6Root_two :
    su7A6StableRootToA6Root (2 : SU7A6StableRootIndex) =
      (5 : Fin 6) := by
  apply Fin.ext
  rfl

theorem su7A6StableRootToA6Root_injective :
    Function.Injective su7A6StableRootToA6Root := by
  intro left right equality
  apply Fin.ext
  have valueEquality := congrArg Fin.val equality
  simp only [su7A6StableRootToA6Root_val] at valueEquality
  omega

@[simp] theorem su7A6StableRoot_cartan_zero_at_leftEndpoint
    (root : SU7A6StableRootIndex) :
    su7A6CartanEntry
        (su7A6StableRootToA6Root root) (0 : Fin 6) = 0 := by
  fin_cases root <;>
    norm_num [su7A6StableRootToA6Root, su7A6CartanEntry, su7A6Adjacent]

@[simp] theorem su7A6StableRoot_cartan_zero_at_rightEndpoint
    (root : SU7A6StableRootIndex) :
    su7A6CartanEntry
        (su7A6StableRootToA6Root root) (1 : Fin 6) = 0 := by
  fin_cases root <;>
    norm_num [su7A6StableRootToA6Root, su7A6CartanEntry,
      su7A6Adjacent] <;>
    omega

/-- The commutative Cartan displacement read by the stable-root graph. -/
def su7A6StableCartanDisplacement
    (moves : SU7A6StableDerivationState) (coordinate : Fin 6) : Int :=
  (moves.map fun root =>
    su7A6CartanEntry
      (su7A6StableRootToA6Root root) coordinate).sum

/-- Structural A6 label generated by a stable-root move multiset. -/
def su7A6StableGeneratedLabel
    (rootLabel : SU7A6WeightLabel)
    (moves : SU7A6StableDerivationState) :
    SU7A6WeightLabel :=
  fun coordinate =>
    rootLabel coordinate -
      su7A6StableCartanDisplacement moves coordinate

@[simp] theorem su7A6StableGeneratedLabel_zero
    (rootLabel : SU7A6WeightLabel) :
    su7A6StableGeneratedLabel rootLabel 0 = rootLabel := by
  funext coordinate
  simp [su7A6StableGeneratedLabel, su7A6StableCartanDisplacement]

theorem su7A6StableGeneratedLabel_cons
    (rootLabel : SU7A6WeightLabel)
    (moves : SU7A6StableDerivationState)
    (root : SU7A6StableRootIndex) :
    su7A6StableGeneratedLabel rootLabel (root ::ₘ moves) =
      su7A6LowerBySimpleRoot
        (su7A6StableRootToA6Root root)
        (su7A6StableGeneratedLabel rootLabel moves) := by
  funext coordinate
  simp [su7A6StableGeneratedLabel, su7A6StableCartanDisplacement,
    su7A6LowerBySimpleRoot]
  ring

theorem su7A6StableGeneratedLabel_leftEndpoint
    (rootLabel : SU7A6WeightLabel)
    (moves : SU7A6StableDerivationState) :
    su7A6StableGeneratedLabel rootLabel moves (0 : Fin 6) =
      rootLabel (0 : Fin 6) := by
  induction moves using Multiset.induction_on with
  | empty => simp
  | @cons root tail ih =>
      rw [su7A6StableGeneratedLabel_cons]
      simp [su7A6LowerBySimpleRoot, ih]

theorem su7A6StableGeneratedLabel_rightEndpoint
    (rootLabel : SU7A6WeightLabel)
    (moves : SU7A6StableDerivationState) :
    su7A6StableGeneratedLabel rootLabel moves (1 : Fin 6) =
      rootLabel (1 : Fin 6) := by
  induction moves using Multiset.induction_on with
  | empty => simp
  | @cons root tail ih =>
      rw [su7A6StableGeneratedLabel_cons]
      simp [su7A6LowerBySimpleRoot, ih]

theorem su7A6StableGeneratedLabel_preserves_leftEndpointCode
    (rootLabel : SU7A6WeightLabel)
    (moves : SU7A6StableDerivationState) :
    su7A6EndpointSourceLeftCodeOf
        (su7A6StableGeneratedLabel rootLabel moves) =
      su7A6EndpointSourceLeftCodeOf rootLabel := by
  simp [su7A6EndpointSourceLeftCodeOf,
    su7A6StableGeneratedLabel_leftEndpoint]

theorem su7A6StableGeneratedLabel_preserves_rightEndpointCode
    (rootLabel : SU7A6WeightLabel)
    (moves : SU7A6StableDerivationState) :
    su7A6EndpointSourceRightCodeOf
        (su7A6StableGeneratedLabel rootLabel moves) =
      su7A6EndpointSourceRightCodeOf rootLabel := by
  simp [su7A6EndpointSourceRightCodeOf,
    su7A6StableGeneratedLabel_rightEndpoint]

/-- Execute an ordered stable-root word by native A6 lowering. -/
def su7A6StableRootAction
    (rootLabel : SU7A6WeightLabel)
    (word : List SU7A6StableRootIndex) :
    SU7A6WeightLabel :=
  word.foldl
    (fun current root =>
      su7A6LowerBySimpleRoot
        (su7A6StableRootToA6Root root) current)
    rootLabel

/-- Ordered lowering and the structural commutative readout agree.

The word remains the provenance authority; this theorem does not reconstruct
it from the multiset. -/
theorem su7A6StableRootAction_eq_generatedLabel
    (rootLabel : SU7A6WeightLabel)
    (word : List SU7A6StableRootIndex) :
    su7A6StableRootAction rootLabel word =
      su7A6StableGeneratedLabel rootLabel
        (word : SU7A6StableDerivationState) := by
  induction word generalizing rootLabel with
  | nil =>
      simp [su7A6StableRootAction]
  | cons root tail ih =>
      rw [show
        su7A6StableRootAction rootLabel (root :: tail) =
          su7A6StableRootAction
            (su7A6LowerBySimpleRoot
              (su7A6StableRootToA6Root root) rootLabel)
            tail by rfl]
      rw [ih]
      funext coordinate
      simp [su7A6StableGeneratedLabel, su7A6StableCartanDisplacement,
        su7A6LowerBySimpleRoot]
      ring

end

end StandardModelConstraint
end SaturationMonoid
