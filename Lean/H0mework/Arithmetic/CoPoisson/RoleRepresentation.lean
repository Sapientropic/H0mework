import H0mework.Arithmetic.CoPoisson.MuntzCoupling

/-!
# Global co-Poisson role representation

The comb, zero mode, and volume mode are three integral group-ring roles on
the same positive-scale carrier.  Their diagonal difference is the existing
Müntz scale remainder, not a separately supplied analytic payload.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalRiemann
namespace ClozelGeneralizedDual
namespace GlobalCoPoissonRoleRepresentation

open FourierTransform MeasureTheory
open ClozelEndpointSourceEffect
open SourceGeneratedIntegralCharacterGroupRing
open ThetaJRoleRepresentation
open ThetaJRoleMuntzCoupling
open scoped SchwartzMap

noncomputable section

/-- The actual theta-comb role already generated by the J representation. -/
def combRole : IntegralScaleCarrier →ₗ[ℤ] ComplexTempered :=
  leftRole

/-- The scale-indexed zero-mode role. -/
def zeroRole : IntegralScaleCarrier →ₗ[ℤ] ComplexTempered :=
  canonicalBasis.constr ℤ
    (fun _ ↦ TemperedDistribution.delta 0)

/-- The scale-indexed Haar-volume role with its actual inverse weight. -/
def volumeRole : IntegralScaleCarrier →ₗ[ℤ] ComplexTempered :=
  canonicalBasis.constr ℤ
    (fun scale ↦ (scaleValue scale)⁻¹ •
      (volume.toTemperedDistribution : ComplexTempered))

@[simp] theorem combRole_delta (scale : Units NNReal) :
    combRole (delta scale) = thetaAtScale scale := by
  simp [combRole]

@[simp] theorem zeroRole_delta (scale : Units NNReal) :
    zeroRole (delta scale) = TemperedDistribution.delta 0 := by
  rw [← canonicalBasis_apply scale]
  exact canonicalBasis.constr_basis ℤ _ scale

@[simp] theorem volumeRole_delta (scale : Units NNReal) :
    volumeRole (delta scale) =
      (scaleValue scale)⁻¹ •
        (volume.toTemperedDistribution : ComplexTempered) := by
  rw [← canonicalBasis_apply scale]
  exact canonicalBasis.constr_basis ℤ _ scale

theorem fourier_zeroRole_delta (scale : Units NNReal) :
    FourierTransform.fourier (zeroRole (delta scale)) =
      (volume.toTemperedDistribution : ComplexTempered) := by
  rw [zeroRole_delta]
  exact TemperedDistribution.fourier_delta_zero

theorem fourier_volumeRole_delta (scale : Units NNReal) :
    FourierTransform.fourier (volumeRole (delta scale)) =
      (scaleValue scale)⁻¹ • zeroRole (delta scale) := by
  rw [volumeRole_delta, zeroRole_delta]
  ext test
  have exchange := congrArg (fun distribution : ComplexTempered ↦
    distribution test) fourier_volume_toTemperedDistribution
  simp only [TemperedDistribution.fourier_apply,
    TemperedDistribution.delta_apply] at exchange ⊢
  exact congrArg
    (fun value : ℂ ↦ (scaleValue scale)⁻¹ • value) exchange

theorem thetaDistributionScalePull_delta_zero (scale : Units NNReal) :
    thetaDistributionScalePull (scaleValue scale)
        (scaleValue_pos scale).ne' (TemperedDistribution.delta 0) =
      TemperedDistribution.delta 0 := by
  ext test
  simp [thetaDistributionScalePull_apply, scaledSchwartzTest_apply]

theorem thetaDistributionScalePull_volume (scale : Units NNReal) :
    thetaDistributionScalePull (scaleValue scale)
        (scaleValue_pos scale).ne'
        (volume.toTemperedDistribution : ComplexTempered) =
      (scaleValue scale)⁻¹ •
        (volume.toTemperedDistribution : ComplexTempered) := by
  ext test
  rw [thetaDistributionScalePull_apply]
  simp only [Measure.toTemperedDistribution_apply,
    scaledSchwartzTest_apply]
  have changeVariables := Measure.integral_comp_smul
    (volume : Measure ℝ) (fun x : ℝ ↦ test x) (scaleValue scale)
  simp only [Module.finrank_self, pow_one,
    abs_of_pos (inv_pos.mpr (scaleValue_pos scale))] at changeVariables
  exact changeVariables

theorem thetaDistributionScalePull_combRole_delta
    (outer inner : Units NNReal) :
    thetaDistributionScalePull (scaleValue outer)
        (scaleValue_pos outer).ne' (combRole (delta inner)) =
      combRole (delta (outer * inner)) := by
  rw [combRole_delta, combRole_delta]
  exact (thetaAtScale_mul outer inner).symm

theorem thetaDistributionScalePull_zeroRole_delta
    (outer inner : Units NNReal) :
    thetaDistributionScalePull (scaleValue outer)
        (scaleValue_pos outer).ne' (zeroRole (delta inner)) =
      zeroRole (delta (outer * inner)) := by
  rw [zeroRole_delta, zeroRole_delta,
    thetaDistributionScalePull_delta_zero]

theorem thetaDistributionScalePull_volumeRole_delta
    (outer inner : Units NNReal) :
    thetaDistributionScalePull (scaleValue outer)
        (scaleValue_pos outer).ne' (volumeRole (delta inner)) =
      volumeRole (delta (outer * inner)) := by
  rw [volumeRole_delta, volumeRole_delta]
  ext test
  rw [thetaDistributionScalePull_apply]
  change (scaleValue inner)⁻¹ •
      (∫ x : ℝ, test (scaleValue outer * x)) =
    (scaleValue (outer * inner))⁻¹ •
      ∫ x : ℝ, test x
  have changeVariables := Measure.integral_comp_smul
    (volume : Measure ℝ) (fun x : ℝ ↦ test x) (scaleValue outer)
  simp only [Module.finrank_self, pow_one,
    abs_of_pos (inv_pos.mpr (scaleValue_pos outer))] at changeVariables
  have changeVariables' :
      (∫ x : ℝ, test (scaleValue outer * x)) =
        (scaleValue outer)⁻¹ • ∫ x : ℝ, test x := by
    simpa only [smul_eq_mul] using changeVariables
  rw [changeVariables', scaleValue_mul, smul_smul]
  congr 1
  field_simp [ne_of_gt (scaleValue_pos outer),
    ne_of_gt (scaleValue_pos inner)]

/-- Diagonal global remainder role on the common integral carrier. -/
def remainderRole : IntegralScaleCarrier →ₗ[ℤ] ComplexTempered :=
  combRole - zeroRole - volumeRole

@[simp] theorem remainderRole_delta (scale : Units NNReal) :
    remainderRole (delta scale) =
      thetaAtScale scale - TemperedDistribution.delta 0 -
        (scaleValue scale)⁻¹ •
          (volume.toTemperedDistribution : ComplexTempered) := by
  simp [remainderRole]

theorem thetaDistributionScalePull_remainderRole_delta
    (outer inner : Units NNReal) :
    thetaDistributionScalePull (scaleValue outer)
        (scaleValue_pos outer).ne' (remainderRole (delta inner)) =
      remainderRole (delta (outer * inner)) := by
  simp only [remainderRole, LinearMap.sub_apply]
  rw [map_sub, map_sub,
    thetaDistributionScalePull_combRole_delta,
    thetaDistributionScalePull_zeroRole_delta,
    thetaDistributionScalePull_volumeRole_delta]

/-- Source left translation of the integral carrier is the actual scale
pull of the joint global remainder. -/
theorem remainderRole_translation_covariance (scale : Units NNReal) :
    remainderRole.comp (leftTranslation scale).toLinearMap =
      ((thetaDistributionScalePull (scaleValue scale)
        (scaleValue_pos scale).ne').restrictScalars ℤ).toLinearMap.comp
          remainderRole := by
  apply MonoidAlgebra.lhom_ext'
  intro basisScale
  apply LinearMap.ext
  intro coefficient
  simp only [LinearMap.comp_apply, MonoidAlgebra.lsingle_apply]
  rw [show MonoidAlgebra.single basisScale coefficient =
      coefficient • delta basisScale by simp [delta]]
  simp only [map_smul]
  congr 1
  change remainderRole (leftTranslation scale (delta basisScale)) = _
  rw [leftTranslation_delta]
  exact (thetaDistributionScalePull_remainderRole_delta
    scale basisScale).symm

/-- Test evaluation of the diagonal role is literally the existing Müntz
scale remainder. -/
theorem remainderRole_delta_apply
    (scale : Units NNReal) (test : SchwartzMap ℝ ℂ) :
    remainderRole (delta scale) test =
      coPoissonMuntzScaleRemainder test (scaleValue scale) := by
  rw [coPoissonMuntzScaleRemainder_eq_leftRole scale test]
  simp [remainderRole, combRole]

theorem coPoissonMuntzScaleRemainder_one
    (test : SchwartzMap ℝ ℂ) :
    coPoissonMuntzScaleRemainder test 1 =
      clozelTemperedRemainder test := by
  rw [coPoissonMuntzScaleRemainder_eq test (by norm_num)]
  rw [clozelTemperedRemainder_apply_nonzero]
  unfold coPoissonMuntzThetaNonzero
  simp

/-- The unit basis is exactly Clozel's original global remainder. -/
theorem remainderRole_delta_one :
    remainderRole (delta (1 : Units NNReal)) =
      clozelTemperedRemainder := by
  ext test
  rw [remainderRole_delta_apply]
  simpa [scaleValue] using coPoissonMuntzScaleRemainder_one test

end
end GlobalCoPoissonRoleRepresentation
end ClozelGeneralizedDual
end CanonicalRiemann
end NoIslandNoMagic
end ConstructiveRoot
end LivingLawEvolution
end ResponsibilityLifecycle
end SaturationMonoid
