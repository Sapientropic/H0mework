import Mathlib.GroupTheory.Finiteness
import H0mework.Realization.Integral.FaithfulAction
import H0mework.Realization.Completion.PrimePowerQuotient
import H0mework.Arithmetic.Tempered.MuntzTheta

/-!
# Tempered theta prime-power integral face

The scaled integer comb is bundled as an actual tempered distribution.  At
every prime power, Poisson summation supplies whole and quotient roles inside
the cyclic integral subgroup generated by the quotient distribution.  This
is an owner-free finite-stage producer; it does not claim a cofinal global
cocycle or install an arbitrary test in authority.
-/

set_option autoImplicit false

namespace SaturationMonoid
namespace ResponsibilityLifecycle
namespace LivingLawEvolution
namespace ConstructiveRoot
namespace NoIslandNoMagic
namespace CanonicalRiemann
namespace ClozelGeneralizedDual

open ClozelEndpointSourceEffect
open PrimePowerQuotientEvaluation
open SourceGeneratedFaithfulIntegralFace
open scoped SchwartzMap

noncomputable section

/-- The integer comb precomposed with actual positive scaling. -/
def coPoissonMuntzThetaDistribution
    (scale : ℝ) (nonzero : scale ≠ 0) : ComplexTempered :=
  PointwiseConvergenceCLM.precomp ℂ
    (SchwartzMap.compCLMOfContinuousLinearEquiv ℂ
      (realScaleEquiv scale nonzero)) integerDiracComb

@[simp] theorem coPoissonMuntzThetaDistribution_apply
    (scale : ℝ) (nonzero : scale ≠ 0) (test : SchwartzMap ℝ ℂ) :
    coPoissonMuntzThetaDistribution scale nonzero test =
      coPoissonMuntzTheta test scale := by
  change integerDiracComb (scaledSchwartzTest scale nonzero test) = _
  rw [integerDiracComb_apply,
    coPoissonMuntzTheta_eq_integer_tsum test nonzero]
  rfl

def thetaDistributionPrimePower
    (prime : Nat.Primes) (exponent : Nat) : Nat :=
  (prime : Nat) ^ exponent

theorem thetaDistributionPrimePower_pos
    (prime : Nat.Primes) (exponent : Nat) :
    0 < thetaDistributionPrimePower prime exponent :=
  pow_pos prime.2.pos _

def thetaDistributionWhole
    (prime : Nat.Primes) (exponent : Nat) : ComplexTempered :=
  coPoissonMuntzThetaDistribution
    (1 / (thetaDistributionPrimePower prime exponent : ℝ))
    (one_div_ne_zero (by
      exact_mod_cast (thetaDistributionPrimePower_pos prime exponent).ne'))

def thetaDistributionQuotient
    (prime : Nat.Primes) (exponent : Nat) : ComplexTempered :=
  FourierTransform.fourier (coPoissonMuntzThetaDistribution
    (thetaDistributionPrimePower prime exponent : ℝ)
    (by exact_mod_cast (thetaDistributionPrimePower_pos prime exponent).ne'))

/-- Distribution-level Poisson landing, not just a scalar test equality. -/
theorem thetaDistributionWhole_eq_primePower_nsmul_quotient
    (prime : Nat.Primes) (exponent : Nat) :
    thetaDistributionWhole prime exponent =
      thetaDistributionPrimePower prime exponent •
        thetaDistributionQuotient prime exponent := by
  ext test
  rw [thetaDistributionWhole, thetaDistributionQuotient,
    coPoissonMuntzThetaDistribution_apply]
  change coPoissonMuntzTheta test
      (1 / (thetaDistributionPrimePower prime exponent : ℝ)) =
    thetaDistributionPrimePower prime exponent •
      (FourierTransform.fourier (coPoissonMuntzThetaDistribution
        (thetaDistributionPrimePower prime exponent : ℝ) _) test)
  rw [TemperedDistribution.fourier_apply,
    coPoissonMuntzThetaDistribution_apply]
  have poisson := coPoissonMuntzTheta_fourier_equation test
    (show 0 < (thetaDistributionPrimePower prime exponent : ℝ) by
      exact_mod_cast thetaDistributionPrimePower_pos prime exponent)
  calc
    _ = ((thetaDistributionPrimePower prime exponent : Nat) : ℂ) •
        coPoissonMuntzTheta (FourierTransform.fourier test)
          (thetaDistributionPrimePower prime exponent : ℝ) := poisson
    _ = _ := Nat.cast_smul_eq_nsmul ℂ _ _

abbrev ThetaDistributionPrimePowerIntegralFace
    (prime : Nat.Primes) (exponent : Nat) : AddSubgroup ComplexTempered :=
  AddSubgroup.zmultiples (thetaDistributionQuotient prime exponent)

def thetaDistributionQuotientElement
    (prime : Nat.Primes) (exponent : Nat) :
    ThetaDistributionPrimePowerIntegralFace prime exponent :=
  ⟨thetaDistributionQuotient prime exponent,
    AddSubgroup.mem_zmultiples _⟩

def thetaDistributionWholeElement
    (prime : Nat.Primes) (exponent : Nat) :
    ThetaDistributionPrimePowerIntegralFace prime exponent :=
  ⟨thetaDistributionWhole prime exponent, by
    rw [AddSubgroup.mem_zmultiples_iff]
    exact ⟨thetaDistributionPrimePower prime exponent,
      (thetaDistributionWhole_eq_primePower_nsmul_quotient
        prime exponent).symm⟩⟩

theorem thetaDistributionWholeElement_eq_primePower_nsmul_quotientElement
    (prime : Nat.Primes) (exponent : Nat) :
    thetaDistributionWholeElement prime exponent =
      thetaDistributionPrimePower prime exponent •
        thetaDistributionQuotientElement prime exponent := by
  apply Subtype.ext
  exact thetaDistributionWhole_eq_primePower_nsmul_quotient prime exponent

theorem thetaDistributionIntegralFace_finiteGenerated
    (prime : Nat.Primes) (exponent : Nat) :
    AddGroup.FG (ThetaDistributionPrimePowerIntegralFace prime exponent) := by
  change AddGroup.FG
    (AddSubgroup.zmultiples (thetaDistributionQuotient prime exponent))
  rw [← AddSubgroup.range_zmultiplesHom]
  infer_instance

def thetaDistributionIntegralRealization
    (prime : Nat.Primes) (exponent : Nat) :
    ThetaDistributionPrimePowerIntegralFace prime exponent →ₗ[ℤ]
      ComplexTempered where
  toFun := Subtype.val
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

def thetaDistributionFaithfulIntegralFace
    (prime : Nat.Primes) (exponent : Nat) :
    FaithfulIntegralFace
      (L := ThetaDistributionPrimePowerIntegralFace prime exponent)
      (Ambient := ComplexTempered) where
  realization := thetaDistributionIntegralRealization prime exponent
  injective := Subtype.val_injective

/-- Direct frozen local-process consumer at this exact prime power. -/
theorem thetaDistributionWhole_quotientEvaluation_eq_zero
    (prime : Nat.Primes) (exponent : Nat) :
    PrimePowerQuotientEvaluation.evaluator
        (ThetaDistributionPrimePowerIntegralFace prime exponent)
        (thetaDistributionWholeElement prime exponent)
        prime exponent = 0 := by
  apply (QuotientAddGroup.eq_zero_iff _).2
  exact ⟨thetaDistributionQuotientElement prime exponent,
    (thetaDistributionWholeElement_eq_primePower_nsmul_quotientElement
      prime exponent).symm⟩

end
