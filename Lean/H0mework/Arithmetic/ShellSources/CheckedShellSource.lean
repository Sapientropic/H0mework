/-!
# SU(7) finite checker sources produce nonempty checked shells

P1037 named the right low-level throat:

```text
SU7NoPrimeNonemptyCheckedShellEveryEvenFiber C
```

This file makes the source-facing input explicit.  A stronger face such as
information, representation, encoding, or finite spectrum does not need to
emit a residual normalizer, a prime-edge loop, or a zero endpoint.  It only has
to emit a finite no-prime source list, the raw-code bound check, the executable
endpoint-energy coverage check, and nonemptiness.

For the canonical raw-code generated list, P956 already transports
`GeneratedRawEnergyCoverage` into the no-prime Boolean coverage check, and
P960 supplies nonemptiness from any bound containing `2`.  Hence P1048's finite
generated Boolean coverage object now lands directly in the P1037 throat.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open RunningSigmaBeta

set_option linter.defProp false

/-! ## Finite checked-shell source packets -/

/-- A source-facing finite checker packet for one SU(7) fiber.

This is deliberately lower than a normalizer: it is just the finite no-prime
list, the endpoint-code bound validation, the Boolean residual-energy coverage
check, and nonemptiness. -/
structure SU7FiniteNoPrimeCheckedShellSource
    (C : SU7WeightTensorCoding) (n : ℕ) where
  cells : List (SU7NoPrimeBranchingSpectrumCell C n)
  rawCodeBound : ℕ
  cells_within_bound :
    NoPrimeBranchingCellsWithinBound rawCodeBound cells
  coverage_check :
    noPrimeBranchingEnergyShellCoverageCheck cells
      (maxNoPrimeBranchingEndpointResidualEnergyOfCells cells) = true
  cells_nonempty : cells ≠ []

/-- Turn a finite checker source packet into the P954 checked rule. -/
def checkedEnergyShellRule_of_finiteNoPrimeCheckedShellSource
    {C : SU7WeightTensorCoding} {n : ℕ}
    (S : SU7FiniteNoPrimeCheckedShellSource C n) :
    SU7NoPrimeBranchingCheckedEnergyShellRule C n where
  cells := S.cells
  rawCodeBound := S.rawCodeBound
  cells_within_bound := S.cells_within_bound
  coverage_check := S.coverage_check

/-- A finite checker source packet is exactly enough to produce the P1037
nonempty checked-shell throat. -/
def nonemptyCheckedShell_of_finiteNoPrimeCheckedShellSource
    {C : SU7WeightTensorCoding} {n : ℕ}
    (S : SU7FiniteNoPrimeCheckedShellSource C n) :
    SU7NoPrimeNonemptyCheckedShell C n where
  rule := checkedEnergyShellRule_of_finiteNoPrimeCheckedShellSource S
  cells_nonempty := S.cells_nonempty

/-- Every even fiber carries a finite checker source packet. -/
def SU7FiniteNoPrimeCheckedShellSourceEveryEvenFiber
    (C : SU7WeightTensorCoding) : Prop :=
  ∀ n : ℕ, 2 ≤ n -> Nonempty (SU7FiniteNoPrimeCheckedShellSource C n)

/-- The generated no-prime allowed predicate for the raw-code finite checker
route.  It is generated from the finite SU(7) no-prime source list, not
supplied as an external Boolean selector. -/
def generatedNoPrimeAllowedPredicate (n bound : ℕ) : ℕ -> ℕ -> Bool :=
  noPrimeBranchingAllowedPredicate (generatedNoPrimeBranchingCells n bound)

/-! ## Sigma residual gap objectification -/

/-- A declared residual domain records the three legitimate ways positive
headroom can avoid becoming a naked terminal residue: it is already carried by
a legal shell, it is generated by a producer trace, or it is a declared
obstruction.  Completeness is a separate theorem, not a field smuggled into
the data. -/
structure ResidualDomainDeclaration (ι : Type*) where
  residualEnergy : ι -> ℕ
  legalCarrier : ι -> Prop
  generated : ι -> Prop
  obstruction : ι -> Prop

/-- Completeness for a residual domain: every positive residual object is
accounted for by a legal carrier, a producer/generated trace, or an explicit
obstruction. -/
def DeclaredCompleteResidualDomain {ι : Type*}
    (D : ResidualDomainDeclaration ι) : Prop :=
  ∀ x : ι, 0 < D.residualEnergy x ->
    D.legalCarrier x ∨ D.generated x ∨ D.obstruction x

/-- A bare positive residual is positive headroom with no legal carrier, no
producer/generated trace, and no declared obstruction. -/
def BarePositiveResidual {ι : Type*}
    (D : ResidualDomainDeclaration ι) (x : ι) : Prop :=
  0 < D.residualEnergy x ∧
    ¬ D.legalCarrier x ∧ ¬ D.generated x ∧ ¬ D.obstruction x

/-- A naked positive residual gap packages the illegal terminal residue as an
object, rather than renaming coverage failure as a missing Boolean. -/
structure NakedPositiveResidualGap {ι : Type*}
    (D : ResidualDomainDeclaration ι) where
  carrier : ι
  bare : BarePositiveResidual D carrier

/-- Declared completeness rules out bare positive residuals. -/
theorem noBarePositiveResidual_of_declaredCompleteResidualDomain
    {ι : Type*} {D : ResidualDomainDeclaration ι}
    (Hcomplete : DeclaredCompleteResidualDomain D) {x : ι} :
    ¬ BarePositiveResidual D x := by
  intro hbare
  rcases hbare with ⟨hpos, hnotLegal, hnotGenerated, hnotObstruction⟩
  rcases Hcomplete x hpos with hlegal | hgenerated | hobstruction
  · exact hnotLegal hlegal
  · exact hnotGenerated hgenerated
  · exact hnotObstruction hobstruction

/-- Declared completeness rules out naked positive residual gaps. -/
theorem noNakedPositiveResidualGap_of_declaredCompleteResidualDomain
    {ι : Type*} {D : ResidualDomainDeclaration ι}
    (Hcomplete : DeclaredCompleteResidualDomain D) :
    ¬ Nonempty (NakedPositiveResidualGap D) := by
  intro hgap
  rcases hgap with ⟨gap⟩
  exact noBarePositiveResidual_of_declaredCompleteResidualDomain
    Hcomplete gap.bare

/-- Declared completeness is exactly absence of bare positive residuals.
This prevents `DeclaredCompleteResidualDomain` from becoming a new opaque
source premise: it is the domain-level no-gap theorem. -/
theorem declaredCompleteResidualDomain_iff_noBarePositiveResidual
    {ι : Type*} (D : ResidualDomainDeclaration ι) :
    DeclaredCompleteResidualDomain D ↔
      ∀ x : ι, ¬ BarePositiveResidual D x := by
  constructor
  · intro Hcomplete x
    exact noBarePositiveResidual_of_declaredCompleteResidualDomain
      Hcomplete
  · intro HnoBare x hpos
    by_cases hlegal : D.legalCarrier x
    · exact Or.inl hlegal
    · by_cases hgenerated : D.generated x
      · exact Or.inr (Or.inl hgenerated)
      · by_cases hobstruction : D.obstruction x
        · exact Or.inr (Or.inr hobstruction)
        · exact False.elim
            (HnoBare x ⟨hpos, hlegal, hgenerated, hobstruction⟩)

/-- Declared completeness is exactly absence of naked positive residual gaps.
The forward direction is the generic no-gap theorem above; the reverse
direction says any failed completeness witness is precisely a naked gap. -/
theorem declaredCompleteResidualDomain_iff_noNakedPositiveResidualGap
    {ι : Type*} (D : ResidualDomainDeclaration ι) :
    DeclaredCompleteResidualDomain D ↔
      ¬ Nonempty (NakedPositiveResidualGap D) := by
  constructor
  · intro Hcomplete
    exact noNakedPositiveResidualGap_of_declaredCompleteResidualDomain
      Hcomplete
  · intro HnoGap
    exact
      (declaredCompleteResidualDomain_iff_noBarePositiveResidual D).mpr
        (by
          intro x hbare
          exact HnoGap ⟨{ carrier := x, bare := hbare }⟩)

/-- A bare residual has been traced to an update-static nonzero residual of a
Truth Formula producer.  This is the formal hook for the σ active-fiber
transport argument: naked headroom would have to be a static produced
residual, and active transport forbids that. -/
def BarePositiveResidualStaticTrace
    {K E State ι : Type*} [Field K] [AddCommGroup E] [Module K E]
    (P : ResidualProjection.ResidualCarrierSystemProducer K E State)
    (D : ResidualDomainDeclaration ι) : Prop :=
  ∀ x : ι, BarePositiveResidual D x ->
    ∃ s : State,
      P.residual s ≠ 0 ∧ P.residual (P.update s) = P.residual s

/-- Truth Formula active transport rules out any bare positive residual whose
headroom has been traced to an update-static nonzero producer residual. -/
theorem noBarePositiveResidual_of_truthFormulaStaticTrace
    {K E State ι : Type*} [Field K] [AddCommGroup E] [Module K E]
    (P : ResidualProjection.ResidualCarrierSystemProducer K E State)
    (hactive : AffineRelaxation.ResidualTransportActive P.keep)
    {D : ResidualDomainDeclaration ι}
    (Htrace : BarePositiveResidualStaticTrace P D) {x : ι} :
    ¬ BarePositiveResidual D x := by
  intro hbare
  rcases Htrace x hbare with ⟨s, hnonzero, hstatic⟩
  exact
    (_root_.SaturationMonoid.ResidualProjection.residualCarrierSystemProducer_update_residual_ne_self_of_ne_zero
      P hactive hnonzero) hstatic

/-- Truth Formula active transport rules out naked positive residual gaps once
the gap has been traced to a static nonzero produced residual. -/
theorem noNakedPositiveResidualGap_of_truthFormulaStaticTrace
    {K E State ι : Type*} [Field K] [AddCommGroup E] [Module K E]
    (P : ResidualProjection.ResidualCarrierSystemProducer K E State)
    (hactive : AffineRelaxation.ResidualTransportActive P.keep)
    {D : ResidualDomainDeclaration ι}
    (Htrace : BarePositiveResidualStaticTrace P D) :
    ¬ Nonempty (NakedPositiveResidualGap D) := by
  intro hgap
  rcases hgap with ⟨gap⟩
  exact noBarePositiveResidual_of_truthFormulaStaticTrace
    P hactive Htrace gap.bare

/-- Under an active Truth Formula producer, the static-trace premise is not a
new source gate: it is exactly absence of naked positive residual gaps.  The
reverse direction is empty because, when no naked gap exists, no bare residual
can demand a trace. -/
theorem barePositiveResidualStaticTrace_iff_noNakedPositiveResidualGap_of_activeProducer
    {K E State ι : Type*} [Field K] [AddCommGroup E] [Module K E]
    (P : ResidualProjection.ResidualCarrierSystemProducer K E State)
    (hactive : AffineRelaxation.ResidualTransportActive P.keep)
    (D : ResidualDomainDeclaration ι) :
    BarePositiveResidualStaticTrace P D ↔
      ¬ Nonempty (NakedPositiveResidualGap D) := by
  constructor
  · intro Htrace
    exact noNakedPositiveResidualGap_of_truthFormulaStaticTrace
      P hactive Htrace
  · intro HnoGap x hbare
    exact False.elim (HnoGap ⟨{ carrier := x, bare := hbare }⟩)

/-- The declared finite shell objects for a filtered raw-code pair coverage
problem.  The carrier is bounded by the generated maximum, so completeness is
only claimed over the shells that the finite checker actually declares. -/
abbrev BoolGaugeFilteredResidualShell
    (n bound : ℕ) : Type :=
  { k : ℕ // k < generatedRawBranchingMaxEnergy n bound }

/-- The concrete residual domain for a filtered raw-code pair coverage problem.
A declared shell `k` is represented as positive residual energy `k + 1`; this
keeps the gap object positive while its legal-carrier predicate is exactly
realization of that shell.  There are no built-in generated traces or
obstructions in this finite checker domain, so those exclusions must be
discharged explicitly. -/
def boolGaugeFilteredRawCodePairResidualDomain
    (n bound : ℕ) (allowed : ℕ -> ℕ -> Bool) :
    ResidualDomainDeclaration
      (BoolGaugeFilteredResidualShell n bound) where
  residualEnergy := fun shell => shell.1 + 1
  legalCarrier := fun shell =>
    BoolGaugeFilteredRawCodePairEnergyShellRealized
      n bound allowed shell.1
  generated := fun _ => False
  obstruction := fun _ => False

/-- A filtered coverage failure produces a naked positive residual gap in the
declared finite-checker domain.  The proof explicitly shows that the gap is
not legal-carried by a realized shell, not generated, and not obstructed. -/
theorem nakedPositiveResidualGap_of_boolGaugeFilteredCoverageFailure
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool}
    (hfail :
      ¬ BoolGaugeFilteredRawCodePairEnergyCoverage n bound allowed) :
    Nonempty
      (NakedPositiveResidualGap
        (boolGaugeFilteredRawCodePairResidualDomain n bound allowed)) := by
  by_contra hnoGap
  apply hfail
  intro k hk
  by_contra hmissing
  let shell : BoolGaugeFilteredResidualShell n bound := ⟨k, hk⟩
  have hbare :
      BarePositiveResidual
        (boolGaugeFilteredRawCodePairResidualDomain n bound allowed)
        shell := by
    refine ⟨Nat.succ_pos k, ?_, ?_, ?_⟩
    · intro hlegal
      exact hmissing hlegal
    · intro hgenerated
      cases hgenerated
    · intro hobstruction
      cases hobstruction
  exact hnoGap ⟨{ carrier := shell, bare := hbare }⟩

/-- In the bounded declared finite-checker domain, a naked positive residual
gap is exactly a filtered coverage failure. -/
theorem boolGaugeFilteredCoverageFailure_of_nakedPositiveResidualGap
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool}
    (hgap :
      Nonempty
        (NakedPositiveResidualGap
          (boolGaugeFilteredRawCodePairResidualDomain n bound allowed))) :
    ¬ BoolGaugeFilteredRawCodePairEnergyCoverage n bound allowed := by
  intro hcoverage
  rcases hgap with ⟨gap⟩
  rcases gap.bare with ⟨_hpos, hnotLegal, _hnotGenerated, _hnotObstruction⟩
  exact hnotLegal (hcoverage gap.carrier.1 gap.carrier.2)

/-- Bounded declared finite-checker form of the slogan: coverage failure is
equivalent to a naked positive residual gap. -/
theorem boolGaugeFilteredCoverageFailure_iff_nakedPositiveResidualGap
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool} :
    (¬ BoolGaugeFilteredRawCodePairEnergyCoverage n bound allowed) ↔
      Nonempty
        (NakedPositiveResidualGap
          (boolGaugeFilteredRawCodePairResidualDomain n bound allowed)) :=
  ⟨nakedPositiveResidualGap_of_boolGaugeFilteredCoverageFailure,
    boolGaugeFilteredCoverageFailure_of_nakedPositiveResidualGap⟩

/-- A filtered coverage failure, once every bare residual has a producer trace,
is exactly a naked gap carrying an update-static nonzero Truth Formula
residual. -/
theorem truthFormulaStaticPositiveResidualTerminal_of_boolGaugeFilteredCoverageFailure
    {K E State : Type*} [Field K] [AddCommGroup E] [Module K E]
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool}
    (P : ResidualProjection.ResidualCarrierSystemProducer K E State)
    (Htrace :
      BarePositiveResidualStaticTrace P
        (boolGaugeFilteredRawCodePairResidualDomain n bound allowed))
    (hfail :
      ¬ BoolGaugeFilteredRawCodePairEnergyCoverage n bound allowed) :
    ∃ _gap :
        NakedPositiveResidualGap
          (boolGaugeFilteredRawCodePairResidualDomain n bound allowed),
      ∃ s : State,
        P.residual s ≠ 0 ∧ P.residual (P.update s) = P.residual s := by
  rcases nakedPositiveResidualGap_of_boolGaugeFilteredCoverageFailure
    hfail with ⟨gap⟩
  rcases Htrace gap.carrier gap.bare with ⟨s, hnonzero, hstatic⟩
  exact ⟨gap, s, hnonzero, hstatic⟩

/-- A static positive producer terminal contains a naked finite-checker gap,
so it implies filtered coverage failure in the bounded declared domain. -/
theorem boolGaugeFilteredCoverageFailure_of_truthFormulaStaticPositiveResidualTerminal
    {K E State : Type*} [Field K] [AddCommGroup E] [Module K E]
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool}
    {P : ResidualProjection.ResidualCarrierSystemProducer K E State}
    (hterminal :
      ∃ _gap :
          NakedPositiveResidualGap
            (boolGaugeFilteredRawCodePairResidualDomain n bound allowed),
        ∃ s : State,
          P.residual s ≠ 0 ∧ P.residual (P.update s) = P.residual s) :
    ¬ BoolGaugeFilteredRawCodePairEnergyCoverage n bound allowed := by
  rcases hterminal with ⟨gap, _s, _hnonzero, _hstatic⟩
  exact boolGaugeFilteredCoverageFailure_of_nakedPositiveResidualGap ⟨gap⟩

/-- Under a real bare-residual trace law, filtered coverage failure is
equivalent to a static nonzero Truth Formula residual terminal. -/
theorem boolGaugeFilteredCoverageFailure_iff_truthFormulaStaticPositiveResidualTerminal
    {K E State : Type*} [Field K] [AddCommGroup E] [Module K E]
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool}
    (P : ResidualProjection.ResidualCarrierSystemProducer K E State)
    (Htrace :
      BarePositiveResidualStaticTrace P
        (boolGaugeFilteredRawCodePairResidualDomain n bound allowed)) :
    (¬ BoolGaugeFilteredRawCodePairEnergyCoverage n bound allowed) ↔
      ∃ _gap :
          NakedPositiveResidualGap
            (boolGaugeFilteredRawCodePairResidualDomain n bound allowed),
        ∃ s : State,
          P.residual s ≠ 0 ∧ P.residual (P.update s) = P.residual s :=
  ⟨truthFormulaStaticPositiveResidualTerminal_of_boolGaugeFilteredCoverageFailure
      P Htrace,
    boolGaugeFilteredCoverageFailure_of_truthFormulaStaticPositiveResidualTerminal⟩

/-- Active Truth Formula transport forbids a static nonzero producer terminal. -/
theorem noTruthFormulaStaticPositiveResidualTerminal_of_activeProducer
    {K E State : Type*} [Field K] [AddCommGroup E] [Module K E]
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool}
    (P : ResidualProjection.ResidualCarrierSystemProducer K E State)
    (hactive : AffineRelaxation.ResidualTransportActive P.keep) :
    ¬
      (∃ _gap :
          NakedPositiveResidualGap
            (boolGaugeFilteredRawCodePairResidualDomain n bound allowed),
        ∃ s : State,
          P.residual s ≠ 0 ∧ P.residual (P.update s) = P.residual s) := by
  intro hterminal
  rcases hterminal with ⟨_gap, s, hnonzero, hstatic⟩
  exact
    (_root_.SaturationMonoid.ResidualProjection.residualCarrierSystemProducer_update_residual_ne_self_of_ne_zero
      P hactive hnonzero) hstatic

/-! ## Finite shell descent from top support -/

/-- Generic finite descent over declared shell energies: if the top declared
shell is realized and every positive realized shell has a realized predecessor,
then every declared shell is realized. -/
theorem finiteShellCoverage_of_topShell_and_predecessor
    (M : ℕ) (realized : ℕ -> Prop)
    (Htop : ∀ _hM : 0 < M, realized (M - 1))
    (Hpred :
      ∀ k : ℕ, 0 < k -> k < M -> realized k -> realized (k - 1)) :
    ∀ k : ℕ, k < M -> realized k := by
  induction M with
  | zero =>
      intro k hk
      exact False.elim ((Nat.not_lt_zero k) hk)
  | succ M ih =>
      intro k hk
      by_cases htop : k = M
      · subst k
        exact Htop (Nat.succ_pos M)
      · have hk_lt_M : k < M := by omega
        exact
          ih
            (fun hM =>
              Hpred M hM (Nat.lt_succ_self M)
                (Htop (Nat.succ_pos M)))
            (fun j hjpos hjlt hjrealized =>
              Hpred j hjpos (Nat.lt_trans hjlt (Nat.lt_succ_self M))
                hjrealized)
            k hk_lt_M

/-- The top declared shell is realized in a filtered raw-code pair domain. -/
def BoolGaugeFilteredTopShellRealized
    (n bound : ℕ) (allowed : ℕ -> ℕ -> Bool) : Prop :=
  ∀ _hmax : 0 < generatedRawBranchingMaxEnergy n bound,
    BoolGaugeFilteredRawCodePairEnergyShellRealized
      n bound allowed (generatedRawBranchingMaxEnergy n bound - 1)

/-- An allowed raw code-pair attains the computed generated maximum energy.
This is lower than top-shell support: P950 no-terminal transport can descend
from this witness to the actual top declared shell `max - 1`. -/
def BoolGaugeFilteredTopEnergyWitness
    (n bound : ℕ) (allowed : ℕ -> ℕ -> Bool) : Prop :=
  BoolGaugeFilteredRawCodePairEnergyShellRealized
    n bound allowed (generatedRawBranchingMaxEnergy n bound)

/-- Every positive realized filtered shell has a realized predecessor.  This
is the finite-shell version of "no terminal positive residual" and is lower
than full coverage. -/
def BoolGaugeFilteredShellPredecessorLaw
    (n bound : ℕ) (allowed : ℕ -> ℕ -> Bool) : Prop :=
  ∀ k : ℕ, 0 < k -> k < generatedRawBranchingMaxEnergy n bound ->
    BoolGaugeFilteredRawCodePairEnergyShellRealized n bound allowed k ->
      BoolGaugeFilteredRawCodePairEnergyShellRealized n bound allowed (k - 1)

/-- Top support plus predecessor descent covers every declared filtered shell.
This is the finite-descent form of the no-terminal-positive-residual route. -/
theorem boolGaugeFilteredCoverage_of_topShell_and_predecessor
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool}
    (Htop : BoolGaugeFilteredTopShellRealized n bound allowed)
    (Hpred : BoolGaugeFilteredShellPredecessorLaw n bound allowed) :
    BoolGaugeFilteredRawCodePairEnergyCoverage n bound allowed :=
  finiteShellCoverage_of_topShell_and_predecessor
    (generatedRawBranchingMaxEnergy n bound)
    (fun k => BoolGaugeFilteredRawCodePairEnergyShellRealized
      n bound allowed k)
    Htop Hpred

/-- The P950 unit-successor law is exactly the predecessor law needed by the
finite shell descent route.  This keeps the new finite-descent premise tied to
the existing no-terminal boundary instead of introducing an independent
successor assumption. -/
theorem boolGaugeFilteredShellPredecessorLaw_of_unitSuccessorLaw
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool}
    (Hunit :
      BoolGaugeFilteredRawCodePairEnergyUnitSuccessorLaw n bound allowed) :
    BoolGaugeFilteredShellPredecessorLaw n bound allowed := by
  intro k hkpos _hklt hrealized
  rcases hrealized with
    ⟨left, right, hallowed, hleft_mem, hright_mem,
      hleft_check, hright_check, henergy⟩
  have hnonzero :
      rawCodePairResidualEnergy n left right ≠ 0 := by
    intro hzero
    have hkzero : k = 0 := by
      simpa [hzero] using henergy.symm
    exact (Nat.ne_of_gt hkpos) hkzero
  rcases
      Hunit left right hallowed hleft_mem hright_mem
        hleft_check hright_check hnonzero with
    ⟨left', right', hallowed', hleft'_mem, hright'_mem,
      hleft'_check, hright'_check, hsucc⟩
  refine
    ⟨left', right', hallowed', hleft'_mem, hright'_mem,
      hleft'_check, hright'_check, ?_⟩
  omega

/-- P950 no-filtered-unit-holonomy produces the shell predecessor law consumed
by finite descent. -/
theorem boolGaugeFilteredShellPredecessorLaw_of_noFilteredHolonomy
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool}
    (Hno :
      BoolGaugeFilteredRawCodePairForbidsUnitPermanentHolonomy
        n bound allowed) :
    BoolGaugeFilteredShellPredecessorLaw n bound allowed :=
  boolGaugeFilteredShellPredecessorLaw_of_unitSuccessorLaw
    ((noFilteredRawCodePairPermanentHolonomy_iff_unitSuccessorLaw
      n bound allowed).mp Hno)

/-- Top support plus P950 no-filtered-unit-holonomy covers every declared
filtered shell.  The only remaining source premise is top active support; the
successor/descent side is now the existing no-terminal law. -/
theorem boolGaugeFilteredCoverage_of_topShell_and_noFilteredHolonomy
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool}
    (Htop : BoolGaugeFilteredTopShellRealized n bound allowed)
    (Hno :
      BoolGaugeFilteredRawCodePairForbidsUnitPermanentHolonomy
        n bound allowed) :
    BoolGaugeFilteredRawCodePairEnergyCoverage n bound allowed :=
  boolGaugeFilteredCoverage_of_topShell_and_predecessor
    Htop
    (boolGaugeFilteredShellPredecessorLaw_of_noFilteredHolonomy Hno)

/-- An allowed max-energy witness plus P950 no-filtered-unit-holonomy produces
the top declared shell `max - 1`. -/
theorem boolGaugeFilteredTopShellRealized_of_topEnergyWitness_and_noFilteredHolonomy
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool}
    (HtopEnergy :
      BoolGaugeFilteredTopEnergyWitness n bound allowed)
    (Hno :
      BoolGaugeFilteredRawCodePairForbidsUnitPermanentHolonomy
        n bound allowed) :
    BoolGaugeFilteredTopShellRealized n bound allowed := by
  intro hmax
  rcases HtopEnergy with
    ⟨left, right, hallowed, hleft_mem, hright_mem,
      hleft_check, hright_check, henergy⟩
  have Hunit :
      BoolGaugeFilteredRawCodePairEnergyUnitSuccessorLaw
        n bound allowed :=
    (noFilteredRawCodePairPermanentHolonomy_iff_unitSuccessorLaw
      n bound allowed).mp Hno
  have hnonzero :
      rawCodePairResidualEnergy n left right ≠ 0 := by
    intro hzero
    have hmax_zero : generatedRawBranchingMaxEnergy n bound = 0 := by
      simpa [hzero] using henergy.symm
    omega
  rcases
      Hunit left right hallowed hleft_mem hright_mem
        hleft_check hright_check hnonzero with
    ⟨left', right', hallowed', hleft'_mem, hright'_mem,
      hleft'_check, hright'_check, hsucc⟩
  refine
    ⟨left', right', hallowed', hleft'_mem, hright'_mem,
      hleft'_check, hright'_check, ?_⟩
  omega

/-- Max-energy support plus P950 no-filtered-unit-holonomy covers every
declared filtered shell. -/
theorem boolGaugeFilteredCoverage_of_topEnergyWitness_and_noFilteredHolonomy
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool}
    (HtopEnergy :
      BoolGaugeFilteredTopEnergyWitness n bound allowed)
    (Hno :
      BoolGaugeFilteredRawCodePairForbidsUnitPermanentHolonomy
        n bound allowed) :
    BoolGaugeFilteredRawCodePairEnergyCoverage n bound allowed :=
  boolGaugeFilteredCoverage_of_topShell_and_noFilteredHolonomy
    (boolGaugeFilteredTopShellRealized_of_topEnergyWitness_and_noFilteredHolonomy
      HtopEnergy Hno)
    Hno

/-- The canonical generated no-prime list supplies its own allowed max-energy
witness.  The max is selected on the no-prime finite list, then transported
back across the generated raw/no-prime max equality. -/
theorem boolGaugeFilteredTopEnergyWitness_of_generatedNoPrimeCells
    {n bound : ℕ}
    (hbound : 2 ≤ bound) :
    BoolGaugeFilteredTopEnergyWitness
      n bound (generatedNoPrimeAllowedPredicate n bound) := by
  have hnonempty :
      generatedNoPrimeBranchingCells n bound ≠ [] :=
    generatedNoPrimeBranchingCells_nonempty_of_bound_ge_two n bound hbound
  rcases
      exists_mem_energy_eq_maxNoPrimeEndpointEnergyOfCells_of_ne_nil
        (generatedNoPrimeBranchingCells n bound) hnonempty with
    ⟨B, hBmem, hBenergy⟩
  have hshell :
      NoPrimeBranchingEndpointShellRealizedUpToGeneratedMax
        (generatedNoPrimeBranchingCells n bound)
        (generatedRawBranchingMaxEnergy n bound) := by
    refine ⟨B, hBmem, ?_⟩
    rw [generatedRawMaxEnergy_eq_generatedNoPrimeMaxEnergy]
    exact hBenergy
  simpa [BoolGaugeFilteredTopEnergyWitness, generatedNoPrimeAllowedPredicate]
    using
      (boolGaugeFilteredShell_of_noPrimeEndpointShell
        (generatedNoPrimeBranchingCellsWithinBound n bound)
        hshell)

/-- For the generated no-prime allowed sector, P950 no-filtered-unit-holonomy
alone covers every declared shell.  Top energy support is produced by the
finite generated no-prime list, so unit-density is no longer a separate premise
on this route. -/
theorem boolGaugeFilteredCoverage_of_generatedNoPrimeNoFilteredHolonomy
    {n bound : ℕ}
    (hbound : 2 ≤ bound)
    (Hno :
      BoolGaugeFilteredRawCodePairForbidsUnitPermanentHolonomy
        n bound (generatedNoPrimeAllowedPredicate n bound)) :
    BoolGaugeFilteredRawCodePairEnergyCoverage
      n bound (generatedNoPrimeAllowedPredicate n bound) :=
  boolGaugeFilteredCoverage_of_topEnergyWitness_and_noFilteredHolonomy
    (boolGaugeFilteredTopEnergyWitness_of_generatedNoPrimeCells hbound)
    Hno

/-- No naked positive residual gap gives filtered raw-code pair coverage. -/
theorem boolGaugeFilteredCoverage_of_noNakedPositiveResidualGap
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool}
    (HnoGap :
      ¬ Nonempty
        (NakedPositiveResidualGap
          (boolGaugeFilteredRawCodePairResidualDomain n bound allowed))) :
    BoolGaugeFilteredRawCodePairEnergyCoverage n bound allowed := by
  by_contra hfail
  exact HnoGap
    (nakedPositiveResidualGap_of_boolGaugeFilteredCoverageFailure hfail)

/-- In the declared finite-checker domain, filtered coverage is exactly the
absence of naked positive residual gaps.  This is the positive form of
`boolGaugeFilteredCoverageFailure_iff_nakedPositiveResidualGap`: a missing
shell is not a harmless Boolean miss, and conversely any naked gap is exactly
such a missing shell. -/
theorem boolGaugeFilteredCoverage_iff_noNakedPositiveResidualGap
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool} :
    BoolGaugeFilteredRawCodePairEnergyCoverage n bound allowed ↔
      ¬ Nonempty
        (NakedPositiveResidualGap
          (boolGaugeFilteredRawCodePairResidualDomain n bound allowed)) := by
  constructor
  · intro Hcoverage hgap
    exact boolGaugeFilteredCoverageFailure_of_nakedPositiveResidualGap
      hgap Hcoverage
  · intro HnoGap
    exact boolGaugeFilteredCoverage_of_noNakedPositiveResidualGap HnoGap

/-- In the concrete finite-checker domain, the static-trace premise collapses
to the same theorem as filtered coverage under active Truth Formula transport.
Thus assuming `BarePositiveResidualStaticTrace` here is no weaker source than
assuming the no-gap/coverage gate itself. -/
theorem boolGaugeFilteredTruthFormulaStaticTrace_iff_energyCoverage
    {K E State : Type*} [Field K] [AddCommGroup E] [Module K E]
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool}
    (P : ResidualProjection.ResidualCarrierSystemProducer K E State)
    (hactive : AffineRelaxation.ResidualTransportActive P.keep) :
    BarePositiveResidualStaticTrace P
        (boolGaugeFilteredRawCodePairResidualDomain n bound allowed) ↔
      BoolGaugeFilteredRawCodePairEnergyCoverage n bound allowed :=
  (barePositiveResidualStaticTrace_iff_noNakedPositiveResidualGap_of_activeProducer
      P hactive
      (boolGaugeFilteredRawCodePairResidualDomain n bound allowed)).trans
    boolGaugeFilteredCoverage_iff_noNakedPositiveResidualGap.symm

/-- Absence of naked positive residual gaps also discharges P950's
no-filtered-terminal law.  The proof passes through coverage as a theorem,
not as an input premise. -/
theorem boolGaugeFilteredNoFilteredHolonomy_of_noNakedPositiveResidualGap
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool}
    (HnoGap :
      ¬ Nonempty
        (NakedPositiveResidualGap
          (boolGaugeFilteredRawCodePairResidualDomain n bound allowed))) :
    BoolGaugeFilteredRawCodePairForbidsUnitPermanentHolonomy
      n bound allowed :=
  boolGaugeFilteredForbidsPermanentHolonomy_of_energyCoverage
    (boolGaugeFilteredCoverage_of_noNakedPositiveResidualGap HnoGap)

/-- On the generated no-prime allowed sector, P950 no-filtered-terminal is
equivalent to absence of naked positive residual gaps.  The forward direction
uses generated max-energy support plus P950 descent to prove coverage; the
backward direction uses the no-gap -> coverage -> no-terminal route. -/
theorem generatedNoPrimeNoFilteredHolonomy_iff_noNakedPositiveResidualGap
    {n bound : ℕ}
    (hbound : 2 ≤ bound) :
    BoolGaugeFilteredRawCodePairForbidsUnitPermanentHolonomy
        n bound (generatedNoPrimeAllowedPredicate n bound) ↔
      ¬ Nonempty
        (NakedPositiveResidualGap
          (boolGaugeFilteredRawCodePairResidualDomain
            n bound (generatedNoPrimeAllowedPredicate n bound))) := by
  constructor
  · intro Hno
    exact
      (boolGaugeFilteredCoverage_iff_noNakedPositiveResidualGap).mp
        (boolGaugeFilteredCoverage_of_generatedNoPrimeNoFilteredHolonomy
          hbound Hno)
  · intro HnoGap
    exact boolGaugeFilteredNoFilteredHolonomy_of_noNakedPositiveResidualGap
      HnoGap

/-- On the generated no-prime allowed sector, the static-trace premise is
equivalent to P950 no-filtered-terminal under active Truth Formula transport.
It therefore cannot be counted as an independent source producer either. -/
theorem generatedTruthFormulaStaticTrace_iff_noFilteredHolonomy
    {K E State : Type*} [Field K] [AddCommGroup E] [Module K E]
    {n bound : ℕ}
    (hbound : 2 ≤ bound)
    (P : ResidualProjection.ResidualCarrierSystemProducer K E State)
    (hactive : AffineRelaxation.ResidualTransportActive P.keep) :
    BarePositiveResidualStaticTrace P
        (boolGaugeFilteredRawCodePairResidualDomain
          n bound (generatedNoPrimeAllowedPredicate n bound)) ↔
      BoolGaugeFilteredRawCodePairForbidsUnitPermanentHolonomy
        n bound (generatedNoPrimeAllowedPredicate n bound) :=
  (barePositiveResidualStaticTrace_iff_noNakedPositiveResidualGap_of_activeProducer
      P hactive
      (boolGaugeFilteredRawCodePairResidualDomain
        n bound (generatedNoPrimeAllowedPredicate n bound))).trans
    (generatedNoPrimeNoFilteredHolonomy_iff_noNakedPositiveResidualGap
      hbound).symm

/-- In the concrete finite-checker residual domain, declared completeness is
not an independent source premise: it is exactly filtered coverage.  The
`generated` and `obstruction` fields of this domain are false, so completeness
can only be legal shell realization. -/
theorem boolGaugeFilteredDeclaredCompleteResidualDomain_iff_energyCoverage
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool} :
    DeclaredCompleteResidualDomain
        (boolGaugeFilteredRawCodePairResidualDomain n bound allowed) ↔
      BoolGaugeFilteredRawCodePairEnergyCoverage n bound allowed := by
  exact
    (declaredCompleteResidualDomain_iff_noNakedPositiveResidualGap
      (boolGaugeFilteredRawCodePairResidualDomain n bound allowed)).trans
        boolGaugeFilteredCoverage_iff_noNakedPositiveResidualGap.symm

/-- On the generated no-prime allowed sector, declared completeness is
equivalent to P950 no-filtered-terminal.  Thus declared completeness cannot be
counted as a separate producer from the no-gap / no-terminal frontier. -/
theorem generatedDeclaredCompleteResidualDomain_iff_noFilteredHolonomy
    {n bound : ℕ}
    (hbound : 2 ≤ bound) :
    DeclaredCompleteResidualDomain
        (boolGaugeFilteredRawCodePairResidualDomain
          n bound (generatedNoPrimeAllowedPredicate n bound)) ↔
      BoolGaugeFilteredRawCodePairForbidsUnitPermanentHolonomy
        n bound (generatedNoPrimeAllowedPredicate n bound) := by
  exact
    (declaredCompleteResidualDomain_iff_noNakedPositiveResidualGap
      (boolGaugeFilteredRawCodePairResidualDomain
        n bound (generatedNoPrimeAllowedPredicate n bound))).trans
      (generatedNoPrimeNoFilteredHolonomy_iff_noNakedPositiveResidualGap
        hbound).symm

/-- Declared completeness of the finite-checker residual domain lowers to the
A-target filtered coverage theorem. -/
theorem boolGaugeFilteredCoverage_of_declaredCompleteResidualDomain
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool}
    (Hcomplete :
      DeclaredCompleteResidualDomain
        (boolGaugeFilteredRawCodePairResidualDomain n bound allowed)) :
    BoolGaugeFilteredRawCodePairEnergyCoverage n bound allowed :=
  boolGaugeFilteredCoverage_of_noNakedPositiveResidualGap
    (noNakedPositiveResidualGap_of_declaredCompleteResidualDomain Hcomplete)

/-- Truth Formula active transport lowers to the A-target filtered coverage
theorem once every naked finite-checker residual has a static nonzero producer
trace. -/
theorem boolGaugeFilteredCoverage_of_truthFormulaStaticTrace
    {K E State : Type*} [Field K] [AddCommGroup E] [Module K E]
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool}
    (P : ResidualProjection.ResidualCarrierSystemProducer K E State)
    (hactive : AffineRelaxation.ResidualTransportActive P.keep)
    (Htrace :
      BarePositiveResidualStaticTrace P
        (boolGaugeFilteredRawCodePairResidualDomain n bound allowed)) :
    BoolGaugeFilteredRawCodePairEnergyCoverage n bound allowed :=
  boolGaugeFilteredCoverage_of_noNakedPositiveResidualGap
    (noNakedPositiveResidualGap_of_truthFormulaStaticTrace
      P hactive Htrace)

/-- Truth Formula active transport also discharges P950's no-filtered-terminal
law once the static-trace route has produced filtered coverage.  This keeps
P950 from remaining as a parallel hard premise on the static-trace branch:
coverage is not assumed, but obtained by excluding naked positive residuals. -/
theorem boolGaugeFilteredNoFilteredHolonomy_of_truthFormulaStaticTrace
    {K E State : Type*} [Field K] [AddCommGroup E] [Module K E]
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool}
    (P : ResidualProjection.ResidualCarrierSystemProducer K E State)
    (hactive : AffineRelaxation.ResidualTransportActive P.keep)
    (Htrace :
      BarePositiveResidualStaticTrace P
        (boolGaugeFilteredRawCodePairResidualDomain n bound allowed)) :
    BoolGaugeFilteredRawCodePairForbidsUnitPermanentHolonomy
      n bound allowed :=
  boolGaugeFilteredForbidsPermanentHolonomy_of_energyCoverage
    (boolGaugeFilteredCoverage_of_truthFormulaStaticTrace
      P hactive Htrace)

/-- Fiberwise finite checker source packets produce P1037 nonempty checked
shells on every even fiber. -/
theorem nonemptyCheckedShellEveryEvenFiber_of_finiteNoPrimeCheckedShellSourceEveryEvenFiber
    {C : SU7WeightTensorCoding}
    (H : SU7FiniteNoPrimeCheckedShellSourceEveryEvenFiber C) :
    SU7NoPrimeNonemptyCheckedShellEveryEvenFiber C := by
  intro n hn
  exact
    ⟨nonemptyCheckedShell_of_finiteNoPrimeCheckedShellSource
      (Classical.choice (H n hn))⟩

/-! ## Generated no-prime unit-confinement entrance -/

/-- A generated no-prime unit-confinement certificate produces the finite
checker source packet directly.

This exposes P960/P1037's real finite-checker content: generated no-prime
cells, a computed coverage check, and `(2, 2)` nonemptiness. -/
def finiteNoPrimeCheckedShellSource_of_generatedNoPrimeUnitConfinement
    {n : ℕ}
    (G : SU7GeneratedNoPrimeUnitConfinementCertificate n) :
    SU7FiniteNoPrimeCheckedShellSource rawCodeTensorCoding n where
  cells := generatedNoPrimeBranchingCells n G.codeBound
  rawCodeBound := G.codeBound
  cells_within_bound := generatedNoPrimeBranchingCellsWithinBound n G.codeBound
  coverage_check := generatedNoPrimeCoverageCheck_of_unitConfinementCertificate G
  cells_nonempty :=
    generatedNoPrimeBranchingCells_nonempty_of_bound_ge_two
      n G.codeBound G.codeBound_ge_two

/-- The same generated no-prime unit-confinement certificate lands in P1037's
nonempty checked-shell throat through the finite source packet. -/
def rawNonemptyCheckedShell_of_generatedNoPrimeUnitConfinement_via_finiteSource
    {n : ℕ}
    (G : SU7GeneratedNoPrimeUnitConfinementCertificate n) :
    SU7NoPrimeNonemptyCheckedShell rawCodeTensorCoding n :=
  nonemptyCheckedShell_of_finiteNoPrimeCheckedShellSource
    (finiteNoPrimeCheckedShellSource_of_generatedNoPrimeUnitConfinement G)

/-- Generated no-prime unit confinement forces the generated allowed-sector
raw code-pair energy coverage.

This is the finite-descent contrapositive route in source form: P960/P958 turn
`forbids_noPrime_unit_holonomy` into a generated no-prime coverage check, P967
raises that check to generated-max endpoint shell coverage, and P966 reads the
same generated source list as P965's Boolean allowed-sector coverage. -/
theorem boolGaugeFilteredCoverage_of_generatedNoPrimeUnitConfinement
    {n : ℕ}
    (G : SU7GeneratedNoPrimeUnitConfinementCertificate n) :
    BoolGaugeFilteredRawCodePairEnergyCoverage
      n G.codeBound
      (generatedNoPrimeAllowedPredicate n G.codeBound) := by
  unfold generatedNoPrimeAllowedPredicate
  exact
    boolGaugeFilteredCoverage_of_noPrimeEndpointCoverage
      (generatedNoPrimeBranchingCellsWithinBound n G.codeBound)
      (noPrimeEndpointShellCoverageUpToGeneratedMax_of_generatedNoPrimeCoverageCheck
        (generatedNoPrimeCoverageCheck_of_unitConfinementCertificate G))

/-- Generated no-prime strict no-terminal confinement plus unit-density forces
the generated allowed-sector raw code-pair energy coverage.

This is the source-side shape closest to the Truth Formula route: the hard
input is not coverage or a unit successor law, but absence of strict positive
residual terminals, plus the discrete unit-density bridge that turns any
strict lower-energy transport into a one-unit descent. -/
theorem boolGaugeFilteredCoverage_of_generatedNoPrimeNoStrictHolonomy_and_unitDensity
    {n bound : ℕ}
    (hbound : 2 ≤ bound)
    (Hstrict :
      NoPrimeBranchingCellsForbidStrictPermanentHolonomy
        (generatedNoPrimeBranchingCells n bound))
    (Hdense :
      NoPrimeBranchingCellEnergyUnitDensity
        (generatedNoPrimeBranchingCells n bound)) :
    BoolGaugeFilteredRawCodePairEnergyCoverage
      n bound (generatedNoPrimeAllowedPredicate n bound) := by
  refine
    boolGaugeFilteredCoverage_of_generatedNoPrimeUnitConfinement
      { codeBound := bound
        codeBound_ge_two := hbound
        forbids_noPrime_unit_holonomy := ?_ }
  exact
    (noPrimeNoUnitHolonomy_iff_cellUnitSuccessorLaw
      (generatedNoPrimeBranchingCells n bound)).mpr
      (noPrimeCellUnitSuccessorLaw_of_noStrictHolonomy_and_unitDensity
        Hstrict Hdense)

/-- Generated allowed-sector coverage produces the old strict-Lyapunov plus
unit-density data for the same generated no-prime finite list.  Thus those
two predicates are readouts of checked shell coverage, not separate source
objects. -/
theorem generatedNoPrimeNoStrictHolonomy_and_unitDensity_of_boolGaugeFilteredCoverage
    {n bound : ℕ}
    (Hcoverage :
      BoolGaugeFilteredRawCodePairEnergyCoverage
        n bound (generatedNoPrimeAllowedPredicate n bound)) :
    NoPrimeBranchingCellsForbidStrictPermanentHolonomy
        (generatedNoPrimeBranchingCells n bound) ∧
      NoPrimeBranchingCellEnergyUnitDensity
        (generatedNoPrimeBranchingCells n bound) := by
  let R : SU7NoPrimeBranchingCheckedEnergyShellRule
      rawCodeTensorCoding n :=
    { cells := generatedNoPrimeBranchingCells n bound
      rawCodeBound := bound
      cells_within_bound := generatedNoPrimeBranchingCellsWithinBound n bound
      coverage_check :=
        generatedNoPrimeCoverageCheck_of_generatedRawEnergyCoverage
          (generatedRawEnergyCoverage_of_boolGaugeFilteredCoverage Hcoverage) }
  exact
    ⟨noPrimeCheckedEnergyShell_forbidsStrictPermanentHolonomy R,
      noPrimeCheckedEnergyShell_energyUnitDensity R⟩

/-- On the generated no-prime allowed sector, strict no-terminal plus
unit-density is equivalent to filtered coverage.  The forward direction is the
old Lyapunov+density route; the reverse direction reads the same data out of
the finite checked shell. -/
theorem generatedNoPrimeNoStrictHolonomy_and_unitDensity_iff_boolGaugeFilteredCoverage
    {n bound : ℕ}
    (hbound : 2 ≤ bound) :
    (NoPrimeBranchingCellsForbidStrictPermanentHolonomy
        (generatedNoPrimeBranchingCells n bound) ∧
      NoPrimeBranchingCellEnergyUnitDensity
        (generatedNoPrimeBranchingCells n bound)) ↔
      BoolGaugeFilteredRawCodePairEnergyCoverage
        n bound (generatedNoPrimeAllowedPredicate n bound) := by
  constructor
  · intro H
    exact
      boolGaugeFilteredCoverage_of_generatedNoPrimeNoStrictHolonomy_and_unitDensity
        hbound H.1 H.2
  · intro Hcoverage
    exact
      generatedNoPrimeNoStrictHolonomy_and_unitDensity_of_boolGaugeFilteredCoverage
        Hcoverage

/-- Consequently, generated strict no-terminal plus unit-density is also
equivalent to the P950 generated allowed-sector no-terminal law.  This prevents
the old Lyapunov+density route from being counted as an independent lower
producer once the generated finite-checker domain is fixed. -/
theorem generatedNoPrimeNoStrictHolonomy_and_unitDensity_iff_noFilteredHolonomy
    {n bound : ℕ}
    (hbound : 2 ≤ bound) :
    (NoPrimeBranchingCellsForbidStrictPermanentHolonomy
        (generatedNoPrimeBranchingCells n bound) ∧
      NoPrimeBranchingCellEnergyUnitDensity
        (generatedNoPrimeBranchingCells n bound)) ↔
      BoolGaugeFilteredRawCodePairForbidsUnitPermanentHolonomy
        n bound (generatedNoPrimeAllowedPredicate n bound) :=
  (generatedNoPrimeNoStrictHolonomy_and_unitDensity_iff_boolGaugeFilteredCoverage
      hbound).trans
    ((boolGaugeFilteredCoverage_iff_noNakedPositiveResidualGap).trans
      (generatedNoPrimeNoFilteredHolonomy_iff_noNakedPositiveResidualGap
        hbound).symm)

/-- If generated allowed-sector coverage fails, the obstruction is not a loose
Boolean miss: either a strict positive residual terminal exists in the
generated no-prime list, or the unit-density bridge from strict descent to unit
descent fails. -/
theorem generatedNoPrimeStrictHolonomyWitnessOrDensityFailure_of_boolGaugeFilteredCoverageFailure
    {n bound : ℕ}
    (hbound : 2 ≤ bound)
    (hfail :
      ¬ BoolGaugeFilteredRawCodePairEnergyCoverage
          n bound (generatedNoPrimeAllowedPredicate n bound)) :
    Nonempty
        {B : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n //
          NoPrimeBranchingCellStrictPermanentHolonomy
            (generatedNoPrimeBranchingCells n bound) B} ∨
      ¬ NoPrimeBranchingCellEnergyUnitDensity
          (generatedNoPrimeBranchingCells n bound) := by
  by_cases Hstrict :
      NoPrimeBranchingCellsForbidStrictPermanentHolonomy
        (generatedNoPrimeBranchingCells n bound)
  · by_cases Hdense :
      NoPrimeBranchingCellEnergyUnitDensity
        (generatedNoPrimeBranchingCells n bound)
    · exact False.elim
        (hfail
          (boolGaugeFilteredCoverage_of_generatedNoPrimeNoStrictHolonomy_and_unitDensity
            hbound Hstrict Hdense))
    · exact Or.inr Hdense
  · have hex :
        ∃ B : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
          NoPrimeBranchingCellStrictPermanentHolonomy
            (generatedNoPrimeBranchingCells n bound) B := by
      by_contra hnone
      apply Hstrict
      intro B hperm
      exact hnone ⟨B, hperm⟩
    exact Or.inl ⟨⟨Classical.choose hex, Classical.choose_spec hex⟩⟩

/-- A single missing generated allowed-sector residual-energy shell produces
the same obstruction split: strict positive residual terminal witness, or
unit-density failure. -/
theorem generatedNoPrimeStrictHolonomyWitnessOrDensityFailure_of_missingAllowedShell
    {n bound k : ℕ}
    (hbound : 2 ≤ bound)
    (hk : k < generatedRawBranchingMaxEnergy n bound)
    (hmissing :
      ¬ BoolGaugeFilteredRawCodePairEnergyShellRealized
          n bound (generatedNoPrimeAllowedPredicate n bound) k) :
    Nonempty
        {B : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n //
          NoPrimeBranchingCellStrictPermanentHolonomy
            (generatedNoPrimeBranchingCells n bound) B} ∨
      ¬ NoPrimeBranchingCellEnergyUnitDensity
          (generatedNoPrimeBranchingCells n bound) := by
  exact
    generatedNoPrimeStrictHolonomyWitnessOrDensityFailure_of_boolGaugeFilteredCoverageFailure
      hbound
      (by
        intro Hcoverage
        exact hmissing (Hcoverage k hk))

/-- A strict positive residual terminal is in particular a unit terminal.  This
is the local bridge from the strict Lyapunov obstruction to P950's filtered
one-step permanent holonomy shape. -/
theorem noPrimeUnitHolonomy_of_strictHolonomy
    {C : SU7WeightTensorCoding} {n : ℕ}
    {xs : List (SU7NoPrimeBranchingSpectrumCell C n)}
    {B : SU7NoPrimeBranchingSpectrumCell C n}
    (H : NoPrimeBranchingCellStrictPermanentHolonomy xs B) :
    NoPrimeBranchingCellUnitPermanentHolonomy xs B := by
  rcases H with ⟨hmem, hnonzero, hterminal⟩
  refine ⟨hmem, hnonzero, ?_⟩
  intro B' hB'mem hsucc
  have hlt :
      noPrimeBranchingEndpointResidualEnergy B' <
        noPrimeBranchingEndpointResidualEnergy B := by
    omega
  exact hterminal B' hB'mem hlt

/-- A strict no-prime branch-cell terminal projects to the filtered raw
code-pair permanent-holonomy witness of P950. -/
theorem filteredRawCodePairHolonomy_of_noPrimeStrictHolonomy
    {C : SU7WeightTensorCoding} {n bound : ℕ}
    {xs : List (SU7NoPrimeBranchingSpectrumCell C n)}
    {B : SU7NoPrimeBranchingSpectrumCell C n}
    (hbounded : NoPrimeBranchingCellsWithinBound bound xs)
    (H : NoPrimeBranchingCellStrictPermanentHolonomy xs B) :
    BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
      n bound (noPrimeBranchingAllowedPredicate xs)
      (atomCode B.leftAtom.toSU7Atom)
      (atomCode B.rightAtom.toSU7Atom) :=
  filteredRawCodePairHolonomy_of_noPrimeUnitHolonomy
    hbounded
    (noPrimeUnitHolonomy_of_strictHolonomy H)

/-- A generated strict-terminal witness is already a filtered raw code-pair
holonomy witness on the generated allowed sector. -/
theorem generatedFilteredRawCodePairHolonomy_of_strictHolonomyWitness
    {n bound : ℕ}
    (Hstrict :
      Nonempty
        {B : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n //
          NoPrimeBranchingCellStrictPermanentHolonomy
            (generatedNoPrimeBranchingCells n bound) B}) :
    Nonempty
      {p : ℕ × ℕ //
        BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
          n bound (generatedNoPrimeAllowedPredicate n bound) p.1 p.2} := by
  rcases Hstrict with ⟨⟨B, HB⟩⟩
  refine
    ⟨⟨(atomCode B.leftAtom.toSU7Atom,
        atomCode B.rightAtom.toSU7Atom), ?_⟩⟩
  unfold generatedNoPrimeAllowedPredicate
  exact
    filteredRawCodePairHolonomy_of_noPrimeStrictHolonomy
      (generatedNoPrimeBranchingCellsWithinBound n bound) HB

/-- Any filtered raw code-pair holonomy witness contradicts filtered coverage.
This is the generic witness-level converse to P965's
coverage -> no-filtered-holonomy theorem. -/
theorem boolGaugeFilteredCoverageFailure_of_filteredRawCodePairHolonomy
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool}
    (Hhol :
      Nonempty
        {p : ℕ × ℕ //
          BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
            n bound allowed p.1 p.2}) :
    ¬ BoolGaugeFilteredRawCodePairEnergyCoverage n bound allowed := by
  intro Hcoverage
  rcases Hhol with ⟨⟨p, hp⟩⟩
  exact
    (boolGaugeFilteredForbidsPermanentHolonomy_of_energyCoverage
      Hcoverage) p.1 p.2 hp

/-- On the generated no-prime allowed sector, any coverage failure produces a
P950 filtered raw code-pair holonomy witness.  This removes the older
unit-density side condition from the witness route: if no such witness existed,
P950 no-terminal would give coverage by finite descent. -/
theorem generatedFilteredRawCodePairHolonomy_of_boolGaugeFilteredCoverageFailure
    {n bound : ℕ}
    (hbound : 2 ≤ bound)
    (hfail :
      ¬ BoolGaugeFilteredRawCodePairEnergyCoverage
          n bound (generatedNoPrimeAllowedPredicate n bound)) :
    Nonempty
      {p : ℕ × ℕ //
        BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
          n bound (generatedNoPrimeAllowedPredicate n bound) p.1 p.2} := by
  by_contra hnone
  apply hfail
  exact
