    {C : SU7WeightTensorCoding} {n bound : ℕ}
    {xs : List (SU7NoPrimeBranchingSpectrumCell C n)}
    (hbounded : NoPrimeBranchingCellsWithinBound bound xs) :
    maxNoPrimeBranchingEndpointResidualEnergyOfCells xs ≤
      generatedRawBranchingMaxEnergy n bound :=
  maxNoPrimeBranchingEndpointResidualEnergyOfCells_le_of_mem_bound
    (by
      intro B hmem
      exact
        noPrimeBranchingEndpointEnergy_le_generatedRawMaxEnergy_of_withinBound
          hbounded hmem)

/-- Endpoint shell coverage up to the generated raw maximum forces the
executable checked-shell coverage check on the source list's own computed
maximum. -/
theorem noPrimeCoverageCheck_of_noPrimeEndpointCoverage
    {C : SU7WeightTensorCoding} {n bound : ℕ}
    {xs : List (SU7NoPrimeBranchingSpectrumCell C n)}
    (hbounded : NoPrimeBranchingCellsWithinBound bound xs)
    (H : NoPrimeBranchingEndpointShellCoverageUpToGeneratedMax bound xs) :
    noPrimeBranchingEnergyShellCoverageCheck xs
      (maxNoPrimeBranchingEndpointResidualEnergyOfCells xs) = true := by
  unfold noPrimeBranchingEnergyShellCoverageCheck
  apply List.all_eq_true.mpr
  intro k hk
  have hklt_max :
      k < maxNoPrimeBranchingEndpointResidualEnergyOfCells xs :=
    List.mem_range.mp hk
  have hmax_le :
      maxNoPrimeBranchingEndpointResidualEnergyOfCells xs ≤
        generatedRawBranchingMaxEnergy n bound :=
    maxNoPrimeBranchingEndpointResidualEnergyOfCells_le_generatedRawMaxEnergy_of_withinBound
      hbounded
  have hklt_generated : k < generatedRawBranchingMaxEnergy n bound :=
    Nat.lt_of_lt_of_le hklt_max hmax_le
  rcases H k hklt_generated with ⟨B, hBmem, hBenergy⟩
  unfold noPrimeBranchingCellHasEndpointEnergy
  apply List.any_eq_true.mpr
  exact ⟨B, hBmem, decide_eq_true_eq.mpr hBenergy⟩

