/-- A canonical rich witness exposes the phase/source-face unit descent over
its own recovered SU(7) source cell.  This is still a source-coordinate
readback, not a raw same-spectrum allowed successor. -/
theorem canonicalRichHolonomyWitness_sourcePhaseUnitDescent_decrements_pair
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    (sourceCellPhaseUnitDescentRing
        W.source_lift.sourceCell.cell).generatedResidualMagnitude + 1 =
      rawCodePairResidualEnergy n p.1 p.2 :=
  sourceCellLift_phaseUnitDescent_decrements_pair W.source_lift

/-- The canonical rich witness carries a non-static source/phase successor:
its unit-descent coordinate is strictly lower than the raw endpoint-code energy
it reads. -/
theorem canonicalRichHolonomyWitness_sourcePhaseUnitDescent_strictly_decreases_pair
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    (sourceCellPhaseUnitDescentRing
        W.source_lift.sourceCell.cell).generatedResidualMagnitude <
      rawCodePairResidualEnergy n p.1 p.2 := by
  have hdec :=
    canonicalRichHolonomyWitness_sourcePhaseUnitDescent_decrements_pair W
  omega

/-- The canonical rich witness's source/phase unit descent is the same scalar
Truth Formula one-step update residual used by the concrete P950 witness. -/
theorem canonicalRichHolonomyWitness_sourcePhaseUnitDescent_realizes_scalarProducerUpdate
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    ((sourceCellPhaseUnitDescentRing
        W.source_lift.sourceCell.cell).generatedResidualMagnitude : ℝ) =
      (ResidualProjection.scalarAffineSystemProducer (0 : ℝ)
          ((rawCodePairResidualEnergy n p.1 p.2 : ℝ)⁻¹)).residual
        ((ResidualProjection.scalarAffineSystemProducer (0 : ℝ)
            ((rawCodePairResidualEnergy n p.1 p.2 : ℝ)⁻¹)).update
          (-(rawCodePairResidualEnergy n p.1 p.2 : ℝ))) := by
  have hphase :=
    canonicalRichHolonomyWitness_sourcePhaseUnitDescent_decrements_pair W
  have hphase_real :
      ((sourceCellPhaseUnitDescentRing
          W.source_lift.sourceCell.cell).generatedResidualMagnitude : ℝ) + 1 =
        (rawCodePairResidualEnergy n p.1 p.2 : ℝ) := by
    exact_mod_cast hphase
  have hunit :=
    generatedFilteredRawCodePairHolonomy_scalarProducer_unitDescent_update_residual
      W.source_lift.holonomy
  linarith

/-- A canonical rich witness cannot have its source/phase unit descent realized
by a same-spectrum generated raw branching cell.

This is the rich-witness form of the local faithful-pullback collision.  It
keeps the phase/H1 and sigma-tag lift in scope, but the contradiction is still
the P950 terminal field of the underlying source lift; no coverage or
downstream normalizer is imported. -/
theorem canonicalRichHolonomyWitness_contradicts_sourcePhaseUnitDescentRawRealization
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    {next : SU7BranchingDecompositionCell n}
    (hnext_mem :
      next ∈
        (gaugeFilteredRawBranchingSpectrum
          n bound (generatedNoPrimeAllowedPredicate n bound)).cells)
    (hnext_realizes :
      rawAtomCodeBranchingDecompositionResidualEnergy next =
        (sourceCellPhaseUnitDescentRing
          W.source_lift.sourceCell.cell).generatedResidualMagnitude) :
    False :=
  sourceCellLift_contradicts_phaseUnitDescentRawRealization
    W.source_lift hnext_mem hnext_realizes

/-- A same-spectrum raw branching unit-successor law contradicts a canonical
rich witness through the source/phase unit-descent coordinate.

This is the rich-coordinate version of the local mouth alignment: the
successor law first realizes the source/phase unit descent in the generated
raw spectrum, then the existing local faithful-pullback collision fires. -/
theorem canonicalRichHolonomyWitness_contradicts_rawBranchingSpectrumUnitSuccessor_via_sourcePhaseUnitDescent
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (Hsucc :
      SU7RawBranchingSpectrumUnitSuccessorLaw
        (gaugeFilteredRawBranchingSpectrum
          n bound (generatedNoPrimeAllowedPredicate n bound)))
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    False :=
  sourceCellLift_contradicts_rawBranchingSpectrumUnitSuccessor_via_phaseUnitDescent
    W.source_lift Hsucc

/-- A canonical rich witness exposes a genuinely nonzero generated integer
residual on its own source-cell phase ring. -/
theorem canonicalRichHolonomyWitness_generatedResidual_ne_zero
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    (sourceCellPhaseRing W.source_lift.sourceCell.cell).generatedResidual ≠ 0 :=
  generatedFilteredRawCodePairPhaseReadback_generatedResidual_ne_zero
    (phaseReadback_of_richHolonomyWitness W.rich_witness)

/-- A canonical rich witness's source residual is captured by the identity
information projection. -/
theorem canonicalRichHolonomyWitness_identityResidualCaptured
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    (sourceCellPhaseRing W.source_lift.sourceCell.cell).ResidualCaptured
      (AddMonoidHom.id Int) := by
