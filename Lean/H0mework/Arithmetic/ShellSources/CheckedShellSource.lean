        right := by
    rw [noPrimeBranchingCellOfBooleanAtomicRawCell_rightCode]
    simp [booleanAtomicCellOfRawCodePair,
      canonicalRawCodePairBranchingCell]
  rw [hleft_code, hright_code] at hallowed
  simpa [generatedNoPrimeAllowedPredicate] using hallowed

