      (ResidualProjection.scalarAffineSystemProducer (0 : ℝ) σ).residual
        (-(canonicalRichHolonomyWitness_sourceResidualReal W))
  source_phase_unit_descent_decrements_pair :
    (sourceCellPhaseUnitDescentRing
        W.source_lift.sourceCell.cell).generatedResidualMagnitude + 1 =
      rawCodePairResidualEnergy n p.1 p.2
  source_phase_unit_descent_realizes_scalar_update :
    ((sourceCellPhaseUnitDescentRing
        W.source_lift.sourceCell.cell).generatedResidualMagnitude : ℝ) =
      (ResidualProjection.scalarAffineSystemProducer (0 : ℝ)
          ((rawCodePairResidualEnergy n p.1 p.2 : ℝ)⁻¹)).residual
        ((ResidualProjection.scalarAffineSystemProducer (0 : ℝ)
            ((rawCodePairResidualEnergy n p.1 p.2 : ℝ)⁻¹)).update
          (-(rawCodePairResidualEnergy n p.1 p.2 : ℝ)))

