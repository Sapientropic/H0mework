      noPrimeBranchingEndpointResidualEnergy step + 1 =
        rawAtomCodeBranchingDecompositionResidualEnergy W.sourceCell.cell) :
    ∃ next : SU7BranchingDecompositionCell n,
      next ∈
        (gaugeFilteredRawBranchingSpectrum
          n bound (generatedNoPrimeAllowedPredicate n bound)).cells ∧
        rawAtomCodeBranchingDecompositionResidualEnergy next + 1 =
          rawAtomCodeBranchingDecompositionResidualEnergy
            W.sourceCell.cell := by
  rcases
      exists_booleanAtomicRawCell_of_mem_generatedNoPrimeBranchingCells
        hstep_mem with
    ⟨x, hxmem, hxstep⟩
  have hleft_code :
      atomCode step.leftAtom.toSU7Atom =
        x.cell.leftWeightCode := by
    rw [← hxstep, noPrimeBranchingCellOfBooleanAtomicRawCell_leftCode]
  have hright_code :
      atomCode step.rightAtom.toSU7Atom =
        x.cell.rightWeightCode := by
    rw [← hxstep, noPrimeBranchingCellOfBooleanAtomicRawCell_rightCode]
  have hallowed_x :
      generatedNoPrimeAllowedPredicate n bound
        x.cell.leftWeightCode x.cell.rightWeightCode = true := by
    have hallowed_step :=
      noPrimeBranchingAllowedPredicate_of_mem
        (C := rawCodeTensorCoding)
        (n := n)
        (xs := generatedNoPrimeBranchingCells n bound)
        hstep_mem
    simpa [generatedNoPrimeAllowedPredicate, hleft_code, hright_code]
      using hallowed_step
  have hxfiltered :
      x ∈
        gaugeFilteredBooleanAtomicRawBranchingCandidateList
          n bound (generatedNoPrimeAllowedPredicate n bound) := by
    unfold gaugeFilteredBooleanAtomicRawBranchingCandidateList
    exact List.mem_filter.mpr ⟨hxmem, hallowed_x⟩
  refine ⟨x.cell, gaugeFilteredBooleanAtomicCell_mem_spectrum hxfiltered, ?_⟩
  calc
    rawAtomCodeBranchingDecompositionResidualEnergy x.cell + 1 =
        noPrimeBranchingEndpointResidualEnergy
            (noPrimeBranchingCellOfBooleanAtomicRawCell x) + 1 := by
          rw [noPrimeBranchingCellOfBooleanAtomicRawCell_energy_eq]
    _ = noPrimeBranchingEndpointResidualEnergy step + 1 := by
          rw [hxstep]
