  rcases Hrepair with
    ⟨left', right', hallowed', hleft'_mem, hright'_mem,
      hleft'_check, hright'_check, hsucc⟩
  exact hterminal left' right' hallowed' hleft'_mem hright'_mem
    hleft'_check hright'_check hsucc

/-- A bounded Boolean-atomic endpoint repair with one-unit lower residual
energy directly rules out a P950 terminal over the completed generated sector.

This is the source-generated version of the completed repair throat: the
repair pair is allowed because the SU(7) finite grammar regenerates it in the
