/-- Therefore `(3,3)` is not terminal once the active sector is completed to
the generated endpoint room `5`. -/
theorem not_generatedNoPrimeBoundFive_terminal_three_three :
    ¬ (∀ left' right' : ℕ,
      generatedNoPrimeAllowedPredicate 6 5 left' right' = true ->
        left' ∈ rawCodeBoundedList 5 ->
          right' ∈ rawCodeBoundedList 5 ->
            natMultiplicativelyAtomicCheck left' = true ->
              natMultiplicativelyAtomicCheck right' = true ->
                rawCodePairResidualEnergy 6 left' right' + 1 ≠
                  rawCodePairResidualEnergy 6 3 3) := by
  intro hterminal
  rcases generatedNoPrimeBoundFive_repairs_three_three with
    ⟨left', right', hallowed, hleft_mem, hright_mem,
      hleft_check, hright_check, hsucc⟩
  exact hterminal left' right' hallowed hleft_mem hright_mem
    hleft_check hright_check hsucc

/-- A bounded Boolean-atomic endpoint pair with one-unit lower residual energy
is a generated completed-sector repair witness.

The `allowed` component is produced by
`generatedNoPrimeAllowedPredicate_of_boundedAtomicRawCodePair`; it is not a
separate assumption. -/
theorem generatedNoPrimeCompletedRepairWitness_of_boundedAtomicEnergyDrop
    {n bound left right left' right' : ℕ}
    (hleft'_mem : left' ∈ rawCodeBoundedList bound)
    (hright'_mem : right' ∈ rawCodeBoundedList bound)
    (hleft'_check : natMultiplicativelyAtomicCheck left' = true)
    (hright'_check : natMultiplicativelyAtomicCheck right' = true)
    (hsucc :
      rawCodePairResidualEnergy n left' right' + 1 =
        rawCodePairResidualEnergy n left right) :
    ∃ repairLeft repairRight : ℕ,
      generatedNoPrimeAllowedPredicate n bound repairLeft repairRight = true ∧
        repairLeft ∈ rawCodeBoundedList bound ∧
          repairRight ∈ rawCodeBoundedList bound ∧
            natMultiplicativelyAtomicCheck repairLeft = true ∧
              natMultiplicativelyAtomicCheck repairRight = true ∧
                rawCodePairResidualEnergy n repairLeft repairRight + 1 =
                  rawCodePairResidualEnergy n left right := by
  refine
    ⟨left', right',
      generatedNoPrimeAllowedPredicate_of_boundedAtomicRawCodePair
        hleft'_mem hright'_mem hleft'_check hright'_check,
      hleft'_mem, hright'_mem, hleft'_check, hright'_check, hsucc⟩

/-- A bounded Boolean-atomic `E - 1` endpoint repair has an explicit generated
Boolean raw source cell before any allowed-predicate readout.

This is the source-path form of completed endpoint room: the canonical
branch/incidence lift is in the generated raw list and its raw residual energy
is exactly one below the original endpoint pair. -/
theorem generatedNoPrimeCompletedRepairRawSourcePath_of_boundedAtomicEnergyDrop
    {n bound left right left' right' : ℕ}
    (hleft'_mem : left' ∈ rawCodeBoundedList bound)
    (hright'_mem : right' ∈ rawCodeBoundedList bound)
    (hleft'_check : natMultiplicativelyAtomicCheck left' = true)
    (hright'_check : natMultiplicativelyAtomicCheck right' = true)
    (hsucc :
      rawCodePairResidualEnergy n left' right' + 1 =
        rawCodePairResidualEnergy n left right) :
    ∃ x : SU7BooleanAtomicRawBranchingCell n,
      x ∈ booleanAtomicRawBranchingCandidateList n bound ∧
        x.cell = canonicalRawCodePairBranchingCell n left' right' ∧
          rawAtomCodeBranchingDecompositionResidualEnergy x.cell + 1 =
            rawCodePairResidualEnergy n left right := by
  let x :=
    booleanAtomicCellOfRawCodePair n left' right'
      hleft'_check hright'_check
  refine
    ⟨x,
      booleanAtomicCellOfRawCodePair_mem_generated
        hleft'_mem hright'_mem hleft'_check hright'_check,
      ?_, ?_⟩
  · simp [x, booleanAtomicCellOfRawCodePair]
  ·
    calc
      rawAtomCodeBranchingDecompositionResidualEnergy x.cell + 1 =
          rawCodePairResidualEnergy n left' right' + 1 := by
            rw [booleanAtomicCellOfRawCodePair_energy_eq]
      _ = rawCodePairResidualEnergy n left right := hsucc

/-- The same bounded Boolean-atomic `E - 1` repair has an explicit generated
no-prime source cell with endpoint-code and residual-energy readouts.

This theorem is below the allowed predicate: it proves membership in
`generatedNoPrimeBranchingCells` first, then records the endpoint and energy
projections of that generated source cell. -/
theorem generatedNoPrimeCompletedRepairNoPrimeSourcePath_of_boundedAtomicEnergyDrop
    {n bound left right left' right' : ℕ}
    (hleft'_mem : left' ∈ rawCodeBoundedList bound)
    (hright'_mem : right' ∈ rawCodeBoundedList bound)
    (hleft'_check : natMultiplicativelyAtomicCheck left' = true)
    (hright'_check : natMultiplicativelyAtomicCheck right' = true)
    (hsucc :
      rawCodePairResidualEnergy n left' right' + 1 =
        rawCodePairResidualEnergy n left right) :
    ∃ B : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
      B ∈ generatedNoPrimeBranchingCells n bound ∧
        atomCode B.leftAtom.toSU7Atom = left' ∧
          atomCode B.rightAtom.toSU7Atom = right' ∧
            noPrimeBranchingEndpointResidualEnergy B + 1 =
              rawCodePairResidualEnergy n left right := by
  let x :=
    booleanAtomicCellOfRawCodePair n left' right'
      hleft'_check hright'_check
  let B := noPrimeBranchingCellOfBooleanAtomicRawCell x
  refine
    ⟨B,
      ?_,
      ?_,
      ?_,
      ?_⟩
  ·
    dsimp [B, x]
    exact
      generatedNoPrimeBranchingCellOf_boundedAtomicRawCodePair_mem
        hleft'_mem hright'_mem hleft'_check hright'_check
  ·
    simpa [B, x, noPrimeBranchingAtom_toSU7Atom_atomCode,
      booleanAtomicCellOfRawCodePair,
      canonicalRawCodePairBranchingCell]
      using noPrimeBranchingCellOfBooleanAtomicRawCell_leftCode x
  ·
    simpa [B, x, noPrimeBranchingAtom_toSU7Atom_atomCode,
      booleanAtomicCellOfRawCodePair,
      canonicalRawCodePairBranchingCell]
      using noPrimeBranchingCellOfBooleanAtomicRawCell_rightCode x
  ·
    calc
      noPrimeBranchingEndpointResidualEnergy B + 1 =
          rawAtomCodeBranchingDecompositionResidualEnergy x.cell + 1 := by
            dsimp [B]
            rw [noPrimeBranchingCellOfBooleanAtomicRawCell_energy_eq]
      _ = rawCodePairResidualEnergy n left' right' + 1 := by
            rw [booleanAtomicCellOfRawCodePair_energy_eq]
      _ = rawCodePairResidualEnergy n left right := hsucc

/-- A generated completed-sector one-unit repair witness directly rules out
the corresponding P950 terminal.

This is the endpoint-code version of the same-spectrum repair throat: a
completion theorem should produce the witness on the left; P950's terminal
field is then impossible without any coverage/no-gap equivalence. -/
theorem not_generatedNoPrimeP950_of_completedRepairWitness
    {n bound left right : ℕ}
    (Hrepair :
      ∃ left' right' : ℕ,
        generatedNoPrimeAllowedPredicate n bound left' right' = true ∧
          left' ∈ rawCodeBoundedList bound ∧
