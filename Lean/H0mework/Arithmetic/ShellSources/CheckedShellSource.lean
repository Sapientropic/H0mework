/-- A raw endpoint-code unit successor must genuinely move at least one
endpoint code.

This is the scalar endpoint-code form of the code-moving producer trace: if
the successor kept both endpoint codes fixed, the one-unit energy equation
would read `E + 1 = E`. -/
theorem rawCodePairUnitSuccessor_changes_endpointCode
    {n bound : ℕ} {allowed : ℕ -> ℕ -> Bool}
    (Hsucc :
      BoolGaugeFilteredRawCodePairEnergyUnitSuccessorLaw n bound allowed)
    {left right : ℕ}
    (hallowed : allowed left right = true)
    (hleft_mem : left ∈ rawCodeBoundedList bound)
    (hright_mem : right ∈ rawCodeBoundedList bound)
    (hleft_check : natMultiplicativelyAtomicCheck left = true)
    (hright_check : natMultiplicativelyAtomicCheck right = true)
    (hnonzero : rawCodePairResidualEnergy n left right ≠ 0) :
    ∃ left' right' : ℕ,
      allowed left' right' = true ∧
        left' ∈ rawCodeBoundedList bound ∧
        right' ∈ rawCodeBoundedList bound ∧
        natMultiplicativelyAtomicCheck left' = true ∧
        natMultiplicativelyAtomicCheck right' = true ∧
        rawCodePairResidualEnergy n left' right' + 1 =
          rawCodePairResidualEnergy n left right ∧
        (left' ≠ left ∨ right' ≠ right) := by
  rcases Hsucc left right hallowed hleft_mem hright_mem
      hleft_check hright_check hnonzero with
    ⟨left', right', hallowed', hleft'_mem, hright'_mem,
      hleft'_check, hright'_check, hsucc⟩
  refine
    ⟨left', right',
      hallowed',
      hleft'_mem,
      hright'_mem,
      hleft'_check,
      hright'_check,
      hsucc,
      ?_⟩
  by_cases hleft_eq : left' = left
  · by_cases hright_eq : right' = right
    · have henergy_eq :
          rawCodePairResidualEnergy n left' right' =
            rawCodePairResidualEnergy n left right := by
        rw [hleft_eq, hright_eq]
      have hsucc_self :
          rawCodePairResidualEnergy n left right + 1 =
            rawCodePairResidualEnergy n left right := by
        rw [henergy_eq] at hsucc
        exact hsucc
      omega
    · exact Or.inr hright_eq
  · exact Or.inl hleft_eq

