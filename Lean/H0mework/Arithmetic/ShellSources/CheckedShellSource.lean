/-- The current broad generated no-prime allowed sector fails the raw
endpoint-code unit successor law in the P948 boundary fiber.

So the information-face closure theorem cannot simply be the current
`generatedNoPrimeAllowedPredicate 6 3`; it must refine or complete the generated
sector so that `E - 1` successor closure is actually true. -/
theorem not_generatedNoPrimeRawCodePairUnitSuccessorLaw_six_three :
    ¬ BoolGaugeFilteredRawCodePairEnergyUnitSuccessorLaw
      6 3 (generatedNoPrimeAllowedPredicate 6 3) := by
  intro H
  have hallowed :
      generatedNoPrimeAllowedPredicate 6 3 3 3 = true :=
    generatedNoPrimeAllowedPredicate_three_three (n := 6) (bound := 3) le_rfl
  have hnonzero :
      rawCodePairResidualEnergy 6 3 3 ≠ 0 := by
    norm_num [rawCodePairResidualEnergy, rawCodePairResidual]
  rcases
