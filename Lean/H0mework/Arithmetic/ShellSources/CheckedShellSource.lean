/-- Rich source-side readback for a generated P950 holonomy witness.

It combines the source-cell lift with the two coordinates that scalar P950
does not generate by itself:

* a generated finite phase-ring residual whose magnitude reads as the raw
  scalar energy;
* tagged sigma iteration depths for the endpoint codes, with an explicit
  no-collapse condition for the iteration map.

This is a source obligation, not a coverage theorem and not a static trace
axiom. -/
structure GeneratedFilteredRawCodePairRichHolonomyWitness
    {Index PhaseState K : Type*} [Fintype Index] [Field K]
    (R : _root_.FiniteReflexiveInteractionRing Index PhaseState Int)
    (σ : K) (hσ : σ ≠ 1) (n bound : ℕ) (p : ℕ × ℕ) where
  source_lift :
    GeneratedFilteredRawCodePairSourceCellLift n bound p
  left_sigma_tag :
    _root_.SaturationMonoid.AffineRelaxation.SigmaAtomicElement σ hσ
  right_sigma_tag :
    _root_.SaturationMonoid.AffineRelaxation.SigmaAtomicElement σ hσ
  left_tag_reads :
    left_sigma_tag.exponent = p.1
  right_tag_reads :
    right_sigma_tag.exponent = p.2
  sigma_iteration_faithful :
    Function.Injective
      (fun d : ℕ =>
        _root_.SaturationMonoid.AffineRelaxation.iteratedNonAbsorbingRate
          σ hσ d)
  energy_reads_generated_residual :
    rawCodePairResidualEnergy n p.1 p.2 =
      R.generatedResidualMagnitude

/-- Phase readback plus nondegenerate sigma readback produces the rich witness.

This theorem closes the automatic part of `GeneratedFilteredRawCodePairRichHolonomyLift`:
source-cell provenance and sigma tags are no longer extra assumptions.  The
remaining source obligation is precisely the phase-ring residual readback. -/
def richHolonomyWitness_of_phaseReadback_mem_Ioo
    {Index PhaseState K : Type*}
    [Fintype Index] [Field K] [LinearOrder K] [IsStrictOrderedRing K]
    {R : _root_.FiniteReflexiveInteractionRing Index PhaseState Int}
    {σ : K} (hσ0 : 0 < σ) (hσ1 : σ < 1)
    {n bound : ℕ} {p : ℕ × ℕ}
    (hp :
      BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
        n bound (generatedNoPrimeAllowedPredicate n bound) p.1 p.2)
    (Hphase : GeneratedFilteredRawCodePairPhaseReadback R n bound p) :
    GeneratedFilteredRawCodePairRichHolonomyWitness
      R σ (ne_of_lt hσ1) n bound p := by
  let S :=
    sigmaTagReadback_of_generatedP950Holonomy_mem_Ioo
      hσ0 hσ1 hp
  exact
    { source_lift := sourceCellLift_of_generatedP950Holonomy hp
      left_sigma_tag := S.left_sigma_tag
      right_sigma_tag := S.right_sigma_tag
      left_tag_reads := S.left_tag_reads
      right_tag_reads := S.right_tag_reads
      sigma_iteration_faithful := S.sigma_iteration_faithful
      energy_reads_generated_residual :=
        Hphase.energy_reads_generated_residual }

/-- A rich witness forgets to the existing generated phase readback. -/
def phaseReadback_of_richHolonomyWitness
    {Index PhaseState K : Type*} [Fintype Index] [Field K]
    {R : _root_.FiniteReflexiveInteractionRing Index PhaseState Int}
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairRichHolonomyWitness
        R σ hσ n bound p) :
    GeneratedFilteredRawCodePairPhaseReadback R n bound p where
  holonomy := W.source_lift.holonomy
  energy_reads_generated_residual :=
    W.energy_reads_generated_residual

/-- Rich source readback gives the H1 obstruction and changed-read witness
already supplied by the finite generated phase-ring theorem. -/
theorem richHolonomyWitness_h1_and_readChanged
    {Index PhaseState K : Type*} [Fintype Index] [Field K]
    {R : _root_.FiniteReflexiveInteractionRing Index PhaseState Int}
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairRichHolonomyWitness
        R σ hσ n bound p) :
    _root_.CechAdditiveCover.H1Obstruction
        (_root_.identityPairZeroTripleCover Index Int)
        R.generatedInteractionPhase ∧
      ∃ i, R.EdgeReadChanged i :=
  generatedFilteredRawCodePairPhaseReadback_h1_and_readChanged
    (phaseReadback_of_richHolonomyWitness W)

/-- Rich source readback also recovers the component/cycle obstruction:
the generated phase cochain is not explained by a global selected-edge
potential. -/
theorem richHolonomyWitness_no_global_cycle_potential
    {Index PhaseState K : Type*} [Fintype Index] [Field K]
    {R : _root_.FiniteReflexiveInteractionRing Index PhaseState Int}
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairRichHolonomyWitness
        R σ hσ n bound p) :
    ¬ _root_.CycleEdgePotentialExplained R.next R.generatedInteractionPhase :=
  generatedFilteredRawCodePairPhaseReadback_no_global_cycle_potential
    (phaseReadback_of_richHolonomyWitness W)

/-- Source obligation: every generated P950 witness admits the rich readback
above.  This is the theorem the SU(7) grammar still owes. -/
def GeneratedFilteredRawCodePairRichHolonomyLift
    {Index PhaseState K : Type*} [Fintype Index] [Field K]
    (R : _root_.FiniteReflexiveInteractionRing Index PhaseState Int)
    (σ : K) (hσ : σ ≠ 1) (n bound : ℕ) : Prop :=
  ∀ p : ℕ × ℕ,
    BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
      n bound (generatedNoPrimeAllowedPredicate n bound) p.1 p.2 ->
      Nonempty
        (GeneratedFilteredRawCodePairRichHolonomyWitness
          R σ hσ n bound p)

/-- Per-witness source-cell form of `GeneratedFilteredRawCodePairRichHolonomyLift`.

The fixed-`R` lift is a stronger uniform theorem.  What the generated SU(7)
source path supplies directly is the rich witness over the canonical phase
ring of the source cell recovered from this P950 witness. -/
theorem generatedFilteredRawCodePairRichHolonomyWitness_mem_Ioo
    {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
    {σ : K} (hσ0 : 0 < σ) (hσ1 : σ < 1)
    {n bound : ℕ} {p : ℕ × ℕ}
    (hp :
      BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
        n bound (generatedNoPrimeAllowedPredicate n bound) p.1 p.2) :
    Nonempty
      (GeneratedFilteredRawCodePairRichHolonomyWitness
        (sourceCellPhaseRing
          (sourceCellLift_of_generatedP950Holonomy hp).sourceCell.cell)
        σ (ne_of_lt hσ1) n bound p) := by
  exact
    ⟨richHolonomyWitness_of_phaseReadback_mem_Ioo
      hσ0 hσ1 hp
      (sourcePhaseReadback_of_generatedP950Holonomy hp).phase_readback⟩

/-- Canonical source-dependent rich witness.

The fixed-`R` lift above is intentionally stronger than what the SU(7)
grammar can produce for free: different P950 cells may read different raw
residual magnitudes.  The canonical source lift therefore lets the phase ring
depend on the generated source cell recovered from the witness itself. -/
structure GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : ℕ) (p : ℕ × ℕ) where
  source_lift :
    GeneratedFilteredRawCodePairSourceCellLift n bound p
  rich_witness :
    GeneratedFilteredRawCodePairRichHolonomyWitness
      (sourceCellPhaseRing source_lift.sourceCell.cell)
      σ hσ n bound p
  rich_source_lift_eq :
    rich_witness.source_lift = source_lift

/-- Canonical source-dependent rich lift for generated P950 holonomy.

This is the source-side version that the SU(7) grammar actually supplies:
every generated P950 witness carries its branch/incidence source cell, that
cell's finite phase/H1 residual coordinate, and noncollapsed sigma iteration
tags.  It does not assert a uniform phase ring for all possible witnesses. -/
def GeneratedFilteredRawCodePairCanonicalRichHolonomyLift
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : ℕ) : Prop :=
  ∀ p : ℕ × ℕ,
    (hp :
      BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
        n bound (generatedNoPrimeAllowedPredicate n bound) p.1 p.2) ->
      Nonempty
        (GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
          σ hσ n bound p)

/-- A generated P950 witness automatically has the canonical source-dependent
rich lift on the active noncollapsed sigma interval `0 < sigma < 1`.

This is the precise Lean form of "the scalar energy shell was missing
coordinates": the witness now carries source-path provenance, component/cycle
phase/H1 readback, endpoint sigma prime tags, and faithful iteration depth,
all generated from the SU(7) grammar/source cell and P307 sigma injectivity. -/
theorem generatedFilteredRawCodePairCanonicalRichHolonomyLift_mem_Ioo
    {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
    {σ : K} (hσ0 : 0 < σ) (hσ1 : σ < 1)
    {n bound : ℕ} :
    GeneratedFilteredRawCodePairCanonicalRichHolonomyLift
      σ (ne_of_lt hσ1) n bound := by
  intro p hp
  let S := sourcePhaseReadback_of_generatedP950Holonomy hp
  refine
    ⟨{ source_lift := S.source_lift
       rich_witness := ?_
       rich_source_lift_eq := ?_ }⟩
  · exact
      richHolonomyWitness_of_phaseReadback_mem_Ioo
        hσ0 hσ1 hp S.phase_readback
  · rfl

/-- Canonical rich witnesses are source-path faithful: the source cell used
to index the phase ring is the same source cell carried by the inner rich
witness. -/
theorem canonicalRichHolonomyWitness_rich_source_lift_eq
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    W.rich_witness.source_lift = W.source_lift :=
  W.rich_source_lift_eq

/-- Canonical rich witnesses preserve source-path fidelity: if two recovered
source cells coincide, then the underlying P950 endpoint-code witnesses are
the same pair. -/
theorem canonicalRichHolonomyWitness_sourcePathFaithful
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p q : ℕ × ℕ}
    (W1 :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    (W2 :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound q)
    (hcell : W1.source_lift.sourceCell.cell =
      W2.source_lift.sourceCell.cell) :
    p = q :=
  sourceCellLift_endpointPair_eq_of_sourceCell_eq
    W1.source_lift W2.source_lift hcell

/-- A canonical rich witness exposes nonzero generated residual magnitude on
the same source-cell phase ring that indexes the witness. -/
theorem canonicalRichHolonomyWitness_generatedResidualMagnitude_ne_zero
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    (sourceCellPhaseRing W.source_lift.sourceCell.cell).generatedResidualMagnitude ≠ 0 :=
