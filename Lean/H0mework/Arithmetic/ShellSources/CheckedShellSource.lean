/-- Raw endpoint-room inclusion is monotone in the finite bound.

This is the minimal admissible-completion fact: raising endpoint room preserves
old endpoint codes instead of replacing the source list by an unrelated table.
-/
theorem rawCodeBoundedList_mono
    {bound completedBound k : ℕ}
    (hbound : bound ≤ completedBound)
    (hk : k ∈ rawCodeBoundedList bound) :
    k ∈ rawCodeBoundedList completedBound := by
  have hk_le : k ≤ bound := by
    simpa [rawCodeBoundedList] using hk
  have hk_completed : k ≤ completedBound := le_trans hk_le hbound
  simpa [rawCodeBoundedList] using hk_completed

/-- The canonical computed endpoint-room completion needed to include an old
bound and both endpoint codes of a proposed repair pair.

This is not a proof that the repair pair exists.  It removes the freedom to
pick an unrelated completed bound once a candidate repair pair has been
produced. -/
def computedEndpointRoomBound
    (bound repairLeft repairRight : ℕ) : ℕ :=
  max (max bound repairLeft) repairRight

/-- The old endpoint bound is contained in the computed completion room. -/
theorem bound_le_computedEndpointRoomBound
    (bound repairLeft repairRight : ℕ) :
    bound ≤ computedEndpointRoomBound bound repairLeft repairRight := by
  unfold computedEndpointRoomBound
  exact le_trans (le_max_left bound repairLeft)
    (le_max_left (max bound repairLeft) repairRight)

/-- The left endpoint of the repair pair is contained in the computed
completion room. -/
theorem repairLeft_mem_rawCodeBoundedList_computedEndpointRoomBound
    (bound repairLeft repairRight : ℕ) :
    repairLeft ∈ rawCodeBoundedList
      (computedEndpointRoomBound bound repairLeft repairRight) := by
  have hle :
      repairLeft ≤ computedEndpointRoomBound bound repairLeft repairRight := by
    unfold computedEndpointRoomBound
    exact le_trans (le_max_right bound repairLeft)
      (le_max_left (max bound repairLeft) repairRight)
  simpa [rawCodeBoundedList] using hle

/-- The right endpoint of the repair pair is contained in the computed
completion room. -/
theorem repairRight_mem_rawCodeBoundedList_computedEndpointRoomBound
    (bound repairLeft repairRight : ℕ) :
    repairRight ∈ rawCodeBoundedList
      (computedEndpointRoomBound bound repairLeft repairRight) := by
  have hle :
      repairRight ≤ computedEndpointRoomBound bound repairLeft repairRight := by
    unfold computedEndpointRoomBound
    exact le_max_right (max bound repairLeft) repairRight
  simpa [rawCodeBoundedList] using hle

/-- Any bounded Boolean-atomic endpoint pair has a concrete no-prime source
cell in the generated SU(7) branch list.

This is the provenance theorem beneath the allowed predicate readout: the
canonical raw-code pair is first generated as a Boolean raw branch cell, then
lifted into `generatedNoPrimeBranchingCells`. -/
theorem generatedNoPrimeBranchingCellOf_boundedAtomicRawCodePair_mem
    {n bound left right : ℕ}
    (hleft_mem : left ∈ rawCodeBoundedList bound)
    (hright_mem : right ∈ rawCodeBoundedList bound)
