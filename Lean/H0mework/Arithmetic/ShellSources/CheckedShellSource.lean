theorem generatedFilteredRawCodePairHolonomy_exists_canonicalRichHolonomyWitness_mem_Ioo
    {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
    {σ : K} (hσ0 : 0 < σ) (hσ1 : σ < 1)
    {n bound : ℕ}
    (Hhol :
      Nonempty
        {p : ℕ × ℕ //
          BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
            n bound (generatedNoPrimeAllowedPredicate n bound) p.1 p.2}) :
    ∃ p : ℕ × ℕ,
      Nonempty
        (GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
          σ (ne_of_lt hσ1) n bound p) := by
  rcases Hhol with ⟨⟨p, hp⟩⟩
  exact
    ⟨p,
      (generatedFilteredRawCodePairCanonicalRichHolonomyLift_mem_Ioo
        hσ0 hσ1) p hp⟩

/-- Coordinate form of the canonical rich lift.

After this theorem, a generated P950 witness cannot be treated as just
`rawCodePairResidualEnergy ≠ 0`: the recovered witness carries the SU(7)
source branch/incidence, the component H1/read-change obstruction, and the
two sigma endpoint tags with faithful iteration depth. -/
theorem generatedFilteredRawCodePairHolonomy_exists_source_h1_sigma_mem_Ioo
    {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
    {σ : K} (hσ0 : 0 < σ) (hσ1 : σ < 1)
    {n bound : ℕ}
    (Hhol :
      Nonempty
        {p : ℕ × ℕ //
          BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
            n bound (generatedNoPrimeAllowedPredicate n bound) p.1 p.2}) :
    ∃ p : ℕ × ℕ,
      ∃ W :
        GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
          σ (ne_of_lt hσ1) n bound p,
        W.source_lift.sourceCell.cell.branch = SU3FlagSchubertCell.e ∧
          W.source_lift.sourceCell.cell.incidence =
            (.colorWeak : SU7BlockIncidence) ∧
          _root_.CechAdditiveCover.H1Obstruction
            (_root_.identityPairZeroTripleCover (Fin 3) Int)
            (sourceCellPhaseRing
              W.source_lift.sourceCell.cell).generatedInteractionPhase ∧
          (∃ i,
            (sourceCellPhaseRing
              W.source_lift.sourceCell.cell).EdgeReadChanged i) ∧
          W.rich_witness.left_sigma_tag.exponent = p.1 ∧
          W.rich_witness.right_sigma_tag.exponent = p.2 ∧
          Function.Injective
            (fun d : ℕ =>
              _root_.SaturationMonoid.AffineRelaxation.iteratedNonAbsorbingRate
                σ (ne_of_lt hσ1) d) := by
  rcases
    generatedFilteredRawCodePairHolonomy_exists_canonicalRichHolonomyWitness_mem_Ioo
      hσ0 hσ1 Hhol with
    ⟨p, ⟨W⟩⟩
  have hphase := canonicalRichHolonomyWitness_h1_and_readChanged W
  exact
    ⟨p, W,
      canonicalRichHolonomyWitness_source_branch W,
      canonicalRichHolonomyWitness_source_incidence W,
      hphase.1,
      hphase.2,
      canonicalRichHolonomyWitness_left_sigma_tag_reads W,
      canonicalRichHolonomyWitness_right_sigma_tag_reads W,
      canonicalRichHolonomyWitness_sigma_iteration_faithful W⟩

/-- Coordinate-plus-descent form of the canonical rich lift.

A generated P950 witness therefore carries not only phase/H1 and noncollapsed
sigma tags, but also the precise SU(7) incidence coordinate that activates
P993's full-orbit incidence-normalizer descent.  The last conjunct is still a
color-orbit descent statement; it is deliberately not phrased as raw endpoint
coverage or a unit successor law. -/
theorem generatedFilteredRawCodePairHolonomy_exists_source_h1_sigma_incidenceDescent_mem_Ioo
    {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
    {σ : K} (hσ0 : 0 < σ) (hσ1 : σ < 1)
    {n bound : ℕ}
    (Hhol :
      Nonempty
        {p : ℕ × ℕ //
          BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
            n bound (generatedNoPrimeAllowedPredicate n bound) p.1 p.2}) :
    ∃ p : ℕ × ℕ,
      ∃ W :
        GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
          σ (ne_of_lt hσ1) n bound p,
        W.source_lift.sourceCell.cell.branch = SU3FlagSchubertCell.e ∧
          W.source_lift.sourceCell.cell.incidence =
            (.colorWeak : SU7BlockIncidence) ∧
          _root_.CechAdditiveCover.H1Obstruction
            (_root_.identityPairZeroTripleCover (Fin 3) Int)
            (sourceCellPhaseRing
              W.source_lift.sourceCell.cell).generatedInteractionPhase ∧
          (∃ i,
            (sourceCellPhaseRing
              W.source_lift.sourceCell.cell).EdgeReadChanged i) ∧
          W.rich_witness.left_sigma_tag.exponent = p.1 ∧
          W.rich_witness.right_sigma_tag.exponent = p.2 ∧
          Function.Injective
            (fun d : ℕ =>
              _root_.SaturationMonoid.AffineRelaxation.iteratedNonAbsorbingRate
                σ (ne_of_lt hσ1) d) ∧
          (∃ y : SU7GeneratedTerminalColorCell n,
            y ∈ su7RepresentationFullTerminalColorOrbit n ∧
              generatedTerminalColorResidual y <
                generatedTerminalColorResidual
                  (generatedTerminalColorCellOfRepresentationSlot n
                    W.source_lift.sourceCell.cell.branch
                    W.source_lift.sourceCell.cell.incidence)) := by
  rcases
    generatedFilteredRawCodePairHolonomy_exists_canonicalRichHolonomyWitness_mem_Ioo
      hσ0 hσ1 Hhol with
    ⟨p, ⟨W⟩⟩
  have hphase := canonicalRichHolonomyWitness_h1_and_readChanged W
  exact
    ⟨p, W,
      canonicalRichHolonomyWitness_source_branch W,
      canonicalRichHolonomyWitness_source_incidence W,
      hphase.1,
      hphase.2,
      canonicalRichHolonomyWitness_left_sigma_tag_reads W,
      canonicalRichHolonomyWitness_right_sigma_tag_reads W,
      canonicalRichHolonomyWitness_sigma_iteration_faithful W,
      canonicalRichHolonomyWitness_fullOrbitIncidenceNormalizer_descent W⟩

