/-- Active Truth Formula transport plus a genuine bare residual static-trace
law directly generates the raw endpoint-code unit successor on the generated
no-prime allowed sector.

This avoids taking coverage, no-gap, or the successor law itself as a premise:
a missing unit successor produces a concrete P950 cell; that cell gives a naked
positive residual terminal in the traced finite-checker domain; active residual
transport rules the terminal out. -/
theorem generatedRawCodePairUnitSuccessor_of_activeTruthFormulaStaticTrace
    {K E State : Type*} [Field K] [AddCommGroup E] [Module K E]
    {n bound : ℕ}
    (P : ResidualProjection.ResidualCarrierSystemProducer K E State)
    (hactive : AffineRelaxation.ResidualTransportActive P.keep)
    (Htrace :
      BarePositiveResidualStaticTrace P
        (boolGaugeFilteredRawCodePairResidualDomain
          n bound (generatedNoPrimeAllowedPredicate n bound))) :
    BoolGaugeFilteredRawCodePairEnergyUnitSuccessorLaw
      n bound (generatedNoPrimeAllowedPredicate n bound) := by
  intro left right hallowed hleft_mem hright_mem
    hleft_check hright_check hnonzero
  by_contra hnone
  have hterminal :
      ∀ left' right' : ℕ,
        generatedNoPrimeAllowedPredicate n bound left' right' = true ->
          left' ∈ rawCodeBoundedList bound ->
            right' ∈ rawCodeBoundedList bound ->
              natMultiplicativelyAtomicCheck left' = true ->
                natMultiplicativelyAtomicCheck right' = true ->
                  rawCodePairResidualEnergy n left' right' + 1 ≠
                    rawCodePairResidualEnergy n left right := by
    intro left' right' hallowed' hleft'_mem hright'_mem
      hleft'_check hright'_check hsucc
    exact hnone
      ⟨left', right', hallowed', hleft'_mem, hright'_mem,
        hleft'_check, hright'_check, hsucc⟩
  have hhol :
      Nonempty
        {p : ℕ × ℕ //
          BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
            n bound (generatedNoPrimeAllowedPredicate n bound) p.1 p.2} :=
    ⟨⟨(left, right),
      filteredRawCodePairPermanentHolonomyCell_of_no_unit_successor
        hallowed hleft_mem hright_mem hleft_check hright_check
        hnonzero hterminal⟩⟩
  have hfail :
      ¬ BoolGaugeFilteredRawCodePairEnergyCoverage
          n bound (generatedNoPrimeAllowedPredicate n bound) :=
    boolGaugeFilteredCoverageFailure_of_filteredRawCodePairHolonomy hhol
  exact
    (noTruthFormulaStaticPositiveResidualTerminal_of_activeProducer
      (n := n) (bound := bound)
      (allowed := generatedNoPrimeAllowedPredicate n bound)
      P hactive)
      (truthFormulaStaticPositiveResidualTerminal_of_boolGaugeFilteredCoverageFailure
        P Htrace hfail)

