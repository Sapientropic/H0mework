checker accepts them, the pair is re-generated by the SU(7) finite list rather
than inserted as an external arithmetic receipt. -/
theorem generatedNoPrimeAllowedPredicate_of_boundedAtomicRawCodePair
    {n bound left right : ℕ}
    (hleft_mem : left ∈ rawCodeBoundedList bound)
    (hright_mem : right ∈ rawCodeBoundedList bound)
    (hleft_check : natMultiplicativelyAtomicCheck left = true)
    (hright_check : natMultiplicativelyAtomicCheck right = true) :
    generatedNoPrimeAllowedPredicate n bound left right = true := by
  have hBmem :
      noPrimeBranchingCellOfBooleanAtomicRawCell
          (booleanAtomicCellOfRawCodePair
            n left right hleft_check hright_check) ∈
        generatedNoPrimeBranchingCells n bound :=
    generatedNoPrimeBranchingCellOf_boundedAtomicRawCodePair_mem
      hleft_mem hright_mem hleft_check hright_check
  have hallowed :=
    noPrimeBranchingAllowedPredicate_of_mem
      (C := rawCodeTensorCoding)
      (n := n)
      (xs := generatedNoPrimeBranchingCells n bound)
      hBmem
  have hleft_code :
      atomCode
          (noPrimeBranchingCellOfBooleanAtomicRawCell
            (booleanAtomicCellOfRawCodePair
              n left right hleft_check hright_check)).leftAtom.toSU7Atom =
        left := by
    rw [noPrimeBranchingCellOfBooleanAtomicRawCell_leftCode]
    simp [booleanAtomicCellOfRawCodePair,
