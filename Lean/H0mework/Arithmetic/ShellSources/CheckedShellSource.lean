/-- A raw allowed endpoint-code successor law can be read back as an actual
no-prime branch-cell successor law on the same source list.  The only extra
input is the existing boundedness of that list: `noPrimeBranchingAllowedPredicate`
turns the successor endpoint codes back into an in-list branch cell. -/
theorem noPrimeCellUnitSuccessorLaw_of_boolGaugeFilteredRawCodePairUnitSuccessorLaw
    {C : SU7WeightTensorCoding} {n bound : ℕ}
    {xs : List (SU7NoPrimeBranchingSpectrumCell C n)}
    (hbounded : NoPrimeBranchingCellsWithinBound bound xs)
    (Hsucc :
      BoolGaugeFilteredRawCodePairEnergyUnitSuccessorLaw
        n bound (noPrimeBranchingAllowedPredicate xs)) :
    NoPrimeBranchingCellUnitSuccessorLaw xs := by
  intro B hBmem hBnonzero
  let left := atomCode B.leftAtom.toSU7Atom
  let right := atomCode B.rightAtom.toSU7Atom
  have hallowed :
      noPrimeBranchingAllowedPredicate xs left right = true := by
    simpa [left, right] using
      (noPrimeBranchingAllowedPredicate_of_mem hBmem)
  have hleft_mem : left ∈ rawCodeBoundedList bound := by
    simpa [left] using (hbounded B hBmem).1
  have hright_mem : right ∈ rawCodeBoundedList bound := by
    simpa [right] using (hbounded B hBmem).2
  have hleft_check :
      natMultiplicativelyAtomicCheck left = true := by
    simpa [left] using noPrimeBranchingCell_left_atomicCheck B
  have hright_check :
      natMultiplicativelyAtomicCheck right = true := by
    simpa [right] using noPrimeBranchingCell_right_atomicCheck B
  have hpair_nonzero :
      rawCodePairResidualEnergy n left right ≠ 0 := by
    simpa [left, right, noPrimeBranchingEndpointResidualEnergy]
      using hBnonzero
  rcases Hsucc left right hallowed hleft_mem hright_mem
      hleft_check hright_check hpair_nonzero with
    ⟨left', right', hallowed', _hleft'_mem, _hright'_mem,
      _hleft'_check, _hright'_check, hsucc⟩
  rcases exists_noPrimeBranchingCell_of_allowedPredicate
      (C := C) (n := n) (xs := xs) hallowed' with
    ⟨B', hB'mem, hleft', hright'⟩
  refine ⟨B', hB'mem, ?_⟩
  simpa [left, right, hleft', hright',
    noPrimeBranchingEndpointResidualEnergy] using hsucc

