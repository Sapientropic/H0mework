theorem noPrimeBranchingEndpointEnergy_le_generatedRawMaxEnergy_of_withinBound
    {C : SU7WeightTensorCoding} {n bound : ℕ}
    {xs : List (SU7NoPrimeBranchingSpectrumCell C n)}
