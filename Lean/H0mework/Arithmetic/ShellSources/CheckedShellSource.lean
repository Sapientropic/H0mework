collapsed away: the raw residual energy is the magnitude of a generated
finite reflexive phase-ring residual.  It is a source obligation, not a
coverage or no-gap theorem. -/
structure GeneratedFilteredRawCodePairPhaseReadback
    {Index State : Type*} [Fintype Index]
    (R : _root_.FiniteReflexiveInteractionRing Index State Int)
    (n bound : ℕ) (p : ℕ × ℕ) : Prop where
  holonomy :
    BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
      n bound (generatedNoPrimeAllowedPredicate n bound) p.1 p.2
  energy_reads_generated_residual :
    rawCodePairResidualEnergy n p.1 p.2 = R.generatedResidualMagnitude

/-- A generated P950 phase readback carries nonzero generated residual
magnitude. -/
theorem generatedFilteredRawCodePairPhaseReadback_generatedResidualMagnitude_ne_zero
    {Index State : Type*} [Fintype Index]
    {R : _root_.FiniteReflexiveInteractionRing Index State Int}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W : GeneratedFilteredRawCodePairPhaseReadback R n bound p) :
    R.generatedResidualMagnitude ≠ 0 := by
  have hraw_ne :
      rawCodePairResidualEnergy n p.1 p.2 ≠ 0 := by
    rcases W.holonomy with
      ⟨_, _, _, _, _, hnonzero, _⟩
    exact hnonzero
  intro hzero
  exact hraw_ne (by
    rw [W.energy_reads_generated_residual, hzero])

/-- A generated P950 phase readback carries a genuinely nonzero generated
integer residual, not only a nonzero natural shell. -/
theorem generatedFilteredRawCodePairPhaseReadback_generatedResidual_ne_zero
    {Index State : Type*} [Fintype Index]
    {R : _root_.FiniteReflexiveInteractionRing Index State Int}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W : GeneratedFilteredRawCodePairPhaseReadback R n bound p) :
    R.generatedResidual ≠ 0 := by
  have hmag_ne :=
    generatedFilteredRawCodePairPhaseReadback_generatedResidualMagnitude_ne_zero
      W
  have hpos : 0 < R.generatedResidualMagnitude :=
    Nat.pos_of_ne_zero hmag_ne
  exact
    (Int.natAbs_pos).mp (by
      simpa [_root_.FiniteReflexiveInteractionRing.generatedResidualMagnitude]
        using hpos)

/-- Once a generated P950 witness is read back through a generated phase-ring
coordinate, its scalar nonzero energy is no longer just a missing shell: it
produces the H1 obstruction and visible changed-read witness supplied by the
finite reflexive interaction-ring theorem. -/
theorem generatedFilteredRawCodePairPhaseReadback_h1_and_readChanged
    {Index State : Type*} [Fintype Index]
    {R : _root_.FiniteReflexiveInteractionRing Index State Int}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W : GeneratedFilteredRawCodePairPhaseReadback R n bound p) :
    _root_.CechAdditiveCover.H1Obstruction
        (_root_.identityPairZeroTripleCover Index Int)
        R.generatedInteractionPhase ∧
      ∃ i, R.EdgeReadChanged i := by
  have hmag_ne :=
    generatedFilteredRawCodePairPhaseReadback_generatedResidualMagnitude_ne_zero
      W
  have hpos : 0 < R.generatedResidualMagnitude :=
    Nat.pos_of_ne_zero hmag_ne
  exact
    _root_.FiniteReflexiveInteractionRing.generatedResidualMagnitude_pos_h1_and_readChanged
      R hpos

/-- The same phase-coordinate readback also gives the cycle-level obstruction:
the generated phase cochain cannot be explained by a single global selected
edge potential.  This is the component/cycle coordinate that the scalar P950
energy alone does not carry. -/
theorem generatedFilteredRawCodePairPhaseReadback_no_global_cycle_potential
    {Index State : Type*} [Fintype Index]
    {R : _root_.FiniteReflexiveInteractionRing Index State Int}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W : GeneratedFilteredRawCodePairPhaseReadback R n bound p) :
    ¬ _root_.CycleEdgePotentialExplained R.next R.generatedInteractionPhase := by
  have hres :=
    generatedFilteredRawCodePairPhaseReadback_generatedResidual_ne_zero W
  exact R.generatedResidual_nonzero_no_global_cycle_potential hres

/-! ## Source-side rich readback for generated P950 holonomy -/

/-- A P950 raw code-pair witness together with a generated filtered Boolean
source cell reading back to the same endpoint codes.

This restores the source-cell coordinate that is lost when the generated
allowed sector is projected to `Nat -> Nat -> Bool`. -/
structure GeneratedFilteredRawCodePairSourceCellLift
    (n bound : ℕ) (p : ℕ × ℕ) where
  holonomy :
    BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
      n bound (generatedNoPrimeAllowedPredicate n bound) p.1 p.2
  sourceCell : SU7BooleanAtomicRawBranchingCell n
  source_mem :
    sourceCell ∈
      gaugeFilteredBooleanAtomicRawBranchingCandidateList
        n bound (generatedNoPrimeAllowedPredicate n bound)
  source_left :
    sourceCell.cell.leftWeightCode = p.1
  source_right :
    sourceCell.cell.rightWeightCode = p.2
  source_branch :
    sourceCell.cell.branch = SU3FlagSchubertCell.e
  source_incidence :
    sourceCell.cell.incidence = (.colorWeak : SU7BlockIncidence)

/-- A generated P950 witness canonically lifts to a filtered generated
Boolean source cell by using the fixed P929 branch/incidence lift. -/
def sourceCellLift_of_generatedP950Holonomy
    {n bound : ℕ} {p : ℕ × ℕ}
    (hp :
      BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
        n bound (generatedNoPrimeAllowedPredicate n bound) p.1 p.2) :
    GeneratedFilteredRawCodePairSourceCellLift n bound p := by
  have hp_keep := hp
  rcases hp with
    ⟨hallowed, hleft_mem, hright_mem, hleft_check, hright_check,
      _hnonzero, _hterminal⟩
  refine
    { holonomy := hp_keep
      sourceCell :=
        booleanAtomicCellOfRawCodePair
          n p.1 p.2 hleft_check hright_check
      source_mem := ?_
      source_left := ?_
      source_right := ?_
      source_branch := ?_
      source_incidence := ?_ }
  · exact
      booleanAtomicCellOfRawCodePair_mem_gaugeFiltered
        hallowed hleft_mem hright_mem hleft_check hright_check
  · simp [booleanAtomicCellOfRawCodePair, canonicalRawCodePairBranchingCell]
  · simp [booleanAtomicCellOfRawCodePair, canonicalRawCodePairBranchingCell]
  · simp [booleanAtomicCellOfRawCodePair, canonicalRawCodePairBranchingCell]
  · simp [booleanAtomicCellOfRawCodePair, canonicalRawCodePairBranchingCell]

/-- The lifted source cell carries its SU(7) incidence source path explicitly:
the generated carrier slot reads the canonical `colorWeak` incidence endpoint
signature, not just the scalar endpoint-code energy. -/
theorem sourceCellLift_endpointSignature
    {n bound : ℕ} {p : ℕ × ℕ}
    (W : GeneratedFilteredRawCodePairSourceCellLift n bound p) :
    generatedSlotEndpointSignature
        (generatedSlotOfBranchingDecompositionCell W.sourceCell.cell) =
      SU7BlockIncidence.endpoints (.colorWeak : SU7BlockIncidence) := by
  calc
    generatedSlotEndpointSignature
        (generatedSlotOfBranchingDecompositionCell W.sourceCell.cell) =
        SU7BlockIncidence.endpoints W.sourceCell.cell.incidence :=
          branchingDecompositionCell_endpointSignature W.sourceCell.cell
    _ = SU7BlockIncidence.endpoints (.colorWeak : SU7BlockIncidence) := by
          rw [W.source_incidence]

/-- The lifted source cell preserves the scalar P950 energy readout. -/
theorem sourceCellLift_energy_reads_pair
    {n bound : ℕ} {p : ℕ × ℕ}
    (W : GeneratedFilteredRawCodePairSourceCellLift n bound p) :
    rawAtomCodeBranchingDecompositionResidualEnergy W.sourceCell.cell =
      rawCodePairResidualEnergy n p.1 p.2 := by
  calc
    rawAtomCodeBranchingDecompositionResidualEnergy W.sourceCell.cell =
        rawCodePairResidualEnergy
          n W.sourceCell.cell.leftWeightCode
            W.sourceCell.cell.rightWeightCode := by
          exact rawBranchingResidualEnergy_eq_codePair W.sourceCell.cell
    _ = rawCodePairResidualEnergy n p.1 p.2 := by
          rw [W.source_left, W.source_right]

/-- The lifted source cell is exactly the canonical branch/incidence lift of
the endpoint-code pair.

This is a source-path fidelity theorem, not a coverage theorem: the generated
P950 source cell is not merely some nonempty Boolean cell with the right
energy; its branch, incidence, and endpoint codes are all the canonical
SU(7) grammar lift of the raw code pair. -/
theorem sourceCellLift_cell_eq_canonicalRawCodePairBranchingCell
    {n bound : ℕ} {p : ℕ × ℕ}
    (W : GeneratedFilteredRawCodePairSourceCellLift n bound p) :
    W.sourceCell.cell =
      canonicalRawCodePairBranchingCell n p.1 p.2 := by
  cases hcell : W.sourceCell.cell with
  | mk branch incidence left right =>
      have hbranch : branch = SU3FlagSchubertCell.e := by
        simpa [hcell] using W.source_branch
      have hincidence : incidence = (.colorWeak : SU7BlockIncidence) := by
        simpa [hcell] using W.source_incidence
      have hleft : left = p.1 := by
        simpa [hcell] using W.source_left
      have hright : right = p.2 := by
        simpa [hcell] using W.source_right
      simp [canonicalRawCodePairBranchingCell,
        hbranch, hincidence, hleft, hright]

/-- The lifted source cell is the canonical Boolean raw-code source cell for its
own endpoint codes.

This is a small source-path fidelity fact for completed endpoint-room
transport: raising the endpoint room regenerates the same canonical SU(7)
source cell, not a different source representative. -/
theorem sourceCellLift_sourceCell_eq_booleanAtomicCellOfRawCodePair
    {n bound : ℕ} {p : ℕ × ℕ}
    (W : GeneratedFilteredRawCodePairSourceCellLift n bound p) :
    W.sourceCell =
      booleanAtomicCellOfRawCodePair n
        W.sourceCell.cell.leftWeightCode
        W.sourceCell.cell.rightWeightCode
        W.sourceCell.left_check
        W.sourceCell.right_check := by
  rcases W with
    ⟨_holonomy, sourceCell, _source_mem, _source_left, _source_right,
      source_branch, source_incidence⟩
  rcases sourceCell with ⟨cell, hleft_check, hright_check⟩
  rcases cell with ⟨branch, incidence, left, right⟩
  have hbranch : branch = SU3FlagSchubertCell.e := by
    simpa using source_branch
  have hincidence : incidence = (.colorWeak : SU7BlockIncidence) := by
    simpa using source_incidence
  subst hbranch
  subst hincidence
  rfl

/-- The canonical no-prime source cell of a generated P950 lift is preserved
when endpoint room is completed.

Completion extends the same branch/incidence grammar; it does not replace the
source list by an unrelated table. -/
theorem sourceCellLift_noPrimeSourceCell_mem_generated_of_bound_le
    {n bound completedBound : ℕ} {p : ℕ × ℕ}
    (hbound : bound ≤ completedBound)
    (W : GeneratedFilteredRawCodePairSourceCellLift n bound p) :
    noPrimeBranchingCellOfBooleanAtomicRawCell W.sourceCell ∈
      generatedNoPrimeBranchingCells n completedBound := by
  have hsource_parts :
      W.sourceCell ∈ booleanAtomicRawBranchingCandidateList n bound ∧
        generatedNoPrimeAllowedPredicate n bound
          W.sourceCell.cell.leftWeightCode
          W.sourceCell.cell.rightWeightCode = true := by
    simpa [gaugeFilteredBooleanAtomicRawBranchingCandidateList]
      using (List.mem_filter.mp W.source_mem)
  have hleft_mem :
      W.sourceCell.cell.leftWeightCode ∈ rawCodeBoundedList bound :=
    booleanAtomicCell_left_mem_rawCodeBoundedList_of_mem_generated
      hsource_parts.1
  have hright_mem :
      W.sourceCell.cell.rightWeightCode ∈ rawCodeBoundedList bound :=
    booleanAtomicCell_right_mem_rawCodeBoundedList_of_mem_generated
      hsource_parts.1
  have hcanonical_mem :
      noPrimeBranchingCellOfBooleanAtomicRawCell
          (booleanAtomicCellOfRawCodePair n
            W.sourceCell.cell.leftWeightCode
            W.sourceCell.cell.rightWeightCode
            W.sourceCell.left_check
            W.sourceCell.right_check) ∈
        generatedNoPrimeBranchingCells n completedBound :=
    generatedNoPrimeBranchingCellOf_boundedAtomicRawCodePair_mem_of_bound_le
      hbound hleft_mem hright_mem
      W.sourceCell.left_check W.sourceCell.right_check
  rw [sourceCellLift_sourceCell_eq_booleanAtomicCellOfRawCodePair W]
  exact hcanonical_mem

/-- The lifted source cell appears in the filtered generated spectrum. -/
theorem sourceCellLift_mem_filteredSpectrum
    {n bound : ℕ} {p : ℕ × ℕ}
    (W : GeneratedFilteredRawCodePairSourceCellLift n bound p) :
    W.sourceCell.cell ∈
      (gaugeFilteredRawBranchingSpectrum
        n bound (generatedNoPrimeAllowedPredicate n bound)).cells :=
  gaugeFilteredBooleanAtomicCell_mem_spectrum W.source_mem

/-- Source-cell lifts are endpoint-path faithful.

This is the P8-style distinction needed here: the generated witness is not
merely assigned some nonempty source cell.  Equality of the recovered SU(7)
source cell forces equality of the raw endpoint-code pair that P950 had
projected to a scalar energy shell. -/
theorem sourceCellLift_endpointPair_eq_of_sourceCell_eq
    {n bound : ℕ} {p q : ℕ × ℕ}
    (W1 : GeneratedFilteredRawCodePairSourceCellLift n bound p)
    (W2 : GeneratedFilteredRawCodePairSourceCellLift n bound q)
    (hcell : W1.sourceCell.cell = W2.sourceCell.cell) :
    p = q := by
  have hleft :
      W1.sourceCell.cell.leftWeightCode =
        W2.sourceCell.cell.leftWeightCode :=
    congrArg SU7BranchingDecompositionCell.leftWeightCode hcell
  have hright :
      W1.sourceCell.cell.rightWeightCode =
        W2.sourceCell.cell.rightWeightCode :=
    congrArg SU7BranchingDecompositionCell.rightWeightCode hcell
  exact
    Prod.ext
      (W1.source_left.symm.trans (hleft.trans W2.source_left))
      (W1.source_right.symm.trans (hright.trans W2.source_right))

/-- A minimal reflexive phase query whose write emits one raw SU(7) source-cell
residual on the distinguished component and zero elsewhere. -/
def sourceCellPhaseQuery (r : ℤ) (i : Fin 3) : ReflexiveQuery ℤ ℤ where
  read := fun x => x
  write := fun _ => if i = 0 then r else 0

/-- Canonical finite phase ring read back from a generated SU(7) source cell.

The generated residual of this ring is the raw branch-cell residual itself, so
the phase coordinate is tied to the canonical branch/incidence source lift and
not to a free-standing scalar shell. -/
def sourceCellPhaseRing
    {n : ℕ} (c : SU7BranchingDecompositionCell n) :
    _root_.FiniteReflexiveInteractionRing (Fin 3) ℤ ℤ where
  next := Equiv.refl (Fin 3)
  query :=
    fun i =>
      sourceCellPhaseQuery
        (rawAtomCodeBranchingDecompositionResidual c) i
  base := fun _ => 0
  nondegenerate := by
    norm_num

@[simp] theorem sourceCellPhaseRing_generatedResidual
    {n : ℕ} (c : SU7BranchingDecompositionCell n) :
    (sourceCellPhaseRing c).generatedResidual =
      rawAtomCodeBranchingDecompositionResidual c := by
  simp [sourceCellPhaseRing,
    sourceCellPhaseQuery,
    _root_.FiniteReflexiveInteractionRing.generatedResidual,
    _root_.FiniteReflexiveInteractionRing.generatedInteractionPhase]

@[simp] theorem sourceCellPhaseRing_generatedResidualMagnitude
    {n : ℕ} (c : SU7BranchingDecompositionCell n) :
    (sourceCellPhaseRing c).generatedResidualMagnitude =
      rawAtomCodeBranchingDecompositionResidualEnergy c := by
  simp [_root_.FiniteReflexiveInteractionRing.generatedResidualMagnitude,
    rawAtomCodeBranchingDecompositionResidualEnergy]

/-- The source-face unit-descent phase ring attached to a generated SU(7)
source cell.

This stays on the phase/source face: it lowers the source-cell residual
magnitude by one unit when that magnitude is positive.  It does not assert that
the lowered phase residual has already been pulled back to an allowed raw
code-pair successor. -/
def sourceCellPhaseUnitDescentRing
    {n : ℕ} (c : SU7BranchingDecompositionCell n) :
    _root_.FiniteReflexiveInteractionRing (Fin 3) ℤ ℤ where
  next := Equiv.refl (Fin 3)
  query :=
    fun i =>
      sourceCellPhaseQuery
        ((rawAtomCodeBranchingDecompositionResidualEnergy c - 1 : ℕ) : ℤ) i
  base := fun _ => 0
  nondegenerate := by
    norm_num

@[simp] theorem sourceCellPhaseUnitDescentRing_generatedResidual
    {n : ℕ} (c : SU7BranchingDecompositionCell n) :
    (sourceCellPhaseUnitDescentRing c).generatedResidual =
      ((rawAtomCodeBranchingDecompositionResidualEnergy c - 1 : ℕ) : ℤ) := by
  simp [sourceCellPhaseUnitDescentRing,
    sourceCellPhaseQuery,
    _root_.FiniteReflexiveInteractionRing.generatedResidual,
    _root_.FiniteReflexiveInteractionRing.generatedInteractionPhase]

@[simp] theorem sourceCellPhaseUnitDescentRing_generatedResidualMagnitude
    {n : ℕ} (c : SU7BranchingDecompositionCell n) :
    (sourceCellPhaseUnitDescentRing c).generatedResidualMagnitude =
      rawAtomCodeBranchingDecompositionResidualEnergy c - 1 := by
  simp [_root_.FiniteReflexiveInteractionRing.generatedResidualMagnitude,
    sourceCellPhaseUnitDescentRing_generatedResidual]

/-- A positive source-cell phase residual has a phase/source-face one-unit
descent.

This is deliberately weaker than a raw-code successor law: it produces the
Truth Formula unit descent on the source phase coordinate, while leaving the
arithmetic faithful-pullback-to-allowed-code-pair step explicit. -/
theorem sourceCellPhaseUnitDescentRing_decrements_magnitude
    {n : ℕ} {c : SU7BranchingDecompositionCell n}
    (hE :
      rawAtomCodeBranchingDecompositionResidualEnergy c ≠ 0) :
    (sourceCellPhaseUnitDescentRing c).generatedResidualMagnitude + 1 =
      (sourceCellPhaseRing c).generatedResidualMagnitude := by
  rw [sourceCellPhaseUnitDescentRing_generatedResidualMagnitude,
    sourceCellPhaseRing_generatedResidualMagnitude]
  omega

/-- The source/phase unit-descent ring is genuinely non-static: its generated
residual magnitude is strictly lower than the original source-cell phase
residual.  This is a phase/source successor statement, not a raw endpoint-code
successor. -/
theorem sourceCellPhaseUnitDescentRing_strictly_decreases_magnitude
    {n : ℕ} {c : SU7BranchingDecompositionCell n}
    (hE :
      rawAtomCodeBranchingDecompositionResidualEnergy c ≠ 0) :
    (sourceCellPhaseUnitDescentRing c).generatedResidualMagnitude <
      (sourceCellPhaseRing c).generatedResidualMagnitude := by
  have hdec := sourceCellPhaseUnitDescentRing_decrements_magnitude hE
  omega

/-- The phase ring attached to a generated P950 source-cell lift reads the
same scalar residual energy as the raw endpoint-code pair.

This keeps the phase/H1 coordinate tied to the actual SU(7) source path rather
than to a free scalar shell. -/
theorem sourceCellLift_phaseResidualMagnitude_reads_pair
    {n bound : ℕ} {p : ℕ × ℕ}
    (W : GeneratedFilteredRawCodePairSourceCellLift n bound p) :
    (sourceCellPhaseRing W.sourceCell.cell).generatedResidualMagnitude =
      rawCodePairResidualEnergy n p.1 p.2 := by
  rw [sourceCellPhaseRing_generatedResidualMagnitude,
    sourceCellLift_energy_reads_pair W]

/-- The source-cell lift also carries the source-face unit-descent phase ring
whose residual magnitude is exactly one below the P950 raw endpoint-code
energy.

This is a generated phase/source successor, not a raw arithmetic successor:
the remaining hard step is faithful pullback from this phase unit descent to an
allowed bounded atomic code pair. -/
theorem sourceCellLift_phaseUnitDescent_decrements_pair
    {n bound : ℕ} {p : ℕ × ℕ}
    (W : GeneratedFilteredRawCodePairSourceCellLift n bound p) :
    (sourceCellPhaseUnitDescentRing
        W.sourceCell.cell).generatedResidualMagnitude + 1 =
      rawCodePairResidualEnergy n p.1 p.2 := by
  have hcell_ne :
      rawAtomCodeBranchingDecompositionResidualEnergy
          W.sourceCell.cell ≠ 0 := by
    intro hzero
    rcases W.holonomy with
      ⟨_, _, _, _, _, hpair_nonzero, _⟩
    exact hpair_nonzero
      (by
        rw [← sourceCellLift_energy_reads_pair W]
        exact hzero)
  calc
    (sourceCellPhaseUnitDescentRing
        W.sourceCell.cell).generatedResidualMagnitude + 1 =
        (sourceCellPhaseRing W.sourceCell.cell).generatedResidualMagnitude :=
          sourceCellPhaseUnitDescentRing_decrements_magnitude hcell_ne
    _ = rawCodePairResidualEnergy n p.1 p.2 :=
          sourceCellLift_phaseResidualMagnitude_reads_pair W

/-- The source-cell phase unit descent recovered from a generated P950 source
lift strictly lowers the raw energy readout. -/
theorem sourceCellLift_phaseUnitDescent_strictly_decreases_pair
    {n bound : ℕ} {p : ℕ × ℕ}
    (W : GeneratedFilteredRawCodePairSourceCellLift n bound p) :
    (sourceCellPhaseUnitDescentRing
        W.sourceCell.cell).generatedResidualMagnitude <
      rawCodePairResidualEnergy n p.1 p.2 := by
  have hdec := sourceCellLift_phaseUnitDescent_decrements_pair W
  omega

/-- A generated source-cell lift cannot have its source/phase unit descent
realized by a same-spectrum generated raw branching cell.

This is the local faithful-pullback collision at the source-cell level.  It
does not assert that such a raw realization exists; it says that if a raw cell
in the generated filtered spectrum realizes the source/phase unit descent, the
P950 terminal field stored in the source lift is violated. -/
theorem sourceCellLift_contradicts_phaseUnitDescentRawRealization
    {n bound : ℕ} {p : ℕ × ℕ}
    (W : GeneratedFilteredRawCodePairSourceCellLift n bound p)
    {next : SU7BranchingDecompositionCell n}
    (hnext_mem :
      next ∈
        (gaugeFilteredRawBranchingSpectrum
          n bound (generatedNoPrimeAllowedPredicate n bound)).cells)
    (hnext_realizes :
      rawAtomCodeBranchingDecompositionResidualEnergy next =
        (sourceCellPhaseUnitDescentRing
          W.sourceCell.cell).generatedResidualMagnitude) :
    False := by
  have hterminal :
      ∀ left' right' : ℕ,
        generatedNoPrimeAllowedPredicate n bound left' right' = true ->
          left' ∈ rawCodeBoundedList bound ->
            right' ∈ rawCodeBoundedList bound ->
              natMultiplicativelyAtomicCheck left' = true ->
                natMultiplicativelyAtomicCheck right' = true ->
                  rawCodePairResidualEnergy n left' right' + 1 ≠
                    rawCodePairResidualEnergy n p.1 p.2 := by
    rcases W.holonomy with
      ⟨_hallowed, _hleft_mem, _hright_mem, _hleft_check, _hright_check,
        _hnonzero, hterminal⟩
    exact hterminal
  rcases
      exists_gaugeFilteredBooleanAtomicCell_of_mem_spectrum
        hnext_mem with
    ⟨x, hxmem, hxcell⟩
  have hxparts :
      x ∈ booleanAtomicRawBranchingCandidateList n bound ∧
        generatedNoPrimeAllowedPredicate n bound
          x.cell.leftWeightCode x.cell.rightWeightCode = true := by
    simpa [gaugeFilteredBooleanAtomicRawBranchingCandidateList]
      using (List.mem_filter.mp hxmem)
  have hleft_mem_x :
      x.cell.leftWeightCode ∈ rawCodeBoundedList bound :=
    booleanAtomicCell_left_mem_rawCodeBoundedList_of_mem_generated
      hxparts.1
  have hright_mem_x :
      x.cell.rightWeightCode ∈ rawCodeBoundedList bound :=
    booleanAtomicCell_right_mem_rawCodeBoundedList_of_mem_generated
      hxparts.1
  have hphase_pair :=
    sourceCellLift_phaseUnitDescent_decrements_pair W
  have hsucc_pair :
      rawCodePairResidualEnergy
          n x.cell.leftWeightCode x.cell.rightWeightCode + 1 =
        rawCodePairResidualEnergy n p.1 p.2 := by
    calc
      rawCodePairResidualEnergy
          n x.cell.leftWeightCode x.cell.rightWeightCode + 1 =
          rawAtomCodeBranchingDecompositionResidualEnergy x.cell + 1 := by
            rw [rawBranchingResidualEnergy_eq_codePair x.cell]
      _ = rawAtomCodeBranchingDecompositionResidualEnergy next + 1 := by
            rw [hxcell]
      _ =
          (sourceCellPhaseUnitDescentRing
            W.sourceCell.cell).generatedResidualMagnitude + 1 := by
            rw [hnext_realizes]
      _ = rawCodePairResidualEnergy n p.1 p.2 :=
            hphase_pair
  exact
    hterminal x.cell.leftWeightCode x.cell.rightWeightCode
      hxparts.2 hleft_mem_x hright_mem_x
      x.left_check x.right_check hsucc_pair

/-- A same-spectrum raw branching unit-successor law faithfully realizes the
source/phase unit descent attached to a generated P950 source-cell lift.

This does not add a new successor premise.  It aligns the existing
same-spectrum successor throat with the richer source/phase coordinate: the
successor produced for the lifted source cell has exactly the phase
unit-descent magnitude. -/
theorem sourceCellLift_phaseUnitDescentRawRealization_of_rawBranchingSpectrumUnitSuccessor
    {n bound : ℕ} {p : ℕ × ℕ}
    (W : GeneratedFilteredRawCodePairSourceCellLift n bound p)
    (Hsucc :
      SU7RawBranchingSpectrumUnitSuccessorLaw
        (gaugeFilteredRawBranchingSpectrum
          n bound (generatedNoPrimeAllowedPredicate n bound))) :
    ∃ next : SU7BranchingDecompositionCell n,
      next ∈
          (gaugeFilteredRawBranchingSpectrum
            n bound (generatedNoPrimeAllowedPredicate n bound)).cells ∧
        rawAtomCodeBranchingDecompositionResidualEnergy next =
          (sourceCellPhaseUnitDescentRing
            W.sourceCell.cell).generatedResidualMagnitude := by
  have hmem :
      W.sourceCell.cell ∈
        (gaugeFilteredRawBranchingSpectrum
          n bound (generatedNoPrimeAllowedPredicate n bound)).cells :=
    sourceCellLift_mem_filteredSpectrum W
  have hnonzero :
      rawAtomCodeBranchingDecompositionResidual W.sourceCell.cell ≠ 0 := by
    intro hzero
    have henergy_zero :
        rawAtomCodeBranchingDecompositionResidualEnergy
            W.sourceCell.cell = 0 :=
      (rawAtomCodeBranchingDecompositionResidualEnergy_eq_zero_iff
        W.sourceCell.cell).mpr hzero
    rcases W.holonomy with
      ⟨_hallowed, _hleft_mem, _hright_mem, _hleft_check, _hright_check,
        hpair_nonzero, _hterminal⟩
    exact hpair_nonzero
      (by
        rw [← sourceCellLift_energy_reads_pair W]
        exact henergy_zero)
  rcases Hsucc W.sourceCell.cell hmem hnonzero with
    ⟨next, hnext_mem, hnext_unit⟩
  refine ⟨next, hnext_mem, ?_⟩
  rw [sourceCellPhaseUnitDescentRing_generatedResidualMagnitude]
  omega

/-- The same-spectrum raw branching unit-successor throat contradicts a
generated source-cell lift through the source/phase unit-descent mouth.

The proof first realizes the phase unit descent as a generated raw cell, then
uses the local P950 terminal-field collision. -/
theorem sourceCellLift_contradicts_rawBranchingSpectrumUnitSuccessor_via_phaseUnitDescent
    {n bound : ℕ} {p : ℕ × ℕ}
    (W : GeneratedFilteredRawCodePairSourceCellLift n bound p)
    (Hsucc :
      SU7RawBranchingSpectrumUnitSuccessorLaw
        (gaugeFilteredRawBranchingSpectrum
          n bound (generatedNoPrimeAllowedPredicate n bound))) :
    False := by
  rcases
      sourceCellLift_phaseUnitDescentRawRealization_of_rawBranchingSpectrumUnitSuccessor
        W Hsucc with
    ⟨next, hnext_mem, hnext_realizes⟩
  exact
    sourceCellLift_contradicts_phaseUnitDescentRawRealization
      W hnext_mem hnext_realizes

/-- Concrete P950 readout of the source-face unit descent.

The P950 witness itself produces a canonical source phase residual successor
whose magnitude is one below the raw endpoint-code energy.  This is still only
the phase/source face; it does not assert that the successor has already been
realized by an allowed raw code pair. -/
theorem generatedFilteredRawCodePairHolonomy_sourcePhaseUnitDescent_decrements_pair
    {n bound : ℕ} {p : ℕ × ℕ}
    (hp :
      BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
        n bound (generatedNoPrimeAllowedPredicate n bound) p.1 p.2) :
    (sourceCellPhaseUnitDescentRing
        (sourceCellLift_of_generatedP950Holonomy hp).sourceCell.cell
      ).generatedResidualMagnitude + 1 =
      rawCodePairResidualEnergy n p.1 p.2 :=
  sourceCellLift_phaseUnitDescent_decrements_pair
    (sourceCellLift_of_generatedP950Holonomy hp)

/-- Direct P950 readback: the source/phase unit descent is a genuine strict
producer move in the recovered source coordinate. -/
theorem generatedFilteredRawCodePairHolonomy_sourcePhaseUnitDescent_strictly_decreases_pair
    {n bound : ℕ} {p : ℕ × ℕ}
    (hp :
      BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
        n bound (generatedNoPrimeAllowedPredicate n bound) p.1 p.2) :
    (sourceCellPhaseUnitDescentRing
        (sourceCellLift_of_generatedP950Holonomy hp).sourceCell.cell
      ).generatedResidualMagnitude <
      rawCodePairResidualEnergy n p.1 p.2 :=
  sourceCellLift_phaseUnitDescent_strictly_decreases_pair
    (sourceCellLift_of_generatedP950Holonomy hp)

/-- A source-cell phase readback: the lifted SU(7) branch/incidence cell carries
the finite generated phase ring whose residual magnitude reads as the P950 raw
code-pair energy. -/
structure GeneratedFilteredRawCodePairSourcePhaseReadback
    (n bound : ℕ) (p : ℕ × ℕ) where
  source_lift :
    GeneratedFilteredRawCodePairSourceCellLift n bound p
  phase_readback :
    GeneratedFilteredRawCodePairPhaseReadback
      (sourceCellPhaseRing source_lift.sourceCell.cell) n bound p

/-- Every concrete generated P950 witness carries the canonical SU(7) source
cell phase readback. -/
def sourcePhaseReadback_of_generatedP950Holonomy
    {n bound : ℕ} {p : ℕ × ℕ}
    (hp :
      BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
        n bound (generatedNoPrimeAllowedPredicate n bound) p.1 p.2) :
    GeneratedFilteredRawCodePairSourcePhaseReadback n bound p := by
  let W := sourceCellLift_of_generatedP950Holonomy hp
  refine
    { source_lift := W
      phase_readback := ?_ }
  refine
    { holonomy := hp
      energy_reads_generated_residual := ?_ }
  calc
    rawCodePairResidualEnergy n p.1 p.2 =
        rawAtomCodeBranchingDecompositionResidualEnergy W.sourceCell.cell :=
          (sourceCellLift_energy_reads_pair W).symm
