/-- A canonical rich witness has visible H1/read-change on the identity
information face. -/
theorem canonicalRichHolonomyWitness_identityVisible_h1_and_readChanged
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    _root_.CechAdditiveCover.H1Obstruction
        (_root_.identityPairZeroTripleCover (Fin 3) Int)
        ((sourceCellPhaseRing W.source_lift.sourceCell.cell).visibleInteractionPhase
          (AddMonoidHom.id Int)) ∧
      ∃ i, (sourceCellPhaseRing W.source_lift.sourceCell.cell).EdgeReadChanged i := by
  exact
    (sourceCellPhaseRing W.source_lift.sourceCell.cell).residualCaptured_h1_and_readChanged
      (AddMonoidHom.id Int)
      (canonicalRichHolonomyWitness_identityResidualCaptured W)

/-- A canonical rich witness exposes the H1 and changed-read coordinates of
its own source-cell phase ring. -/
theorem canonicalRichHolonomyWitness_h1_and_readChanged
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    _root_.CechAdditiveCover.H1Obstruction
        (_root_.identityPairZeroTripleCover (Fin 3) Int)
        (sourceCellPhaseRing W.source_lift.sourceCell.cell).generatedInteractionPhase ∧
      ∃ i,
        (sourceCellPhaseRing W.source_lift.sourceCell.cell).EdgeReadChanged i :=
  richHolonomyWitness_h1_and_readChanged W.rich_witness

/-- A canonical rich witness's source-cell phase is not globally cycle-exact. -/
theorem canonicalRichHolonomyWitness_no_global_cycle_potential
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    ¬ _root_.CycleEdgePotentialExplained
        (sourceCellPhaseRing W.source_lift.sourceCell.cell).next
        (sourceCellPhaseRing W.source_lift.sourceCell.cell).generatedInteractionPhase :=
  richHolonomyWitness_no_global_cycle_potential W.rich_witness

/-- A canonical rich witness keeps the source incidence endpoint signature on
the same source lift used by its phase ring. -/
theorem canonicalRichHolonomyWitness_endpointSignature
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    generatedSlotEndpointSignature
        (generatedSlotOfBranchingDecompositionCell
          W.source_lift.sourceCell.cell) =
      SU7BlockIncidence.endpoints (.colorWeak : SU7BlockIncidence) :=
  sourceCellLift_endpointSignature W.source_lift

/-- A canonical rich witness keeps the canonical SU(7) branch coordinate. -/
theorem canonicalRichHolonomyWitness_source_branch
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    W.source_lift.sourceCell.cell.branch =
      SU3FlagSchubertCell.e :=
  W.source_lift.source_branch

/-- A canonical rich witness keeps the canonical SU(7) incidence coordinate. -/
theorem canonicalRichHolonomyWitness_source_incidence
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    W.source_lift.sourceCell.cell.incidence =
      (.colorWeak : SU7BlockIncidence) :=
  W.source_lift.source_incidence

/-- The left sigma tag of a canonical rich witness reads the left raw endpoint
code. -/
theorem canonicalRichHolonomyWitness_left_sigma_tag_reads
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    W.rich_witness.left_sigma_tag.exponent = p.1 :=
  W.rich_witness.left_tag_reads

/-- The right sigma tag of a canonical rich witness reads the right raw
endpoint code. -/
theorem canonicalRichHolonomyWitness_right_sigma_tag_reads
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    W.rich_witness.right_sigma_tag.exponent = p.2 :=
  W.rich_witness.right_tag_reads

/-- A canonical rich witness carries faithful sigma iteration depth. -/
theorem canonicalRichHolonomyWitness_sigma_iteration_faithful
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    Function.Injective
      (fun d : ℕ =>
        _root_.SaturationMonoid.AffineRelaxation.iteratedNonAbsorbingRate
          σ hσ d) :=
  W.rich_witness.sigma_iteration_faithful

/-! ## Produced active cells and repair-generated completion -/

/-- A produced active SU(7) cell is not a bare enumerated no-prime cell.

The current upstream socket packages the canonical rich readback of a generated
P950 source cell: SU(7) source path, phase/H1 coordinate, and noncollapsed
sigma iteration tags.  The no-prime cell used below is a projection of this
source path, not an independent list element. -/
structure SU7ProducedActiveCell
    {K : Type*} [Field K]
    (σ : K) (hσ : σ ≠ 1) (n bound : ℕ) where
  p : ℕ × ℕ
  witness :
    GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
      σ hσ n bound p

namespace SU7ProducedActiveCell

variable {K : Type*} [Field K]
variable {σ : K} {hσ : σ ≠ 1} {n bound : ℕ}

/-- The recovered SU(7) source-cell lift carried by the active cell. -/
def sourceLift
    (A : SU7ProducedActiveCell σ hσ n bound) :
    GeneratedFilteredRawCodePairSourceCellLift n bound A.p :=
  A.witness.source_lift

/-- The Boolean raw source cell before projecting to no-prime branch cells. -/
def sourceCell
    (A : SU7ProducedActiveCell σ hσ n bound) :
    SU7BooleanAtomicRawBranchingCell n :=
  A.sourceLift.sourceCell

/-- The no-prime source cell projected from the produced source path. -/
def cell
    (A : SU7ProducedActiveCell σ hσ n bound) :
    SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n :=
  noPrimeBranchingCellOfBooleanAtomicRawCell A.sourceCell

/-- Endpoint residual energy of the produced active cell. -/
def energy
    (A : SU7ProducedActiveCell σ hσ n bound) : ℕ :=
  noPrimeBranchingEndpointResidualEnergy A.cell

/-- The projected no-prime cell is in the generated SU(7) grammar list at the
source bound. -/
theorem generated_mem
    (A : SU7ProducedActiveCell σ hσ n bound) :
    A.cell ∈ generatedNoPrimeBranchingCells n bound := by
  have hparts :
      A.sourceCell ∈ booleanAtomicRawBranchingCandidateList n bound ∧
        generatedNoPrimeAllowedPredicate n bound
          A.sourceCell.cell.leftWeightCode
          A.sourceCell.cell.rightWeightCode = true := by
    simpa [sourceCell, sourceLift,
      gaugeFilteredBooleanAtomicRawBranchingCandidateList]
      using (List.mem_filter.mp A.witness.source_lift.source_mem)
  unfold cell sourceCell sourceLift generatedNoPrimeBranchingCells
    noPrimeBranchingCellsOfBooleanAtomicRawCells
  exact List.mem_map.mpr ⟨A.witness.source_lift.sourceCell, hparts.1, rfl⟩

/-- The active cell's no-prime residual energy is the generated source-phase
residual magnitude. -/
theorem energy_eq_source_phase
    (A : SU7ProducedActiveCell σ hσ n bound) :
    A.energy =
      (sourceCellPhaseRing A.sourceCell.cell).generatedResidualMagnitude := by
  unfold energy cell sourceCell sourceLift
  rw [noPrimeBranchingCellOfBooleanAtomicRawCell_energy_eq,
    sourceCellPhaseRing_generatedResidualMagnitude]

/-- The produced active cell's endpoint residual is the raw scalar energy of
its own source endpoint-code pair.

This is only a faithful readout theorem: it does not assert coverage or create
a successor. -/
theorem energy_eq_raw_source_pair
    (A : SU7ProducedActiveCell σ hσ n bound) :
    A.energy =
      rawCodePairResidualEnergy n
        A.sourceCell.cell.leftWeightCode
        A.sourceCell.cell.rightWeightCode := by
  unfold energy cell
  rw [noPrimeBranchingCellOfBooleanAtomicRawCell_energy_eq,
    rawBranchingResidualEnergy_eq_codePair]

/-- The active source path carries the canonical branch coordinate. -/
theorem source_branch
    (A : SU7ProducedActiveCell σ hσ n bound) :
    A.sourceCell.cell.branch = SU3FlagSchubertCell.e := by
  simpa [sourceCell, sourceLift]
    using canonicalRichHolonomyWitness_source_branch A.witness

/-- The active source path carries the canonical charged incidence coordinate. -/
theorem source_incidence
    (A : SU7ProducedActiveCell σ hσ n bound) :
    A.sourceCell.cell.incidence = (.colorWeak : SU7BlockIncidence) := by
  simpa [sourceCell, sourceLift]
    using canonicalRichHolonomyWitness_source_incidence A.witness

/-- The active source phase exposes the restored H1/read-change coordinate. -/
theorem h1_and_readChanged
    (A : SU7ProducedActiveCell σ hσ n bound) :
    _root_.CechAdditiveCover.H1Obstruction
        (_root_.identityPairZeroTripleCover (Fin 3) Int)
        (sourceCellPhaseRing A.sourceCell.cell).generatedInteractionPhase ∧
      ∃ i,
        (sourceCellPhaseRing A.sourceCell.cell).EdgeReadChanged i := by
  simpa [sourceCell, sourceLift]
    using canonicalRichHolonomyWitness_h1_and_readChanged A.witness

/-- The active source phase is not explained by a single global cycle
potential. -/
theorem no_global_cycle_potential
    (A : SU7ProducedActiveCell σ hσ n bound) :
    ¬ _root_.CycleEdgePotentialExplained
        (sourceCellPhaseRing A.sourceCell.cell).next
        (sourceCellPhaseRing A.sourceCell.cell).generatedInteractionPhase := by
  simpa [sourceCell, sourceLift]
    using canonicalRichHolonomyWitness_no_global_cycle_potential A.witness

/-- The left sigma tag reads the produced source endpoint code. -/
theorem left_sigma_tag_reads_source
    (A : SU7ProducedActiveCell σ hσ n bound) :
    A.witness.rich_witness.left_sigma_tag.exponent =
      A.sourceCell.cell.leftWeightCode := by
  unfold sourceCell sourceLift
  exact
    (canonicalRichHolonomyWitness_left_sigma_tag_reads A.witness).trans
      A.witness.source_lift.source_left.symm

/-- The right sigma tag reads the produced source endpoint code. -/
theorem right_sigma_tag_reads_source
    (A : SU7ProducedActiveCell σ hσ n bound) :
    A.witness.rich_witness.right_sigma_tag.exponent =
      A.sourceCell.cell.rightWeightCode := by
  unfold sourceCell sourceLift
  exact
    (canonicalRichHolonomyWitness_right_sigma_tag_reads A.witness).trans
      A.witness.source_lift.source_right.symm

/-- The active sigma coordinate is noncollapsed on its iteration-depth readout. -/
theorem sigma_iteration_faithful
    (A : SU7ProducedActiveCell σ hσ n bound) :
    Function.Injective
      (fun d : ℕ =>
        _root_.SaturationMonoid.AffineRelaxation.iteratedNonAbsorbingRate
          σ hσ d) :=
  canonicalRichHolonomyWitness_sigma_iteration_faithful A.witness

end SU7ProducedActiveCell

/-- A canonical rich witness is already a produced active cell. -/
def producedActiveCell_of_canonicalRichHolonomyWitness
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    SU7ProducedActiveCell σ hσ n bound where
  p := p
  witness := W

/-- A generated P950 witness in the active noncollapsed sigma interval produces
an active SU(7) cell with source path, H1/phase, and sigma-tag coordinates. -/
@[reducible]
def producedActiveCell_of_generatedP950Holonomy_mem_Ioo
    {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
    {σ : K} (hσ0 : 0 < σ) (hσ1 : σ < 1)
    {n bound : ℕ} {p : ℕ × ℕ}
    (hp :
      BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
        n bound (generatedNoPrimeAllowedPredicate n bound) p.1 p.2) :
    Nonempty
      (SU7ProducedActiveCell σ (ne_of_lt hσ1) n bound) := by
  rcases
      (generatedFilteredRawCodePairCanonicalRichHolonomyLift_mem_Ioo
        hσ0 hσ1) p hp with
    ⟨W⟩
  exact ⟨producedActiveCell_of_canonicalRichHolonomyWitness W⟩

/-- A repair obligation is the source-boundary `E - 1` target generated by the
active cell's phase/unit-descent coordinate.

It is not a raw successor cell.  The grammar still has to realize this target
as a generated repair cell in the completed active sector. -/
structure SU7RepairObligation
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1} {n bound : ℕ}
    (A : SU7ProducedActiveCell σ hσ n bound) where
  targetEnergy : ℕ
  source_boundary :
    targetEnergy =
      (sourceCellPhaseUnitDescentRing A.sourceCell.cell).generatedResidualMagnitude
  targetEnergy_spec :
    targetEnergy + 1 = A.energy

namespace SU7RepairObligation

variable {K : Type*} [Field K]
variable {σ : K} {hσ : σ ≠ 1} {n bound : ℕ}

/-- Positive produced active residuals canonically emit the source-boundary
repair obligation.  This only constructs the obligation; it does not realize it
as an allowed/generated repair cell. -/
def of_positive
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    SU7RepairObligation A := by
  refine
    { targetEnergy :=
        (sourceCellPhaseUnitDescentRing
          A.sourceCell.cell).generatedResidualMagnitude
      source_boundary := rfl
      targetEnergy_spec := ?_ }
  have hsource_nonzero :
      rawAtomCodeBranchingDecompositionResidualEnergy
          A.sourceCell.cell ≠ 0 := by
    intro hzero
    exact hpos (by
      rw [SU7ProducedActiveCell.energy_eq_source_phase A,
        sourceCellPhaseRing_generatedResidualMagnitude, hzero])
  calc
    (sourceCellPhaseUnitDescentRing
        A.sourceCell.cell).generatedResidualMagnitude + 1 =
        (sourceCellPhaseRing A.sourceCell.cell).generatedResidualMagnitude :=
          sourceCellPhaseUnitDescentRing_decrements_magnitude hsource_nonzero
    _ = A.energy :=
          (SU7ProducedActiveCell.energy_eq_source_phase A).symm

/-- Repair obligations are residual-transport conservation ledgers:
the active source energy is the successor target energy plus one trace quantum.

This is not a successor existence theorem.  It says that if a positive produced
active residual emits a repair obligation, the missing unit is accounted for as
the source-boundary repair/trace quantum rather than disappearing. -/
theorem traceQuantum_conservation
    (A : SU7ProducedActiveCell σ hσ n bound)
    (O : SU7RepairObligation A) :
    A.energy = O.targetEnergy + 1 :=
  O.targetEnergy_spec.symm

/-- The canonical repair obligation emitted by a positive produced active cell
conserves residual energy as `E = (E - 1) + 1`. -/
theorem of_positive_traceQuantum_conservation
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0) :
    A.energy =
      (SU7RepairObligation.of_positive A hpos).targetEnergy + 1 :=
  traceQuantum_conservation A (SU7RepairObligation.of_positive A hpos)

end SU7RepairObligation

/-- A canonical rich witness is an observed produced tension: its produced
active cell has nonzero residual energy. -/
theorem canonicalRichWitness_producedActiveCell_energy_ne_zero
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    (producedActiveCell_of_canonicalRichHolonomyWitness W).energy ≠ 0 := by
  let A := producedActiveCell_of_canonicalRichHolonomyWitness W
  have henergy := SU7ProducedActiveCell.energy_eq_source_phase A
  intro hzero
  have hAzero : A.energy = 0 := by
    simpa [A] using hzero
  have hsource_zero :
      (sourceCellPhaseRing A.sourceCell.cell).generatedResidualMagnitude = 0 := by
    rw [← henergy]
    exact hAzero
  exact
    canonicalRichHolonomyWitness_generatedResidualMagnitude_ne_zero W
      (by
        simpa [A, producedActiveCell_of_canonicalRichHolonomyWitness,
          SU7ProducedActiveCell.sourceCell, SU7ProducedActiveCell.sourceLift]
          using hsource_zero)

/-- The canonical repair obligation attached to the observed produced tension
of a canonical rich witness.

This is the Lean form of "observed tension obtains an integration obligation":
source-path / phase/H1 / sigma-tag data have already made the positive residual
processable, but the obligation is not yet a generated repair cell. -/
def canonicalRichWitness_repairObligation
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    SU7RepairObligation
      (producedActiveCell_of_canonicalRichHolonomyWitness W) :=
  SU7RepairObligation.of_positive
    (producedActiveCell_of_canonicalRichHolonomyWitness W)
    (canonicalRichWitness_producedActiveCell_energy_ne_zero W)

/-- The source/phase unit descent carried by a canonical rich witness.

This is the thinnest semantic transform: it only says that the source-cell
phase unit-descent coordinate sits exactly one residual quantum below the
observed source phase magnitude.  It is not a raw repair cell and does not
assert any generated-sector realization. -/
structure SemanticSourcePhaseUnitDescent
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) : Prop where
  unit_descent :
    (sourceCellPhaseUnitDescentRing
        W.source_lift.sourceCell.cell).generatedResidualMagnitude + 1 =
      (sourceCellPhaseRing
        W.source_lift.sourceCell.cell).generatedResidualMagnitude

namespace SemanticSourcePhaseUnitDescent

variable {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
variable {n bound : ℕ} {p : ℕ × ℕ}
variable
  {W :
    GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
      σ hσ n bound p}

/-- The source/phase unit descent is strictly below the original source
phase magnitude. -/
theorem target_lt_sourceMagnitude
    (D : SemanticSourcePhaseUnitDescent W) :
    (sourceCellPhaseUnitDescentRing
        W.source_lift.sourceCell.cell).generatedResidualMagnitude <
      (sourceCellPhaseRing
        W.source_lift.sourceCell.cell).generatedResidualMagnitude := by
  have hunit := D.unit_descent
  omega

end SemanticSourcePhaseUnitDescent

/-- Canonical rich witnesses carry source/phase unit descent directly from
the recovered SU(7) source cell.

The proof uses `sourceCellPhaseUnitDescentRing_decrements_magnitude`; it does
not pass through raw repair-cell existence. -/
theorem canonicalRichWitness_semanticSourcePhaseUnitDescent
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    SemanticSourcePhaseUnitDescent W := by
  refine ⟨?_⟩
  have hsource_nonzero :
      rawAtomCodeBranchingDecompositionResidualEnergy
          W.source_lift.sourceCell.cell ≠ 0 := by
    intro hzero
    exact
      canonicalRichHolonomyWitness_generatedResidualMagnitude_ne_zero W
        (by
          rw [sourceCellPhaseRing_generatedResidualMagnitude, hzero])
  exact sourceCellPhaseUnitDescentRing_decrements_magnitude hsource_nonzero

/-- A canonical rich witness observed as source-bound tension.

The witness `W` already carries source path, phase/H1 support, sigma tags, and
producer provenance.  This object records only the semantic source/phase unit
descent recovered from that existing structure. -/
structure CanonicalRichObservedTension
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) : Prop where
  semantic_descent :
    SemanticSourcePhaseUnitDescent W

/-- Canonical rich witnesses are observed source/phase tensions in the thin
semantic sense: they carry source/phase unit descent before any raw repair
cell is generated. -/
def canonicalRichWitness_to_observedTension
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    CanonicalRichObservedTension W :=
  ⟨canonicalRichWitness_semanticSourcePhaseUnitDescent W⟩

/-- Semantic source/phase transform carried by a canonical rich observed
tension.

This is deliberately weaker than a generated repair cell.  It only records
the source-bound unit transform: the canonical target energy is the
source/phase unit-descent magnitude, and one trace quantum restores the
original source-phase residual magnitude. -/
structure CanonicalRichSemanticSourcePhaseTransform
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) : Prop where
  semantic_descent :
    SemanticSourcePhaseUnitDescent W
  target_source_boundary :
    (canonicalRichWitness_repairObligation W).targetEnergy =
      (sourceCellPhaseUnitDescentRing
        W.source_lift.sourceCell.cell).generatedResidualMagnitude
  targetEnergy_trace_quantum :
    (canonicalRichWitness_repairObligation W).targetEnergy + 1 =
      (sourceCellPhaseRing
        W.source_lift.sourceCell.cell).generatedResidualMagnitude

namespace CanonicalRichSemanticSourcePhaseTransform

variable {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
variable {n bound : ℕ} {p : ℕ × ℕ}
variable
  {W :
    GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
      σ hσ n bound p}

/-- The semantic source/phase transform is a strict descent in the source
phase magnitude.  This is not a generated repair realization; it is only the
source-side residual-transport target sitting one unit below the observed
tension. -/
theorem targetEnergy_lt_sourceMagnitude
    (T : CanonicalRichSemanticSourcePhaseTransform W) :
    (canonicalRichWitness_repairObligation W).targetEnergy <
      (sourceCellPhaseRing
        W.source_lift.sourceCell.cell).generatedResidualMagnitude := by
  have hunit := T.targetEnergy_trace_quantum
  omega

end CanonicalRichSemanticSourcePhaseTransform

/-- Canonical rich witnesses carry the semantic source/phase transform before
any repair cell is generated.

The statement is only the transport ledger `targetEnergy + 1 = source energy`;
it does not assert membership in `generatedNoPrimeBranchingCells`. -/
theorem canonicalRichWitness_semanticSourcePhaseTransform
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    CanonicalRichSemanticSourcePhaseTransform W := by
  let A := producedActiveCell_of_canonicalRichHolonomyWitness W
  let O := canonicalRichWitness_repairObligation W
  refine
    { semantic_descent :=
        canonicalRichWitness_semanticSourcePhaseUnitDescent W
      target_source_boundary := by
        simpa [A, O, producedActiveCell_of_canonicalRichHolonomyWitness,
          SU7ProducedActiveCell.sourceCell, SU7ProducedActiveCell.sourceLift]
          using O.source_boundary
      targetEnergy_trace_quantum := ?_ }
  calc
    O.targetEnergy + 1 = A.energy := by
        exact (SU7RepairObligation.traceQuantum_conservation A O).symm
    _ =
        (sourceCellPhaseRing
          W.source_lift.sourceCell.cell).generatedResidualMagnitude := by
        simpa [A, producedActiveCell_of_canonicalRichHolonomyWitness,
          SU7ProducedActiveCell.sourceCell, SU7ProducedActiveCell.sourceLift]
          using SU7ProducedActiveCell.energy_eq_source_phase A

/-- Observed source/phase tension has the semantic source/phase transform.

The proof combines the observed unit descent with the canonical repair
obligation as a ledger.  It still does not construct a raw generated repair
cell. -/
theorem observedTension_has_semanticSourcePhaseTransform
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    {W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p}
    (O : CanonicalRichObservedTension W) :
    CanonicalRichSemanticSourcePhaseTransform W := by
  let R := canonicalRichWitness_repairObligation W
  have hboundary :
      R.targetEnergy =
        (sourceCellPhaseUnitDescentRing
          W.source_lift.sourceCell.cell).generatedResidualMagnitude := by
    simpa [R, producedActiveCell_of_canonicalRichHolonomyWitness,
      SU7ProducedActiveCell.sourceCell, SU7ProducedActiveCell.sourceLift]
      using R.source_boundary
  refine
    { semantic_descent := O.semantic_descent
      target_source_boundary := hboundary
      targetEnergy_trace_quantum := ?_ }
  calc
    R.targetEnergy + 1 =
        (sourceCellPhaseUnitDescentRing
          W.source_lift.sourceCell.cell).generatedResidualMagnitude + 1 := by
          rw [hboundary]
    _ =
        (sourceCellPhaseRing
          W.source_lift.sourceCell.cell).generatedResidualMagnitude :=
          O.semantic_descent.unit_descent

/-- Canonical rich witnesses carry exactly the coordinates needed for an
integration/repair obligation: source path, phase/H1 visibility, sigma
iteration fidelity, and the residual-transport ledger
`E = targetEnergy + 1`.

This is not a repair-realization theorem.  It proves that once a positive
residual is observed through the generated rich witness, it is no longer a
naked residue: it has source structure and a canonical repair obligation. -/
theorem canonicalRichWitness_observedTension_carries_repairObligation
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    let A := producedActiveCell_of_canonicalRichHolonomyWitness W
    let O := canonicalRichWitness_repairObligation W
    A.sourceCell.cell.branch = SU3FlagSchubertCell.e ∧
      A.sourceCell.cell.incidence = (.colorWeak : SU7BlockIncidence) ∧
        _root_.CechAdditiveCover.H1Obstruction
          (_root_.identityPairZeroTripleCover (Fin 3) Int)
          (sourceCellPhaseRing A.sourceCell.cell).generatedInteractionPhase ∧
          (∃ i,
            (sourceCellPhaseRing A.sourceCell.cell).EdgeReadChanged i) ∧
            Function.Injective
              (fun d : ℕ =>
                _root_.SaturationMonoid.AffineRelaxation.iteratedNonAbsorbingRate
                  σ hσ d) ∧
              O.targetEnergy =
                (sourceCellPhaseUnitDescentRing
                  A.sourceCell.cell).generatedResidualMagnitude ∧
                A.energy = O.targetEnergy + 1 := by
  let A := producedActiveCell_of_canonicalRichHolonomyWitness W
  let O := canonicalRichWitness_repairObligation W
  exact
    ⟨SU7ProducedActiveCell.source_branch A,
      SU7ProducedActiveCell.source_incidence A,
      (SU7ProducedActiveCell.h1_and_readChanged A).1,
      (SU7ProducedActiveCell.h1_and_readChanged A).2,
      SU7ProducedActiveCell.sigma_iteration_faithful A,
      O.source_boundary,
      SU7RepairObligation.traceQuantum_conservation A O⟩

/-- A generated repair cell realizes a repair obligation inside the grammar.

The repair cell may live at a completed endpoint-room bound.  The only bound
relation recorded here is that completion extends the source bound; it is not a
fresh fixed broad sector. -/
structure SU7GeneratedRepairCell
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1} {n bound : ℕ}
    (A : SU7ProducedActiveCell σ hσ n bound)
    (O : SU7RepairObligation A) where
  repairBound : ℕ
  source_bound_le : bound ≤ repairBound
  cell : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n
  generated_mem : cell ∈ generatedNoPrimeBranchingCells n repairBound
  energy_realizes :
    noPrimeBranchingEndpointResidualEnergy cell = O.targetEnergy

namespace SU7GeneratedRepairCell

variable {K : Type*} [Field K]
variable {σ : K} {hσ : σ ≠ 1} {n bound : ℕ}
variable {A : SU7ProducedActiveCell σ hσ n bound}
variable {O : SU7RepairObligation A}

/-- A generated repair cell is exactly one residual unit below its produced
active source cell. -/
theorem unit_energy
    (R : SU7GeneratedRepairCell A O) :
    noPrimeBranchingEndpointResidualEnergy R.cell + 1 = A.energy := by
  rw [R.energy_realizes]
  exact O.targetEnergy_spec

/-- A generated repair cell materializes the repair obligation's successor
residual. -/
theorem residual_energy_eq_target
    (R : SU7GeneratedRepairCell A O) :
    noPrimeBranchingEndpointResidualEnergy R.cell = O.targetEnergy :=
  R.energy_realizes

/-- Generated repair cells preserve the same conservation ledger:
the source energy is the repair cell's residual energy plus one trace quantum.

Thus the `E - 1` cell is not an arbitrary table hit; it is the materialized
successor side of the source-boundary repair obligation. -/
theorem traceQuantum_conservation
    (R : SU7GeneratedRepairCell A O) :
    A.energy = noPrimeBranchingEndpointResidualEnergy R.cell + 1 :=
  (R.unit_energy).symm

end SU7GeneratedRepairCell

/-- The completed active sector generated from one produced active source cell:
the base source cell plus repair cells produced by source-boundary obligations.
-/
inductive SU7CompletedActiveSector
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1} {n bound : ℕ}
    (A : SU7ProducedActiveCell σ hσ n bound) :
    SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n -> Prop
  | base :
      SU7CompletedActiveSector A A.cell
  | repair
      (O : SU7RepairObligation A)
      (R : SU7GeneratedRepairCell A O) :
      SU7CompletedActiveSector A R.cell

/-- Unit-successor law for the completed active sector rooted at one produced
active cell. -/
def SU7CompletedActiveSectorUnitSuccessorLaw
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1} {n bound : ℕ}
    (A : SU7ProducedActiveCell σ hσ n bound) : Prop :=
  A.energy ≠ 0 ->
    ∃ B : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
      SU7CompletedActiveSector A B ∧
        noPrimeBranchingEndpointResidualEnergy B + 1 = A.energy

/-- The completed sector has the desired unit successor as soon as the SU(7)
grammar realizes the canonical repair obligation for every positive produced
active source cell.

This is the new upstream throat: the hard gate is the repair-cell realization
law, not coverage/no-gap equivalence over a fixed broad bounded sector. -/
theorem completedActiveSector_unitSuccessorLaw
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1} {n bound : ℕ}
    (A : SU7ProducedActiveCell σ hσ n bound)
    (Hrepair :
      ∀ hpos : A.energy ≠ 0,
        Nonempty
          (SU7GeneratedRepairCell A
            (SU7RepairObligation.of_positive A hpos))) :
    SU7CompletedActiveSectorUnitSuccessorLaw A := by
  intro hpos
  rcases Hrepair hpos with ⟨R⟩
  refine ⟨R.cell, ?_, ?_⟩
  · exact
      SU7CompletedActiveSector.repair
        (SU7RepairObligation.of_positive A hpos) R
  · exact R.unit_energy

/-- A witness-local generated no-prime `E - 1` step at a completed repair bound
realizes the canonical repair obligation of a produced active cell.

This is the narrowest grammar-facing repair payload: a single generated
no-prime cell with one-unit lower residual energy.  The repair cell may live in
a grammar-generated completion bound extending the source bound.  It does not
require a global successor law, coverage theorem, endpoint shell, normalizer, or
downstream carrier. -/
def generatedRepairCell_of_noPrimeUnitStepAtRepairBound
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound completedBound : ℕ}
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0)
    (hbound : bound ≤ completedBound)
    {step : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n}
    (hstep_mem : step ∈ generatedNoPrimeBranchingCells n completedBound)
    (hstep_energy :
      noPrimeBranchingEndpointResidualEnergy step + 1 = A.energy) :
    SU7GeneratedRepairCell A (SU7RepairObligation.of_positive A hpos) where
  repairBound := completedBound
  source_bound_le := hbound
  cell := step
  generated_mem := hstep_mem
  energy_realizes := by
    have htarget :
        (SU7RepairObligation.of_positive A hpos).targetEnergy + 1 =
          A.energy :=
      (SU7RepairObligation.of_positive A hpos).targetEnergy_spec
    omega

/-- Same-bound specialization of
`generatedRepairCell_of_noPrimeUnitStepAtRepairBound`. -/
def generatedRepairCell_of_noPrimeUnitStep
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1} {n bound : ℕ}
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hpos : A.energy ≠ 0)
    {step : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n}
    (hstep_mem : step ∈ generatedNoPrimeBranchingCells n bound)
    (hstep_energy :
      noPrimeBranchingEndpointResidualEnergy step + 1 = A.energy) :
    SU7GeneratedRepairCell A (SU7RepairObligation.of_positive A hpos) :=
  generatedRepairCell_of_noPrimeUnitStepAtRepairBound
    A hpos le_rfl hstep_mem hstep_energy

/-- A concrete completed-bound `E - 1` repair step gives the completed active
sector its rooted unit-successor law.

This is the source-completion socket before any P950/no-gap/coverage readout:
the only payload is a generated repair cell at some bound extending the source
bound. -/
theorem completedActiveSector_unitSuccessorLaw_of_noPrimeUnitStepAtRepairBound
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound completedBound : ℕ}
    (A : SU7ProducedActiveCell σ hσ n bound)
    (hbound : bound ≤ completedBound)
    {step : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n}
    (hstep_mem : step ∈ generatedNoPrimeBranchingCells n completedBound)
    (hstep_energy :
      noPrimeBranchingEndpointResidualEnergy step + 1 = A.energy) :
    SU7CompletedActiveSectorUnitSuccessorLaw A :=
  completedActiveSector_unitSuccessorLaw A
    (fun hpos =>
      ⟨generatedRepairCell_of_noPrimeUnitStepAtRepairBound
        A hpos hbound hstep_mem hstep_energy⟩)

/-- Bound-local target shape for source/phase materialization.

An allowed positive residual is not treated as a naked Boolean predicate here:
the canonical rich witness carries a source path and phase/sigma trace, and
materialization asks for a generated no-prime repair cell whose endpoint energy
is exactly the witness's source-face unit-descent magnitude at this completed
endpoint-room bound.  This definition names the remaining source-generation
target; it is not asserted unconditionally. -/
def CanonicalRichWitnessSourcePhaseDescentMaterializesAt
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    (completedBound : ℕ) : Prop :=
  ∃ repair : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
    bound ≤ completedBound ∧
      repair ∈ generatedNoPrimeBranchingCells n completedBound ∧
        noPrimeBranchingEndpointResidualEnergy repair =
          (sourceCellPhaseUnitDescentRing
            W.source_lift.sourceCell.cell).generatedResidualMagnitude

/-- Completed-bound-existential source/phase materialization. -/
def CanonicalRichWitnessSourcePhaseDescentMaterializes
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) : Prop :=
  ∃ completedBound : ℕ,
    CanonicalRichWitnessSourcePhaseDescentMaterializesAt W completedBound

/-- Source/sigma-domain latent repair at a proposed completion bound.

This is not a projected repair claim.  It only says the source domain has a
generated no-prime exact `E - 1` cell at `repairBound`; projection into a chosen
current endpoint room is a separate question. -/
def CanonicalRichWitnessSigmaLatentRepairAt
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    (repairBound : ℕ) : Prop :=
  bound ≤ repairBound ∧
    ∃ step : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
      step ∈ generatedNoPrimeBranchingCells n repairBound ∧
        noPrimeBranchingEndpointResidualEnergy step + 1 =
          rawAtomCodeBranchingDecompositionResidualEnergy
            W.source_lift.sourceCell.cell

/-- Existential latent repair in some source/sigma completion room. -/
def CanonicalRichWitnessSigmaLatentRepair
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) : Prop :=
  ∃ repairBound : ℕ,
    CanonicalRichWitnessSigmaLatentRepairAt W repairBound

/-- A grammar-realized repair cell is a source/sigma latent repair.

This keeps `SigmaLatentRepair` tied to the produced active cell interface:
the source side still owes a generated repair cell, but once it is supplied,
the latent exact `E - 1` repair is no longer a separate premise. -/
theorem canonicalRichWitness_sigmaLatentRepairAt_of_generatedRepairCell
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    (R :
      SU7GeneratedRepairCell
        (producedActiveCell_of_canonicalRichHolonomyWitness W)
        (canonicalRichWitness_repairObligation W)) :
    CanonicalRichWitnessSigmaLatentRepairAt W R.repairBound := by
  refine ⟨R.source_bound_le, R.cell, R.generated_mem, ?_⟩
  calc
    noPrimeBranchingEndpointResidualEnergy R.cell + 1 =
        (producedActiveCell_of_canonicalRichHolonomyWitness W).energy := by
          exact R.unit_energy
    _ =
        rawAtomCodeBranchingDecompositionResidualEnergy
          W.source_lift.sourceCell.cell := by
          unfold producedActiveCell_of_canonicalRichHolonomyWitness
            SU7ProducedActiveCell.energy SU7ProducedActiveCell.cell
            SU7ProducedActiveCell.sourceCell SU7ProducedActiveCell.sourceLift
          rw [noPrimeBranchingCellOfBooleanAtomicRawCell_energy_eq]

/-- Existential form of
`canonicalRichWitness_sigmaLatentRepairAt_of_generatedRepairCell`. -/
theorem canonicalRichWitness_sigmaLatentRepair_of_generatedRepairCell
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    (R :
      SU7GeneratedRepairCell
        (producedActiveCell_of_canonicalRichHolonomyWitness W)
        (canonicalRichWitness_repairObligation W)) :
    CanonicalRichWitnessSigmaLatentRepair W :=
  ⟨R.repairBound,
    canonicalRichWitness_sigmaLatentRepairAt_of_generatedRepairCell W R⟩

/-- A generated repair cell materializes the source/phase `E - 1` descent at
its own completed repair bound.

This is the direct source/phase reading of `SU7GeneratedRepairCell`: the cell's
endpoint residual is exactly the target energy of the canonical repair
obligation, hence exactly the phase unit-descent residual. -/
theorem canonicalRichWitness_sourcePhaseDescentMaterializesAtRepairBound_of_generatedRepairCell
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    (R :
      SU7GeneratedRepairCell
        (producedActiveCell_of_canonicalRichHolonomyWitness W)
        (canonicalRichWitness_repairObligation W)) :
    CanonicalRichWitnessSourcePhaseDescentMaterializesAt
      W R.repairBound := by
  refine ⟨R.cell, R.source_bound_le, R.generated_mem, ?_⟩
  calc
    noPrimeBranchingEndpointResidualEnergy R.cell =
        (canonicalRichWitness_repairObligation W).targetEnergy := R.energy_realizes
    _ =
        (sourceCellPhaseUnitDescentRing
          W.source_lift.sourceCell.cell).generatedResidualMagnitude := by
          exact (canonicalRichWitness_repairObligation W).source_boundary

/-- Existential source/phase materialization from a generated repair cell. -/
theorem canonicalRichWitness_sourcePhaseDescentMaterializes_of_generatedRepairCell
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    (R :
      SU7GeneratedRepairCell
        (producedActiveCell_of_canonicalRichHolonomyWitness W)
        (canonicalRichWitness_repairObligation W)) :
    CanonicalRichWitnessSourcePhaseDescentMaterializes W :=
  ⟨R.repairBound,
    canonicalRichWitness_sourcePhaseDescentMaterializesAtRepairBound_of_generatedRepairCell
      W R⟩

/-- Current-projection repair predicate. -/
def CanonicalRichWitnessProjectedRepairAtBound
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    (completedBound : ℕ) : Prop :=
  CanonicalRichWitnessSourcePhaseDescentMaterializesAt W completedBound

/-- A latent repair projection gap: source/sigma repair exists, but the
current projection room has not materialized it. -/
def CanonicalRichWitnessLatentRepairProjectionGap
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    (completedBound : ℕ) : Prop :=
  CanonicalRichWitnessSigmaLatentRepair W ∧
    ¬ CanonicalRichWitnessProjectedRepairAtBound W completedBound

/-- Completed repair in some generated endpoint room. -/
def CanonicalRichWitnessCompletedRepair
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) : Prop :=
  CanonicalRichWitnessSourcePhaseDescentMaterializes W

/-- A witness-local generated no-prime exact unit step materializes the
source/phase descent at the same completed bound.

This is strictly lower than a global quantized bridge: the only payload is the
single generated `E - 1` no-prime cell for this canonical source cell. -/
theorem canonicalRichWitness_sourcePhaseDescentMaterializesAt_of_noPrimeUnitStepAtRepairBound
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound completedBound : ℕ} {p : ℕ × ℕ}
    (hbound : bound ≤ completedBound)
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    {step : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n}
    (hstep_mem : step ∈ generatedNoPrimeBranchingCells n completedBound)
    (hstep_energy :
      noPrimeBranchingEndpointResidualEnergy step + 1 =
        rawAtomCodeBranchingDecompositionResidualEnergy
          W.source_lift.sourceCell.cell) :
    CanonicalRichWitnessSourcePhaseDescentMaterializesAt
      W completedBound := by
  refine ⟨step, hbound, hstep_mem, ?_⟩
  rw [sourceCellPhaseUnitDescentRing_generatedResidualMagnitude]
  omega

/-- Source/phase materialization really is a generated repair cell for the
canonical repair obligation.

This ties the older `MaterializesAt` interface back to the produced-active
cell interface: a generated no-prime cell at the unit-descent phase energy is
exactly a `SU7GeneratedRepairCell` for the witness's repair obligation. -/
theorem canonicalRichWitness_generatedRepairCell_of_sourcePhaseDescentMaterializesAt
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound completedBound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    (Hmat :
      CanonicalRichWitnessSourcePhaseDescentMaterializesAt
        W completedBound) :
    Nonempty
      (SU7GeneratedRepairCell
        (producedActiveCell_of_canonicalRichHolonomyWitness W)
        (canonicalRichWitness_repairObligation W)) := by
  rcases Hmat with ⟨repair, hbound, hrepair_mem, hrepair_energy⟩
  let A := producedActiveCell_of_canonicalRichHolonomyWitness W
  let O := canonicalRichWitness_repairObligation W
  have hrepair_target :
      noPrimeBranchingEndpointResidualEnergy repair = O.targetEnergy := by
    exact hrepair_energy.trans O.source_boundary.symm
  have hunit :
      noPrimeBranchingEndpointResidualEnergy repair + 1 = A.energy := by
    calc
      noPrimeBranchingEndpointResidualEnergy repair + 1 =
          O.targetEnergy + 1 := by rw [hrepair_target]
      _ = A.energy := O.targetEnergy_spec
  exact
    ⟨generatedRepairCell_of_noPrimeUnitStepAtRepairBound
      A (canonicalRichWitness_producedActiveCell_energy_ne_zero W)
      hbound hrepair_mem hunit⟩

/-- The produced-active-cell `noRepair` predicate forbids every older
source/phase materialization branch.

This is only a bridge between the two repair interfaces; it does not assert a
static trace or a coverage/no-gap theorem. -/
theorem canonicalRichWitness_noGeneratedRepairCell_forces_noSourcePhaseDescentMaterializesAt
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound completedBound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    (hnoRepair :
      ¬ Nonempty
        (SU7GeneratedRepairCell
          (producedActiveCell_of_canonicalRichHolonomyWitness W)
          (canonicalRichWitness_repairObligation W))) :
    ¬ CanonicalRichWitnessSourcePhaseDescentMaterializesAt
        W completedBound := by
  intro Hmat
  exact hnoRepair
    (canonicalRichWitness_generatedRepairCell_of_sourcePhaseDescentMaterializesAt
      W Hmat)

/-- With latent source/sigma repair already present, produced-active-cell
`noRepair` is only a projection gap at the chosen completed bound.

This theorem deliberately does not say that the semantic source/phase
transform is absent, and it does not produce a scalar static trace. -/
theorem canonicalRichWitness_latentRepairProjectionGap_of_sigmaLatentRepair_and_noGeneratedRepairCell
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound completedBound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    (Hlatent : CanonicalRichWitnessSigmaLatentRepair W)
    (hnoRepair :
      ¬ Nonempty
        (SU7GeneratedRepairCell
          (producedActiveCell_of_canonicalRichHolonomyWitness W)
          (canonicalRichWitness_repairObligation W))) :
    CanonicalRichWitnessLatentRepairProjectionGap W completedBound :=
  ⟨Hlatent,
    canonicalRichWitness_noGeneratedRepairCell_forces_noSourcePhaseDescentMaterializesAt
      W hnoRepair⟩

/-- Existential form of the same `noRepair` readout.

Once materialization is tied back to `SU7GeneratedRepairCell`, a genuine
produced-active-cell `noRepair` hypothesis rules out source/phase
materialization at every completed endpoint room. -/
theorem canonicalRichWitness_noGeneratedRepairCell_forces_noSourcePhaseDescentMaterializes
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    (hnoRepair :
      ¬ Nonempty
        (SU7GeneratedRepairCell
          (producedActiveCell_of_canonicalRichHolonomyWitness W)
          (canonicalRichWitness_repairObligation W))) :
    ¬ CanonicalRichWitnessSourcePhaseDescentMaterializes W := by
  rintro ⟨completedBound, Hmat⟩
  exact
    (canonicalRichWitness_noGeneratedRepairCell_forces_noSourcePhaseDescentMaterializesAt
      (completedBound := completedBound) W hnoRepair) Hmat

/-- A genuine produced-active-cell `noRepair` state forbids any witness-local
generated exact `E - 1` no-prime step in a completed endpoint room.

This is the same negative source readout one layer lower than
`MaterializesAt`: if such a step existed, it would materialize the source/phase
descent and hence produce a `SU7GeneratedRepairCell`. -/
theorem canonicalRichWitness_noGeneratedRepairCell_forbids_noPrimeUnitStepAtRepairBound
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound completedBound : ℕ} {p : ℕ × ℕ}
    (hbound : bound ≤ completedBound)
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    (hnoRepair :
      ¬ Nonempty
        (SU7GeneratedRepairCell
          (producedActiveCell_of_canonicalRichHolonomyWitness W)
          (canonicalRichWitness_repairObligation W)))
    {step : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n}
    (hstep_mem : step ∈ generatedNoPrimeBranchingCells n completedBound)
    (hstep_energy :
      noPrimeBranchingEndpointResidualEnergy step + 1 =
        rawAtomCodeBranchingDecompositionResidualEnergy
          W.source_lift.sourceCell.cell) :
    False := by
  exact
    (canonicalRichWitness_noGeneratedRepairCell_forces_noSourcePhaseDescentMaterializesAt
      (completedBound := completedBound) W hnoRepair)
      (canonicalRichWitness_sourcePhaseDescentMaterializesAt_of_noPrimeUnitStepAtRepairBound
        hbound W hstep_mem hstep_energy)

/-- Predicate-free form of
`canonicalRichWitness_noGeneratedRepairCell_forbids_noPrimeUnitStepAtRepairBound`. -/
theorem canonicalRichWitness_noGeneratedRepairCell_forces_noNoPrimeUnitStepAtRepairBound
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound completedBound : ℕ} {p : ℕ × ℕ}
    (hbound : bound ≤ completedBound)
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    (hnoRepair :
      ¬ Nonempty
        (SU7GeneratedRepairCell
          (producedActiveCell_of_canonicalRichHolonomyWitness W)
          (canonicalRichWitness_repairObligation W))) :
    ¬ ∃ step : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
      step ∈ generatedNoPrimeBranchingCells n completedBound ∧
        noPrimeBranchingEndpointResidualEnergy step + 1 =
          rawAtomCodeBranchingDecompositionResidualEnergy
            W.source_lift.sourceCell.cell := by
  rintro ⟨step, hstep_mem, hstep_energy⟩
  exact
    canonicalRichWitness_noGeneratedRepairCell_forbids_noPrimeUnitStepAtRepairBound
      hbound W hnoRepair hstep_mem hstep_energy

/-- Under `noRepair`, even a witness-local exact unit step is forbidden.

This is the contrapositive form of the exact-step source socket.  It does not
use a global bridge, coverage, a normalizer, or an endpoint shell. -/
theorem canonicalRichWitness_noRepair_forbids_noPrimeUnitStepAtRepairBound
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound completedBound : ℕ} {p : ℕ × ℕ}
    (hbound : bound ≤ completedBound)
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    (hnoRepair :
      ¬ CanonicalRichWitnessSourcePhaseDescentMaterializesAt
        W completedBound)
    {step : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n}
    (hstep_mem : step ∈ generatedNoPrimeBranchingCells n completedBound)
    (hstep_energy :
      noPrimeBranchingEndpointResidualEnergy step + 1 =
        rawAtomCodeBranchingDecompositionResidualEnergy
          W.source_lift.sourceCell.cell) :
    False :=
  hnoRepair
    (canonicalRichWitness_sourcePhaseDescentMaterializesAt_of_noPrimeUnitStepAtRepairBound
      hbound W hstep_mem hstep_energy)

/-- Predicate-free form: noRepair forbids any witness-local generated exact
unit step in the completed room. -/
theorem canonicalRichWitness_noRepair_forces_noNoPrimeUnitStepAtRepairBound
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound completedBound : ℕ} {p : ℕ × ℕ}
    (hbound : bound ≤ completedBound)
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    (hnoRepair :
      ¬ CanonicalRichWitnessSourcePhaseDescentMaterializesAt
        W completedBound) :
    ¬ ∃ step : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n,
      step ∈ generatedNoPrimeBranchingCells n completedBound ∧
        noPrimeBranchingEndpointResidualEnergy step + 1 =
          rawAtomCodeBranchingDecompositionResidualEnergy
            W.source_lift.sourceCell.cell := by
  rintro ⟨step, hstep_mem, hstep_energy⟩
  exact
    canonicalRichWitness_noRepair_forbids_noPrimeUnitStepAtRepairBound
      hbound W hnoRepair hstep_mem hstep_energy

/-- A latent exact repair whose source bound is already inside the current
projection room must be visible in that projection.

The proof reopens the latent generated no-prime cell to its Boolean raw source
pair, regenerates that pair in the larger endpoint room, and preserves the
one-unit energy ledger.  Thus a projection can miss a latent repair only when
the latent repair genuinely requires a larger completion room. -/
theorem canonicalRichWitness_projectedRepairAtBound_of_sigmaLatentRepairAt_le
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound completedBound repairBound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    (Hlatent :
      CanonicalRichWitnessSigmaLatentRepairAt W repairBound)
    (hle : repairBound ≤ completedBound) :
    CanonicalRichWitnessProjectedRepairAtBound W completedBound := by
  rcases Hlatent with
    ⟨hsource_bound, step, hstep_mem, hstep_energy⟩
  rcases
      exists_booleanAtomicRawCell_of_mem_generatedNoPrimeBranchingCells
        hstep_mem with
    ⟨x, hxmem, hxstep⟩
  let repair :=
    noPrimeBranchingCellOfBooleanAtomicRawCell
      (booleanAtomicCellOfRawCodePair
        n x.cell.leftWeightCode x.cell.rightWeightCode
        x.left_check x.right_check)
  have hleft_mem :
      x.cell.leftWeightCode ∈ rawCodeBoundedList repairBound :=
    booleanAtomicCell_left_mem_rawCodeBoundedList_of_mem_generated hxmem
  have hright_mem :
      x.cell.rightWeightCode ∈ rawCodeBoundedList repairBound :=
    booleanAtomicCell_right_mem_rawCodeBoundedList_of_mem_generated hxmem
  have hrepair_mem :
      repair ∈ generatedNoPrimeBranchingCells n completedBound := by
    dsimp [repair]
    exact
      generatedNoPrimeBranchingCellOf_boundedAtomicRawCodePair_mem_of_bound_le
        hle hleft_mem hright_mem x.left_check x.right_check
  have hx_energy :
      rawCodePairResidualEnergy
          n x.cell.leftWeightCode x.cell.rightWeightCode =
        noPrimeBranchingEndpointResidualEnergy step := by
    calc
      rawCodePairResidualEnergy
          n x.cell.leftWeightCode x.cell.rightWeightCode =
          rawAtomCodeBranchingDecompositionResidualEnergy x.cell := by
            exact (rawBranchingResidualEnergy_eq_codePair x.cell).symm
      _ =
          noPrimeBranchingEndpointResidualEnergy
            (noPrimeBranchingCellOfBooleanAtomicRawCell x) := by
            exact
              (noPrimeBranchingCellOfBooleanAtomicRawCell_energy_eq x).symm
      _ = noPrimeBranchingEndpointResidualEnergy step := by
            rw [hxstep]
  have hrepair_energy_eq :
      noPrimeBranchingEndpointResidualEnergy repair =
        rawCodePairResidualEnergy
          n x.cell.leftWeightCode x.cell.rightWeightCode := by
    calc
      noPrimeBranchingEndpointResidualEnergy repair =
          rawAtomCodeBranchingDecompositionResidualEnergy
            (booleanAtomicCellOfRawCodePair
              n x.cell.leftWeightCode x.cell.rightWeightCode
              x.left_check x.right_check).cell := by
            dsimp [repair]
            rw [noPrimeBranchingCellOfBooleanAtomicRawCell_energy_eq]
      _ =
          rawCodePairResidualEnergy
            n x.cell.leftWeightCode x.cell.rightWeightCode := by
            rw [booleanAtomicCellOfRawCodePair_energy_eq]
  have hrepair_unit :
      noPrimeBranchingEndpointResidualEnergy repair + 1 =
        rawAtomCodeBranchingDecompositionResidualEnergy
          W.source_lift.sourceCell.cell := by
    calc
      noPrimeBranchingEndpointResidualEnergy repair + 1 =
          rawCodePairResidualEnergy
            n x.cell.leftWeightCode x.cell.rightWeightCode + 1 := by
            rw [hrepair_energy_eq]
      _ = noPrimeBranchingEndpointResidualEnergy step + 1 := by
            rw [hx_energy]
      _ =
          rawAtomCodeBranchingDecompositionResidualEnergy
            W.source_lift.sourceCell.cell := hstep_energy
  exact
    canonicalRichWitness_sourcePhaseDescentMaterializesAt_of_noPrimeUnitStepAtRepairBound
      (le_trans hsource_bound hle) W hrepair_mem hrepair_unit

/-- Latent source/sigma repair always gives completed repair in some generated
endpoint room. -/
theorem canonicalRichWitness_completedRepair_of_sigmaLatentRepair
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    (Hlatent : CanonicalRichWitnessSigmaLatentRepair W) :
    CanonicalRichWitnessCompletedRepair W := by
  rcases Hlatent with
    ⟨repairBound, hsource_bound, step, hstep_mem, hstep_energy⟩
  exact
    ⟨repairBound,
      canonicalRichWitness_sourcePhaseDescentMaterializesAt_of_noPrimeUnitStepAtRepairBound
        hsource_bound W hstep_mem hstep_energy⟩

/-- If a current projection has no repair, any latent exact repair must live
strictly beyond that projection bound.

This is the formal version of "the missing one may live in the source/sigma
completion room rather than in the current projected table": if it were already
inside the current projection bound, monotone regeneration of its Boolean raw
source pair would make the projected repair visible. -/
theorem canonicalRichWitness_sigmaLatentRepair_projectionGap_forces_largerCompletion
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound completedBound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    (Hlatent : CanonicalRichWitnessSigmaLatentRepair W)
    (hnoProjection :
      ¬ CanonicalRichWitnessProjectedRepairAtBound W completedBound) :
    ∃ repairBound : ℕ,
      completedBound < repairBound ∧
        CanonicalRichWitnessSourcePhaseDescentMaterializesAt W repairBound := by
  rcases Hlatent with
    ⟨repairBound, HlatentAt⟩
  have hnot_le : ¬ repairBound ≤ completedBound := by
    intro hle
    exact hnoProjection
      (canonicalRichWitness_projectedRepairAtBound_of_sigmaLatentRepairAt_le
        W HlatentAt hle)
  have hlt : completedBound < repairBound :=
    Nat.lt_of_not_ge hnot_le
  rcases HlatentAt with
    ⟨hsource_bound, step, hstep_mem, hstep_energy⟩
  exact
    ⟨repairBound, hlt,
      canonicalRichWitness_sourcePhaseDescentMaterializesAt_of_noPrimeUnitStepAtRepairBound
        hsource_bound W hstep_mem hstep_energy⟩

/-- Witness-local active-sigma static trace branch.

This is the "observed but not repaired" side of the fork: the canonical rich
witness has been traced to a nonzero produced residual whose active sigma
producer-trace headroom is zero.  Active Truth Formula transport will reject
this branch. -/
def CanonicalRichWitnessActiveSigmaStaticTrace
    {K E State : Type*} [Field K] [AddCommGroup E] [Module K E]
    {σ : K} (hσ0 : σ ≠ 0) {hσ1 : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (P : ResidualProjection.ResidualCarrierSystemProducer K E State)
    (_W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ1 n bound p) : Prop :=
  ∃ s : State,
    P.residual s ≠ 0 ∧
      AffineRelaxation.activeSigmaSectionHeadroom
          (K := K) (X := State) (H := E) hσ0
          (AffineRelaxation.activeSigmaSystemProducerTraceSection hσ0 P) s =
        0

/-- A nonzero active-sigma static trace contradicts active Truth Formula
transport. -/
theorem canonicalRichWitness_activeSigmaStaticTrace_contradicts_activeProducer
    {K E State : Type*} [Field K] [AddCommGroup E] [Module K E]
    {σ : K} (hσ0 : σ ≠ 0) {hσ1 : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (P : ResidualProjection.ResidualCarrierSystemProducer K E State)
    (hactive : AffineRelaxation.ResidualTransportActive P.keep)
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ1 n bound p)
    (Htrace :
      CanonicalRichWitnessActiveSigmaStaticTrace hσ0 P W) :
    False := by
  rcases Htrace with ⟨s, hnonzero, hhead_zero⟩
  have hhead_nonzero :
      AffineRelaxation.activeSigmaSectionHeadroom
          (K := K) (X := State) (H := E) hσ0
          (AffineRelaxation.activeSigmaSystemProducerTraceSection hσ0 P) s ≠
        0 :=
    (AffineRelaxation.activeSigmaSystemProducerTraceSection_headroom_ne_zero_iff_residual_ne_zero
      hσ0 P hactive s).mpr hnonzero
  exact hhead_nonzero hhead_zero

/-- The repair-obligation fork at a fixed completed endpoint-room bound:
either the source/phase descent is materialized as a generated repair cell in
that room, or the witness has become an active-sigma static trace. -/
def CanonicalRichWitnessRepairOrActiveSigmaStaticBranch
    {K E State : Type*} [Field K] [AddCommGroup E] [Module K E]
    {σ : K} (hσ0 : σ ≠ 0) {hσ1 : σ ≠ 1}
    {n bound : ℕ} {p : ℕ × ℕ}
    (P : ResidualProjection.ResidualCarrierSystemProducer K E State)
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ1 n bound p)
    (completedBound : ℕ) : Prop :=
  CanonicalRichWitnessSourcePhaseDescentMaterializesAt W completedBound ∨
    CanonicalRichWitnessActiveSigmaStaticTrace hσ0 P W

/-- If the source grammar proves that any non-materialized repair obligation
becomes an active-sigma static trace, then the repair obligation has the
desired fork.  This is the safe replacement for the false unconditional target
`W -> exists repair`: the hard source law is the right-hand implication. -/
theorem canonicalRichWitness_repairOrActiveSigmaStaticBranch_of_noRepair_to_activeSigmaStatic
    {K E State : Type*} [Field K] [AddCommGroup E] [Module K E]
    {σ : K} (hσ0 : σ ≠ 0) {hσ1 : σ ≠ 1}
    {n bound completedBound : ℕ} {p : ℕ × ℕ}
    (P : ResidualProjection.ResidualCarrierSystemProducer K E State)
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ1 n bound p)
    (Hstatic :
      ¬ CanonicalRichWitnessSourcePhaseDescentMaterializesAt
          W completedBound ->
        CanonicalRichWitnessActiveSigmaStaticTrace hσ0 P W) :
    CanonicalRichWitnessRepairOrActiveSigmaStaticBranch
      hσ0 P W completedBound := by
  by_cases hrepair :
      CanonicalRichWitnessSourcePhaseDescentMaterializesAt W completedBound
  · exact Or.inl hrepair
  · exact Or.inr (Hstatic hrepair)

/-- If a completed-bound P950 terminal is asserted for the same source pair,
the materialized-repair branch of a canonical rich witness is impossible. -/
theorem canonicalRichWitness_sourcePhaseDescentMaterializesAt_contradicts_completedBoundP950
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound completedBound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p)
    (Hrepair :
      CanonicalRichWitnessSourcePhaseDescentMaterializesAt W completedBound) :
    ¬ BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
      n completedBound
        (generatedNoPrimeAllowedPredicate n completedBound)
        W.source_lift.sourceCell.cell.leftWeightCode
        W.source_lift.sourceCell.cell.rightWeightCode := by
  intro hp
  rcases Hrepair with
    ⟨repair, _hbound, hrepair_mem, hrepair_energy⟩
  rcases
      exists_booleanAtomicRawCell_of_mem_generatedNoPrimeBranchingCells
        hrepair_mem with
    ⟨x, hxmem, hxrepair⟩
  have hx_energy :
      rawCodePairResidualEnergy n
            x.cell.leftWeightCode x.cell.rightWeightCode =
        noPrimeBranchingEndpointResidualEnergy repair := by
    calc
      rawCodePairResidualEnergy n
            x.cell.leftWeightCode x.cell.rightWeightCode =
          rawAtomCodeBranchingDecompositionResidualEnergy x.cell := by
            exact (rawBranchingResidualEnergy_eq_codePair x.cell).symm
      _ =
          noPrimeBranchingEndpointResidualEnergy
            (noPrimeBranchingCellOfBooleanAtomicRawCell x) := by
            exact
              (noPrimeBranchingCellOfBooleanAtomicRawCell_energy_eq x).symm
      _ = noPrimeBranchingEndpointResidualEnergy repair := by
            rw [hxrepair]
  have hphase :
      (sourceCellPhaseUnitDescentRing
          W.source_lift.sourceCell.cell).generatedResidualMagnitude + 1 =
        rawCodePairResidualEnergy n
          W.source_lift.sourceCell.cell.leftWeightCode
          W.source_lift.sourceCell.cell.rightWeightCode := by
    calc
      (sourceCellPhaseUnitDescentRing
          W.source_lift.sourceCell.cell).generatedResidualMagnitude + 1 =
          rawCodePairResidualEnergy n p.1 p.2 :=
            canonicalRichHolonomyWitness_sourcePhaseUnitDescent_decrements_pair
              W
      _ =
          rawCodePairResidualEnergy n
            W.source_lift.sourceCell.cell.leftWeightCode
            W.source_lift.sourceCell.cell.rightWeightCode := by
            rw [W.source_lift.source_left, W.source_lift.source_right]
  have hsucc :
      rawCodePairResidualEnergy n
            x.cell.leftWeightCode x.cell.rightWeightCode + 1 =
        rawCodePairResidualEnergy n
          W.source_lift.sourceCell.cell.leftWeightCode
          W.source_lift.sourceCell.cell.rightWeightCode := by
    calc
      rawCodePairResidualEnergy n
            x.cell.leftWeightCode x.cell.rightWeightCode + 1 =
          noPrimeBranchingEndpointResidualEnergy repair + 1 := by
            rw [hx_energy]
      _ =
          (sourceCellPhaseUnitDescentRing
            W.source_lift.sourceCell.cell).generatedResidualMagnitude + 1 := by
            rw [hrepair_energy]
      _ =
          rawCodePairResidualEnergy n
            W.source_lift.sourceCell.cell.leftWeightCode
            W.source_lift.sourceCell.cell.rightWeightCode := hphase
  rcases hp with
    ⟨_hallowed, _hleft_mem, _hright_mem, _hleft_check, _hright_check,
      _hnonzero, hterminal⟩
  exact
    hterminal x.cell.leftWeightCode x.cell.rightWeightCode
      (generatedNoPrimeAllowedPredicate_of_boundedAtomicRawCodePair
        (booleanAtomicCell_left_mem_rawCodeBoundedList_of_mem_generated hxmem)
        (booleanAtomicCell_right_mem_rawCodeBoundedList_of_mem_generated hxmem)
        x.left_check x.right_check)
      (booleanAtomicCell_left_mem_rawCodeBoundedList_of_mem_generated hxmem)
      (booleanAtomicCell_right_mem_rawCodeBoundedList_of_mem_generated hxmem)
      x.left_check x.right_check hsucc

/-- A completed-bound P950 terminal forces the repair-or-static fork onto the
active-sigma static branch. -/
theorem canonicalRichWitness_completedBoundP950_forces_activeSigmaStaticTrace
    {K E State : Type*} [Field K] [AddCommGroup E] [Module K E]
    {σ : K} (hσ0 : σ ≠ 0) {hσ1 : σ ≠ 1}
    {n bound completedBound : ℕ} {p : ℕ × ℕ}
    (P : ResidualProjection.ResidualCarrierSystemProducer K E State)
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ1 n bound p)
    (Hbranch :
      CanonicalRichWitnessRepairOrActiveSigmaStaticBranch
        hσ0 P W completedBound)
    (hp :
      BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
        n completedBound
        (generatedNoPrimeAllowedPredicate n completedBound)
        W.source_lift.sourceCell.cell.leftWeightCode
        W.source_lift.sourceCell.cell.rightWeightCode) :
    CanonicalRichWitnessActiveSigmaStaticTrace hσ0 P W := by
  rcases Hbranch with hrepair | htrace
  · exact
      False.elim
        (canonicalRichWitness_sourcePhaseDescentMaterializesAt_contradicts_completedBoundP950
          W hrepair hp)
  · exact htrace

/-- Completed-bound P950 plus the repair-or-static fork contradict active
Truth Formula transport. -/
theorem canonicalRichWitness_completedBoundP950_contradicts_repairOrActiveSigmaStaticBranch
    {K E State : Type*} [Field K] [AddCommGroup E] [Module K E]
    {σ : K} (hσ0 : σ ≠ 0) {hσ1 : σ ≠ 1}
    {n bound completedBound : ℕ} {p : ℕ × ℕ}
    (P : ResidualProjection.ResidualCarrierSystemProducer K E State)
    (hactive : AffineRelaxation.ResidualTransportActive P.keep)
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ1 n bound p)
    (Hbranch :
      CanonicalRichWitnessRepairOrActiveSigmaStaticBranch
        hσ0 P W completedBound)
    (hp :
      BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
        n completedBound
        (generatedNoPrimeAllowedPredicate n completedBound)
        W.source_lift.sourceCell.cell.leftWeightCode
        W.source_lift.sourceCell.cell.rightWeightCode) :
    False :=
  canonicalRichWitness_activeSigmaStaticTrace_contradicts_activeProducer
    hσ0 P hactive W
    (canonicalRichWitness_completedBoundP950_forces_activeSigmaStaticTrace
      hσ0 P W Hbranch hp)

/-- A generated repair cell kills the completed-bound P950 terminal for its
own produced source pair.

The repair cell is not read as a downstream carrier.  Its generated-list
membership is reopened to a Boolean atomic SU(7) source cell, and
`SU7GeneratedRepairCell.unit_energy` supplies the conservation ledger
`E = (E - 1) + 1`: the repaired cell carries the `E - 1` residual, while the
missing unit is the source-boundary repair/trace quantum. -/
theorem generatedRepairCell_contradicts_completedBoundP950_via_truthFormulaUnitDescent
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound : ℕ}
    (A : SU7ProducedActiveCell σ hσ n bound)
    {O : SU7RepairObligation A}
    (R : SU7GeneratedRepairCell A O) :
    ¬ BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
      n R.repairBound
        (generatedNoPrimeAllowedPredicate n R.repairBound)
        A.sourceCell.cell.leftWeightCode
        A.sourceCell.cell.rightWeightCode := by
  intro hp
  rcases
      exists_booleanAtomicRawCell_of_mem_generatedNoPrimeBranchingCells
        R.generated_mem with
    ⟨repair, hrepair_mem, hrepair_cell⟩
  have hrepair_energy :
      rawCodePairResidualEnergy n
            repair.cell.leftWeightCode repair.cell.rightWeightCode =
        noPrimeBranchingEndpointResidualEnergy R.cell := by
    calc
      rawCodePairResidualEnergy n
            repair.cell.leftWeightCode repair.cell.rightWeightCode =
          rawAtomCodeBranchingDecompositionResidualEnergy repair.cell := by
            exact (rawBranchingResidualEnergy_eq_codePair repair.cell).symm
      _ =
          noPrimeBranchingEndpointResidualEnergy
            (noPrimeBranchingCellOfBooleanAtomicRawCell repair) := by
            exact
              (noPrimeBranchingCellOfBooleanAtomicRawCell_energy_eq
                repair).symm
      _ = noPrimeBranchingEndpointResidualEnergy R.cell := by
            rw [hrepair_cell]
  have hsource_energy :
      rawCodePairResidualEnergy n
            A.sourceCell.cell.leftWeightCode
            A.sourceCell.cell.rightWeightCode =
        A.energy := by
    calc
      rawCodePairResidualEnergy n
            A.sourceCell.cell.leftWeightCode
            A.sourceCell.cell.rightWeightCode =
          rawAtomCodeBranchingDecompositionResidualEnergy
            A.sourceCell.cell := by
            exact (rawBranchingResidualEnergy_eq_codePair
              A.sourceCell.cell).symm
      _ =
          noPrimeBranchingEndpointResidualEnergy
            (noPrimeBranchingCellOfBooleanAtomicRawCell A.sourceCell) := by
            exact
              (noPrimeBranchingCellOfBooleanAtomicRawCell_energy_eq
                A.sourceCell).symm
      _ = A.energy := by
            rfl
  have hsucc :
      rawCodePairResidualEnergy n
            repair.cell.leftWeightCode repair.cell.rightWeightCode + 1 =
        rawCodePairResidualEnergy n
          A.sourceCell.cell.leftWeightCode
          A.sourceCell.cell.rightWeightCode := by
    calc
      rawCodePairResidualEnergy n
            repair.cell.leftWeightCode repair.cell.rightWeightCode + 1 =
          noPrimeBranchingEndpointResidualEnergy R.cell + 1 := by
            rw [hrepair_energy]
      _ = A.energy := R.unit_energy
      _ =
          rawCodePairResidualEnergy n
            A.sourceCell.cell.leftWeightCode
            A.sourceCell.cell.rightWeightCode := hsource_energy.symm
  exact
    generatedFilteredRawCodePairHolonomy_contradicts_boundedAtomicEnergyDrop_via_truthFormulaUnitDescent
      (p :=
        (A.sourceCell.cell.leftWeightCode,
          A.sourceCell.cell.rightWeightCode))
      hp
      (booleanAtomicCell_left_mem_rawCodeBoundedList_of_mem_generated
        hrepair_mem)
      (booleanAtomicCell_right_mem_rawCodeBoundedList_of_mem_generated
        hrepair_mem)
      repair.left_check
      repair.right_check
      hsucc

/-- A canonical rich witness's recovered source incidence lies in the charged
SU(7) incidence sector.

This is the first P993-facing coordinate recovered from a scalar P950 cell:
the witness is not just a raw energy terminal; its source path is the
`colorWeak` incidence generated by the SU(7) grammar. -/
theorem canonicalRichHolonomyWitness_source_incidence_charged
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    W.source_lift.sourceCell.cell.incidence ∈ su7ColorChargedIncidences := by
  rw [canonicalRichHolonomyWitness_source_incidence W]
  simp [su7ColorChargedIncidences]

/-- The source color cell recovered by a canonical rich witness is a
full-orbit SU(7) representation cell. -/
theorem canonicalRichHolonomyWitness_source_terminalColorCell_mem_fullOrbit
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    generatedTerminalColorCellOfRepresentationSlot n
        W.source_lift.sourceCell.cell.branch
        W.source_lift.sourceCell.cell.incidence ∈
      su7RepresentationFullTerminalColorOrbit n := by
  unfold su7RepresentationFullTerminalColorOrbit
    su7RepresentationFullTerminalCells
  exact List.mem_flatMap.mpr
    ⟨W.source_lift.sourceCell.cell.branch,
      by
        rw [canonicalRichHolonomyWitness_source_branch W]
        simp [SU3FlagSchubertCell.all],
      by
        exact List.mem_map.mpr
          ⟨W.source_lift.sourceCell.cell.incidence,
            by
              rw [canonicalRichHolonomyWitness_source_incidence W]
              simp [SU7BlockIncidence.all],
            rfl⟩⟩

/-- The source color cell recovered by a canonical rich witness is a genuine
color-loop holonomy cell in the P993 incidence orbit. -/
theorem canonicalRichHolonomyWitness_source_terminalColorPermanentHolonomy
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    generatedTerminalColorPermanentHolonomy
      (generatedTerminalColorCellOfRepresentationSlot n
        W.source_lift.sourceCell.cell.branch
        W.source_lift.sourceCell.cell.incidence) :=
  generatedRepresentationChargedIncidence_holonomy
    n W.source_lift.sourceCell.cell.branch
    (canonicalRichHolonomyWitness_source_incidence_charged W)

/-- P993's incidence normalizer gives a strictly lower full-orbit color cell
for the canonical rich witness's own SU(7) source path.

This is source-side descent, not raw endpoint-code coverage: it proves the
coordinates recovered by `GeneratedFilteredRawCodePairRichHolonomyLift` are
rich enough to trigger the existing SU(7) incidence descent theorem. -/
theorem canonicalRichHolonomyWitness_fullOrbitIncidenceNormalizer_descent
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    ∃ y : SU7GeneratedTerminalColorCell n,
      y ∈ su7RepresentationFullTerminalColorOrbit n ∧
        generatedTerminalColorResidual y <
          generatedTerminalColorResidual
            (generatedTerminalColorCellOfRepresentationSlot n
              W.source_lift.sourceCell.cell.branch
              W.source_lift.sourceCell.cell.incidence) :=
  fullGeneratedColor_incidenceNormalizer_descent
    (generatedTerminalColorCellOfRepresentationSlot n
      W.source_lift.sourceCell.cell.branch
      W.source_lift.sourceCell.cell.incidence)
    (canonicalRichHolonomyWitness_source_terminalColorCell_mem_fullOrbit W)
    (canonicalRichHolonomyWitness_source_terminalColorPermanentHolonomy W)

/-- Normalize only the incidence coordinate of a raw SU(7) branching cell.

This is the raw-code shadow of P993's incidence normalizer.  It deliberately
keeps the endpoint codes fixed, so it is useful for checking whether the
color-orbit descent can by itself be a raw endpoint-code successor. -/
def incidenceNormalizedRawBranchingCell
    {n : ℕ} (c : SU7BranchingDecompositionCell n) :
    SU7BranchingDecompositionCell n where
  branch := c.branch
  incidence := incidenceNormalizer c.incidence
  leftWeightCode := c.leftWeightCode
  rightWeightCode := c.rightWeightCode

/-- P993's incidence normalizer does not change raw endpoint-code residual
energy when only the incidence coordinate is normalized.

The raw residual readout is faithful to endpoint codes, not to the color
incidence label.  Therefore incidence descent alone cannot be reinterpreted as
the P950 raw one-unit successor. -/
theorem incidenceNormalizedRawBranchingCell_rawEnergy_eq
    {n : ℕ} (c : SU7BranchingDecompositionCell n) :
    rawAtomCodeBranchingDecompositionResidualEnergy
        (incidenceNormalizedRawBranchingCell c) =
      rawAtomCodeBranchingDecompositionResidualEnergy c := by
  calc
    rawAtomCodeBranchingDecompositionResidualEnergy
        (incidenceNormalizedRawBranchingCell c) =
        rawCodePairResidualEnergy n
          (incidenceNormalizedRawBranchingCell c).leftWeightCode
          (incidenceNormalizedRawBranchingCell c).rightWeightCode := by
          exact rawBranchingResidualEnergy_eq_codePair
            (incidenceNormalizedRawBranchingCell c)
    _ = rawCodePairResidualEnergy n c.leftWeightCode c.rightWeightCode := by
          simp [incidenceNormalizedRawBranchingCell]
    _ = rawAtomCodeBranchingDecompositionResidualEnergy c := by
          exact (rawBranchingResidualEnergy_eq_codePair c).symm

/-- For a canonical rich witness, the P993 incidence-normalized raw cell is
not the one-unit raw successor of the original source cell.

This pins down the remaining hard projection: the source incidence descent is
real, but producing P950's raw endpoint-code successor must change the
endpoint-code coordinates or use another producer trace, not just normalize the
incidence label. -/
theorem canonicalRichHolonomyWitness_incidenceNormalizer_not_rawUnitSuccessor
    {K : Type*} [Field K]
    {σ : K} {hσ : σ ≠ 1} {n bound : ℕ} {p : ℕ × ℕ}
    (W :
      GeneratedFilteredRawCodePairCanonicalRichHolonomyWitness
        σ hσ n bound p) :
    rawAtomCodeBranchingDecompositionResidualEnergy
        (incidenceNormalizedRawBranchingCell
          W.source_lift.sourceCell.cell) + 1 ≠
      rawAtomCodeBranchingDecompositionResidualEnergy
        W.source_lift.sourceCell.cell := by
  intro hunit
  rw [incidenceNormalizedRawBranchingCell_rawEnergy_eq] at hunit
  exact Nat.succ_ne_self
    (rawAtomCodeBranchingDecompositionResidualEnergy
      W.source_lift.sourceCell.cell) hunit

/-- A no-prime branch-cell unit successor must change at least one endpoint
code.

This is the endpoint-code form of the previous obstruction: a successful
P952/P962 unit step cannot keep the same raw code pair and merely change
representation metadata. -/
theorem noPrimeBranchingUnitSuccessor_changes_endpointCode
    {C : SU7WeightTensorCoding} {n : ℕ}
    {B B' : SU7NoPrimeBranchingSpectrumCell C n}
    (hsucc :
      noPrimeBranchingEndpointResidualEnergy B' + 1 =
        noPrimeBranchingEndpointResidualEnergy B) :
    atomCode B'.leftAtom.toSU7Atom ≠ atomCode B.leftAtom.toSU7Atom ∨
      atomCode B'.rightAtom.toSU7Atom ≠ atomCode B.rightAtom.toSU7Atom := by
  by_cases hleft :
      atomCode B'.leftAtom.toSU7Atom = atomCode B.leftAtom.toSU7Atom
  · by_cases hright :
      atomCode B'.rightAtom.toSU7Atom = atomCode B.rightAtom.toSU7Atom
    · have henergy :
          noPrimeBranchingEndpointResidualEnergy B' =
            noPrimeBranchingEndpointResidualEnergy B := by
        unfold noPrimeBranchingEndpointResidualEnergy
        rw [hleft, hright]
      rw [henergy] at hsucc
      exact
        False.elim
          (Nat.succ_ne_self
            (noPrimeBranchingEndpointResidualEnergy B) hsucc)
    · exact Or.inr hright
  · exact Or.inl hleft

/-- The unit selector stored in a generated no-prime residual normalizer must
change endpoint codes whenever it supplies the P962 one-unit bridge.

The normalizer object is therefore a genuine endpoint-code producer only
through its `unitStep` field; its `normalize`/incidence metadata alone is not
enough. -/
theorem generatedNoPrimeNormalizer_unitStep_changes_endpointCode
    {n : ℕ} (N : SU7GeneratedNoPrimeResidualNormalizer n)
    (B lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n)
    (hBmem : B ∈ generatedNoPrimeBranchingCells n N.codeBound)
    (hlower_mem : lower ∈ generatedNoPrimeBranchingCells n N.codeBound)
    (hlt :
      noPrimeBranchingEndpointResidualEnergy lower <
        noPrimeBranchingEndpointResidualEnergy B) :
    atomCode
        (N.unitStep B lower hBmem hlower_mem hlt).leftAtom.toSU7Atom ≠
        atomCode B.leftAtom.toSU7Atom ∨
      atomCode
        (N.unitStep B lower hBmem hlower_mem hlt).rightAtom.toSU7Atom ≠
        atomCode B.rightAtom.toSU7Atom :=
  noPrimeBranchingUnitSuccessor_changes_endpointCode
    (N.unitStep_energy B lower hBmem hlower_mem hlt)

/-- A generated no-prime residual normalizer's strict transport map also
changes endpoint codes on every nonzero in-list cell.

This records the P979 split precisely: `normalize` is the code-moving strict
descent trace, while `unitStep` is the separate code-moving quantized
one-unit bridge. -/
theorem generatedNoPrimeNormalizer_normalize_changes_endpointCode_of_nonzero
    {n : ℕ} (N : SU7GeneratedNoPrimeResidualNormalizer n)
    (B : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n)
    (hmem : B ∈ generatedNoPrimeBranchingCells n N.codeBound)
    (hnonzero : noPrimeBranchingEndpointResidualEnergy B ≠ 0) :
    atomCode (N.normalize B).leftAtom.toSU7Atom ≠
        atomCode B.leftAtom.toSU7Atom ∨
      atomCode (N.normalize B).rightAtom.toSU7Atom ≠
        atomCode B.rightAtom.toSU7Atom := by
  by_cases hleft :
      atomCode (N.normalize B).leftAtom.toSU7Atom =
        atomCode B.leftAtom.toSU7Atom
  · by_cases hright :
      atomCode (N.normalize B).rightAtom.toSU7Atom =
        atomCode B.rightAtom.toSU7Atom
    · have henergy :
          noPrimeBranchingEndpointResidualEnergy (N.normalize B) =
            noPrimeBranchingEndpointResidualEnergy B := by
        unfold noPrimeBranchingEndpointResidualEnergy
        rw [hleft, hright]
      have hlt :
          noPrimeBranchingEndpointResidualEnergy B <
            noPrimeBranchingEndpointResidualEnergy B := by
        simpa [henergy] using
          N.normalize_strictly_decreases_nonzero B hmem hnonzero
      exact False.elim ((lt_irrefl _) hlt)
    · exact Or.inr hright
  · exact Or.inl hleft

/-- A raw branching one-unit successor must change at least one endpoint code.

This is the raw P913 analogue of the no-prime endpoint-code constraint: a
one-unit residual repair cannot keep the same raw code pair. -/
theorem rawBranchingUnitSuccessor_changes_endpointCode
    {n : ℕ} {c c' : SU7BranchingDecompositionCell n}
    (hsucc :
      rawAtomCodeBranchingDecompositionResidualEnergy c' + 1 =
        rawAtomCodeBranchingDecompositionResidualEnergy c) :
    c'.leftWeightCode ≠ c.leftWeightCode ∨
      c'.rightWeightCode ≠ c.rightWeightCode := by
  by_cases hleft : c'.leftWeightCode = c.leftWeightCode
  · by_cases hright : c'.rightWeightCode = c.rightWeightCode
    · have henergy :
          rawAtomCodeBranchingDecompositionResidualEnergy c' =
            rawAtomCodeBranchingDecompositionResidualEnergy c := by
        rw [rawBranchingResidualEnergy_eq_codePair c',
          rawBranchingResidualEnergy_eq_codePair c,
          hleft, hright]
      rw [henergy] at hsucc
      exact
        False.elim
          (Nat.succ_ne_self
            (rawAtomCodeBranchingDecompositionResidualEnergy c) hsucc)
    · exact Or.inr hright
  · exact Or.inl hleft

/-- The repair selected from a P913 local branching successor law is
code-moving on every active nonzero raw residual cell. -/
theorem rawBranchingSuccessorRepair_changes_endpointCode_of_nonzero
    {C : SU7WeightTensorCoding} {n : ℕ}
    (L : SU7RawBranchingLocalSuccessorLaw C n)
    (c : SU7BranchingDecompositionCell n)
    (hmem : c ∈ L.spectrum.cells)
    (hnonzero : rawAtomCodeBranchingDecompositionResidual c ≠ 0) :
    (rawBranchingSuccessorRepair L c).leftWeightCode ≠ c.leftWeightCode ∨
      (rawBranchingSuccessorRepair L c).rightWeightCode ≠ c.rightWeightCode :=
  rawBranchingUnitSuccessor_changes_endpointCode
    (rawBranchingSuccessorRepair_energy_split_decrement
      L c hmem hnonzero)

/-- A P913 local branching successor law directly generates the same-spectrum
raw branching one-unit successor law.

The `startCell` and `tensor_filter` fields of P913 are useful for downstream
P912/P911 readouts, but the generated P950 throat only consumes the local
successor field.  This theorem exposes that lower source object without
coverage, no-gap, normalizer, or endpoint-shell inputs. -/
theorem rawBranchingSpectrumUnitSuccessor_of_branchingSuccessorLaw
    {C : SU7WeightTensorCoding} {n : ℕ}
    (L : SU7RawBranchingLocalSuccessorLaw C n) :
    SU7RawBranchingSpectrumUnitSuccessorLaw L.spectrum := by
  intro c hmem hnonzero
  exact L.successor_exists c hmem hnonzero

/-- A P912 residual-split repair rule is already a P913 local branching
successor law.

This is the direct unit-successor readout of the repair rule's split
decrement, avoiding the weaker detour through a P911 zero-shell normalizer. -/
def branchingSuccessorLaw_of_residualSplitRepairRule
    {C : SU7WeightTensorCoding} {n : ℕ}
    (R : SU7RawResidualSplitRepairRule C n) :
    SU7RawBranchingLocalSuccessorLaw C n where
  spectrum := R.spectrum
  startCell := R.startCell
  start_mem := R.start_mem
  tensor_filter := R.tensor_filter
  successor_exists := by
    intro c hmem hnonzero
    exact
      ⟨R.repair c,
        R.repair_mem_preserves c hmem,
        R.repair_energy_split_decrement c hmem hnonzero⟩

/-- A P912 residual-split repair rule directly generates the same-spectrum raw
branching one-unit successor law.

This is the current lowest P950 throat, read straight from the repair rule's
split decrement.  It does not pass through coverage, no-gap, endpoint shells,
or the P914 no-holonomy equivalence. -/
theorem rawBranchingSpectrumUnitSuccessor_of_residualSplitRepairRule
    {C : SU7WeightTensorCoding} {n : ℕ}
    (R : SU7RawResidualSplitRepairRule C n) :
    SU7RawBranchingSpectrumUnitSuccessorLaw R.spectrum := by
  intro c hmem hnonzero
  exact
    ⟨R.repair c,
      R.repair_mem_preserves c hmem,
      R.repair_energy_split_decrement c hmem hnonzero⟩

/-- A P910/P916 raw bounded energy shell directly generates the same-spectrum
raw branching one-unit successor law.

The source is the shell's finite predecessor table
`lowerEnergyCell e = e - 1`; this readout avoids the P915
strict-holonomy/no-gap bridge and exposes the exact P950 throat. -/
theorem rawBranchingSpectrumUnitSuccessor_of_rawBranchingShell
    {C : SU7WeightTensorCoding} {n : ℕ}
    (L : SU7RawBranchingTensorFilteredBoundedEnergyShell C n) :
    SU7RawBranchingSpectrumUnitSuccessorLaw L.spectrum := by
  intro c hmem hnonzero
  let e := rawAtomCodeBranchingDecompositionResidualEnergy c
  have hpos : 0 < e :=
    rawAtomCodeBranchingDecompositionResidualEnergy_pos_of_nonzero
      c hnonzero
  have hle : e ≤ L.maxEnergy := L.energy_bound c hmem
  refine ⟨L.lowerEnergyCell e hpos hle,
    L.lowerEnergyCell_mem e hpos hle, ?_⟩
  have hpred :
      rawAtomCodeBranchingDecompositionResidualEnergy
          (L.lowerEnergyCell e hpos hle) = e - 1 :=
    L.lowerEnergyCell_rawEnergy_eq_pred e hpos hle
  omega

/-- A residual-split repair rule directly forbids raw unit permanent holonomy
on its own spectrum.

The premise is the repair rule itself, not a coverage shell, normalizer
receipt, or downstream endpoint carrier. -/
theorem noRawUnitPermanentHolonomy_of_residualSplitRepairRule
    {C : SU7WeightTensorCoding} {n : ℕ}
    (R : SU7RawResidualSplitRepairRule C n) :
    SU7RawBranchingSpectrumForbidsUnitPermanentHolonomy R.spectrum :=
  (noRawUnitPermanentHolonomy_iff_unitSuccessorLaw R.spectrum).mpr
    (by
      intro c hmem hnonzero
      exact
        ⟨R.repair c,
          R.repair_mem_preserves c hmem,
          R.repair_energy_split_decrement c hmem hnonzero⟩)

/-- The repair step in a P912 residual-split repair rule is code-moving on
every active nonzero raw residual cell. -/
theorem residualSplitRepairRule_repair_changes_endpointCode_of_nonzero
    {C : SU7WeightTensorCoding} {n : ℕ}
    (R : SU7RawResidualSplitRepairRule C n)
    (c : SU7BranchingDecompositionCell n)
    (hmem : c ∈ R.spectrum.cells)
    (hnonzero : rawAtomCodeBranchingDecompositionResidual c ≠ 0) :
    (R.repair c).leftWeightCode ≠ c.leftWeightCode ∨
      (R.repair c).rightWeightCode ≠ c.rightWeightCode :=
  rawBranchingUnitSuccessor_changes_endpointCode
    (R.repair_energy_split_decrement c hmem hnonzero)

/-- A raw unit-holonomy witness cannot coexist with a residual-split repair
rule on the same raw branching spectrum.

This is the concrete raw-level contradiction shape: the witness says no
one-unit successor exists, while the repair rule supplies `repair c` with the
split decrement. -/
theorem rawUnitPermanentHolonomy_contradicts_residualSplitRepairRule
    {C : SU7WeightTensorCoding} {n : ℕ}
    (R : SU7RawResidualSplitRepairRule C n)
    {c : SU7BranchingDecompositionCell n}
    (hperm : SU7RawBranchingUnitPermanentHolonomyCell R.spectrum c) :
    False :=
  noRawUnitPermanentHolonomy_of_residualSplitRepairRule R c hperm

/-- A generated P950 witness is a concrete raw unit-permanent-holonomy cell on
the same generated filtered raw spectrum.

This is the source-side lift that was easy to lose: the P950 endpoint-code
terminal is not merely a scalar shell failure.  Its canonical SU(7) source cell
is in the generated raw spectrum, has nonzero raw atom-code residual, and has no
same-spectrum one-unit raw successor. -/
theorem sourceCellLift_rawUnitPermanentHolonomyCell
    {n bound : ℕ} {p : ℕ × ℕ}
    (W : GeneratedFilteredRawCodePairSourceCellLift n bound p) :
    SU7RawBranchingUnitPermanentHolonomyCell
      (gaugeFilteredRawBranchingSpectrum
        n bound (generatedNoPrimeAllowedPredicate n bound))
      W.sourceCell.cell := by
  have hmem :
      W.sourceCell.cell ∈
        (gaugeFilteredRawBranchingSpectrum
          n bound (generatedNoPrimeAllowedPredicate n bound)).cells :=
    sourceCellLift_mem_filteredSpectrum W
  rcases W.holonomy with
    ⟨_hallowed, _hleft_mem, _hright_mem, _hleft_check, _hright_check,
      hpair_nonzero, hterminal⟩
  have henergy_nonzero :
      rawAtomCodeBranchingDecompositionResidualEnergy
          W.sourceCell.cell ≠ 0 := by
    intro hzero
    exact hpair_nonzero
      (by
        rw [← sourceCellLift_energy_reads_pair W]
        exact hzero)
  have hraw_nonzero :
      rawAtomCodeBranchingDecompositionResidual W.sourceCell.cell ≠ 0 := by
    intro hzero
    exact henergy_nonzero
      ((rawAtomCodeBranchingDecompositionResidualEnergy_eq_zero_iff
        W.sourceCell.cell).mpr hzero)
  refine ⟨hmem, hraw_nonzero, ?_⟩
  intro next hnext_mem hsucc
  rcases
      exists_gaugeFilteredBooleanAtomicCell_of_mem_spectrum
        hnext_mem with
    ⟨x, hxmem, hxcell⟩
  have hxparts :
      x ∈ booleanAtomicRawBranchingCandidateList n bound ∧
        generatedNoPrimeAllowedPredicate n bound
          x.cell.leftWeightCode x.cell.rightWeightCode = true := by
    simpa [gaugeFilteredBooleanAtomicRawBranchingCandidateList]
      using (List.mem_filter.mp hxmem)
  have hleft_mem_x :
      x.cell.leftWeightCode ∈ rawCodeBoundedList bound :=
    booleanAtomicCell_left_mem_rawCodeBoundedList_of_mem_generated
      hxparts.1
  have hright_mem_x :
      x.cell.rightWeightCode ∈ rawCodeBoundedList bound :=
    booleanAtomicCell_right_mem_rawCodeBoundedList_of_mem_generated
      hxparts.1
  have hsucc_pair :
      rawCodePairResidualEnergy
          n x.cell.leftWeightCode x.cell.rightWeightCode + 1 =
        rawCodePairResidualEnergy n p.1 p.2 := by
    calc
      rawCodePairResidualEnergy
          n x.cell.leftWeightCode x.cell.rightWeightCode + 1 =
          rawAtomCodeBranchingDecompositionResidualEnergy x.cell + 1 := by
            rw [rawBranchingResidualEnergy_eq_codePair x.cell]
      _ =
          rawAtomCodeBranchingDecompositionResidualEnergy next + 1 := by
            rw [hxcell]
      _ = rawAtomCodeBranchingDecompositionResidualEnergy W.sourceCell.cell :=
            hsucc
      _ = rawCodePairResidualEnergy n p.1 p.2 :=
            sourceCellLift_energy_reads_pair W
  exact
    hterminal
      x.cell.leftWeightCode x.cell.rightWeightCode
      hxparts.2 hleft_mem_x hright_mem_x
      x.left_check x.right_check hsucc_pair

/-- Generated P950 witnesses canonically lift to raw unit-permanent holonomy
on the generated filtered raw spectrum. -/
theorem rawUnitPermanentHolonomyCell_of_generatedP950Holonomy
    {n bound : ℕ} {p : ℕ × ℕ}
    (hp :
      BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
        n bound (generatedNoPrimeAllowedPredicate n bound) p.1 p.2) :
    SU7RawBranchingUnitPermanentHolonomyCell
      (gaugeFilteredRawBranchingSpectrum
        n bound (generatedNoPrimeAllowedPredicate n bound))
      (sourceCellLift_of_generatedP950Holonomy hp).sourceCell.cell :=
  sourceCellLift_rawUnitPermanentHolonomyCell
    (sourceCellLift_of_generatedP950Holonomy hp)

/-- The exact local source step that kills a generated P950 witness.

No global successor law is needed here.  If the canonical SU(7) source cell of
the witness has a same-spectrum one-unit raw repair step, the witness's own
terminal field is contradicted. -/
theorem sourceCellLift_contradicts_sameSpectrumUnitRepairStep
    {n bound : ℕ} {p : ℕ × ℕ}
    (W : GeneratedFilteredRawCodePairSourceCellLift n bound p)
    {next : SU7BranchingDecompositionCell n}
    (hnext_mem :
      next ∈
        (gaugeFilteredRawBranchingSpectrum
          n bound (generatedNoPrimeAllowedPredicate n bound)).cells)
    (hnext_energy :
      rawAtomCodeBranchingDecompositionResidualEnergy next + 1 =
        rawAtomCodeBranchingDecompositionResidualEnergy W.sourceCell.cell) :
    False := by
  have hperm := sourceCellLift_rawUnitPermanentHolonomyCell W
  exact hperm.2.2 next hnext_mem hnext_energy

/-- A generated P950 witness is contradicted by a one-unit repair step from its
own canonical source cell in the generated filtered raw spectrum. -/
theorem generatedP950Holonomy_contradicts_sameSpectrumUnitRepairStep
    {n bound : ℕ} {p : ℕ × ℕ}
    (hp :
      BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
        n bound (generatedNoPrimeAllowedPredicate n bound) p.1 p.2)
    {next : SU7BranchingDecompositionCell n}
    (hnext_mem :
      next ∈
        (gaugeFilteredRawBranchingSpectrum
          n bound (generatedNoPrimeAllowedPredicate n bound)).cells)
    (hnext_energy :
      rawAtomCodeBranchingDecompositionResidualEnergy next + 1 =
        rawAtomCodeBranchingDecompositionResidualEnergy
          (sourceCellLift_of_generatedP950Holonomy hp).sourceCell.cell) :
    False :=
  sourceCellLift_contradicts_sameSpectrumUnitRepairStep
    (sourceCellLift_of_generatedP950Holonomy hp)
    hnext_mem hnext_energy

/-- A local same-spectrum repair step realizes the calibrated Truth Formula
unit descent, and so contradicts a concrete generated P950 witness.

This is the active-transport reading at the exact witness throat: the repair
cell has raw energy `E - 1`, which is precisely the residual after one update
of the scalar Truth Formula producer calibrated at the P950 energy `E`. -/
theorem generatedP950Holonomy_contradicts_sameSpectrumUnitRepairStep_via_truthFormulaUnitDescent
    {n bound : ℕ} {p : ℕ × ℕ}
    (hp :
      BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
        n bound (generatedNoPrimeAllowedPredicate n bound) p.1 p.2)
    {next : SU7BranchingDecompositionCell n}
    (hnext_mem :
      next ∈
        (gaugeFilteredRawBranchingSpectrum
          n bound (generatedNoPrimeAllowedPredicate n bound)).cells)
    (hnext_energy :
      rawAtomCodeBranchingDecompositionResidualEnergy next + 1 =
        rawAtomCodeBranchingDecompositionResidualEnergy
          (sourceCellLift_of_generatedP950Holonomy hp).sourceCell.cell) :
    False := by
  let W := sourceCellLift_of_generatedP950Holonomy hp
  rcases
      exists_gaugeFilteredBooleanAtomicCell_of_mem_spectrum
        hnext_mem with
    ⟨x, hxmem, hxcell⟩
  have hxparts :
      x ∈ booleanAtomicRawBranchingCandidateList n bound ∧
        generatedNoPrimeAllowedPredicate n bound
          x.cell.leftWeightCode x.cell.rightWeightCode = true := by
    simpa [gaugeFilteredBooleanAtomicRawBranchingCandidateList]
      using (List.mem_filter.mp hxmem)
  have hleft_mem_x :
      x.cell.leftWeightCode ∈ rawCodeBoundedList bound :=
    booleanAtomicCell_left_mem_rawCodeBoundedList_of_mem_generated
      hxparts.1
  have hright_mem_x :
      x.cell.rightWeightCode ∈ rawCodeBoundedList bound :=
    booleanAtomicCell_right_mem_rawCodeBoundedList_of_mem_generated
      hxparts.1
  have hsucc_pair :
      rawCodePairResidualEnergy
          n x.cell.leftWeightCode x.cell.rightWeightCode + 1 =
        rawCodePairResidualEnergy n p.1 p.2 := by
    calc
      rawCodePairResidualEnergy
          n x.cell.leftWeightCode x.cell.rightWeightCode + 1 =
          rawAtomCodeBranchingDecompositionResidualEnergy x.cell + 1 := by
            rw [rawBranchingResidualEnergy_eq_codePair x.cell]
      _ =
          rawAtomCodeBranchingDecompositionResidualEnergy next + 1 := by
            rw [hxcell]
      _ = rawAtomCodeBranchingDecompositionResidualEnergy
            W.sourceCell.cell := hnext_energy
      _ = rawCodePairResidualEnergy n p.1 p.2 :=
            sourceCellLift_energy_reads_pair W
  exact
    generatedFilteredRawCodePairHolonomy_contradicts_truthFormulaUnitDescentRealization
      hp hxparts.2 hleft_mem_x hright_mem_x
      x.left_check x.right_check
      (by
