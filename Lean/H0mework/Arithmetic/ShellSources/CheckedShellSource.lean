Thus P950 fails because the conserved residual quantum has a generated repair
realization, not because coverage/no-gap has been assumed. -/
theorem completedBoundP950_contradicts_quantizedBridge_and_strictLower_via_generatedRepairCell
    {K : Type*} [Field K] {σ : K} {hσ : σ ≠ 1}
    {n bound completedBound : ℕ}
    (hbound : bound ≤ completedBound)
    (Q :
      NoPrimeBranchingQuantizedUnitBridge
        (generatedNoPrimeBranchingCells n completedBound))
    (A : SU7ProducedActiveCell σ hσ n bound)
    {lower : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n}
    (hlower_mem : lower ∈ generatedNoPrimeBranchingCells n completedBound)
    (hlt :
      noPrimeBranchingEndpointResidualEnergy lower <
        noPrimeBranchingEndpointResidualEnergy
          (noPrimeBranchingCellOfBooleanAtomicRawCell A.sourceCell)) :
    ¬ BoolGaugeFilteredRawCodePairUnitPermanentHolonomyCell
      n completedBound
        (generatedNoPrimeAllowedPredicate n completedBound)
        A.sourceCell.cell.leftWeightCode
        A.sourceCell.cell.rightWeightCode := by
  intro hp
  have hp_keep := hp
  rcases hp with
    ⟨_hallowed, _hleft_mem, _hright_mem, _hleft_check, _hright_check,
      hnonzero, _hterminal⟩
  have hsource_pair_energy :
      rawCodePairResidualEnergy n
          A.sourceCell.cell.leftWeightCode
          A.sourceCell.cell.rightWeightCode = A.energy :=
