unit below the witness's canonical source cell. -/
theorem sourceCellLift_sameSpectrumUnitRepairStep_of_noPrimeUnitStep
    {n bound : ℕ} {p : ℕ × ℕ}
    (W : GeneratedFilteredRawCodePairSourceCellLift n bound p)
    {step : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n}
