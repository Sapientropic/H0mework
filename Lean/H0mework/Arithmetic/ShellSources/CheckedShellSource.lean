/-- Certificate for the finite-checker information route into P1037. -/
structure FiniteNoPrimeCheckedShellSourceProducerCertificate where
  source_to_checked_rule :
    ∀ {C : SU7WeightTensorCoding} {n : ℕ},
      SU7FiniteNoPrimeCheckedShellSource C n ->
        SU7NoPrimeBranchingCheckedEnergyShellRule C n
  source_to_nonempty_checked_shell :
    ∀ {C : SU7WeightTensorCoding} {n : ℕ},
      SU7FiniteNoPrimeCheckedShellSource C n ->
        SU7NoPrimeNonemptyCheckedShell C n
  source_every_fiber_to_nonempty_checked_shells :
    ∀ {C : SU7WeightTensorCoding},
      SU7FiniteNoPrimeCheckedShellSourceEveryEvenFiber C ->
        SU7NoPrimeNonemptyCheckedShellEveryEvenFiber C
  generated_no_prime_unit_confinement_to_finite_source :
    ∀ {n : ℕ},
      SU7GeneratedNoPrimeUnitConfinementCertificate n ->
        SU7FiniteNoPrimeCheckedShellSource rawCodeTensorCoding n
  generated_no_prime_unit_confinement_to_raw_nonempty_checked_shell :
    ∀ {n : ℕ},
      SU7GeneratedNoPrimeUnitConfinementCertificate n ->
        SU7NoPrimeNonemptyCheckedShell rawCodeTensorCoding n
  generated_no_prime_unit_confinement_to_bool_gauge_filtered_coverage :
    ∀ {n : ℕ} (G : SU7GeneratedNoPrimeUnitConfinementCertificate n),
      BoolGaugeFilteredRawCodePairEnergyCoverage
        n G.codeBound
        (generatedNoPrimeAllowedPredicate n G.codeBound)
  generated_no_prime_unit_confinement_to_raw_nonempty_checked_shell_via_allowed_coverage :
    ∀ {n : ℕ},
      SU7GeneratedNoPrimeUnitConfinementCertificate n ->
        SU7NoPrimeNonemptyCheckedShell rawCodeTensorCoding n
  generated_no_prime_coverage_failure_to_strict_terminal_or_density_failure :
    ∀ {n bound : ℕ},
      2 ≤ bound ->
        ¬ BoolGaugeFilteredRawCodePairEnergyCoverage
            n bound (generatedNoPrimeAllowedPredicate n bound) ->
          Nonempty
              {B : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n //
                NoPrimeBranchingCellStrictPermanentHolonomy
                  (generatedNoPrimeBranchingCells n bound) B} ∨
            ¬ NoPrimeBranchingCellEnergyUnitDensity
                (generatedNoPrimeBranchingCells n bound)
  generated_no_prime_missing_shell_to_strict_terminal_or_density_failure :
    ∀ {n bound k : ℕ},
      2 ≤ bound ->
        k < generatedRawBranchingMaxEnergy n bound ->
          ¬ BoolGaugeFilteredRawCodePairEnergyShellRealized
              n bound (generatedNoPrimeAllowedPredicate n bound) k ->
            Nonempty
                {B : SU7NoPrimeBranchingSpectrumCell rawCodeTensorCoding n //
                  NoPrimeBranchingCellStrictPermanentHolonomy
                    (generatedNoPrimeBranchingCells n bound) B} ∨
              ¬ NoPrimeBranchingCellEnergyUnitDensity
                  (generatedNoPrimeBranchingCells n bound)
  no_prime_strict_terminal_to_filtered_code_pair_holonomy :
    ∀ {C : SU7WeightTensorCoding} {n bound : ℕ}
