import H0mework.Arithmetic.CodePairs.P915

/-!
# Proposition 916: raw bounded shells produce no-gap confinement

P915 isolated the real no-gap obligation:

```text
strict Lyapunov descent + raw energy unit-density
```

P910 already has the concrete finite quantized shell object carrying
`lowerEnergyCell e` with energy exactly `e - 1`.  This file connects them:
a raw tensor-filtered bounded energy shell directly produces P915's no-gap
confinement rule.

So the no-gap condition is no longer an isolated hypothesis in this part of
the chain; it is generated by the bounded raw energy-shell predecessor table.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open SaturationMonoid.AffineRelaxation
open RunningSigmaBeta

set_option linter.defProp false

/-! ## Raw bounded shells imply strict descent and unit density -/

/-- In a raw bounded shell, every nonzero residual cell has the canonical
`e - 1` predecessor supplied by the shell. -/
theorem rawBranchingShell_strictSuccessorLaw
    {C : SU7WeightTensorCoding} {n : ℕ}
    (L : SU7RawBranchingTensorFilteredBoundedEnergyShell C n) :
    SU7RawBranchingSpectrumStrictSuccessorLaw L.spectrum := by
  intro c hmem hnonzero
  let e := rawAtomCodeBranchingDecompositionResidualEnergy c
  have hpos : 0 < e :=
    rawAtomCodeBranchingDecompositionResidualEnergy_pos_of_nonzero
      c hnonzero
  have hle : e ≤ L.maxEnergy := L.energy_bound c hmem
  refine ⟨L.lowerEnergyCell e hpos hle,
    L.lowerEnergyCell_mem e hpos hle, ?_⟩
  have hpred :
      rawAtomCodeBranchingDecompositionResidualEnergy
          (L.lowerEnergyCell e hpos hle) = e - 1 :=
    L.lowerEnergyCell_rawEnergy_eq_pred e hpos hle
  omega

/-- In a raw bounded shell, any strict descent below a cell forces the adjacent
energy shell below that cell to be represented in the spectrum. -/
theorem rawBranchingShell_energyUnitDensity
    {C : SU7WeightTensorCoding} {n : ℕ}
    (L : SU7RawBranchingTensorFilteredBoundedEnergyShell C n) :
    SU7RawBranchingSpectrumEnergyUnitDensity L.spectrum := by
  intro c lower hmem _hlower_mem hlower_lt
  let e := rawAtomCodeBranchingDecompositionResidualEnergy c
  have hpos : 0 < e := by omega
  have hle : e ≤ L.maxEnergy := L.energy_bound c hmem
  refine ⟨L.lowerEnergyCell e hpos hle,
    L.lowerEnergyCell_mem e hpos hle, ?_⟩
  have hpred :
      rawAtomCodeBranchingDecompositionResidualEnergy
          (L.lowerEnergyCell e hpos hle) = e - 1 :=
    L.lowerEnergyCell_rawEnergy_eq_pred e hpos hle
  omega

/-- A raw bounded shell directly generates P914's one-unit successor law.

This is the lower throat hidden inside the existing P916 no-gap route: the
shell's predecessor representative is already the exact `e - 1` successor
needed by P914, so no strict-holonomy/no-gap equivalence is used. -/
theorem rawBranchingShell_unitSuccessorLaw
    {C : SU7WeightTensorCoding} {n : ℕ}
    (L : SU7RawBranchingTensorFilteredBoundedEnergyShell C n) :
    SU7RawBranchingSpectrumUnitSuccessorLaw L.spectrum := by
  intro c hmem hnonzero
  let e := rawAtomCodeBranchingDecompositionResidualEnergy c
  have hpos : 0 < e :=
    rawAtomCodeBranchingDecompositionResidualEnergy_pos_of_nonzero
      c hnonzero
  have hle : e ≤ L.maxEnergy := L.energy_bound c hmem
  refine ⟨L.lowerEnergyCell e hpos hle,
    L.lowerEnergyCell_mem e hpos hle, ?_⟩
  have hpred :
      rawAtomCodeBranchingDecompositionResidualEnergy
          (L.lowerEnergyCell e hpos hle) = e - 1 :=
    L.lowerEnergyCell_rawEnergy_eq_pred e hpos hle
  omega

/-- A raw bounded shell forbids strict permanent holonomy. -/
theorem rawBranchingShell_forbidsStrictPermanentHolonomy
    {C : SU7WeightTensorCoding} {n : ℕ}
    (L : SU7RawBranchingTensorFilteredBoundedEnergyShell C n) :
    SU7RawBranchingSpectrumForbidsStrictPermanentHolonomy L.spectrum :=
  (noRawStrictPermanentHolonomy_iff_strictSuccessorLaw L.spectrum).mpr
    (rawBranchingShell_strictSuccessorLaw L)

/-- A raw bounded shell forbids unit permanent holonomy by P915's no-gap
bridge. -/
theorem rawBranchingShell_forbidsUnitPermanentHolonomy
    {C : SU7WeightTensorCoding} {n : ℕ}
    (L : SU7RawBranchingTensorFilteredBoundedEnergyShell C n) :
    SU7RawBranchingSpectrumForbidsUnitPermanentHolonomy L.spectrum :=
  noRawUnitPermanentHolonomy_of_noRawStrict_and_unitDensity
    L.spectrum
    (rawBranchingShell_forbidsStrictPermanentHolonomy L)
    (rawBranchingShell_energyUnitDensity L)

/-! ## Raw bounded shells generate no-gap confinement rules -/

/-- A P910 raw bounded shell is a P915 no-gap confinement rule. -/
def noGapConfinementRule_of_rawBranchingShell
    {C : SU7WeightTensorCoding} {n : ℕ}
    (L : SU7RawBranchingTensorFilteredBoundedEnergyShell C n) :
    SU7RawBranchingNoGapConfinementRule C n where
  spectrum := L.spectrum
  startCell := L.startCell
  start_mem := L.start_mem
  tensor_filter := L.tensor_filter
  forbids_strict_permanent_holonomy :=
    rawBranchingShell_forbidsStrictPermanentHolonomy L
  energy_unit_density :=
    rawBranchingShell_energyUnitDensity L

/-- A raw bounded shell computes a trace-zero prime-edge loop through the
P915 no-gap route. -/
def traceZeroPrimeEdgeLoop_of_rawBranchingShell_viaNoGap
    {C : SU7WeightTensorCoding} {n : ℕ}
    (L : SU7RawBranchingTensorFilteredBoundedEnergyShell C n) :
    TraceZeroPrimeEdgeLoop n :=
  traceZeroPrimeEdgeLoop_of_noGapConfinementRule
    (noGapConfinementRule_of_rawBranchingShell L)

/-! ## Fiberwise raw bounded shells via no-gap -/

/-- Fiberwise raw bounded shells generate P915 no-gap confinement rules on
every even fiber. -/
def noGapConfinementRulesEveryEvenFiber_of_rawBranchingShells
    {C : SU7WeightTensorCoding}
    (H : SU7RawBranchingTensorFilteredBoundedEnergyShellEveryEvenFiber C) :
    SU7RawBranchingNoGapConfinementRuleEveryEvenFiber C := by
  intro n hn
  exact ⟨noGapConfinementRule_of_rawBranchingShell
    (Classical.choice (H n hn))⟩

/-- Fiberwise raw bounded shells give ordinary even Goldbach through the
explicit no-gap route. -/
theorem evenGoldbach_of_rawBranchingShells_viaNoGap
    {C : SU7WeightTensorCoding}
    (H : SU7RawBranchingTensorFilteredBoundedEnergyShellEveryEvenFiber C) :
    EvenGoldbachStatement :=
  evenGoldbach_of_noGapConfinementRules
    (noGapConfinementRulesEveryEvenFiber_of_rawBranchingShells H)

/-! ## Certificate -/

/-- P916 certificate: P910 raw bounded shells generate P915 no-gap confinement.
-/
structure SU7RawBoundedShellNoGapProducerCertificate where
  shell_to_strict_successor :
    ∀ {C : SU7WeightTensorCoding} {n : ℕ}
      (L : SU7RawBranchingTensorFilteredBoundedEnergyShell C n),
      SU7RawBranchingSpectrumStrictSuccessorLaw L.spectrum
  shell_to_unit_density :
    ∀ {C : SU7WeightTensorCoding} {n : ℕ}
      (L : SU7RawBranchingTensorFilteredBoundedEnergyShell C n),
      SU7RawBranchingSpectrumEnergyUnitDensity L.spectrum
  shell_to_unit_successor :
    ∀ {C : SU7WeightTensorCoding} {n : ℕ}
      (L : SU7RawBranchingTensorFilteredBoundedEnergyShell C n),
      SU7RawBranchingSpectrumUnitSuccessorLaw L.spectrum
  shell_to_no_unit_holonomy :
    ∀ {C : SU7WeightTensorCoding} {n : ℕ}
      (L : SU7RawBranchingTensorFilteredBoundedEnergyShell C n),
      SU7RawBranchingSpectrumForbidsUnitPermanentHolonomy L.spectrum
  shell_to_no_gap_rule :
    ∀ {C : SU7WeightTensorCoding} {n : ℕ},
      SU7RawBranchingTensorFilteredBoundedEnergyShell C n ->
        SU7RawBranchingNoGapConfinementRule C n
  every_fiber_to_no_gap :
    ∀ {C : SU7WeightTensorCoding},
      SU7RawBranchingTensorFilteredBoundedEnergyShellEveryEvenFiber C ->
        SU7RawBranchingNoGapConfinementRuleEveryEvenFiber C
  every_fiber_to_goldbach :
    ∀ {C : SU7WeightTensorCoding},
      SU7RawBranchingTensorFilteredBoundedEnergyShellEveryEvenFiber C ->
        EvenGoldbachStatement

/-- Canonical P916 producer certificate. -/
def su7RawBoundedShellNoGapProducerCertificate :
    SU7RawBoundedShellNoGapProducerCertificate where
  shell_to_strict_successor :=
    rawBranchingShell_strictSuccessorLaw
  shell_to_unit_density :=
    rawBranchingShell_energyUnitDensity
  shell_to_unit_successor :=
    rawBranchingShell_unitSuccessorLaw
  shell_to_no_unit_holonomy :=
    rawBranchingShell_forbidsUnitPermanentHolonomy
  shell_to_no_gap_rule :=
    noGapConfinementRule_of_rawBranchingShell
  every_fiber_to_no_gap :=
    noGapConfinementRulesEveryEvenFiber_of_rawBranchingShells
  every_fiber_to_goldbach :=
    evenGoldbach_of_rawBranchingShells_viaNoGap


end
end StandardModelConstraint
end SaturationMonoid
