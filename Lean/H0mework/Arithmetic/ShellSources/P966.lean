import H0mework.Arithmetic.ShellSources.P965

/-!
# Proposition 966: no-prime branch-cell shells generate the allowed sector

P965 made the correct no-gap target explicit, but it still accepted an
external Boolean endpoint predicate

```lean
allowed : Nat -> Nat -> Bool
```

This file removes that last floating input.  The allowed predicate is generated
by a source list of `SU7NoPrimeBranchingSpectrumCell`s.  Those cells contain
SU(7) tensor-irreducible atoms, not `Nat.Prime` proofs, `PrimeExponent`s, or a
Goldbach pair.

The hard producer target is therefore:

```text
no-prime SU(7) branch-cell source list
+ bounded endpoint codes
+ residual-energy shell coverage up to the generated raw maximum
-> P965 gauge-filtered shell coverage
```

Prime-edge arithmetic remains a projection theorem from P932/P951.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open SaturationMonoid.AffineRelaxation
open RunningSigmaBeta

set_option linter.defProp false

/-! ## No-prime branch-cell shell coverage -/

/-- A no-prime SU(7) branch-cell source list realizes an endpoint residual
energy shell when one source cell has that endpoint residual energy.

The source cell stores tensor-irreducible SU(7) atoms.  It stores no
`Nat.Prime` proof and no trace-zero/Goldbach witness. -/
def NoPrimeBranchingEndpointShellRealizedUpToGeneratedMax
    {C : SU7WeightTensorCoding} {n : ℕ}
    (xs : List (SU7NoPrimeBranchingSpectrumCell C n))
    (k : ℕ) : Prop :=
  ∃ B : SU7NoPrimeBranchingSpectrumCell C n,
    B ∈ xs ∧ noPrimeBranchingEndpointResidualEnergy B = k

/-- The no-prime SU(7) source list covers every residual-energy shell below
the raw generated maximum used by P965. -/
def NoPrimeBranchingEndpointShellCoverageUpToGeneratedMax
    {C : SU7WeightTensorCoding} {n : ℕ}
    (bound : ℕ)
    (xs : List (SU7NoPrimeBranchingSpectrumCell C n)) : Prop :=
  ∀ k : ℕ, k < generatedRawBranchingMaxEnergy n bound ->
    NoPrimeBranchingEndpointShellRealizedUpToGeneratedMax xs k

/-! ## From no-prime source shells to P965 allowed shells -/

/-- A no-prime branch-cell shell witness computes a P965 gauge-filtered raw
code-pair shell witness under the allowed predicate generated by the same
source list. -/
theorem boolGaugeFilteredShell_of_noPrimeEndpointShell
    {C : SU7WeightTensorCoding} {n bound k : ℕ}
    {xs : List (SU7NoPrimeBranchingSpectrumCell C n)}
    (hbounded : NoPrimeBranchingCellsWithinBound bound xs)
    (h :
      NoPrimeBranchingEndpointShellRealizedUpToGeneratedMax xs k) :
    BoolGaugeFilteredRawCodePairEnergyShellRealized
      n bound (noPrimeBranchingAllowedPredicate xs) k := by
  rcases h with ⟨B, hBmem, henergy⟩
  refine
    ⟨atomCode B.leftAtom.toSU7Atom,
      atomCode B.rightAtom.toSU7Atom,
      noPrimeBranchingAllowedPredicate_of_mem hBmem,
      (hbounded B hBmem).1,
      (hbounded B hBmem).2,
      noPrimeBranchingCell_left_atomicCheck B,
      noPrimeBranchingCell_right_atomicCheck B,
      ?_⟩
  simpa [noPrimeBranchingEndpointResidualEnergy] using henergy

/-- No-prime branch-cell shell coverage gives P965's gauge-filtered shell
coverage.  The Boolean `allowed` predicate is generated from the source cells,
not supplied as a free external selector. -/
theorem boolGaugeFilteredCoverage_of_noPrimeEndpointCoverage
    {C : SU7WeightTensorCoding} {n bound : ℕ}
    {xs : List (SU7NoPrimeBranchingSpectrumCell C n)}
    (hbounded : NoPrimeBranchingCellsWithinBound bound xs)
    (H : NoPrimeBranchingEndpointShellCoverageUpToGeneratedMax bound xs) :
    BoolGaugeFilteredRawCodePairEnergyCoverage
      n bound (noPrimeBranchingAllowedPredicate xs) := by
  intro k hk
  exact boolGaugeFilteredShell_of_noPrimeEndpointShell
    hbounded (H k hk)

/-! ## Feeding the P965/P964 throat -/

/-- No-prime source-shell coverage produces the generated no-prime
flow/quantization certificate through P965. -/
def generatedNoPrimeFlowQuantizationCertificate_of_noPrimeEndpointCoverage
    {C : SU7WeightTensorCoding} {n bound : ℕ}
    {xs : List (SU7NoPrimeBranchingSpectrumCell C n)}
    (hbound : 2 ≤ bound)
    (hbounded : NoPrimeBranchingCellsWithinBound bound xs)
    (H : NoPrimeBranchingEndpointShellCoverageUpToGeneratedMax bound xs) :
    SU7GeneratedNoPrimeFlowQuantizationCertificate n :=
  generatedNoPrimeFlowQuantizationCertificate_of_boolGaugeFilteredCoverage
    hbound
    (boolGaugeFilteredCoverage_of_noPrimeEndpointCoverage hbounded H)

/-- No-prime source-shell coverage forbids unit permanent holonomy in the
filtered generated spectrum selected by the same source list. -/
theorem filteredSpectrumNoHolonomy_of_noPrimeEndpointCoverage
    {C : SU7WeightTensorCoding} {n bound : ℕ}
    {xs : List (SU7NoPrimeBranchingSpectrumCell C n)}
    (hbounded : NoPrimeBranchingCellsWithinBound bound xs)
    (H : NoPrimeBranchingEndpointShellCoverageUpToGeneratedMax bound xs) :
    SU7RawBranchingSpectrumForbidsUnitPermanentHolonomy
      (gaugeFilteredRawBranchingSpectrum n bound
        (noPrimeBranchingAllowedPredicate xs)) :=
  filteredSpectrumNoHolonomy_of_boolGaugeFilteredCoverage
    (boolGaugeFilteredCoverage_of_noPrimeEndpointCoverage hbounded H)

/-! ## Canonical generated no-prime source list -/

/-- P955's generated no-prime branch-cell list covers every generated raw
residual shell whenever P928's transparent generated coverage theorem holds.
-/
theorem noPrimeEndpointShellCoverage_of_generatedRawEnergyCoverage
    {n bound : ℕ}
    (H : GeneratedRawEnergyCoverage n bound) :
    NoPrimeBranchingEndpointShellCoverageUpToGeneratedMax
      bound (generatedNoPrimeBranchingCells n bound) := by
  intro k hk
  exact noPrimeEndpointEnergyShell_of_generatedRawEnergyShell (H k hk)

/-- The canonical generated no-prime branch-cell list produces P965's
allowed-sector shell coverage from P928's transparent generated coverage.
-/
theorem boolGaugeFilteredCoverage_of_generatedNoPrimeCells
    {n bound : ℕ}
    (H : GeneratedRawEnergyCoverage n bound) :
    BoolGaugeFilteredRawCodePairEnergyCoverage
      n bound
      (noPrimeBranchingAllowedPredicate
        (generatedNoPrimeBranchingCells n bound)) :=
  boolGaugeFilteredCoverage_of_noPrimeEndpointCoverage
    (generatedNoPrimeBranchingCellsWithinBound n bound)
    (noPrimeEndpointShellCoverage_of_generatedRawEnergyCoverage H)

/-- The canonical generated no-prime branch-cell list feeds the P964/P965
flow-quantization throat. -/
def generatedNoPrimeFlowQuantizationCertificate_of_generatedNoPrimeCells
    {n bound : ℕ}
    (hbound : 2 ≤ bound)
    (H : GeneratedRawEnergyCoverage n bound) :
    SU7GeneratedNoPrimeFlowQuantizationCertificate n :=
  generatedNoPrimeFlowQuantizationCertificate_of_noPrimeEndpointCoverage
    hbound
    (generatedNoPrimeBranchingCellsWithinBound n bound)
    (noPrimeEndpointShellCoverage_of_generatedRawEnergyCoverage H)

/-! ## Fiberwise producer shape -/

/-- Every even fiber carries a no-prime SU(7) branch-cell source list with
bounded endpoint codes and generated-max shell coverage. -/
structure SU7NoPrimeEndpointShellCoverageEveryEvenFiber
    (C : SU7WeightTensorCoding) where
  codeBound : ℕ -> ℕ
  codeBound_ge_two : ∀ n : ℕ, 2 ≤ n -> 2 ≤ codeBound n
  cells :
    ∀ n : ℕ, 2 ≤ n -> List (SU7NoPrimeBranchingSpectrumCell C n)
  cells_within_bound :
    ∀ n : ℕ, ∀ hn : 2 ≤ n,
      NoPrimeBranchingCellsWithinBound (codeBound n) (cells n hn)
  shell_coverage :
    ∀ n : ℕ, ∀ hn : 2 ≤ n,
      NoPrimeBranchingEndpointShellCoverageUpToGeneratedMax
        (codeBound n) (cells n hn)

/-- Fiberwise no-prime branch-cell shell coverage produces P962's generated
flow/quantization certificate on every even fiber. -/
theorem generatedFlowQuantizationEveryEvenFiber_of_noPrimeEndpointCoverage
    {C : SU7WeightTensorCoding}
    (H : SU7NoPrimeEndpointShellCoverageEveryEvenFiber C) :
    SU7GeneratedNoPrimeFlowQuantizationEveryEvenFiber := by
  intro n hn
  exact
    ⟨generatedNoPrimeFlowQuantizationCertificate_of_noPrimeEndpointCoverage
      (H.codeBound_ge_two n hn)
      (H.cells_within_bound n hn)
      (H.shell_coverage n hn)⟩

/-- Fiberwise no-prime branch-cell shell coverage eliminates filtered
generated unit permanent holonomy on every even fiber. -/
theorem filteredNoHolonomyEveryEvenFiber_of_noPrimeEndpointCoverage
    {C : SU7WeightTensorCoding}
    (H : SU7NoPrimeEndpointShellCoverageEveryEvenFiber C) :
    ∀ n : ℕ, 2 ≤ n ->
      ∃ bound : ℕ,
      ∃ xs : List (SU7NoPrimeBranchingSpectrumCell C n),
        SU7RawBranchingSpectrumForbidsUnitPermanentHolonomy
          (gaugeFilteredRawBranchingSpectrum n bound
            (noPrimeBranchingAllowedPredicate xs)) := by
  intro n hn
  exact
    ⟨H.codeBound n,
      H.cells n hn,
      filteredSpectrumNoHolonomy_of_noPrimeEndpointCoverage
        (H.cells_within_bound n hn)
        (H.shell_coverage n hn)⟩

/-! ## Certificate -/

/-- P966 certificate: the P965 allowed-sector shell coverage is generated by
no-prime SU(7) branch-spectrum cells. -/
structure SU7NoPrimeBranchCellShellCoverageProducerCertificate where
  no_prime_shell_to_allowed_shell :
    ∀ {C : SU7WeightTensorCoding} {n bound k : ℕ}
      {xs : List (SU7NoPrimeBranchingSpectrumCell C n)},
      NoPrimeBranchingCellsWithinBound bound xs ->
        NoPrimeBranchingEndpointShellRealizedUpToGeneratedMax xs k ->
          BoolGaugeFilteredRawCodePairEnergyShellRealized
            n bound (noPrimeBranchingAllowedPredicate xs) k
  no_prime_coverage_to_allowed_coverage :
    ∀ {C : SU7WeightTensorCoding} {n bound : ℕ}
      {xs : List (SU7NoPrimeBranchingSpectrumCell C n)},
      NoPrimeBranchingCellsWithinBound bound xs ->
        NoPrimeBranchingEndpointShellCoverageUpToGeneratedMax bound xs ->
          BoolGaugeFilteredRawCodePairEnergyCoverage
            n bound (noPrimeBranchingAllowedPredicate xs)
  no_prime_coverage_to_flow_quantization :
    ∀ {C : SU7WeightTensorCoding} {n bound : ℕ}
      {xs : List (SU7NoPrimeBranchingSpectrumCell C n)},
      2 ≤ bound ->
        NoPrimeBranchingCellsWithinBound bound xs ->
          NoPrimeBranchingEndpointShellCoverageUpToGeneratedMax bound xs ->
            SU7GeneratedNoPrimeFlowQuantizationCertificate n
  no_prime_coverage_to_filtered_no_holonomy :
    ∀ {C : SU7WeightTensorCoding} {n bound : ℕ}
      {xs : List (SU7NoPrimeBranchingSpectrumCell C n)},
      NoPrimeBranchingCellsWithinBound bound xs ->
        NoPrimeBranchingEndpointShellCoverageUpToGeneratedMax bound xs ->
          SU7RawBranchingSpectrumForbidsUnitPermanentHolonomy
            (gaugeFilteredRawBranchingSpectrum n bound
              (noPrimeBranchingAllowedPredicate xs))
  generated_raw_coverage_to_no_prime_shells :
    ∀ {n bound : ℕ},
      GeneratedRawEnergyCoverage n bound ->
        NoPrimeBranchingEndpointShellCoverageUpToGeneratedMax
          bound (generatedNoPrimeBranchingCells n bound)
  generated_raw_coverage_to_allowed_coverage :
    ∀ {n bound : ℕ},
      GeneratedRawEnergyCoverage n bound ->
        BoolGaugeFilteredRawCodePairEnergyCoverage
          n bound
          (noPrimeBranchingAllowedPredicate
            (generatedNoPrimeBranchingCells n bound))
  generated_raw_coverage_to_flow_quantization :
    ∀ {n bound : ℕ},
      2 ≤ bound ->
        GeneratedRawEnergyCoverage n bound ->
          SU7GeneratedNoPrimeFlowQuantizationCertificate n
  every_fiber_to_flow_quantization :
    ∀ {C : SU7WeightTensorCoding},
      SU7NoPrimeEndpointShellCoverageEveryEvenFiber C ->
        SU7GeneratedNoPrimeFlowQuantizationEveryEvenFiber

/-- Canonical P966 no-prime branch-cell shell-coverage producer certificate.
-/
def su7NoPrimeBranchCellShellCoverageProducerCertificate :
    SU7NoPrimeBranchCellShellCoverageProducerCertificate where
  no_prime_shell_to_allowed_shell :=
    boolGaugeFilteredShell_of_noPrimeEndpointShell
  no_prime_coverage_to_allowed_coverage :=
    boolGaugeFilteredCoverage_of_noPrimeEndpointCoverage
  no_prime_coverage_to_flow_quantization := by
    intro C n bound xs hbound hbounded H
    exact
      generatedNoPrimeFlowQuantizationCertificate_of_noPrimeEndpointCoverage
        hbound hbounded H
  no_prime_coverage_to_filtered_no_holonomy :=
    filteredSpectrumNoHolonomy_of_noPrimeEndpointCoverage
  generated_raw_coverage_to_no_prime_shells :=
    noPrimeEndpointShellCoverage_of_generatedRawEnergyCoverage
  generated_raw_coverage_to_allowed_coverage :=
    boolGaugeFilteredCoverage_of_generatedNoPrimeCells
  generated_raw_coverage_to_flow_quantization := by
    intro n bound hbound H
    exact
      generatedNoPrimeFlowQuantizationCertificate_of_generatedNoPrimeCells
        hbound H
  every_fiber_to_flow_quantization :=
    generatedFlowQuantizationEveryEvenFiber_of_noPrimeEndpointCoverage


end
end StandardModelConstraint
end SaturationMonoid
