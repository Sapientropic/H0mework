import H0mework.Arithmetic.CodePairs.P950
import H0mework.Arithmetic.ShellSources.P932

/-!
# Proposition 951: no-prime branch cells generate the allowed-sector predicate

P949/P950 made the remaining throat a Boolean endpoint-code predicate

```lean
allowed : Nat -> Nat -> Bool
```

This file stops that predicate from floating free.  A finite list of
`SU7NoPrimeBranchingSpectrumCell`s generates `allowed`; those source cells store
tensor-irreducible SU(7) atoms, not `Nat.Prime` proofs or Goldbach pairs.

The prime-edge facts are then read out only from the projection theorem of
P932.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open SaturationMonoid.AffineRelaxation
open RunningSigmaBeta

set_option linter.defProp false

/-! ## Allowed-sector predicates generated by no-prime branch cells -/

/-- A pair of endpoint codes is allowed by a no-prime SU(7) branch-cell list
when some generated no-prime cell projects to exactly those endpoint codes.

This predicate stores no primality data. -/
def NoPrimeBranchingAllowedPair
    {C : SU7WeightTensorCoding} {n : ℕ}
    (xs : List (SU7NoPrimeBranchingSpectrumCell C n))
    (left right : ℕ) : Prop :=
  ∃ B : SU7NoPrimeBranchingSpectrumCell C n,
    B ∈ xs ∧
      atomCode B.leftAtom.toSU7Atom = left ∧
        atomCode B.rightAtom.toSU7Atom = right

/-- Boolean allowed-sector predicate produced from no-prime SU(7) branch
cells. -/
def noPrimeBranchingAllowedPredicate
    {C : SU7WeightTensorCoding} {n : ℕ}
    (xs : List (SU7NoPrimeBranchingSpectrumCell C n)) :
    ℕ -> ℕ -> Bool :=
  fun left right =>
    xs.any (fun B =>
      (atomCode B.leftAtom.toSU7Atom == left) &&
        (atomCode B.rightAtom.toSU7Atom == right))

/-- The generated Boolean predicate is exactly the no-prime branch-cell
support predicate. -/
theorem noPrimeBranchingAllowedPredicate_eq_true_iff
    {C : SU7WeightTensorCoding} {n : ℕ}
    (xs : List (SU7NoPrimeBranchingSpectrumCell C n))
    (left right : ℕ) :
    noPrimeBranchingAllowedPredicate xs left right = true ↔
      NoPrimeBranchingAllowedPair xs left right := by
  unfold noPrimeBranchingAllowedPredicate
  rw [List.any_eq_true]
  constructor
  · intro h
    rcases h with ⟨B, hmem, hmatch⟩
    rw [Bool.and_eq_true] at hmatch
    exact ⟨B, hmem, (beq_iff_eq.mp hmatch.1),
      (beq_iff_eq.mp hmatch.2)⟩
  · intro h
    rcases h with ⟨B, hmem, hleft, hright⟩
    refine ⟨B, hmem, ?_⟩
    rw [Bool.and_eq_true]
    exact ⟨beq_iff_eq.mpr hleft, beq_iff_eq.mpr hright⟩

/-- Any source no-prime branch cell marks its endpoint-code pair as allowed.
-/
theorem noPrimeBranchingAllowedPredicate_of_mem
    {C : SU7WeightTensorCoding} {n : ℕ}
    {xs : List (SU7NoPrimeBranchingSpectrumCell C n)}
    {B : SU7NoPrimeBranchingSpectrumCell C n}
    (hmem : B ∈ xs) :
    noPrimeBranchingAllowedPredicate xs
        (atomCode B.leftAtom.toSU7Atom)
        (atomCode B.rightAtom.toSU7Atom) = true := by
  exact
    (noPrimeBranchingAllowedPredicate_eq_true_iff xs
      (atomCode B.leftAtom.toSU7Atom)
      (atomCode B.rightAtom.toSU7Atom)).mpr
      ⟨B, hmem, rfl, rfl⟩

/-- An allowed endpoint-code pair comes from an actual no-prime SU(7) branch
cell in the source list. -/
theorem exists_noPrimeBranchingCell_of_allowedPredicate
    {C : SU7WeightTensorCoding} {n left right : ℕ}
    {xs : List (SU7NoPrimeBranchingSpectrumCell C n)}
    (hallowed : noPrimeBranchingAllowedPredicate xs left right = true) :
    ∃ B : SU7NoPrimeBranchingSpectrumCell C n,
      B ∈ xs ∧
        atomCode B.leftAtom.toSU7Atom = left ∧
          atomCode B.rightAtom.toSU7Atom = right :=
  (noPrimeBranchingAllowedPredicate_eq_true_iff xs left right).mp hallowed

/-! ## Projection readout: allowed pairs are prime-edge pairs -/

/-- The left endpoint of any generated allowed pair is prime, by P932's
tensor-irreducible projection theorem. -/
theorem noPrimeAllowedPredicate_left_prime
    {C : SU7WeightTensorCoding} {n left right : ℕ}
    {xs : List (SU7NoPrimeBranchingSpectrumCell C n)}
    (hallowed : noPrimeBranchingAllowedPredicate xs left right = true) :
    Nat.Prime left := by
  rcases exists_noPrimeBranchingCell_of_allowedPredicate
      (C := C) (n := n) (xs := xs) hallowed with
    ⟨B, _hmem, hleft, _hright⟩
  simpa [hleft] using noPrimeBranchingAtom_atomCode_prime B.leftAtom

/-- The right endpoint of any generated allowed pair is prime, by P932's
tensor-irreducible projection theorem. -/
theorem noPrimeAllowedPredicate_right_prime
    {C : SU7WeightTensorCoding} {n left right : ℕ}
    {xs : List (SU7NoPrimeBranchingSpectrumCell C n)}
    (hallowed : noPrimeBranchingAllowedPredicate xs left right = true) :
    Nat.Prime right := by
  rcases exists_noPrimeBranchingCell_of_allowedPredicate
      (C := C) (n := n) (xs := xs) hallowed with
    ⟨B, _hmem, _hleft, hright⟩
  simpa [hright] using noPrimeBranchingAtom_atomCode_prime B.rightAtom

/-! ## Feeding the P950 filtered permanent-holonomy throat -/

/-- A no-prime branch-cell list forbids filtered permanent holonomy when its
generated Boolean allowed predicate does. -/
def NoPrimeAllowedSectorForbidsUnitPermanentHolonomy
    {C : SU7WeightTensorCoding} {n : ℕ}
    (bound : ℕ)
    (xs : List (SU7NoPrimeBranchingSpectrumCell C n)) : Prop :=
  BoolGaugeFilteredRawCodePairForbidsUnitPermanentHolonomy
    n bound (noPrimeBranchingAllowedPredicate xs)

/-- A no-prime generated allowed-sector no-holonomy law forbids unit permanent
holonomy in the corresponding filtered generated SU(7) spectrum. -/
theorem gaugeFilteredForbidsUnitPermanentHolonomy_of_noPrimeAllowedSector
    {C : SU7WeightTensorCoding} {n bound : ℕ}
    {xs : List (SU7NoPrimeBranchingSpectrumCell C n)}
    (H : NoPrimeAllowedSectorForbidsUnitPermanentHolonomy bound xs) :
    SU7RawBranchingSpectrumForbidsUnitPermanentHolonomy
      (gaugeFilteredRawBranchingSpectrum n bound
        (noPrimeBranchingAllowedPredicate xs)) :=
  gaugeFilteredForbidsUnitPermanentHolonomy_of_noRawCodePairHolonomy H

/-! ## Certificate -/

/-- P951 certificate: the P949/P950 Boolean allowed-sector predicate is
generated from no-prime SU(7) branch cells, and allowed endpoint codes become
prime only at projection time. -/
structure SU7NoPrimeAllowedSectorPredicateCertificate where
  allowed_predicate :
    ∀ {C : SU7WeightTensorCoding} {n : ℕ},
      List (SU7NoPrimeBranchingSpectrumCell C n) ->
        ℕ -> ℕ -> Bool
  allowed_iff_generated :
    ∀ {C : SU7WeightTensorCoding} {n : ℕ}
      (xs : List (SU7NoPrimeBranchingSpectrumCell C n))
      (left right : ℕ),
      noPrimeBranchingAllowedPredicate xs left right = true ↔
        NoPrimeBranchingAllowedPair xs left right
  source_cell_allowed :
    ∀ {C : SU7WeightTensorCoding} {n : ℕ}
      {xs : List (SU7NoPrimeBranchingSpectrumCell C n)}
      {B : SU7NoPrimeBranchingSpectrumCell C n},
      B ∈ xs ->
        noPrimeBranchingAllowedPredicate xs
          (atomCode B.leftAtom.toSU7Atom)
          (atomCode B.rightAtom.toSU7Atom) = true
  allowed_left_prime :
    ∀ {C : SU7WeightTensorCoding} {n left right : ℕ}
      {xs : List (SU7NoPrimeBranchingSpectrumCell C n)},
      noPrimeBranchingAllowedPredicate xs left right = true ->
        Nat.Prime left
  allowed_right_prime :
    ∀ {C : SU7WeightTensorCoding} {n left right : ℕ}
      {xs : List (SU7NoPrimeBranchingSpectrumCell C n)},
      noPrimeBranchingAllowedPredicate xs left right = true ->
        Nat.Prime right
  no_holonomy_to_filtered_spectrum :
    ∀ {C : SU7WeightTensorCoding} {n bound : ℕ}
      {xs : List (SU7NoPrimeBranchingSpectrumCell C n)},
      NoPrimeAllowedSectorForbidsUnitPermanentHolonomy bound xs ->
        SU7RawBranchingSpectrumForbidsUnitPermanentHolonomy
          (gaugeFilteredRawBranchingSpectrum n bound
            (noPrimeBranchingAllowedPredicate xs))

/-- Canonical P951 no-prime allowed-sector predicate certificate. -/
def su7NoPrimeAllowedSectorPredicateCertificate :
    SU7NoPrimeAllowedSectorPredicateCertificate where
  allowed_predicate := noPrimeBranchingAllowedPredicate
  allowed_iff_generated := noPrimeBranchingAllowedPredicate_eq_true_iff
  source_cell_allowed := noPrimeBranchingAllowedPredicate_of_mem
  allowed_left_prime := noPrimeAllowedPredicate_left_prime
  allowed_right_prime := noPrimeAllowedPredicate_right_prime
  no_holonomy_to_filtered_spectrum :=
    gaugeFilteredForbidsUnitPermanentHolonomy_of_noPrimeAllowedSector


end
end StandardModelConstraint
end SaturationMonoid
