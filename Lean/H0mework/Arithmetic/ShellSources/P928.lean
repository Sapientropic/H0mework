import H0mework.Arithmetic.CodePairs.P927

/-!
# Proposition 928: generated coverage is explicit energy-shell realization

P927 showed that a successful generated coverage check produces no-gap /
unit-bracket descent.  This file removes the last Boolean opacity from that
statement.

For the explicit generated SU(7) raw spectrum of P926, the checker

```lean
rawBranchingEnergyShellCoverageCheck generatedSpectrum computedMax = true
```

is equivalent to the transparent shell theorem:

```text
for every k < computedMax,
  there is a Boolean-atomic raw branch cell generated by the explicit
  branch/incidence/code enumerator whose residual energy is k.
```

So the remaining producer is now a concrete shell-realization theorem over
the generated Boolean-atomic raw cells, not a hidden Boolean receipt.
-/

namespace SaturationMonoid
namespace StandardModelConstraint

noncomputable section

open SaturationMonoid.AffineRelaxation
open RunningSigmaBeta

set_option linter.defProp false

/-! ## Generated shell realization -/

/-- A generated raw energy shell is realized when the explicit Boolean
atomic branch-cell generator contains a cell whose raw residual energy is
exactly `k`. -/
def GeneratedRawEnergyShellRealized
    (n bound k : ℕ) : Prop :=
  ∃ x : SU7BooleanAtomicRawBranchingCell n,
    x ∈ booleanAtomicRawBranchingCandidateList n bound ∧
      rawAtomCodeBranchingDecompositionResidualEnergy x.cell = k

/-- A generated coverage theorem is the shell-by-shell realization of every
energy below the computed maximum. -/
def GeneratedRawEnergyCoverage (n bound : ℕ) : Prop :=
  ∀ k : ℕ, k < generatedRawBranchingMaxEnergy n bound ->
    GeneratedRawEnergyShellRealized n bound k

/-! ## Membership bridge from generated spectrum back to generated cells -/

/-- A Boolean-atomic generated cell appears in the P926 generated raw
spectrum. -/
theorem booleanAtomicCell_mem_booleanGeneratedSpectrum
    {n bound : ℕ}
    {x : SU7BooleanAtomicRawBranchingCell n}
    (hx : x ∈ booleanAtomicRawBranchingCandidateList n bound) :
    x.cell ∈ (booleanGeneratedRawBranchingSpectrum n bound).cells := by
  unfold booleanGeneratedRawBranchingSpectrum
  unfold rawBranchingSpectrum_of_certifiedCells
  unfold certifiedRawBranchingCells_of_atomicRawBranchingCells
  unfold atomicRawBranchingCells_of_booleanAtomicCells
  exact
    List.mem_map.mpr
      ⟨certifiedRawBranchingCell_of_atomicRawBranchingCell
          (atomicRawBranchingCell_of_booleanAtomicCell x),
        List.mem_map.mpr
          ⟨atomicRawBranchingCell_of_booleanAtomicCell x,
            List.mem_map.mpr ⟨x, hx, rfl⟩,
            rfl⟩,
        rfl⟩

/-- Every raw cell in the P926 generated spectrum comes from a generated
Boolean-atomic raw branch cell. -/
theorem exists_booleanAtomicCell_of_mem_booleanGeneratedSpectrum
    {n bound : ℕ}
    {c : SU7BranchingDecompositionCell n}
    (hmem : c ∈ (booleanGeneratedRawBranchingSpectrum n bound).cells) :
    ∃ x : SU7BooleanAtomicRawBranchingCell n,
      x ∈ booleanAtomicRawBranchingCandidateList n bound ∧
        x.cell = c := by
  let xs := booleanAtomicRawBranchingCandidateList n bound
  change
    c ∈
      (rawBranchingSpectrum_of_certifiedCells
        (certifiedRawBranchingCells_of_atomicRawBranchingCells
          (atomicRawBranchingCells_of_booleanAtomicCells xs))).cells at hmem
  rcases
      exists_certifiedCell_of_mem_rawBranchingSpectrum
        (certifiedRawBranchingCells_of_atomicRawBranchingCells
          (atomicRawBranchingCells_of_booleanAtomicCells xs))
        hmem with
    ⟨cert, hcert_mem, hcert_cell⟩
  rcases
      exists_atomicCell_of_mem_certifiedAtomicList
        (atomicRawBranchingCells_of_booleanAtomicCells xs)
        hcert_mem with
    ⟨atomic, hatomic_mem, hatomic_cert⟩
  rcases exists_booleanCell_of_mem_atomicBooleanList xs hatomic_mem with
    ⟨x, hx_mem, hx_atomic⟩
  subst cert
  subst atomic
  subst c
  exact ⟨x, hx_mem, rfl⟩

/-! ## The Boolean has-energy checker is exactly shell realization -/

/-- For generated spectra, `rawBranchingSpectrumHasEnergy` is exactly
existence of a generated Boolean-atomic raw cell at that energy shell. -/
theorem rawBranchingSpectrumHasEnergy_generated_iff
    (n bound k : ℕ) :
    rawBranchingSpectrumHasEnergy
        (booleanGeneratedRawBranchingSpectrum n bound) k = true ↔
      GeneratedRawEnergyShellRealized n bound k := by
  constructor
  · intro hhas
    rcases
        exists_cell_of_rawBranchingSpectrumHasEnergy_eq_true
          (booleanGeneratedRawBranchingSpectrum n bound) k hhas with
      ⟨c, hmem, henergy⟩
    rcases exists_booleanAtomicCell_of_mem_booleanGeneratedSpectrum
        (n := n) (bound := bound) hmem with
      ⟨x, hx_mem, hx_cell⟩
    subst c
    exact ⟨x, hx_mem, henergy⟩
  · intro hrealized
    rcases hrealized with ⟨x, hx_mem, hx_energy⟩
    unfold rawBranchingSpectrumHasEnergy
    apply List.any_eq_true.mpr
    exact
      ⟨x.cell,
        booleanAtomicCell_mem_booleanGeneratedSpectrum hx_mem,
        decide_eq_true_eq.mpr hx_energy⟩

/-- The generated coverage check is equivalent to shell-by-shell realization
below the computed maximum energy. -/
theorem generatedCoverageCheck_iff_energyCoverage
    (n bound : ℕ) :
    rawBranchingEnergyShellCoverageCheck
        (booleanGeneratedRawBranchingSpectrum n bound)
        (generatedRawBranchingMaxEnergy n bound) = true ↔
      GeneratedRawEnergyCoverage n bound := by
  constructor
  · intro hcheck k hk
    have hhas :
        rawBranchingSpectrumHasEnergy
          (booleanGeneratedRawBranchingSpectrum n bound) k = true :=
      (List.all_eq_true.mp hcheck) k (List.mem_range.mpr hk)
    exact
      (rawBranchingSpectrumHasEnergy_generated_iff n bound k).mp hhas
  · intro hcoverage
    unfold rawBranchingEnergyShellCoverageCheck
    apply List.all_eq_true.mpr
    intro k hk
    exact
      (rawBranchingSpectrumHasEnergy_generated_iff n bound k).mpr
        (hcoverage k (List.mem_range.mp hk))

/-! ## Build generated certificates from transparent shell realization -/

/-- Transparent shell realization plus start membership builds P926's generated
coverage certificate. -/
def generatedCoverageCertificate_of_energyCoverage
    {n bound : ℕ}
    (startCell : SU7BranchingDecompositionCell n)
    (hstart :
      startCell ∈ (booleanGeneratedRawBranchingSpectrum n bound).cells)
    (hcoverage : GeneratedRawEnergyCoverage n bound) :
    SU7GeneratedBooleanRawBranchingCoverageCertificate n where
  codeBound := bound
  startCell := startCell
  start_mem := hstart
  coverage_check :=
    (generatedCoverageCheck_iff_energyCoverage n bound).mpr hcoverage

/-- Every P926 generated coverage certificate yields the transparent
shell-realization theorem. -/
theorem energyCoverage_of_generatedCoverageCertificate
    {n : ℕ} (G : SU7GeneratedBooleanRawBranchingCoverageCertificate n) :
    GeneratedRawEnergyCoverage n G.codeBound :=
  (generatedCoverageCheck_iff_energyCoverage n G.codeBound).mp
    G.coverage_check

/-- Transparent shell realization gives the unit-bracket law. -/
theorem unitSuccessorLaw_of_generatedEnergyCoverage
    {n bound : ℕ}
    (startCell : SU7BranchingDecompositionCell n)
    (hstart :
      startCell ∈ (booleanGeneratedRawBranchingSpectrum n bound).cells)
    (hcoverage : GeneratedRawEnergyCoverage n bound) :
    SU7RawBranchingSpectrumUnitSuccessorLaw
      (booleanGeneratedRawBranchingSpectrum n bound) :=
  generatedCoverage_unitSuccessorLaw
    (generatedCoverageCertificate_of_energyCoverage
      startCell hstart hcoverage)

/-- Transparent shell realization forbids unit permanent holonomy. -/
theorem forbidsUnitPermanentHolonomy_of_generatedEnergyCoverage
    {n bound : ℕ}
    (startCell : SU7BranchingDecompositionCell n)
    (hstart :
      startCell ∈ (booleanGeneratedRawBranchingSpectrum n bound).cells)
    (hcoverage : GeneratedRawEnergyCoverage n bound) :
    SU7RawBranchingSpectrumForbidsUnitPermanentHolonomy
      (booleanGeneratedRawBranchingSpectrum n bound) :=
  generatedCoverage_forbidsUnitPermanentHolonomy
    (generatedCoverageCertificate_of_energyCoverage
      startCell hstart hcoverage)

/-! ## Certificate -/

/-- P928 certificate: the generated Boolean coverage check is exactly explicit
energy-shell realization over generated Boolean-atomic raw cells. -/
structure SU7GeneratedCoverageShellRealizationCertificate where
  has_energy_iff_realized :
    ∀ n bound k : ℕ,
      rawBranchingSpectrumHasEnergy
          (booleanGeneratedRawBranchingSpectrum n bound) k = true ↔
        GeneratedRawEnergyShellRealized n bound k
  coverage_check_iff_shells :
    ∀ n bound : ℕ,
      rawBranchingEnergyShellCoverageCheck
          (booleanGeneratedRawBranchingSpectrum n bound)
          (generatedRawBranchingMaxEnergy n bound) = true ↔
        GeneratedRawEnergyCoverage n bound
  shell_coverage_to_certificate :
    ∀ {n bound : ℕ}
      (startCell : SU7BranchingDecompositionCell n),
      startCell ∈ (booleanGeneratedRawBranchingSpectrum n bound).cells ->
        GeneratedRawEnergyCoverage n bound ->
          SU7GeneratedBooleanRawBranchingCoverageCertificate n
  shell_coverage_to_unit_bracket :
    ∀ {n bound : ℕ}
      (startCell : SU7BranchingDecompositionCell n),
      startCell ∈ (booleanGeneratedRawBranchingSpectrum n bound).cells ->
        GeneratedRawEnergyCoverage n bound ->
          SU7RawBranchingSpectrumUnitSuccessorLaw
            (booleanGeneratedRawBranchingSpectrum n bound)
  shell_coverage_to_no_unit_holonomy :
    ∀ {n bound : ℕ}
      (startCell : SU7BranchingDecompositionCell n),
      startCell ∈ (booleanGeneratedRawBranchingSpectrum n bound).cells ->
        GeneratedRawEnergyCoverage n bound ->
          SU7RawBranchingSpectrumForbidsUnitPermanentHolonomy
            (booleanGeneratedRawBranchingSpectrum n bound)

/-- Canonical P928 shell-realization certificate. -/
def su7GeneratedCoverageShellRealizationCertificate :
    SU7GeneratedCoverageShellRealizationCertificate where
  has_energy_iff_realized :=
    rawBranchingSpectrumHasEnergy_generated_iff
  coverage_check_iff_shells :=
    generatedCoverageCheck_iff_energyCoverage
  shell_coverage_to_certificate :=
    generatedCoverageCertificate_of_energyCoverage
  shell_coverage_to_unit_bracket :=
    unitSuccessorLaw_of_generatedEnergyCoverage
  shell_coverage_to_no_unit_holonomy :=
    forbidsUnitPermanentHolonomy_of_generatedEnergyCoverage


end
end StandardModelConstraint
end SaturationMonoid
